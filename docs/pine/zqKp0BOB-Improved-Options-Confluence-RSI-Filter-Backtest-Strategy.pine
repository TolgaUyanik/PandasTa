//@version=6
strategy("Options Confluence + RSI Filter – Backtest Strategy", overlay=true)

// ==========================
// 🔹 INPUTS
// ==========================
emaLen      = input.int(13, "EMA Length")
ceLen       = input.int(22, "Chandelier ATR Period")
ceMult      = input.float(3.0, "Chandelier Multiplier")
bosLookback = input.int(10, "BOS Lookback")

// 🔹 RSI FILTER INPUTS (new)
rsiLen       = input.int(14, "RSI Length")
rsiBullLevel = input.int(55, "RSI must be ABOVE this for CALL entries")
rsiBearLevel = input.int(45, "RSI must be BELOW this for PUT entries")
useRSIMidBlock = input.bool(true, "Block ALL entries when RSI is in mid-zone (sideways signature)")
rsiMidLow    = input.int(45, "RSI Mid-Zone Low")
rsiMidHigh   = input.int(55, "RSI Mid-Zone High")

useOBOSBlock   = input.bool(true, "Block entries in Overbought/Oversold zones")
rsiOverbought  = input.int(70, "RSI Overbought Level (blocks CALL above this)")
rsiOversold    = input.int(30, "RSI Oversold Level (blocks PUT below this)")

// ==========================
// 🔹 EMA
// ==========================
ema13 = ta.ema(close, emaLen)
plot(ema13, color=color.blue, title="EMA 13")

// ==========================
// 🔹 VWAP (Corrected)
// ==========================
vwapValue = ta.vwap
plot(vwapValue, color=color.orange, title="VWAP")

// ==========================
// 🔹 CHANDELIER EXIT
// ==========================
atr = ceMult * ta.atr(ceLen)

longStop  = ta.highest(high, ceLen) - atr
shortStop = ta.lowest(low, ceLen) + atr

var int ceDir = 1
ceDir := close > shortStop[1] ? 1 :
         close < longStop[1] ? -1 :
         ceDir

// ==========================
// 🔹 BOS
// ==========================
highestHigh = ta.highest(high[1], bosLookback)
lowestLow   = ta.lowest(low[1], bosLookback)

bosBull = close > highestHigh
bosBear = close < lowestLow

// ==========================
// 🔹 RSI (new)
// ==========================
rsiValue = ta.rsi(close, rsiLen)
plot(rsiValue, "RSI", color=color.new(color.fuchsia, 0), display=display.data_window)

rsiBullOK  = rsiValue > rsiBullLevel
rsiBearOK  = rsiValue < rsiBearLevel
rsiMidZone = useRSIMidBlock and rsiValue >= rsiMidLow and rsiValue <= rsiMidHigh

rsiOverboughtZone = useOBOSBlock and rsiValue > rsiOverbought
rsiOversoldZone   = useOBOSBlock and rsiValue < rsiOversold

// Highlight sideways/mid-zone and overbought/oversold bars so you can see WHY trades are blocked
bgcolor(rsiMidZone ? color.new(color.gray, 85) : na, title="RSI Mid-Zone (Sideways) Highlight")
bgcolor(rsiOverboughtZone ? color.new(color.red, 88) : na, title="RSI Overbought Highlight")
bgcolor(rsiOversoldZone ? color.new(color.green, 88) : na, title="RSI Oversold Highlight")

// ==========================
// 🔹 ENTRY CONDITIONS
// ==========================
callEntry =
     strategy.position_size == 0 and
     close > ema13 and
     close > vwapValue and
     ceDir == 1 and
     bosBull and
     rsiBullOK and
     not rsiMidZone and
     not rsiOverboughtZone

putEntry =
     strategy.position_size == 0 and
     close < ema13 and
     close < vwapValue and
     ceDir == -1 and
     bosBear and
     rsiBearOK and
     not rsiMidZone and
     not rsiOversoldZone

// ==========================
// 🔹 EXIT CONDITIONS
// ==========================
callExit =
     strategy.position_size > 0 and
     (close < ema13 or ceDir == -1)

putExit =
     strategy.position_size < 0 and
     (close > ema13 or ceDir == 1)

// ==========================
// 🔹 EXECUTION
// ==========================
if callEntry
    strategy.entry("CALL", strategy.long)

if putEntry
    strategy.entry("PUT", strategy.short)

if callExit
    strategy.close("CALL")

if putExit
    strategy.close("PUT")

// ==========================
// 🔹 VISUAL SIGNALS
// ==========================
plotshape(callEntry, location=location.belowbar,
     color=color.lime, style=shape.labelup, text="CALL")

plotshape(putEntry, location=location.abovebar,
     color=color.red, style=shape.labeldown, text="PUT")

plotshape(callExit, location=location.abovebar,
     color=color.green, style=shape.labeldown, text="EXIT")

plotshape(putExit, location=location.belowbar,
     color=color.maroon, style=shape.labelup, text="EXIT")
