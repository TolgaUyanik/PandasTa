//@version=6

// @description: provides utilities for dates and times
library("TimeFilter", overlay=true)

// @description: provides avialable timezones
// This would probably be better as a type, but Pine doesn't recognize the string in a type as const strings
// Pine also doesn't allow exporting variables so this is just a copy/paste reference
// string GMT_M10      = 'GMT-10'
// string GMT_M8       = 'GMT-8'
// string GMT_M7       = 'GMT-7'
// string GMT_M6       = 'GMT-6'
// string GMT_M5       = 'GMT-5'
// string GMT_M4       = 'GMT-4'
// string GMT_M3       = 'GMT-3'
// string GMT_P0       = 'GMT+0'
// string GMT_P1       = 'GMT+1'
// string GMT_P2       = 'GMT+2'
// string GMT_P3       = 'GMT+3'
// string GMT_P330     = 'GMT+3:30'
// string GMT_P4       = 'GMT+4'
// string GMT_P5       = 'GMT+5'
// string GMT_P530     = 'GMT+5:30'
// string GMT_P545     = 'GMT+5:45'
// string GMT_P6       = 'GMT+6'
// string GMT_P630     = 'GMT+6:30'
// string GMT_P7       = 'GMT+7'
// string GMT_P8       = 'GMT+8'
// string GMT_P9       = 'GMT+9'
// string GMT_P930     = 'GMT+9:30'
// string GMT_P10      = 'GMT+10'
// string GMT_P1030    = 'GMT+10:30'
// string GMT_P11      = 'GMT+11'
// string GMT_P12      = 'GMT+12'
// string GMT_P1245    = 'GMT+12:45'
// string GMT_P13      = 'GMT+13'
// string GMT_P1345    = 'GMT+13:45'

// @description: provides a date range window to apply a specific time range
// @param string    session     (default='0900-1730')       The time session range filter
// @param string    timezone    (default=syminfo.timezone)  The time zone to use
// @param string    period      (default=timeframe.period)  The timeframe filter
// @returns bool    inSession                               Whether the current time is within the defined time session
export inSession ( simple string session = '0900-1730', simple string timezone = syminfo.timezone, simple string period = timeframe.period ) =>
    inSessionRange = not na ( time ( period, session, timezone ) )
    inSessionRange


// @description: provides a date range window to apply a specific time range
// @param int       startDate   (default=-1)    The day to start date range filter
// @param int       endDate     (default=-1)    The month to start date range filter
// @returns bool    inRange                     Whether the current time is within the defined date range
export inDateRange ( int startDate = -1, int endDate = -1 ) =>
    int start   = startDate
    int end     = endDate

    if ( start == -1 )
        start := timestamp ( '1 Sep 2022' )
    if ( end == -1 )
        end := timestamp ( '1 Jan 2030' )

    inRange = time >= start and time <= end

    inRange


// @description: indicate if the current time based on timezone matches one of the selected days
// @param int       weekDay     (default=dayofweek.monday)  The day of the week to check for
// @param string    timezone    (default=syminfo.timezone)  The time zone to use
// @returns bool    isWeekDay                               Whether the provided day is the current day of the week
export isWeekDay ( int weekDay = dayofweek.monday, simple string timezone = syminfo.timezone ) =>
    dayofweek(time, timezone) == weekDay


// @description: indicate if the current time based on timezone matches one of the selected days
// @param bool      useMon      (default=true)              The day to start date range filter
// @param bool      useTue      (default=true)              The month to start date range filter
// @param bool      useWed      (default=true)              The year to start date range filter
// @param bool      useThu      (default=true)              The day to end date range filter
// @param bool      useFri      (default=true)              The month to end date range filter
// @param bool      useSat      (default=true)              The day to end date range filter
// @param bool      useSun      (default=true)              The day to end date range filter
// @param string    timezone    (default=syminfo.timezone)  The time zone to use
// @returns bool    inWeek                                  Whether the current time is one of the defined days
export inWeek ( bool useMon = true, bool useTue = true, bool useWed = true, bool useThu = true, bool useFri = true, bool useSat = true, bool useSun = true, simple string timezone = syminfo.timezone ) =>
    isDay = if useMon and dayofweek ( time, timezone ) == dayofweek.monday
        true
    else if useTue and dayofweek ( time, timezone ) == dayofweek.tuesday
        true
    else if useWed and dayofweek ( time, timezone ) == dayofweek.wednesday
        true
    else if useThu and dayofweek ( time, timezone ) == dayofweek.thursday
        true
    else if useFri and dayofweek ( time, timezone ) == dayofweek.friday
        true
    else if useSat and dayofweek ( time, timezone ) == dayofweek.saturday
        true
    else if useSun and dayofweek ( time, timezone ) == dayofweek.sunday
        true
    else
        false

    isDay


// @description: the result of a the applied filter matches. Pass `false` to skip using a segment (range/week)
// @param bool      useRange    (default=true)  Apply date range filter
// @param bool      useSession  (default=true)  Apply time session filter
// @param bool      useWeek     (default=true)  Apply week filter
// @param bool      inRange     (default=true)  If falls in date range
// @param bool      inSession   (default=true)  If falls in time session filter
// @param bool      inWeek      (default=true)  If falls in week filter
// @returns bool    filter                      Whether the filter matches or not
export filter ( bool useRange = true, bool useSession = true, bool useWeek = true, bool inRange = true, bool inSession = true, bool inWeek = true ) =>
    rangeFilter     = useRange ? inRange : true
    sessionFilter   = useSession ? inSession : true
    weekFilter      = useWeek ? inWeek : true

    filter = rangeFilter and sessionFilter and weekFilter

    filter
