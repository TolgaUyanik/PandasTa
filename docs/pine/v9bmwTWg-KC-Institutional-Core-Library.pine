//@version=6
//@description Reusable Pine Script v6 utilities for timeframe context, score grading, premium/discount classification, alignment, risk-to-reward and position-size calculations. Designed as a transparent helper library for indicators and strategies.
library("KCInstitutionalCore", overlay = false)

//#region Utility helpers

//@function Restricts a numeric value to the supplied minimum and maximum boundaries.
//@param value Value to restrict.
//@param minimum Lower boundary.
//@param maximum Upper boundary.
//@returns The restricted value.
export clamp(float value, float minimum, float maximum) =>
    math.max(minimum, math.min(maximum, value))

//@function Converts a numeric score into a concise quality grade.
//@param score Score expressed on a 0–100 scale.
//@returns A grade string from AA to D.
export scoreToGrade(float score) =>
    score >= 90.0 ? "AA" :
     score >= 82.0 ? "A+" :
     score >= 75.0 ? "A" :
     score >= 68.0 ? "B+" :
     score >= 60.0 ? "B" :
     score >= 50.0 ? "C" : "D"

//@function Normalizes a raw score to a 0–100 scale.
//@param rawScore Current raw score.
//@param maximumScore Maximum possible raw score.
//@returns Normalized score from 0 to 100, or na when maximumScore is not positive.
export normalizeScore(float rawScore, float maximumScore) =>
    maximumScore > 0.0 ? clamp(rawScore / maximumScore * 100.0, 0.0, 100.0) : na

//@function Classifies the current price inside a supplied dealing range.
//@param price Current or evaluated price.
//@param rangeHigh Upper boundary of the range.
//@param rangeLow Lower boundary of the range.
//@returns A tuple containing PREMIUM, DISCOUNT, or EQUILIBRIUM and the 0–100 range percentage.
export rangeLocation(float price, float rangeHigh, float rangeLow) =>
    float span = rangeHigh - rangeLow
    float percentage = span > 0.0 ? clamp((price - rangeLow) / span * 100.0, 0.0, 100.0) : 50.0
    string location = percentage > 55.0 ? "PREMIUM" : percentage < 45.0 ? "DISCOUNT" : "EQUILIBRIUM"
    [location, percentage]

//@function Calculates reward-to-risk from entry, stop and target prices.
//@param entry Entry price.
//@param stop Stop-loss price.
//@param target Target price.
//@returns Absolute reward-to-risk ratio, or na when the stop distance is zero.
export riskReward(float entry, float stop, float target) =>
    float riskDistance = math.abs(entry - stop)
    riskDistance > 0.0 ? math.abs(target - entry) / riskDistance : na

//@function Estimates position size from account risk and stop distance.
//@param accountSize Account balance or planning capital.
//@param riskPercent Percentage of account risked.
//@param entry Entry price.
//@param stop Stop-loss price.
//@param pointValue Monetary value per price point for one unit.
//@returns Estimated units or lots according to the supplied pointValue, or na for invalid inputs.
export positionSize(float accountSize, float riskPercent, float entry, float stop, float pointValue) =>
    float riskAmount = accountSize * math.max(riskPercent, 0.0) / 100.0
    float stopDistance = math.abs(entry - stop)
    float riskPerUnit = stopDistance * pointValue
    accountSize > 0.0 and pointValue > 0.0 and riskPerUnit > 0.0 ? riskAmount / riskPerUnit : na

//@function Maps chart duration in seconds to a general planning style.
//@param chartSeconds Chart timeframe duration in seconds, normally supplied with timeframe.in_seconds().
//@returns SCALP, INTRADAY, SWING, or POSITION.
export tradeStyle(float chartSeconds) =>
    chartSeconds < 3600.0 ? "SCALP" :
     chartSeconds <= 14400.0 ? "INTRADAY" :
     chartSeconds <= 604800.0 ? "SWING" : "POSITION"

//@function Suggests two broader context timeframes from the chart duration.
//@param chartSeconds Chart timeframe duration in seconds, normally supplied with timeframe.in_seconds().
//@returns A tuple containing primary and secondary context timeframe strings.
export adaptiveTimeframes(float chartSeconds) =>
    string primary = chartSeconds < 3600.0 ? "60" :
         chartSeconds <= 3600.0 ? "240" :
         chartSeconds <= 14400.0 ? "D" :
         chartSeconds <= 86400.0 ? "W" :
         chartSeconds <= 604800.0 ? "M" : "3M"
    string secondary = chartSeconds < 3600.0 ? "240" :
         chartSeconds <= 3600.0 ? "D" :
         chartSeconds <= 14400.0 ? "W" :
         chartSeconds <= 86400.0 ? "M" :
         chartSeconds <= 604800.0 ? "3M" : "12M"
    [primary, secondary]

//@function Summarizes local, higher-timeframe and multi-timeframe directional agreement.
//@param localBias Local direction: 1 bullish, -1 bearish, 0 neutral.
//@param htfBias Higher-timeframe direction: 1 bullish, -1 bearish, 0 neutral.
//@param mtfBias Broader alignment direction: 1 bullish, -1 bearish, 0 neutral.
//@returns BULL ALIGNED, BEAR ALIGNED, PARTIAL, CONFLICT, or NEUTRAL.
export alignmentState(int localBias, int htfBias, int mtfBias) =>
    localBias == 1 and htfBias == 1 and mtfBias == 1 ? "BULL ALIGNED" :
     localBias == -1 and htfBias == -1 and mtfBias == -1 ? "BEAR ALIGNED" :
     localBias != 0 and ((htfBias != 0 and localBias != htfBias) or (mtfBias != 0 and localBias != mtfBias)) ? "CONFLICT" :
     localBias != 0 and (localBias == htfBias or localBias == mtfBias) ? "PARTIAL" : "NEUTRAL"

//@function Returns the first material execution blocker in a transparent priority order.
//@param direction Intended direction: 1 long, -1 short, 0 neutral.
//@param htfBias Higher-timeframe direction: 1 bullish, -1 bearish, 0 neutral.
//@param mtfBias Multi-timeframe direction: 1 bullish, -1 bearish, 0 neutral.
//@param location PREMIUM, DISCOUNT, or EQUILIBRIUM.
//@param structureConfirmed True when the required structure event is confirmed.
//@param liquidityConfirmed True when the required liquidity event is confirmed.
//@param newsBlocked True when a manual news blackout is active.
//@returns A concise blocker description, or CLEAR when no listed blocker is active.
export executionBlocker(
     int direction,
     int htfBias,
     int mtfBias,
     string location,
     bool structureConfirmed,
     bool liquidityConfirmed,
     bool newsBlocked
) =>
    newsBlocked ? "NEWS BLACKOUT" :
     direction != 0 and htfBias != 0 and direction != htfBias ? "HTF CONFLICT" :
     direction != 0 and mtfBias != 0 and direction != mtfBias ? "MTF CONFLICT" :
     direction == 1 and location == "PREMIUM" ? "BUY IN PREMIUM" :
     direction == -1 and location == "DISCOUNT" ? "SELL IN DISCOUNT" :
     not structureConfirmed ? "STRUCTURE UNCONFIRMED" :
     not liquidityConfirmed ? "LIQUIDITY UNCONFIRMED" : "CLEAR"

//#endregion
