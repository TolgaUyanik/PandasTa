//@version=6
indicator("Kairos Barakah Strategy", overlay=true)

// User input for time selection
targetHour = input.int(19, "Hour (IST)", minval=0, maxval=23)
targetMinute = input.int(0, "Minute (IST)", minval=0, maxval=59)
windowDuration = input.int(135, "Trading Window Duration (minutes)", minval=1, maxval=1440)

// Calculate IST time
isISTTime(checkHour, checkMinute) =>
    barTimeUTC = time
    barTimeIST = barTimeUTC + (5 * 60 * 60 * 1000) + (30 * 60 * 1000)
    totalMinutesIST = (barTimeIST / (60 * 1000)) % (24 * 60)
    currentHourIST = math.floor(totalMinutesIST / 60)
    currentMinute = totalMinutesIST % 60
    currentHourIST == checkHour and currentMinute == checkMinute

// Calculate end time based on duration
getEndTime(hour, minute, duration) =>
    totalMinutes = hour * 60 + minute + duration
    endHour = math.floor(totalMinutes / 60) % 24
    endMinute = totalMinutes % 60
    [endHour, endMinute]

[endHour, endMinute] = getEndTime(targetHour, targetMinute, windowDuration)

// Store reference levels and signal states
var float refHigh = na
var float refLow = na
var bool buySignalGenerated = false
var bool sellSignalGenerated = false
var bool inTradingWindow = false
var int referenceBarIndex = na
var int todayDate = na
var bool showLines = false

// Store the reference candle for reversal validation
var float refCandleHigh = na
var float refCandleLow = na
var int lastSignalType = 0  // 0: none, 1: buy, 2: sell

// Store win probability variables
var float bodyWinProbability = na
var float volumeWinProbability = na
var float trendWinProbability = na
var float compositeWinProbability = na

// Get today's date
currentDate = year * 10000 + month * 100 + dayofmonth

// Reset at new day
if currentDate != todayDate
    todayDate := currentDate
    referenceBarIndex := na
    buySignalGenerated := false
    sellSignalGenerated := false
    inTradingWindow := false
    refHigh := na
    refLow := na
    showLines := false
    refCandleHigh := na
    refCandleLow := na
    lastSignalType := 0
    bodyWinProbability := na
    volumeWinProbability := na
    trendWinProbability := na
    compositeWinProbability := na

// Detect reference time candle
if isISTTime(targetHour, targetMinute)
    refHigh := high
    refLow := low
    referenceBarIndex := bar_index
    buySignalGenerated := false
    sellSignalGenerated := false
    inTradingWindow := true
    showLines := true
    refCandleHigh := na
    refCandleLow := na
    lastSignalType := 0
    label.new(bar_index, low, "C", 
             style=label.style_label_up, color=color.blue, textcolor=color.white, size=size.normal)

// Turn off lines at end time
if isISTTime(endHour, endMinute)
    showLines := false
    inTradingWindow := false
    buySignalGenerated := false
    sellSignalGenerated := false

// Plot reference lines (visible until end time)
plot(showLines and not na(refHigh) ? refHigh : na, "High Line", color.blue, 2, plot.style_linebr)
plot(showLines and not na(refLow) ? refLow : na, "Low Line", color.blue, 2, plot.style_linebr)

// Plot EMAs for visual trend analysis
ema30 = ta.ema(close, 30)
ema200 = ta.ema(close, 200)
plot(ema30, "EMA 30", color.green, 1)
plot(ema200, "EMA 200", color.red, 1)

// Trading signals - active until end time
buyCondition = inTradingWindow and not isISTTime(targetHour, targetMinute) and not buySignalGenerated and close > refHigh and not na(refHigh)
sellCondition = inTradingWindow and not isISTTime(targetHour, targetMinute) and not sellSignalGenerated and close < refLow and not na(refLow)

// Reversal conditions - must follow proper signal sequence
// For Buy signals → Reversal only if candle closes BELOW reference time candle's low
// For Sell signals → Reversal only if candle closes ABOVE reference time candle's high
buyReversalCondition = inTradingWindow and lastSignalType == 1 and close < refLow and not na(refLow)
sellReversalCondition = inTradingWindow and lastSignalType == 2 and close > refHigh and not na(refHigh)

// Calculate candle body percentage
calculateBodyPercentage() =>
    candleRange = high - low
    bodySize = math.abs(close - open)
    bodyPercentage = candleRange != 0 ? (bodySize / candleRange) * 100 : 0
    math.round(bodyPercentage)

// Calculate volume-based win probability
calculateVolumeWinProbability() =>
    // Compare current volume to recent average volume
    avgVolume = ta.sma(volume, 20)
    volStrength = volume / avgVolume * 100
    
    // Higher volume on signal candle suggests stronger conviction
    volProb = math.min(math.round(volStrength), 100)
    volProb

// Calculate trend-based win probability
calculateTrendWinProbability(isLong) =>
    // Use EMA crossover to determine trend direction
    fastEMA = ta.ema(close, 10)
    slowEMA = ta.ema(close, 30)
    
    // Calculate RSI for momentum
    rsi = ta.rsi(close, 14)
    
    // Initialize variables outside of conditional blocks
    var float emaTrend = 0.0
    var float rsiStrength = 0.0
    
    // For long positions
    if isLong
        // Bullish when fast EMA > slow EMA and RSI > 50
        emaTrend := fastEMA > slowEMA ? 60 : 30
        rsiStrength := rsi > 50 ? math.min(math.round(rsi), 100) : math.round(rsi / 2)
    else
        // Bearish when fast EMA < slow EMA and RSI < 50
        emaTrend := fastEMA < slowEMA ? 60 : 30
        rsiStrength := rsi < 50 ? math.min(math.round(100 - rsi), 100) : math.round((100 - rsi) / 2)
    
    // Combine EMA trend and RSI for overall trend probability
    trendProb = math.round((emaTrend + rsiStrength) / 2)
    trendProb

// Calculate composite win probability
calculateCompositeWinProbability(bodyProb, volumeProb, trendProb) =>
    // Weight the different factors
    // Body: 30%, Volume: 30%, Trend: 40%
    weightedProb = (bodyProb * 0.3) + (volumeProb * 0.3) + (trendProb * 0.4)
    math.round(weightedProb)

// Generate labels and alerts for initial signals
if buyCondition
    label.new(bar_index, low, "B", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)
    buySignalGenerated := true
    sellSignalGenerated := false
    lastSignalType := 1
    refCandleHigh := high
    refCandleLow := low
    
    // Calculate all win probability metrics for buy signal
    bodyWinProbability := calculateBodyPercentage()
    volumeWinProbability := calculateVolumeWinProbability()
    trendWinProbability := calculateTrendWinProbability(true) // true for long position
    compositeWinProbability := calculateCompositeWinProbability(bodyWinProbability, volumeWinProbability, trendWinProbability)
    
if sellCondition
    label.new(bar_index, high, "S", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)
    sellSignalGenerated := true
    buySignalGenerated := false
    lastSignalType := 2
    refCandleHigh := high
    refCandleLow := low
    
    // Calculate all win probability metrics for sell signal
    bodyWinProbability := calculateBodyPercentage()
    volumeWinProbability := calculateVolumeWinProbability()
    trendWinProbability := calculateTrendWinProbability(false) // false for short position
    compositeWinProbability := calculateCompositeWinProbability(bodyWinProbability, volumeWinProbability, trendWinProbability)

// Generate labels and alerts for reversal signals
if buyReversalCondition
    label.new(bar_index, low, "R", style=label.style_label_up, color=color.purple, textcolor=color.white, size=size.normal)
    buySignalGenerated := false
    sellSignalGenerated := true
    lastSignalType := 2
    refCandleHigh := high
    refCandleLow := low
    
    // Calculate all win probability metrics for buy reversal
    bodyWinProbability := calculateBodyPercentage()
    volumeWinProbability := calculateVolumeWinProbability()
    trendWinProbability := calculateTrendWinProbability(true) // true for long position
    compositeWinProbability := calculateCompositeWinProbability(bodyWinProbability, volumeWinProbability, trendWinProbability)

if sellReversalCondition
    label.new(bar_index, high, "R", style=label.style_label_down, color=color.purple, textcolor=color.white, size=size.normal)
    sellSignalGenerated := false
    buySignalGenerated := true
    lastSignalType := 1
    refCandleHigh := high
    refCandleLow := low
    
    // Calculate all win probability metrics for sell reversal
    bodyWinProbability := calculateBodyPercentage()
    volumeWinProbability := calculateVolumeWinProbability()
    trendWinProbability := calculateTrendWinProbability(false) // false for short position
    compositeWinProbability := calculateCompositeWinProbability(bodyWinProbability, volumeWinProbability, trendWinProbability)

// Alert conditions - using fixed strings since we can't use variables in alertcondition messages
// Note: Win Probability cannot be included in alert messages as alertcondition only accepts constant strings
alertcondition(buyCondition, title="BUY Signal", message="BUY Signal: Closed above reference high")
alertcondition(sellCondition, title="SELL Signal", message="SELL Signal: Closed below reference low")
alertcondition(buyReversalCondition, title="BUY Reversal", message="BUY Reversal: Closed below reference time candle low")
alertcondition(sellReversalCondition, title="SELL Reversal", message="SELL Reversal: Closed above reference time candle high")

// Reference table - all information in one place
var table refTable = table.new(position.bottom_right, 2, 9, border_width=1, frame_color=color.blue, frame_width=2)

// MTF RSI Table
var table rsiTable = table.new(position.bottom_left, 7, 1, border_width = 2)

len = input.int(14, title="RSI Length", minval=1)
up = ta.rma(math.max(ta.change(close), 0), len)
down = ta.rma(-math.min(ta.change(close), 0), len)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

rsi1 = request.security(syminfo.tickerid, "5", rsi)
rsi2 = request.security(syminfo.tickerid, "15", rsi)
rsi3 = request.security(syminfo.tickerid, "60", rsi)
rsi4 = request.security(syminfo.tickerid, "240", rsi)
rsi5 = request.security(syminfo.tickerid, "D", rsi)

f_fillCell(table, column, row, value, timeframe) =>
    c_color = value >= 70 ? color.new(color.red, 0) : value <= 30 ? color.new(color.green, 0) : color.new(color.gray, 0)
    cellText = timeframe + "\n" + str.tostring(value, "0")
    table.cell(table, column, row, cellText, bgcolor = c_color, text_color = color.white, width = 8)

if barstate.islast
    f_fillCell(rsiTable, 0, 0, rsi1, "5m")
    f_fillCell(rsiTable, 1, 0, rsi2, "15m")
    f_fillCell(rsiTable, 2, 0, rsi3, "1H")
    f_fillCell(rsiTable, 3, 0, rsi4, "4H")
    f_fillCell(rsiTable, 4, 0, rsi5, "1D")

    table.cell(refTable, 0, 0, str.tostring(targetHour) + ":" + str.tostring(targetMinute, "00") + " Reference", 
              bgcolor=color.blue, text_color=color.white)
    table.cell(refTable, 0, 1, "High:", bgcolor=color.gray)
    table.cell(refTable, 1, 1, str.tostring(refHigh, format.mintick), bgcolor=color.gray)
    table.cell(refTable, 0, 2, "Low:", bgcolor=color.gray)
    table.cell(refTable, 1, 2, str.tostring(refLow, format.mintick), bgcolor=color.gray)
    
    // Prepare signal status and probability texts
    signalStatus = "None"
    if lastSignalType == 1
        signalStatus := "BUY"
    else if lastSignalType == 2
        signalStatus := "SELL"
    
    bodyProbText = na(bodyWinProbability) ? "N/A" : str.tostring(bodyWinProbability) + "%"
    volumeProbText = na(volumeWinProbability) ? "N/A" : str.tostring(volumeWinProbability) + "%"
    trendProbText = na(trendWinProbability) ? "N/A" : str.tostring(trendWinProbability) + "%"
    compositeProbText = na(compositeWinProbability) ? "N/A" : str.tostring(compositeWinProbability) + "%"
    
    // Add LAST SIGNAL header (row 3)
    table.cell(refTable, 0, 3, "LAST SIGNAL", bgcolor=color.blue, text_color=color.white)
    table.cell(refTable, 1, 3, "", bgcolor=color.blue)
    
    // Add Call Type (row 4)
    table.cell(refTable, 0, 4, "Call Type:", bgcolor=color.gray)
    table.cell(refTable, 1, 4, signalStatus, 
              bgcolor=lastSignalType == 1 ? color.green : lastSignalType == 2 ? color.red : color.gray, 
              text_color=color.white)
              
    // Add Body Win Probability (row 5)
    table.cell(refTable, 0, 5, "Body Win Prob:", bgcolor=color.gray)
    table.cell(refTable, 1, 5, bodyProbText, 
              bgcolor=na(bodyWinProbability) ? color.gray : 
                     bodyWinProbability >= 70 ? color.green : 
                     bodyWinProbability >= 40 ? color.orange : color.red, 
              text_color=color.white)
              
    // Add Volume Win Probability (row 6)
    table.cell(refTable, 0, 6, "Volume Win Prob:", bgcolor=color.gray)
    table.cell(refTable, 1, 6, volumeProbText, 
              bgcolor=na(volumeWinProbability) ? color.gray : 
                     volumeWinProbability >= 70 ? color.green : 
                     volumeWinProbability >= 40 ? color.orange : color.red, 
              text_color=color.white)
              
    // Add Trend Win Probability (row 7)
    table.cell(refTable, 0, 7, "Trend Win Prob:", bgcolor=color.gray)
    table.cell(refTable, 1, 7, trendProbText, 
              bgcolor=na(trendWinProbability) ? color.gray : 
                     trendWinProbability >= 70 ? color.green : 
                     trendWinProbability >= 40 ? color.orange : color.red, 
              text_color=color.white)
              
    // Add Composite Win Probability (row 8)
    table.cell(refTable, 0, 8, "COMPOSITE PROBABILITY:", bgcolor=color.blue, text_color=color.white)
    table.cell(refTable, 1, 8, compositeProbText, 
              bgcolor=na(compositeWinProbability) ? color.gray : 
                     compositeWinProbability >= 70 ? color.green : 
                     compositeWinProbability >= 40 ? color.orange : color.red, 
              text_color=color.white)