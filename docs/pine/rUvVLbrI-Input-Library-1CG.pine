//+-----------------------------------------------------+
//                 INPUT LINES & BOXES                  |
//+-----------------------------------------------------+
//#region INPUT STYLES

//@enum           Line style enumeration.
//@field solid    Represents a solid line.
//@field dotted   Represents a dotted line.
//@field dashed   Represents a dashed line.
//@field lArrow   Represents a line with a left arrow.
//@field rArrow   Represents a line with a right arrow.
//@field bArrow   Represents a line with arrows on both ends.
export enum LineStyle
    solid           = "Solid (─)"
    dotted          = "Dotted (┈)"
    dashed          = "Dashed (╌)"
    lArrow          = "Left Arrow (<─)"
    rArrow          = "Right Arrow (─>)"
    bArrow          = "Both Arrows (<─>)"

//@enum           Line thickness enumeration.
//@field thin      Represents a 1px thin line.
//@field normal    Represents a 2px normal line.
//@field heavy     Represents a 3px heavy line.
//@field thick     Represents a 4px thick line.
//@field wide      Represents a 5px wide line.
export enum LineSize
    thin            = "1px (thin)"
    normal          = "2px (normal)"
    heavy           = "3px (heavy)"
    thick           = "4px (thick)"
    wide            = "5px (wide)"

//@enum           Text size enumeration.
//@field auto      Represents automatic text size.
//@field tiny      Represents tiny text size.
//@field small     Represents small text size.
//@field normal    Represents normal text size.
//@field large     Represents large text size.
//@field huge      Represents huge text size.
export enum TextSize 
    auto            = "Auto"
    tiny            = "Tiny"
    small           = "Small"
    normal          = "Normal"
    large           = "Large"
    huge            = "Huge"

//@enum           Horizontal text alignment enumeration.
//@field left      Aligns text to the left.
//@field center    Aligns text to the center.
//@field right     Aligns text to the right.
export enum BoxHAlign
    left            = "Left"
    center          = "Center"
    right           = "Right"

//@enum           Vertical text alignment enumeration.
//@field top       Aligns text to the top.
//@field center    Aligns text to the center.
//@field bottom    Aligns text to the bottom.
export enum BoxVAlign
    top             = "Top"
    center          = "Center"
    bottom          = "Bottom"

//@enum             Line extension enumeration.
//@field none       No extension of the line.
//@field right      Line extends to the right.
//@field left       Line extends to the left.
//@field both       Line extends to both left and right.
export enum LineExtend
    none            = "None"
    right           = "Right"
    left            = "Left"
    both            = "Both"

//@enum           Label style enumeration.
//@field center    Centered label style.
//@field down      Label pointing downward.
//@field left      Label pointing left.
//@field right     Label pointing right.
//@field up        Label pointing upward.
//@field lowLeft   Label positioned lower-left.
//@field lowRight  Label positioned lower-right.
//@field upperLeft Label positioned upper-left.
//@field upperRight Label positioned upper-right.
export enum LabelStyle
    center      = "Center"
    down        = "Down"
    left        = "Left"
    right       = "Right"
    up          = "Up"
    lowLeft     = "Low Left"
    lowRight    = "Low Right"
    upperLeft   = "Upper Left"
    upperRight  = "Upper Right"

//#endregion INPUT STYLES

//+-----------------------------------------------------+
//                    INPUT METHODS                     |
//+-----------------------------------------------------+
//#region INPUT METHODS

// @function                        Resolves the timezone based on the provided `Timezones` enum.
// @param       this (Timezones)    The timezone enum value.
// @returns     (string)            The resolved timezone string. If `Timezones.exch` is used, it returns the exchange timezone.
export method timezoneToString(Timezones this) =>
    this == Timezones.exch ? syminfo.timezone : str.tostring(this)

// @function                        Converts the modified timezone enum back to its official name.
// @param       this (Timezones)    The timezone enum value.
// @returns     (string)            The official IANA timezone name without the offset brackets.
export method getOfficialTimezone(Timezones this) =>
    string tzStr = str.tostring(this)
    array<string> parts = str.split(tzStr, "(")
    this == Timezones.exch ? syminfo.timezone : array.get(parts, 0)

// @function                           Converts a 15-minute enum selection into a compact HHMM string.
// @param       this (quarterHours)    The quarter-hour enum value shown in the dropdown.
// @returns     (string)               The compact time string. Example: "1430".
export method toHHMMString(quarterHours this) =>
    string timeLabel = str.tostring(this)
    str.substring(timeLabel, 0, 2) + str.substring(timeLabel, 3, 5)

// @function                        Returns the line style constant based on the provided style name.
// @param       this (string)       The name of the line style. Defaults to "solid (─)".
// @returns     (line.style)        The corresponding line style constant for the specified style.
export method lineStyle (LineStyle this) =>
    switch this
        LineStyle.solid    => line.style_solid
        LineStyle.dotted   => line.style_dotted
        LineStyle.dashed   => line.style_dashed
        LineStyle.lArrow   => line.style_arrow_left
        LineStyle.rArrow   => line.style_arrow_right
        LineStyle.bArrow   => line.style_arrow_both

// @function                          Returns a line style constant from the common string format used in indicators.
// @param       _style (string)       Style text value. Defaults to "solid (─)".
// @returns     (line.style)          The corresponding line style constant.
export lineStyleFromString(string _style = "solid (─)") =>
    switch _style
        "solid (─)"         => line.style_solid
        "dotted (┈)"        => line.style_dotted
        "dashed (╌)"        => line.style_dashed
        "left arrow (<─)"   => line.style_arrow_left
        "right arrow (─>)"  => line.style_arrow_right
        "both arrow (<─>)"  => line.style_arrow_both
        "Solid (─)"         => line.style_solid
        "Dotted (┈)"        => line.style_dotted
        "Dashed (╌)"        => line.style_dashed
        "Left Arrow (<─)"   => line.style_arrow_left
        "Right Arrow (─>)"  => line.style_arrow_right
        "Both Arrows (<─>)" => line.style_arrow_both

// @function                        Returns the line thickness based on the provided size description.
// @param       this (LineSize)     The description of the line thickness.
// @returns     (int)               The thickness of the line in pixels corresponding to the specified size.
export method lineSize (LineSize this) =>
    switch this
        LineSize.thin      => 1
        LineSize.normal    => 2
        LineSize.heavy     => 3
        LineSize.thick     => 4
        LineSize.wide      => 5

// @function                        Returns a line thickness from the common string format used in indicators.
// @param       _size (string)      Thickness text value.
// @returns     (int)               Width in pixels.
export lineSizeFromString(string _size = "2px (normal)") =>
    switch _size
        "1px (thin)"    => 1
        "2px (normal)"  => 2
        "3px (heavy)"   => 3
        "4px (thick)"   => 4
        "5px (wide)"    => 5

// @function                        Returns the corresponding size value based on the provided text size enumeration.
// @param       this (TextSize)     The size of the text.
// @returns     (size)     The corresponding box size based on the input enumeration.
export method textSize (TextSize this) =>
    switch this
        TextSize.auto      => size.auto
        TextSize.tiny      => size.tiny
        TextSize.small     => size.small
        TextSize.normal    => size.normal
        TextSize.large     => size.large
        TextSize.huge      => size.huge

// @function                        Returns a text size from the common string format used in indicators.
// @param       _size (string)      Text size string.
// @returns     (size)              The corresponding size constant.
export textSizeFromString(string _size = "Tiny") =>
    switch _size
        "Auto"    => size.auto
        "Tiny"    => size.tiny
        "Small"   => size.small
        "Normal"  => size.normal
        "Large"   => size.large
        "Huge"    => size.huge


// @function                       Returns the corresponding horizontal alignment based on the provided enumeration.
// @param       this (BoxHAlign)   The `BoxHAlign` enumeration specifying the horizontal alignment.
// @returns     (series string)    The corresponding horizontal alignment for the text.
export method boxHAlign (BoxHAlign this) =>
    switch this
        BoxHAlign.left     => text.align_left
        BoxHAlign.center   => text.align_center
        BoxHAlign.right    => text.align_right

// @function                        Returns a horizontal alignment from the common string format used in indicators.
// @param       _align (string)     Horizontal alignment string.
// @returns     (series string)     The corresponding text align constant.
export boxHAlignFromString(string _align = "Left") =>
    switch _align
        "Left"    => text.align_left
        "Center"  => text.align_center
        "Right"   => text.align_right

// @function                       Returns the corresponding vertical alignment based on the provided enumeration.
// @param       this (BoxVAlign)   The `BoxVAlign` enumeration specifying the vertical alignment.
// @returns     (series string)    The corresponding vertical alignment for the text.
export method boxVAlign (BoxVAlign this) =>
    switch this
        BoxVAlign.top      => text.align_top
        BoxVAlign.center   => text.align_center
        BoxVAlign.bottom   => text.align_bottom

// @function                        Returns a vertical alignment from the common string format used in indicators.
// @param       _align (string)     Vertical alignment string.
// @returns     (series string)     The corresponding text align constant.
export boxVAlignFromString(string _align = "Top") =>
    switch _align
        "Top"     => text.align_top
        "Center"  => text.align_center
        "Bottom"  => text.align_bottom


// @function                        Returns the corresponding line extension based on the provided enumeration.
// @param       this (LineExtend)   The 'lineExtend' enumeration specifying the extension type.
// @returns     (series string)     The corresponding line extension.
export method lineExtend (LineExtend this) =>
    switch this
        LineExtend.none     => extend.none
        LineExtend.right    => extend.right
        LineExtend.left     => extend.left
        LineExtend.both     => extend.both

// @function                        Returns the label style constant based on the provided label style enumeration.
// @param       this (LabelStyle)   The label style enumeration.
// @returns     (label.style)       The corresponding label style constant.
export method labelStyle(LabelStyle this) =>
    switch this
        LabelStyle.center     => label.style_label_center
        LabelStyle.down       => label.style_label_down
        LabelStyle.left       => label.style_label_left
        LabelStyle.right      => label.style_label_right
        LabelStyle.up         => label.style_label_up
        LabelStyle.lowLeft    => label.style_label_lower_left
        LabelStyle.lowRight   => label.style_label_lower_right
        LabelStyle.upperLeft  => label.style_label_upper_left
        LabelStyle.upperRight => label.style_label_upper_right

//#endregion INPUT METHODS

//+-----------------------------------------------------+
//                      FUNCTIONS                       |
//+-----------------------------------------------------+
//#region FUNCTIONS

// @function                        Combines the provided hour and minute enum data into a single time string.
// @param       h (hours enum)      The hour string.
// @param       m (minutes enum)    The minute string.
// @returns     (string)            The combined time string. IE: "hhmm"
export combineTime (hours h, minutes m) =>
    str.tostring(h) + str.tostring(m)

// @function  getTZOffset (string)  Measures the difference between the provided time zone and UTC.
// @param     _userTZ (string)      The IANA time zone name (e.g., "America/New_York").
// @returns   (int)                 The difference in hours between the provided time zone and UTC. Can return fractional hours.
export getTZOffset(string _userTimezone = "America/New_York") =>
    int dstTime = timestamp(_userTimezone, year, month, dayofmonth, 0, 0)
    int stableTime = timestamp("Etc/UTC", year, month, dayofmonth, 0, 0)
    (stableTime - dstTime)

// @function                        Converts common span names to milliseconds.
// @param       _timeSpan (string)  Span name.
// @returns     (int)               Milliseconds for the requested span.
export timeSpan(string _timeSpan) =>
    switch _timeSpan
        "Minute"        => 60000
        "Minutes"       => 60000
        "Half Hour"     => 1800000
        "Hour"          => 3600000
        "Hours"         => 3600000
        "4 Hours"       => 14400000
        "8 Hours"       => 28800000
        "12 Hours"      => 43200000
        "Day"           => 86400000
        "Week"          => 604800000

// @function                           Splits a compact HHMM string into integer hour and minute values.
// @param       _hhmmString (string)   Four-character time string. Example: "1430".
// @returns     ([int, int])           [hourInt, minuteInt] or [na, na] when the string is invalid.
export hhmmStringToParts(string _hhmmString) =>
    bool lengthOk = str.length(_hhmmString) == 4
    float hh = lengthOk ? str.tonumber(str.substring(_hhmmString, 0, 2)) : na
    float mm = lengthOk ? str.tonumber(str.substring(_hhmmString, 2, 4)) : na

    if na(hh) or na(mm)
        [int(na), int(na)]
    else
        int hourInt = int(hh)
        int minuteInt = int(mm)
        if hourInt < 0 or hourInt > 23 or minuteInt < 0 or minuteInt > 59
            [int(na), int(na)]
        else
            [hourInt, minuteInt]

//#endregion FUNCTIONS
