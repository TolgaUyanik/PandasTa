//@version=6
indicator("Aggression & Absorption Indicator", overlay = true)

// --- Groups ---
string G_MANIP = "Agression Settings (Daily ATR)"
string G_ABS   = "Absorption Settings (Local ATR)"
string G_DASH  = "Dashboard Settings"

// --- Inputs ---
bool  showAtrDash   = input.bool(true, "Show ATR Dashboard", group = G_MANIP)
int   atrLen        = input.int(14, "Daily ATR Length", group = G_MANIP)
float atrThreshold  = input.float(20, "ATR Threshold %", tooltip = "Minimum % of Daily ATR a candle must consume to be highlighted.", group = G_MANIP)
float bodyThreshold = input.float(20, "Body Threshold % (Agression)", tooltip = "If the candle body is greater than this % of its total range, it is considered Aggression.", group = G_MANIP)
color aggrColor     = input.color(color.purple, "Aggression Candle Color", group = G_MANIP)

// Absorption specific inputs (Using local timeframe for better detection)
int   absAtrLen     = input.int(14, "Local ATR Length", group = G_ABS)
float absRangeMult  = input.float(1.0, "ATR Range Multiplier", minval = 0.1, step = 0.1, tooltip = "Minimum candle range relative to local ATR to filter out noise", group = G_ABS)
float volThresh     = input.float(1.5, "Volume Multiplier", minval = 0.1, step = 0.1, tooltip = "How many times the average volume is required to consider it 'High Volume'", group = G_ABS)
float wickThresh    = input.float(0.5, "Wick Ratio", minval = 0.1, maxval = 1.0, step = 0.1, tooltip = "Minimum portion of the candle that must be a wick to signal absorption", group = G_ABS)

color absColor           = input.color(color.white, "Absorption Candle Color", group = G_ABS)
color bullAbsBubbleColor = input.color(#089981, "Bullish Abs Bubble Color", group = G_ABS)
color bearAbsBubbleColor = input.color(color.red, "Bearish Abs Bubble Color", group = G_ABS)

string dashPosStr   = input.string("Bottom Right", "Dashboard Position", options = ["Top Right", "Top Left", "Top Center", "Middle Right", "Middle Left", "Middle Center", "Bottom Right", "Bottom Left", "Bottom Center"], group = G_DASH)
string dashSizeStr  = input.string("Small", "Dashboard Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = G_DASH)

// --- Helper Functions ---
getPos(str) =>
    switch str
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

getSize(str) =>
    switch str
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.small

// --- Calculations ---
candleRange = high - low
bodySize = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

// Aggression Logic (Based on Daily ATR)
dailyAtr = request.security(syminfo.tickerid, "D", ta.atr(atrLen)[1], lookahead = barmerge.lookahead_on)
float requiredRange = dailyAtr * (atrThreshold / 100)

bool isManipCandle = candleRange >= requiredRange
bool isAggr = isManipCandle and (candleRange > 0 ? (bodySize / candleRange) >= (bodyThreshold / 100) : false)

// Absorption Logic (Based on Local Timeframe ATR like the old script)
localAtr = ta.atr(absAtrLen)
volSma = ta.sma(volume, 20)

bool isHighVolume = volume > volSma * volThresh
bool isSignificantRange = candleRange > localAtr * absRangeMult

// Bullish Absorption: High volume, significant local range, and large lower wick
bool bullishAbsorption = isHighVolume and isSignificantRange and (lowerWick > candleRange * wickThresh)

// Bearish Absorption: High volume, significant local range, and large upper wick
bool bearishAbsorption = isHighVolume and isSignificantRange and (upperWick > candleRange * wickThresh)

bool isAbs = bullishAbsorption or bearishAbsorption

// Avoid overlap (prioritize Absorption visually if both happen)
color finalColor = isAbs ? absColor : isAggr ? aggrColor : na
barcolor(finalColor, title = "Agression/Absortion Candle Color")

// Bubbles for Absorption
plotshape(bullishAbsorption, title = "Bullish Absorption Bubble", style = shape.circle, location = location.belowbar, color = bullAbsBubbleColor, size = size.small)
plotshape(bearishAbsorption, title = "Bearish Absorption Bubble", style = shape.circle, location = location.abovebar, color = bearAbsBubbleColor, size = size.small)

// --- ATR Dashboard ---
string dashPos = getPos(dashPosStr)
string dashSize = getSize(dashSizeStr)

var table atrDash = table.new(dashPos, 2, 3, bgcolor = color.new(#1e222d, 10), border_width = 1, border_color = color.new(#5d606b, 50))

if showAtrDash and barstate.islast
    table.set_position(atrDash, dashPos)
    
    table.cell(atrDash, 0, 0, "Metric", text_color = color.white, text_size = dashSize, bgcolor = color.new(#131722, 0))
    table.cell(atrDash, 1, 0, "Value", text_color = color.white, text_size = dashSize, bgcolor = color.new(#131722, 0))
    
    table.cell(atrDash, 0, 1, "Daily ATR (" + str.tostring(atrLen) + ")", text_color = color.white, text_size = dashSize)
    table.cell(atrDash, 1, 1, str.tostring(dailyAtr, "#.##"), text_color = color.yellow, text_size = dashSize)
    
    color atrRangeColor = isManipCandle ? color.green : color.red
    
    table.cell(atrDash, 0, 2, "Current Range", text_color = color.white, text_size = dashSize)
    table.cell(atrDash, 1, 2, str.tostring(candleRange, "#.##") + " (Req: " + str.tostring(requiredRange, "#.##") + ")", text_color = atrRangeColor, text_size = dashSize)
