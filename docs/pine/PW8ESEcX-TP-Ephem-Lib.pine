// ============================================================================
// PUBLIC API — PLANET ENUM, JULIAN DAY CONVERSION, LONGITUDE ACCESSORS
// ============================================================================

// Cowan-essential bodies. Order matches IMCCE planet numbering (Mercury=1, ...).
export enum Planet
    Mercury
    Venus
    Earth
    Mars
    Jupiter
    Saturn
    Uranus
    Neptune

// Convert a TradingView `time` (Unix milliseconds since 1970-01-01 UTC)
// to Julian Day (TT, ignoring TT-UTC <90s offset which is below our precision).
//   JD(unix) = unix_ms / 86,400,000 + 2440587.5
export jd_from_timestamp(int unix_ms) =>
    unix_ms / 86400000.0 + 2440587.5

// Inverse: convert Julian Day to TradingView `time` (Unix ms).
export timestamp_from_jd(float jd) =>
    int(math.round((jd - 2440587.5) * 86400000.0))

// Normalize longitude into [0, 360).
// Pine v6 has no math.fmod — use floor-mod which handles negatives correctly.
export normalize_longitude(float deg) =>
    deg - 360.0 * math.floor(deg / 360.0)

// ============================================================================
// SIDEREAL CORRECTION — Lahiri ayanamsa (Cowan canon V4:L239 prefers sidereal)
// ----------------------------------------------------------------------------
// VSOP87D returns TROPICAL (ecliptic of date) longitudes. To convert to
// SIDEREAL (fixed-star) longitudes, subtract the ayanamsa — the offset between
// the moving tropical equinox and the fixed sidereal zero.
//
// We use the **Lahiri ayanamsa** (Chitrapaksha / Indian government standard):
//   - At J2000.0 (JD 2451545.0): 23.853 degrees
//   - Annual precession rate: 50.288 arcsec/yr = 0.013969 deg/yr
// Linear formula (good to <0.01 deg over 1850-2150):
//   ayanamsa(JD) = 23.853 + 0.013969 * (JD - 2451545.0) / 365.25
//
// Note for Cowan work: synodic phases, cumulative advances, pentagram vertices
// and other RELATIVE measures are FRAME-INDEPENDENT (the ayanamsa cancels).
// Sidereal correction matters only for ABSOLUTE positions (e.g. "Mars 19 deg
// Virgo"). Default useSidereal = false = tropical (as in VSOP87D natively).
// ============================================================================

// Lahiri ayanamsa at the given Julian Day, in degrees.
export get_ayanamsa(float jd) =>
    23.853 + 0.013969 * (jd - 2451545.0) / 365.25

// Heliocentric ecliptic longitude in DEGREES, normalized to [0, 360).
// useSidereal=false: tropical (ecliptic of date) — VSOP87D native frame.
// useSidereal=true:  sidereal — Lahiri ayanamsa subtracted (Cowan V4:L239).
export get_helio_longitude(simple Planet planet, float jd, simple bool useSidereal = false) =>
    t = jd_to_t_millennia(jd)
    rad = switch planet
        Planet.Mercury => mercury_lon_rad(t)
        Planet.Venus   => venus_lon_rad(t)
        Planet.Earth   => earth_lon_rad(t)
        Planet.Mars    => mars_lon_rad(t)
        Planet.Jupiter => jupiter_lon_rad(t)
        Planet.Saturn  => saturn_lon_rad(t)
        Planet.Uranus  => uranus_lon_rad(t)
        Planet.Neptune => neptune_lon_rad(t)
        => na
    deg_tropical = math.todegrees(rad)
    deg = useSidereal ? deg_tropical - get_ayanamsa(jd) : deg_tropical
    normalize_longitude(deg)

// Geocentric Sun longitude derived from heliocentric Earth + 180 deg.
// Useful for Mercury/Venus geo work and zodiacal Sun position.
export get_sun_geo_longitude(float jd, simple bool useSidereal = false) =>
    earth = get_helio_longitude(Planet.Earth, jd, useSidereal)
    normalize_longitude(earth + 180.0)


// ============================================================================
// SYNODIC / ASPECT HELPERS
// ----------------------------------------------------------------------------
// A synodic phase is the angular separation between two planets in heliocentric
// ecliptic. Cowan's canon uses synodic phases for cube face boundaries (S-U,
// V1:L2962-2997), 22.5 deg config switch (J-S, J-U, V1:L3839), and the
// 67-year periodicity (1.5 x S-U synodic, V1:L3127-3141).
//
// CONVENTION: pass the FASTER planet first (smaller orbital period). Then
// (lon(p1) - lon(p2)) mod 360 increases monotonically with time at the synodic
// rate. For Saturn-Uranus pass (Saturn, Uranus) — Saturn moves faster.
// For Jupiter-Saturn pass (Jupiter, Saturn). Etc.
//
// Frame independence: synodic phase is invariant under tropical vs sidereal
// because the ayanamsa cancels in the subtraction. The useSidereal flag is
// kept here for API consistency but produces the same numerical result.
// ============================================================================

// Synodic angular separation in degrees, normalized to [0, 360).
//   phase = (lon(p1) - lon(p2)) mod 360
// Pass the faster planet first for monotonic growth.
export get_synodic_phase(simple Planet p1, simple Planet p2, float jd) =>
    a = get_helio_longitude(p1, jd, false)
    b = get_helio_longitude(p2, jd, false)
    normalize_longitude(a - b)

// Signed aspect angle in degrees, in (-180, +180].
//   positive = p1 leads p2; negative = p1 trails p2
//   0 = conjunction; +/-180 = opposition
// Useful for direction-aware logic (advancing vs retreating aspect).
export get_aspect_angle(simple Planet p1, simple Planet p2, float jd) =>
    phase = get_synodic_phase(p1, p2, jd)
    phase > 180.0 ? phase - 360.0 : phase


// ============================================================================
// COWAN-SPECIFIC HELPERS
// ----------------------------------------------------------------------------
// All helpers operate on RELATIVE angular advances from a user-supplied origin
// (usually a market's birth/origin date or a known turn). This matches
// Cowan's "3-Step Astro Process" (V4:L5079):
//   1. Identify a top or bottom
//   2. Find planet heliocentric positions at that date
//   3. Add multiples of harmonic angles to project future cycle points
// ============================================================================

// AVERAGE orbital speed in degrees per day for each Cowan body. Constant per
// planet, derived from its sidereal period (NOT a position calculator).
//
// Used internally as a bracket/initial-guess aid for the root-finders
// (find_advance_jd, find_synodic_advance_jd). For ACTUAL position at a date,
// always use get_helio_longitude(planet, jd) which returns Keplerian-accurate
// true longitude (eccentricity + perturbations included, validated < 0.01 deg
// vs Swiss Ephemeris). For ACTUAL instantaneous speed at a date use
// speed_deg_per_day(planet, jd) which is the real numerical derivative.
//
// Values from VSOP87D L1 first term: motion_rad_per_millennium / 365250.
export average_speed_deg_per_day(simple Planet planet) =>
    switch planet
        Planet.Mercury => 4.0923344368
        Planet.Venus   => 1.6021302244
        Planet.Earth   => 0.9856473356
        Planet.Mars    => 0.5240207766
        Planet.Jupiter => 0.0830853001
        Planet.Saturn  => 0.0334597203
        Planet.Uranus  => 0.0117316530
        Planet.Neptune => 0.0059800911
        => 0.0

// Numerical speed in degrees per day, central difference at jd.
// Positive = direct (prograde) motion. Negative = retrograde.
export speed_deg_per_day(simple Planet planet, float jd) =>
    h = 0.5
    a = get_helio_longitude(planet, jd - h, false)
    b = get_helio_longitude(planet, jd + h, false)
    delta = b - a
    // wrap delta into [-180, +180] so retrogrades read as small negative numbers
    delta_norm = delta > 180.0 ? delta - 360.0 : delta < -180.0 ? delta + 360.0 : delta
    delta_norm / (2.0 * h)

// True if the planet is currently retrograde (speed < 0). Heliocentric speed
// is rarely retrograde — outer planets are never retrograde HELIOCENTRICALLY.
// Use this from a geocentric tool (where Mercury/Venus/Mars retrograde matters).
export is_retrograde(simple Planet planet, float jd) =>
    speed_deg_per_day(planet, jd) < 0.0

// CUMULATIVE angular advance in degrees from origin_jd to target_jd.
// Returns SIGNED total (positive forward, negative backward); not modulo 360.
// Used by 3-Step Astro (V4:L5079) and pentagram/cube-face calculations.
export cumulative_advance_deg(simple Planet planet, float origin_jd, float target_jd, simple bool useSidereal = false) =>
    lon_origin = get_helio_longitude(planet, origin_jd, useSidereal)
    lon_target = get_helio_longitude(planet, target_jd, useSidereal)
    adv_modular = normalize_longitude(lon_target - lon_origin)
    mm = average_speed_deg_per_day(planet)
    expected_total = mm * (target_jd - origin_jd)
    n = math.round((expected_total - adv_modular) / 360.0)
    n * 360.0 + adv_modular

// CUMULATIVE synodic advance in degrees from origin_jd to target_jd.
// Returns SIGNED total (positive forward); not modulo 360.
// For S-U cube faces (V1:L2962), J-S/J-U 22.5 config (V1:L3839), etc.
// Pass the FASTER planet first.
export cumulative_synodic_advance_deg(simple Planet p1, simple Planet p2, float origin_jd, float target_jd) =>
    syn_origin = get_synodic_phase(p1, p2, origin_jd)
    syn_target = get_synodic_phase(p1, p2, target_jd)
    adv_modular = normalize_longitude(syn_target - syn_origin)
    mm_synodic = average_speed_deg_per_day(p1) - average_speed_deg_per_day(p2)
    expected_total = mm_synodic * (target_jd - origin_jd)
    n = math.round((expected_total - adv_modular) / 360.0)
    n * 360.0 + adv_modular

// ----------------------------------------------------------------------------
// ROOT FINDING — given a target angular advance, locate the JD where it occurs.
// Bisection with a mean-motion-derived initial estimate.
// Risk: inner-planet retrograde windows can break monotonicity. Bracket is
// generous; for Cowan's outer-planet work (Saturn, Uranus, S-U) no issue.
// ----------------------------------------------------------------------------

// Find the JD where `planet` has cumulatively advanced exactly target_advance_deg
// from origin_jd. target_advance_deg may be > 360 for multi-orbit advances.
export find_advance_jd(simple Planet planet, float origin_jd, float target_advance_deg, simple bool useSidereal = false) =>
    mm = average_speed_deg_per_day(planet)
    initial = origin_jd + target_advance_deg / mm
    // Bracket: 1/4 of an orbital period each side, never less than 30 days
    bracket = math.max(30.0, 90.0 / mm)
    a = initial - bracket
    b = initial + bracket
    for i = 0 to 60
        mid = (a + b) / 2.0
        adv_mid = cumulative_advance_deg(planet, origin_jd, mid, useSidereal)
        if adv_mid < target_advance_deg
            a := mid
        else
            b := mid
        if math.abs(b - a) < 0.001
            break
    (a + b) / 2.0

// Find the JD where the synodic pair (p1 faster, p2 slower) has cumulatively
// advanced target_synodic_advance_deg from origin_jd.
export find_synodic_advance_jd(simple Planet p1, simple Planet p2, float origin_jd, float target_synodic_advance_deg) =>
    mm_synodic = average_speed_deg_per_day(p1) - average_speed_deg_per_day(p2)
    initial = origin_jd + target_synodic_advance_deg / mm_synodic
    bracket = math.max(60.0, 180.0 / math.abs(mm_synodic))
    a = initial - bracket
    b = initial + bracket
    for i = 0 to 60
        mid = (a + b) / 2.0
        adv_mid = cumulative_synodic_advance_deg(p1, p2, origin_jd, mid)
        if adv_mid < target_synodic_advance_deg
            a := mid
        else
            b := mid
        if math.abs(b - a) < 0.001
            break
    (a + b) / 2.0

// ----------------------------------------------------------------------------
// PENTAGRAM VERTICES — V4:L449, V4:L1535. Five 72-deg points around Uranus
// (or Saturn 216, Earth-Venus 216) define the pentagram. n = 1..5 gives the
// 5 vertex dates from origin_jd. Beyond n=5, returns later cycles.
// ----------------------------------------------------------------------------

// Date of the n-th pentagram vertex of `planet` from origin_jd.
// n=1 => 72 deg advance, n=2 => 144 deg, n=3 => 216 deg, n=4 => 288 deg, n=5 => 360 deg (cycle).
export pentagram_vertex_jd(simple Planet planet, float origin_jd, simple int n, simple bool useSidereal = false) =>
    target = 72.0 * n
    find_advance_jd(planet, origin_jd, target, useSidereal)

// ----------------------------------------------------------------------------
// CUBE FACE BOUNDARIES — V1:L2106-2114, V1:L2962-2997.
// The 6 faces of a Cowan master cube are defined by S-U synodic milestones
// plus Uranus 360 (one full master cube = one Uranus sidereal cycle).
//   face 1 ends at S-U  90 deg from origin
//   face 2 ends at S-U 180 deg
//   face 3 ends at S-U 270 deg
//   face 4 ends at S-U 360 deg (=0, after one full S-U cycle)
//   face 5 ends at S-U 540 deg (1.5 S-U cycles, = 67-yr periodicity per V1:L3127)
//   face 6 ends at Uranus 360 deg from origin (master cube completion)
// ----------------------------------------------------------------------------

// JD where the face_n boundary is reached, measured from cube origin_jd.
//   face_n in 1..6 returns the boundary at the END of that face.
export cube_face_boundary_jd(float origin_jd, simple int face_n) =>
    target_su = switch face_n
        1 =>  90.0
        2 => 180.0
        3 => 270.0
        4 => 360.0
        5 => 540.0
        => 0.0
    if face_n == 6
        find_advance_jd(Planet.Uranus, origin_jd, 360.0, false)
    else
        find_synodic_advance_jd(Planet.Saturn, Planet.Uranus, origin_jd, target_su)

