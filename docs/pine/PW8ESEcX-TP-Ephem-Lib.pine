// of this software and associated documentation files (the "Software"), to deal
// in the Software without restriction, including without limitation the rights
// to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
// copies of the Software, and to permit persons to whom the Software is
// furnished to do so, subject to the following conditions:
//
// The above copyright notice and this permission notice shall be included in
// all copies or substantial portions of the Software.
//
// THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
// IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
// AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
// LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
// OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
// THE SOFTWARE.
// ============================================================================

// @description  Cowan-tailored heliocentric ephemeris (VSOP87D) for TradingView.
// @description  Returns heliocentric ecliptic longitudes for Mercury through Neptune
// @description  (tropical or sidereal/Lahiri), synodic phases between any two planets,
// @description  and Cowan-canon helpers: 3-Step Astro cumulative advance (V4:L5079),
// @description  pentagram vertex dates (V4:L449), and cube-face boundary dates
// @description  (V1:L2106-2114, V1:L2962-2997). All math validated to <0.01 deg vs
// @description  Swiss Ephemeris (DE441) across 1899-2026. Frame: ecliptic of date.
library("TP_Ephem_Lib", overlay = false)

// ============================================================================
// VSOP87D COEFFICIENT TABLES — heliocentric ecliptic longitude (variable L)
// ----------------------------------------------------------------------------
// Each planet has six sub-series L0..L5 corresponding to powers of T (Julian
// centuries since J2000.0). Each sub-series stores three parallel arrays:
//     A_terms — amplitude   (radians for L; units of A·cos(B + C·t))
//     B_terms — phase       (radians)
//     C_terms — frequency   (radians per Julian millennium)
// Term contribution: A * cos(B + C*t).
// Final longitude: L = sum_p (T^p * sum_i A_p[i]*cos(B_p[i] + C_p[i]*T))
//   where T is Julian millennia since J2000.0 (= centuries / 10).
// VSOP87D natively uses millennia for C; we follow that convention.
// ============================================================================

// ===== MERCURY — heliocentric ecliptic longitude (VSOP87D) =====
// Truncation: L0=80 L1=50 L2=30 L3=15 L4=8 L5=4

// ===== VENUS — heliocentric ecliptic longitude (VSOP87D) =====
// Truncation: L0=80 L1=50 L2=30 L3=15 L4=8 L5=4

// ===== EARTH — heliocentric ecliptic longitude (VSOP87D) =====
// Truncation: L0=80 L1=50 L2=30 L3=15 L4=8 L5=4

// ===== MARS — heliocentric ecliptic longitude (VSOP87D) =====
// Truncation: L0=80 L1=50 L2=30 L3=15 L4=8 L5=4

// ===== JUPITER — heliocentric ecliptic longitude (VSOP87D) =====
// Truncation: L0=50 L1=25 L2=15 L3=8 L4=4 L5=2

// ===== SATURN — heliocentric ecliptic longitude (VSOP87D) =====
// Truncation: L0=50 L1=25 L2=15 L3=8 L4=4 L5=2

// ===== URANUS — heliocentric ecliptic longitude (VSOP87D) =====
// Truncation: L0=50 L1=25 L2=15 L3=8 L4=4 L5=2

// ===== NEPTUNE — heliocentric ecliptic longitude (VSOP87D) =====
// Truncation: L0=50 L1=25 L2=15 L3=8 L4=4 L5=2


// ============================================================================
// CORE SERIES EVALUATION
// ============================================================================

// Julian Day at J2000.0 (2000-01-01 12:00 TT)
J2000_JD = 2451545.0
// Days per Julian millennium (used as VSOP87D's t unit)
JULIAN_MILLENNIUM_DAYS = 365250.0
// Two pi constant for longitude wrap-around
TWO_PI_RAD = 6.28318530717958647692528676655900576

// Convert a Julian Day to Julian millennia since J2000.0.
//   t = (jd - 2451545.0) / 365250
//   matches VSOP87D's natural time argument.
// Convert a Julian Day to Julian millennia since J2000.0 (VSOP87D's t unit).
export jd_to_t_millennia(float jd) =>
    (jd - J2000_JD) / JULIAN_MILLENNIUM_DAYS

// Evaluate one VSOP87D sub-series at time t (millennia).
//   contribution = sum_i A[i] * cos(B[i] + C[i]*t)
// Pine v6 gotcha: empty arrays must be guarded — for-loop with start>end iterates backward.
evaluate_series(float[] A, float[] B, float[] C, float t) =>
    sum = 0.0
    n = array.size(A)
    if n > 0
        for i = 0 to n - 1
            sum := sum + array.get(A, i) * math.cos(array.get(B, i) + array.get(C, i) * t)
    sum

// Combine six L_p sub-series at time t into total heliocentric longitude (radians).
//   L = s0 + t*s1 + t^2*s2 + t^3*s3 + t^4*s4 + t^5*s5
// Result NOT yet normalized to [0, 2pi); caller may apply mod TWO_PI_RAD.
// One private wrapper per planet so it can reference its own arrays directly
// (Pine v6 cannot dispatch arrays-of-arrays at runtime).

mercury_lon_rad(float t) =>
