//@version=6
indicator("Candle Colors Counter", overlay = true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

countLength = input.int(
     10,
     minval = 1,
     title = "Кількість свічок разом з останньою"
)

tablePositionInput = input.string(
     "Bottom Left",
     title = "Положення таблиці",
     options = [
         "Top Left",
         "Top Right",
         "Bottom Left",
         "Bottom Right"
     ]
)

showNeutral = input.bool(
     true,
     title = "Показувати нейтральні свічки"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TABLE POSITION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

tablePosition =
     tablePositionInput == "Top Left"     ? position.top_left :
     tablePositionInput == "Top Right"    ? position.top_right :
     tablePositionInput == "Bottom Right" ? position.bottom_right :
     position.bottom_left

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COUNT CANDLES
//
// Починаємо з [0], тому поточна остання свічка враховується.
// При countLength = 10 рахуємо свічки від [0] до [9].
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

int whiteCandles = 0
int blackCandles = 0
int neutralCandles = 0

int availableCandles = math.min(countLength, bar_index + 1)

for i = 0 to availableCandles - 1
    if close[i] > open[i]
        whiteCandles += 1
    else if close[i] < open[i]
        blackCandles += 1
    else
        neutralCandles += 1

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DOMINANCE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

string dominanceText =
     whiteCandles > blackCandles ? "ПЕРЕВАГА БІЛИХ" :
     blackCandles > whiteCandles ? "ПЕРЕВАГА ЧОРНИХ" :
     "БАЛАНС"

color dominanceColor =
     whiteCandles > blackCandles ? color.green :
     blackCandles > whiteCandles ? color.red :
     color.gray

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TABLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table candleTable = table.new(
     tablePosition,
     2,
     5,
     border_width = 1
)

if barstate.islast
    table.clear(candleTable, 0, 0, 1, 4)

    table.cell(
         candleTable,
         0,
         0,
         "СВІЧОК",
         bgcolor = color.black,
         text_color = color.white
    )

    table.cell(
         candleTable,
         1,
         0,
         str.tostring(availableCandles),
         bgcolor = color.black,
         text_color = color.white
    )

    table.cell(
         candleTable,
         0,
         1,
         "БІЛІ",
         bgcolor = color.new(color.green, 70),
         text_color = color.white
    )

    table.cell(
         candleTable,
         1,
         1,
         str.tostring(whiteCandles),
         bgcolor = color.new(color.green, 70),
         text_color = color.white,
         text_size = size.large
    )

    table.cell(
         candleTable,
         0,
         2,
         "ЧОРНІ",
         bgcolor = color.new(color.red, 70),
         text_color = color.white
    )

    table.cell(
         candleTable,
         1,
         2,
         str.tostring(blackCandles),
         bgcolor = color.new(color.red, 70),
         text_color = color.white,
         text_size = size.large
    )

    if showNeutral
        table.cell(
             candleTable,
             0,
             3,
             "НЕЙТРАЛЬНІ",
             bgcolor = color.new(color.gray, 70),
             text_color = color.white
        )

        table.cell(
             candleTable,
             1,
             3,
             str.tostring(neutralCandles),
             bgcolor = color.new(color.gray, 70),
             text_color = color.white
        )

    table.cell(
         candleTable,
         0,
         4,
         dominanceText,
         bgcolor = dominanceColor,
         text_color = color.white
    )

    table.merge_cells(candleTable, 0, 4, 1, 4)