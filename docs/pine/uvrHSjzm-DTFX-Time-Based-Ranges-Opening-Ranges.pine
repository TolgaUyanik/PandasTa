// © MrWangTactics — modified by zeeTAJ — V TBR (S/R Flip) logic added
// Combined with Opening Range (Asian, London, NY) — NY OR default 09:30‑10:00
// Added custom line style for OR high/low lines
// Added labels: "A OR", "L OR", "NY OR" — with show/hide, color & size options

//@version=6
indicator("DTFX Time Based Ranges + Opening Ranges", "OR+TBR by zeeTFX", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)


// =================================================================================================
//                                  AUTO LIGHT / DARK THEME VISIBILITY
// =================================================================================================
// Auto uses TradingView's chart foreground color, so text follows the active chart theme.
// Manual Light/Dark can be selected from settings if you want fixed text colors.
var string THEME_GROUP = "THEME / VISIBILITY"
theme_mode           = input.string("Auto", "Theme Mode", options = ["Auto", "Light", "Dark"], group = THEME_GROUP)
theme_light_text_col = input.color(color.black, "Light Theme Text Color", group = THEME_GROUP)
theme_dark_text_col  = input.color(color.white, "Dark Theme Text Color", group = THEME_GROUP)
theme_text_col       = theme_mode == "Auto" ? chart.fg_color : theme_mode == "Light" ? theme_light_text_col : theme_dark_text_col

// =================================================================================================
//                                  DTFX TIME BASED RANGES (original)
// =================================================================================================

var string HEADER = "Enable    Hour                                Minute                                Timeframe            "
var bool active_1 = input.bool(true,"", group = HEADER, inline = "group_1")
var int hour_1 = input.int(9, "", group = HEADER, minval = 0, maxval = 23, inline = "group_1")
var int minute_1 = input.int(0, "", group = HEADER, minval = 0, maxval = 59, inline = "group_1")
var string timeframe_1 = input.timeframe("60", "", group = HEADER, inline = "group_1")
color_1 = input.color(color.blue, " ",  group = HEADER,inline = "group_1")

var bool active_2 = input.bool(true,"", group = HEADER, inline = "group_2")
var int hour_2 = input.int(15, "", group = HEADER, minval = 0, maxval = 23, inline = "group_2")
var int minute_2 = input.int(0, "", group = HEADER, minval = 0, maxval = 59, inline = "group_2")
var string timeframe_2 = input.timeframe("60", "", group = HEADER, inline = "group_2")
color_2 = input.color(color.orange, "",  group = HEADER,inline = "group_2")

var bool active_3 = input.bool(false,"", group = HEADER, inline = "group_3")
var int hour_3 = input.int(0, "", group = HEADER, inline = "group_3")
var int minute_3 = input.int(0, "", group = HEADER, minval = 0, maxval = 59, inline = "group_3")
var string timeframe_3 = input.timeframe("60", "", group = HEADER, inline = "group_3")
color_3 = input.color(color.gray, "",  group = HEADER,inline = "group_3")

var bool active_4 = input.bool(false,"", group = HEADER, inline = "group_4")
var int hour_4 = input.int(0, "", group = HEADER, inline = "group_4")
var int minute_4 = input.int(0, "", group = HEADER, minval = 0, maxval = 59, inline = "group_4")
var string timeframe_4 = input.timeframe("60", "", group = HEADER, inline = "group_4")
color_4 = input.color(color.gray, "",  group = HEADER,inline = "group_4")

var bool active_5 = input.bool(false,"", group = HEADER, inline = "group_5")
var int hour_5 = input.int(0, "", group = HEADER, inline = "group_5")
var int minute_5 = input.int(0, "", group = HEADER, minval = 0, maxval = 59, inline = "group_5")
var string timeframe_5 = input.timeframe("60", "", group = HEADER, inline = "group_5")
color_5 = input.color(color.gray, "",  group = HEADER,inline = "group_5")

var bool active_6 = input.bool(false,"", group = HEADER, inline = "group_6")
var int hour_6 = input.int(0, "", group = HEADER, inline = "group_6")
var int minute_6 = input.int(0, "", group = HEADER, minval = 0, maxval = 59, inline = "group_6")
var string timeframe_6 = input.timeframe("60", "", group = HEADER, inline = "group_6")
color_6 = input.color(color.gray, "",  group = HEADER,inline = "group_6")

var bool active_7 = input.bool(false,"", group = HEADER, inline = "group_7")
var int hour_7 = input.int(0, "", group = HEADER, inline = "group_7")
var int minute_7 = input.int(0, "", group = HEADER, minval = 0, maxval = 59, inline = "group_7")
var string timeframe_7 = input.timeframe("60", "", group = HEADER, inline = "group_7")
color_7 = input.color(color.gray, "",  group = HEADER,inline = "group_7")

var bool active_8 = input.bool(false,"", group = HEADER, inline = "group_8")
var int hour_8 = input.int(0, "", group = HEADER, inline = "group_8")
var int minute_8 = input.int(0, "", group = HEADER, minval = 0, maxval = 59, inline = "group_8")
var string timeframe_8 = input.timeframe("60", "", group = HEADER, inline = "group_8")
color_8 = input.color(color.gray, "",  group = HEADER,inline = "group_8")

// === Line thickness ===
var int line_thickness = input.int(2, "Global Line Thickness", minval = 1, maxval = 4, group = "LINE SETTINGS")

// === High/Low Settings ===
var bool show_high_line  = input.bool(true, "Show High (100%)", group = "HIGH/LOW SETTINGS", inline = "hl_toggle")
var bool show_low_line   = input.bool(true, "Show Low (0%)", group = "HIGH/LOW SETTINGS", inline = "hl_toggle")
var bool extend_hl_lines = input.bool(false, "Extend 0% & 100% Lines", group = "HIGH/LOW SETTINGS", inline = "ext_hl")
var color extend_hl_col  = input.color(color.gray, "Extended Line Color",   group = "HIGH/LOW SETTINGS", inline = "ext_hl")
var string extend_hl_style_str = input.string('Solid', "Extended Line Style", options = ['Solid', 'Dashed', 'Dotted'], group = "HIGH/LOW SETTINGS", inline = "ext_hl_style")
var int extend_hl_width  = input.int(1, "Extended Line Thickness", minval = 1, maxval = 4, group = "HIGH/LOW SETTINGS", inline = "ext_hl_style")
var string hl_style_str  = input.string('Solid', "Line Style", options = ['Solid', 'Dashed', 'Dotted'], group = "HIGH/LOW SETTINGS", inline = "hl_style")
var color hl_custom_col  = input.color(color.gray, "Line Color (default zones)", group = "HIGH/LOW SETTINGS", inline = "hl_style")

// ── 9AM ZONE COLORS ──────────────────────────────────────────────────────────
var color z1_box_bg   = input.color(color.new(color.blue, 100), "Box Fill",    group = "9AM ZONE COLORS", inline = "z1_box")
var color z1_box_bord = input.color(color.new(color.blue,  100), "Box Border",  group = "9AM ZONE COLORS", inline = "z1_box")
var color z1_hl_col   = input.color(color.blue,                "H/L Lines",   group = "9AM ZONE COLORS")

// ── 3PM ZONE COLORS ──────────────────────────────────────────────────────────
var color z2_box_bg   = input.color(color.new(color.orange, 100), "Box Fill",  group = "3PM ZONE COLORS", inline = "z2_box")
var color z2_box_bord = input.color(color.new(color.orange,  100), "Box Border",group = "3PM ZONE COLORS", inline = "z2_box")
var color z2_hl_col   = input.color(color.orange,                "H/L Lines", group = "3PM ZONE COLORS")

// ── BOX SETTINGS (zones 3-8) ─────────────────────────────────────────────────
var color box_bg_col     = input.color(color.new(color.gray, 85), "Background Color", group = "BOX SETTINGS (Other Zones)")
var color box_border_col = input.color(color.new(color.gray,  0), "Border Color",     group = "BOX SETTINGS (Other Zones)")
var int   box_border_w   = input.int(1, "Border Width", minval = 1, maxval = 4,        group = "BOX SETTINGS (Other Zones)")
var string box_border_sty= input.string('Solid', "Border Style", options = ['Solid','Dashed','Dotted'], group = "BOX SETTINGS (Other Zones)")

box_bstyle = switch box_border_sty
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

// === 50% Settings ===
var string style_50_str  = input.string('Solid', "50% Style", options = ['Solid', 'Dashed', 'Dotted'], group = "50% MIDPOINT SETTINGS")
var color col_50         = input.color(color.gray, "50% Color", group = "50% MIDPOINT SETTINGS")
var int thick_50         = input.int(2, "50% Thickness", minval = 1, maxval = 4, group = "50% MIDPOINT SETTINGS")
var bool show_50_label   = input.bool(true, "Show 'T B R' Label", group = "50% MIDPOINT SETTINGS")
var bool extend_50_line  = input.bool(false, "Extend 50% (9AM & 3PM only)", group = "50% MIDPOINT SETTINGS")

// === 30% / 70% Settings ===
var bool show_30_line    = input.bool(false, "Show 30% line", group = "30% & 70% SETTINGS", inline = "3070")
var bool show_70_line    = input.bool(false, "Show 70% line", group = "30% & 70% SETTINGS", inline = "3070")
var string style_3070_str= input.string('Dotted', "30/70 Style", options = ['Solid', 'Dashed', 'Dotted'], group = "30% & 70% SETTINGS")
var color col_3070       = input.color(color.gray, "30/70 Color", group = "30% & 70% SETTINGS")

// ── NEW: VIOLATED (V TBR) SETTINGS ───────────────────────────────────────────
var bool show_vtbr          = input.bool(true,  "Show Violated (V TBR) Zones",   group = "VIOLATED TBR SETTINGS")
var color vtbr_box_bg       = input.color(color.new(#ff3a3a, 80), "Box Fill",    group = "VIOLATED TBR SETTINGS", inline = "vtbr_box")
var color vtbr_box_bord     = input.color(color.new(#ff3a3a,  0), "Box Border",  group = "VIOLATED TBR SETTINGS", inline = "vtbr_box")
var color vtbr_line_col     = input.color(#ff3a3a,                "Line Color",  group = "VIOLATED TBR SETTINGS")
var color vtbr_label_col    = input.color(color.yellow,             "Label Color", group = "VIOLATED TBR SETTINGS")
// ─────────────────────────────────────────────────────────────────────────────

// === General Settings ===
var int percent_mitigation = input.int(100, "% mitigation", minval = 0, maxval = 100, group = "SETTINGS")
var string retracements    = input.string('Hidden', "Retracements Style (Shared)", options = ['Hidden', 'Solid', 'Dashed', 'Dotted'])
var bool extend_box        = input.bool(false, "Extend box", group = "SETTINGS")
var int max_unmitigated    = input.int(5, "Max Unmitigated Zones", group = "SETTINGS")
var bool show_only_2_recent = input.bool(false, "Show only 2 most recent TBRs", group = "SETTINGS")
var string timezone        = input.string('America/New_York', "Timezone", options = ['America/New_York','GMT-12','GMT-11','GMT-10','GMT-9','GMT-8','GMT-7','GMT-6','GMT-5','GMT-4','GMT-3','GMT-2','GMT-1','GMT+0','GMT+1','GMT+2','GMT+3','GMT+4','GMT+5','GMT+6','GMT+7','GMT+8','GMT+9','GMT+10','GMT+11','GMT+12','GMT+13','GMT+14'])
var bool only_validated    = input.bool(true, "Show ONLY Validated TBRs (1H Break)", group = "SETTINGS")
var bool show_mitigated_tbr= input.bool(true, "Show mitigated TBRs (tapped ≥ 30%)", group = "SETTINGS")
var bool show_unvalidated_tbr = input.bool(true, "Show Unvalidated TBRs (Gray)", group = "SETTINGS")

// === Label settings ===
var string label_size_str  = input.string('Small', "Label Size", options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = "SETTINGS")
var bool auto_tbr_label_color = input.bool(true, "Auto TBR Label Text Color", group = "SETTINGS")
var color manual_tbr_label_color  = input.color(color.white, "Manual TBR Label Text Color", group = "SETTINGS")
tbr_label_text_col = auto_tbr_label_color ? theme_text_col : manual_tbr_label_color

// Resolve Styles
label_sz = switch label_size_str
    'Tiny'   => size.tiny
    'Small'  => size.small
    'Normal' => size.normal
    'Large'  => size.large
    =>          size.huge

s_50 = switch style_50_str
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

s_3070 = switch style_3070_str
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

s_hl = switch hl_style_str
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

s_ext_hl = switch extend_hl_style_str
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

var r_style = switch retracements
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    'Dotted' => line.style_dotted
    'Hidden' => na

type Candle
    string tf
    bool active
    bool complete
    int _t
    float _o
    float _h
    float _l
    float _c
    color _color
    bool bull
    box _box
    line _0
    line _30
    line _50
    line _70
    line _100
    float mitigation
    bool retested
    bool isFiftyExtended
    label _50_label
    bool tapped
    bool validated
    // ── per-zone resolved colors (set at candle creation) ──
    color box_bg
    color box_bord
    color hl_col
    // ── separate extension lines for 0% and 100% ──
    line _0_ext
    line _100_ext
    bool hl_extended
    // ── bar_time at which extension lines should begin (10AM / 4PM) ──
    int ext_start_hour
    // ── NEW: S/R flip flag — set when price closes fully through the zone ──
    bool flipped
    // ── Fill object for unvalidated gray fill ──
    linefill _fill = na

type Config
    bool active
    int _hour
    int _minute
    string tf
    color _color
    Candle[] candles
    bool activated
    bool insideBar
    bool alertRetested

var configs = array.new<Config>()

if configs.size() == 0
    configs.push(Config.new(active_1, hour_1, minute_1, timeframe_1, color_1, array.new<Candle>(), false, false))
    configs.push(Config.new(active_2, hour_2, minute_2, timeframe_2, color_2, array.new<Candle>(), false, false))
    configs.push(Config.new(active_3, hour_3, minute_3, timeframe_3, color_3, array.new<Candle>(), false, false))
    configs.push(Config.new(active_4, hour_4, minute_4, timeframe_4, color_4, array.new<Candle>(), false, false))
    configs.push(Config.new(active_5, hour_5, minute_5, timeframe_5, color_5, array.new<Candle>(), false, false))
    configs.push(Config.new(active_6, hour_6, minute_6, timeframe_6, color_6, array.new<Candle>(), false, false))
    configs.push(Config.new(active_7, hour_7, minute_7, timeframe_7, color_7, array.new<Candle>(), false, false))
    configs.push(Config.new(active_8, hour_8, minute_8, timeframe_8, color_8, array.new<Candle>(), false, false))

method drawCandle(Candle candle) =>
    _0p   = candle.bull ? candle._l : candle._h
    _100p = candle.bull ? candle._h : candle._l
    diff  = candle.bull ? candle._h - candle._l : candle._l - candle._h
    _30p  = _0p + (diff * 0.7)
    _50p  = _0p + (diff * 0.5)
    _70p  = _0p + (diff * 0.3)

    c_hl_act = (only_validated and not candle.validated) ? na : candle.hl_col
    c_50_act = (only_validated and not candle.validated) ? na : col_50
    c_30_act = (only_validated and not candle.validated) ? na : col_3070
    c_bg     = (only_validated and not candle.validated) ? na : candle.box_bg
    c_border = (only_validated and not candle.validated) ? na : candle.box_bord
    c_text   = (only_validated and not candle.validated) ? na : tbr_label_text_col

    // ── Override for unvalidated TBRs (gray lines + fill, no box) ────────────
    if show_unvalidated_tbr and not candle.validated
        c_hl_act := color.gray
        c_50_act := color.gray
        c_30_act := color.gray
        c_bg     := na
        c_border := na
        c_text   := color.gray
    // ─────────────────────────────────────────────────────────────────────────

    candle._box := box.new(candle._t, candle._h, time, candle._l, border_color = c_border, border_width = box_border_w, border_style = box_bstyle, bgcolor = c_bg, xloc = xloc.bar_time)

    // Original H/L lines — drawn once, never modified again
    if show_low_line
        candle._0 := line.new(candle._t, candle._l, time, candle._l, color = c_hl_act, style = s_hl, width = line_thickness, xloc = xloc.bar_time)
    if show_high_line
        candle._100 := line.new(candle._t, candle._h, time, candle._h, color = c_hl_act, style = s_hl, width = line_thickness, xloc = xloc.bar_time)

    // ── Create a gray fill between high/low for unvalidated TBRs ─────────────
    if show_unvalidated_tbr and not candle.validated and not na(candle._0) and not na(candle._100)
        candle._fill := linefill.new(candle._0, candle._100, color = color.new(color.gray, 85))
    // ─────────────────────────────────────────────────────────────────────────

    _t_end = extend_box ? candle._t : time

    if show_30_line
        candle._30 := line.new(_t_end, _30p, time, _30p, color = c_30_act, style = s_3070, width = line_thickness, xloc = xloc.bar_time)
    if show_70_line
        candle._70 := line.new(_t_end, _70p, time, _70p, color = c_30_act, style = s_3070, width = line_thickness, xloc = xloc.bar_time)

    if not na(r_style) or candle.isFiftyExtended
        _50t = candle.isFiftyExtended ? candle._t : _t_end
        candle._50 := line.new(_50t, _50p, time, _50p, color = c_50_act, style = s_50, width = thick_50, xloc = xloc.bar_time)

        if show_50_label
            candle._50_label := label.new(time, _50p, "T B R", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.gray, 100), textcolor=c_text, style=label.style_label_left, size=label_sz)

method setColor(Candle candle) =>
    c_hl   = (only_validated and not candle.validated) ? na : candle.hl_col
    c_50v  = (only_validated and not candle.validated) ? na : col_50
    c_30v  = (only_validated and not candle.validated) ? na : col_3070
    c_bg   = (only_validated and not candle.validated) ? na : candle.box_bg
    c_bord = (only_validated and not candle.validated) ? na : candle.box_bord
    c_text = (only_validated and not candle.validated) ? na : tbr_label_text_col

    // ── Override for unvalidated TBRs ────────────────────────────────────────
    if show_unvalidated_tbr and not candle.validated
        c_hl   := color.gray
        c_50v  := color.gray
        c_30v  := color.gray
        c_bg   := na
        c_bord := na
        c_text := color.gray
    // ─────────────────────────────────────────────────────────────────────────

    // Remove the unvalidated fill once the TBR is validated
    if not na(candle._fill) and candle.validated
        candle._fill.delete()
        candle._fill := na

    candle._box.set_bgcolor(c_bg)
    candle._box.set_border_color(c_bord)
    candle._box.set_border_width(box_border_w)
    if not na(candle._0)
        candle._0.set_color(c_hl)
    if not na(candle._100)
        candle._100.set_color(c_hl)
    if not na(candle._30)
        candle._30.set_color(c_30v)
    if not na(candle._70)
        candle._70.set_color(c_30v)
    if not na(candle._50)
        candle._50.set_color(c_50v)
    if not na(candle._50_label)
        candle._50_label.set_textcolor(c_text)

// ── NEW: Apply V TBR visual style when a zone is violated (S/R flip) ─────────
method setFlippedColor(Candle candle) =>
    // Remove the gray fill if it exists (zone should no longer be shown as unvalidated)
    if not na(candle._fill)
        candle._fill.delete()
        candle._fill := na

    candle.box_bg   := vtbr_box_bg
    candle.box_bord := vtbr_box_bord
    candle.hl_col   := vtbr_line_col

    candle._box.set_bgcolor(vtbr_box_bg)
    candle._box.set_border_color(vtbr_box_bord)
    candle._box.set_border_width(box_border_w)

    if not na(candle._0)
        candle._0.set_color(vtbr_line_col)
    if not na(candle._100)
        candle._100.set_color(vtbr_line_col)
    if not na(candle._30)
        candle._30.set_color(vtbr_line_col)
    if not na(candle._70)
        candle._70.set_color(vtbr_line_col)
    if not na(candle._50)
        candle._50.set_color(vtbr_line_col)
    if not na(candle._0_ext)
        candle._0_ext.set_color(vtbr_line_col)
    if not na(candle._100_ext)
        candle._100_ext.set_color(vtbr_line_col)

    // Relabel the midpoint as "V TBR"
    if not na(candle._50_label)
        candle._50_label.set_text("V TBR")
        candle._50_label.set_textcolor(vtbr_label_col)
    else if show_50_label
        _50p = (candle._h + candle._l) / 2
        candle._50_label := label.new(time, _50p, "V TBR", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.gray,100), textcolor=vtbr_label_col, style=label.style_label_left, size=label_sz)
        candle._50_label.set_size(label_sz)
// ─────────────────────────────────────────────────────────────────────────────

method setMitigation(Candle candle) =>
    diff = candle._h - candle._l
    mit = (diff * percent_mitigation / 100)
    candle.mitigation := candle.bull ? candle._h - mit : candle._l + mit

method extend(Candle c) =>
    if extend_hl_lines
        if c.ext_start_hour >= 0
            current_hour = hour(time, timezone)
            if current_hour >= c.ext_start_hour
                if not c.hl_extended
                    if show_low_line
                        c._0_ext := line.new(time, c._l, time, c._l, color = extend_hl_col, style = s_ext_hl, width = extend_hl_width, xloc = xloc.bar_time)
                    if show_high_line
                        c._100_ext := line.new(time, c._h, time, c._h, color = extend_hl_col, style = s_ext_hl, width = extend_hl_width, xloc = xloc.bar_time)
                    c.hl_extended := true
                else
                    if not na(c._0_ext)
                        c._0_ext.set_x2(time)
                    if not na(c._100_ext)
                        c._100_ext.set_x2(time)
    if not na(c._30)
        c._30.set_x2(time)
    if not na(c._70)
        c._70.set_x2(time)
    if not na(c._50)
        c._50.set_x2(time)
    if not na(c._50_label)
        c._50_label.set_x(time)
    if extend_box
        c._box.set_right(time)

method removeDrawing(Candle c) =>
    line.delete(c._0)
    line.delete(c._100)
    line.delete(c._0_ext)
    line.delete(c._100_ext)
    line.delete(c._30)
    line.delete(c._50)
    line.delete(c._70)
    label.delete(c._50_label)
    box.delete(c._box)
    // ── Delete the fill if it exists ─────────────────────────────────────────
    if not na(c._fill)
        c._fill.delete()
        c._fill := na

isTime(tf, _h, _m) =>
    if timeframe.in_seconds(tf) < timeframe.in_seconds("D")
        hour(time, timezone) == _h and minute(time, timezone) == _m
    else
        true

// ─────────────────────────────────────────────────────────────────────────────────
// 🛑 RESTRICTION TO H1 AND LOWER TIMEFRAMES – NO DRAWING ON H4 OR HIGHER
// ─────────────────────────────────────────────────────────────────────────────────
if timeframe.in_seconds(timeframe.period) > 3600
    // Clean up all objects so nothing remains on higher timeframes
    for l in line.all
        line.delete(l)
    for b in box.all
        box.delete(b)
    for lb in label.all
        label.delete(lb)
else

    changes = array.new<bool>()
    changes.push(ta.change(time(timeframe_1)) != 0)
    changes.push(ta.change(time(timeframe_2)) != 0)
    changes.push(ta.change(time(timeframe_3)) != 0)
    changes.push(ta.change(time(timeframe_4)) != 0)
    changes.push(ta.change(time(timeframe_5)) != 0)
    changes.push(ta.change(time(timeframe_6)) != 0)
    changes.push(ta.change(time(timeframe_7)) != 0)
    changes.push(ta.change(time(timeframe_8)) != 0)

    is_new_h = ta.change(time("60")) != 0
    float prv_c = close[1]

    for [i, conf] in configs
        conf.activated := false
        conf.insideBar := false
        conf.alertRetested := false
        is50E = extend_50_line and (i == 0 or i == 1)

        int eff_max = show_only_2_recent ? 2 : max_unmitigated

        if conf.active
            lastC = conf.candles.size() > 0 ? conf.candles.get(0) : na
            if changes.get(i)
                if isTime(conf.tf, conf._hour, conf._minute)
                    _zbg        = i == 0 ? z1_box_bg   : i == 1 ? z2_box_bg   : box_bg_col
                    _zbord      = i == 0 ? z1_box_bord : i == 1 ? z2_box_bord : box_border_col
                    _zhl        = i == 0 ? z1_hl_col   : i == 1 ? z2_hl_col   : hl_custom_col
                    _ext_hour   = i == 0 ? 10 : i == 1 ? 16 : -1
                    conf.candles.unshift(Candle.new(conf.tf, false, false, time, open, high, low, close, conf._color, tapped=false, validated=false, isFiftyExtended=is50E, box_bg=_zbg, box_bord=_zbord, hl_col=_zhl, hl_extended=false, ext_start_hour=_ext_hour, flipped=false))
                else if not na(lastC)
                    if not lastC.complete
                        lastC.complete := true
                        lastC.drawCandle()
                    else if lastC.complete and not lastC.active
                        cBr = close < lastC._l
                        cBl = close > lastC._h
                        if cBr or cBl
                            lastC.bull := cBl
                            lastC.setMitigation()
                            lastC.setColor()
                            lastC.active := true
                            if not only_validated
                                conf.activated := true
            else if not na(lastC) and not lastC.complete
                lastC._c := close
                lastC._h := math.max(high, lastC._h)
                lastC._l := math.min(low, lastC._l)

        for [i2, c] in conf.candles
            if c.active and not c.validated and is_new_h
                if prv_c > c._h or prv_c < c._l
                    c.validated := true
                    c.setColor()                    // ✅ FIX: refresh visuals after validation
                    if only_validated
                        conf.activated := true

            isV = not only_validated or c.validated
            if c.active and isV
                if not c.retested and ((not c.bull and high >= c._l) or (c.bull and low <= c._h))
                    c.retested := true
                    conf.alertRetested := true
                if not c.tapped
                    t30Bl = c.bull and low <= c._h - 0.3 * (c._h - c._l)
                    t30Br = not c.bull and high >= c._l + 0.3 * (c._h - c._l)
                    if t30Bl or t30Br
                        c.tapped := true

                // ── S/R Flip detection ───────────────────────────────────────
                // ✅ FIX: Only mark as V TBR if the zone was never tapped (never respected)
                if not c.flipped and not c.tapped
                    bull_violated = c.bull and close < c._l
                    bear_violated = not c.bull and close > c._h
                    if bull_violated or bear_violated
                        if show_vtbr
                            c.flipped := true
                            c.setFlippedColor()
                        else
                            c.removeDrawing()
                            conf.candles.remove(i2)
                            continue
                // ─────────────────────────────────────────────────────────────────

                if c.tapped and not show_mitigated_tbr
                    c.removeDrawing()
                    conf.candles.remove(i2)
                else if (not c.bull and high >= c.mitigation) or (c.bull and low <= c.mitigation)
                    conf.candles.remove(i2)
                else if i2 >= eff_max
                    c.removeDrawing()
                    conf.candles.remove(i2)
                else
                    c.extend()

    // =================================================================================================
    //                         OPENING RANGE – ASIAN, LONDON, NY SESSIONS
    //                         (Times fully customizable — NY default 09:30‑10:00)
    // =================================================================================================

    var string OR_GROUP = "OPENING RANGE SETTINGS"

    or_tz = input.string('America/New_York', "OR Timezone",
         options = ['America/New_York','GMT-12','GMT-11','GMT-10','GMT-9','GMT-8','GMT-7','GMT-6','GMT-5','GMT-4','GMT-3','GMT-2','GMT-1','GMT+0','GMT+1','GMT+2','GMT+3','GMT+4','GMT+5','GMT+6','GMT+7','GMT+8','GMT+9','GMT+10','GMT+11','GMT+12','GMT+13','GMT+14'],
         group = OR_GROUP)

    show_asian_or     = input.bool(true, "Show Asian OR", group = OR_GROUP)
    asian_start_hour  = input.int(20, "Asian Start Hour", minval = 0, maxval = 23, group = OR_GROUP)
    asian_start_min   = input.int(0,  "Asian Start Minute", minval = 0, maxval = 59, group = OR_GROUP)

    show_london_or    = input.bool(true, "Show London OR", group = OR_GROUP)
    london_start_hour = input.int(3, "London Start Hour", minval = 0, maxval = 23, group = OR_GROUP)
    london_start_min  = input.int(0, "London Start Minute", minval = 0, maxval = 59, group = OR_GROUP)

    show_ny_or        = input.bool(true, "Show NY OR", group = OR_GROUP)
    ny_start_hour     = input.int(9,  "NY Start Hour", minval = 0, maxval = 23, group = OR_GROUP)
    ny_start_min      = input.int(30, "NY Start Minute", minval = 0, maxval = 59, group = OR_GROUP)  // 09:30

    or_duration_min   = input.int(30, "Duration (minutes)", minval = 1, group = OR_GROUP)

    // --- OR Label customization inputs ---
    show_or_labels     = input.bool(true, "Show OR Labels", group = OR_GROUP)
    or_auto_label_color = input.bool(true, "Auto OR Label Color", group = OR_GROUP)
    or_label_color      = input.color(color.white, "Manual OR Label Color", group = OR_GROUP)
    or_label_text_col   = or_auto_label_color ? theme_text_col : or_label_color
    or_label_size_str   = input.string("Small", "OR Label Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = OR_GROUP)

    or_label_sz = switch or_label_size_str
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        =>         size.small

    asian_fill_col    = input.color(color.new(color.purple, 70), "Asian Fill",   group = OR_GROUP)
    london_fill_col   = input.color(color.new(color.lime,  70), "London Fill",  group = OR_GROUP)
    ny_fill_col       = input.color(color.new(color.blue,   70), "NY Fill",      group = OR_GROUP)

    asian_high_col    = input.color(color.green, "Asian High", group = OR_GROUP)
    asian_low_col     = input.color(color.red, "Asian Low",  group = OR_GROUP)
    london_high_col   = input.color(color.green,   "London High", group = OR_GROUP)
    london_low_col    = input.color(color.red,   "London Low",  group = OR_GROUP)
    ny_high_col       = input.color(color.green,    "NY High",     group = OR_GROUP)
    ny_low_col        = input.color(color.red,    "NY Low",      group = OR_GROUP)

    or_line_width     = input.int(2, "OR Line Width", minval = 1, group = OR_GROUP)
    or_line_style_str = input.string('Dashed', "OR Line Style", options = ['Solid', 'Dashed', 'Dotted'], group = OR_GROUP)

    show_historical_or = input.bool(true, "Show Historical OR Boxes",
         tooltip = "When disabled, only the current day's OR boxes and lines are shown. When enabled, all past boxes/lines remain on the chart.",
         group = OR_GROUP)

    // Resolve OR line style
    or_line_style = switch or_line_style_str
        'Solid'  => line.style_solid
        'Dashed' => line.style_dashed
        =>          line.style_dotted

    or_year  = year(time, or_tz)
    or_month = month(time, or_tz)
    or_day   = dayofmonth(time, or_tz)

    // --- Asian OR ---
    asian_start = timestamp(or_tz, or_year, or_month, or_day, asian_start_hour, asian_start_min, 0)
    asian_end   = asian_start + or_duration_min * 60 * 1000
    in_asian    = time >= asian_start and time < asian_end

    var box   asian_box = na
    var float asian_high_val = na
    var float asian_low_val  = na

    var label asian_high_label = na
    var label asian_low_label  = na

    // Clean up labels if toggled off
    if not show_or_labels
        label.delete(asian_high_label)
        label.delete(asian_low_label)
        asian_high_label := na
        asian_low_label := na

    if in_asian and not in_asian[1]
        if not show_historical_or
            label.delete(asian_high_label)
            label.delete(asian_low_label)
            asian_high_label := na
            asian_low_label := na
            if not na(asian_box)
                box.delete(asian_box)
        if show_asian_or
            asian_box := box.new(asian_start, high, asian_end, low,
                                 xloc = xloc.bar_time,
                                 bgcolor = asian_fill_col,
                                 border_color = na)
        asian_high_val := high
        asian_low_val  := low
    else if in_asian
        asian_high_val := math.max(asian_high_val, high)
        asian_low_val  := math.min(asian_low_val, low)
        if not na(asian_box)
            box.set_top(asian_box, asian_high_val)
            box.set_bottom(asian_box, asian_low_val)

    if in_asian[1] and not in_asian and show_asian_or
        line.new(asian_start, asian_high_val, asian_end, asian_high_val,
                 xloc = xloc.bar_time, extend = extend.none,
                 color = asian_high_col, width = or_line_width,
                 style = or_line_style)
        line.new(asian_start, asian_low_val, asian_end, asian_low_val,
                 xloc = xloc.bar_time, extend = extend.none,
                 color = asian_low_col, width = or_line_width,
                 style = or_line_style)

        if show_or_labels
            asian_high_label := label.new(asian_end, asian_high_val, "A OR",
                 xloc=xloc.bar_time, color=color.new(color.white,100),
                 textcolor=or_label_text_col, style=label.style_label_left,
                 size=or_label_sz)
            asian_low_label  := label.new(asian_end, asian_low_val, "A OR",
                 xloc=xloc.bar_time, color=color.new(color.white,100),
                 textcolor=or_label_text_col, style=label.style_label_left,
                 size=or_label_sz)

    // --- London OR ---
    london_start = timestamp(or_tz, or_year, or_month, or_day, london_start_hour, london_start_min, 0)
    london_end   = london_start + or_duration_min * 60 * 1000
    in_london    = time >= london_start and time < london_end

    var box   london_box = na
    var float london_high_val = na
    var float london_low_val  = na

    var label london_high_label = na
    var label london_low_label  = na

    if not show_or_labels
        label.delete(london_high_label)
        label.delete(london_low_label)
        london_high_label := na
        london_low_label := na

    if in_london and not in_london[1]
        if not show_historical_or
            label.delete(london_high_label)
            label.delete(london_low_label)
            london_high_label := na
            london_low_label := na
            if not na(london_box)
                box.delete(london_box)
        if show_london_or
            london_box := box.new(london_start, high, london_end, low,
                                  xloc = xloc.bar_time,
                                  bgcolor = london_fill_col,
                                  border_color = na)
        london_high_val := high
        london_low_val  := low
    else if in_london
        london_high_val := math.max(london_high_val, high)
        london_low_val  := math.min(london_low_val, low)
        if not na(london_box)
            box.set_top(london_box, london_high_val)
            box.set_bottom(london_box, london_low_val)

    if in_london[1] and not in_london and show_london_or
        line.new(london_start, london_high_val, london_end, london_high_val,
                 xloc = xloc.bar_time, extend = extend.none,
                 color = london_high_col, width = or_line_width,
                 style = or_line_style)
        line.new(london_start, london_low_val, london_end, london_low_val,
                 xloc = xloc.bar_time, extend = extend.none,
                 color = london_low_col, width = or_line_width,
                 style = or_line_style)

        if show_or_labels
            london_high_label := label.new(london_end, london_high_val, "L OR",
                 xloc=xloc.bar_time, color=color.new(color.white,100),
                 textcolor=or_label_text_col, style=label.style_label_left,
                 size=or_label_sz)
            london_low_label  := label.new(london_end, london_low_val, "L OR",
                 xloc=xloc.bar_time, color=color.new(color.white,100),
                 textcolor=or_label_text_col, style=label.style_label_left,
                 size=or_label_sz)

    // --- NY OR (09:30‑10:00 default) ---
    ny_start = timestamp(or_tz, or_year, or_month, or_day, ny_start_hour, ny_start_min, 0)
    ny_end   = ny_start + or_duration_min * 60 * 1000
    in_ny    = time >= ny_start and time < ny_end

    var box   ny_box = na
    var float ny_high_val = na
    var float ny_low_val  = na

    var label ny_high_label = na
    var label ny_low_label  = na

    if not show_or_labels
        label.delete(ny_high_label)
        label.delete(ny_low_label)
        ny_high_label := na
        ny_low_label := na

    if in_ny and not in_ny[1]
        if not show_historical_or
            label.delete(ny_high_label)
            label.delete(ny_low_label)
            ny_high_label := na
            ny_low_label := na
            if not na(ny_box)
                box.delete(ny_box)
        if show_ny_or
            ny_box := box.new(ny_start, high, ny_end, low,
                              xloc = xloc.bar_time,
                              bgcolor = ny_fill_col,
                              border_color = na)
        ny_high_val := high
        ny_low_val  := low
    else if in_ny
        ny_high_val := math.max(ny_high_val, high)
        ny_low_val  := math.min(ny_low_val, low)
        if not na(ny_box)
            box.set_top(ny_box, ny_high_val)
            box.set_bottom(ny_box, ny_low_val)

    if in_ny[1] and not in_ny and show_ny_or
        line.new(ny_start, ny_high_val, ny_end, ny_high_val,
                 xloc = xloc.bar_time, extend = extend.none,
                 color = ny_high_col, width = or_line_width,
                 style = or_line_style)
        line.new(ny_start, ny_low_val, ny_end, ny_low_val,
                 xloc = xloc.bar_time, extend = extend.none,
                 color = ny_low_col, width = or_line_width,
                 style = or_line_style)

        if show_or_labels
            ny_high_label := label.new(ny_end, ny_high_val, "NY OR",
                 xloc=xloc.bar_time, color=color.new(color.white,100),
                 textcolor=or_label_text_col, style=label.style_label_left,
                 size=or_label_sz)
            ny_low_label  := label.new(ny_end, ny_low_val, "NY OR",
                 xloc=xloc.bar_time, color=color.new(color.white,100),
                 textcolor=or_label_text_col, style=label.style_label_left,
                 size=or_label_sz)
