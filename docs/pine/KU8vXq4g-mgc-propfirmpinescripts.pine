//@version=6
strategy("Farm 1 — S90 Real", overlay=true, default_qty_value=4, pyramiding=0)

float d_close = request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_off)
float d_ema10 = request.security(syminfo.tickerid, "D", ta.ema(close,10), lookahead=barmerge.lookahead_off)
float d_ema5  = request.security(syminfo.tickerid, "D", ta.ema(close, 5), lookahead=barmerge.lookahead_off)
bool regime_up   = not na(d_ema10) and not na(d_ema5) and d_close > d_ema10 and d_close > d_ema5
bool regime_down = not na(d_ema10) and not na(d_ema5) and d_close < d_ema10 and d_close < d_ema5

float e9  = ta.ema(close, 9)
float e21 = ta.ema(close, 21)
float e34 = ta.ema(close, 34)
float e50 = ta.ema(close, 50)
bool bull_stack = e9 > e21 and e21 > e34 and e34 > e50
bool bear_stack = e9 < e21 and e21 < e34 and e34 < e50

int t_min       = hour * 60 + minute
bool rth_start  = t_min >= 570
bool in_session = t_min >= 585 and t_min <= 990
bool new_day    = ta.change(time("D")) != 0

var float _tpv = 0.0
var float _vol = 0.0
var float _cvv = 0.0
_tpv := new_day ? 0.0 : _tpv
_vol := new_day ? 0.0 : _vol
_cvv := new_day ? 0.0 : _cvv
float tp = (high + low + close) / 3.0
if rth_start
    _tpv += tp * volume
    _vol += volume
float vwap_val = _vol > 0 ? _tpv / _vol : na
if rth_start and not na(vwap_val)
    float dev = close - vwap_val
    _cvv += dev * dev * volume
float vwap_std = (not na(vwap_val) and _vol > 0) ? math.sqrt(_cvv / _vol) : 0.0
float vwap_u1  = not na(vwap_val) ? vwap_val + vwap_std : na
float vwap_l1  = not na(vwap_val) ? vwap_val - vwap_std : na

float vol_ma20 = ta.sma(volume, 20)
bool vol_ok    = volume > vol_ma20

var int   trades_today = 0
var float stop_px      = na
var float target_px    = na
trades_today := new_day ? 0 : trades_today

bool bull_bar = close > open
bool bear_bar = close < open
float TICK    = syminfo.mintick

if strategy.position_size > 0 and not na(stop_px)
    if low <= stop_px or high >= target_px
        strategy.close_all()
        stop_px   := na
        target_px := na

if strategy.position_size < 0 and not na(stop_px)
    if high >= stop_px or low <= target_px
        strategy.close_all()
        stop_px   := na
        target_px := na

if t_min >= 990 and strategy.position_size != 0
    strategy.close_all()
    stop_px   := na
    target_px := na

if in_session and strategy.position_size == 0 and trades_today < 3
    if regime_up and bull_stack and not na(vwap_u1) and close > vwap_u1 and bull_bar and vol_ok
        float raw_risk = close - (low - 2 * TICK)
        if raw_risk > 0
            float risk = math.min(raw_risk, 50 * TICK)
            stop_px   := close - risk
            target_px := close + 3.0 * risk
            strategy.entry("L", strategy.long)
            trades_today += 1
    else if regime_down and bear_stack and not na(vwap_l1) and close < vwap_l1 and bear_bar and vol_ok
        float raw_risk = (high + 2 * TICK) - close
        if raw_risk > 0
            float risk = math.min(raw_risk, 50 * TICK)
            stop_px   := close + risk
            target_px := close - 3.0 * risk
            strategy.entry("S", strategy.short)
            trades_today += 1

plot(vwap_val, "VWAP", color.blue, 1)
plot(vwap_u1,  "VWAP+1SD", color.green, 1)
plot(vwap_l1,  "VWAP-1SD", color.red, 1)