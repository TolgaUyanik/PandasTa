//@version=6

// @description Customised techninal analysis functions
library('tac', overlay = false)
import aybarsm/ToolsFluent/6 as ToolsFluent

// @function returns parabolic sar with lagging and fast value
// @param start float: Start
// @param inc float: Increment
// @param max float: Maximum
// @returns [result, lagging, fast] Actual sar value, lagging sar value and fast sar value
export sar(float start, float inc, float max) =>
    var float result = na
    var float lagging = na
    var float fast = na
    var float maxMin = na
    var float acceleration = na
    var bool isBelow = false
    bool isFirstTrendBar = false
    array<float> stages = array.new<float>()

    if bar_index == 1
        if close > close[1]
            isBelow := true
            maxMin := high
            result := low[1]
        else
            isBelow := false
            maxMin := low
            result := high[1]
        isFirstTrendBar := true
        acceleration := start
    
    result := result + acceleration * (maxMin - result)
    array.push(stages, result)

    if isBelow
        if result > low
            isFirstTrendBar := true
            isBelow := false
            result := math.max(high, maxMin)
            maxMin := low
            acceleration := start
    else
        if result < high
            isFirstTrendBar := true
            isBelow := true
            result := math.min(low, maxMin)
            maxMin := high
            acceleration := start
    
    array.push(stages, result)

    if not isFirstTrendBar
        if isBelow
            if high > maxMin
                maxMin := high
                acceleration := math.min(acceleration + inc, max)
        else
            if low < maxMin
                maxMin := low
                acceleration := math.min(acceleration + inc, max)
    
    if isBelow
        result := math.min(result, low[1])
        if bar_index > 1
            result := math.min(result, low[2])
        
    else
        result := math.max(result, high[1])
        if bar_index > 1
            result := math.max(result, high[2])
    
    array.push(stages, result)

    lagging := bar_index > 1 and isFirstTrendBar ? array.get(stages, 0) : array.get(stages, 2)
    fast := not na(lagging) ? lagging + acceleration * (maxMin - lagging) : na

    [result, lagging, fast]

isFracHighBW(float srcHigh = high) =>
    srcHigh[4] < srcHigh[2] and srcHigh[3] <= srcHigh[2] and srcHigh[2] >= srcHigh[1] and srcHigh[2] > srcHigh[0]

isFracLowBW(float srcLow = low) =>
    srcLow[4] > srcLow[2] and srcLow[3] >= srcLow[2] and srcLow[2] <= srcLow[1] and srcLow[2] < srcLow[0]

getFracMarkBW(float srcHigh = high, float srcLow = low) =>
    bool isBWHigh = isFracHighBW(srcHigh)
    bool isBWLow = isFracLowBW(srcLow)
    float lastHigh = ta.valuewhen(isBWHigh, srcHigh[2], 1)
    float lastLow = ta.valuewhen(isBWLow, srcLow[2], 1)

    int highMark = switch 
        isBWHigh and srcHigh[2] > lastHigh => 2
        isBWHigh and srcHigh[2] < lastHigh => 1
        => 0

    int lowMark = switch 
        isBWLow and srcLow[2] < lastLow => -2
        isBWLow and srcLow[2] > lastLow => -1
        => 0

    [highMark, lowMark]

//@type BWFractal - BWFractal mark info object 
//@field price float BWFractal price
//@field when int BWFractal bar time UNIX. Default: time
//@field markWhen int BWFractal mark bar time UNIX. Default: time
//@field boPrice float BWFractal breakout price. Default: na
//@field boTime int BWFractal breakout bar time UNIX. Default: time
//@field boIndex int BWFractal breakout bar index. Default: time
export type BWFractal
	float price
	int when
	int index
	int markWhen = time
	int markIndex = bar_index
	float boPrice = na
	int boTime = na
	int boIndex = na

//@type BWFractals - BWFractals container object 
//@field hh fluent.Fluent[] Higher high fractals. Default: na
//@field lh fluent.Fluent[] Lower high fractals. Default: na
//@field hl fluent.Fluent[] Higher low fractals. Default: na
//@field ll fluent.Fluent[] Lower low fractals. Default: na
export type BWFractals
    ToolsFluent.Fluent bar = na
	array<BWFractal> hh = na
	array<BWFractal> lh = na
	array<BWFractal> hl = na
	array<BWFractal> ll = na

// @function Returns BWFractals after processing
// @param srcHigh source for high fractal marking. Default: high
// @param srcLow source for low fractal marking. Default: low
// @param fractals BWFractals container object to be used.
// @param hhBoLb Higher high brakout lookback count. Default: 0
// @param llBoLb Lower low brakout lookback count. Default: 0
// @param hhBoLbStart Higher high brakout lookback start time. Default: time
// @param llBoLbStart Lower low brakout lookback start time. Default: time
export method eval(BWFractals this, float srcHigh = high, float srcLow = low, int hhBoLb = 0, int llBoLb = 0, int hhBoLbStart = time, int llBoLbStart = time) =>
    this.bar := ToolsFluent.Fluent.new()

    if (na(this.hh))
        this.hh := array.new<BWFractal>()
    if (na(this.lh))
        this.lh := array.new<BWFractal>()
    if (na(this.hl))
        this.hl := array.new<BWFractal>()
    if (na(this.ll))
        this.ll := array.new<BWFractal>()

    [markHigh, markLow] = getFracMarkBW(srcHigh, srcLow)

    this.bar.set('isHigh', markHigh > 0)
    this.bar.set('isLow', markLow < 0)
    this.bar.set('isHH', markHigh == 2)
    this.bar.set('isLH', markHigh == 1)
    this.bar.set('isHL', markLow == -1)
    this.bar.set('isLL', markLow == -2)
    this.bar.set('markHigh', markHigh)
    this.bar.set('markLow', markLow)

    if this.bar.get('isHigh', false) or this.bar.get('isLow', false)
        BWFractal frac = BWFractal.new((this.bar.get('isHigh', false) ? srcHigh[2] : srcLow[2]), time[2], bar_index[2], time, bar_index)

        if this.bar.get('isHigh', false)
            if this.bar.get('isHH', false)
                this.hh.push(frac)
            else
                this.lh.push(frac)

        if this.bar.get('isLow', false)
            if this.bar.get('isLL', false)
                this.ll.push(frac)
            else
                this.hl.push(frac)
    
    if hhBoLb > 0 and array.size(this.hh) > 0
        int hhBoLbFrom = array.size(this.hh) - 1
        int hhBoLbTo = 0
        int hhBoTimeLimit = llBoLb + (this.bar.get('isHH', false) ? 1 : 0)
        int hhBoTimeCounter = 0
        for i = hhBoLbFrom to hhBoLbTo by 1
            hhBoTimeCounter += 1
            BWFractal fracHH = this.hh.get(i)
            if fracHH.when < hhBoLbStart and hhBoTimeCounter > hhBoTimeLimit
                break

            if na(fracHH.boPrice) and close[1] > open[1] and close[1] > fracHH.price
                fracHH.boPrice := close[1]
                fracHH.boTime := time[1]
                fracHH.boIndex := bar_index[1]
                this.hh.insert(i, fracHH)
                if not this.bar.get('isBoHH', false)
                    this.bar.set('isBoHH', true)
                    this.bar.set('boHHPrice', fracHH.price)
            
    if llBoLb > 0 and array.size(this.ll) > 0
        int llBoLbFrom = array.size(this.ll) - 1
        int llBoLbTo = 0
        int llBoTimeLimit = llBoLb + (this.bar.get('isLL', false) ? 1 : 0)
        int llBoTimeCounter = 0
        for i = llBoLbFrom to llBoLbTo by 1
            llBoTimeCounter += 1
            BWFractal fracLL = this.ll.get(i)
            if fracLL.when < llBoLbStart and llBoTimeCounter > llBoTimeLimit
                break

            if na(fracLL.boPrice) and close[1] < open[1] and close[1] < fracLL.price
                fracLL.boPrice := close[1]
                fracLL.boTime := time[1]
                fracLL.boIndex := bar_index[1]
                this.ll.insert(i, fracLL)
                if not this.bar.get('isBoLL', false)
                    this.bar.set('isBoLL', true)
                    this.bar.set('boLLPrice', fracLL.price)