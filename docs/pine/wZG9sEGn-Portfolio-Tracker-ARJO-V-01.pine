int    cutoffPercentInput = input.int(10, "Color intensity cutoff (%)", group = COLOR_GRP, display = display.none,
  tooltip = "The cutoff for maximum color intensity. Absolute values at or above this level have the same color.")
// Table settings
string TABLE_GRP = "Table settings"
string TT_WT = "The table width as a percentage of the pane where the table is located. " +
  "If this value is 0, the width fits the contents of the table, and the table can be wider than the pane."
string TT_HG = "The table height as a percentage of the pane where the table is located. " +
  "If this value is 0, the height fits the contents of the table, and the table can be taller than the pane."
string TT_THF = "Multiplier for the title row height relative to other rows (e.g., 1.5 makes title row 50% taller)."
string tablePositionInput = input.string("Top Right", "Table Position", options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group = TABLE_GRP, display = display.none)
float  tableWidthInput    = input.float(0, "Table Width (%)", maxval = 100, minval = 0, group = TABLE_GRP, tooltip = TT_WT,  display = display.none)
float  tableHeightInput   = input.float(0, "Table Height (%)", maxval = 100, minval = 0, group = TABLE_GRP, tooltip = TT_HG,  display = display.none)
float  titleRowHeightFactor = input.float(1.5, "Title Row Height Factor", minval = 1.0, step = 0.1, group = TABLE_GRP, tooltip = TT_THF, display = display.none)
bool   showTimeframes     = input.bool(false, "Show Timeframe Columns", group = TABLE_GRP, tooltip = "Toggle to show/hide the last four columns (1W, 1M, 3M, 6M)")
// Initialize arrays globally
var array<string> symbolsArray = array.new<string>()
var array<float> buyPricesArray = array.new<float>()
var array<int> buyDatesArray = array.new<int>()
var array<float> stoplossesArray = array.new<float>()
var array<float> unitsArray = array.new<float>()
var array<string> timeframesArray = array.from("1W", "1M", "3M", "6M")
// Helper functions
getTFMult(string timeframe) =>
    multString = str.substring(timeframe, 0, str.length(timeframe) - 1)
    mult = multString == "" ? 1 : int(str.tonumber(multString))
    mult
timeframeToMS(string timeframe) =>
    lastBarYear = year(last_bar_time)
    lastBarMonth = month(last_bar_time)
    lastBarDay = dayofmonth(last_bar_time)
    result = switch
        str.endswith(timeframe, "Y") => timestamp(lastBarYear - getTFMult(timeframe), lastBarMonth, lastBarDay, hour, minute)
        timeframe == "YTD" => timestamp(lastBarYear, 01, 01)
        str.endswith(timeframe, "M") =>
            totalMonths = lastBarYear * 12 + lastBarMonth - getTFMult(timeframe)
            pastYear = int(totalMonths / 12)
            pastMonth = totalMonths % 12
            if pastMonth == 0
                pastYear -= 1
                pastMonth := 12
            timestamp(pastYear, pastMonth, lastBarDay, hour, minute)
        str.endswith(timeframe, "W") or str.endswith(timeframe, "D") => last_bar_time - timeframe.in_seconds(timeframe) * 1000
        => runtime.error("Unrecognized timeframe: " + timeframe), 0
    result
makeTimeAnchors(timeframesArray) =>
    timeAnchors = array.new<int>()
    for item in timeframesArray
        convertedTF = timeframeToMS(item)
        timeAnchors.push(convertedTF)
    timeAnchors
writeValuesOnAnchors(timeframesArray, requestedSeries) =>
    var timeAnchorsArray = makeTimeAnchors(timeframesArray)
    var valuesArray = array.new<float>(timeAnchorsArray.size())
    for [index, anchorTimestamp] in timeAnchorsArray
        if time > anchorTimestamp and time[1] <= anchorTimestamp
            valuesArray.set(index, requestedSeries[1])
    [timeAnchorsArray, valuesArray, requestedSeries, syminfo.ticker]
requestPastCloses(array<string> timeframesArray, string symbol, float source) =>
    [timeAnchorsArray, valuesArray, currClose, description] = request.security(symbol, "1D", writeValuesOnAnchors(timeframesArray, source), lookahead = barmerge.lookahead_on)
    [timeAnchorsArray, valuesArray, currClose, description]
// Process symbol inputs
addSymbol(string s, float bp, string yearStr, string monthStr, string dayStr, float sl, float un) =>
    yearInt = int(str.tonumber(yearStr))
    monthInt = int(str.tonumber(monthStr))
    dayInt = int(str.tonumber(dayStr))
    bdTimestamp = na(yearInt) or na(monthInt) or na(dayInt) or yearInt < 1900 or monthInt < 1 or monthInt > 12 or dayInt < 1 or dayInt > 31 ? 0 : timestamp(yearInt, monthInt, dayInt, 0, 0)
    if s != "" and bp > 0 and bdTimestamp > 0 and sl > 0 and un > 0
        symbolsArray.push(s)
        buyPricesArray.push(bp)
        buyDatesArray.push(bdTimestamp)
        stoplossesArray.push(sl)
        unitsArray.push(un)
if barstate.isfirst
    // Add symbols from inputs
    addSymbol(sym1_symbol, sym1_buyPrice, sym1_year, sym1_month, sym1_day, sym1_stoploss, sym1_units)
    addSymbol(sym2_symbol, sym2_buyPrice, sym2_year, sym2_month, sym2_day, sym2_stoploss, sym2_units)
    addSymbol(sym3_symbol, sym3_buyPrice, sym3_year, sym3_month, sym3_day, sym3_stoploss, sym3_units)
    addSymbol(sym4_symbol, sym4_buyPrice, sym4_year, sym4_month, sym4_day, sym4_stoploss, sym4_units)
    addSymbol(sym5_symbol, sym5_buyPrice, sym5_year, sym5_month, sym5_day, sym5_stoploss, sym5_units)
    addSymbol(sym6_symbol, sym6_buyPrice, sym6_year, sym6_month, sym6_day, sym6_stoploss, sym6_units)
    addSymbol(sym7_symbol, sym7_buyPrice, sym7_year, sym7_month, sym7_day, sym7_stoploss, sym7_units)
    addSymbol(sym8_symbol, sym8_buyPrice, sym8_year, sym8_month, sym8_day, sym8_stoploss, sym8_units)
    addSymbol(sym9_symbol, sym9_buyPrice, sym9_year, sym9_month, sym9_day, sym9_stoploss, sym9_units)
    addSymbol(sym10_symbol, sym10_buyPrice, sym10_year, sym10_month, sym10_day, sym10_stoploss, sym10_units)
    addSymbol(sym11_symbol, sym11_buyPrice, sym11_year, sym11_month, sym11_day, sym11_stoploss, sym11_units)
    addSymbol(sym12_symbol, sym12_buyPrice, sym12_year, sym12_month, sym12_day, sym12_stoploss, sym12_units)
    addSymbol(sym13_symbol, sym13_buyPrice, sym13_year, sym13_month, sym13_day, sym13_stoploss, sym13_units)
    addSymbol(sym14_symbol, sym14_buyPrice, sym14_year, sym14_month, sym14_day, sym14_stoploss, sym14_units)
    addSymbol(sym15_symbol, sym15_buyPrice, sym15_year, sym15_month, sym15_day, sym15_stoploss, sym15_units)
    // Removed: Logic to add chart symbol if enabled

// Table position
var tablePosition = switch tablePositionInput
    "Top Left" => position.top_left
    "Top Center" => position.top_center
    "Top Right" => position.top_right
    "Middle Left" => position.middle_left
    "Middle Center" => position.middle_center
    "Middle Right" => position.middle_right
    "Bottom Left" => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Bottom Right" => position.bottom_right
// Create table: base 8 fixed columns + conditional timeframes, with extra row for title
var int fixedColumns = 8
var int numColumns = fixedColumns + (showTimeframes ? timeframesArray.size() : 0)
var changesTable = table.new(tablePosition, numColumns, math.max(symbolsArray.size() + 2, 3), border_width = 3)

if barstate.islast
    // --- Check Chart Timeframe and Show Message ---
    // Check if the current chart timeframe is Weekly or Monthly
    if timeframe.period == "W" or timeframe.period == "M"
        // Display a message indicating preference for Daily timeframe
        // Note: runtime.error stops execution and shows the message prominently.
        runtime.error("Please Switch to Daily Timeframe for Accurate CMP")


    // Calculate cell heights: title row taller, other rows adjusted
    totalRows = math.max(symbolsArray.size() + 2, 3)
    titleHeight = tableHeightInput == 0 ? na : tableHeightInput / totalRows * titleRowHeightFactor
    otherRowHeight = tableHeightInput == 0 ? na : tableHeightInput / totalRows / (1 + titleRowHeightFactor / (symbolsArray.size() + 1))
    cellWidth = tableWidthInput == 0 ? na : tableWidthInput / numColumns
    // NIFTY-based header background color
    [weekly_close, weekly_sma] = request.security("NSE:NIFTY", "W", [close, ta.sma(close, 10)])
    color headerBg = na(weekly_close) or na(weekly_sma) ? neutralColor : weekly_close > weekly_sma ? posColorInput : negColorInput
    // Initialize portfolio totals
    var float totalPortfolioInitialValue = 0.0
    var float totalPortfolioCurrentValue = 0.0
    // Reset totals at the start of calculation
    totalPortfolioInitialValue := 0.0
    totalPortfolioCurrentValue := 0.0

    // --- Main Symbol Data Loop ---
    for [index, symbol] in symbolsArray
        // --- Fetch Data for Symbol ---
        // Get historical closes for timeframe calculations (uses "1D" internally)
        [timestampsArray, historicalClosesArray, tmpDailyClose_unused, description] = requestPastCloses(timeframesArray, symbol, close)
        // Get the CURRENT close based on the CHART's actual timeframe for accurate CMP display and portfolio calculation
        currClose = request.security(symbol, timeframe.period, close)
        // --- Update Portfolio Totals ---
        float buyPrice = buyPricesArray.get(index)
        float units = unitsArray.get(index)
        // Add to totals only if data is valid
        if not na(buyPrice) and not na(units) and buyPrice > 0 and units > 0 and not na(currClose)
            totalPortfolioInitialValue += buyPrice * units
            totalPortfolioCurrentValue += currClose * units
        // --- Populate Table Cells for Symbol ---
        // Symbol cell
        changesTable.cell(0, index + 2, description, tooltip = description, bgcolor = color.new(neutralColor,70), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight, text_halign = text.align_left)
        // Portfolio cells
        int buyDateTs = buyDatesArray.get(index)
        float stoploss = stoplossesArray.get(index) // Get Stop Loss value
        string buyDate = buyDateTs > 0 ? str.format_time(buyDateTs, "yyyy-MM-dd") : "N/A"
        changesTable.cell(1, index + 2, buyDate, bgcolor = neutralColor, text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
        changesTable.cell(2, index + 2, na(units) ? "N/A" : str.tostring(units), bgcolor = neutralColor, text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
        changesTable.cell(3, index + 2, na(buyPrice) ? "N/A" : str.tostring(buyPrice, format.mintick), bgcolor = neutralColor, text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)

        // --- Stop Loss Breach Check and Formatting ---
        // Determine the background color for the CMP cell
        color cmpCellBgColor = neutralColor // Default background color
        string cmpCellTooltip = "" // Default tooltip

        // Check if both CMP and Stop Loss are valid numbers
        if not na(currClose) and not na(stoploss) and stoploss > 0
            // Check if the current price is below the stop loss level
            if currClose < stoploss
                // Stop loss breached: Set background color to red (or any alert color)
                cmpCellBgColor := color.new(color.red, 80) // Red with some transparency
                cmpCellTooltip := "Stop Loss Breached! Current Price (" + str.tostring(currClose, format.mintick) + ") < Stop Loss (" + str.tostring(stoploss, format.mintick) + ")"
            else
                // Stop loss not breached (but valid data): Keep default neutral color
                // You could potentially add other logic here if desired
                cmpCellBgColor := neutralColor
                cmpCellTooltip := "CMP: " + str.tostring(currClose, format.mintick) // Optional tooltip for non-breached
        else
            // If either CMP or Stop Loss is invalid (N/A), keep the default neutral color
            cmpCellBgColor := neutralColor
            cmpCellTooltip := na(currClose) ? "CMP: N/A" : (na(stoploss) or stoploss <= 0 ? "Stop Loss: N/A/Invalid" : "CMP: " + str.tostring(currClose, format.mintick))

        // Populate the CMP cell (cell 5) with conditional formatting
        changesTable.cell(5, index + 2, na(currClose) ? "N/A" : str.tostring(currClose, format.mintick),
                          bgcolor = cmpCellBgColor, // Use the determined background color
                          text_color = chart.fg_color,
                          tooltip = cmpCellTooltip, // Use the determined tooltip
                          width = cellWidth, height = otherRowHeight)
        // --- End Stop Loss Breach Formatting ---

        changesTable.cell(4, index + 2, na(stoploss) ? "N/A" : str.tostring(stoploss, format.mintick), bgcolor = neutralColor, text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
        // Gain/Loss %
        float gainLossPercent = na(buyPrice) or na(currClose) ? na : (currClose - buyPrice) / buyPrice * 100
        color glCellColorBase = na(gainLossPercent) ? chart.fg_color : gainLossPercent >= 0 ? posColorInput : negColorInput
        color glCellColor = na(gainLossPercent) ? color.new(neutralColor, LOW_TRANSP) : color.from_gradient(gainLossPercent, 0, cutoffPercentInput, color.new(glCellColorBase, LOW_TRANSP), color.new(glCellColorBase, HEAVY_TRANSP))
        string glCellText = na(gainLossPercent) ? "N/A" : str.tostring(gainLossPercent, format.percent)
        string glCellTooltip = buyDateTs > 0 ? "From buy price on " + buyDate : na
        changesTable.cell(6, index + 2, glCellText, tooltip = glCellTooltip, bgcolor = glCellColor, text_color = glCellColorBase, width = cellWidth, height = otherRowHeight)
        // Total Gain/Loss (using chart-timeframe currClose)
        float totalGainLoss = na(buyPrice) or na(currClose) or na(units) ? na : (currClose - buyPrice) * units
        color tglCellColorBase = na(totalGainLoss) ? chart.fg_color : totalGainLoss >= 0 ? posColorInput : negColorInput
        color tglCellColor = na(totalGainLoss) ? color.new(neutralColor, LOW_TRANSP) : color.from_gradient(totalGainLoss, 0, cutoffPercentInput * buyPrice * units / 100, color.new(tglCellColorBase, LOW_TRANSP), color.new(tglCellColorBase, HEAVY_TRANSP))
        string tglCellText = na(totalGainLoss) ? "N/A" : str.tostring(totalGainLoss, format.mintick)
        string tglCellTooltip = na(totalGainLoss) ? na : "Total: (Current - Buy) * Units on " + buyDate
        changesTable.cell(7, index + 2, tglCellText, tooltip = tglCellTooltip, bgcolor = tglCellColor, text_color = tglCellColorBase, width = cellWidth, height = otherRowHeight)
        // --- Timeframe Change Cells ---
        if showTimeframes
            // Timeframe cells (this loop still uses data from requestPastCloses)
            for [jndex, value] in historicalClosesArray
                float changePercent = (currClose - value) / value * 100 // Still compare chart-timeframe close to historical "1D" closes
                color cellColorBase = changePercent >= 0 ? posColorInput : negColorInput
                color cellColor = color.from_gradient(changePercent, 0, cutoffPercentInput, color.new(cellColorBase, LOW_TRANSP), color.new(cellColorBase, HEAVY_TRANSP))
                string cellText = str.tostring(changePercent, format.percent)
                string cellTooltip = str.format_time(timestampsArray.get(jndex), "dd MMM YYYY")
                if na(changePercent)
                    cellColorBase := chart.fg_color
                    cellColor := color.new(neutralColor, LOW_TRANSP)
                    cellText := "No data"
                    cellTooltip := na
                changesTable.cell(fixedColumns + jndex, index + 2, cellText, tooltip = cellTooltip, bgcolor = cellColor,
                  text_color = cellColorBase, width = cellWidth, height = otherRowHeight)
    // --- Main Symbol Data Loop Ends ---

    // --- Calculate Portfolio Totals Summary after the loop ---
    float totalGainLossPortfolio = totalPortfolioCurrentValue - totalPortfolioInitialValue
    float percentGainLossPortfolio = 0.0
    if totalPortfolioInitialValue != 0
        percentGainLossPortfolio := (totalGainLossPortfolio / totalPortfolioInitialValue) * 100

    // --- Populate Portfolio Totals in Title Row (Cells 6,0 and 7,0) ---
    // Title row (row 0):
    // Clear any previous content in row 0
    for int i = 0 to numColumns - 1
        changesTable.cell(i, 0, "", bgcolor = color.new(headerBg, 60))
    // Set the title in the first column and merge across columns 0 to 5
    changesTable.cell(0, 0, "Portfolio Tracker",
     bgcolor = color.new(headerBg, 60),
     text_color = chart.fg_color,
     text_halign = "center",
     text_size = size.large,
     width = cellWidth,
     height = titleHeight)
    // Merge from col 0 to col 5 (fixedColumns - 3 = 8 - 3 = 5)
    table.merge_cells(changesTable, 0, 0, fixedColumns - 3, 0)

    string tglPortfolioText = na(totalGainLossPortfolio) ? "N/A" : str.tostring(totalGainLossPortfolio, format.mintick)
    color tglPortfolioColorBase = na(totalGainLossPortfolio) ? chart.fg_color : totalGainLossPortfolio >= 0 ? posColorInput : negColorInput
    // Adjusted gradient scale if needed, or keep original
    color tglPortfolioColor = na(totalGainLossPortfolio) ? color.new(neutralColor, LOW_TRANSP) : color.from_gradient(totalGainLossPortfolio, 0, cutoffPercentInput * (totalPortfolioInitialValue / math.max(symbolsArray.size(), 1)), color.new(tglPortfolioColorBase, LOW_TRANSP), color.new(tglPortfolioColorBase, HEAVY_TRANSP))
    changesTable.cell(7, 0, tglPortfolioText,
     bgcolor = tglPortfolioColor,
     text_color = tglPortfolioColorBase,
     text_halign = "right",
     width = cellWidth,
     height = titleHeight)

    string pglPortfolioText = na(percentGainLossPortfolio) ? "N/A" : str.tostring(percentGainLossPortfolio, format.percent)
    color pglPortfolioColorBase = na(percentGainLossPortfolio) ? chart.fg_color : percentGainLossPortfolio >= 0 ? posColorInput : negColorInput
    color pglPortfolioColor = na(percentGainLossPortfolio) ? color.new(neutralColor, LOW_TRANSP) : color.from_gradient(percentGainLossPortfolio, 0, cutoffPercentInput, color.new(pglPortfolioColorBase, LOW_TRANSP), color.new(pglPortfolioColorBase, HEAVY_TRANSP))
    changesTable.cell(6, 0, pglPortfolioText,
     bgcolor = pglPortfolioColor,
     text_color = pglPortfolioColorBase,
     text_halign = "right",
     width = cellWidth,
     height = titleHeight)
    // --- End Populate Portfolio Totals ---

    // Headers (row 1)
    changesTable.cell(0, 1, "Symbol", bgcolor = color.new(color.orange,60), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight, text_halign = text.align_left)
    changesTable.cell(1, 1, "Buy Date", bgcolor = color.new(color.orange,60), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
    changesTable.cell(2, 1, "Units", bgcolor = color.new(color.orange,60), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
    changesTable.cell(3, 1, "Buy Price", bgcolor = color.new(color.orange,60), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
    changesTable.cell(4, 1, "Stop Loss", bgcolor = color.new(color.orange,60), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
    changesTable.cell(5, 1, "CMP", bgcolor = color.new(color.orange,60), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
    changesTable.cell(6, 1, "% Gain / Loss", bgcolor = color.new(color.orange,60), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
    changesTable.cell(7, 1, "Gain/Loss", bgcolor = color.new(color.orange,60), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
    if showTimeframes
        for [index, timeframe] in timeframesArray
            changesTable.cell(fixedColumns + index, 1, timeframe, bgcolor = color.new(color.blue,60), text_color = chart.fg_color, width = cellWidth, height = otherRowHeight)
//-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------
