//@version=6
indicator("BulletProof Sessions HL | Asia · London · USA", 
     shorttitle="BP Sessions HL", 
     overlay=true, 
     max_boxes_count=100, 
     max_lines_count=150, 
     max_labels_count=100)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

string GRP_SESS   = "Session Times"
string GRP_STYLE  = "Visual Style"
string GRP_HIST   = "History & Display"
string GRP_ALERT  = "Alerts"

// --- Sessions (default = standard UTC forex/crypto liquidity windows)
string asiaSess   = input.session("0000-0900", "Asia (China/Tokyo)", group=GRP_SESS, tooltip="Standard Asian session. China equity hours are narrower (≈0130-0700 UTC) — adjust if needed.")
string londonSess = input.session("0800-1700", "London", group=GRP_SESS)
string nySess     = input.session("1300-2200", "USA (New York)", group=GRP_SESS)

string tzChoice   = input.string("UTC", "Timezone", options=["UTC", "America/New_York", "Europe/London", "Asia/Shanghai", "Asia/Tokyo", "Exchange"], group=GRP_SESS)
string tz         = tzChoice == "Exchange" ? syminfo.timezone : tzChoice

// --- Style
bool showBg       = input.bool(true,  "Highlight Session Backgrounds", group=GRP_STYLE)
bool showBoxes    = input.bool(true,  "Show Session Range Boxes", group=GRP_STYLE)
bool showLines    = input.bool(true,  "Show High/Low Lines (extend right)", group=GRP_STYLE)
bool showLabels   = input.bool(true,  "Show Price Labels", group=GRP_STYLE)
bool showMid      = input.bool(false, "Show Midpoint of Range", group=GRP_STYLE)

color asiaCol     = input.color(color.new(#00BCD4, 0), "Asia Color", group=GRP_STYLE)
color londonCol   = input.color(color.new(#2196F3, 0), "London Color", group=GRP_STYLE)
color nyCol       = input.color(color.new(#FF9800, 0), "USA Color", group=GRP_STYLE)

int   boxTransp   = input.int(88, "Box Transparency", minval=70, maxval=95, group=GRP_STYLE)
int   bgTransp    = input.int(92, "Background Transparency", minval=80, maxval=97, group=GRP_STYLE)
string lineStyle  = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group=GRP_STYLE)
int   lineWidth   = input.int(1, "Line Width", minval=1, maxval=3, group=GRP_STYLE)

// --- History
int   maxHist     = input.int(6, "Previous Sessions to Keep", minval=0, maxval=20, group=GRP_HIST)
bool  enableAsia  = input.bool(true, "Enable Asia", group=GRP_HIST)
bool  enableLondon= input.bool(true, "Enable London", group=GRP_HIST)
bool  enableNY    = input.bool(true, "Enable USA", group=GRP_HIST)

// ═══════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════

f_inSession(string sess) =>
    not na(time(timeframe.period, sess, tz))

f_lineStyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// ═══════════════════════════════════════════════════════════════
// SESSION STATE (one block per session for clarity & performance)
// ═══════════════════════════════════════════════════════════════

// ——— ASIA ———
var float asiaHigh = na
var float asiaLow  = na
var box   asiaBox  = na
var line  asiaHLine = na
var line  asiaLLine = na
var line  asiaMLine = na
var label asiaHLab = na
var label asiaLLab = na
var array<box>  asiaBoxes  = array.new_box()
var array<line> asiaHLines = array.new_line()
var array<line> asiaLLines = array.new_line()
var array<label> asiaLabs  = array.new_label()

bool isAsia = enableAsia and f_inSession(asiaSess)
bool asiaStart = isAsia and not isAsia[1]
bool asiaEnd   = not isAsia and isAsia[1]

if asiaStart
    asiaHigh := high
    asiaLow  := low
    // Clean old objects if over limit
    if array.size(asiaBoxes) >= maxHist
        box.delete(array.shift(asiaBoxes))
        line.delete(array.shift(asiaHLines))
        line.delete(array.shift(asiaLLines))
        if array.size(asiaLabs) >= 2
            label.delete(array.shift(asiaLabs))
            label.delete(array.shift(asiaLabs))
    // New box
    if showBoxes
        asiaBox := box.new(bar_index, high, bar_index, low, 
             border_color=asiaCol, bgcolor=color.new(asiaCol, boxTransp), 
             border_width=1, border_style=line.style_solid)
        array.push(asiaBoxes, asiaBox)
    // New lines
    if showLines
        asiaHLine := line.new(bar_index, high, bar_index, high, color=asiaCol, width=lineWidth, style=f_lineStyle(lineStyle), extend=extend.right)
        asiaLLine := line.new(bar_index, low,  bar_index, low,  color=asiaCol, width=lineWidth, style=f_lineStyle(lineStyle), extend=extend.right)
        array.push(asiaHLines, asiaHLine)
        array.push(asiaLLines, asiaLLine)
    if showMid
        asiaMLine := line.new(bar_index, (high+low)/2, bar_index, (high+low)/2, color=color.new(asiaCol, 40), width=1, style=line.style_dotted, extend=extend.right)

if isAsia and not asiaStart
    asiaHigh := math.max(asiaHigh, high)
    asiaLow  := math.min(asiaLow, low)
    if showBoxes and not na(asiaBox)
        box.set_top(asiaBox, asiaHigh)
        box.set_bottom(asiaBox, asiaLow)
        box.set_right(asiaBox, bar_index)
    if showLines
        if not na(asiaHLine)
            line.set_y1(asiaHLine, asiaHigh)
            line.set_y2(asiaHLine, asiaHigh)
            line.set_x2(asiaHLine, bar_index)
        if not na(asiaLLine)
            line.set_y1(asiaLLine, asiaLow)
            line.set_y2(asiaLLine, asiaLow)
            line.set_x2(asiaLLine, bar_index)
    if showMid and not na(asiaMLine)
        float mid = (asiaHigh + asiaLow) / 2
        line.set_y1(asiaMLine, mid)
        line.set_y2(asiaMLine, mid)
        line.set_x2(asiaMLine, bar_index)

if asiaEnd and showLabels
    asiaHLab := label.new(bar_index, asiaHigh, "Asia H " + str.tostring(asiaHigh, format.mintick), 
         style=label.style_label_down, color=color.new(asiaCol, 30), textcolor=color.white, size=size.small)
    asiaLLab := label.new(bar_index, asiaLow,  "Asia L " + str.tostring(asiaLow, format.mintick), 
         style=label.style_label_up,   color=color.new(asiaCol, 30), textcolor=color.white, size=size.small)
    array.push(asiaLabs, asiaHLab)
    array.push(asiaLabs, asiaLLab)

// ——— LONDON ———
var float londonHigh = na
var float londonLow  = na
var box   londonBox  = na
var line  londonHLine = na
var line  londonLLine = na
var line  londonMLine = na
var label londonHLab = na
var label londonLLab = na
var array<box>  londonBoxes  = array.new_box()
var array<line> londonHLines = array.new_line()
var array<line> londonLLines = array.new_line()
var array<label> londonLabs  = array.new_label()

bool isLondon = enableLondon and f_inSession(londonSess)
bool londonStart = isLondon and not isLondon[1]
bool londonEnd   = not isLondon and isLondon[1]

if londonStart
    londonHigh := high
    londonLow  := low
    if array.size(londonBoxes) >= maxHist
        box.delete(array.shift(londonBoxes))
        line.delete(array.shift(londonHLines))
        line.delete(array.shift(londonLLines))
        if array.size(londonLabs) >= 2
            label.delete(array.shift(londonLabs))
            label.delete(array.shift(londonLabs))
    if showBoxes
        londonBox := box.new(bar_index, high, bar_index, low, 
             border_color=londonCol, bgcolor=color.new(londonCol, boxTransp), 
             border_width=1)
        array.push(londonBoxes, londonBox)
    if showLines
        londonHLine := line.new(bar_index, high, bar_index, high, color=londonCol, width=lineWidth, style=f_lineStyle(lineStyle), extend=extend.right)
        londonLLine := line.new(bar_index, low,  bar_index, low,  color=londonCol, width=lineWidth, style=f_lineStyle(lineStyle), extend=extend.right)
        array.push(londonHLines, londonHLine)
        array.push(londonLLines, londonLLine)
    if showMid
        londonMLine := line.new(bar_index, (high+low)/2, bar_index, (high+low)/2, color=color.new(londonCol, 40), width=1, style=line.style_dotted, extend=extend.right)

if isLondon and not londonStart
    londonHigh := math.max(londonHigh, high)
    londonLow  := math.min(londonLow, low)
    if showBoxes and not na(londonBox)
        box.set_top(londonBox, londonHigh)
        box.set_bottom(londonBox, londonLow)
        box.set_right(londonBox, bar_index)
    if showLines
        if not na(londonHLine)
            line.set_y1(londonHLine, londonHigh)
            line.set_y2(londonHLine, londonHigh)
            line.set_x2(londonHLine, bar_index)
        if not na(londonLLine)
            line.set_y1(londonLLine, londonLow)
            line.set_y2(londonLLine, londonLow)
            line.set_x2(londonLLine, bar_index)
    if showMid and not na(londonMLine)
        float mid = (londonHigh + londonLow) / 2
        line.set_y1(londonMLine, mid)
        line.set_y2(londonMLine, mid)
        line.set_x2(londonMLine, bar_index)

if londonEnd and showLabels
    londonHLab := label.new(bar_index, londonHigh, "Lon H " + str.tostring(londonHigh, format.mintick), 
         style=label.style_label_down, color=color.new(londonCol, 30), textcolor=color.white, size=size.small)
    londonLLab := label.new(bar_index, londonLow,  "Lon L " + str.tostring(londonLow, format.mintick), 
         style=label.style_label_up,   color=color.new(londonCol, 30), textcolor=color.white, size=size.small)
    array.push(londonLabs, londonHLab)
    array.push(londonLabs, londonLLab)

// ——— NEW YORK (USA) ———
var float nyHigh = na
var float nyLow  = na
var box   nyBox  = na
var line  nyHLine = na
var line  nyLLine = na
var line  nyMLine = na
var label nyHLab = na
var label nyLLab = na
var array<box>  nyBoxes  = array.new_box()
var array<line> nyHLines = array.new_line()
var array<line> nyLLines = array.new_line()
var array<label> nyLabs  = array.new_label()

bool isNY = enableNY and f_inSession(nySess)
bool nyStart = isNY and not isNY[1]
bool nyEnd   = not isNY and isNY[1]

if nyStart
    nyHigh := high
    nyLow  := low
    if array.size(nyBoxes) >= maxHist
        box.delete(array.shift(nyBoxes))
        line.delete(array.shift(nyHLines))
        line.delete(array.shift(nyLLines))
        if array.size(nyLabs) >= 2
            label.delete(array.shift(nyLabs))
            label.delete(array.shift(nyLabs))
    if showBoxes
        nyBox := box.new(bar_index, high, bar_index, low, 
             border_color=nyCol, bgcolor=color.new(nyCol, boxTransp), 
             border_width=1)
        array.push(nyBoxes, nyBox)
    if showLines
        nyHLine := line.new(bar_index, high, bar_index, high, color=nyCol, width=lineWidth, style=f_lineStyle(lineStyle), extend=extend.right)
        nyLLine := line.new(bar_index, low,  bar_index, low,  color=nyCol, width=lineWidth, style=f_lineStyle(lineStyle), extend=extend.right)
        array.push(nyHLines, nyHLine)
        array.push(nyLLines, nyLLine)
    if showMid
        nyMLine := line.new(bar_index, (high+low)/2, bar_index, (high+low)/2, color=color.new(nyCol, 40), width=1, style=line.style_dotted, extend=extend.right)

if isNY and not nyStart
    nyHigh := math.max(nyHigh, high)
    nyLow  := math.min(nyLow, low)
    if showBoxes and not na(nyBox)
        box.set_top(nyBox, nyHigh)
        box.set_bottom(nyBox, nyLow)
        box.set_right(nyBox, bar_index)
    if showLines
        if not na(nyHLine)
            line.set_y1(nyHLine, nyHigh)
            line.set_y2(nyHLine, nyHigh)
            line.set_x2(nyHLine, bar_index)
        if not na(nyLLine)
            line.set_y1(nyLLine, nyLow)
            line.set_y2(nyLLine, nyLow)
            line.set_x2(nyLLine, bar_index)
    if showMid and not na(nyMLine)
        float mid = (nyHigh + nyLow) / 2
        line.set_y1(nyMLine, mid)
        line.set_y2(nyMLine, mid)
        line.set_x2(nyMLine, bar_index)

if nyEnd and showLabels
    nyHLab := label.new(bar_index, nyHigh, "NY H " + str.tostring(nyHigh, format.mintick), 
         style=label.style_label_down, color=color.new(nyCol, 30), textcolor=color.white, size=size.small)
    nyLLab := label.new(bar_index, nyLow,  "NY L " + str.tostring(nyLow, format.mintick), 
         style=label.style_label_up,   color=color.new(nyCol, 30), textcolor=color.white, size=size.small)
    array.push(nyLabs, nyHLab)
    array.push(nyLabs, nyLLab)

// ═══════════════════════════════════════════════════════════════
// BACKGROUND (priority: NY > London > Asia)
// ═══════════════════════════════════════════════════════════════

bgcolor(showBg ? (isNY ? color.new(nyCol, bgTransp) : isLondon ? color.new(londonCol, bgTransp) : isAsia ? color.new(asiaCol, bgTransp) : na) : na)

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════

alertcondition(isAsia and not isAsia[1],  "Asia Session Open",  "Asia session has opened")
alertcondition(isLondon and not isLondon[1], "London Session Open", "London session has opened")
alertcondition(isNY and not isNY[1], "USA Session Open", "New York session has opened")

alertcondition(ta.crossover(close, asiaHigh) or ta.crossunder(close, asiaLow), "Asia HL Cross", "Price crossed Asia session high/low")
alertcondition(ta.crossover(close, londonHigh) or ta.crossunder(close, londonLow), "London HL Cross", "Price crossed London session high/low")
alertcondition(ta.crossover(close, nyHigh) or ta.crossunder(close, nyLow), "NY HL Cross", "Price crossed NY session high/low") 