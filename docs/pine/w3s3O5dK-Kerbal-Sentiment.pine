//@version=6

// @description Kerbal Indicators Shared Library - Sentiment Analysis
// This library provides functions for accessing and analyzing market sentiment indicators
// including VIX and Put/Call ratios for contrarian signal generation.
library("kerbal_sentiment", overlay = false)

// ============================================
// VIX FUNCTIONS
// ============================================

// @function Get VIX (CBOE Volatility Index) close value
// @returns VIX close price
export getVIX() =>
    request.security("CBOE:VIX", timeframe.period, close, barmerge.gaps_on)

// @function Calculate VIX percentile rank over lookback period
// @param length Lookback period for percentile calculation
// @returns VIX percentile (0-100)
export vixPercentile(int length = 252) =>
    float vix = getVIX()
    float minVal = ta.lowest(vix, length)
    float maxVal = ta.highest(vix, length)
    float valueRange = maxVal - minVal
    valueRange > 0 ? (vix - minVal) / valueRange * 100.0 : 50.0

// @function Classify VIX regime based on thresholds
// @param vix VIX value to classify (use na for current)
// @param lowThresh Low VIX threshold (complacent market)
// @param highThresh High VIX threshold (fearful market)
// @param extremeThresh Extreme fear threshold
// @returns Regime: "COMPLACENT", "NORMAL", "FEARFUL", or "EXTREME_FEAR"
export vixRegime(float vix = na, float lowThresh = 15.0, float highThresh = 25.0, float extremeThresh = 35.0) =>
    float vixValue = na(vix) ? getVIX() : vix
    string regime = "NORMAL"
    
    if vixValue < lowThresh
        regime := "COMPLACENT"
    else if vixValue > extremeThresh
        regime := "EXTREME_FEAR"
    else if vixValue > highThresh
        regime := "FEARFUL"
    
    regime

// @function Calculate VIX z-score for relative positioning
// @param length Lookback period for mean and standard deviation
// @returns VIX z-score
export vixZScore(int length = 100) =>
    float vix = getVIX()
    float mean = ta.sma(vix, length)
    float stdDev = ta.stdev(vix, length)
    stdDev > 0 ? (vix - mean) / stdDev : 0.0

// ============================================
// PUT/CALL RATIO FUNCTIONS
// ============================================

// @function Get equity put/call ratio
// @returns Put/Call ratio (typically from CBOE data feed)
export getPutCallRatio() =>
    // Note: Symbol may vary by data provider
    // Common symbols: "USI:PCC" (equity P/C), "CBOE:PCCE" (equity only)
    request.security("CBOE:PCCE", timeframe.period, close, barmerge.gaps_on)

// @function Get smoothed put/call ratio using SMA
// @param length Smoothing period
// @returns Smoothed put/call ratio
export putCallSmoothed(int length = 10) =>
    float pc = getPutCallRatio()
    ta.sma(pc, length)

// @function Calculate put/call z-score for extremes detection
// @param length Lookback period for mean and standard deviation
// @returns Put/Call z-score (positive = elevated put buying)
export putCallZScore(int length = 100) =>
    float pc = getPutCallRatio()
    float mean = ta.sma(pc, length)
    float stdDev = ta.stdev(pc, length)
    stdDev > 0 ? (pc - mean) / stdDev : 0.0

// @function Classify put/call ratio regime
// @param pc Put/call ratio (use na for current)
// @param lowThresh Low P/C threshold (complacent/bullish)
// @param highThresh High P/C threshold (fearful/bearish sentiment)
// @returns Regime: "COMPLACENT", "NORMAL", "DEFENSIVE", "FEARFUL"
export putCallRegime(float pc = na, float lowThresh = 0.7, float highThresh = 1.0) =>
    float pcValue = na(pc) ? getPutCallRatio() : pc
    string regime = "NORMAL"
    
    if pcValue < lowThresh
        regime := "COMPLACENT"
    else if pcValue > highThresh * 1.3
        regime := "FEARFUL"
    else if pcValue > highThresh
        regime := "DEFENSIVE"
    
    regime

// ============================================
// COMPOSITE SENTIMENT SCORING
// ============================================

// @function Calculate composite sentiment score
// @param vixPercentile VIX percentile rank (0-100)
// @param putCallZScore Put/Call ratio z-score
// @returns Sentiment score 0-100 (0 = extreme fear/bullish contrarian, 100 = extreme complacency/bearish contrarian)
export sentimentScore(float vixPercentile, float putCallZScore) =>
    // VIX component: Higher percentile = more fear = lower score
    float vixComponent = 100.0 - vixPercentile
    
    // Put/Call component: Higher z-score (more puts) = more fear = lower score
    // Normalize z-score to 0-100 scale (clamp at +/- 3 standard deviations)
    float pcNormalized = 50.0 - (math.max(math.min(putCallZScore, 3.0), -3.0) * 16.67)
    
    // Composite (equal weight)
    (vixComponent + pcNormalized) / 2.0

// @function Check if sentiment is at contrarian extreme
// @param sentimentScore Composite sentiment score (0-100)
// @param bullishThreshold Threshold for contrarian bullish signal (extreme fear)
// @param bearishThreshold Threshold for contrarian bearish signal (extreme complacency)
// @returns Tuple [isContrarianBullish, isContrarianBearish]
export contrarianSignal(float sentimentScore, float bullishThreshold = 20.0, float bearishThreshold = 80.0) =>
    bool isContrarianBullish = sentimentScore < bullishThreshold
    bool isContrarianBearish = sentimentScore > bearishThreshold
    [isContrarianBullish, isContrarianBearish]

// @function Get sentiment direction and strength
// @param sentimentScore Current sentiment score
// @param prevSentimentScore Previous sentiment score
// @returns Tuple [direction, strength] where direction is "INCREASING_FEAR", "DECREASING_FEAR", "STABLE"
export sentimentTrend(float sentimentScore, float prevSentimentScore, float threshold = 5.0) =>
    float change = sentimentScore - prevSentimentScore
    string direction = "STABLE"
    float strength = math.abs(change)
    
    if change > threshold
        direction := "DECREASING_FEAR"  // Score increasing = less fear
    else if change < -threshold
        direction := "INCREASING_FEAR"  // Score decreasing = more fear
    
    [direction, strength]

// ============================================
// MARKET STRESS INDICATORS
// ============================================

// @function Detect VIX spike (sudden fear increase)
// @param spikeThreshold Z-score threshold for spike detection
// @returns True if VIX is spiking
export vixSpike(float spikeThreshold = 2.0) =>
    float vixZ = vixZScore(20)
    vixZ > spikeThreshold

// @function Detect put/call spike (sudden defensive positioning)
// @param spikeThreshold Z-score threshold for spike detection
// @returns True if P/C ratio is spiking
export putCallSpike(float spikeThreshold = 2.0) =>
    float pcZ = putCallZScore(20)
    pcZ > spikeThreshold

// @function Composite market stress indicator
// @returns Stress level 0-100 (higher = more stress)
export marketStress() =>
    float vixPct = vixPercentile(252)
    float pcZ = putCallZScore(100)
    
    // VIX component (0-50 points)
    float vixStress = vixPct / 2.0
    
    // P/C component (0-50 points, clamped at +3 SD)
    float pcStress = math.max(math.min(pcZ, 3.0), 0.0) * 16.67
    
    vixStress + pcStress

// ============================================
// CONTRARIAN OPPORTUNITY DETECTION
// ============================================

// @function Identify contrarian buy opportunity
// @param minStress Minimum stress level required
// @returns True if contrarian buy opportunity detected
export contrarianBuyOpportunity(float minStress = 70.0) =>
    float stress = marketStress()
    float prevStress = marketStress()[1]
    
    // High stress but showing signs of exhaustion
    bool highStress = stress > minStress
    
    // Check if stress is starting to decline
    bool stressEasing = stress < prevStress
    
    highStress and stressEasing

// @function Identify contrarian sell opportunity
// @param maxStress Maximum stress level (complacency)
// @returns True if contrarian sell opportunity detected  
export contrarianSellOpportunity(float maxStress = 30.0) =>
    float stress = marketStress()
    float prevStress = marketStress()[1]
    
    // Low stress (complacency)
    bool lowStress = stress < maxStress
    
    // Check if stress is starting to increase
    bool stressRising = stress > prevStress
    
    lowStress and stressRising
