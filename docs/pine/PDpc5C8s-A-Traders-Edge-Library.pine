//== RCI CALCULATION FUNCTIONS ==\\ *** Below are not exported functions but rather used by the RCI export functions ***
ord(_seq,_idx,_length,_interval) =>           
    p = _seq[_idx] 
    o = 0.5 
    for i=0 to _interval-1 by 1
        d = p-_seq[i*_length]
        o += (d<0 ? 1 : d==0 ? 0.5 : 0)
    o

d(_length,_source,_interval) =>
    sum=0.0
    step = _length/_interval
    for i=0 to _interval-1 by 1
        x = i+1-ord(_source,i*step,step,_interval)
        sum += x*x
    sum
    
rci(_length,_source,_interval) => 
    (ta.sma(100.0-(600/_interval/(_interval*_interval-1))*d(_length,_source,_interval), math.ceil(_length/_interval)))


//== SINGLE RCI FUNCTION ==\\
// @function                                    
//     You will see me using this a lot. DEFINITELY my favorite oscillator to utilize for SO many different things from 
//     timing entries/exits to determining trends.Calculation of this indicator based on Spearmans Correlation.
//
// @param  _rciLength  (int)   
//     Amount of bars back to use in RCI calculations.
//
// @param  _source  (float) 
//     Source to use in RCI calculations (can use ANY source series. Ie, open,close,high,low,etc).
//
// @param  _interval  (int)   
//     Optional(if parameter not included, it defaults to 3). RCI calculation groups bars by this amount and then will. 
//     rank these groups of bars.
//
// @returns  (float) 
//     Returns a single RCI value that will oscillates between -100 and +100.

export RCI(int _rciLength, float _source, int _interval=3) => rci(_rciLength,_source,_interval)


//== RCI AVERAGE FUNCTION ==\\
// @function                                    
//     20 RCI's are averaged together to get this RCI Avg (Rank Correlation Index Average). Each RCI (of the 20 total RCI)
//     has a progressively LARGER Lookback Length. Though the RCI Lengths are not individually adjustable, 
//     there are 2 factors that ARE: 
//     (1) the Lookback Length of the 1st RCI and 
//     (2) the amount of values between one RCI's Lookback Length and the next. 
//     *** If you set 'firstLength' to it's default of 200 and '_amtBtLengths' to it's default of 120 (aka AMOUNT BETWEEN LENGTHS=120)...
//       then RCI_2 Length=320, RCI_3 Length=440, RCI_4 Length=560, and so on.
// 
// @param  firstLength  (int)   
//     Optional(if parameter is not included when the function is called, then it defaults to 200). 
//     This parameter is the Lookback Length for the 1st RCI used in the RCI Avg.
// 
// @param  _amtBtLengths  (int)   
//     Optional(if parameter not included when the function is called, then it defaults to 120). 
//     This parameter is the value amount between each of the progressively larger lengths used for the 20 RCI's that
//     are averaged in the RCI Avg. 
// 	   ***** BEWARE ***** Too large of a value here will cause the calc to look back too far, causing an error(thus the value must be lowered)
//
// @param  _rciSMAlen  (int)   
//     Unlike the Single RCI Function, this function smooths out the end result using an SMA with a length value that is this parameter.
// 
// @param  _source  (float) 
//     Source to use in RCI calculations (can use ANY source series. Ie, open,close,high,low,etc).
// 
// @param  _interval  (int)   
//     Optional(if parameter not included, it defaults to 3). Within the RCI calculation, bars next to each other are grouped together 
//     and then these groups are Ranked against each other. This parameter is the number of adjacent bars that are grouped together.
// 
// @returns  (float) 
//     Returns a single RCI value that is the Avg of many RCI values that will oscillate between -100 and +100.

export RCIAVG(int firstLength=200, int _amtBtLengths=120, int _rciSMAlen, float _source, int _interval=3) => 
    _01=firstLength,       _02=_01+_amtBtLengths, _03=_02+_amtBtLengths, _04=_03+_amtBtLengths, _05=_04+_amtBtLengths
    _06=_05+_amtBtLengths, _07=_06+_amtBtLengths, _08=_07+_amtBtLengths, _09=_08+_amtBtLengths, _10=_09+_amtBtLengths
    _11=_10+_amtBtLengths, _12=_11+_amtBtLengths, _13=_12+_amtBtLengths, _14=_13+_amtBtLengths, _15=_14+_amtBtLengths
    _16=_15+_amtBtLengths, _17=_16+_amtBtLengths, _18=_17+_amtBtLengths, _19=_18+_amtBtLengths, _20=_19+_amtBtLengths

    rci = ta.sma(((
      rci(_01,_source,_interval)+rci(_02,_source,_interval)+
      rci(_03,_source,_interval)+rci(_04,_source,_interval)+
      rci(_05,_source,_interval)+rci(_06,_source,_interval)+
      rci(_07,_source,_interval)+rci(_08,_source,_interval)+
      rci(_09,_source,_interval)+rci(_10,_source,_interval)+
      rci(_11,_source,_interval)+rci(_12,_source,_interval)+
      rci(_13,_source,_interval)+rci(_14,_source,_interval)+
      rci(_15,_source,_interval)+rci(_16,_source,_interval)+
      rci(_17,_source,_interval)+rci(_18,_source,_interval)+
      rci(_19,_source,_interval)+rci(_20,_source,_interval))/20),_rciSMAlen)


//== PERCENT CHANGE FUNCTION ==\\
// @function 
//     This is a quick function to calculate how much % change has occurred between the '_startingValue' and the '_endingValue' 
//     that you input into the function.
//
// @param  _startingValue  (float)
//     The source value to START the % change calculation from.
//
// @param  _endingValue  (float)
//     The source value to END the % change caluclation from.
//
// @returns  
//     Returns a single output being the % value between 0-100 (with trailing numbers behind a decimal). If you want only 
//     a certain amount of numbers behind the decimal, this function needs to be put within a formatting function to do so.

export PercentChange(float _startingValue, float _endingValue) => 100*((_endingValue-_startingValue)/_startingValue)


//== RESCALE ==\\ 
// @function 
//     Rescales series with a known '_oldMin' & '_oldMax'. Use this when the scale of the '_source' to 
//     rescale is known (bounded). [ie. RSI = 0-100]
//
// @param  _source  (float) 
//     Source to be normalized.
//
// @param  _oldMin  (float) 
//     The known minimum of the '_source'.
//
// @param  _oldMax  (float) 
//     The known maximum of the '_source'.
//
// @param  _newMin  (float) 
//     What you want the NEW minimum of the '_source' to be.
//
// @param  _newMax  (float) 
//     What you want the NEW maximum of the '_source' to be.
//
// @returns  
//     Outputs your previously bounded '_source', but now the value will only move between the '_newMin' and '_newMax' 
//     values you set in the variables.

export Rescale(float _source, int _oldMin, int _oldMax, int _newMin, int _newMax) =>
    _newMin + (_newMax-_newMin) * (_source-_oldMin) / math.max(_oldMax-_oldMin,10e-10)


//== NORMALIZE AN UNBOUNDED SOURCE USING ALL HISTORICAL VALUE TO FIND MAX/MIN ==\\ 
// @function 
//     Normalizes '_source' that has a previously unknown min/max(unbounded) determining the max & min of the '_source' 
//     FROM THE ENTIRE CHARTS HISTORY. [ie. MACD = no limits to boundaries]] 
//
// @param  _source  (float) 
//     Source to be normalized.
//
// @param  _minimumLvl  (float) 
//     The Lower Boundary Level.
//
// @param  _maximumLvl  (float) 
//     The Upper Boundary Level.
//
// @returns   
//     Returns your same '_source', but now the value will MOSTLY stay between the minimum and maximum values you set in the 
//     '_minimumLvl' and '_maximumLvl' variables (ie. if the source you input is an RSI...the output is the same RSI value but 
//     instead of moving between 0-100 it will move between the maxand min you set).

export Normalize_Historical(float _source, int _minimumLvl, int _maximumLvl) =>
    var _historicMin =  10e10
    var _historicMax = -10e10
    _historicMin := math.min(nz(_source, _historicMin), _historicMin)
    _historicMax := math.max(nz(_source, _historicMax), _historicMax)
    _minimumLvl+(_maximumLvl-_minimumLvl) * (_source-_historicMin) / math.max(_historicMax-_historicMin,10e-10)


//== NORMALIZE AN UNBOUNDED SOURCE USING MAX/MIN WITHIN LOOKBACK PERIOD ==\\ 
// @function 
//     Normalizes series with previously unknown min/max(unbounded). Much like the Normalize_Historical function above this one, 
//     but rather than using the Highest/Lowest Values within the ENTIRE charts history, this on looks for the Highest/Lowest 
//     values of '_source' within the last ___ bars (set by user as/in the '_length' parameter. [ie. MACD = no limits to boundaries]] 
//
// @param  _source (float)
//     Source to be normalized.
//
// @param  _length (float)
//     The amount of bars to look back to determine the highest/lowest '_source' value.
//
// @param  _minimumLvl (float)
//     The Lower Boundary Level.
//
// @param  _maximumLvl (float)
//     The Upper Boundary Level.
//
// @returns  
//     Returns a single output variable being the previously unbounded '_source' that is now normalized and bound between 
//     the values used for '_minimumLvl'/'_maximumLvl' of the '_source' within the user defined lookback period.

export Normailize_Local(float _source, int _length, int _minimumLvl, int _maximumLvl) =>
    min = ta.lowest (_source, _length)
    max = ta.highest(_source, _length)
    NORMALIZED = _minimumLvl + ((_source-min) * (_maximumLvl-_minimumLvl)) / (max-min)

