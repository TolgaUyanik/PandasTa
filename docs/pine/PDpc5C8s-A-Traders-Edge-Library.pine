    col11=#2dc37e, col12=#9ec7a8, col13=#defba7, col14=#6d9a85, col15=#c1e3fe, col16=#b0fff7, col17=#5cbec3, col18=#93ecfd, col19=#6cb2d8, col20=#5cbaff
    col21=#3c8bec, col22=#233efa, col23=#4a87b6, col24=#ddfd07, col25=#6771f5, col26=#a0a7ff, col27=#b59bbf, col28=#a57edf, col29=#bc03ff, col30=#d5a1e8
    col31=#eb67f5, col32=#d44486, col33=#ff00a6, col34=#ff1224, col35=#e45faf, col36=#a3d6d1, col37=#c9ac80, col38=#f0805e, col39=#f26047, col40=#f79787

	[col01,col02,col03,col04,col05,col06,col07,col08,col09,col10,col11,col12,col13,col14,col15,col16,col17,col18,col19,col20, 
