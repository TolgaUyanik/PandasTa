//@version=5

// @description Get the Killzones and Macros as Booleans
library(title = "KillzonesAndMacrosLibrary", overlay = true)


// @function isSession: Determine if session is open
// @param sess (string): e.x. "0300-0600:23456"
// @param tz (string): defaults to "America/New_York"
// @returns boolean
export isSession(string sess, string tz = "America/New_York") => not na(time(timeframe.period, sess, tz))

//@type Killzones 
//@field isMidnightOpen bool  True if the current time is during the Midnight Open session
//@field isLondonOpen bool  True if the current time is during the London Open session
//@field isLondonLunch bool  True if the current time is during the London Lunch session
//@field isNewYorkOpen bool  True if the current time is during the New York Open session
//@field isNewYorkAM bool  True if the current time is during the New York AM session
//@field isEquitiesOpen bool  True if the current time is during the Equities Open session
//@field isOpeningRange bool  True if the current time is within the Opening Range period (first hour of trading)
//@field isLondonClose bool  True if the current time is during the London Close session
//@field isNewYorkLunch bool  True if the current time is during the New York Lunch session
//@field isNewYorkPM bool  True if the current time is during the New York PM session
//@field isCdbr bool  True if the current time is during the Central Bank Dealings Range (or another custom defined range)
//@field isFlout bool  True if the current time is during the Flout period (custom trading session or proprietary event)
//@field isPowerHour bool  True if the current time is during Power Hour (last hour of trading)
//@field isAsianRange bool  True if the current time is during the Asian trading session (Tokyo open)
export type Killzones
	bool isMidnightOpen
	bool isLondonOpen
	bool isLondonLunch
	bool isNewYorkOpen
	bool isNewYorkAM
	bool isEquitiesOpen
	bool isOpeningRange
	bool isLondonClose
	bool isNewYorkLunch
	bool isNewYorkPM
	bool isCdbr
	bool isFlout
	bool isPowerHour
	bool isAsianRange

//@type kzTimes
//@field MidnightOpen string  Represents the time range "00:00-00:01" for days 2-6 (Monday to Friday)
//@field LondonOpen string  Represents the time range "02:00-05:00" for days 2-6 (Monday to Friday)
//@field LondonLunch string  Represents the time range "05:00-07:00" for days 2-6 (Monday to Friday)
//@field NewYorkOpen string  Represents the time range "07:00-10:00" for days 2-6 (Monday to Friday)
//@field NewYorkAM string  Represents the time range "08:30-11:00" for days 2-6 (Monday to Friday)
//@field EquitiesOpen string  Represents the time range "09:30-09:31" for days 2-6 (Monday to Friday)
//@field OpeningRange string  Represents the time range "09:30-10:30" for days 2-6 (Monday to Friday)
//@field LondonClose string  Represents the time range "10:00-12:00" for days 2-6 (Monday to Friday)
//@field NewYorkLunch string  Represents the time range "12:00-13:00" for days 2-6 (Monday to Friday)
//@field NewYorkPM string  Represents the time range "13:30-16:00" for days 2-6 (Monday to Friday)
//@field Cdbr string  Represents the time range "14:00-20:00" for days 2-6 (Monday to Friday)
//@field Flout string  Represents the time range "14:00-00:00" for days 2-6 (Monday to Friday)
//@field PowerHour string  Represents the time range "15:00-16:00" for days 2-6 (Monday to Friday)
//@field AsianRange string  Represents the time range "20:00-00:00" for days 2-6 (Monday to Friday)
export type kzTimes
	string MidnightOpen = "0000-0001:23456"
	string LondonOpen = "0200-0500:23456"
	string LondonLunch = "0500-0700:23456"
	string NewYorkOpen = "0700-1000:23456"
	string NewYorkAM = "0830-1100:23456"
	string EquitiesOpen = "0930-0931:23456"
	string OpeningRange = "0930-1030:23456"
	string LondonClose = "1000-1200:23456"
	string NewYorkLunch = "1200-1300:23456"
	string NewYorkPM = "1330-1600:23456"
	string Cdbr = "1400-2000:23456"
	string Flout = "1400-0000:23456"
	string PowerHour = "1500-1600:23456"
	string AsianRange = "2000-0000:23456"


// @function getKillzones: Get all Killzones, reference New York time
// @returns [isMidnightOpen, isLondonOpen, isLondonLunch, isNewYorkOpen, isNewYorkAM, isEquitiesOpen, isOpeningRange, isLondonClose, isNewYorkLunch, isNewYorkPM, isCdbr, isFlout, isPowerHour, isAsianRange]: Booleans
export getKillzones() =>
	kzt = kzTimes.new()
	isMidnightOpen = isSession(kzt.MidnightOpen)
	isLondonOpen = isSession(kzt.LondonOpen)
	isLondonLunch = isSession(kzt.LondonLunch)
	isNewYorkOpen = isSession(kzt.NewYorkOpen)
	isNewYorkAM = isSession(kzt.NewYorkAM)
	isEquitiesOpen = isSession(kzt.EquitiesOpen)
	isOpeningRange = isSession(kzt.OpeningRange)
	isLondonClose = isSession(kzt.LondonClose)
	isNewYorkLunch = isSession(kzt.NewYorkLunch)
	isNewYorkPM = isSession(kzt.NewYorkPM)
	isCdbr = isSession(kzt.Cdbr)
	isFlout = isSession(kzt.Flout)
	isPowerHour = isSession(kzt.PowerHour)
	isAsianRange = isSession(kzt.AsianRange)

	kz = Killzones.new(isMidnightOpen, isLondonOpen, isLondonLunch, isNewYorkOpen, isNewYorkAM, isEquitiesOpen, isOpeningRange, isLondonClose, isNewYorkLunch, isNewYorkPM, isCdbr, isFlout, isPowerHour, isAsianRange)
	kz


//@type Macros
//@field isLondon0233 bool  True if the current time is during the London0233 macro
//@field isLondon0403 bool  True if the current time is during the London0403 macro
//@field isNewYork0850 bool  True if the current time is during the NewYork0850 macro
//@field isNewYork0950 bool  True if the current time is during the NewYork0950 macro
//@field isNewYork1050 bool  True if the current time is during the NewYork1050 macro
//@field isNewYork1150 bool  True if the current time is during the NewYork1150 macro
//@field isNewYork1310 bool  True if the current time is during the NewYork1310 macro
//@field isNewYork1515 bool  True if the current time is during the NewYork1515 macro
export type Macros
	bool isLondon0233
	bool isLondon0403
	bool isNewYork0850
	bool isNewYork0950
	bool isNewYork1050
	bool isNewYork1150
	bool isNewYork1310
	bool isNewYork1515

//@type mcTimes
//@field London0233 string  Represents the time range "02:33-03:00" for days 2-6 (Monday to Friday)
//@field London0403 string  Represents the time range "04:03-04:30" for days 2-6 (Monday to Friday)
//@field NewYork0850 string  Represents the time range "08:50-09:10" for days 2-6 (Monday to Friday)
//@field NewYork0950 string  Represents the time range "09:50-10:10" for days 2-6 (Monday to Friday)
//@field NewYork1050 string  Represents the time range "10:50-11:10" for days 2-6 (Monday to Friday)
//@field NewYork1150 string  Represents the time range "11:50-12:10" for days 2-6 (Monday to Friday)
//@field NewYork1310 string  Represents the time range "13:10-13:40" for days 2-6 (Monday to Friday)
//@field NewYork1515 string  Represents the time range "15:15-15:45" for days 2-6 (Monday to Friday)
export type mcTimes
	string London0233 = "0233-0300:23456"
	string London0403 = "0403-0430:23456"
	string NewYork0850 = "0850-0910:23456"
	string NewYork0950 = "0950-1010:23456"
	string NewYork1050 = "1050-1110:23456"
	string NewYork1150 = "1150-1210:23456"
	string NewYork1310 = "1310-1340:23456"
	string NewYork1515 = "1515-1545:23456"

// @function getKillzones: Get all Macros, reference New York time
// @returns [isLondon0233, isLondon0403, isNewYork0850, isNewYork0950, isNewYork1050, isNewYork1150, isNewYork1310, isNewYork1515]: Booleans
export getMacros()=>
	mct = mcTimes.new()
	isLondon0233 = isSession(mct.London0233)
	isLondon0403 = isSession(mct.London0403)
	isNewYork0850 = isSession(mct.NewYork0850)
	isNewYork0950 = isSession(mct.NewYork0950)
	isNewYork1050 = isSession(mct.NewYork1050)
	isNewYork1150 = isSession(mct.NewYork1150)
	isNewYork1310 = isSession(mct.NewYork1310)
	isNewYork1515 = isSession(mct.NewYork1515)

	mc = Macros.new(isLondon0233, isLondon0403, isNewYork0850, isNewYork0950, isNewYork1050, isNewYork1150, isNewYork1310, isNewYork1515)
	mc