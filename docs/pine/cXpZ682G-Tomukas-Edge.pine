//@version=6
// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                         MMF STRATEGY PREMIUM                           ║
// ║                Professional Multi-Confirmation Strategy                ║
// ╚══════════════════════════════════════════════════════════════════════════╝

strategy(
     "MMF Strategy Premium",
     overlay=true,
     pyramiding=0,
     initial_capital=10000,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     process_orders_on_close=true,
     calc_on_every_tick=false)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

groupTrend = "Trend"
emaFastLen = input.int(3, "Fast EMA", group=groupTrend)
emaSlowLen = input.int(6, "Slow EMA", group=groupTrend)
emaMidLen  = input.int(25, "Pullback EMA", group=groupTrend)
emaTrendLen= input.int(50, "Trend EMA", group=groupTrend)
emaMacroLen= input.int(200,"Macro EMA", group=groupTrend)

groupMomentum = "Momentum"

rsiLen = input.int(14, "RSI Length", group=groupMomentum)
rsiBull = input.int(55, "RSI Buy >", group=groupMomentum)
rsiBear = input.int(45, "RSI Sell <", group=groupMomentum)

macdFast = input.int(12, "MACD Fast", group=groupMomentum)
macdSlow = input.int(26, "MACD Slow", group=groupMomentum)
macdSignal = input.int(9, "MACD Signal", group=groupMomentum)

adxLen = input.int(14, "ADX Length", group=groupMomentum)
adxMin = input.float(22.0, "Minimum ADX", group=groupMomentum)

groupRisk = "Risk"

atrLen = input.int(14, "ATR Length", group=groupRisk)
slATR = input.float(1.2, "Stop ATR", group=groupRisk)
tpATR = input.float(1.8, "Take Profit ATR", group=groupRisk)
trailATR = input.float(1.0, "Trail ATR", group=groupRisk)

groupVolume = "Volume"

useVolume = input.bool(true, "Use Volume Filter", group=groupVolume)
volLen = input.int(20, "Volume MA", group=groupVolume)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INDICATORS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaMid = ta.ema(close, emaMidLen)
emaTrend = ta.ema(close, emaTrendLen)
emaMacro = ta.ema(close, emaMacroLen)

[macdLine, signalLine, hist] = ta.macd(close, macdFast, macdSlow, macdSignal)

rsi = ta.rsi(close, rsiLen)

atr = ta.atr(atrLen)

volMA = ta.sma(volume, volLen)

volumeOK = not useVolume or volume > volMA

[plusDI, minusDI, adx] = ta.dmi(adxLen, adxLen)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TREND
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullTrend =
     close > emaTrend and
     emaTrend > emaMacro

bearTrend =
     close < emaTrend and
     emaTrend < emaMacro

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PULLBACK
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

longPullback =
     low <= emaMid or
     low <= emaTrend

shortPullback =
     high >= emaMid or
     high >= emaTrend

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONFIRMATIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

emaBull = ta.crossover(emaFast, emaSlow)
emaBear = ta.crossunder(emaFast, emaSlow)

macdBull = ta.crossover(macdLine, signalLine)
macdBear = ta.crossunder(macdLine, signalLine)

adxBull =
     plusDI > minusDI and
     adx > adxMin

adxBear =
     minusDI > plusDI and
     adx > adxMin

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNALS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

longSignal =
     bullTrend and
     longPullback and
     emaBull and
     macdBull and
     rsi > rsiBull and
     adxBull and
     volumeOK

shortSignal =
     bearTrend and
     shortPullback and
     emaBear and
     macdBear and
     rsi < rsiBear and
     adxBear and
     volumeOK

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ORDERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if longSignal
    strategy.close("Short")
    strategy.entry("Long", strategy.long)

if shortSignal
    strategy.close("Long")
    strategy.entry("Short", strategy.short)

longStop =
     strategy.position_avg_price -
     atr * slATR

longTarget =
     strategy.position_avg_price +
     atr * tpATR

shortStop =
     strategy.position_avg_price +
     atr * slATR

shortTarget =
     strategy.position_avg_price -
     atr * tpATR

if strategy.position_size > 0
    strategy.exit(
         "Long Exit",
         "Long",
         stop=longStop,
         limit=longTarget,
         trail_points=atr * trailATR)

if strategy.position_size < 0
    strategy.exit(
         "Short Exit",
         "Short",
         stop=shortStop,
         limit=shortTarget,
         trail_points=atr * trailATR)
         