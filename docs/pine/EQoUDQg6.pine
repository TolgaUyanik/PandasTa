//@version=6
indicator('Hacke Volume + Anchored VWAP Signals', overlay = true, max_lines_count = 500, max_labels_count = 500)

// ================== INPUTS ==================
groupVol = 'Volumen-Setup'
groupVWAP = 'VWAP / Session'
groupSignal = 'Signale'

volLookback = input.int(20, 'RelVol Lookback', minval = 1, group = groupVol)
relVolThresh = input.float(1.5, 'RelVol Schwelle (z.B. 1.5 = 150%)', minval = 1.0, step = 0.1, group = groupVol)
bodyStrengthMin = input.float(0.6, 'Min. Körperstärke (0–1)', minval = 0.0, maxval = 1.0, step = 0.05, group = groupVol)

// Session-Einstellungen
sessSession = input.session('0930-1600', 'Regular Session (NY)', group = groupVWAP)
sessionTZ = input.string('America/New_York', 'Zeitzone', group = groupVWAP)

// Anchored VWAP
useAnchoredVWAP = input.bool(true, 'Anchored VWAP Filter nutzen', group = groupVWAP)

// WICHTIG: Default darf NICHT na sein → wir nehmen 0.
// 0 = kein Anchor gesetzt. Nur wenn du >0 einträgst, wird anchored VWAP benutzt.
anchorBarIndex = input.int(0, 'Anchor Bar Index (bar_index, >0 aktiv)', group = groupVWAP)

useSessionReset = input.bool(false, 'Anchored VWAP täglich zurücksetzen', group = groupVWAP)
showVWAPLine = input.bool(true, 'Anchored VWAP Linie anzeigen', group = groupVWAP)

// Signale
showSignals = input.bool(true, 'Long/Short Signale anzeigen', group = groupSignal)
showLabels = input.bool(true, 'Labels für Signale anzeigen', group = groupSignal)
onlyInSession = input.bool(false, 'Signale nur in Session', group = groupSignal)

// ================== BASIS: ZEIT & SESSION ==================
isNewDay = ta.change(time('D')) != 0
inSession = not na(time(timeframe.period, sessSession, sessionTZ))

// ================== RELATIVES VOLUMEN & KERZENSTÄRKE ==================
avgVol = ta.sma(volume, volLookback)
relVol = avgVol > 0 ? volume / avgVol : 1.0

barRange = high - low
body = math.abs(close - open)
bodyStrength = barRange > 0 ? body / barRange : 0.0

highVolBar = relVol > relVolThresh
strongBody = bodyStrength > bodyStrengthMin

bullCandle = close > open
bearCandle = close < open

// ================== ANCHORED VWAP ==================
var float aSumPV = 0.0
var float aSumV = 0.0
var float aVWAP = na
var int aStart = na

typPrice = hlc3

// Anchor nur benutzen, wenn >0 gesetzt ist
bool anchorActive = useAnchoredVWAP and anchorBarIndex > 0

if anchorActive
    if bar_index == anchorBarIndex
        aStart := bar_index
        aSumPV := typPrice * volume
        aSumV := volume
        aVWAP := aSumPV / aSumV
        aVWAP
    else if not na(aStart) and bar_index > aStart
        if useSessionReset and isNewDay
            aSumPV := typPrice * volume
            aSumV := volume
            aSumV
        else
            aSumPV := aSumPV + typPrice * volume
            aSumV := aSumV + volume
            aSumV
        aVWAP := aSumV > 0 ? aSumPV / aSumV : na
        aVWAP
else
    aVWAP := na
    aVWAP

plot(anchorActive and showVWAPLine ? aVWAP : na, title = 'Anchored VWAP', color = color.new(color.fuchsia, 0), linewidth = 2)

// ================== SIGNAL-LOGIK ==================
// Basis: Volumen + Candle
longBase = highVolBar and strongBody and bullCandle
shortBase = highVolBar and strongBody and bearCandle

// optional nur in Session
longBaseF = onlyInSession ? longBase and inSession : longBase
shortBaseF = onlyInSession ? shortBase and inSession : shortBase

// optionaler VWAP-Filter
longCond = anchorActive and not na(aVWAP) ? longBaseF and close > aVWAP : longBaseF
shortCond = anchorActive and not na(aVWAP) ? shortBaseF and close < aVWAP : shortBaseF

longSignal = showSignals and longCond
shortSignal = showSignals and shortCond

// ================== PLOTS & LABELS ==================
plotshape(longSignal, title = 'Long Signal', style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.small, text = 'L')
plotshape(shortSignal, title = 'Short Signal', style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.small, text = 'S')

if showLabels and longSignal
    label.new(bar_index, low, 'VOL LONG', style = label.style_label_up, color = color.new(color.lime, 0), textcolor = color.black)
if showLabels and shortSignal
    label.new(bar_index, high, 'VOL SHORT', style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white)

// ================== ALERT-BEDINGUNGEN ==================
alertcondition(longSignal, title = 'Hacke Volume LONG', message = 'Hacke Volume LONG Signal (hohes Volumen + starke grüne Kerze)')
alertcondition(shortSignal, title = 'Hacke Volume SHORT', message = 'Hacke Volume SHORT Signal (hohes Volumen + starke rote Kerze)')
