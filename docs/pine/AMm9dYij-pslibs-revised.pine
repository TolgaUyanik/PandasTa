//@version=6
library("pslibs_revised")

// Exported function to calculate divergence signals
// Exported function to calculate divergence signals based on closing price
// Parameters:
// - close: Price series of the close prices.
// - mom: Momentum series.
// - rsi: Relative Strength Index series.
// - start_lookback: Starting period for looking back.
// - max_lookback: Maximum period to look back.
// - rsiThresholdBuy: RSI threshold for buy signal.
// - rsiThresholdSell: RSI threshold for sell signal.
// - minAngleDiff: Minimum angle difference to consider for divergence.
// - run_flag: A flag to enable or disable the calculation.
export f_calculate_divergence_on_close(series float close, series float mom, series float rsi, int start_lookback, int max_lookback, float rsiThresholdBuy, float rsiThresholdSell, float minAngleDiff, bool run_flag) =>
    var string[] uniqueCandles = array.new_string(0)
    int divergenceBuy = 0
    int divergenceSell = 0
    if run_flag==true
        for i = start_lookback to max_lookback
            float closePrev = close[i]
            float momPrev = mom[i]
            string candleID = str.tostring(close[i])  // Using close prices for unique candle IDs
            if not array.includes(uniqueCandles, candleID)
                float priceSlope = (close - closePrev) / i  // Using close prices for slope calculations
                float momSlope = (mom - momPrev) / i
                float priceAngle = math.atan(priceSlope) * (180 / math.pi)
                float momAngle = math.atan(momSlope) * (180 / math.pi)
                if (close < closePrev and mom > momPrev and priceAngle < -minAngleDiff and momAngle > minAngleDiff) and (rsi < rsiThresholdBuy or rsi[1] < rsiThresholdBuy)
                    array.push(uniqueCandles, candleID)
                    divergenceBuy := 1
                    break
                if (close > closePrev and mom < momPrev and momAngle < -minAngleDiff and priceAngle > minAngleDiff) and (rsi > rsiThresholdSell or rsi[1] > rsiThresholdSell)
                    array.push(uniqueCandles, candleID)
                    divergenceSell := 1
                    break
    [divergenceBuy, divergenceSell]


// Exported function to calculate divergence signals based on the low price
// Parameters are the same as the above function, but based on the low price.
export f_calculate_divergence_on_low(series float low, series float mom, series float rsi, int start_lookback, int max_lookback, float rsiThresholdBuy, float rsiThresholdSell, float minAngleDiff, bool run_flag) =>
    var string[] uniqueCandles = array.new_string(0)
    int divergenceBuy = 0
    int divergenceSell = 0
    if run_flag==true
        for i = start_lookback to max_lookback
            float closePrev = low[i]
            float momPrev = mom[i]
            string candleID = str.tostring(low[i])  // Using close prices for unique candle IDs
            if not array.includes(uniqueCandles, candleID)
                float priceSlope = (low - closePrev) / i  // Using close prices for slope calculations
                float momSlope = (mom - momPrev) / i
                float priceAngle = math.atan(priceSlope) * (180 / math.pi)
                float momAngle = math.atan(momSlope) * (180 / math.pi)
                if (low < closePrev and mom > momPrev and priceAngle < -minAngleDiff and momAngle > minAngleDiff) and (rsi < rsiThresholdBuy or rsi[1] < rsiThresholdBuy)
                    array.push(uniqueCandles, candleID)
                    divergenceBuy := 1
                    break
                if (low > closePrev and mom < momPrev and momAngle < -minAngleDiff and priceAngle > minAngleDiff) and (rsi > rsiThresholdSell or rsi[1] > rsiThresholdSell)
                    array.push(uniqueCandles, candleID)
                    divergenceSell := 1
                    break
    [divergenceBuy, divergenceSell]

// Exported function to calculate divergence signals based on closing price
// Parameters:
// - close: Price series of the close prices.
// - mom: Momentum series.
// - rsi: Relative Strength Index series.
// - start_lookback: Starting period for looking back.
// - max_lookback: Maximum period to look back.
// - rsiThresholdBuy: RSI threshold for buy signal.
// - rsiThresholdSell: RSI threshold for sell signal.
// - minAngleDiff: Minimum angle difference to consider for divergence.
// - run_flag: A flag to enable or disable the calculation.
export f_calculate_reversal(series float close, series float low, series float high, int macdFastPeriod, int macdSlowPeriod, int macdSignalPeriod, int stochPeriod, int prcKPeriod, int stochOS, int stochOB, bool run_flag) =>
    [macdLine, signalLine, _] = ta.macd(close, macdFastPeriod, macdSlowPeriod, macdSignalPeriod)
    
    float fastPrcK = 100 * (close - ta.lowest(low, stochPeriod)) / (ta.highest(high, stochPeriod) - ta.lowest(low, stochPeriod))
    //float fastPrcD = ta.sma(fastPrcK, prcDPeriod)
    float slowPrcK = ta.sma(fastPrcK, prcKPeriod)
    //float slowPrcD = ta.sma(slowPrcK, prcDPeriod)
    float fullPrcK = ta.sma(fastPrcK, prcKPeriod)
    //float fullPrcD = ta.sma(fullPrcK, prcDPeriod)
    
    bool isBuyReversal = run_flag and ta.crossover(macdLine, 0) and fullPrcK < stochOS //and fastPrcD < slowPrcD
    bool isSellReversal = run_flag and ta.crossunder(macdLine, 0) and fullPrcK > stochOB //and fastPrcD > slowPrcD
    
    [isBuyReversal, isSellReversal]

// Function to check if the current time is within the first 30 minutes of market open
export is_within_first_30_minutes() =>
    offsetHours = 0//isDST() ? 0 : 1
    marketOpenTime = timestamp(year, month, dayofmonth, 9 + offsetHours, 30)
    time >= marketOpenTime and time < marketOpenTime + 30 * 60 * 1000

// Function to check if the current time is within the last 60 minutes of market close
export is_last_60_minutes() =>
    offsetHours = 0//isDST() ? 0 : 1
    marketCloseTime = timestamp(year, month, dayofmonth, 16 + offsetHours, 0)
    time >= marketCloseTime - 60 * 60 * 1000 and time < marketCloseTime


// Function to check if the current time is within the last 60 minutes of market close
export is_last_30_minutes() =>
    offsetHours = 0//isDST() ? 0 : 1
    marketCloseTime = timestamp(year, month, dayofmonth, 16 + offsetHours, 0)
    time >= marketCloseTime - 30 * 60 * 1000 and time < marketCloseTime



// Function to convert timeframe to minutes and round up
convertToMinutes() =>
    // Get the timeframe period
    tf = timeframe.period

    // Convert to minutes based on the timeframe
    minutes = switch tf
        "1"  => 1
        "2"  => 2
        "5"  => 5
        "15" => 15
        "30" => 30
        "60" => 60
        "240" => 240
        //"D"  => 1440  // 1 day = 1440 minutes
        // "W"  => 10080 // 1 week = 10080 minutes
        // "M"  => 43200 // 1 month = 43200 minutes
        => na  // Catch any undefined timeframes

    // Round up the value
    math.round(minutes)


// Function to check if the previous day was in a positive trend
// Parameters:
// - None (uses current chart data).
// Random bar offset (e.g., 5 bars ago)
export func_yestday_was_postive_trend() =>
    yesterday_was_positive_trend=false
    // Get the date components for the current and random candles
    currentYear = year(time)
    currentMonth = month(time)
    currentDay = dayofmonth(time)


    [xOpen_, xHigh_, xLow_, xClose_] = request.security(syminfo.tickerid, "1D", [open, high, low, close],lookahead = barmerge.lookahead_off)
    vPP_ = (xHigh_ + xLow_ + xClose_) / 3
//    plot(vPP_, color=#813786, title="vPP", style=plot.style_circles, linewidth=2)
    [xOpen_previous, xHigh_previous, xLow_previous, xClose_previous] = request.security(syminfo.tickerid, "1D", [open[1], high[1], low[1], close[1]],lookahead = barmerge.lookahead_off)
    vPP_previous = (xHigh_previous + xLow_previous+ xClose_previous) / 3



    [xOpen, xHigh, xLow, xClose] = request.security(syminfo.tickerid, "1D", [open, high, low, close], lookahead=barmerge.lookahead_off)



    
    date_changed = ta.change(time("D"))
    yesterday_periods=math.round(390/convertToMinutes())
    is_postive_trend_pp=false
    if date_changed>1
        if xClose>xOpen and open>vPP_
            check=0
            //label.new(bar_index, high+1,str.tostring(yesterday_periods)+"  "+ str.tostring(math.round(open))+":"+ str.tostring(math.round(vPP_)), color=color.red, textcolor=color.white)
            
            for i = 1 to yesterday_periods//7
                if close[i]>vPP_previous and open[i]>vPP_previous
                    check:=check+1
                    is_postive_trend_pp:=true
                    //label.new(bar_index[i], high+1,str.tostring("Step 2")+ str.tostring(close[i])+" "+ str.tostring(vPP_previous), color=color.red, textcolor=color.white)
                else
                    yesterday_was_positive_trend:=false
                    is_postive_trend_pp:=false
                    break
            if check==yesterday_periods //is_postive_trend_pp==true  or
                yesterday_was_positive_trend:=true
                label.new(bar_index, high+2,str.tostring("YD+")+" ", color=#5261ff, textcolor=color.white)
    //label.new(bar_index,high+5,str.tostring(yesterday_was_positive_trend),color = color.red,textcolor = color.black)           
    [yesterday_was_positive_trend,vPP_]

