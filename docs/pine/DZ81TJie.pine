//@version=6

// ┌──────────────────────────────────────────────────────────────────────────┐
// │  AetherEdge - Triaxial Consensus Strategy  ·  AE-TRIAX-S                    │
// │                                                                            │
// │  Strategy version of AE-TRIAX. The 3-axis consensus engine with 5 AI/ML/RL │
// │  layers issues entries; a full position-management stack handles exits.    │
// │                                                                            │
// │  ENGINE (unchanged from indicator):                                        │
// │    • 3 axes (Trend / Momentum / Volatility), continuous -100..+100         │
// │    • RL-style adaptive axis weights                                        │
// │    • ML regime classifier (Trend / Range / Volatile / Quiet)               │
// │    • MTF alignment filter (HTF 1h / 4h default)                            │
// │    • Q-learning consensus threshold                                        │
// │    • Confidence% from total weighted score                                 │
// │                                                                            │
// │  POSITION MANAGEMENT (new in strategy):                                    │
// │    • Smart position sizing — risk% per trade, scaled by Confidence%,      │
// │      capped by Max Leverage                                                │
// │    • 3-tier TP1/TP2/TP3 with configurable partial-close % at TP1           │
// │    • Breakeven SL move after TP1                                           │
// │    • Intelligent trailing SL — only while Momentum axis agrees             │
// │    • Drawdown protection — halts entries on DD spike                       │
// │    • Webhook-ready alert messages with full context                        │
// └──────────────────────────────────────────────────────────────────────────┘

strategy("AetherEdge - Triaxial Consensus Strategy", "AE-TRIAX-S", overlay = true,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.0,
     max_lines_count = 200, max_labels_count = 200,
     pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = true)


// ============================================================================
//  ░░ INPUTS — engine ░░
// ============================================================================
gP = "▓ PRESET ▓"
presetInput = input.string("Beginner (conservative)", "Profile",
     options = ["Beginner (conservative)", "Standard", "Aggressive"], group = gP,
     tooltip = "Beginner = stricter consensus, fewer signals. Aggressive = looser, more signals.")

gAX = "▓ AXES ▓"
ax_trendOn   = input.bool(true, "Use Trend Axis",      group = gAX)
ax_momOn     = input.bool(true, "Use Momentum Axis",   group = gAX)
ax_volaOn    = input.bool(true, "Use Volatility Axis", group = gAX)
ax_tolInput  = input.float(20.0, "Cross-Axis Tolerance", minval = 5.0, maxval = 80.0, step = 5.0, group = gAX,
     tooltip = "Max disagreement allowed between axes (in score units, -100..+100). Lower = stricter.")

gAI = "▓ AI · ADAPTIVE WEIGHTS ▓"
ai_enableInput= input.bool(true, "Adaptive Axis Weights (RL-style)", group = gAI)
ai_strengthIn = input.float(1.0, "Adaptation Strength", minval = 0.0, maxval = 2.0, step = 0.1, group = gAI)
ai_minWInput  = input.float(0.6, "Min Weight", minval = 0.1, maxval = 1.0, step = 0.1, group = gAI)
ai_maxWInput  = input.float(1.8, "Max Weight", minval = 1.0, maxval = 3.0, step = 0.1, group = gAI)
ai_horizonInp = input.int(8, "Outcome Horizon (bars)", minval = 3, maxval = 50, group = gAI)
ai_winInput   = input.float(0.8, "Required Move (ATR)", minval = 0.2, maxval = 4.0, step = 0.1, group = gAI)

gMTF = "▓ AI · MTF ALIGNMENT ▓"
mtf_enableInput= input.bool(true, "Higher-TF Alignment", group = gMTF)
mtf_tf1Input   = input.timeframe("60",  "HTF 1", group = gMTF)
mtf_tf2Input   = input.timeframe("240", "HTF 2", group = gMTF)

gRG = "▓ AI · REGIME CLASSIFIER ▓"
rg_enableInput= input.bool(true, "Regime-Aware Weighting", group = gRG)

gQL = "▓ AI · Q-LEARNING THRESHOLDS ▓"
ql_enableInput= input.bool(true, "Adaptive Consensus Threshold", group = gQL)
ql_explInput  = input.float(0.1, "Exploration (ε)", minval = 0.0, maxval = 0.5, step = 0.02, group = gQL)


// ============================================================================
//  ░░ INPUTS — risk/reward ░░
// ============================================================================
gRR = "▓ RISK / REWARD ▓"
rr_atrMulSL   = input.float(1.5, "SL Distance (× ATR)", minval = 0.3, maxval = 5.0, step = 0.1, group = gRR)
rr_ratioInput = input.float(2.5, "Default RR Ratio (TP2 : SL)", minval = 0.5, maxval = 8.0, step = 0.1, group = gRR)
rr_useTrailInp= input.bool(true, "Intelligent Trailing Stop", group = gRR)
rr_maxTPInput = input.int(3, "Max TP Levels (1-3)", minval = 1, maxval = 3, group = gRR)
rr_partialInp = input.float(50.0, "Partial Close % at TP1", minval = 0.0, maxval = 100.0, step = 5.0, group = gRR)
rr_beAfter1Inp= input.bool(true, "Breakeven SL After TP1", group = gRR)

gPS = "▓ POSITION SIZING ▓"
ps_riskPctInp = input.float(1.0, "Risk % per Trade", minval = 0.1, maxval = 10.0, step = 0.1, group = gPS,
     tooltip = "Account % risked per trade. 1% standard.")
ps_maxLevInp  = input.float(5.0, "Max Leverage", minval = 1.0, maxval = 100.0, step = 1.0, group = gPS)
ps_scaleByCon = input.bool(true, "Scale Size by Confidence", group = gPS,
     tooltip = "Confidence 80%+ = full sizing; lower = scaled down; below 40% blocked.")

gDP = "▓ DRAWDOWN PROTECTION ▓"
dp_enableInput= input.bool(true, "Halt Signals on Drawdown Spike", group = gDP)
dp_maxDDPct   = input.float(8.0, "Max Drawdown Halt %", minval = 2.0, maxval = 30.0, step = 0.5, group = gDP)


// ============================================================================
//  ░░ INPUTS — visuals ░░
// ============================================================================
gV = "▓ VISUALS ▓"
vi_themeInput = input.string("Tetrachrome (blue/green/yellow/red)", "Palette",
     options = ["Tetrachrome (blue/green/yellow/red)", "Emerald / Ruby", "Spectral"], group = gV)
vi_emaCloud   = input.bool(true, "Show EMA Cloud (3-tier)", group = gV)
vi_barColor   = input.bool(true, "Color Candles by Consensus", group = gV)
vi_showDash   = input.bool(true, "Show Dashboard", group = gV)


// ============================================================================
//  ░░ PRESET RESOLUTION ░░
// ============================================================================
// ============================================================================
//  ░░ PRESET RESOLUTION ░░
//  Thresholds revised after testing showed previous values were too strict for
//  typical bear scenarios (Vol axis goes neutral, finalScore lands ~45-60 even
//  on strong downtrends, missing SELL signals).
// ============================================================================
[presetThrLo, presetThrHi] = switch presetInput
    "Beginner (conservative)" => [50.0, 70.0]
    "Aggressive"              => [30.0, 50.0]
    => [40.0, 60.0]   // Standard


// ============================================================================
//  ░░ PALETTE ░░
// ============================================================================
var color cBuyStrong  = na
var color cBuyWeak    = na
var color cSellStrong = na
var color cSellWeak   = na
var color cNeut       = na
var color cAcc        = na
var color cTxt        = #eef2f0
var color cTxtD       = #6b7d76
var color cPanel      = #080b0a
var color cPanelHd    = #0f1614

setPalette() =>
    [bs, bw, ss, sw, n, a] = switch vi_themeInput
        "Emerald / Ruby" => [#10e0a0, #4ef0c0, #ff3860, #ff8c42, #6b7d76, #d4af37]
        "Spectral"       => [#22d3ee, #67e8f9, #f43f5e, #fb923c, #a78bfa, #e879f9]
        => [#10b981, #3b82f6, #ef4444, #f59e0b, #6b7d76, #d4af37]
    [bs, bw, ss, sw, n, a]
[psbs, psbw, psss, pssw, psn, psa] = setPalette()
cBuyStrong  := psbs
cBuyWeak    := psbw
cSellStrong := psss
cSellWeak   := pssw
cNeut       := psn
cAcc        := psa


// ============================================================================
//  ░░ HELPERS ░░
// ============================================================================
sdiv(a, b) =>
    b != 0 ? a / b : 0.0
clamp(v, lo, hi) =>
    math.max(lo, math.min(hi, v))


// ============================================================================
//  ░░ COMMON SERIES ░░
// ============================================================================
atr = ta.atr(14)
atrAvg = ta.sma(atr, 50)


// ============================================================================
//  ░░ AXIS 1 — TREND ░░
// ============================================================================
ema1 = ta.ema(close,   8)
ema2 = ta.ema(close,  21)
ema3 = ta.ema(close,  55)
ema4 = ta.ema(close, 100)
ema5 = ta.ema(close, 200)

stackUp = (ema1 > ema2 ? 1 : 0) + (ema2 > ema3 ? 1 : 0) + (ema3 > ema4 ? 1 : 0) + (ema4 > ema5 ? 1 : 0)
stackDn = (ema1 < ema2 ? 1 : 0) + (ema2 < ema3 ? 1 : 0) + (ema3 < ema4 ? 1 : 0) + (ema4 < ema5 ? 1 : 0)
stackScore = (stackUp - stackDn) * 25.0

pivLen = 5
phP = ta.pivothigh(high, pivLen, pivLen)
plP = ta.pivotlow(low,  pivLen, pivLen)
var float lastHH = na
var float prevHH = na
var float lastLL = na
var float prevLL = na
if not na(phP)
    prevHH := lastHH
    lastHH := phP
if not na(plP)
    prevLL := lastLL
    lastLL := plP

hhUp = not na(lastHH) and not na(prevHH) and lastHH > prevHH
llUp = not na(lastLL) and not na(prevLL) and lastLL > prevLL
hhDn = not na(lastHH) and not na(prevHH) and lastHH < prevHH
llDn = not na(lastLL) and not na(prevLL) and lastLL < prevLL
dowScore = (hhUp ? 25 : 0) + (llUp ? 25 : 0) - (hhDn ? 25 : 0) - (llDn ? 25 : 0)

[diPlus, diMinus, adx] = ta.dmi(14, 14)
adxScore = adx > 25 ? (diPlus > diMinus ? 50 : -50) : adx > 18 ? (diPlus > diMinus ? 25 : -25) : 0

trendScore = clamp(stackScore * 0.5 + dowScore * 0.3 + adxScore * 0.2, -100.0, 100.0)


// ============================================================================
//  ░░ AXIS 2 — MOMENTUM ░░
// ============================================================================
rsi = ta.rsi(close, 14)
rsiSmooth = ta.ema(rsi, 5)
qqeScore = (rsiSmooth - 50.0) * 2.0

[macdLine, sigLine, hist] = ta.macd(close, 12, 26, 9)
histScore = clamp(hist * 50.0 / (atr + 1e-9), -100.0, 100.0)

momScore = clamp(qqeScore * 0.6 + histScore * 0.4, -100.0, 100.0)


// ============================================================================
//  ░░ AXIS 3 — VOLATILITY ░░
// ============================================================================
bbBasis = ta.sma(close, 20)
bbDev   = ta.stdev(close, 20) * 2
bbW = sdiv((bbBasis + bbDev) - (bbBasis - bbDev), bbBasis) * 100.0
bbWAvg = ta.sma(bbW, 50)
expansion = bbW > bbWAvg * 1.2
squeeze   = bbW < bbWAvg * 0.6

atrRatio = sdiv(atr, atrAvg)
healthyVol = atrRatio < 1.6 and atrRatio > 0.6

candleDir = close > open ? 1 : close < open ? -1 : 0
bodyRatio = sdiv(math.abs(close - open), high - low)
strongCandle = bodyRatio > 0.5

volaScore = (expansion and healthyVol and strongCandle) ? candleDir * 60.0 : 0.0
slopeNorm = clamp(sdiv(close - close[3], atr) * 20.0, -40.0, 40.0)
volaScore := clamp(volaScore + slopeNorm, -100.0, 100.0)


// ============================================================================
//  ░░ REGIME CLASSIFICATION ░░
// ============================================================================
regimeTrend    = adx >= 25 and (stackUp >= 3 or stackDn >= 3)
regimeVolatile = atrRatio >= 1.5
regimeQuiet    = squeeze or atrRatio <= 0.6
regimeName  = regimeTrend ? "Trend" : regimeVolatile ? "Volatile" : regimeQuiet ? "Quiet" : "Range"
regimeCol   = regimeTrend ? cBuyStrong : regimeVolatile ? cSellStrong : regimeQuiet ? cNeut : cSellWeak


// ============================================================================
//  ░░ RL · ADAPTIVE AXIS WEIGHTS ░░
// ============================================================================
NA = 3
var float[] relW = array.new<float>(NA, 0.5)
var int[]   pAg  = array.new<int>(0)
var int[]   pDir = array.new<int>(0)
var float[] pPx  = array.new<float>(0)
var int[]   pAge = array.new<int>(0)

armSample(ag, dir) =>
    array.push(pAg, ag)
    array.push(pDir, dir)
    array.push(pPx, close)
    array.push(pAge, 0)

trendDir = trendScore > 20 ? 1 : trendScore < -20 ? -1 : 0
momDir   = momScore   > 20 ? 1 : momScore   < -20 ? -1 : 0
volaDir  = volaScore  > 20 ? 1 : volaScore  < -20 ? -1 : 0

if ai_enableInput and barstate.isconfirmed
    if trendDir != 0 and trendDir != trendDir[1]
        armSample(0, trendDir)
    if momDir != 0 and momDir != momDir[1]
        armSample(1, momDir)
    if volaDir != 0
        armSample(2, volaDir)

if ai_enableInput and barstate.isconfirmed and array.size(pAg) > 0
    i = array.size(pAg) - 1
    while i >= 0
        age = array.get(pAge, i) + 1
        array.set(pAge, i, age)
        if age >= ai_horizonInp
            ag  = array.get(pAg, i)
            dir = array.get(pDir, i)
            px0 = array.get(pPx, i)
            move = dir > 0 ? (close - px0) : (px0 - close)
            won = move >= ai_winInput * atr ? 1.0 : 0.0
            old = array.get(relW, ag)
            alpha = 0.15 * ai_strengthIn
            array.set(relW, ag, clamp(old + alpha * (won - old), 0.0, 1.0))
            array.remove(pAg, i)
            array.remove(pDir, i)
            array.remove(pPx, i)
            array.remove(pAge, i)
        i -= 1

relToW(r) =>
    ai_enableInput ? ai_minWInput + (ai_maxWInput - ai_minWInput) * r : 1.0

regimeMul(ag) =>
    out = 1.0
    if rg_enableInput
        if regimeTrend
            out := ag == 0 ? 1.3 : ag == 1 ? 1.1 : 0.9
        else if regimeVolatile
            out := ag == 2 ? 1.3 : ag == 1 ? 1.1 : 0.9
        else if regimeQuiet
            out := 0.7
        else
            out := ag == 1 ? 1.2 : ag == 0 ? 0.9 : 1.0
    out

wT = (ax_trendOn ? relToW(array.get(relW, 0)) * regimeMul(0) : 0.0)
wM = (ax_momOn   ? relToW(array.get(relW, 1)) * regimeMul(1) : 0.0)
wV = (ax_volaOn  ? relToW(array.get(relW, 2)) * regimeMul(2) : 0.0)


// ============================================================================
//  ░░ MTF ALIGNMENT ░░
// ============================================================================
htfVerdict() =>
    eF = ta.ema(close, 12)
    eS = ta.ema(close, 30)
    r  = ta.rsi(close, 14)
    eF > eS and r > 50 ? 1 : eF < eS and r < 50 ? -1 : 0

mtfV1 = mtf_enableInput ? request.security(syminfo.tickerid, mtf_tf1Input, htfVerdict(), lookahead = barmerge.lookahead_off) : 0
mtfV2 = mtf_enableInput ? request.security(syminfo.tickerid, mtf_tf2Input, htfVerdict(), lookahead = barmerge.lookahead_off) : 0


// ============================================================================
//  ░░ CONSENSUS COMPUTATION ░░
// ============================================================================
weightedSum = trendScore * wT + momScore * wM + volaScore * wV
maxPossible = (wT + wM + wV) * 100.0
rawScore = sdiv(weightedSum, maxPossible) * 100.0

sgn = math.sign(rawScore)
mtfBonus = mtf_enableInput ? (int(math.sign(mtfV1)) == int(sgn) and sgn != 0 ? 10 : (mtfV1 != 0 ? -10 : 0)) + (int(math.sign(mtfV2)) == int(sgn) and sgn != 0 ? 10 : (mtfV2 != 0 ? -10 : 0)) : 0
finalScore = clamp(rawScore + mtfBonus, -100.0, 100.0)

confidencePct = math.abs(finalScore)

// Cross-axis tolerance check (revised, symmetric for buy and sell).
// Old logic required ALL active axes same-sign, which made SELL signals rare
// because the Volatility axis is often neutral or weakly positive. New logic:
//   • Count axes that "lean" in each direction (|score| > 10 = leaning).
//   • Neutral axes (|score| <= 10) are ignored, neither for nor against.
//   • Trend axis must lean in the signal direction (enforced below).
//   • Of the LEANING axes, the majority must agree with the signal direction.
//   • Spread of LEANING axes must be within tolerance.
activeScores = array.new<float>(0)
if ax_trendOn
    array.push(activeScores, trendScore)
if ax_momOn
    array.push(activeScores, momScore)
if ax_volaOn
    array.push(activeScores, volaScore)

leanUp   = 0
leanDn   = 0
leanScores = array.new<float>(0)
if array.size(activeScores) > 0
    for i = 0 to array.size(activeScores) - 1
        s = array.get(activeScores, i)
        if s > 10
            leanUp += 1
            array.push(leanScores, s)
        else if s < -10
            leanDn += 1
            array.push(leanScores, s)

agreedUp = leanUp > leanDn and leanUp >= 1
agreedDn = leanDn > leanUp and leanDn >= 1

spreadOK = true
if array.size(leanScores) >= 2
    leanMax = array.max(leanScores)
    leanMin = array.min(leanScores)
    spreadOK := (leanMax - leanMin) <= ax_tolInput * 2.0

toleranceOK = (agreedUp or agreedDn) and spreadOK

maxScore = array.size(activeScores) > 0 ? array.max(activeScores) : 0.0
minScore = array.size(activeScores) > 0 ? array.min(activeScores) : 0.0


// ============================================================================
//  ░░ Q-LEARNING CONSENSUS THRESHOLD ░░
// ============================================================================
NTH = 4
var float[] thrCand = array.new<float>(NTH, 50.0)
if barstate.isfirst
    step = (presetThrHi - presetThrLo) / (NTH - 1)
    for k = 0 to NTH - 1
        array.set(thrCand, k, presetThrLo + step * k)

var float[] qThr  = array.new<float>(NTH, 0.5)
var int[]   pThK  = array.new<int>(0)
var int[]   pThD  = array.new<int>(0)
var float[] pThPx = array.new<float>(0)
var int[]   pThA  = array.new<int>(0)

chooseThrIdx() =>
    bestI = 0
    bestQ = array.get(qThr, 0)
    for k = 1 to NTH - 1
        if array.get(qThr, k) > bestQ
            bestQ := array.get(qThr, k)
            bestI := k
    u = math.sin(bar_index * 1.137 + 0.7) * 43758.5453
    u := u - math.floor(u)
    ql_explInput > 0 and u < ql_explInput ? int(math.floor(u * NTH * 7) % NTH) : bestI

var int thrIdx = 1
if ql_enableInput and barstate.isconfirmed
    thrIdx := chooseThrIdx()
activeThr = ql_enableInput ? array.get(thrCand, thrIdx) : (presetThrLo + presetThrHi) / 2.0


// ============================================================================
//  ░░ DRAWDOWN PROTECTION ░░
// ============================================================================
var float peakEq = na
if na(peakEq) or strategy.equity > peakEq
    peakEq := strategy.equity
ddPct = na(peakEq) ? 0.0 : (peakEq - strategy.equity) / peakEq * 100.0
ddHalt = dp_enableInput and ddPct >= dp_maxDDPct


// ============================================================================
//  ░░ FINAL SIGNAL CONDITION ░░
// ============================================================================
// Strong condition: identical to indicator version (toleranceOK + score
// threshold + Trend axis leaning in signal direction + lean-majority agreement).
// Risk filters (ddHalt, position guard, confidence floor) are NOT applied here
// so signals appear at the same bars as the indicator. Entry execution applies
// those filters separately via canEnter below.
trendLeanUp = trendScore > 10
trendLeanDn = trendScore < -10
strongBuy  = toleranceOK and finalScore >=  activeThr and trendLeanUp  and agreedUp
strongSell = toleranceOK and finalScore <= -activeThr and trendLeanDn and agreedDn

var int lastSig = 0
fireBuy  = strongBuy  and lastSig != 1
fireSell = strongSell and lastSig != -1
if barstate.isconfirmed
    if strongBuy
        lastSig := 1
    if strongSell
        lastSig := -1
    if not strongBuy and not strongSell and math.abs(finalScore) < activeThr - 15.0
        lastSig := 0


// Q-learning sample arming + resolution.
if ql_enableInput and barstate.isconfirmed
    if fireBuy or fireSell
        array.push(pThK, thrIdx)
        array.push(pThD, fireBuy ? 1 : -1)
        array.push(pThPx, close)
        array.push(pThA, 0)

if ql_enableInput and barstate.isconfirmed and array.size(pThK) > 0
    i = array.size(pThK) - 1
    while i >= 0
        age = array.get(pThA, i) + 1
        array.set(pThA, i, age)
        if age >= ai_horizonInp
            k   = array.get(pThK, i)
            dir = array.get(pThD, i)
            px0 = array.get(pThPx, i)
            move = dir > 0 ? (close - px0) : (px0 - close)
            won = move >= ai_winInput * atr ? 1.0 : 0.0
            old = array.get(qThr, k)
            array.set(qThr, k, clamp(old + 0.15 * (won - old), 0.0, 1.0))
            array.remove(pThK, i)
            array.remove(pThD, i)
            array.remove(pThPx, i)
            array.remove(pThA, i)
        i -= 1


// ============================================================================
//  ░░ POSITION SIZING ░░
// ============================================================================
positionSizePct(slPx, entryPx) =>
    slDistPct = math.abs(entryPx - slPx) / entryPx * 100.0
    baseSize = sdiv(ps_riskPctInp, slDistPct) * 100.0
    confMul = ps_scaleByCon ? clamp(confidencePct / 80.0, 0.4, 1.0) : 1.0
    leverageCap = ps_maxLevInp * 100.0
    clamp(baseSize * confMul, 0.1, leverageCap)


// ============================================================================
//  ░░ TRADE STATE (for visuals + trailing/breakeven) ░░
// ============================================================================
var line lnSL   = na
var line lnTP1  = na
var line lnTP2  = na
var line lnTP3  = na
var float trEntry = na
var float trSL  = na
var float trTP1 = na
var float trTP2 = na
var float trTP3 = na
var int   trDir = 0
var bool  trTP1Hit = false


// ============================================================================
//  ░░ STRATEGY ENTRIES + EXITS ░░
// ============================================================================
canEnter = strategy.position_size == 0 and confidencePct >= 40.0 and not ddHalt

if fireBuy and canEnter
    slPxLong = close - atr * rr_atrMulSL
    tp1PxLong = close + atr * rr_atrMulSL * (rr_ratioInput * 0.6)
    tp2PxLong = close + atr * rr_atrMulSL * rr_ratioInput
    tp3PxLong = close + atr * rr_atrMulSL * rr_ratioInput * 1.6
    qPct = positionSizePct(slPxLong, close)
    strategy.entry("LONG", strategy.long, qty = qPct,
         alert_message = "AE-TRIAX-S BUY @ " + str.tostring(close, format.mintick) + " | Conf " + str.tostring(math.round(confidencePct)) + "% | SL " + str.tostring(slPxLong, format.mintick) + " | TP1 " + str.tostring(tp1PxLong, format.mintick) + " | Regime " + regimeName)
    if rr_maxTPInput >= 1
        strategy.exit("TP1", "LONG", qty_percent = rr_partialInp, stop = slPxLong, limit = tp1PxLong, alert_message = "AE-TRIAX-S LONG TP1/SL hit")
    if rr_maxTPInput >= 2
        rem2 = (100.0 - rr_partialInp) * 0.5
        strategy.exit("TP2", "LONG", qty_percent = rem2, stop = slPxLong, limit = tp2PxLong, alert_message = "AE-TRIAX-S LONG TP2/SL hit")
    if rr_maxTPInput >= 3
        strategy.exit("TP3", "LONG", stop = slPxLong, limit = tp3PxLong, alert_message = "AE-TRIAX-S LONG TP3/SL hit")
    if not na(lnSL)
        line.delete(lnSL)
    if not na(lnTP1)
        line.delete(lnTP1)
    if not na(lnTP2)
        line.delete(lnTP2)
    if not na(lnTP3)
        line.delete(lnTP3)
    trEntry := close
    trSL := slPxLong
    trTP1 := tp1PxLong
    trTP2 := tp2PxLong
    trTP3 := tp3PxLong
    trDir := 1
    trTP1Hit := false
    lnSL  := line.new(bar_index, slPxLong,  bar_index + 50, slPxLong,  color = color.new(cSellStrong, 20), style = line.style_dashed, width = 2, extend = extend.right)
    lnTP1 := line.new(bar_index, tp1PxLong, bar_index + 50, tp1PxLong, color = color.new(cBuyStrong, 50), style = line.style_dotted, width = 1, extend = extend.right)
    lnTP2 := line.new(bar_index, tp2PxLong, bar_index + 50, tp2PxLong, color = color.new(cBuyStrong, 30), style = line.style_dashed, width = 1, extend = extend.right)
    lnTP3 := line.new(bar_index, tp3PxLong, bar_index + 50, tp3PxLong, color = color.new(cBuyStrong, 10), style = line.style_solid,  width = 2, extend = extend.right)
    slPctLong = math.abs(close - slPxLong) / close * 100.0
    tp1PctLong = math.abs(close - tp1PxLong) / close * 100.0
    label.new(bar_index, low - atr * 1.2, "★ BUY " + str.tostring(math.round(confidencePct)) + "%\nSL " + str.tostring(slPctLong, "#.0") + "%  TP1 " + str.tostring(tp1PctLong, "#.0") + "%  Qty " + str.tostring(qPct, "#.0") + "%",
         yloc = yloc.price, color = cBuyStrong, textcolor = #04140f, style = label.style_label_up, size = size.normal)

if fireSell and canEnter
    slPxShort = close + atr * rr_atrMulSL
    tp1PxShort = close - atr * rr_atrMulSL * (rr_ratioInput * 0.6)
    tp2PxShort = close - atr * rr_atrMulSL * rr_ratioInput
    tp3PxShort = close - atr * rr_atrMulSL * rr_ratioInput * 1.6
    qPct = positionSizePct(slPxShort, close)
    strategy.entry("SHORT", strategy.short, qty = qPct,
         alert_message = "AE-TRIAX-S SELL @ " + str.tostring(close, format.mintick) + " | Conf " + str.tostring(math.round(confidencePct)) + "% | SL " + str.tostring(slPxShort, format.mintick) + " | TP1 " + str.tostring(tp1PxShort, format.mintick) + " | Regime " + regimeName)
    if rr_maxTPInput >= 1
        strategy.exit("TP1", "SHORT", qty_percent = rr_partialInp, stop = slPxShort, limit = tp1PxShort, alert_message = "AE-TRIAX-S SHORT TP1/SL hit")
    if rr_maxTPInput >= 2
        rem2 = (100.0 - rr_partialInp) * 0.5
        strategy.exit("TP2", "SHORT", qty_percent = rem2, stop = slPxShort, limit = tp2PxShort, alert_message = "AE-TRIAX-S SHORT TP2/SL hit")
    if rr_maxTPInput >= 3
        strategy.exit("TP3", "SHORT", stop = slPxShort, limit = tp3PxShort, alert_message = "AE-TRIAX-S SHORT TP3/SL hit")
    if not na(lnSL)
        line.delete(lnSL)
    if not na(lnTP1)
        line.delete(lnTP1)
    if not na(lnTP2)
        line.delete(lnTP2)
    if not na(lnTP3)
        line.delete(lnTP3)
    trEntry := close
    trSL := slPxShort
    trTP1 := tp1PxShort
    trTP2 := tp2PxShort
    trTP3 := tp3PxShort
    trDir := -1
    trTP1Hit := false
    lnSL  := line.new(bar_index, slPxShort,  bar_index + 50, slPxShort,  color = color.new(cSellStrong, 20), style = line.style_dashed, width = 2, extend = extend.right)
    lnTP1 := line.new(bar_index, tp1PxShort, bar_index + 50, tp1PxShort, color = color.new(cSellStrong, 50), style = line.style_dotted, width = 1, extend = extend.right)
    lnTP2 := line.new(bar_index, tp2PxShort, bar_index + 50, tp2PxShort, color = color.new(cSellStrong, 30), style = line.style_dashed, width = 1, extend = extend.right)
    lnTP3 := line.new(bar_index, tp3PxShort, bar_index + 50, tp3PxShort, color = color.new(cSellStrong, 10), style = line.style_solid,  width = 2, extend = extend.right)
    slPctShort = math.abs(close - slPxShort) / close * 100.0
    tp1PctShort = math.abs(close - tp1PxShort) / close * 100.0
    label.new(bar_index, high + atr * 1.2, "★ SELL " + str.tostring(math.round(confidencePct)) + "%\nSL " + str.tostring(slPctShort, "#.0") + "%  TP1 " + str.tostring(tp1PctShort, "#.0") + "%  Qty " + str.tostring(qPct, "#.0") + "%",
         yloc = yloc.price, color = cSellStrong, textcolor = #1a0509, style = label.style_label_down, size = size.normal)


// ============================================================================
//  ░░ POSITION MANAGEMENT: BREAKEVEN AFTER TP1 + INTELLIGENT TRAILING ░░
// ============================================================================
if strategy.position_size != 0 and not na(trEntry) and barstate.isconfirmed
    if not trTP1Hit
        tp1Touched = trDir > 0 ? high >= trTP1 : low <= trTP1
        if tp1Touched
            trTP1Hit := true
            label.new(bar_index, trTP1, "✓ TP1 Hit", yloc = yloc.price, color = trDir > 0 ? cBuyStrong : cSellStrong, textcolor = #000000, style = label.style_label_left, size = size.small)
            if rr_beAfter1Inp
                trSL := trEntry
                if not na(lnSL)
                    line.set_y1(lnSL, trEntry)
                    line.set_y2(lnSL, trEntry)
                strategy.exit("TRAIL", trDir > 0 ? "LONG" : "SHORT", stop = trEntry, alert_message = "AE-TRIAX-S: Breakeven SL after TP1")
    if rr_useTrailInp
        momAgree = (trDir > 0 and momDir == 1) or (trDir < 0 and momDir == -1)
        if momAgree
            trailDist = atr * 1.2
            newSL = trDir > 0 ? math.max(trSL, close - trailDist) : math.min(trSL, close + trailDist)
            if newSL != trSL
                trSL := newSL
                if not na(lnSL)
                    line.set_y1(lnSL, newSL)
                    line.set_y2(lnSL, newSL)
                strategy.exit("TRAIL", trDir > 0 ? "LONG" : "SHORT", stop = newSL, alert_message = "AE-TRIAX-S: Trail SL moved to " + str.tostring(newSL, format.mintick))
    if not na(lnSL)
        line.set_x2(lnSL,  bar_index + 50)
    if not na(lnTP1)
        line.set_x2(lnTP1, bar_index + 50)
    if not na(lnTP2)
        line.set_x2(lnTP2, bar_index + 50)
    if not na(lnTP3)
        line.set_x2(lnTP3, bar_index + 50)

if strategy.position_size == 0 and not na(trEntry) and barstate.isconfirmed
    trEntry := na
    trDir := 0


// ============================================================================
//  ░░ EMA CLOUD (3-tier) ░░
// ============================================================================
cloudTop1 = math.max(ema1, ema2)
cloudBot1 = math.min(ema1, ema2)
cloudTop2 = math.max(ema2, ema3)
cloudBot2 = math.min(ema2, ema3)
cloudTop3 = math.max(ema3, ema5)
cloudBot3 = math.min(ema3, ema5)

cloudBull1 = ema1 > ema2
cloudBull2 = ema2 > ema3
cloudBull3 = ema3 > ema5

c1Top = plot(vi_emaCloud ? cloudTop1 : na, "Cloud1 Top", color = color.new(cloudBull1 ? cBuyWeak : cSellWeak, 80), display = display.none)
c1Bot = plot(vi_emaCloud ? cloudBot1 : na, "Cloud1 Bot", color = color.new(cloudBull1 ? cBuyWeak : cSellWeak, 80), display = display.none)
fill(c1Top, c1Bot, color = vi_emaCloud ? color.new(cloudBull1 ? cBuyWeak : cSellWeak, 80) : na, title = "Cloud 1")
c2Top = plot(vi_emaCloud ? cloudTop2 : na, "Cloud2 Top", color = color.new(cloudBull2 ? cBuyStrong : cSellStrong, 85), display = display.none)
c2Bot = plot(vi_emaCloud ? cloudBot2 : na, "Cloud2 Bot", color = color.new(cloudBull2 ? cBuyStrong : cSellStrong, 85), display = display.none)
fill(c2Top, c2Bot, color = vi_emaCloud ? color.new(cloudBull2 ? cBuyStrong : cSellStrong, 85) : na, title = "Cloud 2")
c3Top = plot(vi_emaCloud ? cloudTop3 : na, "Cloud3 Top", color = color.new(cloudBull3 ? cBuyStrong : cSellStrong, 90), display = display.none)
c3Bot = plot(vi_emaCloud ? cloudBot3 : na, "Cloud3 Bot", color = color.new(cloudBull3 ? cBuyStrong : cSellStrong, 90), display = display.none)
fill(c3Top, c3Bot, color = vi_emaCloud ? color.new(cloudBull3 ? cBuyStrong : cSellStrong, 90) : na, title = "Cloud 3")


// ============================================================================
//  ░░ VISUALS — signal arrows + bar coloring ░░
// ============================================================================
plotshape(fireBuy,  title = "Strong BUY",  style = shape.triangleup,   location = location.belowbar, color = cBuyStrong,  size = size.large)
plotshape(fireSell, title = "Strong SELL", style = shape.triangledown, location = location.abovebar, color = cSellStrong, size = size.large)

bcol = vi_barColor ? (finalScore >= activeThr ? cBuyStrong : finalScore >= activeThr * 0.5 ? cBuyWeak : finalScore <= -activeThr ? cSellStrong : finalScore <= -activeThr * 0.5 ? cSellWeak : na) : na
barcolor(bcol, editable = false)


// ============================================================================
//  ░░ DASHBOARD ░░
// ============================================================================
bar10(p) =>
    int filled = math.round(clamp(p / 100.0, 0.0, 1.0) * 10)
    string s = ""
    for i = 1 to 10
        s += i <= filled ? "█" : "░"
    s

axColor(s) =>
    s > 20 ? cBuyStrong : s > 5 ? cBuyWeak : s < -20 ? cSellStrong : s < -5 ? cSellWeak : cNeut
axSym(s) =>
    s > 5 ? "▲" : s < -5 ? "▼" : "·"

var table hud = na
if vi_showDash and na(hud)
    hud := table.new(position.top_right, 2, 16, bgcolor = cPanel,
         border_color = color.new(cAcc, 60), border_width = 1, frame_color = color.new(cAcc, 40), frame_width = 1)

if vi_showDash and barstate.islast
    sz = size.normal
    verdict = fireBuy ? "★ STRONG BUY" : fireSell ? "★ STRONG SELL" : finalScore > activeThr * 0.5 ? "▲ lean buy" : finalScore < -activeThr * 0.5 ? "▼ lean sell" : "· neutral"
    verdictCol = fireBuy ? cBuyStrong : fireSell ? cSellStrong : finalScore > 0 ? cBuyWeak : finalScore < 0 ? cSellWeak : cNeut

    table.cell(hud, 0, 0, "TRIAXIAL STRATEGY", text_color = cAcc, text_size = sz, bgcolor = cPanelHd, text_halign = text.align_left)
    table.cell(hud, 1, 0, presetInput, text_color = cTxtD, text_size = sz, bgcolor = cPanelHd, text_halign = text.align_right)

    table.cell(hud, 0, 1, "regime", text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 1, regimeName, text_color = regimeCol, text_size = sz, text_halign = text.align_right)

    table.cell(hud, 0, 2, "verdict", text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 2, ddHalt ? "✗ DD HALT" : verdict, text_color = ddHalt ? cSellStrong : verdictCol, text_size = sz, text_halign = text.align_right)

    table.cell(hud, 0, 3, "final score", text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 3, str.tostring(finalScore, "#.0"), text_color = verdictCol, text_size = sz, text_halign = text.align_right)

    table.cell(hud, 0, 4, "confidence", text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 4, bar10(confidencePct) + " " + str.tostring(math.round(confidencePct)) + "%", text_color = confidencePct >= 70 ? cBuyStrong : confidencePct >= 40 ? cTxt : cTxtD, text_size = sz, text_halign = text.align_right)

    table.cell(hud, 0, 5, "▔ AXES ▔", text_color = cAcc, text_size = sz, bgcolor = cPanelHd, text_halign = text.align_left)
    table.cell(hud, 1, 5, "", bgcolor = cPanelHd)

    table.cell(hud, 0, 6, "TREND",      text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 6, axSym(trendScore) + " " + str.tostring(trendScore, "#.0") + "  ×" + str.tostring(wT, "#.1"), text_color = axColor(trendScore), text_size = sz, text_halign = text.align_right)
    table.cell(hud, 0, 7, "MOMENTUM",   text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 7, axSym(momScore) + " " + str.tostring(momScore, "#.0") + "  ×" + str.tostring(wM, "#.1"), text_color = axColor(momScore), text_size = sz, text_halign = text.align_right)
    table.cell(hud, 0, 8, "VOLATILITY", text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 8, axSym(volaScore) + " " + str.tostring(volaScore, "#.0") + "  ×" + str.tostring(wV, "#.1"), text_color = axColor(volaScore), text_size = sz, text_halign = text.align_right)

    table.cell(hud, 0, 9, "MTF " + mtf_tf1Input + "/" + mtf_tf2Input, text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 9, mtf_enableInput ? axSym(mtfV1 * 30) + " / " + axSym(mtfV2 * 30) : "off", text_color = cTxt, text_size = sz, text_halign = text.align_right)

    table.cell(hud, 0, 10, "Q-threshold", text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 10, ql_enableInput ? str.tostring(activeThr, "#") + " (slot " + str.tostring(thrIdx + 1) + "/4)" : "fixed", text_color = cAcc, text_size = sz, text_halign = text.align_right)

    table.cell(hud, 0, 11, "▔ STRATEGY ▔", text_color = cAcc, text_size = sz, bgcolor = cPanelHd, text_halign = text.align_left)
    table.cell(hud, 1, 11, "", bgcolor = cPanelHd)

    table.cell(hud, 0, 12, "drawdown", text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 12, str.tostring(ddPct, "#.1") + "%", text_color = ddPct >= dp_maxDDPct * 0.7 ? cSellStrong : ddPct >= dp_maxDDPct * 0.4 ? cAcc : cTxt, text_size = sz, text_halign = text.align_right)

    posTxt = strategy.position_size > 0 ? "▲ LONG" : strategy.position_size < 0 ? "▼ SHORT" : "—"
    posCol = strategy.position_size > 0 ? cBuyStrong : strategy.position_size < 0 ? cSellStrong : cTxtD
    table.cell(hud, 0, 13, "position", text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    table.cell(hud, 1, 13, posTxt + (strategy.position_size != 0 ? "  (" + (trTP1Hit ? "TP1✓" : "open") + ")" : ""), text_color = posCol, text_size = sz, text_halign = text.align_right)

    table.cell(hud, 0, 14, "axis lean", text_color = cTxtD, text_size = sz, text_halign = text.align_left)
    leanTxt = "↑" + str.tostring(leanUp) + " / ↓" + str.tostring(leanDn) + (toleranceOK ? "  ✓" : "  ✗")
    table.cell(hud, 1, 14, leanTxt, text_color = toleranceOK ? cBuyStrong : cTxtD, text_size = sz, text_halign = text.align_right)

    // Diagnostic: shows WHY a signal does or doesn't fire.
    diag = ""
    diagCol = cTxtD
    if fireBuy
        diag := "★ BUY firing"
        diagCol := cBuyStrong
    else if fireSell
        diag := "★ SELL firing"
        diagCol := cSellStrong
    else if ddHalt
        diag := "DD halt active"
        diagCol := cSellStrong
    else if not toleranceOK
        diag := "axes disagree"
        diagCol := cTxtD
    else if agreedUp and not trendLeanUp
        diag := "trend not up"
        diagCol := cTxtD
    else if agreedDn and not trendLeanDn
        diag := "trend not down"
        diagCol := cTxtD
    else if agreedUp and finalScore < activeThr
        need = activeThr - finalScore
        diag := "+" + str.tostring(need, "#.0") + " score to BUY"
        diagCol := cBuyWeak
    else if agreedDn and finalScore > -activeThr
        need = finalScore - (-activeThr)
        diag := "-" + str.tostring(need, "#.0") + " score to SELL"
        diagCol := cSellWeak
    else if lastSig == 1 and not strongBuy
        diag := "BUY held (locked)"
        diagCol := cAcc
    else if lastSig == -1 and not strongSell
        diag := "SELL held (locked)"
        diagCol := cAcc
    else
        diag := "—"
    table.cell(hud, 0, 15, "▔ DIAGNOSTIC ▔", text_color = cAcc, text_size = sz, bgcolor = cPanelHd, text_halign = text.align_left)
    table.cell(hud, 1, 15, diag, text_color = diagCol, text_size = sz, bgcolor = cPanelHd, text_halign = text.align_right)


// ============================================================================
//  ░░ ALERTS ░░
// ============================================================================
alertcondition(fireBuy,  "Strong BUY",  "AE-TRIAX-S Strong BUY signal")
alertcondition(fireSell, "Strong SELL", "AE-TRIAX-S Strong SELL signal")
alertcondition(ddHalt and not ddHalt[1], "Drawdown Halt", "AE-TRIAX-S: trading halted due to drawdown")
