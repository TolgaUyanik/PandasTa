//@version=6
indicator("4H Open Lines — individual by MSJ", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ── Global settings ──────────────────────
tf       = input.timeframe("240", "Candle timeframe")
lineSize = input.int(1, "Size (width)", minval = 1, maxval = 10)
styleTxt = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"])
lookback = input.int(6, "Lines back", minval = 1, maxval = 250)
showLbl  = input.bool(true, "Show name labels")
lblSize  = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal"])
tz       = input.string("America/New_York", "Slot reference timezone (fixed, ignores chart TZ)",
     options = ["America/New_York", "America/Chicago", "UTC", "Europe/Oslo"])
ampm     = input.bool(true, "Show auto-names as 12h AM/PM (e.g. 10:00 AM)")

lineStyle = styleTxt == "Dashed" ? line.style_dashed : styleTxt == "Dotted" ? line.style_dotted : line.style_solid
labelSize = lblSize == "Tiny" ? size.tiny : lblSize == "Small" ? size.small : size.normal

// ── Individual 4H slots (open hour ÷ 4, in NY time) ──
grp = "Individual 4H candles (times shown = NY time)"
use1 = input.bool(true, "00:00 NY", inline = "s1", group = grp)
col1 = input.color(color.gray,   "", inline = "s1", group = grp)
nm1  = input.string("", "Name", inline = "s1", group = grp)
use2 = input.bool(true, "04:00 NY", inline = "s2", group = grp)
col2 = input.color(color.teal,   "", inline = "s2", group = grp)
nm2  = input.string("", "Name", inline = "s2", group = grp)
use3 = input.bool(true, "08:00 NY", inline = "s3", group = grp)
col3 = input.color(color.orange, "", inline = "s3", group = grp)
nm3  = input.string("", "Name", inline = "s3", group = grp)
use4 = input.bool(true, "12:00 NY", inline = "s4", group = grp)
col4 = input.color(color.blue,   "", inline = "s4", group = grp)
nm4  = input.string("", "Name", inline = "s4", group = grp)
use5 = input.bool(true, "16:00 NY", inline = "s5", group = grp)
col5 = input.color(color.purple, "", inline = "s5", group = grp)
nm5  = input.string("", "Name", inline = "s5", group = grp)
use6 = input.bool(true, "20:00 NY", inline = "s6", group = grp)
col6 = input.color(color.red,    "", inline = "s6", group = grp)
nm6  = input.string("", "Name", inline = "s6", group = grp)

slotUse(int s) => s == 0 ? use1 : s == 1 ? use2 : s == 2 ? use3 : s == 3 ? use4 : s == 4 ? use5 : use6
slotCol(int s) => s == 0 ? col1 : s == 1 ? col2 : s == 2 ? col3 : s == 3 ? col4 : s == 4 ? col5 : col6
slotNm(int s)  => s == 0 ? nm1  : s == 1 ? nm2  : s == 2 ? nm3  : s == 3 ? nm4  : s == 4 ? nm5  : nm6

// ── Logic ────────────────────────────────
var array<line>  lines  = array.new<line>()
var array<label> labels = array.new<label>()
var bool active = false
okTF = timeframe.in_seconds() <= timeframe.in_seconds(tf)

if okTF and timeframe.change(tf)
    h    = hour(time, tz)
    slot = math.floor(h / 4)
    active := false
    if slotUse(slot)
        c = slotCol(slot)
        autoTxt = ampm ? str.format_time(time, "hh:mm a", tz) : str.format_time(time, "HH:mm", tz)
        txt = not showLbl ? "" : slotNm(slot) == "" ? autoTxt : slotNm(slot)
        array.push(lines,  line.new(bar_index, open, bar_index, open, xloc = xloc.bar_index, color = c, width = lineSize, style = lineStyle))
        array.push(labels, label.new(bar_index, open, txt, xloc = xloc.bar_index, style = label.style_none, textcolor = c, size = labelSize))
        active := true
        if array.size(lines) > lookback
            line.delete(array.shift(lines))
            label.delete(array.shift(labels))

if active and array.size(lines) > 0
    line.set_x2(array.get(lines, array.size(lines) - 1), bar_index)
    label.set_x(array.get(labels, array.size(labels) - 1), bar_index)