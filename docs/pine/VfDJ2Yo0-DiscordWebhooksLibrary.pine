//@version=5

// @description Pine Script library for creating Discord webhook messages with custom content, embeds, and formatting options, simplifying integration of trading alerts with Discord channels.
library("DiscordWebhooksLibrary")


export formatTimeframe() =>
    result = ""
    if timeframe.isseconds
        result := timeframe.period + "s"
    if timeframe.isminutes
        floatTimeframe = str.tonumber(timeframe.period)
        if floatTimeframe % 60 == 0
            result := str.tostring(floatTimeframe / 60) + "H"
        else
            result := timeframe.period + "m"
    if timeframe.isdaily
        if timeframe.period == "D"
            result := "1D"
        else
            result := timeframe.period
    if timeframe.isweekly
        if timeframe.period == "W"
            result := "1W"
        else    
            result := timeframe.period
    if timeframe.ismonthly
        if timeframe.period == "M"
            result := "1M"
        else    
            result := timeframe.period
    result


// @function Constructs a JSON string for a Discord webhook message. This string includes optional fields for content, username, avatar URL, and embeds.
// @param contentText (string, optional): The main text content of the webhook message. Default is 'na'.
// @param username (string, optional): Overrides the default username of the webhook. Default is 'na'.
// @param avatar_url (string, optional): Overrides the default avatar URL of the webhook. Default is 'na'.
// @param embeds (string, optional): A string containing one or more embed JSON objects. This should be formatted correctly as a JSON array. Default is 'na'.
export discordWebhookJSON(string contentText = na, string username = na, string avatar_url = na, string embeds = na) =>
    // Initialize JSON string
    string json = "{\n"

    // Add username if provided
    if not na(username)
        json := json + "  \"username\": \"" + username + "\",\n"

    // Add avatar URL if provided
    if not na(avatar_url)
        json := json + "  \"avatar_url\": \"" + avatar_url + "\",\n"

    // Add content text if provided
    if not na(contentText)
        json := json + "  \"content\": \"" + contentText + "\",\n"

    // Add embeds if provided
    if not na(embeds)
        json := json + "  \"embeds\": [" + embeds + "]\n"
    else
        json := str.substring(json, 0, str.length(json) - 2) + "\n"

    // Close JSON string
    json := json + "}"

    // Return the JSON string
    json


// @function Creates a JSON string for a single embed object for a Discord webhook.
// @param title (string, optional): The title of the embed. Default is 'na' (not applicable).
// @param description (string, optional): The description text of the embed. Supports basic formatting. Default is 'na'.
// @param color (int, optional): The color code of the embed, typically in decimal format. Default is 'na'.
// @param authorName (string, optional): The name of the author to display in the embed. Default is 'na'.
// @param authorUrl (string, optional): The URL linked to the author's name. Default is 'na'.
// @param authorIconUrl (string, optional): The URL of the icon to display next to the author's name. Default is 'na'.
// @param fields (string, optional): A string containing one or more field JSON objects. This should be formatted correctly as a JSON array. Default is 'na'. Note: Use the 'createEmbedFieldJSON' function to generate these JSON field strings before adding them to the array.
// @param footerText (string, optional): The footer text to display in the embed.
// @param footerIconUrl (string, optional): The URL of the icon to display next to the footer text.
export createEmbedJSON(string title = na, string description = na, int color = na, string authorName = na, string authorUrl = na, string authorIconUrl = na, string fields = na, string footerText = na, string footerIconUrl = na) =>
    string embedJson = "{\n"

    // Add title if provided
    if not na(title)
        embedJson := embedJson + "  \"title\": \"" + title + "\",\n"

    // Add description if provided
    if not na(description)
        embedJson := embedJson + "  \"description\": \"" + description + "\",\n"

    // Add color if provided
    if not na(color)
        embedJson := embedJson + "  \"color\": " + str.tostring(color) + ",\n"

    // Add author details if provided
    if not na(authorName) or not na(authorUrl) or not na(authorIconUrl)
        embedJson := embedJson + "  \"author\": {\n"
        if not na(authorName)
            embedJson := embedJson + "    \"name\": \"" + authorName + "\",\n"
        if not na(authorUrl)
            embedJson := embedJson + "    \"url\": \"" + authorUrl + "\",\n"
        if not na(authorIconUrl)
            embedJson := embedJson + "    \"icon_url\": \"" + authorIconUrl + "\"\n"
        embedJson := embedJson + "  },\n"

    // Add fields if provided
    if not na(fields)
        embedJson := embedJson + "  \"fields\": [" + fields + "],\n"

    // Add footer if provided
    if not na(footerText) or not na(footerIconUrl)
        embedJson := embedJson + "  \"footer\": {\n"
        if not na(footerText)
            embedJson := embedJson + "    \"text\": \"" + footerText + "\""
            embedJson := embedJson + (not na(footerIconUrl) ? ",\n" : "\n")
        if not na(footerIconUrl)
            embedJson := embedJson + "    \"icon_url\": \"" + footerIconUrl + "\"\n"
        embedJson := embedJson + "  }"

    // Remove last comma and close JSON string
    if str.substring(embedJson, str.length(embedJson) - 2, str.length(embedJson)) == ",\n"
        embedJson := str.substring(embedJson, 0, str.length(embedJson) - 2)
    embedJson := embedJson + "}"

    // Return the embed JSON string
    embedJson


// @function Creates a JSON string representing a single field object within an embed for a Discord webhook message.
// @param name (string): The name of the field, acting as a title for the field content.
// @param value (string): The value of the field, containing the actual text or information you want to display within the field.
// @param inline (bool, optional): A boolean flag indicating whether the field should be displayed inline with other fields. If set to true, the field will be displayed on the same line as the next field
export createEmbedFieldJSON(string name, string value, bool inline = false) =>
    string fieldJson = "{\n"
    fieldJson += "  \"name\": \"" + name + "\",\n"
    fieldJson += "  \"value\": \"" + value + "\""
    fieldJson += inline ? ", \"inline\": true" : ""
    fieldJson += "\n}"
    fieldJson