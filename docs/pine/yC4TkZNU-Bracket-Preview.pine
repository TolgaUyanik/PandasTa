//@version=6
indicator(
     title      = "Bracket Preview", 
     shorttitle = "Bracket Prev.",
     overlay    = true
     )

//#region :::::::::: User Inputs ::::::::::
// Trade Direction Selection
string tradeDirectionSelection = input.string(
     defval  = "Long", 
     title   = "Trade Direction", 
     options = ["Long", "Short", "Both"]
     )

// Long Position
int longTradeTargetTicks = input.int(
     defval = 100,
     minval = 1, 
     title  = "Long Trade Target Distance (In Ticks)",
     group  = "Long Trade",
     active = tradeDirectionSelection == "Long" or tradeDirectionSelection == "Both" 
     )

int longTradeStopLossTicks = input.int(
     defval = 100, 
     minval = 1,
     title  = "Long Trade Stop Loss Distance (In Ticks)",
     group  = "Long Trade",
     active = tradeDirectionSelection == "Long" or tradeDirectionSelection == "Both" 
     )

// Short Position
int shortTradeStopLossTicks = input.int(
     defval = 100, 
     minval = 1,
     title  = "Short Trade Stop Loss Distance (In Ticks)", 
     group  = "Short Trade",
     active = tradeDirectionSelection == "Short" or tradeDirectionSelection == "Both" 
     )

int shortTradeTargetTicks = input.int(
     defval = 100, 
     minval = 1,
     title  = "Short Trade Target Distance (In Ticks)", 
     group  = "Short Trade",
     active = tradeDirectionSelection == "Short" or tradeDirectionSelection == "Both" 
     )
//#endregion

//#region :::::::::: Script Logic ::::::::::
// Pull true live price in case a non-standard chart is being used with a calculated close price.
float trueClose  = request.security(
      symbol     = ticker.standard(syminfo.tickerid), 
      timeframe  = timeframe.period, 
      expression = close
      )

float longTradeTargetPrice    = trueClose + (syminfo.mintick * longTradeTargetTicks)
float longTradeStopLossPrice  = trueClose - (syminfo.mintick * longTradeStopLossTicks)

float shortTradeStopLossPrice = trueClose + (syminfo.mintick * shortTradeStopLossTicks)
float shortTradeTargetPrice   = trueClose - (syminfo.mintick * shortTradeTargetTicks)
//#endregion

//#region :::::::::: Chart Plots ::::::::::
// Long Trade Lines
plot(
     series     = barstate.islast and 
                  (tradeDirectionSelection == "Long" or tradeDirectionSelection == "Both") ? 
                  longTradeTargetPrice : na, 
     title      = "Long Trade Target Line" , 
     color      = color.green, 
     linewidth  = 2, 
     trackprice = true, 
     offset     = -1000
     )

plot(
     series     = barstate.islast and 
                  (tradeDirectionSelection == "Long" or tradeDirectionSelection == "Both") ? 
                  longTradeStopLossPrice : na, 
     title      = "Long Trade Stop Loss Line", 
     color      = color.red, 
     linewidth  = 2, 
     trackprice = true, 
     offset     = -1000
     )

// Short Trade Lines
plot(
     series     = barstate.islast and 
                  (tradeDirectionSelection == "Short" or tradeDirectionSelection == "Both") ? 
                  shortTradeStopLossPrice : na, 
     title      = "Short Trade Stop Loss Line", 
     color      = color.red, 
     trackprice = true, 
     offset     = -1000
     )

plot(
     series     = barstate.islast and 
                  (tradeDirectionSelection == "Short" or tradeDirectionSelection == "Both") ? 
                  shortTradeTargetPrice : na, 
     title      = "Short Trade Target Line", 
     color      = color.green, 
     trackprice = true, 
     offset     = -1000
     )
//#endregion
