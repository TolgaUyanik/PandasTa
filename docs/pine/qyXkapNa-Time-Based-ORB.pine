//@version=6
// © klazalier
// Time Based ORB — Multi-anchor opening ranges (boxes + extended H/L/mid lines)
// with session VWAP and prior-day key levels (MNO / PDH / PDL / PDMid).
indicator("Time Based ORB", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════
// SECTION 1 — SHARED HELPERS
// ═══════════════════════════════════════════════════════════════
TZ = "America/New_York"

f_line_style(s) =>
    s == "dashed" ? line.style_dashed : s == "dotted" ? line.style_dotted : line.style_solid

f_icon_size(s) =>
    s == "tiny" ? size.tiny : s == "small" ? size.small : s == "large" ? size.large : s == "huge" ? size.huge : size.normal

f_text_size(s) =>
    s == "tiny" ? size.tiny : s == "small" ? size.small : s == "large" ? size.large : s == "huge" ? size.huge : size.normal

// Formats an hour/minute pair as "H:MM" for the box labels
f_time_txt(h, m) =>
    str.tostring(h) + ":" + (m < 10 ? "0" + str.tostring(m) : str.tostring(m))

et_hm() => hour(time, TZ) * 100 + minute(time, TZ)

// ═══════════════════════════════════════════════════════════════
// SECTION 2 — PRESET SELECTOR
// ═══════════════════════════════════════════════════════════════
grpP   = "⚙️ Preset"
preset = input.string("Author Defaults", "Settings Mode",
     options=["Author Defaults","User Settings"], group=grpP,
     tooltip="Author Defaults loads the recommended configuration (7:30, 8:50 and 9:30 ET ranges). Switch to User Settings to customize everything.")
use_defaults = preset == "Author Defaults"

// ═══════════════════════════════════════════════════════════════
// SECTION 3 — ORB INPUTS
// ═══════════════════════════════════════════════════════════════

// ── ORB 1 ──────────────────────────────────────────────────────
grp1           = "ORB 1 — Anchoring Range (8:50)"
o1_hour        = input.int(8,     "Hour (ET)",              minval=0, maxval=23, group=grp1)
o1_min         = input.int(50,    "Minute",                  minval=0, maxval=59, group=grp1)
o1_show        = input.bool(true, "Show ORB 1",             group=grp1)
o1_extend_1600 = input.bool(true, "Extend lines to 16:00",  group=grp1, tooltip="Extends the H/L lines to 16:00 ET each day.")
o1_extend_bars = input.int(0,     "Extend box (bars)",      minval=0, group=grp1)

grp1s          = "ORB 1 — Style"
o1_box_col     = input.color(color.new(color.purple, 75), "Box Color",          group=grp1s)
o1_box_brd_col = input.color(color.new(color.purple, 0),  "Box Border Color",   group=grp1s)
o1_box_brd_w   = input.int(2,                              "Box Border Width",   group=grp1s, minval=0)
o1_box_brd_sty = input.string("solid",                     "Box Border Style",   group=grp1s, options=["solid","dashed","dotted"])
o1_ext_col     = input.color(color.new(color.purple, 0),  "External H/L Color", group=grp1s)
o1_ext_width   = input.int(2,                              "External H/L Width", group=grp1s, minval=1)
o1_ext_style   = input.string("solid",                     "External H/L Style", group=grp1s, options=["solid","dashed","dotted"])
o1_show_mid    = input.bool(true,                          "Show Midpoint",      group=grp1s)
o1_mid_col     = input.color(color.new(color.purple, 0),  "Midpoint Color",     group=grp1s)
o1_mid_width   = input.int(1,                              "Midpoint Width",     group=grp1s, minval=1)
o1_mid_style   = input.string("dotted",                    "Midpoint Style",     group=grp1s, options=["solid","dashed","dotted"])
o1_use_dow     = input.bool(false,                         "Color by Day of Week", group=grp1s)
o1_dow_mon     = input.color(color.new(color.blue,   70), "Mon", group=grp1s, inline="dow1")
o1_dow_tue     = input.color(color.new(color.green,  70), "Tue", group=grp1s, inline="dow1")
o1_dow_wed     = input.color(color.new(color.orange, 70), "Wed", group=grp1s, inline="dow1")
o1_dow_thu     = input.color(color.new(color.purple, 70), "Thu", group=grp1s, inline="dow1")
o1_dow_fri     = input.color(color.new(color.red,    70), "Fri", group=grp1s, inline="dow1")
o1_bg_transp   = input.int(75,                             "Background Transparency", group=grp1s, minval=0, maxval=100)

// ── ORB 2 ──────────────────────────────────────────────────────
grp2           = "ORB 2 — Opening Range (9:30)"
o2_hour        = input.int(9,     "Hour (ET)",              minval=0, maxval=23, group=grp2)
o2_min         = input.int(30,    "Minute",                  minval=0, maxval=59, group=grp2)
o2_show        = input.bool(true, "Show ORB 2",             group=grp2)
o2_extend_1600 = input.bool(true, "Extend lines to 16:00",  group=grp2)
o2_extend_bars = input.int(0,     "Extend box (bars)",      minval=0, group=grp2)

grp2s          = "ORB 2 — Style"
o2_box_col     = input.color(color.new(#1F51FF,     75), "Box Color",          group=grp2s)
o2_box_brd_col = input.color(color.new(#1F51FF,      0), "Box Border Color",   group=grp2s)
o2_box_brd_w   = input.int(2,                              "Box Border Width",   group=grp2s, minval=0)
o2_box_brd_sty = input.string("solid",                     "Box Border Style",   group=grp2s, options=["solid","dashed","dotted"])
o2_ext_col     = input.color(color.new(#1F51FF,      0), "External H/L Color", group=grp2s)
o2_ext_width   = input.int(1,                              "External H/L Width", group=grp2s, minval=1)
o2_ext_style   = input.string("solid",                     "External H/L Style", group=grp2s, options=["solid","dashed","dotted"])
o2_show_mid    = input.bool(true,                          "Show Midpoint",      group=grp2s)
o2_mid_col     = input.color(color.new(#1F51FF,      0), "Midpoint Color",     group=grp2s)
o2_mid_width   = input.int(2,                              "Midpoint Width",     group=grp2s, minval=1)
o2_mid_style   = input.string("dashed",                    "Midpoint Style",     group=grp2s, options=["solid","dashed","dotted"])
o2_use_dow     = input.bool(false,                         "Color by Day of Week", group=grp2s)
o2_dow_mon     = input.color(color.new(color.blue,   70), "Mon", group=grp2s, inline="dow2")
o2_dow_tue     = input.color(color.new(color.green,  70), "Tue", group=grp2s, inline="dow2")
o2_dow_wed     = input.color(color.new(color.orange, 70), "Wed", group=grp2s, inline="dow2")
o2_dow_thu     = input.color(color.new(color.purple, 70), "Thu", group=grp2s, inline="dow2")
o2_dow_fri     = input.color(color.new(color.red,    70), "Fri", group=grp2s, inline="dow2")
o2_bg_transp   = input.int(75,                             "Background Transparency", group=grp2s, minval=0, maxval=100)

// ── ORB 3 ──────────────────────────────────────────────────────
grp3           = "ORB 3 — Custom Range"
o3_hour        = input.int(7,     "Hour (ET)",              minval=0, maxval=23, group=grp3)
o3_min         = input.int(30,    "Minute",                  minval=0, maxval=59, group=grp3)
o3_show        = input.bool(true, "Show ORB 3",             group=grp3)
o3_extend_1600 = input.bool(true, "Extend lines to 16:00",  group=grp3)
o3_extend_bars = input.int(0,     "Extend box (bars)",      minval=0, group=grp3)

grp3s          = "ORB 3 — Style"
o3_box_col     = input.color(color.new(color.orange, 75), "Box Color",          group=grp3s)
o3_box_brd_col = input.color(color.new(color.orange,  0), "Box Border Color",   group=grp3s)
o3_box_brd_w   = input.int(2,                              "Box Border Width",   group=grp3s, minval=0)
o3_box_brd_sty = input.string("solid",                     "Box Border Style",   group=grp3s, options=["solid","dashed","dotted"])
o3_ext_col     = input.color(color.new(color.gray,    0), "External H/L Color", group=grp3s)
o3_ext_width   = input.int(1,                              "External H/L Width", group=grp3s, minval=1)
o3_ext_style   = input.string("solid",                     "External H/L Style", group=grp3s, options=["solid","dashed","dotted"])
o3_show_mid    = input.bool(true,                          "Show Midpoint",      group=grp3s)
o3_mid_col     = input.color(color.new(color.orange,  0), "Midpoint Color",     group=grp3s)
o3_mid_width   = input.int(2,                              "Midpoint Width",     group=grp3s, minval=1)
o3_mid_style   = input.string("dotted",                    "Midpoint Style",     group=grp3s, options=["solid","dashed","dotted"])
o3_use_dow     = input.bool(false,                         "Color by Day of Week", group=grp3s)
o3_dow_mon     = input.color(color.new(color.blue,   70), "Mon", group=grp3s, inline="dow3")
o3_dow_tue     = input.color(color.new(color.green,  70), "Tue", group=grp3s, inline="dow3")
o3_dow_wed     = input.color(color.new(color.orange, 70), "Wed", group=grp3s, inline="dow3")
o3_dow_thu     = input.color(color.new(color.purple, 70), "Thu", group=grp3s, inline="dow3")
o3_dow_fri     = input.color(color.new(color.red,    70), "Fri", group=grp3s, inline="dow3")
o3_bg_transp   = input.int(75,                             "Background Transparency", group=grp3s, minval=0, maxval=100)

// ── Box Time Labels ─────────────────────────────────────────────
grpT           = "Box Time Labels"
show_box_text  = input.bool(true,     "Show Time Text on Boxes", group=grpT,
     tooltip="Displays the range start time (e.g. 8:50) inside each ORB box.")
show_side_text = input.bool(true,     "Show Time Labels on H/L Lines", group=grpT,
     tooltip="Places the timestamp (7:30, 8:50, 9:30) directly on each box's extended high and low lines, riding the right end as they extend toward 16:00.")
box_text_size  = input.string("small", "Text Size", group=grpT, options=["tiny","small","normal","large","huge"])

// ── Breakout Confirmation Icons ─────────────────────────────────
grpC          = "Breakout Confirmation Icons"
show_icons    = input.bool(true,   "Show Confirmation Icons",   group=grpC)
icon_size     = input.string("large", "Icon Size",              group=grpC, options=["tiny","small","normal","large","huge"])
bull_icon     = input.string("🚀",  "Bullish Breakout Icon",    group=grpC)
bear_icon     = input.string("▼",   "Bearish Breakout Icon",    group=grpC)
bull_icon_col = input.color(color.green, "Bullish Icon Color",  group=grpC)
bear_icon_col = input.color(color.red,   "Bearish Icon Color",  group=grpC)

// ═══════════════════════════════════════════════════════════════
// SECTION 4 — DEFAULT PRESET OVERRIDES
// ═══════════════════════════════════════════════════════════════
_o1_hour = use_defaults ? 8  : o1_hour
_o1_min  = use_defaults ? 50 : o1_min
_o2_hour = use_defaults ? 9  : o2_hour
_o2_min  = use_defaults ? 30 : o2_min
_o3_hour = use_defaults ? 7  : o3_hour
_o3_min  = use_defaults ? 30 : o3_min

_o1_box_col     = use_defaults ? color.new(color.purple, 75)  : o1_box_col
_o1_box_brd_col = use_defaults ? color.new(color.purple, 0)   : o1_box_brd_col
_o1_ext_col     = use_defaults ? color.new(color.purple, 0)   : o1_ext_col
_o1_mid_col     = use_defaults ? color.new(color.purple, 0)   : o1_mid_col
_o1_ext_width   = use_defaults ? 2 : o1_ext_width
_o1_mid_width   = use_defaults ? 1 : o1_mid_width
_o1_mid_style   = use_defaults ? "dotted" : o1_mid_style

_o2_box_col     = use_defaults ? color.new(#1F51FF, 75)       : o2_box_col
_o2_box_brd_col = use_defaults ? color.new(#1F51FF, 0)        : o2_box_brd_col
_o2_ext_col     = use_defaults ? color.new(#1F51FF, 0)        : o2_ext_col
_o2_mid_col     = use_defaults ? color.new(#1F51FF, 0)        : o2_mid_col
_o2_ext_width   = use_defaults ? 1 : o2_ext_width
_o2_mid_width   = use_defaults ? 2 : o2_mid_width
_o2_mid_style   = use_defaults ? "dashed" : o2_mid_style

_o3_box_col     = use_defaults ? color.new(color.orange, 75)  : o3_box_col
_o3_box_brd_col = use_defaults ? color.new(color.orange, 0)   : o3_box_brd_col
_o3_ext_col     = use_defaults ? color.new(color.gray, 0)     : o3_ext_col
_o3_mid_col     = use_defaults ? color.new(color.orange, 0)   : o3_mid_col
_o3_ext_width   = use_defaults ? 1 : o3_ext_width
_o3_mid_width   = use_defaults ? 2 : o3_mid_width
_o3_mid_style   = use_defaults ? "dotted" : o3_mid_style

_o1_extend_bars = use_defaults ? 1 : o1_extend_bars
_o2_extend_bars = use_defaults ? 1 : o2_extend_bars
_o3_extend_bars = use_defaults ? 1 : o3_extend_bars

// Box label text — e.g. "8:50", "9:30", "7:30"
_o1_txt = f_time_txt(_o1_hour, _o1_min)
_o2_txt = f_time_txt(_o2_hour, _o2_min)
_o3_txt = f_time_txt(_o3_hour, _o3_min)

// ═══════════════════════════════════════════════════════════════
// SECTION 5 — SESSION TIME MATH
// ═══════════════════════════════════════════════════════════════
cur_hm      = et_hm()
is_new_day  = ta.change(dayofweek(time, TZ)) != 0
in_trading  = cur_hm < 1600

o1_bar_match = hour(time, TZ) == _o1_hour and minute(time, TZ) == _o1_min
o2_bar_match = hour(time, TZ) == _o2_hour and minute(time, TZ) == _o2_min
o3_bar_match = hour(time, TZ) == _o3_hour and minute(time, TZ) == _o3_min

// ═══════════════════════════════════════════════════════════════
// SECTION 6 — DOW COLOR HELPER
// ═══════════════════════════════════════════════════════════════
f_dow_col(use_dow, c_mon, c_tue, c_wed, c_thu, c_fri, fallback, transp) =>
    base = not use_dow ? fallback :
         dayofweek(time, TZ) == dayofweek.monday    ? c_mon :
         dayofweek(time, TZ) == dayofweek.tuesday   ? c_tue :
         dayofweek(time, TZ) == dayofweek.wednesday ? c_wed :
         dayofweek(time, TZ) == dayofweek.thursday  ? c_thu : c_fri
    color.new(base, transp)

// ═══════════════════════════════════════════════════════════════
// SECTION 7 — ORB STATE VARIABLES
// ═══════════════════════════════════════════════════════════════
var float o1_hi = na
var float o1_lo = na
var int   o1_bar_start = na
var bool  o1_done = false
var line  o1_ext_hi = na
var line  o1_ext_lo = na
var line  o1_mid_line = na
var box   o1_box = na
var label o1_lbl_hi = na
var label o1_lbl_lo = na
var bool  o1_bull_conf = false
var bool  o1_bear_conf = false

var float o2_hi = na
var float o2_lo = na
var int   o2_bar_start = na
var bool  o2_done = false
var line  o2_ext_hi = na
var line  o2_ext_lo = na
var line  o2_mid_line = na
var box   o2_box = na
var label o2_lbl_hi = na
var label o2_lbl_lo = na
var bool  o2_bull_conf = false
var bool  o2_bear_conf = false

var float o3_hi = na
var float o3_lo = na
var int   o3_bar_start = na
var bool  o3_done = false
var line  o3_ext_hi = na
var line  o3_ext_lo = na
var line  o3_mid_line = na
var box   o3_box = na
var label o3_lbl_hi = na
var label o3_lbl_lo = na
var bool  o3_bull_conf = false
var bool  o3_bear_conf = false

// ═══════════════════════════════════════════════════════════════
// SECTION 8 — RESET ON NEW DAY
// ═══════════════════════════════════════════════════════════════
if is_new_day
    o1_hi := na
    o1_lo := na
    o1_done := false
    o1_bull_conf := false
    o1_bear_conf := false
    o2_hi := na
    o2_lo := na
    o2_done := false
    o2_bull_conf := false
    o2_bear_conf := false
    o3_hi := na
    o3_lo := na
    o3_done := false
    o3_bull_conf := false
    o3_bear_conf := false

// ═══════════════════════════════════════════════════════════════
// SECTION 9 — ORB COLLECTION
// ═══════════════════════════════════════════════════════════════
if o1_show and not o1_done and o1_bar_match
    o1_hi := high
    o1_lo := low
    o1_bar_start := bar_index
if o2_show and not o2_done and o2_bar_match
    o2_hi := high
    o2_lo := low
    o2_bar_start := bar_index
if o3_show and not o3_done and o3_bar_match
    o3_hi := high
    o3_lo := low
    o3_bar_start := bar_index

// ═══════════════════════════════════════════════════════════════
// SECTION 10 — ORB DRAW FUNCTION
// ═══════════════════════════════════════════════════════════════
f_orb_draw(hi, lo, bar_start, ext_bars, box_col, brd_col, brd_w, brd_sty, ext_col, ext_w, ext_sty, show_mid, mid_col, mid_w, mid_sty, box_txt, txt_col) =>
    mid  = (hi + lo) / 2
    _box = box.new(bar_start, hi, bar_start + 1 + ext_bars, lo,
         xloc=xloc.bar_index, bgcolor=box_col,
         border_color=brd_col, border_width=brd_w,
         border_style=f_line_style(brd_sty))
    // Time text drawn as a pinned flag at the box (labels render more
    // reliably than box text). Sits on top of the box's left edge.
    if show_box_text
        label.new(bar_start, hi, box_txt,
             xloc=xloc.bar_index, color=txt_col, textcolor=color.white,
             style=label.style_label_down, size=f_text_size(box_text_size))
    _ehi = line.new(bar_start, hi, bar_index, hi,
         xloc=xloc.bar_index, color=ext_col, width=ext_w,
         style=f_line_style(ext_sty), extend=extend.none)
    _elo = line.new(bar_start, lo, bar_index, lo,
         xloc=xloc.bar_index, color=ext_col, width=ext_w,
         style=f_line_style(ext_sty), extend=extend.none)
    _mid = line(na)
    if show_mid
        _mid := line.new(bar_start, mid, bar_index, mid,
             xloc=xloc.bar_index, color=mid_col, width=mid_w,
             style=f_line_style(mid_sty), extend=extend.none)
    [_box, _ehi, _elo, _mid]

// Creates the flag-style timestamp labels that ride the extended H/L lines.
// One flag on the high line, one on the low line, both moving with the
// right end of the lines (updated each bar in Section 12).
f_line_labels(hi, lo, txt, col) =>
    _h = label.new(bar_index, hi, txt,
         xloc=xloc.bar_index, color=col, textcolor=color.white,
         style=label.style_label_left, size=f_text_size(box_text_size))
    _l = label.new(bar_index, lo, txt,
         xloc=xloc.bar_index, color=col, textcolor=color.white,
         style=label.style_label_left, size=f_text_size(box_text_size))
    [_h, _l]

// ═══════════════════════════════════════════════════════════════
// SECTION 11 — ORB DRAW TRIGGERS
// ═══════════════════════════════════════════════════════════════
o1_just_ended = hour(time[1], TZ) == _o1_hour and minute(time[1], TZ) == _o1_min
o2_just_ended = hour(time[1], TZ) == _o2_hour and minute(time[1], TZ) == _o2_min
o3_just_ended = hour(time[1], TZ) == _o3_hour and minute(time[1], TZ) == _o3_min

if o1_show and o1_just_ended and not o1_done and not na(o1_hi)
    _bc = f_dow_col(o1_use_dow, o1_dow_mon, o1_dow_tue, o1_dow_wed, o1_dow_thu, o1_dow_fri, _o1_box_col, o1_bg_transp)
    [_b, _ehi, _elo, _mid] = f_orb_draw(o1_hi, o1_lo, o1_bar_start, _o1_extend_bars, _bc, _o1_box_brd_col, o1_box_brd_w, o1_box_brd_sty, _o1_ext_col, _o1_ext_width, o1_ext_style, o1_show_mid, _o1_mid_col, _o1_mid_width, _o1_mid_style, _o1_txt, _o1_box_brd_col)
    o1_box := _b
    o1_ext_hi := _ehi
    o1_ext_lo := _elo
    o1_mid_line := _mid
    if show_side_text
        [_lh, _ll] = f_line_labels(o1_hi, o1_lo, _o1_txt, _o1_box_brd_col)
        o1_lbl_hi := _lh
        o1_lbl_lo := _ll
    o1_done := true

if o2_show and o2_just_ended and not o2_done and not na(o2_hi)
    _bc = f_dow_col(o2_use_dow, o2_dow_mon, o2_dow_tue, o2_dow_wed, o2_dow_thu, o2_dow_fri, _o2_box_col, o2_bg_transp)
    [_b, _ehi, _elo, _mid] = f_orb_draw(o2_hi, o2_lo, o2_bar_start, _o2_extend_bars, _bc, _o2_box_brd_col, o2_box_brd_w, o2_box_brd_sty, _o2_ext_col, _o2_ext_width, o2_ext_style, o2_show_mid, _o2_mid_col, _o2_mid_width, _o2_mid_style, _o2_txt, _o2_box_brd_col)
    o2_box := _b
    o2_ext_hi := _ehi
    o2_ext_lo := _elo
    o2_mid_line := _mid
    if show_side_text
        [_lh, _ll] = f_line_labels(o2_hi, o2_lo, _o2_txt, _o2_box_brd_col)
        o2_lbl_hi := _lh
        o2_lbl_lo := _ll
    o2_done := true

if o3_show and o3_just_ended and not o3_done and not na(o3_hi)
    _bc = f_dow_col(o3_use_dow, o3_dow_mon, o3_dow_tue, o3_dow_wed, o3_dow_thu, o3_dow_fri, _o3_box_col, o3_bg_transp)
    [_b, _ehi, _elo, _mid] = f_orb_draw(o3_hi, o3_lo, o3_bar_start, _o3_extend_bars, _bc, _o3_box_brd_col, o3_box_brd_w, o3_box_brd_sty, _o3_ext_col, _o3_ext_width, o3_ext_style, o3_show_mid, _o3_mid_col, _o3_mid_width, _o3_mid_style, _o3_txt, _o3_box_brd_col)
    o3_box := _b
    o3_ext_hi := _ehi
    o3_ext_lo := _elo
    o3_mid_line := _mid
    if show_side_text
        [_lh, _ll] = f_line_labels(o3_hi, o3_lo, _o3_txt, _o3_box_brd_col)
        o3_lbl_hi := _lh
        o3_lbl_lo := _ll
    o3_done := true

// ═══════════════════════════════════════════════════════════════
// SECTION 12 — EXTEND LINES TO 16:00
// ═══════════════════════════════════════════════════════════════
if o1_show and o1_done and in_trading
    if o1_extend_1600 and not na(o1_ext_hi)
        line.set_x2(o1_ext_hi, bar_index)
        line.set_x2(o1_ext_lo, bar_index)
        if o1_show_mid and not na(o1_mid_line)
            line.set_x2(o1_mid_line, bar_index)
        if show_side_text and not na(o1_lbl_hi)
            label.set_x(o1_lbl_hi, bar_index)
            label.set_x(o1_lbl_lo, bar_index)

if o2_show and o2_done and in_trading
    if o2_extend_1600 and not na(o2_ext_hi)
        line.set_x2(o2_ext_hi, bar_index)
        line.set_x2(o2_ext_lo, bar_index)
        if o2_show_mid and not na(o2_mid_line)
            line.set_x2(o2_mid_line, bar_index)
        if show_side_text and not na(o2_lbl_hi)
            label.set_x(o2_lbl_hi, bar_index)
            label.set_x(o2_lbl_lo, bar_index)

if o3_show and o3_done and in_trading
    if o3_extend_1600 and not na(o3_ext_hi)
        line.set_x2(o3_ext_hi, bar_index)
        line.set_x2(o3_ext_lo, bar_index)
        if o3_show_mid and not na(o3_mid_line)
            line.set_x2(o3_mid_line, bar_index)
        if show_side_text and not na(o3_lbl_hi)
            label.set_x(o3_lbl_hi, bar_index)
            label.set_x(o3_lbl_lo, bar_index)

if o1_show and o1_done and not na(o1_box) and _o1_extend_bars > 0
    box.set_right(o1_box, bar_index + _o1_extend_bars)
if o2_show and o2_done and not na(o2_box) and _o2_extend_bars > 0
    box.set_right(o2_box, bar_index + _o2_extend_bars)
if o3_show and o3_done and not na(o3_box) and _o3_extend_bars > 0
    box.set_right(o3_box, bar_index + _o3_extend_bars)

// ═══════════════════════════════════════════════════════════════
// SECTION 13 — BREAKOUT CONFIRMATION ICONS
// ═══════════════════════════════════════════════════════════════
if show_icons and barstate.isconfirmed
    _sz = f_icon_size(icon_size)

    // ORB 1
    if o1_show and o1_done and not na(o1_hi)
        if close > o1_hi and not o1_bull_conf
            label.new(bar_index, high, bull_icon,
                 xloc=xloc.bar_index, yloc=yloc.price,
                 color=color.new(color.white,100), textcolor=bull_icon_col,
                 style=label.style_label_down, size=_sz)
            o1_bull_conf := true
        if close < o1_lo and not o1_bear_conf
            label.new(bar_index, low, bear_icon,
                 xloc=xloc.bar_index, yloc=yloc.price,
                 color=color.new(color.white,100), textcolor=bear_icon_col,
                 style=label.style_label_up, size=_sz)
            o1_bear_conf := true

    // ORB 2
    if o2_show and o2_done and not na(o2_hi)
        if close > o2_hi and not o2_bull_conf
            label.new(bar_index, high, bull_icon,
                 xloc=xloc.bar_index, yloc=yloc.price,
                 color=color.new(color.white,100), textcolor=bull_icon_col,
                 style=label.style_label_down, size=_sz)
            o2_bull_conf := true
        if close < o2_lo and not o2_bear_conf
            label.new(bar_index, low, bear_icon,
                 xloc=xloc.bar_index, yloc=yloc.price,
                 color=color.new(color.white,100), textcolor=bear_icon_col,
                 style=label.style_label_up, size=_sz)
            o2_bear_conf := true

    // ORB 3
    if o3_show and o3_done and not na(o3_hi)
        if close > o3_hi and not o3_bull_conf
            label.new(bar_index, high, bull_icon,
                 xloc=xloc.bar_index, yloc=yloc.price,
                 color=color.new(color.white,100), textcolor=bull_icon_col,
                 style=label.style_label_down, size=_sz)
            o3_bull_conf := true
        if close < o3_lo and not o3_bear_conf
            label.new(bar_index, low, bear_icon,
                 xloc=xloc.bar_index, yloc=yloc.price,
                 color=color.new(color.white,100), textcolor=bear_icon_col,
                 style=label.style_label_up, size=_sz)
            o3_bear_conf := true

// ═══════════════════════════════════════════════════════════════
// SECTION 14 — ALERTS
// ═══════════════════════════════════════════════════════════════
alertcondition(o1_done and close > o1_hi, title="ORB1 Bullish Breakout", message="ORB1 Bullish Breakout: {{ticker}} @ {{close}}")
alertcondition(o1_done and close < o1_lo, title="ORB1 Bearish Breakout", message="ORB1 Bearish Breakout: {{ticker}} @ {{close}}")
alertcondition(o2_done and close > o2_hi, title="ORB2 Bullish Breakout", message="ORB2 Bullish Breakout: {{ticker}} @ {{close}}")
alertcondition(o2_done and close < o2_lo, title="ORB2 Bearish Breakout", message="ORB2 Bearish Breakout: {{ticker}} @ {{close}}")
alertcondition(o3_done and close > o3_hi, title="ORB3 Bullish Breakout", message="ORB3 Bullish Breakout: {{ticker}} @ {{close}}")
alertcondition(o3_done and close < o3_lo, title="ORB3 Bearish Breakout", message="ORB3 Bearish Breakout: {{ticker}} @ {{close}}")

// ═══════════════════════════════════════════════════════════════
// SECTION 15 — VWAP
// ═══════════════════════════════════════════════════════════════
grpV            = "VWAP"
show_vwap       = input.bool(true,  "Show VWAP",              group=grpV)
vwap_src        = input.source(hlc3, "Source",                group=grpV)
vwap_col        = input.color(color.new(color.white, 0), "VWAP Color", group=grpV)
vwap_width      = input.int(2,      "VWAP Width",             group=grpV, minval=1)
show_vwap_bands = input.bool(false, "Show Std Dev Bands",     group=grpV,
     tooltip="Plots upper/lower bands N standard deviations away from VWAP.")
vwap_band_mult  = input.float(1.0,  "Band Multiplier",        group=grpV, minval=0.1, step=0.5)
vwap_band_col   = input.color(color.new(color.white, 60), "Band Color", group=grpV)
vwap_fill       = input.bool(true,  "Fill Bands",             group=grpV)
vwap_fill_col   = input.color(color.new(color.white, 94), "Fill Color", group=grpV)

// Session-anchored VWAP — resets at the start of each new trading session,
// identical to TradingView's built-in VWAP. Hidden on daily+ timeframes.
vwapValue = ta.vwap(vwap_src)
vwapAnchor = ta.change(time("1D")) != 0
[_, vwapUpper, vwapLower] = ta.vwap(vwap_src, vwapAnchor, vwap_band_mult)

bool vwapVisible = show_vwap and timeframe.isintraday

// display: kept off the status line so the indicator title stays clean
// (otherwise TradingView prints the VWAP value and two "ø" for the
// disabled band plots next to the script name).
plot(vwapVisible ? vwapValue : na, "VWAP",
     color=vwap_col, linewidth=vwap_width,
     display=display.pane + display.price_scale + display.data_window)

vwapUpPlot = plot(vwapVisible and show_vwap_bands ? vwapUpper : na, "VWAP Upper Band",
     color=vwap_band_col, linewidth=1,
     display=display.pane + display.data_window)
vwapDnPlot = plot(vwapVisible and show_vwap_bands ? vwapLower : na, "VWAP Lower Band",
     color=vwap_band_col, linewidth=1,
     display=display.pane + display.data_window)
fill(vwapUpPlot, vwapDnPlot,
     color=vwapVisible and show_vwap_bands and vwap_fill ? vwap_fill_col : na,
     title="VWAP Band Fill")

// VWAP Cross Alerts
alertcondition(ta.crossover(close, vwapValue),  title="Price Crossed Above VWAP", message="Price crossed ABOVE VWAP: {{ticker}} @ {{close}}")
alertcondition(ta.crossunder(close, vwapValue), title="Price Crossed Below VWAP", message="Price crossed BELOW VWAP: {{ticker}} @ {{close}}")

// ═══════════════════════════════════════════════════════════════
// SECTION 16 — KEY LEVELS: MIDNIGHT OPEN, PDH, PDL, PDMID
//   Drawn at 00:00 ET each day, extended bar-by-bar until 16:00
// ═══════════════════════════════════════════════════════════════
grpK           = "Key Levels — Midnight Open / PDH / PDL / PDMid"
show_mid_open  = input.bool(true,  "MNO (Midnight Open)", group=grpK, inline="klmo")
mo_col         = input.color(color.new(color.yellow, 0), "", group=grpK, inline="klmo")
show_pdh       = input.bool(true,  "PDH (Prev Day High)", group=grpK, inline="klph")
pdh_col        = input.color(color.new(color.green,  0), "", group=grpK, inline="klph")
show_pdl       = input.bool(true,  "PDL (Prev Day Low)",  group=grpK, inline="klpl")
pdl_col        = input.color(color.new(color.red,    0), "", group=grpK, inline="klpl")
show_pdm       = input.bool(true,  "PDMid (Prev Day Mid)", group=grpK, inline="klpm")
pdm_col        = input.color(color.new(color.silver, 0), "", group=grpK, inline="klpm")
kl_width       = input.int(1,        "Line Width", group=grpK, minval=1)
kl_style       = input.string("dashed", "Line Style", group=grpK, options=["solid","dashed","dotted"])
show_kl_labels = input.bool(true,    "Show Level Labels", group=grpK,
     tooltip="Text tags that ride the right end of each level line.")
kl_label_size  = input.string("small", "Label Size", group=grpK, options=["tiny","small","normal","large","huge"])

// Previous day H/L from the daily timeframe (non-repainting: [1] + lookahead_on)
[pd_high, pd_low] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
pd_mid = (pd_high + pd_low) / 2

// First bar of the new calendar day in ET = the 00:00 anchor.
// Using the date change (not an exact 00:00 match) so it works on any intraday timeframe.
is_new_calday = ta.change(dayofmonth(time, TZ)) != 0

var line  ln_mo = na
var line  ln_pdh = na
var line  ln_pdl = na
var line  ln_pdm = na
var label lb_mo = na
var label lb_pdh = na
var label lb_pdl = na
var label lb_pdm = na

f_kl_line(price, col) =>
    line.new(bar_index, price, bar_index, price,
         xloc=xloc.bar_index, color=col, width=kl_width,
         style=f_line_style(kl_style), extend=extend.none)

// Trailing tag that rides the right end of a key level line.
// Solid background with contrasting text, matching the style of the
// ORB high/low line labels so all right-edge tags look consistent.
f_kl_label(price, txt, col, tcol) =>
    label.new(bar_index, price, txt,
         xloc=xloc.bar_index, color=col, textcolor=tcol,
         style=label.style_label_left, size=f_text_size(kl_label_size))

// Flag-style label pinned at the START (midnight anchor) of a key level.
// Solid background, sits to the left of the line's first bar.
f_kl_flag(price, txt, col, tcol) =>
    label.new(bar_index, price, txt,
         xloc=xloc.bar_index, color=col, textcolor=tcol,
         style=label.style_label_right, size=f_text_size(kl_label_size))

if is_new_calday and timeframe.isintraday
    if show_mid_open
        ln_mo := f_kl_line(open, mo_col)
        if show_kl_labels
            f_kl_flag(open, "MNO", mo_col, color.black)
            lb_mo := f_kl_label(open, "MNO", mo_col, color.black)
    if show_pdh and not na(pd_high)
        ln_pdh := f_kl_line(pd_high, pdh_col)
        if show_kl_labels
            f_kl_flag(pd_high, "PDH", pdh_col, color.white)
            lb_pdh := f_kl_label(pd_high, "PDH", pdh_col, color.white)
    if show_pdl and not na(pd_low)
        ln_pdl := f_kl_line(pd_low, pdl_col)
        if show_kl_labels
            f_kl_flag(pd_low, "PDL", pdl_col, color.white)
            lb_pdl := f_kl_label(pd_low, "PDL", pdl_col, color.white)
    if show_pdm and not na(pd_mid)
        ln_pdm := f_kl_line(pd_mid, pdm_col)
        if show_kl_labels
            f_kl_flag(pd_mid, "PDMid", pdm_col, color.black)
            lb_pdm := f_kl_label(pd_mid, "PDMid", pdm_col, color.black)

// Re-flag the key levels at the ORB 3 (7:30) and ORB 2 (9:30) times so the
// tags are visible mid-session without scrolling back to midnight.
// Uses the configured ORB times, so they move if you change those inputs.
if show_kl_labels and timeframe.isintraday and (o3_bar_match or o2_bar_match)
    if show_mid_open and not na(ln_mo)
        f_kl_flag(line.get_y1(ln_mo), "MNO", mo_col, color.black)
    if show_pdh and not na(ln_pdh)
        f_kl_flag(line.get_y1(ln_pdh), "PDH", pdh_col, color.white)
    if show_pdl and not na(ln_pdl)
        f_kl_flag(line.get_y1(ln_pdl), "PDL", pdl_col, color.white)
    if show_pdm and not na(ln_pdm)
        f_kl_flag(line.get_y1(ln_pdm), "PDMid", pdm_col, color.black)

// Extend all key-level lines (and their labels) bar-by-bar until 16:00 ET
if in_trading
    if not na(ln_mo)
        line.set_x2(ln_mo, bar_index)
        if not na(lb_mo)
            label.set_x(lb_mo, bar_index)
    if not na(ln_pdh)
        line.set_x2(ln_pdh, bar_index)
        if not na(lb_pdh)
            label.set_x(lb_pdh, bar_index)
    if not na(ln_pdl)
        line.set_x2(ln_pdl, bar_index)
        if not na(lb_pdl)
            label.set_x(lb_pdl, bar_index)
    if not na(ln_pdm)
        line.set_x2(ln_pdm, bar_index)
        if not na(lb_pdm)
            label.set_x(lb_pdm, bar_index)

// Key Level Alerts
alertcondition(ta.crossover(close, pd_high),  title="Break Above PDH", message="Price broke ABOVE PDH: {{ticker}} @ {{close}}")
alertcondition(ta.crossunder(close, pd_low),  title="Break Below PDL", message="Price broke BELOW PDL: {{ticker}} @ {{close}}")
