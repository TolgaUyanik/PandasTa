//@version=6
// KALE REJECTION BLOCKS — the indicator HE asked for (his stream, 7/21): "I see FVGs automatically
// in my head, but I DON'T see rejection blocks automatically — that's why I like the rejection block
// indicator." Auto-marks rejection blocks (the wick-rejection zones he uses as TPs: "this rejection
// block 891 is a good TP") with a relevance lifecycle, + optional ZigZag structure (he asked a viewer
// to DM him one). Rejection block (ICT): at a swing HIGH, the candle's upper-wick zone (body-top →
// high) = bearish RB; at a swing LOW, lower-wick zone (body-bottom → low) = bullish RB. Price returns
// to these zones to reject again — entry zones on approach, TP zones on the way.
indicator("Kale Rejection Blocks · John 3:16", overlay = true, max_boxes_count = 40, max_labels_count = 60, max_lines_count = 50)

// ───── inputs
sw       = input.int(3, "swing strength (bars each side)", minval = 2, maxval = 8)
minWickR = input.float(0.35, "min wick fraction of candle range", step = 0.05)
minWickA = input.float(0.30, "min wick size (×ATR)", step = 0.05)
showMid  = input.bool(true, "show 50% line of each block")
showZig  = input.bool(true, "show ZigZag structure line")
keepN    = input.int(12, "max active blocks", minval = 4, maxval = 30)

atr = ta.atr(14)

var array<box>   bxs  = array.new<box>()
var array<line>  mids = array.new<line>()
var array<int>   dirs = array.new<int>()     // 1 = bullish RB (support), -1 = bearish RB (resistance)
var array<bool>  tapped = array.new<bool>()

// ───── detect at confirmed swings: the wickiest candle at the pivot
ph = ta.pivothigh(high, sw, sw)
pl = ta.pivotlow(low, sw, sw)

newRB(dir) =>
    // pivot candle is sw bars back
    o = open[sw], c = close[sw], h = high[sw], l = low[sw]
    bodyTop = math.max(o, c), bodyBot = math.min(o, c)
    wick = dir == -1 ? h - bodyTop : bodyBot - l
    rng = math.max(h - l, syminfo.mintick)
    ok = wick >= minWickR * rng and wick >= minWickA * atr
    [ok, dir == -1 ? h : bodyBot, dir == -1 ? bodyTop : l]

addRB(top, bot, dir) =>
    b = box.new(bar_index - sw, top, bar_index + 1, bot, extend = extend.right,
         border_color = dir == -1 ? color.new(color.red, 25) : color.new(color.teal, 25),
         bgcolor = dir == -1 ? color.new(color.red, 84) : color.new(color.teal, 84))
    label.new(bar_index - sw, dir == -1 ? top : bot, dir == -1 ? "RB ▼ (rejection above)" : "RB ▲ (rejection below)",
         style = dir == -1 ? label.style_label_down : label.style_label_up, size = size.tiny,
         textcolor = dir == -1 ? color.red : color.teal, color = color.new(color.black, 60))
    m = showMid ? line.new(bar_index - sw, (top + bot) / 2, bar_index + 1, (top + bot) / 2, extend = extend.right,
         color = color.new(color.gray, 40), style = line.style_dotted) : line(na)
    array.push(bxs, b), array.push(mids, m), array.push(dirs, dir), array.push(tapped, false)
    if array.size(bxs) > keepN
        box.delete(array.shift(bxs)), line.delete(array.shift(mids))
        array.shift(dirs), array.shift(tapped)

if not na(ph)
    [ok, top, bot] = newRB(-1)
    if ok
        addRB(top, bot, -1)
if not na(pl)
    [ok, top, bot] = newRB(1)
    if ok
        addRB(top, bot, 1)

// ───── relevance lifecycle: TAPPED (his TP/entry moment) → MITIGATED (body-close through) = delete
if array.size(bxs) > 0
    for i = array.size(bxs) - 1 to 0
        b = array.get(bxs, i)
        top = box.get_top(b), bot = box.get_bottom(b)
        dir = array.get(dirs, i)
        // mitigated: body closes fully beyond the far edge → block is spent → remove
        spent = dir == -1 ? close > top : close < bot
        if spent
            box.delete(b), line.delete(array.get(mids, i))
            array.remove(bxs, i), array.remove(mids, i), array.remove(dirs, i), array.remove(tapped, i)
            continue
        // tapped: price enters the zone (this is where he TPs into / fades from)
        inZone = dir == -1 ? high >= bot : low <= top
        if inZone and not array.get(tapped, i)
            array.set(tapped, i, true)
            box.set_bgcolor(b, dir == -1 ? color.new(color.red, 70) : color.new(color.teal, 70))
            label.new(bar_index, dir == -1 ? top : bot, "RB TAP", style = label.style_label_left,
                 size = size.tiny, textcolor = color.yellow, color = color.new(color.black, 55))

tapAlert = false
if array.size(bxs) > 0
    for i = 0 to array.size(bxs) - 1
        b2 = array.get(bxs, i)
        d2 = array.get(dirs, i)
        if (d2 == -1 ? high >= box.get_bottom(b2) : low <= box.get_top(b2)) and not array.get(tapped, i)
            tapAlert := true
alertcondition(tapAlert, "Rejection block tap", "Price entered a rejection block (Kale TP/entry zone)")

// ───── watermark: his name + the verse
var table wm = table.new(position.bottom_left, 1, 1)
if barstate.islast
    table.cell(wm, 0, 0, "Kale · John 3:16", text_color = color.new(color.gray, 30), text_size = size.small, bgcolor = color.new(color.black, 70))

// ───── ZigZag structure (the one he asked a viewer to DM him)
var float lastPivotPx = na
var int   lastPivotBi = na
if showZig and (not na(ph) or not na(pl))
    px = not na(ph) ? high[sw] : low[sw]
    bi = bar_index - sw
    if not na(lastPivotPx)
        line.new(lastPivotBi, lastPivotPx, bi, px, color = color.new(color.silver, 35), width = 1)
    lastPivotPx := px
    lastPivotBi := bi
