///////
///////
//////
//// Historical

//var interval = interval  //input.timeframe('120', 'Time Frame', inline = 'interval', group = "Historical" )

// Getting the values

currentTicker = ticker.new(syminfo.prefix, syminfo.ticker, syminfo.session)
f_Values_C_H() =>
    request.security(currentTicker, interval, [high, low, open], lookahead = barmerge.lookahead_on)
f_Values_P1_H() =>
    request.security(currentTicker, interval, [high[1], low[1], open[1]], lookahead = barmerge.lookahead_on)
f_Values_P2_H() =>
    request.security(currentTicker, interval, [high[2], low[2], open[2]], lookahead = barmerge.lookahead_on)
f_Values_P3_H() =>
    request.security(currentTicker, interval, [high[3], low[3], open[3]], lookahead = barmerge.lookahead_on)
f_Values_P4_H() =>
    request.security(currentTicker, interval, [high[4], low[4], open[4]], lookahead = barmerge.lookahead_on)


barsRequired = 3  // max depth used in your script
enoughBars = bar_index >= barsRequired

[HighC_H, LowC_H, OpenC_H] = f_Values_C_H()
[HighP1_H, LowP1_H, OpenP1_H] = f_Values_P1_H()
[HighP2_H, LowP2_H, OpenP2_H] = f_Values_P2_H()
[HighP3_H, LowP3_H, OpenP3_H] = f_Values_P3_H()
[HighP4_H, LowP4_H, OpenP4_H] = f_Values_P4_H()

TIME_Sec = timeframe.in_seconds(interval)
dailySec = timeframe.in_seconds('1D')
Interval_Close = request.security(currentTicker, interval, time_close, lookahead = barmerge.lookahead_on)

// If the selected interval is not intraday
if TIME_Sec >= dailySec
    if time_close > Interval_Close
        HighP1_H := HighC_H
        LowP1_H := LowC_H
        OpenP1_H := OpenC_H
        OpenP2_H := OpenC_H
        OpenP3_H := OpenC_H
        OpenP4_H := OpenC_H

EQcalc_H = (HighP1_H - (HighP1_H - LowP1_H)*.5)

BoxWidth = 1 //input.int(1, '', minval = 0, inline = 'HLfill', display = display.none)
BoxLineStyle = line.style_solid //input.bool(false, '---', inline = '10') ? line.style_dashed : line.style_solid
BoxColor = color.new(#9598a1, 100)

// open and EQ
H_OpenC = show_historical ? OpenC_show  : false
H_Open_P1 = show_historical ? OpenC_show  ? show_prior_1 : false : false
H_Open_P2 = show_historical ? OpenC_show  ? show_prior_2 : false : false 
H_Open_P3 = show_historical ? OpenC_show  ? show_prior_3 : false : false 
H_Open_P4 = show_historical ? OpenC_show  ? show_prior_4 : false : false 


H_HL = show_historical ? HL_show  : false 

H_EQ = show_historical ? EQ_show  : false 

H_FIB_025 = show_historical ? FIB_025_show  : false 
H_FIB_050 = show_historical ? FIB_050_show  : false 
H_FIB_075 = show_historical ? FIB_075_show  : false 
H_FIB_100 = show_historical ? FIB_100_show  : false 
H_FIB_125 = show_historical ? FIB_125_show  : false 
H_FIB_150 = show_historical ? FIB_150_show  : false  
H_fib_200 = show_historical ? FIB_200_show  : false  
 
hOpenC = H_OpenC and not na(OpenC_H) and enoughBars ? OpenC_H : na
hOpen_P1 = H_Open_P1 and not na(OpenP1_H) and enoughBars ? OpenP1_H : na
hOpen_P2 = H_Open_P2 and not na(OpenP2_H) and enoughBars ? OpenP2_H : na
hOpen_P3 = H_Open_P3 and not na(OpenP3_H) and enoughBars ? OpenP3_H : na
hOpen_P4 = H_Open_P4 and not na(OpenP4_H) and enoughBars ? OpenP4_H : na
yHigh= H_HL and not na(HighP1_H) and enoughBars ? HighP1_H : na //HighP1_H : na
yLow= H_HL and not na(LowP1_H) and enoughBars ? LowP1_H : na //? LowP1_H : na
ysdeq = H_EQ and not na(EQcalc_H) and enoughBars ? EQcalc_H : na //EQcalc_H : na
yFIB_025u = H_FIB_025 ?  H_anchor_fib025 == "open" ? cOpen + ((HighP1_H - LowP1_H)*FIB_025) :  H_anchor_fib025 == "EQ" ? EQcalc_H + ((HighP1_H - LowP1_H)*FIB_025) : na : na
yFIB_025d = H_FIB_025 ?  H_anchor_fib025 == "open" ? cOpen - ((HighP1_H - LowP1_H)*FIB_025) :  H_anchor_fib025 == "EQ" ? EQcalc_H - ((HighP1_H - LowP1_H)*FIB_025) : na : na
yFIB_050u = H_FIB_050 ?  H_anchor_fib050 == "open" ? cOpen + ((HighP1_H - LowP1_H)*FIB_050) :  H_anchor_fib050 == "EQ" ? EQcalc_H + ((HighP1_H - LowP1_H)*FIB_050) : na : na
yFIB_050d = H_FIB_050 ?  H_anchor_fib050 == "open" ? cOpen - ((HighP1_H - LowP1_H)*FIB_050) :  H_anchor_fib050 == "EQ" ? EQcalc_H - ((HighP1_H - LowP1_H)*FIB_050) : na : na
yFIB_075u = H_FIB_075 ?  H_anchor_fib075 == "open" ? cOpen + ((HighP1_H - LowP1_H)*FIB_075) :  H_anchor_fib075 == "EQ" ? EQcalc_H + ((HighP1_H - LowP1_H)*FIB_075) : na : na
yFIB_075d = H_FIB_075 ?  H_anchor_fib075 == "open" ? cOpen - ((HighP1_H - LowP1_H)*FIB_075) :  H_anchor_fib075 == "EQ" ? EQcalc_H - ((HighP1_H - LowP1_H)*FIB_075) : na : na
yFIB_100u = H_FIB_100 ?  H_anchor_fib100 == "open" ? cOpen + ((HighP1_H - LowP1_H)*FIB_100) :  H_anchor_fib100 == "EQ" ? EQcalc_H + ((HighP1_H - LowP1_H)*FIB_100) : na : na
yFIB_100d = H_FIB_100 ?  H_anchor_fib100 == "open" ? cOpen - ((HighP1_H - LowP1_H)*FIB_100) :  H_anchor_fib100 == "EQ" ? EQcalc_H - ((HighP1_H - LowP1_H)*FIB_100) : na : na
yFIB_125u = H_FIB_125 ?  H_anchor_fib125 == "open" ? cOpen + ((HighP1_H - LowP1_H)*FIB_125) :  H_anchor_fib125 == "EQ" ? EQcalc_H + ((HighP1_H - LowP1_H)*FIB_125) : na : na
yFIB_125d = H_FIB_125 ?  H_anchor_fib125 == "open" ? cOpen - ((HighP1_H - LowP1_H)*FIB_125) :  H_anchor_fib125 == "EQ" ? EQcalc_H - ((HighP1_H - LowP1_H)*FIB_125) : na : na
yFIB_150u = H_FIB_150 ?  H_anchor_fib150 == "open" ? cOpen + ((HighP1_H - LowP1_H)*FIB_150) :  H_anchor_fib150 == "EQ" ? EQcalc_H + ((HighP1_H - LowP1_H)*FIB_150) : na : na
yFIB_150d = H_FIB_150 ?  H_anchor_fib150 == "open" ? cOpen - ((HighP1_H - LowP1_H)*FIB_150) :  H_anchor_fib150 == "EQ" ? EQcalc_H - ((HighP1_H - LowP1_H)*FIB_150) : na : na
yfib_200u = H_fib_200 ?  H_anchor_fib200 == "open" ? cOpen + ((HighP1_H - LowP1_H)*fib_200) :  H_anchor_fib200 == "EQ" ? EQcalc_H + ((HighP1_H - LowP1_H)*fib_200) : na : na
yfib_200d = H_fib_200 ?  H_anchor_fib200 == "open" ? cOpen - ((HighP1_H - LowP1_H)*fib_200) :  H_anchor_fib200 == "EQ" ? EQcalc_H - ((HighP1_H - LowP1_H)*fib_200) : na : na

// Plots

hOpenC_plot = plot(hOpenC, color =  H_visual_open == "line" ? (bool(ta.change(hOpenC)) ? na : Open_color) :  H_visual_open == "channel" ? Open_color : na , style = plot.style_line, linewidth = Open_width)
hOpen_P1_plot = plot(hOpen_P1, color =  H_visual_open == "line" ? (bool(ta.change(hOpen_P1)) ? na : Open_color) :  H_visual_open == "channel" ? Open_color : na , style = plot.style_line, linewidth = Open_width)
hOpen_P2_plot = plot(hOpen_P2, color =  H_visual_open == "line" ? (bool(ta.change(hOpen_P2)) ? na : Open_color) :  H_visual_open == "channel" ? Open_color : na , style = plot.style_line, linewidth = Open_width)
hOpen_P3_plot = plot(hOpen_P3, color =  H_visual_open == "line" ? (bool(ta.change(hOpen_P3)) ? na : Open_color) :  H_visual_open == "channel" ? Open_color : na , style = plot.style_line, linewidth = Open_width)
hOpen_P4_plot = plot(hOpen_P4, color =  H_visual_open == "line" ? (bool(ta.change(hOpen_P4)) ? na : Open_color) :  H_visual_open == "channel" ? Open_color : na , style = plot.style_line, linewidth = Open_width)

yHigh_plot = plot(yHigh, color = H_visual_H == "line" ? (bool(ta.change(yHigh)) ? na : HL_color) : H_visual_H == "channel" ? HL_color : na , style = plot.style_stepline, linewidth = HL_width)
yLow_plot = plot(yLow, color = H_visual_L == "line" ? (bool(ta.change(yHigh)) ? na : HL_color) : H_visual_L == "channel" ? HL_color : na , style = plot.style_stepline, linewidth = HL_width)


ysdeqplot = plot(ysdeq, color = H_visual_EQ == "line" ? (bool(ta.change(ysdeq)) ? na : EQ_color) : H_visual_EQ == "channel" ? EQ_color : na , style = plot.style_stepline, linewidth = EQ_width)
yFIB_025uplot = plot(yFIB_025u, color = H_visual_fib025 == "line" ? (bool(ta.change(yFIB_025u)) ? na : FIB_025_color) : H_visual_fib025 == "channel" ? FIB_025_color : na , style = plot.style_stepline, linewidth = FIB_025_width)
yFIB_025dplot = plot(yFIB_025d, color = H_visual_fib025 == "line" ? (bool(ta.change(yFIB_025d)) ? na : FIB_025_color) : H_visual_fib025 == "channel" ? FIB_025_color : na , style = plot.style_stepline, linewidth = FIB_025_width)
yFIB_050uplot = plot(yFIB_050u, color = H_visual_fib050 == "line" ? (bool(ta.change(yFIB_050u)) ? na : FIB_050_color) : H_visual_fib050 == "channel" ? FIB_050_color : na , style = plot.style_stepline, linewidth = FIB_050_width)
yFIB_050dplot = plot(yFIB_050d, color = H_visual_fib050 == "line" ? (bool(ta.change(yFIB_050d)) ? na : FIB_050_color) : H_visual_fib050 == "channel" ? FIB_050_color : na , style = plot.style_stepline, linewidth = FIB_050_width)
yFIB_075uplot = plot(yFIB_075u, color = H_visual_fib075 == "line" ? (bool(ta.change(yFIB_075u)) ? na : FIB_075_color) : H_visual_fib075 == "channel" ? FIB_075_color : na , style = plot.style_stepline, linewidth = FIB_075_width)
