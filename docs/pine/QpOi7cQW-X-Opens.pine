//@version=6
indicator('X Opens+', 'X Opens+', true)

// === FUNCTION TO HANDLE TIMEFRAME DATA ===
process_timeframe(tf) =>
    pHigh = request.security(syminfo.tickerid, tf, high[1], lookahead = barmerge.lookahead_on)
    pLow = request.security(syminfo.tickerid, tf, low[1], lookahead = barmerge.lookahead_on)
    cOpen = request.security(syminfo.tickerid, tf, open, lookahead = barmerge.lookahead_on)
    pOpen = request.security(syminfo.tickerid, tf, open[1], lookahead = barmerge.lookahead_on)
    [pHigh, pLow, cOpen, pOpen]

// Extend lines to the right
extend_len = 10
x2 = bar_index + extend_len

// TIMEFRAME #1 ===

interval  = input.timeframe("D", " ", inline = "TF01", group = "settings")

timeframe_text =  interval  == "5"  ? "5m"  :
                  interval  == "15"  ? "15m"  :
                  interval  == "30"  ? "30m"  :
                  interval  == "60"  ? "1H"  :
                  interval  == "45"  ? "45m"  : 
                  interval  == "120"  ? "2H"  :
                  interval  == "240" ? "4H"  :
                  interval  == "360" ? "6H"  :
                  interval  == "1440"   ? "D" :
                  interval  == "1D"   ? "D" :                  
                  interval  == "2D" ? "2D"  : 
                  interval  == "1W" ? "W"  : 
                  interval  == "2W" ? "2W"  : 
                  interval  == "1M" ? "1M"  : 
                  interval  == "2M" ? "2M"  :
                  interval  == "3M" ? "3M"  :
                  interval  == "4M" ? "4M"  :
                  interval  == "5M" ? "5M"  :
                  interval  == "6M" ? "6M"  :
                  interval  == "12M" ? "12M"  :" "

show_historical = input.bool(true, "Show Historical -----  Extend Opens by ", inline = 'history', group = "settings")
show_prior_1 = input.bool(true, "1", inline = 'history', group = "settings")
show_prior_2 = input.bool(true, "2", inline = 'history', group = "settings")
show_prior_3 = input.bool(true, "3", inline = 'history', group = "settings")
show_prior_4 = false //input.bool(true, "3", inline = 'history', group = "settings")

showlabel = input.bool(true, "Label", inline = 'label', group = "settings")
showlabelsize = input.string('tiny', '', ['tiny', 'small', 'normal', 'large'], inline = 'label', group = "settings")
showlabeltextcolor = input.color(color.rgb(206, 206, 206), '', inline = 'label', group = "settings")
showlabelbackcolor = input.color(color.rgb(32, 32, 32, 100), '', inline = 'label', group = "settings")

OpenC_show  = input.bool(true, "Open", inline = "tf-open", group = "data lines")
OpenP_show  = show_prior_1 //input.bool(false, "prev", inline = "TF01-2", group = "data lines")  
HL_show = input.bool(false, "HL", inline = "tf-hl", group = "data lines")
EQ_show  = input.bool(false, "EQ", inline = "tf-eq", group = "data lines")
FIB_025_show  = input.bool(false, '+- 0.25', inline = "tf-025"  , group = "data lines")
FIB_050_show  = input.bool(false, '+- 0.50', inline = "tf-050"  , group = "data lines")
FIB_075_show  = input.bool(false, '+- 0.75', inline = "tf-075"  , group = "data lines")
FIB_100_show  = input.bool(false, '+- 1.0', inline = "tf-100"  , group = "data lines")
FIB_125_show  = input.bool(false, '+- 1.25', inline = "tf-125"  , group = "data lines")
FIB_150_show  = input.bool(false, '+- 1.5', inline = "tf-150"  , group = "data lines")
FIB_200_show  = input.bool(false, '+- 2.0', inline = "tf-200"  , group = "data lines")

Open_color  = input.color( color.rgb(226, 27, 27, 30), '', inline = "tf-open" , group = "data lines")
HL_color  = input.color( color.rgb(90, 90, 90), '', inline = "tf-hl" , group = "data lines")
EQ_color  = input.color( color.rgb(135, 135, 135, 11), '', inline = "tf-eq" , group = "data lines")
FIB_025_color  = input.color( color.rgb(135, 135, 135, 11), '', inline = "tf-025"  , group = "data lines" )
FIB_050_color  = input.color( color.rgb(135, 135, 135, 11), '', inline = "tf-050"  , group = "data lines" )
FIB_075_color  = input.color( color.rgb(135, 135, 135, 11), '', inline = "tf-075"  , group = "data lines" )
FIB_100_color  = input.color( color.rgb(135, 135, 135, 11), '', inline = "tf-100"  , group = "data lines" )
FIB_125_color  = input.color( color.rgb(135, 135, 135, 11), '', inline = "tf-125"  , group = "data lines" )
FIB_150_color  = input.color( color.rgb(135, 135, 135, 11), '', inline = "tf-150"   , group = "data lines")
FIB_200_color  = input.color( color.rgb(135, 135, 135, 11), '', inline = "tf-200"   , group = "data lines")

Open_width  = input.int( 1, '', inline = "tf-open" , group = "data lines")
HL_width  = input.int( 1, '', inline = "tf-hl" , group = "data lines")
EQ_width  = input.int( 1, '', inline = "tf-eq" , group = "data lines")
FIB_025_width  = input.int( 1, '', inline = "tf-025" , group = "data lines")
FIB_050_width  = input.int( 1, '', inline = "tf-050" , group = "data lines")
FIB_075_width  = input.int( 1, '', inline = "tf-075" , group = "data lines")
FIB_100_width  = input.int( 1, '', inline = "tf-100" , group = "data lines")
FIB_125_width  = input.int( 1, '', inline = "tf-125" , group = "data lines")
FIB_150_width  = input.int( 1, '', inline = "tf-150" , group = "data lines")
FIB_200_width  = input.int( 1, '', inline = "tf-200" , group = "data lines")

H_anchor_fib025 = input.string("open", "", ["open", "EQ"], inline = "tf-025", group = "data lines")
H_anchor_fib050 = input.string("open", "", ["open", "EQ"], inline = "tf-050", group = "data lines")
H_anchor_fib075 = input.string("open", "", ["open", "EQ"], inline = "tf-075", group = "data lines")
H_anchor_fib100 = input.string("open", "", ["open", "EQ"], inline = "tf-100", group = "data lines")
H_anchor_fib125 = input.string("open", "", ["open", "EQ"], inline = "tf-125", group = "data lines")
H_anchor_fib150 = input.string("open", "", ["open", "EQ"], inline = "tf-150", group = "data lines")
H_anchor_fib200 = input.string("open", "", ["open", "EQ"], inline = "tf-200", group = "data lines")

H_visual_open = "line" //input.string("line", "Visual", ["line", "channel"])
H_visual_H = "line" //input.string("line", "Visual", ["line", "channel"])
H_visual_L = "line" //input.string("line", "Visual", ["line", "channel"])
H_visual_EQ = input.string("line", "", ["line", "channel"], inline = "tf-eq" , group = "data lines")
H_visual_fib025 = input.string("line", "", ["line", "channel"], inline = "tf-025" , group = "data lines")
H_visual_fib050 = input.string("line", "", ["line", "channel"], inline = "tf-050" , group = "data lines")
H_visual_fib075 = input.string("line", "", ["line", "channel"], inline = "tf-075" , group = "data lines")
H_visual_fib100 = input.string("line", "", ["line", "channel"], inline = "tf-100" , group = "data lines")
H_visual_fib125 = input.string("line", "", ["line", "channel"], inline = "tf-125" , group = "data lines")
H_visual_fib150 = input.string("line", "", ["line", "channel"], inline = "tf-150" , group = "data lines")
H_visual_fib200 = input.string("line", "", ["line", "channel"], inline = "tf-200" , group = "data lines")

// === DRAW LINES ===

var line OpenC_Line  = na
var line OpenP_Line  = na

var line H_Line  = na
var line L_Line  = na

var line eqLine  = na

var line FIB_025_upperLine  = na
var line FIB_025_lowerLine  = na

var line FIB_050_upperLine  = na
var line FIB_050_lowerLine  = na

var line FIB_075_upperLine  = na
var line FIB_075_lowerLine  = na

var line FIB_100_upperLine  = na
var line FIB_100_lowerLine  = na

var line FIB_125_upperLine  = na
var line FIB_125_lowerLine  = na

var line FIB_150_upperLine  = na
var line FIB_150_lowerLine  = na

var line FIB_200_upperLine  = na
var line FIB_200_lowerLine  = na

// === ANCHOR VARIABLES ===
var float prev_OpenC  = na
var float prev_OpenP  = na

var float prev_high  = na
var float prev_low  = na

var float prev_eq  = na

var float prev_upperFIB_025  = na
var float prev_lowerFIB_025  = na
var float prev_upperFIB_050  = na
var float prev_lowerFIB_050  = na
var float prev_upperFIB_075  = na
var float prev_lowerFIB_075  = na
var float prev_upperFIB_100  = na
var float prev_lowerFIB_100  = na
var float prev_upperFIB_125  = na
var float prev_lowerFIB_125  = na
var float prev_upperFIB_150  = na
var float prev_lowerFIB_150  = na
var float prev_upperFIB_200  = na
var float prev_lowerFIB_200  = na

var int anchor_bar_OpenC  = na
var int anchor_bar_OpenP  = na

var int anchor_bar_high  = na
var int anchor_bar_low  = na

var int anchor_bar_eq  = na

var int anchor_bar_upperFIB_025  = na
var int anchor_bar_lowerFIB_025  = na
var int anchor_bar_upperFIB_050  = na
var int anchor_bar_lowerFIB_050  = na
var int anchor_bar_upperFIB_075  = na
var int anchor_bar_lowerFIB_075  = na
var int anchor_bar_upperFIB_100  = na
var int anchor_bar_lowerFIB_100  = na
var int anchor_bar_upperFIB_125  = na
var int anchor_bar_lowerFIB_125  = na
var int anchor_bar_upperFIB_150  = na
var int anchor_bar_lowerFIB_150  = na
var int anchor_bar_upperFIB_200  = na
var int anchor_bar_lowerFIB_200  = na

// === PROCESS TIMEFRAME  ===
[pHigh , pLow , cOpen , pOpen ] = process_timeframe(interval )

OpenC_calc  = cOpen 
OpenP_calc  = pOpen 

high_calc = pHigh
low_calc = pLow

EQ_calc  = (pHigh  - (pHigh  - pLow ) * 0.5)

FIB_025 = 0.25
FIB_050 = 0.50
FIB_075 = 0.75
FIB_100 = 1.0
FIB_125 = 1.25
FIB_150 = 1.5
fib_200 = 2.0

FIB_025_upper_calc  = cOpen  + (pHigh  - pLow )*FIB_025
FIB_025_lower_calc  = cOpen  - (pHigh  - pLow )*FIB_025
FIB_050_upper_calc  = cOpen  + (pHigh  - pLow )*FIB_050
FIB_050_lower_calc  = cOpen  - (pHigh  - pLow )*FIB_050
FIB_075_upper_calc  = cOpen  + (pHigh  - pLow )*FIB_075
FIB_075_lower_calc  = cOpen  - (pHigh  - pLow )*FIB_075
FIB_100_upper_calc  = cOpen  + (pHigh  - pLow )*FIB_100
FIB_100_lower_calc  = cOpen  - (pHigh  - pLow )*FIB_100
FIB_125_upper_calc  = cOpen  + (pHigh  - pLow )*FIB_125
FIB_125_lower_calc  = cOpen  - (pHigh  - pLow )*FIB_125
FIB_150_upper_calc  = cOpen  + (pHigh  - pLow )*FIB_150
FIB_150_lower_calc  = cOpen  - (pHigh  - pLow )*FIB_150
FIB_200_upper_calc  = cOpen  + (pHigh  - pLow )*fib_200
FIB_200_lower_calc  = cOpen  - (pHigh  - pLow )*fib_200

prev_OpenC  := OpenC_calc 
prev_OpenP  := OpenP_calc 

prev_high  := high_calc
prev_low  := low_calc

prev_eq  := EQ_calc 

prev_upperFIB_025   := FIB_025_upper_calc 
prev_lowerFIB_025  := FIB_025_lower_calc 
prev_upperFIB_050   := FIB_050_upper_calc 
prev_lowerFIB_050  := FIB_050_lower_calc 
prev_upperFIB_075   := FIB_075_upper_calc 
prev_lowerFIB_075  := FIB_075_lower_calc 
prev_upperFIB_100   := FIB_100_upper_calc 
prev_lowerFIB_100  := FIB_100_lower_calc 
prev_upperFIB_125   := FIB_125_upper_calc 
prev_lowerFIB_125  := FIB_125_lower_calc 
prev_upperFIB_150   := FIB_150_upper_calc 
prev_lowerFIB_150  := FIB_150_lower_calc 
prev_upperFIB_200   := FIB_200_upper_calc 
prev_lowerFIB_200  := FIB_200_lower_calc 

// Get HTF open time for new bar detection 
htf_time_open  = request.security(syminfo.tickerid, interval , time, lookahead = barmerge.lookahead_on)
new_htf_bar  = time == htf_time_open 

// Anchor
if new_htf_bar 
    anchor_bar_OpenC  := bar_index
    prev_OpenC  := OpenC_calc 

    anchor_bar_OpenP  := bar_index
    prev_OpenP  := OpenP_calc 

    anchor_bar_high  := bar_index
    prev_high  := high_calc 

    anchor_bar_low  := bar_index
    prev_low  := low_calc 

    anchor_bar_eq  := bar_index
    prev_eq  := EQ_calc 

    anchor_bar_upperFIB_025  := bar_index
    prev_upperFIB_025  := FIB_025_upper_calc 

    anchor_bar_lowerFIB_025  := bar_index
    prev_lowerFIB_025  := FIB_025_lower_calc 

    anchor_bar_upperFIB_050  := bar_index
    prev_upperFIB_050  := FIB_050_upper_calc 

    anchor_bar_lowerFIB_050  := bar_index
    prev_lowerFIB_050  := FIB_050_lower_calc 

    anchor_bar_upperFIB_075  := bar_index
    prev_upperFIB_075  := FIB_075_upper_calc 

    anchor_bar_lowerFIB_075  := bar_index
    prev_lowerFIB_075  := FIB_075_lower_calc 

    anchor_bar_upperFIB_100  := bar_index
    prev_upperFIB_100  := FIB_100_upper_calc 

    anchor_bar_lowerFIB_100  := bar_index
    prev_lowerFIB_100  := FIB_100_lower_calc 
 
    anchor_bar_upperFIB_125  := bar_index
    prev_upperFIB_125  := FIB_125_upper_calc 

    anchor_bar_lowerFIB_125  := bar_index
    prev_lowerFIB_125  := FIB_125_lower_calc 

    anchor_bar_upperFIB_150  := bar_index
    prev_upperFIB_150  := FIB_150_upper_calc 

    anchor_bar_lowerFIB_150  := bar_index
    prev_lowerFIB_150  := FIB_150_lower_calc 

    anchor_bar_upperFIB_200  := bar_index
    prev_upperFIB_200  := FIB_200_upper_calc 

    anchor_bar_lowerFIB_200  := bar_index
    prev_lowerFIB_200  := FIB_200_lower_calc 

// === DELETE OLD LINES ===
line.delete(OpenC_Line )
line.delete(OpenP_Line )
line.delete(H_Line )
line.delete(L_Line )
line.delete(eqLine )
line.delete(FIB_025_upperLine )
line.delete(FIB_025_lowerLine )
line.delete(FIB_050_upperLine )
line.delete(FIB_050_lowerLine )
line.delete(FIB_075_upperLine )
line.delete(FIB_075_lowerLine )
line.delete(FIB_100_upperLine )
line.delete(FIB_100_lowerLine )
line.delete(FIB_125_upperLine )
line.delete(FIB_125_lowerLine )
line.delete(FIB_150_upperLine )
line.delete(FIB_150_lowerLine )
line.delete(FIB_200_upperLine )
line.delete(FIB_200_lowerLine )


// Draw lines 
bool isDrawBar_OpenC = show_historical or bar_index == anchor_bar_OpenC
if (not OpenC_show or not isDrawBar_OpenC) and not na(OpenC_Line)
    line.delete(OpenC_Line)
    OpenC_Line := na
if OpenC_show  and not na(prev_OpenC ) and not na(anchor_bar_OpenC) 
    OpenC_Line  := line.new(x1 = anchor_bar_OpenC , y1 = prev_OpenC , x2 = x2, y2 = prev_OpenC , color = Open_color , width = Open_width )

//bool isDrawBar_OpenP = show_historical or bar_index == anchor_bar_OpenP
//if (not OpenP_show or not isDrawBar_OpenP) and not na(OpenP_Line)
//    line.delete(OpenP_Line)
//    OpenP_Line := na
//if OpenP_show  and not na(prev_OpenP ) and not na(anchor_bar_OpenP) 
//    OpenP_Line  := line.new(x1 = anchor_bar_OpenP , y1 = prev_OpenP , x2 = x2, y2 = prev_OpenP , color = Open_color , width = Open_width )

bool isDrawBar_H = show_historical or bar_index == anchor_bar_high
if (not HL_show or not isDrawBar_H) and not na(H_Line)
    line.delete(H_Line)
    H_Line := na
if HL_show  and not na(prev_high ) and not na(anchor_bar_high)
    H_Line  := line.new(x1 = anchor_bar_high , y1 = prev_high , x2 = x2, y2 = prev_high , color = HL_color , width = HL_width )

bool isDrawBar_L = show_historical or bar_index == anchor_bar_low
if (not HL_show or not isDrawBar_L) and not na(L_Line)
    line.delete(L_Line)
    L_Line := na
if HL_show  and not na(prev_low ) and not na(anchor_bar_low)
    L_Line  := line.new(x1 = anchor_bar_low , y1 = prev_low , x2 = x2, y2 = prev_low , color = HL_color , width = HL_width )

bool isDrawBar_eq = show_historical or bar_index == anchor_bar_eq
if (not EQ_show or not isDrawBar_eq) and not na(eqLine)
    line.delete(eqLine)
    eqLine := na
if EQ_show  and not na(prev_eq ) and not na(anchor_bar_eq)
    eqLine  := line.new(x1 = anchor_bar_eq , y1 = prev_eq , x2 = x2, y2 = prev_eq , color = EQ_color , width = EQ_width )

if FIB_025_show  and not na(prev_upperFIB_025 ) and not na(anchor_bar_upperFIB_025)
    FIB_025_upperLine  := line.new(x1 = anchor_bar_upperFIB_025 , y1 = prev_upperFIB_025 , x2 = x2, y2 = prev_upperFIB_025 , color = FIB_025_color , width = FIB_025_width )
if FIB_025_show  and not na(prev_lowerFIB_025 ) and not na(anchor_bar_lowerFIB_025)
    FIB_025_lowerLine  := line.new(x1 = anchor_bar_lowerFIB_025 , y1 = prev_lowerFIB_025 , x2 = x2, y2 = prev_lowerFIB_025 , color = FIB_025_color , width = FIB_025_width )

if FIB_050_show  and not na(prev_upperFIB_050 ) and not na(anchor_bar_upperFIB_050)
    FIB_050_upperLine  := line.new(x1 = anchor_bar_upperFIB_050 , y1 = prev_upperFIB_050 , x2 = x2, y2 = prev_upperFIB_050 , color = FIB_050_color , width = FIB_050_width )
if FIB_050_show  and not na(prev_lowerFIB_050 ) and not na(anchor_bar_lowerFIB_050)
    FIB_050_lowerLine  := line.new(x1 = anchor_bar_lowerFIB_050 , y1 = prev_lowerFIB_050 , x2 = x2, y2 = prev_lowerFIB_050 , color = FIB_050_color , width = FIB_050_width )

if FIB_075_show  and not na(prev_upperFIB_075 ) and not na(anchor_bar_upperFIB_075)
    FIB_075_upperLine  := line.new(x1 = anchor_bar_upperFIB_075 , y1 = prev_upperFIB_075 , x2 = x2, y2 = prev_upperFIB_075 , color = FIB_075_color , width = FIB_075_width )
if FIB_075_show  and not na(prev_lowerFIB_075 ) and not na(anchor_bar_lowerFIB_075)
    FIB_075_lowerLine  := line.new(x1 = anchor_bar_lowerFIB_075 , y1 = prev_lowerFIB_075 , x2 = x2, y2 = prev_lowerFIB_075 , color = FIB_075_color , width = FIB_075_width )

if FIB_100_show  and not na(prev_upperFIB_100 ) and not na(anchor_bar_upperFIB_100)
    FIB_100_upperLine  := line.new(x1 = anchor_bar_upperFIB_100 , y1 = prev_upperFIB_100 , x2 = x2, y2 = prev_upperFIB_100 , color = FIB_100_color , width = FIB_100_width )
if FIB_100_show  and not na(prev_lowerFIB_100 ) and not na(anchor_bar_lowerFIB_100)
    FIB_100_lowerLine  := line.new(x1 = anchor_bar_lowerFIB_100 , y1 = prev_lowerFIB_100 , x2 = x2, y2 = prev_lowerFIB_100 , color = FIB_100_color , width = FIB_100_width )

if FIB_125_show  and not na(prev_upperFIB_125 ) and not na(anchor_bar_upperFIB_125)
    FIB_125_upperLine  := line.new(x1 = anchor_bar_upperFIB_125 , y1 = prev_upperFIB_125 , x2 = x2, y2 = prev_upperFIB_125 , color = FIB_125_color , width = FIB_125_width )
if FIB_125_show  and not na(prev_lowerFIB_125 ) and not na(anchor_bar_lowerFIB_125)
    FIB_125_lowerLine  := line.new(x1 = anchor_bar_lowerFIB_125 , y1 = prev_lowerFIB_125 , x2 = x2, y2 = prev_lowerFIB_125 , color = FIB_125_color , width = FIB_125_width )

if FIB_150_show  and not na(prev_upperFIB_150 )and not na(anchor_bar_upperFIB_150)
    FIB_150_upperLine  := line.new(x1 = anchor_bar_upperFIB_150 , y1 = prev_upperFIB_150 , x2 = x2, y2 = prev_upperFIB_150 , color = FIB_150_color , width = FIB_150_width )
if FIB_150_show  and not na(prev_lowerFIB_150 ) and not na(anchor_bar_lowerFIB_150)
    FIB_150_lowerLine  := line.new(x1 = anchor_bar_lowerFIB_150 , y1 = prev_lowerFIB_150 , x2 = x2, y2 = prev_lowerFIB_150 , color = FIB_150_color , width = FIB_150_width )

if FIB_200_show  and not na(prev_upperFIB_200 ) and not na(anchor_bar_upperFIB_200)
    FIB_200_upperLine  := line.new(x1 = anchor_bar_upperFIB_200 , y1 = prev_upperFIB_200 , x2 = x2, y2 = prev_upperFIB_200 , color = FIB_200_color , width = FIB_200_width )
if FIB_200_show  and not na(prev_lowerFIB_200 ) and not na(anchor_bar_lowerFIB_200)
    FIB_200_lowerLine  := line.new(x1 = anchor_bar_lowerFIB_200 , y1 = prev_lowerFIB_200 , x2 = x2, y2 = prev_lowerFIB_200 , color = FIB_200_color , width = FIB_200_width )

// ===  LABELS ===
var label lbl_OpenC  = na
var label lbl_OpenP  = na
var label lbl_high  = na
var label lbl_low  = na
var label lbl_eq  = na
var label lbl_upperFIB_025  = na
var label lbl_lowerFIB_025  = na
var label lbl_upperFIB_050  = na
var label lbl_lowerFIB_050  = na
var label lbl_upperFIB_075  = na
var label lbl_lowerFIB_075  = na
var label lbl_upperFIB_100  = na
var label lbl_lowerFIB_100  = na
var label lbl_upperFIB_125  = na
var label lbl_lowerFIB_125  = na
var label lbl_upperFIB_150  = na
var label lbl_lowerFIB_150  = na
var label lbl_upperFIB_200  = na
var label lbl_lowerFIB_200  = na

if barstate.islast and showlabel
    // Timeframe #1 Label

    if na(lbl_OpenC ) and OpenC_show 
        lbl_OpenC  := label.new(bar_index + extend_len + 1, prev_OpenC , "", style=label.style_label_left)
    else
        label.set_xy(lbl_OpenC , bar_index + extend_len + 1, prev_OpenC )
    label.set_text(lbl_OpenC , ("Open" + timeframe_text)) //timeframe_to_text(interval ))
    label.set_color(lbl_OpenC , showlabelbackcolor)
    label.set_textcolor(lbl_OpenC , showlabeltextcolor)
    label.set_size(lbl_OpenC , showlabelsize)
    label.set_style(lbl_OpenC , label.style_label_left)

    if na(lbl_OpenP ) and OpenP_show 
        lbl_OpenP  := label.new(bar_index + extend_len + 1, prev_OpenP , "", style=label.style_label_left)
    else
