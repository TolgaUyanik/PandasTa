//@version=5
strategy("Serhan3 - WMA + ADX + Trailing + Date Filter",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100)

//====================================================
// INPUTS
//====================================================

fastLen = input.int(11, "Hızlı WMA", minval=1)
slowLen = input.int(28, "Yavaş WMA", minval=1)

adxLen = input.int(18, "ADX Periyodu", minval=1)
adxThreshold = input.float(24.0, "ADX Eşik", step=0.1)

trailPerc = input.float(0.8, "Trailing Stop %", step=0.1) / 100

//====================================================
// DATE FILTER
//====================================================

FromMonth = input.int(1, "From Month", minval=1, maxval=12)
FromDay   = input.int(1, "From Day", minval=1, maxval=31)
FromYear  = input.int(2025, "From Year", minval=2000)

ToMonth   = input.int(12, "To Month", minval=1, maxval=12)
ToDay     = input.int(31, "To Day", minval=1, maxval=31)
ToYear    = input.int(2099, "To Year", minval=2000)

startTime = timestamp(FromYear, FromMonth, FromDay, 0, 0)
endTime   = timestamp(ToYear, ToMonth, ToDay, 23, 59)

inDateRange = time >= startTime and time <= endTime

//====================================================
// CALCULATIONS
//====================================================

fastWMA = ta.wma(close, fastLen)
slowWMA = ta.wma(close, slowLen)

[plusDI, minusDI, adxVal] = ta.dmi(adxLen, adxLen)

trendFilter = adxVal > adxThreshold

//====================================================
// ENTRY CONDITIONS
//====================================================

longCondition =
     ta.crossover(fastWMA, slowWMA) and
     close > fastWMA and
     close > slowWMA and
     trendFilter and
     inDateRange

shortCondition =
     ta.crossunder(fastWMA, slowWMA) and
     close < fastWMA and
     close < slowWMA and
     trendFilter and
     inDateRange

//====================================================
// ENTRIES
//====================================================

if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

//====================================================
// TRAILING STOP
//====================================================

if strategy.position_size > 0
    strategy.exit(
         "Exit Long",
         "Long",
         trail_points = close * trailPerc / syminfo.mintick,
         trail_offset = 0)

if strategy.position_size < 0
    strategy.exit(
         "Exit Short",
         "Short",
         trail_points = close * trailPerc / syminfo.mintick,
         trail_offset = 0)

//====================================================
// PLOTS
//====================================================

plot(fastWMA, color=color.blue, linewidth=2, title="Fast WMA")
plot(slowWMA, color=color.orange, linewidth=2, title="Slow WMA")