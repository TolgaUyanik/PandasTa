//@version=6
indicator("No Nonsense Forex Moving Averages ATR Bands[T1][T69]",overlay = true)
import Teyo69/moving_averages_library_public/1 as t69_ma
inpt_src  = input.source(defval = close,title = "Moving Average Length")
inpt_type = input.enum(t69_ma.ma_type.SMA,"Moving Average Type")
inpt_len  = input.int(29,"Moving Average Length")
inpt_atr  = input.int(14,"ATR Look Back Settings")
inpt_band_multiplier = input.int(1,"ATR Bands Multiplier")
inpt_signal_bg       = input.string("Within Range",title = "Background Signal",options = ["Within Range","Long/Short Baseline Signal"])
//============================
//Baseline Setup            ||
//============================
t69_ma.teyo_parameters t69_globals = t69_ma.new_def_teyoparams()
[baseline,return_instances] = t69_ma.get_ma_out(inpt_type,inpt_src,inpt_len,t69_globals)
t69_globals := return_instances
//============================
//ATR Bands Setup           ||
//============================
this_atr = ta.atr(inpt_atr)
upper_line = baseline + (this_atr * inpt_band_multiplier)
lower_line = baseline - (this_atr * inpt_band_multiplier)
//============================
//Visuals                   ||
//============================
//Yellow is Within tradeable range , gray is outside when the option is Within Range
//Green is Long and Red is short when the option is Long/Short Baseline Signal
color_visual = switch inpt_signal_bg
    "Within Range" =>
        close > lower_line and close < upper_line ? color.new(color.yellow,80) : color.new(color.black,80)
    "Long/Short Baseline Signal" =>
        close > baseline and (close > lower_line and close < upper_line) ? color.new(color.green,80) : close < baseline and (close > lower_line and close < upper_line) ? color.new(color.red,80) : color.new(color.black,80)
plot(baseline,title = "Baseline",color = color.maroon)
u_line_fill = plot(upper_line,title = "ATR Upper Line",color = color.navy)
l_line_fill = plot(lower_line,title = "ATR Lower Line",color = color.navy)
fill(u_line_fill,l_line_fill,color = color_visual)