//@version=6
indicator('MAEM - Structure Suite', overlay = true, max_boxes_count = 200, max_lines_count = 220, max_labels_count = 220)

// ============================================================
// MÓDULO 1: Kill Zones / Sesiones (Asia, Londres, NY)
// ============================================================
enableKillZones = input.bool(true, 'Activar Kill Zones', group = 'MAEM · Kill Zones')
tz = input.string('America/New_York', 'Zona horaria de referencia', tooltip = 'Las sesiones ICT se definen por convención en hora de Nueva York.', group = 'MAEM · Kill Zones')
showAsia = input.bool(true, 'Mostrar Asia', group = 'MAEM · Kill Zones')
sessAsia = input.session('1900-0400', 'Sesión Asia', group = 'MAEM · Kill Zones')
colAsia = input.color(color.new(color.blue, 85), 'Color Asia', group = 'MAEM · Kill Zones')
showLondon = input.bool(true, 'Mostrar Londres', group = 'MAEM · Kill Zones')
sessLondon = input.session('0200-1100', 'Sesión Londres', group = 'MAEM · Kill Zones')
colLondon = input.color(color.new(color.orange, 85), 'Color Londres', group = 'MAEM · Kill Zones')
showNY = input.bool(true, 'Mostrar Nueva York', group = 'MAEM · Kill Zones')
sessNY = input.session('0700-1600', 'Sesión NY', group = 'MAEM · Kill Zones')
colNY = input.color(color.new(color.teal, 85), 'Color NY', group = 'MAEM · Kill Zones')
showKZLabels = input.bool(true, 'Mostrar etiquetas H/L', group = 'MAEM · Kill Zones')
extendRight = input.int(10, 'Barras de extensión tras cierre de sesión', minval = 0, maxval = 200, group = 'MAEM · Kill Zones')
maxKZSessions = input.int(10, 'Máximo de sesiones visibles (por tipo)', minval = 1, maxval = 50, group = 'MAEM · Kill Zones', tooltip = 'Antes las cajas de sesión nunca se borraban y se acumulaban indefinidamente. Ahora se conservan solo las últimas N por tipo (Asia/Londres/NY).')

f_sessionBox(sessString, useSession, boxColor, nm, maxKeep) =>
    var array<box> bxs = array.new_box()
    var array<line> topLines = array.new_line()
    var array<line> botLines = array.new_line()
    var array<label> labels = array.new_label()
    var float hi = na
    var float lo = na

    inSess = useSession and not na(time(timeframe.period, sessString, tz))
    newSess = inSess and not inSess[1]
    endSess = not inSess and inSess[1]

    if newSess
        hi := high
        lo := low
        array.push(bxs, box.new(bar_index, high, bar_index, low, border_color = color.new(boxColor, 40), bgcolor = boxColor, extend = extend.none))
        array.push(topLines, line.new(bar_index, high, bar_index, high, color = color.new(boxColor, 20), width = 1))
        array.push(botLines, line.new(bar_index, low, bar_index, low, color = color.new(boxColor, 20), width = 1))
        if array.size(bxs) > maxKeep
            box.delete(array.shift(bxs))
            line.delete(array.shift(topLines))
            line.delete(array.shift(botLines))

    if inSess and array.size(bxs) > 0
        hi := math.max(hi, high)
        lo := math.min(lo, low)
        curBx = array.get(bxs, array.size(bxs) - 1)
        curTop = array.get(topLines, array.size(topLines) - 1)
        curBot = array.get(botLines, array.size(botLines) - 1)
        box.set_top(curBx, hi)
        box.set_bottom(curBx, lo)
        box.set_right(curBx, bar_index)
        line.set_x2(curTop, bar_index)
        line.set_y1(curTop, hi)
        line.set_y2(curTop, hi)
        line.set_x2(curBot, bar_index)
        line.set_y1(curBot, lo)
        line.set_y2(curBot, lo)

    if endSess and array.size(bxs) > 0
        curBx = array.get(bxs, array.size(bxs) - 1)
        curTop = array.get(topLines, array.size(topLines) - 1)
        curBot = array.get(botLines, array.size(botLines) - 1)
        box.set_right(curBx, bar_index + extendRight)
        line.set_x2(curTop, bar_index + extendRight)
        line.set_x2(curBot, bar_index + extendRight)
        if showKZLabels
            array.push(labels, label.new(bar_index, hi, nm + ' H', style = label.style_label_down, color = color.new(boxColor, 0), textcolor = color.white, size = size.tiny))
            array.push(labels, label.new(bar_index, lo, nm + ' L', style = label.style_label_up, color = color.new(boxColor, 0), textcolor = color.white, size = size.tiny))
            if array.size(labels) > maxKeep * 2
                label.delete(array.shift(labels))
                label.delete(array.shift(labels))

if enableKillZones
    f_sessionBox(sessAsia, showAsia, colAsia, 'Asia', maxKZSessions)
    f_sessionBox(sessLondon, showLondon, colLondon, 'Londres', maxKZSessions)
    f_sessionBox(sessNY, showNY, colNY, 'NY', maxKZSessions)

// ============================================================
// MÓDULO 2: Smart Money Concepts (BOS / CHoCH / Order Blocks / FVG)
// ============================================================
enableSMC = input.bool(true, 'Activar SMC', group = 'MAEM · SMC')
swingLen = input.int(8, 'Barras para confirmar swing (izq = der)', minval = 1, group = 'MAEM · SMC', tooltip = '5 era el default original, calibrado para M15. En H1/H4 (tu timeframe actual) 5 marca BOS por cada micro-swing; 7-10 es más estable. Ajustado a 8.')
showBOS = input.bool(true, 'Mostrar BOS', group = 'MAEM · SMC')
showCHOCH = input.bool(true, 'Mostrar CHoCH', group = 'MAEM · SMC')
showOB = input.bool(true, 'Mostrar Order Blocks', group = 'MAEM · SMC - Order Blocks')
obLookback = input.int(15, 'Velas hacia atrás para buscar el OB', minval = 3, maxval = 30, group = 'MAEM · SMC - Order Blocks')
obExtend = input.int(20, 'Extensión OB (barras)', minval = 1, group = 'MAEM · SMC - Order Blocks')
mitigateOB = input.bool(true, 'Ocultar OB al mitigarse', group = 'MAEM · SMC - Order Blocks')
maxOB = input.int(15, 'Máximo de OB visibles', minval = 1, maxval = 40, group = 'MAEM · SMC - Order Blocks')
showFVG = input.bool(true, 'Mostrar Fair Value Gaps', group = 'MAEM · SMC - FVG')
fvgExtend = input.int(20, 'Extensión FVG (barras)', minval = 1, group = 'MAEM · SMC - FVG')
mitigateFVG = input.bool(true, 'Ocultar FVG al mitigarse', group = 'MAEM · SMC - FVG')
maxFVG = input.int(15, 'Máximo de FVG visibles', minval = 1, maxval = 40, group = 'MAEM · SMC - FVG')

colBullBOS = color.new(color.teal, 0)
colBearBOS = color.new(color.red, 0)
colBullCHOCH = color.new(color.lime, 0)
colBearCHOCH = color.new(color.orange, 0)
colBullOB = color.new(color.teal, 80)
colBearOB = color.new(color.red, 80)
colBullFVG = color.new(color.blue, 85)
colBearFVG = color.new(color.purple, 85)

swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var string trend = 'NONE'
var float lastBrokenHigh = na
var float lastBrokenLow = na

if not na(swH)
    lastSwingHigh := swH
    lastSwingHighBar := bar_index - swingLen
    lastSwingHighBar
if not na(swL)
    lastSwingLow := swL
    lastSwingLowBar := bar_index - swingLen
    lastSwingLowBar

bullBreak = enableSMC and not na(lastSwingHigh) and close > lastSwingHigh and lastSwingHigh != lastBrokenHigh
bearBreak = enableSMC and not na(lastSwingLow) and close < lastSwingLow and lastSwingLow != lastBrokenLow

if bullBreak
    isCHoCH = trend == 'DOWN'
    doShow = isCHoCH ? showCHOCH : showBOS
    lblCol = isCHoCH ? colBullCHOCH : colBullBOS
    if doShow
        line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color = lblCol, width = 2, style = line.style_dashed)
        label.new(bar_index, lastSwingHigh, isCHoCH ? 'CHoCH' : 'BOS', style = label.style_label_down, color = color.new(lblCol, 0), textcolor = color.white, size = size.tiny)
    trend := 'UP'
    lastBrokenHigh := lastSwingHigh
    lastBrokenHigh

if bearBreak
    isCHoCH = trend == 'UP'
    doShow = isCHoCH ? showCHOCH : showBOS
    lblCol = isCHoCH ? colBearCHOCH : colBearBOS
    if doShow
        line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color = lblCol, width = 2, style = line.style_dashed)
        label.new(bar_index, lastSwingLow, isCHoCH ? 'CHoCH' : 'BOS', style = label.style_label_up, color = color.new(lblCol, 0), textcolor = color.white, size = size.tiny)
    trend := 'DOWN'
    lastBrokenLow := lastSwingLow
    lastBrokenLow

var array<box> bullOBs = array.new_box()
var array<box> bearOBs = array.new_box()

if showOB and bullBreak
    for i = 1 to obLookback by 1
        if close[i] < open[i]
            if array.size(bullOBs) >= maxOB
                box.delete(array.get(bullOBs, 0))
                array.remove(bullOBs, 0)
            array.push(bullOBs, box.new(bar_index - i, high[i], bar_index + obExtend, low[i], border_color = color.new(colBullOB, 40), bgcolor = colBullOB, extend = extend.none))
            break

if showOB and bearBreak
    for i = 1 to obLookback by 1
        if close[i] > open[i]
            if array.size(bearOBs) >= maxOB
                box.delete(array.get(bearOBs, 0))
                array.remove(bearOBs, 0)
            array.push(bearOBs, box.new(bar_index - i, high[i], bar_index + obExtend, low[i], border_color = color.new(colBearOB, 40), bgcolor = colBearOB, extend = extend.none))
            break

if mitigateOB
    idxOB = array.size(bullOBs) - 1
    while idxOB >= 0
        bx = array.get(bullOBs, idxOB)
        if low <= box.get_top(bx)
            box.delete(bx)
            array.remove(bullOBs, idxOB)
        idxOB := idxOB - 1
        idxOB

if mitigateOB
    idxOB2 = array.size(bearOBs) - 1
    while idxOB2 >= 0
        bx = array.get(bearOBs, idxOB2)
        if high >= box.get_bottom(bx)
            box.delete(bx)
            array.remove(bearOBs, idxOB2)
        idxOB2 := idxOB2 - 1
        idxOB2

bullFVG = enableSMC and low > high[2]
bearFVG = enableSMC and high < low[2]

var array<box> bullFVGs = array.new_box()
var array<box> bearFVGs = array.new_box()

if showFVG and bullFVG
    if array.size(bullFVGs) >= maxFVG
        box.delete(array.get(bullFVGs, 0))
        array.remove(bullFVGs, 0)
    array.push(bullFVGs, box.new(bar_index - 2, low, bar_index + fvgExtend, high[2], border_color = color.new(colBullFVG, 40), bgcolor = colBullFVG, extend = extend.none))

if showFVG and bearFVG
    if array.size(bearFVGs) >= maxFVG
        box.delete(array.get(bearFVGs, 0))
        array.remove(bearFVGs, 0)
    array.push(bearFVGs, box.new(bar_index - 2, low[2], bar_index + fvgExtend, high, border_color = color.new(colBearFVG, 40), bgcolor = colBearFVG, extend = extend.none))

if mitigateFVG
    idxFVG = array.size(bullFVGs) - 1
    while idxFVG >= 0
        bx = array.get(bullFVGs, idxFVG)
        if low <= box.get_bottom(bx)
            box.delete(bx)
            array.remove(bullFVGs, idxFVG)
        idxFVG := idxFVG - 1
        idxFVG

if mitigateFVG
    idxFVG2 = array.size(bearFVGs) - 1
    while idxFVG2 >= 0
        bx = array.get(bearFVGs, idxFVG2)
        if high >= box.get_top(bx)
            box.delete(bx)
            array.remove(bearFVGs, idxFVG2)
        idxFVG2 := idxFVG2 - 1
        idxFVG2

// ============================================================
// MÓDULO 3: PDH/PDL + Pivot Points estándar
// ============================================================
enablePDHPivots = input.bool(true, 'Activar PDH/PDL + Pivotes', group = 'MAEM · PDH-PDL')
showPDHL = input.bool(true, 'Mostrar PDH/PDL', group = 'MAEM · PDH-PDL')
showPivots = input.bool(true, 'Mostrar Pivot Points estándar', group = 'MAEM · PDH-PDL')
showR3S3 = input.bool(false, 'Mostrar R3/S3', group = 'MAEM · PDH-PDL')
extendLine = input.bool(true, 'Extender líneas a la derecha', group = 'MAEM · PDH-PDL')
lineWidth = input.int(1, 'Grosor de línea', minval = 1, maxval = 4, group = 'MAEM · PDH-PDL')

[pdh, pdl, pdc] = request.security(syminfo.tickerid, 'D', [high[1], low[1], close[1]], lookahead = barmerge.lookahead_off)

pp = (pdh + pdl + pdc) / 3
r1 = 2 * pp - pdl
s1 = 2 * pp - pdh
r2 = pp + pdh - pdl
s2 = pp - (pdh - pdl)
r3 = pdh + 2 * (pp - pdl)
s3 = pdl - 2 * (pdh - pp)

newDay = ta.change(time('D')) != 0

f_line(y, col, sty, txt) =>
    var line ln = na
    var label la = na
    ext = extendLine ? extend.right : extend.none
    if newDay
        line.delete(ln)
        label.delete(la)
        ln := line.new(bar_index, y, bar_index + 1, y, extend = ext, color = col, width = lineWidth, style = sty)
        la := label.new(bar_index, y, txt, style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.tiny)
        la
    else
        line.set_y1(ln, y)
        line.set_y2(ln, y)
        if not extendLine
            line.set_x2(ln, bar_index)
        label.set_y(la, y)
        label.set_x(la, bar_index)
    [ln, la]

if enablePDHPivots
    if showPDHL
        f_line(pdh, color.new(color.blue, 0), line.style_solid, 'PDH ' + str.tostring(pdh, format.mintick))
        f_line(pdl, color.new(color.blue, 0), line.style_solid, 'PDL ' + str.tostring(pdl, format.mintick))

    if showPivots
        f_line(pp, color.new(color.gray, 0), line.style_dashed, 'P ' + str.tostring(pp, format.mintick))
        f_line(r1, color.new(color.red, 0), line.style_dotted, 'R1 ' + str.tostring(r1, format.mintick))
        f_line(s1, color.new(color.teal, 0), line.style_dotted, 'S1 ' + str.tostring(s1, format.mintick))
        f_line(r2, color.new(color.red, 0), line.style_dotted, 'R2 ' + str.tostring(r2, format.mintick))
        f_line(s2, color.new(color.teal, 0), line.style_dotted, 'S2 ' + str.tostring(s2, format.mintick))
        if showR3S3
            f_line(r3, color.new(color.red, 0), line.style_dotted, 'R3 ' + str.tostring(r3, format.mintick))
            f_line(s3, color.new(color.teal, 0), line.style_dotted, 'S3 ' + str.tostring(s3, format.mintick))
