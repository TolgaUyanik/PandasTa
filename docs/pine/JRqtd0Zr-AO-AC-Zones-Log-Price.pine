//@version=5
indicator("Log‑Scaled AO/AC Zones", overlay=true)

// ───── INPUTS ─────
fastLen = input.int(5,  "Fast SMA length (AO)")
slowLen = input.int(34, "Slow SMA length (AO)")
accLen  = input.int(5,  "SMA length (AC)", minval=1)
showPct = input.bool(true, "Display AO/AC as % of price")
logBase = input.string("Natural (ln)", "Logarithm base", ["Natural (ln)", "Base-10 (log10)"])

// ───── LOG PRICE ─────
medianPrice = (high + low) / 2.0
logPrice    = logBase == "Natural (ln)" ? math.log(medianPrice) : math.log10(medianPrice)

// ───── LOG AO & AC ─────
fastMA = ta.sma(logPrice, fastLen)
slowMA = ta.sma(logPrice, slowLen)
aoLog  = fastMA - slowMA
aoPct  = (math.exp(fastMA) - math.exp(slowMA)) / math.exp(slowMA) * 100.0
ao     = showPct ? aoPct : aoLog
ac     = ao - ta.sma(ao, accLen)

// ───── ZONE LOGIC ─────
isGreen = ao > ao[1] and ac > ac[1]
isRed   = ao < ao[1] and ac < ac[1]
isGrey  = ao > ao[1] and ac < ac[1]
isGray  = ao < ao[1] and ac > ac[1]

// ───── COLORS & BAR‑PAINTING ─────
upCol   = color.rgb(38,166,154)
downCol = color.rgb(239,83,80)
barcolor(isGrey or isGray ? color.gray : isGreen ? upCol : isRed ? downCol : na)
