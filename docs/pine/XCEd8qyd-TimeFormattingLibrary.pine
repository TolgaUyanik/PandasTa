//@version=5

// @description time formatting functions
library("TimeFormattingLibrary", overlay = true)

// @function converts time into readable format
// @param showDayOfWeek if you want to show day of week (i.e. Mon, Tues etc) 
// @param showDayOfMonth if you want to show day number of month with superscript ordinals (i.e. 1ˢᵗ, 2ⁿᵈ, etc)
// @param showMonth if you want to show the month (i.e. Jan, Feb, etc)
// @param showYear if you want to show the year (i.e. 2023)
// @param showHrMin if you want to show time in 24hr clock format
// @param _time is the unix time (i.e. time or time_close)
// @param _timezone the user timezone input as string (e.g. "America/New_York", "UTC-5", "GMT+0530")
// @returns time date string
export timeFormatFxn(bool showDayOfWeek, bool showDayOfMonth, bool showMonth, bool showYear, bool showHrMin, int _time,  string _timezone)=>
    int _DoW = dayofweek(_time, _timezone)
    string DoW = _DoW == 1?"Sun":_DoW == 2?"Mon":_DoW == 3?"Tues":_DoW == 4?"Weds":_DoW == 5?"Thurs":_DoW == 6?"Fri":_DoW == 7?"Sat":na
    _dayNo = str.format_time(_time, "dd", _timezone)
    dayNo = str.startswith(_dayNo, "0")? str.substring(_dayNo,1):_dayNo
    var string superScript = na
    if str.length(dayNo) == 1
        superScript := str.endswith(dayNo, "1")?"ˢᵗ":str.endswith(dayNo, "2")?"ⁿᵈ":str.endswith(dayNo, "3")?"ʳᵈ":"ᵗʰ"
    if str.length(dayNo) == 2 and str.startswith(dayNo, "1")
        superScript :="ᵗʰ"
    if str.length(dayNo)==2 and str.startswith(dayNo, "2")
        superScript := str.endswith(dayNo, "1")?"ˢᵗ":str.endswith(dayNo, "2")?"ⁿᵈ":str.endswith(dayNo, "3")?"ʳᵈ":"ᵗʰ"
    if str.length(dayNo)==2 and str.startswith(dayNo, "3")
        superScript:= str.endswith(dayNo, "1")?"ˢᵗ":"ᵗʰ"
    int _month = month(_time, _timezone)
    string Month = _month == 1?"Jan":_month == 2?"Feb":_month == 3?"Mar":_month == 4?"Apr":_month == 5?"May":_month == 6?"Jun":_month == 7?"Jul":_month == 8?"Aug":_month == 9?"Sept":_month == 10?"Oct":_month == 11?"Nov":_month == 12?"Dec":na
    string Year = "'"+str.format_time(_time, "yy", _timezone)
    hrMin = str.format_time(_time, "HH:mm", _timezone)
    result = (showDayOfWeek?DoW+" ":"") + (showDayOfMonth?dayNo+ superScript+" ":"") +(showMonth?Month+" ":"") +(showYear?Year+" ":"") +(showHrMin?hrMin:"")


// @function converts timespan into readable format
// @param timespan is the length of time in milliseconds to be converted into a human readable string
// @returns timespan string (whether it be a for showing 'time-elapsed' or for showing a 'countdown timer')
export timeElapsedFxn(int timespan)=>
    totSeconds = int(math.abs(timespan/1000))
    totMins = int((totSeconds-totSeconds % 60)/60)
    totHrs = int((totMins-totMins%60)/60)
    totDays = int((totHrs-totHrs%24)/24)
    totWeeks = int((totDays-totDays%7)/7)
    totMonths= int((totDays-totDays%30.44)/30.44)
    mins = int(totMins%60)
    hrs = int(totHrs%24)
    days = int(totDays%7)
    weeks = int((totDays%30.44)/7)
    var string timestring = na
    if totMonths>0
        timestring:= str.tostring(totMonths) + " months " + (weeks>0?str.tostring(weeks, "##")+ " weeks ":"") + (days>0?str.tostring(days, "##")+ " days ":"") + (hrs>0?str.tostring(hrs, "##") + " hrs ":"")+(mins>0?str.tostring(mins, "##") +" mins":"")
    if totMonths ==0 and totWeeks>0
        timestring:= str.tostring(totWeeks)+ " weeks " + (days>0? str.tostring(days, '##')+ " days ":"") +(hrs>0?str.tostring(hrs, "##") + " hrs ":"") + (mins>0?str.tostring(mins, "##") +" mins":"")
    if totMonths ==0 and totWeeks ==0 and totDays>0
        timestring:= str.tostring(totDays) + " days " +(hrs>0?str.tostring(hrs, "##") + " hrs ":"") + (mins>0?str.tostring(mins, "##") +" mins":"")
    if totMonths ==0 and totWeeks ==0 and totDays ==0
        timestring:= str.tostring(totHrs) + " hrs " + (mins>0?str.tostring(mins, "##") +" mins":"")
    if totMonths ==0 and totWeeks ==0 and totDays ==0 and totHrs ==0
        timestring:= str.tostring(totMins) + " mins"
    if timespan <=0
        timestring:= "NaN"
    timestring

// @function gives bool result for when first occurence in month of the day-of-week input
// @param _dayofweek (can be integer 1-7 or can be dayofweek variable; i.e. dayofweek.wednesday)
export isFirstXdayofmonth(int _dayofweek)=>
    seven_days = 7*24*3600*1000
    result = (dayofweek(time) == _dayofweek and month(time - seven_days) != month(time))
	
// @function gives bool result for when last occurence in month of the day-of-week input
// @param _dayofweek (can be integer 1-7 or can be dayofweek variable; i.e. dayofweek.wednesday)
export isLastXdayofmonth(int _dayofweek)=>
    seven_days = 7*24*3600*1000
    result = (dayofweek(time) == _dayofweek and month(time + seven_days) != month(time))

// @function gives bool result for if yesterday was a bank holiday monday. Only for use with with request.security() function, see example code below
export wasBankHolidayMonday()=>
    var bool result = na
    if dayofweek != dayofweek[1] and dayofweek == dayofweek.tuesday and dayofweek[1] != dayofweek.monday
        result:= true


//// ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//// ~~~~~~~~ EXAMPLE CODE ~~~~~~~~~~
//// ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

monthStartTime = request.security(syminfo.tickerid, "M", time)
if barstate.islast
    line.new(monthStartTime, high, monthStartTime, high+1, xloc = xloc.bar_time, extend = extend.both)

// ~~~ Example code 1: show the last 3 weekly opening prices; lines and labels
var array<label>labOp = array.new<label>(na), var array<line>lnOp = array.new<line>(na)
if timeframe.change("W")
    lnOp.push(line.new(bar_index, open, last_bar_index, open))
    labOp.push(label.new(last_bar_index, open, timeFormatFxn(true, true, true, true, true, time, "America/New_York"), textcolor = color.red, color = color(na), style = label.style_label_left))
if lnOp.size()>3
    line.delete(lnOp.shift())
    label.delete(labOp.shift())

// ~~~ Example code 2: Time elapsed since start of 2023 2nd quarter (April 1st 2023)
startDate = timestamp("01 Apr 2023 00:00:00 GMT-4")
elapsedTime = last_bar_time - startDate
var table Table = table.new(position.middle_right, 2,1)
table.cell(Table, 0,0, "Since start of 2nd Quarter:")
table.cell(Table, 1,0, timeElapsedFxn(elapsedTime), text_color = color.red)

// ~~~ Example code 3: first weds of month, last tuesday of month
firstWeds = isFirstXdayofmonth(dayofweek.wednesday)
var array<label> labArr1 = array.new<label>(na), var array<label> labArr2 = array.new<label>(na)
if firstWeds and not firstWeds[1]
    labArr1.push(label.new(bar_index-1, high, "first\nWeds\nof\nmonth\nv", color = color(na),yloc = yloc.abovebar, textcolor = color.blue))
    if labArr1.size()>2
        label.delete(labArr1.shift())
lastTues = isLastXdayofmonth(dayofweek.tuesday)
if lastTues and not lastTues[1]
    labArr2.push(label.new(bar_index-1, high, "last\nTues\nof\nmonth\nv", color = color(na), yloc = yloc.abovebar, textcolor = color.blue))
    if labArr2.size()>2
        label.delete(labArr2.shift())

// ~~~ Example code 4: show historical bank holiday Mondays
var array<label> labArr3 = array.new<label>(na)
wasBnkHolMon = request.security(syminfo.tickerid, "D", wasBankHolidayMonday(), lookahead = barmerge.lookahead_on)
if wasBnkHolMon and not wasBnkHolMon[1]
    labArr3.push(label.new(bar_index-1, low, "<\nbank\nhol\nMon", yloc = yloc.belowbar, color = color(na), textcolor = color.red))
    if labArr3.size()>15
        label.delete(labArr3.shift())