//@version=5
strategy("EB ICT One Trade Setup For Life - Sniper 70 Model v5",
     overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=0.5,
     commission_type=strategy.commission.percent,
     commission_value=0.01,
     max_labels_count=500,
     max_boxes_count=500)

// Inputs
riskRR          = input.float(1.25, "Risk Reward", step=0.25)
minScore        = input.float(85.0, "Minimum Entry Score", step=5)

emaFastLen      = input.int(50, "EMA 50")
emaSlowLen      = input.int(200, "EMA 200")
htfTF           = input.timeframe("240", "HTF Bias Timeframe")
htfEmaLen       = input.int(50, "HTF EMA")

swingLen        = input.int(5, "Swing Length")
atrLen          = input.int(14, "ATR Length")
slAtrBuffer     = input.float(0.35, "SL ATR Buffer", step=0.05)
maxBarsSetup    = input.int(60, "Max Bars After Sweep")

useNYOnly       = input.bool(false, "NY Only")
londonSession   = input.session("0700-1200", "London KZ")
nySession       = input.session("1300-2000", "NY KZ")

showLabels      = input.bool(true, "Show Labels")
showZones       = input.bool(true, "Show Zones")

// Sessions
inLondon = not na(time(timeframe.period, londonSession))
inNY     = not na(time(timeframe.period, nySession))
sessionOK = useNYOnly ? inNY : (inLondon or inNY)

// Trend
ema50 = ta.ema(close, emaFastLen)
ema200 = ta.ema(close, emaSlowLen)
htfEMA = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen))
atr = ta.atr(atrLen)

bullTrend = close > ema50 and ema50 > ema200
bearTrend = close < ema50 and ema50 < ema200

htfBull = close > htfEMA
htfBear = close < htfEMA

// Swings
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh = na
var float lastLow = na

if not na(ph)
    lastHigh := ph

if not na(pl)
    lastLow := pl

// Sweep
buySweep  = sessionOK and not na(lastLow) and low < lastLow and close > lastLow
sellSweep = sessionOK and not na(lastHigh) and high > lastHigh and close < lastHigh

var int dir = 0
var bool sweepFound = false
var bool dispFound = false
var bool fvgFound = false
var bool mssFound = false
var bool bosFound = false
var bool traded = false

var float sweepLevel = na
var int sweepBar = na

var float fvgTop = na
var float fvgBot = na
var int fvgBar = na

if buySweep
    dir := 1
    sweepFound := true
    dispFound := false
    fvgFound := false
    mssFound := false
    bosFound := false
    traded := false
    sweepLevel := low
    sweepBar := bar_index

if sellSweep
    dir := -1
    sweepFound := true
    dispFound := false
    fvgFound := false
    mssFound := false
    bosFound := false
    traded := false
    sweepLevel := high
    sweepBar := bar_index

setupAlive = sweepFound and bar_index - sweepBar <= maxBarsSetup

// Displacement
body = math.abs(close - open)
avgBody = ta.sma(math.abs(close - open), 20)

bullDisp = setupAlive and dir == 1 and close > open and body > avgBody * 1.6 and close > high[1]
bearDisp = setupAlive and dir == -1 and close < open and body > avgBody * 1.6 and close < low[1]

if bullDisp or bearDisp
    dispFound := true

// FVG
bullFVG = dispFound and dir == 1 and low > high[2]
bearFVG = dispFound and dir == -1 and high < low[2]

if bullFVG
    fvgTop := low
    fvgBot := high[2]
    fvgBar := bar_index
    fvgFound := true

if bearFVG
    fvgTop := low[2]
    fvgBot := high
    fvgBar := bar_index
    fvgFound := true

fvgMid = (fvgTop + fvgBot) / 2
fvgActive = fvgFound and bar_index - fvgBar <= 35

// MSS / BOS
bullMSS = setupAlive and dir == 1 and close > ta.highest(high, 8)[1]
bearMSS = setupAlive and dir == -1 and close < ta.lowest(low, 8)[1]

if bullMSS or bearMSS
    mssFound := true

bullBOS = setupAlive and dir == 1 and mssFound and close > ta.highest(high, 14)[1]
bearBOS = setupAlive and dir == -1 and mssFound and close < ta.lowest(low, 14)[1]

if bullBOS or bearBOS
    bosFound := true

// Retest
bullRetest = fvgActive and dir == 1 and low <= fvgTop and close > fvgBot
bearRetest = fvgActive and dir == -1 and high >= fvgBot and close < fvgTop

deepBullRetest = fvgActive and dir == 1 and low <= fvgMid and close > fvgBot
deepBearRetest = fvgActive and dir == -1 and high >= fvgMid and close < fvgTop

// Rejection
bullReject = close > open and close > close[1]
bearReject = close < open and close < close[1]

// Score
score = 0.0
score += sweepFound ? 25 : 0
score += dispFound ? 20 : 0
score += fvgFound ? 10 : 0
score += mssFound ? 20 : 0
score += bosFound ? 15 : 0
score += (deepBullRetest or deepBearRetest) ? 10 : (bullRetest or bearRetest) ? 5 : 0

// Main signals
buySignal =
     score >= minScore and
     dir == 1 and
     htfBull and
     bullTrend and
     mssFound and
     bosFound and
     bullRetest and
     bullReject

sellSignal =
     score >= minScore and
     dir == -1 and
     htfBear and
     bearTrend and
     mssFound and
     bosFound and
     bearRetest and
     bearReject

// SL / TP
buySL = math.min(sweepLevel, low) - atr * slAtrBuffer
sellSL = math.max(sweepLevel, high) + atr * slAtrBuffer

buyRisk = close - buySL
sellRisk = sellSL - close

buyTP = close + buyRisk * riskRR
sellTP = close - sellRisk * riskRR

if buySignal and not traded and buyRisk > syminfo.mintick
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY EXIT", "BUY", stop=buySL, limit=buyTP)
    traded := true

if sellSignal and not traded and sellRisk > syminfo.mintick
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL EXIT", "SELL", stop=sellSL, limit=sellTP)
    traded := true

// Visuals
plot(ema50, "EMA 50", color=color.orange)
plot(ema200, "EMA 200", color=color.gray)
plot(htfEMA, "HTF EMA", color=color.blue)

if showLabels and buySweep
    label.new(bar_index, low, "BUY SWEEP", style=label.style_label_up, color=color.green, textcolor=color.white)

if showLabels and sellSweep
    label.new(bar_index, high, "SELL SWEEP", style=label.style_label_down, color=color.red, textcolor=color.white)

if showLabels and buySignal
    label.new(bar_index, low, "BUY A+\n" + str.tostring(score), style=label.style_label_up, color=color.lime, textcolor=color.black)

if showLabels and sellSignal
    label.new(bar_index, high, "SELL A+\n" + str.tostring(score), style=label.style_label_down, color=color.red, textcolor=color.white)

if showZones and fvgFound and bar_index == fvgBar
    box.new(bar_index, fvgTop, bar_index + 35, fvgBot, bgcolor=color.new(color.gray, 80), border_color=color.gray)

// Dashboard
var table dash = table.new(position.top_right, 2, 8, border_width=1)

if barstate.islast
    table.cell(dash, 0, 0, "EB ICT SNIPER", text_color=color.white, bgcolor=color.blue)
    table.cell(dash, 1, 0, "v5", text_color=color.white, bgcolor=color.blue)
    table.cell(dash, 0, 1, "Direction")
    table.cell(dash, 1, 1, dir == 1 ? "BUY" : dir == -1 ? "SELL" : "NONE")
    table.cell(dash, 0, 2, "Score")
    table.cell(dash, 1, 2, str.tostring(score))
    table.cell(dash, 0, 3, "Sweep")
    table.cell(dash, 1, 3, sweepFound ? "YES" : "NO")
    table.cell(dash, 0, 4, "Disp/FVG")
    table.cell(dash, 1, 4, (dispFound ? "D " : "") + (fvgFound ? "FVG" : ""))
    table.cell(dash, 0, 5, "MSS/BOS")
    table.cell(dash, 1, 5, (mssFound ? "MSS " : "") + (bosFound ? "BOS" : ""))
    table.cell(dash, 0, 6, "HTF Bias")
    table.cell(dash, 1, 6, htfBull ? "BULL" : htfBear ? "BEAR" : "NEUTRAL")
    table.cell(dash, 0, 7, "Session")
    table.cell(dash, 1, 7, inNY ? "NY" : inLondon ? "LDN" : "CLOSED")