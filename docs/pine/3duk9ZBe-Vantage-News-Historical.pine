//@version=6
// @description Historical news calendar data library for Pine Script strategies (2023–2024).
// Exports a single function that returns five parallel arrays of news event data:
// dates, times (milliseconds from midnight), type IDs, exception severity overrides,
// and exception delay minutes. 2023 and 2024 H1/H2 data includes elevated severity
// overrides reflecting the high-volatility macro environment of those periods.
// Designed as a data-only dependency — import alongside Vantage_NewsTypes to resolve
// type IDs to event names and default severities.
library("Vantage_News_Historical", overlay=false)
import Vantage-Stack/Vantage_News_Types/1 as nt

// ─────────────────────────────────────────────────────────────────────────
// USAGE — same shape as Vantage_News; returns five parallel arrays of
// news rows for 2023–2024. Intended to be imported alongside the current
// (Vantage_News) library so backtests can span both periods.
// ─────────────────────────────────────────────────────────────────────────
//
//   import Vantage-Stack/Vantage_News_Historical/<version> as hist
//   import Vantage-Stack/Vantage_News/<version>            as packed
//
//   [hDates, hTimes, hTypes, hExcSevs, hExcDelays] = hist.LoadNewsRows()
//   [pDates, pTimes, pTypes, pExcSevs, pExcDelays] = packed.LoadNewsRows()
//
//   // Concatenate to cover 2023–current:
//   dates = array.concat(hDates, pDates)
//   times = array.concat(hTimes, pTimes)
//   // ... etc
//
// ─────────────────────────────────────────────────────────────────────────

// Historical news data library: 2023 + 2024.
// Data stored as parallel array.from() literals (dates, timesMS, typeIds).
// Times are pre-computed milliseconds. No runtime string parsing.
// Type IDs reference Vantage_NewsTypes constants.
//
// Returns 5 parallel arrays: [dates, timesMS, typeIds, excSevs, excDelayMins]
// Exception overrides are date-scoped:
//   year 2023                           -> 21 types bumped to sev 3, 0 min delay
//   year 2024, month < 7               -> 2024 H1 overrides, 60 min delay
//   year 2024, month >= 7              -> 2024 H2 overrides, 60 min delay

// ── 2023 Data (chunks 0-6) ──
