//@version=6
indicator(
     "XRS Pro Auto Anchored VWAP + SFP Reversals Alerts + EMA/SMA",
     shorttitle="XRS VWAP / SFP Detector",
     overlay=true,
     max_lines_count=100,
     max_labels_count=500)

grpTime = "Time and Sessions"

tz = input.string("America/New_York", "Time zone", group=grpTime)

nySession = input.session(
     "0930-1759",
     "New York session",
     group=grpTime,
     tooltip="The NY VWAP resets at the first bar of this session. Default: 09:30-17:59 New York time.")

asiaSession = input.session(
     "1800-0929",
     "Asia / overnight session",
     group=grpTime,
     tooltip="The Asia VWAP resets at the first bar of this session. Default: 18:00-09:29 New York time.")

weeklyResetMode = input.string(
     "Sunday 18:00 NY",
     "Weekly VWAP reset",
     options=["Sunday 18:00 NY", "TradingView week"],
     group=grpTime)

useHighResAnchors = input.bool(
     true,
     "Anchor VWAPs to 1-minute data",
     group=grpTime,
     tooltip="When enabled, the New York, Asia, Weekly, and Monthly VWAPs all reset and accumulate using true 1-minute bars, so they anchor precisely, e.g. exactly at 09:30 NY, regardless of your chart's timeframe. Automatically falls back to the chart's own timeframe wherever 1-minute history isn't available. Disable to always use the chart's own timeframe.")

grpGeneral = "General"

srcOption = input.string(
     "HLC3",
     "VWAP source",
     options=["HLC3", "Close"],
     group=grpGeneral)

showNY = input.bool(true, "Show New York VWAP", group=grpGeneral)
showAsia = input.bool(true, "Show Asia VWAP", group=grpGeneral)
showWeekly = input.bool(true, "Show Weekly VWAP", group=grpGeneral)
showMonthly = input.bool(true, "Show Monthly VWAP", group=grpGeneral)

//──────────────────────────────────────────────────────────────────────────────
// Optional moving averages
//──────────────────────────────────────────────────────────────────────────────
grpMA = "Optional Moving Averages"

showEMA9 = input.bool(false, "Show EMA 9", group=grpMA)
showEMA21 = input.bool(false, "Show EMA 21", group=grpMA)
showEMA50 = input.bool(false, "Show EMA 50", group=grpMA)
showEMA100 = input.bool(false, "Show EMA 100", group=grpMA)
showSMA50 = input.bool(false, "Show SMA 50", group=grpMA)
showSMA200 = input.bool(false, "Show SMA 200", group=grpMA)

ema9Color = input.color(color.rgb(0, 235, 255), "EMA 9 color", group=grpMA)
ema21Color = input.color(color.rgb(255, 230, 40), "EMA 21 color", group=grpMA)
ema50Color = input.color(color.rgb(255, 150, 35), "EMA 50 color", group=grpMA)
ema100Color = input.color(color.rgb(255, 80, 80), "EMA 100 color", group=grpMA)
sma50Color = input.color(color.rgb(245, 245, 245), "SMA 50 color", group=grpMA)
sma200Color = input.color(color.rgb(180, 90, 255), "SMA 200 color", group=grpMA)

ema9Width = input.int(2, "EMA 9 thickness", minval=1, maxval=5, group=grpMA)
ema21Width = input.int(2, "EMA 21 thickness", minval=1, maxval=5, group=grpMA)
ema50Width = input.int(2, "EMA 50 thickness", minval=1, maxval=5, group=grpMA)
ema100Width = input.int(2, "EMA 100 thickness", minval=1, maxval=5, group=grpMA)
sma50Width = input.int(2, "SMA 50 thickness", minval=1, maxval=5, group=grpMA)
sma200Width = input.int(2, "SMA 200 thickness", minval=1, maxval=5, group=grpMA)


//──────────────────────────────────────────────────────────────────────────────
// VWAP / Band SFP Signals
//──────────────────────────────────────────────────────────────────────────────
grpSFP = "VWAP / Band SFP Signals"

enableSFPSignals = input.bool(true, "Enable VWAP and band SFP signals", group=grpSFP)
sfpSwingLength = input.int(5, "SFP swing length", minval=1, maxval=50, group=grpSFP)
// Market-aware proximity scaling.
// Each default is intended to represent roughly the same practical proximity
// as 5 NQ points, while remaining editable for the trader's preference.
sfpProximityMode = input.string(
     "Automatic by market",
     "Proximity distance mode",
     options=["Automatic by market", "Manual override"],
     group=grpSFP,
     tooltip="Automatic mode selects an editable distance based on the chart's futures root symbol. Manual override uses one distance for every market.")

sfpManualProximity = input.float(
     5.0,
     "Manual proximity distance",
     minval=0.0,
     step=0.00001,
     group=grpSFP,
     tooltip="Used only when Proximity distance mode is set to Manual override.")

sfpNQProximity = input.float(5.0, "NQ / MNQ distance", minval=0.0, step=0.25, group=grpSFP)
sfpESProximity = input.float(1.25, "ES / MES distance", minval=0.0, step=0.25, group=grpSFP)
sfpYMProximity = input.float(10.0, "YM / MYM distance", minval=0.0, step=1.0, group=grpSFP)
sfpRTYProximity = input.float(1.0, "RTY / M2K distance", minval=0.0, step=0.10, group=grpSFP)
sfpGCProximity = input.float(0.50, "Gold GC / MGC distance", minval=0.0, step=0.10, group=grpSFP)
sfpCLProximity = input.float(0.05, "Crude Oil CL / MCL distance", minval=0.0, step=0.01, group=grpSFP)
sfp6EProximity = input.float(0.00025, "Euro FX 6E / M6E distance", minval=0.0, step=0.00005, group=grpSFP)
sfpSIProximity = input.float(0.010, "Silver SI / SIL distance", minval=0.0, step=0.001, group=grpSFP)
sfpOtherProximity = input.float(
     5.0,
     "Other markets fallback distance",
     minval=0.0,
     step=0.00001,
     group=grpSFP)

marketRoot = syminfo.root

automaticSFPProximity =
     marketRoot == "NQ" or marketRoot == "MNQ" ? sfpNQProximity :
     marketRoot == "ES" or marketRoot == "MES" ? sfpESProximity :
     marketRoot == "YM" or marketRoot == "MYM" ? sfpYMProximity :
     marketRoot == "RTY" or marketRoot == "M2K" ? sfpRTYProximity :
     marketRoot == "GC" or marketRoot == "MGC" ? sfpGCProximity :
     marketRoot == "CL" or marketRoot == "MCL" ? sfpCLProximity :
     marketRoot == "6E" or marketRoot == "M6E" ? sfp6EProximity :
     marketRoot == "SI" or marketRoot == "SIL" ? sfpSIProximity :
     sfpOtherProximity

sfpProximityPoints =
     sfpProximityMode == "Manual override" ?
     sfpManualProximity :
     automaticSFPProximity

sfpSignalMode = input.string(
     "All qualified SFPs",
     "SFP signal mode",
     options=[
          "All qualified SFPs",
          "Outside Band 2 only",
          "VWAP only"],
     group=grpSFP,
     tooltip="All qualified SFPs shows signals at VWAP, Band 1, Band 2, and anywhere beyond Band 2. Outside Band 2 only shows structurally valid SFPs beyond the active ±2σ envelope. VWAP only shows SFPs within the configured point tolerance of the active session VWAP.")

modeAllSFPs = sfpSignalMode == "All qualified SFPs"
modeOutsideBand2Only = sfpSignalMode == "Outside Band 2 only"
modeVWAPOnly = sfpSignalMode == "VWAP only"

bullSFPMarkerColor = input.color(color.rgb(0, 255, 120), "Bullish marker color", group=grpSFP)
bearSFPMarkerColor = input.color(color.rgb(255, 65, 75), "Bearish marker color", group=grpSFP)


grpNY = "New York VWAP"

nyColorInput = input.color(color.rgb(76, 255, 99), "Color", group=grpNY)
nyOpacity = input.int(0, "Opacity / transparency", minval=0, maxval=100, group=grpNY)
nyWidth = input.int(3, "Thickness", minval=1, maxval=5, group=grpNY)

grpAsia = "Asia VWAP"

asiaColorInput = input.color(color.rgb(61, 139, 255), "Color", group=grpAsia)
asiaOpacity = input.int(0, "Opacity / transparency", minval=0, maxval=100, group=grpAsia)
asiaWidth = input.int(3, "Thickness", minval=1, maxval=5, group=grpAsia)

grpWeek = "Weekly VWAP"

weeklyColorInput = input.color(color.rgb(255, 163, 26), "Color", group=grpWeek)
weeklyOpacity = input.int(0, "Opacity / transparency", minval=0, maxval=100, group=grpWeek)
weeklyWidth = input.int(3, "Thickness", minval=1, maxval=5, group=grpWeek)

grpMonth = "Monthly VWAP"

monthlyColorInput = input.color(color.rgb(255, 85, 230), "Color", group=grpMonth)
monthlyOpacity = input.int(0, "Opacity / transparency", minval=0, maxval=100, group=grpMonth)
monthlyWidth = input.int(3, "Thickness", minval=1, maxval=5, group=grpMonth)

grpBands = "Session Standard Deviation Bands — General"

showBands = input.bool(true, "Show active-session deviation bands", group=grpBands)
showBand1 = input.bool(true, "Show ±1 standard deviation", group=grpBands)
showBand2 = input.bool(true, "Show ±2 standard deviations", group=grpBands)

showBandFills = input.bool(
     true,
     "Show band shading",
     group=grpBands,
     tooltip="Turns the colored fill between VWAP and its deviation bands on or off.")

preventScaleSquishing = input.bool(
     false,
     "Prevent bands from squishing chart scale",
     group=grpBands,
     tooltip="When enabled, the deviation bands do not participate in the visible price-scale calculation.")

band1Opacity = input.int(15, "±1 line opacity / transparency", minval=0, maxval=100, group=grpBands)
band1Width = input.int(2, "±1 line thickness", minval=1, maxval=5, group=grpBands)
band1FillOpacity = input.int(88, "±1 shading opacity / transparency", minval=0, maxval=100, group=grpBands)

band2Opacity = input.int(15, "±2 line opacity / transparency", minval=0, maxval=100, group=grpBands)
band2Width = input.int(2, "±2 line thickness", minval=1, maxval=5, group=grpBands)
band2FillOpacity = input.int(92, "±2 shading opacity / transparency", minval=0, maxval=100, group=grpBands)


grpBandsNY = "New York Session Bands"

nyBand1ColorInput = input.color(color.rgb(0, 220, 70), "±1 line color", group=grpBandsNY)
nyBand2ColorInput = input.color(color.rgb(255, 70, 70), "±2 line color", group=grpBandsNY)
nyBand1FillColorInput = input.color(color.rgb(0, 220, 70), "±1 background color", group=grpBandsNY)
nyBand2FillColorInput = input.color(color.rgb(255, 70, 70), "±2 background color", group=grpBandsNY)

grpBandsAsia = "Asia Session Bands"

asiaBand1ColorInput = input.color(color.rgb(45, 115, 225), "±1 line color", group=grpBandsAsia)
asiaBand2ColorInput = input.color(color.rgb(155, 35, 180), "±2 line color", group=grpBandsAsia)
asiaBand1FillColorInput = input.color(color.rgb(15, 175, 200), "±1 background color", group=grpBandsAsia)
asiaBand2FillColorInput = input.color(color.rgb(200, 135, 215), "±2 background color", group=grpBandsAsia)

src = srcOption == "Close" ? close : hlc3
vol = nz(volume, 0.0)

inNY = not na(time(timeframe.period, nySession, tz))
inAsia = not na(time(timeframe.period, asiaSession, tz))

nyReset = inNY and not inNY[1]
asiaReset = inAsia and not inAsia[1]

nyHour = hour(time, tz)
nyDay = dayofweek(time, tz)

isSundayEvening = nyDay == dayofweek.sunday and nyHour >= 18
weeklySundayReset = isSundayEvening and not isSundayEvening[1]
weeklyTVReset = timeframe.change("1W")
weeklyReset = weeklyResetMode == "Sunday 18:00 NY" ? weeklySundayReset : weeklyTVReset

monthlyReset = timeframe.change("1M")

f_updateVWAP(bool reset, float sourceValue, float volumeValue, float priorPV, float priorV, float priorP2V) =>
    float nextPV = priorPV
    float nextV = priorV
    float nextP2V = priorP2V

    if reset or na(priorPV) or na(priorV) or na(priorP2V)
        nextPV := sourceValue * volumeValue
        nextV := volumeValue
        nextP2V := sourceValue * sourceValue * volumeValue
    else
        nextPV += sourceValue * volumeValue
        nextV += volumeValue
        nextP2V += sourceValue * sourceValue * volumeValue

    float nextVWAP = nextV > 0 ? nextPV / nextV : na
    float nextMeanSquare = nextV > 0 ? nextP2V / nextV : na
    float nextVariance = not na(nextMeanSquare) and not na(nextVWAP) ? math.max(nextMeanSquare - nextVWAP * nextVWAP, 0.0) : na
    float nextDeviation = not na(nextVariance) ? math.sqrt(nextVariance) : na

    [nextPV, nextV, nextP2V, nextVWAP, nextDeviation]

var float nyPV = na
var float nyV = na
var float nyP2V = na
[nyPVNext, nyVNext, nyP2VNext, nyVWAPChartRes, nyDevChartRes] = f_updateVWAP(nyReset, src, vol, nyPV, nyV, nyP2V)
nyPV := nyPVNext
nyV := nyVNext
nyP2V := nyP2VNext

var float asiaPV = na
var float asiaV = na
var float asiaP2V = na
[asiaPVNext, asiaVNext, asiaP2VNext, asiaVWAPChartRes, asiaDevChartRes] = f_updateVWAP(asiaReset, src, vol, asiaPV, asiaV, asiaP2V)
asiaPV := asiaPVNext
asiaV := asiaVNext
asiaP2V := asiaP2VNext

var float weeklyPV = na
var float weeklyV = na
var float weeklyP2V = na
[weeklyPVNext, weeklyVNext, weeklyP2VNext, weeklyVWAPChartRes, weeklyDevChartResUnused] = f_updateVWAP(weeklyReset, src, vol, weeklyPV, weeklyV, weeklyP2V)
weeklyPV := weeklyPVNext
weeklyV := weeklyVNext
weeklyP2V := weeklyP2VNext

var float monthlyPV = na
var float monthlyV = na
var float monthlyP2V = na
[monthlyPVNext, monthlyVNext, monthlyP2VNext, monthlyVWAPChartRes, monthlyDevChartResUnused] = f_updateVWAP(monthlyReset, src, vol, monthlyPV, monthlyV, monthlyP2V)
monthlyPV := monthlyPVNext
monthlyV := monthlyVNext
monthlyP2V := monthlyP2VNext

f_nyVWAP1min() =>
    s1 = srcOption == "Close" ? close : hlc3
    v1 = nz(volume, 0.0)
    inNY1 = not na(time("1", nySession, tz))
    reset1 = inNY1 and not inNY1[1]
    var float pv1 = na
    var float v1s = na
    var float p2v1 = na
    if reset1 or na(pv1)
        pv1 := s1 * v1
        v1s := v1
        p2v1 := s1 * s1 * v1
    else
        pv1 += s1 * v1
        v1s += v1
        p2v1 += s1 * s1 * v1
    vwap1 = v1s > 0 ? pv1 / v1s : na
    ms1 = v1s > 0 ? p2v1 / v1s : na
    var1 = not na(ms1) and not na(vwap1) ? math.max(ms1 - vwap1 * vwap1, 0.0) : na
    dev1 = not na(var1) ? math.sqrt(var1) : na
    [vwap1, dev1]

[nyVWAP1min, nyDev1min] = request.security(syminfo.tickerid, "1", f_nyVWAP1min(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

f_asiaVWAP1min() =>
    s1 = srcOption == "Close" ? close : hlc3
    v1 = nz(volume, 0.0)
    inAsia1 = not na(time("1", asiaSession, tz))
    reset1 = inAsia1 and not inAsia1[1]
    var float pv1 = na
    var float v1s = na
    var float p2v1 = na
    if reset1 or na(pv1)
        pv1 := s1 * v1
        v1s := v1
        p2v1 := s1 * s1 * v1
    else
        pv1 += s1 * v1
        v1s += v1
        p2v1 += s1 * s1 * v1
    vwap1 = v1s > 0 ? pv1 / v1s : na
    ms1 = v1s > 0 ? p2v1 / v1s : na
    var1 = not na(ms1) and not na(vwap1) ? math.max(ms1 - vwap1 * vwap1, 0.0) : na
    dev1 = not na(var1) ? math.sqrt(var1) : na
    [vwap1, dev1]

[asiaVWAP1min, asiaDev1min] = request.security(syminfo.tickerid, "1", f_asiaVWAP1min(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

f_weeklyVWAP1min() =>
    s1 = srcOption == "Close" ? close : hlc3
    v1 = nz(volume, 0.0)
    h1 = hour(time, tz)
    d1 = dayofweek(time, tz)
    isSunEve1 = d1 == dayofweek.sunday and h1 >= 18
    weeklySunReset1 = isSunEve1 and not isSunEve1[1]
    weeklyTVReset1 = timeframe.change("1W")
    reset1 = weeklyResetMode == "Sunday 18:00 NY" ? weeklySunReset1 : weeklyTVReset1
    var float pv1 = na
    var float v1s = na
    if reset1 or na(pv1)
        pv1 := s1 * v1
        v1s := v1
    else
        pv1 += s1 * v1
        v1s += v1
    v1s > 0 ? pv1 / v1s : na

weeklyVWAP1min = request.security(syminfo.tickerid, "1", f_weeklyVWAP1min(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

f_monthlyVWAP1min() =>
    s1 = srcOption == "Close" ? close : hlc3
    v1 = nz(volume, 0.0)
    m1 = month(time, tz)
    reset1 = m1 != m1[1]
    var float pv1 = na
    var float v1s = na
    if reset1 or na(pv1)
        pv1 := s1 * v1
        v1s := v1
    else
        pv1 += s1 * v1
        v1s += v1
    v1s > 0 ? pv1 / v1s : na

monthlyVWAP1min = request.security(syminfo.tickerid, "1", f_monthlyVWAP1min(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

nyVWAP = useHighResAnchors and not na(nyVWAP1min) ? nyVWAP1min : nyVWAPChartRes
nyDeviation = useHighResAnchors and not na(nyDev1min) ? nyDev1min : nyDevChartRes

asiaVWAP = useHighResAnchors and not na(asiaVWAP1min) ? asiaVWAP1min : asiaVWAPChartRes
asiaDeviation = useHighResAnchors and not na(asiaDev1min) ? asiaDev1min : asiaDevChartRes

weeklyVWAP = useHighResAnchors and not na(weeklyVWAP1min) ? weeklyVWAP1min : weeklyVWAPChartRes
monthlyVWAP = useHighResAnchors and not na(monthlyVWAP1min) ? monthlyVWAP1min : monthlyVWAPChartRes

activeVWAP = inNY ? nyVWAP : inAsia ? asiaVWAP : na
activeDeviation = inNY ? nyDeviation : inAsia ? asiaDeviation : na

upper1 = activeVWAP + activeDeviation
lower1 = activeVWAP - activeDeviation
upper2 = activeVWAP + activeDeviation * 2.0
lower2 = activeVWAP - activeDeviation * 2.0


bandDisplay = preventScaleSquishing ? display.all - display.price_scale : display.all


//──────────────────────────────────────────────────────────────────────────────
// SFP engine and VWAP/band location matching
//──────────────────────────────────────────────────────────────────────────────
sfpPivotHigh = ta.pivothigh(sfpSwingLength, 1)
sfpPivotLow = ta.pivotlow(sfpSwingLength, 1)

var float latestSwingHigh = na
var float latestSwingLow = na
var int latestSwingHighIndex = na
var int latestSwingLowIndex = na

if not na(sfpPivotHigh)
    latestSwingHigh := sfpPivotHigh
    latestSwingHighIndex := bar_index - 1

if not na(sfpPivotLow)
    latestSwingLow := sfpPivotLow
    latestSwingLowIndex := bar_index - 1

rawBearishSFP = enableSFPSignals and not na(latestSwingHigh) and high > latestSwingHigh and open < latestSwingHigh and close < latestSwingHigh
rawBullishSFP = enableSFPSignals and not na(latestSwingLow) and low < latestSwingLow and open > latestSwingLow and close > latestSwingLow

f_sfpNearLevel(float level, float sweptSwing, float tolerance) =>
    not na(level) and (math.abs(sweptSwing - level) <= tolerance or (low <= level + tolerance and high >= level - tolerance))

bullNearVWAP = rawBullishSFP and f_sfpNearLevel(activeVWAP, latestSwingLow, sfpProximityPoints)
bearNearVWAP = rawBearishSFP and f_sfpNearLevel(activeVWAP, latestSwingHigh, sfpProximityPoints)

bullAtBand1 = rawBullishSFP and (f_sfpNearLevel(upper1, latestSwingLow, sfpProximityPoints) or f_sfpNearLevel(lower1, latestSwingLow, sfpProximityPoints))
bearAtBand1 = rawBearishSFP and (f_sfpNearLevel(upper1, latestSwingHigh, sfpProximityPoints) or f_sfpNearLevel(lower1, latestSwingHigh, sfpProximityPoints))

bullAtBand2 = rawBullishSFP and (f_sfpNearLevel(upper2, latestSwingLow, sfpProximityPoints) or f_sfpNearLevel(lower2, latestSwingLow, sfpProximityPoints))
bearAtBand2 = rawBearishSFP and (f_sfpNearLevel(upper2, latestSwingHigh, sfpProximityPoints) or f_sfpNearLevel(lower2, latestSwingHigh, sfpProximityPoints))

bullBand2ReentrySFP = rawBullishSFP and not na(lower2) and low < lower2 and close > lower2
bearBand2ReentrySFP = rawBearishSFP and not na(upper2) and high > upper2 and close < upper2

// Broad outside-Band-2 classification:
// Any bullish SFP whose rejection candle forms below lower Band 2 qualifies.
// Any bearish SFP whose rejection candle forms above upper Band 2 qualifies.
// These do not require proximity to the line or an immediate close back inside.
bullOutsideBand2SFP =
     rawBullishSFP and
     not na(lower2) and
     low < lower2

bearOutsideBand2SFP =
     rawBearishSFP and
     not na(upper2) and
     high > upper2

// The selected signal mode controls which qualified SFPs may print.
// In All mode, outside-Band-2 signals retain priority over VWAP and band matches.
allowOutsideBand2Signals = modeAllSFPs or modeOutsideBand2Only
allowVWAPSignals = modeAllSFPs or modeVWAPOnly
allowBandSignals = modeAllSFPs

bullSignalRE = allowOutsideBand2Signals and bullBand2ReentrySFP
bearSignalRE = allowOutsideBand2Signals and bearBand2ReentrySFP

bullSignalOUT = allowOutsideBand2Signals and bullOutsideBand2SFP and not bullSignalRE
bearSignalOUT = allowOutsideBand2Signals and bearOutsideBand2SFP and not bearSignalRE

bullSignalVWAP = allowVWAPSignals and bullNearVWAP and not bullSignalRE and not bullSignalOUT
bearSignalVWAP = allowVWAPSignals and bearNearVWAP and not bearSignalRE and not bearSignalOUT

bullSignalB1 = allowBandSignals and bullAtBand1 and not bullSignalRE and not bullSignalOUT and not bullSignalVWAP
bearSignalB1 = allowBandSignals and bearAtBand1 and not bearSignalRE and not bearSignalOUT and not bearSignalVWAP

bullSignalB2 = allowBandSignals and bullAtBand2 and not bullSignalRE and not bullSignalOUT and not bullSignalVWAP and not bullSignalB1
bearSignalB2 = allowBandSignals and bearAtBand2 and not bearSignalRE and not bearSignalOUT and not bearSignalVWAP and not bearSignalB1

bullVWAPBandSFP = bullSignalRE or bullSignalOUT or bullSignalVWAP or bullSignalB1 or bullSignalB2
bearVWAPBandSFP = bearSignalRE or bearSignalOUT or bearSignalVWAP or bearSignalB1 or bearSignalB2
anyVWAPBandSFP = bullVWAPBandSFP or bearVWAPBandSFP

// Unified alert categories tied directly to the visible signal-marker logic.
anySFPMarkerSignal = anyVWAPBandSFP
anyVWAPSFPMarker = bullSignalVWAP or bearSignalVWAP
anyOutsideBand2SFPMarker = bullSignalOUT or bearSignalOUT or bullSignalRE or bearSignalRE

nyColor = color.new(nyColorInput, nyOpacity)
asiaColor = color.new(asiaColorInput, asiaOpacity)
weeklyColor = color.new(weeklyColorInput, weeklyOpacity)
monthlyColor = color.new(monthlyColorInput, monthlyOpacity)

// Per-session band colors: swap the whole band palette based on which
// session is active on each bar, so the bands themselves tell you at a
// glance whether you're looking at an NY-session stretch or an Asia-session
// stretch, even scrolling back through history.
activeBand1ColorInput = inNY ? nyBand1ColorInput : asiaBand1ColorInput
activeBand2ColorInput = inNY ? nyBand2ColorInput : asiaBand2ColorInput

band1Color = color.new(activeBand1ColorInput, band1Opacity)
band2Color = color.new(activeBand2ColorInput, band2Opacity)

activeBand1FillColorInput = inNY ? nyBand1FillColorInput : asiaBand1FillColorInput
activeBand2FillColorInput = inNY ? nyBand2FillColorInput : asiaBand2FillColorInput

band1Fill = color.new(activeBand1FillColorInput, band1FillOpacity)
band2Fill = color.new(activeBand2FillColorInput, band2FillOpacity)

//──────────────────────────────────────────────────────────────────────────────
// Optional moving-average plots
//──────────────────────────────────────────────────────────────────────────────
plot(showEMA9 ? ta.ema(close, 9) : na, "EMA 9", color=ema9Color, linewidth=ema9Width)
plot(showEMA21 ? ta.ema(close, 21) : na, "EMA 21", color=ema21Color, linewidth=ema21Width)
plot(showEMA50 ? ta.ema(close, 50) : na, "EMA 50", color=ema50Color, linewidth=ema50Width)
plot(showEMA100 ? ta.ema(close, 100) : na, "EMA 100", color=ema100Color, linewidth=ema100Width)
plot(showSMA50 ? ta.sma(close, 50) : na, "SMA 50", color=sma50Color, linewidth=sma50Width)
plot(showSMA200 ? ta.sma(close, 200) : na, "SMA 200", color=sma200Color, linewidth=sma200Width)

//──────────────────────────────────────────────────────────────────────────────
// VWAP plots
//──────────────────────────────────────────────────────────────────────────────
pNY = plot(showNY ? nyVWAP : na, "New York VWAP", color=nyColor, linewidth=nyWidth, style=plot.style_linebr)
pAsia = plot(showAsia ? asiaVWAP : na, "Asia VWAP", color=asiaColor, linewidth=asiaWidth, style=plot.style_linebr)
pWeekly = plot(showWeekly ? weeklyVWAP : na, "Weekly VWAP", color=weeklyColor, linewidth=weeklyWidth, style=plot.style_linebr)
pMonthly = plot(showMonthly ? monthlyVWAP : na, "Monthly VWAP", color=monthlyColor, linewidth=monthlyWidth, style=plot.style_linebr)

pActiveVWAP = plot(showBands ? activeVWAP : na, "Active Session VWAP Fill Anchor", color=color.new(color.white, 100), display=bandDisplay)

pUpper1 = plot(showBands and showBand1 ? upper1 : na, "Active Session +1σ", color=band1Color, linewidth=band1Width, style=plot.style_linebr, display=bandDisplay)
pLower1 = plot(showBands and showBand1 ? lower1 : na, "Active Session -1σ", color=band1Color, linewidth=band1Width, style=plot.style_linebr, display=bandDisplay)
pUpper2 = plot(showBands and showBand2 ? upper2 : na, "Active Session +2σ", color=band2Color, linewidth=band2Width, style=plot.style_linebr, display=bandDisplay)
pLower2 = plot(showBands and showBand2 ? lower2 : na, "Active Session -2σ", color=band2Color, linewidth=band2Width, style=plot.style_linebr, display=bandDisplay)

fill(
     pActiveVWAP,
     pUpper1,
     color=showBands and showBandFills and showBand1 ? band1Fill : na,
     title="Upper 1σ shading")

fill(
     pActiveVWAP,
     pLower1,
     color=showBands and showBandFills and showBand1 ? band1Fill : na,
     title="Lower 1σ shading")

fill(
     pUpper1,
     pUpper2,
     color=showBands and showBandFills and showBand1 and showBand2 ? band2Fill : na,
     title="Upper 2σ shading")

fill(
     pLower1,
     pLower2,
     color=showBands and showBandFills and showBand1 and showBand2 ? band2Fill : na,
     title="Lower 2σ shading")

//──────────────────────────────────────────────────────────────────────────────
// Current-session alerts
//──────────────────────────────────────────────────────────────────────────────
// A VWAP touch occurs when the bar trades through the active session VWAP.
activeVWAPTouch =
     not na(activeVWAP) and
     low <= activeVWAP and
     high >= activeVWAP

// A band break requires price to cross from inside to outside the active ±2σ band.
// Separate upper/lower conditions are provided, plus one combined condition.
activeUpperBand2Break =
     not na(upper2) and
     ta.crossover(high, upper2)

activeLowerBand2Break =
     not na(lower2) and
     ta.crossunder(low, lower2)

activeBand2Break = activeUpperBand2Break or activeLowerBand2Break

alertcondition(
     activeVWAPTouch,
     title="Current Session VWAP Touch",
     message="Price touched the current session VWAP on {{ticker}} at {{interval}}.")

alertcondition(
     activeUpperBand2Break,
     title="Current Session Upper 2σ Break",
     message="Price broke above the current session upper 2σ VWAP band on {{ticker}} at {{interval}}.")

alertcondition(
     activeLowerBand2Break,
     title="Current Session Lower 2σ Break",
     message="Price broke below the current session lower 2σ VWAP band on {{ticker}} at {{interval}}.")

alertcondition(
     activeBand2Break,
     title="Current Session 2σ Band Break",
     message="Price broke outside the current session ±2σ VWAP band on {{ticker}} at {{interval}}.")

//──────────────────────────────────────────────────────────────────────────────
// Persistent SFP marker lifecycle
// A marker appears when an SFP forms. It is deleted if the pattern invalidates
// before confirmation and remains permanently once opposite structure breaks.
//──────────────────────────────────────────────────────────────────────────────
var bool activeBullLevelSFP = false
var bool activeBearLevelSFP = false
var bool confirmedBullLevelSFP = false
var bool confirmedBearLevelSFP = false

var float activeBullSwingPrice = na
var float activeBearSwingPrice = na
var float activeBullConfirmationPrice = na
var float activeBearConfirmationPrice = na
var int activeBullSwingIndex = na
var int activeBearSwingIndex = na
var int activeBullSignalIndex = na
var int activeBearSignalIndex = na

var label activeBullMarker = na
var label activeBearMarker = na

f_bullMarkerText() =>
    "B"

f_bearMarkerText() =>
    "S"


// Start or replace an active bullish SFP candidate.
if bullVWAPBandSFP and not na(latestSwingLowIndex)
    if activeBullLevelSFP and not confirmedBullLevelSFP and not na(activeBullMarker)
        label.delete(activeBullMarker)

    float bullOpposite = latestSwingLow
    int bullBarsBack = math.min(math.max(bar_index - latestSwingLowIndex - 1, 0), 500)

    if bullBarsBack > 0
        for i = 1 to bullBarsBack
            if high[i] > bullOpposite
                bullOpposite := high[i]

    activeBullLevelSFP := true
    confirmedBullLevelSFP := false
    activeBullSwingPrice := latestSwingLow
    activeBullConfirmationPrice := bullOpposite
    activeBullSwingIndex := latestSwingLowIndex
    activeBullSignalIndex := bar_index

    activeBullMarker := label.new(
         bar_index,
         low,
         f_bullMarkerText(),
         style=label.style_label_up,
         color=bullSFPMarkerColor,
         textcolor=color.black,
         size=size.tiny)

// Start or replace an active bearish SFP candidate.
if bearVWAPBandSFP and not na(latestSwingHighIndex)
    if activeBearLevelSFP and not confirmedBearLevelSFP and not na(activeBearMarker)
        label.delete(activeBearMarker)

    float bearOpposite = latestSwingHigh
    int bearBarsBack = math.min(math.max(bar_index - latestSwingHighIndex - 1, 0), 500)

    if bearBarsBack > 0
        for i = 1 to bearBarsBack
            if low[i] < bearOpposite
                bearOpposite := low[i]

    activeBearLevelSFP := true
    confirmedBearLevelSFP := false
    activeBearSwingPrice := latestSwingHigh
    activeBearConfirmationPrice := bearOpposite
    activeBearSwingIndex := latestSwingHighIndex
    activeBearSignalIndex := bar_index

    activeBearMarker := label.new(
         bar_index,
         high,
         f_bearMarkerText(),
         style=label.style_label_down,
         color=bearSFPMarkerColor,
         textcolor=color.white,
         size=size.tiny)

// Bullish lifecycle: confirm above opposite structure or delete if invalidated.
if activeBullLevelSFP and not confirmedBullLevelSFP
    if close > activeBullConfirmationPrice
        confirmedBullLevelSFP := true
        // Keep the confirmed marker compact and unchanged.
    else if close < activeBullSwingPrice or bar_index - activeBullSwingIndex > 500
        if not na(activeBullMarker)
            label.delete(activeBullMarker)
        activeBullLevelSFP := false
        activeBullMarker := na

// Bearish lifecycle: confirm below opposite structure or delete if invalidated.
if activeBearLevelSFP and not confirmedBearLevelSFP
    if close < activeBearConfirmationPrice
        confirmedBearLevelSFP := true
        // Keep the confirmed marker compact and unchanged.
    else if close > activeBearSwingPrice or bar_index - activeBearSwingIndex > 500
        if not na(activeBearMarker)
            label.delete(activeBearMarker)
        activeBearLevelSFP := false
        activeBearMarker := na

//──────────────────────────────────────────────────────────────────────────────
// VWAP / band SFP alerts
//──────────────────────────────────────────────────────────────────────────────
alertcondition(bullVWAPBandSFP, title="Bullish VWAP or Band SFP", message="Bullish SFP printed at the active session VWAP or deviation band on {{ticker}} at {{interval}}.")
alertcondition(bearVWAPBandSFP, title="Bearish VWAP or Band SFP", message="Bearish SFP printed at the active session VWAP or deviation band on {{ticker}} at {{interval}}.")
alertcondition(anyVWAPBandSFP, title="Any VWAP or Band SFP", message="An SFP printed at the active session VWAP or deviation band on {{ticker}} at {{interval}}.")
alertcondition(bullSignalRE, title="Bullish Band 2 Re-entry SFP", message="Bullish SFP swept below lower Band 2 and closed back inside on {{ticker}} at {{interval}}.")
alertcondition(bearSignalRE, title="Bearish Band 2 Re-entry SFP", message="Bearish SFP swept above upper Band 2 and closed back inside on {{ticker}} at {{interval}}.")

alertcondition(
     bullSignalOUT,
     title="Bullish SFP Outside Lower Band 2",
     message="A structurally valid bullish SFP formed outside the active lower Band 2 on {{ticker}} at {{interval}}.")

alertcondition(
     bearSignalOUT,
     title="Bearish SFP Outside Upper Band 2",
     message="A structurally valid bearish SFP formed outside the active upper Band 2 on {{ticker}} at {{interval}}.")

alertcondition(bullSignalVWAP or bearSignalVWAP, title="Any Active VWAP SFP", message="An SFP printed at the active session VWAP on {{ticker}} at {{interval}}.")
alertcondition(bullSignalB1 or bearSignalB1, title="Any Active Band 1 SFP", message="An SFP printed at an active session Band 1 level on {{ticker}} at {{interval}}.")
alertcondition(bullSignalB2 or bearSignalB2, title="Any Active Band 2 SFP", message="An SFP printed at an active session Band 2 level on {{ticker}} at {{interval}}.")


bullSFPConfirmedNow =
     activeBullLevelSFP and
     confirmedBullLevelSFP and
     not confirmedBullLevelSFP[1]

bearSFPConfirmedNow =
     activeBearLevelSFP and
     confirmedBearLevelSFP and
     not confirmedBearLevelSFP[1]

alertcondition(
     bullSFPConfirmedNow,
     title="Bullish VWAP/Band SFP Confirmed",
     message="A bullish VWAP or band SFP was confirmed by opposite-structure break on {{ticker}} at {{interval}}.")

alertcondition(
     bearSFPConfirmedNow,
     title="Bearish VWAP/Band SFP Confirmed",
     message="A bearish VWAP or band SFP was confirmed by opposite-structure break on {{ticker}} at {{interval}}.")

//──────────────────────────────────────────────────────────────────────────────
// Simplified master SFP alert choices
//──────────────────────────────────────────────────────────────────────────────
alertcondition(
     anySFPMarkerSignal,
     title="Any SFP Signal Marker",
     message="An SFP signal marker permitted by the selected SFP signal mode printed on {{ticker}} at {{interval}}.")

alertcondition(
     anyVWAPSFPMarker,
     title="Any SFP at Active VWAP",
     message="An SFP signal printed at the active session VWAP on {{ticker}} at {{interval}}.")

alertcondition(
     anyOutsideBand2SFPMarker,
     title="Any SFP Outside Band 2",
     message="An SFP signal printed outside the active session Band 2 envelope on {{ticker}} at {{interval}}.")