//@version=6
strategy("EMA Ride V2 Strategy",
         shorttitle        = "EMA_RD_BT",
         overlay           = true,
         initial_capital   = 100000,
         default_qty_type  = strategy.percent_of_equity,
         default_qty_value = 10,
         commission_type   = strategy.commission.percent,
         commission_value  = 0.1,
         slippage          = 2)

// ═══════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════
grp1 = "EMA Settings"
len9  = input.int(9,  "EMA9",  group=grp1)
len21 = input.int(21, "EMA21", group=grp1)
len50 = input.int(50, "EMA50", group=grp1)

grp2 = "Strategy Settings"
min_weeks    = input.int(4,     "Min Weeks Riding EMA21",       group=grp2)
dip_pct      = input.float(3.0, "Entry Dip Zone % above EMA9",  group=grp2)
min_bounces  = input.int(2,     "Min Cloud Bounces (90 bars)",   group=grp2)
min_pct_ema9 = input.float(60.0,"Min % bars above EMA9 (60 bars)", group=grp2)
min_atr_pct  = input.float(3.0, "Min ATR %",                    group=grp2)
min_52wl_pct = input.float(50.0,"Min % above 52W Low",          group=grp2)

grp3 = "Exit Settings"
exit_mode = input.string("EMA21 Close",
             options = ["EMA21 Close", "EMA9 Trail", "Both"],
             title   = "Exit Mode",
             group   = grp3)

// ═══════════════════════════════════════════
// CORE CALCULATIONS
// ═══════════════════════════════════════════
ema9  = ta.ema(close, len9)
ema21 = ta.ema(close, len21)
ema50 = ta.ema(close, len50)
vol20 = ta.sma(volume, 20)

// EMA Stack
stack = ema9 > ema21 and ema21 > ema50

// Consecutive bars above EMA21
var int bars_ema21 = 0
bars_ema21 := close > ema21 ? bars_ema21 + 1 : 0

// % of last 60 bars above EMA9
ema9_above_60  = math.sum(close > ema9 ? 1 : 0, 60)
ema9_pct_above = ema9_above_60 / 60.0 * 100

// Cloud bounces in last 90 bars
cloud_tested   = low   <= ema21 * 1.02
cloud_bounced  = close >  ema9
genuine_bounce = cloud_tested and cloud_bounced
bounces_90     = math.sum(genuine_bounce ? 1 : 0, 90)

// Distance from EMA9
dist_ema9  = (close - ema9) / ema9 * 100

// EMA9 rising
ema9_rising = ema9 > ema9[3]

// Min bars from weeks
min_bars = min_weeks * 5

// ATR % (V2)
atr14   = ta.atr(14)
atr_pct = atr14 / close * 100

// % above 52-week low (V2)
low52   = ta.lowest(low, 252)
pct52wl = (close - low52) / low52 * 100

// ═══════════════════════════════════════════
// ENTRY CONDITIONS
// ═══════════════════════════════════════════

// Long ride established
_l1 = bars_ema21 >= min_bars
_l2 = ema9_pct_above >= min_pct_ema9
_l3 = bounces_90 >= min_bounces
long_ride = _l1 and _l2 and _l3 and stack

// At EMA9 dip right now
_d1 = dist_ema9 >= 0
_d2 = dist_ema9 <= dip_pct
_d3 = bars_ema21 >= min_bars
_d4 = bounces_90 >= min_bounces
at_dip = _d1 and _d2 and _d3 and _d4 and stack and ema9_rising

// VCPSwing quality filters
_v1 = atr_pct >= min_atr_pct
_v2 = pct52wl >= min_52wl_pct
vcps_pass = _v1 and _v2 and stack

// Final entry signal
entry_signal = at_dip and vcps_pass

// ═══════════════════════════════════════════
// EXIT CONDITIONS
// ═══════════════════════════════════════════
exit_ema21 = close < ema21
exit_ema9  = close < ema9

do_exit = exit_mode == "EMA21 Close" ? exit_ema21 :
          exit_mode == "EMA9 Trail"  ? exit_ema9  :
          exit_ema21 or exit_ema9

// ═══════════════════════════════════════════
// STRATEGY EXECUTION
// ═══════════════════════════════════════════
if entry_signal and strategy.position_size == 0
    strategy.entry("EMA Ride", strategy.long, comment="EMA9 Dip")

if strategy.position_size > 0 and do_exit
    strategy.close("EMA Ride",
                   comment = exit_mode == "EMA21 Close" ? "Below EMA21" :
                             exit_mode == "EMA9 Trail"  ? "Below EMA9"  :
                             "Exit triggered")

// ═══════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════
ema9_line  = plot(ema9,  "EMA9",  color=color.new(color.green,  20), linewidth=1)
ema21_line = plot(ema21, "EMA21", color=color.new(color.blue,   20), linewidth=1)
plot(ema50, "EMA50", color=color.new(color.orange, 40), linewidth=1)

cloud_col = close > ema21 ? color.new(color.green, 80) : color.new(color.red, 80)
fill(ema9_line, ema21_line, color=cloud_col, title="EMA Cloud")

plotshape(entry_signal,
          title    = "Entry",
          style    = shape.triangleup,
          location = location.belowbar,
          color    = color.new(color.green, 0),
          size     = size.small)

plotshape(strategy.position_size > 0 and do_exit,
          title    = "Exit",
          style    = shape.triangledown,
          location = location.abovebar,
          color    = color.new(color.red, 0),
          size     = size.small)