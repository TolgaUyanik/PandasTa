//@version=6

// @description Library for detecting Double Top and Double Bottom patterns
library("DoublePatterns", overlay=true)

// ==================== TYPES ====================

// @type DoublePatternResult
// @field isValid (bool) Whether a valid pattern was found
// @field patternType (string) Type of pattern detected ("Double Top" or "Double Bottom")
// @field isBullish (bool) Whether the pattern is bullish (double bottom) or bearish (double top)
// @field pointBase (float) Base point price
// @field pointFirst (float) First peak/bottom price
// @field pointMiddle (float) Middle valley/peak price
// @field pointSecond (float) Second peak/bottom price
// @field barBase (int) Base point bar index
// @field barFirst (int) First peak/bottom bar index
// @field barMiddle (int) Middle valley/peak bar index
// @field barSecond (int) Second peak/bottom bar index
// @field targetPrice (float) Projected target price
// @field similarity (float) Similarity between the two peaks/bottoms (0-1, 1 = perfect)
// @field valleyDepth (float) Depth of valley relative to peaks (for double top)
// @field peakHeight (float) Height of peak relative to bottoms (for double bottom)
export type DoublePatternResult
    bool isValid
    string patternType
    bool isBullish
    float pointBase
    float pointFirst
    float pointMiddle
    float pointSecond
    int barBase
    int barFirst
    int barMiddle
    int barSecond
    float targetPrice
    float similarity
    float valleyDepth
    float peakHeight

// ==================== UTILITY FUNCTIONS ====================

// @function Check if first peak/bottom is extreme within lookback period
// @param extremePrice (float) Price to validate as extreme
// @param extremeBar (int) Bar index of the extreme
// @param lookbackPeriod (int) Number of bars to check
// @param isDoubleTop (bool) True for double top, false for double bottom
// @returns bool True if price is extreme within lookback
validateExtremeWithinLookback(float extremePrice, int extremeBar, int lookbackPeriod, bool isDoubleTop) =>
    bool isExtreme = true
    int extremeOffset = bar_index - extremeBar
    int barsToCheck = math.min(lookbackPeriod, extremeOffset)
    
    if barsToCheck > 0 and barsToCheck < 5000  // Stay within TradingView limits
        for i = 1 to barsToCheck
            int checkOffset = extremeOffset + i
            if checkOffset >= 0 and checkOffset < 5000
                if isDoubleTop
                    // For double top: first peak should be highest high in lookback
                    if high[checkOffset] > extremePrice
                        isExtreme := false
                        break
                else
                    // For double bottom: first bottom should be lowest low in lookback
                    if low[checkOffset] < extremePrice
                        isExtreme := false
                        break
    
    isExtreme

// @function Calculate pattern quality metrics
// @param firstPoint (float) First peak/bottom price
// @param secondPoint (float) Second peak/bottom price
// @param middle (float) Middle valley/peak price
// @param base (float) Base price
// @param isDoubleTop (bool) True for double top pattern
// @returns [float, float, float] [similarity, valleyDepth, peakHeight]
calculatePatternMetrics(float firstPoint, float secondPoint, float middle, float base, bool isDoubleTop) =>
    // Calculate similarity between peaks/bottoms (higher is better)
    float priceDifference = math.abs(firstPoint - secondPoint)
    float averagePrice = (firstPoint + secondPoint) / 2
    float similarity = averagePrice > 0 ? (1.0 - (priceDifference / averagePrice)) : 0.0
    
    float valleyDepth = 0.0
    float peakHeight = 0.0
    
    if isDoubleTop
        // For double top: calculate valley depth relative to peaks
        float peakAverage = (firstPoint + secondPoint) / 2
        valleyDepth := (peakAverage - middle) / (peakAverage - base)
    else
        // For double bottom: calculate peak height relative to bottoms
        float bottomAverage = (firstPoint + secondPoint) / 2
        peakHeight := (middle - bottomAverage) / (base - bottomAverage)
    
    [similarity, valleyDepth, peakHeight]

// @function Detect Double Top/Bottom pattern from 4 pivot points
// @param pivotValues (array<float>) Array of pivot values (must have at least 4 points)
// @param pivotBars (array<int>) Array of pivot bar indices
// @param zigzagLength (int) ZigZag length for lookback validation
// @returns DoublePatternResult Pattern detection result
export detectPattern(array<float> pivotValues, array<int> pivotBars, int zigzagLength) =>
    DoublePatternResult result = DoublePatternResult.new()
    result.isValid := false
    
    if array.size(pivotValues) < 4
        result
    else
        // Extract 4 most recent pivot points
        int i = array.size(pivotValues) - 4
        float p0 = array.get(pivotValues, i)     // Base
        float p1 = array.get(pivotValues, i + 1) // First peak/bottom
        float p2 = array.get(pivotValues, i + 2) // Middle valley/peak
        float p3 = array.get(pivotValues, i + 3) // Second peak/bottom
        
        int b0 = array.get(pivotBars, i)
        int b1 = array.get(pivotBars, i + 1)
        int b2 = array.get(pivotBars, i + 2)
        int b3 = array.get(pivotBars, i + 3)
        
        // Calculate lookback period for extreme validation
        int lookbackPeriod = zigzagLength * 5
        
        // === DOUBLE TOP PATTERN VALIDATION ===
        bool isDoubleTop = p1 > p0 and          // First peak higher than base
                          p1 > p2 and           // First peak higher than valley
                          p3 > p2 and           // Second peak higher than valley
                          math.abs(p1 - p3) < math.abs(p1 - p2) * 0.02 and  // Peaks are similar height (within 2%)
                          math.abs(p3 - p2) > math.abs(p1 - p0) * 0.3 and   // Significant valley depth (at least 30% of first leg)
                          math.abs(p1 - p2) > 0                             // Prevent division by zero
        
        // Validate first peak is extreme within lookback for double top
        bool extremeValidTop = false
        if isDoubleTop
            extremeValidTop := validateExtremeWithinLookback(p1, b1, lookbackPeriod, true)
        
        // === DOUBLE BOTTOM PATTERN VALIDATION ===
        bool isDoubleBottom = p1 < p0 and       // First bottom lower than base
                             p1 < p2 and        // First bottom lower than peak
                             p3 < p2 and        // Second bottom lower than peak
                             math.abs(p1 - p3) < math.abs(p1 - p2) * 0.02 and  // Bottoms are similar depth (within 2%)
                             math.abs(p3 - p2) > math.abs(p1 - p0) * 0.5 and   // Significant peak height (at least 50% of first leg)
                             math.abs(p2 - p1) > 0 and                         // Prevent division by zero
                             (p0 - p1) > math.abs(p1 - p2) * 1                 // Base significantly higher than first bottom
        
        // Validate first bottom is extreme within lookback for double bottom
        bool extremeValidBottom = false
        if isDoubleBottom
            extremeValidBottom := validateExtremeWithinLookback(p1, b1, lookbackPeriod, false)
        
        // Set result if pattern is valid and extreme is confirmed
        if (isDoubleTop and extremeValidTop) or (isDoubleBottom and extremeValidBottom)
            bool isBullishPattern = isDoubleBottom  // Double bottom is bullish, double top is bearish
            
            // Calculate pattern quality metrics
            [similarity, valleyDepth, peakHeight] = calculatePatternMetrics(p1, p3, p2, p0, isDoubleTop)
            
            // Calculate price target
            float targetMove = math.abs(p3 - p2)  // Distance from second peak/bottom to middle valley/peak
            float targetPrice = isBullishPattern ? p2 + targetMove : p2 - targetMove
            
            // Additional quality checks
            bool qualityCheck = true
            
            if isDoubleTop
                // For double top: valley should be deep enough and peaks similar enough
                qualityCheck := valleyDepth > 0.3 and similarity > 0.95  // Valley at least 30% deep, peaks 95% similar
            else
                // For double bottom: peak should be high enough and bottoms similar enough
                qualityCheck := peakHeight > 0.5 and similarity > 0.95  // Peak at least 50% high, bottoms 95% similar
            
            if qualityCheck
                // Set result fields
                result.isValid := true
                result.patternType := isBullishPattern ? "Double Bottom" : "Double Top"
                result.isBullish := isBullishPattern
                result.pointBase := p0
                result.pointFirst := p1
                result.pointMiddle := p2
                result.pointSecond := p3
                result.barBase := b0
                result.barFirst := b1
                result.barMiddle := b2
                result.barSecond := b3
                result.targetPrice := targetPrice
                result.similarity := similarity
                result.valleyDepth := valleyDepth
                result.peakHeight := peakHeight
        
        result
