//@version=6
indicator("Rumers Magic Lines", overlay = true, max_lines_count = 56, max_labels_count = 56)

string displayGroup = "Previous Day Rumers Lines"
bool showLevels = input.bool(true, "Show levels", group = displayGroup)
int daysToShow = input.int(1, "Previous days to show", minval = 1, maxval = 14, group = displayGroup)
int lineWidth = input.int(1, "Line width", minval = 1, maxval = 4, group = displayGroup)
color swingColor = input.color(color.red, "Swing high / low color", group = displayGroup)
color rangeColor = input.color(color.orange, "Range high / low color", group = displayGroup)

string rangeTimeZone = "America/Chicago"

getRangeStart(int barTime) =>
    int sevenAm = timestamp(
         rangeTimeZone,
         year(barTime, rangeTimeZone),
         month(barTime, rangeTimeZone),
         dayofmonth(barTime, rangeTimeZone),
         7,
         0)
    int rangeDateReference = barTime >= sevenAm ? barTime : barTime - 12 * 60 * 60 * 1000
    timestamp(
         rangeTimeZone,
         year(rangeDateReference, rangeTimeZone),
         month(rangeDateReference, rangeTimeZone),
         dayofmonth(rangeDateReference, rangeTimeZone),
         7,
         0)

hourlyRumerLevels() =>
    var array<int> candleTimes = array.new<int>()
    var array<float> candleHighs = array.new<float>()
    var array<float> candleLows = array.new<float>()

    array.push(candleTimes, time)
    array.push(candleHighs, high)
    array.push(candleLows, low)

    if array.size(candleTimes) > 10000
        array.shift(candleTimes)
        array.shift(candleHighs)
        array.shift(candleLows)

    int activeRangeStart = getRangeStart(time)
    bool startsNewRange = not na(activeRangeStart[1]) and activeRangeStart != activeRangeStart[1]
    var float activeHigh = na
    var float activeLow = na
    var int completedRangeStart = na
    var float completedRangeHigh = na
    var float completedRangeLow = na
    var int selectedSwingHighTime = na
    var float selectedSwingHigh = na
    var int selectedSwingLowTime = na
    var float selectedSwingLow = na

    if na(activeHigh)
        activeHigh := high
        activeLow := low
    else if startsNewRange
        completedRangeStart := activeRangeStart[1]
        completedRangeHigh := activeHigh
        completedRangeLow := activeLow
        selectedSwingHighTime := na
        selectedSwingHigh := na
        selectedSwingLowTime := na
        selectedSwingLow := na

        int candleCount = array.size(candleTimes)

        if candleCount > 0
            for offset = 0 to candleCount - 1
                int candidateIndex = candleCount - 1 - offset
                int candidateTime = array.get(candleTimes, candidateIndex)

                if candidateTime < completedRangeStart
                    float candidateHigh = array.get(candleHighs, candidateIndex)
                    float candidateLow = array.get(candleLows, candidateIndex)

                    if na(selectedSwingHigh) and candidateHigh > completedRangeHigh
                        selectedSwingHighTime := candidateTime
                        selectedSwingHigh := candidateHigh

                    if na(selectedSwingLow) and candidateLow < completedRangeLow
                        selectedSwingLowTime := candidateTime
                        selectedSwingLow := candidateLow

                    if not na(selectedSwingHigh) and not na(selectedSwingLow)
                        break

        activeHigh := high
        activeLow := low
    else
        activeHigh := math.max(activeHigh, high)
        activeLow := math.min(activeLow, low)

    [completedRangeStart, completedRangeHigh, completedRangeLow, selectedSwingHighTime, selectedSwingHigh, selectedSwingLowTime, selectedSwingLow]

[previousRangeStartTime, previousRangeHigh, previousRangeLow, previousSwingHighTime, previousSwingHigh, previousSwingLowTime, previousSwingLow] = request.security(
     syminfo.tickerid,
     "60",
     hourlyRumerLevels(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off,
     calc_bars_count = 10000)

bool newRange = not na(previousRangeStartTime) and (na(previousRangeStartTime[1]) or previousRangeStartTime != previousRangeStartTime[1])

var array<line> levelLines = array.new<line>()
var array<label> levelLabels = array.new<label>()
var array<int> levelGroupSizes = array.new<int>()

if showLevels and newRange and not na(previousRangeHigh)
    while array.size(levelGroupSizes) >= daysToShow
        int expiredGroupSize = array.shift(levelGroupSizes)
        if expiredGroupSize > 0
            for objectIndex = 0 to expiredGroupSize - 1
                line.delete(array.shift(levelLines))
                label.delete(array.shift(levelLabels))

    int groupSize = 2
    int lineEnd = previousRangeStartTime + 24 * 60 * 60 * 1000

    array.push(levelLines, line.new(previousRangeStartTime, previousRangeHigh, lineEnd, previousRangeHigh, xloc = xloc.bar_time, extend = extend.right, color = rangeColor, width = lineWidth))
    array.push(levelLines, line.new(previousRangeStartTime, previousRangeLow, lineEnd, previousRangeLow, xloc = xloc.bar_time, extend = extend.right, color = rangeColor, width = lineWidth))
    array.push(levelLabels, label.new(previousRangeStartTime, previousRangeHigh, "Range High", xloc = xloc.bar_time, style = label.style_label_right, color = rangeColor, textcolor = color.white, size = size.small))
    array.push(levelLabels, label.new(previousRangeStartTime, previousRangeLow, "Range Low", xloc = xloc.bar_time, style = label.style_label_right, color = rangeColor, textcolor = color.white, size = size.small))

    if not na(previousSwingHigh)
        array.push(levelLines, line.new(previousSwingHighTime, previousSwingHigh, lineEnd, previousSwingHigh, xloc = xloc.bar_time, extend = extend.right, color = swingColor, width = lineWidth))
        array.push(levelLabels, label.new(previousSwingHighTime, previousSwingHigh, "Swing High", xloc = xloc.bar_time, style = label.style_label_right, color = swingColor, textcolor = color.white, size = size.small))
        groupSize += 1

    if not na(previousSwingLow)
        array.push(levelLines, line.new(previousSwingLowTime, previousSwingLow, lineEnd, previousSwingLow, xloc = xloc.bar_time, extend = extend.right, color = swingColor, width = lineWidth))
        array.push(levelLabels, label.new(previousSwingLowTime, previousSwingLow, "Swing Low", xloc = xloc.bar_time, style = label.style_label_right, color = swingColor, textcolor = color.white, size = size.small))
        groupSize += 1

    array.push(levelGroupSizes, groupSize)
