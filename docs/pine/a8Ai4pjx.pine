//@version=6

library("CoreTFRSIMD", false)

// --- Core: TFRSI & MD ---
// Library for TFRSI (Transformed Filtered RSI) calculation.
// Exports functions for reusable indicators.
// Usage: import username/CoreTFRSIMD/1
// Then: tfrsi = CoreTFRSIMD.calcTfrsi(close, 6, 2)

// ================== TFRSI ==================
// Exported function to calculate TFRSI
export calcTfrsi(float src, int len, int signalLen) =>
    // High-pass Filter (hp)
    var float hp = na
    hp := 2500.0 * (src - 2.0 * nz(src[1]) + nz(src[2])) + 1.92 * nz(hp[1]) - 0.9216 * nz(hp[2])
    
    // Alpha-Filter (ag) - SuperSmoother-like
    a1 = math.exp(-math.sqrt(2.0) * math.pi / len)
    b1 = 2.0 * a1 * math.cos(math.sqrt(2.0) * math.pi / len)
    c2 = b1
    c3 = -a1 * a1
    c1 = 1.0 - c2 - c3
    var float ag = na
    ag := c1 * (hp + nz(hp[1])) / 2.0 + c2 * nz(ag[1]) + c3 * nz(ag[2])
    
    // Smoothed Percentile (sp)
    var float sp = na
    sp := 0.991 * nz(sp[1])
    sp := math.abs(ag) > sp ? math.abs(ag) : sp
    
    // Normalized x and q1
    x = sp != 0.0 ? ag / sp : 0.0
    q1 = x * 60.0 + 50.0
    
    // Signal smoothing
    ta.sma(q1, signalLen)

// Demo: Direct TFRSI (default parameters)
tfrsi = calcTfrsi(close, 6, 2)
tfrsiPlot = plot(tfrsi)
rsiUpperBand = hline(100, "RSI Upper Band", color = #787B86)
hline(50, "RSI Middle Band", color = color.new(#787B86, 50))
rsiLowerBand = hline(0, "RSI Lower Band", color = #787B86)
midLinePlot = plot(50, color = na, editable = false, display = display.none)
fill(rsiUpperBand, rsiLowerBand, color = color.rgb(126, 87, 194, 90), title = "RSI Background Fill")
fill(tfrsiPlot, midLinePlot, 110, 100, top_color = color.new(color.green, 0), bottom_color = color.new(color.green, 100), title = "Overbought Gradient Fill")
fill(tfrsiPlot, midLinePlot, 0, -10, top_color = color.new(color.red, 100), bottom_color = color.new(color.red, 0), title = "Oversold Gradient Fill")
