// @version=5

// @description Provides a set of utility functions for use in strategies or indicators.
library("utils", true)


export colorGreen(int opacity = 0) => color.rgb(66, 219, 104, opacity)
export colorRed(int opacity = 0) => color.rgb(214, 43, 63, opacity)
export colorTeal(int opacity = 0) => color.rgb(32, 229, 232, opacity)
export colorBlue(int opacity = 0) => color.rgb(32, 81, 229, opacity)
export colorOrange(int opacity = 0) => color.rgb(232, 165, 32, opacity)
export colorPurple(int opacity = 0) => color.rgb(197, 39, 232, opacity)
export colorPink(int opacity = 0) => color.rgb(235, 122, 197, opacity)
export colorYellow(int opacity = 0) => color.rgb(237, 229, 66, opacity)
export colorWhite(int opacity = 0) => color.rgb(255, 255, 255, opacity)
export colorBlack(int opacity = 0) => color.rgb(0, 0, 0, opacity)

// @function Signals when the trend is starting to change in a positive direction.
// @returns bool
export trendChangingUp(float emaShort, float emaLong) =>
    isUptrend = emaShort > emaLong
    ta.cross(emaShort, emaLong) and isUptrend

// @function Signals when the trend is starting to change in a negative direction.
// @returns bool
export trendChangingDown(float emaShort, float emaLong) =>
    isDowntrend = emaShort < emaLong
    ta.cross(emaShort, emaLong) and isDowntrend

// @function Returns the percent change between a start number and end number. A positive change returns a positive value and vice versa.
// @returns float
export percentChange(float start, float end) =>
    increased = end > start
    diff = increased ? end - start : start - end
    result = 0.0

    if increased
        result := (diff / start) * 100
    else
        result := -1 * ((diff / start) * 100)
        
// @function Returns the number that's the percentage of the provided value.
// @param percent Use 0.2 for 20 percent, 0.35 for 35 percent, etc.
// @param n       The number to calculate the percentage of.
// @returns float
export percentOf(float percent, float n) =>
    percent * n
    
export targetPriceByPercent(float percent, float n) =>
    delta = percent * n
    n + delta
        
export hasNegativeSlope(float start, float end) => end < start

// @function Returns true when the current time is within a given session window. Note, the time is calculated in the "America/New_York" timezone.
// @param resolution The time interval to use to start/end the background color. Use "1" for the coloring the background up to the minute.
// @param session The session string to use to identify the time window. Example: "0930-1600:23456" means normal market hours on weekdays.
// @returns series bool        
export timeinrange(simple string resolution, simple string session, simple string timezone) => not na(time(resolution, session, timezone)) ? true : false

// @function Returns the number of bars since the last entry order.
// @returns series int 
export barsSinceLastEntry() => strategy.opentrades > 0 ? (bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)) : na

// @function Returns the number of bars since the last exit order.
// @returns series int 
export barsSinceLastExit() => strategy.closedtrades > 0 ? (bar_index - strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1)) : na

// @function Calculates the slope of the provided line based on its x,y coordinates in the previous bar to the current bar.
// @returns series float 
export calcSlope(float ln, int lookback) =>
    x1 = bar_index - lookback
    x2 = bar_index
    y1 = ln[lookback]
    y2 = ln[0]
    rise = y2 - y1
    run = x2 - x1
    rise / run
    
// @function Returns slope of the line given the start and end x,y coordinates.
// @returns series float  
export openPL() =>
    result = 0.0
    for i = 0 to strategy.opentrades - 1
        result += strategy.opentrades.profit(i)
    result
    
// @function Returns true if the number of consecutive red candles matches the provided count.
// @param lookbackInput The amount of bars to look back to check for consecutive negative bars. Default = 1.
// @returns series bool  
export hasConsecutiveNegativeCandles(int lookbackInput = 1) =>
    result = false
    lookback = lookbackInput
    barsCount = 0
    
    for i = 0 to lookbackInput
        if close[i] < open[i]
            barsCount += 1 
            
    barsCount == lookback
            
// @function Returns the standard deviation as a percentage of price.
// @param stdev The standard deviation value
// @param price The current price of the target ticker.
// @returns series float   
export stdevPercent(float stdev, float price) =>
    n = stdev / price
    n * 100
    
    
    



