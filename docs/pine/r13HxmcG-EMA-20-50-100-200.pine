//@version=6
indicator(title = "EMA 20/50/100/200", overlay = true)

ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

plot(
     ema20,
     title = "EMA 20",
     color = color.green,
     linewidth = 3,
     linestyle = plot.linestyle_dashed
)

plot(
     ema50,
     title = "EMA 50",
     color = color.yellow,
     linewidth = 3,
     linestyle = plot.linestyle_dashed
)

plot(
     ema100,
     title = "EMA 100",
     color = color.orange,
     linewidth = 3,
     linestyle = plot.linestyle_dashed
)

plot(
     ema200,
     title = "EMA 200",
     color = color.red,
     linewidth = 3,
     linestyle = plot.linestyle_dashed
)