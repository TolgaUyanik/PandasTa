//@version=6

// @description metaconnector
library("metaconnector")

// @function Places a buy market order
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to buy
// @returns String syntax for the buy market order
export buy_market_order(string License_ID, string symbol, string lot) =>
    syntax = License_ID + ',' + 'buy' + ',' + symbol + ',' + lot
    syntax

// @function Places a sell market order
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to sell
// @returns String syntax for the sell market order
export sell_market_order(string License_ID, string symbol, string lot) =>
    syntax = License_ID + ',' + 'sell' + ',' + symbol + ',' + lot
    syntax

// @function Places a buy limit order
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to buy
// @param price Limit price for the order
// @returns String syntax for the buy limit order
export buy_limit_order(string License_ID, string symbol, string lot, float price) =>
    syntax = License_ID + ',' + 'buylimit' + ',' + symbol + ',' +lot + ',' + str.tostring(price)
    syntax

// @function Places a sell limit order
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to sell
// @param price Limit price for the order
// @returns String syntax for the sell limit order
export sell_limit_order(string License_ID, string symbol, string lot, float price) =>
    syntax = License_ID + ',' + 'selllimit' + ',' + symbol + ',' + lot + ',' + str.tostring(price)
    syntax

// @function Places a stop-loss order for a buy position
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to buy
// @param price Stop-loss price
// @returns String syntax for the buy stop-loss order
export stoploss_for_buy_order(string License_ID, string symbol, string lot, float stoploss_price) =>
    syntax = License_ID + ',' + 'buysl' + ',' + symbol + ',' + lot + ',' + str.tostring(stoploss_price)
    syntax

// @function Places a stop-loss order for a sell position
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to sell
// @param price Stop-loss price
// @returns String syntax for the sell stop-loss order
export stoploss_for_sell_order(string License_ID, string symbol, string lot, float stoploss_price) =>
    syntax = License_ID + ',' + 'sellsl' + ',' + symbol + ',' + lot + ',' + str.tostring(stoploss_price)
    syntax

// @function Places a take-profit order for a buy position
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to buy
// @param price Target price
// @returns String syntax for the buy take-profit order
export takeprofit_for_buy_order(string License_ID, string symbol, string lot, float target_price) =>
    syntax = License_ID + ',' + 'buytp' + ',' + symbol + ',' + lot + ',' + str.tostring(target_price)
    syntax

// @function Places a take-profit order for a sell position
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to sell
// @param price Target price
// @returns String syntax for the sell take-profit order
export takeprofit_for_sell_order(string License_ID, string symbol, string lot, float target_price) =>
    syntax = License_ID + ',' + 'selltp' + ',' + symbol + ',' +lot+ ',' + str.tostring(target_price)
    syntax

// @function Places a buy stop order above the current market price
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to buy
// @param price Stop order price
// @returns String syntax for the buy stop order
export buy_stop_order(string License_ID, string symbol, string lot, float price) =>
    syntax = License_ID + ',' + 'buystop' + ',' + symbol + ',' + lot + ',' + str.tostring(price)
    syntax

// @function Places a sell stop order below the current market price
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to sell
// @param price Stop order price
// @returns String syntax for the sell stop order
export sell_stop_order(string License_ID, string symbol, string lot, float price) =>
    syntax = License_ID + ',' + 'sellstop' + ',' + symbol + ',' + lot + ',' + str.tostring(price)
    syntax

// @function Closes all positions for a specific symbol
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @returns String syntax for closing all positions
export close_all_positions(string License_ID, string symbol) =>
    syntax = License_ID + ',' + 'closeall' + ',' + symbol
    syntax

// @function Closes all buy positions for a specific symbol
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @returns String syntax for closing all buy positions
export close_buy_positions(string License_ID, string symbol) =>
    syntax = License_ID + ',' + 'closebuy' + ',' + symbol
    syntax

// @function Closes all sell positions for a specific symbol
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @returns String syntax for closing all sell positions
export close_sell_positions(string License_ID, string symbol) =>
    syntax = License_ID + ',' + 'closesell' + ',' + symbol
    syntax

// @function Closes a partial buy position for a specific symbol
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to close
// @returns String syntax for closing a partial buy position
export close_partial_buy_position(string License_ID, string symbol, string lot) =>
    syntax = License_ID + ',' + 'closebuy' + ',' + symbol + ',' + lot
    syntax

// @function Closes a partial sell position for a specific symbol
// @param License_ID Unique license ID of the user
// @param symbol Trading symbol
// @param lot Number of lots to close
// @returns String syntax for closing a partial sell position
export close_partial_sell_position(string License_ID, string symbol, string lot) =>
    syntax = License_ID + ',' + 'closesell' + ',' + symbol + ',' + lot
    syntax
