// Variables to track swing points for CHOCH lines
var float last_swing_high = na
var float last_swing_low = na
var int last_swing_high_bar = na
var int last_swing_low_bar = na

// Variables to track BOS levels
var float last_bos_high = na
var float last_bos_low = na

// Variables to track banker candles
var bool last_bullish_banker = false
var bool last_bearish_banker = false

// Variables to track active FVGs and OBs for zone detection
var active_bull_fvg_zones = array.new<float>()
var active_bear_fvg_zones = array.new<float>()
var active_bull_ob_zones = array.new<float>()
var active_bear_ob_zones = array.new<float>()

// Function to detect Fair Value Gaps with reduced repainting
detect_fvg() =>
    // Use confirmed bars to reduce repainting
    // Bullish FVG: Gap between previous high and current low
    bullish_fvg = low > high[2] and math.abs(low - high[2]) > min_fvg_size
    bullish_fvg_top = bullish_fvg ? low : na
    bullish_fvg_bottom = bullish_fvg ? high[2] : na
    
    // Bearish FVG: Gap between previous low and current high
    bearish_fvg = high < low[2] and math.abs(low[2] - high) > min_fvg_size
    bearish_fvg_top = bearish_fvg ? low[2] : na
    bearish_fvg_bottom = bearish_fvg ? high : na
    
    [bullish_fvg, bullish_fvg_top, bullish_fvg_bottom, bearish_fvg, bearish_fvg_top, bearish_fvg_bottom]

// Function to detect Order Blocks with reduced repainting
detect_order_block() =>
    // Bullish Order Block: Strong buying pressure after a downtrend
    bullish_ob = false
    bullish_ob_top = 0.0
    bullish_ob_bottom = 0.0
    
    // Bearish Order Block: Strong selling pressure after an uptrend
    bearish_ob = false
    bearish_ob_top = 0.0
    bearish_ob_bottom = 0.0
    
    // Look for significant price moves (use historical bars for stability)
    if close[1] > open[1] and close[2] < open[2] and close[3] < open[3]
        if (close[1] - open[1]) > (high[1] - low[1]) * 0.7 // Strong bullish candle
            bullish_ob := true
            bullish_ob_top := high[1]
            bullish_ob_bottom := low[1]
    
    if close[1] < open[1] and close[2] > open[2] and close[3] > open[3]
        if (open[1] - close[1]) > (high[1] - low[1]) * 0.7 // Strong bearish candle
            bearish_ob := true
            bearish_ob_top := high[1]
            bearish_ob_bottom := low[1]
    
    [bullish_ob, bullish_ob_top, bullish_ob_bottom, bearish_ob, bearish_ob_top, bearish_ob_bottom]

// Function to check if price is in an active zone
check_price_in_zones() =>
    in_bull_fvg = false
    in_bear_fvg = false
    in_bull_ob = false
    in_bear_ob = false
    
    // Check bullish FVG zones
    if array.size(active_bull_fvg_zones) >= 2
        for i = 0 to array.size(active_bull_fvg_zones) - 1 by 2
            top = array.get(active_bull_fvg_zones, i)
            bottom = array.get(active_bull_fvg_zones, i + 1)
            if close <= top and close >= bottom
                in_bull_fvg := true
                break
    
    // Check bearish FVG zones
    if array.size(active_bear_fvg_zones) >= 2
        for i = 0 to array.size(active_bear_fvg_zones) - 1 by 2
            top = array.get(active_bear_fvg_zones, i)
            bottom = array.get(active_bear_fvg_zones, i + 1)
            if close <= top and close >= bottom
                in_bear_fvg := true
                break
    
    // Check bullish OB zones
    if array.size(active_bull_ob_zones) >= 2
        for i = 0 to array.size(active_bull_ob_zones) - 1 by 2
            top = array.get(active_bull_ob_zones, i)
            bottom = array.get(active_bull_ob_zones, i + 1)
            if close <= top and close >= bottom
                in_bull_ob := true
                break
    
    // Check bearish OB zones
    if array.size(active_bear_ob_zones) >= 2
        for i = 0 to array.size(active_bear_ob_zones) - 1 by 2
            top = array.get(active_bear_ob_zones, i)
            bottom = array.get(active_bear_ob_zones, i + 1)
            if close <= top and close >= bottom
                in_bear_ob := true
                break
    
    [in_bull_fvg, in_bear_fvg, in_bull_ob, in_bear_ob]

// Function to check volume confirmation
volume_confirmed() =>
    if not use_volume_filter
        true
    else
        avg_volume = ta.sma(volume, volume_lookback)
        volume > avg_volume * volume_multiplier

// Function to detect swing points
detect_swing_points() =>
    // Swing high: current high is higher than previous and next highs
    swing_high = high > high[1] and high[1] > high[2] and high > high[2]
    swing_high_price = swing_high ? high[1] : na
    swing_high_bar = swing_high ? bar_index[1] : na
    
    // Swing low: current low is lower than previous and next lows
    swing_low = low < low[1] and low[1] < low[2] and low < low[2]
    swing_low_price = swing_low ? low[1] : na
    swing_low_bar = swing_low ? bar_index[1] : na
    
    [swing_high, swing_high_price, swing_high_bar, swing_low, swing_low_price, swing_low_bar]

// Function to detect banker candles (institutional rejection candles)
detect_banker_candles() =>
    // Volume analysis
    avg_volume = ta.sma(volume, volume_lookback)
    high_volume = volume > avg_volume * banker_volume_threshold
    
    // Candle body and wick analysis
    candle_range = high - low
    candle_body = math.abs(close - open)
    body_ratio = candle_body / candle_range
    
    // Bullish banker candle (rejection from lows)
    lower_wick = (close > open ? open : close) - low
    upper_wick = high - (close > open ? close : open)
    lower_wick_ratio = lower_wick / candle_range
    
    bullish_banker = high_volume and body_ratio <= banker_body_ratio and lower_wick_ratio >= banker_wick_ratio and close > open and candle_range > ta.atr(14) * 1.2
    
    // Bearish banker candle (rejection from highs)
    upper_wick_ratio = upper_wick / candle_range
    
    bearish_banker = high_volume and body_ratio <= banker_body_ratio and upper_wick_ratio >= banker_wick_ratio and close < open and candle_range > ta.atr(14) * 1.2
    
    [bullish_banker, bearish_banker]

// Function to detect market structure (BOS/ChoCh)
detect_market_structure() =>
    // Calculate recent highs and lows
    recent_high = ta.highest(high, structure_lookback)
    recent_low = ta.lowest(low, structure_lookback)
    
    // Break of Structure detection
    bullish_bos = close > recent_high[1] and (close - recent_high[1]) / recent_high[1] > min_structure_move
    bearish_bos = close < recent_low[1] and (recent_low[1] - close) / recent_low[1] > min_structure_move
    
    // Change of Character detection (reversal)
    prev_trend_up = close[1] > close[5] and close[5] > close[10]
    prev_trend_down = close[1] < close[5] and close[5] < close[10]
    
    bullish_choch = prev_trend_down and close > recent_high[1]
    bearish_choch = prev_trend_up and close < recent_low[1]
    
    // Overall structure bias
    structure_bullish = bullish_bos or bullish_choch
    structure_bearish = bearish_bos or bearish_choch
    structure_neutral = not structure_bullish and not structure_bearish
    
    // Return BOS levels for updating outside the function
    new_bos_high = bullish_bos ? recent_high[1] : na
    new_bos_low = bearish_bos ? recent_low[1] : na
    
    [structure_bullish, structure_bearish, structure_neutral, bullish_bos, bearish_bos, bullish_choch, bearish_choch, new_bos_high, new_bos_low]

// Function to calculate key level confluence
calculate_key_level_confluence() =>
    confluence_count = 0
    confluence_details = ""
    
    // Check if price is near moving averages
    if show_ma_confluence
        near_fast_ma = math.abs(close - ema_fast) / close < 0.002
        near_slow_ma = math.abs(close - ema_slow) / close < 0.002
        
        if near_fast_ma
            confluence_count += 1
            confluence_details += "FastMA "
        if near_slow_ma
            confluence_count += 1
            confluence_details += "SlowMA "
    
    // Check if price is near swing levels
    if not na(last_swing_high)
        near_swing_high = math.abs(close - last_swing_high) / close < 0.003
        if near_swing_high
            confluence_count += 1
            confluence_details += "SwingH "
    
    if not na(last_swing_low)
        near_swing_low = math.abs(close - last_swing_low) / close < 0.003
        if near_swing_low
            confluence_count += 1
            confluence_details += "SwingL "
    
    // Check if we're in a strong trend across timeframes
    strong_bull_trend = strength_1h > 70 and strength_4h > 70
    strong_bear_trend = strength_1h < 30 and strength_4h < 30
    
    if strong_bull_trend
        confluence_count += 2
        confluence_details += "StrongBull "
    else if strong_bear_trend
        confluence_count += 2
        confluence_details += "StrongBear "
    
    [confluence_count, confluence_details]

// Enhanced confluence scoring function with weighted factors
calculate_confluence_score(is_bullish_signal) =>
    score = 0.0
    max_score = 0.0
    
    // Market Structure Score
    [struct_bull, struct_bear, struct_neutral, bull_bos, bear_bos, bull_choch, bear_choch, temp_bos_high, temp_bos_low] = detect_market_structure()
    structure_score = 0.0
    if is_bullish_signal and struct_bull
        structure_score := 10
    else if not is_bullish_signal and struct_bear
        structure_score := 10
    else if struct_neutral
        structure_score := 5
    score += structure_score * weight_structure / 10
    max_score += weight_structure
    
    // Volume Score
    volume_score = volume_confirmed() ? 10 : 0
    score += volume_score * weight_volume / 10
    max_score += weight_volume
    
    // Timeframe Alignment Score
    tf_alignment_score = 0.0
    tf_alignment_score += (close_5m > open_5m) == is_bullish_signal ? 2 : 0
    tf_alignment_score += (close_15m > open_15m) == is_bullish_signal ? 2 : 0
    tf_alignment_score += (close_1h > open_1h) == is_bullish_signal ? 2 : 0
    tf_alignment_score += (close_4h > open_4h) == is_bullish_signal ? 2 : 0
    tf_alignment_score += (close_1d > open_1d) == is_bullish_signal ? 2 : 0
    score += tf_alignment_score * weight_timeframe / 10
    max_score += weight_timeframe
    
    // ML Pattern Score
    if enable_ml_patterns
        ml_score = ml_prediction > ml_min_accuracy ? 10 : ml_prediction / 10
        score += ml_score * weight_ml / 10
        max_score += weight_ml
    
    // Sentiment Score
    if enable_sentiment
        sentiment_score = 0.0
        if is_bullish_signal
            sentiment_score := market_sentiment > 70 ? 10 : market_sentiment > 50 ? 5 : 0
        else
            sentiment_score := market_sentiment < 30 ? 10 : market_sentiment < 50 ? 5 : 0
        score += sentiment_score * weight_sentiment / 10
        max_score += weight_sentiment
    
    // Normalize to 10-point scale
    final_score = max_score > 0 ? (score / max_score) * 10 : 0
    math.min(10, final_score)

// Function to draw trend direction arrows
draw_trend_arrow() =>
    if show_trend_arrows and bar_index % 10 == 0 // Draw every 10 bars
        // Calculate overall trend direction
        avg_strength = (strength_current + strength_1h + strength_4h) / 3
        
        // Determine arrow direction and color
        if avg_strength > 65
            arrow_label = label.new(bar_index, high * 1.01, "⬆", color=color.new(color.green, 100), textcolor=color.green, size=size.large, style=label.style_label_down)
            array.push(trend_arrows, arrow_label)
        else if avg_strength < 35
            arrow_label = label.new(bar_index, low * 0.99, "⬇", color=color.new(color.red, 100), textcolor=color.red, size=size.large, style=label.style_label_up)
            array.push(trend_arrows, arrow_label)
        
        // Clean old arrows
        if array.size(trend_arrows) > 20
            old_arrow = array.shift(trend_arrows)
            label.delete(old_arrow)

// Function to draw BOS horizontal lines
draw_bos_line(is_bullish_bos, is_bearish_bos) =>
    if show_bos_lines
        if is_bullish_bos and not na(last_bos_high)
            // Draw horizontal line at the BOS high level
            bos_line = line.new(bar_index - 20, last_bos_high, bar_index + 20, last_bos_high, color=color.new(color.green, 50), width=2, style=line.style_dashed, extend=extend.none)
            array.push(bos_lines, bos_line)
            
            // Add BOS label
            bos_label = label.new(bar_index, last_bos_high, "BOS↑", color=color.new(color.green, 0), textcolor=color.white, size=size.small, style=label.style_label_down)
            array.push(bos_labels, bos_label)
            
            // Clean old lines
            if array.size(bos_lines) > 50
                old_line = array.shift(bos_lines)
                line.delete(old_line)
            if array.size(bos_labels) > 50
                old_label = array.shift(bos_labels)
                label.delete(old_label)
        
        if is_bearish_bos and not na(last_bos_low)
            // Draw horizontal line at the BOS low level
            bos_line = line.new(bar_index - 20, last_bos_low, bar_index + 20, last_bos_low, color=color.new(color.red, 50), width=2, style=line.style_dashed, extend=extend.none)
            array.push(bos_lines, bos_line)
            
            // Add BOS label
            bos_label = label.new(bar_index, last_bos_low, "BOS↓", color=color.new(color.red, 0), textcolor=color.white, size=size.small, style=label.style_label_up)
            array.push(bos_labels, bos_label)
            
            // Clean old lines
            if array.size(bos_lines) > 50
                old_line = array.shift(bos_lines)
                line.delete(old_line)
            if array.size(bos_labels) > 50
                old_label = array.shift(bos_labels)
                label.delete(old_label)

// Function to draw CHOCH horizontal lines
draw_choch_line(is_bullish_choch, is_bearish_choch) =>
    if show_choch_lines
        if is_bullish_choch and not na(last_swing_low)
            // Draw horizontal line at the swing low level
            choch_line = line.new(bar_index - 20, last_swing_low, bar_index + 20, last_swing_low, color=color.green, width=2, style=line.style_solid, extend=extend.none)
            array.push(choch_lines, choch_line)
            
            // Add CHOCH label
            choch_label = label.new(bar_index, last_swing_low, "CHOCH↑", color=color.new(color.green, 0), textcolor=color.white, size=size.normal, style=label.style_label_down)
            array.push(choch_labels, choch_label)
            
            // Clean old lines
            if array.size(choch_lines) > 50
                old_line = array.shift(choch_lines)
                line.delete(old_line)
            if array.size(choch_labels) > 50
                old_label = array.shift(choch_labels)
                label.delete(old_label)
        
        if is_bearish_choch and not na(last_swing_high)
            // Draw horizontal line at the swing high level
            choch_line = line.new(bar_index - 20, last_swing_high, bar_index + 20, last_swing_high, color=color.red, width=2, style=line.style_solid, extend=extend.none)
            array.push(choch_lines, choch_line)
            
            // Add CHOCH label
            choch_label = label.new(bar_index, last_swing_high, "CHOCH↓", color=color.new(color.red, 0), textcolor=color.white, size=size.normal, style=label.style_label_up)
            array.push(choch_labels, choch_label)
            
            // Clean old lines
            if array.size(choch_lines) > 50
                old_line = array.shift(choch_lines)
                line.delete(old_line)
            if array.size(choch_labels) > 50
                old_label = array.shift(choch_labels)
                label.delete(old_label)

// Function to get structure filter
get_structure_filter(is_bullish_signal) =>
    if not use_structure_filter
        true
    else
        [struct_bull, struct_bear, struct_neutral, bull_bos, bear_bos, bull_choch, bear_choch, temp_bos_high, temp_bos_low] = detect_market_structure()
        if is_bullish_signal
            struct_bull or struct_neutral
        else
            struct_bear or struct_neutral

// Function to check if price is within a range
price_in_range(price, top, bottom) =>
    price <= math.max(top, bottom) and price >= math.min(top, bottom)

// Enhanced FVG detection with volume confirmation
detect_fvg_enhanced() =>
    // Original FVG detection
    [base_bull_fvg, bull_top, bull_bottom, base_bear_fvg, bear_top, bear_bottom] = detect_fvg()
    
    // Volume confirmation
    vol_confirmed = volume_confirmed()
    
    // Apply volume filter
    bullish_fvg = base_bull_fvg and vol_confirmed
    bearish_fvg = base_bear_fvg and vol_confirmed
    
    bullish_fvg_top = bullish_fvg ? bull_top : na
    bullish_fvg_bottom = bullish_fvg ? bull_bottom : na
    bearish_fvg_top = bearish_fvg ? bear_top : na
    bearish_fvg_bottom = bearish_fvg ? bear_bottom : na
    
    [bullish_fvg, bullish_fvg_top, bullish_fvg_bottom, bearish_fvg, bearish_fvg_top, bearish_fvg_bottom]

// Enhanced Order Block detection with volume and structure
detect_order_block_enhanced() =>
    [base_bull_ob, bull_top, bull_bottom, base_bear_ob, bear_top, bear_bottom] = detect_order_block()
    
    // Volume confirmation
    vol_confirmed = volume_confirmed()
    
    // Apply filters
    bullish_ob = base_bull_ob and vol_confirmed
    bearish_ob = base_bear_ob and vol_confirmed
    
    bullish_ob_top = bullish_ob ? bull_top : na
    bullish_ob_bottom = bullish_ob ? bull_bottom : na
    bearish_ob_top = bearish_ob ? bear_top : na
    bearish_ob_bottom = bearish_ob ? bear_bottom : na
    
    [bullish_ob, bullish_ob_top, bullish_ob_bottom, bearish_ob, bearish_ob_top, bearish_ob_bottom]

// Function to clean old boxes and labels
clean_old_boxes(boxes_array, labels_array, max_count) =>
    while array.size(boxes_array) > max_count
        old_box = array.shift(boxes_array)
        box.delete(old_box)
        if array.size(labels_array) > 0
            old_label = array.shift(labels_array)
            label.delete(old_label)

// Main logic with enhanced detection
[bull_fvg, bull_fvg_top, bull_fvg_bottom, bear_fvg, bear_fvg_top, bear_fvg_bottom] = detect_fvg_enhanced()
[bull_ob, bull_ob_top, bull_ob_bottom, bear_ob, bear_ob_top, bear_ob_bottom] = detect_order_block_enhanced()

// Get swing points
[swing_high_detected, swing_high_price, swing_high_bar, swing_low_detected, swing_low_price, swing_low_bar] = detect_swing_points()

// Get banker candles
[bull_banker, bear_banker] = detect_banker_candles()

// Update tracking variables
if bull_banker
    last_bullish_banker := true
if bear_banker
    last_bearish_banker := true

// Reset banker flags after some bars (to prevent stale signals)
if bar_index % 10 == 0
    last_bullish_banker := false
    last_bearish_banker := false

// Update swing point tracking
if swing_high_detected
    last_swing_high := swing_high_price
    last_swing_high_bar := swing_high_bar

if swing_low_detected
    last_swing_low := swing_low_price
    last_swing_low_bar := swing_low_bar

// Get market structure information
[struct_bullish, struct_bearish, struct_neutral, bos_bull, bos_bear, choch_bull, choch_bear, new_bos_high, new_bos_low] = detect_market_structure()

// Update BOS levels in global scope
if not na(new_bos_high)
    last_bos_high := new_bos_high
if not na(new_bos_low)
    last_bos_low := new_bos_low

// Draw CHOCH trend lines
draw_choch_line(choch_bull, choch_bear)

// Draw BOS lines
draw_bos_line(bos_bull, bos_bear)

// Draw trend direction arrows
draw_trend_arrow()

// Update active zone arrays (with memory management)
if bull_fvg
    array.push(active_bull_fvg_zones, bull_fvg_top)
    array.push(active_bull_fvg_zones, bull_fvg_bottom)
    // Keep only recent zones (last 10 FVGs)
    while array.size(active_bull_fvg_zones) > 20
        array.shift(active_bull_fvg_zones)
        array.shift(active_bull_fvg_zones)

if bear_fvg
    array.push(active_bear_fvg_zones, bear_fvg_top)
    array.push(active_bear_fvg_zones, bear_fvg_bottom)
    while array.size(active_bear_fvg_zones) > 20
        array.shift(active_bear_fvg_zones)
        array.shift(active_bear_fvg_zones)

if bull_ob
    array.push(active_bull_ob_zones, bull_ob_top)
    array.push(active_bull_ob_zones, bull_ob_bottom)
    while array.size(active_bull_ob_zones) > 10
        array.shift(active_bull_ob_zones)
        array.shift(active_bull_ob_zones)

if bear_ob
    array.push(active_bear_ob_zones, bear_ob_top)
    array.push(active_bear_ob_zones, bear_ob_bottom)
    while array.size(active_bear_ob_zones) > 10
        array.shift(active_bear_ob_zones)
        array.shift(active_bear_ob_zones)

// Draw Banker Candles
if show_banker_candles
    if bull_banker
        banker_label = label.new(bar_index, low, "BANKER", color=bullish_banker_color, textcolor=color.white, size=size.small, style=label.style_label_up)
        array.push(banker_labels, banker_label)
        
        // Clean old labels
        if array.size(banker_labels) > 50
            old_label = array.shift(banker_labels)
            label.delete(old_label)
    
    if bear_banker
        banker_label = label.new(bar_index, high, "BANKER", color=bearish_banker_color, textcolor=color.white, size=size.small, style=label.style_label_down)
        array.push(banker_labels, banker_label)
        
        // Clean old labels
        if array.size(banker_labels) > 50
            old_label = array.shift(banker_labels)
            label.delete(old_label)

// Draw Fair Value Gaps
if show_fvg and bull_fvg
    fvg_box = box.new(bar_index - 1, bull_fvg_top, bar_index + fvg_lookback, bull_fvg_bottom, bgcolor=bullish_fvg_color, border_color=bullish_fvg_border, border_width=fvg_border_width)
    array.push(fvg_boxes, fvg_box)
    fvg_mid = (bull_fvg_top + bull_fvg_bottom) / 2
    fvg_label = label.new(bar_index + fvg_lookback/2, fvg_mid, "FVG", color=color.new(bullish_fvg_border, 90), textcolor=color.white, size=size.normal, style=label.style_label_center)
    array.push(fvg_labels, fvg_label)
    clean_old_boxes(fvg_boxes, fvg_labels, 20)

if show_fvg and bear_fvg
    fvg_box = box.new(bar_index - 1, bear_fvg_top, bar_index + fvg_lookback, bear_fvg_bottom, bgcolor=bearish_fvg_color, border_color=bearish_fvg_border, border_width=fvg_border_width)
    array.push(fvg_boxes, fvg_box)
    fvg_mid = (bear_fvg_top + bear_fvg_bottom) / 2
    fvg_label = label.new(bar_index + fvg_lookback/2, fvg_mid, "FVG", color=color.new(bearish_fvg_border, 90), textcolor=color.white, size=size.normal, style=label.style_label_center)
    array.push(fvg_labels, fvg_label)
    clean_old_boxes(fvg_boxes, fvg_labels, 20)

// Draw Order Blocks
if show_ob and bull_ob
    ob_box = box.new(bar_index - 1, bull_ob_top, bar_index + ob_lookback, bull_ob_bottom, bgcolor=bullish_ob_color, border_color=bullish_ob_border, border_width=ob_border_width)
    array.push(ob_boxes, ob_box)
    ob_mid = (bull_ob_top + bull_ob_bottom) / 2
    ob_label = label.new(bar_index + ob_lookback/2, ob_mid, "ORDER BLOCK", color=color.new(bullish_ob_border, 90), textcolor=color.white, size=size.normal, style=label.style_label_center)
    array.push(ob_labels, ob_label)
    clean_old_boxes(ob_boxes, ob_labels, 10)

if show_ob and bear_ob
    ob_box = box.new(bar_index - 1, bear_ob_top, bar_index + ob_lookback, bear_ob_bottom, bgcolor=bearish_ob_color, border_color=bearish_ob_border, border_width=ob_border_width)
    array.push(ob_boxes, ob_box)
    ob_mid = (bear_ob_top + bear_ob_bottom) / 2
    ob_label = label.new(bar_index + ob_lookback/2, ob_mid, "ORDER BLOCK", color=color.new(bearish_ob_border, 90), textcolor=color.white, size=size.normal, style=label.style_label_center)
    array.push(ob_labels, ob_label)
    clean_old_boxes(ob_boxes, ob_labels, 10)

// Check for sync signals
var float last_bull_fvg_top = na
var float last_bull_fvg_bottom = na
var float last_bear_fvg_top = na
var float last_bear_fvg_bottom = na
var float last_bull_ob_top = na
var float last_bull_ob_bottom = na
var float last_bear_ob_top = na
var float last_bear_ob_bottom = na

// Store recent FVG and OB levels
if bull_fvg
    last_bull_fvg_top := bull_fvg_top
    last_bull_fvg_bottom := bull_fvg_bottom

if bear_fvg
    last_bear_fvg_top := bear_fvg_top
    last_bear_fvg_bottom := bear_fvg_bottom

if bull_ob
    last_bull_ob_top := bull_ob_top
    last_bull_ob_bottom := bull_ob_bottom

if bear_ob
    last_bear_ob_top := bear_ob_top
    last_bear_ob_bottom := bear_ob_bottom

// Check for sync signals with reduced repainting
bullish_sync = show_signals and not na(last_bull_fvg_top) and not na(last_bull_ob_top) and price_in_range(close, last_bull_fvg_top, last_bull_fvg_bottom) and price_in_range(close, last_bull_ob_top, last_bull_ob_bottom) and close > open and get_structure_filter(true)

bearish_sync = show_signals and not na(last_bear_fvg_top) and not na(last_bear_ob_top) and price_in_range(close, last_bear_fvg_top, last_bear_fvg_bottom) and price_in_range(close, last_bear_ob_top, last_bear_ob_bottom) and close < open and get_structure_filter(false)

// Calculate signal strength when signals occur
var float signal_strength = na
var label signal_strength_label = na

if bullish_sync
    signal_strength := calculate_confluence_score(true)
    if show_strength_label
        label.delete(signal_strength_label)
        signal_strength_label := label.new(bar_index, low * 0.995, "Strength: " + str.tostring(signal_strength, "#.#") + "/10", color=color.new(color.green, 0), textcolor=color.white, size=size.normal, style=label.style_label_up)

if bearish_sync
    signal_strength := calculate_confluence_score(false)
    if show_strength_label
        label.delete(signal_strength_label)
        signal_strength_label := label.new(bar_index, high * 1.005, "Strength: " + str.tostring(signal_strength, "#.#") + "/10", color=color.new(color.red, 0), textcolor=color.white, size=size.normal, style=label.style_label_down)

// Plot signals
plotshape(bullish_sync, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal, title="Buy Signal")
plotshape(bearish_sync, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal, title="Sell Signal")

// Plot moving averages for reference
plot(show_ma_confluence ? ema_fast : na, "Fast EMA", color=color.new(color.blue, 50), linewidth=1)
plot(show_ma_confluence ? ema_slow : na, "Slow EMA", color=color.new(color.orange, 50), linewidth=1)

// Advanced Alert Conditions
high_confluence_bull = bullish_sync and not na(signal_strength) and signal_strength >= min_confluence_score
high_confluence_bear = bearish_sync and not na(signal_strength) and signal_strength >= min_confluence_score

multi_symbol_bull_alignment = enable_multi_symbol and sym1_signal == "BUY" and sym2_signal == "BUY" and sym3_signal == "BUY"
multi_symbol_bear_alignment = enable_multi_symbol and sym1_signal == "SELL" and sym2_signal == "SELL" and sym3_signal == "SELL"

// Alerts
alertcondition(bullish_sync, title="Bullish FVG-OB Sync", message="Bullish sync detected: FVG and Order Block aligned for potential buy")
alertcondition(bearish_sync, title="Bearish FVG-OB Sync", message="Bearish sync detected: FVG and Order Block aligned for potential sell")

// Advanced alerts
alertcondition(high_confluence_bull and alert_on_confluence, title="High Confluence Bullish Signal", message="HIGH CONFIDENCE BUY: Strong confluence score detected")
alertcondition(high_confluence_bear and alert_on_confluence, title="High Confluence Bearish Signal", message="HIGH CONFIDENCE SELL: Strong confluence score detected")

alertcondition(multi_symbol_bull_alignment and alert_on_multi_symbol, title="Multi-Symbol Bullish Alignment", message="ALL SYMBOLS BULLISH: Strong alignment across multiple pairs")
alertcondition(multi_symbol_bear_alignment and alert_on_multi_symbol, title="Multi-Symbol Bearish Alignment", message="ALL SYMBOLS BEARISH: Strong alignment across multiple pairs")

// Check if price is in active zones
[in_bull_fvg, in_bear_fvg, in_bull_ob, in_bear_ob] = check_price_in_zones()

// Modern Dashboard with enhanced styling
if show_signals
    var table main_table = table.new(position.top_right, 6, 60, bgcolor=dashboard_bg_color, border_width=0)
    var table def_table = table.new(position.bottom_right, 1, 5, bgcolor=dashboard_bg_color, border_width=0)
    
    // Main Dashboard Title
    table.cell(main_table, 0, 0, "📊 Advanced Trading Dashboard", text_color=color.white, bgcolor=header_bg_color, text_size=size.normal)
    table.merge_cells(main_table, 0, 0, 5, 0)
    
    // Headers for timeframe section
    table.cell(main_table, 0, 1, "⏱️ TF", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(main_table, 1, 1, "📊 Dir", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(main_table, 2, 1, "💪 Str", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(main_table, 3, 1, "📈 Trend", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(main_table, 4, 1, "⏰ Timer", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    
    // Multi-timeframe data with timers
    table.cell(main_table, 0, 2, "5M", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 1, 2, tf_5m_direction, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    strength_5m_bg = if strength_5m > 70
        bullish_cell_color
    else if strength_5m < 30
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 2, 2, str.tostring(strength_5m, "#"), text_color=color.white, bgcolor=strength_5m_bg, text_size=size.small)
    
    trend_5m_arrow = if strength_5m > 70
        "⬆️"
    else if strength_5m < 30
        "⬇️"
    else
        "➡️"
    table.cell(main_table, 3, 2, trend_5m_arrow, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 4, 2, get_time_remaining("5"), text_color=color.yellow, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    table.cell(main_table, 0, 3, "15M", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 1, 3, tf_15m_direction, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    strength_15m_bg = if strength_15m > 70
        bullish_cell_color
    else if strength_15m < 30
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 2, 3, str.tostring(strength_15m, "#"), text_color=color.white, bgcolor=strength_15m_bg, text_size=size.small)
    
    trend_15m_arrow = if strength_15m > 70
        "⬆️"
    else if strength_15m < 30
        "⬇️"
    else
        "➡️"
    table.cell(main_table, 3, 3, trend_15m_arrow, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 4, 3, get_time_remaining("15"), text_color=color.yellow, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    table.cell(main_table, 0, 4, "1H", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 1, 4, tf_1h_direction, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    strength_1h_bg = if strength_1h > 70
        bullish_cell_color
    else if strength_1h < 30
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 2, 4, str.tostring(strength_1h, "#"), text_color=color.white, bgcolor=strength_1h_bg, text_size=size.small)
    
    trend_1h_arrow = if strength_1h > 70
        "⬆️"
    else if strength_1h < 30
        "⬇️"
    else
        "➡️"
    table.cell(main_table, 3, 4, trend_1h_arrow, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 4, 4, get_time_remaining("60"), text_color=color.yellow, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    table.cell(main_table, 0, 5, "4H", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 1, 5, tf_4h_direction, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    strength_4h_bg = if strength_4h > 70
        bullish_cell_color
    else if strength_4h < 30
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 2, 5, str.tostring(strength_4h, "#"), text_color=color.white, bgcolor=strength_4h_bg, text_size=size.small)
    
    trend_4h_arrow = if strength_4h > 70
        "⬆️"
    else if strength_4h < 30
        "⬇️"
    else
        "➡️"
    table.cell(main_table, 3, 5, trend_4h_arrow, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 4, 5, get_time_remaining("240"), text_color=color.yellow, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    table.cell(main_table, 0, 6, "1D", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 1, 6, tf_1d_direction, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    strength_1d_bg = if strength_1d > 70
        bullish_cell_color
    else if strength_1d < 30
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 2, 6, str.tostring(strength_1d, "#"), text_color=color.white, bgcolor=strength_1d_bg, text_size=size.small)
    
    trend_1d_arrow = if strength_1d > 70
        "⬆️"
    else if strength_1d < 30
        "⬇️"
    else
        "➡️"
    table.cell(main_table, 3, 6, trend_1d_arrow, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 4, 6, get_time_remaining("1D"), text_color=color.yellow, bgcolor=color.new(color.gray, 90), text_size=size.small)
    
    // Separator
    table.cell(main_table, 0, 7, "", text_color=color.gray, bgcolor=color.new(color.gray, 95))
    table.merge_cells(main_table, 0, 7, 5, 7)
    
    // Multi-Symbol Analysis Section
    int current_row = 7
    
    if enable_multi_symbol
        current_row += 1
        table.cell(main_table, 0, current_row, "🌐 Multi-Symbol Analysis", text_color=color.white, bgcolor=color.new(color.purple, 70), text_size=size.small)
        table.merge_cells(main_table, 0, current_row, 5, current_row)
        
        // Symbol 1
        current_row += 1
        table.cell(main_table, 0, current_row, symbol1, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
        sym1_bg = if sym1_signal == "BUY"
            bullish_cell_color
        else if sym1_signal == "SELL"
            bearish_cell_color
        else
            neutral_cell_color
        table.cell(main_table, 1, current_row, sym1_signal, text_color=color.white, bgcolor=sym1_bg, text_size=size.small)
        table.cell(main_table, 3, current_row, str.tostring(sym1_trend, "#.#") + "%", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
        table.merge_cells(main_table, 3, current_row, 5, current_row)
        
        // Symbol 2
        current_row += 1
        table.cell(main_table, 0, current_row, symbol2, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
        sym2_bg = if sym2_signal == "BUY"
            bullish_cell_color
        else if sym2_signal == "SELL"
            bearish_cell_color
        else
            neutral_cell_color
        table.cell(main_table, 1, current_row, sym2_signal, text_color=color.white, bgcolor=sym2_bg, text_size=size.small)
        table.cell(main_table, 3, current_row, str.tostring(sym2_trend, "#.#") + "%", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
        table.merge_cells(main_table, 3, current_row, 5, current_row)
        
        // Symbol 3
        current_row += 1
        table.cell(main_table, 0, current_row, symbol3, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
        sym3_bg = if sym3_signal == "BUY"
            bullish_cell_color
        else if sym3_signal == "SELL"
            bearish_cell_color
        else
            neutral_cell_color
        table.cell(main_table, 1, current_row, sym3_signal, text_color=color.white, bgcolor=sym3_bg, text_size=size.small)
        table.cell(main_table, 3, current_row, str.tostring(sym3_trend, "#.#") + "%", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
        table.merge_cells(main_table, 3, current_row, 5, current_row)
        
        // Separator
        current_row += 1
        table.cell(main_table, 0, current_row, "", text_color=color.gray, bgcolor=color.new(color.gray, 95))
        table.merge_cells(main_table, 0, current_row, 5, current_row)
    
    // ML & Sentiment Section
    if enable_ml_patterns or enable_sentiment
        current_row += 1
        table.cell(main_table, 0, current_row, "🤖 AI Analysis", text_color=color.white, bgcolor=color.new(color.teal, 70), text_size=size.small)
        table.merge_cells(main_table, 0, current_row, 5, current_row)
        
        if enable_ml_patterns
            current_row += 1
            table.cell(main_table, 0, current_row, "ML Score", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
            ml_bg = if ml_prediction > 70
                bullish_cell_color
            else if ml_prediction < 30
                bearish_cell_color
            else
                neutral_cell_color
            table.cell(main_table, 1, current_row, str.tostring(ml_prediction, "#") + "%", text_color=color.white, bgcolor=ml_bg, text_size=size.small)
            table.merge_cells(main_table, 1, current_row, 5, current_row)
        
        if enable_sentiment
            current_row += 1
            table.cell(main_table, 0, current_row, "Sentiment", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
            sent_bg = if market_sentiment > 70
                bullish_cell_color
            else if market_sentiment < 30
                bearish_cell_color
            else
                neutral_cell_color
            table.cell(main_table, 1, current_row, str.tostring(market_sentiment, "#") + "%", text_color=color.white, bgcolor=sent_bg, text_size=size.small)
            table.merge_cells(main_table, 1, current_row, 5, current_row)
        
        // Separator
        current_row += 1
        table.cell(main_table, 0, current_row, "", text_color=color.gray, bgcolor=color.new(color.gray, 95))
        table.merge_cells(main_table, 0, current_row, 5, current_row)
    
    // Market Structure Section
    current_row += 1
    table.cell(main_table, 0, current_row, "🏗️ Market Structure", text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)
    table.merge_cells(main_table, 0, current_row, 5, current_row)
    
    // Alignment
    current_row += 1
    table.cell(main_table, 0, current_row, "ALIGN", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    alignment_text = if all_bullish
        "🟢 BULLISH"
    else if all_bearish
        "🔴 BEARISH"
    else
        "🟡 MIXED"
    alignment_bg = if all_bullish
        bullish_cell_color
    else if all_bearish
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 1, current_row, alignment_text, text_color=color.white, bgcolor=alignment_bg, text_size=size.small)
    table.merge_cells(main_table, 1, current_row, 5, current_row)
    
    // Market Structure
    current_row += 1
    table.cell(main_table, 0, current_row, "STRUCT", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    struct_status = if struct_bullish
        "🟢 BULLISH"
    else if struct_bearish
        "🔴 BEARISH"
    else
        "🟡 NEUTRAL"
    struct_bg = if struct_bullish
        bullish_cell_color
    else if struct_bearish
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 1, current_row, struct_status, text_color=color.white, bgcolor=struct_bg, text_size=size.small)
    
    struct_type = if choch_bull
        "CHOCH ↑"
    else if choch_bear
        "CHOCH ↓"
    else if bos_bull
        "BOS ↑"
    else if bos_bear
        "BOS ↓"
    else
        "---"
    table.cell(main_table, 3, current_row, struct_type, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.merge_cells(main_table, 3, current_row, 5, current_row)
    
    // Volume
    current_row += 1
    table.cell(main_table, 0, current_row, "VOLUME", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    vol_status = volume_confirmed() ? "🟢 HIGH" : "🔴 LOW"
    vol_bg = volume_confirmed() ? bullish_cell_color : bearish_cell_color
    table.cell(main_table, 1, current_row, vol_status, text_color=color.white, bgcolor=vol_bg, text_size=size.small)
    vol_ratio = volume / ta.sma(volume, volume_lookback)
    table.cell(main_table, 3, current_row, str.tostring(vol_ratio, "#.#") + "x AVG", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.merge_cells(main_table, 3, current_row, 5, current_row)
    
    // Separator
    current_row += 1
    table.cell(main_table, 0, current_row, "", text_color=color.gray, bgcolor=color.new(color.gray, 95))
    table.merge_cells(main_table, 0, current_row, 5, current_row)
    
    // Trading Zones Section
    current_row += 1
    table.cell(main_table, 0, current_row, "🎯 Trading Zones", text_color=color.white, bgcolor=color.new(color.purple, 70), text_size=size.small)
    table.merge_cells(main_table, 0, current_row, 5, current_row)
    
    // Zone Recommendation
    zone_recommendation = ""
    zone_bg = neutral_cell_color
    if in_bull_fvg or in_bull_ob
        zone_recommendation := "🟢 BUY ZONE"
        zone_bg := bullish_cell_color
    else if in_bear_fvg or in_bear_ob
        zone_recommendation := "🔴 SELL ZONE"
        zone_bg := bearish_cell_color
    else
        zone_recommendation := "🟡 NEUTRAL"
        zone_bg := neutral_cell_color
    
    current_row += 1
    table.cell(main_table, 0, current_row, "ZONE", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(main_table, 1, current_row, zone_recommendation, text_color=color.white, bgcolor=zone_bg, text_size=size.small)
    table.merge_cells(main_table, 1, current_row, 5, current_row)
    
    // FVG Status
    current_row += 1
    table.cell(main_table, 0, current_row, "FVG", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    fvg_status = if bull_fvg
        "🟢 BULL"
    else if bear_fvg
        "🔴 BEAR"
    else if in_bull_fvg
        "📍 IN BULL"
    else if in_bear_fvg
        "📍 IN BEAR"
    else
        "⚫ NONE"
    fvg_bg = if bull_fvg or in_bull_fvg
        bullish_cell_color
    else if bear_fvg or in_bear_fvg
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 1, current_row, fvg_status, text_color=color.white, bgcolor=fvg_bg, text_size=size.small)
    table.merge_cells(main_table, 1, current_row, 5, current_row)
    
    // Order Block Status
    current_row += 1
    table.cell(main_table, 0, current_row, "OB", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    ob_status = if bull_ob
        "🟢 BULL"
    else if bear_ob
        "🔴 BEAR"
    else if in_bull_ob
        "📍 IN BULL"
    else if in_bear_ob
        "📍 IN BEAR"
    else
        "⚫ NONE"
    ob_bg = if bull_ob or in_bull_ob
        bullish_cell_color
    else if bear_ob or in_bear_ob
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 1, current_row, ob_status, text_color=color.white, bgcolor=ob_bg, text_size=size.small)
    table.merge_cells(main_table, 1, current_row, 5, current_row)
    
    // Separator
    current_row += 1
    table.cell(main_table, 0, current_row, "", text_color=color.gray, bgcolor=color.new(color.gray, 95))
    table.merge_cells(main_table, 0, current_row, 5, current_row)
    
    // Signal Section
    current_row += 1
    table.cell(main_table, 0, current_row, "🚦 Signal Status", text_color=color.white, bgcolor=color.new(color.orange, 70), text_size=size.small)
    table.merge_cells(main_table, 0, current_row, 5, current_row)
    
    // Signal Section
    current_row += 1
    table.cell(main_table, 0, current_row, "SIGNAL", text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    signal_status = if bullish_sync
        "🟢 BUY"
    else if bearish_sync
        "🔴 SELL"
    else
        "🟡 WAIT"
    signal_bg = if bullish_sync
        bullish_cell_color
    else if bearish_sync
        bearish_cell_color
    else
        neutral_cell_color
    table.cell(main_table, 1, current_row, signal_status, text_color=color.white, bgcolor=signal_bg, text_size=size.small)
    
    strength_text = if not na(signal_strength)
        "💪 " + str.tostring(signal_strength, "#.#") + "/10"
    else
        "---"
    table.cell(main_table, 3, current_row, strength_text, text_color=color.white, bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.merge_cells(main_table, 3, current_row, 5, current_row)
    
    // Definitions Table with BIGGER text
    if show_definitions
        table.cell(def_table, 0, 0, "📖 DEFINITIONS", text_color=color.white, bgcolor=header_bg_color, text_size=size.normal)
        
        table.cell(def_table, 0, 1, "FVG: Fair Value Gap - Price imbalance between candles creating a trading opportunity", text_color=color.white, bgcolor=color.new(color.black, 85), text_size=size.normal, text_halign=text.align_left)
        
        table.cell(def_table, 0, 2, "OB: Order Block - Zone where institutional orders were placed", text_color=color.white, bgcolor=color.new(color.black, 85), text_size=size.normal, text_halign=text.align_left)
        
        table.cell(def_table, 0, 3, "BOS: Break of Structure - Trend continuation signal when price breaks key levels", text_color=color.white, bgcolor=color.new(color.black, 85), text_size=size.normal, text_halign=text.align_left)
        
        table.cell(def_table, 0, 4, "CHOCH: Change of Character - Market reversal signal when trend changes", text_color=color.white, bgcolor=color.new(color.black, 85), text_size=size.normal, text_halign=text.align_left)