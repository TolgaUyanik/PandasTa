//@version=5
indicator("FVG & Order Block Sync Pro - Enhanced", shorttitle="FVG-OB Sync Pro+", overlay=true, max_boxes_count=500, max_lines_count=500)

// Input Settings
show_fvg = input.bool(true, "Show Fair Value Gaps")
show_ob = input.bool(true, "Show Order Blocks")
