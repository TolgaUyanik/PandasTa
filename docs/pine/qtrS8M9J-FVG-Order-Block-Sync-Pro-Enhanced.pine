// Advanced Alert Settings
alert_on_confluence = input.bool(true, "Alert on High Confluence", group="Advanced Alerts")
min_confluence_score = input.float(7.0, "Minimum Confluence Score for Alert", minval=5.0, maxval=10.0, group="Advanced Alerts")
alert_on_multi_symbol = input.bool(true, "Alert on Multi-Symbol Alignment", group="Advanced Alerts")

// Multi-timeframe data with RSI and trend strength
[close_5m, open_5m, high_5m, low_5m] = request.security(syminfo.tickerid, "5", [close, open, high, low])
[close_15m, open_15m, high_15m, low_15m] = request.security(syminfo.tickerid, "15", [close, open, high, low])
[close_1h, open_1h, high_1h, low_1h] = request.security(syminfo.tickerid, "60", [close, open, high, low])
[close_4h, open_4h, high_4h, low_4h] = request.security(syminfo.tickerid, "240", [close, open, high, low])
[close_1d, open_1d, high_1d, low_1d] = request.security(syminfo.tickerid, "1D", [close, open, high, low])

// Multi-Symbol Data Collection (Conditional)
var float sym1_trend = na
var float sym2_trend = na
var float sym3_trend = na
var string sym1_signal = "NEUTRAL"
var string sym2_signal = "NEUTRAL"
var string sym3_signal = "NEUTRAL"

// Memory Management - Dynamic array sizing
var int max_array_size = 100
var array<float> ml_predictions = array.new<float>(0)

// Pattern Recognition Variables
var float pattern_success_rate = 50.0
var int successful_patterns = 0
var int total_patterns = 0

// Sentiment Variables
var float market_sentiment = 50.0
var array<float> sentiment_history = array.new<float>(0)

// Function to calculate time remaining in current candle for different timeframes
get_time_remaining(tf_string) =>
    tf_in_minutes = switch tf_string
        "5" => 5
        "15" => 15
        "60" => 60
        "240" => 240
        "1D" => 1440
        => 1
    
    current_time = time(tf_string)
    time_elapsed = time - current_time
    time_remaining = (tf_in_minutes * 60 * 1000) - time_elapsed
    
    minutes = math.floor(time_remaining / 60000)
    seconds = math.floor((time_remaining % 60000) / 1000)
    
    time_string = if tf_string == "1D"
        str.tostring(math.floor(minutes/60)) + "h " + str.tostring(minutes%60) + "m"
    else
        str.tostring(minutes) + ":" + (seconds < 10 ? "0" : "") + str.tostring(seconds)
    
    time_string

// Calculate moving averages for confluence
ema_fast = ta.ema(close, ma_fast)
ema_slow = ta.ema(close, ma_slow)

// Function to calculate trend strength (0-100) using custom method
calculate_trend_strength(src, length) =>
    // Calculate directional movement
    up_move = src > src[1] ? src - src[1] : 0
    down_move = src[1] > src ? src[1] - src : 0
    
    // Smooth the movements
    smooth_up = ta.rma(up_move, length)
    smooth_down = ta.rma(down_move, length)
    
    // Calculate strength
    strength = smooth_up + smooth_down != 0 ? 100 * smooth_up / (smooth_up + smooth_down) : 50
    
    // Additional factors for trend strength
    momentum = ta.mom(src, length)
    momentum_strength = if momentum > 0
        50 + (momentum / src * 100)
    else
        50 - (math.abs(momentum) / src * 100)
    momentum_strength := math.max(0, math.min(100, momentum_strength))
    
    // Combine factors
    final_strength = (strength + momentum_strength) / 2
    final_strength

// Function to calculate market sentiment (simplified momentum-based)
calculate_market_sentiment() =>
    // Volume-price analysis
    vp_sentiment = volume > ta.sma(volume, sentiment_period) and close > close[1] ? 1 : -1
    
    // Price momentum
    price_momentum = ta.rsi(close, sentiment_period)
    
    // Breadth analysis (simplified)
    up_bars = 0
    down_bars = 0
    for i = 0 to sentiment_period - 1
        if close[i] > open[i]
            up_bars += 1
        else if close[i] < open[i]
            down_bars += 1
    
    breadth = up_bars > down_bars ? (up_bars / sentiment_period) * 100 : (1 - down_bars / sentiment_period) * 100
    
    // Combine sentiment factors
    sentiment = (price_momentum + breadth) / 2
    sentiment

// Function for ML pattern recognition
ml_pattern_recognition() =>
    if not enable_ml_patterns
        50.0
    else
        // Pattern features
        current_pattern_score = 0.0
        
        // Simple pattern scoring based on current conditions
        current_pattern_score += close > open ? 10 : 0
        current_pattern_score += volume > ta.sma(volume, 20) ? 10 : 0
        current_pattern_score += close > ema_fast ? 10 : 0
        current_pattern_score += ta.rsi(close, 14) > 50 ? 10 : 0
        current_pattern_score += high > high[1] ? 10 : 0
        
        // Add momentum factor
        momentum_factor = ta.mom(close, 14)
        if momentum_factor > 0
            current_pattern_score += 20
        
        // Add trend alignment
        if close > ema_fast and ema_fast > ema_slow
            current_pattern_score += 30
        else if close < ema_fast and ema_fast < ema_slow
            current_pattern_score += 0
        else
            current_pattern_score += 15
        
        // Return normalized score
        math.min(100, current_pattern_score)

// Multi-symbol data retrieval variables
var float s1_close = na
var float s1_open = na
var float s2_close = na
var float s2_open = na
var float s3_close = na
var float s3_open = na

// Calculate sentiment
if enable_sentiment
    market_sentiment := calculate_market_sentiment()
    array.push(sentiment_history, market_sentiment)
    if array.size(sentiment_history) > max_array_size
        array.shift(sentiment_history)

// Calculate ML predictions
var float ml_prediction = 50.0
if enable_ml_patterns
    ml_prediction := ml_pattern_recognition()
    array.push(ml_predictions, ml_prediction)
    if array.size(ml_predictions) > max_array_size
        array.shift(ml_predictions)

// Multi-symbol data requests (must be unconditional)
[s1_close_req, s1_open_req] = request.security(symbol1, timeframe.period, [close, open])
[s2_close_req, s2_open_req] = request.security(symbol2, timeframe.period, [close, open])
[s3_close_req, s3_open_req] = request.security(symbol3, timeframe.period, [close, open])

sym1_trend_req = request.security(symbol1, timeframe.period, calculate_trend_strength(close, trend_strength_period))
sym2_trend_req = request.security(symbol2, timeframe.period, calculate_trend_strength(close, trend_strength_period))
sym3_trend_req = request.security(symbol3, timeframe.period, calculate_trend_strength(close, trend_strength_period))

// Update multi-symbol signals conditionally
if enable_multi_symbol and bar_index % 5 == 0  // Update every 5 bars for performance
    // Symbol 1
    s1_close := s1_close_req
    s1_open := s1_open_req
    sym1_trend := sym1_trend_req
    sym1_signal := s1_close > s1_open ? "BUY" : s1_close < s1_open ? "SELL" : "NEUTRAL"
    
    // Symbol 2
    s2_close := s2_close_req
    s2_open := s2_open_req
    sym2_trend := sym2_trend_req
    sym2_signal := s2_close > s2_open ? "BUY" : s2_close < s2_open ? "SELL" : "NEUTRAL"
    
    // Symbol 3
    s3_close := s3_close_req
    s3_open := s3_open_req
    sym3_trend := sym3_trend_req
    sym3_signal := s3_close > s3_open ? "BUY" : s3_close < s3_open ? "SELL" : "NEUTRAL"

// Calculate trend strength for each timeframe
strength_current = calculate_trend_strength(close, trend_strength_period)
strength_5m = request.security(syminfo.tickerid, "5", calculate_trend_strength(close, trend_strength_period))
strength_15m = request.security(syminfo.tickerid, "15", calculate_trend_strength(close, trend_strength_period))
strength_1h = request.security(syminfo.tickerid, "60", calculate_trend_strength(close, trend_strength_period))
strength_4h = request.security(syminfo.tickerid, "240", calculate_trend_strength(close, trend_strength_period))
strength_1d = request.security(syminfo.tickerid, "1D", calculate_trend_strength(close, trend_strength_period))

// Multi-timeframe candle direction with trend strength
