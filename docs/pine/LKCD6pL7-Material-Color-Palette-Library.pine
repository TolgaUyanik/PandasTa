        10 => darkLevel == 1 ? color.new(#e7b9ff, opacity) : darkLevel == 2 ? color.new(#b388ff, opacity) : color.new(#805acb, opacity)
        9  => darkLevel == 1 ? color.new(#6746c3, opacity) : darkLevel == 2 ? color.new(#311b92, opacity) : color.new(#000063, opacity)
        8  => darkLevel == 1 ? color.new(#7953d2, opacity) : darkLevel == 2 ? color.new(#4527a0, opacity) : color.new(#000070, opacity)
