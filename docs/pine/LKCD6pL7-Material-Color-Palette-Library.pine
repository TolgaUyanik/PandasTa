        1  => darkLevel == 1 ? color.new(#ffffe4, opacity) : darkLevel == 2 ? color.new(#ffe0b2, opacity) : color.new(#cbae82, opacity)
        
    result

// @function        Generates a specific shade of deep orange.
// @param saturationLevel (int) Saturation level (1-13). Default is 13.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export deepOrange(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) => // Changed function name to camelCase
    color result = switch saturationLevel
        13 => darkLevel == 1 ? color.new(#ff6434, opacity) : darkLevel == 2 ? color.new(#dd2c00, opacity) : color.new(#a30000, opacity)
        12 => darkLevel == 1 ? color.new(#ff7539, opacity) : darkLevel == 2 ? color.new(#ff3d00, opacity) : color.new(#c30000, opacity)
        11 => darkLevel == 1 ? color.new(#ffa06d, opacity) : darkLevel == 2 ? color.new(#ff6e40, opacity) : color.new(#c53d13, opacity)
        10 => darkLevel == 1 ? color.new(#ffd0b0, opacity) : darkLevel == 2 ? color.new(#ff9e80, opacity) : color.new(#c96f53, opacity)
        9  => darkLevel == 1 ? color.new(#f9683a, opacity) : darkLevel == 2 ? color.new(#bf360c, opacity) : color.new(#870000, opacity)
        8  => darkLevel == 1 ? color.new(#ff7543, opacity) : darkLevel == 2 ? color.new(#d84315, opacity) : color.new(#9f0000, opacity)
        7  => darkLevel == 1 ? color.new(#ff7d47, opacity) : darkLevel == 2 ? color.new(#e64a19, opacity) : color.new(#ac0800, opacity)
        6  => darkLevel == 1 ? color.new(#ff844c, opacity) : darkLevel == 2 ? color.new(#f4511e, opacity) : color.new(#b91400, opacity)
        5  => darkLevel == 1 ? color.new(#ff8a50, opacity) : darkLevel == 2 ? color.new(#ff5722, opacity) : color.new(#c41c00, opacity)
        4  => darkLevel == 1 ? color.new(#ffa270, opacity) : darkLevel == 2 ? color.new(#ff7043, opacity) : color.new(#c63f17, opacity)
        3  => darkLevel == 1 ? color.new(#ffbb93, opacity) : darkLevel == 2 ? color.new(#ff8a65, opacity) : color.new(#c75b39, opacity)
        2  => darkLevel == 1 ? color.new(#ffddc1, opacity) : darkLevel == 2 ? color.new(#ffab91, opacity) : color.new(#c97b63, opacity)
        1  => darkLevel == 1 ? color.new(#ffffee, opacity) : darkLevel == 2 ? color.new(#ffccbc, opacity) : color.new(#cb9b8c, opacity)
        
    result

// @function        Generates a specific shade of brown.
// @param saturationLevel (int) Saturation level (1-9). Default is 9.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export brown(int saturationLevel = 9, int darkLevel = 2, int opacity = 0) =>
    color result = switch saturationLevel
        9 => darkLevel == 1 ? color.new(#6a4f4b, opacity) : darkLevel == 2 ? color.new(#3e2723, opacity) : color.new(#1b0000, opacity)
        8 => darkLevel == 1 ? color.new(#7b5e57, opacity) : darkLevel == 2 ? color.new(#4e342e, opacity) : color.new(#260e04, opacity)
        7 => darkLevel == 1 ? color.new(#8b6b61, opacity) : darkLevel == 2 ? color.new(#5d4037, opacity) : color.new(#321911, opacity)
        6 => darkLevel == 1 ? color.new(#9c786c, opacity) : darkLevel == 2 ? color.new(#6d4c41, opacity) : color.new(#40241a, opacity)
        5 => darkLevel == 1 ? color.new(#a98274, opacity) : darkLevel == 2 ? color.new(#795548, opacity) : color.new(#4b2c20, opacity)
        4 => darkLevel == 1 ? color.new(#be9c91, opacity) : darkLevel == 2 ? color.new(#8d6e63, opacity) : color.new(#5f4339, opacity)
        3 => darkLevel == 1 ? color.new(#d3b8ae, opacity) : darkLevel == 2 ? color.new(#a1887f, opacity) : color.new(#725b53, opacity)
        2 => darkLevel == 1 ? color.new(#efdcd5, opacity) : darkLevel == 2 ? color.new(#bcaaa4, opacity) : color.new(#8c7b75, opacity)
        1 => darkLevel == 1 ? color.new(#fffffb, opacity) : darkLevel == 2 ? color.new(#d7ccc8, opacity) : color.new(#a69b97, opacity)
        
    result

// @function        Generates a specific shade of grey.
// @param saturationLevel (int) Saturation level (1-9). Default is 9.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export grey(int saturationLevel = 9, int darkLevel = 2, int opacity = 0) => // Changed function name to avoid conflict with built-in 'color.gray'
    color result = switch saturationLevel
        9 => darkLevel == 1 ? color.new(#484848, opacity) : darkLevel == 2 ? color.new(#212121, opacity) : color.new(#000000, opacity)
        8 => darkLevel == 1 ? color.new(#6d6d6d, opacity) : darkLevel == 2 ? color.new(#424242, opacity) : color.new(#1b1b1b, opacity)
        7 => darkLevel == 1 ? color.new(#8e8e8e, opacity) : darkLevel == 2 ? color.new(#616161, opacity) : color.new(#373737, opacity)
        6 => darkLevel == 1 ? color.new(#a4a4a4, opacity) : darkLevel == 2 ? color.new(#757575, opacity) : color.new(#494949, opacity)
        5 => darkLevel == 1 ? color.new(#cfcfcf, opacity) : darkLevel == 2 ? color.new(#9e9e9e, opacity) : color.new(#707070, opacity)
        4 => darkLevel == 1 ? color.new(#efefef, opacity) : darkLevel == 2 ? color.new(#bdbdbd, opacity) : color.new(#8d8d8d, opacity)
        3 => darkLevel == 1 ? color.new(#ffffff, opacity) : darkLevel == 2 ? color.new(#e0e0e0, opacity) : color.new(#aeaeae, opacity)
        2 => darkLevel == 1 ? color.new(#ffffff, opacity) : darkLevel == 2 ? color.new(#eeeeee, opacity) : color.new(#bcbcbc, opacity)
        1 => darkLevel == 1 ? color.new(#ffffff, opacity) : darkLevel == 2 ? color.new(#f5f5f5, opacity) : color.new(#c2c2c2, opacity)
        
    result

// @function        Generates a specific shade of blue grey.
// @param saturationLevel (int) Saturation level (1-9). Default is 9.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export blueGrey(int saturationLevel = 9, int darkLevel = 2, int opacity = 0) => // Changed function name to camelCase
    color result = switch saturationLevel
        9 => darkLevel == 1 ? color.new(#4f5b62, opacity) : darkLevel == 2 ? color.new(#263238, opacity) : color.new(#000a12, opacity)
        8 => darkLevel == 1 ? color.new(#62727b, opacity) : darkLevel == 2 ? color.new(#37474f, opacity) : color.new(#102027, opacity)
        7 => darkLevel == 1 ? color.new(#718792, opacity) : darkLevel == 2 ? color.new(#455a64, opacity) : color.new(#1c313a, opacity)
        6 => darkLevel == 1 ? color.new(#819ca9, opacity) : darkLevel == 2 ? color.new(#546e7a, opacity) : color.new(#29434e, opacity)
        5 => darkLevel == 1 ? color.new(#8eacbb, opacity) : darkLevel == 2 ? color.new(#607d8b, opacity) : color.new(#34515e, opacity)
        4 => darkLevel == 1 ? color.new(#a7c0cd, opacity) : darkLevel == 2 ? color.new(#78909c, opacity) : color.new(#4b636e, opacity)
        3 => darkLevel == 1 ? color.new(#c1d5e0, opacity) : darkLevel == 2 ? color.new(#90a4ae, opacity) : color.new(#62757f, opacity)
        2 => darkLevel == 1 ? color.new(#e2f1f8, opacity) : darkLevel == 2 ? color.new(#b0bec5, opacity) : color.new(#808e95, opacity)
        1 => darkLevel == 1 ? color.new(#ffffff, opacity) : darkLevel == 2 ? color.new(#cfd8dc, opacity) : color.new(#9ea7aa, opacity)
        
    result

// @function        Returns a predefined base tone color based on name.
// @param colorName   (simple string) The name of the color tone (e.g., 'red', 'blue', 'green').
// @param opacity     (int) Opacity value (0-100). Default is 0.
// @returns         (color) The corresponding base tone color.
export tone(simple string colorName, int opacity = 0) =>
    color result = switch colorName
        'red'         => color.new(#E62433, opacity)
        'pink'        => color.new(#e91e63, opacity)
        'purple'      => color.new(#aa00ff, opacity)
        'deep_Purple' => color.new(#6200ea, opacity) // Consider changing name to 'deepPurple' for consistency
        'indigo'      => color.new(#304ffe, opacity)
        'blue'        => color.new(#2962ff, opacity)
        'light_blue'  => color.new(#0091ea, opacity) // Consider changing name to 'lightBlue' for consistency
        'aqua'        => color.new(#18ffff, opacity) // Note: This differs from 'cyan' function
        'teal'        => color.new(#00bfa5, opacity)
        'green'       => color.new(#07A12C, opacity)
        'light_green' => color.new(#64dd17, opacity) // Consider changing name to 'lightGreen' for consistency
        'lime'        => color.new(#aeea00, opacity)
        'yellow'      => color.new(#ffd600, opacity)
        'orange'      => color.new(#ffab00, opacity) // Note: This is the same hex as amber(13, 2)
        'deep_orange' => color.new(#dd2c00, opacity) // Consider changing name to 'deepOrange' for consistency
        'gray'        => color.new(#757575, opacity) // Note: This differs from grey(6, 2)
        'dark_gray'   => color.new(#212121, opacity) // Note: This is the same hex as grey(9, 2). Consider 'darkGrey'
        'black'       => color.new(#191919, opacity) // Note: Similar to grey(9, 2)
        'white'       => color.new(#FFFFFF, opacity)
         // Default case if colorName is not matched
    result

// --- Paste the original table code here ---
var colorTable = table.new(position.middle_center, 60, 20) // Use camelCase for variable name

if barstate.islast
    // Header Row
    table.cell(colorTable, 1 + 1, 0, 'red()', bgcolor = red(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 1, 0, 3 + 1, 0)
    table.cell(colorTable, 1 + 4, 0, 'pink()', bgcolor = pink(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 4, 0, 3 + 4, 0)
    table.cell(colorTable, 1 + 7, 0, 'purple()', bgcolor = purple(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 7, 0, 3 + 7, 0)
    table.cell(colorTable, 1 + 10, 0, 'deepPurple()', bgcolor = deepPurple(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 10, 0, 3 + 10, 0)
    table.cell(colorTable, 1 + 13, 0, 'indigo()', bgcolor = indigo(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 13, 0, 3 + 13, 0)
    table.cell(colorTable, 1 + 16, 0, 'blue()', bgcolor = blue(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 16, 0, 3 + 16, 0)
    table.cell(colorTable, 1 + 19, 0, 'lightBlue()', bgcolor = lightBlue(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 19, 0, 3 + 19, 0)
    table.cell(colorTable, 1 + 22, 0, 'cyan()', bgcolor = cyan(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 22, 0, 3 + 22, 0)
    table.cell(colorTable, 1 + 25, 0, 'teal()', bgcolor = teal(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 25, 0, 3 + 25, 0)
    table.cell(colorTable, 1 + 28, 0, 'green()', bgcolor = green(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 28, 0, 3 + 28, 0)
    table.cell(colorTable, 1 + 31, 0, 'lightGreen()', bgcolor = lightGreen(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 31, 0, 3 + 31, 0)
    table.cell(colorTable, 1 + 34, 0, 'lime()', bgcolor = lime(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 34, 0, 3 + 34, 0)
    table.cell(colorTable, 1 + 37, 0, 'yellow()', bgcolor = yellow(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 37, 0, 3 + 37, 0)
    table.cell(colorTable, 1 + 40, 0, 'amber()', bgcolor = amber(), text_color = color.white, text_size = 10) 
    table.merge_cells(colorTable, 1 + 40, 0, 3 + 40, 0)
    table.cell(colorTable, 1 + 43, 0, 'orange()', bgcolor = orange(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 43, 0, 3 + 43, 0)
    table.cell(colorTable, 1 + 46, 0, 'deepOrange()', bgcolor = deepOrange(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 46, 0, 3 + 46, 0)
    table.cell(colorTable, 1 + 49, 0, 'brown()', bgcolor = brown(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 49, 0, 3 + 49, 0)
    table.cell(colorTable, 1 + 52, 0, 'grey()', bgcolor = grey(), text_color = color.white, text_size = 10) // Uses the renamed 'grey' function
    table.merge_cells(colorTable, 1 + 52, 0, 3 + 52, 0)
    table.cell(colorTable, 1 + 55, 0, 'blueGrey()', bgcolor = blueGrey(), text_color = color.white, text_size = 10)
    table.merge_cells(colorTable, 1 + 55, 0, 3 + 55, 0)

    // Color Cells - Palette 1 (Red to Deep Orange)
    for i = 0 to 12
        for j = 1 to 3
