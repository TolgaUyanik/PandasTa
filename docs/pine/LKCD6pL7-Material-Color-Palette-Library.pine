        6  => darkLevel == 1 ? color.new(#9162e4, opacity) : darkLevel == 2 ? color.new(#5e35b1, opacity) : color.new(#280680, opacity)
        5  => darkLevel == 1 ? color.new(#9a67ea, opacity) : darkLevel == 2 ? color.new(#673ab7, opacity) : color.new(#320b86, opacity)
        4  => darkLevel == 1 ? color.new(#b085f5, opacity) : darkLevel == 2 ? color.new(#7e57c2, opacity) : color.new(#4d2c91, opacity)
        3  => darkLevel == 1 ? color.new(#c7a4ff, opacity) : darkLevel == 2 ? color.new(#9575cd, opacity) : color.new(#65499c, opacity)
        2  => darkLevel == 1 ? color.new(#e6ceff, opacity) : darkLevel == 2 ? color.new(#b39ddb, opacity) : color.new(#836fa9, opacity)
        1  => darkLevel == 1 ? color.new(#fff7ff, opacity) : darkLevel == 2 ? color.new(#d1c4e9, opacity) : color.new(#a094b7, opacity)
        
    result

