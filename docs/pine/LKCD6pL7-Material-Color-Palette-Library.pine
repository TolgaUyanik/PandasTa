// @function        Generates a specific shade of light green.
// @param saturationLevel (int) Saturation level (1-13). Default is 13.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export lightGreen(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) => // Changed function name to camelCase
    color result = switch saturationLevel
        13 => darkLevel == 1 ? color.new(#9cff57, opacity) : darkLevel == 2 ? color.new(#64dd17, opacity) : color.new(#1faa00, opacity)
        12 => darkLevel == 1 ? color.new(#b0ff57, opacity) : darkLevel == 2 ? color.new(#76ff03, opacity) : color.new(#32cb00, opacity)
        11 => darkLevel == 1 ? color.new(#e7ff8c, opacity) : darkLevel == 2 ? color.new(#b2ff59, opacity) : color.new(#7ecb20, opacity)
        10 => darkLevel == 1 ? color.new(#ffffc2, opacity) : darkLevel == 2 ? color.new(#ccff90, opacity) : color.new(#99cc60, opacity)
        9  => darkLevel == 1 ? color.new(#629749, opacity) : darkLevel == 2 ? color.new(#33691e, opacity) : color.new(#003d00, opacity)
        8  => darkLevel == 1 ? color.new(#85bb5c, opacity) : darkLevel == 2 ? color.new(#558b2f, opacity) : color.new(#255d00, opacity)
        7  => darkLevel == 1 ? color.new(#99d066, opacity) : darkLevel == 2 ? color.new(#689f38, opacity) : color.new(#387002, opacity)
        6  => darkLevel == 1 ? color.new(#aee571, opacity) : darkLevel == 2 ? color.new(#7cb342, opacity) : color.new(#4b830d, opacity)
        5  => darkLevel == 1 ? color.new(#bef67a, opacity) : darkLevel == 2 ? color.new(#8bc34a, opacity) : color.new(#5a9216, opacity)
        4  => darkLevel == 1 ? color.new(#cfff95, opacity) : darkLevel == 2 ? color.new(#9ccc65, opacity) : color.new(#6b9b37, opacity)
        3  => darkLevel == 1 ? color.new(#e1ffb1, opacity) : darkLevel == 2 ? color.new(#aed581, opacity) : color.new(#7da453, opacity)
        2  => darkLevel == 1 ? color.new(#f8ffd7, opacity) : darkLevel == 2 ? color.new(#c5e1a5, opacity) : color.new(#94af76, opacity)
        1  => darkLevel == 1 ? color.new(#fffffb, opacity) : darkLevel == 2 ? color.new(#dcedc8, opacity) : color.new(#aabb97, opacity)
        
    result

// @function        Generates a specific shade of lime.
// @param saturationLevel (int) Saturation level (1-13). Default is 13.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export lime(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) =>
    color result = switch saturationLevel
        13 => darkLevel == 1 ? color.new(#e4ff54, opacity) : darkLevel == 2 ? color.new(#aeea00, opacity) : color.new(#79b700, opacity)
        12 => darkLevel == 1 ? color.new(#fdff58, opacity) : darkLevel == 2 ? color.new(#c6ff00, opacity) : color.new(#90cc00, opacity)
        11 => darkLevel == 1 ? color.new(#ffff78, opacity) : darkLevel == 2 ? color.new(#eeff41, opacity) : color.new(#b8cc00, opacity)
        10 => darkLevel == 1 ? color.new(#ffffb3, opacity) : darkLevel == 2 ? color.new(#f4ff81, opacity) : color.new(#bfcc50, opacity)
        9  => darkLevel == 1 ? color.new(#b4a647, opacity) : darkLevel == 2 ? color.new(#827717, opacity) : color.new(#524c00, opacity)
        8  => darkLevel == 1 ? color.new(#d2ce56, opacity) : darkLevel == 2 ? color.new(#9e9d24, opacity) : color.new(#6c6f00, opacity)
        7  => darkLevel == 1 ? color.new(#e4e65e, opacity) : darkLevel == 2 ? color.new(#afb42b, opacity) : color.new(#7c8500, opacity)
        6  => darkLevel == 1 ? color.new(#f5fd67, opacity) : darkLevel == 2 ? color.new(#c0ca33, opacity) : color.new(#8c9900, opacity)
        5  => darkLevel == 1 ? color.new(#ffff6e, opacity) : darkLevel == 2 ? color.new(#cddc39, opacity) : color.new(#99aa00, opacity)
        4  => darkLevel == 1 ? color.new(#ffff89, opacity) : darkLevel == 2 ? color.new(#d4e157, opacity) : color.new(#a0af22, opacity)
        3  => darkLevel == 1 ? color.new(#ffffa6, opacity) : darkLevel == 2 ? color.new(#dce775, opacity) : color.new(#a8b545, opacity)
        2  => darkLevel == 1 ? color.new(#ffffce, opacity) : darkLevel == 2 ? color.new(#e6ee9c, opacity) : color.new(#b3bc6d, opacity)
        1  => darkLevel == 1 ? color.new(#fffff6, opacity) : darkLevel == 2 ? color.new(#f0f4c3, opacity) : color.new(#bdc192, opacity)
        
    result

// @function        Generates a specific shade of yellow.
// @param saturationLevel (int) Saturation level (1-13). Default is 13.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export yellow(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) =>
    color result = switch saturationLevel
        13 => darkLevel == 1 ? color.new(#ffff52, opacity) : darkLevel == 2 ? color.new(#ffd600, opacity) : color.new(#c7a500, opacity)
        12 => darkLevel == 1 ? color.new(#ffff56, opacity) : darkLevel == 2 ? color.new(#ffea00, opacity) : color.new(#c7b800, opacity)
        11 => darkLevel == 1 ? color.new(#ffff5a, opacity) : darkLevel == 2 ? color.new(#ffff00, opacity) : color.new(#c7cc00, opacity)
        10 => darkLevel == 1 ? color.new(#ffffbf, opacity) : darkLevel == 2 ? color.new(#ffff8d, opacity) : color.new(#cacc5d, opacity)
        9  => darkLevel == 1 ? color.new(#ffb04c, opacity) : darkLevel == 2 ? color.new(#f57f17, opacity) : color.new(#bc5100, opacity)
        8  => darkLevel == 1 ? color.new(#ffd95a, opacity) : darkLevel == 2 ? color.new(#f9a825, opacity) : color.new(#c17900, opacity)
        7  => darkLevel == 1 ? color.new(#fff263, opacity) : darkLevel == 2 ? color.new(#fbc02d, opacity) : color.new(#c49000, opacity)
        6  => darkLevel == 1 ? color.new(#ffff6b, opacity) : darkLevel == 2 ? color.new(#fdd835, opacity) : color.new(#c6a700, opacity)
        5  => darkLevel == 1 ? color.new(#ffff72, opacity) : darkLevel == 2 ? color.new(#ffeb3b, opacity) : color.new(#c8b900, opacity)
        4  => darkLevel == 1 ? color.new(#ffff8b, opacity) : darkLevel == 2 ? color.new(#ffee58, opacity) : color.new(#c9bc1f, opacity)
        3  => darkLevel == 1 ? color.new(#ffffa8, opacity) : darkLevel == 2 ? color.new(#fff176, opacity) : color.new(#cabf45, opacity)
        2  => darkLevel == 1 ? color.new(#ffffcf, opacity) : darkLevel == 2 ? color.new(#fff59d, opacity) : color.new(#cbc26d, opacity)
        1  => darkLevel == 1 ? color.new(#fffff7, opacity) : darkLevel == 2 ? color.new(#fff9c4, opacity) : color.new(#cbc693, opacity)
        
    result

// @function        Generates a specific shade of amber.
// @param saturationLevel (int) Saturation level (1-13). Default is 13.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export amber(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) =>
    color result = switch saturationLevel
        13 => darkLevel == 1 ? color.new(#ffdd4b, opacity) : darkLevel == 2 ? color.new(#ffab00, opacity) : color.new(#c67c00, opacity)
        12 => darkLevel == 1 ? color.new(#fff64f, opacity) : darkLevel == 2 ? color.new(#ffc400, opacity) : color.new(#c79400, opacity)
        11 => darkLevel == 1 ? color.new(#ffff74, opacity) : darkLevel == 2 ? color.new(#ffd740, opacity) : color.new(#c8a600, opacity)
        10 => darkLevel == 1 ? color.new(#ffffb0, opacity) : darkLevel == 2 ? color.new(#ffe57f, opacity) : color.new(#cab350, opacity)
        9  => darkLevel == 1 ? color.new(#ffa040, opacity) : darkLevel == 2 ? color.new(#ff6f00, opacity) : color.new(#c43e00, opacity)
        8  => darkLevel == 1 ? color.new(#ffc046, opacity) : darkLevel == 2 ? color.new(#ff8f00, opacity) : color.new(#c56000, opacity)
        7  => darkLevel == 1 ? color.new(#ffd149, opacity) : darkLevel == 2 ? color.new(#ffa000, opacity) : color.new(#c67c00, opacity) // Corrected duplicate hex value
        6  => darkLevel == 1 ? color.new(#ffe54c, opacity) : darkLevel == 2 ? color.new(#ffb300, opacity) : color.new(#c68400, opacity)
        5  => darkLevel == 1 ? color.new(#fff350, opacity) : darkLevel == 2 ? color.new(#ffc107, opacity) : color.new(#c79100, opacity)
        4  => darkLevel == 1 ? color.new(#fffd61, opacity) : darkLevel == 2 ? color.new(#ffca28, opacity) : color.new(#c79a00, opacity)
        3  => darkLevel == 1 ? color.new(#ffff81, opacity) : darkLevel == 2 ? color.new(#ffd54f, opacity) : color.new(#c8a415, opacity)
        2  => darkLevel == 1 ? color.new(#ffffb3, opacity) : darkLevel == 2 ? color.new(#ffe082, opacity) : color.new(#caae53, opacity)
        1  => darkLevel == 1 ? color.new(#ffffe5, opacity) : darkLevel == 2 ? color.new(#ffecb3, opacity) : color.new(#cbba83, opacity)
        
    result

// @function        Generates a specific shade of orange.
// @param saturationLevel (int) Saturation level (1-13). Default is 13.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export orange(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) =>
    color result = switch saturationLevel
        13 => darkLevel == 1 ? color.new(#ff9e40, opacity) : darkLevel == 2 ? color.new(#ff6d00, opacity) : color.new(#c43c00, opacity)
        12 => darkLevel == 1 ? color.new(#ffc246, opacity) : darkLevel == 2 ? color.new(#ff9100, opacity) : color.new(#c56200, opacity)
        11 => darkLevel == 1 ? color.new(#ffdd71, opacity) : darkLevel == 2 ? color.new(#ffab40, opacity) : color.new(#c77c02, opacity)
        10 => darkLevel == 1 ? color.new(#ffffb1, opacity) : darkLevel == 2 ? color.new(#ffd180, opacity) : color.new(#caa052, opacity)
        9  => darkLevel == 1 ? color.new(#ff833a, opacity) : darkLevel == 2 ? color.new(#e65100, opacity) : color.new(#ac1900, opacity)
        8  => darkLevel == 1 ? color.new(#ff9d3f, opacity) : darkLevel == 2 ? color.new(#ef6c00, opacity) : color.new(#b53d00, opacity)
        7  => darkLevel == 1 ? color.new(#ffad42, opacity) : darkLevel == 2 ? color.new(#f57c00, opacity) : color.new(#bb4d00, opacity)
