// @function        Generates a specific shade of blue.
// @param saturationLevel (int) Saturation level (1-13). Default is 13.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export blue(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) =>
    color result = switch saturationLevel
        13 => darkLevel == 1 ? color.new(#768fff, opacity) : darkLevel == 2 ? color.new(#2962ff, opacity) : color.new(#0039cb, opacity)
        12 => darkLevel == 1 ? color.new(#75a7ff, opacity) : darkLevel == 2 ? color.new(#2979ff, opacity) : color.new(#004ecb, opacity)
        11 => darkLevel == 1 ? color.new(#83b9ff, opacity) : darkLevel == 2 ? color.new(#448aff, opacity) : color.new(#005ecb, opacity)
        10 => darkLevel == 1 ? color.new(#b6e3ff, opacity) : darkLevel == 2 ? color.new(#82b1ff, opacity) : color.new(#4d82cb, opacity)
        9  => darkLevel == 1 ? color.new(#5472d3, opacity) : darkLevel == 2 ? color.new(#0d47a1, opacity) : color.new(#002171, opacity)
        8  => darkLevel == 1 ? color.new(#5e92f3, opacity) : darkLevel == 2 ? color.new(#1565c0, opacity) : color.new(#003c8f, opacity)
        7  => darkLevel == 1 ? color.new(#63a4ff, opacity) : darkLevel == 2 ? color.new(#1976d2, opacity) : color.new(#004ba0, opacity)
        6  => darkLevel == 1 ? color.new(#6ab7ff, opacity) : darkLevel == 2 ? color.new(#1e88e5, opacity) : color.new(#005cb2, opacity)
        5  => darkLevel == 1 ? color.new(#6ec6ff, opacity) : darkLevel == 2 ? color.new(#2196f3, opacity) : color.new(#0069c0, opacity)
        4  => darkLevel == 1 ? color.new(#80d6ff, opacity) : darkLevel == 2 ? color.new(#42a5f5, opacity) : color.new(#0077c2, opacity)
        3  => darkLevel == 1 ? color.new(#9be7ff, opacity) : darkLevel == 2 ? color.new(#64b5f6, opacity) : color.new(#2286c3, opacity)
