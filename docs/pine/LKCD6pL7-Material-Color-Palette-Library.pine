//@version=6
// @description 
library("MaterialColorPalette")

// @function        Generates a specific shade of red based on saturation, darkness, and opacity.
// @param saturationLevel (int) Value 1-13 defining the color's saturation level. Default is 13.
// @param darkLevel     (int) Value 1-3 defining the color's darkness level (1: light, 2: medium, 3: dark). Default is 2.
// @param opacity       (int) Opacity value (0-100). Default is 0.
// @returns           (color) The calculated color.
export red(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) =>
    color result = switch saturationLevel // Explicitly type the return value
        13 => darkLevel == 1 ? color.new(#ff5131, opacity) : darkLevel == 2 ? color.new(#d50000, opacity) : color.new(#9b0000, opacity)
        12 => darkLevel == 1 ? color.new(#ff616f, opacity) : darkLevel == 2 ? color.new(#ff1744, opacity) : color.new(#c4001d, opacity)
        11 => darkLevel == 1 ? color.new(#ff867f, opacity) : darkLevel == 2 ? color.new(#ff5252, opacity) : color.new(#c50e29, opacity)
        10 => darkLevel == 1 ? color.new(#ffbcaf, opacity) : darkLevel == 2 ? color.new(#ff8a80, opacity) : color.new(#c85a54, opacity)
        9  => darkLevel == 1 ? color.new(#f05545, opacity) : darkLevel == 2 ? color.new(#b71c1c, opacity) : color.new(#7f0000, opacity)
        8  => darkLevel == 1 ? color.new(#ff5f52, opacity) : darkLevel == 2 ? color.new(#c62828, opacity) : color.new(#8e0000, opacity)
        7  => darkLevel == 1 ? color.new(#ff6659, opacity) : darkLevel == 2 ? color.new(#d32f2f, opacity) : color.new(#9a0007, opacity)
        6  => darkLevel == 1 ? color.new(#ff6f60, opacity) : darkLevel == 2 ? color.new(#e53935, opacity) : color.new(#ab000d, opacity)
        5  => darkLevel == 1 ? color.new(#ff7961, opacity) : darkLevel == 2 ? color.new(#f44336, opacity) : color.new(#ba000d, opacity)
        4  => darkLevel == 1 ? color.new(#ff867c, opacity) : darkLevel == 2 ? color.new(#ef5350, opacity) : color.new(#b61827, opacity)
        3  => darkLevel == 1 ? color.new(#ffa4a2, opacity) : darkLevel == 2 ? color.new(#e57373, opacity) : color.new(#af4448, opacity)
        2  => darkLevel == 1 ? color.new(#ffcccb, opacity) : darkLevel == 2 ? color.new(#ef9a9a, opacity) : color.new(#ba6b6c, opacity)
        1  => darkLevel == 1 ? color.new(#ffffff, opacity) : darkLevel == 2 ? color.new(#ffcdd2, opacity) : color.new(#cb9ca1, opacity)

    result // Return the calculated color

// @function        Generates a specific shade of pink.
// @param saturationLevel (int) Saturation level (1-13). Default is 13.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export pink(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) =>
    color result = switch saturationLevel
        13 => darkLevel == 1 ? color.new(#fd558f, opacity) : darkLevel == 2 ? color.new(#c51162, opacity) : color.new(#8e0038, opacity)
        12 => darkLevel == 1 ? color.new(#ff5983, opacity) : darkLevel == 2 ? color.new(#f50057, opacity) : color.new(#bb002f, opacity)
        11 => darkLevel == 1 ? color.new(#ff79b0, opacity) : darkLevel == 2 ? color.new(#ff4081, opacity) : color.new(#c60055, opacity)
        10 => darkLevel == 1 ? color.new(#ffb2dd, opacity) : darkLevel == 2 ? color.new(#ff80ab, opacity) : color.new(#c94f7c, opacity)
        9  => darkLevel == 1 ? color.new(#bc477b, opacity) : darkLevel == 2 ? color.new(#880e4f, opacity) : color.new(#560027, opacity)
        8  => darkLevel == 1 ? color.new(#e35183, opacity) : darkLevel == 2 ? color.new(#ad1457, opacity) : color.new(#78002e, opacity)
        7  => darkLevel == 1 ? color.new(#fa5788, opacity) : darkLevel == 2 ? color.new(#c2185b, opacity) : color.new(#8c0032, opacity)
        6  => darkLevel == 1 ? color.new(#ff5c8d, opacity) : darkLevel == 2 ? color.new(#d81b60, opacity) : color.new(#a00037, opacity)
        5  => darkLevel == 1 ? color.new(#ff6090, opacity) : darkLevel == 2 ? color.new(#e91e63, opacity) : color.new(#b0003a, opacity)
        4  => darkLevel == 1 ? color.new(#ff77a9, opacity) : darkLevel == 2 ? color.new(#ec407a, opacity) : color.new(#b4004e, opacity)
        3  => darkLevel == 1 ? color.new(#ff94c2, opacity) : darkLevel == 2 ? color.new(#f06292, opacity) : color.new(#ba2d65, opacity)
        2  => darkLevel == 1 ? color.new(#ffc1e3, opacity) : darkLevel == 2 ? color.new(#f48fb1, opacity) : color.new(#bf5f82, opacity)
        1  => darkLevel == 1 ? color.new(#ffeeff, opacity) : darkLevel == 2 ? color.new(#f8bbd0, opacity) : color.new(#c48b9f, opacity)
        
    result

// @function        Generates a specific shade of purple.
// @param saturationLevel (int) Saturation level (1-13). Default is 13.
// @param darkLevel     (int) Darkness level (1-3). Default is 2.
// @param opacity       (int) Opacity (0-100). Default is 0.
// @returns           (color) The calculated color.
export purple(int saturationLevel = 13, int darkLevel = 2, int opacity = 0) =>
    color result = switch saturationLevel
        13 => darkLevel == 1 ? color.new(#e254ff, opacity) : darkLevel == 2 ? color.new(#aa00ff, opacity) : color.new(#7200ca, opacity)
        12 => darkLevel == 1 ? color.new(#ff5bff, opacity) : darkLevel == 2 ? color.new(#d500f9, opacity) : color.new(#9e00c5, opacity)
        11 => darkLevel == 1 ? color.new(#ff79ff, opacity) : darkLevel == 2 ? color.new(#e040fb, opacity) : color.new(#aa00c7, opacity)
        10 => darkLevel == 1 ? color.new(#ffb2ff, opacity) : darkLevel == 2 ? color.new(#ea80fc, opacity) : color.new(#b64fc8, opacity)
        9  => darkLevel == 1 ? color.new(#7c43bd, opacity) : darkLevel == 2 ? color.new(#4a148c, opacity) : color.new(#12005e, opacity)
        8  => darkLevel == 1 ? color.new(#9c4dcc, opacity) : darkLevel == 2 ? color.new(#6a1b9a, opacity) : color.new(#38006b, opacity)
        7  => darkLevel == 1 ? color.new(#ae52d4, opacity) : darkLevel == 2 ? color.new(#7b1fa2, opacity) : color.new(#4a0072, opacity)
        6  => darkLevel == 1 ? color.new(#c158dc, opacity) : darkLevel == 2 ? color.new(#8e24aa, opacity) : color.new(#5c007a, opacity)
        5  => darkLevel == 1 ? color.new(#d05ce3, opacity) : darkLevel == 2 ? color.new(#9c27b0, opacity) : color.new(#6a0080, opacity)
        4  => darkLevel == 1 ? color.new(#df78ef, opacity) : darkLevel == 2 ? color.new(#ab47bc, opacity) : color.new(#790e8b, opacity)
        3  => darkLevel == 1 ? color.new(#ee98fb, opacity) : darkLevel == 2 ? color.new(#ba68c8, opacity) : color.new(#883997, opacity)
        2  => darkLevel == 1 ? color.new(#ffc4ff, opacity) : darkLevel == 2 ? color.new(#ce93d8, opacity) : color.new(#9c64a6, opacity)
        1  => darkLevel == 1 ? color.new(#fff1ff, opacity) : darkLevel == 2 ? color.new(#e1bee7, opacity) : color.new(#af8eb5, opacity)
        
    result

// @function        Generates a specific shade of deep purple.
