        5  => darkLevel == 1 ? color.new(#ffc947, opacity) : darkLevel == 2 ? color.new(#ff9800, opacity) : color.new(#c66900, opacity)
        4  => darkLevel == 1 ? color.new(#ffd95b, opacity) : darkLevel == 2 ? color.new(#ffa726, opacity) : color.new(#c77800, opacity)
        3  => darkLevel == 1 ? color.new(#ffe97d, opacity) : darkLevel == 2 ? color.new(#ffb74d, opacity) : color.new(#c88719, opacity)
