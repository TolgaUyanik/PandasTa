//@version=6

// @description Kerbal Indicators Shared Library - Drawing object helpers
// This library provides utilities for managing labels, boxes, and areas within Pine Script limits (500 each).
// Includes deduplication, cleanup, filtering, and zone management functions.
library("kerbal_helpers", overlay = true)

// ============================================
// FILTERING UTILITIES
// ============================================

// @function Check if an object is too old based on bar index
// @param barIndex Current bar index
// @param creationBar Bar index when object was created
// @param maxAge Maximum age in bars
// @returns True if object should be filtered out (too old)
export ageFilter(int barIndex, int creationBar, int maxAge) =>
    barIndex - creationBar > maxAge

// @function Check if price is within acceptable distance from reference
// @param price The price to check
// @param referencePrice The reference price
// @param atrMultiplier ATR multiplier for distance
// @param atr The ATR value
// @returns True if within acceptable distance
export distanceFilter(float price, float referencePrice, float atrMultiplier, float atr) =>
    math.abs(price - referencePrice) <= atr * atrMultiplier

// @function Check if weight meets minimum threshold
// @param weight The weight value
// @param minWeight Minimum acceptable weight
// @returns True if weight is acceptable
export weightFilter(float weight, float minWeight) =>
    weight >= minWeight

// @function Check perfection requirement (for Price Exhaustion clusters)
// @param isPerfected Whether the signal is perfected
// @param requirePerfection Whether perfection is required
// @returns True if passes perfection filter
export perfectionFilter(bool isPerfected, bool requirePerfection) =>
    not requirePerfection or isPerfected

// ============================================
// BOX/AREA UTILITIES
// ============================================

// @function Check if two boxes overlap in price space
// @param box1Top Top price of first box
// @param box1Bot Bottom price of first box
// @param box2Top Top price of second box
// @param box2Bot Bottom price of second box
// @returns True if boxes overlap
export boxOverlaps(float box1Top, float box1Bot, float box2Top, float box2Bot) =>
    not (box1Bot > box2Top or box1Top < box2Bot)

// @function Calculate the merged boundaries of two overlapping boxes
// @param box1Top Top price of first box
// @param box1Bot Bottom price of first box
// @param box2Top Top price of second box
// @param box2Bot Bottom price of second box
// @returns Tuple [mergedTop, mergedBot]
export boxMerge(float box1Top, float box1Bot, float box2Top, float box2Bot) =>
    float mergedTop = math.max(box1Top, box2Top)
    float mergedBot = math.min(box1Bot, box2Bot)
    [mergedTop, mergedBot]

// @function Check if a price is within a box/zone
// @param price The price to check
// @param boxTop Top of the box
// @param boxBot Bottom of the box
// @returns True if price is within box boundaries
export priceInZone(float price, float boxTop, float boxBot) =>
    price >= boxBot and price <= boxTop

// @function Calculate the center price of a zone
// @param boxTop Top of the zone
// @param boxBot Bottom of the zone
// @returns Center price
export zoneCenter(float boxTop, float boxBot) =>
    (boxTop + boxBot) / 2.0

// @function Calculate zone width/thickness
// @param boxTop Top of the zone
// @param boxBot Bottom of the zone
// @returns Zone width
export zoneWidth(float boxTop, float boxBot) =>
    boxTop - boxBot

// ============================================
// LABEL DEDUPLICATION HELPERS
// ============================================

// @function Check if two labels would be too close (for deduplication)
// @param x1 Bar index of first label
// @param y1 Price of first label
// @param x2 Bar index of second label
// @param y2 Price of second label
// @param barTolerance Maximum bar distance for considering labels duplicate
// @param priceTolerance Maximum price distance for considering labels duplicate
// @returns True if labels are close enough to be considered duplicates
export labelsNearby(int x1, float y1, int x2, float y2, int barTolerance, float priceTolerance) =>
    math.abs(x1 - x2) <= barTolerance and math.abs(y1 - y2) <= priceTolerance

// @function Calculate distance score between two label positions (lower is closer)
// @param x1 Bar index of first label
// @param y1 Price of first label
// @param x2 Bar index of second label
// @param y2 Price of second label
// @param atr ATR value for price normalization
// @returns Distance score (0+ range, lower means closer)
export labelDistance(int x1, float y1, int x2, float y2, float atr) =>
    float barDist = math.abs(x1 - x2)
    float priceDist = atr > 0 ? math.abs(y1 - y2) / atr : math.abs(y1 - y2)
    math.sqrt(barDist * barDist + priceDist * priceDist)

// ============================================
// CLUSTER TYPE CLASSIFICATION
// ============================================

// @function Classify cluster composition based on anchor types present
// @param hasSession Whether cluster contains session anchors (daily/weekly)
// @param hasPivot Whether cluster contains pivot anchors
// @param hasVolume Whether cluster contains volume anchors
// @param weight Total cluster weight
// @param goldThreshold Weight threshold for "gold" classification
// @param limeThreshold Weight threshold for "lime" classification
// @returns Cluster type: "GOLD", "LIME", "MIXED", "SESSION", "PIVOT", "VOLUME"
export clusterType(bool hasSession, bool hasPivot, bool hasVolume, float weight, float goldThreshold = 10.0, float limeThreshold = 5.0) =>
    string cType = "MIXED"
    
    // Count anchor types present
    int typeCount = 0
    if hasSession
        typeCount += 1
    if hasPivot
        typeCount += 1
    if hasVolume
        typeCount += 1
    
    // Gold: Very high weight, mixed types
    if weight >= goldThreshold and typeCount >= 2
        cType := "GOLD"
    // Lime: High weight, any composition
    else if weight >= limeThreshold
        cType := "LIME"
    // Single type clusters
    else if typeCount == 1
        if hasSession
            cType := "SESSION"
        else if hasPivot
            cType := "PIVOT"
        else if hasVolume
            cType := "VOLUME"
    
    cType

// @function Get color for cluster based on type
// @param clusterType The cluster type string
// @returns Appropriate color for the cluster type
export clusterColor(string clusterType) =>
    color col = color.gray
    if clusterType == "GOLD"
        col := color.yellow
    else if clusterType == "LIME"
        col := color.lime
    else if clusterType == "SESSION"
        col := color.blue
    else if clusterType == "PIVOT"
        col := color.purple
    else if clusterType == "VOLUME"
        col := color.orange
    col

// ============================================
// ZONE/LEVEL MANAGEMENT
// ============================================

// @function Check if a zone is significant enough to display
// @param weight Zone weight
// @param width Zone width in price
// @param minWeight Minimum weight threshold
// @param maxWidth Maximum width threshold (ATR-based)
// @returns True if zone should be displayed
export zoneSignificant(float weight, float width, float minWeight, float maxWidth) =>
    weight >= minWeight and width <= maxWidth

// @function Merge multiple nearby zones into a single wider zone
// @param prices Array of zone center prices
// @param widths Array of zone widths
// @param tolerance Merging tolerance (typically ATR-based)
// @returns Tuple of [mergedCenters, mergedWidths] arrays
export mergeZones(array<float> prices, array<float> widths, float tolerance) =>
    int size = array.size(prices)
    
    var array<float> mergedCenters = array.new<float>()
    var array<float> mergedWidths = array.new<float>()
    array.clear(mergedCenters)
    array.clear(mergedWidths)
    
    if size == 0
        [mergedCenters, mergedWidths]
    else
        array<bool> used = array.new<bool>(size, false)
        
        for i = 0 to size - 1
            if not array.get(used, i)
                float basePrice = array.get(prices, i)
                float baseWidth = array.get(widths, i)
                float minPrice = basePrice - baseWidth / 2.0
                float maxPrice = basePrice + baseWidth / 2.0
                
                // Find overlapping zones
                for j = i + 1 to size - 1
                    if not array.get(used, j)
                        float priceJ = array.get(prices, j)
                        float widthJ = array.get(widths, j)
                        float minPriceJ = priceJ - widthJ / 2.0
                        float maxPriceJ = priceJ + widthJ / 2.0
                        
                        // Check for overlap with tolerance
                        if math.abs(basePrice - priceJ) <= tolerance or 
                           (minPriceJ >= minPrice - tolerance and minPriceJ <= maxPrice + tolerance) or
                           (maxPriceJ >= minPrice - tolerance and maxPriceJ <= maxPrice + tolerance)
                            minPrice := math.min(minPrice, minPriceJ)
                            maxPrice := math.max(maxPrice, maxPriceJ)
                            array.set(used, j, true)
                
                // Store merged zone
                float mergedCenter = (maxPrice + minPrice) / 2.0
                float mergedWidth = maxPrice - minPrice
                array.push(mergedCenters, mergedCenter)
                array.push(mergedWidths, mergedWidth)
        
        [mergedCenters, mergedWidths]

// @function Calculate support and resistance levels from an array of prices
// @param prices Array of price levels
// @param currentPrice Current market price
// @returns Tuple of [nearestSupport, nearestResistance]
export findSupportResistance(array<float> prices, float currentPrice) =>
    int size = array.size(prices)
    float support = na
    float resistance = na
    
    if size > 0
        float closestBelow = -1e10
        float closestAbove = 1e10
        
        for i = 0 to size - 1
            float price = array.get(prices, i)
            if not na(price)
                if price < currentPrice and price > closestBelow
                    closestBelow := price
                else if price > currentPrice and price < closestAbove
                    closestAbove := price
        
        support := closestBelow > -1e10 ? closestBelow : na
        resistance := closestAbove < 1e10 ? closestAbove : na
    
    [support, resistance]

// ============================================
// VOLUME-WEIGHTED ZONE SCORING
// ============================================

// @function Calculate zone strength score based on multiple factors
// @param weight Zone weight (volume participation)
// @param age Bars since zone creation
// @param touches Number of price touches/tests
// @param width Zone width
// @param maxAge Maximum age for full score
// @param maxTouches Maximum touches for full score
// @param optimalWidth Optimal zone width (narrower is better)
// @returns Strength score 0-100
export zoneStrength(float weight, int age, int touches, float width, int maxAge = 100, int maxTouches = 10, float optimalWidth = 1.0) =>
    // Weight component (0-40 points)
    float weightScore = math.min(weight / 10.0 * 40.0, 40.0)
    
    // Age component (0-20 points, fresher is better)
    float ageScore = age < maxAge ? (1.0 - age / maxAge) * 20.0 : 0.0
    
    // Touch component (0-20 points)
    float touchScore = math.min(touches / maxTouches * 20.0, 20.0)
    
    // Width component (0-20 points, narrower is better up to optimal)
    float widthScore = width <= optimalWidth ? 20.0 : math.max(20.0 - (width - optimalWidth) * 5.0, 0.0)
    
    weightScore + ageScore + touchScore + widthScore
