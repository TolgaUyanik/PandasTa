library("K21Common")

export const string TRADE_TEMPLATE_TAGS_TOOLTIP = "Available template tags:\n" +
     "%_entry_num_% - Entry number (1-5)\n" +
     "%_entry_nice_num_% - Entry number with suffix (1st, 2nd, etc.)\n" +
     "%_description_% - Entry description\n" +
     "%_entry_price_% - Entry price\n" +
     "%_stop_price_% - Stop loss price\n" +
     "%_tp_price_% - Take profit price\n" +
     "%_sl_ticks_% - Stop loss distance in ticks\n" +
     "%_sl_points_% - Stop loss distance in points\n" +
     "%_tp_ticks_% - Take profit distance in ticks\n" +
     "%_tp_points_% - Take profit distance in points\n" +
     "%_contracts_% - Number of contracts\n" +
     "%_risk_$_% - Risk in dollars\n" +
     "%_max_risk_$_% - Maximum allowed risk in dollars\n" +
     "%_reward_$_% - Reward in dollars\n" +
     "%_risk_reward_ratio_% - Risk:Reward ratio"


// @function        Calculates the minimum dollar move per tick for the current symbol
// @returns         (float) Dollar value per tick movement
// @description     Uses syminfo.pointvalue (contract value per point) and syminfo.minmove
//                  (minimum tick movement) to calculate the dollar value of a single tick.
//                  This works across all futures contracts without manual configuration.
export minDollarMove() =>
    math.round( syminfo.mintick * syminfo.pointvalue, 2)


// @function                Replaces trade related template tags with actual values
// @param template          (string) Template string with tags
// @param entry_num         (int) Entry number (1-5)
// @param description       (string) Entry description
// @param entry_price       (float) Entry price
// @param stop_price        (float) Stop price
// @param tp_price          (float) TP price
// @param contracts         (int) Number of contracts
// @param risk_dollars      (float) Risk in dollars
// @param reward_dollars    (float) Reward in dollars
// @param rr_ratio          (float) Risk:Reward ratio
// @param max_risk          (float) Maximum allowed risk
// @returns                 (string) Processed template string
export replaceTradeTemplateTags(string template, int entry_num = na, string description = na, 
 float entry_price = na, float stop_price = na, float tp_price = na, int contracts = na, float risk_dollars = na, 
 float reward_dollars = na, float rr_ratio = na, float max_risk = na) =>
    _tpl = template

    if str.contains(_tpl, "%_entry_nice_num_%")
        nice_num =
          switch entry_num
            1 => "1st"
            2 => "2nd"
            3 => "3rd"
            4 => "4th"
            5 => "5th"
            => str.tostring(entry_num)
        _tpl := str.replace_all(_tpl, "%_entry_nice_num_%", nice_num)

    if str.contains(_tpl, "%_entry_num_%")
        _tpl := str.replace_all(_tpl, "%_entry_num_%", str.tostring(entry_num))

    if str.contains(_tpl, "%_description_%")
        _tpl := str.replace_all(_tpl, "%_description_%", description)

    if str.contains(_tpl, "%_entry_price_%")
        _tpl := str.replace_all(_tpl, "%_entry_price_%", str.tostring(math.round_to_mintick(entry_price)))

    if str.contains(_tpl, "%_stop_price_%")
        _tpl := str.replace_all(_tpl, "%_stop_price_%", str.tostring(math.round_to_mintick(stop_price)))

    if str.contains(_tpl, "%_tp_price_%")
        _tpl := str.replace_all(_tpl, "%_tp_price_%", str.tostring(math.round_to_mintick(tp_price)))

    if str.contains(_tpl, "%_sl_ticks_%")
        sl_ticks = math.round(math.abs(entry_price - stop_price) / syminfo.mintick)
        _tpl := str.replace_all(_tpl, "%_sl_ticks_%", str.tostring(sl_ticks))

    if str.contains(_tpl, "%_sl_points_%")
        sl_points = math.round_to_mintick(math.abs(entry_price - stop_price))
        _tpl := str.replace_all(_tpl, "%_sl_points_%", str.tostring(sl_points, "#.##"))

    if str.contains(_tpl, "%_tp_ticks_%")
        tp_ticks = math.round(math.abs(tp_price - entry_price) / syminfo.mintick)
        _tpl := str.replace_all(_tpl, "%_tp_ticks_%", str.tostring(tp_ticks))

    if str.contains(_tpl, "%_tp_points_%")
        tp_points = math.round_to_mintick(math.abs(tp_price - entry_price))
        _tpl := str.replace_all(_tpl, "%_tp_points_%", str.tostring(tp_points, "#.##"))

    if str.contains(_tpl, "%_contracts_%")
        _tpl := str.replace_all(_tpl, "%_contracts_%", str.tostring(contracts))

    if str.contains(_tpl, "%_risk_$_%")
        _tpl := str.replace_all(_tpl, "%_risk_$_%", str.tostring(risk_dollars, "#.##"))

    if str.contains(_tpl, "%_max_risk_$_%")
        _tpl := str.replace_all(_tpl, "%_max_risk_$_%", str.tostring(max_risk, "#.##"))

    if str.contains(_tpl, "%_reward_$_%")
        _tpl := str.replace_all(_tpl, "%_reward_$_%", str.tostring(reward_dollars, "#.##"))

    if str.contains(_tpl, "%_risk_reward_ratio_%")
        _tpl := str.replace_all(_tpl, "%_risk_reward_ratio_%", str.tostring(rr_ratio, "#.##"))

    _tpl


// @function        Checks if a color is light based on luminance calculation
// @param clr        (color) The color to check
// @returns         (bool) True if the color is light
export isLightColor(color clr) =>
    (color.r(clr) * 0.2126 + color.g(clr) * 0.7152 + color.b(clr) * 0.0722) / 255 > 0.5

// @function        Checks if a color is dark based on luminance calculation
// @param clr        (color) The color to check
// @returns         (bool) True if the color is dark
export isDarkColor(color clr) =>
    not isLightColor(clr)

// @function        Checks if the current chart color scheme is light
// @returns         (bool) True if the chart uses a light color scheme
export isLightScheme() =>
    (color.r(chart.bg_color) * 0.2126 + color.g(chart.bg_color) * 0.7152 + color.b(chart.bg_color) * 0.0722) / 255 > 0.5

// @function        Checks if the current chart color scheme is dark
// @returns         (bool) True if the chart uses a dark color scheme
export isDarkScheme() =>
    not isLightScheme()

// @function                Finds the bar_index for a given timestamp by searching historical bars
// @param target_time       (int) The timestamp to find
// @returns                 (int) The bar_index where time matches or is closest to target_time
export getBarIndexFromTime(int target_time) =>
    int found_bar_index = na

    if not na(target_time) 
        if target_time < time
            // Search backwards through history to find the bar with matching time
            int lookback = 0
            bool found = false

            while lookback <= bar_index and lookback < 5000 and not found
                if time[lookback] <= target_time
                    // Found the bar at or before target time
                    found_bar_index := bar_index - lookback
                    found := true
                lookback += 1
        else if target_time >= time and target_time < time_close
            found_bar_index := bar_index 
        else // find projected bar_index    
            int lookforward = 0 
            max_look = math.ceil( target_time - time ) / (time_close - time)
            bool found = false 
            while lookforward < max_look
                lookforward += 1
                n_time = time("", "", lookforward * -1)
                if n_time >= target_time and n_time <= target_time + (time_close-time)
                    found_bar_index := bar_index + lookforward
                    break
                      
    found_bar_index
