//@version=5
library("Touched")

export type Zone
    float High
    float Low
    int BaseTime

export type Touch
    bool Up
    bool Down
    int Length
    int ExtremeIndexBack

// @function Tells if the zone has been broken on the current bar.
// @param zone The definitiin of the zone.
// @param lookback How many bars to look back.
// @returns a Touch object that tells if the zone has been broken up or down.
export Breakout(Zone zone, int lookback) =>
    breakout = Touch.new(ExtremeIndexBack = 0)
    // /
    if low > zone.High
      and low[1] <= zone.High
        for i = 1 to lookback
            if zone.BaseTime > time[i]
                break

            if low[i] > zone.High
                break

            if high[i] <= zone.Low
                breakout.Up := true
                breakout.Length := i
                break
    // \
    if high < zone.Low
      and high[1] >= zone.Low
        for i = 1 to lookback
            if zone.BaseTime > time[i]
                break

            if high[i] < zone.Low
                break

            if low[i] >= zone.High
                breakout.Down := true
                breakout.Length := i
                break

    breakout
// @function Tells if the zone has a false breakout on the current bar. It's concidered to be a false breakout if the zone has been passed with the top/bottom.
// @param zone The definition of the zone.
// @param lookback How many bars to look back.
// @returns a Touch object that tells if the zone has had a false breakout up or down.
export FalseBreakout(Zone zone, int lookback) =>
    falseBreakout = Touch.new()
    //   /'\    \
    //  /   \    \  /'\
    // /      or  \/   \
    if high < zone.Low
      and high[1] >= zone.Low
        higher = false
        highest = 0.
        for i = 0 to lookback
            if zone.BaseTime > time[i]
                break

            if high[i] > zone.High
                higher := true

            if high[i] > highest
                highest := high[i]
                falseBreakout.ExtremeIndexBack := i

            if higher
              and high[i] <= zone.Low
                falseBreakout.Up := true
                falseBreakout.Length := i
                break

            if i > 0
              and high[i] <= zone.Low
                break // previous false breakout
    // \          /\   /
    //  \   /    /  \./
    //   \./ or /
    if low > zone.High
      and low[1] <= zone.High
        lower = false
        lowest = 2147483647.
        for i = 0 to lookback
            if zone.BaseTime > time[i]
                break

            if low[i] < zone.Low
                lower := true
                
            if low[i] < lowest
                lowest := low[i]
                falseBreakout.ExtremeIndexBack := i

            if lower
              and low[i] >= zone.High
                falseBreakout.Down := true
                falseBreakout.Length := i
                break

            if i > 0
              and low[i] >= zone.High
                break // previous false breakout

    falseBreakout
// @function Tells if the zone has been retested on the current bar.
// @param zone The definitiin of the zone.
// @param lookback How many bars to look back.
// @returns a Touch object that tells if the zone has been retested up or down.
export Retest(Zone zone, int lookback) =>
    retest = Touch.new()
    // \/
    if low > zone.High
      and low[1] <= zone.High
        lowest = 2147483647.
        for i = 1 to lookback
            if zone.BaseTime > time[i]
                break

            if low[i] < zone.Low
                break // reached below the zone, no retest

            if low[i] >= zone.High and lowest != 2147483647
                retest.Down := true
                retest.Length := i
                break

            if low[i] < lowest
                lowest := low[i]
                retest.ExtremeIndexBack := i

    // /\
    if high < zone.Low
      and high[1] >= zone.Low
        highest = 0.
        for i = 1 to lookback
            if zone.BaseTime > time[i]
                break

            if high[i] > zone.High
                break // reached above the zone, no retest

            if high[i] <= zone.Low and highest != 0
                retest.Up := true
                retest.Length := i
                break

            if high[i] > highest
                highest := high[i]
                retest.ExtremeIndexBack := i

    retest