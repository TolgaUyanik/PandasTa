    bull5 = isDivergenceBearOverbought(5,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range, min_range, atr,pivot_right_fast, pivot_high_true,pivotHighFast)
    bull6 = isDivergenceBearOverbought(6,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range, min_range, atr,pivot_right_fast, pivot_high_true,pivotHighFast)
    bull7 = isDivergenceBearOverbought(7,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range, min_range, atr,pivot_right_fast, pivot_high_true,pivotHighFast)
    bull8 = isDivergenceBearOverbought(8,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range, min_range, atr,pivot_right_fast, pivot_high_true,pivotHighFast)
    bull9 = isDivergenceBearOverbought(9,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range, min_range, atr,pivot_right_fast, pivot_high_true,pivotHighFast)
    bull10 = isDivergenceBearOverbought(10,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range, min_range, atr,pivot_right_fast, pivot_high_true,pivotHighFast)

    bullRsiFast =  bull+ bull1+bull2 + bull3 +bull4+bull5+bull6+bull7+bull8+bull9+bull10


// rsi bear 

export DivergenceBear(float mainIndicator,color lineColor,float barValue,bool doubleTopBottomEnabled,bool isEnabled,bool isDeleteLine,int pivot_right,int pivot_left,int max_range,int min_range,float atr,bool pivot_high_true,bool pivotHighSlow)=>

    
    bull = isDivergenceBear(0,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)
    bull1 = isDivergenceBear(1,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)
    bull2 = isDivergenceBear(2,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)
