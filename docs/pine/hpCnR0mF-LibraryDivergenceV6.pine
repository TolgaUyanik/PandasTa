//@version=6

// @description Library for my divergence indicators
library("LibraryDivergenceV6")


withinRange(x2_barindex,pivot_right_x,max_range,min_range)=>
    x1_bar = bar_index-pivot_right_x
    totalBars = x1_bar-x2_barindex
    totalBars>(min_range) and totalBars< max_range 


// Avnänd denna som standard BearDivergenceMainIndicator
isDivergenceBear(occurence,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow) =>
 
    isBearDivergence = 0
    y2_prev_rsi_high = ta.valuewhen(pivot_high_true,mainIndicator[pivot_right],occurence)
    y2_prev_price_high = ta.valuewhen(pivot_high_true,barValue[pivot_right],occurence)   
    isPivotHigh = not na(ta.pivothigh(mainIndicator, pivot_left,pivot_right))
    x2_barindex = ta.valuewhen(isPivotHigh, bar_index[pivot_right], occurence)
    if pivotHighSlow and isEnabled
        rsi_ll =  mainIndicator[pivot_right]<y2_prev_rsi_high 
        price_hh = doubleTopBottomEnabled ? (barValue[pivot_right]+atr) > y2_prev_price_high : barValue[pivot_right] > y2_prev_price_high 
        withinRange = withinRange(x2_barindex,pivot_right,max_range,min_range)
        isBearDivergence := rsi_ll and price_hh and withinRange ? 1 : 0
        priceLine = isBearDivergence == 1 ? line.new(bar_index[pivot_right], barValue[pivot_right], bar_index[bar_index-x2_barindex], y2_prev_price_high, color = lineColor):na
        if isBearDivergence == 1
            index =(bar_index-x2_barindex-pivot_right)
            while index >= pivot_right
                if (barValue[index]-atr)>line.get_price(priceLine,bar_index[index])
                    line.delete(priceLine)
                    isBearDivergence := 0
                    break
                index-=1
        if isDeleteLine and na(priceLine) == false // delete Line if priceLine exist
            line.delete(priceLine)

    
    isBearDivergence

// Facit!
isDivergenceBearOverbought(occurence,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range, min_range, atr,pivot_right_fast, pivot_high_true,pivotHighFast) => 
    isBearDivergence = 0
    y2_prev_rsi_high = ta.valuewhen(pivot_high_true,mainIndicator[pivot_right],occurence)
    y2_prev_price_high = ta.valuewhen(pivot_high_true,barValue[pivot_right],occurence)

    isPivotLow = not na(ta.pivothigh(mainIndicator, pivot_left,pivot_right))
    x2_barindex = ta.valuewhen(isPivotLow, bar_index[pivot_right], occurence)
       
    if pivotHighFast and isEnabled
        rsi_ll =  mainIndicator[pivot_right_fast]<y2_prev_rsi_high 
        price_hh = doubleTopBottomEnabled ? (barValue[pivot_right]+atr) > y2_prev_price_high : barValue[pivot_right] > y2_prev_price_high 
        isBearDivergence := rsi_ll and price_hh and withinRange(x2_barindex,pivot_right_fast,max_range,min_range) ? 1 : 0
        priceLine = isBearDivergence == 1 ? line.new(bar_index[pivot_right_fast], barValue[pivot_right_fast], bar_index[bar_index-x2_barindex], y2_prev_price_high, color = lineColor):na
        if isBearDivergence == 1
            index =(bar_index-x2_barindex-pivot_right_fast)
            while index >= pivot_right_fast
                if (barValue[index]-atr)>line.get_price(priceLine,bar_index[index])
                    line.delete(priceLine)
                    isBearDivergence := 0
                    break
                index-=1
        if isDeleteLine and na(priceLine) == false // delete Line if priceLine exist
            line.delete(priceLine)
    isBearDivergence

//Facit
isDivergenceBull(occurence,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)=>
    isBullDivergence = 0
    y2_prev_rsi_low = ta.valuewhen(pivot_low_true,mainIndicator[pivot_right],occurence)
    y2_prev_price_low = ta.valuewhen(pivot_low_true,barValue[pivot_right],occurence)

    isPivotLow = not na(ta.pivotlow(mainIndicator, pivot_left,pivot_right))
    x2_barindex = ta.valuewhen(isPivotLow, bar_index[pivot_right], occurence)
        
    if pivotLowSlow and isEnabled
        rsi_hh =  mainIndicator[pivot_right]>y2_prev_rsi_low 
        price_ll = doubleTopBottomEnabled ? (barValue[pivot_right]-atr) < y2_prev_price_low :barValue[pivot_right] < y2_prev_price_low  // atr is for intepreting double bottom as divergence
        withinRange = withinRange(x2_barindex,pivot_right,max_range,min_range)
        isBullDivergence := rsi_hh and price_ll and withinRange ? 1:0
        priceLine = isBullDivergence == 1 ? line.new(bar_index[pivot_right], barValue[pivot_right], bar_index[bar_index-x2_barindex], y2_prev_price_low, color = lineColor):na
        if isBullDivergence == 1
            index =(bar_index-x2_barindex-pivot_right)
            while index >= pivot_right
                if (barValue[index]+atr)<line.get_price(priceLine,bar_index[index])
                    line.delete(priceLine)
                    isBullDivergence := 0
                    break
                index-=1
        if isDeleteLine and na(priceLine) == false // delete Line if priceLine exist
            line.delete(priceLine)
    isBullDivergence

isDivergenceBullOversold(occurence,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)=>
    isBullDivergence = 0
    y2_prev_rsi_low = ta.valuewhen(pivot_low_true,mainIndicator[pivot_right],occurence)
    y2_prev_price_low = ta.valuewhen(pivot_low_true,barValue[pivot_right],occurence)

    isPivotLow = not na(ta.pivotlow(mainIndicator, pivot_left,pivot_right))
    x2_barindex = ta.valuewhen(isPivotLow, bar_index[pivot_right], occurence)
       
    if pivotLowFast and isEnabled
        rsi_hh =  mainIndicator[pivot_right_fast]>y2_prev_rsi_low 
        price_ll = doubleTopBottomEnabled ? (barValue[pivot_right_fast]-atr) < y2_prev_price_low : barValue[pivot_right_fast] < y2_prev_price_low
        isBullDivergence := rsi_hh and price_ll and withinRange(x2_barindex,pivot_right_fast,max_range,min_range) ? 1:0
        priceLine = isBullDivergence == 1 ? line.new(bar_index[pivot_right_fast], barValue[pivot_right_fast], bar_index[bar_index-x2_barindex], y2_prev_price_low, color = lineColor):na
        if isBullDivergence == 1
            index =(bar_index-x2_barindex-pivot_right_fast)
            while index >= pivot_right_fast
                if (barValue[index]+atr)<line.get_price(priceLine,bar_index[index])
                    line.delete(priceLine)
                    isBullDivergence := 0
                    break
                index-=1
        if isDeleteLine and na(priceLine) == false // delete Line if priceLine exist
            line.delete(priceLine)
    isBullDivergence

// rsi bull oversold
export DivergenceBullOversold(float mainIndicator,color lineColor,float barValue,bool doubleTopBottomEnabled, bool isEnabled,bool isDeleteLine,int pivot_right,int pivot_left, int max_range,int min_range ,float atr,int pivot_right_fast,bool pivot_low_true,bool pivotLowFast)=>

    bull = isDivergenceBullOversold(0,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull2 = isDivergenceBullOversold(2,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull1 = isDivergenceBullOversold(1,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull3 = isDivergenceBullOversold(3,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull4 = isDivergenceBullOversold(4,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull5 = isDivergenceBullOversold(5,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull6 = isDivergenceBullOversold(6,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull7 = isDivergenceBullOversold(7,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull8 = isDivergenceBullOversold(8,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull9 = isDivergenceBullOversold(9,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)
    bull10 = isDivergenceBullOversold(10,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_right_fast,pivot_low_true,pivotLowFast)

    bullRsiFast = bull+bull1+bull2 + bull3 +bull4+bull5+bull6+bull7+bull8+bull9+bull
// rsi bull 
export DivergenceBull(float mainIndicator,color lineColor,float barValue,bool doubleTopBottomEnabled,bool isEnabled,bool isDeleteLine,int pivot_right,int pivot_left, int max_range,int min_range ,float atr,bool pivot_low_true ,bool pivotLowSlow)=>

    bull= isDivergenceBull(0,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull1= isDivergenceBull(1,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull2= isDivergenceBull(2,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull3= isDivergenceBull(3,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull4= isDivergenceBull(4,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull5= isDivergenceBull(5,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull6= isDivergenceBull(6,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull7= isDivergenceBull(7,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull8= isDivergenceBull(8,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull9= isDivergenceBull(9,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    bull10= isDivergenceBull(10,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_low_true,pivotLowSlow)
    
    bullRsi = bull+ bull1+bull2 + bull3 +bull4+bull5+bull6+bull7+bull8+bull9+bull10
    



// rsi bear overbought
export DivergenceBearOverbought(float mainIndicator,color lineColor,float barValue,bool doubleTopBottomEnabled,bool isEnabled,bool isDeleteLine,int pivot_right,int pivot_left,int max_range,int min_range,float atr,int pivot_right_fast,bool pivot_high_true,bool pivotHighFast)=>

    bull =  isDivergenceBearOverbought(0,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range, min_range, atr,pivot_right_fast, pivot_high_true,pivotHighFast)
