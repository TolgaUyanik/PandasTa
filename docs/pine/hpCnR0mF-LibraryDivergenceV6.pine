    bull4 = isDivergenceBear(4,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)
    bull5 = isDivergenceBear(5,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)
    bull6 = isDivergenceBear(6,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)
    bull7 = isDivergenceBear(7,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)
    bull8 = isDivergenceBear(8,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)
    bull9 = isDivergenceBear(9,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)
    bull10 =isDivergenceBear(10,lineColor,barValue,mainIndicator,doubleTopBottomEnabled,isEnabled,isDeleteLine,pivot_right,pivot_left,max_range,min_range,atr,pivot_high_true,pivotHighSlow)

    bullRsiFast =  bull+bull1+bull2 + bull3 +bull4+bull5+bull6+bull7+bull8+bull9+bull10 
    
