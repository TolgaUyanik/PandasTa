//@version=5
strategy("TWE 2-Bar Break Strategy", overlay=true, pyramiding=0)

// ===== INPUTS =====
emaLength = input.int(50, "EMA Trend Filter")

// ===== TREND =====
emaTrend = ta.ema(close, emaLength)

upTrend   = close > emaTrend
downTrend = close < emaTrend

// ===== TWO BAR BREAK =====
twoBarHigh = math.max(high[1], high[2])
twoBarLow  = math.min(low[1], low[2])

// ===== ENTRIES =====
buySignal  = high > twoBarHigh and upTrend
sellSignal = low < twoBarLow and downTrend

// ===== EXITS =====
closeBuy  = strategy.position_size > 0 and low < twoBarLow
closeSell = strategy.position_size < 0 and high > twoBarHigh

// ===== TRADES =====
if buySignal and strategy.position_size <= 0
    strategy.close("SELL")
    strategy.entry("BUY", strategy.long)

if sellSignal and strategy.position_size >= 0
    strategy.close("BUY")
    strategy.entry("SELL", strategy.short)

if closeBuy
    strategy.close("BUY")

if closeSell
    strategy.close("SELL")

// ===== VISUALS =====
plot(emaTrend, title="EMA Trend", color=color.yellow, linewidth=2)

plotshape(buySignal,
     title="BUY",
     text="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white)

plotshape(sellSignal,
     title="SELL",
     text="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white)

plotshape(closeBuy,
     title="CLOSE BUY",
     text="CLOSE BUY",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.orange,
     textcolor=color.white)

plotshape(closeSell,
     title="CLOSE SELL",
     text="CLOSE SELL",
     style=shape.labelup,
     location=location.belowbar,
     color=color.orange,
     textcolor=color.white)

// ===== ALERTS =====
alertcondition(buySignal, "BUY", "TWE BUY")
alertcondition(sellSignal, "SELL", "TWE SELL")
alertcondition(closeBuy, "CLOSE BUY", "TWE CLOSE BUY")
alertcondition(closeSell, "CLOSE SELL", "TWE CLOSE SELL")