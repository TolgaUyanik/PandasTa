//@version=6
indicator('EMA+ATR Band MTF Trend Entry', overlay = true)

// === INPUTS ===
// Entry Timeframe
emaLen = input.int(20, title = 'EMA Length', group = 'Entry Time Frame', minval = 0)
ema_src = input(title = 'EMA Source', defval = low, group = 'Entry Time Frame')
mov_avg = input.string('EMA', title = "Select EMA/SMA", options = ['EMA', 'SMA', 'FAMA-MAMA'], group = 'Entry Time Frame')
mama_avg = input.string('FAMA', title = "Select FAMA/MAMA", options = ['FAMA', 'MAMA'], group = 'Entry Time Frame')
atrLen = input.int(14, title = 'ATR Length', group = 'Entry Time Frame', minval = 0)
atrMult = input.float(1.0, title = 'ATR Multiplier', group = 'Entry Time Frame', minval =0, step=0.1)
pivotLook = input.int(7, title = 'Pivot Lookback', group = 'Entry Time Frame', minval = 0)
signal_lookback = input.int(7, title = 'Recent Siganal Lookback', group = 'Entry Time Frame', minval = 0)
atrMult_signal = input.float(0.27, title = "ATR fraction buffer for Signal", group = 'Entry Time Frame', minval = 0, maxval=1, step=0.01)
// RSI condition in HTF
rsiLen     = input.int(5, title="Higher TF RSI Length", group = 'RSI Time Frame', minval = 3)
rsi_upper  = input.int(70, title="Upper RIS Threshold", minval = 50, maxval = 95, step=5, group = 'RSI Time Frame')
rsi_lower  = input.int(30, title="Lower RIS Threshold", minval = 5, maxval = 50, step=5, group = 'RSI Time Frame')
//Trend Time Frame
fast_ema = input.int(20, title = "Trend Timeframe Fast EMA", minval = 3, group = 'Trend Time Frame')
slow_ema = input.int(50, title = "Trend Timeframe Slow EMA", minval = 3, group = 'Trend Time Frame')

//=== Use MAMA and FAMA moving average ===//
inp = input(title = 'Source', defval = low, group = 'FAMA & MAMA')
res = input.timeframe(title = 'Resolution', defval = '', group = 'FAMA & MAMA')
rep = input(title = 'Allow Repainting?', defval = false, group = 'FAMA & MAMA')
bar = input(title = 'Allow Bar Color Change (if MAMA)?', defval = false, group = 'FAMA & MAMA')
src = request.security(syminfo.tickerid, res, inp[rep ? 0 : barstate.isrealtime ? 1 : 0])[rep ? 0 : barstate.isrealtime ? 0 : 1]
fastLimit = input.float(title = 'FastLimit', defval = 0.5, minval = 0.01, step = 0.01, group = 'FAMA & MAMA')
slowLimit = input.float(title = 'SlowLimit', defval = 0.05, minval = 0.01, step = 0.01, group = 'FAMA & MAMA')

pi = 2 * math.asin(1)
period = 0.0
smooth = (4 * src + 3 * nz(src[1]) + 2 * nz(src[2]) + nz(src[3])) / 10
detrender = (0.0962 * smooth + 0.5769 * nz(smooth[2]) - 0.5769 * nz(smooth[4]) - 0.0962 * nz(smooth[6])) * (0.075 * nz(period[1]) + 0.54)

q1 = (0.0962 * detrender + 0.5769 * nz(detrender[2]) - 0.5769 * nz(detrender[4]) - 0.0962 * nz(detrender[6])) * (0.075 * nz(period[1]) + 0.54)
i1 = nz(detrender[3])

jI = (0.0962 * i1 + 0.5769 * nz(i1[2]) - 0.5769 * nz(i1[4]) - 0.0962 * nz(i1[6])) * (0.075 * nz(period[1]) + 0.54)
jQ = (0.0962 * q1 + 0.5769 * nz(q1[2]) - 0.5769 * nz(q1[4]) - 0.0962 * nz(q1[6])) * (0.075 * nz(period[1]) + 0.54)

i2 = i1 - jQ
i2 := 0.2 * i2 + 0.8 * nz(i2[1])
q2 = q1 + jI
q2 := 0.2 * q2 + 0.8 * nz(q2[1])

re = i2 * nz(i2[1]) + q2 * nz(q2[1])
re := 0.2 * re + 0.8 * nz(re[1])
im = i2 * nz(q2[1]) - q2 * nz(i2[1])
im := 0.2 * im + 0.8 * nz(im[1])

period := im != 0 and re != 0 ? 2 * pi / math.atan(im / re) : 0
period := math.min(math.max(period, 0.67 * nz(period[1])), 1.5 * nz(period[1]))
period := math.min(math.max(period, 6), 50)
period := 0.2 * period + 0.8 * nz(period[1])

smoothPeriod = 0.0
smoothPeriod := 0.33 * period + 0.67 * nz(smoothPeriod[1])

phase = i1 != 0 ? math.atan(q1 / i1) * 180 / pi : 0
deltaPhase = nz(phase[1]) - phase
deltaPhase := deltaPhase < 1 ? 1 : deltaPhase

alpha = fastLimit / deltaPhase
alpha := alpha < slowLimit ? slowLimit : alpha

mama = 0.0
mama := alpha * src + (1 - alpha) * nz(mama[1])

fama = 0.0
fama := 0.5 * alpha * mama + (1 - 0.5 * alpha) * nz(fama[1])

//=== MAMA & FAMA Code bock ===/

// === HIGHER TIMEFRAME MAPPING ===
getHTF(tf) =>
    _htf = switch tf
        '3' => '15'
        '5' => '15'
        '15' => '60'
        '60' => '1D'
        '1D' => '1W'
        '1W' => '1M'
        => '60' // Default fallback
    _trend_tf = switch tf 
        '3' => '60'
        '5' => '60'
        '15' => '1D'
        '60' => '1W'
        '1D' => '1M'
        => '1W' // Default fallback
    [_htf, _trend_tf]

entryTF = timeframe.period
[htf, trend_tf] = getHTF(entryTF)

// === CALCULATIONS ===
// EMA and ATR Bands
emaLow = ta.ema(ema_src, emaLen)
if mov_avg == 'SMA' 
    emaLow:= ta.sma(ema_src, emaLen)
else if mov_avg == 'FAMA-MAMA'
    if mama_avg == 'FAMA'
        emaLow:= fama
    else
        emaLow := mama
color mamaColor = na

if mov_avg == 'FAMA-MAMA'
    sig = mama > fama ? 1 : mama < fama ? -1 : 0
    mamaColor := sig > 0 ? color.green : sig < 0 ? color.red : color.black

barcolor(bar ? mamaColor : na)

atr = ta.atr(atrLen)
upperBand = emaLow + atr[1] * atrMult
lowerBand = emaLow - atr[1] * atrMult

// OBV
obv = ta.obv
obv_change = obv - obv[1]
obv_ok_buy = not na(obv)? obv_change >= 0 : true// No significant drop
obv_ok_sell = not na(obv)? obv_change < 0 : true

// RSI on Higher Timeframe
var float  htf_rsi = na
htf_rsi := request.security(syminfo.tickerid, htf, ta.rsi(close, rsiLen), barmerge.gaps_on, barmerge.lookahead_off)
current_rsi = ta.ema(ta.rsi(close, rsiLen), 3)
rsi_trend_ok = current_rsi >= htf_rsi or (htf_rsi > 60 and current_rsi > 60)
// === SIGNAL LOGIC ===
isGreen = close > open
isRed = close < open
// bg_color = htf_rsi <= rsi_lower? color.new(color.green, 90) : htf_rsi > rsi_upper ? color.new(color.red, 90) : na
// bg_color := na(bg_color) ? bg_color[1] : bg_color

var float buySL = na
var float sellSL = na
var float buy_midRange = na
var float sell_midRange = na
var bool buySignal = false
var bool sellSignal = false


// Buy conditions
sellSL_cross = false //(close >  sellSL and open < sellSL) or (close[1]< sellSL and close>sellSL)
buyCross = (isGreen and ((close > upperBand and open < upperBand)) or (close[1]< upperBand and close>upperBand)) or sellSL_cross
buySignal := buyCross and obv_ok_buy //and rsi_trend_ok

// Filter if recent buy singal 
look_back_signal_buy =  false
for i=1 to signal_lookback
    look_back_signal_buy := look_back_signal_buy or buySignal[i]
if look_back_signal_buy
    buySignal := false


// Sell conditions
buySL_cross = false //(close < buySL and  open > buySL) or (close[1] > buySL and close < buySL)
sellCross = (isRed and ((close < lowerBand and open > lowerBand))  or (close[1] > lowerBand and close<lowerBand)) or buySL_cross
sellSignal := sellCross and obv_ok_sell // and not rsi_trend_ok

//Filter if recent sell signal
look_back_signal_sell =  false
for i=1 to signal_lookback
    look_back_signal_sell := look_back_signal_sell or sellSignal[i]
if look_back_signal_sell
    sellSignal := false

// === STOPLOSS LOGIC ===
buyStopVal = ta.lowest(low, pivotLook) - atr * atrMult
sellStopVal = ta.highest(high, pivotLook) + atr * atrMult


buySL := buySignal ? buyStopVal : nz(buySL[1])
sellSL := sellSignal ? sellStopVal : nz(sellSL[1])

// === PLOTTING ===
// plot(emaLow, 'EMA of Low', color = color.blue, linewidth = 1)
plot(upperBand, 'Upper Band', color = color.green, linewidth = 1, style = plot.style_circles)
plot(lowerBand, 'Lower Band', color = color.red, linewidth = 1, style = plot.style_circles)

plotshape(buySignal, title = 'Buy Signal', location = location.belowbar, color = color.new(color.green, 50), style = shape.triangleup, size = size.small)
plotshape(sellSignal, title = 'Sell Signal', location = location.abovebar, color = color.new(color.red, 50), style = shape.triangledown, size = size.small)

plot(buySL, 'Buy Stoploss', color = color.new(color.green, 20), linewidth = 1, style = plot.style_linebr)
plot(sellSL, 'Sell Stoploss', color = color.new(color.red, 20), linewidth = 1, style = plot.style_linebr)

// bgcolor(bg_color, title = "HTF RSI background Color")

// ===== PLOT TREND TIMEFRAME EMAs
get_trend_ema() =>
    _ema_fast = ta.ema(close, fast_ema)
    _ema_slow = ta.ema(close, slow_ema)
    _ema_color = _ema_fast > _ema_slow ? color.green : color.red
    [_ema_fast, _ema_slow, _ema_color]

[ema_fast, ema_slow, ema_color] = request.security(syminfo.tickerid, trend_tf, get_trend_ema(), barmerge.gaps_on, barmerge.lookahead_off)

plot(ema_fast, title = 'Trend EMA Fast', linewidth = 2, color = ema_color)
plot(ema_slow, title = 'Trend EMA Slow', linewidth = 3, color = ema_color)

var float buffer = na

// Alerts
if buySignal
    buffer := atr*atrMult_signal
    buy_midRange := (high+low)/2
    line.new(x1=bar_index, y1=high+buffer, x2=bar_index + pivotLook, y2=high+buffer, color=color.green, width=2, style=line.style_dotted)
    line.new(x1=bar_index, y1=buy_midRange, x2=bar_index + pivotLook, y2=buy_midRange, color=color.green, width=2, style=line.style_dashed)
    line.new(x1=bar_index, y1=low-buffer, x2=bar_index + pivotLook, y2=low-buffer, color=color.green, width=2, style=line.style_dotted)
    alert("Price crossed above ATR Band! Current price: " + str.tostring(close), freq = alert.freq_once_per_bar_close)

if sellSignal
    buffer := atr*atrMult_signal
    sell_midRange:= (high+low)/2
    line.new(x1=bar_index, y1=high+buffer, x2=bar_index + pivotLook, y2=high+buffer, color=color.red, width=2, style=line.style_dotted)
    line.new(x1=bar_index, y1=sell_midRange, x2=bar_index + pivotLook, y2=sell_midRange, color=color.red, width=2, style=line.style_dashed)
    line.new(x1=bar_index, y1=low-buffer, x2=bar_index + pivotLook, y2=low-buffer, color=color.red, width=2, style=line.style_dotted)
    alert("Price crossed below ATR Band! Current price: " + str.tostring(close), freq = alert.freq_once_per_bar_close)

plot(buy_midRange, 'Buy Mid_range', color = bar_index % 2 == 0 ? na : color.new(color.green, 50), linewidth = 2)
plot(sell_midRange, 'Sell Mid-Range', color = bar_index % 2 == 0 ? na : color.new(color.red, 50), linewidth = 2)

vol_mul = input.float(1.7, title = "Volume ema buffer", minval = 0, step=0.1, group = "Volume Indication")
vol_ema = input.int(10, title = "Volume ema length", minval=3, step=1, group = "Volume Indication")
ema_vol = ta.ema(volume, vol_ema)
atr_vol = ta.stdev(volume,vol_ema) * vol_mul
barcolor(volume>ema_vol+atr_vol ? color.black : na)

//****************************************************************
//SLow stochastic
//****************************************************************
show_stoch = input(false, 'Show Slow Stochastics', group = "Stochastic")
smoothK = input.int(100 , title="%K Period", minval=1, group = "Stochastic")
smoothKDelay = input.int(3 , title="%K Smoothing", minval=1, group = "Stochastic")
smoothD = input.int(3 , title="%D Period", minval=1, group = "Stochastic")
k = ta.sma(ta.stoch(close, high, low, smoothK), smoothKDelay)
d = ta.sma(k, smoothD)

//definitions for Cross
upLine = 55
lowLine = 30
aboveLine = k > upLine ? 1 : 0
belowLine = k < lowLine ? 1 : 0
crossUp = (aboveLine == 1 and aboveLine[1] == 0)  ? true : false
crossDn = (belowLine == 1 and belowLine[1] == 0) ? true : false

var int bg_flag = 0

if crossUp
    bg_flag := 1
else if crossDn
    bg_flag := -1

// -----------------------------
// Background Highlight
// -----------------------------
bgcolor(show_stoch ? bg_flag == 1 ? color.new(color.green, 90) : bg_flag == -1 ? color.new(color.red, 90) : na : na)

showCPR = input.bool(true, title='Show CPR', group='CPR')

//**************************************************************************************************************
// Section 3 - Pivots
//**************************************************************************************************************

//******************LOGICS**************************
//cenral pivot range
pivot = (high + low + close) / 3  //Central Povit
BC = (high + low) / 2  //Below Central povit
TC = pivot - BC + pivot  //Top Central povot

//3  support levels
S1 = pivot * 2 - high
S2 = pivot - (high - low)
S3 = low - 2 * (high - pivot)

//3  resistance levels
R1 = pivot * 2 - low
R2 = pivot + high - low
R3 = high + 2 * (pivot - low)

highLevel = high
lowLevel = low

//Checkbox inputs
CPRPlot = input(title='Plot CPR?', defval=true)
DayS1R1 = input(title='Plot Daiy S1/R1?', defval=true)
DayS2R2 = input(title='Plot Daiy S2/R2?', defval=true)
DayS3R3 = input(title='Plot Daiy S3/R3?', defval=true)
PrevHL = input(title='Plot Previous High/Low?', defval=true)
//******************DAYWISE CPR & PIVOTS**************************
tf = "D"
if timeframe.isdaily
    tf:= "W"
else if timeframe.isweekly
    tf:="W"


// Getting daywise CPR
DayPivot = request.security(syminfo.tickerid, tf, pivot[1], barmerge.gaps_off, barmerge.lookahead_on)
DayBC = request.security(syminfo.tickerid, tf, BC[1], barmerge.gaps_off, barmerge.lookahead_on)
DayTC = request.security(syminfo.tickerid, tf, TC[1], barmerge.gaps_off, barmerge.lookahead_on)

//Adding linebreaks daywse for CPR
CPColour = DayPivot != DayPivot[1] ? na : color.black
BCColour = DayBC != DayBC[1] ? na : color.black
TCColour = DayTC != DayTC[1] ? na : color.black

//Plotting daywise CPR
plot(showCPR? DayPivot : na, title='CP', color=CPColour, style=plot.style_linebr, linewidth=2)
plot(showCPR and CPRPlot ? DayBC : na, title='BC', color=BCColour, style=plot.style_line, linewidth=1)
plot(showCPR and CPRPlot ? DayTC : na, title='TC', color=TCColour, style=plot.style_line, linewidth=1)

// Getting daywise Support levels
DayS1 = request.security(syminfo.tickerid, 'D', S1[1], barmerge.gaps_off, barmerge.lookahead_on)
DayS2 = request.security(syminfo.tickerid, 'D', S2[1], barmerge.gaps_off, barmerge.lookahead_on)
DayS3 = request.security(syminfo.tickerid, 'D', S3[1], barmerge.gaps_off, barmerge.lookahead_on)

//Adding linebreaks for daywise Support levels 
DayS1Color = DayS1 != DayS1[1] ? na : color.green
DayS2Color = DayS2 != DayS2[1] ? na : color.green
DayS3Color = DayS3 != DayS3[1] ? na : color.green

//Plotting daywise Support levels
plot(showCPR and DayS1R1 ? DayS1 : na, title='D-S1', color=DayS1Color, style=plot.style_cross, linewidth=2)
plot(showCPR and DayS2R2 ? DayS2 : na, title='D-S2', color=DayS2Color, style=plot.style_cross, linewidth=2)
plot(showCPR and DayS3R3 ? DayS3 : na, title='D-S3', color=DayS3Color, style=plot.style_cross, linewidth=2)

// Getting daywise Resistance levels
DayR1 = request.security(syminfo.tickerid, 'D', R1[1], barmerge.gaps_off, barmerge.lookahead_on)
DayR2 = request.security(syminfo.tickerid, 'D', R2[1], barmerge.gaps_off, barmerge.lookahead_on)
DayR3 = request.security(syminfo.tickerid, 'D', R3[1], barmerge.gaps_off, barmerge.lookahead_on)

//Adding linebreaks for daywise Support levels
DayR1Color = DayR1 != DayR1[1] ? na : color.red
DayR2Color = DayR2 != DayR2[1] ? na : color.red
DayR3Color = DayR3 != DayR3[1] ? na : color.red

//Plotting daywise Resistance levels
plot(showCPR and DayS1R1 ? DayR1 : na, title='D-R1', color=DayR1Color, style=plot.style_cross, linewidth=2)
plot(showCPR and DayS2R2 ? DayR2 : na, title='D-R2', color=DayR2Color, style=plot.style_cross, linewidth=2)
plot(showCPR and DayS3R3 ? DayR3 : na, title='D-R3', color=DayR3Color, style=plot.style_cross, linewidth=2)

// Getting yesterdays High Low
DayHigh = request.security(syminfo.tickerid, 'D', highLevel[1], barmerge.gaps_off, barmerge.lookahead_on)
DayLow = request.security(syminfo.tickerid, 'D', lowLevel[1], barmerge.gaps_off, barmerge.lookahead_on)

//Plotting yesterdays High Low
plot(PrevHL ? DayHigh : na, title='Prev High', color=color.new(color.orange, 0), style=plot.style_circles, linewidth=2)
plot(PrevHL ? DayLow : na, title='Prev Low', color=color.new(color.orange, 0), style=plot.style_circles, linewidth=2)
