//@version=6
indicator(
     "NIFTY 20 & 80 Levels",
     overlay = true,
     max_lines_count = 200,
     max_labels_count = 200
)

// ─────────────────────────────────────────────
// USER SETTINGS
// ─────────────────────────────────────────────

levelsAboveBelow = input.int(
     10,
     "Levels Above and Below Price",
     minval = 1,
     maxval = 40
)

show20Levels = input.bool(true, "Show 20 Levels")
show80Levels = input.bool(true, "Show 80 Levels")

color20 = input.color(
     color.new(color.green, 0),
     "20 Level Color"
)

color80 = input.color(
     color.new(color.red, 0),
     "80 Level Color"
)

lineWidth = input.int(
     1,
     "Line Width",
     minval = 1,
     maxval = 4
)

showLabels = input.bool(true, "Show Price Labels")

// ─────────────────────────────────────────────
// STORAGE
// ─────────────────────────────────────────────

var line[] levelLines = array.new_line()
var label[] levelLabels = array.new_label()

// ─────────────────────────────────────────────
// DRAW LEVEL FUNCTION
// ─────────────────────────────────────────────

drawLevel(float priceLevel, color levelColor, string levelType) =>
    line newLine = line.new(
         x1 = bar_index - 1,
         y1 = priceLevel,
         x2 = bar_index,
         y2 = priceLevel,
         extend = extend.both,
         color = levelColor,
         width = lineWidth
     )

    array.push(levelLines, newLine)

    if showLabels
        label newLabel = label.new(
             x = bar_index + 1,
             y = priceLevel,
             text = str.tostring(priceLevel, "#") + " (" + levelType + ")",
             style = label.style_label_left,
             color = levelColor,
             textcolor = color.white,
             size = size.tiny
         )

        array.push(levelLabels, newLabel)

// ─────────────────────────────────────────────
// DELETE PREVIOUS OBJECTS
// ─────────────────────────────────────────────

deletePreviousLevels() =>
    if array.size(levelLines) > 0
        for i = 0 to array.size(levelLines) - 1
            line.delete(array.get(levelLines, i))

    array.clear(levelLines)

    if array.size(levelLabels) > 0
        for i = 0 to array.size(levelLabels) - 1
            label.delete(array.get(levelLabels, i))

    array.clear(levelLabels)

// ─────────────────────────────────────────────
// CREATE LEVELS AROUND CURRENT PRICE
// ─────────────────────────────────────────────

if barstate.islast
    deletePreviousLevels()

    // Finds the completed 100-point price block.
    float currentBase = math.floor(close / 100.0) * 100.0

    // Draws levels above and below the current price area.
    for offset = -levelsAboveBelow to levelsAboveBelow
        float hundredBase = currentBase + offset * 100.0

        float level20 = hundredBase + 20.0
        float level80 = hundredBase + 80.0

        if show20Levels
            drawLevel(level20, color20, "20")

        if show80Levels
            drawLevel(level80, color80, "80")