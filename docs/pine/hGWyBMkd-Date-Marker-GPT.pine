//@version=5
// Designer Jimmy Dimos
// corrected by chatGPT-o3
// Intent to make option expiration dates easy to visualize
// paired with linear regression you can see stock trends are likly range during expiration.

indicator("Date Marker GPT", overlay=true)

// Define the number of Friday markers to plot in the past and future
num_fridays_past = 12    // Plot markers for 6 weeks in the past
num_fridays_future = 12 // Plot markers for 12 weeks into the future

// Define the target hour: 3 PM CST, which is 21:00 UTC
target_hour_utc = 21

// -------------------------------------------------------------
// Function: get_previous_friday
// Description: Calculates the timestamp for the most recent Friday at 3 PM CST.
//              If the current day is Friday or Saturday, it returns this week's Friday.
//              Otherwise, it returns the Friday from the previous week.
// Parameters:
//    ts        - The current bar's timestamp.
//    weeks_ago - How many weeks back to go (0 for the immediate past Friday).
// Returns: Timestamp for the desired previous Friday.
// -------------------------------------------------------------
get_previous_friday(ts, weeks_ago) =>
    // TradingView's dayofweek values: Sunday=1, Monday=2, Tuesday=3, Wednesday=4,
    // Thursday=5, Friday=6, Saturday=7.
    // If today is Friday (6) or Saturday (7):
    //    Offset = dayofweek - 6 (i.e. 0 for Friday, 1 for Saturday).
    // Otherwise (Sunday to Thursday):
    //    Offset = dayofweek + 1 (so that, for example, on Thursday (5) offset = 6 days back).
    day_offset = (dayofweek(ts) >= 6 ? dayofweek(ts) - 6 : dayofweek(ts) + 1)
    // Calculate the timestamp for the target Friday by subtracting the offset
    // and any additional full weeks (weeks_ago * 7 days).
    friday_ts = timestamp("GMT+0", year(ts), month(ts), dayofmonth(ts) - day_offset - weeks_ago * 7, target_hour_utc, 0)
    friday_ts

// -------------------------------------------------------------
// Function: get_next_friday
// Description: Calculates the timestamp for the upcoming Friday at 3 PM CST.
//              If today is Friday, it returns the Friday in the next week.
// Parameters:
//    ts          - The current bar's timestamp.
//    weeks_ahead - How many weeks ahead to go (0 for the immediate next Friday).
// Returns: Timestamp for the desired next Friday.
// -------------------------------------------------------------
get_next_friday(ts, weeks_ahead) =>
    // Calculate the number of days to add to reach the upcoming Friday.
    // For Sunday (1) to Thursday (5): offset = 6 - dayofweek(ts)
    // For Friday (6): offset = 7 days ahead (to ensure we get the next Friday)
    // For Saturday (7): offset = (13 - dayofweek(ts)) = 6 days ahead.
    next_offset = dayofweek(ts) < 6 ? 6 - dayofweek(ts) : (dayofweek(ts) == 6 ? 7 : (13 - dayofweek(ts)))
    // Calculate the timestamp for the target Friday by adding the offset
    // and additional days for the number of weeks ahead.
    friday_ts = timestamp("GMT+0", year(ts), month(ts), dayofmonth(ts) + next_offset + weeks_ahead * 7, target_hour_utc, 0)
    friday_ts

// -------------------------------------------------------------
// Plotting Vertical Lines for Past Fridays
// Description: Loop through the past 6 weeks, calculate the corresponding Friday
//              at 3 PM CST, and draw a vertical blue line on the chart.
// -------------------------------------------------------------
for i = 0 to num_fridays_past - 1
    // Calculate the timestamp for the i-th past Friday.
    past_friday = get_previous_friday(time, i)
    // Draw a vertical line at the calculated timestamp that extends from the bar's low to high.
    line.new(x1=past_friday, y1=low, x2=past_friday, y2=high, extend=extend.both, color=color.blue, width=2, xloc=xloc.bar_time)

// -------------------------------------------------------------
// Plotting Vertical Lines for Future Fridays
// Description: Loop through the next 12 weeks, calculate the corresponding Friday
//              at 3 PM CST, and draw a vertical blue line on the chart.
// -------------------------------------------------------------
for i = 0 to num_fridays_future - 1
    // Calculate the timestamp for the i-th future Friday.
    future_friday = get_next_friday(time, i)
    // Draw a vertical line at the calculated timestamp that extends from the bar's low to high.
    line.new(x1=future_friday, y1=low, x2=future_friday, y2=high, extend=extend.both, color=color.blue, width=2, xloc=xloc.bar_time)