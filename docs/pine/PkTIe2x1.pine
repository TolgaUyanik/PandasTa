library("SMC_Structure", overlay=true)

// @function スイングハイを取得する
// @param length 左右の確認バー数
// @returns [float, int] スイングハイの価格と発生したバーインデックス
export get_swing_high(int length) =>
    float sh = ta.pivothigh(high, length, length)
    int sh_idx = na(sh) ? na : bar_index[length]
    [sh, sh_idx]

// @function スイングローを取得する
// @param length 左右の確認バー数
// @returns [float, int] スイングローの価格と発生したバーインデックス
export get_swing_low(int length) =>
    float sl = ta.pivotlow(low, length, length)
    int sl_idx = na(sl) ? na : bar_index[length]
    [sl, sl_idx]

// @function BOS (Break of Structure) または CHoCH (Change of Character) の判定
// @param src_price 現在の価格（終値など）
// @param level 突破を監視するスイングレベル
// @param is_bull 強気目線かどうか
// @returns bool 構造破壊の有無
export detect_break(float src_price, float level, bool is_bull) =>
    bool is_break = false
    if not na(level)
        if is_bull
            is_break := src_price > level
        else
            is_break := src_price < level
    is_break