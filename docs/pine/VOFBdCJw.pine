//@version=6
library("demark_utils")

// --- Generic scoring/formatting helpers ---

export f_grade(float score) =>
    score >= 80 ? "A" : score >= 60 ? "B" : "C"

export f_clampScore(float score) => math.max(0.0, math.min(100.0, score))

export f_px(float v) => str.tostring(v, format.mintick)

export f_pxOrDash(float v) => na(v) ? "-" : f_px(v)

// Sum `src` over `length` bars using an explicit loop.
export f_sum(series float src, int length) =>
    float s = 0.0
    for i = 0 to length - 1
        s += src[i]
    s

// --- Generic bitmask helpers (event buses, flags) ---

export f_hasAnyBits(int bus, int mask) =>
    int a = bus
    int b = mask
    bool res = false
    while not res and a != 0 and b != 0
        if (a % 2 != 0) and (b % 2 != 0)
            res := true
        a := int(a / 2)
        b := int(b / 2)
    res

export f_busSetMask(int bus, int mask) =>
    int b = bus
    int m = mask
    int p = 1
    int res = bus
    while m != 0
        if (m % 2 != 0) and (b % 2 == 0)
            res += p
        m := int(m / 2)
        b := int(b / 2)
        p *= 2
    res

export f_evSet(int bus, int flag) =>
    f_busSetMask(bus, flag)

export f_evSet2(int bus, int flag) =>
    f_busSetMask(bus, flag)
