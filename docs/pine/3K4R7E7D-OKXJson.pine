//@version=5
// OKXJson.lib v1.0
library("OKXJson")

//──────────────────────────────────────────────────────────────
// OKX Signal Bot Alert Message 2.0 - JSON Builder
//──────────────────────────────────────────────────────────────

// Format UTC timestamp in ISO-8601
export f_utcTimestamp() =>
    str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

// Build a reasonably-unique id
export f_buildId(string prefix , string instrument ) =>
    prefix + "_" + instrument + "_" + str.tostring(time) + "_" + str.tostring(bar_index)

// Map internal action → OKX action
export f_okxAction(string internalAction ) =>
    internalAction == "OPEN_LONG" or internalAction == "OPEN_SHORT" ? "open" :    internalAction == "CLOSE" ? "close" : ""

// Map internal action → marketPosition
export f_marketPosition(string internalAction ) =>
    internalAction == "OPEN_LONG"  ? "long"  :    internalAction == "OPEN_SHORT" ? "short" :    internalAction == "CLOSE"      ? "flat"  : ""

// Decide investmentType
export f_investmentType(string     internalAction ,string    entryType ,string    closeType ) =>
    internalAction == "CLOSE" ? closeType : entryType

