// Build final OKX JSON
export f_build(string id, string okxAction, string marketPosition, string prevMarketPosition, string instrument, string signalToken, string timestampUtc, string investmentType, string amount, string maxLagSeconds) =>
    prevPart = prevMarketPosition == "" ? "" : ',"prevMarketPosition":"' + prevMarketPosition + '"'
    lagPart  = maxLagSeconds == "" ? "" : ',"maxLag":"' + maxLagSeconds + '"'

    str.format(       '{{"id":"{0}","action":"{1}","marketPosition":"{2}"{3},"instrument":"{4}","signalToken":"{5}","timestamp":"{6}"{7},"investmentType":"{8}","amount":"{9}"}}',        id,        okxAction,        marketPosition,        prevPart,        instrument,        signalToken,        timestampUtc,        lagPart,        investmentType,        amount    )