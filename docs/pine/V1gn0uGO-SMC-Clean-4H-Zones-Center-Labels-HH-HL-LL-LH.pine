//@version=6
strategy("SMC Clean 4H Zones Center Labels HH HL LL LH", overlay=true, max_boxes_count=100, max_labels_count=300, max_lines_count=200, process_orders_on_close=true)

pivotLen = input.int(5, "Structure Strength", minval=2)
htf = input.timeframe("240", "Supply Demand Timeframe")
atrLen = input.int(14, "ATR Length")
minFvgAtr = input.float(0.35, "Minimum FVG Size ATR")
obLookback = input.int(25, "OB Lookback")
slAtr = input.float(1.5, "SL ATR")
tpAtr = input.float(3.0, "TP ATR")

showFVG = input.bool(true, "Show FVG / IFVG")
showOB = input.bool(true, "Show OB / Breaker")
showBOS = input.bool(true, "Show BOS / CHOCH")
showZones = input.bool(true, "Show 4H Supply Demand")
showStructure = input.bool(true, "Show HH HL LL LH")

atrValue = ta.atr(atrLen)

fvgBullColor = color.new(color.green, 90)
fvgBearColor = color.new(color.red, 90)
ifvgBullColor = color.new(color.lime, 88)
ifvgBearColor = color.new(color.orange, 88)
obBullColor = color.new(color.blue, 90)
obBearColor = color.new(color.purple, 90)
demandColor = color.new(color.green, 86)
supplyColor = color.new(color.red, 86)
neutralLineColor = color.new(color.gray, 10)
neutralLabelColor = color.new(color.gray, 75)
structureLabelColor = color.new(color.gray, 80)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float lastLow = na
var int lastHighBar = na
var int lastLowBar = na
var int trend = 0

if not na(ph)
    highType = na(lastHigh) ? "HH" : ph > lastHigh ? "HH" : "LH"
    if showStructure
        label.new(bar_index - pivotLen, ph, highType, style=label.style_label_down, color=structureLabelColor, textcolor=color.white, size=size.tiny)
    lastHigh := ph
    lastHighBar := bar_index - pivotLen

if not na(pl)
    lowType = na(lastLow) ? "LL" : pl > lastLow ? "HL" : "LL"
    if showStructure
        label.new(bar_index - pivotLen, pl, lowType, style=label.style_label_up, color=structureLabelColor, textcolor=color.white, size=size.tiny)
    lastLow := pl
    lastLowBar := bar_index - pivotLen

bullBreak = not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
bearBreak = not na(lastLow) and close < lastLow and close[1] >= lastLow

bullCHOCH = bullBreak and trend == -1
bearCHOCH = bearBreak and trend == 1
bullBOS = bullBreak and trend != -1
bearBOS = bearBreak and trend != 1

if bullBreak
    if showBOS
        midBar = int(math.round((lastHighBar + bar_index) / 2.0))
        line.new(lastHighBar, lastHigh, bar_index, lastHigh, color=neutralLineColor, width=1, style=line.style_solid)
        label.new(midBar, lastHigh, bullCHOCH ? "CHOCH" : "BOS", style=label.style_label_center, color=neutralLabelColor, textcolor=color.white, size=size.tiny)
    trend := 1

if bearBreak
    if showBOS
        midBar = int(math.round((lastLowBar + bar_index) / 2.0))
        line.new(lastLowBar, lastLow, bar_index, lastLow, color=neutralLineColor, width=1, style=line.style_solid)
        label.new(midBar, lastLow, bearCHOCH ? "CHOCH" : "BOS", style=label.style_label_center, color=neutralLabelColor, textcolor=color.white, size=size.tiny)
    trend := -1

[ph4, pl4, h4, l4, o4, c4] = request.security(syminfo.tickerid, htf, [ta.pivothigh(high, pivotLen, pivotLen), ta.pivotlow(low, pivotLen, pivotLen), high[pivotLen], low[pivotLen], open[pivotLen], close[pivotLen]], lookahead=barmerge.lookahead_off)

newHTF = timeframe.change(htf)

var box demandBox = na
var box supplyBox = na
var label demandLabel = na
var label supplyLabel = na

if showZones and newHTF and not na(pl4)
    box.delete(demandBox)
    label.delete(demandLabel)

    demandTop = math.max(o4, c4)
    demandBot = l4
    demandMid = (demandTop + demandBot) / 2

    demandBox := box.new(bar_index, demandTop, bar_index + 1, demandBot, extend=extend.right, bgcolor=demandColor, border_color=color.new(color.green, 35))
    demandLabel := label.new(bar_index, demandMid, "4H DEMAND", style=label.style_label_center, color=color.new(color.green, 40), textcolor=color.white, size=size.small)

if showZones and newHTF and not na(ph4)
    box.delete(supplyBox)
    label.delete(supplyLabel)

    supplyTop = h4
    supplyBot = math.min(o4, c4)
    supplyMid = (supplyTop + supplyBot) / 2

    supplyBox := box.new(bar_index, supplyTop, bar_index + 1, supplyBot, extend=extend.right, bgcolor=supplyColor, border_color=color.new(color.red, 35))
    supplyLabel := label.new(bar_index, supplyMid, "4H SUPPLY", style=label.style_label_center, color=color.new(color.red, 40), textcolor=color.white, size=size.small)

bullFVG = showFVG and low > high[2] and (low - high[2]) >= atrValue * minFvgAtr
bearFVG = showFVG and high < low[2] and (low[2] - high) >= atrValue * minFvgAtr

var box bullFvgBox = na
var box bearFvgBox = na
var line bullFvgMidLine = na
var line bearFvgMidLine = na

var float bullFvgTop = na
var float bullFvgBot = na
var float bullFvgMid = na
var float bearFvgTop = na
var float bearFvgBot = na
var float bearFvgMid = na

var bool bullFvgActive = false
var bool bearFvgActive = false

if bullFVG
    box.delete(bullFvgBox)
    line.delete(bullFvgMidLine)
    bullFvgTop := low
    bullFvgBot := high[2]
    bullFvgMid := (bullFvgTop + bullFvgBot) / 2
    bullFvgActive := true
    bullFvgBox := box.new(bar_index - 2, bullFvgTop, bar_index + 1, bullFvgBot, extend=extend.right, bgcolor=fvgBullColor, border_color=color.new(color.green, 65))
    bullFvgMidLine := line.new(bar_index - 2, bullFvgMid, bar_index + 1, bullFvgMid, extend=extend.right, color=color.new(color.gray, 45), width=1)

if bearFVG
    box.delete(bearFvgBox)
    line.delete(bearFvgMidLine)
    bearFvgTop := low[2]
    bearFvgBot := high
    bearFvgMid := (bearFvgTop + bearFvgBot) / 2
    bearFvgActive := true
    bearFvgBox := box.new(bar_index - 2, bearFvgTop, bar_index + 1, bearFvgBot, extend=extend.right, bgcolor=fvgBearColor, border_color=color.new(color.red, 65))
    bearFvgMidLine := line.new(bar_index - 2, bearFvgMid, bar_index + 1, bearFvgMid, extend=extend.right, color=color.new(color.gray, 45), width=1)

bullIFVG = bullFvgActive and close < bullFvgBot
bearIFVG = bearFvgActive and close > bearFvgTop

if bullIFVG
    bullFvgActive := false
    box.set_bgcolor(bullFvgBox, ifvgBearColor)
    box.set_border_color(bullFvgBox, color.new(color.gray, 50))

if bearIFVG
    bearFvgActive := false
    box.set_bgcolor(bearFvgBox, ifvgBullColor)
    box.set_border_color(bearFvgBox, color.new(color.gray, 50))

var box bullObBox = na
var box bearObBox = na
var line bullObMidLine = na
var line bearObMidLine = na
var label bullObLabel = na
var label bearObLabel = na

var float bullObTop = na
var float bullObBot = na
var float bullObMid = na
var float bearObTop = na
var float bearObBot = na
var float bearObMid = na

var bool bullObActive = false
var bool bearObActive = false

bullObIndex = 0
bearObIndex = 0

if showOB and bullBreak
    for i = 1 to obLookback
        if close[i] < open[i]
            bullObIndex := i
            break

if showOB and bearBreak
    for i = 1 to obLookback
        if close[i] > open[i]
            bearObIndex := i
            break

if showOB and bullObIndex > 0
    box.delete(bullObBox)
    line.delete(bullObMidLine)
    label.delete(bullObLabel)

    bullObTop := high[bullObIndex]
    bullObBot := low[bullObIndex]
    bullObMid := (bullObTop + bullObBot) / 2
    bullObActive := true

    bullObBox := box.new(bar_index - bullObIndex, bullObTop, bar_index + 1, bullObBot, extend=extend.right, bgcolor=obBullColor, border_color=color.new(color.gray, 55))
    bullObMidLine := line.new(bar_index - bullObIndex, bullObMid, bar_index + 1, bullObMid, extend=extend.right, color=color.new(color.gray, 35), width=1)
    bullObLabel := label.new(bar_index - bullObIndex, bullObMid, "OB", style=label.style_label_center, color=color.new(color.gray, 70), textcolor=color.white, size=size.tiny)

if showOB and bearObIndex > 0
    box.delete(bearObBox)
    line.delete(bearObMidLine)
    label.delete(bearObLabel)

    bearObTop := high[bearObIndex]
    bearObBot := low[bearObIndex]
    bearObMid := (bearObTop + bearObBot) / 2
    bearObActive := true

    bearObBox := box.new(bar_index - bearObIndex, bearObTop, bar_index + 1, bearObBot, extend=extend.right, bgcolor=obBearColor, border_color=color.new(color.gray, 55))
    bearObMidLine := line.new(bar_index - bearObIndex, bearObMid, bar_index + 1, bearObMid, extend=extend.right, color=color.new(color.gray, 35), width=1)
    bearObLabel := label.new(bar_index - bearObIndex, bearObMid, "OB", style=label.style_label_center, color=color.new(color.gray, 70), textcolor=color.white, size=size.tiny)

bullBreaker = bullObActive and close < bullObBot
bearBreaker = bearObActive and close > bearObTop

if showOB and bullBreaker
    bullObActive := false
    box.set_bgcolor(bullObBox, color.new(color.gray, 88))
    box.set_border_color(bullObBox, color.new(color.gray, 50))
    label.set_text(bullObLabel, "BREAKER")

if showOB and bearBreaker
    bearObActive := false
    box.set_bgcolor(bearObBox, color.new(color.gray, 88))
    box.set_border_color(bearObBox, color.new(color.gray, 50))
    label.set_text(bearObLabel, "BREAKER")

longFromFVG = bullFvgActive and low <= bullFvgMid and close > bullFvgMid
longFromOB = bullObActive and low <= bullObTop and close > bullObBot
longFromDemand = showZones and not na(demandBox) and low <= box.get_top(demandBox) and close > box.get_bottom(demandBox)
longFromCHOCH = bullCHOCH or bearIFVG

shortFromFVG = bearFvgActive and high >= bearFvgMid and close < bearFvgMid
shortFromOB = bearObActive and high >= bearObBot and close < bearObTop
shortFromSupply = showZones and not na(supplyBox) and high >= box.get_bottom(supplyBox) and close < box.get_top(supplyBox)
shortFromCHOCH = bearCHOCH or bullIFVG

buySignal = barstate.isconfirmed and (longFromFVG or longFromOB or longFromDemand or longFromCHOCH)
sellSignal = barstate.isconfirmed and (shortFromFVG or shortFromOB or shortFromSupply or shortFromCHOCH)

longSL = close - atrValue * slAtr
longTP = close + atrValue * tpAtr
shortSL = close + atrValue * slAtr
shortTP = close - atrValue * tpAtr

if buySignal
    strategy.close("SELL")
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY EXIT", "BUY", stop=longSL, limit=longTP)

if sellSignal
    strategy.close("BUY")
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL EXIT", "SELL", stop=shortSL, limit=shortTP)

plot(strategy.position_size > 0 ? longSL : na, "BUY SL", color=color.new(color.red, 20), linewidth=2, style=plot.style_linebr)
plot(strategy.position_size > 0 ? longTP : na, "BUY TP", color=color.new(color.lime, 20), linewidth=2, style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortSL : na, "SELL SL", color=color.new(color.red, 20), linewidth=2, style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortTP : na, "SELL TP", color=color.new(color.lime, 20), linewidth=2, style=plot.style_linebr)

alertcondition(buySignal, title="BUY SMC", message="BUY SMC setup")
alertcondition(sellSignal, title="SELL SMC", message="SELL SMC setup")
alertcondition(bullBOS or bullCHOCH, title="Bull BOS CHOCH", message="Bullish BOS or CHOCH")
alertcondition(bearBOS or bearCHOCH, title="Bear BOS CHOCH", message="Bearish BOS or CHOCH")