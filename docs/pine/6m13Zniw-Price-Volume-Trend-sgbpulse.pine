//@version=6
indicator(title = "Price Volume Trend [sgbpulse]", 
          shorttitle = "PVT [sgbpulse]", 
          format = format.volume, 
          overlay = false)

// --- Inputs ---
MA_GRP = "SMOOTHING MA"
BB_GRP = "BOLLINGER BANDS"

// Moving Average Settings
string maType = input.string(defval = "SMA", title = "Moving Average Type", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA"], group = MA_GRP)
int pvtMaLength = input.int(defval = 20, title = "Moving Average Length", minval = 1, group = MA_GRP)
// Bollinger Bands Settings for PVT
float pvtBollingerStdDev = input.float(defval = 2.0, title = "PVT BB StdDev", minval = 0.1, group = BB_GRP)

bool showMa = maType != "None"
bool showPvtBollinger = maType == "SMA + Bollinger Bands"


// --- Functions ---
// Custom function to calculate different types of Moving Averages
ma(float source, int length, maType) =>
    switch maType
        "SMA"                   => ta.sma(source, length)
        "SMA + Bollinger Bands" => ta.sma(source, length)
        "EMA"                   => ta.ema(source, length)
        "SMMA (RMA)"            => ta.rma(source, length)
        "WMA"                   => ta.wma(source, length)
        => ta.sma(source, length) // Fallback


// --- Calculations ---
// Calculate Price Volume Trend (PVT)
float prevClose = nz(source = close[1], replacement = 1.0)
float pvtContribution = bar_index == 0 ? 0.0 : ( (close - prevClose) / prevClose ) * volume
float pvt = ta.cum(source = pvtContribution)
// Calculate MA for PVT
float pvtSma = showMa ? ma(source = pvt, length = pvtMaLength, maType = maType) : na
// Calculate Bollinger Bands for PVT. Note: Standard deviation (ta.stdev) is typically calculated around a Simple Moving Average of the specified length.
float pvtStdDev = showPvtBollinger ? ta.stdev(source = pvt, length = pvtMaLength) : na
float pvtUpperBand = showPvtBollinger ? pvtSma + ( pvtStdDev * pvtBollingerStdDev ) : na
float pvtLowerBand = showPvtBollinger ? pvtSma - ( pvtStdDev * pvtBollingerStdDev ) : na


// --- Plots / Display ---
// Plot PVT main line and Zero Line
plot(series = pvt, title = "PVT", color = #2962ff)

// Plots a dynamic horizontal line indicating the current PVT level, extending across the chart and colored by its recent trend.
var line currentPvtLine = na // Declare a variable to hold the line object
if barstate.islast
    // Delete the previous line object if it exists to avoid drawing multiple lines
    if not na(currentPvtLine)
        line.delete(currentPvtLine)
    // Creates a new line from the current bar's index, at the current PVT value, extending to both sides.
    currentPvtLine := line.new(x1 = bar_index, y1 = pvt, x2 = bar_index + 1, y2 = pvt, extend = extend.both, color = pvt >= pvt[1] ? color.green : color.red , style = line.style_dotted)


// Plot PVT Bollinger Bands and fill
plotPvtSma = plot(series = pvtSma, title = "PVT MA", color = #9c27b080, display = showMa ? display.all : display.none, editable = showMa)
plotPvtUpperBand = plot(series = pvtUpperBand, title = "PVT BB Upper", color = #f77c80b0, display = showPvtBollinger ? display.all : display.none, editable = showPvtBollinger)
plotPvtLowerBand = plot(series = pvtLowerBand, title = "PVT BB Lower", color = #81c784b0, display = showPvtBollinger ? display.all : display.none, editable = showPvtBollinger)
fill(plot1 = plotPvtUpperBand, plot2 = plotPvtLowerBand, color = #26c6da15, title = "BB Fill", display = showPvtBollinger ? display.all : display.none, editable = showPvtBollinger)
