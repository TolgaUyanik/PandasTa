//@version=6
indicator('Before Previous Candle High/Low (Line Starting on Candle)', overlay = true)

// Inputs
extendLength = input.int(5, title = 'Line Length After Candle (Bars)', minval = 1)
highLineColor = input.color(color.black, title = 'High Line Color')
lowLineColor = input.color(color.black, title = 'Low Line Color')

// Line variables
var line highLine = na
var line lowLine = na

if bar_index > 2
    if na(highLine)
        // Start at bar_index - 2 (where the candle is), extend right by extendLength
        highLine := line.new(bar_index - 2, high[2], bar_index - 2 + extendLength, high[2], color = highLineColor, width = 2, extend = extend.none)
        lowLine := line.new(bar_index - 2, low[2], bar_index - 2 + extendLength, low[2], color = lowLineColor, width = 2, extend = extend.none)
        lowLine
    else // Update lines every bar with same logic
        line.set_xy1(highLine, bar_index - 2, high[2])
        line.set_xy2(highLine, bar_index - 2 + extendLength, high[2])
        line.set_color(highLine, highLineColor)

        line.set_xy1(lowLine, bar_index - 2, low[2])
        line.set_xy2(lowLine, bar_index - 2 + extendLength, low[2])
        line.set_color(lowLine, lowLineColor)
