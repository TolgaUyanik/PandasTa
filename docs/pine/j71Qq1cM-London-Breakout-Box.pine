//@version=6
indicator("London → NY Box (Auto)", overlay=true, max_boxes_count=100)

// ── Inputs ──────────────────────────────────────────────
tz          = "America/New_York"
rangeSess   = input.session("0300-0800", "High/Low tracking window (ET)")
boxSess     = input.session("0300-1200", "Box time span (ET)")
fillCol     = input.color(color.new(color.blue, 88), "Box fill")
borderCol   = input.color(color.new(color.blue, 30), "Box border")

// ── Session detection ───────────────────────────────────
inRange = not na(time(timeframe.period, rangeSess, tz))
inBox   = not na(time(timeframe.period, boxSess, tz))

var box b    = na
var float hi = na
var float lo = na

newDayStart = inRange and not inRange[1]

if newDayStart
    // London open: start a fresh box
    hi := high
    lo := low
    b  := box.new(bar_index, hi, bar_index, lo, border_color=borderCol, bgcolor=fillCol, border_width=1)
else if inRange and not na(b)
    // Between London open and NY open: expand top/bottom with new highs/lows
    hi := math.max(hi, high)
    lo := math.min(lo, low)
    box.set_top(b, hi)
    box.set_bottom(b, lo)
    box.set_right(b, bar_index)
else if inBox and not na(b)
    // After NY open: high/low frozen, just extend the right edge until noon ET
    box.set_right(b, bar_index)