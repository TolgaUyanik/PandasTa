// @version=6
// @description Library for creating color gradients and palettes with hex colors
library("ColorGradient")

// Convert hex string to color
// @function hexToColor
// @param hexStr Hex color string (e.g., "#FF0000" or "FF0000")
// @returns color value
export hexToColor(string hexStr) =>
    hex = str.replace_all(hexStr, "#", "")

    r = str.tonumber("0x" + str.substring(hex, 0, 2))
    g = str.tonumber("0x" + str.substring(hex, 2, 4))
    b = str.tonumber("0x" + str.substring(hex, 4, 6))

    color.rgb(r, g, b)

// Linear interpolation between two values
lerp(float a, float b, float t) =>
    a + (b - a) * t

// Generate gradient between two colors
// @function gradientStep
// @param color1 Starting color (hex string)
// @param color2 Ending color (hex string)
// @param steps Number of steps including start and end
// @param step Current step (0 to steps-1)
// @returns Interpolated color
export gradientStep(string color1, string color2, int steps, int step) =>
    hex1 = str.replace_all(color1, "#", "")
    hex2 = str.replace_all(color2, "#", "")

    r1 = str.tonumber("0x" + str.substring(hex1, 0, 2))
    g1 = str.tonumber("0x" + str.substring(hex1, 2, 4))
    b1 = str.tonumber("0x" + str.substring(hex1, 4, 6))

    r2 = str.tonumber("0x" + str.substring(hex2, 0, 2))
    g2 = str.tonumber("0x" + str.substring(hex2, 2, 4))
    b2 = str.tonumber("0x" + str.substring(hex2, 4, 6))

    t = step / math.max(steps - 1, 1)

    r = math.round(lerp(r1, r2, t))
    g = math.round(lerp(g1, g2, t))
    b = math.round(lerp(b1, b2, t))

    color.rgb(r, g, b)

// Generate gradient through multiple colors
// @function multiGradientStep
// @param colors Array of hex color strings
// @param totalSteps Total number of steps across all colors
// @param step Current step (0 to totalSteps-1)
// @returns Interpolated color
export multiGradientStep(array<string> colors, int totalSteps, int step) =>
    numColors = array.size(colors)
    if numColors < 2
        hexToColor(array.get(colors, 0))
    else
        segmentSize = (totalSteps - 1) / (numColors - 1)
        segment = math.floor(step / segmentSize)

        if segment >= numColors - 1
            hexToColor(array.get(colors, numColors - 1))
        else
            localStep = step - (segment * segmentSize)
            localSteps = math.ceil(segmentSize) + 1

            gradientStep(array.get(colors, segment), array.get(colors, segment + 1), localSteps, math.round(localStep))

// Adjust color brightness for palette styles
// @function applyPaletteStyle
// @param hexStr Hex color string
// @param style "normal", "pale", "pastel", "bright", "matte"
// @returns Adjusted color
export applyPaletteStyle(string hexStr, string style) =>
    hex = str.replace_all(hexStr, "#", "")

    r = str.tonumber("0x" + str.substring(hex, 0, 2))
    g = str.tonumber("0x" + str.substring(hex, 2, 4))
    b = str.tonumber("0x" + str.substring(hex, 4, 6))

    if style == "pale"
        // Mix with white (increase all channels toward 255)
        r := math.round(r + (255 - r) * 0.5)
        g := math.round(g + (255 - g) * 0.5)
        b := math.round(b + (255 - b) * 0.5)
    else if style == "pastel"
        // Mix with white more gently
        r := math.round(r + (255 - r) * 0.35)
        g := math.round(g + (255 - g) * 0.35)
        b := math.round(b + (255 - b) * 0.35)
    else if style == "bright"
        // Increase saturation and brightness
        r := math.min(math.round(r * 1.3), 255)
        g := math.min(math.round(g * 1.3), 255)
        b := math.min(math.round(b * 1.3), 255)
    else if style == "matte"
        // Reduce brightness and saturation
        r := math.round(r * 0.7)
        g := math.round(g * 0.7)
        b := math.round(b * 0.7)

    color.rgb(r, g, b)

// Get color from gradient with palette style applied
// @function getStyledGradient
// @param colors Array of hex color strings
// @param totalSteps Total number of steps
// @param step Current step
// @param style Palette style ("normal", "pale", "pastel", "bright", "matte")
// @returns Styled color
export getStyledGradient(array<string> colors, int totalSteps, int step, string style) =>
    baseColor = multiGradientStep(colors, totalSteps, step)

    if style != "normal"
        r = color.r(baseColor)
        g = color.g(baseColor)
        b = color.b(baseColor)

        if style == "pale"
            r := math.round(r + (255 - r) * 0.5)
            g := math.round(g + (255 - g) * 0.5)
            b := math.round(b + (255 - b) * 0.5)
        else if style == "pastel"
            r := math.round(r + (255 - r) * 0.35)
            g := math.round(g + (255 - g) * 0.35)
            b := math.round(b + (255 - b) * 0.35)
        else if style == "bright"
            r := math.min(math.round(r * 1.3), 255)
            g := math.min(math.round(g * 1.3), 255)
            b := math.min(math.round(b * 1.3), 255)
        else if style == "matte"
            r := math.round(r * 0.7)
            g := math.round(g * 0.7)
            b := math.round(b * 0.7)

        color.rgb(r, g, b)
    else
        baseColor
