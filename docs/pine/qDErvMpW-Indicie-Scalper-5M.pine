//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}

strategy(
     title                        = "Universal Meat Scalper 5M v1.1",
     shorttitle                   = "Universal Meat 5M",
     overlay                      = true,
     pyramiding                   = 0,
     initial_capital              = 10000,
     default_qty_type             = strategy.percent_of_equity,
     default_qty_value            = 1.0,
     commission_type              = strategy.commission.percent,
     commission_value             = 0.0,
     slippage                     = 0,
     process_orders_on_close      = true,
     calc_on_every_tick           = false,
     calc_on_order_fills          = false,
     use_bar_magnifier            = true,
     fill_orders_on_standard_ohlc = true,
     margin_long                  = 100,
     margin_short                 = 100,
     max_labels_count             = 500
)

//=============================================================================
// INPUT GROUPS
//=============================================================================

const string GROUP_BRACKET = "1. Fixed TP and SL"
const string GROUP_TREND   = "2. Trend qualification"
const string GROUP_ENTRY   = "3. Pullback and confirmation"
const string GROUP_ALERTS  = "4. Copygram"
const string GROUP_VISUALS = "5. Chart display"

//=============================================================================
// FIXED BRACKET INPUTS
//=============================================================================

float stopPct = input.float(
     0.20,
     "Stop loss (%)",
     minval = 0.01,
     step = 0.01,
     group = GROUP_BRACKET
)

float targetPct = input.float(
     0.50,
     "Take profit (%)",
     minval = 0.01,
     step = 0.01,
     group = GROUP_BRACKET
)

bool allowLongs = input.bool(
     true,
     "Allow long trades",
     group = GROUP_BRACKET
)

bool allowShorts = input.bool(
     true,
     "Allow short trades",
     group = GROUP_BRACKET
)

//=============================================================================
// TREND INPUTS
//=============================================================================

int fastEmaLength = input.int(
     9,
     "Fast EMA",
     minval = 2,
     group = GROUP_TREND
)

int midEmaLength = input.int(
     21,
     "Middle EMA",
     minval = 3,
     group = GROUP_TREND
)

int slowEmaLength = input.int(
     50,
     "Slow EMA",
     minval = 5,
     group = GROUP_TREND
)

int slopeLookback = input.int(
     3,
     "EMA slope lookback",
     minval = 1,
     maxval = 20,
     group = GROUP_TREND
)

int dmiLength = input.int(
     14,
     "DMI length",
     minval = 2,
     group = GROUP_TREND
)

int adxSmoothing = input.int(
     14,
     "ADX smoothing",
     minval = 2,
     group = GROUP_TREND
)

float minimumAdx = input.float(
     18.0,
     "Minimum ADX",
     minval = 1.0,
     step = 0.5,
     group = GROUP_TREND
)

float maximumAdx = input.float(
     38.0,
     "Maximum ADX",
     minval = 1.0,
     step = 0.5,
     group = GROUP_TREND
)

float minimumEmaSpreadAtr = input.float(
     0.10,
     "Minimum EMA spread in ATR",
     minval = 0.0,
     step = 0.05,
     group = GROUP_TREND,
     tooltip = "Filters compressed or nearly flat EMA structures."
)

float maximumEmaSpreadAtr = input.float(
     1.30,
     "Maximum EMA spread in ATR",
     minval = 0.10,
     step = 0.05,
     group = GROUP_TREND,
     tooltip = "Prevents entries after price becomes excessively extended."
)

//=============================================================================
// ENTRY INPUTS
//=============================================================================

int atrLength = input.int(
     14,
     "ATR length",
     minval = 2,
     group = GROUP_ENTRY
)

int pullbackLookback = input.int(
     3,
     "Pullback lookback bars",
     minval = 1,
     maxval = 10,
     group = GROUP_ENTRY
)

float pullbackToleranceAtr = input.float(
     0.15,
     "EMA-touch tolerance in ATR",
     minval = 0.0,
     step = 0.05,
     group = GROUP_ENTRY
)

float maximumMidEmaPierceAtr = input.float(
     0.20,
     "Maximum middle-EMA pierce in ATR",
     minval = 0.0,
     step = 0.05,
     group = GROUP_ENTRY
)

float minimumBodyRatio = input.float(
     0.45,
     "Minimum confirmation body ratio",
     minval = 0.10,
     maxval = 1.00,
     step = 0.05,
     group = GROUP_ENTRY
)

float minimumCloseLocation = input.float(
     0.68,
     "Minimum strong-close location",
     minval = 0.50,
     maxval = 1.00,
     step = 0.01,
     group = GROUP_ENTRY,
     tooltip = "Long candles close near their high. Shorts use the mirrored value."
)

float minimumEntryRangeAtr = input.float(
     0.25,
     "Minimum entry-candle range in ATR",
     minval = 0.0,
     step = 0.05,
     group = GROUP_ENTRY
)

float maximumEntryRangeAtr = input.float(
     1.35,
     "Maximum entry-candle range in ATR",
     minval = 0.10,
     step = 0.05,
     group = GROUP_ENTRY
)

float maximumExtensionAtr = input.float(
     0.90,
     "Maximum entry extension from middle EMA",
     minval = 0.10,
     step = 0.05,
     group = GROUP_ENTRY
)

//=============================================================================
// COPYGRAM INPUTS
//=============================================================================

string customReceiverSymbol = input.string(
     "",
     "Copygram receiver symbol",
     group = GROUP_ALERTS,
     tooltip = "Leave blank to send the current TradingView ticker. Enter a custom value only when your broker uses a different symbol, such as M.SPX500 or EURUSD.a."
)

string trimmedReceiverSymbol =
     str.trim(customReceiverSymbol)

string receiverSymbol =
     str.length(trimmedReceiverSymbol) > 0
     ? trimmedReceiverSymbol
     : syminfo.ticker

//=============================================================================
// VISUAL INPUTS
//=============================================================================

bool showMovingAverages = input.bool(
     true,
     "Show moving averages",
     group = GROUP_VISUALS
)

bool showTrendBackground = input.bool(
     true,
     "Show qualified-trend background",
     group = GROUP_VISUALS
)

bool showTradeLabels = input.bool(
     true,
     "Show entry labels",
     group = GROUP_VISUALS
)

bool showDashboard = input.bool(
     true,
     "Show dashboard",
     group = GROUP_VISUALS
)

//=============================================================================
// HELPER FUNCTIONS
//=============================================================================

formatPrice(float price) =>
    str.tostring(
         math.round_to_mintick(price),
         format.mintick
    )

buildEntryJson(
     string symbol,
     string orderType,
     float entryPrice,
     float stopPrice,
     float targetPrice,
     string signalId
) =>
    string message =
         "{\"symbol\":\"" + symbol + "\"," +
         "\"order_type\":\"" + orderType + "\"," +
         "\"entry_price\":\"" + formatPrice(entryPrice) + "\"," +
         "\"stop_loss\":\"" + formatPrice(stopPrice) + "\"," +
         "\"signal_id\":\"" + signalId + "\"," +
         "\"take_profit\":[\"" + formatPrice(targetPrice) + "\"]}"

    message

//=============================================================================
// CORE INDICATORS
//=============================================================================

float emaFast = ta.ema(close, fastEmaLength)
float emaMid  = ta.ema(close, midEmaLength)
float emaSlow = ta.ema(close, slowEmaLength)

float atr = ta.atr(atrLength)

[plusDI, minusDI, adx] =
     ta.dmi(dmiLength, adxSmoothing)

float candleRange = high - low
float candleBody  = math.abs(close - open)

float bodyRatio =
     candleRange > 0.0
     ? candleBody / candleRange
     : 0.0

float closeLocation =
     candleRange > 0.0
     ? (close - low) / candleRange
     : 0.5

float candleRangeAtr =
     atr > 0.0
     ? candleRange / atr
     : 0.0

float emaSpreadAtr =
     atr > 0.0
     ? math.abs(emaFast - emaSlow) / atr
     : 0.0

float longExtensionAtr =
     atr > 0.0
     ? (close - emaMid) / atr
     : 999.0

float shortExtensionAtr =
     atr > 0.0
     ? (emaMid - close) / atr
     : 999.0

//=============================================================================
// FIVE-MINUTE VALIDATION
//=============================================================================

bool isFiveMinuteChart =
     timeframe.in_seconds() == 300

int warmupBars =
     math.max(
         slowEmaLength,
         math.max(
             atrLength,
             dmiLength + adxSmoothing
         )
     ) +
     slopeLookback +
     pullbackLookback +
     5

bool indicatorsReady =
     bar_index > warmupBars

//=============================================================================
// MODERATE TREND QUALIFICATION
//=============================================================================

bool adxIsModerate =
     adx >= minimumAdx and
     adx <= maximumAdx

bool emaSpreadIsHealthy =
     emaSpreadAtr >= minimumEmaSpreadAtr and
     emaSpreadAtr <= maximumEmaSpreadAtr

bool bullishTrend =
     emaFast > emaMid and
     emaMid > emaSlow and
     close > emaSlow and
     emaMid > emaMid[slopeLookback] and
     plusDI > minusDI and
     adxIsModerate and
     emaSpreadIsHealthy

bool bearishTrend =
     emaFast < emaMid and
     emaMid < emaSlow and
     close < emaSlow and
     emaMid < emaMid[slopeLookback] and
     minusDI > plusDI and
     adxIsModerate and
     emaSpreadIsHealthy

//=============================================================================
// RECENT PULLBACK DETECTION
//=============================================================================

bool recentBullishPullback = false
bool recentBearishPullback = false

for i = 0 to pullbackLookback
    bool enoughPullbackData =
         not na(emaFast[i]) and
         not na(emaMid[i]) and
         not na(atr[i])

    bool bullishTouch =
         enoughPullbackData and
         low[i] <=
             emaFast[i] +
             atr[i] * pullbackToleranceAtr and
         low[i] >=
             emaMid[i] -
             atr[i] * maximumMidEmaPierceAtr

    bool bearishTouch =
         enoughPullbackData and
         high[i] >=
             emaFast[i] -
             atr[i] * pullbackToleranceAtr and
         high[i] <=
             emaMid[i] +
             atr[i] * maximumMidEmaPierceAtr

    recentBullishPullback :=
         recentBullishPullback or
         bullishTouch

    recentBearishPullback :=
         recentBearishPullback or
         bearishTouch

//=============================================================================
// CONTINUATION CANDLE
//=============================================================================

bool entryCandleRangeIsHealthy =
     candleRangeAtr >= minimumEntryRangeAtr and
     candleRangeAtr <= maximumEntryRangeAtr

bool bullishContinuation =
     close > open and
     close > high[1] and
     close > emaFast and
     bodyRatio >= minimumBodyRatio and
     closeLocation >= minimumCloseLocation and
     entryCandleRangeIsHealthy

bool bearishContinuation =
     close < open and
     close < low[1] and
     close < emaFast and
     bodyRatio >= minimumBodyRatio and
     closeLocation <=
         1.0 - minimumCloseLocation and
     entryCandleRangeIsHealthy

bool bullishEntryNotExtended =
     longExtensionAtr >= 0.0 and
     longExtensionAtr <= maximumExtensionAtr

bool bearishEntryNotExtended =
     shortExtensionAtr >= 0.0 and
     shortExtensionAtr <= maximumExtensionAtr

//=============================================================================
// TRADE STATE
//=============================================================================

var float activeEntryPrice  = na
var float activeStopPrice   = na
var float activeTargetPrice = na
var string activeSignalId   = ""

bool tradeJustClosed =
     strategy.closedtrades >
     nz(strategy.closedtrades[1], 0)

if tradeJustClosed
    activeEntryPrice  := na
    activeStopPrice   := na
    activeTargetPrice := na
    activeSignalId    := ""

bool canOpenNewTrade =
     isFiveMinuteChart and
     indicatorsReady and
     barstate.isconfirmed and
     strategy.position_size == 0 and
     strategy.opentrades == 0 and
     not tradeJustClosed

bool longSignal =
     canOpenNewTrade and
     allowLongs and
     bullishTrend and
     recentBullishPullback and
     bullishContinuation and
     bullishEntryNotExtended

bool shortSignal =
     canOpenNewTrade and
     allowShorts and
     bearishTrend and
     recentBearishPullback and
     bearishContinuation and
     bearishEntryNotExtended

//=============================================================================
// LONG ENTRY
//=============================================================================

if longSignal
    activeEntryPrice :=
         math.round_to_mintick(close)

    activeStopPrice :=
         math.round_to_mintick(
             activeEntryPrice *
             (1.0 - stopPct / 100.0)
         )

    activeTargetPrice :=
         math.round_to_mintick(
             activeEntryPrice *
             (1.0 + targetPct / 100.0)
         )

    activeSignalId :=
         receiverSymbol +
         "-" +
         timeframe.period +
         "-BUY-" +
         str.tostring(time_close)

    string longJson =
         buildEntryJson(
             receiverSymbol,
             "BUY",
             activeEntryPrice,
             activeStopPrice,
             activeTargetPrice,
             activeSignalId
         )

    strategy.entry(
         id = "Long",
         direction = strategy.long,
         alert_message = longJson
    )

    strategy.exit(
         id = "Long TP/SL",
         from_entry = "Long",
         stop = activeStopPrice,
         limit = activeTargetPrice,
         disable_alert = true
    )

    if showTradeLabels
        label.new(
             bar_index,
             low,
             text =
                 "BUY " + receiverSymbol + "\n" +
                 "Entry: " +
                 formatPrice(activeEntryPrice) +
                 "\nSL: " +
                 formatPrice(activeStopPrice) +
                 "\nTP: " +
                 formatPrice(activeTargetPrice),
             yloc = yloc.belowbar,
             style = label.style_label_up,
             color = color.new(color.lime, 0),
             textcolor = color.black,
             size = size.small
        )

//=============================================================================
// SHORT ENTRY
//=============================================================================

else if shortSignal
    activeEntryPrice :=
         math.round_to_mintick(close)

    activeStopPrice :=
         math.round_to_mintick(
             activeEntryPrice *
             (1.0 + stopPct / 100.0)
         )

    activeTargetPrice :=
         math.round_to_mintick(
             activeEntryPrice *
             (1.0 - targetPct / 100.0)
         )

    activeSignalId :=
         receiverSymbol +
         "-" +
         timeframe.period +
         "-SELL-" +
         str.tostring(time_close)

    string shortJson =
         buildEntryJson(
             receiverSymbol,
             "SELL",
             activeEntryPrice,
             activeStopPrice,
             activeTargetPrice,
             activeSignalId
         )

    strategy.entry(
         id = "Short",
         direction = strategy.short,
         alert_message = shortJson
    )

    strategy.exit(
         id = "Short TP/SL",
         from_entry = "Short",
         stop = activeStopPrice,
         limit = activeTargetPrice,
         disable_alert = true
    )

    if showTradeLabels
        label.new(
             bar_index,
             high,
             text =
                 "SELL " + receiverSymbol + "\n" +
                 "Entry: " +
                 formatPrice(activeEntryPrice) +
                 "\nSL: " +
                 formatPrice(activeStopPrice) +
                 "\nTP: " +
                 formatPrice(activeTargetPrice),
             yloc = yloc.abovebar,
             style = label.style_label_down,
             color = color.new(color.red, 0),
             textcolor = color.white,
             size = size.small
        )

//=============================================================================
// KEEP INTERNAL BRACKETS ACTIVE
//=============================================================================

if strategy.position_size > 0 and
   not na(activeStopPrice)

    strategy.exit(
         id = "Long TP/SL",
         from_entry = "Long",
         stop = activeStopPrice,
         limit = activeTargetPrice,
         disable_alert = true
    )

if strategy.position_size < 0 and
   not na(activeStopPrice)

    strategy.exit(
         id = "Short TP/SL",
         from_entry = "Short",
         stop = activeStopPrice,
         limit = activeTargetPrice,
         disable_alert = true
    )

//=============================================================================
// CHART VISUALS
//=============================================================================

plot(
     showMovingAverages ? emaFast : na,
     title = "Fast EMA",
     color = color.aqua,
     linewidth = 1
)

plot(
     showMovingAverages ? emaMid : na,
     title = "Middle EMA",
     color = color.orange,
     linewidth = 2
)

plot(
     showMovingAverages ? emaSlow : na,
     title = "Slow EMA",
     color = color.gray,
     linewidth = 2
)

color trendBackground =
     bullishTrend
     ? color.new(color.green, 92)
     : bearishTrend
     ? color.new(color.red, 92)
     : na

bgcolor(
     showTrendBackground
     ? trendBackground
     : na,
     title = "Qualified trend"
)

entryPlot = plot(
     activeEntryPrice,
     title = "Active entry",
     color = color.blue,
     linewidth = 2,
     style = plot.style_linebr
)

targetPlot = plot(
     activeTargetPrice,
     title = "Active target",
     color = color.lime,
     linewidth = 2,
     style = plot.style_linebr
)

stopPlot = plot(
     activeStopPrice,
     title = "Active stop",
     color = color.red,
     linewidth = 2,
     style = plot.style_linebr
)

fill(
     entryPlot,
     targetPlot,
     color = color.new(color.green, 90),
     title = "Profit zone"
)

fill(
     entryPlot,
     stopPlot,
     color = color.new(color.red, 90),
     title = "Risk zone"
)

//=============================================================================
// DASHBOARD
//=============================================================================

var table dashboard = table.new(
     position.top_right,
     2,
     11,
     border_width = 1
)

int decidedTrades =
     strategy.wintrades +
     strategy.losstrades

float winRate =
     decidedTrades > 0
     ? strategy.wintrades *
         100.0 / decidedTrades
     : 0.0

float rewardRisk =
     stopPct > 0.0
     ? targetPct / stopPct
     : 0.0

float estimatedNetR =
     strategy.wintrades *
         rewardRisk -
     strategy.losstrades

string trendText =
     bullishTrend
     ? "BULLISH"
     : bearishTrend
     ? "BEARISH"
     : "NEUTRAL"

color trendTextColor =
     bullishTrend
     ? color.lime
     : bearishTrend
     ? color.red
     : color.silver

string positionText =
     strategy.position_size > 0
     ? "LONG"
     : strategy.position_size < 0
     ? "SHORT"
     : "FLAT"

color positionTextColor =
     strategy.position_size > 0
     ? color.lime
     : strategy.position_size < 0
     ? color.red
     : color.silver

if barstate.islast and showDashboard
    table.cell(
         dashboard,
         0,
         0,
         "UNIVERSAL MEAT",
         bgcolor = color.black,
         text_color = color.white
    )

    table.cell(
         dashboard,
         1,
         0,
         "5M V1.1",
         bgcolor = color.black,
         text_color = color.white
    )

    table.cell(
         dashboard,
         0,
         1,
         "Chart symbol",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         1,
         syminfo.ticker,
         text_color = color.white
    )

    table.cell(
         dashboard,
         0,
         2,
         "Receiver",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         2,
         receiverSymbol,
         text_color = color.white
    )

    table.cell(
         dashboard,
         0,
         3,
         "Timeframe",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         3,
         isFiveMinuteChart
         ? "5m READY"
         : "USE 5m",
         text_color =
             isFiveMinuteChart
             ? color.lime
             : color.red
    )

    table.cell(
         dashboard,
         0,
         4,
         "Trend",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         4,
         trendText,
         text_color = trendTextColor
    )

    table.cell(
         dashboard,
         0,
         5,
         "ADX",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         5,
         str.tostring(adx, "#.0"),
         text_color = color.white
    )

    table.cell(
         dashboard,
         0,
         6,
         "Position",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         6,
         positionText,
         text_color = positionTextColor
    )

    table.cell(
         dashboard,
         0,
         7,
         "SL / TP",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         7,
         str.tostring(stopPct, "#.00") +
         "% / " +
         str.tostring(targetPct, "#.00") +
         "%",
         text_color = color.white
    )

    table.cell(
         dashboard,
         0,
         8,
         "Closed trades",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         8,
         str.tostring(strategy.closedtrades),
         text_color = color.white
    )

    table.cell(
         dashboard,
         0,
         9,
         "Win rate",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         9,
         str.tostring(winRate, "#.0") + "%",
         text_color =
             winRate >= 40.0
             ? color.lime
             : color.white
    )

    table.cell(
         dashboard,
         0,
         10,
         "Estimated net R",
         text_color = color.silver
    )

    table.cell(
         dashboard,
         1,
         10,
         str.tostring(
             estimatedNetR,
             "#.0"
         ) +
         "R",
         text_color =
             estimatedNetR >= 0.0
             ? color.lime
             : color.red
    )

if barstate.islast and not showDashboard
    table.clear(
         dashboard,
         0,
         0,
         1,
         10
    )