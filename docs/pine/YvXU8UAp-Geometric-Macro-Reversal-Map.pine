//@version=6
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © erdensedat

indicator("Geometric Macro Reversal Map", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// --- Constants & Mathematical Sci-Fi ---
PHIDOT = 1.61803398875
RAD_TO_DEG = 180 / math.pi

// --- Inputs ---
grp_geo   = "Geometric Reversal Logic"
atrMult   = input.float(2.56, "Inertia Threshold (ATR Mult)", minval = 0.1, step = 0.1, tooltip = "Fibonacci-based volatility multiplier.")
lookback  = input.int(11, "Temporal Lookback (Bars)", minval = 5)
phi_sens  = input.float(0.382, "Phi Sensitivity Coefficient", minval = 0.1, step = 0.1)

grp_vis   = "Visual Geometry"
themeInput = input.string("Classic", "Interface Theme", options = ["Classic", "Neon", "Monochrome"])
labelSize  = input.string("small", "Label Scaling", options = ["tiny", "small", "normal"])

grp_vwap = "VWAP Settings"
showVwap = input.bool(false, "Show VWAP", group = grp_vwap)
vwapColor = input.color(color.new(color.blue, 0), "VWAP Color", group = grp_vwap)

// --- Colors ---
var color COLOR_REFLECT = #f23645 // Red (Resistance/Down)
var color COLOR_REFRACT = #089981 // Green (Support/Up)

if themeInput == "Neon"
    COLOR_REFLECT := #ff00ff
    COLOR_REFRACT := #00ffff
else if themeInput == "Monochrome"
    COLOR_REFLECT := color.gray
    COLOR_REFRACT := color.silver

// --- VWAP Calculation ---
var float vwapSumPrcVol = 0.0
var float vwapSumVol = 0.0
bool isNewDay = ta.change(time("D")) != 0
if isNewDay
    vwapSumPrcVol := 0.0
    vwapSumVol := 0.0

vwapSumPrcVol += hlc3 * volume
vwapSumVol += volume
float vwapValue = vwapSumPrcVol / vwapSumVol

plot(showVwap ? vwapValue : na, "VWAP", color = vwapColor, linewidth = 2)

// --- User Defined Types ---
type GeometryLevel
    float   price
    bool    isShort     // Determines if it's currently resistance (true) or support (false)
    float   mass        // Hits interpreted as scientific mass
    float   theta       // Approach angle
    float   penetration // Depth of last candle intersection
    line    vectorLine
    box     massBox
    box     intensityBox
    label   dataLabel
    int     initTime
    bool    isActive

var levels = array.new<GeometryLevel>()

// --- Mathematical Functions ---
// Calculate geometric angle of price movement
get_slope_angle(float p1, float p2, int bars) =>
    float price_change_pct = (p2 - p1) / p1 * 100
    math.atan(price_change_pct / bars) * RAD_TO_DEG

// Quantum Interaction: How much of the candle cuts the level?
get_cut_ratio(float p, float h, float l) =>
    float candle_range = h - l
    float cut_depth = 0.0
    if h > p and l < p
        cut_depth := math.min(h - p, p - l) / candle_range
    cut_depth

// --- Core Logic ---
atr = ta.atr(14)
high_pivot = ta.pivothigh(high, lookback, lookback)
low_pivot  = ta.pivotlow(low, lookback, lookback)

// New Level Creation via Pivot Detection
if not na(high_pivot) or not na(low_pivot)
    bool is_high = not na(high_pivot)
    float p = is_high ? high_pivot : low_pivot
    
    // Improved Flawless Level Check
    float diff = math.abs(close - p)
    bool has_inertia = diff > (atr * atrMult)
    
    // Geometric distance check for uniqueness
    bool too_close = false
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            l = array.get(levels, i)
            if math.abs(p - l.price) < (atr * phi_sens)
                l.mass += PHIDOT * 0.5
                too_close := true
                break
    
    if not too_close and has_inertia
        // Initial state based on pivot type
        color c = is_high ? COLOR_REFLECT : COLOR_REFRACT
        ln   = line.new(bar_index[lookback], p, bar_index, p, color = color.new(c, 70), width = 1, style = line.style_dashed)
        bg   = box.new(bar_index, p, bar_index, p, border_color = na, bgcolor = color.new(c, 90))
        fill = box.new(bar_index, p, bar_index, p, bgcolor = c, border_color = na)
        
        string lbl_size = labelSize == "tiny" ? size.tiny : labelSize == "normal" ? size.normal : size.small
        lbl  = label.new(bar_index, p, "", color = #00000000, textcolor = c, style = label.style_label_left, size = lbl_size)
        
        array.push(levels, GeometryLevel.new(p, is_high, 1.0, 0.0, 0.0, ln, bg, fill, lbl, time, true))

// --- Iterative Geometric Processing ---
if array.size(levels) > 0
    for i = array.size(levels) - 1 to 0
        l = array.get(levels, i)
        
        // 1. Kinetic Interaction Calculation
        float cut = get_cut_ratio(l.price, high, low)
        float angle = get_slope_angle(l.price, close, 5)
        l.theta := angle
        l.penetration := cut
        
        // 2. Quantum Polarity Flip
        if cut > 0
            l.mass += (cut * PHIDOT)
            if close > l.price
                l.isShort := false
            else if close < l.price
                l.isShort := true
        
        color state_color = l.isShort ? COLOR_REFLECT : COLOR_REFRACT
        bool is_breaking = (l.isShort and close > l.price) or (not l.isShort and close < l.price)
        
        // Intensity Fill (Based on Mass) Calculation
        float strength_pct = math.min(l.mass * 5, 100)
        
        // User observation logic implementation
        string prediction = ""
        if strength_pct >= 90
            prediction := "LIQ VOID" // Fiyatın çok hızlı geçtiği, kutusu full dolu yerler
        else if strength_pct <= 20
            prediction := "FRESH ZONE" // Kutusu az dolu olan, ateşleme görevi gören yerler
        else
            if cut > 0.4
                prediction := is_breaking ? "BOOM" : "TURBULENCE"
            else if cut > 0 and cut < 0.2
                prediction := l.isShort ? "RES" : "SUP"
            else
                prediction := is_breaking ? "DRIFT" : "STABLE"

        // 3. Visual Rendering (Scientific UI)
        float box_h = atr * 0.05
        int x_offset = 8
        
        line.set_x2(l.vectorLine, bar_index + x_offset)
        line.set_color(l.vectorLine, color.new(state_color, 60))
        
        // Mass Indicator Box
        box.set_lefttop(l.massBox, bar_index + x_offset + 1, l.price + box_h)
        box.set_rightbottom(l.massBox, bar_index + x_offset + 25, l.price - box_h)
        box.set_bgcolor(l.massBox, color.new(state_color, 92))
        
        // Apply Intensity Fill visually
        int fill_width = int(24 * strength_pct / 100)
        box.set_lefttop(l.intensityBox, bar_index + x_offset + 1, l.price + box_h)
        box.set_rightbottom(l.intensityBox, bar_index + x_offset + 1 + fill_width, l.price - box_h)
        box.set_bgcolor(l.intensityBox, state_color)
        
        // Minimal Data Label
        string info = str.tostring(l.price, format.mintick) + " | " + prediction
             
        label.set_xy(l.dataLabel, bar_index + x_offset + 26, l.price)
        label.set_text(l.dataLabel, info)
        label.set_textcolor(l.dataLabel, state_color)

// Cleanup
if array.size(levels) > 15
    old = array.shift(levels)
    line.delete(old.vectorLine)
    box.delete(old.massBox)
    box.delete(old.intensityBox)
    label.delete(old.dataLabel)

// --- Watermark ---
var table wm = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(wm, 0, 0, "erdensedat", text_color = color.new(color.gray, 60), text_size = size.large)
