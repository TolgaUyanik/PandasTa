//@version=5
indicator("Daily EMA 21/34/55 (Matches Built-in)", overlay=true)

// === Inputs ===
ema21_len   = input.int(21, title="EMA 21 Length")
ema34_len   = input.int(34, title="EMA 34 Length")
ema55_len   = input.int(55, title="EMA 55 Length")

color_ema21 = input.color(color.blue, title="EMA 21 Color")
color_ema34 = input.color(color.orange, title="EMA 34 Color")
color_ema55 = input.color(color.red, title="EMA 55 Color")

waitForClose = input.bool(true, title="Wait for timeframe closes (like built-in)")

// === EMA function depending on waitForClose
get_ema_daily(len) =>
    waitForClose
     ? request.security(syminfo.tickerid, "D", ta.ema(close, len)[1], lookahead=barmerge.lookahead_off)
     : request.security(syminfo.tickerid, "D", ta.ema(close, len), lookahead=barmerge.lookahead_on)

// === Final EMA values ===
ema21 = get_ema_daily(ema21_len)
ema34 = get_ema_daily(ema34_len)
ema55 = get_ema_daily(ema55_len)

// === Plot EMAs ===
plot(ema21, title="Daily EMA 21", color=color_ema21, linewidth=2)
plot(ema34, title="Daily EMA 34", color=color_ema34, linewidth=2)
plot(ema55, title="Daily EMA 55", color=color_ema55, linewidth=2)
