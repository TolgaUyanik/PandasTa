// ============================================================================================================
// SECTION#2: CONVERSION UTILITIES
// ============================================================================================================

// @function Converts a Color to an RGB Array.
// @param color (color) The source color to convert.
// @returns ([float, float, float]) A tuple containing Red, Green, and Blue values (0-255).
export toRGB(color color) => 
    [color.r(color), color.g(color), color.b(color)]


// @function Converts a Color to HSL (Hue, Saturation, Lightness) values.
// @param color (color) The source color to convert.
// @returns ([float, float, float]) A tuple containing Hue (0-360), Saturation (0-100)%, and Lightness (0-100)%.
export toHSL(color color) =>
    [R, G, B] = toRGB(color)
    r = R / 255.0, g = G / 255.0, b = B / 255.0

    channelMax = math.max(r, g, b)
    channelMin = math.min(r, g, b)
    delta = channelMax - channelMin

    H = 0.0
    if delta != 0
        if channelMax == r
            H := ((g - b) / delta) % 6
        else if channelMax == g
            H := (b - r) / delta + 2
        else if channelMax == b
            H := (r - g) / delta + 4
        
        H := H < 0 ? (H * 60) + 360 : H * 60

    L = (channelMax + channelMin) / 2.0
    S = delta != 0 ? delta / (1 - math.abs(2 * L - 1)) : 0.0
    
    [H, S * 100, L * 100]


// @function Creates a new color using the RGB color model.
// @param R (float) Red component (0-255).
// @param G (float) Green component (0-255).
// @param B (float) Blue component (0-255).
// @returns (color) The resulting color.
export rgb(float R, float G, float B) =>
    r = math.max(0, math.min(255, R)) 
    g = math.max(0, math.min(255, G))
    b = math.max(0, math.min(255, B))

    color.rgb(r, g, b)


// @function Creates a new color using the HSL color model.
// @param H (float) Hue (0-360).
// @param S (float) Saturation (0-100)%.
// @param L (float) Lightness (0-100)%.
// @returns (color) The resulting color.
export hsl(float H, float S, float L) =>
    h = math.max(0, math.min(360, H)) 
    s = math.max(0, math.min(100, S))/100
    l = math.max(0, math.min(100, L))/100

    c = (1 - math.abs(2 * l - 1)) * s
    x = c * (1 - math.abs((h / 60) % 2 - 1))
    m = l - c / 2

    r = 0.0, g = 0.0, b = 0.0
    
    if h >= 0 and h < 60
        r := c, g := x, b := 0
    else if h >= 60 and h < 120
        r := x, g := c, b := 0
    else if h >= 120 and h < 180
        r := 0, g := c, b := x
    else if h >= 180 and h < 240
        r := 0, g := x, b := c
    else if h >= 240 and h < 300
        r := x, g := 0, b := c
    else if h >= 300 and h <= 360
        r := c, g := 0, b := x
    
    rgb(int((r + m) * 255), int((g + m) * 255), int((b + m) * 255))



// ============================================================================================================
// SECTION#3: GENERAL COLOR FUNCTIONS
// ============================================================================================================

// ================ Inverse Color
// @function Generates the exact opposite color on the RGB scale.
// @param color (series color) The source color.
// @returns (color) The inverse color.
export inverse(series color color) =>
    [R, G, B] = toRGB(color)
    rgb(255 - R, 255 - G, 255 - B)


// ================ Optimal Text Color
// @function Determines if White or Black text provides better contrast for a given background.
// @param color (series color) The background color.
// @returns (color) A text color with either Black or White.
export textColor(series color color) =>
    [R, G, B] = toRGB(color)
    (299 * R + 587 * G + 114 * B) / 1000 > 128 ? #000000 : #ffffff


// ================ Condition Color
// @function Returns a color based on a condition.
// @param condition (series bool) The condition.
// @param positive (series color) Color if condition is true.
// @param negative (series color) Color if condition is false. Default Transparent. 
// @returns (color) The state color.
export iff(series bool condition, series color positive, series color negative = #ffffff00) =>
    condition ? positive : negative


// ================ Random Color
// @function Generates a random color.
// @param seed (series int) Optional. Provides a fixed seed for reproducible randomness. Default na.
// @returns (color) A randomly generated RGB color.
export random(series int seed = na) =>
	if na(seed) or seed == 0
		rgb(math.random(0, 255), math.random(0, 255), math.random(0, 255))
	else 
		rgb(math.random(0, 255, seed), math.random(0, 255, seed * 33), math.random(0, 255, seed * 66))


// ================ Mix Two Colors
// @function Mixes two colors into a single composite color with equal weighting.
// @param color1 (series color) The start color.
// @param color2 (series color) The end color.
// @returns (color) The resulting "Average" color of the collection.
export mixTwo(series color color1, series color color2) =>
    [H1, S1, L1] = toHSL(color1)
    [H2, S2, L2] = toHSL(color2)
    
    p = 0.5
    
    float H = na
    diff = H2 - H1
    if math.abs(diff) > 180
        H := diff > 0 ? H1 + (diff - 360) * p : H1 + (diff + 360) * p
    else
        H := H1 + diff * p
        
    H := (H % 360 + 360) % 360     // Normalize Hue
    S  = S1 + (S2 - S1) * p		   // Saturation - Linear interpolation
    L  = L1 + (L2 - L1) * p        // Lightness - Linear interpolation
    
    hsl(H, S, L)


// ================ Mix Multiple Colors
// @function Mixes an array of colors into a single composite color.
// @param colors (array<color>) The list of colors to mix.
// @returns (color) The resulting "Average" color of the collection.
export mix(array<color> colors) =>
    int size = array.size(colors)
    
    if size == 0
        cNone

    else if size == 1
        array.get(colors, 0)

    else
        float sumSin = 0.0, float sumCos = 0.0
        float sumS   = 0.0, float sumL   = 0.0
        
        for i = 0 to size - 1
            color col = array.get(colors, i)
            [h, s, l] = toHSL(col)
            
            hRad = math.toradians(h)
            sumSin += math.sin(hRad)
            sumCos += math.cos(hRad)
            
            sumS += s
            sumL += l

        avgHRad = 0.0
        if sumCos != 0
            avgHRad := math.atan(sumSin / sumCos)
            if sumCos < 0
                avgHRad := avgHRad + math.pi
        else
            avgHRad := sumSin > 0 ? math.pi / 2 : -math.pi / 2

        float avgH = math.todegrees(avgHRad)

        // Average 
        float S = sumS / size
        float L = sumL / size
        float H = (avgH % 360 + 360) % 360
        
        hsl(H, S, L)


// ================ To Gray Scale
// @function Converts a color to its perceptual grayscale value (Luminance).
// @param color (series color) The source color.
// @returns (color) A grayscale color that matches the perceived brightness of the original.
export grayScale(series color color) =>
    [R, G, B] = toRGB(color)
    luma = int(0.2126 * R + 0.7152 * G + 0.0722 * B)
    rgb(luma, luma, luma)


// ================ Temperature Scale 
// @function Adjusts the color temperature (Warmth/Coolness) based on a value's position within a range.
// @param color (series color) The source color.
// @param value (series float) The source value.
// @param minVal (series float) The minimum value of the range (Cool).
// @param maxVal (series float) The maximum value of the range (Warm).
// @returns (color) The temperature-shifted color.
export temperature(series color color, series float value, series float minVal, series float maxVal) =>
    normalized = (value - minVal) / (maxVal - minVal)
    adjustment = (normalized - 0.5) * 200.0
    
    [H, S, L] = toHSL(color) 
    
    targetH = adjustment > 0 ? 30.0 : 210.0
    factor  = math.abs(adjustment) / 100.0
    
    diff = targetH - H
    if math.abs(diff) > 180
        diff := diff > 0 ? diff - 360 : diff + 360
        
    finalH  = (H + diff * factor) % 360
    finalH := finalH < 0 ? finalH + 360 : finalH
    
    hsl(finalH, S, L)


// ================ Heatmap Scale  
// @function Generates a 3-stop diverging gradient (e.g., Green -> Yellow -> Red).
// @param value (series float) The source value.
// @param minVal (series float) The value corresponding to the start color. Default Green Color.
// @param midVal (series float) The value corresponding to the middle color. Default Yellow Color.
// @param maxVal (series float) The value corresponding to the end color. Default Red Color.
// @param startColor (series color) Color for minVal.
// @param midColor (series color) Color for midVal.
// @param endColor (series color) Color for maxVal.
// @returns (color) The resulting gradient color.
export heatmap(series float value, series float minVal, series float midVal, series float maxVal, 
               series color startColor = #008000, series color midColor = #FFFF00, series color endColor = #FF0000) =>
    if value <= midVal
        rangeA = midVal - minVal
        pct = rangeA != 0 ? (value - minVal) / rangeA * 100 : 0
        color.from_gradient(pct, 0, 100, startColor, midColor)
    else
        rangeB = maxVal - midVal
        pct = rangeB != 0 ? (value - midVal) / rangeB * 100 : 0
		color.from_gradient(pct, 0, 100, midColor, endColor)


// ================ Z-Score Divergence Scale
// @function Generates a color based on Standard Deviations (Z-Score) from the mean.
// @param value (series float) The number of bars (length) for Mean and Standard Deviations.
// @param length (series int) The average value.
// @param stdev (series float) The standard deviation value.
// @param positiveColor (series color) Color for positive deviations. Default Green Color.
// @param negativeColor (series color) Color for negative deviations. Default Red Color.
// @param neutralColor (series color) Color for the mean. Default Gray color. 
// @param threshold (simple float) The Z-Score needed to reach full color intensity. Default 2.0.
// @returns (color) A gradient color representing statistical extremity.
export zScore(series float value, simple int length, series color positiveColor = #008000, 
             series color negativeColor = #FF0000, series color neutralColor = #808080, simple float threshold = 2.0) =>
    
    mean = ta.sma(value, length)
    stdev = ta.stdev(value, length)
    zScore = (value - mean) / (stdev == 0 ? 1 : stdev)
    pct = 50 + (math.max(-threshold, math.min(threshold, zScore)) / threshold * 50)
    if zScore > 0
        color.from_gradient(pct, 50, 100, neutralColor, positiveColor)
    else
        color.from_gradient(pct, 0, 50, negativeColor, neutralColor)



// ============================================================================================================
// SECTION#4: BASIC VARIATIONS
// ============================================================================================================

// ================ Tint Color
// @function Generates a "Tint" (mix with White).
// @param color (series color) The pure color to tint.
// @param intensity (series float) The intensity of the tint (0 to 100). 0 is pure color, 100 is pure white. Default is 50.
// @returns (color) The tinted color.
export tint(series color color, series float intensity = 50) =>
    lvl = math.max(0, math.min(100, intensity)) 
    color.from_gradient(lvl, 0, 100, color, #ffffff)


// ================ Shade Color
// @function Generates a "Shade" (mix with Black).
// @param color (series color) The pure color to shade.
// @param intensity (series float) The intensity of the shade (0 to 100). 0 is pure color, 100 is pure black. Default is 50.
// @returns (color) The shaded color.
export shade(series color color, series float intensity = 50) =>
    lvl = math.max(0, math.min(100, intensity))
    color.from_gradient(lvl, 0, 100, color, #000000)


// ================ Tone Color
// @function Generates a "Tone" (mix with Gray).
// @param color (series color) The pure color to tone.
// @param intensity (series float) The intensity of the tone (0 to 100). 0 is pure color, 100 is gray. Default is 50.
// @returns (color) The toned color.
export tone(series color color, series float intensity = 50) =>
    lvl = math.max(0, math.min(100, intensity))
    color.from_gradient(lvl, 0, 100, color, #808080)



// ============================================================================================================
// SECTION#5: ADVANCED GRADIENTS
// ============================================================================================================

// ================ Lightness Gradient Colors
// @function Calculates a color based on a Lightness gradient mapped to a data series.
// @param color (series color) The source color.
// @param value (series float) The current value to map against the range.
// @param minRange (series float) The bottom of the value range.
// @param maxRange (series float) The top of the value range.
// @param darkLimit (simple float) The darkest lightness percentage allowed (0-100). Default 70.
// @param lightLimit (simple float) The lightest lightness percentage allowed (0-100). Default 30.
// @returns (color) The resulting color with adjusted lightness.
export gradientLightness(series color color, series float value, series float minRange, series float maxRange, 
                         simple float darkLimit = 70, simple float lightLimit = 30) =>
    hiTone = math.max(0, math.min(100, lightLimit))
    lwTone = math.max(0, math.min(100,  darkLimit))
    
    val  = math.max(minRange, math.min(maxRange, value))

    [H, S, L] = toHSL(color)

    diff = maxRange - minRange
    L := (diff != 0 ? ((hiTone - lwTone) / diff * (val - minRange) + lwTone) : lwTone)

    hsl(H, S, L)


// ================ Saturation Gradient Colors
// @function Calculates a color based on a Saturation gradient mapped to a data series.
// @param color (series color) The source color.
// @param value (series float) The current value to map.
// @param minRange (series float) The bottom of the value range.
// @param maxRange (series float) The top of the value range.
// @param lowSat (simple float) The lowest saturation percentage (0-100). Default 20.
// @param highSat (simple float) The highest saturation percentage (0-100). Default 80.
// @returns (color) The resulting color with adjusted saturation.
export gradientSaturation(series color color, series float value, series float minRange, series float maxRange, 
                          simple float lowSat = 20, simple float highSat = 80) =>
    hiTone = math.max(0, math.min(100, highSat))
    lwTone = math.max(0, math.min(100,  lowSat))

    val  = math.max(minRange, math.min(maxRange, value))

    [H, S, L] = toHSL(color)

    diff = maxRange - minRange
    S := (diff != 0 ? ((hiTone - lwTone) / diff * (val - minRange) + lwTone) : lwTone) 

    hsl(H, S, L)


// ================ Hue Gradient Colors
// @function Calculates a color based on a Hue gradient (shift) mapped to a data series.
// @param color (series color) The source color.
// @param value (series float) The current value to map.
// @param minRange (series float) The bottom of the value range.
// @param maxRange (series float) The top of the value range.
// @param startHue (simple float) The starting Hue degree (0-360). Default 0.
// @param endHue (simple float) The ending Hue degree (0-360). Default 300.
// @returns (color) The resulting color with shifted Hue.
export gradientHue(series color color, series float value, series float minRange, series float maxRange, 
                   simple float startHue = 0, simple float endHue = 300) =>
    sHue = math.max(0, math.min(360, startHue))
    eHue = math.max(0, math.min(360,   endHue))

    val = math.max(minRange, math.min(maxRange, value))

    [H, S, L] = toHSL(color)

    diff = maxRange - minRange
    H := diff != 0 ? ((sHue - eHue) / diff * (val - minRange) + eHue) : eHue

    hsl(H, S, L)



// ============================================================================================================
// SECTION#6: COLOR HARMONIES
// ============================================================================================================

// ================ Harmony Monochrome Colors
// @function Generates a Monochromatic color scheme (variations in Lightness/Saturation).
// @param color (series color) The source color.
// @param customLightness (series float) Optional. Force a specific lightness (0-100). If NA, auto-calculates.
// @param customSaturation (series float) Optional. Force a specific saturation (0-100). If NA, auto-calculates.
// @returns ([color, color]) A tuple containing [Base Color, Monochromatic Variant].
export harmonyMonochrome(series color color, series float customLightness = na, series float customSaturation = na) =>
    [H, S, L] = toHSL(color)
    
    // Saturation if not provided
    S := if na(customSaturation) 
        S + 0.4 <= 0.8 ? S + 0.4 : (S - 0.4 >= 0.2 ? S - 0.4 : S + 0.4 - 0.8 + 0.2)
    else 
        math.max(0, math.min(1, customSaturation))

    // Lightness if not provided
    L := if na(customLightness)
        L + 0.3 <= 0.7 ? L + 0.3 : (L - 0.3 >= 0.3 ? L - 0.3 : L + 0.3 - 0.7 + 0.3)
    else 
        math.max(0, math.min(1, customLightness ))

    [color, hsl(H, S, L)]


// ================ Harmony Complementary Color Colors
// @function Generates a Complementary color scheme (180 degrees opposite on the wheel).
// @param color (series color) The source color.
// @returns ([color, color]) A tuple containing [Base Color, Complementary Color].
export harmonyComplementary(series color color) =>
    [H, S, L] = toHSL(color)
    H_comp = (H + 180) % 360
    [color, hsl(H_comp, S, L)]


// ================ Harmony Split Complementary Colors
// @function Generates a Split Complementary scheme (Two colors adjacent to the complement on the color wheel).
// @param color (series color) The source color.
// @returns ([color, color, color]) A tuple containing [Base Color, Split#1 Color, Split#2 Color].
export harmonySplitComplementary(series color color) =>
    [H, S, L] = toHSL(color)
    H_comp = (H + 180) % 360
    H1 = (H_comp - 30 + 360) % 360
    H2 = (H_comp + 30) % 360
    [color, hsl(H1, S, L), hsl(H2, S, L)]


// ================ Harmony Analogous Colors
// @function Generates an Analogous color scheme (Two colors [+/- 45 degrees] adjacent on the color wheel).
// @param color (series color) The source color.
// @returns ([color, color, color]) A tuple containing [Base Color, -45deg Neighbor Color, +45deg Neighbor Color].
export harmonyAnalogous(series color color) =>
    [H, S, L] = toHSL(color)
    H1 = (H - 45 + 360) % 360
    H2 = (H + 45) % 360
    [color, hsl(H1, S, L), hsl(H2, S, L)]


// ================ Harmony Triadic Colors
// @function Generates a Triadic color scheme (Three colors evenly spaced by 120 degrees adjacent on the color wheel).
// @param color (series color) The source color.
// @returns ([color, color, color]) A tuple containing [Base Color, +120deg Color, +240deg Color].
export harmonyTriadic(series color color) =>
    [H, S, L] = toHSL(color)
    H1 = (H + 120) % 360
    H2 = (H + 240) % 360
    [color, hsl(H1, S, L), hsl(H2, S, L)]


// ================ Harmony Tetradic Colors
// @function Generates a Tetradic color scheme (four colors spaced 60 degrees around the color wheel).
// @param color (series color) The source color.
// @returns ([color, color, color, color]) A tuple containing [Base Color, +90deg Color, +180deg Color, +270deg Color].
export harmonyTetradic(series color color) =>
    [H, S, L] = toHSL(color)
	H1 = (H +  90) % 360
	H2 = (H + 180) % 360
	H3 = (H + 270) % 360
    [color, hsl(H1, S, L), hsl(H2, S, L), hsl(H3, S, L)]



// ============================================================================================================
// SECTION#7: ARRAY Schemes GENERATORS
// ============================================================================================================

// ================ Array of TST Scheme Colors 
// @function Generates an array of Tint, Shade, or Tone colors.
// @param color (simple color) The starting color.
// @param count (simple int) Number of colors to generate in the array.
// @param mode (simple string) The type of gradient: "tint", "shade", or "tone".
// @returns (array<color>) An array of generated colors.
export schemeTST(simple color color, simple int count, simple string mode) =>
    colArray = array.new<color>()
    targetColor = mode == "tint" ? #ffffff : (mode == "tone" ? #787b86 : #363a45)

    if count > 0
        for i = 0 to count - 1
            colArray.push(color.from_gradient(i, 0, count - 1, color, targetColor))
    colArray


// ================ Array of LSH Scheme Colors 
// @function Generates an array of Lightness, Saturation, or Hue gradients.
// @param color (simple color) The starting color.
// @param count (simple int) Number of colors to generate in the array.
// @param mode (simple string) The attribute to vary: "lightness", "saturation", or "hue".
// @param upperLimit (simple float) The upper limit (percentage 0-100 for Lightness or Saturation, or degrees 0-360 for Hue).
// @param lowerLimit (simple float) The lower limit (percentage 0-100 for Lightness or Saturation, or degrees 0-360 for Hue).
// @returns (array<color>) An array of generated colors.
export schemeLSH(simple color color, simple int count, simple string mode, 
                 simple float upperLimit = na, simple float lowerLimit = na) =>
    colArray = array.new<color>()
    
    if count > 0
        if mode == "lightness"
            hiTone = math.max(0, math.min(100,  upperLimit))
            lwTone = math.max(0, math.min(100,  lowerLimit))

            hP = na(hiTone) ? 70 : hiTone, lP = na(lwTone) ? 30 : lwTone
            for i = 0 to count - 1 
                colArray.push(gradientLightness(color, i, 0, count - 1, hP, lP))

        else if mode == "saturation"
            hiTone = math.max(0, math.min(100,  upperLimit))
            lwTone = math.max(0, math.min(100,  lowerLimit))

            hP = na(hiTone) ? 80 : hiTone, lP = na(lwTone) ? 20 : lwTone
            for i = 0 to count - 1 
                colArray.push(gradientSaturation(color, i, 0, count - 1, lP, hP)) 

        else if mode == "hue"
            hiTone = math.max(0, math.min(360,  upperLimit))
            lwTone = math.max(0, math.min(360,  lowerLimit))

            hP = na(hiTone) ? 330 : hiTone, lP = na(lwTone) ? 0 : lwTone
            for i = 0 to count - 1 
                colArray.push(gradientHue(color, i, 0, count - 1, lP, hP))
    
    colArray



// ============================================================================================================
// SECTION#8: VISUAL GENERATORS
// ============================================================================================================
// Function to draw cells 
drawCell(tblId, col, row, bg, txtColor) =>
    [H, S, L] = toHSL(bg)
    valStr = "RGB: (" +  str.tostring(color.r(bg)) + ", "  + 
                         str.tostring(color.g(bg)) + ", "  + 
                         str.tostring(color.b(bg)) + ")\n" + 

             "HSL: (" +  str.tostring(math.round(H, 2)) + ", "          + 
                         str.tostring(math.round(S, 2), format.percent) + ", " + 
                         str.tostring(math.round(L, 2), format.percent) + ")"
    
    table.cell(tblId, col, row, valStr, 0, 0, txtColor, text.align_left, text.align_center, size.small, bg, 
               text_font_family = font.family_monospace)


// ================ Single Color
// @function Displays a single color's details (RGB/HSL values) in a table on the chart.
// @param color (simple color) The color to visualize.
// @param position (simple string)  The table position on the chart. Default is position.top_right.
// @returns Draws a colors table on the chart.
export visualizeColor(simple color color, simple string position = position.top_right) =>
    var tbl = table.new(position, 1, 1, cNone, cNone, 0, cNone, 1)
    if barstate.islastconfirmedhistory
        txtColor = textColor(color)
        drawCell(tbl, 0, 0, color, txtColor) 


// ================ Scheme 
// @function Displays an entire color scheme array in a grid table on the chart, each color has its (RGB/HSL values).
// @param colorArray (simple array<color>) The array of colors to visualize.
// @param position (simple string) The table position on the chart. Default is position.top_right.
// @returns Draws a colors table on the chart.
export visualizeScheme(simple array<color> colorArray, simple string position = position.top_right) =>
    var rows = int(math.ceil(colorArray.size() / 5.0))
    var tbl  = table.new(position, 5, rows, cNone, cNone, 0, cNone, 1)
    if barstate.islastconfirmedhistory
        if colorArray.size() > 0
            for i = 0 to colorArray.size() - 1
                color = colorArray.get(i)
                txtColor = textColor(color)
                drawCell(tbl, i % 5, i / 5, color, txtColor)


