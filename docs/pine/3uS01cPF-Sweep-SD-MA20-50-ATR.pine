//@version=6
strategy("Sweep + SD + MA20/50 + ATR", overlay=true, initial_capital=10000)

// ===== INPUTOK =====
swingLen = input.int(5, "Swing Length", minval=2)
rr = input.float(3.0, "Risk Reward", step=0.5)
atrMult = input.float(0.5, "Minimum Sweep ATR", step=0.1)

// ===== MA =====
ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)

plot(ma20, "MA20", color=color.green, linewidth=2)
plot(ma50, "MA50", color=color.red, linewidth=2)

// ===== ATR =====
atr = ta.atr(14)

// ===== SWING HIGH / LOW =====
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float supplyTop = na
var float supplyBottom = na

var float demandTop = na
var float demandBottom = na

// ===== SUPPLY ZÓNA =====
if not na(ph)
    supplyTop := high[swingLen]
    supplyBottom := math.max(open[swingLen], close[swingLen])

// ===== DEMAND ZÓNA =====
if not na(pl)
    demandBottom := low[swingLen]
    demandTop := math.min(open[swingLen], close[swingLen])

// ===== TREND SZŰRŐ =====
bullTrend =
     ma20 > ma50 and
     ma20 > ma20[1] and
     ma50 > ma50[1]

bearTrend =
     ma20 < ma50 and
     ma20 < ma20[1] and
     ma50 < ma50[1]

// ===== ATR TREND SZŰRŐ =====
trendStrength = math.abs(ma20 - ma50)

validTrend =
     trendStrength > atr * 0.2

// ===== LONG SWEEP =====
longSweep =
     not na(demandBottom) and
     low < demandBottom and
     close > demandBottom and
     (demandBottom - low) > atr * atrMult

// ===== SHORT SWEEP =====
shortSweep =
     not na(supplyTop) and
     high > supplyTop and
     close < supplyTop and
     (high - supplyTop) > atr * atrMult

// ===== BELÉPÉSEK =====
longCondition =
     longSweep and
     bullTrend and
     validTrend and
     strategy.position_size == 0

shortCondition =
     shortSweep and
     bearTrend and
     validTrend and
     strategy.position_size == 0

// ===== LONG =====
if longCondition

    stopLoss = low

    risk =
         close - stopLoss

    takeProfit =
         close + risk * rr

    strategy.entry("BUY", strategy.long)

    strategy.exit(
         "BUY TP/SL",
         "BUY",
         stop = stopLoss,
         limit = takeProfit)

// ===== SHORT =====
if shortCondition

    stopLoss = high

    risk =
         stopLoss - close

    takeProfit =
         close - risk * rr

    strategy.entry("SELL", strategy.short)

    strategy.exit(
         "SELL TP/SL",
         "SELL",
         stop = stopLoss,
         limit = takeProfit)

// ===== JELZÉSEK =====
plotshape(
     longCondition,
     title="BUY",
     style=shape.triangleup,
     location=location.belowbar,
     size=size.small,
     color=color.lime)

plotshape(
     shortCondition,
     title="SELL",
     style=shape.triangledown,
     location=location.abovebar,
     size=size.small,
     color=color.red)