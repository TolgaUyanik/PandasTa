//@version=5

// @description In descriptive statistics and chaos theory, a recurrence plot (RP) is a plot showing, for each moment i i in time, the times at which the state of a dynamical system returns to the previous state at `i`, i.e., when the phase space trajectory visits roughly the same area in the phase space as at time `j`. 
// ```
// ﻿﻿A recurrence plot (RP) is a graphical representation used in the analysis of time series data and dynamical systems. It visualizes recurring states or events over time by transforming the original time series into a binary matrix, where each element represents whether two consecutive points are above or below a specified threshold. The resulting Recurrence Plot Matrix reveals patterns, structures, and correlations within the data while providing insights into underlying mechanisms of complex systems.
// ```
// ~starling7b
// ___
// Reference:
// https://en.wikipedia.org/wiki/Recurrence_plot
// https://github.com/johannfaouzi/pyts/blob/main/pyts/image/recurrence.py
// https://github.com/bmfreis/recurrence_python/blob/master/cross_recurrence.py
// https://github.com/bmfreis/recurrence_cpp/blob/master/CrossRecurrencePlot.cpp
// https://github.com/JuliaDynamics/RecurrenceAnalysis.jl/blob/main/src/matrices/distance_matrix.jl
// https://juliadynamics.github.io/RecurrenceAnalysis.jl/v2.0/rplots/
library("TimeSeriesRecurrencePlot", overlay = true)

import RicardoSantos/SimilarityMeasures/1 as Measure
import RicardoSantos/TimeSeriesGrammianAngularField/1 as GAF
import RicardoSantos/MathEasingFunctions/1 as Easing
import peacefulLizard50262/WaveGenerator/1 as wave

// @function Generate distance matrix between two series.
// @param	series1		Source series 1.
// @param	series2		Source series 2.
// @param	max_freq	Maximum frequency to inpect or the size of the generated matrix.
// @param	norm		Norm of the distance metric, default=`euclidean`, options=`euclidean`, `manhattan`, `max`.
// @returns Matrix with distance values.
export distance_matrix (float series1, float series2, int max_freq, string norm='euclidean') =>
	int _depth = math.floor(bar_index / max_freq)
	matrix<float> _mat = matrix.new<float>(max_freq, max_freq, 1.0)
	if bar_index > max_freq
		switch norm
			'euclidean' =>
				for _i = 0 to max_freq - 1
					for _j = 0 to max_freq - 1
						float _temp = 0.0
						for _k = 0 to _depth - 1
							_temp += math.pow(nz(series1[_i+_k*max_freq], 0) - nz(series2[_j+_k*max_freq], 0.0), 2.0)
						_mat.set(_i, _j, math.sqrt(_temp))
			'manhattan' =>
				for _i = 0 to max_freq - 1
					for _j = 0 to max_freq - 1
						float _temp = 0.0
						for _k = 0 to _depth - 1
							_temp += math.abs(nz(series1[_i+_k*max_freq], 0) - nz(series2[_j+_k*max_freq], 0.0))
						_mat.set(_i, _j, _temp)
			'max' =>
				for _i = 0 to max_freq - 1
					for _j = 0 to max_freq - 1
						float _temp = 0.0
						for _k = 0 to _depth - 1
							_temp := math.max(nz(_temp, 0.0), math.abs(nz(series1[_i+_k*max_freq], 0) - nz(series2[_j+_k*max_freq], 0.0)))
						_mat.set(_i, _j, _temp)
	_mat

// @function Normalizes a matrix within its Min-Max range.
// @param	M	Source matrix.
// @returns Normalized matrix.
export method normalize_distance (matrix<float> M) =>
	float _max = M.max()
	float _min = M.min()
	float _r = _max - _min
	for _i = 0 to M.rows() - 1
		for _j = 0 to M.columns() - 1
			M.set(_i, _j, (M.get(_i, _j) - _min) / _r)
	M

// @function Updates the matrix with the condition `M(i,j) > threshold ? 1 : 0`.
// @param	M	Source matrix.
// @returns Cross matrix.
export method threshold (matrix<float> M, float threshold) =>
	for _i = 0 to M.rows() - 1
		for _j = 0 to M.columns() - 1
			M.set(_i, _j, M.get(_i, _j) > threshold ? 1.0 : 0.0)
	M

// @function An experimental alternative method to plot a recurrence_plot.
// @param	a	Array with data.
// @param	b	Array with data.
// @returns Recurrence_plot matrix.
export rolling_window (float[] a, float[] b, int sample_size = 1) =>
	int _size_a = a.size()
	int _size_b = b.size()
	matrix<float> C = matrix.new<float>(_size_a, _size_b, 0.0)
	for _i = 0 to _size_a - (1 + sample_size)
		for _j = 0 to _size_b - (1 + sample_size)
			C.set(_i, _j, Measure.euclidean(a.slice(_i, _i+sample_size), b.slice(_j, _j+sample_size))/sample_size)
	C



