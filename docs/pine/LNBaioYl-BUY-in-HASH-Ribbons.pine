//@version=6
indicator('BUY in HASH Ribbons', overlay=false)

// Hash Ribbons indicate Bitcoin miner capitulation phases, known as "Springs":
// - Gray circle: Start of capitulation (30-day HR SMA crosses below 60-day HR SMA).
// - White circles: During capitulation; brighter white shows HR recovery (increasing short SMA).
// - Yellow circle: End of capitulation (30-day HR SMA crosses above 60-day HR SMA).
// - Orange circle: Buy signal after full recovery, often a strong entry with low downside risk.

// INPUTS
type = input.string('Ribbons', title='Plot Type', options=['Ribbons', 'Oscillator'])
len_s = input.int(30, title='Hash Rate Short SMA (days)')
len_l = input.int(60, title='Hash Rate Long SMA (days)')
signals = input.bool(true, title='Plot Signals')
plot_halvings = input.bool(true, title='Plot Halvings')
raw = input.bool(false, title='Plot Raw Hash Rate')
source = input.string('QUANDL:BCHAIN/HRATE', title='Source Hash Rate', options=['QUANDL:BCHAIN/HRATE', 'INTOTHEBLOCK:BTC_HASHRATE'])

// UNIT SCALE
float scale = 1e6  // Divide by 1e6 to show in millions of TH/s (equivalent to EH/s)

// HASH RATE DATA
live_HR_raw = request.security(source, 'D', close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
live_HR_short = request.security(source, 'D', ta.sma(close, len_s), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
live_HR_long = request.security(source, 'D', ta.sma(close, len_l), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

hist_HR_raw = request.security(source, 'D', close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
hist_HR_short = request.security(source, 'D', ta.sma(close, len_s), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
hist_HR_long = request.security(source, 'D', ta.sma(close, len_l), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

daily_s10 = request.security(syminfo.tickerid, 'D', ta.sma(close, 10), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
daily_s20 = request.security(syminfo.tickerid, 'D', ta.sma(close, 20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// DAILY TIMEFRAME MANAGEMENT
is_newbar(res) => ta.change(time(res)) != 0

since_new_bar = ta.barssince(is_newbar('D'))
D_total_bars = int(na)
D_total_bars := since_new_bar == 0 ? since_new_bar[1] : D_total_bars[1]

// INDICATORS
float HR_short = barstate.isrealtime ? live_HR_short : hist_HR_short
float HR_long = barstate.isrealtime ? live_HR_long : hist_HR_long
float HR_raw = barstate.isrealtime ? live_HR_raw : hist_HR_raw

float s10 = na
s10 := barstate.isrealtime ? since_new_bar == D_total_bars ? daily_s10 : s10[1] : daily_s10
float s20 = na
s20 := barstate.isrealtime ? since_new_bar == D_total_bars ? daily_s20 : s20[1] : daily_s20

// SIGNALS
capitulation = ta.crossunder(HR_short, HR_long)
miner_capitulation = HR_short < HR_long
recovering = HR_short > HR_short[1] and HR_short > HR_short[2] and HR_short > HR_short[3] and miner_capitulation
recovered = ta.crossover(HR_short, HR_long)

// BUY SIGNAL COMPONENTS
price_cross_up = ta.crossover(s10, s20)
price_cross_down = ta.crossunder(s10, s20)
hr_cross_up = ta.crossover(HR_short, HR_long)
bars_since_recovered = ta.barssince(recovered)
bars_since_price_down = ta.barssince(price_cross_down)
bars_since_capitulation = ta.barssince(capitulation)

buy = price_cross_up and bars_since_recovered < bars_since_price_down and bars_since_recovered < bars_since_capitulation or (s10 > s20 and hr_cross_up)

// OSCILLATOR
delta = HR_short - HR_long
diff = delta / HR_short * 100

// PLOTS
plot(raw ? HR_raw / scale : na, color=color.new(color.white, 0), linewidth=1, title='HR Raw (EH/s)')
p1 = plot(type == 'Ribbons' ? HR_long / scale : na, color=color.new(color.white, 50), linewidth=2, title='HR SMA Long (EH/s)')
p2 = plot(type == 'Ribbons' ? HR_short / scale : na, color=HR_short < HR_long ? color.red : color.green, linewidth=2, title='HR SMA Short (EH/s)')
fill(p1, p2, color=HR_short < HR_long ? color.new(color.white, 30) : na)

plot(type == 'Oscillator' ? diff : na, style=plot.style_columns, color=diff < 0 ? color.red : color.blue, title='Oscillator')

// SIGNAL SHAPES
plotshape(signals and capitulation, style=shape.circle, location=location.top, color=color.new(color.gray, 50), size=size.normal, text='Capitulation', textcolor=color.new(color.black, 50), title='Capitulation')
plotshape(signals and miner_capitulation, style=shape.circle, location=location.top, color=color.new(color.white, 90), size=size.normal, title='Miner Capitulation')
plotshape(signals and recovering, style=shape.circle, location=location.top, color=color.new(color.white, 50), size=size.normal, title='Recovering')
plotshape(signals and recovered, style=shape.circle, location=location.top, color=color.new(color.yellow, 50), size=size.normal, textcolor=color.new(color.white, 0), title='Recovered')
plotshape(signals and buy, style=shape.circle, location=location.top, color=color.new(color.orange, 0), size=size.normal, text='BUY', textcolor=color.new(color.orange, 0), title='BUY')

// HALVINGS
halving_1 = timestamp(2012, 11, 28, 0, 0)
halving_2 = timestamp(2016, 7, 9, 0, 0)
halving_3 = timestamp(2020, 5, 11, 0, 0)
halving_4 = timestamp(2024, 4, 20, 0, 0)

var bool drew_h1 = false
var bool drew_h2 = false
var bool drew_h3 = false
var bool drew_h4 = false

if plot_halvings
    if not drew_h1 and time >= halving_1
        line.new(x1=halving_1, y1=0, x2=halving_1, y2=1, xloc=xloc.bar_time, extend=extend.both, color=color.new(color.white, 0), style=line.style_dashed)
        label.new(x=halving_1, y=na, text="1st Halving\n25 BTC", xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.white, 50), textcolor=color.black)
        drew_h1 := true
    
    if not drew_h2 and time >= halving_2
        line.new(x1=halving_2, y1=0, x2=halving_2, y2=1, xloc=xloc.bar_time, extend=extend.both, color=color.new(color.white, 0), style=line.style_dashed)
        label.new(x=halving_2, y=na, text="2nd Halving\n12.5 BTC", xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.white, 50), textcolor=color.black)
        drew_h2 := true
    
    if not drew_h3 and time >= halving_3
        line.new(x1=halving_3, y1=0, x2=halving_3, y2=1, xloc=xloc.bar_time, extend=extend.both, color=color.new(color.white, 0), style=line.style_dashed)
        label.new(x=halving_3, y=na, text="3rd Halving\n6.25 BTC", xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.white, 50), textcolor=color.black)
        drew_h3 := true
    
    if not drew_h4 and time >= halving_4
        line.new(x1=halving_4, y1=0, x2=halving_4, y2=1, xloc=xloc.bar_time, extend=extend.both, color=color.new(color.white, 0), style=line.style_dashed)
        label.new(x=halving_4, y=na, text="4th Halving\n3.125 BTC", xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.white, 50), textcolor=color.black)
        drew_h4 := true

// ALERTS
alertcondition(capitulation, title='Alert - Capitulation')
alertcondition(recovered, title='Alert - Recovered')
alertcondition(buy and not buy[1], title='Alert - BUY')

// CREDIT TABLE
var table table_source = table.new(position=position.bottom_center, columns=1, rows=1, border_width=1)
if barstate.isfirst
    table.cell(table_source, 0, 0, text='Trader T@thepfund', text_color=color.rgb(135, 135, 135), width=30, height=7, text_size=size.normal, text_halign=text.align_right)