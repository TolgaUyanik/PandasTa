//@version=5
//@description This library provides utilities for working with time intervals in milliseconds, seconds, minutes, hours, days, and weeks. It includes functions to handle conditions based on time rather than bars.

library("time_library")

// @type MS - Holds common time intervals in milliseconds.
// @field ms (int) - Milliseconds.
// @field s (int) - Seconds converted to milliseconds.
// @field m (int) - Minutes converted to milliseconds.
// @field h (int) - Hours converted to milliseconds.
// @field d (int) - Days converted to milliseconds.
// @field w (int) - Weeks converted to milliseconds.
export type MS
    int ms = 1
    int s = 1000
    int m = 60000
    int h = 3600000
    int d = 86400000
    int w = 604800000

// @function ms - Converts a time period in string format to milliseconds.
// @param TIME (series[string]) - The time period ("ms", "s", "m", "h", "d", "w").
// @returns (int) - The corresponding time period in milliseconds.
export ms(series string TIME)=>
    MS ms = MS.new()
    int ret = switch TIME
        "ms" => ms.ms
        "s" => ms.s
        "m" => ms.m
        "h" => ms.h
        "d" => ms.d
        "w" => ms.w
        => -1

    if ret == -1
        runtime.error('ms() time period must be: ("ms", "s", "m", "h", "d", "w").')
    
    ret

// @function true_in - Checks if the current time has reached a specific time after the given timestamp.
// @param timestamp (series[int]) - The starting timestamp.
// @param period (series[string]|series[int]) - The period in string format ("ms", "s", "m", "h", "d", "w"), or as an integer in milliseconds.
// @param multiplier (series[float]) - Multiplier to extend the period.
// @returns (bool) - True if current time is equal or past the end date calculated from timestamp and period.
export true_in(series int timestamp, series string period, series float multiplier)=>
    int time_until = int(ms(period) * math.max(0, multiplier))
    int end_date = timestamp + time_until - 1
    time >= end_date and timestamp != 0

// @function true_in - Checks if the current time has reached a specific time after the given timestamp.
// @param timestamp (series[int]) - The starting timestamp.
// @param period (series[string]|series[int]) - The period in string format ("ms", "s", "m", "h", "d", "w"), or as an integer in milliseconds.
// @param multiplier (series[float]) - Multiplier to extend the period.
// @returns (bool) - True if current time is equal or past the end date calculated from timestamp and period.
export true_in(series int timestamp, series int period, series float multiplier)=>
    int time_until = int(math.max(1, period) * math.max(0, multiplier))
    int end_date = timestamp + time_until - 1
    time >= end_date and timestamp != 0

// @function true_after - Returns true after a specified period multiplied by a multiplier has passed since a trigger was last true.
// @param trigger (series[bool]) - The condition that triggers the timer.
// @param period (series[string]|series[int]) - The period in string format ("ms", "s", "m", "h", "d", "w"), or as an integer in milliseconds.
// @param multiplier (series[float]) - Multiplier to extend the period.
// @returns (bool) - True if the specified time has passed since the last trigger.
export true_after(series bool trigger, series string period, series float multiplier)=>
    int ms = int(ms(period) * math.max(0, multiplier))

    var int last_triggered_time = 0
    bool true_after = (time - last_triggered_time) / ms >= 1

    if nz(trigger, false)
        last_triggered_time := time

    true_after

// @function true_after - Returns true after a specified period multiplied by a multiplier has passed since a trigger was last true.
// @param trigger (series[bool]) - The condition that triggers the timer.
// @param period (series[string]|series[int]) - The period in string format ("ms", "s", "m", "h", "d", "w"), or as an integer in milliseconds.
// @param multiplier (series[float]) - Multiplier to extend the period.
// @returns (bool) - True if the specified time has passed since the last trigger.
export true_after(series bool trigger, series int ms, series float multiplier)=>
    var int last_triggered_time = 0
    bool true_after = (time - last_triggered_time) / (math.max(1, ms) * math.max(0, multiplier)) >= 1

    if nz(trigger, false)
        last_triggered_time := time

    true_after

