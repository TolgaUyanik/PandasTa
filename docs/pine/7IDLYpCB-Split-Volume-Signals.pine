//@version=6
indicator("Split Volume + Signals", shorttitle="SplitVol", format=format.volume)

stdGreen = color.rgb(24, 88, 80)
stdRed   = color.rgb(120, 40, 40)
stdBlue  = color.rgb(60, 110, 180)
panelBg  = color.rgb(20, 20, 20)
headerBg = color.rgb(35, 35, 35)
clearBg  = color.new(color.black, 100)

showMa        = input.bool(true, "Show Volume MA")
maLength      = input.int(20, "MA Length", minval=1)
prevCount     = input.int(14, "Previous Candles Count", minval=1)
showTable     = input.bool(true, "Show Delta Table")
tablePosInput = input.string("Top Right", "Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"])
tableSizeIn   = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"])
buyColor      = input.color(stdGreen, "Buy Color")
sellColor     = input.color(stdRed, "Sell Color")
maColor       = input.color(color.new(stdBlue, 0), "MA Color")
signalUpCol   = input.color(stdGreen, "Buy Signal Color")
signalDnCol   = input.color(stdRed, "Sell Signal Color")

getTablePos(pos) =>
    pos == "Top Left" ? position.top_left :
     pos == "Top Center" ? position.top_center :
     pos == "Top Right" ? position.top_right :
     pos == "Middle Left" ? position.middle_left :
     pos == "Middle Center" ? position.middle_center :
     pos == "Middle Right" ? position.middle_right :
     pos == "Bottom Left" ? position.bottom_left :
     pos == "Bottom Center" ? position.bottom_center : position.bottom_right

getTextSize(sz) =>
    sz == "Tiny" ? size.tiny :
     sz == "Small" ? size.small :
     sz == "Normal" ? size.normal :
     sz == "Large" ? size.large : size.huge

calcBuySell() =>
    rng = high - low
    estBuy  = rng > 0 ? volume * (close - low) / rng : volume * 0.5
    estSell = rng > 0 ? volume * (high - close) / rng : volume * 0.5
    estBuy  := math.max(estBuy, 0)
    estSell := math.max(estSell, 0)
    parts = estBuy + estSell
    normBuy  = parts > 0 ? volume * estBuy / parts : volume * 0.5
    normSell = parts > 0 ? volume * estSell / parts : volume * 0.5
    [normBuy, normSell]

calcDeltaPctOnly() =>
    rng = high - low
    estBuy  = rng > 0 ? volume * (close - low) / rng : volume * 0.5
    estSell = rng > 0 ? volume * (high - close) / rng : volume * 0.5
    estBuy  := math.max(estBuy, 0)
    estSell := math.max(estSell, 0)
    parts = estBuy + estSell
    normBuy  = parts > 0 ? volume * estBuy / parts : volume * 0.5
    normSell = parts > 0 ? volume * estSell / parts : volume * 0.5
    totalVol = normBuy + normSell
    totalVol > 0 ? ((normBuy - normSell) / totalVol) * 100 : 0.0

[buyVol, sellVol] = calcBuySell()
deltaPct = volume > 0 ? ((buyVol - sellVol) / volume) * 100 : 0.0

volMA = ta.sma(volume, maLength)
volAboveMa = volume >= volMA

bullCandle = close > open
bearCandle = close < open

bearishSignal = bullCandle and sellVol > buyVol and volAboveMa
bullishSignal = bearCandle and buyVol > sellVol and volAboveMa

weekDeltaPct  = request.security(syminfo.tickerid, "W", calcDeltaPctOnly())
monthDeltaPct = request.security(syminfo.tickerid, "M", calcDeltaPctOnly())

prevBuySum = 0.0
prevSellSum = 0.0
for i = 1 to prevCount
    prevBuySum += nz(buyVol[i])
    prevSellSum += nz(sellVol[i])

prevTotal = prevBuySum + prevSellSum
prevDeltaPct = prevTotal > 0 ? ((prevBuySum - prevSellSum) / prevTotal) * 100 : 0.0

signalY = math.max(volume, nz(volMA, 0)) * 1.05

tablePos = getTablePos(tablePosInput)
tableTextSize = getTextSize(tableSizeIn)

plotcandle(0, sellVol, 0, sellVol, title="Sell Volume", color=sellColor, wickcolor=sellColor, bordercolor=sellColor)
plotcandle(sellVol, volume, sellVol, volume, title="Buy Volume", color=buyColor, wickcolor=buyColor, bordercolor=buyColor)
plot(showMa ? volMA : na, title="Volume MA", color=maColor, linewidth=2)

plotshape(bearishSignal ? signalY : na, title="Sell Signal", style=shape.triangledown, location=location.absolute, color=signalDnCol, size=size.small, text="Sell", textcolor=signalDnCol)
plotshape(bullishSignal ? signalY : na, title="Buy Signal", style=shape.triangleup, location=location.absolute, color=signalUpCol, size=size.small, text="Buy", textcolor=signalUpCol)

formatPct(v) =>
    str.tostring(v, "#.##") + "%"

valueColor(v) =>
    v > 0 ? buyColor : v < 0 ? sellColor : color.silver

var table deltaTable = table.new(tablePos, 2, 5, border_width=1)

if barstate.islast
    if showTable
        table.cell(deltaTable, 0, 0, "Delta %", text_color=color.white, bgcolor=headerBg, text_size=tableTextSize)
        table.cell(deltaTable, 1, 0, "Value", text_color=color.white, bgcolor=headerBg, text_size=tableTextSize)

        table.cell(deltaTable, 0, 1, "Last Candle", text_color=color.white, bgcolor=panelBg, text_size=tableTextSize)
        table.cell(deltaTable, 1, 1, formatPct(deltaPct), text_color=valueColor(deltaPct), bgcolor=panelBg, text_size=tableTextSize)

        table.cell(deltaTable, 0, 2, "Weekly", text_color=color.white, bgcolor=panelBg, text_size=tableTextSize)
        table.cell(deltaTable, 1, 2, formatPct(weekDeltaPct), text_color=valueColor(weekDeltaPct), bgcolor=panelBg, text_size=tableTextSize)

        table.cell(deltaTable, 0, 3, "Monthly", text_color=color.white, bgcolor=panelBg, text_size=tableTextSize)
        table.cell(deltaTable, 1, 3, formatPct(monthDeltaPct), text_color=valueColor(monthDeltaPct), bgcolor=panelBg, text_size=tableTextSize)

        table.cell(deltaTable, 0, 4, "Prev " + str.tostring(prevCount), text_color=color.white, bgcolor=panelBg, text_size=tableTextSize)
        table.cell(deltaTable, 1, 4, formatPct(prevDeltaPct), text_color=valueColor(prevDeltaPct), bgcolor=panelBg, text_size=tableTextSize)
    else
        for col = 0 to 1
            for row = 0 to 4
                table.cell(deltaTable, col, row, "", text_color=clearBg, bgcolor=clearBg, text_size=tableTextSize)
