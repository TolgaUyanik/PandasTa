//@version=6
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Quant

//@version=6
indicator("Solid Dumb Money Concepts v2.1", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================
// 1. CONFIGURATION INPUTS
// ==========================================
var string G_ST = "Swing Sensitivity"
sLeft  = input.int(5, "Left Bars", minval=1, group=G_ST)
sRight = input.int(5, "Right Bars", minval=1, group=G_ST)

var string G_VI = "Current TF Colors"
c_res = input.color(color.new(color.red, 50), "Resistance Color", group=G_VI)
c_sup = input.color(color.new(color.green, 50), "Support Color", group=G_VI)

var string G_HTF = "Higher Timeframes (Dashboard & Levels)"
htf1Res   = input.timeframe("60",  "HTF 1 Timeframe", group=G_HTF)
showHtf1  = input.bool(false, "Show HTF 1 Levels", group=G_HTF)
c_htf1_res = input.color(color.new(color.maroon, 20), "HTF 1 Res Color", group=G_HTF)
c_htf1_sup = input.color(color.new(color.teal, 20), "HTF 1 Sup Color", group=G_HTF)

htf2Res   = input.timeframe("240", "HTF 2 Timeframe", group=G_HTF)
showHtf2  = input.bool(false, "Show HTF 2 Levels", group=G_HTF)
c_htf2_res = input.color(color.new(color.purple, 20), "HTF 2 Res Color", group=G_HTF)
c_htf2_sup = input.color(color.new(color.navy, 20), "HTF 2 Sup Color", group=G_HTF)

htf3Res   = input.timeframe("D",   "HTF 3 Timeframe", group=G_HTF)
showHtf3  = input.bool(false, "Show HTF 3 Levels", group=G_HTF)
c_htf3_res = input.color(color.new(color.fuchsia, 20), "HTF 3 Res Color", group=G_HTF)
c_htf3_sup = input.color(color.new(color.olive, 20), "HTF 3 Sup Color", group=G_HTF)

// ==========================================
// 2. STRUCTURAL DATA & LEVEL TRACKING TYPE
// ==========================================
type LevelTracker
    float[] resLevels
    float[] supLevels
    line[] resLines
    line[] supLines

method processLevels(LevelTracker this, float pivotHi, float pivotLo, float currentClose, color resCol, color supCol, bool isNewPivotBar, bool showLevels) =>
    // Add new levels
    if isNewPivotBar
        if not na(pivotHi)
            this.resLevels.push(pivotHi)
            if showLevels
                l = line.new(bar_index, pivotHi, bar_index, pivotHi, color=resCol, width=2, style=line.style_dashed)
                this.resLines.push(l)
                
        if not na(pivotLo)
            this.supLevels.push(pivotLo)
            if showLevels
                l = line.new(bar_index, pivotLo, bar_index, pivotLo, color=supCol, width=2, style=line.style_dashed)
                this.supLines.push(l)
                
    // Manage Resistance
    if this.resLines.size() > 0
        for i = this.resLines.size() - 1 to 0
            l   = this.resLines.get(i)
            lvl = this.resLevels.get(i)
            if currentClose > lvl 
                if showLevels
                    line.set_x2(l, bar_index)
                    line.set_style(l, line.style_solid)
                    line.set_color(l, color.new(color.blue, 0))
                this.resLines.remove(i)
                this.resLevels.remove(i)
                true
            else
                if showLevels
                    line.set_x2(l, bar_index)
                true

    // Manage Support
    if this.supLines.size() > 0
        for i = this.supLines.size() - 1 to 0
            l   = this.supLines.get(i)
            lvl = this.supLevels.get(i)
            if currentClose < lvl 
                if showLevels
                    line.set_x2(l, bar_index)
                    line.set_style(l, line.style_solid)
                    line.set_color(l, color.new(color.orange, 0))
                this.supLines.remove(i)
                this.supLevels.remove(i)
                true
            else
                if showLevels
                    line.set_x2(l, bar_index)
                true

// ==========================================
// 3. CURRENT TIMEFRAME LEVELS
// ==========================================
bHigh = math.max(open, close)
bLow  = math.min(open, close)

float pivotHi = ta.pivothigh(bHigh, sLeft, sRight)
float pivotLo = ta.pivotlow(bLow, sLeft, sRight)

var LevelTracker currentTfTracker = LevelTracker.new(array.new<float>(), array.new<float>(), array.new<line>(), array.new<line>())
currentTfTracker.processLevels(pivotHi, pivotLo, close, c_res, c_sup, true, true)

// Determine Current TF State
var string currentState = "Ranging"

if currentTfTracker.resLevels.size() > 0
    topRes = currentTfTracker.resLevels.get(currentTfTracker.resLevels.size() - 1)
    if close > topRes
        currentState := "Gained Res -> Next Res"
    else if high > topRes and close < topRes
        currentState := "Failed Gain -> Test Sup"

if currentTfTracker.supLevels.size() > 0
    botSup = currentTfTracker.supLevels.get(currentTfTracker.supLevels.size() - 1)
    if close < botSup
        currentState := "Lost Sup -> Next Sup"
    else if low < botSup and close > botSup
        currentState := "Failed Loss -> Test Res"

// ==========================================
// 4. HIGHER TIMEFRAME LEVELS
// ==========================================
[htf1PHi, htf1PLo, htf1Close, htf1Time, htf1Ema] = request.security(syminfo.tickerid, htf1Res, [ta.pivothigh(math.max(open, close), sLeft, sRight), ta.pivotlow(math.min(open, close), sLeft, sRight), close, time, ta.ema(close, 200)])
[htf2PHi, htf2PLo, htf2Close, htf2Time, htf2Ema] = request.security(syminfo.tickerid, htf2Res, [ta.pivothigh(math.max(open, close), sLeft, sRight), ta.pivotlow(math.min(open, close), sLeft, sRight), close, time, ta.ema(close, 200)])
[htf3PHi, htf3PLo, htf3Close, htf3Time, htf3Ema] = request.security(syminfo.tickerid, htf3Res, [ta.pivothigh(math.max(open, close), sLeft, sRight), ta.pivotlow(math.min(open, close), sLeft, sRight), close, time, ta.ema(close, 200)])

var LevelTracker htf1Tracker = LevelTracker.new(array.new<float>(), array.new<float>(), array.new<line>(), array.new<line>())
var LevelTracker htf2Tracker = LevelTracker.new(array.new<float>(), array.new<float>(), array.new<line>(), array.new<line>())
var LevelTracker htf3Tracker = LevelTracker.new(array.new<float>(), array.new<float>(), array.new<line>(), array.new<line>())

bool isNewHtf1 = ta.change(htf1Time) != 0
bool isNewHtf2 = ta.change(htf2Time) != 0
bool isNewHtf3 = ta.change(htf3Time) != 0

htf1Tracker.processLevels(htf1PHi, htf1PLo, close, c_htf1_res, c_htf1_sup, isNewHtf1, showHtf1)
htf2Tracker.processLevels(htf2PHi, htf2PLo, close, c_htf2_res, c_htf2_sup, isNewHtf2, showHtf2)
htf3Tracker.processLevels(htf3PHi, htf3PLo, close, c_htf3_res, c_htf3_sup, isNewHtf3, showHtf3)

htf1Trend = htf1Close > htf1Ema ? "Bullish" : "Bearish"
htf2Trend = htf2Close > htf2Ema ? "Bullish" : "Bearish"
htf3Trend = htf3Close > htf3Ema ? "Bullish" : "Bearish"

// ==========================================
// 5. DASHBOARD
// ==========================================
var table dash = table.new(position.top_right, 2, 5, border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    // Current TF State
    table.cell(dash, 0, 0, "Current TF State", bgcolor=color.new(color.blue, 80), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, currentState, bgcolor=color.new(color.blue, 80), text_color=color.white, text_size=size.small)
    
    // Next Target Expectation
    table.cell(dash, 0, 1, "Next Target", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    target = (currentState == "Gained Res -> Next Res" or currentState == "Failed Loss -> Test Res") ? "Higher Res" : (currentState == "Lost Sup -> Next Sup" or currentState == "Failed Gain -> Test Sup") ? "Lower Sup" : "Ranging"
    table.cell(dash, 1, 1, target, bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    
    // HTF 1 Bias
    table.cell(dash, 0, 2, "HTF 1 Bias (" + htf1Res + ")", bgcolor=color.new(color.teal, 80), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, htf1Trend, bgcolor=htf1Trend == "Bullish" ? color.new(color.green, 70) : color.new(color.red, 70), text_color=color.white, text_size=size.small)
    
    // HTF 2 Bias
    table.cell(dash, 0, 3, "HTF 2 Bias (" + htf2Res + ")", bgcolor=color.new(color.teal, 80), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, htf2Trend, bgcolor=htf2Trend == "Bullish" ? color.new(color.green, 70) : color.new(color.red, 70), text_color=color.white, text_size=size.small)
    
    // HTF 3 Bias
    table.cell(dash, 0, 4, "HTF 3 Bias (" + htf3Res + ")", bgcolor=color.new(color.teal, 80), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, htf3Trend, bgcolor=htf3Trend == "Bullish" ? color.new(color.green, 70) : color.new(color.red, 70), text_color=color.white, text_size=size.small)
