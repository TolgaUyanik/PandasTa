// defaultTimeZone = input.string("Azia/Shanghai", "Default Time Zone")
// msOffsetInput = hoursOffsetInput * MS_IN_1H

// export currTime() =>
// 	t = timenow + msOffsetInput

export openTime() =>
    t = time(timeframe = timeframe.period, session = syminfo.session, timezone = syminfo.timezone)

///////////////////////////////////////////////////
// @function Convert given time to minutes of day
// @param t Time
// @param timezone Timezone of the input h:m
// @return Minutes of day
// All exported functions args should be typified
export timeMinInDay(int t, string timezone = "GMT+0") =>
	tmid = hour(t, timezone) * 60 + minute(t, timezone)

///////////////////////////////////////////////////
// @function Convert given hour and minute to minutes of day
// @param h Hour in a day
// @param m Minute in a day
// @param timezone Timezone of the input h:m
// @return Minutes of day
export timeMinInDayManual(int h, int m) =>
	tmid = h * 60 + m

///////////////////////////////////////////////////
// @function Return if current time is High Risk for Forex
// @param series of bool of high risk mark
// NOTE: EURUSD => America/New_York is GMT-5 time zone
// @return Minutes of day
export isForexHighRiskTime() =>
    t = openTime()
    timezone = "GMT+0"
    bool isHighRisk = false
    tmid = timeMinInDay(t, timezone)
    // UTC+8 time 03:30-08:00
    isHighRisk := isHighRisk or (tmid >= timeMinInDayManual(20, 30))
    // UTC+8 time 13:20-13:40
    isHighRisk := isHighRisk or (tmid >= timeMinInDayManual(5, 20) and tmid < timeMinInDayManual(5, 40))
    // UTC+8 time 20:20-21:40
    isHighRisk := isHighRisk or (tmid >= timeMinInDayManual(12, 20) and tmid < timeMinInDayManual(13, 40))

// =========== Demo ===========

printTable(txt) =>
    var table t = table.new(position.middle_right, 1, 1)
    table.cell(t, 0, 0, txt, text_halign = text.align_right, bgcolor = color.yellow)

t = openTime()

printTable(
   str.format("Current bar''s open time {0,date,HH:mm:ss yyyy.MM.dd}", t) +
   str.format("\nSymbol Time: {0}, {1}, {2}", timeframe.period, syminfo.session, syminfo.timezone) +
   str.format("\nSymbol Time: {0} {1} {2,date,HH:mm:ss yyyy.MM.dd} {3}", hour(t), minute(t), t, timeMinInDay(t)) +
   str.format("\nAsia/Shanghai Time: {0} {1} {2,date,HH:mm:ss yyyy.MM.dd} {3}", hour(t, "Asia/Shanghai"), minute(t, "Asia/Shanghai"), t, timeMinInDay(t, "Asia/Shanghai")))

bgcolor(isForexHighRiskTime() ? color.silver : na)
