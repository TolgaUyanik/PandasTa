//@version=5
// @description A sophisticated Kalman Filter implementation for financial time series analysis
// @author Rocky-Studio
// @version 1.0
library("Kalmanfilter", overlay=true)

// @function Initializes Kalman Filter parameters
// @param initial_value (float) The initial state estimate
// @param process_noise (float) The process noise coefficient (Q)
// @param measurement_noise (float) The measurement noise coefficient (R)
// @returns [float, float] A tuple containing [initial_state, initial_covariance]
export initialize(float initial_value, float process_noise, float measurement_noise) =>
    initial_state = initial_value
    // More sophisticated covariance initialization
    initial_covariance = math.max(process_noise * math.abs(initial_value), measurement_noise)
    [initial_state, initial_covariance]

// @function Update Kalman Filter state
export update(float prev_state, float prev_covariance, float measurement, 
             float process_noise, float measurement_noise) =>
    // Prediction
    predicted_state = prev_state
    predicted_covariance = prev_covariance + process_noise
    
    // Update
    kalman_gain = predicted_covariance / (predicted_covariance + measurement_noise)
    current_state = predicted_state + kalman_gain * (measurement - predicted_state)
    current_covariance = (1 - kalman_gain) * predicted_covariance
    
    [current_state, current_covariance]

// @function Adaptive measurement noise calculation
export calculate_measurement_noise(float[] price_series, int length) =>
    float sum = 0.0
    float sum_squared = 0.0
    
    for i = 0 to length - 1
        price = array.get(price_series, i)
        sum := sum + price
        sum_squared := sum_squared + price * price
    
    mean = sum / length
    variance = (sum_squared / length) - (mean * mean)
    variance

// Alternative simpler version using built-in variance
export calculate_measurement_noise_simple(float[] price_series) =>
    variance = array.variance(price_series)
    variance

// @function Enhanced trading update with velocity
export update_trading(float prev_state, float prev_velocity, float prev_covariance, 
                     float measurement, int volatility_window) =>
    // Calculate adaptive parameters
    vol = ta.stdev(measurement, volatility_window)
    adaptive_noise = vol * vol
    
    // Prediction with velocity
    predicted_state = prev_state + prev_velocity
    predicted_velocity = prev_velocity
    
    // Update
    innovation = measurement - predicted_state
    kalman_gain = prev_covariance / (prev_covariance + adaptive_noise)
    
    // State updates
    current_state = predicted_state + kalman_gain * innovation
    current_velocity = prev_velocity + kalman_gain * innovation
    current_covariance = (1 - kalman_gain) * prev_covariance
    
    // Signal strength based on velocity and volatility
    signal = current_velocity / vol
    
    [current_state, current_velocity, signal]

// Internal helper function for 2x2 matrix multiplication
matrix_multiply_2x2(float[] a, float[] b) =>
    float c11 = array.get(a, 0) * array.get(b, 0) + array.get(a, 1) * array.get(b, 2)
    float c12 = array.get(a, 0) * array.get(b, 1) + array.get(a, 1) * array.get(b, 3)
    float c21 = array.get(a, 2) * array.get(b, 0) + array.get(a, 3) * array.get(b, 2)
    float c22 = array.get(a, 2) * array.get(b, 1) + array.get(a, 3) * array.get(b, 3)
    array.from(c11, c12, c21, c22)

// @function Kalman Filter Model 4 implementation (Benhamou 2018)
export model4_update(float prev_mean, float prev_speed, float[] prev_covariance, 
              float price, float[] process_noise, float measurement_noise) =>
    // Prediction step
    predicted_mean = prev_mean
    predicted_speed = prev_speed
    
    // Predicted covariance (simplified matrix multiplication)
    p11 = array.get(prev_covariance, 0) + array.get(process_noise, 0)
    p12 = array.get(prev_covariance, 1) + array.get(process_noise, 1)
    p21 = array.get(prev_covariance, 2) + array.get(process_noise, 2)
    p22 = array.get(prev_covariance, 3) + array.get(process_noise, 3)
    
    // Innovation
    innovation = price - (predicted_mean + predicted_speed * (price - predicted_mean))
    
    // Kalman gain calculation
    s = p11 + measurement_noise
    k1 = p11 / s
    k2 = p21 / s
    
    // State update
    current_mean = predicted_mean + k1 * innovation
    current_speed = predicted_speed + k2 * innovation
    
    // Covariance update
    c11 = (1 - k1) * p11
    c12 = (1 - k1) * p12
    c21 = -k2 * p11
    c22 = p22 - k2 * p21
    
    // Trading signal based on mean reversion
    deviation = price - current_mean
    signal = -current_speed * deviation  // Negative because we want to trade mean reversion
    
    [current_mean, current_speed, signal, array.from(c11, c12, c21, c22)]

// @function Initialize Model 4 parameters
export model4_initialize(float initial_price) =>
    initial_mean = initial_price
    initial_speed = 0.5  // Start with moderate mean reversion speed
    initial_covariance = array.from(1.0, 0.0, 0.0, 1.0)  // Identity matrix
    [initial_mean, initial_speed, initial_covariance]

// @function Create default process noise matrix for Model 4
export model4_default_process_noise() =>
    // Default process noise matrix with moderate values
    array.from(0.01, 0.0, 0.0, 0.01)

// @function Adaptive measurement noise calculation for Model 4
export model4_calculate_measurement_noise(float[] price_series, int length) =>
    // Calculate price changes
    float sum_squared_changes = 0.0
    for i = 1 to length - 1
        change = array.get(price_series, i) - array.get(price_series, i-1)
        sum_squared_changes := sum_squared_changes + change * change
    
    // Return variance of changes
    variance = sum_squared_changes / (length - 1)
    variance