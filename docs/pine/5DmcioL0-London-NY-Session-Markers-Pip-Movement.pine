//@version=6
indicator("London & NY Session Markers + Pip Movement", overlay=true)

// === User Inputs ===
showLondon    = input.bool(true, "Show London Session", group="Sessions")
showNY        = input.bool(true, "Show NY Session", group="Sessions")
showPipLabels = input.bool(true, "Show Pip Range Labels", group="Sessions")

// === Current Date Components ===
curYear  = year(time)
curMonth = month(time)
curDay   = dayofmonth(time)

// === Define Session Times in Europe/London timezone ===
londonOpen  = timestamp("Europe/London", curYear, curMonth, curDay, 8, 0)
londonClose = timestamp("Europe/London", curYear, curMonth, curDay, 11, 0)
nyOpen      = timestamp("Europe/London", curYear, curMonth, curDay, 14, 0)
nyClose     = timestamp("Europe/London", curYear, curMonth, curDay, 17, 0)

// === Helper Function to Detect Exact Time Match (session start/end) ===
isTime(sessionTime) =>
    sessionTime >= time[1] and sessionTime < time

// === Draw vertical dotted line and label ===
drawSessionLine(labelText, sessionTime, lineColor) =>
    if isTime(sessionTime)
        line.new(x1=bar_index, y1=low, x2=bar_index, y2=high, extend=extend.both, color=lineColor, style=line.style_dotted, width=1)
        label.new(x=bar_index, y=na, text=labelText, style=label.style_label_down, color=lineColor, textcolor=color.white, size=size.small)

// === Pip Conversion: 0.0001 for most pairs, 0.01 for JPY pairs ===
pipSize = syminfo.mintick == 0.01 ? 0.01 : 0.0001

// === Session Pip Range Variables ===
var float londonHigh = na
var float londonLow  = na
var float nyHigh     = na
var float nyLow      = na

// === London Session Tracking ===
if showLondon
    if isTime(londonOpen)
        londonHigh := high
        londonLow  := low

    if time >= londonOpen and time < londonClose
        londonHigh := na(londonHigh) ? high : math.max(londonHigh, high)
        londonLow  := na(londonLow) ? low : math.min(londonLow, low)

    if isTime(londonClose)
        if showPipLabels and not na(londonHigh) and not na(londonLow)
            pipRange = (londonHigh - londonLow) / pipSize
            label.new(x=bar_index, y=high, text="London: " + str.tostring(pipRange, format.mintick) + " pips", style=label.style_label_up, color=color.aqua, textcolor=color.black, size=size.normal)
        londonHigh := na
        londonLow := na

// === NY Session Tracking ===
if showNY
    if isTime(nyOpen)
        nyHigh := high
        nyLow  := low

    if time >= nyOpen and time < nyClose
        nyHigh := na(nyHigh) ? high : math.max(nyHigh, high)
        nyLow  := na(nyLow) ? low : math.min(nyLow, low)

    if isTime(nyClose)
        if showPipLabels and not na(nyHigh) and not na(nyLow)
            pipRange = (nyHigh - nyLow) / pipSize
            label.new(x=bar_index, y=high, text="NY: " + str.tostring(pipRange, format.mintick) + " pips", style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.normal)
        nyHigh := na
        nyLow := na

// === Session Lines ===
if showLondon
    drawSessionLine("London Open", londonOpen, color.aqua)
    drawSessionLine("London Close", londonClose, color.aqua)

if showNY
    drawSessionLine("NY Open", nyOpen, color.lime)
    drawSessionLine("NY Close", nyClose, color.lime)








