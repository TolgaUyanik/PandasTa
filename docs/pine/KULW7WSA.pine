//@version=6
indicator("THF Scalp & Trend + FVG + Ichimoku [Custom Colors 2]", "THF + FVG + Ichi", overlay = true, max_lines_count = 500, max_boxes_count = 500)

// =============================================================================
//  PART 1: Ultimate AIO Scalper & Trend PRO  [THF] V2.0
// =============================================================================

// --- THF Inputs ---

// 1. Moving Averages Settings (Length, Color, Width)
group_ma = "1. Moving Averages Settings"

// EMA 7 
lenEMA7   = input.int(7, title="Length EMA 7 (Scalp)", group=group_ma)
colEMA7   = input.color(color.yellow, title="Color EMA 7", group=group_ma) 
widEMA7   = input.int(1, title="Width EMA 7", minval=1, maxval=5, group=group_ma)

// EMA 21
lenEMA21  = input.int(21, title="Length EMA 21", group=group_ma)
colEMA21  = input.color(color.green, title="Color EMA 21", group=group_ma)
widEMA21  = input.int(2, title="Width EMA 21", minval=1, maxval=5, group=group_ma)

// EMA 50 
lenEMA50  = input.int(50, title="Length EMA 50", group=group_ma)
colEMA50  = input.color(color.new(#FF4500, 0), title="Color EMA 50", group=group_ma) 
widEMA50  = input.int(2, title="Width EMA 50", minval=1, maxval=5, group=group_ma)

// SMA 50
lenSMA50  = input.int(50, title="Length SMA 50", group=group_ma)
colSMA50  = input.color(color.red, title="Color SMA 50", group=group_ma)
widSMA50  = input.int(2, title="Width SMA 50", minval=1, maxval=5, group=group_ma)

// SMA 100
lenSMA100 = input.int(100, title="Length SMA 100", group=group_ma)
colSMA100 = input.color(color.blue, title="Color SMA 100", group=group_ma)
widSMA100 = input.int(2, title="Width SMA 100", minval=1, maxval=5, group=group_ma)

// SMA 200
lenSMA200 = input.int(200, title="Length SMA 200", group=group_ma)
colSMA200 = input.color(color.new(#0a9fea, 0), title="Color SMA 200", group=group_ma)
widSMA200 = input.int(2, title="Width SMA 200", minval=1, maxval=5, group=group_ma)

showEMA   = input.bool(true, title="Show EMAs?", group=group_ma)
showSMA   = input.bool(true, title="Show SMAs?", group=group_ma)

// 2. Trend & Major Crosses
group_cross = "2. Trend Signals & Crosses"
showTrendSignals = input.bool(true, title="Show Trend Signals (21/50)?", group=group_cross)
showGoldenDeath  = input.bool(true, title="Show Golden/Death Cross (50/200)?", group=group_cross)

// 3. Trend Filter (Default set to TRUE)
group_filter = "3. Trend Filter"
useTrendFilter = input.bool(true, title="Enable Trend Filter (SMA 200)?", tooltip="Only affects Scalp signals. Buy only above SMA 200, Sell below.", group=group_filter)

// 4. Momentum (RSI & MACD)
group_mom = "4. Momentum Indicators"
showRSIStart = input.bool(true, title="Show RSI Signals?", group=group_mom)
lenRSI       = input.int(14, title="RSI Length", group=group_mom)
showMACDStart= input.bool(true, title="Show MACD Signals?", group=group_mom)
fastLen      = input.int(12, title="MACD Fast Length", group=group_mom)
slowLen      = input.int(26, title="MACD Slow Length", group=group_mom)
sigLen       = input.int(9,  title="MACD Signal Length", group=group_mom)

// 5. Volume
group_vol = "5. Volume Settings"
volLength    = input.int(20, title="Volume SMA Length", group=group_vol)
useVolColors = input.bool(true, title="Color Bars based on Volume?", group=group_vol)

// 6. Ichimoku Cloud (Default FALSE)
group_ichi = "6. Ichimoku Cloud"
showIchi    = input.bool(false, title="Show Ichimoku Cloud?", group=group_ichi)
conversionPeriods = input.int(9, minval=1, title="Conversion Line Length", group=group_ichi)
basePeriods       = input.int(26, minval=1, title="Base Line Length", group=group_ichi)
laggingSpan2Periods = input.int(52, minval=1, title="Leading Span B Length", group=group_ichi)
displacement      = input.int(26, minval=1, title="Displacement", group=group_ichi)

// --- THF Calculations ---
ema7   = ta.ema(close, lenEMA7)
ema21  = ta.ema(close, lenEMA21)
ema50  = ta.ema(close, lenEMA50)
sma50  = ta.sma(close, lenSMA50)
sma100 = ta.sma(close, lenSMA100)
sma200 = ta.sma(close, lenSMA200)

rsiVal = ta.rsi(close, lenRSI)
rsiBuySignal = ta.crossover(rsiVal, 30)
rsiSellSignal = ta.crossunder(rsiVal, 70)

[macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, sigLen)
macdBuySignal  = ta.crossover(macdLine, signalLine)
macdSellSignal = ta.crossunder(macdLine, signalLine)

volSma = ta.sma(volume, volLength)

// --- Ichimoku Calculations ---
donchian(len) => math.avg(ta.lowest(len), ta.highest(len))
conversionLine = donchian(conversionPeriods)
baseLine = donchian(basePeriods)
leadLine1 = math.avg(conversionLine, baseLine)
leadLine2 = donchian(laggingSpan2Periods)

// --- THF Logic ---
scalpBuyCondition = ta.crossover(ema7, ema21)
scalpBuy = useTrendFilter ? (scalpBuyCondition and close > sma200) : scalpBuyCondition
scalpSellCondition = ta.crossunder(ema7, ema21)
scalpSell = useTrendFilter ? (scalpSellCondition and close < sma200) : scalpSellCondition

trendBuy = ta.crossover(ema21, sma50)
trendSell = ta.crossunder(ema21, sma50)

goldenCross = ta.crossover(sma50, sma200)
deathCross = ta.crossunder(sma50, sma200)

// --- THF Plotting (Using Custom Colors & Widths) ---
plot(showEMA ? ema7 : na, color=colEMA7, linewidth=widEMA7, title="EMA 7")
plot(showEMA ? ema21 : na, color=colEMA21, linewidth=widEMA21, title="EMA 21")
plot(showEMA ? ema50 : na, color=colEMA50, linewidth=widEMA50, title="EMA 50")
plot(showSMA ? sma50 : na, color=colSMA50, linewidth=widSMA50, title="SMA 50")
plot(showSMA ? sma100 : na, color=colSMA100, linewidth=widSMA100, title="SMA 100")
plot(showSMA ? sma200 : na, color=colSMA200, linewidth=widSMA200, title="SMA 200")

// --- Ichimoku Plotting ---
plot(showIchi ? conversionLine : na, color=color.new(#2962FF, 0), title="Tenkan-sen")
plot(showIchi ? baseLine : na, color=color.new(#B71C1C, 0), title="Kijun-sen")

p1 = plot(showIchi ? leadLine1 : na, offset = displacement - 1, color=color.new(#A5D6A7, 100), title="Senkou Span A")
p2 = plot(showIchi ? leadLine2 : na, offset = displacement - 1, color=color.new(#EF9A9A, 100), title="Senkou Span B")
fill(p1, p2, color = leadLine1 > leadLine2 ? color.new(color.green, 90) : color.new(color.red, 90), title="Kumo Cloud")

// --- Signals Plotting ---
plotshape(series=scalpBuy, location=location.belowbar, color=color.rgb(7, 235, 67), style=shape.triangleup, title="Scalp Buy", text="SCALP", textcolor=color.white, size=size.tiny)
plotshape(series=scalpSell, location=location.abovebar, color=color.rgb(255, 0, 0, 40), style=shape.triangledown, title="Scalp Sell", text="SCALP", textcolor=color.white, size=size.tiny)

plotshape(series=showTrendSignals and trendBuy, location=location.belowbar, color=color.green, style=shape.labelup, title="Trend Buy", text="BUY", textcolor=color.white, size=size.small)
plotshape(series=showTrendSignals and trendSell, location=location.abovebar, color=color.red, style=shape.labeldown, title="Trend Sell", text="SELL", textcolor=color.white, size=size.small)

plotshape(series=showGoldenDeath and goldenCross, location=location.belowbar, color=color.rgb(242, 181, 14), style=shape.labelup, title="Golden Cross", text="GOLDEN", textcolor=color.black, size=size.normal)
plotshape(series=showGoldenDeath and deathCross, location=location.abovebar, color=color.rgb(6, 135, 240), style=shape.labeldown, title="Death Cross", text="DEATH", textcolor=color.rgb(254, 254, 254), size=size.normal)

plotshape(showRSIStart and rsiBuySignal, location=location.belowbar, color=color.lime, style=shape.circle, title="RSI Buy", text="RSI", textcolor=color.lime, size=size.small)
plotshape(showRSIStart and rsiSellSignal, location=location.abovebar, color=color.fuchsia, style=shape.circle, title="RSI Sell", text="RSI", textcolor=color.fuchsia, size=size.small)
plotshape(showMACDStart and macdBuySignal, location=location.belowbar, color=color.aqua, style=shape.diamond, title="MACD Buy", text="MacD", textcolor=color.rgb(64, 167, 251),size=size.tiny)
plotshape(showMACDStart and macdSellSignal, location=location.abovebar, color=color.orange, style=shape.diamond, title="MACD Sell",text="MacD", textcolor=color.rgb(218, 165, 87), size=size.tiny)

volCondition = volume > volSma
bullColor = volCondition ? color.new(#089981, 0) : color.new(#089981, 60)
bearColor = volCondition ? color.new(#f23645, 0) : color.new(#f23645, 60)
barcolor(useVolColors ? (close >= open ? bullColor : bearColor) : na)

alertcondition(scalpBuy, title="Alert: Scalp Buy", message="Scalp Buy Signal")
alertcondition(scalpSell, title="Alert: Scalp Sell", message="Scalp Sell Signal")
alertcondition(trendBuy, title="Alert: Trend Buy", message="Trend Buy Signal (EMA 21 Cross Over SMA 50)")
alertcondition(trendSell, title="Alert: Trend Sell", message="Trend Sell Signal (EMA 21 Cross Under SMA 50)")


// =============================================================================
//  PART 2: Fair Value Gap [LuxAlgo]
// =============================================================================

group_fvg_thresh = "FVG - Threshold"
thresholdPer = input.float(0, "Threshold %", minval = 0, maxval = 100, step = .1, inline = 'threshold', group=group_fvg_thresh)
auto = input(false, "Auto", inline = 'threshold', group=group_fvg_thresh)

group_fvg_levels = "FVG - Levels"
showLast = input.int(0, 'Unmitigated Levels', minval = 0, group=group_fvg_levels)
mitigationLevels = input.bool(true, 'Mitigation Levels', group=group_fvg_levels)
tf = input.timeframe('', "Timeframe", group=group_fvg_levels)

group_fvg_style = 'FVG - Style'
extend = input.int(20, 'Extend', minval = 0, inline = 'extend', group = group_fvg_style)
dynamic = input(false, 'Dynamic', inline = 'extend', group = group_fvg_style)
bullCss = input.color(color.new(#089981, 70), "Bullish FVG", group = group_fvg_style)
bearCss = input.color(color.new(#f23645, 70), "Bearish FVG", group = group_fvg_style)

group_fvg_dash = 'FVG - Dashboard'
showDash  = input(true, 'Show Dashboard', group = group_fvg_dash)
dashLoc  = input.string('Top Right', 'Location', options = ['Top Right', 'Bottom Right', 'Bottom Left'], group = group_fvg_dash)
textSize = input.string('Small', 'Size'        , options = ['Tiny', 'Small', 'Normal']                 , group = group_fvg_dash)

type fvg
    float max
    float min
    bool  isbull
    int   t = time

n = bar_index
method tosolid(color id)=> color.rgb(color.r(id),color.g(id),color.b(id))

// --- FVG Function ---
detect()=>
    var new_fvg = fvg.new(na, na, bool(na)) 
    
    threshold = auto ? ta.cum((high - low) / low) / bar_index : thresholdPer / 100
    bull_fvg = low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > threshold
    bear_fvg = high < low[2] and close[1] < low[2] and (low[2] - high) / high > threshold
    
    if bull_fvg
        new_fvg := fvg.new(low, high[2], true)
    else if bear_fvg
        new_fvg := fvg.new(low[2], high, false)

    [bull_fvg, bear_fvg, new_fvg.max, new_fvg.min, new_fvg.isbull, new_fvg.t]

// --- FVG Calculation & Plots ---

var float max_bull_fvg = na, var float min_bull_fvg = na, var bull_count = 0, var bull_mitigated = 0
var float max_bear_fvg = na, var float min_bear_fvg = na, var bear_count = 0, var bear_mitigated = 0
var t = 0

var fvg_records = array.new<fvg>(0)
var fvg_areas = array.new<box>(0)

[bull_fvg, bear_fvg, n_max, n_min, n_isbull, n_t] = request.security(syminfo.tickerid, tf, detect())
new_fvg = fvg.new(n_max, n_min, n_isbull, n_t)

if bull_fvg and new_fvg.t != t
    if dynamic
        max_bull_fvg := new_fvg.max
        min_bull_fvg := new_fvg.min
    if not dynamic
        fvg_areas.unshift(box.new(n-2, new_fvg.max, n+extend, new_fvg.min, na, bgcolor = bullCss))
    fvg_records.unshift(new_fvg)
    bull_count += 1
    t := new_fvg.t
else if dynamic
    max_bull_fvg := math.max(math.min(close, max_bull_fvg), min_bull_fvg)

if bear_fvg and new_fvg.t != t
    if dynamic
        max_bear_fvg := new_fvg.max
        min_bear_fvg := new_fvg.min
    if not dynamic
        fvg_areas.unshift(box.new(n-2, new_fvg.max, n+extend, new_fvg.min, na, bgcolor = bearCss))
    fvg_records.unshift(new_fvg)
    bear_count += 1
    t := new_fvg.t
else if dynamic
    min_bear_fvg := math.min(math.max(close, min_bear_fvg), max_bear_fvg) 

// --- Mitigation Lines ---
if fvg_records.size() > 0
    for i = fvg_records.size()-1 to 0
        get = fvg_records.get(i)
        if get.isbull
            if close < get.min
                if mitigationLevels
                    line.new(get.t, get.min, time, get.min, xloc.bar_time, color = bullCss, style = line.style_dashed)
                if not dynamic
                    area = fvg_areas.remove(i)
                    area.delete()
                fvg_records.remove(i)
                bull_mitigated += 1
        else if close > get.max
            if mitigationLevels
                line.new(get.t, get.max, time, get.max, xloc.bar_time, color = bearCss, style = line.style_dashed)
            if not dynamic
                area = fvg_areas.remove(i)
                area.delete()
            fvg_records.remove(i)
            bear_mitigated += 1

var unmitigated = array.new<line>(0)
if barstate.islast and showLast > 0 and fvg_records.size() > 0
    if unmitigated.size() > 0 
        for element in unmitigated
            element.delete()
        unmitigated.clear()
    for i = 0 to math.min(showLast-1, fvg_records.size()-1)
        get = fvg_records.get(i)
        unmitigated.push(line.new(get.t, get.isbull ? get.min : get.max, time, get.isbull ? get.min : get.max, xloc.bar_time, color = get.isbull ? bullCss : bearCss))

// --- Dashboard ---
var table_position = dashLoc == 'Bottom Left' ? position.bottom_left : dashLoc == 'Top Right' ? position.top_right : position.bottom_right
var table_size = textSize == 'Tiny' ? size.tiny : textSize == 'Small' ? size.small : size.normal
var tb = table.new(table_position, 3, 3, bgcolor = #1e222d, border_color = #373a46, border_width = 1, frame_color = #373a46, frame_width = 1)

if showDash
    if barstate.isfirst
        tb.cell(1, 0, 'Bullish', text_color = bullCss.tosolid(), text_size = table_size)
        tb.cell(2, 0, 'Bearish', text_color = bearCss.tosolid(), text_size = table_size)
        tb.cell(0, 1, 'Count', text_size = table_size, text_color = color.white)
        tb.cell(0, 2, 'Mitigated', text_size = table_size, text_color = color.white)
    if barstate.islast
        tb.cell(1, 1, str.tostring(bull_count), text_color = bullCss.tosolid(), text_size = table_size)
        tb.cell(2, 1, str.tostring(bear_count), text_color = bearCss.tosolid(), text_size = table_size)
        tb.cell(1, 2, str.tostring(bull_mitigated / bull_count * 100, format.percent), text_color = bullCss.tosolid(), text_size = table_size)
        tb.cell(2, 2, str.tostring(bear_mitigated / bear_count * 100, format.percent), text_color = bearCss.tosolid(), text_size = table_size)

// --- Final Plots ---
max_bull_plot = plot(max_bull_fvg, color = na)
min_bull_plot = plot(min_bull_fvg, color = na)
fill(max_bull_plot, min_bull_plot, color = bullCss)

max_bear_plot = plot(max_bear_fvg, color = na)
min_bear_plot = plot(min_bear_fvg, color = na)
fill(max_bear_plot, min_bear_plot, color = bearCss)

alertcondition(bull_count > bull_count[1], 'FVG Bullish', 'Bullish FVG detected')
alertcondition(bear_count > bear_count[1], 'FVG Bearish', 'Bearish FVG detected')
alertcondition(bull_mitigated > bull_mitigated[1], 'FVG Bull Mitigation', 'Bullish FVG mitigated')
alertcondition(bear_mitigated > bear_mitigated[1], 'FVG Bear Mitigation', 'Bearish FVG mitigated')
