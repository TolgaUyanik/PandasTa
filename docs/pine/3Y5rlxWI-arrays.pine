is_empty(arr)=>na(arr) or arr.size()==0

// @function checks if an int array is either null or empty
// @param arr int array
// @returns bool
export method isEmpty(array<int> arr)=>is_empty(arr)

// @function checks if a float array is either null or empty
// @param arr float array
// @returns bool
export method isEmpty(array<float> arr)=>is_empty(arr)

// @function checks if a string array is either null or empty
// @param arr string array
// @returns bool
export method isEmpty(array<string> arr)=>is_empty(arr)

// @function checks if a bool array is either null or empty
// @param arr bool array
// @returns bool
export method isEmpty(array<bool> arr)=>is_empty(arr)

// @function checks if a color array is either null or empty
// @param arr color array
// @returns bool
export method isEmpty(array<color> arr)=>is_empty(arr)

// @function checks if a chart.point array is either null or empty
// @param arr chart.point array
// @returns bool
export method isEmpty(array<chart.point> arr)=>is_empty(arr)

// @function checks if a line array is either null or empty
