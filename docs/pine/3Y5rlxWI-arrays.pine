// @function checks if a table array is either null or empty
// @param arr table array
// @returns bool
export method isEmpty(array<table> arr)=>is_empty(arr)

is_not_empty(arr)=>not na(arr) and arr.size()>0

// @function checks if an int array is not null and has at least one item
// @param arr int array
// @returns bool
export method isNotEmpty(array<int> arr)=>is_not_empty(arr)

// @function checks if a float array is not null and has at least one item
// @param arr float array
// @returns bool
export method isNotEmpty(array<float> arr)=>is_not_empty(arr)

// @function checks if a string array is not null and has at least one item
