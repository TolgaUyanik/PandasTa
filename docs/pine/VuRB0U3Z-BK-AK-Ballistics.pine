//@version=6
indicator("BK AK-Ballistics", shorttitle = "⌖", overlay = true, max_bars_back = 500, behind_chart = false)

// ─── DISPLAY ────────────────────────────────────────────────────────────────
string i_pos      = input.string(position.bottom_left, '⚙ Position', options = [position.bottom_left, position.bottom_right, position.top_left, position.top_right, position.middle_left, position.middle_right], group = 'Display')
string i_heroSz   = input.string(size.normal, '⚙ Hero Size', options = [size.small, size.normal, size.large], group = 'Display')
string i_detailSz = input.string(size.small, '⚙ Detail Size', options = [size.tiny, size.small, size.normal], group = 'Display')
string i_theme    = input.string('ZENITH', '◉ Theme', options = ['ZENITH', 'ARCTIC', 'PHANTOM', 'SIGNAL', 'EMBER'], tooltip = 'ZENITH = Electric neon. Cyan + Crimson on black.\nARCTIC = Surgical steel. Ice blue + Blood red.\nPHANTOM = Dark precision. Sapphire + Magenta.\nSIGNAL = Military grade. Teal + Vermillion.\nEMBER = Warm edge. Sky blue + Deep amber.', group = 'Display')
string i_meter    = input.string('SURGE', '◉ Meter', options = ['POWER', 'DOMINANT', 'BLACKOUT', 'SPLIT', 'SURGE'], group = 'Display')
bool   i_showVA   = input.bool(true, '◆ POC / VA', group = 'Display')
bool   i_showImb  = input.bool(true, '⚖ Imbalance', group = 'Display')
bool   i_showCVD  = input.bool(true, 'Σ CVD', group = 'Display')

// ─── FOOTPRINT ──────────────────────────────────────────────────────────────
int   i_ticks     = input.int(100, 'Ticks Per Row', minval = 1, maxval = 500, group = 'Footprint')
int   i_vaPct     = input.int(70, 'Value Area %', minval = 50, maxval = 95, group = 'Footprint')
float i_imbThresh = input.float(20.0, 'Imbalance %', minval = 5.0, maxval = 80.0, step = 5.0, group = 'Footprint')

// ═══════════════════════════════════════════════════════════════════════════
//  THEME ENGINE — every color intentional
// ═══════════════════════════════════════════════════════════════════════════
//
//  ZENITH   — Electric neon. Cyan is authority, crimson is danger.
//             The flagship. Black void background. Colors burn.
//  ARCTIC   — Surgical. Ice blue = calculated, cherry red = precise cuts.
//             Clean, cold, institutional.
//  PHANTOM  — Deep sapphire + magenta-rose. Mysterious, high-end.
//             For the trader who sees what others miss.
//  SIGNAL   — Military teal + vermillion. Tactical, no-nonsense.
//             Green-tinged blue = confirmed, warm red = alert.
//  EMBER    — Cool sky blue + deep amber-red. Balanced warm/cool.
//             Calm readability, long session comfort.

// Buy accent
color T_buyC = switch i_theme
    'ZENITH'  => #00d4ff    // electric cyan — not generic, slightly warm
    'ARCTIC'  => #4fc3f7    // steel ice blue — cold, institutional
    'PHANTOM' => #448aff    // deep sapphire — rich, not neon
    'SIGNAL'  => #26a69a    // military teal — green-tinged confirmation
    'EMBER'   => #42a5f5    // sky blue — clear, calm, readable
    => #00d4ff

// Sell accent
color T_sellC = switch i_theme
    'ZENITH'  => #ff2d55    // apple crimson — sharper than orange, reads as danger
    'ARCTIC'  => #ef5350    // cherry red — clinical, precise
    'PHANTOM' => #f50057    // magenta-rose — electric pink-red
    'SIGNAL'  => #ff7043    // vermillion — warm, urgent, alert
    'EMBER'   => #e65100    // deep amber — warm burn, not aggressive
    => #ff2d55

// Background
color T_bg = switch i_theme
    'ZENITH'  => #000000    // true black — maximum contrast
    'ARCTIC'  => #020a10    // near-black blue tint — cold
    'PHANTOM' => #050510    // near-black purple tint — deep
    'SIGNAL'  => #040804    // near-black green tint — tactical
    'EMBER'   => #080400    // near-black warm tint — comfortable
    => #000000

// Header/secondary row bg
color T_hdr = switch i_theme
    'ZENITH'  => #08080f
    'ARCTIC'  => #081018
    'PHANTOM' => #0a0a18
    'SIGNAL'  => #080c08
    'EMBER'   => #100a04
    => #08080f

// Frame
color T_frame = switch i_theme
    'ZENITH'  => #0d47a1
    'ARCTIC'  => #1a3a50
    'PHANTOM' => #1a1a40
    'SIGNAL'  => #1a3028
    'EMBER'   => #3e2000
    => #0d47a1

// Label color — used for icons and identifiers
// NOT gold — each theme has its own premium accent
color T_labelC = switch i_theme
    'ZENITH'  => #e0e0e0    // platinum — clean, modern, not gold
    'ARCTIC'  => #b0bec5    // silver steel — matches the cold feel
    'PHANTOM' => #ce93d8    // soft violet — matches the deep palette
    'SIGNAL'  => #a5d6a7    // muted green — tactical, integrated
    'EMBER'   => #ffcc80    // warm cream — matches amber palette
    => #e0e0e0

// POC
color T_pocC = switch i_theme
    'ZENITH'  => #ffd740
    'ARCTIC'  => #ffb74d
    'PHANTOM' => #ffab40
    'SIGNAL'  => #ffd740
    'EMBER'   => #ffd740
    => #ffd740

// CVD
color T_cvdC = switch i_theme
    'ZENITH'  => #b388ff
    'ARCTIC'  => #80cbc4
    'PHANTOM' => #ea80fc
    'SIGNAL'  => #81d4fa
    'EMBER'   => #ffab91
    => #b388ff

// Dim text — secondary info
color T_dimC = switch i_theme
    'ZENITH'  => #546e7a
    'ARCTIC'  => #546e7a
    'PHANTOM' => #5c5070
    'SIGNAL'  => #4a6050
    'EMBER'   => #6d5040
    => #546e7a

// ─── DOMINANT GLOW SYSTEM ───────────────────────────────────────────────────
// Winner: 22% alpha = STRONG glow. The side is LIT.
// Loser:  88% alpha = barely visible. The side is OFF.
// This is not subtle. This is ON vs OFF.
int GLOW_ON  = 22
int GLOW_OFF = 88

// ═══════════════════════════════════════════════════════════════════════════
//  DATA ENGINE
// ═══════════════════════════════════════════════════════════════════════════

footprint fp = request.footprint(i_ticks, i_vaPct)
bool hasFP    = not na(fp)

float fpBuy   = hasFP ? fp.buy_volume()  : na
float fpSell  = hasFP ? fp.sell_volume() : na
float fpDelta = hasFP ? fp.delta()       : na
float fpTotal = hasFP ? nz(fpBuy) + nz(fpSell) : na

volume_row pocR = hasFP ? fp.poc() : na
volume_row vahR = hasFP ? fp.vah() : na
volume_row valR = hasFP ? fp.val() : na

float pocP = not na(pocR) ? math.avg(pocR.up_price(), pocR.down_price()) : na
float vahP = not na(vahR) ? math.avg(vahR.up_price(), vahR.down_price()) : na
float valP = not na(valR) ? math.avg(valR.up_price(), valR.down_price()) : na

float imbRatio = hasFP and nz(fpTotal) > 0 ? math.abs(nz(fpDelta)) / fpTotal * 100.0 : 0.0
bool  imbBuy   = hasFP and nz(fpDelta) > 0 and imbRatio > i_imbThresh
bool  imbSell  = hasFP and nz(fpDelta) < 0 and imbRatio > i_imbThresh

float _range   = high - low
float estBuy   = _range > 0 ? volume * (close - low) / _range : volume * 0.5
float estSell  = volume - estBuy
float estDelta = estBuy - estSell

float buyVol  = hasFP ? fpBuy   : estBuy
float sellVol = hasFP ? fpSell  : estSell
float delta   = hasFP ? fpDelta : estDelta
float totalV  = hasFP ? fpTotal : volume
float buyPct  = totalV > 0 ? nz(buyVol) / totalV * 100.0 : 50.0
float sellPct = 100.0 - buyPct
bool  buyWins = buyPct > sellPct

var float cvd = 0.0
if session.isfirstbar
    cvd := 0.0
if not na(delta)
    cvd += delta
bool cvdRising = cvd > nz(cvd[1])

float priceChg = ta.change(close)

// ═══════════════════════════════════════════════════════════════════════════
//  SESSION TRACKER — rolling context for strategic reads
// ═══════════════════════════════════════════════════════════════════════════

// Session bar counts
var int sessBars     = 0
var int sessBuyBars  = 0
var int sessSellBars = 0

// Streak tracking — consecutive bars one side dominates
var int buyStreak    = 0
var int sellStreak   = 0

// Delta streak — consecutive positive or negative delta
var int dPosStreak   = 0
var int dNegStreak   = 0

// Session cumulative buy/sell volume
var float sessBuyVol  = 0.0
var float sessSellVol = 0.0

// Session CVD extremes
var float cvdHigh    = 0.0
var float cvdLow     = 0.0

// Session price range
var float sessHigh   = high
var float sessLow    = low
var float sessOpen   = open

// POC migration — track last few POCs
var float prevPocP   = na

if session.isfirstbar
    sessBars     := 0
    sessBuyBars  := 0
    sessSellBars := 0
    buyStreak    := 0
    sellStreak   := 0
    dPosStreak   := 0
    dNegStreak   := 0
    sessBuyVol   := 0.0
    sessSellVol  := 0.0
    cvdHigh      := 0.0
    cvdLow       := 0.0
    sessHigh     := high
    sessLow      := low
    sessOpen     := open
    prevPocP     := na

sessBars += 1

if buyWins
    sessBuyBars += 1
    buyStreak   += 1
    sellStreak  := 0
else
    sessSellBars += 1
    sellStreak   += 1
    buyStreak    := 0

if delta >= 0
    dPosStreak += 1
    dNegStreak := 0
else
    dNegStreak += 1
    dPosStreak := 0

sessBuyVol  += nz(buyVol)
sessSellVol += nz(sellVol)
cvdHigh     := math.max(cvdHigh, cvd)
cvdLow      := math.min(cvdLow, cvd)
sessHigh    := math.max(sessHigh, high)
sessLow     := math.min(sessLow, low)

// Session-level buy %
float sessTotalVol = sessBuyVol + sessSellVol
float sessBuyPct   = sessTotalVol > 0 ? sessBuyVol / sessTotalVol * 100.0 : 50.0

// POC migration
float pocShift    = not na(prevPocP) and not na(pocP) ? pocP - prevPocP : 0.0
if not na(pocP)
    prevPocP := pocP

// ═══════════════════════════════════════════════════════════════════════════
//  DISPLAY
// ═══════════════════════════════════════════════════════════════════════════

fV(float v)  => str.tostring(v, format.volume)
fPc(float v) => str.tostring(v, '#.#') + '%'
fPr(float v) => str.tostring(v, format.mintick)
fD(float v)  => (v >= 0 ? '+' : '') + str.tostring(v, format.volume)

int NC = 10
int NR = 10

var table tb = table.new(i_pos, NC, NR, bgcolor = T_bg, frame_width = 2, frame_color = T_frame, border_width = 0)

if barstate.islast
    tb.clear(0, 0, NC - 1, NR - 1)
    int r = 0

    // ── Strategic intelligence from session tracking ───────
    float absImb   = math.abs(buyPct - 50.0)
    string domSide = buyWins ? 'BUYERS' : 'SELLERS'
    string weakSd  = buyWins ? 'Sellers' : 'Buyers'
    float vRatio   = buyVol > sellVol ? (sellVol > 0 ? buyVol / sellVol : 99.9) : (buyVol > 0 ? sellVol / buyVol : 99.9)
    string ratioS  = str.tostring(vRatio, '#.##') + ':1'
    bool priceUp   = priceChg > 0
    bool priceDn   = priceChg < 0
    bool deltaPos  = delta >= 0
    bool deltaNeg  = delta < 0
    float netV     = math.sign(priceChg) * totalV

    // Session context strings
    string sessCtx  = str.tostring(sessBars) + ' bars in session. ' + str.tostring(sessBuyBars) + ' buy-dominant / ' + str.tostring(sessSellBars) + ' sell-dominant.'
    string sessPctS = 'Session split: ' + fPc(sessBuyPct) + ' buy / ' + fPc(100.0 - sessBuyPct) + ' sell'

    // Streak reads
    string streakRead = buyStreak >= 5 ? 'BUY STREAK x' + str.tostring(buyStreak) + ' — Sustained buyer control. Pullback entries, not fade entries.' : sellStreak >= 5 ? 'SELL STREAK x' + str.tostring(sellStreak) + ' — Sustained seller control. Rally entries risky.' : buyStreak >= 3 ? 'Buy run x' + str.tostring(buyStreak) + ' — Momentum building. Watch for exhaustion.' : sellStreak >= 3 ? 'Sell run x' + str.tostring(sellStreak) + ' — Momentum building. Watch for exhaustion.' : 'No streak — mixed control. Choppy.'

    // Delta vs Price — THE signal
    string dvp = deltaPos and priceUp ? 'CONFIRMED BUY — aggression and price aligned.' : deltaPos and priceDn ? 'ABSORPTION — buying into weakness. Accumulation.' : deltaNeg and priceDn ? 'CONFIRMED SELL — aggression and price aligned.' : deltaNeg and priceUp ? 'DIVERGENCE — selling into strength. Distribution.' : 'FLAT.'

    // Delta streak context
    string dStreakRead = dPosStreak >= 4 ? 'Delta positive x' + str.tostring(dPosStreak) + ' bars straight — persistent buy aggression.' : dNegStreak >= 4 ? 'Delta negative x' + str.tostring(dNegStreak) + ' bars straight — persistent sell aggression.' : ''

    // CVD strategic
    float cvdRange = cvdHigh - cvdLow
    bool cvdNearHigh = cvdRange > 0 ? (cvd - cvdLow) / cvdRange > 0.8 : false
    bool cvdNearLow  = cvdRange > 0 ? (cvd - cvdLow) / cvdRange < 0.2 : false
    string cvdStrat = cvdNearHigh and priceDn ? 'CVD near session HIGH but price falling — ABSORPTION. Smart money buying this dip.' : cvdNearLow and priceUp ? 'CVD near session LOW but price rising — short squeeze. Move is fragile.' : cvdNearHigh and priceUp ? 'CVD near session HIGH with price up — full alignment. Trend is healthy.' : cvdNearLow and priceDn ? 'CVD near session LOW with price down — full alignment. Downtrend confirmed.' : 'CVD mid-range — no extreme positioning.'

    // POC migration
    string pocMig = pocShift > 0 ? 'POC migrating UP — auction moving higher. Bullish structure.' : pocShift < 0 ? 'POC migrating DOWN — auction moving lower. Bearish structure.' : 'POC unchanged — value accepted here.'

    // Price location in session range
    float sessRange = sessHigh - sessLow
    float priceLoc  = sessRange > 0 ? (close - sessLow) / sessRange * 100.0 : 50.0
    string priceLocS = priceLoc > 80 ? 'Price near SESSION HIGH (' + fPc(priceLoc) + '). Breakout or trap?' : priceLoc < 20 ? 'Price near SESSION LOW (' + fPc(priceLoc) + '). Capitulation or bounce?' : 'Price mid-session range (' + fPc(priceLoc) + ').'

    // ── Build strategic tooltips ────────────────────────────

    string buyTip = fV(buyVol) + ' ask-side (' + fPc(buyPct) + ') | ' + ratioS + '\n\n' + dvp + '\n\n' + streakRead + '\n' + sessCtx + '\n' + sessPctS + '\n\n' + priceLocS

    string sellTip = fV(sellVol) + ' bid-side (' + fPc(sellPct) + ') | ' + ratioS + '\n\n' + dvp + '\n\n' + streakRead + '\n' + sessCtx + '\n' + sessPctS + '\n\n' + priceLocS

    string meterTip = domSide + ' ' + ratioS + ' this bar\n' + sessPctS + '\n\n' + streakRead + '\n' + dvp

    string dTip = 'Delta: ' + fD(delta) + ' of ' + fV(totalV) + '\n\n' + dvp + '\n\n' + (dStreakRead != '' ? dStreakRead + '\n\n' : '') + sessCtx

    string nTip = 'Net: ' + fV(netV) + ' | Delta: ' + fD(delta) + '\n\n' + (deltaPos == (netV >= 0) ? 'Delta and Net AGREE — conviction.' : 'Delta and Net DISAGREE — suspect move.') + '\n\n' + priceLocS

    // ── DOMINANT GLOW — winner ON, loser OFF ────────────────

    // Backgrounds: winner = 22% (LIT), loser = 88% (DARK)
    color buyHBg  = color.new(T_buyC,  buyWins ? GLOW_ON     : GLOW_OFF)
    color sellHBg = color.new(T_sellC, buyWins ? GLOW_OFF    : GLOW_ON)
    color buyVBg  = color.new(T_buyC,  buyWins ? GLOW_ON + 5 : GLOW_OFF + 3)
    color sellVBg = color.new(T_sellC, buyWins ? GLOW_OFF + 3 : GLOW_ON + 5)

    // Text: winner = full bright accent, loser = heavily faded
    color bLbl = buyWins ? T_buyC  : color.new(T_buyC, 60)
    color sLbl = buyWins ? color.new(T_sellC, 60) : T_sellC
    color bPct = buyWins ? #ffffff : color.new(#ffffff, 60)
    color sPct = buyWins ? color.new(#ffffff, 60) : #ffffff
    color bVol = buyWins ? #ffffff : color.new(#ffffff, 55)
    color sVol = buyWins ? color.new(#ffffff, 55) : #ffffff

    // Row 1: labels + percentages
    tb.cell(0, r, '▲ BUY', text_color = bLbl, bgcolor = buyHBg, text_size = i_heroSz, text_halign = text.align_left, tooltip = buyTip)
    tb.merge_cells(0, r, 2, r)
    tb.cell(3, r, fPc(buyPct), text_color = bPct, bgcolor = buyHBg, text_size = i_heroSz, text_halign = text.align_right, tooltip = streakRead + '\n' + dvp)
    tb.merge_cells(3, r, 4, r)
    tb.cell(5, r, fPc(sellPct), text_color = sPct, bgcolor = sellHBg, text_size = i_heroSz, text_halign = text.align_left, tooltip = streakRead + '\n' + dvp)
    tb.merge_cells(5, r, 6, r)
    tb.cell(7, r, 'SELL ▼', text_color = sLbl, bgcolor = sellHBg, text_size = i_heroSz, text_halign = text.align_right, tooltip = sellTip)
    tb.merge_cells(7, r, NC - 1, r)
    r += 1

    // Row 2: volumes
    tb.cell(0, r, fV(buyVol), text_color = bVol, bgcolor = buyVBg, text_size = i_heroSz, text_halign = text.align_center, tooltip = buyTip)
    tb.merge_cells(0, r, 4, r)
    tb.cell(5, r, fV(sellVol), text_color = sVol, bgcolor = sellVBg, text_size = i_heroSz, text_halign = text.align_center, tooltip = sellTip)
    tb.merge_cells(5, r, NC - 1, r)
    r += 1

    // ── METER ───────────────────────────────────────────────

    int buyFill = math.round(buyPct / 100.0 * NC)
    int MID     = NC / 2

    for i = 0 to NC - 1
        bool isBuySide = i < buyFill
        color barC  = T_bg

        if i_meter == 'POWER'
            barC := isBuySide ? color.new(T_buyC, 0) : color.new(T_sellC, 0)
        else if i_meter == 'DOMINANT'
            if isBuySide
                barC := buyWins ? color.new(T_buyC, 0) : color.new(T_buyC, 50)
            else
                barC := buyWins ? color.new(T_sellC, 50) : color.new(T_sellC, 0)
        else if i_meter == 'BLACKOUT'
            if isBuySide
                barC := buyWins ? color.new(T_buyC, 0) : color.new(T_buyC, 85)
            else
                barC := buyWins ? color.new(T_sellC, 85) : color.new(T_sellC, 0)
        else if i_meter == 'SPLIT'
            bool inBuy  = i < buyFill and i < MID
            bool inSell = i >= buyFill and i >= MID
            barC := inBuy ? color.new(T_buyC, 0) : inSell ? color.new(T_sellC, 0) : color.new(T_dimC, 92)
        else if i_meter == 'SURGE'
            color winC  = buyWins ? T_buyC  : T_sellC
            color loseC = buyWins ? T_sellC : T_buyC
            if buyWins
                int lit = math.round(buyPct / 100.0 * MID)
                int start = MID - lit
                if i >= start and i < MID
                    int dist = MID - 1 - i
                    int maxD = math.max(lit - 1, 1)
                    barC := color.new(winC, math.round(dist * 25.0 / maxD))
                else if i < MID
                    barC := color.new(winC, 93)
                else
                    barC := color.new(loseC, 93)
            else
                int lit = math.round(sellPct / 100.0 * MID)
                int endC = MID + lit
                if i >= MID and i < endC
                    int dist = i - MID
                    int maxD = math.max(lit - 1, 1)
                    barC := color.new(winC, math.round(dist * 25.0 / maxD))
                else if i >= MID
                    barC := color.new(winC, 93)
                else
                    barC := color.new(loseC, 93)

        // % on edges — white on dark backgrounds, dark on bright
        string cTxt = ''
        color  cTxtC = #000000
        bool darkMode = i_meter == 'BLACKOUT' or i_meter == 'SURGE'
        if i == 0
            cTxt := fPc(buyPct)
            cTxtC := darkMode and not buyWins ? T_buyC : darkMode and buyWins ? #ffffff : #000000
        else if i == NC - 1
            cTxt := fPc(sellPct)
            cTxtC := darkMode and buyWins ? T_sellC : darkMode and not buyWins ? #ffffff : #ffffff

        tb.cell(i, r, cTxt, text_color = cTxtC, bgcolor = barC, text_size = i_heroSz, text_halign = text.align_center, tooltip = meterTip)
    r += 1

    // Scale
    for i = 0 to NC - 1
        string mark = ''
        color  mC   = T_dimC
        color  sBg  = i < MID ? color.new(T_buyC, 94) : color.new(T_sellC, 94)
        if i == 0
            mark := '0'
        else if i == 2
            mark := '25'
        else if i == 5
            mark := '50'
        else if i == 7
            mark := '75'
        else if i == NC - 1
            mark := '100'
        tb.cell(i, r, mark, text_color = mC, bgcolor = sBg, text_size = size.tiny, text_halign = text.align_center)
    r += 1

    // ── SECONDARY ───────────────────────────────────────────

    color dC = delta >= 0 ? T_buyC : T_sellC
    tb.cell(0, r, 'Δ', text_color = T_labelC, bgcolor = T_hdr, text_size = i_detailSz, text_halign = text.align_center, tooltip = dTip)
    tb.cell(1, r, fD(delta), text_color = dC, bgcolor = T_hdr, text_size = i_detailSz, text_halign = text.align_left, tooltip = dTip)
    tb.merge_cells(1, r, 4, r)
    tb.cell(5, r, 'Net', text_color = T_dimC, bgcolor = T_hdr, text_size = i_detailSz, text_halign = text.align_right, tooltip = nTip)
    tb.merge_cells(5, r, 6, r)
    tb.cell(7, r, fV(netV), text_color = dC, bgcolor = T_hdr, text_size = i_detailSz, text_halign = text.align_right, tooltip = nTip)
    tb.merge_cells(7, r, NC - 1, r)
    r += 1

    if i_showVA and not na(pocP)
        string pocVsPrice = pocP > close ? 'POC ABOVE price — overhead supply.' : pocP < close ? 'POC BELOW price — support underneath.' : 'POC AT price — sitting on fair value.'
        string pTip = 'POC: ' + fPr(pocP) + '\n\n' + pocVsPrice + '\n' + pocMig
        bool inVA = close <= vahP and close >= valP
        float vaWidth = vahP - valP
        string vaLocRead = inVA ? 'Price INSIDE VA — rotation until delta shifts.' : close > vahP ? 'Price ABOVE VA — upside exploration. Fails back in = fade.' : 'Price BELOW VA — downside exploration. Recovers back in = fade.'
        string vTip = 'VA: ' + fPr(vahP) + ' — ' + fPr(valP) + ' (' + fPr(vaWidth) + ' wide)\n\n' + vaLocRead + '\n\n' + priceLocS
        tb.cell(0, r, '◆', text_color = T_pocC, bgcolor = T_bg, text_size = i_detailSz, text_halign = text.align_center, tooltip = pTip)
        tb.cell(1, r, fPr(pocP), text_color = T_labelC, bgcolor = T_bg, text_size = i_detailSz, text_halign = text.align_left, tooltip = pTip)
        tb.merge_cells(1, r, 3, r)
        if not na(vahP) and not na(valP)
            tb.cell(4, r, '↑' + fPr(vahP), text_color = T_dimC, bgcolor = T_bg, text_size = i_detailSz, text_halign = text.align_right, tooltip = vTip)
            tb.merge_cells(4, r, 6, r)
            tb.cell(7, r, fPr(valP) + '↓', text_color = T_dimC, bgcolor = T_bg, text_size = i_detailSz, text_halign = text.align_right, tooltip = vTip)
            tb.merge_cells(7, r, NC - 1, r)
        else
            tb.cell(4, r, '', bgcolor = T_bg, text_size = i_detailSz)
            tb.merge_cells(4, r, NC - 1, r)
        r += 1

    bool hasImb = i_showImb and hasFP
    bool hasCvd = i_showCVD
    if hasImb or hasCvd
        if hasImb
            string imbI = imbBuy ? '▲' : imbSell ? '▼' : '—'
            color  imbC = imbBuy ? T_buyC : imbSell ? T_sellC : T_dimC
            string imbState = imbBuy ? 'BUY IMBALANCE at ' + fPc(imbRatio) + '. ' : imbSell ? 'SELL IMBALANCE at ' + fPc(imbRatio) + '. ' : 'BALANCED at ' + fPc(imbRatio) + '. '
            string iTip = imbState + dvp + '\n\n' + streakRead
            tb.cell(0, r, '⚖' + imbI, text_color = imbC, bgcolor = T_bg, text_size = i_detailSz, text_halign = text.align_left, tooltip = iTip)
            tb.merge_cells(0, r, 1, r)
            tb.cell(2, r, fPc(imbRatio), text_color = imbC, bgcolor = T_bg, text_size = i_detailSz, text_halign = text.align_left, tooltip = iTip)
            tb.merge_cells(2, r, 4, r)
        else
            tb.cell(0, r, '', bgcolor = T_bg, text_size = i_detailSz)
            tb.merge_cells(0, r, 4, r)
        if hasCvd
            color cvdC = cvdRising ? T_buyC : T_sellC
            string cvdA = cvdRising ? '▲' : '▼'
            string cTip = 'CVD: ' + fD(cvd) + ' (High: ' + fD(cvdHigh) + ' Low: ' + fD(cvdLow) + ')\n\n' + cvdStrat + '\n\n' + sessCtx
            tb.cell(5, r, 'Σ', text_color = T_labelC, bgcolor = T_bg, text_size = i_detailSz, text_halign = text.align_right, tooltip = cTip)
            tb.cell(6, r, fD(cvd), text_color = cvdC, bgcolor = T_bg, text_size = i_detailSz, text_halign = text.align_right, tooltip = cTip)
            tb.merge_cells(6, r, 8, r)
            tb.cell(9, r, cvdA, text_color = cvdC, bgcolor = T_bg, text_size = i_detailSz, text_halign = text.align_center, tooltip = cTip)
        else
            tb.cell(5, r, '', bgcolor = T_bg, text_size = i_detailSz)
            tb.merge_cells(5, r, NC - 1, r)
        r += 1

