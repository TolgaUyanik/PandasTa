//@version=6
library("MaidongOrderBlockRefiner", overlay = true)

export OBRefiner(string obType, string obRefine, string refineMethod, bool triggerCondition, int index) =>
    float atrValue = ta.atr(55)
    int posIndex = bar_index - index < 4499 ? bar_index - index : 2
    float rangeSeries = high - low
    float bodySeries = close - open

    var float proximal = 0.0
    var float distal = 0.0
    var float proximalRefined = 0.0
    var float distalRefined = 0.0

    var float minOpen = 0.0
    var float minHigh = 0.0
    var float minLow = 0.0
    var float minClose = 0.0
    var float maxOpen = 0.0
    var float maxHigh = 0.0
    var float maxLow = 0.0
    var float maxClose = 0.0

    float rangeCurrent = rangeSeries[posIndex]
    float rangeAfter = rangeSeries[posIndex + 1]
    float rangeBefore = rangeSeries[posIndex - 1]

    var float yp12 = 0.0
    var int xp1 = 0
    var int xp2 = 0
    var float yd12 = 0.0
    var int xd1 = 0
    var int xd2 = 0

    if obType == "Demand" and bar_index > 4
        if bar_index > index + 1
            minOpen := math.min(open[posIndex - 2], open[posIndex + 1], open[posIndex], open[posIndex - 1])
            minHigh := math.min(high[posIndex - 2], high[posIndex + 1], high[posIndex], high[posIndex - 1])
            minLow := math.min(low[posIndex - 2], low[posIndex + 1], low[posIndex], low[posIndex - 1])
            minClose := math.min(close[posIndex - 2], close[posIndex + 1], close[posIndex], close[posIndex - 1])
            maxOpen := math.max(open[posIndex - 2], open[posIndex + 1], open[posIndex], open[posIndex - 1])
            maxHigh := math.max(high[posIndex - 2], high[posIndex + 1], high[posIndex], high[posIndex - 1])
            maxLow := math.max(low[posIndex - 2], low[posIndex + 1], low[posIndex], low[posIndex - 1])
            maxClose := math.max(close[posIndex - 2], close[posIndex + 1], close[posIndex], close[posIndex - 1])
        else if bar_index == index + 1
            minOpen := math.min(open[posIndex + 1], open[posIndex], open[posIndex - 1])
            minHigh := math.min(high[posIndex + 1], high[posIndex], high[posIndex - 1])
            minLow := math.min(low[posIndex + 1], low[posIndex], low[posIndex - 1])
            minClose := math.min(close[posIndex + 1], close[posIndex], close[posIndex - 1])
            maxOpen := math.max(open[posIndex + 1], open[posIndex], open[posIndex - 1])
            maxHigh := math.max(high[posIndex + 1], high[posIndex], high[posIndex - 1])
            maxLow := math.max(low[posIndex + 1], low[posIndex], low[posIndex - 1])
            maxClose := math.max(close[posIndex + 1], close[posIndex], close[posIndex - 1])
        else if bar_index == index
            minOpen := math.min(open[posIndex + 1], open[posIndex])
            minHigh := math.min(high[posIndex + 1], high[posIndex])
            minLow := math.min(low[posIndex + 1], low[posIndex])
            minClose := math.min(close[posIndex + 1], close[posIndex])
            maxOpen := math.max(open[posIndex + 1], open[posIndex])
            maxHigh := math.max(high[posIndex + 1], high[posIndex])
            maxLow := math.max(low[posIndex + 1], low[posIndex])
            maxClose := math.max(close[posIndex + 1], close[posIndex])

        if rangeCurrent <= atrValue * 0.5
            proximal := high[posIndex]
            distal := minLow
        else if rangeCurrent <= atrValue
            if bodySeries > 0 or bodySeries == 0
                proximal := close[posIndex]
                distal := minLow
            else
                proximal := open[posIndex]
                distal := minLow
        else if bar_index > index
            if low[posIndex + 1] < high[posIndex]
                if low[posIndex + 1] > low[posIndex]
                    proximal := low[posIndex + 1]
                    distal := low[posIndex]
                else if bodySeries[posIndex + 1] >= 0
                    if rangeAfter > atrValue
                        proximal := maxOpen
                    else
                        proximal := maxClose
                    distal := minLow
                else
                    proximal := maxOpen
                    distal := minLow
            else if (minLow - minOpen) > (minLow - minClose) and (minLow - minOpen) <= atrValue and (minLow - minOpen) >= atrValue * 0.5
                proximal := minOpen
                distal := minLow
            else
                proximal := minClose
                distal := minLow
        else if rangeAfter > atrValue
            proximal := maxOpen
            distal := minLow
        else
            proximal := maxClose
            distal := minLow

        if refineMethod == "Defensive"
            float width = proximal - distal
            if width >= atrValue * 4
                distalRefined := distal
                proximalRefined := proximal - width * 0.8
            else if width >= atrValue * 3
                distalRefined := distal
                proximalRefined := proximal - width * 0.7
            else if width >= atrValue * 2
                distalRefined := distal
                proximalRefined := proximal - width * 0.6
            else if width >= atrValue * 1.6
                distalRefined := distal
                proximalRefined := proximal - width * 0.5
            else if width > atrValue
                distalRefined := distal
                proximalRefined := proximal - width * 0.25
            else
                distalRefined := distal
                proximalRefined := proximal
        else
            distalRefined := distal
            proximalRefined := proximal

        if triggerCondition
            yp12 := obRefine == "On" ? proximalRefined : high[posIndex]
            xp1 := index
            xp2 := index + 1
            yd12 := obRefine == "On" ? distalRefined : low[posIndex]
            xd1 := index
            xd2 := index + 1

    if obType == "Supply" and bar_index > 4
        if bar_index > index + 1
            minOpen := math.min(open[posIndex - 2], open[posIndex + 1], open[posIndex], open[posIndex - 1])
            minHigh := math.min(high[posIndex - 2], high[posIndex + 1], high[posIndex], high[posIndex - 1])
            minLow := math.min(low[posIndex - 2], low[posIndex + 1], low[posIndex], low[posIndex - 1])
            minClose := math.min(close[posIndex - 2], close[posIndex + 1], close[posIndex], close[posIndex - 1])
            maxOpen := math.max(open[posIndex - 2], open[posIndex + 1], open[posIndex], open[posIndex - 1])
            maxHigh := math.max(high[posIndex - 2], high[posIndex + 1], high[posIndex], high[posIndex - 1])
            maxLow := math.max(low[posIndex - 2], low[posIndex + 1], low[posIndex], low[posIndex - 1])
            maxClose := math.max(close[posIndex - 2], close[posIndex + 1], close[posIndex], close[posIndex - 1])
        else if bar_index == index + 1
            minOpen := math.min(open[posIndex + 1], open[posIndex], open[posIndex - 1])
            minHigh := math.min(high[posIndex + 1], high[posIndex], high[posIndex - 1])
            minLow := math.min(low[posIndex + 1], low[posIndex], low[posIndex - 1])
            minClose := math.min(close[posIndex + 1], close[posIndex], close[posIndex - 1])
            maxOpen := math.max(open[posIndex + 1], open[posIndex], open[posIndex - 1])
            maxHigh := math.max(high[posIndex + 1], high[posIndex], high[posIndex - 1])
            maxLow := math.max(low[posIndex + 1], low[posIndex], low[posIndex - 1])
            maxClose := math.max(close[posIndex + 1], close[posIndex], close[posIndex - 1])
        else if bar_index == index
            minOpen := math.min(open[posIndex + 1], open[posIndex])
            minHigh := math.min(high[posIndex + 1], high[posIndex])
            minLow := math.min(low[posIndex + 1], low[posIndex])
            minClose := math.min(close[posIndex + 1], close[posIndex])
            maxOpen := math.max(open[posIndex + 1], open[posIndex])
            maxHigh := math.max(high[posIndex + 1], high[posIndex])
            maxLow := math.max(low[posIndex + 1], low[posIndex])
            maxClose := math.max(close[posIndex + 1], close[posIndex])

        if rangeCurrent <= atrValue * 0.5
            proximal := low[posIndex]
            distal := maxHigh
        else if rangeCurrent <= atrValue
            if bodySeries > 0 or bodySeries == 0
                proximal := close[posIndex]
                distal := maxHigh
            else
                proximal := open[posIndex]
                distal := maxHigh
        else if bar_index > index
            if high[posIndex - 1] > low[posIndex]
                if high[posIndex - 1] > high[posIndex]
                    proximal := high[posIndex - 1]
                    distal := high[posIndex]
                else if bodySeries[posIndex - 1] >= 0
                    proximal := rangeAfter > atrValue ? minClose : minOpen
                    distal := maxHigh
                else
                    proximal := rangeAfter > atrValue ? minOpen : minClose
                    distal := maxHigh
            else if (maxHigh - minOpen) > (maxHigh - minClose) and (maxHigh - minOpen) <= atrValue and (maxHigh - minOpen) >= atrValue * 0.5
                proximal := minOpen
                distal := maxHigh
            else
                proximal := minClose
                distal := maxHigh
        else if rangeAfter > atrValue
            proximal := minClose
            distal := maxHigh
        else
            proximal := minOpen
            distal := maxHigh

        if refineMethod == "Defensive"
            float width = distal - proximal
            if width >= atrValue * 4
                distalRefined := distal
                proximalRefined := proximal + width * 0.8
            else if width >= atrValue * 3
                distalRefined := distal
                proximalRefined := proximal + width * 0.7
            else if width >= atrValue * 2
                distalRefined := distal
                proximalRefined := proximal + width * 0.6
            else if width >= atrValue * 1.6
                distalRefined := distal
                proximalRefined := proximal + width * 0.5
            else if width > atrValue
                distalRefined := distal
                proximalRefined := proximal + width * 0.25
            else
                distalRefined := distal
                proximalRefined := proximal
        else
            distalRefined := distal
            proximalRefined := proximal

        if triggerCondition
            yp12 := obRefine == "On" ? proximalRefined : low[posIndex]
            xp1 := index
            xp2 := index + 1
            yd12 := obRefine == "On" ? distalRefined : high[posIndex]
            xd1 := index
            xd2 := index + 1

    [xd1, xd2, yd12, xp1, xp2, yp12]
