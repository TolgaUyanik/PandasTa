//@version=5
indicator("Session Prep (RTH only, UTC-4)", overlay=true, max_labels_count=10)

posOffset = input.int(10, "Horizontal Position Offset", minval=-50, maxval=50)
myTZ = "America/New_York"

inRTH = not na(time(timeframe.period, "0930-1600:1234567", myTZ))
isRTHStart = inRTH and not inRTH[1]
isRTHEnd   = inRTH[1] and not inRTH

var float prevOpen  = na
var float prevHigh  = na
var float prevLow   = na
var float prevClose = na

var float sessOpen  = na
var float sessHigh  = na
var float sessLow   = na
var float sessClose = na

inPrevLastHour = not na(time(timeframe.period, "1500-1600:1234567", myTZ))
var float swingHigh = na
var float swingLow  = na

if isRTHStart
    sessOpen := open
    sessHigh := high
    sessLow  := low
    swingHigh := na
    swingLow := na

if inRTH
    sessHigh := na(sessHigh) ? high : math.max(sessHigh, high)
    sessLow  := na(sessLow)  ? low  : math.min(sessLow, low)
    sessClose := close

if isRTHEnd
    prevOpen  := sessOpen
    prevHigh  := sessHigh
    prevLow   := sessLow
    prevClose := sessClose
    sessOpen  := na
    sessHigh  := na
    sessLow   := na
    sessClose := na

if inPrevLastHour and inRTH
    swingHigh := na(swingHigh) ? high : math.max(swingHigh, high)
    swingLow  := na(swingLow)  ? low  : math.min(swingLow, low)

gap = na(sessOpen) or na(prevClose) ? na : sessOpen - prevClose
gapDir = na(gap) ? "" : gap > 0 ? "UP" : gap < 0 ? "DOWN" : "NONE"
gapText = na(gap) ? "Gap: n/a" : "Gap " + gapDir + ": " + str.tostring(gap, format.mintick)

fmt(x) => na(x) ? "n/a" : str.tostring(x, format.mintick)

labelText =
  "Prior Open: " + fmt(prevOpen) + "\n" +
  "Prior High: " + fmt(prevHigh) + "\n" +
  "Prior Low: " + fmt(prevLow) + "\n" +
  "Prior Close: " + fmt(prevClose) + "\n" +
  "Curr Open: " + fmt(sessOpen) + "\n" +
  "Prev Last Hour High: " + fmt(swingHigh) + "\n" +
  "Prev Last Hour Low: " + fmt(swingLow) + "\n" +
  gapText + "\n" +
  "Economic Reports: See Next Photo for Calendar"

var label prepLabel = na
if barstate.islast
    if not na(prepLabel)
        label.delete(prepLabel)
    prepLabel := label.new(bar_index + posOffset, high + (syminfo.mintick * 20), labelText, xloc.bar_index, yloc.price, color=color.blue, textcolor=color.white, size=size.small, style=label.style_label_left)