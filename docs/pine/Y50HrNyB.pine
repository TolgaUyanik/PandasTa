// --- START OF CODE --- (请从这里开始完整复制)

// © 2025 Google Gemini & User Collaboration
// v5: 直接合并两个指标，所有视觉元素独立显示，互不干涉。

//@version=5
indicator("EMA排列状态 + MACD零轴信号 [合并版]", shorttitle="多维度分析 v5", overlay=true)

// =========================================================================================
//                                 1. 输入参数 (INPUTS)
// =========================================================================================
string grp1 = "三条EMA趋势排列"
// 将原脚本中固定的数值改为可调整的输入参数
emaFastPeriod = input.int(50, title="快线 EMA 周期", group=grp1)
emaMidPeriod = input.int(100, title="中线 EMA 周期", group=grp1)
emaSlowPeriod = input.int(200, title="慢线 EMA 周期", group=grp1)

string grp2 = "MACD 零轴交叉"
// 使用您在之前脚本中定义的参数
macdFast = input.int(100, title="MACD 快线周期", group=grp2) 
macdSlow = input.int(26, title="MACD 慢线周期", group=grp2)
macdSignal = input.int(9, title="MACD 信号线周期", group=grp2)
macdTransparency = input.int(85, title="MACD背景透明度", minval=0, maxval=100, group=grp2)

string grp3 = "交易时段区间盒"
londonSession = input.session("0800-1600", "伦敦时段 (UTC)", group=grp3)
nySession = input.session("1300-2100", "纽约时段 (UTC)", group=grp3)
boxTransparency = input.int(90, "区间盒透明度", minval=0, maxval=100, group=grp3)

// =========================================================================================
//                                 2. 指标计算
// =========================================================================================
// --- 模块A: 计算EMA趋势排列 ---
emaF = ta.ema(close, emaFastPeriod)
emaM = ta.ema(close, emaMidPeriod)
emaS = ta.ema(close, emaSlowPeriod)
isBullishAlignment = emaF > emaM and emaM > emaS
isBearishAlignment = emaF < emaM and emaM < emaS

// --- 模块B: 计算MACD零轴交叉 ---
[macdLine, _, _] = ta.macd(close, macdFast, macdSlow, macdSignal)
crossAboveZero = ta.crossover(macdLine, 0)
crossBelowZero = ta.crossunder(macdLine, 0)

// --- 模块C: 计算交易时段 ---
isLondon = not na(time(timeframe.period, londonSession, "GMT+0"))
isLondonStart = isLondon and not isLondon[1]
isNY = not na(time(timeframe.period, nySession, "GMT+0"))
isNYStart = isNY and not isNY[1]

// =========================================================================================
//                                 3. 绘图层 (PLOTTING)
// =========================================================================================
// --- 绘制模块A: EMA均线和其趋势颜色 ---
color lineColor = isBullishAlignment ? color.new(color.blue, 0) : isBearishAlignment ? color.new(color.red, 0) : color.new(color.gray, 0)
plot(emaF, "EMA Fast", color=lineColor, linewidth=2)
plot(emaM, "EMA Mid", color=lineColor, linewidth=2)
plot(emaS, "EMA Slow", color=lineColor, linewidth=2)

// --- 绘制模块B: MACD相关图形 (背景色和信号) ---
var color bgColor = na
if crossAboveZero
    bgColor := color.new(color.red, macdTransparency)
if crossBelowZero
    bgColor := color.new(color.green, macdTransparency)
bgcolor(bgColor, title="MACD零轴穿越背景")

plotshape(crossAboveZero, title="MACD 卖出信号", text="卖出", location=location.abovebar, style=shape.labeldown, color=color.new(color.red, 0), textcolor=color.new(color.white, 0), size=size.normal)
plotshape(crossBelowZero, title="MACD 买入信号", text="买入", location=location.belowbar, style=shape.labelup, color=color.new(color.green, 0), textcolor=color.new(color.white, 0), size=size.normal)

// --- 绘制模块C: 交易时段区间盒 ---
var float londonHigh = na, var float londonLow = na, var box londonBox = na
if isLondonStart
    londonHigh := high, londonLow := low
    londonBox := box.new(bar_index, high, bar_index + 1, low, border_color=color.new(color.blue, 80), bgcolor=color.new(color.blue, boxTransparency))
else if isLondon
    londonHigh := math.max(high, londonHigh)
    londonLow := math.min(low, londonLow)
    box.set_top(londonBox, londonHigh)
    box.set_bottom(londonBox, londonLow)
    box.set_right(londonBox, bar_index + 1)

var float nyHigh = na, var float nyLow = na, var box nyBox = na
if isNYStart
    nyHigh := high, nyLow := low
    nyBox := box.new(bar_index, high, bar_index + 1, low, border_color=color.new(color.purple, 80), bgcolor=color.new(color.purple, boxTransparency))
else if isNY
    nyHigh := math.max(high, nyHigh)
    nyLow := math.min(low, nyLow)
    box.set_top(nyBox, nyHigh)
    box.set_bottom(nyBox, nyLow)
    box.set_right(nyBox, bar_index + 1)

// --- END OF CODE ---