//@version=6
indicator("Day Trade Setup - CRT Session Range Model", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=50)

// ======================
// Inputs
// ======================
displayMode = input.string("Light", "Theme Mode", options=["Light", "Dark"], group="Style")
setupSession = input.string("All", "Session Mode", options=["Dawn Range", "Morning Range", "Evening Range", "All"], display=display.none)
enableDawnPhase = setupSession == "Dawn Range" or setupSession == "All"
enableMorningPhase      = setupSession == "Morning Range" or setupSession == "All"
enableEveningPhase      = setupSession == "Evening Range" or setupSession == "All"
rangeExtendBars = input.int(5, "Setup Right Offset Bars", minval=1, maxval=100, display=display.none)
candleBodyWeight    = input.float(0.5, "Body Weight", minval=0.0, maxval=2.0, step=0.1, display=display.none)
candleWickWeight    = input.float(0.5, "Wick Weight", minval=0.0, maxval=2.0, step=0.1, display=display.none)

rangeLabelOffsetBars = input.int(0, "Setup Label Offset Bars", minval=0, maxval=100, display=display.none)
rangeLabelOffsetY = input.float(0.0, "Setup Label Y Offset", minval=0.0, step=0.1, display=display.none)

rangeLineWidth     = input.int(1, "Line Width", minval=1, maxval=5, display=display.none)
rangeLabelSizeInput  = input.string("normal", "Label Size", options=["tiny", "small", "normal", "large"], display=display.none)
rangeMidLineRatio   = input.float(1.0, "50% Line Length Ratio", minval=0.2, maxval=1.0, step=0.05, display=display.none)
chartBarMs = timeframe.in_seconds(timeframe.period) * 1000

useDarkPalette = displayMode == "Dark"

// Range Model
rangeBorderColor    = useDarkPalette ? color.white : color.black
rangeMidLineColor = useDarkPalette ? color.rgb(255, 255, 255, 60) : color.rgb(0, 0, 0, 80)
rangeTextColorTheme    = useDarkPalette ? color.white : color.black

// Imbalance Gap
gapBorderColor = useDarkPalette ? color.rgb(255, 255, 255, 35) : color.rgb(0, 0, 0, 80)
gapFillColor   = useDarkPalette ? color.rgb(180, 180, 180, 88) : color.rgb(120, 120, 120, 100)
gapMidColor    = useDarkPalette ? color.rgb(255, 255, 255, 45) : color.rgb(0, 0, 0, 80)
gapTextColorTheme   = useDarkPalette ? color.rgb(220, 220, 220) : color.rgb(0, 0, 0, 80)

// Structure
pivotHighColor = useDarkPalette ? color.rgb(255, 255, 255, 55) : color.rgb(0, 0, 0, 80)
pivotLowColor  = useDarkPalette ? color.rgb(255, 255, 255, 55) : color.rgb(0, 0, 0, 80)
pivotTextColorTheme = useDarkPalette ? color.rgb(220, 220, 220) : color.rgb(0, 0, 0, 80)

// Zone
zoneBorderColor = useDarkPalette ? color.rgb(255, 255, 255, 35) : color.rgb(0, 0, 0, 80)
zoneFillColor   = useDarkPalette ? color.rgb(180, 180, 180, 85) : color.rgb(120, 120, 120, 100)
zoneMidColor    = useDarkPalette ? color.rgb(255, 255, 255, 45) : color.rgb(0, 0, 0, 80)
zoneTextColorTheme   = useDarkPalette ? color.rgb(220, 220, 220) : color.rgb(0, 0, 0, 80)

// Execution
entryTextColorTheme = useDarkPalette ? color.white : color.rgb(40, 40, 40)

rangeLineColor    = rangeBorderColor
rangeMidLineColorFinal  = rangeMidLineColor
rangeTextColorFinal     = rangeTextColorTheme

// ======================
// Label size
// ======================
rangeLabelSizeFinal = rangeLabelSizeInput == "tiny" ? size.tiny : rangeLabelSizeInput == "small" ? size.small : rangeLabelSizeInput == "large" ? size.large : size.normal

// ======================
// Score function
// ======================
f_candleWeight(_o, _h, _l, _c) =>
    _body  = math.abs(_c - _o)
    _upper = _h - math.max(_o, _c)
    _lower = math.min(_o, _c) - _l
    _wick  = _upper + _lower
    (_body * candleBodyWeight) + (_wick * candleWickWeight)

// ======================
// Smart Setup Range selection on H1
// ======================
string setupTf = "60"

// ----- 1-5 AM: เลือกแท่งดีที่สุดใน 5 แท่ง -----
dawnHigh = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableDawnPhase and hour(time) == 5,
         (
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? high :
         (
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? high[1] :
         (
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? high[2] :
         (
             f_candleWeight(open[3], high[3], low[3], close[3]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? high[3] : high[4],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

dawnLow = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableDawnPhase and hour(time) == 5,
         (
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? low :
         (
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? low[1] :
         (
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? low[2] :
         (
             f_candleWeight(open[3], high[3], low[3], close[3]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? low[3] : low[4],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

dawnTime = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableDawnPhase and hour(time) == 5,
         (
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? time :
         (
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? time[1] :
         (
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? time[2] :
         (
             f_candleWeight(open[3], high[3], low[3], close[3]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? time[3] : time[4],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

dawnHour = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableDawnPhase and hour(time) == 5,
         (
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? hour(time) :
         (
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? hour(time[1]) :
         (
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? hour(time[2]) :
         (
             f_candleWeight(open[3], high[3], low[3], close[3]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? hour(time[3]) : hour(time[4]),
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
// ----- 1-5 AM: Setup open/close -----
dawnOpen = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableDawnPhase and hour(time) == 5,
         (
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? open :
         (
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? open[1] :
         (
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? open[2] :
         (
             f_candleWeight(open[3], high[3], low[3], close[3]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? open[3] : open[4],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

dawnClose = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableDawnPhase and hour(time) == 5,
         (
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open, high, low, close) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? close :
         (
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[2], high[2], low[2], close[2]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[1], high[1], low[1], close[1]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? close[1] :
         (
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[3], high[3], low[3], close[3]) and
             f_candleWeight(open[2], high[2], low[2], close[2]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? close[2] :
         (
             f_candleWeight(open[3], high[3], low[3], close[3]) >= f_candleWeight(open[4], high[4], low[4], close[4])
         ) ? close[3] : close[4],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)


// ----- 8-9 AM -----
morningHigh = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableMorningPhase and hour(time) == 9,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? high : high[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

morningLow = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableMorningPhase and hour(time) == 9,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? low : low[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

morningTime = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableMorningPhase and hour(time) == 9,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? time : time[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

morningHour = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableMorningPhase and hour(time) == 9,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? hour(time) : hour(time[1]),
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
// ----- 8-9 AM -----
morningOpen = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableMorningPhase and hour(time) == 9,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? open : open[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

morningClose = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableMorningPhase and hour(time) == 9,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? close : close[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
// ----- 8-9 PM -----
eveningHigh = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableEveningPhase and hour(time) == 21,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? high : high[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

eveningLow = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableEveningPhase and hour(time) == 21,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? low : low[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

eveningTime = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableEveningPhase and hour(time) == 21,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? time : time[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

eveningHour = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableEveningPhase and hour(time) == 21,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? hour(time) : hour(time[1]),
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

    // ----- 8-9 PM -----
eveningOpen = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableEveningPhase and hour(time) == 21,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? open : open[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

eveningClose = request.security(syminfo.tickerid, setupTf,
     ta.valuewhen(
         enableEveningPhase and hour(time) == 21,
         f_candleWeight(open, high, low, close) >= f_candleWeight(open[1], high[1], low[1], close[1]) ? close : close[1],
         0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ======================
// รวม Setup ล่าสุดจาก 3 ช่วง
// ======================
latestSetupTime = math.max(nz(dawnTime, 0), math.max(nz(morningTime, 0), nz(eveningTime, 0)))

setupHigh = latestSetupTime == nz(dawnTime, 0) ? dawnHigh : latestSetupTime == nz(morningTime, 0) ? morningHigh : eveningHigh
setupLow  = latestSetupTime == nz(dawnTime, 0) ? dawnLow  : latestSetupTime == nz(morningTime, 0) ? morningLow  : eveningLow
setupTime = latestSetupTime == nz(dawnTime, 0) ? dawnTime : latestSetupTime == nz(morningTime, 0) ? morningTime : eveningTime
setupHour = latestSetupTime == nz(dawnTime, 0) ? dawnHour : latestSetupTime == nz(morningTime, 0) ? morningHour : eveningHour
setupOpen  = latestSetupTime == nz(dawnTime, 0) ? dawnOpen  : latestSetupTime == nz(morningTime, 0) ? morningOpen  : eveningOpen
setupClose = latestSetupTime == nz(dawnTime, 0) ? dawnClose : latestSetupTime == nz(morningTime, 0) ? morningClose : eveningClose

setupBullish = not na(setupOpen) and not na(setupClose) and setupClose > setupOpen
setupBearish = not na(setupOpen) and not na(setupClose) and setupClose < setupOpen

setupMid = (setupHigh + setupLow) / 2.0
newSetup = ta.change(setupTime) != 0

// ======================
// Drawing objects
// ======================
var line  rangeLineHigh = na
var line  rangeLineMid = na
var line  rangeLineLow = na

var label rangeLabelHigh = na
var label rangeLabelMid = na
var label rangeLabelLow = na

// ======================
// Create once when Setup changes
// ======================
if newSetup and not na(setupHigh) and not na(setupLow) and not na(setupTime)
    if not na(rangeLineHigh)
        line.delete(rangeLineHigh)
    if not na(rangeLineMid)
        line.delete(rangeLineMid)
    if not na(rangeLineLow)
        line.delete(rangeLineLow)
    if not na(rangeLabelHigh)
        label.delete(rangeLabelHigh)
    if not na(rangeLabelMid)
        label.delete(rangeLabelMid)
    if not na(rangeLabelLow)
        label.delete(rangeLabelLow)

    int setupLeftTime  = int(setupTime)
    int setupRightTime = time + chartBarMs * rangeExtendBars
    int setupMidRight  = int(setupLeftTime + math.floor((setupRightTime - setupLeftTime) * rangeMidLineRatio))

    string setupTag = setupHour == 1 ? " Setup 1AM" : setupHour == 2 ? " Setup 2AM" : setupHour == 3 ? " Setup 3AM" : setupHour == 4 ? " Setup 4AM" : setupHour == 5 ? " Setup 5AM" : setupHour == 8 ? " Setup 8AM" : setupHour == 9 ? " Setup 9AM" : setupHour == 20 ? " Setup 8PM" : setupHour == 21 ? " Setup 9PM" : " Setup"

    rangeLineHigh := line.new(x1=setupLeftTime, y1=setupHigh, x2=setupRightTime, y2=setupHigh, xloc=xloc.bar_time, color=rangeLineColor, width=rangeLineWidth)
    rangeLineMid := line.new(x1=setupLeftTime, y1=setupMid,  x2=setupMidRight,  y2=setupMid,  xloc=xloc.bar_time, color=rangeMidLineColorFinal, width=rangeLineWidth, style=line.style_dashed)
    rangeLineLow := line.new(x1=setupLeftTime, y1=setupLow,  x2=setupRightTime, y2=setupLow,  xloc=xloc.bar_time, color=rangeLineColor, width=rangeLineWidth)

    rangeLabelHigh := label.new(bar_index + rangeLabelOffsetBars, setupHigh + rangeLabelOffsetY, setupTag + "-H", xloc=xloc.bar_index, style=label.style_label_left, textcolor=rangeTextColorFinal, color=na, size=rangeLabelSizeFinal)
    rangeLabelMid := label.new(bar_index + rangeLabelOffsetBars, setupMid  + rangeLabelOffsetY, "50%", xloc=xloc.bar_index, style=label.style_label_left, textcolor=rangeMidLineColorFinal, color=na, size=rangeLabelSizeFinal)
    rangeLabelLow := label.new(bar_index + rangeLabelOffsetBars, setupLow  - rangeLabelOffsetY, setupTag + "-L", xloc=xloc.bar_index, style=label.style_label_left, textcolor=rangeTextColorFinal, color=na, size=rangeLabelSizeFinal)
// ======================
// Update every bar
// ======================
if not na(setupHigh) and not na(setupLow) and not na(setupTime) and not na(rangeLineHigh)
    int setupLeftTime  = int(setupTime)
    int setupRightTime = time
    int setupMidRight  = int(setupLeftTime + math.floor((setupRightTime - setupLeftTime) * rangeMidLineRatio))

    line.set_xy1(rangeLineHigh, setupLeftTime, setupHigh)
    line.set_xy2(rangeLineHigh, setupRightTime, setupHigh)

    line.set_xy1(rangeLineMid, setupLeftTime, setupMid)
    line.set_xy2(rangeLineMid, setupMidRight, setupMid)

    line.set_xy1(rangeLineLow, setupLeftTime, setupLow)
    line.set_xy2(rangeLineLow, setupRightTime, setupLow)

    label.set_x(rangeLabelHigh, bar_index + rangeLabelOffsetBars)
    label.set_y(rangeLabelHigh, setupHigh + rangeLabelOffsetY)

    label.set_x(rangeLabelMid, bar_index + rangeLabelOffsetBars)
    label.set_y(rangeLabelMid, setupMid + rangeLabelOffsetY)

    label.set_x(rangeLabelLow, bar_index + rangeLabelOffsetBars)
    label.set_y(rangeLabelLow, setupLow - rangeLabelOffsetY)

// ======================
// Setup Alerts
// ======================
setupLabelText = setupHour == 1 ? " Setup 1AM" :
               setupHour == 2 ? " Setup 2AM" :
               setupHour == 3 ? " Setup 3AM" :
               setupHour == 4 ? " Setup 4AM" :
               setupHour == 5 ? " Setup 5AM" :
               setupHour == 8 ? " Setup 8AM" :
               setupHour == 9 ? " Setup 9AM" :
               setupHour == 20 ? " Setup 8PM" :
               setupHour == 21 ? " Setup 9PM" : "Setup"

// Alert condition
strategyName = setupSession == "Morning Range" or setupSession == "Evening Range" ? "Session Model" : setupSession == "Dawn Range" ? "Dawn Model" : "Day Trade Model"
setupHourText = setupHour > 12 ? str.tostring(setupHour - 12) + ":00PM" : str.tostring(setupHour) + ":00AM"

if newSetup
    alert("พบ Day Trade Setup ใหม่ " + syminfo.ticker + " | " + strategyName + " เวลา " + setupHourText + " | เตรียมหาจังหวะเข้าเทรด", alert.freq_once_per_bar_close)
// ======================
// Liquidity Sweep Add-on (Quality Filter)
// ใช้ร่วมกับ setupHigh / setupLow จาก Setup หลัก
// ======================
groupSweep = "Liquidity Sweep"

showSweep          = input.bool(true, "Show Liquidity Sweep", group=groupSweep, display=display.none)
useWickBreak    = input.bool(true, "Use Wick Break", group=groupSweep, display=display.none)
requireCloseReturn = input.bool(true, "Require Close Back Inside", group=groupSweep, display=display.none)
plotSweepShapes    = input.bool(true, "Plot Sweep Labels", group=groupSweep, display=display.none)

sweepMinRangeAtr     = input.float(0.5, "Min Range ATR", minval=0.1, step=0.1, group=groupSweep, display=display.none)
sweepMinWickRatio    = input.float(0.10, "Min Wick Ratio", minval=0.05, maxval=0.95, step=0.05, group=groupSweep, display=display.none)
sweepMinBodyRatio    = input.float(0.10, "Min Body Ratio", minval=0.05, maxval=0.95, step=0.05, group=groupSweep, display=display.none)
sweepCooldownBars    = input.int(10, "Cooldown Bars", minval=1, group=groupSweep, display=display.none)

// ----------------------
// Candle metrics
// ----------------------
volatilityAtr   = ta.atr(14)
candleRange   = high - low
candleBody   = math.abs(close - open)
candleUpperWick  = high - math.max(open, close)
candleLowerWick  = math.min(open, close) - low

rangeValid     = candleRange > volatilityAtr * sweepMinRangeAtr
bodyValid      = candleRange > 0 ? (candleBody / candleRange) >= sweepMinBodyRatio : false
upperWickValid = candleRange > 0 ? (candleUpperWick / candleRange) >= sweepMinWickRatio : false
lowerWickValid = candleRange > 0 ? (candleLowerWick / candleRange) >= sweepMinWickRatio : false

// ----------------------
// Base conditions
// ----------------------
breakAboveHigh = useWickBreak ? (high > setupHigh) : (close > setupHigh)
breakBelowLow  = useWickBreak ? (low < setupLow)   : (close < setupLow)

closeReturnBelow = close < setupHigh
closeReturnAbove = close > setupLow

// ----------------------
// Cooldown
// ----------------------
var int lastSweepBar = na
sweepAllowed = na(lastSweepBar) or (bar_index - lastSweepBar > sweepCooldownBars)

// ----------------------
// Quality TS conditions
// ----------------------
sweepSellSignal = showSweep and not na(setupHigh) and breakAboveHigh and (requireCloseReturn ? closeReturnBelow : true) and rangeValid and bodyValid and upperWickValid and sweepAllowed
sweepBuySignal  = showSweep and not na(setupLow)  and breakBelowLow  and (requireCloseReturn ? closeReturnAbove : true) and rangeValid and bodyValid and lowerWickValid and sweepAllowed

if sweepSellSignal or sweepBuySignal
    lastSweepBar := bar_index

// ----------------------
// Plot shapes
// ----------------------
plotshape(plotSweepShapes and sweepSellSignal, style=shape.labeldown, location=location.abovebar, color=na, text="𓆉", textcolor=rangeTextColorFinal, size=size.tiny, title="Liquidity Sweep Sell")
plotshape(plotSweepShapes and sweepBuySignal,  style=shape.labelup,   location=location.belowbar, color=na, text="𓆉", textcolor=rangeTextColorFinal, size=size.tiny, title="Liquidity Sweep Buy")



// ======================
// Imbalance Gap Zone from M15
// เลือก Gap ที่เกิดก่อน Setup ล่าสุด
// ======================
groupGap = "Imbalance Gap"

showGap         = input.bool(true, "Show Imbalance Gap", group=groupGap, display=display.none)
gapTf           = "15"
gapMode         = input.string("All", "Gap Mode", options=["All", "Bullish Only", "Bearish Only"], group=groupGap, display=display.none)
gapUseAtrFilter       = input.bool(true, "Use Min Size ATR Filter", group=groupGap, display=display.none)
gapMinAtr       = input.float(0.2, "Min Gap Size ATR", minval=0.0, step=0.05, group=groupGap, display=display.none)

gapNearSetupOnly  = input.bool(false, "Near Setup Only", group=groupGap, display=display.none)
gapNearAtr      = input.float(1.5, "Near Setup Distance ATR", minval=0.1, step=0.1, group=groupGap, display=display.none)

gapRightBars    = input.int(25, "Gap Right Offset Bars", minval=1, maxval=100, group=groupGap, display=display.none)
gapLabelOffsetBars  = input.int(25, "Gap Label Offset Bars", minval=1, maxval=100, group=groupGap, display=display.none)

gapBorderColorFinal  = gapBorderColor
gapFillColorFinal    = gapFillColor
gapMidColorFinal     = gapMidColor
gapTextColorFinal    = gapTextColorTheme
gapLabelSizeInput = input.string("small", "Gap Label Size", options=["tiny", "small", "normal", "large"], group=groupGap, display=display.none)

gapLabelSizeFinal = gapLabelSizeInput == "tiny" ? size.tiny : gapLabelSizeInput == "small" ? size.small : gapLabelSizeInput == "large" ? size.large : size.normal
allowGapUp = gapMode == "All" or gapMode == "Bullish Only"
allowGapDown = gapMode == "All" or gapMode == "Bearish Only"

gapVisibleOnTf = timeframe.isminutes and timeframe.multiplier >= 1 and timeframe.multiplier <= 15
// ----------------------
// M15 ล่าสุด / ย้อนหลัง 2 ตัว
// ----------------------
// Gap Up (Bullish)
[gapUpTop0, gapUpBot0, gapUpTime0, gapUpLeft0, gapUpTop1, gapUpBot1, gapUpTime1, gapUpLeft1, gapUpTop2, gapUpBot2, gapUpTime2, gapUpLeft2] = request.security(syminfo.tickerid, gapTf, [ta.valuewhen(low > high[2], low, 0), ta.valuewhen(low > high[2], high[2], 0), ta.valuewhen(low > high[2], time, 0), ta.valuewhen(low > high[2], time[1], 0), ta.valuewhen(low > high[2], low, 1), ta.valuewhen(low > high[2], high[2], 1), ta.valuewhen(low > high[2], time, 1), ta.valuewhen(low > high[2], time[1], 1), ta.valuewhen(low > high[2], low, 2), ta.valuewhen(low > high[2], high[2], 2), ta.valuewhen(low > high[2], time, 2), ta.valuewhen(low > high[2], time[1], 2)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
// Gap Down (Bearish)
[gapDownTop0, gapDownBot0, gapDownTime0, gapDownLeft0, gapDownTop1, gapDownBot1, gapDownTime1, gapDownLeft1, gapDownTop2, gapDownBot2, gapDownTime2, gapDownLeft2, gapAtr15] = request.security(syminfo.tickerid, gapTf, [ta.valuewhen(high < low[2], low[2], 0), ta.valuewhen(high < low[2], high, 0), ta.valuewhen(high < low[2], time, 0), ta.valuewhen(high < low[2], time[1], 0), ta.valuewhen(high < low[2], low[2], 1), ta.valuewhen(high < low[2], high, 1), ta.valuewhen(high < low[2], time, 1), ta.valuewhen(high < low[2], time[1], 1), ta.valuewhen(high < low[2], low[2], 2), ta.valuewhen(high < low[2], high, 2), ta.valuewhen(high < low[2], time, 2), ta.valuewhen(high < low[2], time[1], 2), ta.atr(14)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ----------------------
// Locked Gap storage
// ----------------------
var float gapLockTop = na
var float gapLockBot = na
var float gapLockMid = na
var int   gapLockLeft = na
var bool  gapLockIsUp = false

f_gapUpValid(_top, _bot, _time) =>
    _size = _top - _bot
    _mid  = (_top + _bot) / 2.0
    _atrOk = not na(_top) and (not gapUseAtrFilter or _size >= gapAtr15 * gapMinAtr)
    _nearOk = not gapNearSetupOnly or (not na(setupMid) and math.abs(_mid - setupMid) <= gapAtr15 * gapNearAtr)
    allowGapUp and not na(_time) and _time < setupTime and _atrOk and _nearOk

f_gapDownValid(_top, _bot, _time) =>
    _size = _top - _bot
    _mid  = (_top + _bot) / 2.0
    _atrOk = not na(_top) and (not gapUseAtrFilter or _size >= gapAtr15 * gapMinAtr)
    _nearOk = not gapNearSetupOnly or (not na(setupMid) and math.abs(_mid - setupMid) <= gapAtr15 * gapNearAtr)
    allowGapDown and not na(_time) and _time < setupTime and _atrOk and _nearOk

// ----------------------
// เลือก Gap ตอน Setup ใหม่เท่านั้น
// ----------------------
if showGap and gapVisibleOnTf and newSetup and not na(setupTime)
    gapLockTop  := na
    gapLockBot  := na
    gapLockMid  := na
    gapLockLeft := na
    gapLockIsUp := false

    int bestGapTime = na

    // Bull 0
    if f_gapUpValid(gapUpTop0, gapUpBot0, gapUpTime0)
        bestGapTime := int(gapUpTime0)
        gapLockTop := gapUpTop0
        gapLockBot := gapUpBot0
        gapLockMid := (gapUpTop0 + gapUpBot0) / 2.0
        gapLockLeft := int(gapUpLeft0)
        gapLockIsUp := true

    // Bull 1
    if f_gapUpValid(gapUpTop1, gapUpBot1, gapUpTime1) and (na(bestGapTime) or gapUpTime1 > bestGapTime)
        bestGapTime := int(gapUpTime1)
        gapLockTop := gapUpTop1
        gapLockBot := gapUpBot1
        gapLockMid := (gapUpTop1 + gapUpBot1) / 2.0
        gapLockLeft := int(gapUpLeft1)
        gapLockIsUp := true

    // Bull 2
    if f_gapUpValid(gapUpTop2, gapUpBot2, gapUpTime2) and (na(bestGapTime) or gapUpTime2 > bestGapTime)
        bestGapTime := int(gapUpTime2)
        gapLockTop := gapUpTop2
        gapLockBot := gapUpBot2
        gapLockMid := (gapUpTop2 + gapUpBot2) / 2.0
        gapLockLeft := int(gapUpLeft2)
        gapLockIsUp := true

    // Bear 0
    if f_gapDownValid(gapDownTop0, gapDownBot0, gapDownTime0) and (na(bestGapTime) or gapDownTime0 > bestGapTime)
        bestGapTime := int(gapDownTime0)
        gapLockTop := gapDownTop0
        gapLockBot := gapDownBot0
        gapLockMid := (gapDownTop0 + gapDownBot0) / 2.0
        gapLockLeft := int(gapDownLeft0)
        gapLockIsUp := false

    // Bear 1
    if f_gapDownValid(gapDownTop1, gapDownBot1, gapDownTime1) and (na(bestGapTime) or gapDownTime1 > bestGapTime)
        bestGapTime := int(gapDownTime1)
        gapLockTop := gapDownTop1
        gapLockBot := gapDownBot1
        gapLockMid := (gapDownTop1 + gapDownBot1) / 2.0
        gapLockLeft := int(gapDownLeft1)
        gapLockIsUp := false

    // Bear 2
    if f_gapDownValid(gapDownTop2, gapDownBot2, gapDownTime2) and (na(bestGapTime) or gapDownTime2 > bestGapTime)
        bestGapTime := int(gapDownTime2)
        gapLockTop := gapDownTop2
        gapLockBot := gapDownBot2
        gapLockMid := (gapDownTop2 + gapDownBot2) / 2.0
        gapLockLeft := int(gapDownLeft2)
        gapLockIsUp := false



// ----------------------
// Drawing objects
// ----------------------
var box   gapBox = na
var line  gapMidLine = na
var label gapLabel = na

f_gapMidOutsideSetup(_mid, _setupHigh, _setupLow) =>
    not na(_mid) and not na(_setupHigh) and not na(_setupLow) and (_mid > _setupHigh or _mid < _setupLow)

if showGap and gapVisibleOnTf and newSetup
    if not na(gapBox)
        box.delete(gapBox)
    if not na(gapMidLine)
        line.delete(gapMidLine)
    if not na(gapLabel)
        label.delete(gapLabel)

    if not na(gapLockTop) and not na(gapLockBot) and not na(gapLockLeft) and f_gapMidOutsideSetup(gapLockMid, setupHigh, setupLow)
        int setupRightTime = time + chartBarMs * gapRightBars

        gapBox := box.new(
             left = gapLockLeft,
             right = setupRightTime,
             top = gapLockTop,
             bottom = gapLockBot,
             xloc = xloc.bar_time,
             bgcolor = gapFillColorFinal,
             border_color = gapBorderColorFinal)

        gapMidLine := line.new(
             x1 = gapLockLeft,
             y1 = gapLockMid,
             x2 = setupRightTime,
             y2 = gapLockMid,
             xloc = xloc.bar_time,
             color = gapMidColorFinal,
             style = line.style_dashed,
             width = 1)

        gapLabel := label.new(
             x = bar_index + gapLabelOffsetBars,
             y = gapLockMid,
             text = "GAP-M15",
             xloc = xloc.bar_index,
             style = label.style_label_left,
             textcolor = gapTextColorFinal,
             color = na,
             size = gapLabelSizeFinal)

// ----------------------
// Extend right side only
// ----------------------
if showGap and gapVisibleOnTf and not na(gapBox)
    box.set_right(gapBox, time + chartBarMs * gapRightBars)
    line.set_x2(gapMidLine, time + chartBarMs * gapRightBars)
    label.set_x(gapLabel, bar_index + gapLabelOffsetBars)
    label.set_y(gapLabel, gapLockMid)





// ======================
// Structure High / Low from M15
// ใช้เฉพาะ Structure ที่เกิดก่อน Setup ล่าสุด
// ======================
groupStructure = "Structure Levels"

showStructureLevels   = input.bool(true, "Show Structure High/Low", group=groupStructure, display=display.none)
structureTf           = "15"
structureLen          = input.int(6, "Structure Length", minval=1, maxval=20, group=groupStructure, display=display.none)
structureRightBars    = input.int(25, "Structure Right Offset Bars", minval=1, maxval=100, group=groupStructure, display=display.none)
structureLabelOffsetBars  = input.int(25, "Structure Label Offset Bars", minval=1, maxval=100, group=groupStructure, display=display.none)

structureHighColor    = pivotHighColor
structureLowColor     = pivotLowColor
structureLineStyleInput = input.string("dashed", "Structure Line Style", options=["solid", "dashed", "dotted"], group=groupStructure, display=display.none)
structureTextColorFinal    = pivotTextColorTheme
structureLabelSizeInput = input.string("small", "Structure Label Size", options=["tiny", "small", "normal", "large"], group=groupStructure, display=display.none)

structureLabelSizeFinal = structureLabelSizeInput == "tiny" ? size.tiny : structureLabelSizeInput == "small" ? size.small : structureLabelSizeInput == "large" ? size.large : size.normal
structureLineStyleFinal = structureLineStyleInput == "solid" ? line.style_solid : structureLineStyleInput == "dotted" ? line.style_dotted : line.style_dashed

// ใช้ timeframe ปัจจุบันในการยืดเส้นไปทางขวา
structureBarMs = timeframe.in_seconds(timeframe.period) * 1000
structureVisibleOnTf = timeframe.isminutes and timeframe.multiplier >= 1 and timeframe.multiplier <= 15

// ----------------------
// M15 structure source
// ----------------------
structHighPrice0 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivothigh(high, structureLen, structureLen)), high[structureLen], 0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structHighTime0 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivothigh(high, structureLen, structureLen)), time[structureLen], 0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structHighPrice1 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivothigh(high, structureLen, structureLen)), high[structureLen], 1),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structHighTime1 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivothigh(high, structureLen, structureLen)), time[structureLen], 1),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structHighPrice2 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivothigh(high, structureLen, structureLen)), high[structureLen], 2),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structHighTime2 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivothigh(high, structureLen, structureLen)), time[structureLen], 2),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Low
structLowPrice0 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivotlow(low, structureLen, structureLen)), low[structureLen], 0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structLowTime0 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivotlow(low, structureLen, structureLen)), time[structureLen], 0),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structLowPrice1 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivotlow(low, structureLen, structureLen)), low[structureLen], 1),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structLowTime1 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivotlow(low, structureLen, structureLen)), time[structureLen], 1),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structLowPrice2 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivotlow(low, structureLen, structureLen)), low[structureLen], 2),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

structLowTime2 = request.security(
     syminfo.tickerid, structureTf,
     ta.valuewhen(not na(ta.pivotlow(low, structureLen, structureLen)), time[structureLen], 2),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ----------------------
// Locked structure storage
// ----------------------
var float structLockHigh = na
var int   structLockHighTime = na
var float structLockLow = na
var int   structLockLowTime = na

// ----------------------
// Lock structure only when Setup changes
// เลือก structure ล่าสุดที่อยู่ก่อน Setup
// ----------------------
if showStructureLevels and structureVisibleOnTf and newSetup and not na(setupTime)
    structLockHigh := na
    structLockHighTime := na
    structLockLow := na
    structLockLowTime := na

if showStructureLevels and structureVisibleOnTf and newSetup and not na(setupTime)
    structLockHigh := na
    structLockHighTime := na
    structLockLow := na
    structLockLowTime := na

    // HIGH -> ต้องอยู่เหนือ Setup
    if not na(structHighTime0) and structHighTime0 < setupTime and not na(structHighPrice0) and not na(setupHigh) and structHighPrice0 > setupHigh
        structLockHigh := structHighPrice0
        structLockHighTime := int(structHighTime0)
    else if not na(structHighTime1) and structHighTime1 < setupTime and not na(structHighPrice1) and not na(setupHigh) and structHighPrice1 > setupHigh
        structLockHigh := structHighPrice1
        structLockHighTime := int(structHighTime1)
    else if not na(structHighTime2) and structHighTime2 < setupTime and not na(structHighPrice2) and not na(setupHigh) and structHighPrice2 > setupHigh
        structLockHigh := structHighPrice2
        structLockHighTime := int(structHighTime2)

    // LOW -> ต้องอยู่ใต้ Setup
    if not na(structLowTime0) and structLowTime0 < setupTime and not na(structLowPrice0) and not na(setupLow) and structLowPrice0 < setupLow
        structLockLow := structLowPrice0
        structLockLowTime := int(structLowTime0)
    else if not na(structLowTime1) and structLowTime1 < setupTime and not na(structLowPrice1) and not na(setupLow) and structLowPrice1 < setupLow
        structLockLow := structLowPrice1
        structLockLowTime := int(structLowTime1)
    else if not na(structLowTime2) and structLowTime2 < setupTime and not na(structLowPrice2) and not na(setupLow) and structLowPrice2 < setupLow
        structLockLow := structLowPrice2
        structLockLowTime := int(structLowTime2)
// ----------------------
// Drawing objects
// ----------------------
var line  structHighLine = na
var line  structLowLine  = na
var label structHighLabel  = na
var label structLowLabel   = na

// ----------------------
// Create on new Setup
// ----------------------
if showStructureLevels and structureVisibleOnTf and newSetup
    if not na(structHighLine)
        line.delete(structHighLine)
    if not na(structLowLine)
        line.delete(structLowLine)
    if not na(structHighLabel)
        label.delete(structHighLabel)
    if not na(structLowLabel)
        label.delete(structLowLabel)

    int structureRightTime = time + structureBarMs * structureRightBars

    if not na(structLockHigh) and not na(structLockHighTime)
        structHighLine := line.new(
             x1 = structLockHighTime,
             y1 = structLockHigh,
             x2 = structureRightTime,
             y2 = structLockHigh,
             xloc = xloc.bar_time,
             color = structureHighColor,
             style = structureLineStyleFinal,
             width = 1)

        structHighLabel := label.new(
             x = bar_index + structureLabelOffsetBars,
             y = structLockHigh,
             text = "STRUCT-HIGH",
             xloc = xloc.bar_index,
             style = label.style_label_left,
             textcolor = structureTextColorFinal,
             color = na,
             size = structureLabelSizeFinal)

    if not na(structLockLow) and not na(structLockLowTime)
        structLowLine := line.new(
             x1 = structLockLowTime,
             y1 = structLockLow,
             x2 = structureRightTime,
             y2 = structLockLow,
             xloc = xloc.bar_time,
             color = structureLowColor,
             style = structureLineStyleFinal,
             width = 1)

        structLowLabel := label.new(
             x = bar_index + structureLabelOffsetBars,
             y = structLockLow,
             text = "STRUCT-LOW",
             xloc = xloc.bar_index,
             style = label.style_label_left,
             textcolor = structureTextColorFinal,
             color = na,
             size = structureLabelSizeFinal)

// ----------------------
// Extend right side every bar
// ----------------------
if showStructureLevels and structureVisibleOnTf and not na(structHighLine)
    line.set_x2(structHighLine, time + structureBarMs * structureRightBars)
    label.set_x(structHighLabel, bar_index + structureLabelOffsetBars)
    label.set_y(structHighLabel, structLockHigh)

if showStructureLevels and structureVisibleOnTf and not na(structLowLine)
    line.set_x2(structLowLine, time + structureBarMs * structureRightBars)
    label.set_x(structLowLabel, bar_index + structureLabelOffsetBars)
    label.set_y(structLowLabel, structLockLow)

// ----------------------
// Alerts
// ----------------------
alertcondition(showStructureLevels and newSetup and not na(structLockHigh), title="Old Structure High Before Setup", message="Old structure high before setup selected on {{ticker}}")
alertcondition(showStructureLevels and newSetup and not na(structLockLow), title="Old Structure Low Before Setup", message="Old structure low before setup selected on {{ticker}}")


// ======================
// Supply Demand Zone from M15
// เลือก Zone ที่เกิดก่อน Setup ล่าสุด
// ======================
groupZone = "Supply Demand Zone"

showZone          = input.bool(true, "Show Supply Demand Zone", group=groupZone, display=display.none)
zoneTf            = "15"
zoneMode          = input.string("All", "Zone Mode", options=["All", "Bullish Only", "Bearish Only"], group=groupZone, display=display.none)
zoneMinBodyRatio = input.float(0.4, "Zone Min Body Ratio", minval=0.1, maxval=1.0, step=0.05, group=groupZone, display=display.none)
zoneUseRangeFilter = input.bool(false, "Use Zone Range Filter", group=groupZone, display=display.none)
zoneMinRangeAtr = input.float(0.5, "Zone Min Range ATR", minval=0.1, step=0.1, group=groupZone, display=display.none)
zoneRightBars     = input.int(25, "Zone Right Offset Bars", minval=1, maxval=100, group=groupZone, display=display.none)
zoneLabelOffsetBars   = input.int(25, "Zone Label Offset Bars", minval=1, maxval=100, group=groupZone, display=display.none)

zoneNearSetupOnly   = input.bool(false, "Near Setup Only", group=groupZone, display=display.none)
zoneNearAtr       = input.float(3, "Near Setup Distance ATR", minval=0.1, step=0.1, group=groupZone, display=display.none)

zoneBorderColorFinal   = zoneBorderColor
zoneFillColorFinal     = zoneFillColor
zoneMidColorFinal      = zoneMidColor
zoneTextColorFinal     = zoneTextColorTheme
zoneLabelSizeInput  = input.string("small", "Zone Label Size", options=["tiny", "small", "normal", "large"], group=groupZone, display=display.none)

zoneLabelSizeFinal = zoneLabelSizeInput == "tiny" ? size.tiny : zoneLabelSizeInput == "small" ? size.small : zoneLabelSizeInput == "large" ? size.large : size.normal
allowDemandZone = zoneMode == "All" or zoneMode == "Bullish Only"
allowSupplyZone = zoneMode == "All" or zoneMode == "Bearish Only"

zoneVisibleOnTf = timeframe.isminutes and timeframe.multiplier >= 1 and timeframe.multiplier <= 15
zoneBarMs = timeframe.in_seconds(timeframe.period) * 1000

// ----------------------
// M15 source (ลด security ให้เหลือน้อย)
// ----------------------
f_getZoneData() =>
    zoneBody1 = math.abs(close[1] - open[1])
    zoneRange1 = high[1] - low[1]
    zoneBodyRatio1 = zoneRange1 > 0 ? zoneBody1 / zoneRange1 : 0.0
    zoneAtr1 = ta.atr(14)

    zoneStrongBody = zoneBodyRatio1 >= zoneMinBodyRatio
    rangeValid = not zoneUseRangeFilter or zoneRange1 >= zoneAtr1 * zoneMinRangeAtr

    isDemandCandle = close[1] < open[1] and close > high[1] and zoneStrongBody and rangeValid
    isSupplyCandle = close[1] > open[1] and close < low[1] and zoneStrongBody and rangeValid

    [ta.valuewhen(isDemandCandle, open[1], 0),
     ta.valuewhen(isDemandCandle, close[1], 0),
     ta.valuewhen(isDemandCandle, time[1], 0),

     ta.valuewhen(isDemandCandle, open[1], 1),
     ta.valuewhen(isDemandCandle, close[1], 1),
     ta.valuewhen(isDemandCandle, time[1], 1),

     ta.valuewhen(isDemandCandle, open[1], 2),
     ta.valuewhen(isDemandCandle, close[1], 2),
     ta.valuewhen(isDemandCandle, time[1], 2),

     ta.valuewhen(isSupplyCandle, close[1], 0),
     ta.valuewhen(isSupplyCandle, open[1], 0),
     ta.valuewhen(isSupplyCandle, time[1], 0),

     ta.valuewhen(isSupplyCandle, close[1], 1),
     ta.valuewhen(isSupplyCandle, open[1], 1),
     ta.valuewhen(isSupplyCandle, time[1], 1),

     ta.valuewhen(isSupplyCandle, close[1], 2),
     ta.valuewhen(isSupplyCandle, open[1], 2),
     ta.valuewhen(isSupplyCandle, time[1], 2),

     zoneAtr1]

[demandTop0, demandBot0, demandTime0,
 demandTop1, demandBot1, demandTime1,
 demandTop2, demandBot2, demandTime2,
 supplyTop0, supplyBot0, supplyTime0,
 supplyTop1, supplyBot1, supplyTime1,
 supplyTop2, supplyBot2, supplyTime2,
 zoneAtr15] = request.security(
     syminfo.tickerid, zoneTf, f_getZoneData(),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ----------------------
// Locked Zone storage
// ----------------------
var float zoneLockTop = na
var float zoneLockBot = na
var float zoneLockMid = na
var int   zoneLockTime = na
var bool  zoneLockIsDemand = false

f_demandZoneValid(_top, _bot, _time) =>
    _mid = (_top + _bot) / 2.0
    _nearOk = not zoneNearSetupOnly or (not na(setupMid) and math.abs(_mid - setupMid) <= zoneAtr15 * zoneNearAtr)

    // Setup เขียว -> หา Demand Zone ที่อยู่เหนือ Setup
    _positionOk = setupBullish and not na(setupHigh) and _bot > setupHigh

    allowDemandZone and not na(_time) and _time < setupTime and _nearOk and _positionOk


f_supplyZoneValid(_top, _bot, _time) =>
    _mid = (_top + _bot) / 2.0
    _nearOk = not zoneNearSetupOnly or (not na(setupMid) and math.abs(_mid - setupMid) <= zoneAtr15 * zoneNearAtr)

    // Setup แดง -> หา Supply Zone ที่อยู่ใต้ Setup
    _positionOk = setupBearish and not na(setupLow) and _top < setupLow

    allowSupplyZone and not na(_time) and _time < setupTime and _nearOk and _positionOk

// ----------------------
// เลือก Zone ตอน Setup ใหม่เท่านั้น
// ----------------------
if showZone and zoneVisibleOnTf and newSetup and not na(setupTime)
    zoneLockTop  := na
    zoneLockBot  := na
    zoneLockMid  := na
    zoneLockTime := na
    zoneLockIsDemand := false

    int bestZoneTime = na

    if f_demandZoneValid(demandTop0, demandBot0, demandTime0)
        bestZoneTime := int(demandTime0)
        zoneLockTop  := demandTop0
        zoneLockBot  := demandBot0
        zoneLockMid  := (demandTop0 + demandBot0) / 2.0
        zoneLockTime := int(demandTime0)
        zoneLockIsDemand := true

    if f_demandZoneValid(demandTop1, demandBot1, demandTime1) and (na(bestZoneTime) or demandTime1 > bestZoneTime)
        bestZoneTime := int(demandTime1)
        zoneLockTop  := demandTop1
        zoneLockBot  := demandBot1
        zoneLockMid  := (demandTop1 + demandBot1) / 2.0
        zoneLockTime := int(demandTime1)
        zoneLockIsDemand := true

    if f_demandZoneValid(demandTop2, demandBot2, demandTime2) and (na(bestZoneTime) or demandTime2 > bestZoneTime)
        bestZoneTime := int(demandTime2)
        zoneLockTop  := demandTop2
        zoneLockBot  := demandBot2
        zoneLockMid  := (demandTop2 + demandBot2) / 2.0
        zoneLockTime := int(demandTime2)
        zoneLockIsDemand := true

    if f_supplyZoneValid(supplyTop0, supplyBot0, supplyTime0) and (na(bestZoneTime) or supplyTime0 > bestZoneTime)
        bestZoneTime := int(supplyTime0)
        zoneLockTop  := supplyTop0
        zoneLockBot  := supplyBot0
        zoneLockMid  := (supplyTop0 + supplyBot0) / 2.0
        zoneLockTime := int(supplyTime0)
        zoneLockIsDemand := false

    if f_supplyZoneValid(supplyTop1, supplyBot1, supplyTime1) and (na(bestZoneTime) or supplyTime1 > bestZoneTime)
        bestZoneTime := int(supplyTime1)
        zoneLockTop  := supplyTop1
        zoneLockBot  := supplyBot1
        zoneLockMid  := (supplyTop1 + supplyBot1) / 2.0
        zoneLockTime := int(supplyTime1)
        zoneLockIsDemand := false

    if f_supplyZoneValid(supplyTop2, supplyBot2, supplyTime2) and (na(bestZoneTime) or supplyTime2 > bestZoneTime)
        bestZoneTime := int(supplyTime2)
        zoneLockTop  := supplyTop2
        zoneLockBot  := supplyBot2
        zoneLockMid  := (supplyTop2 + supplyBot2) / 2.0
        zoneLockTime := int(supplyTime2)
        zoneLockIsDemand := false

// ----------------------
// Drawing objects
// ----------------------
var box   zoneBox = na
var line  zoneMidLine = na
var label zoneLabel = na

// ----------------------
// Create on new Setup
// ----------------------
if showZone and zoneVisibleOnTf and newSetup
    if not na(zoneBox)
        box.delete(zoneBox)
    if not na(zoneMidLine)
        line.delete(zoneMidLine)
    if not na(zoneLabel)
        label.delete(zoneLabel)

    if not na(zoneLockTop) and not na(zoneLockBot) and not na(zoneLockTime)
        int zoneRightTime = time + zoneBarMs * zoneRightBars

        zoneBox := box.new(
             left = zoneLockTime,
             right = zoneRightTime,
             top = zoneLockTop,
             bottom = zoneLockBot,
             xloc = xloc.bar_time,
             bgcolor = zoneFillColorFinal,
             border_color = zoneBorderColorFinal)

        zoneMidLine := line.new(
             x1 = zoneLockTime,
             y1 = zoneLockMid,
             x2 = zoneRightTime,
             y2 = zoneLockMid,
             xloc = xloc.bar_time,
             color = zoneMidColorFinal,
             style = line.style_dashed,
             width = 1)

        zoneLabel := label.new(
             x = bar_index + zoneLabelOffsetBars,
             y = zoneLockMid,
             text = "ZONE-M15",
             xloc = xloc.bar_index,
             style = label.style_label_left,
             textcolor = zoneTextColorFinal,
             color = na,
             size = zoneLabelSizeFinal)

// ----------------------
// Extend right side
// ----------------------
if showZone and zoneVisibleOnTf and not na(zoneBox)
    box.set_right(zoneBox, time + zoneBarMs * zoneRightBars)
    line.set_x2(zoneMidLine, time + zoneBarMs * zoneRightBars)
    label.set_x(zoneLabel, bar_index + zoneLabelOffsetBars)
    label.set_y(zoneLabel, zoneLockMid)

// ----------------------
// Hide on TF > 15m
// ----------------------
if not zoneVisibleOnTf
    if not na(zoneBox)
        box.delete(zoneBox)
        zoneBox := na
    if not na(zoneMidLine)
        line.delete(zoneMidLine)
        zoneMidLine := na
    if not na(zoneLabel)
        label.delete(zoneLabel)
        zoneLabel := na

// ----------------------
// Alerts
// ----------------------
alertcondition(showZone and newSetup and not na(zoneLockTop) and zoneLockIsDemand, title="Demand Zone Before Setup", message="Demand zone before setup selected on {{ticker}}")
alertcondition(showZone and newSetup and not na(zoneLockTop) and not zoneLockIsDemand, title="Supply Zone Before Setup", message="Supply zone before setup selected on {{ticker}}")
