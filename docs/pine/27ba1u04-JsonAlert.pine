//@version=5
library("JsonAlert" , overlay = true, dynamic_requests = true)

export alarm ( array<string> keys , array<string> values , string freq )=>
    if array.size(keys) != array.size(values)
        runtime.error("Keys and values arrays must be the same length")
    msg = "{"
    for i = 0 to array.size(keys) - 1
        key = array.get(keys, i)
        val = array.get(values, i)
        msg := msg + "\"" + key + "\": \"" + str.tostring(val) + "\""
        if i < array.size(keys) - 1
            msg := msg + ","
    msg := msg + "}"
	
	if freq == alert.freq_all
    	alert(msg , alert.freq_all)
	else if freq == alert.freq_once_per_bar_close
    	alert(msg , alert.freq_once_per_bar_close)
	else if freq == alert.freq_once_per_bar
    	alert(msg , alert.freq_once_per_bar)
	else
		runtime.error("Wrong input for alert frequency")
