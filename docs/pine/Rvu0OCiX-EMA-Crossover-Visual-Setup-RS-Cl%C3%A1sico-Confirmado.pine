//@version=5
indicator("EMA Crossover Visual Setup (RS Clásico Confirmado)", overlay=true)

// === EMAs ===
ema10 = ta.ema(close, 10)
ema20 = ta.ema(close, 20)

// === Fuerza Relativa Clásica (vs SPY)
spy_price = request.security("SPY", timeframe.period, close)
rs = close / spy_price
rs_ma = ta.sma(rs, 20)

// === Condiciones del setup visual ===
ema_condition = ema10 > ema20
price_condition = close > ema20
rs_ok = rs > rs_ma  // Confirmación de fuerza relativa clásica

// === Setup confirmado cuando se cumplen las 3 condiciones
setup_confirmado = ema_condition and price_condition and rs_ok

// === Visualización en la gráfica
bgcolor(setup_confirmado ? color.new(color.green, 85) : na, title="Setup Confirmado")
plotshape(setup_confirmado and not setup_confirmado[1], title="Señal de Compra", location=location.belowbar, style=shape.labelup, text="Compra", size=size.small, color=color.green, textcolor=color.white)

// === Visualización de EMAs
plot(ema10, title="EMA 10", color=color.orange)
plot(ema20, title="EMA 20", color=color.blue)
