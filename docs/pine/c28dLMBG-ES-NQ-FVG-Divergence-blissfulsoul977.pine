//@version=6
indicator("ES & NQ FVG Divergence ETH/RTH", overlay=true, max_boxes_count=500)

// --- 1. Settings ---
gpEs       = "ES Plot Settings"
showEsBull = input.bool(true, "Show ES Bullish Gaps", group=gpEs)
showEsBear = input.bool(true, "Show ES Bearish Gaps", group=gpEs)
esBullCol  = input.color(color.new(color.green, 90), "ES Bull Color", group=gpEs)
esBearCol  = input.color(color.new(color.red, 90), "ES Bear Color", group=gpEs)

gpNq       = "NQ Plot Settings"
showNqBull = input.bool(true, "Show NQ Bullish Gaps", group=gpNq)
showNqBear = input.bool(true, "Show NQ Bearish Gaps", group=gpNq)
nqBullCol  = input.color(color.new(color.teal, 90), "NQ Bull Color", group=gpNq)
nqBearCol  = input.color(color.new(color.purple, 90), "NQ Bear Color", group=gpNq)

gpGlobal   = "Global Settings"
boxOffset  = input.int(20, "Extend Bars", minval=1, group=gpGlobal)

// --- 2. Interactive Calendar & Time Picker (Correct Form) ---
gpTime     = "Backtest Date & Time Window"
startTime  = input.time(defval=1767225600000, title="Start Date & Time", group=gpTime) // Jan 1, 2026
endTime    = input.time(defval=1798761540000, title="End Date & Time", group=gpTime) // Dec 31, 2026

// Check if the current candle falls exactly within your selected window
isInTimeWindow = (time >= startTime) and (time <= endTime)

// --- 3. Data Fetching ---
[esH0, esH2, esL0, esL2] = request.security("CME_MINI:ES1!", timeframe.period, [high, high[2], low, low[2]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[nqH0, nqH2, nqL0, nqL2] = request.security("CME_MINI:NQ1!", timeframe.period, [high, high[2], low, low[2]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// --- 4. Core FVG Conditions (Strictly filtered by the Time Window) ---
esBaseBull = (esL0 > esH2) and isInTimeWindow
esBaseBear = (esH0 < esL2) and isInTimeWindow
nqBaseBull = (nqL0 > nqH2) and isInTimeWindow
nqBaseBear = (nqH0 < nqL2) and isInTimeWindow

// Divergences
esBullDiv = esBaseBull and not nqBaseBull
esBearDiv = esBaseBear and not nqBaseBear

nqBullDiv = nqBaseBull and not esBaseBull
nqBearDiv = nqBaseBear and not esBaseBear

// --- 5. Storage Structure ---
type GapBox
    box   box_id
    int   creation_time

var GapBox[] gaps = array.new<GapBox>()

// --- 6. Plot & Store Gaps ---
// ES Gaps
if esBullDiv and showEsBull
    b = box.new(bar_index[2], esL0, bar_index + boxOffset, esH2, xloc=xloc.bar_index, bgcolor=esBullCol)
    array.push(gaps, GapBox.new(b, time[2]))

if esBearDiv and showEsBear
    b = box.new(bar_index[2], esL2, bar_index + boxOffset, esH0, xloc=xloc.bar_index, bgcolor=esBearCol)
    array.push(gaps, GapBox.new(b, time[2]))

// NQ Gaps
if nqBullDiv and showNqBull
    b = box.new(bar_index[2], nqL0, bar_index + boxOffset, nqH2, xloc=xloc.bar_index, bgcolor=nqBullCol)
    array.push(gaps, GapBox.new(b, time[2]))

if nqBearDiv and showNqBear
    b = box.new(bar_index[2], nqL2, bar_index + boxOffset, nqH0, xloc=xloc.bar_index, bgcolor=nqBearCol)
    array.push(gaps, GapBox.new(b, time[2]))

// --- 7. Extend Gaps Dynamically ---
if array.size(gaps) > 0
    for i = array.size(gaps) - 1 to 0 by 1
        GapBox currentGap = array.get(gaps, i)
        
        // Dynamically clear out any historical boxes if they fall completely outside the chosen calendar range
        if currentGap.creation_time < startTime or currentGap.creation_time > endTime
            box.delete(currentGap.box_id)
            array.remove(gaps, i)
        else
            if barstate.isnew
                box.set_right(currentGap.box_id, bar_index + boxOffset)