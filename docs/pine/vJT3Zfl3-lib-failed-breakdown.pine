//@version=6
// @description Failed breakdown/breakout detection using exhaustion levels.
// Adapted from Leledc Levels by InSilico: https://www.tradingview.com/script/jB2a9GAV-Leledc-levels-IS/
// Finds swing high/low exhaustion points as support/resistance, then detects
// when price breaks through but fails to hold (failed breakdown/breakout).
// Call via request.security() per timeframe.
library("lib_failed_breakdown", overlay=true)

// Lelec exhaustion detection - finds swing exhaustion points.
// Returns: -1 = bearish exhaustion (resistance at high), 1 = bullish exhaustion (support at low), 0 = none
export lelec(simple int bars, simple int len) =>
    var int bindex = 0
    var int sindex = 0
    int result = 0

    float highestHigh = ta.highest(high, len)
    float lowestLow   = ta.lowest(low, len)

    bindex := close > close[4] ? bindex + 1 : bindex
    sindex := close < close[4] ? sindex + 1 : sindex

    if bindex > bars and close < open and high >= highestHigh
        bindex := 0
        result := -1
    else if sindex > bars and close > open and low <= lowestLow
        sindex := 0
        result := 1

    result

// Check for failed breakdown and failed breakout signals using exhaustion levels.
// swing_len: lookback for highest/lowest (e.g. 40), exhaust_bars: min run length (e.g. 10),
// lookback: how many bars back to check for break attempts (e.g. 5)
// Returns: [failed_breakdown(1/0), failed_breakout(1/0), nearest_support, nearest_resistance]
export check_failed_signals(simple int swing_len, simple int exhaust_bars, simple int lookback) =>
    // Run Lelec to detect new exhaustion points
    int sig = lelec(exhaust_bars, swing_len)

    // Track last 5 resistance levels (exhaustion highs) and 5 support levels (exhaustion lows)
    var float res1 = na
    var float res2 = na
    var float res3 = na
    var float res4 = na
    var float res5 = na
    var float sup1 = na
    var float sup2 = na
    var float sup3 = na
    var float sup4 = na
    var float sup5 = na

    // Shift and store new resistance (bearish exhaustion = resistance at high)
    if sig == -1
        res5 := res4
        res4 := res3
        res3 := res2
        res2 := res1
        res1 := high

    // Shift and store new support (bullish exhaustion = support at low)
    if sig == 1
        sup5 := sup4
        sup4 := sup3
        sup3 := sup2
        sup2 := sup1
        sup1 := low

    // --- Failed Breakout Detection ---
    // Price broke ABOVE a resistance level within lookback bars, but now closed BELOW it
    float maxHigh = ta.highest(high, lookback + 1)
    float f_bo = 0.0

    if not na(res1) and maxHigh > res1 and close < res1
        f_bo := 1.0
    else if not na(res2) and maxHigh > res2 and close < res2
        f_bo := 1.0
    else if not na(res3) and maxHigh > res3 and close < res3
        f_bo := 1.0
    else if not na(res4) and maxHigh > res4 and close < res4
        f_bo := 1.0
    else if not na(res5) and maxHigh > res5 and close < res5
        f_bo := 1.0

    // --- Failed Breakdown Detection ---
    // Price broke BELOW a support level within lookback bars, but now closed ABOVE it
    float minLow = ta.lowest(low, lookback + 1)
    float f_bd = 0.0

    if not na(sup1) and minLow < sup1 and close > sup1
        f_bd := 1.0
    else if not na(sup2) and minLow < sup2 and close > sup2
        f_bd := 1.0
    else if not na(sup3) and minLow < sup3 and close > sup3
        f_bd := 1.0
    else if not na(sup4) and minLow < sup4 and close > sup4
        f_bd := 1.0
    else if not na(sup5) and minLow < sup5 and close > sup5
        f_bd := 1.0

    [f_bd, f_bo, nz(sup1), nz(res1)]
