//@version=5
indicator("ES Gap Trading Levels", shorttitle="ES Gap", overlay=true, max_lines_count=500)

// Input settings
show_labels = input.bool(true, "Show Labels", group="Display Settings")
line_width = input.int(2, "Line Width", minval=1, maxval=5, group="Display Settings")
extend_lines = input.string("Right", "Extend Lines", options=["Right", "Both", "None"], group="Display Settings")
debug_mode = input.bool(true, "Debug Mode (Show Time Info)", group="Debug")

// Color settings
color_10pt = input.color(color.white, "±10 Points Color", group="Colors")
color_20pt = input.color(color.new(color.blue, 0), "±20 Points Color", group="Colors")
color_30pt = input.color(color.red, "±30 Points Color", group="Colors")

// Manual closing price input
use_manual_close = input.bool(true, "Use Manual Closing Price", group="Manual Settings")
manual_close_price = input.float(6423.75, "Manual Closing Price", group="Manual Settings")

// ES point value
es_point = 1.0

// Get current time in ET
hour_et = hour(time, "America/New_York")
minute_et = minute(time, "America/New_York")
day_of_week = dayofweek(time, "America/New_York")

// Time functions
is_market_close() =>
    (hour_et == 15 and minute_et >= 59) or (hour_et == 16 and minute_et == 0)

should_show_gap_levels() =>
    if day_of_week == dayofweek.saturday
        false
    else if (hour_et > 9 and hour_et < 16) or (hour_et == 9 and minute_et >= 30)
        false
    else
        true

// Day calculation
get_day_id() =>
    year(time, "America/New_York") * 1000 + month(time, "America/New_York") * 100 + dayofmonth(time, "America/New_York")

// Variables
var float stored_closing_price = na
var int last_close_capture_day = na
var line[] gap_lines = array.new<line>()
var label[] gap_labels = array.new<label>()
var bool levels_drawn = false

// Current day calculation
current_day = get_day_id()

// Capture closing price logic - handle weekend properly
if use_manual_close
    // For manual mode, we need to determine which day's close to use
    if day_of_week == dayofweek.saturday or day_of_week == dayofweek.sunday
        // Weekend - use Friday's close, but only update if we haven't set Friday's close yet
        friday_day = current_day - (day_of_week == dayofweek.saturday ? 1 : 2)
        if na(last_close_capture_day) or last_close_capture_day < friday_day
            stored_closing_price := manual_close_price
            last_close_capture_day := friday_day
    else
        // Weekday - use current day's close
        if na(last_close_capture_day) or last_close_capture_day != current_day
            stored_closing_price := manual_close_price
            last_close_capture_day := current_day
else if is_market_close() and (na(last_close_capture_day) or last_close_capture_day != current_day)
    stored_closing_price := close
    last_close_capture_day := current_day

// Calculate gap levels
gap_up_10 = not na(stored_closing_price) ? stored_closing_price + (10 * es_point) : na
gap_down_10 = not na(stored_closing_price) ? stored_closing_price - (10 * es_point) : na
gap_up_20 = not na(stored_closing_price) ? stored_closing_price + (20 * es_point) : na
gap_down_20 = not na(stored_closing_price) ? stored_closing_price - (20 * es_point) : na
gap_up_30 = not na(stored_closing_price) ? stored_closing_price + (30 * es_point) : na
gap_down_30 = not na(stored_closing_price) ? stored_closing_price - (30 * es_point) : na

// Function to clear lines and labels
clear_lines_and_labels() =>
    if array.size(gap_lines) > 0
        for i = 0 to array.size(gap_lines) - 1
            line.delete(array.get(gap_lines, i))
        array.clear(gap_lines)
    
    if array.size(gap_labels) > 0
        for i = 0 to array.size(gap_labels) - 1
            label.delete(array.get(gap_labels, i))
        array.clear(gap_labels)

// Show/hide levels logic
show_levels_now = should_show_gap_levels() and not na(stored_closing_price)

// Draw gap levels
if show_levels_now and not levels_drawn
    // Clear previous lines
    clear_lines_and_labels()
    
    // Draw lines
    line_up_30 = line.new(bar_index - 10, gap_up_30, bar_index + 200, gap_up_30, 
                         color=color_30pt, width=line_width, style=line.style_solid, extend=extend.right)
    line_down_30 = line.new(bar_index - 10, gap_down_30, bar_index + 200, gap_down_30, 
                           color=color_30pt, width=line_width, style=line.style_solid, extend=extend.right)
    
    line_up_20 = line.new(bar_index - 10, gap_up_20, bar_index + 200, gap_up_20, 
                         color=color_20pt, width=line_width, style=line.style_solid, extend=extend.right)
    line_down_20 = line.new(bar_index - 10, gap_down_20, bar_index + 200, gap_down_20, 
                           color=color_20pt, width=line_width, style=line.style_solid, extend=extend.right)
    
    line_up_10 = line.new(bar_index - 10, gap_up_10, bar_index + 200, gap_up_10, 
                         color=color_10pt, width=line_width, style=line.style_solid, extend=extend.right)
    line_down_10 = line.new(bar_index - 10, gap_down_10, bar_index + 200, gap_down_10, 
                           color=color_10pt, width=line_width, style=line.style_solid, extend=extend.right)
    
    // Store lines
    array.push(gap_lines, line_up_10)
    array.push(gap_lines, line_down_10)
    array.push(gap_lines, line_up_20)
    array.push(gap_lines, line_down_20)
    array.push(gap_lines, line_up_30)
    array.push(gap_lines, line_down_30)
    
    // Add labels
    if show_labels
        label_30_up = label.new(bar_index, gap_up_30, "+30", color=color.new(color_30pt, 80), 
                      textcolor=color_30pt, style=label.style_label_down, size=size.small)
        label_20_up = label.new(bar_index, gap_up_20, "+20", color=color.new(color_20pt, 80), 
                      textcolor=color_20pt, style=label.style_label_down, size=size.small)
        label_10_up = label.new(bar_index, gap_up_10, "+10", color=color.new(color_10pt, 80), 
                      textcolor=color_10pt, style=label.style_label_down, size=size.small)
        label_10_down = label.new(bar_index, gap_down_10, "-10", color=color.new(color_10pt, 80), 
                      textcolor=color_10pt, style=label.style_label_up, size=size.small)
        label_20_down = label.new(bar_index, gap_down_20, "-20", color=color.new(color_20pt, 80), 
                      textcolor=color_20pt, style=label.style_label_up, size=size.small)
        label_30_down = label.new(bar_index, gap_down_30, "-30", color=color.new(color_30pt, 80), 
                      textcolor=color_30pt, style=label.style_label_up, size=size.small)
        
        array.push(gap_labels, label_30_up)
        array.push(gap_labels, label_20_up)
        array.push(gap_labels, label_10_up)
        array.push(gap_labels, label_10_down)
        array.push(gap_labels, label_20_down)
        array.push(gap_labels, label_30_down)
    
    levels_drawn := true

// Clear levels when they shouldn't be shown
if not show_levels_now and levels_drawn
    clear_lines_and_labels()
    levels_drawn := false

// Plot closing price reference line
plot_closing_line = input.bool(true, "Show Closing Price Reference", group="Display Settings")
plot(plot_closing_line and not na(stored_closing_price) and show_levels_now ? stored_closing_price : na, 
     "Closing Price", color=color.yellow, linewidth=1, style=plot.style_line)

// Debug table
if debug_mode
    var table debug_table = table.new(position.top_left, 2, 9, bgcolor=color.new(color.black, 80), border_width=1)
    
    if barstate.islast
        table.cell(debug_table, 0, 0, "Current Time ET", text_color=color.white)
        table.cell(debug_table, 1, 0, str.tostring(hour_et) + ":" + str.tostring(minute_et), text_color=color.white)
        
        table.cell(debug_table, 0, 1, "Day of Week", text_color=color.white)
        table.cell(debug_table, 1, 1, str.tostring(day_of_week) + " (1=Sun,2=Mon...7=Sat)", text_color=color.white)
        
        table.cell(debug_table, 0, 2, "Should Show Levels", text_color=color.white)
        table.cell(debug_table, 1, 2, str.tostring(should_show_gap_levels()), text_color=color.white)
        
        table.cell(debug_table, 0, 3, "Current Day", text_color=color.white)
        table.cell(debug_table, 1, 3, str.tostring(current_day), text_color=color.white)
        
        table.cell(debug_table, 0, 4, "Friday Day Calc", text_color=color.white)
        friday_calc = day_of_week == dayofweek.saturday ? current_day - 1 : (day_of_week == dayofweek.sunday ? current_day - 2 : current_day)
        table.cell(debug_table, 1, 4, str.tostring(friday_calc), text_color=color.white)
        
        table.cell(debug_table, 0, 5, "Last Close Day", text_color=color.white)
        table.cell(debug_table, 1, 5, not na(last_close_capture_day) ? str.tostring(last_close_capture_day) : "N/A", text_color=color.white)
        
        table.cell(debug_table, 0, 6, "Stored Close", text_color=color.white)
        table.cell(debug_table, 1, 6, not na(stored_closing_price) ? str.tostring(stored_closing_price, "#.##") : "N/A", text_color=color.white)
        
        table.cell(debug_table, 0, 7, "Lines Count", text_color=color.white)
        table.cell(debug_table, 1, 7, str.tostring(array.size(gap_lines)), text_color=color.white)
        
        table.cell(debug_table, 0, 8, "Show Levels Now", text_color=color.white)
        table.cell(debug_table, 1, 8, str.tostring(show_levels_now), text_color=color.white)

// Gap levels table
show_table = input.bool(true, "Show Gap Levels Table", group="Display Settings")

if show_table and show_levels_now and not na(stored_closing_price)
    var table gap_table = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)
    
    if barstate.islast
        table.cell(gap_table, 0, 0, "Level", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(gap_table, 1, 0, "Price", text_color=color.white, bgcolor=color.new(color.gray, 50))
        
        table.cell(gap_table, 0, 1, "+30", text_color=color_30pt)
        table.cell(gap_table, 1, 1, str.tostring(gap_up_30, "#.##"), text_color=color_30pt)
        
        table.cell(gap_table, 0, 2, "+20", text_color=color_20pt)
        table.cell(gap_table, 1, 2, str.tostring(gap_up_20, "#.##"), text_color=color_20pt)
        
        table.cell(gap_table, 0, 3, "+10", text_color=color_10pt)
        table.cell(gap_table, 1, 3, str.tostring(gap_up_10, "#.##"), text_color=color_10pt)
        
        table.cell(gap_table, 0, 4, "Close", text_color=color.yellow)
        table.cell(gap_table, 1, 4, str.tostring(stored_closing_price, "#.##"), text_color=color.yellow)
        
        table.cell(gap_table, 0, 5, "-10", text_color=color_10pt)
        table.cell(gap_table, 1, 5, str.tostring(gap_down_10, "#.##"), text_color=color_10pt)
        
        table.cell(gap_table, 0, 6, "-20", text_color=color_20pt)
        table.cell(gap_table, 1, 6, str.tostring(gap_down_20, "#.##"), text_color=color_20pt)
        
        table.cell(gap_table, 0, 7, "-30", text_color=color_30pt)
        table.cell(gap_table, 1, 7, str.tostring(gap_down_30, "#.##"), text_color=color_30pt)