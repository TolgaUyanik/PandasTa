// Library Exception Mappings (inherit only)
// - Main script will apply these only when the user per-type policy is Inherit
// - f_loadExcSevByTypeId(): 0=no override, 1..3=override severity for rows in this library
// - f_loadExcTagByTypeId(): optional debug tag displayed in reasons ("" if none)
// - f_loadExcDelayAfterNewsMins(): optional override for delay-after-news minutes for rows in this library (0 = no override)
// ────────────────
export f_loadExcSevByTypeId() =>
    int[] _baseSev = nt.f_loadTypeSevByTypeId()
    int _n = array.size(_baseSev)
    int[] _excSev = array.new_int(_n, 0)
    array.set(_excSev, nt.TYPE_FOMC_Meeting_Minutes, 3)
    array.set(_excSev, nt.TYPE_Beige_Book, 3)
    array.set(_excSev, nt.TYPE_Core_CPI_m_m, 1)
