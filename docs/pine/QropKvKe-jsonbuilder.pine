//@version=6

// @description JsonBuilder for easiest way to generate json string
library("jsonbuilder", overlay = true)

// @enum Kind enum
export enum Kind
	STRING
	NUMBER
	OBJECT
	ARRAY

// @type JSONBuilder type
// @field pairs Pairs data
export type _JSONBuilder
	array<string> pairs

// @function Create JSONBuilder instance
// @param pairs Pairs list, not required for users
export JSONBuilder(array<string> pairs = na) =>
	_pairs = pairs
	if na(pairs)
		_pairs := array.new<string>()
	_JSONBuilder.new(_pairs)

// @function Add Json Object
// @param key Field key
// @param value Field value
// @param kind Kind value
export method addField(_JSONBuilder this, string key, string value, Kind kind = Kind.STRING) =>
	v = switch kind
		Kind.STRING => str.format('"{0}"', value)
		Kind.NUMBER => str.tostring(value)
		Kind.OBJECT => str.tostring(value)
		Kind.ARRAY => str.format('[{0}]', value)
		=> str.tostring(value)
	pair = str.format('"{0}": {1}', key, v)
	this.pairs.push(pair)
	JSONBuilder(this.pairs)

// @function Create json string
export method execute(_JSONBuilder this) =>
	'{' + this.pairs.join(',') + '}'

// @function Add Json Array
// @param key Field key
// @param value Object value array
export method addArray(_JSONBuilder this, string key, array<_JSONBuilder> value) =>
	executed = array.new<string>()
	for builder in value
		executed.push(builder.execute())
	this.addField(key, executed.join(","), Kind.ARRAY)

// @function Add Json Object
// @param key Field key
// @param value Object value
export method addObject(_JSONBuilder this, string key, _JSONBuilder value) =>
	this.addField(key, value.execute(), Kind.OBJECT)


// Example Usage
// json = JSONBuilder().addField("symbol", syminfo.ticker).addField("side", "{{strategy.order.action}}").addObject(
//   "tp", JSONBuilder().addField("price", str.tostring(close * 1.12), Kind.NUMBER)).addArray("gridLevels", array.from(
//   JSONBuilder().addField("price", str.tostring(close * 0.99)), JSONBuilder().addField("price", str.tostring(close * 0.98))))
