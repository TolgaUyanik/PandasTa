//@version=6
library("utilities", overlay=false)

// --- Helpers ---

// Simple return: (x / x[1] - 1)
export ret_simple(series float src) =>
    src / src[1] - 1

// Rolling sum of last `length` values
export rolling_sum(series float src, simple int length) =>
    math.sum(src, length)

// Rolling correlation between two series
export rolling_corr(series float src,series float other, simple int length) =>
    ta.correlation(src, other, length)

// Benchmark return aligned to chart, computed inside security
export bench_ret(simple string benchSym, simple string tf, simple bool gaps=true) =>
    request.security(benchSym, tf,ta.change(close) / close[1], gaps ? barmerge.gaps_off : barmerge.gaps_on, barmerge.lookahead_off)

// Sharpe: mean(excess return) / stdev(excess return)
export sharpe_simple(series float returns, series float rf, simple int length) =>
    ex = returns - rf
    mu = ta.sma(ex, length)
    sd = ta.stdev(ex, length)
    sd == 0 ? na : mu / sd

