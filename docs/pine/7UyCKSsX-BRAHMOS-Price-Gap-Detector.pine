//@version=6
indicator("BRAHMOS Price Gap Detector", overlay=true)

//=====================================================
// GAP DETECTION
//=====================================================
gapUp   = low > high[1]
gapDown = high < low[1]

//=====================================================
// VARIABLES
//=====================================================
var string gapType = "NONE"
var string firstCandle = "-"
var string secondCandle = "-"
var float gapSize = na

//=====================================================
// STORE LATEST GAP
//=====================================================
if gapUp
    gapType := "GAP UP"
    gapSize := low - high[1]
    firstCandle := str.format_time(time[1], "HH:mm")
    secondCandle := str.format_time(time, "HH:mm")

if gapDown
    gapType := "GAP DOWN"
    gapSize := low[1] - high
    firstCandle := str.format_time(time[1], "HH:mm")
    secondCandle := str.format_time(time, "HH:mm")

//=====================================================
// DASHBOARD
//=====================================================
var table dash = table.new(position.top_right, 2, 4, border_width=1)

if barstate.islast
    table.cell(dash, 0, 0, "Gap Type", bgcolor=color.blue, text_color=color.white)
    table.cell(dash, 1, 0, gapType)

    table.cell(dash, 0, 1, "1st Candle")
    table.cell(dash, 1, 1, firstCandle)

    table.cell(dash, 0, 2, "2nd Candle")
    table.cell(dash, 1, 2, secondCandle)

    table.cell(dash, 0, 3, "Gap Size")
    table.cell(dash, 1, 3, na(gapSize) ? "-" : str.tostring(gapSize, format.mintick))