//@version=6
indicator("Volume Highlight (USD/BTC) + Open Interest", shorttitle="Vol Highlight + OI", overlay=false, format=format.volume)

// ─────────────────────────────────────────────────────────────
// INPUTS — set your volume amounts here (Settings → Inputs)
// ─────────────────────────────────────────────────────────────
grpVol = "Volume thresholds"
useUsd       = input.bool(true,  "Use USD threshold",  group=grpVol)
usdThreshold = input.float(100000000, "USD volume ≥", minval=0, step=1000000, group=grpVol, tooltip="Candle is highlighted when its volume in USD is at least this amount. Example: 100000000 = $100M")
useBtc       = input.bool(true,  "Use BTC threshold",  group=grpVol)
btcThreshold = input.float(1000, "BTC volume ≥", minval=0, step=100, group=grpVol, tooltip="Candle is highlighted when its volume in BTC (base currency) is at least this amount.")

grpStyle = "Highlight style"
hlColor  = input.color(color.new(color.yellow, 0), "Highlight color", group=grpStyle)

grpOi = "Open Interest"
showOi     = input.bool(true, "Show Open Interest", group=grpOi)
oiOverride = input.symbol("", "OI symbol override (optional)", group=grpOi, tooltip="Leave empty to auto-detect from the chart symbol (chart ticker + \"_OI\", e.g. BINANCE:BTCUSDT.P_OI). If your symbol has no OI feed, point this at one that does.")
oiUpColor  = input.color(color.new(color.teal, 0),  "OI rising color",  group=grpOi)
oiDnColor  = input.color(color.new(color.red, 0),   "OI falling color", group=grpOi)

// ─────────────────────────────────────────────────────────────
// VOLUME CALCULATIONS
// `volume` on crypto pairs like BTCUSDT is reported in the base
// currency (BTC). USD volume is approximated as volume × avg price.
// ─────────────────────────────────────────────────────────────
btcVol = volume
usdVol = volume * hlc3

condUsd = useUsd and usdVol >= usdThreshold
condBtc = useBtc and btcVol >= btcThreshold
highlight = condUsd or condBtc

// Recolor the candle on the main chart (applies to ALL bars your
// TradingView plan loads — there is no lookback limit on barcolor)
barcolor(highlight ? hlColor : na, title="Volume highlight")

// ─────────────────────────────────────────────────────────────
// OPEN INTEREST (plotted in this indicator's pane)
// ─────────────────────────────────────────────────────────────
oiTicker = oiOverride == "" ? syminfo.tickerid + "_OI" : oiOverride
[oiClose, oiOpen] = request.security(oiTicker, timeframe.period, [close, open], ignore_invalid_symbol=true)

oiRising = oiClose >= oiOpen
plot(showOi ? oiClose : na, "Open Interest", color=oiRising ? oiUpColor : oiDnColor, style=plot.style_columns)

// Warn once if no OI data exists for this symbol
var oiWarned = false
if showOi and barstate.islast and na(oiClose) and not oiWarned
    oiWarned := true
    var table warn = table.new(position.top_right, 1, 1)
    table.cell(warn, 0, 0, "No Open Interest data for " + oiTicker + "\nTry a perpetual futures chart (e.g. BINANCE:BTCUSDT.P)\nor set an override symbol in Settings.", text_color=color.white, bgcolor=color.new(color.red, 20), text_size=size.small)

// ─────────────────────────────────────────────────────────────
// DATA WINDOW / STATUS LINE — hover a candle to see its volumes
// ─────────────────────────────────────────────────────────────
plot(usdVol, "Volume (USD)", color=color.new(color.gray, 100), display=display.data_window + display.status_line)
plot(btcVol, "Volume (BTC)", color=color.new(color.gray, 100), display=display.data_window + display.status_line)
plotchar(highlight, "Threshold hit", "", location.top, display=display.data_window)
