//@version=6
library("fpa_unified_lib", overlay=true)

//------------------------------------------------------------------------------
// DESCRIPTION
//------------------------------------------------------------------------------
// fpa_unified_lib contains shared helpers used by fpa-unified-signals:
// - style adapters (line/label style normalization)
// - session/time normalization helpers
// - reusable object lifecycle updaters
// - bounded cleanup helpers for lines/labels
// - shared parsing helpers for numeric list inputs
//
// This library is intentionally utility-focused so the main script can stay
// organized as a thin orchestrator with centralized alert declarations.

//==============================================================================
// STYLE HELPERS
//==============================================================================
export lineStyle(string styleText) =>
    switch styleText
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

export labelSize(string sizeText) =>
    switch sizeText
        "Auto" => size.auto
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

//==============================================================================
// TIME/SESSION HELPERS
//==============================================================================
export normalizeSession(string sessionInput, bool hideWeekends) =>
    hideWeekends ? sessionInput + ":123456" : sessionInput + ":1234567"

export isSessionActive(string sessionInput, string timezoneInput) =>
    not na(time(timeframe.period, sessionInput, timezoneInput))

export tfInRange(string lowTf, string highTf) =>
    timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds(lowTf) and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(highTf)

export parseTradingDayOpenMinutes(string sessionInput) =>
    int result = 18 * 60
    int len = str.length(sessionInput)
    if len >= 4
        int hh = int(str.tonumber(str.substring(sessionInput, 0, 2)))
        int mm = int(str.tonumber(str.substring(sessionInput, 2, 4)))
        if not na(hh) and not na(mm) and hh >= 0 and hh <= 23 and mm >= 0 and mm <= 59
            result := hh * 60 + mm
    result

//==============================================================================
// COLOR/OBJECT HELPERS
//==============================================================================
export safeColor(color c, int transp) =>
    color.new(c, math.max(0, math.min(100, transp)))

export updateRay(line lineRef, bool shouldShow, int startBarIndex, float yPrice, color lineColor, int lineWidth, string lineStyleText, int rightOffsetBars, int lookbackBars) =>
    line updated = lineRef
    if shouldShow and not na(yPrice)
        int rawX1 = na(startBarIndex) ? bar_index - 1 : startBarIndex
        int minX1 = math.max(0, bar_index - math.max(1, lookbackBars))
        int x1 = math.max(rawX1, minX1)
        int x2 = bar_index + math.max(1, rightOffsetBars)
        ls = lineStyle(lineStyleText)
        if na(updated)
            updated := line.new(x1=x1, y1=yPrice, x2=x2, y2=yPrice, extend=extend.none, color=lineColor, width=lineWidth, style=ls)
        else
            line.set_xy1(updated, x1, yPrice)
            line.set_xy2(updated, x2, yPrice)
            line.set_color(updated, lineColor)
            line.set_width(updated, lineWidth)
            line.set_style(updated, ls)
    else if not na(updated)
        line.delete(updated)
        updated := na
    updated

export updateLabel(label labelRef, bool shouldShow, float yPrice, string textValue, color labelColor, int rightOffsetBars, string sizeText) =>
    label updated = labelRef
    if shouldShow and not na(yPrice)
        int x = bar_index + math.max(1, rightOffsetBars)
        sz = labelSize(sizeText)
        if na(updated)
            updated := label.new(x=x, y=yPrice, text=textValue, style=label.style_label_center, textcolor=color.white, color=labelColor, size=sz)
        else if barstate.islast
            label.set_x(updated, x)
            label.set_y(updated, yPrice)
            label.set_text(updated, textValue)
            label.set_size(updated, sz)
            label.set_color(updated, labelColor)
    else if not na(updated)
        label.delete(updated)
        updated := na
    updated

//==============================================================================
// COLLECTION BOUNDS HELPERS
//==============================================================================
export trimLines(array<line> arr, int limit) =>
    int safeLimit = math.max(0, limit)
    while array.size(arr) > safeLimit
        line ln = array.pop(arr)
        line.delete(ln)

export trimLabels(array<label> arr, int limit) =>
    int safeLimit = math.max(0, limit)
    while array.size(arr) > safeLimit
        label lb = array.pop(arr)
        label.delete(lb)

//==============================================================================
// PARSING HELPERS
//==============================================================================
export parseFloatList(string textArea) =>
    array<float> out = array.new_float()
    array<string> chars = str.split(textArea, "")
    string token = ""
    if array.size(chars) > 0
        for i = 0 to array.size(chars) - 1
            string c = array.get(chars, i)
            if c == "\n"
                float v = str.tonumber(token)
                if not na(v)
                    array.push(out, v)
                token := ""
            else
                token += c
        float tail = str.tonumber(token)
        if not na(tail)
            array.push(out, tail)
    out
