//@version=6
indicator("MACD-RSI Divergence Oscillator", shorttitle="MACD-RSI", format=format.price, precision=2)

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// INPUT PARAMETERS
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

// MACD Settings
macd_fast = input.int(12, "MACD Fast Length", minval=1, group="MACD Settings")
macd_slow = input.int(26, "MACD Slow Length", minval=1, group="MACD Settings")
macd_signal = input.int(9, "MACD Signal Length", minval=1, group="MACD Settings")
macd_source = input.source(close, "MACD Source", group="MACD Settings")

// RSI Settings
rsi_length = input.int(14, "RSI Length", minval=1, group="RSI Settings")
rsi_source = input.source(close, "RSI Source", group="RSI Settings")
rsi_overbought = input.int(70, "RSI Overbought", minval=50, maxval=90, group="RSI Settings")
rsi_oversold = input.int(30, "RSI Oversold", minval=10, maxval=50, group="RSI Settings")
rsi_scale = input.float(0.01, "RSI Scale Factor", minval=0.001, maxval=0.1, step=0.001, group="RSI Settings")

// Divergence Settings
divergence_lookback = input.int(5, "Divergence Lookback", minval=3, maxval=20, group="Divergence Analysis")
min_bars_between_divs = input.int(10, "Min Bars Between Divergences", minval=5, maxval=50, group="Divergence Analysis")

// Visual Settings
show_macd = input.bool(true, "Show MACD", group="Display")
show_rsi = input.bool(true, "Show RSI", group="Display")
show_divergences = input.bool(true, "Show Divergences", group="Display")
show_signals = input.bool(true, "Show Trading Signals", group="Display")
macd_scale = input.float(1.0, "MACD Scale Factor", minval=0.1, maxval=5.0, step=0.1, group="Display")

// Table Settings
show_table = input.bool(true, "Show Information Table", group="Table Settings")
table_position = input.string("Top Left", "Table Position", 
     options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], 
     group="Table Settings")
text_size_option = input.string("Normal", "Text Size", 
     options=["Tiny", "Small", "Normal", "Large", "Huge"], 
     group="Table Settings")

// Table Elements
show_macd_value = input.bool(true, "Show MACD Value", group="Table Elements")
show_rsi_value = input.bool(true, "Show RSI Value", group="Table Elements")
show_macd_trend = input.bool(true, "Show MACD Trend", group="Table Elements")
show_momentum = input.bool(true, "Show Momentum", group="Table Elements")
show_divergence_status = input.bool(true, "Show Divergence Status", group="Table Elements")
show_signal_status = input.bool(true, "Show Signal Status", group="Table Elements")

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

// MACD Calculation
[macd_line, signal_line, macd_histogram] = ta.macd(macd_source, macd_fast, macd_slow, macd_signal)
macd_scaled = macd_line * macd_scale

// RSI Calculation
rsi = ta.rsi(rsi_source, rsi_length)
rsi_normalized = (rsi - 50) * rsi_scale  // Scale RSI to match MACD range

// Combined Oscillator (Average of normalized MACD and RSI)
combined_oscillator = (macd_scaled + rsi_normalized) / 2

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// DIVERGENCE DETECTION
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Price Pivots
price_high = ta.pivothigh(high, divergence_lookback, divergence_lookback)
price_low = ta.pivotlow(low, divergence_lookback, divergence_lookback)

// MACD Pivots
macd_high = ta.pivothigh(macd_line, divergence_lookback, divergence_lookback)
macd_low = ta.pivotlow(macd_line, divergence_lookback, divergence_lookback)

// RSI Pivots
rsi_high = ta.pivothigh(rsi, divergence_lookback, divergence_lookback)
rsi_low = ta.pivotlow(rsi, divergence_lookback, divergence_lookback)

// Store pivot values and locations
var float last_price_high = na, var int last_price_high_bar = na
var float last_price_low = na, var int last_price_low_bar = na
var float last_macd_high = na, var int last_macd_high_bar = na
var float last_macd_low = na, var int last_macd_low_bar = na
var float last_rsi_high = na, var int last_rsi_high_bar = na
var float last_rsi_low = na, var int last_rsi_low_bar = na

// Update pivot tracking
if not na(price_high)
    last_price_high := high[divergence_lookback]
    last_price_high_bar := bar_index - divergence_lookback

if not na(price_low)
    last_price_low := low[divergence_lookback]
    last_price_low_bar := bar_index - divergence_lookback

if not na(macd_high)
    last_macd_high := macd_line[divergence_lookback]
    last_macd_high_bar := bar_index - divergence_lookback

if not na(macd_low)
    last_macd_low := macd_line[divergence_lookback]
    last_macd_low_bar := bar_index - divergence_lookback

if not na(rsi_high)
    last_rsi_high := rsi[divergence_lookback]
    last_rsi_high_bar := bar_index - divergence_lookback

if not na(rsi_low)
    last_rsi_low := rsi[divergence_lookback]
    last_rsi_low_bar := bar_index - divergence_lookback

// Divergence Detection Logic
var int last_bullish_div_bar = na
var int last_bearish_div_bar = na

// MACD Bullish Divergence (Price makes lower low, MACD makes higher low)
macd_bullish_div = not na(price_low) and not na(last_price_low) and not na(last_macd_low) and
                   low[divergence_lookback] < last_price_low and 
                   macd_line[divergence_lookback] > last_macd_low and
                   (na(last_bullish_div_bar) or bar_index - last_bullish_div_bar > min_bars_between_divs)

// MACD Bearish Divergence (Price makes higher high, MACD makes lower high)
macd_bearish_div = not na(price_high) and not na(last_price_high) and not na(last_macd_high) and
                   high[divergence_lookback] > last_price_high and 
                   macd_line[divergence_lookback] < last_macd_high and
                   (na(last_bearish_div_bar) or bar_index - last_bearish_div_bar > min_bars_between_divs)

// RSI Bullish Divergence
rsi_bullish_div = not na(price_low) and not na(last_price_low) and not na(last_rsi_low) and
                  low[divergence_lookback] < last_price_low and 
                  rsi[divergence_lookback] > last_rsi_low and
                  (na(last_bullish_div_bar) or bar_index - last_bullish_div_bar > min_bars_between_divs)

// RSI Bearish Divergence
rsi_bearish_div = not na(price_high) and not na(last_price_high) and not na(last_rsi_high) and
                  high[divergence_lookback] > last_price_high and 
                  rsi[divergence_lookback] < last_rsi_high and
                  (na(last_bearish_div_bar) or bar_index - last_bearish_div_bar > min_bars_between_divs)

// Combined Divergences (Both MACD and RSI confirm)
bullish_divergence = macd_bullish_div or rsi_bullish_div
bearish_divergence = macd_bearish_div or rsi_bearish_div
strong_bullish_div = macd_bullish_div and rsi_bullish_div
strong_bearish_div = macd_bearish_div and rsi_bearish_div

// Update last divergence bar tracking
if bullish_divergence
    last_bullish_div_bar := bar_index
if bearish_divergence
    last_bearish_div_bar := bar_index

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// TRADING SIGNALS
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Signal Conditions
macd_bullish_cross = ta.crossover(macd_line, signal_line)
macd_bearish_cross = ta.crossunder(macd_line, signal_line)
rsi_bullish_signal = rsi < rsi_oversold and rsi > rsi[1]
rsi_bearish_signal = rsi > rsi_overbought and rsi < rsi[1]

// Combined Signals
strong_buy_signal = (macd_bullish_cross or rsi_bullish_signal) and bullish_divergence
strong_sell_signal = (macd_bearish_cross or rsi_bearish_signal) and bearish_divergence
buy_signal = macd_bullish_cross and rsi < 60
sell_signal = macd_bearish_cross and rsi > 40

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

get_table_position() =>
    switch table_position
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.top_left

get_text_size() =>
    switch text_size_option
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

count_table_rows() =>
    row_count = 1  // Header row
    if show_macd_value
        row_count += 1
    if show_rsi_value
        row_count += 1
    if show_macd_trend
        row_count += 1
    if show_momentum
        row_count += 1
    if show_divergence_status
        row_count += 1
    if show_signal_status
        row_count += 1
    row_count

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Zero Line
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dashed, linewidth=1)

// RSI Levels (normalized) - Calculate based on actual overbought/oversold levels
rsi_overbought_normalized = (rsi_overbought - 50) * rsi_scale
rsi_oversold_normalized = (rsi_oversold - 50) * rsi_scale

hline(rsi_overbought_normalized, "RSI Overbought", color=color.red, linestyle=hline.style_dotted, linewidth=1)
hline(rsi_oversold_normalized, "RSI Oversold", color=color.green, linestyle=hline.style_dotted, linewidth=1)

// Plot MACD
macd_color = macd_line > signal_line ? color.lime : color.red
plot(show_macd ? macd_scaled : na, title="MACD Line", color=macd_color, linewidth=2)
plot(show_macd ? signal_line * macd_scale : na, title="MACD Signal", color=color.orange, linewidth=1)

// Plot RSI (normalized)
rsi_color = rsi > 50 ? color.blue : color.purple
plot(show_rsi ? rsi_normalized : na, title="RSI Normalized", color=rsi_color, linewidth=2)

// Plot Combined Oscillator
plot(combined_oscillator, title="Combined Oscillator", color=color.white, linewidth=3, display=display.none)

// MACD Histogram
histogram_color = macd_histogram > 0 ? (macd_histogram > macd_histogram[1] ? color.lime : color.green) : (macd_histogram < macd_histogram[1] ? color.red : color.maroon)
plot(show_macd ? macd_histogram * macd_scale : na, title="MACD Histogram", style=plot.style_columns, color=color.new(histogram_color, 60), linewidth=1)

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// DIVERGENCE VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

// Divergence Shapes
plotshape(bullish_divergence and show_divergences, title="Bullish Divergence", style=shape.triangleup, 
          location=location.bottom, color=color.lime, size=size.normal, text="DIV↑")
plotshape(bearish_divergence and show_divergences, title="Bearish Divergence", style=shape.triangledown, 
          location=location.top, color=color.red, size=size.normal, text="DIV↓")

// Strong Divergence Markers
plotshape(strong_bullish_div and show_divergences, title="Strong Bullish Div", style=shape.diamond, 
          location=location.bottom, color=color.aqua, size=size.large, text="STRONG↑")
plotshape(strong_bearish_div and show_divergences, title="Strong Bearish Div", style=shape.diamond, 
          location=location.top, color=color.fuchsia, size=size.large, text="STRONG↓")

// Trading Signal Shapes
plotshape(strong_buy_signal and show_signals, title="Strong Buy", style=shape.labelup, 
          location=location.bottom, color=color.green, textcolor=color.white, text="BUY", size=size.large)
plotshape(strong_sell_signal and show_signals, title="Strong Sell", style=shape.labeldown, 
          location=location.top, color=color.red, textcolor=color.white, text="SELL", size=size.large)

plotshape(buy_signal and show_signals and not strong_buy_signal, title="Buy Signal", style=shape.arrowup, 
          location=location.bottom, color=color.blue, size=size.small)
plotshape(sell_signal and show_signals and not strong_sell_signal, title="Sell Signal", style=shape.arrowdown, 
          location=location.top, color=color.orange, size=size.small)

// Background coloring for divergences
bgcolor(strong_bullish_div and show_divergences ? color.new(color.lime, 85) : na, title="Strong Bullish Div BG")
bgcolor(strong_bearish_div and show_divergences ? color.new(color.red, 85) : na, title="Strong Bearish Div BG")

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// INFORMATION TABLE
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

if barstate.islast and show_table
    var table info_table = table.new(get_table_position(), 2, count_table_rows(), bgcolor=color.white, border_width=1)
    
    current_row = 0
    
    // Header row
    table.cell(info_table, 0, current_row, text="Indicator", bgcolor=color.gray, text_color=color.white, text_size=get_text_size())
    table.cell(info_table, 1, current_row, text="Value", bgcolor=color.gray, text_color=color.white, text_size=get_text_size())
    current_row += 1
    
    // MACD Value
    if show_macd_value
        table.cell(info_table, 0, current_row, text="MACD", bgcolor=color.white, text_size=get_text_size())
        table.cell(info_table, 1, current_row, text=str.tostring(macd_line, "#.####"), 
                   bgcolor=macd_line > signal_line ? color.lime : color.red, text_color=color.white, text_size=get_text_size())
        current_row += 1
    
    // RSI Value
    if show_rsi_value
        table.cell(info_table, 0, current_row, text="RSI", bgcolor=color.white, text_size=get_text_size())
        table.cell(info_table, 1, current_row, text=str.tostring(rsi, "#.##"), 
                   bgcolor=rsi > 70 ? color.red : rsi < 30 ? color.green : color.white, text_size=get_text_size())
        current_row += 1
    
    // MACD Trend
    if show_macd_trend
        table.cell(info_table, 0, current_row, text="MACD Trend", bgcolor=color.white, text_size=get_text_size())
        table.cell(info_table, 1, current_row, text=macd_line > signal_line ? "BULLISH" : "BEARISH", 
                   bgcolor=macd_line > signal_line ? color.green : color.red, text_color=color.white, text_size=get_text_size())
        current_row += 1
    
    // Momentum
    if show_momentum
        table.cell(info_table, 0, current_row, text="Momentum", bgcolor=color.white, text_size=get_text_size())
        table.cell(info_table, 1, current_row, text=rsi > 50 ? "BULLISH" : "BEARISH", 
                   bgcolor=rsi > 50 ? color.green : color.red, text_color=color.white, text_size=get_text_size())
        current_row += 1
    
    // Divergence Status
    if show_divergence_status
        table.cell(info_table, 0, current_row, text="Divergence", bgcolor=color.white, text_size=get_text_size())
        div_text = strong_bullish_div ? "STRONG BULL" : strong_bearish_div ? "STRONG BEAR" : bullish_divergence ? "BULLISH" : bearish_divergence ? "BEARISH" : "NONE"
        div_color = strong_bullish_div ? color.lime : strong_bearish_div ? color.fuchsia : bullish_divergence ? color.green : bearish_divergence ? color.red : color.gray
        table.cell(info_table, 1, current_row, text=div_text, bgcolor=div_color, text_color=color.white, text_size=get_text_size())
        current_row += 1
    
    // Signal Status
    if show_signal_status
        table.cell(info_table, 0, current_row, text="Signal", bgcolor=color.white, text_size=get_text_size())
        signal_text = strong_buy_signal ? "STRONG BUY" : strong_sell_signal ? "STRONG SELL" : buy_signal ? "BUY" : sell_signal ? "SELL" : "NEUTRAL"
        signal_color = strong_buy_signal ? color.lime : strong_sell_signal ? color.red : buy_signal ? color.green : sell_signal ? color.orange : color.gray
        table.cell(info_table, 1, current_row, text=signal_text, bgcolor=signal_color, text_color=color.white, text_size=get_text_size())

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════

alertcondition(strong_bullish_div, title="Strong Bullish Divergence", 
               message="MACD-RSI: Strong bullish divergence detected - Both MACD and RSI confirm")
alertcondition(strong_bearish_div, title="Strong Bearish Divergence", 
               message="MACD-RSI: Strong bearish divergence detected - Both MACD and RSI confirm")
alertcondition(bullish_divergence, title="Bullish Divergence", 
               message="MACD-RSI: Bullish divergence detected")
alertcondition(bearish_divergence, title="Bearish Divergence", 
               message="MACD-RSI: Bearish divergence detected")
alertcondition(strong_buy_signal, title="Strong Buy Signal", 
               message="MACD-RSI: Strong buy signal - Divergence + Cross/RSI confirm")
alertcondition(strong_sell_signal, title="Strong Sell Signal", 
               message="MACD-RSI: Strong sell signal - Divergence + Cross/RSI confirm")
alertcondition(buy_signal, title="Buy Signal", 
               message="MACD-RSI: Buy signal - MACD bullish cross with RSI < 60")
alertcondition(sell_signal, title="Sell Signal", 
               message="MACD-RSI: Sell signal - MACD bearish cross with RSI > 40")