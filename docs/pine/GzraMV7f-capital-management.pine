// @description TODO: add library description here
library(title = "capital_management", overlay = false)


// @function: Function to calculate order volume according to given risk percent
// @param precent_risk: Maximum allowable risk percentage per trade
// @param order_entry_price: Price that entry price
// @returns stop_loss_price: Price that place stop loss order
export order_volume (float percent_risk, float order_entry_price, float stop_loss_price) =>
	// Calculate optimal Volume
	Vlm = (percent_risk / 100 * strategy.equity) / math.abs(order_entry_price - stop_loss_price)
	// Convert optimal colume to volume according to mintick of price
	Vlm := math.floor(Vlm / syminfo.mintick) * syminfo.mintick
	//  Return value
	Vlm

// @function: Function to calculate take profit price according to given risk:rewark ratio
// @param entry_price: Placing price
// @param stoploss_price: Price that place stop loss order
// @param risk_reward: Risk:Reward Ratio. Example: Risk:Reward is 1:3 the enter 3
// @returns Return take profit value according to given risk:reward ratio

export calculate_takeprofit_price (float entry_price, float stop_loss_price, float risk_reward) =>
	// Calculate stop loss distance between entry_price and stop_loss_price
	stop_loss_distance = math.abs(entry_price - stop_loss_price)
	//  Calculate the distance between take profit price and entry price based on risk:reward ratio
	take_profit_distance = stop_loss_distance * risk_reward
	// Return take profit price depending on the trade direction
	if entry_price > stop_loss_price
		// Long trade: Add take_profit_distance in to entry price
		take_profit_price = entry_price + take_profit_distance
	else
		// Short trade: Subtract take_profit_distance from entry_price
		take_profit_price = entry_price - take_profit_distance
