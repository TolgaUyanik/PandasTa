//@version=6
library("CarolTradeLib")

// -------------------------
// HELPER FUNCTION: generate unique signal ID
// -------------------------
export f_generateSignalID(string strategyName) =>
    strategyName + "_" + str.tostring(time)

// -------------------------
// HELPER FUNCTION: construct JSON payload
// -------------------------
export f_buildJSON(string orderType, string action, string symbol, float price, string strategyName, string apiKey, string additionalFields, string indicatorJSON) =>
    var string json = '{'
    json := '{'
    json += '"orderType":"' + orderType + '",'
    json += '"api_key":"' + apiKey + '",'
    json += '"action":"' + action + '",'
    json += '"symbol":"' + symbol + '",'
    json += '"price":' + str.tostring(price) + ','
    json += '"time":"' + str.tostring(time) + '",'
    json += '"strategy":"' + strategyName + '",'
    json += '"signal_id":"' + f_generateSignalID(strategyName) + '"'
    
    if str.length(additionalFields) > 0
        json += ',' + additionalFields
    
    if str.length(indicatorJSON) > 0
        json += ',"indicator":' + indicatorJSON
    
    json += '}'
    json

// -------------------------
// SEND SIGNAL
// -------------------------
export sendSignal(string action, string symbol, float price, string strategyName, string apiKey, string indicatorJSON = "") =>
    string jsonPayload = f_buildJSON("signal", action, symbol, price, strategyName, apiKey, "", indicatorJSON)
    alert(jsonPayload, alert.freq_once_per_bar_close)

// -------------------------
// MARKET ORDER
// -------------------------
export marketOrder(string action, string symbol, float price, string strategyName, string apiKey, float stopLoss, float takeProfit, float rrRatio, float quantity, string indicatorJSON = "") =>
    string additional = '"stop_loss":' + str.tostring(stopLoss) + ',' + '"take_profit":' + str.tostring(takeProfit) + ',' + '"rr_ratio":' + str.tostring(rrRatio) + ',' + '"quantity":' + str.tostring(quantity)
    string jsonPayload = f_buildJSON("market", action, symbol, price, strategyName, apiKey, additional, indicatorJSON)
    alert(jsonPayload, alert.freq_once_per_bar_close)

// -------------------------
// LIMIT ORDER
// -------------------------
export limitOrder(string action, string symbol, float price, string strategyName, string apiKey, float limitPrice, float quantity, string indicatorJSON = "") =>
    string additional = '"limit_price":' + str.tostring(limitPrice) + ',' + '"quantity":' + str.tostring(quantity)
    string jsonPayload = f_buildJSON("limit", action, symbol, price, strategyName, apiKey, additional, indicatorJSON)
    alert(jsonPayload, alert.freq_once_per_bar_close)

// -------------------------
// STOP LIMIT ORDER
// -------------------------
export stopLimitOrder(string action, string symbol, float price, string strategyName, string apiKey, float stopPrice, float limitPrice, float quantity, string indicatorJSON = "") =>
    string additional = '"stop_price":' + str.tostring(stopPrice) + ',' + '"limit_price":' + str.tostring(limitPrice) + ',' + '"quantity":' + str.tostring(quantity)
    string jsonPayload = f_buildJSON("stop_limit", action, symbol, price, strategyName, apiKey, additional, indicatorJSON)
    alert(jsonPayload, alert.freq_once_per_bar_close)