//@version=5
indicator("Intraday Bullish Scanner - Profit Ping Only", overlay=true)

// === INPUTS ===
emaShort = input.int(7, title="EMA Short (7)")
emaLong = input.int(14, title="EMA Long (14)")
volLength = input.int(20, title="Volume MA Length")
rsiLength = input.int(14, title="RSI Length")
macdFast = input.int(12, title="MACD Fast")
macdSlow = input.int(26, title="MACD Slow")
macdSignal = input.int(9, title="MACD Signal")

// === INDICATORS ===
ema7 = ta.ema(close, emaShort)
ema14 = ta.ema(close, emaLong)
volMA = ta.sma(volume, volLength)
rsi = ta.rsi(close, rsiLength)
[macdLine, macdSignalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)

// === CANDLESTICK PATTERNS ===
// Bullish
bullishEngulfing = close[1] < open[1] and close > open and close > open[1] and open < close[1]
bullishPiercing = close[1] < open[1] and open < close[1] and close > (open[1] + close[1]) / 2 and close < open[1]
bullishPatterns = bullishEngulfing or bullishPiercing

// Bearish
bearishEngulfing = close[1] > open[1] and close < open and close < open[1] and open > close[1]
bearishPiercing = close[1] > open[1] and open > close[1] and close < (open[1] + close[1]) / 2 and close > open[1]
bearishPatterns = bearishEngulfing or bearishPiercing

// === ENTRY CONDITIONS ===
emaCrossUp = ta.crossover(ema7, ema14)
volumeSpike = volume > volMA
rsiBuyZone = rsi > 55 and rsi < 65
macdBuyOk = macdHist > 0 and macdHist[1] < 0 and macdSignalLine > macdSignalLine[1]

entrySignal = emaCrossUp and bullishPatterns and volumeSpike and rsiBuyZone and macdBuyOk

// === HOLDING ZONE CHECK (30m Chart) ===
holdingTrendWeak = (ema7 < ema14 or ta.crossunder(ema7, ema14)) and rsi < 55 and (macdHist < 0) and (volume < volMA)

// === TRAILING STOP MANAGEMENT ===
var float entryPrice = na
var float highestPrice = na
var float trailStop = na
var bool inTrade = false
var bool exitNow = false

if entrySignal and not inTrade
    entryPrice := close
    highestPrice := close
    trailStop := close * 0.98  // Start with 2%
    inTrade := true

if inTrade
    highestPrice := math.max(highestPrice, close)
    profit = (close - entryPrice) / entryPrice
    volBoost = volume / volMA
    trailStop := profit > 0.1 and volBoost > 1.5 ? highestPrice * 0.99 : profit > 0.05 and volBoost > 1.2 ? highestPrice * 0.985 : highestPrice * 0.98
    exitNow := close < trailStop

// === FINAL SELL CONFIRMATION ===
emaCrossDown = ta.crossunder(ema7, ema14)
rsiSell = rsi < 50 or rsi < rsi[1]
macdSell = macdHist < 0 and macdSignalLine < macdSignalLine[1]
finalSell = inTrade and exitNow and bearishPatterns and emaCrossDown and rsiSell and macdSell and volume > volMA

if finalSell
    inTrade := false

// === PLOTTING ===
// Entry signal (white triangle + label)
plotshape(entrySignal and not inTrade, title="BUY", location=location.belowbar, color=color.white, style=shape.triangleup, size=size.small)
if entrySignal and not inTrade
    label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.white, textcolor=color.black, yloc=yloc.belowbar)

// Exit signal (yellow triangle + label)
plotshape(finalSell, title="SELL", location=location.abovebar, color=color.yellow, style=shape.triangledown, size=size.small)
if finalSell
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.yellow, textcolor=color.black, yloc=yloc.abovebar)

// === ALERTS ===
alertcondition(entrySignal and not inTrade, title="BUY Alert", message="BUY Signal Triggered")
alertcondition(finalSell, title="SELL Alert", message="SELL Signal Triggered")
