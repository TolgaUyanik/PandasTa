//@version=6
strategy(
     "VWAP Points / Percent / Ticks Strategy",
     overlay=true,
     initial_capital=100000,
     currency=currency.USD,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     pyramiding=0,
     process_orders_on_close=true
)

//────────────────────────────────────
// Inputs
//────────────────────────────────────
mode = input.string(
     "Points",
     "Difference Mode",
     options=["Points", "Percent", "Ticks"])

diff = input.float(
     0.25,
     "Difference",
     minval=0,
     step=0.01)

qty = input.float(
     1,
     "Quantity",
     minval=1)

confirmClose = input.bool(
     true,
     "Confirm Signal On Candle Close")

showLevels = input.bool(
     true,
     "Show Buy/Sell Levels")

showLabels = input.bool(
     true,
     "Show Labels")

//────────────────────────────────────
// VWAP
//────────────────────────────────────
vwapValue = ta.vwap(hlc3)

//────────────────────────────────────
// Difference Calculation
//────────────────────────────────────
offset =
     mode == "Points"  ? diff :
     mode == "Percent" ? vwapValue * diff / 100 :
     diff * syminfo.mintick

buyLevel = vwapValue + offset
sellLevel = vwapValue - offset

//────────────────────────────────────
// Signal Logic
//────────────────────────────────────
buyCross = ta.crossover(close, buyLevel)
sellCross = ta.crossunder(close, sellLevel)

buySignal =
     confirmClose ?
     (buyCross and barstate.isconfirmed) :
     buyCross

sellSignal =
     confirmClose ?
     (sellCross and barstate.isconfirmed) :
     sellCross

//────────────────────────────────────
// Orders
//────────────────────────────────────
if buySignal and strategy.position_size <= 0
    strategy.close("SELL")
    strategy.entry("BUY", strategy.long, qty=qty)

if sellSignal and strategy.position_size >= 0
    strategy.close("BUY")
    strategy.entry("SELL", strategy.short, qty=qty)

//────────────────────────────────────
// Alerts
//────────────────────────────────────
alertcondition(buySignal, title="BUY", message="BUY")
alertcondition(sellSignal, title="SELL", message="SELL")

//────────────────────────────────────
// Plots
//────────────────────────────────────
plot(vwapValue, title="VWAP", color=color.blue, linewidth=2)

plot(
     showLevels ? buyLevel : na,
     title="Buy Level",
     color=color.green)

plot(
     showLevels ? sellLevel : na,
     title="Sell Level",
     color=color.red)

//────────────────────────────────────
// Labels
//────────────────────────────────────
plotshape(
     showLabels and buySignal,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="BUY",
     textcolor=color.white,
     size=size.small)

plotshape(
     showLabels and sellSignal,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.small)