//@version=6

// @description: Applies ROC algorithm to any pair of values.
// This library is used to scale change of value (price, volume) to a percentage value, just as a ROC indicator would do.
library("rate_of_change")

// @function This function is a helper to scale a value change to its percentage value.
// @param value: Current value
// @param base: Former value to compare current value against
// @param hardlimit: The maximum absolute value returned
// @returns per: A float comprised between 0 and 100
export rateOfChange(float value, float base = open, int hardlimit = 10) =>
    per = ((value / base) * 100) - 100
    per := per > hardlimit ? hardlimit : per
    per := per < hardlimit*-1 ? hardlimit*-1 : per
    per

int closeROClength = input.int(9, "Close ROC length")

// ROC (Rate Of Change) indicator plot with a hardlimit to 5%:
plot(rateOfChange(close, close[closeROClength]), "ROC", linewidth = 3)
