//@version=6
indicator('DXY ve US10Y Normalize Karşılaştırma (Zaman Aralığı Uyumu)', overlay = false)

// === Girdiler ===
normalizeBars = input.int(20, 'Normalize için kaç bar önce?', minval = 1)

// === Verileri Al (grafiğin kendi zaman aralığında) ===
dxy = request.security('TVC:DXY', timeframe.period, close)
us10y = request.security('TVC:US10Y', timeframe.period, close)

// === Başlangıç Değerleri ===
baseDxy = request.security('TVC:DXY', timeframe.period, close[normalizeBars])
baseUs10y = request.security('TVC:US10Y', timeframe.period, close[normalizeBars])

// === Normalize edilmiş % değişimler ===
dxyPct = (dxy - baseDxy) / baseDxy * 100
us10yPct = (us10y - baseUs10y) / baseUs10y * 100

// === Doğrusal çizim ===
plot(dxyPct, title = 'DXY % Değişim', color = color.teal, linewidth = 2, style = plot.style_line)
plot(us10yPct, title = 'US10Y % Değişim', color = color.orange, linewidth = 2, style = plot.style_line)
hline(0, 'Referans Seviye', color = color.gray, linestyle = hline.style_dotted)
