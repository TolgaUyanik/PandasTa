//@version=6

// @description A library to draw zigzag lines from provided pivot information.
library("DrawZigZag", overlay = true)

// SHARED SETUP
// @enum Should we extend or create a zigzag? If create, how many? (If we extend, it's always one.)
enum DoZigZag  // We don't need to export this enum because it's only used internally in the method.
    doNothing
    createOne
    createTwo
    extend


//#region HELPER FUNCTIONS

f_getUpZigColour(color _upZigColour) =>
    na(_upZigColour) ? color.green : _upZigColour

f_getDownZagColour(color _downZagColour) =>
    na(_downZagColour) ? color.red : _downZagColour

//  If the oldest stored line is still the invisible bootstrap seed, delete it before shifting it out.
f_shiftZigZagLine(array<line> _a_zigZagLines, line _bootstrapSeed) =>
    if _a_zigZagLines.size() > 0
        bool _shiftingBootstrapSeed = not na(_bootstrapSeed) and array.indexof(_a_zigZagLines, _bootstrapSeed) == 0
        if _shiftingBootstrapSeed
            line _firstLine = _a_zigZagLines.first()
            _firstLine.delete()
        _a_zigZagLines.shift()

//  Once a real zigzag line exists, the bootstrap seed is no longer needed.
f_retireBootstrapSeedIfNeeded(array<line> _a_zigZagLines, line _bootstrapSeed) =>
    if not na(_bootstrapSeed) and _a_zigZagLines.size() > 1 and array.indexof(_a_zigZagLines, _bootstrapSeed) == 0
        f_shiftZigZagLine(_a_zigZagLines, _bootstrapSeed)

//#endregion HELPER FUNCTIONS


//#region 🟢🟢🟢🟢🟢🟢 ZIGZAG FUNCTION `f_drawZigZags` 🟢🟢🟢🟢🟢🟢

// @function              This function creates or extends the latest zigzag line. Takes real-time information about pivots and draws lines. It does not calculate the pivots. It must be called once per script and cannot be called from a loop.
// @param _showZigZag     Whether to show the zigzag lines.
// @param _isHighPivot    Whether the current bar confirms a high pivot. Note that pivots are confirmed after the bar in which they occur.
// @param _isLowPivot     Whether the current bar confirms a low pivot.
// @param _highPivotPrice The price of the high pivot that was confirmed this bar. It is NOT the high price of the current bar.
// @param _lowPivotPrice  The price of the low pivot that was confirmed this bar. It is NOT the low price of the current bar.
// @param _pivotIndex     The bar index of the pivot that was confirmed this bar. This is not an offset. It's the `bar_index` value of the pivot.
// @param _zigzagWidth    The width of the zigzag lines. Default is 3.
// @param _lineStyle      The style of the zigzag lines. Default is `line.style_solid`.
// @param _upZigColour    The colour of the up zigzag lines. Default is `color.green`. If `na`, the library falls back to `color.green`.
// @param _downZagColour  The colour of the down zigzag lines. Default is `color.red`. If `na`, the library falls back to `color.red`.
// @returns               The function has no explicit returns. As a side effect, it draws or updates zigzag lines.
export f_drawZigZags(bool _showZigZag = true, bool _isHighPivot, bool _isLowPivot, float _highPivotPrice, float _lowPivotPrice, int _pivotIndex, int _zigzagWidth = 3, string _lineStyle = line.style_solid, color _upZigColour = color.green, color _downZagColour = color.red) =>
    if _showZigZag and (_isHighPivot or _isLowPivot)  // If there is no pivot confirmed this bar, there is no line to be created or extended and we do nothing.
        var line _zigZag = na  // This is the persistent line object of the zigzag line.
        color _upZigColourSafe = f_getUpZigColour(_upZigColour)
        color _downZagColourSafe = f_getDownZagColour(_downZagColour)

        // If this is the first pivot, create an invisible line (using `color(na)` is the robust way to set an invisible line)within the very candle where we get the first pivot, ending at the pivot price, so that we have something to draw the next pivot from.
        if na(_zigZag)
            // We need to be careful here since we only have ONE of the pivots confirmed. Let's use the candle prices instead of the pivot prices. Note that this *will* still work if we want to extend this for a different timeframe.
            float _y1 = _isHighPivot ? low[bar_index - _pivotIndex]  : _isLowPivot ? high[bar_index - _pivotIndex] : na
            float _y2 = _isHighPivot ? high[bar_index - _pivotIndex] : _isLowPivot ? low[bar_index - _pivotIndex]  : na
            _zigZag   := line.new(x1 = _pivotIndex, y1 = _y1, x2 = _pivotIndex, y2 = _y2, color = color(na), width = _zigzagWidth, style = _lineStyle)

        else  // If there is already a line, check whether we should extend it or create a new one, or create two.
            // Derive the coordinates and direction of the existing line.
            float _previousY1     = _zigZag.get_y1()
            float _previousY2     = _zigZag.get_y2()
            int   _previousX2     = _zigZag.get_x2()
            bool  _wasUp          = _previousY1 <= _previousY2
            bool  _wasDown        = _previousY1 > _previousY2
            // Derive the information we need about the pivot.
            // @variable True if the pivot we are feeding in to the function is on the same candle as an opposing pivot.
            bool  _isDarthMaul    = _isHighPivot and _isLowPivot
            float _highPrice      = _isDarthMaul ? _highPivotPrice : _isHighPivot ? _highPivotPrice : _isLowPivot ? _lowPivotPrice : na
            float _lowPrice       = _isDarthMaul ? _lowPivotPrice  : _isHighPivot ? _highPivotPrice : _isLowPivot ? _lowPivotPrice : na
            bool  _isHigher       = _highPrice > _previousY2
            bool  _isLower        = _lowPrice  < _previousY2
            
            // Decide whether to create or extend the zigzag.
            DoZigZag _doZigZag = DoZigZag.doNothing  // Reset to do nothing each bar.
            if _isDarthMaul
                _doZigZag := DoZigZag.createTwo  // If there are two pivots on the same bar, we create a line through the Darth Maul pivot.
            else
                if _wasUp
                    _doZigZag := switch
                        _isHigher and _isHighPivot => DoZigZag.extend  // This "repaints" the existing line to connect the upZig to the new high.
                        _isLower  and _isLowPivot  => DoZigZag.createOne  // This creates a new line from the previous high to the new low.
                        => DoZigZag.doNothing  // If the new pivot is something else, for example a lower high after a high, we do nothing.
                if _wasDown
                    _doZigZag := switch
                        _isHigher and _isHighPivot => DoZigZag.createOne
                        _isLower  and _isLowPivot  => DoZigZag.extend
                        => DoZigZag.doNothing
            
            // CREATE ONE LINE
            if _doZigZag == DoZigZag.createOne or _doZigZag == DoZigZag.createTwo  // The new line is the opposite direction to the previous one.
                _zigZag := line.new(
                  x1    = _previousX2,
                  y1    = _previousY2,
                  x2    = _pivotIndex,
                  y2    = _wasUp ? _lowPivotPrice : _wasDown ? _highPivotPrice : na,
                  color = _wasUp ? _downZagColourSafe : _wasDown ? _upZigColourSafe : na,
                  width = _zigzagWidth,
                  style = _lineStyle)
            
            // EXTEND ONE LINE
            if _doZigZag == DoZigZag.extend  // We simply extend the existing line.
                _zigZag.set_x2(_pivotIndex)
                _zigZag.set_y2(_isHighPivot ? _highPivotPrice : _isLowPivot ? _lowPivotPrice : na)

            // CREATE A SECOND LINE
            if _doZigZag == DoZigZag.createTwo
                // We already created the new line in the CREATE ONE LINE section above.
                // Now, create a vertical line through the Darth Maul pivot candle.
                float _lastLine_y2 = _zigZag.get_y2()  // Get the y2 of the current line, which is the one we created in the CREATE ONE LINE section above.
                float _newLine_y2 = _wasUp ? _highPivotPrice : _wasDown ? _lowPivotPrice : na  // _wasUp and _wasDown are still defined from the line BEFORE the line *to* the Darth Maul candle. Therefore, this new line within the Darth Maul candle is of the SAME direction as that one.
                _color = _wasUp ? _upZigColourSafe : _wasDown ? _downZagColourSafe : na
                _zigZag := line.new(
                  x1    = _pivotIndex,
                  y1    = _lastLine_y2,
                  x2    = _pivotIndex,
                  y2    = _newLine_y2,
                  color = _color,
                  width = _zigzagWidth,
                  style = _lineStyle)


// EXAMPLE USAGE
enum ExampleZigZagDisplay  // Controls which example implementation is displayed.
    none = "None" // Show neither example.
    f_drawZigZags  // Show the single-line-state example.
    m_drawZigZagsArray  // Show the array-backed example.

ExampleZigZagDisplay in_exampleZigZagDisplay = input.enum(
  defval = ExampleZigZagDisplay.f_drawZigZags,
  title = "Zigzag Example To Show",
  tooltip = "Choose whether to show the `f_drawZigZags()` example, the `m_drawZigZagsArray()` example, or neither."
  )
int     in_fractalLookback = input.int(   defval = 5,             title = "Fractal Lookback", minval = 1, maxval = 100, tooltip = "Lookback for the fractal pivot points.")
int     in_zigzagWidth     = input.int(   defval = 3,             title = "Zigzag Line Width", minval = 1, maxval = 10, tooltip = "Width of the zigzag lines.")
color   in_downZagColour   = input.color( defval = color.red,   title = "Down Zigzag Colour", tooltip = "Colour of the down zigzag lines.")
color   in_upZigColour     = input.color( defval = color.green, title = "Up Zigzag Colour", tooltip = "Colour of the up zigzag lines.")
string  in_lineStyle       = input.string(defval="Solid",         title="Line Style", options=["Solid", "Dotted", "Dashed"])

var string lineStyle       = switch in_lineStyle
    "Solid" => line.style_solid
    "Dotted" => line.style_dotted
    "Dashed" => line.style_dashed

// Define some pivot points using the built-in pivot functions.
float pivotHighPrice = ta.pivothigh(high, in_fractalLookback, in_fractalLookback)
float pivotLowPrice  = ta.pivotlow(low,   in_fractalLookback, in_fractalLookback)
// Define the other values we need for the function.
bool isHigh     = not na(pivotHighPrice)  // Note that these values are not exclusive in our example: you can have a High and Low on the same candle. The library handles this gracefully.
bool isLow      = not na(pivotLowPrice)
int  pivotIndex = bar_index[in_fractalLookback]

// Call the function to draw the zigzag lines.
if in_exampleZigZagDisplay == ExampleZigZagDisplay.f_drawZigZags and (isHigh or isLow)  // This check for pivots is not needed at all; you can simply call the function. It's included as a demonstration because it makes the script run slightly faster by not evaluating the function if it's not needed. It is repeated inside the method for robustness because we don't know how the consuming script will call the method.
    // In this function call we do not include the optional parameters, so the default values are used.
    f_drawZigZags(
      _showZigZag = true, 
      _isHighPivot = isHigh,
      _isLowPivot = isLow, 
      _highPivotPrice = pivotHighPrice, 
      _lowPivotPrice = pivotLowPrice,
      _pivotIndex = pivotIndex
      )

//#endregion ZIGZAG FUNCTION `f_drawZigZags`


// #region 🟢🟢🟢🟢🟢🟢 ZIGZAG ARRAY METHOD `m_drawZigZagsArray` 🟢🟢🟢🟢🟢🟢

// @method                This method uses an array to store the zigzag lines. It creates or extends the latest zigzag line. It does not calculate the pivots.
// @param _a_zigZagLines  The array of lines.
// @param _showZigZag     Whether to show the zigzag lines.
// @param _isHighPivot    Whether the current bar confirms a high pivot. Note that pivots are usually confirmed after the bar in which they occur.
// @param _isLowPivot     Whether the current bar confirms a low pivot.
// @param _highPivotPrice The price of the high pivot that was confirmed this bar. It is NOT the high price of the current bar.
// @param _lowPivotPrice  The price of the low pivot that was confirmed this bar. It is NOT the low price of the current bar.
// @param _pivotIndex     The bar index of the pivot that was confirmed this bar. This is not an offset. It's the `bar_index` value of the pivot.
// @param _zigzagWidth    The width of the zigzag lines. Default is 3.
// @param _lineStyle      The style of the zigzag lines. Default is `line.style_solid`.
// @param _upZigColour    The colour of the up zigzag lines. Default is `color.green`. If `na`, the library falls back to `color.green`.
// @param _downZagColour  The colour of the down zigzag lines. Default is `color.red`. If `na`, the library falls back to `color.red`.
// @param _trimArray      If true, the array of lines is kept to a maximum size of two lines (the line elements are not deleted, except that the library may retire the invisible bootstrap seed when it is no longer needed). If false (the default), the array is kept to a maximum of 500 lines (the maximum number of line objects a single Pine script can display). Default is false. The reason for trimming the array is purely to not use more memory than necessary. The calling script is expected to manage the size of the array and delete line objects from it as needed in order to keep the *total* number of lines in the calling script within budget.
// @returns               This function has no explicit returns but it modifies a global array of zigzag lines.
export method m_drawZigZagsArray(array<line> _a_zigZagLines, bool _showZigZag = true, bool _isHighPivot, bool _isLowPivot, float _highPivotPrice, float _lowPivotPrice, int _pivotIndex, int _zigzagWidth = 3, string _lineStyle = line.style_solid, color _upZigColour = color.green, color _downZagColour = color.red, bool _trimArray = false) =>
    if _showZigZag and (_isHighPivot or _isLowPivot)  // If there is no pivot confirmed this bar, there is no line to be created or extended and we do nothing.
        var line _bootstrapSeed = na
        color _upZigColourSafe = f_getUpZigColour(_upZigColour)
        color _downZagColourSafe = f_getDownZagColour(_downZagColour)
        if not na(_bootstrapSeed) and array.indexof(_a_zigZagLines, _bootstrapSeed) == -1
            _bootstrapSeed := na

        // If this is the first pivot, create an invisible line (using `color(na)` is the robust way to set an invisible line) within the very candle where we get the first pivot, ending at the pivot price, so that we have something to draw the next pivot from.
        if _a_zigZagLines.size() == 0
            // We need to be careful here since we only have ONE of the pivots confirmed. Let's use the candle prices instead of the pivot prices. Note that this *will* still work if we want to extend this for a different timeframe.
            float _y1 = _isHighPivot ? low[bar_index - _pivotIndex]  : _isLowPivot ? high[bar_index - _pivotIndex] : na
            float _y2 = _isHighPivot ? high[bar_index - _pivotIndex] : _isLowPivot ? low[bar_index - _pivotIndex]  : na
            line _zigZag = line.new(x1 = _pivotIndex, y1 = _y1, x2 = _pivotIndex, y2 = _y2, color = color(na), width = _zigzagWidth, style = _lineStyle)
            _bootstrapSeed := _zigZag
            _a_zigZagLines.push(_zigZag)  // This is the only time we push to the array without removing the first element.

        else  // If there is already a line, check whether we should extend it or create a new one, or create two.
            // Derive the coordinates and direction of the previous line.
            line  _previousLine   = _a_zigZagLines.last()
            float _previousY1     = _previousLine.get_y1()
            float _previousY2     = _previousLine.get_y2()
            int   _previousX2     = _previousLine.get_x2()
            bool  _wasUp          = _previousY1 <= _previousY2
            bool  _wasDown        = _previousY1 > _previousY2
            // Derive the information we need about the pivot.
            // @variable True if the pivot we are feeding in to the function is on the same candle as an opposing pivot.
            bool  _isDarthMaul    = _isHighPivot and _isLowPivot
            float _highPrice      = _isDarthMaul ? _highPivotPrice : _isHighPivot ? _highPivotPrice : _isLowPivot ? _lowPivotPrice : na
            float _lowPrice       = _isDarthMaul ? _lowPivotPrice  : _isHighPivot ? _highPivotPrice : _isLowPivot ? _lowPivotPrice : na
            bool  _isHigher       = _highPrice > _previousY2
            bool  _isLower        = _lowPrice  < _previousY2
            
            // Decide whether to create or extend the zigzag.
            DoZigZag _doZigZag = DoZigZag.doNothing  // Reset to do nothing each bar.
            if _isDarthMaul
                _doZigZag := DoZigZag.createTwo  // If there are two pivots on the same bar, we create a line through the Darth Maul pivot.
            else
                if _wasUp
                    _doZigZag := switch
                        _isHigher and _isHighPivot => DoZigZag.extend  // This "repaints" the existing line to connect the upZig to the new high.
                        _isLower  and _isLowPivot  => DoZigZag.createOne  // This creates a new line from the previous high to the new low.
                        => DoZigZag.doNothing  // If the new pivot is something else, for example a lower high after a high, we do nothing.
                if _wasDown
                    _doZigZag := switch
                        _isHigher and _isHighPivot => DoZigZag.createOne
                        _isLower  and _isLowPivot  => DoZigZag.extend
                        => DoZigZag.doNothing
            
            // CREATE ONE LINE
            if _doZigZag == DoZigZag.createOne or _doZigZag == DoZigZag.createTwo  // The new line is the opposite direction to the previous one.
                _zigZag = line.new(
                  x1    = _previousX2,
                  y1    = _previousY2,
                  x2    = _pivotIndex,
                  y2    = _wasUp ? _lowPivotPrice : _wasDown ? _highPivotPrice : na,
                  color = _wasUp ? _downZagColourSafe : _wasDown ? _upZigColourSafe : na,
                  width = _zigzagWidth,
                  style = _lineStyle)
                // Add the new line to the end of the array. Remove the first element because the new line does not replace the previous line but is in addition to it.
                if (_trimArray and _a_zigZagLines.size() > 1) or _a_zigZagLines.size() > 500  // For the first visible line, the array size is 1. We want to keep it to 2 elements. So this is the only place we need to check the array size. Pine cleans up lines after a maximum of 500, so there's no point keeping more than that.
                    f_shiftZigZagLine(_a_zigZagLines, _bootstrapSeed)
                _a_zigZagLines.push(_zigZag)
            
            // EXTEND ONE LINE
            if _doZigZag == DoZigZag.extend  // We simply extend the existing line and do nothing with the array at all.
                _previousLine.set_x2(_pivotIndex)
                _previousLine.set_y2(_isHighPivot ? _highPivotPrice : _isLowPivot ? _lowPivotPrice : na)

            // CREATE A SECOND LINE
            if _doZigZag == DoZigZag.createTwo
                // We already created the new line in the CREATE ONE LINE section above and added it to the end of the array.
                // Now, create a vertical line through the Darth Maul pivot candle.
                float _lastLine_y2 = _a_zigZagLines.last().get_y2()  // Get the y2 of the last line in the array, which is the one we created in the CREATE ONE LINE section above.
                float _newLine_y2 = _wasUp ? _highPivotPrice : _wasDown ? _lowPivotPrice : na  // _wasUp and _wasDown are still defined from the line BEFORE the line *to* the Darth Maul candle. Therefore, this new line within the Darth Maul candle is of the SAME direction as that one.
                _color = _wasUp ? _upZigColourSafe : _wasDown ? _downZagColourSafe : na
                _zigZag = line.new(
                  x1    = _pivotIndex,
                  y1    = _lastLine_y2,
                  x2    = _pivotIndex,
                  y2    = _newLine_y2,
                  color = _color,
                  width = _zigzagWidth,
                  style = _lineStyle)
                // Add the new line to the end of the array. Remove the first element so we keep the array to two elements only.
                if _trimArray or _a_zigZagLines.size() > 500
                    f_shiftZigZagLine(_a_zigZagLines, _bootstrapSeed)
                _a_zigZagLines.push(_zigZag)

        //  Remove the invisible bootstrap seed once a real line exists.
        f_retireBootstrapSeedIfNeeded(_a_zigZagLines, _bootstrapSeed)
        if not na(_bootstrapSeed) and array.indexof(_a_zigZagLines, _bootstrapSeed) == -1
            _bootstrapSeed := na


// EXAMPLE USAGE
// Note: We reuse most of the variables defined in the `f_drawZigZags` section.
bool in_trimArray   = input.bool(defval = true, title = "Trim Array", tooltip = "If true, the array of lines is kept to a maximum size of two lines (the line elements are not deleted from the chart, only removed from the array). If false, the array is kept to a maximum of 500 lines (the maximum number of line objects a single Pine script can display).")

// @variable Holds the zigzag line objects.
var array<line> a_zigZagLines = array.new<line>(0, na)

// Call the method to draw the zigzag lines.
if in_exampleZigZagDisplay == ExampleZigZagDisplay.m_drawZigZagsArray and (isHigh or isLow)  // This check for pivots is not needed at all; you can simply call the method. It's included as a demonstration because it makes the script run slightly faster by not evaluating the method if it's not needed. It is repeated inside the method for robustness because we don't know how the consuming script will call the method.
	a_zigZagLines.m_drawZigZagsArray(
	  _showZigZag = true,
	  _isHighPivot = isHigh,
	  _isLowPivot = isLow,
	  _highPivotPrice = pivotHighPrice,
	  _lowPivotPrice = pivotLowPrice,
	  _pivotIndex = pivotIndex,
	  _zigzagWidth = in_zigzagWidth,
	  _lineStyle = lineStyle,
	  _upZigColour = in_upZigColour,
	  _downZagColour = in_downZagColour,
	  _trimArray = in_trimArray
	  )

//#endregion ZIGZAG ARRAY METHOD `m_drawZigZagsArray`