//@version=6

// @description
// Futures helpers for TradingView.
// Provides month code constants and utilities for determining allowed / major
// contract months per futures root (e.g., SI uses HKNUZ).
library("fsl_futures", overlay = false)

// @function 
// Returns the standard CME-style futures month codes as an array.
// @returns array<string> of month codes in order: F,G,H,J,K,M,N,Q,U,V,X,Z
export allMonthCodes() =>
    array.from("F","G","H","J","K","M","N","Q","U","V","X","Z")

// @function
// Returns all month codes as a single string for quick membership checks.
// @returns string "FGHJKMNQUVXZ"
export allMonthCodesStr() =>
    "FGHJKMNQUVXZ"

// @function 
// Returns the major month-code subset for a given futures root.
// If the root is not mapped, defaults to all months.
// @param product_root Futures root symbol, e.g. "SI", "ES", "CL"
// @returns string of allowed month codes (e.g., "HKNUZ" for SI), otherwise "FGHJKMNQUVXZ"
export majorMonthsByRoot(string product_root) =>
    switch product_root
        // Precious Metals
        "SI" => "HKNUZ"
        "GC" => "GJMQVZ"
        "PL" => "FJNV"
        "PA" => "HMUZ"

        // Macro
        "ES"  => "HMUZ"
        "NQ"  => "HMUZ"
        "YM"  => "HMUZ"
        "RTY" => "HMUZ"

        // Grains
        "ZC" => "FHKNUXZ" 
        "ZS" => "FHKNQUX"
        "ZM" => "FHKNQUVZ" 
        "ZL" => "FHKNQUVZ"
        "ZW" => "HKNUZ"
        "KE" => "HKNUZ"
        
        // Soft
        "KC" => "HKNUZ"
        "SB" => "FHKNUV"
        "CC" => "HKNUZ"
        "CT" => "HKNVZ"        
        => allMonthCodesStr()

// @function 
// Returns the allowed month-code subset for a given futures root.
// If the root is not mapped, defaults to all months.
// @param product_root Futures root symbol, e.g. "SI", "ES", "CL"
// @returns string of allowed month codes (e.g., "HKNUZ" for SI), otherwise "FGHJKMNQUVXZ"
export allowedMonthsByRoot(string product_root) =>
    switch product_root
        // Precious Metals
        "PA" => "HMUZ"

        // Macro
        "ES"  => "HMUZ"
        "NQ"  => "HMUZ"
        "YM"  => "HMUZ"
        "RTY" => "HMUZ"

        // Grains
        "ZC" => "HKNUZ" 
        "ZS" => "FHKNQUX"
        "ZM" => "FHKNQUVZ" 
        "ZL" => "FHKNQUVZ"
        "ZW" => "HKNUZ"
        "KE" => "HKNUZ"
        
        // Soft
        "KC" => "HKNUZ"
        "SB" => "HKNV"
        "CC" => "HKNUZ"
        "CT" => "HKNVZ"

        => allMonthCodesStr()


// @function
// Checks whether a month code is major for a given futures root.
// @param product_root Futures root symbol, e.g. "SI"
// @param month_code Single-letter month code, e.g. "H"
// @returns bool true if month_code is included in the major set for that root
export isMajorMonth(string product_root, string month_code) =>
    allowed = majorMonthsByRoot(product_root)
    str.contains(allowed, month_code)

// @function
// Checks whether a month code is allowed for a given futures root.
// @param product_root Futures root symbol, e.g. "SI"
// @param month_code Single-letter month code, e.g. "H"
// @returns bool true if month_code is included in the allowed set for that root
export isAllowedMonth(string product_root, string month_code) =>
    allowed = allowedMonthsByRoot(product_root)
    str.contains(allowed, month_code)

// @function
// Generates a sequence of forward futures contract symbols starting from the
// current calendar month and progressing forward until the requested number
// of contracts is collected. Only contracts whose month codes are present in
// the allowed month set are included.
//
// The function advances month-by-month and automatically rolls the year when
// moving past December. If an exchange prefix is provided, it is prepended
// to each generated symbol.
//
// @param exchange Exchange prefix used for symbol construction
//        (e.g., "COMEX", "CME"). Use "" for no prefix.
// @param product_root Futures root symbol (e.g., "SI", "CL", "ES").
// @param future_numbers Number of forward contracts to generate.
// @param allowed_months String containing allowed futures month codes
//        (e.g., "HMUZ" for quarterly contracts).
// @returns array<string> Array of forward contract symbols ordered by maturity.
export get_forward_curve_symbols(string exchange, string product_root, int future_numbers, string allowed_months) => 

    fut_month_codes = allMonthCodes()

    cur_year  = year(time)
    cur_month = month(time)

    exch_string = exchange != '' ? exchange + ":" : ""

    code_arr = array.new_string(0) 

    while code_arr.size() < future_numbers

        if str.contains(allowed_months, fut_month_codes.get(cur_month - 1))

            month_code = exch_string + product_root + 
             fut_month_codes.get(cur_month - 1) + str.tostring(cur_year)

            code_arr.push(month_code)

        log.info(str.tostring(code_arr.size()))

        cur_month += 1
        cur_year  := cur_month == 13 ? cur_year + 1 : cur_year
        cur_month := cur_month == 13 ? 1 : cur_month

    code_arr

// @type
// Stores data for a single contract point in the forward curve.
// Each instance represents one futures maturity with associated
// market data used for plotting and analysis.
export type CurvePoint
    float price          // Current price of the contract.
    float price_prev     // Previous price used for comparison (e.g., prior session).
    string symbol        // Full contract symbol (e.g., "COMEX:SIH2026").
    float dte            // Days to expiration.
    int time             // Contract timestamp used for ordering or labeling.
    float volume         // Trading volume for the contract.
    float open_interest  // Open interest for the contract.
    int expiration       // Expiration timestamp of the contract.

// @type
// Stores aggregated statistics for a forward curve dataset.
// Typically calculated after collecting all CurvePoint entries
// and used to determine plotting bounds and scaling.
export type CurveSummary
    int max_time     // Maximum contract timestamp in the curve.
    float min_price  // Minimum price across all curve points.
    float max_price  // Maximum price across all curve points.
    float min_prev   // Minimum previous price across all curve points.
    float max_prev   // Maximum previous price across all curve points.


// @function
// Retrieves forward curve data for a list of futures symbols and returns both
// the collected contract data and summary statistics used for scaling and analysis.
//
// For each symbol, the function requests daily data including current price,
// previous price, expiration date, timestamp, and volume. Contracts are filtered
// based on expiration and minimum volume criteria, except for the designated
// spot symbol which is always included.
//
// Valid contracts are stored as CurvePoint records and aggregated into a curve
// array. Summary statistics such as min/max prices and the latest timestamp are
// tracked in a CurveSummary object.
//
// @param symbols Array<string> List of futures symbols forming the forward curve.
// @param spot_symbol Spot or underlying symbol always included in the curve.
// @param volume_filter Minimum volume required for a futures contract to be included.
// @returns [array<fut.CurvePoint>, fut.CurveSummary]
//          Tuple containing the array of curve points and the calculated summary.
export get_forward_curve_data(array<string> symbols, float min_volume, string spot_symbol) =>

    curve = array.new<CurvePoint>()

    curve_sum = CurveSummary.new(
        0, 
        9999999.9, 0, 
        9999999.9, 0
    )

    for fut_symb in symbols
        [fut_price, fut_prev, fut_exp, fut_time, fut_vol] = request.security(fut_symb, 'D', 
        [close, close[1], syminfo.expiration_date, time, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_on)

        fut_vol := nz(int(fut_vol), 0)

        fut_dte = math.round((fut_exp - time) / 1000 / 60 / 60 / 24, 2)

        if fut_symb == spot_symbol or (fut_exp > time and fut_vol >= min_volume)

            curve_sum.max_time := math.max(curve_sum.max_time, fut_time)

            curve_sum.min_price := math.min(curve_sum.min_price, fut_price)
            curve_sum.max_price := math.max(curve_sum.max_price, fut_price)
            curve_sum.min_prev  := math.min(curve_sum.min_prev, fut_prev)
            curve_sum.max_prev  := math.max(curve_sum.max_prev, fut_prev)

            if not na(fut_price)
            
                p = CurvePoint.new(
                fut_price, fut_prev, fut_symb,
                fut_dte, fut_time, fut_vol,
                0, fut_exp
                )

                curve.push(p)
    [curve, curve_sum]

// @function
// Determines whether the forward curve is in contango.
// Contango occurs when the next futures contract trades
// at a higher price than the front contract.
//
// @param curve Array<fut.CurvePoint> Forward curve data.
// @returns bool True if the curve is in contango, otherwise false.
export forward_curve_contango(array<CurvePoint> curve) =>
    contango = true

    if curve.size() >= 2
        if curve.get(0).price > curve.get(1).price
            contango := false

    contango