//@version=6

// @description Convenience tool library containing helper functions for drawing and charting.
library("UTSConvenienceTools")

import TradingView/ta/10

// --- Color ---

// @function Determines on base of the luminance of the given color if the color can be considered a 'dark' color. Usefull for determining the readable font color for arbitrary colored backgrounds. Credits out to: https://www.tradingview.com/script/gxKVXyX5-Light-or-Dark-Mode-Tutorial-Luminance-Detection/
// @param color (color): The actual color value.
// @returns (bool): A boolean value.
export isDarkColor(color color) =>
	red = color.r(color)
	green = color.g(color)
	blue = color.b(color)
	luminance = red + green + blue
	isDark = luminance <= 383
	isDark


// --- Label Small ---

// @function Displays the specified `txt` in a small label at the `yPos` of the current bar. The label points to the lower right.
// @param text (string): A text value.
// @param yPos (float): The y-position value. To have it positioned above the candle pass 'high'.
// @param bgColor (color): The background color value.
// @returns (bool): A boolean value.
export smallLabelLowerRight(string txt, float yPos, color bgColor) => 
	textColor = isDarkColor(bgColor) ? color.white : color.black
    lbl = label.new(bar_index, yPos, text = txt, color = bgColor, style = label.style_label_lower_right, textcolor = textColor, size = size.small)
	lbl

// @function Displays the specified `txt` in a small label at the `yPos` of the current bar. The label points to the upper right.
