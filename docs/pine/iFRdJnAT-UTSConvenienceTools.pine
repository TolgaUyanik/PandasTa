// --- Table ---

// @function Displays a single row info table at the specified position.
// @param headers (array<string>): List of header entries.
// @param row (array<string>): List of value strings matching each header entry.
// @param position (position): Table position (default: position.top_right).
// @returns The table.
export singleRowTable(array<string> headers, array<string> row, string position = position.top_right, color bgColorHeader = color.gray, color textColorHeader = color.white, color bgColorRow = #D3D3D3, color textColorRow = color.black, string textSize = size.normal) => 
	var tableSize = array.size(headers)
	var table tbl = table.new(position, tableSize, 2, frame_color = bgColorHeader, frame_width = 1)
    for i = 0 to (tableSize == 0 ? na : tableSize - 1)
        table.cell(tbl, i, 0, text = array.get(headers, i), bgcolor = bgColorHeader, text_color = textColorHeader, text_size = textSize, text_formatting = text.format_bold)
        table.cell(tbl, i, 1, text = array.get(row, i), bgcolor =  bgColorRow, text_color = textColorRow, text_size = textSize)
	tbl


// --- Comparisons ---

// @function Determines if the given source1 value is higher than source2 value (has 'crossed over') and gives the value back, if applicable.
// @param source (float): The source1 series.
// @param source (float): The source2 series.
// @returns (float): The value crossed over.
export hasCrossOver(float source1, float source2) =>
    float value = ta.crossover(source1, source2) ? source1 : na
	value

// @function Determines if the given source1 value is lower than source2 value (has 'crossed below') and gives the value back, if applicable.
// @param source (float): The source1 series.
// @param source (float): The source2 series.
// @returns (float): The value crossed under.
export hasCrossUnder(float source1, float source2) =>
    float value = ta.crossunder(source1, source2) ? source1 : na
	value

// @function Determines if the given source value is higher than the bar before.
// @param source (float): The source series.
// @returns (bool): A boolean value.
export isRising(float source) =>
    source > source[1]

// @function Determines if the given source value is lower than the bar before.
// @param source (float): The source series.
// @returns (bool): A boolean value.
export isFalling(float source) =>
    source < source[1]

// @function Determines if the given source has not changed since the bar before.
// @param source (float): The source series.
// @returns (bool): A boolean value.
export isFlat(float source) =>
    source == source[1]

// @function Determines if the given source contains a valid value (means not 'na').
// @param source (float): The source series.
// @returns (bool): A boolean value.
export hasValue(float source) =>
    na(source) == false


// --- Helpers ---

// @function Calculate the normalized value between 0 and 1 of a float series. Avoids division by zero by returning mid value if it happens.
// @param source (float): The source series.
// @param length (int): Length of data points to look back.
// @returns (float): The normalized source.
export normalizedSource(float source, int length = 20) =>
    lowSource = ta.lowest(source, length)
    highSource = ta.highest(source, length)
    maRange = highSource - lowSource
    norm = maRange > 0 ? (source - lowSource) / maRange : 0.5
    norm