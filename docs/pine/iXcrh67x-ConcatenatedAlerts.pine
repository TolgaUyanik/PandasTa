//@version=6

// @description TODO: add library description here
library("ConcatenatedAlerts")

//@enum Represents the frequency of fired alerts, like 'alert.freq_all', 'alert.freq_once_per_bar' and 'alert.freq_once_per_bar_close'.
//@field All Fire alerts on every tick, like 'alert.freq_all'.
//@field OncePerBar Fire alerts once per bar, like 'alert.freq_once_per_bar'.
//@field All Fire alerts on every tick, like 'alert.freq_once_per_bar_close'. This option will concatenate all alert messages (on e»ery tick) and fire them all seperated with new lines and with a header saying how many messages it contains.
export enum Frequency
    All = "all"
    OncePerBar = "once_per_bar"
    OncePerBarClose = "once_per_bar_close"

_frequency = input.enum(Frequency.OncePerBarClose, "Frequency")
_alertFreq = input.string(alert.freq_once_per_bar_close, "Alert frequency", [alert.freq_all, alert.freq_once_per_bar, alert.freq_once_per_bar_close])

//@type Holds all the values for the 'Alert' to be used.
//@field Messages Holds the alert messages within the current bar that will be sent according to 'Frequency'.
//@field Frequency The frequency for the final alert. One of 'alert.freq_all', 'alert.freq_once_per_bar' or 'alert.freq_once_per_bar_close'. If 'alert.freq_all' is set the alert messages will be fired on each tick and no concatination will occure. The same when 'alert.freq_once_per_bar' is set, but the alert will only fire once per bar. If 'alert.freq_once_per_bar_close' is set concatenation will occure before sending an alert (with all concatenated messages) on bar close.
//@field SkipAddition Will skip addition of messages. Used internally if 'Frequency' is 'alert.freq_once_per_bar'.
export type Alert
	varip array<string> Messages
	Frequency Frequency
	bool SkipAddition

// @function Concatenates all alert messages (called on every tick) to fire all of them with 'Alert()'.
// @param a_lert The 'Alert' object to be used for the alert messages concatination.
// @param message The string message to be added to the bar alert.
export Concatenate(Alert a_lert, string message) =>
	switch a_lert.Frequency
		Frequency.All => a_lert.Messages.push(message)
		Frequency.OncePerBar =>
		    if barstate.isnew
				a_lert.SkipAddition := false
		    if not a_lert.SkipAddition
				a_lert.SkipAddition := true
				a_lert.Messages.push(message)
		Frequency.OncePerBarClose => a_lert.Messages.push(message)
// @function When the 'Alert.Frequency' is set to fire on the current tick, this function will concatenate all messages on the current bar and fire an alert. Concatenation will occur if 'alert.freq_once_per_bar_close' is set on 'a_lert.Frequency' separated by new lines and a header saying how many messages the bar contains.
// @param a_lert The 'Alert' object to be used for the alert messages concatination and all its 'Messages' will be alerted.
export Alert(Alert a_lert) =>
	string message = na
	switch a_lert.Frequency
		Frequency.OncePerBarClose =>
		    if barstate.isconfirmed and a_lert.Messages.size() > 0
				for alertMessage in a_lert.Messages
					if na(message)
						message := str.format("{0} message/s", a_lert.Messages.size())
					if str.length(message) + str.length(alertMessage) >= 4096
						alert("Message is too long, will cause error,", alert.freq_all)
					message += str.format("\n{0}", alertMessage)
				a_lert.Messages := array.new<string>()//.clear()
		=> // 'alert.freq_all' or 'alert.freq_once_per_bar'
		    if a_lert.Messages.size() > 0
				message := a_lert.Messages.first()
				a_lert.Messages.clear()
	if not na(message)
		alert(message, alert.freq_all)
//@function Helper function to create an 'Alert' object.
//@param frequency The 'Frequency' in the created 'Alert' object.
//@returns The 'Alert' object that can be used for concatination.
export Create(Frequency frequency) =>
	a_lert = Alert.new(array.new<string>(), frequency)
    a_lert
//@function Helper function to convert 'alert.freq_all', 'alert.freq_once_per_bar' or 'lert.freq_once_per_bar_close'.
//@param alertFreq The 'alert.freq_all', 'alert.freq_once_per_bar' or 'lert.freq_once_per_bar_close' to convert to 'Frequency' enum.
//@returns The 'Alert' object that can be used for concatination.
export CreateFromAlertFreq(string alertFreq) =>
	frequency = switch alertFreq
		alert.freq_all => Frequency.All
		alert.freq_once_per_bar => Frequency.OncePerBar
		alert.freq_once_per_bar_close => Frequency.OncePerBarClose
    Create(frequency)

var alertEnum = Create(_frequency)
varip counterEnum = 0
Concatenate(alertEnum, str.format("enum:{0}", counterEnum))
Alert(alertEnum)
counterEnum += 1

var alertAlertFreq = CreateFromAlertFreq(_alertFreq)
varip counterAlertFreq = 0
Concatenate(alertAlertFreq, str.format("freq:{0}", counterAlertFreq))
Alert(alertAlertFreq)
counterAlertFreq += 1