//@version=6
strategy("Clean VWAP ZL Scalper [Single Trigger]", overlay=true, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.01)

// Inputs
src = input.source(close, "Source")
zlLen = input.int(34, "Zero-Lag Length", minval=2)
atrLen = input.int(14, "ATR Length")
stopATR = input.float(1.2, "ATR Stop Mult", step=0.1)
rr1 = input.float(1.5, "Target RR", step=0.1)
vwapBand1 = input.float(1.0, "VWAP Band 1 σ", step=0.25)
vwapBand2 = input.float(2.0, "VWAP Band 2 σ", step=0.25)
volLen = input.int(20, "Volume MA Length")
volMult = input.float(1.05, "Volume Mult", step=0.05)
showBg = input.bool(true, "Background Shading")
showStops = input.bool(true, "Plot SL/TP")

// Helpers
f_zlema(_src, _len) =>
    lag = math.floor((_len - 1) / 2)
    ta.ema(_src + (_src - _src[lag]), _len)

f_bullReject() =>
    body = math.abs(close - open)
    lowerWick = math.min(open, close) - low
    upperWick = high - math.max(open, close)
    body > 0 and lowerWick > body * 1.0 and upperWick <= body * 1.2

f_bearReject() =>
    body = math.abs(close - open)
    lowerWick = math.min(open, close) - low
    upperWick = high - math.max(open, close)
    body > 0 and upperWick > body * 1.0 and lowerWick <= body * 1.2

// Core indicators
zl = f_zlema(src, zlLen)
atr = ta.atr(atrLen)
volMA = ta.sma(volume, volLen)
volExp = volume > volMA * volMult

vwap = ta.vwap(hlc3)
dev = ta.stdev(hlc3, 50)
upper1 = vwap + dev * vwapBand1
lower1 = vwap - dev * vwapBand1
upper2 = vwap + dev * vwapBand2
lower2 = vwap - dev * vwapBand2

// Bias
bullBias = close > zl and close > vwap
bearBias = close < zl and close < vwap

// Zones
pullbackLong = low <= vwap or low <= lower1 or low <= zl
pullbackShort = high >= vwap or high >= upper1 or high >= zl

// Trigger candle
rejectionLong = f_bullReject() or close > open
rejectionShort = f_bearReject() or close < open

// Confirmation
confirmLong = close > open and close >= open[1]
confirmShort = close < open and close <= open[1]

// Single active state
var int lastSignal = 0  // 1 = buy, -1 = sell, 0 = none

buyTrigger = barstate.isconfirmed and bullBias and pullbackLong and rejectionLong and confirmLong and lastSignal != 1
sellTrigger = barstate.isconfirmed and bearBias and pullbackShort and rejectionShort and confirmShort and lastSignal != -1

// Risk
var float longSL = na
var float longTP = na
var float shortSL = na
var float shortTP = na

if buyTrigger
    entry = close
    risk = atr * stopATR
    longSL := entry - risk
    longTP := entry + risk * rr1
    lastSignal := 1
    strategy.close("Short")
    strategy.entry("Long", strategy.long)

if sellTrigger
    entry = close
    risk = atr * stopATR
    shortSL := entry + risk
    shortTP := entry - risk * rr1
    lastSignal := -1
    strategy.close("Long")
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop=longSL, limit=longTP)

if strategy.position_size < 0
    strategy.exit("Short Exit", "Short", stop=shortSL, limit=shortTP)

// Visuals
plot(zl, "Zero-Lag", color=color.new(color.aqua, 0), linewidth=2)
plot(vwap, "VWAP", color=color.new(color.yellow, 0), linewidth=2)
pU1 = plot(upper1, "VWAP +1σ", color=color.new(color.orange, 0))
pL1 = plot(lower1, "VWAP -1σ", color=color.new(color.orange, 0))
pU2 = plot(upper2, "VWAP +2σ", color=color.new(color.red, 0))
pL2 = plot(lower2, "VWAP -2σ", color=color.new(color.green, 0))
fill(pU1, pU2, color=color.new(color.red, 90))
fill(pL1, pL2, color=color.new(color.green, 90))

bgcolor(showBg and bullBias ? color.new(color.green, 88) : showBg and bearBias ? color.new(color.red, 88) : na)

plotshape(buyTrigger, title="Buy", style=shape.labelup, location=location.belowbar, color=color.lime, text="BUY", textcolor=color.white, size=size.small)
plotshape(sellTrigger, title="Sell", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white, size=size.small)

plot(showStops and strategy.position_size > 0 ? longSL : na, "Long SL", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(showStops and strategy.position_size > 0 ? longTP : na, "Long TP", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(showStops and strategy.position_size < 0 ? shortSL : na, "Short SL", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(showStops and strategy.position_size < 0 ? shortTP : na, "Short TP", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)