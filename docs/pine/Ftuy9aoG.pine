//@version=5
indicator("Ultimate ATR Extreme Detector", overlay=false, precision=2)

// ———— 输入参数 ————
length = input.int(14, "ATR Length", minval=1)
maType = input.string("RMA", "MA Type", options=["RMA", "SMA", "EMA", "WMA"])
lookback = input.int(50, "Lookback Period", minval=10)
minMarkers = input.bool(true, "Show Low Markers")
maxMarkers = input.bool(true, "Show High Markers")
showLabels = input.bool(true, "Show Signal Labels")
enableCooldown = input.bool(true, "Enable Alerts Cooldown")
cooldownPeriod = input.int(14, "Cooldown Period", minval=1)

// ———— 计算真实波幅 ————
atrValue = switch maType
    "RMA" => ta.rma(ta.tr, length)
    "SMA" => ta.sma(ta.tr, length)
    "EMA" => ta.ema(ta.tr, length)
    "WMA" => ta.wma(ta.tr, length)

// ———— 核心极值检测 ————
isMin = ta.lowest(atrValue, lookback) == atrValue
isMax = ta.highest(atrValue, lookback) == atrValue

// ———— 告警历史记录 ————
var int lastLowAlert = 0
var int lastHighAlert = 0

// ———— 可视化系统 ————
plotLowMarker = minMarkers and isMin
plotHighMarker = maxMarkers and isMax

// 低波动标记
plotshape(plotLowMarker, "ATR Low", shape.triangleup, location.bottom, 
     color=color.new(#4CAF50, 0), size=size.small)

// 高波动标记
plotshape(plotHighMarker, "ATR High", shape.triangledown, location.top, 
     color=color.new(#FF5252, 0), size=size.small)

// 信号标签
if showLabels and barstate.islast
    if isMin
        label.new(bar_index, atrValue * 0.95, "ATR LOW\n" + str.tostring(atrValue, "#.##"), 
             color=color.new(#4CAF50, 90), textcolor=color.white, 
             style=label.style_label_up, yloc=yloc.price)
    
    if isMax
        label.new(bar_index, atrValue * 1.05, "ATR HIGH\n" + str.tostring(atrValue, "#.##"), 
             color=color.new(#FF5252, 90), textcolor=color.white, 
             style=label.style_label_down, yloc=yloc.price)

// ———— 信息面板 ————
var table infoTable = table.new(position.bottom_right, 2, 2, bgcolor=#00000000)
if barstate.islast
    // 第一行：信号状态
    minStatus = isMin ? "✔" : "✖"
    maxStatus = isMax ? "✔" : "✖"
    
    table.cell(infoTable, 0, 0, "Low (" + str.tostring(lookback) + "): " + minStatus, 
         bgcolor=isMin ? color.new(#4CAF50, 90) : color.gray)
    table.cell(infoTable, 1, 0, "High (" + str.tostring(lookback) + "): " + maxStatus, 
         bgcolor=isMax ? color.new(#FF5252, 90) : color.gray)
    
    // 第二行：冷却状态
    barsSinceLastLow = lastLowAlert > 0 ? bar_index - lastLowAlert : 10000
    barsSinceLastHigh = lastHighAlert > 0 ? bar_index - lastHighAlert : 10000
    
    lowCooldown = "Low CD: " + str.tostring(barsSinceLastLow) + "/" + str.tostring(cooldownPeriod)
    highCooldown = "High CD: " + str.tostring(barsSinceLastHigh) + "/" + str.tostring(cooldownPeriod)
    
    table.cell(infoTable, 0, 1, lowCooldown, 
         bgcolor=barsSinceLastLow <= cooldownPeriod ? color.new(#FF9800, 70) : color.new(#4CAF50, 70))
    table.cell(infoTable, 1, 1, highCooldown, 
         bgcolor=barsSinceLastHigh <= cooldownPeriod ? color.new(#FF9800, 70) : color.new(#FF5252, 70))

// ———— 背景警示 ————
bgcolor(isMin ? color.new(#4CAF50, 90) : isMax ? color.new(#FF5252, 90) : na)

// ———— 警报系统 ————
alertLow = isMin
alertHigh = isMax

alertcondition(alertLow, "ATR Low Signal", "ATR reached lowest level in lookback period")
alertcondition(alertHigh, "ATR High Signal", "ATR reached highest level in lookback period")

// ———— 绘制ATR主线 ————
plot(atrValue, "ATR", color.new(#2962FF, 0), 2)

// ———— 警报标签（带可配置冷却功能）————
var label alertLabel = na
if barstate.islast
    // 计算图表顶部位置
    chartTop = atrValue * 1.5
    
    // 计算自上次告警以来的柱数
    barsSinceLastLow = lastLowAlert > 0 ? bar_index - lastLowAlert : 10000
    barsSinceLastHigh = lastHighAlert > 0 ? bar_index - lastHighAlert : 10000
    
    // 低波动警报（带冷却期判断）
    if isMin and (barsSinceLastLow > cooldownPeriod or not enableCooldown or lastLowAlert == 0)
        alertText = "Alert: ATR Low (" + str.tostring(lookback) + " bars)"
        cooldownMsg = enableCooldown ? "\n⚡ " + str.tostring(barsSinceLastLow) + "/" + str.tostring(cooldownPeriod) + " bars" : ""
        
        if na(alertLabel)
            alertLabel := label.new(bar_index, chartTop, alertText + cooldownMsg, 
                 color=color.new(#4CAF50, 90), textcolor=color.white, 
                 style=label.style_label_lower_right, yloc=yloc.price)
        else
            label.set_text(alertLabel, alertText + cooldownMsg)
            label.set_y(alertLabel, chartTop)
        
        // 记录本次告警bar_index
        lastLowAlert := bar_index
    
    // 高波动警报（带冷却期判断）
    if isMax and (barsSinceLastHigh > cooldownPeriod or not enableCooldown or lastHighAlert == 0)
        alertText = "Alert: ATR High (" + str.tostring(lookback) + " bars)"
        cooldownMsg = enableCooldown ? "\n⚡ " + str.tostring(barsSinceLastHigh) + "/" + str.tostring(cooldownPeriod) + " bars" : ""
        
        if na(alertLabel)
            alertLabel := label.new(bar_index, chartTop, alertText + cooldownMsg, 
                 color=color.new(#FF5252, 90), textcolor=color.white, 
                 style=label.style_label_lower_right, yloc=yloc.price)
        else
            label.set_text(alertLabel, alertText + cooldownMsg)
            label.set_y(alertLabel, chartTop)
        
        // 记录本次告警bar_index
        lastHighAlert := bar_index