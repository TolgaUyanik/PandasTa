// © ITA Trading Tools - itamardrori_
//@version=6
indicator("Smart Money Concepts PRO [ITA]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
showStruct      = input.bool(true,  "Show Swing Structure (HH/HL/LH/LL)", group="Market Structure")
pivotLen        = input.int(5,      "Pivot Lookback", minval=2, maxval=20, group="Market Structure")
structColorBull = input.color(color.new(#089981, 0), "Bullish Color", group="Market Structure")
structColorBear = input.color(color.new(#f23645, 0), "Bearish Color", group="Market Structure")

showBOS    = input.bool(true,  "Show BOS",   group="Break of Structure & CHoCH")
showCHOCH  = input.bool(true,  "Show CHoCH", group="Break of Structure & CHoCH")
maxBreaks  = input.int(5, "Max Active BOS/CHoCH", minval=1, maxval=20, group="Break of Structure & CHoCH")

showOB       = input.bool(true,  "Show Order Blocks", group="Order Blocks")
maxOBs       = input.int(5,      "Max Active OBs", minval=1, maxval=20, group="Order Blocks")
obBullColor  = input.color(color.new(#089981, 80), "Bullish OB Color", group="Order Blocks")
obBearColor  = input.color(color.new(#f23645, 80), "Bearish OB Color", group="Order Blocks")
mitigateOB   = input.bool(true,  "Remove Mitigated OBs", group="Order Blocks")

showFVG       = input.bool(true,  "Show Fair Value Gaps", group="Fair Value Gaps")
maxFVGs       = input.int(10,     "Max Active FVGs", minval=1, maxval=50, group="Fair Value Gaps")
fvgBullColor  = input.color(color.new(#089981, 85), "Bullish FVG Color", group="Fair Value Gaps")
fvgBearColor  = input.color(color.new(#f23645, 85), "Bearish FVG Color", group="Fair Value Gaps")
fillFVG       = input.bool(true,  "Remove Filled FVGs", group="Fair Value Gaps")

// ─── SWING DETECTION ─────────────────────────────────────────────────────────
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

var float lastPH    = na
var float lastPL    = na
var int   lastPHbar = na
var int   lastPLbar = na
var float prevPH    = na
var float prevPL    = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph
    lastPHbar := bar_index - pivotLen
    if showStruct
        phText = ph > nz(prevPH, ph) ? "HH" : "LH"
        phColor = ph > nz(prevPH, ph) ? structColorBull : structColorBear
        label.new(lastPHbar, ph, phText, style=label.style_label_down, color=color.new(color.black, 100), textcolor=phColor, size=size.tiny)

if not na(pl)
    prevPL := lastPL
    lastPL := pl
    lastPLbar := bar_index - pivotLen
    if showStruct
        plText = pl > nz(prevPL, pl) ? "HL" : "LL"
        plColor = pl > nz(prevPL, pl) ? structColorBull : structColorBear
        label.new(lastPLbar, pl, plText, style=label.style_label_up, color=color.new(color.black, 100), textcolor=plColor, size=size.tiny)

// ─── BOS & CHoCH ─────────────────────────────────────────────────────────────
var int trend = 0
var array<line>  breakLines  = array.new<line>()
var array<label> breakLabels = array.new<label>()

bullBreak = not na(lastPH) and close > lastPH and close[1] <= lastPH
bearBreak = not na(lastPL) and close < lastPL and close[1] >= lastPL

if bullBreak
    isCHOCH = trend == -1
    if (isCHOCH and showCHOCH) or (not isCHOCH and showBOS)
        ln = line.new(lastPHbar, lastPH, bar_index, lastPH, color=structColorBull, style=line.style_dashed, width=1)
        midX = math.round((lastPHbar + bar_index) / 2)
        bosText = isCHOCH ? "CHoCH" : "BOS"
        lb = label.new(midX, lastPH, bosText, style=label.style_label_down, color=color.new(color.black, 100), textcolor=structColorBull, size=size.small)
        array.push(breakLines, ln)
        array.push(breakLabels, lb)
        if array.size(breakLines) > maxBreaks
            line.delete(array.shift(breakLines))
            label.delete(array.shift(breakLabels))
    trend := 1

if bearBreak
    isCHOCH = trend == 1
    if (isCHOCH and showCHOCH) or (not isCHOCH and showBOS)
        ln = line.new(lastPLbar, lastPL, bar_index, lastPL, color=structColorBear, style=line.style_dashed, width=1)
        midX = math.round((lastPLbar + bar_index) / 2)
        bosText = isCHOCH ? "CHoCH" : "BOS"
        lb = label.new(midX, lastPL, bosText, style=label.style_label_up, color=color.new(color.black, 100), textcolor=structColorBear, size=size.small)
        array.push(breakLines, ln)
        array.push(breakLabels, lb)
        if array.size(breakLines) > maxBreaks
            line.delete(array.shift(breakLines))
            label.delete(array.shift(breakLabels))
    trend := -1

// ─── ORDER BLOCKS ────────────────────────────────────────────────────────────
var array<box> bullOBs = array.new<box>()
var array<box> bearOBs = array.new<box>()

if showOB and bullBreak
    int idx = 1
    while idx < 30 and close[idx] >= open[idx]
        idx += 1
    if idx < 30
        b = box.new(bar_index - idx, high[idx], bar_index, low[idx], bgcolor=obBullColor, border_color=color.new(structColorBull, 50), border_width=1)
        array.push(bullOBs, b)
        if array.size(bullOBs) > maxOBs
            box.delete(array.shift(bullOBs))

if showOB and bearBreak
    int idx = 1
    while idx < 30 and close[idx] <= open[idx]
        idx += 1
    if idx < 30
        b = box.new(bar_index - idx, high[idx], bar_index, low[idx], bgcolor=obBearColor, border_color=color.new(structColorBear, 50), border_width=1)
        array.push(bearOBs, b)
        if array.size(bearOBs) > maxOBs
            box.delete(array.shift(bearOBs))

if showOB and array.size(bullOBs) > 0
    for i = array.size(bullOBs) - 1 to 0
        b = array.get(bullOBs, i)
        box.set_right(b, bar_index)
        if mitigateOB and low <= box.get_top(b) and low >= box.get_bottom(b)
            box.delete(b)
            array.remove(bullOBs, i)

if showOB and array.size(bearOBs) > 0
    for i = array.size(bearOBs) - 1 to 0
        b = array.get(bearOBs, i)
        box.set_right(b, bar_index)
        if mitigateOB and high >= box.get_bottom(b) and high <= box.get_top(b)
            box.delete(b)
            array.remove(bearOBs, i)

// ─── FAIR VALUE GAPS ─────────────────────────────────────────────────────────
var array<box> bullFVGs = array.new<box>()
var array<box> bearFVGs = array.new<box>()

if showFVG and low > high[2]
    b = box.new(bar_index - 2, low, bar_index, high[2], bgcolor=fvgBullColor, border_color=color.new(structColorBull, 60), border_width=1)
    array.push(bullFVGs, b)
    if array.size(bullFVGs) > maxFVGs
        box.delete(array.shift(bullFVGs))

if showFVG and high < low[2]
    b = box.new(bar_index - 2, low[2], bar_index, high, bgcolor=fvgBearColor, border_color=color.new(structColorBear, 60), border_width=1)
    array.push(bearFVGs, b)
    if array.size(bearFVGs) > maxFVGs
        box.delete(array.shift(bearFVGs))

if showFVG and array.size(bullFVGs) > 0
    for i = array.size(bullFVGs) - 1 to 0
        b = array.get(bullFVGs, i)
        box.set_right(b, bar_index)
        if fillFVG and low <= box.get_bottom(b)
            box.delete(b)
            array.remove(bullFVGs, i)

if showFVG and array.size(bearFVGs) > 0
    for i = array.size(bearFVGs) - 1 to 0
        b = array.get(bearFVGs, i)
        box.set_right(b, bar_index)
        if fillFVG and high >= box.get_top(b)
            box.delete(b)
            array.remove(bearFVGs, i)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(bullBreak, "Bullish BOS/CHoCH", "Bullish structure break detected")
alertcondition(bearBreak, "Bearish BOS/CHoCH", "Bearish structure break detected")
