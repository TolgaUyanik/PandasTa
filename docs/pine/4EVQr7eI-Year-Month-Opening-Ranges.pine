//@version=6
indicator(
     "Year + Month Opening Ranges",
     shorttitle = "YOR + MOR",
     overlay = true,
     max_labels_count = 20
)

//────────────────────────────────────────────────────────────
// INPUTS
//────────────────────────────────────────────────────────────
groupYear = "Year Opening Range"

showYearRange = input.bool(
     true,
     "Show Year Opening Range",
     group = groupYear
)

yearHighColor = input.color(
     color.green,
     "YOH Color",
     group = groupYear
)

yearLowColor = input.color(
     color.red,
     "YOL Color",
     group = groupYear
)

yearLineWidth = input.int(
     2,
     "Year Line Width",
     minval = 1,
     maxval = 5,
     group = groupYear
)

shadeYearRange = input.bool(
     false,
     "Shade Year Range",
     group = groupYear
)

//────────────────────────────────────────────────────────────
groupMonth = "Month Opening Range"

showMonthRange = input.bool(
     true,
     "Show Month Opening Range",
     group = groupMonth
)

monthHighColor = input.color(
     color.blue,
     "MOH Color",
     group = groupMonth
)

monthLowColor = input.color(
     color.orange,
     "MOL Color",
     group = groupMonth
)

monthLineWidth = input.int(
     2,
     "Month Line Width",
     minval = 1,
     maxval = 5,
     group = groupMonth
)

shadeMonthRange = input.bool(
     false,
     "Shade Month Range",
     group = groupMonth
)

//────────────────────────────────────────────────────────────
groupLabels = "Labels"

showLabels = input.bool(
     true,
     "Show Labels",
     group = groupLabels
)

showPrices = input.bool(
     false,
     "Include Price in Labels",
     group = groupLabels
)

labelOffset = input.int(
     3,
     "Label Offset",
     minval = 0,
     maxval = 50,
     group = groupLabels
)

//────────────────────────────────────────────────────────────
// CASH-SESSION TICKER
//────────────────────────────────────────────────────────────
string cashTicker = ticker.new(
     syminfo.prefix,
     syminfo.ticker,
     session.regular
)

//────────────────────────────────────────────────────────────
// OPENING-RANGE CALCULATION
//────────────────────────────────────────────────────────────
getOpeningRanges() =>
    var float yearORHigh = na
    var float yearORLow = na
    var float monthORHigh = na
    var float monthORLow = na

    bool firstTradingDayOfYear =
         na(year[1]) or year != year[1]

    bool firstTradingDayOfMonth =
         na(month[1]) or
         month != month[1] or
         year != year[1]

    if firstTradingDayOfYear
        yearORHigh := high
        yearORLow := low

    if firstTradingDayOfMonth
        monthORHigh := high
        monthORLow := low

    [yearORHigh, yearORLow, monthORHigh, monthORLow]

[yearORHigh, yearORLow, monthORHigh, monthORLow] = request.security(
     cashTicker,
     "D",
     getOpeningRanges(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

//────────────────────────────────────────────────────────────
// DETECT NEW MONTHS AND YEARS
//────────────────────────────────────────────────────────────
bool newCalendarYear =
     na(year[1]) or year != year[1]

bool newCalendarMonth =
     na(month[1]) or
     month != month[1] or
     year != year[1]

// Add one-bar gaps at period changes.
// plot.style_linebr will not connect across na values.
float displayedYOH =
     newCalendarYear ? na : yearORHigh

float displayedYOL =
     newCalendarYear ? na : yearORLow

float displayedMOH =
     newCalendarMonth ? na : monthORHigh

float displayedMOL =
     newCalendarMonth ? na : monthORLow

//────────────────────────────────────────────────────────────
// PLOTS
//────────────────────────────────────────────────────────────
yohPlot = plot(
     showYearRange ? displayedYOH : na,
     title = "YOH",
     color = yearHighColor,
     linewidth = yearLineWidth,
     style = plot.style_linebr
)

yolPlot = plot(
     showYearRange ? displayedYOL : na,
     title = "YOL",
     color = yearLowColor,
     linewidth = yearLineWidth,
     style = plot.style_linebr
)

mohPlot = plot(
     showMonthRange ? displayedMOH : na,
     title = "MOH",
     color = monthHighColor,
     linewidth = monthLineWidth,
     style = plot.style_linebr
)

molPlot = plot(
     showMonthRange ? displayedMOL : na,
     title = "MOL",
     color = monthLowColor,
     linewidth = monthLineWidth,
     style = plot.style_linebr
)

//────────────────────────────────────────────────────────────
// OPTIONAL RANGE SHADING
//────────────────────────────────────────────────────────────
fill(
     yohPlot,
     yolPlot,
     color = shadeYearRange
         ? color.new(yearHighColor, 92)
         : na,
     title = "Year Opening Range Fill"
)

fill(
     mohPlot,
     molPlot,
     color = shadeMonthRange
         ? color.new(monthHighColor, 92)
         : na,
     title = "Month Opening Range Fill"
)

//────────────────────────────────────────────────────────────
// RIGHT-SIDE LABELS
//────────────────────────────────────────────────────────────
var label yohLabel = na
var label yolLabel = na
var label mohLabel = na
var label molLabel = na

if barstate.islast
    label.delete(yohLabel)
    label.delete(yolLabel)
    label.delete(mohLabel)
    label.delete(molLabel)

    string yohText = showPrices
         ? "YOH  " + str.tostring(yearORHigh, format.mintick)
         : "YOH"

    string yolText = showPrices
         ? "YOL  " + str.tostring(yearORLow, format.mintick)
         : "YOL"

    string mohText = showPrices
         ? "MOH  " + str.tostring(monthORHigh, format.mintick)
         : "MOH"

    string molText = showPrices
         ? "MOL  " + str.tostring(monthORLow, format.mintick)
         : "MOL"

    if showLabels and showYearRange and not na(yearORHigh)
        yohLabel := label.new(
             bar_index + labelOffset,
             yearORHigh,
             yohText,
             style = label.style_label_left,
             color = yearHighColor,
             textcolor = color.white,
             size = size.small
        )

    if showLabels and showYearRange and not na(yearORLow)
        yolLabel := label.new(
             bar_index + labelOffset,
             yearORLow,
             yolText,
             style = label.style_label_left,
             color = yearLowColor,
             textcolor = color.white,
             size = size.small
        )

    if showLabels and showMonthRange and not na(monthORHigh)
        mohLabel := label.new(
             bar_index + labelOffset,
             monthORHigh,
             mohText,
             style = label.style_label_left,
             color = monthHighColor,
             textcolor = color.white,
             size = size.small
        )

    if showLabels and showMonthRange and not na(monthORLow)
        molLabel := label.new(
             bar_index + labelOffset,
             monthORLow,
             molText,
             style = label.style_label_left,
             color = monthLowColor,
             textcolor = color.white,
             size = size.small
        )

//────────────────────────────────────────────────────────────
// POSITION STATUS
//
//  1 = above range
//  0 = inside range
// -1 = below range
//────────────────────────────────────────────────────────────
int yearRangeStatus =
     close > yearORHigh ? 1 :
     close < yearORLow ? -1 :
     0

int monthRangeStatus =
     close > monthORHigh ? 1 :
     close < monthORLow ? -1 :
     0

// Hidden plots for Pine Screener use.
plot(
     yearRangeStatus,
     title = "Year Range Status",
     display = display.none
)

plot(
     monthRangeStatus,
     title = "Month Range Status",
     display = display.none
)

plot(
     close > yearORHigh ? 1 : 0,
     title = "Above YOH",
     display = display.none
)

plot(
     close < yearORLow ? 1 : 0,
     title = "Below YOL",
     display = display.none
)

plot(
     close > monthORHigh ? 1 : 0,
     title = "Above MOH",
     display = display.none
)

plot(
     close < monthORLow ? 1 : 0,
     title = "Below MOL",
     display = display.none
)

//────────────────────────────────────────────────────────────
// ALERTS
//────────────────────────────────────────────────────────────
alertcondition(
     ta.crossover(close, yearORHigh),
     title = "Cross Above YOH",
     message = "{{ticker}} crossed above the Year Opening Range high."
)

alertcondition(
     ta.crossunder(close, yearORLow),
     title = "Cross Below YOL",
     message = "{{ticker}} crossed below the Year Opening Range low."
)

alertcondition(
     ta.crossover(close, monthORHigh),
     title = "Cross Above MOH",
     message = "{{ticker}} crossed above the Month Opening Range high."
)

alertcondition(
     ta.crossunder(close, monthORLow),
     title = "Cross Below MOL",
     message = "{{ticker}} crossed below the Month Opening Range low."
)