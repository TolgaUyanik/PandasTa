//@version=6
indicator("Prime Strategy Swing", shorttitle="Prime Strategy Swing", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────

i_showSwings   = input.bool(true,  "Mostrar Swing H/L",           group="Visibilidad")
i_showLiq      = input.bool(true,  "Mostrar Liquidez (bombitas)", group="Visibilidad")
i_showBosChoch = input.bool(true,  "Mostrar BOS / CHoCH",         group="Visibilidad")
i_showVP       = input.bool(false, "Mostrar Volume Profile",      group="Visibilidad")
i_showZones    = input.bool(true,  "Mostrar Zonas",               group="Visibilidad")
i_showOB       = input.bool(true,  "Mostrar Order Blocks",        group="Visibilidad")

i_swingLen   = input.int(5,  "Sensibilidad Swings",             minval=1, maxval=50,  group="Configuración")
i_zoneExtend = input.int(30, "Extensión zona derecha (barras)", minval=5, maxval=200, group="Configuración")

i_useChartTF  = input.bool(false, "Usar temporalidad del gráfico", group="BOS / CHoCH TF")
i_bosChochTF  = input.string("30", "Temporalidad fija",
     options=["5", "15", "30", "60", "240", "D"], group="BOS / CHoCH TF")

i_useSwingChartTF = input.bool(false, "Usar temporalidad del gráfico", group="Swings TF")
i_swingTF         = input.string("30", "Temporalidad fija",
     options=["5", "15", "30", "60", "240", "D"], group="Swings TF")

i_showSignals  = input.bool(true,  "Activar señales PRIME",      group="Señales")
i_signalStartH = input.int(9,  "H inicio", minval=0, maxval=23,  group="Señales", inline="start")
i_signalStartM = input.int(30, "M",        minval=0, maxval=59,  group="Señales", inline="start")
i_signalEndH   = input.int(17, "H fin",    minval=0, maxval=23,  group="Señales", inline="end")
i_signalEndM   = input.int(0,  "M",        minval=0, maxval=59,  group="Señales", inline="end")
i_maxSignals   = input.int(1,  "Máx señales por día", minval=1, maxval=10, group="Señales")

nwH           = input.float(4., "NW Bandwidth", minval=0, group="NW Filter")
nwMult        = input.float(3., "NW Mult",      minval=0, group="NW Filter")
i_showNWLines = input.bool(false, "Mostrar líneas NW", group="NW Filter")

i_showEMA     = input.bool(true, "Mostrar EMA", group="EMA")
i_emaLen      = input.int(200, "Longitud EMA", minval=1, group="EMA")
i_emaSource   = input.source(close, "Fuente EMA", group="EMA")
i_emaUpCol    = input.color(color.new(color.teal, 0), "Color EMA alcista", group="EMA")
i_emaDownCol  = input.color(color.new(color.red, 0),  "Color EMA bajista", group="EMA")

i_vpRows     = input.int(30, "Filas del Volume Profile",  minval=5,  maxval=40,  group="Volume Profile")
i_vpWidth    = input.int(20, "Ancho del perfil (barras)", minval=10, maxval=100, group="Volume Profile")
i_vpPocColor = input.color(color.new(color.yellow, 0),  "Color POC",             group="Volume Profile")
i_vpBullCol  = input.color(color.new(color.teal,   50), "Color barras alcistas", group="Volume Profile")
i_vpBearCol  = input.color(color.new(color.red,    50), "Color barras bajistas", group="Volume Profile")

i_showTimeLine = input.bool(false, "Línea vertical de horario",   group="Línea Horario")
i_timeHour     = input.int(9,  "H", minval=0, maxval=23,          group="Línea Horario", inline="hora")
i_timeMin      = input.int(30, "M", minval=0, maxval=59,          group="Línea Horario", inline="hora")
i_timeColor    = input.color(color.new(color.white, 40), "Color", group="Línea Horario")

i_showDecree = input.bool(true, "Mostrar decreto", group="Decreto")
i_decretoL2  = input.string("Soy disciplinado. Espero la zona del 85%. Sigo mi plan.", "Texto", group="Decreto")

// ─────────────────────────────────────────────
// CONSTANTES ORDER BLOCKS
// ─────────────────────────────────────────────

int   OB_SEARCH  = 20
int   OB_MAX     = 3
int   OB_MINBARS = 0
float OB_DISP    = 0.0
bool  OB_MITIG_W = true
color OB_BG      = color.new(color.gray, 75)
color OB_BORDER  = color.new(color.gray, 30)
color OB_MID     = color.new(color.gray, 20)

string bcTF    = i_useChartTF      ? timeframe.period : i_bosChochTF
string swingTF = i_useSwingChartTF ? timeframe.period : i_swingTF

// ─────────────────────────────────────────────
// NW FILTER
// ─────────────────────────────────────────────

gauss_nw(x, h) => math.exp(-(math.pow(x, 2) / (h * h * 2)))

var float[] nwCoefs = array.new_float(0)
var float   nwDen   = 0.

if barstate.isfirst
    for i = 0 to 499
        w = gauss_nw(i, nwH)
        array.push(nwCoefs, w)
    nwDen := array.sum(nwCoefs)

nwOut = 0.
for i = 0 to 499
    nwOut += close[i] * array.get(nwCoefs, i)
nwOut /= nwDen
nwMae   = ta.sma(math.abs(close - nwOut), 499) * nwMult
nwLower = nwOut - nwMae
nwUpper = nwOut + nwMae

plot(i_showNWLines ? nwUpper : na, "NW Upper", color.new(color.teal, 40), 1, plot.style_line)
plot(i_showNWLines ? nwOut   : na, "NW Mid",   color.new(color.white, 50), 1, plot.style_line)
plot(i_showNWLines ? nwLower : na, "NW Lower", color.new(color.red,   40), 1, plot.style_line)

// ─────────────────────────────────────────────
// EMA
// ─────────────────────────────────────────────

emaVal   = ta.ema(i_emaSource, i_emaLen)
emaColor = emaVal > emaVal[1] ? i_emaUpCol : i_emaDownCol

plot(i_showEMA ? emaVal : na, "EMA", color=emaColor, linewidth=2)

// ─────────────────────────────────────────────
// SWINGS HTF — usando bar_index en el momento del pivot
// ─────────────────────────────────────────────

htfSwingHigh  = request.security(syminfo.tickerid, swingTF, ta.pivothigh(high, i_swingLen, i_swingLen), lookahead=barmerge.lookahead_off)
htfSwingLow   = request.security(syminfo.tickerid, swingTF, ta.pivotlow(low,  i_swingLen, i_swingLen),  lookahead=barmerge.lookahead_off)
htfSwingHTime = request.security(syminfo.tickerid, swingTF, time[i_swingLen], lookahead=barmerge.lookahead_off)
htfSwingLTime = request.security(syminfo.tickerid, swingTF, time[i_swingLen], lookahead=barmerge.lookahead_off)

var float htfPrevHigh = na
var float htfPrevLow  = na

// Zona: guardar precio Y tiempo (para anclar con xloc.bar_time)
var float zoneSwingH     = na
var int   zoneSwingHTime = na
var float zoneSwingL     = na
var int   zoneSwingLTime = na

var float fixedZoneHigh  = na
var float fixedZoneLow   = na
var int   fixedZoneTime  = na  // tiempo de inicio en bar_time
var int   fixedZoneTrend = 0
var bool  zoneNeedsUpdate = true

if not na(htfSwingHigh) and i_showSwings
    string lblH = na(htfPrevHigh) ? "H" : htfSwingHigh > htfPrevHigh ? "HH" : "LH"
    color  colH = lblH == "HH" ? color.new(color.red, 10) : color.new(color.orange, 10)
    label.new(x=htfSwingHTime, y=htfSwingHigh, text=lblH,
              xloc=xloc.bar_time, yloc=yloc.price,
              style=label.style_label_down, color=colH, textcolor=color.white, size=size.small)
    htfPrevHigh      := htfSwingHigh
    zoneSwingH       := htfSwingHigh
    zoneSwingHTime   := htfSwingHTime

if not na(htfSwingLow) and i_showSwings
    string lblL = na(htfPrevLow) ? "L" : htfSwingLow < htfPrevLow ? "LL" : "HL"
    color  colL = lblL == "LL" ? color.new(color.teal, 10) : color.new(color.green, 10)
    label.new(x=htfSwingLTime, y=htfSwingLow, text=lblL,
              xloc=xloc.bar_time, yloc=yloc.price,
              style=label.style_label_up, color=colL, textcolor=color.white, size=size.small)
    htfPrevLow       := htfSwingLow
    zoneSwingL       := htfSwingLow
    zoneSwingLTime   := htfSwingLTime

// ─────────────────────────────────────────────
// PIVOTS GRÁFICO
// ─────────────────────────────────────────────

phVal  = ta.pivothigh(high, i_swingLen, i_swingLen)
plVal  = ta.pivotlow(low,   i_swingLen, i_swingLen)
phTime = time[i_swingLen]
plTime = time[i_swingLen]

var float lastConfSH     = na
var int   lastConfSHBar  = na
var int   lastConfSHTime = na
var float lastConfSL     = na
var int   lastConfSLBar  = na
var int   lastConfSLTime = na

if not na(phVal)
    lastConfSH     := phVal
    lastConfSHBar  := bar_index - i_swingLen
    lastConfSHTime := phTime

if not na(plVal)
    lastConfSL     := plVal
    lastConfSLBar  := bar_index - i_swingLen
    lastConfSLTime := plTime

// ─────────────────────────────────────────────
// LIQUIDEZ
// ─────────────────────────────────────────────

var float[] liqHighs     = array.new_float(0)
var int[]   liqHighTimes = array.new_int(0)
var line[]  liqHighLines = array.new_line(0)
var label[] liqHighDots  = array.new_label(0)
var float[] liqLows      = array.new_float(0)
var int[]   liqLowTimes  = array.new_int(0)
var line[]  liqLowLines  = array.new_line(0)
var label[] liqLowDots   = array.new_label(0)

MAX_LIQ = 5

if not na(phVal) and i_showLiq
    array.unshift(liqHighs, phVal)
    array.unshift(liqHighTimes, phTime)
    _lh = line.new(x1=phTime, y1=phVal, x2=time, y2=phVal, xloc=xloc.bar_time,
                   color=color.new(color.red, 50), style=line.style_dotted, width=1)
    array.unshift(liqHighLines, _lh)
    _dh = label.new(x=phTime, y=phVal, text="●", xloc=xloc.bar_time, yloc=yloc.price,
                    style=label.style_none, textcolor=color.new(color.red, 20), size=size.normal)
    array.unshift(liqHighDots, _dh)
    if array.size(liqHighs) > MAX_LIQ
        array.pop(liqHighs)
        array.pop(liqHighTimes)
        line.delete(array.pop(liqHighLines))
        label.delete(array.pop(liqHighDots))

if not na(plVal) and i_showLiq
    array.unshift(liqLows, plVal)
    array.unshift(liqLowTimes, plTime)
    _ll = line.new(x1=plTime, y1=plVal, x2=time, y2=plVal, xloc=xloc.bar_time,
                   color=color.new(color.teal, 50), style=line.style_dotted, width=1)
    array.unshift(liqLowLines, _ll)
    _dl = label.new(x=plTime, y=plVal, text="●", xloc=xloc.bar_time, yloc=yloc.price,
                    style=label.style_none, textcolor=color.new(color.teal, 20), size=size.normal)
    array.unshift(liqLowDots, _dl)
    if array.size(liqLows) > MAX_LIQ
        array.pop(liqLows)
        array.pop(liqLowTimes)
        line.delete(array.pop(liqLowLines))
        label.delete(array.pop(liqLowDots))

if i_showLiq
    if array.size(liqHighLines) > 0
        for i = 0 to array.size(liqHighLines) - 1
            line.set_x2(array.get(liqHighLines, i), time)
    if array.size(liqLowLines) > 0
        for i = 0 to array.size(liqLowLines) - 1
            line.set_x2(array.get(liqLowLines, i), time)

if array.size(liqHighs) > 0
    i = 0
    while i < array.size(liqHighs)
        if high >= array.get(liqHighs, i)
            array.remove(liqHighs, i)
            array.remove(liqHighTimes, i)
            line.delete(array.remove(liqHighLines, i))
            label.delete(array.remove(liqHighDots, i))
        else
            i += 1

if array.size(liqLows) > 0
    i = 0
    while i < array.size(liqLows)
        if low <= array.get(liqLows, i)
            array.remove(liqLows, i)
            array.remove(liqLowTimes, i)
            line.delete(array.remove(liqLowLines, i))
            label.delete(array.remove(liqLowDots, i))
        else
            i += 1

// ─────────────────────────────────────────────
// BOS / CHoCH
// ─────────────────────────────────────────────

htfPH     = request.security(syminfo.tickerid, bcTF, ta.pivothigh(high, 5, 5), lookahead=barmerge.lookahead_off)
htfPL     = request.security(syminfo.tickerid, bcTF, ta.pivotlow(low,  5, 5),  lookahead=barmerge.lookahead_off)
htfPHTime = request.security(syminfo.tickerid, bcTF, time[5], lookahead=barmerge.lookahead_off)
htfPLTime = request.security(syminfo.tickerid, bcTF, time[5], lookahead=barmerge.lookahead_off)
htfClose  = request.security(syminfo.tickerid, bcTF, close, lookahead=barmerge.lookahead_off)
htfHi     = request.security(syminfo.tickerid, bcTF, high,  lookahead=barmerge.lookahead_off)
htfLo     = request.security(syminfo.tickerid, bcTF, low,   lookahead=barmerge.lookahead_off)

var float htfLastSH     = na
var int   htfLastSHTime = na
var float htfLastSL     = na
var int   htfLastSLTime = na
var int   trend         = 0
var int   chochDir      = 0

if not na(htfPH)
    htfLastSH     := htfPH
    htfLastSHTime := htfPHTime
if not na(htfPL)
    htfLastSL     := htfPL
    htfLastSLTime := htfPLTime

bool htfBullBreakBody = not na(htfLastSH) and htfClose > htfLastSH and barstate.isconfirmed
bool htfBullBreakWick = not na(htfLastSH) and htfHi   > htfLastSH and htfClose <= htfLastSH and barstate.isconfirmed
bool htfBearBreakBody = not na(htfLastSL) and htfClose < htfLastSL and barstate.isconfirmed
bool htfBearBreakWick = not na(htfLastSL) and htfLo   < htfLastSL and htfClose >= htfLastSL and barstate.isconfirmed
bool htfBullBreak     = htfBullBreakBody or htfBullBreakWick
bool htfBearBreak     = htfBearBreakBody or htfBearBreakWick

f_midTime(_t1, _t2) => int(_t1 + (_t2 - _t1) / 2)

f_drawStructure(_x1, _y, _x2, _solid, _bull, _txt) =>
    _col   = _bull ? color.new(color.teal, 0) : color.new(color.red, 0)
    _style = _solid ? line.style_solid : line.style_dotted
    line.new(x1=_x1, y1=_y, x2=_x2, y2=_y, xloc=xloc.bar_time, color=_col, style=_style, width=2)
    label.new(x=f_midTime(_x1, _x2), y=_y, text=_txt, xloc=xloc.bar_time, yloc=yloc.price,
              style=label.style_none, textcolor=_col, size=size.small)

if i_showBosChoch
    if htfBullBreak and trend != 1
        f_drawStructure(htfLastSHTime, htfLastSH, time, htfBullBreakBody, true, "CHoCH")
        trend           := 1
        chochDir        := 1
        zoneNeedsUpdate := true
        htfLastSH       := na
    else if htfBullBreak and trend == 1
        f_drawStructure(htfLastSHTime, htfLastSH, time, htfBullBreakBody, true, "BOS")
        htfLastSH := na
    if htfBearBreak and trend != -1
        f_drawStructure(htfLastSLTime, htfLastSL, time, htfBearBreakBody, false, "CHoCH")
        trend           := -1
        chochDir        := -1
        zoneNeedsUpdate := true
        htfLastSL       := na
    else if htfBearBreak and trend == -1
        f_drawStructure(htfLastSLTime, htfLastSL, time, htfBearBreakBody, false, "BOS")
        htfLastSL := na

// ─────────────────────────────────────────────
// ZONA FIJA
// ─────────────────────────────────────────────

bool invalidateBear = fixedZoneTrend == -1 and not na(fixedZoneLow)  and close < fixedZoneLow  and close < open and barstate.isconfirmed
bool invalidateBull = fixedZoneTrend ==  1 and not na(fixedZoneHigh) and close > fixedZoneHigh and close > open and barstate.isconfirmed

if invalidateBear or invalidateBull
    zoneNeedsUpdate := true

if zoneNeedsUpdate and not na(zoneSwingH) and not na(zoneSwingL) and trend != 0
    fixedZoneHigh   := math.max(zoneSwingH, zoneSwingL)
    fixedZoneLow    := math.min(zoneSwingH, zoneSwingL)
    // Tiempo de inicio = el más antiguo de los dos swings
    fixedZoneTime   := math.min(zoneSwingHTime, zoneSwingLTime)
    fixedZoneTrend  := trend
    zoneNeedsUpdate := false

// ─────────────────────────────────────────────
// NIVELES FIBONACCI
// ─────────────────────────────────────────────

var float zMid = na
var float z85  = na
var float z70  = na
var float z30  = na
var float z15  = na

if not na(fixedZoneHigh) and not na(fixedZoneLow)
    float zRange = fixedZoneHigh - fixedZoneLow
    zMid := fixedZoneLow + zRange * 0.50
    z85  := fixedZoneLow + zRange * 0.85
    z70  := fixedZoneLow + zRange * 0.70
    z30  := fixedZoneLow + zRange * 0.30
    z15  := fixedZoneLow + zRange * 0.15

// ─────────────────────────────────────────────
// ORDER BLOCKS
// ─────────────────────────────────────────────

var box[]   obBoxes = array.new_box()
var float[] obTops  = array.new_float()
var float[] obBots  = array.new_float()
var int[]   obDirs  = array.new_int()
var int[]   obBorn  = array.new_int()
var line[]  obMids  = array.new_line()
var int lastBullOBBar = na
var int lastBearOBBar = na

bullBOS = not na(lastConfSH) and close > lastConfSH and close[1] <= lastConfSH
bearBOS = not na(lastConfSL) and close < lastConfSL and close[1] >= lastConfSL

atr14    = ta.atr(14)
bodySize = math.abs(close - open)
bool dispOK    = OB_DISP <= 0 or bodySize >= OB_DISP * atr14
bool allowBull = na(lastBullOBBar) or (bar_index - lastBullOBBar) >= OB_MINBARS
bool allowBear = na(lastBearOBBar) or (bar_index - lastBearOBBar) >= OB_MINBARS
int  obRight      = bar_index + i_zoneExtend
int  safeLookback = math.min(OB_SEARCH, bar_index - 1)

if i_showOB and bullBOS and dispOK and allowBull
    int   legStart = na(lastConfSLBar) ? 0 : lastConfSLBar
    int   bestBar  = na
    float bestLow  = na
    for i = 1 to safeLookback
        if (bar_index - i) < legStart
            break
        if close[i] < open[i]
            if na(bestLow) or low[i] < bestLow
                bestBar := i
                bestLow := low[i]
    if not na(bestBar)
        float top    = high[bestBar]
        float bot    = low[bestBar]
        float midVal = bot + (top - bot) * 0.5
        box b = box.new(left=bar_index - bestBar, top=top, right=obRight, bottom=bot,
             bgcolor=OB_BG, border_color=OB_BORDER, border_width=1)
        line m = line.new(x1=bar_index - bestBar, y1=midVal, x2=obRight, y2=midVal,
             color=OB_MID, style=line.style_dashed, width=1)
        array.push(obBoxes, b)
        array.push(obTops,  top)
        array.push(obBots,  bot)
        array.push(obDirs,  1)
        array.push(obBorn,  bar_index)
        array.push(obMids,  m)
        lastBullOBBar := bar_index

if i_showOB and bearBOS and dispOK and allowBear
    int   legStart = na(lastConfSHBar) ? 0 : lastConfSHBar
    int   bestBar  = na
    float bestHigh = na
    for i = 1 to safeLookback
        if (bar_index - i) < legStart
            break
        if close[i] > open[i]
            if na(bestHigh) or high[i] > bestHigh
                bestBar  := i
                bestHigh := high[i]
    if not na(bestBar)
        float top    = high[bestBar]
        float bot    = low[bestBar]
        float midVal = bot + (top - bot) * 0.5
        box b = box.new(left=bar_index - bestBar, top=top, right=obRight, bottom=bot,
             bgcolor=OB_BG, border_color=OB_BORDER, border_width=1)
        line m = line.new(x1=bar_index - bestBar, y1=midVal, x2=obRight, y2=midVal,
             color=OB_MID, style=line.style_dashed, width=1)
        array.push(obBoxes, b)
        array.push(obTops,  top)
        array.push(obBots,  bot)
        array.push(obDirs,  -1)
        array.push(obBorn,  bar_index)
        array.push(obMids,  m)
        lastBearOBBar := bar_index

if i_showOB and array.size(obBoxes) > 0
    int newRight = bar_index + i_zoneExtend
    for i = 0 to array.size(obBoxes) - 1
        box.set_right(array.get(obBoxes, i), newRight)
    if array.size(obMids) > 0
        for i = 0 to array.size(obMids) - 1
            line.set_x2(array.get(obMids, i), newRight)

while array.size(obBoxes) > OB_MAX
    box.delete(array.shift(obBoxes))
    line.delete(array.shift(obMids))
    array.shift(obTops)
    array.shift(obBots)
    array.shift(obDirs)
    array.shift(obBorn)

int nOB = array.size(obBoxes)
if nOB > 0
    for k = nOB - 1 to 0
        float top  = array.get(obTops, k)
        float bot  = array.get(obBots, k)
        int   born = array.get(obBorn, k)
        box   b    = array.get(obBoxes, k)
        line  m    = array.get(obMids, k)
        bool touched = OB_MITIG_W ? (high >= bot and low <= top) : (close >= bot and close <= top)
        if touched and bar_index > born
            box.delete(b)
            line.delete(m)
            array.remove(obBoxes, k)
            array.remove(obTops,  k)
            array.remove(obBots,  k)
            array.remove(obDirs,  k)
            array.remove(obBorn,  k)
            array.remove(obMids,  k)

// ─────────────────────────────────────────────
// DIBUJAR ZONA — anclada con xloc.bar_time
// Zona activa (coloreada) = mitad relevante
// Zona neutra (gris tenue) = mitad opuesta
// ─────────────────────────────────────────────

var box[]   zoneBoxes  = array.new<box>(0)
var line[]  zoneLines  = array.new<line>(0)
var label[] zoneLabels = array.new<label>(0)

if i_showZones and not na(fixedZoneHigh) and not na(fixedZoneLow) and not na(zMid) and not na(fixedZoneTime) and barstate.islast
    if array.size(zoneBoxes) > 0
        for i = 0 to array.size(zoneBoxes) - 1
            box.delete(array.get(zoneBoxes, i))
    array.clear(zoneBoxes)
    if array.size(zoneLines) > 0
        for i = 0 to array.size(zoneLines) - 1
            line.delete(array.get(zoneLines, i))
    array.clear(zoneLines)
    if array.size(zoneLabels) > 0
        for i = 0 to array.size(zoneLabels) - 1
            label.delete(array.get(zoneLabels, i))
    array.clear(zoneLabels)

    // Tiempo de fin = barra actual + extensión convertida a ms
    int msPerBar  = timeframe.in_seconds() * 1000
    int zTimeEnd  = time + msPerBar * i_zoneExtend
    int zTimeStart = fixedZoneTime

    if fixedZoneTrend == 1
        // ALCISTA
        // Mitad superior — gris tenue (zona neutral)
        array.push(zoneBoxes, box.new(
             left=zTimeStart, top=fixedZoneHigh, right=zTimeEnd, bottom=zMid,
             xloc=xloc.bar_time,
             border_color=color.new(color.gray, 80),
             bgcolor=color.new(color.gray, 93), border_width=1))

        // Mitad inferior — verde (zona de compra)
        array.push(zoneBoxes, box.new(
             left=zTimeStart, top=zMid, right=zTimeEnd, bottom=fixedZoneLow,
             xloc=xloc.bar_time,
             border_color=color.new(color.green, 40),
             bgcolor=color.new(color.green, 88), border_width=1))

        // Línea 50%
        array.push(zoneLines, line.new(x1=zTimeStart, y1=zMid, x2=zTimeEnd, y2=zMid,
             xloc=xloc.bar_time, color=color.new(color.white, 50),
             style=line.style_dashed, width=1))

        // 70% buy
        array.push(zoneLines, line.new(x1=zTimeStart, y1=z30, x2=zTimeEnd, y2=z30,
             xloc=xloc.bar_time, color=color.new(color.green, 20),
             style=line.style_dashed, width=2))
        array.push(zoneLabels, label.new(x=zTimeEnd, y=z30, text="70% buy",
             xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left,
             color=color.new(color.green, 20), textcolor=color.white, size=size.small))

        // 85% buy
        array.push(zoneLines, line.new(x1=zTimeStart, y1=z15, x2=zTimeEnd, y2=z15,
             xloc=xloc.bar_time, color=color.new(color.green, 0),
             style=line.style_solid, width=2))
        array.push(zoneLabels, label.new(x=zTimeEnd, y=z15, text="85% buy ⚡",
             xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left,
             color=color.new(color.green, 0), textcolor=color.white, size=size.small))

    else if fixedZoneTrend == -1
        // BAJISTA
        // Mitad superior — roja (zona de venta)
        array.push(zoneBoxes, box.new(
             left=zTimeStart, top=fixedZoneHigh, right=zTimeEnd, bottom=zMid,
             xloc=xloc.bar_time,
             border_color=color.new(color.red, 40),
             bgcolor=color.new(color.red, 88), border_width=1))

        // Mitad inferior — gris tenue (zona neutral)
        array.push(zoneBoxes, box.new(
             left=zTimeStart, top=zMid, right=zTimeEnd, bottom=fixedZoneLow,
             xloc=xloc.bar_time,
             border_color=color.new(color.gray, 80),
             bgcolor=color.new(color.gray, 93), border_width=1))

        // Línea 50%
        array.push(zoneLines, line.new(x1=zTimeStart, y1=zMid, x2=zTimeEnd, y2=zMid,
             xloc=xloc.bar_time, color=color.new(color.white, 50),
             style=line.style_dashed, width=1))

        // 70% sell
        array.push(zoneLines, line.new(x1=zTimeStart, y1=z70, x2=zTimeEnd, y2=z70,
             xloc=xloc.bar_time, color=color.new(color.red, 20),
             style=line.style_dashed, width=2))
        array.push(zoneLabels, label.new(x=zTimeEnd, y=z70, text="70% sell",
             xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left,
             color=color.new(color.red, 20), textcolor=color.white, size=size.small))

        // 85% sell
        array.push(zoneLines, line.new(x1=zTimeStart, y1=z85, x2=zTimeEnd, y2=z85,
             xloc=xloc.bar_time, color=color.new(color.red, 0),
             style=line.style_solid, width=2))
        array.push(zoneLabels, label.new(x=zTimeEnd, y=z85, text="85% sell ⚡",
             xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left,
             color=color.new(color.red, 0), textcolor=color.white, size=size.small))

// ─────────────────────────────────────────────
// SEÑALES PRIME
// ─────────────────────────────────────────────

nyTZ        = "America/New_York"
nyHour      = hour(time, nyTZ)
nyMinute    = minute(time, nyTZ)
nyDayOfWeek = dayofweek(time, nyTZ)

bool inNYSession = (nyHour > i_signalStartH or (nyHour == i_signalStartH and nyMinute >= i_signalStartM)) and
                   (nyHour < i_signalEndH   or (nyHour == i_signalEndH   and nyMinute <= i_signalEndM))
bool isWeekday   = nyDayOfWeek >= dayofweek.monday and nyDayOfWeek <= dayofweek.friday
bool sessionOK   = inNYSession and isWeekday

int currentDay = dayofmonth(time, nyTZ) + month(time, nyTZ) * 100 + year(time, nyTZ) * 10000
var int signalsToday = 0
var int lastDay      = na

if not na(lastDay) and lastDay != currentDay
    signalsToday := 0
lastDay := currentDay

bool tradedToday = signalsToday >= i_maxSignals

bool buyPrimeZone  = fixedZoneTrend == 1  and not na(z15) and low  <= z15
bool buyZone       = fixedZoneTrend == 1  and not na(z30) and low  <= z30 and low  > z15
bool sellPrimeZone = fixedZoneTrend == -1 and not na(z85) and high >= z85
bool sellZone      = fixedZoneTrend == -1 and not na(z70) and high >= z70 and high < z85

bool nwBuyOK  = low  <= nwLower
bool nwSellOK = high >= nwUpper

var bool inBuyPrime  = false
var bool inBuy       = false
var bool inSellPrime = false
var bool inSell      = false

if not buyPrimeZone
    inBuyPrime  := false
if not buyZone
    inBuy       := false
if not sellPrimeZone
    inSellPrime := false
if not sellZone
    inSell      := false

bool sigBuyPrime  = i_showSignals and buyPrimeZone  and not inBuyPrime  and sessionOK and not tradedToday
bool sigBuy       = i_showSignals and buyZone        and nwBuyOK         and not inBuy       and sessionOK and not tradedToday
bool sigSellPrime = i_showSignals and sellPrimeZone  and not inSellPrime and sessionOK and not tradedToday
bool sigSell      = i_showSignals and sellZone       and nwSellOK        and not inSell      and sessionOK and not tradedToday

if sigBuyPrime
    inBuyPrime   := true
    signalsToday += 1
    label.new(x=bar_index, y=low, text="⚡ BUY PRIME",
         xloc=xloc.bar_index, yloc=yloc.belowbar,
         style=label.style_label_up, color=color.new(color.green, 0),
         textcolor=color.white, size=size.normal)

if sigBuy
    inBuy        := true
    signalsToday += 1
    label.new(x=bar_index, y=low, text="⚡ BUY",
         xloc=xloc.bar_index, yloc=yloc.belowbar,
         style=label.style_label_up, color=color.new(color.green, 30),
         textcolor=color.white, size=size.small)

if sigSellPrime
    inSellPrime  := true
    signalsToday += 1
    label.new(x=bar_index, y=high, text="⚡ SELL PRIME",
         xloc=xloc.bar_index, yloc=yloc.abovebar,
         style=label.style_label_down, color=color.new(color.red, 0),
         textcolor=color.white, size=size.normal)

if sigSell
    inSell       := true
    signalsToday += 1
    label.new(x=bar_index, y=high, text="⚡ SELL",
         xloc=xloc.bar_index, yloc=yloc.abovebar,
         style=label.style_label_down, color=color.new(color.red, 30),
         textcolor=color.white, size=size.small)

alertcondition(sigBuyPrime,  title="⚡ BUY PRIME",  message="⚡ BUY PRIME — 85% buy | {{ticker}} | {{close}}")
alertcondition(sigBuy,       title="⚡ BUY",        message="⚡ BUY — 70% buy | {{ticker}} | {{close}}")
alertcondition(sigSellPrime, title="⚡ SELL PRIME", message="⚡ SELL PRIME — 85% sell | {{ticker}} | {{close}}")
alertcondition(sigSell,      title="⚡ SELL",       message="⚡ SELL — 70% sell | {{ticker}} | {{close}}")

// ─────────────────────────────────────────────
// DECRETO
// ─────────────────────────────────────────────

var table decretoTable = table.new(position.top_center, 1, 1,
     bgcolor=color.new(color.black, 100), border_color=color.new(color.black, 100),
     border_width=0, frame_color=color.new(color.black, 100), frame_width=0)

if i_showDecree and barstate.islast
    table.cell(decretoTable, 0, 0, "\n\n" + i_decretoL2,
         text_color=color.new(color.white, 20), text_size=size.normal,
         text_halign=text.align_center, bgcolor=color.new(color.black, 100))

// ─────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────

var table dash = table.new(position.top_right, 2, 4,
     bgcolor=color.new(color.black, 70), border_color=color.new(color.gray, 50),
     border_width=1, frame_color=color.new(color.gray, 30), frame_width=1)

if barstate.islast
    string structTxt   = trend == 1  ? "▲ Alcista" : trend == -1 ? "▼ Bajista" : "— Neutro"
    color  structColor = trend == 1  ? color.new(color.teal, 0) : trend == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
    string chochTxt    = chochDir == 1  ? "▲ Alcista" : chochDir == -1 ? "▼ Bajista" : "—"
    color  chochColor  = chochDir == 1  ? color.new(color.teal, 0) : chochDir == -1 ? color.new(color.red, 0) : color.new(color.gray, 40)
    string tfLabel     = i_useChartTF ? timeframe.period : i_bosChochTF

    string zonaTxt   = "—"
    color  zonaColor = color.new(color.gray, 60)
    if not na(z85) and not na(z70) and not na(z30) and not na(z15)
        if fixedZoneTrend == -1
            if high >= z85
                zonaTxt  := "⚡ 85% Sell"
                zonaColor := color.new(color.red, 0)
            else if high >= z70
                zonaTxt  := "70% Sell"
                zonaColor := color.new(color.red, 20)
            else
                zonaTxt  := "Esperando"
                zonaColor := color.new(color.gray, 40)
        else if fixedZoneTrend == 1
            if low <= z15
                zonaTxt  := "⚡ 85% Buy"
                zonaColor := color.new(color.green, 0)
            else if low <= z30
                zonaTxt  := "70% Buy"
                zonaColor := color.new(color.green, 20)
            else
                zonaTxt  := "Esperando"
                zonaColor := color.new(color.gray, 40)

    string nwTxt   = close > nwUpper ? "▼ Sobre Upper" : close < nwLower ? "▲ Bajo Lower" : "— En canal"
    color  nwColor = close > nwUpper ? color.new(color.red, 0) : close < nwLower ? color.new(color.teal, 0) : color.new(color.gray, 40)

    table.cell(dash, 0, 0, "STRUCT " + tfLabel, text_color=color.new(color.white, 40), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 0, structTxt,  text_color=structColor,  text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 1, "CHoCH " + tfLabel,  text_color=color.new(color.white, 40), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, chochTxt,   text_color=chochColor,   text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 2, "ZONA",     text_color=color.new(color.white, 40), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, zonaTxt,    text_color=zonaColor,    text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 3, "NW",       text_color=color.new(color.white, 40), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, nwTxt,      text_color=nwColor,      text_size=size.small, text_halign=text.align_right)

// ─────────────────────────────────────────────
// LÍNEA DE HORARIO
// ─────────────────────────────────────────────

if i_showTimeLine
    barHour   = hour(time,   "America/New_York")
    barMinute = minute(time, "America/New_York")
    if barHour == i_timeHour and barMinute == i_timeMin
        line.new(x1=bar_index, y1=low * 0.95, x2=bar_index, y2=high * 1.05,
                 color=i_timeColor, style=line.style_dotted, width=1, extend=extend.both)

// ─────────────────────────────────────────────
// VOLUME PROFILE
// ─────────────────────────────────────────────

if i_showVP and barstate.islast and not na(lastConfSH) and not na(lastConfSL) and lastConfSHBar != lastConfSLBar
    float rangeHigh = math.max(lastConfSH, lastConfSL)
    float rangeLow  = math.min(lastConfSH, lastConfSL)
    float rangeSize = rangeHigh - rangeLow
    if rangeSize > 0
        float[] volBuckets     = array.new_float(i_vpRows, 0.0)
        float[] volBullBuckets = array.new_float(i_vpRows, 0.0)
        float[] volBearBuckets = array.new_float(i_vpRows, 0.0)
        float   bucketSize     = rangeSize / i_vpRows
        int     startBar       = math.min(lastConfSHBar, lastConfSLBar)
        for b = startBar to bar_index
            float h     = high  [bar_index - b]
            float l     = low   [bar_index - b]
            float v     = volume[bar_index - b]
            bool isBull = close [bar_index - b] >= open[bar_index - b]
            for r = 0 to i_vpRows - 1
                float bLow    = rangeLow + r * bucketSize
                float bHigh   = bLow + bucketSize
                float overlap = math.max(0.0, math.min(h, bHigh) - math.max(l, bLow))
                float cr      = h - l
                if cr > 0 and overlap > 0
                    float portion = overlap / cr * v
                    array.set(volBuckets,     r, array.get(volBuckets,     r) + portion)
                    if isBull
                        array.set(volBullBuckets, r, array.get(volBullBuckets, r) + portion)
                    else
                        array.set(volBearBuckets, r, array.get(volBearBuckets, r) + portion)
        float maxVol = array.max(volBuckets)
        int   pocIdx = array.indexof(volBuckets, maxVol)
        int   pStart = bar_index + 2
        for r = 0 to i_vpRows - 1
            float bLow  = rangeLow + r * bucketSize
            float bHigh = bLow + bucketSize
            float vol   = array.get(volBuckets, r)
            float bullV = array.get(volBullBuckets, r)
            float bearV = array.get(volBearBuckets, r)
            if maxVol > 0
                int bWidth = math.round(vol / maxVol * i_vpWidth)
                if bWidth > 0
                    color bCol = r == pocIdx ? i_vpPocColor : (bullV >= bearV ? i_vpBullCol : i_vpBearCol)
                    box.new(left=pStart, top=bHigh, right=pStart + bWidth, bottom=bLow,
                            border_color=color.new(bCol, 80), bgcolor=bCol)
        float pocPrice = rangeLow + pocIdx * bucketSize + bucketSize / 2
        label.new(x=pStart + i_vpWidth + 2, y=pocPrice,
                  text="POC: " + str.tostring(pocPrice, "#.0"),
                  xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left,
                  color=color.new(color.yellow, 20), textcolor=color.white, size=size.small)