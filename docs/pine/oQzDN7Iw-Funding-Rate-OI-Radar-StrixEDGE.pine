//@version=6
indicator("Funding Rate & OI Radar [StrixEDGE]", "⚡ Funding Rate & OI Radar [StrixEDGE]", overlay = true, max_bars_back = 500)


// ─── INPUT GROUPS ───────────────────────────────────────────────────────────
var string GP_SYM   = "📊 Symbols"
var string GP_DATA  = "🔌 Data Sources"
var string GP_THR   = "🚨 Thresholds"
var string GP_DISP  = "🎨 Display"
var string GP_COL   = "📋 Columns"


// ─── SYMBOL INPUTS ──────────────────────────────────────────────────────────
i_exchange  = input.string("BINANCE",     "Exchange",                 options = ["BINANCE","BYBIT","OKX","BITGET","BITMEX"],  group = GP_SYM)
i_sym1      = input.string("BTCUSDT.P",   "Symbol 1",                group = GP_SYM, tooltip = "Perpetual contract ticker")
i_sym2      = input.string("ETHUSDT.P",   "Symbol 2",                group = GP_SYM)
i_sym3      = input.string("SOLUSDT.P",   "Symbol 3",                group = GP_SYM)
i_sym4      = input.string("",            "Symbol 4 (Custom)",        group = GP_SYM, tooltip = "Leave blank to disable")
i_sym5      = input.string("",            "Symbol 5 (Custom)",        group = GP_SYM, tooltip = "Leave blank to disable")


// ─── DATA SOURCE INPUTS ────────────────────────────────────────────────────
i_oi_suffix = input.string("_OI",         "OI Ticker Suffix",         group = GP_DATA, tooltip = "Appended to symbol: BTCUSDT.P + _OI → BINANCE:BTCUSDT.P_OI")
i_fr_method = input.string("Ticker",      "FR Data Source",           group = GP_DATA, options = ["Ticker","Basis Proxy"], tooltip = "Ticker: uses exchange FR feed\nBasis Proxy: estimates FR from perp-spot spread")
i_fr_suffix = input.string("_FR",         "FR Ticker Suffix",         group = GP_DATA, tooltip = "Only used when FR Data Source = Ticker")
i_spot_sfx  = input.string("",            "Spot Suffix Override",     group = GP_DATA, tooltip = "For Basis Proxy: spot ticker suffix. E.g., leave blank if BTCUSDT is spot on same exchange")


// ─── THRESHOLD INPUTS ──────────────────────────────────────────────────────
i_fr_extreme = input.float(0.05,   "Extreme FR (%/8h)",       step = 0.005, minval = 0.001,   group = GP_THR, tooltip = "Absolute FR above this triggers extreme alert")
i_oi_alert   = input.float(5.0,    "OI Change Alert (%)",     step = 0.5,   minval = 0.5,     group = GP_THR, tooltip = "OI % change above this triggers alert")
i_fr_hot     = input.float(0.03,   "Elevated FR (%/8h)",      step = 0.005, minval = 0.001,   group = GP_THR, tooltip = "FR above this = elevated (orange zone)")


// ─── DISPLAY INPUTS ────────────────────────────────────────────────────────
i_tbl_pos   = input.string("Top Right",   "Table Position",   options = ["Top Right","Top Left","Bottom Right","Bottom Left","Top Center","Bottom Center","Middle Right","Middle Left"],  group = GP_DISP)
i_tbl_size  = input.string("Normal",      "Text Size",        options = ["Tiny","Small","Normal","Large"],   group = GP_DISP)


// ─── COLUMN VISIBILITY ────────────────────────────────────────────────────
i_show_price = input.bool(true,  "Price",              group = GP_COL)
i_show_pchg  = input.bool(true,  "Price Δ 24H",       group = GP_COL)
i_show_fr    = input.bool(true,  "Funding Rate",       group = GP_COL)
i_show_oi1h  = input.bool(true,  "OI Δ 1H",           group = GP_COL)
i_show_oi4h  = input.bool(true,  "OI Δ 4H",           group = GP_COL)
i_show_oi24h = input.bool(true,  "OI Δ 24H",          group = GP_COL)
i_show_div   = input.bool(true,  "Divergence",         group = GP_COL)
i_show_sent  = input.bool(true,  "Sentiment Footer",   group = GP_COL)


// ═══════════════════════════════════════════════════════════════════════════════
//  BRAND PALETTE
// ═══════════════════════════════════════════════════════════════════════════════
var color C_BRAND      = #00BFFF
var color C_BRAND_DIM  = color.new(#00BFFF, 60)
var color C_BG         = #0d1117
var color C_BG_ROW     = #161b22
var color C_HDR        = #1a1f29
var color C_TITLE_BG   = #002a40
var color C_TXT        = #c9d1d9
var color C_TXT_DIM    = #8b949e
var color C_BULL       = #3fb950
var color C_BEAR       = #f85149
var color C_WARN       = #f0883e
var color C_EXTREME    = #ff2244
var color C_NEUTRAL    = #484f58


// ═══════════════════════════════════════════════════════════════════════════════
//  HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ── Table position mapping ──
f_pos(string p) =>
    switch p
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Top Center"    => position.top_center
        "Bottom Center" => position.bottom_center
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        => position.top_right

// ── Text size mapping ──
f_sz(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.normal

// ── Funding rate color with intensity gradient ──
f_frColor(float fr) =>
    if na(fr)
        C_NEUTRAL
    else
        absFr = math.abs(fr)
        if absFr >= i_fr_extreme
            fr > 0 ? C_EXTREME : color.new(#00ff88, 0)
        else if absFr >= i_fr_hot
            fr > 0 ? C_WARN : color.new(#22cc66, 20)
        else if absFr > 0.005
            fr > 0 ? color.new(#f85149, 40) : color.new(#3fb950, 40)
        else
            C_TXT_DIM

// ── OI change color ──
f_oiColor(float pct) =>
    if na(pct)
        C_NEUTRAL
    else
        absPct = math.abs(pct)
        if absPct >= i_oi_alert
            pct > 0 ? color.new(#00ff88, 0) : C_EXTREME
        else if absPct >= i_oi_alert * 0.5
            pct > 0 ? C_BULL : C_BEAR
        else
            C_TXT_DIM

// ── Trend arrow ──
f_arrow(float pct) =>
    if na(pct)
        "—"
    else if pct > 0.5
        "▲"
    else if pct < -0.5
        "▼"
    else
        "►"

// ── Format percentage ──
f_pct(float val) =>
    if na(val)
        "N/A"
    else
        sign = val >= 0 ? "+" : ""
        sign + str.tostring(val, "#.##") + "%"

// ── Format price ──
f_price(float val) =>
    if na(val)
        "N/A"
    else if val >= 10000
        str.tostring(val, "#.#")
    else if val >= 100
        str.tostring(val, "#.##")
    else if val >= 1
        str.tostring(val, "#.###")
    else
        str.tostring(val, "#.####")

// ── Format funding rate ──
f_fr(float val) =>
    if na(val)
        "N/A"
    else
        sign = val >= 0 ? "+" : ""
        sign + str.tostring(val, "#.####") + "%"

// ── Divergence signal ──
f_divSignal(float priceChg, float oiChg) =>
    if na(priceChg) or na(oiChg)
        ["—", C_NEUTRAL]
    else if priceChg > 0.3 and oiChg < -0.5
        ["WEAK▲", C_WARN]
    else if priceChg < -0.3 and oiChg > 0.5
        ["WEAK▼", C_WARN]
    else if priceChg > 0.3 and oiChg > 0.5
        ["STRONG▲", C_BULL]
    else if priceChg < -0.3 and oiChg < -0.5
        ["STRONG▼", C_BEAR]
    else
        ["NEUTRAL", C_TXT_DIM]

// ── Label from ticker ──
f_label(string sym) =>
    // Strip common suffixes for clean display
    string s = str.replace_all(sym, "USDT.P", "")
    s := str.replace_all(s, "USD.P", "")
    s := str.replace_all(s, "USDT", "")
    s := str.replace_all(s, ".P", "")
    str.length(s) > 6 ? str.substring(s, 0, 6) : s


// ═══════════════════════════════════════════════════════════════════════════════
//  TICKER CONSTRUCTION
// ═══════════════════════════════════════════════════════════════════════════════
// Active flags
sym4_on = str.length(i_sym4) > 0
sym5_on = str.length(i_sym5) > 0

// Price tickers
string tk1 = i_exchange + ":" + i_sym1
string tk2 = i_exchange + ":" + i_sym2
string tk3 = i_exchange + ":" + i_sym3
string tk4 = sym4_on ? i_exchange + ":" + i_sym4 : tk1
string tk5 = sym5_on ? i_exchange + ":" + i_sym5 : tk1

// OI tickers
string oi1 = i_exchange + ":" + i_sym1 + i_oi_suffix
string oi2 = i_exchange + ":" + i_sym2 + i_oi_suffix
string oi3 = i_exchange + ":" + i_sym3 + i_oi_suffix
string oi4 = sym4_on ? i_exchange + ":" + i_sym4 + i_oi_suffix : oi1
string oi5 = sym5_on ? i_exchange + ":" + i_sym5 + i_oi_suffix : oi1

// FR tickers (only used if method = "Ticker")
string fr1 = i_exchange + ":" + i_sym1 + i_fr_suffix
string fr2 = i_exchange + ":" + i_sym2 + i_fr_suffix
string fr3 = i_exchange + ":" + i_sym3 + i_fr_suffix
string fr4 = sym4_on ? i_exchange + ":" + i_sym4 + i_fr_suffix : fr1
string fr5 = sym5_on ? i_exchange + ":" + i_sym5 + i_fr_suffix : fr1

// Spot tickers (for Basis Proxy)
string sp_sfx  = str.length(i_spot_sfx) > 0 ? i_spot_sfx : ""
string sp1 = i_exchange + ":" + str.replace_all(i_sym1, ".P", "") + sp_sfx
string sp2 = i_exchange + ":" + str.replace_all(i_sym2, ".P", "") + sp_sfx
string sp3 = i_exchange + ":" + str.replace_all(i_sym3, ".P", "") + sp_sfx
string sp4 = sym4_on ? i_exchange + ":" + str.replace_all(i_sym4, ".P", "") + sp_sfx : sp1
string sp5 = sym5_on ? i_exchange + ":" + str.replace_all(i_sym5, ".P", "") + sp_sfx : sp1


// ═══════════════════════════════════════════════════════════════════════════════
//  DATA REQUESTS — PRICE (Daily TF for 24H change)
// ═══════════════════════════════════════════════════════════════════════════════
[p1_now, p1_prev] = request.security(tk1, "D", [close, close[1]], lookahead = barmerge.lookahead_off)
[p2_now, p2_prev] = request.security(tk2, "D", [close, close[1]], lookahead = barmerge.lookahead_off)
[p3_now, p3_prev] = request.security(tk3, "D", [close, close[1]], lookahead = barmerge.lookahead_off)
[p4_now, p4_prev] = request.security(tk4, "D", [close, close[1]], lookahead = barmerge.lookahead_off)
[p5_now, p5_prev] = request.security(tk5, "D", [close, close[1]], lookahead = barmerge.lookahead_off)

float pchg1 = not na(p1_prev) and p1_prev != 0 ? (p1_now - p1_prev) / p1_prev * 100 : na
float pchg2 = not na(p2_prev) and p2_prev != 0 ? (p2_now - p2_prev) / p2_prev * 100 : na
float pchg3 = not na(p3_prev) and p3_prev != 0 ? (p3_now - p3_prev) / p3_prev * 100 : na
float pchg4 = not na(p4_prev) and p4_prev != 0 ? (p4_now - p4_prev) / p4_prev * 100 : na
float pchg5 = not na(p5_prev) and p5_prev != 0 ? (p5_now - p5_prev) / p5_prev * 100 : na


// ═══════════════════════════════════════════════════════════════════════════════
//  DATA REQUESTS — OPEN INTEREST (1H / 4H / 24H changes)
// ═══════════════════════════════════════════════════════════════════════════════
// 1H OI
[oi1_1h, oi1_1hp] = request.security(oi1, "60",  [close, close[1]], lookahead = barmerge.lookahead_off)
[oi2_1h, oi2_1hp] = request.security(oi2, "60",  [close, close[1]], lookahead = barmerge.lookahead_off)
[oi3_1h, oi3_1hp] = request.security(oi3, "60",  [close, close[1]], lookahead = barmerge.lookahead_off)
[oi4_1h, oi4_1hp] = request.security(oi4, "60",  [close, close[1]], lookahead = barmerge.lookahead_off)
[oi5_1h, oi5_1hp] = request.security(oi5, "60",  [close, close[1]], lookahead = barmerge.lookahead_off)

// 4H OI
[oi1_4h, oi1_4hp] = request.security(oi1, "240", [close, close[1]], lookahead = barmerge.lookahead_off)
[oi2_4h, oi2_4hp] = request.security(oi2, "240", [close, close[1]], lookahead = barmerge.lookahead_off)
[oi3_4h, oi3_4hp] = request.security(oi3, "240", [close, close[1]], lookahead = barmerge.lookahead_off)
[oi4_4h, oi4_4hp] = request.security(oi4, "240", [close, close[1]], lookahead = barmerge.lookahead_off)
[oi5_4h, oi5_4hp] = request.security(oi5, "240", [close, close[1]], lookahead = barmerge.lookahead_off)

// 24H OI
[oi1_d, oi1_dp] = request.security(oi1, "D",  [close, close[1]], lookahead = barmerge.lookahead_off)
[oi2_d, oi2_dp] = request.security(oi2, "D",  [close, close[1]], lookahead = barmerge.lookahead_off)
[oi3_d, oi3_dp] = request.security(oi3, "D",  [close, close[1]], lookahead = barmerge.lookahead_off)
[oi4_d, oi4_dp] = request.security(oi4, "D",  [close, close[1]], lookahead = barmerge.lookahead_off)
[oi5_d, oi5_dp] = request.security(oi5, "D",  [close, close[1]], lookahead = barmerge.lookahead_off)


// ═══════════════════════════════════════════════════════════════════════════════
//  DATA REQUESTS — FUNDING RATE
// ═══════════════════════════════════════════════════════════════════════════════
// Ticker method: pull from exchange FR feed
float frTk1 = i_fr_method == "Ticker" ? request.security(fr1, "60", close, lookahead = barmerge.lookahead_off) : na
float frTk2 = i_fr_method == "Ticker" ? request.security(fr2, "60", close, lookahead = barmerge.lookahead_off) : na
float frTk3 = i_fr_method == "Ticker" ? request.security(fr3, "60", close, lookahead = barmerge.lookahead_off) : na
float frTk4 = i_fr_method == "Ticker" ? request.security(fr4, "60", close, lookahead = barmerge.lookahead_off) : na
float frTk5 = i_fr_method == "Ticker" ? request.security(fr5, "60", close, lookahead = barmerge.lookahead_off) : na

// Basis Proxy method: (perp - spot) / spot * 100 / 3
// Divide by 3 because there are 3 funding intervals per day
float spot1 = i_fr_method == "Basis Proxy" ? request.security(sp1, "60", close, lookahead = barmerge.lookahead_off) : na
float spot2 = i_fr_method == "Basis Proxy" ? request.security(sp2, "60", close, lookahead = barmerge.lookahead_off) : na
float spot3 = i_fr_method == "Basis Proxy" ? request.security(sp3, "60", close, lookahead = barmerge.lookahead_off) : na
float spot4 = i_fr_method == "Basis Proxy" ? request.security(sp4, "60", close, lookahead = barmerge.lookahead_off) : na
float spot5 = i_fr_method == "Basis Proxy" ? request.security(sp5, "60", close, lookahead = barmerge.lookahead_off) : na

float perp1 = i_fr_method == "Basis Proxy" ? request.security(tk1, "60", close, lookahead = barmerge.lookahead_off) : na
float perp2 = i_fr_method == "Basis Proxy" ? request.security(tk2, "60", close, lookahead = barmerge.lookahead_off) : na
float perp3 = i_fr_method == "Basis Proxy" ? request.security(tk3, "60", close, lookahead = barmerge.lookahead_off) : na
float perp4 = i_fr_method == "Basis Proxy" ? request.security(tk4, "60", close, lookahead = barmerge.lookahead_off) : na
float perp5 = i_fr_method == "Basis Proxy" ? request.security(tk5, "60", close, lookahead = barmerge.lookahead_off) : na


// ═══════════════════════════════════════════════════════════════════════════════
//  CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ── OI % Changes ──
f_oiPct(float curr, float prev) =>
    not na(curr) and not na(prev) and prev != 0 ? (curr - prev) / prev * 100 : na

// 1H changes
float oid1_1h = f_oiPct(oi1_1h, oi1_1hp)
float oid2_1h = f_oiPct(oi2_1h, oi2_1hp)
float oid3_1h = f_oiPct(oi3_1h, oi3_1hp)
float oid4_1h = f_oiPct(oi4_1h, oi4_1hp)
float oid5_1h = f_oiPct(oi5_1h, oi5_1hp)

// 4H changes
float oid1_4h = f_oiPct(oi1_4h, oi1_4hp)
float oid2_4h = f_oiPct(oi2_4h, oi2_4hp)
float oid3_4h = f_oiPct(oi3_4h, oi3_4hp)
float oid4_4h = f_oiPct(oi4_4h, oi4_4hp)
float oid5_4h = f_oiPct(oi5_4h, oi5_4hp)

// 24H changes
float oid1_d = f_oiPct(oi1_d, oi1_dp)
float oid2_d = f_oiPct(oi2_d, oi2_dp)
float oid3_d = f_oiPct(oi3_d, oi3_dp)
float oid4_d = f_oiPct(oi4_d, oi4_dp)
float oid5_d = f_oiPct(oi5_d, oi5_dp)

// ── Resolved Funding Rates ──
f_basisFR(float perpPrice, float spotPrice) =>
    not na(perpPrice) and not na(spotPrice) and spotPrice != 0 ? (perpPrice - spotPrice) / spotPrice * 100 / 3 : na

float fund1 = i_fr_method == "Ticker" ? frTk1 : f_basisFR(perp1, spot1)
float fund2 = i_fr_method == "Ticker" ? frTk2 : f_basisFR(perp2, spot2)
float fund3 = i_fr_method == "Ticker" ? frTk3 : f_basisFR(perp3, spot3)
float fund4 = i_fr_method == "Ticker" ? frTk4 : f_basisFR(perp4, spot4)
float fund5 = i_fr_method == "Ticker" ? frTk5 : f_basisFR(perp5, spot5)

// ── Divergence Signals ──
[div1_txt, div1_clr] = f_divSignal(pchg1, oid1_d)
[div2_txt, div2_clr] = f_divSignal(pchg2, oid2_d)
[div3_txt, div3_clr] = f_divSignal(pchg3, oid3_d)
[div4_txt, div4_clr] = f_divSignal(pchg4, oid4_d)
[div5_txt, div5_clr] = f_divSignal(pchg5, oid5_d)

// ── Aggregate Sentiment ──
float frSum   = 0.0
int   frCount = 0
if not na(fund1)
    frSum   += fund1
    frCount += 1
if not na(fund2)
    frSum   += fund2
    frCount += 1
if not na(fund3)
    frSum   += fund3
    frCount += 1
if sym4_on and not na(fund4)
    frSum   += fund4
    frCount += 1
if sym5_on and not na(fund5)
    frSum   += fund5
    frCount += 1

float avgFR       = frCount > 0 ? frSum / frCount : na
string sentLabel  = na(avgFR) ? "NO DATA" : avgFR > i_fr_extreme ? "🔴 EXTREME GREED" : avgFR > i_fr_hot ? "🟠 ELEVATED LONGS" : avgFR > 0.005 ? "🟡 MILD LONG BIAS" : avgFR < -i_fr_extreme ? "🟢 EXTREME FEAR" : avgFR < -i_fr_hot ? "🟢 ELEVATED SHORTS" : avgFR < -0.005 ? "🔵 MILD SHORT BIAS" : "⚪ NEUTRAL"
color  sentColor  = na(avgFR) ? C_NEUTRAL : avgFR > i_fr_extreme ? C_EXTREME : avgFR > i_fr_hot ? C_WARN : avgFR > 0.005 ? color.new(#e3b341, 0) : avgFR < -i_fr_extreme ? color.new(#00ff88, 0) : avgFR < -i_fr_hot ? C_BULL : avgFR < -0.005 ? C_BRAND : C_TXT_DIM


// ═══════════════════════════════════════════════════════════════════════════════
//  TABLE — Row Writer (global scope, called from barstate.islast)
// ═══════════════════════════════════════════════════════════════════════════════
f_writeRow(table t, int row, string sym, float price, float prChg, float fr, float oi1hPct, float oi4hPct, float oiDPct, string divTxt, color divClr, string sz) =>
    color rowBg = row % 2 == 0 ? C_BG : C_BG_ROW
    int col = 0

    // Symbol
    table.cell(t, col, row, " " + f_label(sym) + " ", text_color = C_BRAND, bgcolor = rowBg, text_size = sz, text_halign = text.align_left)
    col += 1

    // Price
    if i_show_price
        table.cell(t, col, row, " " + f_price(price) + " ", text_color = C_TXT, bgcolor = rowBg, text_size = sz, text_halign = text.align_right)
        col += 1

    // Price Δ 24H
    if i_show_pchg
        color pcClr = na(prChg) ? C_NEUTRAL : prChg >= 0 ? C_BULL : C_BEAR
        table.cell(t, col, row, " " + f_pct(prChg) + " ", text_color = pcClr, bgcolor = rowBg, text_size = sz, text_halign = text.align_right)
        col += 1

    // Funding Rate
    if i_show_fr
        bool isExtreme = not na(fr) and math.abs(fr) >= i_fr_extreme
        color frBg     = isExtreme ? color.new(fr > 0 ? C_EXTREME : #00ff88, 80) : rowBg
        table.cell(t, col, row, " " + f_fr(fr) + " ", text_color = f_frColor(fr), bgcolor = frBg, text_size = sz, text_halign = text.align_right)
        col += 1

    // OI Δ1H
    if i_show_oi1h
        string oiStr1h = f_arrow(oi1hPct) + " " + f_pct(oi1hPct)
        table.cell(t, col, row, " " + oiStr1h + " ", text_color = f_oiColor(oi1hPct), bgcolor = rowBg, text_size = sz, text_halign = text.align_right)
        col += 1

    // OI Δ4H
    if i_show_oi4h
        string oiStr4h = f_arrow(oi4hPct) + " " + f_pct(oi4hPct)
        table.cell(t, col, row, " " + oiStr4h + " ", text_color = f_oiColor(oi4hPct), bgcolor = rowBg, text_size = sz, text_halign = text.align_right)
        col += 1

    // OI Δ24H
    if i_show_oi24h
        string oiStrD = f_arrow(oiDPct) + " " + f_pct(oiDPct)
        table.cell(t, col, row, " " + oiStrD + " ", text_color = f_oiColor(oiDPct), bgcolor = rowBg, text_size = sz, text_halign = text.align_right)
        col += 1

    // Divergence signal
    if i_show_div
        color sigBg = divTxt == "WEAK▲" or divTxt == "WEAK▼" ? color.new(C_WARN, 85) : rowBg
        table.cell(t, col, row, " " + divTxt + " ", text_color = divClr, bgcolor = sigBg, text_size = sz, text_halign = text.align_center)


// ═══════════════════════════════════════════════════════════════════════════════
//  TABLE CONSTRUCTION (global column/row math, table drawn on last bar)
// ═══════════════════════════════════════════════════════════════════════════════

// ── Fixed column count (inputs don't change at runtime) ──
int g_cols = 1 + (i_show_price ? 1 : 0) + (i_show_pchg ? 1 : 0) + (i_show_fr ? 1 : 0) + (i_show_oi1h ? 1 : 0) + (i_show_oi4h ? 1 : 0) + (i_show_oi24h ? 1 : 0) + (i_show_div ? 1 : 0)
int g_dataRows = 3 + (sym4_on ? 1 : 0) + (sym5_on ? 1 : 0)
int g_rows     = 2 + g_dataRows + (i_show_sent ? 1 : 0)

var table tbl = table.new(f_pos(i_tbl_pos), g_cols, g_rows, border_width = 0)

if barstate.islast
    table.clear(tbl, 0, 0, g_cols - 1, g_rows - 1)

    string txtSize = f_sz(i_tbl_size)

    // ── Title Row ──
    table.cell(tbl, 0, 0, "⚡ StrixEDGE  FR & OI Radar", text_color = C_BRAND, bgcolor = C_TITLE_BG, text_size = txtSize, text_halign = text.align_left)
    table.merge_cells(tbl, 0, 0, g_cols - 1, 0)

    // ── Header Row ──
    int c = 0
    table.cell(tbl, c, 1, "SYMBOL", text_color = C_TXT_DIM, bgcolor = C_HDR, text_size = txtSize, text_halign = text.align_center)
    c += 1
    if i_show_price
        table.cell(tbl, c, 1, "PRICE", text_color = C_TXT_DIM, bgcolor = C_HDR, text_size = txtSize, text_halign = text.align_center)
        c += 1
    if i_show_pchg
        table.cell(tbl, c, 1, "Δ 24H", text_color = C_TXT_DIM, bgcolor = C_HDR, text_size = txtSize, text_halign = text.align_center)
        c += 1
    if i_show_fr
        table.cell(tbl, c, 1, "FR /8h", text_color = C_TXT_DIM, bgcolor = C_HDR, text_size = txtSize, text_halign = text.align_center)
        c += 1
    if i_show_oi1h
        table.cell(tbl, c, 1, "OI Δ1H", text_color = C_TXT_DIM, bgcolor = C_HDR, text_size = txtSize, text_halign = text.align_center)
        c += 1
    if i_show_oi4h
        table.cell(tbl, c, 1, "OI Δ4H", text_color = C_TXT_DIM, bgcolor = C_HDR, text_size = txtSize, text_halign = text.align_center)
        c += 1
    if i_show_oi24h
        table.cell(tbl, c, 1, "OI Δ24H", text_color = C_TXT_DIM, bgcolor = C_HDR, text_size = txtSize, text_halign = text.align_center)
        c += 1
    if i_show_div
        table.cell(tbl, c, 1, "SIGNAL", text_color = C_TXT_DIM, bgcolor = C_HDR, text_size = txtSize, text_halign = text.align_center)

    // ── Data Rows ──
    int r = 2
    f_writeRow(tbl, r,     i_sym1, p1_now, pchg1, fund1, oid1_1h, oid1_4h, oid1_d, div1_txt, div1_clr, txtSize)
    f_writeRow(tbl, r + 1, i_sym2, p2_now, pchg2, fund2, oid2_1h, oid2_4h, oid2_d, div2_txt, div2_clr, txtSize)
    f_writeRow(tbl, r + 2, i_sym3, p3_now, pchg3, fund3, oid3_1h, oid3_4h, oid3_d, div3_txt, div3_clr, txtSize)

    if sym4_on
        f_writeRow(tbl, r + 3, i_sym4, p4_now, pchg4, fund4, oid4_1h, oid4_4h, oid4_d, div4_txt, div4_clr, txtSize)
    if sym5_on
        int r5 = sym4_on ? r + 4 : r + 3
        f_writeRow(tbl, r5, i_sym5, p5_now, pchg5, fund5, oid5_1h, oid5_4h, oid5_d, div5_txt, div5_clr, txtSize)

    // ── Sentiment Footer ──
    if i_show_sent
        int sentRow = r + g_dataRows
        string sentTxt = "SENTIMENT: " + sentLabel + "  │  Avg FR: " + f_fr(avgFR)
        table.cell(tbl, 0, sentRow, sentTxt, text_color = sentColor, bgcolor = C_TITLE_BG, text_size = txtSize, text_halign = text.align_center)
        table.merge_cells(tbl, 0, sentRow, g_cols - 1, sentRow)


// ═══════════════════════════════════════════════════════════════════════════════
//  ALERT CONDITIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ── Extreme Funding Rate ──
bool frAlert1 = not na(fund1) and math.abs(fund1) >= i_fr_extreme
bool frAlert2 = not na(fund2) and math.abs(fund2) >= i_fr_extreme
bool frAlert3 = not na(fund3) and math.abs(fund3) >= i_fr_extreme
bool frAlert4 = sym4_on and not na(fund4) and math.abs(fund4) >= i_fr_extreme
bool frAlert5 = sym5_on and not na(fund5) and math.abs(fund5) >= i_fr_extreme
bool anyFRAlert = frAlert1 or frAlert2 or frAlert3 or frAlert4 or frAlert5

alertcondition(anyFRAlert, "⚡ Extreme Funding Rate", "StrixEDGE FR Radar: Extreme funding rate detected across monitored symbols")

// ── OI Surge ──
bool oiSurge1 = not na(oid1_1h) and math.abs(oid1_1h) >= i_oi_alert
bool oiSurge2 = not na(oid2_1h) and math.abs(oid2_1h) >= i_oi_alert
bool oiSurge3 = not na(oid3_1h) and math.abs(oid3_1h) >= i_oi_alert
bool oiSurge4 = sym4_on and not na(oid4_1h) and math.abs(oid4_1h) >= i_oi_alert
bool oiSurge5 = sym5_on and not na(oid5_1h) and math.abs(oid5_1h) >= i_oi_alert
bool anyOISurge = oiSurge1 or oiSurge2 or oiSurge3 or oiSurge4 or oiSurge5

alertcondition(anyOISurge, "⚡ OI Surge", "StrixEDGE OI Radar: Significant OI change detected in 1H window")

// ── Weak Rally / Weak Drop Divergence ──
bool divWeak1 = div1_txt == "WEAK▲" or div1_txt == "WEAK▼"
bool divWeak2 = div2_txt == "WEAK▲" or div2_txt == "WEAK▼"
bool divWeak3 = div3_txt == "WEAK▲" or div3_txt == "WEAK▼"
bool divWeak4 = sym4_on and (div4_txt == "WEAK▲" or div4_txt == "WEAK▼")
bool divWeak5 = sym5_on and (div5_txt == "WEAK▲" or div5_txt == "WEAK▼")
bool anyDivWeak = divWeak1 or divWeak2 or divWeak3 or divWeak4 or divWeak5

alertcondition(anyDivWeak, "⚡ OI-Price Divergence", "StrixEDGE Divergence: Price and OI moving in opposite directions — weak move detected")

// ── Aggregate Sentiment Shift ──
bool sentimentExtreme = not na(avgFR) and math.abs(avgFR) >= i_fr_extreme
alertcondition(sentimentExtreme, "⚡ Sentiment Extreme", "StrixEDGE Sentiment: Aggregate funding rate has reached extreme levels")


// ═══════════════════════════════════════════════════════════════════════════════
//  END — [StrixEDGE] Funding Rate & OI Radar v1.0
// ═══════════════════════════════════════════════════════════════════════════════