//@version=6
strategy("BS - Proyección TP/SL", overlay=true, max_lines_count=500, process_orders_on_close=true, initial_capital=100, margin_long=0, margin_short=0, commission_type=strategy.commission.percent, commission_value=0.04)

// =====================================================================
// 1. CONFIGURACIÓN DEL BOT Y CAPITAL REAL
// =====================================================================
symbol_input = input.string("BTCUSDT", "Símbolo", group="1. Configuración")
margen_trade = input.float(50.0, "Margen por Operación (USDT)", group="1. Configuración") 
leverage_val = input.int(20, "Apalancamiento (x)", group="1. Configuración")

tp_percent   = input.float(0.2, "Take Profit (%)", step=0.05, group="2. Riesgo") / 100
sl_percent   = input.float(0.1, "Stop Loss (%)", step=0.05, group="2. Riesgo") / 100

tamano_posicion_usd = margen_trade * leverage_val
qty_dinamica        = tamano_posicion_usd / close 

// =====================================================================
// 2. JERARQUÍA INSTITUCIONAL
// =====================================================================
tf_mayor = input.timeframe("15", "Temporalidad Mayor (ej. 15)", group="3. Zonas")
tolerancia_acercamiento = input.float(0.1, "Tolerancia de Acercamiento (%)", step=0.05, group="3. Zonas") / 100

[htf_resistencia, htf_soporte] = request.security(syminfo.tickerid, tf_mayor, [high[1], low[1]], lookahead=barmerge.lookahead_on)

activacion_soporte = htf_soporte * (1 + tolerancia_acercamiento)
activacion_resistencia = htf_resistencia * (1 - tolerancia_acercamiento)

// =====================================================================
// 3. LÓGICA DE GATILLO Y MEMORIA (LTF)
// =====================================================================
ema_gatillo = ta.ema(close, 5)
ventana_memoria = 5

en_zona_soporte = low <= activacion_soporte
toque_reciente_soporte = ta.barssince(en_zona_soporte) <= ventana_memoria 
gatillo_long    = ta.crossover(close, ema_gatillo)
condicion_long  = toque_reciente_soporte and gatillo_long

en_zona_resistencia = high >= activacion_resistencia
toque_reciente_resistencia = ta.barssince(en_zona_resistencia) <= ventana_memoria
gatillo_short       = ta.crossunder(close, ema_gatillo)
condicion_short     = toque_reciente_resistencia and gatillo_short

// =====================================================================
// 4. EJECUCIÓN Y ALMACENAMIENTO DE OBJETIVOS (TP/SL VISUALES)
// =====================================================================
// Variables para guardar los precios y dibujarlos
var float active_tp = na
var float active_sl = na

// Si no hay operaciones abiertas, borramos las líneas
if strategy.position_size == 0
    active_tp := na
    active_sl := na

if condicion_long
    price_entry = close
    price_tp = price_entry * (1 + tp_percent)
    price_sl = price_entry * (1 - sl_percent)
    
    // Guardamos los objetivos para el dibujo
    active_tp := price_tp
    active_sl := price_sl
    
    string json_long = '{"symbol": "' + symbol_input + '", "side": "BUY", "leverage": ' + str.tostring(leverage_val) + ', "qty": ' + str.tostring(qty_dinamica) + ', "tp": ' + str.tostring(price_tp) + ', "sl": ' + str.tostring(price_sl) + '}'
    strategy.entry("Long", strategy.long, qty=qty_dinamica, alert_message=json_long)
    strategy.exit("Cierre Long", "Long", limit=price_tp, stop=price_sl)
    
    label.new(x=bar_index, y=price_entry, text="LONG\n" + str.tostring(price_entry, "#.##"), style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.small)

if condicion_short
    price_entry = close
    price_tp = price_entry * (1 - tp_percent)
    price_sl = price_entry * (1 + sl_percent)
    
    // Guardamos los objetivos para el dibujo
    active_tp := price_tp
    active_sl := price_sl
    
    string json_short = '{"symbol": "' + symbol_input + '", "side": "SELL", "leverage": ' + str.tostring(leverage_val) + ', "qty": ' + str.tostring(qty_dinamica) + ', "tp": ' + str.tostring(price_tp) + ', "sl": ' + str.tostring(price_sl) + '}'
    strategy.entry("Short", strategy.short, qty=qty_dinamica, alert_message=json_short)
    strategy.exit("Cierre Short", "Short", limit=price_tp, stop=price_sl)
    
    label.new(x=bar_index, y=price_entry, text="SHORT\n" + str.tostring(price_entry, "#.##"), style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.small)

// =====================================================================
// 5. VISUALIZACIÓN EN GRÁFICO (El "Canal" de Operación)
// =====================================================================
plot(htf_resistencia, color=color.red, linewidth=2, title="Resistencia Jerarquía")
plot(htf_soporte, color=color.green, linewidth=2, title="Soporte Jerarquía")
plot(ema_gatillo, color=color.yellow, title="Gatillo EMA LTF")

bgcolor(toque_reciente_soporte and not condicion_long ? color.new(color.blue, 90) : na, title="Radar Long Activado")
bgcolor(toque_reciente_resistencia and not condicion_short ? color.new(color.orange, 90) : na, title="Radar Short Activado")

// 1. Línea Azul: Tu punto de entrada exacto
precio_entrada_activo = strategy.opentrades > 0 ? strategy.opentrades.entry_price(0) : na
plot(precio_entrada_activo, color=color.new(color.blue, 0), style=plot.style_linebr, linewidth=1, title="Entrada")

// 2. Línea Verde: Tu proyección de Take Profit
plot(active_tp, color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2, title="Meta (Take Profit)")

// 3. Línea Roja: Tu red de seguridad (Stop Loss)
plot(active_sl, color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2, title="Corte (Stop Loss)")

// =====================================================================
// 6. ETIQUETAS DE RESULTADOS (P&L) AL CERRAR LA OPERACIÓN
// =====================================================================
var int current_closed_trades = 0

if strategy.closedtrades > current_closed_trades
    int last_idx     = strategy.closedtrades - 1
    float profit     = strategy.closedtrades.profit(last_idx) 
    int exit_bar     = strategy.closedtrades.exit_bar_index(last_idx) 
    float exit_price = strategy.closedtrades.exit_price(last_idx) 
    
    float roe_percent = (profit / margen_trade) * 100
    string sign = profit > 0 ? "+" : ""
    color lbl_color = profit > 0 ? color.new(color.green, 10) : color.new(color.red, 10)
    
    string lbl_text = sign + str.tostring(profit, "#.##") + " USDT\n(" + sign + str.tostring(roe_percent, "#.##") + "%)\nSalida: " + str.tostring(exit_price, "#.##")
    
    label.new(x=exit_bar, y=exit_price, text=lbl_text, style=profit > 0 ? label.style_label_down : label.style_label_up, color=lbl_color, textcolor=color.white, size=size.small)
    current_closed_trades := strategy.closedtrades