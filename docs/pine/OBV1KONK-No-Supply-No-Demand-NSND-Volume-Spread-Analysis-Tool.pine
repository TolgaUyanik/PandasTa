//@version=5
indicator("No Supply No Demand (NSND) – Volume Spread Analysis Tool", overlay=true)

lookahead_bars = input.int(10, "Lookahead Bars", minval=1)

// === Detect No Demand (ND) === //
isND = close > open and volume < volume[1] and volume < volume[2]

// === Detect No Supply (NS) === //
isNS = close < open and volume < volume[1] and volume < volume[2]

// === Arrays for ND === //
var ndBars = array.new_int()
var ndHighs = array.new_float()
var confirmedNDs = array.new_int()
var unconfirmedNDs = array.new_int()

// === Arrays for NS === //
var nsBars = array.new_int()
var nsLows = array.new_float()
var confirmedNSs = array.new_int()
var unconfirmedNSs = array.new_int()

// === Store ND Candidates === //
if isND
    array.push(ndBars, bar_index)
    array.push(ndHighs, high)

// === Store NS Candidates === //
if isNS
    array.push(nsBars, bar_index)
    array.push(nsLows, low)

// === Process ND Candidates === //
i = 0
while i < array.size(ndBars)
    ndBar = array.get(ndBars, i)
    ndHigh = array.get(ndHighs, i)
    confirm = false

    if bar_index > ndBar and bar_index <= ndBar + lookahead_bars
        if high > ndHigh and close < ndHigh
            confirm := true

    if confirm
        array.push(confirmedNDs, ndBar)
        array.remove(ndBars, i)
        array.remove(ndHighs, i)
        continue

    if bar_index > ndBar + lookahead_bars
        array.push(unconfirmedNDs, ndBar)
        array.remove(ndBars, i)
        array.remove(ndHighs, i)
        continue

    i += 1

// === Process NS Candidates === //
j = 0
while j < array.size(nsBars)
    nsBar = array.get(nsBars, j)
    nsLow = array.get(nsLows, j)
    confirm = false

    if bar_index > nsBar and bar_index <= nsBar + lookahead_bars
        if low < nsLow and close > nsLow
            confirm := true

    if confirm
        array.push(confirmedNSs, nsBar)
        array.remove(nsBars, j)
        array.remove(nsLows, j)
        continue

    if bar_index > nsBar + lookahead_bars
        array.push(unconfirmedNSs, nsBar)
        array.remove(nsBars, j)
        array.remove(nsLows, j)
        continue

    j += 1

// === Plot ND Dots === //
plotND_red = false
plotND_grey = false

if array.size(confirmedNDs) > 0
    for x = 0 to array.size(confirmedNDs) - 1
        if bar_index == array.get(confirmedNDs, x) + 1
            plotND_red := true
            break

if array.size(unconfirmedNDs) > 0
    for x = 0 to array.size(unconfirmedNDs) - 1
        if bar_index == array.get(unconfirmedNDs, x) + 1
            plotND_grey := true
            break

plotshape(plotND_red, title="Confirmed ND (Red)", location=location.abovebar, style=shape.circle, color=color.red, size=size.tiny)
plotshape(plotND_grey, title="Unconfirmed ND (Grey)", location=location.abovebar, style=shape.circle, color=color.gray, size=size.tiny)

// === Plot NS Dots === //
plotNS_green = false
plotNS_grey = false

if array.size(confirmedNSs) > 0
    for y = 0 to array.size(confirmedNSs) - 1
        if bar_index == array.get(confirmedNSs, y) + 1
            plotNS_green := true
            break

if array.size(unconfirmedNSs) > 0
    for y = 0 to array.size(unconfirmedNSs) - 1
        if bar_index == array.get(unconfirmedNSs, y) + 1
            plotNS_grey := true
            break

plotshape(plotNS_green, title="Confirmed NS (Green)", location=location.belowbar, style=shape.circle, color=color.green, size=size.tiny)
plotshape(plotNS_grey, title="Unconfirmed NS (Grey)", location=location.belowbar, style=shape.circle, color=color.gray, size=size.tiny)
