/// Map Region {
// @function One Off function for converting a map into a string to be used for the logger. 
// @param this A Map of the fundamental base types
// @returns A concatenated string to show the insides of a map object. 
MapStringConcatenater(this)=>
    _msg = ''
    for [i, key] in this.keys()
        if this.size() - 1 == i
            _msg += str.format('{0}:{1}', key, this.get(key))
        else 
            _msg += str.format('{0}:{1}, ', key, this.get(key))
    _msg


export method log(map<float, float> this, string tag= 'Map<float, float>', int debugLevel = 1, int showLast=0, bool verbose = false, bool showLabels = false ) =>
    Logger(MapStringConcatenater(this), tag = tag,  debugLevel = debugLevel, showLast = showLast, verbose = verbose, showLabels = showLabels)

export method log(map<float, int> this, string tag= 'Map<float, int>', int debugLevel = 1, int showLast=0, bool verbose = false, bool showLabels = false) =>
    Logger(MapStringConcatenater(this), tag = tag,  debugLevel = debugLevel, showLast = showLast, verbose = verbose, showLabels = showLabels)

