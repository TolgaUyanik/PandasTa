//@description
// Function Description:
// This function aims to extend the logging functionality by overloading various logging methods. 
// The objective is to enable appending ".log" at the end of different types to make logging outputs easier.
// Key features of this function include:
// Multi Debug Levels: The readout will encompass error, warning, and info messages.
// Controlled Output: Logging can be set for every bar or only the last X bars.
// Automatic Logging: Essential variables such as bar_index, time, price, and # of times log has been called can be extracted.
// Methods Included:
// Logs variables.
// Logs floats.
// Logs integers.
// Logs strings.
// Logs booleans.
// Logs arrays.
// Logs matrices.
// Logs maps.
// This comprehensive logging function enhances logging capabilities, 
// providing versatility and ease of use in capturing and debugging data across different contexts.
library("LoggerLib", overlay = true)

// Base Region { 
// @function            Base Logger function.
// @param   this        Variable to be formatted into a logger message  
// @param   tag         String to tag variable name for easy identification inside of pine logs.
// @param   debugLevel  `1 = log.info | 2 = log.warning | 3 = log.error |` 
// @param   showLast    Shows last x Logs, 0 shows all. 
// @param   verbose     Include additional Debug logger Data.
// @param   showLabels  Create Labels of the logs on that main chart.
// @param   lblColor    Changes the color of the label. Only useful if debugging colors.
// @returns this
Logger(this, string tag='This', int debugLevel=1, int showLast=0, bool verbose=false, bool showLabels=false, color lblColor = #00000000) =>
    varip _count    = 0, _count += 1
 
    if (bar_index >  last_bar_index - showLast) or showLast == 0 // Limits the log amount
        _message        = str.format('\n<<Log>>\n{0}: {1}', tag,this)
        _verboseData    = str.format('\n|LOG DATA|\nBar Index: {0}\nPrice: {1}\nTime: {2}\nCount: {3}', bar_index, close, str.format_time(timenow, 'yyyy-MM-dd HH:mm:SS.ss'), _count)
        
        if verbose
            _message += _verboseData

        if showLabels 
            label.new(bar_index, close, '📝      \n \n ', tooltip = _message, color = lblColor)

        switch debugLevel
            1 => log.info(_message)
            2 => log.warning(_message)
            => log.error(_message)

    this
// } End Base Region 

// Fundamental Types Region { 

// @function Logs any variable type, excluding custom UDTs, and displays to the logs or as a label on bars.
// ```  
// // Example 
// variable = close
// variable.log()
// variable.log('my Float', 2, 0,true,true)
//
// // Example Arrays
// ArrayVariable = array.from(1,2,3)
// ArrayVariable.log()
// ArrayVariable.log(tag='This Array Vraible I watn to track')
//
// // Examples Maps
// MapVariable = map.new<string, float>()
// MapVariable.log()
// 
// // Example Funky stuff
// close.log(tag='theclose', debugLevel = 1, showLast = 1, verbose = true, showLabels = true)
// 
// ```
// @param   this     Variable to be formatted into a logger message
// @param   tag       String to tag variable name for easy identification inside of pine logs.
// @param   debugLevel  Log Level `1 = log.info | 2 = log.warning  3 = log.error`
// @param   showLast Shows last x Logs, 0 shows all.
// @param   verbose  Include additional Debug logger Data.
// @param   showLabels Create Labels of the logs on that main chart.
// @returns void
export method log(float this, string tag= 'float', int debugLevel = 1, int showLast=0, bool verbose = false, bool showLabels = false ) =>
    Logger(this, tag = tag, debugLevel = debugLevel, showLast = showLast, verbose = verbose, showLabels = showLabels)

export method log(int this, string tag= 'int', int debugLevel = 1, int showLast=0, bool verbose = false, bool showLabels = false) =>
    Logger(this, tag=tag, debugLevel = debugLevel, showLast = showLast, verbose = verbose, showLabels = showLabels)

export method log(string this, string tag= 'string', int debugLevel = 1, int showLast=0, bool verbose = false, bool showLabels = false) =>
    Logger(this, tag=tag, debugLevel = debugLevel, showLast = showLast, verbose = verbose, showLabels = showLabels)

export method log(bool this, string tag= 'bool', int debugLevel = 1, int showLast=0, bool verbose = false, bool showLabels = false) =>
    Logger(this, tag=tag, debugLevel = debugLevel, showLast = showLast, verbose = verbose, showLabels = showLabels)

export method log(color this, string tag= 'Color', int debugLevel = 1, int showLast=0, bool verbose = false, bool showLabels = false) =>
    Logger('Color', tag=tag, debugLevel = debugLevel, showLast = showLast, verbose = verbose, showLabels = showLabels, lblColor = this)

// Examples 

// Example
// variable = close
// variable.log('The Close' 2, 0,true,true)
// variable.log()
// close.log(tag='My Special note', debugLevel = 1, showLast = 1, verbose = true, showLabels = true)
// 1.0.log()


// } END Fundamental Types Region

