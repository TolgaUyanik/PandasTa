//@version=6

//@description TODO: add library description here
library("UTBot")

// @function TODO: add function description here
// To use : import simverse/UTBot/3 as GT
//  > UTBot - base close, trailing with gap, multi * xATR 
//  > GTrender : general Trender , if source is "close" then UTBot, else if hl2 (=(high+low)/2) then supertrend
// @param x TODO: add parameter x description here

// @returns TODO: add what function returns
export UTBot(float multi, int period ) =>
    xATRTS = 0.0
    src = close

    xATR  = ta.atr(period)
    nLoss = multi * xATR

    xATRTS := src > nz(xATRTS[1],0)   and src [1] > nz(xATRTS[1],0) ? math.max(nz(xATRTS[1]), src - nLoss) 
     :(src < nz(xATRTS[1], 0) and src[1] < nz(xATRTS[1], 0) ?  
     math.min(nz(xATRTS[1]), src + nLoss) : src > nz(xATRTS[1], 0) ? src - nLoss : src + nLoss)

    pos = 0   
    pos :=  src[1] < nz(xATRTS[1], 0) and src > nz(xATRTS[1], 0) ? 1 :
     src[1] > nz(xATRTS[1], 0) and src < nz(xATRTS[1], 0) ? -1 : nz(pos[1], 0)
    
    // ema   = ta.ema(src,1)
    // above = ta.crossover(ema, xATRTS)
    // below = ta.crossover(xATRTS, ema)
	[xATRTS, pos]


export CTrender(float multi, int period ) =>
    xATRTS = 0.0
    src = close

    xATR  = ta.atr(period)
    nLoss = multi * xATR

    // buy position, under line 
    base_lower = hl2 - nLoss 
    base_upper = close + nLoss

    xATRTS := src > nz(xATRTS[1],0)   and src [1] > nz(xATRTS[1],0) ? math.max(nz(xATRTS[1]), base_lower) 
     :(src < nz(xATRTS[1], 0) and src[1] < nz(xATRTS[1], 0) ?  
     math.min(nz(xATRTS[1]), base_upper) : src > nz(xATRTS[1], 0) ? base_lower : base_upper)

    pos = 0   
    pos :=  src[1] < nz(xATRTS[1], 0) and src > nz(xATRTS[1], 0) ? 1 :
     src[1] > nz(xATRTS[1], 0) and src < nz(xATRTS[1], 0) ? -1 : nz(pos[1], 0)
    
    // ema   = ta.ema(src,1)
    // above = ta.crossover(ema, xATRTS)
    // below = ta.crossover(xATRTS, ema)
	[xATRTS, pos]
