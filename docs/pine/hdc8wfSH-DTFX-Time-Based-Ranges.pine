// === High/Low Settings ===
var bool show_high_line  = input.bool(true, "Show High (100%)", group = "HIGH/LOW SETTINGS", inline = "hl_toggle")
var bool show_low_line   = input.bool(true, "Show Low (0%)", group = "HIGH/LOW SETTINGS", inline = "hl_toggle")
