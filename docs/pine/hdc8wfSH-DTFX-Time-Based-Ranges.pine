var color extend_hl_col  = input.color(color.gray, "Extended Line Color",   group = "HIGH/LOW SETTINGS", inline = "ext_hl")
var string extend_hl_style_str = input.string('Solid', "Extended Line Style", options = ['Solid', 'Dashed', 'Dotted'], group = "HIGH/LOW SETTINGS", inline = "ext_hl_style")
var int extend_hl_width  = input.int(1, "Extended Line Thickness", minval = 1, maxval = 4, group = "HIGH/LOW SETTINGS", inline = "ext_hl_style")
var string hl_style_str  = input.string('Solid', "Line Style", options = ['Solid', 'Dashed', 'Dotted'], group = "HIGH/LOW SETTINGS", inline = "hl_style")
var color hl_custom_col  = input.color(color.gray, "Line Color (default zones)", group = "HIGH/LOW SETTINGS", inline = "hl_style")

// ── 9AM ZONE COLORS ──────────────────────────────────────────────────────────
var color z1_box_bg   = input.color(color.new(color.blue, 85), "Box Fill",    group = "9AM ZONE COLORS", inline = "z1_box")
var color z1_box_bord = input.color(color.new(color.blue,  0), "Box Border",  group = "9AM ZONE COLORS", inline = "z1_box")
var color z1_hl_col   = input.color(color.teal,                "H/L Lines",   group = "9AM ZONE COLORS")

// ── 3PM ZONE COLORS ──────────────────────────────────────────────────────────
var color z2_box_bg   = input.color(color.new(color.orange, 85), "Box Fill",  group = "3PM ZONE COLORS", inline = "z2_box")
var color z2_box_bord = input.color(color.new(color.orange,  0), "Box Border",group = "3PM ZONE COLORS", inline = "z2_box")
var color z2_hl_col   = input.color(color.orange,                "H/L Lines", group = "3PM ZONE COLORS")

// ── BOX SETTINGS (zones 3-8) ─────────────────────────────────────────────────
var color box_bg_col     = input.color(color.new(color.gray, 85), "Background Color", group = "BOX SETTINGS (Other Zones)")
var color box_border_col = input.color(color.new(color.gray,  0), "Border Color",     group = "BOX SETTINGS (Other Zones)")
var int   box_border_w   = input.int(1, "Border Width", minval = 1, maxval = 4,        group = "BOX SETTINGS (Other Zones)")
var string box_border_sty= input.string('Solid', "Border Style", options = ['Solid','Dashed','Dotted'], group = "BOX SETTINGS (Other Zones)")
var bool show_box_border = input.bool(false, "Show TBR Box Border", group = "BOX SETTINGS (Other Zones)")

box_bstyle = switch box_border_sty
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

// === 50% Settings ===
var bool show_50_line    = input.bool(true, "Show 50% Line", group = "50% MIDPOINT SETTINGS", inline = "50_toggle")
var bool extend_50_line  = input.bool(true, "Extend 50% (9AM & 3PM only)", group = "50% MIDPOINT SETTINGS", inline = "50_toggle")
var string style_50_str  = input.string('Solid', "50% Line Style", options = ['Solid', 'Dashed', 'Dotted'], group = "50% MIDPOINT SETTINGS", inline = "50_visual")
var int thick_50         = input.int(1, "Thickness", minval = 1, maxval = 4, group = "50% MIDPOINT SETTINGS", inline = "50_visual")
var bool show_50_label   = input.bool(true, "Show 'T B R' Label", group = "50% MIDPOINT SETTINGS")

// === 30% / 70% Settings ===
var bool show_30_line    = input.bool(false, "Show 30% Line", group = "30% & 70% SETTINGS", inline = "30_toggle")
var bool extend_30_line  = input.bool(true,  "Extend 30% Line", group = "30% & 70% SETTINGS", inline = "30_toggle")
var string style_30_str  = input.string('Dotted', "30% Line Type", options = ['Solid', 'Dashed', 'Dotted'], group = "30% & 70% SETTINGS", inline = "30_style")
var int thick_30         = input.int(2, "30% Thickness", minval = 1, maxval = 4, group = "30% & 70% SETTINGS", inline = "30_style")

var bool show_70_line    = input.bool(false, "Show 70% Line", group = "30% & 70% SETTINGS", inline = "70_toggle")
var bool extend_70_line  = input.bool(true,  "Extend 70% Line", group = "30% & 70% SETTINGS", inline = "70_toggle")
var string style_70_str  = input.string('Dotted', "70% Line Type", options = ['Solid', 'Dashed', 'Dotted'], group = "30% & 70% SETTINGS", inline = "70_style")
var int thick_70         = input.int(2, "70% Thickness", minval = 1, maxval = 4, group = "30% & 70% SETTINGS", inline = "70_style")

var color col_3070       = input.color(color.gray, "30/70 Color", group = "30% & 70% SETTINGS")

// ── NEW: VIOLATED (V TBR) SETTINGS ───────────────────────────────────────────
var bool show_vtbr          = input.bool(true,  "Show Violated (V TBR) Zones",   group = "VIOLATED TBR SETTINGS")
var int vtbr_percent_mitigation = input.int(30, "V TBR % Mitigation", minval = 0, maxval = 100, group = "VIOLATED TBR SETTINGS")
var color vtbr_box_bg       = input.color(color.new(#ff3a3a, 80), "Box Fill",    group = "VIOLATED TBR SETTINGS", inline = "vtbr_box")
var color vtbr_box_bord     = input.color(color.new(#ff3a3a,  0), "Box Border",  group = "VIOLATED TBR SETTINGS", inline = "vtbr_box")
var color vtbr_line_col     = input.color(#ff3a3a,                "Line Color",  group = "VIOLATED TBR SETTINGS")
var color vtbr_label_col    = input.color(#ff3a3a,                  "Label Color", group = "VIOLATED TBR SETTINGS")
// ─────────────────────────────────────────────────────────────────────────────

// ── HISTORIC (OLD UNMITIGATED) TBR SETTINGS ──────────────────────────────────
var bool show_historic_tbr  = input.bool(false, "Show Historic TBRs — Extend Old Unmitigated (< 30% tapped)", group = "HISTORIC TBR SETTINGS")
var bool show_historic_vtbr = input.bool(false, "Show Historic V TBRs — Extend Old Unmitigated", group = "HISTORIC TBR SETTINGS")
var int historic_mitigation = input.int(30, "Historic TBR % Mitigation", minval = 0, maxval = 100, group = "HISTORIC TBR SETTINGS")
// ─────────────────────────────────────────────────────────────────────────────

// === General Settings ===
var int percent_mitigation = input.int(50, "% mitigation", minval = 0, maxval = 100, group = "SETTINGS")
var bool extend_box        = input.bool(false, "Extend box", group = "SETTINGS")
var int max_unmitigated    = input.int(5, "Max Unmitigated Zones", group = "SETTINGS")
var int max_frozen_tbrs    = input.int(300, "Max Frozen TBRs Kept On Chart", minval = 0, maxval = 500, group = "SETTINGS")
var bool show_only_2_recent = input.bool(false, "Show only 2 most recent TBRs", group = "SETTINGS")
var string timezone        = input.string('America/New_York', "Timezone", options = ['America/New_York','GMT-12','GMT-11','GMT-10','GMT-9','GMT-8','GMT-7','GMT-6','GMT-5','GMT-4','GMT-3','GMT-2','GMT-1','GMT+0','GMT+1','GMT+2','GMT+3','GMT+4','GMT+5','GMT+6','GMT+7','GMT+8','GMT+9','GMT+10','GMT+11','GMT+12','GMT+13','GMT+14'])
var bool only_validated    = input.bool(true, "Show ONLY Validated TBRs (1H Break)", group = "SETTINGS")
var bool show_mitigated_tbr= input.bool(true, "Show mitigated TBRs (tapped ≥ 30%)", group = "SETTINGS")
var bool show_unvalidated_tbr = input.bool(true, "Show Unvalidated TBRs (Gray)", group = "SETTINGS")

// === Label settings ===
var string label_size_str  = input.string('Small', "Label Size", options = ['Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = "SETTINGS")

// Resolve Styles
label_sz = switch label_size_str
    'Tiny'   => size.tiny
    'Small'  => size.small
    'Normal' => size.normal
    'Large'  => size.large
    =>          size.huge

s_50 = switch style_50_str
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

s_30 = switch style_30_str
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

s_70 = switch style_70_str
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

s_hl = switch hl_style_str
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted

s_ext_hl = switch extend_hl_style_str
    'Solid'  => line.style_solid
    'Dashed' => line.style_dashed
    =>          line.style_dotted


type Candle
    bool active
    bool complete
    int _t
    float _h
    float _l
    bool bull
    box _box
    line _0
    line _30
    line _50
    line _70
    line _100
    float mitigation
    bool isFiftyExtended
    label _50_label
    bool tapped
    bool validated
    // ── per-zone resolved colors (set at candle creation) ──
    color box_bg
    color box_bord
    color hl_col
    // ── separate extension lines for 0% and 100% ──
    line _0_ext
    line _100_ext
    bool hl_extended
    // ── bar_time at which extension lines should begin (10AM / 4PM) ──
    int ext_start_hour
    // ── NEW: S/R flip flag — set when price closes fully through the zone ──
    bool flipped
    // ── H1 opening time on which the original breakout activated this TBR ──
    int breakout_h1_time = na
    // ── Finalized flag — respected TBR or re-entered V TBR: stop extending ──
    bool frozen = false
    // ── Violation direction — true if the zone was broken to the DOWNSIDE ──
    bool flip_below = false
    // ── Bar on which the V TBR was created; that same bar cannot mitigate it ──
    int flipped_bar = na
    // ── A 30% test is pending until price rejects back to the breakout side. ──
    bool respect_pending = false
    // ── Respect flag — confirmed only after a 30% test rejects back outside. ──
    bool mitigated30 = false
    // ── Historic flag — zone aged past the cap while still < 30% tapped. ──
    bool historic = false
    // ── Fill object for unvalidated gray fill ──
    linefill _fill = na

type Config
    bool active
    int _hour
    int _minute
    string tf
    Candle[] candles

var configs = array.new<Config>()

// Archive of frozen zones (drawings kept on chart, no longer tracked). Oldest
// first. Bounded by max_frozen_tbrs so every zone is deleted ATOMICALLY —
// label + lines + box together — before TradingView's independent 500-object
// caps can recycle a zone's lines while stranding its label as orphan text.
var frozen_zones = array.new<Candle>()

if configs.size() == 0
    configs.push(Config.new(active_1, hour_1, minute_1, timeframe_1, array.new<Candle>()))
    configs.push(Config.new(active_2, hour_2, minute_2, timeframe_2, array.new<Candle>()))
    configs.push(Config.new(active_3, hour_3, minute_3, timeframe_3, array.new<Candle>()))
    configs.push(Config.new(active_4, hour_4, minute_4, timeframe_4, array.new<Candle>()))
    configs.push(Config.new(active_5, hour_5, minute_5, timeframe_5, array.new<Candle>()))
    configs.push(Config.new(active_6, hour_6, minute_6, timeframe_6, array.new<Candle>()))
    configs.push(Config.new(active_7, hour_7, minute_7, timeframe_7, array.new<Candle>()))
    configs.push(Config.new(active_8, hour_8, minute_8, timeframe_8, array.new<Candle>()))

method drawCandle(Candle candle) =>
    _0p   = candle.bull ? candle._l : candle._h
    _100p = candle.bull ? candle._h : candle._l
    diff  = candle.bull ? candle._h - candle._l : candle._l - candle._h
    _30p  = _0p + (diff * 0.7)
    _50p  = _0p + (diff * 0.5)
    _70p  = _0p + (diff * 0.3)

    c_hl_act = (only_validated and not candle.validated) ? na : candle.hl_col
    c_50_act = (only_validated and not candle.validated) ? na : candle.hl_col
    c_30_act = (only_validated and not candle.validated) ? na : col_3070
    c_bg     = (only_validated and not candle.validated) ? na : candle.box_bg
    c_border = (only_validated and not candle.validated) ? na : candle.box_bord
    c_text   = (only_validated and not candle.validated) ? na : candle.hl_col

    // ── Override for unvalidated TBRs (gray lines + fill, no box) ────────────
    if show_unvalidated_tbr and not candle.validated
        c_hl_act := color.gray
        c_50_act := color.gray
        c_30_act := color.gray
        c_bg     := na
        c_border := na
        c_text   := color.gray
    // ─────────────────────────────────────────────────────────────────────────

    if not show_box_border
        c_border := na

    candle._box := box.new(candle._t, candle._h, time, candle._l, border_color = c_border, border_width = box_border_w, border_style = box_bstyle, bgcolor = c_bg, xloc = xloc.bar_time)

    // Original H/L lines — drawn once, never modified again
    if show_low_line
        candle._0 := line.new(candle._t, candle._l, time, candle._l, color = c_hl_act, style = s_hl, width = line_thickness, xloc = xloc.bar_time)
    if show_high_line
        candle._100 := line.new(candle._t, candle._h, time, candle._h, color = c_hl_act, style = s_hl, width = line_thickness, xloc = xloc.bar_time)

    // ── Create a gray fill between high/low for unvalidated TBRs ─────────────
    if show_unvalidated_tbr and not candle.validated and not na(candle._0) and not na(candle._100)
        candle._fill := linefill.new(candle._0, candle._100, color = color.new(color.gray, 85))
    // ─────────────────────────────────────────────────────────────────────────

    // Keep 30% and 70% lines visible across the original TBR candle even when
    // their extension options are disabled.
    if show_30_line
        candle._30 := line.new(candle._t, _30p, time, _30p, color = c_30_act, style = s_30, width = thick_30, xloc = xloc.bar_time)
    if show_70_line
        candle._70 := line.new(candle._t, _70p, time, _70p, color = c_30_act, style = s_70, width = thick_70, xloc = xloc.bar_time)

    // The 50% line is independently available even when extension is disabled.
    // Without extension it spans only the original TBR candle. With extension
    // enabled for the 9AM/3PM zones, its right endpoint follows the market.
    if show_50_line
        candle._50 := line.new(candle._t, _50p, time, _50p, color = c_50_act, style = s_50, width = thick_50, xloc = xloc.bar_time)

    // Keep the label independently controllable from the 50% line.
    if show_50_label
        candle._50_label := label.new(time, _50p, "T B R", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.gray, 100), textcolor=c_text, style=label.style_label_left, size=label_sz)

method setColor(Candle candle) =>
    c_hl   = (only_validated and not candle.validated) ? na : candle.hl_col
    c_50v  = (only_validated and not candle.validated) ? na : candle.hl_col
    c_30v  = (only_validated and not candle.validated) ? na : col_3070
    c_bg   = (only_validated and not candle.validated) ? na : candle.box_bg
    c_bord = (only_validated and not candle.validated) ? na : candle.box_bord
    c_text = (only_validated and not candle.validated) ? na : candle.hl_col

    // ── Override for unvalidated TBRs ────────────────────────────────────────
    if show_unvalidated_tbr and not candle.validated
        c_hl   := color.gray
        c_50v  := color.gray
        c_30v  := color.gray
        c_bg   := na
        c_bord := na
        c_text := color.gray
    // ─────────────────────────────────────────────────────────────────────────

    // Remove the unvalidated fill once the TBR is validated
    if not na(candle._fill) and candle.validated
        candle._fill.delete()
        candle._fill := na

    if not show_box_border
        c_bord := na

    candle._box.set_bgcolor(c_bg)
    candle._box.set_border_color(c_bord)
    candle._box.set_border_width(box_border_w)
    if not na(candle._0)
        candle._0.set_color(c_hl)
    if not na(candle._100)
        candle._100.set_color(c_hl)
    if not na(candle._30)
        candle._30.set_color(c_30v)
    if not na(candle._70)
        candle._70.set_color(c_30v)
    if not na(candle._50)
        candle._50.set_color(c_50v)
    if not na(candle._50_label)
        candle._50_label.set_textcolor(c_text)

// ── NEW: Apply V TBR visual style when a zone is violated (S/R flip) ─────────
method setFlippedColor(Candle candle) =>
    // Remove the gray fill if it exists (zone should no longer be shown as unvalidated)
    if not na(candle._fill)
        candle._fill.delete()
        candle._fill := na

    candle.box_bg   := vtbr_box_bg
    candle.box_bord := vtbr_box_bord
    candle.hl_col   := vtbr_line_col

    candle._box.set_bgcolor(vtbr_box_bg)
    candle._box.set_border_color(show_box_border ? vtbr_box_bord : na)
    candle._box.set_border_width(box_border_w)

    if not na(candle._0)
        candle._0.set_color(vtbr_line_col)
    if not na(candle._100)
        candle._100.set_color(vtbr_line_col)
    if not na(candle._30)
        candle._30.set_color(vtbr_line_col)
    if not na(candle._70)
        candle._70.set_color(vtbr_line_col)
    if not na(candle._50)
        candle._50.set_color(vtbr_line_col)
    if not na(candle._0_ext)
        candle._0_ext.set_color(vtbr_line_col)
    if not na(candle._100_ext)
        candle._100_ext.set_color(vtbr_line_col)

    // Relabel the midpoint as "V TBR"
    if not na(candle._50_label)
        candle._50_label.set_text("V TBR")
        candle._50_label.set_textcolor(vtbr_label_col)
    else if show_50_label
        _50p = (candle._h + candle._l) / 2
        candle._50_label := label.new(time, _50p, "V TBR", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.gray,100), textcolor=vtbr_label_col, style=label.style_label_left, size=label_sz)
        candle._50_label.set_size(label_sz)
// ─────────────────────────────────────────────────────────────────────────────

method setMitigation(Candle candle) =>
    diff = candle._h - candle._l
    mit = (diff * percent_mitigation / 100)
    candle.mitigation := candle.bull ? candle._h - mit : candle._l + mit

// Re-anchor the 30% / 70% retracement lines once the zone's direction is
// known. They are first drawn on candle completion, BEFORE any breakout, so
// their placement must be corrected when the direction is finally assigned.
method setLevels(Candle candle) =>
    _0p   = candle.bull ? candle._l : candle._h
    diff  = candle.bull ? candle._h - candle._l : candle._l - candle._h
    _30p  = _0p + (diff * 0.7)
    _70p  = _0p + (diff * 0.3)
    if not na(candle._30)
        candle._30.set_y1(_30p)
        candle._30.set_y2(_30p)
    if not na(candle._70)
        candle._70.set_y1(_70p)
        candle._70.set_y2(_70p)

method extend(Candle c) =>
    // Keep the original gray H/L lines and their fill moving with the market
    // only while no later COMPLETED H1 candle has closed outside the TBR range.
    // They stop on the exact H1 breakout candle once that close is confirmed.
    if c.complete and not c.active and not c.validated and show_unvalidated_tbr
        if not na(c._0)
            c._0.set_x2(time)
        if not na(c._100)
            c._100.set_x2(time)

    if extend_hl_lines
        if c.ext_start_hour >= 0
            current_hour = hour(time, timezone)
            if current_hour >= c.ext_start_hour
                if not c.hl_extended
                    if show_low_line
                        c._0_ext := line.new(time, c._l, time, c._l, color = extend_hl_col, style = s_ext_hl, width = extend_hl_width, xloc = xloc.bar_time)
                    if show_high_line
                        c._100_ext := line.new(time, c._h, time, c._h, color = extend_hl_col, style = s_ext_hl, width = extend_hl_width, xloc = xloc.bar_time)
                    c.hl_extended := true
                else
                    if not na(c._0_ext)
                        c._0_ext.set_x2(time)
                    if not na(c._100_ext)
                        c._100_ext.set_x2(time)
    // Extend each retracement line only when its own option is enabled.
    if extend_30_line and not na(c._30)
        c._30.set_x2(time)
    if extend_70_line and not na(c._70)
        c._70.set_x2(time)
    // Only the 9AM/3PM midpoint objects follow the market when their dedicated
    // 50% extension option is enabled. A non-extended 50% line stays across the
    // original TBR candle instead of disappearing or extending accidentally.
    if c.isFiftyExtended
        if not na(c._50)
            c._50.set_x2(time)
        if not na(c._50_label)
            c._50_label.set_x(time)
    if extend_box
        c._box.set_right(time)

method removeDrawing(Candle c) =>
    line.delete(c._0)
    line.delete(c._100)
    line.delete(c._0_ext)
    line.delete(c._100_ext)
    line.delete(c._30)
    line.delete(c._50)
    line.delete(c._70)
    label.delete(c._50_label)
    box.delete(c._box)
    // ── Delete the fill if it exists ─────────────────────────────────────────
    if not na(c._fill)
        c._fill.delete()
        c._fill := na

isTime(tf, _h, _m) =>
    if timeframe.in_seconds(tf) < timeframe.in_seconds("D")
        hour(time, timezone) == _h and minute(time, timezone) == _m
    else
        true

changes = array.new<bool>()
changes.push(ta.change(time(timeframe_1)) != 0)
changes.push(ta.change(time(timeframe_2)) != 0)
changes.push(ta.change(time(timeframe_3)) != 0)
changes.push(ta.change(time(timeframe_4)) != 0)
changes.push(ta.change(time(timeframe_5)) != 0)
changes.push(ta.change(time(timeframe_6)) != 0)
changes.push(ta.change(time(timeframe_7)) != 0)
changes.push(ta.change(time(timeframe_8)) != 0)

is_new_h = ta.change(time("60")) != 0
float prv_c = close[1]
// High and low of the last fully completed H1 candle. These are used only to
// confirm a genuine 30% retest/rejection before any opposite-side H1 break.
float prv_h = request.security(syminfo.tickerid, "60", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float prv_l = request.security(syminfo.tickerid, "60", low[1],  gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

for [i, conf] in configs
    is50E = extend_50_line and (i == 0 or i == 1)

    int eff_max = show_only_2_recent ? 2 : max_unmitigated

    if conf.active
        lastC = conf.candles.size() > 0 ? conf.candles.get(0) : na
        if changes.get(i)
            if isTime(conf.tf, conf._hour, conf._minute)
                _zbg        = i == 0 ? z1_box_bg   : i == 1 ? z2_box_bg   : box_bg_col
                _zbord      = i == 0 ? z1_box_bord : i == 1 ? z2_box_bord : box_border_col
                _zhl        = i == 0 ? z1_hl_col   : i == 1 ? z2_hl_col   : hl_custom_col
                _ext_hour   = i == 0 ? 10 : i == 1 ? 16 : -1
                conf.candles.unshift(Candle.new(false, false, time, high, low, tapped=false, validated=false, isFiftyExtended=is50E, box_bg=_zbg, box_bord=_zbord, hl_col=_zhl, hl_extended=false, ext_start_hour=_ext_hour, flipped=false))
            else if not na(lastC)
                if not lastC.complete
                    lastC.complete := true
                    lastC.drawCandle()
                else if lastC.complete and not lastC.active
                    cBr = close < lastC._l
                    cBl = close > lastC._h
                    if cBr or cBl
                        lastC.bull := cBl
                        lastC.setMitigation()
                        lastC.setLevels()
                        lastC.setColor()
                        lastC.active := true
                        lastC.breakout_h1_time := time("60")
        else if not na(lastC) and not lastC.complete
            lastC._h := math.max(high, lastC._h)
            lastC._l := math.min(low, lastC._l)

    int i2 = 0
    while i2 < conf.candles.size()
        Candle c = conf.candles.get(i2)
        bool removed = false

        // An unvalidated TBR is ONLY a completed TBR for which no later
        // COMPLETED H1 candle has closed above its high or below its low.
        //
        // Check every closed H1 candle directly. This prevents an old TBR from
        // remaining gray merely because the earlier activation check missed the
        // first breakout H1 candle.
        if c.complete and not c.validated and is_new_h
            completed_h1_time = time("60")[1]
            after_tbr_candle   = not na(completed_h1_time) and completed_h1_time > c._t
            h1_break_above     = after_tbr_candle and prv_c > c._h
            h1_break_below     = after_tbr_candle and prv_c < c._l

            if h1_break_above or h1_break_below
                // A zone already activated by a chart-close breakout keeps its
                // original direction — the H1 confirmation only marks it
                // validated. This prevents a direction flip / recolor flicker.
                if not c.active
                    c.bull := h1_break_above
                    c.setMitigation()
                    c.setLevels()
                    c.active := true
                c.validated := true
                c.breakout_h1_time := completed_h1_time
                c.setColor()

        // Extend gray lines only while the TBR is genuinely still unvalidated
        // AND not yet activated. Because validation is checked first, the
        // endpoint remains on the exact H1 candle that produced the confirmed
        // breakout close.
        if c.complete and not c.active and not c.validated and show_unvalidated_tbr
            c.extend()

        isV = not only_validated or c.validated
        if c.active and isV
            if not c.tapped
                t30Bl = c.bull and low <= c._h - 0.3 * (c._h - c._l)
                t30Br = not c.bull and high >= c._l + 0.3 * (c._h - c._l)
                if t30Bl or t30Br
                    c.tapped := true

            // ── V TBR violation / confirmed-respect state machine ─────────
            // A TBR becomes permanently respected after price tests at least
            // 30% into the zone (therefore also covering 50% and 70% tests) and
            // then reaches the original breakout-side boundary: the TBR high
            // for a bullish TBR or the TBR low for a bearish TBR. Once respected,
            // a later opposite-side break can never convert it into a V TBR.
            //
            // A one-candle pass-through is still a V TBR unless that same H1
            // candle closes back outside the original breakout-side boundary.
            if not c.flipped and not c.mitigated30 and is_new_h
                m_range = c._h - c._l

                // Never use the original breakout H1 candle itself as a retest.
                completed_h1_time = time("60")[1]
                after_breakout = na(c.breakout_h1_time) or completed_h1_time > c.breakout_h1_time

                if after_breakout
                    // Preserve whether the 30%/50%/70% reaction was already
                    // armed by an earlier completed H1 candle.
                    respect_was_pending = c.respect_pending

                    // Arm respect from the completed H1 candle's WICK, not only
                    // its close. A 50% or 70% penetration also satisfies this
                    // 30% minimum test automatically.
                    bull_test30 = c.bull and prv_l <= c._h - 0.3 * m_range and prv_c >= c._l
                    bear_test30 = not c.bull and prv_h >= c._l + 0.3 * m_range and prv_c <= c._h

                    // Once a prior 30%/50%/70% reaction is pending, merely
                    // reaching the TBR high/low with the H1 wick confirms that
                    // the TBR was respected. For a same-H1 test, retain the
                    // close-back-outside requirement so a direct pass-through
                    // candle is not falsely counted as a reaction.
                    bull_respected = c.bull and ((respect_was_pending and prv_h >= c._h) or (bull_test30 and prv_c > c._h))
                    bear_respected = not c.bull and ((respect_was_pending and prv_l <= c._l) or (bear_test30 and prv_c < c._l))

                    // Confirmed respect has priority. After price reacts from
                    // 30%, 50% or 70% and reaches the TBR high/low, the zone can
                    // never be relabelled as V TBR by a later violation.
                    if bull_respected or bear_respected
                        c.mitigated30 := true
                        c.respect_pending := false
                        // A confirmed respect IS the mitigation: freeze it on
                        // this confirmation candle so it stops extending here.
                        if show_mitigated_tbr
                            frozen_zones.push(c)
                        else
                            c.removeDrawing()
                        conf.candles.remove(i2)
                        removed := true
                    else
                        bull_violated = c.bull and prv_c < c._l
                        bear_violated = not c.bull and prv_c > c._h

                        // Only an unrespected opposite-side H1 close creates V TBR.
                        if bull_violated or bear_violated
                            if show_vtbr
                                c.flip_below := prv_c < c._l
                                c.flipped := true
                                c.respect_pending := false
                                // The violating close belongs to the previous chart bar.
                                // Therefore, the current bar is already the first valid
                                // post-violation candle and may mitigate the V TBR.
                                c.flipped_bar := bar_index - 1
                                c.setFlippedColor()
                            else
                                c.removeDrawing()
                                conf.candles.remove(i2)
                                removed := true
                        else if bull_test30 or bear_test30
                            c.respect_pending := true
            // ─────────────────────────────────────────────────────────────────

            if not removed
                // While a zone can still flip, a close past the mitigation level
                // (into the far half) may be on its way to a full break — protect
                // it from the normal mitigation removal so the violation can
                // confirm. A RESPECTED zone (mitigated30) can never flip, so it
                // is exempt: a full pass-through simply mitigates and freezes it
                // instead of extending indefinitely.
                bool breaking_far = not c.mitigated30 and ((c.bull and close < c.mitigation) or (not c.bull and close > c.mitigation))

                if c.flipped
                    // Violated (V TBR): keep extending it to the right until price
                    // mitigates vtbr_percent_mitigation back into the zone (from the
                    // violated side) — that mitigation point is the extent. Freeze
                    // there. Excluded from the normal 50% mitigation.
                    if not c.frozen
                        v_range   = c._h - c._l
                        // Mitigation % is measured from the violated side of the TBR.
                        v_mit_lvl = c.flip_below ? c._l + (v_range * vtbr_percent_mitigation / 100) : c._h - (v_range * vtbr_percent_mitigation / 100)

                        // The violating close is the previous bar. Starting with
                        // the current bar, the first wick that reaches the level
                        // inside the V TBR is the exact final endpoint.
                        v_after_flip = bar_index > c.flipped_bar
                        v_mit_hit = v_after_flip and (c.flip_below ? high >= v_mit_lvl : low <= v_mit_lvl)
                        if v_mit_hit
                            // Stop every V TBR extension object exactly on the
                            // first valid post-violation mitigation candle.
                            if not na(c._0_ext)
                                c._0_ext.set_x2(time)
                            if not na(c._100_ext)
                                c._100_ext.set_x2(time)
                            if extend_30_line and not na(c._30)
                                c._30.set_x2(time)
                            if extend_70_line and not na(c._70)
                                c._70.set_x2(time)
                            if c.isFiftyExtended
                                if not na(c._50)
                                    c._50.set_x2(time)
                                if not na(c._50_label)
                                    c._50_label.set_x(time)
                            if extend_box
                                c._box.set_right(time)
                            c.frozen := true
                            // A frozen V TBR leaves the tracking array but keeps
                            // its drawings — exactly like a respected TBR frozen
                            // at its 50% mitigation. It no longer consumes a
                            // "Max Unmitigated Zones" slot and can never be
                            // deleted later by the zone-count pruning.
                            frozen_zones.push(c)
                            conf.candles.remove(i2)
                            removed := true
                        else
                            c.extend()
                    if not removed and i2 >= eff_max
                        // HISTORIC V TBR: with the toggle ON, an old violated
                        // zone still unmitigated by the V TBR % keeps extending
                        // to the current bar — the V TBR mitigation check above
                        // freezes and archives it exactly when that depth is
                        // finally hit. Nothing to do here in that case.
                        if show_only_2_recent
                            c.removeDrawing()
                            conf.candles.remove(i2)
                            removed := true
                        else if not show_historic_vtbr
                            // Toggle OFF: freeze in place — drawings persist,
                            // extension stops (archived for atomic cleanup).
                            frozen_zones.push(c)
                            conf.candles.remove(i2)
                            removed := true
                else if c.tapped and not show_mitigated_tbr
                    c.removeDrawing()
                    conf.candles.remove(i2)
                    removed := true
                else if i2 >= eff_max
                    // Beyond the zone-count cap.
                    if show_only_2_recent
                        c.removeDrawing()
                        conf.candles.remove(i2)
                        removed := true
                    else
                        // Snapshot historic eligibility the moment the zone
                        // ages past the cap: only zones still < 30% tapped
                        // qualify. Later 30% taps do NOT revoke it — the zone
                        // then runs until the HISTORIC mitigation depth.
                        if not c.historic and not c.tapped
                            c.historic := true
                        if c.historic and show_historic_tbr
                            // HISTORIC TBR: keeps extending to the current bar
                            // until price finally reaches the historic
                            // mitigation depth, measured from the breakout
                            // side. It freezes exactly on that candle.
                            h_range = c._h - c._l
                            h_lvl   = c.bull ? c._h - (h_range * historic_mitigation / 100) : c._l + (h_range * historic_mitigation / 100)
                            h_hit   = not c.respect_pending and not breaking_far and (c.bull ? low <= h_lvl : high >= h_lvl)
                            if h_hit
                                frozen_zones.push(c)
                                conf.candles.remove(i2)
                                removed := true
                            else
                                c.extend()
                        else
                            // Already tapped ≥ 30% (or historic mode off):
                            // freeze in place — drawings persist, extension stops.
                            frozen_zones.push(c)
                            conf.candles.remove(i2)
                            removed := true
                else if not c.respect_pending and not breaking_far and ((not c.bull and high >= c.mitigation) or (c.bull and low <= c.mitigation))
                    // Mitigated: freeze in place — drawings persist, extension stops.
                    frozen_zones.push(c)
                    conf.candles.remove(i2)
                    removed := true
                else
                    c.extend()

        // Advance only when the current element was NOT removed, so no zone is
        // ever skipped and no index ever goes stale (the ghosting/flicker fix).
        if not removed
            i2 += 1

// ── Atomic cleanup of the frozen-zone archive ────────────────────────────────
// Delete the OLDEST frozen zones in full (label + lines + box + fill in one
// pass) only when genuinely necessary: either the user's cap is exceeded, or
// ACTUAL object usage (line.all / label.all / box.all) approaches TradingView's
// 500-per-type limits. This keeps the maximum possible number of TBRs marked
// for any combination of line settings, while still guaranteeing the platform
// never recycles a zone's lines independently and strands orphan "TBR" text.
while frozen_zones.size() > 0 and (frozen_zones.size() > max_frozen_tbrs or line.all.size() > 480 or label.all.size() > 480 or box.all.size() > 480)
    Candle old_z = frozen_zones.shift()
    old_z.removeDrawing()

