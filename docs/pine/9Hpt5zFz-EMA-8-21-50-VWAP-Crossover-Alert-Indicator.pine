//@version=6
indicator(title="EMA 8/21/50 + VWAP Crossover Alert Indicator", shorttitle="EMA+VWAP Cross Alert", overlay=true)

// Inputs for EMA lengths (customizable)
ema8Length = input.int(8, title="8 EMA Length", minval=1)
ema21Length = input.int(21, title="21 EMA Length", minval=1)
ema50Length = input.int(50, title="50 EMA Length", minval=1)

// Input for VWAP source (customizable)
vwapSource = input.source(hlc3, title="VWAP Source")

// Inputs for custom label texts
bullishLabel = input.string("Bullish Cross", title="Bullish Label Text")
bearishLabel = input.string("Bearish Cross", title="Bearish Label Text")

// Calculate EMAs
ema8 = ta.ema(close, ema8Length)
ema21 = ta.ema(close, ema21Length)
ema50 = ta.ema(close, ema50Length)

// Calculate VWAP
vwapValue = ta.vwap(vwapSource)

// Plot EMAs and VWAP on the chart
plot(ema8, title="8 EMA", color=color.new(color.blue, 0), linewidth=2)
plot(ema21, title="21 EMA", color=color.new(color.orange, 0), linewidth=2)
plot(ema50, title="50 EMA", color=color.new(color.purple, 0), linewidth=2)
plot(vwapValue, title="VWAP", color=color.new(color.teal, 0), linewidth=2)

// Detect Crossovers (between 8 and 21 EMA only)
bullishCross = ta.crossover(ema8, ema21)
bearishCross = ta.crossunder(ema8, ema21)

// Plot Signals with Custom Labels using label.new
if (bullishCross)
    label.new(bar_index, low, text=bullishLabel, color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=size.small)

if (bearishCross)
    label.new(bar_index, high, text=bearishLabel, color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_down, size=size.small)

// Trigger Alerts
if (bullishCross)
    alert("Bullish EMA Crossover: 8 EMA crossed above 21 EMA on " + syminfo.ticker + " (" + timeframe.period + ")", alert.freq_once_per_bar_close)

if (bearishCross)
    alert("Bearish EMA Crossover: 8 EMA crossed below 21 EMA on " + syminfo.ticker + " (" + timeframe.period + ")", alert.freq_once_per_bar_close)