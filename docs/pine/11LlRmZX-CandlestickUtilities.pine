//@version=6

// @description This library provides utility functions and pattern detection tools for analyzing candlestick charts. 
// Designed to support technical analysis and strategy development in Pine Script®.
library("CandlestickUtilities", overlay = true)

// === Utility Functions ===

// @function: emaValue
// @description: Returns the EMA of the given source and length
emaValue(float source, int length) =>
    ta.ema(source, length)

// @function: candleLength
// @description: Returns the length of a candle (high - low)
candleLength(int i = 0) =>
    high[i] - low[i]

// @function: upperShadow
// @description: Returns the length of the upper shadow (wick)
upperShadow(int i = 0) =>
    high[i] - math.max(open[i], close[i])

// @function: lowerShadow
// @description: Returns the length of the lower shadow (tail)
lowerShadow(int i = 0) =>
    math.min(open[i], close[i]) - low[i]

// @function: candleBody
// @description: Returns the size of the candle body (absolute difference between open and close)
candleBody(int i = 0) =>
    math.abs(open[i] - close[i])

// === Trend Detection Functions ===

// @function: isUptrend
// @description: Returns true if EMA3 is above EMA5 using close price.
export isUptrend() =>
    emaValue(close, 3) > emaValue(close, 5)

// @function: isDowntrend
// @description: Returns true if EMA3 is below EMA5 using close price.
export isDowntrend() =>
    emaValue(close, 3) < emaValue(close, 5)

// === Candlestick Patterns ===

// @function: isHammer
// @description: 
// This function detects a "Hammer" candlestick pattern in a downtrend based on customizable allowances 
// 
// Parameters:
//  - bodyAllowance (float): The maximum size allowed for the body to avoid Doji candles. Default is na (uses syminfo.mintick * 2).
//  - upperWickAllowance (float): The maximum difference between the close price and the high to consider the candle as a "close near high". Default is na (uses syminfo.mintick * 2).
//  - emaLength (int): The length of the EMA used to check for downtrend. Default is 9.
//  - allowBlackBody (bool): Whether to allow a bearish body (black) for the pattern. Default is false (only allows bullish bodies).
//
// @return: 
// Returns true if all conditions for a Hammer pattern are met, otherwise false.
export isHammer(
     float bodyAllowance = na, 
     float upperWickAllowance = na, 
     bool allowBlackBody = false
     ) =>
    _defaultAllowance   = syminfo.mintick * 2
    _bodyAllowance      = na(bodyAllowance) ? _defaultAllowance : bodyAllowance
    _wickAllowance      = na(upperWickAllowance) ? _defaultAllowance : upperWickAllowance
    _isDoji             = candleBody() <= _bodyAllowance
    _closeNearHigh      = math.abs(close - high) <= _wickAllowance
    _longLowerShadow    = lowerShadow() >= 2 * candleBody()
    _isDowntrend        = isDowntrend()
    _isWhiteBody        = close > open
    _bodyColorOk        = allowBlackBody or _isWhiteBody

    not _isDoji and _closeNearHigh and _longLowerShadow and _isDowntrend and _bodyColorOk and barstate.isconfirmed

// @function: isHangman
// @description: 
// This function detects a "Hanging Man" candlestick pattern in an uptrend based on customizable allowances.
//
// Parameters:
//  - bodyAllowance (float): The maximum size allowed for the body to avoid Doji candles. Default is na (uses syminfo.mintick * 2).
//  - upperWickAllowance (float): The maximum difference between the close price and the high to consider the candle as a "close near high". Default is na (uses syminfo.mintick * 2).
//  - emaLength (int): The length of the EMA used to check for uptrend. Default is 9.
//  - allowWhiteBody (bool): Whether to allow a bullish body (white) for the pattern. Default is false (only allows bearish bodies).
//
// @return: 
// Returns true if all conditions for a Hanging Man pattern are met, otherwise false.
export isHangman(
     float bodyAllowance = na, 
     float upperWickAllowance = na, 
     bool allowWhiteBody = false
     ) =>
    _defaultAllowance   = syminfo.mintick * 2
    _bodyAllowance      = na(bodyAllowance) ? _defaultAllowance : bodyAllowance
    _wickAllowance      = na(upperWickAllowance) ? _defaultAllowance : upperWickAllowance
    _isDoji             = candleBody() <= _bodyAllowance
    _closeNearHigh      = math.abs(close - high) <= _wickAllowance
    _longLowerShadow    = lowerShadow() >= 2 * candleBody()
    _isUptrend          = isUptrend()
    _isBlackBody        = close < open
    _bodyColorOk        = allowWhiteBody or _isBlackBody

    not _isDoji and _closeNearHigh and _longLowerShadow and _isUptrend and _bodyColorOk and barstate.isconfirmed

// @function: isBullishEngulfing
// @description:
// Detects a Bullish Engulfing candlestick pattern.
// A bullish candle fully (or partially) engulfs the previous bearish candle's body,
// potentially signaling a reversal in a downtrend.
//
// Parameters:
//  - bodyAllowance (float): Minimum body size to exclude weak signals. Default is na (uses syminfo.mintick * 2).
//  - emaLength (int): EMA length to identify downtrend. Default is 9.
//  - fullEngulfing (bool): If true, the current candle must fully engulf the previous body. If false, partial engulfing is allowed.
//
// @return:
// Returns true if a Bullish Engulfing pattern is detected, otherwise false.
export isBullishEngulfing(
     float bodyAllowance = na, 
     bool fullEngulfing = false,
     bool checkTrend = true
     ) =>
    _defaultAllowance      = syminfo.mintick * 2
    _bodyAllowance         = na(bodyAllowance) ? _defaultAllowance : bodyAllowance
    _prevBearishBody       = close[1] < open[1]
    _currentBullishBody    = close > open
    _currentBodyBigEnough  = candleBody() > _bodyAllowance
    _isDowntrend           = isDowntrend()
    _strictEngulfing       = open < close[1] and close > open[1]
    _looseEngulfing        = close > open[1]
    _engulfsPrevious       = fullEngulfing ? _strictEngulfing : _looseEngulfing

    _prevBearishBody and _currentBullishBody and _engulfsPrevious and _currentBodyBigEnough and barstate.isconfirmed and checkTrend ? _isDowntrend : true

/// @function: isBearishEngulfing
// @description:
// Detects a Bearish Engulfing candlestick pattern.
// A bearish candle fully (or partially) engulfs the previous bullish candle's body,
// potentially signaling a reversal in an uptrend.
//
// Parameters:
//  - bodyAllowance (float): Minimum body size to exclude weak signals. Default is na (uses syminfo.mintick * 2).
//  - fullEngulfing (bool): If true, the current candle must fully engulf the previous body. If false, partial engulfing is allowed.
//
// @return:
// Returns true if a Bearish Engulfing pattern is detected, otherwise false.
export isBearishEngulfing(
     float bodyAllowance = na, 
     bool fullEngulfing = false,
     bool checkTrend = true
     ) =>
    _defaultAllowance       = syminfo.mintick * 2
    _bodyAllowance          = na(bodyAllowance) ? _defaultAllowance : bodyAllowance
    _prevBullishBody        = close[1] > open[1]
    _currentBearishBody     = close < open
    _currentBodyBigEnough   = candleBody() > _bodyAllowance
    _isUptrend              = isUptrend()
    _strictEngulfing        = open > close[1] and close < open[1]
    _looseEngulfing         = close < open[1]
    _engulfsPrevious        = fullEngulfing ? _strictEngulfing : _looseEngulfing

    _prevBullishBody and _currentBearishBody and _engulfsPrevious and _currentBodyBigEnough and barstate.isconfirmed and checkTrend ? _isUptrend : true

// @function: isDarkCloudCover
// @description:
// Detects the Dark Cloud Cover candlestick pattern.
// A bearish reversal pattern where a bearish candle opens above the previous bullish candle
// and closes below its midpoint.
//
// @return:
// Returns true if Dark Cloud Cover is detected, otherwise false.
export isDarkCloudCover() =>
    _prevBullishBody        = close[1] > open[1]
    _currentBearishBody     = close < open
    _isGapUp                = open > high[1]
    _midpointPrevious       = open[1] + (close[1] - open[1]) / 2
    _closesBelowMidpoint    = close < _midpointPrevious and close > open[1]
    _isUptrend              = isUptrend()

    _prevBullishBody and _currentBearishBody and _isGapUp and _closesBelowMidpoint and _isUptrend and barstate.isconfirmed

// @function: isPiercingPattern
// @description:
// Detects the Piercing Pattern candlestick pattern.
// A bullish reversal pattern where a bullish candle opens below the previous bearish candle
// and closes above its midpoint.
//
// @return:
// Returns true if Piercing Pattern is detected, otherwise false.
export isPiercingPattern() =>
    _prevBearishBody        = close[1] < open[1]
    _currentBullishBody     = close > open
    _isGapDown              = open < low[1]
    _midpointPrevious       = close[1] + (open[1] - close[1]) / 2
    _closesBelowMidpoint    = close > _midpointPrevious and close < open[1]
    _isDowntrend            = isDowntrend()

    _prevBearishBody and _currentBullishBody and _isGapDown and _closesBelowMidpoint and _isDowntrend and barstate.isconfirmed

// @function: isMorningStar
// @description:
// Detects the Morning Star candlestick pattern.
// A bullish reversal pattern made of a long bearish candle, a small-bodied candle (gap down),
// and a strong bullish candle that closes into the first candle's body.
//
// @return:
// Returns true if Morning Star is detected, otherwise false.
export isMorningStar() =>
    c1_bearish       = close[2] < open[2]
    c1_bodySize      = open[2] - close[2]
    c2_smallBody     = math.abs(close[1] - open[1]) < c1_bodySize * 0.3
    c2_gapDown       = open[1] < close[2]
    c3_bullish       = close > open
    c3_closesAboveMid = close > (open[2] + close[2]) / 2
    inDowntrend      = isDowntrend()

    c1_bearish and c2_smallBody and c2_gapDown and c3_bullish and c3_closesAboveMid and inDowntrend and barstate.isconfirmed

// @function: isEveningStar
// @description:
// Detects the Evening Star candlestick pattern.
//
// @return:
// Returns true if the Evening Star pattern is detected, otherwise false.
export isEveningStar() =>
    c1_bullish        = close[2] > open[2]
    c1_bodySize       = close[2] - open[2]
    c2_smallBody      = math.abs(close[1] - open[1]) < c1_bodySize * 0.3
    c2_gapUp          = open[1] > close[2]
    c3_bearish        = close < open
    c3_closesAboveMid = close < (open[2] + close[2]) / 2
    inUptrend         = isUptrend()

    c1_bullish and c2_smallBody and c2_gapUp and c3_bearish and c3_closesAboveMid and inUptrend and barstate.isconfirmed

// @function: isShootingStar
// @description:
// Detects the Shooting Star (Falling Star) candlestick pattern.
// A bearish reversal pattern with a small real body near the low,
// a long upper shadow (at least 2x the body), and minimal lower shadow.
// It appears after an uptrend and may have a bearish or bullish body based on settings.
//
// @return:
// Returns true if the Shooting Star pattern is detected, otherwise false.
export isShootingStar(
     float bodyAllowance = na, 
     float upperWickAllowance = na, 
     bool allowWhiteBody = true
     ) =>
    _defaultAllowance     = syminfo.mintick * 2
    _bodyAllowance        = na(bodyAllowance) ? _defaultAllowance : bodyAllowance
    _wickAllowance        = na(upperWickAllowance) ? _defaultAllowance : upperWickAllowance
    _bodySize             = candleBody()
    _upperWickSize        = upperShadow()
    _lowerWickSize        = lowerShadow()
    _longUpperShadow      = _upperWickSize >= 2 * _bodySize
    _smallLowerWick       = _lowerWickSize <= _bodySize * 0.25
    _closeNearLow         = math.abs(close - low) <= _wickAllowance
    _isUptrend            = isUptrend()
    _isBearishBody        = close < open
    _bodyColorOk          = allowWhiteBody or _isBearishBody

    _bodySize > _bodyAllowance and _longUpperShadow and _smallLowerWick and _closeNearLow and _isUptrend and _bodyColorOk and barstate.isconfirmed

// @function: isInvertedHammer
// @description:
// Detects the Inverted Hammer candlestick pattern in a downtrend.
// This is a potential bullish reversal pattern characterized by a small body, a long upper wick, and a short or nonexistent lower wick.
// The candle must appear during a downtrend and close near its low.
//
// Parameters:
//  - bodyAllowance (float): Minimum body size to exclude doji candles. Default is syminfo.mintick * 2.
//  - upperWickAllowance (float): Maximum difference between the close and low to consider the candle as "close near low". Default is syminfo.mintick * 2.
//
// @return:
// Returns true if all conditions for an Inverted Hammer are met, otherwise false.
export isInvertedHammer(
     float bodyAllowance = na, 
     float upperWickAllowance = na
     ) =>
    _defaultAllowance     = syminfo.mintick * 2
    _bodyAllowance        = na(bodyAllowance) ? _defaultAllowance : bodyAllowance
    _wickAllowance        = na(upperWickAllowance) ? _defaultAllowance : upperWickAllowance
    _bodySize             = candleBody()
    _upperWickSize        = upperShadow()
    _lowerWickSize        = lowerShadow()
    _longUpperShadow      = _upperWickSize >= 2 * _bodySize
    _smallLowerWick       = _lowerWickSize <= _bodySize * 0.25
    _closeNearLow         = math.abs(close - low) <= _wickAllowance
    _isDowntrend          = isDowntrend()

    _bodySize > _bodyAllowance and _longUpperShadow and _smallLowerWick and _closeNearLow and _isDowntrend and barstate.isconfirmed

// @function: isHarami
// @description:
// Detects the Harami candlestick pattern, which can be a potential bullish or bearish reversal signal.
// The pattern consists of a small-bodied candle that appears entirely within the body range of the previous candle.
// It typically signals market indecision and potential reversal when found in a trending market.
// This implementation checks for a significantly smaller body size (less than 20% of the previous body) and requires confirmation after the candle closes.
//
// @return:
// Returns true if the current candle's body is significantly smaller than the previous candle's body,
// and the condition is confirmed on the bar close (barstate.isconfirmed).
export isHarami() =>
    _bodySize     = candleBody()
    _bodySizePrev = candleBody(1)
    _checkCandleSize = _bodySize / _bodySizePrev < 0.2

    openPrev  = open[1]
    closePrev = close[1]
    openCurr  = open
    closeCurr = close

    bodyHighPrev = math.max(openPrev, closePrev)
    bodyLowPrev  = math.min(openPrev, closePrev)
    bodyHighCurr = math.max(openCurr, closeCurr)
    bodyLowCurr  = math.min(openCurr, closeCurr)

    _isCandleEngulfed = bodyHighCurr < bodyHighPrev and bodyLowCurr > bodyLowPrev

    _checkCandleSize and _isCandleEngulfed and barstate.isconfirmed

// @function: isThreeBlackCrows
// @description:
// Detects the Three Black Crows candlestick pattern, which typically indicates a potential bearish reversal after an uptrend.
// The pattern consists of three consecutive bearish candles, each closing lower than the previous one, ideally with little to no lower wicks.
// An uptrend is confirmed using a short EMA crossover (EMA-5 above EMA-9) prior to the pattern.
//
// Parameters:
//  - None. All logic is internally defined, including EMA-based uptrend detection.
//
// @return:
// Returns true if the last three candles are bearish and an uptrend is detected before them.
export isThreeBlackCrows(float wickRatio) =>
    _isFirstBearish     = close[2] < open[2]
    _isSecondBearish    = close[1] < open[1]
    _isThirdBearish     = close < open

    _maxPriceCheck      = high[1] < open[2] and high < open[1]
    _isUptrend          = ta.ema(close[2], 5) > ta.ema(close[2], 9)

    _isLowerWicksSmall  = lowerShadow(2) / candleBody(2) < wickRatio and 
                          lowerShadow(1) / candleBody(1) < wickRatio and 
                          lowerShadow() / candleBody() < wickRatio

    _isFirstBearish and _isSecondBearish and _isThirdBearish and _isUptrend and _maxPriceCheck and _isLowerWicksSmall and barstate.isconfirmed