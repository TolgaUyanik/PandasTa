//@version=6
strategy("Bollinger Bands Simple Strategy", overlay=true,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 5,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.05,
    pyramiding        = 0,
    process_orders_on_close = true)

// ───────────────────────── Inputs ─────────────────────────
length   = input.int  (20,   "BB Length",  minval = 1)
mult     = input.float(2.0,  "StdDev",     minval = 0.1, step = 0.1)
src      = input       (close,"Source")

slMult   = input.float(1.5,  "Stop Loss (ATR x)", minval = 0.1, step = 0.1)
atrLen   = input.int  (14,   "ATR Length")
riskReward = input.float(2.0, "Risk : Reward Ratio (1:X)", minval = 0.5, step = 0.1)
lookback = input.int  (5,    "Lookback for Swing (bars)", minval = 1)

// ─────────────────── Bollinger Band Calc ──────────────────
basis = ta.sma(src, length)
dev   = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev
atr   = ta.atr(atrLen)

// Dynamic SL: Recent swing low/high
swingLow  = ta.lowest(low, lookback)
swingHigh = ta.highest(high, lookback)

// ───────────────────────── Signals ────────────────────────
// BUY  — price closes below lower band
buySignal  = close < lower
// SELL — price closes above upper band
sellSignal = close > upper

longEntrySignal  = buySignal and strategy.position_size == 0
shortEntrySignal = sellSignal and strategy.position_size == 0

// ─────────────── Stop Loss / Take Profit (DYNAMIC) ─────────────────
// Stop Loss = recent swing + ATR buffer (updates each bar)
// Target = basis (20 SMA) updated each bar, OR Risk × Risk:Reward
var float activeLongSL  = na
var float activeLongTP  = na
var float activeShortSL = na
var float activeShortTP = na

if longEntrySignal
    activeLongSL  := swingLow - atr * slMult
    activeLongTP  := basis
    activeShortSL := na
    activeShortTP := na
    strategy.entry("Long", strategy.long, alert_message = "BUY")
    label.new(bar_index, low, "BUY\nPrice: " + str.tostring(close, format.mintick), style = label.style_label_up, textcolor = color.white, color = color.new(#00E676, 0))

if shortEntrySignal
    activeShortSL := swingHigh + atr * slMult
    activeShortTP := basis
    activeLongSL  := na
    activeLongTP  := na
    strategy.entry("Short", strategy.short, alert_message = "SELL")
    label.new(bar_index, high, "SELL\nPrice: " + str.tostring(close, format.mintick), style = label.style_label_down, textcolor = color.white, color = color.new(#FF1744, 0))

// DYNAMIC exits — SL and target update EVERY BAR
if strategy.position_size > 0
    activeLongSL := swingLow - atr * slMult    // Dynamic SL (trailing)
    activeLongTP := basis                      // Target = basis (mean reversion)
    strategy.exit("Long Exit", "Long", stop = activeLongSL, limit = activeLongTP, alert_message = "CLOSE LONG")

if strategy.position_size < 0
    activeShortSL := swingHigh + atr * slMult  // Dynamic SL (trailing)
    activeShortTP := basis                     // Target = basis
    strategy.exit("Short Exit", "Short", stop = activeShortSL, limit = activeShortTP, alert_message = "CLOSE SHORT")

if strategy.position_size[1] > 0 and strategy.position_size == 0 and not na(activeLongSL[1]) and not na(activeLongTP[1])
    longExitText = "Long Exit\nExit Price: " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(activeLongSL[1], format.mintick) + "\nTP: " + str.tostring(activeLongTP[1], format.mintick)
    label.new(bar_index, high, longExitText, style = label.style_label_down, textcolor = color.white, color = color.new(#FF6D00, 0))

if strategy.position_size[1] < 0 and strategy.position_size == 0 and not na(activeShortSL[1]) and not na(activeShortTP[1])
    shortExitText = "Short Exit\nExit Price: " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(activeShortSL[1], format.mintick) + "\nTP: " + str.tostring(activeShortTP[1], format.mintick)
    label.new(bar_index, low, shortExitText, style = label.style_label_up, textcolor = color.white, color = color.new(#FF6D00, 0))

if strategy.position_size == 0
    activeLongSL  := na
    activeLongTP  := na
    activeShortSL := na
    activeShortTP := na

// ──────────────────────── Plotting ────────────────────────
plot(basis, "Basis", color = color.new(#2962FF, 0), linewidth = 3)
p1 = plot(upper, "Upper Band", color = color.new(#F23645, 0))
p2 = plot(lower, "Lower Band", color = color.new(#089981, 0))
fill(p1, p2, title = "BB Background", color = color.rgb(33, 150, 243, 95))

plotshape(longEntrySignal,  "BUY",  shape.labelup,   location.belowbar, color.new(#00E676, 0), textcolor = color.white, text = "",  size = size.normal)
plotshape(shortEntrySignal, "SELL", shape.labeldown, location.abovebar, color.new(#FF1744, 0), textcolor = color.white, text = "", size = size.normal)

// Dynamic SL and Target (updates every bar while in trade)
plot(strategy.position_size > 0 ? activeLongSL : na, "Long SL (Dynamic)",  color.new(#FF6D00, 0), 2, plot.style_linebr)
plot(strategy.position_size < 0 ? activeShortSL : na, "Short SL (Dynamic)", color.new(#FF6D00, 0), 2, plot.style_linebr)
plot(strategy.position_size > 0 ? activeLongTP : strategy.position_size < 0 ? activeShortTP : na, "Target (Basis)", color.new(#90EE90, 0), 2, plot.style_linebr)

barcolor(longEntrySignal ? color.new(#00E676, 0) : shortEntrySignal ? color.new(#FF1744, 0) : na)

// ───────────────────────── Alerts ─────────────────────────
alertcondition(longEntrySignal,  "BB BUY",  "BB Strategy BUY  {{ticker}} @ {{close}}")
alertcondition(shortEntrySignal, "BB SELL", "BB Strategy SELL {{ticker}} @ {{close}}")