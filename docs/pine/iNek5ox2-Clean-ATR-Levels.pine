//@version=5
indicator("Clean ATR Levels", shorttitle="Clean ATR", overlay=true, max_lines_count=10)

// Input for ATR period
atr_period = input.int(14, title="ATR Length", minval=1, maxval=100)

// Input for line styling
level_size = input.int(2, title="Line Width", minval=1, maxval=5)
upper_level_color = input.color(color.white, title="Upper ATR Level Color")
lower_level_color = input.color(color.white, title="Lower ATR Level Color")
previous_close_color = input.color(color.blue, title="Previous Close Color")
show_previous_close = input.bool(true, title="Show Previous Close Line")

// Always use daily timeframe data regardless of current chart timeframe
ticker_id = syminfo.tickerid

// Get the daily data with proper gaps handling
daily_close = request.security(ticker_id, "1D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
daily_atr = request.security(ticker_id, "1D", ta.atr(atr_period), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Use the most recent close (current day's close)
previous_close = daily_close
current_atr = daily_atr

// Calculate the +100% and -100% ATR levels from previous close
upper_100 = previous_close + current_atr    // +100% ATR level
lower_100 = previous_close - current_atr    // -100% ATR level

// Detect if we're in a new trading day
is_new_day = ta.change(time("1D"))

// Function to calculate bars until session end (4 PM EST)
get_bars_to_session_end() =>
    current_time = time
    session_end = timestamp(year(current_time), month(current_time), dayofmonth(current_time), 16, 0) // 4 PM EST
    
    // If current time is past 4 PM, target next day's 4 PM
    if current_time >= session_end
        session_end := session_end + 86400000 // Add 24 hours in milliseconds
    
    // Calculate approximate bars until session end based on timeframe
    timeframe_minutes = timeframe.in_seconds() / 60
    minutes_to_end = (session_end - current_time) / 60000 // Convert to minutes
    bars_to_end = math.max(1, math.round(minutes_to_end / timeframe_minutes))
    bars_to_end

// Variables to store line objects
var line upper_line = na
var line lower_line = na
var line prev_close_line = na

// Simple approach: Draw lines until session end when new day starts
if is_new_day and not na(previous_close) and not na(current_atr)
    // Delete previous lines if they exist
    if not na(upper_line)
        line.delete(upper_line)
        upper_line := na
    if not na(lower_line)
        line.delete(lower_line)
        lower_line := na
    if not na(prev_close_line)
        line.delete(prev_close_line)
        prev_close_line := na
    
    // Calculate bars until session end
    line_length = get_bars_to_session_end()
    
    // Create upper ATR line
    upper_line := line.new(x1=bar_index, y1=upper_100, x2=bar_index + line_length, y2=upper_100, 
                          color=upper_level_color, width=level_size, 
                          style=line.style_solid, extend=extend.none)
    
    // Create lower ATR line
    lower_line := line.new(x1=bar_index, y1=lower_100, x2=bar_index + line_length, y2=lower_100, 
                          color=lower_level_color, width=level_size, 
                          style=line.style_solid, extend=extend.none)
    
    // Create previous close line (if enabled)
    if show_previous_close
        prev_close_line := line.new(x1=bar_index, y1=previous_close, x2=bar_index + line_length, y2=previous_close, 
                                   color=previous_close_color, width=level_size, 
                                   style=line.style_solid, extend=extend.none)

// On the last bar, make sure we have lines (in case we start viewing mid-session)
if barstate.islast and na(upper_line) and not na(previous_close) and not na(current_atr)
    line_length = get_bars_to_session_end()
    
    upper_line := line.new(x1=bar_index, y1=upper_100, x2=bar_index + line_length, y2=upper_100, 
                          color=upper_level_color, width=level_size, 
                          style=line.style_solid, extend=extend.none)
    
    lower_line := line.new(x1=bar_index, y1=lower_100, x2=bar_index + line_length, y2=lower_100, 
                          color=lower_level_color, width=level_size, 
                          style=line.style_solid, extend=extend.none)
    
    if show_previous_close
        prev_close_line := line.new(x1=bar_index, y1=previous_close, x2=bar_index + line_length, y2=previous_close, 
                                   color=previous_close_color, width=level_size, 
                                   style=line.style_solid, extend=extend.none)

// Display current values in a clean info table
show_info = input.bool(true, title="Show Info Table")
if show_info and barstate.islast and not na(previous_close) and not na(current_atr)
    var table info_table = table.new(position.top_right, 2, 4, bgcolor=color.white, border_width=1)
    table.cell(info_table, 0, 0, "ATR Value:", text_color=color.black, text_size=size.small, bgcolor=color.white)
    table.cell(info_table, 1, 0, "$" + str.tostring(current_atr, "#.##"), text_color=color.orange, text_size=size.small, bgcolor=color.white)
    table.cell(info_table, 0, 1, "Prev Close:", text_color=color.black, text_size=size.small, bgcolor=color.white)
    table.cell(info_table, 1, 1, "$" + str.tostring(previous_close, "#.##"), text_color=color.blue, text_size=size.small, bgcolor=color.white)
    table.cell(info_table, 0, 2, "+100% ATR:", text_color=color.black, text_size=size.small, bgcolor=color.white)
    table.cell(info_table, 1, 2, "$" + str.tostring(upper_100, "#.##"), text_color=color.green, text_size=size.small, bgcolor=color.white)
    table.cell(info_table, 0, 3, "-100% ATR:", text_color=color.black, text_size=size.small, bgcolor=color.white)
    table.cell(info_table, 1, 3, "$" + str.tostring(lower_100, "#.##"), text_color=color.red, text_size=size.small, bgcolor=color.white)