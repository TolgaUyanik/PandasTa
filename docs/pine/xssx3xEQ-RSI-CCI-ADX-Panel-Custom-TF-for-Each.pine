//@version=5
indicator("RSI, CCI, ADX Panel (Custom TF for Each)", overlay=false)

// --- RSI Inputs ---
rsi_length   = input.int(14, "RSI Length", minval=1)
rsi_tf       = input.timeframe("", "RSI Time Frame (empty uses chart)")
// --- CCI Inputs ---
cci_length   = input.int(20, "CCI Length", minval=1)
cci_tf       = input.timeframe("", "CCI Time Frame (empty uses chart)")
// --- ADX Inputs ---
adx_length   = input.int(14, "ADX Length", minval=1)
adx_smooth   = input.int(14, "ADX Smoothing", minval=1)
adx_tf       = input.timeframe("", "ADX Time Frame (empty uses chart)")

// --- Custom ADX function for security ---
get_adx(l, s) =>
    [plus, minus, adx] = ta.dmi(l, s)
    adx

// --- Calculations (each on its own TF) ---
// RSI
rsi_val = request.security(syminfo.tickerid, rsi_tf == "" ? timeframe.period : rsi_tf, ta.rsi(close, rsi_length))
// CCI
cci_val = request.security(syminfo.tickerid, cci_tf == "" ? timeframe.period : cci_tf, ta.cci(close, cci_length))
// ADX: Use the custom function to extract ONLY the ADX
adx_val = request.security(syminfo.tickerid, adx_tf == "" ? timeframe.period : adx_tf, get_adx(adx_length, adx_smooth))

// --- Plotting ---
plot(rsi_val, "RSI", color.new(#2196F3, 0), 2)         // Blue
plot(cci_val, "CCI", color.new(#FF9800, 0), 2)         // Orange
plot(adx_val, "ADX", color.new(#9C27B0, 0), 2)         // Purple

