//@version=6
indicator("Médias 9, 20 e 200", overlay=true)

// Cálculo das médias
ema9   = ta.ema(close, 9)
ema20  = ta.ema(close, 20)
sma200 = ta.sma(close, 200)

// Exibição no gráfico
plot(ema9, title="EMA 9", color=color.purple, linewidth=2)
plot(ema20, title="EMA 20", color=color.green, linewidth=2)
plot(sma200, title="Média Aritmética 200", color=color.rgb(255, 105, 180), linewidth=2)