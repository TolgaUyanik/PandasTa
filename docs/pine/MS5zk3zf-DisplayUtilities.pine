// @description Display utilities for color management and visual presentation by AlKaIsMe
library("DisplayUtilities")

// @function Get candle color based on direction and color scheme
// @param direction Direction value (-2, -1, 0, 1, 2)
// @param up_excessive Color for +2 direction
// @param up_normal Color for +1 direction  
// @param neutral Color for 0 direction
// @param down_normal Color for -1 direction
// @param down_excessive Color for -2 direction
// @returns Appropriate color for the direction
export get_direction_color(int direction, color up_excessive, color up_normal, color neutral, color down_normal, color down_excessive) =>
    switch direction
        2 => up_excessive
        1 => up_normal
        -1 => down_normal
        -2 => down_excessive
        0 => neutral
        => na

// @function Get candle directions for different painting algorithms
// @param paint_opt Painting option algorithm
// @param body_dir Body direction
// @param bar_dir Bar direction
// @param breakout_dir Breakout direction
// @param combined_dir Combined direction
// @returns [body_paint_dir, border_paint_dir, wick_paint_dir, unified_dir]
export get_candle_paint_directions(string paint_opt, int body_dir, int bar_dir, int breakout_dir, int combined_dir) =>
    switch paint_opt
        "Combined Direction" => [body_dir, bar_dir, breakout_dir, bar_dir]
        "Body Direction" => [body_dir, body_dir, body_dir, body_dir]
        "Bar Direction" => [bar_dir, bar_dir, bar_dir, bar_dir]
        "Combined Bar Direction" => [bar_dir, body_dir, breakout_dir, bar_dir]
        "Breakout Direction" => [breakout_dir, breakout_dir, breakout_dir, breakout_dir]
        "One Direction" => [combined_dir, combined_dir, combined_dir, combined_dir]
        "Strength Factor Filter Overlay" => [na, na, na, na]
        => [na, na, na, na]

// @function Get paint directions based on bias filter
// @param paint_bias Paint bias option ("All", "Bull Bias", "Bear Bias")
// @param unified_dir Unified direction
// @returns [bias_dir_a, bias_dir_b] Directions for two plotcandle series
export get_bias_paint_directions(string paint_bias, int unified_dir) =>
    int dir_a = paint_bias == "All" or paint_bias == "Bull Bias" ? (unified_dir > 0 ? unified_dir : na) : na
    int dir_b = paint_bias == "All" or paint_bias == "Bear Bias" ? (unified_dir <= 0 ? unified_dir : na) : na
    [dir_a, dir_b]

// @function Calculate transparency levels for strength factor filtering
// @param sf_filtered Is strength factor filtered
// @param fade_option Fade option ("Disabled", "Fade Candle", "Do Not Fade Wick", "Do Not Fade Wick and Border")
// @param fade_opacity Fade opacity percentage
// @returns [body_transparency, border_transparency, wick_transparency]
export get_transparency_levels(bool sf_filtered, string fade_option, int fade_opacity) =>
    int body_transp = 0
    int border_transp = 0  
    int wick_transp = 0
    
    if sf_filtered
        switch fade_option
            "Fade Candle" =>
                body_transp := fade_opacity
                border_transp := fade_opacity
                wick_transp := fade_opacity
            "Do Not Fade Wick" =>
                body_transp := fade_opacity
                border_transp := fade_opacity
                wick_transp := 0
            "Do Not Fade Wick and Border" =>
                body_transp := fade_opacity
                border_transp := 0
                wick_transp := 0
    
    [body_transp, border_transp, wick_transp]

// @function Generate strength factor filter conditions
// @param filter_option Filter option string
// @param individual_filters Map of individual filter conditions
// @returns Boolean filter result
export get_strength_factor_filter(string filter_option, map<string, bool> individual_filters) =>
    switch filter_option
        "Always In Score" => map.get(individual_filters, "always_in_score")
        "Always In Direction" => map.get(individual_filters, "always_in_direction")
        "Always In Bar Direction" => map.get(individual_filters, "always_in_bar_direction")
        "Distance" => map.get(individual_filters, "distance")
        "Uniformity" => map.get(individual_filters, "uniformity")
        "Overlap" => map.get(individual_filters, "overlap")
        "Overlap and Distance" => map.get(individual_filters, "overlap") or map.get(individual_filters, "distance")
        "Body" => map.get(individual_filters, "body")
        "Close" => map.get(individual_filters, "close")
        "Breakout" => map.get(individual_filters, "breakout")
        "Breakout and Close" => map.get(individual_filters, "breakout") or map.get(individual_filters, "close")
        "Breakout Plus" => map.get(individual_filters, "breakout_plus")
        "Direction" => map.get(individual_filters, "direction")
        "Combined Direction" => map.get(individual_filters, "combined_direction")
        "User Defined Combination" => map.get(individual_filters, "user_defined_combination")
        => false

// @function Generate signal bar conditions (inverted filters)
// @param signal_option Signal bar option string  
// @param individual_filters Map of individual filter conditions
// @returns Boolean signal bar result
export get_signal_bar_condition(string signal_option, map<string, bool> individual_filters) =>
    switch signal_option
        "Always In Score" => not map.get(individual_filters, "always_in_score")
        "Always In Direction" => not map.get(individual_filters, "always_in_direction")
        "Always In Bar Direction" => not map.get(individual_filters, "always_in_bar_direction")
        "Distance" => not map.get(individual_filters, "distance")
        "Uniformity" => not map.get(individual_filters, "uniformity")
        "Overlap" => not map.get(individual_filters, "overlap")
        "Overlap and Distance" => not map.get(individual_filters, "overlap") and not map.get(individual_filters, "distance")
        "Body" => not map.get(individual_filters, "body")
        "Close" => not map.get(individual_filters, "close")
        "Breakout" => not map.get(individual_filters, "breakout")
        "Breakout and Close" => not map.get(individual_filters, "breakout") and not map.get(individual_filters, "close")
        "Breakout Plus" => not map.get(individual_filters, "breakout_plus")
        "Direction" => not map.get(individual_filters, "direction")
        "Combined Direction" => not map.get(individual_filters, "combined_direction")
        "User Defined Combination" => not map.get(individual_filters, "user_defined_combination")
        => false

// @function Get Z-score signal bar conditions
// @param z_signal_option Z-score signal option
// @param z_filters Map of Z-score filters
// @returns Boolean Z-score signal condition
export get_zscore_signal_condition(string z_signal_option, map<string, bool> z_filters) =>
    switch z_signal_option
        "Z Distance" => map.get(z_filters, "bar_dist")
        "Z Body" => map.get(z_filters, "body_dist") 
        "Z Consecutive Highs Lows" => map.get(z_filters, "chl_dist")
        "Z Consecutive Closes" => map.get(z_filters, "cc_dist")
        "Z Separation from the Mean" => map.get(z_filters, "m_dist")
        "All zScore Signal Bars" => map.get(z_filters, "any_zscore")
        => false

// @function Create a standard color scheme for directions
// @returns [up_excessive, up_normal, neutral, down_normal, down_excessive] Standard color set
export get_standard_colors() =>
    color up_excessive = #924ed7    // Purple for excessive bullish
    color up_normal = #0000CD       // Blue for normal bullish
    color neutral = color.gray      // Gray for neutral
    color down_normal = #FF0000     // Red for normal bearish
    color down_excessive = #ec407a  // Pink for excessive bearish
    [up_excessive, up_normal, neutral, down_normal, down_excessive]

// @function Modify directions for Z-score excess display
// @param original_dir Original direction
// @param z_filtered Is Z-score filtered (shows excess)
// @returns Modified direction (doubled if excess detected)
export apply_zscore_modification(int original_dir, bool z_filtered) =>
    z_filtered ? original_dir * 2 : original_dir

// @function Get default fade colors for strength factor overlay
// @returns [bullish_fade_color, bearish_fade_color] Default colors for TV overlay
export get_default_fade_colors() =>
    color bullish_fade = #d7d7d7    // Light gray for bullish fade
    color bearish_fade = #0a0a0a    // Dark gray for bearish fade
    [bullish_fade, bearish_fade]

// @function Check if paint algorithm should show candles
// @param paint_algo Paint algorithm option
// @returns True if algorithm should display candles
export should_paint_candles(string paint_algo) =>
    paint_algo != "Do not paint candles" and paint_algo != "Strength Factor Filter Overlay"

// @function Get signal bar character based on signal type
// @param signal_type Signal type ("strength_factor" or "zscore")
// @param is_bullish Direction is bullish
// @returns [character, location] Character and location for plotchar
export get_signal_bar_char(string signal_type, bool is_bullish) =>
    if signal_type == "strength_factor"
        if is_bullish
            ["◒", location.abovebar]
        else
            ["◓", location.belowbar]
    else if signal_type == "zscore"
        if is_bullish
            ["◐", location.abovebar]
        else
            ["◐", location.belowbar]
    else
        ["", location.absolute]

// @function Get signal bar colors
// @param signal_type Signal type ("strength_factor" or "zscore")
// @param is_bullish Direction is bullish
// @returns Signal bar color
export get_signal_bar_color(string signal_type, bool is_bullish) =>
    if signal_type == "strength_factor"
        if is_bullish
            color.aqua
        else
            color.orange
    else if signal_type == "zscore"
        if is_bullish
            color.purple
        else
            color.fuchsia
    else
        color.gray