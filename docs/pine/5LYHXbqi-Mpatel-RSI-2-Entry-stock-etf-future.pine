//@version=5
// ============================================================
// RSI DCA 2-Entry Strategy — Works on Stocks, Futures, Crypto
// Tested for MNQ (Micro Nasdaq Futures)
// Entry 1 : RSI oversold + price <= fixed limit price
// Entry 2 : RSI oversold AGAIN + price <= Entry1 - dcaPct%
// ============================================================
strategy(title="Mpatel RSI 2-Entry (Futures Ready)", shorttitle="Mpatel RSI-2E Future", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=0.62, slippage=2, pyramiding=2)

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────
i_rsiLen     = input.int(14,     "RSI Length",                    minval=1,  maxval=100, group="RSI Settings")
i_rsiSrc     = input.source(close, "RSI Source",                             group="RSI Settings")
i_oversold   = input.int(30,     "Oversold Level",                minval=1,  maxval=49,  group="RSI Settings")
i_overbought = input.int(70,     "Overbought Level",              minval=51, maxval=99,  group="RSI Settings")

// For MNQ use the current futures price e.g. 19000, 20000 etc.
i_limitPrice = input.float(1, "Limit Buy Price",            minval=0.01, step=0.25, group="Entry Settings")
i_dcaPct     = input.float(2,  "Entry 2 Drop from Entry 1 (%)", minval=0.01, step=0.1, group="Entry Settings")

i_useTP      = input.bool(true,  "Enable Take Profit",            group="Exit Settings")
i_tpPct      = input.float(3.0, "Take Profit (%)",                minval=0.01, step=0.1, group="Exit Settings")
i_useSL      = input.bool(false,  "Enable Stop Loss",              group="Exit Settings")
i_slPct      = input.float(8.0, "Stop Loss (%)",                  minval=0.01, step=0.1, group="Exit Settings")
i_rsiExit    = input.bool(true,  "RSI Overbought Exit",           group="Exit Settings")
i_showTable  = input.bool(true,  "Show Dashboard",                group="Display")

// ─────────────────────────────────────────────────────────────
// RSI — use close, not a series input, avoids repaint on futures
// ─────────────────────────────────────────────────────────────
rsiVal       = ta.rsi(i_rsiSrc, i_rsiLen)

// Use crossunder for clean single-bar signal
rsiOversold  = ta.crossunder(rsiVal, i_oversold)
rsiOBought   = ta.crossover(rsiVal, i_overbought)

// ─────────────────────────────────────────────────────────────
// STATE
// ─────────────────────────────────────────────────────────────
var float entry1Fill = na
var float dca2Level  = na
var bool  entry1Open = false
var bool  entry2Open = false

posSize = strategy.position_size
isFlat  = posSize == 0

// Full reset when flat
if isFlat
    entry1Fill := na
    dca2Level  := na
    entry1Open := false
    entry2Open := false

// Capture Entry 1 fill price
if strategy.opentrades == 1 and strategy.opentrades[1] == 0 and not entry1Open
    entry1Fill := strategy.opentrades.entry_price(0)
    dca2Level  := entry1Fill * (1.0 - i_dcaPct / 100.0)
    entry1Open := true

// Capture Entry 2 fill
if strategy.opentrades == 2 and strategy.opentrades[1] == 1 and not entry2Open
    entry2Open := true

// ─────────────────────────────────────────────────────────────
// ENTRY CONDITIONS
// Using close for price check — works correctly on futures
// ─────────────────────────────────────────────────────────────

// Entry 1: RSI oversold cross + price at or below limit
buy1OK = rsiOversold and close <= i_limitPrice and isFlat

// Entry 2: RSI oversold cross AGAIN + price at or below DCA level
buy2OK = rsiOversold and not na(dca2Level) and close <= dca2Level and entry1Open and not entry2Open

// ─────────────────────────────────────────────────────────────
// ORDERS
// Using market order on futures to guarantee fill —
// limit orders on futures can miss by 1 tick easily
// ─────────────────────────────────────────────────────────────
if buy1OK
    strategy.entry("Buy1", strategy.long, comment="Entry 1")

if buy2OK
    strategy.entry("Buy2", strategy.long, comment="Entry 2 DCA")

// ─────────────────────────────────────────────────────────────
// EXIT
// ─────────────────────────────────────────────────────────────
if posSize > 0
    ep      = strategy.position_avg_price
    tpPrice = i_useTP ? ep * (1.0 + i_tpPct / 100.0) : na
    slPrice = i_useSL ? ep * (1.0 - i_slPct / 100.0) : na
    strategy.exit("Exit1", from_entry="Buy1", limit=tpPrice, stop=slPrice)
    strategy.exit("Exit2", from_entry="Buy2", limit=tpPrice, stop=slPrice)

if posSize > 0 and i_rsiExit and rsiOBought
    strategy.close_all(comment="RSI OB Exit")

// ─────────────────────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────────────────────

// Entry 1 fixed limit line
//plot(i_limitPrice, title="Entry 1 Limit", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_line)

// Entry 2 DCA level — only show while waiting for Entry 2
//plot(not na(dca2Level) and entry1Open and not entry2Open ? dca2Level : na, title="Entry 2 DCA Level", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)

// Average entry line while in trade
//plot(posSize > 0 ? strategy.position_avg_price : na, title="Avg Entry", color=color.new(color.white, 40), linewidth=1, style=plot.style_linebr)

// Buy signals
//plotshape(buy1OK, title="Entry 1", location=location.belowbar, style=shape.labelup, color=color.new(color.lime, 0), textcolor=color.black, text="BUY 1", size=size.normal)
//plotshape(buy2OK, title="Entry 2", location=location.belowbar, style=shape.labelup, color=color.new(color.orange, 0), textcolor=color.black, text="BUY 2", size=size.normal)

// RSI fired but price above limit (Entry 1 blocked)
//plotshape(rsiOversold and close > i_limitPrice and isFlat, title="Entry 1 Blocked", location=location.belowbar, style=shape.xcross, color=color.new(color.red, 40), size=size.tiny)

// RSI fired but price above DCA level (Entry 2 blocked)
//plotshape(rsiOversold and not na(dca2Level) and close > dca2Level and entry1Open and not entry2Open, title="Entry 2 Blocked", location=location.belowbar, style=shape.xcross, color=color.new(color.orange, 40), size=size.tiny)

// RSI exit
plotshape(rsiOBought and posSize > 0 and i_rsiExit, title="RSI Exit", location=location.abovebar, style=shape.triangledown, color=color.new(color.red, 10), size=size.small)

// Backgrounds
//bgcolor(isFlat and close <= i_limitPrice ? color.new(color.green, 92) : na, title="Buy Zone BG")
//bgcolor(entry1Open and not entry2Open ? color.new(color.blue, 90) : na, title="1 Position BG")
//bgcolor(entry2Open ? color.new(color.purple, 88) : na, title="2 Positions BG")

// ─────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────
if i_showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 12, border_width=1, border_color=color.new(color.gray, 50), bgcolor=color.new(color.black, 55))

    table.cell(t, 0, 0, "RSI DCA 2-ENTRY", text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 20), text_halign=text.align_center)
    table.cell(t, 1, 0, syminfo.ticker, text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 20), text_halign=text.align_center)

    rsiColor = rsiVal < i_oversold ? color.lime : rsiVal > i_overbought ? color.red : color.white
    table.cell(t, 0, 1, "RSI (" + str.tostring(i_rsiLen) + ")", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(rsiVal, "#.00"), text_color=rsiColor, text_size=size.small)

    table.cell(t, 0, 2, "Current Price", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(close, format.mintick), text_color=color.white, text_size=size.small)

    table.cell(t, 0, 3, "Entry 1 Limit", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(i_limitPrice, format.mintick), text_color=color.yellow, text_size=size.small)

    e1Status = not entry1Open ? (close <= i_limitPrice ? "Ready - Waiting RSI" : "Waiting: price > limit") : "Filled @ " + str.tostring(entry1Fill, format.mintick)
    e1Color  = not entry1Open ? (close <= i_limitPrice ? color.lime : color.gray) : color.lime
    table.cell(t, 0, 4, "Entry 1 Status", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 4, e1Status, text_color=e1Color, text_size=size.small)

    e2LevelStr = na(dca2Level) ? "Need Entry 1 first" : str.tostring(dca2Level, format.mintick)
    e2Color    = na(dca2Level) ? color.gray : entry2Open ? color.lime : color.orange
    table.cell(t, 0, 5, "Entry 2 Level (-" + str.tostring(i_dcaPct) + "%)", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 5, e2LevelStr, text_color=e2Color, text_size=size.small)

    e2Status = not entry1Open ? "Wait for Entry 1" : entry2Open ? "Filled" : (close <= dca2Level ? "Ready - Waiting RSI" : "Waiting: RSI + Price <= " + str.tostring(dca2Level, format.mintick))
    table.cell(t, 0, 6, "Entry 2 Status", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 6, e2Status, text_color=e2Color, text_size=size.small)

    avgStr = posSize > 0 ? str.tostring(strategy.position_avg_price, format.mintick) : "—"
    table.cell(t, 0, 7, "Avg Entry", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 7, avgStr, text_color=color.white, text_size=size.small)

    tpStr = posSize > 0 and i_useTP ? str.tostring(strategy.position_avg_price * (1.0 + i_tpPct / 100.0), format.mintick) : "—"
    slStr = posSize > 0 and i_useSL ? str.tostring(strategy.position_avg_price * (1.0 - i_slPct / 100.0), format.mintick) : "—"
    table.cell(t, 0, 8, "TP / SL", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 8, tpStr + " / " + slStr, text_color=color.white, text_size=size.small)

    posLabel = isFlat ? "Flat" : entry2Open ? "2 Open" : "1 Open"
    posCol   = isFlat ? color.gray : entry2Open ? color.purple : color.blue
    table.cell(t, 0, 9, "Positions", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 9, posLabel, text_color=posCol, text_size=size.small)

    totalTrades = strategy.closedtrades
    winRate     = totalTrades > 0 ? (strategy.wintrades / totalTrades) * 100 : 0.0
    table.cell(t, 0, 10, "Win Rate", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 10, str.tostring(winRate, "#.0") + "% (" + str.tostring(totalTrades) + ")", text_color=winRate >= 50 ? color.lime : color.red, text_size=size.small)

    pnlColor = strategy.netprofit >= 0 ? color.lime : color.red
    table.cell(t, 0, 11, "Net P&L", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 11, "$" + str.tostring(strategy.netprofit, "#.00"), text_color=pnlColor, text_size=size.small)
