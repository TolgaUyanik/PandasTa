//@version=6
indicator("Earnings Move Table (Last 2 Years)", overlay=true)

if not timeframe.isdaily
    runtime.error("Apply this script on the Daily timeframe for accurate results.")

// ---- Data arrays (one row per earnings event) ----
var array<string> dates      = array.new<string>()
var array<float>  beforePct  = array.new<float>()   // day before earnings
var array<float>  onDayPct   = array.new<float>()   // earnings day move
var array<float>  afterPct   = array.new<float>()   // day after earnings
var array<float>  maxPct     = array.new<float>()   // largest |move| of the 3 above (signed)
var array<float>  pre5Pct    = array.new<float>()   // 5-day cumulative move BEFORE the "day before" day
var array<float>  pre10Pct   = array.new<float>()   // 10-day cumulative move BEFORE the "day before" day
var array<float>  post5Pct   = array.new<float>()   // 5-day cumulative move AFTER the "day after" day
var array<float>  post20Pct  = array.new<float>()   // 20-day cumulative move AFTER the "day after" day
var array<float>  post40Pct  = array.new<float>()   // 40-day cumulative move AFTER the "day after" day

// Tracks earnings events still waiting on future bars (after/post5/post20/post40)
var array<int> pendingRow = array.new<int>()   // row index into the arrays above
var array<int> pendingE   = array.new<int>()   // bar_index of the earnings bar

epsActual = request.earnings(syminfo.tickerid, earnings.actual)
isEarningsBar = not na(epsActual) and (na(epsActual[1]) or epsActual != epsActual[1])

twoYearsMs = 730 * 24 * 60 * 60 * 1000

// ---- 1) Resolve pending future-dependent values ----
if array.size(pendingRow) > 0
    for i = array.size(pendingRow) - 1 to 0
        row = array.get(pendingRow, i)
        E   = array.get(pendingE, i)
        bs  = bar_index - E   // bars elapsed since the earnings bar

        if bs == 1
            a = (close - close[1]) / close[1] * 100
            array.set(afterPct, row, a)
            b = array.get(beforePct, row)
            o = array.get(onDayPct, row)
            mx = math.max(math.abs(b), math.abs(o), math.abs(a))
            signedMax = math.abs(b) == mx ? b : (math.abs(o) == mx ? o : a)
            array.set(maxPct, row, signedMax)

        if bs == 6
            array.set(post5Pct, row, (close - close[5]) / close[5] * 100)

        if bs == 21
            array.set(post20Pct, row, (close - close[20]) / close[20] * 100)

        if bs == 41
            array.set(post40Pct, row, (close - close[40]) / close[40] * 100)
            array.remove(pendingRow, i)
            array.remove(pendingE, i)

// ---- 2) Detect a new earnings event, log immediately-available values ----
if isEarningsBar and bar_index > 12 and (timenow - time) <= twoYearsMs
    beforeMove = (close[1] - close[2]) / close[2] * 100
    onDayMove  = (close - close[1]) / close[1] * 100
    pre5       = (close[2] - close[7])  / close[7]  * 100
    pre10      = (close[2] - close[12]) / close[12] * 100

    array.push(dates, str.format("{0,date,yyyy-MM-dd}", time))
    array.push(beforePct, beforeMove)
    array.push(onDayPct, onDayMove)
    array.push(pre5Pct, pre5)
    array.push(pre10Pct, pre10)
    array.push(afterPct, na)
    array.push(maxPct, na)
    array.push(post5Pct, na)
    array.push(post20Pct, na)
    array.push(post40Pct, na)

    array.push(pendingRow, array.size(dates) - 1)
    array.push(pendingE, bar_index)

// ---- Table ----
var table t = table.new(position.top_right, 10, 20, border_width = 1)

f_cell(_col, _row, _val) =>
    txt = na(_val) ? "N/A" : str.tostring(_val, "#.##") + "%"
    col = na(_val) ? color.gray : (_val >= 0 ? color.green : color.red)
    table.cell(t, _col, _row, txt, text_color = col, text_size = size.small)

if barstate.islast
    headers = array.from("Earn. Date", "Pre10d %", "Pre5d %", "Day Before %", "Earn. Day %", "Day After %", "Max Move %", "Post5d %", "Post20d %", "Post40d %")
    for c = 0 to array.size(headers) - 1
        table.cell(t, c, 0, array.get(headers, c), bgcolor = color.gray, text_color = color.white, text_size = size.small)

    n = array.size(dates)
    for i = 0 to n - 1
        row = n - i   // most recent on top
        table.cell(t, 0, row, array.get(dates, i), text_size = size.small)
        f_cell(1, row, array.get(pre10Pct, i))
        f_cell(2, row, array.get(pre5Pct, i))
        f_cell(3, row, array.get(beforePct, i))
        f_cell(4, row, array.get(onDayPct, i))
        f_cell(5, row, array.get(afterPct, i))
        f_cell(6, row, array.get(maxPct, i))
        f_cell(7, row, array.get(post5Pct, i))
        f_cell(8, row, array.get(post20Pct, i))
        f_cell(9, row, array.get(post40Pct, i))