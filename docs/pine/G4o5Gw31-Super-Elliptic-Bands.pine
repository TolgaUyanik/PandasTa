//@version=6
indicator("Super-Elliptic Bands", overlay=true, max_labels_count=100)

// ╔═════════════════════════ INPUTS ══════════════════════════════════╗
maLen      = input.int(50, "Central MA Length", minval=1)
periodBase = input.int(64, "Cycle Period", minval=3) // ≥3 avoids div-by-0
mult       = input.float(2.0, "Volatility Mult", minval=0.1, step=0.1)
shapeP     = input.float(2.0, "Shape Power (p)", minval=1.0, maxval=4.0, tooltip="p = 2: Ellipse\np < 2: Pointier shape\np > 2: Flatter shape")
volSrc     = input.string("StDev", "Volatility Source", options=["StDev", "ATR", "TrueRange"])
volLen     = input.int(30, "Volatility Length", minval=1)
showDots   = input.bool(true, "Show Buy/Sell Dots")
useCloseBar = input.bool(true, "Confirm on closed bar?")


// ╔═════════════════════════ CORE SERIES ═════════════════════════════╗
ma = ta.sma(close, maLen)

// --- Selectable volatility ---
volRaw = volSrc == "ATR" ? ta.atr(volLen) :
         volSrc == "TrueRange" ? ta.tr(true) :
         ta.stdev(close, volLen)
b = volRaw * mult // Semi-minor axis (price radius)

// --- Super-ellipse engine ---
cycle = math.max(periodBase, 3)
xRaw = (bar_index % cycle) / cycle // 0 .. <1
xNorm = 2.0 * xRaw - 1.0 // -1 .. +1 (semi-major axis length = 1)

// Generalised solution |y/b| = (1 - |x/a|^p)^(1/p), where a = 1
term = 1.0 - math.pow(math.abs(xNorm), shapeP)
offset = shapeP != 0 ? b * math.pow(math.max(term, 0), 1.0 / shapeP) : 0.0

// Bands
upper = ma + offset
lower = ma - offset

// ╔═════════════════════════ SIGNAL LOGIC ════════════════════════════╗
isBarClosed = useCloseBar ? barstate.isconfirmed : true

// Adjusted logic: Buy when price crosses above lower band, sell when below upper band
buyCond = ta.crossover(close, lower) and isBarClosed
sellCond = ta.crossunder(close, upper) and isBarClosed

// ╔═════════════════════════ PLOTTING ════════════════════════════════╗
plot(ma, "Central MA", color=#e5ecf1, linewidth=1)
uPlot = plot(upper, "Upper Band", color=color.new(#2ecc71, 0))
lPlot = plot(lower, "Lower Band", color=color.new(#e74c3c, 0))
fill(uPlot, lPlot, color.new(color.gray, 90), title="Band Fill")

plotshape(showDots and buyCond, "Buy", shape.triangleup, location.belowbar,
          size=size.tiny, color=#2ecc71)
plotshape(showDots and sellCond, "Sell", shape.triangledown, location.abovebar,
          size=size.tiny, color=#e74c3c)

// ╔═════════════════════════ ALERTS ══════════════════════════════════╗
alertcondition(buyCond, title="Super-Ellipse BUY", message="Buy signal")
alertcondition(sellCond, title="Super-Ellipse SELL", message="Sell signal")