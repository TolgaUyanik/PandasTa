// ============================================================
// Adaptive Cipher — AWC v1
// WaveTrend + Rejim Tespiti + Devam Sinyali
//
// VMC Cipher B üzerine inşa edilmiştir.
// Temel yenilik: Trend/Range/Düşüş rejimlerini tespit ederek
// yanlış sinyalleri filtreler ve trend içi devam sinyali üretir.
// ============================================================
//@version=6
indicator(title = "Adaptive Cipher", shorttitle = "AWC", overlay = false)

// ── GRUPLAR ──────────────────────────────────────────────────
g_wt   = "🌊 WaveTrend"
g_reg  = "🔄 Rejim Tespiti"
g_sig  = "🎯 Sinyal Ayarları"
g_rsi  = "📊 RSI"
g_mfi  = "💧 MFI"
g_stch = "📈 Stochastic RSI"
g_tdi  = "🔀 TDI"
g_sqz  = "🗜️ Squeeze"
g_col  = "🎨 Renkler"

// ── WAVETREND AYARLARI ────────────────────────────────────────
wtChannelLen = input.int  (10,    "WT Kanal Uzunluğu",      group = g_wt)
wtAverageLen = input.int  (21,    "WT Ortalama Uzunluğu",   group = g_wt)
wtMASource   = input.source(hlc3, "WT Kaynak",              group = g_wt)
wtMALen      = input.int  (3,     "WT MA Uzunluğu",         group = g_wt)
obLevel      = input.int  (60,    "OB Seviye 1",            group = g_wt)
obLevel2     = input.int  (53,    "OB Seviye 2",            group = g_wt)
osLevel      = input.int  (-60,   "OS Seviye 1",            group = g_wt)
osLevel2     = input.int  (-53,   "OS Seviye 2",            group = g_wt)
osLevel3     = input.int  (-75,   "OS Seviye 3 (Gold Buy)", group = g_wt, tooltip = "Sadece Gold Buy koşulunda kullanılır.")
showWT       = input.bool (true,  "WaveTrend Göster",       group = g_wt)
showVWAP     = input.bool (true,  "VWAP Göster",            group = g_wt)

// ── REJİM TESPİTİ ─────────────────────────────────────────────
regLen    = input.int   (20,  "Rejim Lookback (bar)",      group = g_reg, tooltip = "wt2'nin bu kadar barlık ortalaması rejimi belirler.")
regBull   = input.int   (15,  "Trend Eşiği (üst)",         group = g_reg, tooltip = "wt2 ortalaması bu değerin üstündeyse: Trend modu.")
regBear   = input.int   (-15, "Düşüş Eşiği (alt)",         group = g_reg, tooltip = "wt2 ortalaması bu değerin altındaysa: Düşüş modu.")
showRegBG = input.bool  (true, "Rejim Arka Planı",         group = g_reg, tooltip = "Yeşil = trend, kırmızı = düşüş, nötr = range.")

// ── SİNYAL AYARLARI ──────────────────────────────────────────
showDiv      = input.bool (true,  "Divergence Sinyali",        group = g_sig)
showHidDiv   = input.bool (false, "Hidden Divergence",          group = g_sig)
hidDivNoLim  = input.bool (true,  "Hidden Div: OB/OS Limitsiz", group = g_sig)
useLimits    = input.bool (true,  "Div OB/OS Limit Zorunlu",    group = g_sig, tooltip = "Kapatırsan daha fazla divergence sinyali üretir.")
divOBLevel   = input.int  (45,    "Bearish Div min (wt2)",      group = g_sig)
divOSLevel   = input.int  (-65,   "Bullish Div min (wt2)",      group = g_sig)
div2Show     = input.bool (true,  "2. Divergence Seti",         group = g_sig)
divOBLevel2  = input.int  (15,    "2. Bearish Div min",         group = g_sig)
divOSLevel2  = input.int  (-40,   "2. Bullish Div min",         group = g_sig)
momDiv       = input.bool (true,  "Momentum Dönüş Sinyali",     group = g_sig, tooltip = "Fractal beklenmeden: wt2 yerel dip/tepe yaptıktan 1 bar sonra.")
momOSLevel   = input.int  (-35,   "Mom Bull Eşiği (wt2 alt)",   group = g_sig, minval = -100, maxval = 0, tooltip = "-20 = geniş, -60 = sıkı.")
momOBLevel   = input.int  (35,    "Mom Bear Eşiği (wt2 üst)",   group = g_sig, minval = 0,   maxval = 100)
contOn       = input.bool (true,  "Trend Devam Sinyali",        group = g_sig, tooltip = "Trend modunda küçük pullback + toparlanmada AL sinyali üretir.")
contMinWT    = input.int  (10,    "Min wt2 (Devam Sinyali)",    group = g_sig, tooltip = "Bu değerin üstündeki wt2 pullback'lerinde devam sinyali arar.")
showBuyDot   = input.bool (true,  "WT Alım Nokta",              group = g_sig)
showSellDot  = input.bool (true,  "WT Satım Nokta",             group = g_sig)
showGold     = input.bool (true,  "Gold Buy",                   group = g_sig)

// ── RSI ──────────────────────────────────────────────────────
useRsiFilter = input.bool (true,  "RSI Filtresi (Div için)",    group = g_rsi)
rsiBuyFilt   = input.int  (40,    "RSI Alım Filtresi (<?)",     group = g_rsi)
rsiSellFilt  = input.int  (60,    "RSI Satım Filtresi (>?)",    group = g_rsi)
rsiWindow    = input.int  (3,     "RSI Pencere (bar)",          group = g_rsi, tooltip = "Son N barda eşiği geçti mi?")
showRSI      = input.bool (true,  "RSI Göster",                 group = g_rsi)
rsiLen       = input.int  (14,    "RSI Uzunluğu",               group = g_rsi)
rsiOS        = input.int  (30,    "RSI Oversold",               group = g_rsi)
rsiOB        = input.int  (60,    "RSI Overbought",             group = g_rsi)

// ── MFI ──────────────────────────────────────────────────────
showMFI      = input.bool  (true,  "MFI Göster",     group = g_mfi)
mfiPeriod    = input.int   (60,    "MFI Periyot",    group = g_mfi)
mfiMult      = input.float (150.0, "MFI Çarpan",     group = g_mfi)
mfiPosY      = input.float (2.5,   "MFI Y Konumu",   group = g_mfi)

// ── STOCHASTIC RSI ───────────────────────────────────────────
showStoch    = input.bool  (true,  "Stoch RSI Göster",   group = g_stch)
stochUseLog  = input.bool  (true,  "Log Kullan?",         group = g_stch)
stochAvg     = input.bool  (false, "K ve D Ortalaması",   group = g_stch)
stochLen     = input.int   (14,    "Stoch RSI Uzunluğu",  group = g_stch)
stochRsiLen  = input.int   (14,    "RSI Uzunluğu",        group = g_stch)
stochKSmooth = input.int   (3,     "K Smooth",            group = g_stch)
stochDSmooth = input.int   (3,     "D Smooth",            group = g_stch)

// ── TDI ──────────────────────────────────────────────────────
showTDI      = input.bool  (true,  "TDI Göster",              group = g_tdi)
tdiLineW     = input.int   (2,     "TDI Çizgi Kalınlığı",     group = g_tdi, minval = 1, maxval = 4)
tdiZoneOn    = input.bool  (true,  "Bölge Filtresi",          group = g_tdi, tooltip = "Yeşil: tdiR < -eşik. Kırmızı: tdiR > +eşik.")
tdiZoneLvl   = input.int   (5,     "Bölge Eşiği (±)",         group = g_tdi)
tdiGapOn     = input.bool  (true,  "Min Mesafe Filtresi",     group = g_tdi)
tdiGapMin    = input.float (2.0,   "Min Mesafe",              group = g_tdi)

// ── SQUEEZE ──────────────────────────────────────────────────
showSqz      = input.bool  (true,  "Squeeze Göster",  group = g_sqz)
sqzOnCol     = input.color (color.black, "Sıkışma Rengi",  group = g_sqz)
sqzOffCol    = input.color (color.gray,  "Normal Rengi",   group = g_sqz)

// ── RENKLER ──────────────────────────────────────────────────
cBuy         = input.color (color.new(#00e676, 0),  "Alım",             group = g_col)
cSell        = input.color (color.new(#ff1744, 0),  "Satım",            group = g_col)
cGold        = input.color (color.new(#ffd600, 0),  "Gold Buy",         group = g_col)
cCont        = input.color (color.new(#00bcd4, 0),  "Devam Sinyali",    group = g_col)
cWarn        = input.color (color.new(#ff9800, 0),  "Uyarı (counter)",  group = g_col)
cBearDiv     = input.color (color.new(#e60000, 0),  "Bear Div",         group = g_col)
cBullDiv     = input.color (color.new(#00e676, 0),  "Bull Div",         group = g_col)
cWT1         = input.color (color.new(#4994ec, 0),  "WT1 Fill",         group = g_col)
cWT2         = input.color (color.new(#1f1559, 0),  "WT2 Fill",         group = g_col)
cVWAP        = input.color (color.new(#ffffff, 50), "VWAP",             group = g_col)
cRSIOB       = input.color (color.new(#e13e3e, 0),  "RSI OB",           group = g_col)
cRSIOS       = input.color (color.new(#3ee145, 0),  "RSI OS",           group = g_col)
cRSIMid      = input.color (color.new(#c33ee1, 0),  "RSI Nötr",         group = g_col)
cMFIpos      = input.color (color.new(#3ee145, 0),  "MFI > 0",          group = g_col)
cMFIneg      = input.color (color.new(#ff3d2e, 0),  "MFI < 0",          group = g_col)
cStochK      = input.color (color.new(#21baf3, 70), "Stoch K",          group = g_col)
cStochD      = input.color (color.new(#673ab7, 90), "Stoch D",          group = g_col)
cTDIG        = input.color (color.new(#00e676, 0),  "TDI G",            group = g_col)
cTDIR        = input.color (color.new(#ff1744, 0),  "TDI R",            group = g_col)

// ── FONKSIYONLAR ─────────────────────────────────────────────

// Fractal tespiti
f_topFrac(src) => src[2] > src[4] and src[2] > src[3] and src[2] > src[1] and src[2] > src[0]
f_botFrac(src) => src[2] < src[4] and src[2] < src[3] and src[2] < src[1] and src[2] < src[0]

// Divergence bulucu
f_findDivs(src, high_, low_, topLim, botLim, useLim) =>
    isTop = f_topFrac(src) and (useLim ? src[2] >= topLim : true)
    isBot = f_botFrac(src) and (useLim ? src[2] <= botLim : true)
    hPrev   = ta.valuewhen(isTop, src[2],   1)
    hPrice  = ta.valuewhen(isTop, high_[2], 1)
    lPrev   = ta.valuewhen(isBot, src[2],   1)
    lPrice  = ta.valuewhen(isBot, low_[2],  1)
    bearDiv = isTop and high_[2] > hPrice and src[2] < hPrev
    bullDiv = isBot and low_[2]  < lPrice and src[2] > lPrev
    bearHid = isTop and high_[2] < hPrice and src[2] > hPrev
    bullHid = isBot and low_[2]  > lPrice and src[2] < lPrev
    [isTop, isBot, bearDiv, bullDiv, bearHid, bullHid]

// MFI
f_mfi(_period, _mult) =>
    rng = high - low
    ta.sma(rng > 1e-10 ? ((close - open) / rng) * _mult : 0.0, _period) - mfiPosY

// WaveTrend — güvenli bölme (wt2=339 anormalliğini önler)
f_wavetrend(src, chlen, avg, malen) =>
    esa      = ta.ema(src, chlen)
    de       = ta.ema(math.abs(src - esa), chlen)
    de_safe  = math.max(de, 1e-10)
    ci       = math.max(math.min((src - esa) / (0.015 * de_safe), 250.0), -250.0)
    wt1_     = ta.ema(ci, avg)
    wt2_     = ta.sma(wt1_, malen)
    vwap_    = wt1_ - wt2_
    cross_   = ta.cross(wt1_, wt2_)
    crossUp_ = wt2_ - wt1_ <= 0
    crossDn_ = wt2_ - wt1_ >= 0
    [wt1_, wt2_, vwap_, cross_, crossUp_, crossDn_]

// Stochastic RSI
f_stochrsi(src_, sl, rl, sk, sd, useLog, useAvg) =>
    s2  = useLog ? math.log(src_) : src_
    r   = ta.rsi(s2, rl)
    lo  = ta.lowest(r, sl)
    hi  = ta.highest(r, sl)
    k_  = ta.sma(hi != lo ? 100 * (r - lo) / (hi - lo) : 0.0, sk)
    d_  = ta.sma(k_, sd)
    k2  = useAvg ? math.avg(k_, d_) : k_
    [k2, d_]

// ── HESAPLAMALAR ─────────────────────────────────────────────

[wt1, wt2, wtVwap, wtCross, wtCrossUp, wtCrossDown] = f_wavetrend(wtMASource, wtChannelLen, wtAverageLen, wtMALen)

rsiVal  = ta.rsi(close, rsiLen)
rsiCol  = rsiVal <= rsiOS ? cRSIOS : rsiVal >= rsiOB ? cRSIOB : cRSIMid
mfiVal  = f_mfi(mfiPeriod, mfiMult)
mfiCol  = mfiVal > 0 ? cMFIpos : cMFIneg

[stochK, stochD] = f_stochrsi(close, stochLen, stochRsiLen, stochKSmooth, stochDSmooth, stochUseLog, stochAvg)

tdiBase = ta.rsi(close, 14)
tdiG    = ta.sma(tdiBase, 2) - 50
tdiR    = ta.sma(tdiBase, 7) - 50

// Squeeze
[_kc_mid, kUp, kLow] = ta.kc(close, 20, 1.5)
bbMid   = ta.sma(close, 20)
bbStd   = ta.stdev(close, 20)
sqzOn   = (bbMid - 2 * bbStd > kLow) and (bbMid + 2 * bbStd < kUp)

// ── REJİM TESPİTİ ────────────────────────────────────────────
wt2Avg      = ta.sma(wt2, regLen)
isBullTrend = wt2Avg >= regBull
isBearTrend = wt2Avg <= regBear
isRange     = not isBullTrend and not isBearTrend

// ── DİVERGENCE ───────────────────────────────────────────────
[isTop1, isBot1, bearDiv1, bullDiv1, bearHid1, bullHid1] = f_findDivs(wt2, high, low, divOBLevel, divOSLevel, useLimits)
[isTop2, isBot2, bearDiv2, bullDiv2, bearHid2, bullHid2] = f_findDivs(wt2, high, low, divOBLevel2, divOSLevel2, useLimits)

bearHidF = hidDivNoLim ? bearHid1 : bearHid1 and wt2 >= divOBLevel
bullHidF = hidDivNoLim ? bullHid1 : bullHid1 and wt2 <= divOSLevel

bearDivPlot1 = (showDiv and bearDiv1) or (showHidDiv and bearHidF) ? cBearDiv : na
bullDivPlot1 = (showDiv and bullDiv1) or (showHidDiv and bullHidF) ? cBullDiv : na
bearDivPlot2 = showDiv and div2Show and bearDiv2 ? cBearDiv : na
bullDivPlot2 = showDiv and div2Show and bullDiv2 ? cBullDiv : na

// ── MOMENTUM DÖNÜŞ SİNYALİ ───────────────────────────────────
wt2MomBull = wt2 > wt2[1] and wt2[1] <= wt2[2] and wt2[1] <= momOSLevel
wt2MomBear = wt2 < wt2[1] and wt2[1] >= wt2[2] and wt2[1] >= momOBLevel

// RSI filtresi — global değişkene atanmalı (ta.lowest/highest koşullu ifade içinde olamaz)
rsiLowest  = ta.lowest(rsiVal, rsiWindow)
rsiHighest = ta.highest(rsiVal, rsiWindow)
rsiBuyOk   = not useRsiFilter or rsiLowest  < rsiBuyFilt
rsiSellOk  = not useRsiFilter or rsiHighest > rsiSellFilt

// ── TEMEL SİNYALLER (rejim filtreli) ─────────────────────────
wtOversold   = wt2 <= osLevel
wtOverbought = wt2 >= obLevel

// Güçlü alım: OS divergence veya momentum dönüş
// Trend modunda: normal sinyal + devam sinyali
// Düşüş modunda: uyarılı (counter-trend)
buySignalRaw  = showDiv and (bullDiv1 or (div2Show and bullDiv2) or (momDiv and wt2MomBull)) and rsiBuyOk
sellSignalRaw = showDiv and (bearDiv1 or (div2Show and bearDiv2) or (momDiv and wt2MomBear)) and rsiSellOk

// Trend modunda satım sinyali filtresi: wt2 doğal OB'de ise bastır
// Sadece gerçek divergence varsa tetikle
sellFiltered  = sellSignalRaw and (not isBullTrend or bearDiv1 or bearDiv2)

// Düşüş modunda alım sinyali: counter-trend → farklı renk
buyIsCounter  = buySignalRaw and isBearTrend
buySignalMain = buySignalRaw and not isBearTrend

// WT cross sinyalleri
wtBuyDot  = wtCross and wtCrossUp   and wtOversold
wtSellDot = wtCross and wtCrossDown and wtOverbought

// ── DEVAM SİNYALİ (Trend modunda pullback + toparlanma) ───────
// Koşullar:
// 1. Bull trend modundayız
// 2. wt2 yeterince yüksekte (contMinWT'nin üstünde)
// 3. 2+ bar düştü (gerçek pullback)
// 4. Şimdi yukarı dönüyor
wt2WasElevated  = wt2[1] > contMinWT
wt2PulledBack   = wt2[1] < wt2[2] and wt2[2] < wt2[3]
wt2TurningUp    = wt2 > wt2[1]
contBuySignal   = contOn and isBullTrend and wt2WasElevated and wt2PulledBack and wt2TurningUp and not wtOverbought

// ── TDI CROSSOVER (filtreli) ──────────────────────────────────
tdiRawUp   = tdiG > tdiR and tdiG[1] <= tdiR[1]
tdiRawDown = tdiG < tdiR and tdiG[1] >= tdiR[1]
tdiZoneUp  = not tdiZoneOn or tdiR[1] < -tdiZoneLvl
tdiZoneDn  = not tdiZoneOn or tdiR[1] >  tdiZoneLvl
tdiGapUp   = not tdiGapOn  or (tdiR[1] - tdiG[1]) >= tdiGapMin
tdiGapDn   = not tdiGapOn  or (tdiG[1] - tdiR[1]) >= tdiGapMin
tdiCrossUp = tdiRawUp   and tdiZoneUp and tdiGapUp
tdiCrossDn = tdiRawDown and tdiZoneDn and tdiGapDn

// ── GOLD BUY ─────────────────────────────────────────────────
lastRsiAtBot = ta.valuewhen(isBot1, rsiVal[2], 0)[2]
goldBuy = showGold and bullDiv1 and wt2[1] <= osLevel3 and wt2 > osLevel3 and (wt2[1] - wt2) <= -5 and lastRsiAtBot < 30

// ── DRAW ─────────────────────────────────────────────────────
// Pine plot limiti: 64. fill() hedefleri 2x sayılır → toplam azaltılmış versiyon

// 1. Rejim arka planı — tek bgcolor, koşullu renk
regBGColor = isBullTrend ? color.new(#00e676, 96) : isBearTrend ? color.new(#ff1744, 96) : na
bgcolor(showRegBG ? regBGColor : na, title = "Rejim BG")

// 2. Sıfır çizgisi
plot(0, color = color.new(color.white, 50), title = "Zero")

// 3. WaveTrend dalgaları
plot(showWT ? wt1 : na, style = plot.style_area, color = color.new(cWT1, 30), title = "WT1")
plot(showWT ? wt2 : na, style = plot.style_area, color = color.new(cWT2, 25), title = "WT2")

// 4. MFI (sadece area, bar kaldırıldı)
plot(showMFI ? mfiVal : na, style = plot.style_area, color = color.new(mfiCol, 50), title = "MFI")

// 5. wt2 rejim ortalaması
plot(wt2Avg, color = color.new(color.white, 55), linewidth = 1, title = "Rejim Ort")

// 6. Stochastic RSI (fill kaldırıldı, bant rengi birleştirildi)
plot(showStoch ? stochK : na, color = cStochK, linewidth = 2, title = "Stoch K")
plot(showStoch ? stochD : na, color = cStochD, linewidth = 1, title = "Stoch D")

// 7. RSI
plot(showRSI ? rsiVal : na, color = color.new(rsiCol, 25), linewidth = 2, title = "RSI")

// 8. OB/OS seviyeleri (Level 3 kaldırıldı — 100/-75 pratikte kullanışsız)
plot(obLevel,  color = color.new(#fd4545, 55), linewidth = 1, title = "OB 1")
plot(obLevel2, color = color.new(#fd4545, 80), linewidth = 1, style = plot.style_stepline, title = "OB 2")
plot(osLevel,  color = color.new(#3ee145, 55), linewidth = 1, title = "OS 1")
plot(osLevel2, color = color.new(#3ee145, 80), linewidth = 1, style = plot.style_stepline, title = "OS 2")

// 9. Divergence çizgileri
plot(isTop1 ? wt2[2] : na, color = bearDivPlot1, linewidth = 2, offset = -2, title = "Bear Div 1")
plot(isBot1 ? wt2[2] : na, color = bullDivPlot1, linewidth = 2, offset = -2, title = "Bull Div 1")
plot(isTop2 ? wt2[2] : na, color = bearDivPlot2, linewidth = 2, offset = -2, title = "Bear Div 2")
plot(isBot2 ? wt2[2] : na, color = bullDivPlot2, linewidth = 2, offset = -2, title = "Bull Div 2")

// 10. WT cross çemberleri
wtCrossCol = wt2 - wt1 > 0 ? cSell : cBuy
plot(wtCross ? wt2 : na, color = color.new(wtCrossCol, 15), style = plot.style_circles, linewidth = 3, title = "WT Cross")

// 11. VWAP
plot(showVWAP ? wtVwap : na, color = cVWAP, linewidth = 2, title = "VWAP")

// 12. Squeeze nokta
plot(showSqz ? 0 : na, color = sqzOn ? sqzOnCol : sqzOffCol, style = plot.style_circles, linewidth = 2, title = "Squeeze")

// 13. TDI — en üstte
plot(showTDI ? tdiG : na, color = cTDIG, linewidth = tdiLineW, title = "TDI G")
plot(showTDI ? tdiR : na, color = cTDIR, linewidth = tdiLineW, title = "TDI R")

// 14. WT alım/satım nokta
plotchar(showBuyDot  and wtBuyDot  ? -107 : na, char = "·", color = color.new(cBuy,  50), location = location.absolute, size = size.small, title = "WT Alım")
plotchar(showSellDot and wtSellDot ?  107 : na, char = "·", color = color.new(cSell, 50), location = location.absolute, size = size.small, title = "WT Satım")

// 15. Ana sinyaller
plotchar(buySignalMain ? -106 : na, char = "•", color = color.new(cBuy,  15), location = location.absolute, size = size.normal, title = "Güçlü Alım")
plotchar(sellFiltered  ?  106 : na, char = "•", color = color.new(cSell, 15), location = location.absolute, size = size.normal, title = "Güçlü Satım")

// 16. Devam sinyali (cyan ◆)
plotchar(contBuySignal ? -104 : na, char = "◆", color = color.new(cCont, 15), location = location.absolute, size = size.small, title = "Devam Alım")

// 17. Counter-trend (⚠ turuncu — düşüş modunda alım uyarısı)
plotchar(buyIsCounter ? -105 : na, char = "⚠", color = color.new(cWarn, 15), location = location.absolute, size = size.small, title = "Counter Alım")

// 18. TDI cross
plotchar(showTDI and tdiCrossUp ? -108 : na, char = "◆", color = color.new(cTDIG, 20), location = location.absolute, size = size.tiny, title = "TDI ▲")
plotchar(showTDI and tdiCrossDn ?  108 : na, char = "◆", color = color.new(cTDIR, 20), location = location.absolute, size = size.tiny, title = "TDI ▼")

// 19. Gold Buy
plotchar(goldBuy ? -106 : na, char = "•", color = color.new(cGold, 15), location = location.absolute, size = size.huge, title = "Gold Buy")

// ── TABLO ────────────────────────────────────────────────────
var table panel = table.new(position.top_left, 2, 6,
     bgcolor      = color.new(#0d1117, 0),
     border_color = color.new(#30363d, 0),
     border_width = 1,
     frame_color  = color.new(#30363d, 0),
     frame_width  = 1)

// barstate.islast yerine her barda güncelle — daha güvenilir
hdrBg  = color.new(#161b22, 0)
cellBg = color.new(#0d1117, 0)
sub    = color.new(#8b949e, 0)

table.cell(panel, 0, 0, "AWC", text_color = color.white, text_size = size.normal, bgcolor = hdrBg)
table.cell(panel, 1, 0, "v1",  text_color = sub,         text_size = size.normal, bgcolor = hdrBg)

regTxt = isBullTrend ? "TREND" : isBearTrend ? "DUSUS" : "RANGE"
regCol = isBullTrend ? color.new(#00e676, 0) : isBearTrend ? color.new(#ff1744, 0) : color.new(#888888, 0)
table.cell(panel, 0, 1, "REJIM", text_color = sub,    text_size = size.small,  bgcolor = cellBg)
table.cell(panel, 1, 1, regTxt,  text_color = regCol, text_size = size.normal, bgcolor = cellBg)

wtTxt = wt2 >= obLevel ? "OB" : wt2 <= osLevel ? "OS" : "Notr"
wtCol = wt2 >= obLevel ? color.new(#ff4444, 0) : wt2 <= osLevel ? color.new(#44ff44, 0) : color.new(#888888, 0)
table.cell(panel, 0, 2, "WT",  text_color = sub,   text_size = size.small,  bgcolor = cellBg)
table.cell(panel, 1, 2, wtTxt, text_color = wtCol, text_size = size.normal, bgcolor = cellBg)

rsiTxt  = str.tostring(math.round(rsiVal, 1))
rsiTCol = rsiVal >= rsiOB ? cRSIOB : rsiVal <= rsiOS ? cRSIOS : cRSIMid
table.cell(panel, 0, 3, "RSI",  text_color = sub,     text_size = size.small,  bgcolor = cellBg)
table.cell(panel, 1, 3, rsiTxt, text_color = rsiTCol, text_size = size.normal, bgcolor = cellBg)

tdiTxt = tdiG > tdiR ? "Bull" : "Bear"
tdiCol = tdiG > tdiR ? cTDIG : cTDIR
table.cell(panel, 0, 4, "TDI",  text_color = sub,    text_size = size.small,  bgcolor = cellBg)
table.cell(panel, 1, 4, tdiTxt, text_color = tdiCol, text_size = size.normal, bgcolor = cellBg)

sqzTxt = sqzOn ? "SQZ ON" : "Normal"
sqzCol = sqzOn ? color.new(#ff1744, 0) : color.new(#888888, 0)
table.cell(panel, 0, 5, "SQZ",  text_color = sub,    text_size = size.small,  bgcolor = cellBg)
table.cell(panel, 1, 5, sqzTxt, text_color = sqzCol, text_size = size.normal, bgcolor = cellBg)

