alertcondition(buyIsCounter,   "AWC Counter Alim", "Adaptive Cipher: Counter-trend alim (dikkatli)")
alertcondition(goldBuy,        "AWC Gold Buy",     "Adaptive Cipher: Gold Buy")
alertcondition(tdiCrossUp,     "AWC TDI Yukari",   "Adaptive Cipher: TDI yukari kesti")
alertcondition(tdiCrossDn,     "AWC TDI Asagi",    "Adaptive Cipher: TDI asagi kesti")
