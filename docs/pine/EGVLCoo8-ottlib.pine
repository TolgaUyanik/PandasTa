// @version=5
// @description This library contains functions for the calculation of the OTT (Optimized Trend Tracker) 
// and its variants, originally created by [b]Anıl Özekşi[/b] (Anil_Ozeksi). Special thanks to him for
// the concept and to [b]Kıvanç Özbilgiç[/b] (KivancOzbilgic) and [b]dg_factor[/b] (dg_factor) for 
// adapting them to Pine Script.
library("ottlib", overlay = true)

// ╔═════════════════════════════════════════════════════════════════════════════════════════════╗
// ║                                * * * F U N C T I O N S * * *                                ║
// ╚═════════════════════════════════════════════════════════════════════════════════════════════╝

//@function Chande's Variable Index Dynamic Average.
// ___
// **Example**
// ```
// vidyaValue = ottlib.f_vidya(source = close, length = 20)
// 
// plot(vidyaValue, color = color.blue)
// ```
// ___
//@param source (series float) Series of values to process.
//@param length (simple int) Number of bars to lookback.
//@param cmoLength (simple int) Number of bars to lookback for calculating CMO. Default value is `9`.
//@returns (float) Calculated average of `source` for `length` bars back.
export f_vidya(series float source, simple int length, simple int cmoLength = 9) =>
    sma = ta.sma(source, length)
    alpha = 2 / (length + 1)
    cmo = math.abs(ta.cmo(source, cmoLength) / 100)
    vidya = 0.0
    vidya := length == 1 ? source : na(vidya[1]) ? sma : nz(alpha * math.abs(cmo) * source) + (1 - alpha * math.abs(cmo)) * nz(vidya[1])

//@function Calculates trailing stop value.
// ___
// **Example**
// ```
// mostValue = ottlib.f_mostTrail(source = close, multiplier = 2.0)
// 
// plot(mostValue, color = color.orange)
// ```
// ___
// @param source (series int/float) Series of values to process.
// @param multiplier (simple float) Percent of trailing stop.
// @returns (float) Calculated value of trailing stop.
export f_mostTrail(series float source, simple float multiplier) =>
    priceDiff = source * multiplier * 0.01
    longStop = source - priceDiff, longStop := longStop > nz(longStop[1]) or source < nz(longStop[1]) ? longStop : nz(longStop[1])
    shortStop = source + priceDiff, shortStop := shortStop < nz(shortStop[1]) or source > nz(shortStop[1]) ? shortStop : nz(shortStop[1])
    most = 0.0, most := source > nz(most[1]) ? longStop : source < nz(most[1]) ? shortStop : nz(most[1])
    nz(most)

// @function Calculates OTT-specific trailing stop value.
// ___
// **Example**
// ```
// vidyaValue = ottlib.f_vidya(source = close, length = 20)
// ottValue = ottlib.f_ottTrail(source = vidyaValue, multiplier = 1.5)
// 
// plot(ottValue, color = vidyaValue >= ottValue ? color.green : color.red)
// ```
// ___
// @param source (series int/float) Series of values to process.
// @param multiplier (simple float) Percent of trailing stop.
// @returns (float) Calculated value of OTT-specific trailing stop.
export f_ottTrail(series float source, simple float multiplier) =>
    most = f_mostTrail(source, multiplier)
    ott = source > most ? most * (1 + multiplier / 200) : most * (1 - multiplier / 200)
    nz(ott[2])
    
// @function Calculates OTT (Optimized Trend Tracker).
// ___
// **Example**
// ```
// [supportLine, ottLine] = ottlib.ott(source = close, length = 2, multiplier = 1.4)
// 
// longCondition = ta.crossover(supportLine, ottLine)
// shortCondition = ta.crossunder(supportLine, ottLine)
// ```
// ___
// @param source (series float) Series of values to process. Default value is `close`.
// @param length (simple int) Number of bars to lookback. Default value is `2`.
// @param multiplier (simple float) Percent of trailing stop. Default value is `1.4`.
// @returns [(float), (float)] Tuple of `supportLine` and `ottLine`.
export ott(series float source = close, simple int length = 2, simple float multiplier = 1.4) =>
    supportLine = f_vidya(source, length)
    ottLine = f_ottTrail(supportLine, multiplier)
    [supportLine, ottLine]

// @function Calculates TOTT (Twin OTT).
// ___
// **Example**
// ```
// [supportLine, upperLine, lowerLine] = ottlib.tott(source = close, length = 40, multiplier = 0.6, bandsMultiplier = 0.0006)
// 
// longCondition = ta.crossover(supportLine, upperLine)
// shortCondition = ta.crossunder(supportLine, lowerLine)
// ```
// ___
// @param source (series float) Series of values to process. Default value is `close`.
// @param length (simple int) Number of bars to lookback. Default value is `40`.
// @param multiplier (simple float) Percent of trailing stop. Default value is `0.6`.
// @param bandsMultiplier (simple float) Multiplier for bands. Default value is `0.0006`.
// @returns [(float), (float), (float)] Tuple of `supportLine`, `upperLine` and `lowerLine`.
export tott(series float source = close, simple int length = 40, simple float multiplier = 0.6, simple float bandsMultiplier = 0.0006) =>
    supportLine = f_vidya(source, length)
    upperLine = f_ottTrail(supportLine, multiplier) * (1 + bandsMultiplier)
    lowerLine = f_ottTrail(supportLine, multiplier) * (1 - bandsMultiplier)
    [supportLine, upperLine, lowerLine]

// @function Calculates TOTTO (Another version of Twin OTT).
// ___
// **Example**
// ```
// [supportLine, upperLine, lowerLine] = ottlib.totto(source = close, length = 35, multiplier = 0.5, bandsMultiplier = 0.0006)
// 
// longCondition = ta.crossover(supportLine, upperLine)
// shortCondition = ta.crossunder(supportLine, lowerLine)
// ```
// ___
// @param source (series float) Series of values to process. Default value is `close`.
// @param length (simple int) Number of bars to lookback. Default value is `35`.
// @param multiplier (simple float) Percent of trailing stop. Default value is `0.5`.
// @param bandsMultiplier (simple float) Multiplier for bands. Default value is `0.0006`.
// @returns [(float), (float), (float)] Tuple of `supportLine`, `upperLine` and `lowerLine`.
export totto(series float source = close, simple int length = 35, simple float multiplier = 0.5, simple float bandsMultiplier = 0.0006)=>
    supportLine = f_vidya(source, int(length / 2))
    upperLine = f_ottTrail(f_vidya(supportLine, 2), multiplier) * (1 + bandsMultiplier)
    lowerLine = f_ottTrail(f_vidya(supportLine, 2), multiplier) * (1 - bandsMultiplier)
    [supportLine, upperLine, lowerLine]

// @function Calculates OTT Channels.
// ___
// **Example**
// ```
// [ul4, ul3, ul2, ul1, midLine, ll1, ll2, ll3, ll4] = ottlib.ott_channel(source = close, length = 2, multiplier = 1.4, ulMultiplier = 0.01, llMultiplier = 0.01)
// ```
// ___
// @param source (series float) Series of values to process. Default value is `close` 
// @param length (simple int) Number of bars to lookback. Default value is `2` 
// @param multiplier (simple float) Percent of trailing stop. Default value is `1.4`
// @param ulMultiplier (simple float) Multiplier for upper line. Default value is `0.01`
// @param llMultiplier (simple float) Multiplier for lower line. Default value is `0.01`
// @returns [(float), (float), (float), (float), (float), (float), (float), (float), (float)] Tuple of `ul4`, `ul3`, `ul2`, `ul1`, `midLine`, `ll1`, `ll2`, `ll3`, `ll4`.
export ott_channel(series float source = close, simple int length = 2, simple float multiplier = 1.4, simple float ulMultiplier = 0.01, simple float llMultiplier = 0.01) =>
    midLine = f_ottTrail(f_vidya(source, length), multiplier)
    ul4 = midLine * (1 + ulMultiplier)
    ul3 = midLine * (1 + ulMultiplier * 0.618)
    ul2 = midLine * (1 + ulMultiplier * 0.500)
    ul1 = midLine * (1 + ulMultiplier * 0.382)
    ll1 = midLine * (1 - llMultiplier * 0.382)
    ll2 = midLine * (1 - llMultiplier * 0.500)
    ll3 = midLine * (1 - llMultiplier * 0.618)
    ll4 = midLine * (1 - llMultiplier)
    [ul4, ul3, ul2, ul1, midLine, ll1, ll2, ll3, ll4]

// @function Calculates RISOTTO (RSI OTT).
// ___
// **Example**
// ```
// [supportLine, risottoLine] = ottlib.risotto(source = close, length = 50, rsiLength = 100, multiplier = 0.2)
// 
// longCondition = ta.crossover(supportLine, risottoLine)
// shortCondition = ta.crossunder(supportLine, risottoLine)
// ```
// ___
// @param source (series float) Series of values to process. Default value is `close`.
// @param length (simple int) Number of bars to lookback. Default value is `50`.
// @param rsiLength (simple int) Number of bars used for RSI calculation. Default value is `100`.
// @param multiplier (simple float) Percent of trailing stop. Default value is `0.2`.
// @returns [(float), (float)] Tuple of `supportLine` and `risottoLine`.
export risotto(series float source = close, simple int length = 50, simple int rsiLength = 100, simple float multiplier = 0.2) =>
    supportLine = f_vidya(ta.rsi(source, rsiLength), length) + 1000
    risottoLine = f_ottTrail(f_vidya(supportLine, 2), multiplier)
    [supportLine, risottoLine]

// @function Calculates SOTT (Stochastic OTT).
// ___
// **Example**
// ```
// [supportLine, sottLine] = ottlib.sott(source = close, kLength = 500, dLength = 200, multiplier = 0.5)
// 
// longCondition = ta.crossover(supportLine, sottLine)
// shortCondition = ta.crossunder(supportLine, sottLine)
// ```
// ___
// @param source (series float) Series of values to process. Default value is `close`.
// @param kLength (simple int) Stochastic %K length. Default value is `500`.
// @param dLength (simple int) Stochastic %D length. Default value is `200`.
// @param multiplier (simple float) Percent of trailing stop. Default value is `0.5`.
// @returns [(float), (float)] Tuple of `supportLine` and `sottLine`.
export sott(series float source = close, simple int kLength = 500, simple int dLength = 200, simple float multiplier = 0.5) =>
    supportLine = f_vidya(ta.stoch(source, high, low, kLength), dLength) + 1000
    sottLine = f_ottTrail(f_vidya(supportLine, 2), multiplier)
    [supportLine, sottLine]

// @function Calculates HOTT & LOTT (Highest & Lowest OTT).
// ___
// **Example**
// ```
// [hottLine, lottLine] = ottlib.hottlott(length = 20, multiplier = 0.6)
// 
// longCondition = ta.crossover(high, hottLine)
// shortCondition = ta.crossunder(low, lottLine)
// ```
// ___
// @param length (simple int) Number of bars to lookback. Default value is `20`.
// @param multiplier (simple float) Percent of trailing stop. Default value is `0.6`.
// @returns [(float), (float)] Tuple of `hottLine` and `lottLine`.
export hottlott(simple int length = 20, simple float multiplier = 0.6) =>
    hottLine = f_ottTrail(f_vidya(ta.highest(length), 2), multiplier)
    lottLine = f_ottTrail(f_vidya(ta.lowest(length), 2), multiplier)
    [hottLine, lottLine]

// @function Calculates ROTT (Relative OTT).
// ___
// **Example**
// ```
// [supportLine, rottLine] = ottlib.rott(source = close, length = 1000, multiplier = 1.0)
// 
// isUpTrend = supportLine > rottLine
// isDownTrend = supportLine < rottLine
// ```
// ___
// @param source (series float) Series of values to process. Default value is `close`.
// @param length (simple int) Number of bars to lookback. Default value is `1000`.
// @param multiplier (simple float) Percent of trailing stop. Default value is `1.0`.
// @returns [(float), (float)] Tuple of `supportLine` and `rottLine`.
export rott(series float source = close, simple int length = 1000, simple float multiplier = 1.0) =>
    supportLine = f_vidya(source, length)
    rottLine = f_ottTrail(f_vidya(supportLine, 2), multiplier)
    [supportLine, rottLine]

// @function Calculates Fırsatçı Trend (Opportunist Trend).
// ___
// **Example**
// ```
// [supportLine, ftLine] = ottlib.ft(source = close, length = 30, majorMultiplier = 3.6, minorMultiplier = 1.8)
// 
// longCondition = ta.crossover(supportLine, ftLine)
// shortCondition = ta.crossunder(supportLine, ftLine)
// ```
// ___
// @param source (series float) Series of values to process. Default value is `close`.
// @param length (simple int) Number of bars to lookback. Default value is `30`.
// @param majorMultiplier (simple float) Percent of major trend. Default value is `3.6`.
// @param minorMultiplier (simple float) Percent of minor trend. Default value is `1.8`.
// @returns [(float), (float)] Tuple of `supportLine` and `ftLine`.
export ft(series float source = close, simple int length = 30, simple float majorMultiplier = 3.6, simple float minorMultiplier = 1.8) =>
    supportLine = f_vidya(source, length)
    majorTrend = f_ottTrail(supportLine, majorMultiplier)
    minorTrend = f_ottTrail(supportLine, minorMultiplier)
    ftLine = (minorTrend + (2 * minorTrend - majorTrend)[100]) / 2
    [supportLine, ftLine]

// ╔═════════════════════════════════════════════════════════════════════════════════════════════╗
// ║                             * * * C A L C U L A T I O N S * * *                             ║
// ╚═════════════════════════════════════════════════════════════════════════════════════════════╝

[supportLine, ottLine] = ott(source = close, length = 2, multiplier = 1.4)

longCondition = ta.crossover(supportLine, ottLine)
shortCondition = ta.crossunder(supportLine, ottLine)

// ╔═════════════════════════════════════════════════════════════════════════════════════════════╗
// ║                                  * * * E X A M P L E * * *                                  ║
// ╚═════════════════════════════════════════════════════════════════════════════════════════════╝

sLine = plot(supportLine, color = color.blue)
oLine = plot(ottLine, color = color.red)
fill(sLine, oLine, color = supportLine >= ottLine ? color.new(color.green, 80) : color.new(color.red, 80))
plotshape(longCondition, title = "Long", style = shape.labelup, location = location.bottom, color = color.green, text = "BUY", textcolor = color.white)
plotshape(shortCondition, title = "Short", style = shape.labeldown, location = location.top, color = color.red, text = "SELL", textcolor = color.white)
bgcolor(longCondition ? color.new(color.green, 70) : shortCondition ? color.new(color.red, 70) : na)