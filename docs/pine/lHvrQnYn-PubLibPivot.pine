// @description Pivot detection library for harmonic pattern analysis - Fractal and ZigZag methods with validation and utility functions
library('PubLibPivot')

/////////////////////////////////////////
// PIVOT DETECTION - FRACTAL METHOD //
/////////////////////////////////////////

// @function Fractal pivot high condition
// @param int depth - number of bars on each side to check
// @returns bool
export fractalPivotHigh(int depth) =>
    ta.pivothigh(high, depth, depth)

// @function Fractal pivot low condition  
// @param int depth - number of bars on each side to check
// @returns bool
export fractalPivotLow(int depth) =>
    ta.pivotlow(low, depth, depth)

// @function Get fractal pivot high price
// @param int depth - number of bars on each side to check
// @param int occurrence - which occurrence to get (0 = most recent)
// @returns float
export fractalPivotHighPrice(int depth, int occurrence) =>
    ta.valuewhen(not na(fractalPivotHigh(depth)), high, occurrence)

// @function Get fractal pivot low price
// @param int depth - number of bars on each side to check  
// @param int occurrence - which occurrence to get (0 = most recent)
// @returns float
export fractalPivotLowPrice(int depth, int occurrence) =>
    ta.valuewhen(not na(fractalPivotLow(depth)), low, occurrence)

// @function Get fractal pivot high bar index
// @param int depth - number of bars on each side to check
// @param int occurrence - which occurrence to get (0 = most recent)
// @returns int
export fractalPivotHighBarIndex(int depth, int occurrence) =>
    ta.valuewhen(not na(fractalPivotHigh(depth)), bar_index, occurrence)

// @function Get fractal pivot low bar index
// @param int depth - number of bars on each side to check
// @param int occurrence - which occurrence to get (0 = most recent)  
// @returns int
export fractalPivotLowBarIndex(int depth, int occurrence) =>
    ta.valuewhen(not na(fractalPivotLow(depth)), bar_index, occurrence)

/////////////////////////////////////////
// PIVOT DETECTION - ZIGZAG METHOD //
/////////////////////////////////////////

// @function ZigZag pivot high condition
// @param float deviation - minimum price change in percentage or points
// @param int backstep - minimum bars between pivots
// @param bool useATR - use ATR instead of percentage
// @param int atrLength - ATR calculation length
// @returns bool
export zigzagPivotHigh(float deviation, int backstep, bool useATR, int atrLength) =>
    atrValue = ta.atr(atrLength)
    minMove = useATR ? atrValue * deviation / 100 : close * deviation / 100
    
    // Check if current high is higher than previous highs and next highs
    isHigher = high > high[1] and high > high[2]
    isHigherNext = high > high[1] and high > high[2]
    
    // Check minimum movement from last pivot (simplified - using previous high)
    lastHigh = high[backstep]
    movement = math.abs(high - lastHigh)
    
    // Check if enough bars have passed since last potential pivot
    barsSinceLastHigh = ta.barssince(high > high[1] and high > high[2])
    enoughBarsPassed = barsSinceLastHigh >= backstep
    
    isHigher and isHigherNext and movement >= minMove and enoughBarsPassed

// @function ZigZag pivot low condition
// @param float deviation - minimum price change in percentage or points
// @param int backstep - minimum bars between pivots
// @param bool useATR - use ATR instead of percentage
// @param int atrLength - ATR calculation length
// @returns bool
export zigzagPivotLow(float deviation, int backstep, bool useATR, int atrLength) =>
    atrValue = ta.atr(atrLength)
    minMove = useATR ? atrValue * deviation / 100 : close * deviation / 100
    
    // Check if current low is lower than previous lows and next lows
    isLower = low < low[1] and low < low[2]
    isLowerNext = low < low[1] and low < low[2]
    
    // Check minimum movement from last pivot (simplified - using previous low)
    lastLow = low[backstep]
    movement = math.abs(low - lastLow)
    
    // Check if enough bars have passed since last potential pivot
    barsSinceLastLow = ta.barssince(low < low[1] and low < low[2])
    enoughBarsPassed = barsSinceLastLow >= backstep
    
    isLower and isLowerNext and movement >= minMove and enoughBarsPassed

// @function Get ZigZag pivot high price
// @param float deviation - minimum price change
// @param int backstep - minimum bars between pivots
// @param bool useATR - use ATR instead of percentage
// @param int atrLength - ATR calculation length
// @param int occurrence - which occurrence to get (0 = most recent)
// @returns float
export zigzagPivotHighPrice(float deviation, int backstep, bool useATR, int atrLength, int occurrence) =>
    ta.valuewhen(zigzagPivotHigh(deviation, backstep, useATR, atrLength), high, occurrence)

// @function Get ZigZag pivot low price
// @param float deviation - minimum price change
// @param int backstep - minimum bars between pivots
// @param bool useATR - use ATR instead of percentage
// @param int atrLength - ATR calculation length
// @param int occurrence - which occurrence to get (0 = most recent)
// @returns float
export zigzagPivotLowPrice(float deviation, int backstep, bool useATR, int atrLength, int occurrence) =>
    ta.valuewhen(zigzagPivotLow(deviation, backstep, useATR, atrLength), low, occurrence)

// @function Get ZigZag pivot high bar index
// @param float deviation - minimum price change
// @param int backstep - minimum bars between pivots
// @param bool useATR - use ATR instead of percentage
// @param int atrLength - ATR calculation length
// @param int occurrence - which occurrence to get (0 = most recent)
// @returns int
export zigzagPivotHighBarIndex(float deviation, int backstep, bool useATR, int atrLength, int occurrence) =>
    ta.valuewhen(zigzagPivotHigh(deviation, backstep, useATR, atrLength), bar_index, occurrence)

// @function Get ZigZag pivot low bar index
// @param float deviation - minimum price change
// @param int backstep - minimum bars between pivots
// @param bool useATR - use ATR instead of percentage
// @param int atrLength - ATR calculation length
// @param int occurrence - which occurrence to get (0 = most recent)
// @returns int
export zigzagPivotLowBarIndex(float deviation, int backstep, bool useATR, int atrLength, int occurrence) =>
    ta.valuewhen(zigzagPivotLow(deviation, backstep, useATR, atrLength), bar_index, occurrence)

/////////////////////////////////////////
// PIVOT VALIDATION AND FILTERING //
/////////////////////////////////////////

// @function Validate pivot quality based on volume
// @param float pivotPrice - price of the pivot
// @param int pivotBarIndex - bar index of the pivot
// @param float minVolumeRatio - minimum volume ratio vs average
// @param int volumeLength - length for volume average calculation
// @returns bool
export isValidPivotVolume(float pivotPrice, int pivotBarIndex, float minVolumeRatio, int volumeLength) =>
    avgVolume = ta.sma(volume, volumeLength)
    pivotVolume = volume[bar_index - pivotBarIndex]
    
    // Additional validation: check if pivot price is reasonable (not na and within normal range)
    priceValid = not na(pivotPrice) and pivotPrice > 0
    
    // Volume validation with price consideration
    volumeValid = pivotVolume >= avgVolume * minVolumeRatio
    
    priceValid and volumeValid

// @function Validate pivot based on minimum ATR movement
// @param float pivotPrice - price of the pivot
// @param float lastPivotPrice - price of previous pivot
// @param float minATRMultiplier - minimum ATR multiplier
// @param int atrLength - ATR calculation length
// @returns bool
export isValidPivotATR(float pivotPrice, float lastPivotPrice, float minATRMultiplier, int atrLength) =>
    atrValue = ta.atr(atrLength)
    minMove = atrValue * minATRMultiplier
    movement = math.abs(pivotPrice - lastPivotPrice)
    movement >= minMove

// @function Validate pivot based on minimum time between pivots
// @param int pivotBarIndex - current pivot bar index
// @param int lastPivotBarIndex - previous pivot bar index
// @param int minBars - minimum bars between pivots
// @returns bool
export isValidPivotTime(int pivotBarIndex, int lastPivotBarIndex, int minBars) =>
    barsBetween = pivotBarIndex - lastPivotBarIndex
    barsBetween >= minBars

// @function Check if pivot is not repainting (confirmed)
// @param int pivotBarIndex - bar index of the pivot
// @param int depth - fractal depth used for detection
// @returns bool
export isPivotConfirmed(int pivotBarIndex, int depth) =>
    barsSincePivot = bar_index - pivotBarIndex
    barsSincePivot >= depth

/////////////////////////////////////////
// PIVOT ARRAY MANAGEMENT //
/////////////////////////////////////////

// @function Add pivot to array with validation
// @param array<float> pivotArray - array to store pivot prices
// @param array<int> barArray - array to store bar indices
// @param float pivotPrice - price to add
// @param int pivotBarIndex - bar index to add
// @param int maxSize - maximum array size
// @returns array<float> - updated pivot array
export addPivotToArray(array<float> pivotArray, array<int> barArray, float pivotPrice, int pivotBarIndex, int maxSize) =>
    if array.size(pivotArray) >= maxSize
        array.shift(pivotArray)
        array.shift(barArray)
    
    array.push(pivotArray, pivotPrice)
    array.push(barArray, pivotBarIndex)
    pivotArray

// @function Get pivot from array by index
// @param array<float> pivotArray - array containing pivot prices
// @param array<int> barArray - array containing bar indices
// @param int index - index to retrieve (0 = most recent)
// @returns tuple<float, int> - (price, bar_index)
export getPivotFromArray(array<float> pivotArray, array<int> barArray, int index) =>
    if array.size(pivotArray) > index
        price = array.get(pivotArray, array.size(pivotArray) - 1 - index)
        barIdx = array.get(barArray, array.size(barArray) - 1 - index)
        [price, barIdx]
    else
        [na, na]

// @function Get all pivots in range
// @param array<float> pivotArray - array containing pivot prices
// @param array<int> barArray - array containing bar indices
// @param int startIndex - starting index
// @param int count - number of pivots to retrieve
// @returns tuple<array<float>, array<int>> - (prices, bar_indices)
export getPivotsInRange(array<float> pivotArray, array<int> barArray, int startIndex, int count) =>
    var array<float> resultPrices = array.new<float>()
    var array<int> resultBars = array.new<int>()
    
    array.clear(resultPrices)
    array.clear(resultBars)
    
    arraySize = array.size(pivotArray)
    endIndex = math.min(startIndex + count, arraySize)
    
    for i = startIndex to endIndex - 1
        if i < arraySize
            price = array.get(pivotArray, arraySize - 1 - i)
            barIdx = array.get(barArray, arraySize - 1 - i)
            array.push(resultPrices, price)
            array.push(resultBars, barIdx)
    
    [resultPrices, resultBars]

/////////////////////////////////////////
// PIVOT CALCULATIONS AND UTILITIES //
/////////////////////////////////////////

// @function Calculate distance between two pivots in bars
// @param int barIndex1 - first pivot bar index
// @param int barIndex2 - second pivot bar index
// @returns int - distance in bars
export pivotDistance(int barIndex1, int barIndex2) =>
    math.abs(barIndex1 - barIndex2)

// @function Calculate price ratio between two pivots
// @param float price1 - first pivot price
// @param float price2 - second pivot price
// @returns float - price ratio
export pivotPriceRatio(float price1, float price2) =>
    if price2 != 0
        price1 / price2
    else
        na

// @function Calculate retracement ratio
// @param float startPrice - starting price
// @param float endPrice - ending price
// @param float currentPrice - current price
// @returns float - retracement ratio (0-1)
export pivotRetracementRatio(float startPrice, float endPrice, float currentPrice) =>
    if startPrice != endPrice
        math.abs(currentPrice - endPrice) / math.abs(startPrice - endPrice)
    else
        na

// @function Calculate extension ratio
// @param float startPrice - starting price
// @param float endPrice - ending price
// @param float currentPrice - current price
// @returns float - extension ratio (>1 for extension)
export pivotExtensionRatio(float startPrice, float endPrice, float currentPrice) =>
    if startPrice != endPrice
        math.abs(currentPrice - startPrice) / math.abs(endPrice - startPrice)
    else
        na

// @function Check if price is in Fibonacci retracement zone
// @param float startPrice - starting price
// @param float endPrice - ending price
// @param float currentPrice - current price
// @param float fibLevel - Fibonacci level (0.382, 0.618, etc.)
// @param float tolerance - tolerance percentage
// @returns bool - true if in zone
export isInFibZone(float startPrice, float endPrice, float currentPrice, float fibLevel, float tolerance) =>
    if startPrice != endPrice
        fibPrice = endPrice + (startPrice - endPrice) * fibLevel
        priceDiff = math.abs(currentPrice - fibPrice)
        maxDiff = math.abs(startPrice - endPrice) * tolerance / 100
        priceDiff <= maxDiff
    else
        false

// @function Get pivot type (high/low) based on surrounding prices
// @param float pivotPrice - price of the pivot
// @param int pivotBarIndex - bar index of the pivot
// @param int lookback - bars to look back and forward
// @returns string - "high", "low", or "unknown"
export getPivotType(float pivotPrice, int pivotBarIndex, int lookback) =>
    barsSince = bar_index - pivotBarIndex
    if barsSince >= lookback
        isHigh = true
        isLow = true
        
        // Check if it's higher than surrounding bars
        for i = 1 to lookback
            if high[barsSince - i] >= pivotPrice
                isHigh := false
            if high[barsSince + i] >= pivotPrice
                isHigh := false
        
        // Check if it's lower than surrounding bars
        for i = 1 to lookback
            if low[barsSince - i] <= pivotPrice
                isLow := false
            if low[barsSince + i] <= pivotPrice
                isLow := false
        
        if isHigh
            "high"
        else if isLow
            "low"
        else
            "unknown"
    else
        "unknown"

// @function Calculate pivot strength based on volume and price action
// @param float pivotPrice - price of the pivot
// @param int pivotBarIndex - bar index of the pivot
// @param int lookback - bars to analyze
// @returns float - strength score (0-100)
export calculatePivotStrength(float pivotPrice, int pivotBarIndex, int lookback) =>
    // Calculate ATR and volume outside conditional scope for consistency
    avgVolume = ta.sma(volume, lookback)
    
    barsSince = bar_index - pivotBarIndex
    if barsSince >= lookback and not na(pivotPrice) and pivotPrice > 0
        volumeScore = 0.0
        priceScore = 0.0
        priceValidationScore = 0.0
        
        // Volume analysis
        pivotVolume = volume[barsSince]
        volumeScore := math.min(100.0, (pivotVolume / avgVolume) * 50.0)
        
        // Price action analysis
        priceRange = 0.0
        for i = 1 to lookback
            barRange = high[barsSince - i] - low[barsSince - i]
            priceRange += barRange
        
        avgRange = priceRange / lookback
        currentRange = high[barsSince] - low[barsSince]
        priceScore := math.min(50.0, (currentRange / avgRange) * 25.0)
        
        // Price validation - check if pivot price is significant relative to recent price action
        priceDeviation = math.abs(pivotPrice - close[barsSince]) / close[barsSince] * 100
        priceValidationScore := math.min(25.0, priceDeviation * 2.5) // Bonus for significant price moves
        
        volumeScore + priceScore + priceValidationScore
    else
        0.0
