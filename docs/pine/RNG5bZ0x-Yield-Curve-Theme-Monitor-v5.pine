//@version=6
indicator("Yield Curve Theme Monitor v5 — Alt Conf + Session Moves", overlay=true)

//=========================
// SYMBOLS
//=========================
sym2  = input.symbol("TVC:US02Y", "2Y Yield")
sym5  = input.symbol("TVC:US05Y", "5Y Yield")
sym10 = input.symbol("TVC:US10Y", "10Y Yield")
sym20 = input.symbol("TVC:US20Y", "20Y Yield")
sym30 = input.symbol("TVC:US30Y", "30Y Yield")

//=========================
// UPDATE / RESET
//=========================
updateTF = input.timeframe("1", "Yield Update TF (minutes)")
resetTZ  = input.string("UTC", "Reset Timezone", options=["Europe/London","UTC"])

//=========================
// SETTINGS
//=========================
bpsMult       = input.float(100.0, "BPS Multiplier", step=100.0)
bucketBandBps = input.float(0.30,  "Bucket Band (bps) Steep/Flat", step=0.05)
minDispBps    = input.float(0.80,  "Min Dispersion for Non-Neutral", step=0.10)
minDirBps     = input.float(0.10,  "Min Avg Move for Bull/Bear (bps)", step=0.05)
arrowThresh   = input.float(0.50,  "Arrow Threshold (bps)", step=0.10)
lockBps       = input.float(4.0,   "Bull/Bear Lock Threshold (bps)", step=0.5, minval=0.5,
     tooltip="Once avg 5-tenor move exceeds this level, opposing-direction themes are suppressed in Alt Confidence (x0.04 weight)")

//=========================
// DISPLAY TOGGLES
//=========================
showTenors   = input.bool(true, "Show Tenor Row")
showSpreads  = input.bool(true, "Show Spreads / Meta Row")
showWeekly   = input.bool(true, "Show 7-Day Theme Section")
showDailyLog = input.bool(true, "Show Daily Theme Log")
showAltConf  = input.bool(true, "Show Alt Theme Confidence")

//=========================
// HUD STYLE
//=========================
cornerOpt = input.string("Bottom Left", "HUD Corner",
     options=["Top Left","Top Right","Bottom Left","Bottom Right"])
sizeOpt   = input.string("Small", "HUD Text Size",
     options=["Tiny","Small","Normal","Large","Huge"])

bullColor    = input.color(color.lime,                "Bull Color")
bearColor    = input.color(color.red,                 "Bear Color")
neutralColor = input.color(color.silver,              "Neutral Color")
posColor     = input.color(color.new(color.red, 20),  "Positive Delta Color")
negColor     = input.color(color.new(color.lime, 20), "Negative Delta Color")
flatColor    = input.color(color.silver,              "Flat Delta Color")
labelColor   = input.color(color.new(color.gray, 0),  "Label Color")
bgColor      = input.color(color.new(color.black, 75),"HUD Background")
bgAlt        = input.color(color.new(color.black, 85),"HUD Row Alt Background")

//=========================
// HELPERS
//=========================
f_pos(_p) =>
    switch _p
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

f_size(_s) =>
    switch _s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.small

f_fmt(_x)       => str.tostring(_x, "0.00")
f_sign(_x)      => _x > 0 ? "+" : ""
f_fmt_s(_x)     => f_sign(_x) + f_fmt(_x)
f_arrow(_x, _t) => _x > _t ? "▲" : _x < -_t ? "▼" : "─"
f_conf(_mag)    => _mag < 0.5 ? "Low" : _mag < 1.5 ? "Med" : "High"
f_valColor(_x)  => _x > 0.0 ? posColor : _x < 0.0 ? negColor : flatColor

f_abbr(_t) =>
    switch _t
        "Bull Steepener"  => "BullStpn"
        "Bull Flattener"  => "BullFlat"
        "Bull Parallel"   => "BullPar"
        "Bear Steepener"  => "BearStpn"
        "Bear Flattener"  => "BearFlat"
        "Bear Parallel"   => "BearPar"
        "Neutral / Mixed" => "Neutral"
        => "—"

f_themeColor(_t) =>
    str.contains(_t, "Bull") ? bullColor : str.contains(_t, "Bear") ? bearColor : neutralColor

//=========================
// FETCH
//
// y*    — live intraday price (1m stream)
// y*_d  — yesterday's confirmed close (lookahead_on)
// y*_w  — close 7 trading days ago
//=========================
y2  = request.security(sym2,  updateTF, close, barmerge.gaps_off, barmerge.lookahead_off)
y5  = request.security(sym5,  updateTF, close, barmerge.gaps_off, barmerge.lookahead_off)
y10 = request.security(sym10, updateTF, close, barmerge.gaps_off, barmerge.lookahead_off)
y20 = request.security(sym20, updateTF, close, barmerge.gaps_off, barmerge.lookahead_off)
y30 = request.security(sym30, updateTF, close, barmerge.gaps_off, barmerge.lookahead_off)

y2_d  = request.security(sym2,  "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)
y5_d  = request.security(sym5,  "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)
y10_d = request.security(sym10, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)
y20_d = request.security(sym20, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)
y30_d = request.security(sym30, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)

y2_w  = request.security(sym2,  "D", close[8], barmerge.gaps_off, barmerge.lookahead_on)
y5_w  = request.security(sym5,  "D", close[8], barmerge.gaps_off, barmerge.lookahead_on)
y10_w = request.security(sym10, "D", close[8], barmerge.gaps_off, barmerge.lookahead_on)
y20_w = request.security(sym20, "D", close[8], barmerge.gaps_off, barmerge.lookahead_on)
y30_w = request.security(sym30, "D", close[8], barmerge.gaps_off, barmerge.lookahead_on)

//=========================
// INTRADAY DELTAS
//=========================
d2  = (y2  - y2_d)  * bpsMult
d5  = (y5  - y5_d)  * bpsMult
d10 = (y10 - y10_d) * bpsMult
d20 = (y20 - y20_d) * bpsMult
d30 = (y30 - y30_d) * bpsMult

avgD           = (d2 + d5 + d10 + d20 + d30) / 5.0
front          = (d2 + d5) / 2.0
belly          = (d10 + d20) / 2.0
longAvg        = (d10 + d20 + d30) / 3.0
frontMinusLong = front - longAvg

maxD = math.max(d2, math.max(d5, math.max(d10, math.max(d20, d30))))
minD = math.min(d2, math.min(d5, math.min(d10, math.min(d20, d30))))
disp = maxD - minD

spread_2s10s = (y10 - y2) * bpsMult
spread_2s30s = (y30 - y2) * bpsMult

//=========================
// SESSION HIGH / LOW DELTAS
// ─────────────────────────
// Track the highest and lowest bps change vs yesterday's close
// seen during the current session for each of the 5 tenors.
// Reset to the current delta on every new session open so stale
// prior-day extremes never bleed through.
//=========================
var float hiD2  = 0.0
var float loD2  = 0.0
var float hiD5  = 0.0
var float loD5  = 0.0
var float hiD10 = 0.0
var float loD10 = 0.0
var float hiD20 = 0.0
var float loD20 = 0.0
var float hiD30 = 0.0
var float loD30 = 0.0

dayAnchorHL = time("D", "0000-2359", resetTZ)
newDayHL    = ta.change(dayAnchorHL) != 0

if newDayHL
    hiD2  := d2
    loD2  := d2
    hiD5  := d5
    loD5  := d5
    hiD10 := d10
    loD10 := d10
    hiD20 := d20
    loD20 := d20
    hiD30 := d30
    loD30 := d30
else
    hiD2  := math.max(hiD2,  d2)
    loD2  := math.min(loD2,  d2)
    hiD5  := math.max(hiD5,  d5)
    loD5  := math.min(loD5,  d5)
    hiD10 := math.max(hiD10, d10)
    loD10 := math.min(loD10, d10)
    hiD20 := math.max(hiD20, d20)
    loD20 := math.min(loD20, d20)
    hiD30 := math.max(hiD30, d30)
    loD30 := math.min(loD30, d30)

//=========================
// INTRADAY THEME
//=========================
isBull  = avgD < -minDirBps
isBear  = avgD >  minDirBps
isSteep = frontMinusLong < -bucketBandBps
isFlat  = frontMinusLong >  bucketBandBps

if (not isSteep) and (not isFlat) and (disp >= minDispBps)
    if frontMinusLong < 0
        isSteep := true
    else if frontMinusLong > 0
        isFlat := true

string theme = "Neutral / Mixed"
if isBull and isSteep
    theme := "Bull Steepener"
else if isBull and isFlat
    theme := "Bull Flattener"
else if isBull
    theme := "Bull Parallel"
else if isBear and isSteep
    theme := "Bear Steepener"
else if isBear and isFlat
    theme := "Bear Flattener"
else if isBear
    theme := "Bear Parallel"

color themeColor = neutralColor
if str.contains(theme, "Bull")
    themeColor := bullColor
else if str.contains(theme, "Bear")
    themeColor := bearColor

//=========================
// ALT-THEME CONFIDENCE
// ─────────────────────────
// Linear-ramp scoring: every theme always gets a non-zero probability.
//
// DIRECTION weight (uses lockBps as the full-scale reference):
//   bull_raw = max(0.01, lockBps − avgD)   → peaks as yields rally
//   bear_raw = max(0.01, lockBps + avgD)   → peaks as yields sell off
//   At avgD=0 both equal lockBps → 50/50 bull/bear split.
//   At avgD=+1bp with lockBps=4: bull=3, bear=5 → 37% bull / 63% bear.
//   At avgD=+4bp (lock): bull_raw hits floor 0.01, then crushed ×0.04.
//   No direction ever reaches exactly 0% until the lock fires.
//
// SHAPE weight (uses shapeRef = lockBps/2 as reference, default 2bp):
//   steep_wt = max(0.01, shapeRef − fml)   → front falling > long
//   flat_wt  = max(0.01, shapeRef + fml)   → long falling > front
//   par_wt   = max(0.01, shapeRef − |fml|) → all tenors moving together
//   At fml=0: all three equal → three-way shape tie.
//   At fml=+1bp: flat=3, steep=1, par=1 → 60% flat weighting.
//
// Theme score = dir_wt × shape_wt, normalised to 100%.
//
// Display: 4 fixed columns always showing the key traded themes:
//   Col 2 BullStpn  Col 3 BullFlat  Col 4 BearStpn  Col 5 BearFlat
//   Col 6 lock indicator  (Parallel scores are computed but not shown)
//=========================
_shapeRef  = lockBps / 2.0

_bull_raw  = math.max(0.01, lockBps - avgD)
_bear_raw  = math.max(0.01, lockBps + avgD)
_bull_adj  = avgD >  lockBps ? _bull_raw * 0.04 : _bull_raw
_bear_adj  = avgD < -lockBps ? _bear_raw * 0.04 : _bear_raw

_steep_wt  = math.max(0.01, _shapeRef - frontMinusLong)
_flat_wt   = math.max(0.01, _shapeRef + frontMinusLong)
_par_wt    = math.max(0.01, _shapeRef - math.abs(frontMinusLong))

_sc = array.new_float(6)
array.set(_sc, 0, _bull_adj * _steep_wt)   // Bull Steepener
array.set(_sc, 1, _bull_adj * _flat_wt)    // Bull Flattener
array.set(_sc, 2, _bull_adj * _par_wt)     // Bull Parallel  (scored, not shown)
array.set(_sc, 3, _bear_adj * _steep_wt)   // Bear Steepener
array.set(_sc, 4, _bear_adj * _flat_wt)    // Bear Flattener
array.set(_sc, 5, _bear_adj * _par_wt)     // Bear Parallel  (scored, not shown)

// Normalise only over the 4 displayed themes (0=BullStpn, 1=BullFlat, 3=BearStpn, 4=BearFlat)
// Parallel themes (2,5) are scored for completeness but excluded from the display pool,
// ensuring the 4 shown percentages always sum to exactly 100%.
_sc4Sum = array.get(_sc, 0) + array.get(_sc, 1) + array.get(_sc, 3) + array.get(_sc, 4)
if _sc4Sum < 0.0001
    _sc4Sum := 1.0
array.set(_sc, 0, array.get(_sc, 0) / _sc4Sum * 100.0)
array.set(_sc, 1, array.get(_sc, 1) / _sc4Sum * 100.0)
array.set(_sc, 3, array.get(_sc, 3) / _sc4Sum * 100.0)
array.set(_sc, 4, array.get(_sc, 4) / _sc4Sum * 100.0)

_tIdx = theme == "Bull Steepener" ? 0 : theme == "Bull Flattener" ? 1 : theme == "Bull Parallel" ? 2 : theme == "Bear Steepener" ? 3 : theme == "Bear Flattener" ? 4 : theme == "Bear Parallel" ? 5 : -1

_lockActive = math.abs(avgD) > lockBps

//=========================
// WEEKLY DELTAS
//=========================
wd2  = (y2  - y2_w)  * bpsMult
wd5  = (y5  - y5_w)  * bpsMult
wd10 = (y10 - y10_w) * bpsMult
wd20 = (y20 - y20_w) * bpsMult
wd30 = (y30 - y30_w) * bpsMult

wAvgD  = (wd2 + wd5 + wd10 + wd20 + wd30) / 5.0
wFront = (wd2 + wd5) / 2.0
wBelly = (wd10 + wd20) / 2.0
wLong  = (wd10 + wd20 + wd30) / 3.0
wFmL   = wFront - wLong

wMaxD  = math.max(wd2, math.max(wd5, math.max(wd10, math.max(wd20, wd30))))
wMinD  = math.min(wd2, math.min(wd5, math.min(wd10, math.min(wd20, wd30))))
wDisp  = wMaxD - wMinD

//=========================
// WEEKLY THEME
//=========================
wIsBull  = wAvgD < -minDirBps
wIsBear  = wAvgD >  minDirBps
wIsSteep = wFmL < -bucketBandBps
wIsFlat  = wFmL >  bucketBandBps

if (not wIsSteep) and (not wIsFlat) and (wDisp >= minDispBps)
    if wFmL < 0
        wIsSteep := true
    else if wFmL > 0
        wIsFlat := true

string wTheme = "Neutral / Mixed"
if wIsBull and wIsSteep
    wTheme := "Bull Steepener"
else if wIsBull and wIsFlat
    wTheme := "Bull Flattener"
else if wIsBull
    wTheme := "Bull Parallel"
else if wIsBear and wIsSteep
    wTheme := "Bear Steepener"
else if wIsBear and wIsFlat
    wTheme := "Bear Flattener"
else if wIsBear
    wTheme := "Bear Parallel"

color wThemeColor = neutralColor
if str.contains(wTheme, "Bull")
    wThemeColor := bullColor
else if str.contains(wTheme, "Bear")
    wThemeColor := bearColor

wConf = f_conf(math.abs(wFmL))

//=========================
// DURATION + CONFIDENCE
//=========================
var int    themeBars = 0
var string lastTheme = ""

if barstate.isconfirmed
    if theme != lastTheme
        themeBars := 1
        lastTheme := theme
    else
        themeBars += 1

themeChanged = barstate.isconfirmed and theme != theme[1]
confidence   = f_conf(math.abs(frontMinusLong))

//=========================
// DAILY THEME LOG + SESSION MOVES
// ─────────────────────────────────
// dailyThemes[] : rolling 6-session theme history
// dailyMoves[]  : rolling 6-session avg-bps move history (signed)
//
// lastAvgD snapshots the final avgD of each completed session.
// Ordering is critical:
//   ① newDay block runs FIRST  → pushes lastAvgD (still = prev session final)
//   ② lastAvgD update runs AFTER → advances to current bar
// This ensures each stored value is the session's genuine closing move,
// not the next day's opening gap.
//=========================
dayAnchor = time("D", "0000-2359", resetTZ)
newDay    = ta.change(dayAnchor) != 0

var string[] dailyThemes = array.new_string(6, "—")
var float[]  dailyMoves  = array.new_float(6, 0.0)
var float    lastAvgD    = 0.0

// ① Must precede the general isconfirmed block below
if barstate.isconfirmed and newDay
    array.shift(dailyThemes)
    array.push(dailyThemes, theme[1])
    array.shift(dailyMoves)
    array.push(dailyMoves, lastAvgD)

// ② Advance snapshot after new-day capture
if barstate.isconfirmed
    lastAvgD := avgD

//=========================
// ALERTS
//=========================
alertcondition(themeChanged,              title="Theme Changed",  message="Yield Curve: Theme has shifted — check HUD")
alertcondition(theme == "Bull Steepener", title="Bull Steepener", message="Yield Curve: Bull Steepener active")
alertcondition(theme == "Bull Flattener", title="Bull Flattener", message="Yield Curve: Bull Flattener active")
alertcondition(theme == "Bull Parallel",  title="Bull Parallel",  message="Yield Curve: Bull Parallel active")
alertcondition(theme == "Bear Steepener", title="Bear Steepener", message="Yield Curve: Bear Steepener active")
alertcondition(theme == "Bear Flattener", title="Bear Flattener", message="Yield Curve: Bear Flattener active")
alertcondition(theme == "Bear Parallel",  title="Bear Parallel",  message="Yield Curve: Bear Parallel active")

//=========================
// TABLE  (7 cols × 16 rows)
// ─────────────────────────
//  R0      TODAY header + alt-conf inline (cols 2–6)
//  R1–R2   Intraday bucket labels + values
//  R3–R4   Tenor rows                    (toggle)
//  R5      Tenor session HIGH (red)      (toggle, same gate as showTenors)
//  R6      Tenor session LOW  (green)    (toggle, same gate as showTenors)
//  R7–R8   Spreads / Meta               (toggle)
//  R9–R11  7-Day theme                  (toggle)
//  R12–R15 Daily log + session moves    (toggle)
//=========================
COLS = 7
ROWS = 16
emp  = color.new(color.black, 100)

var table hud = table.new(f_pos(cornerOpt), COLS, ROWS,
     border_width=1, border_color=color.new(color.gray, 70),
     frame_width=1,  frame_color=color.new(color.gray, 60))

if barstate.islast
    sz = f_size(sizeOpt)

    // ── R0: TODAY Theme + 4-Theme Confidence ────────────────────
    // Col 0 : "◈  TODAY: <theme>  ✓ NEW"
    // Col 2 : Bull Steepener %  — always visible, bull colour
    // Col 3 : Bull Flattener %  — always visible, bull colour
    // Col 4 : Bear Steepener %  — always visible, bear colour
    // Col 5 : Bear Flattener %  — always visible, bear colour
    //         Primary theme cell gets a highlighted background
    // Col 6 : 🔒BULL / 🔒BEAR when avgD has crossed lockBps
    hdl = "◈  TODAY: " + theme + (themeChanged ? "   ✓ NEW" : "")
    // Fixed mapping: col → theme index in _sc (Parallel excluded from display)
    // col 2 = BullStpn(0), col 3 = BullFlat(1), col 4 = BearStpn(3), col 5 = BearFlat(4)
    for c = 0 to COLS - 1
        if c == 0
            table.cell(hud, c, 0,
                 text        = hdl,
                 text_color  = themeColor,
                 bgcolor     = bgColor,
                 text_size   = sz,
                 text_halign = text.align_left)
        else if (c >= 2 and c <= 5) and showAltConf
            aIdx  = c == 2 ? 0 : c == 3 ? 1 : c == 4 ? 3 : 4
            aAbbr = c == 2 ? "BullStpn" : c == 3 ? "BullFlat" : c == 4 ? "BearStpn" : "BearFlat"
            aPct  = str.tostring(array.get(_sc, aIdx), "0") + "%"
            aColor = c <= 3 ? bullColor : bearColor
            // Slightly highlight whichever column matches the active primary theme
            isPrimary = aIdx == _tIdx
            bgCell = isPrimary ? color.new(color.gray, 60) : bgColor
            table.cell(hud, c, 0, text=aAbbr + " " + aPct, text_color=aColor, bgcolor=bgCell, text_size=sz)
        else if c == 6 and showAltConf
            lockTxt   = _lockActive ? (avgD < 0 ? "🔒BULL" : "🔒BEAR") : ""
            lockColor = avgD < 0 ? bullColor : bearColor
            table.cell(hud, c, 0, text=lockTxt, text_color=lockColor, bgcolor=bgColor, text_size=sz)
        else
            table.cell(hud, c, 0, text="", bgcolor=bgColor, text_size=sz)

    // ── R1: Intraday Bucket Labels ───────────────────────────
    iBktL = array.from("FRONT", "BELLY", "LONG", "F – L", "AVG Δ", "", "")
    for c = 0 to COLS - 1
        table.cell(hud, c, 1,
             text=array.get(iBktL, c), text_color=labelColor, bgcolor=bgAlt, text_size=sz)

    // ── R2: Intraday Bucket Values ───────────────────────────
    iBktV = array.from(front, belly, longAvg, frontMinusLong, avgD)
    for c = 0 to COLS - 1
        if c < 5
            v = array.get(iBktV, c)
            table.cell(hud, c, 2, text=f_fmt_s(v)+"bp", text_color=f_valColor(v), bgcolor=bgColor, text_size=sz)
        else
            table.cell(hud, c, 2, text="", bgcolor=bgColor, text_size=sz)

    // ── R3-R6: Tenor Rows + Session High / Low ──────────────
    // R3 : tenor name + live yield level
    // R4 : direction arrow + current bps delta vs yesterday
    // R5 : session HIGH delta — red  (highest yield reached today)
    // R6 : session LOW  delta — green (lowest yield reached today)
    if showTenors
        tLbls   = array.from("2Y", "5Y", "10Y", "20Y", "30Y")
        tVals   = array.from(d2, d5, d10, d20, d30)
        tLevels = array.from(y2, y5, y10, y20, y30)
        tHi     = array.from(hiD2, hiD5, hiD10, hiD20, hiD30)
        tLo     = array.from(loD2, loD5, loD10, loD20, loD30)
        for c = 0 to COLS - 1
            if c < 5
                lvl = str.tostring(array.get(tLevels, c), "0.000")
                lbl = array.get(tLbls, c) + "   " + lvl
                table.cell(hud, c, 3, text=lbl, text_color=labelColor, bgcolor=bgAlt, text_size=sz)
                v   = array.get(tVals, c)
                val = f_arrow(v, arrowThresh) + "  " + f_fmt_s(v) + "bp"
                table.cell(hud, c, 4, text=val, text_color=f_valColor(v), bgcolor=bgColor, text_size=sz)
                hi = array.get(tHi, c)
                table.cell(hud, c, 5, text="H " + f_fmt_s(hi) + "bp", text_color=posColor, bgcolor=bgAlt, text_size=sz)
                lo = array.get(tLo, c)
                table.cell(hud, c, 6, text="L " + f_fmt_s(lo) + "bp", text_color=negColor, bgcolor=bgColor, text_size=sz)
            else
                table.cell(hud, c, 3, text="", bgcolor=bgAlt,   text_size=sz)
                table.cell(hud, c, 4, text="", bgcolor=bgColor, text_size=sz)
                table.cell(hud, c, 5, text="", bgcolor=bgAlt,   text_size=sz)
                table.cell(hud, c, 6, text="", bgcolor=bgColor, text_size=sz)
    else
        for c = 0 to COLS - 1
            table.cell(hud, c, 3, text="", bgcolor=emp, text_size=size.tiny)
            table.cell(hud, c, 4, text="", bgcolor=emp, text_size=size.tiny)
            table.cell(hud, c, 5, text="", bgcolor=emp, text_size=size.tiny)
            table.cell(hud, c, 6, text="", bgcolor=emp, text_size=size.tiny)

    // ── R7-R8: Spreads / Meta ────────────────────────────────
    if showSpreads
        mLbls = array.from("2s10s", "2s30s", "CONF", "DUR", "DISP", "", "")
        mTxt  = array.from(
             f_fmt(spread_2s10s)+"bp",
             f_fmt(spread_2s30s)+"bp",
             confidence,
             str.tostring(themeBars)+" bars",
             f_fmt(disp)+"bp",
             "", "")
        for c = 0 to COLS - 1
            table.cell(hud, c, 7, text=array.get(mLbls, c), text_color=labelColor, bgcolor=bgAlt, text_size=sz)
            mColor = c == 0 ? f_valColor(spread_2s10s) : c == 1 ? f_valColor(spread_2s30s) : neutralColor
            table.cell(hud, c, 8, text=array.get(mTxt, c), text_color=mColor, bgcolor=bgColor, text_size=sz)
    else
        for c = 0 to COLS - 1
            table.cell(hud, c, 7, text="", bgcolor=emp, text_size=size.tiny)
            table.cell(hud, c, 8, text="", bgcolor=emp, text_size=size.tiny)

    // ── R9-R11: Weekly Theme ─────────────────────────────────
    if showWeekly
        wHdl = "◈  7-DAY: " + wTheme
        for c = 0 to COLS - 1
            table.cell(hud, c, 9,
                 text        = c == 0 ? wHdl : "",
                 text_color  = wThemeColor,
                 bgcolor     = bgColor,
                 text_size   = sz,
                 text_halign = text.align_left)
        wBktL = array.from("FRONT", "BELLY", "LONG", "F – L", "AVG Δ", "CONF", "")
        wBktV = array.from(wFront, wBelly, wLong, wFmL, wAvgD)
        for c = 0 to COLS - 1
            table.cell(hud, c, 10, text=array.get(wBktL, c), text_color=labelColor, bgcolor=bgAlt, text_size=sz)
            if c < 5
                v = array.get(wBktV, c)
                table.cell(hud, c, 11, text=f_fmt_s(v)+"bp", text_color=f_valColor(v), bgcolor=bgColor, text_size=sz)
            else if c == 5
                table.cell(hud, c, 11, text=wConf, text_color=neutralColor, bgcolor=bgColor, text_size=sz)
            else
                table.cell(hud, c, 11, text="", bgcolor=bgColor, text_size=sz)
    else
        for c = 0 to COLS - 1
            table.cell(hud, c, 9,  text="", bgcolor=emp, text_size=size.tiny)
            table.cell(hud, c, 10, text="", bgcolor=emp, text_size=size.tiny)
            table.cell(hud, c, 11, text="", bgcolor=emp, text_size=size.tiny)

    // ── R12-R15: Daily Theme Log + Session Move Magnitudes ───
    if showDailyLog
        for c = 0 to COLS - 1
            table.cell(hud, c, 12,
                 text        = c == 0 ? "DAILY LOG  ( D-6 → Today )" : "",
                 text_color  = labelColor,
                 bgcolor     = color.new(color.navy, 55),
                 text_size   = sz,
                 text_halign = text.align_left)
        dLbls = array.from("D – 6", "D – 5", "D – 4", "D – 3", "D – 2", "D – 1", "TODAY")
        for c = 0 to COLS - 1
            table.cell(hud, c, 13, text=array.get(dLbls, c), text_color=labelColor, bgcolor=bgAlt, text_size=sz)
        // R14: Theme abbreviations
        for c = 0 to COLS - 1
            if c < 6
                t = array.get(dailyThemes, c)
                table.cell(hud, c, 14, text=f_abbr(t), text_color=f_themeColor(t), bgcolor=bgColor, text_size=sz)
            else
                table.cell(hud, 6, 14, text=f_abbr(theme), text_color=themeColor, bgcolor=bgColor, text_size=sz)
        // R15: Session move magnitude
        for c = 0 to COLS - 1
            if c < 6
                mv = array.get(dailyMoves, c)
                table.cell(hud, c, 15,
                     text       = f_fmt_s(mv) + "bp",
                     text_color = f_valColor(mv),
                     bgcolor    = bgColor,
                     text_size  = sz)
            else
                table.cell(hud, 6, 15,
                     text       = f_fmt_s(avgD) + "bp",
                     text_color = f_valColor(avgD),
                     bgcolor    = bgColor,
                     text_size  = sz)
    else
        for c = 0 to COLS - 1
            table.cell(hud, c, 12, text="", bgcolor=emp, text_size=size.tiny)
            table.cell(hud, c, 13, text="", bgcolor=emp, text_size=size.tiny)
            table.cell(hud, c, 14, text="", bgcolor=emp, text_size=size.tiny)
            table.cell(hud, c, 15, text="", bgcolor=emp, text_size=size.tiny)
