//@version=6
// =============================================================================
//  MT5 WEBHOOK ALERT TEMPLATE v1.0
// =============================================================================
//  Que hace: genera senales Buy/Sell con un cruce de EMAs + filtro RSI y
//  emite alertas con un mensaje JSON listo para un puente webhook -> MT5.
//
//  Como usarlo con CUALQUIER puente webhook -> MT5:
//   1. Anade el indicador al chart.
//   2. Crea una alerta (Alt+A) sobre este indicador, condicion "Any alert()
//      function call", y pega la URL de tu webhook en el campo Webhook URL.
//   3. El mensaje ya va en JSON: no toques el campo Message.
//
//  Formato del mensaje (campos soportados por la mayoria de bridges MT5):
//    {"action":"buy","symbol":"EURUSD","lot":0.01,"sl":50,"tp":100}
//    {"action":"sell","symbol":"EURUSD","lot":0.01,"sl":50,"tp":100}
//    action: buy | sell | close | closeall
//    sl/tp: distancia en puntos (pips en forex de 5 digitos), opcionales
//
//  Notas:
//   - Las alertas se evaluan al cierre de la vela (freq_once_per_bar_close)
//     para no repintar intrabar.
//   - El indicador funciona solo como senal visual aunque no uses webhook.
//  Licencia: open source, uso libre con atribucion.
// =============================================================================

indicator("MT5 Webhook Alert Template", shorttitle="Webhook->MT5", overlay=true)

// -----------------------------------------------------------------------------
// Inputs de estrategia
// -----------------------------------------------------------------------------
grpS = "Signal logic"
i_fastLen  = input.int(1,   "Fast EMA", minval=1, group=grpS)
i_slowLen  = input.int(3,   "Slow EMA", minval=2, group=grpS)
i_useRsi   = input.bool(true, "RSI filter", group=grpS,
     tooltip="Longs solo si RSI > 50, shorts solo si RSI < 50")
i_rsiLen   = input.int(2,   "RSI length", minval=2, group=grpS)

// -----------------------------------------------------------------------------
// Inputs del payload webhook (ajusta a tu cuenta)
// -----------------------------------------------------------------------------
grpW = "Webhook payload"
i_lot = input.float(0.01, "Lot size", minval=0.01, step=0.01, group=grpW)
i_sl  = input.int(50,  "Stop Loss (points)", minval=0, group=grpW,
     tooltip="0 = omitir el campo sl del JSON")
i_tp  = input.int(100, "Take Profit (points)", minval=0, group=grpW,
     tooltip="0 = omitir el campo tp del JSON")
i_sym = input.string("", "Symbol override", group=grpW,
     tooltip="Vacio = usa el ticker del chart (p.ej. EURUSD). Rellena si tu broker usa sufijos, p.ej. EURUSD.pro")

// -----------------------------------------------------------------------------
// Logica de senal
// -----------------------------------------------------------------------------
fastEma = ta.ema(close, i_fastLen)
slowEma = ta.ema(close, i_slowLen)
rsiVal  = ta.rsi(close, i_rsiLen)

longOk  = not i_useRsi or rsiVal > 50
shortOk = not i_useRsi or rsiVal < 50

buySignal  = ta.crossover(fastEma, slowEma) and longOk
sellSignal = ta.crossunder(fastEma, slowEma) and shortOk

// -----------------------------------------------------------------------------
// Construccion del mensaje JSON
// -----------------------------------------------------------------------------
symbol = i_sym == "" ? syminfo.ticker : i_sym

jsonMsg(string side) =>
    msg = '{"action":"' + side + '","symbol":"' + symbol + '","lot":' + str.tostring(i_lot)
    msg := i_sl > 0 ? msg + ',"sl":' + str.tostring(i_sl) : msg
    msg := i_tp > 0 ? msg + ',"tp":' + str.tostring(i_tp) : msg
    msg + '}'

// Alertas dinamicas: se disparan con la condicion "Any alert() function call"
if buySignal
    alert(jsonMsg("buy"), alert.freq_once_per_bar_close)
if sellSignal
    alert(jsonMsg("sell"), alert.freq_once_per_bar_close)

// Alertas estaticas (para elegirlas por nombre en el dialogo de alertas)
alertcondition(buySignal,  title="Webhook BUY",
     message='{"action":"buy","symbol":"{{ticker}}","lot":0.01,"sl":50,"tp":100}')
alertcondition(sellSignal, title="Webhook SELL",
     message='{"action":"sell","symbol":"{{ticker}}","lot":0.01,"sl":50,"tp":100}')

// -----------------------------------------------------------------------------
// Visual
// -----------------------------------------------------------------------------
plot(fastEma, "Fast EMA", color=color.new(color.teal, 0), linewidth=2)
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0), linewidth=2)
plotshape(buySignal,  "BUY",  style=shape.triangleup,   location=location.belowbar,
     color=color.new(color.teal, 0), size=size.small, text="BUY")
plotshape(sellSignal, "SELL", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small, text="SELL")
