//@version=6
strategy("RSI + Bollinger Band", overlay=true, fill_orders_on_standard_ohlc=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2)

//Basic inputs for user
BBlength = input.int(20, "Bollinger band length", group="Bollinger Bands")
BBstDevMult = input.float(2.0, "Bollinger band standard deviation multiplier", group="Bollinger Bands")
RSIlength = input.int(14, "RSI length", group="RSI")
RSIoversold = input.int(30, "RSI oversold", group="RSI")
RSIoverbought = input.int(70, "RSI overbought", group="RSI")

[middleBand, upperBand, lowerBand] = ta.bb(close, BBlength, BBstDevMult)
rsi = ta.rsi(close, RSIlength)

confirmOnClose = input.bool(true, "Only signal on bar close?", group="General")
barConfirmed = confirmOnClose ? barstate.isconfirmed : true

//Trend filtering
useTrendFilter = input.bool(false, "Use trend filter?", group="Trend Filter")
trendLength = input.int(200, "Trend EMA length", group="Trend Filter")
trendEMA = ta.ema(close, trendLength)

longTrendOK = useTrendFilter ? close > trendEMA : true
shortTrendOK = useTrendFilter ? close < trendEMA : true

useSqueezeFilter = input.bool(false, "Avoid low-volatility squeezes?", group="Squeeze Filter")
bbWidth = (upperBand - lowerBand) / middleBand
bbWidthMA = ta.sma(bbWidth, BBlength)
notSqueezed = useSqueezeFilter ? bbWidth > bbWidthMA * 0.8 : true

longCondition = close < lowerBand and rsi < RSIoversold and barConfirmed and longTrendOK and notSqueezed
shortCondition = close > upperBand and rsi > RSIoverbought and barConfirmed and shortTrendOK and notSqueezed

//Types of exits
exitMode = input.string("Middle Band", "Exit mode", options=["Middle Band", "Opposite Band", "RSI 50 Cross"], group="Exits")

longExit = switch exitMode
    "Middle Band" => ta.crossover(close, middleBand)
    "Opposite Band" => ta.crossover(close, upperBand)
    "RSI 50 Cross" => ta.crossover(rsi, 50)

shortExit = switch exitMode
    "Middle Band" => ta.crossunder(close, middleBand)
    "Opposite Band" => ta.crossunder(close, lowerBand)
    "RSI 50 Cross" => ta.crossunder(rsi, 50)

//Stop-loss, based on ATR
useStop = input.bool(false, "Use stop-loss?", group="Risk Management")
stopATRlen = input.int(14, "ATR length for stop", group="Risk Management")
stopATRmult = input.float(2.0, "ATR multiplier for stop", group="Risk Management")
atrVal = ta.atr(stopATRlen)

// Position sizing inputs
riskPercent = input.float(1.0, "Risk % per trade (used when stop is ON)", minval=0.1, maxval=10.0, group="Risk Management")
fixedSizePercent = input.float(5.0, "Fixed position size % of equity (used when stop is OFF)", minval=0.1, maxval=100.0, group="Risk Management")

// Stop distance in price terms (only meaningful when useStop is on)
stopDistance = atrVal * stopATRmult

// Position sizing: ATR-risk-based when stop is active, fixed % fallback when it isn't
qtyFromRisk = stopDistance > 0 ? (strategy.equity * (riskPercent / 100)) / stopDistance : 0
qtyFixed = (strategy.equity * (fixedSizePercent / 100)) / close

longQty = useStop ? math.floor(qtyFromRisk) : math.floor(qtyFixed)
shortQty = useStop ? math.floor(qtyFromRisk) : math.floor(qtyFixed)

if (longCondition)
    strategy.entry("Long", strategy.long, qty=longQty)
    if useStop
        strategy.exit("Long Stop", "Long", stop=close - stopDistance)

if (shortCondition)
    strategy.entry("Short", strategy.short, qty=shortQty)
    if useStop
        strategy.exit("Short Stop", "Short", stop=close + stopDistance)

if (longExit)
    strategy.close("Long")

if (shortExit)
    strategy.close("Short")

//Plotting long buy
plotshape(longCondition, "Long", shape.cross, location.belowbar, color.green)
plotshape(shortCondition, "Short", shape.xcross, location.abovebar, color.red)

//Plotting bands
upperLine = plot(upperBand, "Upper band", color.blue, 1)
lowerLine = plot(lowerBand, "Lower band", color.blue, 1)
middleLine = plot(middleBand, "Middle band", color.teal, 1)
fill(upperLine, lowerLine, color.new(color.blue, 85), "Expected area", false)

//Color indicators of strength in signal for each long/short
bandStretch = close < lowerBand ? (lowerBand - close) / lowerBand * 100 : close > upperBand ? (close - upperBand) / upperBand * 100 : 0
rsiExtreme = rsi < RSIoversold ? RSIoversold - rsi : rsi > RSIoverbought ? rsi - RSIoverbought : 0
signalStrength = math.min(100, bandStretch * 10 + rsiExtreme * 2)

bgcolor(longCondition ? color.new(color.green, 100 - signalStrength) : shortCondition ? color.new(color.red, 100 - signalStrength) : na)