//@version=6
// SPDX-License-Identifier: MPL-2.0
//
// Tetrad Elektro Community v1.0
// Open-source educational strategy by Tetrad Protocol.
//
// This is a simplified public research strategy demonstrating
// Bollinger Band exhaustion, RSI confirmation, and bearish divergence logic.
//
// Not financial advice.
// Backtests are hypothetical and may differ from live execution.
// This public version does not include Tetrad's private MLTT/RORO risk engine,
// execution controller, portfolio allocator, live routing, or production parameters.

strategy(
     "Tetrad Elektro Community v1.0",
     shorttitle="Elektro Community",
     overlay=true,
     initial_capital=100,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=3,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     pyramiding=0,
     calc_on_every_tick=false,
     calc_on_order_fills=false,
     max_bars_back=5000
)

//────────────────────────────────────────────
// 1) USER INPUTS
//────────────────────────────────────────────
groupMode = "Mode"

tradeMode = input.string(
     defval="Long & Short",
     title="Trade Mode",
     options=["Long & Short", "Long Only", "Short Only"],
     group=groupMode
)

flatFirst = input.bool(
     defval=true,
     title="Require Flat Before New Opposite Entry?",
     group=groupMode,
     tooltip="When enabled, the strategy will not instantly flip from long to short or short to long on the same bar."
)

groupBB = "Bollinger Bands"

bbLength = input.int(
     defval=265,
     title="Bollinger Length",
     minval=1,
     group=groupBB
)

bbMult = input.float(
     defval=3.3,
     title="Bollinger Multiplier",
     step=0.1,
     group=groupBB
)

groupRSI = "RSI Filters"

rsiLenMain = input.int(
     defval=14,
     title="Main RSI Length",
     minval=1,
     group=groupRSI
)

rsiLenFast = input.int(
     defval=7,
     title="Fast RSI Length",
     minval=1,
     group=groupRSI
)

entryThresholdLongMain = input.float(
     defval=23.0,
     title="Long Entry Main RSI ≤",
     step=0.1,
     group=groupRSI
)

entryThresholdLongFast = input.float(
     defval=85.0,
     title="Long Entry Fast RSI ≤",
     step=0.1,
     group=groupRSI
)

exitThresholdLongMain = input.float(
     defval=77.0,
     title="Long Exit / Short Setup Main RSI ≥",
     step=0.1,
     group=groupRSI
)

exitThresholdShortFast = input.float(
     defval=23.0,
     title="Short Exit Fast RSI ≤",
     step=0.1,
     group=groupRSI
)

groupMACD = "MACD Divergence"

fastLen = input.int(
     defval=12,
     title="MACD Fast Length",
     minval=1,
     group=groupMACD
)

slowLen = input.int(
     defval=26,
     title="MACD Slow Length",
     minval=1,
     group=groupMACD
)

signalLen = input.int(
     defval=14,
     title="MACD Signal Length",
     minval=1,
     group=groupMACD
)

divLookbackBars = input.int(
     defval=20,
     title="Divergence Lookback Bars",
     minval=1,
     group=groupMACD,
     tooltip="Looks for price making a new high while RSI or MACD fails to confirm."
)

useBearishDivergence = input.bool(
     defval=true,
     title="Enable Bearish Divergence Short Setup?",
     group=groupMACD
)

groupRisk = "Risk Management"

useStopLoss = input.bool(
     defval=false,
     title="Use Stop Loss?",
     group=groupRisk
)

longStopFactor = input.float(
     defval=0.85,
     title="Long Stop Factor",
     step=0.01,
     group=groupRisk,
     tooltip="0.85 means long stop is 15% below average entry."
)

shortStopFactor = input.float(
     defval=1.09,
     title="Short Stop Factor",
     step=0.01,
     group=groupRisk,
     tooltip="1.09 means short stop is 9% above average entry."
)

useTimeStop = input.bool(
     defval=false,
     title="Use Time-Based Stop?",
     group=groupRisk
)

timeStopDays = input.int(
     defval=2,
     title="Time Stop Days",
     minval=1,
     group=groupRisk
)

groupVisuals = "Visuals"

themeMode = input.string(
     defval="Dark Mode",
     title="Theme Mode",
     options=["Dark Mode", "Ultra Glow Mode"],
     group=groupVisuals
)

showSignalShapes = input.bool(
     defval=false,
     title="Show Signal Shapes?",
     group=groupVisuals,
     tooltip="Optional chart markers for long setups, exhaustion setups, and bearish divergence. Off by default for a cleaner public chart."
)

showPositionLabels = input.bool(
     defval=false,
     title="Show Trade Labels?",
     group=groupVisuals,
     tooltip="Optional LONG / SHORT / EXIT labels. Off by default to avoid chart clutter."
)

showBranding = input.bool(
     defval=true,
     title="Show Subtle Tetrad Branding?",
     group=groupVisuals
)

//────────────────────────────────────────────
// 2) INDICATOR CALCULATIONS
//────────────────────────────────────────────
bbSource = close

basis = ta.sma(bbSource, bbLength)
dev   = bbMult * ta.stdev(bbSource, bbLength)
upper = basis + dev
lower = basis - dev

rsiMain = ta.rsi(close, rsiLenMain)
rsiFast = ta.rsi(close, rsiLenFast)

macdLine   = ta.ema(close, fastLen) - ta.ema(close, slowLen)
signalLine = ta.ema(macdLine, signalLen)
histLine   = macdLine - signalLine

//────────────────────────────────────────────
// 3) DIVERGENCE LOGIC
//────────────────────────────────────────────
priceMakingNewHigh = close > ta.highest(close[1], divLookbackBars)

rsiNotConfirmingHigh  = rsiMain < ta.highest(rsiMain[1], divLookbackBars)
macdNotConfirmingHigh = macdLine < ta.highest(macdLine[1], divLookbackBars)

bearishDivergence = useBearishDivergence and priceMakingNewHigh and (rsiNotConfirmingHigh or macdNotConfirmingHigh)

//────────────────────────────────────────────
// 4) CORE SIGNAL LOGIC
//────────────────────────────────────────────
// Long mean-reversion setup:
// Price stretches below lower Bollinger Band while RSI is oversold.
buyCondition =
     close <= lower and
     rsiMain <= entryThresholdLongMain and
     rsiFast <= entryThresholdLongFast

// Long exit / short exhaustion setup:
// Price stretches above upper Bollinger Band while RSI is elevated.
sellCondition =
     close >= upper and
     rsiMain >= exitThresholdLongMain and
     rsiFast >= exitThresholdShortFast

// Short setup:
// Either Bollinger/RSI exhaustion or bearish divergence.
shortSetupBollinger =
     close >= upper and
     rsiMain >= exitThresholdLongMain and
     rsiFast >= exitThresholdShortFast

shortCondition = shortSetupBollinger or bearishDivergence

// Short exit:
// Price mean-reverts to lower Bollinger Band or RSI becomes oversold.
shortExitCondition =
     close <= lower or
     (rsiMain <= entryThresholdLongMain and rsiFast <= exitThresholdShortFast)

//────────────────────────────────────────────
// 5) MODE PERMISSIONS
//────────────────────────────────────────────
allowLong =
     tradeMode == "Long & Short" or tradeMode == "Long Only"

allowShort =
     tradeMode == "Long & Short" or tradeMode == "Short Only"

isFlat  = strategy.position_size == 0
isLong  = strategy.position_size > 0
isShort = strategy.position_size < 0

canOpenLong =
     allowLong and buyCondition and (flatFirst ? isFlat : not isLong)

canOpenShort =
     allowShort and shortCondition and (flatFirst ? isFlat : not isShort)

//────────────────────────────────────────────
// 6) ENTRY TIME TRACKING
//────────────────────────────────────────────
var float entryTime = na

newPositionOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
positionClosed    = strategy.position_size == 0 and strategy.position_size[1] != 0

if newPositionOpened
    entryTime := time

if positionClosed
    entryTime := na

//────────────────────────────────────────────
// 7) STRATEGY EXECUTION
//────────────────────────────────────────────
if canOpenLong
    strategy.entry("Long", strategy.long)

if canOpenShort
    strategy.entry("Short", strategy.short)

// Long management
if isLong
    longStopPrice = strategy.position_avg_price * longStopFactor

    if useStopLoss
        strategy.exit("Long Stop", from_entry="Long", stop=longStopPrice)

    if sellCondition
        strategy.close("Long", comment="Long Exit")

// Short management
if isShort
    shortStopPrice = strategy.position_avg_price * shortStopFactor

    if useStopLoss
        strategy.exit("Short Stop", from_entry="Short", stop=shortStopPrice)

    if shortExitCondition
        strategy.close("Short", comment="Short Exit")

// Time stop
if useTimeStop and strategy.position_size != 0 and not na(entryTime)
    msSinceEntry = time - entryTime
    daysSinceEntry = msSinceEntry / 86400000.0

    if daysSinceEntry >= timeStopDays
        strategy.close_all(comment="Time Stop")

//────────────────────────────────────────────
// 8) PLOTS
//────────────────────────────────────────────
lineThickness = themeMode == "Ultra Glow Mode" ? 3 : 2
fillAlpha     = themeMode == "Ultra Glow Mode" ? 70 : 84
shapeAlpha    = themeMode == "Ultra Glow Mode" ? 35 : 55

tetradBlue = color.rgb(0, 51, 255)
softBlue   = color.new(tetradBlue, 50)
basisBlue  = color.new(tetradBlue, 20)

plotBasis = plot(
     basis,
     title="Bollinger Basis",
     color=basisBlue,
     linewidth=lineThickness
)

plotUpper = plot(
     upper,
     title="Bollinger Upper",
     color=softBlue,
     linewidth=lineThickness
)

plotLower = plot(
     lower,
     title="Bollinger Lower",
     color=softBlue,
     linewidth=lineThickness
)

fill(
     plotUpper,
     plotLower,
     color=color.new(tetradBlue, 94),
     title="Bollinger Band Fill"
)

positionFillColor =
     isLong ? color.new(tetradBlue, fillAlpha) :
     isShort ? color.new(color.fuchsia, fillAlpha) :
     na

fill(
     plotBasis,
     plotLower,
     color=isLong ? positionFillColor : na,
     title="Long Position Fill"
)

fill(
     plotBasis,
     plotUpper,
     color=isShort ? positionFillColor : na,
     title="Short Position Fill"
)

//────────────────────────────────────────────
// 9) OPTIONAL SIGNAL SHAPES
//────────────────────────────────────────────
plotshape(
     showSignalShapes and buyCondition,
     title="Optional Long Setup Marker",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.new(tetradBlue, shapeAlpha),
     text="▲",
     textcolor=color.new(tetradBlue, 0),
     size=size.tiny
)

plotshape(
     showSignalShapes and sellCondition,
     title="Optional Exhaustion Marker",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.new(tetradBlue, shapeAlpha),
     text="▼",
     textcolor=color.new(tetradBlue, 0),
     size=size.tiny
)

plotshape(
     showSignalShapes and bearishDivergence,
     title="Optional Bearish Divergence Marker",
     style=shape.diamond,
     location=location.abovebar,
     color=color.new(color.fuchsia, shapeAlpha),
     text="D",
     textcolor=color.new(color.fuchsia, 0),
     size=size.tiny
)

//────────────────────────────────────────────
// 10) OPTIONAL TRADE LABELS
//────────────────────────────────────────────
positionWas = strategy.position_size[1]
positionNow = strategy.position_size

if showPositionLabels and positionWas == 0 and positionNow > 0
    label.new(
         x=bar_index,
         y=low,
         text="LONG",
         style=label.style_label_up,
         color=color.new(tetradBlue, 0),
         textcolor=color.white,
         yloc=yloc.belowbar
    )

if showPositionLabels and positionWas == 0 and positionNow < 0
    label.new(
         x=bar_index,
         y=high,
         text="SHORT",
         style=label.style_label_down,
         color=color.new(color.fuchsia, 0),
         textcolor=color.white,
         yloc=yloc.abovebar
    )

if showPositionLabels and positionWas > 0 and positionNow == 0
    label.new(
         x=bar_index,
         y=high,
         text="EXIT LONG",
         style=label.style_label_down,
         color=color.white,
         textcolor=tetradBlue,
         yloc=yloc.abovebar
    )

if showPositionLabels and positionWas < 0 and positionNow == 0
    label.new(
         x=bar_index,
         y=low,
         text="EXIT SHORT",
         style=label.style_label_up,
         color=color.white,
         textcolor=color.fuchsia,
         yloc=yloc.belowbar
    )

//────────────────────────────────────────────
// 11) BRANDING LABEL
//────────────────────────────────────────────
var label brandLabel = na

if barstate.islast and showBranding
    if not na(brandLabel)
        label.delete(brandLabel)

    brandLabel := label.new(
         x=bar_index,
         y=na,
         text="Tetrad Elektro Community · Educational Open Source",
         style=label.style_label_upper_left,
         color=color.new(color.black, 0),
         textcolor=color.new(tetradBlue, 10),
         size=size.small,
         yloc=yloc.price,
         xloc=xloc.bar_index
    )

if barstate.islast and not showBranding and not na(brandLabel)
    label.delete(brandLabel)
    brandLabel := na

//────────────────────────────────────────────
// 12) ALERT CONDITIONS
//────────────────────────────────────────────
alertcondition(
     buyCondition,
     title="Elektro Long Setup",
     message="Tetrad Elektro Community: Long setup detected."
)

alertcondition(
     sellCondition,
     title="Elektro Long Exit / Short Exhaustion",
     message="Tetrad Elektro Community: Upper-band exhaustion detected."
)

alertcondition(
     shortCondition,
     title="Elektro Short Setup",
     message="Tetrad Elektro Community: Short setup detected."
)

alertcondition(
     shortExitCondition,
     title="Elektro Short Exit",
     message="Tetrad Elektro Community: Short exit condition detected."
)