//@version=6
// @description TODO: A library that allows you to draw a variety of EMA lines over on your chart.
library("EMA", overlay=true)

export A(int length, series float src = close) => 
	ta.ema(src, length)
export B(int length, series float src = close) => 
	ta.ema(src, length)
export C(int length, series float src = close) => 
	ta.ema(src, length)
export D(int length, series float src = close) => 
	ta.ema(src, length)
export E(int length, series float src = close) => 
	ta.ema(src, length)
export F(int length, series float src = close) => 
	ta.ema(src, length)