library('TRZigZagLib', overlay = true)

// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
// Constants
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

const int UP = 1
const int DOWN = -1
const int MAX_ZIGZAG_COUNT = 11

// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
// Types
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

// @type Pivot point in the chart
// @field d Direction: 1=high, -1=low
// @field x Bar index
// @field y Price
// @field confirmed Pivot confirmation flag
export type Pivot
	int d
	int x
	float y
	bool confirmed

// @type ZigZag configuration settings
// @field minLength Minimum pivot detection length
// @field minBarSize Minimum bars between pivots
// @field maxBarSize Maximum bars to lookback
// @field lineColor ZigZag line color
// @field lineWidth ZigZag line width
// @field lineStyle ZigZag line style
export type ZigZagSettings
    int minLength
    int minBarSize
    int maxBarSize
    color lineColor
    int lineWidth
    string lineStyle

// @type Single ZigZag instance
// @field settings Configuration settings
// @field pivots Array of pivot points (max 25 for patterns)
// @field lastUpdateBar Last bar index when updated
// @field depth Current depth value
export type ZigZag
	ZigZagSettings settings
	array<Pivot> pivots
	int lastUpdateBar
	int depth

// @type Multi-depth ZigZag manager
// @field zigzags Array of ZigZag instances (max 11)
// @field depthValues Array of depth values being used
// @field currentBar Current bar index being processed
export type MultiZigZag
    array<ZigZag> zigzags
    array<int> depthValues
    int currentBar

// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
// Pivot Methods
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

// @function Gets pivot direction as string
// @param this Pivot instance
// @returns "HIGH" or "LOW"
export method directionName(Pivot this) =>
    this.d == 1 ? "HIGH" : "LOW"

// @function Checks if pivot is a high
// @param this Pivot instance
// @returns true if pivot is a high
export method isHigh(Pivot this) =>
    this.d == 1

// @function Checks if pivot is a low
// @param this Pivot instance
// @returns true if pivot is a low
export method isLow(Pivot this) =>
    this.d == -1

// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
// ZigZagSettings Methods
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

// @function Creates default ZigZag settings
// @param minLength Minimum pivot length (default: 10)
// @param minBarSize Minimum bars between pivots (default: 5)
// @param maxBarSize Maximum bars to lookback (default: 300)
// @returns New ZigZagSettings instance
export method newSettings(int minLength = 10, int minBarSize = 5, int maxBarSize = 300) =>
    ZigZagSettings.new(
         minLength = minLength,
         minBarSize = minBarSize,
         maxBarSize = maxBarSize,
         lineColor = color.blue,
         lineWidth = 1,
         lineStyle = line.style_solid)

// @function Sets line appearance
// @param this Settings instance
// @param color Line color
// @param width Line width
// @param style Line style
// @returns Modified settings instance
export method setLineStyle(ZigZagSettings this, color lineColor, int lineWidth = 1, string lineStyle = line.style_solid) =>
    this.lineColor := lineColor
    this.lineWidth := lineWidth
    this.lineStyle := lineStyle
    this

// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
// ZigZag Core Methods
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

// @function Creates a new ZigZag instance
// @param settings ZigZag settings
// @param depth Depth value for this ZigZag
// @returns New ZigZag instance
export method newZigZag(ZigZagSettings settings, int depth) =>
    zz = ZigZag.new(
         settings = settings,
         pivots = array.new<Pivot>(),
         lastUpdateBar = bar_index,
         depth = depth)
    
    // Initialize with empty pivots (25 for 7-point patterns)
    for j = 0 to 24
        zz.pivots.unshift(Pivot.new(0, 0, high, false))
    
    zz

// @function Updates pivot in ZigZag array
// @param this ZigZag instance
// @param direction Direction (1 or -1)
// @param barIndex Bar index
// @param price Price
method updatePivot(ZigZag this, int direction, int barIndex, float price) =>
    this.pivots.unshift(Pivot.new(direction, barIndex, price, false))
    this.pivots.pop()
    this.lastUpdateBar := bar_index

// @function Calculates ZigZag using LuxAlgo-style pivot detection
// @param this ZigZag instance
export method calculate(ZigZag this) =>
    int left = this.depth
    int right = 1  // LuxAlgo style confirmation
    int n = bar_index
    
    // Detect pivot high
    ph = ta.pivothigh(high, left, right)
    
    // Detect pivot low
    pl = ta.pivotlow(low, left, right)
    
    // Process HIGH PIVOT
    if not na(ph)
        pivotBar = n - right
        pivotPrice = high[right]
        
        if this.pivots.size() > 0
            currentPiv = this.pivots.first()
            currentDir = currentPiv.d
            currentPrice = currentPiv.y
            
            // New high and price is higher
            if pivotPrice > currentPrice
                if currentDir < 1
                    // Direction change - add new pivot
                    this.updatePivot(1, pivotBar, pivotPrice)
                else
                    // Same direction - update if higher
                    if currentDir == 1 and ph > currentPrice
                        currentPiv.x := pivotBar
                        currentPiv.y := pivotPrice
        else
            // First pivot
            this.updatePivot(1, pivotBar, pivotPrice)
    
    // Process LOW PIVOT
    if not na(pl)
        pivotBar = n - right
        pivotPrice = low[right]
        
        if this.pivots.size() > 0
            currentPiv = this.pivots.first()
            currentDir = currentPiv.d
            currentPrice = currentPiv.y
            
            // New low and price is lower
            if pivotPrice < currentPrice
                if currentDir > -1
                    // Direction change - add new pivot
                    this.updatePivot(-1, pivotBar, pivotPrice)
                else
                    // Same direction - update if lower
                    if currentDir == -1 and pl < currentPrice
                        currentPiv.x := pivotBar
                        currentPiv.y := pivotPrice
        else
            // First pivot
            this.updatePivot(-1, pivotBar, pivotPrice)
    
    true

// @function Gets the last N pivots
// @param this ZigZag instance
// @param count Number of pivots to get (default: 5)
// @returns Array of pivots
export method getLastPivots(ZigZag this, int count = 5) =>
    result = array.new<Pivot>()
    maxCount = math.min(count, this.pivots.size())
    for i = 0 to maxCount - 1
        if i < this.pivots.size()
            result.push(this.pivots.get(i))
    result

// @function Gets pivot at index
// @param this ZigZag instance
// @param index Index (0 = most recent)
// @returns Pivot or na
export method getPivot(ZigZag this, int index) =>
    if index >= 0 and index < this.pivots.size()
        this.pivots.get(index)
    else
        na

// @function Truncates old pivots beyond lookback window
// @param this ZigZag instance
// @param maxBars Maximum bars to keep
export method truncate(ZigZag this, int maxBars) =>
    for i = this.pivots.size() - 1 to 0 by 2
        if i >= 0 and i < this.pivots.size()
            pivot = this.pivots.get(i)
            if bar_index - pivot.x <= maxBars
                break
            this.pivots.pop()
            if this.pivots.size() > 0
                this.pivots.pop()

// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
// MultiZigZag Methods
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

// @function Creates a new MultiZigZag manager
// @param settings Base settings for all ZigZags
// @param minDepth Minimum depth value
// @param maxDepth Maximum depth value
// @param count Number of ZigZag instances (max 11)
// @returns New MultiZigZag instance
export method newMultiZigZag(ZigZagSettings settings, int minDepth, int maxDepth, int count = 11) =>
    // Ensure count doesn't exceed maximum
    actualCount = math.min(count, MAX_ZIGZAG_COUNT)
    
    mzz = MultiZigZag.new(
         zigzags = array.new<ZigZag>(),
         depthValues = array.new<int>(),
         currentBar = bar_index)
    
    // Calculate depth values evenly distributed
    if actualCount == 1
        mzz.depthValues.push(minDepth)
    else
        step = (maxDepth - minDepth) / (actualCount - 1)
        for i = 0 to actualCount - 1
            depth = math.round(minDepth + i * step)
            mzz.depthValues.push(depth)
    
    // Create ZigZag instances
    for depth in mzz.depthValues
        zz = settings.newZigZag(depth)
        mzz.zigzags.push(zz)
    
    mzz

// @function Updates all ZigZag instances
// @param this MultiZigZag instance
export method calculateAll(MultiZigZag this) =>
    this.currentBar := bar_index
    for zz in this.zigzags
        zz.calculate()

// @function Gets ZigZag at index
// @param this MultiZigZag instance
// @param index Index (0 to count-1)
// @returns ZigZag instance or na
export method getZigZag(MultiZigZag this, int index) =>
    if index >= 0 and index < this.zigzags.size()
        this.zigzags.get(index)
    else
        na

// @function Gets depth value at index
// @param this MultiZigZag instance
// @param index Index (0 to count-1)
// @returns Depth value
export method getDepth(MultiZigZag this, int index) =>
    if index >= 0 and index < this.depthValues.size()
        this.depthValues.get(index)
    else
        na

// @function Gets total number of ZigZag instances
// @param this MultiZigZag instance
// @returns Count of ZigZag instances
export method size(MultiZigZag this) =>
    this.zigzags.size()

// @function Truncates all ZigZag instances
// @param this MultiZigZag instance
// @param maxBars Maximum bars to keep
export method truncateAll(MultiZigZag this, int maxBars) =>
    for zz in this.zigzags
        zz.truncate(maxBars)

// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
// Utility Functions
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

// @function Calculates distance between two pivots
// @param p1 First pivot
// @param p2 Second pivot
// @returns Price distance (absolute)
export method distance(Pivot p1, Pivot p2) =>
    math.abs(p1.y - p2.y)

// @function Calculates bar span between two pivots
// @param p1 First pivot
// @param p2 Second pivot
// @returns Bar span (absolute)
export method barSpan(Pivot p1, Pivot p2) =>
    math.abs(p1.x - p2.x)

// @function Checks if pivots are alternating (high-low-high or low-high-low)
// @param pivots Array of pivots
// @returns true if alternating pattern exists
export method isAlternating(array<Pivot> pivots) =>
    if pivots.size() < 2
        false
    else
        isValid = true
        for i = 1 to pivots.size() - 1
            if pivots.get(i).d == pivots.get(i - 1).d
                isValid := false
                break
        isValid
