//@version=6
indicator("BB Squeeze Breakout 21 SMA - Panel", overlay=false, max_labels_count=500)

// Inputs
length                  = input.int(21, "BB Length")
mult                    = input.float(2.0, "StdDev Multiplier")
strongSqueezePct        = input.float(5.0, "Strong Squeeze %", step=0.1)
weakSqueezePct          = input.float(10.0, "Weak Squeeze %", step=0.1)
useStrongFilter         = input.bool(false, "Use Stronger Breakout Filter")
useNextCandleConfirm    = input.bool(true, "Require Next Candle Confirmation")
breakoutBufferPct       = input.float(0.2, "Breakout Buffer %", step=0.1)
requireBandExpand       = input.bool(true, "Require Band Width Expansion")
signalSizeInput         = input.string("Normal", "Signal Size", options=["Tiny", "Small", "Normal", "Large", "Huge"])

// Size mapping
signalSize = signalSizeInput == "Tiny" ? size.tiny :
             signalSizeInput == "Small" ? size.small :
             signalSizeInput == "Large" ? size.large :
             signalSizeInput == "Huge" ? size.huge : size.normal

// Bollinger Bands using 21 SMA
basis = ta.sma(close, length)
dev   = mult * ta.stdev(close, length)
upper = basis + dev
lower = basis - dev

// Band width %
bandWidthPct = basis != 0 ? ((upper - lower) / basis) * 100 : na

// Squeeze zones
strongSqueeze = bandWidthPct <= strongSqueezePct
weakSqueeze   = bandWidthPct > strongSqueezePct and bandWidthPct <= weakSqueezePct

// Breakout rules
strongBuyBase  = barstate.isconfirmed and strongSqueeze[1] and close > upper and close[1] <= upper[1]
strongSellBase = barstate.isconfirmed and strongSqueeze[1] and close < lower and close[1] >= lower[1]

weakBuyBase    = barstate.isconfirmed and weakSqueeze[1] and close > upper and close[1] <= upper[1]
weakSellBase   = barstate.isconfirmed and weakSqueeze[1] and close < lower and close[1] >= lower[1]

// Optional stronger filter on breakout candle
strongFilterBuy  = close >= upper * (1 + breakoutBufferPct / 100) and close > open and (not requireBandExpand or bandWidthPct > bandWidthPct[1])
strongFilterSell = close <= lower * (1 - breakoutBufferPct / 100) and close < open and (not requireBandExpand or bandWidthPct > bandWidthPct[1])

strongBuyBreakout  = useStrongFilter ? (strongBuyBase and strongFilterBuy) : strongBuyBase
strongSellBreakout = useStrongFilter ? (strongSellBase and strongFilterSell) : strongSellBase
weakBuyBreakout    = useStrongFilter ? (weakBuyBase and strongFilterBuy) : weakBuyBase
weakSellBreakout   = useStrongFilter ? (weakSellBase and strongFilterSell) : weakSellBase

// Optional next-candle confirmation
strongBuySignal  = useNextCandleConfirm ? (barstate.isconfirmed and strongBuyBreakout[1] and close > close[1]) : strongBuyBreakout
strongSellSignal = useNextCandleConfirm ? (barstate.isconfirmed and strongSellBreakout[1] and close < close[1]) : strongSellBreakout
weakBuySignal    = useNextCandleConfirm ? (barstate.isconfirmed and weakBuyBreakout[1] and close > close[1]) : weakBuyBreakout
weakSellSignal   = useNextCandleConfirm ? (barstate.isconfirmed and weakSellBreakout[1] and close < close[1]) : weakSellBreakout

// Histogram colors
histColor = bandWidthPct <= strongSqueezePct ? color.lime : bandWidthPct <= weakSqueezePct ? color.blue : color.red

// Panel plots
hline(strongSqueezePct, "Strong Squeeze %", color=color.yellow, linestyle=hline.style_dashed)
hline(weakSqueezePct, "Weak Squeeze %", color=color.orange, linestyle=hline.style_dashed)
plot(bandWidthPct, "Band Width %", style=plot.style_histogram, color=histColor, linewidth=3)

// Background only on confirmed signals
bgColor = strongBuySignal ? color.new(color.green, 55) :
          weakBuySignal ? color.new(color.lime, 75) :
          strongSellSignal ? color.new(color.red, 55) :
          weakSellSignal ? color.new(color.maroon, 75) :
          na

bgcolor(bgColor)

// Chart labels
if strongBuySignal
    label.new(bar_index, low, "STRONG BUY", yloc=yloc.belowbar, style=label.style_label_up, color=color.green, textcolor=color.white, size=signalSize, force_overlay=true)

if weakBuySignal
    label.new(bar_index, low, "WEAK BUY", yloc=yloc.belowbar, style=label.style_label_up, color=color.lime, textcolor=color.black, size=signalSize, force_overlay=true)

if strongSellSignal
    label.new(bar_index, high, "STRONG SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=signalSize, force_overlay=true)

if weakSellSignal
    label.new(bar_index, high, "WEAK SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.maroon, textcolor=color.white, size=signalSize, force_overlay=true)

// Alerts
alertcondition(strongBuySignal, title="Strong Buy Alert", message="Strong BB Squeeze Breakout BUY")
alertcondition(weakBuySignal, title="Weak Buy Alert", message="Weak BB Squeeze Breakout BUY")
alertcondition(strongSellSignal, title="Strong Sell Alert", message="Strong BB Squeeze Breakout SELL")
alertcondition(weakSellSignal, title="Weak Sell Alert", message="Weak BB Squeeze Breakout SELL")
