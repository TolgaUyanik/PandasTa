//@version=6
library("BitLangLangData02", overlay=true)

const int baseMs = 1653004800000
const int baseMin = 27550080

type SummaryStore
    array<string> aSym
    array<int> aSeq
    array<int> aDir
    array<int> aLev
    array<int> aOpenT
    array<int> aCloseT
    array<float> aOpenP
    array<float> aCloseP
    array<float> aRet
    array<float> aPnl
    array<float> aMargin

type DetailStore
    array<int> aFillStart
    array<int> aFillCount
    array<int> aFillT
    array<float> aFillP
    array<float> aFillQ
    array<int> aFillAction

f_b36(string s) =>
    sign = str.startswith(s, "-") ? -1 : 1
    start = sign == -1 ? 1 : 0
    value = 0
    for i = start to str.length(s) - 1
        ch = str.substring(s, i, i + 1)
        pos = str.pos("0123456789abcdefghijklmnopqrstuvwxyz", ch)
        value := value * 36 + pos
    value * sign

f_summary(string pair, int priceScale, string chunk, SummaryStore store) =>
    rows = str.split(chunk, ";")
    for rowNo = 0 to array.size(rows) - 1
        row = array.get(rows, rowNo)
        if str.length(row) > 0
            cols = str.split(row, ",")
            seq = f_b36(array.get(cols, 0))
            signedLev = f_b36(array.get(cols, 1))
            openMin = baseMin + f_b36(array.get(cols, 2))
            closeMin = openMin + f_b36(array.get(cols, 3))
            openPriceInt = f_b36(array.get(cols, 4))
            array.push(store.aSym, pair)
            array.push(store.aSeq, seq)
            array.push(store.aDir, signedLev > 0 ? 1 : -1)
            array.push(store.aLev, math.abs(signedLev))
            array.push(store.aOpenT, baseMs + openMin * 60000)
            array.push(store.aCloseT, baseMs + closeMin * 60000)
            array.push(store.aOpenP, openPriceInt / priceScale)
            array.push(store.aCloseP, (openPriceInt + f_b36(array.get(cols, 5))) / priceScale)
            array.push(store.aRet, f_b36(array.get(cols, 6)) / 100.0)
            array.push(store.aPnl, f_b36(array.get(cols, 7)) / 100.0)
            array.push(store.aMargin, f_b36(array.get(cols, 8)) / 100.0)

f_details(int priceScale, int sizeScale, string chunk, DetailStore store) =>
    trades = str.split(chunk, "!")
    for tradeNo = 0 to array.size(trades) - 1
        trade = array.get(trades, tradeNo)
        if str.length(trade) > 0
            parts = str.split(trade, "|")
            currentMin = baseMin + f_b36(array.get(parts, 0))
            array.push(store.aFillStart, array.size(store.aFillT))
            items = str.split(array.get(parts, 1), ";")
            itemCount = 0
            for itemNo = 0 to array.size(items) - 1
                item = array.get(items, itemNo)
                if str.length(item) > 0
                    cols = str.split(item, ",")
                    currentMin += f_b36(array.get(cols, 0))
                    array.push(store.aFillT, baseMs + currentMin * 60000)
                    array.push(store.aFillP, f_b36(array.get(cols, 1)) / priceScale)
                    array.push(store.aFillQ, f_b36(array.get(cols, 2)) / sizeScale)
                    array.push(store.aFillAction, f_b36(array.get(cols, 3)))
                    itemCount += 1
            array.push(store.aFillCount, itemCount)

