// ╔══════════════════════════════════════════════╗
// ║  Kyber Cell • TTM WAVE-A                     ║
// ║  John Carter’s “Wave A” (MACD 8 / 34)        ║
// ║  Pine Script™ v6 | Non-overlay (separate pane) ║
// ╠══════════════════════════════════════════════╣
// ║  • Shows the fast wave of Carter’s TTM-Wave. ║
// ║  • Histogram = EMA(8) − EMA(34) (no signal). ║
// ║  • Same four-colour logic used in Squeeze Pro║
// ║      Rising & >0  ⇒ aqua → blue              ║
// ║      Falling & <0 ⇒ yellow → red             ║
// ╚══════════════════════════════════════════════╝

//@version=6
indicator("Kyber Cell's – TTM Wave A", overlay = false, max_bars_back = 200)

// ── user inputs
fastLen   = input.int(8 , "Fast EMA length")
slowLen   = input.int(34, "Slow EMA length")
zeroColor = input.color(color.gray, "Zero-line colour")

// ── Wave-A calculation  (MACD with signal length = 1)
wave = ta.ema(close, fastLen) - ta.ema(close, slowLen)

// ── colour scheme (matches Squeeze-Pro)
histColor = wave > 0
     ? (wave > nz(wave[1]) ? color.aqua   : color.blue )
     : (wave < nz(wave[1]) ? color.red    : color.yellow)

// ── plots
plot(wave,  title = "Wave A", style = plot.style_histogram,
     color = histColor, linewidth = 3)
plot(0,     title = "Zero",   color = zeroColor,  linewidth = 1)