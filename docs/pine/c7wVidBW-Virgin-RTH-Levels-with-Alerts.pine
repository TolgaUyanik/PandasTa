//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Virgin RTH Levels — PD / PW / PM / YTD Highs & Lows
//
// • Marks every prior day's RTH (09:30–16:00 NY) High/Low and keeps the line
//   only while the level is VIRGIN (never touched during a later RTH session).
// • Prior-week RTH High/Low  → thicker line
// • Prior-month RTH High/Low → thicker line
// • YTD RTH High/Low         → thickest line (running extremes of the year)
// • Alerts fire in ALL sessions (RTH + ETH). An ETH touch alerts but does NOT
//   remove virgin status; only an RTH touch clears the level.
//
// USAGE
// 1. Apply to an INTRADAY chart. Turn ON extended hours (chart settings) if
//    you want ETH touch alerts.
// 2. Create alert → Condition: this indicator → "Any alert() function call"
//    for dynamic per-level messages (recommended), or pick one of the three
//    alertcondition entries (any / RTH-only / ETH-only).
// ─────────────────────────────────────────────────────────────────────────────
indicator("Virgin RTH Levels — PD/PW/PM/YTD Highs & Lows", "Virgin RTH HL", overlay = true, max_lines_count = 500, max_labels_count = 500)

if not timeframe.isintraday
    runtime.error("Virgin RTH Levels requires an intraday chart timeframe.")

// ─── Inputs ───
string GRP_S = "Session"
sessStr = input.session("0930-1600", "RTH session", group = GRP_S)
tz      = input.string("America/New_York", "Session timezone", group = GRP_S)

string GRP_A = "Alerts"
alertRTH = input.bool(true, "Alert on touches during RTH", group = GRP_A)
alertETH = input.bool(true, "Alert on touches during ETH", group = GRP_A)

string GRP_V = "Visuals"
showLbl  = input.bool(true,  "Show level labels", group = GRP_V)
lblSize  = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal", "Large"], group = GRP_V)
keepDead = input.bool(false, "Keep touched levels on chart (dotted)", group = GRP_V)
showWk = input.bool(true, "Show weekly levels",  group = GRP_V)
showMo = input.bool(true, "Show monthly levels", group = GRP_V)
showYr = input.bool(true, "Show YTD levels",     group = GRP_V)
showHB = input.bool(true, "Show prior-day halfback (50% of RTH range)", group = GRP_V)

string GRP_L = "Lookback"
dBack = input.int(20, "Days to look back (daily levels)",    minval = 1, group = GRP_L, tooltip = "Trading days. 1 = only the prior session's High/Low")
wBack = input.int(12, "Weeks to look back (weekly levels)",  minval = 1, group = GRP_L)
mBack = input.int(12, "Months to look back (monthly levels)", minval = 1, group = GRP_L)

string OPT_SOLID = "Solid"
string OPT_DASH  = "Dashed"
string OPT_DOT   = "Dotted"

colDH = input.color(color.orange, "Daily High ", inline = "dh", group = GRP_V)
wDH   = input.int(1, "", minval = 1, maxval = 10, inline = "dh", group = GRP_V)
sDH   = input.string(OPT_SOLID, "", options = [OPT_SOLID, OPT_DASH, OPT_DOT], inline = "dh", group = GRP_V)
colDL = input.color(color.orange, "Daily Low  ", inline = "dl", group = GRP_V)
wDL   = input.int(1, "", minval = 1, maxval = 10, inline = "dl", group = GRP_V)
sDL   = input.string(OPT_SOLID, "", options = [OPT_SOLID, OPT_DASH, OPT_DOT], inline = "dl", group = GRP_V)

colWH = input.color(color.teal, "Weekly High", inline = "wh", group = GRP_V)
wWH   = input.int(2, "", minval = 1, maxval = 10, inline = "wh", group = GRP_V)
sWH   = input.string(OPT_SOLID, "", options = [OPT_SOLID, OPT_DASH, OPT_DOT], inline = "wh", group = GRP_V)
colWL = input.color(color.teal, "Weekly Low ", inline = "wl", group = GRP_V)
wWL   = input.int(2, "", minval = 1, maxval = 10, inline = "wl", group = GRP_V)
sWL   = input.string(OPT_SOLID, "", options = [OPT_SOLID, OPT_DASH, OPT_DOT], inline = "wl", group = GRP_V)

colMH = input.color(color.purple, "Monthly High", inline = "mh", group = GRP_V)
wMH   = input.int(3, "", minval = 1, maxval = 10, inline = "mh", group = GRP_V)
sMH   = input.string(OPT_SOLID, "", options = [OPT_SOLID, OPT_DASH, OPT_DOT], inline = "mh", group = GRP_V)
colML = input.color(color.purple, "Monthly Low ", inline = "ml", group = GRP_V)
wML   = input.int(3, "", minval = 1, maxval = 10, inline = "ml", group = GRP_V)
sML   = input.string(OPT_SOLID, "", options = [OPT_SOLID, OPT_DASH, OPT_DOT], inline = "ml", group = GRP_V)

colYH = input.color(color.red, "YTD High", inline = "yh", group = GRP_V)
wYH   = input.int(5, "", minval = 1, maxval = 10, inline = "yh", group = GRP_V)
sYH   = input.string(OPT_SOLID, "", options = [OPT_SOLID, OPT_DASH, OPT_DOT], inline = "yh", group = GRP_V)
colYL = input.color(color.red, "YTD Low ", inline = "yl", group = GRP_V)
wYL   = input.int(5, "", minval = 1, maxval = 10, inline = "yl", group = GRP_V)
sYL   = input.string(OPT_SOLID, "", options = [OPT_SOLID, OPT_DASH, OPT_DOT], inline = "yl", group = GRP_V)
colHB = input.color(color.yellow, "Daily 50%", inline = "hb", group = GRP_V)
wHB   = input.int(1, "", minval = 1, maxval = 10, inline = "hb", group = GRP_V)
sHB   = input.string(OPT_DASH, "", options = [OPT_SOLID, OPT_DASH, OPT_DOT], inline = "hb", group = GRP_V)

// ─── Level object ───
type Level
    float price
    int   kind      // 0 = Daily, 1 = Weekly, 2 = Monthly, 3 = YTD
    bool  isHigh
    line  ln
    label lb
    int   born
    int   lastTouch
    int   seq       // day/week/month counter value at creation (for lookback pruning)

var levels = array.new<Level>()
var Level ytdHi = na
var Level ytdLo = na

var float dHi = na
var float dLo = na
var float wHi = na
var float wLo = na
var float mHi = na
var float mLo = na

var int dayCount   = 0
var int weekCount  = 0
var int monthCount = 0

var int dStartT = na    // time of the first RTH bar of the current day / week / month
var int wStartT = na
var int mStartT = na

kindName(int k, bool isH) =>
    k == 4 ? "PD50" : (k == 0 ? "PD" : k == 1 ? "PW" : k == 2 ? "PM" : "YTD") + (isH ? "H" : "L")

kindColor(int k, bool isH) =>
    k == 0 ? (isH ? colDH : colDL) : k == 1 ? (isH ? colWH : colWL) : k == 2 ? (isH ? colMH : colML) : k == 3 ? (isH ? colYH : colYL) : colHB

kindWidth(int k, bool isH) =>
    k == 0 ? (isH ? wDH : wDL) : k == 1 ? (isH ? wWH : wWL) : k == 2 ? (isH ? wMH : wML) : k == 3 ? (isH ? wYH : wYL) : wHB

styleOf(string s) =>
    s == OPT_SOLID ? line.style_solid : s == OPT_DASH ? line.style_dashed : line.style_dotted

kindStyle(int k, bool isH) =>
    styleOf(k == 0 ? (isH ? sDH : sDL) : k == 1 ? (isH ? sWH : sWL) : k == 2 ? (isH ? sMH : sML) : k == 3 ? (isH ? sYH : sYL) : sHB)

lblSizeOf() =>
    lblSize == "Tiny" ? size.tiny : lblSize == "Small" ? size.small : lblSize == "Normal" ? size.normal : size.large

newLevel(float price, int k, bool isH, int x1t) =>
    color c = kindColor(k, isH)
    line ln = line.new(x1t, price, x1t + 1, price, xloc = xloc.bar_time, extend = extend.right, color = c, width = kindWidth(k, isH), style = kindStyle(k, isH))
    label lb = na
    if showLbl
        lb := label.new(x1t, price, kindName(k, isH) + "  " + str.tostring(price, format.mintick), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 88), textcolor = c, size = lblSizeOf())
    Level.new(price, k, isH, ln, lb, bar_index, -10, (k == 0 or k == 4) ? dayCount : k == 1 ? weekCount : k == 2 ? monthCount : 0)

addLevel(float price, int k, bool isH, int x1t) =>
    levels.push(newLevel(price, k, isH, x1t))
    if levels.size() > 480    // internal safety cap (TradingView drawing limit)
        Level old = levels.shift()
        old.ln.delete()
        if not na(old.lb)
            old.lb.delete()

killLevel(Level lv) =>
    if keepDead
        lv.ln.set_extend(extend.none)
        lv.ln.set_x2(time)
        lv.ln.set_style(line.style_dotted)
        lv.ln.set_width(1)
        if not na(lv.lb)
            lv.lb.set_textcolor(color.new(color.gray, 40))
            lv.lb.set_color(color.new(color.gray, 95))
    else
        lv.ln.delete()
        if not na(lv.lb)
            lv.lb.delete()

// ─── Session / calendar state ───
bool inRTH  = not na(time(timeframe.period, sessStr, tz))
bool rthEnd = not inRTH and inRTH[1]

bool newDay   = nz(ta.change(time("D")), 0)   != 0
bool newWeek  = nz(ta.change(time("W")), 0)   != 0
bool newMonth = nz(ta.change(time("M")), 0)   != 0
bool newYear  = nz(ta.change(time("12M")), 0) != 0

if newDay
    dayCount += 1
if newWeek
    weekCount += 1
if newMonth
    monthCount += 1

// ─── Finalize completed periods into virgin levels ───
// Daily: at RTH close (or at day change on RTH-only charts)
if (rthEnd or (inRTH and newDay)) and not na(dHi)
    addLevel(dHi, 0, true, dStartT)
    addLevel(dLo, 0, false, dStartT)
    if showHB
        addLevel((dHi + dLo) / 2, 4, true, dStartT)
    dHi := na
    dLo := na

// Weekly: on the first bar of a new week (Sunday ETH open on futures)
if newWeek and not na(wHi)
    if showWk
        addLevel(wHi, 1, true, wStartT)
        addLevel(wLo, 1, false, wStartT)
    wHi := na
    wLo := na

// Monthly: on the first bar of a new month
if newMonth and not na(mHi)
    if showMo
        addLevel(mHi, 2, true, mStartT)
        addLevel(mLo, 2, false, mStartT)
    mHi := na
    mLo := na

// Prune virgin levels older than the lookback (counted in trading days / weeks / months)
if newDay and levels.size() > 0
    for i = levels.size() - 1 to 0
        Level lv = levels.get(i)
        int age = (lv.kind == 0 or lv.kind == 4) ? dayCount - lv.seq : lv.kind == 1 ? weekCount - lv.seq : monthCount - lv.seq
        int lim = (lv.kind == 0 or lv.kind == 4) ? dBack : lv.kind == 1 ? wBack : mBack
        if age > lim
            lv.ln.delete()
            if not na(lv.lb)
                lv.lb.delete()
            levels.remove(i)

// New year: reset the YTD tracker
if newYear
    if not na(ytdHi)
        ytdHi.ln.delete()
        if not na(ytdHi.lb)
            ytdHi.lb.delete()
    if not na(ytdLo)
        ytdLo.ln.delete()
        if not na(ytdLo.lb)
            ytdLo.lb.delete()
    ytdHi := na
    ytdLo := na

// ─── Touch detection ───
bool anyRTHtouch = false
bool anyETHtouch = false
bool tPDH  = false
bool tPDL  = false
bool tPWH  = false
bool tPWL  = false
bool tPMH  = false
bool tPML  = false
bool tYTDH = false
bool tYTDL = false
bool tPDHB = false

if levels.size() > 0
    for i = levels.size() - 1 to 0
        Level lv = levels.get(i)
        if high >= lv.price and low <= lv.price
            if lv.kind == 0
                if lv.isHigh
                    tPDH := true
                else
                    tPDL := true
            else if lv.kind == 1
                if lv.isHigh
                    tPWH := true
                else
                    tPWL := true
            else if lv.kind == 2
                if lv.isHigh
                    tPMH := true
                else
                    tPML := true
            else if lv.kind == 4
                tPDHB := true
            bool fresh = (inRTH or bar_index > lv.born) and bar_index > lv.lastTouch + 1
            if inRTH
                // RTH touch: alert + virgin status lost
                anyRTHtouch := true
                if alertRTH and fresh
                    alert(str.format("{0}: virgin {1} {2} hit during RTH — level cleared", syminfo.ticker, kindName(lv.kind, lv.isHigh), str.tostring(lv.price, format.mintick)), alert.freq_once_per_bar)
                killLevel(lv)
                levels.remove(i)
            else
                // ETH touch: alert only, virgin status preserved
                anyETHtouch := true
                if alertETH and fresh
                    alert(str.format("{0}: virgin {1} {2} tagged during ETH — virgin status preserved", syminfo.ticker, kindName(lv.kind, lv.isHigh), str.tostring(lv.price, format.mintick)), alert.freq_once_per_bar)
                lv.lastTouch := bar_index

// YTD levels: alert on touch, never removed (running RTH extremes of the year)
if not na(ytdHi) and high >= ytdHi.price and low <= ytdHi.price and bar_index > ytdHi.born
    bool fresh = bar_index > ytdHi.lastTouch + 1
    tYTDH := true
    if inRTH
        anyRTHtouch := true
    else
        anyETHtouch := true
    if fresh and (inRTH ? alertRTH : alertETH)
        alert(str.format("{0}: YTD RTH High {1} touched ({2})", syminfo.ticker, str.tostring(ytdHi.price, format.mintick), inRTH ? "RTH" : "ETH"), alert.freq_once_per_bar)
    ytdHi.lastTouch := bar_index

if not na(ytdLo) and high >= ytdLo.price and low <= ytdLo.price and bar_index > ytdLo.born
    bool fresh = bar_index > ytdLo.lastTouch + 1
    tYTDL := true
    if inRTH
        anyRTHtouch := true
    else
        anyETHtouch := true
    if fresh and (inRTH ? alertRTH : alertETH)
        alert(str.format("{0}: YTD RTH Low {1} touched ({2})", syminfo.ticker, str.tostring(ytdLo.price, format.mintick), inRTH ? "RTH" : "ETH"), alert.freq_once_per_bar)
    ytdLo.lastTouch := bar_index

// ─── Accumulate RTH extremes ───
if inRTH
    if na(dHi)
        dStartT := time
    if na(wHi)
        wStartT := time
    if na(mHi)
        mStartT := time
    dHi := na(dHi) ? high : math.max(dHi, high)
    dLo := na(dLo) ? low  : math.min(dLo, low)
    wHi := na(wHi) ? high : math.max(wHi, high)
    wLo := na(wLo) ? low  : math.min(wLo, low)
    mHi := na(mHi) ? high : math.max(mHi, high)
    mLo := na(mLo) ? low  : math.min(mLo, low)

    if showYr
        if na(ytdHi)
            ytdHi := newLevel(high, 3, true, time)
            ytdLo := newLevel(low, 3, false, time)
        else
            if high > ytdHi.price
                ytdHi.price := high
                ytdHi.ln.set_y1(high)
                ytdHi.ln.set_y2(high)
                if not na(ytdHi.lb)
                    ytdHi.lb.set_y(high)
                    ytdHi.lb.set_text("YTDH  " + str.tostring(high, format.mintick))
            if low < ytdLo.price
                ytdLo.price := low
                ytdLo.ln.set_y1(low)
                ytdLo.ln.set_y2(low)
                if not na(ytdLo.lb)
                    ytdLo.lb.set_y(low)
                    ytdLo.lb.set_text("YTDL  " + str.tostring(low, format.mintick))

// ─── Native alert hooks (Create Alert dialog — messages are editable there, placeholders like {{ticker}}, {{close}}, {{interval}}, {{timenow}} supported) ───
alertcondition(anyRTHtouch or anyETHtouch, "Any virgin level touched (any session)", "{{ticker}}: price touched a virgin RTH level ({{close}})")
alertcondition(anyRTHtouch, "Any virgin level touched (RTH only)", "{{ticker}}: virgin RTH level touched during regular hours — level cleared ({{close}})")
alertcondition(anyETHtouch, "Any virgin level touched (ETH only)", "{{ticker}}: virgin RTH level tagged during extended hours — virgin status preserved ({{close}})")
alertcondition(tPDH,  "Prior-Day High touched",    "{{ticker}}: virgin Prior-Day High touched ({{close}})")
alertcondition(tPDL,  "Prior-Day Low touched",     "{{ticker}}: virgin Prior-Day Low touched ({{close}})")
alertcondition(tPWH,  "Prior-Week High touched",   "{{ticker}}: virgin Prior-Week High touched ({{close}})")
alertcondition(tPWL,  "Prior-Week Low touched",    "{{ticker}}: virgin Prior-Week Low touched ({{close}})")
alertcondition(tPMH,  "Prior-Month High touched",  "{{ticker}}: virgin Prior-Month High touched ({{close}})")
alertcondition(tPML,  "Prior-Month Low touched",   "{{ticker}}: virgin Prior-Month Low touched ({{close}})")
alertcondition(tYTDH, "YTD High touched",          "{{ticker}}: YTD RTH High touched ({{close}})")
alertcondition(tYTDL, "YTD Low touched",           "{{ticker}}: YTD RTH Low touched ({{close}})")
alertcondition(tPDHB, "Prior-Day Halfback (50%) touched", "{{ticker}}: virgin Prior-Day Halfback touched ({{close}})")