// バージョン履歴
// 1 : 2026-06-23 新規作成（nstream.pine のMAリボン描画を抜き出し）
// 2 : 2026-07-24 公開

//@version=6
indicator('MA ribbon', shorttitle = 'MA ribbon', overlay = true)

// MA 1（短期）
string GroupMA1 = 'MA 1'
ma_len1 = input.int(defval = 20, title = '期間', group = GroupMA1, inline = GroupMA1)
upcolor1 = input.color(defval = color.red, title = '上昇', group = GroupMA1, inline = 'GroupMA12')
upcolor2 = input.color(defval = color.blue, title = '下降', group = GroupMA1, inline = 'GroupMA12')
upcolor3 = input.color(defval = color.yellow, title = '見なし平行', group = GroupMA1, inline = 'GroupMA12')
lw1 = input.int(defval = 1, title = '太さ', minval = 1, maxval = 5, group = GroupMA1, inline = GroupMA1)
ma_type1 = input.string(defval = 'SMA', title = 'MA種類', options = ['SMA', 'WMA', 'HMA'], group = GroupMA1)
gosa = input.float(defval = 0.3, title = '見なし平行閾値', group = GroupMA1)

// MA 2
string GroupMA2 = 'MA 2'
ma_len2 = input.int(defval = 40, title = '期間', group = GroupMA2, inline = GroupMA2)
color2 = input.color(defval = color.blue, title = '色', group = GroupMA2, inline = GroupMA2)
lw2 = input.int(defval = 1, title = '太さ', minval = 1, maxval = 5, group = GroupMA2, inline = GroupMA2)

// MA 3
string GroupMA3 = 'MA 3'
ma_len3 = input.int(defval = 75, title = '期間', group = GroupMA3, inline = GroupMA3)
color3 = input.color(defval = color.orange, title = '色', group = GroupMA3, inline = GroupMA3)
lw3 = input.int(defval = 1, title = '太さ', minval = 1, maxval = 5, group = GroupMA3, inline = GroupMA3)

// MA 4（長期）
string GroupMA4 = 'MA 4'
ma_len4 = input.int(defval = 200, title = '期間', group = GroupMA4, inline = GroupMA4)
color4 = input.color(defval = color.green, title = '色', group = GroupMA4, inline = GroupMA4)
lw4 = input.int(defval = 1, title = '太さ', minval = 1, maxval = 5, group = GroupMA4, inline = GroupMA4)

// 20/40 リボン
string GroupRibbon2040 = 'MA 1/MA 2 リボン'
color_up = input.color(defval = color.new(#FFB6C1, 10), title = '上昇', group = GroupRibbon2040, inline = GroupRibbon2040)
color_down = input.color(defval = color.new(#87CEFA, 10), title = '下降', group = GroupRibbon2040, inline = GroupRibbon2040)

// 75/200 リボン
string GroupRibbon75200 = 'MA 3/MA 4 リボン'
color_up75200 = input.color(defval = color.new(#FFFF00, 90), title = '上昇', group = GroupRibbon75200, inline = GroupRibbon75200)
color_down75200 = input.color(defval = color.new(#90EE90, 90), title = '下降', group = GroupRibbon75200, inline = GroupRibbon75200)

// 確定足方式
currentClose = barstate.isconfirmed ? close : close[1]
src = currentClose

// MA計算
ma1 = ma_type1 == 'HMA' ? ta.hma(src, ma_len1) : ma_type1 == 'WMA' ? ta.wma(src, ma_len1) : ta.sma(src, ma_len1)
ma2 = ta.sma(src, ma_len2)
ma3 = ta.ema(src, ma_len3)
ma4 = ta.sma(src, ma_len4)

// 色判定（20MAの方向で色を切替：横ばい=黄、上昇=赤、下降=青）
gosa_value = gosa * syminfo.mintick * 10
color1 = math.abs(ma1 - ma1[1]) <= gosa_value ? upcolor3 : ma1 > ma1[1] ? upcolor1 : ma1 < ma1[1] ? upcolor2 : color.white

// 描画
plt1 = plot(ma1, color = color1, title = '20 MA', linewidth = lw1)
plt2 = plot(ma2, color = color2, title = '40 SMA', linewidth = lw2)
plt3 = plot(ma3, color = color3, title = '75 EMA', linewidth = lw3)
plt4 = plot(ma4, color = color4, title = '200 SMA', linewidth = lw4)
flag_ma_75200 = ma3 > ma4
fill(plt3, plt4, flag_ma_75200 ? color_up75200 : color_down75200, title = '75/200 MA ribbon')
flag_ma = ma1 > ma2
fill(plt1, plt2, flag_ma ? color_up : color_down, title = '20/40 MA ribbon')
