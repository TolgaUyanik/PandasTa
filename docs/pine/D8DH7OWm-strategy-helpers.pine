//@version=5

// @description Provides tools for calculating risk metrics across different types of trading strategies including equities, futures, and forex. Functions allow for precise control over risk management by calculating the number of units or contracts to trade, the value at risk, and the total position value based on entry prices, stop levels, and desired risk percentage. Additional utilities include automatic risk calculation based on asset type, leverage level calculations, and determination of liquidation levels for leveraged trades.
library("strategy_helpers")

// risk {

// @function Calculates risk metrics for equity trades based on entry, stop level, and risk percent
// @param entry The price at which the position is entered. Use close if you arent adding to a position. Use the original entry price if you are adding to a position.
// @param stop_level The price level where the stop loss is placed
// @param stop_range The price range from entry to stop level
// @param capital The total capital available for trading
// @param risk_percent The percentage of capital risked on the trade. 100% is represented by 100.
// @param trade_direction True for long trades, false for short trades
// @param whole_number_buy True to adjust the quantity to whole numbers
// @returns A tuple containing the number of units to trade, the value at risk, and the total value of the position: [number_of_underlying, value_of_risk, value_of_position]
export calculate_risk(float entry, float stop_level, float stop_range, float capital, float risk_percent, bool trade_direction, bool whole_number_buy)=>
	float risk = trade_direction ? stop_range / stop_level : stop_range / entry // Percent risk of stop range.
	float risk_adjustment = risk_percent / 100 / risk // Percent of capital to use to achieve risk percent for a given range. risk_percent is corrected as the argument takes a percent value.
	float risk_capital = capital * risk_adjustment // Amount of portfolio to risk.
	float raw_number_of_underlying = risk_capital / close // Unadjusted number of underlying.
	float number_of_underlying = whole_number_buy ? raw_number_of_underlying : math.floor(raw_number_of_underlying) // Rounded number of underlying if applicable.
	float correction = number_of_underlying / raw_number_of_underlying // Correction coefficient
	float value_of_position = risk_capital * correction // Adjusted risk capital to reflect whole number trade.
	float value_of_risk = value_of_position * risk // Value of trade.
	[number_of_underlying, value_of_risk, value_of_position]

// @function Calculates risk metrics for futures trades based on the risk capital and stop range
// @param risk_capital The capital allocated for the trade
// @param stop_range The price range from entry to stop level
// @returns A tuple containing the number of contracts to trade, the value at risk, and the total value of the position: [contracts, value_of_risk, value_of_position]
export calculate_risk_futures(float risk_capital, float stop_range)=>
    float tick_in_point = 1 / syminfo.mintick // Number of ticks in a point.
    float tick_value  = syminfo.pointvalue / tick_in_point // Value of a tick.
    float change_rounded = math.round_to_mintick(stop_range) // Stop range
    float amount_of_ticks = change_rounded / syminfo.mintick // Number of ticks in stop range.
    float move_value = amount_of_ticks * tick_value // Value of stop range.

    int contracts = math.floor(risk_capital / move_value) // Number of contracts to achieve risk value.
    float value_of_risk = move_value * contracts // Value of range.
    float value_of_position = close * syminfo.pointvalue * contracts // Value of position.
    [contracts, value_of_risk, value_of_position]

// @function Calculates risk metrics for forex trades based on entry, stop level, and risk percent
// @param entry The price at which the position is entered. Use close if you arent adding to a position. Use the original entry price if you are adding to a position.
// @param stop_level The price level where the stop loss is placed
// @param stop_range The price range from entry to stop level
// @param capital The total capital available for trading
// @param risk_percent The percentage of capital risked on the trade. 100% is represented by 100.
// @param trade_direction True for long trades, false for short trades
// @returns A tuple containing the number of lots to trade, the value at risk, and the total value of the position: [number_of_underlying, value_of_risk, value_of_position]
export calculate_risk_forex(float entry, float stop_level, float stop_range, float capital, float risk_percent, bool trade_direction)=>
	float standard_lot = 100000

	float risk = trade_direction ? stop_range / stop_level : stop_range / entry // Percent risk of stop range.
	float risk_adjustment = risk_percent / 100 / risk // Percent of capital to use to achieve risk percent for a given range. risk_percent is corrected as the argument takes a percent value.
	float value_of_position = capital * risk_adjustment // Amount of portfolio to risk.
	float number_of_underlying = value_of_position / (close * standard_lot) 
	float value_of_risk = value_of_position * risk // Value of trade.
	[number_of_underlying, value_of_risk, value_of_position]

// @function Automatically selects the risk calculation method based on the asset type and calculates risk metrics
// @param entry The price at which the position is entered. Use close if you arent adding to a position. Use the original entry price if you are adding to a position.
// @param stop_level The price level where the stop loss is placed
// @param stop_range The price range from entry to stop level
// @param capital The total capital available for trading
// @param risk_percent The percentage of capital risked on the trade. 100% is represented by 100.
// @param trade_direction True for long trades, false for short trades
// @param whole_number_buy True to adjust the quantity to whole numbers, applicable only for non-futures and non-forex trades
// @returns A tuple containing the number of units or contracts to trade, the value at risk, and the total value of the position: [number_of_underlying, value_of_risk, value_of_position]
export calculate_risk_auto(float entry, float stop_level, float stop_range, float capital, float risk_percent, bool trade_direction, bool whole_number_buy)=>
	if syminfo.type == "futures"
		float risk_capital = capital * (risk_percent / 100)
		[contracts, value_of_risk, value_of_position] = calculate_risk_futures(risk_capital, stop_range)

	else if syminfo.type == "forex"
		[number_of_underlying, value_of_risk, value_of_position] = calculate_risk_forex(entry, stop_level, stop_range, capital, risk_percent, trade_direction)

	else
		[number_of_underlying, value_of_risk, value_of_position] = calculate_risk(entry, stop_level, stop_range, capital, risk_percent, trade_direction, whole_number_buy)

// }

// liquidation {

// @function Calculates the leverage level used based on account equity and position value
// @param account_equity Total equity in the trading account
// @param position_value Total value of the position taken
// @returns The leverage level used in the trade
export leverage_level(float account_equity, float position_value)=>
	position_value / account_equity

// @function Calculates the liquidation price level for a leveraged trade
// @param entry The price at which the position is entered
// @param leverage The leverage level used in the trade
// @param trade_direction True for long trades, false for short trades
// @param maintenance_margine The maintenance margin requirement, expressed as a percentage
// @returns The price level at which the position would be liquidated, or na if leverage is zero
export calculate_liquidation_level(float entry, float leverage, bool trade_direction, float maintenance_margine = 0)=>
    float L = 1 / leverage // Reciprocal of leverage level.
    float MM = 1 - (maintenance_margine / 100) // Maintenance margine adjustment.
    float liquidation_level = 0
    if leverage > 0 // if leverage is greater than 0 calculate liquidation level.
        if trade_direction
            liquidation_level := entry * (1 - (L * MM))
        else
            liquidation_level := entry * (1 + (L * MM))

        math.max(0, liquidation_level)
	else
		float(na)

// }

// example {

float capital = input.float(10000, "Capital", minval = 0)
float risk_percent = input.float(1, "Risk Capital", minval = 0, step = 0.1)
float stop_range_percent = close * (input.float(1, "Stop Range Percent", minval = 0, step = 0.1) / 100)
bool show_value_of_position = input.bool(false, "Show Value of Position and Liquidation Level")

float risk_capital = capital * (risk_percent / 100)
[contracts, value_of_risk, value_of_position] = calculate_risk_futures(risk_capital, stop_range_percent)

float leverage_level = leverage_level(capital, value_of_position) 
float liquidation_level = calculate_liquidation_level(close, leverage_level, true, 0)

plot(show_value_of_position ? na : contracts, "Contracts")
plot(show_value_of_position ? value_of_position : value_of_risk, "Value of Risk / Value of Position", color.red)
plot(show_value_of_position ? liquidation_level : leverage_level, "Leverage / Liquidation Level", color.green)

// }
