// For forex presets: use lots input instead of contracts
// p_lots is the effective size for XAUUSD/EURUSD — ignored for all futures presets
// For forex presets: lot size depends on trading mode
// Ghost mode    → auto-calculated from fixed $ risk input
// TV Native     → manual lot size from i_lots input
// Futures       → p_qty (integer contracts, i_lots ignored)
p_isForex = i_preset == 'XAUUSD' or i_preset == 'EURUSD' or i_preset == 'GBPUSD' or i_preset == 'USDJPY' or i_preset == 'AUDUSD' or i_preset == 'EURGBP' or i_preset == 'EURJPY' or i_preset == 'EURAUD' or i_preset == 'GBPJPY' or i_preset == 'GBPAUD' or i_preset == 'AUDJPY'
p_isDivForex = p_isForex and i_preset != 'XAUUSD' and i_useDivStrategy
isXAU = i_preset == 'XAUUSD'
isJPY = i_preset == 'USDJPY' or i_preset == 'EURJPY' or i_preset == 'GBPJPY' or i_preset == 'AUDJPY'

// ── Pip size and pip value per lot (for fixed $ risk lot sizing) ──────────
// USD-quote pairs: pip = 0.0001, $10/lot | JPY pairs: pip = 0.01, varies
// XAUUSD: point = 1.0, $100/lot (handled separately via isXAU)
p_pip_size = isXAU ? 1.0 : isJPY ? 0.01 : 0.0001

// Pip value per standard lot (1.0 lot) — from pip value table
p_pip_val_per_lot = i_preset == 'XAUUSD' ? 100.0 : i_preset == 'EURUSD' ? 10.0 : i_preset == 'GBPUSD' ? 10.0 : i_preset == 'AUDUSD' ? 10.0 : i_preset == 'USDJPY' ? 6.67 : i_preset == 'EURJPY' ? 6.17 : i_preset == 'GBPJPY' ? 5.26 : i_preset == 'AUDJPY' ? 10.10 : i_preset == 'EURGBP' ? 12.70 : i_preset == 'EURAUD' ? 6.60 : i_preset == 'GBPAUD' ? 6.60 : 10.0 // $100/point/lot i_preset == "EURUSD" ? 10.0   :  // $10/pip/lot i_preset == "GBPUSD" ? 10.0   :  // $10/pip/lot i_preset == "AUDUSD" ? 10.0   :  // $10/pip/lot i_preset == "USDJPY" ? 6.67   :  // ~$6.67/pip/lot i_preset == "EURJPY" ? 6.17   :  // ~$6.17/pip/lot i_preset == "GBPJPY" ? 5.26   :  // ~$5.26/pip/lot i_preset == "AUDJPY" ? 10.10  :  // ~$10.10/pip/lot i_preset == "EURGBP" ? 12.70  :  // ~$12.70/pip/lot i_preset == "EURAUD" ? 6.60   :  // ~$6.60/pip/lot i_preset == "GBPAUD" ? 6.60   :  // ~$6.60/pip/lot 10.0

// ── Fixed $ Risk lot calculation ─────────────────────────────────────────
// sl_distance_in_pips = SL ATR distance / pip_size
// lot_size = risk_dollars / (sl_pips × pip_val_per_lot)
// Clamped to min 0.01 lots
_sl_atr_dist = ta.atr(p_atr) * p_sl1 // SL distance in price — uses inline ATR (atrVal defined later)
_sl_pips = p_isForex ? _sl_atr_dist / p_pip_size : 0.0
_raw_lots = p_isForex and _sl_pips > 0 ? i_forex_risk / (_sl_pips * p_pip_val_per_lot) : 0.01
_auto_lots = math.max(0.01, math.round(_raw_lots / 0.01) * 0.01)
p_lots = p_isForex ? i_executionMode == 'Ghost' ? _auto_lots : i_lots : float(p_qty)

p_useTP2 = p_tp2 > 0.0 and p_qty >= 2
p_tp1_qty = p_useTP2 ? math.ceil(p_qty / 2) : p_qty
p_tp2_qty = p_useTP2 ? p_qty - p_tp1_qty : 0

p_sym = i_preset == 'MES' ? 'MES' : i_preset == 'MNQ' ? 'MNQ' : i_preset == 'SIL' ? 'SIL' : i_preset == 'MGC' ? 'MGC' : i_preset == 'MES-AJAY' ? 'MES' : i_preset == 'ES' ? 'ES' : i_preset == 'NQ' ? 'NQ' : i_preset == 'SI' ? 'SI' : i_preset == 'GC' ? 'GC' : i_preset == 'RTY' ? 'RTY' : i_preset == 'XAUUSD' ? 'XAUUSD' : i_preset == 'EURUSD' ? 'EURUSD' : i_preset == 'GBPUSD' ? 'GBPUSD' : i_preset == 'USDJPY' ? 'USDJPY' : i_preset == 'AUDUSD' ? 'AUDUSD' : i_preset == 'EURGBP' ? 'EURGBP' : i_preset == 'EURJPY' ? 'EURJPY' : i_preset == 'EURAUD' ? 'EURAUD' : i_preset == 'GBPJPY' ? 'GBPJPY' : i_preset == 'GBPAUD' ? 'GBPAUD' : i_preset == 'AUDJPY' ? 'AUDJPY' : 'M2K'

// ============================================================
// === NINJA-VIEW TICKER AUTO-CALCULATION ===
// MES, MNQ, M2K: quarterly cycle (Mar/Jun/Sep/Dec)
// MGC: bi-monthly cycle (Feb/Apr/Jun/Aug/Oct/Dec)
// SIL (MISF): non-standard cycle — uses manual i_nv_sil_month input
// Roll assumed on day 10 of the expiry month — aligns with typical
// volume crossover (new contract volume exceeds old ~second Thursday)
// Global override (i_nv_override) takes precedence when not blank
// ============================================================
_cur_month = month(timenow)
_cur_year = year(timenow)
_cur_day = dayofmonth(timenow)
_roll_day = 10 // Roll to next contract on/after day 10 of expiry month

// Quarterly contract month (MES/MNQ/M2K): Mar/Jun/Sep/Dec
// On/after day 10 of expiry month, advance to next quarterly contract
// Year rolls over when advancing from December to March
_qtly_exp_month = _cur_month == 3 and _cur_day >= _roll_day ? 6 : _cur_month == 6 and _cur_day >= _roll_day ? 9 : _cur_month == 9 and _cur_day >= _roll_day ? 12 : _cur_month == 12 and _cur_day >= _roll_day ? 3 : _cur_month <= 3 ? 3 : _cur_month <= 6 ? 6 : _cur_month <= 9 ? 9 : 12

_qtly_exp_year = _cur_month == 12 and _cur_day >= _roll_day ? _cur_year + 1 : _cur_year

_qtly_mm = str.tostring(_qtly_exp_month, '00')
_qtly_yy = str.tostring(_qtly_exp_year % 100, '00')

// MGC bi-monthly contract: Feb/Apr/Jun/Aug/Oct/Dec
// On/after day 10 of expiry month, advance to next bi-monthly contract
// Year rolls over when advancing from December to February
_mgc_exp_month = _cur_month == 2 and _cur_day >= _roll_day ? 4 : _cur_month == 4 and _cur_day >= _roll_day ? 6 : _cur_month == 6 and _cur_day >= _roll_day ? 8 : _cur_month == 8 and _cur_day >= _roll_day ? 10 : _cur_month == 10 and _cur_day >= _roll_day ? 12 : _cur_month == 12 and _cur_day >= _roll_day ? 2 : _cur_month <= 2 ? 2 : _cur_month <= 4 ? 4 : _cur_month <= 6 ? 6 : _cur_month <= 8 ? 8 : _cur_month <= 10 ? 10 : 12

_mgc_exp_year = _cur_month == 12 and _cur_day >= _roll_day ? _cur_year + 1 : _cur_year

_mgc_mm = str.tostring(_mgc_exp_month, '00')
_mgc_yy = str.tostring(_mgc_exp_year % 100, '00')

_nv_auto_ticker = i_preset == 'MES' ? 'MES ' + _qtly_mm + '-' + _qtly_yy : i_preset == 'MNQ' ? 'MNQ ' + _qtly_mm + '-' + _qtly_yy : i_preset == 'M2K' ? 'M2K ' + _qtly_mm + '-' + _qtly_yy : i_preset == 'MGC' ? 'MGC ' + _mgc_mm + '-' + _mgc_yy : i_preset == 'SIL' ? 'MISF ' + i_nv_sil_month : i_preset == 'ES' ? 'ES ' + _qtly_mm + '-' + _qtly_yy : i_preset == 'NQ' ? 'NQ ' + _qtly_mm + '-' + _qtly_yy : i_preset == 'RTY' ? 'RTY ' + _qtly_mm + '-' + _qtly_yy : i_preset == 'GC' ? 'GC ' + _mgc_mm + '-' + _mgc_yy : i_preset == 'SI' ? 'SI ' + i_nv_sil_month : i_preset == 'MES-AJAY' ? 'MES ' + _qtly_mm + '-' + _qtly_yy : i_preset == 'XAUUSD' ? 'XAUUSD' : i_preset == 'EURUSD' ? 'EURUSD' : i_preset == 'GBPUSD' ? 'GBPUSD' : i_preset == 'USDJPY' ? 'USDJPY' : i_preset == 'AUDUSD' ? 'AUDUSD' : i_preset == 'EURGBP' ? 'EURGBP' : i_preset == 'EURJPY' ? 'EURJPY' : i_preset == 'EURAUD' ? 'EURAUD' : i_preset == 'GBPJPY' ? 'GBPJPY' : i_preset == 'GBPAUD' ? 'GBPAUD' : i_preset == 'AUDJPY' ? 'AUDJPY' : ''

nv_ticker = str.length(i_nv_override) > 0 ? i_nv_override : _nv_auto_ticker


// ============================================================
// === SHARED INPUTS ===
// ============================================================

i_wtChanLen = input.int(9, 'WT Channel Length', group = '🔧 Developer Tuning')
i_wtAvgLen = input.int(12, 'WT Average Length', group = '🔧 Developer Tuning')
i_wtMALen = input.int(3, 'WT MA Length', group = '🔧 Developer Tuning')
i_momLen = input.int(10, 'Momentum Length', group = '🔧 Developer Tuning', minval = 1)
i_momSmooth = input.int(3, 'Momentum Smooth', group = '🔧 Developer Tuning', minval = 1)
// this variable moved to the Instrument level-i_sqzMomLen  = input.int(9,    "Squeeze Momentum Len", group="🔧 Developer Tuning")
i_atrMult = input.float(2.0, 'ATR Trail Mult', group = '🔧 Developer Tuning')
i_vfiLen = input.int(130, 'VFI Length', group = '🔧 Developer Tuning')
i_vfiCoef = input.float(0.2, 'VFI Coef', group = '🔧 Developer Tuning')
i_vfiVolCoef = input.float(2.5, 'VFI Vol Coef', group = '🔧 Developer Tuning')
i_swingLen = input.int(5, 'Swing Lookback', group = '🔧 Developer Tuning', minval = 2)

// ============================================================
// === CONFLUENCE PARAMETER RESOLVERS ===
// All gate on i_useOverrides — zero effect on live trading when OFF
// Declared here (after all i_ inputs) so Pine can resolve references
// ============================================================
p_wtOB = i_useOverrides ? i_ovr_wtOB : i_wtOB
p_wtOS = i_useOverrides ? i_ovr_wtOS : i_wtOS
p_wtChanLen = i_useOverrides ? i_ovr_wtChanLen : p_wtChanLen_preset
p_wtAvgLen = i_useOverrides ? i_ovr_wtAvgLen : p_wtAvgLen_preset
p_wtMALen = i_useOverrides ? i_ovr_wtMALen : i_wtMALen
p_momLen = i_useOverrides ? i_ovr_momLen : p_momLen_preset
p_momSmooth = i_useOverrides ? i_ovr_momSmooth : i_momSmooth
p_sqzBBLen = i_useOverrides ? i_ovr_sqzBBLen : p_sqzBBLen_preset
p_sqzBBMult = i_useOverrides ? i_ovr_sqzBBMult : p_sqzBBMult_preset
p_sqzKCLen = i_useOverrides ? i_ovr_sqzKCLen : p_sqzKCLen_preset
p_sqzKCMult = i_useOverrides ? i_ovr_sqzKCMult : p_sqzKCMult_preset
p_atrMult = i_useOverrides ? i_ovr_atrMult : p_atrMult_preset
p_vfiLen = i_useOverrides ? i_ovr_vfiLen : p_vfiLen_preset
p_vfiCoef = i_useOverrides ? i_ovr_vfiCoef : i_vfiCoef
p_vfiVolCoef = i_useOverrides ? i_ovr_vfiVolCoef : i_vfiVolCoef
p_swingLen = i_useOverrides ? i_ovr_swingLen : p_swingLen_preset

// v3.0.5: Per-instrument filter flags (auto-selected by preset, overridable via UI)
p_useRSI_preset = i_preset == 'MES' ? mes_useRSI : i_preset == 'MNQ' ? mnq_useRSI : i_preset == 'MGC' ? mgc_useRSI : i_preset == 'M2K' ? m2k_useRSI : i_preset == 'SIL' ? sil_useRSI : true
p_useADX_preset = i_preset == 'MES' ? mes_useADX : i_preset == 'MNQ' ? mnq_useADX : i_preset == 'MGC' ? mgc_useADX : i_preset == 'M2K' ? m2k_useADX : i_preset == 'SIL' ? sil_useADX : true
p_useRegime_preset = i_preset == 'MES' ? mes_useRegime : i_preset == 'MNQ' ? mnq_useRegime : i_preset == 'MGC' ? mgc_useRegime : i_preset == 'M2K' ? m2k_useRegime : i_preset == 'SIL' ? sil_useRegime : false

p_lossPolicy = i_preset == 'MES' ? mes_lossPolicy : i_preset == 'MNQ' ? mnq_lossPolicy : i_preset == 'MGC' ? mgc_lossPolicy : i_preset == 'M2K' ? m2k_lossPolicy : i_preset == 'SIL' ? sil_lossPolicy : false

i_useRSI = input.bool(true, 'Use RSI Filter', group = 'Filters')
i_useADX = input.bool(true, 'Use ADX Filter', group = 'Filters')
i_useRegimeFilter = input.bool(false, 'Use Regime Filter (blocks counter-regime entries)', group = 'Filters', tooltip = 'When enabled, blocks LONG entries if regime score < i_regimeMinScore and blocks SHORT entries if regime score > -i_regimeMinScore. Requires Regime Heatmap data.')
i_regimeMinScore = input.int(4, 'Min Regime Score (absolute)', minval = 1, maxval = 6, step = 1, group = 'Filters', tooltip = 'Minimum absolute regime score required to take a trade. 1 = any non-neutral regime. 3 = BULL/BEAR BIAS or stronger. 5 = STRONG BULL/BEAR only.')

// v3.0.5: Per-instrument filter routing (declared after all filter inputs)
p_useRSI = i_useOverrides ? i_useRSI : p_useRSI_preset
p_useADX = i_useOverrides ? i_useADX : p_useADX_preset
p_useRegime = i_useOverrides ? i_useRegimeFilter : p_useRegime_preset

i_showPanel = input.bool(true, 'Show Panel', group = 'Display Panel')
i_barCloseOnly = input.bool(true, 'Smooth Display (Bar Close Only)', group = 'Display Panel')
i_panelPos = input.string('Top Right', 'Panel Position', options = ['Top Right', 'Top Left', 'Top Center', 'Bottom Right', 'Bottom Left', 'Bottom Center'], group = 'Display Panel')
i_panelSize = input.string('Normal', 'Panel Text Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = 'Display Panel')
i_showSignalMarkers = input.bool(true, 'Show BUY/SELL Signal Markers', group = 'Display Panel')
i_markerOffset = input.float(2.5, 'Signal Marker Offset (ATR)', minval = 0.1, maxval = 10.0, step = 0.1, group = 'Display Panel')
i_markerSize = input.string('Normal', 'Signal Marker Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = 'Display Panel')

i_showTradeLog = input.bool(false, 'Show Trade Log', group = 'Trade Log')
i_tradeLogPos = input.string('Bottom Left', 'Trade Log Position', options = ['Top Right', 'Top Left', 'Top Center', 'Bottom Right', 'Bottom Left', 'Bottom Center'], group = 'Trade Log')
i_tradeLogSize = input.string('Small', 'Trade Log Text Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = 'Trade Log')
i_tradeLogMax = input.int(10, 'Max Trades To Show', minval = 3, maxval = 20, group = 'Trade Log')

var int bullCalloutStack = 0
var int bearCalloutStack = 0

i_calloutOffsetATR = input.float(0.28, 'Callout Offset (ATR)', minval = 0.05, maxval = 2.0, step = 0.01, group = '🔧 Developer Tuning')
i_calloutStackATR = input.float(0.12, 'Callout Stack Step (ATR)', minval = 0.00, maxval = 1.0, step = 0.01, group = '🔧 Developer Tuning')
i_calloutFade = input.int(18, 'Callout Transparency', minval = 0, maxval = 90, group = '🔧 Developer Tuning')
i_bigTimelineLbl = input.bool(true, 'Use Large Wrapped Timeline Labels', group = '🔧 Developer Tuning')
i_timelineLblSize = input.string('Normal', 'Timeline Label Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = '🔧 Developer Tuning')
i_timelineShowBars = input.bool(true, 'Show Bars Ago In Timeline Labels', group = '🔧 Developer Tuning')
i_showDiagPanel = input.bool(false, 'Show Diagnostics Panel (Separate)', group = '🔧 Developer Tuning')
i_diagPanelPos = input.string('Bottom Left', 'Diagnostics Panel Position', options = ['Top Right', 'Top Left', 'Top Center', 'Bottom Right', 'Bottom Left', 'Bottom Center'], group = '🔧 Developer Tuning')
i_diagPanelSize = input.string('Tiny', 'Diagnostics Panel Text Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = '🔧 Developer Tuning')
i_showDelay = input.bool(true, 'Show Confluence Delay Detector (Panel)', group = '🔧 Developer Tuning')
i_showTimeline = input.bool(true, 'Show Confluence Timeline (Panel)', group = '🔧 Developer Tuning')
i_showTimelineLbl = input.bool(false, 'Show Timeline Labels On Signal Bars', group = '🔧 Developer Tuning')
i_showEntryMarks = input.bool(true, 'Show Entry Debug Markers (Signal Bars)', group = '🔧 Developer Tuning')


// ── Day of Week Filter ────────────────────────────────────────────────────────
i_useDOW = input.bool(true, 'Use Day of Week Filter', tooltip = 'Master switch for day-of-week filtering. When ON: blocks new entries on disabled days. Day source = the manual Trade [Day] toggles below, unless \'Use Optimized DOW Defaults\' is also ON (then per-instrument presets are used). Sunday = Globex open session (typically Sun 18:00 -> Mon 00:00 CT).', group = 'Day of Week Filter')
i_useOptimizedDOW = input.bool(true, 'Use Optimized DOW Defaults', tooltip = 'When ON: loads the per-instrument optimized day-of-week presets (MNQ blocks Sun/Mon/Thu; MGC blocks Sun/Mon/Fri; MES/M2K/SIL all-on). When OFF: uses the manual Trade [Day] toggles below. Independent of \'Use Optimized Time Filter\' (which controls intraday block windows only). Requires \'Use Day of Week Filter\' ON to take effect.', group = 'Day of Week Filter')
i_tradeSun = input.bool(true, 'Trade Sunday', group = 'Day of Week Filter')
i_tradeMon = input.bool(true, 'Trade Monday', group = 'Day of Week Filter')
i_tradeTue = input.bool(true, 'Trade Tuesday', group = 'Day of Week Filter')
i_tradeWed = input.bool(true, 'Trade Wednesday', group = 'Day of Week Filter')
i_tradeThu = input.bool(true, 'Trade Thursday', group = 'Day of Week Filter')
i_tradeFri = input.bool(true, 'Trade Friday', group = 'Day of Week Filter')

i_useTimeFilter = input.bool(false, 'Use Trading Hours Filter', group = 'Trading Hours')
i_startHour = input.int(9, 'Start Hour (Exchange TZ)', minval = 0, maxval = 23, group = 'Trading Hours')
i_startMin = input.int(30, 'Start Minute', minval = 0, maxval = 59, group = 'Trading Hours')
i_stopHour = input.int(16, 'Stop Hour (Exchange TZ)', minval = 0, maxval = 23, group = 'Trading Hours')
i_stopMin = input.int(0, 'Stop Minute', minval = 0, maxval = 59, group = 'Trading Hours')
i_useEODCutoff = input.bool(true, 'Use 15:50–17:00 CDT Market Closure Window', tooltip = 'When enabled: blocks new entries and force-closes any open position at 15:50 CDT. Resumes normal trading at 17:00 CDT. Covers the 16:00–17:00 CDT daily market closure with a 15-minute buffer. Applies every day including Fridays.', group = 'Trading Hours')

i_useOptimizedTimeFilter = input.bool(true, 'Use Optimized Time Filter', tooltip = 'When ON: uses the author\'s pre-optimized intraday block windows for the selected instrument preset. MES and MNQ have optimized windows; MGC, SIL, and M2K have none. When OFF: configure windows manually below. NOTE (v3.0.1): this controls intraday block windows ONLY — day-of-week presets are now under \'Use Optimized DOW Defaults\' in the Day of Week Filter group.', group = 'Trading Hours')

i_useBlockWindow1 = input.bool(false, 'Use Block Window 1', group = 'Trading Hours')
i_block1StartHour = input.int(11, 'Block 1 Start Hour (Exchange TZ)', minval = 0, maxval = 23, group = 'Trading Hours')
i_block1StartMin = input.int(30, 'Block 1 Start Minute', minval = 0, maxval = 59, group = 'Trading Hours')
i_block1EndHour = input.int(13, 'Block 1 End Hour (Exchange TZ)', minval = 0, maxval = 23, group = 'Trading Hours')
i_block1EndMin = input.int(0, 'Block 1 End Minute', minval = 0, maxval = 59, group = 'Trading Hours')

i_useBlockWindow2 = input.bool(false, 'Use Block Window 2', group = 'Trading Hours')
i_block2StartHour = input.int(0, 'Block 2 Start Hour (Exchange TZ)', minval = 0, maxval = 23, group = 'Trading Hours')
i_block2StartMin = input.int(0, 'Block 2 Start Minute', minval = 0, maxval = 59, group = 'Trading Hours')
i_block2EndHour = input.int(0, 'Block 2 End Hour (Exchange TZ)', minval = 0, maxval = 23, group = 'Trading Hours')
i_block2EndMin = input.int(0, 'Block 2 End Minute', minval = 0, maxval = 59, group = 'Trading Hours')

i_useBlockWindow3 = input.bool(false, 'Use Block Window 3', group = 'Trading Hours')
i_block3StartHour = input.int(0, 'Block 3 Start Hour (Exchange TZ)', minval = 0, maxval = 23, group = 'Trading Hours')
i_block3StartMin = input.int(0, 'Block 3 Start Minute', minval = 0, maxval = 59, group = 'Trading Hours')
i_block3EndHour = input.int(0, 'Block 3 End Hour (Exchange TZ)', minval = 0, maxval = 23, group = 'Trading Hours')
i_block3EndMin = input.int(0, 'Block 3 End Minute', minval = 0, maxval = 59, group = 'Trading Hours')

i_showLines = input.bool(true, 'Show Trade Level Lines', group = 'Trade Lines')
i_lineLen = input.int(20, 'Line Length (bars)', group = 'Trade Lines', minval = 1, maxval = 200)
i_entryColor = input.color(color.white, 'Entry Line Color', group = 'Trade Lines')
i_entryStyle = input.string('Solid', 'Entry Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = 'Trade Lines')
i_entryWidth = input.int(2, 'Entry Line Width', minval = 1, maxval = 4, group = 'Trade Lines')
i_tp1Color = input.color(color.new(color.green, 0), 'TP1 Line Color', group = 'Trade Lines')
i_tp1Style = input.string('Dashed', 'TP1 Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = 'Trade Lines')
i_tp1Width = input.int(2, 'TP1 Line Width', minval = 1, maxval = 4, group = 'Trade Lines')
i_sl1Color = input.color(color.new(color.red, 0), 'SL1 Line Color', group = 'Trade Lines')
i_sl1Style = input.string('Dashed', 'SL1 Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = 'Trade Lines')
i_sl1Width = input.int(2, 'SL1 Line Width', minval = 1, maxval = 4, group = 'Trade Lines')
i_showPriceLabels = input.bool(true, 'Show Price Labels On Lines', group = 'Trade Lines', tooltip = 'Shows the price level at the right end of each trade line — entry, TP1, and SL1. Updates live on projected lines before bar close.')

// ============================================================
// === CONFLUENCE 1 & 2: EMA TREND SYSTEM ===
// ============================================================
fastEMA = ta.ema(close, 9)
slowEMA = ta.ema(close, 18)

c1_bull = fastEMA > slowEMA
c1_bear = fastEMA < slowEMA
c2_bull = close > fastEMA
c2_bear = close < fastEMA

// ============================================================
// === CONFLUENCE 3: WAVETREND OSCILLATOR ===
// ============================================================
wtHlc3 = hlc3
wtEsa = ta.ema(wtHlc3, p_wtChanLen)
wtD = ta.ema(math.abs(wtHlc3 - wtEsa), p_wtChanLen)
wtCi = (wtHlc3 - wtEsa) / (0.015 * wtD)
wt1 = ta.ema(wtCi, p_wtAvgLen)
wt2 = ta.sma(wt1, p_wtMALen)
wtCross_bull = ta.crossover(wt1, wt2) and wt1 < p_wtOS
wtCross_bear = ta.crossunder(wt1, wt2) and wt1 > p_wtOB

// v3.1.9 NOTE: the OR-cross terms below are mathematically subsumed by the
// first condition (crossover implies wt1 > wt2 on that bar). C3 reduces to
// simple WT direction; the WT OB/OS tuning inputs have no effect on signals.
// Logic intentionally left unchanged — all optimized params were validated
// against this behavior. Candidate for cleanup in a future signal revision.
c3_bull = wt1 > wt2 or wtCross_bull
c3_bear = wt1 < wt2 or wtCross_bear

// ============================================================
// === CONFLUENCE 4: SMOOTHED MOMENTUM ===
// ============================================================
momentum = close - close[p_momLen]
smoothedMom = ta.ema(momentum, p_momSmooth)

c4_bull = smoothedMom > 0
c4_bear = smoothedMom < 0

// ============================================================
// === CONFLUENCE 5: CANDLE COLOR ===
// ============================================================
c5_bull = close >= open
c5_bear = close < open

// ============================================================
// === CONFLUENCE 6: BREAKOUT + SQUEEZE MOMENTUM ===
// ============================================================
sqzBasis = ta.sma(close, p_sqzBBLen)
sqzDev = p_sqzBBMult * ta.stdev(close, p_sqzBBLen)
sqzUBB = sqzBasis + sqzDev
sqzLBB = sqzBasis - sqzDev
sqzRange = ta.tr(true)
sqzUKC = sqzBasis + p_sqzKCMult * ta.ema(sqzRange, p_sqzKCLen)
sqzLKC = sqzBasis - p_sqzKCMult * ta.ema(sqzRange, p_sqzKCLen)
sqzOn = sqzLBB > sqzLKC and sqzUBB < sqzUKC // v3.1.9 NOTE: unused — C6 gates on sqzVal momentum only. Kept for potential future squeeze-state filter.
sqzVal = ta.linreg(close - math.avg(math.avg(ta.highest(high, p_sqzMomLen), ta.lowest(low, p_sqzMomLen)), ta.sma(close, p_sqzMomLen)), p_sqzMomLen, 0)

c6_bull = sqzVal > 0 and sqzVal > sqzVal[1]
c6_bear = sqzVal < 0 and sqzVal < sqzVal[1]

// ============================================================
// === CONFLUENCE 7: SMART TRAIL (ATR-based) ===
// ============================================================
atrVal = ta.atr(p_atr)
trailAmt = p_atrMult * atrVal

var float trailStop = na
if na(trailStop)
    trailStop := close
    trailStop
if close > trailStop
    trailStop := math.max(trailStop, close - trailAmt)
    trailStop
else if close < trailStop
    trailStop := math.min(trailStop, close + trailAmt)
    trailStop

c7_bull = close > trailStop
c7_bear = close < trailStop

// ============================================================
// === CONFLUENCE 8: VOLUME FLOW INDICATOR (VFI) ===
// ============================================================
vfiInter = math.log(close) - math.log(close[1])
vfiVinter = ta.stdev(vfiInter, 30)
vfiCutoff = p_vfiCoef * vfiVinter * close
vfiVave = ta.sma(volume, p_vfiLen)
vfiVmax = vfiVave * p_vfiVolCoef
vfiVc = math.min(volume, vfiVmax)
vfiMf = close - close[1]
vfiVcp = vfiMf > vfiCutoff ? vfiVc : vfiMf < -vfiCutoff ? -vfiVc : 0
vfi = ta.ema(math.sum(vfiVcp, p_vfiLen) / vfiVave, 3)

c8_bull = vfi > 0
c8_bear = vfi < 0

// ============================================================
// === CONFLUENCE 9: SMART MONEY CONCEPTS (BOS) ===
// ============================================================
swingHigh = ta.pivothigh(high, p_swingLen, p_swingLen)
swingLow = ta.pivotlow(low, p_swingLen, p_swingLen)

var float lastSwingHigh = na
var float lastSwingLow = na

if not na(swingHigh)
    lastSwingHigh := swingHigh
    lastSwingHigh
if not na(swingLow)
    lastSwingLow := swingLow
    lastSwingLow

c9_bull = not na(lastSwingHigh) and close > lastSwingHigh
c9_bear = not na(lastSwingLow) and close < lastSwingLow

// ============================================================
// === RSI & ADX FILTERS ===
// ============================================================
rsiVal = ta.rsi(close, p_rsiLen)

[diPlus, diMinus, adxVal] = ta.dmi(p_adxLen, p_adxLen)

rsiFilter_bull = p_useRSI ? rsiVal < p_rsiOB : true
rsiFilter_bear = p_useRSI ? rsiVal > p_rsiOS : true
adxFilter = p_useADX ? adxVal >= p_adxMin : true

// ============================================================
// === REGIME HEATMAP (price vs EMA 11 across 6 timeframes) ===
// Mirrors Maverick Trender heatmap for data collection.
// Score sent in AlertLog payload — does NOT affect entry logic.
// ============================================================
rh_ema_len = 11
// v3.1.9 FIX: ta.ema moved INSIDE request.security. Previously the EMA was
// computed on chart-resolution samples of the target TF, producing skewed
// values (lower TFs echoed chart TF; higher TFs smeared repeated values).
// Now each row is the true EMA-11 of its own timeframe.
rh_ema(tf) =>
    request.security(syminfo.tickerid, tf, ta.ema(close, rh_ema_len), lookahead = barmerge.lookahead_off)
rh_bull1 = close > rh_ema('1')
rh_bull2 = close > rh_ema('3')
rh_bull3 = close > rh_ema('5')
rh_bull4 = close > rh_ema('15')
rh_bull5 = close > rh_ema('30')
rh_bull6 = close > rh_ema('60')
rh_bull_count = (rh_bull1 ? 1 : 0) + (rh_bull2 ? 1 : 0) + (rh_bull3 ? 1 : 0) + (rh_bull4 ? 1 : 0) + (rh_bull5 ? 1 : 0) + (rh_bull6 ? 1 : 0)
rh_score = (rh_bull1 ? 1 : -1) + (rh_bull2 ? 1 : -1) + (rh_bull3 ? 1 : -1) + (rh_bull4 ? 1 : -1) + (rh_bull5 ? 1 : -1) + (rh_bull6 ? 1 : -1)
rh_label = rh_bull_count >= 5 ? 'STRONG BULL' : rh_bull_count == 4 ? 'BULL BIAS' : rh_bull_count == 3 ? 'NEUTRAL' : rh_bull_count == 2 ? 'BEAR BIAS' : 'STRONG BEAR'

// ============================================================
// === TRADING HOURS FILTER ===
// ============================================================
barMins = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
startMins = i_startHour * 60 + i_startMin
stopMins = i_stopHour * 60 + i_stopMin
timeAllowed = i_useTimeFilter ? startMins <= stopMins ? barMins >= startMins and barMins < stopMins : barMins >= startMins or barMins < stopMins : true

// ── Block window resolver — preset vs manual ──────────────────────────────
// When i_useOptimizedTimeFilter is ON: use per-instrument preset values
// When OFF: use manual i_block1/2/3 inputs (existing behavior unchanged)
p_w1_on = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w1_on : i_preset == 'MNQ' ? mnq_w1_on : i_preset == 'MGC' ? mgc_w1_on : i_preset == 'SIL' ? sil_w1_on : i_preset == 'MES-AJAY' ? ajay_w1_on : i_preset == 'XAUUSD' ? mgc_w1_on : i_preset == 'EURUSD' ? eur_w1_on : i_preset == 'GBPUSD' ? gbp_w1_on : i_preset == 'USDJPY' ? usdj_w1_on : i_preset == 'AUDUSD' ? aud_w1_on : i_preset == 'EURGBP' ? eurgbp_w1_on : i_preset == 'EURJPY' ? eurjpy_w1_on : i_preset == 'EURAUD' ? euraud_w1_on : i_preset == 'GBPJPY' ? gbpjpy_w1_on : i_preset == 'GBPAUD' ? gbpaud_w1_on : i_preset == 'AUDJPY' ? audjpy_w1_on : m2k_w1_on : i_useBlockWindow1
p_w1_sh = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w1_sh : i_preset == 'MNQ' ? mnq_w1_sh : i_preset == 'MGC' ? mgc_w1_sh : i_preset == 'SIL' ? sil_w1_sh : i_preset == 'MES-AJAY' ? ajay_w1_sh : i_preset == 'XAUUSD' ? mgc_w1_sh : i_preset == 'EURUSD' ? eur_w1_sh : i_preset == 'GBPUSD' ? gbp_w1_sh : i_preset == 'USDJPY' ? usdj_w1_sh : i_preset == 'AUDUSD' ? aud_w1_sh : i_preset == 'EURGBP' ? eurgbp_w1_sh : i_preset == 'EURJPY' ? eurjpy_w1_sh : i_preset == 'EURAUD' ? euraud_w1_sh : i_preset == 'GBPJPY' ? gbpjpy_w1_sh : i_preset == 'GBPAUD' ? gbpaud_w1_sh : i_preset == 'AUDJPY' ? audjpy_w1_sh : m2k_w1_sh : i_block1StartHour
p_w1_sm = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w1_sm : i_preset == 'MNQ' ? mnq_w1_sm : i_preset == 'MGC' ? mgc_w1_sm : i_preset == 'SIL' ? sil_w1_sm : i_preset == 'MES-AJAY' ? ajay_w1_sm : i_preset == 'XAUUSD' ? mgc_w1_sm : i_preset == 'EURUSD' ? eur_w1_sm : i_preset == 'GBPUSD' ? gbp_w1_sm : i_preset == 'USDJPY' ? usdj_w1_sm : i_preset == 'AUDUSD' ? aud_w1_sm : i_preset == 'EURGBP' ? eurgbp_w1_sm : i_preset == 'EURJPY' ? eurjpy_w1_sm : i_preset == 'EURAUD' ? euraud_w1_sm : i_preset == 'GBPJPY' ? gbpjpy_w1_sm : i_preset == 'GBPAUD' ? gbpaud_w1_sm : i_preset == 'AUDJPY' ? audjpy_w1_sm : m2k_w1_sm : i_block1StartMin
p_w1_eh = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w1_eh : i_preset == 'MNQ' ? mnq_w1_eh : i_preset == 'MGC' ? mgc_w1_eh : i_preset == 'SIL' ? sil_w1_eh : i_preset == 'MES-AJAY' ? ajay_w1_eh : i_preset == 'XAUUSD' ? mgc_w1_eh : i_preset == 'EURUSD' ? eur_w1_eh : i_preset == 'GBPUSD' ? gbp_w1_eh : i_preset == 'USDJPY' ? usdj_w1_eh : i_preset == 'AUDUSD' ? aud_w1_eh : i_preset == 'EURGBP' ? eurgbp_w1_eh : i_preset == 'EURJPY' ? eurjpy_w1_eh : i_preset == 'EURAUD' ? euraud_w1_eh : i_preset == 'GBPJPY' ? gbpjpy_w1_eh : i_preset == 'GBPAUD' ? gbpaud_w1_eh : i_preset == 'AUDJPY' ? audjpy_w1_eh : m2k_w1_eh : i_block1EndHour
p_w1_em = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w1_em : i_preset == 'MNQ' ? mnq_w1_em : i_preset == 'MGC' ? mgc_w1_em : i_preset == 'SIL' ? sil_w1_em : i_preset == 'MES-AJAY' ? ajay_w1_em : i_preset == 'XAUUSD' ? mgc_w1_em : i_preset == 'EURUSD' ? eur_w1_em : i_preset == 'GBPUSD' ? gbp_w1_em : i_preset == 'USDJPY' ? usdj_w1_em : i_preset == 'AUDUSD' ? aud_w1_em : i_preset == 'EURGBP' ? eurgbp_w1_em : i_preset == 'EURJPY' ? eurjpy_w1_em : i_preset == 'EURAUD' ? euraud_w1_em : i_preset == 'GBPJPY' ? gbpjpy_w1_em : i_preset == 'GBPAUD' ? gbpaud_w1_em : i_preset == 'AUDJPY' ? audjpy_w1_em : m2k_w1_em : i_block1EndMin

p_w2_on = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w2_on : i_preset == 'MNQ' ? mnq_w2_on : i_preset == 'MGC' ? mgc_w2_on : i_preset == 'SIL' ? sil_w2_on : i_preset == 'MES-AJAY' ? ajay_w2_on : i_preset == 'XAUUSD' ? mgc_w2_on : i_preset == 'EURUSD' ? eur_w2_on : i_preset == 'GBPUSD' ? gbp_w2_on : i_preset == 'USDJPY' ? usdj_w2_on : i_preset == 'AUDUSD' ? aud_w2_on : i_preset == 'EURGBP' ? eurgbp_w2_on : i_preset == 'EURJPY' ? eurjpy_w2_on : i_preset == 'EURAUD' ? euraud_w2_on : i_preset == 'GBPJPY' ? gbpjpy_w2_on : i_preset == 'GBPAUD' ? gbpaud_w2_on : i_preset == 'AUDJPY' ? audjpy_w2_on : m2k_w2_on : i_useBlockWindow2
p_w2_sh = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w2_sh : i_preset == 'MNQ' ? mnq_w2_sh : i_preset == 'MGC' ? mgc_w2_sh : i_preset == 'SIL' ? sil_w2_sh : i_preset == 'MES-AJAY' ? ajay_w2_sh : i_preset == 'XAUUSD' ? mgc_w2_sh : i_preset == 'EURUSD' ? eur_w2_sh : i_preset == 'GBPUSD' ? gbp_w2_sh : i_preset == 'USDJPY' ? usdj_w2_sh : i_preset == 'AUDUSD' ? aud_w2_sh : i_preset == 'EURGBP' ? eurgbp_w2_sh : i_preset == 'EURJPY' ? eurjpy_w2_sh : i_preset == 'EURAUD' ? euraud_w2_sh : i_preset == 'GBPJPY' ? gbpjpy_w2_sh : i_preset == 'GBPAUD' ? gbpaud_w2_sh : i_preset == 'AUDJPY' ? audjpy_w2_sh : m2k_w2_sh : i_block2StartHour
p_w2_sm = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w2_sm : i_preset == 'MNQ' ? mnq_w2_sm : i_preset == 'MGC' ? mgc_w2_sm : i_preset == 'SIL' ? sil_w2_sm : i_preset == 'MES-AJAY' ? ajay_w2_sm : i_preset == 'XAUUSD' ? mgc_w2_sm : i_preset == 'EURUSD' ? eur_w2_sm : i_preset == 'GBPUSD' ? gbp_w2_sm : i_preset == 'USDJPY' ? usdj_w2_sm : i_preset == 'AUDUSD' ? aud_w2_sm : i_preset == 'EURGBP' ? eurgbp_w2_sm : i_preset == 'EURJPY' ? eurjpy_w2_sm : i_preset == 'EURAUD' ? euraud_w2_sm : i_preset == 'GBPJPY' ? gbpjpy_w2_sm : i_preset == 'GBPAUD' ? gbpaud_w2_sm : i_preset == 'AUDJPY' ? audjpy_w2_sm : m2k_w2_sm : i_block2StartMin
p_w2_eh = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w2_eh : i_preset == 'MNQ' ? mnq_w2_eh : i_preset == 'MGC' ? mgc_w2_eh : i_preset == 'SIL' ? sil_w2_eh : i_preset == 'MES-AJAY' ? ajay_w2_eh : i_preset == 'XAUUSD' ? mgc_w2_eh : i_preset == 'EURUSD' ? eur_w2_eh : i_preset == 'GBPUSD' ? gbp_w2_eh : i_preset == 'USDJPY' ? usdj_w2_eh : i_preset == 'AUDUSD' ? aud_w2_eh : i_preset == 'EURGBP' ? eurgbp_w2_eh : i_preset == 'EURJPY' ? eurjpy_w2_eh : i_preset == 'EURAUD' ? euraud_w2_eh : i_preset == 'GBPJPY' ? gbpjpy_w2_eh : i_preset == 'GBPAUD' ? gbpaud_w2_eh : i_preset == 'AUDJPY' ? audjpy_w2_eh : m2k_w2_eh : i_block2EndHour
p_w2_em = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w2_em : i_preset == 'MNQ' ? mnq_w2_em : i_preset == 'MGC' ? mgc_w2_em : i_preset == 'SIL' ? sil_w2_em : i_preset == 'MES-AJAY' ? ajay_w2_em : i_preset == 'XAUUSD' ? mgc_w2_em : i_preset == 'EURUSD' ? eur_w2_em : i_preset == 'GBPUSD' ? gbp_w2_em : i_preset == 'USDJPY' ? usdj_w2_em : i_preset == 'AUDUSD' ? aud_w2_em : i_preset == 'EURGBP' ? eurgbp_w2_em : i_preset == 'EURJPY' ? eurjpy_w2_em : i_preset == 'EURAUD' ? euraud_w2_em : i_preset == 'GBPJPY' ? gbpjpy_w2_em : i_preset == 'GBPAUD' ? gbpaud_w2_em : i_preset == 'AUDJPY' ? audjpy_w2_em : m2k_w2_em : i_block2EndMin

p_w3_on = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w3_on : i_preset == 'MNQ' ? mnq_w3_on : i_preset == 'MGC' ? mgc_w3_on : i_preset == 'SIL' ? sil_w3_on : i_preset == 'MES-AJAY' ? ajay_w3_on : i_preset == 'XAUUSD' ? mgc_w3_on : i_preset == 'EURUSD' ? eur_w3_on : i_preset == 'GBPUSD' ? gbp_w3_on : i_preset == 'USDJPY' ? usdj_w3_on : i_preset == 'AUDUSD' ? aud_w3_on : i_preset == 'EURGBP' ? eurgbp_w3_on : i_preset == 'EURJPY' ? eurjpy_w3_on : i_preset == 'EURAUD' ? euraud_w3_on : i_preset == 'GBPJPY' ? gbpjpy_w3_on : i_preset == 'GBPAUD' ? gbpaud_w3_on : i_preset == 'AUDJPY' ? audjpy_w3_on : m2k_w3_on : i_useBlockWindow3
p_w3_sh = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w3_sh : i_preset == 'MNQ' ? mnq_w3_sh : i_preset == 'MGC' ? mgc_w3_sh : i_preset == 'SIL' ? sil_w3_sh : i_preset == 'MES-AJAY' ? ajay_w3_sh : i_preset == 'XAUUSD' ? mgc_w3_sh : i_preset == 'EURUSD' ? eur_w3_sh : i_preset == 'GBPUSD' ? gbp_w3_sh : i_preset == 'USDJPY' ? usdj_w3_sh : i_preset == 'AUDUSD' ? aud_w3_sh : i_preset == 'EURGBP' ? eurgbp_w3_sh : i_preset == 'EURJPY' ? eurjpy_w3_sh : i_preset == 'EURAUD' ? euraud_w3_sh : i_preset == 'GBPJPY' ? gbpjpy_w3_sh : i_preset == 'GBPAUD' ? gbpaud_w3_sh : i_preset == 'AUDJPY' ? audjpy_w3_sh : m2k_w3_sh : i_block3StartHour
p_w3_sm = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w3_sm : i_preset == 'MNQ' ? mnq_w3_sm : i_preset == 'MGC' ? mgc_w3_sm : i_preset == 'SIL' ? sil_w3_sm : i_preset == 'MES-AJAY' ? ajay_w3_sm : i_preset == 'XAUUSD' ? mgc_w3_sm : i_preset == 'EURUSD' ? eur_w3_sm : i_preset == 'GBPUSD' ? gbp_w3_sm : i_preset == 'USDJPY' ? usdj_w3_sm : i_preset == 'AUDUSD' ? aud_w3_sm : i_preset == 'EURGBP' ? eurgbp_w3_sm : i_preset == 'EURJPY' ? eurjpy_w3_sm : i_preset == 'EURAUD' ? euraud_w3_sm : i_preset == 'GBPJPY' ? gbpjpy_w3_sm : i_preset == 'GBPAUD' ? gbpaud_w3_sm : i_preset == 'AUDJPY' ? audjpy_w3_sm : m2k_w3_sm : i_block3StartMin
p_w3_eh = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w3_eh : i_preset == 'MNQ' ? mnq_w3_eh : i_preset == 'MGC' ? mgc_w3_eh : i_preset == 'SIL' ? sil_w3_eh : i_preset == 'MES-AJAY' ? ajay_w3_eh : i_preset == 'XAUUSD' ? mgc_w3_eh : i_preset == 'EURUSD' ? eur_w3_eh : i_preset == 'GBPUSD' ? gbp_w3_eh : i_preset == 'USDJPY' ? usdj_w3_eh : i_preset == 'AUDUSD' ? aud_w3_eh : i_preset == 'EURGBP' ? eurgbp_w3_eh : i_preset == 'EURJPY' ? eurjpy_w3_eh : i_preset == 'EURAUD' ? euraud_w3_eh : i_preset == 'GBPJPY' ? gbpjpy_w3_eh : i_preset == 'GBPAUD' ? gbpaud_w3_eh : i_preset == 'AUDJPY' ? audjpy_w3_eh : m2k_w3_eh : i_block3EndHour
p_w3_em = i_useOptimizedTimeFilter ? i_preset == 'MES' ? mes_w3_em : i_preset == 'MNQ' ? mnq_w3_em : i_preset == 'MGC' ? mgc_w3_em : i_preset == 'SIL' ? sil_w3_em : i_preset == 'MES-AJAY' ? ajay_w3_em : i_preset == 'XAUUSD' ? mgc_w3_em : i_preset == 'EURUSD' ? eur_w3_em : i_preset == 'GBPUSD' ? gbp_w3_em : i_preset == 'USDJPY' ? usdj_w3_em : i_preset == 'AUDUSD' ? aud_w3_em : i_preset == 'EURGBP' ? eurgbp_w3_em : i_preset == 'EURJPY' ? eurjpy_w3_em : i_preset == 'EURAUD' ? euraud_w3_em : i_preset == 'GBPJPY' ? gbpjpy_w3_em : i_preset == 'GBPAUD' ? gbpaud_w3_em : i_preset == 'AUDJPY' ? audjpy_w3_em : m2k_w3_em : i_block3EndMin

block1StartMins = p_w1_sh * 60 + p_w1_sm
block1EndMins = p_w1_eh * 60 + p_w1_em
block2StartMins = p_w2_sh * 60 + p_w2_sm
block2EndMins = p_w2_eh * 60 + p_w2_em
block3StartMins = p_w3_sh * 60 + p_w3_sm
block3EndMins = p_w3_eh * 60 + p_w3_em

inBlockWindow1 = p_w1_on and (block1StartMins <= block1EndMins ? barMins >= block1StartMins and barMins < block1EndMins : barMins >= block1StartMins or barMins < block1EndMins)
inBlockWindow2 = p_w2_on and (block2StartMins <= block2EndMins ? barMins >= block2StartMins and barMins < block2EndMins : barMins >= block2StartMins or barMins < block2EndMins)
inBlockWindow3 = p_w3_on and (block3StartMins <= block3EndMins ? barMins >= block3StartMins and barMins < block3EndMins : barMins >= block3StartMins or barMins < block3EndMins)
inBlockedWindow = inBlockWindow1 or inBlockWindow2 or inBlockWindow3
// ── Day of Week resolver — preset vs manual ───────────────────────────────────
// When i_useOptimizedDOW is ON: use per-instrument preset DOW defaults.
// When OFF (manual): use the user-configured i_trade* toggles directly.
// v3.0.1: decoupled from i_useOptimizedTimeFilter (which now governs block windows only).
p_dow_sun = i_useOptimizedDOW ? i_preset == 'MES' ? mes_dow_sun : i_preset == 'MNQ' ? mnq_dow_sun : i_preset == 'MGC' ? mgc_dow_sun : i_preset == 'SIL' ? sil_dow_sun : i_preset == 'M2K' ? m2k_dow_sun : true : i_tradeSun
p_dow_mon = i_useOptimizedDOW ? i_preset == 'MES' ? mes_dow_mon : i_preset == 'MNQ' ? mnq_dow_mon : i_preset == 'MGC' ? mgc_dow_mon : i_preset == 'SIL' ? sil_dow_mon : i_preset == 'M2K' ? m2k_dow_mon : true : i_tradeMon
p_dow_tue = i_useOptimizedDOW ? i_preset == 'MES' ? mes_dow_tue : i_preset == 'MNQ' ? mnq_dow_tue : i_preset == 'MGC' ? mgc_dow_tue : i_preset == 'SIL' ? sil_dow_tue : i_preset == 'M2K' ? m2k_dow_tue : true : i_tradeTue
p_dow_wed = i_useOptimizedDOW ? i_preset == 'MES' ? mes_dow_wed : i_preset == 'MNQ' ? mnq_dow_wed : i_preset == 'MGC' ? mgc_dow_wed : i_preset == 'SIL' ? sil_dow_wed : i_preset == 'M2K' ? m2k_dow_wed : true : i_tradeWed
p_dow_thu = i_useOptimizedDOW ? i_preset == 'MES' ? mes_dow_thu : i_preset == 'MNQ' ? mnq_dow_thu : i_preset == 'MGC' ? mgc_dow_thu : i_preset == 'SIL' ? sil_dow_thu : i_preset == 'M2K' ? m2k_dow_thu : true : i_tradeThu
p_dow_fri = i_useOptimizedDOW ? i_preset == 'MES' ? mes_dow_fri : i_preset == 'MNQ' ? mnq_dow_fri : i_preset == 'MGC' ? mgc_dow_fri : i_preset == 'SIL' ? sil_dow_fri : i_preset == 'M2K' ? m2k_dow_fri : true : i_tradeFri

// dayofweek() returns 1=Sun, 2=Mon, 3=Tue, 4=Wed, 5=Thu, 6=Fri, 7=Sat (Pine v6)
_dow = dayofweek(time, syminfo.timezone)
dowAllowed = not i_useDOW or _dow == dayofweek.sunday and p_dow_sun or _dow == dayofweek.monday and p_dow_mon or _dow == dayofweek.tuesday and p_dow_tue or _dow == dayofweek.wednesday and p_dow_wed or _dow == dayofweek.thursday and p_dow_thu or _dow == dayofweek.friday and p_dow_fri

entryTimeAllowed = timeAllowed and not inBlockedWindow and dowAllowed // v3.0.1: DOW filter

eodBarMins = hour(time, 'America/Chicago') * 60 + minute(time, 'America/Chicago')
eodCutoffMins = 15 * 60 + 50
eodResumeMins = 17 * 60 + 0
eodReached = i_useEODCutoff and eodBarMins >= eodCutoffMins and eodBarMins < eodResumeMins

// ============================================================
// === FOREX STRENGTH GATE (v2.0) ===
// Embeds currency strength meter logic directly into MITS.
// Uses percentage change over p_fxLookback bars across 10 pairs
// to compute net strength for EUR, USD, GBP, JPY, AUD.
// Gate only activates when p_isForex = true.
// XAUUSD gates on USD strength only (gold vs dollar).
// Per-preset gate params (v2.0.2): XAUUSD uses tuned values;
// all other forex pairs use global input defaults.
// ============================================================

// ── Per-preset gate param resolvers ─────────────────────────
// XAUUSD: tuned lookback=528/minDiv=0.25% (optimizer confirmed)
// All others: fall back to global i_fxLookback / i_fxMinDiv inputs
p_fxLookback = i_fxLookback
p_fxMinDiv = i_fxMinDiv

// v3.1.9 FIX: single security call per pair — offset applied to the returned
// series locally. Identical math, halves security-call budget (20 -> 10).
fx_getStr(sym) =>
    s = request.security(sym, timeframe.period, close, gaps = barmerge.gaps_off)
    s[p_fxLookback] != 0 ? (s - s[p_fxLookback]) / s[p_fxLookback] * 100 : 0.0

// Pull all 10 pairs
fx_eurusd = fx_getStr('EURUSD')
fx_eurgbp = fx_getStr('EURGBP')
fx_eurjpy = fx_getStr('EURJPY')
fx_euraud = fx_getStr('EURAUD')
fx_gbpusd = fx_getStr('GBPUSD')
fx_gbpjpy = fx_getStr('GBPJPY')
fx_gbpaud = fx_getStr('GBPAUD')
fx_usdjpy = fx_getStr('USDJPY')
fx_audusd = fx_getStr('AUDUSD')
fx_audjpy = fx_getStr('AUDJPY')

// Net strength per currency (each weighted across 4 pairs)
fx_eur = (fx_eurusd + fx_eurgbp + fx_eurjpy + fx_euraud) / 4
fx_usd = (-fx_eurusd - fx_gbpusd - fx_audusd + fx_usdjpy) / 4
fx_gbp = (fx_gbpusd - fx_eurgbp + fx_gbpjpy + fx_gbpaud) / 4
fx_jpy = (-fx_eurjpy - fx_gbpjpy - fx_usdjpy - fx_audjpy) / 4
fx_aud = (fx_audusd - fx_euraud - fx_gbpaud + fx_audjpy) / 4

// Resolve base and quote strength for active preset
// XAUUSD: base=XAU (no direct score) — use inverted USD as proxy
fx_base_str = i_preset == 'EURUSD' ? fx_eur : i_preset == 'GBPUSD' ? fx_gbp : i_preset == 'AUDUSD' ? fx_aud : i_preset == 'USDJPY' ? fx_usd : i_preset == 'EURGBP' ? fx_eur : i_preset == 'EURJPY' ? fx_eur : i_preset == 'EURAUD' ? fx_eur : i_preset == 'GBPJPY' ? fx_gbp : i_preset == 'GBPAUD' ? fx_gbp : i_preset == 'AUDJPY' ? fx_aud : i_preset == 'XAUUSD' ? -fx_usd : 0.0 // gold = inverse USD

fx_quote_str = i_preset == 'EURUSD' ? fx_usd : i_preset == 'GBPUSD' ? fx_usd : i_preset == 'AUDUSD' ? fx_usd : i_preset == 'USDJPY' ? fx_jpy : i_preset == 'EURGBP' ? fx_gbp : i_preset == 'EURJPY' ? fx_jpy : i_preset == 'EURAUD' ? fx_aud : i_preset == 'GBPJPY' ? fx_jpy : i_preset == 'GBPAUD' ? fx_aud : i_preset == 'AUDJPY' ? fx_jpy : i_preset == 'XAUUSD' ? fx_usd : 0.0

fx_divergence = fx_base_str - fx_quote_str

// Gate logic — uses p_fxMinDiv (preset-resolved) not i_fxMinDiv directly
// Long: base stronger than quote by at least p_fxMinDiv
// Short: base weaker than quote by at least p_fxMinDiv
// Futures: gate always passes
fxGate_bull = not p_isForex or i_preset == 'XAUUSD' or not i_useFXGate or fx_divergence >= p_fxMinDiv
fxGate_bear = not p_isForex or i_preset == 'XAUUSD' or not i_useFXGate or fx_divergence <= -p_fxMinDiv
fxGateStr = not p_isForex ? 'N/A' : i_preset == 'XAUUSD' ? 'N/A (15m)' : not i_useFXGate ? 'OFF' : fx_divergence >= p_fxMinDiv ? 'LONG-OK' : fx_divergence <= -p_fxMinDiv ? 'SHORT-OK' : 'BLOCKED'

// ============================================================
// === CURRENCY STRENGTH DIVERGENCE STRATEGY (v1.0) ===
// Walk-forward validated params (W2/W3 PASS):
//   min_div=0.05, confirm=36 5m bars (3 H1), stability=24 5m bars (2 H1)
//   soft_exit=0.4, max_bars=576 5m bars (48 H1), trend=true
// Active only when p_isDivForex = true (forex, not XAUUSD).
// Reuses existing security calls; normalizes via ta.stdev() — 0 extra calls.
// ============================================================

// Volatility-normalize each pair's raw return
_dv_euru = ta.stdev(fx_eurusd, i_divNormWindow) > 1e-8 ? fx_eurusd / ta.stdev(fx_eurusd, i_divNormWindow) : 0.0
_dv_eurg = ta.stdev(fx_eurgbp, i_divNormWindow) > 1e-8 ? fx_eurgbp / ta.stdev(fx_eurgbp, i_divNormWindow) : 0.0
_dv_eurj = ta.stdev(fx_eurjpy, i_divNormWindow) > 1e-8 ? fx_eurjpy / ta.stdev(fx_eurjpy, i_divNormWindow) : 0.0
_dv_eura = ta.stdev(fx_euraud, i_divNormWindow) > 1e-8 ? fx_euraud / ta.stdev(fx_euraud, i_divNormWindow) : 0.0
_dv_gbpu = ta.stdev(fx_gbpusd, i_divNormWindow) > 1e-8 ? fx_gbpusd / ta.stdev(fx_gbpusd, i_divNormWindow) : 0.0
_dv_gbpj = ta.stdev(fx_gbpjpy, i_divNormWindow) > 1e-8 ? fx_gbpjpy / ta.stdev(fx_gbpjpy, i_divNormWindow) : 0.0
_dv_gbpa = ta.stdev(fx_gbpaud, i_divNormWindow) > 1e-8 ? fx_gbpaud / ta.stdev(fx_gbpaud, i_divNormWindow) : 0.0
_dv_usdy = ta.stdev(fx_usdjpy, i_divNormWindow) > 1e-8 ? fx_usdjpy / ta.stdev(fx_usdjpy, i_divNormWindow) : 0.0
_dv_audu = ta.stdev(fx_audusd, i_divNormWindow) > 1e-8 ? fx_audusd / ta.stdev(fx_audusd, i_divNormWindow) : 0.0
_dv_audj = ta.stdev(fx_audjpy, i_divNormWindow) > 1e-8 ? fx_audjpy / ta.stdev(fx_audjpy, i_divNormWindow) : 0.0

// Normalized net currency strength (same sign convention as FX gate)
div_eur = (_dv_euru + _dv_eurg + _dv_eurj + _dv_eura) / 4
div_usd = (-_dv_euru - _dv_gbpu - _dv_audu + _dv_usdy) / 4
div_gbp = (_dv_gbpu - _dv_eurg + _dv_gbpj + _dv_gbpa) / 4
div_jpy = (-_dv_eurj - _dv_gbpj - _dv_usdy - _dv_audj) / 4
div_aud = (_dv_audu - _dv_eura - _dv_gbpa + _dv_audj) / 4

// Strongest and weakest currency
div_maxStr = math.max(div_eur, div_usd, div_gbp, div_jpy, div_aud)
div_minStr = math.min(div_eur, div_usd, div_gbp, div_jpy, div_aud)
div_totDiv = div_maxStr - div_minStr // aggregate divergence across all currencies

// Base and quote strength for the currently active preset
div_base_str = i_preset == 'EURUSD' ? div_eur : i_preset == 'GBPUSD' ? div_gbp : i_preset == 'AUDUSD' ? div_aud : i_preset == 'USDJPY' ? div_usd : i_preset == 'EURGBP' ? div_eur : i_preset == 'EURJPY' ? div_eur : i_preset == 'EURAUD' ? div_eur : i_preset == 'GBPJPY' ? div_gbp : i_preset == 'GBPAUD' ? div_gbp : i_preset == 'AUDJPY' ? div_aud : 0.0

div_quote_str = i_preset == 'EURUSD' ? div_usd : i_preset == 'GBPUSD' ? div_usd : i_preset == 'AUDUSD' ? div_usd : i_preset == 'USDJPY' ? div_jpy : i_preset == 'EURGBP' ? div_gbp : i_preset == 'EURJPY' ? div_jpy : i_preset == 'EURAUD' ? div_aud : i_preset == 'GBPJPY' ? div_jpy : i_preset == 'GBPAUD' ? div_aud : i_preset == 'AUDJPY' ? div_jpy : 0.0

// Pair divergence: positive = base stronger (long bias), negative = base weaker (short bias)
div_pair_div = div_base_str - div_quote_str

// Is this pair currently the strongest-vs-weakest pair?
div_pairIsBull = div_base_str == div_maxStr and div_quote_str == div_minStr
div_pairIsBear = div_base_str == div_minStr and div_quote_str == div_maxStr

// Stability counters: consecutive bars same direction AND divergence expanding
var int div_stableCount = 0
var int div_expandCount = 0
var float div_prevAbsDiv = 0.0
var bool div_prevWasBull = false
var bool div_prevWasBear = false

div_continuing = div_pairIsBull and div_prevWasBull or div_pairIsBear and div_prevWasBear
div_expanding = math.abs(div_pair_div) > div_prevAbsDiv

div_stableCount := div_continuing ? div_stableCount + 1 : 1
div_expandCount := div_expanding and (div_pairIsBull or div_pairIsBear) ? div_expandCount + 1 : 1

div_prevAbsDiv := math.abs(div_pair_div)
div_prevWasBull := div_pairIsBull
div_prevWasBear := div_pairIsBear

// Trend filter: EMA-50 on chart timeframe
div_ema50 = ta.ema(close, 50)
div_trendBull = not i_divUseTrend or close > div_ema50
div_trendBear = not i_divUseTrend or close < div_ema50

// Session filter: UTC 08:00 - 22:00
div_sessionHour = hour(time, 'UTC')
div_inSession = not i_divSession or div_sessionHour >= 8 and div_sessionHour < 22

// Entry gate: all conditions met
div_entryGate = div_totDiv >= i_divMinDiv and div_stableCount >= i_divConfirmBars and div_expandCount >= i_divStabilityBars and div_inSession and not eodReached

// Entry signals (only when flat — div strategy does not flip)
divSignal_bull = p_isDivForex and strategy.position_size == 0 and div_entryGate and div_pairIsBull and div_trendBull
divSignal_bear = p_isDivForex and strategy.position_size == 0 and div_entryGate and div_pairIsBear and div_trendBear

// Soft exit state: track entry divergence and bars held
var float div_entryDiv = na
var int div_barsHeld = 0

if p_isDivForex and strategy.position_size != 0
    div_barsHeld := div_barsHeld + 1
    div_barsHeld
else
    div_barsHeld := 0
    div_barsHeld

// Capture entry divergence on the bar the position opens
if p_isDivForex and strategy.position_size != 0 and strategy.position_size[1] == 0
    div_entryDiv := math.abs(div_pair_div)
    div_entryDiv

// Soft exit: pair divergence decayed below threshold
div_softExit = p_isDivForex and strategy.position_size != 0 and not na(div_entryDiv) and math.abs(div_pair_div) < div_entryDiv * i_divSoftExit

// Max bars exit
div_maxExit = p_isDivForex and strategy.position_size != 0 and div_barsHeld >= i_divMaxBars

// Div info string for panel
divStratStr = not p_isDivForex ? p_isForex ? 'OFF' : 'N/A' : divSignal_bull ? 'BULL-ENTRY' : divSignal_bear ? 'BEAR-ENTRY' : div_entryGate and div_pairIsBull ? 'BULL-OK' : div_entryGate and div_pairIsBear ? 'BEAR-OK' : strategy.position_size > 0 ? 'LONG (' + str.tostring(div_barsHeld) + 'b)' : strategy.position_size < 0 ? 'SHORT (' + str.tostring(div_barsHeld) + 'b)' : 'WAIT'

// ============================================================
// === CONFLUENCE SCORING ===
// ============================================================
bullScore = (c1_bull ? 1 : 0) + (c2_bull ? 1 : 0) + (c3_bull ? 1 : 0) + (c4_bull ? 1 : 0) + (c5_bull ? 1 : 0) + (c6_bull ? 1 : 0) + (c7_bull ? 1 : 0) + (c8_bull ? 1 : 0) + (c9_bull ? 1 : 0)
bearScore = (c1_bear ? 1 : 0) + (c2_bear ? 1 : 0) + (c3_bear ? 1 : 0) + (c4_bear ? 1 : 0) + (c5_bear ? 1 : 0) + (c6_bear ? 1 : 0) + (c7_bear ? 1 : 0) + (c8_bear ? 1 : 0) + (c9_bear ? 1 : 0)

// Divergence strategy replaces confluence when p_isDivForex; standard path otherwise
regimeFilter_bull = not p_useRegime or rh_score >= i_regimeMinScore
regimeFilter_bear = not p_useRegime or rh_score <= -i_regimeMinScore

// === SESSION LOSS POLICY STATE (v3.1.12) ===
// Same-bar gating via strategy.closedtrades (updates on intrabar fills, so a
// stop-out earlier in this bar gates this bar close signal — matches engine
// v2.3 semantics). State resets on the 17:00 CT session-open bar.
i_useLossPolicy = input.bool(true, 'Enable Session Loss Policy', group = 'Filters', tooltip = 'After N consecutive same-direction losses in a session, block that direction until the next session (opposite side stays live). Preset defaults: MNQ/M2K/MES on, MGC/SIL off.')
i_lossStreakN = input.int(2, 'Loss Streak Trigger (N)', minval = 1, maxval = 5, group = 'Filters')
i_dailyLossLimit = input.float(0.0, 'Daily Loss Limit $ (0 = off)', minval = -5000.0, maxval = 0.0, step = 50.0, group = 'Filters', tooltip = 'Soft gate: blocks ALL new entries when session realized P&L drops to or below this value. Resets automatically at 17:00 CT (ETH session open). Set to 0 to disable. Example: -300 blocks new entries after $300 session loss. Does NOT close open positions — broker SL/TP handles that.')

var int lp_dir = 0
var int lp_count = 0
var int lp_closedSeen = 0
var float v3_sessionPnlStart = 0.0 // DLL: snapshot of strategy.netprofit at session open (17:00 CT reset)
if eodBarMins == 17 * 60
    lp_dir := 0
    lp_count := 0
    v3_sessionPnlStart := strategy.netprofit // DLL: snapshot net profit at session open
    v3_sessionPnlStart
while lp_closedSeen < strategy.closedtrades
    _lpPnl = strategy.closedtrades.profit(lp_closedSeen)
    _lpDir = strategy.closedtrades.size(lp_closedSeen) > 0 ? 1 : -1
    if _lpPnl <= 0
        if _lpDir == lp_dir
            lp_count := lp_count + 1
            lp_count
        else
            lp_dir := _lpDir
            lp_count := 1
            lp_count
    else
        lp_dir := 0
        lp_count := 0
        lp_count
    lp_closedSeen := lp_closedSeen + 1
    lp_closedSeen
lp_active = i_useLossPolicy and p_lossPolicy and lp_count >= i_lossStreakN
lpBlockBull = lp_active and lp_dir == 1
lpBlockBear = lp_active and lp_dir == -1

// DLL soft gate — blocks new entries when session P&L <= i_dailyLossLimit.
// v3_runningPnl = net profit since last 17:00 CT reset. Gate disabled when limit = 0.
v3_runningPnl = strategy.netprofit - v3_sessionPnlStart
dll_gate = i_dailyLossLimit == 0.0 or v3_runningPnl > i_dailyLossLimit

bullSignal = (p_isDivForex ? divSignal_bull : bullScore >= p_conf and rsiFilter_bull and adxFilter and entryTimeAllowed and not eodReached and fxGate_bull and regimeFilter_bull) and not lpBlockBull and dll_gate
bearSignal = (p_isDivForex ? divSignal_bear : bearScore >= p_conf and rsiFilter_bear and adxFilter and entryTimeAllowed and not eodReached and fxGate_bear and regimeFilter_bear) and not lpBlockBear and dll_gate

// BUG FIX 2026-06-26: capture the confluence score at the exact bar the signal
// fires, not later at fill time. strategy() executes orders on bar close, so by
// the time strategy.position_size flips (one bar after the signal), bullScore/
// bearScore have already moved on to the new bar's value -- causing wh_entryConf
// below to silently log the WRONG (off-by-one-bar) confluence number. This was
// confirmed via real trade data: logged confluence of 5 and 8 on trades that only
// could have fired at the locked threshold of 9. The trade logic itself was never
// wrong (bullSignal/bearSignal correctly gate on >=9) -- only the LOGGED record of
// what fired was stale. Persist the signal-bar's score here, read it back at fill.
var int pendingSignalConf = na
if bullSignal
    pendingSignalConf := bullScore
    pendingSignalConf
if bearSignal
    pendingSignalConf := bearScore
    pendingSignalConf

// === CONFLUENCE FINGERPRINT (v3.1.10) ===
// 9-bit string, C1..C9 left to right, evaluated on the signal bar for the
// fired direction. Logged to AlertLog (entry) and TradeLog (exit) so
// per-confluence outcome data accumulates for future weighted-scoring
// research. Same signal-bar capture discipline as pendingSignalConf
// (see BUG FIX 2026-06-26 above). Informational only — no signal impact.
confBits_bull = (c1_bull ? '1' : '0') + (c2_bull ? '1' : '0') + (c3_bull ? '1' : '0') + (c4_bull ? '1' : '0') + (c5_bull ? '1' : '0') + (c6_bull ? '1' : '0') + (c7_bull ? '1' : '0') + (c8_bull ? '1' : '0') + (c9_bull ? '1' : '0')
confBits_bear = (c1_bear ? '1' : '0') + (c2_bear ? '1' : '0') + (c3_bear ? '1' : '0') + (c4_bear ? '1' : '0') + (c5_bear ? '1' : '0') + (c6_bear ? '1' : '0') + (c7_bear ? '1' : '0') + (c8_bear ? '1' : '0') + (c9_bear ? '1' : '0')

var string pendingSignalBits = na
if bullSignal
    pendingSignalBits := confBits_bull
    pendingSignalBits
if bearSignal
    pendingSignalBits := confBits_bear
    pendingSignalBits

// ============================================================
// === DIAGNOSTICS: Confluence Delay Detector ===
// ============================================================
var int bullFlip1 = na
var int bullFlip2 = na
var int bullFlip3 = na
var int bullFlip4 = na
var int bullFlip5 = na
var int bullFlip6 = na
var int bullFlip7 = na
var int bullFlip8 = na
var int bullFlip9 = na
var int bearFlip1 = na
var int bearFlip2 = na
var int bearFlip3 = na
var int bearFlip4 = na
var int bearFlip5 = na
var int bearFlip6 = na
var int bearFlip7 = na
var int bearFlip8 = na
var int bearFlip9 = na

if c1_bull and not c1_bull[1]
    bullFlip1 := bar_index
    bullFlip1
if c2_bull and not c2_bull[1]
    bullFlip2 := bar_index
    bullFlip2
if c3_bull and not c3_bull[1]
    bullFlip3 := bar_index
    bullFlip3
if c4_bull and not c4_bull[1]
    bullFlip4 := bar_index
    bullFlip4
if c5_bull and not c5_bull[1]
    bullFlip5 := bar_index
    bullFlip5
if c6_bull and not c6_bull[1]
    bullFlip6 := bar_index
    bullFlip6
if c7_bull and not c7_bull[1]
    bullFlip7 := bar_index
    bullFlip7
if c8_bull and not c8_bull[1]
    bullFlip8 := bar_index
    bullFlip8
if c9_bull and not c9_bull[1]
    bullFlip9 := bar_index
    bullFlip9

if c1_bear and not c1_bear[1]
    bearFlip1 := bar_index
    bearFlip1
if c2_bear and not c2_bear[1]
    bearFlip2 := bar_index
    bearFlip2
if c3_bear and not c3_bear[1]
    bearFlip3 := bar_index
    bearFlip3
if c4_bear and not c4_bear[1]
    bearFlip4 := bar_index
    bearFlip4
if c5_bear and not c5_bear[1]
    bearFlip5 := bar_index
    bearFlip5
if c6_bear and not c6_bear[1]
    bearFlip6 := bar_index
    bearFlip6
if c7_bear and not c7_bear[1]
    bearFlip7 := bar_index
    bearFlip7
if c8_bear and not c8_bear[1]
    bearFlip8 := bar_index
    bearFlip8
if c9_bear and not c9_bear[1]
    bearFlip9 := bar_index
    bearFlip9

f_confName(_idx) =>
    string _name = 'n/a'

    if _idx == 1
        _name := '1 EMA Trend'
        _name
    else if _idx == 2
        _name := '2 Price Pos'
        _name
    else if _idx == 3
        _name := '3 WaveTrend'
        _name
    else if _idx == 4
        _name := '4 Momentum'
        _name
    else if _idx == 5
        _name := '5 Candle'
        _name
    else if _idx == 6
        _name := '6 Sqz+Break'
        _name
    else if _idx == 7
        _name := '7 SmartTrail'
        _name
    else if _idx == 8
        _name := '8 Vol Flow'
        _name
    else if _idx == 9
        _name := '9 SMC'
        _name

    _name

f_confColor(_idx, _isBull) =>
    color _c = _isBull ? color.new(color.green, 70) : color.new(color.red, 70)

    if _idx == 1
        _c := _isBull ? color.new(color.blue, 65) : color.new(color.blue, 80)
        _c
    else if _idx == 2
        _c := _isBull ? color.new(color.teal, 65) : color.new(color.teal, 80)
        _c
    else if _idx == 3
        _c := _isBull ? color.new(color.purple, 65) : color.new(color.purple, 80)
        _c
    else if _idx == 4
        _c := _isBull ? color.new(color.orange, 65) : color.new(color.orange, 80)
        _c
    else if _idx == 5
        _c := _isBull ? color.new(color.green, 65) : color.new(color.red, 80)
        _c
    else if _idx == 6
        _c := _isBull ? color.new(color.yellow, 55) : color.new(color.maroon, 75)
        _c
    else if _idx == 7
        _c := _isBull ? color.new(color.aqua, 60) : color.new(color.navy, 75)
        _c
    else if _idx == 8
        _c := _isBull ? color.new(color.lime, 60) : color.new(color.fuchsia, 75)
        _c
    else if _idx == 9
        _c := _isBull ? color.new(color.silver, 60) : color.new(color.gray, 75)
        _c

    _c

f_timelineSize(_sz) =>
    _out = size.normal

    if _sz == 'Tiny'
        _out := size.tiny
        _out
    else if _sz == 'Small'
        _out := size.small
        _out
    else if _sz == 'Large'
        _out := size.large
        _out

    _out


f_confShortName(_idx) =>
    string _name = 'n/a'

    if _idx == 1
        _name := 'EMA Trend'
        _name
    else if _idx == 2
        _name := 'Price Pos'
        _name
    else if _idx == 3
        _name := 'WaveTrend'
        _name
    else if _idx == 4
        _name := 'Momentum'
        _name
    else if _idx == 5
        _name := 'Candle'
        _name
    else if _idx == 6
        _name := 'Sqz+Break'
        _name
    else if _idx == 7
        _name := 'SmartTrail'
        _name
    else if _idx == 8
        _name := 'Vol Flow'
        _name
    else if _idx == 9
        _name := 'SMC'
        _name

    _name

f_calloutText(_isBull, _score, _thr, _lastIdx, _lastAgo, _showBars) =>
    string _head = _isBull ? 'B ' : 'S '
    string _txt = _head + str.tostring(_score) + '/' + str.tostring(_thr) + '\n' + f_confShortName(_lastIdx)
    _txt := _txt + (_showBars and not na(_lastAgo) ? '\n' + str.tostring(_lastAgo) + 'b' : '')
    _txt


// Return [lastIdx, barsAgo] for bull/bear based on "most recently flipped TRUE"
f_lastFlip(_b1, _b2, _b3, _b4, _b5, _b6, _b7, _b8, _b9, _f1, _f2, _f3, _f4, _f5, _f6, _f7, _f8, _f9) =>
    int lastIdx = na
    int lastBar = na
    if _b1 and not na(_f1)
        lastIdx := 1
        lastBar := _f1
        lastBar
    if _b2 and not na(_f2) and (na(lastBar) or _f2 > lastBar)
        lastIdx := 2
        lastBar := _f2
        lastBar
    if _b3 and not na(_f3) and (na(lastBar) or _f3 > lastBar)
        lastIdx := 3
        lastBar := _f3
        lastBar
    if _b4 and not na(_f4) and (na(lastBar) or _f4 > lastBar)
        lastIdx := 4
        lastBar := _f4
        lastBar
    if _b5 and not na(_f5) and (na(lastBar) or _f5 > lastBar)
        lastIdx := 5
        lastBar := _f5
        lastBar
    if _b6 and not na(_f6) and (na(lastBar) or _f6 > lastBar)
        lastIdx := 6
        lastBar := _f6
        lastBar
    if _b7 and not na(_f7) and (na(lastBar) or _f7 > lastBar)
        lastIdx := 7
        lastBar := _f7
        lastBar
    if _b8 and not na(_f8) and (na(lastBar) or _f8 > lastBar)
        lastIdx := 8
        lastBar := _f8
        lastBar
    if _b9 and not na(_f9) and (na(lastBar) or _f9 > lastBar)
        lastIdx := 9
        lastBar := _f9
        lastBar
    int barsAgo = na(lastBar) ? na : bar_index - lastBar
    [lastIdx, barsAgo]

// Compute delay text only when signals are true (Mode 2B: even if entry is blocked)

int bullLastIdx = na
int bullLastAgo = na
int bearLastIdx = na
int bearLastAgo = na
string bullDelayTxt = ''
string bearDelayTxt = ''
string bullTimelineTxt = ''
string bearTimelineTxt = ''

if i_showDelay and bullSignal
    [bullLastIdx, bullLastAgo] = f_lastFlip(c1_bull, c2_bull, c3_bull, c4_bull, c5_bull, c6_bull, c7_bull, c8_bull, c9_bull, bullFlip1, bullFlip2, bullFlip3, bullFlip4, bullFlip5, bullFlip6, bullFlip7, bullFlip8, bullFlip9)
    bullDelayTxt := na(bullLastIdx) ? 'Last: n/a' : 'Last: ' + f_confName(bullLastIdx) + (i_timelineShowBars and not na(bullLastAgo) ? ' (' + str.tostring(bullLastAgo) + ' bars ago)' : '')
    bullTimelineTxt := na(bullLastIdx) ? 'B ' + str.tostring(bullScore) + '/' + str.tostring(p_conf) + '\nLast: n/a' : 'B ' + str.tostring(bullScore) + '/' + str.tostring(p_conf) + '\n' + f_confName(bullLastIdx) + (i_timelineShowBars and not na(bullLastAgo) ? '\n' + str.tostring(bullLastAgo) + ' bars' : '')
    bullTimelineTxt

if i_showDelay and bearSignal
    [bearLastIdx, bearLastAgo] = f_lastFlip(c1_bear, c2_bear, c3_bear, c4_bear, c5_bear, c6_bear, c7_bear, c8_bear, c9_bear, bearFlip1, bearFlip2, bearFlip3, bearFlip4, bearFlip5, bearFlip6, bearFlip7, bearFlip8, bearFlip9)
    bearDelayTxt := na(bearLastIdx) ? 'Last: n/a' : 'Last: ' + f_confName(bearLastIdx) + (i_timelineShowBars and not na(bearLastAgo) ? ' (' + str.tostring(bearLastAgo) + ' bars ago)' : '')
    bearTimelineTxt := na(bearLastIdx) ? 'S ' + str.tostring(bearScore) + '/' + str.tostring(p_conf) + '\nLast: n/a' : 'S ' + str.tostring(bearScore) + '/' + str.tostring(p_conf) + '\n' + f_confName(bearLastIdx) + (i_timelineShowBars and not na(bearLastAgo) ? '\n' + str.tostring(bearLastAgo) + ' bars' : '')
    bearTimelineTxt

if i_showTimelineLbl and bullSignal
    bullCalloutStack := bullSignal[1] ? bullCalloutStack + 1 : 0
    bullCalloutTxt = f_calloutText(true, bullScore, p_conf, bullLastIdx, bullLastAgo, i_timelineShowBars)
    label.new(bar_index, low - atrVal * (i_calloutOffsetATR + bullCalloutStack * i_calloutStackATR), bullCalloutTxt, style = label.style_label_up, textcolor = color.white, color = color.new(f_confColor(bullLastIdx, true), i_calloutFade), size = f_timelineSize(i_timelineLblSize))

if i_showTimelineLbl and bearSignal
    bearCalloutStack := bearSignal[1] ? bearCalloutStack + 1 : 0
    bearCalloutTxt = f_calloutText(false, bearScore, p_conf, bearLastIdx, bearLastAgo, i_timelineShowBars)
    label.new(bar_index, high + atrVal * (i_calloutOffsetATR + bearCalloutStack * i_calloutStackATR), bearCalloutTxt, style = label.style_label_down, textcolor = color.white, color = color.new(f_confColor(bearLastIdx, false), i_calloutFade), size = f_timelineSize(i_timelineLblSize))

if not bullSignal
    bullCalloutStack := 0
    bullCalloutStack
if not bearSignal
    bearCalloutStack := 0
    bearCalloutStack

plotshape(i_showEntryMarks and bullSignal, title = 'DEBUG BullSignal', style = shape.circle, size = size.tiny, location = location.belowbar, color = color.new(color.green, 0))
plotshape(i_showEntryMarks and bearSignal, title = 'DEBUG BearSignal', style = shape.circle, size = size.tiny, location = location.abovebar, color = color.new(color.red, 0))

// ============================================================
// === ATR DISTANCES — used for exit placement and projections ===
// ============================================================
sl1 = atrVal * p_sl1
tp1 = atrVal * p_tp1
tp2 = atrVal * p_tp2

// Estimated levels from signal-bar close — used for webhook payloads
// and projected lines only. Actual bracket uses real fill price below.
// math.round_to_mintick() ensures prices align to instrument tick size —
// prevents order rejections on Tradovate/Ghost from non-tick-aligned values.
longTP1 = math.round_to_mintick(close + tp1)
longTP2 = math.round_to_mintick(close + tp2)
longSL1 = math.round_to_mintick(close - sl1)
shortTP1 = math.round_to_mintick(close - tp1)
shortTP2 = math.round_to_mintick(close - tp2)
shortSL1 = math.round_to_mintick(close + sl1)

// ============================================================
// === STRATEGY ENTRIES & EXITS ===
// ============================================================
// v1.3.5 fill-price fix: exits placed AFTER position opens using
// strategy.position_avg_price (actual fill price), not signal-bar close.
// ATR distances frozen at signal time so they don't drift on later bars.
//
// Flow:
//   Signal bar  → strategy.entry() fires, ATR distances frozen
//   Next bar    → position opens, exits placed from real fill price
// ============================================================

// Persistent ATR distances frozen at signal time
var float entry_tp1_dist = na
var float entry_tp2_dist = na
var float entry_sl1_dist = na

var bool longBEActive = false
var bool shortBEActive = false
var float longBEPrice = na
var float shortBEPrice = na

var string nv_activeOcoId = ''

isGhostMode = i_executionMode == 'Ghost'
isTVNativeMode = i_executionMode == 'TV Native'
isNinjaViewMode = i_executionMode == 'Ninja-View'
isGhostWebhook = i_webhookMode == 'Ghost Webhook' and not i_paperMode
// v3.1.16: GAS logging always active regardless of webhook mode dropdown
isSheetsWebhook = true // was: i_webhookMode == "Google Sheets Webhook"

// ============================================================
// === STRATEGY ENTRIES & EXITS ===
// ============================================================
// Fill-price bracket fix (v1.3.5): exits placed AFTER position opens
// using strategy.position_avg_price — not signal-bar close.
// ATR distances frozen at signal time so they don't drift on later bars.
//
// Ghost Webhook (v1.3.6): alert_message= on strategy.entry/exit fires
// Ghost payload precisely when Pine actually enters or exits.
// Standalone alert() also fires on entry bar for redundancy.
// Ghost deduplicates within 60s — duplicate is rejected cleanly.
//
// Flow:
//   Signal bar  → strategy.entry() fires with Ghost payload, ATR distances frozen
//   Next bar    → position opens, exits placed from real fill price with Ghost exit payload
// ============================================================

// Ghost Webhook payloads — compact format Ghost expects
// Uses syminfo.ticker (e.g. "MES1!") — Ghost accepts continuous contract format
_ghostTicker = p_isForex ? p_sym : syminfo.ticker
_ghostQtyField = p_isForex ? '"lots":' + str.tostring(p_lots, '#.##') : '"qty":' + str.tostring(p_qty)
_ghostLongEntry = '{"ticker":"' + _ghostTicker + '","action":"buy","price":' + str.tostring(math.round(close, 2)) + ',' + _ghostQtyField + ',"tp":' + str.tostring(math.round(longTP1, 2)) + ',"sl":' + str.tostring(math.round(longSL1, 2)) + ',"time":{{timenow}},"rejectAfter":30}'
_ghostShortEntry = '{"ticker":"' + _ghostTicker + '","action":"sell","price":' + str.tostring(math.round(close, 2)) + ',' + _ghostQtyField + ',"tp":' + str.tostring(math.round(shortTP1, 2)) + ',"sl":' + str.tostring(math.round(shortSL1, 2)) + ',"time":{{timenow}},"rejectAfter":30}'
_ghostExit = '{"ticker":"' + _ghostTicker + '","action":"exit"}'

// STEP 1: Fire entry — freeze ATR distances, attach Ghost payload via alert_message
if bullSignal and strategy.position_size == 0
    longBEActive := false
    longBEPrice := na
    entry_tp1_dist := tp1
    entry_sl1_dist := sl1
    entry_tp2_dist := tp2
    strategy.entry('Long', strategy.long, qty = p_qty, alert_message = _ghostLongEntry)

if bearSignal and strategy.position_size == 0
    shortBEActive := false
    shortBEPrice := na
    entry_tp1_dist := tp1
    entry_sl1_dist := sl1
    entry_tp2_dist := tp2
    strategy.entry('Short', strategy.short, qty = p_qty, alert_message = _ghostShortEntry)

// STEP 2: Place exits AFTER fill — anchored to actual entry price
// Ghost exit payload attached via alert_message= — fires precisely on TP/SL hit
if strategy.position_size != 0 and strategy.position_size[1] == 0
    _fillPrice = strategy.position_avg_price
    _isLong = strategy.position_size > 0
    _actualTP1 = math.round_to_mintick(_isLong ? _fillPrice + entry_tp1_dist : _fillPrice - entry_tp1_dist)
    _actualTP2 = math.round_to_mintick(_isLong ? _fillPrice + entry_tp2_dist : _fillPrice - entry_tp2_dist)
    _actualSL1 = math.round_to_mintick(_isLong ? _fillPrice - entry_sl1_dist : _fillPrice + entry_sl1_dist)

    if p_isDivForex
        // Divergence path: SL only — soft exit and max-bars handle normal exits
        if _isLong
            strategy.exit('Div Long SL', 'Long', stop = _actualSL1, comment = 'DIV-SL', alert_message = _ghostExit)
        else
            strategy.exit('Div Short SL', 'Short', stop = _actualSL1, comment = 'DIV-SL', alert_message = _ghostExit)
    else // Standard confluence path: full TP/SL brackets
        if _isLong
            if p_useTP2
                strategy.exit('Long TP1', 'Long', qty = p_tp1_qty, limit = _actualTP1, stop = _actualSL1, comment = 'TP1', alert_message = _ghostExit)
                strategy.exit('Long TP2', 'Long', qty = p_tp2_qty, limit = _actualTP2, stop = _actualSL1, comment = 'TP2', alert_message = _ghostExit)
            else
                strategy.exit('Long Exit', 'Long', limit = _actualTP1, stop = _actualSL1, comment = 'TP1', alert_message = _ghostExit)
        else
            if p_useTP2
                strategy.exit('Short TP1', 'Short', qty = p_tp1_qty, limit = _actualTP1, stop = _actualSL1, comment = 'TP1', alert_message = _ghostExit)
                strategy.exit('Short TP2', 'Short', qty = p_tp2_qty, limit = _actualTP2, stop = _actualSL1, comment = 'TP2', alert_message = _ghostExit)
            else
                strategy.exit('Short Exit', 'Short', limit = _actualTP1, stop = _actualSL1, comment = 'TP1', alert_message = _ghostExit)

// STEP 3: Breakeven stop for TP2 runner (standard path only)
if p_useTP2 and not p_isDivForex
    longExpectedAfterTP1 = p_qty - p_tp1_qty
    shortExpectedAfterTP1 = -(p_qty - p_tp1_qty)

    if strategy.position_size == longExpectedAfterTP1 and strategy.position_size[1] == p_qty and not longBEActive
        longBEActive := true
        longBEPrice := strategy.position_avg_price
        _beTP2 = math.round_to_mintick(longBEPrice + entry_tp2_dist)
        strategy.exit('Long TP2 BE', 'Long', qty = p_tp2_qty, limit = _beTP2, stop = longBEPrice, comment = 'TP2', alert_message = _ghostExit)

    if strategy.position_size == shortExpectedAfterTP1 and strategy.position_size[1] == -p_qty and not shortBEActive
        shortBEActive := true
        shortBEPrice := strategy.position_avg_price
        _beTP2 = math.round_to_mintick(shortBEPrice - entry_tp2_dist)
        strategy.exit('Short TP2 BE', 'Short', qty = p_tp2_qty, limit = _beTP2, stop = shortBEPrice, comment = 'TP2', alert_message = _ghostExit)

// ============================================================
// === EOD FORCE CLOSE — 15:50 CDT ===
// Ghost: fires exit payload ONCE per day at 15:50 CDT only.
// Guard var prevents re-firing on every bar during the EOD window.
// Resets automatically when EOD window ends at 17:00 CDT.
// ============================================================
var bool eodAlertFired = false

// Reset guard each day when EOD window closes
if not eodReached
    eodAlertFired := false
    eodAlertFired

if i_useEODCutoff and eodReached and strategy.position_size != 0 and barstate.isconfirmed
    strategy.close_all(comment = 'EOD-Closing ALL Trades @ 1550 Central Time')

if i_useEODCutoff and eodReached and barstate.isconfirmed and not eodAlertFired
    eodAlertFired := true
    if isGhostWebhook
        alert(_ghostExit, alert.freq_once_per_bar_close)
    if isSheetsWebhook
        _sheetsEodMsg = '{"action":"close","alert_type":"eod_close","ticker":"' + p_sym + '"}'
        alert(_sheetsEodMsg, alert.freq_once_per_bar_close)
    if isNinjaViewMode
        nvEodMsg = '{' + '"alert":        "Cancel OCO and Flatten",' + '"account":      "' + i_nv_account + '",' + '"ticker":       "' + nv_ticker + '",' + '"oco_id":       "' + nv_activeOcoId + '",' + '"oco_entry_id": ""' + '}'
        alert(nvEodMsg, alert.freq_once_per_bar_close)

// === SESSION OPEN FORCE FLAT — 17:00 CDT ETH Open ===
// If Pine still holds stale position state from a prior session (e.g. Friday
// EOD close executed by Ghost but not confirmed back to Pine), flush it here.
// Ghost is already flat — this purely resets Pine's internal tracker so new
// entries are not blocked at ETH open.
// ============================================================
ethOpenMins = 17 * 60 + 0
isEthOpen = eodBarMins == ethOpenMins and not eodReached

var bool ethFlatFired = false

// Reset guard when EOD window opens each day (15:50 CDT)
if eodReached
    ethFlatFired := false
    ethFlatFired

if isEthOpen and barstate.isconfirmed and not ethFlatFired and strategy.position_size != 0
    ethFlatFired := true
    strategy.close_all(comment = 'SESSION-Stale position cleared at ETH open')

// === HOLIDAY-PROOF EOD BACKSTOP (v3.1.9) ===
// The fixed 15:50-17:00 CDT window never fires on early-close holidays
// (e.g. Jul 3, Thanksgiving Friday, Christmas Eve) because no bar prints
// inside the window. session.islastbar_regular is true on the final bar of
// the regular session regardless of holiday schedule — this backstop
// guarantees a flat book at every session close, holiday or not.
// Fires the same webhook payloads as the primary EOD block.
// ============================================================
var bool sessionLastFired = false
if not session.islastbar_regular
    sessionLastFired := false
    sessionLastFired

if strategy.position_size != 0 and session.islastbar_regular and barstate.isconfirmed and not sessionLastFired
    sessionLastFired := true
    strategy.close_all(comment = 'EOD-LastBarOfSession (holiday backstop)')
    if isGhostWebhook
        alert(_ghostExit, alert.freq_once_per_bar_close)
    if isSheetsWebhook
        _sheetsHolidayEodMsg = '{"action":"close","alert_type":"eod_close","ticker":"' + p_sym + '"}'
        alert(_sheetsHolidayEodMsg, alert.freq_once_per_bar_close)
    if isNinjaViewMode
        nvHolidayEodMsg = '{' + '"alert":        "Cancel OCO and Flatten",' + '"account":      "' + i_nv_account + '",' + '"ticker":       "' + nv_ticker + '",' + '"oco_id":       "' + nv_activeOcoId + '",' + '"oco_entry_id": ""' + '}'
        alert(nvHolidayEodMsg, alert.freq_once_per_bar_close)

// ── Divergence strategy: soft exit and max-bars close ────────────────────
if (div_softExit or div_maxExit) and barstate.isconfirmed
    strategy.close_all(comment = div_maxExit ? 'DIV-MaxBars' : 'DIV-SoftExit', alert_message = _ghostExit)
    div_entryDiv := na
    div_entryDiv

// Tick value: $ per full point per contract/lot
// XAUUSD: 0.01 lot = $1/point → $100/point per 1.0 lot — scale by p_lots
// Micros checked before minis (MNQ before NQ, MGC before GC, SIL before SI) to avoid substring collision
tl_tick = p_isForex ? p_pip_val_per_lot / p_pip_size * p_pip_size : str.contains(p_sym, 'MNQ') ? 2.0 : str.contains(p_sym, 'MGC') ? 10.0 : str.contains(p_sym, 'SIL') ? 1000.0 : str.contains(p_sym, 'M2K') ? 5.0 : str.contains(p_sym, 'MES') ? 5.0 : str.contains(p_sym, 'NQ') ? 20.0 : str.contains(p_sym, 'ES') ? 50.0 : str.contains(p_sym, 'RTY') ? 50.0 : str.contains(p_sym, 'GC') ? 100.0 : str.contains(p_sym, 'SI') ? 5000.0 : 5.0
// BUG FIX 2026-06-26: same MES substring-matching bug as v4.x -- see v4.1.4/v4.1.5
// release notes for full explanation. "MES" contains "ES", was falling through to
// the full-size ES tick value (50.0) instead of MES's real 5.0, a confirmed exact
// 10x PnL dollar overstatement on every MES trade. Fixed with explicit MES check.

// ============================================================
// === GOOGLE SHEETS ENTRY PAYLOAD (AlertLog) ===
// Fires on entry bar when Google Sheets Webhook mode is active.
// Full JSON with mode, ticker, price, tp, sl, confluence data.
// TV Native entries not captured (alertcondition cannot carry JSON).
// Ninja-View AlertLog payload fires alongside NV OCO payload (unchanged).
// ============================================================
sheetsLongEntryMsg = '{' + '"script_version": "v3.1.17",' + '"action":      "long",' + '"alert_type":  "entry",' + '"mode":        "' + i_executionMode + '",' + '"ticker":      "' + p_sym + '",' + '"price":       ' + str.tostring(math.round(close, 2)) + ',' + '"tp":          ' + str.tostring(math.round(longTP1, 2)) + ',' + '"tp2":         ' + (p_useTP2 ? str.tostring(math.round(longTP2, 2)) : '0') + ',' + '"sl":          ' + str.tostring(math.round(longSL1, 2)) + ',' + '"qty":         ' + (p_isForex ? str.tostring(p_lots, '#.##') : str.tostring(p_qty)) + ',' + '"contracts":   ' + (p_isForex ? str.tostring(p_lots, '#.##') : str.tostring(p_qty)) + ',' + '"atr":         ' + str.tostring(math.round(atrVal, 4)) + ',' + '"confluence":  ' + str.tostring(bullScore) + ',' + '"conf_bits":   "' + confBits_bull + '",' + '"rsi":         ' + str.tostring(math.round(rsiVal, 1)) + ',' + '"adx":         ' + str.tostring(math.round(adxVal, 1)) + ',' + '"timeframe":   "' + timeframe.period + '",' + '"bar_time":    "' + str.format_time(time, 'yyyy-MM-dd HH:mm', 'UTC') + '",' + '"regime_score":' + str.tostring(rh_score) + ',' + '"regime":      "' + rh_label + '",' + '"fx_base_str": ' + str.tostring(math.round(fx_base_str, 4)) + ',' + '"fx_quote_str":' + str.tostring(math.round(fx_quote_str, 4)) + ',' + '"fx_divergence":' + str.tostring(math.round(fx_divergence, 4)) + ',' + '"fx_gate":     "' + fxGateStr + '"' + '}'

sheetsShortEntryMsg = '{' + '"script_version": "v3.1.17",' + '"action":      "short",' + '"alert_type":  "entry",' + '"mode":        "' + i_executionMode + '",' + '"ticker":      "' + p_sym + '",' + '"price":       ' + str.tostring(math.round(close, 2)) + ',' + '"tp":          ' + str.tostring(math.round(shortTP1, 2)) + ',' + '"tp2":         ' + (p_useTP2 ? str.tostring(math.round(shortTP2, 2)) : '0') + ',' + '"sl":          ' + str.tostring(math.round(shortSL1, 2)) + ',' + '"qty":         ' + (p_isForex ? str.tostring(p_lots, '#.##') : str.tostring(p_qty)) + ',' + '"contracts":   ' + (p_isForex ? str.tostring(p_lots, '#.##') : str.tostring(p_qty)) + ',' + '"atr":         ' + str.tostring(math.round(atrVal, 4)) + ',' + '"confluence":  ' + str.tostring(bearScore) + ',' + '"conf_bits":   "' + confBits_bear + '",' + '"rsi":         ' + str.tostring(math.round(rsiVal, 1)) + ',' + '"adx":         ' + str.tostring(math.round(adxVal, 1)) + ',' + '"timeframe":   "' + timeframe.period + '",' + '"bar_time":    "' + str.format_time(time, 'yyyy-MM-dd HH:mm', 'UTC') + '",' + '"regime_score":' + str.tostring(rh_score) + ',' + '"regime":      "' + rh_label + '",' + '"fx_base_str": ' + str.tostring(math.round(fx_base_str, 4)) + ',' + '"fx_quote_str":' + str.tostring(math.round(fx_quote_str, 4)) + ',' + '"fx_divergence":' + str.tostring(math.round(fx_divergence, 4)) + ',' + '"fx_gate":     "' + fxGateStr + '"' + '}'

if not isNinjaViewMode and bullSignal and strategy.position_size == 0 and barstate.isconfirmed
    if isSheetsWebhook
        alert(sheetsLongEntryMsg, alert.freq_once_per_bar_close)

if not isNinjaViewMode and bearSignal and strategy.position_size == 0 and barstate.isconfirmed
    if isSheetsWebhook
        alert(sheetsShortEntryMsg, alert.freq_once_per_bar_close)

// TV Native Mode — audible/visual alerts (no JSON payload)
if isTVNativeMode and bullSignal and strategy.position_size == 0 and barstate.isconfirmed
    alert('LWTG MITS Long Signal fired. Check chart for entry, TP and SL levels.', alert.freq_once_per_bar_close)

if isTVNativeMode and bearSignal and strategy.position_size == 0 and barstate.isconfirmed
    alert('LWTG MITS Short Signal fired. Check chart for entry, TP and SL levels.', alert.freq_once_per_bar_close)

// Ninja-View Mode — OCO entry payloads + AlertLog entry
if isNinjaViewMode and bullSignal and strategy.position_size == 0 and barstate.isconfirmed
    nv_ocoId = p_sym + str.tostring(bar_index)
    nv_activeOcoId := nv_ocoId
    nvLongMsg = '{' + '"alert":             "OCO Market Buy",' + '"account":           "' + i_nv_account + '",' + '"ticker":            "' + nv_ticker + '",' + '"qty":               "' + str.tostring(p_qty) + '",' + '"take_profit_price": "' + str.tostring(math.round(longTP1, 2)) + '",' + '"stop_loss_price":   "' + str.tostring(math.round(longSL1, 2)) + '",' + '"oco_id":            "' + nv_ocoId + '"' + '}'
    alert(nvLongMsg, alert.freq_once_per_bar_close) // → Ninja-View webhook
    if isSheetsWebhook
        alert(sheetsLongEntryMsg, alert.freq_once_per_bar_close) // → GAS AlertLog

if isNinjaViewMode and bearSignal and strategy.position_size == 0 and barstate.isconfirmed
    nv_ocoId = p_sym + str.tostring(bar_index)
    nv_activeOcoId := nv_ocoId
    nvShortMsg = '{' + '"alert":             "OCO Market Sell",' + '"account":           "' + i_nv_account + '",' + '"ticker":            "' + nv_ticker + '",' + '"qty":               "' + str.tostring(p_qty) + '",' + '"take_profit_price": "' + str.tostring(math.round(shortTP1, 2)) + '",' + '"stop_loss_price":   "' + str.tostring(math.round(shortSL1, 2)) + '",' + '"oco_id":            "' + nv_ocoId + '"' + '}'
    alert(nvShortMsg, alert.freq_once_per_bar_close) // → Ninja-View webhook
    if isSheetsWebhook
        alert(sheetsShortEntryMsg, alert.freq_once_per_bar_close) // → GAS AlertLog

// ============================================================
// === GOOGLE SHEETS EXIT PAYLOAD (TradeLog) ===
// Fires on trade close with full entry + exit + P&L data.
// Ghost Webhook mode: exit handled by alert_message= on strategy.exit() above.
// Google Sheets mode: full TradeLog JSON fires here on position close.
// Create a separate TradingView alert pointing at your Apps Script URL.
// ============================================================
var float wh_entryPrice = na
var float wh_entryTP = na
var float wh_entrySL = na
var float wh_entryATR = na
var int wh_entryConf = na
var string wh_entryBits = na // v3.1.10: 9-bit confluence fingerprint at signal bar
var float wh_entryRSI = na
var float wh_entryADX = na
var string wh_entryDir = na
var string wh_entryTime = na

// Capture entry data at fill — use actual fill price + stored distances for TP/SL
if strategy.position_size != 0 and strategy.position_size[1] == 0
    wh_entryPrice := strategy.position_avg_price
    wh_entryDir := strategy.position_size > 0 ? 'long' : 'short'
    wh_entryTP := math.round_to_mintick(strategy.position_size > 0 ? strategy.position_avg_price + entry_tp1_dist : strategy.position_avg_price - entry_tp1_dist)
    wh_entrySL := math.round_to_mintick(strategy.position_size > 0 ? strategy.position_avg_price - entry_sl1_dist : strategy.position_avg_price + entry_sl1_dist)
    wh_entryATR := atrVal
    wh_entryConf := pendingSignalConf
    wh_entryBits := pendingSignalBits
    wh_entryRSI := rsiVal
    wh_entryADX := adxVal
    wh_entryTime := str.format_time(time, 'yyyy-MM-dd HH:mm', 'UTC')
    wh_entryTime

if strategy.position_size == 0 and strategy.position_size[1] != 0 and barstate.isconfirmed
    _idx = strategy.closedtrades - 1
    _exitP = strategy.closedtrades.exit_price(_idx)
    _isLong = wh_entryDir == 'long'
    _pnlPts = _isLong ? _exitP - wh_entryPrice : wh_entryPrice - _exitP
    _pnlDollar = p_isForex ? _pnlPts * tl_tick * p_lots : _pnlPts * tl_tick * p_qty
    _result = _pnlPts > 0 ? 'TP' : 'SL'

    exitLogMsg = '{' + '"script_version": "v3.1.17",' + '"action":      "exit_' + wh_entryDir + '",' + '"alert_type":  "exit",' + '"symbol":      "' + p_sym + '",' + '"timeframe":   "' + timeframe.period + '",' + '"direction":   "' + wh_entryDir + '",' + '"price":       ' + str.tostring(math.round(wh_entryPrice, 2)) + ',' + '"exit_price":  ' + str.tostring(math.round(_exitP, 2)) + ',' + '"tp":          ' + str.tostring(math.round(wh_entryTP, 2)) + ',' + '"sl":          ' + str.tostring(math.round(wh_entrySL, 2)) + ',' + '"pnl_points":  ' + str.tostring(math.round(_pnlPts, 2)) + ',' + '"pnl_dollar":  ' + str.tostring(math.round(_pnlDollar, 2)) + ',' + '"result":      "' + _result + '",' + '"contracts":   ' + (p_isForex ? str.tostring(p_lots, '#.##') : str.tostring(p_qty)) + ',' + '"confluence":  ' + str.tostring(wh_entryConf) + ',' + '"conf_bits":   "' + wh_entryBits + '",' + '"rsi":         ' + str.tostring(math.round(wh_entryRSI, 1)) + ',' + '"adx":         ' + str.tostring(math.round(wh_entryADX, 1)) + ',' + '"atr":         ' + str.tostring(math.round(wh_entryATR, 4)) + ',' + '"bar_time":    "' + wh_entryTime + '",' + '"regime_score":' + str.tostring(rh_score) + ',' + '"regime":      "' + rh_label + '"' + '}'

    if isSheetsWebhook
        alert(exitLogMsg, alert.freq_once_per_bar_close) // → Google Sheets (Trade Log alert — GAS mode only)

// ============================================================
// === TRADE LOG — Arrays & Tracking ===
// ============================================================
var array<string> tl_dir = array.new_string(0)
var array<int> tl_date = array.new_int(0) // v3.1.3: entry date for each logged trade
var array<float> tl_entry = array.new_float(0)
var array<float> tl_exit = array.new_float(0)
var array<string> tl_result = array.new_string(0)
var array<float> tl_pnl = array.new_float(0)
var int tl_wins = 0
var int tl_losses = 0

if strategy.closedtrades > strategy.closedtrades[1]
    idx = strategy.closedtrades - 1
    entryP = strategy.closedtrades.entry_price(idx)
    exitP = strategy.closedtrades.exit_price(idx)
    entryId = strategy.closedtrades.entry_id(idx)
    isLong = str.contains(entryId, 'Long')
    pnlPts = isLong ? exitP - entryP : entryP - exitP
    pnlDollar = p_isForex ? pnlPts * tl_tick * p_lots : pnlPts * tl_tick * p_qty
    isWin = pnlPts > 0
    exitId = strategy.closedtrades.exit_id(idx)
    // Use exit_id to distinguish TP1 partial, TP2, BE stop, SL, and EOD exits
    // Prevents TP1 partial win label from appearing on an overall losing 2c trade
    isTP1exit = str.contains(exitId, 'TP1') or exitId == 'Long Exit' or exitId == 'Short Exit'
    isTP2exit = str.contains(exitId, 'TP2') and not str.contains(exitId, 'BE')
    isBEexit = str.contains(exitId, 'BE')
    isEODexit = str.contains(exitId, 'EOD')
    resStr = isEODexit ? 'EOD ⏱' : isBEexit and isWin ? 'TP2 ✓' : isBEexit ? 'BE ✗' : isTP2exit and isWin ? 'TP2 ✓' : isTP2exit ? 'SL ✗' : isTP1exit and isWin ? 'TP1 ✓' : isWin ? 'TP ✓' : 'SL ✗'

    array.unshift(tl_dir, isLong ? 'L' : 'S')
    array.unshift(tl_date, strategy.closedtrades.entry_time(idx))
    array.unshift(tl_entry, entryP)
    array.unshift(tl_exit, exitP)
    array.unshift(tl_result, resStr)
    array.unshift(tl_pnl, pnlDollar)

    tl_wins := isWin ? tl_wins + 1 : tl_wins
    tl_losses := isWin ? tl_losses : tl_losses + 1

    // ── Exit result label — draws on actual exit bar at actual exit price ──
    // Uses exit_bar_index() so label is visually correct despite 1-bar calc lag
    exitBarIdx = strategy.closedtrades.exit_bar_index(idx)
    exitLblColor = isWin ? color.new(color.green, 0) : color.new(color.red, 0)
    exitLblStyle = isWin ? isLong ? label.style_label_up : label.style_label_down : isLong ? label.style_label_down : label.style_label_up
    exitLblY = isWin ? isLong ? exitP + atrVal * i_markerOffset : exitP - atrVal * i_markerOffset : isLong ? exitP - atrVal * i_markerOffset : exitP + atrVal * i_markerOffset
    label.new(exitBarIdx, exitLblY, resStr, style = exitLblStyle, color = exitLblColor, textcolor = color.white, size = i_markerSize == 'Tiny' ? size.tiny : i_markerSize == 'Small' ? size.small : i_markerSize == 'Large' ? size.large : size.normal)

    if array.size(tl_dir) > i_tradeLogMax
        array.pop(tl_dir)
        array.pop(tl_entry)
        array.pop(tl_exit)
        array.pop(tl_result)
        array.pop(tl_pnl)

// ============================================================
// === VISUALS ===
// ============================================================
plot(fastEMA, 'Fast EMA', color = color.new(color.lime, 40), linewidth = 2)
plot(slowEMA, 'Slow EMA', color = color.new(color.yellow, 40), linewidth = 1)
plot(trailStop, 'Smart Trail', color = c7_bull ? color.green : color.red, linewidth = 1, style = plot.style_circles)

markerSize = i_markerSize == 'Tiny' ? size.tiny : i_markerSize == 'Small' ? size.small : i_markerSize == 'Large' ? size.large : size.normal

if i_showSignalMarkers and bullSignal and strategy.position_size == 0
    label.new(bar_index, low - atrVal * i_markerOffset, '▲', style = label.style_label_up, textcolor = color.white, color = color.new(color.green, 0), size = markerSize)

if i_showSignalMarkers and bearSignal and strategy.position_size == 0
    label.new(bar_index, high + atrVal * i_markerOffset, '▼', style = label.style_label_down, textcolor = color.white, color = color.new(color.red, 0), size = markerSize)

// ============================================================
// === STATUS LINE PLOTS ===
// ============================================================
plot(rsiVal, 'RSI Value', color = color.new(color.purple, 0), display = display.status_line)
plot(adxVal, 'ADX Value', color = color.new(color.teal, 0), display = display.status_line)
plot(atrVal, 'ATR Value', color = color.new(color.gray, 0), display = display.status_line)
plot(wt1, 'WT1', color = color.new(color.green, 0), display = display.status_line)
plot(wt2, 'WT2', color = color.new(color.red, 0), display = display.status_line)
plot(smoothedMom, 'Momentum', color = color.new(color.yellow, 0), display = display.status_line)
plot(sqzVal, 'Squeeze Val', color = color.new(color.orange, 0), display = display.status_line)
plot(vfi, 'VFI', color = color.new(color.blue, 0), display = display.status_line)
plot(bullSignal ? 1 : 0, 'Bull Signal', color = color.new(color.green, 0), display = display.status_line)
plot(bearSignal ? 1 : 0, 'Bear Signal', color = color.new(color.red, 0), display = display.status_line)
plot(longTP1, 'Long TP1', color = color.new(color.green, 0), display = display.status_line)
plot(longSL1, 'Long SL1', color = color.new(color.red, 0), display = display.status_line)
plot(shortTP1, 'Short TP1', color = color.new(color.green, 0), display = display.status_line)
plot(shortSL1, 'Short SL1', color = color.new(color.red, 0), display = display.status_line)
plot(strategy.position_size, 'Position Size', color = color.new(color.white, 0), display = display.status_line)
plot(strategy.netprofit, 'Net Profit', color = color.new(color.green, 0), display = display.status_line)

// ============================================================
// === RENDER TIMING ===
// ============================================================
shouldUpdate = i_barCloseOnly ? barstate.isconfirmed : barstate.islast

// ============================================================
// === TRADE LEVEL LINES ===
// ============================================================
lineStyle(s) =>
    s == 'Dashed' ? line.style_dashed : s == 'Dotted' ? line.style_dotted : line.style_solid

var line entryLine = na
var line tp1Line = na
var line tp2Line = na
var line sl1Line = na
var line projEntryLine = na
var line projTP1Line = na
var line projSL1Line = na

var label entryLbl = na
var label tp1Lbl = na
var label tp2Lbl = na
var label sl1Lbl = na
var label projEntryLbl = na
var label projTP1Lbl = na
var label projSL1Lbl = na

var float tradeEntryPrice = na
var float tradeTP1 = na
var float tradeTP2 = na
var float tradeSL1 = na

// Use actual fill price + stored distances for confirmed trade lines
if strategy.position_size != 0 and strategy.position_size[1] == 0
    tradeEntryPrice := strategy.position_avg_price
    if strategy.position_size > 0
        tradeTP1 := tradeEntryPrice + entry_tp1_dist
        tradeTP2 := p_useTP2 ? tradeEntryPrice + entry_tp2_dist : na
        tradeSL1 := tradeEntryPrice - entry_sl1_dist
        tradeSL1
    else
        tradeTP1 := tradeEntryPrice - entry_tp1_dist
        tradeTP2 := p_useTP2 ? tradeEntryPrice - entry_tp2_dist : na
        tradeSL1 := tradeEntryPrice + entry_sl1_dist
        tradeSL1

if i_showLines and strategy.position_size != 0 and shouldUpdate
    lineEnd = bar_index + i_lineLen
    line.delete(entryLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(sl1Line)
    label.delete(entryLbl)
    label.delete(tp1Lbl)
    label.delete(tp2Lbl)
    label.delete(sl1Lbl)
    entryLine := line.new(bar_index, tradeEntryPrice, lineEnd, tradeEntryPrice, color = i_entryColor, style = line.style_solid, width = i_entryWidth)
    tp1Line := line.new(bar_index, tradeTP1, lineEnd, tradeTP1, color = i_tp1Color, style = line.style_solid, width = i_tp1Width)
    if p_useTP2 and not na(tradeTP2)
        tp2Line := line.new(bar_index, tradeTP2, lineEnd, tradeTP2, color = color.new(i_tp1Color, 40), style = line.style_solid, width = i_tp1Width)
        tp2Line
    sl1Line := line.new(bar_index, tradeSL1, lineEnd, tradeSL1, color = i_sl1Color, style = line.style_solid, width = i_sl1Width)
    if i_showPriceLabels
        entryLbl := label.new(lineEnd, tradeEntryPrice, str.tostring(math.round(tradeEntryPrice, 2)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = i_entryColor, size = size.small)
        tp1Lbl := label.new(lineEnd, tradeTP1, 'TP  ' + str.tostring(math.round(tradeTP1, 2)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = i_tp1Color, size = size.small)
        sl1Lbl := label.new(lineEnd, tradeSL1, 'SL  ' + str.tostring(math.round(tradeSL1, 2)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = i_sl1Color, size = size.small)
        if p_useTP2 and not na(tradeTP2)
            tp2Lbl := label.new(lineEnd, tradeTP2, 'TP2 ' + str.tostring(math.round(tradeTP2, 2)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(i_tp1Color, 40), size = size.small)
            tp2Lbl

// Projected lines — signal bar before close
projSignal = (bullSignal or bearSignal) and strategy.position_size == 0 and (not barstate.isconfirmed or barstate.islast)
projIsBull = bullSignal and not bearSignal

if i_showLines and projSignal
    lineEnd = bar_index + i_lineLen
    projEntry = close
    projTP1v = projIsBull ? close + tp1 : close - tp1
    projSL1v = projIsBull ? close - sl1 : close + sl1
    line.delete(projEntryLine)
    line.delete(projTP1Line)
    line.delete(projSL1Line)
    label.delete(projEntryLbl)
    label.delete(projTP1Lbl)
    label.delete(projSL1Lbl)
    projEntryLine := line.new(bar_index, projEntry, lineEnd, projEntry, color = color.new(i_entryColor, 40), style = line.style_dashed, width = i_entryWidth)
    projTP1Line := line.new(bar_index, projTP1v, lineEnd, projTP1v, color = color.new(i_tp1Color, 40), style = line.style_dashed, width = i_tp1Width)
    projSL1Line := line.new(bar_index, projSL1v, lineEnd, projSL1v, color = color.new(i_sl1Color, 40), style = line.style_dashed, width = i_sl1Width)
    if i_showPriceLabels
        projEntryLbl := label.new(lineEnd, projEntry, str.tostring(math.round(projEntry, 2)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(i_entryColor, 40), size = size.small)
        projTP1Lbl := label.new(lineEnd, projTP1v, 'TP  ' + str.tostring(math.round(projTP1v, 2)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(i_tp1Color, 40), size = size.small)
        projSL1Lbl := label.new(lineEnd, projSL1v, 'SL  ' + str.tostring(math.round(projSL1v, 2)), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(i_sl1Color, 40), size = size.small)
        projSL1Lbl

if not projSignal
    line.delete(projEntryLine)
    line.delete(projTP1Line)
    line.delete(projSL1Line)
    label.delete(projEntryLbl)
    label.delete(projTP1Lbl)
    label.delete(projSL1Lbl)
    projEntryLine := na
    projTP1Line := na
    projSL1Line := na
    projEntryLbl := na
    projTP1Lbl := na
    projSL1Lbl := na
    projSL1Lbl

if strategy.position_size == 0 and strategy.position_size[1] != 0
    line.delete(entryLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(sl1Line)
    label.delete(entryLbl)
    label.delete(tp1Lbl)
    label.delete(tp2Lbl)
    label.delete(sl1Lbl)
    tradeEntryPrice := na
    tradeTP1 := na
    tradeTP2 := na
    tradeSL1 := na
    tradeSL1

// ============================================================
// === INFO PANEL ===
// ============================================================
panelPos(p) =>
    p == 'Top Left' ? position.top_left : p == 'Top Center' ? position.top_center : p == 'Bottom Right' ? position.bottom_right : p == 'Bottom Left' ? position.bottom_left : p == 'Bottom Center' ? position.bottom_center : position.top_right

pSize = i_panelSize == 'Tiny' ? size.tiny : i_panelSize == 'Normal' ? size.normal : i_panelSize == 'Large' ? size.large : size.small

clrHeader = color.new(#1a1a2e, 0)
clrHeaderTxt = color.new(#ffffff, 0)
clrRowDark = color.new(#0d0d1a, 0)
clrRowLight = color.new(#12122a, 0)
clrLabel = color.new(#00d4ff, 0)
clrValue = color.new(#ffffff, 0)
clrBull = color.new(#00ff88, 0)
clrBear = color.new(#ff3355, 0)
clrWarn = color.new(#ffcc00, 0)
clrGray = color.new(#666688, 0)
clrTP = color.new(#00ff88, 0)
clrSL1 = color.new(#ff3355, 0)
clrHide = color.new(#0d0d1a, 100)

isFlat = strategy.position_size == 0 or eodReached // EOD override: treat as flat during 15:50–17:00 window
posDir = strategy.position_size > 0 ? 'LONG' : strategy.position_size < 0 ? 'SHORT' : ''
exitMode = p_useTP2 ? 'TP1+TP2 Split' : 'TP1/SL1'

rsiLongOK = rsiVal < p_rsiOB
rsiBearOK = rsiVal > p_rsiOS
rsiNearOB = rsiVal >= p_rsiOB - 5 and rsiVal < p_rsiOB
rsiNearOS = rsiVal <= p_rsiOS + 5 and rsiVal > p_rsiOS
rsiColor = not rsiLongOK and not rsiBearOK ? clrBear : not rsiLongOK or not rsiBearOK ? clrBear : rsiNearOB or rsiNearOS ? clrWarn : clrBull

rsiDisplay = str.tostring(math.round(rsiVal, 1)) + ' (' + str.tostring(p_rsiOB) + '/' + str.tostring(p_rsiOS) + ')'
adxOK = adxVal >= p_adxMin
adxDisplay = str.tostring(math.round(adxVal, 1)) + ' (' + str.tostring(p_adxMin) + ')'
adxColor = adxOK ? clrBull : clrBear

var table infoTable = i_showPanel ? table.new(panelPos(i_panelPos), 2, 23, bgcolor = clrRowDark, border_width = 1, border_color = color.new(#334466, 0), frame_width = 2, frame_color = color.new(#00d4ff, 0)) : na

// ============================================================
// === DIAGNOSTICS PANEL ===
// ============================================================
diagSize = i_diagPanelSize == 'Tiny' ? size.tiny : i_diagPanelSize == 'Small' ? size.small : i_diagPanelSize == 'Normal' ? size.normal : size.large

var table diagTable = i_showDiagPanel ? table.new(panelPos(i_diagPanelPos), 3, 14, bgcolor = clrRowDark, border_width = 1, border_color = color.new(#334466, 0), frame_width = 2, frame_color = color.new(#ffaa00, 0)) : na

var bool diagLabelsDrawn = false

if i_showDiagPanel and not diagLabelsDrawn
    table.cell(diagTable, 0, 0, 'Diagnostics', text_color = clrHeaderTxt, bgcolor = clrHeader, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 0, 'Bull', text_color = clrHeaderTxt, bgcolor = clrHeader, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 0, 'Bear', text_color = clrHeaderTxt, bgcolor = clrHeader, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 0, 1, '1 EMA Trend', text_color = clrLabel, bgcolor = clrRowDark, text_size = diagSize)
    table.cell(diagTable, 0, 2, '2 Price Pos', text_color = clrLabel, bgcolor = clrRowLight, text_size = diagSize)
    table.cell(diagTable, 0, 3, '3 WaveTrend', text_color = clrLabel, bgcolor = clrRowDark, text_size = diagSize)
    table.cell(diagTable, 0, 4, '4 Momentum', text_color = clrLabel, bgcolor = clrRowLight, text_size = diagSize)
    table.cell(diagTable, 0, 5, '5 Candle', text_color = clrLabel, bgcolor = clrRowDark, text_size = diagSize)
    table.cell(diagTable, 0, 6, '6 Sqz+Break', text_color = clrLabel, bgcolor = clrRowLight, text_size = diagSize)
    table.cell(diagTable, 0, 7, '7 SmartTrail', text_color = clrLabel, bgcolor = clrRowDark, text_size = diagSize)
    table.cell(diagTable, 0, 8, '8 Vol Flow', text_color = clrLabel, bgcolor = clrRowLight, text_size = diagSize)
    table.cell(diagTable, 0, 9, '9 SMC', text_color = clrLabel, bgcolor = clrRowDark, text_size = diagSize)
    table.cell(diagTable, 0, 10, 'Score (thr)', text_color = clrLabel, bgcolor = clrRowLight, text_size = diagSize)
    table.cell(diagTable, 0, 11, 'Filters', text_color = clrLabel, bgcolor = clrRowDark, text_size = diagSize)
    table.cell(diagTable, 0, 12, 'Delay (last)', text_color = clrLabel, bgcolor = clrRowLight, text_size = diagSize)
    table.cell(diagTable, 0, 13, 'Timeline', text_color = clrLabel, bgcolor = clrRowDark, text_size = diagSize)
    table.cell(diagTable, 0, 14, 'DLL', text_color = clrLabel, bgcolor = clrRowLight, text_size = diagSize)
    diagLabelsDrawn := true
    diagLabelsDrawn

if i_showDiagPanel and shouldUpdate
    table.cell(diagTable, 1, 1, c1_bull ? '✓' : '·', text_color = c1_bull ? clrBull : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 1, c1_bear ? '✓' : '·', text_color = c1_bear ? clrBear : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 2, c2_bull ? '✓' : '·', text_color = c2_bull ? clrBull : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 2, c2_bear ? '✓' : '·', text_color = c2_bear ? clrBear : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 3, c3_bull ? '✓' : '·', text_color = c3_bull ? clrBull : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 3, c3_bear ? '✓' : '·', text_color = c3_bear ? clrBear : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 4, c4_bull ? '✓' : '·', text_color = c4_bull ? clrBull : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 4, c4_bear ? '✓' : '·', text_color = c4_bear ? clrBear : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 5, c5_bull ? '✓' : '·', text_color = c5_bull ? clrBull : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 5, c5_bear ? '✓' : '·', text_color = c5_bear ? clrBear : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 6, c6_bull ? '✓' : '·', text_color = c6_bull ? clrBull : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 6, c6_bear ? '✓' : '·', text_color = c6_bear ? clrBear : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 7, c7_bull ? '✓' : '·', text_color = c7_bull ? clrBull : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 7, c7_bear ? '✓' : '·', text_color = c7_bear ? clrBear : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 8, c8_bull ? '✓' : '·', text_color = c8_bull ? clrBull : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 8, c8_bear ? '✓' : '·', text_color = c8_bear ? clrBear : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 9, c9_bull ? '✓' : '·', text_color = c9_bull ? clrBull : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 9, c9_bear ? '✓' : '·', text_color = c9_bear ? clrBear : clrGray, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 10, str.tostring(bullScore) + '(' + str.tostring(p_conf) + ')', text_color = bullScore >= p_conf ? clrBull : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 10, str.tostring(bearScore) + '(' + str.tostring(p_conf) + ')', text_color = bearScore >= p_conf ? clrBear : clrGray, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    fltBase = (p_useRSI ? 'RSI' : '') + (p_useADX ? p_useRSI ? '+ADX' : 'ADX' : '') + (i_useTimeFilter ? p_useRSI or p_useADX ? '+Time' : 'Time' : p_useRSI or p_useADX ? '' : 'Off')
    fltTxt = fltBase + (i_useDOW ? fltBase != '' ? '+DOW' : 'DOW' : '')
    fltOK = (not p_useRSI or rsiFilter_bull and rsiFilter_bear) and (not p_useADX or adxFilter) and (not i_useTimeFilter and not p_w1_on and not p_w2_on and not p_w3_on or entryTimeAllowed) and dowAllowed
    table.cell(diagTable, 1, 11, fltTxt, text_color = fltOK ? clrValue : clrBear, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 11, fltOK ? 'OK' : 'BLK', text_color = fltOK ? clrBull : clrBear, bgcolor = clrRowDark, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 1, 12, bullSignal ? bullDelayTxt : '', text_color = clrWarn, bgcolor = clrRowLight, text_size = diagSize)
    table.cell(diagTable, 2, 12, bearSignal ? bearDelayTxt : '', text_color = clrWarn, bgcolor = clrRowLight, text_size = diagSize)
    table.cell(diagTable, 1, 13, i_showTimeline and bullSignal ? bullTimelineTxt : '', text_color = clrValue, bgcolor = clrRowDark, text_size = diagSize)
    table.cell(diagTable, 2, 13, i_showTimeline and bearSignal ? bearTimelineTxt : '', text_color = clrValue, bgcolor = clrRowDark, text_size = diagSize)
    // DLL row 14
    _dllPnlTxt = (v3_runningPnl >= 0 ? '+' : '') + str.tostring(math.round(v3_runningPnl, 2))
    _dllStatTxt = i_dailyLossLimit == 0.0 ? 'OFF' : dll_gate ? 'OPEN' : 'BLOCKED'
    _dllStatClr = i_dailyLossLimit == 0.0 ? clrGray : dll_gate ? clrBull : clrBear
    _dllLimTxt = i_dailyLossLimit == 0.0 ? 'DLL: off' : 'DLL: ' + str.tostring(i_dailyLossLimit, '#')
    table.cell(diagTable, 0, 14, _dllLimTxt, text_color = clrLabel, bgcolor = clrRowLight, text_size = diagSize)
    table.cell(diagTable, 1, 14, _dllPnlTxt, text_color = v3_runningPnl >= 0 ? clrBull : clrBear, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)
    table.cell(diagTable, 2, 14, _dllStatTxt, text_color = _dllStatClr, bgcolor = clrRowLight, text_size = diagSize, text_halign = text.align_center)

var bool labelsDrawn = false

if i_showPanel and not labelsDrawn
    table.cell(infoTable, 0, 0, 'LWTG MITS', text_color = clrHeaderTxt, bgcolor = clrHeader, text_size = pSize, text_halign = text.align_center)
    table.cell(infoTable, 1, 0, 'v3.1.17', text_color = clrWarn, bgcolor = clrHeader, text_size = pSize, text_halign = text.align_center)
    table.cell(infoTable, 0, 1, 'Instrument', text_color = clrLabel, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 0, 2, 'Bull Score', text_color = clrLabel, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 0, 3, 'Bear Score', text_color = clrLabel, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 0, 4, 'RSI', text_color = clrLabel, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 0, 5, 'ADX', text_color = clrLabel, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 0, 6, 'Regime', text_color = clrLabel, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 0, 7, 'Position', text_color = clrLabel, bgcolor = clrRowDark, text_size = pSize)
    labelsDrawn := true
    labelsDrawn

if i_showPanel and shouldUpdate
    table.cell(infoTable, 1, 1, i_useOverrides ? i_preset + ' [OVR]' : i_preset, text_color = i_useOverrides ? clrBear : clrWarn, bgcolor = clrRowDark, text_size = pSize, text_halign = text.align_center)
    table.cell(infoTable, 1, 2, str.tostring(bullScore) + ' (' + str.tostring(p_conf) + ')', text_color = bullScore >= p_conf ? clrBull : clrGray, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 3, str.tostring(bearScore) + ' (' + str.tostring(p_conf) + ')', text_color = bearScore >= p_conf ? clrBear : clrGray, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 1, 4, rsiDisplay, text_color = rsiColor, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 5, adxDisplay, text_color = adxColor, bgcolor = clrRowDark, text_size = pSize)
    rhColor = rh_score >= 5 ? clrBull : rh_score >= 3 ? color.new(color.green, 30) : rh_score >= 1 ? color.new(color.green, 60) : rh_score <= -5 ? clrBear : rh_score <= -3 ? color.new(color.red, 30) : rh_score <= -1 ? color.new(color.red, 60) : clrGray
    rhDisplay = str.tostring(rh_score) + '  ' + rh_label + (p_useRegime ? ' [GATE]' : '')
    table.cell(infoTable, 1, 6, rhDisplay, text_color = rhColor, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 7, isFlat ? 'Flat' : 'Open — ' + posDir, text_color = isFlat ? clrGray : posDir == 'LONG' ? clrBull : clrBear, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 0, 8, isFlat ? 'Exit Mode' : p_isForex ? 'Lots (auto)' : 'Contracts', text_color = clrLabel, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 8, isFlat ? exitMode : p_isForex ? str.tostring(p_lots, '#.##') + (i_executionMode == 'Ghost' ? ' / $' + str.tostring(i_forex_risk, '#') : ' / manual') : str.tostring(math.abs(strategy.position_size)), text_color = isFlat ? clrValue : clrWarn, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 0, 9, isFlat ? 'Mode' : posDir == 'LONG' ? 'Buy Price' : 'Sell Price', text_color = clrLabel, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 1, 9, isFlat ? i_executionMode + ' | ' + i_webhookMode : str.tostring(math.round(tradeEntryPrice, 2)), text_color = isFlat ? isGhostMode ? clrWarn : isNinjaViewMode ? color.new(color.purple, 0) : clrBull : posDir == 'LONG' ? clrBull : clrBear, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 0, 10, isFlat ? '' : 'ATR', text_color = clrLabel, bgcolor = isFlat ? clrHide : clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 10, isFlat ? '' : str.tostring(math.round(atrVal, 4)), text_color = clrWarn, bgcolor = isFlat ? clrHide : clrRowLight, text_size = pSize)
    table.cell(infoTable, 0, 11, isFlat ? '' : p_useTP2 ? 'TP1/TP2' : 'TP1', text_color = clrLabel, bgcolor = isFlat ? clrHide : clrRowDark, text_size = pSize)
    table.cell(infoTable, 1, 11, isFlat ? '' : p_useTP2 ? str.tostring(math.round(tradeTP1, 2)) + ' / ' + str.tostring(math.round(tradeTP2, 2)) : str.tostring(math.round(tradeTP1, 2)), text_color = clrTP, bgcolor = isFlat ? clrHide : clrRowDark, text_size = pSize)
    table.cell(infoTable, 0, 12, isFlat ? '' : 'SL1', text_color = clrLabel, bgcolor = isFlat ? clrHide : clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 12, isFlat ? '' : str.tostring(math.round(tradeSL1, 2)), text_color = clrSL1, bgcolor = isFlat ? clrHide : clrRowLight, text_size = pSize)
    table.cell(infoTable, 0, 13, isFlat ? '' : 'Exit Mode', text_color = clrLabel, bgcolor = isFlat ? clrHide : clrRowDark, text_size = pSize)
    table.cell(infoTable, 1, 13, isFlat ? '' : exitMode, text_color = clrValue, bgcolor = isFlat ? clrHide : clrRowDark, text_size = pSize)
    timeStatus = i_useEODCutoff and eodReached ? 'EOD — Closed' : inBlockedWindow ? 'Blocked' : not i_useTimeFilter ? p_w1_on or p_w2_on or p_w3_on ? i_useOptimizedTimeFilter ? 'OTF On' : 'Allowed' : 'No OTF\'s Set' : timeAllowed ? 'In Window' : 'Outside'
    timeColor = i_useEODCutoff and eodReached ? clrBear : inBlockedWindow ? clrBear : not i_useTimeFilter ? p_w1_on or p_w2_on or p_w3_on ? clrBull : clrGray : timeAllowed ? clrBull : clrBear
    table.cell(infoTable, 0, 14, 'Trade Hours', text_color = clrLabel, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 14, timeStatus, text_color = timeColor, bgcolor = clrRowLight, text_size = pSize)
    fxGateColor = not p_isForex or not i_useFXGate ? clrGray : fxGateStr == 'LONG-OK' or fxGateStr == 'SHORT-OK' ? clrBull : clrBear
    table.cell(infoTable, 0, 15, 'FX Gate', text_color = clrLabel, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 1, 15, fxGateStr, text_color = fxGateColor, bgcolor = clrRowDark, text_size = pSize)
    divColor = not p_isDivForex ? clrGray : str.contains(divStratStr, 'ENTRY') ? clrBull : str.contains(divStratStr, 'OK') ? clrBull : str.contains(divStratStr, 'LONG') or str.contains(divStratStr, 'SHORT') ? clrWarn : clrBear
    table.cell(infoTable, 0, 16, 'Div Strat', text_color = clrLabel, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 16, divStratStr, text_color = divColor, bgcolor = clrRowLight, text_size = pSize)

    // ── DOW status rows (17–22) — one row per day ────────────────────────────
    _dowNow = dayofweek(time, syminfo.timezone)
    _isToday_sun = _dowNow == dayofweek.sunday
    _isToday_mon = _dowNow == dayofweek.monday
    _isToday_tue = _dowNow == dayofweek.tuesday
    _isToday_wed = _dowNow == dayofweek.wednesday
    _isToday_thu = _dowNow == dayofweek.thursday
    _isToday_fri = _dowNow == dayofweek.friday

    _dowOff = not i_useDOW

    // Per-day color: gray=master off, green=active, red=blocked
    _dc_sun = _dowOff ? clrGray : p_dow_sun ? clrBull : clrBear
    _dc_mon = _dowOff ? clrGray : p_dow_mon ? clrBull : clrBear
    _dc_tue = _dowOff ? clrGray : p_dow_tue ? clrBull : clrBear
    _dc_wed = _dowOff ? clrGray : p_dow_wed ? clrBull : clrBear
    _dc_thu = _dowOff ? clrGray : p_dow_thu ? clrBull : clrBear
    _dc_fri = _dowOff ? clrGray : p_dow_fri ? clrBull : clrBear

    // Value text: [Day] if today, else day name
    _dv_sun = _isToday_sun ? '[Sun]' : 'Sun'
    _dv_mon = _isToday_mon ? '[Mon]' : 'Mon'
    _dv_tue = _isToday_tue ? '[Tue]' : 'Tue'
    _dv_wed = _isToday_wed ? '[Wed]' : 'Wed'
    _dv_thu = _isToday_thu ? '[Thu]' : 'Thu'
    _dv_fri = _isToday_fri ? '[Fri]' : 'Fri'

    // Label: "DOW" on Sunday row only, blank on the rest; "DOW OFF" if master off
    _dowHeaderTxt = _dowOff ? 'DOW OFF' : 'DOW'
    _dowHeaderClr = _dowOff ? clrGray : clrLabel

    table.cell(infoTable, 0, 17, _dowHeaderTxt, text_color = _dowHeaderClr, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 1, 17, _dv_sun, text_color = _dc_sun, bgcolor = clrRowDark, text_size = pSize, text_halign = text.align_center)
    table.cell(infoTable, 0, 18, '', text_color = clrLabel, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 18, _dv_mon, text_color = _dc_mon, bgcolor = clrRowLight, text_size = pSize, text_halign = text.align_center)
    table.cell(infoTable, 0, 19, '', text_color = clrLabel, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 1, 19, _dv_tue, text_color = _dc_tue, bgcolor = clrRowDark, text_size = pSize, text_halign = text.align_center)
    table.cell(infoTable, 0, 20, '', text_color = clrLabel, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 20, _dv_wed, text_color = _dc_wed, bgcolor = clrRowLight, text_size = pSize, text_halign = text.align_center)
    table.cell(infoTable, 0, 21, '', text_color = clrLabel, bgcolor = clrRowDark, text_size = pSize)
    table.cell(infoTable, 1, 21, _dv_thu, text_color = _dc_thu, bgcolor = clrRowDark, text_size = pSize, text_halign = text.align_center)
    table.cell(infoTable, 0, 22, '', text_color = clrLabel, bgcolor = clrRowLight, text_size = pSize)
    table.cell(infoTable, 1, 22, _dv_fri, text_color = _dc_fri, bgcolor = clrRowLight, text_size = pSize, text_halign = text.align_center)

// ============================================================
// === TRADE LOG TABLE ===
// ============================================================
tlSize = i_tradeLogSize == 'Tiny' ? size.tiny : i_tradeLogSize == 'Small' ? size.small : i_tradeLogSize == 'Normal' ? size.normal : size.large

var table tlTable = i_showTradeLog ? table.new(panelPos(i_tradeLogPos), 6, 12, bgcolor = clrRowDark, border_width = 1, border_color = color.new(#334466, 0), frame_width = 2, frame_color = color.new(#00ff88, 0)) : na

var bool tlLabelsDrawn = false

if i_showTradeLog and not tlLabelsDrawn
    table.cell(tlTable, 0, 0, 'TRADE LOG', text_color = clrHeaderTxt, bgcolor = clrHeader, text_size = tlSize, text_halign = text.align_center)
    table.cell(tlTable, 1, 0, isNinjaViewMode ? p_sym + ' | NV' : p_sym, text_color = isNinjaViewMode ? color.new(color.purple, 0) : clrWarn, bgcolor = clrHeader, text_size = tlSize, text_halign = text.align_center)
    table.cell(tlTable, 2, 0, 'Date', text_color = clrLabel, bgcolor = clrHeader, text_size = tlSize, text_halign = text.align_center)
    table.cell(tlTable, 3, 0, 'Entry', text_color = clrLabel, bgcolor = clrHeader, text_size = tlSize, text_halign = text.align_center)
    table.cell(tlTable, 4, 0, 'Exit', text_color = clrLabel, bgcolor = clrHeader, text_size = tlSize, text_halign = text.align_center)
    table.cell(tlTable, 5, 0, 'P&L $', text_color = clrLabel, bgcolor = clrHeader, text_size = tlSize, text_halign = text.align_center)
    tlLabelsDrawn := true
    tlLabelsDrawn

if i_showTradeLog and shouldUpdate
    totalTrades = tl_wins + tl_losses
    winRate = totalTrades > 0 ? math.round(tl_wins / totalTrades * 100) : 0
    totalPnl = 0.0
    if array.size(tl_pnl) > 0
        for k = 0 to array.size(tl_pnl) - 1 by 1
            totalPnl := totalPnl + array.get(tl_pnl, k)
            totalPnl
    table.cell(tlTable, 0, 1, 'Trades: ' + str.tostring(totalTrades), text_color = clrValue, bgcolor = clrRowLight, text_size = tlSize)
    table.cell(tlTable, 1, 1, 'W:' + str.tostring(tl_wins) + ' L:' + str.tostring(tl_losses), text_color = clrValue, bgcolor = clrRowLight, text_size = tlSize)
    table.cell(tlTable, 2, 1, 'WR: ' + str.tostring(winRate) + '%', text_color = winRate >= 60 ? clrBull : winRate >= 40 ? clrWarn : clrBear, bgcolor = clrRowLight, text_size = tlSize, text_halign = text.align_center)
    table.cell(tlTable, 3, 1, '', bgcolor = clrRowLight, text_size = tlSize)
    table.cell(tlTable, 4, 1, 'Net P&L', text_color = clrLabel, bgcolor = clrRowLight, text_size = tlSize)
    table.cell(tlTable, 5, 1, '$' + str.tostring(math.round(totalPnl, 0)), text_color = totalPnl >= 0 ? clrBull : clrBear, bgcolor = clrRowLight, text_size = tlSize, text_halign = text.align_right)

    logCount = array.size(tl_dir)
    for i = 0 to 9 by 1
        row = i + 2
        rowBg = i % 2 == 0 ? clrRowDark : clrRowLight
        if i < logCount
            dir = array.get(tl_dir, i)
            dateVal = array.get(tl_date, i)
            entryP = array.get(tl_entry, i)
            exitP = array.get(tl_exit, i)
            res = array.get(tl_result, i)
            pnl = array.get(tl_pnl, i)
            dirClr = dir == 'L' ? clrBull : clrBear
            pnlClr = pnl >= 0 ? clrBull : clrBear
            table.cell(tlTable, 0, row, str.tostring(logCount - i), text_color = clrGray, bgcolor = rowBg, text_size = tlSize, text_halign = text.align_center)
            table.cell(tlTable, 1, row, dir, text_color = dirClr, bgcolor = rowBg, text_size = tlSize, text_halign = text.align_center)
            table.cell(tlTable, 2, row, str.format_time(dateVal, 'MM/dd', syminfo.timezone), text_color = clrGray, bgcolor = rowBg, text_size = tlSize, text_halign = text.align_center)
            table.cell(tlTable, 3, row, str.tostring(math.round(entryP, 2)), text_color = clrValue, bgcolor = rowBg, text_size = tlSize, text_halign = text.align_right)
            table.cell(tlTable, 4, row, str.tostring(math.round(exitP, 2)), text_color = clrValue, bgcolor = rowBg, text_size = tlSize, text_halign = text.align_right)
            table.cell(tlTable, 5, row, (pnl >= 0 ? '+' : '') + str.tostring(math.round(pnl, 0)), text_color = pnlClr, bgcolor = rowBg, text_size = tlSize, text_halign = text.align_right)
        else
            table.cell(tlTable, 0, row, '', bgcolor = rowBg, text_size = tlSize)
            table.cell(tlTable, 1, row, '', bgcolor = rowBg, text_size = tlSize)
            table.cell(tlTable, 2, row, '', bgcolor = rowBg, text_size = tlSize)
            table.cell(tlTable, 3, row, '', bgcolor = rowBg, text_size = tlSize)
            table.cell(tlTable, 4, row, '', bgcolor = rowBg, text_size = tlSize)
            table.cell(tlTable, 5, row, '', bgcolor = rowBg, text_size = tlSize)