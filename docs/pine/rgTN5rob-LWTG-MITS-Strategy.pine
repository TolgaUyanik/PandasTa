//@version=6
strategy(title = 'LWTG MITS', shorttitle = 'LWTG MITS', overlay = true, initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_contract, commission_value = 0.50, slippage = 1) // v3.1.17 overlay           = true, initial_capital   = 50000, default_qty_type  = strategy.fixed, default_qty_value = 1, commission_type   = strategy.commission.cash_per_contract, commission_value  = 0.50, slippage          = 1 )

// ============================================================
// === INSTRUMENT PRESET SELECTOR ===
// ============================================================
i_preset = input.string('MES', '⚡ Instrument Preset', options = ['MES', 'MNQ', 'SIL', 'MGC', 'M2K', 'ES', 'NQ', 'SI', 'GC', 'RTY', 'MES-AJAY', 'XAUUSD', 'EURUSD', 'GBPUSD', 'USDJPY', 'AUDUSD', 'EURGBP', 'EURJPY', 'EURAUD', 'GBPJPY', 'GBPAUD', 'AUDJPY'], tooltip = 'Optimized timeframes: MES=15m | MNQ=15m | M2K=15m | MGC=5m | SIL=shelved\nBlock windows (CT): MNQ 10-12 | M2K 13-18 | MGC 10-12 | MES none\nDOW: MNQ all days | MES all days | M2K all days | MGC all days', group = '⚡ Preset')
i_qty = input.int(1, 'Contracts', minval = 1, maxval = 10, group = '⚡ Preset', tooltip = 'Number of contracts to trade (futures). Not used for forex presets — lot size is auto-calculated from Risk $ input.')
i_forex_risk = input.float(10.0, 'Forex Risk Per Trade ($)', minval = 1.0, maxval = 10000.0, step = 1.0, group = '⚡ Preset', tooltip = 'Fixed dollar risk per trade for all forex pairs in Ghost mode. Lot size is auto-calculated: risk / (SL pips × pip value per lot). Ignored for futures presets and TV Native mode.')
i_lots = input.float(0.01, 'Lots (TV Native forex)', minval = 0.01, maxval = 100.0, step = 0.01, group = '⚡ Preset', tooltip = 'Manual lot size for forex pairs in TV Native mode. Set your desired lot size here — the broker panel will use this value. Ignored in Ghost mode (uses auto-calculated lots from Forex Risk $ above) and ignored for futures presets.')

// ── Forex Strength Gate (v2.0) ───────────────────────────────────────────
i_useFXGate = input.bool(true, '🌐 Use Forex Strength Gate', group = '⚡ Preset', tooltip = 'When ON: only allows forex entries when base currency is stronger than quote (long) or weaker (short). Ignored for futures presets.')
i_fxMinDiv = input.float(0.05, '🌐 FX Min Divergence (%)', minval = 0.0, maxval = 2.0, step = 0.01, group = '⚡ Preset', tooltip = 'Global default minimum divergence. XAUUSD uses its own tuned value (0.25%) regardless of this input. For all other forex pairs: base must be this % stronger/weaker than quote to allow entry.')
i_fxLookback = input.int(288, '🌐 FX Strength Lookback (bars)', minval = 48, maxval = 576, step = 48, group = '⚡ Preset', tooltip = 'Global default lookback for forex strength calculation. XAUUSD uses its own tuned value (528 bars) regardless of this input. For all other forex pairs: 288 bars = ~1 full trading day on 5m. Range: 48 (4h) to 576 (2 days).')

i_executionMode = input.string('Ghost', '⚡ Execution Mode', options = ['Ghost', 'TV Native', 'Ninja-View'], tooltip = 'Ghost: fully automated via webhook to Quantcrawler Ghost. TV Native: strategy enters and brackets via TradingView broker integration. Ninja-View: fully automated via webhook to NinjaTrader 8.', group = '⚡ Preset')

// ── Divergence Strategy (Forex only, not XAUUSD) ──────────────────────────
i_useDivStrategy = input.bool(true, '📊 Use Divergence Strategy (not XAUUSD)', group = '⚡ Preset', tooltip = 'Replaces confluence scoring with currency strength divergence logic for all forex pairs except XAUUSD. Walk-forward validated W2/W3. Uses volatility-normalized net currency strength to find strongest-vs-weakest pair.')
i_divNormWindow = input.int(2880, '📊 Div Norm Window (bars)', minval = 576, maxval = 5760, step = 288, group = '⚡ Preset', tooltip = 'Rolling window for volatility normalization. 2880 bars = 10x lookback on 5m chart (H1 lookback x10 from walk-forward). Larger = smoother, less reactive.')
i_divMinDiv = input.float(0.05, '📊 Div Min Divergence', minval = 0.0, maxval = 1.0, step = 0.01, group = '⚡ Preset', tooltip = 'Minimum normalized strength gap between strongest and weakest currency. Walk-forward validated: 0.05.')
i_divConfirmBars = input.int(36, '📊 Div Confirm Bars (5m)', minval = 6, maxval = 144, step = 6, group = '⚡ Preset', tooltip = 'Bars same pair must hold dominant before entry. 36 = 3 H1 bars on 5m chart. Walk-forward validated: 3 H1.')
i_divStabilityBars = input.int(24, '📊 Div Stability Bars (5m)', minval = 6, maxval = 96, step = 6, group = '⚡ Preset', tooltip = 'Bars divergence must expand before entry. 24 = 2 H1 bars on 5m chart. Walk-forward validated: 2 H1.')
i_divSoftExit = input.float(0.4, '📊 Div Soft Exit Fraction', minval = 0.1, maxval = 1.0, step = 0.05, group = '⚡ Preset', tooltip = 'Close when pair divergence drops below this fraction of entry divergence. 0.4 = exit at 40% of entry strength. Walk-forward validated: 0.4.')
i_divMaxBars = input.int(576, '📊 Div Max Bars (5m)', minval = 48, maxval = 1440, step = 48, group = '⚡ Preset', tooltip = 'Force-close after this many bars. 576 = 48 H1 bars on 5m chart. Walk-forward validated: 48 H1.')
i_divUseTrend = input.bool(true, '📊 Div Trend Filter (EMA-50)', group = '⚡ Preset', tooltip = 'Only enter in the direction of the 50-bar EMA on chart timeframe. Walk-forward validated: true.')
i_divSession = input.bool(true, '📊 Div Session Filter (UTC 08-22)', group = '⚡ Preset', tooltip = 'Only allow divergence entries during UTC 08:00-22:00 active forex hours.')

// v3.1.16: This dropdown controls the alert() payload FORMAT only.
// v3.x ALWAYS requires TWO separate TradingView alerts:
//   Alert 1: "Order fills only" → Ghost URL (execution via strategy.order.alert_message)
//   Alert 2: "alert() function calls only" → GAS URL (logging via alert())
// The dropdown here sets which format the alert() calls use — keep on "Ghost Webhook"
// for live trading. GAS logging is now always active regardless of this setting.
i_webhookMode = input.string('Ghost Webhook', '📡 Webhook Mode', options = ['Ghost Webhook', 'Google Sheets Webhook'], tooltip = 'LIVE TRADING: keep on Ghost Webhook. You need TWO separate TV alerts: (1) Order fills only → Ghost URL for execution, (2) alert() function calls only → GAS URL for logging. This dropdown only controls the alert() payload format — GAS logging is always active in v3.1.14+.\n\nPaper Mode: check the Paper Mode box below to suppress Ghost execution while keeping GAS logging active.', group = '⚡ Preset')
i_paperMode = input.bool(false, '📝 Paper Mode (suppress Ghost payload)', tooltip = 'When ON: strategy.entry()/strategy.exit() still fire normally — TradingView\'s built-in Paper Trading panel keeps updating as usual. But the Ghost webhook payload (alert_message) is suppressed, so no live order reaches Ghost.\n\nGAS logging (Google Sheets Webhook mode) is completely unaffected either way — GAS uses separate alert() calls gated by Webhook Mode, not by this toggle.\n\nUse this to run 24/7 on TV\'s paper account while testing new params, without risking a live fill.', group = '⚡ Preset')
// ACCOUNT SELECTION NOTE:
// Ghost Mode:     account is configured inside the Ghost dashboard — no input needed here
// TV Native Mode: account is selected via TradingView Trade panel (broker link) — no input needed here
// Ninja-View Mode: account must be specified here — NT8 is not visible to TradingView
//   To find your account string: open NT8 → Control Center → Accounts
//   Copy the account name exactly as shown — it is case-sensitive
//   Sim101 = NinjaTrader built-in simulator (use for testing)
//   Prop firm accounts use a full string e.g. MAX-50SM421712028609!FundedFuturesNetwork!FundedFuturesNetwork
//   Paste the same string on all 5 instrument charts
i_nv_account = input.string('Sim101', '🥷 NV Account', tooltip = 'Ninja-View mode only. Paste your NT8 account string exactly as shown in NinjaTrader 8 Control Center → Accounts. Ghost and TV Native modes do not use this field — account selection for those modes is handled externally (Ghost dashboard / TradingView Trade panel). Use Sim101 for testing. For live prop firm accounts paste the full account string exactly as shown in NT8.', group = '⚡ Preset')
// NV Ticker is auto-calculated from instrument preset + current date
// SIL (MISF) uses a manual override due to its non-standard listing cycle
// A global override is available for any instrument near roll dates
i_nv_sil_month = input.string('06-26', '🥷 NV SIL Contract', tooltip = 'MISF contract month in MM-YY format (e.g. 06-26). SIL (MISF) has a non-standard listing cycle — update manually each roll. Only used in Ninja-View mode when SIL preset is selected.', group = '⚡ Preset')
i_nv_override = input.string('', '🥷 NV Ticker Override', tooltip = 'Leave blank to use auto-calculated ticker. Paste full NT8 ticker here (e.g. MES 09-26) to override auto-calc — useful near roll dates. Clears automatically when no longer needed. Only used in Ninja-View mode.', group = '⚡ Preset')

