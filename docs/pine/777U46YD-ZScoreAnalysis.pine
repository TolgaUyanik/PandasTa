// @description Z-score analysis for detecting statistical deviations and excess market behavior by AlKaIsMe
library("ZScoreAnalysis")

// @function Calculate Z-score and related metrics with history tracking
// @param source Data source for Z-score calculation
// @param lookback Lookback period for mean and standard deviation
// @param threshold Z-score threshold for significance
// @param switch_enabled Enable/disable switch ("Enabled"/"Disabled")
// @returns [z_score, z_hist, z_avg] Z-score, historical significant values, and running average
export calculate_zscore(float source, int lookback, float threshold, string switch_enabled) =>
    var float z_score = na
    var float z_hist = na
    var float z_avg = na
    var float running_sum = 0.0
    var int count = 0
    var float last_z = 0.0
    
    if switch_enabled == "Enabled"
        float avg = ta.sma(source, lookback)
        float stdDev = ta.stdev(source, lookback, false)
        
        // Avoid division by zero
        if stdDev != 0
            z_score := (source - avg) / stdDev
            
            if z_score > threshold
                z_hist := z_score
                if count >= lookback
                    running_sum := running_sum - last_z
                    count := lookback - 1
                running_sum := running_sum + z_score
                count := count + 1
                last_z := z_score
            else
                z_hist := na
            
            z_avg := count > 0 ? running_sum / count : na
        else
            z_score := 0
            z_hist := na
            z_avg := na
    else
        z_score := na
        z_hist := na
        z_avg := na
    
    [z_score, z_hist, z_avg]

// @function Get threshold based on threshold option
// @param opt Threshold option ("User Input Threshold", "Average as Threshold", or other)
// @param input_thr User input threshold
// @param avg Average threshold
// @returns Calculated threshold value
export get_zscore_threshold(string opt, float input_thr, float avg) =>
    opt == "User Input Threshold" ? input_thr : opt == "Average as Threshold" ? avg : na

// @function Check if a metric passes the Z-score filter
// @param switch_enabled Enable/disable switch
// @param zscore Current Z-score value
// @param threshold Z-score threshold
// @returns True if filtered (exceeds threshold)
export is_zscore_filtered(string switch_enabled, float zscore, float threshold) =>
    switch_enabled == "Enabled" and zscore >= threshold

// @function Calculate consecutive distances for Z-score analysis
// @param body_dir Body direction
// @param breakout_dir Breakout direction  
// @param is_inside_bar Inside bar flag
// @returns [consecutive_close_dist, consecutive_hl_dist]
export get_consecutive_distances(int body_dir, int breakout_dir, bool is_inside_bar) =>
    // Consecutive close distance (when directions are consecutive)
    bool c_C = not ((body_dir == 1 and body_dir[1] == -1) or (body_dir == -1 and body_dir[1] == 1))
    float c_C_dist = c_C ? math.abs(close - close[1]) : 0
    
    // Consecutive high-low distance 
    bool c_HL = not is_inside_bar and not 
     ((breakout_dir == 1 and breakout_dir[1] == -1) or (breakout_dir == -1 and breakout_dir[1] == 1))
    
    float HtoH_dist = math.abs(high - high[1])
    float LtoL_dist = math.abs(low - low[1])
    float c_HL_dist = c_HL ? math.abs(HtoH_dist - LtoL_dist) : 0
    
    [c_C_dist, c_HL_dist]

// @function Calculate distance from trend to mean for momentum analysis
// @returns Distance between trend and mean
export get_trend_to_mean_distance() =>
    float ohlcc5 = math.avg(high, open, low, close, close)
    float trend = ta.ema(ohlcc5, 1)
    float mean = ta.ema(close, 20)
    math.abs(trend - mean)

// @function Get all Z-score calculations for the indicator
// @param lookback Z-score lookback period
// @param threshold Z-score threshold
// @param bar_dist_switch Enable bar distance Z-score
// @param body_dist_switch Enable body distance Z-score  
// @param chl_dist_switch Enable consecutive highs/lows Z-score
// @param cc_dist_switch Enable consecutive closes Z-score
// @param m_dist_switch Enable momentum distance Z-score
// @param body_dir Body direction
// @param breakout_dir Breakout direction
// @param is_inside_bar Inside bar flag
// @returns [z_results] Array of Z-score results and filters
export get_all_zscores(int lookback, float threshold, string bar_dist_switch, string body_dist_switch, 
                      string chl_dist_switch, string cc_dist_switch, string m_dist_switch,
                      int body_dir, int breakout_dir, bool is_inside_bar) =>
    
    // Basic distances
    float bar_dist = high - low
    float body_dist = math.abs(close - open)
    [c_C_dist, c_HL_dist] = get_consecutive_distances(body_dir, breakout_dir, is_inside_bar)
    float trend_mean_dist = get_trend_to_mean_distance()
    
    // Calculate all Z-scores
    [Z_baR_dist, Z_baR_dist_hist, Z_baR_dist_avg] = calculate_zscore(bar_dist, lookback, threshold, bar_dist_switch)
    [Z_boD_dist, Z_boD_dist_hist, Z_boD_dist_avg] = calculate_zscore(body_dist, lookback, threshold, body_dist_switch)
    [Z_CHL_dist, Z_CHL_dist_hist, Z_CHL_dist_avg] = calculate_zscore(c_HL_dist, lookback, threshold, chl_dist_switch)
    [Z_CC_dist, Z_CC_dist_hist, Z_CC_dist_avg] = calculate_zscore(c_C_dist, lookback, threshold, cc_dist_switch)
    [Z_M_dist, Z_M_dist_hist, Z_M_dist_avg] = calculate_zscore(trend_mean_dist, lookback, threshold, m_dist_switch)
    
    // Create results map
    map<string, float> z_scores = map.new<string, float>()
    map<string, float> z_thresholds = map.new<string, float>()
    map<string, bool> z_filters = map.new<string, bool>()
    
    // Store Z-scores
    map.put(z_scores, "bar_dist", Z_baR_dist)
    map.put(z_scores, "body_dist", Z_boD_dist) 
    map.put(z_scores, "chl_dist", Z_CHL_dist)
    map.put(z_scores, "cc_dist", Z_CC_dist)
    map.put(z_scores, "m_dist", Z_M_dist)
    
    // Calculate and store thresholds
    map.put(z_thresholds, "bar_dist", get_zscore_threshold("Average as Threshold", threshold, Z_baR_dist_avg))
    map.put(z_thresholds, "body_dist", get_zscore_threshold("Average as Threshold", threshold, Z_boD_dist_avg))
    map.put(z_thresholds, "chl_dist", get_zscore_threshold("Average as Threshold", threshold, Z_CHL_dist_avg))
    map.put(z_thresholds, "cc_dist", get_zscore_threshold("Average as Threshold", threshold, Z_CC_dist_avg))
    map.put(z_thresholds, "m_dist", get_zscore_threshold("Average as Threshold", threshold, Z_M_dist_avg))
    
    // Calculate and store filters
    map.put(z_filters, "bar_dist", is_zscore_filtered(bar_dist_switch, Z_baR_dist, map.get(z_thresholds, "bar_dist")))
    map.put(z_filters, "body_dist", is_zscore_filtered(body_dist_switch, Z_boD_dist, map.get(z_thresholds, "body_dist")))
    map.put(z_filters, "chl_dist", is_zscore_filtered(chl_dist_switch, Z_CHL_dist, map.get(z_thresholds, "chl_dist")))
    map.put(z_filters, "cc_dist", is_zscore_filtered(cc_dist_switch, Z_CC_dist, map.get(z_thresholds, "cc_dist")))
    map.put(z_filters, "m_dist", is_zscore_filtered(m_dist_switch, Z_M_dist, map.get(z_thresholds, "m_dist")))
    
    // Calculate and store the "any_zscore" combination directly in z_filters
    bool any_zscore_active = map.get(z_filters, "bar_dist") or 
                             map.get(z_filters, "body_dist") or 
                             map.get(z_filters, "chl_dist") or 
                             map.get(z_filters, "cc_dist") or 
                             map.get(z_filters, "m_dist")
    
    map.put(z_filters, "any_zscore", any_zscore_active)
    
    [z_scores, z_thresholds, z_filters]

// @function Get combined Z-score filters
// @param z_filters Map of individual Z-score filters
// @returns [combined_filters] Various combinations of Z-score filters
export get_combined_zscore_filters(map<string, bool> z_filters) =>
    bool bar_filtered = map.get(z_filters, "bar_dist")
    bool body_filtered = map.get(z_filters, "body_dist")
    bool chl_filtered = map.get(z_filters, "chl_dist")
    bool cc_filtered = map.get(z_filters, "cc_dist")
    bool m_filtered = map.get(z_filters, "m_dist")
    
    map<string, bool> combined_filters = map.new<string, bool>()
    
    map.put(combined_filters, "bar_or_body", bar_filtered or body_filtered)
    map.put(combined_filters, "bar_or_body_or_cc", bar_filtered or body_filtered or cc_filtered)
    map.put(combined_filters, "bar_or_body_or_chl", bar_filtered or body_filtered or chl_filtered)
    map.put(combined_filters, "any_zscore", bar_filtered or body_filtered or chl_filtered or cc_filtered)
    map.put(combined_filters, "all_with_momentum", bar_filtered or body_filtered or chl_filtered or cc_filtered or m_filtered)
    
    combined_filters

// @function Calculate basic distances used in Z-score analysis
// @returns [bar_dist, body_dist] Bar range and body range
export get_basic_distances() =>
    float bar_dist = high - low
    float body_dist = math.abs(close - open)
    [bar_dist, body_dist]

// @function Get individual Z-score filter by name
// @param z_filters Map of Z-score filters
// @param filter_name Name of the filter ("bar_dist", "body_dist", etc.)
// @returns Boolean filter result
export get_individual_zscore_filter(map<string, bool> z_filters, string filter_name) =>
    map.get(z_filters, filter_name)

// @function Check if any Z-score filter is active
// @param z_filters Map of individual Z-score filters
// @returns True if any Z-score exceeds threshold
export has_any_zscore_signal(map<string, bool> z_filters) =>
    map.get(z_filters, "bar_dist") or 
     map.get(z_filters, "body_dist") or 
     map.get(z_filters, "chl_dist") or 
     map.get(z_filters, "cc_dist") or 
     map.get(z_filters, "m_dist")