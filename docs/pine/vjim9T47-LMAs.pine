swma = SMMA(close, 50)
hma  = HMA (close, 50)
lsma = LSMA(close, 3, 0)
alma = ALMA(close, 50, 0, 6)
zlsma = ZLSMA(close, 50)
frama = FRAMA(close, 50)
kama = KAMA(close, 50)
jma = JMA(close, 50, 0)
