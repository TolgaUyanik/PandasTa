//@version=6
// @description Custom Dynamic MA's that allow a dynamic calculation beginning from the first bar\ use getDynamicLength(maxLength) =>\\tmath.min(maxLength, bar_index + 1) \as length

library("LMAs", true)
import TradingView/ta/10 as ta

// Function to get the current dynamic length
getDynamicLength(maxLength) =>
    math.min(maxLength, bar_index + 1)


// @function Dynamic SMA
// @param Source and Length
export SMA(float sourceData, int maxLength) =>
    len = getDynamicLength(maxLength)
    validData = array.new_float(0)  // Initialize an empty array to store valid data points

    for i = 0 to len - 1
        if not na(sourceData[i])
            array.push(validData, sourceData[i])

    count = array.size(validData)
    if not (count == 0)
        array.sum(validData) / count  // Average the valid data points


// @function Dynamic EMA
// @param Source and Length
export EMA(float src, int length) =>
    len = getDynamicLength(length)
    alpha = 2 / (len + 1)
    var float emaValue = na  // Persistent variable for EMA

    // Initialize EMA on the first valid value
    if na(emaValue) and bar_index >= len - 1
        emaValue := na(src) ? na : src
    
    // Calculate EMA if enough bars are available
    if bar_index >= len - 1
        emaValue := na(src) ? emaValue : (src - emaValue) * alpha + emaValue

    emaValue

// @function Dynamic DEMA
// @param Source and Length
export DEMA(float src, int length) =>
    len = getDynamicLength(length)
    e = EMA(src, len)
    d = EMA(e, len)
    2 * e - d

// @function Dynamic TEMA
// @param Source and Length
export TEMA(float src, int length) =>
    len = getDynamicLength(length)
    // Compute the first EMA
    ema1 = EMA(src, len)
    // Compute the second EMA
    ema2 = EMA(ema1, len)
    // Compute the third EMA
    ema3 = EMA(ema2, len)

    // TEMA Calculation
    temaValue = 3 * (ema1 - ema2) + ema3

    temaValue

// @function Dynamic WMA
// @param Source and Length
export WMA(float src, int length) =>
    len = getDynamicLength(length)
    float weightedSum = 0.0
    float normalizationFactor = 0.0

    for i = 0 to len - 1
        value = src[i]
        if not na(value)
            weight = len - i  // Weight decreases as we go back in the series
            weightedSum += value * weight
            normalizationFactor += weight

    normalizationFactor > 0 ? weightedSum / normalizationFactor : na

// @function Dynamic HMA
// @param Source and Length
export HMA(float src, int length) =>
    len = getDynamicLength(length)
    halfLength = math.round(len / 2)
    sqrtLength = math.round(math.sqrt(len))
    
    // Calculate the HMA value
    hmaValue = WMA(2 * WMA(src, halfLength) - WMA(src, len), sqrtLength)
    
    hmaValue

// @function Dynamic VWMA
// @param Source, Volume Source and Length
export VWMA(float src, float volsrc, int length) =>
    dynamicLength = getDynamicLength(length)
    // Calculate total volume price and total volume
    totalVolumePrice = math.sum(na(src * volsrc) ? 0 : src * volsrc, dynamicLength)
    totalVolume = math.sum(na(volsrc) ? 0 : volsrc, dynamicLength)

    // Return the VWMA if total volume is greater than zero
    totalVolume > 0 ? totalVolumePrice / totalVolume : na


// @function Dynamic SMMA
// @param Source and Length
export SMMA(float src, int length) =>
    len = getDynamicLength(length)
    float smma = na
    if bar_index >= len - 1
        alpha = 1 / len
        smma := na(smma[1]) ? SMA(src, len) : (src - smma[1]) * alpha + smma[1]
    else
        smma := src
    smma

// @function Dynamic LSMA
// @param Source and Length
export LSMA(float src, int length, int offset) =>
    len = getDynamicLength(length)
    sum_xy = 0.0
    sum_x  = 0.0
    sum_y  = 0.0
    sum_x2 = 0.0
    count = 0
    for i = 0 to len - 1
        if not na(src[i])
            x = i
            y = src[i]
            sum_xy := sum_xy + x * y
            sum_x  := sum_x  + x
            sum_y  := sum_y  + y
            sum_x2 := sum_x2 + x * x
            count  += 1
    if count > 0
        slope = (count * sum_xy - sum_x * sum_y) / (count * sum_x2 - sum_x * sum_x)
        intercept = (sum_y - slope * sum_x) / count
        slope * (offset - 1) + intercept
    else
        na

// @function Dynamic RMA
// @param Source and Length
export RMA(float src, int length) =>
    len = getDynamicLength(length)
    var float rma = na
    rma := na(rma) ? src : (rma * (len - 1) + src) / len
    rma

// @function Dynamic ALMA
// @param Source and Length - Offset and Sigma (Base: 0, 6)
export ALMA(float src, int length, float offset_sigma, float sigma) =>
    len = getDynamicLength(length)
    m = math.floor(offset_sigma * (len - 1))
    s = len / sigma
    alma = 0.0
    norm = 0.0
    for i = 0 to len - 1
        if not na(src[i])
            weight = math.exp(-1 * math.pow(i - m, 2) / (2 * math.pow(s, 2)))
            norm += weight
            alma += src[i] * weight
    norm > 0 ? alma / norm : na


// @function Dynamic ZLSMA
// @param Source and Length
export ZLSMA(float src, int length) => 
    len = getDynamicLength(length)
    lsma = LSMA(src, len, 0)
    lsma2 = LSMA(lsma, len, 0)
    eq= lsma-lsma2
    zlsma = lsma+eq


// @function Dynamic FRAMA
// @param Source and Length
type vars
    float N1
    float N2
    float N3
    float HH
    float LL
    float Dimen 
    float alpha

export FRAMA(float src, int length) =>
    N = getDynamicLength(length)
    // Variables for FRAMA calculation
    var float Filt   = na
    var float Filt1  = na
    var float Filt2  = na
    var int   count1 = na
    var int   count2 = na


    v = vars.new(0., 0., 0., 0., 0., 0., 0.)

    // Calculate N3 for the fractal dimension
    v.N3 := (ta.highest(high, N) - ta.lowest(low, N)) / N

    v.HH := high
    v.LL := low

    for count = 0 to N / 2 - 1
        if high[count] > v.HH
            v.HH := high[count]
        if low[count] < v.LL
            v.LL := low[count]

    v.N1 := (v.HH - v.LL) / (N / 2)

    v.HH := high[N / 2]
    v.LL := low[N / 2]

    for count = N / 2 to N - 1
        if high[count] > v.HH
            v.HH := high[count]
        if low[count] < v.LL
            v.LL := low[count]

    v.N2 := (v.HH - v.LL) / (N / 2)

    if (v.N1 > 0 and v.N2 > 0 and v.N3 > 0)
        v.Dimen := (math.log(v.N1 + v.N2) - math.log(v.N3)) / math.log(2)

    v.alpha := math.exp(-4.6 * (v.Dimen - 1))
    v.alpha := math.max(math.min(v.alpha, 1), 0.01)

    Filt  := na(Filt) ? src : v.alpha * src + (1 - v.alpha) * Filt[1]

    // Filt  := SMA((bar_index < N + 1) ? src : Filt, 5) -- Apply SMA for smoothing

    Filt


// @function Dynamic KAMA
// @param Source and Length
export KAMA(float src, int length) =>
    len = getDynamicLength(length)
    direction = math.abs(src - src[len])
    volatility = 0.0
    for i = 0 to len - 1
        volatility += math.abs(src[i] - src[i + 1])
    er = volatility != 0 ? direction / volatility : 0.0
    fastSC = 2 / (2 + 1)
    slowSC = 2 / (30 + 1)
    sc = math.pow(er * (fastSC - slowSC) + slowSC, 2)
    var float kama = src
    kama := nz(kama[1]) + sc * (src - nz(kama[1]))
    kama


// @function Dynamic JMA
// @param Source and Length and Phase
export JMA(float src, int length, float phase) =>
    len = getDynamicLength(length)
    beta = 0.45 * (length - 1) / (0.45 * (length - 1) + 2)
    alpha = math.pow(beta, 2)
    var float e0 = src
    var float e1 = src
    var float e2 = src
    e0 := (1 - alpha) * src + alpha * nz(e0[1])
    e1 := (src - e0) * (1 - beta) + beta * nz(e1[1])
    e2 := e0 + phase * e1
    e2


// @function Dynamic T3
// @param Source and Length and Volume Factor
export T3(float src, int length, float volumeFactor) =>
    len = getDynamicLength(length)
    e1 = EMA(src, len)
    e2 = EMA(e1, len)
    e3 = EMA(e2, len)
    e4 = EMA(e3, len)
    e5 = EMA(e4, len)
    e6 = EMA(e5, len)
    c1 = -volumeFactor * volumeFactor * volumeFactor
    c2 = 3 * volumeFactor * volumeFactor + 3 * volumeFactor * volumeFactor * volumeFactor
    c3 = -6 * volumeFactor * volumeFactor - 3 * volumeFactor - 3 * volumeFactor * volumeFactor * volumeFactor
    c4 = 1 + 3 * volumeFactor + volumeFactor * volumeFactor * volumeFactor + 3 * volumeFactor * volumeFactor
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3




// Test Plots
sma  = SMA (close, 50)
ema  = EMA (close, 50)
dema = DEMA(close, 50)
tema = TEMA(close, 50)
rma  = RMA(close, 50)
wma  = WMA(close, 50)
