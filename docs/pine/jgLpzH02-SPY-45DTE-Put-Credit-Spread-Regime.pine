//@version=6
indicator(
    "SPY 45DTE Put Credit Spread Regime v9.1",
    shorttitle="SPY PCS Weekly Gate",
    overlay=true,
    max_bars_back=2000,
    max_labels_count=500
)

//=============================================================================
// SYMBOL AND TIMEFRAME RESTRICTIONS
//=============================================================================

isSpyChart = syminfo.ticker == "SPY"
isFiveMinuteChart = timeframe.isminutes and timeframe.multiplier == 5
isDailyChart = timeframe.isdaily and timeframe.multiplier == 1
isWeeklyChart = timeframe.isweekly and timeframe.multiplier == 1

//=============================================================================
// WEEKLY TRADE GATE
//=============================================================================

groupWeekly = "Weekly Trade Gate"

weeklyFastEmaLength = input.int(
    3,
    "Weekly fast EMA length",
    minval=1,
    group=groupWeekly,
    tooltip="Length of the fast weekly EMA used by the main weekly trade gate. Lower values react sooner to trend changes; higher values are smoother but slower."
)

weeklySlowEmaLength = input.int(
    13,
    "Weekly slow EMA length",
    minval=2,
    group=groupWeekly,
    tooltip="Length of the slow weekly EMA used by the main weekly trade gate. Trading normally requires the fast weekly EMA to remain above this slower trend line."
)

//=============================================================================
// SLOW WEEKLY ROLLOVER FILTER
//=============================================================================

groupRollover = "Slow Weekly Rollover Filter"

enableSlowRolloverFilter = input.bool(
    true,
    "Enable slow rollover filter",
    group=groupRollover,
    tooltip="Blocks new trades when the weekly uptrend is still technically positive but has stalled, flattened, and begun losing momentum. Turn this off only when testing the weekly gate without the early rollover warning."
)

slowRolloverLookback = input.int(
    5,
    "Flattening lookback in completed weeks",
    minval=3,
    maxval=12,
    group=groupRollover,
    tooltip="Number of completed weekly bars used to measure whether the fast weekly EMA and price have made meaningful progress. A longer lookback detects slower deterioration but reacts later."
)

maximumFastEmaGain = input.float(
    0.80,
    "Maximum 3-EMA gain over lookback %",
    minval=-5.0,
    maxval=5.0,
    step=0.05,
    group=groupRollover,
    tooltip="Maximum percentage gain allowed in the fast weekly EMA over the rollover lookback for the market to be considered stalled. Lower values make the rollover filter more sensitive."
)

maximumRecentFastEmaChange = input.float(
    0.15,
    "Maximum recent 2-week 3-EMA change %",
    minval=-5.0,
    maxval=5.0,
    step=0.05,
    group=groupRollover,
    tooltip="Maximum percentage change allowed in the fast weekly EMA over the most recent two completed weeks. Lower values require the EMA to be flatter before rollover is recognized."
)

maximumPriceGain = input.float(
    1.25,
    "Maximum price gain over lookback %",
    minval=-10.0,
    maxval=10.0,
    step=0.05,
    group=groupRollover,
    tooltip="Maximum percentage price gain allowed over the rollover lookback. Lower values classify sideways or weak price action as rollover more readily."
)

sharpWeeklyDropExclusion = input.float(
    2.50,
    "Sharp weekly drop exclusion %",
    minval=0.25,
    maxval=10.0,
    step=0.25,
    group=groupRollover,
    tooltip="Excludes unusually sharp weekly declines from the slow-rollover setup because abrupt selloffs are handled by the crash and other risk controls. Lower values exclude more weekly drops."
)

//=============================================================================
// DAILY FULL / CAUTIOUS TIER
//=============================================================================

groupDaily = "Daily Full / Cautious Regime"

dailyFastSmaLength = input.int(
    20,
    "Daily fast SMA length",
    minval=1,
    group=groupDaily,
    tooltip="Length of the fast daily SMA used for crash detection and recovery checks. The default 20-day average represents short-to-intermediate daily trend health."
)

dailyIntermediateSmaLength = input.int(
    50,
    "Daily intermediate SMA length",
    minval=2,
    group=groupDaily,
    tooltip="Length of the intermediate daily SMA used in trend and recovery conditions. The default 50-day average represents the intermediate market trend."
)

dailyLongSmaLength = input.int(
    200,
    "Daily long SMA length",
    minval=3,
    group=groupDaily,
    tooltip="Length of the longer daily SMA used by broad trend checks. Increasing it makes the long-term trend test slower and less sensitive."
)

dailySlopeLookback = input.int(
    5,
    "Daily 50-SMA slope lookback",
    minval=1,
    group=groupDaily,
    tooltip="Number of completed daily sessions used to compare the intermediate SMA with its earlier value. Larger values judge the slope over a longer period."
)

//=============================================================================
// DAILY 50-EMA ROLLOVER BLOCK
//=============================================================================

groupDaily50 = "Daily 50-EMA Rollover Block"

enableDaily50RolloverBlock = input.bool(
    true,
    "Enable daily 50-EMA rollover block",
    group=groupDaily50,
    tooltip="Blocks trades after the daily 50 EMA has rolled downward and keeps the block latched until explicit recovery conditions are satisfied."
)

dailyTrendEmaLength = input.int(
    50,
    "Daily trend EMA length",
    minval=2,
    group=groupDaily50,
    tooltip="Length of the daily EMA used by the Daily 50 Rollover Block. The default 50 tracks the intermediate daily trend while reacting somewhat faster than a 50 SMA."
)

daily50RolloverLookback = input.int(
    3,
    "Rollover lookback in completed sessions",
    minval=2,
    maxval=10,
    group=groupDaily50,
    tooltip="Number of completed daily sessions used to confirm that the daily trend EMA is not merely down for one day but is also below its earlier level."
)

daily50RolloverConfirmDays = input.int(
    2,
    "Sessions required to confirm rollover",
    minval=1,
    maxval=5,
    group=groupDaily50,
    tooltip="Number of consecutive qualifying rollover sessions required before the Daily 50 block turns on. Higher values reduce false starts but react later."
)

daily50RecoveryConfirmDays = input.int(
    3,
    "Consecutive rising sessions to clear block",
    minval=1,
    maxval=10,
    group=groupDaily50,
    tooltip="Number of consecutive qualifying recovery sessions required before the Daily 50 block clears. Higher values demand a more durable recovery."
)

daily50RecoveryLookback = input.int(
    5,
    "Recovery lookback in completed sessions",
    minval=2,
    maxval=15,
    group=groupDaily50,
    tooltip="Number of completed sessions used to confirm that the daily trend EMA has improved versus its earlier value during recovery."
)

daily50RequirePriceOr20Below = input.bool(
    true,
    "Require price or 20 SMA below 50 EMA",
    group=groupDaily50,
    tooltip="When enabled, rollover requires either price or the daily 20 SMA to be below the daily trend EMA. This prevents a tiny EMA downtick from blocking trades during otherwise healthy price action."
)

daily50ClearRequirePriceAbove = input.bool(
    true,
    "Clear only when price is above 50 EMA",
    group=groupDaily50,
    tooltip="When enabled, the Daily 50 block cannot clear until price closes above the daily trend EMA."
)

daily50ClearRequire20Above = input.bool(
    true,
    "Clear only when 20 SMA is above 50 EMA",
    group=groupDaily50,
    tooltip="When enabled, the Daily 50 block cannot clear until the daily 20 SMA is above the daily trend EMA."
)

//=============================================================================
// DAILY RSI TRADE LATCH
//=============================================================================

groupRsiLatch = "Daily RSI Trade Latch"

enableRsiTradeLatch = input.bool(
    true,
    "Enable RSI trade latch",
    group=groupRsiLatch,
    tooltip="Enables the RSI latch system. A valid oversold RSI trigger can temporarily authorize a cautious trade after the latch has been armed and all required safety conditions are met."
)

dailyRsiLength = input.int(
    14,
    "Daily RSI length",
    minval=2,
    group=groupRsiLatch,
    tooltip="Number of completed daily bars used to calculate RSI for the normal latch, crash recovery, overbought block, and bear-recovery logic."
)

rsiLatchTrigger = input.float(
    30.0,
    "RSI cross-down trigger",
    minval=1.0,
    maxval=49.0,
    step=0.5,
    group=groupRsiLatch,
    tooltip="RSI level that activates the normal oversold latch when the latch is armed. Raising this level produces more frequent triggers; lowering it requires deeper oversold conditions."
)

rsiLatchReset = input.float(
    50.0,
    "RSI latch reset level",
    minval=20.0,
    maxval=80.0,
    step=0.5,
    group=groupRsiLatch,
    tooltip="RSI level that resets an active normal latch and rearms it for a future oversold cycle. This is separate from the post-crash recovery level."
)

rsiRequireActualCrossDown = input.bool(
    true,
    "Require actual cross below trigger",
    group=groupRsiLatch,
    tooltip="When enabled, RSI must move from above the trigger to at or below it."
)

rsiLatchOnlyWhenNormalBlocked = input.bool(
    false,
    "Activate only when normal trading is blocked",
    group=groupRsiLatch,
    tooltip="When enabled, the RSI latch can activate only while normal weekly or daily authorization is blocked. This prevents an oversold latch from being created when normal trading is already allowed."
)

rsiLatchForcesCautious = input.bool(
    true,
    "Force Cautious tier while latch is active",
    group=groupRsiLatch,
    tooltip="When enabled, trades authorized through the RSI latch are classified as cautious rather than full-size opportunities."
)

rsiLatchBypassWeeklyGate = input.bool(
    true,
    "Allow latch to bypass weekly gate",
    group=groupRsiLatch,
    tooltip="Allows an active RSI latch to bypass the Weekly Trade Gate. Leave off when the weekly 3/13 relationship must remain mandatory even for oversold entries."
)

rsiLatchBypassSlowRollover = input.bool(
    true,
    "Allow latch to bypass slow rollover",
    group=groupRsiLatch,
    tooltip="Allows an active RSI latch to bypass the Slow Weekly Rollover Filter. Leave off when stalled weekly momentum should still prevent an RSI-based trade."
)

rsiLatchBypassDaily50Block = input.bool(
    true,
    "Allow latch to bypass daily 50 block",
    group=groupRsiLatch,
    tooltip="Allows an active RSI latch to bypass the Daily 50 Rollover Block. Leave off when a falling intermediate daily trend must remain a hard restriction."
)

//=============================================================================
// DAILY RSI OVERBOUGHT HARD BLOCK
//=============================================================================

groupRsiOverbought = "Daily RSI Overbought Block"

enableRsiOverboughtBlock = input.bool(
    true,
    "Enable RSI overbought hard block",
    group=groupRsiOverbought,
    tooltip="Blocks new trades when daily RSI is excessively high, reducing the chance of entering after an extended move that may be vulnerable to mean reversion."
)

rsiOverboughtOnLevel = input.float(
    70.0,
    "Block ON above RSI",
    minval=50.0,
    maxval=90.0,
    step=0.5,
    group=groupRsiOverbought,
    tooltip="Daily RSI level that turns the overbought block on. Lower values block trades sooner and more often."
)

rsiOverboughtOffLevel = input.float(
    65.0,
    "Block OFF below RSI",
    minval=40.0,
    maxval=85.0,
    step=0.5,
    group=groupRsiOverbought,
    tooltip="Creates hysteresis so the block does not rapidly switch near the upper threshold."
)

//=============================================================================
// STRUCTURAL BEAR MARKET
//
// Separate from the crash circuit breaker. This is designed for prolonged,
// grinding bear markets such as 2022. Once confirmed, it is a hard no-trade
// regime. The RSI latch may continue tracking internally, but it cannot bypass
// a confirmed structural bear market.
//=============================================================================

groupStructuralBear = "Structural Bear Market"

enableStructuralBearFilter = input.bool(
    true,
    "Enable structural bear-market hard block",
    group=groupStructuralBear,
    tooltip="Enables the weekly Structural Bear state. This is a broad, persistent bear-market restriction separate from the short-term Crash Circuit Breaker."
)

structuralBearEntryConfirmWeeks = input.int(
    4,
    "Bear entry confirmation weeks",
    minval=1,
    maxval=12,
    group=groupStructuralBear,
    tooltip="Number of consecutive completed weeks that must satisfy the Structural Bear entry condition before the bear state turns on. The default is four weeks to avoid classifying ordinary corrections as prolonged bear markets."
)

structuralBearExitConfirmWeeks = input.int(
    6,
    "Bear exit confirmation weeks",
    minval=1,
    maxval=12,
    group=groupStructuralBear,
    tooltip="Number of consecutive completed recovery weeks required for the normal Structural Bear exit. Lower values restore trading sooner."
)

// Optional fast exit for a genuine structural recovery. The default conditions
// are intentionally strict so a 2022-style bear-market rally should remain blocked.
enableStructuralBearFastExit = input.bool(
    true,
    "Enable fast structural-bear recovery exit",
    group=groupStructuralBear,
    tooltip="Enables an accelerated Structural Bear exit when stronger recovery evidence is present."
)

structuralBearFastExitConfirmWeeks = input.int(
    2,
    "Fast recovery confirmation weeks",
    minval=1,
    maxval=6,
    group=groupStructuralBear,
    tooltip="Number of consecutive completed weeks required for the fast Structural Bear exit. A value of one allows exit after the first fully qualifying recovery week."
)

structuralBearFastExitRequireLongMa = input.bool(
    true,
    "Fast exit: require close above long MA",
    group=groupStructuralBear,
    tooltip="When enabled, the fast Structural Bear exit also requires daily price to be above the selected long moving average."
)

structuralBearFastExitRequireLongMaRising = input.bool(
    true,
    "Fast exit: require long MA rising",
    group=groupStructuralBear,
    tooltip="This is the main protection against a 2022-style rally while the 200-day trend is still declining."
)

structuralBearPostCrashCooldownWeeks = input.int(
    0,
    "Weeks after crash release before bear filter may activate",
    minval=0,
    maxval=26,
    group=groupStructuralBear,
    tooltip="Set above zero only if you want to delay structural-bear activation after a crash. Default is zero for maximum bear-market protection."
)

enableStructuralBearRsiRecoveryOverride = input.bool(
    false,
    "Enable bear RSI recovery override",
    group=groupStructuralBear,
    tooltip="Off restores the previous hard-block behavior. On permits repeated Cautious entries during a confirmed structural bear when the recovery conditions below are met."
)

structuralBearRsiRecoveryLevel = input.float(
    40.0,
    "Bear RSI override recovery level",
    minval=30.0,
    maxval=60.0,
    step=0.5,
    group=groupStructuralBear,
    tooltip="RSI level that must be exceeded during Structural Bear recovery before the override can become ready."
)

structuralBearRecoveryConfirmDays = input.int(
    2,
    "Bear RSI recovery confirmation days",
    minval=1,
    maxval=10,
    group=groupStructuralBear,
    tooltip="Number of consecutive completed daily sessions that must satisfy the Structural Bear RSI recovery conditions."
)

structuralBearRequireCloseAbove20 = input.bool(
    true,
    "Bear RSI override: require close above daily 20 SMA",
    group=groupStructuralBear,
    tooltip="When enabled, Structural Bear RSI recovery also requires the daily close to be above the daily 20 SMA."
)

structuralBearRequire20Rising = input.bool(
    true,
    "Bear RSI override: require daily 20 SMA rising",
    group=groupStructuralBear,
    tooltip="When enabled, Structural Bear RSI recovery also requires the daily 20 SMA to be rising."
)

//=============================================================================
// STRUCTURAL-BEAR RSI ONE-TRADE LATCH
//
// During a confirmed structural bear, the normal RSI latch remains blocked.
// This separate latch permits exactly one Cautious trade on the session after
// completed daily RSI crosses below the configured bear-market low threshold.
// It cannot bypass an active crash block or the RSI overbought hard block.
//=============================================================================

enableBearRsiOneTradeLatch = input.bool(
    true,
    "Allow one trade after bear-market RSI low cross",
    group=groupStructuralBear,
    tooltip="Allows one limited RSI-based trade while Structural Bear is active after a fresh qualifying oversold trigger. The permission is consumed after one authorized trade."
)

bearRsiOneTradeTrigger = input.float(
    30.0,
    "Bear one-trade RSI cross-down level",
    minval=10.0,
    maxval=45.0,
    step=0.5,
    group=groupStructuralBear,
    tooltip="RSI level used to arm the one-trade Structural Bear opportunity. Lower values require a more extreme oversold reading."
)

bearRsiOneTradeRequireActualCross = input.bool(
    true,
    "Bear one-trade latch: require actual cross below",
    group=groupStructuralBear,
    tooltip="When enabled, completed daily RSI must move from above the level to at or below it."
)

bearRsiOneTradeResetLevel = input.float(
    50.0,
    "Bear one-trade latch rearm RSI level",
    minval=30.0,
    maxval=70.0,
    step=0.5,
    group=groupStructuralBear,
    tooltip="After the one trade opportunity is created, RSI must later rise above this level before another bear-market one-trade setup can arm."
)

//=============================================================================
// CRASH CIRCUIT BREAKER
//=============================================================================

groupBear = "Crash Circuit Breaker"

enableBearMarketBlock = input.bool(
    true,
    "Enable crash circuit breaker",
    group=groupBear,
    tooltip="Master switch for the Crash Circuit Breaker and its post-crash RSI recovery sequencing. Turning this off disables the crash block entirely."
)

bearLongMaType = input.string(
    "SMA",
    "Bear-market long MA type",
    options=["SMA", "EMA"],
    group=groupBear,
    tooltip="Selects the moving-average type used for long-term crash and Structural Bear recovery checks. EMA reacts faster; SMA is smoother and slower."
)

bearLongMaLength = input.int(
    200,
    "Bear-market long MA length",
    minval=20,
    group=groupBear,
    tooltip="Length of the selected long moving average. Longer values represent broader market trend and recover more slowly."
)

bearLongMaSlopeLookback = input.int(
    20,
    "Long MA slope lookback",
    minval=2,
    maxval=100,
    group=groupBear,
    tooltip="Number of completed daily sessions used to determine whether the selected long moving average is rising or falling."
)

bearRequireClosingDrawdown = input.bool(
    true,
    "Entry: require confirmed closing drawdown",
    group=groupBear,
    tooltip="Prevents a normal correction or brief intraday break from being classified as a true bear-market hard block."
)

bearDrawdownLookback = input.int(
    252,
    "Closing drawdown lookback in sessions",
    minval=100,
    maxval=500,
    group=groupBear,
    tooltip="Number of completed daily sessions used to find the trailing closing high for the drawdown calculation."
)

bearDrawdownThreshold = input.float(
    20.0,
    "Minimum closing drawdown from high %",
    minval=10.0,
    maxval=40.0,
    step=0.5,
    group=groupBear,
    tooltip="Required percentage decline from the trailing closing high for the drawdown condition. Higher values require a deeper decline."
)

bearRequireWeeklyDown = input.bool(
    true,
    "Entry: require weekly 3 EMA below 13 EMA",
    group=groupBear,
    tooltip="When enabled, the bear setup also requires the completed weekly trend relationship to be bearish."
)

bearRequirePriceBelowLongMa = input.bool(
    true,
    "Entry: require price below long MA",
    group=groupBear,
    tooltip="When enabled, the bear setup requires daily price to be below the selected long moving average."
)

bearRequireLongMaFalling = input.bool(
    true,
    "Entry: require long MA declining",
    group=groupBear,
    tooltip="When enabled, the selected long moving average must be falling for the bear setup to qualify."
)

bearRequire20SmaBelowLongMa = input.bool(
    false,
    "Entry: require daily 20 SMA below long MA",
    group=groupBear,
    tooltip="When enabled, the daily 20 SMA must be below the selected long moving average for the bear setup to qualify."
)

crashRsiLevel = input.float(
    40.0,
    "Crash entry: RSI below",
    minval=20.0,
    maxval=50.0,
    step=0.5,
    group=groupBear,
    tooltip="Maximum daily RSI allowed for the momentum-based Crash Circuit Breaker trigger. Lower values require more severe momentum weakness."
)

rsiCrashRecoveryLevel = input.float(
    50.0,
    "RSI crash recovery level",
    minval=30.0,
    maxval=70.0,
    step=0.5,
    group=groupBear,
    tooltip="After every new circuit-breaker trigger, normal RSI-latch signals remain disabled until completed daily RSI recovers above this level."
)

rsiCrashRecoveryRequireActualCross = input.bool(
    true,
    "RSI crash recovery: require actual cross above",
    group=groupBear,
    tooltip="When enabled, RSI must move from at or below the recovery level to above it. Merely already being above the level does not complete crash recovery."
)

crashThreeDayDropPct = input.float(
    6.0,
    "Crash entry: minimum 3-session drop %",
    minval=2.0,
    maxval=20.0,
    step=0.5,
    group=groupBear,
    tooltip="Minimum percentage decline over three completed sessions that can trigger the momentum crash condition when the other crash filters are also satisfied."
)

crashFiveDayDropPct = input.float(
    8.0,
    "Crash entry: minimum 5-session drop %",
    minval=3.0,
    maxval=30.0,
    step=0.5,
    group=groupBear,
    tooltip="Minimum percentage decline over five completed sessions that can trigger the momentum crash condition when the other crash filters are also satisfied."
)

crashEmergencyDayDropPct = input.float(
    7.0,
    "Crash entry: emergency 1-session drop %",
    minval=3.0,
    maxval=20.0,
    step=0.5,
    group=groupBear,
    tooltip="Single-session percentage decline that triggers the emergency crash condition without requiring the normal multi-day momentum setup."
)

crashStabilityDays = input.int(
    3,
    "Stable sessions required to clear crash block",
    minval=1,
    maxval=10,
    group=groupBear,
    tooltip="After a crash signal, count completed daily sessions without another significant drop. Any significant drop resets the count."
)

crashConfirmationDays = input.int(
    3,
    "Additional confirmation sessions before release",
    minval=1,
    maxval=10,
    group=groupBear,
    tooltip="After the initial stable-session count completes, remain blocked for this many additional completed sessions. A significant re-drop during either stage restarts the full wait."
)

crashResetDayDropPct = input.float(
    4.0,
    "Crash wait reset: single-session drop %",
    minval=1.0,
    maxval=10.0,
    step=0.5,
    group=groupBear,
    tooltip="A one-session decline of at least this size during crash recovery restarts the full stability and confirmation sequence."
)

crashResetOnNewClosingLow = input.bool(
    true,
    "Crash wait reset: new closing low",
    group=groupBear,
    tooltip="When enabled, any new closing low during crash recovery restarts the full two-stage release wait."
)

//=============================================================================
// ALERT TIMING
//=============================================================================

groupTiming = "Alert Timing"

signalTimezone = input.string(
    "America/New_York",
    "Signal timezone",
    group=groupTiming,
    tooltip="Timezone used to interpret the regular-session timing checks. This should normally match the exchange timezone used for SPY."
)

regularSession = input.session(
    "0930-1600",
    "Regular trading session",
    group=groupTiming,
    tooltip="Regular trading-session window used by the script for session-aware processing and alerts."
)

//=============================================================================
// DISPLAY
//=============================================================================

groupDisplay = "Display"

showDailyTradeBackground = input.bool(
    true,
    "Show daily trade-authorization background",
    group=groupDisplay,
    tooltip="Shows the daily trade-authorization state as chart background shading. Disable it when you want calculations and alerts without the visual overlay."
)

dailyBackgroundTransparency = input.int(
    88,
    "Daily background transparency",
    minval=0,
    maxval=100,
    group=groupDisplay,
    tooltip="Controls the transparency of the daily authorization background. Higher values are lighter and less intrusive."
)

showInternalDaily50Ema = input.bool(
    true,
    "Plot internal completed daily 50 EMA",
    group=groupDisplay,
    tooltip="Plots the internal daily trend EMA used by the Daily 50 Rollover Block."
)

showInternalBearLongMa = input.bool(
    false,
    "Plot internal bear-market long MA",
    group=groupDisplay,
    tooltip="Plots the selected long moving average used by crash and Structural Bear conditions."
)

groupDebug = "Historical Debug Labels"

showDebugCrashBlockOn = input.bool(
    true, "Crash block ON", group=groupDebug,
    tooltip="Shows a historical label when the Crash Circuit Breaker turns on."
)
showDebugCrashConfirmation = input.bool(
    false, "Crash confirmation started", group=groupDebug,
    tooltip="Shows when the crash logic finishes its initial stability stage and enters the confirmation stage."
)
showDebugCrashWaitReset = input.bool(
    false, "Crash wait reset", group=groupDebug,
    tooltip="Shows when a renewed decline resets the crash recovery wait back to the beginning."
)
showDebugCrashBlockOff = input.bool(
    true, "Crash block OFF", group=groupDebug,
    tooltip="Shows a historical label when the Crash Circuit Breaker releases."
)
showDebugStructuralBearOn = input.bool(
    true, "Structural bear ON", group=groupDebug,
    tooltip="Shows a historical label when the Structural Bear state activates."
)
showDebugStructuralBearOff = input.bool(
    true, "Structural bear OFF", group=groupDebug,
    tooltip="Shows a historical label when the Structural Bear state clears."
)
showDebugBearRsiReady = input.bool(
    false, "Structural bear RSI override READY", group=groupDebug,
    tooltip="Shows when the Structural Bear RSI recovery override becomes ready."
)
showDebugBearRsiOneTradeReady = input.bool(
    true, "Bear RSI one-trade READY", group=groupDebug,
    tooltip="Shows when the one-trade Structural Bear RSI latch becomes ready."
)

showDebugRsiOverboughtOn = input.bool(
    true, "RSI overbought block ON", group=groupDebug,
    tooltip="Shows when the RSI overbought block turns on."
)
showDebugRsiOverboughtOff = input.bool(
    true, "RSI overbought block OFF", group=groupDebug,
    tooltip="Shows when the RSI overbought block clears."
)

showDebugRsiCrashRecoveryWaiting = input.bool(
    true, "RSI crash recovery WAITING", group=groupDebug,
    tooltip="Shows each new crash event that forces RSI Crash Recovery back into its waiting state."
)
showDebugRsiCrashRecoveryComplete = input.bool(
    true, "RSI crash recovery COMPLETE", group=groupDebug,
    tooltip="Shows when RSI completes post-crash recovery and rearms the normal RSI latch."
)
showDebugRsiLatchOn = input.bool(
    false, "RSI latch ON", group=groupDebug,
    tooltip="Shows when the normal RSI trade latch activates."
)
showDebugRsiLatchOff = input.bool(
    false, "RSI latch OFF", group=groupDebug,
    tooltip="Shows when the normal RSI trade latch resets or is cancelled."
)
showDebugRsiOverrideOn = input.bool(
    false, "RSI override ON", group=groupDebug,
    tooltip="Shows when an active RSI latch successfully authorizes a cautious trade."
)
showDebugRsiOverrideBlocked = input.bool(
    false, "RSI override BLOCKED", group=groupDebug,
    tooltip="Shows when an RSI latch exists but another mandatory restriction prevents authorization."
)
showDebugRsiOverrideOff = input.bool(
    false, "RSI override OFF", group=groupDebug,
    tooltip="Shows when RSI-based authorization ends."
)

showDebugTradeOnNormal = input.bool(
    true, "Trade authorization ON - normal", group=groupDebug,
    tooltip="Shows when trade authorization turns on through the normal weekly and daily rules."
)
showDebugTradeOnRsi = input.bool(
    true, "Trade authorization ON - RSI override", group=groupDebug,
    tooltip="Shows when trade authorization turns on through the normal RSI-latch override."
)
showDebugTradeOnBearRsiOneTrade = input.bool(
    true, "Trade authorization ON - bear RSI one trade", group=groupDebug,
    tooltip="Shows when trade authorization turns on through the one-trade Structural Bear RSI permission."
)
showDebugTradeOffCrash = input.bool(
    false, "Trade authorization OFF - crash", group=groupDebug,
    tooltip="Shows when authorization turns off because the Crash Circuit Breaker is active."
)
showDebugTradeOffOverbought = input.bool(
    true, "Trade authorization OFF - RSI overbought", group=groupDebug,
    tooltip="Shows when authorization turns off because the RSI overbought block is active."
)
showDebugTradeOffWeekly = input.bool(
    true, "Trade authorization OFF - weekly gate", group=groupDebug,
    tooltip="Shows when authorization turns off because the Weekly Trade Gate is closed."
)
showDebugTradeOffRollover = input.bool(
    true, "Trade authorization OFF - slow rollover", group=groupDebug,
    tooltip="Shows when authorization turns off because the Slow Weekly Rollover Filter is active."
)
showDebugTradeOffDaily50 = input.bool(
    true, "Trade authorization OFF - daily 50", group=groupDebug,
    tooltip="Shows when authorization turns off because the Daily 50 Rollover Block is active."
)
showDebugTradeOffLatchReset = input.bool(
    true, "Trade authorization OFF - RSI latch reset", group=groupDebug,
    tooltip="Shows when RSI authorization ends because the normal latch reset condition was reached."
)
showDebugTradeOffOther = input.bool(
    false, "Trade authorization OFF - other", group=groupDebug,
    tooltip="Shows authorization-off events that do not match one of the specifically labeled causes."
)

showWeeklyTradeDayCount = input.bool(
    true,
    "Show weekly count of authorized trade days",
    group=groupDisplay,
    tooltip="On the weekly chart, shows how many completed daily sessions during each completed week would have produced either a Full or Cautious 9:35 entry."
)

weeklyTradeCountLabelAtrOffset = input.float(
    0.35,
    "Weekly count label height (ATR)",
    minval=0.05,
    maxval=3.0,
    step=0.05,
    group=groupDisplay,
    tooltip="Vertical label spacing measured in ATR units for the weekly authorized-day count. Increase it when labels overlap candles or other markers."
)

// Internal EMA lengths retained only because the existing completed-daily data
// bundle also uses these values elsewhere. They are not part of an HH/HL/LH/LL
// or pivot-classification engine.
int dailyStructureFastEmaLength = 3
int dailyStructureSlowEmaLength = 13

//=============================================================================
// COMPLETED WEEKLY DATA
//=============================================================================

[weeklyFastEma, weeklySlowEma, weeklyFastEmaPrior, weeklyFastEmaTwoWeeksAgo, weeklyFastEmaLookback, weeklySlowEmaPrior, weeklyClose, weeklyClosePrior, weeklyCloseLookback] = request.security(
    syminfo.tickerid,
    "W",
    [
        ta.ema(close, weeklyFastEmaLength)[1],
        ta.ema(close, weeklySlowEmaLength)[1],
        ta.ema(close, weeklyFastEmaLength)[2],
        ta.ema(close, weeklyFastEmaLength)[3],
        ta.ema(close, weeklyFastEmaLength)[slowRolloverLookback + 1],
        ta.ema(close, weeklySlowEmaLength)[2],
        close[1],
        close[2],
        close[slowRolloverLookback + 1]
    ],
    gaps=barmerge.gaps_off,
    lookahead=barmerge.lookahead_on
)

weeklyDataReady = (
    not na(weeklyFastEma) and
    not na(weeklySlowEma) and
    not na(weeklyFastEmaPrior) and
    not na(weeklyFastEmaTwoWeeksAgo) and
    not na(weeklyFastEmaLookback) and
    not na(weeklySlowEmaPrior) and
    not na(weeklyClose) and
    not na(weeklyClosePrior) and
    not na(weeklyCloseLookback)
)

weeklyTradeOn = (
    weeklyDataReady and
    weeklyFastEma > weeklySlowEma
)

//=============================================================================
// SLOW WEEKLY ROLLOVER CALCULATIONS
//=============================================================================

fastEmaLookbackChangePct = (
    weeklyDataReady and weeklyFastEmaLookback != 0
        ? (weeklyFastEma - weeklyFastEmaLookback) /
          weeklyFastEmaLookback * 100.0
        : na
)

fastEmaRecentChangePct = (
    weeklyDataReady and weeklyFastEmaTwoWeeksAgo != 0
        ? (weeklyFastEma - weeklyFastEmaTwoWeeksAgo) /
          weeklyFastEmaTwoWeeksAgo * 100.0
        : na
)

priceLookbackChangePct = (
    weeklyDataReady and weeklyCloseLookback != 0
        ? (weeklyClose - weeklyCloseLookback) /
          weeklyCloseLookback * 100.0
        : na
)

latestWeeklyDropPct = (
    weeklyDataReady and weeklyClosePrior != 0
        ? math.max(
            (weeklyClosePrior - weeklyClose) /
            weeklyClosePrior * 100.0,
            0.0
        )
        : na
)

currentEmaGapPct = (
    weeklyDataReady and weeklySlowEma != 0
        ? (weeklyFastEma - weeklySlowEma) /
          weeklySlowEma * 100.0
        : na
)

priorEmaGapPct = (
    weeklyDataReady and weeklySlowEmaPrior != 0
        ? (weeklyFastEmaPrior - weeklySlowEmaPrior) /
          weeklySlowEmaPrior * 100.0
        : na
)

hadPriorAdvance = (
    weeklyDataReady and
    weeklyFastEmaPrior > weeklyFastEmaLookback
)

fastEmaFlattened = (
    weeklyDataReady and
    fastEmaLookbackChangePct <= maximumFastEmaGain and
    fastEmaRecentChangePct <= maximumRecentFastEmaChange
)

priceStalled = (
    weeklyDataReady and
    priceLookbackChangePct <= maximumPriceGain and
    weeklyClose <= weeklyClosePrior
)

emaGapNarrowing = (
    weeklyDataReady and
    currentEmaGapPct < priorEmaGapPct
)

latestMoveWasNotSharp = (
    weeklyDataReady and
    latestWeeklyDropPct < sharpWeeklyDropExclusion
)

slowRolloverDetected = (
    enableSlowRolloverFilter and
    weeklyTradeOn and
    hadPriorAdvance and
    fastEmaFlattened and
    priceStalled and
    emaGapNarrowing and
    latestMoveWasNotSharp
)

//=============================================================================
// COMPLETED DAILY DATA
//=============================================================================

[dailyClose, dailyClosePrior, dailyCloseThreeSessionsAgo, dailyCloseFiveSessionsAgo, dailyHigh, dailyLow, dailyLowPrior, dailyFastSma, dailyFastSmaPrior, dailyIntermediateSma, dailyLongSma, dailyIntermediateSmaPast, dailyRsi, dailyRsiPrior, dailyStructureFastEma, dailyStructureFastEmaPrior, dailyStructureSlowEma, dailyTrendEma, dailyTrendEmaPrior, dailyTrendEmaRolloverLookback, dailyTrendEmaRecoveryLookback, bearLongMa, bearLongMaSlopePast, bearClosingHigh] = request.security(
    syminfo.tickerid,
    "D",
    [
        close[1],
        close[2],
        close[4],
        close[6],
        high[1],
        low[1],
        low[2],
        ta.sma(close, dailyFastSmaLength)[1],
        ta.sma(close, dailyFastSmaLength)[2],
        ta.sma(close, dailyIntermediateSmaLength)[1],
        ta.sma(close, dailyLongSmaLength)[1],
        ta.sma(close, dailyIntermediateSmaLength)[dailySlopeLookback + 1],
        ta.rsi(close, dailyRsiLength)[1],
        ta.rsi(close, dailyRsiLength)[2],
        ta.ema(close, dailyStructureFastEmaLength)[1],
        ta.ema(close, dailyStructureFastEmaLength)[2],
        ta.ema(close, dailyStructureSlowEmaLength)[1],
        ta.ema(close, dailyTrendEmaLength)[1],
        ta.ema(close, dailyTrendEmaLength)[2],
        ta.ema(close, dailyTrendEmaLength)[daily50RolloverLookback + 1],
        ta.ema(close, dailyTrendEmaLength)[daily50RecoveryLookback + 1],
        bearLongMaType == "EMA"
            ? ta.ema(close, bearLongMaLength)[1]
            : ta.sma(close, bearLongMaLength)[1],
        bearLongMaType == "EMA"
            ? ta.ema(close, bearLongMaLength)[bearLongMaSlopeLookback + 1]
            : ta.sma(close, bearLongMaLength)[bearLongMaSlopeLookback + 1],
        ta.highest(close, bearDrawdownLookback)[1]
    ],
    gaps=barmerge.gaps_off,
    lookahead=barmerge.lookahead_on
)

//=============================================================================
// MARKET-STRUCTURE INDICATOR REMOVED
//=============================================================================
//
// The external Higher High / Higher Low / Lower High / Lower Low indicator
// is not calculated or used anywhere in this version.

bool structureLowerHighBlocked = false
int structureLowerHighCount = 0
int structureResistanceBreakCount = 0
float latestStructureResistance = na

dailyDataReady = (
    not na(dailyClose) and
    not na(dailyHigh) and
    not na(dailyLow) and
    not na(dailyLowPrior) and
    not na(dailyFastSma) and
    not na(dailyFastSmaPrior) and
    not na(dailyIntermediateSma) and
    not na(dailyLongSma) and
    not na(dailyIntermediateSmaPast) and
    not na(dailyRsi) and
    not na(dailyRsiPrior) and
    not na(dailyTrendEma) and
    not na(dailyTrendEmaPrior) and
    not na(dailyTrendEmaRolloverLookback) and
    not na(dailyTrendEmaRecoveryLookback) and
    not na(bearLongMa) and
    not na(bearLongMaSlopePast) and
    not na(bearClosingHigh)
)

//=============================================================================
// DAILY FULL / CAUTIOUS TIER
//=============================================================================

dailyIntermediateRising = (
    dailyDataReady and
    dailyIntermediateSma > dailyIntermediateSmaPast
)

dailyFull = (
    dailyDataReady and
    dailyClose > dailyFastSma and
    dailyFastSma > dailyIntermediateSma and
    dailyClose > dailyIntermediateSma and
    dailyIntermediateSma > dailyLongSma and
    dailyIntermediateRising
)

dailyCautious = (
    dailyDataReady and
    not dailyFull
)

//=============================================================================
// NEW DAILY PERIOD
//=============================================================================

newDailyPeriod = timeframe.change("D")
newWeeklyPeriod = timeframe.change("W")

//=============================================================================
// LATCHED DAILY 50-EMA ROLLOVER BLOCK
//=============================================================================

daily50PriceStructureFailed = (
    not daily50RequirePriceOr20Below or
    dailyClose < dailyTrendEma or
    dailyFastSma < dailyTrendEma
)

daily50RolloverRaw = (
    dailyDataReady and
    dailyTrendEma < dailyTrendEmaPrior and
    dailyTrendEma <= dailyTrendEmaRolloverLookback and
    daily50PriceStructureFailed
)

daily50RisingRaw = (
    dailyDataReady and
    dailyTrendEma > dailyTrendEmaPrior
)

daily50RecoveryStructureReturned = (
    dailyDataReady and
    dailyTrendEma > dailyTrendEmaRecoveryLookback and
    (
        not daily50ClearRequirePriceAbove or
        dailyClose > dailyTrendEma
    ) and
    (
        not daily50ClearRequire20Above or
        dailyFastSma > dailyTrendEma
    )
)

var bool daily50RolloverBlocked = false
var int daily50RolloverCount = 0
var int daily50RisingCount = 0

if not enableDaily50RolloverBlock
    daily50RolloverBlocked := false
    daily50RolloverCount := 0
    daily50RisingCount := 0

else if newDailyPeriod and dailyDataReady
    if daily50RolloverRaw
        daily50RolloverCount += 1
    else
        daily50RolloverCount := 0

    if daily50RisingRaw
        daily50RisingCount += 1
    else
        daily50RisingCount := 0

    if (
        not daily50RolloverBlocked and
        daily50RolloverCount >= daily50RolloverConfirmDays
    )
        daily50RolloverBlocked := true
        daily50RisingCount := 0

    if (
        daily50RolloverBlocked and
        daily50RisingCount >= daily50RecoveryConfirmDays and
        daily50RecoveryStructureReturned
    )
        daily50RolloverBlocked := false
        daily50RolloverCount := 0
        daily50RisingCount := 0

//=============================================================================
// STRUCTURAL BEAR MARKET STATE
//
// Entry requires a persistent completed-week downtrend:
// 1) weekly 3 EMA below weekly 13 EMA,
// 2) weekly 13 EMA falling,
// 3) weekly close below weekly 13 EMA, and
// 4) completed daily close below the selected long moving average.
//
// The long-MA requirement separates a prolonged bear regime from a normal
// correction that is already handled by Slow Rollover and Daily 50 Rollover.
//
// Exit is deliberately slow. A confirmed structural bear remains a hard block
// until the weekly 3 EMA is above the weekly 13 EMA, the weekly close is above
// the weekly 13 EMA, and the weekly 13 EMA has risen for the configured number
// of consecutive completed weeks.
//=============================================================================

structuralBearEntryRaw = (
    weeklyDataReady and
    dailyDataReady and
    weeklyFastEma < weeklySlowEma and
    weeklySlowEma < weeklySlowEmaPrior and
    weeklyClose < weeklySlowEma and
    dailyClose < bearLongMa
)

structuralBearExitRaw = (
    weeklyDataReady and
    weeklyFastEma > weeklySlowEma and
    weeklySlowEma > weeklySlowEmaPrior and
    weeklyClose > weeklySlowEma
)

structuralBearFastLongMaPassed = (
    not structuralBearFastExitRequireLongMa or
    dailyClose > bearLongMa
)

structuralBearFastLongMaSlopePassed = (
    not structuralBearFastExitRequireLongMaRising or
    bearLongMa > bearLongMaSlopePast
)

structuralBearFastExitRaw = (
    enableStructuralBearFastExit and
    weeklyDataReady and
    dailyDataReady and
    weeklyFastEma > weeklySlowEma and
    weeklySlowEma > weeklySlowEmaPrior and
    weeklyClose > weeklySlowEma and
    structuralBearFastLongMaPassed and
    structuralBearFastLongMaSlopePassed
)

var bool structuralBearMarket = false
var int structuralBearEntryCount = 0
var int structuralBearExitCount = 0
var int structuralBearFastExitCount = 0
var bool structuralBearLastExitWasFast = false
var int weeksSinceCrashRelease = 999

//=============================================================================
// CRASH CIRCUIT BREAKER
//=============================================================================

bearClosingDrawdownPct = (
    dailyDataReady and bearClosingHigh > 0
        ? (bearClosingHigh - dailyClose) / bearClosingHigh * 100.0
        : na
)

bearDrawdownEntryPassed = (
    not bearRequireClosingDrawdown or
    bearClosingDrawdownPct >= bearDrawdownThreshold
)

bearWeeklyEntryPassed = (
    not bearRequireWeeklyDown or
    weeklyFastEma < weeklySlowEma
)

bearPriceEntryPassed = (
    not bearRequirePriceBelowLongMa or
    dailyClose < bearLongMa
)

bearSlopeEntryPassed = (
    not bearRequireLongMaFalling or
    bearLongMa < bearLongMaSlopePast
)

bearFastSmaEntryPassed = (
    not bearRequire20SmaBelowLongMa or
    dailyFastSma < bearLongMa
)

bearEntryRaw = (
    weeklyDataReady and
    dailyDataReady and
    bearWeeklyEntryPassed and
    bearPriceEntryPassed and
    bearSlopeEntryPassed and
    bearFastSmaEntryPassed and
    bearDrawdownEntryPassed
)

dailyOneSessionReturnPct = (
    dailyDataReady and dailyClosePrior > 0
        ? (dailyClose / dailyClosePrior - 1.0) * 100.0
        : na
)

dailyThreeSessionReturnPct = (
    dailyDataReady and dailyCloseThreeSessionsAgo > 0
        ? (dailyClose / dailyCloseThreeSessionsAgo - 1.0) * 100.0
        : na
)

dailyFiveSessionReturnPct = (
    dailyDataReady and dailyCloseFiveSessionsAgo > 0
        ? (dailyClose / dailyCloseFiveSessionsAgo - 1.0) * 100.0
        : na
)

crashMomentumSetup = (
    dailyDataReady and
    dailyClose < dailyFastSma and
    dailyFastSma < dailyFastSmaPrior and
    dailyRsi < crashRsiLevel and
    (
        dailyThreeSessionReturnPct <= -crashThreeDayDropPct or
        dailyFiveSessionReturnPct <= -crashFiveDayDropPct
    )
)

crashEmergencySetup = (
    dailyDataReady and
    dailyOneSessionReturnPct <= -crashEmergencyDayDropPct
)

crashEntryRaw = crashMomentumSetup or crashEmergencySetup

crashHigherLowRaw = (
    dailyDataReady and
    dailyLow > dailyLowPrior
)

crashExitRaw = crashHigherLowRaw

bearNormalizeRaw = (
    weeklyDataReady and
    dailyDataReady and
    weeklyTradeOn and
    dailyClose > bearLongMa and
    bearLongMa >= bearLongMaSlopePast and
    dailyFastSma > bearLongMa
)

var bool crashBlocked = false
var bool postCrashRecoveryActive = false
var bool bearMarketBlocked = false
var bool crashConfirmationPhase = false
var int crashStableSessionCount = 0
var int crashConfirmationSessionCount = 0
var float crashReferenceClosingLow = na

crashSignificantRedrop = (
    crashBlocked and
    (
        dailyOneSessionReturnPct <= -crashResetDayDropPct or
        (
            crashResetOnNewClosingLow and
            not na(crashReferenceClosingLow) and
            dailyClose < crashReferenceClosingLow
        )
    )
)

if not enableBearMarketBlock
    crashBlocked := false
    postCrashRecoveryActive := false
    bearMarketBlocked := false
    crashConfirmationPhase := false
    crashStableSessionCount := 0
    crashConfirmationSessionCount := 0
    crashReferenceClosingLow := na

else if newDailyPeriod and dailyDataReady
    // A true crash immediately overrides every other trade permission, including the RSI latch.
    if crashEntryRaw
        crashBlocked := true
        postCrashRecoveryActive := false
        crashConfirmationPhase := false
        crashStableSessionCount := 0
        crashConfirmationSessionCount := 0
        if na(crashReferenceClosingLow)
            crashReferenceClosingLow := dailyClose
        else
            crashReferenceClosingLow := math.min(crashReferenceClosingLow, dailyClose)

    else if crashBlocked
        // Any significant re-drop during either stage restarts the full two-stage wait.
        if crashSignificantRedrop
            crashConfirmationPhase := false
            crashStableSessionCount := 0
            crashConfirmationSessionCount := 0
            if na(crashReferenceClosingLow)
                crashReferenceClosingLow := dailyClose
            else
                crashReferenceClosingLow := math.min(crashReferenceClosingLow, dailyClose)

        else if not crashConfirmationPhase
            // Stage 1: establish the initial stable period, but do not release trading yet.
            crashStableSessionCount += 1

            if crashStableSessionCount >= crashStabilityDays
                crashConfirmationPhase := true
                crashConfirmationSessionCount := 0

        else
            // Stage 2: remain blocked through the failure window that caught the first COVID bounce.
            crashConfirmationSessionCount += 1

            if crashConfirmationSessionCount >= crashConfirmationDays
                crashBlocked := false
                crashConfirmationPhase := false
                crashStableSessionCount := 0
                crashConfirmationSessionCount := 0
                crashReferenceClosingLow := na

    // No special recovery authorization is used. After both stages pass,
    // the normal weekly/daily filters and RSI latch resume control immediately.
    postCrashRecoveryActive := false
    bearMarketBlocked := false

// Track time since the crash block released. This cooldown keeps the structural
// bear filter from interfering with the immediate post-crash recovery logic.
if newWeeklyPeriod
    if crashBlocked
        weeksSinceCrashRelease := 0
    else
        weeksSinceCrashRelease += 1

if newDailyPeriod and not crashBlocked and crashBlocked[1]
    weeksSinceCrashRelease := 0

if not enableStructuralBearFilter
    structuralBearMarket := false
    structuralBearEntryCount := 0
    structuralBearExitCount := 0
    structuralBearFastExitCount := 0
    structuralBearLastExitWasFast := false
else if newWeeklyPeriod and weeklyDataReady
    bool structuralBearEntryAllowed = (
        not crashBlocked and
        weeksSinceCrashRelease >= structuralBearPostCrashCooldownWeeks
    )

    if structuralBearMarket
        if structuralBearExitRaw
            structuralBearExitCount += 1
        else
            structuralBearExitCount := 0

        if structuralBearFastExitRaw
            structuralBearFastExitCount += 1
        else
            structuralBearFastExitCount := 0

        if structuralBearFastExitCount >= structuralBearFastExitConfirmWeeks
            structuralBearMarket := false
            structuralBearEntryCount := 0
            structuralBearExitCount := 0
            structuralBearFastExitCount := 0
            structuralBearLastExitWasFast := true
        else if structuralBearExitCount >= structuralBearExitConfirmWeeks
            structuralBearMarket := false
            structuralBearEntryCount := 0
            structuralBearExitCount := 0
            structuralBearFastExitCount := 0
            structuralBearLastExitWasFast := false
    else
        if structuralBearEntryAllowed and structuralBearEntryRaw
            structuralBearEntryCount += 1
        else
            structuralBearEntryCount := 0

        if structuralBearEntryCount >= structuralBearEntryConfirmWeeks
            structuralBearMarket := true
            structuralBearEntryCount := 0
            structuralBearExitCount := 0
            structuralBearFastExitCount := 0
            structuralBearLastExitWasFast := false

//=============================================================================
// NORMAL STRUCTURAL AUTHORIZATION
//=============================================================================

normalStructureAuthorized = (
    weeklyTradeOn and
    not slowRolloverDetected and
    not daily50RolloverBlocked and
    not structureLowerHighBlocked
)

normalTradeAuthorized = (
    not crashBlocked and
    not bearMarketBlocked and
    not structuralBearMarket and
    normalStructureAuthorized
)

//=============================================================================
// DAILY RSI TRADE LATCH
//=============================================================================

rsiCrossedBelowTrigger = (
    dailyDataReady and
    dailyRsi <= rsiLatchTrigger and
    dailyRsiPrior > rsiLatchTrigger
)

rsiTriggerCondition = (
    rsiRequireActualCrossDown
        ? rsiCrossedBelowTrigger
        : dailyRsi <= rsiLatchTrigger
)

rsiLatchActivationAllowed = (
    not rsiLatchOnlyWhenNormalBlocked or
    not normalStructureAuthorized
)

rsiCrashRecoveryCrossedAbove = (
    dailyDataReady and
    dailyRsi > rsiCrashRecoveryLevel and
    dailyRsiPrior <= rsiCrashRecoveryLevel
)

rsiCrashRecoveryCondition = (
    rsiCrashRecoveryRequireActualCross
        ? rsiCrashRecoveryCrossedAbove
        : dailyRsi > rsiCrashRecoveryLevel
)

var bool rsiLatchActive = false
var bool rsiLatchArmed = true
var bool rsiCrashRecoveryRequired = false

if not enableRsiTradeLatch
    rsiLatchActive := false
    rsiLatchArmed := true
    rsiCrashRecoveryRequired := false

else if newDailyPeriod and dailyDataReady
    // Every new circuit-breaker trigger wipes out the prior RSI setup.
    // This repeats even if another crash signal occurs during the same decline.
    if enableBearMarketBlock and crashEntryRaw
        rsiLatchActive := false
        rsiLatchArmed := false
        rsiCrashRecoveryRequired := true

    // While crash recovery is required, all RSI cross-down signals are ignored.
    // Recovery itself only rearms the latch; it does not authorize a trade.
    else if rsiCrashRecoveryRequired
        rsiLatchActive := false
        rsiLatchArmed := false

        if rsiCrashRecoveryCondition
            rsiCrashRecoveryRequired := false
            rsiLatchArmed := true

    else
        if dailyRsi > rsiLatchReset
            rsiLatchActive := false
            rsiLatchArmed := true

        else if (
            not crashBlocked and
            not rsiLatchActive and
            rsiLatchArmed and
            rsiTriggerCondition and
            rsiLatchActivationAllowed
        )
            rsiLatchActive := true
            rsiLatchArmed := false

//=============================================================================
// STRUCTURAL-BEAR RSI RECOVERY OVERRIDE
//
// A confirmed structural bear normally remains a hard block. This recovery
// subsystem permits repeated Cautious entries when completed daily momentum
// has materially improved. The existing Structural Bear Market settings control
// the RSI level, confirmation days, close-above-20 requirement, and rising-20
// requirement. Any failed recovery condition immediately removes permission.
//=============================================================================

structuralBearRsiRecoveryRaw = (
    enableStructuralBearRsiRecoveryOverride and
    structuralBearMarket and
    dailyDataReady and
    dailyRsi > structuralBearRsiRecoveryLevel and
    (
        not structuralBearRequireCloseAbove20 or
        dailyClose > dailyFastSma
    ) and
    (
        not structuralBearRequire20Rising or
        dailyFastSma > dailyFastSmaPrior
    )
)

var int structuralBearRsiRecoveryCount = 0

if not enableStructuralBearRsiRecoveryOverride or not structuralBearMarket
    structuralBearRsiRecoveryCount := 0
else if newDailyPeriod and dailyDataReady
    if structuralBearRsiRecoveryRaw
        structuralBearRsiRecoveryCount += 1
    else
        structuralBearRsiRecoveryCount := 0

structuralBearRsiOverrideReady = (
    structuralBearMarket and
    structuralBearRsiRecoveryRaw and
    structuralBearRsiRecoveryCount >= structuralBearRecoveryConfirmDays
)

//=============================================================================
// LATCHED DAILY RSI OVERBOUGHT HARD BLOCK
//=============================================================================

var bool rsiOverboughtBlocked = false

if not enableRsiOverboughtBlock
    rsiOverboughtBlocked := false
else if newDailyPeriod and dailyDataReady
    if not rsiOverboughtBlocked and dailyRsi > rsiOverboughtOnLevel
        rsiOverboughtBlocked := true
    else if rsiOverboughtBlocked and dailyRsi < rsiOverboughtOffLevel
        rsiOverboughtBlocked := false

//=============================================================================
// STRUCTURAL-BEAR RSI ONE-TRADE LATCH STATE
//=============================================================================

bearRsiCrossedBelowTrigger = (
    dailyDataReady and
    dailyRsi <= bearRsiOneTradeTrigger and
    dailyRsiPrior > bearRsiOneTradeTrigger
)

bearRsiOneTradeTriggerCondition = (
    bearRsiOneTradeRequireActualCross
        ? bearRsiCrossedBelowTrigger
        : dailyRsi <= bearRsiOneTradeTrigger
)

var bool bearRsiOneTradeAvailable = false
var bool bearRsiOneTradeArmed = true

if not enableBearRsiOneTradeLatch
    bearRsiOneTradeAvailable := false
    bearRsiOneTradeArmed := true
else if newDailyPeriod and dailyDataReady
    // The opportunity lasts for this session only. If it is not used at 9:35,
    // it expires when the next daily session begins.
    bearRsiOneTradeAvailable := false

    if not structuralBearMarket
        bearRsiOneTradeArmed := true
    else
        if dailyRsi > bearRsiOneTradeResetLevel
            bearRsiOneTradeArmed := true

        if (
            bearRsiOneTradeArmed and
            bearRsiOneTradeTriggerCondition and
            not crashBlocked and
            not rsiOverboughtBlocked
        )
            bearRsiOneTradeAvailable := true
            bearRsiOneTradeArmed := false

bearRsiOneTradeAuthorized = (
    enableBearRsiOneTradeLatch and
    structuralBearMarket and
    bearRsiOneTradeAvailable and
    not crashBlocked and
    not rsiOverboughtBlocked
)

//=============================================================================
// RSI BYPASS PERMISSIONS
//=============================================================================

rsiWeeklyPermission = (
    rsiLatchBypassWeeklyGate or
    weeklyTradeOn
)

rsiSlowRolloverPermission = (
    rsiLatchBypassSlowRollover or
    not slowRolloverDetected
)

rsiDaily50Permission = (
    rsiLatchBypassDaily50Block or
    not daily50RolloverBlocked
)

rsiStructurePermission = (
    not structureLowerHighBlocked
)

rsiBypassEligible = (
    rsiWeeklyPermission and
    rsiSlowRolloverPermission and
    rsiDaily50Permission and
    rsiStructurePermission
)

rsiCautiousOverrideAuthorized = (
    enableRsiTradeLatch and
    rsiLatchActive and
    rsiBypassEligible and
    not structuralBearMarket and
    not crashBlocked and
    not rsiOverboughtBlocked
)

structuralBearRecoveryAuthorized = (
    structuralBearRsiOverrideReady and
    not crashBlocked and
    not rsiOverboughtBlocked
)

//=============================================================================
// FINAL TRADE AUTHORIZATION
//=============================================================================

tradeAuthorized = (
    not crashBlocked and
    not rsiOverboughtBlocked and
    (
        (
            not structuralBearMarket and
            (
                normalStructureAuthorized or
                rsiCautiousOverrideAuthorized
            )
        ) or
        structuralBearRecoveryAuthorized or
        bearRsiOneTradeAuthorized
    )
)

//=============================================================================
// 9:35 ALERT TIMING
//=============================================================================

inRegularSession = not na(
    time(
        timeframe.period,
        regularSession,
        signalTimezone
    )
)

is935Close = (
    inRegularSession and
    hour(time_close, signalTimezone) == 9 and
    minute(time_close, signalTimezone) == 35
)

evaluateEntry = (
    isSpyChart and
    isFiveMinuteChart and
    is935Close and
    barstate.isconfirmed
)

fullTierAllowed = (
    not bearRsiOneTradeAuthorized and
    not structuralBearRecoveryAuthorized and
    not bearMarketBlocked and
    normalTradeAuthorized and
    dailyFull and
    not (
        rsiLatchForcesCautious and
        rsiCautiousOverrideAuthorized
    )
)

fullEntry = (
    evaluateEntry and
    tradeAuthorized and
    fullTierAllowed
)

cautiousEntry = (
    evaluateEntry and
    tradeAuthorized and
    not fullTierAllowed
)

bearRsiOneTradeEntry = (
    cautiousEntry and
    bearRsiOneTradeAuthorized
)

// Consume the special bear-market opportunity after its single 9:35 entry.
if bearRsiOneTradeEntry
    bearRsiOneTradeAvailable := false

tradeOff = (
    evaluateEntry and
    not tradeAuthorized
)

//=============================================================================
// DISPLAY TEXT AND COLORS
//=============================================================================

stateName = (
    not weeklyDataReady or not dailyDataReady
        ? "WAITING"
        : crashBlocked
            ? "OFF - CRASH"
            : structuralBearMarket and bearRsiOneTradeAuthorized
                ? "CAUTIOUS - BEAR RSI ONE TRADE"
            : structuralBearRecoveryAuthorized
                ? "CAUTIOUS - BEAR RECOVERY"
            : structuralBearMarket
                ? "OFF - STRUCTURAL BEAR"
            : rsiOverboughtBlocked
                ? "OFF - RSI OVERBOUGHT"
            : bearMarketBlocked
                ? "CAUTIOUS"
            : rsiCautiousOverrideAuthorized
                ? "CAUTIOUS - RSI LATCH"
                : not weeklyTradeOn
                    ? "OFF - WEEKLY"
                    : slowRolloverDetected
                        ? "OFF - ROLLOVER"
                        : daily50RolloverBlocked
                            ? "OFF - DAILY 50"
                            : structureLowerHighBlocked
                                ? "OFF - PIVOT LH"
                                : dailyFull
                                    ? "FULL"
                                    : "CAUTIOUS"
)

stateColor = (
    not weeklyDataReady or not dailyDataReady
        ? color.gray
        : crashBlocked
            ? color.red
            : structuralBearRecoveryAuthorized
                ? color.orange
            : structuralBearMarket
                ? color.red
            : rsiOverboughtBlocked
                ? color.red
            : bearMarketBlocked
                ? color.orange
            : rsiCautiousOverrideAuthorized
                ? color.orange
                : normalStructureAuthorized
                    ? dailyFull
                        ? color.green
                        : color.orange
                    : color.red
)

bearMarketText = (
    not enableBearMarketBlock and not enableStructuralBearFilter
        ? "DISABLED"
        : crashBlocked
            ? crashConfirmationPhase
                ? "CRASH CONFIRM " + str.tostring(crashConfirmationSessionCount) + "/" + str.tostring(crashConfirmationDays)
                : "CRASH STABLE " + str.tostring(crashStableSessionCount) + "/" + str.tostring(crashStabilityDays)
            : structuralBearMarket
                ? "STRUCTURAL BEAR"
                : "NORMAL"
)

bearMarketColor = (
    not enableBearMarketBlock and not enableStructuralBearFilter
        ? color.gray
        : crashBlocked
            ? color.red
            : structuralBearMarket
                ? color.red
                : color.green
)

weeklyGateText = (
    not weeklyDataReady
        ? "WAITING"
        : weeklyTradeOn
            ? "ON"
            : "OFF"
)

weeklyGateColor = (
    not weeklyDataReady
        ? color.gray
        : weeklyTradeOn
            ? color.green
            : color.red
)

rolloverText = (
    not weeklyDataReady
        ? "WAITING"
        : not enableSlowRolloverFilter
            ? "DISABLED"
            : slowRolloverDetected
                ? "BLOCKED"
                : "CLEAR"
)

rolloverColor = (
    not weeklyDataReady
        ? color.gray
        : not enableSlowRolloverFilter
            ? color.gray
            : slowRolloverDetected
                ? color.red
                : color.green
)

daily50Text = (
    not dailyDataReady
        ? "WAITING"
        : not enableDaily50RolloverBlock
            ? "DISABLED"
            : daily50RolloverBlocked
                ? "BLOCKED"
                : daily50RolloverCount > 0
                    ? "WATCH " +
                      str.tostring(daily50RolloverCount) +
                      "/" +
                      str.tostring(daily50RolloverConfirmDays)
                    : "CLEAR"
)

daily50Color = (
    not dailyDataReady
        ? color.gray
        : not enableDaily50RolloverBlock
            ? color.gray
            : daily50RolloverBlocked
                ? color.red
                : daily50RolloverCount > 0
                    ? color.orange
                    : color.green
)


rsiLatchText = (
    not enableRsiTradeLatch
        ? "DISABLED"
        : rsiCrashRecoveryRequired
            ? "CRASH RECOVERY WAIT"
            : crashBlocked
                ? "CRASH BLOCK"
            : structuralBearMarket
                ? rsiLatchActive
                    ? "ACTIVE / BEAR BLOCKED"
                    : "BEAR BLOCKED"
            : rsiLatchActive
                ? rsiBypassEligible
                    ? "ACTIVE UNTIL > " +
                      str.tostring(rsiLatchReset, "#.#")
                    : "ACTIVE / LIMITED"
                : rsiLatchArmed
                    ? "ARMED < " +
                      str.tostring(rsiLatchTrigger, "#.#")
                    : "RESET > " +
                      str.tostring(rsiLatchReset, "#.#")
)

rsiLatchColor = (
    not enableRsiTradeLatch
        ? color.gray
        : rsiCrashRecoveryRequired or crashBlocked or structuralBearMarket
            ? color.red
            : rsiLatchActive
                ? rsiBypassEligible
                    ? color.orange
                    : color.gray
                : rsiLatchArmed
                    ? color.green
                    : color.gray
)

rsiCrashRecoveryText = (
    not enableRsiTradeLatch
        ? "DISABLED"
        : rsiCrashRecoveryRequired
            ? "WAITING > " + str.tostring(rsiCrashRecoveryLevel, "#.#")
            : "COMPLETE"
)

rsiCrashRecoveryColor = (
    not enableRsiTradeLatch
        ? color.gray
        : rsiCrashRecoveryRequired
            ? color.red
            : color.green
)

rsiOverrideText = (
    not enableRsiTradeLatch
        ? "DISABLED"
        : rsiCautiousOverrideAuthorized
            ? "ON"
            : "OFF"
)

rsiOverrideColor = (
    not enableRsiTradeLatch
        ? color.gray
        : rsiCautiousOverrideAuthorized
            ? color.orange
            : color.red
)

rsiOverrideBlockedBy = (
    not enableRsiTradeLatch
        ? "LATCH DISABLED"
        : crashBlocked
            ? "CRASH BLOCK"
            : structuralBearMarket
                ? "STRUCTURAL BEAR"
            : rsiOverboughtBlocked
                ? "RSI OVERBOUGHT"
            : not rsiLatchActive
                ? rsiLatchArmed
                    ? "LATCH NOT TRIGGERED"
                    : "WAITING FOR RESET"
                : not rsiWeeklyPermission
                    ? "WEEKLY GATE"
                    : not rsiSlowRolloverPermission
                        ? "SLOW ROLLOVER"
                        : not rsiDaily50Permission
                            ? "DAILY 50"
                            : not rsiStructurePermission
                                ? "PIVOT LH"
                                : "NONE"
)

rsiOverrideBlockedColor = (
    rsiOverrideBlockedBy == "NONE"
        ? color.green
        : rsiCautiousOverrideAuthorized
            ? color.green
            : color.red
)

rsiOverboughtText = (
    not enableRsiOverboughtBlock
        ? "DISABLED"
        : rsiOverboughtBlocked
            ? "BLOCKED > " + str.tostring(rsiOverboughtOnLevel, "#.#")
            : "CLEAR < " + str.tostring(rsiOverboughtOffLevel, "#.#")
)

rsiOverboughtColor = (
    not enableRsiOverboughtBlock
        ? color.gray
        : rsiOverboughtBlocked
            ? color.red
            : color.green
)

actionText = (
    fullEntry
        ? "SELL PCS - FULL"
        : cautiousEntry
            ? "SELL PCS - CAUTIOUS"
            : tradeOff
                ? "NO TRADE"
                : "WAITING"
)

actionColor = (
    fullEntry
        ? color.green
        : cautiousEntry
            ? color.orange
            : tradeOff
                ? color.red
                : color.gray
)

//=============================================================================
// PLOTS
//=============================================================================

plot(
    isSpyChart ? weeklyFastEma : na,
    title="Completed Weekly 3-EMA",
    color=color.green,
    linewidth=2
)

plot(
    isSpyChart ? weeklySlowEma : na,
    title="Completed Weekly 13-EMA",
    color=color.yellow,
    linewidth=2
)

plot(
    isSpyChart and
    isDailyChart and
    showInternalDaily50Ema
        ? dailyTrendEma
        : na,
    title="Internal Completed Daily 50 EMA",
    color=color.purple,
    linewidth=2
)

plot(
    isSpyChart and
    isDailyChart and
    showInternalBearLongMa
        ? bearLongMa
        : na,
    title="Internal Bear-Market Long MA",
    color=color.red,
    linewidth=2
)

//=============================================================================
// DAILY TRADE-AUTHORIZATION BACKGROUND
//=============================================================================

dailyBackgroundReady = (
    weeklyDataReady and
    dailyDataReady
)

dailyBackgroundColor = (
    not dailyBackgroundReady
        ? na
        : tradeAuthorized
            ? color.new(
                color.green,
                dailyBackgroundTransparency
            )
            : color.new(
                color.red,
                dailyBackgroundTransparency
            )
)

bgcolor(
    isSpyChart and
    isDailyChart and
    showDailyTradeBackground
        ? dailyBackgroundColor
        : na,
    title="Daily Trade Authorization Background"
)

//=============================================================================
// WEEKLY AUTHORIZED-TRADE DAY COUNT
//
// Weekly-chart-only labels count the completed daily sessions inside each
// completed weekly candle for which the script would have authorized either
// a Full or Cautious 9:35 entry. A zero therefore means no daily entry would
// have been sent during that week.
//=============================================================================

if (
    isSpyChart and
    isWeeklyChart and
    showWeeklyTradeDayCount
)
    array<int> weeklyDailyAuthorizationValues = request.security_lower_tf(
        syminfo.tickerid,
        "D",
        tradeAuthorized ? 1 : 0
    )

    int weeklyAuthorizedTradeDays = 0

    if array.size(weeklyDailyAuthorizationValues) > 0
        for dailyAuthorizationValue in weeklyDailyAuthorizationValues
            weeklyAuthorizedTradeDays += dailyAuthorizationValue

    if barstate.isconfirmed
        float weeklyCountLabelY = high + ta.atr(14) * weeklyTradeCountLabelAtrOffset
        color weeklyCountLabelColor = weeklyAuthorizedTradeDays > 0 ? color.green : color.red

        label.new(
            bar_index,
            weeklyCountLabelY,
            str.tostring(weeklyAuthorizedTradeDays),
            style=label.style_label_down,
            color=weeklyCountLabelColor,
            textcolor=color.white,
            size=size.normal,
            tooltip=str.tostring(weeklyAuthorizedTradeDays) +
                " authorized daily trade" +
                (weeklyAuthorizedTradeDays == 1 ? "" : "s") +
                " during this completed week"
        )

//=============================================================================
// HISTORICAL CRASH DEBUG LABELS
// Major transitions only: block on, confirmation stage, reset, and block off.
//=============================================================================

crashBlockTurnedOn = (
    crashBlocked and
    not crashBlocked[1]
)

crashConfirmationStarted = (
    crashBlocked and
    crashConfirmationPhase and
    not crashConfirmationPhase[1]
)

crashWaitResetNow = (
    crashBlocked and
    crashSignificantRedrop and
    crashStableSessionCount == 0 and
    crashConfirmationSessionCount == 0
)

crashBlockTurnedOff = (
    not crashBlocked and
    crashBlocked[1]
)

crashDebugTriggerReason = (
    crashEmergencySetup
        ? "1-DAY DROP " + str.tostring(dailyOneSessionReturnPct, "#.##") + "%"
        : dailyThreeSessionReturnPct <= -crashThreeDayDropPct
            ? "3-DAY DROP " + str.tostring(dailyThreeSessionReturnPct, "#.##") + "%"
            : dailyFiveSessionReturnPct <= -crashFiveDayDropPct
                ? "5-DAY DROP " + str.tostring(dailyFiveSessionReturnPct, "#.##") + "%"
                : "MOMENTUM"
)

crashResetReason = (
    dailyOneSessionReturnPct <= -crashResetDayDropPct
        ? "REDROP " + str.tostring(dailyOneSessionReturnPct, "#.##") + "%"
        : "NEW CLOSING LOW"
)

crashDebugAtr = ta.atr(14)

crashDebugLabelsEnabled = (
    isSpyChart and
    isDailyChart and
    dailyDataReady
)

if crashDebugLabelsEnabled and showDebugCrashBlockOn and crashBlockTurnedOn
    label.new(
        bar_index,
        high + crashDebugAtr * 2.15,
        "CRASH BLOCK ON\n" + crashDebugTriggerReason,
        style=label.style_label_down,
        color=color.red,
        textcolor=color.white,
        size=size.normal
    )

if crashDebugLabelsEnabled and showDebugCrashConfirmation and crashConfirmationStarted
    label.new(
        bar_index,
        high + crashDebugAtr * 1.65,
        "CRASH CONFIRMATION\nSTILL BLOCKED",
        style=label.style_label_down,
        color=color.orange,
        textcolor=color.white,
        size=size.normal
    )

if crashDebugLabelsEnabled and showDebugCrashWaitReset and crashWaitResetNow and not crashBlockTurnedOn
    label.new(
        bar_index,
        high + crashDebugAtr * 1.65,
        "CRASH WAIT RESET\n" + crashResetReason,
        style=label.style_label_down,
        color=color.orange,
        textcolor=color.white,
        size=size.normal
    )

if crashDebugLabelsEnabled and showDebugCrashBlockOff and crashBlockTurnedOff
    label.new(
        bar_index,
        low - crashDebugAtr * 1.65,
        "CRASH BLOCK OFF\n" + str.tostring(crashStabilityDays) + "+" + str.tostring(crashConfirmationDays) + " CLEAR DAYS",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

//=============================================================================
// HISTORICAL STRUCTURAL-BEAR DEBUG LABELS
//=============================================================================

structuralBearTurnedOn = structuralBearMarket and not structuralBearMarket[1]
structuralBearTurnedOff = not structuralBearMarket and structuralBearMarket[1]
structuralBearRsiReadyTurnedOn = (
    structuralBearMarket and
    structuralBearRsiOverrideReady and
    not structuralBearRsiOverrideReady[1]
)

if crashDebugLabelsEnabled and showDebugStructuralBearOn and structuralBearTurnedOn
    label.new(
        bar_index,
        high + crashDebugAtr * 1.90,
        "STRUCTURAL BEAR ON\nALL TRADES BLOCKED",
        style=label.style_label_down,
        color=color.red,
        textcolor=color.white,
        size=size.normal
    )

if crashDebugLabelsEnabled and showDebugStructuralBearOff and structuralBearTurnedOff
    string structuralBearExitLabel = "STRUCTURAL BEAR OFF\n" + str.tostring(structuralBearExitConfirmWeeks) + " RISING WEEKS CONFIRMED\nNORMAL RULES"

    if structuralBearLastExitWasFast
        structuralBearExitLabel := "STRUCTURAL BEAR OFF\nFAST STRUCTURAL RECLAIM CONFIRMED\nNORMAL RULES"

    label.new(
        bar_index,
        low - crashDebugAtr * 1.90,
        structuralBearExitLabel,
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

if crashDebugLabelsEnabled and showDebugBearRsiReady and structuralBearRsiReadyTurnedOn
    label.new(
        bar_index,
        low - crashDebugAtr * 1.35,
        "BEAR RSI RECOVERY READY\n" + str.tostring(structuralBearRecoveryConfirmDays) + " CONFIRMED DAYS",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

bearRsiOneTradeTurnedReady = (
    bearRsiOneTradeAuthorized and
    not bearRsiOneTradeAuthorized[1]
)

if crashDebugLabelsEnabled and showDebugBearRsiOneTradeReady and bearRsiOneTradeTurnedReady
    label.new(
        bar_index,
        low - crashDebugAtr * 1.35,
        "BEAR RSI ONE TRADE READY\nCAUTIOUS AT NEXT 9:35\nRSI " + str.tostring(dailyRsi, "#.#"),
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

//=============================================================================
// HISTORICAL RSI LATCH DEBUG LABELS
// These appear only on the SPY daily chart and only when the setting is enabled.
// The label is placed on the daily candle where the script state changed.
//=============================================================================

rsiCrashRecoveryStarted = (
    rsiCrashRecoveryRequired and
    not rsiCrashRecoveryRequired[1]
)

rsiCrashRecoveryCompleted = (
    not rsiCrashRecoveryRequired and
    rsiCrashRecoveryRequired[1]
)

rsiLatchTurnedOn = (
    rsiLatchActive and
    not rsiLatchActive[1]
)

rsiLatchTurnedOff = (
    not rsiLatchActive and
    rsiLatchActive[1]
)

rsiOverrideTurnedOn = (
    rsiCautiousOverrideAuthorized and
    not rsiCautiousOverrideAuthorized[1]
)

rsiOverrideTurnedOff = (
    not rsiCautiousOverrideAuthorized and
    rsiCautiousOverrideAuthorized[1]
)

rsiOverrideBlockedNow = (
    enableRsiTradeLatch and
    rsiLatchActive and
    not rsiCautiousOverrideAuthorized
)

rsiOverrideBlockStarted = (
    rsiOverrideBlockedNow and
    not rsiOverrideBlockedNow[1]
)

rsiHistoricalBlockReason = (
    crashBlocked
        ? "CRASH BLOCK"
        : structuralBearMarket and not structuralBearRsiOverrideReady
            ? "STRUCTURAL BEAR"
        : rsiOverboughtBlocked
            ? "RSI OVERBOUGHT"
        : not rsiWeeklyPermission
            ? "WEEKLY GATE"
            : not rsiSlowRolloverPermission
                ? "SLOW ROLLOVER"
                : not rsiDaily50Permission
                    ? "DAILY 50"
                    : not rsiStructurePermission
                        ? "PIVOT LH"
                        : not rsiLatchActive
                            ? "LATCH OFF"
                            : "UNKNOWN"
)

rsiDebugAtr = ta.atr(14)

rsiDebugLabelsEnabled = (
    isSpyChart and
    isDailyChart and
    dailyDataReady
)

if rsiDebugLabelsEnabled and showDebugRsiCrashRecoveryWaiting and rsiCrashRecoveryStarted
    label.new(
        bar_index,
        high + rsiDebugAtr * 1.15,
        "RSI CRASH RECOVERY\nWAITING ABOVE " + str.tostring(rsiCrashRecoveryLevel, "#.#"),
        style=label.style_label_down,
        color=color.red,
        textcolor=color.white,
        size=size.normal
    )

if rsiDebugLabelsEnabled and showDebugRsiCrashRecoveryComplete and rsiCrashRecoveryCompleted
    label.new(
        bar_index,
        low - rsiDebugAtr * 1.15,
        "RSI CRASH RECOVERY COMPLETE\nLATCH REARMED",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

if rsiDebugLabelsEnabled and showDebugRsiLatchOn and rsiLatchTurnedOn
    label.new(
        bar_index,
        low - rsiDebugAtr * 0.45,
        "LATCH ON\nRSI " + str.tostring(dailyRsi, "#.#"),
        style=label.style_label_up,
        color=color.orange,
        textcolor=color.white,
        size=size.normal
    )

if rsiDebugLabelsEnabled and showDebugRsiLatchOff and rsiLatchTurnedOff
    label.new(
        bar_index,
        high + rsiDebugAtr * 0.45,
        "LATCH OFF\nRSI " + str.tostring(dailyRsi, "#.#"),
        style=label.style_label_down,
        color=color.gray,
        textcolor=color.white,
        size=size.normal
    )

if rsiDebugLabelsEnabled and showDebugRsiOverrideOn and rsiOverrideTurnedOn
    label.new(
        bar_index,
        low - rsiDebugAtr * 0.95,
        "OVERRIDE ON",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

if rsiDebugLabelsEnabled and showDebugRsiOverrideBlocked and rsiOverrideBlockStarted
    label.new(
        bar_index,
        high + rsiDebugAtr * 1.45,
        "OVERRIDE BLOCKED\n" + rsiHistoricalBlockReason,
        style=label.style_label_down,
        color=color.red,
        textcolor=color.white,
        size=size.normal
    )

if (
    rsiDebugLabelsEnabled and
    showDebugRsiOverrideOff and
    rsiOverrideTurnedOff and
    not rsiOverrideBlockStarted
)
    label.new(
        bar_index,
        high + rsiDebugAtr * 1.45,
        "OVERRIDE OFF\n" + rsiHistoricalBlockReason,
        style=label.style_label_down,
        color=color.gray,
        textcolor=color.white,
        size=size.normal
    )

//=============================================================================
// HISTORICAL RSI OVERBOUGHT DEBUG LABELS
//=============================================================================

rsiOverboughtTurnedOn = rsiOverboughtBlocked and not rsiOverboughtBlocked[1]
rsiOverboughtTurnedOff = not rsiOverboughtBlocked and rsiOverboughtBlocked[1]

if rsiDebugLabelsEnabled and showDebugRsiOverboughtOn and rsiOverboughtTurnedOn
    label.new(
        bar_index,
        high + rsiDebugAtr * 1.75,
        "TRADE OFF\nRSI OVERBOUGHT\nRSI " + str.tostring(dailyRsi, "#.#"),
        style=label.style_label_down,
        color=color.red,
        textcolor=color.white,
        size=size.normal
    )

if rsiDebugLabelsEnabled and showDebugRsiOverboughtOff and rsiOverboughtTurnedOff
    label.new(
        bar_index,
        low - rsiDebugAtr * 1.75,
        "RSI OVERBOUGHT CLEARED\nRSI " + str.tostring(dailyRsi, "#.#"),
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

//=============================================================================
// HISTORICAL TRADE-AUTHORIZATION DEBUG LABELS
// One label is drawn only when the daily authorization background changes.
// Each cause can be enabled or disabled independently in settings.
//=============================================================================

tradeAuthorizationTurnedOn = (
    tradeAuthorized and
    not tradeAuthorized[1]
)

tradeAuthorizationTurnedOff = (
    not tradeAuthorized and
    tradeAuthorized[1]
)

string tradeOffReason = "OTHER"

if crashBlocked
    tradeOffReason := "CRASH BLOCK"
else if structuralBearMarket
    tradeOffReason := "STRUCTURAL BEAR"
else if rsiOverboughtBlocked
    tradeOffReason := "RSI OVERBOUGHT"
else if not weeklyTradeOn
    tradeOffReason := "WEEKLY GATE"
else if slowRolloverDetected
    tradeOffReason := "SLOW ROLLOVER"
else if daily50RolloverBlocked
    tradeOffReason := "DAILY 50"

bool tradeOffToggleEnabled = showDebugTradeOffOther

if tradeOffReason == "CRASH BLOCK"
    tradeOffToggleEnabled := showDebugTradeOffCrash
else if tradeOffReason == "RSI OVERBOUGHT"
    tradeOffToggleEnabled := showDebugTradeOffOverbought
else if tradeOffReason == "WEEKLY GATE"
    tradeOffToggleEnabled := showDebugTradeOffWeekly
else if tradeOffReason == "SLOW ROLLOVER"
    tradeOffToggleEnabled := showDebugTradeOffRollover
else if tradeOffReason == "DAILY 50"
    tradeOffToggleEnabled := showDebugTradeOffDaily50

tradeDebugLabelsEnabled = (
    isSpyChart and
    isDailyChart and
    dailyDataReady
)

if (
    tradeDebugLabelsEnabled and
    tradeAuthorizationTurnedOn and
    bearRsiOneTradeAuthorized and
    showDebugTradeOnBearRsiOneTrade
)
    label.new(
        bar_index,
        low - rsiDebugAtr * 1.55,
        "TRADE ON\nBEAR RSI ONE TRADE",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

if (
    tradeDebugLabelsEnabled and
    tradeAuthorizationTurnedOn and
    structuralBearRecoveryAuthorized and
    showDebugBearRsiReady
)
    label.new(
        bar_index,
        low - rsiDebugAtr * 1.55,
        "TRADE ON\nBEAR RECOVERY",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

if (
    tradeDebugLabelsEnabled and
    tradeAuthorizationTurnedOn and
    not bearRsiOneTradeAuthorized and
    not structuralBearRecoveryAuthorized and
    rsiCautiousOverrideAuthorized and
    showDebugTradeOnRsi
)
    label.new(
        bar_index,
        low - rsiDebugAtr * 1.55,
        "TRADE ON\nRSI OVERRIDE",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

if (
    tradeDebugLabelsEnabled and
    tradeAuthorizationTurnedOn and
    not bearRsiOneTradeAuthorized and
    not structuralBearRecoveryAuthorized and
    not rsiCautiousOverrideAuthorized and
    showDebugTradeOnNormal
)
    label.new(
        bar_index,
        low - rsiDebugAtr * 1.55,
        "TRADE ON\nNORMAL RULES",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white,
        size=size.normal
    )

if (
    tradeDebugLabelsEnabled and
    tradeAuthorizationTurnedOff and
    rsiLatchTurnedOff and
    showDebugTradeOffLatchReset
)
    label.new(
        bar_index,
        high + rsiDebugAtr * 2.05,
        "TRADE OFF\nRSI LATCH RESET\n" + tradeOffReason,
        style=label.style_label_down,
        color=color.red,
        textcolor=color.white,
        size=size.normal
    )
else if (
    tradeDebugLabelsEnabled and
    tradeAuthorizationTurnedOff and
    tradeOffToggleEnabled
)
    label.new(
        bar_index,
        high + rsiDebugAtr * 2.05,
        "TRADE OFF\n" + tradeOffReason,
        style=label.style_label_down,
        color=color.red,
        textcolor=color.white,
        size=size.normal
    )

//=============================================================================
// STATUS PANEL
//=============================================================================

var table statusPanel = table.new(
    position.top_right,
    2,
    17,
    border_width=1
)

if barstate.islast
    table.clear(statusPanel, 0, 0, 1, 16)

    if isSpyChart and not isFiveMinuteChart
        table.cell(
            statusPanel,
            0,
            0,
            "SPY 45DTE Put Credit\nSpread Regime",
            bgcolor=color.black,
            text_color=color.white,
            text_size=size.small
        )

        table.cell(
            statusPanel,
            1,
            0,
            "Switch to\n5-Minute Chart",
            bgcolor=color.red,
            text_color=color.white,
            text_size=size.normal
        )

    else if isSpyChart and isFiveMinuteChart
        table.cell(
            statusPanel,
            0,
            0,
            "SPY 45DTE PCS",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            0,
            "5-MINUTE",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            1,
            "Crash state",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            1,
            bearMarketText,
            bgcolor=bearMarketColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            2,
            "Weekly gate",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            2,
            weeklyGateText,
            bgcolor=weeklyGateColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            3,
            "Slow rollover",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            3,
            rolloverText,
            bgcolor=rolloverColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            4,
            "Daily 50 rollover",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            4,
            daily50Text,
            bgcolor=daily50Color,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            5,
            "Daily RSI",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            5,
            str.tostring(dailyRsi, "#.#"),
            bgcolor=dailyRsi <= rsiLatchTrigger
                ? color.orange
                : dailyRsi > rsiLatchReset
                    ? color.green
                    : color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            6,
            "RSI overbought",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            6,
            rsiOverboughtText,
            bgcolor=rsiOverboughtColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            7,
            "RSI crash recovery",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            7,
            rsiCrashRecoveryText,
            bgcolor=rsiCrashRecoveryColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            8,
            "RSI latch",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            8,
            rsiLatchText,
            bgcolor=rsiLatchColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            9,
            "RSI override",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            9,
            rsiOverrideText,
            bgcolor=rsiOverrideColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            10,
            "Override blocked by",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            10,
            rsiOverrideBlockedBy,
            bgcolor=rsiOverrideBlockedColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            11,
            "Daily tier",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            11,
            dailyFull
                ? "FULL"
                : dailyDataReady
                    ? "CAUTIOUS"
                    : "WAITING",
            bgcolor=dailyFull
                ? color.green
                : dailyDataReady
                    ? color.orange
                    : color.gray,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            12,
            "Final state",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            12,
            stateName,
            bgcolor=stateColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            13,
            "9:35 action",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            13,
            actionText,
            bgcolor=actionColor,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            14,
            "Weekly 3 EMA",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            14,
            str.tostring(weeklyFastEma, "#.##"),
            bgcolor=color.green,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            0,
            15,
            "Weekly 13 EMA",
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            15,
            str.tostring(weeklySlowEma, "#.##"),
            bgcolor=color.yellow,
            text_color=color.black
        )

        table.cell(
            statusPanel,
            0,
            16,
            "Bear " +
            str.tostring(bearLongMaLength) +
            " " +
            bearLongMaType,
            bgcolor=color.black,
            text_color=color.white
        )

        table.cell(
            statusPanel,
            1,
            16,
            str.tostring(bearLongMa, "#.##"),
            bgcolor=crashBlocked
                ? color.red
                : postCrashRecoveryActive
                    ? color.orange
                    : bearMarketBlocked
                        ? color.orange
                        : color.black,
            text_color=color.white
        )

//=============================================================================
// ALERTS
