//@version=5
library("map_custom_value_full")
//@type contains maps fields for creating array with map.Must be expanded if you want to create map other types 
export type maps_arrays
    map<int,int> maps_arrays_int = na
    map<string,int> maps_arrays_string = na

//@type contains array fields of all available array types for create value for maps
//@field int field for create int array
//@field float field for create float array
//@field string field for create string array
//@field bool field for create bool array
//@field color field for create color array
//@field table field for create table array
//@field polyline field for create polyline array
//@field linefill field for create linefill array
//@field line field for create line array
//@field label field for create label array
//@field arrays basic field for create must be specified as a value map
//@field maps_arrays field for create array from maps 
export type arrays 
    int[] int = na
    float[] float = na
    string[] string = na
    bool[] bool = na
    color[] color = na
    table[] table = na
    polyline[] polyline = na
    linefill[] linefill = na
    line[] line = na
    label[] label = na
    arrays[] arrays = na
    maps_arrays[] maps_arrays = na

//@type contains map fields of all available map types for create value for map 
//@field int_key_int_value field for create maps with key = int and value = int
//@field int_key_float_value field for create maps with key = int and value = float
