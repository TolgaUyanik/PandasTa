//1. Create map with array value
map_int_arrays = map.new<string,arrays>()
map_int_arrays.put("int_array",array.from(1,2,3,4,5))
map_int_arrays.put("color_array",array.from(color.red,color.green))

//label.new(bar_index,close,str.tostring(map_int_arrays.get("int_array").int),color = map_int_arrays.get("color_array").color.get(0))

//2. Create map with map value
map_map_values = map.new<string,maps>()
map_map_values.put("mapas",maps.new(string_key_arrays_value = map_int_arrays))

//label.new(bar_index,open,str.tostring(map_map_values.get("mapas").string_key_arrays_value.get("int_array").int),color = map_int_arrays.get("color_array").color.get(1))


//3.maps with value in array with maps
map_int_int = map.new<int,int>()
map_int_int.put(1,1)
map_string_int = map.new<string,int>()
map_string_int.put("a",1)
map_arrays_map = map.new<color,arrays>()
map_arrays_map.put(color.red,arrays.new(maps_arrays = array.from(maps_arrays.new(maps_arrays_int = map_int_int),maps_arrays.new(maps_arrays_string = map_string_int))))
// label.new(bar_index,close-close/2,str.tostring(map_arrays_map.get(color.red).maps_arrays.get(0).maps_arrays_int.get(1)))

var example_usage = table.new(position = position.bottom_right, columns = 3, rows = 2, border_width = 1,border_color =color.black, frame_color = color.black, frame_width = 1)
if barstate.islast
    table.merge_cells(example_usage, 0, 0, 2, 0)
    table.cell(table_id = example_usage, column = 0, row = 0, text = "Example usage:")
    table.cell(table_id = example_usage, column = 0, row = 1, text = '1.Create map with array value:\n\n\n
     map_int_arrays = map.new<string,arrays>()\n\n
     map_int_arrays.put("int_array",array.from(1,2,3,4,5))\n\n
     map_int_arrays.put("color_array",array.from(color.red,color.green))\n\n\n
     we got map map_int_arrays\n\n
     which contains key int_array with value = field arrays type,\n\n
     need request field int and we get array int\n\n
     and key color_array with value = field arrays type,\n\n
     need request field color\n\n
     and we get array color\n\n
     method put which we usage\n\nput value in certain array field based on its type
     ',text_halign = text.align_left,text_valign = text.align_top)
    table.cell(table_id = example_usage, column = 1, row = 1, text = '2.Create map with map value:\n\n\n
     map_map_values = map.new<string,maps>()\n\n
     map_map_values.put("mapas",maps.new\n\n(string_key_arrays_value =
     map_int_arrays))\n\n\n
     we get map map_map_values\n\n
     which contains key mapas with value = field maps type,\n\n
     need request field string_key_arrays_value\n\n
     and we get map <string,int>\n\n
     which equal map map_int_arrays from example 1\n\n
     ',text_halign = text.align_left,text_valign = text.align_top)
    table.cell(table_id = example_usage, column = 2, row = 1, text = '3.Create maps with value in array with maps:\n\n\n
     map_int_int = map.new<int,int>()\n\n
     map_int_int.put(1,1)\n\n
     map_string_int = map.new<string,int>()\n\n
     map_string_int.put("a",1)\n\n
     map_arrays_map = map.new<color,arrays>()\n\n
     map_arrays_map.put(color.red,arrays.new(maps_arrays = \n\n
     array.from(maps_arrays.new(maps_arrays_int = map_int_int),\n\n
     maps_arrays.new(maps_arrays_string = map_string_int))))\n\n\n
     we got map map_arrays_map\n\n
     which contains key color.red with value = field arrays type,\n\n
     need request field maps_arrays\n\n
     and we get array from maps_arrays type\n\n
     need request 0 element and maps_arrays_int field\n\n
     and we get map map_int_int with key = 1 and value = 1\n\n
     need reques 1 element and maps_arrays_string field\n\n
     and we get map map_string_int which key = a and value = 1
      ',text_halign = text.align_left,text_valign = text.align_top)
