    //float_key
    map<float, int> float_key_int_value = na
    map<float, float> float_key_float_value = na
    map<float, string> float_key_string_value = na
    map<float, bool> float_key_bool_value = na
    map<float, color> float_key_color_value = na
    map<float, table> float_key_table_value = na
    map<float, polyline> float_key_polyline_value = na
    map<float, linefill> float_key_linefill_value = na
    map<float, line> float_key_line_value = na
    map<float, label> float_key_label_value = na
    map<float, arrays> float_key_arrays_value = na
    //string_key
    map<string, int> string_key_int_value = na
    map<string, float> string_key_float_value = na
    map<string, string> string_key_string_value = na
    map<string, bool> string_key_bool_value = na
    map<string, color> string_key_color_value = na
    map<string, table> string_key_table_value = na
    map<string, polyline> string_key_polyline_value = na
    map<string, linefill> string_key_linefill_value = na
    map<string, line> string_key_line_value = na
    map<string, label> string_key_label_value = na
    map<string, arrays> string_key_arrays_value = na
    //bool_key
    map<bool, int> bool_key_int_value = na
    map<bool, float> bool_key_float_value = na
    map<bool, string> bool_key_string_value = na
    map<bool, bool> bool_key_bool_value = na
    map<bool, color> bool_key_color_value = na
    map<bool, table> bool_key_table_value = na
    map<bool, polyline> bool_key_polyline_value = na
    map<bool, linefill> bool_key_linefill_value = na
    map<bool, line> bool_key_line_value = na
    map<bool, label> bool_key_label_value = na
    map<bool, arrays> bool_key_arrays_value = na
    //color_key
    map<color, int> color_key_int_value = na
    map<color, float> color_key_float_value = na
    map<color, string> color_key_string_value = na
    map<color, bool> color_key_bool_value = na
    map<color, color> color_key_color_value = na
    map<color, table> color_key_table_value = na
    map<color, polyline> color_key_polyline_value = na
    map<color, linefill> color_key_linefill_value = na
    map<color, line> color_key_line_value = na
    map<color, label> color_key_label_value = na
    map<color, arrays> color_key_arrays_value = na

//put for array type 

//int key

export method put(map<int,arrays> id , int key, int[] value)=>
    id.put(key,arrays.new(int = value))

export method put(map<int,arrays> id , int key, float[] value)=>
    id.put(key,arrays.new(float = value))

export method put(map<int,arrays> id , int key, string[] value)=>
    id.put(key,arrays.new(string = value))

export method put(map<int,arrays> id , int key, bool[] value)=>
    id.put(key,arrays.new(bool = value))

export method put(map<int,arrays> id , int key, color[] value)=>
    id.put(key,arrays.new(color = value))

export method put(map<int,arrays> id , int key, table[] value)=>
    id.put(key,arrays.new(table = value))

