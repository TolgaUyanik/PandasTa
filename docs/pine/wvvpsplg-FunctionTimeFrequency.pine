//@version=5

// @description Functions to encode time in a normalized space (-0.5, 0.5) that corresponds to the position of the 
// current time in the referrence frequency of time.
// The purpose of normalizing the time value in this manner is to provide a consistent and easily comparable 
// representation of normalized time that can be used for various calculations or comparisons without needing 
// to consider the specific scale of time. This function can be particularly useful when working with high-precision 
// timing data, as it allows you to compare and manipulate time values more flexibly than using absolute second 
// counts alone.
// 
// Reference:
// https://github.com/xll0328/TimeSieve/blob/main/utils/timefeatures.py
library("FunctionTimeFrequency")

// @function Second of minute encoded as value between (-0.5, 0.5).
// @param	t	Time value.
// @returns normalized time.
export second_of_minute (int t=second) =>
	t / 59.0 - 0.5

// @function Minute of hour encoded as value between (-0.5, 0.5).
// @param	t	Time value.
// @returns normalized time.
export minute_of_hour (int t=minute) =>
	t / 59.0 - 0.5

// @function Hour of day encoded as value between (-0.5, 0.5).
// @param	t	Time value.
// @returns normalized time.
export hour_of_day (int t=hour) =>
	t / 23.0 - 0.5

// @function Day of week encoded as value between (-0.5, 0.5).
// @param	t	Time value.
// @returns normalized time.
export day_of_week (int t=dayofweek) =>
	t / 6.0 - 0.5

// @function Day of month encoded as value between (-0.5, 0.5).
// @param	t	Time value.
// @returns normalized time.
export day_of_month (int t=dayofmonth) =>
	(t - 1) / 30.0 - 0.5

// @function Day of year encoded as value between (-0.5, 0.5).
// @param	t	Time value.
// @returns normalized time.
export day_of_year (int t=na) =>
	int _day_of_year = (time - timestamp(year, 1, 1, 0, 0, 0)) / 86400000//(24 * 60 * 60 * 1000)
	((na(t) ? _day_of_year : t) - 1) / 365.0 - 0.5

// @function Month of year encoded as value between (-0.5, 0.5).
// @param	t	Time value.
// @returns normalized time.
export month_of_year (int t=month) =>
	(t - 1) / 11.0 - 0.5

// @function Week of year encoded as value between (-0.5, 0.5).
// @param	t	Time value.
// @returns normalized time.
export week_of_year (int t=weekofyear) =>
	(t - 1) / 52.0 - 0.5

