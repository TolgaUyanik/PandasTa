//@version=5
indicator("10-Day Avg Upside vs Downside Volume", overlay=false)

// Conditions
isUp = close > close[1]
isDown = close < close[1]

// Volume values based on condition
upVol = isUp ? volume : 0
downVol = isDown ? volume : 0

// 10-day average volumes
upVolAvg = ta.sma(upVol, 10)
downVolAvg = ta.sma(downVol, 10)

// Plotting
plot(upVolAvg, color=color.green, title="10-Day Upside Volume Avg", linewidth=2)
plot(downVolAvg, color=color.red, title="10-Day Downside Volume Avg", linewidth=2)

// Optional: Plot ratio
plot(upVolAvg / downVolAvg, color=color.blue, title="Upside/Downside Volume Ratio")
