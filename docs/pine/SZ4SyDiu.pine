//@version=6
library("demark_pool")

export f_labelArrayClear(label[] pool, bool run) =>
	while run and array.size(pool) > 0
		label old = array.shift(pool)
		label.delete(old)

export f_labelPushCap(label[] pool, label l, int cap) =>
	if not na(l)
		array.push(pool, l)
		while array.size(pool) > cap
			label old = array.shift(pool)
			label.delete(old)

export f_labelTrimCap(label[] pool, bool run, int cap) =>
	while run and array.size(pool) > cap
		label old = array.shift(pool)
		label.delete(old)
