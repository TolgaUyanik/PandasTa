//@version=6

//@description A library providing functions for equity calculation and performance metrics.
library("BacktestLibrary")

// # # # # # EXPORTS # # # # # //{

// @function: Calculates the number of candles since a specified date.
// @param date (simple float): The starting date in timestamp format (e.g., input.time(timestamp()))
// @param active (simple bool): If true, counts the number of candles since the date; if false, returns 0.
// @returns (int): The number of candles since the specified date.
export since(simple float date, simple bool active) =>
    var count = 0
    if active and time >= date
        count += 1
    output = count > 2 ? count - 1 : count
    output

// @function: Calculates the Buy and Hold Equity from a specified date.
// @param r (series float): Daily returns of the asset (e.g., 0.02 for 2% move).
// @param startDate (simple float): Timestamp of the starting date for the equity calculation.
// @returns (float): Buy and Hold Equity of the asset from the specified date.
export buy_and_hold(series float r, simple float startDate) =>
    float b = na
    if time >= startDate
        b := na(b[1]) ? 1 : b[1] * (1 + r)
    b

// @function: Calculates the strategy's equity on a candle-by-candle basis.
// @param sig (series float): Signal values; positive for long, negative for short.
// @param threshold (simple float): Signal threshold for entering trades.
// @param r (series float): Daily returns of the asset (e.g., 0.02 for 2% move).
// @param startDate (simple float): Timestamp of the starting date for the equity calculation.
// @param signals (simple string): Type of signals to backtest ("Long & Short", "Long Only", "Short Only").
// @returns (float): Strategy equity on a candle-by-candle basis.
export equity(series float sig, simple float threshold, series float r, simple float startDate, simple string signals) =>
    var int signal = 0
    var float e    = na
    if ta.crossover(sig, threshold)
        signal := 1
    if ta.crossunder(sig, -threshold)
        signal := -1
    if time >= startDate
        float a = 0
        if signals == "Long & Short"
            a := signal[1] > 0 ? r : -r
        else if signals == "Long Only" and signal[1] > 0
            a := r
        else if signals == "Short Only" and signal[1] < 0
            a := -r
        else if signals != "Long & Short" and signals != "Long Only" and signals != "Short Only"
            runtime.error("No Signal Type found")
        e := na(e[1]) ? 1 : e[1] * (1 + a)
    e

// @function: Calculates performance metrics of a strategy from a specified date.
// @param base (series float): Equity values of the strategy or Buy and Hold equity.
// @param Lookback (series int): Number of periods since the start date; recommended to use the 'since' function.
// @param startDate (simple float): Timestamp of the starting date for the equity calculation.
// @returns (float[]): Array of performance metrics.
export PerformanceMetrics(series float base, series int Lookback, simple float startDate) =>
    // Initialize variables for positive and negative returns
    pos_sum = 0.0
    neg_sum = 0.0
    pos_count = 0
    neg_count = 0
    returns_sum = 0.0
    returns_squared_sum = 0.0
    pos_returns_squared_sum = 0.0
    neg_returns_squared_sum = 0.0
    // Loop through the past 'Lookback' bars to calculate sums and counts
    if time >= startDate
        for i = 0 to Lookback - 1
            r = (base[i] - base[i + 1]) / base[i + 1]
            returns_sum += r
            returns_squared_sum += r * r
            if r > 0
                pos_sum += r
                pos_count += 1
                pos_returns_squared_sum += r * r
            else if r < 0
                neg_sum += r
                neg_count += 1
                neg_returns_squared_sum += r * r
    float[] export_array = array.new_float(12)
    // Calculate means
    mean_all = math.round(returns_sum / Lookback, 5)
    mean_pos = pos_count != 0 ? math.round(pos_sum / pos_count, 5) : na
    mean_neg = neg_count != 0 ? math.round(neg_sum / neg_count, 5) : na
    // Calculate standard deviations
    stddev_all = math.round(math.sqrt((returns_squared_sum - (returns_sum * returns_sum) / Lookback) / Lookback), 5)
    stddev_pos = pos_count != 0 ? math.round(math.sqrt((pos_returns_squared_sum - (pos_sum * pos_sum) / pos_count) / pos_count), 5) : na
    stddev_neg = neg_count != 0 ? math.round(math.sqrt((neg_returns_squared_sum - (neg_sum * neg_sum) / neg_count) / neg_count), 5) : na
    // Calculate probabilities
    prob_pos = math.round((pos_count / Lookback) * 100, 2)
    prob_neg = math.round((neg_count / Lookback) * 100, 2)
    prob_neu = math.round(((Lookback - pos_count - neg_count) / Lookback) * 100, 2)
    // Calculate ratios
    sharpe_ratio = math.round((mean_all / stddev_all) * math.sqrt(255), 2)
    sortino_ratio = math.round((mean_all / stddev_neg) * math.sqrt(255), 2)
    omega_ratio = math.round(pos_sum / math.abs(neg_sum), 2)
    // Set values in the array
    array.set(export_array, 0, mean_all)
    array.set(export_array, 1, mean_pos)
    array.set(export_array, 2, mean_neg)
    array.set(export_array, 3, stddev_all)
    array.set(export_array, 4, stddev_pos)
    array.set(export_array, 5, stddev_neg)
    array.set(export_array, 6, prob_pos)
    array.set(export_array, 7, prob_neu)
    array.set(export_array, 8, prob_neg)
    array.set(export_array, 9, sharpe_ratio)
    array.set(export_array, 10, sortino_ratio)
    array.set(export_array, 11, omega_ratio)
    // Export the array
    export_array

// @function: Plots a table comparing performance metrics of Buy and Hold and Strategy equity.
// @param buy_and_hold (float[]): Metrics from the PerformanceMetrics() function for Buy and Hold.
// @param strategy (float[]): Metrics from the PerformanceMetrics() function for the strategy.
// @returns: Table displaying the performance metrics comparison.
export PerfMetricTable(float[] buy_and_hold, float[] strategy) =>
    var table t = table.new(position.bottom_left, 3, 15, border_width = 1, frame_width = 1, frame_color = color.white)
    // Header
    table.cell(t, 0, 0, "Performance Metrics", text_color=color.white, bgcolor=color.gray)
    table.merge_cells(t, 0, 0, 2, 0)
    // Column headers
    table.cell(t, 1, 1, "Buy & Hold", text_color=color.white)
    table.cell(t, 2, 1, "Strategy", text_color=color.white)
    // Metrics labels
    
    for i = 0 to array.size(buy_and_hold) - 1

        metric = switch i
            0  => "Mean (All Returns) %"
            1  => "Mean (Positive Returns) %"
            2  => "Mean (Negative Returns) %"
            3  => "STDEV (All Returns) %"
            4  => "STDEV (Positive Returns) %"
            5  => "STDEV (Negative Returns) %"
            6  => "% Prob. (Positive Returns)"
            7  => "% Prob. (Neutral Returns)"
            8  => "% Prob. (Negative Returns)"
            9  => "Sharpe Ratio"
            10 => "Sortino Ratio"
            11 => "Omega Ratio"

        table.cell(t, 0, i + 2, metric, text_color=color.white)
        table.cell(t, 1, i + 2, str.tostring(array.get(buy_and_hold, i)), text_color=color.white)
        table.cell(t, 2, i + 2, str.tostring(array.get(strategy, i)), text_color=color.white)
    t

// @function: Calculates key trading performance metrics based on entry, exit, and trade size logic.
// @param startDate (simple float): Timestamp of the starting date for the equity calculation.
// @param initial_capital (simple float): The starting capital for trade calculations.
// @param trade_size (simple float): The proportion of capital allocated per trade.
// @param Long_entry_bool (series bool): Boolean condition indicating a long entry signal.
// @param Short_entry_bool (series bool): Boolean condition indicating a short entry signal.
// @param Long_exit_bool (series bool): Boolean condition indicating a long exit signal.
// @param Short_exit_bool (series bool): Boolean condition indicating a short exit signal.
// @returns (tuple): A tuple containing:
//          - signal (int): Current trade signal (-1 for short, 1 for long, 0 for neutral).
//          - closed_trades_count (int): Total number of closed trades.
//          - closed_long (int): Total number of closed long trades.
//          - closed_short (int): Total number of closed short trades.
//          - win_trades (int): Total number of winning trades.
//          - win_long (int): Total number of winning long trades.
//          - win_short (int): Total number of winning short trades.
//          - gross_profit (float): Total gross profit from all trades.
//          - gross_losses (float): Total gross losses from all trades.
//          - gross_L_profit (float): Gross profit from long trades.
//          - gross_L_losses (float): Gross losses from long trades.
//          - gross_S_profit (float): Gross profit from short trades.
//          - gross_S_losses (float): Gross losses from short trades.
export TradeMetrics(simple float startDate, simple float initial_capital, simple float trade_size, series bool Long_entry_bool, series bool Short_entry_bool, series bool Long_exit_bool, series bool Short_exit_bool) =>
    var signal = 0

    var closed_trades_count = 0 
    var closed_long         = 0
    var closed_short        = 0

    var win_trades          = 0
    var win_long            = 0
    var win_short           = 0

    var gross_profit        = 0.0 
    var gross_losses        = 0.0

    var gross_L_profit      = 0.0
    var gross_L_losses      = 0.0

    var gross_S_profit      = 0.0
    var gross_S_losses      = 0.0

    var entry_long          = 0.0
    var entry_short         = 0.0

    var capital             = initial_capital

    if time >= startDate

        if Long_entry_bool[1] and not (signal == 1)
            signal := 1

            if entry_short > 0.0
                if open < entry_short
                    win_trades += 1
                    win_short += 1

                    capital += (capital[1] * trade_size) * math.abs((open / entry_short) - 1)
                    gross_profit += math.abs(capital - capital[1])
                    gross_S_profit += math.abs(capital - capital[1])

                if open > entry_short
                    capital -= (capital[1] * trade_size) *  math.abs((open / entry_short) - 1)
                    gross_losses += math.abs(capital - capital[1])
                    gross_S_losses += math.abs(capital - capital[1])

                closed_short += 1
                entry_short := 0.0
                closed_trades_count += 1
            
            entry_short := 0.0
            entry_long := open


        if Short_entry_bool[1] and not (signal == -1)
            signal := -1

            if entry_long > 0.0
                if open > entry_long
                    win_trades += 1
                    win_long += 1

                    capital += (capital[1] * trade_size) * math.abs((open / entry_long) - 1)
                    gross_profit += math.abs(capital - capital[1])
                    gross_L_profit += math.abs(capital - capital[1])

                if open < entry_long
                    capital -= (capital[1] * trade_size) *  math.abs((open / entry_long) - 1)
                    gross_losses += math.abs(capital - capital[1])
                    gross_L_losses += math.abs(capital - capital[1])

                closed_long += 1
                entry_long := 0.0
                closed_trades_count += 1

            entry_long := 0.0
            entry_short := open

        if ((Long_exit_bool[1] and signal == 1) or (Short_exit_bool[1] and signal == -1)) and not (signal == 0)
            signal := 0

            if entry_long > 0.0
                if open > entry_long
                    win_trades += 1
                    win_long += 1

                    capital += (capital[1] * trade_size) * math.abs((open / entry_long) - 1)
                    gross_profit += math.abs(capital - capital[1])
                    gross_L_profit += math.abs(capital - capital[1])

                if open < entry_long
                    capital -= (capital[1] * trade_size) *  math.abs((open / entry_long) - 1)
                    gross_losses += math.abs(capital - capital[1])
                    gross_L_losses += math.abs(capital - capital[1])

                closed_long += 1
                entry_long := 0.0
                closed_trades_count += 1

            entry_long := 0.0

            if entry_short > 0.0
                if open < entry_short
                    win_trades += 1
                    win_short += 1

                    capital += (capital[1] * trade_size) * math.abs((open / entry_short) - 1)
                    gross_profit += math.abs(capital - capital[1])
                    gross_S_profit += math.abs(capital - capital[1])

                if open > entry_short
                    capital -= (capital[1] * trade_size) *  math.abs((open / entry_short) - 1)
                    gross_losses += math.abs(capital - capital[1])
                    gross_S_losses += math.abs(capital - capital[1])

                closed_short += 1
                entry_short := 0.0
                closed_trades_count += 1

            entry_short := 0.0

    // export
    [signal, closed_trades_count, closed_long, closed_short, win_trades, win_long, win_short, gross_profit, gross_losses, gross_L_profit, gross_L_losses, gross_S_profit, gross_S_losses]


f_get_col(x, base) =>
    x > base ? color.green : color.red

// @function: Generates a visual table displaying trade performance metrics for all trades, long trades, and short trades.
// @param initial_capital (simple float): The starting capital for trade calculations.
// @param closed_trades_count (series int): Total number of closed trades.
// @param closed_long (series int): Total number of closed long trades.
// @param closed_short (series int): Total number of closed short trades.
// @param win_trades (series int): Total number of winning trades.
// @param win_long (series int): Total number of winning long trades.
// @param win_short (series int): Total number of winning short trades.
// @param gross_profit (series float): Total gross profit from all trades.
// @param gross_losses (series float): Total gross losses from all trades.
// @param gross_L_profit (series float): Gross profit from long trades.
// @param gross_L_losses (series float): Gross losses from long trades.
// @param gross_S_profit (series float): Gross profit from short trades.
// @param gross_S_losses (series float): Gross losses from short trades.
// @returns (table): A table object displaying detailed trade metrics, including:
//          - Total trades, winning trades, and losing trades.
//          - Gross and net profit/loss in absolute and percentage terms.
//          - Profit factor, average trade metrics, and win/loss ratios.
//          - Metrics categorized by all trades, long trades, and short trades.
export TradeMetricsTable(simple float initial_capital, series int closed_trades_count, series int closed_long, series int closed_short, series int win_trades, series int win_long, series int win_short, 
 series float gross_profit, series float gross_losses, series float gross_L_profit, series float gross_L_losses, series float gross_S_profit, series float gross_S_losses) =>
    var table t = table.new(position.top_right, 10, 20, frame_color = color.white, frame_width = 2)

    // Table Header
    table.cell(t, 0, 0, "Trade Metrics", text_color = color.white, bgcolor = color.rgb(0, 0, 255)), table.merge_cells(t, 0, 0, 3, 0)

    table.cell(t, 0, 1, "Metric", text_color = color.white)
    table.cell(t, 1, 1, "All", text_color = color.white)
    table.cell(t, 2, 1, "Long", text_color = color.white)
    table.cell(t, 3, 1, "Short", text_color = color.white)

    table.cell(t, 0, 2, "Closed Trades", text_color = color.white)
    table.cell(t, 0, 3, "Winning Trades", text_color = color.white)
    table.cell(t, 0, 4, "Losing Trades", text_color = color.white)
    table.cell(t, 0, 5, "% Profitable", text_color = color.white)

    table.cell(t, 0, 6, "Gross Profit ($)", text_color = color.white)
    table.cell(t, 0, 7, "Gross Profit (%)", text_color = color.white)
    table.cell(t, 0, 8, "Gross Loss ($)", text_color = color.white)
    table.cell(t, 0, 9, "Gross Loss (%)", text_color = color.white)
    table.cell(t, 0, 10, "Net Profit ($)", text_color = color.white)
    table.cell(t, 0, 11, "Net Profit (%)", text_color = color.white)

    table.cell(t, 0, 12, "Profit Factor", text_color = color.white)

    table.cell(t, 0, 13, "Avg Trade ($)", text_color = color.white)
    table.cell(t, 0, 14, "Avg Winning Trade ($)", text_color = color.white)
    table.cell(t, 0, 15, "Avg Losing Trade ($)", text_color = color.white)
    table.cell(t, 0, 16, "Ratio Avg Win / Avg Loss", text_color = color.white)
    //

    // Table data 
    table.cell(t, 1, 2, text = str.tostring(closed_trades_count), text_color = color.white)
    table.cell(t, 2, 2, text = str.tostring(closed_long), text_color = color.white)
    table.cell(t, 3, 2, text = str.tostring(closed_short), text_color = color.white)

    table.cell(t, 1, 3, text = str.tostring(win_trades), text_color = color.white)
    table.cell(t, 2, 3, text = str.tostring(win_long), text_color = color.white)
    table.cell(t, 3, 3, text = str.tostring(win_short), text_color = color.white)

    table.cell(t, 1, 4, text = str.tostring(closed_trades_count - win_trades), text_color = color.white)
    table.cell(t, 2, 4, text = str.tostring(closed_long - win_long), text_color = color.white)
    table.cell(t, 3, 4, text = str.tostring(closed_short - win_short), text_color = color.white)

    table.cell(t, 1, 5, text = str.tostring(100 * win_trades / closed_trades_count, format.percent), text_color = color.white)
    table.cell(t, 2, 5, text = str.tostring(100 * win_long / closed_long, format.percent), text_color = color.white)
    table.cell(t, 3, 5, text = str.tostring(100 * win_short / closed_short, format.percent), text_color = color.white)

    table.cell(t, 1, 6, text = "$ " + str.tostring(math.round(gross_profit,2)), text_color = color.white)
    table.cell(t, 2, 6, text = "$ " + str.tostring(math.round(gross_L_profit,2)), text_color = color.white)
    table.cell(t, 3, 6, text = "$ " + str.tostring(math.round(gross_S_profit,2)), text_color = color.white)

    table.cell(t, 1, 7, text = str.tostring(math.round(100 * gross_profit / initial_capital,2), format.percent), text_color = color.white)
    table.cell(t, 2, 7, text = str.tostring(math.round(100 * gross_L_profit / initial_capital,2), format.percent), text_color = color.white)
    table.cell(t, 3, 7, text = str.tostring(math.round(100 * gross_S_profit / initial_capital,2), format.percent), text_color = color.white)

    table.cell(t, 1, 8, text = "$ " + str.tostring(math.round(gross_losses,2)), text_color = color.white)
    table.cell(t, 2, 8, text = "$ " + str.tostring(math.round(gross_L_losses,2)), text_color = color.white)
    table.cell(t, 3, 8, text = "$ " + str.tostring(math.round(gross_S_losses,2)), text_color = color.white)

    table.cell(t, 1, 9, text = str.tostring(math.round(100 * gross_losses / initial_capital,2), format.percent), text_color = color.white)
    table.cell(t, 2, 9, text = str.tostring(math.round(100 * gross_L_losses / initial_capital,2), format.percent), text_color = color.white)
    table.cell(t, 3, 9, text = str.tostring(math.round(100 * gross_S_losses / initial_capital,2), format.percent), text_color = color.white)

    table.cell(t, 1, 10, text = "$ " + str.tostring(math.round(gross_profit - gross_losses,2)), text_color = f_get_col(gross_profit - gross_losses, 0))
    table.cell(t, 2, 10, text = "$ " + str.tostring(math.round(gross_L_profit - gross_L_losses,2)), text_color = f_get_col(gross_L_profit - gross_L_losses, 0))
    table.cell(t, 3, 10, text = "$ " + str.tostring(math.round(gross_S_profit - gross_S_losses,2)), text_color = f_get_col(gross_S_profit - gross_S_losses, 0))

    table.cell(t, 1, 11, text = str.tostring(math.round(100 * (gross_profit - gross_losses) / initial_capital,2), format.percent), text_color = f_get_col(gross_profit - gross_losses, 0))
    table.cell(t, 2, 11, text = str.tostring(math.round(100 * (gross_L_profit - gross_L_losses) / initial_capital,2), format.percent), text_color = f_get_col(gross_L_profit - gross_L_losses, 0))
    table.cell(t, 3, 11, text = str.tostring(math.round(100 * (gross_S_profit - gross_S_losses) / initial_capital,2), format.percent), text_color = f_get_col(gross_S_profit - gross_S_losses, 0))

    table.cell(t, 1, 12, text = str.tostring(math.round(math.round(gross_profit / gross_losses, 4),3)), text_color = f_get_col(gross_profit / gross_losses, 1))
    table.cell(t, 2, 12, text = str.tostring(math.round(math.round(gross_L_profit / gross_L_losses, 4),3)), text_color = f_get_col(gross_L_profit / gross_L_losses, 1))
    table.cell(t, 3, 12, text = str.tostring(math.round(math.round(gross_S_profit / gross_S_losses, 4),3)), text_color = f_get_col(gross_S_profit / gross_S_losses, 1))

    table.cell(t, 1, 13, text = "$ " + str.tostring(math.round((gross_profit - gross_losses) / closed_trades_count,2)), text_color = f_get_col(gross_profit - gross_losses, 0))
    table.cell(t, 2, 13, text = "$ " + str.tostring(math.round((gross_L_profit - gross_L_losses) / closed_long,2)), text_color = f_get_col(gross_L_profit - gross_L_losses, 0))
    table.cell(t, 3, 13, text = "$ " + str.tostring(math.round((gross_S_profit - gross_S_losses) / closed_short,2)), text_color = f_get_col(gross_S_profit - gross_S_losses, 0))

    table.cell(t, 1, 14, text = "$ " + str.tostring(math.round(gross_profit / win_trades,2)), text_color = color.white)
    table.cell(t, 2, 14, text = "$ " + str.tostring(math.round(gross_L_profit / win_long,2)), text_color = color.white)
    table.cell(t, 3, 14, text = "$ " + str.tostring(math.round(gross_S_profit / win_short,2)), text_color = color.white)

    table.cell(t, 1, 15, text = "$ " + str.tostring(math.round(gross_losses / (closed_trades_count - win_trades),2)), text_color = color.white)
    table.cell(t, 2, 15, text = "$ " + str.tostring(math.round(gross_L_losses / (closed_long - win_long),2)), text_color = color.white)
    table.cell(t, 3, 15, text = "$ " + str.tostring(math.round(gross_S_losses / (closed_short - win_short),2)), text_color = color.white)

    table.cell(t, 1, 16, text = str.tostring(math.round((gross_profit / win_trades) / (gross_losses / (closed_trades_count - win_trades)),3)), text_color = color.white)
    table.cell(t, 2, 16, text = str.tostring(math.round((gross_L_profit / win_long) / (gross_L_losses / (closed_long - win_long)),3)), text_color = color.white)
    table.cell(t, 3, 16, text = str.tostring(math.round((gross_S_profit / win_short) / (gross_S_losses / (closed_short - win_short)),3)), text_color = color.white)

    t


//}