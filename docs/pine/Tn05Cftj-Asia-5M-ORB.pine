//@version=6
indicator("Asia 5M Range", overlay = true, max_lines_count = 10, max_labels_count = 10)

// Settings
sessionTimeZone = input.string("America/New_York", "Session Time Zone")
asiaOpenHour    = input.int(18, "Asia Open Hour", minval = 0, maxval = 23)
asiaOpenMinute  = input.int(0, "Asia Open Minute", minval = 0, maxval = 59)

highColor = input.color(color.lime, "High Color")
lowColor  = input.color(color.red, "Low Color")
lineWidth = input.int(2, "Line Width", minval = 1, maxval = 5)

// Require a 5-minute chart
isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5

if barstate.isfirst and not isFiveMinute
    runtime.error("Use this indicator on a 5-minute chart.")

// Find the opening Asia candle
isAsiaOpeningCandle =
     hour(time, sessionTimeZone) == asiaOpenHour and
     minute(time, sessionTimeZone) == asiaOpenMinute

// Current lines and price labels
var line highLine = na
var line lowLine = na
var label highLabel = na
var label lowLabel = na

// Create levels after the first candle closes
if isAsiaOpeningCandle and barstate.isconfirmed
    // Remove previous session's objects
    line.delete(highLine)
    line.delete(lowLine)
    label.delete(highLabel)
    label.delete(lowLabel)

    // Lines start at the opening candle and extend right
    highLine := line.new(
         x1 = bar_index,
         y1 = high,
         x2 = bar_index + 1,
         y2 = high,
         extend = extend.right,
         color = highColor,
         width = lineWidth
    )

    lowLine := line.new(
         x1 = bar_index,
         y1 = low,
         x2 = bar_index + 1,
         y2 = low,
         extend = extend.right,
         color = lowColor,
         width = lineWidth
    )

    // Labels show only the price
    highLabel := label.new(
         x = bar_index + 1,
         y = high,
         text = str.tostring(high, format.mintick),
         style = label.style_label_left,
         color = highColor,
         textcolor = color.black,
         size = size.small
    )

    lowLabel := label.new(
         x = bar_index + 1,
         y = low,
         text = str.tostring(low, format.mintick),
         style = label.style_label_left,
         color = lowColor,
         textcolor = color.white,
         size = size.small
    )

// Keep price labels at the right side of the chart
if not na(highLabel)
    label.set_x(highLabel, bar_index + 1)

if not na(lowLabel)
    label.set_x(lowLabel, bar_index + 1)