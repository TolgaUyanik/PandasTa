//@version=6
indicator(title="Dollar Volume %", timeframe="D", precision = 2, format=format.percent)

// This indicator takes the percentual difference between current dollar volume 
// and the last 10 day's average and the last 100 day's average.

fast = input.int(defval = 10, title = "Fast volume period")
slow = input.int(defval = 100, title = "Slow volume period")

// 1. Define Dollar Volume (Price x Share Volume)
dvol = volume * close

// 2. Calculate the Moving Averages of the Dollar Volume
smafast = ta.sma(dvol, fast)
smaslow = ta.sma(dvol, slow)

// 3. Calculate the Percentage Difference
dif_fast = (dvol / smafast) * 100
dif_slow = (dvol / smaslow) * 100

// 4. Plot Output
plot(dif_fast, color=color.blue, title="% SMA fast")
plot(dif_slow, color=color.green, title="% SMA slow")
plot(100, color=color.yellow)
plot(200, color=color.red)