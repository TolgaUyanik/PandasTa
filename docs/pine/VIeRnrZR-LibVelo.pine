export method getStdDev(
  Velo self,
  Metric target
  ) =>
    switch target
        Metric.volume   => self._vpVol.getStdDev()
        Metric.time     => self._vpTime.getStdDev()
        Metric.velocity => 
            self._assemble()
            self._vpVelo.getStdDev()

// @function Returns the skewness for the specified target distribution.
//           Calculates on-demand if the target is 'Velocity' and data changed.
// @param    self   Velo    The profile object.
// @param    target Metric  The data aspect to analyse (Volume, Time, Velocity).
