  ) =>
    switch target
        Metric.volume   => self._vpVol.getSkewness()
        Metric.time     => self._vpTime.getSkewness()
        Metric.velocity => 
            self._assemble()
            self._vpVelo.getSkewness()

// @function Returns the excess kurtosis for the specified target distribution.
//           Calculates on-demand if the target is 'Velocity' and data changed.
// @param    self   Velo    The profile object.
// @param    target Metric  The data aspect to analyse (Volume, Time, Velocity).
// @returns         series float  The excess kurtosis.
export method getKurtosis(
  Velo self,
  Metric target
  ) =>
    switch target
        Metric.volume   => self._vpVol.getKurtosis()
        Metric.time     => self._vpTime.getKurtosis()
        Metric.velocity => 
            self._assemble()
            self._vpVelo.getKurtosis()

// @function Returns the fundamental unimodal segments for the specified target metric.
//           Calculates on-demand if the target is 'Velocity' and data changed.
// @param    self   Velo    The profile object.
// @param    target Metric  The data aspect to analyse (Volume, Time, Velocity).
// @returns         matrix<int>   A 2-column matrix where each row is an [startIndex, endIndex] pair.
export method getSegments(
  Velo self,
  Metric target
  ) =>
    switch target
        Metric.volume   => self._vpVol.getSegments()
        Metric.time     => self._vpTime.getSegments()
        Metric.velocity => 
            self._assemble()
            self._vpVelo.getSegments()

// @function Returns Cumulative Volume Delta (CVD) information.
//           Note: Only available for Metric.volume.
// @param    self   Velo    The profile object.
// @param    target Metric  The data aspect to analyse (Volume, Time, Velocity).
// @returns [cvd, cvdHi, cvdLo]
//          cvd    series float  The final delta value.
//          cvdHi  series float  The historical high-water mark of the delta.
//          cvdLo  series float  The historical low-water mark of the delta.
export method getCvd(
  Velo self,
  Metric target
  ) =>
    if target != Metric.volume
        runtime.error("CVD is only available for Volume metric.")

    self._vpVol.getCvd()