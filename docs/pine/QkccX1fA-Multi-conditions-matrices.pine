//@version=5

//@description : facilitate including multiple AND / OR conditions to a script such as two entry / exit inputs groups.
library("multi_conditions_matrices")

//@function Helper to append conditions to a matrix<bool> condition array
//@param matrix<bool> a matrix containing boolean conditions
//@param conditionPair array<bool> A condition pair [enabled, condition], an input can be passed directly to enable
export method addConditions(matrix<bool> conditions, array<bool> conditionPair) =>
    conditions.add_row(matrix.rows(conditions), conditionPair)

//@function check several condition within given operator
//@param matrix<bool> a matrix containing boolean conditions pair such as [enabled, condition]
//@param operatorAnd bool true if the operator between condition is AND (default OR)
//@returns bool Evaluates conditions
export method check(matrix<bool> conditions, bool operatorAnd = false) => 

	bool exitAND = true
	bool exitOR = false

	int enabled = 0
	int condition = 1

	for conditionPair in conditions
		if conditionPair.get(enabled)
			exitAND := exitAND and conditionPair.get(condition)
			exitOR := exitOR or conditionPair.get(condition)

    (operatorAnd and exitAND) or (not operatorAnd and exitOR)

//@return bool If current day is weekend day
export isWeekend() =>
   dayofweek == dayofweek.saturday or dayofweek == dayofweek.sunday

//@return bool If current hour is night hour
export isNightSignal(int nightHour = 0, int morningHour = 6, string timezone = 'UTC') =>
    currentHour = str.tonumber(str.format_time(time, 'HH', timezone))
    currentHour >= nightHour and currentHour < morningHour

entryConditions = matrix.new<bool>()
exitConditions = matrix.new<bool>()

bool withANDEntryConditions = input(false, "Use AND conditions", group = "Entry conditions")

entryConditions.addConditions(array.from(
   input(true, "Fast EMA above slow EMA", group = "Entry conditions"),
   ta.ema(close, 5) > ta.ema(close, 30)))
entryConditions.addConditions(array.from(
   input(true, "Fast EMA rising 3 bars", group = "Entry conditions"),
   ta.rising(ta.ema(close, 30), 3)))
entryConditions.addConditions(array.from(
   input(false, "Ignore weekends", group = "Entry conditions"),
   not isWeekend()))

entryConditions.addConditions(array.from(
   input(false, "Ignore night signal", group = "Entry conditions"),
   not isNightSignal(0, 8, 'UTC+2')))

bool withANDExitConditions = input(false, "Use AND conditions", group = "Exit conditions")

exitConditions.addConditions(array.from(
   input(true, "Fast EMA above slow EMA", group = "Exit conditions"),
   ta.ema(close, 5) < ta.ema(close, 30)))
exitConditions.addConditions(array.from(
   input(true, "Fast EMA falling 3 bars", group = "Exit conditions"),
   ta.falling(ta.ema(close, 30), 3)))
exitConditions.addConditions(array.from(
   input(false, "Ignore weekends", group = "Exit conditions"),
   not isWeekend()))
exitConditions.addConditions(array.from(
   input(false, "Ignore signal", group = "Exit conditions"),
   not isNightSignal(0, 8, 'UTC+2')))

plot(ta.ema(close, 5))
plot(ta.ema(close, 30))

potentialEntry = entryConditions.check(withANDEntryConditions)
potentialExit = exitConditions.check(withANDExitConditions)

plotshape(potentialEntry, title = "Potential entry", location = location.abovebar, style = shape.circle, color = color.green)
plotshape(potentialExit, title = "Potential exit", location = location.abovebar, style = shape.circle, color = color.red)
