//@version=6
strategy(
     title                  = "Estrategia DPO",
     shorttitle             = "DPO MACD DI SMA",
     overlay                = true,
     pyramiding             = 0,
     initial_capital        = 10000,
     currency               = currency.USD,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 10,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.0,
     slippage               = 0,
     process_orders_on_close = false,
     calc_on_every_tick     = false,
     calc_on_order_fills    = true,
     max_labels_count       = 500
)

//====================================================================
// 01. PANEL GENERAL
//====================================================================

groupGeneral = "01. Configuración general"

recommendedAsset = input.string(
     defval = "Pares Forex principales",
     title  = "Activo recomendado",
     group  = groupGeneral
)

recommendedTf = input.string(
     defval = "1H / 60 minutos",
     title  = "Timeframe recomendado",
     group  = groupGeneral
)

enableStrategyOrders = input.bool(
     defval = true,
     title  = "Activar órdenes de estrategia para backtesting",
     group  = groupGeneral
)

enableLongs = input.bool(
     defval = true,
     title  = "Permitir señales de COMPRA / LONG",
     group  = groupGeneral
)

enableShorts = input.bool(
     defval = true,
     title  = "Permitir señales de VENTA / SHORT",
     group  = groupGeneral
)

allowReversal = input.bool(
     defval = true,
     title  = "Permitir giro directo de LONG a SHORT o de SHORT a LONG",
     group  = groupGeneral
)

showSignals = input.bool(
     defval = true,
     title  = "Mostrar señales en el gráfico",
     group  = groupGeneral
)

showMovingAverages = input.bool(
     defval = true,
     title  = "Mostrar SMA 3 y SMA 15",
     group  = groupGeneral
)

showTradeLevels = input.bool(
     defval = true,
     title  = "Mostrar niveles orientativos de SL / TP",
     group  = groupGeneral
)

showInfoPanel = input.bool(
     defval = true,
     title  = "Mostrar panel informativo superior derecho",
     group  = groupGeneral
)

//====================================================================
// 02. DPO
//====================================================================

groupDpo = "02. DPO - Detrended Price Oscillator"

priceSource = input.source(
     defval = close,
     title  = "Fuente de precio para DPO / MACD",
     group  = groupDpo
)

dpoLength = input.int(
     defval = 12,
     title  = "Periodo DPO",
     minval = 2,
     group  = groupDpo
)

dpoZeroLevel = input.float(
     defval = 0.0,
     title  = "Nivel cero del DPO",
     step   = 0.01,
     group  = groupDpo
)

// DPO operativo sin desplazamiento visual para evitar repainting.
// No se usa offset negativo ni datos futuros.
dpoBasis = ta.sma(priceSource, dpoLength)
dpoValue = priceSource - dpoBasis

dpoCrossUp   = ta.crossover(dpoValue, dpoZeroLevel)
dpoCrossDown = ta.crossunder(dpoValue, dpoZeroLevel)

//====================================================================
// 03. MACD
//====================================================================

groupMacd = "03. MACD"

macdFastLength = input.int(
     defval = 12,
     title  = "MACD rápido",
     minval = 1,
     group  = groupMacd
)

macdSlowLength = input.int(
     defval = 26,
     title  = "MACD lento",
     minval = 1,
     group  = groupMacd
)

macdSignalLength = input.int(
     defval = 9,
     title  = "MACD señal",
     minval = 1,
     group  = groupMacd
)

[macdLine, macdSignalLine, macdHistogram] = ta.macd(priceSource, macdFastLength, macdSlowLength, macdSignalLength)

macdBullish = macdLine > macdSignalLine
macdBearish = macdLine < macdSignalLine

//====================================================================
// 04. ADX / DI
//====================================================================

groupDmi = "04. ADX / DI"

dmiLength = input.int(
     defval = 14,
     title  = "Periodo DI",
     minval = 1,
     group  = groupDmi
)

adxSmoothing = input.int(
     defval = 14,
     title  = "Suavizado ADX",
     minval = 1,
     group  = groupDmi
)

diConfirmationMode = input.string(
     defval  = "Preferible: DI a favor o cruce reciente",
     title   = "Modo de confirmación DI",
     options = [
         "Obligatorio: DI a favor",
         "Preferible: DI a favor o cruce reciente",
         "Desactivado"
     ],
     group   = groupDmi
)

useAdxStrengthFilter = input.bool(
     defval = false,
     title  = "Usar filtro adicional de fuerza ADX",
     group  = groupDmi
)

minAdxValue = input.float(
     defval = 20.0,
     title  = "ADX mínimo",
     step   = 0.5,
     group  = groupDmi
)

[plusDI, minusDI, adxValue] = ta.dmi(dmiLength, adxSmoothing)

diCrossUp   = ta.crossover(plusDI, minusDI)
diCrossDown = ta.crossunder(plusDI, minusDI)

//====================================================================
// 05. MEDIAS MÓVILES
//====================================================================

groupMa = "05. Medias móviles"

fastMaLength = input.int(
     defval = 3,
     title  = "SMA rápida",
     minval = 1,
     group  = groupMa
)

slowMaLength = input.int(
     defval = 15,
     title  = "SMA lenta",
     minval = 1,
     group  = groupMa
)

confirmationWindowBars = input.int(
     defval = 3,
     title  = "Máximo de velas entre cruce DPO y cruce de medias",
     minval = 0,
     maxval = 20,
     group  = groupMa
)

closeOnOppositeMaCross = input.bool(
     defval = true,
     title  = "Cerrar operación por cruce contrario de medias",
     group  = groupMa
)

fastMa = ta.sma(close, fastMaLength)
slowMa = ta.sma(close, slowMaLength)

maCrossUp   = ta.crossover(fastMa, slowMa)
maCrossDown = ta.crossunder(fastMa, slowMa)

//====================================================================
// 06. FILTRO HORARIO
//====================================================================

groupSession = "06. Horario operativo"

useSessionFilter = input.bool(
     defval = false,
     title  = "Activar filtro horario",
     group  = groupSession
)

tradingSession = input.session(
     defval = "0000-2359:1234567",
     title  = "Horario permitido",
     group  = groupSession
)

sessionTimezone = input.string(
     defval = "Europe/Madrid",
     title  = "Zona horaria",
     group  = groupSession
)

isInSession = not useSessionFilter or not na(time(timeframe.period, tradingSession, sessionTimezone))

//====================================================================
// 07. GESTIÓN DE RIESGO
//====================================================================

groupRisk = "07. Gestión de riesgo"

pipMode = input.string(
     defval  = "Automático",
     title   = "Tamaño de pip",
     options = ["Automático", "Manual"],
     group   = groupRisk
)

manualPipSize = input.float(
     defval = 0.0001,
     title  = "Tamaño de pip manual",
     step   = 0.00001,
     group  = groupRisk
)

stopLossPips = input.float(
     defval = 10.0,
     title  = "Margen mínimo del Stop Loss en pips respecto a SMA lenta",
     minval = 0.0,
     step   = 0.5,
     group  = groupRisk
)

takeProfitMode = input.string(
     defval  = "Desactivado",
     title   = "Modo Take Profit",
     options = ["Desactivado", "Pips", "Ratio R:R"],
     group   = groupRisk
)

takeProfitPips = input.float(
     defval = 50.0,
     title  = "Take Profit en pips",
     minval = 0.0,
     step   = 1.0,
     group  = groupRisk
)

riskRewardRatio = input.float(
     defval = 2.0,
     title  = "Ratio beneficio/riesgo",
     minval = 0.1,
     step   = 0.1,
     group  = groupRisk
)

trailingMode = input.string(
     defval  = "Desactivado",
     title   = "Trailing Stop",
     options = ["Desactivado", "Pips", "ATR"],
     group   = groupRisk
)

trailingPips = input.float(
     defval = 25.0,
     title  = "Trailing Stop en pips",
     minval = 0.0,
     step   = 1.0,
     group  = groupRisk
)

atrLength = input.int(
     defval = 14,
     title  = "Periodo ATR para trailing",
     minval = 1,
     group  = groupRisk
)

atrMultiplier = input.float(
     defval = 2.0,
     title  = "Multiplicador ATR",
     minval = 0.1,
     step   = 0.1,
     group  = groupRisk
)

// Tamaño de pip automático:
// En Forex con cotización fraccionada suele ser 10 veces el tick mínimo.
// En otros activos se usa el tick mínimo.
pipValue = pipMode == "Automático" ? (syminfo.type == "forex" ? syminfo.mintick * 10.0 : syminfo.mintick) : manualPipSize

atrValue = ta.atr(atrLength)

trailingDistancePrice = trailingMode == "Pips" ? trailingPips * pipValue :
     trailingMode == "ATR" ? atrValue * atrMultiplier :
     na

trailingDistanceTicks = not na(trailingDistancePrice) and syminfo.mintick > 0.0 ? trailingDistancePrice / syminfo.mintick : na

//====================================================================
// 08. FUNCIONES AUXILIARES
//====================================================================

f_isRecent(_barsSinceValue, _window) =>
    not na(_barsSinceValue) and _barsSinceValue <= _window

f_yesNo(_condition) =>
    _condition ? "Sí" : "No"

//====================================================================
// 09. CONFIRMACIONES DE ENTRADA
//====================================================================

// Cruces recientes dentro de la ventana máxima configurada.
barsSinceDpoCrossUp   = ta.barssince(dpoCrossUp)
barsSinceDpoCrossDown = ta.barssince(dpoCrossDown)
barsSinceMaCrossUp    = ta.barssince(maCrossUp)
barsSinceMaCrossDown  = ta.barssince(maCrossDown)
barsSinceDiCrossUp    = ta.barssince(diCrossUp)
barsSinceDiCrossDown  = ta.barssince(diCrossDown)

dpoUpRecent   = f_isRecent(barsSinceDpoCrossUp, confirmationWindowBars)
dpoDownRecent = f_isRecent(barsSinceDpoCrossDown, confirmationWindowBars)
maUpRecent    = f_isRecent(barsSinceMaCrossUp, confirmationWindowBars)
maDownRecent  = f_isRecent(barsSinceMaCrossDown, confirmationWindowBars)
diUpRecent    = f_isRecent(barsSinceDiCrossUp, confirmationWindowBars)
diDownRecent  = f_isRecent(barsSinceDiCrossDown, confirmationWindowBars)

// Para evitar señales repetidas, se exige que en la vela actual se produzca
// al menos uno de los dos cruces principales: DPO o SMA.
bullishSynchronisedCross = dpoUpRecent and maUpRecent and (dpoCrossUp or maCrossUp)
bearishSynchronisedCross = dpoDownRecent and maDownRecent and (dpoCrossDown or maCrossDown)

bullishDiConfirm =
     diConfirmationMode == "Obligatorio: DI a favor" ? plusDI > minusDI :
     diConfirmationMode == "Preferible: DI a favor o cruce reciente" ? plusDI > minusDI or diUpRecent :
     true

bearishDiConfirm =
     diConfirmationMode == "Obligatorio: DI a favor" ? plusDI < minusDI :
     diConfirmationMode == "Preferible: DI a favor o cruce reciente" ? plusDI < minusDI or diDownRecent :
     true

adxStrengthConfirm = not useAdxStrengthFilter or adxValue >= minAdxValue

rawLongSignal =
     barstate.isconfirmed and
     isInSession and
     enableLongs and
     bullishSynchronisedCross and
     macdBullish and
     bullishDiConfirm and
     adxStrengthConfirm

rawShortSignal =
     barstate.isconfirmed and
     isInSession and
     enableShorts and
     bearishSynchronisedCross and
     macdBearish and
     bearishDiConfirm and
     adxStrengthConfirm

//====================================================================
// 10. ESTADO VIRTUAL DE SEÑALES
// Permite usar el script como "indicador con señales" aunque se desactiven
// las órdenes de estrategia.
//====================================================================

var int signalState = 0
//  1 = posición larga virtual
// -1 = posición corta virtual
//  0 = sin posición virtual

// Si el backtest cerró por SL/TP/Trailing, sincronizamos el estado virtual.
strategyFlatAfterTrade = enableStrategyOrders and strategy.position_size == 0 and strategy.position_size[1] != 0

if strategyFlatAfterTrade
    signalState := 0

canOpenLong  = allowReversal ? signalState <= 0 : signalState == 0
canOpenShort = allowReversal ? signalState >= 0 : signalState == 0

longSignal  = rawLongSignal and canOpenLong
shortSignal = rawShortSignal and canOpenShort

longCloseByMa  = barstate.isconfirmed and signalState == 1 and closeOnOppositeMaCross and maCrossDown and not shortSignal
shortCloseByMa = barstate.isconfirmed and signalState == -1 and closeOnOppositeMaCross and maCrossUp and not longSignal

//====================================================================
// 11. CÁLCULO DE SL / TP
//====================================================================

var float longStopPrice   = na
var float shortStopPrice  = na
var float longTakeProfit  = na
var float shortTakeProfit = na

if longSignal
    longStopCandidate = slowMa - stopLossPips * pipValue

    // Protección: si por cualquier anomalía la SMA lenta queda por encima
    // del precio de señal, se usa un SL mínimo bajo el cierre.
    longStopPrice := longStopCandidate < close ? longStopCandidate : close - stopLossPips * pipValue

    longRisk = math.max(close - longStopPrice, syminfo.mintick)

    longTakeProfit :=
         takeProfitMode == "Pips" ? close + takeProfitPips * pipValue :
         takeProfitMode == "Ratio R:R" ? close + longRisk * riskRewardRatio :
         na

if shortSignal
    shortStopCandidate = slowMa + stopLossPips * pipValue

    // Protección: si por cualquier anomalía la SMA lenta queda por debajo
    // del precio de señal, se usa un SL mínimo sobre el cierre.
    shortStopPrice := shortStopCandidate > close ? shortStopCandidate : close + stopLossPips * pipValue

    shortRisk = math.max(shortStopPrice - close, syminfo.mintick)

    shortTakeProfit :=
         takeProfitMode == "Pips" ? close - takeProfitPips * pipValue :
         takeProfitMode == "Ratio R:R" ? close - shortRisk * riskRewardRatio :
         na

//====================================================================
// 12. ÓRDENES DE ESTRATEGIA
//====================================================================

if enableStrategyOrders and longSignal
    strategy.entry(
         id            = "LONG",
         direction     = strategy.long,
         comment       = "COMPRA DPO/MACD/DI/SMA",
         alert_message = "COMPRA / LONG confirmada en {{ticker}} - TF {{interval}}"
    )

if enableStrategyOrders and shortSignal
    strategy.entry(
         id            = "SHORT",
         direction     = strategy.short,
         comment       = "VENTA DPO/MACD/DI/SMA",
         alert_message = "VENTA / SHORT confirmada en {{ticker}} - TF {{interval}}"
    )

// Brackets de SL / TP / Trailing.
// Los cierres por SL, TP o trailing deben alertarse desde las alertas de órdenes de estrategia.
if enableStrategyOrders and strategy.position_size > 0
    strategy.exit(
         id            = "SL/TP LONG",
         from_entry    = "LONG",
         stop          = longStopPrice,
         limit         = longTakeProfit,
         trail_points  = trailingMode != "Desactivado" ? trailingDistanceTicks : na,
         trail_offset  = trailingMode != "Desactivado" ? trailingDistanceTicks : na,
         comment       = "Salida LONG SL/TP/Trailing",
         alert_message = "CIERRE LONG por SL / TP / Trailing en {{ticker}} - TF {{interval}}"
    )

if enableStrategyOrders and strategy.position_size < 0
    strategy.exit(
         id            = "SL/TP SHORT",
         from_entry    = "SHORT",
         stop          = shortStopPrice,
         limit         = shortTakeProfit,
         trail_points  = trailingMode != "Desactivado" ? trailingDistanceTicks : na,
         trail_offset  = trailingMode != "Desactivado" ? trailingDistanceTicks : na,
         comment       = "Salida SHORT SL/TP/Trailing",
         alert_message = "CIERRE SHORT por SL / TP / Trailing en {{ticker}} - TF {{interval}}"
    )

if enableStrategyOrders and longCloseByMa
    strategy.close(
         id            = "LONG",
         comment       = "Cierre LONG por cruce bajista SMA",
         alert_message = "CIERRE LONG por cruce bajista de medias en {{ticker}} - TF {{interval}}"
    )

if enableStrategyOrders and shortCloseByMa
    strategy.close(
         id            = "SHORT",
         comment       = "Cierre SHORT por cruce alcista SMA",
         alert_message = "CIERRE SHORT por cruce alcista de medias en {{ticker}} - TF {{interval}}"
    )

// Actualización final del estado virtual.
if longSignal
    signalState := 1
else if shortSignal
    signalState := -1
else if longCloseByMa or shortCloseByMa
    signalState := 0

//====================================================================
// 13. CAMBIO DE TENDENCIA
//====================================================================

bullishTrend =
     fastMa > slowMa and
     dpoValue > dpoZeroLevel and
     macdBullish and
     plusDI > minusDI

bearishTrend =
     fastMa < slowMa and
     dpoValue < dpoZeroLevel and
     macdBearish and
     plusDI < minusDI

trendChangeUp   = bullishTrend and not bullishTrend[1]
trendChangeDown = bearishTrend and not bearishTrend[1]

//====================================================================
// 14. VISUALIZACIÓN
//====================================================================

plot(
     showMovingAverages ? fastMa : na,
     title     = "SMA rápida",
     color     = color.new(color.lime, 0),
     linewidth = 1
)

plot(
     showMovingAverages ? slowMa : na,
     title     = "SMA lenta",
     color     = color.new(color.orange, 0),
     linewidth = 2
)

plot(
     showTradeLevels and signalState == 1 ? longStopPrice : na,
     title     = "SL Long",
     color     = color.new(color.red, 0),
     linewidth = 1,
     style     = plot.style_linebr
)

plot(
     showTradeLevels and signalState == 1 ? longTakeProfit : na,
     title     = "TP Long",
     color     = color.new(color.green, 0),
     linewidth = 1,
     style     = plot.style_linebr
)

plot(
     showTradeLevels and signalState == -1 ? shortStopPrice : na,
     title     = "SL Short",
     color     = color.new(color.red, 0),
     linewidth = 1,
     style     = plot.style_linebr
)

plot(
     showTradeLevels and signalState == -1 ? shortTakeProfit : na,
     title     = "TP Short",
     color     = color.new(color.green, 0),
     linewidth = 1,
     style     = plot.style_linebr
)

// Valores técnicos ocultos del gráfico principal, visibles en ventana de datos.
plot(dpoValue, title = "DPO operativo no repaint", display = display.data_window)
plot(macdHistogram, title = "Histograma MACD", display = display.data_window)
plot(adxValue, title = "ADX", display = display.data_window)
plot(plusDI, title = "+DI", display = display.data_window)
plot(minusDI, title = "-DI", display = display.data_window)

plotshape(
     showSignals and longSignal,
     title     = "Señal COMPRA",
     text      = "COMPRA",
     style     = shape.labelup,
     location  = location.belowbar,
     color     = color.new(color.green, 0),
     textcolor = color.white,
     size      = size.tiny
)

plotshape(
     showSignals and shortSignal,
     title     = "Señal VENTA",
     text      = "VENTA",
     style     = shape.labeldown,
     location  = location.abovebar,
     color     = color.new(color.red, 0),
     textcolor = color.white,
     size      = size.tiny
)

plotshape(
     showSignals and longCloseByMa,
     title     = "Cierre LONG",
     text      = "C-LONG",
     style     = shape.xcross,
     location  = location.abovebar,
     color     = color.new(color.gray, 0),
     textcolor = color.gray,
     size      = size.tiny
)

plotshape(
     showSignals and shortCloseByMa,
     title     = "Cierre SHORT",
     text      = "C-SHORT",
     style     = shape.xcross,
     location  = location.belowbar,
     color     = color.new(color.gray, 0),
     textcolor = color.gray,
     size      = size.tiny
)

//====================================================================
// 15. PANEL INFORMATIVO
//====================================================================

var table infoPanel = table.new(position.top_right, 2, 8, border_width = 1)

if showInfoPanel and barstate.islast
    panelBg = bullishTrend ? color.new(color.green, 82) :
         bearishTrend ? color.new(color.red, 82) :
         color.new(color.gray, 85)

    trendText = bullishTrend ? "Alcista" : bearishTrend ? "Bajista" : "Neutral"

    table.cell(infoPanel, 0, 0, "Sistema", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.tiny)
    table.cell(infoPanel, 1, 0, "DPO+MACD+DI+SMA", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.tiny)

    table.cell(infoPanel, 0, 1, "Activo", bgcolor = panelBg, text_size = size.tiny)
    table.cell(infoPanel, 1, 1, recommendedAsset, bgcolor = panelBg, text_size = size.tiny)

    table.cell(infoPanel, 0, 2, "TF ideal", bgcolor = panelBg, text_size = size.tiny)
    table.cell(infoPanel, 1, 2, recommendedTf, bgcolor = panelBg, text_size = size.tiny)

    table.cell(infoPanel, 0, 3, "Tendencia", bgcolor = panelBg, text_size = size.tiny)
    table.cell(infoPanel, 1, 3, trendText, bgcolor = panelBg, text_size = size.tiny)

    table.cell(infoPanel, 0, 4, "Horario OK", bgcolor = panelBg, text_size = size.tiny)
    table.cell(infoPanel, 1, 4, f_yesNo(isInSession), bgcolor = panelBg, text_size = size.tiny)

    table.cell(infoPanel, 0, 5, "DPO", bgcolor = panelBg, text_size = size.tiny)
    table.cell(infoPanel, 1, 5, str.tostring(dpoValue, format.mintick), bgcolor = panelBg, text_size = size.tiny)

    table.cell(infoPanel, 0, 6, "ADX", bgcolor = panelBg, text_size = size.tiny)
    table.cell(infoPanel, 1, 6, str.tostring(adxValue, "#.##"), bgcolor = panelBg, text_size = size.tiny)

    table.cell(infoPanel, 0, 7, "Estado", bgcolor = panelBg, text_size = size.tiny)
    table.cell(infoPanel, 1, 7, signalState == 1 ? "LONG" : signalState == -1 ? "SHORT" : "Sin posición", bgcolor = panelBg, text_size = size.tiny)

//====================================================================
// 16. ALERTAS
//====================================================================

alertcondition(
     condition = longSignal,
     title     = "COMPRA / LONG",
     message   = "COMPRA / LONG confirmada en {{ticker}} - Timeframe {{interval}}"
)

alertcondition(
     condition = shortSignal,
     title     = "VENTA / SHORT",
     message   = "VENTA / SHORT confirmada en {{ticker}} - Timeframe {{interval}}"
)

alertcondition(
     condition = longCloseByMa,
     title     = "CIERRE LONG por cruce bajista SMA",
     message   = "CIERRE LONG por cruce bajista de SMA rápida bajo SMA lenta en {{ticker}} - Timeframe {{interval}}"
)

alertcondition(
     condition = shortCloseByMa,
     title     = "CIERRE SHORT por cruce alcista SMA",
     message   = "CIERRE SHORT por cruce alcista de SMA rápida sobre SMA lenta en {{ticker}} - Timeframe {{interval}}"
)

alertcondition(
     condition = trendChangeUp,
     title     = "Cambio de tendencia ALCISTA",
     message   = "Cambio de tendencia ALCISTA detectado en {{ticker}} - Timeframe {{interval}}"
)

alertcondition(
     condition = trendChangeDown,
     title     = "Cambio de tendencia BAJISTA",
     message   = "Cambio de tendencia BAJISTA detectado en {{ticker}} - Timeframe {{interval}}"
)