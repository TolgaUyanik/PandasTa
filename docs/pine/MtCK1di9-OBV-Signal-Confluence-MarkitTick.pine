//@version=6
indicator("OBV Signal Confluence [MarkitTick]", overlay=false, format=format.volume)
var string GRP_CORE = "⚙️ Core"
var string GRP_FILT = "🕯️ Filters"
var string GRP_TT = "📐 Trade"
var string GRP_VIS = "🎨 Vis"
var string _mt741a = "📊 Dash"
var string GRP_WH = "🔔 Alerts"
var string GRP_COL = "🌈 Colors"
srcInput = input.source(close, "Src", group=GRP_CORE)
maTypeInput = input.string("SMA", "MA Type", options=["SMA", "RMA", "WMA", "VWMA"], group=GRP_CORE)
maLenInput = input.int(21, "MA Len", minval=1, group=GRP_CORE)
divLenInput = input.int(5, "Div Piv", minval=2, group=GRP_CORE)
useHtfInput = input.bool(false, "HTF Confirm", group=GRP_FILT)
htfInput = input.timeframe("60", "HTF", group=GRP_FILT)
useAdxInput = input.bool(false, "ADX Filter", group=GRP_FILT)
adxLenInput = input.int(14, "ADX Len", minval=1, group=GRP_FILT)
adxMinInput = input.float(20.0, "ADX Min", minval=0.0, maxval=100.0, group=GRP_FILT)
useVolInput = input.bool(false, "Vol Filter", group=GRP_FILT)
volMultInput = input.float(1.0, "Vol Mult", minval=0.1, group=GRP_FILT)
showLevelsInput = input.bool(true, "Trade Levels", group=GRP_TT)
atrLenInput = input.int(14, "ATR Len", minval=1, group=GRP_TT)
slMultInput = input.float(1.5, "SL ATRx", minval=0.1, group=GRP_TT)
tp1RrInput = input.float(1.0, "TP1 RR", minval=0.1, group=GRP_TT)
tp2RrInput = input.float(2.0, "TP2 RR", minval=0.1, group=GRP_TT)
tp3RrInput = input.float(3.0, "TP3 RR", minval=0.1, group=GRP_TT)
showHistInput = input.bool(true, "Hist", group=GRP_VIS)
showZeroInput = input.bool(true, "Zero Ln", group=GRP_VIS)
showDivInput = input.bool(true, "Div Sig", group=GRP_VIS)
showHidDivInput = input.bool(true, "Hid Div Sig", group=GRP_VIS)
showCandlesInput = input.bool(true, "Heat Candles", group=GRP_VIS, tooltip="Disable native chart candles in Chart Settings>Symbol for a clean view")
showDashInput = input.bool(true, "Show Dash", group=_mt741a)
dashPosInput = input.string("Top Right", "Pos", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=_mt741a)
i_actionLong = input.string("long", "↑ Long", group=GRP_WH)
i_actionShort = input.string("short", "↓ Short", group=GRP_WH)
i_actionCloseLong = input.string("closelong", "✕ ClsLong", group=GRP_WH)
i_actionCloseShort = input.string("closeshort", "✕ ClsShort", group=GRP_WH)
i_actionTp1 = input.string("tp1", "◆ TP1", group=GRP_WH)
i_actionTp2 = input.string("tp2", "✦ TP2", group=GRP_WH)
i_actionTp3 = input.string("tp3", "◆ TP3", group=GRP_WH)
histUpColorInput = input.color(color.new(#26a69a, 40), "Hist+", group=GRP_COL)
histUpWeakColorInput = input.color(color.new(#26a69a, 75), "Hist+W", group=GRP_COL)
histDnWeakColorInput = input.color(color.new(#ef5350, 75), "Hist-W", group=GRP_COL)
histDnColorInput = input.color(color.new(#ef5350, 40), "Hist-", group=GRP_COL)
zeroColorInput = input.color(color.new(#787b86, 50), "Zero", group=GRP_COL)
bullDivColorInput = input.color(#26a69a, "BullDiv", group=GRP_COL)
bearDivColorInput = input.color(#ef5350, "BearDiv", group=GRP_COL)
slColorInput = input.color(#ef5350, "SL", group=GRP_COL)
entryColorInput = input.color(#2196f3, "Entry", group=GRP_COL)
tp1ColorInput = input.color(color.new(#26a69a, 40), "TP1", group=GRP_COL)
tp2ColorInput = input.color(color.new(#26a69a, 20), "TP2", group=GRP_COL)
tp3ColorInput = input.color(color.new(#26a69a, 0), "TP3", group=GRP_COL)
labelTxtColorInput = input.color(color.white, "LblTxt", group=GRP_COL)
riskFillColorInput = input.color(color.new(#ef5350, 80), "RiskFill", group=GRP_COL)
rewardFillColorInput = input.color(color.new(#26a69a, 85), "RewardFill", group=GRP_COL)
cDashHdrInput = input.color(color.new(#3a2a6d, 55), "DashHdr", group=GRP_COL)
_mt741c = input.color(color.new(#0a0f1a, 10), "DashBg", group=GRP_COL)
cDashTxtInput = input.color(color.new(#ffffff, 0), "DashTxt", group=GRP_COL)
cBullInput = input.color(#26a69a, "Bull", group=GRP_COL)
cBearInput = input.color(#ef5350, "Bear", group=GRP_COL)
f_ma(float src, string t, int len) =>
    float _sma = ta.sma(src, len)
    float _rma = ta.rma(src, len)
    float _wma = ta.wma(src, len)
    float _vwma = ta.vwma(src, len)
    switch t
        "SMA" => _sma
        "RMA" => _rma
        "WMA" => _wma
        "VWMA" => _vwma
        => _sma
f_pivotHigh(series float src, simple int len) =>
    float candidate = src[len + 1]
    bool isValid = true
    for i = 1 to len * 2 + 1
        if i != len + 1 and src[i] >= candidate
            isValid := false
    isValid ? candidate : na
f_pivotLow(series float src, simple int len) =>
    float candidate = src[len + 1]
    bool isValid = true
    for i = 1 to len * 2 + 1
        if i != len + 1 and src[i] <= candidate
            isValid := false
    isValid ? candidate : na
f_htfBull() =>
    _obv = ta.cum(math.sign(ta.change(close)) * volume)
    _ma = f_ma(_obv, maTypeInput, maLenInput)
    _obv > _ma
var line slLine = na
var line entryLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line divBearLine = na
var line divBullLine = na
var line divHidBearLine = na
var line divHidBullLine = na
var label slLbl = na
var label entryLbl = na
var label tp1Lbl = na
var label tp2Lbl = na
var label tp3Lbl = na
var linefill riskFill = na
var linefill rewardFill = na
f_deleteLevels() =>
    line.delete(slLine), line.delete(entryLine)
    line.delete(tp1Line), line.delete(tp2Line), line.delete(tp3Line)
    label.delete(slLbl), label.delete(entryLbl)
    label.delete(tp1Lbl), label.delete(tp2Lbl), label.delete(tp3Lbl)
    linefill.delete(riskFill), linefill.delete(rewardFill)
f_bar(float val, float maxVal, color clr) =>
    int filled = math.round(math.min(val / maxVal, 1.0) * 10)
    string bar = ""
    for i = 1 to 10
        bar := bar + (i <= filled ? "█" : "░")
    bar + "  " + str.tostring(math.round(val / maxVal * 100)) + "%"
f_barColor(float pct) =>
    pct >= 0.66 ? color.new(#26a69a, 0) : pct >= 0.33 ? color.new(#f9a825, 0) : color.new(#ef5350, 0)
f_dashPos(string p) =>
    switch p
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right
obv = ta.cum(math.sign(ta.change(srcInput)) * volume)
obvMa = f_ma(obv, maTypeInput, maLenInput)
obvHist = obv - obvMa
[diPlus, diMinus, adxVal] = ta.dmi(adxLenInput, adxLenInput)
atrVal = ta.atr(atrLenInput)
volAvg = ta.sma(volume, 20)
volRatio = volAvg > 0 ? volume / volAvg : 0.0
htfTrendBull = request.security(syminfo.tickerid, htfInput, f_htfBull()[1], lookahead=barmerge.lookahead_on)
htfOkLong = not useHtfInput or htfTrendBull
htfOkShort = not useHtfInput or not htfTrendBull
adxOk = not useAdxInput or adxVal >= adxMinInput
volOk = not useVolInput or volume >= volAvg * volMultInput
phPrice = f_pivotHigh(high, divLenInput)
plPrice = f_pivotLow(low, divLenInput)
obvAtDivLen = obvHist[divLenInput + 1]
_mt741b = obvAtDivLen
plObvVal = obvAtDivLen
var float lastPh = na
var float lastPhObv = na
var float prevPh = na
var float prevPhObv = na
var int lastPhBar = na
var int prevPhBar = na
bool newPh = not na(phPrice)
if newPh
    prevPh := lastPh
    prevPhObv := lastPhObv
    prevPhBar := lastPhBar
    lastPh := phPrice
    lastPhObv := _mt741b
    lastPhBar := bar_index - divLenInput - 1
bearDiv = newPh and not na(prevPh) and lastPh > prevPh and lastPhObv < prevPhObv
hiddenBearDiv = newPh and not na(prevPh) and lastPh < prevPh and lastPhObv > prevPhObv
var float lastPl = na
var float lastPlObv = na
var float prevPl = na
var float prevPlObv = na
var int lastPlBar = na
var int prevPlBar = na
bool newPl = not na(plPrice)
if newPl
    prevPl := lastPl
    prevPlObv := lastPlObv
    prevPlBar := lastPlBar
    lastPl := plPrice
    lastPlObv := plObvVal
    lastPlBar := bar_index - divLenInput - 1
bullDiv = newPl and not na(prevPl) and lastPl < prevPl and lastPlObv > prevPlObv
hiddenBullDiv = newPl and not na(prevPl) and lastPl > prevPl and lastPlObv < prevPlObv
var string lastDivState = "None"
if bullDiv
    lastDivState := "Bullish"
if bearDiv
    lastDivState := "Bearish"
if bearDiv and not na(prevPhBar) and showDivInput
    line.delete(divBearLine)
    divBearLine := line.new(prevPhBar, prevPh, lastPhBar, lastPh, color=bearDivColorInput, style=line.style_dashed, width=1, force_overlay=true)
if bullDiv and not na(prevPlBar) and showDivInput
    line.delete(divBullLine)
    divBullLine := line.new(prevPlBar, prevPl, lastPlBar, lastPl, color=bullDivColorInput, style=line.style_dashed, width=1, force_overlay=true)
if hiddenBearDiv and not na(prevPhBar) and showHidDivInput
    line.delete(divHidBearLine)
    divHidBearLine := line.new(prevPhBar, prevPh, lastPhBar, lastPh, color=bearDivColorInput, style=line.style_dashed, width=1, force_overlay=true)
if hiddenBullDiv and not na(prevPlBar) and showHidDivInput
    line.delete(divHidBullLine)
    divHidBullLine := line.new(prevPlBar, prevPl, lastPlBar, lastPl, color=bullDivColorInput, style=line.style_dashed, width=1, force_overlay=true)
crossBull = ta.crossover(obv, obvMa)
crossBear = ta.crossunder(obv, obvMa)
longSignal = crossBull and htfOkLong and adxOk and volOk
shortSignal = crossBear and htfOkShort and adxOk and volOk
entryLongCalc = close[1]
slLongCalc = entryLongCalc - atrVal * slMultInput
riskLongCalc = entryLongCalc - slLongCalc
tp1LongCalc = entryLongCalc + riskLongCalc * tp1RrInput
tp2LongCalc = entryLongCalc + riskLongCalc * tp2RrInput
tp3LongCalc = entryLongCalc + riskLongCalc * tp3RrInput
entryShortCalc = close[1]
slShortCalc = entryShortCalc + atrVal * slMultInput
riskShortCalc = slShortCalc - entryShortCalc
tp1ShortCalc = entryShortCalc - riskShortCalc * tp1RrInput
tp2ShortCalc = entryShortCalc - riskShortCalc * tp2RrInput
tp3ShortCalc = entryShortCalc - riskShortCalc * tp3RrInput
var bool longActive = false
var bool shortActive = false
var float activeEntry = na
var float activeSL = na
var float activeTP1 = na
var float activeTP2 = na
var float activeTP3 = na
var bool tp1Done = false
var bool tp2Done = false
var bool tp3Done = false
var int lastSignalBar = na
if longSignal and barstate.isconfirmed
    longActive := true
    shortActive := false
    activeEntry := entryLongCalc
    activeSL := slLongCalc
    activeTP1 := tp1LongCalc
    activeTP2 := tp2LongCalc
    activeTP3 := tp3LongCalc
    tp1Done := false
    tp2Done := false
    tp3Done := false
    lastSignalBar := bar_index
if shortSignal and barstate.isconfirmed
    longActive := false
    shortActive := true
    activeEntry := entryShortCalc
    activeSL := slShortCalc
    activeTP1 := tp1ShortCalc
    activeTP2 := tp2ShortCalc
    activeTP3 := tp3ShortCalc
    tp1Done := false
    tp2Done := false
    tp3Done := false
    lastSignalBar := bar_index
if showLevelsInput and (longSignal or shortSignal) and barstate.isconfirmed
    f_deleteLevels()
    slLine := line.new(bar_index, activeSL, bar_index, activeSL, color=slColorInput, style=line.style_solid, width=2, force_overlay=true)
    entryLine := line.new(bar_index, activeEntry, bar_index, activeEntry, color=entryColorInput, style=line.style_dashed, width=1, force_overlay=true)
    tp1Line := line.new(bar_index, activeTP1, bar_index, activeTP1, color=tp1ColorInput, style=line.style_dashed, width=1, force_overlay=true)
    tp2Line := line.new(bar_index, activeTP2, bar_index, activeTP2, color=tp2ColorInput, style=line.style_dashed, width=1, force_overlay=true)
    tp3Line := line.new(bar_index, activeTP3, bar_index, activeTP3, color=tp3ColorInput, style=line.style_dashed, width=1, force_overlay=true)
    slLbl := label.new(bar_index, activeSL, "✕ SL " + str.tostring(activeSL, format.mintick), style=label.style_label_left, color=slColorInput, textcolor=labelTxtColorInput, size=size.small, force_overlay=true)
    entryLbl := label.new(bar_index, activeEntry, "▶ Entry " + str.tostring(activeEntry, format.mintick), style=label.style_label_left, color=entryColorInput, textcolor=labelTxtColorInput, size=size.small, force_overlay=true)
    tp1Lbl := label.new(bar_index, activeTP1, "◆ TP1 " + str.tostring(activeTP1, format.mintick), style=label.style_label_left, color=tp1ColorInput, textcolor=labelTxtColorInput, size=size.small, force_overlay=true)
    tp2Lbl := label.new(bar_index, activeTP2, "✦ TP2 " + str.tostring(activeTP2, format.mintick), style=label.style_label_left, color=tp2ColorInput, textcolor=labelTxtColorInput, size=size.small, force_overlay=true)
    tp3Lbl := label.new(bar_index, activeTP3, "◆ TP3 " + str.tostring(activeTP3, format.mintick), style=label.style_label_left, color=tp3ColorInput, textcolor=labelTxtColorInput, size=size.small, force_overlay=true)
    riskFill := linefill.new(slLine, entryLine, riskFillColorInput)
    rewardFill := linefill.new(entryLine, tp3Line, rewardFillColorInput)
tp1Hit = (longActive and high >= activeTP1 or shortActive and low <= activeTP1) and not tp1Done
tp2Hit = (longActive and high >= activeTP2 or shortActive and low <= activeTP2) and not tp2Done
tp3Hit = (longActive and high >= activeTP3 or shortActive and low <= activeTP3) and not tp3Done
if tp1Hit
    tp1Done := true
if tp2Hit
    tp2Done := true
if tp3Hit
    tp3Done := true
if not na(slLine) and not na(lastSignalBar) and bar_index <= lastSignalBar + 50
    int extX = lastSignalBar + 50
    line.set_x2(slLine, extX)
    line.set_x2(entryLine, extX)
    line.set_x2(tp1Line, extX)
    line.set_x2(tp2Line, extX)
    line.set_x2(tp3Line, extX)
    label.set_x(slLbl, extX)
    label.set_x(entryLbl, extX)
    label.set_x(tp1Lbl, extX)
    label.set_x(tp2Lbl, extX)
    label.set_x(tp3Lbl, extX)
histColor = obvHist >= 0 ? (obvHist > obvHist[1] ? histUpColorInput : histUpWeakColorInput) : (obvHist > obvHist[1] ? histDnWeakColorInput : histDnColorInput)
plot(showHistInput ? obvHist : na, title="Hist", color=histColor, style=plot.style_columns)
plotcandle(open, high, low, close, title="Heat Candles", color=showCandlesInput ? histColor : na, wickcolor=showCandlesInput ? histColor : na, bordercolor=showCandlesInput ? histColor : na, force_overlay=true)
hline(0, "Zero", color=zeroColorInput, linestyle=hline.style_dashed, display=showZeroInput ? display.all : display.none)
plotshape(showDivInput and bearDiv, title="BearDiv", style=shape.triangledown, location=location.top, color=bearDivColorInput, size=size.tiny)
plotshape(showDivInput and bullDiv, title="BullDiv", style=shape.triangleup, location=location.bottom, color=bullDivColorInput, size=size.tiny)
plotshape(showDivInput and bearDiv, title="BearDivChart", style=shape.arrowdown, location=location.abovebar, color=bearDivColorInput, size=size.small, force_overlay=true)
plotshape(showDivInput and bullDiv, title="BullDivChart", style=shape.arrowup, location=location.belowbar, color=bullDivColorInput, size=size.small, force_overlay=true)
plotshape(showHidDivInput and hiddenBearDiv, title="HidBearDiv", style=shape.diamond, location=location.top, color=bearDivColorInput, size=size.tiny)
plotshape(showHidDivInput and hiddenBullDiv, title="HidBullDiv", style=shape.diamond, location=location.bottom, color=bullDivColorInput, size=size.tiny)
plotshape(showHidDivInput and hiddenBearDiv, title="HidBearDivChart", style=shape.diamond, location=location.abovebar, color=bearDivColorInput, size=size.tiny, force_overlay=true)
plotshape(showHidDivInput and hiddenBullDiv, title="HidBullDivChart", style=shape.diamond, location=location.belowbar, color=bullDivColorInput, size=size.tiny, force_overlay=true)
var table dashTable = na
rowA = _mt741c
rowB = color.new(_mt741c, 40)
trendState = obv > obvMa ? "Bull" : obv < obvMa ? "Bear" : "Neutral"
trendColor = obv > obvMa ? cBullInput : obv < obvMa ? cBearInput : cDashTxtInput
divColor = lastDivState == "Bullish" ? cBullInput : lastDivState == "Bearish" ? cBearInput : cDashTxtInput
adxPct = math.min(adxVal / 50.0, 1.0)
volPct = math.min(volRatio / 3.0, 1.0)
rrProgress = longActive and not na(activeEntry) and (activeEntry - activeSL) != 0 ? (close - activeEntry) / (activeEntry - activeSL) : shortActive and not na(activeEntry) and (activeSL - activeEntry) != 0 ? (activeEntry - close) / (activeSL - activeEntry) : 0.0
rrClipped = math.max(rrProgress, 0.0)
rrPct = math.min(rrClipped / 5.0, 1.0)
dirState = longActive ? "Long" : shortActive ? "Short" : "Flat"
dirColor = longActive ? cBullInput : shortActive ? cBearInput : cDashTxtInput
entryText = not na(activeEntry) ? str.tostring(activeEntry, format.mintick) : "—"
slText = not na(activeSL) ? str.tostring(activeSL, format.mintick) : "—"
lblCol = color.new(cDashTxtInput, 25)
if showDashInput
    adxBarColor = f_barColor(adxPct)
    volBarColor = f_barColor(volPct)
    rrBarColor = f_barColor(rrPct)
    if na(dashTable)
        dashTable := table.new(f_dashPos(dashPosInput), 2, 11, border_width=1, border_color=color.new(#2a3040, 40), frame_width=1, frame_color=color.new(#3a2a6d, 40))
    table.cell(dashTable, 0, 0, "OBV Conf [MT]", text_color=cDashTxtInput, text_halign=text.align_left, bgcolor=cDashHdrInput, text_size=size.small)
    table.cell(dashTable, 1, 0, syminfo.ticker + "  ·  " + timeframe.period, text_color=cDashTxtInput, text_halign=text.align_right, bgcolor=cDashHdrInput, text_size=size.small)
    table.cell(dashTable, 0, 1, "  Trend", text_color=lblCol, text_halign=text.align_left, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 1, 1, trendState + "  ", text_color=trendColor, text_halign=text.align_right, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 0, 2, "  OBV", text_color=lblCol, text_halign=text.align_left, bgcolor=rowB, text_size=size.small)
    table.cell(dashTable, 1, 2, str.tostring(obv, "#") + "  ", text_color=cDashTxtInput, text_halign=text.align_right, bgcolor=rowB, text_size=size.small)
    table.cell(dashTable, 0, 3, "  Signal MA", text_color=lblCol, text_halign=text.align_left, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 1, 3, str.tostring(obvMa, "#") + "  ", text_color=cDashTxtInput, text_halign=text.align_right, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 0, 4, "  Divergence", text_color=lblCol, text_halign=text.align_left, bgcolor=rowB, text_size=size.small)
    table.cell(dashTable, 1, 4, lastDivState + "  ", text_color=divColor, text_halign=text.align_right, bgcolor=rowB, text_size=size.small)
    table.cell(dashTable, 0, 5, "  ADX Str", text_color=lblCol, text_halign=text.align_left, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 1, 5, f_bar(adxVal, 50.0, adxBarColor) + "  ", text_color=adxBarColor, text_halign=text.align_right, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 0, 6, "  Vol Ratio", text_color=lblCol, text_halign=text.align_left, bgcolor=rowB, text_size=size.small)
    table.cell(dashTable, 1, 6, f_bar(volRatio, 3.0, volBarColor) + "  ", text_color=volBarColor, text_halign=text.align_right, bgcolor=rowB, text_size=size.small)
    table.cell(dashTable, 0, 7, "  Direction", text_color=lblCol, text_halign=text.align_left, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 1, 7, dirState + "  ", text_color=dirColor, text_halign=text.align_right, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 0, 8, "  Entry", text_color=lblCol, text_halign=text.align_left, bgcolor=rowB, text_size=size.small)
    table.cell(dashTable, 1, 8, entryText + "  ", text_color=cDashTxtInput, text_halign=text.align_right, bgcolor=rowB, text_size=size.small)
    table.cell(dashTable, 0, 9, "  Stop Loss", text_color=lblCol, text_halign=text.align_left, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 1, 9, slText + "  ", text_color=cBearInput, text_halign=text.align_right, bgcolor=rowA, text_size=size.small)
    table.cell(dashTable, 0, 10, "  R:R Prog", text_color=lblCol, text_halign=text.align_left, bgcolor=rowB, text_size=size.small)
    table.cell(dashTable, 1, 10, f_bar(rrClipped, 5.0, rrBarColor) + "  ", text_color=rrBarColor, text_halign=text.align_right, bgcolor=rowB, text_size=size.small)
else
    if not na(dashTable)
        table.delete(dashTable)
        dashTable := na
string _longInner = str.format('"action":"{0}","ticker":"{1}","tf":"{2}","direction":"long","entry":"{3}","sl":"{4}","tp1":"{5}","tp2":"{6}","tp3":"{7}","obv":"{8}","adx":"{9}"', i_actionLong, syminfo.tickerid, timeframe.period, str.tostring(entryLongCalc, format.mintick), str.tostring(slLongCalc, format.mintick), str.tostring(tp1LongCalc, format.mintick), str.tostring(tp2LongCalc, format.mintick), str.tostring(tp3LongCalc, format.mintick), str.tostring(obv, "#"), str.tostring(adxVal, format.mintick))
string longPayload = "{" + _longInner + "}"
