//@version=5

// @description: When you need more space for your data you can use bitwise operations. For example if you are creating an Order Block indicator and you have multiple types then you can define variables for each type with only one bit set like these:
//
// const int TYPE_OB = 1
// const int TYPE_HH = 2
// const int TYPE_LH = 4
// const int TYPE_HL = 8
// const int TYPE_LL = 16
// const int TYPE_BOS = 32
// const int TYPE_CHOCH = 64
library("LibraryBitwiseOperands")

// @function bitwise_shift_left(): Bitwise left shift: x << y
// @param int x: operand to be shifted
// @param int y: how much the bits will be shifted
// @returns: The left operand’s value is moved toward left by the number of bits specified by the right operand.
export bitwise_shift_left(int x, int y) =>
    x * int(math.pow(2, y))

// @function bitwise_shift_right(): Bitwise right shift: x >> y
// @param int x: operand to be shifted
// @param int y: how much the bits will be shifted
// @returns: The left operand’s value is moved toward right by the number of bits specified by the right operand.
export bitwise_shift_right(int x, int y) =>
    x / int(math.pow(2, y))

// @function bitwise_not(): Bitwise NOT: ~x
// @param int x: operand to be inverted
// @returns: Inverts individual bits.
export bitwise_not(int x) =>
	a = x
    result = 0
    power_of_2 = 1
    while 0 < x
        if 0 == x % 2
            result += power_of_2
        a /= 2
        power_of_2 *= 2
    result

// @function bitwise_and(): Bitwise AND: x & y
// @param int x: operand one
// @param int y: operand two
// @returns: Result bit 1, if both operand bits are 1; otherwise results bit 0.
export bitwise_and(int x, int y) =>
	a = x
	b = y
    result = 0
    power_of_2 = 1
    while a > 0 and b > 0
        if 1 == a % 2 and 1 == b % 2
            result += power_of_2
        a /= 2
        b /= 2
        power_of_2 *= 2
    result

// @function bitwise_or(): Bitwise OR: x | y
// @param int x: operand one
// @param int y: operand two
// @returns: Result bit 1, if any of the operand bit is 1; otherwise results bit 0.
export bitwise_or(int x, int y) =>
	a = x
	b = y
    result = 0
    power_of_2 = 1
    while a > 0 and b > 0
        if 1 == a % 2 or 1 == b % 2
            result += power_of_2
        a /= 2
        b /= 2
        power_of_2 *= 2
    result

// @function bitwise_xor(): Bitwise (exclusive OR) XOR: x ^ y
// @param int x: operand one
// @param int y: operand two
// @returns: Result bit 1, if any of the operand bit is 1 but not both, otherwise results bit 0.
export bitwise_xor(int x, int y) =>
	a = x
	b = y
    result = 0
    power_of_2 = 1
    while a > 0 or b > 0
        bit_a = a % 2
        bit_b = b % 2
        // Compute XOR for the current bit position
        result_bit = (bit_a + bit_b) % 2
        result += result_bit * power_of_2
        a /= 2
        b /= 2
        power_of_2 *= 2
    result

// @function logical_xor(): Logical (exclusive OR) XOR: x xor y
// @param int x: operand one
// @param int y: operand two
// @returns: Result true, if any of the operand bit are different, otherwise results bit 0.
export logical_xor(bool x, bool y) =>
    (x and not y) or (not x and y)

// @function bit_check(): Bitwise Checks the specified bit
// @param int x: target variable
// @param int y: bit number to check
// @returns: Returns True if the bit is set.
export bit_check(int x, int y) =>
    bool(bitwise_and(x, bitwise_shift_left(1, y)))

// @function bit_set(): Bitwise Sets the specified bit
// @param int x: target variable
// @param int y: bit number to set
// @returns: Returns a value with the bit set.
export bit_set(int x, int y) =>
    bitwise_or(x, bitwise_shift_left(1, y))

// @function bit_clear(): Bitwise Clears the specified bit
// @param int x: target variable
// @param int y: bit number to clear
// @returns: Returns a value with the bit cleared.
export bit_clear(int x, int y) =>
    bitwise_and(x, bitwise_not(bitwise_shift_left(1, y)))

// @function bit_flip(): Bitwise Inverts the specified bit
// @param int x: target variable
// @param int y: bit number to invert
// @returns: Returns a value with the bit inverted.
export bit_flip(int x, int y) =>
    bitwise_xor(x, bitwise_shift_left(1, y))

// @function bitmask_check(): Bitwise Checks the specified Mask
// @param int x: target variable
// @param int y: Mask to check
// @returns: Returns True if the mask is set.
export bitmask_check(int x, int mask) =>
    bitwise_and(x, mask) == mask

// @function bitmask_set(): Bitwise Sets the specified Mask
// @param int x: target variable
// @param int y: mask to set
// @returns: Returns a value with the mask set.
export bitmask_set(int x, int mask) =>
    bitwise_or(x, mask)

// @function bitmask_clear(): Bitwise Clears the specified Mask
// @param int x: target variable
// @param int y: mask to clear
// @returns: Returns a value with the mask cleared.
export bitmask_clear(int x, int mask) =>
    bitwise_and(x, bitwise_not(mask))

// @function bitmask_flip(): Inverts the specified Mask
// @param int x: target variable
// @param int y: mask to invert
// @returns: Returns a value with the mask inverted.
export bitmask_flip(int x, int mask) =>
    bitwise_xor(x, mask)

// Fast arithmetic bitwise operands:

// @function math_bit_check(): Fast arithmetic bitwise Checks the specified Mask
// @param int x: target variable
// @param int y: Mask to check
// @returns: Returns True if the mask is set.
export math_bit_check(int x, int y) =>
    1 == int(x / math.pow(y, 2)) % 2

// @function math_bit_set(): Fast arithmetic bitwise Sets the specified bit
// @param int x: target variable
// @param int y: bit number to set
// @returns: Returns a value with the bit set.
export math_bit_set(int x, int y) =>
    math_bit_check(x, y) ? x : x + y

// @function math_bit_clear(): Fast arithmetic bitwise Clears the specified bit
// @param int x: target variable
// @param int y: bit number to clear
// @returns: Returns a value with the bit cleared.
export math_bit_clear(int x, int y) =>
    math_bit_check(x, y) ? x - y : x

// Fast arithmetic bitwise mask operands:

// @function math_bitmask_check(): Fast arithmetic bitwise Checks the specified Mask
// @param int x: target variable
// @param int y: Mask to check
// @returns: Returns True if the mask is set.
export math_bitmask_check(int x, int y) =>
    1 == int(x / y) % 2

// @function math_bitmask_set(): Fast arithmetic bitwise Sets the specified Mask
// @param int x: target variable
// @param int y: mask to set
// @returns: Returns a value with the mask set.
export math_bitmask_set(int x, int y) =>
    math_bitmask_check(x, y) ? x : x + y

// @function math_bitmask_clear(): Fast arithmetic bitwise Clears the specified Mask
// @param int x: target variable
// @param int y: mask to clear
// @returns: Returns a value with the mask cleared.
export math_bitmask_clear(int x, int y) =>
    math_bitmask_check(x, y) ? x - y : x
