//@version=5
indicator("Smart RSI Divergence PRO | Auto Lines + Alerts", overlay=true)

// === INPUTS ===
src = input.source(close, "Source")
rsiLength = input.int(14, "RSI Length")
showRegular = input.bool(true, "Show Regular Divergence")
showHidden = input.bool(true, "Show Hidden Divergence")
showLines = input.bool(true, "Show Divergence Lines")
showLabels = input.bool(true, "Show Labels")

lineWidth = input.int(1, "Line Width")
lineTransparency = input.int(30, "Line Transparency (0-100)")

// === RSI ===
rsiValue = ta.rsi(src, rsiLength)

// === FRACTALS ===
isTop() =>
    high[4] < high[2] and high[3] < high[2] and high[2] > high[1] and high[2] > high

isBottom() =>
    low[4] > low[2] and low[3] > low[2] and low[2] < low[1] and low[2] < low

isRSITop() =>
    rsiValue[4] < rsiValue[2] and rsiValue[3] < rsiValue[2] and rsiValue[2] > rsiValue[1] and rsiValue[2] > rsiValue

isRSIBottom() =>
    rsiValue[4] > rsiValue[2] and rsiValue[3] > rsiValue[2] and rsiValue[2] < rsiValue[1] and rsiValue[2] < rsiValue

// === SAVE FRACTALS ===
ph = isTop() ? high[2] : na
pl = isBottom() ? low[2] : na
rsiPh = isRSITop() ? rsiValue[2] : na
rsiPl = isRSIBottom() ? rsiValue[2] : na

// === PREVIOUS POINTS ===
phPrev = ta.valuewhen(isTop(), high[2], 1)
plPrev = ta.valuewhen(isBottom(), low[2], 1)
rsiPhPrev = ta.valuewhen(isRSITop(), rsiValue[2], 1)
rsiPlPrev = ta.valuewhen(isRSIBottom(), rsiValue[2], 1)

// === CONDITIONS ===
regBear = ph and ph > phPrev and rsiPh < rsiPhPrev and showRegular
regBull = pl and pl < plPrev and rsiPl > rsiPlPrev and showRegular

hidBear = ph and ph < phPrev and rsiPh > rsiPhPrev and showHidden
hidBull = pl and pl > plPrev and rsiPl < rsiPlPrev and showHidden

// === DRAW LINES — только по цене ===
if showLines
    if regBear
        var line l1 = na
        l1 := line.new(ta.valuewhen(isTop(), bar_index[2], 1), phPrev, bar_index[2], ph)
        line.set_color(l1, color.new(color.red, lineTransparency))
        line.set_width(l1, lineWidth)

    if regBull
        var line l2 = na
        l2 := line.new(ta.valuewhen(isBottom(), bar_index[2], 1), plPrev, bar_index[2], pl)
        line.set_color(l2, color.new(color.green, lineTransparency))
        line.set_width(l2, lineWidth)

    if hidBear
        var line l3 = na
        l3 := line.new(ta.valuewhen(isTop(), bar_index[2], 1), phPrev, bar_index[2], ph)
        line.set_color(l3, color.new(color.orange, lineTransparency))
        line.set_width(l3, lineWidth)

    if hidBull
        var line l4 = na
        l4 := line.new(ta.valuewhen(isBottom(), bar_index[2], 1), plPrev, bar_index[2], pl)
        line.set_color(l4, color.new(color.blue, lineTransparency))
        line.set_width(l4, lineWidth)

// === LABELS ===
plotshape(regBear and showLabels ? ph : na, title="Regular Bearish", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)
plotshape(regBull and showLabels ? pl : na, title="Regular Bullish", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(hidBear and showLabels ? ph : na, title="Hidden Bearish", location=location.abovebar, color=color.orange, style=shape.triangledown, size=size.small)
plotshape(hidBull and showLabels ? pl : na, title="Hidden Bullish", location=location.belowbar, color=color.blue, style=shape.triangleup, size=size.small)

// === ALERTS ===
alertcondition(regBear, "Regular Bearish Divergence", "Regular Bearish Divergence Detected")
alertcondition(regBull, "Regular Bullish Divergence", "Regular Bullish Divergence Detected")
alertcondition(hidBear, "Hidden Bearish Divergence", "Hidden Bearish Divergence Detected")
alertcondition(hidBull, "Hidden Bullish Divergence", "Hidden Bullish Divergence Detected")
