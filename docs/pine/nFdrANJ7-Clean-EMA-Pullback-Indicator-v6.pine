//@version=6
indicator("Clean EMA Pullback Indicator v6", overlay=true, max_labels_count=500)

//====================================================
// INPUTS
//====================================================

//-------------------------
// TREND SETTINGS
//-------------------------

groupTrend = "Trend Settings"

ema200Length = input.int(
     200,
     "200 EMA Length",
     group=groupTrend)

ema50Length = input.int(
     50,
     "50 EMA Length",
     group=groupTrend)

ema20Length = input.int(
     20,
     "20 EMA Length",
     group=groupTrend)


showBackground = input.bool(
     true,
     "Show Trend Background",
     group=groupTrend)


//-------------------------
// EMA CHANNEL
//-------------------------

groupChannel = "EMA Pullback Channel"

useATR = input.bool(
     true,
     "Use ATR Channel",
     group=groupChannel)


channelPercent = input.float(
     0.10,
     "EMA Channel %",
     step=0.05,
     group=groupChannel)


atrLength = input.int(
     14,
     "ATR Length",
     group=groupChannel)


atrMultiplier = input.float(
     1.0,
     "ATR Multiplier",
     step=0.1,
     group=groupChannel)


//-------------------------
// MARKET STRUCTURE
//-------------------------

groupStructure = "Market Structure"


showStructure = input.bool(
     true,
     "Show HH HL LH LL",
     group=groupStructure)


swingLength = input.int(
     3,
     "Swing Length",
     minval=1,
     group=groupStructure)


//-------------------------
// FILTERS
//-------------------------

groupFilters = "Trade Filters"


useEMAAlignment = input.bool(
     true,
     "Use EMA Alignment",
     group=groupFilters)


showCandleColors = input.bool(
     true,
     "Show Candle Colors",
     group=groupFilters)


//-------------------------
// RE-ENTRY
//-------------------------

groupReentry = "Re-entry Settings"


showReentry = input.bool(
     true,
     "Show Re-entry Signals",
     group=groupReentry)


//-------------------------
// DAILY RANGE
//-------------------------

groupDaily = "Daily Range"


showDailyRange = input.bool(
     true,
     "Show Previous Day High/Low",
     group=groupDaily)


//-------------------------
// FVG
//-------------------------

groupFVG = "Fair Value Gap"


showFVG = input.bool(
     true,
     "Show Trend FVG",
     group=groupFVG)


fvgExtend = input.int(
     20,
     "FVG Extension",
     minval=1,
     group=groupFVG)


//-------------------------
// MTF DASHBOARD
//-------------------------

groupDashboard = "Dashboard"


showDashboard = input.bool(
     true,
     "Show MTF Dashboard",
     group=groupDashboard)


//====================================================
// ATR TRADE MANAGEMENT
//====================================================

groupATR = "ATR Stop / Target"


showTradeLevels = input.bool(
     true,
     "Show ATR Stop & Targets",
     group=groupATR)


atrSLMultiplier = input.float(
     1.5,
     "Stop Loss ATR Multiplier",
     step=0.1,
     group=groupATR)


atrTP1Multiplier = input.float(
     1.5,
     "TP1 ATR Multiplier",
     step=0.1,
     group=groupATR)


atrTP2Multiplier = input.float(
     3.0,
     "TP2 ATR Multiplier",
     step=0.1,
     group=groupATR)


//====================================================
// EMA CALCULATIONS
//====================================================

ema20 = ta.ema(
     close,
     ema20Length)


ema50 = ta.ema(
     close,
     ema50Length)


ema200 = ta.ema(
     close,
     ema200Length)



//====================================================
// ATR CHANNEL
//====================================================

atrValue = ta.atr(
     atrLength)



channelSize = useATR ?
     atrValue * atrMultiplier :
     ema20 * channelPercent / 100



upperChannel = ema20 + channelSize

lowerChannel = ema20 - channelSize



//====================================================
// TREND LOGIC
//====================================================

bullTrend = close > ema200

bearTrend = close < ema200



bullAlignment =
     ema20 > ema50 and
     ema50 > ema200



bearAlignment =
     ema20 < ema50 and
     ema50 < ema200



ema200Color =
     bullTrend ?
     color.green :
     color.red



//====================================================
// CANDLE COLOR LOGIC
//====================================================

bullCandle =
     bullAlignment and
     close > open


bearCandle =
     bearAlignment and
     close < open



barcolor(
     showCandleColors ?
     bullCandle ? color.green :
     bearCandle ? color.red :
     color.gray
     : na)

 //====================================================
// EMA PLOTS
//====================================================


plot(
     ema200,
     color=ema200Color,
     linewidth=3,
     title="200 EMA")


plot(
     ema50,
     color=color.orange,
     linewidth=2,
     title="50 EMA")


plot(
     ema20,
     color=color.yellow,
     linewidth=2,
     title="20 EMA")



//====================================================
// EMA CHANNEL VISUALS
//====================================================


upperPlot = plot(
     upperChannel,
     color=color.new(color.blue,40),
     title="Upper EMA Channel")


lowerPlot = plot(
     lowerChannel,
     color=color.new(color.blue,40),
     title="Lower EMA Channel")


fill(
     upperPlot,
     lowerPlot,
     color=color.new(color.blue,90),
     title="EMA Channel Fill")



//====================================================
// TREND BACKGROUND
//====================================================


bgcolor(
     showBackground ?
     bullTrend ?
     color.new(color.green,90) :
     color.new(color.red,90)
     : na)


//====================================================
// MARKET STRUCTURE
//====================================================


pivotHigh = ta.pivothigh(
     high,
     swingLength,
     swingLength)


pivotLow = ta.pivotlow(
     low,
     swingLength,
     swingLength)



var float previousHigh = na
var float previousLow = na



var bool higherHigh = false
var bool lowerHigh = false
var bool higherLow = false
var bool lowerLow = false



higherHigh := false
lowerHigh := false
higherLow := false
lowerLow := false



if not na(pivotHigh)

    higherHigh :=
         not na(previousHigh) and
         pivotHigh > previousHigh


    lowerHigh :=
         not na(previousHigh) and
         pivotHigh < previousHigh


    previousHigh := pivotHigh



if not na(pivotLow)

    higherLow :=
         not na(previousLow) and
         pivotLow > previousLow


    lowerLow :=
         not na(previousLow) and
         pivotLow < previousLow


    previousLow := pivotLow



//====================================================
// MARKET STRUCTURE LABELS
//====================================================


if showStructure and higherHigh

    label.new(
         bar_index - swingLength,
         high[swingLength],
         "HH",
         style=label.style_label_down,
         color=color.green,
         textcolor=color.white,
         size=size.tiny)



if showStructure and higherLow

    label.new(
         bar_index - swingLength,
         low[swingLength],
         "HL",
         style=label.style_label_up,
         color=color.green,
         textcolor=color.white,
         size=size.tiny)



if showStructure and lowerHigh

    label.new(
         bar_index - swingLength,
         high[swingLength],
         "LH",
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white,
         size=size.tiny)



if showStructure and lowerLow

    label.new(
         bar_index - swingLength,
         low[swingLength],
         "LL",
         style=label.style_label_up,
         color=color.red,
         textcolor=color.white,
         size=size.tiny)   

   //====================================================
// STATE MANAGEMENT
//====================================================


var bool buySetup = false
var bool sellSetup = false

var bool buyTriggered = false
var bool sellTriggered = false


var float setupHigh = na
var float setupLow = na


var float lastSwingHigh = na
var float lastSwingLow = na



//====================================================
// SAVE SWING LEVELS FOR BREAK CONFIRMATION
//====================================================


if not na(pivotHigh)

    lastSwingHigh := pivotHigh



if not na(pivotLow)

    lastSwingLow := pivotLow



//====================================================
// PULLBACK DETECTION
//====================================================


pullbackIntoEMA =
     high >= lowerChannel and
     low <= upperChannel



//====================================================
// CREATE TRADE SETUPS
//====================================================


validBullTrend =
     bullTrend and
     (not useEMAAlignment or bullAlignment)



validBearTrend =
     bearTrend and
     (not useEMAAlignment or bearAlignment)



if validBullTrend and pullbackIntoEMA

    buySetup := true
    sellSetup := false



if validBearTrend and pullbackIntoEMA

    sellSetup := true
    buySetup := false



//====================================================
// SWING BREAK CONFIRMATION
//====================================================


buyBreak =
     buySetup and
     not na(lastSwingHigh) and
     close > lastSwingHigh and
     close > open



sellBreak =
     sellSetup and
     not na(lastSwingLow) and
     close < lastSwingLow and
     close < open



//====================================================
// BUY SIGNAL
//====================================================


buySignal =
     buyBreak and
     not buyTriggered



if buySignal

    label.new(
         bar_index,
         low,
         "▲ BUY",
         style=label.style_label_up,
         color=color.green,
         textcolor=color.white,
         size=size.large)


    buyTriggered := true
    sellTriggered := false

    buySetup := false

    setupHigh := na



//====================================================
// SELL SIGNAL
//====================================================


sellSignal =
     sellBreak and
     not sellTriggered



if sellSignal

    label.new(
         bar_index,
         high,
         "▼ SELL",
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white,
         size=size.large)


    sellTriggered := true
    buyTriggered := false

    sellSetup := false

    setupLow := na



//====================================================
// RESET AFTER TREND CHANGE
//====================================================


if bearTrend

    buyTriggered := false



if bullTrend

    sellTriggered := false



//====================================================
// ALERTS
//====================================================


alertcondition(
     buySignal,
     title="BUY Signal",
     message="Clean EMA Pullback BUY")


alertcondition(
     sellSignal,
     title="SELL Signal",
     message="Clean EMA Pullback SELL")   

 //====================================================
// RE-ENTRY SIGNALS
//====================================================


var bool lastTradeBuy = false
var bool lastTradeSell = false

var bool buyReentryUsed = false
var bool sellReentryUsed = false



// Track last trade direction

if buySignal

    lastTradeBuy := true
    lastTradeSell := false
    buyReentryUsed := false



if sellSignal

    lastTradeSell := true
    lastTradeBuy := false
    sellReentryUsed := false



//====================================================
// RE-ENTRY CONDITIONS
//====================================================


buyReentry =

     showReentry and
     lastTradeBuy and
     not buyReentryUsed and
     bullTrend and
     (not useEMAAlignment or bullAlignment) and
     pullbackIntoEMA and
     close > ema20 and
     close > open



sellReentry =

     showReentry and
     lastTradeSell and
     not sellReentryUsed and
     bearTrend and
     (not useEMAAlignment or bearAlignment) and
     pullbackIntoEMA and
     close < ema20 and
     close < open



//====================================================
// DRAW RE-ENTRY TRIANGLES
//====================================================


if buyReentry

    label.new(
         bar_index,
         low,
         "",
         style=label.style_triangleup,
         color=color.green,
         size=size.normal)

    buyReentryUsed := true



if sellReentry

    label.new(
         bar_index,
         high,
         "",
         style=label.style_triangledown,
         color=color.red,
         size=size.normal)

    sellReentryUsed := true




//====================================================
// DAILY RANGE
//====================================================


previousDayHigh = request.security(
     syminfo.tickerid,
     "D",
     high[1],
     lookahead=barmerge.lookahead_on)



previousDayLow = request.security(
     syminfo.tickerid,
     "D",
     low[1],
     lookahead=barmerge.lookahead_on)



plot(
     showDailyRange ? previousDayHigh : na,
     title="Previous Day High",
     color=color.blue,
     linewidth=2,
     style=plot.style_linebr)



plot(
     showDailyRange ? previousDayLow : na,
     title="Previous Day Low",
     color=color.blue,
     linewidth=2,
     style=plot.style_linebr)




//====================================================
// FAIR VALUE GAPS
//====================================================


// Bullish FVG
// Candle 3 low is above candle 1 high

bullishFVG =

     low > high[2] and
     bullTrend



// Bearish FVG
// Candle 3 high is below candle 1 low

bearishFVG =

     high < low[2] and
     bearTrend



//====================================================
// DRAW FVG BOXES
//====================================================


if showFVG and bullishFVG

    box.new(
         left=bar_index-2,
         top=low,
         right=bar_index+fvgExtend,
         bottom=high[2],
         bgcolor=color.new(color.green,85),
         border_color=color.green)



if showFVG and bearishFVG

    box.new(
         left=bar_index-2,
         top=low[2],
         right=bar_index+fvgExtend,
         bottom=high,
         bgcolor=color.new(color.red,85),
         border_color=color.red)     

     //====================================================
// HIGHER TIMEFRAME DASHBOARD
//====================================================


// Function to determine timeframe trend

getHTFSignal(tf) =>

    tfClose = request.security(
         syminfo.tickerid,
         tf,
         close)


    tfEMA = request.security(
         syminfo.tickerid,
         tf,
         ta.ema(close, ema200Length))


    tfClose > tfEMA ? "BUY" : "SELL"



// Get signals

signal15 = getHTFSignal("15")

signal30 = getHTFSignal("30")

signal4H = getHTFSignal("240")



//====================================================
// ALIGNMENT
//====================================================


alignment =

     signal15 == "BUY" and
     signal30 == "BUY" and
     signal4H == "BUY" ?

     "STRONG BUY" :


     signal15 == "SELL" and
     signal30 == "SELL" and
     signal4H == "SELL" ?

     "STRONG SELL" :


     "MIXED"



//====================================================
// COLORS
//====================================================


signal15Color =
     signal15 == "BUY" ?
     color.green :
     color.red


signal30Color =
     signal30 == "BUY" ?
     color.green :
     color.red


signal4HColor =
     signal4H == "BUY" ?
     color.green :
     color.red



alignmentColor =

     alignment == "STRONG BUY" ?
     color.green :

     alignment == "STRONG SELL" ?
     color.red :

     color.orange



//====================================================
// CREATE TABLE
//====================================================


var table htfTable = table.new(
     position.top_right,
     2,
     5,
     border_width=1)



//====================================================
// DRAW TABLE
//====================================================


if barstate.islast and showDashboard


    // HEADER

    table.cell(
         htfTable,
         0,
         0,
         "TF",
         bgcolor=color.gray,
         text_color=color.white)


    table.cell(
         htfTable,
         1,
         0,
         "SIGNAL",
         bgcolor=color.gray,
         text_color=color.white)



    // 15 MIN

    table.cell(
         htfTable,
         0,
         1,
         "15M",
         bgcolor=color.gray,
         text_color=color.white)


    table.cell(
         htfTable,
         1,
         1,
         signal15,
         bgcolor=signal15Color,
         text_color=color.white)



    // 30 MIN

    table.cell(
         htfTable,
         0,
         2,
         "30M",
         bgcolor=color.gray,
         text_color=color.white)


    table.cell(
         htfTable,
         1,
         2,
         signal30,
         bgcolor=signal30Color,
         text_color=color.white)



    // 4 HOUR

    table.cell(
         htfTable,
         0,
         3,
         "4H",
         bgcolor=color.gray,
         text_color=color.white)


    table.cell(
         htfTable,
         1,
         3,
         signal4H,
         bgcolor=signal4HColor,
         text_color=color.white)



    // ALIGNMENT

    table.cell(
         htfTable,
         0,
         4,
         "ALIGN",
         bgcolor=color.gray,
         text_color=color.white)


    table.cell(
         htfTable,
         1,
         4,
         alignment,
         bgcolor=alignmentColor,
         text_color=color.white)    

        //====================================================
// ATR STOP LOSS / TAKE PROFIT LEVELS
//====================================================


var float tradeEntry = na
var float stopLoss = na
var float takeProfit1 = na
var float takeProfit2 = na


var bool activeTrade = false



//====================================================
// CREATE BUY LEVELS
//====================================================


if buySignal

    tradeEntry := close

    stopLoss :=
         tradeEntry -
         (atrValue * atrSLMultiplier)


    takeProfit1 :=
         tradeEntry +
         (atrValue * atrTP1Multiplier)


    takeProfit2 :=
         tradeEntry +
         (atrValue * atrTP2Multiplier)


    activeTrade := true



//====================================================
// CREATE SELL LEVELS
//====================================================


if sellSignal

    tradeEntry := close

    stopLoss :=
         tradeEntry +
         (atrValue * atrSLMultiplier)


    takeProfit1 :=
         tradeEntry -
         (atrValue * atrTP1Multiplier)


    takeProfit2 :=
         tradeEntry -
         (atrValue * atrTP2Multiplier)


    activeTrade := true



//====================================================
// PLOT TRADE LEVELS
//====================================================


plot(
     showTradeLevels and activeTrade ? tradeEntry : na,
     title="Entry",
     color=color.white,
     style=plot.style_linebr,
     linewidth=2)



plot(
     showTradeLevels and activeTrade ? stopLoss : na,
     title="Stop Loss",
     color=color.red,
     style=plot.style_linebr,
     linewidth=2)



plot(
     showTradeLevels and activeTrade ? takeProfit1 : na,
     title="TP1",
     color=color.green,
     style=plot.style_linebr,
     linewidth=2)



plot(
     showTradeLevels and activeTrade ? takeProfit2 : na,
     title="TP2",
     color=color.lime,
     style=plot.style_linebr,
     linewidth=2)


//====================================================
// REMOVE LEVELS AFTER TREND FAILURE
//====================================================


if bullTrend == false and bearTrend == false

    activeTrade := false