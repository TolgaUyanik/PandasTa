//@version=6

// @description TODO: add library description here
library("utils", overlay = false)



//@func   返回 int 类型或 na(int) 标识
// @param  this int 待检测对象
// @returns string 类型名称
export method getType(int    this) => na(this) ? "int(na)"    : "int"

//@func   返回 float 类型或 na(float) 标识
// @param  this float 待检测对象
// @returns string 类型名称
export method getType(float  this) => na(this) ? "float(na)"  : "float"

//@func   返回 color 类型或 na(color) 标识
// @param  this color 待检测对象
// @returns string 类型名称
export method getType(color  this) => na(this) ? "color(na)"  : "color"

//@func   返回 string 类型或 na(string) 标识
// @param  this string 待检测对象
// @returns string 类型名称
export method getType(string this) => na(this) ? "string(na)" : "string"

//@func   返回 bool 类型
// @param  this bool 待检测对象
// @returns string 类型名称
export method getType(bool this) => this? "true" : "false"



