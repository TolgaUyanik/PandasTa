// @version=5
// @description Common types and utilities for Smart Money Concepts (SMC) indicators.
// This library provides a foundational set of types and functions for analyzing and drawing
// market structure, liquidity, order blocks, and other key SMC concepts.
library("SMC_Common", true)

// ============================================================================
// TYPE DEFINITIONS
// ============================================================================

// Represents a swing high or swing low point on the chart.
export type SwingPoint
    float price
    int bar_index
    int bar_time
    string swing_type  // "HIGH" or "LOW"
    int strength       // The number of bars required for confirmation.
    bool is_major      // True if it's a major swing point in the market structure.
    string timeframe   // The timeframe the swing was identified on.

// Represents a level of liquidity, adding drawing IDs.
export type LiquidityLevel
    float price
    int bar_index
    int bar_time
    string liq_type    // "BSL" or "SSL"
    bool is_swept
    string timeframe
    // -- Drawing specific fields --
    line line_id       // ID for the line drawn on the chart.
    label label_id     // ID for the label drawn on the chart.
    bool is_active     // To track if the level is still valid.

// Represents a bullish or bearish order block, adding a drawing ID.
export type OrderBlock
    int start_time
    int end_time
    float top
    float bottom
    string ob_type     // "BULLISH" or "BEARISH"
    bool is_mitigated
    string timeframe
    // -- Drawing specific fields --
    box box_id         // ID for the box drawn on the chart.

// Represents a break of structure (BOS) or change of character (CHOCH).
export type StructureBreak
    float level
    int break_time
    string break_type  // "BOS" or "CHOCH"
    string direction   // "BULLISH" or "BEARISH"
    int source_time    // The timestamp of the swing point that was broken.
    string timeframe

// Represents a liquidity sweep event for alerting and tracking.
export type SweepEvent
    float price
    int sweep_time
    string liq_type    // "BSL" or "SSL"
    string timeframe

// ============================================================================
// UTILITY & DETECTION FUNCTIONS
// ============================================================================

// A flexible pivot detection function using left and right strength.
// @param left_strength (int) Number of bars to the left that must be lower/higher.
// @param right_strength (int) Number of bars to the right that must be lower/higher.
// @returns A tuple: [pivot_high_price, pivot_high_time, pivot_low_price, pivot_low_time]
export f_detect_pivots(int left_strength, int right_strength) =>
    float ph_price = ta.pivothigh(left_strength, right_strength)
    int ph_time = time[right_strength]
    float pl_price = ta.pivotlow(left_strength, right_strength)
    int pl_time = time[right_strength]
    [ph_price, ph_time, pl_price, pl_time]

// Converts a timeframe string to a more readable format.
export f_tf_to_string(string tf) =>
    switch tf
        "15"  => "15m"
        "60"  => "1H"
        "240" => "4H"
        "1D"  => "1D"
        => tf

// ============================================================================
// DRAWING MANAGEMENT FUNCTIONS
// ============================================================================
// These functions manage the creation, updating, and deletion of drawing objects,
// ensuring the anchoring and style match your original script.

// Draws a new liquidity level (line and label).
// @param level (LiquidityLevel) The liquidity level object to draw.
// @param color (color) The color for the line and label text.
// @param size (string) The size for the label.
export f_draw_liquidity_level(LiquidityLevel level, color liq_color, string size) =>
    future_extension = 50 * (time - time[1])
    line new_line = line.new(x1=level.bar_time, y1=level.price, x2=time + future_extension, y2=level.price,
         xloc=xloc.bar_time, color=liq_color, width=2, style=line.style_solid, extend=extend.right)

    label_text = f_tf_to_string(level.timeframe) + " " + level.liq_type
    label new_label = label.new(x=level.bar_time, y=level.price, xloc=xloc.bar_time,
         text=label_text, color=color.new(color.white, 100), textcolor=liq_color,
         size=size, style=label.style_label_center)

    level.line_id := new_line
    level.label_id := new_label

// Updates the visual style of a liquidity level when it is swept.
export f_update_swept_liquidity_drawing(LiquidityLevel level, color swept_color) =>
    // Create a dashed line to mark the swept portion
    line.new(x1=level.bar_time, y1=level.price, x2=time, y2=level.price,
         xloc=xloc.bar_time, color=swept_color, width=3, style=line.style_dashed)

    // Delete the original line and label as they are no longer active
    if not na(level.line_id)
        line.delete(level.line_id)
    if not na(level.label_id)
        label.delete(level.label_id)

// Extends the lines of all active liquidity levels to the right.
export f_extend_liquidity_lines(array<LiquidityLevel> liq_array) =>
    if array.size(liq_array) > 0
        future_extension = 50 * (time - time[1])
        for i = 0 to array.size(liq_array) - 1
            level = array.get(liq_array, i)
            if level.is_active and not na(level.line_id)
                line.set_x2(level.line_id, time + future_extension)

// Draws a structure break line and label.
export f_draw_structure_break(StructureBreak break_obj, color line_color, string tf_label) =>
    string label_text = break_obj.break_type + "\n" + tf_label
    label_style = break_obj.direction == "BULLISH" ? label.style_label_down : label.style_label_up
    
    line.new(x1=break_obj.source_time, y1=break_obj.level, x2=time, y2=break_obj.level,
         xloc=xloc.bar_time, color=line_color, style=line.style_solid, width=2)
         
    label.new(x=math.round((break_obj.source_time + time) / 2), y=break_obj.level, xloc=xloc.bar_time,
         text=label_text, color=color.new(color.white, 100),
         textcolor=line_color, style=label_style, size=size.normal)

// Draws an order block.
export f_draw_order_block(OrderBlock ob) =>
    ob_color = ob.ob_type == "BULLISH" ? color.new(color.green, 85) : color.new(color.red, 85)
    border_color = ob.ob_type == "BULLISH" ? color.green : color.red
    
    future_extension = 10 * (time - time[1])
    box ob_box = box.new(left=ob.start_time, top=ob.top, right=time + future_extension, bottom=ob.bottom,
         bgcolor=ob_color, border_color=border_color, border_width=1, extend=extend.right)
    ob.box_id := ob_box
