//@version=6
indicator("ATR Circle Plot", overlay=true)

// --- Inputs ---
atrLength     = input.int(14, "ATR Length", minval=1)
atrMultiplier = input.float(1.0, "ATR Multiplier", minval=0.1, step=0.1)

// Visual Toggles
showLabels    = input.bool(false, "Show ATR Labels")
showNote      = input.bool(true, "Show Teaching Note")
noteSize      = input.string(size.large, "Note Font Size", options=[size.tiny, size.small, size.normal, size.large, size.huge])

upperColor    = input.color(color.blue, "Upper Circle Color")
lowerColor    = input.color(color.red, "Lower Circle Color")

// --- Calculations ---
// Adaptive ATR based on current timeframe
currentATR = ta.atr(atrLength)
upperLevel = open + (currentATR * atrMultiplier)
lowerLevel = open - (currentATR * atrMultiplier)

// --- Plotting ---
plot(upperLevel, title="Upper ATR", color=upperColor, style=plot.style_circles, linewidth=2)
plot(lowerLevel, title="Lower ATR", color=lowerColor, style=plot.style_circles, linewidth=2)

// --- Teaching Note ---
if showNote
    var table noteTable = table.new(position.bottom_right, columns=1, rows=1, frame_color=color.gray, frame_width=1)
    
    if barstate.islastconfirmedhistory
        table.cell(noteTable, 0, 0, 
             "STUDENT EXERCISE:\n1. Draw levels on the DAILY chart at the ATR dots.\n2. Turn OFF indicator when done.", 
             bgcolor=color.new(color.black, 10), text_color=color.yellow, text_size=noteSize, text_halign=text.align_left)