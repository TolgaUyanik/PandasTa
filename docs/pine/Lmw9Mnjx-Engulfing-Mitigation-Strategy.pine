//@version=6
strategy("Engulfing Mitigation Strategy", overlay = true, margin_long = 10, margin_short = 10, pyramiding = 5, initial_capital = 10000)

// --- Inputs ---
takeProfitPctInput = input.float(4.0, "Take Profit %", step = 0.5) / 100.0
pivotLeftInput     = input.int(5, "Pivot Left Bars")
pivotRightInput    = input.int(5, "Pivot Right Bars")
emaLengthInput     = input.int(200, "EMA Length")

// --- Indicators ---
// Trend Filter
ema200 = ta.ema(close, emaLengthInput)

// Engulfing Patterns
bullishEngulfing = close > open[1] and open <= close[1] and close[1] < open[1]
bearishEngulfing = close < open[1] and open >= close[1] and close[1] > open[1]

// Pivot Points
pivotHigh = ta.pivothigh(high, pivotLeftInput, pivotRightInput)
pivotLow  = ta.pivotlow(low, pivotLeftInput, pivotRightInput)

// Visuals
plot(ema200, color = color.blue, title = "200 EMA")
plotshape(bullishEngulfing, title="Bullish Engulfing", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(bearishEngulfing, title="Bearish Engulfing", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// --- Strategy Logic ---
var int entryCount = 0

// Entry scale array: 0.5%, 0.5%, 1%, 2%, 4%
var float[] qtyPercents = array.from(0.005, 0.005, 0.01, 0.02, 0.04)

// Reset counter when flat
if strategy.position_size == 0
    entryCount := 0

// Current base quantity calculation (using available equity)
baseQty = strategy.equity / close

// Initial Entries
if strategy.position_size == 0
    if bullishEngulfing and close > ema200
        strategy.entry("Long_0", strategy.long, qty = baseQty * qtyPercents.get(0))
        entryCount := 1
    else if bearishEngulfing and close < ema200
        strategy.entry("Short_0", strategy.short, qty = baseQty * qtyPercents.get(0))
        entryCount := 1

// DCA / Scale-in Logic
if strategy.position_size > 0
    // Long
    // Add on dips when price is below average entry AND a bullish signal appears (Engulfing or Pivot Low)
    if entryCount < 5 and close < strategy.position_avg_price and (bullishEngulfing or not na(pivotLow))
        strategy.entry("Long_" + str.tostring(entryCount), strategy.long, qty = baseQty * qtyPercents.get(entryCount))
        entryCount += 1
        
    // Exit when price moves 4% in favor from the average entry price
    strategy.exit("TP_Long", limit = strategy.position_avg_price * (1 + takeProfitPctInput))

if strategy.position_size < 0
    // Short
    // Add on rallies when price is above average entry AND a bearish signal appears (Engulfing or Pivot High)
    if entryCount < 5 and close > strategy.position_avg_price and (bearishEngulfing or not na(pivotHigh))
        strategy.entry("Short_" + str.tostring(entryCount), strategy.short, qty = baseQty * qtyPercents.get(entryCount))
        entryCount += 1
        
    // Exit when price moves 4% in favor from the average entry price
    strategy.exit("TP_Short", limit = strategy.position_avg_price * (1 - takeProfitPctInput))
