//@version=6
//──────────────────────────────────────────────────────────────────────
//  Volatility Squeeze – Blue Zone (classic dynamic fill)
//──────────────────────────────────────────────────────────────────────
indicator("Volatility Squeeze – Blue Zone (classic)", overlay = true)

// ────── USER INPUTS ──────────────────────────────────────────────────
lenBB   = input.int  (20 , "Length (BB & KC)")
multBB  = input.float(2.0, "BB Std-Dev" , minval = 0.1, step = 0.1)
multKC  = input.float(1.5, "KC ATR Mult", minval = 0.1, step = 0.1)
src     = input.source(close, "Source price")

shadeBase   = input.color(color.blue , "Zone colour")
shadeOpac   = input.int  (80 , "Zone opacity (0-100)", minval = 0, maxval = 100)

shadeClr = color.new(shadeBase, shadeOpac)

// ────── CORE CALCULATIONS ───────────────────────────────────────────
basisBB = ta.sma(src, lenBB)
devBB   = multBB * ta.stdev(src, lenBB)
bbU     = basisBB + devBB
bbL     = basisBB - devBB

basisKC = ta.sma(src, lenBB)
atrKC   = multKC * ta.atr(lenBB)
kcU     = basisKC + atrKC
kcL     = basisKC - atrKC

// ❶ Squeeze is ON while BB stays inside KC
squeezeOn  = (bbU < kcU) and (bbL > kcL)
squeezeOff = squeezeOn[1] and not squeezeOn

// ────── PLOT & FILL (drawn only during a squeeze) ───────────────────
pU = plot(squeezeOn ? bbU : na, "BB upper in squeeze",  color = na)
pL = plot(squeezeOn ? bbL : na, "BB lower in squeeze",  color = na)
fill(pU, pL, color = shadeClr, title = "Squeeze zone")

// ────── OPTIONAL ALERT ──────────────────────────────────────────────
alertcondition(squeezeOff, "Squeeze breakout",
     "Volatility squeeze has just released on {{ticker}} (bar close).")
