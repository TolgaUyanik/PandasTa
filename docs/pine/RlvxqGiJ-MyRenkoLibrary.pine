//@version=5
library("MyRenkoLibrary")

// Функция для расчета Renko
export calcRenko(float real_break_size) =>
    var float openRenko = na
    var float closeRenko = na
    var int direction=0
    start = open
    start := nz(start[1], open)

    delta = na(closeRenko[1]) ? close - start : close - closeRenko[1]
    
    if  math.abs(delta) >= real_break_size
        if direction[1]==0
            if delta>0
                direction:=1
            if delta<0
                direction:=-1
            
            openRenko := nz(closeRenko[1], start)
            closeRenko := close
        else
            if (math.sign(delta)==math.sign(direction[1]))
                openRenko := nz(closeRenko[1], start)
                closeRenko := close
                direction:=nz(direction[1], 0)
            else if math.abs(delta)>=real_break_size*2
                openRenko := openRenko[1]
                closeRenko := close
                if direction[1]>0
                    direction:=-1
                if direction[1]<0
                    direction:=1
            else
                openRenko := openRenko[1]
                closeRenko := closeRenko[1]
                direction:=nz(direction[1], 0)
    else
        openRenko := openRenko[1]
        closeRenko := closeRenko[1]
        direction:=nz(direction[1], 0)

    [openRenko, closeRenko, direction]

