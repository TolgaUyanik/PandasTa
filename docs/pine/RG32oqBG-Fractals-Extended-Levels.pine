//@version=6
indicator("Fractals Extended Levels", shorttitle="FracLevels", overlay=true, max_lines_count=100)

//------------------------------------------------------------------------------
// Fractal settings
//------------------------------------------------------------------------------
string GROUP_FRACTALS = "Fractals"
string GROUP_LINES = "Fractal Lines"

bool filterBW = input.bool(
     false,
     "Filter Bill Williams Fractals",
     group=GROUP_FRACTALS,
     tooltip="Off uses the original Bill Williams fractal rules. On uses the stricter regular fractal rules."
)

color topMarkerColor = input.color(#E91E63, "Top Fractal Color", group=GROUP_FRACTALS)
color bottomMarkerColor = input.color(#089981, "Bottom Fractal Color", group=GROUP_FRACTALS)

//------------------------------------------------------------------------------
// Fractal-line settings
//------------------------------------------------------------------------------
bool showFractalLines = input.bool(true, "Show Fractal Lines", group=GROUP_LINES)
bool extendLinesRight = input.bool(true, "Extend Lines to the Right", group=GROUP_LINES)

int numberOfLines = input.int(
     5,
     "Number of Fractal Lines",
     minval=1,
     maxval=50,
     group=GROUP_LINES
)

int lineThickness = input.int(
     2,
     "Line Thickness",
     minval=1,
     maxval=4,
     group=GROUP_LINES
)

string lineStyleInput = input.string(
     "Solid",
     "Line Style",
     options=["Solid", "Dashed", "Dotted"],
     group=GROUP_LINES
)

color topLineColor = input.color(#2962FF, "Top Fractal Line Color", group=GROUP_LINES)
color bottomLineColor = input.color(#2962FF, "Bottom Fractal Line Color", group=GROUP_LINES)

//------------------------------------------------------------------------------
// Original five-candle fractal recognition
//------------------------------------------------------------------------------
isRegularFractal(int mode) =>
    bool result = false

    if mode == 1
        result := high[4] < high[3] and high[3] < high[2] and high[2] > high[1] and high[1] > high
    else if mode == -1
        result := low[4] > low[3] and low[3] > low[2] and low[2] < low[1] and low[1] < low

    result

isBWFractal(int mode) =>
    bool result = false

    if mode == 1
        result := high[4] < high[2] and high[3] <= high[2] and high[2] >= high[1] and high[2] > high
    else if mode == -1
        result := low[4] > low[2] and low[3] >= low[2] and low[2] <= low[1] and low[2] < low

    result

bool topFractal = filterBW ? isRegularFractal(1) : isBWFractal(1)
bool bottomFractal = filterBW ? isRegularFractal(-1) : isBWFractal(-1)

//------------------------------------------------------------------------------
// Original-style fractal markers
//------------------------------------------------------------------------------
plotshape(
     topFractal,
     title="Top Fractals",
     style=shape.triangledown,
     location=location.abovebar,
     color=topMarkerColor,
     size=size.auto,
     offset=-2
)

plotshape(
     bottomFractal,
     title="Bottom Fractals",
     style=shape.triangleup,
     location=location.belowbar,
     color=bottomMarkerColor,
     size=size.auto,
     offset=-2
)

//------------------------------------------------------------------------------
// Convert selected line style
//------------------------------------------------------------------------------
lineStyleFromInput(string selectedStyleInput) =>
    string selectedLineStyle = line.style_solid

    if selectedStyleInput == "Dashed"
        selectedLineStyle := line.style_dashed
    else if selectedStyleInput == "Dotted"
        selectedLineStyle := line.style_dotted

    selectedLineStyle

string selectedStyle = lineStyleFromInput(lineStyleInput)

//------------------------------------------------------------------------------
// Fractal lines
// The selected number is the total number of most recent fractal lines,
// combining both top and bottom fractals.
//------------------------------------------------------------------------------
var array<line> fractalLines = array.new_line()
var array<bool> fractalLineIsTop = array.new_bool()

if not showFractalLines
    while array.size(fractalLines) > 0
        line.delete(array.pop(fractalLines))

    while array.size(fractalLineIsTop) > 0
        array.pop(fractalLineIsTop)

if showFractalLines
    if topFractal
        line newTopLine = line.new(
             x1=bar_index - 2,
             y1=high[2],
             x2=bar_index,
             y2=high[2],
             xloc=xloc.bar_index,
             extend=extendLinesRight ? extend.right : extend.none,
             color=topLineColor,
             style=selectedStyle,
             width=lineThickness
        )

        array.push(fractalLines, newTopLine)
        array.push(fractalLineIsTop, true)

    if bottomFractal
        line newBottomLine = line.new(
             x1=bar_index - 2,
             y1=low[2],
             x2=bar_index,
             y2=low[2],
             xloc=xloc.bar_index,
             extend=extendLinesRight ? extend.right : extend.none,
             color=bottomLineColor,
             style=selectedStyle,
             width=lineThickness
        )

        array.push(fractalLines, newBottomLine)
        array.push(fractalLineIsTop, false)

    while array.size(fractalLines) > numberOfLines
        line.delete(array.shift(fractalLines))
        array.shift(fractalLineIsTop)

    if array.size(fractalLines) > 0
        for index = 0 to array.size(fractalLines) - 1
            line activeLine = array.get(fractalLines, index)
            bool isTopLine = array.get(fractalLineIsTop, index)

            line.set_x2(activeLine, bar_index)
            line.set_extend(activeLine, extendLinesRight ? extend.right : extend.none)
            line.set_color(activeLine, isTopLine ? topLineColor : bottomLineColor)
            line.set_style(activeLine, selectedStyle)
            line.set_width(activeLine, lineThickness)
