//@version=5
// v7.2 (2026-05-28): library title renamed AFZT_Webhook_public2 → AFZT_Webhook_Lib →
// "ZT_Webhook_Lib" — TV content-fingerprints any republish under the banned AFZT_
// namespace. Dropping the AFZT_ prefix to "ZT_" mirrors KLP's net-new naming. No
// functional change; encode_*() signatures unchanged.
library("ZT_Webhook_Lib", overlay=false)

i2s(int v) => str.tostring(v)
f2s(float v) => str.tostring(v)
fm(float v) => str.tostring(v, format.mintick)

hdr(int whVer, string typ, string ticker, string tf, int t, int dir) =>
    "AFZT|" + i2s(whVer) + "|" + typ + "|" + ticker + "|" + tf + "|" + i2s(t) + "|" + i2s(dir) + "|"

export encode_entry_v1038(int whVer, string ticker, string tf, int t, int dir, int zoneCode, int baseType, int confidenceInt, int touchCount, int zoneAgeBars, float entryPrice, float stopPrice) =>
    hdr(whVer, "E", ticker, tf, t, dir) +
     i2s(zoneCode) + "|" + i2s(baseType) + "|" + i2s(confidenceInt) + "|" + i2s(touchCount) + "|" + i2s(zoneAgeBars) + "|" +
     fm(entryPrice) + "|" + fm(stopPrice)

export encode_be_v1038(int whVer, string ticker, string tf, int t, int dir, float entryPrice) =>
    hdr(whVer, "BE", ticker, tf, t, dir) + fm(entryPrice)

export encode_close_v1038(int whVer, string ticker, string tf, int t, int dir, float rMultiple, float shE, float shA, float shMF, float shMA) =>
    hdr(whVer, "C", ticker, tf, t, dir) +
     f2s(rMultiple) + "|" + f2s(shE) + "|" + f2s(shA) + "|" + f2s(shMF) + "|" + f2s(shMA)

export encode_close_v1041(int whVer, string ticker, string tf, int t, int dir, float rMultiple, float shE, float shA, float shMF, float shMA, float rMax, float rMin, float barsHeld, int zoneCode, int zoneAgeBars, int scoreMask, int scoreNormInt, float atrMultiple, int volRegime) =>
    hdr(whVer, "C", ticker, tf, t, dir) +
     f2s(rMultiple) + "|" + f2s(shE) + "|" + f2s(shA) + "|" + f2s(shMF) + "|" + f2s(shMA) + "|" +
     f2s(rMax) + "|" + f2s(rMin) + "|" + f2s(barsHeld) + "|" + i2s(zoneCode) + "|" + i2s(zoneAgeBars) + "|" + i2s(scoreMask) + "|" + i2s(scoreNormInt) + "|" + f2s(atrMultiple) + "|" + i2s(volRegime)

export encode_close_v1043_v2(int whVer, string ticker, string tf, int t, int dir,
     float rMultiple, float shE, float shA, float shMF, float shMA,
     float rMax, float rMin, int barsHeld,
     int zoneCode, int zoneAgeBars, int scoreMask, int scoreNormInt, float atrMultiple, int volRegime,
     int stopMethodId, int stopCandidateMask, int beMask, int tpMask,
     float entryAtr, int riskTicks, int zoneWidthTicks) =>
    hdr(whVer, "C", ticker, tf, t, dir) +
     f2s(rMultiple) + "|" + f2s(shE) + "|" + f2s(shA) + "|" + f2s(shMF) + "|" + f2s(shMA) + "|" +
     f2s(rMax) + "|" + f2s(rMin) + "|" + i2s(barsHeld) + "|" + i2s(zoneCode) + "|" + i2s(zoneAgeBars) + "|" +
     i2s(scoreMask) + "|" + i2s(scoreNormInt) + "|" + f2s(atrMultiple) + "|" + i2s(volRegime) + "|" +
     i2s(stopMethodId) + "|" + i2s(stopCandidateMask) + "|" + i2s(beMask) + "|" + i2s(tpMask) + "|" +
     f2s(entryAtr) + "|" + i2s(riskTicks) + "|" + i2s(zoneWidthTicks)

// ─── v5 (v1): S-Event encoder — preserved for backward compatibility ───
// 24 output fields (pos 0-23). Server derives time_of_day + session from timestamp.
// Upstream-emitted features (pos 24-27) are absent — server uses safe defaults.
export encode_signal_v1(int whVer, string tk, string tf, int ts, int dir,
     int zoneCode, int baseType, int scoreNorm, int scoreMask,
     int volRegime, float atrMult, float entryAtr,
     int riskTicks, int zoneWidthTicks,
     int touchCount, int zoneAgeBars,
     float o, float h, float l, float c) =>
    // Filter masks: bit 4=cooldown, bit 7=score_min, bit 8=rr_floor
    int fm = 400   // 16+128+256 — all three always evaluated
    int fr = 16    // bit 4 cooldown always passes (inside entry block)
    if scoreNorm >= 40
        fr += 128
    if riskTicks >= 4
        fr += 256
    // Candle ratios
    float rng = h - l
    float bodyR = rng > 0 ? math.abs(c - o) / rng : 0.0
    float wickR = rng > 0 ? 1.0 - bodyR : 0.0
    // Encode all 24 fields
    hdr(whVer, "S", tk, tf, ts, dir) +
     i2s(zoneCode) + "|" + i2s(baseType) + "|" +
     i2s(scoreNorm) + "|" + i2s(scoreMask) + "|" +
     i2s(fm) + "|" + i2s(fr) + "|" +
     i2s(volRegime) + "|" +
     f2s(nz(atrMult, 0)) + "|" + f2s(nz(entryAtr, 0)) + "|" +
     i2s(nz(riskTicks, 0)) + "|" + i2s(nz(zoneWidthTicks, 0)) + "|" +
     i2s(nz(touchCount, 0)) + "|" + i2s(nz(zoneAgeBars, 0)) + "|" +
     f2s(0) + "|" + f2s(0) + "|" +
     f2s(bodyR) + "|" + f2s(wickR)

// ─── v7 (v2): S-Event encoder — adds 4 upstream-emitted ML features ───
// 28 output fields (pos 0-27). Server also derives time_of_day + session from timestamp.
// NEW params vs v1: sweepFlag, trendBias, htfDirection, liquidityDistance
//
// sweepFlag    (pos 24): 1 if a liquidity sweep occurred on this signal bar, else 0
// trendBias    (pos 25): -1 = bearish bias, 0 = neutral, 1 = bullish bias
// htfDirection (pos 26): -1 = HTF downtrend, 0 = ranging, 1 = HTF uptrend
// liquidityDist(pos 27): distance to nearest liquidity level in R-multiples (float)
//                        pass 0.0 if not available
//
// Backward compat: server parses pos 24-27 only when n > 24; old senders using
// encode_signal_v1 (24 fields) continue to work with safe defaults on the server.
export encode_signal_v2(int whVer, string tk, string tf, int ts, int dir,
     int zoneCode, int baseType, int scoreNorm, int scoreMask,
     int volRegime, float atrMult, float entryAtr,
     int riskTicks, int zoneWidthTicks,
     int touchCount, int zoneAgeBars,
     float o, float h, float l, float c,
     int sweepFlag, int trendBias, int htfDirection, float liquidityDist) =>
    // Filter masks (same logic as v1)
    int fm = 400
    int fr = 16
    if scoreNorm >= 40
        fr += 128
    if riskTicks >= 4
        fr += 256
    // Candle ratios
    float rng = h - l
    float bodyR = rng > 0 ? math.abs(c - o) / rng : 0.0
    float wickR = rng > 0 ? 1.0 - bodyR : 0.0
    // Encode all 28 fields (pos 0-23 identical to v1, pos 24-27 new)
    hdr(whVer, "S", tk, tf, ts, dir) +
     i2s(zoneCode) + "|" + i2s(baseType) + "|" +
     i2s(scoreNorm) + "|" + i2s(scoreMask) + "|" +
     i2s(fm) + "|" + i2s(fr) + "|" +
     i2s(volRegime) + "|" +
     f2s(nz(atrMult, 0)) + "|" + f2s(nz(entryAtr, 0)) + "|" +
     i2s(nz(riskTicks, 0)) + "|" + i2s(nz(zoneWidthTicks, 0)) + "|" +
     i2s(nz(touchCount, 0)) + "|" + i2s(nz(zoneAgeBars, 0)) + "|" +
     f2s(0) + "|" + f2s(0) + "|" +
     f2s(bodyR) + "|" + f2s(wickR) + "|" +
     i2s(nz(sweepFlag, 0)) + "|" + i2s(nz(trendBias, 0)) + "|" +
     i2s(nz(htfDirection, 0)) + "|" + f2s(nz(liquidityDist, 0.0))
