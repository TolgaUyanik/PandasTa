//@version=6
indicator(
     "FVG MTF — Retest & Liquidity Levels",
     shorttitle = "FVG MTF",
     overlay = true,
     max_boxes_count = 150,
     max_lines_count = 150,
     max_labels_count = 200
)

// =============================================================================
// CORE SETTINGS
// =============================================================================

fvgTf = input.timeframe("15", "FVG timeframe", group = "FVG")
showFvgSourceTimeframe = input.bool(
     true,
     "Show source timeframe in labels",
     group = "FVG"
)
showInvalidatedFvgLabels = input.bool(
     false,
     "Show invalidated FVG labels",
     group = "FVG"
)
fvgLabelPosition = input.string(
     "Right margin",
     "FVG label position",
     options = ["Right margin", "Near price", "Hidden"],
     group = "FVG"
)
fvgLabelOffset = input.int(
     10,
     "FVG label offset",
     minval = 1,
     maxval = 100,
     tooltip = "Number of bars between current price and labels in Right margin mode.",
     group = "FVG"
)
fvgLabelSizeName = input.string(
     "Small",
     "FVG label size",
     options = ["Tiny", "Small", "Normal"],
     group = "FVG"
)
safetyPercent = input.float(
     10.0,
     "Safety zone (% of FVG)",
     minval = 0.0,
     maxval = 100.0,
     step = 1.0,
     group = "FVG"
)

gSessions = "Sessions"
userTimezone = input.string(
     "Asia/Kuala_Lumpur",
     "Your timezone",
     options = [
         "Etc/UTC",
         "Pacific/Honolulu",
         "America/Anchorage",
         "America/Los_Angeles",
         "America/Denver",
         "America/Chicago",
         "America/New_York",
         "America/Toronto",
         "America/Sao_Paulo",
         "Atlantic/Reykjavik",
         "Europe/London",
         "Europe/Paris",
         "Europe/Berlin",
         "Europe/Athens",
         "Africa/Cairo",
         "Africa/Johannesburg",
         "Asia/Dubai",
         "Asia/Kolkata",
         "Asia/Bangkok",
         "Asia/Kuala_Lumpur",
         "Asia/Singapore",
         "Asia/Hong_Kong",
         "Asia/Shanghai",
         "Asia/Tokyo",
         "Asia/Seoul",
         "Australia/Perth",
         "Australia/Adelaide",
         "Australia/Sydney",
         "Pacific/Auckland"
     ],
     tooltip = "Select your location. Session times are converted automatically, including daylight-saving changes.",
     group = gSessions
)
showSessionClock = input.bool(true, "Show converted session times", group = gSessions)
asiaHours = input.session(
     "0800-1500",
     "Asia hours — Tokyo time",
     tooltip = "Reference hours in Asia/Tokyo. The converted hours appear in the session clock.",
     group = gSessions
)
londonHours = input.session(
     "0700-1630",
     "London hours — London time",
     tooltip = "Reference hours in Europe/London. Daylight-saving changes are handled automatically.",
     group = gSessions
)
newYorkHours = input.session(
     "0930-1600",
     "New York hours — New York time",
     tooltip = "Reference hours in America/New_York. Daylight-saving changes are handled automatically.",
     group = gSessions
)

gFvgColors = "Colors — FVG"
bullBorderColor = input.color(#2962FF, "Bullish — border", group = gFvgColors)
bullFillColor = input.color(color.new(#2962FF, 88), "Bullish — fill", group = gFvgColors)
bullRemainingColor = input.color(color.new(#2962FF, 68), "Bullish — unfilled area", group = gFvgColors)
bullLabelColor = input.color(#2962FF, "Bullish — label", group = gFvgColors)
bearBorderColor = input.color(#FF6D00, "Bearish — border", group = gFvgColors)
bearFillColor = input.color(color.new(#FF6D00, 88), "Bearish — fill", group = gFvgColors)
bearRemainingColor = input.color(color.new(#FF6D00, 68), "Bearish — unfilled area", group = gFvgColors)
bearLabelColor = input.color(#FF6D00, "Bearish — label", group = gFvgColors)
safetyBorderColor = input.color(#7E57C2, "Safety — border", group = gFvgColors)
safetyFillColor = input.color(color.new(#7E57C2, 82), "Safety — fill", group = gFvgColors)
fvgTextColor = input.color(color.white, "FVG text", group = gFvgColors)

gSignalColors = "Colors — Signals"
buySignalColor = input.color(#00C853, "BUY", group = gSignalColors)
sellSignalColor = input.color(#D50000, "SELL", group = gSignalColors)
signalTextColor = input.color(color.white, "BUY / SELL text", group = gSignalColors)

gLevelColors = "Colors — Levels"
bslLevelColor = input.color(#00BFA5, "BSL", group = gLevelColors)
sslLevelColor = input.color(#26A69A, "SSL", group = gLevelColors)
asiaHighColor = input.color(#42A5F5, "Asia High", group = gLevelColors)
asiaLowColor = input.color(#1E88E5, "Asia Low", group = gLevelColors)
londonHighColor = input.color(#AB47BC, "London High", group = gLevelColors)
londonLowColor = input.color(#8E24AA, "London Low", group = gLevelColors)
newYorkHighColor = input.color(#EF5350, "New York High", group = gLevelColors)
newYorkLowColor = input.color(#E53935, "New York Low", group = gLevelColors)
pdhLevelColor = input.color(#FFC107, "PDH", group = gLevelColors)
pdlLevelColor = input.color(#00BCD4, "PDL", group = gLevelColors)
levelTextColor = input.color(color.white, "Level text", group = gLevelColors)
sweptLevelColor = input.color(color.new(color.gray, 70), "Swept level", group = gLevelColors)

gLevelLabels = "Liquidity labels"
levelLabelOffset = input.int(
     4,
     "Base offset",
     minval = 1,
     maxval = 50,
     tooltip = "Base distance, in bars, between current price and active liquidity labels.",
     group = gLevelLabels
)
levelLabelLaneSpacing = input.int(
     3,
     "Lane spacing",
     minval = 1,
     maxval = 20,
     tooltip = "Horizontal spacing between pivot, session and daily-level label columns.",
     group = gLevelLabels
)
levelLabelSizeName = input.string(
     "Small",
     "Label size",
     options = ["Tiny", "Small", "Normal"],
     group = gLevelLabels
)
showSweptPivotLabels = input.bool(
     false,
     "Show swept BSL / SSL labels",
     tooltip = "This setting applies only to BSL and SSL. Session levels and PDH/PDL always remain visible.",
     group = gLevelLabels
)

gStateColors = "Colors — States"
invalidBorderColor = input.color(color.gray, "Invalid FVG — border", group = gStateColors)
invalidFillColor = input.color(color.new(color.gray, 88), "Invalid FVG — fill", group = gStateColors)
invalidLabelColor = input.color(color.new(color.gray, 20), "Invalid FVG — label", group = gStateColors)
invalidTextColor = input.color(color.white, "Invalid FVG — text", group = gStateColors)
warningColor = input.color(color.red, "Timeframe warning", group = gStateColors)
warningTextColor = input.color(color.white, "Warning text", group = gStateColors)

gClockColors = "Colors — Session clock"
clockHeaderColor = input.color(color.new(color.black, 0), "Header", group = gClockColors)
clockBackgroundColor = input.color(color.new(color.black, 20), "Background", group = gClockColors)
clockTextColor = input.color(color.white, "Text", group = gClockColors)

gSessionOverlays = "Colors — Session overlays"
showAsiaOverlay = input.bool(true, "Show Asia overlay", group = gSessionOverlays)
asiaOverlayColor = input.color(
     color.new(#2962FF, 88),
     "Asia overlay",
     tooltip = "Use the color selector to adjust both color and transparency.",
     group = gSessionOverlays
)
showLondonOverlay = input.bool(true, "Show London overlay", group = gSessionOverlays)
londonOverlayColor = input.color(
     color.new(#795548, 88),
     "London overlay",
     tooltip = "Use the color selector to adjust both color and transparency.",
     group = gSessionOverlays
)
showNewYorkOverlay = input.bool(true, "Show New York overlay", group = gSessionOverlays)
newYorkOverlayColor = input.color(
     color.new(#D32F2F, 88),
     "New York overlay",
     tooltip = "Use the color selector to adjust both color and transparency.",
     group = gSessionOverlays
)

// Pivots are used only to identify confirmed SSL and BSL prices.
int pivotStrength = 3
int maximumStoredLiquidity = 120
int maximumStoredFvgs = 20

chartTfSeconds = timeframe.in_seconds()
fvgTfSeconds = timeframe.in_seconds(fvgTf)
canRun = timeframe.isintraday and chartTfSeconds <= fvgTfSeconds

f_formatTimeframe(int timeframeSeconds, string rawTimeframe) =>
    timeframeMinutes = int(timeframeSeconds / 60)
    timeframeHours = int(timeframeSeconds / 3600)
    timeframeDays = int(timeframeSeconds / 86400)
    timeframeWeeks = int(timeframeSeconds / 604800)

    if timeframeSeconds < 60
        "S" + str.tostring(timeframeSeconds)
    else if timeframeSeconds < 3600
        "M" + str.tostring(timeframeMinutes)
    else if timeframeSeconds < 86400 and timeframeSeconds % 3600 == 0
        "H" + str.tostring(timeframeHours)
    else if timeframeSeconds < 86400
        "M" + str.tostring(timeframeMinutes)
    else if timeframeSeconds % 604800 == 0
        "W" + str.tostring(timeframeWeeks)
    else if timeframeSeconds % 86400 == 0
        "D" + str.tostring(timeframeDays)
    else
        rawTimeframe

fvgSourceName = f_formatTimeframe(fvgTfSeconds, fvgTf)
fvgLabelPrefix = showFvgSourceTimeframe ? fvgSourceName + " FVG" : "FVG"
fvgLabelSize = fvgLabelSizeName == "Tiny"
     ? size.tiny
     : fvgLabelSizeName == "Normal"
         ? size.normal
         : size.small
levelLabelSize = levelLabelSizeName == "Tiny"
     ? size.tiny
     : levelLabelSizeName == "Normal"
         ? size.normal
         : size.small

// =============================================================================
// LIQUIDITY LEVELS
// =============================================================================

// side: 1 = liquidity above price (BSL / High), -1 = liquidity below price.
// Session levels remain visible until the next level from the same session replaces them.
var array<float> liquidityPrice = array.new_float()
var array<int> liquiditySide = array.new_int()
var array<int> liquidityLabelLane = array.new_int()
var array<string> liquidityName = array.new_string()
var array<bool> liquidityUntouched = array.new_bool()
var array<line> liquidityLine = array.new_line()
var array<label> liquidityLabel = array.new_label()

f_levelColor(string name) =>
    name == "BSL"
         ? bslLevelColor
         : name == "SSL"
             ? sslLevelColor
             : name == "Asia High"
                 ? asiaHighColor
                 : name == "Asia Low"
                     ? asiaLowColor
                     : name == "London High"
                         ? londonHighColor
                         : name == "London Low"
                             ? londonLowColor
                             : name == "New York High"
                                 ? newYorkHighColor
                                 : newYorkLowColor

f_levelLane(string name) =>
    name == "BSL" or name == "SSL"
         ? 0
         : name == "Asia High" or name == "Asia Low"
             ? 1
             : name == "London High" or name == "London Low"
                 ? 2
                 : 3

f_levelAlwaysVisible(string name) =>
    name != "BSL" and name != "SSL"

f_registerLiquidity(float price, int side, string name, int startTime) =>
    if not na(price) and not na(startTime)
        if f_levelAlwaysVisible(name) and array.size(liquidityPrice) > 0
            int existingIndex = -1

            for i = 0 to array.size(liquidityPrice) - 1
                if array.get(liquidityName, i) == name
                    existingIndex := i

            if existingIndex >= 0
                array.remove(liquidityPrice, existingIndex)
                array.remove(liquiditySide, existingIndex)
                array.remove(liquidityLabelLane, existingIndex)
                array.remove(liquidityName, existingIndex)
                array.remove(liquidityUntouched, existingIndex)
                replacedLine = array.remove(liquidityLine, existingIndex)
                replacedLabel = array.remove(liquidityLabel, existingIndex)

                if not na(replacedLine)
                    line.delete(replacedLine)
                if not na(replacedLabel)
                    label.delete(replacedLabel)

        if array.size(liquidityPrice) >= maximumStoredLiquidity
            int removalIndex = 0

            for i = 0 to array.size(liquidityPrice) - 1
                if not f_levelAlwaysVisible(array.get(liquidityName, i))
                    removalIndex := i
                    break

            array.remove(liquidityPrice, removalIndex)
            array.remove(liquiditySide, removalIndex)
            array.remove(liquidityLabelLane, removalIndex)
            array.remove(liquidityName, removalIndex)
            array.remove(liquidityUntouched, removalIndex)
            oldLine = array.remove(liquidityLine, removalIndex)
            oldLabel = array.remove(liquidityLabel, removalIndex)
            if not na(oldLine)
                line.delete(oldLine)
            if not na(oldLabel)
                label.delete(oldLabel)

        levelColor = f_levelColor(name)
        labelLane = f_levelLane(name)
        newLine = line.new(
             x1 = startTime,
             y1 = price,
             x2 = time_close,
             y2 = price,
             xloc = xloc.bar_time,
             extend = extend.right,
             color = levelColor,
             width = 1,
             style = line.style_dashed
        )
        newLabel = label.new(
             x = bar_index + levelLabelOffset + labelLane * levelLabelLaneSpacing,
             y = price,
             text = name + " · " + str.tostring(price, format.mintick),
             color = levelColor,
             textcolor = levelTextColor,
             style = label.style_label_left,
             size = levelLabelSize
        )

        array.push(liquidityPrice, price)
        array.push(liquiditySide, side)
        array.push(liquidityLabelLane, labelLane)
        array.push(liquidityName, name)
        array.push(liquidityUntouched, true)
        array.push(liquidityLine, newLine)
        array.push(liquidityLabel, newLabel)

f_sessionDurationMinutes(string sessionHours) =>
    startHour = int(str.tonumber(str.substring(sessionHours, 0, 2)))
    startMinute = int(str.tonumber(str.substring(sessionHours, 2, 4)))
    endHour = int(str.tonumber(str.substring(sessionHours, 5, 7)))
    endMinute = int(str.tonumber(str.substring(sessionHours, 7, 9)))
    startTotal = startHour * 60 + startMinute
    endTotal = endHour * 60 + endMinute
    endTotal > startTotal ? endTotal - startTotal : 1440 - startTotal + endTotal

f_localSessionWindow(int sessionStart, string sessionHours) =>
    if na(sessionStart)
        "Waiting for data"
    else
        durationMilliseconds = f_sessionDurationMinutes(sessionHours) * 60 * 1000
        str.format_time(sessionStart, "HH:mm", userTimezone) + "–" +
             str.format_time(sessionStart + durationMilliseconds, "HH:mm", userTimezone)

// =============================================================================
// SESSION HIGHS AND LOWS
// =============================================================================

inAsia = canRun and not na(time(timeframe.period, asiaHours, "Asia/Tokyo"))
inLondon = canRun and not na(time(timeframe.period, londonHours, "Europe/London"))
inNewYork = canRun and not na(time(timeframe.period, newYorkHours, "America/New_York"))

bgcolor(
     showAsiaOverlay and inAsia ? asiaOverlayColor : na,
     title = "Asia session overlay"
)
bgcolor(
     showLondonOverlay and inLondon ? londonOverlayColor : na,
     title = "London session overlay"
)
bgcolor(
     showNewYorkOverlay and inNewYork ? newYorkOverlayColor : na,
     title = "New York session overlay"
)

asiaBegins = inAsia and not inAsia[1]
asiaFinishes = not inAsia and inAsia[1]
londonBegins = inLondon and not inLondon[1]
londonFinishes = not inLondon and inLondon[1]
newYorkBegins = inNewYork and not inNewYork[1]
newYorkFinishes = not inNewYork and inNewYork[1]

var float asiaHigh = na
var float asiaLow = na
var float londonHigh = na
var float londonLow = na
var float newYorkHigh = na
var float newYorkLow = na
var int asiaStartTime = na
var int londonStartTime = na
var int newYorkStartTime = na
var int mostRecentAsiaStart = na
var int mostRecentLondonStart = na
var int mostRecentNewYorkStart = na

if asiaBegins
    asiaHigh := high
    asiaLow := low
    asiaStartTime := time
    mostRecentAsiaStart := time
else if inAsia
    asiaHigh := math.max(asiaHigh, high)
    asiaLow := math.min(asiaLow, low)

if asiaFinishes
    f_registerLiquidity(asiaHigh, 1, "Asia High", asiaStartTime)
    f_registerLiquidity(asiaLow, -1, "Asia Low", asiaStartTime)
    asiaHigh := na
    asiaLow := na
    asiaStartTime := na

if londonBegins
    londonHigh := high
    londonLow := low
    londonStartTime := time
    mostRecentLondonStart := time
else if inLondon
    londonHigh := math.max(londonHigh, high)
    londonLow := math.min(londonLow, low)

if londonFinishes
    f_registerLiquidity(londonHigh, 1, "London High", londonStartTime)
    f_registerLiquidity(londonLow, -1, "London Low", londonStartTime)
    londonHigh := na
    londonLow := na
    londonStartTime := na

if newYorkBegins
    newYorkHigh := high
    newYorkLow := low
    newYorkStartTime := time
    mostRecentNewYorkStart := time
else if inNewYork
    newYorkHigh := math.max(newYorkHigh, high)
    newYorkLow := math.min(newYorkLow, low)

if newYorkFinishes
    f_registerLiquidity(newYorkHigh, 1, "New York High", newYorkStartTime)
    f_registerLiquidity(newYorkLow, -1, "New York Low", newYorkStartTime)
    newYorkHigh := na
    newYorkLow := na
    newYorkStartTime := na

var table sessionClock = table.new(
     position.top_right,
     2,
     4,
     border_width = 1
)

if barstate.islast
    if showSessionClock
        table.cell(
             sessionClock,
             0,
             0,
             "SESSION",
             text_color = clockTextColor,
             bgcolor = clockHeaderColor
        )
        table.cell(
             sessionClock,
             1,
             0,
             userTimezone,
             text_color = clockTextColor,
             bgcolor = clockHeaderColor
        )
        table.cell(
             sessionClock,
             0,
             1,
             "Asia",
             text_color = clockTextColor,
             bgcolor = color.new(asiaHighColor, 55)
        )
        table.cell(
             sessionClock,
             1,
             1,
             f_localSessionWindow(mostRecentAsiaStart, asiaHours),
             text_color = clockTextColor,
             bgcolor = clockBackgroundColor
        )
        table.cell(
             sessionClock,
             0,
             2,
             "London",
             text_color = clockTextColor,
             bgcolor = color.new(londonHighColor, 55)
        )
        table.cell(
             sessionClock,
             1,
             2,
             f_localSessionWindow(mostRecentLondonStart, londonHours),
             text_color = clockTextColor,
             bgcolor = clockBackgroundColor
        )
        table.cell(
             sessionClock,
             0,
             3,
             "New York",
             text_color = clockTextColor,
             bgcolor = color.new(newYorkHighColor, 55)
        )
        table.cell(
             sessionClock,
             1,
             3,
             f_localSessionWindow(mostRecentNewYorkStart, newYorkHours),
             text_color = clockTextColor,
             bgcolor = clockBackgroundColor
        )
    else
        table.clear(sessionClock, 0, 0, 1, 3)

// =============================================================================
// CONFIRMED PDH / PDL
// =============================================================================

pdh = request.security(
     syminfo.tickerid,
     "D",
     high[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

pdl = request.security(
     syminfo.tickerid,
     "D",
     low[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

newDay = ta.change(time("D")) != 0

var line pdhLine = na
var line pdlLine = na
var label pdhLabel = na
var label pdlLabel = na

if barstate.isfirst or newDay
    if not na(pdhLine)
        line.delete(pdhLine)
    if not na(pdlLine)
        line.delete(pdlLine)
    if not na(pdhLabel)
        label.delete(pdhLabel)
    if not na(pdlLabel)
        label.delete(pdlLabel)

    pdhLine := canRun and not na(pdh)
         ? line.new(time, pdh, time_close, pdh, xloc = xloc.bar_time, extend = extend.right, color = pdhLevelColor, style = line.style_dashed)
         : na
    pdlLine := canRun and not na(pdl)
         ? line.new(time, pdl, time_close, pdl, xloc = xloc.bar_time, extend = extend.right, color = pdlLevelColor, style = line.style_dashed)
         : na
    pdhLabel := canRun and not na(pdh)
         ? label.new(bar_index + levelLabelOffset + 4 * levelLabelLaneSpacing, pdh, "PDH · " + str.tostring(pdh, format.mintick), color = pdhLevelColor, textcolor = levelTextColor, style = label.style_label_left, size = levelLabelSize)
         : na
    pdlLabel := canRun and not na(pdl)
         ? label.new(bar_index + levelLabelOffset + 4 * levelLabelLaneSpacing, pdl, "PDL · " + str.tostring(pdl, format.mintick), color = pdlLevelColor, textcolor = levelTextColor, style = label.style_label_left, size = levelLabelSize)
         : na

if canRun
    if not na(pdhLabel)
        label.set_x(
             pdhLabel,
             bar_index + levelLabelOffset + 4 * levelLabelLaneSpacing
        )
    if not na(pdlLabel)
        label.set_x(
             pdlLabel,
             bar_index + levelLabelOffset + 4 * levelLabelLaneSpacing
        )

// =============================================================================
// CONFIRMED SSL / BSL ON THE FVG TIMEFRAME
// =============================================================================

[pivotHighPrice, pivotHighTime, pivotLowPrice, pivotLowTime] = request.security(
     syminfo.tickerid,
     fvgTf,
     [ta.pivothigh(high, pivotStrength, pivotStrength),
         not na(ta.pivothigh(high, pivotStrength, pivotStrength)) ? time[pivotStrength] : na,
         ta.pivotlow(low, pivotStrength, pivotStrength),
         not na(ta.pivotlow(low, pivotStrength, pivotStrength)) ? time[pivotStrength] : na
     ],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

newBsl = canRun and not na(pivotHighTime) and (
     na(pivotHighTime[1]) or pivotHighTime != pivotHighTime[1]
)

newSsl = canRun and not na(pivotLowTime) and (
     na(pivotLowTime[1]) or pivotLowTime != pivotLowTime[1]
)

if newBsl
    f_registerLiquidity(pivotHighPrice, 1, "BSL", pivotHighTime)

if newSsl
    f_registerLiquidity(pivotLowPrice, -1, "SSL", pivotLowTime)

// BSL and SSL stop extending after their first sweep.
// Session highs and lows remain visible until their next completed session replaces them.
if canRun and array.size(liquidityPrice) > 0
    for i = 0 to array.size(liquidityPrice) - 1
        if array.get(liquidityUntouched, i)
            level = array.get(liquidityPrice, i)
            side = array.get(liquiditySide, i)
            labelLane = array.get(liquidityLabelLane, i)
            levelName = array.get(liquidityName, i)
            levelLine = array.get(liquidityLine, i)
            levelLabel = array.get(liquidityLabel, i)

            if not na(levelLabel)
                label.set_x(
                     levelLabel,
                     bar_index + levelLabelOffset + labelLane * levelLabelLaneSpacing
                )

            swept = not f_levelAlwaysVisible(levelName) and (
                 side == 1 ? high >= level : low <= level
            )

            if swept
                array.set(liquidityUntouched, i, false)
                if not na(levelLine)
                    line.set_extend(levelLine, extend.none)
                    line.set_x2(levelLine, time_close)
                    line.set_color(levelLine, sweptLevelColor)
                if not na(levelLabel)
                    if showSweptPivotLabels
                        label.set_x(levelLabel, bar_index)
                        label.set_color(levelLabel, sweptLevelColor)
                    else
                        label.delete(levelLabel)
                        array.set(liquidityLabel, i, na)

// =============================================================================
// FVG VISUAL STATE
// =============================================================================

var array<int> gapDirection = array.new_int()
var array<float> gapTop = array.new_float()
var array<float> gapBottom = array.new_float()
var array<float> gapSafetyEdge = array.new_float()
var array<float> gapDeepestWick = array.new_float()
var array<bool> gapIsActive = array.new_bool()
var array<bool> gapWasRetested = array.new_bool()

var array<box> gapOutline = array.new_box()
var array<box> gapRemaining = array.new_box()
var array<box> gapSafety = array.new_box()
var array<label> gapStatus = array.new_label()

var array<label> gapSignalLabel = array.new_label()

f_deleteBox(box id) =>
    if not na(id)
        box.delete(id)

f_deleteLabel(label id) =>
    if not na(id)
        label.delete(id)

f_removeOldestFvg() =>
    array.shift(gapDirection)
    array.shift(gapTop)
    array.shift(gapBottom)
    array.shift(gapSafetyEdge)
    array.shift(gapDeepestWick)
    array.shift(gapIsActive)
    array.shift(gapWasRetested)

    f_deleteBox(array.shift(gapOutline))
    f_deleteBox(array.shift(gapRemaining))
    f_deleteBox(array.shift(gapSafety))
    f_deleteLabel(array.shift(gapStatus))

    f_deleteLabel(array.shift(gapSignalLabel))

f_addFvg(
     int direction,
     float top,
     float bottom,
     int originTime,
     int confirmationTime
) =>
    if array.size(gapDirection) >= maximumStoredFvgs
        f_removeOldestFvg()

    gapSize = top - bottom
    safetySize = gapSize * safetyPercent / 100.0
    safetyEdge = direction == 1 ? bottom - safetySize : top + safetySize
    borderColor = direction == 1 ? bullBorderColor : bearBorderColor
    fillColor = direction == 1 ? bullFillColor : bearFillColor
    remainingColor = direction == 1 ? bullRemainingColor : bearRemainingColor
    statusColor = direction == 1 ? bullLabelColor : bearLabelColor

    outline = box.new(
         left = originTime,
         top = top,
         right = confirmationTime,
         bottom = bottom,
         xloc = xloc.bar_time,
         extend = extend.right,
         border_color = borderColor,
         border_width = 1,
         bgcolor = fillColor
    )

    remaining = box.new(
         left = originTime,
         top = top,
         right = confirmationTime,
         bottom = bottom,
         xloc = xloc.bar_time,
         extend = extend.right,
         border_color = color.new(borderColor, 100),
         bgcolor = remainingColor
    )

    safetyTop = direction == 1 ? bottom : safetyEdge
    safetyBottom = direction == 1 ? safetyEdge : top

    safety = box.new(
         left = originTime,
         top = safetyTop,
         right = confirmationTime,
         bottom = safetyBottom,
         xloc = xloc.bar_time,
         extend = extend.right,
         border_color = safetyBorderColor,
         border_width = 1,
         bgcolor = safetyFillColor
    )

    label status = na

    if fvgLabelPosition != "Hidden"
        statusX = bar_index + (fvgLabelPosition == "Right margin" ? fvgLabelOffset : 1)
        statusStyle = fvgLabelPosition == "Right margin"
             ? label.style_label_left
             : direction == 1
                 ? label.style_label_up
                 : label.style_label_down

        status := label.new(
             x = statusX,
             y = safetyEdge,
             text = fvgLabelPrefix + (direction == 1 ? " ↑ · 0%" : " ↓ · 0%"),
             color = statusColor,
             textcolor = fvgTextColor,
             style = statusStyle,
             size = fvgLabelSize
        )

    array.push(gapDirection, direction)
    array.push(gapTop, top)
    array.push(gapBottom, bottom)
    array.push(gapSafetyEdge, safetyEdge)
    array.push(gapDeepestWick, na)
    array.push(gapIsActive, true)
    array.push(gapWasRetested, false)

    array.push(gapOutline, outline)
    array.push(gapRemaining, remaining)
    array.push(gapSafety, safety)
    array.push(gapStatus, status)

    array.push(gapSignalLabel, na)

// =============================================================================
// CONFIRMED FVG DETECTION
// =============================================================================

[confirmedFvgBarTime, confirmedFvgBarClose, bullishFvg, bullishTop, bullishBottom, bearishFvg, bearishTop, bearishBottom] = request.security(
     syminfo.tickerid,
     fvgTf,
     [time[1],
         time_close[1],
         low[1] > high[3],
         low[1],
         high[3],
         high[1] < low[3],
         low[3],
         high[1]
     ],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

newConfirmedFvgBar = not na(confirmedFvgBarTime) and (
     na(confirmedFvgBarTime[1]) or confirmedFvgBarTime != confirmedFvgBarTime[1]
)

if canRun and newConfirmedFvgBar
    if bullishFvg and bullishTop > bullishBottom
        f_addFvg(1, bullishTop, bullishBottom, confirmedFvgBarTime, confirmedFvgBarClose)

    if bearishFvg and bearishTop > bearishBottom
        f_addFvg(-1, bearishTop, bearishBottom, confirmedFvgBarTime, confirmedFvgBarClose)

// =============================================================================
// WICK RETRACEMENT, SAFETY ZONE AND RETEST SIGNAL
// =============================================================================

if canRun and array.size(gapDirection) > 0
    for i = 0 to array.size(gapDirection) - 1
        if array.get(gapIsActive, i)
            direction = array.get(gapDirection, i)
            top = array.get(gapTop, i)
            bottom = array.get(gapBottom, i)
            safetyEdge = array.get(gapSafetyEdge, i)
            deepest = array.get(gapDeepestWick, i)
            status = array.get(gapStatus, i)
            remaining = array.get(gapRemaining, i)
            gapSize = top - bottom

            enteredCore = low <= top and high >= bottom

            if direction == 1 and low <= top
                deepest := na(deepest) ? low : math.min(deepest, low)
                array.set(gapDeepestWick, i, deepest)

                remainingTop = math.max(bottom, math.min(top, deepest))
                box.set_top(remaining, remainingTop)
                box.set_bottom(remaining, bottom)

            if direction == -1 and high >= bottom
                deepest := na(deepest) ? high : math.max(deepest, high)
                array.set(gapDeepestWick, i, deepest)

                remainingBottom = math.min(top, math.max(bottom, deepest))
                box.set_top(remaining, top)
                box.set_bottom(remaining, remainingBottom)

            if not na(deepest)
                retracement = direction == 1
                     ? (top - deepest) / gapSize
                     : (deepest - bottom) / gapSize
                retracement := math.max(0.0, retracement)

                if not na(status)
                    label.set_text(
                         status,
                         fvgLabelPrefix + (direction == 1 ? " ↑ · " : " ↓ · ") +
                             str.tostring(retracement * 100.0, "#.0") + "%"
                    )

            invalidated = direction == 1 ? low <= safetyEdge : high >= safetyEdge

            if invalidated
                array.set(gapIsActive, i, false)

                outline = array.get(gapOutline, i)
                safety = array.get(gapSafety, i)

                box.set_extend(outline, extend.none)
                box.set_right(outline, time_close)
                box.set_extend(remaining, extend.none)
                box.set_right(remaining, time_close)
                box.set_extend(safety, extend.none)
                box.set_right(safety, time_close)

                box.set_border_color(outline, invalidBorderColor)
                box.set_bgcolor(outline, invalidFillColor)
                box.set_bgcolor(remaining, invalidFillColor)
                box.set_border_color(safety, invalidBorderColor)
                box.set_bgcolor(safety, invalidFillColor)

                if not na(status)
                    if showInvalidatedFvgLabels
                        label.set_x(status, bar_index)
                        label.set_y(status, safetyEdge)
                        label.set_style(
                             status,
                             direction == 1
                                 ? label.style_label_up
                                 : label.style_label_down
                        )
                        label.set_text(status, fvgLabelPrefix + " INVALIDATED")
                        label.set_color(status, invalidLabelColor)
                        label.set_textcolor(status, invalidTextColor)
                    else
                        label.delete(status)
                        array.set(gapStatus, i, na)

            else
                if not na(status)
                    label.set_x(
                         status,
                         bar_index + (fvgLabelPosition == "Right margin" ? fvgLabelOffset : 1)
                    )
                    label.set_y(status, safetyEdge)

                if enteredCore and not array.get(gapWasRetested, i)
                    array.set(gapWasRetested, i, true)

                    signal = label.new(
                         x = bar_index,
                         y = direction == 1 ? low : high,
                         text = (direction == 1 ? "BUY" : "SELL") +
                             (showFvgSourceTimeframe ? " · " + fvgSourceName + " FVG" : ""),
                         color = direction == 1 ? buySignalColor : sellSignalColor,
                         textcolor = signalTextColor,
                         style = direction == 1 ? label.style_label_up : label.style_label_down,
                         size = size.small
                    )
                    array.set(gapSignalLabel, i, signal)

// =============================================================================
// MESSAGE WHEN THE CHART TIMEFRAME IS ABOVE THE FVG TIMEFRAME
// =============================================================================

var label timeframeMessage = na

if barstate.islast
    if not canRun
        message = "Use a chart timeframe equal to or lower than " + fvgTf

        if na(timeframeMessage)
            timeframeMessage := label.new(
                 bar_index,
                 high,
                 message,
                 color = warningColor,
                 textcolor = warningTextColor,
                 style = label.style_label_down,
                 size = size.small
            )
        else
            label.set_xy(timeframeMessage, bar_index, high)
            label.set_text(timeframeMessage, message)
    else if not na(timeframeMessage)
        label.delete(timeframeMessage)
        timeframeMessage := na
