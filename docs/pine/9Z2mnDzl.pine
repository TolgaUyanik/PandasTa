//@version=6
library("matrixCore")

// ═══════════════════════════════════════════════════════════════════════════════
// 📊 TYPES DE DONNÉES
// ═══════════════════════════════════════════════════════════════════════════════

export type StateConfig
    int kijunPattern
    int emaPattern
    int pricePos
    int compression
    int candleType
    int emaSlope
    bool tfHigherBullish
    bool tfLowerBullish
    bool redRejection
    int hash

export type BarSnapshot
    int barIndex
    float openPrice
    float highPrice
    float lowPrice
    float closePrice
    float atr
    float emaFast
    int stateHash
    int kijunPattern
    int emaPattern
    int pricePos
    int compression
    int candleType
    int emaSlope
    bool tfHigherBullish
    bool tfLowerBullish
    bool redRejection

// ═══════════════════════════════════════════════════════════════════════════════
// 🕯️ CANDLE ANALYSIS
// ═══════════════════════════════════════════════════════════════════════════════

export analyzeCandleStructure(float o, float h, float l, float c, float atr, float smallBodyThreshold, float longWickRatio) =>
    float body = math.abs(c - o)
    float upperWick = h - math.max(o, c)
    float lowerWick = math.min(o, c) - l
    float bodyPctATR = (body / atr) * 100
    float upperWickRatio = body > 0 ? upperWick / body : 0
    float lowerWickRatio = body > 0 ? lowerWick / body : 0
    bool isSmallBody = bodyPctATR < smallBodyThreshold
    int candleType = 3
    if isSmallBody
        if upperWickRatio > longWickRatio and upperWick > lowerWick
            candleType := 0
        else if lowerWickRatio > longWickRatio and lowerWick > upperWick
            candleType := 1
    else
        if body > (upperWick + lowerWick)
            candleType := 2
    candleType

export isRedRejectionCandle(float o, float l, float c, float redRejectionWickMin) =>
    bool isRed = c < o
    float body = math.abs(c - o)
    float lowerWick = math.min(o, c) - l
    float lowerWickRatio = body > 0 ? lowerWick / body : 0
    isRed and lowerWickRatio >= redRejectionWickMin

// ═══════════════════════════════════════════════════════════════════════════════
// 🔍 PATTERN DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

export isEqual(float a, float b, float tol) =>
    math.abs(a - b) <= tol

export detectPattern(float kf, float km, float ks, float tol) =>
    bool fEqM = isEqual(kf, km, tol)
    bool fEqS = isEqual(kf, ks, tol)
    bool mEqS = isEqual(km, ks, tol)
    int result = 12
    if fEqM and fEqS and mEqS
        result := 12
    else if fEqM and kf > ks
        result := 6
    else if fEqM and kf < ks
        result := 10
    else if fEqS and kf > km
        result := 7
    else if fEqS and km > kf
        result := 11
    else if mEqS and kf > km
        result := 9
    else if mEqS and kf < km
        result := 8
    else if kf > km and km > ks
        result := 0
    else if kf > ks and ks > km
        result := 1
    else if km > kf and kf > ks
        result := 2
    else if km > ks and ks > kf
        result := 3
    else if ks > kf and kf > km
        result := 4
    else if ks > km and km > kf
        result := 5
    result

// ═══════════════════════════════════════════════════════════════════════════════
// 📊 STATE HASH
// ═══════════════════════════════════════════════════════════════════════════════

export calculateStateHash(int kp, int ep, int pp, int comp, int cType, int slope, bool tfH, bool tfL, bool redRej) =>
    int hash = kp * 100000000 + ep * 1000000 + pp * 100000 + comp * 10000 + cType * 1000 + slope * 100 + (tfH ? 10 : 0) + (tfL ? 1 : 0) + (redRej ? 100000000 : 0)
    hash

export createStateConfig(int kp, int ep, int pp, int comp, int cType, int slope, bool tfH, bool tfL, bool redRej, int hash) =>
    StateConfig cfg = StateConfig.new()
    cfg.kijunPattern := kp
    cfg.emaPattern := ep
    cfg.pricePos := pp
    cfg.compression := comp
    cfg.candleType := cType
    cfg.emaSlope := slope
    cfg.tfHigherBullish := tfH
    cfg.tfLowerBullish := tfL
    cfg.redRejection := redRej
    cfg.hash := hash
    cfg

export createBarSnapshot(int barIdx, float o, float h, float l, float c, float atr, float ema, int stateHash, int kp, int ep, int pp, int comp, int cType, int slope, bool tfH, bool tfL, bool redRej) =>
    BarSnapshot snap = BarSnapshot.new()
    snap.barIndex := barIdx
    snap.openPrice := o
    snap.highPrice := h
    snap.lowPrice := l
    snap.closePrice := c
    snap.atr := atr
    snap.emaFast := ema
    snap.stateHash := stateHash
    snap.kijunPattern := kp
    snap.emaPattern := ep
    snap.pricePos := pp
    snap.compression := comp
    snap.candleType := cType
    snap.emaSlope := slope
    snap.tfHigherBullish := tfH
    snap.tfLowerBullish := tfL
    snap.redRejection := redRej
    snap

// ═══════════════════════════════════════════════════════════════════════════════
// 🎨 STRING FORMATTERS
// ═══════════════════════════════════════════════════════════════════════════════

export stateToString(StateConfig cfg) =>
    string kStr = cfg.kijunPattern == 0 ? "K:B+" : cfg.kijunPattern == 5 ? "K:B-" : cfg.kijunPattern == 12 ? "K:≈" : "K:" + str.tostring(cfg.kijunPattern)
    string eStr = cfg.emaPattern == 0 ? "E:B+" : cfg.emaPattern == 5 ? "E:B-" : cfg.emaPattern == 12 ? "E:≈" : "E:" + str.tostring(cfg.emaPattern)
    string pStr = cfg.pricePos == 2 ? "P:↑" : cfg.pricePos == 0 ? "P:↓" : "P:↔"
    string cStr = cfg.compression == 0 ? "C:⬇" : cfg.compression == 2 ? "C:⬆" : "C:—"
    string ctStr = cfg.candleType == 0 ? "🕯↓" : cfg.candleType == 1 ? "🕯↑" : cfg.candleType == 2 ? "🕯█" : "🕯·"
    string sStr = cfg.emaSlope == 2 ? "S↗" : cfg.emaSlope == 0 ? "S↘" : "S→"
    string tfhStr = cfg.tfHigherBullish ? "H✓" : "H✗"
    string tflStr = cfg.tfLowerBullish ? "L✓" : "L✗"
    string redStr = cfg.redRejection ? "🔴" : ""
    string result = kStr + " " + eStr + " " + pStr + " " + cStr + " " + ctStr + " " + sStr + " " + tfhStr + " " + tflStr
    if redStr != ""
        result := result + " " + redStr
    result

// ═══════════════════════════════════════════════════════════════════════════════
// 🎨 HELPERS
// ═══════════════════════════════════════════════════════════════════════════════

export getTablePosition(string pos) =>
    string result = position.middle_center
    if pos == "Top Left"
        result := position.top_left
    else if pos == "Top Center"
        result := position.top_center
    else if pos == "Top Right"
        result := position.top_right
    else if pos == "Middle Left"
        result := position.middle_left
    else if pos == "Middle Right"
        result := position.middle_right
    else if pos == "Bottom Left"
        result := position.bottom_left
    else if pos == "Bottom Center"
        result := position.bottom_center
    else if pos == "Bottom Right"
        result := position.bottom_right
    result

export getGradientColor(float value, float minVal, float maxVal) =>
    float normalized = maxVal > minVal ? (value - minVal) / (maxVal - minVal) : 0.5
    normalized := math.max(0, math.min(1, normalized))
    color result = color.gray
    if normalized >= 0.75
        result := color.new(#00FF00, 70)
    else if normalized >= 0.5
        result := color.new(#7FFF00, 70)
    else if normalized >= 0.25
        result := color.new(#FFD700, 70)
    else
        result := color.new(#FF4500, 70)
    result