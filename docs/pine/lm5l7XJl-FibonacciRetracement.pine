//@version=6
library("FibonacciRetracement")

import mickes/PriceAction/1

//@type Holds all the values for 'TrendlineSettings'.
//@field Enabled If the trendli‌ne should be visible or not.
//@field Color The color of the trendli‌ne.
//@field Style The style of the trendli‌ne (as a string).
export type TrendlineSettings
    bool Enabled
    color Color
    string Style
//@type Holds all the values for 'GenericZonesSettings', that will be applicable to all drawn objects.
//@field ExtendRight If all lines should extend to the right or not.
//@field Style The style of all drawn lines
//@field Reverse If true, all lines will be reversed.
//@field Prices If price levels should be shown or not.
//@field Levels If levels should be shown or not.
//@field LevelsValue Either 'Value' or 'Percent'. Defined if value or percentage should be shown.
//@field FontSize The for size of the text in labels drawn.
//@field LabelsPosition Coul be 'Left', 'Rigth' or 'Adapt'. 'Adapt' will try to adapt the labels position to the prices.
export type GenericZonesSettings
    bool ExtendRight
    string Style
    bool Reverse
    bool Prices
    bool Levels
    string LevelsValue
    int FontSize
    string LabelsPosition
//@type Holds all the values for 'ZoneSettings'.
//@field Enabled If this zone is enabled or not.
//@field Level The level of the zone.
//@field Color The color that will be displayed.
//@field Price The price of the level. Will be set internally.
export type ZoneSettings
    bool Enabled
    float Level
    color Color
    float Price
//@type Holds all the values for 'Settings'.
//@field PivotLeftLength The left length used to find pivots through the 'MarketStructure' library.
//@field PivotRightLength The right length used to find pivots through the 'MarketStructure' library.
//@field Trendline The settings for the 'Trendline' object.
//@field GenericZonesSettings The setting applicable to all zones.
//@field AlertFrequency The frequency for the alerts. If 'alert.freq_once_per_bar_close', alert messages will be concatenated and have a header saying how many messages it contains (if it's more than 1).
//@field AlertPrice The price that has to enter a zone. Can be 'Close' (the closing price) or 'Wick' (the whole candle needs to be in the zone).
//@field Zone1 The 'ZoneSettings' that represents this zone.
//@field Zone2 The 'ZoneSettings' that represents this zone.
//@field Zone3 The 'ZoneSettings' that represents this zone.
//@field Zone4 The 'ZoneSettings' that represents this zone.
//@field Zone5 The 'ZoneSettings' that represents this zone.
//@field Zone6 The 'ZoneSettings' that represents this zone.
//@field Zone7 The 'ZoneSettings' that represents this zone.
//@field Zone8 The 'ZoneSettings' that represents this zone.
//@field Zone9 The 'ZoneSettings' that represents this zone.
//@field Zone10 The 'ZoneSettings' that represents this zone.
//@field Zone11 The 'ZoneSettings' that represents this zone.
//@field Zone12 The 'ZoneSettings' that represents this zone.
//@field Zone13 The 'ZoneSettings' that represents this zone.
//@field Zone14 The 'ZoneSettings' that represents this zone.
//@field Zone15 The 'ZoneSettings' that represents this zone.
//@field Zone16 The 'ZoneSettings' that represents this zone.
//@field Zone17 The 'ZoneSettings' that represents this zone.
//@field Zone18 The 'ZoneSettings' that represents this zone.
//@field Zone19 The 'ZoneSettings' that represents this zone.
//@field Zone20 The 'ZoneSettings' that represents this zone.
//@field Zone21 The 'ZoneSettings' that represents this zone.
//@field Zone22 The 'ZoneSettings' that represents this zone.
//@field Zone23 The 'ZoneSettings' that represents this zone.
//@field Zone24 The 'ZoneSettings' that represents this zone.
export type Settings
    int PivotLeftLength
    int PivotRightLength
    TrendlineSettings Trendline
    GenericZonesSettings GenericZonesSettings
    string AlertFrequency
    string AlertPrice
    ZoneSettings Zone1
    ZoneSettings Zone2
    ZoneSettings Zone3
    ZoneSettings Zone4
    ZoneSettings Zone5
    ZoneSettings Zone6
    ZoneSettings Zone7
    ZoneSettings Zone8
    ZoneSettings Zone9
    ZoneSettings Zone10
    ZoneSettings Zone11
    ZoneSettings Zone12
    ZoneSettings Zone13
    ZoneSettings Zone14
    ZoneSettings Zone15
    ZoneSettings Zone16
    ZoneSettings Zone17
    ZoneSettings Zone18
    ZoneSettings Zone19
    ZoneSettings Zone20
    ZoneSettings Zone21
    ZoneSettings Zone22
    ZoneSettings Zone23
    ZoneSettings Zone24
//@type Holds all the values for 'Context'.
//@field Lines All the drawn lines for the current 'Context'.
//@field Labels All the drawn labels for the current 'Context'.
//@field Boxes All the drawn boxes for the current 'Context'.
//@field Alerts All the alert messages on the current tick.
//@field Start The start bar index of the current 'Context'.
export type Context
    array<line> Lines
    array<label> Labels
    array<box> Boxes
    array<string> Alerts
    int Start

// @function Concatenates all alerts from the bar to one string (separated by new lines) and clears alert messages on the current bar.
// @param Context The context for the Fibonacci retracement to check for alert messages in.
export ConcateAlerts(Context context) =>
    multipleAlerts = context.Alerts.size() > 1
    message = switch multipleAlerts
        false => ""
        true => str.format("{0} message/s", context.Alerts.size())
    for alert in context.Alerts
	    message += str.format("{0}{1}", multipleAlerts ? "\n" : "", alert)
    context.Alerts.clear()
    message
export AddAlert(Context context, string message, bool unshiftInsteadOfPush = false) =>
    if unshiftInsteadOfPush
        context.Alerts.unshift(message)
    else
        context.Alerts.push(message)
method AlertIfEnabled(Context context, ZoneSettings settings, Settings settings2) =>
    if not na(settings) and settings.Enabled
        switch settings2.AlertPrice
            "Close" =>
                if close <= settings.Price and close[1] > settings.Price
                    AddAlert(context, str.format("enter below {0}", settings.Level), true) // unshift instead of push because we want high levels to be above low in the alert
                if close >= settings.Price and close[1] < settings.Price
                    AddAlert(context, str.format("enter above {0}", settings.Level))
            "Wick" =>
                if high <= settings.Price and high[1] > settings.Price
                    AddAlert(context, str.format("enter below {0}", settings.Level), true) // unshift instead of push because we want high levels to be above low in the alert
                if low >= settings.Price and low[1] < settings.Price
                    AddAlert(context, str.format("enter above {0}", settings.Level))
method AllZoneSettings(Settings settings) =>
    array.from(
      settings.Zone1,
      settings.Zone2,
      settings.Zone3,
      settings.Zone4,
      settings.Zone5,
      settings.Zone6,
      settings.Zone7,
      settings.Zone8,
      settings.Zone9,
      settings.Zone10,
      settings.Zone11,
      settings.Zone12,
      settings.Zone13,
      settings.Zone14,
      settings.Zone15,
      settings.Zone16,
      settings.Zone17,
      settings.Zone18,
      settings.Zone19,
      settings.Zone20,
      settings.Zone21,
      settings.Zone22,
      settings.Zone23,
      settings.Zone24)
method ClearOld(Context context) =>
    for l in context.Lines
        l.delete()
    for l in context.Labels
        l.delete()
    for b in context.Boxes
        b.delete()
    context.Lines.clear()
    context.Labels.clear()
    context.Boxes.clear()
method Draw(TrendlineSettings settings, Context context, PriceAction.Pivot start, PriceAction.Pivot end) =>
    if settings.Enabled
        context.Lines.push(line.new(start.BarIndex, start.Price, end.BarIndex, end.Price, width = 2, color = settings.Color, style = settings.Style))
method DrawLines(ZoneSettings settings, Context context, PriceAction.Pivot start, PriceAction.Pivot end, float width, GenericZonesSettings genericZonesSettings) =>
    extendLine = if genericZonesSettings.Reverse
        if genericZonesSettings.ExtendRight
            extend.right
        else
            extend.none
    else
        if genericZonesSettings.ExtendRight
            extend.left
        else
            extend.none
    settings.Price := start.Price + (width * settings.Level)
    context.Lines.push(line.new(start.BarIndex, settings.Price, end.BarIndex, settings.Price, color = settings.Color, style = genericZonesSettings.Style, extend = extendLine)) // extend left instead of right because line is drawn right->left
method LabelStyle(ZoneSettings settings, GenericZonesSettings genericZonesSettings) =>
    if genericZonesSettings.Reverse
        if settings.Level < 0.5
            if genericZonesSettings.ExtendRight
                label.style_label_lower_left
            else
                label.style_label_left
        else
            label.style_label_right
    else
        if settings.Level >= 0.5
            if genericZonesSettings.ExtendRight
                label.style_label_lower_left
            else
                label.style_label_left
        else
            label.style_label_right
method LabelBarIndex(ZoneSettings settings, PriceAction.Pivot start, PriceAction.Pivot end, GenericZonesSettings genericZonesSettings) =>
    if genericZonesSettings.Reverse
        if settings.Level < 0.5
            end.BarIndex
        else
            start.BarIndex
    else
        if settings.Level >= 0.5
            start.BarIndex
        else
            end.BarIndex
method DrawLabels(ZoneSettings settings, Context context, PriceAction.Pivot start, PriceAction.Pivot end, float width, GenericZonesSettings genericZonesSettings) =>
    labelStyle = switch genericZonesSettings.LabelsPosition
        "Left" => label.style_label_right
        "Right" => label.style_label_left
        "Adapt" => settings.LabelStyle(genericZonesSettings)
    labelBarIndex = switch genericZonesSettings.LabelsPosition
        "Left" => genericZonesSettings.Reverse ? start.BarIndex : end.BarIndex
        "Right" => genericZonesSettings.Reverse ? end.BarIndex : start.BarIndex
        "Adapt" => settings.LabelBarIndex(start, end, genericZonesSettings)
    txt = ""
    if genericZonesSettings.Levels
        txt += switch genericZonesSettings.LevelsValue
            "Values" => str.format("{0}", settings.Level)
            "Percentages" => str.format("{0}%", settings.Level * 100)
    if genericZonesSettings.Prices
        txt += str.format("{0}({1})", txt == "" ? "" : " ", start.Price + (width * settings.Level))
    context.Labels.push(label.new(labelBarIndex, start.Price + (width * settings.Level), txt, color = color.new(color.black, 100), textcolor = settings.Color, style = labelStyle, size = genericZonesSettings.FontSize))
Draw(ZoneSettings settings, Context context, PriceAction.Pivot start, PriceAction.Pivot end, float width, GenericZonesSettings genericZonesSettings) =>
    if not na(settings) and settings.Enabled
        settings.DrawLines(context, start, end, width, genericZonesSettings)
        if genericZonesSettings.Levels or genericZonesSettings.Prices
            settings.DrawLabels(context, start, end, width, genericZonesSettings)
// @function Will return values if new levels/zones should be drawn.
// @param context The 'Context' for the Fibonacci retracement.
// @param structure The current 'Structure' from the 'MarketStructure' library.
// @param settings The 'Settings' object for the 'Context'.
// @returns A tuple with the start and end pivot if new zones should be drawn, '[na, na]' otherwise.
export Range(Context context, PriceAction.Structure structure, Settings settings) =>
    pivotSize = structure.Pivots.size()
    if pivotSize > 1
        current = structure.Pivots.first()
        PriceAction.Pivot previous = na
        if current.BarIndex == bar_index - structure.RightLength
            if current.Type == structure.Trend // only draw fibonacci from low->high in bullish trend (1) and high->low in bearish trend (-1)
                oppositeType = switch current.Type
                    -1 => 1
                    1 => -1
                for i = 1 to pivotSize - 1 // find the latest pivot of the opposite type
                    pivot = structure.Pivots.get(i)
                    if pivot.Type == oppositeType
                        previous := pivot
                        break
                if not na(previous)
                    context.ClearOld()
                    settings.Trendline.Draw(context, previous, current)
                    [start, end] = switch settings.GenericZonesSettings.Reverse
                        false => [current, previous]
                        true => [previous, current]
                    [start, end]
// @function Draws lines and labels for the zone. It will also set the 'Price' value that will be used for absolute positions.
// @param context The 'Context' for the Fibonacci retracement.
// @param settings The 'Settings' object for the 'Context'.
// @param The start pivot from the 'MarketStructure' library.
// @param The end pivot from the 'MarketStructure' library.
export DrawAll(Context context, Settings settings, PriceAction.Pivot start, PriceAction.Pivot end) =>
    context.Start := bar_index
    if start.BarIndex < end.BarIndex
        context.Boxes.push(box.new(start.BarIndex, start.Price, context.Start, end.Price, bgcolor = color.new(color.green, 70), border_width = 0))
    else
        context.Boxes.push(box.new(end.BarIndex, end.Price, context.Start, start.Price, bgcolor = color.new(color.green, 70), border_width = 0))
    width = end.Price - start.Price
    Draw(settings.Zone1, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone2, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone3, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone4, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone5, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone6, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone7, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone8, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone9, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone10, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone11, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone12, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone13, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone14, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone15, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone16, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone17, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone18, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone19, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone20, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone21, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone22, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone23, context, start, end, width, settings.GenericZonesSettings)
    Draw(settings.Zone24, context, start, end, width, settings.GenericZonesSettings)
    AddAlert(context, str.format("New dealing range with right pivot length of {0} and left of {1} ({2} to {3})", settings.PivotLeftLength, settings.PivotRightLength, start.Price, end.Price))
// @function Will alert for all zones that are active. If multiple alert messages are added they will be concatenated (separated by a new line) with a header saying how many messages the alert contains.
// @param context The 'Context' for the Fibonacci retracement. This contains the zones that will be alerted if price (wick or close according to the settings) enters it.
// @param settings The 'Settings' object for the 'Context'.
export AlertActive(Context context, Settings settings) =>
    if context.Start != bar_index
        varip allZoneSettings = settings.AllZoneSettings()
        for zoneSetting in allZoneSettings
            context.AlertIfEnabled(zoneSetting, settings)