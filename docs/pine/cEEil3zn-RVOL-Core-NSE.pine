//@version=6
library("RVOL_Core_NSE", overlay = false)

//────────────────────────────────────────────────────────────
// CONSTANT
//────────────────────────────────────────────────────────────
MAX_BARS_BACK = 1500

//────────────────────────────────────────────────────────────
// INTERNAL HELPERS (PRIVATE)
//────────────────────────────────────────────────────────────

// Optimal usable lookback (bars-safe)
f_optimalLookback(_barNosAtDayStart, _userPeriods) =>
    int _ret = 0
    int _maxIdx = array.size(_barNosAtDayStart) - 1

    if _maxIdx < 0
        0
    else
        for _i = math.min(_userPeriods - 1, _maxIdx) to 0
            if bar_index - array.get(_barNosAtDayStart, _i) > MAX_BARS_BACK - 1
                break
            _ret += 1
        _ret

// Point-to-point historical volume
f_pastVolPtp(_msOffset, _timeAtFarthest, _periods) =>
    if _periods < 2
        na
    else
        float[] vols = array.new_float()
        int tfNo = 0

        for i = 1 to MAX_BARS_BACK - 2
            if time[i] < _timeAtFarthest or tfNo >= _periods
                break
            if _msOffset == nz(_msOffset[i])
                tfNo += 1
                array.push(vols, volume[i])

        nz(array.avg(vols))

// Cumulative historical volume
f_pastCumVol(_msOffset, _timeAtFarthest, _periods) =>
    if _periods < 2
        na
    else
        float[] vols = array.new_float()
        float cum = 0.0
        int tfNo = 0

        for i = 1 to MAX_BARS_BACK - 2
            if time[i] < _timeAtFarthest
                break

            if nz(_msOffset[i]) <= _msOffset
                cum += volume[i]

            if nz(_msOffset[i]) == 0
                tfNo += 1
                if tfNo <= _periods
                    array.push(vols, cum)
                cum := 0.0

        nz(array.avg(vols))

//────────────────────────────────────────────────────────────
// PUBLIC FUNCTION (EXPORT)
//────────────────────────────────────────────────────────────

export f_rvol(
     int lookbackDays,           // Number of past sessions
     bool isNewDay,               // Day boundary signal
     int msSinceSessionStart,    // Milliseconds since session start
     float volume                  // Current bar volume
 ) =>
    // Persistent state
    var int[] barNosAtDayStart = array.new_int()
    var int   lastOffsetMs = na
    var float cachedAvgReg = na
    var float cachedAvgCum = na
    var float cumVolToday = 0.0

    // ── Day reset
    if isNewDay
        array.push(barNosAtDayStart, bar_index)
        lastOffsetMs := na
        cachedAvgReg := na
        cachedAvgCum := na
        cumVolToday  := 0.0

    // Cap stored days
    if array.size(barNosAtDayStart) > lookbackDays + 5
        array.shift(barNosAtDayStart)

    usableLookback =
         f_optimalLookback(barNosAtDayStart, lookbackDays)

    // Time of farthest usable lookback
    int timeAtFarthest = na
    if usableLookback > 0 and array.size(barNosAtDayStart) >= usableLookback
        farIdx = array.get(
            barNosAtDayStart,
            array.size(barNosAtDayStart) - usableLookback
        )
        offset = bar_index - farIdx
        if offset >= 0 and offset < MAX_BARS_BACK
            timeAtFarthest := time[offset]

    // Intrabar-safe cumulative volume
    barVolInc =
         barstate.isrealtime ?
         math.max(volume - nz(volume[1]), 0) :
         volume

    cumVolToday += barVolInc

    // Compute historical averages once per offset
    if usableLookback >= 2 and msSinceSessionStart != lastOffsetMs
        cachedAvgReg :=
             f_pastVolPtp(
                 msSinceSessionStart,
                 timeAtFarthest,
                 usableLookback
             )

        cachedAvgCum :=
             f_pastCumVol(
                 msSinceSessionStart,
                 timeAtFarthest,
                 usableLookback
             )

        lastOffsetMs := msSinceSessionStart

    // Final RVOL values
    rvolReg =
         cachedAvgReg > 0 ? volume / cachedAvgReg : na

    rvolCum =
         cachedAvgCum > 0 ? cumVolToday / cachedAvgCum : na

    [cachedAvgReg, cachedAvgCum, rvolReg, rvolCum]

