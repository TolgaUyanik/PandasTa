//@version=6
indicator("RTH Opens (9:30)", overlay=true, max_lines_count=500, max_labels_count=500)

// ─── Inputs ───
showLines   = input.bool(true,  "Show Lines")
lookback    = input.int(20,     "Days Back", minval=1, maxval=100)
lineColor   = input.color(color.new(color.orange, 0), "Line Color")
lineWidth   = input.int(1,      "Line Width", minval=1, maxval=4)
lineStyleIn = input.string("Solid", "Line Style", options=["Solid","Dashed","Dotted"])
showLabels  = input.bool(true,  "Show Price Labels")
extendRight = input.bool(true,  "Extend Lines to Current Bar")

lStyle = lineStyleIn == "Dashed" ? line.style_dashed : lineStyleIn == "Dotted" ? line.style_dotted : line.style_solid

// ─── Detect the 9:30 NY open bar (explicit hour/minute check) ───
nyHour = hour(time, "America/New_York")
nyMin  = minute(time, "America/New_York")
atOpen = nyHour == 9 and nyMin == 30
isOpen = atOpen and not atOpen[1]

// ─── Store the 9:30 open price + the TIME it happened ───
var opens    = array.new<float>()
var openTime = array.new<int>()

if isOpen
    opens.push(open)
    openTime.push(time)
    if opens.size() > lookback
        opens.shift()
        openTime.shift()

// ─── Redraw on the last bar ───
var lines  = array.new<line>()
var labels = array.new<label>()

if barstate.islast and showLines
    if lines.size() > 0
        for i = 0 to lines.size() - 1
            line.delete(lines.get(i))
    if labels.size() > 0
        for i = 0 to labels.size() - 1
            label.delete(labels.get(i))
    lines.clear()
    labels.clear()

    if opens.size() > 0
        for i = 0 to opens.size() - 1
            px = opens.get(i)
            t1 = openTime.get(i)
            t2 = extendRight ? time : (i < openTime.size() - 1 ? openTime.get(i + 1) : time)
            ln = line.new(t1, px, t2, px, xloc=xloc.bar_time, color=lineColor, width=lineWidth, style=lStyle)
            lines.push(ln)
            if showLabels
                lb = label.new(time, px, str.tostring(px, format.mintick), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.orange, 100), textcolor=lineColor, size=size.small)
                labels.push(lb)