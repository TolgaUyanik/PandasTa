// Indicator for TradingView showing MACD and Signal lines with colors based on Williams %R overbought/oversold
//@version=5
indicator("MACD and Signal with Williams %R Coloring", overlay=false)

// Input parameters
fast_length = input.int(12, "Fast EMA Length", minval=1)
slow_length = input.int(26, "Slow EMA Length", minval=1)
signal_length = input.int(9, "Signal Line Length", minval=1)
williams_length = input.int(14, "Williams %R Length", minval=1)
overbought_level = input.float(-20, "Overbought Level", minval=-100, maxval=0)
oversold_level = input.float(-80, "Oversold Level", minval=-100, maxval=0)

// Calculate MACD Line (Fast EMA - Slow EMA)
fast_ema = ta.ema(close, fast_length)
slow_ema = ta.ema(close, slow_length)
macd = fast_ema - slow_ema

// Calculate Signal Line (EMA of MACD)
signal = ta.ema(macd, signal_length)

// Calculate Williams %R
highest_high = ta.highest(high, williams_length)
lowest_low = ta.lowest(low, williams_length)
williams_r = highest_high == lowest_low ? 0 : 100 * (close - highest_high) / (highest_high - lowest_low)

// Define conditions for coloring
is_overbought = williams_r >= overbought_level
is_oversold = williams_r <= oversold_level

// Determine line colors
line_color = is_overbought ? color.red : is_oversold ? color.green : color.blue

// Plot MACD and Signal lines with conditional coloring
plot(macd, "MACD Line", color=line_color, linewidth=2)
plot(signal, "Signal Line", color=line_color, linewidth=2)

// Plot 0 line for reference
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dashed)