//@version=6
strategy("AI Triple Confirmation Strategy", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10)

// =====================================================
// SETTINGS
// =====================================================

emaFastLen = input.int(50, "Fast EMA")
emaSlowLen = input.int(200, "Slow EMA")

rsiLen = input.int(14, "RSI Length")
rsiBuy = input.int(55, "RSI Buy Level")
rsiSell = input.int(45, "RSI Sell Level")

atrLen = input.int(14, "ATR Length")
riskReward = input.float(3.0, "Risk Reward Ratio")

swingLen = input.int(5, "Swing Length")

// =====================================================
// TREND CONFIRMATION (EMA)
// =====================================================

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow

plot(emaFast, color=color.green, title="EMA 50")
plot(emaSlow, color=color.red, title="EMA 200")

// =====================================================
// MOMENTUM CONFIRMATION (RSI)
// =====================================================

rsi = ta.rsi(close, rsiLen)

bullRSI = rsi > rsiBuy
bearRSI = rsi < rsiSell

// =====================================================
// MARKET STRUCTURE CONFIRMATION (BOS)
// =====================================================

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh = na
var float lastLow = na

if not na(ph)
    lastHigh := ph

if not na(pl)
    lastLow := pl

bullBOS = ta.crossover(close, lastHigh)
bearBOS = ta.crossunder(close, lastLow)

// =====================================================
// FINAL CONFIRMATION
// =====================================================

buySignal =
     bullTrend and
     bullRSI and
     bullBOS

sellSignal =
     bearTrend and
     bearRSI and
     bearBOS

// =====================================================
// ATR STOP LOSS
// =====================================================

atr = ta.atr(atrLen)

buySL = close - atr
buyTP = close + (atr * riskReward)

sellSL = close + atr
sellTP = close - (atr * riskReward)

// =====================================================
// EXECUTION
// =====================================================

if buySignal
    strategy.entry("BUY", strategy.long)
    strategy.exit(
         "BUY TP/SL",
         from_entry="BUY",
         stop=buySL,
         limit=buyTP)

if sellSignal
    strategy.entry("SELL", strategy.short)
    strategy.exit(
         "SELL TP/SL",
         from_entry="SELL",
         stop=sellSL,
         limit=sellTP)

// =====================================================
// VISUALS
// =====================================================

plotshape(
     buySignal,
     title="BUY SIGNAL",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="BUY")

plotshape(
     sellSignal,
     title="SELL SIGNAL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL")

// TP & SL VISUALS

plot(
     strategy.position_size > 0 ? buyTP : na,
     color=color.green,
     style=plot.style_linebr,
     title="BUY TP")

plot(
     strategy.position_size > 0 ? buySL : na,
     color=color.red,
     style=plot.style_linebr,
     title="BUY SL")

plot(
     strategy.position_size < 0 ? sellTP : na,
     color=color.green,
     style=plot.style_linebr,
     title="SELL TP")

plot(
     strategy.position_size < 0 ? sellSL : na,
     color=color.red,
     style=plot.style_linebr,
     title="SELL SL")

// =====================================================
// ALERTS
// =====================================================

alertcondition(
     buySignal,
     title="BUY ALERT",
     message="Triple Confirmation BUY Signal")

alertcondition(
     sellSignal,
     title="SELL ALERT",
     message="Triple Confirmation SELL Signal")