//@version=6

// ============================================================================
// ARGENTINA SOVEREIGN BONDS LIBRARY
// ============================================================================
//
// [EN] DESCRIPTION:
//      Reusable Pine Script library for Argentine sovereign bond analysis.
//      Provides cashflow data and calculation functions for Bonares (Argentine law)
//      and Globales (New York law) USD-denominated bonds.
//
//      EXPORTED FUNCTIONS:
//
//      Cashflow data:
//      - getCashflows_[TICKER](): Returns [timestamps, cashflows, count] for each bond
//        Timestamps in milliseconds since epoch. Cashflows in USD per 100 nominal.
//
//      Bond identification:
//      - getBondType(ticker): Returns BONAR() or GLOBAL()
//      - getBaseTicker(ticker): Extracts base ticker without BCBA: prefix or D/C suffix
//      - getCurrencyType(ticker): Returns 0=ARS, 1=MEP (D suffix), 2=Cable (C suffix)
//      - isSupported(baseTicker): Checks if a bond ticker is supported
//
//      Valuation:
//      - calcPV(ts, cf, count, settlement, rate): Present value (Actual/365)
//      - calcIRR(ts, cf, count, settlement, price): IRR via Newton-Raphson
//      - calcPriceFromIRR(ts, cf, count, settlement, tir): Price from target TIR
//
//      Utilities:
//      - convertToNativeCurrency(...): Converts price to the bond's cashflow currency
//      - getSettlementDate(): Returns T+1 settlement timestamp
//
//      SUPPORTED BONDS (13):
//      Bonares (USD MEP, Argentine law):
//        AE38, AL29, AL30, AL35, AL41, AN29, AO27
//      Globales (USD Cable, New York law):
//        GD29, GD30, GD35, GD38, GD41, GD46
//
// [ES] DESCRIPCION:
//      Libreria reutilizable en Pine Script para analisis de bonos soberanos argentinos.
//      Provee datos de flujos de fondos y funciones de calculo para Bonares (ley argentina)
//      y Globales (ley Nueva York) denominados en dolares estadounidenses.
//
//      FUNCIONES EXPORTADAS:
//
//      Datos de flujos:
//      - getCashflows_[TICKER](): Retorna [timestamps, cashflows, count] para cada bono
//        Timestamps en milisegundos desde epoch. Cashflows en USD por cada 100 de VN.
//
//      Identificacion de bonos:
//      - getBondType(ticker): Retorna BONAR() o GLOBAL()
//      - getBaseTicker(ticker): Extrae ticker base sin prefijo BCBA: ni sufijo D/C
//      - getCurrencyType(ticker): Retorna 0=ARS, 1=MEP (sufijo D), 2=Cable (sufijo C)
//      - isSupported(baseTicker): Verifica si el bono esta soportado
//
//      Valuacion:
//      - calcPV(ts, cf, count, settlement, rate): Valor presente (Actual/365)
//      - calcIRR(ts, cf, count, settlement, price): TIR via Newton-Raphson
//      - calcPriceFromIRR(ts, cf, count, settlement, tir): Precio desde TIR objetivo
//
//      Utilidades:
//      - convertToNativeCurrency(...): Convierte precio a la moneda del flujo del bono
//      - getSettlementDate(): Retorna timestamp de liquidacion T+1
//
//      BONOS SOPORTADOS (13):
//      Bonares (USD MEP, ley argentina):
//        AE38, AL29, AL30, AL35, AL41, AN29, AO27
//      Globales (USD Cable, ley Nueva York):
//        GD29, GD30, GD35, GD38, GD41, GD46
//
// ============================================================================
//
// ==================== DISCLAIMER / AVISO LEGAL ====================
// [EN] This indicator is for informational and educational purposes only.
//      Eco Valores S.A. does NOT provide investment advice or recommendations.
//      Consult a qualified financial advisor before making investment decisions.
// [ES] Este indicador es solo para fines informativos y educativos.
//      Eco Valores S.A. NO brinda asesoramiento ni recomendaciones de inversion.
//      Consulte con un asesor financiero calificado antes de invertir.
// ==================================================================

library("ArgentinaBondsLib", overlay=true)

// Bond type constants
export BONAR() => 1
export GLOBAL() => 2

