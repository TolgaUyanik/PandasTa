// ============================================================================
// BOND IDENTIFICATION FUNCTIONS
// ============================================================================

// Get bond type from ticker (1=Bonar, 2=Global)
export getBondType(string ticker) =>
    string baseTicker = str.replace_all(str.replace_all(ticker, "D", ""), "C", "")
    baseTicker := str.replace_all(baseTicker, "BCBA:", "")
    result = str.startswith(baseTicker, "G") ? GLOBAL() : BONAR()
    result

// Get base ticker without exchange prefix and currency suffix
export getBaseTicker(string ticker) =>
    string result = str.replace_all(ticker, "BCBA:", "")
    if str.endswith(result, "D") or str.endswith(result, "C")
        result := str.substring(result, 0, str.length(result) - 1)
    result

// Get currency type from ticker suffix
// Returns: 0=ARS, 1=MEP (D suffix), 2=Cable (C suffix)
export getCurrencyType(string ticker) =>
    string cleanTicker = str.replace_all(ticker, "BCBA:", "")
    result = str.endswith(cleanTicker, "D") ? 1 : str.endswith(cleanTicker, "C") ? 2 : 0
    result

// ============================================================================
// PRESENT VALUE AND IRR CALCULATION
// ============================================================================

// Calculate Present Value of future cashflows given a discount rate
// Uses Actual/365 day count convention
// settlementDate: timestamp in milliseconds
// rate: annual rate as decimal (e.g., 0.10 for 10%)
export calcPV(array<int> timestamps, array<float> cashflows, int count, int settlementDate, float rate) =>
    float pv = 0.0
    float msPerYear = 365.0 * 24.0 * 60.0 * 60.0 * 1000.0
    for i = 0 to count - 1
        int cfDate = array.get(timestamps, i)
        if cfDate > settlementDate
            float cf = array.get(cashflows, i)
            float yearsToPayment = (cfDate - settlementDate) / msPerYear
            float discountFactor = math.pow(1.0 + rate, -yearsToPayment)
            pv += cf * discountFactor
    pv

// Calculate derivative of PV with respect to rate (for Newton-Raphson)
export calcPVDerivative(array<int> timestamps, array<float> cashflows, int count, int settlementDate, float rate) =>
    float dpv = 0.0
    float msPerYear = 365.0 * 24.0 * 60.0 * 60.0 * 1000.0
    for i = 0 to count - 1
        int cfDate = array.get(timestamps, i)
        if cfDate > settlementDate
            float cf = array.get(cashflows, i)
            float yearsToPayment = (cfDate - settlementDate) / msPerYear
            dpv -= yearsToPayment * cf * math.pow(1.0 + rate, -yearsToPayment - 1.0)
    dpv

// Calculate IRR using Newton-Raphson method
// Returns annual IRR as decimal (e.g., 0.10 for 10%)
// price: current bond price per 100 nominal in native currency
// settlementDate: timestamp in milliseconds (typically timenow + 86400000 for T+1)
export calcIRR(array<int> timestamps, array<float> cashflows, int count, int settlementDate, float price) =>
    float rate = 0.10  // Initial guess 10%
    float tolerance = 0.000001
    int maxIterations = 50
    float msPerYear = 365.0 * 24.0 * 60.0 * 60.0 * 1000.0
    
    for iter = 0 to maxIterations - 1
        float pv = 0.0
        float dpv = 0.0
        
        for i = 0 to count - 1
            int cfDate = array.get(timestamps, i)
            if cfDate > settlementDate
                float cf = array.get(cashflows, i)
                float yearsToPayment = (cfDate - settlementDate) / msPerYear
                float discountFactor = math.pow(1.0 + rate, -yearsToPayment)
                pv += cf * discountFactor
                dpv -= yearsToPayment * cf * math.pow(1.0 + rate, -yearsToPayment - 1.0)
        
        float npv = pv - price
        if math.abs(npv) < tolerance
            break
        if math.abs(dpv) < 1e-10
            break
        rate := rate - npv / dpv
        rate := math.max(0.001, math.min(0.50, rate))
    
    rate

// Calculate price given a target IRR (inverse of calcIRR)
// Returns price per 100 nominal
export calcPriceFromIRR(array<int> timestamps, array<float> cashflows, int count, int settlementDate, float targetIRR) =>
    calcPV(timestamps, cashflows, count, settlementDate, targetIRR)

// ============================================================================
// CURRENCY CONVERSION
// ============================================================================

// Convert price to the bond's native cashflow currency
// For Bonares: convert to USD MEP (cashflows paid in Argentina)
// For Globales: convert to USD Cable (cashflows paid in USA)
// 
// Parameters:
// - price: raw price from TradingView
// - bondType: BONAR() or GLOBAL()
// - currencyType: 0=ARS, 1=MEP (D), 2=Cable (C)
// - al30: price of AL30 in ARS
// - al30d: price of AL30D in USD MEP
// - al30c: price of AL30C in USD Cable
export convertToNativeCurrency(float price, int bondType, int currencyType, float al30, float al30d, float al30c) =>
    float ratioMEP = al30d / al30      // ARS -> MEP
    float ratioCable = al30c / al30    // ARS -> Cable
    float ratioCCL = al30c / al30d     // MEP -> Cable (CCL/MEP ratio)
    
    float result = price
    
    if bondType == BONAR()
        // Bonares pay in MEP, need price in MEP
        if currencyType == 0  // ARS
            result := price * ratioMEP
        else if currencyType == 2  // Cable
            result := price / ratioCCL  // Convert Cable to MEP
        // currencyType == 1 (MEP) -> already correct
    else
        // Globales pay in Cable, need price in Cable  
        if currencyType == 0  // ARS
            result := price * ratioCable
        else if currencyType == 1  // MEP
            result := price * ratioCCL  // Convert MEP to Cable
        // currencyType == 2 (Cable) -> already correct
    
    result

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

// Get settlement date (T+1) as timestamp in milliseconds
export getSettlementDate() =>
    int oneDay = 86400000
    timenow + oneDay

// Check if a base ticker is supported
export isSupported(string baseTicker) =>
    baseTicker == "AE38" or baseTicker == "AL29" or baseTicker == "AL30" or baseTicker == "AL35" or baseTicker == "AL41" or baseTicker == "AN29" or baseTicker == "AO27" or baseTicker == "GD29" or baseTicker == "GD30" or baseTicker == "GD35" or baseTicker == "GD38" or baseTicker == "GD41" or baseTicker == "GD46"

