//@version=5
indicator("30s OR Projections", overlay = true, max_lines_count=500, max_labels_count=500, max_boxes_count=20)

// === INPUTS ===
grpONS = "ONS"

// Range / OR box
show_range           = input.bool(true, "Show OR", group=grpONS, inline="showrange")
vert_line            = input.bool(true, "Show Start/End", group=grpONS, inline="showrange")  // (kept; not used below)
range_color          = input.color(color.new(#3bffef, 80), "OR Color", inline="kz_color", group=grpONS)
lineWidth            = 1
range_type           = input.string("Wicks", "Use Wicks or Bodies for Range", options=["Wicks", "Bodies"], group=grpONS) // (kept; not used below)

// Background shading colors
bg_color_5           = input.color(color.new(#7e8584, 61), "Background Color 0 to -0.5", group=grpONS)
bg_color_1           = input.color(color.new(#3bffef, 61), "Background Color -1 to -1.5", group=grpONS)
bg_color_2           = input.color(color.new(#ca62f3, 61), "Background Color -2 to -2.5", group=grpONS)

// NEW shading inputs
bg_color_33          = input.color(color.new(#ffb703, 70), "Background Color -3 to -3.5", group=grpONS)
bg_color_3           = input.color(color.new(#f50101, 61), "Background Color -4 to -4.5", group=grpONS)
bg_color_55          = input.color(color.new(#00b4d8, 72), "Background Color -5 to -5.5", group=grpONS)
bg_color_4           = input.color(color.new(#7c0b80, 71), "Background Color -6 to -6.5", group=grpONS)

// Projections controls
show_projections     = input.bool(true, "Show Projections", group=grpONS, inline="projections")
show_lines           = input.bool(true, "Show Projection Lines", group=grpONS, inline="projections")
projection_color     = input.color(color.new(#110808, 0), "Projections Color", inline="kz_color", group=grpONS) // (kept; not used below)
hide_lines           = input.string("60", "Hide OR above __ Minutes", group = grpONS, options = ["15", "30", "60", "120", "240"]) // (kept; not used below)
text_offset          = 2
proj_05_color        = input.color(color.orange, "±0.5 Projection Line Color", group=grpONS, inline="proj05")
proj_05_width        = input.int(2, "Width", minval=1, maxval=5, group=grpONS, inline="proj05")

// Extend projections to current bar
extend_to_current    = input.bool(false, "Extend Projections to Current Price", group=grpONS)

// ── OR EQ + Quarter (0.25/0.75) controls ─────────────────────────────
grpEQ = "ONS • OR EQ & Quarters"

eq_on       = input.bool(true, "Show OR EQ", group=grpEQ, inline="eq")
eq_color    = input.color(color.new(color.black, 45), "Color", group=grpEQ, inline="eq")
eq_width    = input.int(1, "Width", minval=1, maxval=5, group=grpEQ, inline="eq")
eq_style_i  = input.string("Dashed", "Style", options=["Solid","Dashed","Dotted"], group=grpEQ)

q_on        = input.bool(true, "Show 0.25 / 0.75", group=grpEQ)

q25_on      = input.bool(true, "0.25", group=grpEQ, inline="q25")
q25_color   = input.color(color.teal, "Color", group=grpEQ, inline="q25")
q25_width   = input.int(1, "W", minval=1, maxval=5, group=grpEQ, inline="q25")
q25_style_i = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grpEQ)

q75_on      = input.bool(true, "0.75", group=grpEQ, inline="q75")
q75_color   = input.color(color.fuchsia, "Color", group=grpEQ, inline="q75")
q75_width   = input.int(1, "W", minval=1, maxval=5, group=grpEQ, inline="q75")
q75_style_i = input.string("Dotted", "Style", options=["Solid","Dashed","Dotted"], group=grpEQ)

// ── Projection Price Labels ─────────────────────
show_price_labels     = input.bool(true,  "Show Price at Projection Levels", group=grpONS)
price_label_mode      = input.string("level", "Price Label Content", options=["price","level","both"], group=grpONS)
price_label_side      = input.string("left", "Price Label Side", options=["left","right"], group=grpONS)
price_label_size      = input.string("small", "Price Label Size", options=["tiny","small","normal","large"], group=grpONS)
price_text_color      = input.color(color.black, "Price Text Color", group=grpONS)
price_bg_color        = input.color(color.new(color.white, 100), "Price Background", group=grpONS) // 100 = transparent
price_label_padding_x = input.int(2, "Price Label Horizontal Padding (bars)", minval=0, group=grpONS)
price_label_padding_y = input.float(0.25, "Price Label Vertical Padding (ticks)", minval=0, group=grpONS)

// Helpers
f_size(s) =>
    s == "tiny"   ? size.tiny  :    s == "small"  ? size.small :    s == "large"  ? size.large :    size.normal

f_style(s) =>
    s == "Dashed" ? line.style_dashed :    s == "Dotted" ? line.style_dotted :    line.style_solid

// Build the label text for a given level and y-price
f_level_price_text(_mode, _level, _y) =>
    lvlTxt = str.tostring(_level)
    pxTxt  = str.tostring(_y, format.mintick)
    _mode == "both"  ? (lvlTxt + " | " + pxTxt) : _mode == "price" ? pxTxt : lvlTxt

// === OR Session Time ===
use_auto_or   = input.bool(true, "Auto-detect OR Time (Gold vs Equities)", group=grpONS)
manual_hour   = input.int(15, "Manual OR Hour", group=grpONS, inline="manual", minval=0, maxval=23)
manual_minute = input.int(50, "", group=grpONS, inline="manual", minval=0, maxval=59)
manual_second = input.int(0, "", group=grpONS, inline="manual", minval=0, maxval=59)

is_gold = str.contains(syminfo.ticker, "GC") or str.contains(syminfo.ticker, "XAU")
or_hour = use_auto_or ? (is_gold ? 8 : 9) : manual_hour
or_min  = use_auto_or ? (is_gold ? 20 : 30) : manual_minute
or_sec  = use_auto_or ? 0 : manual_second

// === OR Logic ===
session_tz = "America/New_York"
times = request.security_lower_tf(syminfo.tickerid, "30S", time)
highs = request.security_lower_tf(syminfo.tickerid, "30S", high)
lows  = request.security_lower_tf(syminfo.tickerid, "30S", low)

var float rng_high = na
var float rng_low  = na
var int   last_rng_day = na

current_day_key = year(time, session_tz) * 10000 + month(time, session_tz) * 100 + dayofmonth(time, session_tz)

// Reset OR range for each new day (independent of midnight — works on RTH)
if current_day_key != last_rng_day
    rng_high := na
    rng_low  := na

if array.size(times) > 0 and na(rng_high)
    for i = 0 to array.size(times) - 1
        t = array.get(times, i)
        if hour(t, session_tz) == or_hour and minute(t, session_tz) == or_min and second(t, session_tz) == or_sec
            rng_high := array.get(highs, i)
            rng_low  := array.get(lows, i)
            last_rng_day := current_day_key
            break

// === VARIABLES ===
var box  rangebox = na
var line eq_line  = na
var line q25_line = na
var line q75_line = na

var bool projections_drawn = false
var bool range_finalized   = false

var label[] all_labels = array.new_label()
var line[]  all_lines  = array.new_line()
var box[]   all_boxes  = array.new_box()

// Track day for clearing drawings (RTH-friendly)
var int last_draw_day = na
if na(last_draw_day)
    last_draw_day := current_day_key

// === CLEAR ON NEW TRADING DAY (RTH-safe) ===
if current_day_key != last_draw_day
    // delete all stored labels, lines, boxes
    while array.size(all_labels) > 0
        label.delete(array.pop(all_labels))
    while array.size(all_lines) > 0
        line.delete(array.pop(all_lines))
    while array.size(all_boxes) > 0
        box.delete(array.pop(all_boxes))

    if not na(rangebox)
        box.delete(rangebox)
        rangebox := na

    if not na(eq_line)
        line.delete(eq_line)
        eq_line := na

    if not na(q25_line)
        line.delete(q25_line)
        q25_line := na

    if not na(q75_line)
        line.delete(q75_line)
        q75_line := na

    projections_drawn := false
    range_finalized   := false
    last_draw_day     := current_day_key

// === DRAW RANGE (one-time for the day) ===
if show_range and not na(rng_high) and not na(rng_low) and not range_finalized
    // OR box
    rangebox := box.new(bar_index, rng_high, bar_index, rng_low, xloc=xloc.bar_index, border_color=color.new(#c78234, 100), bgcolor=range_color)

    // EQ line (controlled)
    if eq_on
        eq_val  = math.avg(rng_high, rng_low)
        eq_line := line.new(bar_index, eq_val, bar_index, eq_val, xloc=xloc.bar_index, color=eq_color, width=eq_width, style=f_style(eq_style_i))
        array.push(all_lines, eq_line)

    // 0.25 / 0.75 internal OR levels (controlled)
    if q_on
        _r = rng_high - rng_low
        if q25_on
            q25 = rng_low + 0.25 * _r
            q25_line := line.new(bar_index, q25, bar_index, q25, xloc=xloc.bar_index, color=q25_color, width=q25_width, style=f_style(q25_style_i))
            array.push(all_lines, q25_line)
        if q75_on
            q75 = rng_low + 0.75 * _r
            q75_line := line.new(bar_index, q75, bar_index, q75, xloc=xloc.bar_index, color=q75_color, width=q75_width, style=f_style(q75_style_i))
            array.push(all_lines, q75_line)

    projections_drawn := false
    range_finalized   := true

// === DRAW PROJECTIONS (one-time) ===
if range_finalized and not projections_drawn and not na(rangebox) and show_projections
    _top    = box.get_top(rangebox)
    _bottom = box.get_bottom(rangebox)
    _range  = _top - _bottom

    // initial span for drawing (will get extended live if extend_to_current is ON)
    start_idx = bar_index
    end_idx   = bar_index + 15  // initial span ~15 bars

    // UPDATED: include -5.5 so we can shade -5 to -5.5
    levels = array.from(0, -0.5, -1, -1.5, -2, -2.5, -3, -3.5, -4, -4.5, -5, -5.5, -6, -6.5, -7, -8, -9, -10)

    y_pad = price_label_padding_y * syminfo.mintick

    for i = 0 to array.size(levels) - 1
        level = array.get(levels, i)

        top_y = _top + (-level * _range)
        bot_y = _bottom - (-level * _range)

        // ===== Background shading =====
        if level == 0
            nextLevel = level - 0.5  // 0 → -0.5
            // top side band
            zone_top = _top + (-level * _range)
            zone_bot = _top + (-nextLevel * _range)
            array.push(all_boxes, box.new(start_idx, zone_top, end_idx, zone_bot, xloc=xloc.bar_index, border_width=0, bgcolor=bg_color_5))
            // bottom side band
            zone_top2 = _bottom - (-level * _range)
            zone_bot2 = _bottom - (-nextLevel * _range)
            array.push(all_boxes, box.new(start_idx, zone_top2, end_idx, zone_bot2, xloc=xloc.bar_index, border_width=0, bgcolor=bg_color_5))

        // UPDATED: include -3 and -5 shading tiers
        if level == -1 or level == -2 or level == -3 or level == -4 or level == -5 or level == -6
            nextLevel = level - 0.5

            // top side band
            zone_top_t = _top + (-level * _range)
            zone_bot_t = _top + (-nextLevel * _range)

            col = level == -1 ? bg_color_1 :                  level == -2 ? bg_color_2 :                  level == -3 ? bg_color_33 :                  level == -4 ? bg_color_3 :                  level == -5 ? bg_color_55 :                                bg_color_4

            array.push(all_boxes, box.new(start_idx, zone_top_t, end_idx, zone_bot_t, xloc=xloc.bar_index, border_width=0, bgcolor=col))

            // bottom side band
            zone_top_b = _bottom - (-level * _range)
            zone_bot_b = _bottom - (-nextLevel * _range)
            array.push(all_boxes, box.new(start_idx, zone_top_b, end_idx, zone_bot_b, xloc=xloc.bar_index, border_width=0, bgcolor=col))

        // ===== Projection Lines =====
        if level == 0
            array.push(all_lines, line.new(start_idx, top_y, end_idx, top_y, xloc=xloc.bar_index, color=color.black, width=2))
            array.push(all_lines, line.new(start_idx, bot_y, end_idx, bot_y, xloc=xloc.bar_index, color=color.black, width=2))
        else if show_lines and level == -0.5
            array.push(all_lines, line.new(start_idx, top_y, end_idx, top_y, xloc=xloc.bar_index, color=proj_05_color, width=proj_05_width))
            array.push(all_lines, line.new(start_idx, bot_y, end_idx, bot_y, xloc=xloc.bar_index, color=proj_05_color, width=proj_05_width))
        else if show_lines
            proj_color = (level == -4 or level == -4.5 ? color.red : (level == -2 or level == -2.5 ? color.purple : color.black))
            array.push(all_lines, line.new(start_idx, top_y, end_idx, top_y, xloc=xloc.bar_index, color=proj_color, width=1))
            array.push(all_lines, line.new(start_idx, bot_y, end_idx, bot_y, xloc=xloc.bar_index, color=proj_color, width=1))

        // ===== Price labels (with padding) =====
        if show_price_labels
            x_pos     = price_label_side == "right" ? end_idx + price_label_padding_x : start_idx - price_label_padding_x
            txt_align = price_label_side == "right" ? text.align_left : text.align_right

            array.push(all_labels, label.new(x_pos, top_y + y_pad, f_level_price_text(price_label_mode, level, top_y),
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textalign=txt_align,
                 size=f_size(price_label_size), color=price_bg_color, textcolor=price_text_color))

            array.push(all_labels, label.new(x_pos, bot_y - y_pad, f_level_price_text(price_label_mode, level, bot_y),
                 xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textalign=txt_align,
                 size=f_size(price_label_size), color=price_bg_color, textcolor=price_text_color))

    projections_drawn := true

// === LIVE EXTENSION TO CURRENT PRICE (when enabled) ===
if extend_to_current and projections_drawn
    new_x = bar_index

    // extend all projection lines + EQ + quarter lines (everything pushed into all_lines)
    for i = 0 to array.size(all_lines) - 1
        ln = array.get(all_lines, i)
        line.set_x2(ln, new_x)

    // extend all shading boxes
    for i = 0 to array.size(all_boxes) - 1
        bx = array.get(all_boxes, i)
        box.set_right(bx, new_x)

    // extend the main range box
    if not na(rangebox)
        box.set_right(rangebox, new_x)

    // slide price labels to stay near the right edge (optional)
    if show_price_labels
        lbl_x = price_label_side == "right" ? new_x + price_label_padding_x : new_x - price_label_padding_x
        for i = 0 to array.size(all_labels) - 1
            lb = array.get(all_labels, i)
            label.set_x(lb, lbl_x)
