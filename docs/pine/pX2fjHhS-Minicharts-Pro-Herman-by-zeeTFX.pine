// --- Auto SMT Detection ---
makeSymbol(string ticker) =>
    str.length(syminfo.prefix) > 0 ? syminfo.prefix + ":" + ticker : ticker

getAutoSmtSymbol() =>
    root = str.upper(syminfo.root)
    ticker = str.upper(syminfo.ticker)
    target = syminfo.tickerid

    if root == "XAUUSD" or ticker == "XAUUSD"
        target := makeSymbol("XAGUSD")
    else if root == "XAGUSD" or ticker == "XAGUSD"
        target := makeSymbol("XAUUSD")
    else if root == "BTCUSD" or ticker == "BTCUSD"
        target := makeSymbol("ETHUSD")
    else if root == "ETHUSD" or ticker == "ETHUSD"
        target := makeSymbol("BTCUSD")
    else if root == "BTCUSDT" or ticker == "BTCUSDT"
        target := makeSymbol("ETHUSDT")
    else if root == "ETHUSDT" or ticker == "ETHUSDT"
        target := makeSymbol("BTCUSDT")
    else if root == "MNQ"
        target := "CME_MINI:MES1!"
    else if root == "MES"
        target := "CME_MINI:MNQ1!"
    else if root == "NQ"
        target := "CME_MINI:ES1!"
    else if root == "ES"
        target := "CME_MINI:NQ1!"
    else if root == "EURUSD" or ticker == "EURUSD"
        target := makeSymbol("GBPUSD")
    else if root == "GBPUSD" or ticker == "GBPUSD"
        target := makeSymbol("EURUSD")
    else if root == "US100" or ticker == "US100" or root == "NAS100" or ticker == "NAS100" or root == "USTEC" or ticker == "USTEC"
        target := makeSymbol("US500")
    else if root == "US500" or ticker == "US500" or root == "SPX500" or ticker == "SPX500"
        target := makeSymbol("US100")
    else if root == "USOIL" or ticker == "USOIL" or root == "USOILSPOT" or ticker == "USOILSPOT" or root == "WTI" or ticker == "WTI"
        target := "TVC:DXY"
    else if root == "DXY" or ticker == "DXY"
        target := makeSymbol("USOIL")
    else if root == "YM" or root == "MYM"
        target := "CME_MINI:ES1!"
    else if root == "GC" or root == "MGC"
        target := "COMEX:SI1!"
    else if root == "SI"
        target := "COMEX:GC1!"
    else if root == "CL" or root == "MCL"
        target := "TVC:DXY"
    else if root == "RB"
        target := "NYMEX:CL1!"
    target

activeAutoSym = getAutoSmtSymbol()

