// --- Theme Helpers ---
isColorDark(color col) =>
    ((color.r(col) * 299.0) + (color.g(col) * 587.0) + (color.b(col) * 114.0)) / 1000.0 < 128.0

bool isDarkTheme = themeMode == "Dark" ? true : themeMode == "Light" ? false : isColorDark(chart.bg_color)
color bullColor = isDarkTheme ? darkBullColor : lightBullColor
color bearColor = isDarkTheme ? darkBearColor : lightBearColor
color wickColor = isDarkTheme ? darkWickColor : lightWickColor
color tbrBullColor = isDarkTheme ? darkTbrBullColor : lightTbrBullColor
color tbrBearColor = isDarkTheme ? darkTbrBearColor : lightTbrBearColor
color frameBgColor = color.new(chart.fg_color, 95)
color frameBorderColor = color.new(chart.fg_color, 80)
color tfLabelColor = chart.fg_color
color smtTableBgColor = color.new(chart.bg_color, 15)
color smtTableTextColor = chart.fg_color

getLabelSize(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.tiny

// --- Symbol Helper ---
cleanSymbolName(string symbolName) =>
    string resolved = resolveSymbolInput(symbolName, symbolName)
    int colonPos = str.pos(resolved, ":")
    not na(colonPos) ? str.substring(resolved, colonPos + 1, str.length(resolved)) : resolved

isCurrencyCode(string c) =>
    c == "AUD" or c == "CAD" or c == "CHF" or c == "EUR" or c == "GBP" or c == "JPY" or c == "NZD" or c == "USD"

isForexSymbol(string symbolName) =>
    string s = str.upper(cleanSymbolName(symbolName))
    if str.length(s) >= 6
        string base = str.substring(s, 0, 3)
        string quote = str.substring(s, 3, 6)
        isCurrencyCode(base) and isCurrencyCode(quote)
    else
        false

containsText(string source, string needle) =>
    not na(str.pos(source, needle))

isGoldSymbol(string symbolName) =>
    string s = str.upper(cleanSymbolName(symbolName))
    containsText(s, "XAU") or containsText(s, "GOLD") or s == "GC" or s == "GC1!" or s == "MGC" or s == "MGC1!"

isIndexSymbol(string symbolName) =>
    string s = str.upper(cleanSymbolName(symbolName))
    bool isIndex = false
    isIndex := isIndex or containsText(s, "US100")
    isIndex := isIndex or containsText(s, "NAS100")
    isIndex := isIndex or containsText(s, "USTEC")
    isIndex := isIndex or containsText(s, "NASDAQ")
    isIndex := isIndex or containsText(s, "NDX")
    isIndex := isIndex or s == "NQ" or s == "NQ1!" or s == "MNQ" or s == "MNQ1!"
    isIndex := isIndex or containsText(s, "US500")
    isIndex := isIndex or containsText(s, "SPX")
    isIndex := isIndex or containsText(s, "SP500")
    isIndex := isIndex or s == "ES" or s == "ES1!" or s == "MES" or s == "MES1!"
    isIndex := isIndex or containsText(s, "US30")
    isIndex := isIndex or containsText(s, "DJI")
    isIndex := isIndex or containsText(s, "DOW")
    isIndex := isIndex or s == "YM" or s == "YM1!" or s == "MYM" or s == "MYM1!"
    isIndex := isIndex or containsText(s, "GER40")
    isIndex := isIndex or containsText(s, "DE40")
    isIndex := isIndex or containsText(s, "DAX")
    isIndex := isIndex or containsText(s, "UK100")
    isIndex := isIndex or containsText(s, "FTSE")
    isIndex := isIndex or containsText(s, "JP225")
    isIndex := isIndex or containsText(s, "JPN225")
    isIndex := isIndex or containsText(s, "HK50")
    isIndex := isIndex or containsText(s, "HSI")
    isIndex := isIndex or containsText(s, "AUS200")
    isIndex := isIndex or containsText(s, "FRA40")
    isIndex := isIndex or containsText(s, "CAC")
    isIndex := isIndex or containsText(s, "EU50")
    isIndex := isIndex or containsText(s, "STOXX")
    isIndex

formatPriceScaleText(string symbolName, float price) =>
    isForexSymbol(symbolName) ? str.tostring(price, "#.####") : (isGoldSymbol(symbolName) or isIndexSymbol(symbolName) ? str.tostring(price, "#.##") : str.tostring(price, "#.####"))

// --- Types ---
type BarData
    float o
    float h
    float l
    float c
    float vol
    float ch
    float cl
    float e
    float m2
    float m3
    float m4
    float sv
    float dv
    float wv
    int t

type Store
    float[] oArr
    float[] hArr
    float[] lArr
    float[] cArr
    float[] volArr
    float[] chArr
    float[] clArr
    float[] eArr
    float[] m2Arr
    float[] m3Arr
    float[] m4Arr
    float[] svArr
    float[] dvArr
    float[] wvArr
    int[] tArr
    string tf

// --- TBR 9 AM / 3 PM NY Candle Helper ---
isH1Timeframe(string tf) =>
    string t = str.upper(tf)
    t == "60" or t == "1H" or t == "60M"

isLowerThanH1Timeframe(string tf) =>
    int tfSec = timeframe.in_seconds(tf)
    not na(tfSec) and tfSec < 3600

isTbrCandle(BarData b, string tfName) =>
    int nyHour = hour(b.t, "America/New_York")
    int nyMinute = minute(b.t, "America/New_York")
    bool isTbrHour = not na(b.t) and (nyHour == 9 or nyHour == 15)
    bool isTbrH1 = isH1Timeframe(tfName) and nyMinute == 0 and isTbrHour
    bool isTbrLowerTf = showTbrLowerTf and isLowerThanH1Timeframe(tfName) and isTbrHour
    showTbr and not na(b.t) and (isTbrH1 or isTbrLowerTf)

// --- SMT Table ---
var table smtTbl = table.new(position.top_right, 1, 1)

// --- Moving Average Calculation ---
calcMA(string maType, int len) =>
    float src = close
    float emaA = ta.ema(src, len)
    float emaB = ta.ema(emaA, len)
    float emaC = ta.ema(emaB, len)
    switch maType
        "EMA"  => emaA
        "SMA"  => ta.sma(src, len)
        "TEMA" => 3.0 * emaA - 3.0 * emaB + emaC
        "SMMA" => ta.rma(src, len)
        "WMA"  => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        => emaA

// --- Data Fetching ---
getMainData() =>
    float e  = calcMA(emaType, emaPeriod)
    float m2 = calcMA(ma2Type, ma2Period)
    float m3 = calcMA(ma3Type, ma3Period)
    float m4 = calcMA(ma4Type, ma4Period)
    float sv = ta.vwap(hlc3)
    float dv = ta.vwap(hlc3, timeframe.change("D"))
    float wv = ta.vwap(hlc3, timeframe.change("W"))
    [open, high, low, close, volume, e, m2, m3, m4, sv, dv, wv, time, time[1], open[1], high[1], low[1], close[1], volume[1], e[1], m2[1], m3[1], m4[1], sv[1], dv[1], wv[1]]

fetchData(string sym, string tf, string corr, Store s, int count) =>
    [o0, h0, l0, c0, vol0, e0, m20, m30, m40, sv0, dv0, wv0, t0, t1, o1, h1, l1, c1, vol1, e1, m21, m31, m41, sv1, dv1, wv1] = request.security(sym, tf, getMainData())
    
    [ch0, cl0, ch1, cl1] = request.security(corr, tf, 
         [high, low, high[1], low[1]], ignore_invalid_symbol = true)

    tfChanged = ta.change(t0) != 0
    if not na(t0) and tfChanged
        array.unshift(s.oArr, o1)
        array.unshift(s.hArr, h1)
        array.unshift(s.lArr, l1)
        array.unshift(s.cArr, c1)
        array.unshift(s.volArr, nz(vol1))
        array.unshift(s.chArr, nz(ch1, h1))
        array.unshift(s.clArr, nz(cl1, l1))
        array.unshift(s.eArr, nz(e1))
        array.unshift(s.m2Arr, nz(m21))
        array.unshift(s.m3Arr, nz(m31))
        array.unshift(s.m4Arr, nz(m41))
        array.unshift(s.svArr, nz(sv1))
        array.unshift(s.dvArr, nz(dv1))
        array.unshift(s.wvArr, nz(wv1))
        array.unshift(s.tArr, t1)
        
        if array.size(s.oArr) > count
            array.pop(s.oArr)
            array.pop(s.hArr)
            array.pop(s.lArr)
            array.pop(s.cArr)
            array.pop(s.volArr)
            array.pop(s.chArr)
            array.pop(s.clArr)
            array.pop(s.eArr)
            array.pop(s.m2Arr)
            array.pop(s.m3Arr)
            array.pop(s.m4Arr)
            array.pop(s.svArr)
            array.pop(s.dvArr)
            array.pop(s.wvArr)
            array.pop(s.tArr)

    array<BarData> bars = array.new<BarData>()
    bars.push(BarData.new(o0, h0, l0, c0, nz(vol0), nz(ch0, h0), nz(cl0, l0), e0, m20, m30, m40, sv0, dv0, wv0, t0))
    if array.size(s.oArr) > 0
        for i = 0 to array.size(s.oArr) - 1
            bars.push(BarData.new(
                 array.get(s.oArr, i), array.get(s.hArr, i),
                 array.get(s.lArr, i), array.get(s.cArr, i),
                 array.get(s.volArr, i), array.get(s.chArr, i), array.get(s.clArr, i),
                 array.get(s.eArr, i), array.get(s.m2Arr, i), array.get(s.m3Arr, i), array.get(s.m4Arr, i),
                 array.get(s.svArr, i), array.get(s.dvArr, i), array.get(s.wvArr, i), array.get(s.tArr, i)))
    bars

// --- Compact Lower-Timeframe Fetch ---
// Used when the main chart timeframe is higher than the minichart timeframe.
// This collects every lower-timeframe candle inside each host candle so M5/M15/M60 minicharts stay compact on H1/H4/D charts.
getMainCurrentData() =>
    float e  = calcMA(emaType, emaPeriod)
    float m2 = calcMA(ma2Type, ma2Period)
    float m3 = calcMA(ma3Type, ma3Period)
    float m4 = calcMA(ma4Type, ma4Period)
    float sv = ta.vwap(hlc3)
    float dv = ta.vwap(hlc3, timeframe.change("D"))
    float wv = ta.vwap(hlc3, timeframe.change("W"))
    [open, high, low, close, volume, e, m2, m3, m4, sv, dv, wv, time]

shouldUseLowerTfFetch(string tf) =>
    int miniSec = timeframe.in_seconds(tf)
    int chartSec = timeframe.in_seconds(timeframe.period)
    bool validTf = not na(miniSec) and not na(chartSec) and miniSec > 0 and chartSec > 0
    float ratio = validTf ? chartSec / miniSec : na
    validTf and miniSec < chartSec and miniSec < 86400 and ratio <= 500

trimStore(Store s, int count) =>
    while array.size(s.oArr) > count
        array.pop(s.oArr)
        array.pop(s.hArr)
        array.pop(s.lArr)
        array.pop(s.cArr)
        array.pop(s.volArr)
        array.pop(s.chArr)
        array.pop(s.clArr)
        array.pop(s.eArr)
        array.pop(s.m2Arr)
        array.pop(s.m3Arr)
        array.pop(s.m4Arr)
        array.pop(s.svArr)
        array.pop(s.dvArr)
        array.pop(s.wvArr)
        array.pop(s.tArr)

fetchDataLower(string sym, string tf, string corr, Store s, int count) =>
    [oLArr, hLArr, lLArr, cLArr, volLArr, eLArr, m2LArr, m3LArr, m4LArr, svLArr, dvLArr, wvLArr, tLArr] = request.security_lower_tf(sym, tf, getMainCurrentData())
    [chLArr, clLArr] = request.security_lower_tf(corr, tf, [high, low], ignore_invalid_symbol = true)

    int lowerBars = array.size(oLArr)
    if lowerBars > 0
        for j = 0 to lowerBars - 1
            int t = array.get(tLArr, j)
            float o = array.get(oLArr, j)
            float h = array.get(hLArr, j)
            float l = array.get(lLArr, j)
            float c = array.get(cLArr, j)
            if not na(t) and not na(o) and not na(h) and not na(l) and not na(c)
                float vol = nz(array.get(volLArr, j))
                float ch = array.size(chLArr) > j ? nz(array.get(chLArr, j), h) : h
                float cl = array.size(clLArr) > j ? nz(array.get(clLArr, j), l) : l
                float e = array.get(eLArr, j)
                float m2 = array.get(m2LArr, j)
                float m3 = array.get(m3LArr, j)
                float m4 = array.get(m4LArr, j)
                float sv = array.get(svLArr, j)
                float dv = array.get(dvLArr, j)
                float wv = array.get(wvLArr, j)

                bool hasBars = array.size(s.tArr) > 0
                int newestT = hasBars ? array.get(s.tArr, 0) : na

                if hasBars and t == newestT
                    array.set(s.oArr, 0, o)
                    array.set(s.hArr, 0, h)
                    array.set(s.lArr, 0, l)
                    array.set(s.cArr, 0, c)
                    array.set(s.volArr, 0, vol)
                    array.set(s.chArr, 0, ch)
                    array.set(s.clArr, 0, cl)
                    array.set(s.eArr, 0, e)
                    array.set(s.m2Arr, 0, m2)
                    array.set(s.m3Arr, 0, m3)
                    array.set(s.m4Arr, 0, m4)
                    array.set(s.svArr, 0, sv)
                    array.set(s.dvArr, 0, dv)
                    array.set(s.wvArr, 0, wv)
                    array.set(s.tArr, 0, t)
                else if not hasBars or t > newestT
                    array.unshift(s.oArr, o)
                    array.unshift(s.hArr, h)
                    array.unshift(s.lArr, l)
                    array.unshift(s.cArr, c)
                    array.unshift(s.volArr, vol)
                    array.unshift(s.chArr, ch)
                    array.unshift(s.clArr, cl)
                    array.unshift(s.eArr, e)
                    array.unshift(s.m2Arr, m2)
                    array.unshift(s.m3Arr, m3)
                    array.unshift(s.m4Arr, m4)
                    array.unshift(s.svArr, sv)
                    array.unshift(s.dvArr, dv)
                    array.unshift(s.wvArr, wv)
                    array.unshift(s.tArr, t)
                    trimStore(s, count)

    array<BarData> bars = array.new<BarData>()
    if array.size(s.oArr) > 0
        for i = 0 to array.size(s.oArr) - 1
            bars.push(BarData.new(
                 array.get(s.oArr, i), array.get(s.hArr, i),
                 array.get(s.lArr, i), array.get(s.cArr, i),
                 array.get(s.volArr, i), array.get(s.chArr, i), array.get(s.clArr, i),
                 array.get(s.eArr, i), array.get(s.m2Arr, i), array.get(s.m3Arr, i), array.get(s.m4Arr, i),
                 array.get(s.svArr, i), array.get(s.dvArr, i), array.get(s.wvArr, i), array.get(s.tArr, i)))
    bars

// --- Memory-Safe Direct HTF Snapshot ---
// Used only for Daily and higher minicharts so they stay fully populated on M1 without loading huge collections for every minichart.
isDirectHistoryTf(string tf) =>
    int tfSec = timeframe.in_seconds(tf)
    not na(tfSec) and tfSec >= 86400

getMainArraysLast(int count) =>
    array<float> oArr   = array.new<float>()
    array<float> hArr   = array.new<float>()
    array<float> lArr   = array.new<float>()
    array<float> cArr   = array.new<float>()
    array<float> volArr = array.new<float>()
    array<float> eArr   = array.new<float>()
    array<float> m2Arr  = array.new<float>()
    array<float> m3Arr  = array.new<float>()
    array<float> m4Arr  = array.new<float>()
    array<float> svArr  = array.new<float>()
    array<float> dvArr  = array.new<float>()
    array<float> wvArr  = array.new<float>()
    array<int>   tArr   = array.new<int>()

    // Keep MA/VWAP calculations outside the last-bar-only block.
    // On Daily/higher minicharts, Pine must calculate these series on every requested bar first;
    // otherwise direct-history Daily MA/VWAP arrays can come back as na.
    float e  = calcMA(emaType, emaPeriod)
    float m2 = calcMA(ma2Type, ma2Period)
    float m3 = calcMA(ma3Type, ma3Period)
    float m4 = calcMA(ma4Type, ma4Period)
    float sv = ta.vwap(hlc3)
    float dv = ta.vwap(hlc3, timeframe.change("D"))
    float wv = ta.vwap(hlc3, timeframe.change("W"))

    if barstate.islast
        int safeCount = math.max(1, math.min(count, 60))

        for i = 0 to safeCount - 1
            array.push(oArr, open[i])
            array.push(hArr, high[i])
            array.push(lArr, low[i])
            array.push(cArr, close[i])
            array.push(volArr, volume[i])
            array.push(eArr, e[i])
            array.push(m2Arr, m2[i])
            array.push(m3Arr, m3[i])
            array.push(m4Arr, m4[i])
            array.push(svArr, sv[i])
            array.push(dvArr, dv[i])
            array.push(wvArr, wv[i])
            array.push(tArr, time[i])

    [oArr, hArr, lArr, cArr, volArr, eArr, m2Arr, m3Arr, m4Arr, svArr, dvArr, wvArr, tArr]

getCorrArraysLast(int count) =>
    array<float> chArr = array.new<float>()
    array<float> clArr = array.new<float>()

    if barstate.islast
        int safeCount = math.max(1, math.min(count, 60))
        for i = 0 to safeCount - 1
            array.push(chArr, high[i])
            array.push(clArr, low[i])

    [chArr, clArr]

fetchDataDirect(string sym, string tf, string corr, int count) =>
    [oReqArr, hReqArr, lReqArr, cReqArr, volReqArr, eReqArr, m2ReqArr, m3ReqArr, m4ReqArr, svReqArr, dvReqArr, wvReqArr, tReqArr] = request.security(sym, tf, getMainArraysLast(count))
    [chReqArr, clReqArr] = request.security(corr, tf, getCorrArraysLast(count), ignore_invalid_symbol = true)

    array<BarData> bars = array.new<BarData>()
    int reqSize = math.min(count, array.size(oReqArr))

    if reqSize > 0
        for i = 0 to reqSize - 1
            float o = array.get(oReqArr, i)
            float h = array.get(hReqArr, i)
            float l = array.get(lReqArr, i)
            float c = array.get(cReqArr, i)
            int   t = array.get(tReqArr, i)

            if not na(t) and not na(o) and not na(h) and not na(l) and not na(c)
                float vol = nz(array.get(volReqArr, i))
                float ch  = array.size(chReqArr) > i ? nz(array.get(chReqArr, i), h) : h
                float cl  = array.size(clReqArr) > i ? nz(array.get(clReqArr, i), l) : l
                bars.push(BarData.new(
                     o, h, l, c, vol, ch, cl,
                     array.get(eReqArr, i), array.get(m2ReqArr, i), array.get(m3ReqArr, i), array.get(m4ReqArr, i),
                     array.get(svReqArr, i), array.get(dvReqArr, i), array.get(wvReqArr, i), t))
    bars

// --- Store Initialization ---
var s1 = Store.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<int>(), tf1)
var s2 = Store.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<int>(), tf2)
var s3 = Store.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<int>(), tf3)

data1 = show1 and not isDirectHistoryTf(tf1) ? (shouldUseLowerTfFetch(tf1) ? fetchDataLower(activeMiniSym1, tf1, activeSmtSym, s1, barsCount) : fetchData(activeMiniSym1, tf1, activeSmtSym, s1, barsCount)) : na
data2 = show2 and not isDirectHistoryTf(tf2) ? (shouldUseLowerTfFetch(tf2) ? fetchDataLower(activeMiniSym2, tf2, activeSmtSym, s2, barsCount) : fetchData(activeMiniSym2, tf2, activeSmtSym, s2, barsCount)) : na
data3 = show3 and not isDirectHistoryTf(tf3) ? (shouldUseLowerTfFetch(tf3) ? fetchDataLower(activeMiniSym3, tf3, activeSmtSym, s3, barsCount) : fetchData(activeMiniSym3, tf3, activeSmtSym, s3, barsCount)) : na

// --- Global Context ---
float g_fullH = ta.highest(high, 300)
float g_fullL = ta.lowest(low, 300)
float g_atr   = ta.atr(14)

// --- Drawing Arrays ---
var box[]      boxArr      = array.new<box>()
var line[]     lineArr     = array.new<line>()
var label[]    lblArr      = array.new<label>()
var polyline[] polyArr     = array.new<polyline>()
var linefill[] fvgFillArr  = array.new<linefill>()

// --- FVG Fill Helper ---
// Line fills render behind candle wick lines and candle body boxes.
drawFvgFill(int leftX, float topY, int rightX, float bottomY, color fillColor) =>
    line topBoundary = line.new(leftX, topY, rightX, topY, color = color.new(fillColor, 100))
    line bottomBoundary = line.new(leftX, bottomY, rightX, bottomY, color = color.new(fillColor, 100))
    array.push(lineArr, topBoundary)
    array.push(lineArr, bottomBoundary)
    array.push(fvgFillArr, linefill.new(topBoundary, bottomBoundary, color.new(fillColor, fvgTransparency)))

// --- VWAP Line Helper ---
drawVwapLine(array<BarData> bars, int n, int xS, float bY, float sB, float dR, float uH, int spacing, string mode, color clr) =>
    array<chart.point> pts = array.new<chart.point>()
    for i = 0 to n - 1
        b = array.get(bars, i)
        float v = mode == "S" ? b.sv : mode == "D" ? b.dv : b.wv
        if not na(v)
            int x = xS + (n - 1 - i) * spacing
            float y = bY + math.max(0.0, math.min(1.0, (v - sB) / dR)) * uH
            array.push(pts, chart.point.from_index(x, y))
    if array.size(pts) > 1
        array.push(polyArr, polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_index, line_color = clr, line_width = 1))

// --- Moving Average Line Helper ---
drawMaLine(array<BarData> bars, int n, int xS, float bY, float sB, float dR, float uH, int spacing, string mode, color clr) =>
    for i = 0 to n - 2
        b1 = array.get(bars, i)
        b2 = array.get(bars, i + 1)
        float v1 = mode == "1" ? b1.e : mode == "2" ? b1.m2 : mode == "3" ? b1.m3 : b1.m4
        float v2 = mode == "1" ? b2.e : mode == "2" ? b2.m2 : mode == "3" ? b2.m3 : b2.m4
        if not na(v1) and not na(v2)
            x1 = xS + (n-1-i) * spacing
            x2 = xS + (n-1-(i+1)) * spacing
            y1 = bY + math.max(0.0, math.min(1.0, (v1 - sB) / dR)) * uH
            y2 = bY + math.max(0.0, math.min(1.0, (v2 - sB) / dR)) * uH
            array.push(lineArr, line.new(x1, y1, x2, y2, color = clr, width = 1))

// --- Render Function ---
renderMini(array<BarData> bars, int col, int row, string tfName, string symbolName, string chartType, bool useSmt, bool useMa1, bool useMa2, bool useMa3, bool useMa4, bool useVolume, bool useSessVwap, bool useDailyVwap, bool useWeeklyVwap) =>
    if not na(bars) and array.size(bars) > 0
        float fullH = g_fullH
        float fullL = g_fullL
        float fullR = fullH - fullL
        if na(fullR) or fullR < (g_atr * 3)
            fullR := nz(g_atr * 3, syminfo.mintick * 100)

        float uH = fullR * ySizePerc
        float bY = fullH - (row - 1) * (uH + fullR * yGapRows) - uH
        int n = array.size(bars), cW = (barsCount - 1) * barSpacing
        int xS = bar_index + xOff + (col - 1) * (cW + xGapCols), xE = xS + cW
        int plotXS = xS + candleHorizontalShift, plotXE = plotXS + cW
        float plotBY = bY + (uH * candleVerticalShift)

        int bgPadX = bgBoxHorizontalExtend
        float bgPadY = uH * bgBoxVerticalExtend
        int bgLeftX = xS - barSpacing - bgPadX
        int bgRightX = xE + barSpacing + 5 + bgPadX

        if showBgBoxes
            array.push(boxArr, box.new(bgLeftX, bY + uH + bgPadY, bgRightX, bY - bgPadY,
                 bgcolor = frameBgColor, border_color = frameBorderColor))

        float dMax = -1.0e10, float dMin = 1.0e10
        float vMax = 0.0
        for i = 0 to n - 1
            bv = array.get(bars, i)
            dMax := math.max(dMax, nz(bv.h, dMax))
            dMin := math.min(dMin, nz(bv.l, dMin))
            vMax := math.max(vMax, nz(bv.vol, 0))

        float diff = dMax - dMin
        float dR = diff <= 0 ? syminfo.mintick : diff * 1.25
        float sB = ((dMax + dMin) / 2) - (dR / 2)
        int bHW = math.max(1, int(barSpacing * 0.35))
        int maxBodyHW = math.max(0, int(math.floor((barSpacing - 1) / 2.0)))
        int cHW = math.min(candleBodyHalfWidth, maxBodyHW)

        // --- Price Scale ---
        if showPriceScale
            int psLevels = math.max(2, math.min(12, priceScaleLevels))
            int psLineRightX = bgRightX - 1
            int psLineLeftX = psLineRightX - barSpacing * 1
            int psLabelX = bgRightX + barSpacing + priceScaleRightShift
            for ps = 0 to psLevels - 1
                float psRatio = psLevels == 1 ? 0.0 : ps / (psLevels - 1.0)
                float psPrice = sB + dR * psRatio
                float psY = plotBY + psRatio * uH
                array.push(lineArr, line.new(psLineLeftX, psY, psLineRightX, psY, color = priceScaleFontColor, style = line.style_dotted, width = 1))
                string psText = formatPriceScaleText(symbolName, psPrice)
                array.push(lblArr, label.new(psLabelX, psY, psText, color = #00000000, textcolor = priceScaleFontColor, style = label.style_label_left, size = getLabelSize(priceScaleFontSize)))

        // --- Bias Framework Logic ---
        if n > 2
            c1 = array.get(bars, 2) // Previous bar
            c2 = array.get(bars, 1) // Most recent closed bar
            
            string biasTxt = "AVOID X"
            color biasClr  = biasAvoid
            
            bool sweepHigh = c2.h > c1.h
            bool sweepLow  = c2.l < c1.l
            bool inside    = c2.h <= c1.h and c2.l >= c1.l
            bool outside   = sweepHigh and sweepLow
            
            if outside or inside
                biasTxt := "AVOID X"
                biasClr := biasAvoid
            else if sweepHigh
                if c2.c > c1.h
                    biasTxt := "BULLISH"
                    biasClr := biasBull
                else
                    biasTxt := "BEARISH"
                    biasClr := biasBear
            else if sweepLow
                if c2.c < c1.l
                    biasTxt := "BEARISH"
                    biasClr := biasBear
                else
                    biasTxt := "BULLISH"
                    biasClr := biasBull
            
            if showBias
                array.push(lblArr, label.new(xS + cW / 2, bY + uH, biasTxt, color = #00000000, textcolor = biasClr, style = label.style_label_down, size = size.small))

            if highlightBias
                int x1 = plotXS + (n - 3) * barSpacing - bHW
                int x2 = plotXS + (n - 2) * barSpacing + bHW
                // Pionowy pas przez cala wysokosc ramki minicharta
                int signalBorderTransparency = math.min(100, signalFillTransparency + 3)
                array.push(boxArr, box.new(x1, plotBY + uH, x2, plotBY, bgcolor = color.new(biasClr, signalFillTransparency), border_color = color.new(biasClr, signalBorderTransparency)))
                // Subtelna linia na dole ramki pod swiecami sygnalowymi
                array.push(lineArr, line.new(x1, plotBY, x2, plotBY, color = biasClr, width = 2))

        // --- SMT ---
        if useSmt and n > (smtLookback * 2)
            int lastH = -1, int lastL = -1
            for i = smtLookback to n - smtLookback - 1
                bp = array.get(bars, i)
                bool isPH = true, bool isPL = true
                for k = 1 to smtLookback
                    if nz(array.get(bars, i-k).h) > bp.h or nz(array.get(bars, i+k).h) > bp.h
                        isPH := false
                    if nz(array.get(bars, i-k).l) < bp.l or nz(array.get(bars, i+k).l) < bp.l
                        isPL := false
                if isPH
                    if lastH != -1
                        prev = array.get(bars, lastH)
                        if (bp.h - prev.h) * (bp.ch - prev.ch) < 0
                            array.push(lineArr, line.new(plotXS + (n-1-lastH)*barSpacing, plotBY+(prev.h-sB)/dR*uH, plotXS + (n-1-i)*barSpacing, plotBY+(bp.h-sB)/dR*uH, color = smtHighColor))
                            array.push(lblArr, label.new(plotXS + (n-1-i)*barSpacing, plotBY+(bp.h-sB)/dR*uH, "✦", style = label.style_label_down, color = #00000000, textcolor = smtHighColor, size = size.tiny))
                    lastH := i
                if isPL
                    if lastL != -1
                        prev = array.get(bars, lastL)
                        if (bp.l - prev.l) * (bp.cl - prev.cl) < 0
                            array.push(lineArr, line.new(plotXS + (n-1-lastL)*barSpacing, plotBY+(prev.l-sB)/dR*uH, plotXS + (n-1-i)*barSpacing, plotBY+(bp.l-sB)/dR*uH, color = smtLowColor))
                            array.push(lblArr, label.new(plotXS + (n-1-i)*barSpacing, plotBY+(bp.l-sB)/dR*uH, "❖", style = label.style_label_up, color = #00000000, textcolor = smtLowColor, size = size.tiny))
                    lastL := i

        // --- FVG ---
        for i = 0 to n - 1
            b = array.get(bars, i)
            int p = n-1-i, x = plotXS + p*barSpacing
            if showFvg and i <= n-4
                b1 = array.get(bars, i+1), b3 = array.get(bars, i+3)
                if b1.l > b3.h or b3.l > b1.h
                    isBu = b1.l > b3.h
                    fT = isBu ? b1.l : b3.l, fB = isBu ? b3.h : b1.h
                    int fvgBaseRightX = plotXS + (n-1-i) * barSpacing + bHW
                    int fvgCountRightX = math.min(plotXE + 4, fvgBaseRightX + (fvgExtendCandles - 1) * barSpacing)
                    int fvgCurrentMarketRightX = plotXS + (n - 1) * barSpacing + bHW
                    int selectedFvgRightX = fvgExt == "Extended" ? plotXE + 4 : fvgExt == "Current Market Price" ? fvgCurrentMarketRightX : fvgExt == "Number of Candles" ? fvgCountRightX : fvgBaseRightX

                    isInv = false
                    for k = 0 to i
                        if (isBu and nz(array.get(bars, k).c) < fB) or (not isBu and nz(array.get(bars, k).c) > fT)
                            isInv := true
                            break

                    int fvgLeftX = plotXS + (n-1-(i+2))*barSpacing - bHW
                    color activeFvgColor = isBu ? bullFvgClr : bearFvgClr

                    if isInv
                        // Preserve the existing inverted-FVG display and stop it at a full fill.
                        bool invFullyFilled = false
                        int invFullFillRightX = selectedFvgRightX
                        for mitigationStep = 0 to i
                            int mitigationIndex = i - mitigationStep
                            mitigationBar = array.get(bars, mitigationIndex)
                            int mitigationRightX = plotXS + (n - 1 - mitigationIndex) * barSpacing + bHW
                            if mitigationRightX <= selectedFvgRightX
                                if (isBu and mitigationBar.l <= fB) or (not isBu and mitigationBar.h >= fT)
                                    invFullyFilled := true
                                    invFullFillRightX := mitigationRightX
                                    break
                        int invRightX = invFullyFilled ? math.min(selectedFvgRightX, invFullFillRightX) : selectedFvgRightX
                        if invRightX > fvgLeftX
                            drawFvgFill(fvgLeftX, plotBY+(fT-sB)/dR*uH, invRightX, plotBY+(fB-sB)/dR*uH, invFvgClr)
                    else
                        // Each tapped portion remains visible only up to the candle that tapped it.
                        // The still-unfilled portion starts after that candle and keeps extending.
                        float remainingTop = fT
                        float remainingBottom = fB
                        int remainingLeftX = fvgLeftX
                        bool fvgFullyFilled = false

                        for mitigationStep = 0 to i
                            int mitigationIndex = i - mitigationStep
                            mitigationBar = array.get(bars, mitigationIndex)
                            int mitigationX = plotXS + (n - 1 - mitigationIndex) * barSpacing

                            if mitigationX <= selectedFvgRightX
                                bool tappedRemaining = isBu ? mitigationBar.l <= remainingTop : mitigationBar.h >= remainingBottom
                                if tappedRemaining
                                    // Keep the old FVG state marked up to this tap candle,
                                    // but never extend that old state beyond the tap.
                                    if mitigationX > remainingLeftX
                                        drawFvgFill(remainingLeftX, plotBY+(remainingTop-sB)/dR*uH, mitigationX, plotBY+(remainingBottom-sB)/dR*uH, activeFvgColor)

                                    if isBu
                                        if mitigationBar.l <= fB
                                            remainingTop := fB
                                            fvgFullyFilled := true
                                        else
                                            remainingTop := math.max(fB, mitigationBar.l)
                                    else
                                        if mitigationBar.h >= fT
                                            remainingBottom := fT
                                            fvgFullyFilled := true
                                        else
                                            remainingBottom := math.min(fT, mitigationBar.h)

                                    remainingLeftX := mitigationX
                                    if fvgFullyFilled
                                        break

                        // Only the currently unfilled remainder is extended.
                        if not fvgFullyFilled and selectedFvgRightX > remainingLeftX
                            drawFvgFill(remainingLeftX, plotBY+(remainingTop-sB)/dR*uH, selectedFvgRightX, plotBY+(remainingBottom-sB)/dR*uH, activeFvgColor)

            // --- Volume ---
            if showVolume and useVolume and vMax > 0
                float volH = (uH * volumeHeightPerc) * math.max(0.0, nz(b.vol, 0)) / vMax
                float vThickness = math.max(0.1, volumeBarThickness)
                int vHW = math.max(1, int(math.round(vThickness)))
                color vClr = b.c >= b.o ? volumeBullColor : volumeBearColor
                if volH > 0
                    if vThickness < 1.0
                        int vLineW = math.max(1, math.min(4, int(math.round(1.0 + vThickness * 2.0))))
                        array.push(lineArr, line.new(x, bY, x, bY + volH, color = vClr, width = vLineW))
                    else
                        array.push(boxArr, box.new(x - vHW, bY + volH, x + vHW, bY, bgcolor = vClr, border_color = vClr))

            // --- Price Chart ---
            bool isTbrMark = isTbrCandle(b, tfName)
            bool isBullCandle = b.c >= b.o
            color c = isTbrMark ? (isBullCandle ? tbrBullColor : tbrBearColor) : (isBullCandle ? bullColor : bearColor)
            color cWick = isTbrMark ? c : wickColor
            float yHigh = plotBY+(b.h-sB)/dR*uH
            float yLow = plotBY+(b.l-sB)/dR*uH
            float yOpen = plotBY+(b.o-sB)/dR*uH
            float yClose = plotBY+(b.c-sB)/dR*uH
            float bodyTop = plotBY+(math.max(b.o,b.c)-sB)/dR*uH
            float bodyBot = plotBY+(math.min(b.o,b.c)-sB)/dR*uH

            if chartType == "Line"
                if i < n - 1
                    bNext = array.get(bars, i + 1)
                    int xNext = plotXS + (n - 1 - (i + 1)) * barSpacing
                    float yNextClose = plotBY+(bNext.c-sB)/dR*uH
                    color lineClr = isTbrMark ? c : (b.c >= bNext.c ? bullColor : bearColor)
                    array.push(lineArr, line.new(xNext, yNextClose, x, yClose, color = lineClr, width = 1))
            else if chartType == "Bars"
                array.push(lineArr, line.new(x, yHigh, x, yLow, color = c, width = 1))
                array.push(lineArr, line.new(x - bHW, yOpen, x, yOpen, color = c, width = 1))
                array.push(lineArr, line.new(x, yClose, x + bHW, yClose, color = c, width = 1))
            else
                int bodyHW = cHW
                if chartType == "Volume Candles" and vMax > 0
                    float vRel = math.max(0.0, math.min(1.0, nz(b.vol, 0) / vMax))
                    int volBodyHW = int(math.round(vRel * maxBodyHW))
                    bodyHW := math.min(maxBodyHW, math.max(0, volBodyHW))
                array.push(lineArr, line.new(x, yHigh, x, yLow, color = cWick))
                if bodyHW == 0
                    array.push(lineArr, line.new(x, bodyTop, x, bodyBot, color = c, width = 1))
                else
                    array.push(boxArr, box.new(x-bodyHW, bodyTop, x+bodyHW, bodyBot, bgcolor = c, border_color = c))

        // --- Moving Averages ---
        if n > 1
            if showEma and useMa1
                drawMaLine(bars, n, plotXS, plotBY, sB, dR, uH, barSpacing, "1", emaColor)
            if showMa2 and useMa2
                drawMaLine(bars, n, plotXS, plotBY, sB, dR, uH, barSpacing, "2", ma2Color)
            if showMa3 and useMa3
                drawMaLine(bars, n, plotXS, plotBY, sB, dR, uH, barSpacing, "3", ma3Color)
            if showMa4 and useMa4
                drawMaLine(bars, n, plotXS, plotBY, sB, dR, uH, barSpacing, "4", ma4Color)

        // --- Session / Daily / Weekly VWAP ---
        if n > 1
            if showSessionVwap and useSessVwap
                drawVwapLine(bars, n, plotXS, plotBY, sB, dR, uH, barSpacing, "S", sessionVwapColor)
            if showDailyVwap and useDailyVwap
                drawVwapLine(bars, n, plotXS, plotBY, sB, dR, uH, barSpacing, "D", dailyVwapColor)
            if showWeeklyVwap and useWeeklyVwap
                drawVwapLine(bars, n, plotXS, plotBY, sB, dR, uH, barSpacing, "W", weeklyVwapColor)

        if showTfLabels
            bool tfTop = tfLabelPosition == "Top Right" or tfLabelPosition == "Top Left"
            bool tfLeft = tfLabelPosition == "Top Left" or tfLabelPosition == "Bottom Left"
            bool tfRight = tfLabelPosition == "Top Right" or tfLabelPosition == "Bottom Right"
            int tfX = tfLeft ? xS + barSpacing - tfLabelLeftShift : tfRight ? xE - barSpacing + tfLabelRightShift : xS + cW / 2
            float tfY = tfTop ? bY + uH + (uH * tfLabelTopShift) : bY - (uH * tfLabelBottomShift)
            tfStyle = tfTop ? label.style_label_up : label.style_label_down
            array.push(lblArr, label.new(tfX, tfY, tfName, color = #00000000, textcolor = tfLabelColor, style = tfStyle, size = size.small))

        if showSymbolLabels
            bool symTop = symbolLabelPosition == "Top Right" or symbolLabelPosition == "Top Left"
            bool symLeft = symbolLabelPosition == "Top Left" or symbolLabelPosition == "Bottom Left"
            bool symRight = symbolLabelPosition == "Top Right" or symbolLabelPosition == "Bottom Right"
            int symX = symLeft ? xS + barSpacing - symbolLabelLeftShift : symRight ? xE - barSpacing + symbolLabelRightShift : xS + cW / 2
            float symY = symTop ? bY + uH + (uH * symbolLabelTopShift) : bY - (uH * symbolLabelBottomShift)
            symStyle = symTop ? label.style_label_up : label.style_label_down
            array.push(lblArr, label.new(symX, symY, cleanSymbolName(symbolName), color = #00000000, textcolor = tfLabelColor, style = symStyle, size = size.small))

// --- Draw ---
if barstate.islast
    for b in boxArr
        box.delete(b)
    array.clear(boxArr)
    for lf in fvgFillArr
        linefill.delete(lf)
    array.clear(fvgFillArr)
    for l in lineArr
        line.delete(l)
    array.clear(lineArr)
    for lb in lblArr
        label.delete(lb)
    array.clear(lblArr)
    for pl in polyArr
        polyline.delete(pl)
    array.clear(polyArr)

    if showSmtLabel
        table.cell(smtTbl, 0, 0, "SMT Linked Symbol: " + activeSmtSym, bgcolor = smtTableBgColor, text_color = smtTableTextColor, text_size = size.small)

    array<BarData> drawData1 = show1 and isDirectHistoryTf(tf1) ? fetchDataDirect(activeMiniSym1, tf1, activeSmtSym, barsCount) : data1
    array<BarData> drawData2 = show2 and isDirectHistoryTf(tf2) ? fetchDataDirect(activeMiniSym2, tf2, activeSmtSym, barsCount) : data2
    array<BarData> drawData3 = show3 and isDirectHistoryTf(tf3) ? fetchDataDirect(activeMiniSym3, tf3, activeSmtSym, barsCount) : data3

    renderMini(drawData1, 1, 1, tf1, activeMiniSym1, chartType1, sSmt1, sEma1, sMa2_1, sMa3_1, sMa4_1, sVol1, sSessVwap1, sDailyVwap1, sWeeklyVwap1)
    renderMini(drawData2, 1, 2, tf2, activeMiniSym2, chartType2, sSmt2, sEma2, sMa2_2, sMa3_2, sMa4_2, sVol2, sSessVwap2, sDailyVwap2, sWeeklyVwap2)
    renderMini(drawData3, 1, 3, tf3, activeMiniSym3, chartType3, sSmt3, sEma3, sMa2_3, sMa3_3, sMa4_3, sVol3, sSessVwap3, sDailyVwap3, sWeeklyVwap3)




