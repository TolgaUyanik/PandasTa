// --- Symbol Input Resolver ---
// TradingView futures symbols can sometimes be returned as a JSON-like string from input.symbol().
// This keeps request.security() and minichart labels using only the clean tickerid, e.g. CME_MINI:MNQ1!.
resolveSymbolInput(string inputSymbol, string fallbackSymbol) =>
    string resolved = inputSymbol
    string symbolKey = "\"symbol\":\""
    int keyPos = str.pos(resolved, symbolKey)
    if not na(keyPos)
        int startPos = keyPos + str.length(symbolKey)
        string afterKey = str.substring(resolved, startPos, str.length(resolved))
        int endPos = str.pos(afterKey, "\"")
        resolved := not na(endPos) ? str.substring(afterKey, 0, endPos) : afterKey
    str.length(resolved) == 0 ? fallbackSymbol : resolved

