//@version=6
library("OHLCVRangeX")

import viorel8/OHLCVData/15 as OHLCV

// --- Type Definition ---
export type OHLCVRange
    string id                   // Range type identifier (for user)
    int start_bar_index         // Bar index of first candle
    int end_bar_index           // Bar index of last candle
    int start_time              // Timestamp of first candle
    int end_time                // Timestamp of last candle
    array<OHLCV.OHLCV> candles  // Array of OHLCV structs
    int duration                // Number of candles
    bool isValid                // True if range is actively forming/meeting criteria
    int count                   // Grace-counter / general purpose counter
    int startBarsCounter        // Tracks bars to confirm phase start
    int breakoutConfirmCandles  // Aux counter
    bool finalized              // True if range just hit its end condition

// === UTILITY FUNCTIONS ===

// @function fastClear
// @description Resets an existing range object to its default empty state.
export fastClear(OHLCVRange r) =>
    while (array.size(r.candles) > 0)
        array.pop(r.candles)
    r.start_bar_index := na
    r.end_bar_index   := na
    r.start_time      := na
    r.end_time        := na
    r.duration        := 0
    r.isValid         := false
    r.count           := 0
    r.startBarsCounter := 0
    r.breakoutConfirmCandles := 0
    r.finalized       := false
    r

// @function getRangeHigh
// @description Finds the highest 'high' price from all candles within the range.
export getRangeHigh(OHLCVRange r) =>
    float maxHigh = na
    if (not na(r) and not na(r.candles) and array.size(r.candles) > 0)
        for i = 0 to array.size(r.candles) - 1
            OHLCV.OHLCV c = array.get(r.candles, i)
            if (not na(c))
                maxHigh := na(maxHigh) or c.high > maxHigh ? c.high : maxHigh
    maxHigh

// @function getRangeLow
// @description Finds the lowest 'low' price from all candles within the range.
export getRangeLow(OHLCVRange r) =>
    float minLow = na
    if (not na(r) and not na(r.candles) and array.size(r.candles) > 0)
        for i = 0 to array.size(r.candles) - 1
            OHLCV.OHLCV c = array.get(r.candles, i)
            if (not na(c))
                minLow := na(minLow) or c.low < minLow ? c.low : minLow
    minLow

// @function getRangeVolume
// @description Calculates the sum of all volume from the candles within the range.
export getRangeVolume(OHLCVRange r) =>
    float totalVol = 0.0
    if (not na(r) and not na(r.candles) and array.size(r.candles) > 0)
        for i = 0 to array.size(r.candles) - 1
            OHLCV.OHLCV c = array.get(r.candles, i)
            if (not na(c) and not na(c.volume))
                totalVol += c.volume
    totalVol

// @function getRangeAvg
// @description Calculates the midpoint price of the range's highest high and lowest low.
export getRangeAvg(OHLCVRange r) =>
    float h = getRangeHigh(r)
    float l = getRangeLow(r)
    (na(h) or na(l)) ? na : (h + l) / 2.0

// @function getRangeOpen
// @description Gets the 'open' price of the very first candle in the range.
export getRangeOpen(OHLCVRange r) =>
    (not na(r) and not na(r.candles) and array.size(r.candles) > 0 and not na(array.get(r.candles, 0))) ? array.get(r.candles, 0).open : na

// @function getRangeClose
// @description Gets the 'close' price of the very last candle in the range.
export getRangeClose(OHLCVRange r) =>
    (not na(r) and not na(r.candles) and array.size(r.candles) > 0 and not na(array.get(r.candles, array.size(r.candles) - 1))) ? array.get(r.candles, array.size(r.candles) - 1).close : na

// @function updateRangeCommon
// @description A low-level helper to add the current candle to a range and update its basic properties.
export updateRangeCommon(OHLCVRange r, OHLCV.OHLCV current, bool shouldBeValidAfterAdd) =>
    if (na(r) or na(current))
        r
    else
        if (array.size(r.candles) == 0)
            r.start_bar_index := current.bar_index
            r.start_time      := current.time
        array.push(r.candles, current)
        r.end_bar_index   := current.bar_index
        r.end_time        := current.time
        r.duration        := array.size(r.candles)
        r.isValid         := shouldBeValidAfterAdd
        r.finalized       := false
        r

// @function mergeRanges
// @description Combines two separate OHLCVRange objects into a new one.
export mergeRanges(OHLCVRange r1, OHLCVRange r2) =>
    OHLCVRange merged = OHLCVRange.new()
    merged.candles := array.new<OHLCV.OHLCV>() // Ensure array is initialized
    if (na(r1) and na(r2))
        merged
    else
        string id1_val = (na(r1) or na(r1.id)) ? "" : r1.id
        string id2_val = (na(r2) or na(r2.id)) ? "" : r2.id
        if (id1_val == "" and id2_val == "")
            merged.id := "merged_range"
        else if (id1_val == "")
            merged.id := "merged_with_" + id2_val
        else if (id2_val == "")
            merged.id := id1_val + "_merged"
        else
            merged.id := id1_val + "_&_" + id2_val
        merged

// === CORE RANGE DETECTION FUNCTIONS ===

// @function updateAccumulationRange
// @description REWRITTEN: Correctly identifies low volatility periods with robust state management.
export updateAccumulationRange(OHLCVRange r, OHLCV.OHLCV current, float atr, float atrMultiplier, int minCandles, bool useVolumeFilter, float volMultiplier, int accAvgVolumeLookback, int gracePeriod, int confirmBars) =>
    if r.finalized
        fastClear(r)

    float threshold = atr * atrMultiplier
    bool isVolatilityLow = (current.high - current.low) <= threshold
    bool isVolumeOk = not useVolumeFilter or (volume <= ta.sma(volume, accAvgVolumeLookback) * volMultiplier)
    bool isConditionMet = isVolatilityLow and isVolumeOk

    if r.isValid
        bool breakoutOccurred = current.high > getRangeHigh(r) or current.low < getRangeLow(r)
        if isConditionMet and not breakoutOccurred
            r.count := gracePeriod
            updateRangeCommon(r, current, true)
        else if breakoutOccurred
            r.breakoutConfirmCandles += 1
            if r.breakoutConfirmCandles >= confirmBars
                r.isValid := false
                r.finalized := true
        else 
            if r.count > 0
                r.count -= 1
            else
                r.isValid := false
                r.finalized := true
        
        if not r.isValid
            // CORRECTED: Use the built-in 'bar_index' history, not a field of the 'current' object.
            r.end_bar_index := bar_index[1]
            r.end_time := time[1]
    else
        if isConditionMet
            r.startBarsCounter += 1
            updateRangeCommon(r, current, false)
            if r.startBarsCounter >= minCandles
                r.isValid := true
                r.count := gracePeriod
                r.start_bar_index := current.bar_index - (minCandles - 1)
                r.start_time := time - (minCandles - 1) * timeframe.in_seconds() * 1000
        else
            fastClear(r)
    r

// @function updateCompressionRange
// @description Identifies a sustained phase using the "Smart Grace Period" logic.
export updateCompressionRange(OHLCVRange r, OHLCV.OHLCV current, bool isConditionMet, int minBarsToStart, int consecutiveFailsForExit, float magnitudeMultiplierForExit) =>
    if r.finalized
        fastClear(r)

    if isConditionMet
        r.startBarsCounter += 1
        r.count := 0
        updateRangeCommon(r, current, r.isValid) 

        if not r.isValid and r.startBarsCounter >= minBarsToStart
            r.isValid := true
            r.start_bar_index := current.bar_index - (r.startBarsCounter - 1)
            r.start_time := time - (r.startBarsCounter - 1) * timeframe.in_seconds() * 1000
    else 
        r.startBarsCounter := 0
        if r.isValid
            float rangeHigh = getRangeHigh(r)
            float rangeLow = getRangeLow(r)
            float rangeSpan = na(rangeHigh) or na(rangeLow) ? 0 : rangeHigh - rangeLow
            float mishapSpan = current.high - current.low
            bool isInstantBreakout = rangeSpan > 0 and mishapSpan > (rangeSpan * magnitudeMultiplierForExit)
            r.count += 1
            bool isPersistentFailure = r.count >= consecutiveFailsForExit
            if isInstantBreakout or isPersistentFailure
                updateRangeCommon(r, current, false)
                r.isValid := false
                r.finalized := true
            else
                updateRangeCommon(r, current, true)
    r

// @function updateLowVolumeRange
// @description Handles the specific state logic for the Low Volume Phase (exit on spike).
export updateLowVolumeRange(OHLCVRange r, OHLCV.OHLCV current, bool isLowVolume, bool isSpike, int minBarsToStart, int graceOnNormalVol) =>
    if r.finalized
        fastClear(r)

    if isSpike
        if r.isValid
            updateRangeCommon(r, current, false)
            r.isValid := false
            r.finalized := true
    else if isLowVolume
        r.startBarsCounter += 1
        r.count := graceOnNormalVol
        updateRangeCommon(r, current, r.isValid)
        if not r.isValid and r.startBarsCounter >= minBarsToStart
            r.isValid := true
            r.start_bar_index := current.bar_index - (r.startBarsCounter - 1)
            r.start_time := time - (r.startBarsCounter - 1) * timeframe.in_seconds() * 1000
    else
        r.startBarsCounter := 0
        if r.isValid
            if r.count > 0
                r.count -= 1
                updateRangeCommon(r, current, true)
            else
                r.isValid := false
                r.finalized := true
    r

// @function updateFixedRange
// @description Creates a rolling window range of a fixed number of bars.
export updateFixedRange(OHLCVRange r, OHLCV.OHLCV current, int barsBack) =>
    if (na(r) or na(current) or na(barsBack) or barsBack <= 0)
        r
    else
        updateRangeCommon(r, current, false)
        while (array.size(r.candles) > barsBack)
            array.remove(r.candles, 0)
        if (array.size(r.candles) > 0)
            r.start_bar_index := array.get(r.candles, 0).bar_index
            r.start_time := array.get(r.candles, 0).time
        else if (barsBack > 0)
            r.start_bar_index := na
            r.start_time := na
        r.duration := array.size(r.candles)
        r.isValid := array.size(r.candles) == barsBack
        r.finalized := false
        r
        
// @function updateSessionRange
// @description Creates a range that is active only during a specific time window each day.
export updateSessionRange(OHLCVRange r, OHLCV.OHLCV current, int minuteStart, int minuteEnd) =>
    if (na(r) or na(current))
        r
    else
        if (r.finalized)
            fastClear(r)
        int tot = hour(current.time, syminfo.timezone) * 60 + minute(current.time, syminfo.timezone)
        bool inSession = tot >= minuteStart and tot < minuteEnd
        bool wasValidAndHadCandles = r.isValid and array.size(r.candles) > 0
        if (inSession)
            updateRangeCommon(r, current, true)
        else
            if (wasValidAndHadCandles)
                r.isValid := false
                r.finalized := true
            else if (array.size(r.candles) == 0)
                r.isValid := false
                r.finalized := false
        r

// @function updatePriceZoneRange
// @description Creates a range from candles that fall within a static, predefined price zone.
export updatePriceZoneRange(OHLCVRange r, OHLCV.OHLCV current, float minP, float maxP, float bufferPct=0.01) =>
    if (na(r) or na(current) or na(minP) or na(maxP))
        r
    else
        if (r.finalized)
            fastClear(r)
        float buffer = (maxP - minP) * bufferPct
        bool inZone = current.low >= minP - buffer and current.high <= maxP + buffer
        bool wasValidAndHadCandles = r.isValid and array.size(r.candles) > 0
        if (inZone)
            updateRangeCommon(r, current, true)
        else
            if (wasValidAndHadCandles)
                r.isValid := false
                r.finalized := true
            else if (array.size(r.candles) == 0)
                r.isValid := false
                r.finalized := false
        r

// @function updateManipulationRange
// @description Identifies candles characterized by low volume but high volatility and a large price body.
export updateManipulationRange(OHLCVRange r,OHLCV.OHLCV current,float atr,int minCandles,int gracePeriod,int avgVolumeLookback,float lowVolMultiplier,float highVolAtrMultiplier,float priceDeltaAtrMultiplier) =>
    if (na(r) or na(current) or na(atr))
        r
    else
        if (r.finalized)
            fastClear(r)
        float avgVol = ta.sma(volume, avgVolumeLookback)
        bool isLowVolume = current.volume < avgVol * lowVolMultiplier
        float currentCandleRange = current.high - current.low
        bool isHighVolatility = currentCandleRange > atr * highVolAtrMultiplier
        float currentBodySize = math.abs(current.close - current.open)
        bool isHighPriceDelta = currentBodySize > atr * priceDeltaAtrMultiplier
        bool meetsManipulationCriteria = isLowVolume and isHighVolatility and isHighPriceDelta
        int existingCandleCount = array.size(r.candles)
        bool wasPreviouslyValidAndMetMinCandles = r.isValid and existingCandleCount >= minCandles
        if (meetsManipulationCriteria)
            r.count := gracePeriod
            bool shouldBeValidNow = (existingCandleCount + 1) >= minCandles
            updateRangeCommon(r, current, shouldBeValidNow)
        else
            if (wasPreviouslyValidAndMetMinCandles)
                if (r.count > 0)
                    r.count := r.count - 1
                else
                    r.isValid := false
                    r.finalized := true
            else
                if (existingCandleCount > 0 and (not r.isValid or existingCandleCount < minCandles) )
                    fastClear(r)
                else if (array.size(r.candles) == 0)
                    r.isValid := false
                    r.finalized := false
        r

// @function updateDistributionRange
// @description Identifies candles characterized by high volume, high volatility, and a large price body.
export updateDistributionRange(OHLCVRange r, OHLCV.OHLCV current, float atr, int minCandles, int gracePeriod, int avgVolumeLookback, float highVolMultiplier, float highVolAtrMultiplier, float priceDeltaAtrMultiplier) =>
    if (na(r) or na(current) or na(atr))
        r
    else
        if (r.finalized)
            fastClear(r)
        float avgVol = ta.sma(volume, avgVolumeLookback)
        bool isHighVolumeCondition = current.volume > avgVol * highVolMultiplier
        float currentCandleRange = current.high - current.low
        bool isHighVolatility = currentCandleRange > atr * highVolAtrMultiplier
        float currentBodySize = math.abs(current.close - current.open)
        bool isBigPriceDelta = currentBodySize > atr * priceDeltaAtrMultiplier
        bool meetsDistributionCriteria = isHighVolumeCondition and isHighVolatility and isBigPriceDelta
        int existingCandleCount = array.size(r.candles)
        bool wasPreviouslyValidAndMetMinCandles = r.isValid and existingCandleCount >= minCandles
        if (meetsDistributionCriteria)
            r.count := gracePeriod
            bool shouldBeValidNow = (existingCandleCount + 1) >= minCandles
            updateRangeCommon(r, current, shouldBeValidNow)
        else
            if (wasPreviouslyValidAndMetMinCandles)
                if (r.count > 0)
                    r.count := r.count - 1
                else
                    r.isValid := false
                    r.finalized := true
            else
                if (existingCandleCount > 0 and (not r.isValid or existingCandleCount < minCandles) )
                    fastClear(r)
                else if (array.size(r.candles) == 0)
                    r.isValid := false
                    r.finalized := false
        r
