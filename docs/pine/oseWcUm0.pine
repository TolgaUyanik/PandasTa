//@version=6
library("MaidongOrderBlockDrawing", overlay = true)

export OBDrawing(string obType, bool triggerCondition, float distalPriceInput, float proximalPriceInput, int indexInput, bool obValidGlobal, int obValidDistance, string mitigationLevel, string mitigationLevelBB, bool showAll, bool showAllBB, bool show, bool showBB, color zoneColor, color zoneColorBB) =>
    var float distalPrice = 0.0
    var float proximalPrice = 0.0
    var bool active = false
    var line distalLine = na
    var line proximalLine = na
    var line midLine = na
    var linefill zoneFill = na
    var bool mitigationAlert = false

    var bool bbTriggered = false
    var float distalPriceBB = 0.0
    var float proximalPriceBB = 0.0
    var int indexBB = 0
    var bool activeBB = false
    var line distalLineBB = na
    var line proximalLineBB = na
    var line midLineBB = na
    var linefill zoneFillBB = na
    var bool mitigationAlertBB = false

    if triggerCondition
        distalPrice := distalPriceInput
        proximalPrice := proximalPriceInput

    float mitigationPrice = switch mitigationLevel
        "Proximal" => proximalPrice
        "Distal" => distalPrice
        => (proximalPrice + distalPrice) / 2

    float mitigationPriceBB = switch mitigationLevelBB
        "Proximal" => proximalPriceBB
        "Distal" => distalPriceBB
        => (proximalPriceBB + distalPriceBB) / 2

    if obType == "Demand"
        if triggerCondition and show
            distalLine := line.new(indexInput, distalPrice, bar_index, distalPrice, color = color.rgb(0, 0, 0, 45), style = line.style_dashed, width = 1)
            proximalLine := line.new(indexInput, proximalPrice, bar_index, proximalPrice, color = color.rgb(0, 0, 0, 45), style = line.style_dashed, width = 1)
            midLine := line.new(indexInput, (proximalPrice + distalPrice) / 2, bar_index, (proximalPrice + distalPrice) / 2, color = color.rgb(0, 0, 0), style = line.style_dotted, width = 1)
            zoneFill := linefill.new(distalLine, proximalLine, zoneColor)

        if active and obValidGlobal
            line.set_x2(distalLine, bar_index + 1)
            line.set_x2(proximalLine, bar_index + 1)
            line.set_x2(midLine, bar_index + 1)

        if low < mitigationPrice or (bar_index - indexInput) >= obValidDistance
            active := false

        if triggerCondition
            active := true

        bbTriggered := active[1] and not active
        if (bbTriggered[1] or bbTriggered[2] or bbTriggered[3] or bbTriggered) and not activeBB
            if close < distalPrice
                indexBB := bar_index
                activeBB := true
                distalPriceBB := proximalPrice
                proximalPriceBB := distalPrice

        bool newBreakerBlock = not activeBB[1] and activeBB
        if newBreakerBlock and showBB
            distalLineBB := line.new(indexBB, distalPriceBB, bar_index, distalPriceBB, color = color.rgb(0, 0, 0, 45), style = line.style_dashed, width = 1)
            proximalLineBB := line.new(indexBB, proximalPriceBB, bar_index, proximalPriceBB, color = color.rgb(0, 0, 0, 45), style = line.style_dashed, width = 1)
            midLineBB := line.new(indexBB, (proximalPriceBB + distalPriceBB) / 2, bar_index, (proximalPriceBB + distalPriceBB) / 2, color = color.rgb(0, 0, 0), style = line.style_dotted, width = 1)
            zoneFillBB := linefill.new(distalLineBB, proximalLineBB, zoneColorBB)

        if activeBB[1] and activeBB and obValidGlobal
            line.set_x2(distalLineBB, bar_index + 1)
            line.set_x2(proximalLineBB, bar_index + 1)
            line.set_x2(midLineBB, bar_index + 1)

        if high > mitigationPriceBB or (bar_index - indexBB) >= obValidDistance or (active[1] and not active)
            activeBB := false

        if not showAll and triggerCondition
            line.delete(distalLine[1])
            line.delete(proximalLine[1])
            line.delete(midLine[1])
            linefill.delete(zoneFill[1])

        if not showAllBB and newBreakerBlock
            line.delete(distalLineBB[1])
            line.delete(proximalLineBB[1])
            line.delete(midLineBB[1])
            linefill.delete(zoneFillBB[1])

    if obType == "Supply"
        if triggerCondition and show
            distalLine := line.new(indexInput, distalPrice, bar_index, distalPrice, color = color.rgb(0, 0, 0, 45), style = line.style_dashed, width = 1)
            proximalLine := line.new(indexInput, proximalPrice, bar_index, proximalPrice, color = color.rgb(0, 0, 0, 45), style = line.style_dashed, width = 1)
            midLine := line.new(indexInput, (proximalPrice + distalPrice) / 2, bar_index, (proximalPrice + distalPrice) / 2, color = color.rgb(0, 0, 0), style = line.style_dotted, width = 1)
            zoneFill := linefill.new(distalLine, proximalLine, zoneColor)

        if active and obValidGlobal
            line.set_x2(distalLine, bar_index + 1)
            line.set_x2(proximalLine, bar_index + 1)
            line.set_x2(midLine, bar_index + 1)

        if high > mitigationPrice or (bar_index - indexInput) >= obValidDistance
            active := false

        if triggerCondition
            active := true

        bbTriggered := active[1] and not active
        if (bbTriggered[1] or bbTriggered[2] or bbTriggered[3] or bbTriggered) and not activeBB
            if close > distalPrice
                indexBB := bar_index
                activeBB := true
                distalPriceBB := proximalPrice
                proximalPriceBB := distalPrice

        bool newBreakerBlock = not activeBB[1] and activeBB
        if newBreakerBlock and showBB
            distalLineBB := line.new(indexBB, distalPriceBB, bar_index, distalPriceBB, color = color.rgb(0, 0, 0, 45), style = line.style_dashed, width = 1)
            proximalLineBB := line.new(indexBB, proximalPriceBB, bar_index, proximalPriceBB, color = color.rgb(0, 0, 0, 45), style = line.style_dashed, width = 1)
            midLineBB := line.new(indexBB, (proximalPriceBB + distalPriceBB) / 2, bar_index, (proximalPriceBB + distalPriceBB) / 2, color = color.rgb(0, 0, 0), style = line.style_dotted, width = 1)
            zoneFillBB := linefill.new(distalLineBB, proximalLineBB, zoneColorBB)

        if activeBB[1] and activeBB and obValidGlobal
            line.set_x2(distalLineBB, bar_index + 1)
            line.set_x2(proximalLineBB, bar_index + 1)
            line.set_x2(midLineBB, bar_index + 1)

        if low < mitigationPriceBB or (bar_index - indexBB) >= obValidDistance or (active[1] and not active)
            activeBB := false

        if not showAll and triggerCondition
            line.delete(distalLine[1])
            line.delete(proximalLine[1])
            line.delete(midLine[1])
            linefill.delete(zoneFill[1])

        if not showAllBB and newBreakerBlock
            line.delete(distalLineBB[1])
            line.delete(proximalLineBB[1])
            line.delete(midLineBB[1])
            linefill.delete(zoneFillBB[1])

    mitigationAlert := active[1] and not active
    mitigationAlertBB := activeBB[1] and not activeBB and not mitigationAlert
    [mitigationAlert, mitigationAlertBB, proximalPriceBB, distalPriceBB, indexBB]
