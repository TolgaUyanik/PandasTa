//@version=6
indicator(title='Volume-Based Candle Shading', shorttitle='[Top] Volume Shading', overlay=true)

// === INPUTS ===
visualGroup = 'Color Settings'
bullishColor    = input.color(color.green, 'Bullish Base Color', tooltip = "This color will be used for bullish candles with exactly average volume.", group=visualGroup)
bearishColor    = input.color(color.red,   'Bearish Base Color', tooltip = "This color will be used for bullish candles with exactly average volume.", group=visualGroup)
darkenHighVol   = input.bool(true, 'Higher Volume Is Darker', tooltip = "When checked this will cause high volume candles to be darker than the colors above, and low volume candles to be lighter.\n\nWhen unchecked this will cause high volume candles to be lighter than the colors above, and low volume candles to be darker.", group=visualGroup)

volumeGroup = 'Volume Settings'
volumeMALength  = input.int(20, 'Volume MA Length', minval=1, tooltip = "Determines how many previous candles are averaged together to determine what is considered above/below average volume.", group=volumeGroup)

// === HELPER: MIX BASE COLOR WITH BLACK / WHITE ===
mixColorBrightness(baseCol, factor) =>
    var float mixRatio = 0.0
    var int r = 0
    var int g = 0
    var int b = 0
    if factor > 1
        mixRatio := math.min((factor - 1) * 0.5, 0.55)
        r := math.round(color.r(baseCol) * (1 - mixRatio))
        g := math.round(color.g(baseCol) * (1 - mixRatio))
        b := math.round(color.b(baseCol) * (1 - mixRatio))
        b                    // (no-op, kept from original)
    else
        mixRatio := (1 - factor) * 0.7
        r := math.round(color.r(baseCol) + (255 - color.r(baseCol)) * mixRatio)
        g := math.round(color.g(baseCol) + (255 - color.g(baseCol)) * mixRatio)
        b := math.round(color.b(baseCol) + (255 - color.b(baseCol)) * mixRatio)
        b
    color.rgb(r, g, b)

// === CORE LOGIC ===
volumeMA   = ta.sma(volume, volumeMALength)
volumeRatio = volume / volumeMA

getVolumeBarColor(isUp, volRatio) =>
    baseCol = isUp ? bullishColor : bearishColor
    adjFactor = darkenHighVol ? volRatio : (volRatio > 0 ? 1 / volRatio : 0)  // flip mapping if user unchecks
    mixColorBrightness(baseCol, adjFactor)

// === APPLY COLOR ===
barColor = getVolumeBarColor(close > open, volumeRatio)
barcolor(barColor)