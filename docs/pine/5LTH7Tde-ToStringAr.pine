// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          toStringAr() FUNCTIONS                              ┃ {
 
// --- _toStringAr() helper--- {
// @function Applies toS to each of the elements (int/float/bool/string)
_toStringAr(arr, string format = na, string nz = na) =>
    if na(arr)
        runtime.error("toStringAr: array is na")
    sz = arr.size()
    if sz > 0  
        arS = array.new<string>(sz,na)
		for i = 0 to sz-1
            _v = arr.get(i)
            arS.set(i, ToS.toS(_v, format, nz))
        arS
	else
		array.new<string>()

// END OF _toStringAr() helper}


// ------------ toStringAr( bool, format ) ------------ {
// @function Returns a string array made of original array items converted to string using toS() using `format` string. 
// @param format (string) Acts in the same way as in str.format() 
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
export method toStringAr(bool    [] arr, string format = na, string nz = na) =>_toStringAr(arr, format, nz)
// END OF toStringAr( bool, _format ) ------------ }


// ------------ toStringAr( int, format ) ------------ {
// @function Returns a string array made of original array items converted to string using toS() using `format` string. 
// - --- Number formats ---
// - "number" 
// - "0"      
// - "0.0"
// - "0.00"
// - "0.000"
// - "0.0000"
// - "0.00000"
// - "0.000000"
// - "0.0000000"
// - --- Date formats ---
// - "date" 
// - "date : time"
// - "dd.MM"
// - "dd" 
// - --- Time formats ---
// - "time" 
// - "HH:mm"
// - "mm:ss"
// - "date time"
// - "date, time"
// - "date,time"
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
export method toStringAr(int     [] arr, string format = na, string nz = na) =>_toStringAr(arr, format, nz)
// END OF toStringAr( int, _format ) ------------ }


// ------------ toStringAr( float, format ) ------------ {
// @function Returns a string array made of original array items converted to string using toS() using `format` string. 
// - --- Number formats ---
// - "number" 
// - "0"      
// - "0.0"
// - "0.00"
// - "0.000"
// - "0.0000"
// - "0.00000"
// - "0.000000"
// - "0.0000000"
// - --- Date formats ---
// - "date" 
// - "date : time"
// - "dd.MM"
// - "dd" 
// - --- Time formats ---
// - "time" 
// - "HH:mm"
// - "mm:ss"
// - "date time"
// - "date, time"
// - "date,time"
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
export method toStringAr(float   [] arr, string format = na, string nz = na) =>_toStringAr(arr, format, nz)
// END OF toStringAr( float, _format ) ------------ }


// ------------ toStringAr( string, format ) ------------ {
// @function Returns a string array made of original array items converted to string using toS() using `format` string. 
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
export method toStringAr(string  [] arr, string format = na, string nz = na) =>_toStringAr(arr, format, nz)
// END OF toStringAr( string, _format ) ------------ }


// ------------ toStringAr( color, format ) ------------ {
// @function Returns a string array made of original array items converted to string using toS() using `format` string. 
// @param format (string) "HEX" or "RGB"
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
export method toStringAr(color  [] arr, string format = "HEX", string nz = na) =>_toStringAr(arr, format, nz)
// END OF toStringAr( string, _format ) ------------ }


// ------------ toStringAr( line, format ) ------------ {
// @function Returns a string array made of original array items converted to string with toS().
// @param format (string) If empty returns coordinates as "(x1, y1) - (x2, y2)". Otherwise replaces "x1", "x2", "y1", "y2" in `format` string by values.
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
export method toStringAr(line    [] arr, string format = na, string nz = na) =>_toStringAr(arr, format, nz)
// END OF toStringAr( bolineol, _format ) ------------ }


// ------------ toStringAr( label, format ) ------------ {
// @function Returns a string array made of original array items converted to string with toS().
// @param format (string) If empty returns coordinates and text (if _printText) as "(x, y): text = text". Otherwise replaces "x1", "x2", "txt" in `format` string by values.
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
export method toStringAr(label   [] arr, string format = na, string nz = na) =>_toStringAr(arr, format, nz)
// END OF toStringAr( label, _format ) ------------ }


// ------------ toStringAr( box, format ) ------------ {
// @function Returns a string array made of original array items converted to string with toS().
// @param format (string) If empty returns coordinates as "(x1, y1) - (x2, y2)". Otherwise replaces "x1", "x2", "y1", "y2" in `format` string by values.
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
export method toStringAr(box     [] arr, string format = na, string nz = na) =>_toStringAr(arr, format, nz)
// END OF toStringAr( box, _format ) ------------ }


// ^^^ END OF toStringAr() FUNCTIONS }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 



