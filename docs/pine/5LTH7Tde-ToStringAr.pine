//@version=5

// @description Contains toString/toS conversion methods for int/float/bool/string/line/label/box and arrays and matrices thereof. Also contains a string wraping function.
library("ToStringAr", overlay = false)
import moebius1977/ToS/1


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          toS() FUNCTIONS                                     ┃ {

// ♦♦♦♦♦♦   toS(array )  ♦♦♦♦♦♦ {

// ━━━━━━ _toSArray(<this, index_from, index_to, separator, format, _truncate) ━━━━━━ {
// @function Like array.join() but with string length limit. Joins elements into readable string (length capped at 4000, truncating the end or beg)
// @param format Format string. By default "{0}: {1}" if showIDs = true or "{1}" otherwise.
// @param nz (string) A string used to represent na (na values are substituted with this string).
_toSArray(this, int index_from = na , int index_to = na, string separator = ", ", bool showIDs = false, string format = na, bool truncate_left = false, int size_limit = 4000, string nz = na) =>
    string _s = "" 
    if this.size() > 0 
        index_to1 = na(index_to) ? array.size(this)-1 : math.min(index_to,array.size(this)-1) 
        index_from1 = na(index_from) ? 0 : math.max(index_from, 0)  
        _size_limit = math.min(4095, size_limit)
        _format =   showIDs  ? "{0}: {1}" 
                             : "{1}" 

        if truncate_left
            for _i = index_to1 to index_from1 
                _p = array.get(this, _i)
				_sp = _p.toS(format == "" ? "{0}" : format, nz)
				_sp := str.format(_format, _i, _sp) // add ID if necessary
                if str.length(_s) + str.length(_sp) < _size_limit
                    _s := _sp + (_i == index_to1 ? "" : separator) + _s
                else    
                    break
        else    
            for _i = index_from1 to index_to1 
                _p = array.get(this, _i)
				_sp = _p.toS(format == "" ? "{0}" : format, nz)
				_sp := str.format(_format, _i, _sp) // add ID if necessary
                if str.length(_s) + str.length(_sp) < _size_limit
                    _s := _s + (_i == index_from1 ? "" : separator) + _sp
                else    
                    break
    _s != "" ? _s : (na(nz) ? na : nz)

// END OF _toSArray (string []) }


// ━━━━━━ toS(bool[], index_from, index_to, separator, showIDs, format, truncate_left, size_limit, nz) ━━━━━━ {
// @function Like array.join() but with string length limit. Joins elements into readable string (length capped at 4000, truncating the end or beg)
// @param index_from (int) (Optional) Start from this id (starting from 0, in insertion order). If omitted - start from the first item.
// @param index_to (int) (Optional)  End with this pair (inclusive, in insertion order). If omitted - to last item.
// @param separator (string) (Optional) String to be inserted between pairs. Default: `", "`
// @param showIDs (bool) (Optional) If true item's id is added in the form `id: value`.
// @param format (string) (Optional) Format string. By default "{0}: {1}" if showIDs = true or "{1}" otherwise. (use "{0}" as a placeholder for id and "{1}" for item value)
// @param truncate_left (bool) (Optional) Truncate from left or right. Default: false.
// @param size_limit (int) (Optional) Max output string length. Default: 4000.
// @param nz (string) (Optional) A string used to represent na (na values are substituted with this string).
export method toS(bool[]	this, int index_from = na , int index_to = na, string separator = ", ", bool showIDs = false, string format = na, bool truncate_left = false, int size_limit = 4000, string nz = na) => _toSArray(this, index_from, index_to, separator, showIDs, format, truncate_left, size_limit, nz)
// END OF toS(bool[], ...) }


// ━━━━━━ toS(int[], index_from, index_to, separator, showIDs, format, truncate_left, size_limit, nz) ━━━━━━ {
// {
// {
// @function Like array.join() but with string length limit and formatting. Joins elements into readable string (length 
// capped at 4000, truncating the end or beg)
// Some shorthand "format" options: 
// ```
// --- number ---
// - "" 						 => "{0}"
// - "number"                    => "{0}"
// - "0"                         => "{0, number, 0       }"
// - "0.0"                       => "{0, number, 0.0      }"
// - "0.00"                      => "{0, number, 0.00     }"
// - "0.000"                     => "{0, number, 0.000    }"
// - "0.0000"                    => "{0, number, 0.0000   }"
// - "0.00000"                   => "{0, number, 0.00000  }"
// - "0.000000"                  => "{0, number, 0.000000 }"
// - "0.0000000"                 => "{0, number, 0.0000000}"
// --- date ---           	                       
// - "date"                      => "{0, date, dd.MM.YY}"
// - "date : time"               => "{0, date, dd.MM.YY} : {0, time, HH.mm.ss}"
// - "dd.MM"                     => "{0, date, dd:MM}"
// - "dd"                        => "{0, date, dd}"
// - "... <date> ... " in any place is substituted with "{0, date, dd.MM.YY}" 
// --- time ---           	                       
// - "time"                      => "{0, time, HH:mm:ss}"
// - "HH:mm"                     => "{0, time, HH:mm}"
// - "mm:ss"                     => "{0, time, mm:ss}"
// - "date time"                 => "{0, date, dd.MM.YY\} {0, time, HH.mm.ss}"
// - "date, time"                => "{0, date, dd.MM.YY\}, {0, time, HH.mm.ss}"
// - "date,time"                 => "{0, date, dd.MM.YY\},{0, time, HH.mm.ss}"
// - "date\ntime"                => "{0, date, dd.MM.YY\}\n{0, time, HH.mm.ss}"
// - "... <time> ... " in any place is substituted with "{0, time, HH.mm.ss}" 
// ```
// @param index_from (int) (Optional) Start from this id (starting from 0, in insertion order). If omitted - start from the first item.
// @param index_to (int) (Optional)  End with this pair (inclusive, in insertion order). If omitted - to last item.
// @param separator (string) (Optional) String to be inserted between pairs. Default: `", "`
// @param showIDs (bool) (Optional) If true item's id is added in the form `id: value`.
// @param format (string) (Optional) Format string applied to each item. By default "{0}".
// @param truncate_left (bool) (Optional) Truncate from left or right. Default: false.
// @param size_limit (int) (Optional) Max output string length. Default: 4000.
// @param nz (string) (Optional) A string used to represent na (na values are substituted with this string).
export method toS(int[]		this, int index_from = na , int index_to = na, string separator = ", ", bool showIDs = false, string format = na, bool truncate_left = false, int size_limit = 4000, string nz = na) => _toSArray(this, index_from, index_to, separator, showIDs, format, truncate_left, size_limit, nz)
// END OF toS(int[], ...) }


// ━━━━━━ toS(float[], index_from, index_to, separator, showIDs, format, truncate_left, size_limit, nz) ━━━━━━ {
//{ these lines are required since "}"'s break the folding
//{
// @function Like array.join() but with string length limit. Joins elements into readable string (length 
// capped at 4000, truncating the end or beg)
// Some shorthand "format" options: 
// ```
// --- number ---
// - "" 						 => "{0}"
// - "number"                    => "{0}"
// - "0"                         => "{0, number, 0       }"
// - "0.0"                       => "{0, number, 0.0      }"
// - "0.00"                      => "{0, number, 0.00     }"
// - "0.000"                     => "{0, number, 0.000    }"
// - "0.0000"                    => "{0, number, 0.0000   }"
// - "0.00000"                   => "{0, number, 0.00000  }"
// - "0.000000"                  => "{0, number, 0.000000 }"
// - "0.0000000"                 => "{0, number, 0.0000000}"
// --- date ---           	                       
// - "date"                      => "{0, date, dd.MM.YY}"
// - "date : time"               => "{0, date, dd.MM.YY} : {0, time, HH.mm.ss}"
// - "dd.MM"                     => "{0, date, dd:MM}"
// - "dd"                        => "{0, date, dd}"
// - "... <date> ... " in any place is substituted with "{0, date, dd.MM.YY}" 
// --- time ---           	                       
// - "time"                      => "{0, time, HH:mm:ss}"
// - "HH:mm"                     => "{0, time, HH:mm}"
// - "mm:ss"                     => "{0, time, mm:ss}"
// - "date time"                 => "{0, date, dd.MM.YY\} {0, time, HH.mm.ss}"
// - "date, time"                => "{0, date, dd.MM.YY\}, {0, time, HH.mm.ss}"
// - "date,time"                 => "{0, date, dd.MM.YY\},{0, time, HH.mm.ss}"
// - "date\ntime"                => "{0, date, dd.MM.YY\}\n{0, time, HH.mm.ss}"
// - "... <time> ... " in any place is substituted with "{0, time, HH.mm.ss}" 
// ```// @param index_from (int) (Optional) Start from this id (starting from 0, in insertion order). If omitted - start from the first item.
// @param index_to (int) (Optional)  End with this pair (inclusive, in insertion order). If omitted - to last item.
// @param separator (string) (Optional) String to be inserted between pairs. Default: `", "`
// @param showIDs (bool) (Optional) If true item's id is added in the form `id: value`.
// @param format (string) (Optional) Format string. By default "{0}: {1}" if showIDs = true or "{1}" otherwise. (use "{0}" as a placeholder for id and "{1}" for item value)
// @param truncate_left (bool) (Optional) Truncate from left or right. Default: false.
// @param size_limit (int) (Optional) Max output string length. Default: 4000.
// @param nz (string) (Optional) A string used to represent na (na values are substituted with this string).
export method toS(float[]	this, int index_from = na , int index_to = na, string separator = ", ", bool showIDs = false, string format = na, bool truncate_left = false, int size_limit = 4000, string nz = na) => _toSArray(this, index_from, index_to, separator, showIDs, format, truncate_left, size_limit, nz)
// END OF toS(float[], ...) }


