//@version=6
indicator(
     "Adjustable Monthly OpEx & Triple Witching",
     shorttitle = "Adjustable OpEx",
     overlay = true,
     max_labels_count = 500,
     max_lines_count = 500
)

//=============================================================================
// DISPLAY SETTINGS
//=============================================================================

groupDisplay = "1. Display Settings"

showMonthlyOpEx = input.bool(
     true,
     "Show Monthly OpEx",
     group = groupDisplay
)

showTripleWitching = input.bool(
     true,
     "Show Triple Witching",
     group = groupDisplay
)

showBackground = input.bool(
     true,
     "Show Background",
     group = groupDisplay
)

showLabels = input.bool(
     true,
     "Show Main Labels",
     group = groupDisplay
)

showMarkers = input.bool(
     true,
     "Show Markers",
     group = groupDisplay
)

showVerticalLines = input.bool(
     false,
     "Show Vertical Lines",
     group = groupDisplay
)

//=============================================================================
// MONTHLY OPEX SETTINGS
//=============================================================================

groupMonthly = "2. Monthly OpEx Settings"

monthlyBackgroundColor = input.color(
     color.orange,
     "Background Color",
     group = groupMonthly
)

monthlyBackgroundTransparency = input.int(
     86,
     "Background Transparency",
     minval = 0,
     maxval = 100,
     group = groupMonthly
)

monthlyLabelText = input.string(
     "MONTHLY OPEX\nThird Friday",
     "Label Text",
     group = groupMonthly
)

monthlyLabelBackgroundColor = input.color(
     color.orange,
     "Label Background Color",
     group = groupMonthly
)

// Editable monthly font color
monthlyLabelFontColor = input.color(
     color.black,
     "Label Font Color",
     group = groupMonthly
)

// Editable monthly font size
monthlyLabelFontSizeInput = input.string(
     "Small",
     "Label Font Size",
     options = [
          "Tiny",
          "Small",
          "Normal",
          "Large",
          "Huge"
     ],
     group = groupMonthly
)

monthlyMarkerText = input.string(
     "O",
     "Marker Text",
     group = groupMonthly
)

monthlyMarkerColor = input.color(
     color.orange,
     "Marker Background Color",
     group = groupMonthly
)

// Editable monthly marker font color
monthlyMarkerFontColor = input.color(
     color.black,
     "Marker Font Color",
     group = groupMonthly
)

// Editable monthly marker font size
monthlyMarkerFontSizeInput = input.string(
     "Tiny",
     "Marker Font Size",
     options = [
          "Tiny",
          "Small",
          "Normal",
          "Large",
          "Huge"
     ],
     group = groupMonthly
)

monthlyLineColor = input.color(
     color.orange,
     "Vertical Line Color",
     group = groupMonthly
)

//=============================================================================
// TRIPLE WITCHING SETTINGS
//=============================================================================

groupQuarterly = "3. Triple Witching Settings"

quarterlyBackgroundColor = input.color(
     color.red,
     "Background Color",
     group = groupQuarterly
)

quarterlyBackgroundTransparency = input.int(
     82,
     "Background Transparency",
     minval = 0,
     maxval = 100,
     group = groupQuarterly
)

quarterlyLabelText = input.string(
     "TRIPLE WITCHING\nQuarterly Expiration",
     "Label Text",
     group = groupQuarterly
)

quarterlyLabelBackgroundColor = input.color(
     color.red,
     "Label Background Color",
     group = groupQuarterly
)

// Editable triple-witching font color
quarterlyLabelFontColor = input.color(
     color.white,
     "Label Font Color",
     group = groupQuarterly
)

// Editable triple-witching font size
quarterlyLabelFontSizeInput = input.string(
     "Small",
     "Label Font Size",
     options = [
          "Tiny",
          "Small",
          "Normal",
          "Large",
          "Huge"
     ],
     group = groupQuarterly
)

quarterlyMarkerText = input.string(
     "TW",
     "Marker Text",
     group = groupQuarterly
)

quarterlyMarkerColor = input.color(
     color.red,
     "Marker Background Color",
     group = groupQuarterly
)

// Editable triple-witching marker font color
quarterlyMarkerFontColor = input.color(
     color.white,
     "Marker Font Color",
     group = groupQuarterly
)

// Editable triple-witching marker font size
quarterlyMarkerFontSizeInput = input.string(
     "Tiny",
     "Marker Font Size",
     options = [
          "Tiny",
          "Small",
          "Normal",
          "Large",
          "Huge"
     ],
     group = groupQuarterly
)

quarterlyLineColor = input.color(
     color.red,
     "Vertical Line Color",
     group = groupQuarterly
)

//=============================================================================
// MAIN LABEL POSITION SETTINGS
//=============================================================================

groupLabels = "4. Main Label Position"

labelPosition = input.string(
     "Above Price",
     "Label Position",
     options = [
          "Above Price",
          "Below Price"
     ],
     group = groupLabels
)

labelDistanceATR = input.float(
     0.50,
     "Distance From Price in ATR",
     minval = 0.0,
     step = 0.10,
     group = groupLabels
)

labelBarOffset = input.int(
     0,
     "Horizontal Bar Offset",
     minval = -100,
     maxval = 100,
     group = groupLabels
)

labelTextAlignment = input.string(
     "Center",
     "Text Alignment",
     options = [
          "Left",
          "Center",
          "Right"
     ],
     group = groupLabels
)

includeDateInLabel = input.bool(
     false,
     "Include Date in Label",
     group = groupLabels
)

//=============================================================================
// MARKER SETTINGS
//=============================================================================

groupMarkers = "5. Marker Settings"

markerPosition = input.string(
     "Above Price",
     "Marker Position",
     options = [
          "Above Price",
          "Below Price"
     ],
     group = groupMarkers
)

markerStyleInput = input.string(
     "Diamond",
     "Marker Style",
     options = [
          "Diamond",
          "Circle",
          "Square",
          "Triangle Up",
          "Triangle Down"
     ],
     group = groupMarkers
)

markerDistanceATR = input.float(
     0.20,
     "Distance From Price in ATR",
     minval = 0.0,
     step = 0.05,
     group = groupMarkers
)

markerBarOffset = input.int(
     0,
     "Horizontal Bar Offset",
     minval = -100,
     maxval = 100,
     group = groupMarkers
)

//=============================================================================
// VERTICAL LINE SETTINGS
//=============================================================================

groupLines = "6. Vertical Line Settings"

lineWidthInput = input.int(
     1,
     "Line Width",
     minval = 1,
     maxval = 5,
     group = groupLines
)

lineStyleInput = input.string(
     "Dashed",
     "Line Style",
     options = [
          "Solid",
          "Dashed",
          "Dotted"
     ],
     group = groupLines
)

lineTransparency = input.int(
     20,
     "Line Transparency",
     minval = 0,
     maxval = 100,
     group = groupLines
)

//=============================================================================
// SESSION SETTINGS
//=============================================================================

groupSession = "7. Session Settings"

timezoneInput = input.string(
     "America/Chicago",
     "Time Zone",
     options = [
          "Exchange",
          "America/New_York",
          "America/Chicago",
          "America/Denver",
          "America/Los_Angeles",
          "Etc/UTC"
     ],
     group = groupSession
)

shadeEntireTradingDay = input.bool(
     true,
     "Shade Entire Trading Day",
     group = groupSession
)

customBackgroundSession = input.session(
     "0830-1500",
     "Custom Background Session",
     group = groupSession
)

labelPlacementTime = input.string(
     "First Bar of Trading Day",
     "Label and Line Placement",
     options = [
          "First Bar of Trading Day",
          "Regular Session Open"
     ],
     group = groupSession
)

regularSession = input.session(
     "0830-1500",
     "Regular Trading Session",
     group = groupSession
)

//=============================================================================
// MONTH FILTERS
//=============================================================================

groupMonths = "8. Month Filters"

showJanuary = input.bool(true, "January", group = groupMonths)
showFebruary = input.bool(true, "February", group = groupMonths)
showMarch = input.bool(true, "March", group = groupMonths)
showApril = input.bool(true, "April", group = groupMonths)
showMay = input.bool(true, "May", group = groupMonths)
showJune = input.bool(true, "June", group = groupMonths)
showJuly = input.bool(true, "July", group = groupMonths)
showAugust = input.bool(true, "August", group = groupMonths)
showSeptember = input.bool(true, "September", group = groupMonths)
showOctober = input.bool(true, "October", group = groupMonths)
showNovember = input.bool(true, "November", group = groupMonths)
showDecember = input.bool(true, "December", group = groupMonths)

//=============================================================================
// ALERT SETTINGS
//=============================================================================

groupAlerts = "9. Alert Settings"

enableMonthlyAlert = input.bool(
     true,
     "Enable Monthly OpEx Alert",
     group = groupAlerts
)

enableQuarterlyAlert = input.bool(
     true,
     "Enable Triple Witching Alert",
     group = groupAlerts
)

//=============================================================================
// HELPER FUNCTIONS
//=============================================================================

fontSizeFromInput(string selectedSize) =>
    selectedSize == "Tiny" ? size.tiny :
     selectedSize == "Small" ? size.small :
     selectedSize == "Normal" ? size.normal :
     selectedSize == "Large" ? size.large :
     size.huge

textAlignmentFromInput(string selectedAlignment) =>
    selectedAlignment == "Left" ? text.align_left :
     selectedAlignment == "Right" ? text.align_right :
     text.align_center

lineStyleFromInput(string selectedStyle) =>
    selectedStyle == "Solid" ? line.style_solid :
     selectedStyle == "Dotted" ? line.style_dotted :
     line.style_dashed

markerStyleFromInput(string selectedStyle) =>
    selectedStyle == "Circle" ? label.style_circle :
     selectedStyle == "Square" ? label.style_square :
     selectedStyle == "Triangle Up" ? label.style_triangleup :
     selectedStyle == "Triangle Down" ? label.style_triangledown :
     label.style_diamond

//=============================================================================
// CONVERT SETTINGS
//=============================================================================

string selectedTimezone =
     timezoneInput == "Exchange" ?
     syminfo.timezone :
     timezoneInput

monthlyLabelFontSize =
     fontSizeFromInput(monthlyLabelFontSizeInput)

quarterlyLabelFontSize =
     fontSizeFromInput(quarterlyLabelFontSizeInput)

monthlyMarkerFontSize =
     fontSizeFromInput(monthlyMarkerFontSizeInput)

quarterlyMarkerFontSize =
     fontSizeFromInput(quarterlyMarkerFontSizeInput)

selectedTextAlignment =
     textAlignmentFromInput(labelTextAlignment)

selectedLineStyle =
     lineStyleFromInput(lineStyleInput)

selectedMarkerStyle =
     markerStyleFromInput(markerStyleInput)

//=============================================================================
// TRADING DATE CALCULATIONS
//=============================================================================

// The daily closing timestamp associates an overnight futures session
// with the date on which that session closes.
int tradingDateTimestamp = time_close("D")

int tradingDay =
     dayofmonth(tradingDateTimestamp, selectedTimezone)

int tradingMonth =
     month(tradingDateTimestamp, selectedTimezone)

int tradingYear =
     year(tradingDateTimestamp, selectedTimezone)

int tradingDayOfWeek =
     dayofweek(tradingDateTimestamp, selectedTimezone)

// The third Friday always falls between the 15th and 21st.
bool isThirdFriday =
     tradingDayOfWeek == dayofweek.friday and
     tradingDay >= 15 and
     tradingDay <= 21

bool isQuarterlyMonth =
     tradingMonth == 3 or
     tradingMonth == 6 or
     tradingMonth == 9 or
     tradingMonth == 12

bool isTripleWitching =
     isThirdFriday and
     isQuarterlyMonth

bool isRegularMonthlyOpEx =
     isThirdFriday and
     not isQuarterlyMonth

//=============================================================================
// MONTH FILTER
//=============================================================================

bool selectedMonthIsVisible =
     tradingMonth == 1 ? showJanuary :
     tradingMonth == 2 ? showFebruary :
     tradingMonth == 3 ? showMarch :
     tradingMonth == 4 ? showApril :
     tradingMonth == 5 ? showMay :
     tradingMonth == 6 ? showJune :
     tradingMonth == 7 ? showJuly :
     tradingMonth == 8 ? showAugust :
     tradingMonth == 9 ? showSeptember :
     tradingMonth == 10 ? showOctober :
     tradingMonth == 11 ? showNovember :
     tradingMonth == 12 ? showDecember :
     false

bool displayMonthly =
     showMonthlyOpEx and
     isRegularMonthlyOpEx and
     selectedMonthIsVisible

bool displayQuarterly =
     showTripleWitching and
     isTripleWitching and
     selectedMonthIsVisible

//=============================================================================
// SESSION DETECTION
//=============================================================================

bool isNewTradingDay =
     timeframe.change("D")

bool isInRegularSession =
     not na(
          time(
               timeframe.period,
               regularSession,
               selectedTimezone
          )
     )

bool wasInRegularSession =
     bar_index > 0 ?
     isInRegularSession[1] :
     false

bool isRegularSessionOpen =
     isInRegularSession and
     not wasInRegularSession

bool isInCustomBackgroundSession =
     not na(
          time(
               timeframe.period,
               customBackgroundSession,
               selectedTimezone
          )
     )

bool expirationStartBar =
     labelPlacementTime == "Regular Session Open" ?
     isRegularSessionOpen :
     isNewTradingDay

bool shadeThisBar =
     shadeEntireTradingDay or
     isInCustomBackgroundSession

//=============================================================================
// BACKGROUND SHADING
//=============================================================================

color monthlyBackground =
     color.new(
          monthlyBackgroundColor,
          monthlyBackgroundTransparency
     )

color quarterlyBackground =
     color.new(
          quarterlyBackgroundColor,
          quarterlyBackgroundTransparency
     )

color activeBackground =
     displayQuarterly ? quarterlyBackground :
     displayMonthly ? monthlyBackground :
     na

bgcolor(
     showBackground and shadeThisBar ?
     activeBackground :
     na,
     title = "OpEx Background"
)

//=============================================================================
// LABEL TEXT AND POSITION
//=============================================================================

float atrValue =
     ta.atr(14)

float mainLabelPrice =
     labelPosition == "Above Price" ?
     high + atrValue * labelDistanceATR :
     low - atrValue * labelDistanceATR

mainLabelStyle =
     labelPosition == "Above Price" ?
     label.style_label_down :
     label.style_label_up

string expirationDateText =
     str.tostring(tradingMonth) + "/" +
     str.tostring(tradingDay) + "/" +
     str.tostring(tradingYear)

string completeMonthlyLabelText =
     includeDateInLabel ?
     monthlyLabelText + "\n" + expirationDateText :
     monthlyLabelText

string completeQuarterlyLabelText =
     includeDateInLabel ?
     quarterlyLabelText + "\n" + expirationDateText :
     quarterlyLabelText

//=============================================================================
// MAIN LABELS
//=============================================================================

if showLabels and expirationStartBar and displayMonthly
    label.new(
         x = bar_index + labelBarOffset,
         y = mainLabelPrice,
         text = completeMonthlyLabelText,
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = mainLabelStyle,
         color = monthlyLabelBackgroundColor,
         textcolor = monthlyLabelFontColor,
         size = monthlyLabelFontSize,
         textalign = selectedTextAlignment
    )

if showLabels and expirationStartBar and displayQuarterly
    label.new(
         x = bar_index + labelBarOffset,
         y = mainLabelPrice,
         text = completeQuarterlyLabelText,
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = mainLabelStyle,
         color = quarterlyLabelBackgroundColor,
         textcolor = quarterlyLabelFontColor,
         size = quarterlyLabelFontSize,
         textalign = selectedTextAlignment
    )

//=============================================================================
// MARKERS
//=============================================================================

float markerPrice =
     markerPosition == "Above Price" ?
     high + atrValue * markerDistanceATR :
     low - atrValue * markerDistanceATR

if showMarkers and expirationStartBar and displayMonthly
    label.new(
         x = bar_index + markerBarOffset,
         y = markerPrice,
         text = monthlyMarkerText,
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = selectedMarkerStyle,
         color = monthlyMarkerColor,
         textcolor = monthlyMarkerFontColor,
         size = monthlyMarkerFontSize
    )

if showMarkers and expirationStartBar and displayQuarterly
    label.new(
         x = bar_index + markerBarOffset,
         y = markerPrice,
         text = quarterlyMarkerText,
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = selectedMarkerStyle,
         color = quarterlyMarkerColor,
         textcolor = quarterlyMarkerFontColor,
         size = quarterlyMarkerFontSize
    )

//=============================================================================
// VERTICAL LINES
//=============================================================================

if showVerticalLines and expirationStartBar and displayMonthly
    line.new(
         x1 = bar_index,
         y1 = low,
         x2 = bar_index,
         y2 = high,
         xloc = xloc.bar_index,
         extend = extend.both,
         color = color.new(
              monthlyLineColor,
              lineTransparency
         ),
         style = selectedLineStyle,
         width = lineWidthInput
    )

if showVerticalLines and expirationStartBar and displayQuarterly
    line.new(
         x1 = bar_index,
         y1 = low,
         x2 = bar_index,
         y2 = high,
         xloc = xloc.bar_index,
         extend = extend.both,
         color = color.new(
              quarterlyLineColor,
              lineTransparency
         ),
         style = selectedLineStyle,
         width = lineWidthInput
    )

//=============================================================================
// DATA WINDOW
//=============================================================================

plot(
     isThirdFriday ? 1 : 0,
     title = "Third Friday",
     display = display.data_window
)

plot(
     isTripleWitching ? 1 : 0,
     title = "Triple Witching",
     display = display.data_window
)

//=============================================================================
// ALERTS
//=============================================================================

bool monthlyAlertCondition =
     enableMonthlyAlert and
     expirationStartBar and
     displayMonthly

bool quarterlyAlertCondition =
     enableQuarterlyAlert and
     expirationStartBar and
     displayQuarterly

alertcondition(
     monthlyAlertCondition,
     title = "Monthly Options Expiration",
     message = "Today is a third-Friday monthly options expiration session."
)

alertcondition(
     quarterlyAlertCondition,
     title = "Triple Witching",
     message = "Today is a quarterly triple-witching expiration session."
)