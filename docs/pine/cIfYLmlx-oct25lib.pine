library("oct25lib")

export salmav3(series float src,int length,int smooth,float mult,int sd_len) =>
    baseline = ta.wma(src, sd_len)
    dev = mult * ta.stdev(src, sd_len)
    upper = baseline + dev
    lower = baseline - dev
    cprice = src > upper ? upper : src < lower ? lower : src
    REMA = ta.wma(ta.wma(cprice, length), smooth)
    remasig =REMA > REMA[1]?1:-1
    remasig

export boltzman(series float src, int length, float T, float alpha, int smoothLen) => 

    k_B = 1.0 // Boltzmann constant (fixed at 1)
    var float sum_weights = 0.0
    var float sum_price   = 0.0

    sum_weights := 0.0
    sum_price   := 0.0

    // Calculate Boltzmann-weighted sum over the specified window
    for i = 0 to length - 1
        energy = alpha * i
        weight = math.exp(-energy / (k_B * T))
        sum_weights += weight
        sum_price   += src[i] * weight

    boltzmann_ma = sum_price / sum_weights
    // Apply smoothing using an EMA
    smoothed_ma = ta.ema(boltzmann_ma, smoothLen)
    boltzmansignal=smoothed_ma > smoothed_ma[1]?1:-1
    boltzmansignal

export shannon(series float src,series float vol, int len,bool bc, bool vc,int smooth )=>

    cr = src/math.sum(src,len)
    vr = math.log(vol)/math.sum(math.log(vol),len)
    info = ((vc ? math.sum(vr*math.log10(vr)/math.log10(2),len) : 0) - (bc ? vc ? math.sum(cr*math.log10(cr)/math.log10(2),len) : math.sum(cr* math.log10(cr)/ math.log10(2),len) : 0))
    smoothinfo=ta.ema(info,smooth)
    shannonsignal=smoothinfo>0?1:smoothinfo<0?-1:0
    shannonsignal

export vama(series float src, int baseLen, int volLen, float beta)=>

    // Volatility (log returns)
    returns = math.log(src / src[1])
    vol     = ta.stdev(returns, volLen)
    avgVol  = ta.sma(vol, volLen)
    // avoid zero divide
    avgVol := avgVol == 0.0 ? vol : avgVol

    // Adjusted (float) effective length
    adjustedLen = baseLen * (1 + beta * (vol / avgVol))
    adjustedLen := math.min(math.max(adjustedLen, 1.0), 200.0)  // clamp to reasonable range

    // Convert adjusted length to EMA smoothing factor alpha (float)
    alpha = 2.0 / (adjustedLen + 1.0)

    // Recursive EMA with float alpha (works as time-varying EMA)
    var float vama = na
    vama := nz(vama[1], src) * (1 - alpha) + alpha * src

    // Plot
    vamasig = vama > vama[1]?1:-1
	vamasig

export fwma(series float src,int period, float lambda,int smooth)=>


    // 1. Estimate Fractal Dimension (Ehlers-style method)

    // Use the ratio of log of total path length to log of straight-line distance
    length1 = 0.0
    for i = 1 to period - 1
        length1 += math.abs(src[i] - src[i-1])

    total_dist = math.abs(src[period-1] - src[0])
    D = na(total_dist) or total_dist == 0.0 ? 1.5 : (math.log(length1) - math.log(total_dist)) / math.log(period)
    D := math.min(math.max(D, 1.0), 2.0) // clamp between 1 and 2

    // 2. Compute Fractal-Weighted Average

    sum_w = 0.0
    sum_p = 0.0
    for i = 0 to period - 1
        w = math.exp(-lambda * i * (2 - D))
        sum_w += w
        sum_p += src[i] * w

    fwma1 = sum_p / sum_w
    fwma=ta.ema(fwma1,smooth)
    fwmasig = fwma > fwma[1]?1:fwma<fwma[1]?-1:0
	fwmasig

savitzky_golay_filter_w_15_vectors(series float source,int length) =>
    
    float sum            = 0.0
    float polynomial     = 0.0
    float[] coefficients = array.new<float>(16)
    // Predefined 15 coefficients
    for i = -4 to 4
        coefficients.set(i + 4, i) // from -4 to 5
        if i == 4
            for j = 5 to -4
                for g = 8 to 15 
                    coefficients.set(g, j) // from 5 to -4

    // Calculate normalization factor as the sum of absolute values of coefficients
    float norm_factor = coefficients.sum()

    // Loop through coefficients and calculate the weighted sum
    for i = 0 to coefficients.size()-1
        sum := sum + coefficients.get(i) * source[i]

    // Calculate the smoothed value
    for i = 1 to length-1
        polynomial := math.sum(sum / norm_factor, i) / i

    polynomial

export savitzky(series float srcc,series float srch,series float srcl, int length)=> 
	
    var direction = int(na)
    var count = 0

    // Apply the filter to close prices
    basis = savitzky_golay_filter_w_15_vectors(srcc,length)


    distance = ta.sma(srch-srcl, 100) * 2

    h_band = basis + distance
    l_band = basis - distance

    prevLowerBand = nz(l_band[1])
    prevUpperBand = nz(h_band[1])

    l_band := l_band > prevLowerBand or srcc[1] < prevLowerBand ? l_band : prevLowerBand
    h_band := h_band < prevUpperBand or srcc[1] > prevUpperBand ? h_band : prevUpperBand

    savitzkysig = srcc > h_band ? 1 : srcc < l_band ? -1 : 0
    savitzkysig



get2PoleBF(src, length) =>
    PI = 2 * math.asin(1)
    a = math.exp(-math.sqrt(2) * PI / length)
    b = 2 * a * math.cos(math.sqrt(2) * PI / length)
    bf = 0.0
    bf := b * nz(bf[1]) - math.pow(a, 2) * nz(bf[2]) + ((1 - b + math.pow(a, 2)) / 4) * (src + 2 * nz(src[1]) + nz(src[2]))
    bf

get3PoleBF(src, length) =>
    PI = 2 * math.asin(1)
    a = math.exp(-PI / length)
    b = 2 * a * math.cos(1.738 * PI / length)
    c = math.pow(a, 2)
    bf = 0.0
    bf := (b + c) * nz(bf[1]) - (c + b * c) * nz(bf[2]) + math.pow(c, 2) * nz(bf[3]) + ((1 - b + c) * (1 - c) / 8) * (src + 3 * nz(src[1]) + 3 * nz(src[2]) + nz(src[3]))
    bf

export butterworth(series float src,int length, int poles, int smooth)=>
	
    bf = poles == 2
             ? get2PoleBF(src, length)
             : get3PoleBF(src, length)


    bfema=ta.ema(bf,smooth)
    bfsig = bfema > bfema[1] ? 1 : -1
	bfsig

export rti(series float src,int trend_data_count,int trend_sensitivity_percentage,int midline,int smooth)=>

    //Relative Trend Index Calculation {
    upper_trend = src + ta.stdev(src, 2)
    lower_trend = src - ta.stdev(src, 2)

    upper_array = array.new<float>(0)
    lower_array = array.new<float>(0)
    for i = 0 to trend_data_count - 1 
        upper_array.push(upper_trend[i])
        lower_array.push(lower_trend[i])
    upper_array.sort()
    lower_array.sort()

    upper_index  = math.round(trend_sensitivity_percentage / 100 * trend_data_count) - 1
    lower_index  = math.round((100 - trend_sensitivity_percentage) / 100 * trend_data_count) - 1
    UpperTrend   = upper_array.get(upper_index)
    LowerTrend   = lower_array.get(lower_index)
    RelativeTrendIndex = ((src - LowerTrend) / (UpperTrend - LowerTrend))*100
    rtiema=ta.ema(RelativeTrendIndex,smooth)
	rtisig=rtiema>midline?1:rtiema<midline?-1:0
	rtisig



f1(m) => m >= 0.0 ? m : 0.0
f2(m) => m >= 0.0 ? 0.0 : -m
percent(nom, div) => 100 * nom / div
export chandemo(series float src, int length,int smooth)=>

    momm = ta.change(src)

    m1 = f1(momm)
    m2 = f2(momm)
    sm1 = math.sum(m1, length)
    sm2 = math.sum(m2, length)
    chandeMO = percent(sm1-sm2, sm1+sm2)
	chandema=ta.ema(chandeMO,smooth)
	chandesig=chandema>0?1:chandema<0?-1:0
	chandesig

export hsma(series float assetClose , int length,int emalen,float midline) =>

    wma  = ta.wma(assetClose, length)
    wma1 = ta.wma(assetClose, length)
    hma = 3 * wma - 2 * wma1
    sma = ta.sma(assetClose, length)
    diff = hma - sma
    xMax = ta.highest(diff, length)
    xMin = ta.lowest(diff, length)
    range_ = xMax - xMin
    y = diff / range_
    strength = math.round(y * 40)
	strengthema=ta.ema(strength,emalen)
    hsmasignal = strengthema>midline? 1:-1
    hsmasignal

export rsi(series float src,int rsiLengthInput, int rsiemalen, float midline)=>
    
    change = ta.change(src)
    up = ta.rma(math.max(change, 0), rsiLengthInput)
    down = ta.rma(-math.min(change, 0), rsiLengthInput)
    rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))
    rsiema=ta.ema(rsi,rsiemalen)
    rsisignal=rsiema>midline?1:-1
    rsisignal

f_ma(src, length, type) =>
    if type == 'SMA'
        ta.sma(src, length)
    else if type == 'EMA'
        ta.ema(src, length)
    else if type == 'WMA'
        ta.wma(src, length)
    else if type == 'RMA'
        ta.rma(src, length)
    else if type == 'VWMA'
        ta.vwma(src, length)
    else if type == 'ALMA'
        ta.alma(src, length, 0.85, 6)
    else if type == 'T3'
        ta.wma(ta.wma(ta.wma(src, length), length), length)
    else if type == 'JMA'
        ta.wma(src, length)
    else if type == 'SMMA'
        ta.rma(src, length)
    else if type == 'VWAP'
        ta.vwap
    else
        na
export lacoca(series float src, int lookback, int malen, string matype) =>

    smoothed = f_ma(src, malen, matype)

    // Z-Score Calculation
    mean = ta.sma(smoothed, lookback)
    stdev = ta.stdev(smoothed, lookback)
    z_score = (smoothed - mean) / stdev

    cocasignal=z_score>0?1:-1
    cocasignal
