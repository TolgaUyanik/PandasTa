//@version=6
indicator("趋势结构系统均线共振版", overlay=true, max_labels_count=500)

// ===== 显示开关 =====
showBullLabels = input.bool(true, title="显示做多标记 (▲)", group="标记显示")
showBearLabels = input.bool(true, title="显示做空标记 (▼)", group="标记显示")

// ===== 均线 =====
ema20 = ta.ema(close, 20)
ema60 = ta.ema(close, 60)
ema120 = ta.ema(close, 120)
ma20 = ta.sma(close, 20)
ma60 = ta.sma(close, 60)
ma120 = ta.sma(close, 120)

plot(ema20, color=color.rgb(40, 47, 54), title="EMA 20")
plot(ema60, color=color.rgb(119, 163, 230), title="EMA 60")
plot(ema120, color=color.rgb(209, 86, 94), title="EMA 120")
plot(ma20, color=color.rgb(56, 49, 59), title="MA 20")
plot(ma60, color=color.rgb(71, 39, 234), title="MA 60")
plot(ma120, color=color.rgb(219, 27, 46), title="MA 120")

// ===== ATR =====
atrValue = ta.atr(14)

// ===== 趋势过滤 =====
trendUp = ema20 > ema60 and ema20 > ema120 and ma20 > ma120 and ma20 > ma60
trendDown = ema20 < ema60 and ema20 < ema120 and ma20 < ma120 and ma20 < ma60

// ===== 趋势状态机 =====
var int trend = 0
prevTrend = trend

if trendUp
    trend := 1
else if trendDown
    trend := -1

// ===== 趋势线 =====
var float trendLine = na
bullLine = low - atrValue
bearLine = high + atrValue

if trend == 1
    trendLine := na(trendLine) ? bullLine : math.max(trendLine, bullLine)
else if trend == -1
    trendLine := na(trendLine) ? bearLine : math.min(trendLine, bearLine)

if prevTrend == 1 and trend == -1
    trendLine := bearLine
if prevTrend == -1 and trend == 1
    trendLine := bullLine

plot(trendLine, "ATR趋势线", color=color.rgb(255, 152, 0), linewidth=1)

// ===== 极值记录 =====
var float bullHigh = na
var int bullHighBar = na
var int bullHighTime = na

var float bearLow = na
var int bearLowBar = na
var int bearLowTime = na

if trend == 1
    bullHigh := na(bullHigh) ? high : math.max(bullHigh, high)
    if high == bullHigh
        bullHighBar := bar_index
        bullHighTime := time

if trend == -1
    bearLow := na(bearLow) ? low : math.min(bearLow, low)
    if low == bearLow
        bearLowBar := bar_index
        bearLowTime := time

// ===== 趋势切换 =====
bullToBear = prevTrend == 1 and trend == -1
bearToBull = prevTrend == -1 and trend == 1

// ===== MACD（用于背驰判断）=====
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

// ===== 背驰判断（MACD柱面积法）=====
// 记录上一个高点/低点的价格和MACD面积
var float prevBullHighPrice = na
var float prevBullMacdArea = na   // 上一个▲对应的MACD柱和
var float prevBearLowPrice = na
var float prevBearMacdArea = na   // 上一个▼对应的MACD柱和

// 当前结构点的MACD柱累计
var float bullMacdAccum = 0.0     // 当前多头段MACD柱累加
var float bearMacdAccum = 0.0     // 当前空头段MACD柱累加

// 在每个K线累加MACD柱
if trend == 1
    // 多头段：累加正的MACD柱（向上的动能）
    bullMacdAccum := bullMacdAccum + math.max(histLine, 0)
    
if trend == -1
    // 空头段：累加负的MACD柱的绝对值（向下的动能）
    bearMacdAccum := bearMacdAccum + math.max(-histLine, 0)

// ——— 顶背驰检测 ———
if bullToBear and not na(bullHigh)
    bool isDivergence = false
    string labelText = "▲"
    
    if not na(prevBullMacdArea) and not na(prevBullHighPrice)
        // 价格创新高 + MACD面积缩小 → 顶背驰
        if bullHigh > prevBullHighPrice and bullMacdAccum < prevBullMacdArea * 0.95
            isDivergence := true
            labelText := "▲ 顶背驰"
    
    // 记录供下一个高点比较
    prevBullHighPrice := bullHigh
    prevBullMacdArea := bullMacdAccum
    
    if showBullLabels
        label.new(bullHighBar, bullHigh, labelText,
                  color=isDivergence ? color.rgb(255, 152, 0) : color.green,
                  textcolor=color.white,
                  style=label.style_label_down, size=isDivergence ? size.huge : size.large)

// ——— 底背驰检测 ———
if bearToBull and not na(bearLow)
    bool isDivergence = false
    string labelText = "▼"
    
    if not na(prevBearMacdArea) and not na(prevBearLowPrice)
        // 价格创新低 + MACD面积缩小 → 底背驰
        if bearLow < prevBearLowPrice and bearMacdAccum < prevBearMacdArea * 0.95
            isDivergence := true
            labelText := "▼ 底背驰"
    
    prevBearLowPrice := bearLow
    prevBearMacdArea := bearMacdAccum
    
    if showBearLabels
        label.new(bearLowBar, bearLow, labelText,
                  color=isDivergence ? color.rgb(255, 152, 0) : color.red,
                  textcolor=color.white,
                  style=label.style_label_up, size=isDivergence ? size.huge : size.large)

// ===== 结构点连线 =====
var int lastPointTime = na
var float lastPointPrice = na

if bullToBear and not na(bullHigh)
    if not na(lastPointTime)
        line.new(lastPointTime, lastPointPrice, bullHighTime, bullHigh,
                 xloc=xloc.bar_time, color=color.green, width=2)
    lastPointTime := bullHighTime
    lastPointPrice := bullHigh

if bearToBull and not na(bearLow)
    if not na(lastPointTime)
        line.new(lastPointTime, lastPointPrice, bearLowTime, bearLow,
                 xloc=xloc.bar_time, color=color.red, width=2)
    lastPointTime := bearLowTime
    lastPointPrice := bearLow

// ===== 重置 =====
if bullToBear
    bullHigh := na
    bullHighBar := na
    bullMacdAccum := 0.0

if bearToBull
    bearLow := na
    bearLowBar := na
    bearMacdAccum := 0.0
