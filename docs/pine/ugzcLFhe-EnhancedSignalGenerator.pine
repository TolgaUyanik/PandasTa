//@version=6
// @description Enhanced Signal Generator – clean v6 implementation (UDT-based)
library("EnhancedSignalGenerator")

// —————————————————  USER-DEFINED TYPE  —————————————————
// @type Signal data structure for market analysis
// @field dir Signal direction: +1 bull, -1 bear, 0 flat
// @field strength Signal strength magnitude (0-1)
// @field conf Confidence level (0-1)
// @field rationale Human-readable explanation
// @field source Signal source classification
// @field quality Blended quality assessment score
export type Signal
    int    dir        
    float  strength   
    float  conf       
    string rationale  
    string source     
    float  quality    

// —————————————————  CONSTANTS  —————————————————
const float PRI_THR = 0.70
const float SEC_THR = 0.50
const float MIN_STR = 0.15
const float DECAY   = 0.85

const int BULL =  1
const int BEAR = -1
const int FLAT =  0

// —————————————————  UTILITY FUNCTIONS  —————————————————
// @function Constrains value within specified bounds
// @param x Input value to clamp
// @param lo Lower bound
// @param hi Upper bound
// @returns float Clamped value
clamp(x, lo, hi) => 
    math.max(lo, math.min(x, hi))

// @function Calculates adaptive threshold values based on market conditions
// @param vol Volatility factor (0.001-0.10)
// @param trendAbs Absolute trend component (0.0-1.0)
// @returns [float, float] Primary and secondary thresholds
thresh(vol, trendAbs) =>
    v     = clamp(vol,   0.001, 0.10)
    t     = clamp(trendAbs, 0.0, 1.0)
    vMult = clamp(v / 0.02, 0.4, 2.5)
    adj   = 1.0 + t*0.25
    pri   = clamp(PRI_THR * vMult * adj, 0.20, 0.95)
    sec   = clamp(SEC_THR * vMult * adj, 0.15, 0.85)
    [pri, sec]

// @function Validates signal strength against minimum requirements
// @param absScore Absolute signal score for validation
// @returns [bool, float] Validation status and quality score
validate(absScore) =>
    pass = absScore >= MIN_STR
    qual = pass ? 0.75 : 0.25
    [pass, qual]

// @function Generates primary signal pathway analysis
// @param score Raw signal score
// @param trend Trend component factor
// @param vol Volatility factor
// @param qual Quality assessment score
// @param priThr Primary threshold level
// @returns Signal Primary pathway signal object
primary(score, trend, vol, qual, priThr) =>
    comp = math.abs(score)*(1 + math.abs(trend)) / (1 + vol*50)
    if comp >= priThr
        dir  = score > 0 ? BULL : BEAR
        conf = clamp(qual*0.4 + comp*0.6, 0.0, 1.0)
        rat  = "Primary " + str.tostring(math.round(comp, 3))
        Signal.new(dir=dir, strength=comp, conf=conf,
                   rationale=rat, source="Primary",
                   quality=comp/priThr)
    else
        Signal.new(dir=FLAT, strength=0.0, conf=0.0,
                   rationale="No primary", source="None",
                   quality=0.0)

// @function Generates secondary signal pathway analysis  
// @param score Raw signal score
// @param mom Momentum indicator value
// @param qual Quality assessment score
// @param secThr Secondary threshold level
// @returns Signal Secondary pathway signal object
secondary(score, mom, qual, secThr) =>
    a = clamp(math.abs(score), 0.0, 1.0)
    b = clamp(math.abs(mom)  , 0.0, 1.0)
    c = clamp(qual           , 0.0, 1.0)
    denom = (a>0?1/a:0) + (b>0?1/b:0) + (c>0?1/c:0)
    harm  = denom > 0 ? 3.0/denom : 0.0
    if harm >= secThr
        dir  = score > 0 ? BULL : BEAR
        conf = harm*0.6
        rat  = "Secondary " + str.tostring(math.round(harm,3))
        Signal.new(dir=dir, strength=harm, conf=conf,
                   rationale=rat, source="Secondary",
                   quality=harm)
    else
        Signal.new(dir=FLAT, strength=0.0, conf=0.0,
                   rationale="No secondary", source="None",
                   quality=0.0)

// @function Selects optimal signal from primary and secondary pathways
// @param pri Primary signal object
// @param sec Secondary signal object  
// @returns Signal Selected optimal signal
choose(pri, sec) => 
    pri.strength > 0 ? pri : sec

// —————————————————  EXPORTED FUNCTIONS  —————————————————

// @function Generates advanced signal analysis with multi-pathway evaluation
// @param unifiedScore Unified market score input
// @param trendComp Trend component analysis factor
// @param momInd Momentum indicator value
// @param volFactor Volatility adjustment factor
// @param qualScore Quality assessment metric
// @param cyclePos Market cycle position (0.0-1.0, where 0.5 = neutral cycle phase)
// @param regime Market regime classification string ("bull", "bear", "sideways", "volatile")
// @returns Signal Comprehensive signal analysis result
export generateAdvancedSignal(float unifiedScore, float trendComp, float momInd, float volFactor, float qualScore, float cyclePos, string regime) =>
    // Advanced Threshold Calculation with Cycle Position Integration
    // Implements cycle-aware threshold modulation for enhanced signal precision
    [priThr, secThr] = thresh(volFactor, math.abs(trendComp))
    [ok, valQual]    = validate(math.abs(unifiedScore))

    // Market Regime Analysis and Parameter Adjustment
    // Applies regime-specific modifications to enhance signal reliability
    regimeMultiplier = switch regime
        "bull"     => 1.15    // Enhanced sensitivity in bullish conditions
        "bear"     => 1.25    // Increased threshold in bearish markets
        "volatile" => 0.85    // Reduced threshold for volatile environments
        "sideways" => 1.05    // Slight adjustment for ranging markets
        =>            1.00    // Default neutral multiplier

    // Cycle Position Modulation System
    // Incorporates market cycle phase analysis for temporal signal adjustment
    cycleAdjustment = 1.0 + (cyclePos - 0.5) * 0.3  // ±15% modulation range
    finalMultiplier = regimeMultiplier * cycleAdjustment

    if not ok
        Signal.new(dir=FLAT, strength=0.0, conf=0.0,
                   rationale="Validation failed - " + regime + " regime", source="None",
                   quality=valQual)
    else
        // Enhanced Signal Generation with Regime and Cycle Integration
        sPri = primary(unifiedScore, trendComp, volFactor,
                       qualScore, priThr * finalMultiplier)
        sSec = secondary(unifiedScore, momInd,
                         qualScore, secThr * finalMultiplier)
        sel  = choose(sPri, sSec)
        
        // Advanced Decay Calculation with Cycle-Dependent Persistence
        cyclePersistence = 0.75 + (math.abs(cyclePos - 0.5) * 0.5)  // 0.75-1.0 range
        adaptiveDecay = DECAY * cyclePersistence
        decStrength = sel.strength * adaptiveDecay
        
        // Comprehensive Quality Assessment with Multi-Factor Integration
        enhancedQuality = (sel.quality + qualScore + valQual + (1.0 - math.abs(cyclePos - 0.5))) / 4.0
        
        Signal.new(dir=sel.dir, strength=decStrength, conf=sel.conf,
                   rationale=sel.rationale + " [" + regime + "|" + str.tostring(math.round(cyclePos, 2)) + "]", 
                   source=sel.source,
                   quality=enhancedQuality)

// @function Analyzes pattern-based signal components with multi-dimensional price action evaluation
// @param h High price value for range analysis
// @param l Low price value for support/resistance detection
// @param c Close price value for momentum assessment
// @param v Volume data for confirmation analysis
// @param w Analysis window period for pattern formation timeframe
// @param reg Market regime string for context-aware pattern interpretation
// @returns Signal Pattern analysis signal with comprehensive technical evaluation
export analyzePatternSignals(float h, float l, float c, float v, int w, string reg) =>
    // Advanced Price Action Analysis Framework
    // Implements multi-dimensional pattern recognition with volume confirmation
    
    // Primary Pattern Metrics Calculation
    // Establishes foundational measurements for pattern classification
    priceRange = h - l
    bodySize = math.abs(c - ((h + l) / 2))  // Distance from midpoint
    rangePosition = (c - l) / (priceRange > 0 ? priceRange : 1.0)  // Relative close position
    
    // Volume-Weighted Pattern Strength Assessment
    // Integrates volume analysis for enhanced pattern reliability
    volumeIntensity = clamp(v / (v + 1.0), 0.0, 1.0)  // Normalized volume factor
    volumeAdjustedStrength = bodySize * (1.0 + volumeIntensity * 0.5)
    
    // Window-Based Pattern Persistence Evaluation
    // Incorporates temporal analysis window for pattern significance
    windowMultiplier = clamp(float(w) / 20.0, 0.5, 2.0)  // Normalized window influence
    persistenceScore = volumeAdjustedStrength * windowMultiplier
    
    // Regime-Specific Pattern Interpretation Matrix
    // Applies market context for enhanced pattern classification accuracy
    regimeAdjustment = switch reg
        "bull"     => rangePosition > 0.6 ? 1.3 : 0.8    // Favor upper-range closes in bull markets
        "bear"     => rangePosition < 0.4 ? 1.3 : 0.8    // Favor lower-range closes in bear markets
        "volatile" => priceRange > bodySize ? 1.2 : 0.9  // Enhanced sensitivity to range patterns
        "sideways" => math.abs(rangePosition - 0.5) < 0.3 ? 1.1 : 0.85  // Favor balanced patterns
        =>            1.0  // Default neutral adjustment
    
    // Comprehensive Pattern Signal Generation
    // Synthesizes multi-factor analysis into unified signal output
    finalStrength = clamp(persistenceScore * regimeAdjustment, 0.0, 1.0)
    
    // Pattern Direction Classification System
    // Determines bullish/bearish bias through position and volume analysis
    signalDirection = if finalStrength > 0.15
        rangePosition > 0.55 ? BULL : (rangePosition < 0.45 ? BEAR : FLAT)
    else
        FLAT
    
    // Enhanced Confidence Calculation with Multi-Factor Validation
    confidenceMetrics = (rangePosition * 0.4) + (volumeIntensity * 0.3) + (windowMultiplier * 0.3)
    adjustedConfidence = clamp(confidenceMetrics * regimeAdjustment, 0.0, 1.0)
    
    // Pattern Quality Assessment Framework
    // Evaluates signal reliability through comprehensive technical analysis
    rangeValidityFactor = priceRange > 0 ? 0.25 : 0.0           // Range validity assessment
    volumeConfirmationFactor = volumeIntensity * 0.25           // Volume confirmation strength  
    positionSignificanceFactor = math.abs(rangePosition - 0.5) * 0.25  // Position significance metric
    strengthValidationFactor = finalStrength > 0.15 ? 0.25 : 0.0       // Strength validation threshold
    
    // Composite Quality Score Calculation
    // Aggregates multi-dimensional quality metrics for comprehensive assessment
    patternQuality = rangeValidityFactor + volumeConfirmationFactor + positionSignificanceFactor + strengthValidationFactor
    
    // Comprehensive Signal Construction with Technical Attribution
    rationale = "Pattern[" + reg + "|W:" + str.tostring(w) + "|R:" + str.tostring(math.round(rangePosition, 2)) + "|V:" + str.tostring(math.round(volumeIntensity, 2)) + "]"
    
    Signal.new(dir=signalDirection, strength=finalStrength, conf=adjustedConfidence,
               rationale=rationale, source="Pattern",
               quality=patternQuality)

// @function Optimizes signal generation parameters through advanced statistical analysis
// @param s Signal array input for performance evaluation
// @param p Parameter array input for optimization target values
// @param w Window period for rolling optimization analysis
// @param m Optimization method string ("sharpe", "sortino", "calmar", "variance")
// @returns float Optimization result score representing parameter fitness
export optimizeSignalParameters(array<float> s, array<float> p, int w, string m) =>
    // Advanced Parameter Optimization Framework
    // Implements multi-method statistical analysis for signal enhancement
    
    // Input Validation and Boundary Conditions
    // Ensures robust operation with comprehensive error handling
    signalSize = array.size(s)
    paramSize = array.size(p)
    effectiveWindow = math.min(w, math.min(signalSize, paramSize))
    
    if signalSize == 0 or paramSize == 0 or effectiveWindow <= 0
        0.0  // Return neutral score for invalid inputs
    else
        // Rolling Window Signal Analysis Configuration
        // Establishes temporal analysis framework for optimization evaluation
        windowStart = math.max(0, signalSize - effectiveWindow)
        windowEnd = signalSize - 1
        
        // Signal Performance Metrics Calculation Engine
        // Computes comprehensive statistical measures for optimization assessment
        var float cumulativeReturn = 0.0
        var float cumulativeSquaredReturn = 0.0
        var float cumulativeDownsideRisk = 0.0
        var int validSamples = 0
        
        // Iterative Statistical Accumulation Process
        // Processes signal data through rolling window analysis
        for i = windowStart to windowEnd
            if i < signalSize and i < paramSize
                currentSignal = array.get(s, i)
                currentParam = array.get(p, i)
                
                // Signal-Parameter Interaction Analysis
                // Evaluates correlation between signal strength and parameter optimization
                signalReturn = currentSignal * currentParam  // Weighted signal evaluation
                cumulativeReturn += signalReturn
                cumulativeSquaredReturn += signalReturn * signalReturn
                
                // Downside Risk Assessment for Sortino Analysis
                // Captures negative performance metrics for comprehensive evaluation
                if signalReturn < 0.0
                    cumulativeDownsideRisk += signalReturn * signalReturn
                
                validSamples += 1
        
        // Statistical Normalization and Risk-Adjusted Metrics
        // Transforms raw accumulations into meaningful optimization scores
        if validSamples > 0
            meanReturn = cumulativeReturn / validSamples
            variance = validSamples > 1 ? (cumulativeSquaredReturn - (cumulativeReturn * cumulativeReturn / validSamples)) / (validSamples - 1) : 0.0
            standardDeviation = math.sqrt(math.max(variance, 0.0))
            downsideDeviation = math.sqrt(math.max(cumulativeDownsideRisk / validSamples, 0.0))
            
            // Method-Specific Optimization Algorithm Selection
            // Implements diverse optimization techniques based on specified methodology
            optimizationResult = switch m
                "sharpe"   => standardDeviation > 0.0 ? meanReturn / standardDeviation : 0.0              // Risk-adjusted return optimization
                "sortino"  => downsideDeviation > 0.0 ? meanReturn / downsideDeviation : meanReturn       // Downside risk-focused optimization  
                "calmar"   => standardDeviation > 0.0 ? math.abs(meanReturn) / standardDeviation : 0.0   // Maximum drawdown consideration
                "variance" => 1.0 / (1.0 + variance)                                                      // Variance minimization approach
                =>            meanReturn  // Default: Simple return optimization
            
            // Window-Adjusted Scoring Mechanism
            // Applies temporal weighting for enhanced optimization precision
            windowAdjustment = clamp(float(effectiveWindow) / float(w), 0.5, 1.0)
            finalScore = optimizationResult * windowAdjustment
            
            // Boundary Constraint Application for Numerical Stability
            // Ensures optimization scores remain within practical ranges
            clamp(finalScore, -10.0, 10.0)
        else
            0.0  // Return neutral score for insufficient data