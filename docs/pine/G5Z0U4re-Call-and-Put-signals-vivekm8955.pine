//@version=5
indicator('Call and Put signals[vivekm8955]', overlay=true, max_lines_count=500, max_labels_count=500)

// ——————————————————————————————
// INPUTS
// ——————————————————————————————
exponential_moving_average     = input.int(title='1st EMA (Fast)', defval=7, minval=0, maxval=250)
exponential2_moving_average    = input.int(title='2nd EMA (Slow)', defval=13, minval=0, maxval=250)
lengthK   = input.int(35, "%K Length",  minval = 1, maxval = 15000)
lengthD   = input.int(30,  "%D Length",  minval = 1, maxval = 4999)
lengthEMA = input.int(9,  "EMA Length", minval = 0, maxval = 4999)

// ——————————————————————————————
// PRICE & MOVING AVERAGES
// ——————————————————————————————
o = request.security(syminfo.tickerid, timeframe.period, open)
h = request.security(syminfo.tickerid, timeframe.period, high)
l = request.security(syminfo.tickerid, timeframe.period, low)
c = request.security(syminfo.tickerid, timeframe.period, close)
avg_price = (o + h + l + c) / 4

ema = ta.ema(close, exponential_moving_average)
ema2 = ta.ema(close, exponential2_moving_average)

// MA Crossover
ema1 = ta.ema(close, 4)
ema6 = ta.ema(close, 35)

// ——————————————————————————————
// BUY / SELL LOGIC
// ——————————————————————————————
sellsignal = ema > avg_price and ema2 > avg_price and ema2 > ema
buysignal  = ema < avg_price and ema2 < avg_price and ema2 < ema

sellseries = sellsignal and ta.crossover(ema2, ema)
buyseries  = buysignal and ta.crossunder(ema2, ema)

// ——————————————————————————————
// SIGNAL VISUALS
// ——————————————————————————————
plotshape(sellseries, title='🔽 PUT Signal', style=shape.labeldown, location=location.abovebar, color=color.new(#ff0000, 0), text='🔽 PUT', size=size.normal, textcolor=color.white)
plotshape(buyseries, title='🔼 CALL Signal', style=shape.labelup, location=location.belowbar, color=color.new(#11ff00, 0), text='🔼 CALL', size=size.normal, textcolor=color.black)

plot(ema1, title="EMA 4", color=color.white)
plot(ema2, title="EMA 30", color=color.yellow)

bgcolor(ta.crossover(ema1, ema2) ? color.rgb(0, 255, 8, 61) : na)
bgcolor(ta.crossunder(ema1, ema2) ? color.rgb(248, 0, 0, 67) : na)

// ——————————————————————————————
// HEIKIN ASHI CANDLE
// ——————————————————————————————
CANDLE_GREEN = #11ff00
CANDLE_RED   = #ff0400

haTicker = ticker.heikinashi(syminfo.tickerid)
[haO, haH, haL, haC] = request.security(haTicker, timeframe.period, [open, high, low, close])
candleColor = haC >= haO ? CANDLE_GREEN : CANDLE_RED
plotcandle(haO, haH, haL, haC, color=candleColor, title="Heikin Ashi")

// ——————————————————————————————
// SMI INDICATOR (Double EMA Version)
// ——————————————————————————————
emaEma(source, length) => ta.ema(ta.ema(source, length), length)

highestHigh = ta.highest(lengthK)
lowestLow = ta.lowest(lengthK)
highestLowestRange = highestHigh - lowestLow
relativeRange = close - (highestHigh + lowestLow) / 2
smi = 200 * (emaEma(relativeRange, lengthD) / emaEma(highestLowestRange, lengthD))

smiPlot = plot(smi, "SMI", color=color.blue)
emaSmi = ta.ema(smi, lengthEMA)
plot(emaSmi, "SMI-based EMA", color=color.orange)

// ——————————————————————————————
// TAKE PROFIT SIGNALS
// ——————————————————————————————
tpBuySignal  = ta.crossunder(smi, 0)
tpSellSignal = ta.crossover(smi, 0)

plotshape(tpBuySignal, title="✅ TP - Buy", color=color.green, style=shape.labelup, location=location.belowbar, text='TP', textcolor=color.red, size=size.small)
plotshape(tpSellSignal, title="✅ TP - Sell", color=color.red, style=shape.labeldown, location=location.abovebar, text='TP', textcolor=color.red, size=size.small)

// ——————————————————————————————
// INTERACTIVE PANE INFO
// ——————————————————————————————
var table t = table.new(position.top_right, 3, 4, border_width=1)

bgCol = buyseries ? color.new(color.green, 80) : sellseries ? color.new(color.red, 80) : na
table.cell(t, 0, 0, "Signal", bgcolor=color.gray, text_color=color.white, text_size=size.normal)
table.cell(t, 0, 1, buyseries ? "🔼 CALL" : sellseries ? "🔽 PUT" : "-", bgcolor=bgCol, text_color=color.white, text_size=size.normal)

table.cell(t, 1, 0, "SMI", bgcolor=color.gray, text_color=color.white)
table.cell(t, 1, 1, str.tostring(smi, "#.##"), text_color=color.blue)

table.cell(t, 2, 0, "TP Signal", bgcolor=color.gray, text_color=color.white)
table.cell(t, 2, 1, tpBuySignal ? "TP - BUY ✅" : tpSellSignal ? "TP - SELL ✅" : "-", text_color=tpBuySignal ? color.green : tpSellSignal ? color.red : color.gray)

// ——————————————————————————————
// ALERTS
// ——————————————————————————————
alertcondition(buysignal, title="🔼 Buy Alert", message="🔼 CALL Signal")
alertcondition(sellsignal, title="🔽 Sell Alert", message="🔽 PUT Signal")
alertcondition(tpBuySignal, title="✅ TP Buy Alert", message="✅ Take Profit BUY - SMI Crossunder 0")
alertcondition(tpSellSignal, title="✅ TP Sell Alert", message="✅ Take Profit SELL - SMI Crossover 0")
