        if show_boxes
            box.set_top(bx_d, max_d)
            box.set_rightbottom(bx_d, n, min_d)

        if show_txt
            if label_right
                if show_hi_labels and not na(lbl_d)
                    label.set_xy(lbl_d, n, max_d)
                if show_lo_labels and not na(lbl_lo_d)
