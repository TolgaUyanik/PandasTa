qn2_css  = input.color(color.new(#808080, 80), '', inline = 'qn2', group = grp_90m)

qn3_txt  = input.string('NY AM Q3', '', inline = 'qn3', group = grp_90m)
qn3_ses  = input.session('1500-1630', '', inline = 'qn3', group = grp_90m)
qn3_css  = input.color(color.new(#808080, 80), '', inline = 'qn3', group = grp_90m)

qn4_txt  = input.string('NY AM Q4', '', inline = 'qn4', group = grp_90m)
qn4_ses  = input.session('1630-1800', '', inline = 'qn4', group = grp_90m)
qn4_css  = input.color(color.new(#808080, 80), '', inline = 'qn4', group = grp_90m)

qp1_txt  = input.string('NY PM Q1', '', inline = 'qp1', group = grp_90m)
qp1_ses  = input.session('1800-1930', '', inline = 'qp1', group = grp_90m)
qp1_css  = input.color(color.new(#808080, 80), '', inline = 'qp1', group = grp_90m)

qp2_txt  = input.string('NY PM Q2', '', inline = 'qp2', group = grp_90m)
qp2_ses  = input.session('1930-2100', '', inline = 'qp2', group = grp_90m)
qp2_css  = input.color(color.new(#808080, 80), '', inline = 'qp2', group = grp_90m)

qp3_txt  = input.string('NY PM Q3', '', inline = 'qp3', group = grp_90m)
qp3_ses  = input.session('2100-2230', '', inline = 'qp3', group = grp_90m)
qp3_css  = input.color(color.new(#808080, 80), '', inline = 'qp3', group = grp_90m)

qp4_txt  = input.string('NY PM Q4', '', inline = 'qp4', group = grp_90m)
qp4_ses  = input.session('2230-0000', '', inline = 'qp4', group = grp_90m)
qp4_css  = input.color(color.new(#808080, 80), '', inline = 'qp4', group = grp_90m)

//Fair Value Gaps (FVG)
show_fvg = input.bool(true, title="Pokaz Fair Value Gaps (FVG)", group="Fair Value Gaps")
color_fvg_bull = input.color(color.new(#a7f5d0, 60), title="Kolor FVG Wzrostowej (Bullish)", group="Fair Value Gaps")
color_fvg_bear = input.color(color.new(#fecaca, 60), title="Kolor FVG Spadkowej (Bearish)", group="Fair Value Gaps")

//-----------------------------------------------------------------------------}
//Sessions
//-----------------------------------------------------------------------------{
n  = bar_index
tf = timeframe.period
tz = "Europe/Warsaw"

is_intraday = timeframe.isintraday
is_weekly   = timeframe.isweekly
is_monthly  = timeframe.ismonthly

//HTF data for accurate PMH/PML on all timeframes (including 1m)
[sec_pmH, sec_pmL] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

is_sesa = is_intraday ? math.sign(nz(time(tf, sesa_ses, tz))) : 0
is_sesb = is_intraday ? math.sign(nz(time(tf, sesb_ses, tz))) : 0
is_sesc = is_intraday ? math.sign(nz(time(tf, sesc_ses, tz))) : 0
is_sesd = is_intraday ? math.sign(nz(time(tf, sesd_ses, tz))) : 0
is_sese = is_intraday ? math.sign(nz(time(tf, sese_ses, tz))) : 0

//New trading day detection — anchored to fixed midnight Warsaw time (independent of user session inputs)
//EOD line snapping uses bar_index - 1
is_dopen_win    = is_intraday ? math.sign(nz(time(tf, '0000-0001', tz))) : 0
new_trading_day = is_intraday and is_dopen_win > is_dopen_win[1]

//Lookback
int bars_per_day_lb = math.ceil(82800 / timeframe.in_seconds())
in_lookback = use_lookback ? (last_bar_index - bar_index) <= lookback_days * bars_per_day_lb : true
in_box_lookback = use_box_lookback ? (last_bar_index - bar_index) <= box_lookback_days * bars_per_day_lb : true
in_90m_lookback = use_90m_lookback ? (last_bar_index - bar_index) <= lookback_90m_days * bars_per_day_lb : true

//Tracking arrays for persistent lines
var line[]  all_top_lines  = array.new_line()
var float[] all_top_levels = array.new_float()
var label[] all_top_labels = array.new_label()
var line[]  all_bot_lines  = array.new_line()
var float[] all_bot_levels = array.new_float()
var label[] all_bot_labels = array.new_label()

//-----------------------------------------------------------------------------}
//Session A Range
//-----------------------------------------------------------------------------{
var int   t_a       = na
var float max_a     = na
var float min_a     = na
var int   bar_max_a = na
var int   bar_min_a = na
var box   bx_a      = na
var label lbl_a     = na
var label lbl_lo_a  = na
var line  ln_top_a  = na
var line  ln_bot_a  = na
var line  ln_eq_a   = na

if show_sesa
    if is_sesa > is_sesa[1]
        t_a       := time
        max_a     := high
        min_a     := low
        bar_max_a := n
        bar_min_a := n

        if show_boxes and in_box_lookback
            bx_a := box.new(n, max_a, n, min_a
              , bgcolor = sesa_css
              , border_color = show_outline ? color.new(sesa_css, 0) : na
              , border_style = line.style_dotted)

        if show_txt and in_lookback
            string hi_txt_a = show_hl_suffix ? sesa_txt + ' High' : sesa_txt
            string lo_txt_a = show_hl_suffix ? sesa_txt + ' Low' : sesa_txt
            color  lbl_css_a = use_custom_color ? custom_label_css : color.new(sesa_css, 0)
            if show_hi_labels
                if label_right
                    lbl_a := label.new(n, max_a, hi_txt_a, xloc = xloc.bar_index, textcolor = lbl_css_a, style = label.style_label_lower_right, color = color.new(color.white, 100), size = label_size)
                else
                    lbl_a := label.new(t_a, max_a, hi_txt_a, xloc = xloc.bar_time, textcolor = lbl_css_a, style = label.style_label_down, color = color.new(color.white, 100), size = label_size)
            if show_lo_labels
                if label_right
                    lbl_lo_a := label.new(n, min_a, lo_txt_a, xloc = xloc.bar_index, textcolor = lbl_css_a, style = lo_right_style, color = color.new(color.white, 100), size = label_size)
                else
                    lbl_lo_a := label.new(t_a, min_a, lo_txt_a, xloc = xloc.bar_time, textcolor = lbl_css_a, style = label.style_label_up, color = color.new(color.white, 100), size = label_size)

        if show_lines and in_lookback
            ln_top_a := line.new(n, max_a, n, max_a, color = use_custom_line_color ? custom_line_css : color.new(sesa_css, 0), width = lines_width, style = lines_style)
            ln_bot_a := line.new(n, min_a, n, min_a, color = use_custom_line_color ? custom_line_css : color.new(sesa_css, 0), width = lines_width, style = lines_style)

        if show_ses_eq and in_box_lookback
            float eq_a = (max_a + min_a) / 2.0
            ln_eq_a := line.new(n, eq_a, n, eq_a, color = use_custom_eq_color ? custom_eq_css : color.new(sesa_css, 0), width = 1, style = ses_eq_style)

    if bool(is_sesa) and is_sesa == is_sesa[1]
        if high > max_a
            max_a     := high
            bar_max_a := n
        if low < min_a
            min_a     := low
            bar_min_a := n

        if show_boxes
            box.set_top(bx_a, max_a)
            box.set_rightbottom(bx_a, n, min_a)

        if show_txt
            if label_right
                if show_hi_labels and not na(lbl_a)
                    label.set_xy(lbl_a, n, max_a)
                if show_lo_labels and not na(lbl_lo_a)
                    label.set_xy(lbl_lo_a, n, min_a)
            else
                if show_hi_labels and not na(lbl_a)
                    label.set_xy(lbl_a, int(math.avg(t_a, time)), max_a)
                if show_lo_labels and not na(lbl_lo_a)
                    label.set_xy(lbl_lo_a, int(math.avg(t_a, time)), min_a)

        if show_lines and not na(ln_top_a)
            line.set_x1(ln_top_a, bar_max_a)
            line.set_y1(ln_top_a, max_a)
            line.set_y2(ln_top_a, max_a)
            line.set_x2(ln_top_a, n)
            line.set_x1(ln_bot_a, bar_min_a)
            line.set_y1(ln_bot_a, min_a)
            line.set_y2(ln_bot_a, min_a)
            line.set_x2(ln_bot_a, n)

        if show_ses_eq and not na(ln_eq_a)
            float eq_a = (max_a + min_a) / 2.0
            line.set_y1(ln_eq_a, eq_a)
            line.set_y2(ln_eq_a, eq_a)
            line.set_x2(ln_eq_a, n)

    //Session ended — push lines to tracking arrays for mitigation
    if is_sesa[1] > is_sesa and show_lines and not na(ln_top_a)
        array.push(all_top_lines, ln_top_a)
        array.push(all_top_levels, max_a)
        array.push(all_top_labels, (label_right) and show_txt and show_hi_labels ? lbl_a : na)
        array.push(all_bot_lines, ln_bot_a)
        array.push(all_bot_levels, min_a)
        array.push(all_bot_labels, (label_right) and show_lo_labels and show_txt ? lbl_lo_a : na)

//-----------------------------------------------------------------------------}
//Session B Range
//-----------------------------------------------------------------------------{
var int   t_b       = na
var float max_b     = na
var float min_b     = na
var int   bar_max_b = na
var int   bar_min_b = na
