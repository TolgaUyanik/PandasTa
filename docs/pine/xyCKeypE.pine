i_op6Color = input.color(#2a2e39, '', inline = 'op6', group = 'Opening Prices')

i_op7Show  = input.bool(false, '', inline = 'op7', group = 'Opening Prices')
i_op7Name  = input.string('20:00', '', inline = 'op7', group = 'Opening Prices')
i_op7Ses   = input.session('2000-2001', '', inline = 'op7', group = 'Opening Prices')
i_op7Color = input.color(#2a2e39, '', inline = 'op7', group = 'Opening Prices')

i_customOpStyle = input.string('Dotted', 'Custom Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'cops', group = 'Opening Prices')
i_opMultiShow   = input.bool(false, 'Show Previous Custom Opens', inline = 'opmulti', group = 'Opening Prices', tooltip = 'When enabled, shows previous days custom open price lines. Max 5 days back. The Custom Open Line Endpoint setting controls where all custom open lines end.')
i_opMultiDays   = input.int(2, '', minval = 1, maxval = 5, inline = 'opmulti', group = 'Opening Prices')
i_opMultiMode   = input.string('End of Day', 'Previous Custom Open Line Endpoint', options = ['End of Day', 'Next Opening', 'Current Bar'], inline = 'opmode', group = 'Opening Prices', tooltip = 'Controls where previous custom open lines end. End of Day stops at 5PM EST (end of trading day), Next Opening stops at the next occurrence of the same open time, Current Bar extends all lines to the current bar. Current day open lines always extend to the current bar.')

dOpenLineStyle = i_dOpenStyle == 'Dashed' ? line.style_dashed : i_dOpenStyle == 'Dotted' ? line.style_dotted : line.style_solid
wOpenLineStyle = i_wOpenStyle == 'Dashed' ? line.style_dashed : i_wOpenStyle == 'Dotted' ? line.style_dotted : line.style_solid
