            line.set_y1(ln_top_d, max_d)
            line.set_y2(ln_top_d, max_d)
            line.set_x2(ln_top_d, n)
            line.set_x1(ln_bot_d, bar_min_d)
            line.set_y1(ln_bot_d, min_d)
            line.set_y2(ln_bot_d, min_d)
            line.set_x2(ln_bot_d, n)

        if show_ses_eq and not na(ln_eq_d)
            float eq_d = (max_d + min_d) / 2.0
            line.set_y1(ln_eq_d, eq_d)
            line.set_y2(ln_eq_d, eq_d)
            line.set_x2(ln_eq_d, n)

    if is_sesd[1] > is_sesd and show_lines and not na(ln_top_d)
        array.push(all_top_lines, ln_top_d)
        array.push(all_top_levels, max_d)
        array.push(all_top_labels, (label_right) and show_txt and show_hi_labels ? lbl_d : na)
        array.push(all_bot_lines, ln_bot_d)
        array.push(all_bot_levels, min_d)
        array.push(all_bot_labels, (label_right) and show_lo_labels and show_txt ? lbl_lo_d : na)

//-----------------------------------------------------------------------------}
//Session E Range (NY Lunch)
//-----------------------------------------------------------------------------{
var int   t_e       = na
var float max_e     = na
var float min_e     = na
var int   bar_max_e = na
var int   bar_min_e = na
var box   bx_e      = na
var label lbl_e     = na
var label lbl_lo_e  = na
var line  ln_top_e  = na
var line  ln_bot_e  = na
var line  ln_eq_e   = na

if show_sese
    if is_sese > is_sese[1]
        t_e       := time
        max_e     := high
        min_e     := low
        bar_max_e := n
        bar_min_e := n

        if show_boxes and in_box_lookback
            bx_e := box.new(n, max_e, n, min_e
              , bgcolor = sese_css
              , border_color = show_outline ? color.new(sese_css, 0) : na
              , border_style = line.style_dotted)

        if show_txt and in_lookback
            string hi_txt_e = show_hl_suffix ? sese_txt + ' High' : sese_txt
            string lo_txt_e = show_hl_suffix ? sese_txt + ' Low' : sese_txt
            color  lbl_css_e = use_custom_color ? custom_label_css : color.new(sese_css, 0)
            if show_hi_labels
                if label_right
                    lbl_e := label.new(n, max_e, hi_txt_e, xloc = xloc.bar_index, textcolor = lbl_css_e, style = label.style_label_lower_right, color = color.new(color.white, 100), size = label_size)
                else
                    lbl_e := label.new(t_e, max_e, hi_txt_e, xloc = xloc.bar_time, textcolor = lbl_css_e, style = label.style_label_down, color = color.new(color.white, 100), size = label_size)
            if show_lo_labels
                if label_right
                    lbl_lo_e := label.new(n, min_e, lo_txt_e, xloc = xloc.bar_index, textcolor = lbl_css_e, style = lo_right_style, color = color.new(color.white, 100), size = label_size)
                else
                    lbl_lo_e := label.new(t_e, min_e, lo_txt_e, xloc = xloc.bar_time, textcolor = lbl_css_e, style = label.style_label_up, color = color.new(color.white, 100), size = label_size)

        if show_lines and in_lookback
            ln_top_e := line.new(n, max_e, n, max_e, color = use_custom_line_color ? custom_line_css : color.new(sese_css, 0), width = lines_width, style = lines_style)
            ln_bot_e := line.new(n, min_e, n, min_e, color = use_custom_line_color ? custom_line_css : color.new(sese_css, 0), width = lines_width, style = lines_style)

        if show_ses_eq and in_box_lookback
            float eq_e = (max_e + min_e) / 2.0
            ln_eq_e := line.new(n, eq_e, n, eq_e, color = use_custom_eq_color ? custom_eq_css : color.new(sese_css, 0), width = 1, style = ses_eq_style)

    if bool(is_sese) and is_sese == is_sese[1]
        if high > max_e
            max_e     := high
            bar_max_e := n
        if low < min_e
            min_e     := low
            bar_min_e := n

        if show_boxes
            box.set_top(bx_e, max_e)
            box.set_rightbottom(bx_e, n, min_e)

        if show_txt
            if label_right
                if show_hi_labels and not na(lbl_e)
                    label.set_xy(lbl_e, n, max_e)
                if show_lo_labels and not na(lbl_lo_e)
                    label.set_xy(lbl_lo_e, n, min_e)
            else
                if show_hi_labels and not na(lbl_e)
                    label.set_xy(lbl_e, int(math.avg(t_e, time)), max_e)
                if show_lo_labels and not na(lbl_lo_e)
                    label.set_xy(lbl_lo_e, int(math.avg(t_e, time)), min_e)

        if show_lines and not na(ln_top_e)
            line.set_x1(ln_top_e, bar_max_e)
            line.set_y1(ln_top_e, max_e)
            line.set_y2(ln_top_e, max_e)
            line.set_x2(ln_top_e, n)
            line.set_x1(ln_bot_e, bar_min_e)
            line.set_y1(ln_bot_e, min_e)
            line.set_y2(ln_bot_e, min_e)
            line.set_x2(ln_bot_e, n)

        if show_ses_eq and not na(ln_eq_e)
            float eq_e = (max_e + min_e) / 2.0
            line.set_y1(ln_eq_e, eq_e)
            line.set_y2(ln_eq_e, eq_e)
            line.set_x2(ln_eq_e, n)

    if is_sese[1] > is_sese and show_lines and not na(ln_top_e)
        array.push(all_top_lines, ln_top_e)
        array.push(all_top_levels, max_e)
        array.push(all_top_labels, (label_right) and show_txt and show_hi_labels ? lbl_e : na)
        array.push(all_bot_lines, ln_bot_e)
        array.push(all_bot_levels, min_e)
        array.push(all_bot_labels, (label_right) and show_lo_labels and show_txt ? lbl_lo_e : na)

//-----------------------------------------------------------------------------}
//Line Mitigation & EOD Logic
//-----------------------------------------------------------------------------{
//Pending relabel arrays (filled during EOD, processed after tdH/tdL/twH/twL are set)
var label[] relabel_top_lbls = array.new_label()
var float[] relabel_top_lvls = array.new_float()
var label[] relabel_bot_lbls = array.new_label()
var float[] relabel_bot_lvls = array.new_float()

if show_lines
    //Process top lines (session highs) — mitigated when price reaches the level
    if array.size(all_top_lines) > 0
        for i = array.size(all_top_lines) - 1 to 0
            ln  = array.get(all_top_lines, i)
            lvl = array.get(all_top_levels, i)
            lbl = array.get(all_top_labels, i)

            if high >= lvl
                //Mitigated
                if remove_mitigated
                    line.delete(ln)
                    if not na(lbl)
                        label.delete(lbl)
                else
                    line.set_x2(ln, n)
                    if not na(lbl)
                        label.set_x(lbl, n)
                array.remove(all_top_lines, i)
                array.remove(all_top_levels, i)
                array.remove(all_top_labels, i)
            else if new_trading_day and not extend_to_current
                //Queue for relabeling (processed after tdH/twH are set)
                if i_showDayWeekLabels and not na(lbl)
                    array.push(relabel_top_lbls, lbl)
                    array.push(relabel_top_lvls, lvl)
                //EOD — snap to last bar before 6PM EST (= ~5PM EOD bar on futures with halt)
                line.set_x2(ln, n - 1)
                if not na(lbl)
                    label.set_x(lbl, n - 1)
                array.remove(all_top_lines, i)
                array.remove(all_top_levels, i)
                array.remove(all_top_labels, i)
            else
                //Queue for relabeling on new trading day (when extending)
                if new_trading_day and i_showDayWeekLabels and not na(lbl)
                    array.push(relabel_top_lbls, lbl)
                    array.push(relabel_top_lvls, lvl)
                //Keep extending
                line.set_x2(ln, n)
                if not na(lbl)
                    label.set_x(lbl, n)

    //Process bot lines (session lows) — mitigated when price reaches the level
    if array.size(all_bot_lines) > 0
        for i = array.size(all_bot_lines) - 1 to 0
            ln  = array.get(all_bot_lines, i)
            lvl = array.get(all_bot_levels, i)
            lbl = array.get(all_bot_labels, i)

            if low <= lvl
                //Mitigated
                if remove_mitigated
                    line.delete(ln)
                    if not na(lbl)
                        label.delete(lbl)
                else
                    line.set_x2(ln, n)
                    if not na(lbl)
                        label.set_x(lbl, n)
                array.remove(all_bot_lines, i)
                array.remove(all_bot_levels, i)
                array.remove(all_bot_labels, i)
            else if new_trading_day and not extend_to_current
                //Queue for relabeling (processed after tdL/twL are set)
                if i_showDayWeekLabels and not na(lbl)
                    array.push(relabel_bot_lbls, lbl)
                    array.push(relabel_bot_lvls, lvl)
                //EOD — snap to last bar before 6PM EST (= ~5PM EOD bar on futures with halt)
                line.set_x2(ln, n - 1)
                if not na(lbl)
                    label.set_x(lbl, n - 1)
                array.remove(all_bot_lines, i)
                array.remove(all_bot_levels, i)
                array.remove(all_bot_labels, i)
            else
                //Relabel on new trading day (when extending)
                if new_trading_day and i_showDayWeekLabels and not na(lbl)
                    array.push(relabel_bot_lbls, lbl)
                    array.push(relabel_bot_lvls, lvl)
                //Keep extending
                line.set_x2(ln, n)
                if not na(lbl)
                    label.set_x(lbl, n)

//-----------------------------------------------------------------------------}
//Previous Hour High/Low
//-----------------------------------------------------------------------------{
_newHour = ta.change(time("60")) != 0
bool newHour = is_intraday and _newHour

var float thH = na, var float thL = na
var int thHBar = na, var int thLBar = na
var float phH = na, var float phL = na
var int phHBar = na, var int phLBar = na

if newHour
    phH := thH, phL := thL
    phHBar := thHBar, phLBar := thLBar
    thH := high, thL := low
    thHBar := bar_index, thLBar := bar_index

if not newHour
    if na(thH)
        thH := high, thL := low
        thHBar := bar_index, thLBar := bar_index
    if high > nz(thH, high)
        thH := high, thHBar := bar_index
    if low < nz(thL, low)
        thL := low, thLBar := bar_index

bool validPH = not na(phH) and not na(phL)

var line ln_phh = na, var line ln_phl = na
var label lb_phh = na, var label lb_phl = na

if newHour and validPH
    line.delete(ln_phh), line.delete(ln_phl)
    label.delete(lb_phh), label.delete(lb_phl)
    int phhS = math.max(nz(phHBar, bar_index), bar_index - 499)
    int phlS = math.max(nz(phLBar, bar_index), bar_index - 499)

    if i_phhShow
        ln_phh := line.new(phhS, phH, bar_index, phH, color = i_phhColor, width = 1, style = phhLineStyle)
    if i_phlShow
        ln_phl := line.new(phlS, phL, bar_index, phL, color = i_phlColor, width = 1, style = phlLineStyle)

if i_phhShow and not na(ln_phh)
    line.set_x2(ln_phh, bar_index + 5)
if i_phlShow and not na(ln_phl)
    line.set_x2(ln_phl, bar_index + 5)

if remove_prev_hour_mitigated
    if i_phhShow and not na(ln_phh) and high >= phH
        line.delete(ln_phh), label.delete(lb_phh)
        ln_phh := na, lb_phh := na
    if i_phlShow and not na(ln_phl) and low <= phL
        line.delete(ln_phl), label.delete(lb_phl)
        ln_phl := na, lb_phl := na

if barstate.islast and validPH
    int phLblX = bar_index + 5
    if i_phhShow and not na(ln_phh)
        label.delete(lb_phh)
        lb_phh := label.new(phLblX, phH, 'PHH', style = label.style_label_left, color = color(na), textcolor = i_phhColor, size = size.small)
    if i_phlShow and not na(ln_phl)
        label.delete(lb_phl)
        lb_phl := label.new(phLblX, phL, 'PHL', style = label.style_label_left, color = color(na), textcolor = i_phlColor, size = size.small)

//-----------------------------------------------------------------------------}
//Previous Day, Week, and Month Levels
//-----------------------------------------------------------------------------{
_newDay = ta.change(time("D")) != 0
bool newDay = (is_intraday or timeframe.isdaily) and _newDay

var float tdH = na, var float tdL = na
var int tdHBar = na, var int tdLBar = na
var float pdH = na, var float pdL = na, var float pdEQ = na, var float pdC = na
var int pdHBar = na, var int pdLBar = na
var int dayStartBar = na

if newDay
    pdH := tdH, pdL := tdL
    pdEQ := (tdH + tdL) / 2.0
    pdC := close[1]
    pdHBar := tdHBar, pdLBar := tdLBar
    dayStartBar := bar_index
    tdH := high, tdL := low
    tdHBar := bar_index, tdLBar := bar_index

if not newDay
    if na(tdH)
        tdH := high, tdL := low
        tdHBar := bar_index, tdLBar := bar_index
    if high > nz(tdH, high)
        tdH := high, tdHBar := bar_index
    if low < nz(tdL, low)
        tdL := low, tdLBar := bar_index

bool validPD = not na(pdH) and not na(pdL)

var line ln_pdh = na, var line ln_pdl = na, var line ln_pdeq = na, var line ln_pdc = na
var label lb_pdh = na, var label lb_pdl = na, var label lb_pdeq = na, var label lb_pdc = na

if newDay and validPD
    line.delete(ln_pdh), line.delete(ln_pdl), line.delete(ln_pdeq), line.delete(ln_pdc)
    label.delete(lb_pdh), label.delete(lb_pdl), label.delete(lb_pdeq), label.delete(lb_pdc)
    int phS = math.max(nz(pdHBar, bar_index), bar_index - 499)
    int plS = math.max(nz(pdLBar, bar_index), bar_index - 499)
    int dS  = math.max(nz(dayStartBar, bar_index), bar_index - 499)

    if i_pdhShow
        ln_pdh := line.new(phS, pdH, bar_index, pdH, color = i_pdhColor, width = 1, style = pdhLineStyle)
    if i_pdlShow
        ln_pdl := line.new(plS, pdL, bar_index, pdL, color = i_pdlColor, width = 1, style = pdlLineStyle)
    if i_pdeqShow
        ln_pdeq := line.new(dS, pdEQ, bar_index, pdEQ, color = i_pdeqColor, width = 1, style = pdeqLineStyle)
    if i_pdcShow
        ln_pdc := line.new(bar_index - 1, pdC, bar_index, pdC, color = i_pdcColor, width = 1, style = pdcLineStyle)

//Extend PD lines and labels to current bar
if i_pdhShow and not na(ln_pdh)
    line.set_x2(ln_pdh, bar_index + 5)
if i_pdlShow and not na(ln_pdl)
    line.set_x2(ln_pdl, bar_index + 5)
if i_pdeqShow and not na(ln_pdeq)
    line.set_x2(ln_pdeq, bar_index + 5)
if i_pdcShow and not na(ln_pdc)
    line.set_x2(ln_pdc, bar_index + 5)

if remove_prev_mitigated
    if i_pdhShow and not na(ln_pdh) and high >= pdH
        line.delete(ln_pdh), label.delete(lb_pdh)
        ln_pdh := na, lb_pdh := na
    if i_pdlShow and not na(ln_pdl) and low <= pdL
        line.delete(ln_pdl), label.delete(lb_pdl)
        ln_pdl := na, lb_pdl := na

if barstate.islast and validPD
    int lblX = bar_index + 5
    if i_pdhShow and not na(ln_pdh)
        label.delete(lb_pdh)
        lb_pdh := label.new(lblX, pdH, 'PDH', style = label.style_label_left, color = color(na), textcolor = i_pdhColor, size = size.small)
    if i_pdlShow and not na(ln_pdl)
        label.delete(lb_pdl)
        lb_pdl := label.new(lblX, pdL, 'PDL', style = label.style_label_left, color = color(na), textcolor = i_pdlColor, size = size.small)
    if i_pdeqShow
        label.delete(lb_pdeq)
        lb_pdeq := label.new(lblX, pdEQ, 'PD EQ', style = label.style_label_left, color = color(na), textcolor = i_pdeqColor, size = size.small)
    if i_pdcShow and not na(ln_pdc)
        label.delete(lb_pdc)
        lb_pdc := label.new(lblX, pdC, 'PDC', style = label.style_label_left, color = color(na), textcolor = i_pdcColor, size = size.small)

//Previous Week High/Low
_newWeekPW = ta.change(time("W")) != 0
bool newWeekPW = not is_monthly and _newWeekPW

var float twH = na, var float twL = na
var int twHBar = na, var int twLBar = na
var float pwH = na, var float pwL = na, var float pwEQ = na
var int pwHBar = na, var int pwLBar = na

if newWeekPW
    pwH := twH, pwL := twL
    pwEQ := (twH + twL) / 2.0
    pwHBar := twHBar, pwLBar := twLBar
    twH := high, twL := low
    twHBar := bar_index, twLBar := bar_index

if not newWeekPW
    if na(twH)
        twH := high, twL := low
        twHBar := bar_index, twLBar := bar_index
    if high > nz(twH, high)
        twH := high, twHBar := bar_index
    if low < nz(twL, low)
        twL := low, twLBar := bar_index

bool validPW = not na(pwH) and not na(pwL)

var line ln_pwh = na, var line ln_pwl = na, var line ln_pweq = na
var label lb_pwh = na, var label lb_pwl = na, var label lb_pweq = na

if newWeekPW and validPW
    line.delete(ln_pwh), line.delete(ln_pwl), line.delete(ln_pweq)
    label.delete(lb_pwh), label.delete(lb_pwl), label.delete(lb_pweq)
    int pwh_x1 = not na(pwHBar) and (bar_index - pwHBar) < 500 ? pwHBar : bar_index
    int pwl_x1 = not na(pwLBar) and (bar_index - pwLBar) < 500 ? pwLBar : bar_index
    if i_pwhShow
        ln_pwh := line.new(pwh_x1, pwH, bar_index, pwH, color = i_pwhColor, width = 1, style = pwhLineStyle)
    if i_pwlShow
        ln_pwl := line.new(pwl_x1, pwL, bar_index, pwL, color = i_pwlColor, width = 1, style = pwlLineStyle)
    if i_pweqShow
        ln_pweq := line.new(bar_index, pwEQ, bar_index, pwEQ, color = i_pweqColor, width = 1, style = pweqLineStyle)

if not is_monthly and i_pwhShow and not na(ln_pwh)
    line.set_x2(ln_pwh, bar_index + 5)
if not is_monthly and i_pwlShow and not na(ln_pwl)
    line.set_x2(ln_pwl, bar_index + 5)
if not is_monthly and i_pweqShow and not na(ln_pweq)
    line.set_x2(ln_pweq, bar_index + 5)

if remove_prev_mitigated
    if i_pwhShow and not na(ln_pwh) and high >= pwH
        line.delete(ln_pwh), label.delete(lb_pwh)
        ln_pwh := na, lb_pwh := na
    if i_pwlShow and not na(ln_pwl) and low <= pwL
        line.delete(ln_pwl), label.delete(lb_pwl)
        ln_pwl := na, lb_pwl := na

if barstate.islast and validPW and not is_monthly
    int pwLblX = bar_index + 5
    if i_pwhShow and not na(ln_pwh)
        label.delete(lb_pwh)
        lb_pwh := label.new(pwLblX, pwH, 'PWH', style = label.style_label_left, color = color(na), textcolor = i_pwhColor, size = size.small)
    if i_pwlShow and not na(ln_pwl)
        label.delete(lb_pwl)
        lb_pwl := label.new(pwLblX, pwL, 'PWL', style = label.style_label_left, color = color(na), textcolor = i_pwlColor, size = size.small)
    if i_pweqShow
        label.delete(lb_pweq)
        lb_pweq := label.new(pwLblX, pwEQ, 'PW EQ', style = label.style_label_left, color = color(na), textcolor = i_pweqColor, size = size.small)

//Previous Month High/Low
bool newMonthPM = ta.change(time("M")) != 0

var float tmH = na, var float tmL = na
var int tmHBar = na, var int tmLBar = na
var float pmH = na, var float pmL = na
var int pmHBar = na, var int pmLBar = na

if newMonthPM
    pmH := sec_pmH, pmL := sec_pmL
    pmHBar := tmHBar, pmLBar := tmLBar
    tmH := high, tmL := low
    tmHBar := bar_index, tmLBar := bar_index

if not newMonthPM
    if na(tmH)
        tmH := high, tmL := low
        tmHBar := bar_index, tmLBar := bar_index
    if high > nz(tmH, high)
        tmH := high, tmHBar := bar_index
    if low < nz(tmL, low)
        tmL := low, tmLBar := bar_index

//Process pending relabels (pdH/pdL/twH/twL/tmH/tmL all available now)
if i_showDayWeekLabels and new_trading_day
    if array.size(relabel_top_lbls) > 0
        for i = 0 to array.size(relabel_top_lbls) - 1
            label rl = array.get(relabel_top_lbls, i)
            float rv = array.get(relabel_top_lvls, i)
            if not na(rl)
                if not na(pmH) and rv == pmH
                    label.set_text(rl, 'Month High')
                else if not na(pwH) and rv == pwH
                    label.set_text(rl, 'Week High')
                else if not na(pdH) and rv == pdH
                    label.set_text(rl, 'Day High')
        array.clear(relabel_top_lbls), array.clear(relabel_top_lvls)
    if array.size(relabel_bot_lbls) > 0
        for i = 0 to array.size(relabel_bot_lbls) - 1
            label rl = array.get(relabel_bot_lbls, i)
            float rv = array.get(relabel_bot_lvls, i)
            if not na(rl)
                if not na(pmL) and rv == pmL
                    label.set_text(rl, 'Month Low')
                else if not na(pwL) and rv == pwL
                    label.set_text(rl, 'Week Low')
                else if not na(pdL) and rv == pdL
                    label.set_text(rl, 'Day Low')
        array.clear(relabel_bot_lbls), array.clear(relabel_bot_lvls)

bool validPM = not na(pmH) and not na(pmL)

var line ln_pmh = na, var line ln_pml = na
var label lb_pmh = na, var label lb_pml = na

if newMonthPM and validPM
    line.delete(ln_pmh), line.delete(ln_pml)
    label.delete(lb_pmh), label.delete(lb_pml)
    int pmh_x1 = not na(pmHBar) and (bar_index - pmHBar) < 500 ? pmHBar : bar_index
    int pml_x1 = not na(pmLBar) and (bar_index - pmLBar) < 500 ? pmLBar : bar_index
    if i_pmhShow
        ln_pmh := line.new(pmh_x1, pmH, bar_index, pmH, color = i_pmhColor, width = 1, style = pmhLineStyle)
    if i_pmlShow
        ln_pml := line.new(pml_x1, pmL, bar_index, pmL, color = i_pmlColor, width = 1, style = pmlLineStyle)

if i_pmhShow and not na(ln_pmh)
    line.set_x2(ln_pmh, bar_index + 5)
if i_pmlShow and not na(ln_pml)
    line.set_x2(ln_pml, bar_index + 5)

//Initialize PMH/PML from HTF data if newMonthPM never fired (e.g., 1m chart starting mid-month)
if na(pmH) and not na(sec_pmH)
    pmH := sec_pmH
if na(pmL) and not na(sec_pmL)
    pmL := sec_pmL

//Create PM lines if initialized from HTF but newMonthPM hasn't fired
if not na(pmH) and not na(pmL) and na(ln_pmh) and i_pmhShow
    ln_pmh := line.new(bar_index, pmH, bar_index, pmH, color = i_pmhColor, width = 1, style = pmhLineStyle)
if not na(pmH) and not na(pmL) and na(ln_pml) and i_pmlShow
    ln_pml := line.new(bar_index, pmL, bar_index, pmL, color = i_pmlColor, width = 1, style = pmlLineStyle)

if remove_prev_mitigated
    if i_pmhShow and not na(ln_pmh) and high >= pmH
        line.delete(ln_pmh), label.delete(lb_pmh)
        ln_pmh := na, lb_pmh := na
    if i_pmlShow and not na(ln_pml) and low <= pmL
        line.delete(ln_pml), label.delete(lb_pml)
        ln_pml := na, lb_pml := na

if barstate.islast and validPM
    int pmLblX = bar_index + 5
    if i_pmhShow and not na(ln_pmh)
        label.delete(lb_pmh)
        lb_pmh := label.new(pmLblX, pmH, 'PMH', style = label.style_label_left, color = color(na), textcolor = i_pmhColor, size = size.small)
    if i_pmlShow and not na(ln_pml)
        label.delete(lb_pml)
        lb_pml := label.new(pmLblX, pmL, 'PML', style = label.style_label_left, color = color(na), textcolor = i_pmlColor, size = size.small)

//Overlap suppression — higher priority hides lower (PMH/L > PWH/L > PDH/L)
//Suppress PDH if it matches PWH or PMH
if not na(pdH)
    if (i_pwhShow and not na(pwH) and pdH == pwH) or (i_pmhShow and not na(pmH) and pdH == pmH)
        if not na(ln_pdh)
            line.delete(ln_pdh), label.delete(lb_pdh)
            ln_pdh := na, lb_pdh := na
//Suppress PDL if it matches PWL or PML
if not na(pdL)
    if (i_pwlShow and not na(pwL) and pdL == pwL) or (i_pmlShow and not na(pmL) and pdL == pmL)
        if not na(ln_pdl)
            line.delete(ln_pdl), label.delete(lb_pdl)
            ln_pdl := na, lb_pdl := na
//Suppress PWH if it matches PMH
if not na(pwH) and i_pmhShow and not na(pmH) and pwH == pmH
    if not na(ln_pwh)
        line.delete(ln_pwh), label.delete(lb_pwh)
        ln_pwh := na, lb_pwh := na
//Suppress PWL if it matches PML
if not na(pwL) and i_pmlShow and not na(pmL) and pwL == pmL
    if not na(ln_pwl)
        line.delete(ln_pwl), label.delete(lb_pwl)
        ln_pwl := na, lb_pwl := na

//-----------------------------------------------------------------------------}
//Opening Prices
//-----------------------------------------------------------------------------{
var float dOpen = na, var int dOpenBar = na
var float wOpen = na, var int wOpenBar = na
var float mOpen = na, var int mOpenBar = na

//Detect new daily/weekly/monthly
newWeek  = ta.change(time("W")) != 0
newMonth = ta.change(time("M")) != 0

if newDay
    dOpen    := open
    dOpenBar := bar_index
if newWeek
    wOpen    := open
    wOpenBar := bar_index
if newMonth
    mOpen    := open
    mOpenBar := bar_index

var float op1Open = na, var int op1Bar = na
var float op2Open = na, var int op2Bar = na
var float op3Open = na, var int op3Bar = na
var float op4Open = na, var int op4Bar = na
var float op5Open = na, var int op5Bar = na
var float op6Open = na, var int op6Bar = na
var float op7Open = na, var int op7Bar = na

//Historical open arrays (for multi-day) — prices, start bars, and EOD bars
var float[] op1_prices = array.new_float(), var int[] op1_bars = array.new_int(), var int[] op1_eods = array.new_int()
var float[] op2_prices = array.new_float(), var int[] op2_bars = array.new_int(), var int[] op2_eods = array.new_int()
var float[] op3_prices = array.new_float(), var int[] op3_bars = array.new_int(), var int[] op3_eods = array.new_int()
var float[] op4_prices = array.new_float(), var int[] op4_bars = array.new_int(), var int[] op4_eods = array.new_int()
var float[] op5_prices = array.new_float(), var int[] op5_bars = array.new_int(), var int[] op5_eods = array.new_int()
var float[] op6_prices = array.new_float(), var int[] op6_bars = array.new_int(), var int[] op6_eods = array.new_int()
var float[] op7_prices = array.new_float(), var int[] op7_bars = array.new_int(), var int[] op7_eods = array.new_int()
int opMaxArr = i_opMultiDays + 1

//Detect custom open times using session picker
is_op1 = math.sign(nz(time(tf, i_op1Ses, tz)))
new_op1 = is_op1 > is_op1[1]
is_op2 = math.sign(nz(time(tf, i_op2Ses, tz)))
new_op2 = is_op2 > is_op2[1]
is_op3 = math.sign(nz(time(tf, i_op3Ses, tz)))
new_op3 = is_op3 > is_op3[1]
is_op4 = math.sign(nz(time(tf, i_op4Ses, tz)))
new_op4 = is_op4 > is_op4[1]
is_op5 = math.sign(nz(time(tf, i_op5Ses, tz)))
new_op5 = is_op5 > is_op5[1]
is_op6 = math.sign(nz(time(tf, i_op6Ses, tz)))
new_op6 = is_op6 > is_op6[1]
is_op7 = math.sign(nz(time(tf, i_op7Ses, tz)))
new_op7 = is_op7 > is_op7[1]

if new_op1
    op1Open := open
    op1Bar  := bar_index
    if i_opMultiShow
        array.push(op1_prices, open), array.push(op1_bars, bar_index), array.push(op1_eods, 0)
        if array.size(op1_prices) > opMaxArr
            array.shift(op1_prices), array.shift(op1_bars), array.shift(op1_eods)
if new_op2
    op2Open := open
    op2Bar  := bar_index
    if i_opMultiShow
        array.push(op2_prices, open), array.push(op2_bars, bar_index), array.push(op2_eods, 0)
        if array.size(op2_prices) > opMaxArr
            array.shift(op2_prices), array.shift(op2_bars), array.shift(op2_eods)
if new_op3
    op3Open := open
    op3Bar  := bar_index
    if i_opMultiShow
        array.push(op3_prices, open), array.push(op3_bars, bar_index), array.push(op3_eods, 0)
        if array.size(op3_prices) > opMaxArr
            array.shift(op3_prices), array.shift(op3_bars), array.shift(op3_eods)
if new_op4
    op4Open := open
    op4Bar  := bar_index
    if i_opMultiShow
        array.push(op4_prices, open), array.push(op4_bars, bar_index), array.push(op4_eods, 0)
        if array.size(op4_prices) > opMaxArr
            array.shift(op4_prices), array.shift(op4_bars), array.shift(op4_eods)
if new_op5
    op5Open := open
    op5Bar  := bar_index
    if i_opMultiShow
        array.push(op5_prices, open), array.push(op5_bars, bar_index), array.push(op5_eods, 0)
        if array.size(op5_prices) > opMaxArr
            array.shift(op5_prices), array.shift(op5_bars), array.shift(op5_eods)
if new_op6
    op6Open := open
    op6Bar  := bar_index
    if i_opMultiShow
        array.push(op6_prices, open), array.push(op6_bars, bar_index), array.push(op6_eods, 0)
        if array.size(op6_prices) > opMaxArr
            array.shift(op6_prices), array.shift(op6_bars), array.shift(op6_eods)
if new_op7
    op7Open := open
    op7Bar  := bar_index
    if i_opMultiShow
        array.push(op7_prices, open), array.push(op7_bars, bar_index), array.push(op7_eods, 0)
        if array.size(op7_prices) > opMaxArr
            array.shift(op7_prices), array.shift(op7_bars), array.shift(op7_eods)

//Stamp EOD bars for all open entries that don't have one yet
stampEOD(int[] eods) =>
    if array.size(eods) > 0
        for j = 0 to array.size(eods) - 1
            if array.get(eods, j) == 0
                array.set(eods, j, bar_index - 1)

if new_trading_day and i_opMultiShow
    stampEOD(op1_eods), stampEOD(op2_eods), stampEOD(op3_eods)
    stampEOD(op4_eods), stampEOD(op5_eods), stampEOD(op6_eods)
    stampEOD(op7_eods)

//Label text from custom names
op1_txt = i_op1Name
op2_txt = i_op2Name
op3_txt = i_op3Name
op4_txt = i_op4Name
op5_txt = i_op5Name
op6_txt = i_op6Name
op7_txt = i_op7Name

var line ln_dOpen = na, var line ln_wOpen = na, var line ln_mOpen = na
var line ln_op1 = na, var line ln_op2 = na, var line ln_op3 = na
var line ln_op4 = na, var line ln_op5 = na, var line ln_op6 = na, var line ln_op7 = na
var label lb_dOpen = na, var label lb_wOpen = na, var label lb_mOpen = na
var label lb_op1 = na, var label lb_op2 = na, var label lb_op3 = na
var label lb_op4 = na, var label lb_op5 = na, var label lb_op6 = na, var label lb_op7 = na

//Daily Open (intraday + daily)
if not is_weekly and not is_monthly and newDay and not (newWeek and i_wOpenShow) and not (newMonth and i_mOpenShow) and i_dOpenShow
    line.delete(ln_dOpen), label.delete(lb_dOpen)
    ln_dOpen := line.new(bar_index, dOpen, bar_index, dOpen, color = i_dOpenColor, width = 1, style = dOpenLineStyle)

if not is_weekly and not is_monthly and i_dOpenShow and not na(ln_dOpen)
    line.set_x2(ln_dOpen, bar_index + 5)

//Weekly Open (intraday + daily + weekly, not monthly)
if not is_monthly and newWeek and not (newMonth and i_mOpenShow) and i_wOpenShow
    line.delete(ln_wOpen), label.delete(lb_wOpen)
    ln_wOpen := line.new(bar_index, wOpen, bar_index, wOpen, color = i_wOpenColor, width = 1, style = wOpenLineStyle)
    //Remove daily open on new week to prevent overlap
    if not na(ln_dOpen)
        line.delete(ln_dOpen), label.delete(lb_dOpen)
        ln_dOpen := na, lb_dOpen := na

if not is_monthly and i_wOpenShow and not na(ln_wOpen)
    line.set_x2(ln_wOpen, bar_index + 5)

//Monthly Open (all timeframes)
if newMonth and i_mOpenShow
    line.delete(ln_mOpen), label.delete(lb_mOpen)
    ln_mOpen := line.new(bar_index, mOpen, bar_index, mOpen, color = i_mOpenColor, width = 1, style = mOpenLineStyle)
    //Remove daily and weekly open on new month to prevent overlap
    if not na(ln_dOpen)
        line.delete(ln_dOpen), label.delete(lb_dOpen)
        ln_dOpen := na, lb_dOpen := na
    if not na(ln_wOpen)
        line.delete(ln_wOpen), label.delete(lb_wOpen)
        ln_wOpen := na, lb_wOpen := na

if i_mOpenShow and not na(ln_mOpen)
    line.set_x2(ln_mOpen, bar_index + 5)

//Custom Open 1 (intraday only)
if is_intraday and new_op1 and i_op1Show
    line.delete(ln_op1), label.delete(lb_op1)
    ln_op1 := line.new(bar_index, op1Open, bar_index, op1Open, color = i_op1Color, width = 1, style = customOpLineStyle)

if is_intraday and i_op1Show and not na(ln_op1)
    line.set_x2(ln_op1, bar_index + 5)

//Custom Open 2 (intraday only)
if is_intraday and new_op2 and i_op2Show
    line.delete(ln_op2), label.delete(lb_op2)
    ln_op2 := line.new(bar_index, op2Open, bar_index, op2Open, color = i_op2Color, width = 1, style = customOpLineStyle)

if is_intraday and i_op2Show and not na(ln_op2)
    line.set_x2(ln_op2, bar_index + 5)

//Custom Open 3 (intraday only)
if is_intraday and new_op3 and i_op3Show
    line.delete(ln_op3), label.delete(lb_op3)
    ln_op3 := line.new(bar_index, op3Open, bar_index, op3Open, color = i_op3Color, width = 1, style = customOpLineStyle)

if is_intraday and i_op3Show and not na(ln_op3)
    line.set_x2(ln_op3, bar_index + 5)

//Custom Open 4 (intraday only)
if is_intraday and new_op4 and i_op4Show
    line.delete(ln_op4), label.delete(lb_op4)
    ln_op4 := line.new(bar_index, op4Open, bar_index, op4Open, color = i_op4Color, width = 1, style = customOpLineStyle)

if is_intraday and i_op4Show and not na(ln_op4)
    line.set_x2(ln_op4, bar_index + 5)

//Custom Open 5 (intraday only)
if is_intraday and new_op5 and i_op5Show
    line.delete(ln_op5), label.delete(lb_op5)
    ln_op5 := line.new(bar_index, op5Open, bar_index, op5Open, color = i_op5Color, width = 1, style = customOpLineStyle)

if is_intraday and i_op5Show and not na(ln_op5)
    line.set_x2(ln_op5, bar_index + 5)

//Custom Open 6 (intraday only)
if is_intraday and new_op6 and i_op6Show
    line.delete(ln_op6), label.delete(lb_op6)
    ln_op6 := line.new(bar_index, op6Open, bar_index, op6Open, color = i_op6Color, width = 1, style = customOpLineStyle)

if is_intraday and i_op6Show and not na(ln_op6)
    line.set_x2(ln_op6, bar_index + 5)

//Custom Open 7 (intraday only)
if is_intraday and new_op7 and i_op7Show
    line.delete(ln_op7), label.delete(lb_op7)
    ln_op7 := line.new(bar_index, op7Open, bar_index, op7Open, color = i_op7Color, width = 1, style = customOpLineStyle)

if is_intraday and i_op7Show and not na(ln_op7)
    line.set_x2(ln_op7, bar_index + 5)

//Labels
if barstate.islast
    int opLblX = bar_index + 5
    if not is_weekly and not is_monthly and i_dOpenShow and not na(ln_dOpen)
        label.delete(lb_dOpen)
        lb_dOpen := label.new(opLblX, dOpen, 'Daily Open', style = label.style_label_left, color = color(na), textcolor = i_dOpenColor, size = size.small)
    if not is_monthly and i_wOpenShow and not na(ln_wOpen)
        label.delete(lb_wOpen)
        lb_wOpen := label.new(opLblX, wOpen, 'Weekly Open', style = label.style_label_left, color = color(na), textcolor = i_wOpenColor, size = size.small)
    if i_mOpenShow and not na(mOpen)
        label.delete(lb_mOpen)
        lb_mOpen := label.new(opLblX, mOpen, 'Monthly Open', style = label.style_label_left, color = color(na), textcolor = i_mOpenColor, size = size.small)
    if is_intraday and i_op1Show and not na(op1Open)
        label.delete(lb_op1)
        lb_op1 := label.new(opLblX, op1Open, op1_txt, style = label.style_label_left, color = color(na), textcolor = i_op1Color, size = size.small)
    if is_intraday and i_op2Show and not na(op2Open)
        label.delete(lb_op2)
        lb_op2 := label.new(opLblX, op2Open, op2_txt, style = label.style_label_left, color = color(na), textcolor = i_op2Color, size = size.small)
    if is_intraday and i_op3Show and not na(op3Open)
        label.delete(lb_op3)
        lb_op3 := label.new(opLblX, op3Open, op3_txt, style = label.style_label_left, color = color(na), textcolor = i_op3Color, size = size.small)
    if is_intraday and i_op4Show and not na(op4Open)
        label.delete(lb_op4)
        lb_op4 := label.new(opLblX, op4Open, op4_txt, style = label.style_label_left, color = color(na), textcolor = i_op4Color, size = size.small)
    if is_intraday and i_op5Show and not na(op5Open)
        label.delete(lb_op5)
        lb_op5 := label.new(opLblX, op5Open, op5_txt, style = label.style_label_left, color = color(na), textcolor = i_op5Color, size = size.small)
    if is_intraday and i_op6Show and not na(op6Open)
        label.delete(lb_op6)
        lb_op6 := label.new(opLblX, op6Open, op6_txt, style = label.style_label_left, color = color(na), textcolor = i_op6Color, size = size.small)
    if is_intraday and i_op7Show and not na(op7Open)
        label.delete(lb_op7)
        lb_op7 := label.new(opLblX, op7Open, op7_txt, style = label.style_label_left, color = color(na), textcolor = i_op7Color, size = size.small)

//Previous Custom Opens (multi-day, drawn on last bar)
var line[]  hist_op_lines  = array.new_line()
var label[] hist_op_labels = array.new_label()

drawHistOpen(float[] prices, int[] bars, int[] eods, bool show, string txt, color css) =>
    if show and array.size(prices) > 1
        int sz = array.size(prices)
        for i = 0 to sz - 2
            float p       = array.get(prices, i)
            int rawStart  = array.get(bars, i)
            int startBar  = math.max(rawStart, bar_index - 499)
            int nextBar   = array.get(bars, i + 1)
            int eodBar    = array.get(eods, i)
            int endBar    = i_opMultiMode == 'Current Bar' ? bar_index + 5 : i_opMultiMode == 'Next Opening' ? nextBar : (eodBar > 0 ? eodBar : bar_index + 5)
            endBar        := math.max(endBar, startBar)
            array.push(hist_op_lines, line.new(startBar, p, endBar, p, color = css, width = 1, style = customOpLineStyle))
            int lblX = i_opMultiMode == 'Current Bar' ? bar_index + 5 : endBar
            array.push(hist_op_labels, label.new(lblX, p, txt, style = label.style_label_left, color = color(na), textcolor = css, size = size.small))

if barstate.islast and is_intraday and i_opMultiShow
    //Clean up old drawings
    if array.size(hist_op_lines) > 0
        for i = 0 to array.size(hist_op_lines) - 1
            line.delete(array.get(hist_op_lines, i))
        array.clear(hist_op_lines)
    if array.size(hist_op_labels) > 0
        for i = 0 to array.size(hist_op_labels) - 1
            label.delete(array.get(hist_op_labels, i))
        array.clear(hist_op_labels)
    //Draw all historical opens
    drawHistOpen(op1_prices, op1_bars, op1_eods, i_op1Show, op1_txt, i_op1Color)
    drawHistOpen(op2_prices, op2_bars, op2_eods, i_op2Show, op2_txt, i_op2Color)
    drawHistOpen(op3_prices, op3_bars, op3_eods, i_op3Show, op3_txt, i_op3Color)
    drawHistOpen(op4_prices, op4_bars, op4_eods, i_op4Show, op4_txt, i_op4Color)
    drawHistOpen(op5_prices, op5_bars, op5_eods, i_op5Show, op5_txt, i_op5Color)
    drawHistOpen(op6_prices, op6_bars, op6_eods, i_op6Show, op6_txt, i_op6Color)
    drawHistOpen(op7_prices, op7_bars, op7_eods, i_op7Show, op7_txt, i_op7Color)

//-----------------------------------------------------------------------------}
//Opening Gaps (NDOG / NWOG)
//-----------------------------------------------------------------------------{

//NDOG tracking arrays
var box[]   ndog_boxes   = array.new_box()
var line[]  ndog_mids    = array.new_line()
var label[] ndog_lbls    = array.new_label()
var float[] ndog_tops    = array.new_float()
var float[] ndog_bots    = array.new_float()
var bool[]  ndog_top_hit = array.new_bool()
var bool[]  ndog_bot_hit = array.new_bool()

//NWOG tracking arrays
var box[]   nwog_boxes   = array.new_box()
var line[]  nwog_mids    = array.new_line()
var label[] nwog_lbls    = array.new_label()
var float[] nwog_tops    = array.new_float()
var float[] nwog_bots    = array.new_float()
var bool[]  nwog_top_hit = array.new_bool()
var bool[]  nwog_bot_hit = array.new_bool()

//Create NDOG on new trading day
if is_intraday and i_ndogShow and new_trading_day and not (newWeek and i_nwogShow)
    float dg_close = close[1]
    float dg_open  = open
    float dg_top   = math.max(dg_close, dg_open)
    float dg_bot   = math.min(dg_close, dg_open)
    float dg_mid   = (dg_top + dg_bot) / 2.0

    if dg_top != dg_bot
        array.push(ndog_boxes, box.new(bar_index, dg_top, bar_index, dg_bot, bgcolor = i_ndogBgColor, border_color = na))
        array.push(ndog_mids, i_ndogShowMid ? line.new(bar_index, dg_mid, bar_index, dg_mid, color = i_ndogMid, width = 1, style = ndogMidStyle) : na)
        array.push(ndog_lbls, label.new(bar_index + 1, dg_mid, 'NDOG', style = label.style_label_left, color = color(na), textcolor = i_ndogMid, size = size.small))
        array.push(ndog_tops, dg_top)
        array.push(ndog_bots, dg_bot)
        array.push(ndog_top_hit, false)
        array.push(ndog_bot_hit, false)
        //Prune oldest if over max
        if i_ogMaxGaps and array.size(ndog_boxes) > i_ogMaxGapsVal
            box.delete(array.shift(ndog_boxes))
            line mid_old = array.shift(ndog_mids)
            if not na(mid_old)
                line.delete(mid_old)
            label.delete(array.shift(ndog_lbls))
            array.shift(ndog_tops), array.shift(ndog_bots)
            array.shift(ndog_top_hit), array.shift(ndog_bot_hit)

//Create NWOG on new week
if is_intraday and i_nwogShow and newWeek
    float wg_close = close[1]
    float wg_open  = open
    float wg_top   = math.max(wg_close, wg_open)
    float wg_bot   = math.min(wg_close, wg_open)
    float wg_mid   = (wg_top + wg_bot) / 2.0

    if wg_top != wg_bot
        array.push(nwog_boxes, box.new(bar_index, wg_top, bar_index, wg_bot, bgcolor = i_nwogBgColor, border_color = na))
        array.push(nwog_mids, i_nwogShowMid ? line.new(bar_index, wg_mid, bar_index, wg_mid, color = i_nwogMid, width = 1, style = nwogMidStyle) : na)
        array.push(nwog_lbls, label.new(bar_index + 1, wg_mid, 'NWOG', style = label.style_label_left, color = color(na), textcolor = i_nwogMid, size = size.small))
        array.push(nwog_tops, wg_top)
        array.push(nwog_bots, wg_bot)
        array.push(nwog_top_hit, false)
        array.push(nwog_bot_hit, false)
        //Prune oldest if over max
        if i_ogMaxGaps and array.size(nwog_boxes) > i_ogMaxGapsVal
            box.delete(array.shift(nwog_boxes))
            line mid_old = array.shift(nwog_mids)
            if not na(mid_old)
                line.delete(mid_old)
            label.delete(array.shift(nwog_lbls))
            array.shift(nwog_tops), array.shift(nwog_bots)
            array.shift(nwog_top_hit), array.shift(nwog_bot_hit)

//Extend and mitigate NDOG
if array.size(ndog_boxes) > 0
    for i = array.size(ndog_boxes) - 1 to 0
        bx  = array.get(ndog_boxes, i)
        mid = array.get(ndog_mids, i)
        lbl = array.get(ndog_lbls, i)
        gt  = array.get(ndog_tops, i)
        gb  = array.get(ndog_bots, i)

        //Track mitigation (both edges must be hit)
        if high >= gt
            array.set(ndog_top_hit, i, true)
        if low <= gb
            array.set(ndog_bot_hit, i, true)

        if i_ogRemoveMit and array.get(ndog_top_hit, i) and array.get(ndog_bot_hit, i)
            box.delete(bx)
            if not na(mid)
                line.delete(mid)
            label.delete(lbl)
            array.remove(ndog_boxes, i), array.remove(ndog_mids, i), array.remove(ndog_lbls, i)
            array.remove(ndog_tops, i), array.remove(ndog_bots, i)
            array.remove(ndog_top_hit, i), array.remove(ndog_bot_hit, i)
        else
            //Keep extending
            box.set_right(bx, bar_index)
            if not na(mid)
                line.set_x2(mid, bar_index)
            label.set_x(lbl, bar_index + 1)

//Extend and mitigate NWOG
if array.size(nwog_boxes) > 0
    for i = array.size(nwog_boxes) - 1 to 0
        bx  = array.get(nwog_boxes, i)
        mid = array.get(nwog_mids, i)
        lbl = array.get(nwog_lbls, i)
        gt  = array.get(nwog_tops, i)
        gb  = array.get(nwog_bots, i)

        //Track mitigation (both edges must be hit)
        if high >= gt
            array.set(nwog_top_hit, i, true)
        if low <= gb
            array.set(nwog_bot_hit, i, true)

        if i_ogRemoveMit and array.get(nwog_top_hit, i) and array.get(nwog_bot_hit, i)
            box.delete(bx)
            if not na(mid)
                line.delete(mid)
            label.delete(lbl)
            array.remove(nwog_boxes, i), array.remove(nwog_mids, i), array.remove(nwog_lbls, i)
            array.remove(nwog_tops, i), array.remove(nwog_bots, i)
            array.remove(nwog_top_hit, i), array.remove(nwog_bot_hit, i)
        else
            //Keep extending
            box.set_right(bx, bar_index)
            if not na(mid)
                line.set_x2(mid, bar_index)
            label.set_x(lbl, bar_index + 1)

//-----------------------------------------------------------------------------}
//Day of Week
//-----------------------------------------------------------------------------{
//Vertical lines at trading day start (6PM EST -> 00:00 Warsaw)
var line[] dow_lines = array.new_line()

if is_intraday and i_showDow and new_trading_day
    array.push(dow_lines, line.new(n, high, n, low, xloc = xloc.bar_index, extend = extend.both, color = i_dowColor, width = 1, style = line.style_dotted))
    if array.size(dow_lines) > i_dowDays
        line.delete(array.shift(dow_lines))

//Day of week labels — use bars from end for exact control
//Calculate bars per trading day based on timeframe (23 trading hours = 82800 seconds)
int bars_per_day = math.ceil(82800 / timeframe.in_seconds())
int dow_max_bars = i_dowDays * bars_per_day
bool in_dow_range = (last_bar_index - n) <= dow_max_bars

bool dowTime = hour == i_dowHour and minute == 0
plotchar(i_showDow and dowTime and in_dow_range and dayofweek == dayofweek.monday   ? true : false, char = ' ', text = 'M O N', color = color.new(i_dowTxtColor, 100), location = i_dowLoc, textcolor = i_dowTxtColor, editable = false)
plotchar(i_showDow and dowTime and in_dow_range and dayofweek == dayofweek.tuesday  ? true : false, char = ' ', text = 'T U E', color = color.new(i_dowTxtColor, 100), location = i_dowLoc, textcolor = i_dowTxtColor, editable = false)
plotchar(i_showDow and dowTime and in_dow_range and dayofweek == dayofweek.wednesday? true : false, char = ' ', text = 'W E D', color = color.new(i_dowTxtColor, 100), location = i_dowLoc, textcolor = i_dowTxtColor, editable = false)
plotchar(i_showDow and dowTime and in_dow_range and dayofweek == dayofweek.thursday ? true : false, char = ' ', text = 'T H U', color = color.new(i_dowTxtColor, 100), location = i_dowLoc, textcolor = i_dowTxtColor, editable = false)
plotchar(i_showDow and dowTime and in_dow_range and dayofweek == dayofweek.friday   ? true : false, char = ' ', text = 'F R I', color = color.new(i_dowTxtColor, 100), location = i_dowLoc, textcolor = i_dowTxtColor, editable = false)

//-----------------------------------------------------------------------------}
//90 Minute Cycles
//-----------------------------------------------------------------------------{
type QCycle
    float hi = na
    float lo = na
    int start_t = na
    box bx = na
    label lbl = na

method process(QCycle this, bool show, float is_now, float is_prev, color css, string txt, bool outline, bool labels, bool use_lbl_css, color lbl_css, string lbl_sz, bool in_lb) =>
    if show
        if is_now > is_prev
            this.start_t := time
            this.hi := high
            this.lo := low
            if in_lb
                this.bx := box.new(n, this.hi, n, this.lo
                  , bgcolor = css
                  , border_color = outline ? color.new(css, 0) : na
                  , border_style = line.style_dotted)
                if labels
                    color txt_css = use_lbl_css ? lbl_css : color.new(css, 0)
                    string sz = lbl_sz == 'Small' ? size.small : lbl_sz == 'Normal' ? size.normal : lbl_sz == 'Large' ? size.large : size.tiny
                    this.lbl := label.new(time, this.hi, txt
                      , xloc = xloc.bar_time
                      , textcolor = txt_css
                      , style = label.style_label_down
                      , color = color.new(color.white, 100)
                      , size = sz)
        if bool(is_now) and is_now == is_prev
            if high > this.hi
                this.hi := high
            if low < this.lo
                this.lo := low
            if not na(this.bx)
                box.set_top(this.bx, this.hi)
                box.set_rightbottom(this.bx, n, this.lo)
            if labels and not na(this.lbl)
                label.set_xy(this.lbl, int(math.avg(this.start_t, time)), this.hi)

//Session detection (intraday only)
is_qa1 = is_intraday ? math.sign(nz(time(tf, qa1_ses, tz))) : 0
is_qa2 = is_intraday ? math.sign(nz(time(tf, qa2_ses, tz))) : 0
is_qa3 = is_intraday ? math.sign(nz(time(tf, qa3_ses, tz))) : 0
is_qa4 = is_intraday ? math.sign(nz(time(tf, qa4_ses, tz))) : 0
is_ql1 = is_intraday ? math.sign(nz(time(tf, ql1_ses, tz))) : 0
is_ql2 = is_intraday ? math.sign(nz(time(tf, ql2_ses, tz))) : 0
is_ql3 = is_intraday ? math.sign(nz(time(tf, ql3_ses, tz))) : 0
is_ql4 = is_intraday ? math.sign(nz(time(tf, ql4_ses, tz))) : 0
is_qn1 = is_intraday ? math.sign(nz(time(tf, qn1_ses, tz))) : 0
is_qn2 = is_intraday ? math.sign(nz(time(tf, qn2_ses, tz))) : 0
is_qn3 = is_intraday ? math.sign(nz(time(tf, qn3_ses, tz))) : 0
is_qn4 = is_intraday ? math.sign(nz(time(tf, qn4_ses, tz))) : 0
is_qp1 = is_intraday ? math.sign(nz(time(tf, qp1_ses, tz))) : 0
is_qp2 = is_intraday ? math.sign(nz(time(tf, qp2_ses, tz))) : 0
is_qp3 = is_intraday ? math.sign(nz(time(tf, qp3_ses, tz))) : 0
is_qp4 = is_intraday ? math.sign(nz(time(tf, qp4_ses, tz))) : 0

//Quarter instances
var QCycle qcA1 = QCycle.new(), var QCycle qcA2 = QCycle.new()
var QCycle qcA3 = QCycle.new(), var QCycle qcA4 = QCycle.new()
var QCycle qcL1 = QCycle.new(), var QCycle qcL2 = QCycle.new()
var QCycle qcL3 = QCycle.new(), var QCycle qcL4 = QCycle.new()
var QCycle qcN1 = QCycle.new(), var QCycle qcN2 = QCycle.new()
var QCycle qcN3 = QCycle.new(), var QCycle qcN4 = QCycle.new()
var QCycle qcP1 = QCycle.new(), var QCycle qcP2 = QCycle.new()
var QCycle qcP3 = QCycle.new(), var QCycle qcP4 = QCycle.new()

//Process all quarters
qcA1.process(show_90m, is_qa1, is_qa1[1], qa1_css, qa1_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcA2.process(show_90m, is_qa2, is_qa2[1], qa2_css, qa2_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcA3.process(show_90m, is_qa3, is_qa3[1], qa3_css, qa3_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcA4.process(show_90m, is_qa4, is_qa4[1], qa4_css, qa4_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcL1.process(show_90m, is_ql1, is_ql1[1], ql1_css, ql1_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcL2.process(show_90m, is_ql2, is_ql2[1], ql2_css, ql2_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcL3.process(show_90m, is_ql3, is_ql3[1], ql3_css, ql3_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcL4.process(show_90m, is_ql4, is_ql4[1], ql4_css, ql4_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcN1.process(show_90m, is_qn1, is_qn1[1], qn1_css, qn1_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcN2.process(show_90m, is_qn2, is_qn2[1], qn2_css, qn2_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcN3.process(show_90m, is_qn3, is_qn3[1], qn3_css, qn3_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcN4.process(show_90m, is_qn4, is_qn4[1], qn4_css, qn4_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcP1.process(show_90m, is_qp1, is_qp1[1], qp1_css, qp1_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcP2.process(show_90m, is_qp2, is_qp2[1], qp2_css, qp2_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcP3.process(show_90m, is_qp3, is_qp3[1], qp3_css, qp3_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)
qcP4.process(show_90m, is_qp4, is_qp4[1], qp4_css, qp4_txt, show_90m_outline, show_90m_labels, use_90m_lbl_color, custom_90m_lbl_css, lbl_90m_size_str, in_90m_lookback)

//-----------------------------------------------------------------------------}
// RYSOWANIE FAIR VALUE GAPS (FVG)
//-----------------------------------------------------------------------------{
// FVG wzrostowa (Bullish) - luka miedzy high[2] a low[0]
is_bullish_fvg = low > high[2] and close[1] > open[1]
// FVG spadkowa (Bearish) - luka miedzy low[2] a high[0]
is_bearish_fvg = high < low[2] and close[1] < open[1]

if show_fvg and in_lookback
    // Rysujemy FVG jako male, statyczne prostokaty idealnie w miejscu wystapienia luki (od swiecy [2] do biezacej [0])
    if is_bullish_fvg
        box.new(left=bar_index[2], top=low, right=bar_index, bottom=high[2], border_color=na, bgcolor=color_fvg_bull)
        
    if is_bearish_fvg
        box.new(left=bar_index[2], top=low[2], right=bar_index, bottom=high, border_color=na, bgcolor=color_fvg_bear)


//-----------------------------------------------------------------------------}
// BOS & CHOCH MODULE
//-----------------------------------------------------------------------------{
grp_smc = "BOS & CHOCH"
show_smc = input.bool(true, title="Pokaz BOS i CHOCH", group=grp_smc)
pivot_len = input.int(5, title="Dlugosc Pivotow (Pivot Length)", minval=1, group=grp_smc)

var int smc_trend = 0
var float top_lvl = na
var int top_loc = na
var float btm_lvl = na
var int btm_loc = na

// Szukanie pivotów (dołki / szczyty)
p_h = ta.pivothigh(high, pivot_len, pivot_len)
p_l = ta.pivotlow(low, pivot_len, pivot_len)

if not na(p_h)
    top_lvl := p_h
    top_loc := bar_index[pivot_len]

if not na(p_l)
    btm_lvl := p_l
    btm_loc := bar_index[pivot_len]

// Ograniczenie rysowania do ostatnich 48 godzin 
// (48 godzin * 60 minut * 60 sekund * 1000 milisekund = 172800000)
bool in_48h_window = (timenow - time) <= 172800000

// Bycze wybicie (Bullish Breakout)
if not na(top_lvl) and close > top_lvl
    bool is_bos = (smc_trend == 1)
    string smc_txt = is_bos ? "BOS" : "CHOCH"

    if show_smc and in_48h_window
        line.new(top_loc, top_lvl, bar_index, top_lvl, color=color.red, style=line.style_dashed)
        label.new(int(math.avg(top_loc, bar_index)), top_lvl, smc_txt, color=color.new(color.white, 100), textcolor=color.red, style=label.style_none, size=size.small)

    top_lvl := na
    smc_trend := 1

// Niedźwiedzie wybicie (Bearish Breakout)
if not na(btm_lvl) and close < btm_lvl
    bool is_bos = (smc_trend == -1)
    string smc_txt = is_bos ? "BOS" : "CHOCH"

    if show_smc and in_48h_window
        line.new(btm_loc, btm_lvl, bar_index, btm_lvl, color=color.red, style=line.style_dashed)
        label.new(int(math.avg(btm_loc, bar_index)), btm_lvl, smc_txt, color=color.new(color.white, 100), textcolor=color.red, style=label.style_none, size=size.small)

    btm_lvl := na
    smc_trend := -1