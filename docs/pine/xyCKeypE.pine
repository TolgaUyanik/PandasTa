ndogMidStyle = i_ndogMidStyl == 'Dashed' ? line.style_dashed : i_ndogMidStyl == 'Dotted' ? line.style_dotted : line.style_solid
nwogMidStyle = i_nwogMidStyl == 'Dashed' ? line.style_dashed : i_nwogMidStyl == 'Dotted' ? line.style_dotted : line.style_solid

i_ogMaxGaps    = input.bool(true, 'Limit to Max Gaps', inline = 'ogmax', group = grp_og)
i_ogMaxGapsVal = input.int(2, '', minval = 1, maxval = 30, inline = 'ogmax', group = grp_og)
i_ogRemoveMit  = input.bool(false, 'Remove Mitigated Gaps', group = grp_og, tooltip = 'When enabled, gaps are removed from the chart once fully mitigated. Price must fill the entire gap (touch both the top and bottom) for it to be considered mitigated.')

//Day of Week
i_showDow     = input.bool(false, 'Show Day of Week', inline = 'dow', group = 'Day of Week')
i_dowTxtColor = input.color(#787b86, '', inline = 'dow', group = 'Day of Week')
