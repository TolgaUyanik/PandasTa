//@version=6
indicator("Sessions Suite [claysul] + FVG", overlay=true, max_bars_back=500, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
show_sesa = input(true, '', inline = 'sesa', group = 'Sessions')
sesa_txt  = input.string('Asia', '', inline = 'sesa', group = 'Sessions')
sesa_ses  = input.session('0000-0600', '', inline = 'sesa', group = 'Sessions')
sesa_css  = input.color(color.new(#ad6c1f, 90), '', inline = 'sesa', group = 'Sessions')

show_sesb = input(true, '', inline = 'sesb', group = 'Sessions')
sesb_txt  = input.string('London', '', inline = 'sesb', group = 'Sessions')
sesb_ses  = input.session('0600-1200', '', inline = 'sesb', group = 'Sessions')
sesb_css  = input.color(color.new(#3783c1, 90), '', inline = 'sesb', group = 'Sessions')

show_sesc = input(true, '', inline = 'sesc', group = 'Sessions')
sesc_txt  = input.string('NY AM', '', inline = 'sesc', group = 'Sessions')
sesc_ses  = input.session('1200-1800', '', inline = 'sesc', group = 'Sessions')
sesc_css  = input.color(color.new(#00332a, 90), '', inline = 'sesc', group = 'Sessions')

show_sesd = input(true, '', inline = 'sesd', group = 'Sessions')
sesd_txt  = input.string('NY PM', '', inline = 'sesd', group = 'Sessions')
sesd_ses  = input.session('1800-0000', '', inline = 'sesd', group = 'Sessions')
sesd_css  = input.color(color.new(#93585d, 90), '', inline = 'sesd', group = 'Sessions')

show_sese = input(false, '', inline = 'sese', group = 'Sessions')
sese_txt  = input.string('NY Lunch', '', inline = 'sese', group = 'Sessions')
sese_ses  = input.session('1800-1900', '', inline = 'sese', group = 'Sessions')
sese_css  = input.color(color.new(#2a2e39, 90), '', inline = 'sese', group = 'Sessions')

show_boxes     = input(true, 'Show Session Boxes', group = 'Sessions')
show_outline   = input(true, 'Show Session Borders', group = 'Sessions')
use_box_lookback = input(true, 'Limit Session Boxes to Max Days', inline = 'blkb', group = 'Sessions', tooltip = 'When enabled, session boxes are limited to the specified number of days (max 30). When disabled, session boxes have no limit (TradingView will auto-manage older drawings beyond its 500 object cap).')
box_lookback_days = input.int(2, '', minval = 1, maxval = 30, inline = 'blkb', group = 'Sessions')

show_ses_eq         = input(false, 'Show Session EQ (Equilibrium)', inline = 'eq', group = 'Sessions', tooltip = 'Session EQ visibility follows the "Limit Session Boxes to Max Days" setting — when enabled, EQ lines are limited to the same number of days as session boxes.')
ses_eq_style_str    = input.string('Dashed', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'eq', group = 'Sessions')
use_custom_eq_color = input(false, 'Use One Color for Session EQ', inline = 'eqc', group = 'Sessions', tooltip = 'By default, session EQ lines use each session\'s color. When enabled, this override applies a single color to all session EQ lines.')
custom_eq_css       = input.color(#000000, '', inline = 'eqc', group = 'Sessions')

ses_eq_style = ses_eq_style_str == 'Dashed' ? line.style_dashed : ses_eq_style_str == 'Dotted' ? line.style_dotted : line.style_solid

//Mitigation
extend_to_current   = input(false, 'Extend Unmitigated Lines to Current Bar', group = 'Mitigation')
remove_mitigated    = input(false, 'Remove Mitigated Lines (Requires Extend Lines ON)', group = 'Mitigation', tooltip = 'When enabled, mitigated lines and their labels are removed from the chart. The "Extend Unmitigated Lines to Current Bar" is required to be enabled in order for this option to work.')

//Session Lines
show_lines       = input(true, 'Show Session Lines', inline = 'ln', group = 'Session Lines')
lines_width      = input.int(1, 'Width', minval = 1, maxval = 4, inline = 'ln', group = 'Session Lines')
lines_style_str  = input.string('Solid', 'Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'ln', group = 'Session Lines')
use_custom_line_color = input(false, 'Use One Color for Session Lines', inline = 'lcl', group = 'Session Lines', tooltip = 'By default, session lines use each session\'s color. When enabled, this override applies a single color to all session lines.')
custom_line_css       = input.color(#000000, '', inline = 'lcl', group = 'Session Lines')
use_lookback          = input(true, 'Limit Lines/Labels to Max Days', inline = 'lkb', group = 'Session Lines', tooltip = 'When enabled, session lines and labels are limited to the specified number of days (max 30). When disabled, lines and labels have no limit (TradingView will auto-manage older drawings beyond its 500 object cap).')
lookback_days         = input.int(2, '', minval = 1, maxval = 30, inline = 'lkb', group = 'Session Lines')

lines_style = lines_style_str == 'Dashed' ? line.style_dashed : lines_style_str == 'Dotted' ? line.style_dotted : line.style_solid

//Session Labels
show_session_labels = input(true, 'Show Session Labels', group = 'Session Labels')
label_size_str = input.string('Small', 'Label Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = 'Session Labels')
label_mode     = input.string('Right of Line', 'Session Label Alignment', options = ['Centered (Box)', 'Right of Line'], group = 'Session Labels')
label_placement = input.string('Above Line', 'Session Label Placement', options = ['Above Line', 'Above / Below Line'], group = 'Session Labels', tooltip = 'When Above / Below Line is selected, low labels will be placed below the line instead of above. Only applies when Session Label Alignment is set to Right of Line.')
label_display  = input.string('High and Low', 'Session Label Display', options = ['High and Low', 'High Only', 'Low Only'], group = 'Session Labels')
show_hl_suffix = input(true, 'Show High/Low Text on Labels', group = 'Session Labels')
i_showDayWeekLabels = input(false, 'Relabel Session H/L to Day/Week/Month High and Low', group = 'Session Labels', tooltip = 'When enabled, session lines that match the day, week, or month high/low will be relabeled to "Day High", "Day Low", "Week High", "Week Low", "Month High", or "Month Low". Month labels take priority over week, which takes priority over day.')
use_custom_color = input(false, 'Use One Color for Session Labels', inline = 'lcol', group = 'Session Labels', tooltip = 'By default, session labels use each session\'s color. When enabled, this override applies a single color to all session labels.')
custom_label_css = input.color(#000000, '', inline = 'lcol', group = 'Session Labels')

label_size = label_size_str == 'Small' ? size.small : label_size_str == 'Normal' ? size.normal : label_size_str == 'Large' ? size.large : size.tiny
show_txt = show_session_labels
label_right = label_mode == 'Right of Line'
show_hi_labels = label_display == 'High and Low' or label_display == 'High Only'
show_lo_labels = label_display == 'High and Low' or label_display == 'Low Only'
lo_right_style = label_placement == 'Above / Below Line' ? label.style_label_upper_right : label.style_label_lower_right

//Previous Day, Week, and Month
grp_prev = 'Previous Day, Week, and Month'
i_pdhShow   = input.bool(true, 'PDH', inline = 'pdh', group = grp_prev, tooltip = 'Previous Day High')
i_pdhColor  = input.color(#2a2e39, '', inline = 'pdh', group = grp_prev)
i_pdhStyle  = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'pdh', group = grp_prev)
i_pdlShow   = input.bool(true, 'PDL', inline = 'pdl', group = grp_prev, tooltip = 'Previous Day Low')
i_pdlColor  = input.color(#2a2e39, '', inline = 'pdl', group = grp_prev)
i_pdlStyle  = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'pdl', group = grp_prev)
i_pdeqShow  = input.bool(false, 'PD EQ', inline = 'pdeq', group = grp_prev, tooltip = 'Previous Day Equilibrium — midpoint of PDH and PDL')
i_pdeqColor = input.color(#2a2e39, '', inline = 'pdeq', group = grp_prev)
i_pdeqStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'pdeq', group = grp_prev)
i_pdcShow   = input.bool(false, 'PDC', inline = 'pdc', group = grp_prev, tooltip = 'Previous Day Close')
i_pdcColor  = input.color(#2a2e39, '', inline = 'pdc', group = grp_prev)
i_pdcStyle  = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'pdc', group = grp_prev)

//Previous Hour
grp_prev_hour = 'Previous Hour'
i_phhShow  = input.bool(true, 'PHH', inline = 'phh', group = grp_prev_hour, tooltip = 'Previous Hour High')
i_phhColor = input.color(#2a2e39, '', inline = 'phh', group = grp_prev_hour)
i_phhStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'phh', group = grp_prev_hour)
i_phlShow  = input.bool(true, 'PHL', inline = 'phl', group = grp_prev_hour, tooltip = 'Previous Hour Low')
i_phlColor = input.color(#2a2e39, '', inline = 'phl', group = grp_prev_hour)
i_phlStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'phl', group = grp_prev_hour)

remove_prev_hour_mitigated = input(false, 'Remove Mitigated Previous Hour Lines', group = grp_prev_hour)

i_pwhShow   = input.bool(true, 'PWH', inline = 'pwh', group = grp_prev, tooltip = 'Previous Week High')
i_pwhColor  = input.color(#2a2e39, '', inline = 'pwh', group = grp_prev)
i_pwhStyle  = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'pwh', group = grp_prev)
i_pwlShow   = input.bool(true, 'PWL', inline = 'pwl', group = grp_prev, tooltip = 'Previous Week Low')
i_pwlColor  = input.color(#2a2e39, '', inline = 'pwl', group = grp_prev)
i_pwlStyle  = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'pwl', group = grp_prev)
i_pweqShow  = input.bool(false, 'PW EQ', inline = 'pweq', group = grp_prev, tooltip = 'Previous Week Equilibrium — midpoint of PWH and PWL')
i_pweqColor = input.color(#2a2e39, '', inline = 'pweq', group = grp_prev)
i_pweqStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'pweq', group = grp_prev)

i_pmhShow   = input.bool(true, 'PMH', inline = 'pmh', group = grp_prev, tooltip = 'Previous Month High')
i_pmhColor  = input.color(#2a2e39, '', inline = 'pmh', group = grp_prev)
i_pmhStyle  = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'pmh', group = grp_prev)
i_pmlShow   = input.bool(true, 'PML', inline = 'pml', group = grp_prev, tooltip = 'Previous Month Low')
i_pmlColor  = input.color(#2a2e39, '', inline = 'pml', group = grp_prev)
i_pmlStyle  = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'pml', group = grp_prev)

remove_prev_mitigated = input(false, 'Remove Mitigated Previous D/W/M Lines', group = grp_prev)

pdhLineStyle  = i_pdhStyle == 'Dashed' ? line.style_dashed : i_pdhStyle == 'Dotted' ? line.style_dotted : line.style_solid
pdlLineStyle  = i_pdlStyle == 'Dashed' ? line.style_dashed : i_pdlStyle == 'Dotted' ? line.style_dotted : line.style_solid
pdeqLineStyle = i_pdeqStyle == 'Dashed' ? line.style_dashed : i_pdeqStyle == 'Dotted' ? line.style_dotted : line.style_solid
pdcLineStyle  = i_pdcStyle == 'Dashed' ? line.style_dashed : i_pdcStyle == 'Dotted' ? line.style_dotted : line.style_solid
phhLineStyle  = i_phhStyle == 'Dashed' ? line.style_dashed : i_phhStyle == 'Dotted' ? line.style_dotted : line.style_solid
phlLineStyle  = i_phlStyle == 'Dashed' ? line.style_dashed : i_phlStyle == 'Dotted' ? line.style_dotted : line.style_solid
pwhLineStyle  = i_pwhStyle == 'Dashed' ? line.style_dashed : i_pwhStyle == 'Dotted' ? line.style_dotted : line.style_solid
pwlLineStyle  = i_pwlStyle == 'Dashed' ? line.style_dashed : i_pwlStyle == 'Dotted' ? line.style_dotted : line.style_solid
pweqLineStyle = i_pweqStyle == 'Dashed' ? line.style_dashed : i_pweqStyle == 'Dotted' ? line.style_dotted : line.style_solid
pmhLineStyle  = i_pmhStyle == 'Dashed' ? line.style_dashed : i_pmhStyle == 'Dotted' ? line.style_dotted : line.style_solid
pmlLineStyle  = i_pmlStyle == 'Dashed' ? line.style_dashed : i_pmlStyle == 'Dotted' ? line.style_dotted : line.style_solid

//Opening Prices
i_dOpenShow  = input.bool(true, 'Daily Open', inline = 'dopen', group = 'Opening Prices')
i_dOpenColor = input.color(#2a2e39, '', inline = 'dopen', group = 'Opening Prices')
i_dOpenStyle = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'dopen', group = 'Opening Prices')
