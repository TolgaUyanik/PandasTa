            if show_lo_labels
                if label_right
                    lbl_lo_b := label.new(n, min_b, lo_txt_b, xloc = xloc.bar_index, textcolor = lbl_css_b, style = lo_right_style, color = color.new(color.white, 100), size = label_size)
                else
                    lbl_lo_b := label.new(t_b, min_b, lo_txt_b, xloc = xloc.bar_time, textcolor = lbl_css_b, style = label.style_label_up, color = color.new(color.white, 100), size = label_size)

        if show_lines and in_lookback
            ln_top_b := line.new(n, max_b, n, max_b, color = use_custom_line_color ? custom_line_css : color.new(sesb_css, 0), width = lines_width, style = lines_style)
            ln_bot_b := line.new(n, min_b, n, min_b, color = use_custom_line_color ? custom_line_css : color.new(sesb_css, 0), width = lines_width, style = lines_style)

        if show_ses_eq and in_box_lookback
            float eq_b = (max_b + min_b) / 2.0
            ln_eq_b := line.new(n, eq_b, n, eq_b, color = use_custom_eq_color ? custom_eq_css : color.new(sesb_css, 0), width = 1, style = ses_eq_style)

    if bool(is_sesb) and is_sesb == is_sesb[1]
        if high > max_b
            max_b     := high
            bar_max_b := n
        if low < min_b
            min_b     := low
            bar_min_b := n

        if show_boxes
            box.set_top(bx_b, max_b)
            box.set_rightbottom(bx_b, n, min_b)

        if show_txt
            if label_right
                if show_hi_labels and not na(lbl_b)
                    label.set_xy(lbl_b, n, max_b)
                if show_lo_labels and not na(lbl_lo_b)
                    label.set_xy(lbl_lo_b, n, min_b)
            else
                if show_hi_labels and not na(lbl_b)
                    label.set_xy(lbl_b, int(math.avg(t_b, time)), max_b)
                if show_lo_labels and not na(lbl_lo_b)
                    label.set_xy(lbl_lo_b, int(math.avg(t_b, time)), min_b)

        if show_lines and not na(ln_top_b)
            line.set_x1(ln_top_b, bar_max_b)
            line.set_y1(ln_top_b, max_b)
            line.set_y2(ln_top_b, max_b)
            line.set_x2(ln_top_b, n)
            line.set_x1(ln_bot_b, bar_min_b)
            line.set_y1(ln_bot_b, min_b)
            line.set_y2(ln_bot_b, min_b)
            line.set_x2(ln_bot_b, n)

        if show_ses_eq and not na(ln_eq_b)
            float eq_b = (max_b + min_b) / 2.0
            line.set_y1(ln_eq_b, eq_b)
            line.set_y2(ln_eq_b, eq_b)
            line.set_x2(ln_eq_b, n)

    if is_sesb[1] > is_sesb and show_lines and not na(ln_top_b)
        array.push(all_top_lines, ln_top_b)
        array.push(all_top_levels, max_b)
        array.push(all_top_labels, (label_right) and show_txt and show_hi_labels ? lbl_b : na)
        array.push(all_bot_lines, ln_bot_b)
        array.push(all_bot_levels, min_b)
        array.push(all_bot_labels, (label_right) and show_lo_labels and show_txt ? lbl_lo_b : na)

//-----------------------------------------------------------------------------}
