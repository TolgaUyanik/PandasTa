//@version=6
indicator("RSI Zones - Directional Entry Strict", overlay=false)

// === INPUTS ===
rsiPeriod = input.int(14, title="RSI Period")
buyLow    = input.float(35, title="Buy Zone Low")
buyHigh   = input.float(40, title="Buy Zone High")
sellLow   = input.float(60, title="Sell Zone Low")
sellHigh  = input.float(65, title="Sell Zone High")

// === RSI CALCULATION ===
rsi = ta.rsi(close, rsiPeriod)
plot(rsi, title="RSI", color=color.purple, linewidth=2)

// === STATIC LINES ===
hline(buyLow,  "Buy Low",  color=color.green)
hline(buyHigh, "Buy High", color=color.green)
hline(sellLow,  "Sell Low",  color=color.red)
hline(sellHigh, "Sell High", color=color.red)
hline(50, "Midline", color=color.gray)

// === BOX ARRAYS ===
var buyBoxes = array.new<box>()
var sellBoxes = array.new<box>()

// === BUY ZONE LOGIC ===
inBuyZone = rsi >= buyLow and rsi <= buyHigh
enteredBuyFromAbove = rsi[1] > buyHigh and inBuyZone

if enteredBuyFromAbove
    newBuyBox = box.new(bar_index, buyHigh, bar_index + 1, buyLow, bgcolor = color.new(color.green, 85), border_color = color.green)
    array.push(buyBoxes, newBuyBox)

if inBuyZone and array.size(buyBoxes) > 0
    lastBuyBox = array.get(buyBoxes, array.size(buyBoxes) - 1)
    box.set_right(lastBuyBox, bar_index + 1)

// === SELL ZONE LOGIC ===
inSellZone = rsi >= sellLow and rsi <= sellHigh
enteredSellFromBelow = rsi[1] < sellLow and inSellZone

if enteredSellFromBelow
    newSellBox = box.new(bar_index, sellHigh, bar_index + 1, sellLow, bgcolor = color.new(color.red, 85), border_color = color.red)
    array.push(sellBoxes, newSellBox)

if inSellZone and array.size(sellBoxes) > 0
    lastSellBox = array.get(sellBoxes, array.size(sellBoxes) - 1)
    box.set_right(lastSellBox, bar_index + 1)