//@version=6
indicator("EMA Trend Screener", overlay=false)

// ============================
// SETTINGS
// ============================
emaFastLength = input.int(50, "Fast EMA Length", minval=1)
emaSlowLength = input.int(200, "Slow EMA Length", minval=1)
tf = input.timeframe("D", "Timeframe")
showOnlyPassing = input.bool(true, "Show Only Passing Symbols")

// ============================
// SYMBOL LIST (12 max = 36 calls + 3 background = 39 total)
// Edit these to your preferred symbols
// ============================
s01 = "FX:EURUSD"
s02 = "FX:GBPUSD"
s03 = "FX:USDJPY"
s04 = "FX:AUDUSD"
s05 = "FX:USDCAD"
s06 = "FX:USDCHF"
s07 = "FX:NZDUSD"
s08 = "FX:XAUUSD"
s09 = "FX:US30"
s10 = "FX:SPX500"
s11 = "FX:NAS100"
s12 = "FX:BTCUSD"

// ============================
// PRE-FETCH ALL DATA (top level, every bar)
// ============================
c01 = request.security(s01, tf, close[1], lookahead=barmerge.lookahead_on)
f01 = request.security(s01, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l01 = request.security(s01, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c02 = request.security(s02, tf, close[1], lookahead=barmerge.lookahead_on)
f02 = request.security(s02, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l02 = request.security(s02, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c03 = request.security(s03, tf, close[1], lookahead=barmerge.lookahead_on)
f03 = request.security(s03, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l03 = request.security(s03, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c04 = request.security(s04, tf, close[1], lookahead=barmerge.lookahead_on)
f04 = request.security(s04, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l04 = request.security(s04, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c05 = request.security(s05, tf, close[1], lookahead=barmerge.lookahead_on)
f05 = request.security(s05, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l05 = request.security(s05, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c06 = request.security(s06, tf, close[1], lookahead=barmerge.lookahead_on)
f06 = request.security(s06, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l06 = request.security(s06, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c07 = request.security(s07, tf, close[1], lookahead=barmerge.lookahead_on)
f07 = request.security(s07, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l07 = request.security(s07, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c08 = request.security(s08, tf, close[1], lookahead=barmerge.lookahead_on)
f08 = request.security(s08, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l08 = request.security(s08, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c09 = request.security(s09, tf, close[1], lookahead=barmerge.lookahead_on)
f09 = request.security(s09, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l09 = request.security(s09, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c10 = request.security(s10, tf, close[1], lookahead=barmerge.lookahead_on)
f10 = request.security(s10, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l10 = request.security(s10, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c11 = request.security(s11, tf, close[1], lookahead=barmerge.lookahead_on)
f11 = request.security(s11, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l11 = request.security(s11, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

c12 = request.security(s12, tf, close[1], lookahead=barmerge.lookahead_on)
f12 = request.security(s12, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
l12 = request.security(s12, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

// ============================
// CHECK FUNCTIONS (top level)
// ============================
check(c, f, l) => c > f and c > l

p01 = check(c01, f01, l01)
p02 = check(c02, f02, l02)
p03 = check(c03, f03, l03)
p04 = check(c04, f04, l04)
p05 = check(c05, f05, l05)
p06 = check(c06, f06, l06)
p07 = check(c07, f07, l07)
p08 = check(c08, f08, l08)
p09 = check(c09, f09, l09)
p10 = check(c10, f10, l10)
p11 = check(c11, f11, l11)
p12 = check(c12, f12, l12)

// ============================
// TABLE HELPER (top level)
// ============================
addRow(table t, int row, string symStr, float closeVal, float fastVal, float slowVal, bool pass) =>
    clean = str.replace(symStr, "FX:", "")
    above50 = closeVal > fastVal
    col50 = above50 ? color.green : color.red
    colBoth = pass ? color.green : color.red
    txt50 = above50 ? "YES" : "NO"
    txtBoth = pass ? "YES" : "NO"
    
    int nextRow = row
    if not showOnlyPassing or pass
        table.cell(t, 0, row, clean, text_color=color.white, text_size=size.small)
        table.cell(t, 1, row, str.tostring(closeVal, format.mintick), text_color=color.white, text_size=size.small)
        table.cell(t, 2, row, str.tostring(fastVal, format.mintick), text_color=color.yellow, text_size=size.small)
        table.cell(t, 3, row, str.tostring(slowVal, format.mintick), text_color=color.fuchsia, text_size=size.small)
        table.cell(t, 4, row, txt50, text_color=col50, text_size=size.small)
        table.cell(t, 5, row, txtBoth, text_color=colBoth, text_size=size.small)
        nextRow := row + 1
    nextRow

// ============================
// BUILD TABLE (last bar only)
// ============================
if barstate.islast
    var table t = table.new(position.top_right, 6, 14, 
         bgcolor=color.new(color.black, 10), 
         border_width=1, 
         border_color=color.gray,
         frame_color=color.gray,
         frame_width=1)
    
    table.cell(t, 0, 0, "SYMBOL", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "PRICE", text_color=color.white, text_size=size.small)
    table.cell(t, 2, 0, "50 EMA", text_color=color.white, text_size=size.small)
    table.cell(t, 3, 0, "200 EMA", text_color=color.white, text_size=size.small)
    table.cell(t, 4, 0, "> 50?", text_color=color.white, text_size=size.small)
    table.cell(t, 5, 0, "> BOTH?", text_color=color.white, text_size=size.small)
    
    int r = 1
    r := addRow(t, r, s01, c01, f01, l01, p01)
    r := addRow(t, r, s02, c02, f02, l02, p02)
    r := addRow(t, r, s03, c03, f03, l03, p03)
    r := addRow(t, r, s04, c04, f04, l04, p04)
    r := addRow(t, r, s05, c05, f05, l05, p05)
    r := addRow(t, r, s06, c06, f06, l06, p06)
    r := addRow(t, r, s07, c07, f07, l07, p07)
    r := addRow(t, r, s08, c08, f08, l08, p08)
    r := addRow(t, r, s09, c09, f09, l09, p09)
    r := addRow(t, r, s10, c10, f10, l10, p10)
    r := addRow(t, r, s11, c11, f11, l11, p11)
    r := addRow(t, r, s12, c12, f12, l12, p12)
    
    if r == 1
        table.cell(t, 0, 1, "No symbols above both EMAs", text_color=color.red, text_size=size.normal)
        table.merge_cells(t, 0, 1, 5, 1)

// ============================
// BACKGROUND SIGNAL (current chart)
// ============================
currClose = request.security(syminfo.tickerid, tf, close[1], lookahead=barmerge.lookahead_on)
currFast = request.security(syminfo.tickerid, tf, ta.ema(close, emaFastLength)[1], lookahead=barmerge.lookahead_on)
currSlow = request.security(syminfo.tickerid, tf, ta.ema(close, emaSlowLength)[1], lookahead=barmerge.lookahead_on)

currPass = currClose > currFast and currClose > currSlow
bgcolor(currPass ? color.new(color.green, 90) : na, title="Above Both EMAs")