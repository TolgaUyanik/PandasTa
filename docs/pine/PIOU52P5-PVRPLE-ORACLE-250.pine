
//@version=6
strategy("PVRPLE ORACLE - Clean OB Continuation", overlay=true, initial_capital=10000, currency=currency.USD, pyramiding=0, default_qty_type=strategy.cash, default_qty_value=500, commission_type=strategy.commission.percent, commission_value=0, calc_on_order_fills=true, process_orders_on_close=false, max_boxes_count=50)

// =====================
// INPUT
// =====================
atrPeriod = input.int(14, "ATR Period", minval=1)
bodyAtrMin = input.float(0.20, "Min OB body ATR", step=0.05)
impulseAtrMult = input.float(0.30, "Impulse ATR multiplier", step=0.05)

confirmPoints = input.float(100.0, "Entry confirmation points", step=1.0)
takeProfit = input.float(250.0, "Take Profit points", step=1.0)
stopLoss = input.float(50.0, "Stop Loss points", step=1.0)

zoneLifeBars = input.int(80, "Zone expiry bars", minval=10)
setupLifeBars = input.int(30, "Pending setup expiry bars", minval=1)

showZones = input.bool(true, "Show zones")
showSignals = input.bool(true, "Show signals")

// =====================
// BASE DATA
// =====================
atr = ta.atr(atrPeriod)

candidateBearish = close[3] < open[3]
candidateBullish = close[3] > open[3]

candidateBody = math.abs(close[3] - open[3])
candidateAtr = atr[3]

postHigh = math.max(high, math.max(high[1], high[2]))
postLow = math.min(low, math.min(low[1], low[2]))

bullishImpulse = postHigh - high[3]
bearishImpulse = low[3] - postLow

newBlueOB = candidateBearish and candidateBody >= candidateAtr * bodyAtrMin and bullishImpulse >= candidateAtr * impulseAtrMult
newRedOB = candidateBullish and candidateBody >= candidateAtr * bodyAtrMin and bearishImpulse >= candidateAtr * impulseAtrMult

// =====================
// ACTIVE ZONES
// =====================
var float blueTop = na
var float blueBottom = na
var int blueCreatedBar = na
var bool blueUsed = false
var box blueBox = na

var float redTop = na
var float redBottom = na
var int redCreatedBar = na
var bool redUsed = false
var box redBox = na

if newBlueOB
    blueTop := high[3]
    blueBottom := low[3]
    blueCreatedBar := bar_index
    blueUsed := false

    if not na(blueBox)
        box.delete(blueBox)

    if showZones
        blueBox := box.new(
             left=bar_index[3],
             top=blueTop,
             right=bar_index + zoneLifeBars,
             bottom=blueBottom,
             bgcolor=color.new(color.blue, 88),
             border_color=color.new(color.blue, 20)
         )

if newRedOB
    redTop := high[3]
    redBottom := low[3]
    redCreatedBar := bar_index
    redUsed := false

    if not na(redBox)
        box.delete(redBox)

    if showZones
        redBox := box.new(
             left=bar_index[3],
             top=redTop,
             right=bar_index + zoneLifeBars,
             bottom=redBottom,
             bgcolor=color.new(color.red, 88),
             border_color=color.new(color.red, 20)
         )

if showZones and not na(blueBox)
    box.set_right(blueBox, bar_index + zoneLifeBars)

if showZones and not na(redBox)
    box.set_right(redBox, bar_index + zoneLifeBars)

// =====================
// ZONE EXPIRY / INVALIDATION
// =====================
blueExpired = not na(blueCreatedBar) and bar_index - blueCreatedBar > zoneLifeBars
redExpired = not na(redCreatedBar) and bar_index - redCreatedBar > zoneLifeBars

if not na(blueBottom) and (close < blueBottom or blueExpired)
    blueTop := na
    blueBottom := na
    blueUsed := true

if not na(redTop) and (close > redTop or redExpired)
    redTop := na
    redBottom := na
    redUsed := true

// =====================
// ONE PENDING SETUP ONLY
// armedSide: 1 = long, -1 = short
// =====================
var int armedSide = 0
var float armedTrigger = na
var int armedBar = na

flat = strategy.position_size == 0

touchBlue = not na(blueTop) and not na(blueBottom) and low <= blueTop and high >= blueBottom
touchRed = not na(redTop) and not na(redBottom) and high >= redBottom and low <= redTop

if flat and armedSide == 0
    if touchBlue and not blueUsed
        armedSide := 1
        armedTrigger := blueTop + confirmPoints
        armedBar := bar_index

    else if touchRed and not redUsed
        armedSide := -1
        armedTrigger := redBottom - confirmPoints
        armedBar := bar_index

setupExpired = armedSide != 0 and not na(armedBar) and bar_index - armedBar > setupLifeBars

if setupExpired
    strategy.cancel("LONG")
    strategy.cancel("SHORT")
    armedSide := 0
    armedTrigger := na
    armedBar := na

// =====================
// ENTRY ORDERS
// Stop orders are sent only after the zone touch bar.
// =====================
longOrderActive = flat and armedSide == 1 and bar_index > armedBar and not na(armedTrigger)
shortOrderActive = flat and armedSide == -1 and bar_index > armedBar and not na(armedTrigger)

if longOrderActive
    strategy.entry("LONG", strategy.long, stop=armedTrigger, comment="PVRPLE ORACLE LONG")

if shortOrderActive
    strategy.entry("SHORT", strategy.short, stop=armedTrigger, comment="PVRPLE ORACLE SHORT")

// =====================
// DETECT REAL EXECUTION
// =====================
longOpened = strategy.position_size > 0 and strategy.position_size[1] <= 0
shortOpened = strategy.position_size < 0 and strategy.position_size[1] >= 0

if longOpened
    blueUsed := true
    armedSide := 0
    armedTrigger := na
    armedBar := na
    strategy.cancel("SHORT")

if shortOpened
    redUsed := true
    armedSide := 0
    armedTrigger := na
    armedBar := na
    strategy.cancel("LONG")

// =====================
// TP / SL
// =====================
if strategy.position_size > 0
    longEntry = strategy.position_avg_price
    strategy.exit(
         "LONG EXIT",
         from_entry="LONG",
         stop=longEntry - stopLoss,
         limit=longEntry + takeProfit
     )

if strategy.position_size < 0
    shortEntry = strategy.position_avg_price
    strategy.exit(
         "SHORT EXIT",
         from_entry="SHORT",
         stop=shortEntry + stopLoss,
         limit=shortEntry - takeProfit
     )

// =====================
// VISUAL
// =====================
plot(armedSide == 1 ? armedTrigger : na, "Long trigger", color=color.new(color.green, 25), style=plot.style_linebr)
plot(armedSide == -1 ? armedTrigger : na, "Short trigger", color=color.new(color.red, 25), style=plot.style_linebr)

plotshape(showSignals and newBlueOB, title="Blue OB", text="B-OB", style=shape.circle, location=location.belowbar, color=color.blue, textcolor=color.white, size=size.tiny)
plotshape(showSignals and newRedOB, title="Red OB", text="R-OB", style=shape.circle, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)

plotshape(showSignals and longOpened, title="LONG", text="LONG", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(showSignals and shortOpened, title="SHORT", text="SHORT", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
