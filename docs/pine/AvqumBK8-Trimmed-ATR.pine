//@version=6
indicator("Trimmed ATR", overlay=false, shorttitle="T-ATR")

// === INPUTS ===
length      = input.int(14, minval=2, title="ATR Length")
trimPercent = input.float(10.0, minval=0.0, maxval=49.0, step=0.1, title="Trim % (each side)")

// === TRUE RANGE CALCULATION ===
tr = ta.tr(true)
atr = ta.atr(length)

// === ARRAY FOR SLIDING WINDOW ===
var trWindow = array.new_float()

// Add current TR to array
array.push(trWindow, tr)

// Keep array size equal to length
if array.size(trWindow) > length
    array.shift(trWindow)

// === TRIMMED MEAN CALCULATION ===
float trimmedATR = na
if array.size(trWindow) == length
    sorted = array.copy(trWindow)
    array.sort(sorted, order.ascending)

    trimCount = math.floor(length * trimPercent / 100)
    startIndex = trimCount
    endIndex   = length - trimCount

    sum = 0.0
    for i = startIndex to endIndex - 1
        sum += array.get(sorted, i)

    trimmedATR := sum / (endIndex - startIndex)

// === PLOT ===
plot(trimmedATR, title="Trimmed ATR", color=color.orange, linewidth=2)
plot(atr, title = "Average True Range", color = color.blue)

