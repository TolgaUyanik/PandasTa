//@version=6
library("PremiumDiscountLibrary")

// @function Vérifie si le prix est en zone premium ou discount
// @param currentTime L'heure actuelle (timestamp)
// @param price Le prix actuel
// @param trend La tendance ("bullish" ou "bearish")
// @param tz Le fuseau horaire pour calculer les sessions (par défaut : "GMT+1")
// @returns true si le prix est dans la zone correcte, sinon false
export isInZone(int currentTime, float price, string trend, string tz) =>
    // Définir les horaires des sessions
    londonStart = timestamp(tz, year, month, dayofmonth, 8, 0)
    londonEnd = timestamp(tz, year, month, dayofmonth, 11, 0)
    nyStart = timestamp(tz, year, month, dayofmonth, 13, 0)
    nyEnd = timestamp(tz, year, month, dayofmonth, 16, 0)
    
    // Définir les lignes de référence pour les sessions
    midnightOpen = request.security("SPX", "D", open, lookahead=barmerge.lookahead_on)
    nyOpen = request.security("SPX", "1D", request.security("SPX", "D", open[0]))
    
    // Déterminer la session en cours
    isLondon = (currentTime >= londonStart and currentTime <= londonEnd)
    isNewYork = (currentTime >= nyStart and currentTime <= nyEnd)
    
    // Ligne de référence en fonction de la session
    var float sessionLine = na
    if isLondon
        sessionLine := midnightOpen
    if isNewYork
        sessionLine := nyOpen

    // Résultat en fonction de la tendance
    var bool result = false
    if trend == "bullish" and not na(sessionLine)
        result := price < sessionLine
    if trend == "bearish" and not na(sessionLine)
        result := price > sessionLine
    result