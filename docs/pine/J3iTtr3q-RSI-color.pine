//@version=6
indicator("RSI color", overlay=true)

// === INPUTS ===
rsiLength = input.int(14, title="RSI Length")
upperLevel = input.int(50, title="Upper Level")
lowerLevel = input.int(50, title="Lower Level")

// === RSI CALCULATION ===
rsiValue = ta.rsi(close, rsiLength)

// === BACKGROUND COLOR LOGIC ===
bgColor = rsiValue > upperLevel ? color.new(color.green, 85) :
          rsiValue < lowerLevel ? color.new(color.red, 85) :
          color.new(color.yellow, 85)

// === APPLY BACKGROUND ===
bgcolor(bgColor)



// === LEVEL LINES ===
hline(upperLevel, "Upper Level", color=color.green)
hline(lowerLevel, "Lower Level", color=color.red)
