//@version=6
indicator("RSI Smart Divergence [josseliani]", overlay=false, max_lines_count=300, max_labels_count=300)

//====================================================
// INPUTS
//====================================================
groupRsi = "RSI Settings"
rsiLen = input.int(14, "RSI Length", minval=1, group=groupRsi)
src = input.source(close, "Source", group=groupRsi)
overbought = input.float(70.0, "Overbought Level", group=groupRsi)
oversold = input.float(30.0, "Oversold Level", group=groupRsi)

groupDiv = "Smart Divergence Settings"
showDivergence = input.bool(true, "Show smart divergences", group=groupDiv)
pivotLeft = input.int(3, "RSI Pivot Left", minval=1, group=groupDiv)
pivotRight = input.int(3, "RSI Pivot Right", minval=1, group=groupDiv)
maxBarsBetweenPoints = input.int(80, "Max bars between RSI points", minval=5, group=groupDiv)
showOscDivLines = input.bool(true, "Draw divergence line on RSI", group=groupDiv)
showPriceDivLines = input.bool(true, "Draw divergence line on price chart", group=groupDiv)
maxDivLines = input.int(50, "Max divergence lines", minval=1, maxval=150, group=groupDiv)

groupView = "Display"
showLevels = input.bool(true, "Show RSI levels", group=groupView)
showBgZones = input.bool(false, "Color overbought/oversold background", group=groupView)

// Internal fixed price search radius
priceSearchAroundPoint = 3

//====================================================
// RSI
//====================================================
rsi = ta.rsi(src, rsiLen)

//====================================================
// FUNCTIONS
//====================================================
f_priceLowNearPivot(int centerOffset, int radius) =>
    int startOffset = math.max(centerOffset - radius, 0)
    int endOffset = centerOffset + radius
    float bestLow = low[startOffset]
    int bestBar = bar_index - startOffset
    for i = startOffset to endOffset
        if low[i] < bestLow
            bestLow := low[i]
            bestBar := bar_index - i
    [bestLow, bestBar]

f_priceHighNearPivot(int centerOffset, int radius) =>
    int startOffset = math.max(centerOffset - radius, 0)
    int endOffset = centerOffset + radius
    float bestHigh = high[startOffset]
    int bestBar = bar_index - startOffset
    for i = startOffset to endOffset
        if high[i] > bestHigh
            bestHigh := high[i]
            bestBar := bar_index - i
    [bestHigh, bestBar]

f_addLine(line[] arr, line ln, int maxCount) =>
    array.push(arr, ln)
    if array.size(arr) > maxCount
        oldLine = array.shift(arr)
        line.delete(oldLine)

//====================================================
// SMART DIVERGENCE LOGIC
//====================================================
var float prevBullRsi = na
var int prevBullRsiBar = na
var float prevBullPriceLow = na
var int prevBullPriceLowBar = na

var float prevBearRsi = na
var int prevBearRsiBar = na
var float prevBearPriceHigh = na
var int prevBearPriceHighBar = na

var line[] oscLines = array.new_line()
var line[] priceLines = array.new_line()

bullDiv = false
bearDiv = false

var float bullSignalY = na
var float bearSignalY = na

bullSignalY := na
bearSignalY := na

rsiPivotLow = ta.pivotlow(rsi, pivotLeft, pivotRight)
rsiPivotHigh = ta.pivothigh(rsi, pivotLeft, pivotRight)

//====================================================
// BULLISH SMART DIVERGENCE
//====================================================
if showDivergence and barstate.isconfirmed and not na(rsiPivotLow)
    currBullRsi = rsi[pivotRight]
    currBullBar = bar_index - pivotRight
    [currPriceLow, currPriceLowBar] = f_priceLowNearPivot(pivotRight, priceSearchAroundPoint)
    validBullZone = currBullRsi < oversold
    validPrevBull = not na(prevBullRsi) and not na(prevBullRsiBar) and not na(prevBullPriceLow) and not na(prevBullPriceLowBar)
    barsBetweenBull = validPrevBull ? currBullBar - prevBullRsiBar : na
    rsiHigherLow = validPrevBull and currBullRsi > prevBullRsi
    priceLowerLow = validPrevBull and currPriceLow < prevBullPriceLow
    inBullWindow = validPrevBull and barsBetweenBull > 0 and barsBetweenBull <= maxBarsBetweenPoints
    bullDiv := validBullZone and rsiHigherLow and priceLowerLow and inBullWindow
    bullSignalY := bullDiv ? rsi : na
    if bullDiv and showOscDivLines
        oscLine = line.new(prevBullRsiBar, prevBullRsi, currBullBar, currBullRsi, xloc=xloc.bar_index, extend=extend.none, color=color.lime, style=line.style_dashed, width=1)
        f_addLine(oscLines, oscLine, maxDivLines)
    if bullDiv and showPriceDivLines
        priceLine = line.new(prevBullPriceLowBar, prevBullPriceLow, currPriceLowBar, currPriceLow, xloc=xloc.bar_index, extend=extend.none, color=color.lime, style=line.style_dashed, width=1, force_overlay=true)
        f_addLine(priceLines, priceLine, maxDivLines)
    if validBullZone
        prevBullRsi := currBullRsi
        prevBullRsiBar := currBullBar
        prevBullPriceLow := currPriceLow
        prevBullPriceLowBar := currPriceLowBar

//====================================================
// BEARISH SMART DIVERGENCE
//====================================================
if showDivergence and barstate.isconfirmed and not na(rsiPivotHigh)
    currBearRsi = rsi[pivotRight]
    currBearBar = bar_index - pivotRight
    [currPriceHigh, currPriceHighBar] = f_priceHighNearPivot(pivotRight, priceSearchAroundPoint)
    validBearZone = currBearRsi > overbought
    validPrevBear = not na(prevBearRsi) and not na(prevBearRsiBar) and not na(prevBearPriceHigh) and not na(prevBearPriceHighBar)
    barsBetweenBear = validPrevBear ? currBearBar - prevBearRsiBar : na
    rsiLowerHigh = validPrevBear and currBearRsi < prevBearRsi
    priceHigherHigh = validPrevBear and currPriceHigh > prevBearPriceHigh
    inBearWindow = validPrevBear and barsBetweenBear > 0 and barsBetweenBear <= maxBarsBetweenPoints
    bearDiv := validBearZone and rsiLowerHigh and priceHigherHigh and inBearWindow
    bearSignalY := bearDiv ? rsi : na
    if bearDiv and showOscDivLines
        oscLine = line.new(prevBearRsiBar, prevBearRsi, currBearBar, currBearRsi, xloc=xloc.bar_index, extend=extend.none, color=color.red, style=line.style_dashed, width=1)
        f_addLine(oscLines, oscLine, maxDivLines)
    if bearDiv and showPriceDivLines
        priceLine = line.new(prevBearPriceHighBar, prevBearPriceHigh, currPriceHighBar, currPriceHigh, xloc=xloc.bar_index, extend=extend.none, color=color.red, style=line.style_dashed, width=1, force_overlay=true)
        f_addLine(priceLines, priceLine, maxDivLines)
    if validBearZone
        prevBearRsi := currBearRsi
        prevBearRsiBar := currBearBar
        prevBearPriceHigh := currPriceHigh
        prevBearPriceHighBar := currPriceHighBar

//====================================================
// PLOTS
//====================================================
plot(rsi, "RSI", color=color.aqua, linewidth=2)

plot(showLevels ? overbought : na, "Overbought", color=color.new(color.red, 40), linewidth=1)
plot(showLevels ? 50 : na, "Middle", color=color.new(color.gray, 70), linewidth=1)
plot(showLevels ? oversold : na, "Oversold", color=color.new(color.lime, 40), linewidth=1)

bgcolor(showBgZones and rsi > overbought ? color.new(color.red, 92) : na)
bgcolor(showBgZones and rsi < oversold ? color.new(color.green, 92) : na)

plotshape(showDivergence and bullDiv ? bullSignalY : na, title="Smart Bullish RSI Divergence", style=shape.triangleup, location=location.absolute, color=color.lime, size=size.tiny)
plotshape(showDivergence and bearDiv ? bearSignalY : na, title="Smart Bearish RSI Divergence", style=shape.triangledown, location=location.absolute, color=color.red, size=size.tiny)

//====================================================
// ALERTS
//====================================================
alertcondition(bullDiv, title="Smart Bullish RSI Divergence", message="Smart Bullish RSI Divergence on {{ticker}} {{interval}}")
alertcondition(bearDiv, title="Smart Bearish RSI Divergence", message="Smart Bearish RSI Divergence on {{ticker}} {{interval}}")