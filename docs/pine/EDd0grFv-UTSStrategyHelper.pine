//@version=6

// @description Library containing a collection of helper functions like trailing stop calculation and position size determination.
library("UTSStrategyHelper")

// @function Calculates the stop loss price using a distance determined by ATR multiplied by a factor. Example for Long trade SL: PRICE - (ATR * factor).
// @param atr (float): The value of the atr.
// @param positionSize (float): The factor value to be multiplied by ATR value. Default is usualy 1.5.
// @param priceSource (float): The current price.
// @param isLong (bool): The current trade direction.
// @returns (bool): A boolean value.
export stopLossPrice(float sig, float atr, float factor, bool isLong) =>
    distance = atr * factor
    value = isLong ? sig - distance : sig + distance
    value

// @function Calculates the take profit price using a distance determined by ATR multiplied by a factor. Example for Long trade TP: PRICE + (ATR * factor). When take profit price is reached usually 50 % of the position is closed and the other 50 % get a trailing stop assigned.
// @param atr (float): The value of the atr.
// @param positionSize (float): The factor value to be multiplied by ATR value. Default is usualy 1.0.
// @param priceSource (float): The current price.
// @param isLong (bool): The current trade direction.
// @returns (bool): A boolean value.
export takeProfitPrice(float sig, float atr, float factor, bool isLong) =>
    distance = atr * factor
    value = isLong ? sig + distance : sig - distance
    value

// @function Calculates a trailing stop price using a distance determined by ATR multiplied by a factor. It takes an initial price and follows the price closely if it changes in a favourable way.
// @param initialStopPrice (float): The initial stop price which, for consistency also should be ATR * factor behind price: e.g. Long trade: PRICE - (ATR * factor)
// @param atr (float): The value of the atr. Ideally the ATR value at trade open is taken and used for subsequent calculations.
// @param positionSize (float): The factor value to be multiplied by ATR value. Default is usualy 1.5.
// @param priceSource (float): The current price.
// @param isLong (bool): The current trade direction.
// @returns (bool): A boolean value.
export trailingStopPrice(float initialStopPrice, float atr, float factor, float priceSource, bool isLong) =>
    stopDistance = atr * factor
    value = isLong ? math.max(initialStopPrice, priceSource - stopDistance) : math.min(initialStopPrice, priceSource + stopDistance)
    value

// @function Determines if the strategy's position size has grown since the last bar.
// @param positionSize (float): The size of the position.
// @returns (bool): A boolean value.
export hasGreaterPositionSize(float positionSize) =>
    positionSize > positionSize[1]

// @function Determines if the strategy's position size has decreased since the last bar.
// @param positionSize (float): The size of the position.
// @returns (bool): A boolean value.
export hasSmallerPositionSize(float positionSize) =>
    positionSize < positionSize[1]

// @function Determines if the strategy's position size has changed since the last bar.
// @param positionSize (float): The size of the position.
// @returns (bool): A boolean value.
export hasUnchangedPositionSize(float positionSize) =>
    positionSize == positionSize[1]

// @function Determines if the strategy has an open long position.
// @param positionSize (float): The size of the position.
// @returns (bool): A boolean value.
export hasLongPosition(float positionSize) =>
    positionSize > 0

// @function Determines if the strategy has an open short position.
// @param positionSize (float): The size of the position.
// @returns (bool): A boolean value.
export hasShortPosition(float positionSize) =>
    positionSize < 0

// @function Determines if the strategy has any open position, regardless of short or long.
// @param positionSize (float): The size of the position.
// @returns (bool): A boolean value.
export hasAnyPosition(float positionSize) =>
    positionSize != 0

// @function Determines if the given argument contains a valid value (means not 'na').
// @param value (float): The actual value.
// @returns (bool): A boolean value.
export hasSignal(float value) =>
    na(value) == false
