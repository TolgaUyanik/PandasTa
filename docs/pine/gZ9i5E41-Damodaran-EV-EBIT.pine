// Damodaran EV/EBIT library with Developed Market mode using US base data as proxy,
// and Emerging Market mode using the January 2026 Emerging Markets table.
// Updated mapping includes full TradingView sector/industry coverage and proxy fills for non-bank NA industries.
// Band outputs use log-space percentile modeling with industry sigma overrides and sector fallback.

//@version=6
library("Damodaran_EV_EBIT", overlay=true)

export const float PCTL_LOW  = 0.3
export const float PCTL_HIGH = 0.7

// ------------------------------------------------------------------------------------------------
// Z-scores for common percentiles (hardcoded)
// ------------------------------------------------------------------------------------------------
f_z(float p) =>
    p == 0.10 ? -1.281551565545 :
      p == 0.20 ? -0.841621233573 :
      p == 0.25 ? -0.674489750196 :
      p == 0.30 ? -0.524400512708 :
      p == 0.70 ?  0.524400512708 :
      p == 0.75 ?  0.674489750196 :
      p == 0.80 ?  0.841621233573 :
      p == 0.90 ?  1.281551565545 : na

// ------------------------------------------------------------------------------------------------
// Sector sigma (dispersion in log-space).
// You can tune sigma later; usually you just change percentiles first.
// ------------------------------------------------------------------------------------------------
export sector_sigma(string sector) =>
    switch
        sector == "Utilities" => 0.25
        sector == "Finance" => 0.30
        sector == "Investment Trusts/Mutual Funds" => 0.30
        sector == "Technology Services" => 0.65
        sector == "Electronic Technology" => 0.65
        sector == "Health Technology" => 0.45
        sector == "Health Services" => 0.40
        sector == "Retail Trade" => 0.40
        sector == "Consumer Non-Durables" => 0.40
        sector == "Consumer Durables" => 0.45
        sector == "Consumer Services" => 0.45
        sector == "Producer Manufacturing" => 0.45
        sector == "Industrial Services" => 0.45
        sector == "Commercial Services" => 0.45
        sector == "Distribution Services" => 0.45
        sector == "Transportation" => 0.50
        sector == "Communications" => 0.50
        sector == "Process Industries" => 0.50
        sector == "Energy Minerals" => 0.55
        sector == "Non-Energy Minerals" => 0.55
        sector == "Miscellaneous" => 0.50
        => 0.50

// ------------------------------------------------------------------------------------------------
// Industry sigma (dispersion in log-space).
// Heuristic overrides for industries that tend to trade with materially tighter/wider
// valuation spreads than their broad sector bucket. Falls back to sector sigma.
// ------------------------------------------------------------------------------------------------
f_industry_sigma(string industry, string sector) =>
    _sig = sector_sigma(sector)

    switch
        // High dispersion growth / tech
        industry == "Internet Software/Services" => 0.85
        industry == "Packaged Software" => 0.75
        industry == "Semiconductors" => 0.75
        industry == "Electronic Production Equipment" => 0.70
        industry == "Telecommunications Equipment" => 0.70
        industry == "Computer Communications" => 0.70
        industry == "Biotechnology" => 0.90
        industry == "Medical Specialties" => 0.55
        industry == "Alternative Power Generation" => 0.70

        // Lower dispersion mature tech / defensive
        industry == "Information Technology Services" => 0.55
        industry == "Data Processing Services" => 0.50
        industry == "Pharmaceuticals: Major" => 0.35
        industry == "Pharmaceuticals: Other" => 0.40
        industry == "Pharmaceuticals: Generic" => 0.35
        industry == "Drug Manufacturers: Specialty & Generic" => 0.40
        industry == "Managed Health Care" => 0.30
        industry == "Medical/Nursing Services" => 0.30
        industry == "Healthcare Facilities" => 0.35
        industry == "Hospital/Nursing Management" => 0.35
        industry == "Services to the Health Industry" => 0.35
        industry == "Household/Personal Care" => 0.30
        industry == "Food: Major Diversified" => 0.30
        industry == "Food: Specialty/Candy" => 0.30
        industry == "Food: Meat/Fish/Dairy" => 0.30
        industry == "Food Retail" => 0.30
        industry == "Beverages: Non-Alcoholic" => 0.30
        industry == "Tobacco" => 0.30
        industry == "Electric Utilities" => 0.22
        industry == "Gas Distributors" => 0.22
        industry == "Water Utilities" => 0.20
        industry == "Major Telecommunications" => 0.35
        industry == "Specialty Telecommunications" => 0.40
        industry == "Wireless Telecommunications" => 0.40

        // Commodity / cyclical industries
        industry == "Coal" => 0.70
        industry == "Integrated Oil" => 0.45
        industry == "Oil Refining/Marketing" => 0.45
        industry == "Oil and Gas Production" => 0.70
        industry == "Oil & Gas Production" => 0.70
        industry == "Contract Drilling" => 0.65
        industry == "Oilfield Services/Equipment" => 0.65
        industry == "Precious Metals" => 0.70
        industry == "Other Metals/Minerals" => 0.65
        industry == "Aluminum" => 0.60
        industry == "Steel" => 0.60
        industry == "Chemicals: Agricultural" => 0.55
        industry == "Chemicals: Major Diversified" => 0.45
        industry == "Chemicals: Specialty" => 0.45
        industry == "Agricultural Commodities/Milling" => 0.55
        industry == "Forest Products" => 0.55
        industry == "Pulp and Paper" => 0.55
        industry == "Pulp & Paper" => 0.55
        industry == "Construction Materials" => 0.55
        industry == "Marine Shipping" => 0.60
        industry == "Airlines" => 0.60
        industry == "Trucking" => 0.55
        industry == "Railroads" => 0.40

        // Financial / property
        industry == "Real Estate Development" => 0.60
        industry == "Real Estate Services" => 0.50
        industry == "Real Estate Investment Trusts" => 0.35
        industry == "Investment Managers" => 0.40
        industry == "Investment Trusts/Mutual Funds" => 0.35
        industry == "Finance/Rental/Leasing" => 0.55
        industry == "Finance: Consumer Services" => 0.55
        industry == "Property/Casualty Insurance" => 0.30
        industry == "Multi-Line Insurance" => 0.30
        industry == "Life/Health Insurance" => 0.30
        industry == "Specialty Insurance" => 0.35
        industry == "Insurance Brokers/Services" => 0.30

        // Consumer / retail
        industry == "Internet Retail" => 0.60
        industry == "Department Stores" => 0.50
        industry == "Discount Stores" => 0.40
        industry == "Specialty Stores" => 0.50
        industry == "Apparel/Footwear Retail" => 0.50
        industry == "Electronics/Appliance Stores" => 0.50
        industry == "Home Improvement Chains" => 0.35
        industry == "Restaurants" => 0.45
        industry == "Hotels/Resorts/Cruiselines" => 0.55
        industry == "Hotels/Resorts/Cruise lines" => 0.55
        industry == "Casinos/Gaming" => 0.60

        => _sig

