// ------------------------------------------------------------------------------------------------
// Default routing keeps existing two-arg API usable on other scripts:
// - Developed Market country or known developed-market prefixes -> DM mode
// - otherwise                                                  -> EM mode
// ------------------------------------------------------------------------------------------------
f_is_dm_country(string _country) =>
    _country == "AU" or
      _country == "AT" or
      _country == "BE" or
      _country == "CA" or
      _country == "DK" or
      _country == "FI" or
      _country == "FR" or
      _country == "DE" or
      _country == "HK" or
      _country == "IE" or
      _country == "IL" or
      _country == "IT" or
      _country == "JP" or
      _country == "NL" or
      _country == "NZ" or
      _country == "NO" or
      _country == "PT" or
      _country == "SG" or
      _country == "ES" or
      _country == "SE" or
      _country == "CH" or
      _country == "GB" or
      _country == "US"

f_is_dm_prefix(string _prefix) =>
    _prefix == "AMEX" or
      _prefix == "ARCA" or
      _prefix == "ASX" or
      _prefix == "BATS" or
      _prefix == "BER" or
      _prefix == "BME" or
      _prefix == "BX" or
      _prefix == "CBOE" or
      _prefix == "CBOT" or
      _prefix == "CBOT_MINI" or
      _prefix == "CME" or
      _prefix == "CME_MINI" or
      _prefix == "COMEX" or
      _prefix == "CSE" or
      _prefix == "DJ" or
      _prefix == "DUS" or
      _prefix == "EURONEXT" or
      _prefix == "FSE" or
      _prefix == "FWB" or
      _prefix == "HAM" or
      _prefix == "HAN" or
      _prefix == "HKEX" or
      _prefix == "ICEUS" or
      _prefix == "LSE" or
      _prefix == "LSIN" or
      _prefix == "MIL" or
      _prefix == "MUN" or
      _prefix == "NASDAQ" or
      _prefix == "NEO" or
      _prefix == "NGM" or
      _prefix == "NZX" or
      _prefix == "NYMEX" or
      _prefix == "NYSE" or
      _prefix == "OMXCOP" or
      _prefix == "OMXHEX" or
      _prefix == "OMXSTO" or
      _prefix == "OMXTSE" or
      _prefix == "OSL" or
      _prefix == "OTC" or
      _prefix == "OTCBB" or
      _prefix == "SGX" or
      _prefix == "SIX" or
      _prefix == "SP" or
      _prefix == "SWB" or
      _prefix == "TASE" or
      _prefix == "TSE" or
      _prefix == "TSX" or
      _prefix == "TSXV" or
      _prefix == "XETR"

f_default_market() =>
    _prefix = syminfo.prefix
    (f_is_dm_country(syminfo.country) or f_is_dm_prefix(_prefix)) ? "DM" : "EM"

f_market_mode(string _market) =>
    _market == "EM" ? "EM" : "DM"

export ev_ebit_base_market(string industry, string market) =>
    _market_mode = f_market_mode(market)
    _market_mode == "DM" ? ev_ebit_base(industry) : f_ev_ebit_base_em(industry)

// ------------------------------------------------------------------------------------------------
// Band construction in log-space:
// low  = base * exp(z_low  * sigma)
// high = base * exp(z_high * sigma)
// ------------------------------------------------------------------------------------------------
export ev_ebit_band_market(string industry, string sector, string market) =>
    base = ev_ebit_base_market(industry, market)
    sig  = f_industry_sigma(industry, sector)
    zL   = f_z(PCTL_LOW)
    zH   = f_z(PCTL_HIGH)

    _low  = (not na(base) and base > 0 and not na(zL)) ? base * math.exp(zL * sig) : na
    _high = (not na(base) and base > 0 and not na(zH)) ? base * math.exp(zH * sig) : na

    [_low, _high, base, sig]

export ev_ebit_band(string industry, string sector) =>
    ev_ebit_band_market(industry, sector, f_default_market())

// Convenience wrappers
export ev_ebit_low_market(string industry, string sector, string market) =>
    [lo, _, _, _] = ev_ebit_band_market(industry, sector, market)
    lo

export ev_ebit_low(string industry, string sector) =>
    ev_ebit_low_market(industry, sector, f_default_market())

export ev_ebit_high_market(string industry, string sector, string market) =>
    [_, hi, _, _] = ev_ebit_band_market(industry, sector, market)
    hi

export ev_ebit_high(string industry, string sector) =>
    ev_ebit_high_market(industry, sector, f_default_market())
