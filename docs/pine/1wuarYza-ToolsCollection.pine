//@version=6

// @description Helper functions for collection (map/array) type operations
library('ToolsCollection', overlay = false)

// @function Returns Map key's value with default return value option
// @param container Map object
// @param key Key to be checked
// @param default Default return value when key not found. Default: false
// @returns bool
export get(map<string, bool> container, string key, bool default = false) =>
    if container.contains(key)
        container.get(key)
    else
        default

// @function Returns Map key's value with default return value option
// @param container Map object
// @param key Key to be checked
// @param default Default return value when key not found. Default: -1
// @returns int
export get(map<string, int> container, string key, int default = -1) =>
    if container.contains(key)
        container.get(key)
    else
        default

// @function Returns Map key's value with default return value option
// @param container Map object
// @param key Key to be checked
// @param default Default return value when key not found. Default: -1
// @returns float
export get(map<string, float> container, string key, float default = -1) =>
    if container.contains(key)
        container.get(key)
    else
        default

// @function Returns Map key's value with default return value option
// @param container Map object
// @param key Key to be checked
// @param default Default return value when key not found. Default: ''
// @returns string
export get(map<string, string> container, string key, string default = '') =>
    if container.contains(key)
        container.get(key)
    else
        default

// @function Returns Map key's value with default return value option
// @param container Map object
// @param key Key to be checked
// @param default Default return value when key not found. Default: color.white
// @returns color
export get(map<string, color> container, string key, color default = color.white) =>
    if container.contains(key)
        container.get(key)
    else
        default

