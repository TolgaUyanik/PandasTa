// @function Returns Array key's value with default return value option
// @param container Array<bool> object
// @param key Key to be checked
// @param default Default return value when key not found. Default: false
// @returns bool
export get(array<bool> container, int key, bool default = false) =>
    if array.size(container) >= key + 1
        container.get(key)
    else
        default

// @function Returns Array key's value with default return value option
// @param container Array<bool> object
// @param key Key to be checked
// @param default Default return value when key not found. Default: -1
// @returns bool
export get(array<int> container, int key, int default = -1) =>
    if array.size(container) >= key + 1
        container.get(key)
    else
        default

