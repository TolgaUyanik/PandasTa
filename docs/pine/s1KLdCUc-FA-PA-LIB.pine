// ---> BEGIN TA FUNCTIONS {

// @function Gets the current candle's body size (in POINTS, divide by 10 to get pips)
// @returns The current candle's body size in POINTS
export getBodySize() => 
    float _return = math.abs(close - open) / syminfo.mintick


// @function Gets the current candle's top wick size (in POINTS, divide by 10 to get pips)
// @returns The current candle's top wick size in POINTS
export getTopWickSize() => 
    float _return = math.abs(high - (close > open ? close : open)) / syminfo.mintick


// @function Gets the current candle's top wick size (in POINTS, divide by 10 to get pips)
// @returns  Percent of total candle width that is occupied by the upper wick
export getTopWickPercent() => 
    float _return = ((math.abs(high - (close > open ? close : open)) / syminfo.mintick) / (math.abs(high-low))) * 100


// @function Gets the current candle's bottom wick size (in POINTS, divide by 10 to get pips)
// @returns The current candle's bottom wick size in POINTS
export getBottomWickSize() => 
    float _return = math.abs((close < open ? close : open) - low) / syminfo.mintick


// @function Gets the current candle's bottom wick size (in POINTS, divide by 10 to get pips)
// @returns  Percent of total candle width that is occupied by the lower wick
export getBottomWickPercent() => 
    float _return = ((math.abs((close < open ? close : open) - low) / syminfo.mintick) / (math.abs(high-low))) * 100 


// @function Gets the current candle's midpoint wick to wick
// @returns The current candle's mid point
export getBarMidPoint() => 
    float _return = (math.max(high,low) + math.min(high,low)) / 2


// @function Gets the current candle's body size as a percentage of its entire size including its wicks
// @returns The current candle's body size percentage (00.00)
export getBodyPercent() => 
    float _return = math.abs(open - close) / math.abs(high - low)


// @function Calculates a bullish fibonacci value
// @param priceLow The lowest price point
// @param priceHigh The highest price point
// @param fibRatio The fibonacci % ratio to calculate
// @returns The fibonacci value of the given ratio between the two price points
export bullFib(float priceLow, float priceHigh, float fibRatio = 0.382) => 
    float _return = (priceLow - priceHigh) * fibRatio + priceHigh

// @function Calculates a bearish fibonacci value
// @param priceLow The lowest price point
// @param priceHigh The highest price point
// @param fibRatio The fibonacci % ratio to calculate
// @returns The fibonacci value of the given ratio between the two price points
export bearFib(float priceLow, float priceHigh, float fibRatio = 0.382) => 
    float _return = (priceHigh - priceLow) * fibRatio + priceLow


// } <--- END TA FUNCTIONS





// ---> BEGIN CANDLE SETUP DETECTION {

// @function Checks if the current bar is a Bear Bar 
// @returns A boolean - true if the current bar is bear candle
export isBr () => 
    bool _return = close < open                      // Bear Candle

// @function Checks if the current bar is a Bull Bar 
// @returns A boolean - true if the current bar is Bull candle
export isBl () => 
    bool _return = close > open                      // Bull candle

// @function Checks if the current bar is a Trend Bar. Candle that its body size is greater than 50% of entire candle size
// @returns A boolean - true if the current bar is Trend candle
export isTrendBar () =>
    bool _return = getBodyPercent() > 0.50

// @function Checks if the current bar is a Bull Trend Bar. Bullish candle that its body size is greater than 50% of entire candle size
// @returns A boolean - true if the current bar is Bull Trend candle
export isBlTrendBar () =>
    bool _return = isBl() and (getBodyPercent() >= 0.5 )

// @function Checks if the current bar is a Bull Trend Bar. Bullish candle that its body size is greater than 50% of entire candle size
// @returns A boolean - true if the current bar is Bull Trend candle
export isBrTrendBar () =>
    bool _return = isBr() and (getBodyPercent() >= 0.5 )

// @function Checks if the current bar is a Bull Reversal Bar. Bullish candle that closes on upper half of candle body
// @returns A boolean - true if the current bar is Bull Reversal candle
export isBlRevB () =>
    bool _return = isBl() and close > getBarMidPoint()

// @function Checks if the current bar is a Bear Reversal Bar. BulBearish candle that closes on lower half of candle body
// @returns A boolean - true if the current bar is Bear Reversal candle
export isBrRevB () =>
    bool _return = isBr() and close < getBarMidPoint()

// @function Checks if the current bar is a doji candle based on the given parameters
// @param wickSize (default=2) The maximum top wick size compared to the bottom (and vice versa)
// @param bodySize (default=0.05) The maximum body size as a percentage compared to the entire candle size
// @returns A boolean - true if the current bar matches the requirements of a doji candle
export isDoji(float wickSize = 2.0, float bodySize = 0.05) =>
    bool _return = getTopWickSize() <= getBottomWickSize() * wickSize and getBottomWickSize() <= getTopWickSize() * wickSize and getBodyPercent() <= bodySize 
         or (math.round_to_mintick(close) == math.round_to_mintick(open) )


// @function Checks if the current bar is a hammer candle based on the given parameters
// @param fib (default=0.382) The fib to base candle body on
// @param colorMatch (default=true) Does the candle need to be green? (true/false)
// @returns A boolean - true if the current bar matches the requirements of a hammer candle
export isHammer(float fib = 0.382, bool colorMatch = true) =>
    bullFib = bullFib(low, high, fib)
    lowestBody = close < open ? close : open
    bool _return = lowestBody >= bullFib and (not colorMatch or close > open) and not isDoji(2.0,0.05) and getTopWickSize() <= getBodySize()


// @function Checks if the current bar is a shooting star candle based on the given parameters
// @param fib (default=0.382) The fib to base candle body on
// @param colorMatch (default=false) Does the candle need to be red? (true/false)
// @returns A boolean - true if the current bar matches the requirements of a shooting star candle
export isStar(float fib = 0.382, bool colorMatch = true) =>
    bearFib = bearFib(low, high, fib)
    highestBody = close > open ? close : open
    bool _return = highestBody <= bearFib and (not colorMatch or close < open) and not isDoji(2.0,0.05) and getBottomWickSize() <= getBodySize()


// @function Detects Bullish outside bars(OB)
// @returns Returns true if the current bar is a bull outside bar
export isBlOB() => 
    bool _return = high > high[1] and low < low[1] and isBlTrendBar()


// @function Detects Bearish outside bars(OB)
// @returns Returns true if the current bar is a bear outside bar
export isBrOB() => 
    bool _return = high > high[1] and low < low[1] and isBrTrendBar()



// } <--- END CANDLE SETUP DETECTION



