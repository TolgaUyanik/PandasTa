    float weightSum = 0.0
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            float k = i / length
            float w = 0.42 - 0.5 * math.cos(2 * math.pi * k) + 0.08 * math.cos(4 * math.pi * k)
            sum += val * w
            weightSum += w
            
    weightSum > 0 ? sum / weightSum : na

// @function Corrective Moving Average (CMA).
// @param src The source series.
// @param length The length.
// @returns The calculated CMA.
export cma(series float src, simple int length) =>
    float sma_val = sma(src, length)
    var float ma = na
    
    if not na(src) and not na(sma_val)
        // Manual variance calculation to handle NA properly
        float sum_difsq = 0.0
        int count = 0
        for i = 0 to length - 1
            if not na(src[i])
                sum_difsq += math.pow(src[i] - sma_val, 2)
                count += 1
        
        float v1 = count > 0 ? sum_difsq / count : 0.0
        float prev_ma = nz(ma[1], sma_val)
        float v2 = math.pow(prev_ma - sma_val, 2)
        float v3 = (v1 == 0 or v2 == 0) ? 1.0 : v2 / (v1 + v2)
        
        // Iterative Gain Factor
        float tolerance = 1e-5
        float err = 1.0
        float kPrev = 1.0
        float k = 1.0
        
        // Capped loop for efficiency
        for i = 0 to 100 
            if err > tolerance
                k := v3 * kPrev * (2 - kPrev)
                err := math.abs(kPrev - k)
                kPrev := k
            else 
                break
                
        ma := prev_ma + k * (sma_val - prev_ma)
    else 
        ma := sma_val
    ma

// @function Corrective Moving Average (CMA).
// @param src The source series.
// @param length The length.
// @returns The calculated CMA.
export cma(series float src, series int length) =>
    float sma_val = sma(src, length)
    var float ma = na
    
    if not na(src) and not na(sma_val)
        // Manual variance calculation to handle NA properly
        float sum_difsq = 0.0
        int count = 0
        for i = 0 to length - 1
            if not na(src[i])
                sum_difsq += math.pow(src[i] - sma_val, 2)
                count += 1
        
        float v1 = count > 0 ? sum_difsq / count : 0.0
        float prev_ma = nz(ma[1], sma_val)
        float v2 = math.pow(prev_ma - sma_val, 2)
        float v3 = (v1 == 0 or v2 == 0) ? 1.0 : v2 / (v1 + v2)
        
        // Iterative Gain Factor
        float tolerance = 1e-5
        float err = 1.0
        float kPrev = 1.0
        float k = 1.0
        
        // Capped loop for efficiency
        for i = 0 to 100 
            if err > tolerance
                k := v3 * kPrev * (2 - kPrev)
                err := math.abs(kPrev - k)
                kPrev := k
            else 
                break
                
        ma := prev_ma + k * (sma_val - prev_ma)
    else 
        ma := sma_val
    ma

// @function Double Exponential Moving Average (DEMA).
// @param src The source series.
// @param length The length.
// @returns The calculated DEMA.
export dema(series float src, simple int length) =>
    float e1 = ema(src, length)
    float e2 = ema(e1, length)
    2 * e1 - e2

// @function Double Exponential Moving Average (DEMA).
// @param src The source series.
// @param length The length.
// @returns The calculated DEMA.
export dema(series float src, series int length) =>
    float e1 = ema(src, length)
    float e2 = ema(e1, length)
    2 * e1 - e2

// @function Damped Sine Wave Weighted Filter (DSWF).
// @param src The source series.
// @param length The length.
// @returns The calculated DSWF.
export dswf(series float src, simple int length) =>
    float sum = 0.0
    float weightSum = 0.0
    
    for i = 1 to length
        float val = src[i - 1]
        if not na(val)
            float w = math.sin(2.0 * math.pi * i / length) / i
            sum += val * w
            weightSum += w
            
    weightSum != 0 ? sum / weightSum : na

// @function Damped Sine Wave Weighted Filter (DSWF).
// @param src The source series.
// @param length The length.
// @returns The calculated DSWF.
export dswf(series float src, series int length) =>
