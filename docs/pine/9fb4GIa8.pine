//@version=6

// @description This library broadens the set of moving-average methods available to traders.
// It includes robust handling of `na` values, ensuring calculations remain accurate even with missing data.
library("ma_library")

// ==========================================
// Basic Moving Averages
// ==========================================

// @function Calculates a Simple Moving Average (SMA) ignoring na values.
// @param src The source series (e.g., close).
// @param length The length of the moving average.
// @returns The calculated SMA.
export sma(series float src, simple int length) =>
    int local_len = math.max(1, length)
    float sum = 0.0
    int count = 0
    for i = 0 to local_len - 1
        float val = src[i]
        if not na(val)
            sum += val
            count += 1
    count > 0 ? sum / count : na

// @function Calculates a Simple Moving Average (SMA) ignoring na values.
// @param src The source series (e.g., close).
// @param length The length of the moving average.
// @returns The calculated SMA.
export sma(series float src, series int length) =>
    int local_len = math.max(1, length)
    float sum = 0.0
    int count = 0
    for i = 0 to local_len - 1
        float val = src[i]
        if not na(val)
            sum += val
            count += 1
    count > 0 ? sum / count : na

// @function Calculates an Exponential Moving Average (EMA). Holds previous value if current source is na.
// @param src The source series.
// @param length The length of the EMA.
// @returns The calculated EMA.
export ema(series float src, simple int length) =>
    float alpha = 2.0 / (length + 1)
    var float ema = na
    
    if not na(src)
        ema := na(ema) ? src : (src - ema) * alpha + ema
    ema

// @function Calculates an Exponential Moving Average (EMA). Holds previous value if current source is na.
// @param src The source series.
// @param length The length of the EMA.
// @returns The calculated EMA.
export ema(series float src, series int length) =>
    float alpha = 2.0 / (length + 1)
    var float ema = na
    
    if not na(src)
        ema := na(ema) ? src : (src - ema) * alpha + ema
    ema

// @function Calculates a Weighted Moving Average (WMA) ignoring na values. 
// Weights are normalized based on valid data points.
// @param src The source series.
// @param length The length of the WMA.
// @returns The calculated WMA.
export wma(series float src, simple int length) =>
    float sum = 0.0
    float weightSum = 0.0
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            float weight = length - i
            sum += val * weight
            weightSum += weight
            
    weightSum > 0 ? sum / weightSum : na

// @function Calculates a Weighted Moving Average (WMA) ignoring na values. 
// Weights are normalized based on valid data points.
// @param src The source series.
// @param length The length of the WMA.
// @returns The calculated WMA.
export wma(series float src, series int length) =>
    float sum = 0.0
    float weightSum = 0.0
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            float weight = length - i
            sum += val * weight
            weightSum += weight
            
    weightSum > 0 ? sum / weightSum : na

// ==========================================
// Advanced & Adaptive Moving Averages
// ==========================================

// @function Ehlers Instantaneous Trendline (EIT).
// @param src The source series.
// @returns The calculated EIT.
export eit(series float src) =>
    float eit_alpha = 0.07
    float ma = na
    
    // Safety check for history
    float s0 = nz(src, src[1])
    float s1 = nz(src[1], src)
    float s2 = nz(src[2], src[1])
    
    if bar_index < 7
        ma := (s0 + 2 * s1 + s2) / 4
    else
        // Use nz on self-reference to handle initialization
        float prev_ma1 = nz(ma[1], s1)
        float prev_ma2 = nz(ma[2], s2)
        
        float term1 = (0.07 - (math.pow(eit_alpha, 2) / 4)) * s0
        float term2 = (0.5 * math.pow(eit_alpha, 2) * s1)
        float term3 = (eit_alpha - (0.75 * math.pow(eit_alpha, 2))) * s2
        float term4 = 2 * (1 - eit_alpha) * prev_ma1
        float term5 = math.pow(1 - eit_alpha, 2) * prev_ma2
        
        ma := term1 + term2 - term3 + term4 - term5
    ma

// @function Arnaud Legoux Moving Average (ALMA) ignoring na values.
// @param src The source series.
// @param length The window size.
// @param offset The Gaussian offset (0-1).
// @param sigma The sigma value for the Gaussian distribution.
// @returns The calculated ALMA.
export alma(series float src, simple int length, simple float offset, simple float sigma) =>
    float m = offset * (length - 1)
    float s = length / sigma
    float sum = 0.0
    float norm = 0.0
    
    for i = 0 to length - 1
        float val = src[length - 1 - i]
        if not na(val)
            float weight = math.exp(-1 * math.pow(i - m, 2) / (2 * math.pow(s, 2)))
            sum += val * weight
            norm += weight
            
    norm > 0 ? sum / norm : na

// @function Arnaud Legoux Moving Average (ALMA) ignoring na values.
// @param src The source series.
// @param length The window size.
// @param offset The Gaussian offset (0-1).
// @param sigma The sigma value for the Gaussian distribution.
// @returns The calculated ALMA.
export alma(series float src, series int length, simple float offset, simple float sigma) =>
    float m = offset * (length - 1)
    float s = length / sigma
    float sum = 0.0
    float norm = 0.0
    
    for i = 0 to length - 1
        float val = src[length - 1 - i]
        if not na(val)
            float weight = math.exp(-1 * math.pow(i - m, 2) / (2 * math.pow(s, 2)))
            sum += val * weight
            norm += weight
            
    norm > 0 ? sum / norm : na

// @function Ahrens Moving Average (AHMA).
// @param src The source series.
// @param length The length.
// @returns The calculated AHMA.
export ahma(series float src, simple int length) =>
    var float ma = na
    
    if not na(src)
        float prev_ma = nz(ma[1], src)
        float src_lag = nz(ma[length], src) // Approximation for stability
        ma := prev_ma + (src - (prev_ma + src_lag) / 2) / length
    ma

// @function Ahrens Moving Average (AHMA).
// @param src The source series.
// @param length The length.
// @returns The calculated AHMA.
export ahma(series float src, series int length) =>
    var float ma = na
    
    if not na(src)
        float prev_ma = nz(ma[1], src)
        float src_lag = nz(ma[length], src) // Approximation for stability
        ma := prev_ma + (src - (prev_ma + src_lag) / 2) / length
    ma

// @function Blackman Filter (BMF) ignoring na values.
// @param src The source series.
// @param length The length.
// @returns The calculated BMF.
export bmf(series float src, simple int length) =>
    float sum = 0.0
    float weightSum = 0.0
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            float k = i / length
            float w = 0.42 - 0.5 * math.cos(2 * math.pi * k) + 0.08 * math.cos(4 * math.pi * k)
            sum += val * w
            weightSum += w
            
    weightSum > 0 ? sum / weightSum : na

// @function Blackman Filter (BMF) ignoring na values.
