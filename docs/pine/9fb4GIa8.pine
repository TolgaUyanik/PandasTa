    w_sum != 0 ? sum / w_sum : na

// @function Triangular Moving Average (TMA).
// @param src The source series.
// @param length The length.
// @returns The calculated TMA.
export tma(series float src, simple int length) =>
    int len1 = math.ceil(length / 2)
    int len2 = math.floor(length / 2) + 1
    sma(sma(src, len1), len2)

// @function Triangular Moving Average (TMA).
// @param src The source series.
// @param length The length.
// @returns The calculated TMA.
export tma(series float src, series int length) =>
    int len1 = math.ceil(length / 2)
    int len2 = math.floor(length / 2) + 1
    sma(sma(src, len1), len2)

// @function Triple Exponential Moving Average (TEMA).
// @param src The source series.
// @param length The length.
// @returns The calculated TEMA.
export tema(series float src, simple int length) =>
    float e1 = ema(src, length)
    float e2 = ema(e1, length)
    float e3 = ema(e2, length)
    3 * e1 - 3 * e2 + e3

// @function Triple Exponential Moving Average (TEMA).
// @param src The source series.
// @param length The length.
// @returns The calculated TEMA.
export tema(series float src, series int length) =>
    float e1 = ema(src, length)
    float e2 = ema(e1, length)
    float e3 = ema(e2, length)
    3 * e1 - 3 * e2 + e3

// @function True Strength Force (TSF) - Forecast.
// @param src The source series.
// @param length The length.
// @returns The calculated TSF.
export tsf(series float src, simple int length) =>
    // TSF is usually Linear Regression Forecast: y = mx + b calculated for next bar or current
    // Standard TSF = LRI + slope.
    // LRI = LinReg(0), Slope = LinReg(0) - LinReg(1)
    // TSF = LinReg(0) + (LinReg(0) - LinReg(1))
    float lrc = lsma(src, length)
    float lrc1 = lsma(src[1], length) // Lookback for slope
    lrc + (lrc - lrc1)

// @function True Strength Force (TSF) - Forecast.
// @param src The source series.
// @param length The length.
// @returns The calculated TSF.
export tsf(series float src, series int length) =>
    // TSF is usually Linear Regression Forecast: y = mx + b calculated for next bar or current
    // Standard TSF = LRI + slope.
    // LRI = LinReg(0), Slope = LinReg(0) - LinReg(1)
    // TSF = LinReg(0) + (LinReg(0) - LinReg(1))
    float lrc = lsma(src, length)
    float lrc1 = lsma(src[1], length) // Lookback for slope
    lrc + (lrc - lrc1)

// @function VIDYA (Variable Index Dynamic Average) - previously VARMA/VMA.
// @param src The source series.
// @param length The length.
// @returns The calculated VIDYA.
export vidya(series float src, simple int length) =>
    var float ma = na
    float alpha = 2.0 / (length + 1)
    
    if not na(src)
        // Manual CMO calculation
        float sum_up = 0.0
        float sum_down = 0.0
        for i = 0 to 8 // Fixed length 9 as per original code
            float change = src[i] - src[i+1]
            if not na(change)
                if change > 0
                    sum_up += change
                else
                    sum_down += math.abs(change)
        
        float div = sum_up + sum_down
        float cmo = div != 0 ? math.abs((sum_up - sum_down) / div) : 0.0
        
        ma := na(ma) ? src : (alpha * cmo * src) + (1 - alpha * cmo) * ma
    ma

// @function VIDYA (Variable Index Dynamic Average) - previously VARMA/VMA.
// @param src The source series.
// @param length The length.
// @returns The calculated VIDYA.
export vidya(series float src, series int length) =>
    var float ma = na
    float alpha = 2.0 / (length + 1)
    
    if not na(src)
        // Manual CMO calculation
        float sum_up = 0.0
        float sum_down = 0.0
        for i = 0 to 8 // Fixed length 9 as per original code
            float change = src[i] - src[i+1]
            if not na(change)
                if change > 0
                    sum_up += change
                else
                    sum_down += math.abs(change)
        
        float div = sum_up + sum_down
        float cmo = div != 0 ? math.abs((sum_up - sum_down) / div) : 0.0
        
        ma := na(ma) ? src : (alpha * cmo * src) + (1 - alpha * cmo) * ma
    ma

// @function Volume Adjusted Moving Average (VAMA).
// @param src The source series.
// @param length The length.
// @returns The calculated VAMA.
export vama(series float src, simple int length) =>
    float mid = ema(src, length)
    float dev = src - mid
    // Volatility lookback fixed to 12 as per original source
    float volUp = ta.highest(dev, 12)
    float volDown = ta.lowest(dev, 12)
    mid + math.avg(volUp, volDown)

// @function Volume Adjusted Moving Average (VAMA).
// @param src The source series.
// @param length The length.
// @returns The calculated VAMA.
export vama(series float src, series int length) =>
    float mid = ema(src, length)
    float dev = src - mid
    // Volatility lookback fixed to 12 as per original source
    float volUp = ta.highest(dev, 12)
    float volDown = ta.lowest(dev, 12)
    mid + math.avg(volUp, volDown)

// @function Variable Band Moving Average (VBMA).
// @param src The source series.
// @param length The length.
// @returns The calculated VBMA.
export vbma(series float src, simple int length) =>
    var float ma = na
    var float pdmS = 0.0
    var float mdmS = 0.0
    var float pdiS = 0.0
    var float mdiS = 0.0
    var float iS = 0.0
    
    if not na(src) and not na(src[1])
        float k = 1.0 / length
        float pdm = math.max((src - src[1]), 0)
        float mdm = math.max((src[1] - src), 0)
        
        pdmS := (1 - k) * pdmS + k * pdm
        mdmS := (1 - k) * mdmS + k * mdm
        
        float s = pdmS + mdmS
        float pdi = s != 0 ? pdmS / s : 0
        float mdi = s != 0 ? mdmS / s : 0
        
        pdiS := (1 - k) * pdiS + k * pdi
        mdiS := (1 - k) * mdiS + k * mdi
        
        float d = math.abs(pdiS - mdiS)
        float s1 = pdiS + mdiS
        
        if s1 != 0
            iS := (1 - k) * iS + k * (d / s1)
        
        float hhv = ta.highest(iS, length)
        float llv = ta.lowest(iS, length)
        float d1 = hhv - llv
        float vI = d1 != 0 ? (iS - llv) / d1 : 0
        
        ma := na(ma) ? src : (1 - k * vI) * ma + k * vI * src
    ma

// @function Variable Band Moving Average (VBMA).
// @param src The source series.
// @param length The length.
// @returns The calculated VBMA.
export vbma(series float src, series int length) =>
    var float ma = na
    var float pdmS = 0.0
    var float mdmS = 0.0
    var float pdiS = 0.0
    var float mdiS = 0.0
    var float iS = 0.0
    
    if not na(src) and not na(src[1])
        float k = 1.0 / length
        float pdm = math.max((src - src[1]), 0)
        float mdm = math.max((src[1] - src), 0)
        
        pdmS := (1 - k) * pdmS + k * pdm
        mdmS := (1 - k) * mdmS + k * mdm
        
        float s = pdmS + mdmS
        float pdi = s != 0 ? pdmS / s : 0
        float mdi = s != 0 ? mdmS / s : 0
        
        pdiS := (1 - k) * pdiS + k * pdi
        mdiS := (1 - k) * mdiS + k * mdi
        
        float d = math.abs(pdiS - mdiS)
        float s1 = pdiS + mdiS
        
        if s1 != 0
            iS := (1 - k) * iS + k * (d / s1)
        
        float hhv = ta.highest(iS, length)
        float llv = ta.lowest(iS, length)
        float d1 = hhv - llv
        float vI = d1 != 0 ? (iS - llv) / d1 : 0
        
        ma := na(ma) ? src : (1 - k * vI) * ma + k * vI * src
    ma

// @function Quick Moving Average (QMA).
// @param src The source series.
// @param length The length.
// @returns The calculated QMA.
export qma(series float src, simple int length) =>
    float sum = 0.0
    float w_sum = 0.0
    int peak = math.floor(length / 3)
    
    for i = 1 to length + 1
        float val = src[i-1]
        if not na(val)
            float mult = 0.0
            if i <= peak
                mult := i / float(peak)
            else
                mult := (length + 1 - i) / (length + 1 - float(peak))
            
            sum += val * mult
            w_sum += mult
            
    w_sum != 0 ? sum / w_sum : na

// @function Quick Moving Average (QMA).
// @param src The source series.
// @param length The length.
// @returns The calculated QMA.
export qma(series float src, series int length) =>
    float sum = 0.0
    float w_sum = 0.0
    int peak = math.floor(length / 3)
    
    for i = 1 to length + 1
        float val = src[i-1]
        if not na(val)
            float mult = 0.0
            if i <= peak
                mult := i / float(peak)
            else
                mult := (length + 1 - i) / (length + 1 - float(peak))
            
            sum += val * mult
            w_sum += mult
            
    w_sum != 0 ? sum / w_sum : na

// @function Calculates a Rolling Moving Average (RMA) / Wilder's Smoothing.
// Maintains continuity by holding the previous value if the current source is na.
// @param src The source series.
// @param length The length.
// @returns The calculated RMA.
export rma(series float src, simple int length) =>
    float alpha = 1.0 / length
    var float ma = na
    
    // Logic: 
    // 1. If src is na, do nothing (return previous ma).
    // 2. If ma is na (first run), initialize with src.
    // 3. Otherwise, apply Wilder's formula.
    if not na(src)
        ma := na(ma) ? src : alpha * src + (1 - alpha) * ma
        
    ma

// @function Calculates a Rolling Moving Average (RMA) / Wilder's Smoothing.
// Maintains continuity by holding the previous value if the current source is na.
// @param src The source series.
// @param length The length.
// @returns The calculated RMA.
export rma(series float src, series int length) =>
    float alpha = 1.0 / length
    var float ma = na
    
    // Logic: 
    // 1. If src is na, do nothing (return previous ma).
    // 2. If ma is na (first run), initialize with src.
    // 3. Otherwise, apply Wilder's formula.
    if not na(src)
        ma := na(ma) ? src : alpha * src + (1 - alpha) * ma
        
    ma

// @function Repulsion Moving Average (RPMA).
// @param src The source series.
// @param length The length.
// @returns The calculated RPMA.
export rpma(series float src, simple int length) =>
    // Formula: SMA(3x) + SMA(2x) - SMA(1x)
    sma(src, length * 3) + sma(src, length * 2) - sma(src, length)

// @function Repulsion Moving Average (RPMA).
// @param src The source series.
// @param length The length.
// @returns The calculated RPMA.
export rpma(series float src, series int length) =>
    // Formula: SMA(3x) + SMA(2x) - SMA(1x)
    sma(src, length * 3) + sma(src, length * 2) - sma(src, length)

// @function Right Sided Ricker Moving Average (RSRMA).
// @param src The source series.
// @param length The length.
// @returns The calculated RSRMA.
export rsrma(series float src, simple int length) =>
    float sum = 0.0
    float w_sum = 0.0
    float pw = 60.0
    float width = pw / 100.0 * length
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            float x_ratio = i / width
            float w = (1 - math.pow(x_ratio, 2)) * math.exp(-(i * i) / (2 * math.pow(width, 2)))
            sum += val * w
            w_sum += w
            
    w_sum != 0 ? sum / w_sum : na

// @function Right Sided Ricker Moving Average (RSRMA).
// @param src The source series.
// @param length The length.
// @returns The calculated RSRMA.
export rsrma(series float src, series int length) =>
    float sum = 0.0
    float w_sum = 0.0
    float pw = 60.0
    float width = pw / 100.0 * length
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            float x_ratio = i / width
            float w = (1 - math.pow(x_ratio, 2)) * math.exp(-(i * i) / (2 * math.pow(width, 2)))
            sum += val * w
            w_sum += w
            
    w_sum != 0 ? sum / w_sum : na

// @function Calculates a Volume Weighted Moving Average (VWMA) ignoring na values.
// Only bars containing both a valid price and a valid volume are included in the sum.
// @param src The source series (e.g., close).
// @param length The length of the moving average.
// @param vol The volume series (usually `volume`).
// @returns The calculated VWMA.
export vwma(series float src, simple int length, series float vol) =>
    int local_len = math.max(1, length)
    float sumPV = 0.0
    float sumV = 0.0
    
    for i = 0 to local_len - 1
        float p = src[i]
        float v = vol[i]
        
        // Robustness check: Ensure both Price and Volume are valid numbers
        if not na(p) and not na(v)
            sumPV += p * v
            sumV += v
            
    sumV > 0 ? sumPV / sumV : na

// @function Calculates a Volume Weighted Moving Average (VWMA) ignoring na values.
// Only bars containing both a valid price and a valid volume are included in the sum.
// @param src The source series (e.g., close).
// @param length The length of the moving average.
// @param vol The volume series (usually `volume`).
// @returns The calculated VWMA.
export vwma(series float src, series int length, series float vol) =>
    int local_len = math.max(1, length)
    float sumPV = 0.0
    float sumV = 0.0
    
    for i = 0 to local_len - 1
        float p = src[i]
        float v = vol[i]
        
        // Robustness check: Ensure both Price and Volume are valid numbers
        if not na(p) and not na(v)
            sumPV += p * v
            sumV += v
            
    sumV > 0 ? sumPV / sumV : na

// @function Zero Lag Exponential Moving Average (ZLEMA).
// @param src The source series.
// @param length The length.
// @returns The calculated ZLEMA.
export zlema(series float src, simple int length) =>
    // Standard ZLEMA is EMA of de-lagged data
    int lag = math.floor((length - 1) / 2)
    // De-lagged data: Close + (Close - Close[lag])
    // Need to handle NA in lag
    float val_lag = nz(src[lag], src)
    float de_lagged = src + (src - val_lag)
    ema(de_lagged, length)

// @function Zero Lag Exponential Moving Average (ZLEMA).
// @param src The source series.
// @param length The length.
// @returns The calculated ZLEMA.
export zlema(series float src, series int length) =>
    // Standard ZLEMA is EMA of de-lagged data
    int lag = math.floor((length - 1) / 2)
    // De-lagged data: Close + (Close - Close[lag])
    // Need to handle NA in lag
    float val_lag = nz(src[lag], src)
    float de_lagged = src + (src - val_lag)
    ema(de_lagged, length)

// ==========================================
// Selector
// ==========================================

// @function Allows the user to select a Moving Average type via a string input.
// @param src The source series.
// @param length The length.
// @param type The string identifier for the MA (e.g., "SMA", "EMA").
// @returns The calculated MA based on selection.
export selector(float src, simple int length, string type) =>
    float ma = src
    
    switch type
        "SMA"   => ma := sma(src, length)
        "EMA"   => ma := ema(src, length)
        "WMA"   => ma := wma(src, length)
        "VWMA"  => ma := vwma(src, length, volume)
        "RMA"   => ma := rma(src, length)
        "ALMA"  => ma := alma(src, length, 0.85, 6)
        "AHMA"  => ma := ahma(src, length)
        "BMF"   => ma := bmf(src, length)
        "CMA"   => ma := cma(src, length)
        "DEMA"  => ma := dema(src, length)
        "DSWF"  => ma := dswf(src, length)
        "EIT"   => ma := eit(src)
        "ESD"   => ma := esd(src, length)
        "EVWMA" => ma := evwma(src, length, volume)
        "FRAMA" => ma := frama(src, length)
        "FLSMA" => ma := flsma(src, length)
        "GMMA"  => ma := gmma(src, length)
        "HCF"   => ma := hcf(src, length)
        "HMA"   => ma := hma(src, length)
        "JMA"   => ma := jma(src, length)
        "KAMA"  => ma := kama(src, length)
        "KAMA_FAST"  => ma := kama(src, length, 1.5)
        "KAMA_SLOW"  => ma := kama(src, length, 3)
        "KIJUN" => ma := kijun(src, length)
        "LSMA"  => ma := lsma(src, length)
        "LMA"   => ma := lma(src, length)
        "MD"    => ma := md(src, length)
        "MF"    => ma := mf(src, length)
        "MM"    => ma := mm(src, length)
        "QMA"   => ma := qma(src, length)
        "RPMA"  => ma := rpma(src, length)
        "RSRMA" => ma := rsrma(src, length)
        "SMMA"  => ma := smma(src, length)
        "SSMA"  => ma := ssma(src, length)
        "SWMA"  => ma := swma(src, length)
        "TEMA"  => ma := tema(src, length)
        "TMA"   => ma := tma(src, length)
        "TSF"   => ma := tsf(src, length)
        "VAMA"  => ma := vama(src, length)
        "VBMA"  => ma := vbma(src, length)
        "VIDYA" => ma := vidya(src, length) // Unified VARMA/VMA
        "ZLEMA" => ma := zlema(src, length)
        => ma := sma(src, length) // Default
    ma

