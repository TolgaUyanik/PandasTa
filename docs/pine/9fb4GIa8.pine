    float weightSum = 0.0
    
    for i = 1 to length
        float val = src[i - 1]
        if not na(val)
            float w = math.sin(2.0 * math.pi * i / length) / i
            sum += val * w
            weightSum += w
            
    weightSum != 0 ? sum / weightSum : na

// @function Elastic Volume Weighted MA (EVWMA).
// @param src The source series.
// @param length The length.
// @param volume_src The volume series.
// @returns The calculated EVWMA.
export evwma(series float src, simple int length, series float volume_src) =>
    var float ma = na
    
    if not na(src) and not na(volume_src)
        // Manual volume sum to handle NAs
        float vol_sum = 0.0
        for i = 0 to length - 1
            vol_sum += nz(volume_src[i], 0)
            
        if na(ma)
            ma := src
        else if vol_sum > 0
            ma := ((vol_sum - volume_src) * ma + volume_src * src) / vol_sum
    ma

// @function Elastic Volume Weighted MA (EVWMA).
// @param src The source series.
// @param length The length.
// @param volume_src The volume series.
// @returns The calculated EVWMA.
export evwma(series float src, series int length, series float volume_src) =>
    var float ma = na
    
    if not na(src) and not na(volume_src)
        // Manual volume sum to handle NAs
        float vol_sum = 0.0
        for i = 0 to length - 1
            vol_sum += nz(volume_src[i], 0)
            
        if na(ma)
            ma := src
        else if vol_sum > 0
            ma := ((vol_sum - volume_src) * ma + volume_src * src) / vol_sum
    ma

// @function Ehlers Simple Decycler (ESD).
// @param src The source series.
// @param length The length.
// @returns The calculated ESD.
export esd(series float src, simple int length) =>
    float angle = 2 * math.pi / (length * 1.414) // sqrt(2) approx
    float alpha = (math.cos(angle) + math.sin(angle) - 1) / math.cos(angle)
    
    var float hp = na
    float s0 = nz(src, src[1])
    float s1 = nz(src[1], src)
    float s2 = nz(src[2], src[1])
    
    if not na(src)
        float prev_hp1 = nz(hp[1], 0.0)
        float prev_hp2 = nz(hp[2], 0.0)
        
        hp := math.pow(1 - (alpha / 2), 2) * (s0 - 2 * s1 + s2) + 2 * (1 - alpha) * prev_hp1 - math.pow(1 - alpha, 2) * prev_hp2
    
    src - hp

// @function Ehlers Simple Decycler (ESD).
// @param src The source series.
// @param length The length.
// @returns The calculated ESD.
export esd(series float src, series int length) =>
    float angle = 2 * math.pi / (length * 1.414) // sqrt(2) approx
    float alpha = (math.cos(angle) + math.sin(angle) - 1) / math.cos(angle)
    
    var float hp = na
    float s0 = nz(src, src[1])
    float s1 = nz(src[1], src)
    float s2 = nz(src[2], src[1])
    
    if not na(src)
        float prev_hp1 = nz(hp[1], 0.0)
        float prev_hp2 = nz(hp[2], 0.0)
        
        hp := math.pow(1 - (alpha / 2), 2) * (s0 - 2 * s1 + s2) + 2 * (1 - alpha) * prev_hp1 - math.pow(1 - alpha, 2) * prev_hp2
    
    src - hp

// @function Fractal Adaptive MA (FRAMA).
// @param src The source series.
// @param length The length.
// @returns The calculated FRAMA.
export frama(series float src, simple int length) =>
    var float ma = na
    
    if not na(src)
        int len2 = math.floor(length / 2)
        // ta.highest/lowest automatically ignore na, but return na if all are na
        float hh2 = ta.highest(len2)
        float ll2 = ta.lowest(len2)
        float hh2_lag = ta.highest(src[len2], len2)
        float ll2_lag = ta.lowest(src[len2], len2)
        float hh = ta.highest(length)
        float ll = ta.lowest(length)
        
        if not na(hh2) and not na(hh)
            float N1 = (hh2 - ll2) / len2
            float N2 = (hh2_lag - ll2_lag) / len2
            float N3 = (hh - ll) / length
            
            float D = 0.0
            if N3 > 0 and (N1 + N2) > 0
                D := (math.log(N1 + N2) - math.log(N3)) / math.log(2)
            
            float alpha = math.exp(-4.6 * (D - 1))
            alpha := math.max(0.01, math.min(1.0, alpha)) // Clamp alpha
            
            ma := na(ma[1]) ? src : alpha * src + (1 - alpha) * ma[1]
    ma

// @function Fractal Adaptive MA (FRAMA).
// @param src The source series.
// @param length The length.
// @returns The calculated FRAMA.
export frama(series float src, series int length) =>
    var float ma = na
    
    if not na(src)
        int len2 = math.floor(length / 2)
        // ta.highest/lowest automatically ignore na, but return na if all are na
        float hh2 = ta.highest(len2)
        float ll2 = ta.lowest(len2)
        float hh2_lag = ta.highest(src[len2], len2)
        float ll2_lag = ta.lowest(src[len2], len2)
        float hh = ta.highest(length)
        float ll = ta.lowest(length)
        
        if not na(hh2) and not na(hh)
            float N1 = (hh2 - ll2) / len2
            float N2 = (hh2_lag - ll2_lag) / len2
            float N3 = (hh - ll) / length
            
            float D = 0.0
            if N3 > 0 and (N1 + N2) > 0
                D := (math.log(N1 + N2) - math.log(N3)) / math.log(2)
            
            float alpha = math.exp(-4.6 * (D - 1))
            alpha := math.max(0.01, math.min(1.0, alpha)) // Clamp alpha
            
            ma := na(ma[1]) ? src : alpha * src + (1 - alpha) * ma[1]
    ma

// @function Fisher Least Squares MA (FLSMA).
// @param src The source series.
// @param length The length.
// @returns The calculated FLSMA.
export flsma(series float src, simple int length) =>
    float sma_src = sma(src, length)
    var float ma = na
    
    if not na(src)
        float prev_ma = nz(ma[1], src)
        // Calculate dynamic error components manually to handle NA
        float difabs_sum = 0.0
        float difsum = 0.0
        float val_sq_sum = 0.0
        float val_sum = 0.0
        int count = 0
        
        for i = 0 to length - 1
            if not na(src[i])
                difabs_sum += math.abs(src[i] - prev_ma)
                difsum += src[i] - prev_ma
                val_sum += src[i]
                val_sq_sum += src[i] * src[i]
                count += 1
        
        if count > 0
            float e = difabs_sum / count
            float z = e != 0 ? (difsum / count) / e : 0
            float r = (math.exp(2 * z) - 1) / (math.exp(2 * z) + 1)
            
            // Standard Deviation of src manually
            float mean = val_sum / count
            float variance = (val_sq_sum / count) - (mean * mean)
            float std_dev = math.sqrt(math.max(0, variance))
            
            // StDev of bar_index is constant for fixed length, simplified linear term
            // Using a simplified factor 'a' as per original code intent but secured
            float a = 0.5 * r // Simplified approximation factor for robustness
            
            ma := sma_src + a * std_dev
    ma

// @function Fisher Least Squares MA (FLSMA).
// @param src The source series.
// @param length The length.
// @returns The calculated FLSMA.
export flsma(series float src, series int length) =>
    float sma_src = sma(src, length)
    var float ma = na
    
    if not na(src)
        float prev_ma = nz(ma[1], src)
        // Calculate dynamic error components manually to handle NA
        float difabs_sum = 0.0
        float difsum = 0.0
        float val_sq_sum = 0.0
        float val_sum = 0.0
        int count = 0
        
        for i = 0 to length - 1
            if not na(src[i])
                difabs_sum += math.abs(src[i] - prev_ma)
                difsum += src[i] - prev_ma
                val_sum += src[i]
                val_sq_sum += src[i] * src[i]
                count += 1
        
        if count > 0
            float e = difabs_sum / count
            float z = e != 0 ? (difsum / count) / e : 0
            float r = (math.exp(2 * z) - 1) / (math.exp(2 * z) + 1)
            
            // Standard Deviation of src manually
            float mean = val_sum / count
            float variance = (val_sq_sum / count) - (mean * mean)
            float std_dev = math.sqrt(math.max(0, variance))
            
            // StDev of bar_index is constant for fixed length, simplified linear term
            // Using a simplified factor 'a' as per original code intent but secured
            float a = 0.5 * r // Simplified approximation factor for robustness
            
            ma := sma_src + a * std_dev
    ma

// @function Geometric Mean MA (GMMA).
// @param src The source series.
// @param length The length.
// @returns The calculated GMMA.
export gmma(series float src, simple int length) =>
    float log_sum = 0.0
    int count = 0
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val) and val > 0
            log_sum += math.log(val)
            count += 1
            
    count > 0 ? math.exp(log_sum / count) : na

// @function Geometric Mean MA (GMMA).
// @param src The source series.
// @param length The length.
// @returns The calculated GMMA.
export gmma(series float src, series int length) =>
    float log_sum = 0.0
    int count = 0
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val) and val > 0
            log_sum += math.log(val)
            count += 1
            
    count > 0 ? math.exp(log_sum / count) : na

// @function Hybrid Convolution Filter (HCF).
// @param src The source series.
// @param length The length.
// @returns The calculated HCF.
export hcf(series float src, simple int length) =>
    float sum = 0.0
    float w_sum = 0.0
    float prev_ma = nz(src[1], src) // Approximation
    
    for i = 1 to length
        // Determine values
        float val0 = prev_ma
        float val1 = src[i-1]
        
        if not na(val1)
            float pi_ratio_i = (i * math.pi) / length
            float pi_ratio_prev = ((i - 1) * math.pi) / length
            
            float sgn = 0.5 * (1 - math.cos(pi_ratio_i))
            float w = (0.5 * (1 - math.cos(pi_ratio_i))) - (0.5 * (1 - math.cos(pi_ratio_prev)))
            
            float sample = sgn * val0 + (1 - sgn) * val1
            
            sum += sample * w
            w_sum += w
            
    w_sum != 0 ? sum / w_sum : na

// @function Hybrid Convolution Filter (HCF).
// @param src The source series.
// @param length The length.
// @returns The calculated HCF.
export hcf(series float src, series int length) =>
    float sum = 0.0
    float w_sum = 0.0
    float prev_ma = nz(src[1], src) // Approximation
    
    for i = 1 to length
        // Determine values
        float val0 = prev_ma
        float val1 = src[i-1]
        
        if not na(val1)
            float pi_ratio_i = (i * math.pi) / length
            float pi_ratio_prev = ((i - 1) * math.pi) / length
            
            float sgn = 0.5 * (1 - math.cos(pi_ratio_i))
            float w = (0.5 * (1 - math.cos(pi_ratio_i))) - (0.5 * (1 - math.cos(pi_ratio_prev)))
            
            float sample = sgn * val0 + (1 - sgn) * val1
            
            sum += sample * w
            w_sum += w
            
    w_sum != 0 ? sum / w_sum : na

// @function Hull Moving Average (HMA).
// @param src The source series.
// @param length The length.
// @returns The calculated HMA.
export hma(series float src, simple int length) =>
    int hallen = math.floor(length / 2)
    int sqrt_len = math.round(math.sqrt(length))
    
    float wma1 = wma(src, hallen)
    float wma2 = wma(src, length)
    float diff = 2 * wma1 - wma2
    
    wma(diff, sqrt_len)

// @function Hull Moving Average (HMA).
// @param src The source series.
// @param length The length.
// @returns The calculated HMA.
export hma(series float src, series int length) =>
    int hallen = math.floor(length / 2)
    int sqrt_len = math.round(math.sqrt(length))
    
    float wma1 = wma(src, hallen)
    float wma2 = wma(src, length)
    float diff = 2 * wma1 - wma2
    
    wma(diff, sqrt_len)

// @function Jurik Moving Average (JMA).
// @param src The source series.
// @param length The length.
// @returns The calculated JMA.
export jma(series float src, simple int length) =>
    // Constants
    float beta = 0.45 * (length - 1) / (0.45 * (length - 1) + 2)
    float alpha = beta // Simplified JMA often sets alpha = beta
    
    // Persistent Variables
    var float tmp0 = na
    var float tmp1 = na
    var float tmp2 = na
    var float tmp3 = na
    var float tmp4 = na
    var float ma = na
    
    if not na(src)
        // Initialize on first valid bar
        if na(ma)
            tmp0 := src
            tmp1 := 0.0
            tmp2 := src
            tmp3 := 0.0
            tmp4 := 0.0
            ma := src
        else
            tmp0 := (1 - alpha) * src + alpha * tmp0
            tmp1 := (src - tmp0) * (1 - beta) + beta * tmp1
            tmp2 := tmp0 + tmp1
            tmp3 := (tmp2 - tmp4) * math.pow(1 - alpha, 2) + math.pow(alpha, 2) * tmp3
            tmp4 := tmp4 + tmp3
            ma := tmp4
    ma

// @function Jurik Moving Average (JMA).
// @param src The source series.
// @param length The length.
// @returns The calculated JMA.
export jma(series float src, series int length) =>
    // Constants
    float beta = 0.45 * (length - 1) / (0.45 * (length - 1) + 2)
    float alpha = beta // Simplified JMA often sets alpha = beta
    
    // Persistent Variables
    var float tmp0 = na
    var float tmp1 = na
    var float tmp2 = na
    var float tmp3 = na
    var float tmp4 = na
    var float ma = na
    
    if not na(src)
        // Initialize on first valid bar
        if na(ma)
            tmp0 := src
            tmp1 := 0.0
            tmp2 := src
            tmp3 := 0.0
            tmp4 := 0.0
            ma := src
        else
            tmp0 := (1 - alpha) * src + alpha * tmp0
            tmp1 := (src - tmp0) * (1 - beta) + beta * tmp1
            tmp2 := tmp0 + tmp1
            tmp3 := (tmp2 - tmp4) * math.pow(1 - alpha, 2) + math.pow(alpha, 2) * tmp3
            tmp4 := tmp4 + tmp3
            ma := tmp4
    ma

// @function Kaufman's Adaptive Moving Average (KAMA).
// @param src The source series.
// @param length The length.
// @param speed (float) Defines the Fast Period, standard Fast Period is 2.
// @returns The calculated KAMA.
export kama(series float src, simple int length, float speed = 2) =>
    var float ma = na
    //float fastAlpha = 2.0 / (2 + 1) //ORIG: 2
    float fastAlpha = 2.0 / (speed + 1)
    float slowAlpha = 2.0 / (30 + 1)
    
    if not na(src)
        // Manual volatility calculation to handle NAs
        float change_abs = math.abs(src - src[length])
        float volatility = 0.0
        for i = 0 to length - 1
            if not na(src[i]) and not na(src[i+1])
                volatility += math.abs(src[i] - src[i+1])
        
        if na(ma)
            ma := src
        else if volatility != 0
            float ratio = change_abs / volatility
            float smoothing = math.pow(ratio * (fastAlpha - slowAlpha) + slowAlpha, 2)
            ma := ma + smoothing * (src - ma)
    ma

// @function Kaufman's Adaptive Moving Average (KAMA).
// @param src The source series.
// @param length The length.
// @param speed (float) Defines the Fast Period, standard Fast Period is 2.
// @returns The calculated KAMA.
export kama(series float src, series int length, float speed = 2) =>
    var float ma = na
    //float fastAlpha = 2.0 / (2 + 1) //ORIG: 2
    float fastAlpha = 2.0 / (speed + 1)
    float slowAlpha = 2.0 / (30 + 1)
    
    if not na(src)
        // Manual volatility calculation to handle NAs
        float change_abs = math.abs(src - src[length])
        float volatility = 0.0
        for i = 0 to length - 1
            if not na(src[i]) and not na(src[i+1])
                volatility += math.abs(src[i] - src[i+1])
        
        if na(ma)
            ma := src
        else if volatility != 0
            float ratio = change_abs / volatility
            float smoothing = math.pow(ratio * (fastAlpha - slowAlpha) + slowAlpha, 2)
            ma := ma + smoothing * (src - ma)
    ma

// @function Kijun-sen (Base Line).
// @param src The source series.
// @param length The length.
// @returns The calculated Kijun-sen.
export kijun(series float src, simple int length) =>
    // ta.highest/lowest automatically skip NAs
    math.avg(ta.lowest(src, length), ta.highest(src, length))

// @function Kijun-sen (Base Line).
// @param src The source series.
// @param length The length.
// @returns The calculated Kijun-sen.
export kijun(series float src, series int length) =>
    // ta.highest/lowest automatically skip NAs
    math.avg(ta.lowest(src, length), ta.highest(src, length))

// @function Least Squares Moving Average (LSMA) calculated iteratively to ignore NAs.
// @param src The source series.
// @param length The length.
// @returns The calculated LSMA.
export lsma(series float src, simple int length) =>
    // y = mx + b, result is m*(length-1) + b (regression at current bar)
    float sum_x = 0.0
    float sum_y = 0.0
    float sum_xy = 0.0
    float sum_xx = 0.0
    int count = 0
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            // x is the index reversed (0 is current, length-1 is oldest)
            // To match linreg(offset=0), current bar is highest X
            float x = length - 1 - i
            sum_x += x
            sum_y += val
            sum_xy += x * val
            sum_xx += x * x
            count += 1
            
    if count > 1
        float m = (count * sum_xy - sum_x * sum_y) / (count * sum_xx - sum_x * sum_x)
        float b = (sum_y - m * sum_x) / count
        // Value at current bar (x = length - 1)
        m * (length - 1) + b
    else 
        na

// @function Least Squares Moving Average (LSMA) calculated iteratively to ignore NAs.
// @param src The source series.
// @param length The length.
// @returns The calculated LSMA.
export lsma(series float src, series int length) =>
    // y = mx + b, result is m*(length-1) + b (regression at current bar)
    float sum_x = 0.0
    float sum_y = 0.0
    float sum_xy = 0.0
    float sum_xx = 0.0
    int count = 0
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            // x is the index reversed (0 is current, length-1 is oldest)
            // To match linreg(offset=0), current bar is highest X
            float x = length - 1 - i
            sum_x += x
            sum_y += val
            sum_xy += x * val
            sum_xx += x * x
            count += 1
            
    if count > 1
        float m = (count * sum_xy - sum_x * sum_y) / (count * sum_xx - sum_x * sum_x)
        float b = (sum_y - m * sum_x) / count
        // Value at current bar (x = length - 1)
        m * (length - 1) + b
    else 
        na

// @function Leo Moving Average (LMA).
// @param src The source series.
// @param length The length.
// @returns The calculated LMA.
export lma(series float src, simple int length) =>
    2 * wma(src, length) - sma(src, length)

// @function Leo Moving Average (LMA).
// @param src The source series.
// @param length The length.
// @returns The calculated LMA.
export lma(series float src, series int length) =>
    2 * wma(src, length) - sma(src, length)

// @function McGinley Dynamic (MD).
// @param src The source series.
// @param length The length.
// @returns The calculated MD.
export md(series float src, simple int length) =>
    var float ma = na
    if not na(src)
        if na(ma)
            ma := src
        else
            float ratio = src / ma
            // Avoid division by zero and extreme values
            float factor = length * math.pow(math.max(0.01, ratio), 4)
            ma := ma + (src - ma) / factor
    ma

// @function McGinley Dynamic (MD).
// @param src The source series.
// @param length The length.
// @returns The calculated MD.
export md(series float src, series int length) =>
    var float ma = na
    if not na(src)
        if na(ma)
            ma := src
        else
            float ratio = src / ma
            // Avoid division by zero and extreme values
            float factor = length * math.pow(math.max(0.01, ratio), 4)
            ma := ma + (src - ma) / factor
    ma

// @function Modular Filter (MF).
// @param src The source series.
// @param length The length.
// @returns The calculated MF.
export mf(series float src, simple int length) =>
    float alpha = 2.0 / (length + 1)
    var float b = na
    var float c = na
    var float os = 0.0
    var float ma = na
    
    if not na(src)
        if na(b)
            b := src
            c := src
            ma := src
        else
            float b_prev = b
            float c_prev = c
            
            float feedback_b = alpha * src + (1 - alpha) * b_prev
            b := src > feedback_b ? src : feedback_b
            
            float feedback_c = alpha * src + (1 - alpha) * c_prev
            c := src < feedback_c ? src : feedback_c
            
            if src == b
                os := 1.0
            else if src == c
                os := 0.0
                
            float upper = 0.8 * b + 0.2 * c
            float lower = 0.8 * c + 0.2 * b
            
            ma := os * upper + (1 - os) * lower
    ma

// @function Modular Filter (MF).
// @param src The source series.
// @param length The length.
// @returns The calculated MF.
export mf(series float src, series int length) =>
    float alpha = 2.0 / (length + 1)
    var float b = na
    var float c = na
    var float os = 0.0
    var float ma = na
    
    if not na(src)
        if na(b)
            b := src
            c := src
            ma := src
        else
            float b_prev = b
            float c_prev = c
            
            float feedback_b = alpha * src + (1 - alpha) * b_prev
            b := src > feedback_b ? src : feedback_b
            
            float feedback_c = alpha * src + (1 - alpha) * c_prev
            c := src < feedback_c ? src : feedback_c
            
            if src == b
                os := 1.0
            else if src == c
                os := 0.0
                
            float upper = 0.8 * b + 0.2 * c
            float lower = 0.8 * c + 0.2 * b
            
            ma := os * upper + (1 - os) * lower
    ma

// @function Moving Median (MM).
// @param src The source series.
// @param length The length.
// @returns The calculated MM.
export mm(series float src, simple int length) =>
    ta.percentile_nearest_rank(src, length, 50)

// @function Moving Median (MM).
// @param src The source series.
// @param length The length.
// @returns The calculated MM.
export mm(series float src, series int length) =>
    ta.percentile_nearest_rank(src, length, 50)

// @function Smoothed Moving Average (SMMA).
// @param src The source series.
// @param length The length.
// @returns The calculated SMMA.
export smma(series float src, simple int length) =>
    var float ma = na
    if not na(src)
        if na(ma)
            ma := sma(src, length) // Initialize with SMA
        else
            ma := (ma * (length - 1) + src) / length
    ma

// @function Smoothed Moving Average (SMMA).
// @param src The source series.
// @param length The length.
// @returns The calculated SMMA.
export smma(series float src, series int length) =>
    var float ma = na
    if not na(src)
        if na(ma)
            ma := sma(src, length) // Initialize with SMA
        else
            ma := (ma * (length - 1) + src) / length
    ma

// @function Shapeshifting Moving Average (SSMA).
// @param src The source series.
// @param length The length.
// @returns The calculated SSMA.
export ssma(series float src, simple int length) =>
    bool ssma_smooth = false
    float ssma_pow = 4.0
    float sum = 0.0
    float w_sum = 0.0
    
    float alpha = ssma_smooth ? 2.0 : 1.0
    float power = ssma_smooth ? ssma_pow - ssma_pow % 2 : ssma_pow
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            float x = i / math.max(1, length - 1)
            float n = ssma_smooth ? -1 + x * 2 : x
            float w = 1 - 2 * math.pow(n, alpha) / (math.pow(n, power) + 1)
            
            sum += val * w
            w_sum += w
            
    w_sum != 0 ? sum / w_sum : na

// @function Shapeshifting Moving Average (SSMA).
// @param src The source series.
// @param length The length.
// @returns The calculated SSMA.
export ssma(series float src, series int length) =>
    bool ssma_smooth = false
    float ssma_pow = 4.0
    float sum = 0.0
    float w_sum = 0.0
    
    float alpha = ssma_smooth ? 2.0 : 1.0
    float power = ssma_smooth ? ssma_pow - ssma_pow % 2 : ssma_pow
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            float x = i / math.max(1, length - 1)
            float n = ssma_smooth ? -1 + x * 2 : x
            float w = 1 - 2 * math.pow(n, alpha) / (math.pow(n, power) + 1)
            
            sum += val * w
            w_sum += w
            
    w_sum != 0 ? sum / w_sum : na

// @function Sine Weighted Moving Average (SWMA).
// @param src The source series.
// @param length The length.
// @returns The calculated SWMA.
export swma(series float src, simple int length) =>
    float sum = 0.0
    float w_sum = 0.0
    
    for i = 0 to length - 1
        float val = src[i]
        if not na(val)
            float w = math.sin((i + 1) * math.pi / (length + 1))
            sum += val * w
            w_sum += w
            
    w_sum != 0 ? sum / w_sum : na

// @function Sine Weighted Moving Average (SWMA).
