//@version=6
strategy(
     title = "Good luck!",
     shorttitle = "Good luck!",
     overlay = true,
     initial_capital = 10000,
     pyramiding = 2,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     max_lines_count = 500,
     max_labels_count = 500,
     max_boxes_count = 500
)

//─────────────────────────────────────────────
// SETTINGS
//─────────────────────────────────────────────
grp_ma = "── EMA SETTINGS ──"

ma_fast = input.int(9, "Fast EMA", minval = 2, maxval = 50, group = grp_ma)
ma_mid  = input.int(21, "Medium EMA", minval = 5, maxval = 100, group = grp_ma)
ma_slow = input.int(55, "Slow EMA", minval = 10, maxval = 200, group = grp_ma)

grp_filter = "── TREND FILTER ──"

use_trend_filter = input.bool(true, "Use Trend Filter", group = grp_filter)

grp_risk = "── RISK ──"

use_atr_stop = input.bool(true, "Use ATR Stop", group = grp_risk)
atr_len      = input.int(14, "ATR Length", group = grp_risk)
atr_mult     = input.float(1.5, "ATR Multiplier", step = 0.1, group = grp_risk)

grp_vwap = "── VWAP ──"

show_vwap = input.bool(true, "Show VWAP", group = grp_vwap)

//─────────────────────────────────────────────
// EMA
//─────────────────────────────────────────────
ema_fast = ta.ema(close, ma_fast)
ema_mid  = ta.ema(close, ma_mid)
ema_slow = ta.ema(close, ma_slow)
ema200   = ta.ema(close, 200)

vwap_line = ta.vwap(hlc3)

atr = ta.atr(atr_len)

//─────────────────────────────────────────────
// TREND FILTER
//─────────────────────────────────────────────
bull_trend = ema_fast > ema_slow
bear_trend = ema_fast < ema_slow

//─────────────────────────────────────────────
// ENTRY CONDITIONS
//─────────────────────────────────────────────
long_entry =
     close > ema_fast and
     close[1] <= ema_fast[1] and
     (not use_trend_filter or bull_trend)

short_entry =
     close < ema_fast and
     close[1] >= ema_fast[1] and
     (not use_trend_filter or bear_trend)

//─────────────────────────────────────────────
// EXIT CONDITIONS
//─────────────────────────────────────────────
long_exit =
     close < ema_slow

short_exit =
     close > ema_slow

//─────────────────────────────────────────────
// STRATEGY EXECUTION
//─────────────────────────────────────────────
if long_entry
    strategy.close("SHORT")
    strategy.entry("LONG", strategy.long)

if short_entry
    strategy.close("LONG")
    strategy.entry("SHORT", strategy.short)

if strategy.position_size > 0 and long_exit
    strategy.close("LONG")

if strategy.position_size < 0 and short_exit
    strategy.close("SHORT")

//─────────────────────────────────────────────
// ATR STOP
//─────────────────────────────────────────────
long_stop  = strategy.position_avg_price - atr * atr_mult
short_stop = strategy.position_avg_price + atr * atr_mult

if use_atr_stop
    strategy.exit("LONG ATR STOP", from_entry = "LONG", stop = long_stop)
    strategy.exit("SHORT ATR STOP", from_entry = "SHORT", stop = short_stop)

//─────────────────────────────────────────────
// CANDLE COLORS
//─────────────────────────────────────────────
bullish =
     close > ema_fast and
     ema_fast > ema_fast[1]

bearish =
     close < ema_fast and
     ema_fast < ema_fast[1]

barcolor(
     bullish ? color.rgb(26, 255, 0) :
     bearish ? color.rgb(255, 0, 0) :
     color.gray
)

//─────────────────────────────────────────────
// PLOTS
//─────────────────────────────────────────────
plot(
     ema_fast,
     title = "EMA FAST",
     color = color.new(#787b86, 31), style = plot.style_stepline, offset = 1,
     linewidth = 1
)

plot(
     ema_mid,
     title = "EMA MID",
     color = color.new(#a49400, 20), style = plot.style_circles,
     linewidth = 1
)

plot(
     ema_slow,
     title = "EMA SLOW",
     color = color.new(#ae0000, 20), style = plot.style_circles,
     linewidth = 1
)

plot(
     ema200,
     title = "EMA 200",
     color = color.new(color.blue, 0),
     linewidth = 1
)

plot(
     show_vwap ? vwap_line : na,
     title = "VWAP",
     color = color.purple,
     linewidth = 1, style = plot.style_circles
)

//─────────────────────────────────────────────
// ALERTS
//─────────────────────────────────────────────
alertcondition(
     long_entry,
     title = "LONG ENTRY",
     message = "LONG ENTRY"
)

alertcondition(
     short_entry,
     title = "SHORT ENTRY",
     message = "SHORT ENTRY"
)

alertcondition(
     long_exit,
     title = "LONG EXIT",
     message = "LONG EXIT"
)

alertcondition(
     short_exit,
     title = "SHORT EXIT",
     message = "SHORT EXIT"
)

//─────────────────────────────────────────────
// INFO PANEL
//─────────────────────────────────────────────
var table dashboard = table.new(
     position.top_right,
     2,
     6,
     bgcolor = color.new(color.black, 75),
     border_width = 1
)

if barstate.islast

    table.cell(
         dashboard,
         0,
         0,
         "Good luck!",
         text_color = color.rgb(246, 255, 0),
         bgcolor = color.rgb(0, 46, 84)
    )

    table.cell(
         dashboard,
         1,
         0,
         timeframe.period,
         text_color = color.yellow,
         bgcolor = color.rgb(0, 54, 98)
    )

    table.cell(dashboard, 0, 1, "Trend")

    table.cell(
         dashboard,
         1,
         1,
         bull_trend ? "BULL" :
         bear_trend ? "BEAR" :
         "RANGE",
         text_color =
              bull_trend ? color.lime :
              bear_trend ? color.red :
              color.gray
    )

    table.cell(dashboard, 0, 2, "ATR")

    table.cell(
         dashboard,
         1,
         2,
         str.tostring(atr, "#.00")
    )

    table.cell(dashboard, 0, 3, "Position")

    table.cell(
         dashboard,
         1,
         3,
         strategy.position_size > 0 ? "LONG" :
         strategy.position_size < 0 ? "SHORT" :
         "FLAT",
         text_color =
              strategy.position_size > 0 ? color.lime :
              strategy.position_size < 0 ? color.red :
              color.gray
    )

//─────────────────────────────────────────────
// FAIR VALUE GAPS
//─────────────────────────────────────────────
gap_extend = input.int(20, "Gap Extension")

bull_gap = bar_index > 2 and low > high[2]
bear_gap = bar_index > 2 and high < low[2]

if bull_gap
    box.new(
         left = bar_index - 2,
         top = low,
         right = bar_index + gap_extend,
         bottom = high[2],
         bgcolor = color.new(color.green, 80),
         border_color = na
    )

if bear_gap
    box.new(
         left = bar_index - 2,
         top = low[2],
         right = bar_index + gap_extend,
         bottom = high,
         bgcolor = color.new(color.red, 80),
         border_color = na
    )

alertcondition(
     bull_gap,
     title = "Bullish Gap",
     message = "Bullish imbalance"
)

alertcondition(
     bear_gap,
     title = "Bearish Gap",
     message = "Bearish imbalance"
)

//─────────────────────────────────────────────
// SUPPLY & DEMAND
//─────────────────────────────────────────────
swing_length = input.int(10, "Swing Length")
history      = input.int(20, "History")
box_width    = input.float(2.5, "Box Width")

swing_high = ta.pivothigh(high, swing_length, swing_length)
swing_low  = ta.pivotlow(low, swing_length, swing_length)

var supply_boxes = array.new_box()
var demand_boxes = array.new_box()

if not na(swing_high)

    top = swing_high
    bottom = swing_high - atr * (box_width / 10)

    bx =
         box.new(
              left = bar_index[swing_length],
              top = top,
              right = bar_index + 20,
              bottom = bottom,
              bgcolor = color.new(#787b86, 67),
              border_color = color.new(#ffffff, 100),
              extend = extend.right
         )

    array.push(supply_boxes, bx)

if not na(swing_low)

    top = swing_low + atr * (box_width / 10)
    bottom = swing_low

    bx =
         box.new(
              left = bar_index[swing_length],
              top = top,
              right = bar_index + 20,
              bottom = bottom,
              bgcolor = color.new(#00bbd4, 81),
              border_color = color.new(#ffffff, 100),
              extend = extend.right
         )

    array.push(demand_boxes, bx)

//─────────────────────────────────────────────
// REMOVE BROKEN SUPPLY ZONES
//─────────────────────────────────────────────
if array.size(supply_boxes) > 0

    for i = array.size(supply_boxes) - 1 to 0

        bx = array.get(supply_boxes, i)

        if not na(bx)

            top_level = box.get_top(bx)

            if close > top_level

                box.delete(bx)
                array.remove(supply_boxes, i)

//─────────────────────────────────────────────
// REMOVE BROKEN DEMAND ZONES
//─────────────────────────────────────────────
if array.size(demand_boxes) > 0

    for i = array.size(demand_boxes) - 1 to 0

        bx = array.get(demand_boxes, i)

        if not na(bx)

            bottom_level = box.get_bottom(bx)

            if close < bottom_level

                box.delete(bx)
                array.remove(demand_boxes, i)

