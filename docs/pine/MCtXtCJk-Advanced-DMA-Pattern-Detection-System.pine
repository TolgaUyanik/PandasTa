//@version=5
indicator("Advanced DMA Pattern Detection System", overlay=true, max_labels_count=50)

// ═══════════════════════════════════════════════════════════════════════════════════
// INPUT CONTROLS
// ═══════════════════════════════════════════════════════════════════════════════════

// Master Controls
master_enable = input.bool(true, "🔥 Enable Pattern Detection System", group="🎛️ Master Controls")
show_basic_dmas = input.bool(true, "Show Basic DMAs", group="🎛️ Master Controls")

// DMA Toggles
show_5dma = input.bool(true, "Show 5 DMA", group="📊 DMA Display")
show_10dma = input.bool(true, "Show 10 DMA", group="📊 DMA Display")
show_20dma = input.bool(true, "Show 20 DMA", group="📊 DMA Display")
show_50dma = input.bool(true, "Show 50 DMA", group="📊 DMA Display")
show_100dma = input.bool(true, "Show 100 DMA", group="📊 DMA Display")
show_200dma = input.bool(true, "Show 200 DMA", group="📊 DMA Display")

// Pattern Detection Controls
show_pattern_table = input.bool(true, "📋 Show Pattern Table", group="🔍 Pattern Detection")
table_position = input.string("Top Left", "📍 Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Middle Left", "Middle Right"], group="🔍 Pattern Detection")
show_chart_alerts = input.bool(true, "⚠️ Show Chart Alerts", group="🔍 Pattern Detection")
show_background_color = input.bool(true, "🎨 Color Background by Pattern", group="🔍 Pattern Detection")
show_historical_validation = input.bool(true, "📈 Track Historical Success", group="🔍 Pattern Detection")

// DMA Label Controls
show_dma_labels = input.bool(true, "🏷️ Show DMA Labels", group="📊 DMA Display")
label_offset = input.int(10, "Label Offset (bars)", minval=1, maxval=50, group="📊 DMA Display")

// Alert Sensitivity
alert_sensitivity = input.string("Medium", "Alert Sensitivity", options=["Conservative", "Medium", "Aggressive"], group="🔔 Alert Settings")
min_probability_change = alert_sensitivity == "Conservative" ? 30 : alert_sensitivity == "Medium" ? 20 : 10

// ═══════════════════════════════════════════════════════════════════════════════════
// DMA CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════════

dma_5 = ta.sma(close, 5)
dma_10 = ta.sma(close, 10)
dma_20 = ta.sma(close, 20)
dma_50 = ta.sma(close, 50)
dma_100 = ta.sma(close, 100)
dma_200 = ta.sma(close, 200)

// DMA Colors
color_5 = color.new(color.purple, 0)
color_10 = color.new(color.blue, 0)
color_20 = color.new(color.green, 0)
color_50 = color.new(color.orange, 0)
color_100 = color.new(color.red, 0)
color_200 = color.new(color.maroon, 0)

// Plot Basic DMAs
plot(show_basic_dmas and show_5dma ? dma_5 : na, "5 DMA", color=color_5, linewidth=1)
plot(show_basic_dmas and show_10dma ? dma_10 : na, "10 DMA", color=color_10, linewidth=1)
plot(show_basic_dmas and show_20dma ? dma_20 : na, "20 DMA", color=color_20, linewidth=2)
plot(show_basic_dmas and show_50dma ? dma_50 : na, "50 DMA", color=color_50, linewidth=2)
plot(show_basic_dmas and show_100dma ? dma_100 : na, "100 DMA", color=color_100, linewidth=2)
plot(show_basic_dmas and show_200dma ? dma_200 : na, "200 DMA", color=color_200, linewidth=3)

// Create DMA labels on the last bar
if show_dma_labels and show_basic_dmas and barstate.islast
    if show_5dma
        label.new(bar_index + label_offset, dma_5, "5 DMA\n(Day Trading)", 
                  color=color_5, textcolor=color.white, size=size.small, 
                  style=label.style_label_left)
    
    if show_10dma
        label.new(bar_index + label_offset, dma_10, "10 DMA\n(Short-term)", 
                  color=color_10, textcolor=color.white, size=size.small, 
                  style=label.style_label_left)
    
    if show_20dma
        label.new(bar_index + label_offset, dma_20, "20 DMA\n(Swing Trading)", 
                  color=color_20, textcolor=color.white, size=size.small, 
                  style=label.style_label_left)
    
    if show_50dma
        label.new(bar_index + label_offset, dma_50, "50 DMA\n(Medium-term)", 
                  color=color_50, textcolor=color.white, size=size.small, 
                  style=label.style_label_left)
    
    if show_100dma
        label.new(bar_index + label_offset, dma_100, "100 DMA\n(Intermediate)", 
                  color=color_100, textcolor=color.white, size=size.small, 
                  style=label.style_label_left)
    
    if show_200dma
        label.new(bar_index + label_offset, dma_200, "200 DMA\n(Bull/Bear Line)", 
                  color=color_200, textcolor=color.white, size=size.normal, 
                  style=label.style_label_left)

// ═══════════════════════════════════════════════════════════════════════════════════
// PATTERN DETECTION ENGINE
// ═══════════════════════════════════════════════════════════════════════════════════

// Price Position Analysis
price_above_5 = close > dma_5
price_above_10 = close > dma_10
price_above_20 = close > dma_20
price_above_50 = close > dma_50
price_above_100 = close > dma_100
price_above_200 = close > dma_200

above_count = (price_above_5 ? 1 : 0) + (price_above_10 ? 1 : 0) + (price_above_20 ? 1 : 0) + 
              (price_above_50 ? 1 : 0) + (price_above_100 ? 1 : 0) + (price_above_200 ? 1 : 0)

// DMA Stacking Analysis (Perfect Bull = all in ascending order)
perfect_bull_stack = dma_5 > dma_10 and dma_10 > dma_20 and dma_20 > dma_50 and dma_50 > dma_100 and dma_100 > dma_200
perfect_bear_stack = dma_200 > dma_100 and dma_100 > dma_50 and dma_50 > dma_20 and dma_20 > dma_10 and dma_10 > dma_5

// Cross Detection
golden_cross = ta.crossover(dma_50, dma_200)
death_cross = ta.crossunder(dma_50, dma_200)
recent_golden = ta.barssince(golden_cross) <= 10
recent_death = ta.barssince(death_cross) <= 10

// Multiple Cross Detection (choppy market indicator)
cross_20_50 = ta.cross(dma_20, dma_50)
cross_50_100 = ta.cross(dma_50, dma_100)
cross_10_20 = ta.cross(dma_10, dma_20)
recent_crosses = (ta.barssince(cross_20_50) <= 5 ? 1 : 0) + (ta.barssince(cross_50_100) <= 5 ? 1 : 0) + (ta.barssince(cross_10_20) <= 5 ? 1 : 0)

// Volume Confirmation
vol_avg = ta.sma(volume, 20)
high_volume = volume > vol_avg * 1.5

// ═══════════════════════════════════════════════════════════════════════════════════
// PATTERN CLASSIFICATION & PROBABILITY ENGINE
// ═══════════════════════════════════════════════════════════════════════════════════

var float pattern_probability = 50.0
var string current_pattern = "Neutral"
var color pattern_color = color.gray

// Pattern Detection Logic
if master_enable
    // INSTITUTIONAL ACCUMULATION (85-95% Bullish)
    if above_count >= 5 and perfect_bull_stack and high_volume
        pattern_probability := 95.0
        current_pattern := "🚀 Institutional Accumulation"
        pattern_color := color.new(color.lime, 0)
    
    // STRONG BULLISH SETUP (80-90% Bullish)
    else if above_count >= 4 and (perfect_bull_stack or recent_golden)
        pattern_probability := 85.0
        current_pattern := "📈 Strong Bullish Setup"
        pattern_color := color.new(color.green, 0)
    
    // DISTRIBUTION PHASE (85-95% Bearish)
    else if above_count <= 1 and perfect_bear_stack and high_volume
        pattern_probability := 5.0  // 5% bullish = 95% bearish
        current_pattern := "💀 Distribution Phase"
        pattern_color := color.new(color.red, 0)
    
    // STRONG BEARISH SETUP (10-20% Bullish = 80-90% Bearish)
    else if above_count <= 2 and (perfect_bear_stack or recent_death)
        pattern_probability := 15.0
        current_pattern := "📉 Strong Bearish Setup"
        pattern_color := color.new(color.maroon, 0)
    
    // BULL TRANSITION (60-80% Bullish)
    else if above_count >= 4 and close > dma_200 and not perfect_bull_stack
        pattern_probability := 70.0
        current_pattern := "🔄 Bull Transition"
        pattern_color := color.new(color.aqua, 0)
    
    // BEAR TRANSITION (20-40% Bullish = 60-80% Bearish)
    else if above_count <= 2 and close < dma_200 and not perfect_bear_stack
        pattern_probability := 30.0
        current_pattern := "🔄 Bear Transition"
        pattern_color := color.new(color.orange, 0)
    
    // CHOPPY/AVOID (20-50% - Unreliable)
    else if recent_crosses >= 2 or (above_count == 3 and recent_crosses >= 1)
        pattern_probability := 40.0
        current_pattern := "⚠️ Choppy Market - AVOID"
        pattern_color := color.new(color.yellow, 0)
    
    // NEUTRAL/TRANSITIONAL
    else
        pattern_probability := 50.0
        current_pattern := "😐 Neutral/Transitional"
        pattern_color := color.new(color.gray, 0)

// Confidence Level
confidence_level = pattern_probability <= 50 and pattern_probability >= 20 ? "🔴 Low" : 
                  pattern_probability > 50 and pattern_probability <= 80 ? "🟡 Medium" : "🟢 High"

// ═══════════════════════════════════════════════════════════════════════════════════
// HISTORICAL VALIDATION SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════════

var array<float> pattern_history = array.new<float>()
var array<bool> pattern_success = array.new<bool>()
var int last_pattern_bar = 0

// Track pattern changes
pattern_changed = current_pattern != current_pattern[1] and barstate.isconfirmed

// Store historical data (simplified for demo)
if show_historical_validation and pattern_changed and bar_index - last_pattern_bar > 10
    array.push(pattern_history, pattern_probability)
    // Simplified success criteria: pattern direction matches price movement over next 10 bars
    future_return = close[1] > close[11] // Look back to avoid future leak
    pattern_was_bullish = pattern_probability[11] > 50
    success = pattern_was_bullish == future_return
    array.push(pattern_success, success)
    
    // Keep only last 20 patterns
    if array.size(pattern_history) > 20
        array.shift(pattern_history)
        array.shift(pattern_success)
    
    last_pattern_bar := bar_index

// Calculate success rate
success_count = 0
total_patterns = array.size(pattern_success)
if total_patterns > 0
    for i = 0 to total_patterns - 1
        if array.get(pattern_success, i)
            success_count += 1

success_rate = total_patterns > 0 ? math.round(success_count * 100 / total_patterns) : 0

// ═══════════════════════════════════════════════════════════════════════════════════
// ALERT SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════════

// Significant change detection
prob_change = math.abs(pattern_probability - pattern_probability[1])
significant_change = prob_change >= min_probability_change

// Chart Alerts
if show_chart_alerts and master_enable and significant_change and barstate.isconfirmed
    if pattern_probability >= 80
        label.new(bar_index, high * 1.02, "🚨 HIGH CONFIDENCE\n" + current_pattern + "\n" + str.tostring(pattern_probability, "##") + "%", 
                  color=pattern_color, textcolor=color.white, size=size.normal, style=label.style_label_down)
    else if pattern_probability <= 20
        label.new(bar_index, low * 0.98, "🚨 HIGH CONFIDENCE\n" + current_pattern + "\n" + str.tostring(100-pattern_probability, "##") + "% Bearish", 
                  color=pattern_color, textcolor=color.white, size=size.normal, style=label.style_label_up)

// Background Color
bgcolor(show_background_color and master_enable ? color.new(pattern_color, 90) : na)

// ═══════════════════════════════════════════════════════════════════════════════════
// PATTERN INFORMATION TABLE
// ═══════════════════════════════════════════════════════════════════════════════════

if show_pattern_table and master_enable and barstate.islast
    // Convert table position string to position constant
    pos = table_position == "Top Left" ? position.top_left :
          table_position == "Top Right" ? position.top_right :
          table_position == "Bottom Left" ? position.bottom_left :
          table_position == "Bottom Right" ? position.bottom_right :
          table_position == "Middle Left" ? position.middle_left : position.middle_right
    
    var table pattern_table = table.new(pos, 2, 8, bgcolor=color.white, border_width=2, border_color=color.black)
    
    // Headers
    table.cell(pattern_table, 0, 0, "🎯 DMA PATTERN ANALYSIS", text_color=color.white, bgcolor=color.black, text_size=size.normal)
    table.cell(pattern_table, 1, 0, "VALUES", text_color=color.white, bgcolor=color.black, text_size=size.normal)
    
    // Current Pattern
    table.cell(pattern_table, 0, 1, "Current Pattern", text_color=color.black, bgcolor=color.silver)
    table.cell(pattern_table, 1, 1, current_pattern, text_color=color.white, bgcolor=pattern_color, text_size=size.small)
    
    // Probability
    table.cell(pattern_table, 0, 2, "Probability", text_color=color.black, bgcolor=color.silver)
    prob_display = pattern_probability > 50 ? str.tostring(pattern_probability, "##") + "% Bullish" : str.tostring(100-pattern_probability, "##") + "% Bearish"
    table.cell(pattern_table, 1, 2, prob_display, text_color=color.black, bgcolor=color.white)
    
    // Confidence
    table.cell(pattern_table, 0, 3, "Confidence", text_color=color.black, bgcolor=color.silver)
    table.cell(pattern_table, 1, 3, confidence_level, text_color=color.black, bgcolor=color.white)
    
    // Price vs DMAs
    table.cell(pattern_table, 0, 4, "Above DMAs", text_color=color.black, bgcolor=color.silver)
    table.cell(pattern_table, 1, 4, str.tostring(above_count) + "/6", text_color=color.black, bgcolor=color.white)
    
    // Key Level
    key_level = close > dma_200 ? dma_200 : dma_200
    table.cell(pattern_table, 0, 5, "Key Level (200 DMA)", text_color=color.black, bgcolor=color.silver)
    table.cell(pattern_table, 1, 5, str.tostring(key_level, "#.##"), text_color=color.black, bgcolor=color.white)
    
    // Historical Success Rate
    if show_historical_validation and total_patterns > 5
        table.cell(pattern_table, 0, 6, "Success Rate", text_color=color.black, bgcolor=color.silver)
        table.cell(pattern_table, 1, 6, str.tostring(success_rate) + "% (" + str.tostring(total_patterns) + " signals)", text_color=color.black, bgcolor=color.white)
    
    // Next Action
    next_action = pattern_probability >= 80 ? "🟢 STRONG BUY ZONE" : 
                 pattern_probability <= 20 ? "🔴 STRONG SELL ZONE" :
                 pattern_probability >= 60 ? "🟡 WAIT FOR PULLBACK" :
                 pattern_probability <= 40 ? "🟡 WAIT FOR BOUNCE" : "😐 WAIT FOR CLARITY"
    
    table.cell(pattern_table, 0, 7, "Next Action", text_color=color.black, bgcolor=color.silver)
    table.cell(pattern_table, 1, 7, next_action, text_color=color.white, bgcolor=pattern_color, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════════
// ALERTS FOR EXTERNAL SYSTEMS
// ═══════════════════════════════════════════════════════════════════════════════════

// High confidence alerts
alertcondition(pattern_probability >= 85 and significant_change, "🚀 High Confidence Bullish", "High Confidence Bullish Pattern: {{plot(\"current_pattern\")}}")
alertcondition(pattern_probability <= 15 and significant_change, "💀 High Confidence Bearish", "High Confidence Bearish Pattern: {{plot(\"current_pattern\")}}")
alertcondition(golden_cross, "Golden Cross", "Golden Cross Detected - 50 DMA crossed above 200 DMA")
alertcondition(death_cross, "Death Cross", "Death Cross Detected - 50 DMA crossed below 200 DMA")