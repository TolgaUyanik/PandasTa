//@version=5
indicator("Buy Sell Magic Rework", overlay=true)

// === INPUTS ===
len = input.int(14, "ZigZag Period", minval=1)
sar_start = input.float(0.02, "SAR Start", minval=0.001)
sar_increment = input.float(0.02, "SAR Increment", minval=0.001)
sar_max = input.float(0.2, "SAR Max", minval=0.01)
useZigZag = input.bool(false, "Use ZigZag Filter")

// === PARABOLIC SAR ===
sar = ta.sar(sar_start, sar_increment, sar_max)
plot(sar, "Parabolic SAR", style=plot.style_cross, color=color.gray)

// === ЧИСТЫЙ SAR FLIP ===
sellSar = sar > close and sar[1] < close[1]
buySar  = sar < close and sar[1] > close[1]

// === ZIGZAG PIVOTS ===
ph_raw = ta.pivothigh(high, len, len)
pl_raw = ta.pivotlow(low, len, len)

// === ЗИГЗАГ ЛОГИКА ===
var int lastDir = 0  // -1 sell, 1 buy

var float pH = na
var float pL = na

if useZigZag
    pH := na
    pL := na
    if not na(ph_raw) and lastDir != -1
        pH := ph_raw
        lastDir := -1
    if not na(pl_raw) and lastDir != 1
        pL := pl_raw
        lastDir := 1

sell = useZigZag ? not na(pH) : sellSar
buy  = useZigZag ? not na(pL) : buySar

// === PLOTS ===
plotshape(sell, style=shape.arrowdown, location=location.abovebar, color=color.red, size=size.small)
plotshape(buy,  style=shape.arrowup,   location=location.belowbar, color=color.green, size=size.small)
