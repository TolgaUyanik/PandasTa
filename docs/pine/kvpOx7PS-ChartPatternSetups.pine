//@version=6
library('ChartPatternSetups', overlay = true)

// @function Detects a Symmetrical Triangle (Bullish or Bearish) and provides trade levels.
// @param lookback Number of bars to look back for pivots.
// @returns Tuple of (isBullish, isBearish, entry, sl, tp).
export detectSymmetricalTriangle(int lookback) =>
    // Find pivot highs and lows
    pivotHigh = ta.pivothigh(high, lookback, lookback)
    pivotLow = ta.pivotlow(low, lookback, lookback)

    // Check for converging trendlines (higher lows, lower highs)
    higherLows = ta.rising(low, lookback)
    lowerHighs = ta.falling(high, lookback)
    isConverging = higherLows and lowerHighs

    // Detect breakout
    breakoutUp = ta.crossover(close, pivotHigh[lookback])
    breakoutDown = ta.crossunder(close, pivotLow[lookback])

    // Trade levels for bullish breakout
    float entryBull = breakoutUp ? close : na
    float slBull = breakoutUp ? pivotLow[lookback] : na
    float tpBull = breakoutUp ? close + close - pivotLow[lookback] : na

    // Trade levels for bearish breakout
    float entryBear = breakoutDown ? close : na
    float slBear = breakoutDown ? pivotHigh[lookback] : na
    float tpBear = breakoutDown ? close - (pivotHigh[lookback] - close) : na

    // Return results
    [breakoutUp and isConverging, breakoutDown and isConverging, entryBull, slBull, tpBull, entryBear, slBear, tpBear]

// @function Detects an Ascending Triangle (Bullish) and provides trade levels.
// @param lookback Number of bars to look back for pivots.
// @returns Tuple of (isDetected, entry, sl, tp).
export detectAscendingTriangle(int lookback) =>
    // Flat resistance (pivot highs at similar levels)
    pivotHigh = ta.pivothigh(high, lookback, lookback)
    resistance = pivotHigh[lookback]
    flatResistance = math.abs(high - resistance) < ta.atr(14) * 0.5

    // Rising support (higher lows)
    higherLows = ta.rising(low, lookback)

    // Breakout above resistance
    breakoutUp = ta.crossover(close, resistance)

    // Trade levels
    float entry = breakoutUp ? close : na
    float sl = breakoutUp ? ta.lowest(low, lookback) : na
    float tp = breakoutUp ? close + close - sl : na

    [breakoutUp and flatResistance and higherLows, entry, sl, tp]

// @function Detects a Descending Triangle (Bearish) and provides trade levels.
// @param lookback Number of bars to look back for pivots.
// @returns Tuple of (isDetected, entry, sl, tp).
export detectDescendingTriangle(int lookback) =>
    // Flat support (pivot lows at similar levels)
    pivotLow = ta.pivotlow(low, lookback, lookback)
    support = pivotLow[lookback]
    flatSupport = math.abs(low - support) < ta.atr(14) * 0.5

    // Declining resistance (lower highs)
    lowerHighs = ta.falling(high, lookback)

    // Breakout below support
    breakoutDown = ta.crossunder(close, support)

    // Trade levels
    float entry = breakoutDown ? close : na
    float sl = breakoutDown ? ta.highest(high, lookback) : na
    float tp = breakoutDown ? close - (sl - close) : na

    [breakoutDown and flatSupport and lowerHighs, entry, sl, tp]

// @function Detects a Falling Wedge (Bullish) and provides trade levels.
// @param lookback Number of bars to look back for pivots.
// @returns Tuple of (isDetected, entry, sl, tp).
export detectFallingWedge(int lookback) =>
    // Downward-sloping converging trendlines
    lowerHighs = ta.falling(high, lookback)
    lowerLows = ta.falling(low, lookback)
    isConverging = lowerHighs and lowerLows and (ta.rising(low, lookback / 2) or ta.falling(high, lookback / 2))

    // Breakout upward
    pivotHigh = ta.pivothigh(high, lookback, lookback)
    breakoutUp = ta.crossover(close, pivotHigh[lookback])

    // Trade levels
    float entry = breakoutUp ? close : na
    float sl = breakoutUp ? ta.lowest(low, lookback) : na
    float tp = breakoutUp ? close + close - sl : na

    [breakoutUp and isConverging, entry, sl, tp]

// @function Detects a Rising Wedge (Bearish) and provides trade levels.
// @param lookback Number of bars to look back for pivots.
// @returns Tuple of (isDetected, entry, sl, tp).
export detectRisingWedge(int lookback) =>
    // Upward-sloping converging trendlines
    higherHighs = ta.rising(high, lookback)
    higherLows = ta.rising(low, lookback)
    isConverging = higherHighs and higherLows and (ta.falling(high, lookback / 2) or ta.rising(low, lookback / 2))

    // Breakout downward
    pivotLow = ta.pivotlow(low, lookback, lookback)
    breakoutDown = ta.crossunder(close, pivotLow[lookback])

    // Trade levels
    float entry = breakoutDown ? close : na
    float sl = breakoutDown ? ta.highest(high, lookback) : na
    float tp = breakoutDown ? close - (sl - close) : na

    [breakoutDown and isConverging, entry, sl, tp]
