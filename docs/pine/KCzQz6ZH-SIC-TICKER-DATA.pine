// =============================================================================
// ULTRA-FAST BULK DATA LOADING (Alternative for very large datasets)
// =============================================================================

// @function Load data from pre-formatted string - FASTEST method for large datasets
// @param store The DataStore object
// @param tickerData Pre-formatted ticker data as "TICKER:SIC:INDUSTRY|TICKER:SIC:INDUSTRY|..."
// @returns void
loadBulkData(DataStore store, string tickerData) =>
    // Clear existing maps
    map.clear(store.tickerToSic)
    map.clear(store.tickerToIndustry)
    map.clear(store.sicToIndustry)
    map.clear(store.sicToTickers)
    map.clear(store.industryToTickers)
    
    // Split by entries (using | as separator for speed)
    entries = str.split(tickerData, "|")
    
    // Process each entry in optimized way
    for i = 0 to array.size(entries) - 1
        entry = array.get(entries, i)
        parts = str.split(entry, ":")
        
        if array.size(parts) == 3
            ticker = array.get(parts, 0)
            sic = array.get(parts, 1)
            industry = array.get(parts, 2)
            
            // Direct map operations - fastest approach
            map.put(store.tickerToSic, ticker, sic)
            map.put(store.tickerToIndustry, ticker, industry)
            map.put(store.sicToIndustry, sic, industry)
            
            // Update aggregated ticker lists
            existingSicTickers = map.get(store.sicToTickers, sic)
            existingIndustryTickers = map.get(store.industryToTickers, industry)
            
            map.put(store.sicToTickers, sic, na(existingSicTickers) ? ticker : existingSicTickers + "," + ticker)
            map.put(store.industryToTickers, industry, na(existingIndustryTickers) ? ticker : existingIndustryTickers + "," + ticker)

// =============================================================================
// MAIN INITIALIZATION FUNCTION - OPTIMIZED
// =============================================================================

// @function Create and initialize a new DataStore with all data - OPTIMIZED
// @returns Initialized DataStore object
export createDataStore() =>
    store = DataStore.new(map.new<string, string>(), map.new<string, string>(), map.new<string, string>(), map.new<string, string>(), map.new<string, string>())
    initOptimizedData(store)
    store

// @function Create DataStore using bulk loading - FASTEST for large datasets
// @param bulkData Pre-formatted data string
// @returns Initialized DataStore object
export createDataStoreFromBulk(string bulkData) =>
    store = DataStore.new(map.new<string, string>(), map.new<string, string>(), map.new<string, string>(), map.new<string, string>(), map.new<string, string>())
    loadBulkData(store, bulkData)
    store

// =============================================================================
// LOOKUP FUNCTIONS - Already optimized with O(1) map operations
// =============================================================================

// @function Get SIC code for a given ticker
// @param store The DataStore object
// @param ticker The ticker symbol to look up
// @returns The SIC code as a string, or "NOT_FOUND" if not found
export getSicByTicker(DataStore store, string ticker) =>
    result = map.get(store.tickerToSic, ticker)
    not na(result) ? result : "NOT_FOUND"

// @function Get industry for a given ticker
// @param store The DataStore object
// @param ticker The ticker symbol to look up
// @returns The industry name as a string, or "NOT_FOUND" if not found
export getIndustryByTicker(DataStore store, string ticker) =>
    result = map.get(store.tickerToIndustry, ticker)
    not na(result) ? result : "NOT_FOUND"

// @function Get comma-separated tickers for a given SIC code
// @param store The DataStore object
// @param sic The SIC code to look up
// @returns Comma-separated ticker symbols as a string, or "NOT_FOUND" if not found
export getTickersBySic(DataStore store, string sic) =>
    result = map.get(store.sicToTickers, sic)
    not na(result) ? result : "NOT_FOUND"

// @function Get comma-separated tickers for a given industry
// @param store The DataStore object
// @param industry The industry name to look up
// @returns Comma-separated ticker symbols as a string, or "NOT_FOUND" if not found
export getTickersByIndustry(DataStore store, string industry) =>
    result = map.get(store.industryToTickers, industry)
    not na(result) ? result : "NOT_FOUND"

// @function Get industry name for a given SIC code
// @param store The DataStore object
// @param sic The SIC code to look up
// @returns The industry name as a string, or "NOT_FOUND" if not found
export getIndustryBySic(DataStore store, string sic) =>
    result = map.get(store.sicToIndustry, sic)
    not na(result) ? result : "NOT_FOUND"

// =============================================================================
// OPTIMIZED ARRAY CONVERSION FUNCTIONS
// =============================================================================

// @function Convert comma-separated ticker string to array - OPTIMIZED
// @param tickerString Comma-separated ticker symbols
// @returns Array of ticker symbols
export tickerStringToArray(string tickerString) =>
    tickerString == "NOT_FOUND" or tickerString == "" ? array.new<string>() : str.split(tickerString, ",")

// @function Get ticker array for a given SIC code - OPTIMIZED
// @param store The DataStore object
// @param sic The SIC code to look up
// @returns Array of ticker symbols, or empty array if not found
export getTickerArrayBySic(DataStore store, string sic) =>
    tickerStringToArray(getTickersBySic(store, sic))

// @function Get ticker array for a given industry - OPTIMIZED
// @param store The DataStore object
// @param industry The industry name to look up
// @returns Array of ticker symbols, or empty array if not found
export getTickerArrayByIndustry(DataStore store, string industry) =>
    tickerStringToArray(getTickersByIndustry(store, industry))

// =============================================================================
// OPTIMIZED UTILITY FUNCTIONS
// =============================================================================

// @function Check if a ticker exists in the database - O(1) operation
// @param store The DataStore object
// @param ticker The ticker symbol to check
// @returns true if ticker exists, false otherwise
export tickerExists(DataStore store, string ticker) =>
    map.contains(store.tickerToSic, ticker)

// @function Check if a SIC code exists in the database - O(1) operation
// @param store The DataStore object
// @param sic The SIC code to check
// @returns true if SIC exists, false otherwise
export sicExists(DataStore store, string sic) =>
    map.contains(store.sicToIndustry, sic)

// @function Check if an industry exists in the database - O(1) operation
// @param store The DataStore object
// @param industry The industry name to check
// @returns true if industry exists, false otherwise
export industryExists(DataStore store, string industry) =>
    map.contains(store.industryToTickers, industry)

// @function Get total number of tickers in database - O(1) operation
// @param store The DataStore object
// @returns Total ticker count
export getTotalTickerCount(DataStore store) =>
    map.size(store.tickerToSic)

// @function Get ticker count for a given SIC code - OPTIMIZED
// @param store The DataStore object
// @param sic The SIC code to look up
// @returns Number of tickers in that SIC code
export getTickerCountBySic(DataStore store, string sic) =>
    tickerString = getTickersBySic(store, sic)
    if tickerString == "NOT_FOUND"
        0
    else
        // Count commas + 1 for efficiency instead of creating array
        str.length(tickerString) - str.length(str.replace_all(tickerString, ",", "")) + 1

// @function Get ticker count for a given industry - OPTIMIZED
// @param store The DataStore object
// @param industry The industry name to look up
// @returns Number of tickers in that industry
export getTickerCountByIndustry(DataStore store, string industry) =>
    tickerString = getTickersByIndustry(store, industry)
    if tickerString == "NOT_FOUND"
        0
    else
        // Count commas + 1 for efficiency instead of creating array
        str.length(tickerString) - str.length(str.replace_all(tickerString, ",", "")) + 1

// =============================================================================
// ADVANCED SEARCH FUNCTIONS - OPTIMIZED
// =============================================================================

// @function Check if a ticker belongs to a specific SIC code - O(1) operation
// @param store The DataStore object
// @param ticker The ticker to check
// @param sic The SIC code to check against
// @returns true if ticker belongs to the SIC code, false otherwise
export tickerInSic(DataStore store, string ticker, string sic) =>
    getSicByTicker(store, ticker) == sic

// @function Check if a ticker belongs to a specific industry - O(1) operation
// @param store The DataStore object
// @param ticker The ticker to check
// @param industry The industry to check against
// @returns true if ticker belongs to the industry, false otherwise
export tickerInIndustry(DataStore store, string ticker, string industry) =>
    getIndustryByTicker(store, ticker) == industry

// @function Get the first N tickers for a given SIC code
// @param store The DataStore object
// @param sic The SIC code to look up
// @param count Maximum number of tickers to return
// @returns Comma-separated string of first N tickers
export getFirstNTickersBySic(DataStore store, string sic, int count) =>
    allTickers = getTickersBySic(store, sic)
    if allTickers == "NOT_FOUND" or count <= 0
        "NOT_FOUND"
    else
        tickerArray = str.split(allTickers, ",")
        result = ""
        limit = math.min(count, array.size(tickerArray))
        for i = 0 to limit - 1
            ticker = array.get(tickerArray, i)
            result := result == "" ? ticker : result + "," + ticker
        result

// @function Get the first N tickers for a given industry
// @param store The DataStore object
// @param industry The industry to look up
// @param count Maximum number of tickers to return
// @returns Comma-separated string of first N tickers
export getFirstNTickersByIndustry(DataStore store, string industry, int count) =>
    allTickers = getTickersByIndustry(store, industry)
    if allTickers == "NOT_FOUND" or count <= 0
        "NOT_FOUND"
    else
        tickerArray = str.split(allTickers, ",")
        result = ""
        limit = math.min(count, array.size(tickerArray))
        for i = 0 to limit - 1
            ticker = array.get(tickerArray, i)
            result := result == "" ? ticker : result + "," + ticker
        result

// =============================================================================
// MEMORY-EFFICIENT COLLECTION UTILITIES
// =============================================================================

// @function Get all unique SIC codes as comma-separated string
// @param store The DataStore object
// @returns String of all SIC codes separated by commas
export getAllSicCodes(DataStore store) =>
    result = ""
    for [sic, industry] in store.sicToIndustry
        result := result == "" ? sic : result + "," + sic
    result

// @function Get all unique industries as comma-separated string
// @param store The DataStore object
// @returns String of all industries separated by commas
export getAllIndustries(DataStore store) =>
    result = ""
    for [industry, tickers] in store.industryToTickers
        result := result == "" ? industry : result + "," + industry
    result

// @function Get all unique SIC codes as array
// @param store The DataStore object
// @returns Array of all SIC codes
export getAllSicCodesArray(DataStore store) =>
    tickerStringToArray(getAllSicCodes(store))

// @function Get all unique industries as array
// @param store The DataStore object
// @returns Array of all industries
export getAllIndustriesArray(DataStore store) =>
    tickerStringToArray(getAllIndustries(store))