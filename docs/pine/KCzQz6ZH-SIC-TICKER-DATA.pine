// @version=6
// @description An optimized library for looking up SIC ticker data using efficient structured data format
library("SIC_TICKER_DATA", overlay=true)

// =============================================================================
// OPTIMIZED DATA STRUCTURE - Using direct maps instead of processing arrays
// =============================================================================

// User Defined Type to hold all our data - optimized structure
export type DataStore
    map<string, string> tickerToSic
    map<string, string> tickerToIndustry
    map<string, string> sicToIndustry
    map<string, string> sicToTickers
    map<string, string> industryToTickers

// =============================================================================
// OPTIMIZED DATA INITIALIZATION - Direct map population
// =============================================================================

// @function Add multiple tickers for the same SIC/Industry
// @param store The DataStore object
// @param tickers Comma-separated ticker symbols
// @param sic SIC code
// @param industry Industry name
// @returns void
addTickerGroup(DataStore store, string tickers, string sic, string industry) =>
    // Store SIC to Industry mapping once
    map.put(store.sicToIndustry, sic, industry)
    
    // Process tickers efficiently
    tickerArray = str.split(tickers, ",")
    
    // Update SIC and Industry ticker lists
    existingSicTickers = map.get(store.sicToTickers, sic)
    existingIndustryTickers = map.get(store.industryToTickers, industry)
    
    // Pre-calculate concatenated strings to avoid repeated operations
    newSicTickers = na(existingSicTickers) ? tickers : existingSicTickers + "," + tickers
    newIndustryTickers = na(existingIndustryTickers) ? tickers : existingIndustryTickers + "," + tickers
    
    map.put(store.sicToTickers, sic, newSicTickers)
    map.put(store.industryToTickers, industry, newIndustryTickers)
    
    // Add individual ticker mappings in batch
    for i = 0 to array.size(tickerArray) - 1
        ticker = str.replace_all(array.get(tickerArray, i), " ", "")
        if ticker != ""
            map.put(store.tickerToSic, ticker, sic)
            map.put(store.tickerToIndustry, ticker, industry)

// @function Initialize data with OPTIMIZED approach - No raw data processing
// @param store The DataStore object
// @returns void
initOptimizedData(DataStore store) =>
    // Clear existing maps
    map.clear(store.tickerToSic)
    map.clear(store.tickerToIndustry)
    map.clear(store.sicToIndustry)
    map.clear(store.sicToTickers)
    map.clear(store.industryToTickers)
    
    // OPTIMIZED: Direct map population - much faster than array processing
