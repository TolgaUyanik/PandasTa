//@version=6
indicator("Selector MTF 4H + 1H", overlay=false)

// Datos confirmados de 4 horas
[close4h, ema4h, ema4hAnterior] = request.security(
     syminfo.tickerid,
     "240",
     [close[1], ta.ema(close, 50)[1], ta.ema(close, 50)[6]],
     barmerge.gaps_off,
     barmerge.lookahead_off)

// Cálculo horario

estadoHorario() =>
    [macd, senal, histograma] = ta.macd(close, 12, 26, 9)
    cruceAlcista = ta.crossover(macd, senal)
    [close[1], macd[1], senal[1], histograma[1], ta.barssince(cruceAlcista)[1]]

[close1h, macd1h, senal1h, hist1h, velasDesdeCruce] = request.security(syminfo.tickerid, "60", estadoHorario(), barmerge.gaps_off, barmerge.lookahead_off)

// Condiciones
tendencia4h = close4h > ema4h and ema4h > ema4hAnterior
senalHoraria = macd1h > senal1h and hist1h > 0
cruceReciente = velasDesdeCruce >= 0 and velasDesdeCruce <= 3

candidata = tendencia4h and senalHoraria and cruceReciente

// Permite ordenar acciones de distinto precio
fuerza = close1h != 0 ? hist1h / close1h * 100 : na

plot(candidata ? 1 : 0, "Candidata")
plot(fuerza, "Fuerza MACD")
plot(close4h / ema4h, "Precio / EMA50")