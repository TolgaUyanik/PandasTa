// This Pine Script(tm) v6 indicator is subject to the Terms of Use:
// https://www.tradingview.com/pine-script-reference/v6/
// Crypto Futures COT — Cohort Positioning v1.0
//
// An INFORMATIONAL viewer for the CFTC Commitments of Traders report on
// CME-listed crypto futures (Bitcoin, Ether) — the positioning data the
// mainstream futures screeners leave out. It shows how each cohort is
// positioned and how that evolves against price. No signals, no buy/sell
// markers: read the patterns yourself. Companion to COT Commercial Hedger
// Extreme (this one is the raw multi-cohort read; that one flags the
// commercial bottom-tell on commodities).
//
// Cohorts (CFTC "Legacy" report):
//   • Commercial hedgers      → producers / dealers hedging physical
//   • Large speculators       → Noncommercial: funds, large traders
//   • Retail / small traders  → Nonreportable: below the reporting threshold
//
// Data: CFTC COT, weekly (Tuesday snapshot, Friday release). Only CME-listed
// crypto has a COT report. Free / educational. Data © CFTC.

//@version=6
indicator("Crypto Futures COT — Cohort Positioning", "Crypto COT", overlay = false, format = format.volume, precision = 0)

import TradingView/LibraryCOT/4 as cot

// ── COT data ─────────────────────────────────────────────────────────────────
// Uses TradingView's official COT library (LibraryCOT v4). If the COTTickerid
// line ever red-lines after a library update, click the import to open the
// reference and match the current argument order. Plot/table logic is independent
// of this fetch. NOTE: cot-commercial-extreme.pine in this folder imports the
// wrong "TradingView/COT/3" (no such library) — it needs this same import fix.
gD = "COT data"
manualCode = input.string("133741", "CFTC code", group = gD, tooltip = "CME Bitcoin = 133741. CME Ether = 146021 (verify). Other markets have their own codes — look them up on cftc.gov or via TradingView's symbol search. Only CME-listed crypto is covered.")
includeOpt = input.bool(false, "Include options (futures + options)", group = gD, tooltip = "Off = futures-only. On = combined futures and options.")
reportTF   = input.string("1W", "COT report timeframe", group = gD, tooltip = "COT is a weekly report; 1W is the natural resolution.")

// ── Display ──────────────────────────────────────────────────────────────────
gV = "Display"
mode   = input.string("Net positions", "View", options = ["Net positions", "Long vs Short", "COT Index (0-100)"], group = gV, tooltip = "Net = long minus short per cohort. Long vs Short = gross legs (short mirrored below zero). COT Index = each cohort's net normalized 0-100 over the lookback, i.e. how extreme positioning is versus its own history.")
idxLen = input.int(156, "COT Index lookback (weeks)", minval = 26, maxval = 520, group = gV, tooltip = "About 156 weeks = 3 years.")

// ── Cohorts ──────────────────────────────────────────────────────────────────
gC = "Cohorts"
showComm   = input.bool(true, "Commercial hedgers",     group = gC, inline = "1")
colComm    = input.color(color.orange, "",              group = gC, inline = "1")
showSpec   = input.bool(true, "Large speculators",      group = gC, inline = "2")
colSpec    = input.color(color.blue, "",                group = gC, inline = "2")
showRetail = input.bool(true, "Retail (small traders)", group = gC, inline = "3")
colRetail  = input.color(color.gray, "",                group = gC, inline = "3")

// ── Snapshot table ───────────────────────────────────────────────────────────
gT = "Latest-report table"
showTable = input.bool(true, "Show snapshot table", group = gT)
tblPos    = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = gT)

// ── Request helper (Legacy report, contract positions) ───────────────────────
f_cot(string participant, string direction) =>
    request.security(cot.COTTickerid("Legacy", manualCode, includeOpt, participant, direction, "All"), reportTF, close, ignore_invalid_symbol = true)

commL = f_cot("Commercial Positions",    "Long")
commS = f_cot("Commercial Positions",    "Short")
specL = f_cot("Noncommercial Positions", "Long")
specS = f_cot("Noncommercial Positions", "Short")
retL  = f_cot("Nonreportable Positions", "Long")
retS  = f_cot("Nonreportable Positions", "Short")

commN = commL - commS
specN = specL - specS
retN  = retL  - retS

// ── COT Index: normalize a net series to 0-100 over the lookback ─────────────
f_idx(series float x) =>
    lo = ta.lowest(x, idxLen)
    hi = ta.highest(x, idxLen)
    hi == lo ? na : (x - lo) / (hi - lo) * 100.0

isLS  = mode == "Long vs Short"
isIdx = mode == "COT Index (0-100)"

commDisp = isIdx ? f_idx(commN) : commN
specDisp = isIdx ? f_idx(specN) : specN
retDisp  = isIdx ? f_idx(retN)  : retN

// ── Plots ────────────────────────────────────────────────────────────────────
// Net / COT Index: one line per cohort
plot(isLS ? na : (showComm   ? commDisp : na), "Commercials", color = colComm,   linewidth = 2)
plot(isLS ? na : (showSpec   ? specDisp : na), "Large specs", color = colSpec,   linewidth = 2)
plot(isLS ? na : (showRetail ? retDisp  : na), "Retail",      color = colRetail, linewidth = 2)

// Long vs Short: gross legs, longs above zero, shorts mirrored below
plot(isLS and showComm   ? commL  : na, "Comm long",    color = colComm)
plot(isLS and showComm   ? -commS : na, "Comm short",   color = color.new(colComm, 55))
plot(isLS and showSpec   ? specL  : na, "Spec long",    color = colSpec)
plot(isLS and showSpec   ? -specS : na, "Spec short",   color = color.new(colSpec, 55))
plot(isLS and showRetail ? retL   : na, "Retail long",  color = colRetail)
plot(isLS and showRetail ? -retS  : na, "Retail short", color = color.new(colRetail, 55))

// Reference lines
hline(isIdx ? 50 : 0, "Zero / mid", color = color.new(color.gray, 40), linestyle = hline.style_dotted)
hline(isIdx ? 80 : na, "80", color = color.new(color.gray, 70))
hline(isIdx ? 20 : na, "20", color = color.new(color.gray, 70))

// ── Latest weekly change per cohort (0 on non-update bars; keep last real move) ─
f_lastChg(series float net) =>
    var float c = na
    ch = ta.change(net)
    if not na(ch) and ch != 0
        c := ch
    c

commChg = f_lastChg(commN)
specChg = f_lastChg(specN)
retChg  = f_lastChg(retN)

f_num(float x) => na(x) ? "n/a" : str.tostring(x, format.volume)
f_delta(float d) => na(d) ? "n/a" : (d >= 0 ? "+" : "") + str.tostring(d, format.volume)

f_row(table t, int r, string name, color c, float l, float s, float n, float d) =>
    table.cell(t, 0, r, name,       text_color = c,                              text_size = size.small)
    table.cell(t, 1, r, f_num(l),   text_color = color.gray,                     text_size = size.small)
    table.cell(t, 2, r, f_num(s),   text_color = color.gray,                     text_size = size.small)
    table.cell(t, 3, r, f_num(n),   text_color = n >= 0 ? color.green : color.red, text_size = size.small)
    table.cell(t, 4, r, f_delta(d), text_color = na(d) ? color.gray : (d >= 0 ? color.green : color.red), text_size = size.small)

var table t = na
if showTable and barstate.islast
    pos = tblPos == "Top right" ? position.top_right : tblPos == "Top left" ? position.top_left : tblPos == "Bottom right" ? position.bottom_right : position.bottom_left
    if na(t)
        t := table.new(pos, 5, 4, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)
    table.cell(t, 0, 0, "Cohort", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(t, 1, 0, "Long",   text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(t, 2, 0, "Short",  text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(t, 3, 0, "Net",    text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(t, 4, 0, "Change", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    row = 1
    if showComm
        f_row(t, row, "Commercials", colComm, commL, commS, commN, commChg)
        row += 1
    if showSpec
        f_row(t, row, "Large specs", colSpec, specL, specS, specN, specChg)
        row += 1
    if showRetail
        f_row(t, row, "Retail", colRetail, retL, retS, retN, retChg)
        row += 1
