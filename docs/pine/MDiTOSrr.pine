library("SMC_Blocks", overlay=true)

// @function オーダーブロック (OB) の検出
// @param c1 1本前の終値
// @param o1 1本前の始値
// @param c0 現在の終値
// @param l1 1本前の安値
// @param h1 1本前の高値
// @param is_bull 強気OBの判定か
// @returns bool OB形成の有無
export detect_ob(float c1, float o1, float c0, float l1, float h1, bool is_bull) =>
    bool is_ob = false
    
    if is_bull
        // 弱気キャンドル(陰線)の直後に、その高値を上抜ける強い陽線が発生した場合
        if c1 < o1 and c0 > h1
            is_ob := true
    else
        // 強気キャンドル(陽線)の直後に、その安値を下抜ける強い陰線が発生した場合
        if c1 > o1 and c0 < l1
            is_ob := true
            
    is_ob