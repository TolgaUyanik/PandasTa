library("MahjongYakuEngine", overlay=false)

// ==========================================
// 七対子（チートイツ）判定
// ==========================================
export is_chiitoitsu(string[] hand) =>
    bool is_valid = true
    if array.size(hand) != 14
        is_valid := false
    else
        string[] temp = array.copy(hand)
        array.sort(temp)
        
        for i = 0 to 12 by 2
            if array.get(temp, i) != array.get(temp, i + 1)
                is_valid := false
                
        for i = 0 to 10 by 2
            if array.get(temp, i) == array.get(temp, i + 2)
                is_valid := false
    is_valid

// ==========================================
// [新規] 二盃口（リャンペーコー）判定
// ==========================================
export is_ryanpeikou(int[] counts) =>
    // 二盃口は7対子の形を取るため、各牌が必ず2枚（または0枚）であることを前提とする
    int peikou_count = 0
    bool is_valid_shape = true
    
    for i = 0 to 33
        int c = counts.get(i)
        if c != 0 and c != 2
            is_valid_shape := false
            break

    if is_valid_shape
        // 萬子・筒子・索子のそれぞれで、連続する3つの対子（例：22 33 44）を探す
        for s = 0 to 2
            int base = s * 9
            for i = 0 to 6
                if counts.get(base + i) == 2 and counts.get(base + i + 1) == 2 and counts.get(base + i + 2) == 2
                    peikou_count += 1
                    
    bool is_ryan = (peikou_count >= 2)
    is_ryan

// ==========================================
// 国士無双（コクシムソウ）判定
// ==========================================
export is_kokushi(string[] hand) =>
    var string[] YAO_CHU = array.from("🀇","🀏","🀙","🀡","🀐","🀘","🀀","🀁","🀂","🀃","🀄","🀅","🀆")

    bool is_valid = false
    if array.size(hand) == 14
        string[] temp = array.copy(hand)
        array.sort(temp)
        
        int pair_count = 0
        int yao_chu_types = 0
        
        for i = 0 to array.size(temp) - 1
            string t = array.get(temp, i)
            if not array.includes(YAO_CHU, t)
                break 
            
            if i == 0 or t != array.get(temp, i - 1)
                yao_chu_types += 1
            else if t == array.get(temp, i - 1)
                pair_count += 1
                
        if yao_chu_types == 13 and pair_count == 1
            is_valid := true
    is_valid