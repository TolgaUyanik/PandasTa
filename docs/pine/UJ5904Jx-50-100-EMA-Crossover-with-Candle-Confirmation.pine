//@version=6
indicator("50/100 EMA Crossover with Candle Confirmation", overlay=true)

// — Inputs
emaShortLen = input.int(50, "Fast EMA Length", minval=1)
emaLongLen  = input.int(100, "Slow EMA Length", minval=1)

// — EMA calculations
emaShort = ta.ema(close, emaShortLen)
emaLong  = ta.ema(close, emaLongLen)

// — Candle body prices
bodyHigh = math.max(open, close)
bodyLow  = math.min(open, close)

// — Plot EMAs
plot(emaShort, title="50 EMA", color=color.orange)
plot(emaLong,  title="100 EMA", color=color.blue)

// — Crossover with candle body confirmation
bullCrossover = (emaShort > emaLong) and (emaShort[1] <= emaLong[1]) and (bodyLow > emaLong)
bearCrossover = (emaShort < emaLong) and (emaShort[1] >= emaLong[1]) and (bodyHigh < emaLong)

// — Plot signals
plotshape(bullCrossover, title="Buy Signal",  style=shape.labelup,   location=location.belowbar, color=color.green, text="BUY")
plotshape(bearCrossover, title="Sell Signal", style=shape.labeldown, location=location.abovebar, color=color.red,   text="SELL")

// — Alerts
alertcondition(bullCrossover, "Buy Alert",  "50 EMA crossed above 100 EMA & candle closed above – BUY")
alertcondition(bearCrossover, "Sell Alert", "50 EMA crossed below 100 EMA & candle closed below – SELL")