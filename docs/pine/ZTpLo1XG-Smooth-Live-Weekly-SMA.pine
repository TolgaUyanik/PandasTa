//@version=6
indicator(
     title="Smooth Live Weekly SMA",
     shorttitle="Smooth Live W-SMA",
     overlay=true
)

lengthInput = input.int(10, "Weekly SMA Length", minval=1)
colorInput  = input.color(color.yellow, "Line Color")
widthInput  = input.int(2, "Line Width", minval=1, maxval=5)

// Confirmed weekly SMA anchors.
// Values exist only at completed weekly bars.
confirmedWeeklySma = request.security(
     syminfo.tickerid,
     "W",
     ta.sma(close, lengthInput),
     gaps=barmerge.gaps_on,
     lookahead=barmerge.lookahead_off
)

// Information needed to calculate the current developing weekly SMA.
previousWeeklySma = request.security(
     syminfo.tickerid,
     "W",
     ta.sma(close, lengthInput)[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

oldestWeeklyClose = request.security(
     syminfo.tickerid,
     "W",
     close[lengthInput],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

// Exact provisional weekly SMA using today's latest price.
liveWeeklySma =
     (previousWeeklySma * lengthInput
     - oldestWeeklyClose
     + close) / lengthInput

// Historical weekly anchors plus today's live endpoint.
plotValue = barstate.islast ? liveWeeklySma : confirmedWeeklySma

plot(
     plotValue,
     title="Smooth Live Weekly SMA",
     color=colorInput,
     linewidth=widthInput,
     style=plot.style_line
)