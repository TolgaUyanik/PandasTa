//@version=5
indicator("3 Bullish Candles + No Wick + SL unter BoS (Swing Low)", overlay=true)

var float entryPrice = na
var float stopLoss = na
var float takeProfit = na
var bool inTrade = false

// --- 1) Pattern: 3 Bullische Kerzen mit No-Wick-Mitte -----------------------
bull1 = close[2] > open[2]
bull2 = close[1] > open[1] and open[1] == low[1] and close[1] == high[1]
bull3 = close > open
patternFound = bull1 and bull2 and bull3
entryTrigger = patternFound and not inTrade
entryLevel = low[1]

// --- 2) Finde letztes Swing Low (Break of Structure) ------------------------
var float lastSwingLow = na
isSwingLow = low[3] < low[2] and low[3] < low[4]
if isSwingLow
    lastSwingLow := low[3]

// --- 3) Entry wenn Kurs zurückkehrt zum Entry-Level --------------------------
entryCondition = entryTrigger and low <= entryLevel and not na(lastSwingLow)

if entryCondition
    entryPrice := entryLevel
    stopLoss := lastSwingLow
    takeProfit := entryPrice + (entryPrice - stopLoss) * 2.1
    inTrade := true

// --- 4) Exit-Bedingungen -----------------------------------------------------
exitTP = inTrade and high >= takeProfit
exitSL = inTrade and low <= stopLoss

if exitTP or exitSL
    inTrade := false
    entryPrice := na
    stopLoss := na
    takeProfit := na

// --- 5) Zeichnungen ----------------------------------------------------------
plotshape(entryCondition, location=location.belowbar, style=shape.arrowup, color=color.green, title="Long Entry")
plot(entryPrice, "Entry", color=color.green, style=plot.style_linebr)
plot(takeProfit, "Take Profit", color=color.blue, style=plot.style_linebr)
plot(stopLoss, "Stop Loss (Swing Low)", color=color.red, style=plot.style_linebr)

