//@version=6
strategy(
    "STtrend - TP Lock Added",
    overlay=true,
    pyramiding=0,
    initial_capital=500000,
    default_qty_type=strategy.fixed,
    default_qty_value=1,
    margin_long=5,
    margin_short=5
)

//==================================================
// Inputs
//==================================================
atrPeriod = input.int(10, "ATR Period", minval=1)
factor = input.float(3.0, "SuperTrend Factor", minval=0.1, step=0.1)

initialRiskDollars = input.float(2000, "Initial Stop Loss ($)", minval=1)

useProfitLocks = input.bool(true, "Enable Profit Locks")
lock1Trigger = input.float(1500, "Lock 1 Trigger ($)", minval=1)
lock1Amount  = input.float(500, "Lock 1 Locked Profit ($)", minval=0)
lock2Trigger = input.float(2500, "Lock 2 Trigger ($)", minval=1)
lock2Amount  = input.float(1500, "Lock 2 Locked Profit ($)", minval=0)
lock3Trigger = input.float(4000, "Lock 3 Trigger ($)", minval=1)
lock3Amount  = input.float(3000, "Lock 3 Locked Profit ($)", minval=0)

// NEW: hard take profit
useTakeProfit = input.bool(true, "Enable Hard Take Profit")
takeProfitDollars = input.float(3000, "Take Profit ($)", minval=1)

//==================================================
// SuperTrend
//==================================================
[stValue, stDirection] = ta.supertrend(factor, atrPeriod)

bullFlip = stDirection < 0 and stDirection[1] > 0
bearFlip = stDirection > 0 and stDirection[1] < 0

plot(stDirection < 0 ? stValue : na, "Bullish SuperTrend", color=color.green, linewidth=2)
plot(stDirection > 0 ? stValue : na, "Bearish SuperTrend", color=color.red, linewidth=2)

//==================================================
// NQ math
//==================================================
pointValue = syminfo.pointvalue
avgEntry = strategy.position_avg_price

dollarsToPoints(dollars) =>
    dollars / pointValue

float openProfitDollars = 0.0
if strategy.position_size > 0
    openProfitDollars := (close - avgEntry) * pointValue
else if strategy.position_size < 0
    openProfitDollars := (avgEntry - close) * pointValue
else
    openProfitDollars := 0.0

//==================================================
// State
//==================================================
var float activeStop = na
var bool lock1Shown = false
var bool lock2Shown = false
var bool lock3Shown = false
var bool tpShown = false

//==================================================
// Entries
//==================================================
if bullFlip
    strategy.close("Short", comment="Opposite Flip")
    strategy.entry("Long", strategy.long, qty=1, comment="Long Flip")

if bearFlip
    strategy.close("Long", comment="Opposite Flip")
    strategy.entry("Short", strategy.short, qty=1, comment="Short Flip")

//==================================================
// Stop + profit lock + hard TP
//==================================================
if strategy.position_size != 0
    initialStopPoints = dollarsToPoints(initialRiskDollars)

    longInitialStop = avgEntry - initialStopPoints
    shortInitialStop = avgEntry + initialStopPoints

    float lockedProfitDollars = 0.0

    if useProfitLocks
        if openProfitDollars >= lock3Trigger
            lockedProfitDollars := lock3Amount
        else if openProfitDollars >= lock2Trigger
            lockedProfitDollars := lock2Amount
        else if openProfitDollars >= lock1Trigger
            lockedProfitDollars := lock1Amount
        else
            lockedProfitDollars := 0.0

    lockedProfitPoints = dollarsToPoints(lockedProfitDollars)

    float longLockStop = na
    float shortLockStop = na

    if lockedProfitDollars > 0
        longLockStop := avgEntry + lockedProfitPoints
        shortLockStop := avgEntry - lockedProfitPoints

    // Lock labels
    if useProfitLocks
        if openProfitDollars >= lock1Trigger and not lock1Shown
            label.new(bar_index, high, "LOCK 1 $" + str.tostring(lock1Amount), style=label.style_label_down, color=color.purple, textcolor=color.white)
            lock1Shown := true

        if openProfitDollars >= lock2Trigger and not lock2Shown
            label.new(bar_index, high, "LOCK 2 $" + str.tostring(lock2Amount), style=label.style_label_down, color=color.teal, textcolor=color.white)
            lock2Shown := true

        if openProfitDollars >= lock3Trigger and not lock3Shown
            label.new(bar_index, high, "LOCK 3 $" + str.tostring(lock3Amount), style=label.style_label_down, color=color.blue, textcolor=color.white)
            lock3Shown := true

    // Hard TP prices
    float longTakeProfit = na
    float shortTakeProfit = na

    if useTakeProfit
        tpPoints = dollarsToPoints(takeProfitDollars)
        longTakeProfit := avgEntry + tpPoints
        shortTakeProfit := avgEntry - tpPoints

        if openProfitDollars >= takeProfitDollars and not tpShown
            label.new(bar_index, high, "TAKE PROFIT $" + str.tostring(takeProfitDollars), style=label.style_label_down, color=color.green, textcolor=color.white)
            tpShown := true

    // Long management
    if strategy.position_size > 0
        float candidateStopLong = longInitialStop

        if not na(longLockStop)
            candidateStopLong := math.max(candidateStopLong, longLockStop)

        activeStop := na(activeStop) ? candidateStopLong : math.max(activeStop, candidateStopLong)

        strategy.exit(
             "Long Exit",
             from_entry="Long",
             stop=activeStop,
             limit=longTakeProfit,
             comment="Long TP/SL"
         )

    // Short management
    if strategy.position_size < 0
        float candidateStopShort = shortInitialStop

        if not na(shortLockStop)
            candidateStopShort := math.min(candidateStopShort, shortLockStop)

        activeStop := na(activeStop) ? candidateStopShort : math.min(activeStop, candidateStopShort)

        strategy.exit(
             "Short Exit",
             from_entry="Short",
             stop=activeStop,
             limit=shortTakeProfit,
             comment="Short TP/SL"
         )

else
    activeStop := na
    lock1Shown := false
    lock2Shown := false
    lock3Shown := false
    tpShown := false

plot(activeStop, "Active Stop", color=color.orange, linewidth=2, style=plot.style_linebr)

//==================================================
// Flip exits
//==================================================
if strategy.position_size > 0 and bearFlip
    strategy.close("Long", comment="SuperTrend Flip Exit")

if strategy.position_size < 0 and bullFlip
    strategy.close("Short", comment="SuperTrend Flip Exit")

//==================================================
// Labels
//==================================================
enteredLong = strategy.position_size > 0 and strategy.position_size[1] <= 0
enteredShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
exitedTrade = strategy.position_size == 0 and strategy.position_size[1] != 0

if enteredLong
    label.new(bar_index, low, "ENTRY LONG", style=label.style_label_up, color=color.green, textcolor=color.white)

if enteredShort
    label.new(bar_index, high, "ENTRY SHORT", style=label.style_label_down, color=color.red, textcolor=color.white)

if exitedTrade
    wasLong = strategy.position_size[1] > 0
    label.new(bar_index, wasLong ? high : low, "EXIT", style=wasLong ? label.style_label_down : label.style_label_up, color=color.yellow, textcolor=color.black)