//@version=6
indicator("Mickey's EMA", shorttitle="Mickey's EMA", overlay=true)

fastLen   = input.int(20,   "Fast EMA Length",    minval=1)
slowLen   = input.int(200,  "Slow EMA Length",    minval=1)
src       = input.source(close, "Price Source")
slPct     = input.float(0.1, "Custom Stop Loss %", minval=0.0, step=0.1)/100
tpPct     = input.float(0.5, "Target %",           minval=0.0, step=0.1)/100
showSig   = input.bool(true, "Show Entry/SL/Target")
if fastLen == slowLen
    runtime.error("Fast & Slow EMA lengths must differ.")

emaFast    = ta.ema(src, fastLen)
emaSlow    = ta.ema(src, slowLen)
longSignal  = ta.crossover(emaFast, emaSlow)
shortSignal = ta.crossunder(emaFast, emaSlow)

var float entryPrice    = na
var float stopPrice     = na
var float targetPrice   = na
var bool  inTrade       = false
var bool  isLong        = false
var bool  slPlotted     = false
var bool  tpPlotted     = false

if longSignal
    entryPrice  := emaFast
    isLong       := true
    inTrade      := true
    stopPrice    := entryPrice * (1 - slPct)
    targetPrice  := entryPrice * (1 + tpPct)
    slPlotted    := false
    tpPlotted    := false

if shortSignal
    entryPrice  := emaFast
    isLong       := false
    inTrade      := true
    stopPrice    := entryPrice * (1 + slPct)
    targetPrice  := entryPrice * (1 - tpPct)
    slPlotted    := false
    tpPlotted    := false

plot(emaFast, title="Fast EMA", color=color.blue,  linewidth=1)
plot(emaSlow, title="Slow EMA", color=color.white, linewidth=1)

plotshape(series=showSig and longSignal,  title="BUY",  location=location.belowbar, style=shape.labelup,   size=size.small, color=color.new(color.blue, 50), text="BUY 🟢", textcolor=color.white)
plotshape(series=showSig and shortSignal, title="SELL", location=location.abovebar, style=shape.labeldown, size=size.small, color=color.new(color.white,50), text="SELL 🔴", textcolor=color.black)

if showSig and inTrade and isLong    and shortSignal and not slPlotted and not tpPlotted
    label.new(bar_index, entryPrice, "❌ (Custom)", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, size=size.small, color=color.new(color.white, 50), textcolor=color.black)
    slPlotted := true
if showSig and inTrade and not isLong and longSignal  and not slPlotted and not tpPlotted
    label.new(bar_index, entryPrice, "❌ (Custom)", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up,   size=size.small, color=color.new(color.white, 50), textcolor=color.black) 
    slPlotted := true

if showSig and inTrade and isLong    and not slPlotted and low  <= stopPrice
    label.new(bar_index, stopPrice,    "❌",           xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, size=size.small, color=color.new(color.white, 50), textcolor=color.black) 
    slPlotted := true
if showSig and inTrade and not isLong and not slPlotted and high >= stopPrice
    label.new(bar_index, stopPrice,    "❌",           xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up,   size=size.small, color=color.new(color.white, 50), textcolor=color.black) 
    slPlotted := true

if showSig and inTrade and isLong    and not tpPlotted and high >= targetPrice
    label.new(bar_index, targetPrice,  "🎯",        xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up,   size=size.small, color=color.new(color.blue, 50), textcolor=color.white) 
    tpPlotted := true
if showSig and inTrade and not isLong and not tpPlotted and low  <= targetPrice
    label.new(bar_index, targetPrice,  "🎯",        xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, size=size.small, color=color.new(color.blue, 50), textcolor=color.white) 
    tpPlotted := true

alertcondition(longSignal,  title="Mickey's EMA → BUY",  message="🚀 Fast EMA crossed above Slow EMA — BUY")
alertcondition(shortSignal, title="Mickey's EMA → SELL", message="💥 Fast EMA crossed below Slow EMA — SELL")

trend = longSignal ? "CE" : "PE"

buildJSON(trend) => '{"script":"'+syminfo.ticker+'","scriptType":"'+syminfo.type+'","instrumentType":"'+syminfo.prefix+'","timeframe":"'+timeframe.period+'","trend":"'+trend+'","price":'+str.tostring(close)+'}'

if longSignal or shortSignal
    alert(buildJSON(trend = trend))
