//@version=5
indicator("Multi-Session Levels + EMA Crosses + TP Calculator", overlay=true)

// ================================
// CONFIGURACIÓN BÁSICA
// ================================

// Configuración de la sesión 7-8 AM hora de México
session_time = input.session("0700-0800", "Sesión 7-8 AM México")

// Input para timezone de México
timezone_mexico = input.string("America/Mexico_City", "Timezone México", options=["America/Mexico_City", "GMT-6", "GMT-5"])

// ================================
// CONFIGURACIÓN TP CALCULATOR
// ================================
group_tp = "═════════ TP CALCULATOR ═════════"
adr_period = input.int(20, "Período ADR", minval=5, group=group_tp)
atr_period = input.int(14, "Período ATR", minval=1, group=group_tp)
atr_timeframe = input.timeframe("60", "ATR Timeframe", group=group_tp)
show_table = input.bool(true, "Mostrar Tabla TP", group=group_tp)
show_tp_levels = input.bool(true, "Mostrar Niveles TP", group=group_tp)

// ================================
// CONFIGURACIÓN MACD
// ================================
group_macd = "═════════ CONFIGURACIÓN MACD ═════════"
show_macd_validation = input.bool(true, "Activar Validación MACD", group=group_macd)
macd_fast = input.int(12, "MACD Fast Length", minval=1, group=group_macd)
macd_slow = input.int(26, "MACD Slow Length", minval=1, group=group_macd)
macd_signal = input.int(9, "MACD Signal Length", minval=1, group=group_macd)

// Calcular MACD
[macd_line, signal_line, hist] = ta.macd(close, macd_fast, macd_slow, macd_signal)

// ================================
// CONFIGURACIÓN RSI
// ================================
group_rsi = "═════════ CONFIGURACIÓN RSI ═════════"
show_rsi_validation = input.bool(true, "Activar Validación RSI", group=group_rsi)
rsi_length = input.int(14, "RSI Length", minval=1, group=group_rsi)
rsi_ma_length = input.int(9, "RSI MA Length", minval=1, group=group_rsi)
rsi_overbought = input.float(75.0, "RSI Sobrecompra (Máximo para Compras)", minval=50, maxval=90, step=1.0, group=group_rsi)
rsi_oversold = input.float(25.0, "RSI Sobreventa (Mínimo para Ventas)", minval=10, maxval=50, step=1.0, group=group_rsi)

// Calcular RSI y su Media Móvil
rsi = ta.rsi(close, rsi_length)
rsi_ma = ta.sma(rsi, rsi_ma_length)

// ================================
// CONFIGURACIÓN SQUEEZE MOMENTUM
// ================================
group_squeeze = "═════════ CONFIGURACIÓN SQUEEZE MOMENTUM ═════════"
show_squeeze_validation = input.bool(true, "Activar Validación Squeeze", group=group_squeeze)
bb_length = input.int(20, "BB Length", minval=1, group=group_squeeze)
bb_mult = input.float(2.0, "BB MultFactor", minval=0.1, step=0.1, group=group_squeeze)
kc_length = input.int(20, "KC Length", minval=1, group=group_squeeze)
kc_mult = input.float(1.5, "KC MultFactor", minval=0.1, step=0.1, group=group_squeeze)
use_true_range = input.bool(true, "Use TrueRange (KC)", group=group_squeeze)

// Calculate BB (LazyBear version)
bb_source = close
bb_basis = ta.sma(bb_source, bb_length)
bb_dev = kc_mult * ta.stdev(bb_source, bb_length)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

// Calculate KC (LazyBear version)
kc_ma = ta.sma(bb_source, kc_length)
kc_range = use_true_range ? ta.tr : (high - low)
kc_rangema = ta.sma(kc_range, kc_length)
kc_upper = kc_ma + kc_rangema * kc_mult
kc_lower = kc_ma - kc_rangema * kc_mult

// Squeeze detection (LazyBear logic)
sqz_on = (bb_lower > kc_lower) and (bb_upper < kc_upper)
sqz_off = (bb_lower < kc_lower) and (bb_upper > kc_upper)
no_sqz = not sqz_on and not sqz_off

// ================================
// CÁLCULOS PARA TP
// ================================

// Sesión NY (6 AM - 4 PM México) para cálculos TP
ny_session_time = "0600-1600"
in_ny_session_tp = time(timeframe.period, ny_session_time + ":1234567", timezone_mexico)

// 1. Average Daily Range (ADR) - usando timeframe diario
daily_range = request.security(syminfo.tickerid, "1D", high - low)
adr = ta.sma(daily_range, adr_period)

// 2. ATR desde timeframe superior (por defecto H1)
atr = request.security(syminfo.tickerid, atr_timeframe, ta.atr(atr_period))

// 3. Rango actual de la sesión NY
var float ny_high = na
var float ny_low = na
var float ny_open = na

if in_ny_session_tp and not in_ny_session_tp[1]
    ny_high := high
    ny_low := low
    ny_open := open
else if in_ny_session_tp
    ny_high := math.max(ny_high, high)
    ny_low := math.min(ny_low, low)

// Función para calcular pips
get_pip_value() =>
    if str.contains(syminfo.ticker, "JPY")
        0.01
    else
        0.0001

pip_value = get_pip_value()

// Pips ya recorridos en sesión NY
ny_range_pips = in_ny_session_tp and not na(ny_high) and not na(ny_low) ? 
               (ny_high - ny_low) / pip_value : 0

// ADR en pips
adr_pips = adr / pip_value

// ATR en pips
atr_pips = atr / pip_value

// === CÁLCULO DE TPs POTENCIALES ===

// TP basado en ADR restante (más agresivo)
tp_adr_pips = math.max(20, adr_pips - ny_range_pips)

// TP basado en ATR (multiplicadores más conservadores para H1)
tp_atr_conservative = atr_pips * 1.5   
tp_atr_aggressive = atr_pips * 2.5     
tp_atr_very_aggressive = atr_pips * 3.5

// TP basado en % del ADR total
tp_percentage_50 = adr_pips * 0.5  // 50% del ADR
tp_percentage_75 = adr_pips * 0.75 // 75% del ADR
tp_percentage_100 = adr_pips * 1.0 // 100% del ADR

// ================================
// FUNCIONES DE VALIDACIÓN
// ================================

// Función para validar MACD en compras
macd_valid_buy() =>
    hist_strong_green = hist > 0 and hist > hist[1]
    hist_light_red = hist < 0 and hist > hist[1]
    hist_valid = hist_strong_green or hist_light_red
    macd_above_or_equal_signal = macd_line >= signal_line
    coming_from_negative = macd_line[1] < 0 or macd_line[2] < 0 or macd_line[3] < 0
    hist_valid and macd_above_or_equal_signal and coming_from_negative

// Función para validar MACD en ventas
macd_valid_sell() =>
    hist_strong_red = hist < 0 and hist < hist[1]
    hist_light_green = hist > 0 and hist < hist[1]
    hist_valid = hist_strong_red or hist_light_green
    macd_below_or_equal_signal = macd_line <= signal_line
    coming_from_positive = macd_line[1] > 0 or macd_line[2] > 0 or macd_line[3] > 0
    hist_valid and macd_below_or_equal_signal and coming_from_positive

// Función para validar RSI en compras
rsi_valid_buy() =>
    rsi_not_overbought = rsi < rsi_overbought
    rsi_above_ma = rsi > rsi_ma
    rsi_not_overbought and rsi_above_ma

// Función para validar RSI en ventas
rsi_valid_sell() =>
    rsi_not_oversold = rsi > rsi_oversold
    rsi_below_ma = rsi < rsi_ma
    rsi_not_oversold and rsi_below_ma

// Función para validar Squeeze Momentum
squeeze_valid_buy() =>
    sqz_on

squeeze_valid_sell() =>
    sqz_on

// Función de validación combinada para compras
combined_valid_buy() =>
    macd_ok = not show_macd_validation or macd_valid_buy()
    rsi_ok = not show_rsi_validation or rsi_valid_buy()
    squeeze_ok = not show_squeeze_validation or squeeze_valid_buy()
    macd_ok and rsi_ok and squeeze_ok

// Función de validación combinada para ventas
combined_valid_sell() =>
    macd_ok = not show_macd_validation or macd_valid_sell()
    rsi_ok = not show_rsi_validation or rsi_valid_sell()
    squeeze_ok = not show_squeeze_validation or squeeze_valid_sell()
    macd_ok and rsi_ok and squeeze_ok

// Función para contar validaciones en compras
count_buy_validations() =>
    count = 0
    
    // MACD validations (2 total)
    if show_macd_validation
        hist_strong_green = hist > 0 and hist > hist[1]
        hist_light_red = hist < 0 and hist > hist[1]
        hist_valid = hist_strong_green or hist_light_red
        macd_above_or_equal_signal = macd_line >= signal_line
        coming_from_negative = macd_line[1] < 0 or macd_line[2] < 0 or macd_line[3] < 0
        
        if hist_valid
            count := count + 1
        if macd_above_or_equal_signal and coming_from_negative
            count := count + 1
    else
        count := count + 2
    
    // RSI validation (1 total)
    if show_rsi_validation
        if rsi_valid_buy()
            count := count + 1
    else
        count := count + 1
    
    // Squeeze validation (1 total)
    if show_squeeze_validation
        if squeeze_valid_buy()
            count := count + 1
    else
        count := count + 1
    
    count

// Función para contar validaciones en ventas
count_sell_validations() =>
    count = 0
    
    // MACD validations (2 total)
    if show_macd_validation
        hist_strong_red = hist < 0 and hist < hist[1]
        hist_light_green = hist > 0 and hist < hist[1]
        hist_valid = hist_strong_red or hist_light_green
        macd_below_or_equal_signal = macd_line <= signal_line
        coming_from_positive = macd_line[1] > 0 or macd_line[2] > 0 or macd_line[3] > 0
        
        if hist_valid
            count := count + 1
        if macd_below_or_equal_signal and coming_from_positive
            count := count + 1
    else
        count := count + 2
    
    // RSI validation (1 total)
    if show_rsi_validation
        if rsi_valid_sell()
            count := count + 1
    else
        count := count + 1
    
    // Squeeze validation (1 total)
    if show_squeeze_validation
        if squeeze_valid_sell()
            count := count + 1
    else
        count := count + 1
    
    count

// ================================
// CONFIGURACIÓN MODIFICADA: SESIÓN ASIÁTICA COMPLETA 6PM-1AM (NARANJA)
// ================================

session_time_asia = input.session("1800-0100", "Sesión Asiática Completa 6PM-1AM México")
show_asia_levels = input.bool(true, "Mostrar Niveles Asiáticos (Naranja)")

var float session_high_asia = na
var float session_low_asia = na
var int session_start_bar_asia = na
var array<line> active_asia_high_lines = array.new<line>()
var array<line> active_asia_low_lines = array.new<line>()

// ================================
// CONFIGURACIÓN DE SESIONES PARA ANÁLISIS
// ================================

london_session = input.session("0100-0600", "Sesión Londres")
ny_session = input.session("0800-1600", "Sesión Nueva York")

var string asia_status = "Esperando..."
var string london_status = "Esperando..."
var string ny_status = "Esperando..."
var string amd_status = "Esperando..."
var bool london_touched_asia_high = false
var bool london_touched_asia_low = false
var float asia_high_ref = na
var float asia_low_ref = na
var bool asia_completed = false
var bool london_completed = false
var float london_high_ref = na
var float london_low_ref = na
var bool use_london_levels = false
var array<line> active_london_high_lines = array.new<line>()
var array<line> active_london_low_lines = array.new<line>()
var int london_start_bar = na

// ================================
// CONFIGURACIÓN DE EMAs
// ================================

show_emas = input.bool(true, "Mostrar EMAs")
ema8_period = input.int(8, "EMA 8 Períodos", minval=1)
ema13_period = input.int(13, "EMA 13 Períodos", minval=1)
ema21_period = input.int(21, "EMA 21 Períodos", minval=1)
ema55_period = input.int(55, "EMA 55 Períodos", minval=1)

ema8 = ta.ema(close, ema8_period)
ema13 = ta.ema(close, ema13_period)
ema21 = ta.ema(close, ema21_period)
ema55 = ta.ema(close, ema55_period)

plot(show_emas ? ema8 : na, "EMA 8", color=color.blue, linewidth=2)
plot(show_emas ? ema13 : na, "EMA 13", color=color.green, linewidth=2)
plot(show_emas ? ema21 : na, "EMA 21", color=color.yellow, linewidth=2)
plot(show_emas ? ema55 : na, "EMA 55", color=color.red, linewidth=2)

// ================================
// DETECCIÓN DE CRUCES EMA 8 y EMA 13 CON VALIDACIÓN COMPLETA
// ================================

show_crosses = input.bool(true, "Mostrar Cruces EMA 8 vs EMA 13")
cross_session_mx = input.session("0400-1200", "Sesión Cruces EMA (4AM-12PM México)")

in_cross_session = time(timeframe.period, cross_session_mx, timezone_mexico)

basic_bullish_cross = ta.crossover(ema8, ema13) and in_cross_session
basic_bearish_cross = ta.crossunder(ema8, ema13) and in_cross_session

bullish_cross = basic_bullish_cross and combined_valid_buy()
bearish_cross = basic_bearish_cross and combined_valid_sell()

// Contar validaciones para señales no completas
bullish_count = basic_bullish_cross and not bullish_cross ? count_buy_validations() : na
bearish_count = basic_bearish_cross and not bearish_cross ? count_sell_validations() : na

var string current_cross_type = "none"
var bool cross_session_active = false

if in_cross_session and not in_cross_session[1]
    current_cross_type := "none"
    cross_session_active := true

if not in_cross_session and in_cross_session[1]
    cross_session_active := false

if cross_session_active and in_cross_session
    if bullish_cross
        current_cross_type := "bullish"
    else if bearish_cross
        current_cross_type := "bearish"

if ta.change(dayofweek) != 0
    current_cross_type := "none"
    cross_session_active := false

// ================================
// NIVELES DE TP EN GRÁFICO
// ================================
var line tp_line_1 = na
var line tp_line_2 = na
var line tp_line_3 = na
var line tp_line_4 = na

if show_tp_levels and (bullish_cross or bearish_cross)
    // Limpiar líneas anteriores
    if not na(tp_line_1)
        line.delete(tp_line_1)
    if not na(tp_line_2)
        line.delete(tp_line_2)
    if not na(tp_line_3)
        line.delete(tp_line_3)
    if not na(tp_line_4)
        line.delete(tp_line_4)
    
    if bullish_cross and tp_atr_conservative > 0
        tp_1 = close + (tp_atr_conservative * pip_value)      // ATR 1.5x
        tp_2 = close + (tp_atr_aggressive * pip_value)        // ATR 2.5x
        tp_3 = close + (tp_percentage_75 * pip_value)         // 75% ADR
        tp_4 = close + (tp_atr_very_aggressive * pip_value)   // ATR 3.5x
        
        tp_line_1 := line.new(bar_index, tp_1, bar_index + 50, tp_1, color=#00FF00, width=2, style=line.style_dashed)
        tp_line_2 := line.new(bar_index, tp_2, bar_index + 50, tp_2, color=#0080FF, width=2, style=line.style_dashed)
        tp_line_3 := line.new(bar_index, tp_3, bar_index + 50, tp_3, color=#FFFF00, width=2, style=line.style_dotted)
        tp_line_4 := line.new(bar_index, tp_4, bar_index + 50, tp_4, color=#FF00FF, width=3, style=line.style_solid)
        
        line.set_extend(tp_line_1, extend.right)
        line.set_extend(tp_line_2, extend.right)
        line.set_extend(tp_line_3, extend.right)
        line.set_extend(tp_line_4, extend.right)
    
    if bearish_cross and tp_atr_conservative > 0
        tp_1 = close - (tp_atr_conservative * pip_value)      // ATR 1.5x
        tp_2 = close - (tp_atr_aggressive * pip_value)        // ATR 2.5x
        tp_3 = close - (tp_percentage_75 * pip_value)         // 75% ADR
        tp_4 = close - (tp_atr_very_aggressive * pip_value)   // ATR 3.5x
        
        tp_line_1 := line.new(bar_index, tp_1, bar_index + 50, tp_1, color=#FF0000, width=2, style=line.style_dashed)
        tp_line_2 := line.new(bar_index, tp_2, bar_index + 50, tp_2, color=#800000, width=2, style=line.style_dashed)
        tp_line_3 := line.new(bar_index, tp_3, bar_index + 50, tp_3, color=#FFA500, width=2, style=line.style_dotted)
        tp_line_4 := line.new(bar_index, tp_4, bar_index + 50, tp_4, color=#800080, width=3, style=line.style_solid)
        
        line.set_extend(tp_line_1, extend.right)
        line.set_extend(tp_line_2, extend.right)
        line.set_extend(tp_line_3, extend.right)
        line.set_extend(tp_line_4, extend.right)

plotshape(show_crosses and bullish_cross, "Cruce Alcista VALIDADO", shape.triangleup, location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(show_crosses and bearish_cross, "Cruce Bajista VALIDADO", shape.triangledown, location.abovebar, color=color.new(color.red, 0), size=size.small)

show_invalid_signals = (show_macd_validation or show_rsi_validation or show_squeeze_validation)
plotshape(show_crosses and show_invalid_signals and basic_bullish_cross and not bullish_cross, "Cruce Alcista NO VALIDADO", shape.triangleup, location.belowbar, color=color.new(color.lime, 70), size=size.tiny)
plotshape(show_crosses and show_invalid_signals and basic_bearish_cross and not bearish_cross, "Cruce Bajista NO VALIDADO", shape.triangledown, location.abovebar, color=color.new(color.red, 70), size=size.tiny)

// Números para señales parcialmente validadas
if show_crosses and show_invalid_signals and not na(bullish_count)
    label.new(bar_index, low, text=str.tostring(bullish_count), style=label.style_label_up, color=color.lime, textcolor=color.white, size=size.small)

if show_crosses and show_invalid_signals and not na(bearish_count)
    label.new(bar_index, high, text=str.tostring(bearish_count), style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

plotshape(show_crosses and not show_invalid_signals and basic_bullish_cross, "Cruce Alcista BÁSICO", shape.triangleup, location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(show_crosses and not show_invalid_signals and basic_bearish_cross, "Cruce Bajista BÁSICO", shape.triangledown, location.abovebar, color=color.new(color.red, 0), size=size.small)

alertcondition(bullish_cross, title="Cruce Alcista VALIDADO + TP", message="EMA 8/13 Alcista + MACD + RSI + Squeeze Validados - Revisar TPs sugeridos")
alertcondition(bearish_cross, title="Cruce Bajista VALIDADO + TP", message="EMA 8/13 Bajista + MACD + RSI + Squeeze Validados - Revisar TPs sugeridos")

// ================================
// FUNCIÓN PARA VERIFICAR Y ELIMINAR LÍNEAS TOCADAS
// ================================

check_asia_lines() =>
    if array.size(active_asia_high_lines) > 0
        for i = array.size(active_asia_high_lines) - 1 to 0
            current_line = array.get(active_asia_high_lines, i)
            if not na(current_line)
                line_price = line.get_y1(current_line)
                if high >= line_price
                    line.delete(current_line)
                    array.remove(active_asia_high_lines, i)
    
    if array.size(active_asia_low_lines) > 0
        for i = array.size(active_asia_low_lines) - 1 to 0
            current_line = array.get(active_asia_low_lines, i)
            if not na(current_line)
                line_price = line.get_y1(current_line)
                if low <= line_price
                    line.delete(current_line)
                    array.remove(active_asia_low_lines, i)

check_london_lines() =>
    if array.size(active_london_high_lines) > 0
        for i = array.size(active_london_high_lines) - 1 to 0
            current_line = array.get(active_london_high_lines, i)
            if not na(current_line)
                line_price = line.get_y1(current_line)
                if high >= line_price
                    line.delete(current_line)
                    array.remove(active_london_high_lines, i)
    
    if array.size(active_london_low_lines) > 0
        for i = array.size(active_london_low_lines) - 1 to 0
            current_line = array.get(active_london_low_lines, i)
            if not na(current_line)
                line_price = line.get_y1(current_line)
                if low <= line_price
                    line.delete(current_line)
                    array.remove(active_london_low_lines, i)

// ================================
// SESIÓN ASIÁTICA COMPLETA 6PM-1AM (NARANJA)
// ================================

in_session_asia = time(timeframe.period, session_time_asia, timezone_mexico)
in_london_session = time(timeframe.period, london_session, timezone_mexico)
in_ny_session = time(timeframe.period, ny_session, timezone_mexico)

if in_session_asia and not in_session_asia[1] and show_asia_levels
    session_high_asia := high
    session_low_asia := low
    session_start_bar_asia := bar_index
    asia_completed := false
    london_completed := false
    london_touched_asia_high := false
    london_touched_asia_low := false
    use_london_levels := false
    london_high_ref := na
    london_low_ref := na
    asia_status := "Generando niveles..."
    london_status := "Esperando..."
    ny_status := "Esperando..."
    amd_status := "Esperando..."

if in_session_asia and show_asia_levels
    session_high_asia := math.max(session_high_asia, high)
    session_low_asia := math.min(session_low_asia, low)

if not in_session_asia and in_session_asia[1] and not na(session_high_asia) and not na(session_low_asia) and show_asia_levels
    minutes_duration_asia = 15 * 60
    timeframe_minutes_asia = timeframe.in_seconds() / 60
    bars_duration_asia = math.round(minutes_duration_asia / timeframe_minutes_asia)
    
    high_line_asia = line.new(session_start_bar_asia, session_high_asia, bar_index + bars_duration_asia, session_high_asia, color=color.orange, width=2, style=line.style_solid, extend=extend.none)
    low_line_asia = line.new(session_start_bar_asia, session_low_asia, bar_index + bars_duration_asia, session_low_asia, color=color.orange, width=2, style=line.style_solid, extend=extend.none)
    
    array.push(active_asia_high_lines, high_line_asia)
    array.push(active_asia_low_lines, low_line_asia)
    
    asia_high_ref := session_high_asia
    asia_low_ref := session_low_asia
    asia_completed := true
    asia_status := "Niveles generados ✓"

// ================================
// LÓGICA DE ANÁLISIS LONDRES
// ================================

var float london_session_high = na
var float london_session_low = na

if in_london_session and not in_london_session[1] and asia_completed
    london_session_high := high
    london_session_low := low
    london_start_bar := bar_index

if in_london_session and asia_completed and not na(asia_high_ref) and not na(asia_low_ref)
    london_session_high := math.max(london_session_high, high)
    london_session_low := math.min(london_session_low, low)
    
    if high >= asia_high_ref and not london_touched_asia_high
        london_touched_asia_high := true
    
    if low <= asia_low_ref and not london_touched_asia_low
        london_touched_asia_low := true

if not in_london_session and in_london_session[1] and asia_completed and not london_completed
    london_completed := true
    london_high_ref := london_session_high
    london_low_ref := london_session_low
    
    minutes_duration_london = 15 * 60
    timeframe_minutes_london = timeframe.in_seconds() / 60
    bars_duration_london = math.round(minutes_duration_london / timeframe_minutes_london)
    
    if london_touched_asia_high and london_touched_asia_low
        london_status := "Doble"
        use_london_levels := true
        
        london_high_line = line.new(london_start_bar, london_high_ref, london_start_bar + bars_duration_london, london_high_ref, color=color.orange, width=2, style=line.style_solid, extend=extend.none)
        array.push(active_london_high_lines, london_high_line)
        
        london_low_line = line.new(london_start_bar, london_low_ref, london_start_bar + bars_duration_london, london_low_ref, color=color.orange, width=2, style=line.style_solid, extend=extend.none)
        array.push(active_london_low_lines, london_low_line)
    
    else if london_touched_asia_high and not london_touched_asia_low
        london_status := "Londres Alcista"
        use_london_levels := true
        
        london_high_line = line.new(london_start_bar, london_high_ref, london_start_bar + bars_duration_london, london_high_ref, color=color.orange, width=2, style=line.style_solid, extend=extend.none)
        array.push(active_london_high_lines, london_high_line)
        
        london_low_line = line.new(london_start_bar, london_low_ref, london_start_bar + bars_duration_london, london_low_ref, color=color.orange, width=2, style=line.style_solid, extend=extend.none)
        array.push(active_london_low_lines, london_low_line)
    
    else if london_touched_asia_low and not london_touched_asia_high
        london_status := "Londres Bajista"
        use_london_levels := true
        
        london_high_line = line.new(london_start_bar, london_high_ref, london_start_bar + bars_duration_london, london_high_ref, color=color.orange, width=2, style=line.style_solid, extend=extend.none)
        array.push(active_london_high_lines, london_high_line)
        
        london_low_line = line.new(london_start_bar, london_low_ref, london_start_bar + bars_duration_london, london_low_ref, color=color.orange, width=2, style=line.style_solid, extend=extend.none)
        array.push(active_london_low_lines, london_low_line)
    
    else
        london_status := "Sin manipulación"
        use_london_levels := false

check_asia_lines()
check_london_lines()

// ================================
// NIVELES 7-8 AM CON CONTROL DINÁMICO POR CRUCES EMA VALIDADOS
// ================================

var float session_high = na
var float session_low = na
var int session_start_bar = na
var line high_line = na
var line low_line = na
var array<line> all_high_lines = array.new<line>()
var array<line> all_low_lines = array.new<line>()

in_session = time(timeframe.period, session_time, timezone_mexico)

if in_session and not in_session[1]
    session_high := high
    session_low := low
    session_start_bar := bar_index
    ny_status := "Generando niveles..."

if in_session
    session_high := math.max(session_high, high)
    session_low := math.min(session_low, low)

if not in_session and in_session[1] and not na(session_high) and not na(session_low)
    minutes_duration = 4 * 60
    timeframe_minutes = timeframe.in_seconds() / 60
    bars_duration = math.round(minutes_duration / timeframe_minutes)
    
    high_line := line.new(session_start_bar, session_high, bar_index + bars_duration, session_high, color=color.white, width=2, style=line.style_solid, extend=extend.none)
    low_line := line.new(session_start_bar, session_low, bar_index + bars_duration, session_low, color=color.white, width=2, style=line.style_solid, extend=extend.none)
    
    array.push(all_high_lines, high_line)
    array.push(all_low_lines, low_line)
    
    ny_status := "Niveles listos - Monitoreando cruces validados"

if not na(session_high) and not na(session_low) and not na(high_line) and not na(low_line)
    if current_cross_type == "bullish"
        line.set_color(high_line, color.green)
        line.set_color(low_line, color.green)
        ny_status := "NY Alcista (Todos los indicadores ✓)"
    
    else if current_cross_type == "bearish"
        line.set_color(high_line, color.red)
        line.set_color(low_line, color.red)
        ny_status := "NY Bajista (Todos los indicadores ✓)"
    
    else if current_cross_type == "none"
        line.set_color(high_line, color.white)
        line.set_color(low_line, color.white)
        ny_status := "Niveles listos - Sin cruces validados"

// ================================
// LÓGICA DE AMD (COMBINACIÓN LONDRES + NY)
// ================================

if (london_status == "Londres Alcista" or london_status == "Londres Bajista" or london_status == "Doble" or london_status == "Sin manipulación") and (str.contains(ny_status, "Alcista") or str.contains(ny_status, "Bajista"))
    if (london_status == "Londres Alcista" and str.contains(ny_status, "Bajista")) or (london_status == "Londres Bajista" and str.contains(ny_status, "Alcista")) or (london_status == "Doble")
        amd_status := "Listo 100% + Todos los indicadores ✓"
    else
        amd_status := "Cancelado"

// ================================
// TABLA INFORMATIVA DE TP
// ================================
if show_table and barstate.islast
    var table tp_table = table.new(position.top_right, columns=2, rows=9, 
                                  bgcolor=color.white, border_width=1, border_color=color.black)
    
    table.cell(tp_table, 0, 0, "TP CALCULATOR", text_color=color.white, text_size=size.normal, bgcolor=color.blue)
    table.cell(tp_table, 1, 0, "PIPS", text_color=color.white, text_size=size.normal, bgcolor=color.blue)
    
    table.cell(tp_table, 0, 1, "TP Conservador (ATR 1.5x)", text_color=color.black, text_size=size.small, bgcolor=color.gray)
    table.cell(tp_table, 1, 1, str.tostring(tp_atr_conservative, "#.#"), text_color=color.green, text_size=size.small, bgcolor=color.white)
    
    table.cell(tp_table, 0, 2, "TP Agresivo (ATR 2.5x)", text_color=color.black, text_size=size.small, bgcolor=color.gray)
    table.cell(tp_table, 1, 2, str.tostring(tp_atr_aggressive, "#.#"), text_color=color.blue, text_size=size.small, bgcolor=color.white)
    
    table.cell(tp_table, 0, 3, "TP Muy Agresivo (ATR 3.5x)", text_color=color.black, text_size=size.small, bgcolor=color.gray)
    table.cell(tp_table, 1, 3, str.tostring(tp_atr_very_aggressive, "#.#"), text_color=color.fuchsia, text_size=size.small, bgcolor=color.white)
    
    table.cell(tp_table, 0, 4, "75% del ADR", text_color=color.black, text_size=size.small, bgcolor=color.gray)
    table.cell(tp_table, 1, 4, str.tostring(tp_percentage_75, "#.#"), text_color=color.maroon, text_size=size.small, bgcolor=color.white)
    
    table.cell(tp_table, 0, 5, "100% del ADR", text_color=color.black, text_size=size.small, bgcolor=color.gray)
    table.cell(tp_table, 1, 5, str.tostring(tp_percentage_100, "#.#"), text_color=color.orange, text_size=size.small, bgcolor=color.white)
    
    table.cell(tp_table, 0, 6, "Ya Recorrido NY", text_color=color.black, text_size=size.small, bgcolor=color.gray)
    table.cell(tp_table, 1, 6, str.tostring(ny_range_pips, "#.#"), text_color=color.red, text_size=size.small, bgcolor=color.white)
    
    table.cell(tp_table, 0, 7, "ADR Promedio", text_color=color.black, text_size=size.small, bgcolor=color.gray)
    table.cell(tp_table, 1, 7, str.tostring(adr_pips, "#.#"), text_color=color.navy, text_size=size.small, bgcolor=color.white)
    
    table.cell(tp_table, 0, 8, "ATR H1", text_color=color.black, text_size=size.small, bgcolor=color.gray)
    table.cell(tp_table, 1, 8, str.tostring(atr_pips, "#.#"), text_color=color.purple, text_size=size.small, bgcolor=color.white)

plot(na, "Niveles Asiáticos", color=color.orange)