//@version=5
indicator("MA Table [RanaAlgo]", overlay=true, shorttitle="MA Signals Table Pro")

// Input parameters for MA visibility
showEma = input.bool(true, "Show EMA Signals", group="MA Visibility")
showSma = input.bool(true, "Show SMA Signals", group="MA Visibility")

// Table Styling Inputs
var bgHeader = input.color(color.new(#2C3E50, 0), "Header Background", group="Table Styling")
var textHeader = input.color(color.white, "Header Text", group="Table Styling")
var bgRowEven = input.color(color.new(#34495E, 70), "Even Row BG", group="Table Styling")
var bgRowOdd = input.color(color.new(#2C3E50, 70), "Odd Row BG", group="Table Styling")
var textMain = input.color(color.white, "Main Text Color", group="Table Styling")
var borderColor = input.color(color.new(#7F8C8D, 50), "Border Color", group="Table Styling")
var borderWidth = input.int(2, "Border Width", minval=1, maxval=5, group="Table Styling")
var textSize = input.string("normal", "Text Size", options=["tiny", "small", "normal", "large"], group="Table Styling")
var buyColor = input.color(color.new(#27AE60, 70), "Buy Signal Color", group="Signal Colors")
var sellColor = input.color(color.new(#E74C3C, 70), "Sell Signal Color", group="Signal Colors")

// Calculate MAs
ema10 = ta.ema(close, 10)
ema20 = ta.ema(close, 20)
ema30 = ta.ema(close, 30)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)

sma10 = ta.sma(close, 10)
sma20 = ta.sma(close, 20)
sma30 = ta.sma(close, 30)
sma50 = ta.sma(close, 50)
sma100 = ta.sma(close, 100)

// Determine signals with additional strength indicator
ema10_signal = close > ema10 ? "▲ Buy" : "▼ Sell"
ema20_signal = close > ema20 ? "▲ Buy" : "▼ Sell"
ema30_signal = close > ema30 ? "▲ Buy" : "▼ Sell"
ema50_signal = close > ema50 ? "▲ Buy" : "▼ Sell"
ema100_signal = close > ema100 ? "▲ Buy" : "▼ Sell"

sma10_signal = close > sma10 ? "▲ Buy" : "▼ Sell"
sma20_signal = close > sma20 ? "▲ Buy" : "▼ Sell"
sma30_signal = close > sma30 ? "▲ Buy" : "▼ Sell"
sma50_signal = close > sma50 ? "▲ Buy" : "▼ Sell"
sma100_signal = close > sma100 ? "▲ Buy" : "▼ Sell"

// Create the table with customizable position
tablePosition = input.string("top_right", "Table Position", 
  options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"],
  group="Table Position")

var table maTable = table.new(  position = tablePosition,  columns = 3,  rows = 11,  border_width = borderWidth,  border_color = borderColor,  bgcolor = color.new(#2C3E50, 90))

// Function to get text size enum
getTextSize() =>
  switch textSize
    "tiny" => size.tiny
    "small" => size.small
    "normal" => size.normal
    "large" => size.large

// Table headers with full styling
if barstate.islast
    // Header row - all columns now have equal width
    table.cell(maTable, 0, 0, "MA Type", bgcolor=bgHeader, text_color=textHeader, text_size=getTextSize(), text_halign=text.align_center)
    table.cell(maTable, 1, 0, "Period", bgcolor=bgHeader, text_color=textHeader, text_size=getTextSize(), text_halign=text.align_center)
    table.cell(maTable, 2, 0, "Signal", bgcolor=bgHeader, text_color=textHeader, text_size=getTextSize(), text_halign=text.align_center)

    // EMA Signals Rows
    if showEma
        table.cell(maTable, 0, 1, "EMA", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 1, "10", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 1, ema10_signal, bgcolor=str.contains(ema10_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        
        table.cell(maTable, 0, 2, "EMA", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 2, "20", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 2, ema20_signal, bgcolor=str.contains(ema20_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        
        table.cell(maTable, 0, 3, "EMA", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 3, "30", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 3, ema30_signal, bgcolor=str.contains(ema30_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        
        table.cell(maTable, 0, 4, "EMA", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 4, "50", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 4, ema50_signal, bgcolor=str.contains(ema50_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        
        table.cell(maTable, 0, 5, "EMA", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 5, "100", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 5, ema100_signal, bgcolor=str.contains(ema100_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)

    // SMA Signals Rows
    if showSma
        table.cell(maTable, 0, 6, "SMA", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 6, "10", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 6, sma10_signal, bgcolor=str.contains(sma10_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        
        table.cell(maTable, 0, 7, "SMA", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 7, "20", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 7, sma20_signal, bgcolor=str.contains(sma20_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        
        table.cell(maTable, 0, 8, "SMA", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 8, "30", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 8, sma30_signal, bgcolor=str.contains(sma30_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        
        table.cell(maTable, 0, 9, "SMA", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 9, "50", bgcolor=bgRowOdd, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 9, sma50_signal, bgcolor=str.contains(sma50_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        
        table.cell(maTable, 0, 10, "SMA", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 1, 10, "100", bgcolor=bgRowEven, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)
        table.cell(maTable, 2, 10, sma100_signal, bgcolor=str.contains(sma100_signal, "Buy") ? buyColor : sellColor, text_color=textMain, text_size=getTextSize(), text_halign=text.align_center)

// Optional: Plot MAs for visual reference
plot(showEma ? ema10 : na, "EMA 10", color=color.new(#3498DB, 0), linewidth=2)
plot(showEma ? ema20 : na, "EMA 20", color=color.new(#E74C3C, 0), linewidth=2)
plot(showEma ? ema30 : na, "EMA 30", color=color.new(#2ECC71, 0), linewidth=2)
plot(showEma ? ema50 : na, "EMA 50", color=color.new(#F39C12, 0), linewidth=2)
plot(showEma ? ema100 : na, "EMA 100", color=color.new(#9B59B6, 0), linewidth=2)

plot(showSma ? sma10 : na, "SMA 10", color=color.new(#3498DB, 0), linewidth=1, style=plot.style_cross)
plot(showSma ? sma20 : na, "SMA 20", color=color.new(#E74C3C, 0), linewidth=1, style=plot.style_cross)
plot(showSma ? sma30 : na, "SMA 30", color=color.new(#2ECC71, 0), linewidth=1, style=plot.style_cross)
plot(showSma ? sma50 : na, "SMA 50", color=color.new(#F39C12, 0), linewidth=1, style=plot.style_cross)
plot(showSma ? sma100 : na, "SMA 100", color=color.new(#9B59B6, 0), linewidth=1, style=plot.style_cross)
