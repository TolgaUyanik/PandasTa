//@version=6
//@description Complete Machine Learning Library for PineScript v6. Includes KNN, Linear/Logistic Regression, Naive Bayes, Neural Networks, distance functions, activation functions, preprocessing, loss functions, optimization, metrics, and trading utilities.
library("machine_learning", overlay=false)

// =============================================================================
// ML COMBINED - Complete Machine Learning Library for PineScript v6
// =============================================================================
// This single file consolidates all ML modules:
// - Types (UDTs for models)
// - Constants (numerical stability)
// - Distance functions
// - Activation functions
// - Preprocessing/Scaling
// - Loss functions
// - Optimization (SGD, Adam, etc.)
// - KNN (classification/regression)
// - Linear Regression (OLS, Ridge, Lasso, Elastic Net)
// - Logistic Regression
// - Naive Bayes
// - Neural Network (MLP)
// - Metrics (classification/regression)
// - Data utilities
// - Trading utilities
// =============================================================================

// =============================================================================
// CONSTANTS
// =============================================================================

//@variable Smallest epsilon value for numerical stability (1e-15)
export const float EPSILON_TINY = 1e-15

//@variable Small epsilon value for numerical stability (1e-10)
export const float EPSILON_SMALL = 1e-10

//@variable Medium epsilon value for numerical stability (1e-8)
export const float EPSILON_MEDIUM = 1e-8

//@variable Precomputed value of log(2*PI) used in Gaussian probability calculations
export const float LOG_2PI = 1.8378770664093453

//@variable Default maximum iterations for iterative algorithms
export const int MAX_ITERATIONS = 100

//@variable Maximum number of elements allowed in a matrix (PineScript limitation)
export const int MAX_MATRIX_ELEMENTS = 100000

// =============================================================================
// USER-DEFINED TYPES
// =============================================================================

//@type K-Nearest Neighbors model for classification
//@field k Number of neighbors to consider (default: 5)
//@field distance_type Distance metric: "euclidean", "manhattan", "cosine", or "chebyshev"
//@field X_train Training feature matrix
//@field y_train Training labels array
export type ml_knn
    int k = 5
    string distance_type = "euclidean"
    matrix<float> X_train = na
    array<int> y_train = na

//@type Linear regression model (OLS, Ridge, Lasso)
//@field coefficients Model coefficients for each feature
//@field intercept Model intercept (bias term)
//@field lambda Regularization parameter (0 for OLS)
export type ml_linreg
    array<float> coefficients = na
    float intercept = 0.0
    float lambda = 0.0

//@type Logistic regression model for binary classification
//@field weights Model weights for each feature
//@field bias Model bias term
//@field learning_rate Learning rate for gradient descent
//@field iterations Number of training iterations
export type ml_logreg
    array<float> weights = na
    float bias = 0.0
    float learning_rate = 0.01
    int iterations = 50

//@type Multi-layer perceptron neural network
//@field layers Array of layer sizes (input, hidden..., output)
//@field weights Flattened weight matrix
//@field biases Array of all bias values
//@field weight_offsets Starting indices for each layer's weights
//@field bias_offsets Starting indices for each layer's biases
//@field activation Activation function: "relu", "sigmoid", "tanh", etc.
export type ml_nn
    array<int> layers = na
    matrix<float> weights = na
    array<float> biases = na
    array<int> weight_offsets = na
    array<int> bias_offsets = na
    string activation = "relu"

//@type Gaussian Naive Bayes classifier
//@field class_priors Prior probability of each class
//@field means Mean of each feature for each class
//@field variances Variance of each feature for each class
//@field n_classes Number of classes
export type ml_nb
    array<float> class_priors = na
    matrix<float> means = na
    matrix<float> variances = na
    int n_classes = 2

//@type Data scaler for feature normalization
//@field min_vals Minimum values for min-max scaling
//@field max_vals Maximum values for min-max scaling
//@field means Mean values for z-score normalization
//@field stds Standard deviation values for z-score normalization
//@field method Scaling method: "zscore" or "minmax"
export type ml_scaler
    array<float> min_vals = na
    array<float> max_vals = na
    array<float> means = na
    array<float> stds = na
    string method = "zscore"

//@type Training result containing metrics and convergence info
//@field loss_history Array of loss values during training
//@field final_loss Final loss value after training
//@field converged Whether training converged
//@field iterations_run Number of iterations actually executed
export type ml_train_result
    array<float> loss_history = na
    float final_loss = 0.0
    bool converged = false
    int iterations_run = 0

//@type Prediction result with class and probability information
//@field class_label Predicted class label
//@field probability Probability of the predicted class
//@field probabilities Array of probabilities for all classes
//@field value Regression prediction value (for regression models)
export type ml_prediction
    int class_label = 0
    float probability = 0.0
    array<float> probabilities = na
    float value = 0.0

// =============================================================================
// DISTANCE FUNCTIONS
// =============================================================================

//@function Calculates the Euclidean distance between two vectors
//@param a First vector
//@param b Second vector
//@returns The Euclidean (L2) distance between vectors a and b
export euclidean(array<float> a, array<float> b) =>
    if na(a) or na(b)
        float(na)
    else
        int n = math.min(array.size(a), array.size(b))
        if n == 0
            0.0
        else
            float sum_sq = 0.0
            for i = 0 to n - 1
                float diff = array.get(a, i) - array.get(b, i)
                sum_sq += diff * diff
            math.sqrt(sum_sq)

//@function Calculates the Manhattan distance between two vectors
//@param a First vector
//@param b Second vector
//@returns The Manhattan (L1) distance between vectors a and b
export manhattan(array<float> a, array<float> b) =>
    if na(a) or na(b)
        float(na)
    else
        int n = math.min(array.size(a), array.size(b))
        if n == 0
            0.0
        else
            float sum_abs = 0.0
            for i = 0 to n - 1
                sum_abs += math.abs(array.get(a, i) - array.get(b, i))
            sum_abs

//@function Calculates the cosine similarity between two vectors
//@param a First vector
//@param b Second vector
//@returns Cosine similarity value between -1 and 1
export cosine_similarity(array<float> a, array<float> b) =>
    if na(a) or na(b)
        float(na)
    else
        int n = math.min(array.size(a), array.size(b))
        if n == 0
            float(na)
        else
            float dot_product = 0.0
            float norm_a = 0.0
            float norm_b = 0.0
            for i = 0 to n - 1
                float val_a = array.get(a, i)
                float val_b = array.get(b, i)
                dot_product += val_a * val_b
                norm_a += val_a * val_a
                norm_b += val_b * val_b
            float denom = math.sqrt(norm_a) * math.sqrt(norm_b)
            denom == 0.0 ? 0.0 : dot_product / denom

//@function Calculates the cosine distance between two vectors (1 - cosine_similarity)
//@param a First vector
//@param b Second vector
//@returns Cosine distance value between 0 and 2
export cosine_distance(array<float> a, array<float> b) =>
    float sim = cosine_similarity(a, b)
    na(sim) ? float(na) : 1.0 - sim

//@function Calculates the Chebyshev distance between two vectors (max absolute difference)
//@param a First vector
//@param b Second vector
//@returns The Chebyshev (L-infinity) distance between vectors a and b
export chebyshev(array<float> a, array<float> b) =>
    if na(a) or na(b)
        float(na)
    else
        int n = math.min(array.size(a), array.size(b))
        if n == 0
            0.0
        else
            float max_diff = 0.0
            for i = 0 to n - 1
                float diff = math.abs(array.get(a, i) - array.get(b, i))
                if diff > max_diff
                    max_diff := diff
            max_diff

//@function Calculates the Minkowski distance between two vectors
//@param a First vector
//@param b Second vector
//@param p Order of the Minkowski distance (p=1 is Manhattan, p=2 is Euclidean)
//@returns The Minkowski distance of order p between vectors a and b
export minkowski(array<float> a, array<float> b, float p) =>
    if na(a) or na(b) or na(p) or p <= 0.0
        float(na)
    else
        int n = math.min(array.size(a), array.size(b))
        if n == 0
            0.0
        else
            float sum_pow = 0.0
            for i = 0 to n - 1
                float diff = math.abs(array.get(a, i) - array.get(b, i))
                sum_pow += math.pow(diff, p)
            math.pow(sum_pow, 1.0 / p)

//@function Calculates the dot product of two vectors
//@param a First vector
//@param b Second vector
//@returns The dot product (scalar) of vectors a and b
export dot_product(array<float> a, array<float> b) =>
    if na(a) or na(b)
        float(na)
    else
        int n = math.min(array.size(a), array.size(b))
        if n == 0
            0.0
        else
            float result = 0.0
            for i = 0 to n - 1
                result += array.get(a, i) * array.get(b, i)
            result

//@function Calculates the p-norm (length) of a vector
//@param arr Input vector
//@param p Order of the norm (default: 2.0 for Euclidean norm)
//@returns The p-norm of the vector
export vector_norm(array<float> arr, float p = 2.0) =>
    if na(arr) or array.size(arr) == 0 or p <= 0.0
        float(na)
    else
        float sum_pow = 0.0
        for i = 0 to array.size(arr) - 1
            sum_pow += math.pow(math.abs(array.get(arr, i)), p)
        math.pow(sum_pow, 1.0 / p)

// =============================================================================
// ACTIVATION FUNCTIONS
// =============================================================================

//@function Applies the sigmoid activation function
//@param x Input value
//@returns Sigmoid output in range (0, 1)
export sigmoid(float x) =>
    if na(x)
        float(na)
    else
        float x_clipped = math.max(-500.0, math.min(500.0, x))
        1.0 / (1.0 + math.exp(-x_clipped))

//@function Calculates the derivative of sigmoid (for backpropagation)
//@param x Sigmoid output value (not the input)
//@returns Derivative of sigmoid at x
export sigmoid_derivative(float x) =>
    na(x) ? float(na) : x * (1.0 - x)

//@function Calculates the derivative of tanh (for backpropagation)
//@param x Tanh output value (not the input)
//@returns Derivative of tanh at x
export tanh_derivative(float x) =>
    na(x) ? float(na) : 1.0 - x * x

//@function Applies the ReLU activation function
//@param x Input value
//@returns max(0, x)
export relu(float x) =>
    na(x) ? float(na) : math.max(0.0, x)

//@function Calculates the derivative of ReLU (for backpropagation)
//@param x Input value
//@returns 1 if x > 0, else 0
export relu_derivative(float x) =>
    na(x) ? float(na) : (x > 0.0 ? 1.0 : 0.0)

//@function Applies the Leaky ReLU activation function
//@param x Input value
//@param alpha Slope for negative values (default: 0.01)
//@returns x if x > 0, else alpha * x
export leaky_relu(float x, float alpha = 0.01) =>
    na(x) ? float(na) : (x > 0.0 ? x : alpha * x)

//@function Calculates the derivative of Leaky ReLU (for backpropagation)
//@param x Input value
//@param alpha Slope for negative values (default: 0.01)
//@returns 1 if x > 0, else alpha
export leaky_relu_derivative(float x, float alpha = 0.01) =>
    na(x) ? float(na) : (x > 0.0 ? 1.0 : alpha)

//@function Applies the ELU activation function
//@param x Input value
//@param alpha Scale for negative values (default: 1.0)
//@returns x if x > 0, else alpha * (exp(x) - 1)
export elu(float x, float alpha = 1.0) =>
    na(x) ? float(na) : (x > 0.0 ? x : alpha * (math.exp(x) - 1.0))

//@function Applies the hyperbolic tangent activation function
//@param x Input value
//@returns Tanh output in range (-1, 1)
tanh(float x) =>
    if na(x)
        float(na)
    else
        float e2x = math.exp(2.0 * math.max(-500.0, math.min(500.0, x)))
        (e2x - 1.0) / (e2x + 1.0)

//@function Applies the GELU activation function (Gaussian Error Linear Unit)
//@param x Input value
//@returns GELU output approximation
export gelu(float x) =>
    if na(x)
        float(na)
    else
        float sqrt_2_pi = 0.7978845608
        0.5 * x * (1.0 + tanh(sqrt_2_pi * (x + 0.044715 * math.pow(x, 3))))

//@function Applies the Swish activation function (x * sigmoid(beta * x))
//@param x Input value
//@param beta Scaling parameter (default: 1.0)
//@returns Swish output
export swish(float x, float beta = 1.0) =>
    na(x) ? float(na) : x * sigmoid(beta * x)

//@function Applies the softmax function to convert logits to probabilities
//@param arr Input array of logits
//@returns Array of probabilities summing to 1
export softmax(array<float> arr) =>
    if na(arr) or array.size(arr) == 0
        array<float> result = na
        result
    else
        int n = array.size(arr)
        array<float> result = array.new_float(n, 0.0)
        float max_val = array.max(arr)
        float sum_exp = 0.0
        for i = 0 to n - 1
            float exp_val = math.exp(array.get(arr, i) - max_val)
            array.set(result, i, exp_val)
            sum_exp += exp_val
        if sum_exp > 0.0
            for i = 0 to n - 1
                array.set(result, i, array.get(result, i) / sum_exp)
        result

//@function Applies a specified activation function to an array
//@param arr Input array
//@param activation_type Type: "sigmoid", "tanh", "relu", "leaky_relu", "elu", "gelu", "swish"
//@param alpha Parameter for leaky_relu and elu (default: 0.01)
//@returns Array with activation applied to each element
export apply_activation(array<float> arr, string activation_type, float alpha = 0.01) =>
    if na(arr) or array.size(arr) == 0
        array<float> result = na
        result
    else
        int n = array.size(arr)
        array<float> result = array.new_float(n, 0.0)
        for i = 0 to n - 1
            float x = array.get(arr, i)
            float y = switch activation_type
                "sigmoid" => sigmoid(x)
                "tanh" => tanh(x)
                "relu" => relu(x)
                "leaky_relu" => leaky_relu(x, alpha)
                "elu" => elu(x, alpha)
                "gelu" => gelu(x)
                "swish" => swish(x)
                => x
            array.set(result, i, y)
        result

// =============================================================================
// PREPROCESSING / SCALING
// =============================================================================

//@function Normalizes array values to range [0, 1] using min-max scaling
//@param arr Input array
//@param min_val Optional minimum value (if na, computed from arr)
//@param max_val Optional maximum value (if na, computed from arr)
//@returns Normalized array with values in [0, 1]
export normalize_minmax(array<float> arr, float min_val = na, float max_val = na) =>
    if na(arr) or array.size(arr) == 0
        array<float> result = na
        result
    else
        float actual_min = na(min_val) ? array.min(arr) : min_val
        float actual_max = na(max_val) ? array.max(arr) : max_val
        float val_range = actual_max - actual_min
        int n = array.size(arr)
        array<float> result = array.new_float(n, 0.0)
        if val_range == 0.0
            for i = 0 to n - 1
                array.set(result, i, 0.5)
        else
            for i = 0 to n - 1
                array.set(result, i, (array.get(arr, i) - actual_min) / val_range)
        result

//@function Standardizes array values using z-score normalization
//@param arr Input array
//@param mean_val Optional mean value (if na, computed from arr)
//@param std_val Optional standard deviation (if na, computed from arr)
//@returns Standardized array with zero mean and unit variance
export normalize_zscore(array<float> arr, float mean_val = na, float std_val = na) =>
    if na(arr) or array.size(arr) == 0
        array<float> result = na
        result
    else
        float actual_mean = na(mean_val) ? array.avg(arr) : mean_val
        float actual_std = na(std_val) ? array.stdev(arr) : std_val
        int n = array.size(arr)
        array<float> result = array.new_float(n, 0.0)
        if actual_std == 0.0 or na(actual_std)
            for i = 0 to n - 1
                array.set(result, i, 0.0)
        else
            for i = 0 to n - 1
                array.set(result, i, (array.get(arr, i) - actual_mean) / actual_std)
        result

//@function Standardizes each column of a matrix using z-score normalization
//@param m Input matrix
//@returns Matrix with each column standardized (zero mean, unit variance)
export normalize_matrix_cols(matrix<float> m) =>
    if na(m)
        matrix<float> result = na
        result
    else
        int rows = matrix.rows(m)
        int cols = matrix.columns(m)
        matrix<float> result = matrix.new<float>(rows, cols, 0.0)
        for c = 0 to cols - 1
            float sum = 0.0
            for r = 0 to rows - 1
                sum += matrix.get(m, r, c)
            float mean = sum / rows
            float sum_sq = 0.0
            for r = 0 to rows - 1
                float diff = matrix.get(m, r, c) - mean
                sum_sq += diff * diff
            float std = math.sqrt(sum_sq / rows)
            if std == 0.0
                for r = 0 to rows - 1
                    matrix.set(result, r, c, 0.0)
            else
                for r = 0 to rows - 1
                    matrix.set(result, r, c, (matrix.get(m, r, c) - mean) / std)
        result

//@function Creates and fits a scaler to an array
//@param arr Input array to fit
//@param method Scaling method: "zscore" or "minmax" (default: "zscore")
//@returns Fitted ml_scaler object
export scaler_fit(array<float> arr, string method = "zscore") =>
    ml_scaler scaler = ml_scaler.new()
    scaler.method := method
    if not na(arr) and array.size(arr) > 0
        if method == "minmax"
            scaler.min_vals := array.new_float(1, array.min(arr))
            scaler.max_vals := array.new_float(1, array.max(arr))
        else
            scaler.means := array.new_float(1, array.avg(arr))
            scaler.stds := array.new_float(1, array.stdev(arr))
    scaler

//@function Creates and fits a scaler to a matrix (column-wise)
//@param m Input matrix to fit
//@param method Scaling method: "zscore" or "minmax" (default: "zscore")
//@returns Fitted ml_scaler object with parameters for each column
export scaler_fit_matrix(matrix<float> m, string method = "zscore") =>
    ml_scaler scaler = ml_scaler.new()
    scaler.method := method
    if not na(m)
        int rows = matrix.rows(m)
        int cols = matrix.columns(m)
        if method == "minmax"
            scaler.min_vals := array.new_float(cols, 0.0)
            scaler.max_vals := array.new_float(cols, 0.0)
            for c = 0 to cols - 1
                float col_min = matrix.get(m, 0, c)
                float col_max = matrix.get(m, 0, c)
                for r = 1 to rows - 1
                    float val = matrix.get(m, r, c)
                    if val < col_min
                        col_min := val
                    if val > col_max
                        col_max := val
                array.set(scaler.min_vals, c, col_min)
                array.set(scaler.max_vals, c, col_max)
        else
            scaler.means := array.new_float(cols, 0.0)
            scaler.stds := array.new_float(cols, 0.0)
            for c = 0 to cols - 1
                float sum = 0.0
                for r = 0 to rows - 1
                    sum += matrix.get(m, r, c)
                float mean = sum / rows
                float sum_sq = 0.0
                for r = 0 to rows - 1
                    float diff = matrix.get(m, r, c) - mean
                    sum_sq += diff * diff
                array.set(scaler.means, c, mean)
                array.set(scaler.stds, c, math.sqrt(sum_sq / rows))
    scaler

//@function Transforms an array using a fitted scaler
//@param scaler Fitted ml_scaler object
//@param arr Array to transform
//@returns Transformed array
export scaler_transform(ml_scaler scaler, array<float> arr) =>
    if na(arr) or array.size(arr) == 0
        array<float> result = na
        result
    else
        int n = array.size(arr)
        array<float> result = array.new_float(n, 0.0)
        if scaler.method == "minmax"
            float min_v = array.size(scaler.min_vals) > 0 ? array.get(scaler.min_vals, 0) : 0.0
            float max_v = array.size(scaler.max_vals) > 0 ? array.get(scaler.max_vals, 0) : 1.0
            float val_range = max_v - min_v
            if val_range == 0.0
                for i = 0 to n - 1
                    array.set(result, i, 0.5)
            else
                for i = 0 to n - 1
                    array.set(result, i, (array.get(arr, i) - min_v) / val_range)
        else
            float mean = array.size(scaler.means) > 0 ? array.get(scaler.means, 0) : 0.0
            float std = array.size(scaler.stds) > 0 ? array.get(scaler.stds, 0) : 1.0
            if std == 0.0
                for i = 0 to n - 1
                    array.set(result, i, 0.0)
            else
                for i = 0 to n - 1
                    array.set(result, i, (array.get(arr, i) - mean) / std)
        result

//@function Transforms a matrix using a fitted scaler (column-wise)
//@param scaler Fitted ml_scaler object
//@param m Matrix to transform
//@returns Transformed matrix
export scaler_transform_matrix(ml_scaler scaler, matrix<float> m) =>
    if na(m)
        matrix<float> result = na
        result
    else
        int rows = matrix.rows(m)
        int cols = matrix.columns(m)
        matrix<float> result = matrix.new<float>(rows, cols, 0.0)
        for c = 0 to cols - 1
            if scaler.method == "minmax"
                float min_v = c < array.size(scaler.min_vals) ? array.get(scaler.min_vals, c) : 0.0
                float max_v = c < array.size(scaler.max_vals) ? array.get(scaler.max_vals, c) : 1.0
                float val_range = max_v - min_v
                if val_range == 0.0
                    for r = 0 to rows - 1
                        matrix.set(result, r, c, 0.5)
                else
                    for r = 0 to rows - 1
                        matrix.set(result, r, c, (matrix.get(m, r, c) - min_v) / val_range)
            else
                float mean = c < array.size(scaler.means) ? array.get(scaler.means, c) : 0.0
                float std = c < array.size(scaler.stds) ? array.get(scaler.stds, c) : 1.0
                if std == 0.0
                    for r = 0 to rows - 1
                        matrix.set(result, r, c, 0.0)
                else
                    for r = 0 to rows - 1
                        matrix.set(result, r, c, (matrix.get(m, r, c) - mean) / std)
        result

//@function Clips a value to a specified range
//@param x Input value
//@param lo Lower bound
//@param hi Upper bound
//@returns Value clipped to [lo, hi]
export clip(float x, float lo, float hi) =>
    na(x) ? float(na) : math.max(lo, math.min(hi, x))

//@function Clips all values in an array to a specified range
//@param arr Input array
//@param lo Lower bound
//@param hi Upper bound
//@returns Array with all values clipped to [lo, hi]
export clip_array(array<float> arr, float lo, float hi) =>
    if na(arr) or array.size(arr) == 0
        array<float> result = na
        result
    else
        int n = array.size(arr)
        array<float> result = array.new_float(n, 0.0)
        for i = 0 to n - 1
            array.set(result, i, math.max(lo, math.min(hi, array.get(arr, i))))
        result

// =============================================================================
// LOSS FUNCTIONS
// =============================================================================

//@function Calculates Mean Squared Error loss
//@param predicted Array of predicted values
//@param actual Array of actual (ground truth) values
//@returns Mean Squared Error
export loss_mse(array<float> predicted, array<float> actual) =>
    if na(predicted) or na(actual)
        float(na)
    else
        int n = math.min(array.size(predicted), array.size(actual))
        if n == 0
            float(na)
        else
            float sum_sq = 0.0
            for i = 0 to n - 1
                float diff = array.get(predicted, i) - array.get(actual, i)
                sum_sq += diff * diff
            sum_sq / n

//@function Calculates Root Mean Squared Error loss
//@param predicted Array of predicted values
//@param actual Array of actual (ground truth) values
//@returns Root Mean Squared Error
export loss_rmse(array<float> predicted, array<float> actual) =>
    float mse_val = loss_mse(predicted, actual)
    na(mse_val) ? float(na) : math.sqrt(mse_val)

//@function Calculates Mean Absolute Error loss
//@param predicted Array of predicted values
//@param actual Array of actual (ground truth) values
//@returns Mean Absolute Error
export loss_mae(array<float> predicted, array<float> actual) =>
    if na(predicted) or na(actual)
        float(na)
    else
        int n = math.min(array.size(predicted), array.size(actual))
        if n == 0
            float(na)
        else
            float sum_abs = 0.0
            for i = 0 to n - 1
                sum_abs += math.abs(array.get(predicted, i) - array.get(actual, i))
            sum_abs / n

//@function Calculates Binary Cross-Entropy loss
//@param predicted Array of predicted probabilities (0-1)
//@param actual Array of actual labels (0 or 1)
//@returns Binary Cross-Entropy loss
export loss_binary_crossentropy(array<float> predicted, array<float> actual) =>
    if na(predicted) or na(actual)
        float(na)
    else
        int n = math.min(array.size(predicted), array.size(actual))
        if n == 0
            float(na)
        else
            float sum_loss = 0.0
            for i = 0 to n - 1
                float p = math.max(EPSILON_TINY, math.min(1.0 - EPSILON_TINY, array.get(predicted, i)))
                float y = array.get(actual, i)
                sum_loss += -(y * math.log(p) + (1.0 - y) * math.log(1.0 - p))
            sum_loss / n

//@function Calculates Huber loss (smooth approximation of MAE)
//@param predicted Array of predicted values
//@param actual Array of actual (ground truth) values
//@param delta Threshold at which to change from quadratic to linear (default: 1.0)
//@returns Huber loss
export loss_huber(array<float> predicted, array<float> actual, float delta = 1.0) =>
    if na(predicted) or na(actual)
        float(na)
    else
        int n = math.min(array.size(predicted), array.size(actual))
        if n == 0
            float(na)
        else
            float sum_loss = 0.0
            for i = 0 to n - 1
                float diff = math.abs(array.get(predicted, i) - array.get(actual, i))
                if diff <= delta
                    sum_loss += 0.5 * diff * diff
                else
                    sum_loss += delta * (diff - 0.5 * delta)
            sum_loss / n

// =============================================================================
// OPTIMIZATION
// =============================================================================

//@function Performs a single gradient descent step
//@param weights Current weight values
//@param gradients Gradient values
//@param lr Learning rate
//@returns Updated weights after one gradient step
export gradient_step(array<float> weights, array<float> gradients, float lr) =>
    if na(weights) or na(gradients)
        array<float> result = na
        result
    else
        int n = math.min(array.size(weights), array.size(gradients))
        array<float> result = array.new_float(n, 0.0)
        for i = 0 to n - 1
            array.set(result, i, array.get(weights, i) - lr * array.get(gradients, i))
        result

//@function Performs a single Adam optimizer step
//@param weights Current weight values
//@param gradients Gradient values
//@param m First moment estimates (momentum)
//@param v Second moment estimates (RMSprop)
//@param lr Learning rate
//@param beta1 Exponential decay rate for first moment (default: 0.9)
//@param beta2 Exponential decay rate for second moment (default: 0.999)
//@param t Current timestep (default: 1)
//@param epsilon Small constant for numerical stability (default: 1e-8)
//@returns Tuple of [new_weights, new_m, new_v]
export adam_step(array<float> weights, array<float> gradients, array<float> m, array<float> v, float lr, float beta1 = 0.9, float beta2 = 0.999, int t = 1, float epsilon = 1e-8) =>
    array<float> new_weights = na
    array<float> new_m = na
    array<float> new_v = na
    if not na(weights) and not na(gradients) and not na(m) and not na(v)
        int n = math.min(math.min(math.min(array.size(weights), array.size(gradients)), array.size(m)), array.size(v))
        new_weights := array.new_float(n, 0.0)
        new_m := array.new_float(n, 0.0)
        new_v := array.new_float(n, 0.0)
        float bc1 = 1.0 - math.pow(beta1, t)
        float bc2 = 1.0 - math.pow(beta2, t)
        for i = 0 to n - 1
            float g = array.get(gradients, i)
            float m_val = beta1 * array.get(m, i) + (1.0 - beta1) * g
            float v_val = beta2 * array.get(v, i) + (1.0 - beta2) * g * g
            array.set(new_m, i, m_val)
            array.set(new_v, i, v_val)
            float m_hat = m_val / bc1
            float v_hat = v_val / bc2
            array.set(new_weights, i, array.get(weights, i) - lr * m_hat / (math.sqrt(v_hat) + epsilon))
    [new_weights, new_m, new_v]

//@function Clips gradients by global norm to prevent exploding gradients
//@param gradients Array of gradient values
//@param max_norm Maximum allowed norm
//@returns Clipped gradient array
export clip_gradients(array<float> gradients, float max_norm) =>
    if na(gradients) or array.size(gradients) == 0
        array<float> result = na
        result
    else
        float norm_sq = 0.0
        for i = 0 to array.size(gradients) - 1
            float g = array.get(gradients, i)
            norm_sq += g * g
        float norm = math.sqrt(norm_sq)
        int n = array.size(gradients)
        array<float> result = array.new_float(n, 0.0)
        if norm > max_norm
            float scale = max_norm / norm
            for i = 0 to n - 1
                array.set(result, i, array.get(gradients, i) * scale)
        else
            for i = 0 to n - 1
                array.set(result, i, array.get(gradients, i))
        result

//@function Calculates decayed learning rate using inverse time decay
//@param initial_lr Initial learning rate
//@param decay_rate Rate of decay
//@param step Current training step
//@returns Decayed learning rate
export lr_decay(float initial_lr, float decay_rate, int step) =>
    initial_lr / (1.0 + decay_rate * step)

//@function Calculates learning rate using cosine annealing schedule
//@param initial_lr Initial (maximum) learning rate
//@param min_lr Minimum learning rate
//@param step Current training step
//@param total_steps Total number of training steps
//@returns Annealed learning rate
export lr_cosine_annealing(float initial_lr, float min_lr, int step, int total_steps) =>
    min_lr + 0.5 * (initial_lr - min_lr) * (1.0 + math.cos(math.pi * step / total_steps))

// =============================================================================
// KNN
// =============================================================================

//@function Creates a new K-Nearest Neighbors model
//@param k Number of neighbors to consider (default: 5)
//@param distance_type Distance metric: "euclidean", "manhattan", "cosine", "chebyshev" (default: "euclidean")
//@returns New ml_knn model instance
export knn_create(int k = 5, string distance_type = "euclidean") =>
    ml_knn model = ml_knn.new()
    model.k := math.max(1, k)
    bool is_valid = distance_type == "euclidean" or distance_type == "manhattan" or distance_type == "cosine" or distance_type == "chebyshev"
    model.distance_type := is_valid ? distance_type : "euclidean"
    model

//@function Fits a KNN model with training data
//@param model ml_knn model instance
//@param X Training feature matrix (samples x features)
//@param y Training labels array
//@returns Fitted ml_knn model
export knn_fit(ml_knn model, matrix<float> X, array<int> y) =>
    if na(X) or na(y)
        model
    else
        model.X_train := matrix.copy(X)
        model.y_train := array.copy(y)
        model

find_k_nearest(ml_knn model, array<float> x) =>
    array<int> k_indices = na
    array<float> k_distances = na
    if not na(model.X_train) and not na(x)
        int n_samples = matrix.rows(model.X_train)
        int n_features = matrix.columns(model.X_train)
        int k = math.min(model.k, n_samples)
        array<float> distances = array.new_float(n_samples, 0.0)
        array<int> indices = array.new_int(n_samples, 0)
        array<float> sample = array.new_float(n_features, 0.0)
        for i = 0 to n_samples - 1
            for f = 0 to n_features - 1
                array.set(sample, f, matrix.get(model.X_train, i, f))
            float dist = switch model.distance_type
                "euclidean" => euclidean(x, sample)
                "manhattan" => manhattan(x, sample)
                "cosine" => cosine_distance(x, sample)
                "chebyshev" => chebyshev(x, sample)
                => euclidean(x, sample)
            array.set(distances, i, dist)
            array.set(indices, i, i)
        k_indices := array.new_int(k, 0)
        k_distances := array.new_float(k, 0.0)
        for i = 0 to k - 1
            int min_idx = i
            float min_dist = array.get(distances, i)
            for j = i + 1 to n_samples - 1
                if array.get(distances, j) < min_dist
                    min_dist := array.get(distances, j)
                    min_idx := j
            if min_idx != i
                float temp_dist = array.get(distances, i)
                int temp_idx = array.get(indices, i)
                array.set(distances, i, array.get(distances, min_idx))
                array.set(indices, i, array.get(indices, min_idx))
                array.set(distances, min_idx, temp_dist)
                array.set(indices, min_idx, temp_idx)
            array.set(k_indices, i, array.get(indices, i))
            array.set(k_distances, i, array.get(distances, i))
    [k_indices, k_distances]

//@function Predicts the class label for a single sample using KNN
//@param model Fitted ml_knn model
//@param x Feature vector for prediction
//@returns Predicted class label
export knn_predict(ml_knn model, array<float> x) =>
    if na(model.X_train) or na(model.y_train) or na(x)
        int(na)
    else
        [k_indices, k_distances] = find_k_nearest(model, x)
        if na(k_indices)
            int(na)
        else
            int max_label = 0
            for i = 0 to array.size(model.y_train) - 1
                int lbl = array.get(model.y_train, i)
                if lbl > max_label
                    max_label := lbl
            array<int> votes = array.new_int(max_label + 1, 0)
            for i = 0 to array.size(k_indices) - 1
                int idx = array.get(k_indices, i)
                int label = array.get(model.y_train, idx)
                array.set(votes, label, array.get(votes, label) + 1)
            int best_label = 0
            int best_count = 0
            for lbl = 0 to max_label
                if array.get(votes, lbl) > best_count
                    best_count := array.get(votes, lbl)
                    best_label := lbl
            best_label

//@function Predicts class probabilities for a single sample using KNN
//@param model Fitted ml_knn model
//@param x Feature vector for prediction
//@returns Array of class probabilities
export knn_predict_proba(ml_knn model, array<float> x) =>
    if na(model.X_train) or na(model.y_train) or na(x)
        array<float> result = na
        result
    else
        [k_indices, k_distances] = find_k_nearest(model, x)
        if na(k_indices)
            array<float> result = na
            result
        else
            int max_label = 0
            for i = 0 to array.size(model.y_train) - 1
                int lbl = array.get(model.y_train, i)
                if lbl > max_label
                    max_label := lbl
            int n_classes = max_label + 1
            array<float> probs = array.new_float(n_classes, 0.0)
            int k = array.size(k_indices)
            for i = 0 to k - 1
                int idx = array.get(k_indices, i)
                int label = array.get(model.y_train, idx)
                array.set(probs, label, array.get(probs, label) + 1.0)
            for lbl = 0 to n_classes - 1
                array.set(probs, lbl, array.get(probs, lbl) / k)
            probs

//@function Predicts class labels for multiple samples using KNN
//@param model Fitted ml_knn model
//@param X Feature matrix (samples x features)
//@returns Array of predicted class labels
export knn_batch_predict(ml_knn model, matrix<float> X) =>
    if na(model.X_train) or na(model.y_train) or na(X)
        array<int> result = na
        result
    else
        int n_samples = matrix.rows(X)
        int n_features = matrix.columns(X)
        array<int> predictions = array.new_int(n_samples, 0)
        array<float> query = array.new_float(n_features, 0.0)
        for i = 0 to n_samples - 1
            for f = 0 to n_features - 1
                array.set(query, f, matrix.get(X, i, f))
            array.set(predictions, i, knn_predict(model, query))
        predictions

// =============================================================================
// LINEAR REGRESSION
// =============================================================================

//@function Fits an Ordinary Least Squares linear regression model
//@param X Feature matrix (samples x features)
//@param y Target values array
//@returns Fitted ml_linreg model
export linreg_fit(matrix<float> X, array<float> y) =>
    if na(X) or na(y)
        ml_linreg model = ml_linreg.new()
        model
    else
        int n_samples = matrix.rows(X)
        int n_features = matrix.columns(X)
        if n_samples == 0 or array.size(y) < n_samples
            ml_linreg model = ml_linreg.new()
            model
        else
            matrix<float> X_bias = matrix.new<float>(n_samples, n_features + 1, 0.0)
            for i = 0 to n_samples - 1
                matrix.set(X_bias, i, 0, 1.0)
                for j = 0 to n_features - 1
                    matrix.set(X_bias, i, j + 1, matrix.get(X, i, j))
            matrix<float> y_mat = matrix.new<float>(n_samples, 1, 0.0)
            for i = 0 to n_samples - 1
                matrix.set(y_mat, i, 0, array.get(y, i))
            matrix<float> Xt = matrix.transpose(X_bias)
            matrix<float> XtX = matrix.mult(Xt, X_bias)
            matrix<float> XtX_inv = matrix.pinv(XtX)
            matrix<float> Xty = matrix.mult(Xt, y_mat)
            matrix<float> w = matrix.mult(XtX_inv, Xty)
            ml_linreg model = ml_linreg.new()
            model.intercept := matrix.get(w, 0, 0)
            model.coefficients := array.new_float(n_features, 0.0)
            for j = 0 to n_features - 1
                array.set(model.coefficients, j, matrix.get(w, j + 1, 0))
            model.lambda := 0.0
            model

//@function Fits a Ridge regression model with L2 regularization
//@param X Feature matrix (samples x features)
//@param y Target values array
//@param lambda Regularization strength
//@returns Fitted ml_linreg model
export ridge_fit(matrix<float> X, array<float> y, float lambda) =>
    if na(X) or na(y) or na(lambda)
        ml_linreg model = ml_linreg.new()
        model
    else
        int n_samples = matrix.rows(X)
        int n_features = matrix.columns(X)
        if n_samples == 0 or array.size(y) < n_samples
            ml_linreg model = ml_linreg.new()
            model
        else
            matrix<float> X_bias = matrix.new<float>(n_samples, n_features + 1, 0.0)
            for i = 0 to n_samples - 1
                matrix.set(X_bias, i, 0, 1.0)
                for j = 0 to n_features - 1
                    matrix.set(X_bias, i, j + 1, matrix.get(X, i, j))
            matrix<float> y_mat = matrix.new<float>(n_samples, 1, 0.0)
            for i = 0 to n_samples - 1
                matrix.set(y_mat, i, 0, array.get(y, i))
            matrix<float> Xt = matrix.transpose(X_bias)
            matrix<float> XtX = matrix.mult(Xt, X_bias)
            int dim = n_features + 1
            for i = 1 to dim - 1
                matrix.set(XtX, i, i, matrix.get(XtX, i, i) + lambda)
            matrix<float> XtX_inv = matrix.pinv(XtX)
            matrix<float> Xty = matrix.mult(Xt, y_mat)
            matrix<float> w = matrix.mult(XtX_inv, Xty)
            ml_linreg model = ml_linreg.new()
            model.intercept := matrix.get(w, 0, 0)
            model.coefficients := array.new_float(n_features, 0.0)
            for j = 0 to n_features - 1
                array.set(model.coefficients, j, matrix.get(w, j + 1, 0))
            model.lambda := lambda
            model

//@function Predicts a single value using the linear regression model
//@param model Fitted ml_linreg model
//@param x Feature vector for prediction
//@returns Predicted value
export linreg_predict(ml_linreg model, array<float> x) =>
    if na(model.coefficients) or na(x)
        float(na)
    else
        int n_features = math.min(array.size(model.coefficients), array.size(x))
        float prediction = model.intercept
        for i = 0 to n_features - 1
            prediction += array.get(model.coefficients, i) * array.get(x, i)
        prediction

//@function Predicts values for multiple samples using linear regression
//@param model Fitted ml_linreg model
//@param X Feature matrix (samples x features)
//@returns Array of predicted values
export linreg_predict_batch(ml_linreg model, matrix<float> X) =>
    if na(model.coefficients) or na(X)
        array<float> result = na
        result
    else
        int n_samples = matrix.rows(X)
        int n_features = matrix.columns(X)
        array<float> predictions = array.new_float(n_samples, 0.0)
        array<float> x = array.new_float(n_features, 0.0)
        for i = 0 to n_samples - 1
            for j = 0 to n_features - 1
                array.set(x, j, matrix.get(X, i, j))
            array.set(predictions, i, linreg_predict(model, x))
        predictions

//@function Calculates R-squared score for linear regression model
//@param model Fitted ml_linreg model
//@param X Feature matrix (samples x features)
//@param y True target values
//@returns R-squared coefficient of determination
export linreg_score(ml_linreg model, matrix<float> X, array<float> y) =>
    if na(model.coefficients) or na(X) or na(y)
        float(na)
    else
        array<float> predictions = linreg_predict_batch(model, X)
        if na(predictions)
            float(na)
        else
            int n = math.min(array.size(predictions), array.size(y))
            float y_mean = 0.0
            for i = 0 to n - 1
                y_mean += array.get(y, i)
            y_mean /= n
            float ss_res = 0.0
            float ss_tot = 0.0
            for i = 0 to n - 1
                float y_true = array.get(y, i)
                float y_pred = array.get(predictions, i)
                ss_res += math.pow(y_true - y_pred, 2)
                ss_tot += math.pow(y_true - y_mean, 2)
            ss_tot == 0.0 ? 1.0 : 1.0 - ss_res / ss_tot

// =============================================================================
// LOGISTIC REGRESSION
// =============================================================================

//@function Creates a new logistic regression model
//@param n_features Number of input features
//@param learning_rate Learning rate for gradient descent (default: 0.01)
//@param iterations Number of training iterations (default: 50)
//@returns New ml_logreg model instance
export logreg_create(int n_features, float learning_rate = 0.01, int iterations = 50) =>
    ml_logreg model = ml_logreg.new()
    model.weights := array.new_float(n_features, 0.0)
    model.bias := 0.0
    model.learning_rate := learning_rate
    model.iterations := iterations
    model

//@function Fits a logistic regression model using gradient descent
//@param model ml_logreg model instance
//@param X Training feature matrix (samples x features)
//@param y Binary training labels (0 or 1)
//@returns Fitted ml_logreg model
export logreg_fit(ml_logreg model, matrix<float> X, array<int> y) =>
    if na(X) or na(y) or na(model.weights)
        model
    else
        int n_samples = matrix.rows(X)
        int n_features = matrix.columns(X)
        array<float> x_sample = array.new_float(n_features, 0.0)
        for iter = 0 to model.iterations - 1
            array<float> dw = array.new_float(n_features, 0.0)
            float db = 0.0
            for i = 0 to n_samples - 1
                for f = 0 to n_features - 1
                    array.set(x_sample, f, matrix.get(X, i, f))
                float z = model.bias
                for f = 0 to n_features - 1
                    z += array.get(model.weights, f) * array.get(x_sample, f)
                float pred = sigmoid(z)
                float error = pred - float(array.get(y, i))
                db += error
                for f = 0 to n_features - 1
                    array.set(dw, f, array.get(dw, f) + error * array.get(x_sample, f))
            model.bias -= model.learning_rate * db / n_samples
            for f = 0 to n_features - 1
                array.set(model.weights, f, array.get(model.weights, f) - model.learning_rate * array.get(dw, f) / n_samples)
        model

//@function Predicts probability of positive class for a single sample
//@param model Fitted ml_logreg model
//@param x Feature vector for prediction
//@returns Probability of positive class (0-1)
export logreg_predict_proba(ml_logreg model, array<float> x) =>
    if na(model.weights) or na(x)
        float(na)
    else
        int n = math.min(array.size(model.weights), array.size(x))
        float z = model.bias
        for i = 0 to n - 1
            z += array.get(model.weights, i) * array.get(x, i)
        sigmoid(z)

//@function Predicts binary class label for a single sample
//@param model Fitted ml_logreg model
//@param x Feature vector for prediction
//@param threshold Decision threshold (default: 0.5)
//@returns Predicted class label (0 or 1)
export logreg_predict(ml_logreg model, array<float> x, float threshold = 0.5) =>
    float prob = logreg_predict_proba(model, x)
    na(prob) ? int(na) : (prob >= threshold ? 1 : 0)

//@function Predicts binary class labels for multiple samples
//@param model Fitted ml_logreg model
//@param X Feature matrix (samples x features)
//@param threshold Decision threshold (default: 0.5)
//@returns Array of predicted class labels
export logreg_batch_predict(ml_logreg model, matrix<float> X, float threshold = 0.5) =>
    if na(model.weights) or na(X)
        array<int> result = na
        result
    else
        int n_samples = matrix.rows(X)
        int n_features = matrix.columns(X)
        array<int> predictions = array.new_int(n_samples, 0)
        array<float> x = array.new_float(n_features, 0.0)
        for i = 0 to n_samples - 1
            for f = 0 to n_features - 1
                array.set(x, f, matrix.get(X, i, f))
            array.set(predictions, i, logreg_predict(model, x, threshold))
        predictions

// =============================================================================
// NAIVE BAYES
// =============================================================================

//@function Creates a new Gaussian Naive Bayes model
//@param n_classes Number of classes (default: 2)
//@returns New ml_nb model instance
export nb_create(int n_classes = 2) =>
    ml_nb model = ml_nb.new()
    model.n_classes := n_classes
    model

//@function Fits a Gaussian Naive Bayes model
//@param model ml_nb model instance
//@param X Training feature matrix (samples x features)
//@param y Training labels array
//@returns Fitted ml_nb model
export nb_fit(ml_nb model, matrix<float> X, array<int> y) =>
    if na(X) or na(y)
        model
    else
        int n_samples = matrix.rows(X)
        int n_features = matrix.columns(X)
        int n_classes = model.n_classes
        model.class_priors := array.new_float(n_classes, 0.0)
        model.means := matrix.new<float>(n_classes, n_features, 0.0)
        model.variances := matrix.new<float>(n_classes, n_features, 0.0)
        array<int> class_counts = array.new_int(n_classes, 0)
        for i = 0 to n_samples - 1
            int label = array.get(y, i)
            if label >= 0 and label < n_classes
                array.set(class_counts, label, array.get(class_counts, label) + 1)
                for f = 0 to n_features - 1
                    float val = matrix.get(X, i, f)
                    matrix.set(model.means, label, f, matrix.get(model.means, label, f) + val)
        for c = 0 to n_classes - 1
            int count = array.get(class_counts, c)
            array.set(model.class_priors, c, float(count) / n_samples)
            if count > 0
                for f = 0 to n_features - 1
                    matrix.set(model.means, c, f, matrix.get(model.means, c, f) / count)
        for i = 0 to n_samples - 1
            int label = array.get(y, i)
            if label >= 0 and label < n_classes
                for f = 0 to n_features - 1
                    float diff = matrix.get(X, i, f) - matrix.get(model.means, label, f)
                    matrix.set(model.variances, label, f, matrix.get(model.variances, label, f) + diff * diff)
        for c = 0 to n_classes - 1
            int count = array.get(class_counts, c)
            if count > 1
                for f = 0 to n_features - 1
                    matrix.set(model.variances, c, f, matrix.get(model.variances, c, f) / count + EPSILON_SMALL)
            else
                for f = 0 to n_features - 1
                    matrix.set(model.variances, c, f, EPSILON_SMALL)
        model

//@function Predicts class probabilities for a single sample using Naive Bayes
//@param model Fitted ml_nb model
//@param x Feature vector for prediction
//@returns Array of class probabilities
export nb_predict_proba(ml_nb model, array<float> x) =>
    if na(model.means) or na(model.variances) or na(x)
        array<float> result = na
        result
    else
        int n_classes = model.n_classes
        int n_features = array.size(x)
        array<float> log_probs = array.new_float(n_classes, 0.0)
        for c = 0 to n_classes - 1
            float log_prob = math.log(math.max(EPSILON_TINY, array.get(model.class_priors, c)))
            for f = 0 to n_features - 1
                float mean = matrix.get(model.means, c, f)
                float variance = matrix.get(model.variances, c, f)
                float x_val = array.get(x, f)
                float diff = x_val - mean
                log_prob += -0.5 * (LOG_2PI + math.log(variance) + diff * diff / variance)
            array.set(log_probs, c, log_prob)
        float max_log = array.max(log_probs)
        float sum_exp = 0.0
        array<float> probs = array.new_float(n_classes, 0.0)
        for c = 0 to n_classes - 1
            float exp_val = math.exp(array.get(log_probs, c) - max_log)
            array.set(probs, c, exp_val)
            sum_exp += exp_val
        if sum_exp > 0.0
            for c = 0 to n_classes - 1
                array.set(probs, c, array.get(probs, c) / sum_exp)
        probs

//@function Predicts the class label for a single sample using Naive Bayes
//@param model Fitted ml_nb model
//@param x Feature vector for prediction
//@returns Predicted class label
export nb_predict(ml_nb model, array<float> x) =>
    array<float> probs = nb_predict_proba(model, x)
    if na(probs)
        int(na)
    else
        int best_class = 0
        float best_prob = array.get(probs, 0)
        for c = 1 to array.size(probs) - 1
            if array.get(probs, c) > best_prob
                best_prob := array.get(probs, c)
                best_class := c
        best_class

// =============================================================================
// NEURAL NETWORK
// =============================================================================

//@function Creates a new multi-layer perceptron neural network
//@param layers Array of layer sizes [input, hidden..., output]
//@param activation Activation function: "relu", "sigmoid", "tanh", etc. (default: "relu")
//@returns New ml_nn model instance with randomly initialized weights
export nn_create(array<int> layers, string activation = "relu") =>
    ml_nn model = ml_nn.new()
    model.layers := array.copy(layers)
    model.activation := activation
    int n_layers = array.size(layers)
    int total_weights = 0
    int total_biases = 0
    model.weight_offsets := array.new_int(n_layers - 1, 0)
    model.bias_offsets := array.new_int(n_layers - 1, 0)
    for l = 0 to n_layers - 2
        array.set(model.weight_offsets, l, total_weights)
        array.set(model.bias_offsets, l, total_biases)
        int in_size = array.get(layers, l)
        int out_size = array.get(layers, l + 1)
        total_weights += in_size * out_size
        total_biases += out_size
    int max_layer_size = array.get(layers, 0)
    for l = 1 to n_layers - 1
        if array.get(layers, l) > max_layer_size
            max_layer_size := array.get(layers, l)
    model.weights := matrix.new<float>(total_weights, 1, 0.0)
    model.biases := array.new_float(total_biases, 0.0)
    for l = 0 to n_layers - 2
        int in_size = array.get(layers, l)
        int out_size = array.get(layers, l + 1)
        float std = math.sqrt(2.0 / in_size)
        int w_offset = array.get(model.weight_offsets, l)
        for i = 0 to in_size - 1
            for j = 0 to out_size - 1
                float rand_val = (math.random() - 0.5) * 2.0 * std
                matrix.set(model.weights, w_offset + i * out_size + j, 0, rand_val)
    model

nn_get_weight(ml_nn model, int layer, int in_idx, int out_idx) =>
    int in_size = array.get(model.layers, layer)
    int out_size = array.get(model.layers, layer + 1)
    int offset = array.get(model.weight_offsets, layer)
    matrix.get(model.weights, offset + in_idx * out_size + out_idx, 0)

nn_get_bias(ml_nn model, int layer, int out_idx) =>
    int offset = array.get(model.bias_offsets, layer)
    array.get(model.biases, offset + out_idx)

//@function Performs forward propagation through the neural network
//@param model ml_nn model instance
//@param x Input feature vector
//@returns Output array (softmax probabilities for classification)
export nn_forward(ml_nn model, array<float> x) =>
    if na(model.weights) or na(x)
        array<float> result = na
        result
    else
        array<float> current = array.copy(x)
        int n_conn_layers = array.size(model.layers) - 1
        for l = 0 to n_conn_layers - 1
            int in_size = array.get(model.layers, l)
            int out_size = array.get(model.layers, l + 1)
            array<float> output = array.new_float(out_size, 0.0)
            for j = 0 to out_size - 1
                float sum = nn_get_bias(model, l, j)
                for i = 0 to in_size - 1
                    if i < array.size(current)
                        sum += array.get(current, i) * nn_get_weight(model, l, i, j)
                array.set(output, j, sum)
            if l < n_conn_layers - 1
                current := apply_activation(output, model.activation)
            else
                current := softmax(output)
        current

//@function Predicts the class label using the neural network
//@param model ml_nn model instance
//@param x Input feature vector
//@returns Predicted class label (index of highest probability)
export nn_predict_class(ml_nn model, array<float> x) =>
    array<float> probs = nn_forward(model, x)
    if na(probs)
        int(na)
    else
        int best_class = 0
        float best_prob = array.get(probs, 0)
        for i = 1 to array.size(probs) - 1
            if array.get(probs, i) > best_prob
                best_prob := array.get(probs, i)
                best_class := i
        best_class

// =============================================================================
// METRICS
// =============================================================================

//@function Calculates classification accuracy
//@param y_true Array of true class labels
//@param y_pred Array of predicted class labels
//@returns Accuracy score (0-1)
export accuracy(array<int> y_true, array<int> y_pred) =>
    if na(y_true) or na(y_pred)
        float(na)
    else
        int n = math.min(array.size(y_true), array.size(y_pred))
        if n == 0
            float(na)
        else
            int correct = 0
            for i = 0 to n - 1
                if array.get(y_true, i) == array.get(y_pred, i)
                    correct += 1
            float(correct) / n

//@function Calculates precision for binary classification
//@param y_true Array of true class labels
//@param y_pred Array of predicted class labels
//@param positive_class Label of positive class (default: 1)
//@returns Precision score (0-1)
export precision(array<int> y_true, array<int> y_pred, int positive_class = 1) =>
    if na(y_true) or na(y_pred)
        float(na)
    else
        int n = math.min(array.size(y_true), array.size(y_pred))
        int tp = 0
        int fp = 0
        for i = 0 to n - 1
            if array.get(y_pred, i) == positive_class
                if array.get(y_true, i) == positive_class
                    tp += 1
                else
                    fp += 1
        (tp + fp) == 0 ? 0.0 : float(tp) / (tp + fp)

//@function Calculates recall (sensitivity) for binary classification
//@param y_true Array of true class labels
//@param y_pred Array of predicted class labels
//@param positive_class Label of positive class (default: 1)
//@returns Recall score (0-1)
export recall(array<int> y_true, array<int> y_pred, int positive_class = 1) =>
    if na(y_true) or na(y_pred)
        float(na)
    else
        int n = math.min(array.size(y_true), array.size(y_pred))
        int tp = 0
        int fn = 0
        for i = 0 to n - 1
            if array.get(y_true, i) == positive_class
                if array.get(y_pred, i) == positive_class
                    tp += 1
                else
                    fn += 1
        (tp + fn) == 0 ? 0.0 : float(tp) / (tp + fn)

//@function Calculates F1 score (harmonic mean of precision and recall)
//@param y_true Array of true class labels
//@param y_pred Array of predicted class labels
//@param positive_class Label of positive class (default: 1)
//@returns F1 score (0-1)
export f1_score(array<int> y_true, array<int> y_pred, int positive_class = 1) =>
    float p = precision(y_true, y_pred, positive_class)
    float r = recall(y_true, y_pred, positive_class)
    if na(p) or na(r) or (p + r) == 0.0
        0.0
    else
        2.0 * p * r / (p + r)

//@function Calculates R-squared (coefficient of determination) for regression
//@param y_true Array of true values
//@param y_pred Array of predicted values
//@returns R-squared score
export r_squared(array<float> y_true, array<float> y_pred) =>
    if na(y_true) or na(y_pred)
        float(na)
    else
        int n = math.min(array.size(y_true), array.size(y_pred))
        if n == 0
            float(na)
        else
            float y_mean = 0.0
            for i = 0 to n - 1
                y_mean += array.get(y_true, i)
            y_mean /= n
            float ss_res = 0.0
            float ss_tot = 0.0
            for i = 0 to n - 1
                float y_t = array.get(y_true, i)
                float y_p = array.get(y_pred, i)
                ss_res += math.pow(y_t - y_p, 2)
                ss_tot += math.pow(y_t - y_mean, 2)
            ss_tot == 0.0 ? 1.0 : 1.0 - ss_res / ss_tot

//@function Calculates Mean Squared Error for regression
//@param y_true Array of true values
//@param y_pred Array of predicted values
//@returns Mean Squared Error
export mse(array<float> y_true, array<float> y_pred) =>
    if na(y_true) or na(y_pred)
        float(na)
    else
        int n = math.min(array.size(y_true), array.size(y_pred))
        if n == 0
            float(na)
        else
            float sum_sq = 0.0
            for i = 0 to n - 1
                float diff = array.get(y_true, i) - array.get(y_pred, i)
                sum_sq += diff * diff
            sum_sq / n

//@function Calculates Root Mean Squared Error for regression
//@param y_true Array of true values
//@param y_pred Array of predicted values
//@returns Root Mean Squared Error
export rmse(array<float> y_true, array<float> y_pred) =>
    float mse_val = mse(y_true, y_pred)
    na(mse_val) ? float(na) : math.sqrt(mse_val)

//@function Calculates Mean Absolute Error for regression
//@param y_true Array of true values
//@param y_pred Array of predicted values
//@returns Mean Absolute Error
export mae(array<float> y_true, array<float> y_pred) =>
    if na(y_true) or na(y_pred)
        float(na)
    else
        int n = math.min(array.size(y_true), array.size(y_pred))
        if n == 0
            float(na)
        else
            float sum_abs = 0.0
            for i = 0 to n - 1
                sum_abs += math.abs(array.get(y_true, i) - array.get(y_pred, i))
            sum_abs / n

//@function Creates a confusion matrix for classification evaluation
//@param y_true Array of true class labels
//@param y_pred Array of predicted class labels
//@param n_classes Number of classes (default: 2)
//@returns Matrix where [i,j] is count of class i predicted as class j
export confusion_matrix(array<int> y_true, array<int> y_pred, int n_classes = 2) =>
    if na(y_true) or na(y_pred)
        matrix<int> result = na
        result
    else
        int n = math.min(array.size(y_true), array.size(y_pred))
        matrix<int> cm = matrix.new<int>(n_classes, n_classes, 0)
        for i = 0 to n - 1
            int true_label = array.get(y_true, i)
            int pred_label = array.get(y_pred, i)
            if true_label >= 0 and true_label < n_classes and pred_label >= 0 and pred_label < n_classes
                matrix.set(cm, true_label, pred_label, matrix.get(cm, true_label, pred_label) + 1)
        cm

// =============================================================================
// DATA UTILITIES
// =============================================================================

//@function Creates a sliding window matrix from a 1D array
//@param data Input data array
//@param window_size Size of each window
//@returns Matrix where each row is a window of consecutive values
export sliding_window(array<float> data, int window_size) =>
    if na(data) or array.size(data) < window_size
        matrix<float> result = na
        result
    else
        int n_windows = array.size(data) - window_size + 1
        matrix<float> result = matrix.new<float>(n_windows, window_size, 0.0)
        for i = 0 to n_windows - 1
            for j = 0 to window_size - 1
                matrix.set(result, i, j, array.get(data, i + j))
        result

//@function Splits data into training and test sets
//@param X Feature matrix
//@param y Labels array
//@param test_ratio Fraction of data for testing (default: 0.2)
//@returns Tuple of [X_train, X_test, y_train, y_test]
export train_test_split(matrix<float> X, array<int> y, float test_ratio = 0.2) =>
    if na(X) or na(y)
        matrix<float> empty_m1 = na
        matrix<float> empty_m2 = na
        array<int> empty_a1 = na
        array<int> empty_a2 = na
        [empty_m1, empty_m2, empty_a1, empty_a2]
    else
        int n_samples = matrix.rows(X)
        int n_features = matrix.columns(X)
        int n_test = math.round(n_samples * test_ratio)
        int n_train = n_samples - n_test
        matrix<float> X_train = matrix.new<float>(n_train, n_features, 0.0)
        matrix<float> X_test = matrix.new<float>(n_test, n_features, 0.0)
        array<int> y_train = array.new_int(n_train, 0)
        array<int> y_test = array.new_int(n_test, 0)
        for i = 0 to n_train - 1
            for f = 0 to n_features - 1
                matrix.set(X_train, i, f, matrix.get(X, i, f))
            array.set(y_train, i, array.get(y, i))
        for i = 0 to n_test - 1
            for f = 0 to n_features - 1
                matrix.set(X_test, i, f, matrix.get(X, n_train + i, f))
            array.set(y_test, i, array.get(y, n_train + i))
        [X_train, X_test, y_train, y_test]

//@function Creates binary labels from continuous data using a threshold
//@param data Input data array
//@param threshold Value above which label is 1 (default: 0.0)
//@returns Array of binary labels (0 or 1)
export create_binary_labels(array<float> data, float threshold = 0.0) =>
    if na(data) or array.size(data) == 0
        array<int> result = na
        result
    else
        int n = array.size(data)
        array<int> labels = array.new_int(n, 0)
        for i = 0 to n - 1
            array.set(labels, i, array.get(data, i) > threshold ? 1 : 0)
        labels

//@function Creates a lag matrix for time series data
//@param data Input data array
//@param n_lags Number of lagged features to create
//@returns Matrix where each row contains n_lags previous values
export lag_matrix(array<float> data, int n_lags) =>
    if na(data) or array.size(data) <= n_lags
        matrix<float> result = na
        result
    else
        int n = array.size(data) - n_lags
        matrix<float> result = matrix.new<float>(n, n_lags, 0.0)
        for i = 0 to n - 1
            for lag = 0 to n_lags - 1
                matrix.set(result, i, lag, array.get(data, i + n_lags - lag - 1))
        result

// =============================================================================
// TRADING UTILITIES
// =============================================================================

//@function Converts a prediction probability to a position signal
//@param prediction Prediction probability (0-1)
//@param threshold_long Threshold above which to go long (default: 0.6)
//@param threshold_short Threshold below which to go short (default: 0.4)
//@returns Position signal: 1 (long), -1 (short), or 0 (neutral)
export signal_to_position(float prediction, float threshold_long = 0.6, float threshold_short = 0.4) =>
    if na(prediction)
        0
    else if prediction >= threshold_long
        1
    else if prediction <= threshold_short
        -1
    else
        0

//@function Calculates position size based on prediction confidence
//@param probability Prediction probability (0-1)
//@param max_size Maximum position size (default: 1.0)
//@param min_confidence Minimum confidence to take a position (default: 0.5)
//@returns Position size scaled by confidence
export confidence_sizing(float probability, float max_size = 1.0, float min_confidence = 0.5) =>
    if na(probability) or probability < min_confidence
        0.0
    else
        float confidence = (probability - min_confidence) / (1.0 - min_confidence)
        max_size * confidence

//@function Calculates optimal position size using Kelly Criterion
//@param win_rate Historical win rate (0-1)
//@param avg_win Average winning trade size
//@param avg_loss Average losing trade size (positive value)
//@param max_fraction Maximum fraction of capital to risk (default: 0.25)
//@returns Optimal position size fraction
export kelly_sizing(float win_rate, float avg_win, float avg_loss, float max_fraction = 0.25) =>
    if na(win_rate) or na(avg_win) or na(avg_loss) or avg_loss == 0.0
        0.0
    else
        float b = avg_win / math.abs(avg_loss)
        float kelly = (win_rate * b - (1.0 - win_rate)) / b
        math.max(0.0, math.min(max_fraction, kelly))

//@function Calculates annualized Sharpe ratio from returns
//@param returns Array of period returns
//@param risk_free_rate Risk-free rate (default: 0.0)
//@returns Annualized Sharpe ratio (assuming 252 trading days)
export sharpe_ratio(array<float> returns, float risk_free_rate = 0.0) =>
    if na(returns) or array.size(returns) < 2
        float(na)
    else
        float mean = array.avg(returns)
        float std = array.stdev(returns)
        std == 0.0 ? 0.0 : (mean - risk_free_rate) * math.sqrt(252) / std

//@function Calculates annualized Sortino ratio (downside deviation only)
//@param returns Array of period returns
//@param risk_free_rate Risk-free rate (default: 0.0)
//@returns Annualized Sortino ratio (assuming 252 trading days)
export sortino_ratio(array<float> returns, float risk_free_rate = 0.0) =>
    if na(returns) or array.size(returns) < 2
        float(na)
    else
        float mean = array.avg(returns)
        float sum_sq_neg = 0.0
        int count_neg = 0
        for i = 0 to array.size(returns) - 1
            float r = array.get(returns, i)
            if r < 0.0
                sum_sq_neg += r * r
                count_neg += 1
        float downside_std = count_neg > 0 ? math.sqrt(sum_sq_neg / count_neg) : 0.0
        downside_std == 0.0 ? 0.0 : (mean - risk_free_rate) * math.sqrt(252) / downside_std

//@function Calculates maximum drawdown from equity curve
//@param equity Array of equity values
//@returns Maximum drawdown as a fraction (0-1)
export max_drawdown(array<float> equity) =>
    if na(equity) or array.size(equity) == 0
        float(na)
    else
        float peak = array.get(equity, 0)
        float max_dd = 0.0
        for i = 0 to array.size(equity) - 1
            float val = array.get(equity, i)
            if val > peak
                peak := val
            float dd = (peak - val) / peak
            if dd > max_dd
                max_dd := dd
        max_dd

//@function Calculates ATR-based stop loss price
//@param entry_price Trade entry price
//@param atr Current ATR value
//@param multiplier ATR multiplier for stop distance (default: 2.0)
//@param is_long True for long position, false for short (default: true)
//@returns Stop loss price
export atr_stop_loss(float entry_price, float atr, float multiplier = 2.0, bool is_long = true) =>
    if na(entry_price) or na(atr)
        float(na)
    else
        is_long ? entry_price - multiplier * atr : entry_price + multiplier * atr

//@function Calculates take profit price based on risk/reward ratio
//@param entry_price Trade entry price
//@param stop_loss Stop loss price
//@param ratio Risk/reward ratio (default: 2.0)
//@returns Take profit price
export risk_reward_take_profit(float entry_price, float stop_loss, float ratio = 2.0) =>
    if na(entry_price) or na(stop_loss)
        float(na)
    else
        float risk = math.abs(entry_price - stop_loss)
        entry_price > stop_loss ? entry_price + ratio * risk : entry_price - ratio * risk

//@function Performs majority voting across ensemble predictions
//@param predictions Array of predictions from different models
//@returns Most common prediction (majority vote)
export ensemble_vote(array<int> predictions) =>
    if na(predictions) or array.size(predictions) == 0
        int(na)
    else
        int max_label = 0
        for i = 0 to array.size(predictions) - 1
            int pred = array.get(predictions, i)
            if pred > max_label
                max_label := pred
        array<int> votes = array.new_int(max_label + 1, 0)
        for i = 0 to array.size(predictions) - 1
            int pred = array.get(predictions, i)
            array.set(votes, pred, array.get(votes, pred) + 1)
        int best_label = 0
        int best_count = 0
        for lbl = 0 to max_label
            if array.get(votes, lbl) > best_count
                best_count := array.get(votes, lbl)
                best_label := lbl
        best_label

//@function Calculates weighted average of ensemble predictions
//@param predictions Array of predictions from different models
//@param weights Array of weights for each model
//@returns Weighted average prediction
export ensemble_weighted_average(array<float> predictions, array<float> weights) =>
    if na(predictions) or na(weights) or array.size(predictions) == 0
        float(na)
    else
        int n = math.min(array.size(predictions), array.size(weights))
        float sum_weighted = 0.0
        float sum_weights = 0.0
        for i = 0 to n - 1
            float w = array.get(weights, i)
            sum_weighted += array.get(predictions, i) * w
            sum_weights += w
        sum_weights == 0.0 ? 0.0 : sum_weighted / sum_weights

//@function Smooths predictions using exponential moving average
//@param current Current prediction value
//@param previous Previous smoothed value
//@param alpha Smoothing factor (0-1, higher = less smoothing) (default: 0.3)
//@returns Smoothed prediction value
export smooth_prediction(float current, float previous, float alpha = 0.3) =>
    if na(previous)
        current
    else if na(current)
        previous
    else
        alpha * current + (1.0 - alpha) * previous

//@function Classifies market regime based on volatility and trend
//@param volatility Current volatility measure
//@param trend_strength Current trend strength measure
//@param vol_threshold Threshold for high volatility (default: 0.02)
//@param trend_threshold Threshold for strong trend (default: 0.3)
//@returns Regime: "trending_volatile", "ranging_volatile", "trending_calm", "ranging_calm", or "unknown"
export regime_classifier(float volatility, float trend_strength, float vol_threshold = 0.02, float trend_threshold = 0.3) =>
    if na(volatility) or na(trend_strength)
        "unknown"
    else
        bool high_vol = volatility > vol_threshold
        bool strong_trend = math.abs(trend_strength) > trend_threshold
        if high_vol and strong_trend
            "trending_volatile"
        else if high_vol
            "ranging_volatile"
        else if strong_trend
            "trending_calm"
        else
            "ranging_calm"
