//@version=6

// @description Dynamic Period Calculation Library
// This library provides tools for adaptive period determination, useful for creating indicators or strategies that automatically adjust to market conditions.
library('DynamicPeriodPublic', overlay = false)

// Calculates a dynamic period based on pivot distances
// @param left Number of left bars for pivot detection
// @param right Number of right bars for pivot detection
// @param numPivots Minimum number of pivots to calculate average distance
// @param minPeriod Minimum allowed period
// @param maxPeriod Maximum allowed period
// @param defaultPeriod Default period if no pivots are found
// @param high Source for low values
// @param low Source for high values
// @returns Calculated dynamic period
export dynamic_period(int left = 5, int right = 5, int numPivots = 5, int minPeriod = 2, int maxPeriod = 50, int defaultPeriod = 14, float high = high, float low = low) =>
    // Calculate pivot points
    pivotHigh = ta.pivothigh(high, left, right)
    pivotLow = ta.pivotlow(low, left, right)

    // Initialize arrays to store pivot bar indices
    var highPivotBars = array.new_int()
    var lowPivotBars = array.new_int()

    // Store pivot bar indices
    if bool(pivotHigh)
        array.push(highPivotBars, bar_index)
    if bool(pivotLow)
        array.push(lowPivotBars, bar_index)

    // --- Calculate average distance between pivot highs
    float avgHighPivotDist = na
    if array.size(highPivotBars) >= numPivots
        totalDist = 0
        for i = 0 to numPivots - 2 by 1
            idx1 = array.get(highPivotBars, array.size(highPivotBars) - 1 - i)
            idx2 = array.get(highPivotBars, array.size(highPivotBars) - 2 - i)
            dist = idx1 - idx2
            totalDist := totalDist + dist
            totalDist
        avgHighPivotDist := totalDist / (numPivots - 1)
        avgHighPivotDist

    // --- Calculate average distance between pivot lows
    float avgLowPivotDist = na
    if array.size(lowPivotBars) >= numPivots
        totalDist = 0
        for i = 0 to numPivots - 2 by 1
            idx1 = array.get(lowPivotBars, array.size(lowPivotBars) - 1 - i)
            idx2 = array.get(lowPivotBars, array.size(lowPivotBars) - 2 - i)
            dist = idx1 - idx2
            totalDist := totalDist + dist
            totalDist
        avgLowPivotDist := totalDist / (numPivots - 1)
        avgLowPivotDist

    // --- Calculate overall average pivot distance
    float avgPivotDist = na
    if not na(avgHighPivotDist) and not na(avgLowPivotDist)
        avgPivotDist := (avgHighPivotDist + avgLowPivotDist) / 2
        avgPivotDist
    else if not na(avgHighPivotDist)
        avgPivotDist := avgHighPivotDist
        avgPivotDist
    else if not na(avgLowPivotDist)
        avgPivotDist := avgLowPivotDist
        avgPivotDist

    // --- Calculate dynamic period
    float period = na
    if not na(avgPivotDist)
        period := math.round(avgPivotDist / 2)
        period := math.max(math.min(period, maxPeriod), minPeriod)
        period
    else
        period := defaultPeriod // Default period if no pivot distance is available
        period

    period

// Inputs
left = input.int(5, 'Left bars', minval = 1)
right = input.int(5, 'Right bars', minval = 1)
numPivots = input.int(5, 'Number of Pivots to Consider', minval = 2)

// Calculate period
period = dynamic_period(left, right, numPivots)

// Plot the period
plot(period, color = color.white, precision = 0)
