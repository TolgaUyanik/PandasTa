//@version=6
indicator("EMA Slope % of Range (X Days, Y EMA)", shorttitle="EMA Slope %Range", overlay=false)

// ─── Inputs ───────────────────────────────────────────────────────────────
xDays  = input.int(20, title="X - Lookback Window (Days)", minval=1)
yLen   = input.int(21, title="Y - EMA Period", minval=1)
srcIn  = input.source(close, title="Source")
smoothSlope = input.bool(false, title="Smooth slope with 1-bar SMA (reduces noise)")

// ─── Convert X days -> bars, works for both intraday and daily+ charts ────
// On intraday charts we scale by how many bars fit in a day based on chart timeframe.
// On daily/weekly/monthly charts we just use X as the bar count directly.
secondsPerDay = 86400.0
tfSeconds     = timeframe.in_seconds(timeframe.period)
barsPerDay    = tfSeconds > 0 and tfSeconds < secondsPerDay ? secondsPerDay / tfSeconds : 1.0
barsInWindow  = int(math.max(2, math.round(xDays * barsPerDay)))

// ─── EMA and its slope ──────────────────────────────────────────────────
ema = ta.ema(srcIn, yLen)
rawSlope = ema - ema[1]
slope = smoothSlope ? ta.sma(rawSlope, 1) : rawSlope

// ─── Rolling max positive slope and max-magnitude negative slope over the window ──
maxPosSlope = ta.highest(slope, barsInWindow)          // most positive slope seen in window
minNegSlope = ta.lowest(slope, barsInWindow)            // most negative slope seen in window (still negative)

// Guard against zero/undefined ranges
posRange = maxPosSlope > 0 ? maxPosSlope : na
negRange = minNegSlope < 0 ? math.abs(minNegSlope) : na

// ─── Normalize current slope as % of the relevant range ───────────────────
// Positive slope -> 0% to 100% of the largest positive slope in the window
// Negative slope -> 0% to -100% of the largest-magnitude negative slope in the window
slopePct = slope >= 0 ? (na(posRange) ? 0.0 : (slope / posRange) * 100.0) :
                         (na(negRange) ? 0.0 : (slope / negRange) * 100.0)

// ─── Plot ───────────────────────────────────────────────────────────────
plotColor = slopePct >= 0 ? color.new(color.lime, 0) : color.new(color.red, 0)
plot(slopePct, title="EMA Slope % of Range", style=plot.style_columns, color=plotColor)
hline(0, title="Zero Line", color=color.gray, linestyle=hline.style_solid)
hline(100, title="+100%", color=color.new(color.gray, 70), linestyle=hline.style_dotted)
hline(-100, title="-100%", color=color.new(color.gray, 70), linestyle=hline.style_dotted)

// Optional info label on last bar
var label infoLbl = na
if barstate.islast
    label.delete(infoLbl)
    infoLbl := label.new(bar_index, slopePct,
         text="Window: " + str.tostring(barsInWindow) + " bars (~" + str.tostring(xDays) + "d)\nEMA(" + str.tostring(yLen) + ") slope: " + str.tostring(slope, format.mintick) + "\n% of range: " + str.tostring(slopePct, "#.##") + "%",
         style=label.style_label_left, color=color.new(color.black, 80), textcolor=color.white, size=size.small)
