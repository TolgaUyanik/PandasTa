library("kijunStackCore")

// ─────────────────────────────────────────────────────────────────────────────
// ————— Kijun core (pure, no request.*)
// ─────────────────────────────────────────────────────────────────────────────
export kijun(float highSeries, float lowSeries, int length) =>
    (ta.highest(highSeries, length) + ta.lowest(lowSeries, length)) / 2.0

export distNormAtr(float a, float b, float atrValue) =>
    atrValue == 0.0 ? na : math.abs(a - b) / atrValue

export distNormPct(float a, float b, float price) =>
    price == 0.0 ? na : math.abs(a - b) / price * 100.0

// ─────────────────────────────────────────────────────────────────────────────
// ————— Stack classification (3 levels)
// code: +2 bull strict, +1 bull partial, 0 mixed, -1 bear partial, -2 bear strict
// ─────────────────────────────────────────────────────────────────────────────
export stack3Code(
    float kFast,
    float kMid,
    float kSlow,
    float distFastMid,
    float distMidSlow,
    float tolEq
) =>
    bool eqFastMid = distFastMid <= tolEq
    bool eqMidSlow = distMidSlow <= tolEq

    bool bullStrict = (kFast > kMid) and (kMid > kSlow)
    bool bearStrict = (kFast < kMid) and (kMid < kSlow)

    bool bullPartial = (kFast >= kMid) and (kMid >= kSlow) and (eqFastMid or eqMidSlow) and not bullStrict
    bool bearPartial = (kFast <= kMid) and (kMid <= kSlow) and (eqFastMid or eqMidSlow) and not bearStrict

    int code =
         bullStrict  ?  2 :
         bullPartial ?  1 :
         bearStrict  ? -2 :
         bearPartial ? -1 : 0

    code

export stack3Compressed(float distFastMid, float distMidSlow, float tight) =>
    (distFastMid < tight) and (distMidSlow < tight)

export stack3Stretched(float distFastMid, float distMidSlow, float wide) =>
    (distFastMid > wide) or (distMidSlow > wide)
