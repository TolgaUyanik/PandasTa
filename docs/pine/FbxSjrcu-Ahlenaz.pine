//@version=6
strategy("XRP Price Action + Volume Strategy", overlay=true, initial_capital=10000, scale=scale.right)

// =====================================================
// INPUTS
// =====================================================
fastEMA           = input.int(50, "Fast EMA")
slowEMA           = input.int(200, "Slow EMA")
volLength         = input.int(20, "Volume SMA Length")   // <-- stray "A" removed here
breakoutLookback  = input.int(20, "Resistance Lookback")
riskATR           = input.float(1.5, "ATR Stop Multiplier")

// =====================================================
// INDICATORS
// =====================================================
emaFast = ta.ema(close, fastEMA)
emaSlow = ta.ema(close, slowEMA)

volMA = ta.sma(volume, volLength)

highResistance = ta.highest(high, breakoutLookback)
lowSupport     = ta.lowest(low, breakoutLookback)

atr = ta.atr(14)

// =====================================================
// TREND FILTER
// =====================================================
bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow

// =====================================================
// PRICE ACTION + VOLUME CONDITIONS
// =====================================================
bullBreakout  = close > highResistance[1] and close > open and volume > volMA * 1.5
bearBreakdown = close < lowSupport[1] and close < open and volume > volMA * 1.5

// =====================================================
// ENTRY SIGNALS
// =====================================================
buySignal  = bullTrend and bullBreakout
sellSignal = bearTrend and bearBreakdown

// =====================================================
// EXECUTION
// =====================================================
if buySignal
    strategy.entry("BUY", strategy.long)

if sellSignal
    strategy.entry("SELL", strategy.short)

// =====================================================
// RISK MANAGEMENT
// =====================================================
longStop  = close - (atr * riskATR)
shortStop = close + (atr * riskATR)

strategy.exit("Exit Buy", "BUY", stop=longStop)
strategy.exit("Exit Sell", "SELL", stop=shortStop)

// =====================================================
// VISUALS
// =====================================================
plot(emaFast, title="50 EMA")
plot(emaSlow, title="200 EMA")

plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, text="BUY")
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, text="SELL")

// =====================================================
// ALERTS
// =====================================================
alertcondition(buySignal, title="BUY ALERT", message="Bullish XRP breakout detected")
alertcondition(sellSignal, title="SELL ALERT", message="Bearish XRP breakdown detected")
