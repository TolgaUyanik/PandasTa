//@version=6
library("Crypto_in_details_MAlib")

// Simple Moving Average
export sma(float src, int length) =>
    ta.sma(src, length)

// Exponential Moving Average
export ema(float src, int length) =>
    ta.ema(src, length)

// Weighted Moving Average
export wma(float src, int length) =>
    ta.wma(src, length)

// Running Moving Average (RMA)
export rma(float src, int length) =>
    ta.rma(src, length)

// Volume Weighted Moving Average
export vwma(float src, int length) =>
    ta.vwma(src, length)

// Hull Moving Average
export hma(float src, int length) =>
    ta.hma(src, length)

// Triple Exponential Moving Average (TEMA)
export tema(float src, int length) =>
    ema1 = ta.ema(src, length)
    ema2 = ta.ema(ema1, length)
    ema3 = ta.ema(ema2, length)
    3 * (ema1 - ema2) + ema3

// Exponential Hull Moving Average (EHMA)
export ehma(float src, int length) =>
    half_ema = ta.ema(src, math.round(length / 2))
    full_ema = ta.ema(src, length)
    diff = 2 * half_ema - full_ema
    ta.ema(diff, math.round(math.sqrt(length)))

// Triple Hull Moving Average (THMA)
export thma(float src, int length) =>
    wma1 = ta.wma(src, math.round(length / 3))
    wma2 = ta.wma(src, math.round(length / 2))
    wma3 = ta.wma(src, length)
    ta.wma(3 * wma1 - 3 * wma2 + wma3, length)
