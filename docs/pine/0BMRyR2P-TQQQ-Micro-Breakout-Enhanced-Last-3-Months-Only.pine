//@version=6
strategy("TQQQ Micro-Breakout (Enhanced + Last 3 Months Only)",
     overlay = true,
     initial_capital = 10000,
     commission_type = strategy.commission.percent,
     commission_value = 0.05,
     default_qty_type = strategy.cash,
     pyramiding = 0)

//====================================================
// Inputs
//====================================================
use3MonthFilter = input.bool(true, "Limit Backtest to Last 3 Months Only", group="Backtest Window")

trendLen        = input.int(20, "Trend EMA Length", group="Strategy Settings")
pullbackLen     = input.int(7, "Micro Pullback Lookback", group="Strategy Settings")

atrLen          = input.int(14, "ATR Length", group="Risk Management")
trailATRMult    = input.float(1.8, "Trailing Stop ATR Multiplier", group="Risk Management")
riskPct         = input.float(1.0, "Risk % per Trade", group="Risk Management")

//====================================================
// Backtest Window (Your Correct Version)
//====================================================
msIn90Days = 90 * 24 * 60 * 60 * 1000
threeMonthsAgo = last_bar_time - msIn90Days
inRange = use3MonthFilter ? (time >= threeMonthsAgo) : true

//====================================================
// Core Indicators
//====================================================
trendEMA = ta.ema(close, trendLen)
trendUp  = close > trendEMA

atr      = ta.atr(atrLen)

//====================================================
// Upgrade 1: ATR Volatility Floor
//====================================================
atrFloorPct = input.float(0.8, "ATR Volatility Floor (%)", group="Volatility Filter")
atrPct = atr / close * 100
volOK = atrPct >= atrFloorPct

//====================================================
// Upgrade 2: Higher-Low Filter
//====================================================
// Condition: current low > previous swing low (pullbackLen lookback)
prevSwingLow = ta.lowest(low[1], pullbackLen)
higherLow = low > prevSwingLow

//====================================================
// Your Corrected Breakout Logic (unchanged)
//====================================================
prevHigh      = ta.highest(high[1], pullbackLen)
microBreakout = close > prevHigh and trendUp

//====================================================
// Combined Entry Condition (Your Logic + Upgrades)
//====================================================
longCond = microBreakout and higherLow and volOK and inRange

//====================================================
// Trailing Stop & Position Sizing (Your Logic)
//====================================================
var float trailingStop = na

estimatedStop = close - atr * trailATRMult
riskCapital   = strategy.equity * (riskPct / 100.0)
riskPerUnit   = math.abs(close - estimatedStop)
longQty       = riskPerUnit > 0 ? math.floor(riskCapital / riskPerUnit) : 0

if longCond and strategy.position_size == 0 and longQty > 0
    strategy.entry("Long", strategy.long, qty = longQty)
    trailingStop := estimatedStop

if strategy.position_size > 0
    newStop = close - atr * trailATRMult
    trailingStop := math.max(nz(trailingStop, newStop), newStop)
    strategy.exit("Exit", "Long", stop = trailingStop)
else
    trailingStop := na

//====================================================
// Upgrade 3: Performance Dashboard
//====================================================
var float peakEquity = strategy.equity
peakEquity := math.max(peakEquity, strategy.equity)
maxDD = (strategy.equity - peakEquity) / peakEquity * 100

var float grossProfit = 0
var float grossLoss   = 0
var int wins = 0
var int losses = 0

if strategy.closedtrades > 0
    pl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if pl > 0
        grossProfit += pl
        wins += 1
    else
        grossLoss += math.abs(pl)
        losses += 1

winRate      = wins + losses > 0 ? wins / (wins + losses) * 100 : na
profitFactor = grossLoss > 0 ? grossProfit / grossLoss : na

plotchar(winRate, "Win Rate %", "", location.top)
plotchar(profitFactor, "Profit Factor", "", location.top)
plotchar(maxDD, "Max Drawdown %", "", location.top)
plotchar(strategy.netprofit, "Net Profit", "", location.top)

//====================================================
// Visuals
//====================================================
plot(trendEMA, "Trend EMA", color = color.yellow, linewidth = 2)
plot(prevHigh, "Previous High (Breakout Level)", color = color.new(color.blue, 40), style = plot.style_linebr)
plot(strategy.position_size > 0 ? trailingStop : na, "Dynamic ATR Stop", color = color.red, style = plot.style_linebr, linewidth = 2)

bgcolor(inRange and use3MonthFilter ? color.new(color.blue, 95) : na, title="Backtest Range Highlight")
