//@version=5
indicator("Volume vs Volatility Trend Signal", overlay=false)

// === Inputs ===
volumeSource = input.source(volume, "Volume Source")

// === Calculate Changes ===
volatility = high - low
volatilityPrev = high[1] - low[1]
volatilityPrev2 = high[2] - low[2]

volumePrev = volumeSource[1]
volumePrev2 = volumeSource[2]

// === Logic ===
// Case 1: Volume increased AND volatility decreased → signal = 1
bullCondition = (volumePrev > volumePrev2) and (volatilityPrev < volatilityPrev2)

// Case 2: Volume decreased AND volatility increased → signal = -1
bearCondition = (volumePrev < volumePrev2) and (volatilityPrev > volatilityPrev2)

// Default case: signal = 0
signal = bullCondition ? 1 : bearCondition ? -1 : 0

// === Output ===
plot(signal, title="Trend Signal", color=color.new(color.blue, 0), style=plot.style_columns)
hline(1, "Bullish", color=color.green)
hline(0, "Neutral", color=color.gray)
hline(-1, "Bearish", color=color.red)
