//@version=6
// @description Library holding exact envelope band percentages for stocks I-P
library("EnvelopeLibrary_IP", overlay=true)

export getPct_I_P(string symbol, string tf) =>
    float val = -1.0
    val := switch symbol
        "HAVELLS"    => tf == "D" ? 1.50 : tf == "W" ? 4.50 : tf == "M" ? 10.00 : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 40.00
        "HDFCAMC"    => tf == "D" ? 2.50 : tf == "W" ? 5.00 : tf == "M" ? 11.00 : tf == "3M" ? 16.00 : tf == "6M" ? 20.00 : 20.00
        "HDFCBANK"   => tf == "D" ? 2.00 : tf == "W" ? 3.00 : tf == "M" ? 6.00  : tf == "3M" ? 10.00 : tf == "6M" ? 20.00 : 25.00
        "HDFCLIFE"   => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 12.00 : tf == "6M" ? 15.00 : 20.00
        "HEROMOTOCO" => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 7.00  : tf == "3M" ? 15.00 : tf == "6M" ? 22.00 : 32.00
        "HINDALCO"   => tf == "D" ? 2.50 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 35.00
        "HINDUNILVR" => tf == "D" ? 1.50 : tf == "W" ? 3.00 : tf == "M" ? 8.00  : tf == "3M" ? 15.00 : tf == "6M" ? 18.00 : 25.00
        "ICICIBANK"  => tf == "D" ? 1.75 : tf == "W" ? 5.00 : tf == "M" ? 8.00  : tf == "3M" ? 17.00 : tf == "6M" ? 25.00 : 35.00
        "ICICIGI"    => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 12.00 : tf == "6M" ? 20.00 : 20.00
        "ICICIPRULI" => tf == "D" ? 2.50 : tf == "W" ? 5.00 : tf == "M" ? 8.00  : tf == "3M" ? 12.00 : tf == "6M" ? 16.00 : 20.00
        "IDFCFIRSTB" => tf == "D" ? 0.00 : tf == "W" ? 8.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 0.00  : 0.00
        "IEX"        => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 12.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 35.00
        "IGL"        => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 9.00  : tf == "3M" ? 18.00 : tf == "6M" ? 23.00 : 32.00
        "IKIO"       => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 10.00 : tf == "3M" ? 16.00 : tf == "6M" ? 20.00 : 26.00
        "INDHOTEL"   => tf == "D" ? 2.00 : tf == "W" ? 6.00 : tf == "M" ? 10.00 : tf == "3M" ? 15.00 : tf == "6M" ? 25.00 : 30.00
        "INDIGO"     => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 10.00 : tf == "3M" ? 15.00 : tf == "6M" ? 21.00 : 25.00
        "INDUSINDBK" => tf == "D" ? 2.50 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 14.00 : tf == "6M" ? 24.00 : 35.00
        "INDUSTOWER" => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 14.00 : tf == "6M" ? 18.00 : 20.00
        "INFY"       => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 9.00  : tf == "3M" ? 15.00 : tf == "6M" ? 23.00 : 35.00
        "IOC"        => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 8.00  : tf == "3M" ? 14.00 : tf == "6M" ? 30.00 : 40.00
        "IPCALAB"    => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 17.00 : tf == "6M" ? 25.00 : 35.00
        "IRCTC"      => tf == "D" ? 4.00 : tf == "W" ? 8.00 : tf == "M" ? 14.00 : tf == "3M" ? 24.00 : tf == "6M" ? 30.00 : 40.00
        "IRFC"       => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 15.00 : tf == "3M" ? 25.00 : tf == "6M" ? 35.00 : 45.00
        "ITC"        => tf == "D" ? 3.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 32.00
        "JSWSTEEL"   => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 31.00
        "JUBLFOOD"   => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 12.00 : tf == "3M" ? 19.00 : tf == "6M" ? 25.00 : 35.00
        "JUSTDIAL"   => tf == "D" ? 0.00 : tf == "W" ? 0.00 : tf == "M" ? 10.00 : tf == "3M" ? 0.00  : tf == "6M" ? 0.00  : 0.00
        "KALYANKJIL" => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 16.00 : tf == "3M" ? 24.00 : tf == "6M" ? 35.00 : 35.00
        "KOTAKBANK"  => tf == "D" ? 1.75 : tf == "W" ? 4.00 : tf == "M" ? 7.00  : tf == "3M" ? 15.00 : tf == "6M" ? 20.00 : 30.00
        "KPITTECH"   => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 25.00 : tf == "6M" ? 35.00 : 45.00
        "LT"         => tf == "D" ? 1.75 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 15.00 : tf == "6M" ? 21.00 : 25.00
        "LTIM"       => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 35.00
        "LTTS"       => tf == "D" ? 2.00 : tf == "W" ? 7.00 : tf == "M" ? 13.00 : tf == "3M" ? 22.00 : tf == "6M" ? 26.00 : 40.00
        "LUPIN"      => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 40.00
        "M&M"        => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 9.00  : tf == "3M" ? 15.00 : tf == "6M" ? 20.00 : 30.00
        "MARICO"     => tf == "D" ? 1.50 : tf == "W" ? 2.00 : tf == "M" ? 6.50  : tf == "3M" ? 12.00 : tf == "6M" ? 18.00 : 30.00
        "MARUTI"     => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 16.00 : tf == "6M" ? 28.00 : 38.00
        "MCX"        => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 13.00 : tf == "3M" ? 24.00 : tf == "6M" ? 24.00 : 35.00
        "MGL"        => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 12.00 : tf == "6M" ? 14.00 : 18.00
        "MOTHERSON"  => tf == "D" ? 2.50 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 24.00 : tf == "6M" ? 35.00 : 45.00
        "MPHASIS"    => tf == "D" ? 2.00 : tf == "W" ? 6.00 : tf == "M" ? 9.00  : tf == "3M" ? 17.00 : tf == "6M" ? 27.00 : 35.00
        "MRF"        => tf == "D" ? 2.00 : tf == "W" ? 3.00 : tf == "M" ? 8.00  : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 40.00
        "MUTHOOTFIN" => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 18.00 : tf == "6M" ? 23.00 : 30.00
        "NATIONALUM" => tf == "D" ? 3.00 : tf == "W" ? 8.00 : tf == "M" ? 15.00 : tf == "3M" ? 22.00 : tf == "6M" ? 30.00 : 35.00
        "NAUKRI"     => tf == "D" ? 2.50 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 20.00 : tf == "6M" ? 25.00 : 33.00
        "NAVINFLUOR" => tf == "D" ? 2.00 : tf == "W" ? 4.50 : tf == "M" ? 10.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 40.00
        "NESTLEIND"  => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 7.00  : tf == "3M" ? 12.00 : tf == "6M" ? 20.00 : 30.00
        "NHPC"       => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 8.00  : tf == "3M" ? 12.00 : tf == "6M" ? 15.00 : 20.00
        "NMDC"       => tf == "D" ? 3.00 : tf == "W" ? 7.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 24.00 : 30.00
        "NTPC"       => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 15.00 : tf == "6M" ? 20.00 : 25.00
        "NYKAA"      => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 20.00 : tf == "6M" ? 25.00 : 25.00
        "OBEROIRLTY" => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 13.00 : tf == "3M" ? 18.00 : tf == "6M" ? 23.00 : 30.00
        "ONGC"       => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 10.00 : tf == "3M" ? 14.00 : tf == "6M" ? 23.00 : 30.00
        "PAGEIND"    => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 9.00  : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 35.00
        "PAYTM"      => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 18.00 : tf == "3M" ? 24.00 : tf == "6M" ? 20.00 : 20.00
        "PETRONET"   => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 9.00  : tf == "3M" ? 16.00 : tf == "6M" ? 24.00 : 30.00
        "PFC"        => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 22.00 : tf == "6M" ? 30.00 : 40.00
        => -1.0
    val