//@version=5 
library("WCWebLib", overlay = true)

// @description The webhook message library provides several functions for building JSON payloads 

// @type Constants for payload values.
export type CONSTANTS
    string ACTION_BUY                   = "buy"
    string ACTION_SELL                  = "sell"
    string ACTION_EXIT                  = "exit"
    string ACTION_CANCEL                = "cancel"
    string ACTION_ADD                   = "add"
    string SENTIMENT_BULLISH            = "bullish"
    string SENTIMENT_BEARISH            = "bearish"
    string SENTIMENT_LONG               = "long"
    string SENTIMENT_SHORT              = "short"
    string SENTIMENT_FLAT               = "flat"
    string STOP_LOSS_TYPE_STOP          = "stop"
    string STOP_LOSS_TYPE_STOP_LIMIT    = "stop_limit"
    string STOP_LOSS_TYPE_TRAILING_STOP = "trailing_stop"
    bool   EXTENDEDHOURS                = false
    string ORDER_TYPE_LIMIT             = "limit"
    string ORDER_TYPE_MARKET            = "market"
    string TIF_DAY                      = "day"

// @type Final webhook message.
export type webhookMessage
    string ticker
    string action 
    string sentiment
    float  price
    int    quantity
    string takeProfit = ""
    string stopLoss = ""
    bool   extendedHours = false
    string type = "limit"
    string timeInForce = "day"

// @type Take profit message.
export type takeProfitMessage
    float limitPrice
    float percent
    float amount

// @type Stop loss message.
export type stopLossMessage
    string type
    float  percent
    float  amount
    float  stopPrice
    float  limitPrice
    float  trailPrice
    float  trailPercent

// @function Builds the final JSON payload from a webhookMessage type.
// @param msg (webhookMessage) A prepared webhookMessage.
// @returns <string> A JSON Payload.
export method buildWebhookJson(webhookMessage msg, CONSTANTS constants = na) =>
    var cnst = na(constants) ? CONSTANTS.new() : constants
    var string json = "{"
    json += '"library": "WebhookMessage"'
    json += ',"time": "' + str.format_time(time) + '"'
    // ticker
    var string ticker_to_use = msg.ticker == "" ? syminfo.ticker : msg.ticker
    if na(ticker_to_use)
        log.error("Invalid ticker: msg.ticker={0}, syminfo.ticker={1}", msg.ticker, syminfo.ticker)
        ticker_to_use := "UNKNOWN"
    json += ',"ticker": "' + ticker_to_use + '"'
    // action
    json += ',"action": "' + msg.action + '"'
    // sentiment
    var bool isValidSentiment = msg.sentiment == cnst.SENTIMENT_BULLISH or msg.sentiment == cnst.SENTIMENT_BEARISH or msg.sentiment == cnst.SENTIMENT_LONG or msg.sentiment == cnst.SENTIMENT_SHORT or msg.sentiment == cnst.SENTIMENT_FLAT
    if isValidSentiment
        json += ',"sentiment": "' + msg.sentiment + '"'
    // price
    if msg.price > 0 and msg.type == cnst.ORDER_TYPE_LIMIT
        json += ',".angle": ' + str.tostring(math.round(msg.price, 2))
        if msg.action == cnst.ACTION_BUY or msg.action == cnst.ACTION_SELL
            if not msg.extendedHours
                log.warning("Extended hours trading requires a limit price and extendedHours=true for buy/sell actions with limit orders.")
    // quantity
    if msg.quantity > 0
        json += ',"quantity": ' + str.tostring(math.min(msg.quantity, 1000000))
    else
        log.error("Invalid quantity: {0}", msg.quantity)
    // takeProfit
    if msg.takeProfit != ""
        json += ',"takeProfit":' + msg.takeProfit
    // stopLoss
    if msg.stopLoss != ""
        json += ',"stopLoss":' + msg.stopLoss
    // extendedHours
    json += ',"extendedHours": ' + (msg.extendedHours ? "true" : "false")	
    // type
    json += ',"type": "' + msg.type + '"'
    // timeInForce
    json += ',"timeInForce": "' + msg.timeInForce + '"'
    json += "}"
    json

// @function Builds the takeProfit JSON message to be used in a webhook message.
export method buildTakeProfitJson(takeProfitMessage msg) =>
    var string json = "{"
    var string[] messages = array.new_string(0)
    if not na(msg.limitPrice)
        array.push(messages, '"limitPrice": ' + str.tostring(math.round(msg.limitPrice, 2)))
    if not na(msg.percent)
        array.push(messages, '"percent": ' + str.tostring(math.round(msg.percent, 2)))
    if not na(msg.amount)
        array.push(messages, '"amount": ' + str.tostring(math.round(msg.amount, 2)))
    json += array.join(messages, ",")
    json += "}"
    json

// @function Builds the stopLoss JSON message to be used in a webhook message.
export method buildStopLossJson(stopLossMessage msg, CONSTANTS constants = na) =>
    var cnst = na(constants) ? CONSTANTS.new() : constants
    if not na(msg.limitPrice) and msg.type != cnst.STOP_LOSS_TYPE_STOP_LIMIT
        msg.type := cnst.STOP_LOSS_TYPE_STOP_LIMIT
    if (not na(msg.trailPrice) or not na(msg.trailPercent)) and msg.type != cnst.STOP_LOSS_TYPE_TRAILING_STOP
        msg.type := cnst.STOP_LOSS_TYPE_TRAILING_STOP
    var string json = "{"
    var string[] messages = array.new_string(0)
    if not na(msg.type)
        array.push(messages, '"type": "' + msg.type + '"')
    if not na(msg.percent)
        array.push(messages, '"percent": ' + str.tostring(math.round(msg.percent, 2)))
    if not na(msg.amount)
        array.push(messages, '"amount": ' + str.tostring(math.round(msg.amount, 2)))
    if not na(msg.stopPrice)
        array.push(messages, '"stopPrice": ' + str.tostring(math.round(msg.stopPrice, 2)))
    if not na(msg.limitPrice)
        array.push(messages, '"limitPrice": ' + str.tostring(math.round(msg.limitPrice, 2)))
    if not na(msg.trailPrice)
        array.push(messages, '"trailPrice": ' + str.tostring(math.round(msg.trailPrice, 2)))
    if not na(msg.trailPercent)
        array.push(messages, '"trailPercent": ' + str.tostring(math.round(msg.trailPercent, 2)))
    json += array.join(messages, ",")
    json += "}"
    json