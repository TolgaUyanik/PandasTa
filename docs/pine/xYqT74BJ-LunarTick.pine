//@version=6

// @description LunarTick shared library
library("LunarTick")


////////////////////////////////////////////////////////////////////////////////////////////////////
// Enums
////////////////////////////////////////////////////////////////////////////////////////////////////

// @enum Enum indicating long/short direction
export enum Direction
    long = "Long"
    short = "Short"

// @enum Enum indicating trend direction
export enum TrendDirection
    neutral = "Neutral"
    bullish = "Bullish"
    bearish = "Bearish"


////////////////////////////////////////////////////////////////////////////////////////////////////
// Functions
////////////////////////////////////////////////////////////////////////////////////////////////////

// @function Determines if a bar is bullish
// @param bars_ago Specifies which bar to be used
// @returns True if specified bar is bullish, otherwise false
export is_bullish(int bars_ago) => close[bars_ago] > open[bars_ago]

// @function Determines if a bar is bearish
// @param bars_ago Specifies which bar to be used
// @returns True if specified bar is bearish, otherwise false
export is_bearish(int bars_ago) => close[bars_ago] < open[bars_ago]

// @function Formats a timeframe period for display
// @param period Timeframe period
// @returns Display representation of timeframe period
export format_timeframe_period(string period) =>
    string result = period
    string multiplier_str = str.match(period, "^\\d+")
    if str.endswith(period, "M")
        // Months
        result := (multiplier_str == "1") ? "M" : period
    else if str.endswith(period, "W")
        // Weeks
        result := (multiplier_str == "1") ? "W" : period
    else if str.endswith(period, "D")
        // Days
        result := (multiplier_str == "1") ? "D" : period
    else if str.endswith(period, "S")
        // Seconds
        result := multiplier_str + "s"
    else if str.endswith(period, "T")
        // Ticks
        result := multiplier_str + "t"
    else if str.length(multiplier_str) == str.length(period)
        // Minutes - Check for exact hours
        int hours = int(str.tonumber(multiplier_str) / 60)
        if str.tostring(hours * 60) == multiplier_str
            // Format as hours
            result := str.tostring(hours) + "H"
        else
            // Format as pure minutes
            result := multiplier_str + "m"
    result

// @function Pads an integer with leading zeroes until desired length is reached
// @param value The integer value to be padded
// @param length The required length
// @returns String containing value padded with leading zeroes
export pad_leading_zeroes(int value, int length) =>
    string result = str.tostring(value)
    while str.length(result) < length
        result := "0" + result
    result

// @function Adds minutes to an integer time value (HHMM)
// @param value The integer time value (HHMM)
// @param minutes The number of minutes to add
// @returns Integer time value (HHMM)
export time_add_minutes(int value, int minutes) =>
    int result = value
    int hh = value / 100
    int mm = value - (hh * 100)
    mm += minutes
    if mm > 59
        hh += 1
        mm -= 60
    else if mm < 0
        hh -= 1
        mm += 60
    result := (hh * 100) + mm

// @function Gets a bar's body as percentage of bar range
// @param bars_ago Specifies which bar to be used
// @returns Bar's body as percentage of bar range
export get_body_percent(int bars_ago) =>
    bar_range = math.abs(high[bars_ago] - low[bars_ago])
    bar_body = math.abs(close[bars_ago] - open[bars_ago])
    (bar_body / bar_range) * 100.0

// @function Gets a bar's leading wick as percentage of bar range
// @param bars_ago Specifies which bar to be used
// @returns Bar's leading wick as percentage of bar range
export get_leading_wick_percent(int bars_ago) =>
    leading_wick = (is_bullish(bars_ago) ? high - close : close - low)
    bar_range = math.abs(high[bars_ago] - low[bars_ago])
    (leading_wick / bar_range) * 100.0

// @function Pluralize a specified word
// @param count Count value used to determine singular/plural
// @param word The word to be pluralized
// @param pluralized Custom pluralized version of word, if required
// @returns Pluralized version of word
export pluralize(int count, string word, string pluralized = na) =>
    if count == 1
        word
    else
        (not na(pluralized)) ? pluralized : (word + "s")
