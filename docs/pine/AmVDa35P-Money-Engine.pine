//@version=6
indicator("PDH / PDL Levels", overlay=true)

// ---- Color inputs ----
pdhColor = input.color(color.red, "PDH Color", group="Colors")
pdlColor = input.color(color.green, "PDL Color", group="Colors")

// ---- Label position input ----
labelOffset = input.int(50, "Label Distance from Last Bar", minval=1, maxval=100, group="Label")

// ---- Get previous day's high and low ----
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)

// ---- Detect new day ----
newDay = ta.change(time("D")) != 0

var line pdhLine = na
var line pdlLine = na
var label pdhLabel = na
var label pdlLabel = na

if newDay
    line.delete(pdhLine)
    line.delete(pdlLine)
    label.delete(pdhLabel)
    label.delete(pdlLabel)

    pdhLine := line.new(bar_index - 1, pdh, bar_index, pdh, extend=extend.both, color=pdhColor, width=2)
    pdlLine := line.new(bar_index - 1, pdl, bar_index, pdl, extend=extend.both, color=pdlColor, width=2)

    pdhLabel := label.new(bar_index + labelOffset, pdh, "PDH " + str.tostring(pdh, format.mintick), style=label.style_label_right, color=pdhColor, textcolor=color.white)
    pdlLabel := label.new(bar_index + labelOffset, pdl, "PDL " + str.tostring(pdl, format.mintick), style=label.style_label_right, color=pdlColor, textcolor=color.white)

line.set_xy1(pdhLine, bar_index - 1, pdh)
line.set_xy2(pdhLine, bar_index, pdh)
line.set_xy1(pdlLine, bar_index - 1, pdl)
line.set_xy2(pdlLine, bar_index, pdl)

label.set_x(pdhLabel, bar_index + labelOffset)
label.set_x(pdlLabel, bar_index + labelOffset)
label.set_y(pdhLabel, pdh)
label.set_y(pdlLabel, pdl)

line.set_color(pdhLine, pdhColor)
line.set_color(pdlLine, pdlColor)
label.set_color(pdhLabel, pdhColor)
label.set_color(pdlLabel, pdlColor)

// ---- Session settings ----
sessionInput = input.session("0530-1130", "Asian Session Time", group="Session")
tzInput = input.string("Asia/Kolkata", "Timezone", group="Session")

// ---- Color inputs ----
ahColor = input.color(color.orange, "Asian High Color", group="Colors")
alColor = input.color(color.blue, "Asian Low Color", group="Colors")

inSession = not na(time(timeframe.period, sessionInput, tzInput))
sessionStart = inSession and not inSession[1]

var float asianHigh = na
var float asianLow = na

if sessionStart
    asianHigh := high
    asianLow := low
else if inSession
    asianHigh := math.max(asianHigh, high)
    asianLow := math.min(asianLow, low)

var line ahLine = na
var line alLine = na
var label ahLabel = na
var label alLabel = na

if sessionStart
    line.delete(ahLine)
    line.delete(alLine)
    label.delete(ahLabel)
    label.delete(alLabel)

    ahLine := line.new(bar_index - 1, asianHigh, bar_index, asianHigh, extend=extend.both, color=ahColor, width=2)
    alLine := line.new(bar_index - 1, asianLow, bar_index, asianLow, extend=extend.both, color=alColor, width=2)

    ahLabel := label.new(bar_index + labelOffset, asianHigh, "Asian High " + str.tostring(asianHigh, format.mintick), style=label.style_label_right, color=ahColor, textcolor=color.white)
    alLabel := label.new(bar_index + labelOffset, asianLow, "Asian Low " + str.tostring(asianLow, format.mintick), style=label.style_label_right, color=alColor, textcolor=color.white)

line.set_xy1(ahLine, bar_index - 1, asianHigh)
line.set_xy2(ahLine, bar_index, asianHigh)
line.set_xy1(alLine, bar_index - 1, asianLow)
line.set_xy2(alLine, bar_index, asianLow)

label.set_x(ahLabel, bar_index + labelOffset)
label.set_x(alLabel, bar_index + labelOffset)
label.set_y(ahLabel, asianHigh)
label.set_y(alLabel, asianLow)

line.set_color(ahLine, ahColor)
line.set_color(alLine, alColor)
label.set_color(ahLabel, ahColor)
label.set_color(alLabel, alColor)

// =====================================================
// ---- ALERTS: Candle close crossing PDH/PDL/Asian H-L ----
// =====================================================
pdhCrossUp   = ta.crossover(close, pdh)
pdlCrossDown = ta.crossunder(close, pdl)
ahCrossUp    = ta.crossover(close, asianHigh)
alCrossDown  = ta.crossunder(close, asianLow)

alertcondition(pdhCrossUp, title="Close Above PDH", message="{{ticker}} candle closed ABOVE PDH at {{close}}")
alertcondition(pdlCrossDown, title="Close Below PDL", message="{{ticker}} candle closed BELOW PDL at {{close}}")
alertcondition(ahCrossUp, title="Close Above Asian High", message="{{ticker}} candle closed ABOVE Asian High at {{close}}")
alertcondition(alCrossDown, title="Close Below Asian Low", message="{{ticker}} candle closed BELOW Asian Low at {{close}}")


//-----r&s module3

// ---- Show/Hide toggles ----
showResistance = input.bool(true, "Show Resistance", group="Display")
showSupport = input.bool(true, "Show Support", group="Display")

// ---- Inputs ----
swingLength = input.int(10, "Swing Strength (bars left/right)", minval=1, maxval=50, group="Settings")
resistanceColor = input.color(color.red, "Resistance Color", group="Colors")
supportColor = input.color(color.green, "Support Color", group="Colors")
maxLevels = input.int(2, "Max Levels to Show", minval=1, maxval=10, group="Settings")

swingHigh = ta.pivothigh(high, swingLength, swingLength)
swingLow = ta.pivotlow(low, swingLength, swingLength)

var array<float> resistanceLevels = array.new<float>()
var array<line> resistanceLines = array.new<line>()
var array<label> resistanceLabels = array.new<label>()

var array<float> supportLevels = array.new<float>()
var array<line> supportLines = array.new<line>()
var array<label> supportLabels = array.new<label>()

if not na(swingHigh)
    array.unshift(resistanceLevels, swingHigh)
    if array.size(resistanceLevels) > maxLevels
        array.pop(resistanceLevels)

if not na(swingLow)
    array.unshift(supportLevels, swingLow)
    if array.size(supportLevels) > maxLevels
        array.pop(supportLevels)

if barstate.islast
    for ln in resistanceLines
        line.delete(ln)
    for lb in resistanceLabels
        label.delete(lb)
    array.clear(resistanceLines)
    array.clear(resistanceLabels)

    if showResistance
        for i = 0 to array.size(resistanceLevels) - 1
            lvl = array.get(resistanceLevels, i)
            newLine = line.new(bar_index - 1, lvl, bar_index, lvl, extend=extend.both, color=resistanceColor, width=2)
            newLabel = label.new(bar_index + labelOffset, lvl, "R" + str.tostring(i + 1) + " " + str.tostring(lvl, format.mintick), style=label.style_label_right, color=resistanceColor, textcolor=color.white)
            array.push(resistanceLines, newLine)
            array.push(resistanceLabels, newLabel)

    for ln in supportLines
        line.delete(ln)
    for lb in supportLabels
        label.delete(lb)
    array.clear(supportLines)
    array.clear(supportLabels)

    if showSupport
        for i = 0 to array.size(supportLevels) - 1
            lvl = array.get(supportLevels, i)
            newLine = line.new(bar_index - 1, lvl, bar_index, lvl, extend=extend.both, color=supportColor, width=2)
            newLabel = label.new(bar_index + labelOffset, lvl, "S" + str.tostring(i + 1) + " " + str.tostring(lvl, format.mintick), style=label.style_label_right, color=supportColor, textcolor=color.white)
            array.push(supportLines, newLine)
            array.push(supportLabels, newLabel)


//------------module-bos-choch
// ---- Show/Hide toggles ----
showBOS = input.bool(true, "Show BOS", group="Display")
showCHoCH = input.bool(true, "Show CHoCH", group="Display")

// ---- Inputs ----
bosColor = input.color(color.blue, "BOS Color", group="Colors")
chochColor = input.color(color.purple, "CHoCH Color", group="Colors")
labelSize = input.string(size.small, "Label Size", options=[size.tiny, size.small, size.normal, size.large], group="Label")


var float lastSwingHigh = na
var int lastSwingHighBar = na
var float lastSwingLow = na
var int lastSwingLowBar = na

var bool highBroken = true
var bool lowBroken = true
var int trend = 0

if not na(swingHigh)
    lastSwingHigh := swingHigh
    lastSwingHighBar := bar_index - swingLength
    highBroken := false

if not na(swingLow)
    lastSwingLow := swingLow
    lastSwingLowBar := bar_index - swingLength
    lowBroken := false

// ---- Bullish break ----
if not na(lastSwingHigh) and not highBroken and close > lastSwingHigh
    isChoch = trend == -1
    shouldDraw = isChoch ? showCHoCH : showBOS

    if shouldDraw
        lineColor = isChoch ? chochColor : bosColor
        labelText = isChoch ? "CHoCH" : "BOS"
        line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=lineColor, width=1, style=line.style_dashed)
        label.new(math.round(math.avg(lastSwingHighBar, bar_index)), lastSwingHigh, labelText, style=label.style_label_down, color=lineColor, textcolor=color.white, size=labelSize)

    trend := 1
    highBroken := true

// ---- Bearish break ----
if not na(lastSwingLow) and not lowBroken and close < lastSwingLow
    isChoch = trend == 1
    shouldDraw = isChoch ? showCHoCH : showBOS

    if shouldDraw
        lineColor = isChoch ? chochColor : bosColor
        labelText = isChoch ? "CHoCH" : "BOS"
        line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=lineColor, width=1, style=line.style_dashed)
        label.new(math.round(math.avg(lastSwingLowBar, bar_index)), lastSwingLow, labelText, style=label.style_label_up, color=lineColor, textcolor=color.white, size=labelSize)

    trend := -1
    lowBroken := true


//---module 5

// ---- Inputs ----
bullColor = input.color(color.green, "Bullish Color", group="Colors")
bearColor = input.color(color.red, "Bearish Color", group="Colors")

if not na(swingHigh)
    lastSwingHigh := swingHigh
    highBroken := false

if not na(swingLow)
    lastSwingLow := swingLow
    lowBroken := false

if not na(lastSwingHigh) and not highBroken and close > lastSwingHigh
    trend := 1
    highBroken := true

if not na(lastSwingLow) and not lowBroken and close < lastSwingLow
    trend := -1
    lowBroken := true

// ---- Direction Label ----
var label trendLabel = na

if barstate.islast
    label.delete(trendLabel)
    trendText = trend == 1 ? "▲ BULLISH" : trend == -1 ? "▼ BEARISH" : "NEUTRAL"
    trendColor = trend == 1 ? bullColor : trend == -1 ? bearColor : color.gray
    trendLabel := label.new(bar_index + 15, high + (high - low) * 3, trendText, style=label.style_label_center, color=trendColor, textcolor=color.white, size=size.large)