//@version=5
indicator("Swing Strategy MTF with Auto SL/TP + Weekly Pivots", overlay=true)

// === INPUTS ===
htf         = input.timeframe("D", "Higher Timeframe")
entryEMA    = input.int(21, "Entry EMA (LTF)")
ema50_HTF   = input.int(50, "HTF EMA 1")
ema200_HTF  = input.int(200, "HTF EMA 2")
rsiLength   = input.int(14, "RSI Length")
pivotTF     = input.timeframe("W", "Pivot Timeframe")
rrRatio     = input.float(2.0, "Target RR Ratio")

// === HIGHER TIMEFRAME TREND ===
htfClose    = request.security(syminfo.tickerid, htf, close)
htfEMA50    = request.security(syminfo.tickerid, htf, ta.ema(close, ema50_HTF))
htfEMA200   = request.security(syminfo.tickerid, htf, ta.ema(close, ema200_HTF))

bullTrend = htfClose > htfEMA50 and htfEMA50 > htfEMA200
bearTrend = htfClose < htfEMA50 and htfEMA50 < htfEMA200

// === LOWER TIMEFRAME INDICATORS ===
emaEntry = ta.ema(close, entryEMA)
rsi      = ta.rsi(close, rsiLength)
nearEMA  = math.abs(close - emaEntry) / emaEntry < 0.01

// === Reversal Candles ===
bullishCandle = close > open and close > high[1]
bearishCandle = close < open and close < low[1]

// === ENTRY CONDITIONS ===
longEntry  = bullTrend and rsi > 50 and nearEMA and bullishCandle
shortEntry = bearTrend and rsi < 50 and nearEMA and bearishCandle

// === PLOTS ===
plot(emaEntry, title="21 EMA", color=color.orange)

// === WEEKLY PIVOTS ===
[wh, wl, wc] = request.security(syminfo.tickerid, pivotTF, [high, low, close])
pivot   = (wh + wl + wc) / 3
R1      = 2 * pivot - wl
S1      = 2 * pivot - wh

plot(pivot, "Pivot", color=color.gray)
plot(R1, "Weekly R1", color=color.green)
plot(S1, "Weekly S1", color=color.red)

// === SIGNALS & LABELS ===
if (longEntry)
    sl = ta.lowest(low, 5)
    tp = close + rrRatio * math.abs(close - sl)
    label.new(bar_index, close, "BUY", style=label.style_label_up, color=color.green, textcolor=color.white)
    label.new(bar_index, sl, "SL", style=label.style_label_left, color=color.red, textcolor=color.white)
    label.new(bar_index, tp, "TP", style=label.style_label_right, color=color.lime, textcolor=color.black)

if (shortEntry)
    sl = ta.highest(high, 5)
    tp = close - rrRatio * math.abs(sl - close)
    label.new(bar_index, close, "SELL", style=label.style_label_down, color=color.red, textcolor=color.white)
    label.new(bar_index, sl, "SL", style=label.style_label_left, color=color.green, textcolor=color.white)
    label.new(bar_index, tp, "TP", style=label.style_label_right, color=color.orange, textcolor=color.black)

// === BACKGROUND COLOR ===
bgcolor(bullTrend ? color.new(color.green, 90) : na)
bgcolor(bearTrend ? color.new(color.red, 90) : na)
