//@version=6
strategy("Trend Structure Scale-In", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, initial_capital=100000, default_qty_type=strategy.percent_of_equity)

// --- Inputs ---
int pivotLeft = input.int(5, "Pivot Left Bars", group="Structure")
int pivotRight = input.int(5, "Pivot Right Bars", group="Structure")
int zoneMaxBars = input.int(20, "Max Bars to Mitigate", group="Structure")

color emaColor = input.color(color.orange, "EMA 200 Color", group="Visuals")
color buyColor = input.color(color.gray, "Buy Color", group="Visuals")
color sellColor = input.color(color.red, "Sell Color", group="Visuals")

// --- Indicators ---
float ema200 = ta.ema(close, 200)
plot(ema200, "EMA 200", emaColor, 2)

// --- Structure & Patterns ---
float pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
float pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)

var int lastPivotLowBar = 0
var int lastPivotHighBar = 0

if not na(pivotLow)
    lastPivotLowBar := bar_index[pivotRight]
if not na(pivotHigh)
    lastPivotHighBar := bar_index[pivotRight]

bool bullEngulfing = close > open and close > open[1] and open < close[1] and close[1] < open[1]
bool bearEngulfing = close < open and close < open[1] and open > close[1] and close[1] > open[1]

// Mitigation Zones
var float bullZoneTop = na
var float bullZoneBot = na
var int bullZoneStart = 0
var box bullBox = na

var float bearZoneTop = na
var float bearZoneBot = na
var int bearZoneStart = 0
var box bearBox = na

// Bullish Setup
if bullEngulfing and (bar_index - lastPivotLowBar <= 10) and (lastPivotLowBar > bullZoneStart) and close > ema200
    bullZoneTop := close
    bullZoneBot := open
    bullZoneStart := bar_index
    bullBox := box.new(bar_index[1], bullZoneTop, bar_index, bullZoneBot, border_color=color.new(buyColor, 50), bgcolor=color.new(buyColor, 80))

// Bearish Setup
if bearEngulfing and (bar_index - lastPivotHighBar <= 10) and (lastPivotHighBar > bearZoneStart) and close < ema200
    bearZoneTop := open
    bearZoneBot := close
    bearZoneStart := bar_index
    bearBox := box.new(bar_index[1], bearZoneTop, bar_index, bearZoneBot, border_color=color.new(sellColor, 50), bgcolor=color.new(sellColor, 80))

// Extend boxes
if not na(bullBox)
    box.set_right(bullBox, bar_index)
if not na(bearBox)
    box.set_right(bearBox, bar_index)

// Touch logic
bool bullTouch = false
bool bearTouch = false

if not na(bullZoneTop) and low <= bullZoneTop and high >= bullZoneBot and bar_index > bullZoneStart and (bar_index - bullZoneStart <= zoneMaxBars)
    bullTouch := true
    bullZoneTop := na // Consume zone

if not na(bearZoneTop) and high >= bearZoneBot and low <= bearZoneTop and bar_index > bearZoneStart and (bar_index - bearZoneStart <= zoneMaxBars)
    bearTouch := true
    bearZoneTop := na // Consume zone

// --- Strategy Logic ---
int numTrades = strategy.opentrades

bool isLong = strategy.position_size > 0
bool isShort = strategy.position_size < 0
float avgPrice = strategy.position_avg_price

// Scale-In percentages
float pct = 0.0
string entryId = ""

if numTrades == 0
    pct := 0.005
    entryId := isLong ? "B1" : "S1"
else if numTrades == 1
    pct := 0.005
    entryId := isLong ? "B2" : "S2"
else if numTrades == 2
    pct := 0.01
    entryId := isLong ? "B3" : "S3"
else if numTrades == 3
    pct := 0.02
    entryId := isLong ? "B4" : "S4"
else if numTrades == 4
    pct := 0.04
    entryId := isLong ? "B5" : "S5"

float qty = (strategy.equity * pct) / close

// Entries
if bullTouch and close > ema200 and not isShort
    if numTrades == 0
        strategy.entry("B1", strategy.long, qty)
        label.new(bar_index, low, "B1", color=color.new(color.white, 100), style=label.style_label_up, textcolor=buyColor, size=size.small)
    else if isLong and numTrades < 5 and close < avgPrice
        strategy.entry(entryId, strategy.long, qty)
        label.new(bar_index, low, entryId, color=color.new(color.white, 100), style=label.style_label_up, textcolor=buyColor, size=size.small)

if bearTouch and close < ema200 and not isLong
    if numTrades == 0
        strategy.entry("S1", strategy.short, qty)
        label.new(bar_index, high, "S1", color=color.new(color.white, 100), style=label.style_label_down, textcolor=sellColor, size=size.small)
    else if isShort and numTrades < 5 and close > avgPrice
        strategy.entry(entryId, strategy.short, qty)
        label.new(bar_index, high, entryId, color=color.new(color.white, 100), style=label.style_label_down, textcolor=sellColor, size=size.small)

// Take Profit
float longTP = strategy.position_avg_price * 1.02
float shortTP = strategy.position_avg_price * 0.98

if isLong
    strategy.exit("TP_Long", limit=longTP)
if isShort
    strategy.exit("TP_Short", limit=shortTP)

// Live TP Line
var line tpLine = na
if strategy.position_size != 0
    if na(tpLine)
        tpLine := line.new(bar_index, isLong ? longTP : shortTP, bar_index + 1, isLong ? longTP : shortTP, color=color.blue, style=line.style_dashed, width=2)
    else
        line.set_xy1(tpLine, bar_index[1], isLong ? longTP : shortTP)
        line.set_xy2(tpLine, bar_index + 1, isLong ? longTP : shortTP)
else
    if not na(tpLine)
        line.delete(tpLine)
        tpLine := na
