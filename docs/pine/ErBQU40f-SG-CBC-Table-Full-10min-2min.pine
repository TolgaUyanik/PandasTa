//@version=5
indicator("SG CBC Table - Full 10min & 2min", overlay=true)

// === Table Position ===
tablePosition = input.string(title="Table Position", options=["bottom_center","bottom_left","bottom_right","top_left","top_center","top_right"], defval="top_center")

// === Customization Inputs ===
// Header colors
header_text_color = input.color(color.white, "Header Text Color")
header_bg_color   = input.color(color.gray, "Header Background Color")
header_transparency = input.int(0, "Header Transparency (0-100)", minval=0, maxval=100)

// Ticker colors
ticker_text_color = input.color(color.white, "Ticker Text Color")
ticker_bg_color   = input.color(color.black, "Ticker Background Color")
ticker_transparency = input.int(0, "Ticker Transparency (0-100)", minval=0, maxval=100)

// CBC colors
long_color        = input.color(color.green, "Long Color")
short_color       = input.color(color.red, "Short Color")
long_transparency  = input.int(0, "Long Transparency (0-100)", minval=0, maxval=100)
short_transparency = input.int(0, "Short Transparency (0-100)", minval=0, maxval=100)

// === Function: Flip Box-style CBC calculation ===
calc_cbc(close_, high_, low_, prevStatus) =>
    close_ > high_ ? true : close_ < low_ ? false : prevStatus

// === === ES === ===
es_close_10 = request.security("CME_MINI:ES1!", "10", close)
es_high_10  = request.security("CME_MINI:ES1!", "10", high[1])
es_low_10   = request.security("CME_MINI:ES1!", "10", low[1])
var bool escbc_10 = false
escbc_10 := calc_cbc(es_close_10, es_high_10, es_low_10, escbc_10[1])

es_close_2 = request.security("CME_MINI:ES1!", "2", close)
es_high_2  = request.security("CME_MINI:ES1!", "2", high[1])
es_low_2   = request.security("CME_MINI:ES1!", "2", low[1])
var bool escbc_2 = false
escbc_2 := calc_cbc(es_close_2, es_high_2, es_low_2, escbc_2[1])

// === === NQ === ===
nq_close_10 = request.security("CME_MINI:NQ1!", "10", close)
nq_high_10  = request.security("CME_MINI:NQ1!", "10", high[1])
nq_low_10   = request.security("CME_MINI:NQ1!", "10", low[1])
var bool nqcbc_10 = false
nqcbc_10 := calc_cbc(nq_close_10, nq_high_10, nq_low_10, nqcbc_10[1])

nq_close_2 = request.security("CME_MINI:NQ1!", "2", close)
nq_high_2  = request.security("CME_MINI:NQ1!", "2", high[1])
nq_low_2   = request.security("CME_MINI:NQ1!", "2", low[1])
var bool nqcbc_2 = false
nqcbc_2 := calc_cbc(nq_close_2, nq_high_2, nq_low_2, nqcbc_2[1])

// === === VIX === ===
vix_close_10 = request.security("VIX", "10", close)
vix_high_10  = request.security("VIX", "10", high[1])
vix_low_10   = request.security("VIX", "10", low[1])
var bool vixcbc_10 = false
vixcbc_10 := calc_cbc(vix_close_10, vix_high_10, vix_low_10, vixcbc_10[1])

vix_close_2 = request.security("VIX", "2", close)
vix_high_2  = request.security("VIX", "2", high[1])
vix_low_2   = request.security("VIX", "2", low[1])
var bool vixcbc_2 = false
vixcbc_2 := calc_cbc(vix_close_2, vix_high_2, vix_low_2, vixcbc_2[1])

// === === GC === ===
gc_close_10 = request.security("COMEX:GC1!", "10", close)
gc_high_10  = request.security("COMEX:GC1!", "10", high[1])
gc_low_10   = request.security("COMEX:GC1!", "10", low[1])
var bool gccbc_10 = false
gccbc_10 := calc_cbc(gc_close_10, gc_high_10, gc_low_10, gccbc_10[1])

gc_close_2 = request.security("COMEX:GC1!", "2", close)
gc_high_2  = request.security("COMEX:GC1!", "2", high[1])
gc_low_2   = request.security("COMEX:GC1!", "2", low[1])
var bool gccbc_2 = false
gccbc_2 := calc_cbc(gc_close_2, gc_high_2, gc_low_2, gccbc_2[1])

// === Create and Populate Table ===
var table t = table.new(position=tablePosition, columns=3, rows=5, border_width=1)

if barstate.isconfirmed
    // Header row (with customizable colors)
    table.cell(t, 0, 0, "Ticker", text_color=header_text_color, bgcolor=color.new(header_bg_color, header_transparency))
    table.cell(t, 1, 0, "10m CBC", text_color=header_text_color, bgcolor=color.new(header_bg_color, header_transparency))
    table.cell(t, 2, 0, "2m CBC", text_color=header_text_color, bgcolor=color.new(header_bg_color, header_transparency))

    // ES row
    table.cell(t, 0, 1, "ES", text_color=ticker_text_color, bgcolor=color.new(ticker_bg_color, ticker_transparency))
    table.cell(t, 1, 1, escbc_10 ? "Long" : "Short", text_color=color.white, bgcolor=color.new(escbc_10 ? long_color : short_color, escbc_10 ? long_transparency : short_transparency))
    table.cell(t, 2, 1, escbc_2 ? "Long" : "Short", text_color=color.white, bgcolor=color.new(escbc_2 ? long_color : short_color, escbc_2 ? long_transparency : short_transparency))

    // NQ row
    table.cell(t, 0, 2, "NQ", text_color=ticker_text_color, bgcolor=color.new(ticker_bg_color, ticker_transparency))
    table.cell(t, 1, 2, nqcbc_10 ? "Long" : "Short", text_color=color.white, bgcolor=color.new(nqcbc_10 ? long_color : short_color, nqcbc_10 ? long_transparency : short_transparency))
    table.cell(t, 2, 2, nqcbc_2 ? "Long" : "Short", text_color=color.white, bgcolor=color.new(nqcbc_2 ? long_color : short_color, nqcbc_2 ? long_transparency : short_transparency))

    // VIX row (colors reversed for CBC)
    table.cell(t, 0, 3, "VIX", text_color=ticker_text_color, bgcolor=color.new(ticker_bg_color, ticker_transparency))
    table.cell(t, 1, 3, vixcbc_10 ? "Long" : "Short", text_color=color.white, bgcolor=color.new(vixcbc_10 ? short_color : long_color, vixcbc_10 ? short_transparency : long_transparency))
    table.cell(t, 2, 3, vixcbc_2 ? "Long" : "Short", text_color=color.white, bgcolor=color.new(vixcbc_2 ? short_color : long_color, vixcbc_2 ? short_transparency : long_transparency))

    // GC row
    table.cell(t, 0, 4, "GC", text_color=ticker_text_color, bgcolor=color.new(ticker_bg_color, ticker_transparency))
    table.cell(t, 1, 4, gccbc_10 ? "Long" : "Short", text_color=color.white, bgcolor=color.new(gccbc_10 ? long_color : short_color, gccbc_10 ? long_transparency : short_transparency))
    table.cell(t, 2, 4, gccbc_2 ? "Long" : "Short", text_color=color.white, bgcolor=color.new(gccbc_2 ? long_color : short_color, gccbc_2 ? long_transparency : short_transparency))
