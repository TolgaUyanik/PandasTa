    assertParseFail(
            "givenMissingOperator_whenParse_thenReturnError (2)",
            "a 1",
            array.from("a"))

    assertParseFail(
            "givenMissingOperator_whenParse_thenReturnError (3)",
            "(1 + 2)(3 + 4)",
