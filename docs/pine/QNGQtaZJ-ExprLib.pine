    assertEvaluationCorrect(
            "givenClampFunction_whenParseAndEvaluate_thenReturnCorrectResult (3)",
            "clamp(5, 3, 9)",
            EMPTY_STRING_ARR,
            EMPTY_FLOAT_ARR,
