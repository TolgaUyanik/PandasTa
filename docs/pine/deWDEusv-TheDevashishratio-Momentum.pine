//@version=5
indicator("TheDevashishratio-Momentum [DRM] — Indicator", overlay=false, max_bars_back=5000)

// Inputs
max_step     = input.int(10, "Max half-steps (0,0.5,…,max)", minval=2)
min_lookback = input.int(2,  "Min lookback bound", minval=1)
max_lookback = input.int(200,"Max lookback bound", minval=5)

w_scheme     = input.string("Equal", "Weighting", options=["Equal","Linear","Exponential"])
exp_alpha    = input.float(0.9, "Expo weight alpha (0–1, higher=more weight on short)", minval=0.01, maxval=0.99)

norm_mode    = input.string("Z-Score", "Normalization", options=["None","ATR","Z-Score"])
atrLen       = input.int(14, "ATR len (if ATR)", minval=1)
zLen         = input.int(100,"Z-score lookback", minval=20)

smoothLen    = input.int(10, "Oscillator EMA smooth", minval=1)
signalLen    = input.int(6,  "Signal EMA", minval=1)

kSigma       = input.float(1.0, "Threshold k*sigma (if dynamic)", minval=0.1, step=0.1)
fixThresh    = input.float(0.0, "Fixed threshold (if not dynamic)", step=0.01)
useDynThresh = input.bool(true, "Use dynamic threshold (k*sigma)")

// Filters
useHTF       = input.bool(false, "Use HTF trend filter?")
htfTF        = input.timeframe("60","HTF timeframe")
htfEMAlen    = input.int(50, "HTF EMA len", minval=2)
useVolFilter = input.bool(false, "Use volume filter?")
volLook      = input.int(20, "Vol SMA len", minval=2)

// Visuals
showHist     = input.bool(true, "Show histogram")
showColorBar = input.bool(true, "Color bars by oscillator")
showSignals  = input.bool(true, "Show chart signal markers")

// Build unique integer lookbacks from half-steps
num_steps = int(max_step * 2 + 1)

var int[] lookbacks = array.new_int()
if bar_index == 0
    for i = 1 to num_steps-1
        val = int(math.round(i * 0.5))
        if val >= min_lookback and val <= max_lookback and not array.includes(lookbacks, val)
            array.push(lookbacks, val)

lbCount = array.size(lookbacks)
if lbCount == 0
    runtime.error("No valid lookbacks after bounds; widen min/max or increase max_step.")

// Weights
get_weight(idx) =>
    if w_scheme == "Equal"
        1.0
    else if w_scheme == "Linear"
        (lbCount - idx)
    else
        math.pow(exp_alpha, idx)  // Exponential: more weight to shorter lookbacks

// Raw momentum blend (weighted price delta across lookbacks)
mom_raw = 0.0
wTotal  = 0.0
for i = 0 to lbCount-1
    n = array.get(lookbacks, i)
    w = get_weight(i)
    delta = close - close[n]
    mom_raw += delta * w
    wTotal  += w

mom_avg = wTotal == 0.0 ? 0.0 : mom_raw / wTotal

// Normalization helpers
atr = ta.atr(atrLen)
f_zscore(src, len) =>
    m  = ta.sma(src, len)
    sd = ta.stdev(src, len)
    sd == 0.0 ? 0.0 : (src - m) / sd

// Single-line ternary to avoid line-continuation errors
osc_pre = norm_mode == "None" ? mom_avg : norm_mode == "ATR" ? (atr == 0.0 ? 0.0 : mom_avg / atr) : f_zscore(mom_avg, zLen)

// Smooth + Signal
osc    = ta.ema(osc_pre, smoothLen)
signal = ta.ema(osc,     signalLen)

// Dynamic/Fixed thresholds
sigma = ta.stdev(osc, zLen)
thUp  = useDynThresh ? (kSigma * sigma) : fixThresh
thDn  = useDynThresh ? (-kSigma * sigma) : -fixThresh

// Filters (HTF trend & volume)
var float htfEMA = na
htfClose = useHTF ? request.security(syminfo.tickerid, htfTF, close) : na
htfEMA   := useHTF ? request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEMAlen)) : na

volOK = not useVolFilter or (volume > ta.sma(volume, volLook))
trendLong  = not useHTF or (htfClose > htfEMA)
trendShort = not useHTF or (htfClose < htfEMA)

// Signals (no orders)
longCond      = ta.crossover(osc, signal) and osc > thUp and trendLong and volOK
shortCond     = ta.crossunder(osc, signal) and osc < thDn and trendShort and volOK
exitLongCond  = ta.crossunder(osc, 0)  or shortCond
exitShortCond = ta.crossover(osc, 0)   or longCond

// Plots
plot(series=showHist ? osc : na, title="DRM Osc", style=plot.style_histogram, linewidth=2,
     color= osc >= 0 ? color.new(color.teal, 0) : color.new(color.red, 0))
plot(series=signal,  title="Signal", color=color.new(color.orange, 0), linewidth=2)
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)
plot(series=thUp,  title="Threshold +", color=color.new(color.blue, 50), style=plot.style_linebr)
plot(series=thDn,  title="Threshold -", color=color.new(color.blue, 50), style=plot.style_linebr)

barcolor(showColorBar ? (osc > thUp ? color.teal : osc < thDn ? color.red : na) : na)

plotshape(series=showSignals and longCond,  title="Long Setup",
          style=shape.triangleup,   location=location.bottom, size=size.tiny,
          color=color.teal, text="DRM L")
plotshape(series=showSignals and shortCond, title="Short Setup",
          style=shape.triangledown, location=location.top,    size=size.tiny,
          color=color.red,  text="DRM S")
plotshape(series=showSignals and exitLongCond and osc < 0,  title="Exit Long",
          style=shape.circle, location=location.bottom, size=size.tiny,
          color=color.orange, text="XL")
plotshape(series=showSignals and exitShortCond and osc > 0, title="Exit Short",
          style=shape.circle, location=location.top,    size=size.tiny,
          color=color.orange, text="XS")

// Alerts
alertcondition(longCond,      title="DRM Long Setup",   message="DRM: Long setup on {{ticker}} @ {{close}}")
alertcondition(shortCond,     title="DRM Short Setup",  message="DRM: Short setup on {{ticker}} @ {{close}}")
alertcondition(exitLongCond,  title="DRM Long Exit",    message="DRM: Exit long {{ticker}} @ {{close}}")
alertcondition(exitShortCond, title="DRM Short Exit",   message="DRM: Exit short {{ticker}} @ {{close}}")
