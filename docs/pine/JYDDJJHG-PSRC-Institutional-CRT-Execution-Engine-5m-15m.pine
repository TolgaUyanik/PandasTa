int continuationVolumeLength = input.int(20, "Continuation volume average length", minval=2, maxval=200, group=GROUP_BIAS)
float continuationVolumeMultiplier = input.float(1.05, "Continuation volume multiplier", minval=0.10, maxval=5.0, step=0.05, group=GROUP_BIAS)

bool requirePostContinuationBreak = input.bool(true, "Require post-continuation break", group=GROUP_BIAS,
     tooltip="After a continuation candle passes quality, wait for a later candle to break its high/low before issuing the unified BUY/SELL alert.")
int postContinuationBreakExpiryBars = input.int(2, "Post-continuation break expiry bars", minval=1, maxval=5, group=GROUP_BIAS)
bool requireBreakBarDirectionalClose = input.bool(true, "Break bar must close in trade direction", group=GROUP_BIAS)
float breakBufferAtr = input.float(0.00, "Break confirmation buffer (ATR)", minval=0.0, maxval=0.50, step=0.01, group=GROUP_BIAS)

bool requirePostBreakAcceptance = input.bool(true, "Require post-break acceptance close", group=GROUP_BIAS,
     tooltip="After the continuation high/low is broken, require the break candle to close beyond the trigger level before issuing the unified alert.")
float acceptanceCloseBufferAtr = input.float(0.00, "Acceptance close buffer (ATR)", minval=0.0, maxval=0.50, step=0.01, group=GROUP_BIAS)
bool allowRetestAcceptance = input.bool(false, "Allow next-bar retest acceptance", group=GROUP_BIAS,
     tooltip="If the break candle does not close beyond the trigger, allow one later candle to retest and close back beyond the trigger.")
int retestAcceptanceExpiryBars = input.int(1, "Retest acceptance expiry bars", minval=1, maxval=3, group=GROUP_BIAS)

// Weighted institutional execution-quality model.
bool useExecutionQualityGate = input.bool(true, "Use weighted execution-quality gate", group=GROUP_BIAS)
float minimumExecutionQuality = input.float(75.0, "Minimum execution quality", minval=50.0, maxval=95.0, step=1.0, group=GROUP_BIAS)
float continuationWeight = input.float(25.0, "Continuation quality weight", minval=0.0, maxval=50.0, step=1.0, group=GROUP_BIAS)
float acceptanceWeight = input.float(25.0, "Break acceptance weight", minval=0.0, maxval=50.0, step=1.0, group=GROUP_BIAS)
float contextWeight = input.float(30.0, "Context/confidence weight", minval=0.0, maxval=50.0, step=1.0, group=GROUP_BIAS)
float rewardWeight = input.float(20.0, "Live reward-quality weight", minval=0.0, maxval=50.0, step=1.0, group=GROUP_BIAS)
float qualityDecayPerBar = input.float(3.0, "Quality decay per stale bar", minval=0.0, maxval=15.0, step=0.5, group=GROUP_BIAS)
float eliteExecutionThreshold = input.float(90.0, "A+ execution threshold", minval=80.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float institutionalExecutionThreshold = input.float(82.0, "A execution threshold", minval=70.0, maxval=95.0, step=1.0, group=GROUP_BIAS)

//-----------------------------------------------------------------------------
// SWEEP AND ARMING
//-----------------------------------------------------------------------------
string armingLevels = input.string(
     "Daily + Range TF",
     "Eligible CRT sweep levels",
     options=["Daily + Range TF", "Daily only", "Range TF only"],
     group=GROUP_SWEEP)
float minSweepAtr = input.float(0.02, "Minimum sweep depth (chart ATR)", minval=0.0, step=0.01, group=GROUP_SWEEP)
float maxSweepAtr = input.float(0.50, "Maximum sweep depth (chart ATR)", minval=0.05, step=0.05, group=GROUP_SWEEP)
float rejectionClosePct = input.float(
     0.65,
     "Rejection close location",
     minval=0.50,
     maxval=0.95,
     step=0.05,
     group=GROUP_SWEEP)
int armedExpiryBars = input.int(16, "Maximum bars from arm to confirmation", minval=2, maxval=100, group=GROUP_SWEEP)
int maxFailedArmsPerLevel = input.int(
     2,
     "Failed arms allowed before level is consumed",
     minval=1,
     maxval=10,
     group=GROUP_SWEEP,
