var float trackedMinLow = na
var float trackedMfeR = 0.0
var float trackedMaeR = 0.0
var string trackedGrade = ""
var string trackedSource = ""
var string trackedExecutionType = ""
var string trackedTargetModel = ""
var float trackedEri = 0.0

var int eriInstitutionalTrades = 0
var int eriGradeATrades = 0
var int eriGradeBTrades = 0
var float eriInstitutionalNetR = 0.0
var float eriGradeANetR = 0.0
var float eriGradeBNetR = 0.0

var int closedOutcomeTrades = 0
var int positiveOutcomeTrades = 0
var int tp2OutcomeTrades = 0
var int runnerOutcomeTrades = 0
var int tp1ProtectedTrades = 0
var int stopOutcomeTrades = 0
var int timeoutOutcomeTrades = 0
var float netOutcomeR = 0.0
var float grossProfitR = 0.0
var float grossLossR = 0.0
var float sumOutcomeMfeR = 0.0
var float sumOutcomeMaeR = 0.0

if newMacroBar
    consumedBullDaily := false
    consumedBearDaily := false
    failedBullDaily := 0
    failedBearDaily := 0
    lastBullDailyArmSession := -1
    lastBearDailyArmSession := -1
    lastBullDailyArmExtreme := na
    lastBearDailyArmExtreme := na
    bullDailyRearmReady := true
    bearDailyRearmReady := true

if newRangeBar
    consumedBullRange := false
    consumedBearRange := false
    failedBullRange := 0
    failedBearRange := 0
    lastBullRangeArmSession := -1
    lastBearRangeArmSession := -1
    lastBullRangeArmExtreme := na
    lastBearRangeArmExtreme := na
    bullRangeRearmReady := true
    bearRangeRearmReady := true

// Persistent mode requires midpoint resolution or a material departure before re-arming.
if not bullDailyRearmReady and (high >= dMid or high >= dLow + chartAtr * rearmResetAtr)
    bullDailyRearmReady := true
if not bearDailyRearmReady and (low <= dMid or low <= dHigh - chartAtr * rearmResetAtr)
    bearDailyRearmReady := true
if not bullRangeRearmReady and (high >= rMid or high >= rLow + chartAtr * rearmResetAtr)
    bullRangeRearmReady := true
if not bearRangeRearmReady and (low <= rMid or low <= rHigh - chartAtr * rearmResetAtr)
    bearRangeRearmReady := true

bool cooldownOk = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars

bool selectedBullConsumed =
     selectedBullSource == "Daily" ? consumedBullDaily :
     selectedBullSource == "Range TF" ? consumedBullRange : true

bool selectedBearConsumed =
     selectedBearSource == "Daily" ? consumedBearDaily :
     selectedBearSource == "Range TF" ? consumedBearRange : true

bool bullDailyNewExtreme = na(lastBullDailyArmExtreme) or low < lastBullDailyArmExtreme - chartAtr * rearmNewExtremeAtr
bool bearDailyNewExtreme = na(lastBearDailyArmExtreme) or high > lastBearDailyArmExtreme + chartAtr * rearmNewExtremeAtr
bool bullRangeNewExtreme = na(lastBullRangeArmExtreme) or low < lastBullRangeArmExtreme - chartAtr * rearmNewExtremeAtr
bool bearRangeNewExtreme = na(lastBearRangeArmExtreme) or high > lastBearRangeArmExtreme + chartAtr * rearmNewExtremeAtr

bool bullDailyDedupeOk = dedupeMode == "Session reset" ? lastBullDailyArmSession != sweepSessionSerial or (bullDailyRearmReady and bullDailyNewExtreme) : lastBullDailyArmSession == -1 or (bullDailyRearmReady and bullDailyNewExtreme)
bool bearDailyDedupeOk = dedupeMode == "Session reset" ? lastBearDailyArmSession != sweepSessionSerial or (bearDailyRearmReady and bearDailyNewExtreme) : lastBearDailyArmSession == -1 or (bearDailyRearmReady and bearDailyNewExtreme)
bool bullRangeDedupeOk = dedupeMode == "Session reset" ? lastBullRangeArmSession != sweepSessionSerial or (bullRangeRearmReady and bullRangeNewExtreme) : lastBullRangeArmSession == -1 or (bullRangeRearmReady and bullRangeNewExtreme)
bool bearRangeDedupeOk = dedupeMode == "Session reset" ? lastBearRangeArmSession != sweepSessionSerial or (bearRangeRearmReady and bearRangeNewExtreme) : lastBearRangeArmSession == -1 or (bearRangeRearmReady and bearRangeNewExtreme)

bool selectedBullDedupeOk = selectedBullSource == "Daily" ? bullDailyDedupeOk : selectedBullSource == "Range TF" ? bullRangeDedupeOk : false
bool selectedBearDedupeOk = selectedBearSource == "Daily" ? bearDailyDedupeOk : selectedBearSource == "Range TF" ? bearRangeDedupeOk : false

bool bullDailyArmAvailable = bullDailySweep and not consumedBullDaily and bullDailyDedupeOk
bool bullRangeArmAvailable = bullRangeSweep and not consumedBullRange and bullRangeDedupeOk
bool bearDailyArmAvailable = bearDailySweep and not consumedBearDaily and bearDailyDedupeOk
bool bearRangeArmAvailable = bearRangeSweep and not consumedBearRange and bearRangeDedupeOk

string effectiveBullSource = bullDailyArmAvailable ? "Daily" : bullRangeArmAvailable ? "Range TF" : ""
string effectiveBearSource = bearDailyArmAvailable ? "Daily" : bearRangeArmAvailable ? "Range TF" : ""
float effectiveBullLevel = bullDailyArmAvailable ? dLow : bullRangeArmAvailable ? rLow : na
float effectiveBearLevel = bearDailyArmAvailable ? dHigh : bearRangeArmAvailable ? rHigh : na

bool activeTradeLockOk = not pendingAddActive and (not blockNewSignalsWhileTracking or not trackedTradeActive)

// Per-bar events.
bool longArmEvent = false
bool shortArmEvent = false
bool longMssEvent = false
bool shortMssEvent = false
bool longReadyEvent = false
bool shortReadyEvent = false
bool buySignal = false
bool sellSignal = false
bool addBuySignal = false
bool addSellSignal = false
bool longFailureEvent = false
bool shortFailureEvent = false
string longFailureSource = ""
string shortFailureSource = ""
string failureReason = ""
bool outcomeEvent = false
string outcomeText = ""
float outcomeR = na

float signalEntry = na
float signalAddEntry = na
float signalAddZoneLow = na
float signalAddZoneHigh = na
float signalScoutRiskPct = 100.0
float signalStop = na
float signalTp1 = na
float signalTp2 = na
string signalGrade = ""
string signalSource = ""
string signalExecutionType = ""
string signalTargetModel = ""
int signalQualityScore = 0
int longPlannedQualityScore = 0
int shortPlannedQualityScore = 0
float signalConfidencePct = 0.0
float longPlannedConfidencePct = 0.0
float shortPlannedConfidencePct = 0.0
float signalEri = 0.0
float longPlannedEri = 0.0
float shortPlannedEri = 0.0
string signalExecutionGrade = ""
string longPlannedExecutionGrade = ""
string shortPlannedExecutionGrade = ""
string signalConfidenceTier = ""
string longPlannedConfidenceTier = ""
string shortPlannedConfidenceTier = ""
float signalUnifiedConfidence = 0.0
float signalExecutionQuality = 0.0
string signalExecutionRank = ""
float longPlannedUnifiedConfidence = 0.0
float shortPlannedUnifiedConfidence = 0.0
string signalGateStatus = ""
string longPlannedGateStatus = ""
string shortPlannedGateStatus = ""
float addSignalEntry = na
float addSignalStop = na
float addSignalTp1 = na
float addSignalTp2 = na
float addSignalRiskPct = na
string addSignalGrade = ""
string addSignalSource = ""

//=============================================================================
// COMMON CONFIRMATION CONDITIONS
//=============================================================================
bool bullDisplacement =
     close > open and
     candleBody >= averageBody * displacementBodyMult and
     candleBody >= chartAtr * displacementAtrMin and
     closeLocation >= rejectionClosePct

bool bearDisplacement =
     close < open and
     candleBody >= averageBody * displacementBodyMult and
     candleBody >= chartAtr * displacementAtrMin and
     closeLocation <= 1.0 - rejectionClosePct

float bodyAtrRatio = chartAtr > 0.0 ? candleBody / chartAtr : 0.0
float bodyAverageRatio = averageBody > 0.0 ? candleBody / averageBody : 0.0
float volumeRatio = averageVolume > 0.0 ? volume / averageVolume : 0.0
float bodyEfficiency = candleRange > 0.0 ? candleBody / candleRange : 0.0
float rangeAtrRatio = chartAtr > 0.0 ? candleRange / chartAtr : 0.0

float bullDisplacementScore =
     math.min(25.0, bodyAtrRatio * 25.0) +
     math.min(20.0, bodyAverageRatio * 10.0) +
     math.min(15.0, closeLocation * 15.0) +
     math.min(15.0, volumeRatio * 10.0) +
     math.min(15.0, bodyEfficiency * 15.0) +
     math.min(10.0, rangeAtrRatio * 6.67)

float bearDisplacementScore =
     math.min(25.0, bodyAtrRatio * 25.0) +
     math.min(20.0, bodyAverageRatio * 10.0) +
     math.min(15.0, (1.0 - closeLocation) * 15.0) +
     math.min(15.0, volumeRatio * 10.0) +
     math.min(15.0, bodyEfficiency * 15.0) +
     math.min(10.0, rangeAtrRatio * 6.67)

bool bullDisplacementQualified = bullDisplacement and (not useDisplacementScoreGate or bullDisplacementScore >= minimumDisplacementScore)
bool bearDisplacementQualified = bearDisplacement and (not useDisplacementScoreGate or bearDisplacementScore >= minimumDisplacementScore)

bool bullFvg = low > high[2]
bool bearFvg = high < low[2]

bool bullVwapAligned = close > vwapValue and (not requireVwapSlope or vwapValue > vwapValue[1])
bool bearVwapAligned = close < vwapValue and (not requireVwapSlope or vwapValue < vwapValue[1])
bool bullVwapImmediateOk = vwapMode == "Off" or vwapMode == "Grade modifier" or bullVwapAligned
bool bearVwapImmediateOk = vwapMode == "Off" or vwapMode == "Grade modifier" or bearVwapAligned
bool bullVolumeOk = not useVolumeExpansion or volume >= averageVolume * volumeMultiplier
bool bearVolumeOk = not useVolumeExpansion or volume >= averageVolume * volumeMultiplier
bool bullFvgOk = not requireFvg or bullFvg
bool bearFvgOk = not requireFvg or bearFvg

//=============================================================================
// ACTIVE-STATE MAINTENANCE AND TRANSITIONS
//=============================================================================
if barstate.isconfirmed
    //-------------------------------------------------------------------------
    // LONG: ARMED -> MSS
    //-------------------------------------------------------------------------
    if longState == 1
        longSweepExtreme := math.min(longSweepExtreme, low)

        int longAge = bar_index - longArmBar
        bool longGraceExpired = confirmationPolicy == "Grace after valid arm" and longAge > confirmationGraceBars
        bool longSessionLost = confirmationPolicy == "Must remain in session" and not inSession
        bool longExpired = longAge > armedExpiryBars or longGraceExpired or longSessionLost
        bool longInvalid = close < longSweptLevel

        if longInvalid or longExpired or sweepConflict
            longFailureEvent := true
            longFailureSource := longSource
            failureReason := longInvalid ? "RECLAIM LOST" : longSessionLost ? "SESSION" : sweepConflict ? "TWO-SIDED" : "MSS EXPIRED"
            longState := 0
        else
            bool longInternalMss = close > longInternalBreak and close[1] <= longInternalBreak
            if longInternalMss
                longState := 2
                longMssBar := bar_index
                longMssEvent := true
                totalLongMss += 1
                longExternalConfirmed := close > longExternalBreak

    //-------------------------------------------------------------------------
    // SHORT: ARMED -> MSS
    //-------------------------------------------------------------------------
    if shortState == 1
        shortSweepExtreme := math.max(shortSweepExtreme, high)

        int shortAge = bar_index - shortArmBar
        bool shortGraceExpired = confirmationPolicy == "Grace after valid arm" and shortAge > confirmationGraceBars
        bool shortSessionLost = confirmationPolicy == "Must remain in session" and not inSession
        bool shortExpired = shortAge > armedExpiryBars or shortGraceExpired or shortSessionLost
        bool shortInvalid = close > shortSweptLevel

        if shortInvalid or shortExpired or sweepConflict
            shortFailureEvent := true
            shortFailureSource := shortSource
            failureReason := shortInvalid ? "RECLAIM LOST" : shortSessionLost ? "SESSION" : sweepConflict ? "TWO-SIDED" : "MSS EXPIRED"
            shortState := 0
        else
            bool shortInternalMss = close < shortInternalBreak and close[1] >= shortInternalBreak
            if shortInternalMss
                shortState := 2
                shortMssBar := bar_index
                shortMssEvent := true
                totalShortMss += 1
                shortExternalConfirmed := close < shortExternalBreak

    //-------------------------------------------------------------------------
    // LONG: MSS -> DISPLACEMENT / VWAP / CONFIRMATION / EXECUTION PLAN
    //-------------------------------------------------------------------------
    if longState == 2
        longSweepExtreme := math.min(longSweepExtreme, low)
        longExternalConfirmed := longExternalConfirmed or close > longExternalBreak

        int longAge = bar_index - longArmBar
        int longMssAge = bar_index - longMssBar
        bool longGraceExpired = confirmationPolicy == "Grace after valid arm" and longAge > confirmationGraceBars
        bool longSessionLost = confirmationPolicy == "Must remain in session" and not inSession
        bool longExpired = longAge > armedExpiryBars or longMssAge > effectiveDisplacementGrace + effectiveVwapGrace or longGraceExpired or longSessionLost
        bool longInvalid = close < longSweptLevel

        if bullDisplacementQualified
            if not longDisplacementRecorded
                totalLongDisplacement += 1
                longDisplacementRecorded := true

            longDisplacementBar := bar_index
            longDispOpen := open
            longDispHigh := high
            longDispLow := low
            longDispClose := close
            longDispFvg := bullFvg
            longDispBodyMid := (open + close) * 0.5
            longDispVacuumPassed := not useLiquidityVacuumFilter or
                 (candleBody >= chartAtr * vacuumBodyAtrMin and volume >= averageVolume * vacuumVolumeMultiplier)
            longDisplacementScore := bullDisplacementScore
            longProtectedMssLevel :=
                 not na(lastConfirmedPivotHigh) ? lastConfirmedPivotHigh :
                 useInternalBreakFallback ? longInternalBreak : na
            longProtectedMssPassed :=
                 not requireProtectedMssGate or
                 (not na(longProtectedMssLevel) and close > longProtectedMssLevel + chartAtr * mssCloseBufferAtr)
            longGoldRangeBreakPassed :=
                 not autoGoldAsset or not goldRequireRangeExtremeBreak or
                 (not na(rHigh) and close > rHigh + chartAtr * goldRangeBreakBufferAtr)
            longDispFvgAnchor := high[2]
            longFvgPassed := bullFvgOk
            longVolumePassed := bullVolumeOk

            longVwapPassed := bullVwapAligned

        bool longVwapWindowOpen = longDisplacementRecorded and not na(longDisplacementBar) and bar_index - longDisplacementBar <= vwapGraceBars
        if longVwapWindowOpen and bullVwapAligned
            longVwapPassed := true

        bool longCompressionWindowOpen = longDisplacementRecorded and not na(longDisplacementBar) and bar_index - longDisplacementBar >= compressionBars
        float longPriorCompressionHigh = ta.highest(high[1], compressionLookback)
        float longPriorCompressionLow = ta.lowest(low[1], compressionLookback)
        float longCompressionRange = longPriorCompressionHigh - longPriorCompressionLow
        float longDisplacementRange = math.max(longDispHigh - longDispLow, syminfo.mintick)
        float longCompressionRatioToDisp = longDisplacementRange > 0.0 ? longCompressionRange / longDisplacementRange : 10.0
        float longCompressionRatioToAtr = chartAtr > 0.0 ? longCompressionRange / chartAtr : 10.0
        float longCompressionTightnessScore =
             math.max(0.0, 100.0 - longCompressionRatioToDisp * 100.0)
        float longCompressionAtrScore =
             math.max(0.0, 100.0 - longCompressionRatioToAtr * 70.0)
        float longCompressionBreakScore = close > longPriorCompressionHigh ? 100.0 : close > longPriorCompressionLow ? 55.0 : 20.0
        longCompressionScore :=
             longCompressionTightnessScore * 0.45 +
             longCompressionAtrScore * 0.35 +
             longCompressionBreakScore * 0.20
        bool longCompressionRangeOk =
             longCompressionRange <= longDisplacementRange * maxCompressionToDisplacement and
             longCompressionRange <= chartAtr * maxCompressionAtr
        bool longCompressionBreakoutOk = not requireCompressionBreakout or close > longPriorCompressionHigh
        longCompressionQualified := not useCompressionQualification or
             (longCompressionWindowOpen and
              ((useCompressionScore and longCompressionScore >= minimumCompressionScore) or
               (not useCompressionScore and longCompressionRangeOk and longCompressionBreakoutOk)))
        longCompressionHigh := longPriorCompressionHigh
        longCompressionLow := longPriorCompressionLow

        bool longAcceptanceWindowOpen = longDisplacementRecorded and not na(longDisplacementBar) and bar_index > longDisplacementBar and bar_index - longDisplacementBar <= acceptanceGraceBars
        bool longDirectionalBodyPassed = not requireDirectionalAcceptance or close > open
        bool longDirectionalClosePassed = not requireDirectionalAcceptance or closeLocation >= 0.60
        bool longAcceptanceDirectional = longDirectionalBodyPassed and longDirectionalClosePassed
        bool longMidpointStrict = close > longDispBodyMid
        bool longMidpointRejection = low <= longDispBodyMid and close > longDispBodyMid and close > open
        bool longMidpointTolerant = close >= longDispBodyMid - chartAtr * midpointToleranceAtr and close > open
        bool longMidpointAccepted =
             midpointAcceptanceMode == "Strict close" ? longMidpointStrict :
             midpointAcceptanceMode == "Rejection or close" ? (longMidpointStrict or longMidpointRejection) :
             (longMidpointStrict or longMidpointRejection or longMidpointTolerant)
        bool longPersistencePassed = not requireDisplacementPersistence or close >= longDispBodyMid - chartAtr * midpointToleranceAtr
        bool longAcceptancePassed = not requireAcceptance or
             (longAcceptanceWindowOpen and longMidpointAccepted and
              longPersistencePassed and longAcceptanceDirectional and longCompressionQualified)
        bool longVacuumPassed = not useLiquidityVacuumFilter or longDispVacuumPassed

        bool longStrictConfirm = longAcceptancePassed and longVacuumPassed and longFvgPassed and longVolumePassed and bullVwapAligned
        bool longDelayedConfirm = longAcceptancePassed and longVacuumPassed and longVwapWindowOpen and longFvgPassed and longVolumePassed and bullVwapAligned
        bool longModifierConfirm = longAcceptancePassed and longVacuumPassed and longFvgPassed and longVolumePassed
        bool longOffConfirm = longAcceptancePassed and longVacuumPassed and longFvgPassed and longVolumePassed
        bool longConfirmBar =
             vwapMode == "Strict" ? longStrictConfirm :
             vwapMode == "Delayed confirmation" ? longDelayedConfirm :
             vwapMode == "Grade modifier" ? longModifierConfirm :
             longOffConfirm

        dbgLongActive := longDisplacementRecorded
        dbgLongWindow := longAcceptanceWindowOpen
        dbgLongMidpoint := longMidpointAccepted and longPersistencePassed
        dbgLongDirectional := longAcceptanceDirectional
        dbgLongDirBody := longDirectionalBodyPassed
        dbgLongDirCloseLocation := longDirectionalClosePassed
        dbgLongCompression := longCompressionQualified
        dbgLongVacuum := longVacuumPassed
        dbgLongFvg := longFvgPassed
        dbgLongVolume := longVolumePassed
        dbgLongVwap := (vwapMode == "Strict" or vwapMode == "Delayed confirmation") ? bullVwapAligned : true
        dbgLongConfirm := longConfirmBar
        dbgLongDispAge := na(longDisplacementBar) ? na : bar_index - longDisplacementBar
        dbgLongMidDeltaAtr := chartAtr > 0 and not na(longDispBodyMid) ? (close - longDispBodyMid) / chartAtr : na
        dbgLongCloseLocation := closeLocation
        dbgLongBlocker :=
             not longDisplacementRecorded ? "NO DISP" :
             not longAcceptanceWindowOpen ? "WINDOW CLOSED" :
             not dbgLongMidpoint ? "MIDPOINT/CLOSE" :
             not longAcceptanceDirectional ? "DIRECTION" :
             not longCompressionQualified ? "COMPRESSION" :
             not longVacuumPassed ? "VACUUM" :
             not longFvgPassed ? "FVG" :
             not longVolumePassed ? "VOLUME" :
             not dbgLongVwap ? "VWAP" :
             longConfirmBar ? "CONFIRMED" : "UNKNOWN"

        if longConfirmBar and not longConfirmationRecorded
            totalLongConfirmation += 1
            longConfirmationRecorded := true
            longVwapAlignedAtConfirm := bullVwapAligned

        if longInvalid or longExpired or sweepConflict
            longFailureEvent := true
            longFailureSource := longSource
            string longTerminalBlocker =
                 not longDisplacementRecorded ? "DISP EXPIRED" :
                 not longFvgPassed ? "FVG REJECT" :
                 not longVolumePassed ? "VOLUME REJECT" :
                 (vwapMode == "Strict" or vwapMode == "Delayed confirmation") and not longVwapPassed ? "VWAP REJECT" :
                 longPlanBlocker == "STOP" ? "STOP INVALID" :
                 longPlanBlocker == "TARGET" ? "TARGET INVALID" :
                 longRrRejected ? "RR REJECT" : "CONFIRM EXPIRED"
            failureReason := longInvalid ? "RECLAIM LOST" : longSessionLost ? "SESSION" : sweepConflict ? "TWO-SIDED" : longTerminalBlocker
            longState := 0
        else if longConfirmBar
            string rawGrade = longBiasGradeAtArm == "A" and (longSource == "Daily" or longExternalConfirmed) ? "A" : "B"
            bool vwapGradeDowngrade = vwapMode == "Grade modifier" and not bullVwapAligned and rawGrade == "A"
            string baseGrade = vwapGradeDowngrade ? "B" : rawGrade

            if vwapGradeDowngrade and not longVwapDowngraded
                totalLongVwapDowngrade += 1
                longVwapDowngraded := true

            float basisOpen = na(longDispOpen) ? open : longDispOpen
            float basisHigh = na(longDispHigh) ? high : longDispHigh
            float basisLow = na(longDispLow) ? low : longDispLow
            float basisClose = na(longDispClose) ? close : longDispClose
            bool basisFvg = longDispFvg
            float basisRange = math.max(basisHigh - basisLow, syminfo.mintick)
            int longQualityScore =
                 (longSource == "Daily" ? 3 : 1) +
                 (longBiasGradeAtArm == "A" ? 2 : 1) +
                 (candleBody >= averageBody * 1.50 and candleBody >= chartAtr * 0.40 ? 2 : 1) +
                 (bullVwapAligned ? 1 : 0) +
                 (basisFvg ? 1 : 0) +
                 (volume >= averageVolume * volumeMultiplier ? 1 : 0)
            int longRequiredScore = isEurUsd ? eurUsdMinimumScore : autoGoldAsset ? goldMinimumScore : autoUsIndexAsset ? usIndexMinimumScore : minimumQualityScore
            float longSessionMultiplier = not useSessionWeightedConfidence ? 1.0 : rawInSession ? primeSessionWeight : offSessionWeight
            float longBaseConfidence =
                 (longSource == "Daily" ? 30.0 : 15.0) +
                 (longBiasGradeAtArm == "A" ? 20.0 : 10.0) +
                 (longDispVacuumPassed ? 15.0 : 5.0) +
                 (bullVwapAligned ? 10.0 : 0.0) +
                 (basisFvg ? 10.0 : 0.0) +
                 (volume >= averageVolume * volumeMultiplier ? 5.0 : 0.0) +
                 (longAcceptancePassed ? 10.0 : 0.0)
            float longConfidencePct = math.min(100.0, longBaseConfidence * longSessionMultiplier)
            float longSweepComponent = longSource == "Daily" ? 100.0 : 65.0
            float longBiasComponent = longBiasGradeAtArm == "A" ? 100.0 : 60.0
            float longDispComponent = math.min(100.0, nz(longDisplacementScore, 0.0))
            float longAcceptanceComponent = longAcceptancePassed ? 100.0 : 0.0
            float longVwapComponent = bullVwapAligned ? 100.0 : 0.0
            float longVolumeComponent = volume >= averageVolume * volumeMultiplier ? 100.0 : 50.0
            float longLocationReference = longSource == "Daily" ? dMid : rMid
            float longLocationDistanceAtr = chartAtr > 0.0 ? (longLocationReference - close) / chartAtr : 0.0
            longLocationScore :=
                 longLocationDistanceAtr >= 0.50 ? 100.0 :
                 longLocationDistanceAtr >= 0.00 ? 80.0 :
                 longLocationDistanceAtr >= -0.25 ? 60.0 :
                 longLocationDistanceAtr >= -0.50 ? 40.0 : 15.0
            float longCompressionComponent = nz(longCompressionScore, 0.0)
            float longEri =
                 longBiasComponent * 0.25 +
                 longDispComponent * 0.20 +
                 longAcceptanceComponent * 0.15 +
                 longSweepComponent * 0.10 +
                 longVwapComponent * 0.10 +
                 longLocationScore * 0.10 +
                 longCompressionComponent * 0.05 +
                 longVolumeComponent * 0.05
            float longSweepThreshold = useSweepAdaptiveEri ? (longSource == "Daily" ? dailySweepEriMinimum : rangeSweepEriMinimum) : activeEriThreshold
            float longRequiredEri = math.max(activeEriThreshold, longSweepThreshold)
            bool longEriEligible = not useEntryReadinessIndex or longEri >= longRequiredEri

            float longWeightTotal =
                 weightBias + weightSweep + weightDisplacement + weightCompression +
                 weightLocation + weightAcceptance + weightVwap + weightVolume

            float longUnifiedConfidence =
                 longWeightTotal > 0.0 ?
                 (
                     longBiasComponent * weightBias +
                     longSweepComponent * weightSweep +
                     longDispComponent * weightDisplacement +
                     longCompressionComponent * weightCompression +
                     longLocationScore * weightLocation +
                     longAcceptanceComponent * weightAcceptance +
                     longVwapComponent * weightVwap +
                     longVolumeComponent * weightVolume
                 ) / longWeightTotal : 0.0

            float longAssetPremium = autoGoldAsset ? goldConfidencePremium : isEurUsd ? eurUsdConfidencePremium : 0.0
            float longRequiredUnifiedConfidence = math.min(100.0, minimumUnifiedConfidence + longAssetPremium)
            bool longUnifiedEligible = not useUnifiedConfidenceModel or longUnifiedConfidence >= longRequiredUnifiedConfidence

            float longSweepDepthAtr = chartAtr > 0.0 ? (longSweptLevel - longSweepExtreme) / chartAtr : 0.0
            float longBasisBodyAtr = chartAtr > 0.0 ? math.abs(basisClose - basisOpen) / chartAtr : 0.0
            bool longBiasGate = not requireBiasStage or longBiasGradeAtArm == "A" or longBiasGradeAtArm == "B"
            bool longSweepGate = not requireSweepStage or
                 (longSweepDepthAtr >= minSweepAtr and
                  (not autoGoldAsset or longSweepDepthAtr >= goldMinimumSweepAtr))
            bool longDisplacementGate = not requireDisplacementStage or
                 (nz(longDisplacementScore, 0.0) >= minimumDisplacementScore and
                  (not autoGoldAsset or longBasisBodyAtr >= goldMinimumDisplacementAtr))
            bool longProtectedMssGate =
                 not requireProtectedMssGate or longProtectedMssPassed
            bool longGoldRangeGate =
                 not autoGoldAsset or not goldRequireRangeExtremeBreak or longGoldRangeBreakPassed
            bool longAcceptanceGate = not requireAcceptanceStage or
                 (longAcceptancePassed and
                  (not isEurUsd or not eurUsdRequireTwoAcceptanceCloses or
                   (close > longDispBodyMid and close[1] > longDispBodyMid)))
            bool longCompressionGate = not requireCompressionStage or longCompressionQualified
            bool longLocationGate = not requireLocationStage or longLocationScore >= minimumLocationScore
            bool longEurRangeGate = not isEurUsd or not eurUsdRejectInternalRangeDisplacement or
                 not (basisHigh <= rHigh and basisLow >= rLow)
            bool longHierarchyPassed =
                 longBiasGate and longSweepGate and longDisplacementGate and
                 longProtectedMssGate and longGoldRangeGate and
                 longAcceptanceGate and longCompressionGate and longLocationGate and
                 longEurRangeGate
            longPlannedGateStatus :=
                 not longBiasGate ? "BIAS" :
                 not longSweepGate ? "SWEEP" :
                 not longDisplacementGate ? "DISPLACEMENT" :
                 not longProtectedMssGate ? "PROTECTED MSS" :
                 not longGoldRangeGate ? "GOLD RANGE BREAK" :
                 not longAcceptanceGate ? "ACCEPTANCE" :
                 not longCompressionGate ? "COMPRESSION" :
                 not longLocationGate ? "LOCATION" :
                 not longEurRangeGate ? "INTERNAL RANGE" : "PASSED"

            bool longProfileEligible =
                 (not useQualityScoreGate or longQualityScore >= longRequiredScore) and
                 longConfidencePct >= longRequiredScore * 10.0 and
                 longEriEligible and
                 longUnifiedEligible and
                 (not useHierarchicalExecutionGate or longHierarchyPassed) and
                 (not isEurUsd or not eurUsdDailySweepOnly or longSource == "Daily")
            float longExtensionAtr = chartAtr > 0.0 ? (close - longSweepExtreme) / chartAtr : 999.0

            float retraceEntry =
                 retracementModel == "FVG midpoint, otherwise displacement 50%" and basisFvg and not na(longDispFvgAnchor) ? (longDispFvgAnchor + basisLow) * 0.5 :
                 (basisOpen + basisClose) * 0.5

            float addZoneLow = basisHigh - basisRange * hybridZoneDeepPct * 0.01
            float addZoneHigh = basisHigh - basisRange * hybridZoneShallowPct * 0.01
            float hybridAddEntry = addZoneHigh
            float candidateStop = longSweepExtreme - math.max(chartAtr * stopAtrBuffer, syminfo.mintick * stopTickBuffer)

            bool eurGradeBRestricted = isEurUsd and protectEurUsdGradeB and baseGrade != "A"
            bool gradeAHybridContext = baseGrade == "A" and gradeAExecution == "Hybrid scout + retracement" and longExtensionAtr <= gradeAMaxExtensionAtr
            bool gradeBPlusContext = baseGrade == "B" and enableGradeBPlus and not eurGradeBRestricted and (longBiasGradeAtArm == "A" or longSource == "Daily") and longExtensionAtr <= gradeBPlusMaxExtensionAtr
            bool preliminaryHybrid = gradeAHybridContext or gradeBPlusContext
            bool preliminaryCloseOnly = baseGrade == "A" and gradeAExecution == "Confirmation close" or (baseGrade == "B" and not gradeBPlusContext and gradeBExecution == "Confirmation close" and not eurGradeBRestricted)
            float primaryEntry = preliminaryHybrid or preliminaryCloseOnly ? close : retraceEntry
            float primaryRisk = primaryEntry - candidateStop

            float candidateTp1 = longSource == "Daily" ? dMid : rMid
            float candidateTp2 = longSource == "Daily" ? dHigh : rHigh
            string candidateTargetModel = "CRT"

            float closeRisk = close - candidateStop
            float retraceRisk = retraceEntry - candidateStop
            float hybridRisk = hybridAddEntry - candidateStop

            bool closeTargetsValid = closeRisk > syminfo.mintick and candidateTp1 > close and candidateTp2 > candidateTp1
            bool retraceTargetsValid = retraceRisk > syminfo.mintick and candidateTp1 > retraceEntry and candidateTp2 > candidateTp1
            bool hybridTargetsValid = hybridRisk > syminfo.mintick and candidateTp1 > hybridAddEntry and candidateTp2 > candidateTp1

            float closeR1 = closeTargetsValid ? (candidateTp1 - close) / closeRisk : na
            float closeR2 = closeTargetsValid ? (candidateTp2 - close) / closeRisk : na
            float retraceR1 = retraceTargetsValid ? (candidateTp1 - retraceEntry) / retraceRisk : na
            float retraceR2 = retraceTargetsValid ? (candidateTp2 - retraceEntry) / retraceRisk : na
            float hybridR1 = hybridTargetsValid ? (candidateTp1 - hybridAddEntry) / hybridRisk : na
            float hybridR2 = hybridTargetsValid ? (candidateTp2 - hybridAddEntry) / hybridRisk : na

            float prelimScoutPct = baseGrade == "A" ? gradeAScoutRiskPct : gradeBPlusScoutRiskPct
            float prelimScoutFraction = prelimScoutPct * 0.01
            float prelimAddFraction = 1.0 - prelimScoutFraction
            float prelimBlendedR1 = preliminaryHybrid and closeTargetsValid and hybridTargetsValid ? prelimScoutFraction * closeR1 + prelimAddFraction * hybridR1 : na
            float prelimBlendedR2 = preliminaryHybrid and closeTargetsValid and hybridTargetsValid ? prelimScoutFraction * closeR2 + prelimAddFraction * hybridR2 : na
            bool crtRewardValid =
                 preliminaryHybrid ? closeTargetsValid and hybridTargetsValid and prelimBlendedR1 >= minTarget1R and prelimBlendedR2 >= minTarget2R :
                 preliminaryCloseOnly ? closeTargetsValid and closeR1 >= minTarget1R and closeR2 >= minTarget2R :
                 retraceTargetsValid and retraceR1 >= minTarget1R and retraceR2 >= minTarget2R

            bool longFixedREligible =
                 (not restrictFixedRToHighQuality or longSource == "Daily" or longQualityScore >= 8) and
                 (not useEntryReadinessIndex or longEri >= fixedREriMinimum) and
                 (not useUnifiedConfidenceModel or longUnifiedConfidence >= fixedRUnifiedConfidence)
            if not crtRewardValid and useFixedRFallback and longFixedREligible and primaryRisk > syminfo.mintick
                float adaptiveLongTp1R = useAdaptiveFixedR ? (longConfidencePct >= 90.0 ? 1.25 : longConfidencePct >= 80.0 ? 1.10 : 1.00) : fallbackTp1R
                float adaptiveLongTp2R = useAdaptiveFixedR ? (longConfidencePct >= 90.0 ? 3.00 : longConfidencePct >= 80.0 ? 2.50 : longConfidencePct >= 70.0 ? 2.00 : 1.50) : fallbackTp2R
                candidateTp1 := primaryEntry + primaryRisk * adaptiveLongTp1R
                candidateTp2 := primaryEntry + primaryRisk * adaptiveLongTp2R
                candidateTargetModel := "FIXED-R"

                closeTargetsValid := closeRisk > syminfo.mintick and candidateTp1 > close and candidateTp2 > candidateTp1
                retraceTargetsValid := retraceRisk > syminfo.mintick and candidateTp1 > retraceEntry and candidateTp2 > candidateTp1
                hybridTargetsValid := hybridRisk > syminfo.mintick and candidateTp1 > hybridAddEntry and candidateTp2 > candidateTp1
                closeR1 := closeTargetsValid ? (candidateTp1 - close) / closeRisk : na
                closeR2 := closeTargetsValid ? (candidateTp2 - close) / closeRisk : na
                retraceR1 := retraceTargetsValid ? (candidateTp1 - retraceEntry) / retraceRisk : na
                retraceR2 := retraceTargetsValid ? (candidateTp2 - retraceEntry) / retraceRisk : na
                hybridR1 := hybridTargetsValid ? (candidateTp1 - hybridAddEntry) / hybridRisk : na
                hybridR2 := hybridTargetsValid ? (candidateTp2 - hybridAddEntry) / hybridRisk : na

            bool gradeBPlusEligible = gradeBPlusContext and closeTargetsValid and closeR2 >= gradeBPlusMinCloseR2
            bool useHybrid = gradeAHybridContext or gradeBPlusEligible
            bool useCloseOnly = baseGrade == "A" and gradeAExecution == "Confirmation close" or (baseGrade == "B" and not gradeBPlusEligible and gradeBExecution == "Confirmation close" and not eurGradeBRestricted)
            string candidateGrade = gradeBPlusEligible ? "B+" : baseGrade
            float candidateScoutPct = useHybrid ? (baseGrade == "A" ? gradeAScoutRiskPct : gradeBPlusScoutRiskPct) : eurGradeBRestricted ? eurUsdGradeBRiskPct : 100.0
            float scoutFraction = candidateScoutPct * 0.01
            float addFraction = 1.0 - scoutFraction
            float blendedR1 = useHybrid and closeTargetsValid and hybridTargetsValid ? scoutFraction * closeR1 + addFraction * hybridR1 : na
            float blendedR2 = useHybrid and closeTargetsValid and hybridTargetsValid ? scoutFraction * closeR2 + addFraction * hybridR2 : na

            float candidateEntry = useFirstReturnExecution ? retraceEntry : useHybrid or useCloseOnly ? close : retraceEntry
            bool validRisk = useFirstReturnExecution ? retraceRisk > syminfo.mintick : useHybrid ? closeRisk > syminfo.mintick and hybridRisk > syminfo.mintick : useCloseOnly ? closeRisk > syminfo.mintick : retraceRisk > syminfo.mintick
            bool validTargets = useFirstReturnExecution ? retraceTargetsValid : useHybrid ? closeTargetsValid and hybridTargetsValid : useCloseOnly ? closeTargetsValid : retraceTargetsValid
            bool longLocationEligible =
                 not usePremiumDiscountFilter or
                 ((useLocationScore and longLocationScore >= minimumLocationScore) or
                  (not useLocationScore and candidateEntry <= (longSource == "Daily" ? dMid : rMid) + chartAtr * discountToleranceAtr))
            bool validRewardBase = useFirstReturnExecution ? validTargets and retraceR1 >= minTarget1R and retraceR2 >= minTarget2R : useHybrid ? validTargets and blendedR1 >= minTarget1R and blendedR2 >= minTarget2R : useCloseOnly ? validTargets and closeR1 >= minTarget1R and closeR2 >= minTarget2R : validTargets and retraceR1 >= minTarget1R and retraceR2 >= minTarget2R
            bool longIndexExtensionEligible = not autoUsIndexAsset or longExtensionAtr <= indexMaximumExtensionAtr
            // The setup has already passed the confirmation state machine. In restored
            // production mode, do not veto it a second time with duplicate profile,
            // hierarchy and location gates. Risk, target geometry and minimum RR remain hard.
            bool longPostConfirmationEligible =
                 not strictExecutionGate or
                 (longProfileEligible and longLocationEligible and longIndexExtensionEligible)
            bool validReward = validRewardBase and longPostConfirmationEligible

            longPlanBlocker :=
                 not validRisk ? "STOP" :
                 not validTargets ? "TARGET" :
                 not validRewardBase ? "RR" :
                 strictExecutionGate and not longProfileEligible ? "PROFILE" :
                 strictExecutionGate and not longLocationEligible ? "LOCATION" :
                 strictExecutionGate and not longIndexExtensionEligible ? "INDEX EXT" : ""

            if not validReward
                longRrRejected := true

            if validReward
                longPlannedEntry := f_roundToTick(candidateEntry)
                longPlannedAddEntry := useHybrid ? f_roundToTick(hybridAddEntry) : na
                longPlannedAddZoneLow := useHybrid ? f_roundToTick(addZoneLow) : na
                longPlannedAddZoneHigh := useHybrid ? f_roundToTick(addZoneHigh) : na
                longPlannedStop := f_roundToTick(candidateStop)
                longPlannedTp1 := f_roundToTick(candidateTp1)
                longPlannedTp2 := f_roundToTick(candidateTp2)
                longTargetModel := candidateTargetModel
                longScoutRiskPct := candidateScoutPct
                longReadyBar := bar_index
                longGrade := candidateGrade
                longPlannedQualityScore := longQualityScore
                longPlannedConfidencePct := longConfidencePct
                longPlannedEri := longEri
                float longTierScore = useUnifiedConfidenceModel ? longUnifiedConfidence : longEri
                longPlannedExecutionGrade :=
                     longTierScore >= 95.0 ? "ELITE" :
                     longTierScore >= 90.0 ? "INSTITUTIONAL" :
                     longTierScore >= 85.0 ? "PRIME" :
                     longTierScore >= 80.0 ? "PROFESSIONAL" :
                     longTierScore >= 75.0 ? "RESEARCH" : "REJECT"
                longPlannedConfidenceTier := longPlannedExecutionGrade
                longPlannedUnifiedConfidence := longUnifiedConfidence
                longPlannedGateStatus := longHierarchyPassed ? "PASSED" : longPlannedGateStatus
                longExecutionType := useFirstReturnExecution ? "FIRST RETURN" : useHybrid ? "HYBRID" : useCloseOnly ? "CLOSE" : "RETRACE"
                longReadyEvent := true
                totalLongReady += 1

                if candidateTargetModel == "FIXED-R"
                    totalLongFixedRFallback += 1

                if not useFirstReturnExecution and (useHybrid or useCloseOnly)
                    buySignal := true
                    signalEntry := longPlannedEntry
                    signalAddEntry := longPlannedAddEntry
                    signalAddZoneLow := longPlannedAddZoneLow
                    signalAddZoneHigh := longPlannedAddZoneHigh
                    signalScoutRiskPct := longScoutRiskPct
                    signalStop := longPlannedStop
                    signalTp1 := longPlannedTp1
                    signalTp2 := longPlannedTp2
                    signalGrade := longGrade
                    signalSource := longSource
                    signalExecutionType := longExecutionType
                    signalTargetModel := longTargetModel
                    signalQualityScore := longPlannedQualityScore
                    signalConfidencePct := longPlannedConfidencePct
                    signalEri := longPlannedEri
                    signalExecutionGrade := longPlannedExecutionGrade
                    signalConfidenceTier := longPlannedConfidenceTier
                    signalUnifiedConfidence := longPlannedUnifiedConfidence
                    signalGateStatus := longPlannedGateStatus
                    longState := 0
                    lastSignalBar := bar_index
                else
                    longState := 3

    //-------------------------------------------------------------------------
    // SHORT: MSS -> DISPLACEMENT / VWAP / CONFIRMATION / EXECUTION PLAN
    //-------------------------------------------------------------------------
    if shortState == 2
        shortSweepExtreme := math.max(shortSweepExtreme, high)
        shortExternalConfirmed := shortExternalConfirmed or close < shortExternalBreak

        int shortAge = bar_index - shortArmBar
        int shortMssAge = bar_index - shortMssBar
        bool shortGraceExpired = confirmationPolicy == "Grace after valid arm" and shortAge > confirmationGraceBars
        bool shortSessionLost = confirmationPolicy == "Must remain in session" and not inSession
        bool shortExpired = shortAge > armedExpiryBars or shortMssAge > effectiveDisplacementGrace + effectiveVwapGrace or shortGraceExpired or shortSessionLost
        bool shortInvalid = close > shortSweptLevel

        if bearDisplacementQualified
            if not shortDisplacementRecorded
                totalShortDisplacement += 1
                shortDisplacementRecorded := true

            shortDisplacementBar := bar_index
            shortDispOpen := open
            shortDispHigh := high
            shortDispLow := low
            shortDispClose := close
            shortDispFvg := bearFvg
            shortDispBodyMid := (open + close) * 0.5
            shortDispVacuumPassed := not useLiquidityVacuumFilter or
                 (candleBody >= chartAtr * vacuumBodyAtrMin and volume >= averageVolume * vacuumVolumeMultiplier)
            shortDisplacementScore := bearDisplacementScore
            shortProtectedMssLevel :=
                 not na(lastConfirmedPivotLow) ? lastConfirmedPivotLow :
                 useInternalBreakFallback ? shortInternalBreak : na
            shortProtectedMssPassed :=
                 not requireProtectedMssGate or
                 (not na(shortProtectedMssLevel) and close < shortProtectedMssLevel - chartAtr * mssCloseBufferAtr)
            shortGoldRangeBreakPassed :=
                 not autoGoldAsset or not goldRequireRangeExtremeBreak or
                 (not na(rLow) and close < rLow - chartAtr * goldRangeBreakBufferAtr)
            shortDispFvgAnchor := low[2]
            shortFvgPassed := bearFvgOk
            shortVolumePassed := bearVolumeOk

            shortVwapPassed := bearVwapAligned

        bool shortVwapWindowOpen = shortDisplacementRecorded and not na(shortDisplacementBar) and bar_index - shortDisplacementBar <= vwapGraceBars
        if shortVwapWindowOpen and bearVwapAligned
            shortVwapPassed := true

        bool shortCompressionWindowOpen = shortDisplacementRecorded and not na(shortDisplacementBar) and bar_index - shortDisplacementBar >= compressionBars
        float shortPriorCompressionHigh = ta.highest(high[1], compressionLookback)
        float shortPriorCompressionLow = ta.lowest(low[1], compressionLookback)
        float shortCompressionRange = shortPriorCompressionHigh - shortPriorCompressionLow
        float shortDisplacementRange = math.max(shortDispHigh - shortDispLow, syminfo.mintick)
        float shortCompressionRatioToDisp = shortDisplacementRange > 0.0 ? shortCompressionRange / shortDisplacementRange : 10.0
        float shortCompressionRatioToAtr = chartAtr > 0.0 ? shortCompressionRange / chartAtr : 10.0
        float shortCompressionTightnessScore =
             math.max(0.0, 100.0 - shortCompressionRatioToDisp * 100.0)
        float shortCompressionAtrScore =
             math.max(0.0, 100.0 - shortCompressionRatioToAtr * 70.0)
        float shortCompressionBreakScore = close < shortPriorCompressionLow ? 100.0 : close < shortPriorCompressionHigh ? 55.0 : 20.0
        shortCompressionScore :=
             shortCompressionTightnessScore * 0.45 +
             shortCompressionAtrScore * 0.35 +
             shortCompressionBreakScore * 0.20
        bool shortCompressionRangeOk =
             shortCompressionRange <= shortDisplacementRange * maxCompressionToDisplacement and
             shortCompressionRange <= chartAtr * maxCompressionAtr
        bool shortCompressionBreakoutOk = not requireCompressionBreakout or close < shortPriorCompressionLow
        shortCompressionQualified := not useCompressionQualification or
             (shortCompressionWindowOpen and
              ((useCompressionScore and shortCompressionScore >= minimumCompressionScore) or
               (not useCompressionScore and shortCompressionRangeOk and shortCompressionBreakoutOk)))
        shortCompressionHigh := shortPriorCompressionHigh
        shortCompressionLow := shortPriorCompressionLow

        bool shortAcceptanceWindowOpen = shortDisplacementRecorded and not na(shortDisplacementBar) and bar_index > shortDisplacementBar and bar_index - shortDisplacementBar <= acceptanceGraceBars
        bool shortDirectionalBodyPassed = not requireDirectionalAcceptance or close < open
        bool shortDirectionalClosePassed = not requireDirectionalAcceptance or closeLocation <= 0.40
        bool shortAcceptanceDirectional = shortDirectionalBodyPassed and shortDirectionalClosePassed
        bool shortMidpointStrict = close < shortDispBodyMid
        bool shortMidpointRejection = high >= shortDispBodyMid and close < shortDispBodyMid and close < open
        bool shortMidpointTolerant = close <= shortDispBodyMid + chartAtr * midpointToleranceAtr and close < open
        bool shortMidpointAccepted =
             midpointAcceptanceMode == "Strict close" ? shortMidpointStrict :
             midpointAcceptanceMode == "Rejection or close" ? (shortMidpointStrict or shortMidpointRejection) :
             (shortMidpointStrict or shortMidpointRejection or shortMidpointTolerant)
        bool shortPersistencePassed = not requireDisplacementPersistence or close <= shortDispBodyMid + chartAtr * midpointToleranceAtr
        bool shortAcceptancePassed = not requireAcceptance or
             (shortAcceptanceWindowOpen and shortMidpointAccepted and
              shortPersistencePassed and shortAcceptanceDirectional and shortCompressionQualified)
        bool shortVacuumPassed = not useLiquidityVacuumFilter or shortDispVacuumPassed

        bool shortStrictConfirm = shortAcceptancePassed and shortVacuumPassed and shortFvgPassed and shortVolumePassed and bearVwapAligned
        bool shortDelayedConfirm = shortAcceptancePassed and shortVacuumPassed and shortVwapWindowOpen and shortFvgPassed and shortVolumePassed and bearVwapAligned
        bool shortModifierConfirm = shortAcceptancePassed and shortVacuumPassed and shortFvgPassed and shortVolumePassed
        bool shortOffConfirm = shortAcceptancePassed and shortVacuumPassed and shortFvgPassed and shortVolumePassed
        bool shortConfirmBar =
             vwapMode == "Strict" ? shortStrictConfirm :
             vwapMode == "Delayed confirmation" ? shortDelayedConfirm :
             vwapMode == "Grade modifier" ? shortModifierConfirm :
             shortOffConfirm

        dbgShortActive := shortDisplacementRecorded
        dbgShortWindow := shortAcceptanceWindowOpen
        dbgShortMidpoint := shortMidpointAccepted and shortPersistencePassed
        dbgShortDirectional := shortAcceptanceDirectional
        dbgShortDirBody := shortDirectionalBodyPassed
        dbgShortDirCloseLocation := shortDirectionalClosePassed
        dbgShortCompression := shortCompressionQualified
        dbgShortVacuum := shortVacuumPassed
        dbgShortFvg := shortFvgPassed
        dbgShortVolume := shortVolumePassed
        dbgShortVwap := (vwapMode == "Strict" or vwapMode == "Delayed confirmation") ? bearVwapAligned : true
        dbgShortConfirm := shortConfirmBar
        dbgShortDispAge := na(shortDisplacementBar) ? na : bar_index - shortDisplacementBar
        dbgShortMidDeltaAtr := chartAtr > 0 and not na(shortDispBodyMid) ? (shortDispBodyMid - close) / chartAtr : na
        dbgShortCloseLocation := closeLocation
        dbgShortBlocker :=
             not shortDisplacementRecorded ? "NO DISP" :
             not shortAcceptanceWindowOpen ? "WINDOW CLOSED" :
             not dbgShortMidpoint ? "MIDPOINT/CLOSE" :
             not shortAcceptanceDirectional ? "DIRECTION" :
             not shortCompressionQualified ? "COMPRESSION" :
             not shortVacuumPassed ? "VACUUM" :
             not shortFvgPassed ? "FVG" :
             not shortVolumePassed ? "VOLUME" :
             not dbgShortVwap ? "VWAP" :
             shortConfirmBar ? "CONFIRMED" : "UNKNOWN"

        if shortConfirmBar and not shortConfirmationRecorded
            totalShortConfirmation += 1
            shortConfirmationRecorded := true
            shortVwapAlignedAtConfirm := bearVwapAligned

        if shortInvalid or shortExpired or sweepConflict
            shortFailureEvent := true
            shortFailureSource := shortSource
            string shortTerminalBlocker =
                 not shortDisplacementRecorded ? "DISP EXPIRED" :
                 not shortFvgPassed ? "FVG REJECT" :
                 not shortVolumePassed ? "VOLUME REJECT" :
                 (vwapMode == "Strict" or vwapMode == "Delayed confirmation") and not shortVwapPassed ? "VWAP REJECT" :
                 shortPlanBlocker == "STOP" ? "STOP INVALID" :
                 shortPlanBlocker == "TARGET" ? "TARGET INVALID" :
                 shortRrRejected ? "RR REJECT" : "CONFIRM EXPIRED"
            failureReason := shortInvalid ? "RECLAIM LOST" : shortSessionLost ? "SESSION" : sweepConflict ? "TWO-SIDED" : shortTerminalBlocker
            shortState := 0
        else if shortConfirmBar
            string rawGrade = shortBiasGradeAtArm == "A" and (shortSource == "Daily" or shortExternalConfirmed) ? "A" : "B"
            bool vwapGradeDowngrade = vwapMode == "Grade modifier" and not bearVwapAligned and rawGrade == "A"
            string baseGrade = vwapGradeDowngrade ? "B" : rawGrade

            if vwapGradeDowngrade and not shortVwapDowngraded
                totalShortVwapDowngrade += 1
                shortVwapDowngraded := true

            float basisOpen = na(shortDispOpen) ? open : shortDispOpen
            float basisHigh = na(shortDispHigh) ? high : shortDispHigh
            float basisLow = na(shortDispLow) ? low : shortDispLow
            float basisClose = na(shortDispClose) ? close : shortDispClose
            bool basisFvg = shortDispFvg
            float basisRange = math.max(basisHigh - basisLow, syminfo.mintick)
            int shortQualityScore =
                 (shortSource == "Daily" ? 3 : 1) +
                 (shortBiasGradeAtArm == "A" ? 2 : 1) +
                 (candleBody >= averageBody * 1.50 and candleBody >= chartAtr * 0.40 ? 2 : 1) +
                 (bearVwapAligned ? 1 : 0) +
                 (basisFvg ? 1 : 0) +
                 (volume >= averageVolume * volumeMultiplier ? 1 : 0)
            int shortRequiredScore = isEurUsd ? eurUsdMinimumScore : autoGoldAsset ? goldMinimumScore : autoUsIndexAsset ? usIndexMinimumScore : minimumQualityScore
            float shortSessionMultiplier = not useSessionWeightedConfidence ? 1.0 : rawInSession ? primeSessionWeight : offSessionWeight
            float shortBaseConfidence =
                 (shortSource == "Daily" ? 30.0 : 15.0) +
                 (shortBiasGradeAtArm == "A" ? 20.0 : 10.0) +
                 (shortDispVacuumPassed ? 15.0 : 5.0) +
                 (bearVwapAligned ? 10.0 : 0.0) +
                 (basisFvg ? 10.0 : 0.0) +
                 (volume >= averageVolume * volumeMultiplier ? 5.0 : 0.0) +
                 (shortAcceptancePassed ? 10.0 : 0.0)
            float shortConfidencePct = math.min(100.0, shortBaseConfidence * shortSessionMultiplier)
            float shortSweepComponent = shortSource == "Daily" ? 100.0 : 65.0
            float shortBiasComponent = shortBiasGradeAtArm == "A" ? 100.0 : 60.0
            float shortDispComponent = math.min(100.0, nz(shortDisplacementScore, 0.0))
            float shortAcceptanceComponent = shortAcceptancePassed ? 100.0 : 0.0
            float shortVwapComponent = bearVwapAligned ? 100.0 : 0.0
            float shortVolumeComponent = volume >= averageVolume * volumeMultiplier ? 100.0 : 50.0
            float shortLocationReference = shortSource == "Daily" ? dMid : rMid
            float shortLocationDistanceAtr = chartAtr > 0.0 ? (close - shortLocationReference) / chartAtr : 0.0
            shortLocationScore :=
                 shortLocationDistanceAtr >= 0.50 ? 100.0 :
                 shortLocationDistanceAtr >= 0.00 ? 80.0 :
                 shortLocationDistanceAtr >= -0.25 ? 60.0 :
                 shortLocationDistanceAtr >= -0.50 ? 40.0 : 15.0
            float shortCompressionComponent = nz(shortCompressionScore, 0.0)
            float shortEri =
                 shortBiasComponent * 0.25 +
                 shortDispComponent * 0.20 +
                 shortAcceptanceComponent * 0.15 +
                 shortSweepComponent * 0.10 +
                 shortVwapComponent * 0.10 +
                 shortLocationScore * 0.10 +
                 shortCompressionComponent * 0.05 +
                 shortVolumeComponent * 0.05
            float shortSweepThreshold = useSweepAdaptiveEri ? (shortSource == "Daily" ? dailySweepEriMinimum : rangeSweepEriMinimum) : activeEriThreshold
            float shortRequiredEri = math.max(activeEriThreshold, shortSweepThreshold)
            bool shortEriEligible = not useEntryReadinessIndex or shortEri >= shortRequiredEri

            float shortWeightTotal =
                 weightBias + weightSweep + weightDisplacement + weightCompression +
                 weightLocation + weightAcceptance + weightVwap + weightVolume

            float shortUnifiedConfidence =
                 shortWeightTotal > 0.0 ?
                 (
                     shortBiasComponent * weightBias +
                     shortSweepComponent * weightSweep +
                     shortDispComponent * weightDisplacement +
                     shortCompressionComponent * weightCompression +
                     shortLocationScore * weightLocation +
                     shortAcceptanceComponent * weightAcceptance +
                     shortVwapComponent * weightVwap +
                     shortVolumeComponent * weightVolume
                 ) / shortWeightTotal : 0.0

            float shortAssetPremium = autoGoldAsset ? goldConfidencePremium : isEurUsd ? eurUsdConfidencePremium : 0.0
            float shortRequiredUnifiedConfidence = math.min(100.0, minimumUnifiedConfidence + shortAssetPremium)
            bool shortUnifiedEligible = not useUnifiedConfidenceModel or shortUnifiedConfidence >= shortRequiredUnifiedConfidence

            float shortSweepDepthAtr = chartAtr > 0.0 ? (shortSweepExtreme - shortSweptLevel) / chartAtr : 0.0
            float shortBasisBodyAtr = chartAtr > 0.0 ? math.abs(basisClose - basisOpen) / chartAtr : 0.0
            bool shortBiasGate = not requireBiasStage or shortBiasGradeAtArm == "A" or shortBiasGradeAtArm == "B"
            bool shortSweepGate = not requireSweepStage or
                 (shortSweepDepthAtr >= minSweepAtr and
                  (not autoGoldAsset or shortSweepDepthAtr >= goldMinimumSweepAtr))
            bool shortDisplacementGate = not requireDisplacementStage or
                 (nz(shortDisplacementScore, 0.0) >= minimumDisplacementScore and
                  (not autoGoldAsset or shortBasisBodyAtr >= goldMinimumDisplacementAtr))
            bool shortProtectedMssGate =
                 not requireProtectedMssGate or shortProtectedMssPassed
            bool shortGoldRangeGate =
                 not autoGoldAsset or not goldRequireRangeExtremeBreak or shortGoldRangeBreakPassed
            bool shortAcceptanceGate = not requireAcceptanceStage or
                 (shortAcceptancePassed and
                  (not isEurUsd or not eurUsdRequireTwoAcceptanceCloses or
                   (close < shortDispBodyMid and close[1] < shortDispBodyMid)))
            bool shortCompressionGate = not requireCompressionStage or shortCompressionQualified
            bool shortLocationGate = not requireLocationStage or shortLocationScore >= minimumLocationScore
            bool shortEurRangeGate = not isEurUsd or not eurUsdRejectInternalRangeDisplacement or
                 not (basisHigh <= rHigh and basisLow >= rLow)
            bool shortHierarchyPassed =
                 shortBiasGate and shortSweepGate and shortDisplacementGate and
                 shortProtectedMssGate and shortGoldRangeGate and
                 shortAcceptanceGate and shortCompressionGate and shortLocationGate and
                 shortEurRangeGate
            shortPlannedGateStatus :=
                 not shortBiasGate ? "BIAS" :
                 not shortSweepGate ? "SWEEP" :
                 not shortDisplacementGate ? "DISPLACEMENT" :
                 not shortProtectedMssGate ? "PROTECTED MSS" :
                 not shortGoldRangeGate ? "GOLD RANGE BREAK" :
                 not shortAcceptanceGate ? "ACCEPTANCE" :
                 not shortCompressionGate ? "COMPRESSION" :
                 not shortLocationGate ? "LOCATION" :
                 not shortEurRangeGate ? "INTERNAL RANGE" : "PASSED"

            bool shortProfileEligible =
                 (not useQualityScoreGate or shortQualityScore >= shortRequiredScore) and
                 shortConfidencePct >= shortRequiredScore * 10.0 and
                 shortEriEligible and
                 shortUnifiedEligible and
                 (not useHierarchicalExecutionGate or shortHierarchyPassed) and
                 (not isEurUsd or not eurUsdDailySweepOnly or shortSource == "Daily")
            float shortExtensionAtr = chartAtr > 0.0 ? (shortSweepExtreme - close) / chartAtr : 999.0

            float retraceEntry =
                 retracementModel == "FVG midpoint, otherwise displacement 50%" and basisFvg and not na(shortDispFvgAnchor) ? (shortDispFvgAnchor + basisHigh) * 0.5 :
                 (basisOpen + basisClose) * 0.5

            float addZoneLow = basisLow + basisRange * hybridZoneShallowPct * 0.01
            float addZoneHigh = basisLow + basisRange * hybridZoneDeepPct * 0.01
            float hybridAddEntry = addZoneLow
            float candidateStop = shortSweepExtreme + math.max(chartAtr * stopAtrBuffer, syminfo.mintick * stopTickBuffer)

            bool eurGradeBRestricted = isEurUsd and protectEurUsdGradeB and baseGrade != "A"
            bool gradeAHybridContext = baseGrade == "A" and gradeAExecution == "Hybrid scout + retracement" and shortExtensionAtr <= gradeAMaxExtensionAtr
            bool gradeBPlusContext = baseGrade == "B" and enableGradeBPlus and not eurGradeBRestricted and (shortBiasGradeAtArm == "A" or shortSource == "Daily") and shortExtensionAtr <= gradeBPlusMaxExtensionAtr
            bool preliminaryHybrid = gradeAHybridContext or gradeBPlusContext
            bool preliminaryCloseOnly = baseGrade == "A" and gradeAExecution == "Confirmation close" or (baseGrade == "B" and not gradeBPlusContext and gradeBExecution == "Confirmation close" and not eurGradeBRestricted)
            float primaryEntry = preliminaryHybrid or preliminaryCloseOnly ? close : retraceEntry
            float primaryRisk = candidateStop - primaryEntry

            float candidateTp1 = shortSource == "Daily" ? dMid : rMid
            float candidateTp2 = shortSource == "Daily" ? dLow : rLow
            string candidateTargetModel = "CRT"

            float closeRisk = candidateStop - close
            float retraceRisk = candidateStop - retraceEntry
            float hybridRisk = candidateStop - hybridAddEntry

            bool closeTargetsValid = closeRisk > syminfo.mintick and candidateTp1 < close and candidateTp2 < candidateTp1
            bool retraceTargetsValid = retraceRisk > syminfo.mintick and candidateTp1 < retraceEntry and candidateTp2 < candidateTp1
            bool hybridTargetsValid = hybridRisk > syminfo.mintick and candidateTp1 < hybridAddEntry and candidateTp2 < candidateTp1

            float closeR1 = closeTargetsValid ? (close - candidateTp1) / closeRisk : na
            float closeR2 = closeTargetsValid ? (close - candidateTp2) / closeRisk : na
            float retraceR1 = retraceTargetsValid ? (retraceEntry - candidateTp1) / retraceRisk : na
            float retraceR2 = retraceTargetsValid ? (retraceEntry - candidateTp2) / retraceRisk : na
            float hybridR1 = hybridTargetsValid ? (hybridAddEntry - candidateTp1) / hybridRisk : na
            float hybridR2 = hybridTargetsValid ? (hybridAddEntry - candidateTp2) / hybridRisk : na

            float prelimScoutPct = baseGrade == "A" ? gradeAScoutRiskPct : gradeBPlusScoutRiskPct
            float prelimScoutFraction = prelimScoutPct * 0.01
            float prelimAddFraction = 1.0 - prelimScoutFraction
            float prelimBlendedR1 = preliminaryHybrid and closeTargetsValid and hybridTargetsValid ? prelimScoutFraction * closeR1 + prelimAddFraction * hybridR1 : na
            float prelimBlendedR2 = preliminaryHybrid and closeTargetsValid and hybridTargetsValid ? prelimScoutFraction * closeR2 + prelimAddFraction * hybridR2 : na
            bool crtRewardValid =
                 preliminaryHybrid ? closeTargetsValid and hybridTargetsValid and prelimBlendedR1 >= minTarget1R and prelimBlendedR2 >= minTarget2R :
                 preliminaryCloseOnly ? closeTargetsValid and closeR1 >= minTarget1R and closeR2 >= minTarget2R :
                 retraceTargetsValid and retraceR1 >= minTarget1R and retraceR2 >= minTarget2R

            bool shortFixedREligible =
                 (not restrictFixedRToHighQuality or shortSource == "Daily" or shortQualityScore >= 8) and
                 (not useEntryReadinessIndex or shortEri >= fixedREriMinimum) and
                 (not useUnifiedConfidenceModel or shortUnifiedConfidence >= fixedRUnifiedConfidence)
            if not crtRewardValid and useFixedRFallback and shortFixedREligible and primaryRisk > syminfo.mintick
                float adaptiveShortTp1R = useAdaptiveFixedR ? (shortConfidencePct >= 90.0 ? 1.25 : shortConfidencePct >= 80.0 ? 1.10 : 1.00) : fallbackTp1R
                float adaptiveShortTp2R = useAdaptiveFixedR ? (shortConfidencePct >= 90.0 ? 3.00 : shortConfidencePct >= 80.0 ? 2.50 : shortConfidencePct >= 70.0 ? 2.00 : 1.50) : fallbackTp2R
                candidateTp1 := primaryEntry - primaryRisk * adaptiveShortTp1R
                candidateTp2 := primaryEntry - primaryRisk * adaptiveShortTp2R
                candidateTargetModel := "FIXED-R"

                closeTargetsValid := closeRisk > syminfo.mintick and candidateTp1 < close and candidateTp2 < candidateTp1
                retraceTargetsValid := retraceRisk > syminfo.mintick and candidateTp1 < retraceEntry and candidateTp2 < candidateTp1
                hybridTargetsValid := hybridRisk > syminfo.mintick and candidateTp1 < hybridAddEntry and candidateTp2 < candidateTp1
                closeR1 := closeTargetsValid ? (close - candidateTp1) / closeRisk : na
                closeR2 := closeTargetsValid ? (close - candidateTp2) / closeRisk : na
                retraceR1 := retraceTargetsValid ? (retraceEntry - candidateTp1) / retraceRisk : na
                retraceR2 := retraceTargetsValid ? (retraceEntry - candidateTp2) / retraceRisk : na
                hybridR1 := hybridTargetsValid ? (hybridAddEntry - candidateTp1) / hybridRisk : na
                hybridR2 := hybridTargetsValid ? (hybridAddEntry - candidateTp2) / hybridRisk : na

            bool gradeBPlusEligible = gradeBPlusContext and closeTargetsValid and closeR2 >= gradeBPlusMinCloseR2
            bool useHybrid = gradeAHybridContext or gradeBPlusEligible
            bool useCloseOnly = baseGrade == "A" and gradeAExecution == "Confirmation close" or (baseGrade == "B" and not gradeBPlusEligible and gradeBExecution == "Confirmation close" and not eurGradeBRestricted)
            string candidateGrade = gradeBPlusEligible ? "B+" : baseGrade
            float candidateScoutPct = useHybrid ? (baseGrade == "A" ? gradeAScoutRiskPct : gradeBPlusScoutRiskPct) : eurGradeBRestricted ? eurUsdGradeBRiskPct : 100.0
            float scoutFraction = candidateScoutPct * 0.01
            float addFraction = 1.0 - scoutFraction
            float blendedR1 = useHybrid and closeTargetsValid and hybridTargetsValid ? scoutFraction * closeR1 + addFraction * hybridR1 : na
            float blendedR2 = useHybrid and closeTargetsValid and hybridTargetsValid ? scoutFraction * closeR2 + addFraction * hybridR2 : na

            float candidateEntry = useFirstReturnExecution ? retraceEntry : useHybrid or useCloseOnly ? close : retraceEntry
            bool validRisk = useFirstReturnExecution ? retraceRisk > syminfo.mintick : useHybrid ? closeRisk > syminfo.mintick and hybridRisk > syminfo.mintick : useCloseOnly ? closeRisk > syminfo.mintick : retraceRisk > syminfo.mintick
            bool validTargets = useFirstReturnExecution ? retraceTargetsValid : useHybrid ? closeTargetsValid and hybridTargetsValid : useCloseOnly ? closeTargetsValid : retraceTargetsValid
            bool shortLocationEligible =
                 not usePremiumDiscountFilter or
                 ((useLocationScore and shortLocationScore >= minimumLocationScore) or
                  (not useLocationScore and candidateEntry >= (shortSource == "Daily" ? dMid : rMid) - chartAtr * discountToleranceAtr))
            bool validRewardBase = useFirstReturnExecution ? validTargets and retraceR1 >= minTarget1R and retraceR2 >= minTarget2R : useHybrid ? validTargets and blendedR1 >= minTarget1R and blendedR2 >= minTarget2R : useCloseOnly ? validTargets and closeR1 >= minTarget1R and closeR2 >= minTarget2R : validTargets and retraceR1 >= minTarget1R and retraceR2 >= minTarget2R
            bool shortIndexExtensionEligible = not autoUsIndexAsset or shortExtensionAtr <= indexMaximumExtensionAtr
            // The setup has already passed the confirmation state machine. In restored
            // production mode, do not veto it a second time with duplicate profile,
            // hierarchy and location gates. Risk, target geometry and minimum RR remain hard.
            bool shortPostConfirmationEligible =
                 not strictExecutionGate or
                 (shortProfileEligible and shortLocationEligible and shortIndexExtensionEligible)
            bool validReward = validRewardBase and shortPostConfirmationEligible

            shortPlanBlocker :=
                 not validRisk ? "STOP" :
                 not validTargets ? "TARGET" :
                 not validRewardBase ? "RR" :
                 strictExecutionGate and not shortProfileEligible ? "PROFILE" :
                 strictExecutionGate and not shortLocationEligible ? "LOCATION" :
                 strictExecutionGate and not shortIndexExtensionEligible ? "INDEX EXT" : ""

            if not validReward
                shortRrRejected := true

            if validReward
                shortPlannedEntry := f_roundToTick(candidateEntry)
                shortPlannedAddEntry := useHybrid ? f_roundToTick(hybridAddEntry) : na
                shortPlannedAddZoneLow := useHybrid ? f_roundToTick(addZoneLow) : na
                shortPlannedAddZoneHigh := useHybrid ? f_roundToTick(addZoneHigh) : na
                shortPlannedStop := f_roundToTick(candidateStop)
                shortPlannedTp1 := f_roundToTick(candidateTp1)
                shortPlannedTp2 := f_roundToTick(candidateTp2)
                shortTargetModel := candidateTargetModel
                shortScoutRiskPct := candidateScoutPct
                shortReadyBar := bar_index
                shortGrade := candidateGrade
                shortPlannedQualityScore := shortQualityScore
                shortPlannedConfidencePct := shortConfidencePct
                shortPlannedEri := shortEri
                float shortTierScore = useUnifiedConfidenceModel ? shortUnifiedConfidence : shortEri
                shortPlannedExecutionGrade :=
                     shortTierScore >= 95.0 ? "ELITE" :
                     shortTierScore >= 90.0 ? "INSTITUTIONAL" :
                     shortTierScore >= 85.0 ? "PRIME" :
                     shortTierScore >= 80.0 ? "PROFESSIONAL" :
                     shortTierScore >= 75.0 ? "RESEARCH" : "REJECT"
                shortPlannedConfidenceTier := shortPlannedExecutionGrade
                shortPlannedUnifiedConfidence := shortUnifiedConfidence
                shortPlannedGateStatus := shortHierarchyPassed ? "PASSED" : shortPlannedGateStatus
                shortExecutionType := useFirstReturnExecution ? "FIRST RETURN" : useHybrid ? "HYBRID" : useCloseOnly ? "CLOSE" : "RETRACE"
                shortReadyEvent := true
                totalShortReady += 1

                if candidateTargetModel == "FIXED-R"
                    totalShortFixedRFallback += 1

                if not useFirstReturnExecution and (useHybrid or useCloseOnly)
                    sellSignal := true
                    signalEntry := shortPlannedEntry
                    signalAddEntry := shortPlannedAddEntry
                    signalAddZoneLow := shortPlannedAddZoneLow
                    signalAddZoneHigh := shortPlannedAddZoneHigh
                    signalScoutRiskPct := shortScoutRiskPct
                    signalStop := shortPlannedStop
                    signalTp1 := shortPlannedTp1
                    signalTp2 := shortPlannedTp2
                    signalGrade := shortGrade
                    signalSource := shortSource
                    signalExecutionType := shortExecutionType
                    signalTargetModel := shortTargetModel
                    signalQualityScore := shortPlannedQualityScore
                    signalConfidencePct := shortPlannedConfidencePct
                    signalEri := shortPlannedEri
                    signalExecutionGrade := shortPlannedExecutionGrade
                    signalConfidenceTier := shortPlannedConfidenceTier
                    signalUnifiedConfidence := shortPlannedUnifiedConfidence
                    signalGateStatus := shortPlannedGateStatus
                    shortState := 0
                    lastSignalBar := bar_index
                else
                    shortState := 3

    //-------------------------------------------------------------------------
    // LONG: READY -> FIRST RETURN -> CONTINUATION
    //-------------------------------------------------------------------------
    if longState == 3
        bool longEntryExpired = bar_index - longReadyBar > (useFirstReturnExecution ? firstReturnExpiryBars : entryExpiryBars)
        bool longPlanInvalid = close < longSweptLevel or low <= longPlannedStop

        if longEntryExpired or longPlanInvalid or sweepConflict
            longFailureEvent := true
            longFailureSource := longSource
            failureReason := longPlanInvalid ? "PLAN INVALID" : sweepConflict ? "TWO-SIDED" : "ENTRY EXPIRED"
            longState := 0
        else if bar_index > longReadyBar
            bool longEntryTouched = low <= longPlannedEntry and high >= longPlannedEntry
            bool longStopTouched = low <= longPlannedStop

            if longEntryTouched and not longStopTouched and close > longSweptLevel
                if useFirstReturnExecution
                    longFirstReturnBar := bar_index
                    longFirstReturnLow := low
                    longState := 4
                else
                    buySignal := true
                    signalEntry := longPlannedEntry
                    signalAddEntry := na
                    signalAddZoneLow := na
                    signalAddZoneHigh := na
                    signalScoutRiskPct := longScoutRiskPct
                    signalStop := longPlannedStop
                    signalTp1 := longPlannedTp1
                    signalTp2 := longPlannedTp2
                    signalGrade := longGrade
                    signalSource := longSource
                    signalExecutionType := longExecutionType
                    signalTargetModel := longTargetModel
                    signalQualityScore := longPlannedQualityScore
                    signalConfidencePct := longPlannedConfidencePct
                    signalEri := longPlannedEri
                    signalExecutionGrade := longPlannedExecutionGrade
                    signalConfidenceTier := longPlannedConfidenceTier
                    signalUnifiedConfidence := longPlannedUnifiedConfidence
                    signalGateStatus := longPlannedGateStatus
                    longState := 0
                    lastSignalBar := bar_index

    if longState == 4
        longFirstReturnLow := math.min(nz(longFirstReturnLow, low), low)
        bool longContinuationExpired = bar_index - longFirstReturnBar > continuationExpiryBars
        bool longContinuationInvalid = low <= longPlannedStop or close < longSweptLevel
        float longContinuationRange = math.max(high - low, syminfo.mintick)
        float longContinuationBodyPct = candleBody / longContinuationRange * 100.0
        float longContinuationUpperWick = high - math.max(open, close)
        float longContinuationOppWickPct = candleBody > syminfo.mintick ? longContinuationUpperWick / candleBody * 100.0 : 999.0
        float longContinuationCloseFromHighPct = (high - close) / longContinuationRange * 100.0
        float longContinuationVolumeAverage = ta.sma(volume, continuationVolumeLength)

        bool longDirectionalBody = close > open and candleBody >= chartAtr * continuationBodyAtrMin
        bool longBreakConfirmed = not continuationBreakPriorBar or close > high[1]
        bool longContinuationBodyQuality = longContinuationBodyPct >= continuationMinBodyPct
        bool longContinuationCloseQuality = longContinuationCloseFromHighPct <= continuationCloseExtremePct
        bool longContinuationWickQuality = longContinuationOppWickPct <= continuationMaxOppWickBodyPct
        bool longContinuationVolumeQuality = not continuationRequireVolumeExpansion or na(volume) or na(longContinuationVolumeAverage) or volume >= longContinuationVolumeAverage * continuationVolumeMultiplier
        bool longContinuationQualityPassed = not useContinuationQualityGate or
             (longContinuationBodyQuality and longContinuationCloseQuality and
              longContinuationWickQuality and longContinuationVolumeQuality)
        bool longContinuationConfirmed =
             bar_index > longFirstReturnBar and longDirectionalBody and
             longBreakConfirmed and close > longPlannedEntry and
             longContinuationQualityPassed

        if longContinuationExpired or longContinuationInvalid or sweepConflict
            longFailureEvent := true
            longFailureSource := longSource
            failureReason := longContinuationInvalid ? "FIRST RETURN INVALID" : sweepConflict ? "TWO-SIDED" : "CONT QUALITY EXPIRED"
            longState := 0
        else if longContinuationConfirmed
            if requirePostContinuationBreak
                longContinuationQualifiedBar := bar_index
                longContinuationTriggerHigh := high
                longState := 5
            else
                float liveLongEntry = useActualContinuationClose ? close : longPlannedEntry
                float liveLongRisk = liveLongEntry - longPlannedStop
                float liveLongR1 = liveLongRisk > syminfo.mintick ? (longPlannedTp1 - liveLongEntry) / liveLongRisk : na
                float liveLongR2 = liveLongRisk > syminfo.mintick ? (longPlannedTp2 - liveLongEntry) / liveLongRisk : na
                bool liveLongRewardValid = liveLongRisk > syminfo.mintick and liveLongR1 >= minTarget1R and liveLongR2 >= minTarget2R

                if liveLongRewardValid
                    buySignal := true
                    signalEntry := f_roundToTick(liveLongEntry)
                    signalAddEntry := na
                    signalAddZoneLow := na
                    signalAddZoneHigh := na
                    signalScoutRiskPct := longScoutRiskPct
                    signalStop := longPlannedStop
                    signalTp1 := longPlannedTp1
                    signalTp2 := longPlannedTp2
                    signalGrade := longGrade
                    signalSource := longSource
                    signalExecutionType := "FIRST RETURN CONFIRM"
                    signalTargetModel := longTargetModel
                    signalQualityScore := longPlannedQualityScore
                    signalConfidencePct := longPlannedConfidencePct
                    signalEri := longPlannedEri
                    signalExecutionGrade := longPlannedExecutionGrade
                    signalConfidenceTier := longPlannedConfidenceTier
                    signalUnifiedConfidence := longPlannedUnifiedConfidence
                    signalGateStatus := longPlannedGateStatus
                    longState := 0
                    lastSignalBar := bar_index
                else
                    longFailureEvent := true
                    longFailureSource := longSource
                    failureReason := "LIVE RR"
                    longState := 0

    //-------------------------------------------------------------------------
    // SHORT: READY -> FIRST RETURN -> CONTINUATION
    //-------------------------------------------------------------------------
    if shortState == 3
        bool shortEntryExpired = bar_index - shortReadyBar > (useFirstReturnExecution ? firstReturnExpiryBars : entryExpiryBars)
        bool shortPlanInvalid = close > shortSweptLevel or high >= shortPlannedStop

        if shortEntryExpired or shortPlanInvalid or sweepConflict
            shortFailureEvent := true
            shortFailureSource := shortSource
            failureReason := shortPlanInvalid ? "PLAN INVALID" : sweepConflict ? "TWO-SIDED" : "ENTRY EXPIRED"
            shortState := 0
        else if bar_index > shortReadyBar
            bool shortEntryTouched = low <= shortPlannedEntry and high >= shortPlannedEntry
            bool shortStopTouched = high >= shortPlannedStop

            if shortEntryTouched and not shortStopTouched and close < shortSweptLevel
                if useFirstReturnExecution
                    shortFirstReturnBar := bar_index
                    shortFirstReturnHigh := high
                    shortState := 4
                else
                    sellSignal := true
                    signalEntry := shortPlannedEntry
                    signalAddEntry := na
                    signalAddZoneLow := na
                    signalAddZoneHigh := na
                    signalScoutRiskPct := shortScoutRiskPct
                    signalStop := shortPlannedStop
                    signalTp1 := shortPlannedTp1
                    signalTp2 := shortPlannedTp2
                    signalGrade := shortGrade
                    signalSource := shortSource
                    signalExecutionType := shortExecutionType
                    signalTargetModel := shortTargetModel
                    signalQualityScore := shortPlannedQualityScore
                    signalConfidencePct := shortPlannedConfidencePct
                    signalEri := shortPlannedEri
                    signalExecutionGrade := shortPlannedExecutionGrade
                    signalConfidenceTier := shortPlannedConfidenceTier
                    signalUnifiedConfidence := shortPlannedUnifiedConfidence
                    signalGateStatus := shortPlannedGateStatus
                    shortState := 0
                    lastSignalBar := bar_index

    if shortState == 4
        shortFirstReturnHigh := math.max(nz(shortFirstReturnHigh, high), high)
        bool shortContinuationExpired = bar_index - shortFirstReturnBar > continuationExpiryBars
        bool shortContinuationInvalid = high >= shortPlannedStop or close > shortSweptLevel
        float shortContinuationRange = math.max(high - low, syminfo.mintick)
        float shortContinuationBodyPct = candleBody / shortContinuationRange * 100.0
        float shortContinuationLowerWick = math.min(open, close) - low
        float shortContinuationOppWickPct = candleBody > syminfo.mintick ? shortContinuationLowerWick / candleBody * 100.0 : 999.0
        float shortContinuationCloseFromLowPct = (close - low) / shortContinuationRange * 100.0
        float shortContinuationVolumeAverage = ta.sma(volume, continuationVolumeLength)

        bool shortDirectionalBody = close < open and candleBody >= chartAtr * continuationBodyAtrMin
        bool shortBreakConfirmed = not continuationBreakPriorBar or close < low[1]
        bool shortContinuationBodyQuality = shortContinuationBodyPct >= continuationMinBodyPct
        bool shortContinuationCloseQuality = shortContinuationCloseFromLowPct <= continuationCloseExtremePct
        bool shortContinuationWickQuality = shortContinuationOppWickPct <= continuationMaxOppWickBodyPct
        bool shortContinuationVolumeQuality = not continuationRequireVolumeExpansion or na(volume) or na(shortContinuationVolumeAverage) or volume >= shortContinuationVolumeAverage * continuationVolumeMultiplier
        bool shortContinuationQualityPassed = not useContinuationQualityGate or
             (shortContinuationBodyQuality and shortContinuationCloseQuality and
              shortContinuationWickQuality and shortContinuationVolumeQuality)
        bool shortContinuationConfirmed =
             bar_index > shortFirstReturnBar and shortDirectionalBody and
             shortBreakConfirmed and close < shortPlannedEntry and
             shortContinuationQualityPassed

        if shortContinuationExpired or shortContinuationInvalid or sweepConflict
            shortFailureEvent := true
            shortFailureSource := shortSource
            failureReason := shortContinuationInvalid ? "FIRST RETURN INVALID" : sweepConflict ? "TWO-SIDED" : "CONT QUALITY EXPIRED"
            shortState := 0
        else if shortContinuationConfirmed
            if requirePostContinuationBreak
                shortContinuationQualifiedBar := bar_index
                shortContinuationTriggerLow := low
                shortState := 5
            else
                float liveShortEntry = useActualContinuationClose ? close : shortPlannedEntry
                float liveShortRisk = shortPlannedStop - liveShortEntry
                float liveShortR1 = liveShortRisk > syminfo.mintick ? (liveShortEntry - shortPlannedTp1) / liveShortRisk : na
                float liveShortR2 = liveShortRisk > syminfo.mintick ? (liveShortEntry - shortPlannedTp2) / liveShortRisk : na
                bool liveShortRewardValid = liveShortRisk > syminfo.mintick and liveShortR1 >= minTarget1R and liveShortR2 >= minTarget2R

                if liveShortRewardValid
                    sellSignal := true
                    signalEntry := f_roundToTick(liveShortEntry)
                    signalAddEntry := na
                    signalAddZoneLow := na
                    signalAddZoneHigh := na
                    signalScoutRiskPct := shortScoutRiskPct
                    signalStop := shortPlannedStop
                    signalTp1 := shortPlannedTp1
                    signalTp2 := shortPlannedTp2
                    signalGrade := shortGrade
                    signalSource := shortSource
                    signalExecutionType := "FIRST RETURN CONFIRM"
                    signalTargetModel := shortTargetModel
                    signalQualityScore := shortPlannedQualityScore
                    signalConfidencePct := shortPlannedConfidencePct
                    signalEri := shortPlannedEri
                    signalExecutionGrade := shortPlannedExecutionGrade
                    signalConfidenceTier := shortPlannedConfidenceTier
                    signalUnifiedConfidence := shortPlannedUnifiedConfidence
                    signalGateStatus := shortPlannedGateStatus
                    shortState := 0
                    lastSignalBar := bar_index
                else
                    shortFailureEvent := true
                    shortFailureSource := shortSource
                    failureReason := "LIVE RR"
                    shortState := 0

    //-------------------------------------------------------------------------
    // POST-CONTINUATION BREAK CONFIRMATION
    //-------------------------------------------------------------------------
    if longState == 5
        bool longBreakExpired = bar_index - longContinuationQualifiedBar > postContinuationBreakExpiryBars
        bool longBreakInvalid = low <= longPlannedStop or close < longSweptLevel
        bool longBreakTriggered = bar_index > longContinuationQualifiedBar and high > longContinuationTriggerHigh + chartAtr * breakBufferAtr
        bool longBreakDirectionOk = not requireBreakBarDirectionalClose or close > open

        if longBreakExpired or longBreakInvalid or sweepConflict
            longFailureEvent := true
            longFailureSource := longSource
            failureReason := longBreakInvalid ? "BREAK INVALID" : sweepConflict ? "TWO-SIDED" : "BREAK EXPIRED"
            longState := 0
        else if longBreakTriggered and longBreakDirectionOk
            bool longAcceptedNow = not requirePostBreakAcceptance or close > longContinuationTriggerHigh + chartAtr * acceptanceCloseBufferAtr

            if longAcceptedNow
                float liveLongEntry = close
                float liveLongRisk = liveLongEntry - longPlannedStop
                float liveLongR1 = liveLongRisk > syminfo.mintick ? (longPlannedTp1 - liveLongEntry) / liveLongRisk : na
                float liveLongR2 = liveLongRisk > syminfo.mintick ? (longPlannedTp2 - liveLongEntry) / liveLongRisk : na
                bool liveLongRewardValid = liveLongRisk > syminfo.mintick and liveLongR1 >= minTarget1R and liveLongR2 >= minTarget2R

                if liveLongRewardValid
                    buySignal := true
                    signalEntry := f_roundToTick(liveLongEntry)
                    signalAddEntry := na
                    signalAddZoneLow := na
                    signalAddZoneHigh := na
                    signalScoutRiskPct := longScoutRiskPct
                    signalStop := longPlannedStop
                    signalTp1 := longPlannedTp1
                    signalTp2 := longPlannedTp2
                    signalGrade := longGrade
                    signalSource := longSource
                    signalExecutionType := "FIRST RETURN + BREAK + ACCEPT"
                    signalTargetModel := longTargetModel
                    signalQualityScore := longPlannedQualityScore
                    signalConfidencePct := longPlannedConfidencePct
                    signalEri := longPlannedEri
                    signalExecutionGrade := longPlannedExecutionGrade
                    signalConfidenceTier := longPlannedConfidenceTier
                    signalUnifiedConfidence := longPlannedUnifiedConfidence
                    signalGateStatus := longPlannedGateStatus
                    longState := 0
                    lastSignalBar := bar_index
                else
                    longFailureEvent := true
                    longFailureSource := longSource
                    failureReason := "LIVE RR"
                    longState := 0
            else if allowRetestAcceptance
                longBreakBar := bar_index
                longState := 6
            else
                longFailureEvent := true
                longFailureSource := longSource
                failureReason := "NO ACCEPT CLOSE"
                longState := 0

    if shortState == 5
        bool shortBreakExpired = bar_index - shortContinuationQualifiedBar > postContinuationBreakExpiryBars
        bool shortBreakInvalid = high >= shortPlannedStop or close > shortSweptLevel
        bool shortBreakTriggered = bar_index > shortContinuationQualifiedBar and low < shortContinuationTriggerLow - chartAtr * breakBufferAtr
        bool shortBreakDirectionOk = not requireBreakBarDirectionalClose or close < open

        if shortBreakExpired or shortBreakInvalid or sweepConflict
            shortFailureEvent := true
            shortFailureSource := shortSource
            failureReason := shortBreakInvalid ? "BREAK INVALID" : sweepConflict ? "TWO-SIDED" : "BREAK EXPIRED"
            shortState := 0
        else if shortBreakTriggered and shortBreakDirectionOk
            bool shortAcceptedNow = not requirePostBreakAcceptance or close < shortContinuationTriggerLow - chartAtr * acceptanceCloseBufferAtr

            if shortAcceptedNow
                float liveShortEntry = close
                float liveShortRisk = shortPlannedStop - liveShortEntry
                float liveShortR1 = liveShortRisk > syminfo.mintick ? (liveShortEntry - shortPlannedTp1) / liveShortRisk : na
                float liveShortR2 = liveShortRisk > syminfo.mintick ? (liveShortEntry - shortPlannedTp2) / liveShortRisk : na
                bool liveShortRewardValid = liveShortRisk > syminfo.mintick and liveShortR1 >= minTarget1R and liveShortR2 >= minTarget2R

                if liveShortRewardValid
                    sellSignal := true
                    signalEntry := f_roundToTick(liveShortEntry)
                    signalAddEntry := na
                    signalAddZoneLow := na
                    signalAddZoneHigh := na
                    signalScoutRiskPct := shortScoutRiskPct
                    signalStop := shortPlannedStop
                    signalTp1 := shortPlannedTp1
                    signalTp2 := shortPlannedTp2
                    signalGrade := shortGrade
                    signalSource := shortSource
                    signalExecutionType := "FIRST RETURN + BREAK + ACCEPT"
                    signalTargetModel := shortTargetModel
                    signalQualityScore := shortPlannedQualityScore
                    signalConfidencePct := shortPlannedConfidencePct
                    signalEri := shortPlannedEri
                    signalExecutionGrade := shortPlannedExecutionGrade
                    signalConfidenceTier := shortPlannedConfidenceTier
                    signalUnifiedConfidence := shortPlannedUnifiedConfidence
                    signalGateStatus := shortPlannedGateStatus
                    shortState := 0
                    lastSignalBar := bar_index
                else
                    shortFailureEvent := true
                    shortFailureSource := shortSource
                    failureReason := "LIVE RR"
                    shortState := 0
            else if allowRetestAcceptance
                shortBreakBar := bar_index
                shortState := 6
            else
                shortFailureEvent := true
                shortFailureSource := shortSource
                failureReason := "NO ACCEPT CLOSE"
                shortState := 0

    //-------------------------------------------------------------------------
    // OPTIONAL RETEST ACCEPTANCE
    //-------------------------------------------------------------------------
    if longState == 6
        bool longRetestExpired = bar_index - longBreakBar > retestAcceptanceExpiryBars
        bool longRetestInvalid = low <= longPlannedStop or close < longSweptLevel
        bool longRetestAccepted = bar_index > longBreakBar and low <= longContinuationTriggerHigh and close > longContinuationTriggerHigh + chartAtr * acceptanceCloseBufferAtr

        if longRetestExpired or longRetestInvalid or sweepConflict
            longFailureEvent := true
            longFailureSource := longSource
            failureReason := longRetestInvalid ? "ACCEPT INVALID" : sweepConflict ? "TWO-SIDED" : "ACCEPT EXPIRED"
            longState := 0
        else if longRetestAccepted
            float liveLongEntry = close
            float liveLongRisk = liveLongEntry - longPlannedStop
            float liveLongR1 = liveLongRisk > syminfo.mintick ? (longPlannedTp1 - liveLongEntry) / liveLongRisk : na
            float liveLongR2 = liveLongRisk > syminfo.mintick ? (longPlannedTp2 - liveLongEntry) / liveLongRisk : na
            bool liveLongRewardValid = liveLongRisk > syminfo.mintick and liveLongR1 >= minTarget1R and liveLongR2 >= minTarget2R

            if liveLongRewardValid
                buySignal := true
                signalEntry := f_roundToTick(liveLongEntry)
                signalAddEntry := na
                signalAddZoneLow := na
                signalAddZoneHigh := na
                signalScoutRiskPct := longScoutRiskPct
                signalStop := longPlannedStop
                signalTp1 := longPlannedTp1
                signalTp2 := longPlannedTp2
                signalGrade := longGrade
                signalSource := longSource
                signalExecutionType := "FIRST RETURN + BREAK + RETEST"
                signalTargetModel := longTargetModel
                signalQualityScore := longPlannedQualityScore
                signalConfidencePct := longPlannedConfidencePct
                signalEri := longPlannedEri
                signalExecutionGrade := longPlannedExecutionGrade
                signalConfidenceTier := longPlannedConfidenceTier
                signalUnifiedConfidence := longPlannedUnifiedConfidence
                signalGateStatus := longPlannedGateStatus
                longState := 0
                lastSignalBar := bar_index
            else
                longFailureEvent := true
                longFailureSource := longSource
                failureReason := "LIVE RR"
                longState := 0

    if shortState == 6
        bool shortRetestExpired = bar_index - shortBreakBar > retestAcceptanceExpiryBars
        bool shortRetestInvalid = high >= shortPlannedStop or close > shortSweptLevel
        bool shortRetestAccepted = bar_index > shortBreakBar and high >= shortContinuationTriggerLow and close < shortContinuationTriggerLow - chartAtr * acceptanceCloseBufferAtr

        if shortRetestExpired or shortRetestInvalid or sweepConflict
            shortFailureEvent := true
            shortFailureSource := shortSource
            failureReason := shortRetestInvalid ? "ACCEPT INVALID" : sweepConflict ? "TWO-SIDED" : "ACCEPT EXPIRED"
            shortState := 0
        else if shortRetestAccepted
            float liveShortEntry = close
            float liveShortRisk = shortPlannedStop - liveShortEntry
            float liveShortR1 = liveShortRisk > syminfo.mintick ? (liveShortEntry - shortPlannedTp1) / liveShortRisk : na
            float liveShortR2 = liveShortRisk > syminfo.mintick ? (liveShortEntry - shortPlannedTp2) / liveShortRisk : na
            bool liveShortRewardValid = liveShortRisk > syminfo.mintick and liveShortR1 >= minTarget1R and liveShortR2 >= minTarget2R

            if liveShortRewardValid
                sellSignal := true
                signalEntry := f_roundToTick(liveShortEntry)
                signalAddEntry := na
                signalAddZoneLow := na
                signalAddZoneHigh := na
                signalScoutRiskPct := shortScoutRiskPct
                signalStop := shortPlannedStop
                signalTp1 := shortPlannedTp1
                signalTp2 := shortPlannedTp2
                signalGrade := shortGrade
                signalSource := shortSource
                signalExecutionType := "FIRST RETURN + BREAK + RETEST"
                signalTargetModel := shortTargetModel
                signalQualityScore := shortPlannedQualityScore
                signalConfidencePct := shortPlannedConfidencePct
                signalEri := shortPlannedEri
                signalExecutionGrade := shortPlannedExecutionGrade
                signalConfidenceTier := shortPlannedConfidenceTier
                signalUnifiedConfidence := shortPlannedUnifiedConfidence
                signalGateStatus := shortPlannedGateStatus
                shortState := 0
                lastSignalBar := bar_index
            else
                shortFailureEvent := true
                shortFailureSource := shortSource
                failureReason := "LIVE RR"
                shortState := 0

    //-------------------------------------------------------------------------
    // WEIGHTED EXECUTION QUALITY, PRIORITIZATION AND DECAY
    //-------------------------------------------------------------------------
    if buySignal or sellSignal
        bool scoringLong = buySignal
        float scoringRange = math.max(high - low, syminfo.mintick)
        float scoringBodyPct = math.min(100.0, candleBody / scoringRange * 100.0)
        float scoringClosePct = scoringLong ? (close - low) / scoringRange * 100.0 : (high - close) / scoringRange * 100.0
        float continuationComponent = math.min(100.0, scoringBodyPct * 0.65 + scoringClosePct * 0.35)

        float scoringTrigger = scoringLong ? longContinuationTriggerHigh : shortContinuationTriggerLow
        float scoringBreakDistanceAtr = not na(scoringTrigger) and chartAtr > 0.0 ?
             (scoringLong ? math.max(0.0, close - scoringTrigger) : math.max(0.0, scoringTrigger - close)) / chartAtr : 0.0
        float breakDistanceScore = math.min(100.0, scoringBreakDistanceAtr / 0.25 * 100.0)
        float acceptanceComponent = math.min(100.0, breakDistanceScore * 0.55 + scoringClosePct * 0.45)

        float contextComponent = math.min(100.0, math.max(0.0, signalUnifiedConfidence))
        float liveRiskForScore = scoringLong ? signalEntry - signalStop : signalStop - signalEntry
        float liveR2ForScore = liveRiskForScore > syminfo.mintick ?
             (scoringLong ? (signalTp2 - signalEntry) / liveRiskForScore : (signalEntry - signalTp2) / liveRiskForScore) : 0.0
        float rewardComponent = math.min(100.0, math.max(0.0, liveR2ForScore / 3.0 * 100.0))

        float totalQualityWeight = math.max(continuationWeight + acceptanceWeight + contextWeight + rewardWeight, 1.0)
        float rawExecutionQuality =
             (continuationComponent * continuationWeight +
              acceptanceComponent * acceptanceWeight +
              contextComponent * contextWeight +
              rewardComponent * rewardWeight) / totalQualityWeight

        int qualityAnchorBar = scoringLong ? nz(longContinuationQualifiedBar, bar_index) : nz(shortContinuationQualifiedBar, bar_index)
        int staleBars = math.max(0, bar_index - qualityAnchorBar - 1)
        signalExecutionQuality := math.max(0.0, math.min(100.0, rawExecutionQuality - staleBars * qualityDecayPerBar))
        signalExecutionRank :=
             signalExecutionQuality >= eliteExecutionThreshold ? "A+" :
             signalExecutionQuality >= institutionalExecutionThreshold ? "A" :
             signalExecutionQuality >= minimumExecutionQuality ? "B+" :
             signalExecutionQuality >= minimumExecutionQuality - 5.0 ? "B" : "REJECT"

        bool executionQualityPassed = not useExecutionQualityGate or signalExecutionQuality >= minimumExecutionQuality
        if not executionQualityPassed
            if scoringLong
                longFailureEvent := true
                longFailureSource := signalSource
            else
                shortFailureEvent := true
                shortFailureSource := signalSource
            failureReason := "EXEC QUALITY"
            buySignal := false
            sellSignal := false
        else
            signalExecutionGrade := signalExecutionRank

//=============================================================================
// FAILURE ACCOUNTING AND LEVEL CONSUMPTION
//=============================================================================
if longFailureEvent
    totalFailedArms += 1
    totalLongFailures += 1

    if failureReason == "MSS EXPIRED"
        totalLongMssExpired += 1
    else if failureReason == "DISP EXPIRED"
        totalLongDisplacementExpired += 1
    else if failureReason == "CONFIRM EXPIRED"
        totalLongConfirmExpired += 1
    else if failureReason == "FVG REJECT"
        totalLongFvgRejected += 1
    else if failureReason == "VWAP REJECT"
        totalLongVwapRejected += 1
    else if failureReason == "VOLUME REJECT"
        totalLongVolumeRejected += 1
    else if failureReason == "RR REJECT"
        totalLongRrRejected += 1
    else if failureReason == "STOP INVALID"
        totalLongStopInvalid += 1
    else if failureReason == "TARGET INVALID"
        totalLongTargetInvalid += 1
    else if failureReason == "ENTRY EXPIRED"
        totalLongEntryExpiry += 1
    else if failureReason == "PLAN INVALID"
        totalLongPlanInvalid += 1
    else if failureReason == "RECLAIM LOST"
        totalLongReclaimLost += 1
    else if failureReason == "SESSION"
        totalLongSessionExpired += 1
    else if failureReason == "TWO-SIDED"
        totalLongTwoSided += 1
    else
        totalLongOtherFailures += 1

    if longFailureSource == "Daily"
        failedBullDaily += 1
        consumedBullDaily := failedBullDaily >= maxFailedArmsPerLevel
    else if longFailureSource == "Range TF"
        failedBullRange += 1
        consumedBullRange := failedBullRange >= maxFailedArmsPerLevel

if shortFailureEvent
    totalFailedArms += 1
    totalShortFailures += 1

    if failureReason == "MSS EXPIRED"
        totalShortMssExpired += 1
    else if failureReason == "DISP EXPIRED"
        totalShortDisplacementExpired += 1
    else if failureReason == "CONFIRM EXPIRED"
        totalShortConfirmExpired += 1
    else if failureReason == "FVG REJECT"
        totalShortFvgRejected += 1
    else if failureReason == "VWAP REJECT"
        totalShortVwapRejected += 1
    else if failureReason == "VOLUME REJECT"
        totalShortVolumeRejected += 1
    else if failureReason == "RR REJECT"
        totalShortRrRejected += 1
    else if failureReason == "STOP INVALID"
        totalShortStopInvalid += 1
    else if failureReason == "TARGET INVALID"
        totalShortTargetInvalid += 1
    else if failureReason == "ENTRY EXPIRED"
        totalShortEntryExpiry += 1
    else if failureReason == "PLAN INVALID"
        totalShortPlanInvalid += 1
    else if failureReason == "RECLAIM LOST"
        totalShortReclaimLost += 1
    else if failureReason == "SESSION"
        totalShortSessionExpired += 1
    else if failureReason == "TWO-SIDED"
        totalShortTwoSided += 1
    else
        totalShortOtherFailures += 1

    if shortFailureSource == "Daily"
        failedBearDaily += 1
        consumedBearDaily := failedBearDaily >= maxFailedArmsPerLevel
    else if shortFailureSource == "Range TF"
        failedBearRange += 1
        consumedBearRange := failedBearRange >= maxFailedArmsPerLevel

// A final initial signal consumes the exact source level immediately.
if buySignal
    totalBuySignals += 1

    if signalSource == "Daily"
        consumedBullDaily := true
    else if signalSource == "Range TF"
        consumedBullRange := true

if sellSignal
    totalSellSignals += 1

    if signalSource == "Daily"
        consumedBearDaily := true
    else if signalSource == "Range TF"
        consumedBearRange := true

//=============================================================================
// HYBRID RETRACEMENT ADD-ON MANAGEMENT
// The scout is already live. The add-on is canceled if TP1/SL occurs first.
// Same-bar add-entry and stop ambiguity is treated as no add fill.
//=============================================================================
if pendingAddActive and barstate.isconfirmed and bar_index > pendingAddCreatedBar
    bool pendingExpired = bar_index - pendingAddCreatedBar > entryExpiryBars
    bool pendingStopTouched = pendingAddDirection == 1 ? low <= pendingAddStop : high >= pendingAddStop
    bool pendingTp1Touched = pendingAddDirection == 1 ? high >= pendingAddTp1 : low <= pendingAddTp1
    bool pendingZoneTouched = high >= pendingAddZoneLow and low <= pendingAddZoneHigh
    float firstTouchZoneEntry =
         pendingAddDirection == 1 ? math.max(pendingAddZoneLow, math.min(pendingAddZoneHigh, high)) :
         math.min(pendingAddZoneHigh, math.max(pendingAddZoneLow, low))

    if pendingExpired or pendingStopTouched or pendingTp1Touched
        if pendingAddDirection == 1
            totalLongAddExpiry += 1
        else
            totalShortAddExpiry += 1
        pendingAddActive := false
    else if pendingZoneTouched
        addBuySignal := pendingAddDirection == 1
        addSellSignal := pendingAddDirection == -1
        addSignalEntry := f_roundToTick(firstTouchZoneEntry)
        addSignalStop := pendingAddStop
        addSignalTp1 := pendingAddTp1
        addSignalTp2 := pendingAddTp2
        addSignalRiskPct := pendingAddRiskPct
        addSignalGrade := pendingAddGrade
        addSignalSource := pendingAddSource

        if addBuySignal
            totalLongAddFills += 1
        else
            totalShortAddFills += 1

        pendingAddActive := false

// Create a new hybrid add-on zone after processing any previous order.
if (buySignal or sellSignal) and signalExecutionType == "HYBRID"
    pendingAddActive := true
    pendingAddDirection := buySignal ? 1 : -1
    pendingAddEntry := signalAddEntry
    pendingAddZoneLow := signalAddZoneLow
    pendingAddZoneHigh := signalAddZoneHigh
    pendingAddStop := signalStop
    pendingAddTp1 := signalTp1
    pendingAddTp2 := signalTp2
    pendingAddRiskPct := 100.0 - signalScoutRiskPct
    pendingAddCreatedBar := bar_index
    pendingAddGrade := signalGrade
    pendingAddSource := signalSource

//=============================================================================
// PAPER OUTCOME TRACKING
// Risk is normalized to the total planned 1R budget. Hybrid scouts and reduced-
// risk Grade-B entries therefore report results against the intended full-risk
// budget. Same-bar stop/target ambiguity assumes the stop occurred first.
//=============================================================================

// Apply a filled hybrid add-on to the active tracked portfolio.
if trackOutcomes and trackedTradeActive and (addBuySignal or addSellSignal) and ((trackedDirection == 1 and addBuySignal) or (trackedDirection == -1 and addSellSignal))
    trackedAddFilled := true
    trackedAddEntry := addSignalEntry
    trackedAddRisk := math.abs(addSignalEntry - addSignalStop)
    trackedAddMaxHigh := addSignalEntry
    trackedAddMinLow := addSignalEntry
    float scoutQtyWeight = trackedScoutRisk > 0.0 ? trackedScoutRiskFraction / trackedScoutRisk : 0.0
    float addQtyWeight = trackedAddRisk > 0.0 ? trackedAddRiskFraction / trackedAddRisk : 0.0
    trackedPortfolioBe := scoutQtyWeight + addQtyWeight > 0.0 ? (scoutQtyWeight * trackedScoutEntry + addQtyWeight * trackedAddEntry) / (scoutQtyWeight + addQtyWeight) : trackedScoutEntry
    trackedEntry := trackedPortfolioBe

if trackOutcomes and trackedTradeActive and barstate.isconfirmed and bar_index > trackedEntryBar
    trackedMaxHigh := math.max(trackedMaxHigh, high)
    trackedMinLow := math.min(trackedMinLow, low)

    if trackedAddFilled
        trackedAddMaxHigh := math.max(trackedAddMaxHigh, high)
        trackedAddMinLow := math.min(trackedAddMinLow, low)

    float activeAddFraction = trackedAddFilled ? trackedAddRiskFraction : 0.0
    float activeRiskFraction = trackedScoutRiskFraction + activeAddFraction
    float scoutMfeR = trackedScoutRisk > 0.0 ? (trackedDirection == 1 ? math.max(0.0, (trackedMaxHigh - trackedScoutEntry) / trackedScoutRisk) : math.max(0.0, (trackedScoutEntry - trackedMinLow) / trackedScoutRisk)) : 0.0
    float scoutMaeR = trackedScoutRisk > 0.0 ? (trackedDirection == 1 ? math.max(0.0, (trackedScoutEntry - trackedMinLow) / trackedScoutRisk) : math.max(0.0, (trackedMaxHigh - trackedScoutEntry) / trackedScoutRisk)) : 0.0
    float addMfeR = trackedAddFilled and trackedAddRisk > 0.0 ? (trackedDirection == 1 ? math.max(0.0, (trackedAddMaxHigh - trackedAddEntry) / trackedAddRisk) : math.max(0.0, (trackedAddEntry - trackedAddMinLow) / trackedAddRisk)) : 0.0
    float addMaeR = trackedAddFilled and trackedAddRisk > 0.0 ? (trackedDirection == 1 ? math.max(0.0, (trackedAddEntry - trackedAddMinLow) / trackedAddRisk) : math.max(0.0, (trackedAddMaxHigh - trackedAddEntry) / trackedAddRisk)) : 0.0
    float currentMfeR = trackedScoutRiskFraction * scoutMfeR + activeAddFraction * addMfeR
    float currentMaeR = trackedScoutRiskFraction * scoutMaeR + activeAddFraction * addMaeR
    trackedMfeR := math.max(trackedMfeR, currentMfeR)
    trackedMaeR := math.max(trackedMaeR, currentMaeR)

    float scoutR1 = trackedScoutRisk > 0.0 ? math.abs(trackedTp1 - trackedScoutEntry) / trackedScoutRisk : 0.0
    float scoutR2 = trackedScoutRisk > 0.0 ? math.abs(trackedTp2 - trackedScoutEntry) / trackedScoutRisk : 0.0
    float addR1 = trackedAddFilled and trackedAddRisk > 0.0 ? math.abs(trackedTp1 - trackedAddEntry) / trackedAddRisk : 0.0
    float addR2 = trackedAddFilled and trackedAddRisk > 0.0 ? math.abs(trackedTp2 - trackedAddEntry) / trackedAddRisk : 0.0
    float portfolioR1 = trackedScoutRiskFraction * scoutR1 + activeAddFraction * addR1
    float portfolioR2 = trackedScoutRiskFraction * scoutR2 + activeAddFraction * addR2

    float scoutCloseR = trackedScoutRisk > 0.0 ? (trackedDirection == 1 ? (close - trackedScoutEntry) / trackedScoutRisk : (trackedScoutEntry - close) / trackedScoutRisk) : 0.0
    float addCloseR = trackedAddFilled and trackedAddRisk > 0.0 ? (trackedDirection == 1 ? (close - trackedAddEntry) / trackedAddRisk : (trackedAddEntry - close) / trackedAddRisk) : 0.0
    float portfolioCloseR = trackedScoutRiskFraction * scoutCloseR + activeAddFraction * addCloseR

    float scoutStopR = trackedScoutRisk > 0.0 ? (trackedDirection == 1 ? (trackedCurrentStop - trackedScoutEntry) / trackedScoutRisk : (trackedScoutEntry - trackedCurrentStop) / trackedScoutRisk) : 0.0
    float addStopR = trackedAddFilled and trackedAddRisk > 0.0 ? (trackedDirection == 1 ? (trackedCurrentStop - trackedAddEntry) / trackedAddRisk : (trackedAddEntry - trackedCurrentStop) / trackedAddRisk) : 0.0
    float portfolioStopR = trackedScoutRiskFraction * scoutStopR + activeAddFraction * addStopR

    bool trackedStopTouched = trackedDirection == 1 ? low <= trackedCurrentStop : high >= trackedCurrentStop
    bool trackedTp1Touched = trackedDirection == 1 ? high >= trackedTp1 : low <= trackedTp1
    bool trackedTp2Touched = trackedDirection == 1 ? high >= trackedTp2 : low <= trackedTp2
    bool outcomeTimedOut = bar_index - trackedEntryBar >= maxOutcomeBars

    if not trackedTp1Hit
        if trackedStopTouched
            outcomeEvent := true
            outcomeText := "SL"
            outcomeR := -activeRiskFraction
        else if trackedTp2Touched
            trackedTp1Hit := true
            trackedTp2Hit := true
            trackedTp1HitBar := bar_index
            trackedTp2HitBar := bar_index
            trackedRealizedR := trackedTp1Allocation * portfolioR1 + trackedTp2Allocation * portfolioR2

            if trackedRunnerAllocation <= 0.0
                outcomeEvent := true
                outcomeText := "TP2"
                outcomeR := trackedRealizedR
        else if trackedTp1Touched
            trackedTp1Hit := true
            trackedTp1HitBar := bar_index
            trackedRealizedR := trackedTp1Allocation * portfolioR1
        else if outcomeTimedOut
            outcomeEvent := true
            outcomeText := "TIMEOUT"
            outcomeR := portfolioCloseR

    else if not trackedTp2Hit
        float remainingAfterTp1 = math.max(0.0, 1.0 - trackedTp1Allocation)

        if trackedStopTouched
            outcomeEvent := true
            outcomeText := postTp1StopModel == "Structure trail" ? "TP1 + TRAIL" : postTp1StopModel == "Break-even" ? "TP1 + BE" : "TP1 + SL"
            outcomeR := trackedRealizedR + remainingAfterTp1 * portfolioStopR
        else if trackedTp2Touched
            trackedTp2Hit := true
            trackedTp2HitBar := bar_index
            trackedRealizedR += trackedTp2Allocation * portfolioR2

            if trackedRunnerAllocation <= 0.0
                outcomeEvent := true
                outcomeText := "TP2"
                outcomeR := trackedRealizedR
        else if outcomeTimedOut
            outcomeEvent := true
            outcomeText := "TP1 + TIMEOUT"
            outcomeR := trackedRealizedR + remainingAfterTp1 * portfolioCloseR

    else
        if trackedStopTouched
            outcomeEvent := true
            outcomeText := "RUNNER STOP"
            outcomeR := trackedRealizedR + trackedRunnerAllocation * portfolioStopR
        else if outcomeTimedOut
            outcomeEvent := true
            outcomeText := "RUNNER TIMEOUT"
            outcomeR := trackedRealizedR + trackedRunnerAllocation * portfolioCloseR

    // Ratchet after current-bar stop/target checks. The assignment therefore
    // applies from the next bar and never receives retroactive intrabar effect.
    if not outcomeEvent and trackedTp1Hit and not na(trackedTp1HitBar) and bar_index >= trackedTp1HitBar
        float portfolioRiskPrice = math.max(math.abs(trackedPortfolioBe - trackedInitialStop), syminfo.mintick)

        if trackedDirection == 1
            float protectedFloor = trackedPortfolioBe - portfolioRiskPrice * postTp1RiskAllowanceR
            float structureCandidate = not na(lastConfirmedPivotLow) and lastConfirmedPivotLow < close ? lastConfirmedPivotLow - chartAtr * structureTrailAtrBuffer : protectedFloor
            float requestedStop =
                 postTp1StopModel == "Break-even" ? trackedPortfolioBe :
                 postTp1StopModel == "Initial stop" ? trackedInitialStop :
                 math.max(protectedFloor, structureCandidate)
            requestedStop := math.min(requestedStop, close - syminfo.mintick)
            trackedCurrentStop := math.max(trackedCurrentStop, requestedStop)

        if trackedDirection == -1
            float protectedCeiling = trackedPortfolioBe + portfolioRiskPrice * postTp1RiskAllowanceR
            float structureCandidate = not na(lastConfirmedPivotHigh) and lastConfirmedPivotHigh > close ? lastConfirmedPivotHigh + chartAtr * structureTrailAtrBuffer : protectedCeiling
            float requestedStop =
                 postTp1StopModel == "Break-even" ? trackedPortfolioBe :
                 postTp1StopModel == "Initial stop" ? trackedInitialStop :
                 math.min(protectedCeiling, structureCandidate)
            requestedStop := math.max(requestedStop, close + syminfo.mintick)
            trackedCurrentStop := math.min(trackedCurrentStop, requestedStop)

if outcomeEvent
    closedOutcomeTrades += 1
    netOutcomeR += outcomeR
    sumOutcomeMfeR += trackedMfeR
    sumOutcomeMaeR += trackedMaeR

    if trackedEri >= 90.0
        eriInstitutionalTrades += 1
        eriInstitutionalNetR += outcomeR
    else if trackedEri >= 80.0
        eriGradeATrades += 1
        eriGradeANetR += outcomeR
    else
        eriGradeBTrades += 1
        eriGradeBNetR += outcomeR

    if outcomeR > 0.0
        positiveOutcomeTrades += 1
        grossProfitR += outcomeR
    else if outcomeR < 0.0
        grossLossR += outcomeR

    if trackedTp2Hit
        tp2OutcomeTrades += 1
    if str.contains(outcomeText, "RUNNER")
        runnerOutcomeTrades += 1
    if trackedTp1Hit
        tp1ProtectedTrades += 1
    if outcomeText == "SL"
        stopOutcomeTrades += 1
    if str.contains(outcomeText, "TIMEOUT")
        timeoutOutcomeTrades += 1

    if showOutcomeLabels
        float outcomeLabelY = trackedDirection == 1 ? high : low
        label.new(
             bar_index,
             outcomeLabelY,
             outcomeText + " | " + str.tostring(outcomeR, "#.##") + "R" +
             "\nMFE " + str.tostring(trackedMfeR, "#.##") + "R" +
             " | MAE " + str.tostring(trackedMaeR, "#.##") + "R",
             style=trackedDirection == 1 ? label.style_label_down : label.style_label_up,
             color=outcomeR >= 0.0 ? color.new(color.green, 15) : color.new(color.red, 15),
             textcolor=color.white,
             size=size.tiny)

    trackedTradeActive := false
    trackedDirection := 0
    pendingAddActive := false

// Initialize a new tracked trade only after any prior trade has been processed.
if trackOutcomes and (buySignal or sellSignal)
    trackedTradeActive := true
    trackedDirection := buySignal ? 1 : -1
    trackedScoutEntry := signalEntry
    trackedScoutRisk := math.abs(signalEntry - signalStop)
    trackedScoutRiskFraction := signalScoutRiskPct * 0.01
    trackedAddEntry := signalAddEntry
    trackedAddRisk := not na(signalAddEntry) ? math.abs(signalAddEntry - signalStop) : na
    trackedAddRiskFraction := signalExecutionType == "HYBRID" ? 1.0 - trackedScoutRiskFraction : 0.0
    trackedAddFilled := false
    trackedAddMaxHigh := na
    trackedAddMinLow := na
    trackedPortfolioBe := signalEntry
    trackedEntry := signalEntry
    trackedInitialStop := signalStop
    trackedCurrentStop := signalStop
    trackedTp1 := signalTp1
    trackedTp2 := signalTp2
    trackedRisk := trackedScoutRisk
    trackedTp1Hit := false
    trackedTp2Hit := false
    trackedTp1HitBar := na
    trackedTp2HitBar := na
    trackedRealizedR := 0.0

    bool gradeAOutcome = signalGrade == "A"
    trackedTp1Allocation := (gradeAOutcome ? gradeATp1AllocationPct : gradeBTp1AllocationPct) * 0.01
    trackedTp2Allocation := (gradeAOutcome ? gradeATp2AllocationPct : gradeBTp2AllocationPct) * 0.01
    trackedRunnerAllocation := math.max(0.0, 1.0 - trackedTp1Allocation - trackedTp2Allocation)

    trackedEntryBar := bar_index
    trackedMaxHigh := signalEntry
    trackedMinLow := signalEntry
    trackedMfeR := 0.0
    trackedMaeR := 0.0
    trackedGrade := signalGrade
    trackedSource := signalSource
    trackedExecutionType := signalExecutionType
    trackedTargetModel := signalTargetModel
    trackedEri := signalEri

//=============================================================================
// NEW ARMING EVENTS
// Performed after active-state processing so a failed setup cannot immediately
// re-arm on the same candle.
//=============================================================================
bool engineIdle = longState == 0 and shortState == 0
bool noFailureThisBar = not longFailureEvent and not shortFailureEvent

if barstate.isconfirmed and engineIdle and noFailureThisBar and cooldownOk and activeTradeLockOk and not sweepConflict and not buySignal and not sellSignal and not addBuySignal and not addSellSignal
    if longDirectionEnabled and bullBiasEligible and effectiveBullSource != ""
        float validPivotHigh = not na(lastConfirmedPivotHigh) and lastConfirmedPivotHigh > close ? lastConfirmedPivotHigh : na
        float internalHigh =
             structureModel == "Sweep candle" ? high :
             structureModel == "Nearest confirmed pivot" ? (na(validPivotHigh) ? high : validPivotHigh) :
             na(validPivotHigh) ? high : math.min(high, validPivotHigh)

        longState := 1
        longSweptLevel := effectiveBullLevel
        longSweepExtreme := low
        longInternalBreak := internalHigh
        longExternalBreak := math.max(internalHigh, preSweepExternalHigh)
        longExternalConfirmed := false
        longSource := effectiveBullSource
        longBiasGradeAtArm := bullBiasGrade
        longArmBar := bar_index
        longMssBar := na
        longPlanBlocker := ""
        longExecutionType := ""
        longFirstReturnBar := na
        longFirstReturnLow := na
        longContinuationQualifiedBar := na
        longContinuationTriggerHigh := na
        longBreakBar := na
        longTargetModel := ""
        longPlannedAddZoneLow := na
        longPlannedAddZoneHigh := na
        longDisplacementBar := na
        longDispOpen := na
        longDispBodyMid := na
        longDispVacuumPassed := false
        longDisplacementScore := na
        longProtectedMssLevel := na
        longProtectedMssPassed := false
        longGoldRangeBreakPassed := false
        longCompressionQualified := false
        longCompressionHigh := na
        longCompressionLow := na
        longCompressionScore := na
        longLocationScore := na
        longDispHigh := na
        longDispLow := na
        longDispClose := na
        longDispFvg := false
        longDispFvgAnchor := na
        longVwapAlignedAtConfirm := false
        longVwapDowngraded := false
        longDisplacementRecorded := false
        longFvgPassed := false
        longVwapPassed := false
        longVolumePassed := false
        longConfirmationRecorded := false
        longRrRejected := false
        longArmEvent := true
        totalLongArms += 1

        if effectiveBullSource == "Daily"
            lastBullDailyArmSession := sweepSessionSerial
            lastBullDailyArmExtreme := low
            bullDailyRearmReady := false
        else
            lastBullRangeArmSession := sweepSessionSerial
            lastBullRangeArmExtreme := low
            bullRangeRearmReady := false

    else if shortDirectionEnabled and bearBiasEligible and effectiveBearSource != ""
        float validPivotLow = not na(lastConfirmedPivotLow) and lastConfirmedPivotLow < close ? lastConfirmedPivotLow : na
        float internalLow =
             structureModel == "Sweep candle" ? low :
             structureModel == "Nearest confirmed pivot" ? (na(validPivotLow) ? low : validPivotLow) :
             na(validPivotLow) ? low : math.max(low, validPivotLow)

        shortState := 1
        shortSweptLevel := effectiveBearLevel
        shortSweepExtreme := high
        shortInternalBreak := internalLow
        shortExternalBreak := math.min(internalLow, preSweepExternalLow)
        shortExternalConfirmed := false
        shortSource := effectiveBearSource
        shortBiasGradeAtArm := bearBiasGrade
        shortArmBar := bar_index
        shortMssBar := na
        shortPlanBlocker := ""
        shortExecutionType := ""
        shortFirstReturnBar := na
        shortFirstReturnHigh := na
        shortContinuationQualifiedBar := na
        shortContinuationTriggerLow := na
        shortBreakBar := na
        shortTargetModel := ""
        shortPlannedAddZoneLow := na
        shortPlannedAddZoneHigh := na
        shortDisplacementBar := na
        shortDispOpen := na
        shortDispBodyMid := na
        shortDispVacuumPassed := false
        shortDisplacementScore := na
        shortProtectedMssLevel := na
        shortProtectedMssPassed := false
        shortGoldRangeBreakPassed := false
        shortCompressionQualified := false
        shortCompressionHigh := na
        shortCompressionLow := na
        shortCompressionScore := na
        shortLocationScore := na
        shortDispHigh := na
        shortDispLow := na
        shortDispClose := na
        shortDispFvg := false
        shortDispFvgAnchor := na
        shortVwapAlignedAtConfirm := false
        shortVwapDowngraded := false
        shortDisplacementRecorded := false
        shortFvgPassed := false
        shortVwapPassed := false
        shortVolumePassed := false
        shortConfirmationRecorded := false
        shortRrRejected := false
        shortArmEvent := true
        totalShortArms += 1

        if effectiveBearSource == "Daily"
            lastBearDailyArmSession := sweepSessionSerial
            lastBearDailyArmExtreme := high
            bearDailyRearmReady := false
        else
            lastBearRangeArmSession := sweepSessionSerial
            lastBearRangeArmExtreme := high
            bearRangeRearmReady := false

//=============================================================================
// DIAGNOSTIC WATERFALL
//=============================================================================
string diagnosticText = "WAIT SWEEP"

if pendingAddActive
    diagnosticText := "WAIT HYBRID ADD"
else if blockNewSignalsWhileTracking and trackedTradeActive
    diagnosticText := "TRACKING TRADE"
else if not cooldownOk
    diagnosticText := "COOLDOWN"
else if longState == 1 or shortState == 1
    diagnosticText := "WAIT MSS"
else if longState == 2
    diagnosticText :=
         not longDisplacementRecorded ? "DISPLACEMENT" :
         not longFvgPassed ? "FVG" :
         not longVolumePassed ? "VOLUME" :
         (vwapMode == "Strict" or vwapMode == "Delayed confirmation") and not longVwapPassed ? "VWAP" :
         longPlanBlocker != "" ? longPlanBlocker : "CONFIRM"
else if shortState == 2
    diagnosticText :=
         not shortDisplacementRecorded ? "DISPLACEMENT" :
         not shortFvgPassed ? "FVG" :
         not shortVolumePassed ? "VOLUME" :
         (vwapMode == "Strict" or vwapMode == "Delayed confirmation") and not shortVwapPassed ? "VWAP" :
         shortPlanBlocker != "" ? shortPlanBlocker : "CONFIRM"
else if longState == 3 or shortState == 3
    diagnosticText := "WAIT RETRACE"
else if effectiveSessionFilter and not rawInSession
    diagnosticText := "WAIT SESSION"
else if not bullBiasEligible and not bearBiasEligible
    diagnosticText := "BIAS"
else if sweepConflict
    diagnosticText := "TWO-SIDED"
else if (bullDailySweep and not bullDailyDedupeOk) or (bullRangeSweep and not bullRangeDedupeOk) or (bearDailySweep and not bearDailyDedupeOk) or (bearRangeSweep and not bearRangeDedupeOk)
    diagnosticText := "DEDUPED"
else if (consumedBullDaily or not dailyLevelEnabled) and (consumedBullRange or not rangeLevelEnabled) and (consumedBearDaily or not dailyLevelEnabled) and (consumedBearRange or not rangeLevelEnabled)
    diagnosticText := "LEVELS USED"

//=============================================================================
// VISUALS
//=============================================================================
plot(showDailyLevels ? dHigh : na, "Macro CRT High", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_stepline)
plot(showDailyLevels ? dMid : na, "Macro CRT Midpoint", color=color.new(color.yellow, 55), linewidth=1, style=plot.style_stepline)
plot(showDailyLevels ? dLow : na, "Macro CRT Low", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_stepline)

plot(showRangeLevels ? rHigh : na, "Range-TF CRT High", color=color.new(color.orange, 0), linewidth=1, style=plot.style_stepline)
plot(showRangeLevels ? rMid : na, "Range-TF CRT Midpoint", color=color.new(color.orange, 55), linewidth=1, style=plot.style_stepline)
plot(showRangeLevels ? rLow : na, "Range-TF CRT Low", color=color.new(color.orange, 0), linewidth=1, style=plot.style_stepline)

plot(showVwap ? vwapValue : na, "Session VWAP", color=color.new(color.aqua, 15), linewidth=1)
plot(trackOutcomes and trackedTradeActive ? trackedCurrentStop : na, "Tracked Active Stop", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(trackOutcomes and trackedTradeActive ? trackedTp1 : na, "Tracked Active TP1", color=color.new(color.teal, 35), linewidth=1, style=plot.style_linebr)
plot(trackOutcomes and trackedTradeActive ? trackedTp2 : na, "Tracked Active TP2", color=color.new(color.teal, 0), linewidth=2, style=plot.style_linebr)
plot(pendingAddActive ? pendingAddZoneLow : na, "Hybrid Add Zone Low", color=color.new(color.blue, 45), linewidth=1, style=plot.style_linebr)
plot(pendingAddActive ? pendingAddZoneHigh : na, "Hybrid Add Zone High", color=color.new(color.blue, 15), linewidth=1, style=plot.style_linebr)
plot(pendingAddActive ? pendingAddEntry : na, "Hybrid Add First-Touch Entry", color=color.new(color.blue, 0), linewidth=2, style=plot.style_linebr)

plot(longState == 1 or longState == 2 ? longSweptLevel : na, "Active Bull Sweep Level", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)
plot(shortState == 1 or shortState == 2 ? shortSweptLevel : na, "Active Bear Sweep Level", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

plot(longState == 1 ? longInternalBreak : na, "Long Internal MSS Level", color=color.new(color.lime, 50), linewidth=1, style=plot.style_linebr)
plot(shortState == 1 ? shortInternalBreak : na, "Short Internal MSS Level", color=color.new(color.red, 50), linewidth=1, style=plot.style_linebr)

plot(longState == 3 ? longPlannedEntry : na, "Long Entry Plan", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)
plot(longState == 3 ? longPlannedStop : na, "Long Stop Plan", color=color.new(color.red, 15), linewidth=1, style=plot.style_linebr)
plot(longState == 3 ? longPlannedTp1 : na, "Long TP1 Plan", color=color.new(color.teal, 10), linewidth=1, style=plot.style_linebr)
plot(longState == 3 ? longPlannedTp2 : na, "Long TP2 Plan", color=color.new(color.teal, 0), linewidth=2, style=plot.style_linebr)

plot(shortState == 3 ? shortPlannedEntry : na, "Short Entry Plan", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(shortState == 3 ? shortPlannedStop : na, "Short Stop Plan", color=color.new(color.red, 15), linewidth=1, style=plot.style_linebr)
plot(shortState == 3 ? shortPlannedTp1 : na, "Short TP1 Plan", color=color.new(color.teal, 10), linewidth=1, style=plot.style_linebr)
plot(shortState == 3 ? shortPlannedTp2 : na, "Short TP2 Plan", color=color.new(color.teal, 0), linewidth=2, style=plot.style_linebr)

plotshape(buySignal, title="Institutional BUY", text="BUY", style=shape.labelup, location=location.belowbar,
     color=color.new(color.lime, 0), textcolor=color.black, size=size.small)
plotshape(sellSignal, title="Institutional SELL", text="SELL", style=shape.labeldown, location=location.abovebar,
     color=color.new(color.red, 0), textcolor=color.white, size=size.small)
plotshape(addBuySignal, title="Hybrid BUY Add", text="ADD", style=shape.labelup, location=location.belowbar,
     color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
plotshape(addSellSignal, title="Hybrid SELL Add", text="ADD", style=shape.labeldown, location=location.abovebar,
     color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)

if showAddOnLabels and addBuySignal
    label.new(bar_index, low, "LONG ADD " + str.tostring(addSignalRiskPct, "#") + "%\n" + f_price(addSignalEntry), style=label.style_label_up, color=color.new(color.blue, 10), textcolor=color.white, size=size.tiny)

if showAddOnLabels and addSellSignal
    label.new(bar_index, high, "SHORT ADD " + str.tostring(addSignalRiskPct, "#") + "%\n" + f_price(addSignalEntry), style=label.style_label_down, color=color.new(color.blue, 10), textcolor=color.white, size=size.tiny)

if deploymentMode == "Research" and showArmLabels and longArmEvent
    label.new(
         bar_index,
         low,
         "BULL CRT ARMED [" + longBiasGradeAtArm + "]\n" + longSource + " sell-side sweep",
         style=label.style_label_up,
         color=color.new(color.lime, 72),
         textcolor=color.lime,
         size=size.tiny)

if deploymentMode == "Research" and showArmLabels and shortArmEvent
    label.new(
         bar_index,
         high,
         "BEAR CRT ARMED [" + shortBiasGradeAtArm + "]\n" + shortSource + " buy-side sweep",
         style=label.style_label_down,
         color=color.new(color.red, 72),
         textcolor=color.red,
         size=size.tiny)

if deploymentMode == "Research" and showMssLabels and longMssEvent
    label.new(bar_index, low, "BULL MSS", style=label.style_label_up, color=color.new(color.green, 55), textcolor=color.white, size=size.tiny)

if deploymentMode == "Research" and showMssLabels and shortMssEvent
    label.new(bar_index, high, "BEAR MSS", style=label.style_label_down, color=color.new(color.maroon, 55), textcolor=color.white, size=size.tiny)

if deploymentMode == "Research" and showReadyLabels and longReadyEvent and not buySignal
    label.new(
         bar_index,
         low,
         "LONG READY [" + longGrade + "] " + longExecutionType + " " + longTargetModel + "\nEntry " + f_price(longPlannedEntry) +
         "\nRisk " + str.tostring(longScoutRiskPct, "#") + "% | SL " + f_price(longPlannedStop) +
         "\nTP1 " + f_price(longPlannedTp1) +
         "\nTP2 " + f_price(longPlannedTp2),
         style=label.style_label_up,
         color=color.new(color.green, 10),
         textcolor=color.white,
         size=size.small)

if deploymentMode == "Research" and showReadyLabels and shortReadyEvent and not sellSignal
    label.new(
         bar_index,
         high,
         "SHORT READY [" + shortGrade + "] " + shortExecutionType + " " + shortTargetModel + "\nEntry " + f_price(shortPlannedEntry) +
         "\nRisk " + str.tostring(shortScoutRiskPct, "#") + "% | SL " + f_price(shortPlannedStop) +
         "\nTP1 " + f_price(shortPlannedTp1) +
         "\nTP2 " + f_price(shortPlannedTp2),
         style=label.style_label_down,
         color=color.new(color.maroon, 10),
         textcolor=color.white,
         size=size.small)

// Freeze latest final signal projection.
var line entryLine = na
var line addLine = na
var line stopLine = na
var line tp1Line = na
var line tp2Line = na

if buySignal or sellSignal
    line.delete(entryLine)
    line.delete(addLine)
    addLine := na
    line.delete(stopLine)
    line.delete(tp1Line)
    line.delete(tp2Line)

    entryLine := line.new(bar_index, signalEntry, bar_index + projectionBars, signalEntry, color=color.new(color.blue, 0), width=2)
    if signalExecutionType == "HYBRID"
        addLine := line.new(bar_index, signalAddEntry, bar_index + projectionBars, signalAddEntry, color=color.new(color.blue, 35), width=1, style=line.style_dashed)
    stopLine := line.new(bar_index, signalStop, bar_index + projectionBars, signalStop, color=color.new(color.red, 0), width=2, style=line.style_dashed)
    tp1Line := line.new(bar_index, signalTp1, bar_index + projectionBars, signalTp1, color=color.new(color.teal, 20), width=1, style=line.style_dashed)
    tp2Line := line.new(bar_index, signalTp2, bar_index + projectionBars, signalTp2, color=color.new(color.teal, 0), width=2)

    string sideText = buySignal ? "BUY" : "SELL"
    float labelY = buySignal ? low : high
    string hybridPlanText = signalExecutionType == "HYBRID" ? "\nScout " + str.tostring(signalScoutRiskPct, "#") + "% @ " + f_price(signalEntry) + "\nAdd zone " + f_price(signalAddZoneLow) + " - " + f_price(signalAddZoneHigh) : "\nEntry " + f_price(signalEntry) + " | Risk " + str.tostring(signalScoutRiskPct, "#") + "%"

    label.new(
         bar_index,
         labelY,
         sideText + " [" + signalGrade + "] Q" + str.tostring(signalQualityScore) + " C" + str.tostring(signalUnifiedConfidence, "#") + "% ERI" + str.tostring(signalEri, "#") + " " + signalExecutionGrade + " " + signalSource + " " + signalExecutionType + " " + signalTargetModel +
         hybridPlanText +
         "\nSL " + f_price(signalStop) +
         "\nTP1 " + f_price(signalTp1) +
         "\nTP2 " + f_price(signalTp2),
         style=buySignal ? label.style_label_up : label.style_label_down,
         color=buySignal ? color.new(color.lime, 0) : color.new(color.red, 0),
         textcolor=buySignal ? color.black : color.white,
         size=size.small)

//=============================================================================
// DASHBOARDS
//=============================================================================
string biasText =
     bullBiasEligible and not bearBiasEligible ? "BULL " + bullBiasGrade :
     bearBiasEligible and not bullBiasEligible ? "BEAR " + bearBiasGrade :
     bullBiasEligible and bearBiasEligible ? "UNFILTERED" : "NEUTRAL"

color biasColor =
     bullBiasEligible and not bearBiasEligible ? color.green :
     bearBiasEligible and not bullBiasEligible ? color.red : color.orange

string setupState =
     longState == 1 ? "LONG ARMED" :
     longState == 2 ? "LONG MSS" :
     longState == 3 ? "LONG READY" :
     shortState == 1 ? "SHORT ARMED" :
     shortState == 2 ? "SHORT MSS" :
     shortState == 3 ? "SHORT READY" : "IDLE"

string sourceText = longState > 0 ? longSource : shortState > 0 ? shortSource : "-"
string retryCountText = "D " + str.tostring(failedBullDaily + failedBearDaily) + " | R " + str.tostring(failedBullRange + failedBearRange)
string historicalFailText = "L " + str.tostring(totalLongFailures) + " | S " + str.tostring(totalShortFailures)
string trackedTradeText = trackedTradeActive ? (trackedDirection == 1 ? "LONG " : "SHORT ") + trackedExecutionType + (trackedTp2Hit ? " RUNNER" : trackedTp1Hit ? " TP1" : " OPEN") : pendingAddActive ? (pendingAddDirection == 1 ? "LONG ADD ZONE" : "SHORT ADD ZONE") : "NONE"

float outcomeWinRate = closedOutcomeTrades > 0 ? positiveOutcomeTrades * 100.0 / closedOutcomeTrades : na
float outcomeProfitFactor = grossLossR < 0.0 ? grossProfitR / math.abs(grossLossR) : na
float averageOutcomeMfe = closedOutcomeTrades > 0 ? sumOutcomeMfeR / closedOutcomeTrades : na
float averageOutcomeMae = closedOutcomeTrades > 0 ? sumOutcomeMaeR / closedOutcomeTrades : na

string winRateText = na(outcomeWinRate) ? "-" : str.tostring(outcomeWinRate, "#.0") + "%"
string profitFactorText = na(outcomeProfitFactor) ? "-" : str.tostring(outcomeProfitFactor, "#.##")
string averageExcursionText = na(averageOutcomeMfe) ? "-" : str.tostring(averageOutcomeMfe, "#.##") + " / " + str.tostring(averageOutcomeMae, "#.##")
string validationStatusText = closedOutcomeTrades >= minimumValidationTrades ? "SAMPLE OK" : "RESEARCH " + str.tostring(closedOutcomeTrades) + "/" + str.tostring(minimumValidationTrades)

var table hud = table.new(position.top_right, 2, 14, border_width=1, border_color=color.new(color.gray, 40))
var table funnelHud = table.new(position.bottom_right, 3, 28, border_width=1, border_color=color.new(color.gray, 40))
var table performanceHud = table.new(position.bottom_left, 2, 16, border_width=1, border_color=color.new(color.gray, 40))

//=============================================================================
// DASHBOARD RENDER FUNCTIONS
// Wrapped to keep the Pine main body below TradingView's CE10295 limit.
//=============================================================================
f_renderMainHud(table hud) =>
    if barstate.islast and showDashboard
        table.cell(hud, 0, 0, "PSRC CRT ENGINE", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 0, "v3.3.4 RC", bgcolor=color.rgb(30, 34, 45), text_color=color.white)

        table.cell(hud, 0, 1, "Chart", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 1, timeframe.period + (validExecutionTf ? " OK" : " INVALID"), bgcolor=validExecutionTf ? color.new(color.green, 20) : color.new(color.red, 10), text_color=color.white)

        table.cell(hud, 0, 2, "Session profile", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 2, activeSessionProfile, bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(hud, 0, 3, "Sweep session", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 3, not effectiveSessionFilter ? "OFF" : rawInSession ? "OPEN" : "LOCKED", bgcolor=not effectiveSessionFilter ? color.new(color.gray, 20) : rawInSession ? color.new(color.green, 20) : color.new(color.red, 10), text_color=color.white)

        table.cell(hud, 0, 4, "HTF Bias", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 4, biasText, bgcolor=color.new(biasColor, 15), text_color=color.white)

        table.cell(hud, 0, 5, "State", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 5, setupState, bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(hud, 0, 6, "Source", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 6, sourceText, bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(hud, 0, 7, "Blocker", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 7, diagnosticText, bgcolor=diagnosticText == "WAIT RETRACE" ? color.new(color.green, 20) : color.rgb(60, 65, 75), text_color=color.white)

        table.cell(hud, 0, 8, "Tracking", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 8, trackedTradeText, bgcolor=trackedTradeActive or pendingAddActive ? color.new(color.blue, 25) : color.rgb(60, 65, 75), text_color=color.white)

        table.cell(hud, 0, 9, "Arms / Ready", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 9, str.tostring(totalLongArms + totalShortArms) + " / " + str.tostring(totalLongReady + totalShortReady), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(hud, 0, 10, "Buy / Sell / Add", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 10, str.tostring(totalBuySignals) + " / " + str.tostring(totalSellSignals) + " / " + str.tostring(totalLongAddFills + totalShortAddFills), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(hud, 0, 11, "Fails / retries", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 11, historicalFailText + " | " + retryCountText, bgcolor=totalFailedArms > 0 ? color.new(color.orange, 30) : color.rgb(60, 65, 75), text_color=color.white)

        table.cell(hud, 0, 12, "Grace / dedupe", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 12, str.tostring(effectiveDisplacementGrace) + "+" + str.tostring(effectiveVwapGrace) + " | " + (dedupeMode == "Persistent institutional" ? "PERSIST" : "SESSION"), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(hud, 0, 13, "Mode / gate", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(hud, 1, 13, deploymentMode + " | " + (useExecutionQualityGate ? "WEIGHTED-Q" : requirePostBreakAcceptance ? "RETURN+CQ+BREAK+ACCEPT" : requirePostContinuationBreak ? "RETURN+CQ+BREAK" : useFirstReturnExecution ? "RETURN+CQ" : useHierarchicalExecutionGate ? "HIER+MSS" : "SCORED") + " | Q>=" + str.tostring(minimumExecutionQuality, "#"), bgcolor=color.rgb(60, 65, 75), text_color=color.white)



f_conversionText(int passed, int source) =>
    string pct = source > 0 ? str.tostring(100.0 * passed / source, "#.0") + "%" : "-"
    str.tostring(passed) + " | " + pct

f_renderFunnelHud(table funnelHud) =>
    if barstate.islast and showDashboard
        table.cell(funnelHud, 0, 0, "FUNNEL / BLOCKERS", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 0, "LONG", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 2, 0, "SHORT", bgcolor=color.rgb(30, 34, 45), text_color=color.white)

        table.cell(funnelHud, 0, 1, "ARM", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 1, str.tostring(totalLongArms), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 1, str.tostring(totalShortArms), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 2, "MSS", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 2, f_conversionText(totalLongMss, totalLongArms), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 2, f_conversionText(totalShortMss, totalShortArms), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 3, "DISP", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 3, f_conversionText(totalLongDisplacement, totalLongMss), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 3, f_conversionText(totalShortDisplacement, totalShortMss), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 4, "CONF", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 4, f_conversionText(totalLongConfirmation, totalLongDisplacement), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 4, f_conversionText(totalShortConfirmation, totalShortDisplacement), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 5, "RR/READY", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 5, f_conversionText(totalLongReady, totalLongConfirmation), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 5, f_conversionText(totalShortReady, totalShortConfirmation), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 6, "ENTRY", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 6, f_conversionText(totalBuySignals, totalLongReady), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 6, f_conversionText(totalSellSignals, totalShortReady), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 7, "ADD FILL", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 7, str.tostring(totalLongAddFills), bgcolor=color.new(color.blue, 35), text_color=color.white)
        table.cell(funnelHud, 2, 7, str.tostring(totalShortAddFills), bgcolor=color.new(color.blue, 35), text_color=color.white)

        table.cell(funnelHud, 0, 8, "FAIL", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 8, str.tostring(totalLongFailures), bgcolor=color.new(color.orange, 30), text_color=color.white)
        table.cell(funnelHud, 2, 8, str.tostring(totalShortFailures), bgcolor=color.new(color.orange, 30), text_color=color.white)

        table.cell(funnelHud, 0, 9, "MSS EXP", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 9, str.tostring(totalLongMssExpired), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 9, str.tostring(totalShortMssExpired), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 10, "DISP EXP", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 10, str.tostring(totalLongDisplacementExpired), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 10, str.tostring(totalShortDisplacementExpired), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 11, "CONF EXP", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 11, str.tostring(totalLongConfirmExpired), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 11, str.tostring(totalShortConfirmExpired), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 12, "RECLAIM", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 12, str.tostring(totalLongReclaimLost), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 12, str.tostring(totalShortReclaimLost), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 13, "SESSION", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 13, str.tostring(totalLongSessionExpired), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 13, str.tostring(totalShortSessionExpired), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 14, "TWO-SIDED", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 14, str.tostring(totalLongTwoSided), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 14, str.tostring(totalShortTwoSided), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 15, "FVG", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 15, str.tostring(totalLongFvgRejected), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 15, str.tostring(totalShortFvgRejected), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 16, "VWAP REJ", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 16, str.tostring(totalLongVwapRejected), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 16, str.tostring(totalShortVwapRejected), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 17, "VWAP DOWN", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 17, str.tostring(totalLongVwapDowngrade), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 17, str.tostring(totalShortVwapDowngrade), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 18, "VOLUME", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 18, str.tostring(totalLongVolumeRejected), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 18, str.tostring(totalShortVolumeRejected), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 19, "RR", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 19, str.tostring(totalLongRrRejected), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 19, str.tostring(totalShortRrRejected), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 20, "STOP INV", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 20, str.tostring(totalLongStopInvalid), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 20, str.tostring(totalShortStopInvalid), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 21, "TARGET INV", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 21, str.tostring(totalLongTargetInvalid), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 21, str.tostring(totalShortTargetInvalid), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 22, "FIXED-R", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 22, str.tostring(totalLongFixedRFallback), bgcolor=color.new(color.teal, 35), text_color=color.white)
        table.cell(funnelHud, 2, 22, str.tostring(totalShortFixedRFallback), bgcolor=color.new(color.teal, 35), text_color=color.white)

        table.cell(funnelHud, 0, 23, "ENTRY EXP", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 23, str.tostring(totalLongEntryExpiry), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 23, str.tostring(totalShortEntryExpiry), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 24, "PLAN INV", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 24, str.tostring(totalLongPlanInvalid), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 24, str.tostring(totalShortPlanInvalid), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 25, "ADD UNFILLED", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 25, str.tostring(totalLongAddExpiry), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 25, str.tostring(totalShortAddExpiry), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 26, "OTHER FAIL", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 26, str.tostring(totalLongOtherFailures), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 26, str.tostring(totalShortOtherFailures), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(funnelHud, 0, 27, "TOTAL FILTER", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(funnelHud, 1, 27, str.tostring(totalLongFailures - totalLongEntryExpiry - totalLongPlanInvalid), bgcolor=color.rgb(60, 65, 75), text_color=color.white)
        table.cell(funnelHud, 2, 27, str.tostring(totalShortFailures - totalShortEntryExpiry - totalShortPlanInvalid), bgcolor=color.rgb(60, 65, 75), text_color=color.white)


f_renderPerformanceHud(table performanceHud) =>
    if barstate.islast and showPerformanceDashboard
        table.cell(performanceHud, 0, 0, "PAPER OUTCOMES", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 0, "RISK-WEIGHTED", bgcolor=color.rgb(30, 34, 45), text_color=color.white)

        table.cell(performanceHud, 0, 1, "Active", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 1, trackedTradeText, bgcolor=trackedTradeActive ? color.new(color.blue, 25) : color.rgb(60, 65, 75), text_color=color.white)

        table.cell(performanceHud, 0, 2, "Validation", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 2, validationStatusText, bgcolor=closedOutcomeTrades >= minimumValidationTrades ? color.new(color.green, 25) : color.new(color.orange, 30), text_color=color.white)

        table.cell(performanceHud, 0, 3, "Closed", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 3, str.tostring(closedOutcomeTrades), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(performanceHud, 0, 4, "Positive", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 4, str.tostring(positiveOutcomeTrades), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(performanceHud, 0, 5, "TP2 reached", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 5, str.tostring(tp2OutcomeTrades), bgcolor=color.new(color.green, 25), text_color=color.white)

        table.cell(performanceHud, 0, 6, "Runner exits", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 6, str.tostring(runnerOutcomeTrades), bgcolor=color.new(color.teal, 30), text_color=color.white)

        table.cell(performanceHud, 0, 7, "TP1 protected", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 7, str.tostring(tp1ProtectedTrades), bgcolor=color.new(color.green, 40), text_color=color.white)

        table.cell(performanceHud, 0, 8, "Initial SL", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 8, str.tostring(stopOutcomeTrades), bgcolor=color.new(color.red, 25), text_color=color.white)

        table.cell(performanceHud, 0, 9, "Timeout", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 9, str.tostring(timeoutOutcomeTrades), bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(performanceHud, 0, 10, "Net R", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 10, str.tostring(netOutcomeR, "#.##"), bgcolor=netOutcomeR >= 0.0 ? color.new(color.green, 25) : color.new(color.red, 25), text_color=color.white)

        table.cell(performanceHud, 0, 11, "Win / PF", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 11, winRateText + " / " + profitFactorText, bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(performanceHud, 0, 12, "Avg MFE / MAE", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 12, averageExcursionText, bgcolor=color.rgb(60, 65, 75), text_color=color.white)

        table.cell(performanceHud, 0, 13, "ERI 90+ trades / R", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 13, str.tostring(eriInstitutionalTrades) + " / " + str.tostring(eriInstitutionalNetR, "#.##"), bgcolor=color.new(color.green, 35), text_color=color.white)

        table.cell(performanceHud, 0, 14, "ERI 80-89 trades / R", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 14, str.tostring(eriGradeATrades) + " / " + str.tostring(eriGradeANetR, "#.##"), bgcolor=color.new(color.teal, 40), text_color=color.white)

        table.cell(performanceHud, 0, 15, "ERI <80 trades / R", bgcolor=color.rgb(30, 34, 45), text_color=color.white)
        table.cell(performanceHud, 1, 15, str.tostring(eriGradeBTrades) + " / " + str.tostring(eriGradeBNetR, "#.##"), bgcolor=color.new(color.orange, 40), text_color=color.white)


f_renderMainHud(hud)
f_renderFunnelHud(funnelHud)
f_renderPerformanceHud(performanceHud)

//=============================================================================
// ALERTS
//=============================================================================
alertcondition(buySignal, "PSRC Unified BUY", "PSRC BUY | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(sellSignal, "PSRC Unified SELL", "PSRC SELL | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(buySignal or sellSignal, "PSRC CRT Unified Buy/Sell", "PSRC CRT signal | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(addBuySignal, "PSRC CRT BUY Add", "PSRC CRT hybrid BUY add | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(addSellSignal, "PSRC CRT SELL Add", "PSRC CRT hybrid SELL add | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(addBuySignal or addSellSignal, "PSRC CRT Unified Add", "PSRC CRT hybrid add | {{ticker}} | TF={{interval}} | Close={{close}}")
alertcondition(longArmEvent or shortArmEvent, "PSRC CRT Setup Armed", "PSRC CRT setup armed | {{ticker}} | TF={{interval}}")
alertcondition(longMssEvent or shortMssEvent, "PSRC CRT MSS Confirmed", "PSRC CRT MSS confirmed | {{ticker}} | TF={{interval}}")
alertcondition(longReadyEvent or shortReadyEvent, "PSRC CRT Setup Ready", "PSRC CRT setup ready | {{ticker}} | TF={{interval}}")
alertcondition(outcomeEvent, "PSRC CRT Outcome", "PSRC CRT tracked outcome | {{ticker}} | TF={{interval}}")

if enableDynamicAlerts and longArmEvent
    alert(
         "PSRC_CRT|LONG_ARMED|" + syminfo.ticker +
         "|TF=" + timeframe.period +
         "|BIAS_GRADE=" + longBiasGradeAtArm +
         "|SOURCE=" + longSource +
         "|SWEEP=" + f_price(longSweptLevel) +
         "|MSS=" + f_price(longInternalBreak),
         alert.freq_once_per_bar_close)

if enableDynamicAlerts and shortArmEvent
    alert(
         "PSRC_CRT|SHORT_ARMED|" + syminfo.ticker +
         "|TF=" + timeframe.period +
         "|BIAS_GRADE=" + shortBiasGradeAtArm +
         "|SOURCE=" + shortSource +
         "|SWEEP=" + f_price(shortSweptLevel) +
         "|MSS=" + f_price(shortInternalBreak),
         alert.freq_once_per_bar_close)

if enableDynamicAlerts and longReadyEvent
    alert(
         "PSRC_CRT|LONG_READY|" + syminfo.ticker +
         "|TF=" + timeframe.period +
         "|GRADE=" + longGrade +
         "|QUALITY_SCORE=" + str.tostring(longPlannedQualityScore) +
         "|CONFIDENCE=" + str.tostring(longPlannedConfidencePct, "#") + "%" +
         "|EXEC=" + longExecutionType +
         "|TARGET_MODEL=" + longTargetModel +
         "|SOURCE=" + longSource +
         "|ENTRY=" + f_price(longPlannedEntry) +
         "|RISK_PCT=" + str.tostring(longScoutRiskPct, "#") +
         (longExecutionType == "HYBRID" ? "|ADD_ZONE_LOW=" + f_price(longPlannedAddZoneLow) + "|ADD_ZONE_HIGH=" + f_price(longPlannedAddZoneHigh) : "") +
         "|SL=" + f_price(longPlannedStop) +
         "|TP1=" + f_price(longPlannedTp1) +
         "|TP2=" + f_price(longPlannedTp2),
         alert.freq_once_per_bar_close)

if enableDynamicAlerts and shortReadyEvent
    alert(
         "PSRC_CRT|SHORT_READY|" + syminfo.ticker +
         "|TF=" + timeframe.period +
         "|GRADE=" + shortGrade +
         "|QUALITY_SCORE=" + str.tostring(shortPlannedQualityScore) +
         "|CONFIDENCE=" + str.tostring(shortPlannedConfidencePct, "#") + "%" +
         "|EXEC=" + shortExecutionType +
         "|TARGET_MODEL=" + shortTargetModel +
         "|SOURCE=" + shortSource +
         "|ENTRY=" + f_price(shortPlannedEntry) +
         "|RISK_PCT=" + str.tostring(shortScoutRiskPct, "#") +
         (shortExecutionType == "HYBRID" ? "|ADD_ZONE_LOW=" + f_price(shortPlannedAddZoneLow) + "|ADD_ZONE_HIGH=" + f_price(shortPlannedAddZoneHigh) : "") +
         "|SL=" + f_price(shortPlannedStop) +
         "|TP1=" + f_price(shortPlannedTp1) +
         "|TP2=" + f_price(shortPlannedTp2),
         alert.freq_once_per_bar_close)

if enableDynamicAlerts and buySignal
    alert(
         "PSRC_CRT|BUY|" + syminfo.ticker +
         "|TF=" + timeframe.period +
         "|GRADE=" + signalGrade +
         "|QUALITY_SCORE=" + str.tostring(signalQualityScore) +
         "|CONFIDENCE=" + str.tostring(signalConfidencePct, "#") + "%" +
         "|ERI=" + str.tostring(signalEri, "#") +
         "|EXECUTION_GRADE=" + signalExecutionGrade +
         "|CONFIDENCE_TIER=" + signalConfidenceTier +
         "|UNIFIED_CONFIDENCE=" + str.tostring(signalUnifiedConfidence, "#") + "%" +
         "|HIERARCHY=" + signalGateStatus +
         "|MSS_GATE=" + (signalGateStatus == "PASSED" ? "PASSED" : signalGateStatus) +
         "|ENTRY_SEQUENCE=" + signalExecutionType +
         "|CONTINUATION_QUALITY=PASSED" +
         "|POST_CONTINUATION_BREAK=" + (str.contains(signalExecutionType, "BREAK") ? "PASSED" : "BYPASSED") +
         "|BREAK_ACCEPTANCE=" + (str.contains(signalExecutionType, "ACCEPT") or str.contains(signalExecutionType, "RETEST") ? "PASSED" : "BYPASSED") +
         "|EXECUTION_QUALITY=" + str.tostring(signalExecutionQuality, "#.0") +
         "|EXECUTION_RANK=" + signalExecutionRank +
         "|EXEC=" + signalExecutionType +
         "|TARGET_MODEL=" + signalTargetModel +
         "|SOURCE=" + signalSource +
         "|ENTRY=" + f_price(signalEntry) +
         "|SCOUT_RISK_PCT=" + str.tostring(signalScoutRiskPct, "#") +
         (signalExecutionType == "HYBRID" ? "|ADD_ZONE_LOW=" + f_price(signalAddZoneLow) + "|ADD_ZONE_HIGH=" + f_price(signalAddZoneHigh) + "|ADD_RISK_PCT=" + str.tostring(100.0 - signalScoutRiskPct, "#") : "") +
         "|SL=" + f_price(signalStop) +
         "|TP1=" + f_price(signalTp1) +
         "|TP2=" + f_price(signalTp2),
         alert.freq_once_per_bar_close)

if enableDynamicAlerts and sellSignal
    alert(
         "PSRC_CRT|SELL|" + syminfo.ticker +
         "|TF=" + timeframe.period +
         "|GRADE=" + signalGrade +
         "|QUALITY_SCORE=" + str.tostring(signalQualityScore) +
         "|CONFIDENCE=" + str.tostring(signalConfidencePct, "#") + "%" +
         "|ERI=" + str.tostring(signalEri, "#") +
         "|EXECUTION_GRADE=" + signalExecutionGrade +
         "|CONFIDENCE_TIER=" + signalConfidenceTier +
         "|UNIFIED_CONFIDENCE=" + str.tostring(signalUnifiedConfidence, "#") + "%" +
         "|HIERARCHY=" + signalGateStatus +
         "|MSS_GATE=" + (signalGateStatus == "PASSED" ? "PASSED" : signalGateStatus) +
         "|ENTRY_SEQUENCE=" + signalExecutionType +
         "|CONTINUATION_QUALITY=PASSED" +
         "|POST_CONTINUATION_BREAK=" + (str.contains(signalExecutionType, "BREAK") ? "PASSED" : "BYPASSED") +
         "|BREAK_ACCEPTANCE=" + (str.contains(signalExecutionType, "ACCEPT") or str.contains(signalExecutionType, "RETEST") ? "PASSED" : "BYPASSED") +
         "|EXECUTION_QUALITY=" + str.tostring(signalExecutionQuality, "#.0") +
         "|EXECUTION_RANK=" + signalExecutionRank +
         "|EXEC=" + signalExecutionType +
         "|TARGET_MODEL=" + signalTargetModel +
         "|SOURCE=" + signalSource +
         "|ENTRY=" + f_price(signalEntry) +
         "|SCOUT_RISK_PCT=" + str.tostring(signalScoutRiskPct, "#") +
         (signalExecutionType == "HYBRID" ? "|ADD_ZONE_LOW=" + f_price(signalAddZoneLow) + "|ADD_ZONE_HIGH=" + f_price(signalAddZoneHigh) + "|ADD_RISK_PCT=" + str.tostring(100.0 - signalScoutRiskPct, "#") : "") +
         "|SL=" + f_price(signalStop) +
         "|TP1=" + f_price(signalTp1) +
         "|TP2=" + f_price(signalTp2),
         alert.freq_once_per_bar_close)


if enableDynamicAlerts and addBuySignal
    alert(
         "PSRC_CRT|BUY_ADD|" + syminfo.ticker +
         "|TF=" + timeframe.period +
         "|GRADE=" + addSignalGrade +
         "|SOURCE=" + addSignalSource +
         "|RISK_PCT=" + str.tostring(addSignalRiskPct, "#") +
         "|ENTRY=" + f_price(addSignalEntry) +
         "|SL=" + f_price(addSignalStop) +
         "|TP1=" + f_price(addSignalTp1) +
         "|TP2=" + f_price(addSignalTp2),
         alert.freq_once_per_bar_close)

if enableDynamicAlerts and addSellSignal
    alert(
         "PSRC_CRT|SELL_ADD|" + syminfo.ticker +
         "|TF=" + timeframe.period +
         "|GRADE=" + addSignalGrade +
         "|SOURCE=" + addSignalSource +
         "|RISK_PCT=" + str.tostring(addSignalRiskPct, "#") +
         "|ENTRY=" + f_price(addSignalEntry) +
         "|SL=" + f_price(addSignalStop) +
         "|TP1=" + f_price(addSignalTp1) +
         "|TP2=" + f_price(addSignalTp2),
         alert.freq_once_per_bar_close)

if enableDynamicAlerts and outcomeEvent
    alert(
         "PSRC_CRT|OUTCOME|" + syminfo.ticker +
         "|TF=" + timeframe.period +
         "|GRADE=" + trackedGrade +
         "|SOURCE=" + trackedSource +
         "|TARGET_MODEL=" + trackedTargetModel +
         "|RESULT=" + outcomeText +
         "|R=" + str.tostring(outcomeR, "#.##") +
         "|MFE_R=" + str.tostring(trackedMfeR, "#.##") +
         "|MAE_R=" + str.tostring(trackedMaeR, "#.##"),
         alert.freq_once_per_bar_close)


//-----------------------------------------------------------------------------
// v3.3.0 RC — Confirmation and direction-gate diagnostics
//-----------------------------------------------------------------------------
f_dbgMark(bool value) =>
    value ? "✓" : "×"

f_dbgColor(bool value) =>
    value ? color.new(color.green, 35) : color.new(color.red, 35)

f_midValueColor(bool active, bool passed, float value) =>
    not active or na(value) ? color.new(color.gray, 70) :
     passed ? color.new(color.green, 35) :
     math.abs(value) <= midpointToleranceAtr + 0.15 ? color.new(color.orange, 30) :
     color.new(color.red, 35)

f_closeLocColor(bool active, bool passed, float value) =>
    not active or na(value) ? color.new(color.gray, 70) :
     passed ? color.new(color.green, 35) :
     color.new(color.red, 35)


f_windowDetail(bool active, int age) =>
    not active ? "AWAIT DISP" :
     na(age) ? "AGE PENDING" :
     age <= 0 ? "WAIT NEXT BAR" :
     age > acceptanceGraceBars ? "WINDOW CLOSED " + str.tostring(age) + "/" + str.tostring(acceptanceGraceBars) :
     "WINDOW OPEN " + str.tostring(age) + "/" + str.tostring(acceptanceGraceBars)

f_midDetail(bool active, bool passed, float deltaAtr) =>
    not active ? "AWAIT DISP" :
     na(deltaAtr) ? "MID PENDING" :
     (passed ? "PASS " : deltaAtr < 0 ? "BELOW " : "ABOVE ") +
     str.tostring(deltaAtr, "#.###") + " ATR | REQ ±" +
     str.tostring(midpointToleranceAtr, "#.##")

f_compressionDetail(bool active, bool passed, float score) =>
    not active ? "AWAIT DISP" :
     not useCompressionQualification ? "FILTER OFF" :
     useCompressionScore ?
         (na(score) ? "SCORE PENDING" :
          str.tostring(score, "#.##") + " | REQ " +
          str.tostring(minimumCompressionScore, "#.##") +
          (passed ? " PASS" : " FAIL")) :
     (passed ? "RANGE/BREAK PASS" : "RANGE/BREAK FAIL")

f_vacuumDetail(bool active, bool passed) =>
    not active ? "AWAIT DISP" :
     not useLiquidityVacuumFilter ? "FILTER OFF" :
     passed ? "PASS" : "FAIL"

f_confirmDetail(bool active, bool confirmed, string blocker) =>
    not active ? "AWAIT DISP" :
     confirmed ? "CONFIRMED" :
     blocker == "WINDOW CLOSED" ? "WINDOW FAIL" :
     blocker == "MIDPOINT/CLOSE" ? "MID/CLOSE FAIL" :
     blocker == "DIRECTION" ? "DIR FAIL" :
     blocker == "COMPRESSION" ? "COMP FAIL" :
     blocker == "VACUUM" ? "VAC FAIL" :
     blocker == "FVG" ? "FVG FAIL" :
     blocker == "VOLUME" ? "VOL FAIL" :
     blocker == "VWAP" ? "VWAP FAIL" :
     blocker

f_readiness(bool active, bool windowOk, bool midpointOk, bool directionOk, bool compressionOk, bool vacuumOk, bool fvgOk, bool volumeOk, bool vwapOk, bool confirmOk) =>
    // Strict hierarchical readiness. Scores only advance after critical gates complete.
    not active ? 0 :
     not windowOk ? 10 :
     not midpointOk ? 25 :
     not directionOk ? 60 :
     not compressionOk ? 70 :
     not vacuumOk ? 78 :
     not fvgOk ? 84 :
     not volumeOk ? 88 :
     not vwapOk ? 92 :
     not confirmOk ? 95 :
     100

f_nextGate(bool active, bool windowOk, bool midpointOk, bool directionOk, bool compressionOk, bool vacuumOk, bool fvgOk, bool volumeOk, bool vwapOk, bool confirmOk) =>
    not active ? "WAIT_DISPLACEMENT" :
     not windowOk ? "WAIT_WINDOW" :
     not midpointOk ? "WAIT_MIDPOINT" :
     not directionOk ? "WAIT_DIRECTION" :
     not compressionOk ? "WAIT_COMPRESSION" :
     not vacuumOk ? "WAIT_VACUUM" :
     not fvgOk ? "WAIT_FVG" :
     not volumeOk ? "WAIT_VOLUME" :
     not vwapOk ? "WAIT_VWAP" :
     not confirmOk ? "WAIT_CONFIRM" :
     "READY"

f_stateColor(string state) =>
    state == "EXPIRED" or state == "INVALIDATED" ? color.new(color.red, 10) :
     state == "READY" ? color.new(color.lime, 0) :
     state == "WAIT_CONFIRM" ? color.new(color.green, 20) :
     state == "WAIT_VWAP" or state == "WAIT_VOLUME" or state == "WAIT_FVG" ? color.new(color.yellow, 15) :
     state == "WAIT_VACUUM" or state == "WAIT_COMPRESSION" ? color.new(color.orange, 15) :
     color.new(color.red, 25)

f_scoreStatus(bool active, bool windowOk, bool midpointOk, bool directionOk, bool compressionOk) =>
    not active ? "AWAIT DISP" :
     not windowOk ? "WAIT WINDOW" :
     not midpointOk ? "WAIT MIDPOINT" :
     not directionOk ? "WAIT DIRECTION" :
     not compressionOk ? "WAIT COMPRESSION" :
     "SCORE ELIGIBLE"

f_readinessColor(int score) =>
    score >= 100 ? color.new(color.lime, 0) :
     score >= 80 ? color.new(color.green, 15) :
     score >= 60 ? color.new(color.yellow, 15) :
     score >= 30 ? color.new(color.orange, 15) :
     color.new(color.red, 25)

f_midGapDetail(bool active, bool passed, float deltaAtr, bool isLong) =>
    float req = midpointAcceptanceMode == "ATR-tolerant close" ? midpointToleranceAtr : 0.0
    float boundary = isLong ? -req : req
    float gap = na(deltaAtr) ? na : isLong ? math.max(boundary - deltaAtr, 0.0) : math.max(deltaAtr - boundary, 0.0)
    not active ? "AWAIT DISP" :
     na(deltaAtr) ? "MID PENDING" :
     passed ? "MIDPOINT PASS" :
     str.tostring(gap, "#.##") + " ATR REMAINING"

string currentLongState = f_nextGate(dbgLongActive, dbgLongWindow, dbgLongMidpoint, dbgLongDirectional, dbgLongCompression, dbgLongVacuum, dbgLongFvg, dbgLongVolume, dbgLongVwap, dbgLongConfirm)
string currentShortState = f_nextGate(dbgShortActive, dbgShortWindow, dbgShortMidpoint, dbgShortDirectional, dbgShortCompression, dbgShortVacuum, dbgShortFvg, dbgShortVolume, dbgShortVwap, dbgShortConfirm)

var string trackedLongState = ""
var string trackedShortState = ""
var int longStateStartBar = na
var int shortStateStartBar = na
var int longStateStartTime = na
var int shortStateStartTime = na

if currentLongState != trackedLongState
    trackedLongState := currentLongState
    longStateStartBar := bar_index
    longStateStartTime := time

if currentShortState != trackedShortState
    trackedShortState := currentShortState
    shortStateStartBar := bar_index
    shortStateStartTime := time

int longStateAge = na(longStateStartBar) ? 0 : bar_index - longStateStartBar
int shortStateAge = na(shortStateStartBar) ? 0 : bar_index - shortStateStartBar
float longStateAgeHours = na(longStateStartTime) ? 0.0 : math.max(float(time - longStateStartTime) / 3600000.0, 0.0)
float shortStateAgeHours = na(shortStateStartTime) ? 0.0 : math.max(float(time - shortStateStartTime) / 3600000.0, 0.0)
bool longStateExpired = currentLongState != "READY" and longStateAgeHours >= diagnosticStateExpiryHours
bool shortStateExpired = currentShortState != "READY" and shortStateAgeHours >= diagnosticStateExpiryHours

// Authoritative display state. Expiry has absolute precedence.
string longEngineState = longStateExpired ? "EXPIRED" : currentLongState
string shortEngineState = shortStateExpired ? "EXPIRED" : currentShortState

// Display-active is false after expiry even if the underlying setup flag remains latched
// until the next structural reset. This prevents contradictory telemetry.
bool longDisplayActive = dbgLongActive and not longStateExpired
bool shortDisplayActive = dbgShortActive and not shortStateExpired

f_stateAgeText(float ageHours, int ageBars, bool expired) =>
    expired ? "EXPIRED" :
     ageHours >= 48.0 ? str.tostring(ageHours / 24.0, "#.#") + " days" :
     ageHours >= 1.0 ? str.tostring(ageHours, "#.#") + " hrs" :
     str.tostring(ageBars) + " bars"

// v3.7.2 RC — Operator UX refinement
// Execution logic is unchanged. The display exposes only operator-facing states:
// OFF, WATCH, READY, LIVE. Inactive diagnostics are collapsed.

f_operatorStatus(string state, bool expired, bool isLong) =>
    bool liveSide = trackedTradeActive and ((isLong and trackedDirection == 1) or (not isLong and trackedDirection == -1))
    liveSide ? "LIVE" :
     state == "READY" and not expired ? "READY" :
     expired or state == "WAIT_DISPLACEMENT" ? "OFF" :
     "WATCH"

f_statusColor(string status) =>
    status == "LIVE" ? color.new(color.aqua, 0) :
     status == "READY" ? color.new(color.lime, 0) :
     status == "WATCH" ? color.new(color.orange, 10) :
     color.new(color.gray, 70)

f_operatorNextAction(string state, bool expired) =>
    expired ? "WAIT FOR NEW DISPLACEMENT" :
     state == "WAIT_DISPLACEMENT" ? "WAIT FOR NEW DISPLACEMENT" :
     state == "WAIT_WINDOW" ? "WAIT FOR VALID WINDOW" :
     state == "WAIT_MIDPOINT" ? "WAIT FOR MIDPOINT CLOSE" :
     state == "WAIT_DIRECTION" ? "WAIT FOR DIRECTIONAL CLOSE" :
     state == "WAIT_COMPRESSION" ? "WAIT FOR COMPRESSION" :
     state == "WAIT_VACUUM" ? "WAIT FOR VACUUM PASS" :
     state == "WAIT_FVG" ? "WAIT FOR FVG" :
     state == "WAIT_VOLUME" ? "WAIT FOR VOLUME" :
     state == "WAIT_VWAP" ? "WAIT FOR VWAP ALIGNMENT" :
     state == "WAIT_CONFIRM" ? "WAIT FOR CONFIRMATION CLOSE" :
     state == "READY" ? "EXECUTE VALID PLAN" :
     "WAIT"

f_operatorNextGate(string state, bool expired) =>
    expired or state == "WAIT_DISPLACEMENT" ? "DISPLACEMENT" :
     state == "WAIT_WINDOW" ? "WINDOW" :
     state == "WAIT_MIDPOINT" ? "MIDPOINT" :
     state == "WAIT_DIRECTION" or state == "WAIT_COMPRESSION" ? "STRUCTURE" :
     state == "WAIT_VACUUM" or state == "WAIT_FVG" or state == "WAIT_VOLUME" or state == "WAIT_VWAP" or state == "WAIT_CONFIRM" ? "CONFIRMATION" :
     state == "READY" ? "ENTRY" :
     "DISPLACEMENT"

f_operatorBlockerDetail(string state, bool expired, bool active, float midDeltaAtr, bool isLong) =>
    float req = midpointAcceptanceMode == "ATR-tolerant close" ? midpointToleranceAtr : 0.0
    float boundary = isLong ? -req : req
    float gap = na(midDeltaAtr) ? na : isLong ? math.max(boundary - midDeltaAtr, 0.0) : math.max(midDeltaAtr - boundary, 0.0)
    expired ? "STALE SETUP — RESET REQUIRED" :
     state == "WAIT_DISPLACEMENT" ? "NO ACTIVE DISPLACEMENT" :
     state == "WAIT_WINDOW" ? "DISPLACEMENT OUTSIDE VALID WINDOW" :
     state == "WAIT_MIDPOINT" ? (na(gap) ? "MIDPOINT DATA PENDING" : str.tostring(gap, "#.##") + " ATR TO MIDPOINT") :
     state == "WAIT_DIRECTION" ? "DIRECTIONAL BODY/CLOSE NOT CONFIRMED" :
     state == "WAIT_COMPRESSION" ? "COMPRESSION THRESHOLD NOT MET" :
     state == "WAIT_VACUUM" ? "VACUUM TEST FAILED" :
     state == "WAIT_FVG" ? "FVG NOT PRESENT" :
     state == "WAIT_VOLUME" ? "VOLUME CONFIRMATION FAILED" :
     state == "WAIT_VWAP" ? "VWAP ALIGNMENT FAILED" :
     state == "WAIT_CONFIRM" ? "CONFIRMATION CANDLE INCOMPLETE" :
     state == "READY" ? "NONE" :
     active ? state : "NO ACTIVE SETUP"

f_ageColor(float ageHours, bool expired) =>
    expired ? color.new(color.red, 5) :
     ageHours >= diagnosticStateExpiryHours * 0.75 ? color.new(color.orange, 10) :
     ageHours >= diagnosticStateExpiryHours * 0.5 ? color.new(color.yellow, 15) :
     color.new(color.green, 25)

f_contextStatus(bool expired, bool pass, string passText, string failText) =>
    expired ? "N/A" : pass ? passText : failText

f_confirmationStatus(bool expired, bool vacuumOk, bool fvgOk, bool volumeOk, bool vwapOk, bool confirmOk) =>
    expired ? "N/A" :
     not vacuumOk ? "VACUUM BLOCKED" :
     not fvgOk ? "FVG BLOCKED" :
     not volumeOk ? "VOLUME BLOCKED" :
     not vwapOk ? "VWAP BLOCKED" :
     not confirmOk ? "CANDLE BLOCKED" :
     "PASS"

//=============================================================================
// v4.2 CENTRAL INSTITUTIONAL DECISION MODEL
//=============================================================================

// Central deterministic institutional score. This is a rule-completion score,
// not a statistical probability.
f_institutionalScore(bool active, bool windowOk, bool midpointOk, bool directionOk, bool compressionOk, bool vacuumOk, bool fvgOk, bool volumeOk, bool vwapOk, bool confirmOk) =>
    float score = (active ? 5.0 : 0.0) +
      (windowOk ? 5.0 : 0.0) +
      (midpointOk ? 10.0 : 0.0) +
      (directionOk ? 20.0 : 0.0) +
      (compressionOk ? 10.0 : 0.0) +
      (vacuumOk ? 10.0 : 0.0) +
      (fvgOk ? 10.0 : 0.0) +
      (volumeOk ? 10.0 : 0.0) +
      (vwapOk ? 10.0 : 0.0) +
      (confirmOk ? 10.0 : 0.0)
    math.max(0.0, math.min(100.0, score))

f_gateCountV42(bool active, bool windowOk, bool midpointOk, bool directionOk, bool compressionOk, bool vacuumOk, bool fvgOk, bool volumeOk, bool vwapOk, bool confirmOk) =>
    (active ? 1 : 0) + (windowOk ? 1 : 0) + (midpointOk ? 1 : 0) +
      (directionOk ? 1 : 0) + (compressionOk ? 1 : 0) + (vacuumOk ? 1 : 0) +
      (fvgOk ? 1 : 0) + (volumeOk ? 1 : 0) + (vwapOk ? 1 : 0) + (confirmOk ? 1 : 0)

f_qualityScoreV42(float storedQuality, bool directionOk, bool compressionOk, bool vacuumOk, bool fvgOk, bool volumeOk, bool vwapOk) =>
    float evidence = (directionOk ? 25.0 : 0.0) + (compressionOk ? 15.0 : 0.0) +
      (vacuumOk ? 15.0 : 0.0) + (fvgOk ? 15.0 : 0.0) +
      (volumeOk ? 15.0 : 0.0) + (vwapOk ? 15.0 : 0.0)
    float stored = storedQuality > 0.0 ? math.min(100.0, storedQuality * 10.0) : 0.0
    math.max(stored, evidence)

f_qualityGradeV42(float score) =>
    score >= 97.0 ? "A+" :
     score >= 92.0 ? "A" :
     score >= 87.0 ? "A-" :
     score >= 82.0 ? "B+" :
     score >= 76.0 ? "B" :
     score >= 70.0 ? "B-" :
     score >= 64.0 ? "C+" :
     score >= 58.0 ? "C" :
     score >= 50.0 ? "D" :
     "F"

f_projectedRV42(bool isLong, float entry, float stop, float target) =>
    float risk = isLong ? entry - stop : stop - entry
    float reward = isLong ? target - entry : entry - target
    risk > syminfo.mintick and reward > 0.0 ? reward / risk : na

f_decisionStateV42(string status, float score, float projectedR) =>
    status == "LIVE" ? "MANAGE" :
     status == "OFF" ? "IGNORE" :
     status == "READY" and score >= 95.0 and (na(projectedR) or projectedR >= 1.20) ? "EXECUTE" :
     score >= 90.0 ? "READY" :
     score >= 75.0 ? "PREPARE" :
     score >= 55.0 ? "MONITOR" :
     score >= 30.0 ? "WATCH" :
     "IGNORE"

f_actionV42(string decision, string state, bool isLong) =>
    decision == "MANAGE" ? "MANAGE OPEN RISK" :
     decision == "EXECUTE" ? (isLong ? "EXECUTE LONG PLAN" : "EXECUTE SHORT PLAN") :
     decision == "READY" ? "VERIFY EXECUTION CONDITIONS" :
     decision == "PREPARE" ? "PREPARE ORDER PLAN" :
     decision == "MONITOR" ? "MONITOR NEXT GATE" :
     decision == "WATCH" ? "WATCH FOR STRUCTURE" :
     state == "WAIT_DISPLACEMENT" ? "WAIT FOR NEW DISPLACEMENT" :
     "STANDBY"

f_triggerTextV42(string state, bool isLong) =>
    state == "WAIT_DISPLACEMENT" ? (isLong ? "Bullish displacement close" : "Bearish displacement close") :
     state == "WAIT_WINDOW" ? "Valid post-displacement window" :
     state == "WAIT_MIDPOINT" ? (isLong ? "Close above midpoint threshold" : "Close below midpoint threshold") :
     state == "WAIT_DIRECTION" ? (isLong ? "Bullish directional close" : "Bearish directional close") :
     state == "WAIT_COMPRESSION" ? "Compression qualification" :
     state == "WAIT_VACUUM" ? "Liquidity-vacuum pass" :
     state == "WAIT_FVG" ? "FVG confirmation" :
     state == "WAIT_VOLUME" ? "Volume expansion" :
     state == "WAIT_VWAP" ? (isLong ? "VWAP bullish alignment" : "VWAP bearish alignment") :
     state == "WAIT_CONFIRM" ? "Final confirmation close" :
     state == "READY" ? "Unified execution signal" :
     "New displacement"

f_blockerV42(string state, bool expired, bool active, float midDeltaAtr, bool isLong) =>
    float req = midpointAcceptanceMode == "ATR-tolerant close" ? midpointToleranceAtr : 0.0
    float boundary = isLong ? -req : req
    float gap = na(midDeltaAtr) ? na : isLong ? math.max(boundary - midDeltaAtr, 0.0) : math.max(midDeltaAtr - boundary, 0.0)
    expired ? "STALE SETUP — RESET REQUIRED" :
     state == "WAIT_DISPLACEMENT" ? "NO ACTIVE DISPLACEMENT" :
     state == "WAIT_WINDOW" ? "DISPLACEMENT OUTSIDE VALID WINDOW" :
     state == "WAIT_MIDPOINT" ? (na(gap) ? "MIDPOINT DATA PENDING" : str.tostring(gap, "#.##") + " ATR TO MIDPOINT") :
     state == "WAIT_DIRECTION" ? "DIRECTIONAL BODY/CLOSE NOT CONFIRMED" :
     state == "WAIT_COMPRESSION" ? "COMPRESSION THRESHOLD NOT MET" :
     state == "WAIT_VACUUM" ? "VACUUM TEST FAILED" :
     state == "WAIT_FVG" ? "FVG NOT PRESENT" :
     state == "WAIT_VOLUME" ? "VOLUME CONFIRMATION FAILED" :
     state == "WAIT_VWAP" ? "VWAP ALIGNMENT FAILED" :
     state == "WAIT_CONFIRM" ? "FINAL CANDLE NOT CONFIRMED" :
     state == "READY" ? "NONE" :
     active ? state : "NO ACTIVE SETUP"

f_progressBarV42(float score) =>
    int filled = int(math.round(score / 10.0))
    string bar = ""
    for i = 1 to 10
        bar += i <= filled ? "■" : "□"
    bar + " " + str.tostring(score, "#") + "%"

f_decisionColorV42(string decision) =>
    decision == "EXECUTE" or decision == "MANAGE" ? color.new(color.lime, 0) :
     decision == "READY" ? color.new(color.green, 0) :
     decision == "PREPARE" ? color.new(color.green, 20) :
     decision == "MONITOR" or decision == "WATCH" ? color.new(color.orange, 5) :
     color.new(color.red, 10)

f_scoreColorV42(float value) =>
    value >= 90.0 ? color.new(color.lime, 0) :
     value >= 75.0 ? color.new(color.green, 15) :
     value >= 50.0 ? color.new(color.orange, 10) :
     color.new(color.red, 15)

f_environmentV42(bool isLong) =>
    bool emaBull = chartEma20 > chartEma50 and close > chartEma20
    bool emaBear = chartEma20 < chartEma50 and close < chartEma20
    isLong ? (emaBull ? "TREND ALIGNED" : emaBear ? "COUNTERTREND" : "MIXED") :
     (emaBear ? "TREND ALIGNED" : emaBull ? "COUNTERTREND" : "MIXED")

f_riskStateV42(string status, string decision, float projectedR) =>
    status == "LIVE" ? "OPEN RISK" :
     decision == "EXECUTE" and not na(projectedR) and projectedR < 1.20 ? "RR BLOCKED" :
     decision == "READY" or decision == "EXECUTE" ? "ARMED" :
     "FLAT"

f_driversV42(bool directionOk, bool midpointOk, bool vacuumOk, bool fvgOk, bool volumeOk, bool vwapOk, bool confirmOk) =>
    string s = ""
    s += directionOk ? "DIR " : ""
    s += midpointOk ? "MID " : ""
    s += vacuumOk ? "VAC " : ""
    s += fvgOk ? "FVG " : ""
    s += volumeOk ? "VOL " : ""
    s += vwapOk ? "VWAP " : ""
    s += confirmOk ? "CONF" : ""
    str.length(s) == 0 ? "NONE" : s

f_missingV42(bool directionOk, bool midpointOk, bool compressionOk, bool vacuumOk, bool fvgOk, bool volumeOk, bool vwapOk, bool confirmOk) =>
    string s = ""
    s += not midpointOk ? "MID " : ""
    s += not directionOk ? "DIR " : ""
    s += not compressionOk ? "CMP " : ""
    s += not vacuumOk ? "VAC " : ""
    s += not fvgOk ? "FVG " : ""
    s += not volumeOk ? "VOL " : ""
    s += not vwapOk ? "VWAP " : ""
    s += not confirmOk ? "CONF" : ""
    str.length(s) == 0 ? "NONE" : s

var table confirmationDebugTable = table.new(position.bottom_center, 3, 20, border_width=1)

f_renderDecisionIntelligenceV42() =>
    string longStatus = f_operatorStatus(longEngineState, longStateExpired, true)
    string shortStatus = f_operatorStatus(shortEngineState, shortStateExpired, false)

    float longScore = longStatus == "LIVE" ? 100.0 : longStatus == "OFF" ? 0.0 :
      f_institutionalScore(dbgLongActive, dbgLongWindow, dbgLongMidpoint, dbgLongDirectional, dbgLongCompression, dbgLongVacuum, dbgLongFvg, dbgLongVolume, dbgLongVwap, dbgLongConfirm)
    float shortScore = shortStatus == "LIVE" ? 100.0 : shortStatus == "OFF" ? 0.0 :
      f_institutionalScore(dbgShortActive, dbgShortWindow, dbgShortMidpoint, dbgShortDirectional, dbgShortCompression, dbgShortVacuum, dbgShortFvg, dbgShortVolume, dbgShortVwap, dbgShortConfirm)

    int longGateCount = f_gateCountV42(dbgLongActive, dbgLongWindow, dbgLongMidpoint, dbgLongDirectional, dbgLongCompression, dbgLongVacuum, dbgLongFvg, dbgLongVolume, dbgLongVwap, dbgLongConfirm)
    int shortGateCount = f_gateCountV42(dbgShortActive, dbgShortWindow, dbgShortMidpoint, dbgShortDirectional, dbgShortCompression, dbgShortVacuum, dbgShortFvg, dbgShortVolume, dbgShortVwap, dbgShortConfirm)

    float longQuality = f_qualityScoreV42(longPlannedQualityScore, dbgLongDirectional, dbgLongCompression, dbgLongVacuum, dbgLongFvg, dbgLongVolume, dbgLongVwap)
    float shortQuality = f_qualityScoreV42(shortPlannedQualityScore, dbgShortDirectional, dbgShortCompression, dbgShortVacuum, dbgShortFvg, dbgShortVolume, dbgShortVwap)

    float longProjectedR = f_projectedRV42(true, longPlannedEntry, longPlannedStop, longPlannedTp2)
    float shortProjectedR = f_projectedRV42(false, shortPlannedEntry, shortPlannedStop, shortPlannedTp2)

    string longDecision = f_decisionStateV42(longStatus, longScore, longProjectedR)
    string shortDecision = f_decisionStateV42(shortStatus, shortScore, shortProjectedR)

    string longAction = f_actionV42(longDecision, longEngineState, true)
    string shortAction = f_actionV42(shortDecision, shortEngineState, false)

    string longBlocker = f_blockerV42(longEngineState, longStateExpired, longDisplayActive, dbgLongMidDeltaAtr, true)
    string shortBlocker = f_blockerV42(shortEngineState, shortStateExpired, shortDisplayActive, dbgShortMidDeltaAtr, false)

    table.clear(confirmationDebugTable, 0, 0, 2, 19)

    table.cell(confirmationDebugTable, 0, 0, "DECISION INTELLIGENCE v4.2", text_color=color.white, bgcolor=color.new(color.blue, 35))
    table.cell(confirmationDebugTable, 1, 0, "LONG", text_color=color.white, bgcolor=color.new(color.blue, 35))
    table.cell(confirmationDebugTable, 2, 0, "SHORT", text_color=color.white, bgcolor=color.new(color.blue, 35))

    table.cell(confirmationDebugTable, 0, 1, "STATUS")
    table.cell(confirmationDebugTable, 1, 1, longStatus, bgcolor=f_statusColor(longStatus))
    table.cell(confirmationDebugTable, 2, 1, shortStatus, bgcolor=f_statusColor(shortStatus))

    table.cell(confirmationDebugTable, 0, 2, "DECISION")
    table.cell(confirmationDebugTable, 1, 2, longDecision, bgcolor=f_decisionColorV42(longDecision))
    table.cell(confirmationDebugTable, 2, 2, shortDecision, bgcolor=f_decisionColorV42(shortDecision))

    table.cell(confirmationDebugTable, 0, 3, "ACTION")
    table.cell(confirmationDebugTable, 1, 3, longAction)
    table.cell(confirmationDebugTable, 2, 3, shortAction)

    table.cell(confirmationDebugTable, 0, 4, "NEXT TRIGGER")
    table.cell(confirmationDebugTable, 1, 4, f_triggerTextV42(longEngineState, true))
    table.cell(confirmationDebugTable, 2, 4, f_triggerTextV42(shortEngineState, false))

    table.cell(confirmationDebugTable, 0, 5, "PRIMARY BLOCKER")
    table.cell(confirmationDebugTable, 1, 5, longBlocker, bgcolor=longBlocker == "NONE" ? color.new(color.green, 20) : color.new(color.red, 15))
    table.cell(confirmationDebugTable, 2, 5, shortBlocker, bgcolor=shortBlocker == "NONE" ? color.new(color.green, 20) : color.new(color.red, 15))

    table.cell(confirmationDebugTable, 0, 6, "INSTITUTIONAL SCORE")
    table.cell(confirmationDebugTable, 1, 6, f_progressBarV42(longScore), bgcolor=f_scoreColorV42(longScore))
    table.cell(confirmationDebugTable, 2, 6, f_progressBarV42(shortScore), bgcolor=f_scoreColorV42(shortScore))

    table.cell(confirmationDebugTable, 0, 7, "QUALITY GRADE")
    table.cell(confirmationDebugTable, 1, 7, f_qualityGradeV42(longQuality) + " | " + str.tostring(longQuality, "#.0"), bgcolor=f_scoreColorV42(longQuality))
    table.cell(confirmationDebugTable, 2, 7, f_qualityGradeV42(shortQuality) + " | " + str.tostring(shortQuality, "#.0"), bgcolor=f_scoreColorV42(shortQuality))

    table.cell(confirmationDebugTable, 0, 8, "GATE PROGRESS")
    table.cell(confirmationDebugTable, 1, 8, str.tostring(longGateCount) + " / 10")
    table.cell(confirmationDebugTable, 2, 8, str.tostring(shortGateCount) + " / 10")

    table.cell(confirmationDebugTable, 0, 9, "PROJECTED TP2 RR")
    table.cell(confirmationDebugTable, 1, 9, na(longProjectedR) ? "N/A" : str.tostring(longProjectedR, "#.##") + "R")
    table.cell(confirmationDebugTable, 2, 9, na(shortProjectedR) ? "N/A" : str.tostring(shortProjectedR, "#.##") + "R")

    table.cell(confirmationDebugTable, 0, 10, "SETUP FRESHNESS")
    table.cell(confirmationDebugTable, 1, 10, longStatus == "OFF" ? "STANDBY" : f_stateAgeText(longStateAgeHours, longStateAge, false), bgcolor=f_ageColor(longStateAgeHours, longStateExpired))
    table.cell(confirmationDebugTable, 2, 10, shortStatus == "OFF" ? "STANDBY" : f_stateAgeText(shortStateAgeHours, shortStateAge, false), bgcolor=f_ageColor(shortStateAgeHours, shortStateExpired))

    table.cell(confirmationDebugTable, 0, 11, "ENVIRONMENT")
    table.cell(confirmationDebugTable, 1, 11, f_environmentV42(true))
    table.cell(confirmationDebugTable, 2, 11, f_environmentV42(false))

    table.cell(confirmationDebugTable, 0, 12, "RISK STATE")
    table.cell(confirmationDebugTable, 1, 12, f_riskStateV42(longStatus, longDecision, longProjectedR))
    table.cell(confirmationDebugTable, 2, 12, f_riskStateV42(shortStatus, shortDecision, shortProjectedR))

    table.cell(confirmationDebugTable, 0, 13, "WINDOW")
    table.cell(confirmationDebugTable, 1, 13, longStatus == "OFF" ? "N/A" : f_windowDetail(dbgLongActive, dbgLongDispAge))
    table.cell(confirmationDebugTable, 2, 13, shortStatus == "OFF" ? "N/A" : f_windowDetail(dbgShortActive, dbgShortDispAge))

    table.cell(confirmationDebugTable, 0, 14, "MIDPOINT")
    table.cell(confirmationDebugTable, 1, 14, longStatus == "OFF" ? "N/A" : f_midGapDetail(longDisplayActive, dbgLongMidpoint, dbgLongMidDeltaAtr, true), bgcolor=longStatus == "OFF" ? color.new(color.gray, 90) : f_dbgColor(dbgLongMidpoint))
    table.cell(confirmationDebugTable, 2, 14, shortStatus == "OFF" ? "N/A" : f_midGapDetail(shortDisplayActive, dbgShortMidpoint, dbgShortMidDeltaAtr, false), bgcolor=shortStatus == "OFF" ? color.new(color.gray, 90) : f_dbgColor(dbgShortMidpoint))

    table.cell(confirmationDebugTable, 0, 15, "CONFIDENCE DRIVERS")
    table.cell(confirmationDebugTable, 1, 15, f_driversV42(dbgLongDirectional, dbgLongMidpoint, dbgLongVacuum, dbgLongFvg, dbgLongVolume, dbgLongVwap, dbgLongConfirm))
    table.cell(confirmationDebugTable, 2, 15, f_driversV42(dbgShortDirectional, dbgShortMidpoint, dbgShortVacuum, dbgShortFvg, dbgShortVolume, dbgShortVwap, dbgShortConfirm))

    table.cell(confirmationDebugTable, 0, 16, "MISSING FACTORS")
    table.cell(confirmationDebugTable, 1, 16, f_missingV42(dbgLongDirectional, dbgLongMidpoint, dbgLongCompression, dbgLongVacuum, dbgLongFvg, dbgLongVolume, dbgLongVwap, dbgLongConfirm))
    table.cell(confirmationDebugTable, 2, 16, f_missingV42(dbgShortDirectional, dbgShortMidpoint, dbgShortCompression, dbgShortVacuum, dbgShortFvg, dbgShortVolume, dbgShortVwap, dbgShortConfirm))

    table.cell(confirmationDebugTable, 0, 17, "MODEL WEIGHTS")
    table.cell(confirmationDebugTable, 1, 17, "DIR20 MID10 CMP10 VAC10 FVG10")
    table.cell(confirmationDebugTable, 2, 17, "VOL10 VWAP10 CONF10 ACT/WIN10")

    table.cell(confirmationDebugTable, 0, 18, "LIVE ROUTING")
    table.cell(confirmationDebugTable, 1, 18, longDecision == "EXECUTE" ? "LONG ALERT ELIGIBLE" : "NO LONG ROUTE", bgcolor=longDecision == "EXECUTE" ? color.new(color.green, 20) : color.new(color.gray, 85))
    table.cell(confirmationDebugTable, 2, 18, shortDecision == "EXECUTE" ? "SHORT ALERT ELIGIBLE" : "NO SHORT ROUTE", bgcolor=shortDecision == "EXECUTE" ? color.new(color.green, 20) : color.new(color.gray, 85))

    table.cell(confirmationDebugTable, 0, 19, "NOTICE")
    table.cell(confirmationDebugTable, 1, 19, "DETERMINISTIC SCORE — NOT PROBABILITY", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(confirmationDebugTable, 2, 19, "DETERMINISTIC SCORE — NOT PROBABILITY", text_color=color.white, bgcolor=color.new(color.gray, 70))

if barstate.islast
    if showConfirmationDiagnostics
        f_renderDecisionIntelligenceV42()
    else
        table.clear(confirmationDebugTable, 0, 0, 2, 19)
