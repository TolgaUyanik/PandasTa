bool requireVwapSlope = input.bool(false, "Require VWAP slope alignment", group=GROUP_CONFIRM)
bool useVolumeExpansion = input.bool(false, "Require volume expansion", group=GROUP_CONFIRM)
float volumeMultiplier = input.float(1.20, "Volume expansion multiplier", minval=0.5, step=0.05, group=GROUP_CONFIRM)

//-----------------------------------------------------------------------------
// ENTRY AND RISK
//-----------------------------------------------------------------------------
string gradeBExecution = input.string(
     "Retracement",
     "Grade-B execution",
     options=["Retracement", "Confirmation close"],
     group=GROUP_EXEC)
string gradeAExecution = input.string(
     "Hybrid scout + retracement",
     "Grade-A execution",
     options=["Hybrid scout + retracement", "Retracement", "Confirmation close"],
     group=GROUP_EXEC)
float gradeAScoutRiskPct = input.float(
     30.0,
     "Grade-A scout risk allocation (%)",
     minval=5.0,
     maxval=95.0,
     step=5.0,
     group=GROUP_EXEC,
     tooltip="Percentage of total planned risk deployed at the confirmation close. The balance remains for retracement.")
float gradeAMaxExtensionAtr = input.float(
     1.25,
     "Grade-A maximum scout extension (ATR)",
     minval=0.25,
     step=0.05,
     group=GROUP_EXEC)
bool enableGradeBPlus = input.bool(true, "Enable Grade-B+ hybrid scout", group=GROUP_EXEC)
float gradeBPlusScoutRiskPct = input.float(25.0, "Grade-B+ scout risk allocation (%)", minval=5.0, maxval=75.0, step=5.0, group=GROUP_EXEC)
float gradeBPlusMaxExtensionAtr = input.float(0.75, "Grade-B+ maximum scout extension (ATR)", minval=0.10, step=0.05, group=GROUP_EXEC)
float gradeBPlusMinCloseR2 = input.float(2.00, "Grade-B+ minimum close-entry TP2 reward (R)", minval=0.5, step=0.1, group=GROUP_EXEC)
string retracementModel = input.string(
     "FVG midpoint, otherwise displacement 50%",
     "Retracement model",
     options=["FVG midpoint, otherwise displacement 50%", "Displacement 50%"],
     group=GROUP_EXEC)
float hybridZoneShallowPct = input.float(38.2, "Hybrid add zone shallow retracement (%)", minval=10.0, maxval=49.0, step=0.1, group=GROUP_EXEC)
float hybridZoneDeepPct = input.float(61.8, "Hybrid add zone deep retracement (%)", minval=51.0, maxval=90.0, step=0.1, group=GROUP_EXEC)
int entryExpiryBars = input.int(8, "Retracement/add-zone expiry bars", minval=1, maxval=50, group=GROUP_EXEC)
float stopAtrBuffer = input.float(0.10, "Stop buffer (chart ATR)", minval=0.0, step=0.05, group=GROUP_EXEC)
int stopTickBuffer = input.int(2, "Minimum stop buffer (ticks)", minval=0, maxval=100, group=GROUP_EXEC)
float minTarget1R = input.float(0.80, "Minimum TP1 reward (R)", minval=0.1, step=0.1, group=GROUP_EXEC)
float minTarget2R = input.float(1.80, "Minimum TP2 reward (R)", minval=0.2, step=0.1, group=GROUP_EXEC)
bool useFixedRFallback = input.bool(true, "Use fixed-R targets when CRT targets fail", group=GROUP_EXEC)
float fallbackTp1R = input.float(1.00, "Fallback TP1 (R)", minval=0.5, step=0.1, group=GROUP_EXEC)
float fallbackTp2R = input.float(2.00, "Fallback TP2 (R)", minval=1.0, step=0.1, group=GROUP_EXEC)
bool protectEurUsdGradeB = input.bool(true, "EURUSD Grade-B: retracement only", group=GROUP_EXEC)
float eurUsdGradeBRiskPct = input.float(50.0, "EURUSD Grade-B risk allocation (%)", minval=10.0, maxval=100.0, step=5.0, group=GROUP_EXEC)
int cooldownBars = input.int(4, "Signal cooldown bars", minval=0, maxval=100, group=GROUP_EXEC)
int projectionBars = input.int(30, "Risk projection length", minval=5, maxval=200, group=GROUP_EXEC)

//-----------------------------------------------------------------------------
// PAPER OUTCOME TRACKING
//-----------------------------------------------------------------------------
bool trackOutcomes = input.bool(true, "Track signal outcomes", group=GROUP_OUTCOME)
bool blockNewSignalsWhileTracking = input.bool(true, "One active tracked trade at a time", group=GROUP_OUTCOME)
float gradeATp1AllocationPct = input.float(40.0, "Grade-A allocation at TP1 (%)", minval=0.0, maxval=100.0, step=5.0, group=GROUP_OUTCOME)
float gradeATp2AllocationPct = input.float(30.0, "Grade-A allocation at TP2 (%)", minval=0.0, maxval=100.0, step=5.0, group=GROUP_OUTCOME)
float gradeBTp1AllocationPct = input.float(60.0, "Grade-B/B+ allocation at TP1 (%)", minval=0.0, maxval=100.0, step=5.0, group=GROUP_OUTCOME)
float gradeBTp2AllocationPct = input.float(40.0, "Grade-B/B+ allocation at TP2 (%)", minval=0.0, maxval=100.0, step=5.0, group=GROUP_OUTCOME)
string postTp1StopModel = input.string(
     "Structure trail",
     "Protection after TP1",
     options=["Structure trail", "Break-even", "Initial stop"],
     group=GROUP_OUTCOME)
float postTp1RiskAllowanceR = input.float(0.10, "Maximum protected loss after TP1 (R)", minval=0.0, maxval=0.50, step=0.05, group=GROUP_OUTCOME)
float structureTrailAtrBuffer = input.float(0.10, "Structure trail buffer (ATR)", minval=0.0, step=0.05, group=GROUP_OUTCOME)
int maxOutcomeBars = input.int(120, "Maximum bars to track an open signal", minval=5, maxval=1000, group=GROUP_OUTCOME)
int minimumValidationTrades = input.int(100, "Minimum closed trades before sample validation", minval=20, maxval=1000, group=GROUP_OUTCOME)
bool showOutcomeLabels = input.bool(true, "Show outcome labels", group=GROUP_OUTCOME)
bool showPerformanceDashboard = input.bool(false, "Show performance dashboard", group=GROUP_OUTCOME)

//-----------------------------------------------------------------------------
// VISUALS
//-----------------------------------------------------------------------------
bool showDailyLevels = input.bool(true, "Show macro CRT", group=GROUP_VIS)
bool showRangeLevels = input.bool(true, "Show range-TF CRT", group=GROUP_VIS)
bool showVwap = input.bool(true, "Show VWAP", group=GROUP_VIS)
bool showArmLabels = input.bool(true, "Show arming labels", group=GROUP_VIS)
bool showMssLabels = input.bool(false, "Show MSS labels", group=GROUP_VIS)
bool showReadyLabels = input.bool(true, "Show setup-ready labels", group=GROUP_VIS)
bool showAddOnLabels = input.bool(true, "Show hybrid add-on labels", group=GROUP_VIS)
bool showDashboard = input.bool(false, "Show diagnostic dashboard", group=GROUP_VIS)
bool enableDynamicAlerts = input.bool(true, "Enable dynamic alert() messages", group=GROUP_VIS)

//=============================================================================
// VALIDATION
//=============================================================================
int chartSeconds = timeframe.in_seconds()
bool validExecutionTf = chartSeconds == 300 or chartSeconds == 900

if barstate.isfirst
    if strictChartTf and not validExecutionTf
        runtime.error("PSRC CRT Engine v2.9.1 must run on a 5-minute or 15-minute chart.")
    if timeframe.in_seconds(rangeTf) <= chartSeconds
        runtime.error("The institutional range timeframe must be higher than the chart timeframe.")
    if timeframe.in_seconds(macroTf) <= chartSeconds
        runtime.error("The macro timeframe must be higher than the chart timeframe.")
    if timeframe.in_seconds(macroTf) < timeframe.in_seconds(rangeTf)
        runtime.error("The macro timeframe must be equal to or higher than the institutional range timeframe.")
    if maxSweepAtr <= minSweepAtr
        runtime.error("Maximum sweep depth must be greater than minimum sweep depth.")
    if hybridZoneShallowPct >= hybridZoneDeepPct
        runtime.error("Hybrid shallow retracement must be less than the deep retracement.")
    if fallbackTp2R <= fallbackTp1R
        runtime.error("Fallback TP2 must be greater than fallback TP1.")
    if gradeATp1AllocationPct + gradeATp2AllocationPct > 100.0
        runtime.error("Grade-A TP1 and TP2 allocations cannot exceed 100%.")
    if gradeBTp1AllocationPct + gradeBTp2AllocationPct > 100.0
        runtime.error("Grade-B TP1 and TP2 allocations cannot exceed 100%.")

//=============================================================================
// FUNCTIONS
//=============================================================================
f_confirmedHtf(string tf) =>
    request.security(
         syminfo.tickerid,
         tf,
         [open[1], high[1], low[1], close[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1], ta.atr(14)[1]],
         gaps=barmerge.gaps_off,
         lookahead=barmerge.lookahead_on)

f_roundToTick(float value) =>
    math.round(value / syminfo.mintick) * syminfo.mintick

f_price(float value) =>
    str.tostring(f_roundToTick(value), format.mintick)

//=============================================================================
// CONFIRMED HIGHER-TIMEFRAME DATA
//=============================================================================
[dOpen, dHigh, dLow, dClose, dEma20, dEma50, dEma200, dAtr] = f_confirmedHtf(macroTf)
[rOpen, rHigh, rLow, rClose, rEma20, rEma50, rEma200, rAtr] = f_confirmedHtf(rangeTf)

float dMid = (dHigh + dLow) * 0.5
float rMid = (rHigh + rLow) * 0.5

bool newMacroBar = ta.change(time(macroTf)) != 0
bool newRangeBar = ta.change(time(rangeTf)) != 0

//=============================================================================
// CHART-TIMEFRAME CALCULATIONS
//=============================================================================
float chartAtr = ta.atr(14)
float candleRange = math.max(high - low, syminfo.mintick)
float candleBody = math.abs(close - open)
float averageBody = ta.sma(candleBody, bodyAverageLength)
float closeLocation = (close - low) / candleRange
float vwapValue = ta.vwap(hlc3)
float averageVolume = ta.sma(volume, bodyAverageLength)
float chartEma20 = ta.ema(close, 20)
float chartEma50 = ta.ema(close, 50)
float emaSeparationAtr = chartAtr > 0.0 ? math.abs(chartEma20 - chartEma50) / chartAtr : 0.0
bool trendingRegime = emaSeparationAtr >= trendStrengthAtr
float activeEriThreshold = useAdaptiveRegimeEri ? (trendingRegime ? trendingEriMinimum : rangingEriMinimum) : minimumEri

string symbolKey = str.upper(syminfo.tickerid)
bool isEurUsd = str.contains(symbolKey, "EURUSD")
bool autoGoldAsset = str.contains(symbolKey, "XAU") or str.contains(symbolKey, "GOLD") or str.contains(symbolKey, "GC1!")
bool autoUsIndexAsset = str.contains(symbolKey, "US500") or str.contains(symbolKey, "SPX") or str.contains(symbolKey, "USTEC") or str.contains(symbolKey, "NAS100") or str.contains(symbolKey, "NDX") or str.contains(symbolKey, "NQ1!") or str.contains(symbolKey, "ES1!")
bool autoEnergyAsset = str.contains(symbolKey, "XBR") or str.contains(symbolKey, "BRENT") or str.contains(symbolKey, "UKOIL") or str.contains(symbolKey, "USOIL") or str.contains(symbolKey, "WTI") or str.contains(symbolKey, "CL1!")
string autoSessionProfile = autoGoldAsset ? "Gold" : autoUsIndexAsset ? "US indices" : autoEnergyAsset ? "Energy" : syminfo.type == "forex" ? "FX" : "CRT source windows"
string activeSessionProfile = sessionProfile == "Auto by asset" ? autoSessionProfile : sessionProfile
string effectiveSessionInput =
     activeSessionProfile == "FX" ? "0200-0500,0800-1100" :
     activeSessionProfile == "Gold" ? "0300-0500,0820-1130" :
     activeSessionProfile == "US indices" ? "0930-1130,1330-1530" :
     activeSessionProfile == "Energy" ? "0900-1130" :
     activeSessionProfile == "CRT source windows" ? "0000-0100,1200-1400" :
     customSessionInput
bool effectiveSessionFilter = useSessionFilter and activeSessionProfile != "Always on"
bool rawInSession = not effectiveSessionFilter or not na(time(timeframe.period, effectiveSessionInput, sessionTimezone))
bool inSession = not effectiveSessionFilter or rawInSession
bool newChartDay = ta.change(time("D")) != 0
bool newSweepSession = effectiveSessionFilter ? (rawInSession and not rawInSession[1]) : newChartDay
var int sweepSessionSerial = 0

int effectiveDisplacementGrace =
     displacementGraceMode == "Manual" ? displacementGraceManual :
     chartSeconds == 300 ? displacementGrace5m :
     chartSeconds == 900 ? displacementGrace15m :
     displacementGraceManual
int effectiveVwapGrace = vwapMode == "Delayed confirmation" ? vwapGraceBars : 0

if newSweepSession
    sweepSessionSerial += 1

float pivotHigh = ta.pivothigh(high, pivotStrength, pivotStrength)
float pivotLow = ta.pivotlow(low, pivotStrength, pivotStrength)
var float lastConfirmedPivotHigh = na
var float lastConfirmedPivotLow = na

if not na(pivotHigh)
    lastConfirmedPivotHigh := pivotHigh
if not na(pivotLow)
    lastConfirmedPivotLow := pivotLow

float preSweepExternalHigh = ta.highest(high[1], externalStructureLookback)
float preSweepExternalLow = ta.lowest(low[1], externalStructureLookback)

//=============================================================================
// HTF BIAS AND GRADING
//=============================================================================
int enabledBiasComponents =
     (useDailyMidpoint ? 1 : 0) +
     (useDailyEma50 ? 1 : 0) +
     (useRangeMidpoint ? 1 : 0) +
     (useRangeEmaStack ? 1 : 0)

int bullBiasScore =
     (useDailyMidpoint and dClose > dMid ? 1 : 0) +
     (useDailyEma50 and dClose > dEma50 ? 1 : 0) +
     (useRangeMidpoint and rClose > rMid ? 1 : 0) +
     (useRangeEmaStack and rEma20 > rEma200 ? 1 : 0)

int bearBiasScore =
     (useDailyMidpoint and dClose < dMid ? 1 : 0) +
     (useDailyEma50 and dClose < dEma50 ? 1 : 0) +
     (useRangeMidpoint and rClose < rMid ? 1 : 0) +
     (useRangeEmaStack and rEma20 < rEma200 ? 1 : 0)

int gradeBThreshold = enabledBiasComponents > 0 ? int(math.ceil(enabledBiasComponents * 0.75)) : 0

bool bullBiasEligible =
     biasMode == "No bias filter" or
     enabledBiasComponents == 0 or
     (biasMode == "Strict 4-of-4" and bullBiasScore == enabledBiasComponents) or
     (biasMode == "Graded 3-of-4" and bullBiasScore >= gradeBThreshold)

bool bearBiasEligible =
     biasMode == "No bias filter" or
     enabledBiasComponents == 0 or
     (biasMode == "Strict 4-of-4" and bearBiasScore == enabledBiasComponents) or
     (biasMode == "Graded 3-of-4" and bearBiasScore >= gradeBThreshold)

string bullBiasGrade =
     biasMode == "No bias filter" or enabledBiasComponents == 0 ? "U" :
     bullBiasScore == enabledBiasComponents ? "A" :
     bullBiasScore >= gradeBThreshold ? "B" : "X"

string bearBiasGrade =
     biasMode == "No bias filter" or enabledBiasComponents == 0 ? "U" :
     bearBiasScore == enabledBiasComponents ? "A" :
     bearBiasScore >= gradeBThreshold ? "B" : "X"

bool longDirectionEnabled = directionMode != "Short only"
bool shortDirectionEnabled = directionMode != "Long only"

//=============================================================================
// EXACT CRT SWEEP LOGIC
//=============================================================================
bool dailyLevelEnabled = armingLevels != "Range TF only"
bool rangeLevelEnabled = armingLevels != "Daily only"

float bullDailyDepth = dLow - low
float bullRangeDepth = rLow - low
float bearDailyDepth = high - dHigh
float bearRangeDepth = high - rHigh

bool bullDailySweep =
     barstate.isconfirmed and inSession and dailyLevelEnabled and
     low < dLow and close > dLow and
     bullDailyDepth >= chartAtr * minSweepAtr and bullDailyDepth <= chartAtr * maxSweepAtr and
     closeLocation >= rejectionClosePct

bool bullRangeSweep =
     barstate.isconfirmed and inSession and rangeLevelEnabled and
     low < rLow and close > rLow and
     bullRangeDepth >= chartAtr * minSweepAtr and bullRangeDepth <= chartAtr * maxSweepAtr and
     closeLocation >= rejectionClosePct

bool bearDailySweep =
     barstate.isconfirmed and inSession and dailyLevelEnabled and
     high > dHigh and close < dHigh and
     bearDailyDepth >= chartAtr * minSweepAtr and bearDailyDepth <= chartAtr * maxSweepAtr and
     closeLocation <= 1.0 - rejectionClosePct

bool bearRangeSweep =
     barstate.isconfirmed and inSession and rangeLevelEnabled and
     high > rHigh and close < rHigh and
     bearRangeDepth >= chartAtr * minSweepAtr and bearRangeDepth <= chartAtr * maxSweepAtr and
     closeLocation <= 1.0 - rejectionClosePct

bool anyBullSweep = bullDailySweep or bullRangeSweep
bool anyBearSweep = bearDailySweep or bearRangeSweep
bool twoSidedSweep = anyBullSweep and anyBearSweep
bool sweepConflict = rejectTwoSidedSweep and twoSidedSweep

// Daily receives priority if both eligible levels reclaim on the same candle.
float selectedBullLevel = bullDailySweep ? dLow : bullRangeSweep ? rLow : na
float selectedBearLevel = bearDailySweep ? dHigh : bearRangeSweep ? rHigh : na
string selectedBullSource = bullDailySweep ? "Daily" : bullRangeSweep ? "Range TF" : ""
string selectedBearSource = bearDailySweep ? "Daily" : bearRangeSweep ? "Range TF" : ""

//=============================================================================
// Confirmation diagnostic state (v3.2.7 RC)
var bool dbgLongActive = false
var bool dbgLongWindow = false
var bool dbgLongMidpoint = false
var bool dbgLongDirectional = false
var bool dbgLongDirBody = false
var bool dbgLongDirCloseLocation = false
var bool dbgLongCompression = false
var bool dbgLongVacuum = false
var bool dbgLongFvg = false
