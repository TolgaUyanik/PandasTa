//@version=6
indicator("PSRC Institutional CRT Execution Engine v4.2.0 RC CENTRAL DECISION ENGINE [5m/15m]", shorttitle="PSRC CRT Engine v4.2.0 RC", overlay=true, max_lines_count=200, max_labels_count=500)

// v4.2.0 RC — Central Institutional Decision Layer
// - Preserves the existing signal-generation and execution FSM
// - Separates readiness, model confidence, setup quality and projected RR
// - Adds plain-language recommendation, next trigger and blocker explanation
// - Scores are deterministic model diagnostics, not empirical probabilities
// - Unified alerts, risk logic, order management and outcome tracking preserved

// v3.6.0 RC — Authoritative finite-state telemetry
// - Expired sides terminate ACTIVE and suppress stale downstream gates
// - Expired diagnostics collapse to a concise reset message
// - Single engine-state precedence drives readiness and display
// - Midpoint telemetry reports ATR remaining
// - Trading logic, alerts, execution, and risk architecture preserved

// v3.5.0 RC — Compile-safe hierarchical state-machine integration
// - Eliminates missing f_midRequirement() dependency by inlining midpoint requirement logic
// - Corrects compression-score shadowing with reassignment operators
// - Preserves the existing execution, risk, alert, and telemetry architecture
// v3.4.0 RC — Execution-state orchestration upgrade
// Adds weighted readiness, deterministic wait-state telemetry, blocker persistence,
// dependency-aware scoring status, and operator-facing lifecycle diagnostics.
// Signal-generation, confirmation, execution, risk, alerts, and outcome logic are unchanged.
// v3.3.4 RC — Structural gate telemetry expansion
// Adds explicit WINDOW, MIDPOINT, COMPRESSION, VACUUM, and CONFIRM diagnostics.
// No entry, execution, risk, alert, or outcome logic changes.
// v3.3.0 RC — Direction gate decomposition and color-coded telemetry
// Separates directional candle body and close-location subconditions.
// Adds pass/fail coloring to midpoint distance and close-location values.
// Entry, execution, risk, alert, and outcome logic are unchanged.
// v3.2.9 RC — Gate telemetry instrumentation
// Adds numerical midpoint and direction diagnostics without changing entry logic.
// v3.2.8 RC — Confirmation-window and midpoint acceptance repair
// Changes:
// 1) Default post-displacement acceptance lifetime extended from 3 to 15 bars.
// 2) Midpoint acceptance supports strict close, rejection, or ATR-tolerant close.
// 3) Confirmation remains non-repainting and is evaluated only on confirmed bars.
// Execution, RR, target, risk, alerts, and outcome accounting are unchanged.

//=============================================================================
// PSRC CRT ENGINE v3.3.4 RC CONFIRMATION RESTORATION
// Canonical production release restored directly from the last verified working v2.9.1 engine.
// Signal-generation, confirmation, state-transition, execution, outcome and alert logic are unchanged.
// Production execution logic remains unchanged from v3.2.4.
// v3.2.5 adds stage-by-stage conversion analytics to isolate funnel attrition.
//
// Confirmed HTF ranges -> exact sweep/reclaim -> graded HTF bias ->
// internal MSS -> delayed/graded VWAP confirmation -> CRT/fixed-R targets ->
// hybrid zone execution -> structure-managed, risk-weighted outcomes.
//=============================================================================

//-----------------------------------------------------------------------------
// INPUT GROUPS
//-----------------------------------------------------------------------------
string GROUP_TF      = "1. Timeframes"
string GROUP_SESSION = "2. Sessions"
string GROUP_BIAS    = "3. HTF Bias and Grading"
string GROUP_SWEEP   = "4. CRT Sweep and Arming"
string GROUP_CONFIRM = "5. LTF Structure and Confirmation"
string GROUP_EXEC    = "6. Entry and Risk Projection"
string GROUP_OUTCOME = "7. Paper Outcome Tracking"
string GROUP_VIS     = "8. Visuals, Diagnostics and Alerts"

//-----------------------------------------------------------------------------
// TIMEFRAMES
//-----------------------------------------------------------------------------
bool showConfirmationDiagnostics = input.bool(true, "Show confirmation diagnostics", group="Diagnostics")
int diagnosticStateExpiryHours = input.int(24, "Diagnostic state expiry (hours)", minval=1, maxval=168, group="Diagnostics")

string rangeTf = input.timeframe("240", "Institutional range timeframe", group=GROUP_TF)
string macroTf = input.timeframe("1D", "Macro bias timeframe", group=GROUP_TF)
bool strictChartTf = input.bool(true, "Restrict chart to 5m or 15m", group=GROUP_TF)

//-----------------------------------------------------------------------------
// SESSIONS
//-----------------------------------------------------------------------------
bool useSessionFilter = input.bool(true, "Sweep must occur in session", group=GROUP_SESSION)
string sessionProfile = input.string(
     "Auto by asset",
     "Institutional session profile",
     options=["Auto by asset", "FX", "Gold", "US indices", "Energy", "CRT source windows", "Custom", "Always on"],
     group=GROUP_SESSION,
     tooltip="Auto selects a New York-time profile from the chart symbol. Custom uses the window below.")
string customSessionInput = input.string("0000-0100,1200-1400", "Custom session windows", group=GROUP_SESSION)
string sessionTimezone = input.string("America/New_York", "Session timezone", group=GROUP_SESSION)
string confirmationPolicy = input.string(
     "Grace after valid arm",
     "Confirmation policy",
     options=["Grace after valid arm", "Must remain in session"],
     group=GROUP_SESSION,
     tooltip="Recommended: arm the sweep inside the session, then allow confirmation after the window closes.")
int confirmationGraceBars = input.int(12, "Confirmation grace bars after arm", minval=1, maxval=100, group=GROUP_SESSION)

//-----------------------------------------------------------------------------
// HTF BIAS
//-----------------------------------------------------------------------------
string directionMode = input.string("Both", "Trade direction", options=["Both", "Long only", "Short only"], group=GROUP_BIAS)
string biasMode = input.string(
     "Graded 3-of-4",
     "Bias model",
     options=["Graded 3-of-4", "Strict 4-of-4", "No bias filter"],
     group=GROUP_BIAS,
     tooltip="With four filters enabled: 4/4 = Grade A, 3/4 = Grade B, below 3/4 = blocked.")
bool useDailyMidpoint = input.bool(true, "Macro close versus macro midpoint", group=GROUP_BIAS)
bool useDailyEma50 = input.bool(true, "Macro close versus EMA 50", group=GROUP_BIAS)
bool useRangeMidpoint = input.bool(true, "Range-TF close versus midpoint", group=GROUP_BIAS)
bool useRangeEmaStack = input.bool(true, "Range-TF EMA 20 versus EMA 200", group=GROUP_BIAS)
string deploymentMode = input.string("Research", "Deployment mode", options=["Research", "Live"], group=GROUP_BIAS,
     tooltip="Research shows all setup diagnostics. Live retains execution signals, levels, dashboard and alerts.")
string executionGatePolicy = input.string(
     "Restored production",
     "Execution gate policy",
     options=["Restored production", "Strict institutional"],
     group=GROUP_BIAS,
     tooltip="Restored production prevents the post-confirmation quality stack from vetoing an already-confirmed setup a second time. Strict institutional retains every profile, location, hierarchy and index-extension veto.")
bool strictExecutionGate = executionGatePolicy == "Strict institutional"
bool useQualityScoreGate = input.bool(true, "Use institutional quality-score gate", group=GROUP_BIAS)
int minimumQualityScore = input.int(7, "Minimum general quality score", minval=1, maxval=10, group=GROUP_BIAS)
int eurUsdMinimumScore = input.int(8, "EURUSD minimum score", minval=1, maxval=10, group=GROUP_BIAS)
int goldMinimumScore = input.int(6, "Gold minimum score", minval=1, maxval=10, group=GROUP_BIAS)
int usIndexMinimumScore = input.int(7, "US-index minimum score", minval=1, maxval=10, group=GROUP_BIAS)
bool eurUsdDailySweepOnly = input.bool(true, "EURUSD requires Daily sweep", group=GROUP_BIAS)
bool restrictFixedRToHighQuality = input.bool(true, "Fixed-R requires Daily sweep or score >= 8", group=GROUP_BIAS)
bool requireAcceptance = input.bool(true, "Require post-displacement acceptance", group=GROUP_BIAS,
     tooltip="Confirmation must occur after the displacement candle and hold beyond its body midpoint.")
int acceptanceGraceBars = input.int(15, "Acceptance window after displacement", minval=1, maxval=50, group=GROUP_BIAS,
     tooltip="Bars allowed for post-displacement confirmation. Default 15 prevents valid institutional retests from expiring prematurely.")
string midpointAcceptanceMode = input.string(
     "ATR-tolerant close",
     "Displacement midpoint acceptance",
     options=["Strict close", "Rejection or close", "ATR-tolerant close"],
     group=GROUP_BIAS,
     tooltip="Strict close requires a close beyond the body midpoint. Rejection accepts a midpoint test followed by a directional close. ATR-tolerant close permits a small ATR-based shortfall.")
float midpointToleranceAtr = input.float(0.10, "Midpoint tolerance (ATR)", minval=0.0, maxval=0.50, step=0.01, group=GROUP_BIAS)
bool requireDisplacementPersistence = input.bool(true, "Require displacement persistence", group=GROUP_BIAS,
     tooltip="Acceptance must preserve the displacement thesis at candle close; wick retests are allowed.")
bool useLiquidityVacuumFilter = input.bool(true, "Use liquidity-vacuum filter", group=GROUP_BIAS)
float vacuumBodyAtrMin = input.float(0.40, "Vacuum minimum body / ATR", minval=0.10, step=0.05, group=GROUP_BIAS)
float vacuumVolumeMultiplier = input.float(1.25, "Vacuum minimum volume / average", minval=0.50, step=0.05, group=GROUP_BIAS)
bool useSessionWeightedConfidence = input.bool(true, "Weight confidence by active session", group=GROUP_BIAS)
float primeSessionWeight = input.float(1.10, "Prime-session confidence multiplier", minval=0.50, maxval=1.50, step=0.05, group=GROUP_BIAS)
float offSessionWeight = input.float(0.80, "Off-session confidence multiplier", minval=0.50, maxval=1.20, step=0.05, group=GROUP_BIAS)
bool useAdaptiveFixedR = input.bool(true, "Use confidence-adaptive Fixed-R targets", group=GROUP_BIAS)
bool useDisplacementScoreGate = input.bool(true, "Use weighted displacement score", group=GROUP_BIAS)
float minimumDisplacementScore = input.float(70.0, "Minimum displacement score", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
bool requireDirectionalAcceptance = input.bool(true, "Acceptance candle must confirm direction", group=GROUP_BIAS)
bool useEntryReadinessIndex = input.bool(true, "Use Entry Readiness Index (ERI)", group=GROUP_BIAS)
float minimumEri = input.float(75.0, "Minimum ERI for standard entry", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float fixedREriMinimum = input.float(85.0, "Minimum ERI for Fixed-R targets", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
bool useCompressionQualification = input.bool(true, "Require post-displacement compression", group=GROUP_BIAS)
int compressionBars = input.int(2, "Minimum compression bars", minval=1, maxval=8, group=GROUP_BIAS)
int compressionLookback = input.int(3, "Compression range lookback", minval=2, maxval=10, group=GROUP_BIAS)
float maxCompressionToDisplacement = input.float(0.75, "Maximum compression / displacement range", minval=0.20, maxval=1.50, step=0.05, group=GROUP_BIAS)
float maxCompressionAtr = input.float(0.90, "Maximum compression range / ATR", minval=0.20, maxval=2.00, step=0.05, group=GROUP_BIAS)
bool requireCompressionBreakout = input.bool(true, "Require breakout from compression", group=GROUP_BIAS)
bool usePremiumDiscountFilter = input.bool(true, "Require premium/discount entry location", group=GROUP_BIAS)
float discountToleranceAtr = input.float(0.10, "Premium/discount tolerance (ATR)", minval=0.0, maxval=1.0, step=0.05, group=GROUP_BIAS)
bool useAdaptiveRegimeEri = input.bool(true, "Adapt ERI threshold to market regime", group=GROUP_BIAS)
float trendingEriMinimum = input.float(72.0, "Trending-market minimum ERI", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float rangingEriMinimum = input.float(88.0, "Ranging-market minimum ERI", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float trendStrengthAtr = input.float(0.35, "Minimum EMA separation / ATR for trend", minval=0.05, maxval=2.0, step=0.05, group=GROUP_BIAS)
bool useCompressionScore = input.bool(true, "Use weighted compression score", group=GROUP_BIAS)
float minimumCompressionScore = input.float(55.0, "Minimum compression score", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
bool useLocationScore = input.bool(true, "Use weighted premium/discount score", group=GROUP_BIAS)
float minimumLocationScore = input.float(55.0, "Minimum location score", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
bool useSweepAdaptiveEri = input.bool(true, "Adapt ERI threshold by sweep source", group=GROUP_BIAS)
float dailySweepEriMinimum = input.float(72.0, "Daily-sweep minimum ERI", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float rangeSweepEriMinimum = input.float(82.0, "Range-TF sweep minimum ERI", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)

bool useUnifiedConfidenceModel = input.bool(true, "Use unified probabilistic confidence model", group=GROUP_BIAS)
float minimumUnifiedConfidence = input.float(80.0, "Minimum unified confidence", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float fixedRUnifiedConfidence = input.float(88.0, "Minimum unified confidence for Fixed-R", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)

float weightBias = input.float(20.0, "Weight: HTF bias", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float weightSweep = input.float(15.0, "Weight: sweep quality", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float weightDisplacement = input.float(20.0, "Weight: displacement", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float weightCompression = input.float(15.0, "Weight: compression", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float weightLocation = input.float(10.0, "Weight: premium/discount", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float weightAcceptance = input.float(10.0, "Weight: acceptance", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float weightVwap = input.float(5.0, "Weight: VWAP", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)
float weightVolume = input.float(5.0, "Weight: volume", minval=0.0, maxval=100.0, step=1.0, group=GROUP_BIAS)

float goldConfidencePremium = input.float(3.0, "Gold confidence premium", minval=0.0, maxval=20.0, step=0.5, group=GROUP_BIAS,
     tooltip="Extra confidence required for Gold to suppress wick-driven false positives.")
float eurUsdConfidencePremium = input.float(4.0, "EURUSD confidence premium", minval=0.0, maxval=20.0, step=0.5, group=GROUP_BIAS,
     tooltip="Extra confidence required for EURUSD to suppress balance-market signals.")

bool useHierarchicalExecutionGate = input.bool(true, "Use mandatory hierarchical execution gate", group=GROUP_BIAS,
     tooltip="Requires bias, valid liquidity sweep, displacement, acceptance, compression and location in sequence. Weighted confidence cannot rescue a failed mandatory stage.")
bool requireBiasStage = input.bool(true, "Gate 1: require directional HTF bias", group=GROUP_BIAS)
bool requireSweepStage = input.bool(true, "Gate 2: require valid sweep depth", group=GROUP_BIAS)
bool requireDisplacementStage = input.bool(true, "Gate 3: require qualified displacement", group=GROUP_BIAS)
bool requireAcceptanceStage = input.bool(true, "Gate 4: require acceptance", group=GROUP_BIAS)
bool requireCompressionStage = input.bool(true, "Gate 5: require compression", group=GROUP_BIAS)
bool requireLocationStage = input.bool(true, "Gate 6: require premium/discount location", group=GROUP_BIAS)

float goldMinimumDisplacementAtr = input.float(0.80, "Gold minimum displacement body / ATR", minval=0.10, maxval=3.0, step=0.05, group=GROUP_BIAS)
float goldMinimumSweepAtr = input.float(0.15, "Gold minimum sweep depth / ATR", minval=0.01, maxval=2.0, step=0.01, group=GROUP_BIAS)
bool eurUsdRequireTwoAcceptanceCloses = input.bool(true, "EURUSD requires two acceptance closes", group=GROUP_BIAS)
bool eurUsdRejectInternalRangeDisplacement = input.bool(true, "EURUSD rejects displacement fully inside Range-TF range", group=GROUP_BIAS)
float indexMaximumExtensionAtr = input.float(2.50, "US-index maximum extension from sweep (ATR)", minval=0.50, maxval=10.0, step=0.25, group=GROUP_BIAS)

bool requireProtectedMssGate = input.bool(true, "Gate 4: require protected-structure MSS", group=GROUP_BIAS,
     tooltip="The displacement close must break the latest confirmed protected swing in the trade direction. This gate sits between displacement and acceptance.")
bool useInternalBreakFallback = input.bool(true, "Allow armed internal-break fallback when pivot is unavailable", group=GROUP_BIAS)
float mssCloseBufferAtr = input.float(0.02, "MSS close buffer (ATR)", minval=0.0, maxval=0.50, step=0.01, group=GROUP_BIAS)

bool goldRequireRangeExtremeBreak = input.bool(true, "Gold requires displacement beyond Range-TF opposite extreme", group=GROUP_BIAS,
     tooltip="Bullish Gold displacement must close above the active Range-TF high; bearish displacement must close below the active Range-TF low.")
float goldRangeBreakBufferAtr = input.float(0.02, "Gold range-extreme break buffer (ATR)", minval=0.0, maxval=0.50, step=0.01, group=GROUP_BIAS)

bool useFirstReturnExecution = input.bool(true, "Use first-return continuation execution", group=GROUP_BIAS,
     tooltip="After the full CRT hierarchy passes, wait for the first retracement into the planned origin entry, then require a directional continuation candle before issuing BUY/SELL.")
int firstReturnExpiryBars = input.int(12, "First-return expiry bars", minval=1, maxval=50, group=GROUP_BIAS)
int continuationExpiryBars = input.int(4, "Continuation confirmation expiry bars", minval=1, maxval=12, group=GROUP_BIAS)
bool continuationBreakPriorBar = input.bool(true, "Continuation must break prior candle", group=GROUP_BIAS)
float continuationBodyAtrMin = input.float(0.10, "Continuation minimum body / ATR", minval=0.0, maxval=1.0, step=0.05, group=GROUP_BIAS)
bool useActualContinuationClose = input.bool(true, "Use continuation close as alert entry", group=GROUP_BIAS,
     tooltip="Live-safe mode. The alert entry is the confirmed continuation close rather than a retroactive limit fill.")

bool useContinuationQualityGate = input.bool(true, "Use continuation quality gate", group=GROUP_BIAS)
float continuationMinBodyPct = input.float(60.0, "Continuation minimum body % of range", minval=0.0, maxval=100.0, step=5.0, group=GROUP_BIAS)
