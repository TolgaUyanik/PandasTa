//@version=6
library("SMC_Imbalance", overlay=true)

// @function Fair Value Gap (FVG) の検出
// @param high2 2本前の高値
// @param low0 現在の安値
// @param low2 2本前の安値
// @param high0 現在の高値
// @param is_bull 強気FVGの判定か
// @returns [bool, float] FVGの有無と、ギャップのサイズ
export detect_fvg(float high2, float low0, float low2, float high0, bool is_bull) =>
    bool is_fvg = false
    float gap_size = 0.0
    
    if is_bull
        if not na(high2) and not na(low0) and low0 > high2
            is_fvg := true
            gap_size := low0 - high2
    else
        if not na(low2) and not na(high0) and high0 < low2
            is_fvg := true
            gap_size := low2 - high0
            
    [is_fvg, gap_size]