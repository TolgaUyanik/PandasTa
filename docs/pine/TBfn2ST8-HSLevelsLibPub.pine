// ═══════════════════════════════════════════════════════════════════════════════
// VIX THRESHOLDS - Used by: HS Plotter, Volatility Radar
// ═══════════════════════════════════════════════════════════════════════════════
// @function Returns VIX threshold levels for regime determination
// @returns [bearish, bearishChop, bullishChop, bullish] as tuple of floats
export getVIXThresholds() =>
    // ┌────────────────────────────────────────────────────────────────────┐
    // │  UPDATE THESE VALUES DAILY                                         │
    // │  Format: [Bearish, BearishChop, BullishChop, Bullish]             │
    // └────────────────────────────────────────────────────────────────────┘
    float bearish     = 15.96
    float bearishChop = 15.74
    float bullishChop = 14.78
    float bullish     = 14.49    
    
    [bearish, bearishChop, bullishChop, bullish]

// Helper to get VIX as CSV strings for scripts that need that format
// @function Returns VIX thresholds as CSV strings
// @returns [pricesCSV, labelsCSV] as tuple of strings
export getVIXThresholdsCSV() =>
    [bearish, bearishChop, bullishChop, bullish] = getVIXThresholds()
    string prices = str.tostring(bearish) + "," + str.tostring(bearishChop) + "," + str.tostring(bullishChop) + "," + str.tostring(bullish)
    string labels = "Bearish,Bearish Chop,Bullish Chop,Bullish"
    [prices, labels]

// ═══════════════════════════════════════════════════════════════════════════════
// EXPIRY DATE - Used by: Trend Duel, Options Chain Table
// ═══════════════════════════════════════════════════════════════════════════════
// @function Returns current options expiry date in YYMMDD format
// @returns string in YYMMDD format (e.g., "260108" for Jan 8, 2026)
export getExpiry() =>
    // ┌────────────────────────────────────────────────────────────────────┐
    // │  UPDATE THIS VALUE DAILY (or for target expiry)                   │
    // │  Format: YYMMDD                                                    │
    // └────────────────────────────────────────────────────────────────────┘
    "260109"  // January 9, 2026

// ═══════════════════════════════════════════════════════════════════════════════
// ANCHOR STRIKES - Used by: Trend Duel, Options Chain Table
// ═══════════════════════════════════════════════════════════════════════════════
// @function Returns the anchor strike price for a given symbol
// @param symbol The ticker symbol (SPY, QQQ, SPX, VIX)
// @returns float anchor strike price
export getAnchorStrike(simple string symbol) =>
    // ┌────────────────────────────────────────────────────────────────────┐
    // │  UPDATE THESE VALUES DAILY                                         │
    // │  Set to current ATM strike for each symbol                        │
    // └────────────────────────────────────────────────────────────────────┘
    float result = switch symbol
        "SPY"  => 692
        "QQQ"  => 623
        "SPX"  => 6920
        "SPXW" => 6920
        "VIX"  => 15
        => 0.0
    result    

// ═══════════════════════════════════════════════════════════════════════════════
// FRACTAL LEVELS - Used by: HS Plotter F2
// ═══════════════════════════════════════════════════════════════════════════════
// @function Returns fractal level prices as CSV for a symbol
// @param symbol The ticker symbol (SPY, QQQ, SPX)
// @returns string of comma-separated prices
export getFractalPrices(simple string symbol) =>
    // ┌────────────────────────────────────────────────────────────────────┐
    // │  UPDATE THESE VALUES DAILY                                         │
    // │  Order should match labels: IV Peak, PDH, Pivot, PDL, etc.        │
    // └────────────────────────────────────────────────────────────────────┘
    string result = switch symbol
        "SPY"  => "595.50,598.25,593.00,590.75,592.50,600.00,588.00,602.00"
        "QQQ"  => "520.25,518.50,515.00,512.75,525.00"
        "SPX"  => "5955,5982,5930,5908,5925,6000"
        "SPXW" => "5955,5982,5930,5908,5925,6000"
        => ""
    result

// @function Returns fractal level labels as CSV for a symbol
// @param symbol The ticker symbol (SPY, QQQ, SPX)
// @returns string of comma-separated labels
export getFractalLabels(simple string symbol) =>
    // Labels must match the order of prices above
    string result = switch symbol
        "SPY"   => "692.82,686.89,685.34,690.68,681.80,674.29,694.56"
        "QQQ"   => "632.34,626.47,616.69,614.86,626,614.35,604.54,627.79"
        "SPX"   => "6900.67,6897.05,6849.07,6827.69"
        "SPXW" => "6900.67,6897.05,6849.07,6827.69"
        => ""
    result

// @function Returns both fractal prices and labels as CSV tuple
// @param symbol The ticker symbol
// @returns [pricesCSV, labelsCSV] tuple
export getFractalLevels(simple string symbol) =>
    [getFractalPrices(symbol), getFractalLabels(symbol)]

// ═══════════════════════════════════════════════════════════════════════════════
// CONVENIENCE FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// @function Auto-detect symbol and return appropriate anchor strike
// @returns float anchor strike for current chart symbol
export getAnchorStrikeAuto() =>
    string sym = syminfo.ticker
    if syminfo.root == "SPX" or sym == "SPX"
        sym := "SPXW"
    getAnchorStrike(sym)

// @function Auto-detect symbol and return fractal levels
// @returns [pricesCSV, labelsCSV] for current chart symbol
export getFractalLevelsAuto() =>
    string sym = syminfo.ticker
    if syminfo.root == "SPX" or sym == "SPX"
        sym := "SPXW"
    getFractalLevels(sym)

// @function Get all data for a symbol in one call
// @param symbol The ticker symbol
// @returns [fractalPrices, fractalLabels, anchorStrike, expiry]
export getAllData(simple string symbol) =>
    [prices, labels] = getFractalLevels(symbol)
    float anchor = getAnchorStrike(symbol)
    string exp = getExpiry()
    [prices, labels, anchor, exp]

// ═══════════════════════════════════════════════════════════════════════════════
// LIBRARY VERSION INFO
// ═══════════════════════════════════════════════════════════════════════════════
// @function Returns library version and last update timestamp
// @returns string with version info
export getVersion() =>
    "HSLevelsLibrary v1.0 | Updated: 2026-01-08"
