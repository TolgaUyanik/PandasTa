//@version=5
library("SMB_Library", overlay=true)

// [수출 1] 스퀴즈 상태 판별
export f_is_squeeze(float upperBB, float lowerBB, float upperKC, float lowerKC) =>
    (lowerBB > lowerKC) and (upperBB < upperKC)

// [수출 2] 모멘텀 단계별 색상 반환 (시각화의 핵심!)
export f_mom_color(float mom_val) =>
    float prev = mom_val[1]
    color res_col = color.new(color.gray, 90) // 기본값 (회색)
    if mom_val > 0
        // 가속 상승(진한 녹색), 감속 상승(연한 녹색)
        res_col := mom_val > prev ? color.new(#00ff08, 70) : color.new(#00ff08, 90)
    else
        // 가속 하락(진한 빨간색), 감속 하락(연한 빨간색)
        res_col := mom_val < prev ? color.new(#ff0000, 70) : color.new(#ff0000, 90)
    res_col