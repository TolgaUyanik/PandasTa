// @version=5
indicator("Sessions 13-Zones (UTC Based)", overlay=true, max_boxes_count=500)

// === Algemene instellingen ===
range_transp = input.int(85, "Transparantie van sessiegebied", minval=0, maxval=100)
use_exchange = input.bool(false, "Gebruik Exchange tijdzone")
tz_offset = input.int(0, "UTC Offset")
tz = use_exchange ? syminfo.timezone : str.format("UTC{0}{1}", tz_offset >= 0 ? "+" : "-", str.tostring(math.abs(tz_offset)))

// === Sessie instellingen A t/m M ===
showA = input.bool(true, "", inline="sA", group="Session A")
labelA = input.string("Session A", "", inline="sA", group="Session A")
timeA = input.session("0000-0100", "", inline="sA", group="Session A")
colorA = input.color(color.red, "", inline="sA", group="Session A")

showB = input.bool(true, "", inline="sB", group="Session B")
labelB = input.string("Session B", "", inline="sB", group="Session B")
timeB = input.session("0100-0200", "", inline="sB", group="Session B")
colorB = input.color(color.blue, "", inline="sB", group="Session B")

showC = input.bool(true, "", inline="sC", group="Session C")
labelC = input.string("Session C", "", inline="sC", group="Session C")
timeC = input.session("0200-0300", "", inline="sC", group="Session C")
colorC = input.color(color.yellow, "", inline="sC", group="Session C")

showD = input.bool(true, "", inline="sD", group="Session D")
labelD = input.string("Session D", "", inline="sD", group="Session D")
timeD = input.session("0300-0400", "", inline="sD", group="Session D")
colorD = input.color(color.red, "", inline="sD", group="Session D")

showE = input.bool(true, "", inline="sE", group="Session E")
labelE = input.string("Session E", "", inline="sE", group="Session E")
timeE = input.session("0400-0500", "", inline="sE", group="Session E")
colorE = input.color(color.blue, "", inline="sE", group="Session E")

showF = input.bool(true, "", inline="sF", group="Session F")
labelF = input.string("Session F", "", inline="sF", group="Session F")
timeF = input.session("0500-0600", "", inline="sF", group="Session F")
colorF = input.color(color.yellow, "", inline="sF", group="Session F")

showG = input.bool(true, "", inline="sG", group="Session G")
labelG = input.string("Session G", "", inline="sG", group="Session G")
timeG = input.session("0600-0700", "", inline="sG", group="Session G")
colorG = input.color(color.red, "", inline="sG", group="Session G")

showH = input.bool(true, "", inline="sH", group="Session H")
labelH = input.string("Session H", "", inline="sH", group="Session H")
timeH = input.session("0700-0800", "", inline="sH", group="Session H")
colorH = input.color(color.blue, "", inline="sH", group="Session H")

showI = input.bool(true, "", inline="sI", group="Session I")
labelI = input.string("Session I", "", inline="sI", group="Session I")
timeI = input.session("0800-0900", "", inline="sI", group="Session I")
colorI = input.color(color.yellow, "", inline="sI", group="Session I")

showJ = input.bool(true, "", inline="sJ", group="Session J")
labelJ = input.string("Session J", "", inline="sJ", group="Session J")
timeJ = input.session("0900-1000", "", inline="sJ", group="Session J")
colorJ = input.color(color.red, "", inline="sJ", group="Session J")

showK = input.bool(true, "", inline="sK", group="Session K")
labelK = input.string("Session K", "", inline="sK", group="Session K")
timeK = input.session("1000-1100", "", inline="sK", group="Session K")
colorK = input.color(color.blue, "", inline="sK", group="Session K")

showL = input.bool(true, "", inline="sL", group="Session L")
labelL = input.string("Session L", "", inline="sL", group="Session L")
timeL = input.session("1100-1200", "", inline="sL", group="Session L")
colorL = input.color(color.yellow, "", inline="sL", group="Session L")

showM = input.bool(true, "", inline="sM", group="Session M")
labelM = input.string("Session M", "", inline="sM", group="Session M")
timeM = input.session("1200-1300", "", inline="sM", group="Session M")
colorM = input.color(color.red, "", inline="sM", group="Session M")

// === Teken sessie ===
draw_session(active, sess_time, sess_color) =>
    sess_actief = active and not na(time(timeframe.period, sess_time, tz))
    var box b = na
    var float hi = na
    var float lo = na
    if sess_actief and not sess_actief[1]
        hi := high
        lo := low
        b := box.new(bar_index, hi, bar_index, lo, bgcolor=color.new(sess_color, range_transp), border_color=sess_color)
    if sess_actief and sess_actief[1]
        hi := math.max(hi, high)
        lo := math.min(lo, low)
        box.set_rightbottom(b, bar_index, lo)
        box.set_top(b, hi)

// === Teken alle sessies ===
draw_session(showA, timeA, colorA)
draw_session(showB, timeB, colorB)
draw_session(showC, timeC, colorC)
draw_session(showD, timeD, colorD)
draw_session(showE, timeE, colorE)
draw_session(showF, timeF, colorF)
draw_session(showG, timeG, colorG)
draw_session(showH, timeH, colorH)
draw_session(showI, timeI, colorI)
draw_session(showJ, timeJ, colorJ)
draw_session(showK, timeK, colorK)
draw_session(showL, timeL, colorL)
draw_session(showM, timeM, colorM)