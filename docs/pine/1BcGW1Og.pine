//@version=6
indicator("S/R Force Matrix", overlay=true, 
          max_labels_count=200,
          shorttitle="S/R Force Matrix")

// ============================================================
// MODULE 1: Input Parameters
// ============================================================
maxSwingPoints = input.int(20, "Max Swing Points", minval=5, maxval=50)
showLabels = input.bool(true, "Show Labels")
showTable = input.bool(true, "Show Table")

powerThreshold = input.float(1.0, "⚡ Power Threshold", minval=0.3, maxval=3.0, step=0.1)
lookbackRange = input.int(50, "📏 Lookback Range", minval=10, maxval=200)

tablePosition = input.string("top_right", "Table Position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"])
tableScale = input.float(1.0, "Table Scale", minval=0.5, maxval=2.0, step=0.1)
tableBgOpacity = input.int(92, "Table Opacity", minval=50, maxval=100, step=1)

autoBars = math.round(ta.atr(14) / ta.sma(ta.tr, 50) * 5)
autoBars := math.max(3, math.min(10, autoBars))

// ============================================================
// MODULE 2: Auto-Detect Timeframe Multiplier
// ============================================================
getTimeFrameMultiplier() =>
    tf = timeframe.period
    if tf == "1"
        0.05
    else if tf == "5"
        0.10
    else if tf == "15"
        0.20
    else if tf == "30"
        0.35
    else if tf == "60" or tf == "1H"
        0.60
    else if tf == "120" or tf == "2H"
        0.70
    else if tf == "180" or tf == "3H"
        0.75
    else if tf == "240" or tf == "4H"
        0.85
    else if tf == "D" or tf == "1D"
        1.00
    else if tf == "W" or tf == "1W"
        1.20
    else if tf == "M" or tf == "1M"
        1.50
    else
        0.50

tfMultiplier = getTimeFrameMultiplier()

// ============================================================
// MODULE 3: Get Readable Timeframe
// ============================================================
getReadableTimeframe() =>
    tf = timeframe.period
    if tf == "1"
        "1m"
    else if tf == "5"
        "5m"
    else if tf == "15"
        "15m"
    else if tf == "30"
        "30m"
    else if tf == "45"
        "45m"
    else if tf == "60" or tf == "1H"
        "1h"
    else if tf == "120" or tf == "2H"
        "2h"
    else if tf == "180" or tf == "3H"
        "3h"
    else if tf == "240" or tf == "4H"
        "4h"
    else if tf == "D" or tf == "1D"
        "1d"
    else if tf == "W" or tf == "1W"
        "1w"
    else if tf == "M" or tf == "1M"
        "1M"
    else
        tf

// ============================================================
// MODULE 4: Core - Calculate Historical Power
// ============================================================
calcHistoricalPower(price, swingIdx) =>
    barsAgo = bar_index - swingIdx
    if barsAgo < 0
        barsAgo := 0
    
    atrAtIdx = ta.atr(14)[barsAgo]
    if na(atrAtIdx) or atrAtIdx <= 0
        atrAtIdx := ta.atr(14)
    
    volAtIdx = volume[barsAgo]
    if na(volAtIdx) or volAtIdx <= 0
        volAtIdx := volume
    
    avgVolAtIdx = ta.sma(volume, 20)[barsAgo]
    if na(avgVolAtIdx) or avgVolAtIdx <= 0
        avgVolAtIdx := ta.sma(volume, 20)
    
    volMultiple = avgVolAtIdx > 0 ? volAtIdx / avgVolAtIdx : 1
    volMultiple := math.min(volMultiple, 5)
    
    priceShock = atrAtIdx > 0 ? (price / atrAtIdx) * tfMultiplier : 1
    priceShock := math.min(priceShock, 10)
    
    distanceFromCurrent = bar_index - swingIdx
    weight = distanceFromCurrent <= lookbackRange ? 1.0 : 0.5
    
    rawPower = priceShock * volMultiple * weight
    rawPower := math.min(rawPower, 20)
    
    rawPower

// ============================================================
// MODULE 5: Candle Pressure
// ============================================================
totalRange = high - low + 0.0001
buyPressure = (close - low) / totalRange * 100
sellPressure = (high - close) / totalRange * 100
pressureBalance = buyPressure - sellPressure

pressureStatus = ""
pressureColor = color.white
if pressureBalance > 60
    pressureStatus := "🟢 Strong Buy"
    pressureColor := color.rgb(0,255,0)
else if pressureBalance > 30
    pressureStatus := "📈 Buying"
    pressureColor := color.rgb(100,255,100)
else if pressureBalance > 10
    pressureStatus := "📈 Weak Buy"
    pressureColor := color.rgb(150,255,150)
else if pressureBalance > -10
    pressureStatus := "➡️ Balanced"
    pressureColor := color.rgb(200,200,200)
else if pressureBalance > -30
    pressureStatus := "📉 Weak Sell"
    pressureColor := color.rgb(255,200,150)
else if pressureBalance > -60
    pressureStatus := "📉 Selling"
    pressureColor := color.rgb(255,150,100)
else
    pressureStatus := "🔴 Strong Sell"
    pressureColor := color.rgb(255,0,0)

// ============================================================
// MODULE 6: Swing Detection + Data Storage
// ============================================================
swingHigh = ta.pivothigh(autoBars, autoBars)
swingLow = ta.pivotlow(autoBars, autoBars)

var float[] resistancePrices = array.new_float()
var int[] resistanceIndices = array.new_int()
var float[] resistancePower = array.new_float()
var int[] resistanceCount = array.new_int()
var float[] resistanceWeight = array.new_float()

var float[] supportPrices = array.new_float()
var int[] supportIndices = array.new_int()
var float[] supportPower = array.new_float()
var int[] supportCount = array.new_int()
var float[] supportWeight = array.new_float()

var label[] resistanceLabels = array.new_label()
var label[] supportLabels = array.new_label()

var string[] tableLabels = array.new_string()
var string[] tableValues = array.new_string()
var color[] tableLabelColors = array.new_color()
var color[] tableValueColors = array.new_color()

// ============================================================
// MODULE 7: Create Table (2 Column)
// ============================================================
var table infoTable = na
if barstate.isfirst
    if tablePosition == "top_left"
        infoTable := table.new(position.top_left, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "top_center"
        infoTable := table.new(position.top_center, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "top_right"
        infoTable := table.new(position.top_right, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "middle_left"
        infoTable := table.new(position.middle_left, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "middle_center"
        infoTable := table.new(position.middle_center, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "middle_right"
        infoTable := table.new(position.middle_right, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "bottom_left"
        infoTable := table.new(position.bottom_left, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "bottom_center"
        infoTable := table.new(position.bottom_center, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))
    else if tablePosition == "bottom_right"
        infoTable := table.new(position.bottom_right, 2, 10,
                               bgcolor=color.rgb(10,10,30, tableBgOpacity),
                               border_color=color.rgb(80,80,150, 50),
                               frame_color=color.rgb(50,50,120, 70))

/// ============================================================
// MODULE 8: Auto Test Detection (Relaxed)
// ============================================================
calculateResistanceBehavior(price, swingIdx) =>
    cnt = 0
    weightScore = 0.0
    lastTouchBar = 0
    
    for i = 1 to 50
        if not na(high[i]) and not na(low[i])
            upper = price * 1.003
            lower = price * 0.997
            
            isTouched = false
            if (high[i] >= lower and high[i] <= upper) or (low[i] >= lower and low[i] <= upper) or (close[i] >= lower and close[i] <= upper)
                isTouched := true
            
            if isTouched and i - lastTouchBar >= 2
                cnt := cnt + 1
                lastTouchBar := i
                timeWeight = 1.0 - (i / 50) * 0.5
                weightScore := weightScore + timeWeight
    
    if cnt > 5
        cnt := 5
    
    avgWeight = cnt > 0 ? weightScore / cnt : 0
    
    countFactor = 0.3
    if cnt >= 5
        countFactor := 1.5
    else if cnt >= 3
        countFactor := 1.0
    else if cnt >= 2
        countFactor := 0.6
    
    finalScore = cnt * avgWeight * countFactor
    if finalScore > 5.0
        finalScore := 5.0
    
    [cnt, finalScore]

calculateSupportBehavior(price, swingIdx) =>
    cnt = 0
    weightScore = 0.0
    lastTouchBar = 0
    
    for i = 1 to 50
        if not na(high[i]) and not na(low[i])
            upper = price * 1.003
            lower = price * 0.997
            
            isTouched = false
            if (high[i] >= lower and high[i] <= upper) or (low[i] >= lower and low[i] <= upper) or (close[i] >= lower and close[i] <= upper)
                isTouched := true
            
            if isTouched and i - lastTouchBar >= 2
                cnt := cnt + 1
                lastTouchBar := i
                timeWeight = 1.0 - (i / 50) * 0.5
                weightScore := weightScore + timeWeight
    
    if cnt > 5
        cnt := 5
    
    avgWeight = cnt > 0 ? weightScore / cnt : 0
    
    countFactor = 0.3
    if cnt >= 5
        countFactor := 1.5
    else if cnt >= 3
        countFactor := 1.0
    else if cnt >= 2
        countFactor := 0.6
    
    finalScore = cnt * avgWeight * countFactor
    if finalScore > 5.0
        finalScore := 5.0
    
    [cnt, finalScore]

// ----- Process Resistance -----
if not na(swingHigh)
    idx = bar_index[autoBars]
    power = calcHistoricalPower(swingHigh, idx)
    [cnt, weightScore] = calculateResistanceBehavior(swingHigh, idx)
    
    array.push(resistancePrices, swingHigh)
    array.push(resistanceIndices, idx)
    array.push(resistancePower, power)
    array.push(resistanceCount, cnt)
    array.push(resistanceWeight, weightScore)
    
    if array.size(resistancePrices) > maxSwingPoints
        array.remove(resistancePrices, 0)
        array.remove(resistanceIndices, 0)
        array.remove(resistancePower, 0)
        array.remove(resistanceCount, 0)
        array.remove(resistanceWeight, 0)

// ----- Process Support -----
if not na(swingLow)
    idx = bar_index[autoBars]
    power = calcHistoricalPower(swingLow, idx)
    [cnt, weightScore] = calculateSupportBehavior(swingLow, idx)
    
    array.push(supportPrices, swingLow)
    array.push(supportIndices, idx)
    array.push(supportPower, power)
    array.push(supportCount, cnt)
    array.push(supportWeight, weightScore)
    
    if array.size(supportPrices) > maxSwingPoints
        array.remove(supportPrices, 0)
        array.remove(supportIndices, 0)
        array.remove(supportPower, 0)
        array.remove(supportCount, 0)
        array.remove(supportWeight, 0)

// ============================================================
// MODULE 9: Clean Up Old Labels
// ============================================================
if array.size(resistanceLabels) > 0
    for i = 0 to array.size(resistanceLabels) - 1
        lbl = array.get(resistanceLabels, i)
        if not na(lbl)
            label.delete(lbl)
array.clear(resistanceLabels)

if array.size(supportLabels) > 0
    for i = 0 to array.size(supportLabels) - 1
        lbl = array.get(supportLabels, i)
        if not na(lbl)
            label.delete(lbl)
array.clear(supportLabels)

// ============================================================
// MODULE 10: Draw S/R Labels
// ============================================================
if showLabels
    for i = 0 to array.size(resistancePrices) - 1
        idx = array.get(resistanceIndices, i)
        val = array.get(resistancePrices, i)
        power = array.get(resistancePower, i)
        cnt = array.get(resistanceCount, i)
        
        if not na(power) and power >= powerThreshold and not na(idx) and not na(val)
            distPercent = (val - close) / close * 100
            
            distLevel = ""
            if distPercent < 0.5
                distLevel := "Immediate"
            else if distPercent < 1.5
                distLevel := "Short-Term"
            else if distPercent < 3.0
                distLevel := "Medium-Term"
            else
                distLevel := "Long-Term"
            
            powerLabel = ""
            if power >= 5.0
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Extreme)"
            else if power >= 3.0
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Strong)"
            else if power >= 2.0
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Moderate)"
            else if power >= 1.5
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Mild)"
            else
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Weak)"
            
            behaviorDisplay = ""
            if cnt >= 5
                behaviorDisplay := "✅ Strongly Validated"
            else if cnt >= 3
                behaviorDisplay := "✅ Validated"
            else if cnt >= 2
                behaviorDisplay := "⏳ Initial Test"
            else
                behaviorDisplay := "🆕 Untested"
            
            lbl = label.new(
                x=idx, y=val,
                text="🔴 R (" + str.tostring(val, "#.##") + ")\n" + distLevel + " ↑ " + str.tostring(distPercent, "#.##") + "%\n" + powerLabel + "\n" + behaviorDisplay,
                color=color.new(color.red, 85),
                textcolor=color.white,
                style=label.style_label_down,
                size=size.small,
                textalign=text.align_center
            )
            array.push(resistanceLabels, lbl)
    
    for i = 0 to array.size(supportPrices) - 1
        idx = array.get(supportIndices, i)
        val = array.get(supportPrices, i)
        power = array.get(supportPower, i)
        cnt = array.get(supportCount, i)
        
        if not na(power) and power >= powerThreshold and not na(idx) and not na(val)
            distPercent = (close - val) / close * 100
            
            distLevel = ""
            if distPercent < 0.5
                distLevel := "Immediate"
            else if distPercent < 1.5
                distLevel := "Short-Term"
            else if distPercent < 3.0
                distLevel := "Medium-Term"
            else
                distLevel := "Long-Term"
            
            powerLabel = ""
            if power >= 5.0
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Extreme)"
            else if power >= 3.0
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Strong)"
            else if power >= 2.0
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Moderate)"
            else if power >= 1.5
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Mild)"
            else
                powerLabel := "Power " + str.tostring(power, "#.##") + " (Weak)"
            
            behaviorDisplay = ""
            if cnt >= 5
                behaviorDisplay := "✅ Strongly Validated"
            else if cnt >= 3
                behaviorDisplay := "✅ Validated"
            else if cnt >= 2
                behaviorDisplay := "⏳ Initial Test"
            else
                behaviorDisplay := "🆕 Untested"
            
            lbl = label.new(
                x=idx, y=val,
                text="🟢 S (" + str.tostring(val, "#.##") + ")\n" + distLevel + " ↓ " + str.tostring(distPercent, "#.##") + "%\n" + powerLabel + "\n" + behaviorDisplay,
                color=color.new(color.green, 85),
                textcolor=color.white,
                style=label.style_label_up,
                size=size.small,
                textalign=text.align_center
            )
            array.push(supportLabels, lbl)

// ============================================================
// MODULE 11: Table Data (Liquidity Flow)
// ============================================================
array.clear(tableLabels)
array.clear(tableValues)
array.clear(tableLabelColors)
array.clear(tableValueColors)

resCount = array.size(resistancePrices)
supCount = array.size(supportPrices)

highPowerRes = 0
sumResPower = 0.0
maxResPower = 0.0
for i = 0 to resCount - 1
    power = array.get(resistancePower, i)
    if not na(power)
        sumResPower := sumResPower + power
        if power > maxResPower
            maxResPower := power
        if power >= powerThreshold
            highPowerRes := highPowerRes + 1

highPowerSup = 0
sumSupPower = 0.0
maxSupPower = 0.0
for i = 0 to supCount - 1
    power = array.get(supportPower, i)
    if not na(power)
        sumSupPower := sumSupPower + power
        if power > maxSupPower
            maxSupPower := power
        if power >= powerThreshold
            highPowerSup := highPowerSup + 1

avgResPower = resCount > 0 ? sumResPower / resCount : 0
avgSupPower = supCount > 0 ? sumSupPower / supCount : 0
avgPowerTotal = (avgResPower + avgSupPower) / 2
maxPowerTotal = math.max(maxResPower, maxSupPower)

// ============================================================
// Volume-Driven Liquidity Flow
// ============================================================
avgVol20 = ta.sma(volume, 20)
avgVol50 = ta.sma(volume, 50)
volRatio = avgVol20 / avgVol50
volSpike = volume > avgVol20 * 2.0
vwap = ta.vwap(close)
priceVsVwap = close - vwap

liquidityFlowStatus = ""
liquidityFlowColor = color.white

if volSpike and priceVsVwap > 0
    liquidityFlowStatus := "🔥 Buyer Liquidity Flood"
    liquidityFlowColor := color.rgb(0,255,100)
else if volSpike and priceVsVwap < 0
    liquidityFlowStatus := "🔥 Seller Liquidity Flood"
    liquidityFlowColor := color.rgb(255,80,80)
else if volRatio > 1.5 and priceVsVwap > 0
    liquidityFlowStatus := "📈 Buyer Liquidity Expansion"
    liquidityFlowColor := color.rgb(100,255,100)
else if volRatio > 1.5 and priceVsVwap < 0
    liquidityFlowStatus := "📉 Seller Liquidity Expansion"
    liquidityFlowColor := color.rgb(255,150,100)
else if volRatio > 1.0 and priceVsVwap > 0
    liquidityFlowStatus := "↗️ Buyer Liquidity Mild"
    liquidityFlowColor := color.rgb(150,255,150)
else if volRatio > 1.0 and priceVsVwap < 0
    liquidityFlowStatus := "↘️ Seller Liquidity Mild"
    liquidityFlowColor := color.rgb(255,180,150)
else if volRatio < 0.8
    liquidityFlowStatus := "⏸️ Liquidity Contraction"
    liquidityFlowColor := color.rgb(200,200,200)
else
    liquidityFlowStatus := "➡️ Liquidity Balanced"
    liquidityFlowColor := color.rgb(180,180,200)

liquidityStrength = 50
if volSpike
    liquidityStrength := 90
else if volRatio > 2.0
    liquidityStrength := 80
else if volRatio > 1.5
    liquidityStrength := 70
else if volRatio > 1.2
    liquidityStrength := 60
else if volRatio > 0.8
    liquidityStrength := 50
else if volRatio > 0.5
    liquidityStrength := 30
else
    liquidityStrength := 10

textSize = tableScale >= 1.5 ? size.large : tableScale >= 1.0 ? size.normal : size.small

array.push(tableLabels, " ⚡ S/R Force Matrix")
array.push(tableValues, "")
array.push(tableLabelColors, color.rgb(200,220,255))
array.push(tableValueColors, color.rgb(200,220,255))

array.push(tableLabels, "━━━━━━━━━━━━")
array.push(tableValues, "━━━━━━━━━━━━")
array.push(tableLabelColors, color.rgb(80,80,150))
array.push(tableValueColors, color.rgb(80,80,150))

array.push(tableLabels, "📊 Avg Power")
array.push(tableValues, str.tostring(avgPowerTotal, "#.##"))
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, color.rgb(200,220,255))

array.push(tableLabels, "🔥 Max Power")
array.push(tableValues, str.tostring(maxPowerTotal, "#.##"))
array.push(tableLabelColors, color.rgb(255,200,150))
array.push(tableValueColors, color.rgb(255,220,180))

array.push(tableLabels, "⚖️ Pressure")
array.push(tableValues, pressureStatus)
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, pressureColor)

array.push(tableLabels, "💧 Liquidity Flow")
array.push(tableValues, liquidityFlowStatus + " (" + str.tostring(liquidityStrength) + "%)")
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, liquidityFlowColor)

array.push(tableLabels, "⏱️ Timeframe")
array.push(tableValues, getReadableTimeframe())
array.push(tableLabelColors, color.rgb(180,200,255))
array.push(tableValueColors, color.rgb(200,220,255))

// ============================================================
// MODULE 12: Render Table
// ============================================================
if barstate.islast and not na(infoTable)
    for row = 0 to array.size(tableLabels) - 1
        labelText = array.get(tableLabels, row)
        valueText = array.get(tableValues, row)
        labelColor = array.get(tableLabelColors, row)
        valueColor = array.get(tableValueColors, row)
        
        isHeader = row == 0
        isSeparator = row == 1
        
        if isHeader
            table.cell(infoTable, 0, row, labelText, 
                       text_color=labelColor, 
                       bgcolor=color.rgb(30, 50, 120, tableBgOpacity), 
                       text_size=textSize, 
                       text_halign=text.align_center)
            table.cell(infoTable, 1, row, "", 
                       text_color=labelColor, 
                       bgcolor=color.rgb(30, 50, 120, tableBgOpacity), 
                       text_size=textSize)
        else if isSeparator
            table.cell(infoTable, 0, row, labelText, 
                       text_color=labelColor, 
                       bgcolor=color.rgb(15, 15, 40, tableBgOpacity), 
                       text_size=textSize, 
                       text_halign=text.align_center)
            table.cell(infoTable, 1, row, "", 
                       text_color=labelColor, 
                       bgcolor=color.rgb(15, 15, 40, tableBgOpacity), 
                       text_size=textSize)
        else
            table.cell(infoTable, 0, row, labelText, 
                       text_color=labelColor, 
                       bgcolor=color.rgb(20, 25, 55, tableBgOpacity), 
                       text_size=textSize, 
                       text_halign=text.align_left)
            table.cell(infoTable, 1, row, valueText, 
                       text_color=valueColor, 
                       bgcolor=color.rgb(20, 25, 55, tableBgOpacity), 
                       text_size=textSize, 
                       text_halign=text.align_right)