//@version=5


// @library LightyearWebhook
// @description This library provides functionality to create a webhook signal configuration for trading strategies. 
// 				It generates a JSON string with relevant trading information which can be sent to external systems.
library("LightyearWebhook", overlay = true)


 // @function signal_config
 // @description Generates a JSON string containing the signal configuration for trading strategies. This includes 
 //              information about the symbol, order action, market position, amount, price, cost, fee, order ID, 
 //              trade timestamp, previous entry price, previous market position size, initial capital, leverage, 
 //              contract size, and strategy token.
 // @param int leverage The leverage used in the strategy.
 // @param int contract_size The size of the contract used in the strategy.
 // @param string token A unique token for the strategy.
 // @returns string A JSON string containing the signal configuration.
export signal_config (int leverage , int contract_size, string token) =>
     '{ "symbol": "{{ticker}}"' +
     ', "order_action": "{{strategy.order.action}}"' +
     ', "market_position": "{{strategy.market_position}}"' + 
     ', "amount": {{strategy.order.contracts}}' +
     ', "price": {{strategy.order.price}}' +
     ', "cost": ' + str.tostring(na(strategy.position_avg_price) ? 0 : strategy.position_avg_price) + // REMOVE
     ', "fee": ' +  str.tostring(0) +
     ', "order_id": "{{strategy.order.id}}"' +
     ', "trade_at": "{{timenow}}"' +
     // Exit portion
     ', "prev_entry_price":' + str.tostring(na(strategy.opentrades.entry_price(strategy.opentrades - 1)) ? 0 : strategy.opentrades.entry_price(strategy.opentrades - 1)) + // NOTE: pnl
     ', "prev_market_position_size": {{strategy.prev_market_position_size}}' + 
     // Entry Portion
     ', "initial_capital": ' +  str.tostring(strategy.initial_capital) +
     ', "leverage": ' + str.tostring(leverage) +
     ', "contract_size": ' + str.tostring(contract_size) +
     ', "strategy_token":' + '"' + str.tostring(token) + '"' +  
     '}'