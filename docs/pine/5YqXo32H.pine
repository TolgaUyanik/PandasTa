// ============================================================
//  ██████╗  ██████╗ ██╗     ██████╗     █████╗ ██╗
// ██╔════╝ ██╔═══██╗██║     ██╔══██╗   ██╔══██╗██║
// ██║  ███╗██║   ██║██║     ██║  ██║   ███████║██║
// ██║   ██║██║   ██║██║     ██║  ██║   ██╔══██║██║
// ╚██████╔╝╚██████╔╝███████╗██████╔╝   ██║  ██║██║
//  ╚═════╝  ╚═════╝ ╚══════╝╚═════╝    ╚═╝  ╚═╝╚═╝
//
// GOLD AI STRATEGY v2.0 — XAU/USD
// Autore   : Claude AI (Anthropic)
// Mercato  : XAUUSD (Oro / Dollaro USA)
// Timeframe: H1 ottimale  |  M15–H4 compatibile
// Licenza  : Solo uso educativo — non è consulenza finanziaria
// ============================================================

//@version=6
strategy(
     title            = "🥇 GOLD AI Strategy v2.0",
     shorttitle        = "GOLD·AI",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 5,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.04,
     slippage          = 3,
     currency          = currency.USD,
     max_bars_back     = 500
     )

// ============================================================
// ── 1. INPUT PARAMETERS
// ============================================================
grp_trend   = "📈 Trend Filter"
grp_entry   = "🎯 Entry Signals"
grp_vol     = "📊 Volatility / ATR"
grp_risk    = "🛡️ Risk Management"
grp_session = "⏰ Session Filter"
grp_display = "🖥️ Display"

// Trend
ema_fast    = input.int(21,  "EMA Fast",          minval=5,  maxval=50,   group=grp_trend)
ema_slow    = input.int(55,  "EMA Slow",          minval=20, maxval=200,  group=grp_trend)
ema_trend   = input.int(200, "EMA Trend (200)",   minval=50, maxval=500,  group=grp_trend)

// Entry
rsi_len     = input.int(14,   "RSI Length",        minval=5,  maxval=30,   group=grp_entry)
rsi_ob      = input.int(70,   "RSI Overbought",    minval=60, maxval=90,   group=grp_entry)
rsi_os      = input.int(30,   "RSI Oversold",      minval=10, maxval=40,   group=grp_entry)
macd_fast   = input.int(12,   "MACD Fast",         minval=3,  maxval=30,   group=grp_entry)
macd_slow   = input.int(26,   "MACD Slow",         minval=10, maxval=60,   group=grp_entry)
macd_sig    = input.int(9,    "MACD Signal",       minval=3,  maxval=20,   group=grp_entry)
bb_len      = input.int(20,   "BB Length",         minval=10, maxval=50,   group=grp_entry)
bb_mult     = input.float(2.0,"BB StdDev",         minval=1.0,maxval=3.5,  group=grp_entry)
stoch_k     = input.int(14,   "Stoch %K",          minval=5,  maxval=30,   group=grp_entry)
stoch_d     = input.int(3,    "Stoch %D",          minval=1,  maxval=10,   group=grp_entry)
stoch_smooth= input.int(3,    "Stoch Smooth",      minval=1,  maxval=10,   group=grp_entry)

// Volatility
atr_len     = input.int(14,   "ATR Length",        minval=5,  maxval=30,   group=grp_vol)
atr_mult_sl = input.float(1.8,"ATR Mult. SL",      minval=0.5,maxval=5.0,  group=grp_vol)
atr_mult_tp = input.float(3.0,"ATR Mult. TP",      minval=1.0,maxval=8.0,  group=grp_vol)
vol_filter  = input.bool(true, "Volume Filter",                            group=grp_vol)
vol_ma_len  = input.int(20,   "Volume MA Length",  minval=5,  maxval=50,   group=grp_vol)

// Risk
use_trailing= input.bool(true, "Use Trailing Stop",                        group=grp_risk)
trail_perc  = input.float(0.8, "Trailing % (ATR-based)",minval=0.1,maxval=5.0, group=grp_risk)
max_trades  = input.int(1,    "Max Concurrent Trades", minval=1, maxval=3, group=grp_risk)
score_min   = input.int(4,    "Min Signal Score (1-6)",minval=1, maxval=6, group=grp_risk)

// Session
use_session = input.bool(true, "Enable Session Filter",                    group=grp_session)
london_open = input.session("0700-1600", "London Session",                 group=grp_session)
ny_open     = input.session("1300-2100", "New York Session",               group=grp_session)

// Display
show_ema    = input.bool(true, "Show EMAs",                                group=grp_display)
show_bb     = input.bool(true, "Show Bollinger Bands",                     group=grp_display)
show_signals= input.bool(true, "Show Entry Signals",                       group=grp_display)
show_sl_tp  = input.bool(true, "Show SL/TP Lines",                        group=grp_display)

// ============================================================
// ── 2. INDICATOR CALCULATIONS
// ============================================================

// EMAs
ema_f  = ta.ema(close, ema_fast)
ema_s  = ta.ema(close, ema_slow)
ema_t  = ta.ema(close, ema_trend)

// RSI
rsi    = ta.rsi(close, rsi_len)

// MACD
[macd_line, signal_line, hist_line] = ta.macd(close, macd_fast, macd_slow, macd_sig)

// Bollinger Bands
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_len, bb_mult)

// Stochastic
stoch_k_val = ta.sma(ta.stoch(close, high, low, stoch_k), stoch_smooth)
stoch_d_val = ta.sma(stoch_k_val, stoch_d)

// ATR
atr    = ta.atr(atr_len)

// Volume MA
vol_ma = ta.sma(volume, vol_ma_len)
high_vol= volume > vol_ma * 1.2

// ============================================================
// ── 3. TREND ANALYSIS (Scoring System)
// ============================================================

// Trend direction
bull_trend = close > ema_t and ema_f > ema_s
bear_trend = close < ema_t and ema_f < ema_s

// SCORE LONG (0-6 punti)
score_long = 0
score_long := score_long + (close > ema_t      ? 1 : 0)   // Sopra EMA 200
score_long := score_long + (ema_f > ema_s       ? 1 : 0)   // EMA cross bullish
score_long := score_long + (rsi > 50 and rsi < rsi_ob ? 1 : 0)  // RSI zona rialzo
score_long := score_long + (macd_line > signal_line ? 1 : 0)    // MACD bullish
score_long := score_long + (close > bb_mid      ? 1 : 0)   // Sopra BB medio
score_long := score_long + (stoch_k_val > stoch_d_val and stoch_k_val < 80 ? 1 : 0) // Stoch bullish

// SCORE SHORT (0-6 punti)
score_short = 0
score_short := score_short + (close < ema_t     ? 1 : 0)
score_short := score_short + (ema_f < ema_s      ? 1 : 0)
score_short := score_short + (rsi < 50 and rsi > rsi_os ? 1 : 0)
score_short := score_short + (macd_line < signal_line ? 1 : 0)
score_short := score_short + (close < bb_mid     ? 1 : 0)
score_short := score_short + (stoch_k_val < stoch_d_val and stoch_k_val > 20 ? 1 : 0)

// ============================================================
// ── 4. ENTRY CONDITIONS
// ============================================================

// EMA cross
ema_cross_up   = ta.crossover(ema_f, ema_s)
ema_cross_down = ta.crossunder(ema_f, ema_s)

// MACD cross
macd_cross_up   = ta.crossover(macd_line, signal_line)
macd_cross_down = ta.crossunder(macd_line, signal_line)

// RSI reversal
rsi_bounce_up   = ta.crossover(rsi, rsi_os + 5)
rsi_bounce_down = ta.crossunder(rsi, rsi_ob - 5)

// Bollinger Band squeeze breakout
bb_width    = bb_upper - bb_lower
bb_squeeze  = bb_width < ta.lowest(bb_width, 20) * 1.15
bb_break_up = close > bb_upper[1] and bb_squeeze[1]
bb_break_dn = close < bb_lower[1] and bb_squeeze[1]

// Stochastic cross
stoch_cross_up = ta.crossover(stoch_k_val, stoch_d_val) and stoch_k_val < 40
stoch_cross_dn = ta.crossunder(stoch_k_val, stoch_d_val) and stoch_k_val > 60

// Session filter
in_london = use_session ? not na(time(timeframe.period, london_open)) : true
in_ny     = use_session ? not na(time(timeframe.period, ny_open))     : true
in_session= in_london or in_ny

// Volume OK
vol_ok    = vol_filter ? high_vol : true

// ── PRIMARY SIGNALS (require score threshold)
long_signal  = in_session and vol_ok and score_long  >= score_min and
               (ema_cross_up or macd_cross_up or rsi_bounce_up or stoch_cross_up) and
               close > ema_t

short_signal = in_session and vol_ok and score_short >= score_min and
               (ema_cross_down or macd_cross_down or rsi_bounce_down or stoch_cross_dn) and
               close < ema_t

// ============================================================
// ── 5. RISK MANAGEMENT — SL & TP
// ============================================================

var float sl_price = na
var float tp_price = na
var float entry_px = na

sl_distance = atr * atr_mult_sl
tp_distance = atr * atr_mult_tp

// ============================================================
// ── 6. STRATEGY EXECUTION
// ============================================================

if long_signal and strategy.opentrades < max_trades
    entry_px := close
    sl_price := close - sl_distance
    tp_price := close + tp_distance
    strategy.entry("LONG", strategy.long, comment="🟢 LONG")
    if use_trailing
        strategy.exit("EXIT_L", "LONG",
             stop   = sl_price,
             limit  = tp_price,
             trail_points = atr * trail_perc * 10,
             trail_offset = atr * trail_perc * 10)
    else
        strategy.exit("EXIT_L", "LONG", stop=sl_price, limit=tp_price)

if short_signal and strategy.opentrades < max_trades
    entry_px := close
    sl_price := close + sl_distance
    tp_price := close - tp_distance
    strategy.entry("SHORT", strategy.short, comment="🔴 SHORT")
    if use_trailing
        strategy.exit("EXIT_S", "SHORT",
             stop   = sl_price,
             limit  = tp_price,
             trail_points = atr * trail_perc * 10,
             trail_offset = atr * trail_perc * 10)
    else
        strategy.exit("EXIT_S", "SHORT", stop=sl_price, limit=tp_price)

// ============================================================
// ── 7. PLOTS
// ============================================================

// EMAs
plot(show_ema ? ema_f : na,  "EMA Fast",  color=color.new(#00E5FF, 0),  linewidth=1)
plot(show_ema ? ema_s : na,  "EMA Slow",  color=color.new(#FF9800, 0),  linewidth=1)
plot(show_ema ? ema_t : na,  "EMA Trend", color=color.new(#E040FB, 40), linewidth=2)

// Bollinger Bands
p_bb_mid   = plot(show_bb ? bb_mid   : na, "BB Mid",   color=color.new(color.gray, 60))
p_bb_upper = plot(show_bb ? bb_upper : na, "BB Upper", color=color.new(#FF5252, 60))
p_bb_lower = plot(show_bb ? bb_lower : na, "BB Lower", color=color.new(#69F0AE, 60))
fill(p_bb_upper, p_bb_lower, color=color.new(color.blue, 93))

// Entry Arrows
plotshape(show_signals and long_signal,  "LONG",  shape.triangleup,
          location.belowbar, color=#00E676, size=size.normal)
plotshape(show_signals and short_signal, "SHORT", shape.triangledown,
          location.abovebar, color=#FF1744, size=size.normal)

// Score labels
if show_signals and long_signal
    label.new(bar_index, low - atr * 0.5,
         "LONG\n⭐" + str.tostring(score_long) + "/6",
         color=#00E676, textcolor=color.black,
         style=label.style_label_up, size=size.small)

if show_signals and short_signal
    label.new(bar_index, high + atr * 0.5,
         "SHORT\n⭐" + str.tostring(score_short) + "/6",
         color=#FF1744, textcolor=color.white,
         style=label.style_label_down, size=size.small)

// ============================================================
// ── 8. DASHBOARD TABLE
// ============================================================

var table dash = table.new(
     position.top_right, 3, 12,
     bgcolor=color.new(color.black, 20),
     border_color=color.new(#FFD700, 50),
     border_width=1,
     frame_color=color.new(#FFD700, 20),
     frame_width=2)

gold = #FFD700
grn  = #00E676
red  = #FF1744
wht  = color.white

if barstate.islast
    // Header
    table.cell(dash, 0, 0, "🥇 GOLD AI v2.0", text_color=gold,
         bgcolor=color.new(color.black, 10), text_size=size.normal)
    table.cell(dash, 1, 0, "",               text_color=gold,
         bgcolor=color.new(color.black, 10), text_size=size.normal)
    table.cell(dash, 2, 0, "XAU/USD",        text_color=color.new(gold, 40),
         bgcolor=color.new(color.black, 10), text_size=size.small)

    // ATR
    table.cell(dash, 0, 1, "ATR",      text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(math.round(atr, 2)), text_color=wht, text_size=size.small)
    table.cell(dash, 2, 1, "pips",     text_color=color.gray, text_size=size.small)

    // Trend
    trend_txt = bull_trend ? "📈 RIALZO" : bear_trend ? "📉 RIBASSO" : "↔ LATERALE"
    trend_col = bull_trend ? grn : bear_trend ? red : color.orange
    table.cell(dash, 0, 2, "TREND",    text_color=color.gray,  text_size=size.small)
    table.cell(dash, 1, 2, trend_txt,  text_color=trend_col,   text_size=size.small)
    table.cell(dash, 2, 2, "",         text_color=trend_col,   text_size=size.small)

    // RSI
    rsi_col = rsi > rsi_ob ? red : rsi < rsi_os ? grn : wht
    table.cell(dash, 0, 3, "RSI",      text_color=color.gray,  text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(rsi, 1)), text_color=rsi_col, text_size=size.small)
    table.cell(dash, 2, 3, rsi > rsi_ob ? "OB" : rsi < rsi_os ? "OS" : "—",
         text_color=rsi_col, text_size=size.small)

    // MACD
    macd_col = macd_line > signal_line ? grn : red
    table.cell(dash, 0, 4, "MACD",     text_color=color.gray,  text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(math.round(macd_line, 3)),
         text_color=macd_col, text_size=size.small)
    table.cell(dash, 2, 4, macd_line > signal_line ? "↑" : "↓",
         text_color=macd_col, text_size=size.small)

    // Stochastic
    stoch_col = stoch_k_val > 80 ? red : stoch_k_val < 20 ? grn : wht
    table.cell(dash, 0, 5, "STOCH",    text_color=color.gray,  text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(math.round(stoch_k_val, 1)),
         text_color=stoch_col, text_size=size.small)
    table.cell(dash, 2, 5, stoch_k_val > 80 ? "OB" : stoch_k_val < 20 ? "OS" : "—",
         text_color=stoch_col, text_size=size.small)

    // Volume
    vol_col = high_vol ? grn : color.gray
    table.cell(dash, 0, 6, "VOLUME",   text_color=color.gray,  text_size=size.small)
    table.cell(dash, 1, 6, high_vol ? "✔ ALTO" : "✖ BASSO",
         text_color=vol_col, text_size=size.small)
    table.cell(dash, 2, 6, "",         text_color=vol_col, text_size=size.small)

    // Session
    sess_col = in_session ? grn : color.gray
    table.cell(dash, 0, 7, "SESSION",  text_color=color.gray,  text_size=size.small)
    table.cell(dash, 1, 7, in_session ? "✔ ATTIVA" : "✖ CHIUSA",
         text_color=sess_col, text_size=size.small)
    table.cell(dash, 2, 7, "",          text_color=sess_col, text_size=size.small)

    // Score LONG
    sl_col = score_long >= score_min ? grn : color.gray
    table.cell(dash, 0, 8, "LONG ⭐",  text_color=color.gray,  text_size=size.small)
    table.cell(dash, 1, 8, str.tostring(score_long) + " / 6",
         text_color=sl_col, text_size=size.small)
    table.cell(dash, 2, 8, score_long >= score_min ? "✔" : "✖",
         text_color=sl_col, text_size=size.small)

    // Score SHORT
    ss_col = score_short >= score_min ? red : color.gray
    table.cell(dash, 0, 9, "SHORT ⭐", text_color=color.gray,  text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(score_short) + " / 6",
         text_color=ss_col, text_size=size.small)
    table.cell(dash, 2, 9, score_short >= score_min ? "✔" : "✖",
         text_color=ss_col, text_size=size.small)

    // SL / TP live
    trade_col = strategy.opentrades > 0 ? gold : color.gray
    sl_live   = strategy.opentrades > 0 ? str.tostring(math.round(sl_price, 2)) : "—"
    tp_live   = strategy.opentrades > 0 ? str.tostring(math.round(tp_price, 2)) : "—"
    table.cell(dash, 0, 10, "SL",       text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 10, sl_live,    text_color=red,        text_size=size.small)
    table.cell(dash, 2, 10, "",         text_color=red,        text_size=size.small)
    table.cell(dash, 0, 11, "TP",       text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 11, tp_live,    text_color=grn,        text_size=size.small)
    table.cell(dash, 2, 11, "",         text_color=grn,        text_size=size.small)

// ============================================================
// ── 9. ALERTS
// ============================================================

alertcondition(long_signal,  "🥇 GOLD LONG",   "GOLD AI — Segnale LONG attivato")
alertcondition(short_signal, "🥇 GOLD SHORT",  "GOLD AI — Segnale SHORT attivato")
alertcondition(long_signal or short_signal, "🥇 GOLD SIGNAL", "GOLD AI — Nuovo segnale rilevato")

// ── END OF SCRIPT ────────────────────────────────────────────
