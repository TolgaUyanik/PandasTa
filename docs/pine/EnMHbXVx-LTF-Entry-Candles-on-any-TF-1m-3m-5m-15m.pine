//@version=6
// LTF Entry Candles (any chart timeframe) — candles of 1m/3m/5m/15m drawn to the RIGHT of the live bar.
// Once a candle closes, it commits the accurate native OHLC so it matches the real chart.

indicator("LTF Entry Candles — any TF (1/3/5/15)", overlay = true, max_boxes_count = 300, max_lines_count = 300, max_labels_count = 50, dynamic_requests = true)

nShow      = input.int(3, "Candles per timeframe", minval = 1, maxval = 5)
bodyHalf   = input.int(1, "Body half-width (bars)", minval = 1, maxval = 5)
gapBetween = input.int(1, "Gap between candles (bars)", minval = 1, maxval = 8)
gapFromLive= input.int(3, "Gap from live bar (bars)", minval = 1)
groupGap   = input.int(3, "Gap between groups (bars)", minval = 0)

show1  = input.bool(true, "Show 1m",  group = "Timeframes")
show3  = input.bool(true, "Show 3m",  group = "Timeframes")
show5  = input.bool(true, "Show 5m",  group = "Timeframes")
show15 = input.bool(true, "Show 15m", group = "Timeframes")

upCol = input.color(#26A69A, "Up candle",   group = "Style")
dnCol = input.color(#EF5350, "Down candle", group = "Style")

showCountdown = input.bool(true, "Show candle countdown", group = "Style")
urgentSecs    = input.int(10, "Countdown urgent under (secs)", minval = 0, maxval = 60, group = "Style")
urgentCol     = input.color(#FFD24D, "Countdown urgent colour", group = "Style")

type ohlc
    float o
    float h
    float l
    float c

var array<ohlc> conf1  = array.new<ohlc>(), var array<ohlc> form1  = array.new<ohlc>(), var array<int> lt1  = array.new<int>()
var array<ohlc> conf3  = array.new<ohlc>(), var array<ohlc> form3  = array.new<ohlc>(), var array<int> lt3  = array.new<int>()
var array<ohlc> conf5  = array.new<ohlc>(), var array<ohlc> form5  = array.new<ohlc>(), var array<int> lt5  = array.new<int>()
var array<ohlc> conf15 = array.new<ohlc>(), var array<ohlc> form15 = array.new<ohlc>(), var array<int> lt15 = array.new<int>()

nearEnd = (last_bar_index - bar_index) < 60

chartSec = timeframe.in_seconds()
draw1  = show1  and timeframe.in_seconds("1")  != chartSec
draw3  = show3  and timeframe.in_seconds("3")  != chartSec
draw5  = show5  and timeframe.in_seconds("5")  != chartSec
draw15 = show15 and timeframe.in_seconds("15") != chartSec

secsLeftFor(simple string tf) =>
    s       = timeframe.in_seconds(tf)
    nowSec  = math.floor(timenow / 1000)
    elapsed = nowSec % s
    math.max(0, math.min(s, s - elapsed))

fmtCountdown(float secsIn) =>
    total = math.max(0, math.floor(secsIn))
    m  = math.floor(total / 60)
    ss = total - m * 60
    str.tostring(m, "0") + ":" + (ss < 10 ? "0" : "") + str.tostring(ss, "0")

update(simple string tf, array<ohlc> conf, array<ohlc> forming, array<int> ltBox) =>
    cSec = timeframe.in_seconds()
    sSec = timeframe.in_seconds(tf)
    if nearEnd
        if sSec == cSec
            if barstate.isconfirmed
                conf.push(ohlc.new(open, high, low, close))
                while conf.size() > nShow
                    conf.shift()
            forming.clear()
            if not barstate.isconfirmed
                forming.push(ohlc.new(open, high, low, close))
        else if sSec < cSec
            safeTf = sSec < cSec ? tf : "1"
            [ao, ah, al, ac] = request.security_lower_tf(syminfo.tickerid, safeTf, [open, high, low, close])
            if barstate.isconfirmed and not na(ao) and ao.size() > 0
                for i = 0 to ao.size() - 1
                    conf.push(ohlc.new(ao.get(i), ah.get(i), al.get(i), ac.get(i)))
                while conf.size() > nShow
                    conf.shift()
            forming.clear()
            if (not barstate.isconfirmed) and not na(ao) and ao.size() > 0
                for i = 0 to ao.size() - 1
                    forming.push(ohlc.new(ao.get(i), ah.get(i), al.get(i), ac.get(i)))
        else
            // higher-TF: track the confirmed native bar and commit ACCURATE OHLC on close
            [ro, rh, rl, rc] = request.security(syminfo.tickerid, tf, [open, high, low, close], lookahead = barmerge.lookahead_off)
            rt = request.security(syminfo.tickerid, tf, time, lookahead = barmerge.lookahead_off)
            [pro, prh, prl, prc] = request.security(syminfo.tickerid, tf, [open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_off)
            if not na(rt)
                prevT = ltBox.size() > 0 ? ltBox.get(0) : na
                // when the TF rolls to a new bar, the bar that just closed is committed with native confirmed OHLC
                if (not na(prevT)) and rt != prevT
                    conf.push(ohlc.new(pro, prh, prl, prc))
                    while conf.size() > nShow
                        conf.shift()
                if ltBox.size() > 0
                    ltBox.set(0, rt)
                else
                    ltBox.push(rt)
                forming.clear()
                forming.push(ohlc.new(ro, rh, rl, rc))

if draw1
    update("1", conf1, form1, lt1)
if draw3
    update("3", conf3, form3, lt3)
if draw5
    update("5", conf5, form5, lt5)
if draw15
    update("15", conf15, form15, lt15)

buildList(array<ohlc> conf, array<ohlc> forming) =>
    out = array.new<ohlc>()
    for e in conf
        out.push(e)
    for e in forming
        out.push(e)
    while out.size() > nShow
        out.shift()
    out

var array<box>   boxes  = array.new<box>()
var array<line>  wicks  = array.new<line>()
var array<label> labels = array.new<label>()

stepBars = 2 * bodyHalf + gapBetween

drawGroup(array<ohlc> list, int startBar, string tag, simple string tf) =>
    n = list.size()
    if n > 0
        for i = 0 to n - 1
            cdl = list.get(i)
            bx  = startBar + i * stepBars
            up  = cdl.c >= cdl.o
            col = up ? upCol : dnCol
            top = math.max(cdl.o, cdl.c)
            bot = math.min(cdl.o, cdl.c)
            bt = top == bot ? top + syminfo.mintick : top
            bb = top == bot ? bot - syminfo.mintick : bot
            boxes.push(box.new(left = bx, top = bt, right = bx + 2 * bodyHalf, bottom = bb, xloc = xloc.bar_index, border_color = col, bgcolor = col, border_width = 1))
            wicks.push(line.new(bx + bodyHalf, cdl.h, bx + bodyHalf, cdl.l, xloc = xloc.bar_index, color = col, width = 1))
        labels.push(label.new(startBar + bodyHalf, list.get(0).l, tag, xloc = xloc.bar_index, style = label.style_label_up, color = color.new(color.gray, 90), textcolor = color.gray, size = size.tiny))
        if showCountdown
            secs = secsLeftFor(tf)
            cdCol = secs <= urgentSecs ? urgentCol : color.gray
            labels.push(label.new(startBar + bodyHalf, list.get(0).h, fmtCountdown(secs), xloc = xloc.bar_index, style = label.style_label_down, color = color.new(color.gray, 90), textcolor = cdCol, size = size.tiny))

if barstate.islast
    for b in boxes
        b.delete()
    boxes.clear()
    for w in wicks
        w.delete()
    wicks.clear()
    for lb in labels
        lb.delete()
    labels.clear()

    spanBars = nShow * stepBars
    cursor = bar_index + gapFromLive
    if draw1
        drawGroup(buildList(conf1, form1), cursor, "1m", "1")
        cursor := cursor + spanBars + groupGap
    if draw3
        drawGroup(buildList(conf3, form3), cursor, "3m", "3")
        cursor := cursor + spanBars + groupGap
    if draw5
        drawGroup(buildList(conf5, form5), cursor, "5m", "5")
        cursor := cursor + spanBars + groupGap
    if draw15
        drawGroup(buildList(conf15, form15), cursor, "15m", "15")

plot(na, "", display = display.none)
