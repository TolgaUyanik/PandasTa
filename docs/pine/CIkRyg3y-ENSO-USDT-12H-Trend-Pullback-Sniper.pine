// ============================================================================
// ENSO/USDT 15m - Trend Pullback Sniper Strategy (FIXED)
// Indicators: EMA 9/21/50 + Stochastic RSI + VWAP + ATR
// ============================================================================

//@version=6
strategy("ENSO/USDT 15m Trend Pullback Sniper", 
     overlay=true, 
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=100, 
     initial_capital=10000, 
     commission_type=strategy.commission.percent, 
     commission_value=0.075)

// ============================================================================
// INPUTS
// ============================================================================

// EMA Settings
emaFastLen   = input.int(9,   "EMA Fast Length",   minval=1)
emaMidLen    = input.int(21,  "EMA Mid Length",    minval=1)
emaSlowLen   = input.int(50,  "EMA Slow Length",   minval=1)

// Stochastic RSI Settings
stochRsiLen  = input.int(14,  "Stoch RSI Length",  minval=1)
stochK       = input.int(3,   "Stoch K Smoothing", minval=1)
stochD       = input.int(3,   "Stoch D Smoothing", minval=1)
stochOB      = input.int(80,  "Stoch Overbought",  minval=50, maxval=100)
stochOS      = input.int(20,  "Stoch Oversold",    minval=0,  maxval=50)

// ATR Settings
atrLen       = input.int(14,  "ATR Length",        minval=1)
slMulti      = input.float(1.5, "Stop Loss ATR Multiplier",   step=0.1)
tp1Multi     = input.float(2.0, "Take Profit 1 ATR Multiplier", step=0.1)
tp2Multi     = input.float(3.0, "Take Profit 2 ATR Multiplier", step=0.1)

// Pullback Zone
pullbackATR  = input.float(1.0, "Pullback Zone (ATR from EMA21)", step=0.1)

// ============================================================================
// CALCULATIONS
// ============================================================================

// EMAs
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)

// VWAP
vwapVal = ta.vwap(hlc3)

// ATR
atrVal  = ta.atr(atrLen)

// Stochastic RSI
rsiVal    = ta.rsi(close, stochRsiLen)
stochKVal = ta.sma(ta.stoch(rsiVal, rsiVal, rsiVal, stochRsiLen), stochK)
stochDVal = ta.sma(stochKVal, stochD)

// Stoch Crosses
stochCrossUp   = ta.crossover(stochKVal, stochDVal)
stochCrossDown = ta.crossunder(stochKVal, stochDVal)

// ============================================================================
// CONDITIONS
// ============================================================================

// Trend
uptrendEMA   = emaFast > emaMid and close > emaSlow
downtrendEMA = emaFast < emaMid and close < emaSlow

// VWAP Bias
bullishVWAP = close > vwapVal
bearishVWAP = close < vwapVal

// Pullback near EMA21
nearEMA21 = math.abs(close - emaMid) <= (atrVal * pullbackATR)

// Stoch Signals
stochOSCross = stochCrossUp and stochKVal[1] < stochOS
stochOBCross = stochCrossDown and stochKVal[1] > stochOB

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

longCondition  = uptrendEMA and bullishVWAP and nearEMA21 and stochOSCross
shortCondition = downtrendEMA and bearishVWAP and nearEMA21 and stochOBCross

// ============================================================================
// EXECUTION
// ============================================================================

if longCondition and strategy.position_size == 0
    slPrice  = close - (atrVal * slMulti)
    tp1Price = close + (atrVal * tp1Multi)
    tp2Price = close + (atrVal * tp2Multi)

    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP1", "Long", qty_percent=50, limit=tp1Price, stop=slPrice)
    strategy.exit("Long TP2", "Long", qty_percent=100, limit=tp2Price, stop=slPrice)

if shortCondition and strategy.position_size == 0
    slPrice  = close + (atrVal * slMulti)
    tp1Price = close - (atrVal * tp1Multi)
    tp2Price = close - (atrVal * tp2Multi)

    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP1", "Short", qty_percent=50, limit=tp1Price, stop=slPrice)
    strategy.exit("Short TP2", "Short", qty_percent=100, limit=tp2Price, stop=slPrice)

// ============================================================================
// EMA50 Invalidation
// ============================================================================

if strategy.position_size > 0 and close < emaSlow
    strategy.close("Long", comment="EMA50 Invalidation")

if strategy.position_size < 0 and close > emaSlow
    strategy.close("Short", comment="EMA50 Invalidation")

// ============================================================================
// PLOTS
// ============================================================================

plot(emaFast, "EMA 9",  color=color.green,  linewidth=1)
plot(emaMid,  "EMA 21", color=color.orange, linewidth=2)
plot(emaSlow, "EMA 50", color=color.red,    linewidth=2)
plot(vwapVal, "VWAP",   color=color.purple, linewidth=1)

// Background trend color
bgcolor(uptrendEMA and bullishVWAP ? color.new(color.green, 90) : 
       downtrendEMA and bearishVWAP ? color.new(color.red, 90) : na)

// Signal markers
plotshape(longCondition  and strategy.position_size == 0, 
     title="Long Signal",  
     style=shape.triangleup,   
     location=location.belowbar, 
     color=color.green, 
     size=size.small)

plotshape(shortCondition and strategy.position_size == 0, 
     title="Short Signal", 
     style=shape.triangledown, 
     location=location.abovebar, 
     color=color.red,   
     size=size.small)