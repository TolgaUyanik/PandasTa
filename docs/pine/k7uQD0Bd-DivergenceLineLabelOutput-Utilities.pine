// @returns Updated label.
export syncLivePriceLabel(
     label lbl,
     bool show,
     int xTime,
     string labelText,
     simple string ylocText,
     simple string styleText,
     color lineColor,
     bool labelTextOnly,
     int labelBgTransp,
     simple string labelSize) =>

    label out = lbl

    if not na(out)
        label.delete(out)
        out := na

    if show and not na(xTime) and labelText != "" and not na(lineColor)
        string resolvedStyle =
             styleText == "down" ? label.style_label_down :
             styleText == "up" ? label.style_label_up : label.style_none

        string resolvedYloc =
             ylocText == "above" ? yloc.abovebar : yloc.belowbar

        color labelBg = labelTextOnly ? color.new(color.black, 100) : color.new(lineColor, labelBgTransp)
        color labelTxt = labelTextOnly ? color.new(lineColor, 0) : divContrastText(lineColor)

        out := label.new(x=xTime, y=0, text=labelText, xloc=xloc.bar_time, yloc=resolvedYloc, style=resolvedStyle, color=labelBg, textcolor=labelTxt, size=divLabelSize(labelSize), force_overlay=true)

    out

// ==============================================================================================
// 🔴 END REGION: Live Preview Label Helpers
