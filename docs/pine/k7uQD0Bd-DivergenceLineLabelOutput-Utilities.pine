// ==============================================================================================
// 🟢 REGION: Pivot Context Box Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides lightweight box helpers for drawing confirmed pivot context zones.
//
// 🧠 USER-FACING MODEL:
//     These helpers are useful for scripts that want to visually frame the oscillator
//     or price zones where confirmed divergence/context pivots were formed.
//
// Important design note:
//
// • This library does not confirm pivots.
// • This library does not decide whether a box should be upper or lower.
// • This library does not store pivot memory.
// • The calling script supplies:
//      - confirmed pivot index
//      - confirmed pivot value
//      - visibility state
//      - colors
//      - border style / width
//
// Common oscillator use:
//
// • Confirmed oscillator peak = upper pivot context box
// • Confirmed oscillator dip = lower pivot context box
// • Boxes can use oscillator candle high/low values supplied by the script
// • Boxes can help frame divergence anchors and pressure zones
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Pivot Box Bounds Resolver
// ──────────────────────────────────────────────

// @function Resolves a thin box around a pivot value using an inner percentage.
// @param pivotValue Pivot value, usually oscillator synthetic high/low or price value.
// @param innerPct Inner percentage used to create box thickness. Example: 0.90.
// @returns top, bottom, ok.
export divPivotBoxBounds(
     float pivotValue,
     float innerPct) =>

    float safePct =
         math.max(math.min(innerPct, 1.0), 0.0)

    float innerValue =
         pivotValue * safePct

    float top =
         math.max(pivotValue, innerValue)

    float bottom =
         math.min(pivotValue, innerValue)

    bool ok =
         not na(pivotValue) and
         not na(top) and
         not na(bottom) and
         top > bottom

    [top, bottom, ok]

// ──────────────────────────────────────────────
// 🟦 Subregion: Native Pane Box Manager
// ──────────────────────────────────────────────

// @function Creates, updates, or deletes a native-pane pivot context box.
// @param bx Existing box reference.
// @param show Whether the box should exist.
// @param left Left bar_index.
// @param right Right bar_index.
// @param top Top y value.
// @param bottom Bottom y value.
// @param fillColor Box fill color.
// @param borderColor Box border color.
// @param borderStyle Border style string: Solid, Dashed, or Dotted.
// @param borderWidth Border width.
// @returns Updated box reference.
export syncNativeBox(
     box bx,
     bool show,
     int left,
     int right,
     float top,
     float bottom,
     color fillColor,
     color borderColor,
     simple string borderStyle,
     int borderWidth) =>

    box out =
         bx

    bool valid =
         show and
         not na(left) and
         not na(right) and
         not na(top) and
         not na(bottom) and
         top > bottom

    if valid
        if na(out)
            out := box.new(
                 left=left,
                 right=right,
                 top=top,
                 bottom=bottom,
                 xloc=xloc.bar_index,
                 bgcolor=fillColor,
                 border_color=borderColor,
                 border_style=divLineStyle(borderStyle),
                 border_width=borderWidth)
        else
            box.set_left(out, left)
            box.set_right(out, right)
            box.set_top(out, top)
            box.set_bottom(out, bottom)
            box.set_bgcolor(out, fillColor)
            box.set_border_color(out, borderColor)
            box.set_border_style(out, divLineStyle(borderStyle))
            box.set_border_width(out, borderWidth)
    else
        if not na(out)
            box.delete(out)
            out := na

    out

// ──────────────────────────────────────────────
// 🟦 Subregion: Price Pane Box Manager
// ──────────────────────────────────────────────

// @function Creates, updates, or deletes a price-pane pivot context box using force_overlay=true.
// @param bx Existing box reference.
// @param show Whether the box should exist.
// @param left Left bar_index.
// @param right Right bar_index.
// @param top Top price value.
// @param bottom Bottom price value.
// @param fillColor Box fill color.
// @param borderColor Box border color.
// @param borderStyle Border style string: Solid, Dashed, or Dotted.
// @param borderWidth Border width.
// @returns Updated box reference.
export syncPriceBox(
     box bx,
     bool show,
     int left,
     int right,
     float top,
     float bottom,
     color fillColor,
     color borderColor,
     simple string borderStyle,
     int borderWidth) =>

    box out =
         bx

    bool valid =
         show and
         not na(left) and
         not na(right) and
         not na(top) and
         not na(bottom) and
         top > bottom

    if valid
        if na(out)
            out := box.new(
                 left=left,
                 right=right,
                 top=top,
                 bottom=bottom,
                 xloc=xloc.bar_index,
                 bgcolor=fillColor,
                 border_color=borderColor,
                 border_style=divLineStyle(borderStyle),
                 border_width=borderWidth,
                 force_overlay=true)
        else
            box.set_left(out, left)
            box.set_right(out, right)
            box.set_top(out, top)
            box.set_bottom(out, bottom)
            box.set_bgcolor(out, fillColor)
            box.set_border_color(out, borderColor)
            box.set_border_style(out, divLineStyle(borderStyle))
            box.set_border_width(out, borderWidth)
    else
        if not na(out)
            box.delete(out)
            out := na

    out

// ──────────────────────────────────────────────
// 🟦 Subregion: Indexed Box Wrappers
// ──────────────────────────────────────────────

// @function Creates, updates, or deletes a native-pane box with Last-N anchor gating.
// @param bx Existing box reference.
// @param show Whether the box should exist.
// @param anchorIdx Bar index used for Last-N gating.
// @param minIdxToKeep Oldest allowed bar_index.
// @param left Left bar_index.
// @param right Right bar_index.
// @param top Top y value.
// @param bottom Bottom y value.
// @param fillColor Box fill color.
// @param borderColor Box border color.
// @param borderStyle Border style string.
// @param borderWidth Border width.
// @returns Updated box reference.
export syncNativeBoxIndexed(
     box bx,
     bool show,
     int anchorIdx,
     int minIdxToKeep,
     int left,
     int right,
     float top,
     float bottom,
     color fillColor,
     color borderColor,
     simple string borderStyle,
     int borderWidth) =>

    bool showIndexed =
         show and
         not na(anchorIdx) and
         anchorIdx >= minIdxToKeep

    syncNativeBox(
         bx,
         showIndexed,
         left,
         right,
         top,
         bottom,
         fillColor,
         borderColor,
         borderStyle,
         borderWidth)

// @function Creates, updates, or deletes a price-pane box with Last-N anchor gating.
// @param bx Existing box reference.
// @param show Whether the box should exist.
// @param anchorIdx Bar index used for Last-N gating.
// @param minIdxToKeep Oldest allowed bar_index.
// @param left Left bar_index.
// @param right Right bar_index.
// @param top Top price value.
// @param bottom Bottom price value.
// @param fillColor Box fill color.
// @param borderColor Box border color.
// @param borderStyle Border style string.
// @param borderWidth Border width.
// @returns Updated box reference.
export syncPriceBoxIndexed(
     box bx,
     bool show,
     int anchorIdx,
     int minIdxToKeep,
     int left,
     int right,
     float top,
     float bottom,
     color fillColor,
     color borderColor,
     simple string borderStyle,
     int borderWidth) =>

    bool showIndexed =
         show and
         not na(anchorIdx) and
         anchorIdx >= minIdxToKeep

    syncPriceBox(
         bx,
         showIndexed,
         left,
         right,
         top,
         bottom,
         fillColor,
         borderColor,
         borderStyle,
         borderWidth)

