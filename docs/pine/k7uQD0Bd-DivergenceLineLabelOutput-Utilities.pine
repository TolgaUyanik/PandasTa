export syncLiveOscLabel(
     label lbl,
     bool show,
     int xIndex,
     float y,
     string labelText,
     simple string styleText,
     color lineColor,
     bool labelTextOnly,
     int labelBgTransp,
     simple string labelSize) =>

    label out = lbl

    if not na(out)
        label.delete(out)
        out := na

    if show and not na(xIndex) and not na(y) and labelText != "" and not na(lineColor)
        string resolvedStyle =
             styleText == "down" ? label.style_label_down :
             styleText == "up" ? label.style_label_up : label.style_none

        color labelBg = labelTextOnly ? color.new(color.black, 100) : color.new(lineColor, labelBgTransp)
        color labelTxt = labelTextOnly ? color.new(lineColor, 0) : divContrastText(lineColor)

        out := label.new(x=xIndex, y=y, text=labelText, xloc=xloc.bar_index, yloc=yloc.price, style=resolvedStyle, color=labelBg, textcolor=labelTxt, size=divLabelSize(labelSize))

    out

// @function Creates, updates, or deletes a live price-pane divergence label.
// @param lbl Existing label.
// @param show Whether live label should exist.
// @param xTime Label x time.
// @param labelText Label text.
// @param ylocText yloc text.
