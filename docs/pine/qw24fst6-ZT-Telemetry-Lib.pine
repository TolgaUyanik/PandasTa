
//@version=5
// v1.0.2 (2026-05-28): library title renamed AFZT_Telemetry_public → AFZT_Telemetry_Lib →
// "ZT_Telemetry_Lib" — TV content-fingerprints any republish under the banned AFZT_
// namespace. Dropping the AFZT_ prefix to "ZT_" mirrors KLP's net-new naming. No
// functional change; tfCode/buildMasks_v22/zoneCode* signatures unchanged.
library("ZT_Telemetry_Lib", overlay=false)

// =============================
// TF CODE MAPPING
// =============================
export tfCode(string _tfStr) =>
    int code = 0
    code := _tfStr == "1"   ? 1  : code
    code := _tfStr == "3"   ? 3  : code
    code := _tfStr == "5"   ? 5  : code
    code := _tfStr == "15"  ? 15 : code
    code := _tfStr == "30"  ? 30 : code
    code := _tfStr == "45"  ? 45 : code
    code := _tfStr == "60"  ? 60 : code
    code := _tfStr == "120" ? 120: code
    code := _tfStr == "240" ? 240: code
    code := _tfStr == "D"   ? 1001 : code
    code := _tfStr == "W"   ? 1002 : code
    code := _tfStr == "M"   ? 1003 : code
    code

// =============================
// TELEMETRY MASK BUILDER (v2.2)
// =============================
export buildMasks_v22(float scoreNorm, float atrMult, float entryAtr, int riskTicks, int zoneWidthTicks, bool hasCisd) =>

    // ---- STOP MASK ----
    int stopMask = 1 + 8
    stopMask += (not na(entryAtr) and entryAtr > 0) ? 2 : 0
    stopMask += hasCisd ? 4 : 0
    stopMask += (not na(atrMult) and atrMult <= 1.2 and riskTicks <= zoneWidthTicks * 0.9) ? 16 : 0

    // ---- BE MASK ----
    int beMask = 1 + 2 + 4 + 8
    beMask += (scoreNorm >= 70 and zoneWidthTicks >= riskTicks * 0.75) ? 16 : 0

    // ---- TP MASK ----
    int tpMask = 1 + 2 + 4
    tpMask += (scoreNorm >= 75 and zoneWidthTicks >= riskTicks * 0.8) ? 8 : 0
    tpMask += (scoreNorm >= 80 and zoneWidthTicks >= riskTicks * 0.6) ? 16 : 0

    [stopMask, beMask, tpMask]

// =============================
// ZONE CODE ENCODING
// =============================

// Demand Zones
export zoneCodeDemand(string zoneName, int autoIdx, string autoName) =>
    int zc = 0
    zc := (not na(autoIdx) and zoneName == autoName) ? (1100 + autoIdx) : zc
    zc := zc == 0 and zoneName == "DZ1" ? 101 : zc
    zc := zc == 0 and zoneName == "DZ2" ? 102 : zc
    zc := zc == 0 and zoneName == "DZ3" ? 103 : zc
    zc

// Supply Zones
export zoneCodeSupply(string zoneName, int autoIdx, string autoName) =>
    int zc = 0
    zc := (not na(autoIdx) and zoneName == autoName) ? (2100 + autoIdx) : zc
    zc := zc == 0 and zoneName == "SZ1" ? 201 : zc
    zc := zc == 0 and zoneName == "SZ2" ? 202 : zc
    zc := zc == 0 and zoneName == "SZ3" ? 203 : zc
    zc