//@version=6
indicator("WMA Crossover", overlay = true)

// Inputs
fastLen = input.int(8,  "Fast WMA Length")
slowLen = input.int(21, "Slow WMA Length")

// WMAs
fastWMA = ta.wma(close, fastLen)
slowWMA = ta.wma(close, slowLen)

// Crossover conditions
bullish = ta.crossover(fastWMA, slowWMA)
bearish = ta.crossunder(fastWMA, slowWMA)

// Plot WMAs
plot(fastWMA, color=color.green, linewidth=2, title="Fast WMA")
plot(slowWMA, color=color.red, linewidth=2, title="Slow WMA")

// Plot signals
plotshape(bullish, title="Buy", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(bearish, title="Sell", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
