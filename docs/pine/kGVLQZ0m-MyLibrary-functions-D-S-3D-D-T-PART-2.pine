////draw_line_123
export draw_line_123(bool zigzag_Indicator_ ,int scan_no_ ,int lw_ ,int hg_ ,int last_l_ ,int last_h_ ,int [] lw_D_POINT_ad_ ,int [] hg_D_POINT_ad_ ,string [] lw_D_POINT_id_ ,string [] hg_D_POINT_id_ ,int [] x_P_123_lw_ ,int [] x_P_123_hg_ ,int lw_D_P_1__ ,int lw_D_P_2__ ,int lw_D_P_3__ ,int lw_D_P_4__ ,int lw_D_P_5__ ,int hg_D_P_1__ ,int hg_D_P_2__ ,int hg_D_P_3__ ,int hg_D_P_4__ ,int hg_D_P_5__ ,int Num_last_lebel_for_scan_no_123_MS_ ,int Num_last_lebel_for_scan_no_123_MN_ ,float Source_Zigzag_123_F_low_ ,float Source_Zigzag_123_F_high_ ,bool MS_Div_123_ ,bool MN_Div_123_ ,bool Fibonacci_Retracement_123_ ,int x_P_lb_Re_Fib_123_ ,float y_P_lb_Re_Fib_123_ ,string N_Re_Fib_123_ ,string size_txt_lable_lb_ ,string Fibonacci_Re_text_ ,int line_thick_123_ ,string sty_line_123_ ,color upcolor_li_123_ ,color dncolor_li_123_ ,color upcolor_txt_123_ ,color dncolor_txt_123_) =>
    draw_line_(zigzag_Indicator_ ,array.indexof(x_P_123_lw_ , lw_D_P_1__) ,array.indexof(x_P_123_hg_ , hg_D_P_1__) ,scan_no_ ,lw_ ,hg_ ,last_l_ ,last_h_ ,lw_D_POINT_ad_ ,hg_D_POINT_ad_ ,lw_D_POINT_id_ ,hg_D_POINT_id_ ,x_P_123_lw_ ,x_P_123_hg_ ,Num_last_lebel_for_scan_no_123_MS_ ,Num_last_lebel_for_scan_no_123_MN_ ,Source_Zigzag_123_F_low_ ,Source_Zigzag_123_F_high_ ,MS_Div_123_ ,MN_Div_123_ ,Fibonacci_Retracement_123_ ,x_P_lb_Re_Fib_123_ ,y_P_lb_Re_Fib_123_ ,str.tostring(N_Re_Fib_123_) ,size_txt_lable_lb_ ,Fibonacci_Re_text_ ,line_thick_123_ ,sty_line_123_ ,upcolor_li_123_ ,dncolor_li_123_ ,upcolor_txt_123_ ,dncolor_txt_123_)
    draw_line_(zigzag_Indicator_ ,array.indexof(x_P_123_lw_ , lw_D_P_2__) ,array.indexof(x_P_123_hg_ , hg_D_P_2__) ,scan_no_ ,lw_ ,hg_ ,last_l_ ,last_h_ ,lw_D_POINT_ad_ ,hg_D_POINT_ad_ ,lw_D_POINT_id_ ,hg_D_POINT_id_ ,x_P_123_lw_ ,x_P_123_hg_ ,Num_last_lebel_for_scan_no_123_MS_ ,Num_last_lebel_for_scan_no_123_MN_ ,Source_Zigzag_123_F_low_ ,Source_Zigzag_123_F_high_ ,MS_Div_123_ ,MN_Div_123_ ,Fibonacci_Retracement_123_ ,x_P_lb_Re_Fib_123_ ,y_P_lb_Re_Fib_123_ ,str.tostring(N_Re_Fib_123_) ,size_txt_lable_lb_ ,Fibonacci_Re_text_ ,line_thick_123_ ,sty_line_123_ ,upcolor_li_123_ ,dncolor_li_123_ ,upcolor_txt_123_ ,dncolor_txt_123_)
    draw_line_(zigzag_Indicator_ ,array.indexof(x_P_123_lw_ , lw_D_P_3__) ,array.indexof(x_P_123_hg_ , hg_D_P_3__) ,scan_no_ ,lw_ ,hg_ ,last_l_ ,last_h_ ,lw_D_POINT_ad_ ,hg_D_POINT_ad_ ,lw_D_POINT_id_ ,hg_D_POINT_id_ ,x_P_123_lw_ ,x_P_123_hg_ ,Num_last_lebel_for_scan_no_123_MS_ ,Num_last_lebel_for_scan_no_123_MN_ ,Source_Zigzag_123_F_low_ ,Source_Zigzag_123_F_high_ ,MS_Div_123_ ,MN_Div_123_ ,Fibonacci_Retracement_123_ ,x_P_lb_Re_Fib_123_ ,y_P_lb_Re_Fib_123_ ,str.tostring(N_Re_Fib_123_) ,size_txt_lable_lb_ ,Fibonacci_Re_text_ ,line_thick_123_ ,sty_line_123_ ,upcolor_li_123_ ,dncolor_li_123_ ,upcolor_txt_123_ ,dncolor_txt_123_)
    draw_line_(zigzag_Indicator_ ,array.indexof(x_P_123_lw_ , lw_D_P_4__) ,array.indexof(x_P_123_hg_ , hg_D_P_4__) ,scan_no_ ,lw_ ,hg_ ,last_l_ ,last_h_ ,lw_D_POINT_ad_ ,hg_D_POINT_ad_ ,lw_D_POINT_id_ ,hg_D_POINT_id_ ,x_P_123_lw_ ,x_P_123_hg_ ,Num_last_lebel_for_scan_no_123_MS_ ,Num_last_lebel_for_scan_no_123_MN_ ,Source_Zigzag_123_F_low_ ,Source_Zigzag_123_F_high_ ,MS_Div_123_ ,MN_Div_123_ ,Fibonacci_Retracement_123_ ,x_P_lb_Re_Fib_123_ ,y_P_lb_Re_Fib_123_ ,str.tostring(N_Re_Fib_123_) ,size_txt_lable_lb_ ,Fibonacci_Re_text_ ,line_thick_123_ ,sty_line_123_ ,upcolor_li_123_ ,dncolor_li_123_ ,upcolor_txt_123_ ,dncolor_txt_123_)
    draw_line_(zigzag_Indicator_ ,array.indexof(x_P_123_lw_ , lw_D_P_5__) ,array.indexof(x_P_123_hg_ , hg_D_P_5__) ,scan_no_ ,lw_ ,hg_ ,last_l_ ,last_h_ ,lw_D_POINT_ad_ ,hg_D_POINT_ad_ ,lw_D_POINT_id_ ,hg_D_POINT_id_ ,x_P_123_lw_ ,x_P_123_hg_ ,Num_last_lebel_for_scan_no_123_MS_ ,Num_last_lebel_for_scan_no_123_MN_ ,Source_Zigzag_123_F_low_ ,Source_Zigzag_123_F_high_ ,MS_Div_123_ ,MN_Div_123_ ,Fibonacci_Retracement_123_ ,x_P_lb_Re_Fib_123_ ,y_P_lb_Re_Fib_123_ ,str.tostring(N_Re_Fib_123_) ,size_txt_lable_lb_ ,Fibonacci_Re_text_ ,line_thick_123_ ,sty_line_123_ ,upcolor_li_123_ ,dncolor_li_123_ ,upcolor_txt_123_ ,dncolor_txt_123_)

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////draw_point_123
export draw_point_123(bool zigzag_Indicator_123 ,bool points_ ,int lw ,int hg ,int last_l ,int last_h ,float Source_Zigzag_F_low ,float Source_Zigzag_F_high ,int [] arr_x_P_lw_ ,int [] arr_x_P_hg_ ,int Num_last_lebel_for_scan_no_123_MS_ ,int Num_last_lebel_for_scan_no_123_MN_ ,string size_points ,string style_label_upper ,string style_label_lower ,color upcolor_lebel ,color dncolor_lebel)=>

    _lw_hg_ = lw < hg ? 1 : lw > hg ? 2 : 0

    if zigzag_Indicator_123 == true and points_ == true
        line zz = na
        label point = na


        Last_P_M_MS_index = Num_last_lebel_for_scan_no_123_MS_
        Last_P_M_MN_index = Num_last_lebel_for_scan_no_123_MN_ 
        Last_P_M_MS_MN_index = nz(Num_last_lebel_for_scan_no_123_MS_) > nz(Num_last_lebel_for_scan_no_123_MN_) ? Last_P_M_MS_index : Last_P_M_MN_index 
        lw_hg_string = nz(Num_last_lebel_for_scan_no_123_MS_) > nz(Num_last_lebel_for_scan_no_123_MN_) ? 'lw' : 'hg' 
        [SD_1_MS_i_ ,SD_2_MS_i_ ,SD_3_MS_i_ ,OD_1_MS_i_ ,OD_2_MS_i_ ,OD_3_MS_i_] = Previous_piote(lw_hg_string ,arr_x_P_lw_ ,arr_x_P_hg_ ,Last_P_M_MS_MN_index)

        if (_lw_hg_ == _lw_hg_[1]) 
            // line.delete(zz[1])
            label.delete(point[1])
        ////////
        x1 = _lw_hg_ == 1 ? lw : _lw_hg_ == 2 ? hg : na 
        y1 = x1==lw ? Source_Zigzag_F_low[lw] : x1==hg ? Source_Zigzag_F_high[hg] : na 

        x2 = _lw_hg_ == 2 ? lw : _lw_hg_ == 1 ? hg : na 
        y2 = x2==lw ? Source_Zigzag_F_low[lw] : x2==hg ? Source_Zigzag_F_high[hg] : na 

        ////////
        style_lable   = lw < hg ? style_label_upper : lw > hg ? style_label_lower : na 
        color_lable   = lw < hg ? upcolor_lebel : lw > hg ? dncolor_lebel : na 
        lable_lable   = lw < hg ? Source_Zigzag_F_low[lw] < Source_Zigzag_F_low[last_l] ? 'LL' : 'HL' : lw > hg ? Source_Zigzag_F_high[hg] > Source_Zigzag_F_high[last_h] ? 'HH' : 'LH' : na
        tooltip_lable = lw < hg ? Source_Zigzag_F_low[lw] < Source_Zigzag_F_low[last_l] ? 'Lower Low' : 'Higher Low' : lw > hg ? Source_Zigzag_F_high[hg] > Source_Zigzag_F_high[last_h] ? 'Higher High' : 'Lower High' : na

        ////////
        if x1 != last_l
            // zz:= line.new(bar_index-x1, y1, bar_index-x2, y2, width=line_thick, color=color_lable)
            point := label.new(bar_index-x1, y1, lable_lable, style=style_lable, size=size_points, color=color_lable, textcolor=color.black, tooltip = tooltip_lable)

        i_ = SD_3_MS_i_
        // if i_ == -1  
        //     i_ := SD_2_MS_i_
        // if i_ == -1  
        //     i_ := SD_1_MS_i_
        // if i_ == -1  
        //     i_ := 1001 
        // if i_ > 0    
        //     for j = i_+1 to i_+(bar_index-i_)
        //         if j < 2000
        //         // line.delete(zz[j])
        //             label.delete(point[j])

