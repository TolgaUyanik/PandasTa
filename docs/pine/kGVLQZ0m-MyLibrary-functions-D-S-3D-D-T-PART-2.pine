library("MyLibrary_functions_D_S_3D_D_T_PART_2")

////////////////////////////////////////////////////////////////////////////////
////import
import WartlowS/MyLibrary_functions_D_S_3D_D_T_PART_1/1

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////Fibonacci x3_P to x2_P
export N_Re_Fib(float Source_low , float Source_high , int lw , int hg , int x3_P, int x1_P, int x2_P) =>
    N_Re_Fib = 0.0
// hg > lw
    if hg > lw
        if (x1_P < 300) and (x2_P < 300) and (x3_P < 300)
            N_Re_Fib := math.round(( ( math.log(Source_high[x2_P])/math.log(2) - math.log(Source_low[x1_P])/math.log(2) ) / ( math.log(Source_high[x2_P])/math.log(2) - math.log(Source_low[x3_P])/math.log(2) ) ),3)

// lw > hg
    if  lw > hg
        if (x1_P < 300) and (x2_P < 300) and (x3_P < 300)
            N_Re_Fib := math.round(( math.log(Source_high[x1_P])/math.log(2) - math.log(Source_low[x2_P])/math.log(2) ) / ( math.log(Source_high[x3_P])/math.log(2) - math.log(Source_low[x2_P])/math.log(2) ),3)

    [N_Re_Fib]

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////piote lable Fibonacci
export P_lb_Re_Fib( float Source_low , float Source_high , int lw , int hg , int x3_P, int x1_P) =>
    x_P_lb_Re_Fib = 0
    y_P_lb_Re_Fib = 0.0

    x_P_lb_Re_Fib := ( ( (x3_P) - (x1_P) ) / 2 ) + (x1_P)

// hg > lw
    if hg > lw
        if (x1_P < 300) and (x3_P < 300)
            y_P_lb_Re_Fib := ((((Source_low[x3_P])-(Source_low[x1_P]))/((x3_P)-(x1_P)))*((x_P_lb_Re_Fib)-(x3_P)))+(Source_low[x3_P])

// lw > hg
    if  lw > hg
        if (x1_P < 300) and (x3_P < 300)
            y_P_lb_Re_Fib := ((((Source_high[x3_P])-(Source_high[x1_P]))/((x3_P)-(x1_P)))*((x_P_lb_Re_Fib)-(x3_P)))+(Source_high[x3_P])

    [x_P_lb_Re_Fib , y_P_lb_Re_Fib]

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
///////label_New
export label_New(string lw_hg ,bool zigzag_Indicator_1_ ,bool zigzag_Indicator_2_ ,bool zigzag_Indicator_3_ ,int Number_Of_Labels_Printed_MS_MN ,int x1_ ,int i_ ,string label_id_ ,string style_lable_ ,color color_lable_ ,string size_txt_lable_ ,color color_txt_lable_)=>
    label label_name__  = na
    [label_txt_] = MyLibrary_functions_D_S_3D_D_T_PART_1.label_txt(str.tostring(str.match(str.substring((label_id_),3), "^..........................................................................................")) ,zigzag_Indicator_1_ ,zigzag_Indicator_2_ ,zigzag_Indicator_3_)
    source = lw_hg == 'lw' ? low : lw_hg == 'hg' ? high : na
    label.delete(label_name__[1])
    if (label_txt_ != "") and (Number_Of_Labels_Printed_MS_MN >= i_) and Number_Of_Labels_Printed_MS_MN > 0
        if x1_ < 1000
            label_name__ := label.new(bar_index - x1_, source[x1_], text=str.tostring(label_txt_), style=style_lable_, color=color_lable_, size=size_txt_lable_, textcolor=color_txt_lable_)

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////Num_last_lebel_for_scan_no
export Num_last_lebel_for_scan_no(int Number_Of_Labels_Printed_ , int [] array_ad , string [] array_id , int gap , string scan_no) =>

    int Num_last_lebel = -1
    if (array.size(array_ad) > 0) and (array.size(array_id) > 0) and Number_Of_Labels_Printed_ > 0
        for i = Number_Of_Labels_Printed_-1 to 0
            if (bar_index > array.get(array_ad , (i))) and (str.match(str.substring(array.get(array_id , (i)),gap), "^.") == scan_no)
                Num_last_lebel := array.get(array_ad , (i)) 
                break

    [Num_last_lebel]

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////Previous_piote
export Previous_piote(string lw_hg ,int [] arr_x_P_lw ,int [] arr_x_P_hg ,int Num_last_lebel_for_scan_no_MSMN)=>
    //
    arr_same_direction     = lw_hg == 'lw' ? arr_x_P_lw : lw_hg == 'hg' ? arr_x_P_hg : arr_x_P_lw
    arr_opposite_direction = lw_hg == 'lw' ? arr_x_P_hg : lw_hg == 'hg' ? arr_x_P_lw : arr_x_P_hg
    //
    // _1_previous period_same_direction
    int SD_1_ = -1
    int SD_1 = -1
    if array.size(arr_same_direction) > 0 and Num_last_lebel_for_scan_no_MSMN != -1
        SD_1_ := array.indexof(arr_same_direction ,Num_last_lebel_for_scan_no_MSMN) != -1 ? array.indexof(arr_same_direction ,Num_last_lebel_for_scan_no_MSMN)+1 : -1
        SD_1 := SD_1_ != -1 and SD_1_ < array.size(arr_same_direction) ? array.get(arr_same_direction,SD_1_) : -1

    // _2_previous period_same_direction
    int SD_2_ = -1
    int SD_2 = -1
    if array.size(arr_same_direction) > 0 and SD_1_ != -1 and SD_1 != -1
        SD_2_ := array.indexof(arr_same_direction ,SD_1) != -1 ? array.indexof(arr_same_direction ,SD_1)+1 : -1
        SD_2 := SD_2_ != -1 and SD_2_ < array.size(arr_same_direction) ? array.get(arr_same_direction,SD_2_) : -1

    // _3_previous period_same_direction
    int SD_3_ = -1
    int SD_3 = -1
    if array.size(arr_same_direction) > 0 and SD_2_ != -1 and SD_2 != -1
        SD_3_ := array.indexof(arr_same_direction ,SD_2) != -1 ? array.indexof(arr_same_direction ,SD_2)+1 : -1
        SD_3 := SD_3_ != -1 and SD_3_ < array.size(arr_same_direction) ? array.get(arr_same_direction,SD_3_) : -1

    //
    // _1_previous period_opposite_direction
    int OD_1_ = -1
    int OD_1 = -1
    if array.size(arr_opposite_direction) > 0 and Num_last_lebel_for_scan_no_MSMN != -1
        for i = 0 to array.size(arr_opposite_direction)-1
            if array.get(arr_opposite_direction , i) > Num_last_lebel_for_scan_no_MSMN
                OD_1_ := i
                OD_1 := array.get(arr_opposite_direction,i)
                break

    // _2_previous period_opposite_direction
    int OD_2_ = -1
    int OD_2 = -1
    if array.size(arr_opposite_direction) > 0 and OD_1_ != -1 and OD_1 != -1
        OD_2_ := array.indexof(arr_opposite_direction ,OD_1) != -1 ? array.indexof(arr_opposite_direction ,OD_1)+1 : -1
        OD_2 := OD_2_ != -1 and OD_2_ < array.size(arr_opposite_direction) ? array.get(arr_opposite_direction,OD_2_) : -1

    // _3_previous period_opposite_direction
    int OD_3_ = -1
    int OD_3 = -1
    if array.size(arr_opposite_direction) > 0 and OD_2_ != -1 and OD_2 != -1
        OD_3_ := array.indexof(arr_opposite_direction ,OD_2) != -1 ? array.indexof(arr_opposite_direction ,OD_2)+1 : -1
        OD_3 := OD_3_ != -1 and OD_3_ < array.size(arr_opposite_direction) ? array.get(arr_opposite_direction,OD_3_) : -1
                
    [SD_1 ,SD_2 ,SD_3 ,OD_1 ,OD_2 ,OD_3]

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////Required_drawing_information
export Required_drawing_information(int lw__ ,int hg__ ,int last_l__ ,int last_h__ ,float Source_Zigzag_low_ ,float Source_Zigzag_high_ ,color upcolor_li__ ,color dncolor_li__ ,color upcolor_txt__ ,color dncolor_txt__)=>

    lable_lable = ""
    tooltip_lable = ""
    if (lw__!=-1 and lw__<1000) and (hg__!=-1 and hg__<1000) and (last_l__!=-1 and last_l__<1000) and (last_h__!=-1 and last_h__<1000)  
        lable_lable   := lw__ < hg__ ? Source_Zigzag_low_[lw__] < Source_Zigzag_low_[last_l__] ? 'LL' : 'HL' : lw__ > hg__ ? Source_Zigzag_high_[hg__] > Source_Zigzag_high_[last_h__] ? 'HH' : 'LH' : na
        tooltip_lable := lw__ < hg__ ? Source_Zigzag_low_[lw__] < Source_Zigzag_low_[last_l__] ? 'Lower Low' : 'Higher Low' : lw__ > hg__ ? Source_Zigzag_high_[hg__] > Source_Zigzag_high_[last_h__] ? 'Higher High' : 'Lower High' : na
    color_line  = lw__ > hg__ ? upcolor_li__ : lw__ < hg__ ? dncolor_li__ : dncolor_li__
    color_lable = lw__ > hg__ ? dncolor_li__ : lw__ < hg__ ? upcolor_li__ : dncolor_li__
    color_lable_txt = lw__ > hg__ ? dncolor_txt__ : lw__ < hg__ ? upcolor_txt__ : dncolor_txt__

    [lable_lable ,tooltip_lable ,color_line ,color_lable ,color_lable_txt]

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////draw_line_
export draw_line_(bool zigzag_Indicator_ ,int i__lw ,int i__hg ,int Scan_No ,int lw_ ,int hg_ ,int last_l_ ,int last_h_ ,int [] arr_ad_lw_ ,int [] arr_ad_hg_ ,string [] arr_id_lw_ ,string [] arr_id_hg_ ,int [] arr_x_P_lw_ ,int [] arr_x_P_hg_ ,int Num_last_lebel_for_scan_no_123_MS_ ,int Num_last_lebel_for_scan_no_123_MN_ ,float Source_Zigzag_low_ ,float Source_Zigzag_high_ ,bool MS_Div_ ,bool MN_Div_ ,bool Fibonacci_Retracement_ ,int x_P_lb_Re_Fib_ ,float y_P_lb_Re_Fib_ ,string N_Re_Fib_ ,string size_txt_lable ,string Fibonacci_txt ,int line_thick_ ,string sty_line_ ,color upcolor_li_ ,color dncolor_li_ ,color upcolor_txt_ ,color dncolor_txt_)=>
    ////
    int i_lw_ = 100000
    line MS_pr_li_Div__lw = na
    int lw__lw = na
    int hg__lw = na
    int last_l__lw = na
    int last_h__lw = na
    //
    int X1_lw = na
    float Y1_lw = na
    int X2_lw = na
    float Y2_lw = na
    int X3_lw = na
    float Y3_lw = na
    ////
    int i_hg_ = 100000
    line MN_pr_li_Div__hg = na
    int lw__hg = na
    int hg__hg = na
    int last_l__hg = na
    int last_h__hg = na
    //
    int X1_hg = na
    float Y1_hg = na
    int X2_hg = na
    float Y2_hg = na
    int X3_hg = na
    float Y3_hg = na
    //
    label N_Re_Fib_lb_ = na
    //
    line.delete(MS_pr_li_Div__lw[1])
    line.delete(MN_pr_li_Div__hg[1])
    label.delete(N_Re_Fib_lb_[1])
    //
    //lw
    i_lw=i__lw
    // if array.size(arr_x_P_lw_) > i_lw 
    if array.size(arr_x_P_lw_) > i_lw and i_lw != -1
        i_lw_ := array.get(arr_x_P_lw_ , i_lw) 
        [SD_1_MS_i_lw ,SD_2_MS_i_lw ,SD_3_MS_i_lw ,OD_1_MS_i_lw ,OD_2_MS_i_lw ,OD_3_MS_i_lw] = Previous_piote('lw' ,arr_x_P_lw_ ,arr_x_P_hg_ ,i_lw_)
        lw__lw     := i_lw_        
        hg__lw     := OD_1_MS_i_lw 
        last_l__lw := SD_1_MS_i_lw 
        last_h__lw := OD_2_MS_i_lw 
        //
        X1_lw := i_lw_
        Y1_lw := X1_lw < 1000 and X1_lw >= 0 ? Source_Zigzag_low_[X1_lw] : na
        //
        X2_lw := OD_1_MS_i_lw
        Y2_lw := X2_lw < 1000 and X2_lw >= 0 ? Source_Zigzag_high_[X2_lw] : na  
        //
        X3_lw := SD_1_MS_i_lw
        Y3_lw := X3_lw < 1000 and X3_lw >= 0 ? Source_Zigzag_low_[X3_lw] : na   
        //
    ////
    [lable_lable_i_lw ,tooltip_lable_i_lw ,color_line_i_lw ,color_lable_i_lw ,color_lable_txt_i_lw] = Required_drawing_information(lw__lw ,hg__lw ,last_l__lw ,last_h__lw ,Source_Zigzag_low_ ,Source_Zigzag_high_ ,upcolor_li_ ,dncolor_li_ ,upcolor_txt_ ,dncolor_txt_)

    //hg
    i_hg=i__hg
    if array.size(arr_x_P_hg_) > i_hg and i_hg != -1
    // if array.size(arr_x_P_hg_) > i_hg 
        i_hg_ := array.get(arr_x_P_hg_ , i_hg) 
        [SD_1_MN_i_hg ,SD_2_MN_i_hg ,SD_3_MN_i_hg ,OD_1_MN_i_hg ,OD_2_MN_i_hg ,OD_3_MN_i_hg] = Previous_piote('hg' ,arr_x_P_lw_ ,arr_x_P_hg_ ,i_hg_)
        lw__hg     := OD_1_MN_i_hg 
        hg__hg     := i_hg_        
        last_l__hg := OD_2_MN_i_hg 
        last_h__hg := SD_1_MN_i_hg 
        //
        X1_hg := i_hg_
        Y1_hg := X1_hg < 1000 and X1_hg >= 0 ? Source_Zigzag_high_[X1_hg] : na
        //
        X2_hg := OD_1_MN_i_hg
        Y2_hg := X2_hg < 1000 and X2_hg >= 0 ? Source_Zigzag_low_[X2_hg] : na 
        //
        X3_hg := SD_1_MN_i_hg
        Y3_hg := X3_hg < 1000 and X3_hg >= 0 ? Source_Zigzag_high_[X3_hg] : na  
        //
    ////
    [lable_lable_i_hg ,tooltip_lable_i_hg ,color_line_i_hg ,color_lable_i_hg ,color_lable_txt_i_hg] = Required_drawing_information(lw__hg ,hg__hg ,last_l__hg ,last_h__hg ,Source_Zigzag_low_ ,Source_Zigzag_high_ ,upcolor_li_ ,dncolor_li_ ,upcolor_txt_ ,dncolor_txt_)
 
    if zigzag_Indicator_ == true 
        ////
        if i_lw_ <= Num_last_lebel_for_scan_no_123_MS_ and i_lw != -1
            if array.indexof(arr_ad_lw_ ,i_lw_) != -1 
                if (array.size(arr_id_lw_) > 0) and (array.size(arr_ad_lw_) > 0)
                    if str.match(str.substring(array.get(arr_id_lw_ ,array.indexof(arr_ad_lw_ ,i_lw_)),Scan_No-1), "^.") == str.tostring(Scan_No)
                        if (X1_lw<1000) 
                            MS_pr_li_Div__lw := line.new(bar_index-X1_lw,Y1_lw,bar_index-X3_lw,Y3_lw, width = line_thick_, style = sty_line_, color = color_lable_i_lw)
        if i_hg_ <= Num_last_lebel_for_scan_no_123_MN_ and i_hg != -1
            if array.indexof(arr_ad_hg_ ,i_hg_) != -1 
                if (array.size(arr_id_hg_) > 0) and (array.size(arr_ad_hg_) > 0)
                    if str.match(str.substring(array.get(arr_id_hg_ ,array.indexof(arr_ad_hg_ ,i_hg_)),Scan_No-1), "^.") == str.tostring(Scan_No)
                        if (X1_hg<1000) 
                            MN_pr_li_Div__hg := line.new(bar_index-X1_hg,Y1_hg,bar_index-X3_hg,Y3_hg, width = line_thick_, style = sty_line_, color = color_lable_i_hg)
        //Fibonacci_Retracement
        if Fibonacci_Retracement_ == true and (x_P_lb_Re_Fib_<1000) and (lw_ < hg_ ? i_lw_ <= Num_last_lebel_for_scan_no_123_MS_ : lw_ > hg_ ? i_hg_ <= Num_last_lebel_for_scan_no_123_MN_ : false)
            if (last_l_ != last_h_) and (MS_Div_ == true or MN_Div_ == true)
                N_Re_Fib_lb_ := label.new(bar_index-x_P_lb_Re_Fib_,y_P_lb_Re_Fib_, str.tostring(N_Re_Fib_), style=label.style_label_center , size=size_txt_lable, color=(lw_ < hg_ ? color_lable_i_hg : lw_ > hg_ ? color_lable_i_lw : color_lable_i_lw) , textcolor=(lw_ < hg_ ? color_lable_txt_i_hg : lw_ > hg_ ? color_lable_txt_i_lw : color_lable_txt_i_lw) , tooltip = Fibonacci_txt)

