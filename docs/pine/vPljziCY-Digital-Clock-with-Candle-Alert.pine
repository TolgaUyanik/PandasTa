//@version=6
// ===================================
// Digital Clock with Candle Alert
// ===================================
// Author: Filipe Teixeira Amaral
// Version: 1.0
// Last Updated: January 2025
//
// Description:
// A customizable digital clock that displays real-time on your chart with visual alerts
// before new candle formation. Features include timezone selection, custom colors,
// position control, and configurable blinking alerts.
//
// Features:
// • Real-time digital clock display with seconds
// • Customizable timezone (Exchange, UTC, NY, London, Tokyo, Sydney)
// • Visual blinking alert before new candle formation
// • Configurable alert timing (5 seconds to 1 hour)
// • Custom colors for normal and alert states
// • Adjustable size and position on chart
// • Half-second blinking frequency for better visibility
//
// Note: Updates are dependent on incoming price ticks. During low-volume periods,
// the clock may not update every second.
// ===================================

indicator('Digital Clock with Candle Alert', overlay=true)

// Time configuration
timeZoneInput = input.string('Exchange', 'Timezone', options=['Exchange', 'UTC', 'America/New_York', 'Europe/London', 'Asia/Tokyo', 'Australia/Sydney'])

// Color configuration
textColor = input.color(color.white, 'Text Color')
bgColor = input.color(color.black, 'Background Color')
blinkTextColor = input.color(color.black, 'Blink Text Color')
blinkBgColor = input.color(color.red, 'Blink Background Color')

// Size configuration
textSize = input.string('normal', 'Text Size', options=['tiny', 'small', 'normal', 'large', 'huge', 'auto'])

// Position configuration
tablePosition = input.string('top_center', 'Position', options=['top_left', 'top_center', 'top_right', 'middle_left', 'middle_center', 'middle_right', 'bottom_left', 'bottom_center', 'bottom_right'])

// Blinking configuration
enableBlink = input.bool(true, 'Enable Blinking Before New Candle')
blinkTimeframe = input.timeframe('15', 'Blink for New Candle Timeframe')
blinkSecondsStr = input.string('10 seconds', 'Time Before New Candle to Start Blinking', options=['5 seconds', '10 seconds', '15 seconds', '30 seconds', '45 seconds', '1 minute', '2 minutes', '3 minutes', '5 minutes', '10 minutes', '15 minutes', '30 minutes', '1 hour'])

// Convert blink time string to seconds
getBlinkSeconds(timeStr) =>
    switch timeStr
        '5 seconds' => 5
        '10 seconds' => 10
        '15 seconds' => 15
        '30 seconds' => 30
        '45 seconds' => 45
        '1 minute' => 60
        '2 minutes' => 120
        '3 minutes' => 180
        '5 minutes' => 300
        '10 minutes' => 600
        '15 minutes' => 900
        '30 minutes' => 1800
        '1 hour' => 3600
        => 10

blinkSeconds = getBlinkSeconds(blinkSecondsStr)

// Convert position string to table position
getTablePosition(pos) =>
    switch pos
        'top_left' => position.top_left
        'top_center' => position.top_center
        'top_right' => position.top_right
        'middle_left' => position.middle_left
        'middle_center' => position.middle_center
        'middle_right' => position.middle_right
        'bottom_left' => position.bottom_left
        'bottom_center' => position.bottom_center
        'bottom_right' => position.bottom_right
        => position.top_center

// Convert size string to size constant
getTextSize(sz) =>
    switch sz
        'tiny' => size.tiny
        'small' => size.small
        'normal' => size.normal
        'large' => size.large
        'huge' => size.huge
        'auto' => size.auto
        => size.normal

// Interpret "Exchange" as the chart's exchange timezone
tz = timeZoneInput == 'Exchange' ? syminfo.timezone : timeZoneInput

// Create table with configurable position
var table clkTable = table.new(getTablePosition(tablePosition), 1, 1, border_width=0)

// Variable to track last second
var int lastSecond = -1

// Update clock on every tick
if barstate.isconfirmed or barstate.isrealtime
    // Get current time components using timenow for real-time updates
    currentTime = timenow
    h = hour(currentTime, tz)
    m = minute(currentTime, tz)
    s = second(currentTime, tz)
    
    // Get milliseconds for half-second blinking
    ms = (currentTime % 1000)
    
    // Calculate if we should blink based on selected timeframe
    shouldBlink = false
    secondsUntilNew = 999999
    
    if enableBlink
        // Get the timeframe in seconds
        tfSeconds = timeframe.in_seconds(blinkTimeframe)
        
        // Calculate seconds until next candle based on timeframe
        if tfSeconds == 60 // 1 minute
            secondsUntilNew := 60 - s
        else if tfSeconds == 300 // 5 minutes
            minuteInPeriod = m % 5
            secondsInPeriod = minuteInPeriod * 60 + s
            secondsUntilNew := 300 - secondsInPeriod
        else if tfSeconds == 900 // 15 minutes
            minuteInPeriod = m % 15
            secondsInPeriod = minuteInPeriod * 60 + s
            secondsUntilNew := 900 - secondsInPeriod
        else if tfSeconds == 1800 // 30 minutes
            minuteInPeriod = m % 30
            secondsInPeriod = minuteInPeriod * 60 + s
            secondsUntilNew := 1800 - secondsInPeriod
        else if tfSeconds == 3600 // 1 hour
            secondsInPeriod = m * 60 + s
            secondsUntilNew := 3600 - secondsInPeriod
        else if tfSeconds == 14400 // 4 hours
            hourInPeriod = h % 4
            secondsInPeriod = hourInPeriod * 3600 + m * 60 + s
            secondsUntilNew := 14400 - secondsInPeriod
        else if tfSeconds == 86400 // Daily
            secondsInPeriod = h * 3600 + m * 60 + s
            secondsUntilNew := 86400 - secondsInPeriod
        
        // Check if we should blink
        shouldBlink := secondsUntilNew <= blinkSeconds
    
    // Only update if the second has changed OR if we're blinking (for half-second updates)
    updateNeeded = s != lastSecond or (shouldBlink and barstate.isrealtime)
    
    if updateNeeded
        if s != lastSecond
            lastSecond := s
        
        // Format time string with leading zeros
        hStr = h < 10 ? '0' + str.tostring(h) : str.tostring(h)
        mStr = m < 10 ? '0' + str.tostring(m) : str.tostring(m)
        sStr = s < 10 ? '0' + str.tostring(s) : str.tostring(s)
        clockStr = hStr + ':' + mStr + ':' + sStr
        
        // Blinking logic - alternate colors every half second
        // Use milliseconds to determine if we're in first or second half of the second
        blink = shouldBlink and (ms < 500)
        displayTextColor = blink ? blinkTextColor : textColor
        displayBgColor = blink ? blinkBgColor : bgColor
        
        // Update table with new values
        table.cell(clkTable, 0, 0, clockStr, text_color=displayTextColor, bgcolor=displayBgColor, text_size=getTextSize(textSize))
else
    // For historical bars, just show a static clock with the bar's time
    h = hour(time, tz)
    m = minute(time, tz)
    s = 0 // Historical bars don't have second precision
    
    hStr = h < 10 ? '0' + str.tostring(h) : str.tostring(h)
    mStr = m < 10 ? '0' + str.tostring(m) : str.tostring(m)
    clockStr = hStr + ':' + mStr + ':00'
    
    table.cell(clkTable, 0, 0, clockStr, text_color=textColor, bgcolor=bgColor, text_size=getTextSize(textSize))

// Plot invisible value to force updates
plot(close, display=display.none)