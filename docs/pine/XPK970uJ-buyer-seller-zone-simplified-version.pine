//@version=6
indicator("Buyer/Seller Zone (Simplified Version)", overlay=true)

// === Filter Parameters ===
volLength      = input.int(20, "Volume Period")
volMult2       = input.float(2.0, "Volume Filter")
bodyLookback   = input.int(20, "Body Volatility Lookback", options=[10, 20, 30])
bodyRankThresh = input.float(0.9, "Volatility Threshold (top %)")
minBodyRatio   = input.float(0.3, "Min. Body-to-Range Ratio", minval=0.0, maxval=1.0)

// === Display Settings ===
shapeType      = input.string("area", "Display Type", options=["area", "circle", "diamond"])
shapeSizeNum   = input.int(20, "Label Size (in pixels)", minval=1, maxval=100)
shapeTransparency = input.int(85, "Transparency", minval=0, maxval=100)
boxBorderWidth = input.int(1, "Box Border Width", minval=0, maxval=5)
areaLength     = input.int(50, "Box Length (in bars)")
areaBodyPart   = input.float(0.25, "Box Height Relative to Candle Body")

// === Anomalous Volume ===
volMA    = ta.sma(volume, volLength)
volSTD   = ta.stdev(volume, volLength)
volThres = volMA + volMult2 * volSTD
isAnomalyVol = volume > volThres

// === Candle Volatility ===
fullRange = high - low
bodySize = math.abs(close - open)
var float[] bodyList = array.new_float()
var float thresholdBody = na
isVolatile = false
if bar_index > bodyLookback
    array.clear(bodyList)
    for i = 1 to bodyLookback
        array.push(bodyList, high[i] - low[i])
    sorted = array.copy(bodyList)
    array.sort(sorted, order.descending)
    rankIndex = math.floor(bodyRankThresh * bodyLookback)
    thresholdBody := array.get(sorted, rankIndex)
    isVolatile := fullRange >= thresholdBody and (bodySize / fullRange >= minBodyRatio)

// === Signals ===
isBullish = close > open
isBearish = close < open
isSignalBull = isAnomalyVol and isVolatile and isBullish
isSignalBear = isAnomalyVol and isVolatile and isBearish

// === Signal Display ===
if isSignalBull
    if shapeType == "area"
        float boxLow = math.min(open, close)
        float boxHeight = math.abs(close - open) * areaBodyPart
        float boxTop = boxLow + boxHeight
        box.new(left=bar_index, right=bar_index + areaLength, top=boxTop, bottom=boxLow, bgcolor=color.new(color.green, shapeTransparency), border_color=color.green, border_width=boxBorderWidth)
    else
        label.new(x=bar_index, y=open, style=shapeType == "circle" ? label.style_circle : label.style_diamond, color=color.new(color.green, shapeTransparency), size=size.small, text="", textcolor=color.white)

if isSignalBear
    if shapeType == "area"
        float boxHigh = math.max(open, close)
        float boxHeight = math.abs(close - open) * areaBodyPart
        float boxBottom = boxHigh - boxHeight
        box.new(left=bar_index, right=bar_index + areaLength, top=boxHigh, bottom=boxBottom, bgcolor=color.new(color.red, shapeTransparency), border_color=color.red, border_width=boxBorderWidth)
    else
        label.new(x=bar_index, y=open, style=shapeType == "circle" ? label.style_circle : label.style_diamond, color=color.new(color.red, shapeTransparency), size=size.small, text="", textcolor=color.white)

// === Alerts ===
alertcondition(isSignalBull, title="🔔 Buyer Signal", message="Strong buyer detected")
alertcondition(isSignalBear, title="🔔 Seller Signal", message="Strong seller detected")
alertcondition(isSignalBull or isSignalBear, title="🔔 Signal Alert", message="Signal detected: strong buyer or seller")