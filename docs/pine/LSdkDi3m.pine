        "MEME-USDT-SWAP" => true
        "MEW-USDT-SWAP" => true
        "MSN-USDT-SWAP" => true
        "NOT-USDT-SWAP" => true
        "ONT-USDT-SWAP" => true
        "OP-USDT-SWAP" => true
        "ORDI-USDT-SWAP" => true
        "PEOPLE-USDT-SWAP" => true
        "PEPE-USDT-SWAP" => true
        "SHIB-USDT-SWAP" => true
        "SLP-USDT-SWAP" => true
        "SOL-USDT-SWAP" => true
        "STRK-USDT-SWAP" => true
        "SUI-USDT-SWAP" => true
        "TON-USDT-SWAP" => true
        "TRB-USDT-SWAP" => true
        "TURBO-USDT-SWAP" => true
        "UMA-USDT-SWAP" => true
