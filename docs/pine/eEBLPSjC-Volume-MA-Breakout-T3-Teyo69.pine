//@version=6
indicator("Volume MA Breakout T3 [Teyo69]",overlay = false)
import TradingView/ta/10
inpt_ma_len = input.int(14,title = "Length",group = "Moving Average")
inpt_ma_method = input.string(defval = "SMA",title = "Method",group = "Moving Average",options = ["SMA","EMA","Double EMA"])
vol_ma = switch inpt_ma_method
    "SMA" =>
        ta.sma(volume,inpt_ma_len)
    "EMA" =>
        ta.ema(volume,inpt_ma_len)
    "Double EMA" =>
        ta.dema(volume,inpt_ma_len)

vol_color = volume > vol_ma ? color.green : color.red
plot(volume,title = "Volume",color = vol_color,style = plot.style_columns)
