//@version=6
indicator("BYB trade Hammer HL-LH", overlay=true)

//=====================
// INPUTS
//=====================
fastEMA = input.int(50, "Fast EMA")
slowEMA = input.int(200, "Slow EMA")

ema50 = ta.ema(close, fastEMA)
ema200 = ta.ema(close, slowEMA)

plot(ema50, color=color.green)
plot(ema200, color=color.red)

//=====================
// TREND
//=====================
upTrend = ema50 > ema200
downTrend = ema50 < ema200

//=====================
// HAMMER
//=====================
body = math.abs(close-open)
lowerShadow = math.min(open,close)-low
upperShadow = high-math.max(open,close)

hammer = lowerShadow > body*2 and upperShadow < body

//=====================
// SHOOTING STAR
//=====================
shootingStar = upperShadow > body*2 and lowerShadow < body

//=====================
// HIGHER LOW
//=====================
higherLow = low > low[1]

//=====================
// LOWER HIGH
//=====================
lowerHigh = high < high[1]

//=====================
// SIGNAL
//=====================
buy = upTrend and hammer and higherLow
sell = downTrend and shootingStar and lowerHigh

plotshape(buy,
style=shape.labelup,
location=location.belowbar,
color=color.lime,
text="BUY")

plotshape(sell,
style=shape.labeldown,
location=location.abovebar,
color=color.red,
text="SELL")

alertcondition(buy,"BUY","BYB BUY")
alertcondition(sell,"SELL","BYB SELL")