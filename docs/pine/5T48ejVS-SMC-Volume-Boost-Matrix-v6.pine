//@version=6
indicator("SMC Volume Boost Matrix v6", overlay=true)

// Inputs
macdFast = input.int(12, title="MACD Fast Length")
macdSlow = input.int(26, title="MACD Slow Length")
macdSignal = input.int(9, title="MACD Signal Length")
volumeThreshold = input.float(1.5, title="Volume Multiplier for Boost")

// Calculations
[macdLine, signalLine, _] = ta.macd(close, macdFast, macdSlow, macdSignal)
avgVolume = ta.sma(volume, 20)

// Trend & Volume Conditions
bullishTrend = macdLine > signalLine
bearishTrend = macdLine < signalLine
highVolume = volume > (avgVolume * volumeThreshold)

// Signals
buyBoost = bullishTrend and highVolume and ta.crossover(close, ta.highest(high, 5)[1])
sellBoost = bearishTrend and highVolume and ta.crossunder(close, ta.lowest(low, 5)[1])

// Visualizing Order Blocks / Support-Resistance Zones dynamically
var float topZone = na
var float bottomZone = na

if buyBoost
    topZone := high
    bottomZone := low
if sellBoost
    topZone := high
    bottomZone := low

// Plotting Dynamic Boost Zones
p1 = plot(topZone, color=color.new(color.green, 50), linewidth=1, title="Upper Boost Zone", style=plot.style_stepline)
p2 = plot(bottomZone, color=color.new(color.red, 50), linewidth=1, title="Lower Boost Zone", style=plot.style_stepline)
fill(p1, p2, color=bullishTrend ? color.new(color.green, 95) : color.new(color.red, 95), title="Zone Fill")

// Plot Signals
plotshape(buyBoost, title="Institutional BUY", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, text="🚀 BUY BOOST", size=size.normal)
plotshape(sellBoost, title="Institutional SELL", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, text="💥 SELL BOOST", size=size.normal)

// Alerts
alertcondition(buyBoost, title="Alert: Big Money BUY", message="Volume and Trend confirmed a massive BUY breakout!")
alertcondition(sellBoost, title="Alert: Big Money SELL", message="Volume and Trend confirmed a massive SELL breakdown!")
//@version=6
