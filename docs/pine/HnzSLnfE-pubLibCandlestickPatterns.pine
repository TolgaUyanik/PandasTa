//@version=6

// @description candlestick pattern conditions for indicator and strategy development
library("pubLibCandlestickPatterns")

///////////////////////
// Generic Variables //
///////////////////////

green_candle = close >= open
red_candle = close < open

candle_body = close >= open ? close - open : open - close
candle_range = high - low
upper_wick = close >= open ? high - close : high - open
lower_wick = close >= open ? open - low : close - low

body_wick_ratio = candle_body / candle_range * 100

rising_gap = open > close[1] and open - close[1] >= candle_range[1] * 0.1
falling_gap = open < close[1] and close[1] - open >= candle_range[1] * 0.1

sig_rising_gap = open > close[1] and open - close[1] >= candle_range[1] * 0.5
sig_falling_gap = open < close[1] and close[1] - open >= candle_range[1] * 0.5

gap_high = open > high[1] and open - high[1] >= candle_range[1] * 0.1
gap_low = open < low[1] and low[1] - open >= candle_range[1] * 0.1

rising_window = low > high[1] and low - high[1] >= candle_range[1] * 0.1
falling_window = high < low[1] and low[1] - high >= candle_range[1] * 0.1

green_kicker = open > open[1] and open - open[1] >= candle_range[1] * 0.5
red_kicker = open < open[1] and open[1] - open >= candle_range[1] * 0.5

//////////////////////////
// Candlestick Patterns //
//////////////////////////

// @function doji candlestick pattern condition
// @returns bool

export doji() =>
 body_wick_ratio <= 5

doji = doji()

// @function bullish marubozu candlestick pattern condition
// @returns bool 

export bull_marubozu() =>
 green_candle
 and body_wick_ratio >= 95

bull_marubozu = bull_marubozu()

// @function bearish marubozu candlestick pattern condition
// @returns bool 

export bear_marubozu() =>
 red_candle
 and body_wick_ratio >= 95

bear_marubozu = bear_marubozu()

// @function spinning top candlestick pattern condition
// @returns bool

export spinning_top() =>
 (not doji) 
 and body_wick_ratio <= 30

spinning_top = spinning_top()

// @function bullish belt-hold line candlestick pattern condition
// @returns bool

export bull_belt_hold_line() =>
 (not bull_marubozu)
 and green_candle
 and body_wick_ratio >= 80
 
// @function bearish belt-hold line candlestick pattern condition
// @returns bool 

export bear_belt_hold_line() =>
 (not bear_marubozu)
 and red_candle
 and body_wick_ratio >= 80

// @function bullish breakaway candlestick pattern condition
// @returns bool 

export bull_breakaway() =>
 green_candle 
 and red_candle[1] 
 and red_candle[3]
 and red_candle[4]
 and body_wick_ratio[4] >= 70
 and sig_falling_gap[3]
 and close >= open[3]
 and close <= close[4]
 and close[1] < close[2]
 and close[2] < close[3]
 
// @function bearish breakaway candlestick pattern condition
// @returns bool 

export bear_breakaway() =>
 red_candle
 and green_candle[1]
 and green_candle[3]
 and green_candle[4]
 and body_wick_ratio[4] >= 70
 and sig_rising_gap[3]
 and close <= open[3]
 and close >= close[4]
 and close[1] > close[2]
 and close[2] > close[3]

// @function concealing baby swallow candlestick pattern condition
// @returns bool 

export concealing_baby_swallow() =>
 bear_marubozu[2]
 and bear_marubozu[3]
 and red_candle
 and red_candle[1]
 and upper_wick[1] >= candle_range[1] * 0.4
 and falling_gap[1]
 and high[1] >= close[2]
 and open >= high[1]
 and close <= low[1]

// @function bullish counterattack candlestick pattern condition
// @returns bool

export bull_counterattack() =>
 green_candle
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 and sig_falling_gap
 and close == close[1]

// @function bearish counterattack candlestick pattern condition
// @returns bool 

export bear_counterattack() =>
 red_candle
 and green_candle[1]
 and body_wick_ratio[1] >= 70
 and sig_rising_gap
 and close == close[1]

// @function dark cloud cover candlestick pattern condition
// @returns bool 

export dark_cloud_cover() =>
 red_candle
 and green_candle[1]
 and body_wick_ratio[1] >= 70
 and gap_high
 and close > open[1]
 and close <= close[1] - (candle_body[1] * 0.5)

// @function long-legged doji candlestick pattern condition
// @returns bool

export long_legged_doji() =>
 doji
 and upper_wick >= candle_range * 0.4
 and lower_wick >= candle_range * 0.4

// @function southern doji candlestick pattern condition
// @returns bool

export southern_doji() =>
 doji
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 
// @function northern doji candlestick pattern condition
// @returns bool 

export northern_doji() =>
 doji
 and green_candle[1]
 and body_wick_ratio[1] >= 70

// @function dumpling top candlestick pattern condition
// @returns bool 

export dumpling_top() => 
 red_candle
 and sig_falling_gap
 and high[1] < high[2]
 and high[2] <= high[3]
 and high[3] >= high[4]
 and high[4] >= high[5]
 and high[5] >= high[6]
 and high[6] >= high[7]
 and high[7] > high[8]

// @function bullish engulfing candlestick pattern condition
// @returns bool

export bull_engulfing() =>
 green_candle 
 and red_candle[1]
 and open <= close[1]
 and close > open[1]

// @function bearish engulfing candlestick pattern condition
// @returns bool 

export bear_engulfing() =>
 red_candle 
 and green_candle[1]
 and open >= close[1]
 and close < open[1]

// @function frypan bottom candlestick pattern condition
// @returns bool

export frypan_bottom() => 
 green_candle
 and sig_rising_gap
 and low[1] > low[2]
 and low[2] >= low[3]
 and low[3] <= low[4]
 and low[4] <= low[5]
 and low[5] <= low[6]
 and low[6] <= low[7]
 and low[7] < low[8]

// @function hammer candlestick pattern condition
// @returns bool

export hammer() =>
 spinning_top
 and red_candle[1] 
 and body_wick_ratio[1] >= 70
 and upper_wick <= candle_body / 2
 and lower_wick >= candle_body * 2

// @function hanging man candlestick pattern condition
// @returns bool 

export hanging_man() =>
 spinning_top
 and green_candle[1]
 and body_wick_ratio[1] >= 70
 and upper_wick <= candle_body / 2
 and lower_wick >= candle_body * 2

// @function bullish harami candlestick pattern condition
// @returns bool

export bull_harami() =>
 spinning_top
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 and open < open[1]
 and open > close[1]
 and close < open[1]
 and close > close[1]

// @function bearish harami candlestick pattern condition
// @returns bool 

export bear_harami() =>
 spinning_top
 and green_candle[1]
 and body_wick_ratio[1] >= 70
 and open > open[1]
 and open < close[1]
 and close > open[1]
 and close < close[1]
 
// @function bullish harami cross candlestick pattern condition
// @returns bool

export bull_harami_cross() =>
 doji
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 and open < open[1]
 and open >= close[1]
 and close < open[1]
 and close > close[1]
 
// @function bearish harami cross candlestick pattern condition
// @returns bool 

export bear_harami_cross() =>
 doji
 and green_candle[1]
 and body_wick_ratio[1] >= 70
 and open > open[1]
 and open <= close[1]
 and close > open[1]
 and close < close[1]

// @function high-wave candlestick pattern condition
// @returns bool

export high_wave() =>
 spinning_top
 and upper_wick >= candle_range * 0.4
 and lower_wick >= candle_range * 0.4

// @function bullish hikkake candlestick pattern condition
// @returns bool 

export bull_hikkake() =>
 high < high[1]
 and high[1] < high[2]
 and low < low[1]
 and low[1] > low[2]
 
// @function bearish hikkake candlestick pattern condition
// @returns bool 

export bear_hikkake() =>
 high > high[1]
 and high[1] < high[2]
 and low > low[1]
 and low[1] > low[2]

// @function homing pigeon candlestick pattern condition
// @returns bool 

export homing_pigeon() =>
 red_candle
 and red_candle[1]
 and open < open[1]
 and close > close[1]

// @function in-neck candlestick pattern condition
// @returns bool

export in_neck() =>
 green_candle
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 and gap_low
 and close > close[1]
 and close <= close[1] + (candle_body[1] * 0.2)
 
// @function bullish kicking candlestick pattern condition
// @returns bool 

export bull_kicking() =>
 bull_marubozu
 and bear_marubozu[1]
 and green_kicker

// @function bearish kicking candlestick pattern condition
// @returns bool 

export bear_kicking() =>
 bear_marubozu
 and bull_marubozu[1]
 and red_kicker

// @function matching low candlestick pattern condition
// @returns bool 

export matching_low() =>
 red_candle 
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 and close == close[1]

// @function on-neck candlestick pattern condition
// @returns bool

export on_neck() =>
 green_candle 
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 and gap_low
 and close >= low[1]
 and close <= close[1]

// @function piercing candlestick pattern condition
// @returns bool

export piercing() =>
 green_candle
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 and gap_low
 and close < open[1]
 and close >= close[1] + (candle_body[1] * 0.5)

// @function bullish separating lines candlestick pattern condition
// @returns bool 

export bull_separating_lines() =>
 green_candle
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 and sig_rising_gap
 and open == open[1]

// @function bearish separating lines candlestick pattern condition
// @returns bool 

export bear_separating_lines() =>
 red_candle
 and green_candle[1]
 and body_wick_ratio[1] >= 70
 and sig_falling_gap
 and open == open[1]

// @function upgap side-by-side white lines candlestick pattern condition
// @returns bool 

export upgap_side_by_side_white_lines() => 
 green_candle
 and green_candle[1]
 and green_candle[2]
 and body_wick_ratio[2] >= 70
 and candle_body < candle_body[1] * 2
 and candle_body[1] < candle_body * 2
 and rising_window[1]
 and open > high[2]
 and ((open >= open[1] and open <= close[1]) or (close >= open[1] and close <= close[1]))

// @function downgap side-by-side white lines candlestick pattern condition
// @returns bool 

export downgap_side_by_side_white_lines() => 
 green_candle
 and green_candle[1]
 and red_candle[2]
 and body_wick_ratio[2] >= 70
 and candle_body < candle_body[1] * 2
 and candle_body[1] < candle_body * 2
 and falling_window[1]
 and close < low[2]
 and ((open >= open[1] and open <= close[1]) or (close >= open[1] and close <= close[1]))

// @function stalled candlestick pattern condition
// @returns bool

export stalled() =>
 green_candle 
 and green_candle[1] 
 and green_candle[2] 
 and red_candle[3]
 and candle_body <= candle_body[1] * 0.5
 and upper_wick <= candle_range * 0.2
 and upper_wick[1] <= candle_range[1] * 0.2
 and upper_wick[2] <= candle_range[2] * 0.2
 and open > open[1]
 and open <= close[1]
 and open[1] > open[2]
 and open[1] < close[2]
 and close > close[1]
 and close[1] > close[2]
 and open >= close[1] - (candle_body[1] * 0.3) 

stalled = stalled()

// @function bullish star candlestick pattern condition
// @returns bool

export bull_star() =>
 spinning_top 
 and red_candle[1]  
 and body_wick_ratio[1] >= 70
 and falling_gap 
 and close < close[1]

bull_star = bull_star()

// @function bearish star candlestick pattern condition
// @returns bool 

export bear_star() =>
 spinning_top 
 and green_candle[1] 
 and body_wick_ratio[1] >= 70
 and rising_gap
 and close > close[1]

bear_star = bear_star()

// @function bullish doji star candlestick pattern condition
// @returns bool

export bull_doji_star() =>
 doji 
 and red_candle[1] 
 and body_wick_ratio[1] >= 70
 and falling_gap
 and close <= close[1]

bull_doji_star = bull_doji_star()

// @function bearish doji star candlestick pattern condition
// @returns bool 

export bear_doji_star() =>
 doji 
 and green_candle[1] 
 and body_wick_ratio[1] >= 70
 and rising_gap 
 and close >= close[1]

bear_doji_star = bear_doji_star()

// @function morning star candlestick pattern condition
// @returns bool

export morning_star() =>
 bull_star[1]
 and green_candle
 and close < open[2]
 and close >= low[2] + ((high[2] - low[2]) * 0.4) 
 
// @function evening star candlestick pattern condition
// @returns bool 

export evening_star() =>
 bear_star[1]
 and red_candle
 and close > open[2]
 and close <= high[2] - ((high[2] - low[2]) * 0.4) 
 
// @function morning doji star candlestick pattern condition
// @returns bool

export morning_doji_star() =>
 bull_doji_star[1]
 and green_candle
 and close < open[2]
 and close >= low[2] + ((high[2] - low[2]) * 0.4) 
 
morning_doji_star = morning_doji_star()

// @function evening doji star candlestick pattern condition
// @returns bool 

export evening_doji_star() =>
 bear_doji_star[1]
 and red_candle
 and close > open[2]
 and close <= high[2] - ((high[2] - low[2]) * 0.4) 
 
evening_doji_star = evening_doji_star()

// @function abandoned baby bottom candlestick pattern condition
// @returns bool

export abandoned_baby_bottom() =>
 morning_doji_star
 and high[1] < low
 and high[1] < low[2] 
 
// @function abandoned baby top candlestick pattern condition
// @returns bool 

export abandoned_baby_top() =>
 evening_doji_star
 and low[1] > high
 and low[1] > high[2] 

// @function inverted hammer candlestick pattern condition
// @returns bool

export inverted_hammer() =>
 bull_star
 and upper_wick >= candle_range * 0.8

// @function shooting star candlestick pattern condition
// @returns bool 

export shooting_star() =>
 bear_star
 and upper_wick >= candle_range * 0.8

// @function dragonfly doji candlestick pattern condition
// @returns bool

export dragonfly_doji() =>
 bull_doji_star
 and lower_wick >= candle_range * 0.8

// @function gravestone doji candlestick pattern condition
// @returns bool 

export gravestone_doji() =>
 bear_doji_star
 and upper_wick >= candle_range * 0.8

// @function stick sandwich candlestick pattern condition
// @returns bool 

export stick_sandwich() =>
 red_candle 
 and green_candle[1]
 and red_candle[2]
 and open[1] > close[2]
 and close == close[2]

// @function upward gapping tasuki candlestick pattern condition
// @returns bool 

export upward_gapping_tasuki() => 
 red_candle
 and green_candle[1]
 and green_candle[2]
 and body_wick_ratio[2] >= 70
 and rising_window[1]
 and open > open[1]
 and open < close[1]
 and close < open[1]

// @function downward gapping tasuki candlestick pattern condition
// @returns bool 

export downward_gapping_tasuki() => 
 green_candle
 and red_candle[1]
 and red_candle[2]
 and body_wick_ratio[2] >= 70
 and falling_window[1]
 and open < open[1]
 and open > close[1]
 and close > open[1]

// @function three black crows candlestick pattern condition
// @returns bool 

export three_black_crows() =>
 red_candle 
 and red_candle[1] 
 and red_candle[2] 
 and green_candle[3]
 and lower_wick <= candle_range * 0.2
 and lower_wick[1] <= candle_range[1] * 0.2
 and lower_wick[2] <= candle_range[2] * 0.2
 and open < open[1]
 and open > close[1]
 and open[1] < open[2]
 and open[1] > close[2]
 and close < close[1]
 and close[1] < close[2]

// @function advance block candlestick pattern condition
// @returns bool

export advance_block() =>
 (not stalled)
 and green_candle 
 and green_candle[1] 
 and green_candle[2] 
 and red_candle[3]
 and ((candle_body < candle_body[1] and candle_body[1] < candle_body[2]) or (upper_wick[1] >= candle_range[1] * 0.5 and upper_wick >= candle_range * 0.5))
 and upper_wick <= candle_range * 0.2
 and upper_wick[1] <= candle_range[1] * 0.2
 and upper_wick[2] <= candle_range[2] * 0.2
 and open > open[1]
 and open < close[1]
 and open[1] > open[2]
 and open[1] < close[2]
 and close > close[1]
 and close[1] > close[2]

advance_block = advance_block()

// @function three advancing white soldiers candlestick pattern condition
// @returns bool

export three_advancing_white_soldiers() =>
 (not advance_block or stalled)
 and green_candle 
 and green_candle[1] 
 and green_candle[2] 
 and red_candle[3]
 and upper_wick <= candle_range * 0.2
 and upper_wick[1] <= candle_range[1] * 0.2
 and upper_wick[2] <= candle_range[2] * 0.2
 and open > open[1]
 and open < close[1]
 and open[1] > open[2]
 and open[1] < close[2]
 and close > close[1]
 and close[1] > close[2]

// @function bullish three-line strike candlestick pattern condition
// @returns bool 

export bull_three_line_strike() =>
 red_candle 
 and green_candle[1]
 and green_candle[2]
 and green_candle[3]
 and open >= high[1]
 and close < open[3]
 and close[1] > close[2]
 and close[2] > close[3]

// @function bearish three-line strike candlestick pattern condition
// @returns bool 

export bear_three_line_strike() =>
 green_candle
 and red_candle[1]
 and red_candle[2]
 and red_candle[3]
 and open <= low[1]
 and close > open[3]
 and close[1] < close[2]
 and close[2] < close[3]

// @function rising three methods candlestick pattern condition
// @returns bool 

export rising_three_methods() => 
 green_candle
 and red_candle[1]
 and red_candle[2]
 and red_candle[3]
 and green_candle[4]
 and body_wick_ratio >= 50 
 and body_wick_ratio[4] >= 50 
 and open >= close[1]
 and high[4] > open[1] 
 and high[4] > open[2]
 and high[4] > open[3]
 and low[4] < close[1]
 and low[4] < close[2]
 and low[4] < close[3]
 and close > close[4]
 
// @function falling three methods candlestick pattern condition
// @returns bool 

export falling_three_methods() => 
 red_candle
 and green_candle[1]
 and green_candle[2]
 and green_candle[3]
 and red_candle[4]
 and body_wick_ratio >= 50 
 and body_wick_ratio[4] >= 50 
 and open <= close[1]
 and high[4] > close[1] 
 and high[4] > close[2]
 and high[4] > close[3]
 and low[4] < open[1]
 and low[4] < open[2]
 and low[4] < open[3]
 and close < close[4]

// @function three stars in the south candlestick pattern condition
// @returns bool 

export three_stars_in_the_south() =>
 bear_marubozu
 and red_candle[1]
 and red_candle[2]
 and lower_wick[1] >= candle_range[1] * 0.4
 and lower_wick[2] >= candle_range[2] * 0.4
 and high < high[1]
 and low > low[1]
 and high[1] < high[2]
 and low[1] > low[2]

// @function thrusting candlestick pattern condition
// @returns bool

export thrusting() =>
 green_candle
 and red_candle[1]
 and body_wick_ratio[1] >= 70
 and gap_low
 and close > close[1]
 and close > close[1] + (candle_body[1] * 0.2)
 and close < close[1] + (candle_body[1] * 0.5)

// @function tower bottom candlestick pattern condition
// @returns bool

export tower_bottom() => 
 green_candle
 and green_candle[1]
 and red_candle[2]
 and red_candle[3]
 and body_wick_ratio >= 70
 and body_wick_ratio[3] >= 70
 and candle_body[1] < candle_body * 0.5 and candle_body[1] < candle_body[3] * 0.5
 and candle_body[2] < candle_body * 0.5 and candle_body[2] < candle_body[3] * 0.5
 
// @function tower top candlestick pattern condition
// @returns bool 

export tower_top() => 
 red_candle
 and red_candle[1]
 and green_candle[2]
 and green_candle[3]
 and body_wick_ratio >= 70
 and body_wick_ratio[3] >= 70
 and candle_body[1] < candle_body * 0.5 and candle_body[1] < candle_body[3] * 0.5
 and candle_body[2] < candle_body * 0.5 and candle_body[2] < candle_body[3] * 0.5

// @function tri-star bottom candlestick pattern condition
// @returns bool

export tri_star_bottom() =>
 doji
 and doji[1]
 and doji[2]
 and falling_gap[1]
 and low > low[1]
 and low[2] > low[1]

// @function tri-star top candlestick pattern condition
// @returns bool 

export tri_star_top() =>
 doji
 and doji[1]
 and doji[2]
 and rising_gap[1]
 and high < high[1]
 and high[2] < high[1]

// @function tweezer bottom candlestick pattern condition
// @returns bool

export tweezer_bottom() =>
 red_candle[1]
 and body_wick_ratio <= 30
 and candle_body <= candle_body[1] * 0.5
 and body_wick_ratio[1] >= 70
 and low == low[1]

// @function tweezer top candlestick pattern condition
// @returns bool 

export tweezer_top() =>
 green_candle[1]
 and body_wick_ratio <= 30
 and candle_body <= candle_body[1] * 0.5
 and body_wick_ratio[1] >= 70
 and high == high[1]

// @function upside-gap two crows candlestick pattern condition
// @returns bool 

export upside_gap_two_crows() =>
 red_candle
 and red_candle[1]
 and green_candle[2]
 and rising_gap[1]
 and open >= open[1]
 and high > high[1]
 and close < close[1]
 and close[1] > close[2]