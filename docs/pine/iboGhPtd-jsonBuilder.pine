//@version=6
library("jsonBuilder", overlay = true)

// Convert string key + string value to JSON key-value pair
export jsonString(string strKey, string strVal) =>
    '"' + strKey + '": "' + strVal + '"'

// Combine up to 20 key-value pairs into a full JSON object
export jsonObject(string pair1, string pair2="", string pair3="", string pair4="", string pair5="", 
 string pair6="", string pair7="", string pair8="", string pair9="", string pair10="", 
 string pair11="", string pair12="", string pair13="", string pair14="", string pair15="", 
 string pair16="", string pair17="", string pair18="", string pair19="", string pair20="") => 
	'{' + pair1 + (pair2 != ""  ? ", " + pair2  : "") + (pair3 != ""  ? ", " + pair3  : "") + (pair4 != ""  ? ", " + pair4  : "") + (pair5 != ""  ? ", " + pair5  : "") + (pair6 != ""  ? ", " + pair6  : "") + (pair7 != ""  ? ", " + pair7  : "") + (pair8 != ""  ? ", " + pair8  : "") + (pair9 != ""  ? ", " + pair9  : "") + (pair10 != "" ? ", " + pair10 : "") + (pair11 != "" ? ", " + pair11 : "") + (pair12 != "" ? ", " + pair12 : "") + (pair13 != "" ? ", " + pair13 : "") + (pair14 != "" ? ", " + pair14 : "") + (pair15 != "" ? ", " + pair15 : "") + (pair16 != "" ? ", " + pair16 : "") + (pair17 != "" ? ", " + pair17 : "") + (pair18 != "" ? ", " + pair18 : "") + (pair19 != "" ? ", " + pair19 : "") + (pair20 != "" ? ", " + pair20 : "") + '}'

