//@version=5

// @description CandleInsights provides a set of utility functions to facilitate identifying certain types of individual candles and candle patterns.
library("CandleInsights")

isBearCandle = close < open
isBullCandle = close > open
candleRange = math.abs(high - low)
topWickRange = math.abs(isBearCandle ? high - open : high - close)
bottomWickRange = math.abs(isBearCandle ? close - low : open - low)
topWickPctOfCandle = topWickRange / candleRange
bottomWickPctOfCandle = bottomWickRange / candleRange
bodyPctOfCandle = (topWickRange / candleRange) - (bottomWickPctOfCandle / candleRange)

percentChange(float start, float end) =>
    increased = end > start
    diff = increased ? end - start : start - end
    result = 0.0

    if increased
        result := (diff / start) * 100
    else
        result := -1 * ((diff / start) * 100)

// @function Returns true if candle is bullish. 
// @returns bool
export isBullish() =>
	close > open

// @function Returns true if candle is bearish. 
// @returns bool
export isBearish() =>
	close < open
    
// @function Returns true if candle is a hammer. TODO: Allow params
// @returns bool
export isHammer() =>
    bottomWickPctOfCandle >= 0.55 and topWickPctOfCandle <= 0.1

// @function Returns true if candle is a shooting star. TODO: Allow params
// @returns bool
export isShootingStar() =>
	topWickPctOfCandle >= 0.7 and bottomWickPctOfCandle <= 0.1

// @function Returns true if candle is bearish with a top wick over half the range of the candle. TODO: Allow params
// @returns bool	
export isBearishToppingTail() =>
    topWickPctOfCandle >= 0.55 and bodyPctOfCandle >= 0.23 and isBearish()    

// @function Returns true if candle is considering a hanging candle (aka hanging man). TODO: Allow params
// @returns bool
export isHanging() => 
    isBearCandle and bottomWickPctOfCandle >= 0.48 and topWickPctOfCandle <= 0.1 or isBearCandle and bottomWickPctOfCandle >= 0.48 and bodyPctOfCandle >= 0.15
    
export isLongBullish(float pctChg) =>
    chg = percentChange(close[1], close)
    isBullCandle and topWickRange > 0.1 and bottomWickRange > 0.1 and chg >= pctChg

export isBullishEngulfing() =>
    isBearCandle[1] and open <= close[1] and close > open[1]

