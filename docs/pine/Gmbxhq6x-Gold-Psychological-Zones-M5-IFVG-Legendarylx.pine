//@version=6
indicator(
     "Gold Psychological Zones + M5 IFVG [Legendarylx]",
     overlay=true,
     max_boxes_count=500,
     max_lines_count=500,
     max_labels_count=500
)

//=============================================================================
// 1. SETTINGS
//=============================================================================

groupPsych = "Psychological Zones"

psychSpacing = input.float(
     50.0,
     "Psych Level Spacing",
     minval=1.0,
     step=1.0,
     group=groupPsych,
     tooltip="50 = 4000, 4050, 4100, 4150, 4200..."
)

zoneWidth = input.float(
     5.0,
     "Zone Width (+/-)",
     minval=0.1,
     step=0.5,
     group=groupPsych,
     tooltip="5 = 4095 to 4105 around the 4100 level."
)

zonesAbove = input.int(
     10,
     "Zones Above Current Price",
     minval=1,
     maxval=30,
     group=groupPsych
)

zonesBelow = input.int(
     10,
     "Zones Below Current Price",
     minval=1,
     maxval=30,
     group=groupPsych
)

showCenterLine = input.bool(
     true,
     "Show Exact Psych Level",
     group=groupPsych
)

showLabels = input.bool(
     true,
     "Show Psych Labels",
     group=groupPsych
)

psychColor = input.color(
     color.new(color.orange, 88),
     "Psych Zone Color",
     group=groupPsych
)

centerColor = input.color(
     color.new(color.orange, 25),
     "Center Line Color",
     group=groupPsych
)


//=============================================================================
// M5 IFVG SETTINGS
//=============================================================================

groupIFVG = "5-Minute IFVG"

showIFVG = input.bool(
     true,
     "Show M5 IFVG",
     group=groupIFVG
)

requirePsychOverlap = input.bool(
     true,
     "Only IFVGs at Psych Zones",
     group=groupIFVG
)

maxFVGAge = input.int(
     30,
     "Maximum M5 FVG Age",
     minval=1,
     maxval=200,
     group=groupIFVG,
     tooltip="Maximum number of 5-minute bars before an FVG is ignored."
)

ifvgExtendBars = input.int(
     100,
     "IFVG Extension Bars",
     minval=10,
     maxval=500,
     group=groupIFVG
)

bullIFVGColor = input.color(
     color.new(color.green, 82),
     "Bullish IFVG Color",
     group=groupIFVG
)

bearIFVGColor = input.color(
     color.new(color.red, 82),
     "Bearish IFVG Color",
     group=groupIFVG
)


//=============================================================================
// TRADE SETTINGS
//=============================================================================

groupTrade = "Trade Setup"

showSignals = input.bool(
     true,
     "Show BUY / SELL",
     group=groupTrade
)

showTradeLevels = input.bool(
     true,
     "Show Entry / SL / TP",
     group=groupTrade
)

rrTarget = input.float(
     1.5,
     "Target R:R",
     minval=0.5,
     step=0.25,
     group=groupTrade
)

slBuffer = input.float(
     0.0,
     "SL Buffer",
     minval=0.0,
     step=0.1,
     group=groupTrade
)


//=============================================================================
// 2. PSYCHOLOGICAL ZONES
//=============================================================================

var psychBoxes = array.new_box()
var psychLines = array.new_line()
var psychLabels = array.new_label()

if barstate.islast

    // Remove old drawings before rebuilding around current price.

    if array.size(psychBoxes) > 0
        for i = 0 to array.size(psychBoxes) - 1
            box.delete(array.get(psychBoxes, i))

    if array.size(psychLines) > 0
        for i = 0 to array.size(psychLines) - 1
            line.delete(array.get(psychLines, i))

    if array.size(psychLabels) > 0
        for i = 0 to array.size(psychLabels) - 1
            label.delete(array.get(psychLabels, i))

    array.clear(psychBoxes)
    array.clear(psychLines)
    array.clear(psychLabels)

    basePsych =
         math.floor(close / psychSpacing) *
         psychSpacing

    for i = -zonesBelow to zonesAbove

        level =
             basePsych +
             (i * psychSpacing)

        zoneTop =
             level + zoneWidth

        zoneBottom =
             level - zoneWidth

        // Infinite horizontal zone.
        newBox = box.new(
             left=bar_index,
             top=zoneTop,
             right=bar_index + 1,
             bottom=zoneBottom,
             xloc=xloc.bar_index,
             extend=extend.both,
             bgcolor=psychColor,
             border_color=color.new(psychColor, 100)
        )

        array.push(
             psychBoxes,
             newBox
        )

        // Exact psychological number.
        if showCenterLine

            newLine = line.new(
                 x1=bar_index,
                 y1=level,
                 x2=bar_index + 1,
                 y2=level,
                 xloc=xloc.bar_index,
                 extend=extend.both,
                 color=centerColor,
                 style=line.style_dotted,
                 width=1
            )

            array.push(
                 psychLines,
                 newLine
            )

        if showLabels

            newLabel = label.new(
                 x=bar_index + 5,
                 y=level,
                 text=str.tostring(
                      level,
                      format.mintick
                 ),
                 style=label.style_label_left,
                 textcolor=centerColor,
                 color=color.new(
                      color.white,
                      100
                 ),
                 size=size.tiny
            )

            array.push(
                 psychLabels,
                 newLabel
            )


//=============================================================================
// 3. FUNCTION: CHECK PSYCHOLOGICAL ZONE
//=============================================================================

f_overlapsPsych(
     rangeLow,
     rangeHigh) =>

    midpoint =
         (rangeLow + rangeHigh) /
         2.0

    nearest =
         math.round(
              midpoint /
              psychSpacing
         ) *
         psychSpacing

    centerOverlap =
         rangeHigh >=
         nearest - zoneWidth and
         rangeLow <=
         nearest + zoneWidth

    upper =
         nearest +
         psychSpacing

    upperOverlap =
         rangeHigh >=
         upper - zoneWidth and
         rangeLow <=
         upper + zoneWidth

    lower =
         nearest -
         psychSpacing

    lowerOverlap =
         rangeHigh >=
         lower - zoneWidth and
         rangeLow <=
         lower + zoneWidth

    centerOverlap or
     upperOverlap or
     lowerOverlap


//=============================================================================
// 4. GET ONLY 5-MINUTE DATA
//=============================================================================

// These values ALWAYS come from the 5-minute timeframe,
// regardless of the chart timeframe.

m5Open = request.security(
     syminfo.tickerid,
     "5",
     open,
     barmerge.gaps_off,
     barmerge.lookahead_off
)

m5High = request.security(
     syminfo.tickerid,
     "5",
     high,
     barmerge.gaps_off,
     barmerge.lookahead_off
)

m5Low = request.security(
     syminfo.tickerid,
     "5",
     low,
     barmerge.gaps_off,
     barmerge.lookahead_off
)

m5Close = request.security(
     syminfo.tickerid,
     "5",
     close,
     barmerge.gaps_off,
     barmerge.lookahead_off
)

m5Time = request.security(
     syminfo.tickerid,
     "5",
     time,
     barmerge.gaps_off,
     barmerge.lookahead_off
)


// Detect new 5-minute candle.

newM5Bar =
     ta.change(m5Time) != 0


//=============================================================================
// 5. M5 FVG DETECTION
//=============================================================================

// Use confirmed M5 candle structure.

// Bullish FVG:
// Candle 3 low > Candle 1 high.

m5BullFVG =
     request.security(
          syminfo.tickerid,
          "5",
          low > high[2],
          barmerge.gaps_off,
          barmerge.lookahead_off
     )

m5BullTop =
     request.security(
          syminfo.tickerid,
          "5",
          low,
          barmerge.gaps_off,
          barmerge.lookahead_off
     )

m5BullBottom =
     request.security(
          syminfo.tickerid,
          "5",
          high[2],
          barmerge.gaps_off,
          barmerge.lookahead_off
     )


// Bearish FVG:
// Candle 3 high < Candle 1 low.

m5BearFVG =
     request.security(
          syminfo.tickerid,
          "5",
          high < low[2],
          barmerge.gaps_off,
          barmerge.lookahead_off
     )

m5BearTop =
     request.security(
          syminfo.tickerid,
          "5",
          low[2],
          barmerge.gaps_off,
          barmerge.lookahead_off
     )

m5BearBottom =
     request.security(
          syminfo.tickerid,
          "5",
          high,
          barmerge.gaps_off,
          barmerge.lookahead_off
     )


//=============================================================================
// 6. STORE QUALIFYING M5 FVG
//=============================================================================

var float bullTop = na
var float bullBottom = na
var int bullCreatedTime = na
var int bullAge = 0
var bool bullActive = false

var float bearTop = na
var float bearBottom = na
var int bearCreatedTime = na
var int bearAge = 0
var bool bearActive = false


// Only process once per new M5 candle.

if newM5Bar

    // Age existing FVGs.

    if bullActive
        bullAge += 1

    if bearActive
        bearAge += 1


    // Expire old FVGs.

    if bullActive and
       bullAge > maxFVGAge

        bullActive := false


    if bearActive and
       bearAge > maxFVGAge

        bearActive := false


    // ---------------------------------------------------------
    // New Bullish M5 FVG
    // ---------------------------------------------------------

    if m5BullFVG

        touchesPsych =
             f_overlapsPsych(
                  m5BullBottom,
                  m5BullTop
             )

        if not requirePsychOverlap or
           touchesPsych

            bullTop :=
                 m5BullTop

            bullBottom :=
                 m5BullBottom

            bullCreatedTime :=
                 m5Time

            bullAge := 0

            bullActive := true


    // ---------------------------------------------------------
    // New Bearish M5 FVG
    // ---------------------------------------------------------

    if m5BearFVG

        touchesPsych =
             f_overlapsPsych(
                  m5BearBottom,
                  m5BearTop
             )

        if not requirePsychOverlap or
           touchesPsych

            bearTop :=
                 m5BearTop

            bearBottom :=
                 m5BearBottom

            bearCreatedTime :=
                 m5Time

            bearAge := 0

            bearActive := true


//=============================================================================
// 7. M5 IFVG CONFIRMATION
//=============================================================================

// A bullish FVG becomes a BEARISH IFVG
// when a confirmed M5 candle closes below its lower boundary.

bearishIFVG =
     newM5Bar and
     bullActive and
     m5Close[1] <
     bullBottom


// A bearish FVG becomes a BULLISH IFVG
// when a confirmed M5 candle closes above its upper boundary.

bullishIFVG =
     newM5Bar and
     bearActive and
     m5Close[1] >
     bearTop


//=============================================================================
// 8. DRAW M5 IFVG + TRADE SETUP
//=============================================================================

if bearishIFVG

    entry =
         m5Close[1]

    stop =
         m5High[1] +
         slBuffer

    risk =
         stop -
         entry

    target =
         entry -
         (risk * rrTarget)


    // IFVG Box.

    if showIFVG

        box.new(
             left=time,
             top=bullTop,
             right=time + (
                  ifvgExtendBars *
                  5 *
                  60 *
                  1000
             ),
             bottom=bullBottom,
             xloc=xloc.bar_time,
             bgcolor=bearIFVGColor,
             border_color=color.new(
                  color.red,
                  20
             )
        )


    // SELL label.

    if showSignals

        label.new(
             bar_index,
             high,
             "M5 SELL\nIFVG @ PSYCH",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small
        )


    // Trade levels.

    if showTradeLevels and
       risk > 0

        line.new(
             bar_index,
             entry,
             bar_index + 50,
             entry,
             color=color.gray
        )

        line.new(
             bar_index,
             stop,
             bar_index + 50,
             stop,
             color=color.red,
             width=2
        )

        line.new(
             bar_index,
             target,
             bar_index + 50,
             target,
             color=color.green,
             width=2
        )


    bullActive := false


//=============================================================================
// BULLISH IFVG
//=============================================================================

if bullishIFVG

    entry =
         m5Close[1]

    stop =
         m5Low[1] -
         slBuffer

    risk =
         entry -
         stop

    target =
         entry +
         (risk * rrTarget)


    // IFVG Box.

    if showIFVG

        box.new(
             left=time,
             top=bearTop,
             right=time + (
                  ifvgExtendBars *
                  5 *
                  60 *
                  1000
             ),
             bottom=bearBottom,
             xloc=xloc.bar_time,
             bgcolor=bullIFVGColor,
             border_color=color.new(
                  color.green,
                  20
             )
        )


    // BUY label.

    if showSignals

        label.new(
             bar_index,
             low,
             "M5 BUY\nIFVG @ PSYCH",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.small
        )


    // Trade levels.

    if showTradeLevels and
       risk > 0

        line.new(
             bar_index,
             entry,
             bar_index + 50,
             entry,
             color=color.gray
        )

        line.new(
             bar_index,
             stop,
             bar_index + 50,
             stop,
             color=color.red,
             width=2
        )

        line.new(
             bar_index,
             target,
             bar_index + 50,
             target,
             color=color.green,
             width=2
        )


    bearActive := false


//=============================================================================
// 9. ALERTS
//=============================================================================

alertcondition(
     bearishIFVG,
     title="M5 Bearish IFVG @ Gold Psych Zone",
     message="XAUUSD: M5 Bearish IFVG confirmed at Psychological Zone."
)

alertcondition(
     bullishIFVG,
     title="M5 Bullish IFVG @ Gold Psych Zone",
     message="XAUUSD: M5 Bullish IFVG confirmed at Psychological Zone."
)