    table.cell(researchPanel, 0, PANEL_BOTTOM_SPACER_ROW, "")
    table.merge_cells(researchPanel, 0, 0, PANEL_CONTENT_LAST_COLUMN, 0)
    table.merge_cells(researchPanel, 1, 1, PANEL_CONTENT_LAST_COLUMN, 1)
    table.merge_cells(researchPanel, 0, 2, 1, 2)
    table.merge_cells(researchPanel, 0, 3, 1, 3)
    table.merge_cells(researchPanel, 0, 4, 1, 4)
    table.merge_cells(researchPanel, 1, 5, PANEL_CONTENT_LAST_COLUMN, 5)
    table.merge_cells(researchPanel, 0, 6, 1, 6)
    table.merge_cells(researchPanel, 2, 6, PANEL_CONTENT_LAST_COLUMN, 6)
    table.merge_cells(researchPanel, 0, 7, 1, 7)
    table.merge_cells(researchPanel, 2, 7, PANEL_CONTENT_LAST_COLUMN, 7)
    table.merge_cells(researchPanel, 0, 8, PANEL_CONTENT_LAST_COLUMN, 8)
    table.merge_cells(researchPanel, 0, 9, PANEL_CONTENT_LAST_COLUMN, 9)
    table.merge_cells(researchPanel, 0, PANEL_BOTTOM_SPACER_ROW, PANEL_SPACER_COLUMN, PANEL_BOTTOM_SPACER_ROW)

// Snapshot used by the fixed research card. In adaptive mode it follows the
// rightmost rendered session, so scrolling backward keeps the card relevant.
var bool cardStarted = false
var int cardSession = na
var int cardRangeEnd = na
var int cardProjectionEnd = na
var int cardObservationTime = na
var bool cardLocked = false
var bool cardPartialStart = false
var bool cardUsedChartFallback = false
var float cardHigh = na
var float cardLow = na
var float cardWidth = na
var float cardPercentile = na
var float cardEfficiency = na
var float cardLateShare = na
var float cardSkew = na
var int cardClassification = 0
var int cardPostSampleCount = 0
var int cardInsideSampleCount = 0
var int cardAboveSampleCount = 0
var int cardBelowSampleCount = 0
var int cardFirstDepartureSide = 0
var bool cardReenteredRange = false
var bool cardTraversedOppositeEdge = false
var int cardUpperTestCount = 0
var int cardLowerTestCount = 0
var float cardMaxUpperReachR = 0.0
var float cardMaxLowerReachR = 0.0

var float finalRangeWidth = na
var float finalRangeContextMeasure = na
var float finalRangeMidpoint = na
var float finalRangeEquilibrium = na
var float finalPathEfficiency = na
var float finalCloseLocation = na
var float finalExpansionSkew = na
var float finalLateExpansionShare = na
var float finalEarlyWidthShare = na
var float finalWidthPercentile = na
