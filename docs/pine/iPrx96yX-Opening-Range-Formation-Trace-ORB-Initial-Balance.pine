// Opening Range Formation Trace - ORB & Initial Balance
// A non-directional research indicator for studying how an opening range forms,
// locks, and is subsequently accepted, rejected, or traversed.

// Visualizes a configurable opening range and preserves its formation path as
// cumulative time-slice envelopes. Completed ranges are classified from
// transparent measurements, then tracked through neutral post-range events.
// English is the default chart language; Japanese chart text is selectable.
// Revision 1.6: fresh-editor distribution. Runtime calculations, chart objects, colors, and the visual research panel are unchanged from Revision 1.5.
indicator(
     "Opening Range Formation Trace - ORB & Initial Balance",
     overlay = true,
     behind_chart = false,
     max_boxes_count = 500,
     max_lines_count = 500,
     max_labels_count = 500
)

//──────────────────────────────────────────────────────────────────────────────
// Constants
//──────────────────────────────────────────────────────────────────────────────
const int MS_MINUTE = 60 * 1000
const int MS_HOUR   = 60 * MS_MINUTE
const int MS_DAY    = 24 * MS_HOUR

const int PANEL_METER_SEGMENTS = 6
const int PANEL_CONTENT_LAST_COLUMN = 8
const int PANEL_SPACER_COLUMN = 9
const int PANEL_BOTTOM_SPACER_ROW = 10

// Custom integer text sizes provide a controlled step between Pine's fixed
// tiny/small/normal presets. The comfortable default is intentionally only
// one step larger than v1.4, preserving the panel's compact visual identity.
const int PANEL_MICRO_COMPACT = 8
const int PANEL_BASE_COMPACT = 9
const int PANEL_VALUE_COMPACT = 10
const int PANEL_ICON_COMPACT = 12

const int PANEL_MICRO_COMFORTABLE = 9
const int PANEL_BASE_COMFORTABLE = 10
const int PANEL_VALUE_COMFORTABLE = 12
const int PANEL_ICON_COMFORTABLE = 14

const int PANEL_MICRO_LARGE = 10
const int PANEL_BASE_LARGE = 12
const int PANEL_VALUE_LARGE = 14
const int PANEL_ICON_LARGE = 16

const string GROUP_GENERAL   = "1. General / 全般"
const string GROUP_SESSION   = "2. Opening range / オープニングレンジ"
const string GROUP_TRACE     = "3. Formation trace / 形成トレース"
