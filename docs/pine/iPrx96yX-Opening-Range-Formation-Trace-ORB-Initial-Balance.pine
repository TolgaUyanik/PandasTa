// Post-range evidence state.
var int lastPostSampleTime = na
var int postSampleCount = 0
var int insideSampleCount = 0
var int aboveSampleCount = 0
var int belowSampleCount = 0
var int upperEvidenceRun = 0
var int lowerEvidenceRun = 0
var int firstDepartureSide = 0
var int firstDepartureTime = na
var bool reenteredRange = false
var int reentryTime = na
var bool traversedOppositeEdge = false
var int upperTestCount = 0
var int lowerTestCount = 0
var bool touchingUpper = false
var bool touchingLower = false
var float maxUpperReachR = 0.0
var float maxLowerReachR = 0.0

// One-execution event flags used by the neutral alert conditions.
bool rangeLockedEvent = false
bool acceptedAboveEvent = false
bool acceptedBelowEvent = false
bool reentryEvent = false
bool traverseEvent = false

//──────────────────────────────────────────────────────────────────────────────
// Pass 1: Build the opening range from intrabars
//──────────────────────────────────────────────────────────────────────────────
bool barInsideVisibleWindow = time_close >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
if barInsideVisibleWindow
    visibleChartHigh := na(visibleChartHigh) ? high : math.max(visibleChartHigh, high)
    visibleChartLow := na(visibleChartLow) ? low : math.min(visibleChartLow, low)

int intrabarCount = array.size(ltfTime)
bool useConfirmedChartFallback = intrabarCount == 0 and chartFallbackUsable and not barstate.isrealtime and barstate.isconfirmed
int analysisSampleCount = intrabarCount > 0 ? intrabarCount : useConfirmedChartFallback ? 1 : 0

if barInsideVisibleWindow and chartSupported and intrabarCount == 0 and barstate.isconfirmed and not useConfirmedChartFallback
    visibleHistoryGapDetected := true

if chartSupported and analysisSampleCount > 0
    for intrabarIndex = 0 to analysisSampleCount - 1
        bool coarseSample = intrabarCount == 0
        int sampleTime = coarseSample ? time : array.get(ltfTime, intrabarIndex)
        int sampleCloseTime = coarseSample ? time_close : array.get(ltfTimeClose, intrabarIndex)
        float sampleOpen = coarseSample ? open : array.get(ltfOpen, intrabarIndex)
        float sampleHigh = coarseSample ? high : array.get(ltfHigh, intrabarIndex)
        float sampleLow = coarseSample ? low : array.get(ltfLow, intrabarIndex)
        float sampleClose = coarseSample ? close : array.get(ltfClose, intrabarIndex)
        float sampleVolume = coarseSample ? volume : array.get(ltfVolume, intrabarIndex)

        bool firstRetrievedSample = not anySampleSeen
        anySampleSeen := true

        int candidateSession = f_sessionStart(sampleTime, sessionTimezone, sessionHour, sessionMinute)
        int candidateRangeEnd = candidateSession + rangeMilliseconds
        bool validSessionDay = f_dayAllowed(candidateSession, sessionTimezone, dayMaskInput)
        bool sampleInsideRange = sampleTime >= candidateSession and sampleTime < candidateRangeEnd
        bool sampleClosesInsideRange = sampleCloseTime <= candidateRangeEnd
        bool sampleAvailableNow = not barstate.isrealtime or sampleTime <= timenow

        if validSessionDay and sampleInsideRange and sampleClosesInsideRange and sampleAvailableNow
            bool newSession = na(currentSession) or candidateSession != currentSession

            if newSession
                currentSession := candidateSession
                currentRangeEnd := candidateRangeEnd
                currentProjectionEnd := candidateSession + projectionMilliseconds
                currentStarted := true
                currentLocked := false
                currentPartialStart := firstRetrievedSample and sampleTime > candidateSession
                currentUsedChartFallback := coarseSample

                bool sessionIntersectsVisible = (
                     currentProjectionEnd >= chart.left_visible_bar_time and
                     currentSession <= chart.right_visible_bar_time
                )
                currentRenderSession := adaptiveHistory ? sessionIntersectsVisible : true

                if currentRenderSession
                    array.push(retainedSessions, currentSession)
                    array.push(retainedSessionTops, sampleHigh)
                    array.push(retainedSessionBottoms, sampleLow)
                    array.push(retainedSessionWidths, math.max(sampleHigh - sampleLow, syminfo.mintick))
                    visibleFallbackUsed := visibleFallbackUsed or coarseSample

                    while array.size(retainedSessions) > sessionsToKeepInput
                        historyBudgetExceeded := historyBudgetExceeded or adaptiveHistory
                        int expiredSession = array.shift(retainedSessions)
                        array.shift(retainedSessionTops)
                        array.shift(retainedSessionBottoms)
                        array.shift(retainedSessionWidths)
                        f_deleteSessionBoxes(storedBoxes, storedBoxSessions, expiredSession)
                        f_deleteSessionLines(storedLines, storedLineSessions, expiredSession)
                        f_deleteSessionLabels(
                             storedLabels,
                             storedLabelSessions,
                             storedLabelSides,
                             storedLabelLanes,
                             expiredSession
                        )

                currentOpen := na
                currentHigh := na
                currentLow := na
                currentClose := na
                previousSampleClose := na
                currentHighTime := na
                currentLowTime := na
                currentFirstSampleTime := na
                currentLastSampleCloseTime := na
                currentPath := 0.0
                currentPriceSum := 0.0
                currentVolumePriceSum := 0.0
                currentVolumeSum := 0.0
                currentSamples := 0
                currentHalfHigh := na
                currentHalfLow := na
                currentEarlyHigh := na
                currentEarlyLow := na

                for sliceIndex = 0 to traceSlicesInput - 1
                    array.set(sliceHighs, sliceIndex, na)
                    array.set(sliceLows, sliceIndex, na)
                    array.set(sliceBoxes, sliceIndex, na)

                currentMainBox := na
                currentHighLine := na
                currentLowLine := na
                currentMidLine := na
                currentOpenLine := na
                currentEquilibriumLine := na
                currentFormationLabel := na
                currentHighTimeLabel := na
                currentLowTimeLabel := na
                currentDepartureLabel := na
                currentReentryLabel := na
                currentTraverseLabel := na

                finalRangeWidth := na
                finalRangeContextMeasure := na
                finalRangeMidpoint := na
                finalRangeEquilibrium := na
                finalPathEfficiency := na
                finalCloseLocation := na
                finalExpansionSkew := na
                finalLateExpansionShare := na
                finalEarlyWidthShare := na
                finalWidthPercentile := na
                finalFormationClass := 0
                finalAnnotationStep := na

                lastPostSampleTime := na
                postSampleCount := 0
                insideSampleCount := 0
                aboveSampleCount := 0
                belowSampleCount := 0
                upperEvidenceRun := 0
                lowerEvidenceRun := 0
                firstDepartureSide := 0
                firstDepartureTime := na
                reenteredRange := false
                reentryTime := na
                traversedOppositeEdge := false
                upperTestCount := 0
                lowerTestCount := 0
                touchingUpper := false
                touchingLower := false
                maxUpperReachR := 0.0
                maxLowerReachR := 0.0

            bool firstSample = currentSamples == 0
            if firstSample
                currentOpen := sampleOpen
                currentHigh := sampleHigh
                currentLow := sampleLow
                currentHighTime := sampleTime
                currentLowTime := sampleTime
                currentFirstSampleTime := sampleTime
                currentPath := math.abs(sampleClose - sampleOpen)
            else
                if sampleHigh > currentHigh
                    currentHigh := sampleHigh
                    currentHighTime := sampleTime
                if sampleLow < currentLow
                    currentLow := sampleLow
                    currentLowTime := sampleTime
                currentPath += math.abs(sampleClose - previousSampleClose)

            currentClose := sampleClose
            previousSampleClose := sampleClose
            currentLastSampleCloseTime := sampleCloseTime
            currentSamples += 1
            currentUsedChartFallback := currentUsedChartFallback or coarseSample

            if currentRenderSession
                visibleFallbackUsed := visibleFallbackUsed or coarseSample
                f_updateSessionBounds(
                     retainedSessions,
                     retainedSessionTops,
                     retainedSessionBottoms,
                     retainedSessionWidths,
                     currentSession,
                     sampleHigh,
                     sampleLow,
                     currentHigh - currentLow
                )

            // Classification checkpoints are independent of the visual trace-slice count.
            int halfwayCheckpoint = currentSession + int(math.round(rangeMilliseconds * 0.5))
            int earlyCheckpoint = currentSession + int(math.round(rangeMilliseconds * earlyCheckpointInput / 100.0))
            if sampleTime < halfwayCheckpoint
                currentHalfHigh := na(currentHalfHigh) ? currentHigh : math.max(currentHalfHigh, currentHigh)
                currentHalfLow := na(currentHalfLow) ? currentLow : math.min(currentHalfLow, currentLow)
            if sampleTime < earlyCheckpoint
                currentEarlyHigh := na(currentEarlyHigh) ? currentHigh : math.max(currentEarlyHigh, currentHigh)
                currentEarlyLow := na(currentEarlyLow) ? currentLow : math.min(currentEarlyLow, currentLow)

            float sampleTypicalPrice = (sampleHigh + sampleLow + sampleClose) / 3.0
            currentPriceSum += sampleTypicalPrice
            if not na(sampleVolume) and sampleVolume > 0.0
                currentVolumePriceSum += sampleTypicalPrice * sampleVolume
                currentVolumeSum += sampleVolume

            int elapsedMilliseconds = math.max(0, sampleTime - currentSession)
            int activeSlice = math.min(
                 traceSlicesInput - 1,
                 int(math.floor(float(elapsedMilliseconds) * traceSlicesInput / rangeMilliseconds))
            )
            array.set(sliceHighs, activeSlice, currentHigh)
            array.set(sliceLows, activeSlice, currentLow)

            if showMainBoxInput and currentRenderSession
                if na(currentMainBox)
                    currentMainBox := box.new(
                         left = currentSession,
                         top = currentHigh,
                         right = currentRangeEnd,
                         bottom = currentLow,
                         xloc = xloc.bar_time,
                         border_color = neutralColorInput,
                         border_width = lineWidthInput,
                         border_style = f_lineStyle(referenceLineStyleInput),
                         bgcolor = color.new(neutralColorInput, mainTransparencyInput)
                    )
                    f_registerBox(storedBoxes, storedBoxSessions, currentMainBox, currentSession)
                else
                    box.set_top(currentMainBox, currentHigh)
                    box.set_bottom(currentMainBox, currentLow)
                    box.set_right(currentMainBox, currentRangeEnd)

            if showTraceInput and currentRenderSession
                int sliceLeft = currentSession + int(math.floor(float(rangeMilliseconds) * activeSlice / traceSlicesInput))
                int sliceRight = currentSession + int(math.floor(float(rangeMilliseconds) * (activeSlice + 1) / traceSlicesInput))
                box activeSliceBox = array.get(sliceBoxes, activeSlice)
                if na(activeSliceBox)
                    activeSliceBox := box.new(
                         left = sliceLeft,
                         top = currentHigh,
                         right = sliceRight,
                         bottom = currentLow,
                         xloc = xloc.bar_time,
                         border_color = neutralColorInput,
                         border_width = 1,
                         bgcolor = color.new(neutralColorInput, traceTransparencyInput)
                    )
                    array.set(sliceBoxes, activeSlice, activeSliceBox)
                    f_registerBox(storedBoxes, storedBoxSessions, activeSliceBox, currentSession)
                else
                    box.set_top(activeSliceBox, currentHigh)
                    box.set_bottom(activeSliceBox, currentLow)

            float developingMidpoint = (currentHigh + currentLow) / 2.0
            float developingMean = currentSamples > 0 ? currentPriceSum / currentSamples : developingMidpoint
            float developingVolumeMean = currentVolumeSum > 0.0 ? currentVolumePriceSum / currentVolumeSum : developingMean
            float developingEquilibrium = (
                 equilibriumModeInput == "Volume-weighted mean" ? developingVolumeMean :
                 equilibriumModeInput == "Mean price"           ? developingMean :
                 equilibriumModeInput == "Opening price"        ? currentOpen :
                                                                  developingMidpoint
            )

            if showHighLowInput and currentRenderSession
                if na(currentHighLine)
                    currentHighLine := line.new(
                         x1 = currentSession,
                         y1 = currentHigh,
                         x2 = currentProjectionEnd,
                         y2 = currentHigh,
                         xloc = xloc.bar_time,
                         extend = extend.none,
                         color = upperColorInput,
                         style = f_lineStyle(boundaryLineStyleInput),
                         width = lineWidthInput
                    )
                    f_registerLine(storedLines, storedLineSessions, currentHighLine, currentSession)
                else
                    line.set_xy1(currentHighLine, currentSession, currentHigh)
                    line.set_xy2(currentHighLine, currentProjectionEnd, currentHigh)

                if na(currentLowLine)
                    currentLowLine := line.new(
                         x1 = currentSession,
                         y1 = currentLow,
                         x2 = currentProjectionEnd,
                         y2 = currentLow,
                         xloc = xloc.bar_time,
                         extend = extend.none,
                         color = lowerColorInput,
                         style = f_lineStyle(boundaryLineStyleInput),
                         width = lineWidthInput
                    )
                    f_registerLine(storedLines, storedLineSessions, currentLowLine, currentSession)
                else
                    line.set_xy1(currentLowLine, currentSession, currentLow)
                    line.set_xy2(currentLowLine, currentProjectionEnd, currentLow)

            if showMidpointInput and currentRenderSession
                if na(currentMidLine)
                    currentMidLine := line.new(
                         x1 = currentSession,
                         y1 = developingMidpoint,
                         x2 = currentProjectionEnd,
                         y2 = developingMidpoint,
                         xloc = xloc.bar_time,
                         extend = extend.none,
                         color = neutralColorInput,
                         style = line.style_dashed,
                         width = 1
                    )
                    f_registerLine(storedLines, storedLineSessions, currentMidLine, currentSession)
                else
                    line.set_xy1(currentMidLine, currentSession, developingMidpoint)
                    line.set_xy2(currentMidLine, currentProjectionEnd, developingMidpoint)

            if showOpenInput and currentRenderSession
                if na(currentOpenLine)
                    currentOpenLine := line.new(
                         x1 = currentSession,
                         y1 = currentOpen,
                         x2 = currentProjectionEnd,
                         y2 = currentOpen,
                         xloc = xloc.bar_time,
                         extend = extend.none,
                         color = color.new(chart.fg_color, 35),
                         style = line.style_dotted,
                         width = 1
                    )
                    f_registerLine(storedLines, storedLineSessions, currentOpenLine, currentSession)

            if showEquilibriumInput and currentRenderSession
                if na(currentEquilibriumLine)
                    currentEquilibriumLine := line.new(
                         x1 = currentSession,
                         y1 = developingEquilibrium,
                         x2 = currentProjectionEnd,
                         y2 = developingEquilibrium,
                         xloc = xloc.bar_time,
                         extend = extend.none,
                         color = twoSidedColorInput,
                         style = f_lineStyle(referenceLineStyleInput),
                         width = 1
                    )
                    f_registerLine(storedLines, storedLineSessions, currentEquilibriumLine, currentSession)
                else
                    line.set_xy1(currentEquilibriumLine, currentSession, developingEquilibrium)
                    line.set_xy2(currentEquilibriumLine, currentProjectionEnd, developingEquilibrium)

//──────────────────────────────────────────────────────────────────────────────
// Lock the range and preserve its formation fingerprint
//──────────────────────────────────────────────────────────────────────────────
int lastAvailableIntrabarClose = intrabarCount > 0 ? array.get(ltfTimeClose, intrabarCount - 1) : na
bool finalIntrabarCloseAvailable = not barstate.isrealtime or (not na(lastAvailableIntrabarClose) and lastAvailableIntrabarClose <= timenow)
bool rangeEndReachedByData = currentStarted and not na(lastAvailableIntrabarClose) and finalIntrabarCloseAvailable and lastAvailableIntrabarClose >= currentRangeEnd
bool rangeEndReachedByClock = currentStarted and (barstate.isrealtime ? timenow >= currentRangeEnd : time_close >= currentRangeEnd)

if chartSupported and currentStarted and not currentLocked and (rangeEndReachedByData or rangeEndReachedByClock)
    currentLocked := true
    rangeLockedEvent := true

    finalRangeWidth := math.max(currentHigh - currentLow, syminfo.mintick)
    finalAnnotationStep := f_annotationStep(finalRangeWidth, na)
    finalRangeContextMeasure := widthBasisInput == "Raw price" ? finalRangeWidth : f_rangePercent(finalRangeWidth, currentOpen)
    finalRangeMidpoint := (currentHigh + currentLow) / 2.0

    if currentRenderSession
        f_updateSessionBounds(
             retainedSessions,
             retainedSessionTops,
             retainedSessionBottoms,
             retainedSessionWidths,
             currentSession,
             currentHigh,
             currentLow,
             finalRangeWidth
        )

    float arithmeticMean = currentSamples > 0 ? currentPriceSum / currentSamples : finalRangeMidpoint
    float volumeWeightedMean = currentVolumeSum > 0.0 ? currentVolumePriceSum / currentVolumeSum : arithmeticMean
    finalRangeEquilibrium := (
         equilibriumModeInput == "Volume-weighted mean" ? volumeWeightedMean :
         equilibriumModeInput == "Mean price"           ? arithmeticMean :
         equilibriumModeInput == "Opening price"        ? currentOpen :
                                                          finalRangeMidpoint
    )

    finalPathEfficiency := math.min(1.0, f_safeRatio(math.abs(currentClose - currentOpen), currentPath, 0.0))
    finalCloseLocation := math.min(1.0, math.max(0.0, f_safeRatio(currentClose - currentLow, finalRangeWidth, 0.5)))
    finalExpansionSkew := math.max(-1.0, math.min(1.0, f_safeRatio((currentHigh - currentOpen) - (currentOpen - currentLow), finalRangeWidth, 0.0)))

    // Carry the last available cumulative envelope through empty trace slices.
    float previousSliceHigh = currentOpen
    float previousSliceLow = currentOpen
    for sliceIndex = 0 to traceSlicesInput - 1
        float sliceHigh = array.get(sliceHighs, sliceIndex)
        float sliceLow = array.get(sliceLows, sliceIndex)

        if na(sliceHigh) or na(sliceLow)
            sliceHigh := previousSliceHigh
            sliceLow := previousSliceLow
            array.set(sliceHighs, sliceIndex, sliceHigh)
            array.set(sliceLows, sliceIndex, sliceLow)

            if showTraceInput and currentRenderSession
                int sliceLeft = currentSession + int(math.floor(float(rangeMilliseconds) * sliceIndex / traceSlicesInput))
                int sliceRight = currentSession + int(math.floor(float(rangeMilliseconds) * (sliceIndex + 1) / traceSlicesInput))
                box missingSliceBox = box.new(
                     left = sliceLeft,
                     top = sliceHigh,
                     right = sliceRight,
                     bottom = sliceLow,
                     xloc = xloc.bar_time,
                     border_color = color.new(neutralColorInput, 5),
                     border_width = 1,
                     bgcolor = color.new(neutralColorInput, traceTransparencyInput)
                )
                array.set(sliceBoxes, sliceIndex, missingSliceBox)
                f_registerBox(storedBoxes, storedBoxSessions, missingSliceBox, currentSession)

        box sliceBox = array.get(sliceBoxes, sliceIndex)
        bool expandedUpper = sliceHigh > previousSliceHigh
        bool expandedLower = sliceLow < previousSliceLow
        color sliceColor = (
             expandedUpper and not expandedLower ? upperColorInput :
             expandedLower and not expandedUpper ? lowerColorInput :
             expandedUpper and expandedLower     ? twoSidedColorInput :
                                                   neutralColorInput
        )

        if not na(sliceBox)
            box.set_top(sliceBox, sliceHigh)
            box.set_bottom(sliceBox, sliceLow)
            box.set_border_color(sliceBox, sliceColor)
            box.set_bgcolor(sliceBox, color.new(sliceColor, traceTransparencyInput))

        previousSliceHigh := sliceHigh
        previousSliceLow := sliceLow

    float halfWidth = not na(currentHalfHigh) and not na(currentHalfLow) ? currentHalfHigh - currentHalfLow : 0.0
    float earlyWidth = not na(currentEarlyHigh) and not na(currentEarlyLow) ? currentEarlyHigh - currentEarlyLow : 0.0
    finalLateExpansionShare := math.max(0.0, math.min(1.0, f_safeRatio(finalRangeWidth - halfWidth, finalRangeWidth, 0.0)))
    finalEarlyWidthShare := math.max(0.0, math.min(1.0, f_safeRatio(earlyWidth, finalRangeWidth, 0.0)))

    if currentPartialStart
        finalWidthPercentile := na
        finalFormationClass := 0
    else
        if not na(finalRangeContextMeasure)
            finalWidthPercentile := f_percentile(finalRangeContextMeasure, widthHistory)
            array.push(widthHistory, finalRangeContextMeasure)
            while array.size(widthHistory) > widthContextInput
                array.shift(widthHistory)
        else
            finalWidthPercentile := na

        finalFormationClass := f_classify(
             finalPathEfficiency,
             finalCloseLocation,
             finalExpansionSkew,
             finalLateExpansionShare,
             finalEarlyWidthShare
        )

    color formationColor = currentPartialStart ? twoSidedColorInput : f_classColor(finalFormationClass)

    if not na(currentMainBox)
        box.set_top(currentMainBox, currentHigh)
        box.set_bottom(currentMainBox, currentLow)
        box.set_right(currentMainBox, currentRangeEnd)
        box.set_border_color(currentMainBox, formationColor)
        box.set_bgcolor(currentMainBox, color.new(formationColor, mainTransparencyInput))

    if not na(currentHighLine)
        line.set_xy1(currentHighLine, currentSession, currentHigh)
        line.set_xy2(currentHighLine, currentProjectionEnd, currentHigh)
    if not na(currentLowLine)
        line.set_xy1(currentLowLine, currentSession, currentLow)
        line.set_xy2(currentLowLine, currentProjectionEnd, currentLow)
    if not na(currentMidLine)
        line.set_xy1(currentMidLine, currentSession, finalRangeMidpoint)
        line.set_xy2(currentMidLine, currentProjectionEnd, finalRangeMidpoint)
    if not na(currentEquilibriumLine)
        line.set_xy1(currentEquilibriumLine, currentSession, finalRangeEquilibrium)
        line.set_xy2(currentEquilibriumLine, currentProjectionEnd, finalRangeEquilibrium)

    if showFormationLabelInput and currentRenderSession
        string resolutionText = (
             currentUsedChartFallback
                 ? f_localText(
                     japanese,
                     "Resolution: confirmed chart bars ~" + timeframe.period,
                     "解像度: 確定チャート足 ~" + timeframe.period
                 )
                 : f_localText(
                     japanese,
                     "Resolution: " + samplingTimeframe + " intrabars",
                     "解像度: " + samplingTimeframe + " 下位足"
                 )
        )
        string detailedFormationText = (
             currentPartialStart
                 ? f_localText(
                     japanese,
                     "Partial opening range\nEarlier samples unavailable",
                     "不完全なオープニングレンジ\n開始前半のデータなし"
                 )
                 : f_classText(finalFormationClass, japanese) + "\n" +
                   f_percentText(finalWidthPercentile, japanese) + "  |  " +
                   f_localText(japanese, "EFF ", "効率 ") + str.tostring(finalPathEfficiency, "#.00") + "\n" +
                   f_orderText(currentHighTime, currentLowTime, japanese) + "  |  " +
                   f_localText(japanese, "Late ", "後半 ") + str.tostring(finalLateExpansionShare * 100.0, "#") + "%"
        )
        string compactPercentile = (
             na(finalWidthPercentile)
                 ? f_localText(japanese, "P—", "順—")
                 : f_localText(japanese, "P", "順") + str.tostring(finalWidthPercentile, "#")
        )
        string compactFormationText = (
             currentPartialStart
                 ? f_localText(japanese, "Partial OR", "不完全OR")
                 : f_classShortText(finalFormationClass, japanese) + " · " + compactPercentile +
                   " · E" + str.tostring(finalPathEfficiency, "#.00") +
                   " · L" + str.tostring(finalLateExpansionShare * 100.0, "#") + "%" +
                   (currentUsedChartFallback ? " · ~" + timeframe.period : "")
        )
        string formationText = formationLabelDetailInput == "Detailed" ? detailedFormationText : compactFormationText
        string formationTooltip = (
             detailedFormationText + "\n" +
             f_localText(japanese, "Width ", "幅 ") + str.tostring(finalRangeWidth, format.mintick) +
             "  |  " + f_localText(japanese, "Width % ", "幅% ") + str.tostring(f_rangePercent(finalRangeWidth, currentOpen), "#.###") + "%\n" +
             f_localText(japanese, "Close location ", "終値位置 ") + str.tostring(finalCloseLocation, "#.00") +
             "  |  " + f_localText(japanese, "Skew ", "偏り ") + f_signed(finalExpansionSkew) + "\n" +
             f_localText(japanese, "Early share ", "初動比率 ") + str.tostring(finalEarlyWidthShare * 100.0, "#") + "%\n" +
             resolutionText
        )
        int formationSide = (
             currentPartialStart ? 1 :
             finalFormationClass > 0 ? -1 :
             finalFormationClass < 0 ? 1 :
             dayofmonth(currentSession, sessionTimezone) % 2 == 0 ? 1 : -1
        )
        float formationLane = formationLabelDetailInput == "Detailed" ? 3.80 : 3.20
        float formationLabelY = (
             formationSide > 0
                 ? f_upperLane(currentHigh, finalAnnotationStep, formationLane)
                 : f_lowerLane(currentLow, finalAnnotationStep, formationLane)
        )
        string formationStyle = (
             formationLabelDetailInput == "Detailed"
                 ? (formationSide > 0 ? label.style_label_lower_left : label.style_label_upper_left)
                 : (formationSide > 0 ? label.style_label_down : label.style_label_up)
        )
        int formationX = currentSession + int(math.round(rangeMilliseconds * 0.5))
        currentFormationLabel := label.new(
             x = formationX,
             y = formationLabelY,
             text = formationText,
             xloc = xloc.bar_time,
             yloc = yloc.price,
             style = formationStyle,
             color = color.new(formationColor, 4),
             textcolor = f_contrastText(formationColor),
             size = f_labelSize(labelSizeInput),
             textalign = formationLabelDetailInput == "Detailed" ? text.align_left : text.align_center,
             tooltip = formationTooltip
        )
        f_registerLabel(
             storedLabels,
             storedLabelSessions,
             storedLabelSides,
             storedLabelLanes,
             currentFormationLabel,
             currentSession,
             formationSide,
             formationLane
        )

    if showExtremeTimesInput and not currentPartialStart and currentRenderSession
        if not na(currentHighTime)
            string highTimeText = "H " + str.format_time(currentHighTime, "HH:mm", sessionTimezone)
            currentHighTimeLabel := label.new(
                 x = currentHighTime,
                 y = f_upperLane(currentHigh, finalAnnotationStep, 0.60),
                 text = highTimeText,
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style = label.style_label_down,
                 color = color.new(upperColorInput, 58),
                 textcolor = chart.fg_color,
                 size = f_labelSize(labelSizeInput),
                 tooltip = f_localText(japanese, "Final opening-range high time: ", "最終オープニングレンジ高値時刻: ") + str.format_time(currentHighTime, "yyyy-MM-dd HH:mm", sessionTimezone)
            )
            f_registerLabel(
                 storedLabels,
                 storedLabelSessions,
                 storedLabelSides,
                 storedLabelLanes,
                 currentHighTimeLabel,
                 currentSession,
                 1,
                 0.60
            )

        if not na(currentLowTime)
            string lowTimeText = "L " + str.format_time(currentLowTime, "HH:mm", sessionTimezone)
            currentLowTimeLabel := label.new(
                 x = currentLowTime,
                 y = f_lowerLane(currentLow, finalAnnotationStep, 0.60),
                 text = lowTimeText,
                 xloc = xloc.bar_time,
                 yloc = yloc.price,
                 style = label.style_label_up,
                 color = color.new(lowerColorInput, 58),
                 textcolor = chart.fg_color,
                 size = f_labelSize(labelSizeInput),
                 tooltip = f_localText(japanese, "Final opening-range low time: ", "最終オープニングレンジ安値時刻: ") + str.format_time(currentLowTime, "yyyy-MM-dd HH:mm", sessionTimezone)
            )
            f_registerLabel(
                 storedLabels,
                 storedLabelSessions,
                 storedLabelSides,
                 storedLabelLanes,
                 currentLowTimeLabel,
                 currentSession,
                 -1,
                 0.60
            )

//──────────────────────────────────────────────────────────────────────────────
// Projection bounds for collision-safe annotation reflow
// Uses chart-bar highs/lows only for visual clearance. It never changes the OR,
// classification, or evidence calculations.
//──────────────────────────────────────────────────────────────────────────────
bool chartBarInsideCurrentProjection = (
     currentStarted and currentLocked and
     time < currentProjectionEnd and time_close > currentRangeEnd
)
if currentRenderSession and chartBarInsideCurrentProjection and (not adaptiveHistory or barInsideVisibleWindow)
    f_updateSessionBounds(
         retainedSessions,
         retainedSessionTops,
         retainedSessionBottoms,
         retainedSessionWidths,
         currentSession,
         high,
         low,
         finalRangeWidth
    )

//──────────────────────────────────────────────────────────────────────────────
// Pass 2: Neutral post-range evidence tracking
//──────────────────────────────────────────────────────────────────────────────
if chartSupported and evidenceEnabledInput and currentLocked and not currentPartialStart and analysisSampleCount > 0
    for intrabarIndex = 0 to analysisSampleCount - 1
        bool coarseEvidenceSample = intrabarCount == 0
        int sampleTime = coarseEvidenceSample ? time : array.get(ltfTime, intrabarIndex)
        int sampleCloseTime = coarseEvidenceSample ? time_close : array.get(ltfTimeClose, intrabarIndex)
        float sampleHigh = coarseEvidenceSample ? high : array.get(ltfHigh, intrabarIndex)
        float sampleLow = coarseEvidenceSample ? low : array.get(ltfLow, intrabarIndex)
        float sampleClose = coarseEvidenceSample ? close : array.get(ltfClose, intrabarIndex)

        bool belongsToCurrentSession = f_sessionStart(sampleTime, sessionTimezone, sessionHour, sessionMinute) == currentSession
        bool inEvidenceWindow = sampleTime >= currentRangeEnd and sampleTime < currentProjectionEnd
        bool notProcessed = na(lastPostSampleTime) or sampleTime > lastPostSampleTime
        bool sampleAvailableNow = not barstate.isrealtime or sampleCloseTime <= timenow

        if belongsToCurrentSession and inEvidenceWindow and notProcessed and sampleAvailableNow
            lastPostSampleTime := sampleTime
            postSampleCount += 1
            currentUsedChartFallback := currentUsedChartFallback or coarseEvidenceSample

            if currentRenderSession
                visibleFallbackUsed := visibleFallbackUsed or coarseEvidenceSample
                if not adaptiveHistory or barInsideVisibleWindow
                    f_updateSessionBounds(
                         retainedSessions,
                         retainedSessionTops,
                         retainedSessionBottoms,
                         retainedSessionWidths,
                         currentSession,
                         sampleHigh,
                         sampleLow,
                         finalRangeWidth
                    )

            if sampleClose > currentHigh
                aboveSampleCount += 1
            else if sampleClose < currentLow
                belowSampleCount += 1
            else
                insideSampleCount += 1

            float touchBand = finalRangeWidth * touchBandInput
            bool upperTouched = sampleLow <= currentHigh + touchBand and sampleHigh >= currentHigh - touchBand
            bool lowerTouched = sampleLow <= currentLow + touchBand and sampleHigh >= currentLow - touchBand

            if upperTouched and not touchingUpper
                upperTestCount += 1
            if lowerTouched and not touchingLower
                lowerTestCount += 1
            touchingUpper := upperTouched
            touchingLower := lowerTouched

            maxUpperReachR := math.max(maxUpperReachR, math.max(0.0, (sampleHigh - currentHigh) / finalRangeWidth))
            maxLowerReachR := math.max(maxLowerReachR, math.max(0.0, (currentLow - sampleLow) / finalRangeWidth))

            float departureBuffer = finalRangeWidth * departureBufferInput
            bool aboveEvidence = (
                 evidenceBasisInput == "Close"
                     ? sampleClose > currentHigh + departureBuffer
                     : sampleHigh > currentHigh + departureBuffer
            )
            bool belowEvidence = (
                 evidenceBasisInput == "Close"
                     ? sampleClose < currentLow - departureBuffer
                     : sampleLow < currentLow - departureBuffer
            )

            if aboveEvidence and belowEvidence
                upperEvidenceRun := 0
                lowerEvidenceRun := 0
            else if aboveEvidence
                upperEvidenceRun += 1
                lowerEvidenceRun := 0
            else if belowEvidence
                lowerEvidenceRun += 1
                upperEvidenceRun := 0
            else
                upperEvidenceRun := 0
                lowerEvidenceRun := 0

            if firstDepartureSide == 0
                if upperEvidenceRun >= confirmationSamplesInput
                    firstDepartureSide := 1
                    firstDepartureTime := sampleTime
                    acceptedAboveEvent := true

                    if showEvidenceLabelsInput and currentRenderSession
                        string departureText = (
                             eventAnnotationModeInput == "Compact markers"
                                 ? "A↑"
                                 : f_localText(japanese, "Accepted above", "上側受容")
                        )
                        string departureTooltip = (
                             f_localText(
                                 japanese,
                                 "Accepted departure above the completed opening range",
                                 "完成オープニングレンジ上側への受容離脱"
                             ) + "\n" +
                             str.format_time(sampleTime, "yyyy-MM-dd HH:mm", sessionTimezone) + "  |  " +
                             f_localText(japanese, "Basis ", "基準 ") + evidenceBasisInput + "  |  " +
                             f_localText(japanese, "Confirmations ", "連続確認 ") + str.tostring(confirmationSamplesInput)
                        )
                        float departureLane = 1.20
                        string departureStyle = (
                             eventAnnotationModeInput == "Compact markers"
                                 ? label.style_label_down
                                 : label.style_label_lower_right
                        )
                        currentDepartureLabel := label.new(
                             x = sampleTime,
                             y = f_upperLane(currentHigh, finalAnnotationStep, departureLane),
                             text = departureText,
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = departureStyle,
                             color = color.new(upperColorInput, 3),
                             textcolor = f_contrastText(upperColorInput),
                             size = f_labelSize(labelSizeInput),
                             tooltip = departureTooltip
                        )
                        f_registerLabel(
                             storedLabels,
                             storedLabelSessions,
                             storedLabelSides,
                             storedLabelLanes,
                             currentDepartureLabel,
                             currentSession,
                             1,
                             departureLane
                        )

                else if lowerEvidenceRun >= confirmationSamplesInput
                    firstDepartureSide := -1
                    firstDepartureTime := sampleTime
                    acceptedBelowEvent := true

                    if showEvidenceLabelsInput and currentRenderSession
                        string departureText = (
                             eventAnnotationModeInput == "Compact markers"
                                 ? "A↓"
                                 : f_localText(japanese, "Accepted below", "下側受容")
                        )
                        string departureTooltip = (
                             f_localText(
                                 japanese,
                                 "Accepted departure below the completed opening range",
                                 "完成オープニングレンジ下側への受容離脱"
                             ) + "\n" +
                             str.format_time(sampleTime, "yyyy-MM-dd HH:mm", sessionTimezone) + "  |  " +
                             f_localText(japanese, "Basis ", "基準 ") + evidenceBasisInput + "  |  " +
                             f_localText(japanese, "Confirmations ", "連続確認 ") + str.tostring(confirmationSamplesInput)
                        )
                        float departureLane = 1.20
                        string departureStyle = (
                             eventAnnotationModeInput == "Compact markers"
                                 ? label.style_label_up
                                 : label.style_label_upper_right
                        )
                        currentDepartureLabel := label.new(
                             x = sampleTime,
                             y = f_lowerLane(currentLow, finalAnnotationStep, departureLane),
                             text = departureText,
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = departureStyle,
                             color = color.new(lowerColorInput, 3),
                             textcolor = f_contrastText(lowerColorInput),
                             size = f_labelSize(labelSizeInput),
                             tooltip = departureTooltip
                        )
                        f_registerLabel(
                             storedLabels,
                             storedLabelSessions,
                             storedLabelSides,
                             storedLabelLanes,
                             currentDepartureLabel,
                             currentSession,
                             -1,
                             departureLane
                        )

            if firstDepartureSide != 0 and not reenteredRange and sampleTime > firstDepartureTime
                bool returnedInside = firstDepartureSide == 1 ? sampleClose <= currentHigh : sampleClose >= currentLow
                if returnedInside
                    reenteredRange := true
                    reentryTime := sampleTime
                    reentryEvent := true

                    if showEvidenceLabelsInput and currentRenderSession
                        string reentryText = (
                             eventAnnotationModeInput == "Compact markers"
                                 ? "R"
                                 : f_localText(japanese, "Re-entry", "再侵入")
                        )
                        string reentryTooltip = (
                             f_localText(
                                 japanese,
                                 "Price re-entered the completed opening range after the first accepted departure",
                                 "最初の受容離脱後に完成オープニングレンジへ再侵入"
                             ) + "\n" +
                             str.format_time(sampleTime, "yyyy-MM-dd HH:mm", sessionTimezone)
                        )
                        int reentrySide = firstDepartureSide
                        float reentryLane = 2.25
                        float reentryY = (
                             reentrySide > 0
                                 ? f_upperLane(currentHigh, finalAnnotationStep, reentryLane)
                                 : f_lowerLane(currentLow, finalAnnotationStep, reentryLane)
                        )
                        string reentryStyle = (
                             eventAnnotationModeInput == "Compact markers"
                                 ? (reentrySide > 0 ? label.style_label_down : label.style_label_up)
                                 : (reentrySide > 0 ? label.style_label_lower_left : label.style_label_upper_left)
                        )
                        currentReentryLabel := label.new(
                             x = sampleTime,
                             y = reentryY,
                             text = reentryText,
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = reentryStyle,
                             color = color.new(neutralColorInput, 6),
                             textcolor = f_contrastText(neutralColorInput),
                             size = f_labelSize(labelSizeInput),
                             tooltip = reentryTooltip
                        )
                        f_registerLabel(
                             storedLabels,
                             storedLabelSessions,
                             storedLabelSides,
                             storedLabelLanes,
                             currentReentryLabel,
                             currentSession,
                             reentrySide,
                             reentryLane
                        )

            if reenteredRange and not traversedOppositeEdge and sampleTime > reentryTime
                bool oppositeEdgeReached = (
                     firstDepartureSide == 1
                         ? sampleLow <= currentLow
                         : sampleHigh >= currentHigh
                )
                if oppositeEdgeReached
                    traversedOppositeEdge := true
                    traverseEvent := true

                    if showEvidenceLabelsInput and currentRenderSession
                        string traverseText = (
                             eventAnnotationModeInput == "Compact markers"
                                 ? "X"
                                 : f_localText(japanese, "Opposite edge", "反対端到達")
                        )
                        string traverseTooltip = (
                             f_localText(
                                 japanese,
                                 "Price reached the opposite opening-range edge after re-entry",
                                 "再侵入後にオープニングレンジの反対端へ到達"
                             ) + "\n" +
                             str.format_time(sampleTime, "yyyy-MM-dd HH:mm", sessionTimezone)
                        )
                        int traverseSide = -firstDepartureSide
                        float traverseLane = 1.20
                        float traverseY = (
                             traverseSide > 0
                                 ? f_upperLane(currentHigh, finalAnnotationStep, traverseLane)
                                 : f_lowerLane(currentLow, finalAnnotationStep, traverseLane)
                        )
                        string traverseStyle = (
                             eventAnnotationModeInput == "Compact markers"
                                 ? (traverseSide > 0 ? label.style_label_down : label.style_label_up)
                                 : (traverseSide > 0 ? label.style_label_lower_left : label.style_label_upper_left)
                        )
                        currentTraverseLabel := label.new(
                             x = sampleTime,
                             y = traverseY,
                             text = traverseText,
                             xloc = xloc.bar_time,
                             yloc = yloc.price,
                             style = traverseStyle,
                             color = color.new(twoSidedColorInput, 3),
                             textcolor = f_contrastText(twoSidedColorInput),
                             size = f_labelSize(labelSizeInput),
                             tooltip = traverseTooltip
                        )
                        f_registerLabel(
                             storedLabels,
                             storedLabelSessions,
                             storedLabelSides,
                             storedLabelLanes,
                             currentTraverseLabel,
                             currentSession,
                             traverseSide,
                             traverseLane
                        )

//──────────────────────────────────────────────────────────────────────────────
// Research-card snapshot and final visual reflow
//──────────────────────────────────────────────────────────────────────────────
if currentRenderSession and currentStarted and (not adaptiveHistory or time <= chart.right_visible_bar_time)
    cardStarted := true
    cardSession := currentSession
    cardRangeEnd := currentRangeEnd
    cardProjectionEnd := currentProjectionEnd
    cardObservationTime := math.min(barstate.isrealtime ? timenow : nz(time_close, time), currentProjectionEnd)
    cardLocked := currentLocked
    cardPartialStart := currentPartialStart
    cardUsedChartFallback := currentUsedChartFallback
    cardHigh := currentHigh
    cardLow := currentLow
    cardWidth := currentLocked ? finalRangeWidth : math.max(nz(currentHigh - currentLow, syminfo.mintick), syminfo.mintick)
    cardPercentile := finalWidthPercentile
    cardEfficiency := finalPathEfficiency
    cardLateShare := finalLateExpansionShare
    cardSkew := finalExpansionSkew
    cardClassification := finalFormationClass
    cardPostSampleCount := postSampleCount
    cardInsideSampleCount := insideSampleCount
    cardAboveSampleCount := aboveSampleCount
    cardBelowSampleCount := belowSampleCount
    cardFirstDepartureSide := firstDepartureSide
    cardReenteredRange := reenteredRange
    cardTraversedOppositeEdge := traversedOppositeEdge
    cardUpperTestCount := upperTestCount
    cardLowerTestCount := lowerTestCount
    cardMaxUpperReachR := maxUpperReachR
    cardMaxLowerReachR := maxLowerReachR

if barstate.islast
    float visibleSpan = (
         not na(visibleChartHigh) and not na(visibleChartLow)
             ? math.max(visibleChartHigh - visibleChartLow, syminfo.mintick)
             : math.max(high - low, syminfo.mintick)
    )
    f_reflowLabels(
         storedLabels,
         storedLabelSessions,
         storedLabelSides,
         storedLabelLanes,
         retainedSessions,
         retainedSessionTops,
         retainedSessionBottoms,
         retainedSessionWidths,
         visibleSpan
    )

    bool showPanelData = cardStarted and researchCardModeInput != "Off"
    string panelHeaderText = ""
    string panelClassText = ""
    string panelStateText = ""
    string panelFlowText = ""
    string panelDetailText = ""
    string panelResolutionText = ""
    string panelStateIcon = "OR"
    string panelPercentileValue = "—"
    string panelEfficiencyValue = "—"
    string panelLateValue = "—"
    float panelPercentileRatio = na
    float panelEfficiencyRatio = na
    float panelLateRatio = na
    color panelAccentColor = neutralColorInput

    if showPanelData
        string scopeEnglish = adaptiveHistory ? "VISIBLE OPENING RANGE" : "LATEST OPENING RANGE"
        string scopeJapanese = adaptiveHistory ? "表示中オープニングレンジ" : "最新オープニングレンジ"
        panelHeaderText := (
             (japanese ? scopeJapanese : scopeEnglish) + "  ·  " +
             str.format_time(cardSession, "MM-dd HH:mm", sessionTimezone)
        )

        float panelInsidePercent = cardPostSampleCount > 0 ? 100.0 * cardInsideSampleCount / cardPostSampleCount : na
        float panelAbovePercent = cardPostSampleCount > 0 ? 100.0 * cardAboveSampleCount / cardPostSampleCount : na
        float panelBelowPercent = cardPostSampleCount > 0 ? 100.0 * cardBelowSampleCount / cardPostSampleCount : na
        int panelElapsedMinutes = int(math.floor(math.max(0, math.min(cardObservationTime, cardRangeEnd) - cardSession) / MS_MINUTE))
        panelResolutionText := (
             cardUsedChartFallback
                 ? f_localText(japanese, "Resolution  ·  confirmed chart bars ~" + timeframe.period, "解像度  ·  確定チャート足 ~" + timeframe.period)
                 : f_localText(japanese, "Resolution  ·  " + samplingTimeframe + " intrabars", "解像度  ·  " + samplingTimeframe + " 下位足")
        )

        if not cardLocked
            panelClassText := (
                 f_localText(japanese, "BUILDING RANGE", "レンジ形成中") + "  " +
                 str.tostring(math.min(panelElapsedMinutes, rangeMinutesInput)) + "/" + str.tostring(rangeMinutesInput) + "m"
            )
            panelStateText := f_localText(japanese, "Capturing the opening auction in realtime", "寄り付きオークションをリアルタイム収集中")
            panelFlowText := f_localText(japanese, "High / low / equilibrium are updating", "高値・安値・均衡値を更新中")
            panelDetailText := f_localText(japanese, "Current width  ", "現在幅  ") + str.tostring(cardWidth, format.mintick)
            panelStateIcon := "LIVE"
            panelAccentColor := neutralColorInput
        else if cardPartialStart
            panelClassText := f_localText(japanese, "PARTIAL OPENING RANGE", "不完全オープニングレンジ")
            panelStateText := f_localText(japanese, "Earlier opening samples are unavailable", "寄り付き前半サンプルを取得できません")
            panelFlowText := f_localText(japanese, "Classification and evidence are intentionally disabled", "形成分類とレンジ後検証を意図的に停止")
            panelDetailText := f_localText(japanese, "Research-grade fallback only", "研究用フォールバック表示")
            panelStateIcon := "!"
            panelAccentColor := twoSidedColorInput
        else
            panelClassText := researchCardModeInput == "Detailed" ? f_classText(cardClassification, japanese) : f_classShortText(cardClassification, japanese)
            panelPercentileValue := na(cardPercentile) ? "—" : str.tostring(cardPercentile, "#")
            panelEfficiencyValue := str.tostring(cardEfficiency, "#.00")
            panelLateValue := str.tostring(cardLateShare * 100.0, "#") + "%"
            panelPercentileRatio := na(cardPercentile) ? na : cardPercentile / 100.0
            panelEfficiencyRatio := cardEfficiency
            panelLateRatio := cardLateShare

            panelStateText := (
                 not evidenceEnabledInput
                     ? f_localText(japanese, "Evidence tracking is off", "レンジ後検証はオフ")
                     : cardFirstDepartureSide == 0
                         ? f_localText(japanese, "No accepted departure", "受容離脱なし")
                         : cardTraversedOppositeEdge
                             ? f_localText(japanese, "Opposite edge traversed", "反対端まで横断")
                             : cardReenteredRange
                                 ? f_localText(japanese, "Re-entered the range", "レンジへ再侵入")
                                 : cardFirstDepartureSide == 1
                                     ? f_localText(japanese, "Holding above after acceptance", "上側受容後に上方滞在")
                                     : f_localText(japanese, "Holding below after acceptance", "下側受容後に下方滞在")
            )
            panelStateIcon := (
                 not evidenceEnabledInput ? "—" :
                 cardTraversedOppositeEdge ? "↔" :
                 cardReenteredRange ? "↩" :
                 cardFirstDepartureSide == 1 ? "↑" :
                 cardFirstDepartureSide == -1 ? "↓" :
                 "•"
            )

            string departureNode = cardFirstDepartureSide == 1 ? "A↑" : cardFirstDepartureSide == -1 ? "A↓" : "A·"
            string reentryNode = cardReenteredRange ? "R✓" : "R·"
            string traverseNode = cardTraversedOppositeEdge ? "X✓" : "X·"
            panelFlowText := evidenceEnabledInput ? departureNode + "   ›   " + reentryNode + "   ›   " + traverseNode : "A—   ›   R—   ›   X—"

            string compactDetail = (
                 f_localText(japanese, "Tests U/L  ", "テスト 上/下  ") +
                 str.tostring(cardUpperTestCount) + "/" + str.tostring(cardLowerTestCount) +
                 "   ·   " + f_localText(japanese, "Reach +", "到達 +") + str.tostring(cardMaxUpperReachR, "#.00") + "R / -" +
                 str.tostring(cardMaxLowerReachR, "#.00") + "R"
            )
            string detailedDetail = (
                 f_localText(japanese, "Dwell I/U/D  ", "滞在 内/上/下  ") +
                 (na(panelInsidePercent)
                     ? "n/a"
                     : str.tostring(panelInsidePercent, "#") + "/" +
                       str.tostring(panelAbovePercent, "#") + "/" +
                       str.tostring(panelBelowPercent, "#") + "%") +
                 "   ·   " + compactDetail
            )
            panelDetailText := researchCardModeInput == "Detailed" ? detailedDetail : compactDetail
            panelAccentColor := (
                 cardTraversedOppositeEdge or cardReenteredRange ? twoSidedColorInput :
                 cardFirstDepartureSide == 1 ? upperColorInput :
                 cardFirstDepartureSide == -1 ? lowerColorInput :
                 f_classColor(cardClassification)
            )

    string noticeText = ""
    if not chartSupported
        noticeText := f_appendLine(
             noticeText,
             f_localText(
                 japanese,
                 "Use a standard intraday chart; synthetic and daily-or-higher charts are disabled.",
                 "標準の日中足チャートを使用してください。合成足および日足以上では停止します。"
             )
        )
    else
        if samplingFallback
            noticeText := f_appendLine(
                 noticeText,
                 f_localText(
                     japanese,
                     "Sampling fallback: the chart timeframe replaces the selected higher sampling timeframe.",
                     "サンプリング退避: 選択足がチャート足より上位のためチャート足を使用しています。"
                 )
            )
        if not boundaryAligned
            noticeText := f_appendLine(
                 noticeText,
                 f_localText(
                     japanese,
                     "Boundary note: choose a finer sampling timeframe for cleaner range-end attribution.",
                     "境界注意: より細かいサンプリング足でレンジ終了境界が明確になります。"
                 )
            )
        if cardStarted and cardPartialStart
            noticeText := f_appendLine(
                 noticeText,
                 f_localText(
                     japanese,
                     "Partial visible session: classification and post-range evidence are disabled.",
                     "表示セッションは不完全です。形成分類とレンジ後検証を停止しています。"
                 )
            )
        if adaptiveHistory and visibleFallbackUsed
            noticeText := f_appendLine(
                 noticeText,
                 f_localText(
                     japanese,
                     "Coarse history active: some visible sessions use confirmed " + timeframe.period + " chart bars.",
                     "粗い履歴を使用中: 一部の表示セッションは確定" + timeframe.period + "チャート足で再構築しています。"
                 )
            )
        if adaptiveHistory and visibleHistoryGapDetected
            noticeText := f_appendLine(
                 noticeText,
                 f_localText(
                     japanese,
                     "Some visible bars exceed available intrabar history and cannot use chart-bar fallback at this timeframe.",
                     "一部の表示バーは下位足履歴外で、この時間足ではチャート足退避を使用できません。"
                 )
            )
        if adaptiveHistory and historyBudgetExceeded
            noticeText := f_appendLine(
                 noticeText,
                 f_localText(
                     japanese,
                     "Visible-session drawing budget reached; the newest " + str.tostring(sessionsToKeepInput) + " intersecting sessions are retained.",
                     "表示セッション描画上限に到達し、交差する新しい" + str.tostring(sessionsToKeepInput) + "セッションを保持しています。"
                 )
            )
        if adaptiveHistory and not cardStarted
            noticeText := f_appendLine(
                 noticeText,
                 f_localText(
                     japanese,
                     "No configured opening range intersects the current visible window.",
                     "現在の表示範囲に設定済みオープニングレンジがありません。"
                 )
            )

    bool showNoticeCell = noticeText != ""
    bool showPanelSurface = showPanelData or showNoticeCell
    color panelBaseBackground = color.new(chart.bg_color, 4)
    color panelSecondaryBackground = color.new(chart.fg_color, 92)
    color panelTransparent = color.new(chart.bg_color, 100)
    color panelAccentText = f_contrastText(panelAccentColor)

    int panelMicroTextSize = f_panelMicroSize(researchPanelScaleInput)
    int panelBaseTextSize = f_panelBaseSize(researchPanelScaleInput)
    int panelValueTextSize = f_panelValueSize(researchPanelScaleInput)
    int panelIconTextSize = f_panelIconSize(researchPanelScaleInput)
    string panelInnerPad = researchPanelScaleInput == "Compact" ? " " : "  "

    table.set_position(researchPanel, f_tablePosition(researchPanelPositionInput))

    table.cell(
         researchPanel,
         0,
         0,
         showPanelData ? panelInnerPad + panelHeaderText + panelInnerPad : "",
         text_color = showPanelData ? panelAccentColor : color.new(chart.fg_color, 100),
         text_halign = text.align_left,
         text_valign = text.align_center,
         text_size = panelMicroTextSize,
         text_formatting = text.format_bold,
         bgcolor = showPanelData ? panelBaseBackground : panelTransparent
    )
    table.cell(
         researchPanel,
         0,
         1,
         showPanelData ? panelStateIcon : "",
         text_color = showPanelData ? panelAccentText : color.new(chart.fg_color, 100),
         text_halign = text.align_center,
         text_valign = text.align_center,
         text_size = panelIconTextSize,
         text_formatting = text.format_bold,
         bgcolor = showPanelData ? panelAccentColor : panelTransparent
    )
    table.cell(
         researchPanel,
         1,
         1,
         showPanelData ? panelInnerPad + panelClassText + panelInnerPad : "",
         text_color = showPanelData ? panelAccentText : color.new(chart.fg_color, 100),
         text_halign = text.align_left,
         text_valign = text.align_center,
         text_size = panelValueTextSize,
         text_formatting = text.format_bold,
         bgcolor = showPanelData ? color.new(panelAccentColor, 12) : panelTransparent
    )

    table.cell(researchPanel, 0, 2, showPanelData ? " PCTL" : "", text_color = twoSidedColorInput, text_halign = text.align_left, text_size = panelBaseTextSize, text_formatting = text.format_bold, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    table.cell(researchPanel, 2, 2, showPanelData ? panelPercentileValue + " " : "", text_color = twoSidedColorInput, text_halign = text.align_right, text_size = panelValueTextSize, text_formatting = text.format_bold, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    f_drawPanelMeter(researchPanel, 2, panelPercentileRatio, twoSidedColorInput, panelBaseBackground, showPanelData)

    table.cell(researchPanel, 0, 3, showPanelData ? " EFF" : "", text_color = upperColorInput, text_halign = text.align_left, text_size = panelBaseTextSize, text_formatting = text.format_bold, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    table.cell(researchPanel, 2, 3, showPanelData ? panelEfficiencyValue + " " : "", text_color = upperColorInput, text_halign = text.align_right, text_size = panelValueTextSize, text_formatting = text.format_bold, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    f_drawPanelMeter(researchPanel, 3, panelEfficiencyRatio, upperColorInput, panelBaseBackground, showPanelData)

    table.cell(researchPanel, 0, 4, showPanelData ? " LATE" : "", text_color = lowerColorInput, text_halign = text.align_left, text_size = panelBaseTextSize, text_formatting = text.format_bold, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    table.cell(researchPanel, 2, 4, showPanelData ? panelLateValue + " " : "", text_color = lowerColorInput, text_halign = text.align_right, text_size = panelValueTextSize, text_formatting = text.format_bold, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    f_drawPanelMeter(researchPanel, 4, panelLateRatio, lowerColorInput, panelBaseBackground, showPanelData)

    table.cell(
         researchPanel,
         0,
         5,
         showPanelData ? "●" : "",
         text_color = showPanelData ? panelAccentColor : color.new(chart.fg_color, 100),
         text_halign = text.align_center,
         text_size = panelValueTextSize,
         text_formatting = text.format_bold,
         bgcolor = showPanelData ? panelSecondaryBackground : panelTransparent
    )
    table.cell(
         researchPanel,
         1,
         5,
         showPanelData ? panelInnerPad + panelStateText + panelInnerPad : "",
         text_color = chart.fg_color,
         text_halign = text.align_left,
         text_size = panelBaseTextSize,
         bgcolor = showPanelData ? panelSecondaryBackground : panelTransparent
    )
    table.cell(researchPanel, 0, 6, showPanelData ? " FLOW" : "", text_color = neutralColorInput, text_halign = text.align_left, text_size = panelBaseTextSize, text_formatting = text.format_bold, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    table.cell(researchPanel, 2, 6, showPanelData ? panelInnerPad + panelFlowText + panelInnerPad : "", text_color = panelAccentColor, text_halign = text.align_left, text_size = panelValueTextSize, text_formatting = text.format_bold, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    table.cell(researchPanel, 0, 7, showPanelData ? " STUDY" : "", text_color = neutralColorInput, text_halign = text.align_left, text_size = panelBaseTextSize, text_formatting = text.format_bold, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    table.cell(researchPanel, 2, 7, showPanelData ? panelInnerPad + panelDetailText + panelInnerPad : "", text_color = chart.fg_color, text_halign = text.align_left, text_size = panelBaseTextSize, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    table.cell(researchPanel, 0, 8, showPanelData ? panelInnerPad + panelResolutionText + panelInnerPad : "", text_color = color.new(chart.fg_color, 18), text_halign = text.align_left, text_size = panelMicroTextSize, bgcolor = showPanelData ? panelBaseBackground : panelTransparent)
    table.cell(
         researchPanel,
         0,
         9,
         showNoticeCell ? panelInnerPad + "⚠  " + noticeText + panelInnerPad : "",
         text_color = showNoticeCell ? f_contrastText(twoSidedColorInput) : color.new(chart.fg_color, 100),
         text_halign = text.align_left,
         text_size = panelBaseTextSize,
         text_formatting = text.format_bold,
         bgcolor = showNoticeCell ? color.new(twoSidedColorInput, 8) : panelTransparent
    )

    // Transparent right clearance: keeps the wider panel away from price-scale labels.
    table.cell(
         researchPanel,
         PANEL_SPACER_COLUMN,
         0,
         showPanelSurface ? "••••" : "",
         text_color = color.new(chart.fg_color, 100),
         text_size = panelBaseTextSize,
         bgcolor = panelTransparent
    )
    for panelRow = 1 to 9
        table.cell(researchPanel, PANEL_SPACER_COLUMN, panelRow, "", bgcolor = panelTransparent)

    // Transparent bottom clearance: keeps the panel off the time-axis edge.
    table.cell(
         researchPanel,
         0,
         PANEL_BOTTOM_SPACER_ROW,
         showPanelSurface ? " " : "",
         text_color = color.new(chart.fg_color, 100),
         text_size = panelMicroTextSize,
         bgcolor = panelTransparent
    )

//──────────────────────────────────────────────────────────────────────────────
// Research outputs
// These appear in the Data Window for transparent study, but remain absent from
// the chart and status line. They are also available to external-source workflows.
// Extreme-order code: 1 = final high occurred first, -1 = final low occurred first,
// 0 = both final extremes were first recorded in the same sampled interval.
// Formation code: -2 late lower, -1 lower-led, 0 mixed, 1 upper-led,
// 2 late upper, 3 late two-sided, 4 rotational, 5 two-sided.
// Evidence code: sign = first departure side; absolute value 1 = accepted,
// 2 = re-entered, 3 = traversed to the opposite edge.
//──────────────────────────────────────────────────────────────────────────────
int evidenceStateCode = (
     not currentLocked             ? 0 :
     traversedOppositeEdge         ? firstDepartureSide * 3 :
     reenteredRange                ? firstDepartureSide * 2 :
                                     firstDepartureSide
)

plot(currentStarted ? currentHigh : na, "Opening Range High", display = display.data_window, editable = false)
plot(currentStarted ? currentLow : na, "Opening Range Low", display = display.data_window, editable = false)
plot(currentLocked ? finalRangeEquilibrium : na, "Opening Range Equilibrium", display = display.data_window, editable = false)
plot(currentLocked ? f_rangePercent(finalRangeWidth, currentOpen) : na, "Opening Range Width Percent", display = display.data_window, editable = false)
plot(currentLocked and not currentPartialStart ? finalWidthPercentile : na, "Opening Range Width Percentile", display = display.data_window, editable = false)
plot(currentLocked and not currentPartialStart ? finalPathEfficiency : na, "Sampled Path Efficiency", display = display.data_window, editable = false)
plot(currentLocked and not currentPartialStart ? finalCloseLocation : na, "Opening Range Close Location", display = display.data_window, editable = false)
plot(currentLocked and not currentPartialStart ? finalExpansionSkew : na, "Opening Range Expansion Skew", display = display.data_window, editable = false)
plot(currentLocked and not currentPartialStart ? finalLateExpansionShare : na, "Late Expansion Share", display = display.data_window, editable = false)
plot(currentLocked and not currentPartialStart ? finalEarlyWidthShare : na, "Early Checkpoint Width Share", display = display.data_window, editable = false)
plot(currentLocked and not currentPartialStart ? (currentHighTime < currentLowTime ? 1 : currentHighTime > currentLowTime ? -1 : 0) : na, "Final Extreme Order Code", display = display.data_window, editable = false)
plot(currentLocked and not currentPartialStart ? finalFormationClass : na, "Formation Classification Code", display = display.data_window, editable = false)
plot(currentLocked and not currentPartialStart and evidenceEnabledInput ? evidenceStateCode : na, "Post-Range Evidence State Code", display = display.data_window, editable = false)

//──────────────────────────────────────────────────────────────────────────────
// Alerts: neutral research events, not trade instructions
//──────────────────────────────────────────────────────────────────────────────
alertcondition(
     rangeLockedEvent and barstate.isconfirmed,
     "Opening range locked",
     "Opening Range Formation Trace: the configured opening range has locked."
)

alertcondition(
     acceptedAboveEvent and barstate.isconfirmed,
     "Accepted departure above",
     "Opening Range Formation Trace: the first configured accepted departure occurred above the range."
)

alertcondition(
     acceptedBelowEvent and barstate.isconfirmed,
     "Accepted departure below",
     "Opening Range Formation Trace: the first configured accepted departure occurred below the range."
)

alertcondition(
     reentryEvent and barstate.isconfirmed,
     "Range re-entry",
     "Opening Range Formation Trace: price re-entered the range after the first accepted departure."
)

alertcondition(
     traverseEvent and barstate.isconfirmed,
     "Opposite-edge traverse",
     "Opening Range Formation Trace: price reached the opposite range edge after re-entry."
)
