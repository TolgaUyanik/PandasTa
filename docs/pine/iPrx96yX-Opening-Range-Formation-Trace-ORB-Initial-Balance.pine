//──────────────────────────────────────────────────────────────────────────────
// Helpers
//──────────────────────────────────────────────────────────────────────────────
f_localText(bool japanese, string englishText, string japaneseText) =>
    japanese ? japaneseText : englishText

f_lineStyle(string styleText) =>
    styleText == "Solid" ? line.style_solid : styleText == "Dotted" ? line.style_dotted : line.style_dashed

f_labelSize(string sizeText) =>
    sizeText == "Tiny" ? size.tiny : sizeText == "Normal" ? size.normal : size.small

f_panelMicroSize(string scaleText) =>
    scaleText == "Compact" ? PANEL_MICRO_COMPACT : scaleText == "Large" ? PANEL_MICRO_LARGE : PANEL_MICRO_COMFORTABLE

f_panelBaseSize(string scaleText) =>
    scaleText == "Compact" ? PANEL_BASE_COMPACT : scaleText == "Large" ? PANEL_BASE_LARGE : PANEL_BASE_COMFORTABLE

f_panelValueSize(string scaleText) =>
    scaleText == "Compact" ? PANEL_VALUE_COMPACT : scaleText == "Large" ? PANEL_VALUE_LARGE : PANEL_VALUE_COMFORTABLE

f_panelIconSize(string scaleText) =>
    scaleText == "Compact" ? PANEL_ICON_COMPACT : scaleText == "Large" ? PANEL_ICON_LARGE : PANEL_ICON_COMFORTABLE

f_tablePosition(string positionText) =>
    (
         positionText == "Top left" ? position.top_left :
         positionText == "Bottom right" ? position.bottom_right :
         positionText == "Bottom left" ? position.bottom_left :
         position.top_right
    )

f_contrastText(color backgroundColor) =>
    float perceivedLuminance = (
         0.299 * color.r(backgroundColor) +
         0.587 * color.g(backgroundColor) +
         0.114 * color.b(backgroundColor)
    )
    perceivedLuminance >= 150.0 ? color.rgb(7, 15, 28) : color.white

f_drawPanelMeter(
     table panel,
     int row,
     float normalizedValue,
     color activeColor,
     color baseBackground,
     bool visible
) =>
    float boundedValue = na(normalizedValue) ? 0.0 : math.max(0.0, math.min(1.0, normalizedValue))
    int filledSegments = visible and not na(normalizedValue) ? int(math.round(boundedValue * PANEL_METER_SEGMENTS)) : 0
    for segment = 0 to PANEL_METER_SEGMENTS - 1
        bool segmentActive = segment < filledSegments
        table.cell(
             panel,
             segment + 3,
             row,
             visible ? "■" : "",
             text_color = segmentActive ? activeColor : color.new(chart.fg_color, 84),
             text_halign = text.align_center,
             text_valign = text.align_center,
             text_size = f_panelBaseSize(researchPanelScaleInput),
             text_formatting = text.format_bold,
             bgcolor = visible ? baseBackground : color.new(chart.bg_color, 100)
        )
    0

f_annotationStep(float rangeWidth, float visibleSpan) =>
    float sizeScale = labelSizeInput == "Tiny" ? 0.85 : labelSizeInput == "Normal" ? 1.25 : 1.00
    float widthBasedStep = math.max(nz(rangeWidth, syminfo.mintick), syminfo.mintick) * annotationSpacingInput
    float visibleBasedFloor = na(visibleSpan) ? 0.0 : math.max(visibleSpan, syminfo.mintick) * visibleLaneFloorInput / 100.0
    float tickBasedFloor = syminfo.mintick * 6.0
    math.max(math.max(widthBasedStep, visibleBasedFloor), tickBasedFloor) * sizeScale

f_upperLane(float upperEdge, float laneStep, float laneNumber) =>
    upperEdge + laneStep * laneNumber

f_lowerLane(float lowerEdge, float laneStep, float laneNumber) =>
    lowerEdge - laneStep * laneNumber

f_sessionStart(int sampleTime, string timezone, int openingHour, int openingMinute) =>
    int localMidnight = timestamp(
         timezone,
         year(sampleTime, timezone),
         month(sampleTime, timezone),
         dayofmonth(sampleTime, timezone),
         0,
         0
    )
    int todayStart = timestamp(
         timezone,
         year(sampleTime, timezone),
         month(sampleTime, timezone),
         dayofmonth(sampleTime, timezone),
         openingHour,
         openingMinute
    )
    int previousDayProbe = localMidnight - 12 * MS_HOUR
    int previousStart = timestamp(
         timezone,
         year(previousDayProbe, timezone),
         month(previousDayProbe, timezone),
         dayofmonth(previousDayProbe, timezone),
         openingHour,
         openingMinute
    )
    sampleTime >= todayStart ? todayStart : previousStart

f_dayAllowed(int sessionStart, string timezone, string dayMask) =>
    int sessionDay = dayofweek(sessionStart, timezone)
    str.contains(dayMask, str.tostring(sessionDay))

f_safeRatio(float numerator, float denominator, float fallback) =>
    not na(denominator) and denominator != 0.0 ? numerator / denominator : fallback

f_rangePercent(float rangeWidth, float openingPrice) =>
    openingPrice != 0.0 ? 100.0 * rangeWidth / math.abs(openingPrice) : na

f_percentile(float currentValue, array<float> history) =>
    int historyCount = array.size(history)
    float result = na
    if historyCount >= 5 and not na(currentValue)
        float rank = 0.0
        for historicalValue in history
            rank += currentValue > historicalValue ? 1.0 : currentValue == historicalValue ? 0.5 : 0.0
        result := 100.0 * rank / historyCount
    result

f_classify(
     float efficiency,
     float closeLocation,
     float expansionSkew,
     float lateShare,
     float earlyWidthShare
) =>
    int classification = 0
    bool upperDrive = efficiency >= driveEfficiencyInput and closeLocation >= edgeCloseInput and expansionSkew >= skewThresholdInput
    bool lowerDrive = efficiency >= driveEfficiencyInput and closeLocation <= 1.0 - edgeCloseInput and expansionSkew <= -skewThresholdInput
    bool lateExpansion = lateShare >= lateShareInput
    bool rotation = efficiency <= rotationEfficiencyInput and closeLocation >= 0.35 and closeLocation <= 0.65
    bool twoSided = math.abs(expansionSkew) < skewThresholdInput and earlyWidthShare <= earlyShareMaxInput

    if upperDrive
        classification := 1
    else if lowerDrive
        classification := -1
    else if lateExpansion and expansionSkew >= skewThresholdInput
        classification := 2
    else if lateExpansion and expansionSkew <= -skewThresholdInput
        classification := -2
    else if lateExpansion
        classification := 3
    else if rotation
        classification := 4
    else if twoSided
        classification := 5
    classification

f_classText(int classification, bool japanese) =>
    string englishText = "Mixed formation"
    string japaneseText = "混合形成"

    if classification == 1
        englishText := "Upper-led drive"
        japaneseText := "上側主導ドライブ"
    else if classification == -1
        englishText := "Lower-led drive"
        japaneseText := "下側主導ドライブ"
    else if classification == 2
        englishText := "Late upper expansion"
        japaneseText := "後半上側拡張"
    else if classification == -2
        englishText := "Late lower expansion"
        japaneseText := "後半下側拡張"
    else if classification == 3
        englishText := "Late two-sided expansion"
        japaneseText := "後半両側拡張"
    else if classification == 4
        englishText := "Rotational formation"
        japaneseText := "回転型形成"
    else if classification == 5
        englishText := "Two-sided formation"
        japaneseText := "両側形成"

    japanese ? japaneseText : englishText

f_classShortText(int classification, bool japanese) =>
    string englishText = "Mixed"
    string japaneseText = "混合"

    if classification == 1
        englishText := "Upper drive"
        japaneseText := "上主導"
    else if classification == -1
        englishText := "Lower drive"
        japaneseText := "下主導"
    else if classification == 2
        englishText := "Late ↑"
        japaneseText := "後半↑"
    else if classification == -2
        englishText := "Late ↓"
        japaneseText := "後半↓"
    else if classification == 3
        englishText := "Late ↕"
        japaneseText := "後半↕"
    else if classification == 4
        englishText := "Rotation"
        japaneseText := "回転"
    else if classification == 5
        englishText := "Two-sided"
        japaneseText := "両側"

    japanese ? japaneseText : englishText

f_classColor(int classification) =>
    (
         classification == 1 or classification == 2 ? upperColorInput :
         classification == -1 or classification == -2 ? lowerColorInput :
         classification == 3 or classification == 5 ? twoSidedColorInput :
         neutralColorInput
    )

f_orderText(int highTime, int lowTime, bool japanese) =>
    string result = highTime < lowTime ? "H→L" : highTime > lowTime ? "L→H" : "H=L"
    japanese ? (highTime < lowTime ? "高→安" : highTime > lowTime ? "安→高" : "高=安") : result

f_percentText(float percentile, bool japanese) =>
    (
         na(percentile)
             ? f_localText(japanese, "PCTL n/a", "順位 未算出")
             : f_localText(japanese, "PCTL " + str.tostring(percentile, "#"), "順位 " + str.tostring(percentile, "#"))
    )

f_signed(float value) =>
    na(value) ? "n/a" : (value > 0.0 ? "+" : "") + str.tostring(value, "#.00")

f_appendLine(string currentText, string nextLine) =>
    currentText == "" ? nextLine : currentText + "\n" + nextLine

f_registerBox(array<box> ids, array<int> sessionKeys, box id, int sessionKey) =>
    if not na(id)
        array.push(ids, id)
        array.push(sessionKeys, sessionKey)
    0

f_registerLine(array<line> ids, array<int> sessionKeys, line id, int sessionKey) =>
    if not na(id)
        array.push(ids, id)
        array.push(sessionKeys, sessionKey)
    0

f_registerLabel(
     array<label> ids,
     array<int> sessionKeys,
     array<int> sides,
     array<float> lanes,
     label id,
     int sessionKey,
     int side,
     float lane
) =>
    if not na(id)
        array.push(ids, id)
        array.push(sessionKeys, sessionKey)
        array.push(sides, side)
        array.push(lanes, lane)
    0

f_deleteSessionBoxes(array<box> ids, array<int> sessionKeys, int sessionKey) =>
    int index = array.size(ids) - 1
    while index >= 0
        if array.get(sessionKeys, index) == sessionKey
            box.delete(array.get(ids, index))
            array.remove(ids, index)
            array.remove(sessionKeys, index)
        index -= 1
    0

f_deleteSessionLines(array<line> ids, array<int> sessionKeys, int sessionKey) =>
    int index = array.size(ids) - 1
    while index >= 0
        if array.get(sessionKeys, index) == sessionKey
            line.delete(array.get(ids, index))
            array.remove(ids, index)
            array.remove(sessionKeys, index)
        index -= 1
    0

f_deleteSessionLabels(
     array<label> ids,
     array<int> sessionKeys,
     array<int> sides,
     array<float> lanes,
     int sessionKey
) =>
    int index = array.size(ids) - 1
    while index >= 0
        if array.get(sessionKeys, index) == sessionKey
            label.delete(array.get(ids, index))
            array.remove(ids, index)
            array.remove(sessionKeys, index)
            array.remove(sides, index)
            array.remove(lanes, index)
        index -= 1
    0

f_updateSessionBounds(
     array<int> sessionKeys,
     array<float> tops,
     array<float> bottoms,
     array<float> widths,
     int sessionKey,
     float observedHigh,
     float observedLow,
     float rangeWidth
) =>
    int sessionIndex = array.indexof(sessionKeys, sessionKey)
    if sessionIndex >= 0
        float storedTop = array.get(tops, sessionIndex)
        float storedBottom = array.get(bottoms, sessionIndex)
        array.set(tops, sessionIndex, na(storedTop) ? observedHigh : math.max(storedTop, observedHigh))
        array.set(bottoms, sessionIndex, na(storedBottom) ? observedLow : math.min(storedBottom, observedLow))
        if not na(rangeWidth)
            array.set(widths, sessionIndex, math.max(rangeWidth, syminfo.mintick))
    0

f_reflowLabels(
     array<label> ids,
     array<int> labelSessionKeys,
     array<int> sides,
     array<float> lanes,
     array<int> sessionKeys,
     array<float> tops,
     array<float> bottoms,
     array<float> widths,
     float visibleSpan
) =>
    int labelCount = array.size(ids)
    if labelCount > 0
        for labelIndex = 0 to labelCount - 1
            int sessionKey = array.get(labelSessionKeys, labelIndex)
            int sessionIndex = array.indexof(sessionKeys, sessionKey)
            if sessionIndex >= 0
                int side = array.get(sides, labelIndex)
                float lane = array.get(lanes, labelIndex)
                float sessionTop = array.get(tops, sessionIndex)
                float sessionBottom = array.get(bottoms, sessionIndex)
                float sessionWidth = array.get(widths, sessionIndex)
                float laneStep = f_annotationStep(sessionWidth, visibleSpan)
                float labelY = side > 0 ? f_upperLane(sessionTop, laneStep, lane) : f_lowerLane(sessionBottom, laneStep, lane)
                label.set_y(array.get(ids, labelIndex), labelY)
    0

//──────────────────────────────────────────────────────────────────────────────
// Effective configuration
//──────────────────────────────────────────────────────────────────────────────
bool japanese = languageInput == "日本語"

string sessionTimezone = (
     presetInput == "US Equities 09:30 New York" ? "America/New_York" :
     presetInput == "Tokyo Cash 09:00 Tokyo"      ? "Asia/Tokyo" :
     presetInput == "London Cash 08:00 London"    ? "Europe/London" :
     presetInput == "CME Equity RTH 08:30 Chicago"? "America/Chicago" :
     presetInput == "Exchange Time 09:30"         ? syminfo.timezone :
                                                    customTimezoneInput
)

int sessionHour = (
     presetInput == "Tokyo Cash 09:00 Tokyo"       ? 9 :
     presetInput == "London Cash 08:00 London"     ? 8 :
     presetInput == "CME Equity RTH 08:30 Chicago" ? 8 :
     presetInput == "Custom"                       ? customHourInput :
                                                    9
)

int sessionMinute = (
     presetInput == "CME Equity RTH 08:30 Chicago" ? 30 :
     presetInput == "Custom"                       ? customMinuteInput :
     presetInput == "Tokyo Cash 09:00 Tokyo"       ? 0 :
     presetInput == "London Cash 08:00 London"     ? 0 :
                                                    30
)

int rangeMilliseconds = rangeMinutesInput * MS_MINUTE
int projectionMinutes = math.max(projectionMinutesInput, rangeMinutesInput)
int projectionMilliseconds = projectionMinutes * MS_MINUTE

bool chartSupported = timeframe.isintraday and chart.is_standard
float chartSeconds = timeframe.in_seconds()
float requestedSeconds = timeframe.in_seconds(precisionInput)
bool selectedTimeframeUsable = chartSupported and not na(chartSeconds) and not na(requestedSeconds) and requestedSeconds <= chartSeconds
string samplingTimeframe = selectedTimeframeUsable ? precisionInput : timeframe.period
float effectiveSampleSeconds = timeframe.in_seconds(samplingTimeframe)
bool boundaryAligned = not na(effectiveSampleSeconds) and math.abs((rangeMinutesInput * 60.0) % effectiveSampleSeconds) < 0.000001
bool samplingFallback = chartSupported and not selectedTimeframeUsable and not na(chartSeconds) and chartSeconds >= 60
bool adaptiveHistory = historyRenderInput == "Visible chart (adaptive)"
bool chartFallbackUsable = chartSupported and confirmedChartFallbackInput and not na(chartSeconds) and chartSeconds <= rangeMinutesInput * 60.0

// One tuple request keeps intrabar acquisition centralized.
[ltfTime, ltfTimeClose, ltfOpen, ltfHigh, ltfLow, ltfClose, ltfVolume] = request.security_lower_tf(
     syminfo.tickerid,
     samplingTimeframe,
     [time, time_close, open, high, low, close, volume],
     ignore_invalid_timeframe = true,
     calc_bars_count = intrabarHistoryBarsInput
)

