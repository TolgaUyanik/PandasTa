)

if barstate.isfirst
    table.cell(researchPanel, 0, 0, "")
    table.cell(researchPanel, 1, 1, "")
    table.cell(researchPanel, 0, 2, "")
    table.cell(researchPanel, 0, 3, "")
    table.cell(researchPanel, 0, 4, "")
