// Indicator for TradingView showing RSI with line color based on Williams %R overbought/oversold
//@version=5
indicator("RSI with Williams %R Coloring", overlay=false)

// Input parameters
rsi_length = input.int(14, "RSI Length", minval=1)
williams_length = input.int(14, "Williams %R Length", minval=1)
overbought_level = input.float(-20, "Overbought Level", minval=-100, maxval=0)
oversold_level = input.float(-80, "Oversold Level", minval=-100, maxval=0)

// Calculate RSI
rsi = ta.rsi(close, rsi_length)

// Calculate Williams %R
highest_high = ta.highest(high, williams_length)
lowest_low = ta.lowest(low, williams_length)
williams_r = 100 * (close - highest_high) / (highest_high - lowest_low)

// Define conditions for coloring
is_overbought = williams_r >= overbought_level
is_oversold = williams_r <= oversold_level

// Determine RSI line color
rsi_color = is_overbought ? color.red : is_oversold ? color.green : color.blue

// Plot RSI with conditional coloring
plot(rsi, "RSI", color=rsi_color, linewidth=2)

// Plot 50 line for reference
hline(50, "Center Line", color=color.gray, linestyle=hline.style_dashed)