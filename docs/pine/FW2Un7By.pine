//@version=6

// @description Utility library for common trading functions
library("TradingUtils")

// @function Calculates variation of a price based on a threshold
// @param price (float) The price to be varied
// @param threshold (float) The threshold for the variation
// @returns (float) The varied price
export calcVariation(float price, float threshold) =>
    price * (1 - threshold)

// @function Sends an alert message in JSON format
// @param action (string) The action to be taken (e.g., "BUY", "SELL")
// @param symbol (string) The trading symbol (e.g., "BTCUSDT")
// @param orderType (string) The order type (e.g., "MARKET")
// @param quantity (float) The quantity of the order
// @param message (string) The message to be included in the alert
export sendAlert(string action, string symbol, string orderType, float quantity, string message) =>
    alert_message = '{ "action": "' + action + '", "symbol": "' + symbol + '", "order_type": "' + orderType + '", "quantity": ' + str.tostring(quantity) + ', "message": "' + message + '" }'
    alert(alert_message, alert.freq_once_per_bar)

// @function Sends an alert message in JSON format at the close of the bar
// @param action (string) The action to be taken (e.g., "BUY", "SELL")
// @param symbol (string) The trading symbol (e.g., "BTCUSDT")
// @param orderType (string) The order type (e.g., "MARKET")
// @param quantity (float) The quantity of the order
// @param message (string) The message to be included in the alert
export sendAlertOnClose(string action, string symbol, string orderType, float quantity, string message) =>
    alert_message = '{ "action": "' + action + '", "symbol": "' + symbol + '", "order_type": "' + orderType + '", "quantity": ' + str.tostring(quantity) + ', "message": "' + message + '", "execution": "on_close" }'
    alert(alert_message, alert.freq_once_per_bar_close)

// @function Sends a coordinated alert for high-frequency strategies
// @param action (string) The action to be taken (e.g., "BUY", "SELL")
// @param symbol (string) The trading symbol (e.g., "BTCUSDT")
// @param orderType (string) The order type (e.g., "MARKET")
// @param quantity (float) The quantity of the order
// @param strategy_id (string) Identifier for the strategy ("BUY" or "SELL")
// @param message (string) The message to be included in the alert
export sendCoordinatedAlert(string action, string symbol, string orderType, float quantity, string strategy_id, string message) =>
    alert_message = '{ "action": "' + action + '", "symbol": "' + symbol + '", "order_type": "' + orderType + '", "quantity": ' + str.tostring(quantity) + ', "strategy": "' + strategy_id + '", "message": "' + message + '", "time": "' + str.tostring(timenow) + '" }'
    alert(alert_message, alert.freq_once_per_bar_close)

// @function Updates or creates a line on the chart
// @param condition (bool) Condition to check if the line should be updated or created
// @param index (int) The current bar index
// @param price (float) The price value for the line
// @param lineColor (color) The color of the line
// @returns (line) The updated or newly created line
export updateLine(bool condition, int index, float price, color lineColor) =>
    var line newLine = na
    if condition
        if na(newLine)
            newLine := line.new(index, price, index + 1, price, width = 1, color = lineColor, style = line.style_solid)
        else
            line.set_xy1(newLine, index, price)
            line.set_xy2(newLine, index + 20, price)
            line.set_color(newLine, lineColor)
            line.set_width(newLine, 3)
            line.set_style(newLine, line.style_solid)
    else
        if not na(newLine)
            newLine := na
    newLine

// @function Executes an action once and blocks it for a specified number of bars
// @param condition (bool) Condition to check if the action should be executed
// @param blockBars (int) Number of bars to block the execution after the action is executed
// @returns (bool) True if the action is executed, false otherwise
export executeOnceAndBlock(bool condition, int blockBars) =>
    var bool lastExecution = false
    var int lastExecutionBar = 0
    canExecute = lastExecution == false or (bar_index - lastExecutionBar > blockBars)
    if condition and canExecute
        lastExecution := true
        lastExecutionBar := bar_index
        true
    else
        false