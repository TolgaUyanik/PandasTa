//@version=6
indicator("RSI Divergence Engine v3 [30-40 Bar Window]", overlay=true, max_lines_count=500, max_labels_count=500)

// --- Inputs ---
rsi_len      = input.int(14, "RSI Length", group="RSI Settings")
rsi_os       = input.int(45, "Max RSI for Bullish Div", group="RSI Settings", tooltip="RSI must be at or below this threshold at the pivot low to qualify.")
rsi_ob       = input.int(55, "Min RSI for Bearish Div", group="RSI Settings", tooltip="RSI must be at or above this threshold at the pivot high to qualify.")

pivot_left   = input.int(4, "Pivot Left Strength", group="Divergence Detection")
pivot_right  = input.int(4, "Pivot Right Strength", group="Divergence Detection")
min_lookback = input.int(10, "Min Candle Distance Between Pivots", minval=5, group="Divergence Detection")
max_lookback = input.int(40, "Max Candle Distance Between Pivots", minval=20, maxval=60, group="Divergence Detection")

// Risk Management Inputs
rrr          = input.float(1.5, "Reward-to-Risk Ratio (RRR)", step=0.1, group="Risk & Execution")
sl_buffer    = input.float(5.0, "SL Buffer Points (Nifty)", group="Risk & Execution")
line_length  = input.int(20, "Extend SL/TP Lines (Bars)", group="Visuals")

// --- Calculations ---
rsi_val = ta.rsi(close, rsi_len)
ema_200 = ta.ema(close, 200)

plot(ema_200, title="200 EMA Trend Filter", color=color.white, linewidth=2)

// Detect Pivot Highs and Lows on Price
p_low  = ta.pivotlow(low, pivot_left, pivot_right)
p_high = ta.pivothigh(high, pivot_left, pivot_right)

// Persistent State Variables
var float prev_pl_price = na
var float prev_pl_rsi   = na
var int   prev_pl_bar   = na

var float prev_ph_price = na
var float prev_ph_rsi   = na
var int   prev_ph_bar   = na

// Exact bar index where pivot occurred
int p_low_bar  = bar_index - pivot_right
int p_high_bar = bar_index - pivot_right

// Visual Line Handles
var line entry_line = na
var line sl_line    = na
var line tp_line    = na

// --- Positive (Bullish) Divergence Logic ---
if not na(p_low)
    float cur_rsi = rsi_val[pivot_right]
    
    if not na(prev_pl_price)
        int dist = p_low_bar - prev_pl_bar
        
        // Validate lookback window (10 to 40 bars) & RSI threshold
        if (dist >= min_lookback) and (dist <= max_lookback) and (cur_rsi <= rsi_os)
            // Price Lower Low AND RSI Higher Low
            if (p_low < prev_pl_price) and (cur_rsi > prev_pl_rsi)
                float sl_price = p_low - sl_buffer
                float entry_px = close
                float risk     = entry_px - sl_price
                float tp_price = entry_px + (risk * rrr)
                
                label.new(p_low_bar, p_low, "BUY (Bullish Div)", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)
                line.new(prev_pl_bar, prev_pl_price, p_low_bar, p_low, color=color.green, width=2)
                
                // Draw SL/TP Level Lines
                line.delete(entry_line), line.delete(sl_line), line.delete(tp_line)
                entry_line := line.new(bar_index, entry_px, bar_index + line_length, entry_px, color=color.blue, width=2, style=line.style_dashed)
                sl_line    := line.new(bar_index, sl_price, bar_index + line_length, sl_price, color=color.red, width=2)
                tp_line    := line.new(bar_index, tp_price, bar_index + line_length, tp_price, color=color.green, width=2)
                
                alert('{"event": "BULL_DIV", "entry": ' + str.tostring(entry_px) + ', "sl": ' + str.tostring(sl_price) + ', "tp": ' + str.tostring(tp_price) + '}', alert.freq_once_per_bar)

    // Store current pivot for next evaluation
    prev_pl_price := p_low
    prev_pl_rsi   := cur_rsi
    prev_pl_bar   := p_low_bar

// --- Negative (Bearish) Divergence Logic ---
if not na(p_high)
    float cur_rsi = rsi_val[pivot_right]
    
    if not na(prev_ph_price)
        int dist = p_high_bar - prev_ph_bar
        
        // Validate lookback window (10 to 40 bars) & RSI threshold
        if (dist >= min_lookback) and (dist <= max_lookback) and (cur_rsi >= rsi_ob)
            // Price Higher High AND RSI Lower High
            if (p_high > prev_ph_price) and (cur_rsi < prev_ph_rsi)
                float sl_price = p_high + sl_buffer
                float entry_px = close
                float risk     = sl_price - entry_px
                float tp_price = entry_px - (risk * rrr)
                
                label.new(p_high_bar, p_high, "SELL (Bearish Div)", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
                line.new(prev_ph_bar, prev_ph_price, p_high_bar, p_high, color=color.red, width=2)
                
                // Draw SL/TP Level Lines
                line.delete(entry_line), line.delete(sl_line), line.delete(tp_line)
                entry_line := line.new(bar_index, entry_px, bar_index + line_length, entry_px, color=color.blue, width=2, style=line.style_dashed)
                sl_line    := line.new(bar_index, sl_price, bar_index + line_length, sl_price, color=color.red, width=2)
                tp_line    := line.new(bar_index, tp_price, bar_index + line_length, tp_price, color=color.green, width=2)
                
                alert('{"event": "BEAR_DIV", "entry": ' + str.tostring(entry_px) + ', "sl": ' + str.tostring(sl_price) + ', "tp": ' + str.tostring(tp_price) + '}', alert.freq_once_per_bar)

    // Store current pivot for next evaluation
    prev_ph_price := p_high
    prev_ph_rsi   := cur_rsi
    prev_ph_bar   := p_high_bar