// @description Helper library for my indicators/strategies
library("OutofOptionsHelperLibrary", overlay = true)

export type liquidity
    float price
    int time = 0
    float oprice
    int otime = 0
    int sweeps = 0
    int bars_swept = 0

export enum ln
    sol = "Solid"
    dot = "Dotted"
    dsh = "Dashed"

export enum ls
    tiny    = "Tiny"
    small   = "Small"
    normal  = "Normal"

var simple int one_bar = timeframe.in_seconds()
export const string TZ = "America/New_York"
export const color na_color = color.new(color.gray,100)

// @function number of milliseconds in one bar
// @returns int
export oneBar() => one_bar * 1000

// @function is Up candle
// @param int i bar index
// @returns bool
export isUp(int i) => close[i] > open[i]

// @function is Down candle
// @param int i bar index
// @returns bool
export isDown(int i) => open[i] > close[i]

// @function format time into date/time string
// @param int t time
// @returns string
export TF(int t, bool timeOnly=false) => str.format_time(t, timeOnly ? "HH:mm:ss" : "MM-dd HH:mm:ss", TZ)

// @function format data to string
// @param float s
// @returns string
export S(float s) =>  str.format("{0,number,#.##}", s)

// @function format data to string
// @param float s
// @returns string
export S2(float s) => syminfo.mintick > 0 ? str.format("{0,number,#.##}", s) : str.format("{0,number,#.###}", s)

// @function format data to string
// @param int s
// @returns string
export S(int s) => str.tostring(s)

// @function format data to string
// @param bool s
// @returns string
export S(bool s) => str.tostring(s)

// @function Determine if candle closed above/below price
// @param float price to check
// @param bool up direction up or down
// @param strict bool if close over is required or if close at the price is good enough
// @returns bool
export barClose(float price, bool up, bool strict = false) =>
	if strict
		up ? close > price : close < price
	else
		up ? close >= price : close <= price

// @function Determine how many liquidity sweeps were made
// @returns int
export processSweep(liquidity[] L, float price, bool up, int leftB) =>
    int sweeps = 0
    int barsSwept = 0
    int oneB = oneBar()

    while (L.size() > 0)
        liquidity l = L.pop()
        if (up ? l.price < price : l.price > price)
            if (time[1] - l.time) / oneB >= leftB // only count sweep if > leftbars
                sweeps += 1
            else
                sweeps += l.sweeps
                if sweeps == 0
                    barsSwept += (time[1] - l.time) / oneB + l.bars_swept
        else
            barsSwept := leftB
            for i = barsSwept + 2 to math.min((time - l.time) / oneB, leftB * 4)
                if up ? high[i] > price : low[i] < price
                    break
                else
                    barsSwept += 1

            L.push(l)
            break

    if barsSwept == 0
        barsSwept := leftB -1

    if barsSwept >= leftB * 2
        sweeps := 1

    sweeps > 0 ? sweeps : -barsSwept

// @function Checks if time is within a restricted list of times that are delimited by new line
// @returns bool
export enforceTimeLimit(string timeLimits) =>
    bool valid = true
    for e in str.split(timeLimits, "\n")
        if str.contains(e, "#")
            continue
        if not na(time(timeframe.period, e + ":1234567", TZ))
            valid := false
            break
    valid

// @param function Find nearest swing in opposite direction
// @returns liquidity
export nearestSwing(int startTime, bool bullish, float max_tp_price, float min_price = 0) =>
    liquidity swing = na

    int start = (time - startTime) / oneBar() + 1
    for i = start to start + 50
        if bullish
            if high[i] > max_tp_price
                break
            if high[i] >= high[i - 1] and high[i] >= high[i + 1] and high[i] > close
                swing := liquidity.new(high[i], time[i])
                if high[i] > min_price
                    break
        else
            if low[i] < max_tp_price
                break
            if low[i] <= low[i - 1] and low[i] <= low[i + 1] and close > low[i]
                swing := liquidity.new(low[i], time[i])
                if min_price == 0 or low[i] < min_price
                    break

    swing

// @param function Determine if currently inside the specified session range
// @returns bool
export inSession(string session_range) => not(na(time(timeframe.period, session_range, TZ)))

// @param function Calculate average between 2 values rounded to tick size
// @returns float
export avg(float a, float b) => math.round_to_mintick(math.avg(a, b))

// @returns string
export lineStyleTextToVal(string val) =>
    s = val == "Solid" ? line.style_solid : val == "Dotted" ? line.style_dotted : line.style_dashed

// @returns string
export lineStyle(ln s) => 
    s == ln.sol ? line.style_solid : (s == ln.dot ? line.style_dotted : line.style_dashed)

// @returns string
export getDuration(int s, int e) =>
    int diff = (e - s) / 1000
    string out = ''

    int hours = math.floor(diff / 3600)
    int minutes = math.floor((diff % 3600) / 60)
    int seconds = math.floor(diff % 60)
    if hours > 0
        out += S(hours) + "h "
    if minutes > 0
        out += S(minutes) + "m "
    if seconds > 0
        out += S(seconds) + "s"

    str.trim(out)

// @returns string
export formatTimeframe() =>
    if timeframe.isseconds
        S(timeframe.multiplier) + " sec(s)"
    else if timeframe.isminutes
        if timeframe.multiplier > 60
            S(timeframe.multiplier / 60) + " hours(s)"
        else
            S(timeframe.multiplier) + " min(s)"
    else if timeframe.isdaily
        S(timeframe.multiplier) + " days(s)"
    else if timeframe.isweekly
        S(timeframe.multiplier) + " week(s)"

// @returns float[]
export devToArray(string dev) =>
    float[] out = array.new<float>()
    for e in str.split(dev, ",")
        float d = str.tonumber(e)
        if not na(d)
            out.push(d)
    out

// @returns float
export getDev(float d, bool bull, float h, float l) =>
    float dev = math.round_to_mintick(d * (h - l))
    bull ? h - dev : l + dev
