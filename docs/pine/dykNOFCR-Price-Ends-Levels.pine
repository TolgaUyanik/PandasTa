//@version=6
indicator(
     "Price Ends Levels",
     overlay = true,
     max_labels_count = 500,
     max_lines_count = 500,
     max_boxes_count = 500)

//=====================================================================
// INPUTS
//=====================================================================

buySuffix = input.int(
     26,
     "Buy level ending",
     minval = 0,
     maxval = 99)

sellSuffix = input.int(
     50,
     "Sell level ending",
     minval = 0,
     maxval = 99)

dedupePerLevel = input.bool(
     true,
     "Only signal once per level")

showSignals = input.bool(
     true,
     "Show buy / sell markers",
     group = "Visuals")

showLevelLines = input.bool(
     true,
     "Show horizontal level lines",
     group = "Visuals")

showGradientBoxes = input.bool(
     true,
     "Show green-to-red boxes",
     group = "Visuals")

levelsAboveBelow = input.int(
     4,
     "Boxes above / below current price",
     minval = 1,
     maxval = 12,
     group = "Visuals")

boxLookbackBars = input.int(
     80,
     "Box lookback bars",
     minval = 10,
     maxval = 400,
     group = "Visuals")

boxForwardBars = input.int(
     80,
     "Box forward bars",
     minval = 10,
     maxval = 400,
     group = "Visuals")

gradientSteps = input.int(
     8,
     "Gradient smoothness",
     minval = 2,
     maxval = 20,
     group = "Visuals")

boxTransparency = input.int(
     88,
     "Box transparency",
     minval = 60,
     maxval = 98,
     group = "Visuals")

maxSavedZones = input.int(
     45,
     "Max saved boxes",
     minval = 5,
     maxval = 60,
     group = "Visuals")

//=====================================================================
// CONSTANTS
//=====================================================================

float levelStep = 100.0

color buyColor = color.rgb(0, 220, 130)
color sellColor = color.rgb(255, 75, 90)

int effectiveMaxSavedZones = math.max(
     1,
     math.min(
         maxSavedZones,
         int(math.floor(480.0 / gradientSteps))))

//=====================================================================
// HELPER FUNCTIONS
//=====================================================================

levelForPrice(float price, int suffix) =>
    float base = math.floor(math.floor(price) / levelStep) * levelStep
    base + suffix

levelInBar(int suffix) =>
    float base = math.floor(low / levelStep) * levelStep
    float candidate = base + suffix

    if candidate < low
        candidate += levelStep

    candidate

touchesExactLevel(float level) =>
    level >= low and level <= high

findZone(array<float> bases, float base) =>
    int result = -1

    if array.size(bases) > 0
        for i = 0 to array.size(bases) - 1
            if array.get(bases, i) == base
                result := i
                break

    result

drawGradientZone(
     array<box> boxes,
     int leftBar,
     int rightBar,
     float buyLevel,
     float sellLevel) =>

    float zoneTop = math.max(buyLevel, sellLevel)
    float zoneBottom = math.min(buyLevel, sellLevel)
    float stepSize = (zoneTop - zoneBottom) / gradientSteps

    for step = 0 to gradientSteps - 1
        float bottom = zoneBottom + stepSize * step
        float top = bottom + stepSize

        color bandColor = color.new(
             color.from_gradient(
                 step,
                 0,
                 gradientSteps - 1,
                 buyColor,
                 sellColor),
             boxTransparency)

        box band = box.new(
             left = leftBar,
             top = top,
             right = rightBar,
             bottom = bottom,
             bgcolor = bandColor,
             border_color = color.new(bandColor, 100))

        array.push(boxes, band)

drawLevelLine(
     array<line> lines,
     int leftBar,
     int rightBar,
     float level,
     color lineColor) =>

    line id = line.new(
         x1 = leftBar,
         y1 = level,
         x2 = rightBar,
         y2 = level,
         color = color.new(lineColor, 15),
         width = 2)

    array.push(lines, id)

extendGradientZone(
     array<box> boxes,
     int zoneIndex,
     int rightBar) =>

    int startIndex = zoneIndex * gradientSteps

    for step = 0 to gradientSteps - 1
        int boxIndex = startIndex + step

        if boxIndex < array.size(boxes)
            box.set_right(
                 array.get(boxes, boxIndex),
                 rightBar)

extendLevelLines(
     array<line> lines,
     int zoneIndex,
     int rightBar) =>

    int startIndex = zoneIndex * 2

    for step = 0 to 1
        int lineIndex = startIndex + step

        if lineIndex < array.size(lines)
            line.set_x2(
                 array.get(lines, lineIndex),
                 rightBar)

trimOldZones(
     array<float> bases,
     array<box> boxes,
     array<line> lines) =>

    while array.size(bases) > effectiveMaxSavedZones
        array.shift(bases)

        for i = 0 to gradientSteps - 1
            if array.size(boxes) > 0
                box.delete(array.shift(boxes))

        for i = 0 to 1
            if array.size(lines) > 0
                line.delete(array.shift(lines))

//=====================================================================
// EXACT LEVEL TOUCH LOGIC
//=====================================================================

float buyTouchedLevel = levelInBar(buySuffix)
float sellTouchedLevel = levelInBar(sellSuffix)

bool buySignalRaw = touchesExactLevel(buyTouchedLevel)
bool sellSignalRaw = touchesExactLevel(sellTouchedLevel)

var float lastBuyLevel = na
var float lastSellLevel = na

bool buySignal =
     buySignalRaw and
     (
         not dedupePerLevel or
         na(lastBuyLevel) or
         buyTouchedLevel != lastBuyLevel
     )

bool sellSignal =
     sellSignalRaw and
     (
         not dedupePerLevel or
         na(lastSellLevel) or
         sellTouchedLevel != lastSellLevel
     )

if buySignal
    lastBuyLevel := buyTouchedLevel

if sellSignal
    lastSellLevel := sellTouchedLevel

//=====================================================================
// PERSISTENT VISUAL ZONES
//=====================================================================

var array<float> zoneBases = array.new_float()
var array<box> zoneBoxes = array.new_box()
var array<line> levelLines = array.new_line()

int leftBar = math.max(
     0,
     bar_index - boxLookbackBars)

int rightBar = bar_index + boxForwardBars

float currentBase =
     math.floor(math.floor(close) / levelStep) * levelStep

for offset = -levelsAboveBelow to levelsAboveBelow
    float base = currentBase + offset * levelStep
    float buyGuide = base + buySuffix
    float sellGuide = base + sellSuffix

    int zoneIndex = findZone(zoneBases, base)

    if zoneIndex == -1
        array.push(zoneBases, base)

        if showGradientBoxes
            drawGradientZone(
                 zoneBoxes,
                 leftBar,
                 rightBar,
                 buyGuide,
                 sellGuide)

        if showLevelLines
            drawLevelLine(
                 levelLines,
                 leftBar,
                 rightBar,
                 buyGuide,
                 buyColor)

            drawLevelLine(
                 levelLines,
                 leftBar,
                 rightBar,
                 sellGuide,
                 sellColor)

    else
        if showGradientBoxes
            extendGradientZone(
                 zoneBoxes,
                 zoneIndex,
                 rightBar)

        if showLevelLines
            extendLevelLines(
                 levelLines,
                 zoneIndex,
                 rightBar)

trimOldZones(
     zoneBases,
     zoneBoxes,
     levelLines)

//=====================================================================
// SIGNAL MARKERS
//=====================================================================

plotshape(
     showSignals and buySignal,
     title = "Buy xx26.00",
     style = shape.triangleup,
     location = location.belowbar,
     color = buyColor,
     text = "BUY 26",
     textcolor = color.white,
     size = size.small)

plotshape(
     showSignals and sellSignal,
     title = "Sell xx50.00",
     style = shape.triangledown,
     location = location.abovebar,
     color = sellColor,
     text = "SELL 50",
     textcolor = color.white,
     size = size.small)

//=====================================================================
// ALERTS
//=====================================================================

alertcondition(
     buySignal,
     title = "Buy exact xx26.00",
     message = "BUY: price touched the exact xx26.00 level.")

alertcondition(
     sellSignal,
     title = "Sell exact xx50.00",
     message = "SELL: price touched the exact xx50.00 level.")