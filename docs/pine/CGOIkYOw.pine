//@version=6
library("MaidongLiquidityLibrary", overlay = true)

export LLF(int staticPivotPeriod, int dynamicPivotPeriod, float staticRangeSensitivity, float dynamicRangeSensitivity, bool showStaticHighLiquidity, bool showStaticLowLiquidity, bool showDynamicHighLiquidity, bool showDynamicLowLiquidity) =>
    float atrValue = ta.atr(55)

    float staticHighPivot = ta.pivothigh(staticPivotPeriod, staticPivotPeriod)
    float staticLowPivot = ta.pivotlow(staticPivotPeriod, staticPivotPeriod)
    bool staticHighFound = not na(staticHighPivot)
    bool staticLowFound = not na(staticLowPivot)
    float staticHighCurrent = ta.valuewhen(staticHighFound, high[staticPivotPeriod], 0)
    float staticLowCurrent = ta.valuewhen(staticLowFound, low[staticPivotPeriod], 0)
    int staticHighCurrentIndex = ta.valuewhen(staticHighFound, bar_index[staticPivotPeriod], 0)
    int staticLowCurrentIndex = ta.valuewhen(staticLowFound, bar_index[staticPivotPeriod], 0)
    float staticHighPrevious = ta.valuewhen(staticHighFound, high[staticPivotPeriod], 1)
    float staticLowPrevious = ta.valuewhen(staticLowFound, low[staticPivotPeriod], 1)
    int staticHighPreviousIndex = ta.valuewhen(staticHighFound, bar_index[staticPivotPeriod], 1)
    int staticLowPreviousIndex = ta.valuewhen(staticLowFound, bar_index[staticPivotPeriod], 1)

    float dynamicHighPivot = ta.pivothigh(dynamicPivotPeriod, dynamicPivotPeriod)
    float dynamicLowPivot = ta.pivotlow(dynamicPivotPeriod, dynamicPivotPeriod)
    bool dynamicHighFound = not na(dynamicHighPivot)
    bool dynamicLowFound = not na(dynamicLowPivot)
    float dynamicHighCurrent = ta.valuewhen(dynamicHighFound, high[dynamicPivotPeriod], 0)
    float dynamicLowCurrent = ta.valuewhen(dynamicLowFound, low[dynamicPivotPeriod], 0)
    int dynamicHighCurrentIndex = ta.valuewhen(dynamicHighFound, bar_index[dynamicPivotPeriod], 0)
    int dynamicLowCurrentIndex = ta.valuewhen(dynamicLowFound, bar_index[dynamicPivotPeriod], 0)
    float dynamicHighPrevious = ta.valuewhen(dynamicHighFound, high[dynamicPivotPeriod], 1)
    float dynamicLowPrevious = ta.valuewhen(dynamicLowFound, low[dynamicPivotPeriod], 1)
    int dynamicHighPreviousIndex = ta.valuewhen(dynamicHighFound, bar_index[dynamicPivotPeriod], 1)
    int dynamicLowPreviousIndex = ta.valuewhen(dynamicLowFound, bar_index[dynamicPivotPeriod], 1)

    var line staticHighLine = na
    var line staticLowLine = na
    var label staticHighLabel = na
    var label staticLowLabel = na
    var line dynamicHighLine = na
    var line dynamicLowLine = na
    var label dynamicHighLabel = na
    var label dynamicLowLabel = na

    if staticHighCurrentIndex != staticHighCurrentIndex[1] and staticHighCurrent <= staticHighPrevious and (staticHighCurrentIndex - staticHighPreviousIndex) >= 8 and showStaticHighLiquidity
        if math.abs((staticHighPrevious - staticHighCurrent) / atrValue[staticPivotPeriod]) <= staticRangeSensitivity
            staticHighLine := line.new(staticHighPreviousIndex, staticHighPrevious, staticHighCurrentIndex, staticHighPrevious, color = color.rgb(18, 123, 184, 43), style = line.style_dotted)
            staticHighLabel := label.new(math.round((staticHighPreviousIndex + staticHighCurrentIndex) / 2), staticHighPrevious - (atrValue / 2), "2 Top Liq", color = color.rgb(255, 255, 255, 100), textcolor = color.rgb(18, 123, 184), style = label.style_label_down, size = size.small)

    if staticLowCurrentIndex != staticLowCurrentIndex[1] and staticLowCurrent >= staticLowPrevious and (staticLowCurrentIndex - staticLowPreviousIndex) >= 8 and showStaticLowLiquidity
        if math.abs((staticLowPrevious - staticLowCurrent) / atrValue[staticPivotPeriod]) <= staticRangeSensitivity
            staticLowLine := line.new(staticLowPreviousIndex, staticLowPrevious, staticLowCurrentIndex, staticLowPrevious, color = color.rgb(162, 10, 233, 45), style = line.style_dotted)
            staticLowLabel := label.new(math.round((staticLowPreviousIndex + staticLowCurrentIndex) / 2), staticLowPrevious + (atrValue / 2), "2 Bottom Liq", color = color.rgb(255, 255, 255, 100), textcolor = color.rgb(162, 10, 233), style = label.style_label_up, size = size.small)

    if dynamicHighCurrentIndex != dynamicHighCurrentIndex[1] and dynamicHighCurrent <= dynamicHighPrevious and (dynamicHighCurrentIndex - dynamicHighPreviousIndex) >= 4 and showDynamicHighLiquidity
        if math.abs((dynamicHighPrevious - dynamicHighCurrent) / atrValue[dynamicPivotPeriod]) >= dynamicRangeSensitivity and math.abs((dynamicHighPrevious - dynamicHighCurrent) / atrValue[dynamicPivotPeriod]) <= 1.95
            dynamicHighLine := line.new(dynamicHighPreviousIndex, dynamicHighPrevious, dynamicHighCurrentIndex, dynamicHighCurrent, color = color.rgb(18, 123, 184, 44), style = line.style_dotted)
            dynamicHighLabel := label.new(math.round((dynamicHighPreviousIndex + dynamicHighCurrentIndex) / 2) + 2, (dynamicHighPrevious + dynamicHighCurrent) / 2 - (atrValue / 4), "DLiq", color = color.rgb(255, 255, 255, 100), textcolor = color.rgb(18, 123, 184), style = label.style_label_down, size = size.small)

    if dynamicLowCurrentIndex != dynamicLowCurrentIndex[1] and dynamicLowCurrent >= dynamicLowPrevious and (dynamicLowCurrentIndex - dynamicLowPreviousIndex) >= 4 and showDynamicLowLiquidity
        if math.abs((dynamicLowPrevious - dynamicLowCurrent) / atrValue[dynamicPivotPeriod]) >= dynamicRangeSensitivity and math.abs((dynamicLowPrevious - dynamicLowCurrent) / atrValue[dynamicPivotPeriod]) <= 1.95
            dynamicLowLine := line.new(dynamicLowPreviousIndex, dynamicLowPrevious, dynamicLowCurrentIndex, dynamicLowCurrent, color = color.rgb(162, 10, 233, 45), style = line.style_dotted)
            dynamicLowLabel := label.new(math.round((dynamicLowPreviousIndex + dynamicLowCurrentIndex) / 2) + 2, (dynamicLowPrevious + dynamicLowCurrent) / 2 + (atrValue / 4), "DLiq", color = color.rgb(255, 255, 255, 100), textcolor = color.rgb(162, 10, 233), style = label.style_label_up, size = size.small)

    if not na(staticHighLine) and not na(staticHighLine[1]) and math.abs(line.get_x2(staticHighLine[1]) - line.get_x1(staticHighLine)) <= 2
        line.delete(staticHighLine)
        if not na(staticHighLabel[1])
            label.delete(staticHighLabel[1])
        line.set_x2(staticHighLine[1], staticHighCurrentIndex)
        if not na(staticHighLabel)
            label.set_text(staticHighLabel, "3 Top Liq")
            label.set_x(staticHighLabel, math.abs((line.get_x1(staticHighLine[1]) + line.get_x2(staticHighLine[1])) / 2))

    if not na(staticLowLine) and not na(staticLowLine[1]) and math.abs(line.get_x2(staticLowLine[1]) - line.get_x1(staticLowLine)) <= 2
        line.delete(staticLowLine)
        if not na(staticLowLabel[1])
            label.delete(staticLowLabel[1])
        line.set_x2(staticLowLine[1], staticLowCurrentIndex)
        if not na(staticLowLabel)
            label.set_text(staticLowLabel, "3 Top Liq")
            label.set_x(staticLowLabel, math.abs((line.get_x1(staticLowLine[1]) + line.get_x2(staticLowLine[1])) / 2))

    if not na(dynamicHighLine) and not na(dynamicHighLine[1]) and math.abs(line.get_x2(dynamicHighLine[1]) - line.get_x1(dynamicHighLine)) <= dynamicPivotPeriod * 2 + 1
        line.delete(dynamicHighLine)
        if not na(dynamicHighLabel[1])
            label.delete(dynamicHighLabel[1])
        line.set_xy2(dynamicHighLine[1], dynamicHighCurrentIndex, dynamicHighCurrent)
        if not na(dynamicHighLabel)
            label.set_xy(dynamicHighLabel, math.abs(((line.get_x1(dynamicHighLine[1]) + line.get_x2(dynamicHighLine[1])) / 2) + 2), (line.get_y1(dynamicHighLine[1]) + line.get_y2(dynamicHighLine[1])) / 2)

    if not na(dynamicLowLine) and not na(dynamicLowLine[1]) and math.abs(line.get_x2(dynamicLowLine[1]) - line.get_x1(dynamicLowLine)) <= dynamicPivotPeriod * 2 + 1
        line.delete(dynamicLowLine)
        if not na(dynamicLowLabel[1])
            label.delete(dynamicLowLabel[1])
        line.set_xy2(dynamicLowLine[1], dynamicLowCurrentIndex, dynamicLowCurrent)
        if not na(dynamicLowLabel)
            label.set_xy(dynamicLowLabel, math.abs(((line.get_x1(dynamicLowLine[1]) + line.get_x2(dynamicLowLine[1])) / 2) + 2), (line.get_y1(dynamicLowLine[1]) + line.get_y2(dynamicLowLine[1])) / 2)
