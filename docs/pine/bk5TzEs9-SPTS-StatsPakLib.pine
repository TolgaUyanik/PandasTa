// Test of Normality //////////////////////////////////////////////////////////////////////////////////////////////////////////////// 

close_array = array.new_float() 
for i = 0 to 50
    array.push(close_array, close[i])

[skew, kurt, dist, implication] = test_of_normality(close_array, close)

var label normality_lbl = na 
var label kurt_lbl = na 
if barstate.islast 
    label.delete(normality_lbl) 
    label.delete(kurt_lbl)
    normality_lbl := label.new(bar_index + 10, y = high, text = str.tostring(dist), color = color.white, textcolor = color.black)
    kurt_lbl := label.new(bar_index, y = low, text = "Kurtosis = " + str.tostring(math.round(kurt,2)) + "\n Skewness = " + str.tostring(math.round(skew,2)), color = color.white, textcolor = color.black, style = label.style_label_up)
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


// Regression //////////////////////////////////////////////////////////////////////////////////////////////////////////////////// 
[result, pear_cor, rsqrd, std_err, slope, intercept] = f_linear_regression(close, close[1], 150)

plot(result) 

var table reg = table.new(position.top_center, 2, 2, bgcolor = color.white) 
table.cell(reg, 1, 1, text = "y = " + str.tostring(math.round(result,4)) + "x + " + str.tostring(math.round(intercept,2)), bgcolor = color.white, text_color = color.black)

// Forecast //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

btc_prediction = array.new_float() 
btc_ucl = array.new_float()
btc_lcl = array.new_float() 

[thing, thing1, thing2] = f_forecast(close, close[1], 150, 10, btc_prediction, btc_ucl, btc_lcl)

var table btc_table = table.new(position.middle_right, 4, 20, bgcolor = color.black) 
table.cell(btc_table, 1, 1, text = "Forecast", bgcolor = color.black, text_color = color.white) 
table.cell(btc_table, 2, 1, text = "UCL", bgcolor = color.black, text_color = color.white)
table.cell(btc_table, 3, 1, text = "LCL", bgcolor = color.black, text_color = color.white)
for i = 0 to array.size(btc_prediction) - 1
    table.cell(btc_table, 1, 2 + i, text = str.tostring(array.get(btc_prediction, i)), bgcolor = color.black, text_color = color.white) 
    table.cell(btc_table, 2, 2 + i, text = str.tostring(array.get(btc_ucl, i)), bgcolor = color.black, text_color = color.white) 
    table.cell(btc_table, 3, 2 + i, text = str.tostring(array.get(btc_lcl, i)), bgcolor = color.black, text_color = color.white) 

