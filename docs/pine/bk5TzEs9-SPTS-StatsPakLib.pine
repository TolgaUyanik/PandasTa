// @function TODO: Calculates the r2 of two arrays 
// @param x TODO: parameters are the 2 arrays you wish to calculate the rsqrd for, make sure they are equal size! 
// @returns TODO: returns the R2 value
export f_r2_array(float[] array1, float[] array2) => 
    array1_stdev = array.stdev(array1) 
    array2_stdev = array.stdev(array2) 
    cov = array.covariance(array1, array2) 
    pp_cor = cov / (array1_stdev * array2_stdev) 
    res = math.pow(pp_cor, 2)

// @function TODO: Calculates the r2 of two float variables 
