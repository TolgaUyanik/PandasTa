// @function TODO: Calculates the confidence interval between two arrays 
// @param x TODO: parameters are the 2 arrays you wish to calculate, as well as the desired confidence level (generally 1.96)  
// @returns TODO: returns the upper_bound and lower_bound cofidence interval as float values 
export f_confidence_interval(float[] array1, float[] array2, float ci_input) =>
    upper_bound = 0.0 
    lower_bound = 0.0 
    // Standard Error 
    avg1 = array.avg(array1)
    avg2 = array.avg(array2) 
    asd1 = array.stdev(array1) 
    asd2 = array.stdev(array2) 
    se1 = (math.pow(asd1,2) / array.size(array1))
    se2 = (math.pow(asd2,2) / array.size(array2))
    se3 = (se1 + se2) 
    s_er = math.sqrt(se3) 
    // Confidence interval 
    avg_dif = (avg1 - avg2)
    ci = s_er * ci_input 
    upper_bound := avg_dif + ci 
    lower_bound := avg_dif - ci 
    [upper_bound, lower_bound]


