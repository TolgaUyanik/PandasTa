// @function TODO: This performs a quadratic (curvlinear) pearson correlation between two values.   
// @param x TODO: Input your two sources and the length of assessment. 
// @returns TODO: The function will return the pearson correlation (quadratic based). 
export quadratic_correlation(float src1, float src2, int len) => 
    x = array.new_float() 
    y = array.new_float() 
    a3 = array.new_float() 
    a4 = array.new_float() 
    for i = 0 to len 
        array.push(x, src2[i] * math.pow(src2[i], 2)) 
        array.push(y, src1[i])
    x_sd = array.stdev(x) 
    y_sd = array.stdev(y) 
    xy_cov = array.covariance(x, y)
    q_cor = xy_cov / (x_sd * y_sd) 
    // End of function 

