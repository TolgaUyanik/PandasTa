// @function TODO: Calculates the z-score 
// @param x TODO: input the variable of interest and the length of assessment 
// @returns TODO: returns float z-score 

export f_zscore(float variable, int length) =>
	z = (variable - ta.sma(variable, length)) / ta.stdev(variable, length) 
	
