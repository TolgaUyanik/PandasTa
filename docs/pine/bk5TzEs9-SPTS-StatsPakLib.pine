// Paired Sample t-test 
// This will output the t_statistic (T-Statistic) and the dfs (Degress of Freedom), similar to the one tailed test. 
// @function TODO: Performs a paired sample t-test 
// @param x TODO: parameter input include the two sources for comparison of the t-test and the length of the t-test
// @returns TODO: Returns the t-statistic and degrees of freedom of a paired sample t-test
export paired_sample_t(float src1, float src2, int len) => 
    t_static = 0.0 
    dfs = 0.0 
    dif = array.new_float() 
    for i = 0 to len
        array.push(dif, src1[i] - src2[i]) 
    avg_dif = array.avg(dif) 
    stdev_dif = array.stdev(dif) 
    t1 = stdev_dif / math.sqrt(array.size(dif))
    t_static := avg_dif / t1 
    dfs := array.size(dif) - 1 
    [t_static, dfs]
    // End of function 

