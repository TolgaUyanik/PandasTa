// @function TODO: This performs a simple forecast function on a single dependent variable. It will autoregress this based on the train time, to the desired length of output,
// then it will push the forecasted values to 3 float arrays, one that contains the forecasted result, 1 that contains the Upper Confidence Result and one with the lower confidence
// result.  
// @param x TODO: The output variable (desired forecasted variable), the input variable (the variable to forecast from), len is the length of learning for the model, forecast_length
// is the desired length into the future you want to forecast, then the array inputs for the forecast result, ucl and lcl.  
// @returns TODO: Will return 3 arrays, one with the forecasted results, one with the upper confidence results, and a final with the lower confidence results. Example is given below. 
export f_forecast(float output, float input, int train_len, int forecast_length, float[] output_array, float[] upper_array, float[] lower_array) =>
    result = 0.0 
    std_err = 0.0 
    slope = 0.0 
    intercept = 0.0 

	y_array = array.new_float() 
	y_sq_array = array.new_float() 
	x_array = array.new_float() 
	x_sq_array = array.new_float() 
	xy_array = array.new_float() 

	// Loop functions
	for i = 0 to train_len
		array.push(y_array, output[i])
		array.push(y_sq_array, output[i] * output[i]) 
		array.push(x_array, input[i])
		array.push(x_sq_array, input[i] * input[i]) 
		array.push(xy_array, input[i] * output[i])
	
	// Regression Calculations 
	y = array.sum(y_array)
	y2 = array.sum(y_sq_array) 
	x = array.sum(x_array) 
	x2 = array.sum(x_sq_array)
	xy = array.sum(xy_array) 

	b1 = xy - (x * y) / train_len 
	bbb2 = x2 - (math.pow(x, 2) / train_len) 
	slope := (b1 / bbb2) 

	abc = y - (slope * x) 
	intercept := abc / train_len 

	result := (input * slope) + intercept
    // Standard Error
    se_residuals = array.new_float() 
    for i = 0 to train_len 
        array.push(se_residuals, (result[i] - output[i]) * (result[i] - output[i]))
    se_add = array.sum(se_residuals) 
    r1 = se_add / (train_len - 2) 
	std_err := math.sqrt(r1) 
    float prediction = result 
    float ucl = result + std_err 
    float lcl = result - std_err 
    for i = 0 to forecast_length 
        array.push(output_array, result[i])
        array.push(upper_array, ucl[i])
        array.push(lower_array, lcl[i])
        prediction := prediction * slope + intercept 
        ucl := prediction + std_err 
        lcl := prediction - std_err 
    [output_array, upper_array, lower_array]



// Dickey Fuller Test  
//@function: Performs a basic Dickey Fuller Test 
// @param  TODO: change_x: Change value (delta x) calculated from the second variable subtracted from the first variable, lagged_x is the immediate previous variable 
// @returns: returns t-statistic as float and significance and bool (true or false) 

export f_dickey_fuller_test(float change_x, float lagged_x, int len) =>
    result = 0.0 
    rsqrd = 0.0 
    pear_cor = 0.0 
    std_err = 0.0 
    slope = 0.0 
    intercept = 0.0 
    float t_statistic = 0.0 
    bool pass = na 

	y_array = array.new_float() 
	y_sq_array = array.new_float() 
	x_array = array.new_float() 
	x_sq_array = array.new_float() 
	xy_array = array.new_float() 

	// Loop functions
	for i = 0 to len
		array.push(y_array, change_x[i])
		array.push(y_sq_array, change_x[i] * change_x[i]) 
		array.push(x_array, lagged_x[i])
		array.push(x_sq_array, lagged_x[i] * lagged_x[i]) 
		array.push(xy_array, change_x[i] * lagged_x[i])
	
	// Regression Calculations 
	y = array.sum(y_array)
	y2 = array.sum(y_sq_array) 
	x = array.sum(x_array) 
	x2 = array.sum(x_sq_array)
	xy = array.sum(xy_array) 

	b1 = xy - (x * y) / len 
	bbb2 = x2 - (math.pow(x, 2) / len) 
	slope := (b1 / bbb2) 

	abc = y - (slope * x) 
	intercept := abc / len 

	result := (lagged_x * slope)
     // Correlation 
    stdev1 = array.stdev(x_array)
    stdev2 = array.stdev(y_array)
    xy_cov = array.covariance(y_array, x_array)
    pear_cor := xy_cov / (stdev1 * stdev2) 
    // R2 
    rsqrd := math.pow(pear_cor,2)
    // Standard Error
    se_residuals = array.new_float() 
    for i = 0 to len 
        array.push(se_residuals, (result[i] - lagged_x[i]) * (result[i] - lagged_x[i]))
    se_add = array.sum(se_residuals) 
    r1 = se_add / (len - 2) 
	std_err := math.sqrt(r1) 
    t_statistic := (slope / rsqrd)
    // Significance 
    if t_statistic <= -1.62 
        pass := true 
    else if t_statistic > -1.62 
        pass := false 
    [t_statistic, pass]

//anova 
// @function  performs a 3 way ANOVA analysis of 3 independent variables. Returns the F Statistic and the significance (P value) 
// @param x 3 independent groups and the length of ANOVA assessment  
// @returns F Statistic and P value 
export ANOVA(float group1, float group2, float group3, int len) => 
    float sig = 0.0 
    g1_ar = array.new<float>() 
    g2_ar = array.new<float>() 
    g3_ar = array.new<float>() 
    for i = 0 to len 
        array.push(g1_ar, group1[i])
        array.push(g2_ar, group2[i]) 
        array.push(g3_ar, group3[i]) 
    //
    g1_avg = array.avg(g1_ar) 
    g2_avg = array.avg(g2_ar) 
    g3_avg = array.avg(g3_ar) 
    total_avg = math.avg(g1_avg, g2_avg, g3_avg) 
    // Sum of Squares 
    sos_g1 = array.new<float>() 
    sos_g2 = array.new<float>() 
    sos_g3 = array.new<float>() 
    for i = 0 to len 
        array.push(sos_g1, (group1[i] - g1_avg) * (group1[i] - g1_avg)) 
        array.push(sos_g2, (group2[i] - g2_avg) * (group2[i] - g2_avg))
        array.push(sos_g3, (group3[i] - g3_avg) * (group3[i] - g3_avg))
    g1_sum = array.sum(sos_g1) 
    g2_sum = array.sum(sos_g2) 
    g3_sum = array.sum(sos_g3) 
    total_sum = (array.size(g1_ar) - 1 + array.size(g2_ar) - 1 + array.size(g3_ar) - 1)
    sum_of_squares = (g1_sum + g2_sum + g3_sum) 
    mss = (sum_of_squares) / (total_sum - 3) 
    //
    m1 = (array.size(g1_ar) - 1) * math.pow((g1_avg - total_avg),2)
    m2 = (array.size(g2_ar) - 1) * math.pow((g2_avg - total_avg),2)
    m3 = (array.size(g3_ar) - 1) * math.pow((g3_avg - total_avg),2)
    // sum
    m_sum = (m1 + m2 + m3) / 2 
    f_stat = (m_sum / mss)  
    df_b = 2 
    df_w = total_sum - 3 
    if f_stat >= 4.61 
        sig := 0.01 
    else if f_stat >= 3.00 
        sig := 0.05 
    else if f_stat >= 2.30 
        sig := 0.10 
    else
        sig := 1 


    [sig, f_stat]  
    

