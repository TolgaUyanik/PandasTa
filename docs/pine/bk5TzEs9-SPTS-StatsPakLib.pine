// @function TODO: This performs a pearson correlation assessment of two arrays. They need to be of equal size!  
// @param x TODO: Input your two arrays ensuring they are of equal size.  
// @returns TODO: The function will return the pearson correlation. 
export cor_of_array(float[] array1, float[] array2) => 
    array1_stdev = array.stdev(array1) 
    array2_stdev = array.stdev(array2) 
    cov = array.covariance(array1, array2) 
    p_cor = cov / (array1_stdev * array2_stdev) 
    // end of function 

