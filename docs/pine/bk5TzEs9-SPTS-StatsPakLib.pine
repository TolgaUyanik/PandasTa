// @function TODO: Calculates the effect size between two arrays of equal scale. 
// @param x TODO: parameters are the 2 arrays you wish to calculate the effect size for. It will use the entire size of each array, so its important to ensure they are of equal size. 
// @returns TODO: returns the effect size (float) 
export f_effect_size(float[] array1, float[] array2) => 
    float a1_sd = 0.0 
    float a2_sd = 0.0 
    int a1_size = 0 
    int a2_size = 0 
    float ps = 0.0 
    float avg1 = 0.0 
    float avg2 = 0.0 
    a1_sd := array.stdev(array1) 
    a2_sd := array.stdev(array2) 
    // Pooled standard deviation 
    a1_size := array.size(array1) 
    a2_size := array.size(array2) 
    sp1 = ((a1_size - 1) * (math.pow(a1_sd,2))) + ((a2_size - 1) * (math.pow(a2_sd,2)))
    sp2 = (a1_size + a2_size) - 2 
    sp3 = (sp1 / sp2) 
    ps := math.sqrt(sp3) 

    avg1 := array.avg(array1)
    avg2 := array.avg(array2) 

    es = (avg1 - avg2) / ps 

