//@version=6
indicator("Daily Volume + MA + Labels - Shubhashish Dixit", shorttitle="Vol Bars by Shubh", overlay=false)

// Inputs
length      = input.int(20, "Volume MA Length", minval=1)
showMA      = input.bool(true, "Show Volume MA")
colorByPrice= input.bool(true, "Color Bars by Price Change")
showLabels  = input.bool(true, "Show Volume Labels")

// Color logic
isUp     = close >= close[1]
volColor = colorByPrice ? (isUp ? color.green : color.rgb(202, 42, 42)) : color.gray

// Daily volume
dailyVol = request.security(syminfo.tickerid, "D", volume)
dailyVolMA = ta.sma(dailyVol, length)

// Plot bars
plot(dailyVol, title="Daily Volume", style=plot.style_columns, color=volColor)

// Plot MA
plot(showMA ? dailyVolMA : na, title="Daily Volume MA", color=color.orange, linewidth=2)

// Volume formatting function
formatVol(_v) =>
    _v >= 1e9 ? str.tostring(_v / 1e9, "#.##") + "B" :_v >= 1e6 ? str.tostring(_v / 1e6, "#.##") + "M" :_v >= 1e3 ? str.tostring(_v / 1e3, "#.##") + "K" :    str.tostring(_v, "#")

// Add labels on bars
if showLabels and barstate.islast == false
    label.new(bar_index, dailyVol, formatVol(dailyVol), yloc=yloc.abovebar, color=color.new(color.black, 100), textcolor=color.white, size=size.tiny)
