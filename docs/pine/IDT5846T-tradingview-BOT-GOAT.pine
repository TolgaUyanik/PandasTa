//@version=6
// =============================================================
//  tradingview BOT GOAT  (Pine Script v6)
//  10x leverage | full-equity sizing
//  SL $1 | TP1 $1 (half) | TP2 $3 (runner) | Trail: lag $1, follow $0.5
// =============================================================
strategy("tradingview BOT GOAT", shorttitle="BOT GOAT", overlay=true,
     pyramiding=0, calc_on_every_tick=false, calc_on_order_fills=false,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     initial_capital=10000,
     margin_long=10.0, margin_short=10.0,
     commission_type=strategy.commission.percent, commission_value=0.0)

// ---------------- INPUTS ----------------
emaFastLen = input.int(21, "Fast EMA", minval=1, group="Trend")
emaSlowLen = input.int(55, "Slow EMA", minval=1, group="Trend")

only15m           = input.bool(true, "Only trade on the 15-minute chart", group="Filters")
tradeWeekdaysOnly = input.bool(true, "Trade weekdays only (Mon-Fri)",      group="Filters")

slDollars          = input.float(1.0,  "Stop Loss ($)",                  step=0.1, minval=0.0, group="Risk ($)")
tp1Dollars         = input.float(1.0,  "Take Profit 1 - half ($)",       step=0.1, minval=0.0, group="Risk ($)")
tp2Dollars         = input.float(3.0,  "Take Profit 2 - full ($)",       step=0.1, minval=0.0, group="Risk ($)")
tp1Percent         = input.float(50.0, "TP1 size (% of position)", step=5.0, minval=1.0, maxval=99.0, group="Risk ($)")
trailLagDollars    = input.float(1.0,  "Trailing activation lag ($)",    step=0.1, minval=0.0, group="Risk ($)")
trailFollowDollars = input.float(0.5,  "Trailing follow distance ($)",   step=0.1, minval=0.0, group="Risk ($)")

showArrows = input.bool(true, "Show entry arrows", group="Display")

// ---------------- CALCULATIONS ----------------
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

emaCrossUp   = ta.crossover(emaFast, emaSlow)
emaCrossDown = ta.crossunder(emaFast, emaSlow)

isWeekday = dayofweek != dayofweek.saturday and dayofweek != dayofweek.sunday
tfOk      = not only15m or timeframe.period == "15"
tradeOk   = tfOk and (not tradeWeekdaysOnly or isWeekday)

// ---------------- DOLLARS -> TICKS ----------------
slTicks          = math.max(1, math.round(slDollars          / syminfo.mintick))
tp1Ticks         = math.max(1, math.round(tp1Dollars         / syminfo.mintick))
tp2Ticks         = math.max(1, math.round(tp2Dollars         / syminfo.mintick))
trailLagTicks    = math.max(1, math.round(trailLagDollars    / syminfo.mintick))
trailFollowTicks = math.max(1, math.round(trailFollowDollars / syminfo.mintick))

// ---------------- SIGNALS ----------------
longSignal  = emaCrossUp   and tradeOk
shortSignal = emaCrossDown and tradeOk

// ---------------- ENTRIES (full equity, with visible flip exits) ----------------
if longSignal
    strategy.close("Short", comment="Flip to Long")
    strategy.entry("Long", strategy.long)

if shortSignal
    strategy.close("Long", comment="Flip to Short")
    strategy.entry("Short", strategy.short)

// ---------------- EXITS: TP1 (half) / TP2 / SL / TRAILING ----------------
// LONG
strategy.exit("TP1 Long", from_entry="Long", qty_percent=tp1Percent, profit=tp1Ticks,
     comment_profit="TP1 Long")
strategy.exit("Exit Long", from_entry="Long",
     profit=tp2Ticks, loss=slTicks,
     trail_points=trailLagTicks, trail_offset=trailFollowTicks,
     comment_profit="TP2 Long", comment_loss="SL Long", comment_trailing="Trail Long")

// SHORT
strategy.exit("TP1 Short", from_entry="Short", qty_percent=tp1Percent, profit=tp1Ticks,
     comment_profit="TP1 Short")
strategy.exit("Exit Short", from_entry="Short",
     profit=tp2Ticks, loss=slTicks,
     trail_points=trailLagTicks, trail_offset=trailFollowTicks,
     comment_profit="TP2 Short", comment_loss="SL Short", comment_trailing="Trail Short")

// ---------------- PLOTS ----------------
plot(emaFast, "Fast EMA", color=color.new(color.aqua,   0))
plot(emaSlow, "Slow EMA", color=color.new(color.orange, 0))

plotshape(showArrows and longSignal,  title="Long Arrow",  style=shape.triangleup,
     location=location.belowbar, color=color.new(color.lime,    0), size=size.small)
plotshape(showArrows and shortSignal, title="Short Arrow", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.fuchsia, 0), size=size.small)

// ---------------- ALERTS ----------------
alertcondition(longSignal,  title="Long Entry",  message="BOT GOAT LONG {{ticker}} @ {{close}}")
alertcondition(shortSignal, title="Short Entry", message="BOT GOAT SHORT {{ticker}} @ {{close}}")