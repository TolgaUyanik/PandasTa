//@version=6
library("LuxyEnergyIndex", overlay=true)

// ═══════════════════════════════════════════════════════════════════════════════
// LUXY ENERGY INDEX (LEI) - Library v1.0
// ═══════════════════════════════════════════════════════════════════════════════
// 
// DESCRIPTION:
// The Luxy Energy Index (LEI) measures the exhaustion level of price movements
// by combining three dimensions: Extension (distance from fair value), 
// Velocity (speed of movement), and Volume (confirmation/suspicion).
//
// Unlike traditional overbought/oversold indicators (RSI, MFI), LEI answers
// "how tired is this move?" rather than "how far has price gone?"
//
// METHODOLOGY:
// LEI combines three normalized components in a novel approach:
// 1. Extension - How far price has moved from VWAP (equilibrium)
// 2. Velocity - How fast price is moving (5-bar rate of change)
// 3. Volume - Acts as a modifier (climax amplifies, suspicious amplifies)
//
// INTERPRETATION:
// 0-30:   Low energy - Safe zone, move can continue
// 30-50:  Moderate - Caution, watch for signs
// 50-70:  Elevated - Warning, exhaustion building
// 70-100: High energy - Exhaustion likely, reversal risk high
//
// KEY FEATURES:
// - Novel combination of Extension, Velocity, and Volume dimensions
// - Volume as modifier, not multiplier (prevents extreme values)
// - Auto-detects crypto vs stocks for VWAP calculation
// - Returns na until sufficient data (no misleading early values)
//
// FIXED PARAMETERS (by design - LEI is a methodology, not a tool):
// - Velocity Period: 5 bars
// - Volume Period: 20 bars  
// - Z-Score Period: 50 bars
// - Extension/Velocity Weights: 50/50
//
// CREDITS & ACKNOWLEDGMENTS:
// This indicator builds upon established technical analysis concepts:
// - VWAP (Volume Weighted Average Price) - Industry standard fair value measure
// - Z-Score normalization - Statistical standardization method
// - ATR (Average True Range) by J. Welles Wilder Jr. - Volatility normalization
// - Volume analysis principles from VSA (Volume Spread Analysis)
// - Academic research: Campbell-Grossman-Wang (1993) on volume-return relationships
//
// DISCLAIMER:
// This indicator is for educational and informational purposes only.
// It does not constitute financial advice. Past performance does not
// guarantee future results. Always do your own research before trading.
// Trading involves substantial risk of loss.
//
// AUTHOR: OrenLuxy
// VERSION: 1.0
// ═══════════════════════════════════════════════════════════════════════════════


// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS (Fixed - not configurable by design)
// ═══════════════════════════════════════════════════════════════════════════════

const int VELOCITY_PERIOD = 5
const int VOLUME_PERIOD = 20
const int ZSCORE_PERIOD = 50
const int ATR_PERIOD = 14
const int ROLLING_VWAP_PERIOD = 50
const float EXTENSION_WEIGHT = 0.5
const float VELOCITY_WEIGHT = 0.5
const float VOLUME_CLIMAX_THRESHOLD = 2.0
const float VOLUME_SUSPICIOUS_THRESHOLD = -1.5
const float VOLUME_CLIMAX_MULTIPLIER = 0.15
const float VOLUME_SUSPICIOUS_MULTIPLIER = 0.10
const float LEI_SCALE_FACTOR = 15.0
const float LEI_CENTER = 50.0


// ═══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// @function Calculates Z-Score normalization
// @param value Current value to normalize
// @param period Lookback period for mean and stddev
// @returns Z-Score normalized value
zScore(float value, int period) =>
    float mean = ta.sma(value, period)
    float stdDev = ta.stdev(value, period)
    float result = stdDev != 0 ? (value - mean) / stdDev : 0.0
    result


// @function Calculates Session VWAP (resets daily) using TradingView built-in
// @returns Session VWAP value
sessionVWAP() =>
    ta.vwap(hlc3)


// @function Calculates Rolling VWAP (no reset, rolling window) for 24/7 markets
// @param period Rolling window period
// @returns Rolling VWAP value
rollingVWAP(int period) =>
    float typicalPrice = hlc3
    float sumTypicalVol = math.sum(typicalPrice * volume, period)
    float sumVol = math.sum(volume, period)
    float vwap = sumVol != 0 ? sumTypicalVol / sumVol : close
    vwap


// @function Determines if current symbol is cryptocurrency
// @returns true if crypto, false otherwise
isCrypto() =>
    bool result = syminfo.type == "crypto"
    result


// @function Gets appropriate VWAP based on asset type
// @returns VWAP value (session for stocks, rolling for crypto)
export getVWAP() =>
    float vwap = isCrypto() ? rollingVWAP(ROLLING_VWAP_PERIOD) : sessionVWAP()
    vwap


// ═══════════════════════════════════════════════════════════════════════════════
// CORE LEI COMPONENTS
// ═══════════════════════════════════════════════════════════════════════════════

// @function Calculates Extension component (distance from VWAP)
// @param src Source price (typically close)
// @param vwapValue VWAP value to measure from
// @returns Extension value normalized by ATR
export calcExtension(float src, float vwapValue) =>
    float atr = ta.atr(ATR_PERIOD)
    float extension = atr != 0 ? math.abs(src - vwapValue) / atr : 0.0
    extension


// @function Calculates Velocity component (rate of price change)
// @param src Source price (typically close)
// @returns Velocity value normalized by ATR
export calcVelocity(float src) =>
    float atr = ta.atr(ATR_PERIOD)
    float priceChange = math.abs(src - src[VELOCITY_PERIOD])
    float velocity = atr != 0 ? priceChange / atr : 0.0
    velocity


// @function Calculates Volume Z-Score
// @returns Volume Z-Score value
export calcVolumeZ() =>
    float volZ = zScore(volume, VOLUME_PERIOD)
    volZ


// @function Calculates Volume Modifier based on Z-Score
// @param volumeZ Volume Z-Score value
// @returns Modifier multiplier (1.0 = neutral, >1.0 = amplified)
export calcVolumeModifier(float volumeZ) =>
    float modifier = 1.0
    if volumeZ > VOLUME_CLIMAX_THRESHOLD
        modifier := 1.0 + (volumeZ - VOLUME_CLIMAX_THRESHOLD) * VOLUME_CLIMAX_MULTIPLIER
    else if volumeZ < VOLUME_SUSPICIOUS_THRESHOLD
        modifier := 1.0 + math.abs(volumeZ - VOLUME_SUSPICIOUS_THRESHOLD) * VOLUME_SUSPICIOUS_MULTIPLIER
    modifier


// ═══════════════════════════════════════════════════════════════════════════════
// MAIN LEI CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

// @function Calculates the complete Luxy Energy Index
// @param src Source price (default: close)
// @returns LEI value (0-100 scale) or na if insufficient data
export lei(float src = close) =>
    // Check for sufficient data
    bool hasEnoughBars = bar_index >= ZSCORE_PERIOD
    
    // Check for valid volume (not zero)
    bool hasValidVolume = volume > 0
    
    // Get appropriate VWAP
    float vwapValue = getVWAP()
    
    // Calculate raw components
    float extensionRaw = calcExtension(src, vwapValue)
    float velocityRaw = calcVelocity(src)
    
    // Normalize to Z-Scores
    float extensionZ = zScore(extensionRaw, ZSCORE_PERIOD)
    float velocityZ = zScore(velocityRaw, ZSCORE_PERIOD)
    
    // Calculate LEI Core (weighted average)
    float leiCore = (extensionZ * EXTENSION_WEIGHT) + (velocityZ * VELOCITY_WEIGHT)
    
    // Calculate Volume Modifier
    float volumeZ = hasValidVolume ? calcVolumeZ() : 0.0
    float volumeModifier = hasValidVolume ? calcVolumeModifier(volumeZ) : 1.0
    
    // Apply Volume Modifier
    float leiAdjusted = leiCore * volumeModifier
    
    // Scale to 0-100
    float leiScaled = LEI_CENTER + (leiAdjusted * LEI_SCALE_FACTOR)
    
    // Clamp to valid range
    float leiFinal = math.max(0.0, math.min(100.0, leiScaled))
    
    // Return na if insufficient data
    float result = hasEnoughBars ? leiFinal : na
    result


// @function Returns LEI with all component values for analysis
// @param src Source price (default: close)
// @returns Tuple [lei, extension, velocity, volumeZ, volumeModifier, vwap]
export leiDetailed(float src = close) =>
    bool hasEnoughBars = bar_index >= ZSCORE_PERIOD
    bool hasValidVolume = volume > 0
    
    float vwapValue = getVWAP()
    float extensionRaw = calcExtension(src, vwapValue)
    float velocityRaw = calcVelocity(src)
    float extensionZ = zScore(extensionRaw, ZSCORE_PERIOD)
    float velocityZ = zScore(velocityRaw, ZSCORE_PERIOD)
    float leiCore = (extensionZ * EXTENSION_WEIGHT) + (velocityZ * VELOCITY_WEIGHT)
    float volumeZ = hasValidVolume ? calcVolumeZ() : 0.0
    float volumeModifier = hasValidVolume ? calcVolumeModifier(volumeZ) : 1.0
    float leiAdjusted = leiCore * volumeModifier
    float leiScaled = LEI_CENTER + (leiAdjusted * LEI_SCALE_FACTOR)
    float leiFinal = math.max(0.0, math.min(100.0, leiScaled))
    float leiResult = hasEnoughBars ? leiFinal : na
    float extResult = hasEnoughBars ? extensionRaw : na
    float velResult = hasEnoughBars ? velocityRaw : na
    float volZResult = hasEnoughBars ? volumeZ : na
    float volModResult = hasEnoughBars ? volumeModifier : na
    
    [leiResult, extResult, velResult, volZResult, volModResult, vwapValue]


// ═══════════════════════════════════════════════════════════════════════════════
// SIGNAL FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// @function Checks if LEI is in exhaustion zone (reversal likely)
// @param leiValue Current LEI value
// @param threshold Exhaustion threshold (default: 70)
// @returns true if LEI >= threshold
export isExhausted(float leiValue, float threshold = 70.0) =>
    bool result = not na(leiValue) and leiValue >= threshold
    result


// @function Checks if LEI is in safe zone (move can continue)
// @param leiValue Current LEI value
// @param threshold Safe zone threshold (default: 30)
// @returns true if LEI <= threshold
export isSafe(float leiValue, float threshold = 30.0) =>
    bool result = not na(leiValue) and leiValue <= threshold
    result


// @function Checks if LEI crossed into exhaustion zone
// @param leiValue Current LEI value
// @param threshold Exhaustion threshold (default: 70)
// @returns true on the bar where LEI crosses above threshold
export crossedExhaustion(float leiValue, float threshold = 70.0) =>
    bool result = ta.crossover(leiValue, threshold)
    result


// @function Checks if LEI crossed into safe zone
// @param leiValue Current LEI value  
// @param threshold Safe zone threshold (default: 30)
// @returns true on the bar where LEI crosses below threshold
export crossedSafe(float leiValue, float threshold = 30.0) =>
    bool result = ta.crossunder(leiValue, threshold)
    result


// @function Returns LEI zone as string
// @param leiValue Current LEI value
// @returns Zone name: "Safe", "Caution", "Warning", or "Exhaustion"
export getZone(float leiValue) =>
    string zone = na(leiValue) ? "N/A" : leiValue < 30 ? "Safe" : leiValue < 50 ? "Caution" : leiValue < 70 ? "Warning" : "Exhaustion"
    zone


// @function Returns recommended color for LEI value
// @param leiValue Current LEI value
// @returns Color based on zone (green/yellow/orange/red)
export getColor(float leiValue) =>
    color c = na(leiValue) ? color.gray : leiValue < 30 ? color.green : leiValue < 50 ? color.yellow : leiValue < 70 ? color.orange : color.red
    c


// ═══════════════════════════════════════════════════════════════════════════════
// UTILITY FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// @function Returns the minimum bars required before LEI produces valid values
// @returns Number of bars needed (50)
export minBarsRequired() =>
    int result = ZSCORE_PERIOD
    result


// @function Checks if current bar has enough history for valid LEI
// @returns true if bar_index >= required bars
export hasEnoughHistory() =>
    bool result = bar_index >= ZSCORE_PERIOD
    result


// @function Returns LEI version string
// @returns Version string
export version() =>
    string v = "1.0"
    v

