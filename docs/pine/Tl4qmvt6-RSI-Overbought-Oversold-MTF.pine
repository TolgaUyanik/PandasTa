//@version=6
indicator("RSI Overbought/Oversold MTF", overlay = false)

rsiPeriod = input.int(14, "RSI Period")
thresholdHigh = input.int(70, "Overbought Threshold")
thresholdLow = input.int(30, "Oversold Threshold")

// --- Symbol Inputs (configurable) ---
symbol0 = input.symbol("BINANCE:BTCUSDT", "Symbol 1")
symbol1 = input.symbol("BINANCE:ETHUSDT", "Symbol 2")
symbol2 = input.symbol("BINANCE:SOLUSDT", "Symbol 3")
symbol3 = input.symbol("BINANCE:BNBUSDT", "Symbol 4")
symbol4 = input.symbol("BINANCE:XRPUSDT", "Symbol 5")
symbol5 = input.symbol("BINANCE:ADAUSDT", "Symbol 6")
symbol6 = input.symbol("BINANCE:AVAXUSDT", "Symbol 7")
symbol7 = input.symbol("BINANCE:AVAAIUSDT.P", "Symbol 8")
symbol8 = input.symbol("BINANCE:DOGEUSDT", "Symbol 9")
symbol9 = input.symbol("BINANCE:VIRTUALUSDT", "Symbol 10")
symbol10 = input.symbol("BINANCE:SUIUSDT", "Symbol 11")
symbol11 = input.symbol("BINANCE:ALCHUSDT.P", "Symbol 12")
symbol12 = input.symbol("BINANCE:LAYERUSDT.P", "Symbol 13")

symbols = array.from(symbol0, symbol1, symbol2, symbol3, symbol4, symbol5, symbol6, symbol7, symbol8, symbol9, symbol10, symbol11, symbol12)

// --- Table Setup ---
var table rsiTable = table.new(position.top_right, 5, 16, border_width = 1)

if bar_index == 1
    table.cell(rsiTable, 0, 0, "Symbol", text_color=color.white, bgcolor=color.gray)
    table.cell(rsiTable, 1, 0, "RSI 1m", text_color=color.white, bgcolor=color.gray)
    table.cell(rsiTable, 2, 0, "RSI 5m", text_color=color.white, bgcolor=color.gray)
    table.cell(rsiTable, 3, 0, "RSI 15m", text_color=color.white, bgcolor=color.gray)
    table.cell(rsiTable, 4, 0, "Status", text_color=color.white, bgcolor=color.gray)

// --- Function for RSI color ---
f_rsi_color(r) => r > thresholdHigh ? color.red : r < thresholdLow ? color.green : color.white

// --- Arrays to hold RSI values ---
rsi_1m_vals = array.new_float()
rsi_5m_vals = array.new_float()
rsi_15m_vals = array.new_float()

// --- Track alerts
var overbought_triggered = array.new_bool()
var oversold_triggered = array.new_bool()

for i = 0 to array.size(symbols) - 1
    sym = array.get(symbols, i)
    rsi1 = request.security(sym, "1", ta.rsi(close, rsiPeriod))
    rsi5 = request.security(sym, "5", ta.rsi(close, rsiPeriod))
    rsi15 = request.security(sym, "15", ta.rsi(close, rsiPeriod))

    array.push(rsi_1m_vals, rsi1)
    array.push(rsi_5m_vals, rsi5)
    array.push(rsi_15m_vals, rsi15)

    // --- Alert logic
    isOversold = (rsi1 < thresholdLow and rsi5 < thresholdLow and rsi15 < thresholdLow)
    isOverbought = (rsi1 > thresholdHigh and rsi5 > thresholdHigh and rsi15 > thresholdHigh)

    if isOversold
        alert("🔔 [Oversold] " + sym + " is oversold on 1m/5m/15m", alert.freq_once_per_bar)
    if isOverbought
        alert("🔔 [Overbought] " + sym + " is overbought on 1m/5m/15m", alert.freq_once_per_bar)

// --- Display table ---
for i = 0 to array.size(symbols) - 1
    sym = array.get(symbols, i)
    rsi1 = array.get(rsi_1m_vals, i)
    rsi5 = array.get(rsi_5m_vals, i)
    rsi15 = array.get(rsi_15m_vals, i)

    status = (rsi1 < thresholdLow and rsi5 < thresholdLow and rsi15 < thresholdLow) ? "Oversold" :
             (rsi1 > thresholdHigh and rsi5 > thresholdHigh and rsi15 > thresholdHigh) ? "Overbought" :
             "Mixed"

    table.cell(rsiTable, 0, i + 1, sym, text_color=color.white)
    table.cell(rsiTable, 1, i + 1, str.tostring(rsi1, format.mintick), text_color=f_rsi_color(rsi1))
    table.cell(rsiTable, 2, i + 1, str.tostring(rsi5, format.mintick), text_color=f_rsi_color(rsi5))
    table.cell(rsiTable, 3, i + 1, str.tostring(rsi15, format.mintick), text_color=f_rsi_color(rsi15))
    table.cell(rsiTable, 4, i + 1, status, text_color=status == "Oversold" ? color.green : status == "Overbought" ? color.red : color.white)
