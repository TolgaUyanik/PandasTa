//@version=6
indicator("VWAPs + Key lvls ASFX-setups", overlay=true)

// #############################################################################
// ############################  VWAP SECTION  ################################
// #############################################################################

// === VWAP INPUTS ===
grpVwapGeneral  = "VWAP — General"
grpVwapToday    = "VWAP — Today Visibility"
grpVwapYesterday = "VWAP — Yesterday Visibility"
grpVwapTimes    = "VWAP — Session Start Times"

showOnlyRecent = input.bool(true, "Show only Today's VWAPs", group=grpVwapGeneral)
vwapSource     = input.source(ohlc4, "VWAP Source", group=grpVwapGeneral)
vwapTz         = input.string("Europe/Lisbon", "Timezone",
     options = ["Europe/Lisbon", "Europe/London", "America/New_York", "UTC"], group=grpVwapGeneral)

showTodayDay      = input.bool(true, "Show Today's Day VWAP", group=grpVwapToday)
showTodayLondon   = input.bool(true, "Show Today's London VWAP", group=grpVwapToday)
showTodayNY       = input.bool(true, "Show Today's NY VWAP", group=grpVwapToday)

showYesterdayLondon = input.bool(true, "Show YD London VWAP", group=grpVwapYesterday)
showYesterdayNY     = input.bool(true, "Show YD NY VWAP", group=grpVwapYesterday)

vwapDayHour     = input.int(0,  "Day VWAP Start Hour", minval=0, maxval=23, group=grpVwapTimes)
vwapDayMin      = input.int(0,  "Day VWAP Start Minute", minval=0, maxval=59, group=grpVwapTimes)

vwapLondonHour  = input.int(8,  "London VWAP Start Hour", minval=0, maxval=23, group=grpVwapTimes)
vwapLondonMin   = input.int(0,  "London VWAP Start Minute", minval=0, maxval=59, group=grpVwapTimes)

vwapNyHour      = input.int(14, "NY VWAP Start Hour", minval=0, maxval=23, group=grpVwapTimes)
vwapNyMin       = input.int(30, "NY VWAP Start Minute", minval=0, maxval=59, group=grpVwapTimes)

colorTodayDay      = color.rgb(0, 0, 0)
colorTodayLondon   = color.rgb(128, 0, 0)
colorTodayNY       = color.rgb(19, 22, 240)

colorYesterdayLondon = color.rgb(250, 104, 104)
colorYesterdayNY     = color.rgb(0, 204, 255)

// === VWAP TIME DETECTION ===
vwapCurrentHour   = hour(time, vwapTz)
vwapCurrentMinute = minute(time, vwapTz)

isDayOpen    = ta.change(time("D")) != 0     // fires once on the first bar of a new calendar day
isLondonOpen = vwapCurrentHour == vwapLondonHour and vwapCurrentMinute == vwapLondonMin
isNYOpen     = vwapCurrentHour == vwapNyHour and vwapCurrentMinute == vwapNyMin

// === VWAP CALENDAR MASKS ===
// The accumulator logic below (cur/prev) computes correct VALUES on every
// historical day, because the same "start at session open, roll at day open" rule
// repeats every day. Without a mask, that means today's-VWAP-shaped lines would
// draw on EVERY past day too, not just today. These masks restrict plotting to the
// actual current calendar day(s) relative to now, so old days stay blank.
msPerDay = 24 * 60 * 60 * 1000

isCalToday = year(time, vwapTz) == year(timenow, vwapTz) and month(time, vwapTz) == month(timenow, vwapTz) and dayofmonth(time, vwapTz) == dayofmonth(timenow, vwapTz)

vwapYestMs = timenow - msPerDay
isCalYesterday = year(time, vwapTz) == year(vwapYestMs, vwapTz) and month(time, vwapTz) == month(vwapYestMs, vwapTz) and dayofmonth(time, vwapTz) == dayofmonth(vwapYestMs, vwapTz)

// === TODAY'S DAY VWAP (resets each day) ===
f_anchoredVWAP(reset) =>
    var float cumulativePV = na
    var float cumulativeVol = na
    if reset or na(cumulativePV)
        cumulativePV := vwapSource * volume
        cumulativeVol := volume
    else
        cumulativePV += vwapSource * volume
        cumulativeVol += volume
    cumulativePV / cumulativeVol

todayDayVWAP = f_anchoredVWAP(isDayOpen)

// === ROLLING TODAY / YESTERDAY LONDON + NY VWAPs ===
// Model: "today" accumulates from its session open and resets at each new day.
// On the bar a new day starts, whatever "today" had accumulated becomes the new
// "yesterday" snapshot, and "yesterday" then keeps accumulating in parallel with
// "today" — anchored one session earlier — until it gets overwritten again at the
// next day open. This gives a genuinely continuous 2-generation rolling VWAP with
// no manual date-matching and no infinite accumulation.

// --- London ---
var float curLondonPV   = na
var float curLondonVol  = na
var bool  curLondonOn   = false

var float prevLondonPV  = na
var float prevLondonVol = na
var bool  prevLondonOn  = false

if isDayOpen
    prevLondonPV  := curLondonPV
    prevLondonVol := curLondonVol
    prevLondonOn  := curLondonOn
    curLondonPV   := na
    curLondonVol  := na
    curLondonOn   := false

if isLondonOpen
    curLondonPV  := vwapSource * volume
    curLondonVol := volume
    curLondonOn  := true
else if curLondonOn
    curLondonPV  += vwapSource * volume
    curLondonVol += volume

if prevLondonOn
    prevLondonPV  += vwapSource * volume
    prevLondonVol += volume

todayLondonVWAP     = curLondonOn  ? curLondonPV  / curLondonVol  : na
yesterdayLondonVWAP  = prevLondonOn ? prevLondonPV / prevLondonVol : na

// --- NY ---
var float curNYPV   = na
var float curNYVol  = na
var bool  curNYOn    = false

var float prevNYPV  = na
var float prevNYVol = na
var bool  prevNYOn  = false

if isDayOpen
    prevNYPV  := curNYPV
    prevNYVol := curNYVol
    prevNYOn  := curNYOn
    curNYPV   := na
    curNYVol  := na
    curNYOn   := false

if isNYOpen
    curNYPV  := vwapSource * volume
    curNYVol := volume
    curNYOn  := true
else if curNYOn
    curNYPV  += vwapSource * volume
    curNYVol += volume

if prevNYOn
    prevNYPV  += vwapSource * volume
    prevNYVol += volume

todayNYVWAP     = curNYOn  ? curNYPV  / curNYVol  : na
yesterdayNYVWAP = prevNYOn ? prevNYPV / prevNYVol : na

// === VWAP PLOTS ===
plot(showTodayDay ? (showOnlyRecent ? (isCalToday ? todayDayVWAP : na) : todayDayVWAP) : na,
     color=colorTodayDay, linewidth=2, title="Today Day VWAP")

plot(showTodayLondon ? (showOnlyRecent ? (isCalToday ? todayLondonVWAP : na) : todayLondonVWAP) : na,
     color=colorTodayLondon, linewidth=2, title="Today London VWAP")

plot(showTodayNY ? (showOnlyRecent ? (isCalToday ? todayNYVWAP : na) : todayNYVWAP) : na,
     color=colorTodayNY, linewidth=2, title="Today NY VWAP")

plot(showYesterdayLondon ? (showOnlyRecent ? ((isCalYesterday or isCalToday) ? yesterdayLondonVWAP : na) : yesterdayLondonVWAP) : na,
     color=colorYesterdayLondon, linewidth=2, title="Yesterday London VWAP")

plot(showYesterdayNY ? (showOnlyRecent ? ((isCalYesterday or isCalToday) ? yesterdayNYVWAP : na) : yesterdayNYVWAP) : na,
     color=colorYesterdayNY, linewidth=2, title="Yesterday NY VWAP")


// #############################################################################
// ##########################  OR + Y-H/L SECTION  #############################
// #############################################################################

// === OR INPUTS ===
grpOrGeneral = "OR — General"
grpOrTimes   = "OR — Session Times"
grpOrColors  = "OR — Colors"

showOR = input.bool(true, "Show Open Range", group=grpOrGeneral)

orNyOpenHour   = input.int(14, "Open Hour", minval=0, maxval=23, group=grpOrTimes)
orNyOpenMinute = input.int(30, "Open Minute", minval=0, maxval=59, group=grpOrTimes)

orNyCloseHour   = input.int(21, "Close Hour", minval=0, maxval=23, group=grpOrTimes)
orNyCloseMinute = input.int(0, "Close Minute", minval=0, maxval=59, group=grpOrTimes)

orMinutes = input.int(15, "Open Range Minutes", minval=1, maxval=60, group=grpOrTimes)

orHighColor = input.color(color.rgb(0, 0, 0), "OR High Color", group=grpOrColors)
orLowColor  = input.color(color.rgb(0, 0, 0), "OR Low Color", group=grpOrColors)

// === OR TIME LOGIC ===
// Uses the same timezone selector as the VWAP section (vwapTz) instead of a
// fixed one, so changing the VWAP timezone input now also shifts the OR window,
// yesterday's day boundary, and the day reset for this section.
orCurrentHour    = hour(time, vwapTz)
orCurrentMinute  = minute(time, vwapTz)
orCurrentMinutes = orCurrentHour * 60 + orCurrentMinute

orOpenMinutes  = orNyOpenHour * 60 + orNyOpenMinute
orCloseMinutes = orNyCloseHour * 60 + orNyCloseMinute

inORPeriod  = orCurrentMinutes >= orOpenMinutes and orCurrentMinutes < orOpenMinutes + orMinutes
inNYSession = orCurrentMinutes >= orOpenMinutes and orCurrentMinutes < orCloseMinutes

// === OPEN RANGE CALCULATION ===
var float orHigh = na
var float orLow  = na
var int   orStartBar = na

// Line objects
var line orHighLine = na
var line orLowLine  = na

// Reset at new day
orNewDay = ta.change(time("D")) != 0
if orNewDay
    orHigh := na
    orLow := na
    orStartBar := na
    if not na(orHighLine)
        line.delete(orHighLine)
    if not na(orLowLine)
        line.delete(orLowLine)
    orHighLine := na
    orLowLine := na

// Record the first bar of the OR
if inORPeriod and na(orStartBar)
    orStartBar := bar_index

// Build OR during first X minutes
if inORPeriod
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow) ? low : math.min(orLow, low)

// OR is ready after the first X minutes
orReady = orCurrentMinutes >= orOpenMinutes + orMinutes

// Draw/update lines
if orReady and inNYSession and showOR
    if na(orHighLine)
        orHighLine := line.new(x1=orStartBar, y1=orHigh, x2=bar_index, y2=orHigh, color=orHighColor, width=2)
        orLowLine  := line.new(x1=orStartBar, y1=orLow,  x2=bar_index, y2=orLow,  color=orLowColor,  width=2)
    else
        line.set_xy1(orHighLine, orStartBar, orHigh)
        line.set_xy2(orHighLine, bar_index, orHigh)
        line.set_color(orHighLine, orHighColor)

        line.set_xy1(orLowLine, orStartBar, orLow)
        line.set_xy2(orLowLine, bar_index, orLow)
        line.set_color(orLowLine, orLowColor)

// === YESTERDAY HIGH / LOW ===

// Previous completed day's High and Low
yesterdayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
yesterdayLow  = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)

// Detect today's bars (now follows the same VWAP timezone selector as the rest
// of the script, instead of a fixed one)
orIsToday = year(time, vwapTz) == year(timenow, vwapTz) and
          month(time, vwapTz) == month(timenow, vwapTz) and
          dayofmonth(time, vwapTz) == dayofmonth(timenow, vwapTz)

// Plot only on today's chart
plot(orIsToday ? yesterdayHigh : na, title="Yesterday High", linewidth=1)
plot(orIsToday ? yesterdayLow : na, title="Yesterday Low", linewidth=1)