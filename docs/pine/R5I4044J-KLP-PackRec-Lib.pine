//@version=5

// ============================================================================
// KLP_PackRec_Lib — Key Levels Pro Ai Recommendation Pack Library
// Version: 1 (fresh TV publication — renamed from KLP_PackRec on 2026-05-15)
// Generated: 20260406 | Lookback: 90d | Min N: 10 | Contexts: 36
// ============================================================================
// Published ONCE under library name "KLP_PackRec_Lib".
// Subsequent recommendation updates only bump the TradingView version number.
// KLP Ai imports this library as:
//   import ragstotrading/KLP_PackRec_Lib/1 as KLPPACK
//
// Context dimensions:
//   root  — root symbol (NQ, ES, RTY, CL, GC, 6E, NG, BTC, etc.)
//   tf    — timeframe string ("1", "2", "5", "15", "30", "60", "240", "D")
//   dir   — direction (1=long, -1=short)
//   fam   — signal_family (0=REVERSAL, 1=CONTINUATION)
//   ichi  — ichi_aligned (1=cloud fully aligned with direction, 0=mixed/against)
//
// Returns from klp_pack_get():
//   found         — bool: true if context has data above min_n threshold
//   be_id         — 0=NoBE  1=BE@TP1
//   tp_id         — 1=TP1only  2=TP1+TP2
//   stop_mult_x10 — recommended ATR stop multiplier x10 (10=1.0x, 8=0.75x, 15=1.5x)
//   n             — sample count for this context
//   avg_r         — average R for this context (use to derive ML quality label)
//   updated       — YYYYMMDD of last server computation
//
// ML Quality label derivation from avg_r (matches server _klp_quality_bucket):
//   avg_r <  0.0  → POOR
//   avg_r >= 0.0  → WEAK
//   avg_r >= 1.0  → GOOD
//   avg_r >= 1.5  → STRONG
//
// Pack data format: "ROOT|TF|DIR|FAM|ICHI|BE_ID|TP_ID|STOP_MULT_X10|N|AVG_R_X100"
//
// ── HOW TO UPDATE ────────────────────────────────────────────────────────────
// 1. Dashboard → KLP Signal Intelligence → KLP Pack Builder → Build KLP Pack
// 2. Download the generated .pine file
// 3. Open TradingView Pine Editor → KLP_PackRec_Lib library → select all → paste
// 4. Publish → New version (TradingView auto-increments version number)
// 5. Update KLP Ai: import ragstotrading/KLP_PackRec_Lib/<new_version> as KLPPACK
// 6. Republish KLP Ai Pine indicator
// ============================================================================

library("KLP_PackRec_Lib", overlay=false)

// ── Pack metadata ─────────────────────────────────────────────────────────────
string PACK_DATE          = "20260406"
int    PACK_LOOKBACK_DAYS = 90
int    PACK_MIN_N         = 10

// ── Internal lookup key builder ────────────────────────────────────────────────
_klp_pack_key(string root, string tf, int dir, int fam, int ichi) =>
    root + "|" + tf + "|" + str.tostring(dir) + "|" + str.tostring(fam) + "|" + str.tostring(ichi)

// ── Exported function: klp_pack_get ───────────────────────────────────────────
// Returns: [found, be_id, tp_id, stop_mult_x10, n, avg_r, updated_date]
export klp_pack_get(string root, string tf, int dir, int fam, int ichi) =>
    // Format: "ROOT|TF|DIR|FAM|ICHI|BE_ID|TP_ID|STOP_MULT_X10|N|AVG_R_X100"
    // 9-field rows (v1): no stop_mult field — defaults to 10 (1.0x ATR)
    // 10-field rows (v2+): includes stop_mult_x10 at index 7
    string[] _rows = array.from("BTC|2|1|0|1|1|2|8|11|106",
         "BTC|2|1|0|0|1|2|8|14|93",
         "HG|2|1|0|0|1|1|8|16|55",
         "HG|2|1|0|0|0|1|10|23|49",
         "YM|2|1|1|1|0|1|8|73|47",
         "BTC|2|1|1|1|0|1|10|56|47",
         "HG|2|1|0|0|0|1|10|20|46",
         "NG|2|1|0|0|0|1|8|42|43",
         "BTC|2|1|0|0|0|1|10|12|40",
         "CL|2|-1|0|0|0|1|15|18|37",
         "YM|2|1|0|0|0|1|10|12|36",
         "NG|2|-1|0|0|0|1|15|19|35",
         "GC|2|1|0|0|0|1|10|10|33",
         "6E|2|1|1|1|0|1|10|27|32",
         "6E|2|-1|0|0|0|1|15|17|31",
         "6E|2|1|0|0|0|1|10|29|30",
         "NG|2|1|0|1|0|1|10|21|30",
         "YM|2|-1|0|0|0|1|15|14|29",
         "CL|2|-1|0|0|0|1|15|10|27",
         "HG|2|1|1|1|0|1|10|43|23",
         "6E|2|-1|0|1|0|1|15|19|20",
         "RTY|2|1|1|1|0|1|10|71|20",
         "ES|2|1|1|1|0|1|8|77|20",
         "NG|2|1|1|1|0|1|10|11|19",
         "6E|2|1|0|0|0|1|10|37|18",
         "6E|2|1|0|1|0|1|10|22|17",
         "NQ|2|-1|0|0|0|1|15|11|16",
         "NQ|2|1|1|1|0|1|10|84|16",
         "CL|2|1|0|0|0|1|8|10|14",
         "RTY|2|1|0|0|0|1|10|18|13",
         "HG|2|-1|0|0|0|1|15|17|12",
         "BTC|2|-1|1|1|0|1|15|48|11",
         "CL|2|1|1|1|0|1|10|58|11",
         "GC|2|1|1|1|0|1|10|84|10",
         "NG|2|1|0|0|0|1|10|35|7",
         "RTY|2|-1|0|0|0|1|15|12|0"
         )

    string _key         = _klp_pack_key(root, tf, dir, fam, ichi)
    bool   _found       = false
    int    _be_id       = 0
    int    _tp_id       = 1
    int    _stop_mult   = 10
    int    _n           = 0
    float  _avg_r       = 0.0
    string _date        = PACK_DATE

    int _size = array.size(_rows)
    if _size > 0
        for _i = 0 to _size - 1
            string _row = array.get(_rows, _i)
            if str.length(_row) > 5
                string[] _parts = str.split(_row, "|")
                int _sz = array.size(_parts)
                if _sz >= 9
                    string _rKey = array.get(_parts, 0) + "|" +
                                   array.get(_parts, 1) + "|" +
                                   array.get(_parts, 2) + "|" +
                                   array.get(_parts, 3) + "|" +
                                   array.get(_parts, 4)
                    if _rKey == _key
                        bool _isV2plus = _sz == 10
                        int _n_idx    = _isV2plus ? 8 : 7
                        int _avgr_idx = _isV2plus ? 9 : 8
                        int _rN       = int(str.tonumber(array.get(_parts, _n_idx)))
                        if _rN >= PACK_MIN_N
                            _found     := true
                            _be_id     := int(str.tonumber(array.get(_parts, 5)))
                            _tp_id     := int(str.tonumber(array.get(_parts, 6)))
                            _stop_mult := _isV2plus ? int(str.tonumber(array.get(_parts, 7))) : 10
                            _n         := _rN
                            _avg_r     := str.tonumber(array.get(_parts, _avgr_idx)) / 100.0
    [_found, _be_id, _tp_id, _stop_mult, _n, _avg_r, _date]

// ── Exported function: klp_pack_meta ──────────────────────────────────────────
// Returns: [updated_date, lookback_days_str, min_n_str]
export klp_pack_meta() =>
    [PACK_DATE, str.tostring(PACK_LOOKBACK_DAYS), str.tostring(PACK_MIN_N)]
