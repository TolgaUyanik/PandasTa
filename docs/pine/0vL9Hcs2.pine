//@version=6
strategy(
     title="Strategy_470 - NY Open 3H Sweep Continuation",
     shorttitle="Strategy_470",
     overlay=true,
     initial_capital=10000,
     pyramiding=0,
     commission_type=strategy.commission.percent,
     commission_value=0.0,
     process_orders_on_close=true,
     calc_on_every_tick=true,
     calc_on_order_fills=true
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

nySession      = input.session("0900-1030", "NY Trading Window")
nyTimezone     = input.string("America/New_York", "Timezone")

useLongs       = input.bool(true, "Enable Longs")
useShorts      = input.bool(true, "Enable Shorts")

swingLen       = input.int(2, "Swing Length", minval=1, maxval=10)
bufferTicks    = input.int(2, "SL Buffer Ticks", minval=0, maxval=100)

useBreakEven   = input.bool(true, "Move SL to BE at +1R")
oneTradeDay    = input.bool(true, "Max 1 Trade Per Day")

showLevels     = input.bool(true, "Show Previous 3H Range")
showSignals    = input.bool(true, "Show Signals")
showDebug       = input.bool(true, "Show Debug Labels")

positionPct    = input.float(95.0, "Position Size % of Equity", minval=1, maxval=100, step=1)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SESSION LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

inSession = not na(time(timeframe.period, nySession, nyTimezone))
newDay = ta.change(time("D", "0000-2359", nyTimezone)) != 0

var bool tradedToday = false

if newDay
    tradedToday := false

canTradeToday = oneTradeDay ? not tradedToday : true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3H REFERENCE RANGE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

h3HighPrev = request.security(syminfo.tickerid, "180", high[1], barmerge.gaps_off, barmerge.lookahead_off)
h3LowPrev  = request.security(syminfo.tickerid, "180", low[1],  barmerge.gaps_off, barmerge.lookahead_off)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SWING DETECTION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow  = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(pivotHigh)
    lastSwingHigh := pivotHigh

if not na(pivotLow)
    lastSwingLow := pivotLow

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DAILY STATE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var bool longSweepDetected  = false
var bool shortSweepDetected = false

var float longSweepLow      = na
var float shortSweepHigh    = na

var float longEntryLevel    = na
var float shortEntryLevel   = na

var float longSL            = na
var float longTP            = na
var float shortSL           = na
var float shortTP           = na

if newDay
    longSweepDetected  := false
    shortSweepDetected := false
    longSweepLow       := na
    shortSweepHigh     := na
    longEntryLevel     := na
    shortEntryLevel    := na
    longSL             := na
    longTP             := na
    shortSL            := na
    shortTP            := na

slBuffer = bufferTicks * syminfo.mintick

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SWEEP DETECTION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if inSession and canTradeToday and strategy.position_size == 0
    if useLongs and low < h3LowPrev
        longSweepDetected := true
        longSweepLow := na(longSweepLow) ? low : math.min(longSweepLow, low)

    if useShorts and high > h3HighPrev
        shortSweepDetected := true
        shortSweepHigh := na(shortSweepHigh) ? high : math.max(shortSweepHigh, high)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTRY LEVEL AFTER SWEEP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if inSession and canTradeToday and strategy.position_size == 0
    if longSweepDetected and not na(lastSwingHigh)
        longEntryLevel := lastSwingHigh
        longSL := longSweepLow - slBuffer
        longTP := h3HighPrev

    if shortSweepDetected and not na(lastSwingLow)
        shortEntryLevel := lastSwingLow
        shortSL := shortSweepHigh + slBuffer
        shortTP := h3LowPrev

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// POSITION SIZE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

qty = (strategy.equity * positionPct / 100.0) / close

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTRY CONDITIONS
// En vez de dejar una orden stop delicada,
// ejecutamos cuando el precio rompe el nivel.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

longReady = (
     inSession and
     canTradeToday and
     useLongs and
     strategy.position_size == 0 and
     longSweepDetected and
     not na(longEntryLevel) and
     not na(longSL) and
     not na(longTP) and
     longEntryLevel > longSL and
     longTP > longEntryLevel
)

shortReady = (
     inSession and
     canTradeToday and
     useShorts and
     strategy.position_size == 0 and
     shortSweepDetected and
     not na(shortEntryLevel) and
     not na(shortSL) and
     not na(shortTP) and
     shortEntryLevel < shortSL and
     shortTP < shortEntryLevel
)

longTrigger = longReady and high >= longEntryLevel
shortTrigger = shortReady and low <= shortEntryLevel

if longTrigger
    strategy.entry("Long", strategy.long, qty=qty)
    tradedToday := true

if shortTrigger
    strategy.entry("Short", strategy.short, qty=qty)
    tradedToday := true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRADE MANAGEMENT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float activeLongSL  = na
var float activeLongTP  = na
var float activeShortSL = na
var float activeShortTP = na

var bool longBEActivated  = false
var bool shortBEActivated = false

newLongPosition  = strategy.position_size > 0 and strategy.position_size[1] <= 0
newShortPosition = strategy.position_size < 0 and strategy.position_size[1] >= 0

if newLongPosition
    activeLongSL := longSL
    activeLongTP := longTP
    longBEActivated := false

if newShortPosition
    activeShortSL := shortSL
    activeShortTP := shortTP
    shortBEActivated := false

if strategy.position_size == 0
    activeLongSL := na
    activeLongTP := na
    activeShortSL := na
    activeShortTP := na
    longBEActivated := false
    shortBEActivated := false

// Long BE
if strategy.position_size > 0 and useBreakEven and not longBEActivated and not na(activeLongSL)
    entryPrice = strategy.position_avg_price
    riskLong = entryPrice - activeLongSL
    beTriggerLong = entryPrice + riskLong

    if riskLong > 0 and high >= beTriggerLong
        activeLongSL := entryPrice
        longBEActivated := true

// Short BE
if strategy.position_size < 0 and useBreakEven and not shortBEActivated and not na(activeShortSL)
    entryPrice = strategy.position_avg_price
    riskShort = activeShortSL - entryPrice
    beTriggerShort = entryPrice - riskShort

    if riskShort > 0 and low <= beTriggerShort
        activeShortSL := entryPrice
        shortBEActivated := true

if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=activeLongSL, limit=activeLongTP)

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", stop=activeShortSL, limit=activeShortTP)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VISUALS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plot(showLevels ? h3HighPrev : na, title="Previous 3H High", color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
plot(showLevels ? h3LowPrev : na, title="Previous 3H Low", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)

plot(showSignals ? longEntryLevel : na, title="Long Entry Level", color=color.new(color.lime, 0), linewidth=2, style=plot.style_circles)
plot(showSignals ? shortEntryLevel : na, title="Short Entry Level", color=color.new(color.red, 0), linewidth=2, style=plot.style_circles)

plot(strategy.position_size > 0 ? activeLongSL : na, title="Active Long SL", color=color.new(color.red, 0), linewidth=2)
plot(strategy.position_size > 0 ? activeLongTP : na, title="Active Long TP", color=color.new(color.green, 0), linewidth=2)

plot(strategy.position_size < 0 ? activeShortSL : na, title="Active Short SL", color=color.new(color.red, 0), linewidth=2)
plot(strategy.position_size < 0 ? activeShortTP : na, title="Active Short TP", color=color.new(color.green, 0), linewidth=2)

bgcolor(inSession ? color.new(color.blue, 88) : na, title="NY Trading Window")

plotshape(
     showSignals and longSweepDetected and inSession,
     title="Long Sweep Detected",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.new(color.lime, 0),
     size=size.tiny,
     text="Sweep L"
)

plotshape(
     showSignals and shortSweepDetected and inSession,
     title="Short Sweep Detected",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.new(color.red, 0),
     size=size.tiny,
     text="Sweep S"
)

plotshape(
     longTrigger,
     title="Long Entry",
     style=shape.labelup,
     location=location.belowbar,
     color=color.new(color.lime, 0),
     textcolor=color.black,
     size=size.small,
     text="LONG"
)

plotshape(
     shortTrigger,
     title="Short Entry",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.new(color.red, 0),
     textcolor=color.white,
     size=size.small,
     text="SHORT"
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DEBUG TABLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table debugTable = table.new(position.top_right, 2, 8, border_width=1)

if showDebug and barstate.islast
    table.cell(debugTable, 0, 0, "In Session", text_color=color.white)
    table.cell(debugTable, 1, 0, str.tostring(inSession), text_color=color.white)

    table.cell(debugTable, 0, 1, "Traded Today", text_color=color.white)
    table.cell(debugTable, 1, 1, str.tostring(tradedToday), text_color=color.white)

    table.cell(debugTable, 0, 2, "3H High Prev", text_color=color.white)
    table.cell(debugTable, 1, 2, str.tostring(h3HighPrev), text_color=color.white)

    table.cell(debugTable, 0, 3, "3H Low Prev", text_color=color.white)
    table.cell(debugTable, 1, 3, str.tostring(h3LowPrev), text_color=color.white)

    table.cell(debugTable, 0, 4, "Long Sweep", text_color=color.white)
    table.cell(debugTable, 1, 4, str.tostring(longSweepDetected), text_color=color.white)

    table.cell(debugTable, 0, 5, "Short Sweep", text_color=color.white)
    table.cell(debugTable, 1, 5, str.tostring(shortSweepDetected), text_color=color.white)

    table.cell(debugTable, 0, 6, "Long Ready", text_color=color.white)
    table.cell(debugTable, 1, 6, str.tostring(longReady), text_color=color.white)

    table.cell(debugTable, 0, 7, "Short Ready", text_color=color.white)
    table.cell(debugTable, 1, 7, str.tostring(shortReady), text_color=color.white)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(longTrigger, title="Strategy_470 Long Entry", message="Strategy_470 Long entry triggered")
alertcondition(shortTrigger, title="Strategy_470 Short Entry", message="Strategy_470 Short entry triggered")