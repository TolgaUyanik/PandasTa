// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Modifed with Universal Auto LTF Resolution Mapping, Auto Text Contrast, Continuous POC & Docked Label

//@version=6
indicator('Dynamic Volume & Delta Profile (Advanced Support/Resistance/Mitigation)[LTW]', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

// ==========================================
// 1. INPUT SETTINGS (설정)
// ==========================================
grp_general = 'General Settings (기본 설정)'
bbars = input.int(defval = 672, title = 'Number of Bars (과거 조회 봉 개수 제한)', minval = 10, maxval = 5000, group = grp_general)
cnum = input.int(defval = 30, title = 'Row Size (매물대 행 개수)', minval = 10, maxval = 100, group = grp_general)
vp_width_pct = input.int(defval = 50, title = 'Profile Width % (막대 최대 너비 %)', minval = 10, maxval = 200, group = grp_general)
prof_mode = input.string(defval = 'Delta (순매수/순매도 차이)', title = 'Profile Mode (프로파일 표시 모드)', options = ['Delta (순매수/순매도 차이)', 'Split (매수/매도 분리)', 'Total (통합 거래량)'], group = grp_general)
placement = input.string(defval = 'Right', title = 'Placement (배치 위치)', options = ['Left', 'Right'], group = grp_general)
offset = input.int(defval = 100, title = 'Horizontal Offset (우측 이동 칸수)', minval = -500, maxval = 500, group = grp_general)
show_range = input.bool(defval = true, title = 'Show Profile Date Range & Start Line (조회 시작점 수직선/날짜 표시)', group = grp_general)

grp_mit = 'Mitigation & SMC (미티게이션 및 물량 해소)'
use_mitigation  = input.bool(defval = true, title = 'Enable Mitigation Cut-off (HVN/LVN 충돌 감지 및 중단)', group = grp_mit)
show_only_fresh = input.bool(defval = false, title = 'Show Only Unmitigated Zones (미체결/신선한 매물대만 표시)', group = grp_mit)
mit_style       = input.string(defval = 'Dim Mitigated (해소된 영역 어둡게)', title = 'Mitigated Zone Style (해소된 영역 표시 방식)', options = ['Dim Mitigated (해소된 영역 어둡게)', 'Hide Mitigated (해소된 영역 숨기기)', 'Normal (일반 표시)'], group = grp_mit)

// [전면 개편] 모든 시간봉 및 분봉/일봉 차트 완벽 호환을 위한 스마트 LTF 선택 모드
grp_precision = 'Precision & LTF (정밀도 및 하위 타임프레임)'
use_ltf    = input.bool(defval = true, title = 'Use Lower Timeframe Precision (하위 분봉 정밀 분석 사용)', group = grp_precision)
ltf_mode   = input.string(defval = 'Auto (차트 주기에 맞춰 자동 셋팅)', title = 'LTF Selection Mode (하위 분봉 선택 모드)', options = ['Auto (차트 주기에 맞춰 자동 셋팅)', 'Manual (수동 지정)'], group = grp_precision)
ltf_manual = input.timeframe(defval = '5', title = 'Manual LTF (수동 지정 시 분봉)', group = grp_precision)

grp_sr = 'Support / Resistance Zones (지지/저항 존)'
show_hvn = input.bool(defval = true, title = 'Highlight HVN Zones (강한 매물대 지지/저항 연장)', group = grp_sr)
hvn_percent = input.float(defval = 85.0, title = 'HVN Threshold % (상위 매물대 기준)', minval = 50.0, maxval = 99.0, group = grp_sr)
show_lvn = input.bool(defval = true, title = 'Highlight LVN Lines (진공 지대 / 급변 구간)', group = grp_sr)
lvn_width = input.int(defval = 1, title = 'LVN Line Width (진공 지대 선 두께)', minval = 1, maxval = 5, group = grp_sr)
lvn_style_str = input.string(defval = 'Dotted (점선)', title = 'LVN Line Style (진공 지대 선 종류)', options = ['Solid (실선)', 'Dashed (파선)', 'Dotted (점선)'], group = grp_sr)
lvn_col_mode = input.string(defval = 'Auto (Match Delta Color)', title = 'LVN Color Mode (진공 지대 색상 모드)', options = ['Auto (Match Delta Color)', 'Manual (수동 지정)'], group = grp_sr)

grp_text = 'Row Volume Labels (막대별 거래량 텍스트)'
show_row_vols = input.bool(defval = true, title = 'Show Row Volume Text (막대별 거래량 표시)', group = grp_text)
row_vol_type = input.string(defval = 'Total Vol (통합 거래량)', title = 'Display Value (표시 내용)', options = ['Total Vol (통합 거래량)', 'Delta Vol (순매수/매도 차이)', 'Both (통합 + 델타)'], group = grp_text)
col_mode = input.string(defval = 'Auto (Match Buy/Sell Color)', title = 'Text Color Mode (글자 색상 모드)', options = ['Auto (Match Buy/Sell Color)', 'Manual (수동 지정)'], group = grp_text)
manual_color = input.color(defval = #FFFFFF, title = 'Manual Text Color (수동 지정 색상)', group = grp_text)
text_size_str = input.string(defval = 'tiny', title = 'Text Size (글자 크기)', options = ['tiny', 'small', 'normal'], group = grp_text)

grp_color = 'Color Settings (색상 설정)'
color_buy = input.color(defval = #00E676, title = 'Buy / Delta Plus (매수 우위 기본색)', group = grp_color)
color_sell = input.color(defval = #FF5252, title = 'Sell / Delta Minus (매도 우위 기본색)', group = grp_color)
color_total = input.color(defval = #2962FF, title = 'Total Volume (통합 기본색)', group = grp_color)
min_trans = input.int(defval = 0, title = 'Min Transparency % (가장 진한 막대 투명도 %)', minval = 0, maxval = 100, group = grp_color)
max_trans = input.int(defval = 85, title = 'Max Transparency % (가장 연한 막대 투명도 %)', minval = 0, maxval = 100, group = grp_color)
color_hvn_up = input.color(defval = color.new(#00E676, 80), title = 'HVN Support Zone (지지 존)', group = grp_color)
color_hvn_dn = input.color(defval = color.new(#FF5252, 80), title = 'HVN Resistance Zone (저항 존)', group = grp_color)
color_lvn = input.color(defval = color.new(#9E9E9E, 30), title = 'LVN Line Color (수동 지정 진공 지대 선)', group = grp_color)
poc_color     = input.color(defval = #FFD600, title = 'Naked POC Color (미체결 POC 기본색)', group = grp_color)
poc_mit_color = input.color(defval = #9E9E9E, title = 'Mitigated POC Color (해소된 POC 변경색)', group = grp_color)

// ==========================================
// 2. DATA CALCULATION (데이터 및 유니버설 LTF 스마트 셋팅)
// ==========================================
top = ta.highest(bbars)
bot = ta.lowest(bbars)
dist = (top - bot) / 500
step = (top - bot) / cnum

levels = array.new_float(cnum + 1)
for x = 0 to cnum by 1
    array.set(levels, x, bot + step * x)

get_vol(y11, y12, y21, y22, height, vol) =>
    height == 0 ? 0.0 : nz(math.max(math.min(math.max(y11, y12), math.max(y21, y22)) - math.max(math.min(y11, y12), math.min(y21, y22)), 0) * vol / height)

format_vol(vol) =>
    abs_vol = math.abs(vol)
    formatted_str = abs_vol >= 1000000000 ? str.tostring(vol / 1000000000, '#.##') + 'B' : abs_vol >= 1000000 ? str.tostring(vol / 1000000, '#.##') + 'M' : abs_vol >= 1000 ? str.tostring(vol / 1000, '#.##') + 'K' : str.tostring(vol, '#.##')
    formatted_str

f_get_row_text(t_val, d_val) =>
    if not show_row_vols
        ''
    else if row_vol_type == 'Total Vol (통합 거래량)'
        format_vol(t_val)
    else if row_vol_type == 'Delta Vol (순매수/매도 차이)'
        (d_val > 0 ? '+' : '') + format_vol(d_val)
    else
        format_vol(t_val) + ' (' + (d_val > 0 ? '+' : '') + format_vol(d_val) + ')'

// --- [핵심 업그레이드] 모든 시간봉(1H, 2H, 3H, 4H, 6H, 8H, 12H 등) 및 전체 차트 완벽 대응 스케일링 ---
// 캔들 1개당 10~20개의 하위 캔들을 일정하게 유지하여 서버 과부하 방지 및 최대 오더플로우 정확도 달성
simple int tf_sec = timeframe.in_seconds(timeframe.period)
simple string auto_ltf = tf_sec <= 900    ? "1" :   // 1분~15분 차트 -> 1분봉 정밀도
                         tf_sec <= 1800   ? "3" :   // 30분 차트 -> 3분봉 (10배수)
                         tf_sec <= 3600   ? "5" :   // 1시간(1H) 차트 -> 5분봉 (12배수)
                         tf_sec <= 7200   ? "10" :  // 2시간(2H) 차트 -> 10분봉 (12배수)
                         tf_sec <= 14400  ? "15" :  // 3시간~4시간(4H) 차트 -> 15분봉 (12~16배수)
                         tf_sec <= 28800  ? "30" :  // 6시간~8시간(8H) 차트 -> 30분봉 (12~16배수)
                         tf_sec <= 86400  ? "60" :  // 12시간~일봉(D) 차트 -> 1시간봉(60m) (12~24배수)
                         tf_sec <= 604800 ? "240" : // 3일~주봉(W) 차트 -> 4시간봉(240m)
                         "D"                        // 월봉(M) 이상 -> 일봉(D)

simple string target_ltf = ltf_mode == 'Auto (차트 주기에 맞춰 자동 셋팅)' ? auto_ltf : ltf_manual

[ltf_o, ltf_h, ltf_l, ltf_c, ltf_v] = request.security_lower_tf(syminfo.tickerid, target_ltf, [open, high, low, close, volume])

// ==========================================
// 3. PROFILE & MITIGATION PROCESSING (실시간 연산)
// ==========================================
if barstate.islast
    int eff_bars = math.min(bbars, bar_index + 1)
    int left_bar = bar_index - eff_bars + 1

    buy_vols = array.new_float(cnum, 0.0)
    sell_vols = array.new_float(cnum, 0.0)
    row_max_vol = array.new_float(cnum, 0.0)
    row_origin_bar = array.new_int(cnum, eff_bars - 1)

    for bars = 0 to eff_bars - 1 by 1
        if use_ltf and not na(ltf_o[bars]) and array.size(ltf_o[bars]) > 0
            sub_o = ltf_o[bars], sub_h = ltf_h[bars], sub_l = ltf_l[bars], sub_c = ltf_c[bars], sub_v = ltf_v[bars]
            for i = 0 to array.size(sub_o) - 1 by 1
                s_o = array.get(sub_o, i), s_h = array.get(sub_h, i), s_l = array.get(sub_l, i), s_c = array.get(sub_c, i), s_v = array.get(sub_v, i)
                is_buy = s_c >= s_o
                for x = 0 to cnum - 1 by 1
                    vol_slice = get_vol(array.get(levels, x), array.get(levels, x + 1), s_l, s_h, s_h - s_l, s_v)
                    if is_buy
                        array.set(buy_vols, x, array.get(buy_vols, x) + vol_slice)
                    else
                        array.set(sell_vols, x, array.get(sell_vols, x) + vol_slice)
                    if vol_slice > array.get(row_max_vol, x)
                        array.set(row_max_vol, x, vol_slice)
                        array.set(row_origin_bar, x, bars)
        else
            body_top = math.max(close[bars], open[bars]), body_bot = math.min(close[bars], open[bars])
            itsgreen = close[bars] >= open[bars], topwick = high[bars] - body_top
            bottomwick = body_bot - low[bars], body = body_top - body_bot
            total_span = 2 * topwick + 2 * bottomwick + body
            bodyvol = total_span > 0 ? body * volume[bars] / total_span : volume[bars]
            topwickvol = total_span > 0 ? 2 * topwick * volume[bars] / total_span : 0
            bottomwickvol = total_span > 0 ? 2 * bottomwick * volume[bars] / total_span : 0

            for x = 0 to cnum - 1 by 1
                b_slice = (itsgreen ? get_vol(array.get(levels, x), array.get(levels, x + 1), body_bot, body_top, body, bodyvol) : 0) + get_vol(array.get(levels, x), array.get(levels, x + 1), body_top, high[bars], topwick, topwickvol) / 2 + get_vol(array.get(levels, x), array.get(levels, x + 1), body_bot, low[bars], bottomwick, bottomwickvol) / 2
                s_slice = (itsgreen ? 0 : get_vol(array.get(levels, x), array.get(levels, x + 1), body_bot, body_top, body, bodyvol)) + get_vol(array.get(levels, x), array.get(levels, x + 1), body_top, high[bars], topwick, topwickvol) / 2 + get_vol(array.get(levels, x), array.get(levels, x + 1), body_bot, low[bars], bottomwick, bottomwickvol) / 2
                tot_slice = b_slice + s_slice
                array.set(buy_vols, x, array.get(buy_vols, x) + b_slice)
                array.set(sell_vols, x, array.get(sell_vols, x) + s_slice)
                if tot_slice > array.get(row_max_vol, x)
                    array.set(row_max_vol, x, tot_slice)
                    array.set(row_origin_bar, x, bars)

    total_vols = array.new_float(cnum, 0.0)
    delta_vols = array.new_float(cnum, 0.0)
    for x = 0 to cnum - 1 by 1
        t_vol = array.get(buy_vols, x) + array.get(sell_vols, x)
        array.set(total_vols, x, t_vol)
        array.set(delta_vols, x, array.get(buy_vols, x) - array.get(sell_vols, x))

    int poc = array.indexof(total_vols, array.max(total_vols))
    max_vol = array.max(total_vols)
    max_delta = 0.0
    for x = 0 to cnum - 1 by 1
        max_delta := math.max(max_delta, math.abs(array.get(delta_vols, x)))

    row_mit_bar = array.new_int(cnum, -1)
    if use_mitigation
        for x = 0 to cnum - 1 by 1
            int orig_b = array.get(row_origin_bar, x)
            y_top_val = array.get(levels, x + 1) - dist, y_bot_val = array.get(levels, x) + dist
            bool departed = false, int mit_b = -1
            if orig_b > 0 and orig_b < eff_bars
                for b = orig_b - 1 to 0 by 1
                    bool in_zone = high[b] >= y_bot_val and low[b] <= y_top_val
                    if not departed
                        if not in_zone
                            departed := true
                    else
                        if in_zone
                            mit_b := b
                            break
            array.set(row_mit_bar, x, mit_b)

    float max_bar_len = eff_bars * (vp_width_pct / 100.0)

    // ==========================================
    // 4. DRAWING PROFILES, S/R ZONES & START LINE
    // ==========================================
    var vol_boxes = array.new_box()
    var sr_zones = array.new_box()
    var sr_lines = array.new_line()
    var vol_labels = array.new_label()
    var line start_l = na
    var label start_lbl = na

    while array.size(vol_boxes) > 0
        box.delete(array.pop(vol_boxes))
    while array.size(sr_zones) > 0
        box.delete(array.pop(sr_zones))
    while array.size(sr_lines) > 0
        line.delete(array.pop(sr_lines))
    while array.size(vol_labels) > 0
        label.delete(array.pop(vol_labels))
    line.delete(start_l)
    label.delete(start_lbl)

    string start_str = str.format('{0,date,yy/MM/dd HH:mm}', time[eff_bars - 1])
    if show_range
        start_l := line.new(left_bar, top, left_bar, bot, color = color.new(#FFD600, 30), style = line.style_dashed, width = 1, extend = extend.both)
        start_lbl := label.new(left_bar, top, text = 'VP Start: ' + start_str + '\n(' + str.tostring(eff_bars) + ' Bars)', color = color.new(#FFD600, 20), textcolor = color.black, style = label.style_label_down, size = size.small)

    hvn_threshold = max_vol * (hvn_percent / 100.0), lvn_threshold = max_vol * 0.15
    string t_size = text_size_str == 'normal' ? size.normal : text_size_str == 'small' ? size.small : size.tiny
    string l_style = lvn_style_str == 'Solid (실선)' ? line.style_solid : lvn_style_str == 'Dashed (파선)' ? line.style_dashed : line.style_dotted

    for x = 0 to cnum - 1 by 1
        y_top = array.get(levels, x + 1) - dist, y_bot = array.get(levels, x) + dist, mid_y = (y_top + y_bot) / 2
        t_vol = array.get(total_vols, x), d_vol = array.get(delta_vols, x)
        b_vol = array.get(buy_vols, x), s_vol = array.get(sell_vols, x)
        int mit_b = array.get(row_mit_bar, x)
        bool is_mitigated = (use_mitigation and mit_b != -1)

        int trans_tot = int(max_trans - (max_trans - min_trans) * (max_vol == 0 ? 0 : t_vol / max_vol))
        int trans_del = int(max_trans - (max_trans - min_trans) * (max_delta == 0 ? 0 : math.abs(d_vol) / max_delta))
        int trans_buy = int(max_trans - (max_trans - min_trans) * (max_vol == 0 ? 0 : b_vol / max_vol))
        int trans_sel = int(max_trans - (max_trans - min_trans) * (max_vol == 0 ? 0 : s_vol / max_vol))

        string box_text = f_get_row_text(t_vol, d_vol)
        color txt_col = col_mode == 'Auto (Match Buy/Sell Color)' ? d_vol >= 0 ? color.new(color_buy, 0) : color.new(color_sell, 0) : manual_color

        int x_start = (placement == 'Left' ? left_bar : bar_index) + offset
        int x_end = x_start

        if prof_mode == 'Delta (순매수/순매도 차이)'
            int d_len = int(math.round(math.abs(d_vol) * max_bar_len / (max_delta == 0 ? 1 : max_delta)))
            x_end := placement == 'Left' ? x_start + d_len : x_start - d_len
            color base_col = d_vol >= 0 ? color_buy : color_sell
            array.push(vol_boxes, box.new(x_start, y_top, x_end, y_bot, border_width = 0, bgcolor = color.new(base_col, trans_del)))

        else if prof_mode == 'Split (매수/매도 분리)'
            int b_len = int(math.round(b_vol * max_bar_len / max_vol)), s_len = int(math.round(s_vol * max_bar_len / max_vol))
            int b_end = placement == 'Left' ? x_start + b_len : x_start - b_len
            x_end := placement == 'Left' ? b_end + s_len : b_end - s_len
            array.push(vol_boxes, box.new(x_start, y_top, b_end, y_bot, border_width = 0, bgcolor = color.new(color_buy, trans_buy)))
            array.push(vol_boxes, box.new(b_end, y_top, x_end, y_bot, border_width = 0, bgcolor = color.new(color_sell, trans_sel)))

        else // Total (통합 거래량)
            int t_len = int(math.round(t_vol * max_bar_len / max_vol))
            x_end := placement == 'Left' ? x_start + t_len : x_start - t_len
            array.push(vol_boxes, box.new(x_start, y_top, x_end, y_bot, border_width = 0, bgcolor = color.new(color_total, trans_tot)))

        int leftmost_x  = math.min(x_start, x_end), rightmost_x = math.max(x_start, x_end)

        bool hide_zone = (show_only_fresh and is_mitigated) or (mit_style == 'Hide Mitigated (해소된 영역 숨기기)' and is_mitigated)
        int final_end_x = is_mitigated ? math.min(bar_index - mit_b, leftmost_x) : leftmost_x

        if show_hvn and t_vol >= hvn_threshold and not hide_zone
            color zone_color = d_vol >= 0 ? color_hvn_up : color_hvn_dn
            if is_mitigated and mit_style == 'Dim Mitigated (해소된 영역 어둡게)'
                zone_color := color.new(zone_color, 93)
            sr_box = box.new(left_bar, y_top, final_end_x, y_bot, border_width = 0, bgcolor = zone_color)
            array.push(sr_zones, sr_box)

        if show_lvn and t_vol <= lvn_threshold and t_vol > 0 and not hide_zone
            color l_col = lvn_col_mode == 'Auto (Match Delta Color)' ? d_vol >= 0 ? color.new(color_buy, 20) : color.new(color_sell, 20) : color_lvn
            if is_mitigated and mit_style == 'Dim Mitigated (해소된 영역 어둡게)'
                l_col := color.new(l_col, 85)
            lvn_line = line.new(left_bar, mid_y, final_end_x, mid_y, color = l_col, width = lvn_width, style = l_style)
            array.push(sr_lines, lvn_line)

        if show_row_vols and box_text != '' and t_vol > 0 and x != poc
            var label r_lbl = na
            r_lbl := label.new(x = rightmost_x, y = mid_y, text = ' ' + box_text + ' ', xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.white, 100), style = label.style_label_right, textcolor = txt_col, size = t_size)
            array.push(vol_labels, r_lbl)

    // ==========================================
    // 5. POC 라인 및 도킹 라벨 (글자 색상 자동 대비 적용)
    // ==========================================
    poc_level = (array.get(levels, poc) + array.get(levels, poc + 1)) / 2
    poc_total_vol = array.get(total_vols, poc), poc_delta_vol = array.get(delta_vols, poc)
    int poc_mit_b = array.get(row_mit_bar, poc)
    bool poc_mitigated = (use_mitigation and poc_mit_b != -1)

    int base_x = (placement == 'Left' ? left_bar : bar_index) + offset
    int poc_len = int(math.round(poc_total_vol * max_bar_len / (max_vol == 0 ? 1 : max_vol)))
    int poc_right_x = placement == 'Left' ? base_x + poc_len : base_x

    var line poc_line = na
    var label poc_label = na
    line.delete(poc_line)
    label.delete(poc_label)

    bool hide_poc = (show_only_fresh and poc_mitigated) or (mit_style == 'Hide Mitigated (해소된 영역 숨기기)' and poc_mitigated)
    if not hide_poc
        color p_col = poc_mitigated ? poc_mit_color : poc_color
        
        poc_line := line.new(left_bar, poc_level, math.max(bar_index, poc_right_x + 5), poc_level, color = p_col, width = 2, style = line.style_solid)

        delta_sign = poc_delta_vol > 0 ? '+' : ''
        string status_str = poc_mitigated ? '\n[Tested / 해소됨 @ Bar ' + str.tostring(poc_mit_b) + ']' : '\n★ NAKED POC (미체결) ★'
        label_text = 'POC / Max Vol (' + str.tostring(eff_bars) + ' Bars)' + status_str + '\n[' + start_str + ' ~ 현재]\n' + str.tostring(math.round_to_mintick(poc_level)) + '\nVol: ' + format_vol(poc_total_vol) + '\nDelta: ' + delta_sign + format_vol(poc_delta_vol)

        float r_val = color.r(p_col)
        float g_val = color.g(p_col)
        float b_val = color.b(p_col)
        float brightness = (r_val * 299.0 + g_val * 587.0 + b_val * 114.0) / 1000.0
        color poc_txt_col = brightness > 128.0 ? color.black : color.white

        poc_label := label.new(poc_right_x, poc_level, text = label_text, color = p_col, textcolor = poc_txt_col, style = label.style_label_left, size = size.small)