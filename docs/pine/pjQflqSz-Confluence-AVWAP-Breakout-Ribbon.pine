// @version=5
indicator("Confluence AVWAP Breakout Ribbon", overlay=true, max_bars_back=500)

// ───────────────── INPUTS
groupAnch = "⚓ Anchors"
useDay    = input.bool(true,  "Session (Daily)",    group=groupAnch)
useWeek   = input.bool(true,  "Week",               group=groupAnch)
useMonth  = input.bool(true,  "Month",              group=groupAnch)
usePH     = input.bool(true,  "Prior Swing-High",   group=groupAnch)
usePL     = input.bool(true,  "Prior Swing-Low",    group=groupAnch)
pivotLen  = input.int(10,     "Swing Length",       group=groupAnch, minval=2)

groupViz  = "🎨 Visuals"
showRibbon= input.bool(true,  "Show Gradient Ribbon", group=groupViz)
ribbonOpac= input.int(80,     "Ribbon Opacity (%)",  group=groupViz, minval=0, maxval=100, step=5)

// ───────────────── CONSTANTS
price  = hlc3
upCol  = color.new(#00E676, 0)
dnCol  = color.new(#FF3D00, 0)

// ───────────────── TYPE DEFINITION
type VW
    float sumPV
    float sumV
    float vwap

// ───────────────── FUNCTIONS
f_reset(_id) =>
    _id.sumPV := price * volume
    _id.sumV  := volume
    _id.vwap  := _id.sumPV / _id.sumV

f_update(_id) =>
    _id.sumPV += price * volume
    _id.sumV  += volume
    _id.vwap  := _id.sumPV / _id.sumV

// ───────────────── INSTANCE CREATION
var VW dayVW = VW.new(0.0, 0.0, 0.0)
var VW wkVW  = VW.new(0.0, 0.0, 0.0)
var VW moVW  = VW.new(0.0, 0.0, 0.0)
var VW hiVW  = VW.new(0.0, 0.0, 0.0)
var VW loVW  = VW.new(0.0, 0.0, 0.0)

// ───────────────── ANCHOR TRIGGERS
newDay   = ta.change(time("D"))
newWeek  = ta.change(time("W"))
newMonth = ta.change(time("M"))

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

// ───────────────── PER-ANCHOR LOGIC
if useDay
    newDay ? f_reset(dayVW) : f_update(dayVW)
if useWeek
    newWeek ? f_reset(wkVW) : f_update(wkVW)
if useMonth
    newMonth ? f_reset(moVW) : f_update(moVW)

// Swing-High Anchor
if usePH and not na(ph)
    f_reset(hiVW)
else if usePH and hiVW.sumV > 0
    f_update(hiVW)

// Swing-Low Anchor
if usePL and not na(pl)
    f_reset(loVW)
else if usePL and loVW.sumV > 0
    f_update(loVW)

// ───────────────── COLLECT ACTIVE VWAPS
float[] vArr = array.new_float()
if useDay   and dayVW.sumV  > 0
    array.push(vArr, dayVW.vwap)
if useWeek  and wkVW.sumV   > 0
    array.push(vArr, wkVW.vwap)
if useMonth and moVW.sumV   > 0
    array.push(vArr, moVW.vwap)
if usePH    and hiVW.sumV   > 0
    array.push(vArr, hiVW.vwap)
if usePL    and loVW.sumV   > 0
    array.push(vArr, loVW.vwap)

arrOK = array.size(vArr) > 0
top   = arrOK ? array.max(vArr) : na
bot   = arrOK ? array.min(vArr) : na

// ───────────────── PRICING LOGIC
f_all(dir) =>
    bool ok = arrOK
    for i = 0 to array.size(vArr) - 1
        float v = array.get(vArr, i)
        ok := dir == 1 ? (ok and close > v) : dir == -1 ? (ok and close < v) : ok
    ok

isAboveAll  = f_all(1)
isBelowAll  = f_all(-1)
longSignal  = isAboveAll  and not isAboveAll[1]
shortSignal = isBelowAll  and not isBelowAll[1]

// ───────────────── PLOTTING VWAPS
plot(series = useDay   ? dayVW.vwap : na, title = "Daily VWAP", color = color.orange,  linewidth = 2)
plot(series = useWeek  ? wkVW.vwap  : na, title = "Weekly VWAP", color = color.blue,    linewidth = 2)
plot(series = useMonth ? moVW.vwap  : na, title = "Monthly VWAP", color = color.purple,  linewidth = 2)
plot(series = usePH    ? hiVW.vwap  : na, title = "SW-High VWAP", color = color.teal,    linewidth = 2)
plot(series = usePL    ? loVW.vwap  : na, title = "SW-Low VWAP",  color = color.yellow,  linewidth = 2)

// ───────────────── RIBBON
l1   = plot(series = showRibbon and arrOK ? top : na, title = "Ribbon Top", color = upCol)
l2   = plot(series = showRibbon and arrOK ? bot : na, title = "Ribbon Bot", color = dnCol)
rng  = math.max(top - bot, 1e-10)
ratio= showRibbon and arrOK ? math.min(math.max((close - bot) / rng, 0), 1) : na
fill(l1, l2, showRibbon and arrOK ? color.new(color.from_gradient(ratio, 0, 1, dnCol, upCol), ribbonOpac) : na)

// ───────────────── ENTRY SIGNALS
plotshape(series = longSignal,  title = "Long Arrow",  style = shape.arrowup,   location = location.belowbar, color = upCol, size = size.large)
plotshape(series = shortSignal, title = "Short Arrow", style = shape.arrowdown, location = location.abovebar, color = dnCol, size = size.large)

// ───────────────── ALERTS
alertcondition(longSignal,  title = "Long Breakout",  message = "AV-Ribbon Long")
alertcondition(shortSignal, title = "Short Breakout", message = "AV-Ribbon Short")
