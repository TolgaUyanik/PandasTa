library("emaStackCore")

// ═════════════════════════════════════════════════════════════════════════════
// ————— EMA Stack Core Library
// ————— Dedicated library for EMA-based multi-timeframe analysis
// ═════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────
// EMA Core Calculations
// ─────────────────────────────────────────────

// @function Calculate EMA
// @param source Price source (close, hl2, etc.)
// @param length EMA period
// @returns EMA value
export emaCalc(float source, int length) =>
    ta.ema(source, length)

// @function Calculate EMA slope (% change over lookback period)
// @param emaValue Current EMA value
// @param lookback Number of bars to look back
// @returns Slope in percentage
export emaSlope(float emaValue, int lookback) =>
    float emaPrev = emaValue[lookback]
    
    float result = na
    if na(emaPrev) or emaPrev == 0.0
        result := na
    else
        result := (emaValue - emaPrev) / math.abs(emaPrev) * 100.0
    
    result

// @function Calculate distance between 2 EMAs (normalized)
// @param ema1 First EMA value
// @param ema2 Second EMA value
// @param mode Normalization mode ("ATR" or "%")
// @param atrVal ATR value for ATR mode
// @param price Reference price for % mode
// @returns Normalized distance
export emaDist(float ema1, float ema2, string mode, float atrVal, float price) =>
    float dist = math.abs(ema1 - ema2)
    
    float result = na
    if mode == "ATR"
        result := atrVal == 0.0 ? na : dist / atrVal
    else  // mode == "%"
        result := price == 0.0 ? na : dist / price * 100.0
    
    result

// ─────────────────────────────────────────────
// Slope Classification
// ─────────────────────────────────────────────

// @function Classify EMA slope
// @param slope EMA slope in %
// @param thresholdFlat Threshold to consider slope as flat
// @returns +1 (rising), 0 (flat), -1 (falling)
export slopeClass(float slope, float thresholdFlat) =>
    int result = 0
    
    if na(slope)
        result := 0
    else if slope > thresholdFlat
        result := 1
    else if slope < -thresholdFlat
        result := -1
    else
        result := 0
    
    result

// @function Calculate combined slope score for 5 EMAs
// @param slope10 EMA10 slope
// @param slope20 EMA20 slope
// @param slope50 EMA50 slope
// @param slope100 EMA100 slope
// @param slope200 EMA200 slope
// @param threshold Flat threshold
// @returns Sum of slope classes (-5 to +5)
export slopeScore5(float slope10, float slope20, float slope50, float slope100, float slope200, float threshold) =>
    int class10  = slopeClass(slope10, threshold)
    int class20  = slopeClass(slope20, threshold)
    int class50  = slopeClass(slope50, threshold)
    int class100 = slopeClass(slope100, threshold)
    int class200 = slopeClass(slope200, threshold)
    
    class10 + class20 + class50 + class100 + class200

// ─────────────────────────────────────────────
// EMA Stack Classification (5 EMAs: 10/20/50/100/200)
// ─────────────────────────────────────────────

// @function Calculate EMA stack score (5 EMAs)
// @param e10 EMA 10 value
// @param e20 EMA 20 value
// @param e50 EMA 50 value
// @param e100 EMA 100 value
// @param e200 EMA 200 value
// @param tolEq Tolerance for equality (%)
// @returns Stack score (-4 to +4)
export emaStack5Score(
    float e10, 
    float e20, 
    float e50, 
    float e100, 
    float e200,
    float tolEq
) =>
    // Count bullish links (with tolerance)
    bool link1Bull = e10 > e20 * (1 - tolEq/100)   // 10 > 20
    bool link2Bull = e20 > e50 * (1 - tolEq/100)   // 20 > 50
    bool link3Bull = e50 > e100 * (1 - tolEq/100)  // 50 > 100
    bool link4Bull = e100 > e200 * (1 - tolEq/100) // 100 > 200
    
    int bullScore = 0
    if link1Bull
        bullScore += 1
    if link2Bull
        bullScore += 1
    if link3Bull
        bullScore += 1
    if link4Bull
        bullScore += 1
    
    // Count bearish links
    bool link1Bear = e10 < e20 * (1 + tolEq/100)
    bool link2Bear = e20 < e50 * (1 + tolEq/100)
    bool link3Bear = e50 < e100 * (1 + tolEq/100)
    bool link4Bear = e100 < e200 * (1 + tolEq/100)
    
    int bearScore = 0
    if link1Bear
        bearScore += 1
    if link2Bear
        bearScore += 1
    if link3Bear
        bearScore += 1
    if link4Bear
        bearScore += 1
    
    // Final score
    int finalScore = 0
    if bullScore > bearScore
        finalScore := bullScore
    else if bearScore > bullScore
        finalScore := -bearScore
    else
        finalScore := 0
    
    finalScore

// @function Enhanced EMA stack with slope
// @returns [score, slopeScore]
export emaStack5ScoreWithSlope(
    float e10, float e20, float e50, float e100, float e200,
    float slope10, float slope20, float slope50, float slope100, float slope200,
    float tolEq,
    float slopeThreshold
) =>
    int stackScore = emaStack5Score(e10, e20, e50, e100, e200, tolEq)
    int slope_Score = slopeScore5(slope10, slope20, slope50, slope100, slope200, slopeThreshold)
    
    [stackScore, slope_Score]

// ─────────────────────────────────────────────
// Regime Change Detection
// ─────────────────────────────────────────────

// @function Detect regime change in EMA stack
// @param currentScore Current stack score
// @param previousScore Previous stack score
// @param threshold Minimum change to consider significant
// @returns [changed, direction, delta]
export emaRegimeChange(
    int currentScore, 
    int previousScore,
    int threshold
) =>
    int delta = math.abs(currentScore - previousScore)
    bool changed = delta >= threshold
    
    string direction = "NONE"
    if changed
        if currentScore > previousScore
            direction := "BULL"
        else if currentScore < previousScore
            direction := "BEAR"
    
    [changed, direction, delta]

// ─────────────────────────────────────────────
// Compression / Squeeze Detection
// ─────────────────────────────────────────────

// @function Detect EMA compression (squeeze)
// @param e10 EMA 10 value
// @param e20 EMA 20 value
// @param e50 EMA 50 value
// @param e100 EMA 100 value
// @param e200 EMA 200 value
// @param threshold Max spread % to consider compressed
// @returns [compressed, spread]
export emaCompressed(
    float e10, 
    float e20, 
    float e50, 
    float e100, 
    float e200,
    float threshold
) =>
    float emaMax = math.max(e10, math.max(e20, math.max(e50, math.max(e100, e200))))
    float emaMin = math.min(e10, math.min(e20, math.min(e50, math.min(e100, e200))))
    
    float spread = 0.0
    if emaMax != 0.0
        spread := (emaMax - emaMin) / emaMax * 100.0
    
    bool compressed = spread < threshold
    
    [compressed, spread]

// ─────────────────────────────────────────────
// Confluence Analysis (MTF)
// ─────────────────────────────────────────────

// @function Calculate confluence score (how many EMAs are near price)
// @param price Current price
// @param e10_tf1 EMA10 on timeframe 1
// @param e20_tf1 EMA20 on timeframe 1
// @param e50_tf1 EMA50 on timeframe 1
// @param e10_tf2 EMA10 on timeframe 2
// @param e20_tf2 EMA20 on timeframe 2
// @param e50_tf2 EMA50 on timeframe 2
// @param e10_tf3 EMA10 on timeframe 3
// @param e20_tf3 EMA20 on timeframe 3
// @param e50_tf3 EMA50 on timeframe 3
// @param threshold Max distance % to consider "near"
// @returns Confluence count (0-9)
export emaConfluence9(
    float price,
    float e10_tf1, float e20_tf1, float e50_tf1,
    float e10_tf2, float e20_tf2, float e50_tf2,
    float e10_tf3, float e20_tf3, float e50_tf3,
    float threshold
) =>
    int confluenceCount = 0
    
    if price == 0.0
        confluenceCount := 0
    else
        // Timeframe 1
        if math.abs(price - e10_tf1) / price * 100 < threshold
            confluenceCount += 1
        if math.abs(price - e20_tf1) / price * 100 < threshold
            confluenceCount += 1
        if math.abs(price - e50_tf1) / price * 100 < threshold
            confluenceCount += 1
        
        // Timeframe 2
        if math.abs(price - e10_tf2) / price * 100 < threshold
            confluenceCount += 1
        if math.abs(price - e20_tf2) / price * 100 < threshold
            confluenceCount += 1
        if math.abs(price - e50_tf2) / price * 100 < threshold
            confluenceCount += 1
        
        // Timeframe 3
        if math.abs(price - e10_tf3) / price * 100 < threshold
            confluenceCount += 1
        if math.abs(price - e20_tf3) / price * 100 < threshold
            confluenceCount += 1
        if math.abs(price - e50_tf3) / price * 100 < threshold
            confluenceCount += 1
    
    confluenceCount

// @function Simplified confluence for 3 EMAs on single TF
// @returns Confluence count (0-3)
export emaConfluence3(
    float price,
    float e10, 
    float e20, 
    float e50,
    float threshold
) =>
    int confluenceCount = 0
    
    if price != 0.0
        if math.abs(price - e10) / price * 100 < threshold
            confluenceCount += 1
        if math.abs(price - e20) / price * 100 < threshold
            confluenceCount += 1
        if math.abs(price - e50) / price * 100 < threshold
            confluenceCount += 1
    
    confluenceCount

// ─────────────────────────────────────────────
// Lead-Lag Analysis (MTF)
// ─────────────────────────────────────────────

// @function Determine which timeframe is leading the move
// @param score15m Stack score on 15m
// @param score1H Stack score on 1H
// @param score4H Stack score on 4H
// @param lookback Bars to look back for change detection
// @returns Leader timeframe ("15m", "1H", "4H", "ALIGNED", "MIXED")
export emaLeadLag(
    int score15m, 
    int score1H, 
    int score4H,
    int lookback
) =>
    bool changed15m = score15m != score15m[lookback]
    bool changed1H  = score1H != score1H[lookback]
    bool changed4H  = score4H != score4H[lookback]
    
    string leader = "MIXED"
    
    // 15m changed but not 1H/4H → 15m leads
    if changed15m and not changed1H and not changed4H
        leader := "15m"
    
    // 15m and 1H changed but not 4H → 1H leads
    else if changed15m and changed1H and not changed4H
        leader := "1H"
    
    // All changed → 4H leads (macro)
    else if changed15m and changed1H and changed4H
        leader := "4H"
    
    // All aligned (same score) → macro dominance
    else if score15m == score1H and score1H == score4H
        leader := "ALIGNED"
    
    leader

// ─────────────────────────────────────────────
// Price vs EMA Divergence
// ─────────────────────────────────────────────

// @function Detect divergence between price and EMA direction
// @param price Current price
// @param emaValue EMA value (typically EMA20)
// @param lookback Bars to compare
// @returns [divergence, priceChange%, emaChange%]
export emaPriceDivergence(
    float price, 
    float emaValue,
    int lookback
) =>
    float pricePrev = price[lookback]
    float emaPrev = emaValue[lookback]
    
    float priceChange = 0.0
    float emaChange = 0.0
    int divergence = 0
    
    if not na(pricePrev) and pricePrev != 0.0
        priceChange := (price - pricePrev) / math.abs(pricePrev) * 100.0
    
    if not na(emaPrev) and emaPrev != 0.0
        emaChange := (emaValue - emaPrev) / math.abs(emaPrev) * 100.0
    
    // Bullish divergence: price down, EMA up
    bool bullDivergence = priceChange < -0.5 and emaChange > 0.5
    
    // Bearish divergence: price up, EMA down
    bool bearDivergence = priceChange > 0.5 and emaChange < -0.5
    
    if bullDivergence
        divergence := 1
    else if bearDivergence
        divergence := -1
    
    [divergence, priceChange, emaChange]

// ─────────────────────────────────────────────
// EMA Order Strength (distance-weighted)
// ─────────────────────────────────────────────

// @function Calculate EMA order strength (weighted by distance)
// @param e10 EMA 10
// @param e20 EMA 20
// @param e50 EMA 50
// @param e100 EMA 100
// @param e200 EMA 200
// @returns Strength score (higher = stronger trend)
export emaOrderStrength(
    float e10, 
    float e20, 
    float e50, 
    float e100, 
    float e200
) =>
    // Calculate distances between consecutive EMAs
    float d1 = math.abs(e10 - e20)
    float d2 = math.abs(e20 - e50)
    float d3 = math.abs(e50 - e100)
    float d4 = math.abs(e100 - e200)
    
    // Sum of distances (normalized by e200)
    float totalDist = 0.0
    if e200 != 0.0
        totalDist := (d1 + d2 + d3 + d4) / e200 * 100.0
    
    // Higher distance = stronger separation = stronger trend
    totalDist

// ─────────────────────────────────────────────
// EMA Zone Classification (price position)
// ─────────────────────────────────────────────

// @function Determine which EMA zone price is in
// @param price Current price
// @param e10 EMA 10
// @param e20 EMA 20
// @param e50 EMA 50
// @param e100 EMA 100
// @param e200 EMA 200
// @returns Zone code (5=above all, 0=below all, -1=mixed)
export emaPriceZone(
    float price,
    float e10, 
    float e20, 
    float e50, 
    float e100, 
    float e200
) =>
    int zone = 0
    
    if price > e10 and price > e20 and price > e50 and price > e100 and price > e200
        zone := 5  // Above all EMAs
    else if price > e10 and price > e20 and price > e50 and price > e100
        zone := 4  // Above 10/20/50/100
    else if price > e10 and price > e20 and price > e50
        zone := 3  // Above 10/20/50
    else if price > e10 and price > e20
        zone := 2  // Above 10/20
    else if price > e10
        zone := 1  // Above 10 only
    else if price < e10 and price < e20 and price < e50 and price < e100 and price < e200
        zone := -5  // Below all EMAs
    else if price < e10 and price < e20 and price < e50 and price < e100
        zone := -4
    else if price < e10 and price < e20 and price < e50
        zone := -3
    else if price < e10 and price < e20
        zone := -2
    else if price < e10
        zone := -1
    else
        zone := 0  // Mixed (between EMAs)
    
    zone