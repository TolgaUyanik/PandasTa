// ==============================================================================================
// 🟢 REGION: Primary Trend Window Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for scanning the Primary Trend Window to find
//     the strongest completed TradingView HA streak, resolve its tier color,
//     and return optional diagonal-line coordinates from the winning result.
//
// 🧭 EXPORTS:
//     • haPrimaryTrendWinner()    -> Returns the strongest completed HA streak inside the lookback window
//     • haPrimaryTrendTierColor() -> Returns the winning Primary Trend tier color
//     • haPrimaryTrendCoords()    -> Returns diagonal coordinates from the winning streak anchors
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Primary Trend Winner Resolver
// ──────────────────────────────────────────────

// @function Returns the strongest completed HA streak inside the lookback window
// @param lookback Number of bars to scan
// @param haBull Bullish HA state series
// @param haBear Bearish HA state series
// @param bullCount Bullish HA streak-count series
// @param bearCount Bearish HA streak-count series
// @param haHigh HA high series used for wick-based streak measurement
// @param haLow HA low series used for wick-based streak measurement
// @returns Winning streak length, winning direction, winning percent move, winning start bars-ago, winning end bars-ago, winning validity state
export haPrimaryTrendWinner(
     simple int lookback,
     bool haBull,
     bool haBear,
     int bullCount,
     int bearCount,
     float haHigh,
     float haLow) =>

    int winBars =
         math.min(bar_index + 1, lookback)

    int winOldestBA =
         winBars - 1

    int bestLen =
         0

    int bestDir =
         0

    float bestPct =
         na

    int bestEndBA =
         na

    int bestStartBA =
         na

    for endBA = 0 to winOldestBA
        int dir =
             haBull[endBA] ? 1 :
             haBear[endBA] ? -1 :
             0

        if dir != 0
            int fullLen =
                 dir == 1 ? nz(bullCount[endBA]) : nz(bearCount[endBA])

            if fullLen > 0
                int startBA =
                     endBA + fullLen - 1

                bool needPct =
                     fullLen > bestLen or
                     fullLen == bestLen

                float pct =
                     na

                if needPct
                    int scanStartBA =
                         math.min(math.min(startBA, bar_index), 9999)

                    if dir == 1
                        float minLowSoFar =
                             na

                        float bestUp =
                             na

                        for k = scanStartBA to endBA
                            float lo =
                                 haLow[k]

                            float hi =
                                 haHigh[k]

                            minLowSoFar :=
                                 na(minLowSoFar) ? lo : math.min(minLowSoFar, lo)

                            if not na(minLowSoFar) and minLowSoFar != 0.0
                                float up =
                                     (hi - minLowSoFar) / minLowSoFar * 100.0

                                bestUp :=
                                     na(bestUp) ? up : math.max(bestUp, up)

                        pct := bestUp
                    else
                        float maxHighSoFar =
                             na

                        float bestDn =
                             na

                        for k = scanStartBA to endBA
                            float lo =
                                 haLow[k]

                            float hi =
                                 haHigh[k]

                            maxHighSoFar :=
                                 na(maxHighSoFar) ? hi : math.max(maxHighSoFar, hi)

                            if not na(maxHighSoFar) and maxHighSoFar != 0.0
                                float dn =
                                     (maxHighSoFar - lo) / maxHighSoFar * 100.0

                                bestDn :=
                                     na(bestDn) ? dn : math.max(bestDn, dn)

                        pct := bestDn

                bool better =
                     fullLen > bestLen or
                     (fullLen == bestLen and (na(bestPct) or pct > bestPct)) or
                     (fullLen == bestLen and pct == bestPct and endBA < nz(bestEndBA, 1000000))

                if better
                    bestLen := fullLen
                    bestDir := dir
                    bestPct := pct
                    bestEndBA := endBA
                    bestStartBA := startBA

    bool ok =
         bestLen > 0 and
         bestDir != 0 and
         not na(bestStartBA) and
         not na(bestEndBA) and
         bestStartBA >= bestEndBA

    [bestLen, bestDir, bestPct, bestStartBA, bestEndBA, ok]

// ──────────────────────────────────────────────
// 🟦 Subregion: Primary Trend Tier Color Resolver
// ──────────────────────────────────────────────

// @function Returns the winning Primary Trend tier color
// @param dir Winning streak direction: +1 bull, -1 bear, 0 none
// @param streakLen Winning streak length
// @param streakTierBars Number of bars required before advancing to the next tier
// @param bullTier1 Bullish tier 1 color
// @param bullTier2 Bullish tier 2 color
// @param bullTier3 Bullish tier 3 color
// @param bullTier4 Bullish tier 4 color
// @param bearTier1 Bearish tier 1 color
// @param bearTier2 Bearish tier 2 color
// @param bearTier3 Bearish tier 3 color
// @param bearTier4 Bearish tier 4 color
// @param fallbackBg Fallback background when no valid winner exists
// @returns Winning tier color
export haPrimaryTrendTierColor(
     int dir,
     int streakLen,
     simple int streakTierBars,
     color bullTier1,
     color bullTier2,
     color bullTier3,
     color bullTier4,
     color bearTier1,
     color bearTier2,
     color bearTier3,
     color bearTier4,
     color fallbackBg) =>

    dir == 1 ?
         streakLen <= streakTierBars ? bullTier1 :
         streakLen <= streakTierBars * 2 ? bullTier2 :
         streakLen <= streakTierBars * 3 ? bullTier3 :
         bullTier4 :
     dir == -1 ?
         streakLen <= streakTierBars ? bearTier1 :
         streakLen <= streakTierBars * 2 ? bearTier2 :
         streakLen <= streakTierBars * 3 ? bearTier3 :
         bearTier4 :
     fallbackBg

// ──────────────────────────────────────────────
// 🟦 Subregion: Primary Trend Coordinate Resolver
// ──────────────────────────────────────────────

// @function Returns diagonal coordinates from the winning streak anchors
// @param dir Winning streak direction: +1 bull, -1 bear, 0 none
// @param startBA Winning start bars-ago
// @param endBA Winning end bars-ago
// @param highSeries High series used for line anchors
// @param lowSeries Low series used for line anchors
// @returns ok, x1, x2, y1, y2
export haPrimaryTrendCoords(
     int dir,
     int startBA,
     int endBA,
     float highSeries,
     float lowSeries) =>

    bool ok =
         dir != 0 and
         not na(startBA) and
         not na(endBA) and
         startBA >= endBA

    int x1 =
         ok ? bar_index - startBA : na

    int x2 =
         ok ? bar_index - endBA : na

    float y1 =
         ok ? (dir == 1 ? lowSeries[startBA] : highSeries[startBA]) : na

    float y2 =
         ok ? (dir == 1 ? highSeries[endBA] : lowSeries[endBA]) : na

    [ok, x1, x2, y1, y2]

