// ==============================================================================================
// 🟢 REGION: HA Threshold Color Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides HA-facing threshold color logic for centered oscillator outputs.
//
// 🧭 EXPORTS:
//     • haThresholdStateColor() -> Resolves one of six caller-supplied colors
//       from centered oscillator state
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Threshold State Color Resolver
// ──────────────────────────────────────────────

// @function Resolves a visual color from centered-oscillator threshold state
// @param src Source series
// @param upperGuide Upper threshold guide
// @param lowerGuide Lower threshold guide
// @param aboveUpperRiseColor Color used when src is above the upper guide and rising
// @param aboveZeroRiseColor Color used when src is above zero and rising
// @param aboveZeroFallColor Color used when src is above zero and falling
// @param belowZeroFallColor Color used when src is below zero and falling
// @param belowLowerFallColor Color used when src is below the lower guide and falling
// @param belowZeroRiseColor Color used when src is below zero and rising
// @returns Resolved visual color
export haThresholdStateColor(
     float src,
     float upperGuide,
     float lowerGuide,
     color aboveUpperRiseColor,
     color aboveZeroRiseColor,
     color aboveZeroFallColor,
     color belowZeroFallColor,
     color belowLowerFallColor,
     color belowZeroRiseColor) =>

    bool rising =
         src > src[1]

    bool falling =
         src < src[1]

    bool aboveUpper =
         not na(upperGuide) and
         upperGuide > 0 and
         src >= upperGuide

    bool belowLower =
         not na(lowerGuide) and
         lowerGuide < 0 and
         src <= lowerGuide

    aboveUpper and rising ? aboveUpperRiseColor :
     src >= 0 and falling ? aboveZeroFallColor :
     src >= 0 and rising ? aboveZeroRiseColor :
     belowLower and falling ? belowLowerFallColor :
     src < 0 and falling ? belowZeroFallColor :
     belowZeroRiseColor

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// color oscColor = HeikinAshiTrendUtilities.haThresholdStateColor(
//      regOsc,
//      0.40,
//      -0.40,
//      color.orange,
//      color.yellow,
//      color.gray,
//      color.white,
//      color.purple,
//      color.aqua)

// ==============================================================================================
// 🔴 END REGION: HA Threshold Color Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: HA Structure Scan Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for scanning a lookback window to find the
//     strongest completed bullish or bearish move and return its key anchors.
//
// 🧭 EXPORTS:
//     • haScanMaxMove() -> Scans a lookback window and returns the strongest bullish or bearish move
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Max Move Scanner
// ──────────────────────────────────────────────

// @function Scans a lookback window for the strongest upward or downward percentage move
// @param lookback Number of bars to scan
// @param includeCurrentBar Whether bar 0 should be included in the scan
// @param highSeries High series used for upward and downward move detection
// @param lowSeries Low series used for upward and downward move detection
// @returns Winning direction, winning percent move, winning start bars-ago, winning end bars-ago, winning span bars
export haScanMaxMove(
     simple int lookback,
     simple bool includeCurrentBar,
     float highSeries,
     float lowSeries) =>

    int barsAvail =
         math.min(bar_index + 1, math.max(1, lookback))

    int endIdx =
         includeCurrentBar ? 0 : 1

    float bestUpPct = na
    int bestUpStartBA = na
    int bestUpEndBA = na

    float bestDnPct = na
    int bestDnStartBA = na
    int bestDnEndBA = na

    if barsAvail > endIdx
        float minLowSoFar = na
        int minLowBA = na

        float maxHighSoFar = na
        int maxHighBA = na

        for i = barsAvail - 1 to endIdx
            float lo =
                 lowSeries[i]

            float hi =
                 highSeries[i]

            if na(minLowSoFar) or lo < minLowSoFar
                minLowSoFar := lo
                minLowBA := i

            if not na(minLowSoFar) and minLowSoFar != 0.0
                float upPct =
                     (hi - minLowSoFar) / minLowSoFar * 100.0

                bool upBetter =
                     na(bestUpPct) or
                     upPct > bestUpPct or
                     (upPct == bestUpPct and i < nz(bestUpEndBA, 1000000))

                if upBetter
                    bestUpPct := upPct
                    bestUpStartBA := minLowBA
                    bestUpEndBA := i

            if na(maxHighSoFar) or hi > maxHighSoFar
                maxHighSoFar := hi
                maxHighBA := i

            if not na(maxHighSoFar) and maxHighSoFar != 0.0
                float dnPct =
                     (maxHighSoFar - lo) / maxHighSoFar * 100.0

                bool dnBetter =
                     na(bestDnPct) or
                     dnPct > bestDnPct or
                     (dnPct == bestDnPct and i < nz(bestDnEndBA, 1000000))

                if dnBetter
                    bestDnPct := dnPct
                    bestDnStartBA := maxHighBA
                    bestDnEndBA := i

    bool pickUp =
         na(bestDnPct) ? true :
         na(bestUpPct) ? false :
         bestUpPct > bestDnPct ? true :
         bestUpPct < bestDnPct ? false :
         nz(bestUpEndBA, 1000000) < nz(bestDnEndBA, 1000000)

    int dir =
         (na(bestUpPct) and na(bestDnPct)) ? 0 : (pickUp ? 1 : -1)

    float pct =
         dir == 0 ? na : (pickUp ? bestUpPct : bestDnPct)

    int startBA =
         dir == 0 ? na : (pickUp ? bestUpStartBA : bestDnStartBA)

    int endBA =
         dir == 0 ? na : (pickUp ? bestUpEndBA : bestDnEndBA)

    int bars =
         na(startBA) or na(endBA) ? na :
         math.max(1, startBA - endBA + 1)

    [dir, pct, startBA, endBA, bars]

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// [dir, pct, startBA, endBA, bars] = HeikinAshiTrendUtilities.haScanMaxMove(
//      144,
//      true,
//      haHigh,
//      haLow)
//
// bool foundMove =
//      dir != 0
//
// int startX =
//      foundMove ? bar_index - startBA : na
//
// int endX =
//      foundMove ? bar_index - endBA : na

// ==============================================================================================
// 🔴 END REGION: HA Structure Scan Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: HA Streak Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for raw HA streak state, tier-color resolution,
//     and wick-based streak percent movement.
//
// 🧭 EXPORTS:
//     • haStreakState()     -> Resolves raw HA streak state and start offset
//     • haStreakTierColor() -> Resolves active streak-tier color
//     • haStreakPct()       -> Returns wick-based streak percent movement
//

// ──────────────────────────────────────────────
// 🟦 Subregion: HA Streak State Resolver
// ──────────────────────────────────────────────

// @function Resolves raw HA bull/bear state, streak counts, and streak start offset
// @param haOpen Current Heikin Ashi open
// @param haClose Current Heikin Ashi close
// @param bullCountPrev Prior bullish streak count
// @param bearCountPrev Prior bearish streak count
// @returns is HA bullish, is HA bearish, bullish streak count, bearish streak count, current streak length, streak start bars-ago
export haStreakState(
     float haOpen,
     float haClose,
     int bullCountPrev,
     int bearCountPrev) =>

    bool isHaBull =
         not na(haOpen) and not na(haClose) and haClose > haOpen

    bool isHaBear =
         not na(haOpen) and not na(haClose) and haClose <= haOpen

    int bullCount =
         isHaBull ? bullCountPrev + 1 : 0

    int bearCount =
         isHaBear ? bearCountPrev + 1 : 0

    int currStreak =
         isHaBull ? bullCount :
         isHaBear ? bearCount :
         0

    int startBA =
         currStreak > 0 ? currStreak - 1 : na

    [isHaBull, isHaBear, bullCount, bearCount, currStreak, startBA]

// ──────────────────────────────────────────────
// 🟦 Subregion: HA Streak Tier Color Resolver
// ──────────────────────────────────────────────

// @function Returns the active streak-tier color from bull/bear streak counts
// @param isHaBull True when the current HA streak is bullish
// @param isHaBear True when the current HA streak is bearish
// @param bullCount Current bullish streak count
// @param bearCount Current bearish streak count
// @param streakTierBars Number of bars required before advancing to the next tier
// @param bullTier1 Bullish tier 1 color
// @param bullTier2 Bullish tier 2 color
// @param bullTier3 Bullish tier 3 color
// @param bullTier4 Bullish tier 4 color
// @param bearTier1 Bearish tier 1 color
// @param bearTier2 Bearish tier 2 color
// @param bearTier3 Bearish tier 3 color
// @param bearTier4 Bearish tier 4 color
// @param neutralColor Fallback color when no active streak is available
// @returns Active streak-tier color
export haStreakTierColor(
     bool isHaBull,
     bool isHaBear,
     int bullCount,
     int bearCount,
     simple int streakTierBars,
     color bullTier1,
     color bullTier2,
     color bullTier3,
     color bullTier4,
     color bearTier1,
     color bearTier2,
     color bearTier3,
     color bearTier4,
     color neutralColor) =>

    color bullColor =
         bullCount <= streakTierBars ? bullTier1 :
         bullCount <= streakTierBars * 2 ? bullTier2 :
         bullCount <= streakTierBars * 3 ? bullTier3 :
         bullTier4

    color bearColor =
         bearCount <= streakTierBars ? bearTier1 :
         bearCount <= streakTierBars * 2 ? bearTier2 :
         bearCount <= streakTierBars * 3 ? bearTier3 :
         bearTier4

    isHaBull ? bullColor :
     isHaBear ? bearColor :
     neutralColor

// ──────────────────────────────────────────────
// 🟦 Subregion: HA Streak Percent Resolver
// ──────────────────────────────────────────────

// @function Returns the wick-based percent move from the streak start to the current bar
// @param isHaBull True when the current HA streak is bullish
// @param isHaBear True when the current HA streak is bearish
// @param streakBars Current active streak length
// @param highSeries High series used for streak measurement
// @param lowSeries Low series used for streak measurement
// @returns Wick-based streak percent move
export haStreakPct(
     bool isHaBull,
     bool isHaBear,
     int streakBars,
     float highSeries,
     float lowSeries) =>

    int startBA =
         streakBars > 0 ? math.min(math.min(streakBars - 1, bar_index), 9999) : na

    float pct =
         isHaBull and not na(startBA) and lowSeries[startBA] != 0.0 ?
         ((highSeries - lowSeries[startBA]) / lowSeries[startBA]) * 100.0 :
         isHaBear and not na(startBA) and highSeries[startBA] != 0.0 ?
         -((highSeries[startBA] - lowSeries) / highSeries[startBA]) * 100.0 :
         na

    pct

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// [isHaBull, isHaBear, bullCount, bearCount, currStreak, startBA] = HeikinAshiTrendUtilities.haStreakState(
//      haOverlayOpen,
//      haOverlayClose,
//      haBullishCount[1],
//      haBearishCount[1])

// ==============================================================================================
// 🔴 END REGION: HA Streak Helpers
// ==============================================================================================


// ==============================================================================================
// 🟢 REGION: Confirmed HA Trend Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for confirmation-based HA trend state,
//     confirmed trend projection geometry, and confirmed streak percent movement.
//
// 🧭 EXPORTS:
//     • haConfirmedTrendState()      -> Resolves confirmed trend state
//     • haConfirmedTrendProjection() -> Returns confirmed projection geometry
//     • haConfirmedTrendPct()        -> Returns confirmed streak percent movement
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Confirmed Trend State Resolver
// ──────────────────────────────────────────────

// @function Resolves confirmed trend direction, build count, and confirmed start bar
// @param enabled Whether the confirmed-trend engine is active
// @param rawDir Current raw HA direction: +1 bull, -1 bear, 0 neutral
// @param confirmBars Consecutive opposite raw HA bars required to confirm a flip
// @param dirPrev Prior confirmed direction
// @param oppCountPrev Prior opposite-side build count
// @param startBarPrev Prior confirmed trend start bar index
// @param firstOppBarPrev Prior first opposite raw HA bar index
// @returns Confirmed direction, opposite-side build count, confirmed start bar index, first opposite raw HA bar index, confirmed leg bars, confirmed start bars-ago
export haConfirmedTrendState(
     simple bool enabled,
     int rawDir,
     simple int confirmBars,
     int dirPrev,
     int oppCountPrev,
     int startBarPrev,
     int firstOppBarPrev) =>

    int dir =
         dirPrev

    int oppCount =
         oppCountPrev

    int startBarIndex =
         startBarPrev

    int firstOppBarIndex =
         firstOppBarPrev

    if not enabled
        dir := 0
        oppCount := 0
        startBarIndex := na
        firstOppBarIndex := na
    else
        if rawDir != 0
            if dir == 0
                dir := rawDir
                oppCount := 0
                startBarIndex := bar_index
                firstOppBarIndex := na
            else if rawDir == dir
                oppCount := 0
                firstOppBarIndex := na
            else
                oppCount += 1

                if oppCount == 1
                    firstOppBarIndex := bar_index

                if oppCount >= confirmBars
                    dir := rawDir
                    oppCount := 0
                    startBarIndex := firstOppBarIndex
                    firstOppBarIndex := na

    int legBars =
         not na(startBarIndex) ? bar_index - startBarIndex + 1 : na

    int startOffset =
         not na(startBarIndex) ? math.min(bar_index - startBarIndex, bar_index) : na

    [dir, oppCount, startBarIndex, firstOppBarIndex, legBars, startOffset]

// ──────────────────────────────────────────────
// 🟦 Subregion: Confirmed Trend Projection Resolver
// ──────────────────────────────────────────────

// @function Returns confirmed trend projection geometry from body/wick anchor rules
// @param confirmedDir Confirmed direction: +1 bull, -1 bear, 0 neutral
// @param startOffset Confirmed start bars-ago offset
// @param openValue Regular-price open
// @param highValue Regular-price high
// @param lowValue Regular-price low
// @param closeValue Regular-price close
// @param anchorMode Projection anchor mode: "Body" or "Wick"
// @param pathMode Projection path mode: "Same Side" or "Opposite Side"
// @param forwardBars Number of bars forward for projection
// @returns Has valid projection, start Y, current Y, future Y, slope
export haConfirmedTrendProjection(
     int confirmedDir,
     int startOffset,
     float openValue,
     float highValue,
     float lowValue,
     float closeValue,
     simple string anchorMode,
     simple string pathMode,
     simple int forwardBars) =>

    bool useBody =
         anchorMode == "Body"

    bool sameSide =
         pathMode == "Same Side"

    int lb =
         not na(startOffset) ? math.min(math.max(0, startOffset), bar_index) : na

    bool haveBars =
         confirmedDir != 0 and not na(lb)

    float bodyTop =
         math.max(openValue, closeValue)

    float bodyBot =
         math.min(openValue, closeValue)

    float startBodyTop =
         haveBars ? bodyTop[lb] : na

    float startBodyBot =
         haveBars ? bodyBot[lb] : na

    float startHigh =
         haveBars ? highValue[lb] : na

    float startLow =
         haveBars ? lowValue[lb] : na

    float yStart = na
    float yNow = na

    if confirmedDir == 1
        yStart := useBody ? startBodyBot : startLow
        yNow := sameSide ? (useBody ? bodyBot : lowValue) : (useBody ? bodyTop : highValue)
    else if confirmedDir == -1
        yStart := useBody ? startBodyTop : startHigh
        yNow := sameSide ? (useBody ? bodyTop : highValue) : (useBody ? bodyBot : lowValue)

    float denom =
         haveBars ? lb : na

    float slope =
         haveBars and not na(yStart) and not na(yNow) ?
         (denom == 0 ? 0.0 : ((yNow - yStart) / denom)) :
         na

    float yFuture =
         not na(slope) and not na(yNow) ? yNow + slope * forwardBars : na

    [haveBars, yStart, yNow, yFuture, slope]

// ──────────────────────────────────────────────
// 🟦 Subregion: Confirmed Trend Percent Resolver
// ──────────────────────────────────────────────

// @function Returns confirmed streak percent movement from the confirmed start bar
// @param confirmedDir Confirmed direction: +1 bull, -1 bear, 0 neutral
// @param startOffset Confirmed start bars-ago offset
// @param highSeries HA high series used for confirmed move measurement
// @param lowSeries HA low series used for confirmed move measurement
// @returns Confirmed streak percent move
export haConfirmedTrendPct(
     int confirmedDir,
     int startOffset,
     float highSeries,
     float lowSeries) =>

    int lb =
         not na(startOffset) ? math.min(math.min(startOffset, bar_index), 9999) : na

    float startLow =
         not na(lb) ? lowSeries[lb] : na

    float startHigh =
         not na(lb) ? highSeries[lb] : na

    float movePct =
         confirmedDir == 1 and not na(startLow) and startLow != 0.0 ?
         lowSeries < startLow ?
         -((startLow - lowSeries) / startLow) * 100.0 :
         ((highSeries - startLow) / startLow) * 100.0 :
         confirmedDir == -1 and not na(startHigh) and startHigh != 0.0 ?
         highSeries > startHigh ?
         ((highSeries - startHigh) / startHigh) * 100.0 :
         -((startHigh - lowSeries) / startHigh) * 100.0 :
         na

    movePct

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// [confirmDir, confirmOppCount, confirmStartBar, confirmFirstOppBar, confirmLegBars, confirmStartOffset] = HeikinAshiTrendUtilities.haConfirmedTrendState(
//      in_haTrendConfirmDisplay == "Show",
//      rawHaDir,
//      in_haTrendConfirmBars,
//      haTrendConfirmDir[1],
//      haTrendConfirmOppCount[1],
//      haTrendConfirmStartBar[1],
//      haTrendConfirmFirstOppBar[1])

// ==============================================================================================
// 🔴 END REGION: Confirmed HA Trend Helpers
// ==============================================================================================


// ==============================================================================================
// 🟢 REGION: HA Pressure Meter Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for normalizing the HA-driven oscillator into a
//     0-100 Pressure Meter, resolving threshold state, and returning row / strip colors.
//
// 🧭 EXPORTS:
//     • haPressureMeter()      -> Normalizes a raw oscillator value into 0-100
//     • haPressureState()      -> Resolves bull/bear/neutral threshold state
//     • haPressureTierColors() -> Returns tier-based row colors
//     • haPressureStripColor() -> Returns active or neutral strip color
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Pressure Contrast Text Resolver
// ──────────────────────────────────────────────
_haPressureContrastText(color bg) =>
    if na(bg)
        color.white
    else
        float r =
             color.r(bg)

        float g =
             color.g(bg)

        float b =
             color.b(bg)

        float lum =
             0.299 * r + 0.587 * g + 0.114 * b

        lum >= 150 ? #000000 : color.white

// ──────────────────────────────────────────────
// 🟦 Subregion: Pressure Meter Normalizer
// ──────────────────────────────────────────────

// @function Normalizes a raw oscillator value into a 0-100 Pressure Meter
// @param rawOsc Raw oscillator value
// @param bullAnchor Raw oscillator value that should map to 100
// @param bearAnchor Raw oscillator value that should map to 0
// @returns Pressure Meter value in the 0-100 range
export haPressureMeter(
     float rawOsc,
     float bullAnchor,
     float bearAnchor) =>

    float pressureMeterRaw =
         na(rawOsc) or na(bullAnchor) or na(bearAnchor) or bullAnchor == bearAnchor ? na :
         ((rawOsc - bearAnchor) / (bullAnchor - bearAnchor)) * 100.0

    na(pressureMeterRaw) ? na : math.max(0.0, math.min(100.0, pressureMeterRaw))

// ──────────────────────────────────────────────
// 🟦 Subregion: Pressure State Resolver
// ──────────────────────────────────────────────

// @function Resolves bullish, bearish, and neutral threshold state from the Pressure Meter
// @param pressureMeter Normalized Pressure Meter value
// @param bullThreshold Meter level where bullish pressure becomes active
// @param bearThreshold Meter level where bearish pressure becomes active
// @returns Bull-active, bear-active, neutral-between
export haPressureState(
     float pressureMeter,
     float bullThreshold,
     float bearThreshold) =>

    bool bullActive =
         not na(pressureMeter) and pressureMeter >= bullThreshold

    bool bearActive =
         not na(pressureMeter) and pressureMeter <= bearThreshold

    bool neutralBetween =
         not na(pressureMeter) and not bullActive and not bearActive

    [bullActive, bearActive, neutralBetween]

// ──────────────────────────────────────────────
// 🟦 Subregion: Pressure Tier Row Colors
// ──────────────────────────────────────────────

// @function Returns tier-based pressure-row background and readable text color
// @param pressureMeter Normalized Pressure Meter value
// @param bullTier1 Bull tier 1 color
// @param bullTier2 Bull tier 2 color
// @param bullTier3 Bull tier 3 color
// @param bullTier4 Bull tier 4 color
// @param bearTier1 Bear tier 1 color
// @param bearTier2 Bear tier 2 color
// @param bearTier3 Bear tier 3 color
// @param bearTier4 Bear tier 4 color
// @param fallbackBg Fallback background when the meter is na
// @returns Row background color, row text color
export haPressureTierColors(
     float pressureMeter,
     color bullTier1,
     color bullTier2,
     color bullTier3,
     color bullTier4,
     color bearTier1,
     color bearTier2,
     color bearTier3,
     color bearTier4,
     color fallbackBg) =>

    color bg =
         na(pressureMeter) ? fallbackBg :
         pressureMeter >= 87.5 ? bullTier4 :
         pressureMeter >= 75.0 ? bullTier3 :
         pressureMeter >= 62.5 ? bullTier2 :
         pressureMeter >= 50.0 ? bullTier1 :
         pressureMeter <= 12.5 ? bearTier4 :
         pressureMeter <= 25.0 ? bearTier3 :
         pressureMeter <= 37.5 ? bearTier2 :
         bearTier1

    color txt =
         _haPressureContrastText(bg)

    [bg, txt]

// ──────────────────────────────────────────────
// 🟦 Subregion: Pressure Strip Color Resolver
// ──────────────────────────────────────────────

// @function Returns active or neutral strip color from the Pressure Meter state
// @param pressureMeter Normalized Pressure Meter value
// @param bullThreshold Meter level where bullish pressure becomes active
// @param bearThreshold Meter level where bearish pressure becomes active
// @param bullTier1 Bull tier 1 color
// @param bullTier2 Bull tier 2 color
// @param bullTier3 Bull tier 3 color
// @param bullTier4 Bull tier 4 color
// @param bearTier1 Bear tier 1 color
// @param bearTier2 Bear tier 2 color
// @param bearTier3 Bear tier 3 color
// @param bearTier4 Bear tier 4 color
// @param neutralColor Neutral-zone base color
// @param activeTransp Transparency used when bull or bear pressure is active
// @param neutralTransp Transparency used inside the neutral zone
// @returns Strip color
export haPressureStripColor(
     float pressureMeter,
     float bullThreshold,
     float bearThreshold,
     color bullTier1,
     color bullTier2,
     color bullTier3,
     color bullTier4,
     color bearTier1,
     color bearTier2,
     color bearTier3,
     color bearTier4,
     color neutralColor,
     int activeTransp,
     int neutralTransp) =>

    [bullActive, bearActive, neutralBetween] =
         haPressureState(pressureMeter, bullThreshold, bearThreshold)

    [tierBg, _tierTxt] =
         haPressureTierColors(
             pressureMeter,
             bullTier1,
             bullTier2,
             bullTier3,
             bullTier4,
             bearTier1,
             bearTier2,
             bearTier3,
             bearTier4,
             neutralColor)

    color stripColor =
         na(pressureMeter) ? na :
         neutralBetween ? color.new(neutralColor, neutralTransp) :
         color.new(tierBg, activeTransp)

    stripColor

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// float pressureMeter = HeikinAshiTrendUtilities.haPressureMeter(
//      regOsc,
//      OSC_PRESSURE_BULL_ANCHOR,
//      OSC_PRESSURE_BEAR_ANCHOR)

// ==============================================================================================
// 🔴 END REGION: HA Pressure Meter Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Fib Backbone Structure Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for converting a winning Fib Backbone max-move
//     scan into the structure geometry reused by the Backbone diagonal,
//     support/resistance anchors, anchor boxes, and fib levels.
//
// 🧭 EXPORTS:
//     • haFibBackboneStructure() -> Returns backbone coordinates, S/R anchors, and anchor-box geometry
//     • haFibLevelPrice()        -> Returns one fib level price between the backbone anchors
//     • haFibPctFromClose()      -> Returns percent distance from close to a fib level
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Fib Backbone Structure Resolver
// ──────────────────────────────────────────────

// @function Returns backbone coordinates, S/R anchors, and anchor-box geometry
// @param dir Winning move direction: +1 bull, -1 bear, 0 none
// @param startBA Winning move start bars-ago
// @param endBA Winning move end bars-ago
// @param openValue Regular-price open
// @param highValue Regular-price high
// @param lowValue Regular-price low
// @param closeValue Regular-price close
// @returns ok, xStart, xEnd, yStart, yEnd, startIsRes, endIsRes, anchorTopS, anchorBotS, anchorTopE, anchorBotE, isTopS, isTopE
export haFibBackboneStructure(
     int dir,
     int startBA,
     int endBA,
     float openValue,
     float highValue,
     float lowValue,
     float closeValue) =>

    bool ok =
         dir != 0 and
         not na(startBA) and
         not na(endBA) and
         startBA >= endBA

    int xStart =
         ok ? bar_index - startBA : na

    int xEnd =
         ok ? bar_index - endBA : na

    float yStart =
         ok ? (dir == 1 ? lowValue[startBA] : highValue[startBA]) : na

    float yEnd =
         ok ? (dir == 1 ? highValue[endBA] : lowValue[endBA]) : na

    float bodyTopS =
         ok ? math.max(openValue[startBA], closeValue[startBA]) : na

    float bodyBotS =
         ok ? math.min(openValue[startBA], closeValue[startBA]) : na

    float bodyTopE =
         ok ? math.max(openValue[endBA], closeValue[endBA]) : na

    float bodyBotE =
         ok ? math.min(openValue[endBA], closeValue[endBA]) : na

    bool startIsRes =
         ok and dir == -1

    bool endIsRes =
         ok and dir == 1

    float anchorTopS =
         not ok ? na :
         startIsRes ? highValue[startBA] : bodyBotS

    float anchorBotS =
         not ok ? na :
         startIsRes ? bodyTopS : lowValue[startBA]

    float anchorTopE =
         not ok ? na :
         endIsRes ? highValue[endBA] : bodyBotE

    float anchorBotE =
         not ok ? na :
         endIsRes ? bodyTopE : lowValue[endBA]

    float topLevel =
         ok ? math.max(yStart, yEnd) : na

    float botLevel =
         ok ? math.min(yStart, yEnd) : na

    float midS =
         ok ? (anchorTopS + anchorBotS) * 0.5 : na

    float midE =
         ok ? (anchorTopE + anchorBotE) * 0.5 : na

    bool isTopS =
         ok and math.abs(midS - topLevel) <= math.abs(midS - botLevel)

    bool isTopE =
         ok and math.abs(midE - topLevel) <= math.abs(midE - botLevel)

    [ok, xStart, xEnd, yStart, yEnd, startIsRes, endIsRes, anchorTopS, anchorBotS, anchorTopE, anchorBotE, isTopS, isTopE]

// ──────────────────────────────────────────────
// 🟦 Subregion: Fib Level Price Resolver
// ──────────────────────────────────────────────

// @function Returns the price of one fib level between the backbone anchors
// @param yStart Backbone start anchor price
// @param yEnd Backbone end anchor price
// @param fibLevel Fib level such as 0.236, 0.382, 0.50, 0.618, 0.786
// @returns Fib level price
export haFibLevelPrice(
     float yStart,
     float yEnd,
     float fibLevel) =>

    not na(yStart) and not na(yEnd) ?
         yEnd + (yStart - yEnd) * fibLevel :
         na

// ──────────────────────────────────────────────
// 🟦 Subregion: Percent From Close Resolver
// ──────────────────────────────────────────────

// @function Returns percent distance from close to a fib level
// @param closeValue Current close
// @param fibPrice Fib level price
// @returns Percent from close to fib level
export haFibPctFromClose(
     float closeValue,
     float fibPrice) =>

    not na(closeValue) and not na(fibPrice) and fibPrice != 0.0 ?
         ((closeValue - fibPrice) / fibPrice) * 100.0 :
         na

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// [backboneDir, backbonePct, backboneStartBA, backboneEndBA, backboneBars] = HeikinAshiTrendUtilities.haScanMaxMove(
//      in_maxMoveLookback_fib_backbone,
//      in_includeCurrentBarForMaxMove,
//      basePriceHigh,
//      basePriceLow)
//
// [okBackbone, xStartBarFibBackbone, xEndBarFibBackbone, yStartSR_FibBackbone, yEndSR_FibBackbone, startIsRes_FibBackbone, endIsRes_FibBackbone, anchorTopS_FibBackbone, anchorBotS_FibBackbone, anchorTopE_FibBackbone, anchorBotE_FibBackbone, isTopS_FibBackbone, isTopE_FibBackbone] = HeikinAshiTrendUtilities.haFibBackboneStructure(
//      backboneDir,
//      backboneStartBA,
//      backboneEndBA,
//      basePriceOpen,
//      basePriceHigh,
//      basePriceLow,
//      basePriceClose)

// ==============================================================================================
// 🔴 END REGION: Fib Backbone Structure Helpers
// ==============================================================================================


// ==============================================================================================
// 🟢 REGION: Fib Backbone Context Window Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for building the Fib Backbone context window
//     state used by the outline and midpoint visuals.
//
// 🧭 EXPORTS:
//     • haFibContextWindow()   -> Returns the active Fib Backbone context window geometry
//     • haFibContextMidpoint() -> Returns the midpoint of the active context window
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Fib Context Window Geometry Resolver
// ──────────────────────────────────────────────

// @function Returns the active Fib Backbone context window geometry
// @param lookback Context-window lookback length
// @param includeCurrentBar Whether the current bar participates in the active window
// @param sourceMode Source selection. Expected values: "Wicks" or "Closes"
// @param highValue Regular-price high
// @param lowValue Regular-price low
// @param closeValue Regular-price close
// @returns ok, leftX, rightX, windowBars, windowHigh, windowLow, leftHigh, leftLow
export haFibContextWindow(
     simple int lookback,
     simple bool includeCurrentBar,
     simple string sourceMode,
     float highValue,
     float lowValue,
     float closeValue) =>

    float highSrc =
         sourceMode == "Wicks" ? highValue : closeValue

    float lowSrc =
         sourceMode == "Wicks" ? lowValue : closeValue

    int barsInc =
         math.max(1, math.min(bar_index + 1, lookback))

    int barsExc =
         math.max(1, math.min(bar_index, lookback))

    float highInc =
         ta.highest(highSrc, barsInc)

    float lowInc =
         ta.lowest(lowSrc, barsInc)

    float highExc =
         ta.highest(highSrc[1], barsExc)

    float lowExc =
         ta.lowest(lowSrc[1], barsExc)

    int windowBars =
         includeCurrentBar ? barsInc : barsExc

    bool ok =
         includeCurrentBar ? bar_index >= 0 : bar_index >= 1

    float windowHigh =
         includeCurrentBar ? highInc : highExc

    float windowLow =
         includeCurrentBar ? lowInc : lowExc

    int leftX =
         not ok ? na :
         includeCurrentBar ? bar_index - windowBars + 1 :
         bar_index - windowBars

    int rightX =
         not ok ? na :
         includeCurrentBar ? bar_index :
         bar_index - 1

    int leftOffset =
         not ok ? na :
         includeCurrentBar ? windowBars - 1 :
         windowBars

    float leftHigh =
         ok ? highSrc[leftOffset] : na

    float leftLow =
         ok ? lowSrc[leftOffset] : na

    [ok, leftX, rightX, windowBars, windowHigh, windowLow, leftHigh, leftLow]

// ──────────────────────────────────────────────
// 🟦 Subregion: Fib Context Window Midpoint Resolver
// ──────────────────────────────────────────────

// @function Returns the midpoint of the active Fib Backbone context window
// @param ok Whether the context window is valid
// @param windowHigh Active context-window high
// @param windowLow Active context-window low
// @returns Context-window midpoint
export haFibContextMidpoint(
     bool ok,
     float windowHigh,
     float windowLow) =>

    ok ? (windowHigh + windowLow) / 2.0 : na

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// [fibCtxOk, fibCtxLeftX, fibCtxRightX, fibCtxBars, fibCtxHigh, fibCtxLow, fibCtxLeftHigh, fibCtxLeftLow] = HeikinAshiTrendUtilities.haFibContextWindow(
//      in_maxMoveLookback_fib_backbone,
//      in_includeCurrentBarForMaxMove,
//      in_fibBackboneWindowSourceMode,
//      basePriceHigh,
//      basePriceLow,
//      basePriceClose)
