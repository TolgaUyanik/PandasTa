//@version=6
//@description Shared Heikin Ashi helpers for MYNAMEISBRANDON Pine scripts.
library("HeikinAshiTrendUtilities", true)

// ==============================================================================================
// 📚 LIBRARY MAP
// ==============================================================================================
//
// HeikinAshiTrendUtilities is currently organized into the following helper regions:
//
// • Heikin Ashi Core Helpers
// • HA Oscillator Foundation Helpers
// • HA Blend Engine Helpers
// • HA Range Base Engine Helpers
// • HA Threshold Color Helpers
// • HA Structure Scan Helpers
// • HA Streak Helpers
// • Confirmed HA Trend Helpers
// • HA Pressure Meter Helpers
// • Fib Backbone Structure Helpers
// • Fib Backbone Context Window Helpers
// • Primary Trend Window Helpers
//

// ==============================================================================================
// 🟢 REGION: Heikin Ashi Core Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides the core Heikin Ashi calculations reused across Brandon HA scripts.
//
// 🧭 EXPORTS:
//     • heikinAshi()         -> Builds one HA candle from real OHLC and prior HA state
//     • haPredictClose()     -> Estimates the real close needed to flip the current HA candle
//     • smoothedHeikinAshi() -> Builds double-smoothed Heikin Ashi OHLC values
//
// 📎 ATTRIBUTION:
//     Adapted from the open-source Heikin Ashi work by @SimpleCryptoLife.
//     Keep attribution intact when reusing derived open-source work.
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Heikin Ashi Builder
// ──────────────────────────────────────────────

// @function Builds one Heikin Ashi candle from real OHLC and prior HA state
// @param openValue Real open
// @param closeValue Real close
// @param highValue Real high
// @param lowValue Real low
// @param haOpenPrev Prior Heikin Ashi open
// @param haClosePrev Prior Heikin Ashi close
// @returns HA open, HA close, HA high, HA low, is HA up, is HA down
export heikinAshi(
     float openValue,
     float closeValue,
     float highValue,
     float lowValue,
     float haOpenPrev,
     float haClosePrev) =>

    float haOpen =
         barstate.isfirst ? (openValue + closeValue) / 2.0 : (haOpenPrev + haClosePrev) / 2.0

    float haClose =
         (openValue + closeValue + highValue + lowValue) / 4.0

    float haHigh =
         barstate.isfirst ? highValue : math.max(highValue, haOpen, haClose)

    float haLow =
         barstate.isfirst ? lowValue : math.min(lowValue, haOpen, haClose)

    bool isHaUp =
         haClose > haOpen

    bool isHaDown =
         haClose <= haOpen

    [haOpen, haClose, haHigh, haLow, isHaUp, isHaDown]

// ──────────────────────────────────────────────
// 🟦 Subregion: Predictive HA Close Resolver
// ──────────────────────────────────────────────

// @function Estimates the real close price needed to flip the current HA candle
// @param haOpen Current Heikin Ashi open
// @param openValue Real open
// @param highValue Real high
// @param lowValue Real low
// @returns Predicted real close needed to flip the HA candle
export haPredictClose(
     float haOpen,
     float openValue,
     float highValue,
     float lowValue) =>

    float closeInside =
         (4.0 * haOpen) - openValue - highValue - lowValue

    float closeBelow =
         (2.0 * haOpen) - ((openValue + highValue) / 2.0)

    float closeAbove =
         (2.0 * haOpen) - ((openValue + lowValue) / 2.0)

    float closeProjected =
         closeInside > highValue ? closeAbove :
         closeInside < lowValue ? closeBelow :
         closeInside

    closeProjected

// ──────────────────────────────────────────────
// 🟦 Subregion: Smoothed Heikin Ashi Builder
// ──────────────────────────────────────────────

// @function Builds double-smoothed Heikin Ashi values from real OHLC inputs
// @param openValue Real open
// @param highValue Real high
// @param lowValue Real low
// @param closeValue Real close
// @param len1 First EMA smoothing length applied to real OHLC
// @param len2 Second EMA smoothing length applied to HA OHLC
// @returns Smoothed HA open, smoothed HA high, smoothed HA low, smoothed HA close, is smoothed HA up, is smoothed HA down
export smoothedHeikinAshi(
     float openValue,
     float highValue,
     float lowValue,
     float closeValue,
     simple int len1,
     simple int len2) =>

    float o1 =
         ta.ema(openValue, len1)

    float h1 =
         ta.ema(highValue, len1)

    float l1 =
         ta.ema(lowValue, len1)

    float c1 =
         ta.ema(closeValue, len1)

    float haCloseRaw =
         (o1 + h1 + l1 + c1) / 4.0

    var float haOpenRaw = na
    haOpenRaw := na(haOpenRaw[1]) ? (o1 + c1) / 2.0 : (haOpenRaw[1] + haCloseRaw[1]) / 2.0

    float haHighRaw =
         math.max(h1, math.max(haOpenRaw, haCloseRaw))

    float haLowRaw =
         math.min(l1, math.min(haOpenRaw, haCloseRaw))

    float smOpen =
         ta.ema(haOpenRaw, len2)

    float smHigh =
         ta.ema(haHighRaw, len2)

    float smLow =
         ta.ema(haLowRaw, len2)

    float smClose =
         ta.ema(haCloseRaw, len2)

    bool isSmHaUp =
         smClose >= smOpen

    bool isSmHaDown =
         smClose < smOpen

    [smOpen, smHigh, smLow, smClose, isSmHaUp, isSmHaDown]

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// var float haOpen = na
// var float haClose = na
//
// [rHaOpen, rHaClose, rHaHigh, rHaLow, rIsHaUp, rIsHaDown] = HeikinAshiTrendUtilities.heikinAshi(
//      open,
//      close,
//      high,
//      low,
//      haOpen[1],
//      haClose[1])
//
// haOpen := rHaOpen
// haClose := rHaClose
//
// float haFlipClose = HeikinAshiTrendUtilities.haPredictClose(
//      haOpen,
//      open,
//      high,
//      low)
//
// [smHaOpen, smHaHigh, smHaLow, smHaClose, isSmHaUp, isSmHaDown] = HeikinAshiTrendUtilities.smoothedHeikinAshi(
//      open,
//      high,
//      low,
//      close,
//      4,
//      2)

// ==============================================================================================
// 🔴 END REGION: Heikin Ashi Core Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: HA Oscillator Foundation Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for building the prepared HA-signed oscillator
//     foundation used by the HA Range Base and HA Blend engines, plus the
//     matching guide levels used by the threshold-color model.
//
// 🧭 EXPORTS:
//     • haSignedRangePct()    -> Returns the signed HA range-percent foundation
//     • haPreparedOscSource() -> Returns the normalized / optionally clamped HA oscillator source
//     • haOscGuides()         -> Returns upper and lower threshold guides from an oscillator series
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Signed HA Range Foundation
// ──────────────────────────────────────────────

// @function Returns the signed HA range-percent foundation used by the oscillator engine
// @param haHigh Heikin Ashi high
// @param haLow Heikin Ashi low
// @param haClose Heikin Ashi close
// @param haIsBull True when the current HA candle is bullish
// @param haIsBear True when the current HA candle is bearish
// @returns Signed HA range-percent foundation
export haSignedRangePct(
     float haHigh,
     float haLow,
     float haClose,
     bool haIsBull,
     bool haIsBear) =>

    float rangePct =
         not na(haHigh) and not na(haLow) and not na(haClose) and haClose != 0.0 ?
         ((haHigh - haLow) / haClose) * 100.0 :
         0.0

    haIsBull ? rangePct :
     haIsBear ? -rangePct :
     0.0

// ──────────────────────────────────────────────
// 🟦 Subregion: Prepared Oscillator Source
// ──────────────────────────────────────────────

// @function Returns the normalized / optionally clamped HA oscillator source
// @param signedSrc Signed HA foundation
// @param normLen Normalization lookback length
// @param useClamp Whether the normalized result should be clamped
// @param clampRange Absolute clamp boundary when useClamp is true
// @returns Prepared HA oscillator source
export haPreparedOscSource(
     float signedSrc,
     simple int normLen,
     simple bool useClamp,
     float clampRange) =>

    float stdevVal =
         ta.stdev(signedSrc, normLen)

    float zscore =
         stdevVal != 0 ? signedSrc / stdevVal : 0.0

    useClamp ? math.max(math.min(zscore, clampRange), -clampRange) : zscore

// ──────────────────────────────────────────────
// 🟦 Subregion: Oscillator Guide Resolver
// ──────────────────────────────────────────────

// @function Returns upper and lower threshold guides from an oscillator series
// @param src Oscillator series
// @param lookback Guide lookback window
// @param guideFactor Scaling factor applied to the highest/lowest values
// @returns Upper guide, lower guide
export haOscGuides(
     float src,
     simple int lookback,
     float guideFactor = 0.50) =>

    float upperGuide =
         ta.highest(src, lookback) * guideFactor

    float lowerGuide =
         ta.lowest(src, lookback) * guideFactor

    [upperGuide, lowerGuide]

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// float regOscHaSignedBase = HeikinAshiTrendUtilities.haSignedRangePct(
//      r_HAHigh,
//      r_HALow,
//      r_HAClose,
//      r_isHAUp,
//      r_isHADown)
//
// float regOscHaSignedPrepared = HeikinAshiTrendUtilities.haPreparedOscSource(
//      regOscHaSignedBase,
//      regOscNormPeriod,
//      REG_OSC_USE_CLAMP,
//      REG_OSC_CLAMP_RANGE)
//
// [regOscUpperGuide, regOscLowerGuide] = HeikinAshiTrendUtilities.haOscGuides(
//      regOsc,
//      regOscNormPeriod,
//      0.50)

// ==============================================================================================
// 🔴 END REGION: HA Oscillator Foundation Helpers
// ==============================================================================================


// ==============================================================================================
// 🟢 REGION: HA Blend Engine Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for building the HA Blend oscillator engine
//     from the prepared HA signed source, including pair-set selection,
//     pair-stack text, core blend calculation, and optional final smoothing.
//
// 🧭 EXPORTS:
//     • haBlendPairStackText() -> Returns the active EMA pair-stack text
//     • haBlendEngineCore()    -> Returns the raw HA Blend engine core
//     • haBlendEngine()        -> Returns the final HA Blend engine
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Internal Blend MA Selector
// ──────────────────────────────────────────────
_haBlendMa(float src, simple int len, simple string maType) =>
    maType == "SMA" ? ta.sma(src, len) : ta.ema(src, len)

// ──────────────────────────────────────────────
// 🟦 Subregion: Blend Pair-Stack Text Resolver
// ──────────────────────────────────────────────

// @function Returns the active EMA pair-stack text for the selected HA Blend pair set
// @param pairSet Pair-set label. Expected values: "Fast", "Balanced", or "Slow"
// @returns Pair-stack text
export haBlendPairStackText(simple string pairSet) =>
    pairSet == "Fast" ? "5/8 | 8/13 | 13/21 | 21/34" :
     pairSet == "Balanced" ? "13/21 | 21/34 | 34/55 | 55/89" :
     "34/55 | 55/89 | 89/144 | 144/233"

// ──────────────────────────────────────────────
// 🟦 Subregion: Blend Engine Core Builder
// ──────────────────────────────────────────────

// @function Returns the raw HA Blend engine core before final smoothing
// @param src Prepared HA signed source used by the blend engine
// @param pairSet Pair-set label. Expected values: "Fast", "Balanced", or "Slow"
// @returns Raw HA Blend engine core
export haBlendEngineCore(
     float src,
     simple string pairSet) =>

    float ema5 =
         ta.ema(src, 5)

    float ema8 =
         ta.ema(src, 8)

    float ema13 =
         ta.ema(src, 13)

    float ema21 =
         ta.ema(src, 21)

    float ema34 =
         ta.ema(src, 34)

    float ema55 =
         ta.ema(src, 55)

    float ema89 =
         ta.ema(src, 89)

    float ema144 =
         ta.ema(src, 144)

    float ema233 =
         ta.ema(src, 233)

    float pair1 =
         pairSet == "Fast" ? (ema5 + ema8) / 2.0 :
         pairSet == "Balanced" ? (ema13 + ema21) / 2.0 :
         (ema34 + ema55) / 2.0

    float pair2 =
         pairSet == "Fast" ? (ema8 + ema13) / 2.0 :
         pairSet == "Balanced" ? (ema21 + ema34) / 2.0 :
         (ema55 + ema89) / 2.0

    float pair3 =
         pairSet == "Fast" ? (ema13 + ema21) / 2.0 :
         pairSet == "Balanced" ? (ema34 + ema55) / 2.0 :
         (ema89 + ema144) / 2.0

    float pair4 =
         pairSet == "Fast" ? (ema21 + ema34) / 2.0 :
         pairSet == "Balanced" ? (ema55 + ema89) / 2.0 :
         (ema144 + ema233) / 2.0

    (pair1 + pair2 + pair3 + pair4) / 4.0

// ──────────────────────────────────────────────
// 🟦 Subregion: Final Blend Engine Resolver
// ──────────────────────────────────────────────

// @function Returns the final HA Blend engine with optional final smoothing
// @param src Prepared HA signed source used by the blend engine
// @param pairSet Pair-set label. Expected values: "Fast", "Balanced", or "Slow"
// @param useFinalSmooth Whether final smoothing should be applied
// @param finalSmoothLen Final smoothing length
// @param finalSmoothType Final smoothing type. Expected values: "EMA" or "SMA"
// @returns Final HA Blend engine
export haBlendEngine(
     float src,
     simple string pairSet,
     simple bool useFinalSmooth,
     simple int finalSmoothLen,
     simple string finalSmoothType) =>

    float core =
         haBlendEngineCore(src, pairSet)

    useFinalSmooth ? _haBlendMa(core, finalSmoothLen, finalSmoothType) : core

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// string blendPairsTxt = HeikinAshiTrendUtilities.haBlendPairStackText(
//      in_regOscBlendPairSet)
//
// float regOscBlendEngineCore = HeikinAshiTrendUtilities.haBlendEngineCore(
//      regOscHaSignedPrepared,
//      in_regOscBlendPairSet)
//
// float regOscBlendEngine = HeikinAshiTrendUtilities.haBlendEngine(
//      regOscHaSignedPrepared,
//      in_regOscBlendPairSet,
//      in_regOscUseFinalSmooth,
//      in_regOscFinalSmoothLen,
//      in_regOscFinalSmoothType)

// ==============================================================================================
// 🔴 END REGION: HA Blend Engine Helpers
// ==============================================================================================


// ==============================================================================================
// 🟢 REGION: HA Range Base Engine Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable helpers for building the HA Range Base oscillator engine
//     from the prepared HA signed source, including core smoothing and optional
//     final smoothing.
//
// 🧭 EXPORTS:
//     • haRangeEngineCore() -> Returns the raw HA Range Base engine core
//     • haRangeEngine()     -> Returns the final HA Range Base engine
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Internal Range MA Selector
// ──────────────────────────────────────────────
_haRangeMa(float src, simple int len, simple string maType) =>
    maType == "SMA" ? ta.sma(src, len) : ta.ema(src, len)

// ──────────────────────────────────────────────
// 🟦 Subregion: Range Base Engine Core Builder
// ──────────────────────────────────────────────

// @function Returns the raw HA Range Base engine core before final smoothing
// @param src Prepared HA signed source used by the Range Base engine
// @param rangeLen Core smoothing length used by the Range Base engine
// @param rangeMaType Core smoothing type. Expected values: "EMA" or "SMA"
// @returns Raw HA Range Base engine core
export haRangeEngineCore(
     float src,
     simple int rangeLen,
     simple string rangeMaType) =>

    _haRangeMa(src, rangeLen, rangeMaType)

// ──────────────────────────────────────────────
// 🟦 Subregion: Final Range Base Engine Resolver
// ──────────────────────────────────────────────

// @function Returns the final HA Range Base engine with optional final smoothing
// @param src Prepared HA signed source used by the Range Base engine
// @param rangeLen Core smoothing length used by the Range Base engine
// @param rangeMaType Core smoothing type. Expected values: "EMA" or "SMA"
// @param useFinalSmooth Whether final smoothing should be applied
// @param finalSmoothLen Final smoothing length
// @param finalSmoothType Final smoothing type. Expected values: "EMA" or "SMA"
// @returns Final HA Range Base engine
export haRangeEngine(
     float src,
     simple int rangeLen,
     simple string rangeMaType,
     simple bool useFinalSmooth,
     simple int finalSmoothLen,
     simple string finalSmoothType) =>

    float core =
         haRangeEngineCore(src, rangeLen, rangeMaType)

    useFinalSmooth ? _haRangeMa(core, finalSmoothLen, finalSmoothType) : core

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// float regOscRangeEngineCore = HeikinAshiTrendUtilities.haRangeEngineCore(
//      regOscHaSignedPrepared,
//      in_regOscRangeLen,
//      in_regOscRangeMaType)
//
// float regOscRangeEngine = HeikinAshiTrendUtilities.haRangeEngine(
//      regOscHaSignedPrepared,
//      in_regOscRangeLen,
//      in_regOscRangeMaType,
//      in_regOscUseFinalSmooth,
