//@version=5

//Objects and methods that can simplify construction, visualization and management of technical levels
library("Levels",overlay=true)

export type level_info
	string name = ""
	float value = 0
	int bar_num = 0
	line level_line = na
	int line_start_bar = 0
	color level_color = color.black
	bool show = true
	bool ss = false
	bool sr = false  

export type levels_collection
	array<level_info> levels

export method initialize(levels_collection id)=>
	id.levels := array.new<level_info>(0)

method get_level(levels_collection id, int index_=0)=>
	result = id.levels.get(math.min(index_,id.levels.size()-1))
	if na(result)
		result := level_info.new()
	result

method get_level(levels_collection id, string name_)=>
	level_info level = level_info.new("na")
	if id.levels.size()>0
		for k =0 to id.levels.size()-1
			level := id.get_level(k)
			if level.name==name_
				break
	level

method add_level(levels_collection id, level_info level_)=>
	id.levels.unshift(level_)
	if id.levels.size()>10 
		id.levels.pop()

export method create_level(levels_collection id, string name, float value, int level_start_bar, color level_color, bool show)=>
	level_info new_level = level_info.new(name, value, na, na, level_start_bar, level_color, show)
	id.add_level(new_level)

export method set_level(levels_collection id, string name, float value, int level_start_bar, bool show)=>
	level = id.get_level(name)
	level.value := value
	level.line_start_bar := level_start_bar
	level.show := show	


export method find_resistance(levels_collection id)=>
	level_info resistance = level_info.new("na", 999999)
	if id.levels.size()>0
		for k =0 to id.levels.size()-1
			l = id.get_level(k)
			if l.value>close and resistance.value>l.value and l.sr
				resistance := l
	resistance

export method find_support(levels_collection id)=>
	level_info support = level_info.new("na", 0)
	if id.levels.size()>0
		for k =0 to id.levels.size()-1
			l = id.get_level(k)
			if l.value<close and support.value<l.value and l.ss
				support := l
	support

export method draw_level(level_info id)=>
	line.delete(id.level_line)
	id.level_line := line.new(id.line_start_bar, id.value, id.line_start_bar+1, id.value, extend = extend.right, color= id.level_color)	

export method draw_all_levels(levels_collection id)=>
	if id.levels.size()>0
		for k =0 to id.levels.size()-1
			l = id.get_level(k)
			if l.show
				l.draw_level()
