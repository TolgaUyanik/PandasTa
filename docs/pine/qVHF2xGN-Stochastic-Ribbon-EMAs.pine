// @version=5
indicator("Stochastic Ribbon & EMAs", shorttitle="SR + EMAs Line", overlay=true)

// --- Stochastic Ribbon Settings ---
ribbon_group = "Stochastic Ribbon Settings"
showRibbon = input.bool(true, title="Show Stochastic Ribbon", group=ribbon_group)
length = input.int(defval=50, minval=1, title="Length", group=ribbon_group)
start = input.int(defval=1, minval=1, title="Start", group=ribbon_group) 

// --- EMA Settings ---
ema_group = "EMA Settings"
showEMAs = input.bool(true, title="Show EMAs", group=ema_group)
// EMA 1
showEMA1 = input.bool(true, title="", group=ema_group, inline="ema1")
len1 = input.int(20, title="EMA 1", group=ema_group, inline="ema1")
color1 = input.color(color.new(#9932CC, 0), "", group=ema_group, inline="ema1")
// EMA 2
showEMA2 = input.bool(true, title="", group=ema_group, inline="ema2")
len2 = input.int(50, title="EMA 2", group=ema_group, inline="ema2")
color2 = input.color(color.new(#008B8B, 0), "", group=ema_group, inline="ema2")
// EMA 3
showEMA3 = input.bool(true, title="", group=ema_group, inline="ema3")
len3 = input.int(100, title="EMA 3", group=ema_group, inline="ema3")
color3 = input.color(color.new(#B99095, 0), "", group=ema_group, inline="ema3")
// EMA 4
showEMA4 = input.bool(true, title="", group=ema_group, inline="ema4")
len4 = input.int(200, title="EMA 4", group=ema_group, inline="ema4")
color4 = input.color(color.new(#A52A2A, 0), "", group=ema_group, inline="ema4")

// --- Stochastic Line Color (Yellow) ---
stoColor = color.new(color.yellow, 80)

// --- Ribbon Calculation Logic ---
getVal(c, b) =>
    b ? ta.highest(high, c) : ta.lowest(low, c)

count = length * start

// Calculate the 3 specific Stochastic levels: 80%, 50%, 20%
high_val = getVal(count, true)
low_val = getVal(count, false)
range_val = high_val - low_val

// Calculate the 3 Stochastic lines
sto_80 = low_val + (range_val * 0.8)  // 80th percentile
sto_50 = low_val + (range_val * 0.5)  // 50th percentile (middle)
sto_20 = low_val + (range_val * 0.2)  // 20th percentile

// --- EMA Calculation ---
ema1 = ta.ema(close, len1)
ema2 = ta.ema(close, len2)
ema3 = ta.ema(close, len3)
ema4 = ta.ema(close, len4)

// --- PLOTTING (3 Yellow Stochastic Lines) ---
// All 3 lines now use the same yellow color
plot(showRibbon ? sto_80 : na, color=stoColor, title="Stochastic 80%", linewidth=1)
plot(showRibbon ? sto_50 : na, color=stoColor, title="Stochastic 50%", linewidth=1)
plot(showRibbon ? sto_20 : na, color=stoColor, title="Stochastic 20%", linewidth=1)

// EMA plots with updated colors and titles
plot(showEMAs and showEMA1 ? ema1 : na, title="20 day EMA", color=color1, linewidth=1)
plot(showEMAs and showEMA2 ? ema2 : na, title="50 day EMA", color=color2, linewidth=1)
plot(showEMAs and showEMA3 ? ema3 : na, title="100 day EMA", color=color3, linewidth=1)
plot(showEMAs and showEMA4 ? ema4 : na, title="200 day EMA", color=color4, linewidth=1)

// --- Plot Count Summary ---
// Stochastic: 3 lines (80%, 50%, 20%)
// EMAs: 4 lines
// Total: 7 plots (well within 64 limit)