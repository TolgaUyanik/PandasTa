//@version=6
indicator("IFVG DETECTOR V1", shorttitle="IFVG DET V1", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════ INPUTS ═══════
gDet   = "① IFVG Detection"
gTrade = "② SL / TP"
gStyle = "③ Style"
gDash  = "④ Dashboard"

showIFVG      = input.bool(true, "Show IFVG signals", group = gDet)
maxIFVG       = input.int(6, "Max IFVG kept on chart", minval = 1, maxval = 30, group = gDet)
mitigation    = input.string("Wick", "Mitigation trigger", options = ["Wick", "Close"], group = gDet)
breakBuf      = input.float(0.05, "Clean-break buffer (x ATR)", minval = 0.0, step = 0.01, group = gDet)
maxAge        = input.int(80, "Max FVG age (bars)", minval = 5, maxval = 500, group = gDet)
deleteInvalid = input.bool(true, "Delete IFVG when invalidated", group = gDet)

showTrade  = input.bool(true, "Show SL / TP setup", group = gTrade)
rrTarget   = input.int(3, "Take Profit (R)  [1-10]", minval = 1, maxval = 10, group = gTrade)
slBuf      = input.float(0.1, "SL buffer beyond IFVG (x ATR)", minval = 0.0, step = 0.05, group = gTrade)
boxLen     = input.int(6, "TP/SL box length (bars)", minval = 1, maxval = 50, group = gTrade)

labelSize  = input.string("Small", "IFVG label size", options = ["Tiny", "Small", "Normal"], group = gStyle)
bullCol    = input.color(#2962ff, "Bullish (IFVG+)", group = gStyle)
bearCol    = input.color(#ff5252, "Bearish (IFVG-)", group = gStyle)
tpCol      = input.color(#26a69a, "TP", group = gStyle)
slCol      = input.color(#ef5350, "SL", group = gStyle)
entryCol   = input.color(#9598a1, "Entry", group = gStyle)

showDash   = input.bool(true, "Show Dashboard", group = gDash)

labSz = labelSize == "Tiny" ? size.tiny : labelSize == "Normal" ? size.normal : size.small

atrVal = ta.atr(14)
safeAtr = na(atrVal) or atrVal <= 0 ? syminfo.mintick : atrVal

// ═══════ FVG MEMORY ═══════
var array<float> fTop = array.new_float()
var array<float> fBot = array.new_float()
var array<int>   fDir = array.new_int()
var array<int>   fAge = array.new_int()

// ═══════ IFVG VISUALS ═══════
var array<line>  iLine = array.new<line>()
var array<label> iLab  = array.new<label>()
var array<float> iLvl  = array.new_float()
var array<int>   iDir  = array.new_int()

bool newBull = false
bool newBear = false
float sigLvl = na
float sigFar = na
int   sigDir = 0

if array.size(fAge) > 0
    for k = 0 to array.size(fAge) - 1
        array.set(fAge, k, array.get(fAge, k) + 1)
if array.size(fAge) > 0
    for k = array.size(fAge) - 1 to 0
        if array.get(fAge, k) > maxAge
            array.remove(fTop, k)
            array.remove(fBot, k)
            array.remove(fDir, k)
            array.remove(fAge, k)

bullFVG = not na(high[2]) and low > high[2]
bearFVG = not na(low[2]) and high < low[2]
if bullFVG
    array.push(fTop, low)
    array.push(fBot, high[2])
    array.push(fDir, 1)
    array.push(fAge, 0)
if bearFVG
    array.push(fTop, low[2])
    array.push(fBot, high)
    array.push(fDir, -1)
    array.push(fAge, 0)
while array.size(fTop) > 100
    array.shift(fTop)
    array.shift(fBot)
    array.shift(fDir)
    array.shift(fAge)

buf = safeAtr * breakBuf
if array.size(fTop) > 0
    for k = array.size(fTop) - 1 to 0
        t = array.get(fTop, k)
        b = array.get(fBot, k)
        d = array.get(fDir, k)
        brokeUp   = mitigation == "Wick" ? high >= t + buf : close >= t + buf
        brokeDown = mitigation == "Wick" ? low  <= b - buf : close <= b - buf
        bullInv = d == -1 and brokeUp
        bearInv = d == 1 and brokeDown
        if bullInv or bearInv
            newBull := bullInv
            newBear := bearInv
            sigLvl := bullInv ? t : b
            sigFar := bullInv ? b : t
            sigDir := bullInv ? 1 : -1
            array.remove(fTop, k)
            array.remove(fBot, k)
            array.remove(fDir, k)
            array.remove(fAge, k)
            break

// draw new IFVG marker + small label
if showIFVG and (newBull or newBear)
    col = newBull ? bullCol : bearCol
    ln = line.new(bar_index, sigLvl, bar_index + 8, sigLvl, xloc = xloc.bar_index, color = col, width = 1)
    lb = label.new(bar_index + 8, sigLvl, newBull ? "IFVG+" : "IFVG-", xloc = xloc.bar_index, style = label.style_label_left, color = col, textcolor = color.white, size = labSz)
    array.push(iLine, ln)
    array.push(iLab, lb)
    array.push(iLvl, sigLvl)
    array.push(iDir, sigDir)
    if array.size(iLine) > maxIFVG
        line.delete(array.shift(iLine))
        label.delete(array.shift(iLab))
        array.shift(iLvl)
        array.shift(iDir)

// remove IFVGs that price has closed back through (invalidated)
if deleteInvalid and array.size(iLine) > 0
    for k = array.size(iLine) - 1 to 0
        lvl = array.get(iLvl, k)
        d = array.get(iDir, k)
        gone = d == 1 ? close < lvl : close > lvl
        if gone
            line.delete(array.get(iLine, k))
            label.delete(array.get(iLab, k))
            array.remove(iLine, k)
            array.remove(iLab, k)
            array.remove(iLvl, k)
            array.remove(iDir, k)

// keep surviving IFVG markers trailing to the right
if array.size(iLine) > 0
    for k = 0 to array.size(iLine) - 1
        line.set_x2(array.get(iLine, k), bar_index + 8)
        label.set_x(array.get(iLab, k), bar_index + 8)

// ═══════ SL / TP SETUP (IFVG-anchored) ═══════
var bool   tActive = false
var int    tDir    = 0
var int    tBar    = na
var float  tEntry  = na
var float  tSL     = na
var float  tTP     = na
var box    bTP     = na
var box    bSL     = na
var line   lEntry  = na
var label  labTP   = na
var label  labEn   = na
var label  labSL   = na
var int    trades  = 0
var int    wins    = 0
var int    losses  = 0
var string lastRes = "—"

f_clearTrade() =>
    if not na(bTP)
        box.delete(bTP)
    if not na(bSL)
        box.delete(bSL)
    if not na(lEntry)
        line.delete(lEntry)
    if not na(labTP)
        label.delete(labTP)
    if not na(labEn)
        label.delete(labEn)
    if not na(labSL)
        label.delete(labSL)

if showTrade and (newBull or newBear) and not tActive
    f_clearTrade()
    tDir := sigDir
    tEntry := sigLvl
    gapDist = math.abs(sigLvl - sigFar) + safeAtr * slBuf
    risk = math.max(gapDist, safeAtr * 0.25)
    tSL := tDir == 1 ? tEntry - risk : tEntry + risk
    tTP := tDir == 1 ? tEntry + risk * rrTarget : tEntry - risk * rrTarget
    tActive := true
    tBar := bar_index
    trades += 1
    r0 = bar_index + boxLen
    bTP := box.new(bar_index, math.max(tEntry, tTP), r0, math.min(tEntry, tTP), xloc = xloc.bar_index, bgcolor = color.new(tpCol, 82), border_color = color.new(tpCol, 40), border_width = 1)
    bSL := box.new(bar_index, math.max(tEntry, tSL), r0, math.min(tEntry, tSL), xloc = xloc.bar_index, bgcolor = color.new(slCol, 82), border_color = color.new(slCol, 40), border_width = 1)
    lEntry := line.new(bar_index, tEntry, r0, tEntry, xloc = xloc.bar_index, color = entryCol, width = 1, style = line.style_dashed)
    labTP := label.new(r0, tTP, "TP " + str.tostring(rrTarget) + "R", xloc = xloc.bar_index, style = label.style_label_left, color = tpCol, textcolor = color.white, size = size.small)
    labEn := label.new(r0, tEntry, "ENTRY", xloc = xloc.bar_index, style = label.style_label_left, color = entryCol, textcolor = color.black, size = size.small)
    labSL := label.new(r0, tSL, "SL", xloc = xloc.bar_index, style = label.style_label_left, color = slCol, textcolor = color.white, size = size.small)

if tActive
    rExt = math.max(bar_index, tBar + boxLen)
    if not na(bTP)
        box.set_right(bTP, rExt)
        box.set_right(bSL, rExt)
        line.set_x2(lEntry, rExt)
        label.set_x(labTP, rExt)
        label.set_x(labEn, rExt)
        label.set_x(labSL, rExt)
    if bar_index > tBar
        hitSL = tDir == 1 ? low <= tSL : high >= tSL
        hitTP = tDir == 1 ? high >= tTP : low <= tTP
        if hitSL
            losses += 1
            lastRes := "SL"
            tActive := false
        else if hitTP
            wins += 1
            lastRes := "TP"
            tActive := false

// ═══════ DASHBOARD ═══════
winRate = (wins + losses) > 0 ? str.tostring(math.round(wins / (wins + losses) * 100)) + "%" : "—"
statusTxt = tActive ? "ACTIVE" : lastRes == "TP" ? "TP HIT" : lastRes == "SL" ? "SL HIT" : "—"

var table dash = table.new(position.top_right, 2, 8, bgcolor = #0c0e12, border_color = #2a2e39, border_width = 1, frame_color = #2a2e39, frame_width = 1)

f_cell(row, k, v, vc) =>
    table.cell(dash, 0, row, k, text_color = #868993, text_halign = text.align_left, text_size = size.tiny, bgcolor = #0c0e12)
    table.cell(dash, 1, row, v, text_color = vc, text_halign = text.align_right, text_size = size.tiny, bgcolor = #0c0e12)

if showDash and barstate.islast
    table.merge_cells(dash, 0, 0, 1, 0)
    table.cell(dash, 0, 0, "IFVG DETECTOR V1", text_color = color.white, text_size = size.small, bgcolor = #1b1f2a)
    f_cell(1, "Bias", tDir == 1 ? "Bullish" : tDir == -1 ? "Bearish" : "—", tDir == 1 ? bullCol : tDir == -1 ? bearCol : #868993)
    f_cell(2, "Status", statusTxt, tActive ? #26a69a : #868993)
    f_cell(3, "Target", str.tostring(rrTarget) + "R", #d1d4dc)
    f_cell(4, "Entry", na(tEntry) ? "—" : str.tostring(tEntry, format.mintick), #d1d4dc)
    f_cell(5, "SL / TP", (na(tSL) ? "—" : str.tostring(tSL, format.mintick)) + " / " + (na(tTP) ? "—" : str.tostring(tTP, format.mintick)), #d1d4dc)
    f_cell(6, "Trades / W / L", str.tostring(trades) + " / " + str.tostring(wins) + " / " + str.tostring(losses), #d1d4dc)
    f_cell(7, "Win Rate", winRate, #d1d4dc)

// ═══════ ALERTS ═══════
alertcondition(newBull, title = "Bullish IFVG+", message = "IFVG DETECTOR V1 | Bullish IFVG+ on {{ticker}} {{interval}}")
alertcondition(newBear, title = "Bearish IFVG-", message = "IFVG DETECTOR V1 | Bearish IFVG- on {{ticker}} {{interval}}")