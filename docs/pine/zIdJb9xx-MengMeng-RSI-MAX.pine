//@version=6
indicator(title = 'RSI MAX', overlay = true, precision = 2, max_lines_count = 500, max_labels_count = 500)

// === RSI 设置 ===
len = input.int(14, title = 'RSI Length', minval = 1)
uplevel = input.int(70, title = '超买线 (上穿报警)', minval = 1)
downlevel = input.int(30, title = '超卖线 (下穿报警)', minval = 1)

// === 多标的设置（10个）===
group_multi = '多标的跟踪 (最多10个)'
sym1 = input.symbol('', '标的 1', group = group_multi)
sym2 = input.symbol('', '标的 2', group = group_multi)
sym3 = input.symbol('', '标的 3', group = group_multi)
sym4 = input.symbol('', '标的 4', group = group_multi)
sym5 = input.symbol('', '标的 5', group = group_multi)
sym6 = input.symbol('', '标的 6', group = group_multi)
sym7 = input.symbol('', '标的 7', group = group_multi)
sym8 = input.symbol('', '标的 8', group = group_multi)
sym9 = input.symbol('', '标的 9', group = group_multi)
sym10 = input.symbol('', '标的 10', group = group_multi)

// === 颜色设置 ===
color0 = input.color(color.lime, 'Color 0 - RSI > 80', group = '颜色设置')
color1 = input.color(color.green, 'Color 1 - RSI 75-80', group = '颜色设置')
color2 = input.color(color.teal, 'Color 2 - RSI 70-75', group = '颜色设置')
color3 = input.color(color.orange, 'Color 3 - RSI 25-30', group = '颜色设置')
color4 = input.color(color.red, 'Color 4 - RSI 20-25', group = '颜色设置')
color5 = input.color(color.maroon, 'Color 5 - RSI < 20', group = '颜色设置')
color6 = input.color(color.gray, 'Color 6 - 中性', group = '颜色设置')

// === 当前图表 RSI ===
rsi = ta.rsi(close, len)

// === 当前图表 K线染色 ===
bodyColor = rsi > 80 ? color0 : rsi > 75 ? color1 : rsi > uplevel ? color2 : rsi < downlevel and rsi >= 25 ? color3 : rsi < 25 and rsi >= 20 ? color4 : rsi < 20 ? color5 : color6

plotcandle(open, high, low, close, color = bodyColor, wickcolor = bodyColor, bordercolor = bodyColor, title = 'RSI Candle')

// === 获取其他标的 RSI ===
getRSI(sym) =>
    sym == '' ? na : request.security(sym, timeframe.period, ta.rsi(close, len))

rsi1 = getRSI(sym1)
rsi2 = getRSI(sym2)
rsi3 = getRSI(sym3)
rsi4 = getRSI(sym4)
rsi5 = getRSI(sym5)
rsi6 = getRSI(sym6)
rsi7 = getRSI(sym7)
rsi8 = getRSI(sym8)
rsi9 = getRSI(sym9)
rsi10 = getRSI(sym10)

// === 触发逻辑（仅收盘确认 + 记录触发标的）===
isConfirmed = barstate.isconfirmed

bool anySignal = false
string triggerSymbol = na

// 当前图表触发
if isConfirmed and ta.crossover(rsi, uplevel)
    anySignal := true
    triggerSymbol := syminfo.ticker
    triggerSymbol
if isConfirmed and ta.crossunder(rsi, downlevel)
    anySignal := true
    triggerSymbol := syminfo.ticker
    triggerSymbol

// 其他10个标的触发
if isConfirmed and not na(rsi1) and ta.crossover(rsi1, uplevel)
    anySignal := true
    triggerSymbol := sym1
    triggerSymbol
if isConfirmed and not na(rsi1) and ta.crossunder(rsi1, downlevel)
    anySignal := true
    triggerSymbol := sym1
    triggerSymbol

if isConfirmed and not na(rsi2) and ta.crossover(rsi2, uplevel)
    anySignal := true
    triggerSymbol := sym2
    triggerSymbol
if isConfirmed and not na(rsi2) and ta.crossunder(rsi2, downlevel)
    anySignal := true
    triggerSymbol := sym2
    triggerSymbol

if isConfirmed and not na(rsi3) and ta.crossover(rsi3, uplevel)
    anySignal := true
    triggerSymbol := sym3
    triggerSymbol
if isConfirmed and not na(rsi3) and ta.crossunder(rsi3, downlevel)
    anySignal := true
    triggerSymbol := sym3
    triggerSymbol

if isConfirmed and not na(rsi4) and ta.crossover(rsi4, uplevel)
    anySignal := true
    triggerSymbol := sym4
    triggerSymbol
if isConfirmed and not na(rsi4) and ta.crossunder(rsi4, downlevel)
    anySignal := true
    triggerSymbol := sym4
    triggerSymbol

if isConfirmed and not na(rsi5) and ta.crossover(rsi5, uplevel)
    anySignal := true
    triggerSymbol := sym5
    triggerSymbol
if isConfirmed and not na(rsi5) and ta.crossunder(rsi5, downlevel)
    anySignal := true
    triggerSymbol := sym5
    triggerSymbol

if isConfirmed and not na(rsi6) and ta.crossover(rsi6, uplevel)
    anySignal := true
    triggerSymbol := sym6
    triggerSymbol
if isConfirmed and not na(rsi6) and ta.crossunder(rsi6, downlevel)
    anySignal := true
    triggerSymbol := sym6
    triggerSymbol

if isConfirmed and not na(rsi7) and ta.crossover(rsi7, uplevel)
    anySignal := true
    triggerSymbol := sym7
    triggerSymbol
if isConfirmed and not na(rsi7) and ta.crossunder(rsi7, downlevel)
    anySignal := true
    triggerSymbol := sym7
    triggerSymbol

if isConfirmed and not na(rsi8) and ta.crossover(rsi8, uplevel)
    anySignal := true
    triggerSymbol := sym8
    triggerSymbol
if isConfirmed and not na(rsi8) and ta.crossunder(rsi8, downlevel)
    anySignal := true
    triggerSymbol := sym8
    triggerSymbol

if isConfirmed and not na(rsi9) and ta.crossover(rsi9, uplevel)
    anySignal := true
    triggerSymbol := sym9
    triggerSymbol
if isConfirmed and not na(rsi9) and ta.crossunder(rsi9, downlevel)
    anySignal := true
    triggerSymbol := sym9
    triggerSymbol

if isConfirmed and not na(rsi10) and ta.crossover(rsi10, uplevel)
    anySignal := true
    triggerSymbol := sym10
    triggerSymbol
if isConfirmed and not na(rsi10) and ta.crossunder(rsi10, downlevel)
    anySignal := true
    triggerSymbol := sym10
    triggerSymbol

// === 报警 ===
alertcondition(anySignal, title = '10标的上穿70/下穿30 报警', message = '🚨 RSI 极端穿越警报！\n触发标的: {{triggerSymbol}}\n当前图表: {{ticker}}\nRSI值: {{plot("当前 RSI")}}\n时间: {{time}}')

// 数据窗口显示
plot(rsi, '当前 RSI', color = color.purple, display = display.data_window)
