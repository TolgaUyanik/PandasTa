//@version=6

// @description TODO: add library description here
library("DrIdrLibrary", overlay = true)

import tomasz_foltyn/SessionRangeLibrary/2 as SRL

tokyoLineColorInput = input.color(color.new(color.yellow, 0), 'Tokyo line color')
londonLineColorInput = input.color(color.new(color.red, 0), 'London line color')
nyLineColorInput = input.color(color.new(color.blue, 0), 'New york line color')
lineWidthInput = input.int(2, 'Line width')

export enum City
	TOKYO = 'Tokyo'
	LONDON = 'London'
	NEW_YORK = 'New York'

export type DR
	float price
	bool isValid
	bool wasBreachedNow
	City city
	line l

export type Data
	array<DR> pendingDRs
	array<DR> activeDrs

addToPending(SRL.Data srlData, Data data, City city) =>
	data.pendingDRs.push(DR.new(srlData.drh, true, false, city))
	data.pendingDRs.push(DR.new(srlData.drl, true, false, city))
	data.pendingDRs.push(DR.new(srlData.idrh, true, false, city))
	data.pendingDRs.push(DR.new(srlData.idrl, true, false, city))
	data.pendingDRs.push(DR.new(srlData.mid, true, false, city))

movePendingToActiveByCity(Data data, City city) =>
	if(array.size(data.pendingDRs) > 0)
		for i = 0 to array.size(data.pendingDRs) - 1
			dr = array.get(data.pendingDRs, i)
			if(not na(dr) and dr.city == city)
				data.activeDrs.push(dr)
				array.remove(data.pendingDRs, i)

removeInvalidDrs(Data data) =>
	if(array.size(data.activeDrs) > 0)
		for i = 0 to array.size(data.activeDrs) - 1
			dr = array.get(data.activeDrs, i)
			if(not na(dr) and not dr.isValid)
				array.remove(data.activeDrs, i)
				if (not na(dr.l))
					line.delete(dr.l)

validateDrs(Data data) =>
	isGapTime = not na(time('','1700-1805'))
	for dr in data.activeDrs
		if(dr.isValid)
			isBreachedBySameCandle = dr.price < high and dr.price > low
			isBreachedByGap = isGapTime ? false : (dr.price < high[1] and dr.price > low) or (dr.price < high and dr.price > low[1]) 
			if(isBreachedBySameCandle or isBreachedByGap)
				dr.isValid:= false
				dr.wasBreachedNow:= true

updateBreachedDrs(Data data) =>
	for dr in data.activeDrs
		if(dr.wasBreachedNow)
			dr.wasBreachedNow:= false

export update() =>
	var Data data = Data.new()
	if (na(data.pendingDRs))
		data.pendingDRs:= array.new<DR>(0)
		data.activeDrs:= array.new<DR>(0)
	SRL.Data tokyo = SRL.update('1930-2030')
	SRL.Data london = SRL.update('0300-0400')
	SRL.Data newYork = SRL.update('0930-1030')
	tokyoReleaseTime = not na(time('', '0200-0300'))
	londonReleaseTime = not na(time('', '0830-0930'))
	nyReleaseTime = not na(time('', '1600-1700'))
	if(session.isfirstbar_regular)
		removeInvalidDrs(data)
	if (not na(tokyo))
		addToPending(tokyo, data, City.TOKYO)
	if (not na(london))
		addToPending(london, data, City.LONDON)
	if (not na(newYork))
		addToPending(newYork, data, City.NEW_YORK)
	if(tokyoReleaseTime)
		movePendingToActiveByCity(data, City.TOKYO)
	if(londonReleaseTime)
		movePendingToActiveByCity(data, City.LONDON)
	if(nyReleaseTime)
		movePendingToActiveByCity(data, City.NEW_YORK)
	if(session.islastbar_regular)
		movePendingToActiveByCity(data, City.NEW_YORK)
	updateBreachedDrs(data)
	validateDrs(data)
	data.activeDrs

a = update()