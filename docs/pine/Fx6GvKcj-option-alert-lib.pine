//@version=5
library("option_alert_lib", overlay=true)

// @function Constructs and fires a webhook alert message for an option order
// @param symbol Option contract symbol (e.g., C-BTC-90000-310125)
// @param side Order side - "buy" or "sell"
// @param qty Order quantity as string
// @param strategyId Delta Exchange strategy/webhook ID
export fireAlert(string symbol, string side, string qty, string strategyId) =>
    message = '{"symbol":"' + symbol + 
              '","side":"' + side + 
              '","qty":"' + qty + 
              '","trigger_time":"' + str.tostring(timenow) + 
              '","strategy_id":"' + strategyId + '"}'
    alert(message, alert.freq_once_per_bar_close)
