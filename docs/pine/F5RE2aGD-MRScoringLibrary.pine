// MRScoreLib v1.0 — Mean-Reversion Graduated Scoring Library
// ═══════════════════════════════════════════════════════════════
// PURPOSE: Standardised z-score → graduated score (-3 to +3) for
//          any mean-reversion indicator used in SDCA/LTPI/MTPI.
//
// CONVENTION:
//   +3 = deep oversold   → strong ACCUMULATE
//   +2 = oversold
//   +1 = mildly oversold
//    0 = neutral
//   -1 = mildly overbought
//   -2 = overbought
//   -3 = deep overbought → strong DISTRIBUTE
//
// USAGE:
//   import Rafe-Promachos-LLP/MRScoreLib/1 as mrs
//   score = mrs.mrScore(indicator_value, 252, false, false)
//
// NOTES:
// - Works for any indicator that outputs a continuous value.
// - For indicators already outputting z-scores (SOPR Z, Ehlers Z, BB% Z),
//   set alreadyZ=true to skip internal z-scoring.
// - For indicators where HIGH value = oversold (inverted polarity),
//   set invert=true to flip the mapping.
// - Manual/binary inputs (Fear+Greed, MVRV manual) stay as ±1/0 —
//   this library doesn't apply to them.
// ═══════════════════════════════════════════════════════════════

//@version=6
// @description Mean-reversion graduated scoring: z-score any indicator into -3 to +3 integer scale.
library("MRScoringLibrary", overlay=true)

// ╔══════════════════════════════════════════════════════════════╗
// ║                    CORE SCORING FUNCTION                     ║
// ╚══════════════════════════════════════════════════════════════╝
// @function Converts any continuous indicator value into a graduated
//           mean-reversion score from -3 (deep overbought) to +3 (deep oversold).
// @param src       Raw indicator value (or z-score if alreadyZ=true)
// @param lookback  Rolling lookback for z-score calc (ignored if alreadyZ=true)
// @param alreadyZ  True if src is already a z-score — skips internal z-scoring
// @param invert    True if HIGH indicator value = oversold (flips mapping)
// @returns         Integer score: +3 to -3
export mrScore(float src, int lookback, bool alreadyZ, bool invert) =>
    float z = 0.0
    if alreadyZ
        z := nz(src)
    else
        float _m = ta.sma(src, lookback)
        float _s = ta.stdev(src, lookback)
        z := _s != 0 ? (src - _m) / _s : 0.0

    // Flip if indicator polarity is inverted
    if invert
        z := -z

    // Default mapping: low z = oversold = positive score (ACCUM)
    int score = z <= -3.0 ? 3 : z <= -2.0 ? 2 : z <= -1.0 ? 1 : z >= 3.0 ? -3 : z >= 2.0 ? -2 : z >= 1.0 ? -1 : 0
    score

// ╔══════════════════════════════════════════════════════════════╗
// ║                  Z-SCORE UTILITY FUNCTION                    ║
// ╚══════════════════════════════════════════════════════════════╝
// @function Returns the raw z-score without mapping to graduated scale.
//           Useful for plotting or custom threshold logic.
// @param src       Raw indicator value
// @param lookback  Rolling lookback period
// @returns         Float z-score
export zScore(float src, int lookback) =>
    float _m = ta.sma(src, lookback)
    float _s = ta.stdev(src, lookback)
    float z  = _s != 0 ? (src - _m) / _s : 0.0
    z

// ╔══════════════════════════════════════════════════════════════╗
// ║              SCORE WITH CUSTOM SD THRESHOLDS                 ║
// ╚══════════════════════════════════════════════════════════════╝
// @function Same as mrScore but with configurable SD band edges.
//           For indicators where standard 1/2/3 SD bands don't fit well
//           (e.g., an indicator only becomes useful at 1.5 SD).
// @param src       Raw indicator value (or z-score if alreadyZ=true)
// @param lookback  Rolling lookback for z-score calc
// @param alreadyZ  True if src is already a z-score
// @param invert    True if HIGH value = oversold
// @param sd1       Inner band threshold (default would be 1.0)
// @param sd2       Middle band threshold (default would be 2.0)
// @param sd3       Outer band threshold (default would be 3.0)
// @returns         Integer score: +3 to -3
export mrScoreCustom(float src, int lookback, bool alreadyZ, bool invert, float sd1, float sd2, float sd3) =>
    float z = 0.0
    if alreadyZ
        z := nz(src)
    else
        float _m = ta.sma(src, lookback)
        float _s = ta.stdev(src, lookback)
        z := _s != 0 ? (src - _m) / _s : 0.0

    if invert
        z := -z

    int score = z <= -sd3 ? 3 : z <= -sd2 ? 2 : z <= -sd1 ? 1 : z >= sd3 ? -3 : z >= sd2 ? -2 : z >= sd1 ? -1 : 0
    score
