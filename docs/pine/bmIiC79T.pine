//@version=5
strategy("BTC 4H RSI + Bullish Engulfing", overlay=true, initial_capital=10000)

// Inputs
rsiLength = input.int(14, "RSI Length")
rsiOversold = input.int(30, "RSI Oversold")
lookbackVolume = input.int(100, "Volume Lookback")
slBuffer = input.float(0.5, "SL Buffer %")

// RSI
rsi = ta.rsi(close, rsiLength)

// Bullish Engulfing
prevBearish = close[1] < open[1]
currentBullish = close > open

bullishEngulfing =
     prevBearish and
     currentBullish and
     open <= close[1] and
     close >= open[1]

// Oversold Bedingung
oversoldCondition = rsi < rsiOversold

// Einstieg
longSignal = bullishEngulfing and oversoldCondition

// Stop Loss
engulfLow = low
stopLoss = engulfLow * (1 - slBuffer / 100)

// Volume High finden
var float volumeHighPrice = na

highestVol = ta.highest(volume, lookbackVolume)

for i = 0 to lookbackVolume - 1
    if volume[i] == highestVol
        volumeHighPrice := close[i]

// Entry
if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

// Exit
if strategy.position_size > 0

    entryPrice = strategy.position_avg_price

    risk = entryPrice - stopLoss

    minTP = entryPrice + (risk * 2)

    finalTP = na(volumeHighPrice) ? minTP : math.max(volumeHighPrice, minTP)

    strategy.exit(
         "Exit",
         from_entry="Long",
         stop=stopLoss,
         limit=finalTP)

// Visualisierung
plot(volumeHighPrice, color=color.green, linewidth=2, title="Volume Target")

plotshape(
     longSignal,
     title="BUY",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.lime,
     size=size.large)