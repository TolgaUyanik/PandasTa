//@version=6
// =============================================================================
//  Session VWAP Band Candles
//  - Computes the session-anchored VWAP and its ±N standard-deviation band
//  - Recolors the candles by where they sit relative to the 1-deviation band:
//        inside the band  -> white body, black outline
//        above upper band -> green
//        below lower band -> red
//  - Every colour (body / border / wick) for all three states is styleable,
//    as are the VWAP and band lines.
//
//  TIP: the coloured candles are drawn ON TOP of the native ones via
//  plotcandle(). For a perfectly clean look, hide the chart's own candles
//  (chart Settings > Symbol > untick Body / Borders / Wick).
//
//  NOTE: ta.vwap requires volume. Most GER40/DAX feeds provide (tick) volume;
//  if a symbol has none, TradingView will report a "depends on volume" error.
// =============================================================================
indicator("Session VWAP Band Candles", "VWAP Band Candles", overlay=true)

// ===================== INPUTS =====================
gV = "▸ VWAP & Band"
src      = input.source(hlc3,   "VWAP source",        group=gV)
anchorIn = input.string("Session", "Anchor (reset)",  options=["Session","Day","Week","Month","Year"], group=gV, tooltip="When the session VWAP resets. Session = first bar of each regular trading session.")
mult     = input.float(1.0,     "Band deviations",    minval=0.1, step=0.1, group=gV, tooltip="Standard-deviation multiplier. 1.0 = the one-deviation band that drives the colours.")
mode     = input.string("Close","Trigger price",      options=["Close","Full candle"], group=gV, tooltip="Close: colour by the candle's close vs the band. Full candle: green only if the WHOLE candle is above the upper band, red only if the whole candle is below the lower band.")

gShow = "▸ Show"
showCandles = input.bool(true,  "Colour candles",     group=gShow)
showVWAP    = input.bool(true,  "VWAP line",          group=gShow)
showBands   = input.bool(true,  "Band lines",         group=gShow)
fillBands   = input.bool(false, "Shade inside band",  group=gShow)

gIn = "▸ Inside band (within ±1 dev)"
inBody = input.color(color.white, "Body",   group=gIn)
inBord = input.color(color.black, "Border", group=gIn)
inWick = input.color(color.black, "Wick",   group=gIn)

gUp = "▸ Above upper band"
upBody = input.color(#26a69a, "Body",   group=gUp)
upBord = input.color(#1b5e20, "Border", group=gUp)
upWick = input.color(#26a69a, "Wick",   group=gUp)

gDn = "▸ Below lower band"
dnBody = input.color(#ef5350, "Body",   group=gDn)
dnBord = input.color(#b71c1c, "Border", group=gDn)
dnWick = input.color(#ef5350, "Wick",   group=gDn)

gLine = "▸ Line styling"
vwapCol = input.color(#2962ff,            "VWAP colour", group=gLine)
vwapW   = input.int(2, "VWAP width", minval=1, maxval=5, group=gLine)
bandCol = input.color(#2962ff,            "Band colour", group=gLine)
bandW   = input.int(1, "Band width", minval=1, maxval=5, group=gLine)
fillCol = input.color(color.new(#2962ff, 92), "Band fill", group=gLine)

// ===================== ANCHOR =====================
bool isNewPeriod = anchorIn == "Session" ? session.isfirstbar_regular : anchorIn == "Day" ? timeframe.change("D") : anchorIn == "Week" ? timeframe.change("W") : anchorIn == "Month" ? timeframe.change("M") : timeframe.change("12M")

// ===================== VWAP + BAND =====================
[vwapVal, upperBand, lowerBand] = ta.vwap(src, isNewPeriod, mult)

// ===================== STATE =====================
bool isAbove = mode == "Full candle" ? low  > upperBand : close > upperBand
bool isBelow = mode == "Full candle" ? high < lowerBand : close < lowerBand

color bodyCol = isAbove ? upBody : isBelow ? dnBody : inBody
color bordCol = isAbove ? upBord : isBelow ? dnBord : inBord
color wickCol = isAbove ? upWick : isBelow ? dnWick : inWick

// ===================== DRAW =====================
plotcandle(showCandles ? open  : na, showCandles ? high : na, showCandles ? low : na, showCandles ? close : na, title="VWAP Band Candles", color=bodyCol, wickcolor=wickCol, bordercolor=bordCol)

plot(showVWAP ? vwapVal : na, "VWAP", color=vwapCol, linewidth=vwapW)
pU = plot(upperBand, "Upper band", color=showBands ? bandCol : na, linewidth=bandW)
pL = plot(lowerBand, "Lower band", color=showBands ? bandCol : na, linewidth=bandW)
fill(pU, pL, color=fillBands ? fillCol : na, title="Band fill")
