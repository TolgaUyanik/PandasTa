
//@version=6
strategy(
    "Adaptive Multi-Factor Swing Strategy",
    overlay=true,
    margin_long=100,
    margin_short=100,
    calc_on_every_tick=false,
    initial_capital=100000
)

// -----------------------------------------------------
// 0) 유틸 함수
// -----------------------------------------------------
sumN(src, length) =>
    total = 0.0
    for i = 0 to length - 1
        total += nz(src[i], 0)
    total


// -----------------------------------------------------
// 1) 사용자 입력
// -----------------------------------------------------
fast      = input.int(12)
slow      = input.int(26)
sig       = input.int(7)

stochLen  = input.int(14)
stochSig  = input.int(3)
momLen    = input.int(10)
rsiLen    = input.int(7)

rsiLongLimit  = input.int(100)
rsiShortLimit = input.int(30)

psarStart = input.float(0.0)
psarInc   = input.float(0.02)
psarMax   = input.float(0.2)

vortexLen = input.int(8)
dmiLen    = input.int(8)
mfiLen    = input.int(10)

fishLen   = input.int(10)
fishSig   = input.int(6)

longScoreTh   = input.int(4)
longExitTh    = input.int(1)
shortScoreTh  = input.int(-6)
shortExitTh   = input.int(-2)

// 🔴 파산 기준
bankruptPct   = input.float(50.0, "Bankrupt %")

// 🟠 자동 정지
cooldownBars  = input.int(50, "Cooldown Bars")

// 🟡 위험 구간 필터
adxLimit      = input.float(10, "ADX Danger")
atrLen        = input.int(14)


// -----------------------------------------------------
// 2) 지표 계산
// -----------------------------------------------------
macdLine = ta.ema(close, fast) - ta.ema(close, slow)
signal   = ta.ema(macdLine, sig)

k = ta.stoch(high, low, close, stochLen)
d = ta.sma(k, stochSig)

mom = ta.mom(close, momLen)
rsi = ta.rsi(close, rsiLen)

psar = ta.sar(psarStart, psarInc, psarMax)

atr = ta.atr(atrLen)
atrMA = ta.sma(atr, 20)

[plusDI, minusDI, adx] = ta.dmi(dmiLen, dmiLen)

// -----------------------------------------------------
// 3) Vortex
// -----------------------------------------------------
vmPlus  = sumN(math.abs(high - nz(low[1])), vortexLen)
vmMinus = sumN(math.abs(low - nz(high[1])), vortexLen)
trSum   = sumN(ta.tr, vortexLen)

vip = trSum != 0 ? vmPlus / trSum : 0
vim = trSum != 0 ? vmMinus / trSum : 0

// -----------------------------------------------------
// 4) MFI
// -----------------------------------------------------
tp = (high + low + close) / 3
rawMF = tp * volume

posMF = tp > nz(tp[1]) ? rawMF : 0
negMF = tp < nz(tp[1]) ? rawMF : 0

mfi = sumN(negMF, mfiLen) == 0 ? 100 :
      100 - (100 / (1 + sumN(posMF, mfiLen) / sumN(negMF, mfiLen)))

// -----------------------------------------------------
// 5) Fisher
// -----------------------------------------------------
hi = ta.highest(close, fishLen)
lo = ta.lowest(close, fishLen)
v  = hi != lo ? (close - lo) / (hi - lo) : 0.5
v := math.max(math.min(v, 0.999), 0.001)

fish = 0.5 * math.log(v / (1 - v))
fishSigLine = ta.sma(fish, fishSig)

// -----------------------------------------------------
// 6) 점수 합산
// -----------------------------------------------------
score = 0
score += macdLine > signal ? 1 : -1
score += k > d ? 1 : -1
score += mom > 0 ? 1 : -1
score += rsi > 50 ? 1 : -1
score += vip > vim ? 1 : -1
score += plusDI > minusDI ? 1 : -1
score += mfi > 50 ? 1 : -1
score += fish > fishSigLine ? 1 : -1


// -----------------------------------------------------
// 7) 🚨 위험 구간 필터 (핵심)
// -----------------------------------------------------
adxDanger    = adx < adxLimit
atrExplosion = atr > atrMA
chopZone     = adxDanger and atrExplosion

var int stopUntil = na

if chopZone
    stopUntil := bar_index + cooldownBars

tradeAllowed = na(stopUntil) or bar_index > stopUntil


// -----------------------------------------------------
// 8) 💀 파산 로직
// -----------------------------------------------------
bankruptLevel = strategy.initial_capital * bankruptPct / 100
var bool isBankrupt = false

if not isBankrupt and strategy.equity <= bankruptLevel
    isBankrupt := true
    strategy.close_all(comment="BANKRUPT")


// -----------------------------------------------------
// 9) 매매 조건
// -----------------------------------------------------
longEntry  = score >= longScoreTh  and psar < close and rsi < rsiLongLimit
longExit   = score <= longExitTh   or  psar > close

shortEntry = score <= shortScoreTh and psar > close and rsi > rsiShortLimit
shortExit  = score >= shortExitTh  or  psar < close


// -----------------------------------------------------
// 10) 전략 실행 (필터 + 파산 + 스위치)
// -----------------------------------------------------
if longEntry and not isBankrupt and tradeAllowed
    strategy.entry("LONG", strategy.long)

if longExit
    strategy.close("LONG")

if shortEntry and not isBankrupt and tradeAllowed
    strategy.entry("SHORT", strategy.short)

if shortExit
    strategy.close("SHORT")


// -----------------------------------------------------
// 11) 시각화
// -----------------------------------------------------
plot(score, "Score", color=color.blue)
bgcolor(chopZone ? color.new(color.red, 85) : na)
