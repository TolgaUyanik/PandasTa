//@function This method adds trailing stop loss to the current position. “Price” is the trailing stop loss starting level. You can leave price blank if you want it to start immediately 
//@param ticker The ticker symbol of the instrument. Default value is the current chart's ticker (syminfo.ticker).
//@param stopType Specifies the trailing stoploss calculation type. Options: "trailPercent", "trailAmount".
//@param stopValue Stop-loss value based on stopType. Can be a percentage, dollar amount.
//@param price The trailing stop loss starting level. You can leave price blank if you want it to start immediately. Default is current price.
export addTsl(string symbol = syminfo.ticker,string stopType,float stopValue,float price=close) =>
    mes = '{"ticker": ' + '"' + symbol + '",'
    mes += '"action": ' + '"' + "exit" + '"}'
    mes += '"price": ' +  str.tostring(price) + ','
    mes += '"' + stopType + '": ' +   str.tostring(stopValue)
    mes+="}"
    
    mes