// @description This library has methods that provide practical signal transmission for traderpost.Developed By Milvetti
library("Milvetti_TraderPost_Library",true)


getTf(string x) =>
    v = str.tonumber(x)
    result = x
    if result==""
        result:="Chart"    

    if result=="Chart" or result=="1D" or result=="3D" or result=="1W" or result=="1M" or result=="3M" or result=="6M" or result=="12M" or result=="1S" or result=="5S" or result=="10S" or result=="15S" or result=="30S" 
        result :=result
    else if v<60
        result+="m"
    else if v>=60
        mod = v
        mod %= 60
        if mod==0 
            result:= str.tostring(v/60) + "h"
        else
            result+="m"   
    result

error(bool condition,string message)=>
	if condition==false
		runtime.error(message)

//@function This method generates a signal in JSON format that cancels all orders for the specified pair. (If you want to cancel stop loss and takeprofit orders together, use the “exitOrder” method.
//@param ticker The ticker symbol of the instrument. Default value is the current chart's ticker (syminfo.ticker).
export cancelOrders(string symbol = syminfo.ticker) =>
	mes = '{"ticker": ' + '"' + symbol + '",'
    mes += '"action": ' + '"' + "cancel" + '"}' 

//@function This method generates a signal in JSON format that close all orders for the specified pair.
//@param ticker The ticker symbol of the instrument. Default value is the current chart's ticker (syminfo.ticker).
export exitOrders(string symbol = syminfo.ticker) =>
	mes = '{"ticker": ' + '"' + symbol + '",'
    mes += '"action": ' + '"' + "exit" + '"}' 


addslTp(stopType,stopValue,profitType,profitValue)=>
	mes = ""
    if stopValue!=0
        error(stopValue>0,"stopvalue cannot be less than 0")
        error(stopType=="percent" or stopType=="amount" or stopType=="stopPrice" or stopType=="trailAmount" or stopType=="trailPercent","Wrong stopType Parameter")
        
        mes += '"stopLoss": {'
        if stopType=="trailAmount" or stopType=="trailPercent"
            mes += '"type": ' + '"' + "trailing_stop" + '",'
        else 
            mes += '"type": ' + '"' + "stop" + '",'

        mes += '"' + stopType + '": ' +   str.tostring(stopValue)
        mes += '},'

    //TakeProfit Types
    // limitPrice - Absolute limit price calculated on the webhook sender side.
    // percent: Relative percentage take profit to calculate relative to entry price. The entry price for market orders is estimated based on the mid point between the bid and ask on the most recent quote.
    // amount - Relative dollar amount take profit to calculate relative to entry price. The entry price for market orders is estimated based on the mid point between the bid and ask on the most recent quote.
    if profitValue!=0
        error(profitValue>0,"profitValue cannot be less than 0")
        error(profitType=="percent" or profitType=="amount" or profitType=="limitPrice","Wrong profitType Parameter")

        mes += '"takeProfit": {'
        mes += '"' + profitType + '": ' +   str.tostring(profitValue)
        mes += '},'

	mes

addQty(qtyType,qty)=>
    //Qty Types
    // fixed_quantity - A fixed quantity number that is used for the order.
    // dollar_amount - Dynamically calculates a quantity for the given dollar amount.
    // risk_dollar_amount - Dynamically calculates a quantity for the given risk dollar amount. This type requires a stop loss.
    // percent_of_equity - Dynamically calculates a quantity for the given percent of equity.
    // percent_of_position - Dynamically calculates a quantity for the given percent of position.
    mes = ""
    if qty!=0
        error(qty>0,"Qty cannot be less than 0")
        error(qtyType=="fixed_quantity" or qtyType=="dollar_amount" or qtyType=="risk_dollar_amount" or qtyType=="percent_of_equity" or qtyType=="percent_of_position","Wrong QtyType Parameter")

        mes += '"quantityType": ' + '"' + qtyType + '",'
        mes += '"quantity": ' + str.tostring(qty) + ','


//@function This function is designed to send buy or sell orders to traderpost. It can create customized orders by flexibly specifying parameters such as order type, position type, entry price, quantity calculation method, stop-loss, and take-profit. The purpose of the function is to consolidate all necessary details for opening a position into a single structure and present it as a structured JSON output. This format can be sent to trading platforms via webhooks.
//@param ticker The ticker symbol of the instrument. Default value is the current chart's ticker (syminfo.ticker).
//@param positionType Determines the type of order (e.g., "long" or "buy" for buying and "short" or "sell" for selling).
//@param orderType Defines the order type for execution. Options: "market", "limit", "stop". Default is "market"
//@param entryPrice The price level for entry orders. Only applicable for limit or stop orders. Default is 0 (market orders ignore this).
//@param signalPrice Optional. Only necessary when using relative take profit or stop losses, and the broker does not support fetching quotes to perform the calculation. Default is 0
//@param qtyType Determines how the order quantity is calculated. Options: "fixed_quantity", "dollar_amount", "percent_of_equity", "percent_of_position". 
//@param qty Quantity value. Can represent units of shares/contracts or a dollar amount, depending on qtyType.
//@param stopLoss Enable or disable stop-loss functionality. Set to `true` to activate.
//@param stopType Specifies the stop-loss calculation type. Options: "percent", "amount", "stopPrice", "trailPercent", "trailAmount". Default is "stopPrice"
//@param stopValue Stop-loss value based on stopType. Can be a percentage, dollar amount, or a specific stop price. Default is "stopPrice"
//@param takeProfit Enable or disable take-profit functionality. Set to `true` to activate.
//@param profitType Specifies the take-profit calculation type. Options: "percent", "amount", "limitPrice". Default is "limitPrice" 
//@param timeInForce The time in force for your order. Options: day, gtc, opg, cls, ioc and fok 
//@param profitValue Take-profit value based on profitType. Can be a percentage, dollar amount, or a specific limit price. Default is 0
// @returns Return result in Json format.
export createOrder(string ticker=syminfo.ticker, 
 string positionType,
 string orderType="market",
 float entryPrice = 0,
 float signalPrice = 0,
 string qtyType = "fixed_quantity",
 float qty=0,
 string stopType = "stopPrice",
 float stopValue=0,
 string profitType = "limitPrice",
 float profitValue=0,
 string timeInForce = "gtc",
 int delay = 0
 )=>
	side = str.lower(positionType)
    action = switch side
        "long"=> "buy"
        "short" => "sell"
        =>side
    if (action=="buy" or action=="sell" or action=="exit")==false
        runtime.error("Wrong Position Type Parameter: "  + str.tostring(action))

    mes = "{"
    mes += '"ticker": ' + '"' + ticker + '",' 
    mes += '"action": ' + '"' + action + '",' 
	mes += '"orderType": ' + '"' + orderType + '",' 
	
    //Order Types market, limit, stop
    if orderType=="stop"
        mes += '"stopPrice": ' +  str.tostring(entryPrice) + ','

    if orderType=="limit" or orderType=="stop_limit"     
        mes += '"limitPrice": ' +  str.tostring(entryPrice) + ','

    if signalPrice!=0
        mes += '"signalPrice": ' +  str.tostring(signalPrice) + ','

    //Qty
    mes += addQty(qtyType,qty)

    //SL TP
    mes += addslTp(stopType,stopValue,profitType,profitValue)

    // The supported values are day, gtc, opg, cls, ioc and fok.
    // day - Good For Day
    // gtc - Good Until Canceled
    // opg - Market on Open / Limit on Open
    // cls - Market on Close / Limit on Close
    // ioc - Immediate or Cancel
    // fok - Fill or Kill
    if timeInForce!=""
        if (timeInForce=="gtc" or timeInForce=="day" or timeInForce=="opg" or timeInForce=="cls" or timeInForce=="ioc" or timeInForce=="fok")==false
            runtime.error("Wrong timeInForce Parameter: " + str.tostring(timeInForce))
        mes += '"timeInForce": ' + '"' + timeInForce + '",'

    if delay>0
        mes += '"delay": ' +  str.tostring(delay) + ','

    mes += '"time": ' + '"' + str.tostring(timenow) + '"'

    mes+="}"
    
    mes

//@function Market Buy. This function is designed to send buy or sell orders to traderpost. It can create customized orders by flexibly specifying parameters such as order type, position type, entry price, quantity calculation method, stop-loss, and take-profit. The purpose of the function is to consolidate all necessary details for opening a position into a single structure and present it as a structured JSON output. This format can be sent to trading platforms via webhooks.
//@param ticker The ticker symbol of the instrument. Default value is the current chart's ticker (syminfo.ticker).
//@param signalPrice Optional. Only necessary when using relative take profit or stop losses, and the broker does not support fetching quotes to perform the calculation. Default is 0
//@param qtyType Determines how the order quantity is calculated. Options: "fixed_quantity", "dollar_amount", "percent_of_equity", "percent_of_position". 
//@param qty Quantity value. Can represent units of shares/contracts or a dollar amount, depending on qtyType.
//@param stopLoss Enable or disable stop-loss functionality. Set to `true` to activate.
//@param stopType Specifies the stop-loss calculation type. Options: "percent", "amount", "stopPrice", "trailPercent", "trailAmount". Default is "stopPrice"
//@param stopValue Stop-loss value based on stopType. Can be a percentage, dollar amount, or a specific stop price. Default is "stopPrice"
//@param takeProfit Enable or disable take-profit functionality. Set to `true` to activate.
//@param profitType Specifies the take-profit calculation type. Options: "percent", "amount", "limitPrice". Default is "limitPrice" 
//@param timeInForce The time in force for your order. Options: day, gtc, opg, cls, ioc and fok 
//@param profitValue Take-profit value based on profitType. Can be a percentage, dollar amount, or a specific limit price. Default is 0
// @returns Return result in Json format.
export buy(string ticker=syminfo.ticker, 
 float signalPrice = 0,
 string qtyType = "fixed_quantity",
 float qty=0,
 string stopType = "stopPrice",
 float stopValue=0,
 string profitType = "limitPrice",
 float profitValue=0,
 string timeInForce = "gtc"
 )=>
    createOrder(ticker,"buy","market",0,signalPrice,qtyType,qty,stopType,stopValue,profitType,profitValue,timeInForce)

