//@version=6

// @description Kerbal Indicators Shared Library - Breadth Analysis
// This library provides functions for analyzing market breadth indicators including
// Advance/Decline lines, Bullish Percent Index, and breadth divergence detection.
library("kerbal_breadth", overlay = false)

// ============================================
// ADVANCE/DECLINE LINE FUNCTIONS
// ============================================

// @function Get NYSE Advance/Decline line
// @returns NYSE A/D line value
export getAdvDecLine() =>
    request.security("USI:ADLI", timeframe.period, close, barmerge.gaps_on)

// @function Get NYSE Advance/Decline ratio
// @returns NYSE Advance/Decline ratio
export getAdvDecRatio() =>
    // Advances divided by Declines
    request.security("USI:ADD", timeframe.period, close, barmerge.gaps_on)

// @function Calculate A/D line slope (rate of change)
// @param length Period for slope calculation
// @returns A/D line slope (positive = breadth improving, negative = deteriorating)
export advDecSlope(int length = 10) =>
    float ad = getAdvDecLine()
    float adPrev = ad[length]
    ad - adPrev

// @function Detect A/D line divergence with price
// @param priceHigh Recent price high
// @param priceHighBar Bar index of price high
// @param lookback Bars to look back for divergence
// @returns Tuple [bearishDiv, bullishDiv] - true if divergence detected
export advDecDivergence(float priceHigh, int priceHighBar = 0, int lookback = 50) =>
    float ad = getAdvDecLine()
    float adAtPriceHigh = getAdvDecLine()[priceHighBar]
    
    // Find previous price high within lookback
    float prevPriceHigh = priceHigh
    float prevAdHigh = adAtPriceHigh
    
    for i = priceHighBar + 1 to priceHighBar + lookback
        if high[i] >= prevPriceHigh * 0.95  // Within 5% of current high
            prevPriceHigh := high[i]
            prevAdHigh := getAdvDecLine()[i]
    
    // Bearish divergence: Price making new high but A/D is not
    bool bearishDiv = priceHigh > prevPriceHigh and ad < prevAdHigh
    
    // Bullish divergence: Price making new low but A/D is not
    bool bullishDiv = priceHigh < prevPriceHigh and ad > prevAdHigh
    
    [bearishDiv, bullishDiv]

// ============================================
// BULLISH PERCENT INDEX (BPI) FUNCTIONS
// ============================================

// @function Get Bullish Percent Index for NYSE
// @returns NYSE BPI value (0-100 scale)
export getBullishPercentNYSE() =>
    // BPI measures percentage of stocks on P&F buy signals
    request.security("USI:BPNYA", timeframe.period, close, barmerge.gaps_on)

// @function Get Bullish Percent Index for S&P 500
// @returns SPX BPI value (0-100 scale)
export getBullishPercentSPX() =>
    request.security("USI:BPSPX", timeframe.period, close, barmerge.gaps_on)

// @function Get Bullish Percent Index for Nasdaq
// @returns NDX BPI value (0-100 scale)
export getBullishPercentNDX() =>
    request.security("USI:BPNDX", timeframe.period, close, barmerge.gaps_on)

// @function Classify BPI regime
// @param bpi BPI value (0-100)
// @param oversoldThresh Oversold threshold (contrarian bullish)
// @param overboughtThresh Overbought threshold (contrarian bearish)
// @returns Regime: "OVERSOLD", "BULLISH", "NEUTRAL", "BEARISH", "OVERBOUGHT"
export bpiRegime(float bpi, float oversoldThresh = 30.0, float overboughtThresh = 70.0) =>
    string regime = "NEUTRAL"
    
    if bpi < oversoldThresh * 0.7  // Extreme oversold
        regime := "OVERSOLD"
    else if bpi < oversoldThresh
        regime := "BEARISH"
    else if bpi > overboughtThresh * 1.15  // Extreme overbought
        regime := "OVERBOUGHT"
    else if bpi > overboughtThresh
        regime := "BULLISH"
    
    regime

// ============================================
// PERCENTAGE ABOVE MOVING AVERAGE
// ============================================

// @function Get percentage of S&P 500 stocks above their 200-day MA
// @returns Percentage (0-100)
export pctAbove200MA_SPX() =>
    request.security("USI:SPXA200R", timeframe.period, close, barmerge.gaps_on)

// @function Get percentage of S&P 500 stocks above their 50-day MA
// @returns Percentage (0-100)
export pctAbove50MA_SPX() =>
    request.security("USI:SPXA50R", timeframe.period, close, barmerge.gaps_on)

// @function Analyze breadth health based on MA participation
// @param pct200 Percentage above 200-day MA
// @param pct50 Percentage above 50-day MA
// @returns Health assessment: "STRONG", "HEALTHY", "WEAK", "POOR"
export breadthHealth(float pct200, float pct50) =>
    string health = "WEAK"
    
    if pct200 > 70.0 and pct50 > 70.0
        health := "STRONG"
    else if pct200 > 50.0 and pct50 > 50.0
        health := "HEALTHY"
    else if pct200 < 30.0 or pct50 < 30.0
        health := "POOR"
    
    health

// ============================================
// BREADTH THRUST DETECTION
// ============================================

// @function Detect breadth thrust (rapid improvement in breadth)
// @param period Measurement period
// @param threshold Minimum improvement threshold
// @returns True if breadth thrust detected
export breadthThrust(int period = 10, float threshold = 20.0) =>
    float pct50 = pctAbove50MA_SPX()
    float pct50Prev = pct50[period]
    
    // Rapid improvement from low levels
    bool fromLow = pct50Prev < 40.0
    bool rapidRise = (pct50 - pct50Prev) > threshold
    
    fromLow and rapidRise

// ============================================
// COMPOSITE BREADTH SCORING
// ============================================

// @function Calculate composite breadth score
// @param advDecSlope A/D line slope
// @param bpi Bullish Percent Index value
// @param pct200 Percentage above 200-day MA
// @returns Breadth score 0-100 (higher = better breadth)
export breadthScore(float advDecSlope, float bpi, float pct200) =>
    // A/D slope component (0-33 points)
    float adNormalized = math.max(math.min(advDecSlope / 1000.0, 1.0), -1.0)
    float adScore = (adNormalized + 1.0) / 2.0 * 33.33
    
    // BPI component (0-33 points)
    float bpiScore = bpi / 100.0 * 33.33
    
    // % Above 200 MA component (0-33 points)
    float maScore = pct200 / 100.0 * 33.33
    
    adScore + bpiScore + maScore

// @function Get current composite breadth with all data retrieval
// @returns Composite breadth score 0-100
export currentBreadthScore() =>
    float slope = advDecSlope(10)
    float bpi = getBullishPercentSPX()
    float pct200 = pctAbove200MA_SPX()
    breadthScore(slope, bpi, pct200)

// ============================================
// BREADTH DIVERGENCE DETECTION
// ============================================

// @function Detect bearish breadth divergence
// @param priceHigh Current price high
// @param prevPriceHigh Previous price high
// @param currentBreadth Current breadth score
// @param prevBreadth Previous breadth score
// @returns True if bearish divergence (price up, breadth down)
export breadthBearishDivergence(float priceHigh, float prevPriceHigh, float currentBreadth, float prevBreadth) =>
    bool priceHigher = priceHigh > prevPriceHigh
    bool breadthLower = currentBreadth < prevBreadth - 5.0  // 5 point threshold
    priceHigher and breadthLower

// @function Detect bullish breadth divergence
// @param priceLow Current price low
// @param prevPriceLow Previous price low
// @param currentBreadth Current breadth score
// @param prevBreadth Previous breadth score
// @returns True if bullish divergence (price down, breadth up)
export breadthBullishDivergence(float priceLow, float prevPriceLow, float currentBreadth, float prevBreadth) =>
    bool priceLower = priceLow < prevPriceLow
    bool breadthHigher = currentBreadth > prevBreadth + 5.0  // 5 point threshold
    priceLower and breadthHigher

// ============================================
// BREADTH CONFIRMATION FILTERS
// ============================================

// @function Check if breadth confirms bullish price action
// @param breadthScore Current breadth score (0-100)
// @param minScore Minimum acceptable breadth score
// @returns True if breadth is confirming
export breadthConfirmsBullish(float breadthScore, float minScore = 60.0) =>
    breadthScore >= minScore

// @function Check if breadth confirms bearish price action
// @param breadthScore Current breadth score (0-100)
// @param maxScore Maximum acceptable breadth score
// @returns True if breadth is confirming
export breadthConfirmsBearish(float breadthScore, float maxScore = 40.0) =>
    breadthScore <= maxScore

// @function Detect breadth warning signals
// @param breadthScore Current breadth score
// @param priceAction Recent price direction (1 = up, -1 = down, 0 = neutral)
// @returns Tuple [bearishWarning, bullishWarning]
export breadthWarning(float breadthScore, int priceAction) =>
    // Bearish warning: Price rising but breadth weak
    bool bearishWarning = priceAction > 0 and breadthScore < 40.0
    
    // Bullish warning: Price falling but breadth strong
    bool bullishWarning = priceAction < 0 and breadthScore > 60.0
    
    [bearishWarning, bullishWarning]

// ============================================
// MARKET HEALTH ASSESSMENT
// ============================================

// @function Comprehensive market health from breadth indicators
// @param breadthScore Composite breadth score
// @param hasThrust Whether breadth thrust detected
// @param divergenceType Divergence type: 1 = bearish, -1 = bullish, 0 = none
// @returns Health string: "EXCELLENT", "GOOD", "FAIR", "POOR", "WARNING"
export marketHealthFromBreadth(float breadthScore, bool hasThrust, int divergenceType) =>
    string health = "FAIR"
    
    if hasThrust and breadthScore > 70.0
        health := "EXCELLENT"
    else if breadthScore > 65.0 and divergenceType != 1
        health := "GOOD"
    else if breadthScore < 35.0 and divergenceType == 1
        health := "POOR"
    else if divergenceType != 0
        health := "WARNING"
    
    health

// @function Combined sentiment and breadth confirmation
// @param sentimentScore Sentiment score from kerbal_sentiment library (0-100)
// @param breadthScore Breadth score (0-100)
// @returns Tuple [overallHealth, contrarian Signal]
export marketHealth(float sentimentScore, float breadthScore) =>
    // Overall health: Average of both (inverted sentiment since low = fear = contrarian bullish)
    float invertedSentiment = 100.0 - sentimentScore
    float overallHealth = (invertedSentiment + breadthScore) / 2.0
    
    // Contrarian signals: Extreme sentiment + breadth confirmation
    bool contrarianBullish = sentimentScore < 20.0 and breadthScore > 40.0  // Fear + decent breadth
    bool contrarianBearish = sentimentScore > 80.0 and breadthScore < 60.0  // Complacency + weak breadth
    
    string contrarianSignal = "NONE"
    if contrarianBullish
        contrarianSignal := "BULLISH"
    else if contrarianBearish
        contrarianSignal := "BEARISH"
    
    [overallHealth, contrarianSignal]
