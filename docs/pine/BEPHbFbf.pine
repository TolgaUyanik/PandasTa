//@version=5
indicator("SMA 9 vs SMA 20 Highlight", overlay=true)

// Define the SMAs
sma9 = ta.sma(close, 9)
sma20 = ta.sma(close, 20)

// Define color for the area based on crossover
bullish = sma9 > sma20
bearish = sma9 < sma20

areaColor = bullish ? color.new(color.green, 80) : bearish ? color.new(color.red, 80) : na

// Fill the area between the SMAs
plot_sma9 = plot(sma9, title="SMA 9", color=color.green, linewidth=1)
plot_sma20 = plot(sma20, title="SMA 20", color=color.red, linewidth=1)

fill(plot_sma9, plot_sma20, color=areaColor, title="SMA Area Highlight")