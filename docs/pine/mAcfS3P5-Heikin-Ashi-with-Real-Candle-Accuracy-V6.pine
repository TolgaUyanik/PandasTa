//@version=6
indicator("Heikin-Ashi with Real Candle Accuracy V6", overlay=true)

// 1. Calculate standard Heikin-Ashi values in the background
ha_close = (open + high + low + close) / 4

// Initialize ha_open using a persistent variable
var float ha_open = na
ha_open := na(ha_open[1]) ? (open + close) / 2 : (ha_open[1] + ha_close[1]) / 2

// Find the highest high and lowest low for the HA candle
ha_high = math.max(high, math.max(ha_open, ha_close))
ha_low  = math.min(low, math.min(ha_open, ha_close))

// 2. Determine color based on Heikin-Ashi trend direction
ha_color = ha_close >= ha_open ? color.green : color.red

// 3. Plot the ACTUAL standard candles using real OHLC, colored by Heikin-Ashi
plotcandle(open, high, low, close, title="Real Candles with HA Color", color=ha_color, wickcolor=ha_color, bordercolor=ha_color)