//@version=6  
library("SessionVolumeProfile", overlay=true)  

// Exported UDT to hold profile levels  
//@type Volume profile levels from a session.  
export type VolumeProfile  
    float poc  
    float vah  
    float val  
    float totalVolume  

// Core function: calculate profile from high/low/volume arrays (lower TF data ideal)  
//@function Computes POC, VAL, VAH for 70% VA using 24 price rows.  
//@param highs Series of highs.  
//@param lows Series of lows.  
//@param volumes Series of volumes.  
//@param rows simple int Number of price bins (default 24).  
//@returns VolumeProfile object.  
export calcProfile(array<float> highs, array<float> lows, array<float> volumes, simple int rows = 24) =>  
    if array.size(highs) == 0  
        VolumeProfile.new(na, na, na, 0.0)  
    else  
        float sessionHigh = array.max(highs)  
        float sessionLow = array.min(lows)  
        float rowSize = (sessionHigh - sessionLow) / rows  
        if rowSize <= 0  
            VolumeProfile.new(na, na, na, 0.0)  
        else  
            array<float> rowVolumes = array.new<float>(rows, 0.0)  
            // Distribute volume to rows  
            for i = 0 to array.size(highs) - 1  
                float h = array.get(highs, i)  
                float l = array.get(lows, i)  
                float v = array.get(volumes, i)  
                int startRow = math.floor((h - sessionLow) / rowSize)  
                int endRow = math.floor((l - sessionLow) / rowSize)  
                float vPerRow = v / math.max((endRow - startRow + 1), 1)  
                for j = math.min(startRow, endRow) to math.max(startRow, endRow)  
                    if j >= 0 and j < rows  
                        array.set(rowVolumes, j, array.get(rowVolumes, j) + vPerRow)  
            // Find POC (max volume row)  
            int pocRow = 0  
            float maxVol = 0.0  
            for j = 0 to rows - 1  
                float vol = array.get(rowVolumes, j)  
                if vol > maxVol  
                    maxVol := vol  
                    pocRow := j  
            float poc = sessionLow + (pocRow + 0.5) * rowSize  
            // Value Area: start at POC, expand to 70% total volume  
            float totalVol = array.sum(rowVolumes)  
            float targetVol = totalVol * 0.7  
            float accumVol = maxVol  
            int upperRow = pocRow  
            int lowerRow = pocRow  
            while accumVol < targetVol and (upperRow < rows - 1 or lowerRow > 0)  
                float upperVol = upperRow < rows - 1 ? array.get(rowVolumes, upperRow + 1) : 0.0  
                float lowerVol = lowerRow > 0 ? array.get(rowVolumes, lowerRow - 1) : 0.0  
                if upperVol >= lowerVol and upperRow < rows - 1  
                    upperRow += 1  
                    accumVol += upperVol  
                else if lowerRow > 0  
                    lowerRow -= 1  
                    accumVol += lowerVol  
                else  
                    break  
            float vah = sessionLow + (upperRow + 0.5) * rowSize  
            float val_ = sessionLow + (lowerRow + 0.5) * rowSize  
            VolumeProfile.new(poc, vah, val_, totalVol)  