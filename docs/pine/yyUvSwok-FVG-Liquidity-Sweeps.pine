//@version=5
indicator("FVG + Liquidity Sweeps", overlay=true)

// === INPUTS ===
showFVG = input.bool(true, "Show FVGs")
showSweeps = input.bool(true, "Show Liquidity Sweeps")
fvgLookback = input.int(20, "FVG Lookback", minval=2)
sweepSensitivity = input.int(5, "Sweep Sensitivity", minval=1)

// === FVG DETECTION ===
// FVG occurs when the previous candle’s high < current candle’s low or
// previous candle’s low > current candle’s high (imbalance between candles)
fvgUp = showFVG and (high[2] < low)
fvgDown = showFVG and (low[2] > high)

plotshape(fvgUp, title="FVG Up", location=location.belowbar, color=color.green, style=shape.labelup, text="FVG↑")
plotshape(fvgDown, title="FVG Down", location=location.abovebar, color=color.red, style=shape.labeldown, text="FVG↓")

// === LIQUIDITY SWEEP DETECTION ===
// Check if price sweeps recent high/low then reverses
var float lastHigh = na
var float lastLow = na

// Track swing highs/lows
isSwingHigh = high > ta.highest(high[1], sweepSensitivity) and high > ta.highest(high[1], sweepSensitivity)
isSwingLow = low < ta.lowest(low[1], sweepSensitivity) and low < ta.lowest(low[1], sweepSensitivity)

if isSwingHigh
    lastHigh := high
if isSwingLow
    lastLow := low

// Detect sweep and rejection
sweepHigh = showSweeps and high > lastHigh[1] and close < lastHigh[1]
sweepLow = showSweeps and low < lastLow[1] and close > lastLow[1]

plotshape(sweepHigh, title="Liquidity Sweep High", location=location.abovebar, color=color.orange, style=shape.triangledown, text="Sweep High")
plotshape(sweepLow, title="Liquidity Sweep Low", location=location.belowbar, color=color.teal, style=shape.triangleup, text="Sweep Low")
