// ==========================================
// --- RANGE BOXES (setBox) ---
// ==========================================

// @function Draws a filled box with a smart label to prevent visual clutter.
// @param top Price of the upper boundary.
// @param bottom Price of the lower boundary.
// @param startTime UNIX timestamp (ms) for the left side of the box.
// @param endTime UNIX timestamp (ms) for the right side (defaults to current 'time').
// @param boxText Optional text label for the box. Use "" to hide.
// @param l_pos Label alignment: "left" (start of box), "right" (current time), or "center".
// @param b_col Border and fill color.
// @param b_width Border width in pixels.
// @param b_style Border style: "solid", "dashed", or "dotted".
// @param b_transp Background transparency (0-100).
// @returns The ID of the drawn box and label.
export setBox(float top, float bottom, int startTime, int endTime = na, string boxText = "", string l_pos = "left", color b_col = color.blue, int b_width = 1, string b_style = "solid", int b_transp = 90) =>
    var box rangeBox = na
    var label boxLab = na
    box.delete(rangeBox)
    label.delete(boxLab)
    eTime = na(endTime) ? time : endTime
    style = b_style == "dashed" ? line.style_dashed : b_style == "dotted" ? line.style_dotted : line.style_solid
    rangeBox := box.new(startTime, top, eTime, bottom, xloc = xloc.bar_time, border_color = b_col, border_width = b_width, border_style = style, bgcolor = color.new(b_col, b_transp), force_overlay = true)
    if boxText != ""
        int targetTime = l_pos == "left" ? startTime : l_pos == "center" ? int(math.avg(startTime, eTime)) : eTime
        lStyle = l_pos == "left" ? label.style_label_right : l_pos == "right" ? label.style_label_left : label.style_label_center
        boxLab := label.new(targetTime, (top + bottom) / 2, text = boxText, xloc = xloc.bar_time, style = lStyle, color = color.new(color.white, 100), textcolor = b_col, size = size.normal, force_overlay = true)
