// ==========================================
// --- TREND VECTORS (trendLine) ---
// ==========================================

// @function Draws a diagonal trendline (vector) between two specific points in time.
// @param start_price Price level at the starting point.
// @param startTime UNIX timestamp (ms) of the starting point.
// @param last_price Price level at the end point.
// @param lastTime UNIX timestamp (ms) of the end point.
// @param labelText Text to display on the label. Use "none" to hide.
// @param labelPos Vertical position of the label ('above', 'below', or 'none').
// @param is_extend Extension mode: "ext.right", "ext.both", or "no ext.".
// @param l_width Width of the line in pixels.
// @param l_col Color of the line and the label text.
// @param l_style Line style: "solid", "dashed", or "dotted".
// @returns The ID of the drawn line and label.
export trendLine(float start_price, int startTime, float last_price, int lastTime, string labelText = "none", string labelPos = "none", string is_extend = "no ext.", int l_width = 1, color l_col = color.blue, string l_style = "solid") =>
    var line tLine = na
    var label tLab = na
    line.delete(tLine)
    label.delete(tLab)
    style = l_style == "dashed" ? line.style_dashed : l_style == "dotted" ? line.style_dotted : line.style_solid
    ext   = is_extend == "ext.right" ? extend.right : is_extend == "ext.both" ? extend.both : extend.none
    tLine := line.new(startTime, start_price, lastTime, last_price, xloc = xloc.bar_time, color = l_col, width = l_width, style = style, extend = ext, force_overlay = true)
    if labelPos != "none" and labelText != "none"
        lStyle = labelPos == "above" ? label.style_label_down : label.style_label_up
        tLab := label.new(time, last_price, xloc = xloc.bar_time, text = labelText, style = lStyle, color = color.new(color.white, 100), textcolor = l_col, size = size.normal, force_overlay = true)

// ==========================================
// --- INDIVIDUAL COLORS (colorsuite) ---
// ==========================================

// @function Provides a unified palette of cyberpunk, structural, and dashboard colors.
// @returns A tuple containing [bull_candle_color, bear_candle_color, deep_space_blue, obsidian_forest, silk_pearl, omsf_color, omsf_bulls_color, omsf_bears_color, hyper_green_hex, laser_crimson_hex]
export colorsuite() =>

    // --- Candle Body Colors ---
    color bull_candle_color = #0bcdad
    color bear_candle_color = #e51f54

    // --- OMSF Structural Engine Colors ---
    color omsf_bears_color  = color.rgb(255, 64, 25)
    color omsf_color        = color.rgb(255, 229, 145)
    color omsf_bulls_color  = color.rgb(204, 255, 62)

    // --- High-Visibility Neon Accents ---
    // RGB: Red = 0, Green = 255, Blue = 120 (for a vibrant, cyan-tinted glow effect)
    color hyper_green_rgb   = color.rgb(0, 255, 120)
    color hyper_green_hex   = #00ff78

    // RGB: Red = 255, Green = 20, Blue = 80 (the distinct hue for a neon-laser vibe)
    color laser_crimson_rgb = color.rgb(255, 20, 80)
    color laser_crimson_hex = #ff1450

    // --- Dashboard & Background Colors ---
    color midnight_charcoal = color.rgb(18, 24, 32)   // HEX: #121820
    color deep_space_blue   = color.rgb(1, 10, 41)    // HEX: #0A1128
    color obsidian_forest   = color.rgb(11, 29, 20)   // HEX: #0B1D14

    // --- High-Contrast Light Text / Accent Colors ---
    color ice_glare         = color.rgb(240, 248, 255) // HEX: #F0F8FF
    color mint_frost        = color.rgb(230, 255, 240) // HEX: #E6FFF0
    color silk_pearl        = color.rgb(255, 253, 245) // HEX: #FFFDF5

    // --- Muted Mid-Tone Text / Accent Colors ---
    color pewter_mist       = color.rgb(205, 212, 218) // HEX: #CDD4DA
    color dusty_alabaster   = color.rgb(222, 218, 210) // HEX: #DEDAD2
    color sage_vapor        = color.rgb(202, 214, 205) // HEX: #CAD6CD


    [bull_candle_color, bear_candle_color, deep_space_blue, obsidian_forest, silk_pearl, omsf_color, omsf_bulls_color, omsf_bears_color, hyper_green_hex, laser_crimson_hex]

[bull_candle_color, bear_candle_color, deep_space_blue, obsidian_forest, silk_pearl, omsf_color, omsf_bulls_color, omsf_bears_color, hyper_green_hex, laser_crimson_hex] = colorsuite()

