// @version=6
// @description MTF-Safe Visual Objects, optimized for coding in OMSF environments. 
// This library provides high-performance drawing tools (Lines, Boxes, Trendlines) using UNIX timestamps 
// to ensure visual consistency across all timeframes without drift.
//
// Key Features:
// - Multi-Timeframe (MTF) stability via xloc.bar_time.
// - Smart labeling to prevent UI clutter at the right chart margin.
// - Optimized for the OMSF (Open Market Structure Framework).
//
// Links & Resources:
// @link https://www.tradingview.com/script/g1122Yj2/ - Main Indicator using this library
// @link https://www.tradingview.com/u/arnipoer/#published-scripts - Author profile and more scripts
// - Documentation: Refer to function tooltips within the Pine Editor for detailed parameter descriptions.

library("VisualStructureTools", true)

// ==========================================
// --- HORIZONTAL LEVELS (setLine) ---
// ==========================================

// @function Draws a horizontal price level or a segment with an optional synchronized label.
// @param price The price level where the line will be drawn.
// @param startTime UNIX timestamp (ms) for the starting point of the line.
// @param labelText Text to be displayed on the label. Set to "none" to disable.
// @param v_labelPos Vertical position of the label relative to the price ('above', 'below', or 'none').
// @param is_extend Extension mode: "ext.both" for infinite extension, "no ext." to draw from startTime to current time.
// @param l_width Line thickness in pixels.
// @param l_col Color for both the line and the label text.
// @param l_style Visual style of the line: "solid", "dashed", or "dotted".
// @returns The ID of the updated line and label objects.
export setLine(float price, int startTime, string labelText = "none", string v_labelPos = "none", string is_extend = "no ext.", int l_width = 1, color l_col = color.blue, string l_style = "solid") =>
    var line lvlLine = na
    var label lvlLab = na
    line.delete(lvlLine)
    label.delete(lvlLab)
    style = l_style == "dashed" ? line.style_dashed : l_style == "dotted" ? line.style_dotted : line.style_solid
    ext   = is_extend == "ext.both" ? extend.both : extend.none
    lvlLine := line.new(startTime, price, time, price, xloc = xloc.bar_time, color = l_col, width = l_width, style = style, extend = ext, force_overlay = true)
    if v_labelPos != "none" and labelText != "none"
        lStyle = v_labelPos == "above" ? label.style_label_down : label.style_label_up
        lvlLab := label.new(time, price, text = labelText, xloc = xloc.bar_time, style = lStyle, color = color.new(color.white, 100), textcolor = l_col, size = size.normal, force_overlay = true)
