// @version=5

// @description Library utilitas untuk analisa Smart Money Concepts (SMC).
// © setiawan_viewer
library("SMC_Core")

// --- SETTINGAN GLOBAL ---
const string DATE_STYLE = "MM-dd (E)"
const string TIME_STYLE = "HH:mm"
const string NY_ZONE    = "America/New_York"
const string TF_1M      = "1"

// @function        Fungsi internal untuk validasi nilai string yang kosong (na).
// @param input_val Nilai yang akan dicek.
// @param def_val   Nilai cadangan jika input_val kosong.
get_safe_val(string input_val, string def_val) => not na(input_val) ? input_val : def_val

// @enum Opsi perpanjangan garis area di chart.
export enum AreaExtend
    current = "Current Session"
    next    = "Next Session"
    active  = "Current Bar"

// @enum Pilihan model visualisasi garis (Solid, Putus-putus, Titik).
export enum PlotStyle
    solid_line = "Solid"
    dash_line  = "Dashed"
    dot_line   = "Dotted"

// @enum Pilihan ukuran tulisan pada label chart.
export enum LabelFontSize
    tiny_size   = "Tiny"
    small_size  = "Small"
    normal_size = "Normal"
    large_size  = "Large"
    huge_size   = "Huge"

// @enum Arah bias market (Bullish atau Bearish).
export enum MarketSide
    UP   = "+"
    DOWN = "-"

// @enum Daftar kategori area harga (PD Arrays).
export enum ZoneCategory
    fvg_code    = "FVG"
    fvg_name    = "Fair Value Gap"
    ifvg_code   = "IFVG"
    ifvg_name   = "Inversion Fair Value Gap"
    vi_code     = "VI"
    vi_name     = "Volume Imbalance"
    lv_code     = "LV"
    lv_name     = "Liquidity Void"
    ob_code     = "OB"
    ob_name     = "Order Block"
    brk_code    = "BRKR"
    brk_name    = "Breaker"

// @function     Mengambil tipe garis TradingView berdasarkan pilihan user.
export get_line_type(PlotStyle select) =>
    switch select
        PlotStyle.solid_line => line.style_solid
        PlotStyle.dash_line  => line.style_dashed
        PlotStyle.dot_line   => line.style_dotted

// @function     Mengambil ukuran font TradingView berdasarkan pilihan user.
export get_font_type(LabelFontSize select) =>
    switch select
        LabelFontSize.tiny_size   => size.tiny
        LabelFontSize.small_size  => size.small
        LabelFontSize.normal_size => size.normal
        LabelFontSize.large_size  => size.large
        LabelFontSize.huge_size   => size.huge

// @function 		Mengubah waktu UNIX menjadi teks tanggal & jam (Zona NY).
export convert_time_to_str(int unix_ms) =>
    string d_part = str.format_time(unix_ms, DATE_STYLE, NY_ZONE)
    string t_part = str.format_time(unix_ms, TIME_STYLE, NY_ZONE)
    str.format("{0} - {1}", d_part, t_part)

// @function        Membuat label area (contoh: +FVG atau -OB).
// @param s         Arah market (MarketSide).
// @param c         Kategori area (ZoneCategory).
export create_zone_tag(MarketSide s, ZoneCategory c) => str.format("{0}{1}", str.tostring(s), str.tostring(c))

// @function		Membedah string sesi menjadi data waktu UNIX (Start & End).
export resolve_session_range(string sess_input, string tz_id = na, string tf_id = na) =>
	active_tz = get_safe_val(tz_id, NY_ZONE)
	active_tf = get_safe_val(tf_id, TF_1M)
    int ref_t   = time(active_tf, sess_input, active_tz)

    if not na(ref_t)
        segments = str.split(sess_input, "-")
        h_on = str.tonumber(str.substring(segments.get(0), 0, 2))
        m_on = str.tonumber(str.substring(segments.get(0), 2, 4))
        h_off = str.tonumber(str.substring(segments.get(1), 0, 2))
        m_off = str.tonumber(str.substring(segments.get(1), 2, 4))
        
        day_shift = h_on == 0 ? 1 : 0 
        ts_start = timestamp(active_tz, year(ref_t), month(ref_t), dayofmonth(ref_t) + day_shift, int(h_on), int(m_on))
        ts_end   = timestamp(active_tz, year(ref_t), month(ref_t), dayofmonth(ref_t) + day_shift, int(h_off), int(m_off))
        [ref_t, ts_start, ts_end]

// --- OBJEK & METHOD (TYPES) ---

// @type 			Objek untuk mengelola jadwal sesi trading.
export type MarketSession
    string tag
    string time_range // SEBELUMNYA 'range', SUDAH DIPERBAIKI
    bool use_it = false
    int t_start
    int t_end
    int t_raw

// @function 	Memvalidasi apakah input jam sesi sudah benar (HHMM-HHMM).
export method verify_range(MarketSession self) =>
    string err = na
    items = str.split(self.time_range, "-")

    if not (items.size() == 2)
        err := "Missing start/end time"
    else
        float v_start = str.tonumber(items.get(0))
        float v_end   = str.tonumber(items.get(1))

        if v_start >= v_end
            err := "Start time must be before end time"
    
    if self.use_it and not na(err)
        runtime.error(str.format("Error in Session {0}: {1}.", self.tag, err))
    self

// @function	Menghitung dan memperbarui waktu sesi pada bar berjalan.
export method refresh_timing(MarketSession self) =>
    [raw, t1, t2] = resolve_session_range(self.time_range)
    self.t_raw   := raw
    self.t_start := t1
    self.t_end   := t2
    self

// @function	Mengecek apakah saat ini market sedang berada di dalam sesi.
export method is_within_time(MarketSession self) =>
    self.refresh_timing()
    not na(self.t_raw)

// @type 		Objek untuk menyimpan data area Gap (FVG, VI, LV).
export type GapZone
    MarketSide side
    string label
    int start_t
    int end_t
    int start_bar
    int end_bar
    float price_low
    float price_high
    float mean_threshold

// @function	Mendeteksi adanya Fair Value Gap (FVG).
export detect_fvg(int lookback = 0, bool merge_vi = true) =>
    k = lookback
    GapZone fvg_res = na

    // Kondisi Bullish FVG
    if barstate.isconfirmed and high[1+k] > high[2+k] and low[k] > high[2+k]
        float p_top = merge_vi and close[k] > open[k] and open[k] > close[1+k] ? open[k] : low[k]
        float p_bot = merge_vi and open[2+k] < close[2+k] and close[2+k] < open[1+k] ? close[2+k] : high[2+k]
        fvg_res := GapZone.new(MarketSide.UP, create_zone_tag(MarketSide.UP, ZoneCategory.fvg_code),
          time[2+k], time[k], bar_index[2+k], bar_index[k], p_bot, p_top, math.avg(p_bot, p_top))

    // Kondisi Bearish FVG
    else if barstate.isconfirmed and low[1+k] < low[2+k] and high[k] < low[2+k]
        float p_top = merge_vi and open[2+k] > close[2+k] and close[2+k] > open[1+k] ? close[2+k] : low[2+k]
        float p_bot = merge_vi and open[k] > close[k] and open[k] < close[1+k] ? open[k] : high[k]
        fvg_res := GapZone.new(MarketSide.DOWN, create_zone_tag(MarketSide.DOWN, ZoneCategory.fvg_code), 
          time[2+k], time[k], bar_index[2+k], bar_index[k], p_bot, p_top, math.avg(p_bot, p_top))

    fvg_res

// @function	Mendeteksi adanya Volume Imbalance (VI).
export detect_vi(int lookback = 0) =>
    k = lookback
    GapZone vi_res = na

    if barstate.isconfirmed and open[k] > close[1+k] and close[k] > close[1+k] and close[1+k] > open[1+k]
        vi_res := GapZone.new(MarketSide.UP, create_zone_tag(MarketSide.UP, ZoneCategory.vi_code),
          time[2+k], time[k], bar_index[2+k], bar_index[k], close[1+k], open[k], math.avg(close[1+k], open[k]))
    else if barstate.isconfirmed and open[k] < close[1+k] and close[k] < close[1+k] and close[1+k] < open[1+k]
        vi_res := GapZone.new(MarketSide.DOWN, create_zone_tag(MarketSide.DOWN, ZoneCategory.vi_code), 
          time[2+k], time[k], bar_index[2+k], bar_index[k], open[k], close[1+k], math.avg(open[k], close[1+k]))

    vi_res

// @function	Mendeteksi adanya Liquidity Void (LV).
export detect_lv(int lookback = 0) =>
    k = lookback
    GapZone lv_res = na

    if barstate.isconfirmed and low[k] > high[1+k]
        lv_res := GapZone.new(MarketSide.UP, create_zone_tag(MarketSide.UP, ZoneCategory.lv_code),
          time[2+k], time[k], bar_index[2+k], bar_index[k], high[1+k], low[k], math.avg(high[1+k], low[k]))
    else if barstate.isconfirmed and high[k] < low[1+k]
        lv_res := GapZone.new(MarketSide.DOWN, create_zone_tag(MarketSide.DOWN, ZoneCategory.lv_code),
          time[2+k], time[k], bar_index[2+k], bar_index[k], high[k], low[1+k], math.avg(high[k], low[1+k]))

    lv_res
