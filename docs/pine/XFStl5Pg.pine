//@version=6
indicator("SMA Highlight + Thick MACD Arrows + MACD Cycle Zones (Peak Precision)", overlay=true)

// === SMA Setup ===
sma5 = ta.sma(close, 5)
sma20 = ta.sma(close, 20)
plot_sma5 = plot(sma5, title="SMA 5", color=color.green, linewidth=1)
plot_sma20 = plot(sma20, title="SMA 20", color=color.red, linewidth=1)
bullish = sma5 > sma20
bearish = sma5 < sma20
areaColor = bullish ? color.new(color.green, 80) : bearish ? color.new(color.red, 80) : na
fill(plot_sma5, plot_sma20, color=areaColor, title="SMA Area Highlight")

// === MACD Setup ===
[macdLine, signalLine, _] = ta.macd(close, 5, 20, 9)
bullishMACD = ta.crossover(macdLine, signalLine)
bearishMACD = ta.crossunder(macdLine, signalLine)

// === Thick MACD arrows ===
arrowOffset = (high - low) * 1.5
plotshape(bullishMACD ? sma5[1] - arrowOffset : na, style=shape.triangleup, location=location.absolute, color=color.blue, size=size.large, title="Bullish Arrow")
plotshape(bearishMACD ? sma5[1] + arrowOffset : na, style=shape.triangledown, location=location.absolute, color=color.red, size=size.large, title="Bearish Arrow")

// === Divergence calculation ===
divergence = macdLine - signalLine
divPrev = nz(divergence[1])

// === State tracking ===
var int state = 0        // 0 = idle, 1 = yellow zone active, 2 = blue zone active
var float peakValue = na // Stores the max/min divergence of current cycle

// --- Bullish cycle start: signal below MACD, convergence toward bullish cross ---
if (state == 0 and divergence < 0 and divergence > divPrev)
    state := 1
    peakValue := na

// --- Bearish cycle start: signal above MACD, convergence toward bearish cross ---
if (state == 0 and divergence > 0 and divergence < divPrev)
    state := 2
    peakValue := na

// --- Track peak divergence after bullish cross ---
if (state == 1)
    if bullishMACD
        peakValue := na  // reset peak tracking after cross
    // Start tracking peak divergence after cross has occurred
    if divergence > 0
        peakValue := na(peakValue) ? divergence : math.max(peakValue, divergence)
        if divergence < peakValue
            state := 0  // End zone at peak candle

// --- Track trough divergence after bearish cross ---
if (state == 2)
    if bearishMACD
        peakValue := na  // reset peak tracking after cross
    // Start tracking trough divergence after cross has occurred
    if divergence < 0
        peakValue := na(peakValue) ? divergence : math.min(peakValue, divergence)
        if divergence > peakValue
            state := 0  // End zone at trough candle

// === Plot background colors ===
bgcolor(state == 1 ? color.new(color.yellow, 85) : na, title="Bullish Convergence/Divergence Zone")
bgcolor(state == 2 ? color.new(color.blue, 85) : na, title="Bearish Convergence/Divergence Zone")