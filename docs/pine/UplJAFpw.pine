//@version=6
indicator("달러 갭 비율 (USD/KRW vs DXY)", overlay=false)

// DXY 및 USD/KRW 데이터 가져오기
dxy = request.security("TVC:DXY", timeframe.period, close)
usdkrw = close

// 갭 비율 계산 (스케일 조정을 위한 승수 적용)
gap_ratio = (dxy / usdkrw) * 100000 

// 1년 중간값 대용 (240일 이동평균선)
sma_240 = ta.sma(gap_ratio, 240)

// 차트에 그리기 (버전 6 문법 적용 완료)
plot(gap_ratio, title="Gap Ratio", color=color.blue, linewidth=2)
plot(sma_240, title="1년 중간값 대용(240일 이평선)", color=color.gray, style=plot.style_linebr)