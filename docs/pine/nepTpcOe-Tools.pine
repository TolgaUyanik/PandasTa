//@version=6

// @description Library for common tools
library('Tools', overlay = false)
import aybarsm/ToolsFluent/1 as fluent

var map<string, fluent.Fluent> container = map.new<string, fluent.Fluent>()

//@function Returns the type of variable
//@param value Value to check.
//@returns String bool|int|float|string|color
export typeof(bool value) => 
    string res = value == true ? 'bool' : 'bool'

    res

export typeof(int value) => 
    string res = value == 0 ? 'int' : 'int'

    res

export typeof(float value) =>
    string res = value == 0 ? 'float' : 'float'

    res

export typeof(string value) => 
    string res = value == '' ? 'string' : 'string'

    res

export typeof(color value) =>
    string res = value == color.white ? 'color' : 'color'

    res

// @function Dynamically returns desired moving average type
// @param maType string Moving average type
// @param maSource float[] Source series for moving average
// @param maLength int Length for moving average 
// @returns float[] ta.{sma,rma,ema,wma,vwma,hma}
export movingAverage(string maType, float maSource, int maLength) =>
    switch maType
        'SMA' => ta.sma(maSource, maLength)
        'RMA' => ta.rma(maSource, maLength)
        'EMA' => ta.ema(maSource, maLength)
        'WMA' => ta.wma(maSource, maLength)
        'VWMA' => ta.vwma(maSource, maLength)
        'HMA' => ta.hma(maSource, maLength)
        => 
    	    runtime.error('Library: aybarsm/Tools - Function: movingAverage - No matching MA type found.')
    	    float(na)

// @function Returns bool regarding candle[2] can be marked as BW High Fractal
// @param srcHigh float[] Series source for high fractal marking. Default: high
// @returns boolean
export isFracHighBW(float srcHigh = high) =>
    srcHigh[4] < srcHigh[2] and srcHigh[3] <= srcHigh[2] and srcHigh[2] >= srcHigh[1] and srcHigh[2] > srcHigh[0]

// @function Returns bool regarding candle[2] can be marked as BW Low Fractal
// @param srcLow float[] Series source for low fractal marking. Default: low
// @returns boolean
export isFracLowBW(float srcLow = low) =>
    srcLow[4] > srcLow[2] and srcLow[3] >= srcLow[2] and srcLow[2] <= srcLow[1] and srcLow[2] < srcLow[0]

// @function Returns int between -2 and 2. 2: HH, 1: LH, 0: No condition met, -1: HL, -2: LL
// @param srcHigh float[] Series source for high fractal marking. Default: high
// @param srcLow float[] Series source for low fractal marking. Default: low
// @returns array -2, -1, 0, 1, 2
export getFracMarkBW(float srcHigh = high, float srcLow = low) =>
    bool isBWHigh = isFracHighBW(srcHigh)
    bool isBWLow = isFracLowBW(srcLow)
    float lastHigh = ta.valuewhen(isBWHigh, srcHigh[2], 1)
    float lastLow = ta.valuewhen(isBWLow, srcLow[2], 1)

    int highMark = switch 
        isBWHigh and srcHigh[2] > lastHigh => 2
        isBWHigh and srcHigh[2] < lastHigh => 1
        => 0

    int lowMark = switch 
        isBWLow and srcLow[2] < lastLow => -2
        isBWLow and srcLow[2] > lastLow => -1
        => 0

    [highMark, lowMark]

//@enum An enumeration of named values representing hh, lh, hl, and ll fractal marks.
//@field hh Represents a "Higher High" mark.
//@field lh Represents a "Lower High" mark.
//@field hl Represents a "Higher Low" mark.
//@field ll Represents a "Lower Low" mark.
export enum FracMark
	hh = 'hh'
	lh = 'lh'
	hl = 'hl'
	ll = 'll'

//@type FracInfo - Fractal mark info object 
//@field mark <FracMark> Fractal mark
//@field price float Fractal price
//@field when int Fractal bar time UNIX. Default: time
//@field markWhen int Fractal mark bar time UNIX. Default: time
//@field boPrice float Fractal breakout price. Default: na
//@field boTime int Fractal breakout bar time UNIX. Default: time
//@field boIndex int Fractal breakout bar index. Default: time
export type FracInfo
	FracMark mark
	float price
	int when
	int index
	int markWhen = time
	int markIndex = bar_index
	float boPrice = na
	int boTime = na
	int boIndex = na

//@type Fractals - Fractal container object 
//@field hh FracInfo[] Higher high fractals
//@field lh FracInfo[] Lower high fractals
//@field hl FracInfo[] Higher low fractals
//@field ll FracInfo[] Lower low fractals
//@field isHigh bool Is current candle marked a high fractal
//@field isLow bool Is current candle marked a low fractal
//@field isHH bool Is current candle marked a higher high fractal
//@field isLH bool Is current candle marked a lower high fractal
//@field isHL bool Is current candle marked a higher low fractal
//@field isLL bool Is current candle marked a lower low fractal
export type Fractals
	array<FracInfo> hh = na
	array<FracInfo> lh = na
	array<FracInfo> hl = na
	array<FracInfo> ll = na
	bool isHigh = false
	bool isLow = false
	bool isHH = false
	bool isLH = false
	bool isHL = false
	bool isLL = false

// @function Returns Fractals after processing
// @param fractals Fractals container object to be used. Default: na
// @param srcHigh source for high fractal marking. Default: high
// @param srcLow source for low fractal marking. Default: low
// @param hhBoLb Higher high brakout lookback count. Default: 0
// @param llBoLb Lower low brakout lookback count. Default: 0
// @returns Fractals
export processFractals(Fractals fractals = na, float srcHigh = high, float srcLow = low, int hhBoLb = 0, int llBoLb = 0) =>
    Fractals container = na(fractals) ? Fractals.new() : fractals.copy()
    
    container.hh := na(container.hh) ? array.new<FracInfo>() : container.hh
    container.lh := na(container.lh) ? array.new<FracInfo>() : container.lh
    container.hl := na(container.hl) ? array.new<FracInfo>() : container.hl
    container.ll := na(container.ll) ? array.new<FracInfo>() : container.ll

    [highMark, lowMark] = getFracMarkBW(srcHigh, srcLow)

    container.isHigh := highMark > 0
    container.isLow := lowMark < 0
    container.isHH := highMark == 2
    container.isLH := highMark == 1
    container.isHL := lowMark == -1
    container.isLL := lowMark == -2

    if container.isHigh
        array.push(container.isHH ? container.hh : container.lh, FracInfo.new(container.isHH ? FracMark.hh : FracMark.lh, srcHigh[2], time[2], bar_index[2]))

    if container.isLow
        array.push(container.isLL ? container.ll : container.hl, FracInfo.new(container.isLL ? FracMark.ll : FracMark.hl, srcLow[2], time[2], bar_index[2]))

    if hhBoLb > 0 and array.size(container.hh) > 0
        int hhBoLbFrom = math.max(0, array.size(container.hh) - hhBoLb)
        int hhBoLbTo = array.size(container.hh) - 1
        for i = hhBoLbFrom to hhBoLbTo by 1
            if na(array.get(container.hh, i).boPrice) and close[1] > open[1] and close[1] > array.get(container.hh, i).price
                FracInfo fracHH = array.get(container.hh, i)
                fracHH.boPrice := close[1]
                fracHH.boTime := time[1]
                fracHH.boIndex := bar_index[1]
                array.insert(container.hh, i, fracHH)

    if llBoLb > 0 and array.size(container.ll) > 0
        int llBoLbFrom = math.max(0, array.size(container.ll) - llBoLb)
        int llBoLbTo = array.size(container.ll) - 1
        for i = llBoLbFrom to llBoLbTo by 1
            if na(array.get(container.ll, i).boPrice) and close[1] < open[1] and close[1] < array.get(container.ll, i).price
                FracInfo fracLL = array.get(container.ll, i)
                fracLL.boPrice := close[1]
                fracLL.boTime := time[1]
                fracLL.boIndex := bar_index[1]
                array.insert(container.ll, i, fracLL)

    container