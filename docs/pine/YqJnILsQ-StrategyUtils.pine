//@version=6
// StrategyUtils Library v1.0.0
// A utility collection of backtest logic, price formatting, and trade management for Pine Script strategies.

library('StrategyUtils')

// @function getHeikinAshi
// @param open float: Raw open price
// @param high float: Raw high price
// @param low float: Raw low price
// @param close float: Raw close price
// @returns tuple of haOpen, haClose, haHigh, haLow
export getHeikinAshi(float open, float high, float low, float close) =>
    haclose = (open + high + low + close) / 4
    var float prevHaOpen = na
    prevHaOpen := na(prevHaOpen[1]) ? (open + close) / 2 : (prevHaOpen[1] + haclose) / 2
    hahigh = math.max(high, math.max(prevHaOpen, haclose))
    halow = math.min(low, math.min(prevHaOpen, haclose))
    [prevHaOpen, haclose, hahigh, halow]
    // @function getFibExtensions
    // @param high float: Highest point before trade
    // @param low float: Lowest point before trade
    // @returns tuple of extension levels
export getFibExtensions(float high, float low) =>
    Fbrange = high - low
    ext_127 = high + Fbrange * 1.272
    ext_141 = high + Fbrange * 1.618
    ext_161 = high + Fbrange * 2.618
    [ext_127, ext_141, ext_161]

// @function inBacktestWindow
// @param time int: Current bar time
// @param start int: Start timestamp
// @param end int: End timestamp
// @returns bool: true if within Fbrange
export inBacktestWindow(int time, int start, int end) =>
    not na(time) and time >= start and time < end

// @function getCurrentState
// @param buy bool: Buy signal condition
// @param sell bool: Sell signal condition
// @returns string: "Buy", "Sell", or "None"
export getCurrentState(bool buy, bool sell) =>
    buy ? 'Buy' : sell ? 'Sell' : 'None'

// @function formatPrice
// @param price float: Input price value
// @returns string: Formatted price string
export formatPrice(float price) =>
    price > 1 ? str.tostring(price, '#,###.##') : price > 0 ? str.tostring(price, '#.########') : str.tostring(price, '##.###')

// @function getColorByProfit
// @param netprofit float: Strategy net profit
// @param initial float: Initial capital
// @param green color: Positive color
// @param red color: Negative color
// @returns color: Display color based on PnL
export getColorByProfit(float netprofit, float initial, color green, color red) =>
    initial + netprofit > initial ? color.new(green, 70) : initial + netprofit == initial ? color.gray : color.new(red, 70)
