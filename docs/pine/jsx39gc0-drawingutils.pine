//@version=6
// @description methods used in my scripts for some basic and customized drawings and arrays.
library('drawingutils', overlay = true)
import Trendoscope/utils/6 as ut

// @function Draws line and adds to the array
// @param this array to which the created line needs to be added
// @param p1 point1 of the line
// @param p2 point2 of the line
// @param lineColor line color
// @param style line style
// @param width line width
// @param xloc xloc.bar_index or xloc.bar_time
// @param extend default is extend.none
// @returns line created
export method line(array<line> this, chart.point p1, chart.point p2, color lineColor, string style = line.style_solid,
                     int width = 1, string xloc = xloc.bar_index, string extend = extend.none) =>
    targetLine = line.new(p1, p2, xloc, extend, lineColor, style, width)
    this.push(targetLine)
    targetLine

// @function Draws label and adds to the array
// @param this array to which the created label needs to be added
// @param p point at which the label needs to be drawn
// @param txt label text
// @param tooltip tooltip text
// @param xloc xloc value - xloc.bar_index or xloc.bar_time
// @param yloc y location of the label
// @param color label color
// @param style label style
// @param textcolor label text color
// @param size Size of the label
// @param textalign text alignment
// @returns label created
export method label(array<label> this, chart.point p, string txt, string tooltip, string xloc = xloc.bar_index, string yloc = yloc.price,
         color color = na, string style = label.style_label_down, color textcolor=na, string size=size.normal, string textalign=text.align_center) =>
    targetLabel = label.new(p, txt, xloc, yloc, color, style, textcolor, size, textalign, tooltip)
    this.push(targetLabel)
    targetLabel

// @function Draws linefill and adds to array
// @param this array to which the created linefill needs to be added
// @param ln1 line1 of the fill
// @param ln2 line2 of the fill
// @param fillColor fill Color
// @param transparency fill transparency
// @returns linefill created
export method linefill(array<linefill> this, line ln1, line ln2, color fillColor, int transparency) =>
    lnfl = linefill.new(ln1, ln2, color.new(fillColor, transparency))
    array.push(this, lnfl)
    lnfl

// @function Draws labelled line
// @param target target price
// @param lblText label text
// @param linecolor line color
// @param labelcolor label color
// @param index index to calculate the distance offset
// @param highlight highlight true/false
// @param linesArray array of lines where the created line is added
// @param labelsArray array of labels where the created label is added
// @param highlightSize Size of highlighted text
// @param tinySize size of non highlighted text
// @param yloc y location
// @param textalign text alignment
// @returns void
export draw_labelled_line(float target, string lblText, color linecolor, color labelcolor, int index, bool highlight, array<line> linesArray,
                         array<label> labelsArray, string highlightSize = size.normal, string tinySize = size.tiny, string yloc = yloc.price, string textalign = text.align_center) =>
    x1 = bar_index + 20 * index * 2
    x2 = x1 + 20
    xloc = xloc.bar_index
    style = yloc == yloc.price ? label.style_none : yloc == yloc.abovebar ? label.style_label_down : label.style_label_up
    targetLine = line.new(x1 = x1, y1 = target, x2 = x2, y2 = target, color = linecolor, xloc = xloc, extend = extend.none, style = highlight ? line.style_solid : line.style_dotted)
    targetLabel = label.new(x = (x1 + x2) / 2, y = target, 
             text = lblText + '\n' + str.tostring(math.round_to_mintick(target)), xloc = xloc, style = style, 
                             textcolor = highlight ? labelcolor : color.new(labelcolor, 70), 
                             size = highlight ? highlightSize : tinySize, color = color.new(labelcolor, 100), textalign = textalign)
    array.push(linesArray, targetLine)
    array.push(labelsArray, targetLabel)

// @function Draws custom labelled box
// @param y1 price 1 of the box
// @param y2 price 2 of the box
// @param labelColor label color
// @param labelText label text
// @param index index to calculate the offset distance
// @param boxArray box array to which the box needs to be added
// @param labelArray label array to which the label needs to be added
// @param borderColor border color
// @param borderStyle border style
// @param borderWidth border width
// @param textAlign text align of the label
// @param highlight highlight label text
// @param highLightLabel highlight label size
// @returns void
export draw_labelled_box(float y1, float y2, color labelColor, string labelText, int index, array<box> boxArray, array<label> labelArray,
                         color borderColor = color.blue, string borderStyle = line.style_dotted, int borderWidth = 1, string textAlign = text.align_right, 
                         bool highlight = true, bool highLightLabel = false) =>
    x1 = bar_index + 20 * index * 2
    x2 = x1 + 20
    y = (y1 + y2) / 2
    transp = highlight ? 70 : 90
    transpLabel = highlight ? 0 : 50
    labelSize = highLightLabel ? size.normal : size.small
    bx = box.new(x1, y1, x2, y2, borderColor, borderWidth, borderStyle, bgcolor = color.new(labelColor, transp))
    lbl = label.new(x = x2, y = y, text = labelText, yloc = yloc.price, color = labelColor, style = label.style_none,
                  textcolor = color.new(labelColor, transpLabel), size = labelSize, textalign = textAlign)
    array.push(labelArray, lbl)
    array.push(boxArray, bx)


