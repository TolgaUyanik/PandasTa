//@version=6
indicator('Asian & London Session Two-Color Candles', overlay = true)

// === SESSION TIME SETTINGS (EDIT TO YOUR BROKER/CHART TIMEZONE) ===
// Sessions in UTC time
asian_session_start = 2300
asian_session_end = 700
london_session_start = 700
london_session_end = 1500

getSession(timeVal) =>
    // Convert built-in `time` (ms) to session integer (e.g., 945 for 9:45 UTC)
    hour = hour(timeVal)
    minute = minute(timeVal)
    hour * 100 + minute

sessTime = getSession(time)

isAsian = sessTime >= asian_session_start or sessTime < asian_session_end
isLondon = sessTime >= london_session_start and sessTime < london_session_end

// === COLOUR SETTINGS ===
asian_bull = input.color(color.blue, 'Asian Bull Candle')
asian_bear = input.color(color.navy, 'Asian Bear Candle')
london_bull = input.color(color.green, 'London Bull Candle')
london_bear = input.color(color.red, 'London Bear Candle')
other_candle = input.color(color.gray, 'Other Sessions Candle')

bull = close >= open
bear = close < open

// Select color logic
candle_col = isAsian ? bull ? asian_bull : asian_bear : isLondon ? bull ? london_bull : london_bear : other_candle

barcolor(candle_col)

// Or, if you want custom chart candles in these colors (instead of just coloring default candles):
// plotcandle(open, high, low, close, color=candle_col, bordercolor=candle_col)
