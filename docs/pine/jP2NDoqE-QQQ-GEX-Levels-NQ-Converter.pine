//@version=6
indicator("QQQ GEX Levels → NQ Converter", overlay = true)

// ─────────────────────────────────────────────
// Conversion settings
// ─────────────────────────────────────────────
groupConversion = "Conversion Settings"

qqqSymbol = input.symbol("NASDAQ:QQQ", "QQQ Symbol", group = groupConversion)

conversionMode = input.string(
     "Fixed Morning Snapshot",
     "Conversion Mode",
     options = ["Fixed Morning Snapshot", "Live Ratio"],
     group = groupConversion,
     tooltip = "Fixed Morning Snapshot keeps levels stationary. Live Ratio continuously changes them as QQQ and NQ move."
)

manualQQQ = input.float(
     0.0,
     "QQQ Price When Levels Were Collected",
     minval = 0.0,
     step = 0.01,
     group = groupConversion
)

manualNQ = input.float(
     0.0,
     "NQ Price at the Same Time",
     minval = 0.0,
     step = 0.25,
     group = groupConversion
)

// Live QQQ price. The NQ chart's close is used as the live NQ price.
liveQQQ = request.security(
     qqqSymbol,
     timeframe.period,
     close,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

useFixed = conversionMode == "Fixed Morning Snapshot"

conversionRatio =
     useFixed and manualQQQ > 0 and manualNQ > 0
     ? manualNQ / manualQQQ
     : close / liveQQQ

// Converts a QQQ strike into its estimated NQ equivalent.
convertLevel(float qqqStrike) =>
    qqqStrike > 0 and not na(conversionRatio)
         ? qqqStrike * conversionRatio
         : na

// ─────────────────────────────────────────────
// Positive gamma strikes
// ─────────────────────────────────────────────
groupPositive = "Positive Gamma — Potential Reaction"

pos1 = input.float(0.0, "Positive Gamma 1", step = 0.5, group = groupPositive)
pos2 = input.float(0.0, "Positive Gamma 2", step = 0.5, group = groupPositive)
pos3 = input.float(0.0, "Positive Gamma 3", step = 0.5, group = groupPositive)
pos4 = input.float(0.0, "Positive Gamma 4", step = 0.5, group = groupPositive)
pos5 = input.float(0.0, "Positive Gamma 5", step = 0.5, group = groupPositive)

// ─────────────────────────────────────────────
// Negative gamma strikes
// ─────────────────────────────────────────────
groupNegative = "Negative Gamma — Potential Target/Acceleration"

neg1 = input.float(0.0, "Negative Gamma 1", step = 0.5, group = groupNegative)
neg2 = input.float(0.0, "Negative Gamma 2", step = 0.5, group = groupNegative)
neg3 = input.float(0.0, "Negative Gamma 3", step = 0.5, group = groupNegative)
neg4 = input.float(0.0, "Negative Gamma 4", step = 0.5, group = groupNegative)
neg5 = input.float(0.0, "Negative Gamma 5", step = 0.5, group = groupNegative)

// ─────────────────────────────────────────────
// Converted NQ levels
// ─────────────────────────────────────────────
nqPos1 = convertLevel(pos1)
nqPos2 = convertLevel(pos2)
nqPos3 = convertLevel(pos3)
nqPos4 = convertLevel(pos4)
nqPos5 = convertLevel(pos5)

nqNeg1 = convertLevel(neg1)
nqNeg2 = convertLevel(neg2)
nqNeg3 = convertLevel(neg3)
nqNeg4 = convertLevel(neg4)
nqNeg5 = convertLevel(neg5)

// Positive gamma levels
plot(nqPos1, "Positive GEX 1", color = color.lime, linewidth = 2, style = plot.style_stepline)
plot(nqPos2, "Positive GEX 2", color = color.lime, linewidth = 2, style = plot.style_stepline)
plot(nqPos3, "Positive GEX 3", color = color.lime, linewidth = 2, style = plot.style_stepline)
plot(nqPos4, "Positive GEX 4", color = color.lime, linewidth = 2, style = plot.style_stepline)
plot(nqPos5, "Positive GEX 5", color = color.lime, linewidth = 2, style = plot.style_stepline)

// Negative gamma levels
plot(nqNeg1, "Negative GEX 1", color = color.red, linewidth = 2, style = plot.style_stepline)
plot(nqNeg2, "Negative GEX 2", color = color.red, linewidth = 2, style = plot.style_stepline)
plot(nqNeg3, "Negative GEX 3", color = color.red, linewidth = 2, style = plot.style_stepline)
plot(nqNeg4, "Negative GEX 4", color = color.red, linewidth = 2, style = plot.style_stepline)
plot(nqNeg5, "Negative GEX 5", color = color.red, linewidth = 2, style = plot.style_stepline)

// Warning when fixed mode lacks anchor prices.
missingAnchors = useFixed and (manualQQQ <= 0 or manualNQ <= 0)

bgcolor(
     missingAnchors
     ? color.new(color.orange, 85)
     : na,
     title = "Missing Snapshot Prices"
)