//@version=5
indicator("FTM → SONIC Combined Candlesticks", overlay=true)

// Grensdatums (UTC-tijd)
eindFTM = timestamp("2025-01-13 21:00 +0000")
startSONIC = timestamp("2025-01-16 08:00 +0000")

// FTM candlestickdata van Poloniex
ftmOpen  = request.security("POLONIEX:FTMUSDT", timeframe.period, open)
ftmHigh  = request.security("POLONIEX:FTMUSDT", timeframe.period, high)
ftmLow   = request.security("POLONIEX:FTMUSDT", timeframe.period, low)
ftmClose = request.security("POLONIEX:FTMUSDT", timeframe.period, close)

// SONIC candlestickdata van Binance
sonicOpen  = request.security("BINANCE:SUSDT", timeframe.period, open)
sonicHigh  = request.security("BINANCE:SUSDT", timeframe.period, high)
sonicLow   = request.security("BINANCE:SUSDT", timeframe.period, low)
sonicClose = request.security("BINANCE:SUSDT", timeframe.period, close)

// Combineer op tijd met 1ms marge voor sluiting candle
var float showOpen  = na
var float showHigh  = na
var float showLow   = na
var float showClose = na

if time < eindFTM + 1
    showOpen := ftmOpen
    showHigh := ftmHigh
    showLow := ftmLow
    showClose := ftmClose
else if time >= startSONIC
    showOpen := sonicOpen
    showHigh := sonicHigh
    showLow := sonicLow
    showClose := sonicClose
else
    showOpen := na
    showHigh := na
    showLow := na
    showClose := na

// Candles tonen als data beschikbaar is
valid = not na(showOpen) and not na(showClose)
candleColor = valid and showClose > showOpen ? color.green : color.red

plotcandle(showOpen, showHigh, showLow, showClose, title="FTM → SONIC", color=candleColor)
