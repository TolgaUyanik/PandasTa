//@version=6
indicator("Poor trend【ALT_analyst】", overlay=true, max_labels_count=500)

// 1. Parameters
int atrPeriod = input.int(10, "ATR Period")
float factor = input.float(3.0, "ATR Multiplier")

int adx_len = input.int(14, "ADX Period")
int adx_threshold = input.int(20, "ADX Threshold")

int vol_short = input.int(20, "Volume Short SMA")
int vol_long = input.int(50, "Volume Long SMA")

int z_length = input.int(50, "Z-Score Period")
int whip_length = input.int(20, "Whipsaw Period")
int whip_threshold = input.int(3, "Whipsaw Threshold")

// 2. Supertrend & Neutral Lines
float src = hl2
float atr = ta.atr(atrPeriod)
float upperBand = src + (factor * atr)
float lowerBand = src - (factor * atr)
[supertrend, direction] = ta.supertrend(factor, atrPeriod)
float inverse_supertrend = direction == -1 ? upperBand : lowerBand

color line_color = color.new(color.gray, 60)
plot_normal = plot(supertrend, color=line_color, title="Normal Line", linewidth=1, style=plot.style_linebr)
plot_inverse = plot(inverse_supertrend, color=line_color, title="Inverse Line", linewidth=1, style=plot.style_linebr)

// 3. Danger Detection Modules
// 未使用変数を破棄して警告を回避
[_, _, adx] = ta.dmi(adx_len, adx_len)
bool is_low_adx = adx < adx_threshold

float vma_s = ta.sma(volume, vol_short)
float vma_l = ta.sma(volume, vol_long)
bool is_low_vol = vma_s < vma_l

float st_width = upperBand - lowerBand
float width_mean = ta.sma(st_width, z_length)
float width_std = ta.stdev(st_width, z_length)
float width_z = width_std != 0 ? (st_width - width_mean) / width_std : 0.0
bool is_low_volatility = width_z < 0.0

// 初期バーのna伝播をnz()で防止
int flip_event = nz(ta.change(direction)) != 0 ? 1 : 0
float flip_count = math.sum(flip_event, whip_length)
bool is_whipsaw = flip_count >= whip_threshold

// Trapped: Price is strictly inside the ATR bands
bool is_trapped = high < upperBand and low > lowerBand

// 4. Danger Score Calculation (0-5)
int danger_score = 0
danger_score += is_low_adx ? 1 : 0
danger_score += is_low_vol ? 1 : 0
danger_score += is_low_volatility ? 1 : 0
danger_score += is_whipsaw ? 1 : 0
danger_score += is_trapped ? 1 : 0

// 5. Ribbon Fill (0 is transparent)
color fill_color = danger_score == 5 ? color.new(#8B0000, 30) : 
                   danger_score == 4 ? color.new(#FF0000, 45) : 
                   danger_score == 3 ? color.new(#FF4500, 60) : 
                   danger_score == 2 ? color.new(#FFA500, 70) : 
                   danger_score == 1 ? color.new(#FFD700, 80) : 
                   na 

fill(plot_normal, plot_inverse, color=fill_color, title="Danger Ribbon")

// 6. Label Plotting (Trigger on danger increase or return to PEACE)
bool is_danger_up = danger_score > nz(danger_score[1], 0)
bool is_peace = danger_score == 0 and nz(danger_score[1], 0) > 0
bool trigger_label = is_danger_up or is_peace

if trigger_label
    string txt = danger_score == 5 ? "MAX DANGER" :
                 danger_score == 4 ? "NO ENTRY" :
                 danger_score == 3 ? "DANGER" :
                 danger_score == 2 ? "STOP" :
                 danger_score == 1 ? "WAIT" :
                 "PEACE"
                 
    color bg = danger_score == 5 ? color.new(#8B0000, 0) :
               danger_score == 4 ? color.new(#FF0000, 0) :
               danger_score == 3 ? color.new(#FF4500, 0) :
               danger_score == 2 ? color.new(#FFA500, 0) :
               danger_score == 1 ? color.new(#FFD700, 0) :
               color.new(color.white, 0)
               
    color tc = (danger_score >= 3) or (danger_score == 0) ? color.white : color.black
    if danger_score == 0
        tc := color.black
    
    label.new(bar_index, high, text=txt, color=bg, textcolor=tc, style=label.style_label_down, yloc=yloc.abovebar, size=size.small)

// 7. Dashboard Table
var table danger_table = table.new(position.bottom_right, 2, 6, border_width=2, border_color=color.new(color.black, 0))
if barstate.islast
    table.cell(danger_table, 0, 0, "POOR-TREND FILTER", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(danger_table, 1, 0, danger_score == 0 ? "PEACE" : "WARNING", bgcolor=danger_score == 0 ? color.new(color.white, 0) : color.new(#8B0000, 0), text_color=danger_score == 0 ? color.black : color.white)
    
    table.cell(danger_table, 0, 1, "1. Lack of Trend (ADX)", bgcolor=color.new(color.black, 20), text_color=color.white)
    table.cell(danger_table, 1, 1, is_low_adx ? "DETECTED" : "CLEAR", bgcolor=is_low_adx ? color.new(#FFD700, 0) : color.new(color.gray, 80), text_color=is_low_adx ? color.black : color.gray)
    
    table.cell(danger_table, 0, 2, "2. Low Volume (SMA)", bgcolor=color.new(color.black, 20), text_color=color.white)
    table.cell(danger_table, 1, 2, is_low_vol ? "DETECTED" : "CLEAR", bgcolor=is_low_vol ? color.new(#FFA500, 0) : color.new(color.gray, 80), text_color=is_low_vol ? color.black : color.gray)
    
    table.cell(danger_table, 0, 3, "3. Volatility Shrinking", bgcolor=color.new(color.black, 20), text_color=color.white)
    table.cell(danger_table, 1, 3, is_low_volatility ? "DETECTED" : "CLEAR", bgcolor=is_low_volatility ? color.new(#FF4500, 0) : color.new(color.gray, 80), text_color=color.white)
    
    table.cell(danger_table, 0, 4, "4. Unstable Direction", bgcolor=color.new(color.black, 20), text_color=color.white)
    table.cell(danger_table, 1, 4, is_whipsaw ? "DETECTED" : "CLEAR", bgcolor=is_whipsaw ? color.new(#FF0000, 0) : color.new(color.gray, 80), text_color=color.white)
    
    table.cell(danger_table, 0, 5, "5. Price Stuck (Inside)", bgcolor=color.new(color.black, 20), text_color=color.white)
    table.cell(danger_table, 1, 5, is_trapped ? "DETECTED" : "CLEAR", bgcolor=is_trapped ? color.new(#8B0000, 0) : color.new(color.gray, 80), text_color=color.white)