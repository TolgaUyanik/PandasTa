//@version=5
indicator("Smart Price Divergence (MACD Filter) + EMA", overlay=true)

// === INPUTS ===
fast = input.int(12, "MACD Fast Length")
slow = input.int(26, "MACD Slow Length")
signal = input.int(9, "MACD Signal Length")
emaLen = input.int(200, "EMA Length")

// === CALC ===
[macdLine, signalLine, _] = ta.macd(close, fast, slow, signal)
ema = ta.ema(close, emaLen)

// === PRICE HIGH/LOW ===
priceHigh = ta.highest(close, 5)
priceLow  = ta.lowest(close, 5)

// === DIVERGENCE ===
// Bearish: цена делает higher high, MACD lower high
bearDiv = close > close[1] and macdLine < macdLine[1] and close > ema
// Bullish: цена делает lower low, MACD higher low
bullDiv = close < close[1] and macdLine > macdLine[1] and close < ema

// === PLOT ===
plot(ema, color=color.orange)
plotshape(bullDiv, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Bull Div")
plotshape(bearDiv, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Bear Div")

// === ALERT ===
alertcondition(bullDiv, title="Bullish Divergence", message="🟢 Bullish Divergence detected — check for LONG")
alertcondition(bearDiv, title="Bearish Divergence", message="🔴 Bearish Divergence detected — check for SHORT")
