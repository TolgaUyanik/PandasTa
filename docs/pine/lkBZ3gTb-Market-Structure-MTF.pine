//@version=6
indicator("Market Structure — BOS / CHoCH / HH-HL-LH-LL [MTF]", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─────────── Inputs ───────────
grpS = "Structure"
strTF   = input.timeframe("", "Structure Timeframe (blank = chart TF)", group = grpS,
     tooltip = "Leave blank to use the chart timeframe. Set to 60 to read 1H structure while on a 10m chart.")
pvLen   = input.int(5, "Pivot Strength", minval = 1, maxval = 50, group = grpS,
     tooltip = "Bars required each side to confirm a swing. Higher = fewer, more significant swings.")
confirm = input.string("Close", "Break Confirmation", options = ["Close", "Wick"], group = grpS)

grpD = "Display"
showSw    = input.bool(true,  "Show HH / HL / LH / LL labels", group = grpD)
showBOS   = input.bool(true,  "Show BOS", group = grpD)
showCHOCH = input.bool(true,  "Show CHoCH", group = grpD)
showLvl   = input.bool(true,  "Show live structure levels", group = grpD)
showTable = input.bool(true,  "Show bias dashboard", group = grpD)
lblOffMlt = input.float(0.25, "Label Offset (× ATR)", minval = 0, step = 0.05, group = grpD)

grpC = "Colors"
cBull = input.color(color.new(#26a69a, 0), "Bullish", group = grpC, inline = "c")
cBear = input.color(color.new(#ef5350, 0), "Bearish", group = grpC, inline = "c")
cNeut = input.color(color.new(#787b86, 0), "Neutral", group = grpC, inline = "c")

// ─────────── Structure-TF pivots ───────────
tf     = strTF == "" ? timeframe.period : strTF
atrOff = ta.atr(14) * lblOffMlt

f_piv() =>
    ph = ta.pivothigh(high, pvLen, pvLen)
    pl = ta.pivotlow(low,  pvLen, pvLen)
    [ph, pl, high[pvLen], low[pvLen], close[pvLen], time[pvLen]]

[phv, plv, phPrice, plPrice, pvClose, pvTime] = request.security(syminfo.tickerid, tf, f_piv(), lookahead = barmerge.lookahead_off)

newPH = not na(phv) and (na(phv[1]) or phv != phv[1] or pvTime != pvTime[1])
newPL = not na(plv) and (na(plv[1]) or plv != plv[1] or pvTime != pvTime[1])

// ─────────── State ───────────
var float swH       = na
var float swL       = na
var float swHClose  = na
var float swLClose  = na
var float prevSwH   = na
var float prevSwL   = na
var float prevSwHCl = na
var float prevSwLCl = na
var int   swHBar    = na
var int   swLBar    = na
var int   trend     = 0
var bool  swHBroken = false
var bool  swLBroken = false

f_anchorBar(int t) =>
    bi = bar_index
    for i = 0 to math.min(bar_index, 500)
        if time[i] <= t
            bi := bar_index - i
            break
    bi

// ─────────── Register new swings ───────────
if newPH
    prevSwH   := swH
    prevSwHCl := swHClose
    swH       := phPrice
    swHClose  := pvClose
    swHBar    := f_anchorBar(pvTime)
    swHBroken := false
    if showSw
        lbl = na(prevSwHCl) ? "SH" : (pvClose > prevSwHCl and phPrice > prevSwH) ? "HH" : "LH"
        label.new(swHBar, phPrice + atrOff, lbl, style = label.style_label_down, textcolor = chart.fg_color,
             color = color.new(chart.bg_color, 100), size = size.small)

if newPL
    prevSwL   := swL
    prevSwLCl := swLClose
    swL       := plPrice
    swLClose  := pvClose
    swLBar    := f_anchorBar(pvTime)
    swLBroken := false
    if showSw
        lbl = na(prevSwLCl) ? "SL" : (pvClose < prevSwLCl and plPrice < prevSwL) ? "LL" : "HL"
        label.new(swLBar, plPrice - atrOff, lbl, style = label.style_label_up, textcolor = chart.fg_color,
             color = color.new(chart.bg_color, 100), size = size.small)

// ─────────── Break tests ───────────
upSrc   = confirm == "Close" ? close : high
downSrc = confirm == "Close" ? close : low

brokeHigh = not na(swH) and not swHBroken and upSrc   > swH
brokeLow  = not na(swL) and not swLBroken and downSrc < swL

f_draw(float lvl, int fromBar, string txt, color col, bool dashed, bool isBull) =>
    line.new(fromBar, lvl, bar_index, lvl, color = col, width = 2,
         style = dashed ? line.style_dashed : line.style_solid)
    label.new(math.round(math.avg(fromBar, bar_index)), lvl + (isBull ? atrOff : -atrOff), txt,
         style = isBull ? label.style_label_down : label.style_label_up,
         yloc = yloc.price, textcolor = col,
         color = color.new(chart.bg_color, 100), size = size.small)

bosUp = false, bosDn = false, chochUp = false, chochDn = false

if brokeHigh
    isChoch = trend <= 0 and trend != 0
    if isChoch
        chochUp := true
        if showCHOCH
            f_draw(swH, swHBar, "CHoCH", cBull, confirm == "Wick", true)
    else
        bosUp := true
        if showBOS and trend == 1
            f_draw(swH, swHBar, "BOS", cBull, confirm == "Wick", true)
    trend     := 1
    swHBroken := true

if brokeLow
    isChoch = trend >= 0 and trend != 0
    if isChoch
        chochDn := true
        if showCHOCH
            f_draw(swL, swLBar, "CHoCH", cBear, confirm == "Wick", false)
    else
        bosDn := true
        if showBOS and trend == -1
            f_draw(swL, swLBar, "BOS", cBear, confirm == "Wick", false)
    trend     := -1
    swLBroken := true

// ─────────── Live levels ───────────
var line lnH = na
var line lnL = na
if showLvl and barstate.islast
    line.delete(lnH)
    line.delete(lnL)
    if not na(swH)
        lnH := line.new(swHBar, swH, bar_index + 10, swH, color = color.new(cBear, 40), style = line.style_dotted)
    if not na(swL)
        lnL := line.new(swLBar, swL, bar_index + 10, swL, color = color.new(cBull, 40), style = line.style_dotted)

// ─────────── Dashboard ───────────
biasCol = trend == 1 ? cBull : trend == -1 ? cBear : cNeut

var table tbl = table.new(position.top_right, 2, 5, border_width = 1)
if showTable and barstate.islast
    table.cell(tbl, 0, 0, "Structure TF", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 0, tf, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 1, "Bias", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 1, trend == 1 ? "Bullish" : trend == -1 ? "Bearish" : "Undefined",
         text_color = color.white, bgcolor = biasCol, text_size = size.small)
    table.cell(tbl, 0, 2, "Swing High", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 2, na(swH) ? "—" : str.tostring(swH, format.mintick), text_color = cBear, text_size = size.small)
    table.cell(tbl, 0, 3, "Swing Low", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 3, na(swL) ? "—" : str.tostring(swL, format.mintick), text_color = cBull, text_size = size.small)
    table.cell(tbl, 0, 4, "CHoCH level", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 4, trend == 1 ? (na(swL) ? "—" : str.tostring(swL, format.mintick))
                        : trend == -1 ? (na(swH) ? "—" : str.tostring(swH, format.mintick)) : "—",
         text_color = chart.fg_color, text_size = size.small)

// ─────────── Alerts ───────────
alertcondition(bosUp,   "Bullish BOS",   "Bullish Break of Structure")
alertcondition(bosDn,   "Bearish BOS",   "Bearish Break of Structure")
alertcondition(chochUp, "Bullish CHoCH", "Bullish Change of Character")
alertcondition(chochDn, "Bearish CHoCH", "Bearish Change of Character")

plotshape(chochUp, "CHoCH Up", shape.triangleup,   location.belowbar, cBull, size = size.tiny)
plotshape(chochDn, "CHoCH Dn", shape.triangledown, location.abovebar, cBear, size = size.tiny)