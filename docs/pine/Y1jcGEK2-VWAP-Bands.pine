//@version=6
indicator(" VVWAP Bands", shorttitle="CC VWAP", overlay=true)

// ===== Ancora =====
gA = "Ancora"
anchorSel = input.string("Sessao RTH", "Reset da VWAP", options=["Sessao RTH", "Dia", "Semana", "Mes"], group=gA)
sessRTH   = input.session("0930-1600", "Horario RTH", group=gA)
sessTZ    = input.string("America/New_York", "Fuso da sessao", group=gA)
src       = input.source(hlc3, "Fonte", group=gA)

// ===== Bandas =====
gB = "Bandas"
showBands = input.bool(true, "Mostrar bandas", group=gB)
m1 = input.float(1.0, "Desvio 1", step=0.5, minval=0, group=gB)
m2 = input.float(2.0, "Desvio 2", step=0.5, minval=0, group=gB)
m3 = input.float(3.0, "Desvio 3", step=0.5, minval=0, group=gB)

// ===== Visual =====
gV = "Visual"
cVwap = input.color(color.orange, "Cor VWAP", group=gV)
c1 = input.color(color.teal,   "Cor +/-1", group=gV)
c2 = input.color(color.blue,   "Cor +/-2", group=gV)
c3 = input.color(color.purple, "Cor +/-3", group=gV)
showLabels = input.bool(true, "Rotulos de preco", group=gV)
showTable  = input.bool(true, "Tabela de status", group=gV)
showArrows = input.bool(false, "Setas de cruzamento da VWAP", group=gV)
tblPosSel  = input.string("Superior direita", "Posicao da tabela", options=["Superior direita","Superior esquerda","Inferior direita","Inferior esquerda"], group=gV)

// ===== Alertas =====
alertBand = input.float(2.0, "Banda para alerta de toque", step=0.5, minval=0, group="Alertas")

// ===== Ancora (calculo do reset) =====
inRTH  = not na(time(timeframe.period, sessRTH, sessTZ))
newRTH = inRTH and not inRTH[1]
newPeriod = switch anchorSel
    "Sessao RTH" => newRTH
    "Semana"     => timeframe.change("W")
    "Mes"        => timeframe.change("M")
    => timeframe.change("D")

// ===== VWAP + desvio-padrao =====
[vwapVal, up1, _lo1] = ta.vwap(src, newPeriod, 1.0)
dev = up1 - vwapVal
u1 = vwapVal + m1 * dev
l1 = vwapVal - m1 * dev
u2 = vwapVal + m2 * dev
l2 = vwapVal - m2 * dev
u3 = vwapVal + m3 * dev
l3 = vwapVal - m3 * dev

// ===== Plots =====
plot(vwapVal, "VWAP", color=cVwap, linewidth=2)
p_u1 = plot(showBands ? u1 : na, "+1 dev", color=color.new(c1, 40))
p_l1 = plot(showBands ? l1 : na, "-1 dev", color=color.new(c1, 40))
p_u2 = plot(showBands ? u2 : na, "+2 dev", color=color.new(c2, 30))
p_l2 = plot(showBands ? l2 : na, "-2 dev", color=color.new(c2, 30))
p_u3 = plot(showBands ? u3 : na, "+3 dev", color=color.new(c3, 20))
p_l3 = plot(showBands ? l3 : na, "-3 dev", color=color.new(c3, 20))
fill(p_u1, p_l1, color=color.new(c1, 92), title="Zona +/-1")

// ===== Sinais visuais =====
crossUp = ta.crossover(close, vwapVal)
crossDn = ta.crossunder(close, vwapVal)
plotshape(showArrows and crossUp, "Cruz cima",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.tiny)
plotshape(showArrows and crossDn, "Cruz baixo", shape.triangledown, location.abovebar, color.new(color.red, 0),  size=size.tiny)

// ===== Rotulos de preco nas bandas =====
f_lbl(_id, _price, _txt, _col) =>
    label.set_xy(_id, bar_index + 3, _price)
    label.set_text(_id, _txt)
    label.set_textcolor(_id, _col)

var label lbV  = label.new(na, na, "", style=label.style_none, size=size.small)
var label lbU1 = label.new(na, na, "", style=label.style_none, size=size.small)
var label lbL1 = label.new(na, na, "", style=label.style_none, size=size.small)
var label lbU2 = label.new(na, na, "", style=label.style_none, size=size.small)
var label lbL2 = label.new(na, na, "", style=label.style_none, size=size.small)
var label lbU3 = label.new(na, na, "", style=label.style_none, size=size.small)
var label lbL3 = label.new(na, na, "", style=label.style_none, size=size.small)

if barstate.islast
    lblOn  = showLabels
    bandOn = showLabels and showBands
    f_lbl(lbV,  vwapVal, lblOn  ? "VWAP " + str.tostring(vwapVal, format.mintick) : "", cVwap)
    f_lbl(lbU1, u1, bandOn ? "+1 " + str.tostring(u1, format.mintick) : "", c1)
    f_lbl(lbL1, l1, bandOn ? "-1 " + str.tostring(l1, format.mintick) : "", c1)
    f_lbl(lbU2, u2, bandOn ? "+2 " + str.tostring(u2, format.mintick) : "", c2)
    f_lbl(lbL2, l2, bandOn ? "-2 " + str.tostring(l2, format.mintick) : "", c2)
    f_lbl(lbU3, u3, bandOn ? "+3 " + str.tostring(u3, format.mintick) : "", c3)
    f_lbl(lbL3, l3, bandOn ? "-3 " + str.tostring(l3, format.mintick) : "", c3)

// ===== Tabela de status =====
f_pos(_s) =>
    switch _s
        "Superior esquerda" => position.top_left
        "Inferior direita"  => position.bottom_right
        "Inferior esquerda" => position.bottom_left
        => position.top_right

var table t = table.new(f_pos(tblPosSel), 2, 5, border_width=1, frame_color=color.new(color.gray, 40), frame_width=1)
if barstate.islast and showTable
    dist = close - vwapVal
    sig  = dev != 0 ? dist / dev : 0.0
    absS = math.abs(sig)
    zona = absS <= m1 ? "Dentro +/-1" : absS <= m2 ? "Entre 1 e 2" : absS <= m3 ? "Entre 2 e 3" : "Extremo (>3)"
    acima = close >= vwapVal
    regCol = acima ? color.new(color.green, 0) : color.new(color.red, 0)
    hdr = color.new(color.gray, 30)
    table.cell(t, 0, 0, "VWAP",        text_color=color.white, bgcolor=hdr, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(vwapVal, format.mintick), text_color=color.orange, text_size=size.small)
    table.cell(t, 0, 1, "Preco",       text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(close, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "Dist (pts)",  text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(dist, format.mintick), text_color=regCol, text_size=size.small)
    table.cell(t, 0, 3, "Dist (sigma)",text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(sig, "#.00"), text_color=regCol, text_size=size.small)
    table.cell(t, 0, 4, "Zona",        text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, zona, text_color=regCol, text_size=size.small)

// ===== Alertas (voce liga na UI) =====
uAlert = vwapVal + alertBand * dev
lAlert = vwapVal - alertBand * dev
alertcondition(crossUp,        "Preco cruzou VWAP para CIMA",  "Preco cruzou a VWAP para cima")
alertcondition(crossDn,        "Preco cruzou VWAP para BAIXO", "Preco cruzou a VWAP para baixo")
alertcondition(high >= uAlert, "Tocou banda superior",         "Preco tocou a banda superior")
alertcondition(low  <= lAlert, "Tocou banda inferior",         "Preco tocou a banda inferior")
