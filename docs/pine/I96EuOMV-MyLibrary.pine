//@version=5

// @description This library contains various trading strategies and utility functions for Pine Script.
library("MyLibrary")

// @function simple_moving_average
// @description Calculates the Simple Moving Average (SMA) of a given series.
// @param src (series float) The input series (e.g., close prices).
// @param length (int) The number of periods to use for the SMA calculation.
// @returns (series float) The calculated SMA series.
export simple_moving_average(series float src, int length) =>
    ta.sma(src, length)

// @function exponential_moving_average
// @description Calculates the Exponential Moving Average (EMA) of a given series.
// @param src (series float) The input series (e.g., close prices).
// @param length (int) The number of periods to use for the EMA calculation.
// @returns (series float) The calculated EMA series.
export exponential_moving_average(series float src, int length) =>
    ta.ema(src, length)

// @function safe_division
// @description Performs division with error handling for division by zero.
// @param numerator (float) The numerator for the division.
// @param denominator (float) The denominator for the division.
// @returns (float) The result of the division, or na if the denominator is zero.
export safe_division(float numerator, float denominator) =>
    denominator == 0 ? na : numerator / denominator

// @function strategy_moving_average_crossover
// @description Implements a Moving Average Crossover strategy.
// @param shortLength (int) The length for the short period SMA.
// @param longLength (int) The length for the long period SMA.
// @returns (series float, series float, series bool, series bool) The short SMA, long SMA, crossover signals, and crossunder signals.
export strategy_moving_average_crossover(int shortLength, int longLength) =>
    shortSMA = simple_moving_average(close, shortLength)
    longSMA = simple_moving_average(close, longLength)
    crossover = ta.crossover(shortSMA, longSMA)
    crossunder = ta.crossunder(shortSMA, longSMA)
    [shortSMA, longSMA, crossover, crossunder]

// @function strategy_rsi
// @description Implements an RSI-based trading strategy.
// @param rsiLength (int) The length for the RSI calculation.
// @param overbought (float) The overbought threshold.
// @param oversold (float) The oversold threshold.
// @returns (series float, series bool, series bool) The RSI values, long signals, and short signals.
export strategy_rsi(int rsiLength, float overbought, float oversold) =>
    rsiValue = ta.rsi(close, rsiLength)
    longSignal = rsiValue < oversold
    shortSignal = rsiValue > overbought
    [rsiValue, longSignal, shortSignal]

// @function ichimoku_cloud
// @description Computes Ichimoku Cloud components.
// @param convPeriod (int) The conversion line period.
// @param basePeriod (int) The base line period.
// @param laggingSpan2Period (int) The lagging span 2 period.
// @returns (series float, series float, series float, series float, series float) The conversion line, base line, leading span A, leading span B, and lagging span.
export ichimoku_cloud(int convPeriod, int basePeriod, int spanBPeriod, int laggingSpanPeriod) =>
    conversionLine = ta.sma(ta.highest(high, convPeriod) + ta.lowest(low, convPeriod), 2)
    baseLine = ta.sma(ta.highest(high, basePeriod) + ta.lowest(low, basePeriod), 2)
    leadingSpanA = ta.sma(conversionLine + baseLine, 2)
    leadingSpanB = ta.sma(ta.highest(high, spanBPeriod) + ta.lowest(low, spanBPeriod), 2)
    laggingSpan = close[laggingSpanPeriod]
    [conversionLine, baseLine, leadingSpanA, leadingSpanB, laggingSpan]

// @function strategy_ichimoku_conversion_baseline
// @description Implements an Ichimoku Conversion Line and Baseline strategy.
// @returns (series float, series float, series bool, series bool) The conversion line, baseline, crossover signals, and crossunder signals.
export strategy_ichimoku_conversion_baseline() =>
    [conversionLine, baseLine, leadingSpanA, leadingSpanB, laggingSpan] = ichimoku_cloud(9, 26, 52, 26)
    crossover = ta.crossover(conversionLine, baseLine)
    crossunder = ta.crossunder(conversionLine, baseLine)
    [conversionLine, baseLine, crossover, crossunder]

// Debugging and Error Handling Functions

// @function debug_print
// @description Prints values to the chart for debugging purposes.
// @param labelText (string) The label text.
// @param value (float) The value to display.
// @param barIndex (int) The bar index where the label should be displayed.
export debug_print(string labelText, float value, int barIndex) =>
    label.new(x=barIndex, y=value, text=labelText + ": " + str.tostring(value), color=color.red)
