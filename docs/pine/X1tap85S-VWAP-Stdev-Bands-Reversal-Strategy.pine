//@version=6
strategy("VWAP Stdev Bands Reversal Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, process_orders_on_close=true, calc_on_every_tick=false, margin_long=1, margin_short=1, commission_type=strategy.commission.percent, commission_value=0.02, slippage=0)

// ----- Band inputs (from original) -----
devUp1 = input.float(1.28, title="Stdev above (1)")
devDn1 = input.float(1.28, title="Stdev below (1)")
devUp2 = input.float(2.01, title="Stdev above (2)")
devDn2 = input.float(2.01, title="Stdev below (2)")
devUp3 = input.float(2.51, title="Stdev above (3)")
devDn3 = input.float(2.51, title="Stdev below (3)")
devUp4 = input.float(3.09, title="Stdev above (4)")
devDn4 = input.float(3.09, title="Stdev below (4)")
devUp5 = input.float(4.01, title="Stdev above (5)")
devDn5 = input.float(4.01, title="Stdev below (5)")

showDv2 = input.bool(true,  title="Show second group of bands?")
showDv3 = input.bool(true,  title="Show third group of bands?")
showDv4 = input.bool(false, title="Show fourth group of bands?")
showDv5 = input.bool(false, title="Show fifth group of bands?")
showPrevVWAP = input.bool(false, title="Show previous VWAP close")

// ----- Signal inputs -----
extremeBand = input.int(3, title="Most extreme band (1-5)", minval=1, maxval=5, group="Signals")
secondBand  = input.int(2, title="Second most extreme band (1-5)", minval=1, maxval=5, group="Signals")
swingLen    = input.int(5, title="Swing lookback for stop (bars)", minval=1, group="Signals")
armExpiry   = input.int(500, title="Arm expiry (bars to wait for reversal)", minval=1, group="Signals")
sessionWarmup = input.int(3, title="Skip first N bars of session (VWAP warmup)", minval=0, group="Signals")
sessionCutoff = input.int(5, title="Skip last N bars of session (end-of-day)", minval=0, group="Signals")
showSignals = input.bool(true, title="Show reversal arrows", group="Signals")
minRR       = input.float(1.5, title="Minimum Risk:Reward", minval=0, step=0.1, group="Strategy")
reverseOpp  = input.bool(true, title="Opposite signal closes/reverses trade", group="Strategy")
useLimit    = input.bool(true, title="Use resting limit entries (maker)", group="Strategy")
limitExpiry = input.int(3, title="Limit order expiry (bars)", minval=1, group="Strategy")
riskPct     = input.float(1.0, title="Risk per trade (% of equity)", minval=0.01, step=0.1, group="Strategy")
useRiskSize = input.bool(true, title="Size by stop-loss risk (fixed-fractional)", group="Strategy")
maxLeverage = input.float(5.0, title="Max leverage (position notional / equity cap)", minval=0.1, step=0.5, group="Strategy")

// ----- VWAP & stdev (session reset) -----
newSession = timeframe.change("D")

var float vwapsum   = na
var float volumesum = na
var float v2sum     = na
vwapsum   := newSession ? hl2 * volume        : nz(vwapsum[1])   + hl2 * volume
volumesum := newSession ? volume              : nz(volumesum[1]) + volume
v2sum     := newSession ? volume * hl2 * hl2   : nz(v2sum[1])     + volume * hl2 * hl2
myvwap = vwapsum / volumesum
dev = math.sqrt(math.max(v2sum / volumesum - myvwap * myvwap, 0))

// ----- Plots (original) -----
A  = plot(myvwap, style=plot.style_circles, title="VWAP", color=color.black)
U1 = plot(myvwap + devUp1 * dev, style=plot.style_circles, title="VWAP Upper", color=color.gray)
D1 = plot(myvwap - devDn1 * dev, style=plot.style_circles, title="VWAP Lower", color=color.gray)

U2 = plot(showDv2 ? myvwap + devUp2 * dev : na, color=color.red,   title="VWAP Upper (2)")
D2 = plot(showDv2 ? myvwap - devDn2 * dev : na, color=color.green, title="VWAP Lower (2)")
U3 = plot(showDv3 ? myvwap + devUp3 * dev : na, color=color.red,   title="VWAP Upper (3)")
D3 = plot(showDv3 ? myvwap - devDn3 * dev : na, color=color.green, title="VWAP Lower (3)")
U4 = plot(showDv4 ? myvwap + devUp4 * dev : na, color=color.red,   title="VWAP Upper (4)")
D4 = plot(showDv4 ? myvwap - devDn4 * dev : na, color=color.green, title="VWAP Lower (4)")
U5 = plot(showDv5 ? myvwap + devUp5 * dev : na, color=color.red,   title="VWAP Upper (5)")
D5 = plot(showDv5 ? myvwap - devDn5 * dev : na, color=color.green, title="VWAP Lower (5)")

var float prevwap = na
prevwap := newSession ? myvwap[1] : prevwap[1]
plot(showPrevVWAP ? prevwap : na, style=plot.style_circles, color=close > prevwap ? color.green : color.red)

fill(U1, U2, color=color.new(color.red,   90), title="Over Bought Fill 1")
fill(D1, D2, color=color.new(color.green, 90), title="Over Sold Fill 1")
fill(U2, U3, color=color.new(color.red,   90), title="Over Bought Fill 2")
fill(D2, D3, color=color.new(color.green, 90), title="Over Sold Fill 2")
fill(U3, U4, color=color.new(color.red,   90), title="Over Bought Fill 3")
fill(D3, D4, color=color.new(color.green, 90), title="Over Sold Fill 3")
fill(U4, U5, color=color.new(color.red,   90), title="Over Bought Fill 4")
fill(D4, D5, color=color.new(color.green, 90), title="Over Sold Fill 4")
fill(A, U1,  color=color.new(color.gray,  90), title="Middle Fill Up")
fill(A, D1,  color=color.new(color.gray,  90), title="Middle Fill Down")

// ----- Band level helpers -----
upMult(n) => n == 1 ? devUp1 : n == 2 ? devUp2 : n == 3 ? devUp3 : n == 4 ? devUp4 : devUp5
dnMult(n) => n == 1 ? devDn1 : n == 2 ? devDn2 : n == 3 ? devDn3 : n == 4 ? devDn4 : devDn5

upExt = myvwap + upMult(extremeBand) * dev
dnExt = myvwap - dnMult(extremeBand) * dev
up2nd = myvwap + upMult(secondBand)  * dev
dn2nd = myvwap - dnMult(secondBand)  * dev

// Debug: visualize the exact levels the signal logic uses
plot(upExt, title="DBG Up Extreme",  color=color.new(color.orange, 0), linewidth=1)
plot(dnExt, title="DBG Dn Extreme",  color=color.new(color.orange, 0), linewidth=1)
plot(up2nd, title="DBG Up 2nd",      color=color.new(color.blue, 0),   linewidth=1)
plot(dn2nd, title="DBG Dn 2nd",      color=color.new(color.blue, 0),   linewidth=1)

// ----- Triggers -----
// Up overextension: high reaches most-extreme band OR close beyond 2nd-most-extreme => arm SHORT
// Down overextension: low reaches most-extreme band OR close beyond 2nd-most-extreme => arm LONG
upTrigger0 = (high >= upExt) or (close > up2nd)
dnTrigger0 = (low  <= dnExt) or (close < dn2nd)

// Count bars since session start. During the VWAP warmup window, dev is
// computed off too few bars and the bands pinch — suppress arming there.
var int barsSinceSession = 0
barsSinceSession := newSession ? 0 : barsSinceSession + 1
warmupOK = barsSinceSession >= sessionWarmup

// Learn the length of the PREVIOUS completed session so we can estimate how
// close we are to the end of the current one (adapts to timeframe/instrument).
var int prevSessionLen = na
var int runningLen     = 0
if newSession
    prevSessionLen := runningLen   // length the just-finished session reached
    runningLen     := 0
else
    runningLen += 1

// We're in the end-of-day cutoff zone if we're within sessionCutoff bars of
// the prior session's length. If we don't yet know a prior length, don't cut.
cutoffOK = na(prevSessionLen) or sessionCutoff == 0 ? true : barsSinceSession < (prevSessionLen - sessionCutoff)

sessionOK = warmupOK and cutoffOK

upTrigger = upTrigger0 and sessionOK
dnTrigger = dnTrigger0 and sessionOK

var bool armShort = false
var bool armLong  = false
var int  shortAge = 0   // bars since short arm was set
var int  longAge  = 0

// Reset arm state at the start of each session so nothing carries over.
if newSession
    armShort := false
    armLong  := false
    shortAge := 0
    longAge  := 0

// Expire arms that have waited too long without a reversal candle.
if armShort
    shortAge += 1
    if shortAge > armExpiry
        armShort := false
if armLong
    longAge += 1
    if longAge > armExpiry
        armLong := false

// Arm from THIS bar's overextension first, so the arming candle itself
// can serve as the reversal/entry candle on the same bar.
if upTrigger
    armShort := true
    shortAge := 0
if dnTrigger
    armLong := true
    longAge := 0

bullCandle = close > open
bearCandle = close < open

// Evaluate signals on the current bar against the (now possibly just-armed) state.
// A reversal candle triggers a signal. But if its body has already closed
// past the centre line (VWAP), cancel the arm entirely — no entry, and it
// won't fire later. The arm only comes back on a fresh overextension.
longSignal  = armLong  and bullCandle and close <= myvwap
shortSignal = armShort and bearCandle and close >= myvwap

longCancel  = armLong  and bullCandle and close > myvwap
shortCancel = armShort and bearCandle and close < myvwap

// Disarm once the direction either fires OR is cancelled by closing past VWAP.
if longSignal or longCancel
    armLong := false
if shortSignal or shortCancel
    armShort := false

// ----- Stop / target levels -----
longStop  = ta.lowest(low,  swingLen)
shortStop = ta.highest(high, swingLen)
tpLong  = up2nd   // long targets opposite (upper) 2nd band
tpShort = dn2nd   // short targets opposite (lower) 2nd band

// ----- Risk:Reward filter (entry assumed at candle close) -----
longRisk   = close - longStop
longReward = tpLong - close
longRR     = longRisk > 0 ? longReward / longRisk : 0

shortRisk   = shortStop - close
shortReward = close - tpShort
shortRR     = shortRisk > 0 ? shortReward / shortRisk : 0

longOK  = longSignal  and longRR  >= minRR
shortOK = shortSignal and shortRR >= minRR

// ----- Strategy orders -----
// Only act on a genuine new entry: when flat, or (if reverseOpp) when flipping
// from the opposite side. Never re-issue an entry while already in that
// direction — doing so detaches the resting exit and leaves trades stuck open.
flat      = strategy.position_size == 0
isLong    = strategy.position_size > 0
isShort   = strategy.position_size < 0

enterLong  = longOK  and (flat or (reverseOpp and isShort))
enterShort = shortOK and (flat or (reverseOpp and isLong))

// Track resting limit orders so we can cancel them after limitExpiry bars.
var float longLimitPrice  = na
var float shortLimitPrice = na
var int   longOrderAge    = na
var int   shortOrderAge   = na
var float longStopAtSig   = na   // stop captured at signal (limit fills later)
var float shortStopAtSig  = na
var float longTpAtSig     = na
var float shortTpAtSig    = na

// Helper: risk-based qty from a given entry price and stop.
// Guard against non-positive equity (a deep drawdown can drive it <= 0,
// which would otherwise produce a negative qty and a runtime error).
// Cap the size so notional never exceeds maxLeverage x equity. When the cap
// binds (very tight stop), actual risk on that trade is BELOW the target %,
// which is the safe direction to err.
qtyFor(entryPrice, stopPrice) =>
    rpu = math.abs(entryPrice - stopPrice)
    eq  = math.max(strategy.equity, 0)
    riskQty = useRiskSize and rpu > 0 and eq > 0 ? (eq * riskPct / 100) / rpu : na
    maxQty  = entryPrice > 0 and eq > 0 ? (eq * maxLeverage) / entryPrice : na
    na(riskQty) ? na : (na(maxQty) ? riskQty : math.min(riskQty, maxQty))

if enterLong
    if isShort
        strategy.close("Short")
    if useLimit
        // Resting limit at the signal candle's close; size off that price.
        longLimitPrice := close
        longStopAtSig  := longStop
        longTpAtSig     := tpLong
        longOrderAge   := 0
        q = qtyFor(longLimitPrice, longStopAtSig)
        if not na(q)
            strategy.entry("Long", strategy.long, qty=q, limit=longLimitPrice)
        else
            strategy.entry("Long", strategy.long, limit=longLimitPrice)
    else
        q = qtyFor(close, longStop)
        if not na(q)
            strategy.entry("Long", strategy.long, qty=q)
        else
            strategy.entry("Long", strategy.long)
        strategy.exit("Long X", from_entry="Long", stop=longStop, limit=tpLong)

if enterShort
    if isLong
        strategy.close("Long")
    if useLimit
        shortLimitPrice := close
        shortStopAtSig  := shortStop
        shortTpAtSig     := tpShort
        shortOrderAge   := 0
        q = qtyFor(shortLimitPrice, shortStopAtSig)
        if not na(q)
            strategy.entry("Short", strategy.short, qty=q, limit=shortLimitPrice)
        else
            strategy.entry("Short", strategy.short, limit=shortLimitPrice)
    else
        q = qtyFor(close, shortStop)
        if not na(q)
            strategy.entry("Short", strategy.short, qty=q)
        else
            strategy.entry("Short", strategy.short)
        strategy.exit("Short X", from_entry="Short", stop=shortStop, limit=tpShort)

// ----- Manage resting limit orders (expiry + attach exit once filled) -----
if useLimit
    // Age and cancel unfilled long limit
    if not na(longOrderAge) and strategy.position_size <= 0
        longOrderAge += 1
        if longOrderAge > limitExpiry
            strategy.cancel("Long")
            longOrderAge := na
    // Once the long limit has filled, attach its stop/target (captured at signal)
    if isLong and not na(longStopAtSig)
        strategy.exit("Long X", from_entry="Long", stop=longStopAtSig, limit=longTpAtSig)
        longStopAtSig := na
        longOrderAge  := na

    if not na(shortOrderAge) and strategy.position_size >= 0
        shortOrderAge += 1
        if shortOrderAge > limitExpiry
            strategy.cancel("Short")
            shortOrderAge := na
    if isShort and not na(shortStopAtSig)
        strategy.exit("Short X", from_entry="Short", stop=shortStopAtSig, limit=shortTpAtSig)
        shortStopAtSig := na
        shortOrderAge  := na

// ----- Arrows (reflect R:R-filtered entries) -----
plotshape(showSignals and longOK,  title="Long Entry",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small, text="L")
plotshape(showSignals and shortOK, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small, text="S")

// ----- DIAGNOSTIC: show actual position state & exits -----
// Tinted background = currently in a position (green long / red short).
bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : strategy.position_size < 0 ? color.new(color.red, 90) : na, title="Position state")
// Mark the bar where position size actually changes (any fill).
posChanged = strategy.position_size != strategy.position_size[1]
plotchar(posChanged, title="Fill", char="•", location=location.top, color=color.yellow, size=size.tiny)

// ----- Alerts -----
alertcondition(longOK,  title="Long Entry",  message="VWAP Long entry signal")
alertcondition(shortOK, title="Short Entry", message="VWAP Short entry signal")
