//@version=6

// @description This library will create order blocks and fair value gaps according to the settings provided.
library("PDArrays")

import mickes/Touched/17
import mickes/PriceAction/9

//@enum Tells if the intended direction is bullish, bearish or both.
//@field Bearish Bearish direction.
//@field Bullish Bullish direction.
//@field Both Bullish and bearish direction.
export enum Direction
    Bearish
    Bullish
    Both
//@type Holds the visual elements or the zone.
//@field Boxes All the visual boxes.
//@field Lines All the visual lines.
//@field Labels All the visual labels.
export type Visual
    array<box> Boxes
    array<line> Lines
    array<label> Labels
//@enum Holds the different types of PD Arrays that this library can create.
//@field FairValueGap The type is fair value gap.
//@field InversionFairValueGap The type is inversion fair value gap.
//@field OrderBlock The type is order block.
//@field BreakerBlock The type is breaker block.
//@field MitigationBlock The type is mitigation block.
export enum Type
    FairValueGap = "Fair value gap"
    InversionFairValueGap = "Inversion fair value gap"

    OrderBlock = "Order block"
    BreakerBlock = "Breaker block"
    MitigationBlock = "Mitigation block"
//@type The settings for confirmation pivots.
//@field LeftLength The left length used to find pivots.
//@field RightLength The right length used to find pivots.
//@field Show If found confirmation pivots should be displayed.
//@field Lookback How many pivots back to takaction on.
//@field Timeframe What timeframe that should be used to find pivots.
export type ConfirmationPivotSettings
    int LeftLength
    int RightLength
    bool Show
    int Lookback
    string Timeframe
//@type Holds the values for visuals for the zone and to handle interactions (retests, false breakouts and breakouts).
//@field BaseTimeClose The time close for the start of the zone.
//@field FoundTimeClose The time close for the zone when it's found.
//@field ChartBaseTime The time for the start of the zone according to the chart bar.
//@field High The maximimum price of the zone.
//@field Low The minimum price of the zone.
//@field ReactionLimit Set a factor (%) of the Average True Range (of length 14) that the total reaction must have.
//@field TouchedZone Zone object that will be created and sent to the library 'Touched'.
//@field Visual An object that holds the visual elements for the zone.
//@field SourceTimeframeSeconds The 'timeframe.in_seconds' for the zone.
//@field Direction Defines if the found zone is bullish (1) or bearish (-1).
//@field LatestBreakoutBarIndex The latest 'bar_index' for a breakout.
//@field BarIndex The chart's timeeframe 'bar_index'.
//@field OriginType The 'Type' for the origin (order block or fair value gap).
//@field Type The type of the zone.
//@field Visible If the zone is drawn and not removed or re-drawn.
//@field Invalid Tells if the zone is valid for creation or not.
//@field CausedTrades The number of entered trades from the zone.
export type Zone
    int BaseTimeClose
    int FoundTimeClose
    int ChartBaseTime
    float High
    float Low
    float ReactionLimit
    Touched.Zone TouchedZone
    Visual Visual
    int SourceTimeframeSeconds
    int Direction // -1 = bearish, 1 = bullish
    int LatestBreakoutBarIndex
    int BarIndex
    Type OriginType
    Type Type
    bool Visible
    bool Invalid
    int CausedTrades
//@enum Direction of a trade, either long (bullish) or short (bearish).
//@field Long The direction of the trade is long (bullish).
//@field Short The direction of the trade is short (bearish).
export enum TradeDirection
    Long
    Short
//@type Is not 'na' when the library 'Touched' gives a signal that an integration occured.
//@field Direction The direction of the integration (long or short).
export type TouchedTrade
    TradeDirection Direction
//@type A statistically informational trade that's openned upon an integration.
//@field Entry The entry price of the trade.
//@field StopLoss The stop loss price of the trade.
//@field EntryBarIndex The 'bar_index' upon entry.
//@field Source The source type that caused the trade.
//@field SourceInt An integer representing the source type (this is usefull in the Pine Screener). Fair value gap = 1, order block = 2, inversion fair value gap = 3, breaker block = 4 and mitigation block = 5.
//@field ProfitPrice The current highest (for long trades) or lowest (for short trades) that's used to calculate 'Profit' that's a maximum profit bassed on the risk (risk/reward).
//@field StopLossHit If price has reached the stop loss or not.
//@field Profit A risk/reward value that's based on maximum 'ProfitPrice' and the difference between entry and stop loss.
//@field TrailingStopLossHit If the market structure trailing stop loss is hit (the trend has changed).
//@field ProfitIfTrailingStopLoss The estimated profit if a market structure trailing stop would have been used.
export type Trade
    float Entry
    float StopLoss
    int EntryBarIndex
    Type Source
    int SourceInt
    float ProfitPrice
    bool StopLossHit
    float Profit
    bool TrailingStopLossHit
    float ProfitIfTrailingStopLoss
//@type Addition statistics can be added to the current context.
//@field Longs Long (bullish) trades that's openned,
//@field Shorts Short (bearish) trades that's openned,
export type Statistics
    array<Trade> Longs
    array<Trade> Shorts
//@type Holds settings used for statistical trades.
//@field TradesPerZone A zone can open this number of trades.
//@field StopLossMargin A margin for the stop losses on entered trades can be used. This is a factor of the width of the zone (high - low) that will put the stop loss above the zone with this margin for short trades, and below for long trades.
export type TradeSettings
    int TradesPerZone
    float StopLossMargin
//@type Settings used for statistics.
//@field TradeSettings Settings used for statistical trades.
export type StatisticsSettings
    TradeSettings TradeSettings
//@type Holds the values for the charts context.
//@field Zones The currently active context.
//@field Removes Reprsents the zones that will be replaced.
//@field HiddenZones The currently hidden zones.
//@field ConfirmationHighPivot The found high pivots that's used for confirmation.
//@field ConfirmationLowPivotsThe found low pivots that's used for confirmation.
//@field Statistics The statistics for the current context.
export type Context
    array<Zone> Zones
    array<Zone> Removes
    array<Zone> HiddenZones
    array<PriceAction.Pivot> ConfirmationHighPivots
    array<PriceAction.Pivot> ConfirmationLowPivots
    Statistics Statistics
//@type The settings specific for order block creation.
//@field TakeOut If the bas candle needs to be higher\lower than the previous candle (liquidity sweep\grab).
//@field FairValueGap If there needs o be a fair value gap between the first and the last (third) candle of the order block.
//@field ConsecutiveRisingOrFalling The candles in the reaction must consecutivly rise or fall (the 'hl2' must be rising/falling).
//@field ReactionFactor A factor of the Average True Range (of length 14) that the total reaction must have. A higher value will create fewer zones with a bigger reaction. And check the checkbox if you want the limit to be displayed.
//@field ShowReaction Show a solid line for the reaction limit.
//@field HideConsecutiveZones If multiple order blocks are found after each other only the first one will be found by the indicator.
export type OrderBlockSettings
    bool TakeOut
    bool FairValueGap
    bool ConsecutiveRisingOrFalling
    float ReactionFactor
    bool ShowReaction
    bool HideConsecutiveZones
//@type The settings specific for fair value gap creation.
//@field ConsecutiveRisingOrFalling The candles in the reaction must consecutivly rise or fall (the 'hl2' must be rising/falling).
//@field Strong If this is enabled it will force the FVG middle candle to have a higher/lower 'hl2' (middle of the entire candle) than the first candle's high.
//@field HideConsecutiveZones If multiple order blocks are found after each other only the first one will be found by the indicator.
//@field MinimumSizeFactor A factor of the Average True Range (of length 14) that the size of the fair value gap must have.
export type FairValueGapSettings
    bool ConsecutiveRisingOrFalling
    bool Strong
    bool HideConsecutiveZones
    float MinimumSizeFactor
//@type The settings for the creation of order blocks and fair value gaps. You will need to set all the containing values in here.
//@field KeepHistoryZones Set to true if you want removed (from previous trend) zones to be displayed.
//@field Bull The color of bullish context.
//@field Bear The color of bearish context.
//@field CreateCreationZone Set to true if you want a box with a border to be drawn at the creation of the zone. This is usefull when the zones comes from a higher timeframe, but not from a lower. If this is false the 'Draw()' function will start at 'time - time_close'.
//@field AlertRetests Enable if you want alerts to fire when the 'Touched' library signals that a retest of the order block has occured.
//@field AlertFalseBreakouts Enable if you want alerts to fire when the 'Touched' library signals that a false breakout of the order block has occured.
//@field Types All types that should be displayed.
//@field FairValueGapSettings The settings for the creation of fair value gaps.
//@field OrderBlockSettings The settings for the creation of order blocks.
//@field ConfirmationPivotSettings The settings for confirmation pivots.
//@field StatisticsSettings The settings for statistics.
export type Settings
    bool KeepHistoryZones
    color Bull
    color Bear
    bool CreateCreationZone
    bool AlertRetests
    bool AlertFalseBreakouts
    array<Type> Types
    FairValueGapSettings FairValueGapSettings
    OrderBlockSettings OrderBlockSettings
    ConfirmationPivotSettings ConfirmationPivotSettings
    StatisticsSettings StatisticsSettings
//@type Holds contextual information about price action turtle soups.
//@param LatestTurtleSoupEndBarIndex The bar index for the lagest found turtle soup.
//@param FirstConfirmationPivotLow The first confirmation pivot after the current latest turtle soup.
//@param FirstConfirmationPivotHigh The first confirmation pivot after the current latest turtle soup.
export type TurtleSoupInfo
    int LatestTurtleSoupEndBarIndex
    PriceAction.Pivot FirstConfirmationPivotLow
    PriceAction.Pivot FirstConfirmationPivotHigh
//@type Holds the state needed from the 'PriceAction' library for the market structure.
//@field BrokenBarIndex The 'bar_index' that the 'Pivot' was broken by price.
//@field Pivot The 'PriceAction.Pivot' for the market structure.
//@field DeepestRetracement The deepest retracement before the structure break.
//@field DeepestRetracementBarIndex The deepest retracement bar index before the structure break.
export type MarketStructurePivot
    int BrokenBarIndex
    PriceAction.Pivot Pivot
    float DeepestRetracement
    int DeepestRetracementBarIndex
//@type Holds the needed market structure pivots needed for this library.
//@field LatestBreakOfStructure The latest break of structure (BOS) found by the 'PriceAction' library.
//@field LatestChangeOfCharacter The latest change of character (CHoCH\CHoCH+) found by the 'PriceAction' library.
//@field TurtleSoupInfo The current information about turtle soup context.
export type MarketStructureInfo
    MarketStructurePivot LatestBreakOfStructure
    MarketStructurePivot LatestChangeOfCharacter
    TurtleSoupInfo TurtleSoupInfo

_hl21 = hl2[1]
_hl22 = hl2[2]
_high2 = high[2]
_low2 = low[2]
_timeClose = time_close
_time2 = time[2]
_timeClose2 = time_close[2]
_atr = ta.atr(14)
var _timeframeSeconds = timeframe.in_seconds(timeframe.period)
var _mainTimeframeSeconds = timeframe.in_seconds(timeframe.main_period)

method RemoveVisuals(Zone zone, Settings settings) =>
    if zone.Visible
        for [i, b] in zone.Visual.Boxes
            if settings.KeepHistoryZones
                if i == 0 // only edit the zone box
                    b.set_right(time)
                    b.set_extend(extend.none)
            else
                b.delete()
        if not settings.KeepHistoryZones
            for l in zone.Visual.Lines
                l.delete()
        for l in zone.Visual.Labels
            l.delete()
        zone.Visible := false
RemoveLabels(Zone zone) =>
    for l in zone.Visual.Labels
        l.delete()
Add(Context context, Zone zone) =>
    context.Zones.push(zone)
AddHidden(Context context, Zone zone) =>
    context.HiddenZones.push(zone)
AddRemoval(Context context, Zone zone) =>
    context.Removes.push(zone)
// @function Removes the zone in 'context.Remove' and its visuals. The visuals will be kept if 'settings.KeepHistoryZones' is true.
// @param zones The current zone.
// @param settings Set all values in this parameter to define the settings for the context.
export Remove(Context context, Settings settings) =>
    for remove in context.Removes
        if not na(remove)
            remove.RemoveVisuals(settings)
    context.Removes.clear()
UpdateText(Zone zone) =>
    zone.Visual.Boxes.first().set_text(str.tostring(zone.Type))
Draw(Zone zone, Settings settings) =>
    var timeDifference = timeframe.in_seconds(timeframe.main_period) * 1000 // needed because how tradingview draws to the next candle if the time value is 'time_close'
    c = switch zone.Direction
        -1 => settings.Bear
        1 => settings.Bull
    zone.Visual.Boxes.push(box.new(zone.ChartBaseTime, zone.High, zone.FoundTimeClose, zone.Low, xloc = xloc.bar_time, bgcolor = color.new(c, 70), border_width = 0, extend = extend.right, text = not na(zone.Type) ? str.tostring(zone.Type) : str.tostring(zone.OriginType), text_color = color.new(c, 70)))
    if settings.CreateCreationZone
        end = if zone.SourceTimeframeSeconds == _mainTimeframeSeconds
            zone.BaseTimeClose
        else if zone.SourceTimeframeSeconds > _mainTimeframeSeconds
            zone.BaseTimeClose - timeDifference
        zone.Visual.Boxes.push(box.new(zone.ChartBaseTime, zone.High, end, zone.Low, xloc = xloc.bar_time, bgcolor = na, border_color = c))
    if zone.OriginType == Type.OrderBlock and settings.OrderBlockSettings.ShowReaction
        reactionLimit = switch zone.Direction
            -1 => zone.High - zone.ReactionLimit
            1 => zone.Low + zone.ReactionLimit
        end = if zone.SourceTimeframeSeconds == _mainTimeframeSeconds
            zone.FoundTimeClose - timeDifference
        else if zone.SourceTimeframeSeconds > _mainTimeframeSeconds
            zone.FoundTimeClose - timeDifference
        else
            zone.ChartBaseTime + timeDifference
        zone.Visual.Lines.push(line.new(zone.ChartBaseTime, reactionLimit, end, reactionLimit, xloc = xloc.bar_time, color = c))
    zone.Visible := true
method AlertMessageFormat(Zone zone, string integration) =>
    str.format("{0} on {1} from {2}", integration, str.tostring(zone.Type), str.format_time(zone.ChartBaseTime))
AddTrade(Trade trade, Zone zone, Context context, TradeDirection direction) =>
    switch direction
        TradeDirection.Long => context.Statistics.Longs.pop(), context.Statistics.Longs.unshift(trade)
        TradeDirection.Short => context.Statistics.Shorts.pop(), context.Statistics.Shorts.unshift(trade)
TradeProfit(TradeDirection direction, float entry, float takeProfit, float stopLoss) =>
    switch direction
        TradeDirection.Long => (takeProfit - entry) / (entry - stopLoss)
        TradeDirection.Short => (entry - takeProfit) / (stopLoss - entry)
//@function Sets market structure trailing stop loss triggering on 'trades'.
//@param trades The trades to take action on.
//@param direction Either bullish or bearish.
//@param trend -1 = bearish and 1 = bullish.
export MarketStructureTrailingStopLoss(array<Trade> trades, TradeDirection direction, int trend) =>
    for trade in trades
        if trade.TrailingStopLossHit or trade.StopLossHit
            continue
        switch direction
            TradeDirection.Long =>
                if trend[1] == -1 // if the trend has changed wait for the next candle and exit on its open price
                    trade.TrailingStopLossHit := true
                    trade.ProfitIfTrailingStopLoss := TradeProfit(direction, trade.Entry, open, trade.StopLoss)
            TradeDirection.Short =>
                if trend[1] == 1
                    trade.TrailingStopLossHit := true
                    trade.ProfitIfTrailingStopLoss := TradeProfit(direction, trade.Entry, open, trade.StopLoss)
//@function Handle all 'trades'. If its stop loss is hit or if price action has reaches a higher (for long trades) or lower (for short trades) the increases its potential 'profit'.
//@param trades The trades to take action on.
//@param direction Either bullish or bearish.
export HandleTrades(array<Trade> trades, TradeDirection direction) =>
    for trade in trades
        if trade.StopLossHit
            continue
        stopLossHit = switch direction
            TradeDirection.Long => low <= trade.StopLoss
            TradeDirection.Short => high >= trade.StopLoss
        if stopLossHit
            trade.StopLossHit := true
            trade.Profit *= -1 // add a minus sign in front of profit to signal that it hit its stop loss
            continue
        switch direction
            TradeDirection.Long =>
                if na(trade.ProfitPrice) or high > trade.ProfitPrice
                    trade.ProfitPrice := high
                    trade.Profit := TradeProfit(direction, trade.Entry, trade.ProfitPrice, trade.StopLoss)
            TradeDirection.Short =>
                if na(trade.ProfitPrice) or low < trade.ProfitPrice
                    trade.ProfitPrice := low
                    trade.Profit := TradeProfit(direction, trade.Entry, trade.ProfitPrice, trade.StopLoss)
SourceInt(Type source) =>
    switch source
        Type.FairValueGap => 1
        Type.OrderBlock => 2
        Type.InversionFairValueGap => 3
        Type.BreakerBlock => 4
        Type.MitigationBlock => 5
method Interaction(Zone zone, Touched.Touch touch, int trend, color c = na, string lbl = na) =>
    TouchedTrade touchedTrade = na
    if touch.Down and trend >= 0
        if not na(lbl)
            zone.Visual.Labels.push(label.new(bar_index - touch.ExtremeIndexBack, low[touch.ExtremeIndexBack], lbl, color = c, style = label.style_label_up))
        touchedTrade := TouchedTrade.new(TradeDirection.Long)
    if touch.Up and trend <= 0
        if not na(lbl)
            zone.Visual.Labels.push(label.new(bar_index - touch.ExtremeIndexBack, high[touch.ExtremeIndexBack], lbl, color = c))
        touchedTrade := TouchedTrade.new(TradeDirection.Short)
    touchedTrade
// @function Sets the interactions (retests\false breakouts\breakouts) from the library 'Touched'. Also enter a trade if the specific integration has alerts enabled.
// @param context The entire context for current PD Arrays.
// @param settings set all values in this parameter to define the settings for the order block creation.
// @param trend the market structure trend that's used for the integrations direction. 1 = bullish, -1 = bearish, 0 = both.
// @param marketStructureInfo The state of market structure needed.
export Interactions(Context context, Settings settings, int trend, MarketStructureInfo marketStructureInfo) =>
    for zone in context.Zones
        if na(zone)
            continue
        if not zone.Visible
            continue
        retest = zone.Interaction(Touched.Retest(zone.TouchedZone, 30), trend, color.new(color.blue, 30), "R")
        if not na(retest)
            if settings.AlertRetests
                zoneMessage = zone.AlertMessageFormat("Retest")
                MarketStructureMessage = switch trend
                    -1 => zone.BarIndex > marketStructureInfo.LatestChangeOfCharacter.DeepestRetracementBarIndex ? "formed during falling prices" : "formed during rising prices"
                    1 => zone.BarIndex > marketStructureInfo.LatestChangeOfCharacter.DeepestRetracementBarIndex ? "formed during rising prices" : "formed during falling prices"
                alert(str.format("{0} ({1})", zoneMessage, MarketStructureMessage), alert.freq_all)
                if settings.StatisticsSettings.TradeSettings.TradesPerZone == -1 ? true : zone.CausedTrades < settings.StatisticsSettings.TradeSettings.TradesPerZone
                    stopLossMargin = (zone.High - zone.Low) * settings.StatisticsSettings.TradeSettings.StopLossMargin
                    stopLoss = switch retest.Direction
                        TradeDirection.Long => zone.Low - stopLossMargin
                        TradeDirection.Short => zone.High + stopLossMargin
                    AddTrade(Trade.new(close, stopLoss, bar_index, zone.Type, SourceInt(zone.Type)), zone, context, retest.Direction)
                    zone.CausedTrades += 1
        falseBreakout = zone.Interaction(Touched.FalseBreakout(zone.TouchedZone, 30), trend, color.new(color.orange, 30), "FB")
        if not na(falseBreakout)
            if settings.AlertFalseBreakouts
                zoneMessage = zone.AlertMessageFormat("False breakout")
                MarketStructureMessage = switch trend
                    -1 => zone.BarIndex > marketStructureInfo.LatestChangeOfCharacter.DeepestRetracementBarIndex ? "formed during falling prices" : "formed during rising prices"
                    1 => zone.BarIndex > marketStructureInfo.LatestChangeOfCharacter.DeepestRetracementBarIndex ? "formed during rising prices" : "formed during falling prices"
                alert(str.format("{0} ({1})", zoneMessage, MarketStructureMessage), alert.freq_all)
                if settings.StatisticsSettings.TradeSettings.TradesPerZone == -1 ? true : zone.CausedTrades < settings.StatisticsSettings.TradeSettings.TradesPerZone
                    stopLossMargin = (zone.High - zone.Low) * settings.StatisticsSettings.TradeSettings.StopLossMargin
                    stopLoss = switch falseBreakout.Direction
                        TradeDirection.Long => zone.Low - stopLossMargin
                        TradeDirection.Short => zone.High + stopLossMargin
                    AddTrade(Trade.new(close, stopLoss, bar_index, zone.Type, SourceInt(zone.Type)), zone, context, falseBreakout.Direction)
                    zone.CausedTrades += 1
        breakout = zone.Interaction(Touched.Breakout(zone.TouchedZone, 50), 0, color.new(color.red, 30), "B")
        if not na(breakout)
            zone.LatestBreakoutBarIndex := bar_index
            RemoveVisuals(zone, settings)
// @function Sets the hidden interactions (only breakouts) from the library 'Touched'.
// @param context The entire context for current PD Arrays.
// @param settings set all values in this parameter to define the settings for the order block creation.
// @param marketStructureInfo The state of market structure needed.
// @param trend the market structure trend that's used for the integrations direction. 1 = bullish, -1 = bearish, 0 = both.
export HiddenInteractions(Context context, Settings settings, MarketStructureInfo marketStructureInfo, int trend) =>
    brokenHiddenZonesIndices = array.new<int>()
    for [i, zone] in context.HiddenZones
        if na(zone)
            continue
        breakout = zone.Interaction(Touched.Breakout(zone.TouchedZone, 50), 0, color.new(color.red, 30), na)
        if not na(breakout)
            zone.LatestBreakoutBarIndex := bar_index
            if zone.Direction == trend
                continue
            create = false
            switch zone.OriginType
                Type.FairValueGap =>
                    if settings.Types.includes(Type.InversionFairValueGap)
                        zone.Type := Type.InversionFairValueGap
                        create := true
                Type.OrderBlock =>
                    if zone.BarIndex <= marketStructureInfo.LatestChangeOfCharacter.BrokenBarIndex
                        if settings.Types.includes(Type.BreakerBlock)
                            zone.Type := Type.BreakerBlock
                            create := true
                    else
                        if settings.Types.includes(Type.MitigationBlock)
                            zone.Type := Type.MitigationBlock
                            create := true
            if create and not zone.Invalid
                Draw(zone, settings)
                brokenHiddenZonesIndices.unshift(i) // remove from HiddenZones and add to Zones
                context.Zones.push(zone)
    for brokenHiddnZonesIndex in brokenHiddenZonesIndices
        context.HiddenZones.remove(brokenHiddnZonesIndex)
OrderBlockUp(OrderBlockSettings settings) =>
    satisfied = true
    for i = 2 to 1
        if settings.ConsecutiveRisingOrFalling
            [previous, current] = switch i
                2 => [_hl21, _hl22]
                1 => [hl2, _hl21]
            if previous < current
                satisfied := false
                break

    if settings.FairValueGap
        if _high2 >= low
            satisfied := false
    if settings.HideConsecutiveZones
        var previousSatisfiedBarIndex = 0
        if satisfied and bar_index == previousSatisfiedBarIndex + 1
            satisfied := false
        if satisfied
            previousSatisfiedBarIndex := bar_index
    satisfied
OrderBlockDown(OrderBlockSettings settings) =>
    satisfied = true
    for i = 2 to 1
        if settings.ConsecutiveRisingOrFalling
            [previous, current] = switch i
                2 => [_hl21, _hl22]
                1 => [hl2, _hl21]
            if previous > current
                satisfied := false
                break

    if settings.FairValueGap
        if _low2 <= high
            satisfied := false
    if settings.HideConsecutiveZones
        var previousSatisfiedBarIndex = 0
        if satisfied and bar_index == previousSatisfiedBarIndex + 1
            satisfied := false
        if satisfied
            previousSatisfiedBarIndex := bar_index
    satisfied
// @function Creates pivots (high and low) to be used for order block creation.
// @param settings set all values in this parameter to define the settings for the order block creation.
// @returns a tuple containing two pivot values (high and low) or 'na'
export Pivots(Settings settings) =>
    [ta.pivothigh(settings.OrderBlockSettings.TakeOut ? 1 : 0, 2), ta.pivotlow(settings.OrderBlockSettings.TakeOut ? 1 : 0, 2)]
// @function Creates an order block if one is found according to the settings parameter.
// @param settings set all values in this parameter to define the settings for the order block creation.
// @param pivotHigh The high pivot to use.
// @param pivotLow The low pivot to use.
// @returns a Zone object if an order block is found, na otherwise
export OrderBlock(Settings settings, float pivotHigh, float pivotLow) =>
    chartTime2 = time(timeframe.main_period, bars_back = 2)
    if not na(chartTime2)
        reactionLimit = _atr * settings.OrderBlockSettings.ReactionFactor
        widthUp = high - _low2
        widthDown = _high2 - low
        zone = Zone.new(_timeClose2, _timeClose, chartTime2, _high2, _low2, reactionLimit, Touched.Zone.new(_high2, _low2, _time2), Visual.new(array.new<box>(), array.new<line>(), array.new<label>()), _timeframeSeconds, OriginType = Type.OrderBlock, Type = Type.OrderBlock, CausedTrades = 0)
        create = false
        if widthUp >= reactionLimit
            if not na(pivotLow) and barstate.isconfirmed // only create an order block if the HTF bar is closed
                if OrderBlockUp(settings.OrderBlockSettings)
                    zone.Direction := 1
                    create := true
        if widthDown >= reactionLimit
            if not na(pivotHigh) and barstate.isconfirmed // only create an order block if the HTF bar is closed
                if OrderBlockDown(settings.OrderBlockSettings)
                    zone.Direction := -1
                    create := true
        if create
            zone
FairValueGapUp(FairValueGapSettings settings) =>
    satisfied = high[2] < high[1] and high[1] < high and low[2] < low[1] and low[1] < low
    if satisfied
        if settings.ConsecutiveRisingOrFalling
            for i = 1 to 0
                previous = hl2[i + 1]
                current = hl2[i]
                if previous > current
                    satisfied := false
                    break
    if satisfied
        if settings.Strong and _hl21 <= _high2
            satisfied := false
    if satisfied
        if settings.HideConsecutiveZones
            var previousSatisfiedBarIndex = 0
            if satisfied and bar_index == previousSatisfiedBarIndex + 1
                satisfied := false
            if satisfied
                previousSatisfiedBarIndex := bar_index
    if satisfied
        if low - _high2 < settings.MinimumSizeFactor * _atr
            satisfied := false
    satisfied
FairValueGapDown(FairValueGapSettings settings) =>
    satisfied = high[2] > high[1] and high[1] > high and low[2] > low[1] and low[1] > low
    if satisfied
        if settings.ConsecutiveRisingOrFalling
            for i = 1 to 0
                previous = hl2[i + 1]
                current = hl2[i]
                if previous < current
                    satisfied := false
                    break
    if satisfied
        if settings.Strong and _hl21 >= _high2
            satisfied := false
    if satisfied
        if _low2 - high < settings.MinimumSizeFactor * _atr 
            satisfied := false
    if satisfied
        if settings.HideConsecutiveZones
            var previousSatisfiedBarIndex = 0
            if satisfied and bar_index == previousSatisfiedBarIndex + 1
                satisfied := false
            if satisfied
                previousSatisfiedBarIndex := bar_index
    satisfied
// @function Creates a fair value gap if one is found according to the settings parameter.
// @param settings set all values in this parameter to define the settings for the fair value gap creation.
// @returns a Zone object if a fair value gap is found, na otherwise
export FairValueGap(Settings settings) =>
    chartTime2 = time(timeframe.main_period, bars_back = 2)
    if not na(chartTime2)
        zone = Zone.new(_timeClose2, _timeClose, chartTime2, _high2, _low2, -1, na, Visual.new(array.new<box>(), array.new<line>(), array.new<label>()), _timeframeSeconds, OriginType = Type.FairValueGap, Type = Type.FairValueGap, CausedTrades = 0)
        create = false
        if barstate.isconfirmed
            if FairValueGapUp(settings.FairValueGapSettings)
                zone.High := low
                zone.Low := _high2
                zone.TouchedZone := Touched.Zone.new(low, _high2, time)
                zone.Direction := 1
                create := true
        if barstate.isconfirmed
            if FairValueGapDown(settings.FairValueGapSettings)
                zone.High := _low2
                zone.Low := high
                zone.TouchedZone := Touched.Zone.new(_low2, high, time)
                zone.Direction := -1
                create := true
        if create
            zone
// @function Sets the 'BarIndex' value of the 'zone' object according to 'zone.ChartBaseTime'.
// @param zone The 'Zone' object to set the bar index on.
export SetBarIndex(Zone zone) =>
    barIndex = 0
    i = 0
    while true
        timeI = time[i]
        if timeI < zone.ChartBaseTime or na(timeI)// before creation of zone 
            barIndex := bar_index - (i - 1) // set the creation bar to the first bar inside the zone
            break
        i += 1
    zone.BarIndex := barIndex
// @function Creates/draws zones (order blocks and fair value gaps) depending on the current market structure from the price action.
// @param marketStructureInfo The infirmation about the market structure from the price action.
// @param foundZones All zones (order blocks and fair value gaps) to take action on.
// @param zones The 'Zones' object that holds the current context.
// @param priceAction The 'PriceAction.PriceAction' object from the library 'PriceAction'.
// @param settings set all values in this parameter to define the settings for the fair value gap creation.
export MarketStructureZones(MarketStructureInfo marketStructureInfo, array<Zone> foundZones, Context context, PriceAction.PriceAction priceAction, Settings settings) =>
    if marketStructureInfo.LatestChangeOfCharacter.BrokenBarIndex == bar_index
        context.Zones.clear()
        context.HiddenZones.clear()
        removes = array.new<int>()
        for [i, zone] in foundZones
            if zone.BarIndex < marketStructureInfo.LatestChangeOfCharacter.Pivot.BarIndex
                AddRemoval(context, zone)
                removes.unshift(i)
            else
                followingTrend = switch priceAction.Swing.Trend
                    -1 =>
                        switch zone.Direction
                            -1 => true
                            1 => false
                    1 =>
                        switch zone.Direction
                            -1 => false
                            1 => true
                keep2 = switch followingTrend
                    false =>
                        switch zone.OriginType
                            Type.FairValueGap =>
                                if zone.LatestBreakoutBarIndex >= marketStructureInfo.LatestChangeOfCharacter.Pivot.BarIndex
                                    zone.Type := Type.InversionFairValueGap
                                    settings.Types.includes(Type.InversionFairValueGap)
                            Type.OrderBlock =>
                                if zone.LatestBreakoutBarIndex >= marketStructureInfo.LatestChangeOfCharacter.Pivot.BarIndex
                                    zone.Type := Type.BreakerBlock
                                    settings.Types.includes(Type.BreakerBlock)
                    true =>
                        switch zone.OriginType
                            Type.FairValueGap => settings.Types.includes(Type.FairValueGap)
                            Type.OrderBlock => settings.Types.includes(Type.OrderBlock)

                if keep2
                    if not zone.Visible
                        if zone.Invalid
                            AddHidden(context, zone)
                        else
                            Draw(zone, settings)
                            Add(context, zone)
                    else
                        if not zone.Visible
                            Draw(zone, settings) // removed, redraw
                        else
                            UpdateText(zone)
                        if zone.Invalid
                            AddHidden(context, zone)
                        else
                            Add(context, zone)
                    RemoveLabels(zone) // remove all previous labels as they are no longer relevant to current price action
                else
                    AddRemoval(context, zone)
                    AddHidden(context, zone)
        Remove(context, settings)
        for removeIndex in removes
            foundZones.remove(removeIndex)
    var latestDrawnFairValueGapBarIndex = -1
    var latestDrawnOrderBlockBarIndex = -1
    for zone in foundZones
        if zone.Visible
            continue
        draw = false
        hidden = false
        switch zone.OriginType
            Type.FairValueGap =>
                if zone.BarIndex > latestDrawnFairValueGapBarIndex
                    if zone.Direction == priceAction.Swing.Trend and settings.Types.includes(Type.FairValueGap)
                        draw := true
                    else
                        hidden := true
                    latestDrawnFairValueGapBarIndex := zone.BarIndex
            Type.OrderBlock =>
                if zone.BarIndex > latestDrawnOrderBlockBarIndex
                    if zone.Direction == priceAction.Swing.Trend and settings.Types.includes(Type.OrderBlock)
                        draw := true
                    else
                        hidden := true
                    latestDrawnOrderBlockBarIndex := zone.BarIndex
        if draw
            if zone.Invalid
                AddHidden(context, zone)
            else
                Add(context, zone) // add all zones to 'context.Zones' in the current trend
                Draw(zone, settings)
        else if hidden
            AddHidden(context, zone)
        Remove(context, settings)
//@function Invalidates the zone for creation if no turtle soup has happend between the CHoCH/CHoCH+ pivot and the bar that caused the change of trend.
//@param turtleSoupsContext The context for current turtle soup price action.
//@param marketStructureInfo The infirmation about the market structure from the price action.
//@param foundZones All zones (order blocks and fair value gaps) to take action on.
//@param priceAction The 'PriceAction.PriceAction' object from the library 'PriceAction'.
export InvalidateIfNoTurtleSoup(PriceAction.TurtleSoups turtleSoupsContext, MarketStructureInfo marketStructureInfo, array<Zone> foundZones, PriceAction.PriceAction priceAction) =>
    var turtleSoupBeforeChangeOfCharacter = false
    if marketStructureInfo.LatestChangeOfCharacter.BrokenBarIndex == bar_index
        turtleSoupBeforeChangeOfCharacter := false
    if not turtleSoupBeforeChangeOfCharacter and not na(marketStructureInfo.LatestChangeOfCharacter.Pivot) and marketStructureInfo.LatestChangeOfCharacter.BrokenBarIndex == bar_index
        earliest = marketStructureInfo.LatestChangeOfCharacter.Pivot.BarIndex
        latest = marketStructureInfo.LatestChangeOfCharacter.BrokenBarIndex
        turtleSoups = switch priceAction.Swing.Trend
            -1 => turtleSoupsContext.Bearish
            1 => turtleSoupsContext.Bullish
        for turtleSoup in turtleSoups
            if turtleSoup.Visible and turtleSoup.End >= earliest and turtleSoup.End <= latest and turtleSoup.Pivot.BarIndex >= earliest and turtleSoup.Deepest == marketStructureInfo.LatestChangeOfCharacter.DeepestRetracement
                turtleSoupBeforeChangeOfCharacter := true
                marketStructureInfo.TurtleSoupInfo := TurtleSoupInfo.new(turtleSoup.End)
                break
        if turtleSoupBeforeChangeOfCharacter
            for zone in foundZones
                if zone.BarIndex >= marketStructureInfo.LatestChangeOfCharacter.Pivot.BarIndex
                    zone.Invalid := false
        else
            for zone in foundZones
                zone.Invalid := true
    if not turtleSoupBeforeChangeOfCharacter
        for zone in foundZones
            if zone.Invalid
                continue
            zone.Invalid := true
//@function Invalidates the zone for creation if the market structur trend is wrong.
//@param foundZones All zones (order blocks and fair value gaps) to take action on.
//@param direction If the trend has has the wrong direction according to this enumeration it will be invalidated.
//@param trend The market structure trend.
export InvalidateIfWrongDirection(array<Zone> foundZones, Direction direction, int trend) =>
    for zone in foundZones
        invalid = switch direction
            Direction.Bearish => trend != -1
            Direction.Bullish => trend != 1
        if invalid
            zone.Invalid := true
//@function Revalidates the zones efter 'earliest' for creation if the market structur trend is right now.
//@param foundZones All zones (order blocks and fair value gaps) to take action on.
//@param direction If the trend has has the wrong direction according to this enumeration it will be invalidated.
//@param trend The market structure trend.
//@param earliest The earliest bar_index for revalidation (the base pivot for the CHoCH).
export RevalidateIfRightDirection(array<Zone> foundZones, Direction direction, int trend, int earliest) =>
    for zone in foundZones
        if zone.BarIndex < earliest
            continue
        invalid = switch direction
            Direction.Bearish => trend != -1
            Direction.Bullish => trend != 1
        if not invalid
            zone.Invalid := false
//@function Gets confirmation pivots after a CHoCH/CHoCH+ that has a turtle soup. This confirmation pivot is used to invalidate zones that are found after it.
//@param settings The 'ConfirmationPivotSettings' object that's used.
//@returns a tuple with high and low pivots.
export GetConfirmationPivots(ConfirmationPivotSettings settings) =>
    PriceAction.Pivot confirmationPivotHigh = na
    PriceAction.Pivot confirmationPivotLow = na
    pivotHighPrice = ta.pivothigh(settings.LeftLength, settings.RightLength)
    pivotLowPrice = ta.pivotlow(settings.LeftLength, settings.RightLength)
    if not na(pivotHighPrice)
        confirmationPivotHigh := PriceAction.Pivot.new(pivotHighPrice, Type = 1, Time = time[settings.RightLength])
    if not na(pivotLowPrice)
        confirmationPivotLow := PriceAction.Pivot.new(pivotLowPrice, Type = -1, Time = time[settings.RightLength])
    [confirmationPivotHigh, confirmationPivotLow]
//@function Sets the found confirmation pivots in 'context'.
//@param context The 'Context' object for PD Arrays.
//@param settings The 'ConfirmationPivotSettings' object that's used.
//@param pivotHigh The high pivot.
//@param pivotLow T=e low pivot.
export SetConfirmationPivots(Context context, ConfirmationPivotSettings settings, PriceAction.Pivot pivotHigh, PriceAction.Pivot pivotLow) =>
    if not na(pivotHigh)
        if context.ConfirmationHighPivots.size() >= settings.Lookback
            context.ConfirmationHighPivots.pop()
        context.ConfirmationHighPivots.unshift(pivotHigh)
    if not na(pivotLow)
        if context.ConfirmationLowPivots.size() >= settings.Lookback
            context.ConfirmationLowPivots.pop()
        context.ConfirmationLowPivots.unshift(pivotLow)
//@function Invalidates zones that are after a confirmation pivot.
//@param context The 'Context' object for PD Arrays.
//@param marketStructureInfo The infirmation about the market structure from the price action.
//@param trend the market structure trend that's used for the integrations direction. 1 = bullish, -1 = bearish, 0 = both.
//@param foundZones All zones (order blocks and fair value gaps) to take action on.
//@param settings The 'ConfirmationPivotSettings' object that's used.
export InvalidateIfAfterConfirmationPivot(Context context, MarketStructureInfo marketStructureInfo, int trend, array<Zone> foundZones, ConfirmationPivotSettings settings) =>
    [firstConfirmationPivot, confirmationPivots] = switch trend
        -1 => [marketStructureInfo.TurtleSoupInfo.FirstConfirmationPivotLow, context.ConfirmationLowPivots]
        1 => [marketStructureInfo.TurtleSoupInfo.FirstConfirmationPivotHigh, context.ConfirmationHighPivots]
    if not na(marketStructureInfo.LatestChangeOfCharacter.Pivot) and na(firstConfirmationPivot) and marketStructureInfo.TurtleSoupInfo.LatestTurtleSoupEndBarIndex > marketStructureInfo.LatestChangeOfCharacter.Pivot.BarIndex
        for pivot in confirmationPivots
            if pivot.BarIndex == bar_index - settings.RightLength
                switch trend
                    -1 =>
                        marketStructureInfo.TurtleSoupInfo.FirstConfirmationPivotLow := pivot
                        if settings.Show
                            label.new(pivot.BarIndex, -1, yloc = yloc.belowbar, size = 4, color = color.new(color.red, 70), style = label.style_triangledown)
                    1 =>
                        marketStructureInfo.TurtleSoupInfo.FirstConfirmationPivotHigh := pivot
                        if settings.Show
                            label.new(pivot.BarIndex, -1, yloc = yloc.abovebar, size = 4, color = color.new(color.red, 70), style = label.style_triangleup)
    switch trend
        -1 =>
            if not na(marketStructureInfo.TurtleSoupInfo.FirstConfirmationPivotLow)
                for zone in foundZones
                    zone.Invalid := true
        1 =>
            if not na(marketStructureInfo.TurtleSoupInfo.FirstConfirmationPivotHigh)
                for zone in foundZones
                    zone.Invalid := true
//@function Tells you the deepest (lowest/highest) price counter trend.
//@param from The bar_index to start with.
//@param t_o The bar_index to end with.
//@param trend The market structure trend that's used to find the deepest pullback. 1 = bullish, -1 = bearish, 0 = both.
//@returns A tuple with the deepest pullback and the bar_index.
export DeepestRetracement(int from, int t_o, int trend) =>
    deepestPullbackInsideCHoCH = switch trend
        -1 => -2147483648.
        1 => 2147483647.
    deepestPullbackInsideCHoCHBarIndex = -1
    for i = 0 to t_o - from
        switch trend
            -1 =>
                if high[i] > deepestPullbackInsideCHoCH
                    deepestPullbackInsideCHoCH := high[i]
                    deepestPullbackInsideCHoCHBarIndex := bar_index - i
            1 =>
                if low[i] < deepestPullbackInsideCHoCH
                    deepestPullbackInsideCHoCH := low[i]
                    deepestPullbackInsideCHoCHBarIndex := bar_index - i
    [deepestPullbackInsideCHoCH, deepestPullbackInsideCHoCHBarIndex]