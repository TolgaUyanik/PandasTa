//@version=6
library("ZigZagATRPct", overlay = true)

// ============================================================================
// ZigZag ATR Percent Change Library
// Detects pivots based on ATR % change instead of raw ATR values
// ============================================================================

// ————————————————————————————————————————————————————————————————————————————
// Types
// ————————————————————————————————————————————————————————————————————————————

// @type Settings for ZigZag ATR Percent
// @field atrLength Length for ATR EMA calculation
// @field atrLookback Lookback period for ATR % change calculation
// @field atrPctThreshold Minimum ATR % change threshold to form a new pivot
// @field depth Minimum bars between pivots
// @field lineColor Color for zigzag lines
// @field extend Whether to extend line to current bar
// @field showPrice Show price at pivot
// @field showVol Show cumulative volume
// @field showChg Show price change
// @field priceDiff Price difference display mode ("Absolute", "Percent", "ATRPct")
// @field draw Whether library handles drawing
// @field allowZigZagOnOneBar Allow pivot reversal on same bar
export type Settings
    int atrLength = 14
    int atrLookback = 14
    float atrPctThreshold = 5.0
    int depth = 10
    color lineColor = #2962FF
    bool extend = true
    bool showPrice = true
    bool showVol = true
    bool showChg = true
    string priceDiff = "ATRPct"
    bool draw = true
    bool allowZigZagOnOneBar = true

// @type Pivot point data
// @field point Chart point (time, price)
// @field isHigh True if pivot is a high, false if low
// @field vol Cumulative volume to this pivot
// @field atrPct ATR % change at this pivot
export type Pivot
    chart.point point
    bool isHigh
    float vol
    float atrPct

// @type Main ZigZag state
// @field settings Configuration settings
// @field pivots Array of detected pivots
// @field sumVol Cumulative volume since last pivot
// @field lastAtrPct Last calculated ATR % change
// @field atr Current ATR value
export type ZigZag
    Settings settings
    array<Pivot> pivots
    float sumVol
    float lastAtrPct
    float atr

// ————————————————————————————————————————————————————————————————————————————
// ATR Percent Calculation
// ————————————————————————————————————————————————————————————————————————————

// @function Calculate True Range
// @returns True range value
export calcTR() =>
    float tr = na(high[1]) ? (high - low) : math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
    tr

// @function Calculate ATR using EMA
// @param length EMA length for ATR
// @returns ATR value
export calcATR(simple int length) =>
    float tr = calcTR()
    float atr = ta.ema(tr, length)
    atr

// @function Calculate ATR Percent Change
// @param atr Current ATR value
// @param atrPrev Previous ATR value
// @returns ATR percent change
export calcATRPct(float atr, float atrPrev) =>
    float atrPct = nz(atrPrev) > 0 ? 100.0 * (atr / atrPrev - 1.0) : 0.0
    atrPct

// ————————————————————————————————————————————————————————————————————————————
// ZigZag Core Functions
// ————————————————————————————————————————————————————————————————————————————

// @function Create new ZigZag instance
// @param settings Configuration settings
// @returns New ZigZag instance
export newInstance(Settings settings) =>
    ZigZag.new(
         settings,
         array.new<Pivot>(),
         0.0,
         0.0,
         na
     )

// @function Get the last pivot
// @param zz ZigZag instance
// @returns Last pivot or na
export getLastPivot(ZigZag zz) =>
    int size = zz.pivots.size()
    size > 0 ? zz.pivots.get(size - 1) : na

// @function Check if enough bars have passed since last pivot
// @param zz ZigZag instance
// @param barTime Current bar time
// @returns True if depth requirement is met
depthCheck(ZigZag zz, int barTime) =>
    Pivot lastPivot = getLastPivot(zz)
    if na(lastPivot)
        true
    else
        int barsSince = bar_index - math.round((barTime - lastPivot.point.time) / (time - time[1]))
        barsSince >= zz.settings.depth or zz.settings.allowZigZagOnOneBar

// @function Add a new pivot
// @param zz ZigZag instance
// @param price Pivot price
// @param barTime Bar time
// @param isHigh Is this a high pivot
// @param atrPct ATR % at pivot
addPivot(ZigZag zz, float price, int barTime, bool isHigh, float atrPct) =>
    Pivot newPivot = Pivot.new(
         chart.point.from_time(barTime, price),
         isHigh,
         zz.sumVol,
         atrPct
     )
    zz.pivots.push(newPivot)
    zz.sumVol := 0.0

// @function Update the last pivot (for extending pivots)
// @param zz ZigZag instance
// @param price New price
// @param barTime New bar time
// @param atrPct ATR % at update
updateLastPivot(ZigZag zz, float price, int barTime, float atrPct) =>
    int size = zz.pivots.size()
    if size > 0
        Pivot lastPivot = zz.pivots.get(size - 1)
        lastPivot.point := chart.point.from_time(barTime, price)
        lastPivot.vol := zz.sumVol
        lastPivot.atrPct := atrPct

// @function Main update function - call on each bar
// @param zz ZigZag instance
// @param atr Current ATR value (calculated externally)
// @param atrPct Current ATR % change (calculated externally)
// @returns Updated ZigZag instance
export update(ZigZag zz, float atr, float atrPct) =>
    Settings s = zz.settings

    // Store values
    zz.atr := atr
    zz.lastAtrPct := atrPct

    // Accumulate volume
    zz.sumVol += nz(volume)

    // Get current high/low
    float curHigh = high
    float curLow = low
    int curTime = time

    // Check for new pivots
    Pivot lastPivot = getLastPivot(zz)

    if na(lastPivot)
        // First pivot - use high
        addPivot(zz, curHigh, curTime, true, atrPct)
    else
        bool lastWasHigh = lastPivot.isHigh
        float lastPrice = lastPivot.point.price

        // ATR % triggers pivot detection:
        // When ATR% change is significant (above threshold), we detect pivots
        // Positive ATR% = volatility expanding, Negative ATR% = volatility contracting
        bool volatilitySignificant = math.abs(atrPct) >= s.atrPctThreshold

        if lastWasHigh
            // Last was high, looking for lower low or higher high
            if curHigh > lastPrice
                // Extend the high (always extend to higher high)
                updateLastPivot(zz, curHigh, curTime, atrPct)
            else if curLow < lastPrice and volatilitySignificant
                // New low pivot when price reverses AND volatility change is significant
                if depthCheck(zz, curTime)
                    addPivot(zz, curLow, curTime, false, atrPct)
        else
            // Last was low, looking for higher high or lower low
            if curLow < lastPrice
                // Extend the low (always extend to lower low)
                updateLastPivot(zz, curLow, curTime, atrPct)
            else if curHigh > lastPrice and volatilitySignificant
                // New high pivot when price reverses AND volatility change is significant
                if depthCheck(zz, curTime)
                    addPivot(zz, curHigh, curTime, true, atrPct)

    zz

// @function Get pivot count
// @param zz ZigZag instance
// @returns Number of pivots
export getPivotCount(ZigZag zz) =>
    zz.pivots.size()

// @function Get pivot at index
// @param zz ZigZag instance
// @param index Pivot index
// @returns Pivot at index
export getPivot(ZigZag zz, int index) =>
    zz.pivots.get(index)

// @function Calculate price percent change between two prices
// @param startPrice Start price of swing
// @param endPrice End price of swing
// @returns Price percent change
export calcPricePct(float startPrice, float endPrice) =>
    float pctChange = 100.0 * (endPrice / startPrice - 1.0)
    pctChange
