//@version=5
indicator("Trend Buy/Sell Fibonacci Range - KLT", overlay=true)

// === Input ===
lookback      = input.int(10, title="Fibonacci Period (n candles)", minval=2)
upperLevel    = input.float(0.618, title="Upper level (Buy)", step=0.01)
lowerLevel    = input.float(0.382, title="Lower level (Sell)", step=0.01)
showArrows    = input.bool(false, title="Show Arrow")
showFibLevels = input.bool(true, title="Show Fibonacci Levels")

// === Calcolo range Fibonacci ===
swingHigh = ta.highest(high, lookback)
swingLow  = ta.lowest(low, lookback)
fibRange  = swingHigh - swingLow
pricePos  = close - swingLow
fibRatio  = fibRange > 0 ? pricePos / fibRange : 0

// === Condizioni Buy/Sell ===
isBuy  = fibRatio >= upperLevel
isSell = fibRatio <= lowerLevel

// === Colorazione Candele ===
candleColor = isBuy ? color.lime :
              isSell ? color.red :
              color.gray
barcolor(candleColor)

// === Frecce ===
plotshape(showArrows and isBuy, title=" Buy Signal", location=location.belowbar,
     style=shape.triangleup, color=color.lime, size=size.small)

plotshape(showArrows and isSell, title="Sell Signal", location=location.abovebar,
     style=shape.triangledown, color=color.red, size=size.small)

// === Disegno Livelli Fibonacci ===
fib_0     = swingLow
fib_236   = swingLow + fibRange * 0.236
fib_382   = swingLow + fibRange * 0.382
fib_5     = swingLow + fibRange * 0.5
fib_618   = swingLow + fibRange * 0.618
fib_786   = swingLow + fibRange * 0.786
fib_1     = swingHigh

plot(showFibLevels ? fib_0 : na,     title="Fib 0.0",   color=color.new(color.gray, 80), linewidth=1, style=plot.style_line)
plot(showFibLevels ? fib_236 : na,   title="Fib 0.236", color=color.new(color.orange, 80), linewidth=1)
plot(showFibLevels ? fib_382 : na,   title="Fib 0.382", color=color.new(color.orange, 80), linewidth=1)
plot(showFibLevels ? fib_5 : na,     title="Fib 0.5",   color=color.new(color.blue, 80), linewidth=1)
plot(showFibLevels ? fib_618 : na,   title="Fib 0.618", color=color.new(color.green, 80), linewidth=1)
plot(showFibLevels ? fib_786 : na,   title="Fib 0.786", color=color.new(color.green, 80), linewidth=1)
plot(showFibLevels ? fib_1 : na,     title="Fib 1.0",   color=color.new(color.gray, 80), linewidth=1)
