// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
strategy("MACD & RSI Watchlist (MTF) Strategy", overlay = true, margin_long = 100, margin_short = 100, initial_capital = 10000)

// --- Group: MACD Settings ---
fastLength   = input.int(12, "MACD Fast Length", minval = 1, group = "MACD Settings")
slowLength   = input.int(26, "MACD Slow Length", minval = 1, group = "MACD Settings")
signalLength = input.int(9, "MACD Signal Length", minval = 1, group = "MACD Settings")

// --- Group: RSI Settings ---
rsiLength    = input.int(14, "RSI Length", minval = 1, group = "RSI Settings")
rsiSource    = input.source(close, "RSI Source", group = "RSI Settings")
rsiMaLength  = input.int(14, "RSI MA Length", minval = 1, group = "RSI Settings")
rsiMaType    = input.string("SMA", "RSI MA Type", options = ["SMA", "EMA", "WMA"], group = "RSI Settings")

// --- Group: Watchlist & Timeframe ---
scanTimeframe = input.timeframe("", "Scanning Timeframe", group = "Watchlist", tooltip = "Select a specific timeframe for the entire scanner. Leave empty ('Same as chart') to follow the chart timeframe.")
s01 = input.symbol("BTCUSDT", "Symbol 01", group = "Watchlist")
s02 = input.symbol("ETHUSDT", "Symbol 02", group = "Watchlist")
s03 = input.symbol("SOLUSDT", "Symbol 03", group = "Watchlist")
s04 = input.symbol("BNBUSDT", "Symbol 04", group = "Watchlist")
s05 = input.symbol("XRPUSDT", "Symbol 05", group = "Watchlist")
s06 = input.symbol("ADAUSDT", "Symbol 06", group = "Watchlist")
s07 = input.symbol("DOGEUSDT", "Symbol 07", group = "Watchlist")
s08 = input.symbol("DOTUSDT", "Symbol 08", group = "Watchlist")
s09 = input.symbol("MATICUSDT", "Symbol 09", group = "Watchlist")
s10 = input.symbol("LINKUSDT", "Symbol 10", group = "Watchlist")

// --- Logic ---
get_signals() =>
    // MACD
    fastMA = ta.ema(close, fastLength)
    slowMA = ta.ema(close, slowLength)
    macdLine = fastMA - slowMA
    signalLine = ta.ema(macdLine, signalLength)
    macdBull = ta.crossover(macdLine, signalLine)
    macdBear = ta.crossunder(macdLine, signalLine)
    
    // RSI
    rsiValue = ta.rsi(rsiSource, rsiLength)
    rsiMA = switch rsiMaType
        "SMA" => ta.sma(rsiValue, rsiMaLength)
        "EMA" => ta.ema(rsiValue, rsiMaLength)
        "WMA" => ta.wma(rsiValue, rsiMaLength)
        => ta.sma(rsiValue, rsiMaLength)
    
    rsiBull = rsiValue > rsiMA
    rsiBear = rsiValue < rsiMA
    
    [macdBull and rsiBull, macdBear and rsiBear]

// Fetch function
fetch_status(ticker) =>
    request.security(ticker, scanTimeframe, get_signals())

// Calculate signals for current chart symbol using the selected timeframe
[bullCross, bearCross] = request.security(syminfo.tickerid, scanTimeframe, get_signals())

// Strategy Execution (Current Symbol)
if bullCross
    strategy.entry("Long", strategy.long, comment = "Bullish " + (scanTimeframe == "" ? "" : scanTimeframe))
    alert("Bullish Signal on " + syminfo.tickerid + " (" + (scanTimeframe == "" ? timeframe.period : scanTimeframe) + ")", alert.freq_once_per_bar)

if bearCross
    strategy.close("Long", comment = "Bearish " + (scanTimeframe == "" ? "" : scanTimeframe))
    alert("Bearish Signal on " + syminfo.tickerid + " (" + (scanTimeframe == "" ? timeframe.period : scanTimeframe) + ")", alert.freq_once_per_bar)

// Watchlist Processing
[b01, r01] = fetch_status(s01)
[b02, r02] = fetch_status(s02)
[b03, r03] = fetch_status(s03)
[b04, r04] = fetch_status(s04)
[b05, r05] = fetch_status(s05)
[b06, r06] = fetch_status(s06)
[b07, r07] = fetch_status(s07)
[b08, r08] = fetch_status(s08)
[b09, r09] = fetch_status(s09)
[b10, r10] = fetch_status(s10)

// Multi-symbol Alerts
allBull = b01 or b02 or b03 or b04 or b05 or b06 or b07 or b08 or b09 or b10 or bullCross
allBear = r01 or r02 or r03 or r04 or r05 or r06 or r07 or r08 or r09 or r10 or bearCross

tfLabel = scanTimeframe == "" ? timeframe.period : scanTimeframe

if allBull
    msg = "Bullish (" + tfLabel + "): " + (bullCross ? syminfo.ticker + " " : "") +
          (b01 ? s01 + " " : "") + (b02 ? s02 + " " : "") + (b03 ? s03 + " " : "") +
          (b04 ? s04 + " " : "") + (b05 ? s05 + " " : "") + (b06 ? s06 + " " : "") +
          (b07 ? s07 + " " : "") + (b08 ? s08 + " " : "") + (b09 ? s09 + " " : "") + (b10 ? s10 + " " : "")
    alert(msg, alert.freq_once_per_bar)

if allBear
    msg = "Bearish (" + tfLabel + "): " + (bearCross ? syminfo.ticker + " " : "") +
          (r01 ? s01 + " " : "") + (r02 ? s02 + " " : "") + (r03 ? s03 + " " : "") +
          (r04 ? s04 + " " : "") + (r05 ? s05 + " " : "") + (r06 ? s06 + " " : "") +
          (r07 ? s07 + " " : "") + (r08 ? s08 + " " : "") + (r09 ? s09 + " " : "") + (r10 ? s10 + " " : "")
    alert(msg, alert.freq_once_per_bar)

// --- Visualization: Dashboard ---
update_row(tbl, row, name, bull, bear) =>
    bg = bull ? color.new(#089981, 30) : bear ? color.new(#f23645, 30) : color.new(chart.bg_color, 0)
    txt = bull ? "BULL" : bear ? "BEAR" : "Neutral"
    table.cell(tbl, 0, row, name, text_color = chart.fg_color)
    table.cell(tbl, 1, row, txt, bgcolor = bg, text_color = chart.fg_color)

var table scannerTable = table.new(position.top_right, 2, 11, border_width = 1, frame_color = chart.fg_color, frame_width = 1)

if barstate.islast
    table.cell(scannerTable, 0, 0, "Symbol (" + tfLabel + ")", bgcolor = color.new(#5b9cf6, 30), text_color = chart.fg_color)
    table.cell(scannerTable, 1, 0, "Signal", bgcolor = color.new(#5b9cf6, 30), text_color = chart.fg_color)
    
    update_row(scannerTable, 1, s01, b01, r01)
    update_row(scannerTable, 2, s02, b02, r02)
    update_row(scannerTable, 3, s03, b03, r03)
    update_row(scannerTable, 4, s04, b04, r04)
    update_row(scannerTable, 5, s05, b05, r05)
    update_row(scannerTable, 6, s06, b06, r06)
    update_row(scannerTable, 7, s07, b07, r07)
    update_row(scannerTable, 8, s08, b08, r08)
    update_row(scannerTable, 9, s09, b09, r09)
    update_row(scannerTable, 10, s10, b10, r10)

// Visual Indicators
plotshape(bullCross, "Bullish Signal", shape.triangleup, location.belowbar, color.new(#089981, 0), size = size.small)
plotshape(bearCross, "Bearish Signal", shape.triangledown, location.abovebar, color.new(#f23645, 0), size = size.small)
