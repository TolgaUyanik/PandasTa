//@version=6

indicator("Liquidity Sweep Hunter | AlphaScript", shorttitle = "Liquidity Hunter | AlphaScript",
     overlay = true, max_lines_count = 200, max_labels_count = 100)

// ═══════════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════════
grpSwing   = "Swing Detection"
grpFilter  = "Filters"
grpDisplay = "Display"

swingLen   = input.int(10,  "Swing Lookback", minval = 3, maxval = 50, group = grpSwing,
     tooltip = "Bars on each side required to confirm a pivot. A pivot is confirmed this many bars after it prints.")
sweepMode  = input.string("Both", "Detection Mode", options = ["Wick", "Reclaim", "Both"], group = grpSwing,
     tooltip = "Wick: pierce and close back inside on the same bar (a sweep). Reclaim: close through, then later close back (a break-and-reclaim — labeled BSL-R / SSL-R). Both: detect either.")
maxLevels  = input.int(10,  "Max Active Levels", minval = 5, maxval = 100, group = grpSwing)
maxAge     = input.int(300, "Max Level Age (bars)", minval = 50, maxval = 2000, group = grpSwing)
maxSweeps  = input.int(10,  "Max Visible Events", minval = 1, maxval = 50, group = grpSwing,
     tooltip = "Older event lines and labels beyond this count are removed.")
recentBars = input.int(500, "Show Signal Shapes (recent bars)", minval = 50, maxval = 5000, group = grpSwing,
     tooltip = "Triangle shapes only appear on the most recent N bars to reduce chart noise. Labels and lines are permanent.")

atrLen  = input.int(14, "ATR Length", minval = 5, group = grpFilter)
atrMult = input.float(0.1, "Min Penetration (ATR mult)", minval = 0.0, maxval = 2.0, step = 0.05, group = grpFilter,
     tooltip = "Minimum penetration beyond the level, as a multiple of ATR. Applies to the wick in Wick mode and to the breakout extreme in Reclaim mode. 0 = no filter.")

showLines  = input.bool(true, "Show Level Lines", group = grpDisplay)
showLabels = input.bool(true, "Show Event Labels", group = grpDisplay)
bullCol    = input.color(#00bcd4, "Bullish Event", group = grpDisplay)
bearCol    = input.color(#f23645, "Bearish Event", group = grpDisplay)
levelCol   = input.color(#787b86, "Level Line", group = grpDisplay)
showBroken = input.bool(true, "Show Broken Levels", group = grpDisplay,
     tooltip = "Levels closed through in Reclaim/Both mode are kept, dimmed and tagged, while they await a possible reclaim. Turn off to hide them for a cleaner chart.")
brokenCol  = input.color(#ff9800, "Broken Level", group = grpDisplay)
lblTxtCol  = input.color(#ffffff, "Label Text Color", group = grpDisplay,
     tooltip = "Text color for event labels. Switch to a dark color if you use a light chart theme.")
levelStyle = input.string("Dotted", "Level Line Style", options = ["Solid", "Dashed", "Dotted"], group = grpDisplay, inline = "ls")
levelWidth = input.int(1, "Width", minval = 1, maxval = 4, group = grpDisplay, inline = "ls")
eventStyle = input.string("Dashed", "Event Line Style", options = ["Solid", "Dashed", "Dotted"], group = grpDisplay, inline = "es")
eventWidth = input.int(2, "Width", minval = 1, maxval = 4, group = grpDisplay, inline = "es")
levelExtend = input.int(50, "Level Line Length (bars)", minval = 5, maxval = 500, group = grpDisplay,
     tooltip = "How many bars a pending (unswept) level line extends to the right. Prevents lines running infinitely across the chart. The line still resolves normally if price sweeps or breaks it.")
showLevelTags = input.bool(true, "Label Pending Levels", group = grpDisplay,
     tooltip = "Tags each unswept swing level as resting liquidity — BSL (buy-side, above swing highs) or SSL (sell-side, below swing lows) — so you can see the levels price may return to sweep. These are targets, not completed sweeps.")
showDash   = input.bool(true, "Show Dashboard", group = grpDisplay)
dashTheme  = input.string("Dark", "Dashboard Theme", options = ["Dark", "Light"], group = grpDisplay,
     tooltip = "Dark for dark chart backgrounds, Light for light ones.")
dashSize   = input.string("Small", "Dashboard Size", options = ["Tiny", "Small", "Normal", "Large"], group = grpDisplay)
dashPos    = input.string("Top Right", "Dashboard Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpDisplay)

// ═══════════════════════════════════════════════════════════════════
//  STATE
// ═══════════════════════════════════════════════════════════════════
type SwingLevel
    float price
    int   lvlTime
    int   lvlBar
    bool  broken   // Reclaim mode: price has closed through, awaiting reclaim
    line  lvlLine
    label lvlTag

var SwingLevel[] bullLevels = array.new<SwingLevel>()
var SwingLevel[] bearLevels = array.new<SwingLevel>()

var line[]  eventLines  = array.new<line>()
var label[] eventLabels = array.new<label>()
var label[] brokenLabels = array.new<label>()

atrVal         = ta.atr(atrLen)
msPerBar       = bar_index > 0 ? time - time[1] : 0
inRecentWindow = bar_index >= last_bar_index - recentBars

// ═══════════════════════════════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════════════════════════════

f_lineStyle(string st) =>
    st == "Solid" ? line.style_solid : st == "Dotted" ? line.style_dotted : line.style_dashed

// Cap retained event drawings to the configured maximum.
f_capEventDrawings() =>
    while eventLabels.size() > maxSweeps
        label.delete(eventLabels.shift())
    while eventLines.size() > maxSweeps
        line.delete(eventLines.shift())

// Visual state for a level that has been closed through and is now
// awaiting a possible reclaim (Reclaim/Both modes). Distinct color +
// a small tag so broken levels are easy to identify; both honor the
// Show Broken Levels toggle.
f_markBroken(SwingLevel lvl, bool isHigh) =>
    label.delete(lvl.lvlTag)
    if not na(lvl.lvlLine)
        // stop the line extending — freeze it at the break bar
        line.set_extend(lvl.lvlLine, extend.none)
        line.set_x2(lvl.lvlLine, time)
        if showBroken
            line.set_color(lvl.lvlLine, color.new(brokenCol, 35))
            line.set_style(lvl.lvlLine, line.style_dashed)
        else
            line.set_color(lvl.lvlLine, color.new(brokenCol, 100))
    if showBroken
        label bl = label.new(bar_index, lvl.price, "× broken", xloc = xloc.bar_index, yloc = yloc.price, style = isHigh ? label.style_label_down : label.style_label_up, color = color.new(brokenCol, 20), textcolor = lblTxtCol, size = size.tiny)
        brokenLabels.push(bl)
        while brokenLabels.size() > maxSweeps
            label.delete(brokenLabels.shift())

// Convert a level's line into a resolved event line and register it.
f_resolveLine(SwingLevel lvl, color eventCol) =>
    label.delete(lvl.lvlTag)
    if not na(lvl.lvlLine)
        line.set_extend(lvl.lvlLine, extend.none)
        line.set_x2(lvl.lvlLine, time)
        line.set_color(lvl.lvlLine, color.new(eventCol, 20))
        line.set_style(lvl.lvlLine, f_lineStyle(eventStyle))
        line.set_width(lvl.lvlLine, eventWidth)
        eventLines.push(lvl.lvlLine)
        f_capEventDrawings()

// ═══════════════════════════════════════════════════════════════════
//  PIVOT DETECTION (confirmed bars only — repaint-safe)
// ═══════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

if not na(ph) and barstate.isconfirmed
    line newLine = showLines ? line.new(time[swingLen], ph, time + levelExtend * msPerBar, ph, xloc = xloc.bar_time, extend = extend.none, color = color.new(levelCol, 40), style = f_lineStyle(levelStyle), width = levelWidth) : line(na)
    label newTag = showLevelTags ? label.new(time + levelExtend * msPerBar, ph, "BSL ⇠", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = color.new(bearCol, 100), textcolor = color.new(bearCol, 15), size = size.tiny) : label(na)
    bearLevels.push(SwingLevel.new(price = ph, lvlTime = time[swingLen], lvlBar = bar_index - swingLen, broken = false, lvlLine = newLine, lvlTag = newTag))
    if bearLevels.size() > maxLevels
        SwingLevel old = bearLevels.shift()
        line.delete(old.lvlLine)
        label.delete(old.lvlTag)

if not na(pl) and barstate.isconfirmed
    line newLine = showLines ? line.new(time[swingLen], pl, time + levelExtend * msPerBar, pl, xloc = xloc.bar_time, extend = extend.none, color = color.new(levelCol, 40), style = f_lineStyle(levelStyle), width = levelWidth) : line(na)
    label newTag = showLevelTags ? label.new(time + levelExtend * msPerBar, pl, "SSL ⇠", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = color.new(bullCol, 100), textcolor = color.new(bullCol, 15), size = size.tiny) : label(na)
    bullLevels.push(SwingLevel.new(price = pl, lvlTime = time[swingLen], lvlBar = bar_index - swingLen, broken = false, lvlLine = newLine, lvlTag = newTag))
    if bullLevels.size() > maxLevels
        SwingLevel old = bullLevels.shift()
        line.delete(old.lvlLine)
        label.delete(old.lvlTag)

// ═══════════════════════════════════════════════════════════════════
//  EVENT DETECTION — confirmed bars only
// ═══════════════════════════════════════════════════════════════════
bool bearSweep   = false   // swing HIGH wicked and rejected (BSL)
bool bullSweep   = false   // swing LOW wicked and rejected (SSL)
bool bearReclaim = false   // swing HIGH broken then reclaimed (BSL-R)
bool bullReclaim = false   // swing LOW broken then reclaimed (SSL-R)

if barstate.isconfirmed
    // ── Swing HIGHS: Buy Side Liquidity ────────────────────────────
    if bearLevels.size() > 0
        for i = bearLevels.size() - 1 to 0
            SwingLevel lvl = bearLevels.get(i)
            if bar_index - lvl.lvlBar > maxAge
                line.delete(lvl.lvlLine)
                label.delete(lvl.lvlTag)
                bearLevels.remove(i)
            else
                bool penOk    = atrMult == 0.0 or high - lvl.price >= atrVal * atrMult
                bool isSweep  = (sweepMode == "Wick" or sweepMode == "Both") and not lvl.broken and high > lvl.price and close < lvl.price and penOk
                bool reclaim  = false
                if sweepMode == "Reclaim" or sweepMode == "Both"
                    if not lvl.broken and close > lvl.price and penOk
                        lvl.broken := true
                        f_markBroken(lvl, true)
                    else if lvl.broken and close < lvl.price
                        reclaim := true
                if isSweep or reclaim
                    bearSweep   := bearSweep   or isSweep
                    bearReclaim := bearReclaim or reclaim
                    f_resolveLine(lvl, bearCol)
                    bearLevels.remove(i)

    // ── Swing LOWS: Sell Side Liquidity ────────────────────────────
    if bullLevels.size() > 0
        for i = bullLevels.size() - 1 to 0
            SwingLevel lvl = bullLevels.get(i)
            if bar_index - lvl.lvlBar > maxAge
                line.delete(lvl.lvlLine)
                label.delete(lvl.lvlTag)
                bullLevels.remove(i)
            else
                bool penOk    = atrMult == 0.0 or lvl.price - low >= atrVal * atrMult
                bool isSweep  = (sweepMode == "Wick" or sweepMode == "Both") and not lvl.broken and low < lvl.price and close > lvl.price and penOk
                bool reclaim  = false
                if sweepMode == "Reclaim" or sweepMode == "Both"
                    if not lvl.broken and close < lvl.price and penOk
                        lvl.broken := true
                        f_markBroken(lvl, false)
                    else if lvl.broken and close > lvl.price
                        reclaim := true
                if isSweep or reclaim
                    bullSweep   := bullSweep   or isSweep
                    bullReclaim := bullReclaim or reclaim
                    f_resolveLine(lvl, bullCol)
                    bullLevels.remove(i)

// ═══════════════════════════════════════════════════════════════════
//  EVENT LABELS
//  BSL / SSL = sweep (wick).  BSL-R / SSL-R = break-and-reclaim.
// ═══════════════════════════════════════════════════════════════════
f_eventLabel(string txt, bool isHigh, color col) =>
    label lbl = label.new(bar_index, isHigh ? high : low, txt, xloc = xloc.bar_index, yloc = isHigh ? yloc.abovebar : yloc.belowbar, color = color.new(col, 10), textcolor = lblTxtCol, style = isHigh ? label.style_label_down : label.style_label_up, size = size.small)
    eventLabels.push(lbl)
    f_capEventDrawings()

if showLabels
    if bearSweep
        f_eventLabel("✗ BSL swept", true, bearCol)
    if bearReclaim
        f_eventLabel("⟲ BSL reclaimed", true, bearCol)
    if bullSweep
        f_eventLabel("✗ SSL swept", false, bullCol)
    if bullReclaim
        f_eventLabel("⟲ SSL reclaimed", false, bullCol)

// ═══════════════════════════════════════════════════════════════════
//  SIGNAL SHAPES — recent bars only (labels and lines are permanent)
// ═══════════════════════════════════════════════════════════════════
plotshape((bullSweep or bullReclaim) and inRecentWindow, title = "SSL — Sell Side Liquidity Taken",
     style = shape.triangleup, location = location.belowbar, color = bullCol, size = size.small)

plotshape((bearSweep or bearReclaim) and inRecentWindow, title = "BSL — Buy Side Liquidity Taken",
     style = shape.triangledown, location = location.abovebar, color = bearCol, size = size.small)

// ═══════════════════════════════════════════════════════════════════
//  DASHBOARD (theme + size configurable)
// ═══════════════════════════════════════════════════════════════════
f_dashPos(string p) =>
    p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right

f_hdrSize(string sz) =>
    sz == "Tiny" ? size.tiny : sz == "Normal" ? size.large : sz == "Large" ? size.huge : size.normal
f_bodySize(string sz) =>
    sz == "Tiny" ? size.tiny : sz == "Small" ? size.tiny : sz == "Large" ? size.normal : size.small

// Theme-derived colors
bool  dkDash   = dashTheme == "Dark"
color dBg      = dkDash ? color.new(#1e222d, 5)  : color.new(#f5f5f5, 5)
color dBorder  = dkDash ? color.new(#363a45, 0)  : color.new(#c0c4cc, 0)
color dHdrBg   = dkDash ? color.new(#2a2e39, 0)  : color.new(#e0e3ea, 0)
color dHdrTx   = dkDash ? #d1d4dc                 : #2a2e39
color dTicker  = dkDash ? #ffeb3b                 : #b58900
color dLabelTx = dkDash ? #ffffff                 : #2a2e39
color dModeTx  = dkDash ? #d1d4dc                 : #4a4e5a

var table dash = na
if barstate.islast and showDash
    if na(dash)
        dash := table.new(f_dashPos(dashPos), 2, 4, bgcolor = dBg, border_color = dBorder, border_width = 1)
    table.cell(dash, 0, 0, "Liquidity Hunter", text_color = dHdrTx, text_size = f_bodySize(dashSize), bgcolor = dHdrBg)
    table.cell(dash, 1, 0, syminfo.ticker, text_color = dTicker, text_size = f_hdrSize(dashSize), bgcolor = dHdrBg)
    table.cell(dash, 0, 1, "Bull Levels", text_color = dLabelTx, text_size = f_bodySize(dashSize))
    table.cell(dash, 1, 1, str.tostring(bullLevels.size()), text_color = bullCol, text_size = f_bodySize(dashSize))
    table.cell(dash, 0, 2, "Bear Levels", text_color = dLabelTx, text_size = f_bodySize(dashSize))
    table.cell(dash, 1, 2, str.tostring(bearLevels.size()), text_color = bearCol, text_size = f_bodySize(dashSize))
    table.cell(dash, 0, 3, "Mode", text_color = dLabelTx, text_size = f_bodySize(dashSize))
    table.cell(dash, 1, 3, sweepMode, text_color = dModeTx, text_size = f_bodySize(dashSize))

// ═══════════════════════════════════════════════════════════════════
//  ALERTS
// ═══════════════════════════════════════════════════════════════════
alertcondition(bullSweep,                 "SSL Sweep",            "Sell Side Liquidity swept — swing low wicked, close back above")
alertcondition(bearSweep,                 "BSL Sweep",            "Buy Side Liquidity swept — swing high wicked, close back below")
alertcondition(bullReclaim,               "SSL Reclaim",          "Swing low broken then reclaimed — close back above the level")
alertcondition(bearReclaim,               "BSL Reclaim",          "Swing high broken then reclaimed — close back below the level")
alertcondition(bullSweep or bearSweep,    "Any Sweep",            "Liquidity sweep detected (wick through, close back inside)")
alertcondition(bullReclaim or bearReclaim,"Any Reclaim",          "Break-and-reclaim detected (close through, then close back)")