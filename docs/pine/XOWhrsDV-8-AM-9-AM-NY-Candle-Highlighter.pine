//@version=5
indicator("8 AM & 9 AM NY Candle Highlighter", overlay=true)

// --- User Inputs ---
// Define the target hours for 8 AM and 9 AM candles
int hour8AM = 8
int hour9AM = 9

// Define the New York Time Zone for accurate time conversion,
// which automatically handles Daylight Saving Time (DST).
string nyTimeZone = "America/New_York"

// Define colors for the candles
color color8AM = color.black // Color for the 8 AM NY candle
color color9AMUp = color.blue // Color for the 9 AM NY candle if it closes above 8 AM close
color color9AMDown = color.red // Color for the 9 AM NY candle if it closes below 8 AM close

// --- Internal Variables ---
// `var` keyword ensures that the variable retains its value across bars,
// and is only initialized once on the first bar.
// This will store the closing price of the 8 AM candle.
var float closeOf8AMCandle = na

// --- Time Zone and Hour Calculation ---
// Get the current hour of the bar in the specified New York timezone.
// `time` is a built-in variable that returns the timestamp of the current bar.
// `hour()` function converts the timestamp to the hour (0-23) in the given timezone.
int currentHourNY = hour(time, nyTimeZone)

// Check if the current bar is the 8 AM NY candle
bool is8AMNYCandle = (currentHourNY == hour8AM)

// Check if the current bar is the 9 AM NY candle
bool is9AMNYCandle = (currentHourNY == hour9AM)

// --- Logic for Candle Coloring ---

// Initialize a variable to hold the color for the current bar.
// By default, it's 'na' (not available), meaning no custom color is applied.
color barCustomColor = na

// 1. Process the 8 AM NY candle
if is8AMNYCandle
    // Store the closing price of the 8 AM candle.
    // This value will be retained for subsequent bars due to 'var' keyword.
    closeOf8AMCandle := close
    // Set the color for the 8 AM candle.
    barCustomColor := color8AM
else if is9AMNYCandle
    // 2. Process the 9 AM NY candle
    // Ensure that we have a valid closing price from the previous 8 AM candle.
    if not na(closeOf8AMCandle)
        // Compare the current 9 AM candle's close with the stored 8 AM candle's close.
        if close > closeOf8AMCandle
            // If 9 AM candle closes above 8 AM candle's close, set color to blue.
            barCustomColor := color9AMUp
        else if close < closeOf8AMCandle
            // If 9 AM candle closes below 8 AM candle's close, set color to red.
            barCustomColor := color9AMDown
        // If the 9 AM candle closes exactly at the 8 AM candle's close,
        // barCustomColor remains 'na', so it will retain its default chart color.

// Reset the stored 8 AM candle close at the start of a new day,
// or after the relevant period (e.g., after 9 AM candle has passed)
// to ensure it's fresh for the next trading day.
// This condition checks if the current hour is less than 8 AM,
// implying we are in a new day before the 8 AM candle.
if currentHourNY < hour8AM and not na(closeOf8AMCandle)
    closeOf8AMCandle := na // Reset for the new day

// Apply the determined custom color to the bar.
// This ensures `barcolor()` is called once per bar at the global scope,
// resolving the "Cannot use 'barcolor' in local scope" error.
barcolor(barCustomColor)
