//@version=5
library("ALGEBRA", overlay=true)

// -----------------------------------------
// Function: line_fromXy
// Purpose:  Calculate the slope and y-intercept of a line given two points.
// Inputs: 
//    x1 (int):  x-coordinate (bar index) of the first point.
//    y1 (float): y-coordinate (price) of the first point.
//    x2 (int):  x-coordinate (bar index) of the second point.
//    y2 (float): y-coordinate (price) of the second point.
// Returns: A tuple containing the slope (float) and y-intercept (float) of the line.
// -----------------------------------------
export line_fromXy(int x1, float y1, int x2, float y2) =>
    var float slope = (y2 - y1) / (x2 - x1)
    var float yInt = y1 - slope * x1
    [slope, yInt]

// -----------------------------------------
// Function: line_getPrice
// Purpose: Calculate the price (y-coordinate) at a given x-coordinate (bar index) on a line.
// Inputs:
//    x (int): The x-coordinate (bar index) at which to calculate the price.
//    slope (float): The slope of the line.
//    yInt (float): The y-intercept of the line.
// Returns: The calculated price (float) at the given x-coordinate.
// -----------------------------------------
export line_getPrice(int x, float slope, float yInt) =>
    slope * x + yInt

// -----------------------------------------
// Function: line_length
// Purpose: Calculate the length of a line segment between two points.
// Inputs:
//    x1 (int):  x-coordinate (bar index) of the first point.
//    y1 (float): y-coordinate (price) of the first point.
//    x2 (int):  x-coordinate (bar index) of the second point.
//    y2 (float): y-coordinate (price) of the second point.
// Returns: The length of the line segment (float).
// -----------------------------------------
export line_length(int x1, float y1, int x2, float y2) =>
    var float deltaX = x2 - x1
    var float deltaY = y2 - y1
    math.sqrt(deltaX * deltaX + deltaY * deltaY)

// -----------------------------------------
// Function: distance
// Purpose: Calculate the distance between two points.
// Inputs:
//    x1 (int):  x-coordinate (bar index) of the first point.
//    y1 (float): y-coordinate (price) of the first point.
//    x2 (int):  x-coordinate (bar index) of the second point.
//    y2 (float): y-coordinate (price) of the second point.
// Returns: The distance between the two points (float).
// -----------------------------------------
export distance(int x1, float y1, int x2, float y2) =>
    line_length(x1, y1, x2, y2)