//@version=6
indicator("MCX - Supertrend (10,2) + Heikin Ashi 3H - Indicator w/ alerts", overlay=true)

// =====================================================================
// GENERIC ALERT INDICATOR
// =====================================================================
// Works on whatever candle type your chart is currently set to
// (regular, Heikin Ashi, etc.) — it just uses the chart's own
// close/high/low. Point the Supertrend input below at whatever
// Supertrend indicator/settings you already have plotted.
//
// Rules:
//   Long entry  : Close > Supertrend AND Close > previous High
//   Long exit   : Close < previous Low
//   Short entry : Close < Supertrend AND Close < previous Low
//   Short exit  : Close > previous High
//   (Reversals happen on the same bar when the opposite entry
//    condition fires immediately after an exit.)
// =====================================================================

// ---------------- Input: map these to your built-in Supertrend's two plots ----------------
// TradingView's built-in Supertrend outputs TWO separate plots ("Up Trend" and
// "Down Trend"), each blank (na) whenever the other is active. Map both below;
// this script merges them into one continuous value automatically.
superTrendUp   = input.source(close, "Supertrend - Up Trend plot")
superTrendDown = input.source(close, "Supertrend - Down Trend plot")
superTrendSrc  = na(superTrendUp) ? superTrendDown : superTrendUp

// ---------------- Previous-bar references ----------------
prevHigh = high[1]
prevLow  = low[1]

// ---------------- Raw conditions ----------------
longEntryCond  = close > superTrendSrc and close > prevHigh
longExitCond   = close < prevLow
shortEntryCond = close < superTrendSrc and close < prevLow
shortExitCond  = close > prevHigh

// ---------------- Position state machine (so alerts fire once, on the transition, not every bar the condition holds) ----------------
var position = 0   // 0 = flat, 1 = long, -1 = short

fireLongEntry  = false
fireLongExit   = false
fireShortEntry = false
fireShortExit  = false

if position == 0
    if longEntryCond
        fireLongEntry := true
        position := 1
    else if shortEntryCond
        fireShortEntry := true
        position := -1
else if position == 1
    if longExitCond
        fireLongExit := true
        position := 0
        if shortEntryCond
            fireShortEntry := true
            position := -1
else if position == -1
    if shortExitCond
        fireShortExit := true
        position := 0
        if longEntryCond
            fireLongEntry := true
            position := 1

// ---------------- Debug: plot the Supertrend source you selected ----------------
// If this line just traces exactly on top of price / doesn't move like your
// Supertrend indicator, the input below is still defaulted to "close" (or
// otherwise mismapped) and needs to be fixed in Settings > Inputs.
plot(superTrendSrc, title="DEBUG - Supertrend Input Value", color=color.blue, linewidth=1)

// ---------------- Plots ----------------
// Entry labels: clear BUY / SELL text on the chart
if fireLongEntry
    label.new(bar_index, low, text="BUY", yloc=yloc.belowbar,
         style=label.style_label_up, color=color.new(color.green, 0),
         textcolor=color.white, size=size.small)

if fireShortEntry
    label.new(bar_index, high, text="SELL", yloc=yloc.abovebar,
         style=label.style_label_down, color=color.new(color.red, 0),
         textcolor=color.white, size=size.small)

// Exit markers: smaller, muted, so BUY/SELL entries stay the visual focus
plotshape(fireLongExit, style=shape.xcross, location=location.abovebar, color=color.green, size=size.tiny, title="Long Exit")
plotshape(fireShortExit, style=shape.xcross, location=location.belowbar, color=color.red, size=size.tiny, title="Short Exit")

// ---------------- Alerts ----------------
alertcondition(fireLongEntry, title="Long Entry", message="SILVER: ENTER LONG (Close crossed above Supertrend & prev High)")
alertcondition(fireLongExit, title="Long Exit", message="SILVER: EXIT LONG (Close crossed below prev Low)")
alertcondition(fireShortEntry, title="Short Entry", message="SILVER: ENTER SHORT (Close crossed below Supertrend & prev Low)")
alertcondition(fireShortExit, title="Short Exit", message="SILVER: EXIT SHORT (Close crossed above prev High)")
