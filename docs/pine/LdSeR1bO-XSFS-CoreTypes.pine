
//@version=5
library("XSFS_CoreTypes", overlay=false)

// ---------- Helpers ----------
export f_top(float a, float b) => math.max(a,b)
export f_bot(float a, float b) => math.min(a,b)
export f_mid(float top, float bot) => (top + bot) * 0.5
export f_clamp(int v, int lo, int hi) => math.min(hi, math.max(lo, v))

export f_lineStyle2(string st)=>
    st=="Dotted"?line.style_dotted:st=="Dashed"?line.style_dashed:line.style_solid

// ---------- Types ----------
export type SetupState
    int   dir
    int   status
    float obTop
    float obBot
    int   obT0
    float oteTop
    float oteBot
    int   oteT0
    float fvgTop
    float fvgBot
    int   fvgT0
    float atr

export type FiltersState
    bool biasOK
    bool pdOK
    bool emaOK
    bool vwapOK
    bool kzOK
    bool m5OK
    bool trigOK

export type FinalState
    bool tradable
    string phase
    int score