//@version=5
indicator("Smart Impulse Exhaustion Finder (ATR + ADX Filter)", overlay=true)

// === INPUTS ===
rsiLength = input.int(14, "RSI Length")
rsiOB = input.int(80, "RSI Overbought Level")
rsiOS = input.int(20, "RSI Oversold Level")
volLength = input.int(20, "Volume SMA Length")
volMultiplier = input.float(1.5, "Volume Spike Multiplier")
wickThreshold = input.float(50.0, "Wick Threshold % of Candle")
extremumLength = input.int(50, "Extremum Lookback Bars")
adxLength = input.int(14, "ADX Length")
adxThreshold = input.int(20, "Min ADX (Trend Strength)")
bodyATRFactor = input.float(0.3, "Min Body Size (ATR %)")

// === RSI ===
rsi = ta.rsi(close, rsiLength)

// === Volume Spike ===
volSMA = ta.sma(volume, volLength)
volSpike = volume > volSMA * volMultiplier

// === Wick ===
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
candleSize = high - low
upperWickPct = upperWick / candleSize * 100
lowerWickPct = lowerWick / candleSize * 100

upperWickLarge = upperWickPct >= wickThreshold
lowerWickLarge = lowerWickPct >= wickThreshold

// === Extremums ===
newHigh = high == ta.highest(high, extremumLength)
newLow = low == ta.lowest(low, extremumLength)

// === ATR Filter ===
atr = ta.atr(14)
bigCandle = candleSize >= atr

// === Impulse Move ===
prevHigh = ta.highest(high, extremumLength)[1]
prevLow = ta.lowest(low, extremumLength)[1]
impulseUp = high - prevHigh >= atr * 1.0
impulseDown = prevLow - low >= atr * 1.0

// === Trend Filter (manual ADX) ===
upMove = ta.change(high)
downMove = -ta.change(low)
plusDM = na(upMove) ? na : (upMove > downMove and upMove > 0 ? upMove : 0)
minusDM = na(downMove) ? na : (downMove > upMove and downMove > 0 ? downMove : 0)
trur = ta.rma(ta.tr(true), adxLength)
plusDI = 100 * ta.rma(plusDM, adxLength) / trur
minusDI = 100 * ta.rma(minusDM, adxLength) / trur
adx = ta.rma(math.abs(plusDI - minusDI) / (plusDI + minusDI) * 100, adxLength)

trendOK = adx > adxThreshold

// === Body Filter ===
bodySize = math.abs(close - open)
bodyOK = bodySize >= atr * bodyATRFactor

// === Combined Conditions ===
bearCount = (rsi > rsiOB ? 1 : 0) + (volSpike ? 1 : 0) + (upperWickLarge ? 1 : 0)
bullCount = (rsi < rsiOS ? 1 : 0) + (volSpike ? 1 : 0) + (lowerWickLarge ? 1 : 0)

bearExhaustion = newHigh and bearCount >= 2 and bigCandle and impulseUp and trendOK and bodyOK
bullExhaustion = newLow and bullCount >= 2 and bigCandle and impulseDown and trendOK and bodyOK

// === Plots ===
plotshape(bearExhaustion, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Bear Exhaustion")
plotshape(bullExhaustion, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Bull Exhaustion")

// === Alerts ===
alertcondition(bearExhaustion, title="Bearish Impulse Exhaustion", message="Bearish impulse exhaustion detected")
alertcondition(bullExhaustion, title="Bullish Impulse Exhaustion", message="Bullish impulse exhaustion detected")
