//@version=6
indicator("IB + 9 SMA Candle 30% Levels", overlay=true, max_lines_count=500)

// Inputs
smaLength = input.int(9, "SMA Length")
nySession = input.session("0830-0930", "NY Initial Balance")
asiaSession = input.session("0000-0100", "Asia Initial Balance")
lineLength = input.int(1, "Line Extension (Bars)", minval=1)

// 9 SMA
sma9 = ta.sma(close, smaLength)
plot(sma9, color=color.yellow, title="9 SMA")

// Session detection
inNY = not na(time(timeframe.period, nySession, "America/New_York"))
inAsia = not na(time(timeframe.period, asiaSession, "Asia/Tokyo"))

// Track NY IB
var float nyHigh = na
var float nyLow = na
var int nyTime = na

if inNY and not inNY[1]
    nyHigh := high
    nyLow := low
    nyTime := time

if inNY
    nyHigh := math.max(nyHigh, high)
    nyLow := math.min(nyLow, low)


// Track Asia IB
var float asiaHigh = na
var float asiaLow = na
var int asiaTime = na

if inAsia and not inAsia[1]
    asiaHigh := high
    asiaLow := low
    asiaTime := time

if inAsia
    asiaHigh := math.max(asiaHigh, high)
    asiaLow := math.min(asiaLow, low)


// Select most recent IB
float activeIBHigh = na
float activeIBLow = na

if not na(nyTime) and not na(asiaTime)
    if nyTime > asiaTime
        activeIBHigh := nyHigh
        activeIBLow := nyLow
    else
        activeIBHigh := asiaHigh
        activeIBLow := asiaLow
else if not na(nyTime)
    activeIBHigh := nyHigh
    activeIBLow := nyLow
else if not na(asiaTime)
    activeIBHigh := asiaHigh
    activeIBLow := asiaLow


// Conditions
touchSMA = high >= sma9 and low <= sma9

// Candle overlaps IB
insideIB = not na(activeIBHigh) and 
     high >= activeIBLow and 
     low <= activeIBHigh


qualifyingCandle = touchSMA and insideIB


// Plot candle 30% levels
if qualifyingCandle
    candleRange = high - low
    
    top30 = high - candleRange * 0.30
    bottom30 = low + candleRange * 0.30
    
    line.new(
         bar_index,
         top30,
         bar_index + lineLength,
         top30,
         color=color.red,
         width=2
     )

    line.new(
         bar_index,
         bottom30,
         bar_index + lineLength,
         bottom30,
         color=color.green,
         width=2
     )



// Optional IB visualization
plot(activeIBHigh, "Active IB High", color=color.blue, style=plot.style_linebr)
plot(activeIBLow, "Active IB Low", color=color.blue, style=plot.style_linebr)
