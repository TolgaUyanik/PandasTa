// Trade Wzrd - Library Alert String Utils
// Library name (import): TradeWzrdAlerts
//
// Builds comma-separated Trade Wzrd webhook signals for all 15 commands.
// Parser accepts any token order; this library always emits:
//   COMMAND,SYMBOL[,KEY=VALUE...]
//
// Decisions (v1):
// - ticket: string, optional (omit when blank)
// - symbol: pass-through (no forced uppercase)
// - OFFSET: omit when not provided (na); emit when user sets a value including 0
// - primary command names only (no aliases)
// - COMMENT: strips "," and ";" so multi-command grammar cannot break
// - invalid required fields => empty string (caller must not fire empty alerts)
//
// Zero-config helpers emit TPSLTYPE=PRICE with format.mintick prices
// (strategy SL/TP prices in, no manual pip math).

//@version=6
//@description Trade Wzrd webhook signal builders. One export per command plus zero-config PRICE helpers and multi-command join. Educational protocol library for automation alert messages. Not a signal service.
library("TradeWzrdAlerts", overlay = true)

// ═══════════════════════════════════════════════════════════════════════════
// CORE
// ═══════════════════════════════════════════════════════════════════════════

// Format numbers for signal text. Uses mintick when on a chart context.
fmtNum(float x) =>
    na(x) ? "" : str.tostring(x, format.mintick)

// Sanitize free text so it cannot inject extra commands/params.
cleanText(string s) =>
    str.replace_all(str.replace_all(s, ",", " "), ";", " ")

// Append KEY=VALUE only when value is non-empty after trim.
appendKV(string body, string key, string val) =>
    string v = str.trim(val)
    v == "" ? body : body + "," + key + "=" + v

appendNum(string body, string key, float x) =>
    na(x) ? body : appendKV(body, key, fmtNum(x))

appendStr(string body, string key, string s) =>
    s == "" ? body : appendKV(body, key, cleanText(s))

// True flags only (CLOSEALL filters).
appendFlag(string body, string key, bool on) =>
    on ? appendKV(body, key, "true") : body

// VOL vs RISK sizing fragment.
appendSize(string body, float vol, float risk) =>
    not na(vol) ? appendNum(body, "VOL", vol) : not na(risk) ? appendNum(body, "RISK", risk) : body

// Base: COMMAND,SYMBOL
base(string command, string symbol) =>
    string sym = str.trim(symbol)
    str.trim(command) == "" or sym == "" ? "" : str.trim(command) + "," + sym

// Shared optional tail used by many entry-like commands.
// Order: VOL/RISK, PRICE, SL, TP, TPSLTYPE, MAGIC, COMMENT, TICKET, SIDE, OFFSET, PERCENT, flags
tailCommon(string body, float vol=na, float risk=na, float price=na, float sl=na, float tp=na, string tpslType="", string magic="", string comment="", string ticket="", string side="", float offset=na, float percent=na, bool positive=false, bool negative=false, bool pending=false, bool positions=false) =>
    string b = body
    b := appendSize(b, vol, risk)
    b := appendNum(b, "PRICE", price)
    b := appendNum(b, "SL", sl)
    b := appendNum(b, "TP", tp)
    b := appendStr(b, "TPSLTYPE", tpslType)
    b := appendStr(b, "MAGIC", magic)
    b := appendStr(b, "COMMENT", comment)
    b := appendStr(b, "TICKET", ticket)
    b := appendStr(b, "SIDE", side)
    b := appendNum(b, "OFFSET", offset)
    b := appendNum(b, "PERCENT", percent)
    b := appendFlag(b, "POSITIVE", positive)
    b := appendFlag(b, "NEGATIVE", negative)
    b := appendFlag(b, "PENDING", pending)
    b := appendFlag(b, "POSITIONS", positions)
    b

// ═══════════════════════════════════════════════════════════════════════════
// MARKET
// ═══════════════════════════════════════════════════════════════════════════

// BUY — market long
export buy(string symbol, float vol=na, float risk=na, float sl=na, float tp=na, string tpslType="", string magic="", string comment="", string ticket="") =>
    string b = base("BUY", symbol)
    b == "" ? "" : tailCommon(b, vol=vol, risk=risk, sl=sl, tp=tp, tpslType=tpslType, magic=magic, comment=comment, ticket=ticket)

// SELL — market short
export sell(string symbol, float vol=na, float risk=na, float sl=na, float tp=na, string tpslType="", string magic="", string comment="", string ticket="") =>
    string b = base("SELL", symbol)
    b == "" ? "" : tailCommon(b, vol=vol, risk=risk, sl=sl, tp=tp, tpslType=tpslType, magic=magic, comment=comment, ticket=ticket)

// ═══════════════════════════════════════════════════════════════════════════
// PENDING (require PRICE)
// ═══════════════════════════════════════════════════════════════════════════

export buyLimit(string symbol, float price, float vol=na, float risk=na, float sl=na, float tp=na, string tpslType="", string magic="", string comment="", string ticket="") =>
    string b = base("BUYLIMIT", symbol)
    b == "" or na(price) ? "" : tailCommon(b, vol=vol, risk=risk, price=price, sl=sl, tp=tp, tpslType=tpslType, magic=magic, comment=comment, ticket=ticket)

export sellLimit(string symbol, float price, float vol=na, float risk=na, float sl=na, float tp=na, string tpslType="", string magic="", string comment="", string ticket="") =>
    string b = base("SELLLIMIT", symbol)
    b == "" or na(price) ? "" : tailCommon(b, vol=vol, risk=risk, price=price, sl=sl, tp=tp, tpslType=tpslType, magic=magic, comment=comment, ticket=ticket)

export buyStop(string symbol, float price, float vol=na, float risk=na, float sl=na, float tp=na, string tpslType="", string magic="", string comment="", string ticket="") =>
    string b = base("BUYSTOP", symbol)
    b == "" or na(price) ? "" : tailCommon(b, vol=vol, risk=risk, price=price, sl=sl, tp=tp, tpslType=tpslType, magic=magic, comment=comment, ticket=ticket)

export sellStop(string symbol, float price, float vol=na, float risk=na, float sl=na, float tp=na, string tpslType="", string magic="", string comment="", string ticket="") =>
    string b = base("SELLSTOP", symbol)
    b == "" or na(price) ? "" : tailCommon(b, vol=vol, risk=risk, price=price, sl=sl, tp=tp, tpslType=tpslType, magic=magic, comment=comment, ticket=ticket)

// ═══════════════════════════════════════════════════════════════════════════
// FUTURES BRACKET / REMOVE
// ═══════════════════════════════════════════════════════════════════════════

// BRACKET — entry with SL+TP brackets (futures OSO; forex behaves like BUY/SELL+SL/TP)
export bracket(string symbol, float vol=na, float risk=na, float sl=na, float tp=na, string tpslType="", string magic="", string comment="", string ticket="") =>
    string b = base("BRACKET", symbol)
    b == "" ? "" : tailCommon(b, vol=vol, risk=risk, sl=sl, tp=tp, tpslType=tpslType, magic=magic, comment=comment, ticket=ticket)

export removeSl(string symbol, string ticket="") =>
    string b = base("REMOVE_SL", symbol)
    b == "" ? "" : tailCommon(b, ticket=ticket)

export removeTp(string symbol, string ticket="") =>
    string b = base("REMOVE_TP", symbol)
    b == "" ? "" : tailCommon(b, ticket=ticket)

// ═══════════════════════════════════════════════════════════════════════════
// MODIFY / BREAKEVEN
// ═══════════════════════════════════════════════════════════════════════════

// MODIFY — at least one of SL or TP required
export modify(string symbol, float sl=na, float tp=na, string tpslType="", string magic="", string comment="", string ticket="", string side="") =>
    string b = base("MODIFY", symbol)
    b == "" or (na(sl) and na(tp)) ? "" : tailCommon(b, sl=sl, tp=tp, tpslType=tpslType, magic=magic, comment=comment, ticket=ticket, side=side)

// BREAKEVEN — OFFSET omitted when na (user did not set). Pass 0.0 explicitly to send OFFSET=0
export breakEven(string symbol, float offset=na, string tpslType="", string magic="", string comment="", string ticket="", string side="") =>
    string b = base("BREAKEVEN", symbol)
    b == "" ? "" : tailCommon(b, offset=offset, tpslType=tpslType, magic=magic, comment=comment, ticket=ticket, side=side)

// ═══════════════════════════════════════════════════════════════════════════
// CLOSE / CLOSEALL / LAYER / CANCEL
// ═══════════════════════════════════════════════════════════════════════════

// CLOSE — full if no percent/vol; partial via PERCENT; layer-style via VOL
export close(string symbol, float percent=na, float vol=na, string magic="", string comment="", string ticket="", string side="") =>
    string b = base("CLOSE", symbol)
    b == "" ? "" : tailCommon(b, vol=vol, magic=magic, comment=comment, ticket=ticket, side=side, percent=percent)

export closeAll(string symbol, bool positive=false, bool negative=false, bool pending=false, bool positions=false, string magic="", string comment="", string ticket="") =>
    string b = base("CLOSEALL", symbol)
    b == "" ? "" : tailCommon(b, magic=magic, comment=comment, ticket=ticket, positive=positive, negative=negative, pending=pending, positions=positions)

// LAYER_CLOSE — VOL required
export layerClose(string symbol, float vol, string magic="", string comment="", string ticket="", string side="") =>
    string b = base("LAYER_CLOSE", symbol)
    b == "" or na(vol) ? "" : tailCommon(b, vol=vol, magic=magic, comment=comment, ticket=ticket, side=side)

export cancel(string symbol, string magic="", string comment="", string ticket="", string side="") =>
    string b = base("CANCEL", symbol)
    b == "" ? "" : tailCommon(b, magic=magic, comment=comment, ticket=ticket, side=side)

// ═══════════════════════════════════════════════════════════════════════════
// MULTI-COMMAND
// ═══════════════════════════════════════════════════════════════════════════

// Join non-empty signals with ";" (max 6 segments)
export multi(string a, string b="", string c="", string d="", string e="", string f="") =>
    string out = ""
    if str.trim(a) != ""
        out := str.trim(a)
    if str.trim(b) != ""
        out := out == "" ? str.trim(b) : out + ";" + str.trim(b)
    if str.trim(c) != ""
        out := out == "" ? str.trim(c) : out + ";" + str.trim(c)
    if str.trim(d) != ""
        out := out == "" ? str.trim(d) : out + ";" + str.trim(d)
    if str.trim(e) != ""
        out := out == "" ? str.trim(e) : out + ";" + str.trim(e)
    if str.trim(f) != ""
        out := out == "" ? str.trim(f) : out + ";" + str.trim(f)
    out

// ═══════════════════════════════════════════════════════════════════════════
// ZERO-CONFIG (PRICE mode) — from prior TradeWzrd automation system
// Pass exact strategy stop/limit prices; no pip conversion.
// sizeMode: "RISK" or "VOL"
// ═══════════════════════════════════════════════════════════════════════════

export resolveSymbol(string override="") =>
    str.trim(override) != "" ? str.trim(override) : str.replace_all(syminfo.ticker, "!", "")

// BUY/SELL with absolute SL/TP prices (TPSLTYPE=PRICE)
export entryPrice(string action, string symbol, float slPrice, float tpPrice, float sizeVal, string sizeMode="RISK", string magic="", string comment="") =>
    string act = str.upper(str.trim(action))
    string b = base(act, symbol)
    if b == "" or (act != "BUY" and act != "SELL" and act != "BRACKET")
        ""
    else
        float vol = sizeMode == "VOL" ? sizeVal : na
        float risk = sizeMode == "RISK" ? sizeVal : na
        tailCommon(b, vol=vol, risk=risk, sl=slPrice, tp=tpPrice, tpslType="PRICE", magic=magic, comment=comment)

export buyPrice(string symbol, float slPrice, float tpPrice, float sizeVal, string sizeMode="RISK", string magic="", string comment="") =>
    entryPrice("BUY", symbol, slPrice, tpPrice, sizeVal, sizeMode, magic, comment)

export sellPrice(string symbol, float slPrice, float tpPrice, float sizeVal, string sizeMode="RISK", string magic="", string comment="") =>
    entryPrice("SELL", symbol, slPrice, tpPrice, sizeVal, sizeMode, magic, comment)

export bracketPrice(string symbol, float slPrice, float tpPrice, float sizeVal, string sizeMode="RISK", string magic="", string comment="") =>
    entryPrice("BRACKET", symbol, slPrice, tpPrice, sizeVal, sizeMode, magic, comment)

// Partial / full close helpers
export closePercent(string symbol, float percent, string side="", string magic="") =>
    close(symbol, percent=percent, magic=magic, side=side)

export closeFull(string symbol, string side="", string magic="") =>
    close(symbol, magic=magic, side=side)

// MODIFY SL to an absolute price (breakeven/trail after you compute price in strategy)
export modifySlPrice(string symbol, float slPrice, string side="", string magic="") =>
    modify(symbol, sl=slPrice, tpslType="PRICE", magic=magic, side=side)

// Compute BE price then MODIFY — long adds offset, short subtracts
// offsetPrice: absolute price distance (0 allowed and emitted if you pass 0)
export breakEvenPrice(string symbol, float entryPrice, bool isLong, float offsetPrice=0.0, string magic="") =>
    float newSl = isLong ? entryPrice + offsetPrice : entryPrice - offsetPrice
    modifySlPrice(symbol, newSl, side=isLong ? "BUY" : "SELL", magic=magic)

// Pip/tick distance entries (TPSLTYPE set by caller)
export entryDist(string action, string symbol, float slDist, float tpDist, string tpslType, float sizeVal, string sizeMode="VOL", string magic="", string comment="") =>
    string act = str.upper(str.trim(action))
    string b = base(act, symbol)
    if b == "" or (act != "BUY" and act != "SELL" and act != "BRACKET")
        ""
    else
        float vol = sizeMode == "VOL" ? sizeVal : na
        float risk = sizeMode == "RISK" ? sizeVal : na
        tailCommon(b, vol=vol, risk=risk, sl=slDist, tp=tpDist, tpslType=tpslType, magic=magic, comment=comment)
