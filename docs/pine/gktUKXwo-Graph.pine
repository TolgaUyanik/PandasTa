//@version=5

// @description Library to collect data and draw scatterplot and heatmap as graph
library("Graph", overlay = true)

import Trendoscope/InsertionSort/1

// @enum Type of Graphs
// @field scatterplot Scatterplot graph type
// @field heatmap Heatmap graph type
export enum GraphType
	scatterplot
	heatmap

// @type Coordinates of sample data
// @field xValue x value of the sample data
// @field yValue y value of the sample data
export type Coordinate
	float xValue
	float yValue

// @type Data belonging to particular quadrant
// @field coordinates Coordinates present in given quadrant
export type Quadrant
    array<Coordinate> coordinates

// @type Properties of Graph that needs to be drawn 
// @field rows Number of rows (y values) in each quadrant
// @field columns number of columns (x values) in each quadrant
// @field graphtype Type of graph - scatterplot or heatmap
// @field plotColor color of plots or heatmap
// @field plotSize size of cells in the table
// @field plotchar Character to be printed for display of scatterplot
// @field outliers Excude the outlier percent of data from calculating the min and max
// @field position Table position
// @field bgColor graph background color
// @field summaryBgColor background color of quadrant summary label
// @field summaryTextColor text color of quadrant summary label
// @field summaryTextSize Size of the quadrant summary text
export type GraphProperties
	int rows = 10
	int columns = 15
	GraphType graphtype = GraphType.scatterplot
	color plotColor = color.yellow
	string plotSize = size.large
	string plotchar = '•'
	int outliers = 20
	string position = position.middle_center
	color bgColor = chart.bg_color
	color summaryBgColor = color.maroon
	color summaryTextColor = color.white
	string summaryTextSize = size.huge


// @type Range of a plot in terms of x and y values and the number of data points that fall within the Range
// @field minX min range of X value
// @field maxX max range of X value
// @field minY min range of Y value
// @field maxY max range of Y value
// @field count number of samples in the range
export type PlotRange
	float minX
	float maxX
	float minY
	float maxY
	int count

method tostring(PlotRange this)=> str.format('X ( {0} : {1} )\n Y ( {2} : {3} )\nCount {4}', this.minX, this.maxX, this.minY, this.maxY, this.count)

// @type Graph data and properties
// @field properties Graph Properties object associated
// @field quadrants Array containing 4 quadrant data
// @field plotRanges range and count for each cell
// @field xArray array of x values
// @field yArray arrray of y values
export type Graph
	GraphProperties properties
    array<Quadrant> quadrants
	matrix<PlotRange> plotRanges
	array<float> xArray
	array<float> yArray

// @function Initialise Quadrant Data
// @param this Quadrant object that needs to be initialised
// @returns current Quadrant object
export method init(Quadrant this)=>
    this.coordinates := array.new<Coordinate>()
    this

// @function Initialise Graph Data
// @param this Graph object that needs to be initialised with 4 Quadrants
// @returns current Graph object
export method init(Graph this)=>
    if(na(this.properties))
		this.properties := GraphProperties.new()
	this.xArray := array.new<float>()
	this.yArray := array.new<float>()
	this.plotRanges := matrix.new<PlotRange>(this.properties.rows*2, this.properties.columns*2)
	this.quadrants := array.new<Quadrant>()
    for i =0 to 3
        this.quadrants.push(Quadrant.new().init())
    this

// @function Add coordinates to graph
// @param this Graph object
// @param data Coordinates containing x, y data
// @returns current Graph object
export method add(Graph this, Coordinate data)=>
    quadrantIndex = math.sign(data.xValue) == math.sign(data.yValue)? (data.xValue > 0 ? 0 : 2) : (data.xValue > 0? 3 : 1)
    this.quadrants.get(quadrantIndex).coordinates.push(data)
	this.xArray.binary_insertion_sort(math.abs(data.xValue), InsertionSort.ORDER.ASC)
	this.yArray.binary_insertion_sort(math.abs(data.yValue), InsertionSort.ORDER.ASC)

// @function Calculation required for plotting the graph
// @param this Graph object
// @returns current Graph object
export method calculate(Graph this)=>
	maxX = this.xArray.percentile_linear_interpolation(100-this.properties.outliers)
	minX = this.xArray.percentile_linear_interpolation(this.properties.outliers)
	maxY = this.yArray.percentile_linear_interpolation(100-this.properties.outliers)
	minY = this.yArray.percentile_linear_interpolation(this.properties.outliers)

	plots = matrix.new<int>(this.properties.rows*2, this.properties.columns*2, 0)
    for quadrant in this.quadrants
        for coordinate in quadrant.coordinates
            absX = math.max(math.min(math.abs(coordinate.xValue), maxX), minX)
            absY = math.max(math.min(math.abs(coordinate.yValue), maxY), minY)
            xAsIndex = ((absX-minX)/(maxX-minX))*(this.properties.columns-1)
            yAsIndex = ((absY - minY)/(maxY-minY))*(this.properties.rows-1)

            yIndex =  int(coordinate.yValue > 0? (this.properties.rows - 1 - yAsIndex) : (this.properties.rows + yAsIndex))
            xIndex = int(coordinate.xValue > 0? (this.properties.columns + xAsIndex) : (this.properties.columns - 1 - xAsIndex))

            plots.set(yIndex, xIndex, plots.get(yIndex, xIndex) + 1)

	for i = 0 to this.properties.columns-1
		for j = 0 to this.properties.rows -1
			minXR = minX+(i/this.properties.columns)*(maxX-minX)
			maxXR = minX+((i+1)/this.properties.columns)*(maxX-minX)
			minYR = minY+(j/this.properties.rows)*(maxY-minY)
			maxYR = minY+((j+1)/this.properties.rows)*(maxY-minY)

			q1i = this.properties.columns+i
			q1j = this.properties.rows-1-j
			this.plotRanges.set(q1j, q1i, PlotRange.new(minXR, maxXR, minYR, maxYR, plots.get(q1j, q1i)))

			q2i = this.properties.columns-1-i
			q2j = this.properties.rows-1-j
			this.plotRanges.set(q2j, q2i, PlotRange.new(-minXR, -maxXR, minYR, maxYR, plots.get(q2j, q2i)))

			q3i = this.properties.columns-1-i
			q3j = this.properties.rows+j
			this.plotRanges.set(q3j, q3i, PlotRange.new(-minXR, -maxXR, -minYR, -maxYR, plots.get(q3j, q3i)))

			q4i = this.properties.columns+i
			q4j = this.properties.rows+j
			this.plotRanges.set(q4j, q4i, PlotRange.new(minXR, maxXR, -minYR, -maxYR, plots.get(q4j, q4i)))
	this

// @function Draw graph
// @param this Graph object
// @returns current Graph object
export method paint(Graph this)=>
    var graphTable = table.new(this.properties.position, this.properties.columns*2, this.properties.rows*2,
				 this.properties.bgColor, this.properties.plotColor, 1, force_overlay = true)

    array<int> uniqueValues = array.new<int>()
    for i = 0 to this.plotRanges.rows()-1
        for j=0 to this.plotRanges.columns()-1
            val = this.plotRanges.get(i, j)
			if(val.count != 0 and not uniqueValues.includes(val.count))
				uniqueValues.push(val.count)

	uniqueValues.sort()

    displaySymbol = this.properties.graphtype == GraphType.scatterplot? this.properties.plotchar : ''

    for i = 0 to this.plotRanges.rows()-1
        for j=0 to this.plotRanges.columns()-1
            val = this.plotRanges.get(i, j)
            transparency = val.count == 0? 100  : (70 - 70*(uniqueValues.indexof(val.count)/uniqueValues.size()))
			tooltip = val.tostring()

            bgColor = this.properties.graphtype == GraphType.heatmap? color.new(this.properties.plotColor, transparency) : this.properties.bgColor
            graphTable.cell(j, i, displaySymbol, width=1, height = 1, text_color=color.new(this.properties.plotColor, transparency), bgcolor = bgColor,
									 text_size = this.properties.plotSize, tooltip=tooltip)

	this


// @function Draw quadrant summary
// @param this Graph object
// @returns current Graph object
export method paintQuadrantSummary(Graph this)=>
    quadrantPositions = array.from(position.top_right, position.top_left, position.bottom_left, position.bottom_right)
    for [i, quadrant] in this.quadrants
        position = quadrantPositions.get(i)
        t = table.new(position, 1, 1, this.properties.summaryBgColor, force_overlay = true)
        table.cell(t, 0, 0, str.tostring(quadrant.coordinates.size()), text_color = this.properties.summaryTextColor,
			 bgcolor = this.properties.summaryBgColor, text_size=this.properties.summaryTextSize, tooltip='Quadrant '+str.tostring(i+1)+ ' : '+str.tostring(quadrant.coordinates.size()))
	this