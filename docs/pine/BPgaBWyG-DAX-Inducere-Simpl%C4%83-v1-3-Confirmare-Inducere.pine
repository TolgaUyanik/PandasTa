//@version=6
indicator("DAX Inducere Simplă v1.3 – Confirmare Inducere", overlay=true)

// === TIME WINDOW (London session)
inSession = hour(time, "Europe/London") >= 8 and hour(time, "Europe/London") < 17

// === ASIA RANGE CALCULAT PRIN SECURITY (stabil)
asiaHigh = request.security(syminfo.tickerid, "15", ta.highest(high, 36), lookahead=barmerge.lookahead_on)
asiaLow  = request.security(syminfo.tickerid, "15", ta.lowest(low, 36),  lookahead=barmerge.lookahead_on)

// === INDUCERE VALIDĂ
inducereBuy  = inSession and low  < asiaLow
inducereSell = inSession and high > asiaHigh

// === SEMNALE VIZUALE
plotshape(inducereBuy, title="BUY", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(inducereSell, title="SELL", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")

plot(asiaHigh, title="Asia High", color=color.fuchsia, linewidth=1)
plot(asiaLow,  title="Asia Low",  color=color.teal, linewidth=1)

// === LINIE VERTICALĂ LA INDUCERE
plot(inducereBuy or inducereSell ? high + 100 : na, title="Inducere Marker", color=color.orange, style=plot.style_columns, linewidth=1)
