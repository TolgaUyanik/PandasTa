//@version=6
strategy("RFS-4.4", "RFS-4.4", overlay=true, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.05, pyramiding=2, margin_long=0, margin_short=0, max_lines_count=100)

// ════════════════ INPUTS ════════════════
riskUSD = input.float(100.0, "Max loss per trade ($)", minval=1, step=10)
minTPr  = input.float(0.1, "Min TP distance (R) — token guard", minval=0.0, step=0.05)
swLen   = input.int(5, "Swing low — strength (bars each side)", minval=2)
phLen   = input.int(3, "Range high — swing strength (bars each side)", minval=2)
mhLen   = input.int(10, "Major high — swing strength (bars each side)", minval=5, tooltip="LAUNCHPADS: when price breaks above the last confirmed major high, the most recent swing low before that breakout is recorded as a launchpad — the TP species.")
rMult   = input.float(3.0, "R multiple (TP fallback if no launchpad below)", minval=0.5, step=0.25)
maxBars = input.int(300, "Setup / bridge expires after (bars)", minval=20)
showLv  = input.bool(true, "Plot levels")
showSig = input.bool(true, "Mark events (KL / RC / LP)")

// ════════ structure tracking ════════
phv = ta.pivothigh(high, phLen, phLen)
var float lastPH = na
if not na(phv)
    lastPH := phv

mhv = ta.pivothigh(high, mhLen, mhLen)
var float lastMH    = na     // invalidation anchor
var float bosLevel  = na     // the standing major high price must BREAK
var bool  bosArmed  = false

// raw latest swing low — the launchpad candidate at breakout time
slv = ta.pivotlow(low, swLen, swLen)
var float lastRawSL = na
if not na(slv)
    lastRawSL := slv

// ════════ LAUNCHPAD REGISTRY · drawn live on the chart, purged once swept ════════
var pool   = array.new_float()
var poolLn = array.new<line>()

f_addPool(float v) =>
    if not na(v)
        bool dup = false
        if array.size(pool) > 0
            for i = 0 to array.size(pool) - 1
                if math.abs(array.get(pool, i) - v) <= syminfo.mintick
                    dup := true
        if not dup
            array.push(pool, v)
            array.push(poolLn, line.new(bar_index, v, bar_index + 1, v, extend=extend.right, color=color.new(color.green, 45), width=1))
            if array.size(pool) > 40
                line.delete(array.get(poolLn, 0))
                array.shift(pool)
                array.shift(poolLn)

bool lpSig = false

// major high confirms → it becomes the BOS level to beat
if not na(mhv)
    lastMH   := mhv
    bosLevel := mhv
    bosArmed := true

// BREAK OF STRUCTURE: price exceeds the standing major high → the last swing low = LAUNCHPAD
if bosArmed and not na(bosLevel) and high > bosLevel
    f_addPool(lastRawSL)
    lpSig    := true
    bosArmed := false                       // one launchpad per break

// PURGE: a swept launchpad's liquidity is spent — line removed, level gone forever
if array.size(pool) > 0
    for i = array.size(pool) - 1 to 0
        if low < array.get(pool, i)
            line.delete(array.get(poolLn, i))
            array.remove(pool, i)
            array.remove(poolLn, i)

// ════════ candidate → validated WATCHED swing low (ENTRY machinery) ════════
var float candSL    = na
var float candRef   = na
var float candHi    = na
var float lastSL    = na
var int   lastSLBar = na
var float usedSL    = na
var float runHi     = na

if not na(slv)
    candSL  := slv
    candRef := lastPH[swLen]
    candHi  := ta.highest(high, swLen + 1)
else if not na(candSL)
    candHi := math.max(candHi, high)

if not na(candSL) and (na(candRef) or high >= candRef)
    lastSL    := candSL
    lastSLBar := bar_index
    runHi     := candHi
    candSL    := na
    candRef   := na
    candHi    := na

if not na(lastSL) and not na(runHi)
    runHi := math.max(runHi, high)

// TP = nearest UNSWEPT LAUNCHPAD below entry · fallback = R-multiple
f_target(float entry, float sl) =>
    float risk   = math.max(sl - entry, syminfo.mintick)
    float ceilLv = entry - minTPr * risk
    float t = na
    if array.size(pool) > 0
        for i = 0 to array.size(pool) - 1
            v = array.get(pool, i)
            if v <= ceilLv and (na(t) or v > t)
                t := v
    if na(t)
        t := entry - rMult * risk
    t

f_qty(float slLevel, float entryLevel) =>
    riskUSD / math.max(slLevel - entryLevel, syminfo.mintick)

f_invalidation(float localHi) =>
    na(lastMH) ? localHi : math.max(localHi, lastMH)

f_isOpen(string id) =>
    bool f = false
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == id
                f := true
    f

f_filled(string id, int fromClosed) =>
    bool f = f_isOpen(id)
    if not f and strategy.closedtrades > fromClosed
        for j = fromClosed to strategy.closedtrades - 1
            if strategy.closedtrades.entry_id(j) == id
                f := true
    f

// ════════ LIVE TRADE TRACKER · TP may only TIGHTEN, never loosen ════════
var tId    = array.new_int()
var tStop  = array.new_float()
var tEntry = array.new_float()
var tTp    = array.new_float()

if array.size(tId) > 0
    for i = array.size(tId) - 1 to 0
        string id = "S" + str.tostring(array.get(tId, i))
        if f_isOpen(id)
            float e    = array.get(tEntry, i)
            float s    = array.get(tStop, i)
            float cand = f_target(e, s)
            if cand > array.get(tTp, i)
                array.set(tTp, i, cand)
            strategy.exit("X" + str.tostring(array.get(tId, i)), id, stop=s, limit=array.get(tTp, i))
        else
            array.remove(tId, i)
            array.remove(tStop, i)
            array.remove(tEntry, i)
            array.remove(tTp, i)

// ════════════════ STATE ════════════════
var int   state       = 0
var float keyLow      = na
var float rangeTop    = na
var float rangeBot    = na
var float priorHi     = na
var float rallyHi     = na
var int   startBar    = na
var int   bornBar     = na
var float tpLevel     = na
var int   setupN      = 0
var int   armedClosed = 0

// ─── the single BRIDGE ───
var bool  brdOn    = false
var int   brdN     = na
var float brdHi    = na
var int   brdStart = na
var float brdStop  = na
var float brdEntry = na

if brdOn
    if f_filled("S" + str.tostring(brdN), 0)
        array.push(tId, brdN)
        array.push(tStop, brdStop)
        array.push(tEntry, brdEntry)
        array.push(tTp, f_target(brdEntry, brdStop))
        brdOn := false
    else if high > brdHi or bar_index - brdStart > maxBars
        strategy.cancel("S" + str.tostring(brdN))
        brdOn := false

bool klSig = false
bool rcSig = false

// ─── REBIRTH · fresh validated sweep → new setup; old armed order becomes the BRIDGE ───
bool freshSweep = (state == 1 or state == 2) and not na(lastSL) and (na(usedSL) or lastSL != usedSL) and not na(lastSLBar) and not na(bornBar) and lastSLBar > bornBar and low < lastSL

if freshSweep
    if state == 2 and not brdOn
        brdOn    := true
        brdN     := setupN
        brdHi    := priorHi
        brdStart := startBar
        brdStop  := rallyHi
        brdEntry := keyLow
    else if state == 2 and brdOn
        strategy.cancel("S" + str.tostring(setupN))
    state    := 1
    keyLow   := low
    rangeTop := na(lastPH) ? rangeTop : lastPH
    rangeBot := lastSL
    priorHi  := f_invalidation(runHi)
    usedSL   := lastSL
    bornBar  := bar_index
    startBar := bar_index
    klSig    := true

// ─── STATE 0 · sweep of the watched (validated) swing low → KEY LOW born ───
else if state == 0 and not na(lastSL) and (na(usedSL) or lastSL != usedSL) and low < lastSL
    state    := 1
    keyLow   := low
    rangeTop := na(lastPH) ? ta.highest(high, 12)[1] : lastPH
    rangeBot := lastSL
    priorHi  := f_invalidation(runHi)
    usedSL   := lastSL
    bornBar  := bar_index
    startBar := bar_index
    klSig    := true

// ─── STATE 1 · key low deepens → range re-anchors · RECLAIM = touch of the range top ───
else if state == 1
    if low < keyLow
        keyLow   := low
        rangeTop := na(lastPH) ? rangeTop : lastPH
        startBar := bar_index
    if high >= rangeTop
        if brdOn
            strategy.cancel("S" + str.tostring(brdN))
            brdOn := false
        state       := 2
        rallyHi     := high
        setupN      += 1
        armedClosed := strategy.closedtrades
        rcSig       := true
        strategy.entry("S" + str.tostring(setupN), strategy.short, qty=f_qty(rallyHi, keyLow), stop=keyLow)
        strategy.exit("X" + str.tostring(setupN), "S" + str.tostring(setupN), stop=rallyHi, limit=f_target(keyLow, rallyHi))
    else if bar_index - startBar > maxBars
        state := 0

// ─── STATE 2 · order resting · fill → hand the trade to the live tracker ───
else if state == 2
    if f_filled("S" + str.tostring(setupN), armedClosed)
        array.push(tId, setupN)
        array.push(tStop, rallyHi)
        array.push(tEntry, keyLow)
        array.push(tTp, f_target(keyLow, rallyHi))
        state := 0
    else
        rallyHi := math.max(rallyHi, high)
        tpLevel := f_target(keyLow, rallyHi)
        strategy.entry("S" + str.tostring(setupN), strategy.short, qty=f_qty(rallyHi, keyLow), stop=keyLow)
        strategy.exit("X" + str.tostring(setupN), "S" + str.tostring(setupN), stop=rallyHi, limit=tpLevel)
        if high > priorHi
            strategy.cancel("S" + str.tostring(setupN))
            state := 0
        else if bar_index - startBar > maxBars
            strategy.cancel("S" + str.tostring(setupN))
            state := 0

// ════════════════ VISUALS ════════════════
plot(showLv and state == 0 ? lastSL : na, "Watching Key Low", color.new(color.gray, 55), 1, plot.style_linebr)
plot(showLv and state == 0 ? candSL : na, "Candidate (awaiting validation)", color.new(color.gray, 82), 1, plot.style_linebr)
plot(showLv and state >= 1 ? keyLow : na, "Key Low", color.red, 1, plot.style_linebr)
plot(showLv and state >= 1 ? rangeTop : na, "Range Top", color.blue, 1, plot.style_linebr)
plot(showLv and state >= 1 ? rangeBot : na, "Range Bottom (swept low)", color.new(color.blue, 55), 1, plot.style_linebr)
plot(showLv and state >= 1 ? priorHi : na, "Invalidation (previous major high)", color.new(color.purple, 60), 1, plot.style_linebr)
plot(showLv and brdOn ? brdHi : na, "Bridge invalidation", color.new(color.teal, 50), 1, plot.style_linebr, display=display.none)
plot(showLv and state == 2 ? rallyHi : na, "Stop (rally high)", color.orange, 1, plot.style_linebr)
plot(showLv and state == 2 ? tpLevel : na, "Target (launchpad)", color.new(color.green, 0), 1, plot.style_linebr, display=display.none)
plotshape(showSig and klSig, "Key Low born", shape.diamond, location.belowbar, color.red, text="KL", textcolor=color.red, size=size.tiny)
plotshape(showSig and rcSig, "Reclaim", shape.triangleup, location.abovebar, color.blue, text="RC", textcolor=color.blue, size=size.tiny)
plotshape(showSig and lpSig, "Launchpad recorded", shape.labelup, location.belowbar, color.new(color.green, 20), text="LP", textcolor=color.white, size=size.tiny, display=display.none)
plotshape(showSig and freshSweep and state == 2, "Bridge created", shape.square, location.belowbar, color.teal, text="BRG", textcolor=color.teal, size=size.tiny, display=display.none)
bgcolor(state == 1 ? color.new(color.orange, 92) : state == 2 ? color.new(color.blue, 90) : na, display=display.none)
bgcolor(brdOn ? color.new(color.teal, 94) : na, display=display.none)
