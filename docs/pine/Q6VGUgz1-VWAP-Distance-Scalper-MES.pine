//@version=6
strategy("VWAP % Distance Scalper [MES]", overlay = true, calc_on_every_tick = false, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 2)

vwapSrc = input.source(hlc3, "VWAP Source")
bbLen = input.int(20, "Band Length")
mult1 = input.float(1.0, "Band 1 StdDev Mult")
mult2 = input.float(2.0, "Band 2 StdDev Mult")
mult3 = input.float(3.0, "Band 3 StdDev Mult")
stopLookback = input.int(5, "Stop Lookback (bars)")
sessMode = input.string("RTH", "Trading Session", options = ["RTH", "ETH"])
targetSel = input.string("Band 1", "Profit Target", options = ["Band 1", "Band 2", "Band 3", "VWAP"])
expandBars = input.int(3, "Bands Wider Than Max Of Prior X Bars", minval = 1)
useExpansion = input.bool(true, "Use Expansion Filter")
trendTF = input.timeframe("D", "Trend Timeframe")
trendLen = input.int(20, "Trend EMA Length")
beTrigger = input.float(30, "Breakeven Trigger ($/contract)", minval = 0)
enableLongs = input.bool(true, "Enable Long Entries")
enableShorts = input.bool(true, "Enable Short Entries")
allow2nd = input.bool(true, "Allow 2nd Contract (pyramid)")
showStop = input.bool(true, "Show Stop Line")
showTradeLine = input.bool(true, "Show Entry-to-Exit Line")
tradeLineWidth = input.int(2, "Trade Line Width", minval = 1)
tradeWinColor = input.color(color.green, "Trade Line Color (win)")
tradeLossColor = input.color(color.red, "Trade Line Color (loss)")

pointValue = 5.0

rthSession = "0930-1600"
ethSession = "1800-1700"
sessSpec = sessMode == "RTH" ? rthSession : ethSession
inSession = not na(time(timeframe.period, sessSpec, "America/New_York"))

vwapValue = ta.vwap(vwapSrc)
pctDist = (close - vwapValue) / vwapValue * 100

sd = ta.stdev(pctDist, bbLen)
u1 = sd * mult1
u2 = sd * mult2
u3 = sd * mult3

priceU1 = vwapValue * (1 + u1 / 100)
priceL1 = vwapValue * (1 - u1 / 100)
priceU2 = vwapValue * (1 + u2 / 100)
priceL2 = vwapValue * (1 - u2 / 100)
priceU3 = vwapValue * (1 + u3 / 100)
priceL3 = vwapValue * (1 - u3 / 100)

longTarget = targetSel == "Band 1" ? priceL1 : targetSel == "Band 2" ? priceL2 : targetSel == "Band 3" ? priceL3 : vwapValue
shortTarget = targetSel == "Band 1" ? priceU1 : targetSel == "Band 2" ? priceU2 : targetSel == "Band 3" ? priceU3 : vwapValue

trendEMA = request.security(syminfo.tickerid, trendTF, ta.ema(close, trendLen)[1], lookahead = barmerge.lookahead_off)
uptrend = close > trendEMA
downtrend = close < trendEMA

expanding = useExpansion ? sd > ta.highest(sd[1], expandBars) : true

longTrigger = pctDist[1] < -u3[1] and pctDist >= -u3
shortTrigger = pctDist[1] > u3[1] and pctDist <= u3

flat = strategy.position_size == 0

if flat and longTrigger and inSession and expanding and uptrend and enableLongs
    strategy.entry("Long", strategy.long)

if flat and shortTrigger and inSession and expanding and downtrend and enableShorts
    strategy.entry("Short", strategy.short)

if allow2nd and strategy.position_size > 0 and longTrigger and inSession and expanding and uptrend and enableLongs and close < strategy.position_avg_price
    strategy.entry("Long2", strategy.long)

var float stopPrice = na
beOffset = beTrigger / pointValue

if strategy.position_size > 0
    if na(stopPrice) or bar_index == strategy.opentrades.entry_bar_index(0)
        stopPrice := ta.lowest(low, stopLookback)
    else if high - strategy.position_avg_price >= beOffset
        stopPrice := math.max(stopPrice, strategy.position_avg_price)
    strategy.exit("Long Exit", stop = stopPrice, limit = longTarget)

if strategy.position_size < 0
    if na(stopPrice) or bar_index == strategy.opentrades.entry_bar_index(0)
        stopPrice := ta.highest(high, stopLookback)
    else if strategy.position_avg_price - low >= beOffset
        stopPrice := math.min(stopPrice, strategy.position_avg_price)
    strategy.exit("Short Exit", stop = stopPrice, limit = shortTarget)

if flat
    stopPrice := na

var int entryBar = na
var float entryPx = na

justEntered = strategy.position_size != 0 and strategy.position_size[1] == 0
justExited = strategy.position_size == 0 and strategy.position_size[1] != 0

if justEntered
    entryBar := bar_index
    entryPx := strategy.position_avg_price

if showTradeLine and justExited and not na(entryBar)
    lineCol = close >= entryPx ? tradeWinColor : tradeLossColor
    line.new(entryBar, entryPx, bar_index, close, color = lineCol, width = tradeLineWidth)

stopPlot = showStop ? stopPrice : na

plot(vwapValue, "VWAP", color = color.new(color.blue, 0))
plot(priceU1, "Upper 1", color = color.new(color.gray, 50))
plot(priceL1, "Lower 1", color = color.new(color.gray, 50))
plot(priceU2, "Upper 2", color = color.new(color.gray, 65))
plot(priceL2, "Lower 2", color = color.new(color.gray, 65))
plot(priceU3, "Upper 3", color = color.new(color.gray, 75))
plot(priceL3, "Lower 3", color = color.new(color.gray, 75))
plot(trendEMA, "Trend EMA", color = color.new(color.orange, 0), linewidth = 2)
plot(stopPlot, "Stop", color = color.new(color.red, 0), style = plot.style_circles, linewidth = 2)
bgcolor(inSession ? na : color.new(color.gray, 92), title = "Out-of-Session Shading")