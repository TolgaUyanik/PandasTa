// Type Definitions
type Lines
    line   vline
    line   hline
    label  txt
    int    start_time
    float  line_price
    int    end_time

type htf_hl
    line[] hi_line
    line[] lo_line
    label[] hi_label
    label[] lo_label

type htf_info
    string tf
    float o = na
    float h = na
    float l = na
    float ph = na
    float pl = na

// Variables & Constants
var htf1_hl = htf_hl.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())
var htf2_hl = htf_hl.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())
var htf3_hl = htf_hl.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())
var htf4_hl = htf_hl.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())
var htf5_hl = htf_hl.new(array.new_line(), array.new_line(), array.new_label(), array.new_label())

var htf1_info = htf_info.new(htf1_tf)
var htf2_info = htf_info.new(htf2_tf)
var htf3_info = htf_info.new(htf3_tf)
var htf4_info = htf_info.new(htf4_tf)
var htf5_info = htf_info.new(htf5_tf)

var htf1_sep_line = array.new_line()
var htf2_sep_line = array.new_line()
var htf3_sep_line = array.new_line()
var htf4_sep_line = array.new_line()
var htf5_sep_line = array.new_line()

var htf1_line = array.new_line()
var htf2_line = array.new_line()
var htf3_line = array.new_line()
var htf4_line = array.new_line()
var htf5_line = array.new_line()

var htf1_label = array.new_label()
var htf2_label = array.new_label()
var htf3_label = array.new_label()
var htf4_label = array.new_label()
var htf5_label = array.new_label()

// Helper Methods
method manage_lines(array<Lines> lines) =>
    current_ny_time = time(timeframe.period, "America/New_York")
    extension = timeframe.in_seconds(timeframe.period) * 1000 * hline_extend
    
    if lines.size() > 0
        for i = lines.size() - 1 to 0
            l = lines.get(i)
            if current_ny_time <= l.end_time
                line.set_x2(l.hline, math.min(current_ny_time + extension, l.end_time))
                label.set_x(l.txt, math.min(current_ny_time + extension, l.end_time))

        if lines.size() > h_sessions + 1
            l = lines.shift()
            line.delete(l.hline)
            line.delete(l.vline)
            label.delete(l.txt)

get_offset_time() =>
    time + line_offset * timeframe.in_seconds("") * 1000

update_htf_info(htf_info n) =>
    if timeframe.change(n.tf)
        n.ph := n.h
        n.pl := n.l
        n.o := open
        n.h := high
        n.l := low
    else
        n.h := math.max(high, n.h)
        n.l := math.min(low,  n.l)

// Modified plotting function to use session-based cutoff times
plot_lines(session, cond, o, c, w, s, txt = "") =>
    [startH, startM, endH, endM] = getSessionTimes(session)
    
    end   = (endH * 60) + endM
    start = (startH * 60) + startM
    duration = end >= start ? end - start : (24 * 60) - start + end

    notPlot = (duration <= 180 and timeframe.in_seconds(timeframe.period) >= 3600) or
              (duration <= 90 and timeframe.in_seconds(timeframe.period) >= 1800 ) or
              (duration <= 45 and timeframe.in_seconds(timeframe.period) >= 900  )

    var lines = array.new<Lines>()
    current_ny_time = time(timeframe.period, "America/New_York")
    
    current_hour = hour(current_ny_time, "America/New_York")
    current_minute = minute(current_ny_time, "America/New_York")
    current_second = second(current_ny_time, "America/New_York")
    
    time_match = (current_hour == startH and current_minute == startM and current_second == 0)
    
    if time_match and cond
        future_time = current_ny_time + (60000 * hline_extend)
        
        // Calculate end time based on session input
        end_time = timestamp("America/New_York", year(current_ny_time, "America/New_York"), month(current_ny_time, "America/New_York"), dayofmonth(current_ny_time, "America/New_York"), endH, endM, 0)
        if end_time <= current_ny_time
            end_time := timestamp("America/New_York", year(current_ny_time + 86400000, "America/New_York"), month(current_ny_time + 86400000, "America/New_York"), dayofmonth(current_ny_time + 86400000, "America/New_York"), endH, endM, 0)

        lines.push(
         Lines.new(
          o != "Opening Price" ? line.new(current_ny_time, high, current_ny_time, low, xloc.bar_time, extend.both, c, getType(vLine_type), vLine_width) : na,
          o != "Vertical Line" and not notPlot? 
           line.new(current_ny_time, open, future_time, open, xloc.bar_time, extend.none, c, s, w) : na,
          o != "Vertical Line" and not notPlot and useText ?
           label.new(future_time, open, txt, xloc.bar_time, yloc.price, textcolor = text_color, textalign = text.align_left, style = label.style_label_left, size = getSize(text_size), color = color.new(color.white, 100), text_font_family = getFont(text_font)) : na,
          current_ny_time,
          open,
          end_time
         )
         ) 
    lines.manage_lines()

htf_sep(string tf, string type, line[] arr, color col) =>
    if type == "Vertical Line" or type == "Both"
        if timeframe.change(tf)
            arr.unshift(line.new(bar_index, high*1.0001, bar_index, low, style = htf_vertical_style, width = htf_vertical_width, extend = extend.both, color = col))
            if arr.size() > max_days + 1
                arr.pop().delete()

htf_open(string tf, bool use, string type, line[] lns, label[] lbls, htf_info n, color col, string label_text) =>
    if use and (type == "Opening Price" or type == "Both")
        if lns.size() > 0
            lns.get(0).set_x2(get_offset_time())
            if htf_useText and lbls.size() > 0
                lbls.get(0).set_x(get_offset_time())
        
        if timeframe.change(tf)
            if lns.size() > 0
                lns.get(0).set_x2(time)
                if htf_useText and lbls.size() > 0
                    lbls.get(0).set_x(time)
            
            lns.unshift(line.new(time, n.o, get_offset_time(), n.o, xloc = xloc.bar_time, style = htf_style, width = htf_width, color = col))
            if htf_useText
                lbls.unshift(label.new(get_offset_time(), n.o, label_text, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = txt_color, size = lbl_size, text_font_family = txt_font))
            if lns.size() > max_days + 1
                lns.pop().delete()
                if htf_useText and lbls.size() > max_days + 1
                    lbls.pop().delete()

htf_hl_func(string tf, bool use, htf_hl hl, htf_info n, color col, string high_label, string low_label) =>
    if use
        if hl.hi_line.size() > 0
            hl.hi_line.get(0).set_x2(get_offset_time())
            hl.lo_line.get(0).set_x2(get_offset_time())
            if htf_useText
                if hl.hi_label.size() > 0
                    hl.hi_label.get(0).set_x(get_offset_time())
                if hl.lo_label.size() > 0
                    hl.lo_label.get(0).set_x(get_offset_time())
        
        if timeframe.change(tf)
            if hl.hi_line.size() > 0
                hl.hi_line.get(0).set_x2(time)
                hl.lo_line.get(0).set_x2(time)
                if htf_useText
                    if hl.hi_label.size() > 0
                        hl.hi_label.get(0).set_x(time)
                    if hl.lo_label.size() > 0
                        hl.lo_label.get(0).set_x(time)
            
            hl.hi_line.unshift(line.new(time, n.ph, get_offset_time(), n.ph, xloc = xloc.bar_time, style = htf_style, width = htf_width, color = col))
            hl.lo_line.unshift(line.new(time, n.pl, get_offset_time(), n.pl, xloc = xloc.bar_time, style = htf_style, width = htf_width, color = col))
            if htf_useText
                hl.hi_label.unshift(label.new(get_offset_time(), n.ph, high_label, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = txt_color, size = lbl_size, text_font_family = txt_font))
                hl.lo_label.unshift(label.new(get_offset_time(), n.pl, low_label, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = txt_color, size = lbl_size, text_font_family = txt_font))
            if hl.hi_line.size() > max_days + 1
                hl.hi_line.pop().delete()
                hl.lo_line.pop().delete()
                if htf_useText
                    if hl.hi_label.size() > max_days + 1
                        hl.hi_label.pop().delete()
                    if hl.lo_label.size() > max_days + 1
                        hl.lo_label.pop().delete()

htf_levels() =>
    if show_htf1_open
        htf_sep(htf1_tf, htf1_type, htf1_sep_line, htf1_color)
        htf_open(htf1_tf, true, htf1_type, htf1_line, htf1_label, htf1_info, htf1_color, htf1_open_lbl)
    
    if show_htf2_open
        htf_sep(htf2_tf, htf2_type, htf2_sep_line, htf2_color)
        htf_open(htf2_tf, true, htf2_type, htf2_line, htf2_label, htf2_info, htf2_color, htf2_open_lbl)
    
    if show_htf3_open
        htf_sep(htf3_tf, htf3_type, htf3_sep_line, htf3_color)
        htf_open(htf3_tf, true, htf3_type, htf3_line, htf3_label, htf3_info, htf3_color, htf3_open_lbl)
    
    if show_htf4_open
        htf_sep(htf4_tf, htf4_type, htf4_sep_line, htf4_color)
        htf_open(htf4_tf, true, htf4_type, htf4_line, htf4_label, htf4_info, htf4_color, htf4_open_lbl)
    
    if show_htf5_open
        htf_sep(htf5_tf, htf5_type, htf5_sep_line, htf5_color)
        htf_open(htf5_tf, true, htf5_type, htf5_line, htf5_label, htf5_info, htf5_color, htf5_open_lbl)
    
    htf_hl_func(htf1_tf, show_htf1_hl, htf1_hl, htf1_info, htf1_color, htf1_high_lbl, htf1_low_lbl)
    htf_hl_func(htf2_tf, show_htf2_hl, htf2_hl, htf2_info, htf2_color, htf2_high_lbl, htf2_low_lbl)
    htf_hl_func(htf3_tf, show_htf3_hl, htf3_hl, htf3_info, htf3_color, htf3_high_lbl, htf3_low_lbl)
    htf_hl_func(htf4_tf, show_htf4_hl, htf4_hl, htf4_info, htf4_color, htf4_high_lbl, htf4_low_lbl)
    htf_hl_func(htf5_tf, show_htf5_hl, htf5_hl, htf5_info, htf5_color, htf5_high_lbl, htf5_low_lbl)

// HTF Info Updates
if show_htf1_open or show_htf1_hl
    update_htf_info(htf1_info)
if show_htf2_open or show_htf2_hl
    update_htf_info(htf2_info)
if show_htf3_open or show_htf3_hl
    update_htf_info(htf3_info)
if show_htf4_open or show_htf4_hl
    update_htf_info(htf4_info)
if show_htf5_open or show_htf5_hl
    update_htf_info(htf5_info)

// Custom Times Execution
