// Ufonose

//@version=6
indicator("Custom Opening Times", shorttitle = "Opening Times", overlay = true, max_labels_count = 500, max_lines_count = 500, max_bars_back = 5000)

// Functions (Line Style, Text Size, Text Font)
getType(type_) =>
    switch type_
        "Solid"     => line.style_solid
        "Dashed"    => line.style_dashed
        "Dotted"    => line.style_dotted

getSize(size) =>
    switch size
        "Tiny"      => size.tiny
        "Small"     => size.small
        "Normal"    => size.normal
        "Large"     => size.large
        "Huge"      => size.huge

getFont(font) =>
    switch font
        "Default"   => font.family_default
        "Monospace" => font.family_monospace

// Helper function to extract start and end times from session string
getSessionTimes(session) =>
    sessionStr = str.tostring(session)
    dashPos = str.pos(sessionStr, "-")
    
    if dashPos > 0
        startTimeStr = str.substring(sessionStr, 0, dashPos)
        endTimeStr = str.substring(sessionStr, dashPos + 1)
        
        // Parse start time
        startHour = int(str.tonumber(str.substring(startTimeStr, 0, 2)))
        startMinute = int(str.tonumber(str.substring(startTimeStr, 2, 4)))
        
        // Parse end time
        endHour = int(str.tonumber(str.substring(endTimeStr, 0, 2)))
        endMinute = int(str.tonumber(str.substring(endTimeStr, 2, 4)))
        
        [startHour, startMinute, endHour, endMinute]
    else
        // Fallback if no dash found
        startHour = int(str.tonumber(str.substring(sessionStr, 0, 2)))
        startMinute = int(str.tonumber(str.substring(sessionStr, 2, 4)))
        [startHour, startMinute, 23, 59] // Default end time

// Helper function to extract hour and minute from session string
getHourMinute(session) =>
    [startH, startM, endH, endM] = getSessionTimes(session)
    [startH, startM]

// Global Custom Time Settings
