//@version=6
indicator("NDX Levels Adjusted to Active Ticker", overlay=true)

// === NDX is the reference ("source of truth") ===
spx_price = request.security("NDX", "1", close)

// Detect current chart symbol
ticker = syminfo.ticker

// Do nothing if the current chart is NDX itself
is_ndx = ticker == "NDX"

// Do nothing if the current chart is not related to the NDX
is_valid_ticker = str.startswith(ticker, "NQ1") or ticker == "QQQ" or ticker == "NAS100" or ticker == "NAS100USD"

run = is_valid_ticker and not is_ndx

price = close

// Calculate spread between SPX and current symbol
spread = run ? (spx_price - price) : na

// === SPX levels to track (input by user) ===
spx_level_1 = input.float(23000, "NDX Level 1")
spx_level_2 = input.float(24000, "NDX Level 2")
spx_level_3 = input.float(25000, "NDX Level 3")

// Adjust levels to current chart symbol using the spread
adjusted_1 = run ? spx_level_1 - spread : na
adjusted_2 = run ? spx_level_2 - spread : na
adjusted_3 = run ? spx_level_3 - spread : na

// Plot the spread in the chart's status line
plot(run ? spread : na, title="NDX - Current Ticker Spread", color=color.orange, linewidth=1, display=display.status_line)
// === Draw horizontal lines and their corresponding labels ===
var line line1 = na
var line line2 = na
var line line3 = na

var label label1 = na
var label label2 = na
var label label3 = na

if run and bar_index > 1
    // Line 1 and label
    if na(line1)
        line1 := line.new(x1=bar_index, y1=adjusted_1, x2=bar_index + 1, y2=adjusted_1, color=color.green, extend=extend.right, width=1)
        label1 := label.new(x=bar_index + 5, y=adjusted_1, text="NDX Level " + str.tostring(spx_level_1), style=label.style_label_left, size=size.small, textcolor=color.white, color=color.green)
    else
        line.set_y1(line1, adjusted_1)
        line.set_y2(line1, adjusted_1)
        label.set_y(label1, adjusted_1)
        label.set_text(label1, "NDX Level " + str.tostring(spx_level_1))
        label.set_x(label1, bar_index + 5)

    // Line 2 and label
    if na(line2)
        line2 := line.new(x1=bar_index, y1=adjusted_2, x2=bar_index + 1, y2=adjusted_2, color=color.blue, extend=extend.right, width=1)
        label2 := label.new(x=bar_index + 5, y=adjusted_2, text="NDX Level " + str.tostring(spx_level_2), style=label.style_label_left, size=size.small, textcolor=color.white, color=color.blue)
    else
        line.set_y1(line2, adjusted_2)
        line.set_y2(line2, adjusted_2)
        label.set_y(label2, adjusted_2)
        label.set_text(label2, "NDX Level " + str.tostring(spx_level_2))
        label.set_x(label2, bar_index + 5)

    // Line 3 and label
    if na(line3)
        line3 := line.new(x1=bar_index, y1=adjusted_3, x2=bar_index + 1, y2=adjusted_3, color=color.red, extend=extend.right, width=1)
        label3 := label.new(x=bar_index + 5, y=adjusted_3, text="NDX Level " + str.tostring(spx_level_3), style=label.style_label_left, size=size.small, textcolor=color.white, color=color.red)
    else
        line.set_y1(line3, adjusted_3)
        line.set_y2(line3, adjusted_3)
        label.set_y(label3, adjusted_3)
        label.set_text(label3, "NDX Level " + str.tostring(spx_level_3))
        label.set_x(label3, bar_index + 5)

    // Spread info label every 50 bars
    if bar_index % 50 == 0
        label.new(bar_index, high, text="Spread: " + str.tostring(spread, format.mintick), style=label.style_label_left, size=size.small, color=color.gray, textcolor=color.white)