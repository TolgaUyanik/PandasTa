//@version=6
strategy("9 EMA + 20 EMA Retest Strategy", overlay=true, initial_capital=100000)

// ======================================================
// INPUTS
// ======================================================

emaFastLength = input.int(9, title="9 EMA")
emaSlowLength = input.int(20, title="20 EMA")

rr = input.float(3.0, title="Risk Reward Ratio", step=0.1)

// ======================================================
// EMA CALCULATION
// ======================================================

ema9 = ta.ema(close, emaFastLength)
ema20 = ta.ema(close, emaSlowLength)

// ======================================================
// PLOT EMAs
// ======================================================

plot(ema9, color=color.blue, linewidth=2, title="9 EMA")
plot(ema20, color=color.red, linewidth=2, title="20 EMA")

// ======================================================
// TIME FILTER (9 AM to 4 PM IST)
// ======================================================

sessionTime = input.session("0900-1600", title="Trading Session")
inSession = not na(time(timeframe.period, sessionTime, "Asia/Kolkata"))

// ======================================================
// TREND CONDITIONS
// ======================================================

// Buy Trend
bullTrend = ema9 > ema20

// Sell Trend
bearTrend = ema20 > ema9

// ======================================================
// CROSSOVER CONDITIONS
// ======================================================

bullCross = ta.crossover(ema9, ema20)
bearCross = ta.crossover(ema20, ema9)

// Store crossover state
var bool allowBuy = false
var bool allowSell = false

if bullCross
    allowBuy := true
    allowSell := false

if bearCross
    allowSell := true
    allowBuy := false

// ======================================================
// RETEST CONDITIONS
// ======================================================

// Candle touches EMA zone
buyRetest =
     low <= ema9 or low <= ema20

sellRetest =
     high >= ema9 or high >= ema20

// Confirmation candles
bullishCandle = close > open
bearishCandle = close < open

// ======================================================
// BUY ENTRY
// ======================================================

buyCondition =
     allowBuy and
     bullTrend and
     buyRetest and
     bullishCandle and
     inSession

// ======================================================
// SELL ENTRY
// ======================================================

sellCondition =
     allowSell and
     bearTrend and
     sellRetest and
     bearishCandle and
     inSession

// ======================================================
// EXECUTION
// ======================================================

// BUY TRADE
if buyCondition and strategy.position_size == 0

    entryPrice = close
    stopLoss = low
    risk = entryPrice - stopLoss
    takeProfit = entryPrice + (risk * rr)

    strategy.entry("BUY", strategy.long)

    strategy.exit(
         "BUY EXIT",
         from_entry = "BUY",
         stop = stopLoss,
         limit = takeProfit
     )

// SELL TRADE
if sellCondition and strategy.position_size == 0

    entryPrice = close
    stopLoss = high
    risk = stopLoss - entryPrice
    takeProfit = entryPrice - (risk * rr)

    strategy.entry("SELL", strategy.short)

    strategy.exit(
         "SELL EXIT",
         from_entry = "SELL",
         stop = stopLoss,
         limit = takeProfit
     )

// ======================================================
// SIGNALS
// ======================================================

plotshape(
     buyCondition,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="BUY"
)

plotshape(
     sellCondition,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL"
)

// ======================================================
// ALERTS
// ======================================================

alertcondition(buyCondition, title="Buy Alert", message="BUY Signal")
alertcondition(sellCondition, title="Sell Alert", message="SELL Signal")