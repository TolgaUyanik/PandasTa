//@version=6
strategy("BTC Averages Strategy - Long & Short", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=99, commission_type=strategy.commission.percent, commission_value=0.05)

// ==========================================
// ⚙️ INPUTS
// ==========================================
fast_len    = input.int(3, "Fast MA Period", minval=1)
slow_len    = input.int(48, "Slow MA Period", minval=1)
trend_len   = input.int(168, "Trend MA Period", minval=1)

// ==========================================
// 📊 CALCULATIONS
// ==========================================
ma_f = ta.sma(close, fast_len)
ma_s = ta.sma(close, slow_len)
ma_t = ta.sma(close, trend_len)

// ==========================================
// 🚀 TRADING RULES
// ==========================================

// LONG: Fast MA > Slow MA AND Price > Trend MA
long_entry  = ma_f > ma_s and close > ma_t
// Exit Long when Fast MA crosses below Slow MA
long_exit   = ma_f < ma_s

// SHORT: Fast MA < Slow MA AND Price < Trend MA
short_entry = ma_f < ma_s and close < ma_t
// Exit Short when Fast MA crosses above Slow MA
short_exit  = ma_f > ma_s

// ==========================================
// 🛡️ EXECUTION
// ==========================================

// Long Execution
if (long_entry)
    strategy.entry("Long", strategy.long, comment="Entry Long")

if (long_exit)
    strategy.close("Long", comment="Exit Long")

// Short Execution
if (short_entry)
    strategy.entry("Short", strategy.short, comment="Entry Short")

if (short_exit)
    strategy.close("Short", comment="Exit Short")

// ==========================================
// 📈 VISUALS
// ==========================================
plot(ma_f, color=color.blue, title="Fast MA")
plot(ma_s, color=color.orange, title="Slow MA")
plot(ma_t, color=color.white, title="Trend MA", linewidth=2)

// Background coloring for Trend
bgcolor(close > ma_t ? color.new(color.green, 90) : color.new(color.red, 90), title="Trend Background")

