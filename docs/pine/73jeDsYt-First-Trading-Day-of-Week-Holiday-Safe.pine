//@version=5
indicator("First Trading Day of Week (Holiday Safe)", overlay=true)

// First trading day of the week happens when the current week != previous week
isNewWeek = weekofyear != weekofyear[1]

if isNewWeek
    line.new(x1=bar_index, y1=low, x2=bar_index, y2=high, extend=extend.both, color=color.orange, width=1)
