//@version=6

// @description Maps a worded string for timeframes useful when working with the input.timeframe settings input. Use like timeframeToString("120") and the output will be "2 hour"
library("TimeframeInputToString")


// @function Converts timeframe strings e.g. "60" will 1 hour
// @returns returns string
export timeframeToString(string timeframeString) =>
	//TODO : add function body and return value here
	varip timeToTextMap = map.new<string, string>()
	timeToTextMap.put("1S", "1s")
	timeToTextMap.put("5S", "5s")
	timeToTextMap.put("15S", "15s")
	timeToTextMap.put("30S", "30s")
	timeToTextMap.put("1", "1 min")
	timeToTextMap.put("2", "2 min")
	timeToTextMap.put("3", "3 min")
	timeToTextMap.put("4", "4 min")
	timeToTextMap.put("5", "5 min")
	timeToTextMap.put("6", "6 min")
	timeToTextMap.put("7", "7 min")
	timeToTextMap.put("8", "8 min")
	timeToTextMap.put("9", "9 min")
	timeToTextMap.put("10", "10 min")
	timeToTextMap.put("15", "15 min")
	timeToTextMap.put("20", "20 min")
	timeToTextMap.put("30", "30 min")
	timeToTextMap.put("45", "45 min")
	timeToTextMap.put("60", "1 hour")
	timeToTextMap.put("120", "2 hour")
	timeToTextMap.put("180", "3 hour")
	timeToTextMap.put("240", "4 hour")
	timeToTextMap.put("300", "5 hour")
	timeToTextMap.put("360", "6 hour")
	timeToTextMap.put("480", "8 hour")
	timeToTextMap.put("540", "9 hour")
	timeToTextMap.put("720", "12 hour")
	timeToTextMap.put("1440", "24 hour")
	timeToTextMap.put("D", "day")
	timeToTextMap.put("2D", "2 day")
	timeToTextMap.put("3D", "3 day")
	timeToTextMap.put("4D", "4 day")
	timeToTextMap.put("12D", "12 day")
	timeToTextMap.put("W", "week")
	timeToTextMap.put("M", "month")
	timeToTextMap.put("3M", "3 month")
	timeToTextMap.put("6M", "6 month")
	timeToTextMap.put("12M", "12 month")
	timeToTextMap.get(timeframeString)

