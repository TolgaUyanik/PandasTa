//@version=6
indicator("Pivot Dots", overlay=true)

// ==========================================
// 1. INPUTS & CONFIGURATION
// ==========================================
leftBars          = input.int(title="Left Bars (Lookback)", defval=4, minval=1, group="Pivot Settings")
dotOffset         = input.float(title="Dot Offset Percentage", defval=0.3, minval=0.0, group="Pivot Settings")

// Structural Zone Settings
zoneBarWindow     = input.int(title="Zone Filter Bar Window", defval=15, minval=2, tooltip="How many historical bars back to check for better peaks/valleys", group="Advanced Cluster Filtering")

fontSizeInput     = input.string(title="Minute Font Size", defval="Small", options=["Tiny", "Small", "Normal", "Large", "Huge"], group="Text Settings")
fontSize = fontSizeInput == "Tiny" ? size.tiny : fontSizeInput == "Small" ? size.small : fontSizeInput == "Normal" ? size.normal : fontSizeInput == "Large" ? size.large : size.huge

// Bottom Table Style Settings
bottomTextColor   = input.color(title="Bottom Text Color", defval=color.white, group="Table Customization")

// ==========================================
// 2. LIVE INSTANT DETECTION & PROCESSING
// ==========================================
atrValue = ta.atr(14)
offsetAmount = atrValue * dotOffset

// Global historical calculations to preserve integrity
highestLeftHigh = ta.highest(high, leftBars)
lowestLeftLow   = ta.lowest(low, leftBars)

// Strict 1-bar confirmation lookback definitions
isHighCandidate = high[1] > high and high[1] > highestLeftHigh[2]
isLowCandidate  = low[1] < low   and low[1]  < lowestLeftLow[2]

// Array declarations for tracking structural history over time
var int[]   pastHighBars   = array.new_int()
var float[] pastHighPrices = array.new_float()
var label[] pastHighLabels = array.new_label()

var int[]   pastLowBars    = array.new_int()
var float[] pastLowPrices  = array.new_float()
var label[] pastLowLabels  = array.new_label()

// --- PERFORMANCE CLEANUP (PRUNING QUEUES OUTSIDE WINDOW) ---
if array.size(pastHighBars) > 0
    while array.size(pastHighBars) > 0 and (bar_index - array.get(pastHighBars, 0)) > zoneBarWindow
        array.shift(pastHighBars)
        array.shift(pastHighPrices)
        array.shift(pastHighLabels)

if array.size(pastLowBars) > 0
    while array.size(pastLowBars) > 0 and (bar_index - array.get(pastLowBars, 0)) > zoneBarWindow
        array.shift(pastLowBars)
        array.shift(pastLowPrices)
        array.shift(pastLowLabels)

// --- ADVANCED STRUCTURAL HIGHS ZONE FILTER ---
isHighPeak = false
if isHighCandidate
    int candidateBar = bar_index - 1
    float candidatePrice = high[1]
    bool isTrueHighestInZone = true
    
    if array.size(pastHighBars) > 0
        for i = array.size(pastHighBars) - 1 to 0
            int oldBar = array.get(pastHighBars, i)
            float oldPrice = array.get(pastHighPrices, i)
            
            if oldPrice >= candidatePrice
                isTrueHighestInZone := false
                break
            else
                label olderLabel = array.get(pastHighLabels, i)
                if not na(olderLabel)
                    label.delete(olderLabel)
    
    if isTrueHighestInZone
        isHighPeak := true
        array.push(pastHighBars, candidateBar)
        array.push(pastHighPrices, candidatePrice)

// --- ADVANCED STRUCTURAL LOWS ZONE FILTER ---
isLowPeak = false
if isLowCandidate
    int candidateBar = bar_index - 1
    float candidatePrice = low[1]
    bool isTrueLowestInZone = true
    
    if array.size(pastLowBars) > 0
        for i = array.size(pastLowBars) - 1 to 0
            int oldBar = array.get(pastLowBars, i)
            float oldPrice = array.get(pastLowPrices, i)
            
            if oldPrice <= candidatePrice
                isTrueLowestInZone := false
                break
            else
                label olderLabel = array.get(pastLowLabels, i)
                if not na(olderLabel)
                    label.delete(olderLabel)
    
    if isTrueLowestInZone
        isLowPeak := true
        array.push(pastLowBars, candidateBar)
        array.push(pastLowPrices, candidatePrice)

// --- EXECUTE LABELS ON CONFIRMED HIGHS ---
if isHighPeak
    labelHighText = str.format("{0,number,00}", minute[1]) + "\n•"
    newLabel = label.new(x=bar_index - 1, y=high[1] + offsetAmount, text=labelHighText, style=label.style_none, textcolor=color.red, textalign=text.align_center, size=fontSize)
    array.push(pastHighLabels, newLabel)

// --- EXECUTE LABELS ON CONFIRMED LOWS ---
if isLowPeak
    labelLowText = "•\n" + str.format("{0,number,00}", minute[1])
    newLabel = label.new(x=bar_index - 1, y=low[1] - offsetAmount, text=labelLowText, style=label.style_none, textcolor=color.green, textalign=text.align_center, size=fontSize)
    array.push(pastLowLabels, newLabel)

// --- REAL-TIME LOOPING INVALIDATION ENGINE ---
if array.size(pastHighPrices) > 0
    for i = array.size(pastHighPrices) - 1 to 0
        if high > array.get(pastHighPrices, i)
            label targetLabel = array.get(pastHighLabels, i)
            if not na(targetLabel)
                label.delete(targetLabel)

if array.size(pastLowPrices) > 0
    for i = array.size(pastLowPrices) - 1 to 0
        if low < array.get(pastLowPrices, i)
            label targetLabel = array.get(pastLowLabels, i)
            if not na(targetLabel)
                label.delete(targetLabel)

// ==========================================
// 3. BOTTOM CENTER DATA SECTION (TRANSPARENT BACKGROUND)
// ==========================================
var table displayTable = table.new(position=position.bottom_center, columns=1, rows=3, border_color=color.new(color.white, 100), border_width=0)

if barstate.islast
    table.cell(displayTable, column=0, row=0, text="ALGO 1 = 00-11-41-03-17-29 = MMXM", text_color=bottomTextColor, text_size=size.normal, text_halign=text.align_center, bgcolor=na)
    table.cell(displayTable, column=0, row=1, text="ALGO 2 = 03-59-17-11-47-29 = TRENDING", text_color=bottomTextColor, text_size=size.normal, text_halign=text.align_center, bgcolor=na)
    table.cell(displayTable, column=0, row=2, text="00-03-{07}-11-{14}-17-{23}-29-{35}-41-{44}-47-{50}-53-{56}-59-{65}", text_color=bottomTextColor, text_size=size.normal, text_halign=text.align_center, bgcolor=na)
