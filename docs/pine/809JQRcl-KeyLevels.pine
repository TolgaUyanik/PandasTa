//@version=6

// @description Library for common trading levels including VWAP, session levels,
// Asia/London/NYC ranges, Comex IB, standard IB, opening ranges, HTF OHLC,
// ADR values, mids/ranges, and nearest-level utilities.
//
// --- IMPLEMENTATION INSTRUCTIONS ---
// 1. Save this script as a Library named "KeyLevels".
// 2. In your indicator/strategy, import it:
//      import adekoyotemohn/KeyLevels/3 as kl
// 3. To get the data object, call:
//      levels = kl.getLevels()
// 4. Access levels using dot notation:
//      levels.loH, levels.o5H, levels.pdMid, levels.adr
// 5. To get all levels in a single array for loops:
//      levelArray = kl.toArray(levels)
//
// --- TIMEZONE NOTE ---
// The default timezone is "UTC-5" for backward compatibility.
// For accurate seasonal adjustments, prefer "America/New_York".
library("KeyLevels", overlay = true)


// ══════════════════════════════════════════════════════════════════════════════
// SECTION 01 — USER DEFINED TYPES
// ══════════════════════════════════════════════════════════════════════════════

export type KeyLevelsData
    // VWAP pack
    float vwapCenter
    float vwapUpper
    float vwapLower
    float htfVwapCenter
    float htfVwapUpper
    float htfVwapLower
    float rollingVwap

    // Core anchors
    float dailyOpen
    float settlement

    // ADR pack
    float adr
    float adr5
    float adr10
    float adr14
    float adr20

    // Asia
    float asO
    float asH
    float asL
    float asC
    float asMid
    float asRange

    // London
    float loO
    float loH
    float loL
    float loC
    float loMid
    float loRange

    // NYC / RTH
    float nycO
    float nycH
    float nycL
    float nycC
    float nycMid
    float nycRange

    // Comex IB
    float cibO
    float cibH
    float cibL
    float cibC
    float cibMid
    float cibRange

    // Standard IB
    float ibO
    float ibH
    float ibL
    float ibC
    float ibMid
    float ibRange

    // Previous IB
    float pibH
    float pibL
    float pibMid
    float pibRange

    // Opening Range 5
    float o5O
    float o5H
    float o5L
    float o5C
    float o5Mid
    float o5Range

    // Opening Range 15
    float o15O
    float o15H
    float o15L
    float o15C
    float o15Mid
    float o15Range

    // Opening Range 30
    float o30O
    float o30H
    float o30L
    float o30C
    float o30Mid
    float o30Range

    // Opening Range 60
    float o60O
    float o60H
    float o60L
    float o60C
    float o60Mid
    float o60Range

    // Previous Day
    float pdO
    float pdH
    float pdL
    float pdC
    float pdMid
    float pdRange

    // Previous Week
    float pwO
    float pwH
    float pwL
    float pwC
    float pwMid
    float pwRange

    // Current Week
    float cwO
    float cwH
    float cwL
    float cwC
    float cwMid
    float cwRange

    // Current Month
    float cmO
    float cmH
    float cmL
    float cmC
    float cmMid
    float cmRange



// ══════════════════════════════════════════════════════════════════════════════
// SECTION 02 — INTERNAL HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

rollingVwapCalc(float src, int len) =>
    float pv = src * volume
    float sumPV = ta.sma(pv, len) * len
    float sumV = ta.sma(volume, len) * len
    not na(sumV) and sumV > 0.0 ? sumPV / sumV : na


safeMid(float hi, float lo) =>
    not na(hi) and not na(lo) ? (hi + lo) / 2.0 : na


safeRange(float hi, float lo) =>
    not na(hi) and not na(lo) ? math.abs(hi - lo) : na


getRangeOHLC(string sessionRange, string tz) =>
    var float o = na
    var float h = na
    var float l = na
    var float c = na

    bool inSession = not na(time(timeframe.period, sessionRange, tz))
    bool newSession = inSession and not inSession[1]

    if newSession
        o := open
        h := high
        l := low
        c := close
    else if inSession
        h := na(h) ? high : math.max(h, high)
        l := na(l) ? low : math.min(l, low)
        c := close

    [o, h, l, c]



// ══════════════════════════════════════════════════════════════════════════════
// SECTION 03 — EXPORTED SIMPLE HELPERS
// ══════════════════════════════════════════════════════════════════════════════

export isReady(float value) =>
    not na(value)


export rangeReady(float hi, float lo) =>
    not na(hi) and not na(lo)


export getMid(float hi, float lo) =>
    safeMid(hi, lo)


export getRange(float hi, float lo) =>
    safeRange(hi, lo)


export pctOfRange(float rangeValue, float pct) =>
    not na(rangeValue) ? rangeValue * pct * 0.01 : na


export distanceTicks(float priceA, float priceB) =>
    not na(priceA) and not na(priceB) and syminfo.mintick > 0.0 ? math.abs(priceA - priceB) / syminfo.mintick : na



// ══════════════════════════════════════════════════════════════════════════════
// SECTION 04 — NEAREST-LEVEL UTILITIES
// ══════════════════════════════════════════════════════════════════════════════

export nearestAbove(array<float> levels, float price) =>
    float best = na
    int count = array.size(levels)

    if count > 0 and not na(price)
        for i = 0 to count - 1
            float lv = array.get(levels, i)
            if not na(lv) and lv > price
                best := na(best) or lv < best ? lv : best

    best


export nearestBelow(array<float> levels, float price) =>
    float best = na
    int count = array.size(levels)

    if count > 0 and not na(price)
        for i = 0 to count - 1
            float lv = array.get(levels, i)
            if not na(lv) and lv < price
                best := na(best) or lv > best ? lv : best

    best


export nearestLevel(array<float> levels, float price) =>
    float best = na
    float bestDist = na
    int count = array.size(levels)

    if count > 0 and not na(price)
        for i = 0 to count - 1
            float lv = array.get(levels, i)
            if not na(lv)
                float dist = math.abs(lv - price)
                if na(bestDist) or dist < bestDist
                    bestDist := dist
                    best := lv

    best


export nearestDistance(array<float> levels, float price) =>
    float lv = nearestLevel(levels, price)
    not na(lv) and not na(price) ? math.abs(lv - price) : na


export nearestIndex(array<float> levels, float price) =>
    int bestIndex = -1
    float bestDist = na
    int count = array.size(levels)

    if count > 0 and not na(price)
        for i = 0 to count - 1
            float lv = array.get(levels, i)
            if not na(lv)
                float dist = math.abs(lv - price)
                if na(bestDist) or dist < bestDist
                    bestDist := dist
                    bestIndex := i

    bestIndex


export nearestAboveIndex(array<float> levels, float price) =>
    int bestIndex = -1
    float best = na
    int count = array.size(levels)

    if count > 0 and not na(price)
        for i = 0 to count - 1
            float lv = array.get(levels, i)
            if not na(lv) and lv > price
                if na(best) or lv < best
                    best := lv
                    bestIndex := i

    bestIndex


export nearestBelowIndex(array<float> levels, float price) =>
    int bestIndex = -1
    float best = na
    int count = array.size(levels)

    if count > 0 and not na(price)
        for i = 0 to count - 1
            float lv = array.get(levels, i)
            if not na(lv) and lv < price
                if na(best) or lv > best
                    best := lv
                    bestIndex := i

    bestIndex


export nearestName(array<float> levels, array<string> names, float price) =>
    string result = ""
    int idx = nearestIndex(levels, price)
    int nameCount = array.size(names)

    if idx >= 0 and idx < nameCount
        result := array.get(names, idx)

    result


export nearestAboveName(array<float> levels, array<string> names, float price) =>
    string result = ""
    int idx = nearestAboveIndex(levels, price)
    int nameCount = array.size(names)

    if idx >= 0 and idx < nameCount
        result := array.get(names, idx)

    result


export nearestBelowName(array<float> levels, array<string> names, float price) =>
    string result = ""
    int idx = nearestBelowIndex(levels, price)
    int nameCount = array.size(names)

    if idx >= 0 and idx < nameCount
        result := array.get(names, idx)

    result



// ══════════════════════════════════════════════════════════════════════════════
// SECTION 05 — getLevels()
// FIXED:
// - ADR request.security() expressions use fixed lengths only.
// - Previous IB now uses persistent prior-day IB tracking instead of fragile
//   ta.valuewhen(timeframe.change("D"), ibH[1], 0) logic.
// ══════════════════════════════════════════════════════════════════════════════

export getLevels(
     string vwapAnchor = "1D",
     float vwapMult = 2.0,
     int rollingLen = 20,
     string htfAnchor = "1W",
     string tz = "UTC-5",
     string adrMode = "ADR10"
 ) =>

    // VWAP pack
    [v, vU, vL] = ta.vwap(hlc3, timeframe.change(vwapAnchor), vwapMult)
    [hv, hvU, hvL] = ta.vwap(hlc3, timeframe.change(htfAnchor), vwapMult)
    float rv = rollingVwapCalc(hlc3, rollingLen)

    // ADR pack.
    // These request.security() expressions use fixed lengths only.
    float adr5 = request.security(syminfo.tickerid, "1D", ta.sma(high - low, 5))
    float adr10 = request.security(syminfo.tickerid, "1D", ta.sma(high - low, 10))
    float adr14 = request.security(syminfo.tickerid, "1D", ta.sma(high - low, 14))
    float adr20 = request.security(syminfo.tickerid, "1D", ta.sma(high - low, 20))

    float adr = switch adrMode
        "ADR5"  => adr5
        "ADR14" => adr14
        "ADR20" => adr20
        => adr10

    // Sessions
    [asO, asH, asL, asC] = getRangeOHLC("2000-0000:1234567", tz)
    [loO, loH, loL, loC] = getRangeOHLC("0200-0800:1234567", tz)
    [nycO, nycH, nycL, nycC] = getRangeOHLC("0930-1600:23456", tz)
    [cibO, cibH, cibL, cibC] = getRangeOHLC("0820-0920:23456", tz)

    // Opening Ranges
    [o5O, o5H, o5L, o5C] = getRangeOHLC("0930-0935:23456", tz)
    [o15O, o15H, o15L, o15C] = getRangeOHLC("0930-0945:23456", tz)
    [o30O, o30H, o30L, o30C] = getRangeOHLC("0930-1000:23456", tz)
    [o60O, o60H, o60L, o60C] = getRangeOHLC("0930-1030:23456", tz)

    // Initial Balance
    [ibO, ibH, ibL, ibC] = getRangeOHLC("0930-1030:23456", tz)

    // Previous IB tracking.
    // This captures the last completed day's IB range when a new daily period starts.
    // It avoids relying on valuewhen() against mutable session-state values.
    var float prevIbH = na
    var float prevIbL = na

    bool newDayForIb = timeframe.change("D")

    if newDayForIb and not na(ibH[1]) and not na(ibL[1])
        prevIbH := ibH[1]
        prevIbL := ibL[1]

    float pibH = prevIbH
    float pibL = prevIbL

    // HTF references.
    // Expressions are fixed and do not depend on exported function args.
    float dO = request.security(syminfo.tickerid, "1D", open)
    [pdO, pdH, pdL, pdC] = request.security(syminfo.tickerid, "1D", [open[1], high[1], low[1], close[1]])
    [pwO, pwH, pwL, pwC] = request.security(syminfo.tickerid, "1W", [open[1], high[1], low[1], close[1]])
    [cwO, cwH, cwL, cwC] = request.security(syminfo.tickerid, "1W", [open, high, low, close])
    [cmO, cmH, cmL, cmC] = request.security(syminfo.tickerid, "1M", [open, high, low, close])

    // Settlement proxy
    float settlement = pdC

    // Derived session values
    float asMid = safeMid(asH, asL)
    float asRange = safeRange(asH, asL)

    float loMid = safeMid(loH, loL)
    float loRange = safeRange(loH, loL)

    float nycMid = safeMid(nycH, nycL)
    float nycRange = safeRange(nycH, nycL)

    float cibMid = safeMid(cibH, cibL)
    float cibRange = safeRange(cibH, cibL)

    float ibMid = safeMid(ibH, ibL)
    float ibRange = safeRange(ibH, ibL)

    float pibMid = safeMid(pibH, pibL)
    float pibRange = safeRange(pibH, pibL)

    // Derived opening range values
    float o5Mid = safeMid(o5H, o5L)
    float o5Range = safeRange(o5H, o5L)

    float o15Mid = safeMid(o15H, o15L)
    float o15Range = safeRange(o15H, o15L)

    float o30Mid = safeMid(o30H, o30L)
    float o30Range = safeRange(o30H, o30L)

    float o60Mid = safeMid(o60H, o60L)
    float o60Range = safeRange(o60H, o60L)

    // Derived HTF values
    float pdMid = safeMid(pdH, pdL)
    float pdRange = safeRange(pdH, pdL)

    float pwMid = safeMid(pwH, pwL)
    float pwRange = safeRange(pwH, pwL)

    float cwMid = safeMid(cwH, cwL)
    float cwRange = safeRange(cwH, cwL)

    float cmMid = safeMid(cmH, cmL)
    float cmRange = safeRange(cmH, cmL)

    KeyLevelsData.new(
         v, vU, vL,
         hv, hvU, hvL,
         rv,

         dO,
         settlement,

         adr,
         adr5,
         adr10,
         adr14,
         adr20,

         asO, asH, asL, asC, asMid, asRange,
         loO, loH, loL, loC, loMid, loRange,
         nycO, nycH, nycL, nycC, nycMid, nycRange,
         cibO, cibH, cibL, cibC, cibMid, cibRange,

         ibO, ibH, ibL, ibC, ibMid, ibRange,
         pibH, pibL, pibMid, pibRange,

         o5O, o5H, o5L, o5C, o5Mid, o5Range,
         o15O, o15H, o15L, o15C, o15Mid, o15Range,
         o30O, o30H, o30L, o30C, o30Mid, o30Range,
         o60O, o60H, o60L, o60C, o60Mid, o60Range,

         pdO, pdH, pdL, pdC, pdMid, pdRange,
         pwO, pwH, pwL, pwC, pwMid, pwRange,
         cwO, cwH, cwL, cwC, cwMid, cwRange,
         cmO, cmH, cmL, cmC, cmMid, cmRange
    )



// ══════════════════════════════════════════════════════════════════════════════
// SECTION 06 — toArray()
// ══════════════════════════════════════════════════════════════════════════════

export toArray(KeyLevelsData data) =>
    array<float> l = array.new<float>()

    // VWAP pack
    l.push(data.vwapCenter), l.push(data.vwapUpper), l.push(data.vwapLower)
    l.push(data.htfVwapCenter), l.push(data.htfVwapUpper), l.push(data.htfVwapLower)
    l.push(data.rollingVwap)

    // Core anchors
    l.push(data.dailyOpen), l.push(data.settlement)

    // Session highs/lows/mids
    l.push(data.asH), l.push(data.asL), l.push(data.asMid)
    l.push(data.loH), l.push(data.loL), l.push(data.loMid)
    l.push(data.nycH), l.push(data.nycL), l.push(data.nycMid)
    l.push(data.cibH), l.push(data.cibL), l.push(data.cibMid)

    // IB
    l.push(data.ibH), l.push(data.ibL), l.push(data.ibMid)
    l.push(data.pibH), l.push(data.pibL), l.push(data.pibMid)

    // Opening ranges
    l.push(data.o5H), l.push(data.o5L), l.push(data.o5Mid)
    l.push(data.o15H), l.push(data.o15L), l.push(data.o15Mid)
    l.push(data.o30H), l.push(data.o30L), l.push(data.o30Mid)
    l.push(data.o60H), l.push(data.o60L), l.push(data.o60Mid)

    // Previous day/week and current higher-timeframe levels
    l.push(data.pdH), l.push(data.pdL), l.push(data.pdC), l.push(data.pdMid)
    l.push(data.pwH), l.push(data.pwL), l.push(data.pwC), l.push(data.pwMid)
    l.push(data.cwH), l.push(data.cwL), l.push(data.cwMid)
    l.push(data.cmH), l.push(data.cmL), l.push(data.cmMid)

    l



// ══════════════════════════════════════════════════════════════════════════════
// SECTION 07 — toNames()
// IMPORTANT: Order must match toArray() exactly.
// ══════════════════════════════════════════════════════════════════════════════

export toNames() =>
    array<string> n = array.new<string>()

    // VWAP pack
    n.push("VWAP"), n.push("VWAP Upper"), n.push("VWAP Lower")
    n.push("HTF VWAP"), n.push("HTF VWAP Upper"), n.push("HTF VWAP Lower")
    n.push("Rolling VWAP")

    // Core anchors
    n.push("Daily Open"), n.push("Settlement")

    // Session highs/lows/mids
    n.push("Asia High"), n.push("Asia Low"), n.push("Asia Mid")
    n.push("London High"), n.push("London Low"), n.push("London Mid")
    n.push("NYC High"), n.push("NYC Low"), n.push("NYC Mid")
    n.push("Comex IB High"), n.push("Comex IB Low"), n.push("Comex IB Mid")

    // IB
    n.push("IB High"), n.push("IB Low"), n.push("IB Mid")
    n.push("Prior IB High"), n.push("Prior IB Low"), n.push("Prior IB Mid")

    // Opening ranges
    n.push("OR5 High"), n.push("OR5 Low"), n.push("OR5 Mid")
    n.push("OR15 High"), n.push("OR15 Low"), n.push("OR15 Mid")
    n.push("OR30 High"), n.push("OR30 Low"), n.push("OR30 Mid")
    n.push("OR60 High"), n.push("OR60 Low"), n.push("OR60 Mid")

    // Previous day/week and current higher-timeframe levels
    n.push("Prior Day High"), n.push("Prior Day Low"), n.push("Prior Day Close"), n.push("Prior Day Mid")
    n.push("Prior Week High"), n.push("Prior Week Low"), n.push("Prior Week Close"), n.push("Prior Week Mid")
    n.push("Current Week High"), n.push("Current Week Low"), n.push("Current Week Mid")
    n.push("Current Month High"), n.push("Current Month Low"), n.push("Current Month Mid")

    n



// ══════════════════════════════════════════════════════════════════════════════
// SECTION 08 — toMajorArray()
// ══════════════════════════════════════════════════════════════════════════════

export toMajorArray(KeyLevelsData data) =>
    array<float> l = array.new<float>()

    l.push(data.dailyOpen)
    l.push(data.settlement)

    l.push(data.vwapCenter)
    l.push(data.htfVwapCenter)
    l.push(data.rollingVwap)

    l.push(data.o5H)
    l.push(data.o5L)
    l.push(data.o5Mid)

    l.push(data.o15H)
    l.push(data.o15L)
    l.push(data.o15Mid)

    l.push(data.ibH)
    l.push(data.ibL)
    l.push(data.ibMid)

    l.push(data.pdH)
    l.push(data.pdL)
    l.push(data.pdMid)
    l.push(data.pdC)

    l.push(data.pwH)
    l.push(data.pwL)
    l.push(data.pwMid)

    l



export toMajorNames() =>
    array<string> n = array.new<string>()

    n.push("Daily Open")
    n.push("Settlement")

    n.push("VWAP")
    n.push("HTF VWAP")
    n.push("Rolling VWAP")

    n.push("OR5 High")
    n.push("OR5 Low")
    n.push("OR5 Mid")

    n.push("OR15 High")
    n.push("OR15 Low")
    n.push("OR15 Mid")

    n.push("IB High")
    n.push("IB Low")
    n.push("IB Mid")

    n.push("Prior Day High")
    n.push("Prior Day Low")
    n.push("Prior Day Mid")
    n.push("Prior Day Close")

    n.push("Prior Week High")
    n.push("Prior Week Low")
    n.push("Prior Week Mid")

    n