//@version=6
library("KillzoneLibrary")

// @function Vérifie si l'heure actuelle est dans une Killzone
// @param currentTime L'heure actuelle (entier représentant le timestamp)
// @param tz Le fuseau horaire (par défaut : "GMT+1")
// @returns true si dans une Killzone, sinon false
export isKillzone(int currentTime, string tz) =>
    // Définir les horaires des Killzones (heure locale, par exemple GMT+1)
    londonStart = timestamp(tz, year, month, dayofmonth, 8, 0)
    londonEnd = timestamp(tz, year, month, dayofmonth, 11, 0)
    nyStart = timestamp(tz, year, month, dayofmonth, 13, 0)
    nyEnd = timestamp(tz, year, month, dayofmonth, 16, 0)
    
    // Vérifier si l'heure actuelle est dans une Killzone
    (currentTime >= londonStart and currentTime <= londonEnd) or (currentTime >= nyStart and currentTime <= nyEnd)