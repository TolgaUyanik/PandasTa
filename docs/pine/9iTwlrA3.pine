 //@version=6
indicator("Monday & Tuesday Candle Boxes + Daily Points", overlay = true, max_boxes_count = 500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// الإعدادات
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupSettings = "إعدادات المؤشر"

showMonday = input.bool(true, "إظهار الاثنين", group = groupSettings)
showTuesday = input.bool(true, "إظهار الثلاثاء", group = groupSettings)

mondayColor = input.color(color.blue, "لون الاثنين", group = groupSettings)
tuesdayColor = input.color(color.orange, "لون الثلاثاء", group = groupSettings)

boxTransparency = input.int(
     85,
     "شفافية المربع",
     minval = 0,
     maxval = 100,
     group = groupSettings
)

borderWidth = input.int(
     2,
     "سُمك حدود المربع",
     minval = 1,
     maxval = 5,
     group = groupSettings
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// التحقق من الفريم
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
isValidTimeframe = timeframe.isintraday or timeframe.isdaily

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// تحديد الأيام
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
isMonday  = dayofweek == dayofweek.monday
isTuesday = dayofweek == dayofweek.tuesday

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// المتغيرات
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var box mondayBox  = na
var box tuesdayBox = na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// مربع الاثنين
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if isValidTimeframe and showMonday and isMonday

    if na(mondayBox) or dayofweek[1] != dayofweek.monday

        mondayBox := box.new(
             left = bar_index,
             top = high,
             right = bar_index,
             bottom = low,
             border_color = mondayColor,
             border_width = borderWidth,
             bgcolor = color.new(mondayColor, boxTransparency)
        )

    else

        box.set_right(mondayBox, bar_index)
        box.set_top(mondayBox, math.max(box.get_top(mondayBox), high))
        box.set_bottom(mondayBox, math.min(box.get_bottom(mondayBox), low))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// مربع الثلاثاء
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if isValidTimeframe and showTuesday and isTuesday

    if na(tuesdayBox) or dayofweek[1] != dayofweek.tuesday

        tuesdayBox := box.new(
             left = bar_index,
             top = high,
             right = bar_index,
             bottom = low,
             border_color = tuesdayColor,
             border_width = borderWidth,
             bgcolor = color.new(tuesdayColor, boxTransparency)
        )

    else

        box.set_right(tuesdayBox, bar_index)
        box.set_top(tuesdayBox, math.max(box.get_top(tuesdayBox), high))
        box.set_bottom(tuesdayBox, math.min(box.get_bottom(tuesdayBox), low))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// نقاط فوق شموع الاثنين والثلاثاء
// تظهر على الفريم اليومي فقط
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plotshape(
     timeframe.isdaily and showMonday and isMonday,
     title = "Monday Daily Point",
     style = shape.circle,
     location = location.abovebar,
     color = mondayColor,
     size = size.small
)

plotshape(
     timeframe.isdaily and showTuesday and isTuesday,
     title = "Tuesday Daily Point",
     style = shape.circle,
     location = location.abovebar,
     color = tuesdayColor,
     size = size.small
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// خلفية خفيفة للفريمات غير المدعومة
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bgcolor(
     not isValidTimeframe
     ? color.new(color.red, 95)
     : na
)