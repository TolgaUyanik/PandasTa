// }

// functions {

// @type A type that holds a dataset as an array of float arrays.
// @field data_set A chunk of csv data. (A float array)
export type vec
    float[] data_set

// @method csv_parse
// @description Parses a string array of CSV data and converts it into an array of floats.
// @param string[] data The array of CSV strings to parse.
// @returns An array of floats representing the parsed CSV data.
export method csv_parse(string[] data)=>
    var float[] series_container = array.new<float>()

    if barstate.isfirst
        for strings in data
            string[] split_csv = str.split(strings, ",")
            for data_points in split_csv
                series_container.push(str.tonumber(data_points))

    series_container

// @description Generates a series from the parsed CSV data starting at a specified index.
// @param float[] series_container The array of floats representing the CSV data.
// @param int start_index The bar index from which to start reading the series data (default is 0).
// @returns A tuple containing the current value of the series and a boolean indicating if the data is valid.
export method make_series(float[] series_container, int start_index = 0)=>
    float csv_series = na
    bool data_ok = false

    int offset_bar_index = bar_index - start_index
    int series_container_size = series_container.size() - 1

    if offset_bar_index <= series_container_size and offset_bar_index >= 0
        data_ok := true
        csv_series := series_container.get(offset_bar_index)

    [csv_series, data_ok]

// @description Generates a series from a vector of datasets starting at a specified index, handling multiple datasets sequentially. Generally used when you have to chunk a large series into many libraries.
// @param vec[] series_vector The vector containing multiple datasets as `vec` types.
// @param int start_index The bar index from which to start reading the series data (default is 0).
// @returns A tuple containing the current value of the series and a boolean indicating if the data is valid.
export method make_series(vec[] series_vector, int start_index = 0)=>
    float csv_series = na
    bool data_ok = false
    
    var int read_position = 0
    var int cumulative_bar_index_offset = 0

    int offset_bar_index = bar_index - start_index
    int read_index = offset_bar_index - cumulative_bar_index_offset

    float[] series_container = series_vector.get(read_position).data_set
    int series_container_size = series_container.size() - 1
    int series_vector_size = series_vector.size() - 1

    if read_position <= series_vector_size and read_index >= 0
        if read_index <= series_container_size
            data_ok := true
            csv_series := series_container.get(read_index)

            if read_index == series_container_size
                cumulative_bar_index_offset += series_container_size
                read_position += 1

    [csv_series, data_ok]

// }

// example usage {

string[] full_csv = full_csv()

float[] my_series_container_1 = full_csv.csv_parse()
float[] my_series_container_2 = my_series_container_1.copy()
my_series_container_2.reverse()

vec[] series_vector = array.from(vec.new(my_series_container_1), vec.new(my_series_container_2))

[csv_time_series, series_active] = my_series_container_1.make_series()
[csv_time_series_vector_usage, series_active_vector_usage] = series_vector.make_series(10)

plot(csv_time_series, "CSV SERIES")
plot(csv_time_series_vector_usage, "CSV SERIES VECTOR VERSION", color.red)

// }
