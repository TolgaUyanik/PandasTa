// @description A collection of custom utility functions used in my scripts.
library("UtilityLibrary")


// ----------------------------------------------------- TYPES ------------------------------------------------------ {

// @type 2D vector.
export type Vec2
    float x
    float y


// @type 4D vector.
export type Vec4
    float x
    float y
    float z
    float w


// @type A collection of four 2D points, used by this libraries `cubic_bezier` function.
// @field p0 Starting point.
// @field p1 First control point.
// @field p2 Second control point.
// @field p3 Ending point.
export type Vec2_x4
    Vec2 p0
    Vec2 p1
    Vec2 p2
    Vec2 p3


// @enum Intended for [input.enum](#fun_input.enum), in conjuction with this libraries `source()` function, as an alternative to [input.source](#fun_input.source) when non bar values may break a script (ie. the output from another indicator).
export enum BarValAvgStr
    hl   = "(H + L)/2"
    hlc  = "(H + L + C)/3"
    ohlc = "(O + H + L + C)/4"
    hlcc = "(H + L + C + C)/4"


// @enum Intended for [input.enum](#fun_input.enum), in conjuction with this libraries `source()` function, as an alternative to [input.source](#fun_input.source) when non bar values may break a script (ie. the output from another indicator).
export enum BarValStr
    o    = "Open"
    h    = "High"
    l    = "Low"
    c    = "Close"
    hl   = "(H + L)/2"
    hlc  = "(H + L + C)/3"
    ohlc = "(O + H + L + C)/4"
    hlcc = "(H + L + C + C)/4"


// @enum Intended for [input.enum](#fun_input.enum), in conjuction with this libraries `source()` function, as an alternative to [input.source](#fun_input.source) when non bar values may break a script (ie. the output from another indicator). Includes `min` and `max`.
export enum BarValStrMinMax
    o    = "Open"
    h    = "High"
    l    = "Low"
    c    = "Close"
    hl   = "(H + L)/2"
    hlc  = "(H + L + C)/3"
    ohlc = "(O + H + L + C)/4"
    hlcc = "(H + L + C + C)/4"
    min  = "Min"
    max  = "Max"


// @enum Intended for [input.enum](#fun_input.enum) as a way to specify label and table text sizes.
export enum TextSizeStr
    auto   = "Auto"
    tiny   = "Tiny"
    small  = "Small"
    normal = "Normal"
    large  = "Large"
    huge   = "Huge"

// }


// ------------------------------------------------------ TIME ------------------------------------------------------ {

simple int milliseconds_per_bar =
 timeframe.multiplier * (
 timeframe.isseconds ? 1000 :
 timeframe.isminutes ? 60000 :
 timeframe.isdaily   ? 86400000 :
 timeframe.isweekly  ? 604800000 :
 timeframe.ismonthly ? 2629800000 :
 1)


// @function Gets the maximum number of milliseconds per bar.
// @returns Maximum number of milliseconds per bar.
export milliseconds_per_bar() => milliseconds_per_bar


// @function Gets the maximum number of intraday bars per session.
// @returns Maximum number of intraday bars per session, or [na](#var_na) when the timeframe is not intraday.
export max_bars_per_session() =>
    timeframe.isintraday
     ? math.ceil(1440 / timeframe.multiplier) // Contributed by @The_Peaceful_Lizard
     : na


// @function Converts a [bar_index](#var_bar_index) offset into a [time](#var_time) equivalent.
// @param number_of_bars The [bar_index](#var_bar_index) offset.
// @returns Offset converted to milliseconds.
export index_to_time(int number_of_bars) =>
    number_of_bars * milliseconds_per_bar


// @function Converts a [time](#var_time) offset into a [bar_index](#var_bar_index) equivalent.
// @param number_of_milliseconds The [time](#var_time) offset in milliseconds.
// @returns Offset converted to number of bars.
export time_to_index(int number_of_milliseconds) =>
    int(number_of_milliseconds / milliseconds_per_bar)


// @function Checks if the current bar is the actual realtime bar.
// @returns [True](#const_true) when the current bar is the actual realtime bar, [false](#const_false) otherwise.
export realtime() =>
    t  = time_to_index(timenow)
    barstate.isrealtime and (t == time_to_index(time) or t == time_to_index(time_tradingday))


// @function Checks if replay mode is active.
// @returns [True](#const_true) when the replay mode is active, [false](#const_false) otherwise.
export replay_mode() =>
    simple bool result = str.contains(syminfo.tickerid, "replay")


// @function Checks if the current bar is the last replay bar.
// @returns [True](#const_true) when the current bar is the last replay bar, [false](#const_false) otherwise.
export last_replay_bar() =>
    replay_mode() and barstate.islast


// @function Gets the number of milliseconds between consecutive script executions.
// @returns Milliseconds.
export deltatime() =>
    timenow - timenow[1]


// @function Gets how much of the current bar has elapsed.
// @returns Between 0 and 1.
export bar_elapsed() => 
    barstate.isconfirmed or not realtime() ? 1 : (timenow % milliseconds_per_bar) / milliseconds_per_bar


// @function Converts a bars [time](#var_time) into the number of minutes since midnight.
// @param bar_time Epoch timestamp ([time](#var_time) by default).
// @returns Between 0 and 1439, or [na](#var_na) when the timeframe is not intraday.
export minutes_since_midnight(int bar_time = time) =>
    timeframe.isintraday
     ? int((hour(bar_time) * 60 + minute(bar_time)) / timeframe.multiplier) // Contributed by @The_Peaceful_Lizard
     : na


// @function Converts a tally of minutes since midnight into a 24-hour clock time equivalent.
// @param minutes_since_midnight The number of minutes since midnight.
// @returns [ hour, minute ]
export clock_time_from_minutes(int minutes_since_midnight) =>
    t = minutes_since_midnight * timeframe.multiplier
    [int(t / 60), t % 60]


// @function Gets the index of the current intraday session. Similar to [bar_index](#var_bar_index) but for sessions.
// @returns Index of the current intraday session, or [na](#var_na) when the timeframe is not intraday.
export session_index() =>
    int sum = na
    sum := timeframe.isintraday and session.isfirstbar ? 1 + nz(sum[1], -1) : sum[1]


// @function Gets the index of the current intraday bar relative to its parent session.
// @returns Index of the current bar within the current session, or [na](#var_na) when the timeframe is not intraday.
export session_bar_index() =>
    timeframe.isintraday ? ta.barssince(session.isfirstbar) : na


// @function Counts the number of elapsed bars within a session on intraday charts.\
// @returns Number of elapsed bars per session, or [na](#var_na) when the timeframe is not intraday.\
// \
// **During** the first (incomplete) session, the maximum number of **potential** bars is returned.\
// **After** the first (complete) session, the actual maximum number of **counted** bars is returned.
export bars_per_session() =>
    int sum = na
    if timeframe.isintraday
        idx  = session_index()
        bar  = session_bar_index()
        sum := session.isfirstbar
         ? idx == 1 ? bar[1]
         : math.max(nz(bar[1]), nz(sum[1], max_bars_per_session()))
         : sum[1]
    sum

// }


// ------------------------------------------------------ MATH ------------------------------------------------------ {

// @function Alternate to `%` operator. If you're working with potentially negative values and care about consistency
// or wrapping, `mod` is safer and more mathematically correct.\
// \
// For positive numbers, `mod` and `%` are the same.
// ```
// mod(1, 9) == 1 % 9 == 1
// mod(2, 9) == 2 % 9 == 2
// ```
// \
// For negative numbers, they are different.
// ```
// -1 % 9 == -1
// -2 % 9 == -2
// 
// mod(-1, 9) == 8
// mod(-2, 9) == 7
// ```
// \
// This difference is the result of the built-in operator using `int()` and this function using `math.floor()`.
// @param a Number to evaluate.
// @param b Evaluating number.
// @return Remainder
export method mod(float a, float b) => 
    a - b * math.floor(a / b)


// @function Checks if the integer part of a number is even.
// @param number Number to evaluate.
// @returns [True](#const_true) when the integer part is even, [false](#const_false) when it is odd.
export method even(float number) =>
    int(number) % 2 == 0


// @function Gets the sign of a number.
// @param number Number to evaluate.
// @returns -1 or 1, unlike [math.sign](#fun_math.sign) which returns 0 if the number is 0.
export method sign(float number) =>
    sign = math.sign(number)
    na(sign) ? na : 1 / sign < 0 ? -1 : 1


// @function Shifts decimal 6 digits to the right. Pine comparators eval to 1.0e-10 and shifting the decimal affords
// 1.0e-16 evaulations, making comparators sensitive to smaller values.
// ```
// x = 0.9999999999999999
// False = 1 > x
// True  = 1.0e6 > x.e6()
// ```
// @param number Value to multiply by 1.0e6.
// @returns number × 1.0e6
method e6(float number) =>
    na(1 / number) ? number : nz(number * 1.0e16, sign(number) * 1.7976931348623157e308)


// @function Computes the Y coordinate of a hyperbolic sine.
// @param x X coordinate.
// @returns Between ± ∞.
export sinh(float x) =>
    (math.exp(x) - math.exp(-x)) * 0.5


// @function Computes the Y coordinate of a hyperbolic cosine.
// @param x X coordinate.
// @returns Between 1 and +∞.
export cosh(float x) =>
    (math.exp(x) + math.exp(-x)) * 0.5


// @function Computes the Y coordinate of a hyperbolic tangent.
// @param x X coordinate.
// @returns Between -1 and 1.
export tanh(float x) =>
    e1 = math.exp(x)
    e2 = math.exp(-x)
    (e1 - e2) / (e1 + e2)

// @function Computes the Y coordinate of the inverse hyperbolic sine.
// @param x X coordinate.
// @returns Between ± ∞.
export asinh(float x) =>
    math.log(x + math.sqrt(x * x + 1))


// @function Computes the Y coordinate of the inverse hyperbolic cosine.
// @param x X coordinate.
// @returns Between 0 and +∞.
export acosh(float x) =>
    math.log(x + math.sqrt(x * x - 1))


// @function Computes the Y coordinate of the inverse hyperbolic tangent.
// @param x X coordinate, must be between -1 and 1 (exclusive).
// @returns Between ± ∞.
export atanh(float x) =>
    math.log((1 + x) / (1 - x)) * 0.5


// @function Computes the Y coordinate of the hyperbolic secant.
// @param x X coordinate.
// @returns Between 0 and 1.
export sech(float x) =>
    2 / (math.exp(x) + math.exp(-x))


// @function Computes the Y coordinate of the hyperbolic cosecant.
// @param x X coordinate.
// @returns Between -∞ and +∞, excluding 0.
export csch(float x) =>
    2 / (math.exp(x) - math.exp(-x))


// @function Computes the Y coordinate of the hyperbolic cotangent.
// @param x X coordinate.
// @returns Between -∞ and +∞, excluding (-1, 1).
export coth(float x) =>
    e1 = math.exp(x)
    e2 = math.exp(-x)
    (e1 + e2) / (e1 - e2)


// @function Computes an angle in radians from the XY coordinate.
// @param y Y coordinate.
// @param x X coordinate.
// @returns Between -π and π.
export atan2(float y, float x) =>
    if x == 0 and y == 0
        na
    else if x > 0
        math.atan(y / x)
    else if x < 0
        math.atan(y / x) + math.pi * sign(y)
    else // x == 0
        sign(y) * math.pi / 2


// @function Gets the Euclidean length (magnitude) of a coordinate.
// @param x X coordinate.
// @param y Y coordinate.
// @returns Length (magnitude) of a coordinate.
export len(float x, float y) =>
    math.sqrt(x * x + y * y)


// @function Gets the Euclidean length (magnitude) of a 2D point, relative to the origin (0,0).
// @param point 2D point.
// @returns Length (magnitude) of the 2D point.
export len(Vec2 point) =>
    len(point.x, point.y)


// @function Zero's a point to an origin.
// @param point Point to zero.
// @param origin Origin point.
// @returns New `Vec2` point with translated coordinates.
export zero(Vec2 point, Vec2 origin) =>
    Vec2.new(point.x - origin.x, point.y - origin.y)


// @function Gets the dot product of two 2D points relative to an origin.
// @param a Point 1.
// @param b Point 2.
// @param o Point of origin (0,0 by default).
// @param cos Sets if the result should be normalized between -1 and 1, aka. the cosine similarity ([true](#const_true) by default).
// @returns Dot product of `a` and `b`.
export dot(Vec2 a, Vec2 b, Vec2 o = na, bool cos = true) =>
    A = na(o) ? a : zero(a, o)
    B = na(o) ? b : zero(b, o)
    dot_product = A.x * B.x + A.y * B.y
    cos
     ? nz(dot_product / (len(A) * len(B)))
     : dot_product

// }


// ----------------------------------------------------- ARRAYS ----------------------------------------------------- {

// @function Returns an array of floats resulting from an element-wise `operation` between `arr1` and `arr2`.
// @param arr1 An array object.
// @param arr2 An array object.
// @param operation Operation to be performed. Options: + - * / % ^ √
// @returns Array of element-wise results.
export method math(float[] arr1, float[] arr2, string operation) =>
    result = array.new_float()
    for [i, v1] in arr1
        v2 = arr2.get(i)
        r  = switch operation
            "+" => v1 + v2
            "-" => v1 - v2
            "*" => v1 * v2
            "/" => v1 / v2
            "%" => v1 % v2
            "^" => math.pow(v1, v2)
            "√" => math.pow(v1, 1 / v2)
            => na
        result.push(r)
    result

// Overload for the array math function, allowing for the second parameter to be a number.
export method math(float[] arr, float number, string operation) =>
    math(arr, array.new_float(arr.size(), number), operation)


// @function Returns an array of booleans resulting from an element-wise `comparison` between `arr1` and `arr2`.
// @param arr1 An array object.
// @param arr2 An array object.
// @param comparison Comparison to be performed. Options: == != < > <= >=
// @returns Array of element-wise results.
export method eval(float[] arr1, float[] arr2, string comparison) =>
    result = array.new_bool()
    for [i, v1] in arr1
        v2 = arr2.get(i)
        r  = switch comparison
            "==" => v1 == v2
            "!=" => v1 != v2
            "<"  => v1  < v2
            ">"  => v1  > v2
            "<=" => v1 <= v2
            ">=" => v1 >= v2
            => false
        result.push(r)
    result

// Overload for the array eval function, allowing for the second parameter to be a number.
export method eval(float[] arr, float number, string comparison) =>
    eval(arr, array.new_float(arr.size(), number), comparison)


// @function Gets the cosine similarity between two arrays.
// @param arr1 An array object.
// @param arr2 An array object.
// @returns Value between -1 and 1, where 1 is identical, 0 is orthogonal (unrelated), and -1 is opposite.
export method cos_sim(float[] arr1, float[] arr2) =>
    dot_product = 0., mag1 = 0., mag2 = 0.
    for [i, v1] in arr1
        v2 = arr2.get(i)
        dot_product += v1 * v2
        mag1 += v1 * v1
        mag2 += v2 * v2
    nz(dot_product / (math.sqrt(mag1) * math.sqrt(mag2)))


// @function Gets the dot product of two identically sized arrays.
// @param arr1 An array object.
// @param arr2 An array object.
// @param cos Sets if the result should be normalized between -1 and 1, aka. the cosine similarity ([false](#const_false) by default).
// @returns Dot product of `arr1` and `arr2`.
export method dot(float[] arr1, float[] arr2, bool cos = false) =>
    if cos
        cos_sim(arr1, arr2)
    else
        dot_product = 0.
        for [i, v] in arr1
            dot_product += v * arr2.get(i)


// @function Gets the magnitude (Euclidean length) of an array.
// @param arr An array object.
// @returns Magnitude of the array.
export method mag(float[] arr) =>
    math.sqrt(dot(arr, arr))


// @function Weighted average of two arrays. When `source` and `weight` are not the same size, `source` values are proportionally remapped to `weight` indices.
// @param source Array of source data.
// @param weight Array of weights.
// @returns Weighted average.
export weighted_average(float[] source, float[] weight) =>
    if source.size() == weight.size()
        dot(source, weight) / weight.sum()
    else
        dot = 0., sum = 0.
        last_source_index = math.max(source.size() - 1, 0)
        last_weight_index = math.max(weight.size() - 1, 0)
        for [i, v] in source
            w = nz(weight.get(math.round(math.max(last_weight_index * nz(i / last_source_index, 1), 0))), 1)
            dot += v * w
            sum += w
        dot / sum


// @function Gets the array value nearest to the target `value`.
// @param arr An array object.
// @param value Target value.
// @returns Array value nearest the target value.
export method nearest(float[] arr, float value) =>
    result = arr.get(0)
    prev_diff = math.abs(result - value)
    for v in arr
        if prev_diff == 0
            break
        diff = math.abs(v - value)
        if diff < prev_diff
            prev_diff := diff
            result := v
    result


// @function Gets the array value furthest from the target `value`.
// @param arr An array object.
// @param value Target value.
// @returns Array value furthest the target value.
export method furthest(float[] arr, float value) =>
    min = arr.min(), max = arr.max()
    math.abs(min - value) > math.abs(max - value) ? min : max


// @function Gets the index of the value if found, or the index of where the value would be if not found.\
// The array to search **must** be sorted in either ascending or descending order.
// @param arr An array object.
// @param value Target value.
// @param ascending Specifies the sort direction of the array ([true](#const_true) by default).
// @returns Array index nearest the target value.
export method binary_search_nearest(float[] arr, float value, bool ascending = true) =>
    index = 0, size = arr.size()
    if size > 0
        a = 0, b = size - 1, float v = na
        while a <= b
            index := int(a + (b - a) * 0.5)
            v := arr.get(index)
            if v == value
                break
            if ascending ? v < value : v > value
                a := index + 1
            else
                b := index - 1
        if ascending ? v < value : v > value
            index += 1
    index


// @function Ensures array size ≤ max size, while maintaining the sort order, and inserting a value.\
// \
// The array size is managed by shifting when items are inserted in the right half,\
// and popping when items are inserted in the left half.
// @param arr An array object.
// @param value Number to insert.
// @param max_size Maximum array size (100000 by default, the Pine Script max).
// @param ascending Sets the sort direction ([true](#const_true) by default).
export method insort(float[] arr, float value, bool ascending = true, int max_size = 100000) =>
    index = arr.binary_search_nearest(value, ascending)
    arr.insert(index, value)
    if max_size < arr.size()
        shift = index > arr.size() / 2
        while max_size < arr.size()
            switch shift
                true  => arr.shift()
                false => arr.pop()


// @function Ensures array size ≤ max size while appending a value.
// @param arr An array object.
// @param value Number to append.
// @param max_size Maximum array size [1, 100000] (100000 by default, the Pine Script max).
export method pushift(float[] arr, float value, int max_size = 100000) =>
    max = math.min(math.max(max_size, 1), 100000)
    if max < arr.size() + 1
        a = 0
        b = arr.size() - max + 1
        arr.slice(a, b).clear()
    arr.push(value)


// @function Ensures array size ≤ max size while appending an array of values.
// @param arr An array object.
// @param values An array object.
// @param max_size Maximum array size [1, 100000] (100000 by default, the Pine Script max).
export method pushift(float[] arr, float[] values, int max_size = 100000) =>
    max = math.min(math.max(max_size, 1), 100000)
    if values.size() > 0
        if max < arr.size() + values.size()
            a = 0
            b = math.min(arr.size(), values.size())
            arr.slice(a, b).clear()
        arr.concat(values)
        if max < arr.size()
            a = 0
            b = arr.size() - max + 1
            arr.slice(a, b).clear()


// @function Shuffles the order of array elements pseudo-randomly.
// @param arr An array object.
export method shuffle(float[] arr) =>
    size = arr.size()
    for i = 0 to size - 1
        arr.push(arr.remove(int(math.random(0, size - i))))


// @function Shuffles the order of array elements pseudo-randomly.
// @param arr An array object.
// @param seed Optional argument. When the same seed is used, allows successive calls to the function to produce a repeatable set of values.
export method shuffle(float[] arr, int seed) =>
    size = arr.size()
    for i = 0 to size - 1
        arr.push(arr.remove(int(math.random(0, size - i, seed))))

// }


// -------------------------------------------------- INTERPOLATION ------------------------------------------------- {

// @function Ensures a value is between the `min` and `max` values.
// @param number Number to clamp.
// @param min Minimum value (0 by default).
// @param max Maximum value (1 by default).
// @returns Between `min` and `max`.
export method clamp(float number, float min = 0, float max = 1) =>
    math.min(math.max(number, min), max)


// @function Ensures a value is between the `min` and `max` values.
// @param number Number to clamp.
// @param min Minimum value (0 by default).
// @param max Maximum value (1 by default).
// @returns Between `min` and `max`.
export method clamp(int number, int min = 0, int max = 1) =>
    int(clamp(number, min, max))


// @function Checks if a value is **equal to** or **between** the min-max values.
// @param number Number to check.
// @param min Minimum value (0 by default).
// @param max Maximum value (1 by default).
// @returns [True](#const_true) when the number is **equal to** or **between** the `min` and `max`, [false](#const_false) otherwise.
export method between(float number, float min = 0, float max = 1) =>
    number == number.clamp(min, max)


// @function Linearly interpolates (lerps) between two values.
// @param a Starting value.
// @param b Ending value.
// @param t Interpolation factor [0, 1].
// @returns Value between `a` and `b`.
export lerp(float a, float b, float t = 0.5) =>
    a + (b - a) * clamp(t)


// @function Spherical linear interpolation (slerp) between two values.
// @param a Starting value.
// @param b Ending value.
// @param t Interpolation factor [0, 1].
// @param angular Sets if the slerp should be angular (2D analog of a quaternion slerp, [true](#const_true), default) or scalar (smooth ease-in curve using sine, [false](#const_false)).
// @returns Value between `a` and `b`.
export slerp(float a, float b, float t = 0.5, bool angular = true) =>
    angular
     ? a + atan2(math.sin(b - a), math.cos(b - a)) * clamp(t)
     : a + (b - a) * math.sin(clamp(t) * math.pi * 0.5)


// @function Normalizes a value between two other values (inverse lerp).
// @param v Current value.
// @param a Starting value.
// @param b Ending value.
// @returns Unclamped normalized value, where 0 is `a` and 1 is `b`.
export method inv_lerp(float v, float a, float b) =>
    (v - a) / (b - a)


// @function Linearly interpolates between two output values given a non-normalized set of inputs.
// @param v Current value.
// @param iMin Input minimum (where to start interpolating).
// @param iMax Input maximum (where to stop interpolating).
// @param oMin Output minimum (lowest output value).
// @param oMax Output maximum (highest output value).
// @returns Value between `oMin` and `oMax`
export method remap( float v, float iMin, float iMax, float oMin, float oMax) =>
    lerp(oMin, oMax, inv_lerp(v, iMin, iMax)) 


// @function Hyperbolically interpolates (eases) between two values **after** the `a` threshold is exceeded.\
// \
// When `a < b`: `b` is the max and values less than `a` are literal, akin to [math.min](#fun_math.min).\
// When `a > b`: `b` is the min and values greater than `a` are literal, akin to [math.max](#fun_math.max).\
// \
// An educational example of this function is available at [desmos.com/calculator/noolsgg5ev](https://www.desmos.com/calculator/noolsgg5ev) to help illustrate the curve and expected output.
// @param v Current value.
// @param a Value where interpolation begins (0.5 by default).
// @param b Value that will not be exceeded (1 by default).
// @param e Minimum early exit lerp threshold, after which `b` is always returned (5 by default).
// @returns Value that does not exceed `b`.
export method compress(float v, float a = 0.5, float b = 1, float e = 5) =>
    switch (v < a and a < b) or (b < a and a < v)
        false => t = inv_lerp(v, a, b), t > e ? b : lerp(a, b, tanh(t))
        true  => v


// @function A semi-linear soft clamp, ensuring a value is between the `min` and `max`.\
// \
// Values are literal within the min-max Interquartile Range, compressed higher when below Q1, and compressed lower when above Q3.
// \
// An educational example of this function is available at [desmos.com/calculator/0mplguvczk](https://www.desmos.com/calculator/0mplguvczk) to help illustrate the curve and expected output.
// @param number Number to smoothly clamp.
// @param min Minimum value (0 by default).
// @param max Maximum value (1 by default).
// @returns Between `min` and `max`.
export method sclamp(float number, float min = 0, float max = 1) =>
    Q2 = lerp(min, max, 0.25), Q3 = lerp(min, max, 0.75)
    switch true
        number < Q2 => number.compress(Q2, min)
        number > Q3 => number.compress(Q3, max)
        => number


// @function A non-linear (smooth) interpolation between 0 and 1.\
// \
// An educational example of this function is available at [desmos.com/calculator/2icw3cl12s](https://www.desmos.com/calculator/2icw3cl12s) to help illustrate the curve and expected output.
// @param t Interpolation factor [0, 1].
// @param precise Sets if the calc should be precise or efficient ([true](#const_true) by default).
// @returns Between 0 and 1.
export smoothstep(float t = 0.5, bool precise = true) =>
    x = clamp(t)
    y = precise ? -math.cos(x * math.pi) / 2 + 0.5 : x * x * (3 - 2 * x)


// @function An adjustable non-linear interpolation between 0 and 1.\
// \  
// An educational example of this function is available at [desmos.com/calculator/dei9clpcck](https://www.desmos.com/calculator/dei9clpcck) to help illustrate the curve and expected output.
// @param v Easing variant: `in-out`, `in`, `out` or `out-in`.
// @param t Interpolation factor [0, 1].
// @param n1 First degree of ease [0≤] (1 by default).
// @param n2 Second degree of ease [0≤]. Only used by `out-in` (`n1` by default).
// @returns Between 0 and 1.
export ease(string v, float t = 0.5, float n1 = 1, float n2 = na) =>
    x = clamp(t)
    p = math.max(0, n1) + 1
    y = switch v
        "in"  => math.pow(x, p)
        "out" => 1 - math.pow(1 - x, p)
        "in-out" => math.pow(x, p) / (math.pow(x, p) + math.pow(1 - x, p))
        "out-in" => math.pow(1 - math.pow(1 - x, p), nz(math.max(0, n2) + 1, p))
    clamp(y)


// @function Calculates a coordinate for the Cubic Bézier function.
cubic_bezier_equation(float t, float p0, float p1, float p2, float p3) =>
    a = 1 - t, b = a * a, c = t * t
    clamp(a * b * p0 + 3 * t * b * p1 + 3 * c * a * p2 + c * t * p3)


// @function Simplifies point creation for the Cubic Bézier function.
// @param x0 X coordinate of starting point (0 by default).
// @param y0 Y coordinate of starting point (0 by default).
// @param x1 X coordinate of first control point (0.1 by default).
// @param y1 Y coordinate of first control point (0.8 by default).
// @param x2 X coordinate of second control point (0.2 by default).
// @param y2 Y coordinate of second control point (0.9 by default).
// @param x3 X coordinate of end point (1 by default).
// @param y3 Y coordinate of end point (1 by default).
export bezier_points(float x0 = 0, float y0 = 0, float x1 = 0.1, float y1 =  0.8, float x2 = 0.2, float y2 = 0.9, float x3 = 1, float y3 = 1) =>
    Vec2_x4.new(Vec2.new(x0,y0), Vec2.new(x1,y1), Vec2.new(x2,y2), Vec2.new(x3,y3))


// @function A non-linear (smooth) approximated interpolation between 0 and 1 derived from the 4 points of a Cubic Bézier Curve. \
// \ 
// **Note** \
// Oddly shaped curves may produce unexpected results. Further, because the interpolation is being approximated within a bifurcation loop, calling the function with each chart update may be inefficient.\
// Consider using this libraries `lerp_lut` function when [barstate.isfirstbar](#var_barstate.isfirst) and assigning the output to a [var](#kw_var), minimizing realtime calls to this function.\
// \
// An educational example of this function is available at [desmos.com/calculator/uoiwq6qp2r](https://www.desmos.com/calculator/uoiwq6qp2r) to help illustrate the curve and expected output.
// @param t Interpolation factor [0, 1].
// @param bezier_points The four points of a Cubic Bézier Curve.
// @returns Value between 0 and 1.
export cubic_bezier(float t = 0.5, Vec2_x4 bezier_points = na) =>
    curve = not na(bezier_points) ? bezier_points : bezier_points()

    // Bifurcation method for approximating x ≈ t 
    target = clamp(t), x = 0.5, a = 0., b = 1.
    for i = 0 to 31
        guess = cubic_bezier_equation(x, curve.p0.x, curve.p1.x, curve.p2.x, curve.p3.x)
        switch true
            guess < target => a := x
            guess > target => b := x
            => break
        x := lerp(a, b, 0.5)
    y = cubic_bezier_equation(x, curve.p0.y, curve.p1.y, curve.p2.y, curve.p3.y)


// @function Generates a look-up table (an array) for a given shaping function.
// @param size Total number of values within the LUT.
// @param shaping_function The shaping function to use. Options: `linear`, `smoothstep`, `ease-in`, `ease-out`, `ease-in-out`, `ease-out-in`, and `cubic-bezier` (`smoothstep` by default).
// @param deg1 First degree of ease [0≤] (1 by default). Only used with `ease-in`, `ease-out`, `ease-in-out`, and `ease-out-in`.
// @param deg2 Second degree of ease [0≤] (`deg1` by default). Only used with `ease-out-in`.
// @param bezier_points The four points of a Cubic Bézier Curve. Only used with `cubic-bezier`.
// @returns An array of `size` values between 0 and 1.
export lerp_lut(int size, string shaping_function = "smoothstep", float deg1 = 1, float deg2 = na, Vec2_x4 bezier_points = na) =>
    shape = str.split(str.lower(shaping_function), "-")
    func = shape.get(0)

    // Function specific variables
    variant = func == "ease" ? shape.size() == 2 ? shape.get(1) : shape.get(1)+"-"+shape.get(2) : na    
    curve   = func == "cubic" ? na(bezier_points) ? bezier_points() : bezier_points : na

    // Generate LUT
    lut_size = size.clamp(2, 100000)
    lut = array.new_float(lut_size)
    end = lut_size - 1
    for i = 0 to end
        t = i / end
        v = switch func
            "smoothstep" => smoothstep(t)
            "ease"  => ease(variant, t, deg1, deg2)
            "cubic" => cubic_bezier(t, curve)
            => lerp(0, 1, t)
        lut.set(i, v)
    lut

// }


// ------------------------------------------------------ PRICE ----------------------------------------------------- {

// @function Synthesizes standard bar values. Most useful when a script uses [request.security](#fun_request.security) or [request.security_lower_tf](#fun_request.security_lower_tf), or when you want a value nearest / furthest another value (ie. a moving average, or 0 if oscillating)
// @param s Desired source. Options: `open`, `high`, `low`, `close`, `hl2`, `hlc3`, `ohlc4`, `hlcc4`, `min`, or `max`.
// @param o Opening value ([open](#var_open) by default).
// @param h Highest value ([high](#var_high) by default).
// @param l Lowest value ([low](#var_low) by default).
// @param c Closing value ([close](#var_close) by default).
// @param a Average (mean) value (0 by default). Only used when `s` is `min` or `max.
// @returns Specified source, or 0 if the result is [na](#var_na).
export source(simple string s, float o = open, float h = high, float l = low, float c = close, float a = 0) =>

    float result = na
    src = str.lower(s)

    // Get the value nearest (or furthest) "a".
    // Useful for oscillating values (aka. the "min" might be the "high" or "max" might be the "low")
    if src == "min" or src == "max"
        barVal  = array.from(nz(o), nz(h), nz(l), nz(c), math.avg(nz(h), nz(l)), math.avg(nz(h), nz(l), nz(c)), math.avg(nz(o), nz(h), nz(l), nz(c)))
        result := switch src
            "min" => barVal.nearest(nz(a))
            "max" => barVal.furthest(nz(a))

    else // Get standard bar value
        result := switch src
            "open"  => o
            "high"  => h
            "low"   => l
            "close" => c
            "hl2"   => math.avg(h, l)
            "hlc3"  => math.avg(h, l, c)
            "ohlc4" => math.avg(o, h, l, c)
            "hlcc4" => math.avg(h, l, c, c)

    nz(result)

// Overload to convert a barValStr enum into a string.
export source(simple BarValStr s, float o = open, float h = high, float l = low, float c = close, float a = 0) =>
    simple string src = str.replace_all(str.replace_all(str.replace_all(str.tostring(s), "(", ""), " + ", ""), ")/", "")
    source(src, o, h, l, c, a)

// Overload to convert a barValStrMinMax enum into a string.
export source(simple BarValStrMinMax s, float o = open, float h = high, float l = low, float c = close, float a = 0) =>
    simple string src = str.replace_all(str.replace_all(str.replace_all(str.tostring(s), "(", ""), " + ", ""), ")/", "")
    source(src, o, h, l, c, a)

// }


// ------------------------------------------------ MOVING AVERAGES ------------------------------------------------- {

// @function Checks if the current bar is the first bar of an intraday session, or the first bar on the chart when the timeframe is not intraday.
// @returns [True](#const_true) on the first bar of an intraday session **and / or** the first charted bar, [false](#const_false) otherwise.
export new_session() =>
    barstate.isfirst or (timeframe.isintraday and timeframe.change("1440"))


// @function Increments a length to the maximum value with each new bar.\
// Intended to be used with moving averages, allowing them to function akin to [ta.vwap](#fun_ta.vwap), meaning:
// - Averages can be re-anchored (ie. `reset = new_session()`)
// - Averages can be plotted between the anchor and specified length (ie. between 0 and 199 when the length is 200)
// @param max Maximum length. Indefinite when [na](#var_na), and by default.
// @param reset The condition that resets the increment.
// @returns Value between 1 and the maximum length.
export length(int max = na, bool reset = false) =>
    clamp(ta.barssince(reset or barstate.isfirst) + 1, 1, nz(max, bar_index + 1))


// @function Weighted moving average, similar to [ta.wma](#fun_ta.wma), but with explicit weight declarations.\
// \
// **Note:** \
// The length of the average is inferred by the array size of `weight`.
// @param source Series of values to process.
// @param weight Array of weights.
// @param anchor The condition that resets averaging calculations (optional).
// @param stabilize_anchor Makes the average more resistant to change near the anchor ([false](#const_false) by default).        
// @returns Weighted moving average.
export wma(float source, float[] weight, bool anchor = false, bool stabilize_anchor = false) =>
    
    // Store price data in an array to avoid max_bars_back errors
    var price = stabilize_anchor ? array.new_float(weight.size(), source) : array.new_float()
    if anchor
        switch stabilize_anchor
            true  => price.fill(source)
            false => price.clear()
    price.pushift(source, weight.size())

    // Calculate weighted average
    weighted_average(price, weight)

// }


// ------------------------------------------------------ COLOR ----------------------------------------------------- {

// @function Determines if a color is invisible.
// @param Color (color) Color to evaluate.
// @returns [True](#const_true) when the color is transparent, [false](#const_false) otherwise.
export method is_transparent(color Color) =>
    color.t(Color) == 100


// @function Removes gamma from normalized sRGB channel values.
// @param value Normalized channel value [0, 1].
// @returns Channel value with gamma removed.
export method remove_gamma(float value) =>
    absV = math.abs(value)
    absV > 0.04045
     ? sign(value) * (math.pow((absV + 0.055) / 1.055, 2.4))
     : value / 12.92


// @function Adds gamma to normalized linear RGB channel values.
// @param value Normalized channel value [0, 1].
// @returns Channel value with gamma added.
export method add_gama(float value) =>
    absV = math.abs(value)
    absV > 0.0031308
     ? sign(value) * (1.055 * math.pow(absV, 1 / 2.4) - 0.055)
     : value * 12.92


// @function Extracts Linear RGB channels [0,1] from sRGB color.
// @param Color (color) sRGB color to process.
// @returns (float tuple) [r, g, b, a]
export method rgb_to_lin(color Color) =>
    [remove_gamma(color.r(Color) / 255),
     remove_gamma(color.g(Color) / 255),
     remove_gamma(color.b(Color) / 255),
     1 - color.t(Color) / 100]


// @function Converts Linear RGB channels [0,1] into an sRGB color.
// @param r Red channel value.
// @param g Green channel value.
// @param b Blue channel value.
// @param a Alpha channel value, (1 by default).
// @param (color) sRGB color object.
export method lin_to_rgb(float r, float g, float b, float a = na) =>
    color.rgb(
     math.round(clamp(add_gama(r)) * 255),
     math.round(clamp(add_gama(g)) * 255),
     math.round(clamp(add_gama(b)) * 255),
     math.round(clamp(1 - nz(a,1)) * 100))


// @function Extracts XYZ-D65 channels from sRGB color.
// @param Color (color) sRGB color to process.
// @returns (float tuple) [x, y, z]
export method rgb_to_xyz(color Color) =>

    // Convert sRGB to Linear RGB
    [r, g, b, _] = rgb_to_lin(Color)

    // Convert Linear RGB to XYZ-D65
    x = 506752/1228815 * r + 87881/245763 * g + 12673/70218 * b
    y = 87098/409605 * r + 175762/245763 * g + 12673/175545 * b
    z = 7918/409605 * r + 87881/737289 * g + 1001167/1053270 * b

    [x, y, z]


// @function Converts XYZ-D65 channels into an sRGB color.
// @param x X channel value.
// @param y Y channel value.
// @param z Z channel value.
// @returns (int tuple) [r, g, b]
export method xyz_to_rgb(float x, float y, float z) =>

    // Convert XYZ-D65 to Linear RGB
    r = 12831/3959 * x + -329/214 * y + -1974/3959 * z
    g = -851781/878810 * x + 1648619/878810 * y + 36519/878810 * z
    b = 705/12673 * x + -2585/12673 * y + 705/667 * z

    // Convert Linear RGB to sRGB
    lin_to_rgb(r, g, b)


// @function Extracts OKLAB-D65 channels from sRGB color.
// @param Color (color) sRGB color to process.
// @returns (float tuple) [l, a, b]
export method rgb_to_oklab(color Color) =>

    // Convert sRGB to XYZ-D65
    [x, y, z] = rgb_to_xyz(Color)

    // Convert XYZ-D65 to LMS
    L = math.pow(0.8190224379967030 * x + 0.3619062600528904 * y + -0.1288737815209879 * z, 1/3)
    M = math.pow(0.0329836539323885 * x + 0.9292868615863434 * y +  0.0361446663506424 * z, 1/3)
    S = math.pow(0.0481771893596242 * x + 0.2642395317527308 * y +  0.6335478284694309 * z, 1/3)

    // Convert LMS to OKLAB-D65
    l = 0.2104542683093140 * L +  0.7936177747023054 * M + -0.0040720430116193 * S
    A = 1.9779985324311684 * L + -2.4285922420485799 * M +  0.4505937096174110 * S
    B = 0.0259040424655478 * L +  0.7827717124575296 * M + -0.8086757549230774 * S

    [l, A, B]


// @function Converts OKLAB-D65 channels into an sRGB color.
// @param l L channel value.
// @param a A channel value.
// @param b B channel value.
// @returns (int tuple) [r, g, b]
export method oklab_to_rgb(float l, float a, float b) =>

    // Convert OKLAB-D65 to LMS
    L = math.pow(l +  0.3963377773761749 * a +  0.2158037573099136 * b, 3)
    M = math.pow(l + -0.1055613458156586 * a + -0.0638541728258133 * b, 3)
    S = math.pow(l + -0.0894841775298119 * a + -1.2914855480194092 * b, 3)

    // Convert LMS to XYZ-D65
    x =  1.2268798758459243 * L + -0.5578149944602171 * M +  0.2813910456659647 * S
    y = -0.0405757452148008 * L +  1.1122868032803170 * M + -0.0717110580655164 * S
    z = -0.0763729366746601 * L + -0.4214933324022432 * M +  1.5869240198367816 * S

    // Convert XYZ-D65 to sRGB
    xyz_to_rgb(x, y, z)


// @function Extracts OKLCH channels from sRGB color.
// @param Color (color) sRGB color to process.
// @returns (float tuple) [l, c, h]
export method rgb_to_oklch(color Color) =>

    // Convert sRGB to OKLAB-D65
    [l, a, b] = rgb_to_oklab(Color)

    // OKLAB-D65 to OKLCH
    c  = math.sqrt(a * a + b * b)
    h  = atan2(b, a)

    [l, c, h]


// @function Converts OKLCH channels into an sRGB color.
// @param l L channel value.
// @param c C channel value.
// @param h H channel value.
// @returns (float tuple) [r, g, b]
export method oklch_to_rgb(float l, float c, float h) =>

    // Convert OKLCH to OKLAB-D65
    A = c * math.cos(h)
    B = c * math.sin(h)

    // Convert OKLAB-D65 to sRGB
    oklab_to_rgb(l, A, B)


// @function Ensures the hue angles are set correctly for linearly interpolating OKLCH.
// @param l1 First L channel value.
// @param h1 First H channel value.
// @param l2 Second L channel value.
// @param h2 Second H channel value.
// @param dist Preferred angular distance to use. Options: `min` or `max` (`min` by default).
// @returns (float tuple) [h1, h2]
export method hues(float l1, float h1, float l2, float h2, string dist = "min") =>

    // Ensure the hue angle of white matches the other color
    H1 = l1 == 1 ? h2 : h1
    H2 = l2 == 1 ? H1 : h2

    // Set the angular distance
    diff = H2 - H1
    H2 := H1 + ( dist == "max"
     ? math.abs(diff) > math.pi ? diff : diff - 2 * math.pi * sign(diff)
     : math.abs(diff) > math.pi ? diff - 2 * math.pi * sign(diff) : diff )

    [H1, H2]


// @function Linearly interpolates a colors transparency.
// @param Color (color) Color to process.
// @param Alpha Interpolation factor [0, 1], where `0` is fully transparent and `1` is the original transparency value (0.5 by default).
// @returns (color) The same RGB color with an interpolated A channel.
export method fade(color Color, float Alpha = 0.5) =>
    color.new(Color, lerp(100, color.t(Color), Alpha))


// @function Linearly interpolates between two colors.
// @param color1 (color) First color.
// @param color2 (color) Second color.
// @param blend Interpolation factor [0, 1].
// @param space Color space to use for interpolating. Options: `rgb`, `oklab`, and `oklch` (`rgb` by default).
// @param dist Angular distance to use for the hue change when the color space is set to `oklch`. Options: `min` and `max` (`min` by default).
// @returns (color) Blend of `color1` and `color2`.
export method mix(color color1, color color2, float blend = 0.5, string space = "rgb", string dist = "min") =>
    t = lerp(color.t(color1), color.t(color2), blend)
    if space == "oklab"
        [l1, a1, b1] = rgb_to_oklab(color1)
        [l2, a2, b2] = rgb_to_oklab(color2)
        rgb = oklab_to_rgb(lerp(l1, l2, blend), lerp(a1, a2, blend), lerp(b1, b2, blend))
        color.new(rgb, t)
    else if space == "oklch"
        [l1, c1, h1] = rgb_to_oklch(color1)
        [l2, c2, h2] = rgb_to_oklch(color2)
        [H1, H2] = hues(l1, h1, l2, h2, dist)
        rgb = oklch_to_rgb(lerp(l1, l2, blend), lerp(c1, c2, blend), lerp(H1, H2, blend))
        color.new(rgb, t)
    else
        r = lerp(color.r(color1), color.r(color2), blend)
        g = lerp(color.g(color1), color.g(color2), blend)
        b = lerp(color.b(color1), color.b(color2), blend)
        color.rgb(r, g, b, t)

// }