//@version=6
library("TFLabelsLibrary", overlay=false)

// =============================================================================
// TFLabels -- Librairie Pine Script v6 [mrD / Gonzo]
//
// Fonctions exportees:
//   tf_label(tf)   -> string : nom lisible du timeframe
//   tf_minutes(tf) -> float  : duree en minutes
//   tf_seconds(tf) -> float  : duree en secondes
//   tf_sortval(tf) -> float  : valeur de tri
//   tf_group(tf)   -> int    : groupe de trading (1=Scalp 2=Intra 3=Day 4=Swing)
//
// Supporte tous les formats Pine v6 :
//   Secondes : "1S" "5S" "10S" "15S" "30S" "45S"
//   Minutes  : "1".."1440"
//   Jours    : "D" "2D".."365D"
//   Semaines : "W" "2W".."52W"
//   Mois     : "M" "2M".."12M"
//
// Apres publication sur TradingView:
//   import VOTRE_USERNAME/TFLabels/1 as TFL
//   label = TFL.tf_label(timeframe.period)
// =============================================================================

// -----------------------------------------------------------------------------
// tf_label : retourne le nom lisible du timeframe
// Note: les checks is_num/is_S/is_D/is_W/is_M sont pre-calcules AVANT
// la chaine if/else pour eviter l ambiguite de parsing Pine v6
// avec les blocs imbrique dans else if
// -----------------------------------------------------------------------------
export tf_label(string tf) =>
    string  r      = tf
    float   mins_f = str.tonumber(tf)
    bool    is_num = not na(mins_f)
    bool    is_S   = str.endswith(tf, "S") and not is_num
    bool    is_D   = str.endswith(tf, "D") and not is_num
    bool    is_W   = str.endswith(tf, "W") and not is_num
    bool    is_M   = str.endswith(tf, "M") and not is_num

    if tf == "D"
        r := "1D"
    else if tf == "W"
        r := "1W"
    else if tf == "M"
        r := "1M"
    else if is_S
        r := str.replace(tf, "S", "") + "s"
    else if is_D
        float nd = str.tonumber(str.replace(tf, "D", ""))
        int   ni = not na(nd) ? int(nd) : 0
        r := ni >= 365 ? str.tostring(ni / 365) + "Y" :
             ni % 7 == 0 ? str.tostring(ni / 7) + "W" :
             str.tostring(ni) + "D"
    else if is_W
        float nw = str.tonumber(str.replace(tf, "W", ""))
        int   ni = not na(nw) ? int(nw) : 0
        r := ni >= 52 ? str.tostring(ni / 52) + "Y" : str.tostring(ni) + "W"
    else if is_M
        float nm = str.tonumber(str.replace(tf, "M", ""))
        int   ni = not na(nm) ? int(nm) : 0
        r := ni >= 12 ? str.tostring(ni / 12) + "Y" : str.tostring(ni) + "M"
    else if is_num
        // Minutes : conversion intelligente
        int mi = int(mins_f)
        if mi >= 1440
            int d  = mi / 1440
            int rm = mi % 1440
            r := rm == 0 ? str.tostring(d) + "D" :
                 str.tostring(d) + "D" + str.tostring(rm / 60) + "H"
        else if mi % 60 == 0
            r := str.tostring(mi / 60) + "H"
        else if mi > 60
            r := str.tostring(mi / 60) + "H" + str.tostring(mi % 60) + "m"
        else
            r := str.tostring(mi) + "m"
    r

// -----------------------------------------------------------------------------
// tf_minutes : retourne la duree en minutes
// -----------------------------------------------------------------------------
export tf_minutes(string tf) =>
    float   m      = na
    float   mins_f = str.tonumber(tf)
    bool    is_num = not na(mins_f)
    bool    is_S   = str.endswith(tf, "S") and not is_num
    bool    is_D   = str.endswith(tf, "D") and not is_num
    bool    is_W   = str.endswith(tf, "W") and not is_num
    bool    is_M   = str.endswith(tf, "M") and not is_num

    if tf == "D"
        m := 1440.0
    else if tf == "W"
        m := 10080.0
    else if tf == "M"
        m := 43200.0
    else if is_S
        float n = str.tonumber(str.replace(tf, "S", ""))
        m := not na(n) ? n / 60.0 : na
    else if is_D
        float n = str.tonumber(str.replace(tf, "D", ""))
        m := not na(n) ? n * 1440.0 : na
    else if is_W
        float n = str.tonumber(str.replace(tf, "W", ""))
        m := not na(n) ? n * 10080.0 : na
    else if is_M
        float n = str.tonumber(str.replace(tf, "M", ""))
        m := not na(n) ? n * 43200.0 : na
    else if is_num
        m := mins_f
    na(m) ? 1.0 : math.max(m, 1.0 / 60.0)

// -----------------------------------------------------------------------------
// tf_seconds : retourne la duree en secondes
// -----------------------------------------------------------------------------
export tf_seconds(string tf) =>
    tf_minutes(tf) * 60.0

// -----------------------------------------------------------------------------
// tf_sortval : valeur de tri (secondes)
// -----------------------------------------------------------------------------
export tf_sortval(string tf) =>
    tf_seconds(tf)

// -----------------------------------------------------------------------------
// tf_group : groupe de trading
// 1 = Scalping  (<= 1H)
// 2 = Intraday  (<= 4H)
// 3 = Day       (<= 1D)
// 4 = Swing/LT  (> 1D)
// -----------------------------------------------------------------------------
export tf_group(string tf) =>
    float m = tf_minutes(tf)
    m <= 60 ? 1 : m <= 240 ? 2 : m <= 1440 ? 3 : 4

// =============================================================================
// Demo -- table horizontale (1 colonne par TF)
// Ligne 0 : TF string brut
// Ligne 1 : tf_label()   -- nom lisible
// Ligne 2 : tf_minutes() -- duree en minutes
// Ligne 3 : tf_group()   -- groupe (1=Scalp 2=Intra 3=Day 4=Swing)
// =============================================================================

// 32 TFs + 1 colonne header = 33 colonnes, 4 lignes de donnees + 0 header ligne
var table t = table.new(position.top_right, 33, 4,
 border_width=1, border_color=color.new(#787b86, 50),
 bgcolor=color.new(#1a1a2e, 80), frame_width=1, frame_color=color.new(#37474f,0))

if barstate.islast
    string[] tfs = array.from(
     "1S","5S","15S","30S","45S",
     "1","5","15","30","45","60","90","120","180","240","360","480","720","1440",
     "D","2D","3D","7D","30D","365D",
     "W","4W","52W",
     "M","3M","6M","12M")

    // Colonne 0 : labels de ligne
    string[] row_lbl = array.from("TF", "label", "min", "grp")
    color[]  row_clr = array.from(
     color.new(#546e7a, 40),
     color.new(#1565c0, 40),
     color.new(#37474f, 60),
     color.new(#4a148c, 60))
    for r = 0 to 3
        table.cell(t, 0, r, array.get(row_lbl, r),
         text_color=chart.fg_color, bgcolor=array.get(row_clr, r),
         text_size=size.small)

    // Colonnes 1..32 : une par TF
    for i = 0 to array.size(tfs) - 1
        int    col = i + 1
        string tf  = array.get(tfs, i)
        string lbl = tf_label(tf)
        float  mn  = tf_minutes(tf)
        int    grp = tf_group(tf)

        // Couleur par unite de temps
        color unit_clr =
         str.endswith(tf, "S") ? color.new(#00e676, 75) :
         mn < 60   ? color.new(#00bcd4, 75) :
         mn < 1440 ? color.new(#7c4dff, 75) :
         mn < 10080? color.new(#ff9800, 75) : color.new(#ab47bc, 75)

        // Couleur par groupe de trading
        color grp_clr =
         grp == 1 ? color.new(#00bcd4, 60) :
         grp == 2 ? color.new(#7c4dff, 60) :
         grp == 3 ? color.new(#ff9800, 60) : color.new(#ab47bc, 60)

        // Ligne 0 : TF string brut
        table.cell(t, col, 0, tf,
         text_color=color.new(unit_clr, 0), bgcolor=color.new(unit_clr, 88),
         text_size=size.small)
        // Ligne 1 : tf_label()
        table.cell(t, col, 1, lbl,
         text_color=chart.fg_color, bgcolor=color.new(unit_clr, 80),
         text_size=size.small)
        // Ligne 2 : tf_minutes()
        table.cell(t, col, 2, str.tostring(mn),
         text_color=color.new(#90a4ae, 0), bgcolor=color.new(#263238, 80),
         text_size=size.tiny)
        // Ligne 3 : tf_group()
        table.cell(t, col, 3, str.tostring(grp),
         text_color=chart.fg_color, bgcolor=grp_clr,
         text_size=size.tiny)