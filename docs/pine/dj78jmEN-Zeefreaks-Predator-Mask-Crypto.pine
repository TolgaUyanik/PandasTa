//@version=6
indicator(title="MAs", shorttitle="AOTS", overlay=true)

// Input lengths
Length1 = input.int(19, minval=1, title="EMA Length")
Length2 = input.int(23, minval=1, title="SMA 23 Length")
Length3 = input.int(100, minval=1, title="SMA 100 Length")

// Price source
xPrice = close

// Moving Averages
xEMA19  = ta.ema(xPrice, Length1)
xMA23   = ta.sma(xPrice, Length2)
xMA100  = ta.sma(xPrice, Length3)

// Plot the moving averages
plot(xEMA19, color=color.new(#FF5252, 0), linewidth=1, title="EMA 19")
plot(xMA23,  color=color.new(#FF9800, 0), linewidth=1, title="SMA 23")
plot(xMA100, color=color.new(#2196F3, 0), linewidth=1, title="SMA 100")
