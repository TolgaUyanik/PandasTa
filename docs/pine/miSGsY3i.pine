//@version=6

// @description Ticker Library
library("TickerLib")
// Ticker
// BINANCE:BTCUSDT.P
// exchange:pair.perp


//=== Existance ===//

// @function Test if a tickerId exists
// @param (string) tickerId
// @returns (bool)
export exists(string tickerId) =>
	candleValue = request.security(tickerId, "9", open, barmerge.gaps_off, barmerge.lookahead_on, ignore_invalid_symbol=true)
	not(na(candleValue))

// @function Test if a tickerId do not exists
// @param (string) tickerId
// @returns (bool)
export notExist(string tickerId) =>
	not(exists(tickerId))


// === Ticker informations ===//

// @function Pass a tickerId return the exchange
// @param (string) tickerId by default use the current one
// @returns (string) exchange
export getExchange(string tickerId=syminfo.tickerid) =>
	array.shift(str.split(tickerId, ":"))

// @function Test if tickerId is a perps pair
// @param (string) tickerId by default use the current one
// @returns (bool)
export isPerp(string tickerId=syminfo.tickerid) =>
	str.endswith(tickerId, ".P")

// @function Test if tickerId is not a perps pair
// @param (string) tickerId by default use the current one
// @returns (bool)
export isNotPerp(string tickerId=syminfo.tickerid) =>
	not(isPerp(tickerId))

// @function Pass a tickerId return the pair without exchange
// @param (string) tickerId by default use the current one
// @returns (string) the pair
export getPair(string tickerId=syminfo.tickerid) =>
	array.pop(str.split(tickerId, ":"))

// @function Pass a tickerId return the pair without exchange and perps
// @param (string) tickerId by default use the current one
// @returns (string) the pair
export getSpotPair(string tickerId=syminfo.tickerid) =>
	pair = getPair(tickerId)
	if isPerp()
		// Remove ".P" at the end
		pair := str.substring(pair, 0, str.length(pair) - 2)
	pair