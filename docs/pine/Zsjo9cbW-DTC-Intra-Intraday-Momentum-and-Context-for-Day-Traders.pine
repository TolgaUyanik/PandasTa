// used and adapted under MPL-2.0. All other components are original to DTC Intra+.
//@version=6
indicator("DTC Intra+", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// === THEME SETTINGS ===
string themeMode = input.string('Auto', title='Theme', options=['Auto', 'Dark', 'Light'], group='🎨 Theme Settings', tooltip='Changes the color scheme of all dashboard elements. Auto detects chart background.')
bool enableThemeAdaptation = input.bool(true, title='Enable Theme Adaptation', group='🎨 Theme Settings', tooltip='Automatically adapt colors to match the selected theme')
bool showThemeInfo = input.bool(false, title='Show Theme Info', group='🎨 Theme Settings', tooltip='Display current theme information in the table')

// === AUTOMATIC THEME DETECTION ===
// Function to detect if chart background is dark or light
f_is_dark_theme() =>
    // Get chart background color brightness
    bg = chart.bg_color
    // Extract RGB components and calculate luminance
    r = color.r(bg)
    g = color.g(bg)
    b = color.b(bg)
    // Use standard luminance formula (0.299*R + 0.587*G + 0.114*B)
    luminance = 0.299 * r + 0.587 * g + 0.114 * b
    // If luminance < 128, it's a dark theme
    luminance < 128

// Determine if dark theme should be used
bool isDark = switch themeMode
    'Auto' => f_is_dark_theme()
    'Dark' => true
    'Light' => false
    => f_is_dark_theme()  // Default to auto detection

// === BLUE THEME COLOR SCHEME ===
// --- Dark Theme (Blue Accent) ---
color dark_bg_pri = #1a1f2e
color dark_bg_sec = #2a3142
color dark_text_pri = #ffffff
color dark_text_sec = #b8c5d6
color dark_head_bg = #1e3a8a
color dark_pos = #3b82f6
color dark_vpos = #10b981
color dark_neg = #ef4444
color dark_stage2 = #3b82f6
color dark_stage13 = #f59e0b
color dark_border = #475569

// --- Light Theme (Blue Accent) ---
color light_bg_pri = #ffffff
color light_bg_sec = #f1f5f9
color light_text_pri = #1e293b
color light_text_sec = #475569
color light_head_bg = #3b82f6
color light_pos = #2563eb
color light_vpos = #059669
color light_neg = #dc2626
color light_stage2 = #2563eb
color light_stage13 = #d97706
color light_border = #64748b

// --- Dynamic Colors (Blue Theme) ---
// Table backgrounds — fully transparent, matched to DTC AIO's clean/transparent table
// style (no cell fills, no zebra stripes, no border — text color carries the meaning).
color tableBg1 = color.new(color.black, 100)
color tableBg2 = color.new(color.black, 100)
// Text colors adapt to theme
color tableText = isDark ? dark_text_pri : light_text_pri
color tableHeaderText = tableText
color tableHeaderBg = color.new(color.black, 100)
// Performance colors (blue theme)
color positiveColor = isDark ? dark_pos : light_pos
color veryPositiveColor = isDark ? dark_vpos : light_vpos
color negativeColor = isDark ? dark_neg : light_neg
color stage2Color = isDark ? dark_stage2 : light_stage2
color stage13Color = isDark ? dark_stage13 : light_stage13
color adaptiveTextSecondary = isDark ? dark_text_sec : light_text_sec

// === INPUTS ===
// Moving Average Settings
ma10_length = input.int(10, "MA 10 Length", minval=1, maxval=500)
ma20_length = input.int(20, "MA 20 Length", minval=1, maxval=500)
ma50_length = input.int(50, "MA 50 Length", minval=1, maxval=500)
ma200_length = input.int(200, "MA 200 Length", minval=1, maxval=500)

// Moving Average Types
ma_type = input.string("SMA", "Moving Average Type", options=["SMA", "EMA", "WMA", "HMA"])

// VWAP Settings
show_vwap = input.bool(true, "Show VWAP")
vwap_color = input.color(color.purple, "VWAP Color")
vwap_width = input.int(2, "VWAP Line Width", minval=1, maxval=5)

// Moving Average Colors
ma10_color = input.color(color.yellow, "MA 10 Color", tooltip="Color for the 10-period moving average line")
ma20_color = input.color(color.blue, "MA 20 Color", tooltip="Color for the 20-period moving average line")
ma50_color = input.color(color.orange, "MA 50 Color", tooltip="Color for the 50-period moving average line")
ma200_color = input.color(color.red, "MA 200 Color", tooltip="Color for the 200-period moving average line")

// Moving Average Widths
ma10_width = input.int(1, "MA 10 Width", minval=1, maxval=5, tooltip="Line thickness for the 10-period moving average")
ma20_width = input.int(1, "MA 20 Width", minval=1, maxval=5, tooltip="Line thickness for the 20-period moving average")
ma50_width = input.int(1, "MA 50 Width", minval=1, maxval=5, tooltip="Line thickness for the 50-period moving average")
ma200_width = input.int(2, "MA 200 Width", minval=1, maxval=5, tooltip="Line thickness for the 200-period moving average (thicker for emphasis)")

// === INTRADAY SESSION DETECTION ===
g_intraday_sessions = "🌅 INTRADAY SESSIONS"
enable_intraday_sessions = input.bool(true, "Enable Intraday Sessions", group=g_intraday_sessions, tooltip="Show/hide intraday session detection and analysis")
show_session_boxes = input.bool(true, "Show Session Boxes", group=g_intraday_sessions, tooltip="Display colored boxes for each intraday session")
show_session_labels = input.bool(true, "Show Session Labels", group=g_intraday_sessions, tooltip="Display session names and characteristics on the chart")

// Session 1: Morning (9:15 AM - 11:00 AM IST)
session1_enabled = input.bool(true, "Session 1: Morning", group=g_intraday_sessions, inline="s1", tooltip="Enable morning session detection")
session1_start = input.session("0915-1100", "Start-End", group=g_intraday_sessions, inline="s1", tooltip="Morning session time range (HHMM-HHMM format)")
session1_label = input.string("MORNING", "Label", group=g_intraday_sessions, inline="s1", tooltip="Label for morning session")
session1_color = input.color(color.rgb(34, 139, 34), "Color", group=g_intraday_sessions, inline="s1", tooltip="Background color for morning session")

// Session 2: Mid-Day (11:00 AM - 1:30 PM IST)
session2_enabled = input.bool(true, "Session 2: Mid-Day", group=g_intraday_sessions, inline="s2", tooltip="Enable mid-day session detection")
session2_start = input.session("1100-1330", "Start-End", group=g_intraday_sessions, inline="s2", tooltip="Mid-day session time range (HHMM-HHMM format)")
session2_label = input.string("MID-DAY", "Label", group=g_intraday_sessions, inline="s2", tooltip="Label for mid-day session")
session2_color = input.color(color.rgb(255, 140, 0), "Color", group=g_intraday_sessions, inline="s2", tooltip="Background color for mid-day session")

// Session 3: Afternoon (1:30 PM - 3:30 PM IST)
session3_enabled = input.bool(true, "Session 3: Afternoon", group=g_intraday_sessions, inline="s3", tooltip="Enable afternoon session detection")
session3_start = input.session("1330-1530", "Start-End", group=g_intraday_sessions, inline="s3", tooltip="Afternoon session time range (HHMM-HHMM format)")
session3_label = input.string("AFTERNOON", "Label", group=g_intraday_sessions, inline="s3", tooltip="Label for afternoon session")
session3_color = input.color(color.rgb(128, 0, 128), "Color", group=g_intraday_sessions, inline="s3", tooltip="Background color for afternoon session")

// Session Box Styling
session_box_opacity = input.int(10, "Session Box Opacity", minval=10, maxval=100, group=g_intraday_sessions, tooltip="Transparency level for session box backgrounds (10=transparent, 100=opaque)")
session_border_opacity = input.int(50, "Session Border Opacity", minval=10, maxval=100, group=g_intraday_sessions, tooltip="Transparency level for session box borders (10=transparent, 100=opaque)")
session_border_width = input.int(1, "Session Border Width", minval=1, maxval=5, group=g_intraday_sessions, tooltip="Thickness of session box borders")

// === TABLE SETTINGS ===
g_table_settings = "📊 TABLE SETTINGS"
table_position = input.string("Top Right", "Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=g_table_settings, tooltip="Position of the information table on the chart")

// === DAILY DIVIDERS ===
g_daily_dividers = "📅 DAILY DIVIDERS"
show_daily_dividers = input.bool(true, "Show Daily Dividers", group=g_daily_dividers, tooltip="Show day labels to separate trading days")

// === THEME-ADAPTIVE COLORS ===
// Function to get table position from string input
get_table_position(pos_string) =>
    switch pos_string
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.top_right  // Default fallback

// Function to determine text color based on background color
get_adaptive_text_color(bg_color) =>
    // If background color is not the default table background, use white text
    // Otherwise use the theme-appropriate text color
    bg_color != tableBg1 ? color.white : tableText

// Moving Average Colors that adapt to theme
color ma10_theme_color = isDark ? color.new(ma10_color, 0) : ma10_color
color ma20_theme_color = isDark ? color.new(ma20_color, 0) : ma20_color
color ma50_theme_color = isDark ? color.new(ma50_color, 0) : ma50_color
color ma200_theme_color = isDark ? color.new(ma200_color, 0) : ma200_color

// VWAP Color that adapts to theme
color vwap_theme_color = isDark ? color.new(vwap_color, 0) : vwap_color

// Background colors for theme adaptation
color chart_bg_color = isDark ? color.new(dark_bg_pri, 95) : color.new(light_bg_pri, 95)
color session_bg_color = isDark ? color.new(dark_bg_sec, 90) : color.new(light_bg_sec, 90)

// Theme-adaptive text color for session boxes
color boxTextColor = isDark ? color.white : color.black



// === MOVING AVERAGE CALCULATIONS ===
// Function to calculate moving average based on type
get_ma(src, length, type) =>
    switch type
        "SMA" => ta.sma(src, length)
        "EMA" => ta.ema(src, length)
        "WMA" => ta.wma(src, length)
        "HMA" => ta.hma(src, length)

// Calculate all moving averages
ma10 = get_ma(close, ma10_length, ma_type)
ma20 = get_ma(close, ma20_length, ma_type)
ma50 = get_ma(close, ma50_length, ma_type)
ma200 = get_ma(close, ma200_length, ma_type)

// === VWAP CALCULATION ===
vwap = ta.vwap(close)

// === RELATIVE VOLUME (RVOL) ===
rvol_length = input.int(21, "RVol Length", minval=1, maxval=100, group="Volume Analysis", tooltip="Period for calculating average volume. Higher values give more stable baseline.")
show_rvol = input.bool(true, "Show RVol in Table", group="Volume Analysis", tooltip="Display Relative Volume percentage in the information table")

// Volume Analysis Settings
volume_period = input.int(50, "Volume Period", minval=10, maxval=200, group="Volume Analysis", tooltip="Period for calculating average volume. Used to determine volume thresholds.")
volume_multiplier = input.float(2.5, "Volume Multiplier", minval=1.0, maxval=10.0, step=0.1, group="Volume Analysis", tooltip="Multiplier for high volume detection. 2.5x means 250% of average volume triggers high volume coloring.")

// Volume Colors
volume_high_bullish_color = input.color(color.rgb(0, 255, 0), "High Bullish Volume (200%+)", group="Volume Analysis", tooltip="Green color for candles with high volume and price increase")
volume_high_bearish_color = input.color(color.rgb(255, 0, 0), "High Bearish Volume (200%+)", group="Volume Analysis", tooltip="Red color for candles with high volume and price decrease")
volume_moderate_bullish_color = input.color(color.rgb(0, 150, 255), "Moderate Bullish Volume (150%+)", group="Volume Analysis", tooltip="Blue color for candles with moderate volume and price increase")
volume_moderate_bearish_color = input.color(color.rgb(255, 0, 255), "Moderate Bearish Volume (150%+)", group="Volume Analysis", tooltip="Pink color for candles with moderate volume and price decrease")

// RVol calculation (from DTC AIO)
float today_vol = request.security(syminfo.tickerid, "D", volume)
float avg_vol = request.security(syminfo.tickerid, "D", ta.sma(volume[1], rvol_length))
float rvol = avg_vol > 0 ? (today_vol / avg_vol) * 100 : na

// === ADR (AVERAGE DAILY RANGE) ===
adr_length = input.int(14, "ADR Period", minval=1, maxval=100, group="ADR Analysis", tooltip="Length for the Average Daily Range calculation. Shows average daily volatility over N days.")
show_adr = input.bool(true, "Show ADR in Table", group="ADR Analysis", tooltip="Display ADR information in the table")

// ADR calculations - Use daily data for past 20 days
float adr = request.security(syminfo.tickerid, "D", ta.sma(high - low, 20))
float adr_daily_close = request.security(syminfo.tickerid, "D", close)
float adr_percent = adr / adr_daily_close * 100

// Multi-timeframe ADR
float adr_weekly = request.security(syminfo.tickerid, "W", ta.sma(high - low, 14))
float adr_weekly_percent = adr_weekly / close * 100
float adr_monthly = request.security(syminfo.tickerid, "M", ta.sma(high - low, 12))
float adr_monthly_percent = adr_monthly / close * 100

// === BURST RANKER ===
show_burst = input.bool(true, "Show Burst in Table", group="Burst Analysis", tooltip="Display burst ranker information in the table")
burst_lookback = input.string("3 Years", "Burst Lookback", options=["3 Months", "6 Months", "1 Year", "3 Years"], group="Burst Analysis", tooltip="Sets the lookback period for the burst ranker. Longer periods give more historical context.")

// Burst time calculation
f_get_burst_cutoff_time(period) =>
    y = year(timenow)
    m = month(timenow)
    d = dayofmonth(timenow)

    switch period
        "3 Months" => m := m - 3
        "6 Months" => m := m - 6
        "1 Year"   => y := y - 1
        "3 Years"  => y := y - 3

    if m <= 0
        y := y - 1
        m := m + 12

    timestamp(y, m, d, 0, 0)

burst_cutoff_time = f_get_burst_cutoff_time(burst_lookback)

// Burst counting variables - Use daily data
var int count_5p = 0
var int count_10p = 0
var int count_17p = 0

// Get daily data for burst calculation
daily_close = request.security(syminfo.tickerid, "D", close)
daily_close_prev = request.security(syminfo.tickerid, "D", close[1])
daily_time = request.security(syminfo.tickerid, "D", time)

// Burst detection logic - Completely based on daily data
daily_move_burst = (daily_close - daily_close_prev) / daily_close_prev * 100
is_in_burst_lookback = daily_time >= burst_cutoff_time
is_new_day_burst = ta.change(daily_time) != 0

// Reset counters when entering new lookback period
if is_in_burst_lookback and not is_in_burst_lookback[1]
    count_5p := 0
    count_10p := 0
    count_17p := 0

// Count burst days based on daily data
if is_in_burst_lookback and is_new_day_burst
    if daily_move_burst >= 5
        count_5p += 1
    if daily_move_burst >= 10
        count_10p += 1
    if daily_move_burst >= 17
        count_17p += 1

// Burst power score calculation
burst_power_score = math.round(count_5p / 5 + count_10p / 2 + count_17p / 0.5)

// === VOLUME-BASED CANDLE COLORING ===
show_volume_colors = input.bool(true, "Show Volume Colors", group="Volume Analysis", tooltip="Color candles based on volume strength")




// Calculate average volume over the specified period
avg_volume = ta.sma(volume, volume_period)
moderate_volume_threshold = avg_volume * 1.5  // 150%
high_volume_threshold = avg_volume * volume_multiplier  // 200%+ (adjustable)

// Check if current candle has moderate or high volume
is_moderate_volume = volume > moderate_volume_threshold and volume <= high_volume_threshold
is_high_volume = volume > high_volume_threshold

// Volume-based candle coloring
volume_color = show_volume_colors ? (is_high_volume ? (close > open ? volume_high_bullish_color : volume_high_bearish_color) : (is_moderate_volume ? (close > open ? volume_moderate_bullish_color : volume_moderate_bearish_color) : na)) : na

// === INTRADAY SESSION DETECTION LOGIC ===
// Session detection using IST timezone
ist_timezone = "Asia/Kolkata"

// Check if we're in each session
in_session1 = not na(time(timeframe.period, session1_start, ist_timezone)) and session1_enabled
in_session2 = not na(time(timeframe.period, session2_start, ist_timezone)) and session2_enabled
in_session3 = not na(time(timeframe.period, session3_start, ist_timezone)) and session3_enabled

// Session variables for tracking
var box session1_box = na
var box session2_box = na
var box session3_box = na

// Session background colors using user-defined opacity
color session1_bg = color.new(session1_color, 100 - session_box_opacity)
color session2_bg = color.new(session2_color, 100 - session_box_opacity)
color session3_bg = color.new(session3_color, 100 - session_box_opacity)

// Session border colors using user-defined border opacity
color session1_border = color.new(session1_color, 100 - session_border_opacity)
color session2_border = color.new(session2_color, 100 - session_border_opacity)
color session3_border = color.new(session3_color, 100 - session_border_opacity)

// === INTRADAY SESSION BOX DRAWING ===
if enable_intraday_sessions and show_session_boxes and timeframe.isintraday
    // Session 1: Morning Trending
    if in_session1 and not in_session1[1]
        // Session 1 started - create new box
        if not na(session1_box)
            box.delete(session1_box)
        session1_box := box.new(bar_index, high, bar_index + 1, low,
                               border_color=session1_border, bgcolor=session1_bg,
                               border_style=line.style_solid, border_width=session_border_width)

    if in_session1 and in_session1[1] and not na(session1_box)
        // Extend Session 1 box to right edge and update high/low
        box.set_right(session1_box, bar_index + 1)
        if high > box.get_top(session1_box)
            box.set_top(session1_box, high)
        if low < box.get_bottom(session1_box)
            box.set_bottom(session1_box, low)
        // Add label if box is wide enough
        if (box.get_right(session1_box) - box.get_left(session1_box)) >= 2 and show_session_labels
            box.set_text(session1_box, session1_label)
            box.set_text_color(session1_box, boxTextColor)
            box.set_text_size(session1_box, size.small)
            box.set_text_halign(session1_box, text.align_center)
            box.set_text_valign(session1_box, text.align_center)
        else
            box.set_text(session1_box, "")

    if not in_session1 and in_session1[1] and not na(session1_box)
        // Session 1 ended - finalize box at current bar
        box.set_right(session1_box, bar_index - 1)

    // Session 2: Mid-Day Sideways
    if in_session2 and not in_session2[1]
        // Session 2 started - create new box
        if not na(session2_box)
            box.delete(session2_box)
        session2_box := box.new(bar_index, high, bar_index + 1, low,
                               border_color=session2_border, bgcolor=session2_bg,
                               border_style=line.style_solid, border_width=session_border_width)

    if in_session2 and in_session2[1] and not na(session2_box)
        // Extend Session 2 box to right edge and update high/low
        box.set_right(session2_box, bar_index + 1)
        if high > box.get_top(session2_box)
            box.set_top(session2_box, high)
        if low < box.get_bottom(session2_box)
            box.set_bottom(session2_box, low)
        // Add label if box is wide enough
        if (box.get_right(session2_box) - box.get_left(session2_box)) >= 2 and show_session_labels
            box.set_text(session2_box, session2_label)
            box.set_text_color(session2_box, boxTextColor)
            box.set_text_size(session2_box, size.small)
            box.set_text_halign(session2_box, text.align_center)
            box.set_text_valign(session2_box, text.align_center)
        else
            box.set_text(session2_box, "")

    if not in_session2 and in_session2[1] and not na(session2_box)
        // Session 2 ended - finalize box at current bar
        box.set_right(session2_box, bar_index - 1)

    // Session 3: Afternoon Volatile
    if in_session3 and not in_session3[1]
        // Session 3 started - create new box
        if not na(session3_box)
            box.delete(session3_box)
        session3_box := box.new(bar_index, high, bar_index + 1, low,
                               border_color=session3_border, bgcolor=session3_bg,
                               border_style=line.style_solid, border_width=session_border_width)

    if in_session3 and in_session3[1] and not na(session3_box)
        // Extend Session 3 box to right edge and update high/low
        box.set_right(session3_box, bar_index + 1)
        if high > box.get_top(session3_box)
            box.set_top(session3_box, high)
        if low < box.get_bottom(session3_box)
            box.set_bottom(session3_box, low)
        // Add label if box is wide enough
        if (box.get_right(session3_box) - box.get_left(session3_box)) >= 2 and show_session_labels
            box.set_text(session3_box, session3_label)
            box.set_text_color(session3_box, boxTextColor)
            box.set_text_size(session3_box, size.small)
            box.set_text_halign(session3_box, text.align_center)
            box.set_text_valign(session3_box, text.align_center)
        else
            box.set_text(session3_box, "")

    if not in_session3 and in_session3[1] and not na(session3_box)
        // Session 3 ended - finalize box at current bar
        box.set_right(session3_box, bar_index - 1)



// === STRONG START (from DTC AIO) ===
// Same definition as DTC AIO's Strong Start: gapped up AND held the gap — open > prev
// close AND (running) low >= prev close × (1 − gap tolerance). Distinct from the plain
// Gap Alert above, which only checks the raw opening gap %, not whether it actually held.
g_strong_start = "🚀 Strong Start"
ss_enabled = input.bool(true, "Enable", group=g_strong_start, tooltip="Flags days where the stock gapped up AND has held the gap: open > prev close AND low ≥ prev close × (1 − gap tolerance).")
ss_gap_tol = input.float(0.5, "Gap tolerance (%)", minval=0.0, maxval=3.0, step=0.1, group=g_strong_start, tooltip="Max % the low can dip below previous close before the gap is considered filled. Default 0.5%.")
ss_show_label = input.bool(true, "Show label", group=g_strong_start)
ss_color = input.color(color.new(#ffd000, 0), "Marker color", group=g_strong_start)

// === MINICHARTS MULTI MARKET (integrated component) ===
// The single-symbol mini chart originally in this dashboard has been replaced with the
// "Minicharts Multi Market" engine by TradingView user helman13 (Herman Trading), used
// under its Mozilla Public License 2.0 (https://mozilla.org/MPL/2.0/). Credit and license
// retained per the original. It renders up to three on-chart mini candlestick panels of
// any symbols/timeframes, each with optional EMA and VWAP overlays. It is off by default
// (master toggle below) so the dashboard is unchanged until you enable it.

// --- Timeframe guard ---
// Requesting a resolution finer than the chart's (e.g. a 5-minute minichart on a Daily
// chart) loads intrabar data across the whole history and can exceed TradingView's memory
// limit. Clamp each minichart's timeframe to be no finer than the current chart timeframe.
f_effTf(string reqTf) =>
    timeframe.in_seconds(reqTf) >= timeframe.in_seconds(timeframe.period) ? reqTf : timeframe.period

// --- Groups ---
string G_C   = "🔍 Minicharts — Assets Setup"
string G_EMA = "🔍 Minicharts — EMA"
string G_VWAP = "🔍 Minicharts — VWAP"
string G_ST  = "🔍 Minicharts — Style & Layout"

// --- Master toggle (kept off by default so the dashboard is unchanged until enabled) ---
bool mm_master = input.bool(false, "Enable Minicharts panel", group = G_C, tooltip = "Master switch for the Minicharts Multi Market panel (by helman13). Off by default.")

// --- Inputs ---
bool show1 = input.bool(true, "1", group = G_C, inline = "c1")
string sym1 = input.symbol("NSE:NIFTYMIDSML400", "", group = G_C, inline = "c1")
string tf1 = input.timeframe("5", "", group = G_C, inline = "c1")
bool sEma1 = input.bool(true, "EMA", group = G_C, inline = "c1")
bool sVwap1 = input.bool(true, "VWAP", group = G_C, inline = "c1")

bool show2 = input.bool(true, "2", group = G_C, inline = "c2")
string sym2 = input.symbol("NSE:NIFTY", "", group = G_C, inline = "c2")
string tf2 = input.timeframe("5", "", group = G_C, inline = "c2")
bool sEma2 = input.bool(true, "EMA", group = G_C, inline = "c2")
bool sVwap2 = input.bool(true, "VWAP", group = G_C, inline = "c2")

bool show3 = input.bool(true, "3", group = G_C, inline = "c3")
string sym3 = input.symbol("NSE:NIFTYSMLCAP250", "", group = G_C, inline = "c3")
string tf3 = input.timeframe("5", "", group = G_C, inline = "c3")
bool sEma3 = input.bool(true, "EMA", group = G_C, inline = "c3")
bool sVwap3 = input.bool(true, "VWAP", group = G_C, inline = "c3")

// --- EMA Inputs ---
bool showEma   = input.bool(true, "Show EMA on Minicharts", group = G_EMA)
int emaPeriod  = input.int(20, "EMA Period", minval = 1, group = G_EMA)
color emaColor = input.color(color.new(#ff0000, 10), "EMA Color", group = G_EMA)

// --- VWAP Inputs ---
bool showVwap   = input.bool(true, "Show VWAP on Minicharts", group = G_VWAP)
color vwapColor = input.color(color.new(color.blue, 10), "VWAP Color", group = G_VWAP)

// --- Style Inputs ---
int barsCount = input.int(20, "HTF Bars to Show", minval = 10, maxval = 60, group = G_ST)
int barSpacing = input.int(3, "Bar Spacing", minval = 3, maxval = 10, group = G_ST)
bool showBgBoxes = input.bool(true, "Show Background Frames", group = G_ST)
color bullColor = input.color(#089981, "Bull Candle", group = G_ST)
color bearColor = input.color(#f23645, "Bear Candle", group = G_ST)
int xOff = input.int(30, "Right Offset", group = G_ST)
int xGapCols = input.int(35, "Column Gap", group = G_ST)
float ySizePerc = input.float(0.15, "Chart Height (%)", group = G_ST)
float yGapRows = input.float(0.08, "Row Gap (%)", group = G_ST)
bool showTfLabels = input.bool(true, "Show Asset/TF Labels", group = G_ST)

// --- Types (helman13) ---
type BarData
    float o
    float h
    float l
    float c
    float e
    float v

type Store
    float[] oArr
    float[] hArr
    float[] lArr
    float[] cArr
    float[] eArr
    float[] vArr

// --- Data Fetching (helman13) ---
fetchData(string sId, string tf, Store s, int count) =>
    sActual = sId == "" ? syminfo.tickerid : sId

    [o0, h0, l0, c0, e0, v0, t0, o1, h1, l1, c1, e1, v1] = request.security(sActual, tf,
         [open, high, low, close, ta.ema(close, emaPeriod), ta.vwap, time, open[1], high[1], low[1], close[1], ta.ema(close, emaPeriod)[1], ta.vwap[1]],
         ignore_invalid_symbol = true)

    tfChanged = ta.change(t0) != 0
    if not na(t0) and tfChanged
        array.unshift(s.oArr, o1)
        array.unshift(s.hArr, h1)
        array.unshift(s.lArr, l1)
        array.unshift(s.cArr, c1)
        array.unshift(s.eArr, nz(e1))
        array.unshift(s.vArr, nz(v1))

        if array.size(s.oArr) > count
            array.pop(s.oArr)
            array.pop(s.hArr)
            array.pop(s.lArr)
            array.pop(s.cArr)
            array.pop(s.eArr)
            array.pop(s.vArr)

    array<BarData> bars = array.new<BarData>()
    if not na(t0)
        bars.push(BarData.new(o0, h0, l0, c0, e0, v0))
        if array.size(s.oArr) > 0
            for i = 0 to array.size(s.oArr) - 1
                bars.push(BarData.new(
                     array.get(s.oArr, i), array.get(s.hArr, i),
                     array.get(s.lArr, i), array.get(s.cArr, i),
                     array.get(s.eArr, i), array.get(s.vArr, i)))
    bars

// --- Store Initialization ---
var s1 = Store.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>())
var s2 = Store.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>())
var s3 = Store.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>())

data1 = (mm_master and show1) ? fetchData(sym1, f_effTf(tf1), s1, barsCount) : na
data2 = (mm_master and show2) ? fetchData(sym2, f_effTf(tf2), s2, barsCount) : na
data3 = (mm_master and show3) ? fetchData(sym3, f_effTf(tf3), s3, barsCount) : na

// --- Global Context for Positioning ---
float g_fullH = ta.highest(high, 300)
float g_fullL = ta.lowest(low, 300)
float g_atr   = ta.atr(14)

// --- Drawing Arrays ---
var box[]   boxArr  = array.new<box>()
var line[]  lineArr = array.new<line>()
var label[] lblArr  = array.new<label>()

// --- Render Function (helman13) ---
renderMini(array<BarData> bars, int col, int row, string tfName, string sName, bool useEma, bool useVwap) =>
    if not na(bars) and array.size(bars) > 0
        float fullH = g_fullH
        float fullL = g_fullL
        float fullR = fullH - fullL
        if na(fullR) or fullR < (g_atr * 3)
            fullR := nz(g_atr * 3, syminfo.mintick * 100)

        float uH = fullR * ySizePerc
        float bY = fullH - (row - 1) * (uH + fullR * yGapRows) - uH
        int n = array.size(bars), cW = (barsCount - 1) * barSpacing
        int xS = bar_index + xOff + (col - 1) * (cW + xGapCols), xE = xS + cW

        if showBgBoxes
            array.push(boxArr, box.new(xS - barSpacing, bY + uH, xE + barSpacing + 5, bY,
                 bgcolor = color.new(color.gray, 95), border_color = color.new(color.gray, 80)))

        float dMax = -1.0e10, float dMin = 1.0e10
        for i = 0 to n - 1
            bv = array.get(bars, i)
            dMax := math.max(dMax, nz(bv.h, dMax))
            dMin := math.min(dMin, nz(bv.l, dMin))

        float diff = dMax - dMin
        float dR = diff <= 0 ? syminfo.mintick : diff * 1.25
        float sB = ((dMax + dMin) / 2) - (dR / 2)
        int bHW = math.max(1, int(barSpacing * 0.35))

        // --- Candles ---
        for i = 0 to n - 1
            b = array.get(bars, i)
            int p = n-1-i, x = xS + p*barSpacing
            color c = b.c >= b.o ? bullColor : bearColor
            array.push(lineArr, line.new(x, bY+(b.h-sB)/dR*uH, x, bY+(b.l-sB)/dR*uH, color = c))
            array.push(boxArr, box.new(x-bHW, bY+(math.max(b.o,b.c)-sB)/dR*uH, x+bHW, bY+(math.min(b.o,b.c)-sB)/dR*uH, bgcolor = c, border_color = c))

        // --- EMA ---
        if showEma and useEma and n > 1
            for i = 0 to n - 2
                b1 = array.get(bars, i), b2 = array.get(bars, i + 1)
                if not na(b1.e) and not na(b2.e)
                    x1 = xS + (n-1-i) * barSpacing, x2 = xS + (n-1-(i+1)) * barSpacing
                    y1 = bY + math.max(0.0, math.min(1.0, (b1.e - sB) / dR)) * uH
                    y2 = bY + math.max(0.0, math.min(1.0, (b2.e - sB) / dR)) * uH
                    array.push(lineArr, line.new(x1, y1, x2, y2, color = emaColor, width = 1))

        // --- VWAP ---
        if showVwap and useVwap and n > 1
            for i = 0 to n - 2
                b1 = array.get(bars, i), b2 = array.get(bars, i + 1)
                if not na(b1.v) and not na(b2.v)
                    x1 = xS + (n-1-i) * barSpacing, x2 = xS + (n-1-(i+1)) * barSpacing
                    y1 = bY + math.max(0.0, math.min(1.0, (b1.v - sB) / dR)) * uH
                    y2 = bY + math.max(0.0, math.min(1.0, (b2.v - sB) / dR)) * uH
                    array.push(lineArr, line.new(x1, y1, x2, y2, color = vwapColor, width = 1))

        if showTfLabels
            array.push(lblArr, label.new(xS + cW / 2, bY, sName + " (" + tfName + ")", color = #00000000, textcolor = color.gray, style = label.style_label_down, size = size.small))



// === STRONG START (Gap + Hold) CALCULATION ===
// This indicator runs on intraday charts, so unlike DTC AIO (which reads open/close[1]
// directly off a daily bar), the "day's low so far" has to be tracked bar-by-bar as it
// forms rather than read off a single daily candle.
bool ss_new_day = ta.change(time("D")) != 0
var float ss_prev_close = na
var float ss_day_low    = na
var bool  ss_gapped_up  = false
var bool  ss_label_done = false

if ss_new_day
    ss_prev_close := close[1]
    ss_day_low    := low
    ss_gapped_up  := not na(close[1]) and open > close[1]
    ss_label_done := false
else
    ss_day_low := na(ss_day_low) ? low : math.min(ss_day_low, low)

bool ss_held_gap        = not na(ss_prev_close) and ss_day_low >= ss_prev_close * (1 - ss_gap_tol / 100)
bool ss_strong_start_now = ss_enabled and ss_gapped_up and ss_held_gap

// One label per qualifying day, drawn the moment the hold criterion is met — permanent
// afterward. Intraday-only: on daily/weekly charts every historical qualifying day would
// get its own label, stacking into clutter (the table's Strong Start row still reflects
// the current value on any timeframe).
if ss_enabled and ss_show_label and ss_strong_start_now and not ss_label_done and timeframe.isintraday
    label.new(bar_index, low, text="Strong Start", style=label.style_label_up,
      color=color.new(ss_color, 0), textcolor=color.black, size=size.small)
    ss_label_done := true

// === MINICHARTS MULTI MARKET — CLEAR AND DRAW (helman13) ===
// All previously drawn boxes/lines/labels are cleared and the three mini panels are
// redrawn on the last bar in a single stacked column. Gated on the master toggle so the
// dashboard is unaffected when the panel is off.
if mm_master and barstate.islast
    for b in boxArr
        box.delete(b)
    array.clear(boxArr)
    for l in lineArr
        line.delete(l)
    array.clear(lineArr)
    for lb in lblArr
        label.delete(lb)
    array.clear(lblArr)

    renderMini(data1, 1, 1, f_effTf(tf1), sym1, sEma1, sVwap1)
    renderMini(data2, 1, 2, f_effTf(tf2), sym2, sEma2, sVwap2)
    renderMini(data3, 1, 3, f_effTf(tf3), sym3, sEma3, sVwap3)

// === PLOTTING ===
// Plot moving averages
plot(ma10, "MA 10", color=ma10_theme_color, linewidth=ma10_width)
plot(ma20, "MA 20", color=ma20_theme_color, linewidth=ma20_width)
plot(ma50, "MA 50", color=ma50_theme_color, linewidth=ma50_width)
plot(ma200, "MA 200", color=ma200_theme_color, linewidth=ma200_width)

// Plot VWAP if enabled
plot(show_vwap ? vwap : na, "VWAP", color=vwap_theme_color, linewidth=vwap_width)

// === DAILY DIVIDERS ===
// Daily divider logic - using conditional plotting to avoid local scope issues
day = dayofweek
showDividers = show_daily_dividers and timeframe.isintraday and timeframe.in_seconds(timeframe.period) < 14400
newDay = day != day[1] and showDividers

// Plot daily divider labels using conditional plotting
plotshape(newDay and day == 1, "Sunday", shape.labeldown, location.top, na, text="Sunday", textcolor=tableText, size=size.tiny, display=display.all - display.status_line, editable=false)
plotshape(newDay and day == 2, "Monday", shape.labeldown, location.top, na, text="Monday", textcolor=tableText, size=size.tiny, display=display.all - display.status_line, editable=false)
plotshape(newDay and day == 3, "Tuesday", shape.labeldown, location.top, na, text="Tuesday", textcolor=tableText, size=size.tiny, display=display.all - display.status_line, editable=false)
plotshape(newDay and day == 4, "Wednesday", shape.labeldown, location.top, na, text="Wednesday", textcolor=tableText, size=size.tiny, display=display.all - display.status_line, editable=false)
plotshape(newDay and day == 5, "Thursday", shape.labeldown, location.top, na, text="Thursday", textcolor=tableText, size=size.tiny, display=display.all - display.status_line, editable=false)
plotshape(newDay and day == 6, "Friday", shape.labeldown, location.top, na, text="Friday", textcolor=tableText, size=size.tiny, display=display.all - display.status_line, editable=false)
plotshape(newDay and day == 7, "Saturday", shape.labeldown, location.top, na, text="Saturday", textcolor=tableText, size=size.tiny, display=display.all - display.status_line, editable=false)

// === VOLUME CANDLE COLORING ===
// Fill candles with volume colors
barcolor(volume_color)

// === ALERTS ===
// MA Crossovers
ma10_cross_above_ma20 = ta.crossover(ma10, ma20)
ma10_cross_below_ma20 = ta.crossunder(ma10, ma20)
ma20_cross_above_ma50 = ta.crossover(ma20, ma50)
ma20_cross_below_ma50 = ta.crossunder(ma20, ma50)

// Price vs MA alerts
price_above_ma200 = close > ma200
price_below_ma200 = close < ma200

// === TABLE STYLE (matched to DTC AIO) ===
// Fully transparent — no cell fills, no zebra stripes, no border. Label left-aligned,
// value right-aligned in its own column so the numbers line up regardless of label
// length, same clean/transparent look as DTC AIO's dashboard table.
f_row(table _t, int row, string label, string val, color valColor) =>
    table.cell(_t, 0, row, label, text_color=tableText, bgcolor=tableBg1, text_halign=text.align_left, text_size=size.small)
    table.cell(_t, 1, row, val, text_color=valColor, bgcolor=tableBg1, text_halign=text.align_right, text_size=size.small)

// === TABLE DISPLAY ===
if barstate.islast and (show_rvol or show_adr or show_burst or ss_enabled)
    var table info_table = table.new(get_table_position(table_position), 2, 10, bgcolor=color.new(color.black, 100), border_width=0)

    table.cell(info_table, 0, 0, "⚡ DTC Intra+", text_color=tableHeaderText, bgcolor=tableHeaderBg, text_halign=text.align_left, text_size=size.normal)
    table.cell(info_table, 1, 0, "", bgcolor=tableHeaderBg)
    table.merge_cells(info_table, 0, 0, 1, 0)
    int r = 1

    // RVol Information
    if show_rvol
        color rvol_val_color = rvol > 100 ? veryPositiveColor : tableText
        f_row(info_table, r, "RVol", str.tostring(rvol, "#.#") + "%", rvol_val_color)
        r += 1

    // ADR Information
    if show_adr
        f_row(info_table, r, "D ADR", str.tostring(adr_percent, "#.##") + "%", tableText)
        r += 1

    // Burst Information
    if show_burst
        string burst_label = "Switch to 1D"
        color burst_val_color = tableText
        if timeframe.isdaily
            if burst_power_score >= 15
                burst_label := "GREAT"
                burst_val_color := veryPositiveColor
            else if burst_power_score >= 8
                burst_label := "GOOD"
                burst_val_color := stage13Color
            else
                burst_label := "LOW"
        f_row(info_table, r, "Burst", burst_label, burst_val_color)
        r += 1

    // Sector / Industry Information
    f_row(info_table, r, "Sector", syminfo.sector, tableText)
    r += 1
    f_row(info_table, r, "Industry", syminfo.industry, tableText)
    r += 1

    // Theme Information (when enabled)
    if showThemeInfo
        string current_theme = themeMode == 'Auto' ? (isDark ? 'Auto (Dark)' : 'Auto (Light)') : themeMode
        f_row(info_table, r, "Theme", current_theme, tableText)
        r += 1

    // Current Session Information
    if enable_intraday_sessions
        string current_session = "N/A"
        if in_session1
            current_session := session1_label
        else if in_session2
            current_session := session2_label
        else if in_session3
            current_session := session3_label
        f_row(info_table, r, "Session", current_session, tableText)
        r += 1

    // Strong Start Information
    if ss_enabled
        color ss_val_color = ss_strong_start_now ? veryPositiveColor : tableText
        f_row(info_table, r, "Strong Start", ss_strong_start_now ? "Yes 🔥" : "No", ss_val_color)
        r += 1
