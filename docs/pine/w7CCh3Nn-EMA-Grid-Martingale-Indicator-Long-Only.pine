//@version=5
indicator("EMA Grid + Martingale Indicator (Long-Only)", overlay=true)

// ── INPUTS ─────────────────────────────────────────────────────────────
ema1Len      = input.int(10,   "EMA 1 Length (Fast Group 1)",    minval=1,  maxval=50)
ema2Len      = input.int(20,   "EMA 2 Length (Slow Group 1)",    minval=1,  maxval=100)
ema3Len      = input.int(50,   "EMA 3 Length (Fast Group 2)",    minval=1,  maxval=200)
ema4Len      = input.int(100,  "EMA 4 Length (Slow Group 2)",    minval=1,  maxval=300)

maxEntries   = input.int(5,    "Max Grid Entries",               minval=1,  maxval=10)
gridStepPips = input.int(20,   "Grid Step (pips)",               minval=1,  maxval=100)
baseSize     = input.float(0.1,"Base Order Size",                minval=0.001, maxval=10)
useMG        = input.bool(true,"Use Martingale Sizing")
mgFactor     = input.float(2.0,"Martingale Factor",              minval=1.0, maxval=5.0)

closeAtW     = input.bool(true, "Close at Weighted Price")
bufferPips   = input.int(0,     "Close Buffer (pips)",           minval=0,  maxval=50)

// ── PRICE STEP CALCS ──────────────────────────────────────────────────
tickSize    = syminfo.mintick
pipValue    = tickSize * 10
stepPrice   = gridStepPips * pipValue
bufferPrice = bufferPips   * pipValue

// ── EMAs & BUY SIGNAL ─────────────────────────────────────────────────
e1 = ta.ema(close, ema1Len)
e2 = ta.ema(close, ema2Len)
e3 = ta.ema(close, ema3Len)
e4 = ta.ema(close, ema4Len)

grp1Bull  = e1 > e2
grp2Bull  = e3 > e4
buySignal = grp1Bull and grp2Bull and not (grp1Bull[1] and grp2Bull[1])

// ── PLOT EMAS ─────────────────────────────────────────────────────────
plot(e1, title="EMA 1", linewidth=2)
plot(e2, title="EMA 2", linewidth=2)
plot(e3, title="EMA 3", linewidth=2)
plot(e4, title="EMA 4", linewidth=2)

// ── STATE VARS ────────────────────────────────────────────────────────
var bool   inGrid         = false
var int    entryCount     = 0
var float  lastEntryPrice = na
var float  cumCost        = 0.0
var float  cumQty         = 0.0

// ── OPEN INITIAL GRID LEG ─────────────────────────────────────────────
if buySignal and not inGrid
    inGrid         := true
    entryCount     := 1
    lastEntryPrice := close
    size            = baseSize
    cumCost        := size * close
    cumQty         := size
    label.new(bar_index, low,  "L1",
              yloc=yloc.belowbar,
              style=label.style_label_up,
              color=color.green,
              textcolor=color.white)

// ── ADDITIONAL GRID ENTRIES ────────────────────────────────────────────
if inGrid and entryCount < maxEntries and low <= lastEntryPrice - stepPrice
    entryCount     += 1
    lastEntryPrice := close
    size            = useMG ? baseSize * math.pow(mgFactor, entryCount - 1) : baseSize
    cumCost        += size * close
    cumQty         += size
    label.new(bar_index, low, "L" + str.tostring(entryCount),
              yloc=yloc.belowbar,
              style=label.style_label_up,
              color=color.green,
              textcolor=color.white)

// ── WEIGHTED-AVERAGE CLOSE ─────────────────────────────────────────────
if closeAtW and inGrid
    avgPrice = cumCost / cumQty
    if high >= avgPrice + bufferPrice
        label.new(bar_index, high, "Exit",
                  yloc=yloc.abovebar,
                  style=label.style_label_down,
                  color=color.green,
                  textcolor=color.white)
        inGrid     := false
        entryCount := 0
        cumCost    := 0.0
        cumQty     := 0.0