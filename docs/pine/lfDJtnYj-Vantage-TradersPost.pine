// PHASE 2: CORE ORDER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// @function Send advanced order with comprehensive parameter validation and JSON construction
// @param ticker Symbol to trade (defaults to syminfo.ticker)
// @param action Order action (buy/sell/exit/cancel/add)
// @param quantity Order quantity
// @param quantityType Type of quantity (fixed/dollar/percent)
// @param orderType Type of order (market/limit/stop/stop_limit/trailing_stop)
// @param sentiment Position sentiment (long/short/flat, optional)
// @param limitPrice Limit price for limit orders
// @param stopPrice Stop price for stop orders
// @param trailAmount Trailing amount for trailing stops
// @param trailPercent Trailing percent for trailing stops
// @param takeProfitPrice Take profit limit price (absolute)
// @param takeProfitAmount Take profit dollar amount (relative)
// @param takeProfitPercent Take profit percentage (relative)
// @param stopLossPrice Stop loss price (absolute)
// @param stopLossAmount Stop loss dollar amount (relative)
// @param stopLossPercent Stop loss percentage (relative)
// @param stopLossType Stop loss order type
// @param stopLossLimitPrice Limit price for stop_limit orders
// @param cancel Controls order cancellation (true = cancel existing, false = don't cancel, na = use defaults)
// @param extendedHours Enable extended hours trading (boolean)
// @param optionType Option type for options trading (both/call/put)
// @param intrinsicValue Intrinsic value filter for options (itm/otm)
// @param expiration Option expiration (date string)
// @param strikePrice Option strike price
// @param signalPrice The market price at alert time (for slippage tracking)
// @param comment Optional comment for the order (shows in TradersPost UI for debugging)
// @returns ErrorResponse with success status and JSON or error details
export SendAdvancedOrder(
     string ticker = na,
     Action action = Action.buy,
     float quantity = na,
     QuantityType quantityType = QuantityType.fixed,
     OrderType orderType = OrderType.market,
     Sentiment sentiment = na,
     bool cancel = false,
     float limitPrice = na,
     float stopPrice = na,
     float trailAmount = na,
     float trailPercent = na,
     float takeProfitPrice = na,
     float takeProfitAmount = na,
     float takeProfitPercent = na,
     float stopLossPrice = na,
     float stopLossAmount = na,
     float stopLossPercent = na,
     StopLossType stopLossType = StopLossType.stop,
     float stopLossLimitPrice = na,
     bool extendedHours = false,
     OptionType optionType = na,
     IntrinsicValue intrinsicValue = na,
     string expiration = na,
     float strikePrice = na,
     float signalPrice = na,
     string comment = na) =>
    
    // Initialize with success state - JSON will always be in message
    rval = ErrorResponse.new(true, array.new<string>(), "")

    _ticker = ticker
    if na(_ticker)
        _ticker := syminfo.ticker

    // Step 1: Comprehensive parameter validation
    if rval.success
        validationResponse = ValidateCompleteOrder(
             _ticker, action, quantity, quantityType, orderType,
             limitPrice, stopPrice, takeProfitPrice
         )

        if not validationResponse.success
            // Validation failed - copy error details
            rval.success := false
            rval.message := validationResponse.message
            rval.errors := validationResponse.errors

    // Step 2: Construct JSON using validated parameters
    if rval.success
        jsonResponse = _validateAndBuildJSON(
             _ticker, action, quantity, quantityType, orderType, sentiment,
             cancel, na,
             limitPrice, stopPrice, trailAmount, trailPercent,
             takeProfitPrice, takeProfitAmount, takeProfitPercent,
             stopLossPrice, stopLossAmount, stopLossPercent,
             stopLossType, stopLossLimitPrice,
             extendedHours, optionType, intrinsicValue, expiration, strikePrice,
             signalPrice, comment
         )

        if not jsonResponse.success
            // JSON construction failed - copy error details
            rval.success := false
            rval.message := jsonResponse.message
            rval.errors := jsonResponse.errors
        else
            // Success - put JSON in message
            rval.message := jsonResponse.message

    // Step 3: Send alert to TradersPost (only if successful)
    if rval.success
        alert(rval.message, alert.freq_once_per_bar)

    rval

// @function Send sentiment-based position management order
// @param ticker Symbol to manage (defaults to syminfo.ticker)
// @param sentiment Target position sentiment (long/short/flat)
// @param quantity Position size (optional, uses account default if not specified)
// @param quantityType Type of quantity specification
// @param signalPrice The market price at alert time (for slippage tracking)
// @param comment Optional comment
// @returns ErrorResponse with success status
export SendSentiment(
     string ticker = na,
     Sentiment sentiment,
     float quantity = na,
     QuantityType quantityType = QuantityType.fixed,
     float signalPrice = na,
     string comment = na) =>
    
    ErrorResponse rval = na
    
    // Validate required sentiment parameter
    if na(sentiment)
        response = ErrorResponse.new(false, array.new<string>(), "Sentiment is required")
        array.push(response.errors, "Sentiment cannot be na for position management")
        rval := response
    
    if na(rval)
        // Determine action based on sentiment
        action = switch sentiment
            Sentiment.long => Action.buy
            Sentiment.short => Action.sell
            Sentiment.flat => Action.exit
            => Action.buy  // default
        
        // Send order with sentiment specified
        rval := SendAdvancedOrder(
             ticker = ticker,
             action = action,
             quantity = quantity,
             quantityType = quantityType,
             orderType = OrderType.market,
             sentiment = sentiment,
             signalPrice = signalPrice,
             comment = comment
         )
    
    rval

// @function Cancel all open orders for the specified symbol
// @param ticker Symbol to cancel orders for (defaults to syminfo.ticker)
// @param comment Optional comment for the cancellation
// @returns ErrorResponse with success status
export SendCancelAll(
     string ticker = na,
     string comment = na) =>
    
    // Send cancel action order (minimal parameters needed for cancel)
    SendAdvancedOrder(
         ticker = ticker,
         action = Action.cancel,
         quantity = na,
         quantityType = QuantityType.fixed,
         orderType = OrderType.market,  // Order type not relevant for cancel
         comment = comment
     )

// @function Send order without canceling existing orders
// @param ticker Symbol to trade (defaults to syminfo.ticker)
// @param action Order action (buy/sell/exit)
// @param quantity Order quantity
// @param quantityType Type of quantity (fixed/dollar/percent)
// @param orderType Type of order (market/limit/stop/stop_limit)
// @param limitPrice Limit price for limit orders
// @param stopPrice Stop price for stop orders
// @param sentiment Position sentiment (long/short/flat, optional)
// @param takeProfitPrice Take profit price
// @param takeProfitAmount Take profit amount (optional)
// @param stopLossPrice Stop loss price
// @param stopLossAmount Stop loss amount (optional)
// @param stopLossPercent Stop loss percentage (optional)
// @param stopLossType Stop loss order type
// @param stopLossLimitPrice Limit price for stop_limit orders
// @param signalPrice The market price at alert time (for slippage tracking)
// @param comment Optional comment
// @returns ErrorResponse with success status
export SendOrderNoCancelExisting(
     string ticker = na,
     Action action = Action.buy,
     float quantity = na,
     QuantityType quantityType = QuantityType.fixed,
     OrderType orderType = OrderType.market,
     Sentiment sentiment = na,
     float limitPrice = na,
     float stopPrice = na,
     float takeProfitPrice = na,
     float takeProfitAmount = na,
     float takeProfitPercent = na,
     float stopLossPrice = na,
     float stopLossAmount = na,
     float stopLossPercent = na,
     StopLossType stopLossType = StopLossType.stop,
     float stopLossLimitPrice = na,
     float signalPrice = na,
     string comment = na) =>
    
    // Send order with cancel explicitly set to false (don't cancel existing orders)
    SendAdvancedOrder(
         ticker = ticker,
         action = action,
         quantity = quantity,
         quantityType = quantityType,
         orderType = orderType,
         sentiment = sentiment,
         cancel = false,  // Key feature: prevents canceling existing orders
         limitPrice = limitPrice,
         stopPrice = stopPrice,
         takeProfitPrice = takeProfitPrice,
         takeProfitAmount = takeProfitAmount,
         takeProfitPercent = takeProfitPercent,
         stopLossPrice = stopLossPrice,
         stopLossAmount = stopLossAmount,
         stopLossPercent = stopLossPercent,
         stopLossType = stopLossType,
         stopLossLimitPrice = stopLossLimitPrice,
         signalPrice = signalPrice,
         comment = comment
     )

// ═══════════════════════════════════════════════════════════════════════════════
// PHASE 2.2: BRACKET ORDER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// @function Build bracket order parameters by routing entryPrice to correct parameter based on orderType
// This helper function maps the conceptual "entryPrice" to the technical parameters needed
// @param orderType The order type for the entry order
// @param entryPrice The desired entry price (trigger for stops, limit for limits)
// @param entryLimitPrice The limit price for stop_limit orders (optional)
// @returns [limitPrice, stopPrice] array with correct routing
export _buildBracketOrderParams(OrderType orderType, float entryPrice = na, float entryLimitPrice = na) =>
    float limitPrice = na
    float stopPrice = na

    if not na(entryPrice)
        switch orderType
            OrderType.market =>
                // Market orders don't use entry price - will be ignored
                limitPrice := na
                stopPrice := na
            OrderType.limit =>
                // Limit orders use entryPrice as limitPrice
                limitPrice := entryPrice
                stopPrice := na
            OrderType.stop =>
                // Stop orders use entryPrice as stopPrice (becomes market order when triggered)
                limitPrice := na
                stopPrice := entryPrice
            OrderType.stop_limit =>
                // Stop limit orders use entryPrice as stopPrice and entryLimitPrice as limitPrice
                // If entryLimitPrice is na, add small buffer to ensure limitPrice > stopPrice for buy orders
                limitPrice := na(entryLimitPrice) ? entryPrice * 1.001 : entryLimitPrice
                stopPrice := entryPrice

    [limitPrice, stopPrice]

// @function Send bracket order (entry + take profit + stop loss)
// @param ticker Symbol to trade
// @param action Entry action (buy/sell)
// @param quantity Order quantity
// @param quantityType Type of quantity specification
// @param orderType Type of entry order
// @param entryPrice Entry price (trigger price for stop orders, limit price for limit orders)
// @param entryLimitPrice Entry limit price (only for stop_limit orders, defaults to entryPrice if na)
// @param takeProfitPrice Take profit price
// @param stopLossPrice Stop loss price
// @param takeProfitAmount Take profit dollar amount (alternative to price)
// @param takeProfitPercent Take profit percentage (alternative to price)
// @param stopLossAmount Stop loss dollar amount (alternative to price)
// @param stopLossPercent Stop loss percentage (alternative to price)
// @param stopLossType Stop loss order type
// @param stopLossLimitPrice Limit price for stop_limit orders
// @param signalPrice The market price at alert time (for slippage tracking)
// @param comment Optional comment
// @returns ErrorResponse with success status
export SendBracketOrder(
     string ticker = na,
     Action action = Action.buy,
     float quantity = na,
     QuantityType quantityType = QuantityType.fixed,
     OrderType orderType = OrderType.market,
     float entryPrice = na,
     float entryLimitPrice = na,
     float takeProfitPrice = na,
     float stopLossPrice = na,
     float takeProfitAmount = na,
     float takeProfitPercent = na,
     float stopLossAmount = na,
     float stopLossPercent = na,
     StopLossType stopLossType = StopLossType.stop,
     float stopLossLimitPrice = na,
     float signalPrice = na,
     string comment = na) =>
    
    ErrorResponse rval = na
    
    // Validate bracket order requirements
    if na(takeProfitPrice) and na(takeProfitAmount)
        response = ErrorResponse.new(false, array.new<string>(), "Bracket order requires take profit")
        array.push(response.errors, "Must specify either takeProfitPrice or takeProfitAmount")
        rval := response
    
    if na(rval) and na(stopLossPrice) and na(stopLossAmount)
        response = ErrorResponse.new(false, array.new<string>(), "Bracket order requires stop loss")
        array.push(response.errors, "Must specify either stopLossPrice or stopLossAmount")
        rval := response
    
    // Validate price relationships for bracket orders
    if na(rval) and not na(entryPrice) and not na(takeProfitPrice) and not na(stopLossPrice)
        priceValidation = ValidatePrices(entryPrice, stopLossPrice, takeProfitPrice, action)
        if not priceValidation.success
            rval := priceValidation
    
    // Send the bracket order
    if na(rval)
        // Route entryPrice to correct parameter based on orderType
        [bracketLimitPrice, bracketStopPrice] = _buildBracketOrderParams(orderType, entryPrice, entryLimitPrice)

        // Map trailing stop parameters correctly
        trailAmountParam = stopLossType == StopLossType.trailing_stop ? stopLossAmount : na
        trailPercentParam = stopLossType == StopLossType.trailing_stop ? stopLossPercent : na
        stopLossAmountParam = stopLossType == StopLossType.trailing_stop ? na : stopLossAmount
        stopLossPercentParam = stopLossType == StopLossType.trailing_stop ? na : stopLossPercent

        rval := SendAdvancedOrder(
         ticker = ticker,
         action = action,
         quantity = quantity,
         quantityType = quantityType,
         orderType = orderType,
         sentiment = na,
         cancel = false,  // Use default cancel behavior (no cancel)
         limitPrice = bracketLimitPrice,
         stopPrice = bracketStopPrice,
         trailAmount = trailAmountParam,
         trailPercent = trailPercentParam,
         takeProfitPrice = takeProfitPrice,
         takeProfitAmount = takeProfitAmount,
         takeProfitPercent = takeProfitPercent,
         stopLossPrice = stopLossPrice,
         stopLossAmount = stopLossAmountParam,
         stopLossPercent = stopLossPercentParam,
         stopLossType = stopLossType,
         stopLossLimitPrice = stopLossLimitPrice,
         signalPrice = signalPrice,
         comment = comment
         )
    
    rval

// @function Send One-Triggers-Other (OTO) order sequence
// Note: OTO linking must be configured in TradersPost strategy settings
// This sends two separate orders - TradersPost handles the OTO logic
// @param primaryTicker Primary order ticker
// @param primaryAction Primary order action
// @param primaryQuantity Primary order quantity
// @param primaryOrderType Primary entry type
// @param primaryPrice Primary order price
// @param secondaryTicker Secondary order ticker (defaults to primary ticker)
// @param secondaryAction Secondary order action
// @param secondaryQuantity Secondary order quantity
// @param secondaryOrderType Secondary entry type
// @param secondaryPrice Secondary order price
// @param signalPrice The market price at alert time (for slippage tracking)
// @param comment Optional comment for both orders
// @returns ErrorResponse with success status
export SendOTOOrder(
     string primaryTicker = na,
     Action primaryAction = Action.buy,
     float primaryQuantity = na,
     OrderType primaryOrderType = OrderType.market,
     float primaryPrice = na,
     string secondaryTicker = na,
     Action secondaryAction = Action.sell,
     float secondaryQuantity = na,
     OrderType secondaryOrderType = OrderType.limit,
     float secondaryPrice = na,
     float signalPrice = na,
     string comment = na) =>
    
    ErrorResponse rval = na
    
    // Send primary order first
    primaryResponse = SendAdvancedOrder(
         ticker = primaryTicker,
         action = primaryAction,
         quantity = primaryQuantity,
         orderType = primaryOrderType,
         limitPrice = primaryPrice,
         signalPrice = signalPrice,
         comment = na(comment) ? "OTO Primary" : comment + " [OTO Primary]"
     )
    
    if not primaryResponse.success
        // Primary order failed, don't send secondary
        rval := primaryResponse
    
    if na(rval)
        // Send secondary order
        secondaryResponse = SendAdvancedOrder(
             ticker = na(secondaryTicker) ? primaryTicker : secondaryTicker,
             action = secondaryAction,
             quantity = na(secondaryQuantity) ? primaryQuantity : secondaryQuantity,
             orderType = secondaryOrderType,
             limitPrice = secondaryPrice,
             signalPrice = signalPrice,
             comment = na(comment) ? "OTO Secondary" : comment + " [OTO Secondary]"
         )
        
        if not secondaryResponse.success
            // Secondary order failed - ideally would cancel primary, but TradersPost handles this
            combinedResponse = ErrorResponse.new(false, array.new<string>(), "OTO order partially failed")
            array.push(combinedResponse.errors, "Primary order sent successfully")
            array.push(combinedResponse.errors, "Secondary order failed: " + secondaryResponse.message)
            rval := combinedResponse
        else
            // Both orders successful
            successResponse = ErrorResponse.new(true, array.new<string>(), "OTO order sequence sent successfully")
            array.push(successResponse.errors, "Primary: " + primaryResponse.message)
            array.push(successResponse.errors, "Secondary: " + secondaryResponse.message)
            rval := successResponse
    
    rval

// @function Send One-Cancels-Other (OCO) order pair
// Note: OCO linking must be configured in TradersPost strategy settings
// This sends two separate orders - TradersPost handles the OCO logic
// @param ticker Symbol for both orders
// @param firstAction Action for first order
// @param firstQuantity Quantity for first order
// @param firstOrderType Order type for first order
// @param firstPrice Price for first order
// @param secondAction Action for second order
// @param secondQuantity Quantity for second order
// @param secondOrderType Order type for second order
// @param secondPrice Price for second order
// @param signalPrice The market price at alert time (for slippage tracking)
// @param comment Optional comment
// @returns ErrorResponse with success status
export SendOCOOrder(
     string ticker = na,
     Action firstAction = Action.buy,
     float firstQuantity = na,
     OrderType firstOrderType = OrderType.limit,
     float firstPrice = na,
     Action secondAction = Action.buy,
     float secondQuantity = na,
     OrderType secondOrderType = OrderType.stop,
     float secondPrice = na,
     float signalPrice = na,
     string comment = na) =>
    
    ErrorResponse rval = na
    ErrorResponse firstResponse = na
    
    // Validate that we have different order types/prices
    if firstOrderType == secondOrderType and firstPrice == secondPrice
        response = ErrorResponse.new(false, array.new<string>(), "OCO orders must be different")
        array.push(response.errors, "OCO orders cannot have identical type and price")
        rval := response
    
    if na(rval)
        // Send first order
        firstResponse := SendAdvancedOrder(
             ticker = ticker,
             action = firstAction,
             quantity = firstQuantity,
             orderType = firstOrderType,
             limitPrice = firstOrderType == OrderType.limit ? firstPrice : na,
             stopPrice = firstOrderType == OrderType.stop or firstOrderType == OrderType.stop_limit ? firstPrice : na,
             signalPrice = signalPrice,
             comment = na(comment) ? "OCO A" : comment + " [OCO A]"
         )
        
        if not firstResponse.success
            rval := firstResponse
    
    if na(rval)
        // Send second order
        secondResponse = SendAdvancedOrder(
             ticker = ticker,
             action = secondAction,
             quantity = na(secondQuantity) ? firstQuantity : secondQuantity,
             orderType = secondOrderType,
             limitPrice = secondOrderType == OrderType.limit ? secondPrice : na,
             stopPrice = secondOrderType == OrderType.stop or secondOrderType == OrderType.stop_limit ? secondPrice : na,
             signalPrice = signalPrice,
             comment = na(comment) ? "OCO B" : comment + " [OCO B]"
         )
        
        if not secondResponse.success
            // Second order failed - first order already sent
            combinedResponse = ErrorResponse.new(false, array.new<string>(), "OCO order partially failed")
            array.push(combinedResponse.errors, "First order sent successfully")
            array.push(combinedResponse.errors, "Second order failed: " + secondResponse.message)
            rval := combinedResponse
        else
            // Both orders successful
            successResponse = ErrorResponse.new(true, array.new<string>(), "OCO order pair sent successfully")
            array.push(successResponse.errors, "First: " + firstResponse.message)
            array.push(successResponse.errors, "Second: " + secondResponse.message)
            rval := successResponse
    
    rval