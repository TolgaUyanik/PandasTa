//@version=5
indicator("Premarket High/Low Lines", overlay=true, max_lines_count=2)

myTZ = "America/New_York"
inPremkt = not na(time(timeframe.period, "0400-0930:1234567", myTZ))
newDay   = ta.change(time("D", myTZ)) != 0

// Track today's premarket high/low
var float preHigh = na
var float preLow  = na

if newDay
    preHigh := na
    preLow  := na

if inPremkt
    preHigh := na(preHigh) ? high : math.max(preHigh, high)
    preLow  := na(preLow)  ? low  : math.min(preLow, low)

// Draw lines after premarket ends, and keep them until reset next day
var line highLine = na
var line lowLine  = na

showLines = not inPremkt and not na(preHigh) and not na(preLow)

if showLines and barstate.isconfirmed
    if na(highLine)
        highLine := line.new(bar_index, preHigh, bar_index + 1, preHigh, color=color.red, width=2, extend=extend.right, style=line.style_dashed)
    else
        line.set_xy1(highLine, bar_index, preHigh)
        line.set_xy2(highLine, bar_index + 1, preHigh)
    if na(lowLine)
        lowLine := line.new(bar_index, preLow, bar_index + 1, preLow, color=color.red, width=2, extend=extend.right, style=line.style_dashed)
    else
        line.set_xy1(lowLine, bar_index, preLow)
        line.set_xy2(lowLine, bar_index + 1, preLow)
else
    if not showLines
        if not na(highLine)
            line.delete(highLine)
        if not na(lowLine)
            line.delete(lowLine)
        highLine := na
        lowLine := na