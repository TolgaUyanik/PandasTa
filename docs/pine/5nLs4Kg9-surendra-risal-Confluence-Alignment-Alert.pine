//@version=6
indicator('Confluence Alignment Alert', overlay = true)

// ============================================================
// CONFLUENCE ALIGNMENT ALERT
// Fires when trend, momentum, oscillator, and volume all agree
// on the same direction (bullish or bearish) on the same bar.
//
// NOTE: This uses standard, well-known indicators (EMA, MACD,
// Stochastic, Volume momentum) as stand-ins for your custom
// panels. If your chart's indicators are custom-coded, swap the
// calculation blocks below with your actual formulas/sources so
// the thresholds match exactly what you were looking at.
// ============================================================

// ---------- Inputs ----------
fastLen = input.int(9, 'Fast EMA Length')
slowLen = input.int(21, 'Slow EMA Length')

macdFast = input.int(12, 'MACD Fast')
macdSlow = input.int(26, 'MACD Slow')
macdSig = input.int(9, 'MACD Signal')

stochLen = input.int(14, 'Stochastic Length')
stochOB = input.int(70, 'Stochastic Overbought')
stochOS = input.int(30, 'Stochastic Oversold')

volLen = input.int(20, 'Volume MA Length')

minAgree = input.int(4, 'Minimum Indicators Required to Agree (of 4)', minval = 1, maxval = 4)

// ---------- 1. Trend: EMA cross/slope ----------
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
trendUp = fastEMA > slowEMA and fastEMA > fastEMA[1]
trendDown = fastEMA < slowEMA and fastEMA < fastEMA[1]

// ---------- 2. Momentum: MACD histogram ----------
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSig)
macdUp = histLine > 0 and histLine > histLine[1]
macdDown = histLine < 0 and histLine < histLine[1]

// ---------- 3. Oscillator: Stochastic turning ----------
k = ta.sma(ta.stoch(close, high, low, stochLen), 3)
stochUp = k < stochOS and k > k[1]
stochDown = k > stochOB and k < k[1]

// ---------- 4. Volume momentum ----------
volMA = ta.sma(volume, volLen)
volConfirm = volume > volMA

// ---------- Combine into confluence score ----------
bullScore = (trendUp ? 1 : 0) + (macdUp ? 1 : 0) + (stochUp ? 1 : 0) + (volConfirm ? 1 : 0)
bearScore = (trendDown ? 1 : 0) + (macdDown ? 1 : 0) + (stochDown ? 1 : 0) + (volConfirm ? 1 : 0)

bullAligned = bullScore >= minAgree
bearAligned = bearScore >= minAgree

// ---------- Plot markers ----------
plotshape(bullAligned, title = 'Bullish Confluence', location = location.belowbar, style = shape.labelup, color = color.new(color.green, 0), text = 'BUY\nConfluence', textcolor = color.white, size = size.small)

plotshape(bearAligned, title = 'Bearish Confluence', location = location.abovebar, style = shape.labeldown, color = color.new(color.red, 0), text = 'SELL\nConfluence', textcolor = color.white, size = size.small)

// ---------- Alerts ----------
alertcondition(bullAligned, title = 'Bullish Confluence Alert', message = 'EURUSD: Bullish confluence detected — trend, MACD, oscillator, and volume aligned up.')

alertcondition(bearAligned, title = 'Bearish Confluence Alert', message = 'EURUSD: Bearish confluence detected — trend, MACD, oscillator, and volume aligned down.')
