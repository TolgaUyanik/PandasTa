// V20.2: Added formatted BUY/SELL + TP/SL Alerts (emoji template, {{plot()}} placeholders)

//@version=6
indicator("Breakout Targets [AlgoAlpha] - Colorful V20", "crypto Signals (Breakout 🚀Targets)", overlay = true, behind_chart = false, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, explicit_plot_zorder = true)

// ============================================================================
// INPUTS — MAIN
// ============================================================================
len          = input.int(99,   "Range Detection Period",    group="Main Settings")
overlap      = not input.bool(true, "Prevent Overlap",      group="Main Settings")

shw_TP1      = input.bool(true,  "Show Take Profit Levels",              group="Targets")
use_percent  = input.bool(false, "✦ Use Percentage % (Default / no profile matched)", group="Targets")

// ATR (Default / used only when no profile matches)
atr_period     = input.int(14,    "ATR Period",            group="Targets", minval=1)
sl_multiplier  = input.float(5.0, "SL  ATR Multiplier",   group="Targets", minval=0.1, step=0.1)
tp1_multiplier = input.float(0.5, "TP1 ATR Multiplier",   group="Targets", minval=0.1, step=0.1)
tp2_multiplier = input.float(1.0, "TP2 ATR Multiplier",   group="Targets", minval=0.1, step=0.1)
tp3_multiplier = input.float(1.5, "TP3 ATR Multiplier",   group="Targets", minval=0.1, step=0.1)

// Percentage Targets (Default / used only when no profile matches)
pct_sl   = input.float(0.60, "✘ SL  %",  group="Targets", minval=0.01, step=0.05)
pct_tp1  = input.float(0.30, "✔ TP1 %",  group="Targets", minval=0.01, step=0.05)
pct_tp2  = input.float(0.60, "✔ TP2 %",  group="Targets", minval=0.01, step=0.05)
pct_tp3  = input.float(0.90, "✔ TP3 %",  group="Targets", minval=0.01, step=0.05)

// Label offset
label_offset   = input.int(8, "➤ Label Offset (candles ahead)", group="Targets", minval=1, maxval=50, tooltip="Number of candles the labels are shifted ahead, to the right of the current bar")

// ============================================================================
// INPUTS — AUTO SYMBOL PROFILES (5 profiles: A–E)
// Each profile has its own ATR-or-Percentage mode switch.
// ============================================================================
enable_auto_profiles = input.bool(false, "Enable Auto Profiles", group="Auto Symbol Profiles", tooltip="When ON, the indicator automatically loads the matching profile's settings based on the current chart symbol. If no match is found, Default Settings above are used.")

// --- Profile A ---
pA_symbol = input.string("XAUUSD", "Symbol", group="Profile A", inline="pA0")
pA_mode   = input.bool(true, "Use Percentage % (OFF = use ATR)", group="Profile A", inline="pA0")
pA_len    = input.int(99,   "Range Len",  group="Profile A", inline="pA1")
pA_atr    = input.int(14,   "ATR Period", group="Profile A", inline="pA1")
pA_slm    = input.float(5.0, "SL ATR x",  group="Profile A", inline="pA2")
pA_tp1m   = input.float(0.5, "TP1 ATR x", group="Profile A", inline="pA2")
pA_tp2m   = input.float(1.0, "TP2 ATR x", group="Profile A", inline="pA3")
pA_tp3m   = input.float(1.5, "TP3 ATR x", group="Profile A", inline="pA3")
pA_sl     = input.float(0.60, "SL %",  group="Profile A", inline="pA4")
pA_tp1    = input.float(0.30, "TP1 %", group="Profile A", inline="pA4")
pA_tp2    = input.float(0.60, "TP2 %", group="Profile A", inline="pA5")
pA_tp3    = input.float(0.90, "TP3 %", group="Profile A", inline="pA5")

// --- Profile B ---
pB_symbol = input.string("USOIL", "Symbol", group="Profile B", inline="pB0")
pB_mode   = input.bool(true, "Use Percentage % (OFF = use ATR)", group="Profile B", inline="pB0")
pB_len    = input.int(99,   "Range Len",  group="Profile B", inline="pB1")
pB_atr    = input.int(14,   "ATR Period", group="Profile B", inline="pB1")
pB_slm    = input.float(5.0, "SL ATR x",  group="Profile B", inline="pB2")
pB_tp1m   = input.float(0.5, "TP1 ATR x", group="Profile B", inline="pB2")
pB_tp2m   = input.float(1.0, "TP2 ATR x", group="Profile B", inline="pB3")
pB_tp3m   = input.float(1.5, "TP3 ATR x", group="Profile B", inline="pB3")
pB_sl     = input.float(0.60, "SL %",  group="Profile B", inline="pB4")
pB_tp1    = input.float(0.30, "TP1 %", group="Profile B", inline="pB4")
pB_tp2    = input.float(0.60, "TP2 %", group="Profile B", inline="pB5")
pB_tp3    = input.float(0.90, "TP3 %", group="Profile B", inline="pB5")

// --- Profile C ---
pC_symbol = input.string("NQ1!", "Symbol", group="Profile C", inline="pC0")
pC_mode   = input.bool(true, "Use Percentage % (OFF = use ATR)", group="Profile C", inline="pC0")
pC_len    = input.int(99,   "Range Len",  group="Profile C", inline="pC1")
pC_atr    = input.int(14,   "ATR Period", group="Profile C", inline="pC1")
pC_slm    = input.float(5.0, "SL ATR x",  group="Profile C", inline="pC2")
pC_tp1m   = input.float(0.5, "TP1 ATR x", group="Profile C", inline="pC2")
pC_tp2m   = input.float(1.0, "TP2 ATR x", group="Profile C", inline="pC3")
pC_tp3m   = input.float(1.5, "TP3 ATR x", group="Profile C", inline="pC3")
pC_sl     = input.float(0.60, "SL %",  group="Profile C", inline="pC4")
pC_tp1    = input.float(0.30, "TP1 %", group="Profile C", inline="pC4")
pC_tp2    = input.float(0.60, "TP2 %", group="Profile C", inline="pC5")
pC_tp3    = input.float(0.90, "TP3 %", group="Profile C", inline="pC5")

// --- Profile D ---
pD_symbol = input.string("BTCUSDT", "Symbol", group="Profile D", inline="pD0")
pD_mode   = input.bool(true, "Use Percentage % (OFF = use ATR)", group="Profile D", inline="pD0")
pD_len    = input.int(99,   "Range Len",  group="Profile D", inline="pD1")
pD_atr    = input.int(14,   "ATR Period", group="Profile D", inline="pD1")
pD_slm    = input.float(5.0, "SL ATR x",  group="Profile D", inline="pD2")
pD_tp1m   = input.float(0.5, "TP1 ATR x", group="Profile D", inline="pD2")
pD_tp2m   = input.float(1.0, "TP2 ATR x", group="Profile D", inline="pD3")
pD_tp3m   = input.float(1.5, "TP3 ATR x", group="Profile D", inline="pD3")
pD_sl     = input.float(0.60, "SL %",  group="Profile D", inline="pD4")
pD_tp1    = input.float(0.30, "TP1 %", group="Profile D", inline="pD4")
pD_tp2    = input.float(0.60, "TP2 %", group="Profile D", inline="pD5")
pD_tp3    = input.float(0.90, "TP3 %", group="Profile D", inline="pD5")

// --- Profile E ---
pE_symbol = input.string("ETHUSDT", "Symbol", group="Profile E", inline="pE0")
pE_mode   = input.bool(true, "Use Percentage % (OFF = use ATR)", group="Profile E", inline="pE0")
pE_len    = input.int(99,   "Range Len",  group="Profile E", inline="pE1")
pE_atr    = input.int(14,   "ATR Period", group="Profile E", inline="pE1")
pE_slm    = input.float(5.0, "SL ATR x",  group="Profile E", inline="pE2")
pE_tp1m   = input.float(0.5, "TP1 ATR x", group="Profile E", inline="pE2")
pE_tp2m   = input.float(1.0, "TP2 ATR x", group="Profile E", inline="pE3")
pE_tp3m   = input.float(1.5, "TP3 ATR x", group="Profile E", inline="pE3")
pE_sl     = input.float(0.60, "SL %",  group="Profile E", inline="pE4")
pE_tp1    = input.float(0.30, "TP1 %", group="Profile E", inline="pE4")
pE_tp2    = input.float(0.60, "TP2 %", group="Profile E", inline="pE5")
pE_tp3    = input.float(0.90, "TP3 %", group="Profile E", inline="pE5")

// ============================================================================
// INPUTS — APPEARANCE / COLORS / DASHBOARDS
// ============================================================================
green_c = input.color(#00ffbb, "Bullish Colour", group="Appearance")
red_c   = input.color(#ff1100, "Bearish Colour", group="Appearance")

tp1_color = input.color(color.new(#04df79, 0), "TP1 Color", group="Colors")
tp2_color = input.color(color.new(#ee14ee, 0), "TP2 Color", group="Colors")
tp3_color = input.color(color.new(#fbc02d, 0), "TP3 Color", group="Colors")
sl_color  = input.color(color.new(#b71c1c, 0), "SL Color",  group="Colors")

show_dashboard = input.bool(true,          "Show Statistics Dashboard",   group="Dashboard")
dash_position  = input.string("Top Right", "Dashboard Position",          group="Dashboard", options=["Top Right","Top Left","Bottom Right","Bottom Left"])
trades_limit   = input.int(40,             "Last X Trades to Count",      group="Dashboard", minval=1, maxval=500)

show_pts_dashboard = input.bool(true,           "Show %/SL/NET Dashboard",  group="Percentage Dashboard")
pts_position        = input.string("Bottom Left", "Percentage Dashboard Position",    group="Percentage Dashboard", options=["Top Right","Top Left","Bottom Right","Bottom Left"])
pts_size_input       = input.string("Small", "Small Dashboard Size", group="Percentage Dashboard", options=["Tiny","Small","Normal","Large"])

// ============================================================================
// AUTO SYMBOL PROFILE ARRAYS  (populated once, before any logic uses them)
// ============================================================================
var array<string> profile_names       = array.new<string>()
var array<string> profile_symbols     = array.new<string>()
var array<bool>   profile_use_percent = array.new<bool>()
var array<float>  profile_sls         = array.new<float>()
var array<float>  profile_tp1s        = array.new<float>()
var array<float>  profile_tp2s        = array.new<float>()
var array<float>  profile_tp3s        = array.new<float>()
var array<float>  profile_slm         = array.new<float>()
var array<float>  profile_tp1m        = array.new<float>()
var array<float>  profile_tp2m        = array.new<float>()
var array<float>  profile_tp3m        = array.new<float>()

if barstate.isfirst
    array.push(profile_names, "A"), array.push(profile_symbols, pA_symbol), array.push(profile_use_percent, pA_mode), array.push(profile_sls, pA_sl), array.push(profile_tp1s, pA_tp1), array.push(profile_tp2s, pA_tp2), array.push(profile_tp3s, pA_tp3), array.push(profile_slm, pA_slm), array.push(profile_tp1m, pA_tp1m), array.push(profile_tp2m, pA_tp2m), array.push(profile_tp3m, pA_tp3m)
    array.push(profile_names, "B"), array.push(profile_symbols, pB_symbol), array.push(profile_use_percent, pB_mode), array.push(profile_sls, pB_sl), array.push(profile_tp1s, pB_tp1), array.push(profile_tp2s, pB_tp2), array.push(profile_tp3s, pB_tp3), array.push(profile_slm, pB_slm), array.push(profile_tp1m, pB_tp1m), array.push(profile_tp2m, pB_tp2m), array.push(profile_tp3m, pB_tp3m)
    array.push(profile_names, "C"), array.push(profile_symbols, pC_symbol), array.push(profile_use_percent, pC_mode), array.push(profile_sls, pC_sl), array.push(profile_tp1s, pC_tp1), array.push(profile_tp2s, pC_tp2), array.push(profile_tp3s, pC_tp3), array.push(profile_slm, pC_slm), array.push(profile_tp1m, pC_tp1m), array.push(profile_tp2m, pC_tp2m), array.push(profile_tp3m, pC_tp3m)
    array.push(profile_names, "D"), array.push(profile_symbols, pD_symbol), array.push(profile_use_percent, pD_mode), array.push(profile_sls, pD_sl), array.push(profile_tp1s, pD_tp1), array.push(profile_tp2s, pD_tp2), array.push(profile_tp3s, pD_tp3), array.push(profile_slm, pD_slm), array.push(profile_tp1m, pD_tp1m), array.push(profile_tp2m, pD_tp2m), array.push(profile_tp3m, pD_tp3m)
    array.push(profile_names, "E"), array.push(profile_symbols, pE_symbol), array.push(profile_use_percent, pE_mode), array.push(profile_sls, pE_sl), array.push(profile_tp1s, pE_tp1), array.push(profile_tp2s, pE_tp2), array.push(profile_tp3s, pE_tp3), array.push(profile_slm, pE_slm), array.push(profile_tp1m, pE_tp1m), array.push(profile_tp2m, pE_tp2m), array.push(profile_tp3m, pE_tp3m)

f_find_profile_index() =>
    int found = -1
    if enable_auto_profiles
        for i = 0 to array.size(profile_symbols) - 1
            if array.get(profile_symbols, i) == syminfo.ticker and array.get(profile_symbols, i) != ""
                found := i
                break
    found

active_profile_idx   = f_find_profile_index()
active_profile_label = active_profile_idx >= 0 ? array.get(profile_names, active_profile_idx) + " (" + syminfo.ticker + ")" : "Default"

effective_use_percent = active_profile_idx >= 0 ? array.get(profile_use_percent, active_profile_idx) : use_percent
effective_pct_sl       = active_profile_idx >= 0 ? array.get(profile_sls,  active_profile_idx) : pct_sl
effective_pct_tp1      = active_profile_idx >= 0 ? array.get(profile_tp1s, active_profile_idx) : pct_tp1
effective_pct_tp2      = active_profile_idx >= 0 ? array.get(profile_tp2s, active_profile_idx) : pct_tp2
effective_pct_tp3      = active_profile_idx >= 0 ? array.get(profile_tp3s, active_profile_idx) : pct_tp3
effective_sl_mult       = active_profile_idx >= 0 ? array.get(profile_slm,  active_profile_idx) : sl_multiplier
effective_tp1_mult      = active_profile_idx >= 0 ? array.get(profile_tp1m, active_profile_idx) : tp1_multiplier
effective_tp2_mult      = active_profile_idx >= 0 ? array.get(profile_tp2m, active_profile_idx) : tp2_multiplier
effective_tp3_mult      = active_profile_idx >= 0 ? array.get(profile_tp3m, active_profile_idx) : tp3_multiplier

// ============================================================================
// PER-PROFILE ATR / LENGTH CANDIDATES
// ============================================================================
atr_default = ta.atr(atr_period)
atr_A = ta.atr(pA_atr), atr_B = ta.atr(pB_atr), atr_C = ta.atr(pC_atr), atr_D = ta.atr(pD_atr), atr_E = ta.atr(pE_atr)

volatility = switch active_profile_idx
    0 => atr_A
    1 => atr_B
    2 => atr_C
    3 => atr_D
    4 => atr_E
    => atr_default

effective_len = switch active_profile_idx
    0 => pA_len
    1 => pB_len
    2 => pC_len
    3 => pD_len
    4 => pE_len
    => len

len_half_default = int(len / 2)
len_half_A = int(pA_len / 2), len_half_B = int(pB_len / 2), len_half_C = int(pC_len / 2), len_half_D = int(pD_len / 2), len_half_E = int(pE_len / 2)

len_ = switch active_profile_idx
    0 => len_half_A
    1 => len_half_B
    2 => len_half_C
    3 => len_half_D
    4 => len_half_E
    => len_half_default

pivh_default = ta.pivothigh(len_half_default, len_half_default)
pivh_A = ta.pivothigh(len_half_A, len_half_A), pivh_B = ta.pivothigh(len_half_B, len_half_B), pivh_C = ta.pivothigh(len_half_C, len_half_C)
pivh_D = ta.pivothigh(len_half_D, len_half_D), pivh_E = ta.pivothigh(len_half_E, len_half_E)

pivh = switch active_profile_idx
    0 => pivh_A
    1 => pivh_B
    2 => pivh_C
    3 => pivh_D
    4 => pivh_E
    => pivh_default

pivl_default = ta.pivotlow(len_half_default, len_half_default)
pivl_A = ta.pivotlow(len_half_A, len_half_A), pivl_B = ta.pivotlow(len_half_B, len_half_B), pivl_C = ta.pivotlow(len_half_C, len_half_C)
pivl_D = ta.pivotlow(len_half_D, len_half_D), pivl_E = ta.pivotlow(len_half_E, len_half_E)

pivl = switch active_profile_idx
    0 => pivl_A
    1 => pivl_B
    2 => pivl_C
    3 => pivl_D
    4 => pivl_E
    => pivl_default

v1_default = ta.wma(math.abs(close - open), len)
v1_A = ta.wma(math.abs(close - open), pA_len), v1_B = ta.wma(math.abs(close - open), pB_len), v1_C = ta.wma(math.abs(close - open), pC_len)
v1_D = ta.wma(math.abs(close - open), pD_len), v1_E = ta.wma(math.abs(close - open), pE_len)

v1 = switch active_profile_idx
    0 => v1_A
    1 => v1_B
    2 => v1_C
    3 => v1_D
    4 => v1_E
    => v1_default

v2_default = ta.ema(math.abs(close - open), len)
v2_A = ta.ema(math.abs(close - open), pA_len), v2_B = ta.ema(math.abs(close - open), pB_len), v2_C = ta.ema(math.abs(close - open), pC_len)
v2_D = ta.ema(math.abs(close - open), pD_len), v2_E = ta.ema(math.abs(close - open), pE_len)

v2 = switch active_profile_idx
    0 => v2_A
    1 => v2_B
    2 => v2_C
    3 => v2_D
    4 => v2_E
    => v2_default

vola_default = ta.atr(len) / 2
vola_A = ta.atr(pA_len) / 2, vola_B = ta.atr(pB_len) / 2, vola_C = ta.atr(pC_len) / 2, vola_D = ta.atr(pD_len) / 2, vola_E = ta.atr(pE_len) / 2

vola = switch active_profile_idx
    0 => vola_A
    1 => vola_B
    2 => vola_C
    3 => vola_D
    4 => vola_E
    => vola_default

// ============================================================================
// STATISTICS VARIABLES
// ============================================================================
var array<bool> trades_history = array.new<bool>()
var int  tp1_hit_count = 0
var int  tp2_hit_count = 0
var int  tp3_hit_count = 0

// ============================================================================
// PERCENTAGE TRACKING — per-TRADE
// ============================================================================
var float cur_tp1_pct = 0.0
var float cur_tp2_pct = 0.0
var float cur_tp3_pct = 0.0
var float cur_sl_pct  = 0.0

var array<float> hist_tp1 = array.new<float>()
var array<float> hist_tp2 = array.new<float>()
var array<float> hist_tp3 = array.new<float>()
var array<float> hist_sl  = array.new<float>()

f_close_trade(float t1, float t2, float t3, float sl) =>
    array.push(hist_tp1, t1)
    array.push(hist_tp2, t2)
    array.push(hist_tp3, t3)
    array.push(hist_sl,  sl)
    if array.size(hist_tp1) > trades_limit
        array.shift(hist_tp1)
        array.shift(hist_tp2)
        array.shift(hist_tp3)
        array.shift(hist_sl)

var float entry_price = na

// ============================================================================
// BOX / LINE ARRAYS
// ============================================================================
var boxes       = array.new_box()
var boxes_u     = array.new_box()
var boxes_l     = array.new_box()
var centerLines = array.new_line()

// ============================================================================
// HELPER: Distance calculation (ATR or Percentage %) — now per-profile aware
// ============================================================================
calc_distances() =>
    float sl_d  = effective_use_percent ? close * effective_pct_sl  / 100 : volatility * effective_sl_mult
    float tp1_d = effective_use_percent ? close * effective_pct_tp1 / 100 : sl_d * effective_tp1_mult
    float tp2_d = effective_use_percent ? close * effective_pct_tp2 / 100 : sl_d * effective_tp2_mult
    float tp3_d = effective_use_percent ? close * effective_pct_tp3 / 100 : sl_d * effective_tp3_mult
    [sl_d, tp1_d, tp2_d, tp3_d]

var line  entry_line  = na,  var line  sl_line   = na
var line  tp1_line    = na,  var line  tp2_line  = na,  var line  tp3_line  = na
var label entry_label = na,  var label sl_label  = na
var label tp1_label   = na,  var label tp2_label = na,  var label tp3_label = na
var linefill lf1      = na,  var linefill lf2    = na

var int   trade_dir     = 0
var bool  tp3_done      = false
var bool  tp1_hit       = false
var bool  tp2_hit       = false
var bool  trade_counted = false
var bool  trade_open    = false

// NEW: flags to fire the formatted BUY/SELL alert() exactly once, on the breakout bar
var bool  fire_buy_alert  = false
var bool  fire_sell_alert = false

// ============================================================================
// PIVOT-DERIVED LEVELS
// ============================================================================
pivh_lvl_0   = ta.valuewhen(not na(pivh), high[len_], 0)
pivh_index_0 = ta.valuewhen(not na(pivh), bar_index[len_], 0)
pivl_lvl_0   = ta.valuewhen(not na(pivl), low[len_], 0)
pivl_index_0 = ta.valuewhen(not na(pivl), bar_index[len_], 0)

var wede = 0
if boxes.size() > 0
    wede := boxes.first().get_right()

if ta.crossunder(v1, v2)
    float h = na, float l = na, int start_idx = na

    if pivh_index_0 > pivl_index_0
        h := pivh_lvl_0, start_idx := pivh_index_0
        int dist = bar_index - start_idx
        if dist > 0
            float min_val = high
            for i = 0 to dist - 1
                min_val := math.min(min_val, low[i])
            l := min_val
    else
        l := pivl_lvl_0, start_idx := pivl_index_0
        int dist = bar_index - start_idx
        if dist > 0
            float max_val = low
            for i = 0 to dist - 1
                max_val := math.max(max_val, high[i])
            h := max_val

    if (not na(h)) and (not na(l)) and (close <= h and close >= l) and (overlap or start_idx > wede)
        boxes.unshift(box.new(start_idx, h, bar_index, l, bgcolor=color.new(chart.fg_color,90), border_color=na))
        boxes_u.unshift(box.new(start_idx, h, bar_index, h-vola, bgcolor=color.new(red_c,70), border_color=na))
        boxes_l.unshift(box.new(start_idx, l+vola, bar_index, l, bgcolor=color.new(green_c,70), border_color=na))
        centerLines.unshift(line.new(start_idx,(h+l)/2, bar_index,(h+l)/2, color=color.new(chart.fg_color,50), style=line.style_dashed))

// ============================================================================
// BREAKOUT DETECTION
// ============================================================================
upbreak    = 0.0
downbreak  = 0.0
bool new_breakout = false
bool can_flip = not trade_open or tp1_hit or tp3_done

// reset the one-shot alert flags every bar
fire_buy_alert  := false
fire_sell_alert := false

if boxes.size() > 0
    for i = boxes.size()-1 to 0
        box b     = boxes.get(i)
        float top = b.get_top()
        float bot = b.get_bottom()

        if close > top and can_flip
            upbreak      := bot
            new_breakout := true
            boxes.remove(i), boxes_u.remove(i), boxes_l.remove(i), centerLines.remove(i)

            if shw_TP1
                if trade_open
                    f_close_trade(cur_tp1_pct, cur_tp2_pct, 0.0, 0.0)

                if trade_open and not trade_counted
                    array.push(trades_history, tp1_hit)
                    if array.size(trades_history) > trades_limit
                        array.shift(trades_history)

                trade_dir     := 1
                tp3_done      := false
                tp1_hit       := false
                tp2_hit       := false
                trade_counted := false
                trade_open    := true
                entry_price   := close
                cur_tp1_pct   := 0.0
                cur_tp2_pct   := 0.0
                cur_tp3_pct   := 0.0
                cur_sl_pct    := 0.0

                [sl_d, tp1_d, tp2_d, tp3_d] = calc_distances()
                float SL      = effective_use_percent ? close - sl_d : low - sl_d
                float TP1_lvl = close + tp1_d
                float TP2_lvl = close + tp2_d
                float TP3_lvl = close + tp3_d
                float sl_pct_diff  = (close - SL)      / close * 100
                float tp1_pct_diff = (TP1_lvl - close)  / close * 100
                float tp2_pct_diff = (TP2_lvl - close)  / close * 100
                float tp3_pct_diff = (TP3_lvl - close)  / close * 100

                int lx = bar_index + label_offset

                line.delete(entry_line),  label.delete(entry_label)
                line.delete(sl_line),     label.delete(sl_label)
                line.delete(tp1_line),    label.delete(tp1_label)
                line.delete(tp2_line),    label.delete(tp2_label)
                line.delete(tp3_line),    label.delete(tp3_label)
                linefill.delete(lf1),     linefill.delete(lf2)

                entry_line  := line.new(bar_index, close, lx, close, color=green_c, width=3)
                entry_label := label.new(lx, close, "Entry ▸ " + str.tostring(close, format.mintick), style=label.style_label_left, color=green_c, textcolor=color.rgb(0,0,0))

                sl_line  := line.new(bar_index, SL, lx, SL, color=color.new(sl_color,40), width=2)
                sl_label := label.new(lx, SL,
                     "✘ SL ▸ " + str.tostring(SL, format.mintick) + "  -" + str.tostring(sl_pct_diff, "#.##") + "%",
                     style=label.style_label_left, color=color.new(sl_color,40), textcolor=color.white)

                tp1_line  := line.new(bar_index, TP1_lvl, lx, TP1_lvl, color=color.new(tp1_color,40), width=2)
                tp1_label := label.new(lx, TP1_lvl,
                     " ✔ TP1 ▸ " + str.tostring(TP1_lvl, format.mintick) + "  +" + str.tostring(tp1_pct_diff, "#.##") + "%",
                     style=label.style_label_left, color=color.new(tp1_color,40), textcolor=color.white)

                tp2_line  := line.new(bar_index, TP2_lvl, lx, TP2_lvl, color=color.new(tp2_color,40), width=2)
                tp2_label := label.new(lx, TP2_lvl,
                     " ✔ TP2 ▸ " + str.tostring(TP2_lvl, format.mintick) + "  +" + str.tostring(tp2_pct_diff, "#.##") + "%",
                     style=label.style_label_left, color=color.new(tp2_color,40), textcolor=color.white)

                tp3_line  := line.new(bar_index, TP3_lvl, lx, TP3_lvl, color=color.new(tp3_color,40), width=2)
                tp3_label := label.new(lx, TP3_lvl,
                     " ✔ TP3 ▸ " + str.tostring(TP3_lvl, format.mintick) + "  +" + str.tostring(tp3_pct_diff, "#.##") + "%",
                     style=label.style_label_left, color=color.new(tp3_color,40), textcolor=color.white)

                lf1 := linefill.new(entry_line, sl_line,  color.new(red_c,   95))
                lf2 := linefill.new(entry_line, tp3_line, color.new(green_c, 95))

                fire_buy_alert := true

        else if close < bot and can_flip
            downbreak    := top
            new_breakout := true
            boxes.remove(i), boxes_u.remove(i), boxes_l.remove(i), centerLines.remove(i)

            if shw_TP1
                if trade_open
                    f_close_trade(cur_tp1_pct, cur_tp2_pct, 0.0, 0.0)

                if trade_open and not trade_counted
                    array.push(trades_history, tp1_hit)
                    if array.size(trades_history) > trades_limit
                        array.shift(trades_history)

                trade_dir     := -1
                tp3_done      := false
                tp1_hit       := false
                tp2_hit       := false
                trade_counted := false
                trade_open    := true
                entry_price   := close
                cur_tp1_pct   := 0.0
                cur_tp2_pct   := 0.0
                cur_tp3_pct   := 0.0
                cur_sl_pct    := 0.0

                [sl_d, tp1_d, tp2_d, tp3_d] = calc_distances()
                float SL      = effective_use_percent ? close + sl_d : high + sl_d
                float TP1_lvl = close - tp1_d
                float TP2_lvl = close - tp2_d
                float TP3_lvl = close - tp3_d
                float sl_pct_diff  = (SL - close)      / close * 100
                float tp1_pct_diff = (close - TP1_lvl) / close * 100
                float tp2_pct_diff = (close - TP2_lvl) / close * 100
                float tp3_pct_diff = (close - TP3_lvl) / close * 100

                int lx = bar_index + label_offset

                line.delete(entry_line),  label.delete(entry_label)
                line.delete(sl_line),     label.delete(sl_label)
                line.delete(tp1_line),    label.delete(tp1_label)
                line.delete(tp2_line),    label.delete(tp2_label)
                line.delete(tp3_line),    label.delete(tp3_label)
                linefill.delete(lf1),     linefill.delete(lf2)

                entry_line  := line.new(bar_index, close, lx, close, color=red_c, width=3)
                entry_label := label.new(lx, close, "Entry ▸ " + str.tostring(close, format.mintick), style=label.style_label_left, color=red_c, textcolor=color.rgb(8,8,8))

                sl_line  := line.new(bar_index, SL, lx, SL, color=color.new(sl_color,40), width=2)
                sl_label := label.new(lx, SL,
                     "✘ SL ▸ " + str.tostring(SL, format.mintick) + "  -" + str.tostring(sl_pct_diff, "#.##") + "%",
                     style=label.style_label_left, color=color.new(sl_color,40), textcolor=color.white)

                tp1_line  := line.new(bar_index, TP1_lvl, lx, TP1_lvl, color=color.new(tp1_color,40), width=2)
                tp1_label := label.new(lx, TP1_lvl,
                     " ✔ TP1 ▸ " + str.tostring(TP1_lvl, format.mintick) + "  +" + str.tostring(tp1_pct_diff, "#.##") + "%",
                     style=label.style_label_left, color=color.new(tp1_color,40), textcolor=color.white)

                tp2_line  := line.new(bar_index, TP2_lvl, lx, TP2_lvl, color=color.new(tp2_color,40), width=2)
                tp2_label := label.new(lx, TP2_lvl,
                     " ✔ TP2 ▸ " + str.tostring(TP2_lvl, format.mintick) + "  +" + str.tostring(tp2_pct_diff, "#.##") + "%",
                     style=label.style_label_left, color=color.new(tp2_color,40), textcolor=color.white)

                tp3_line  := line.new(bar_index, TP3_lvl, lx, TP3_lvl, color=color.new(tp3_color,40), width=2)
                tp3_label := label.new(lx, TP3_lvl,
                     " ✔ TP3 ▸ " + str.tostring(TP3_lvl, format.mintick) + "  +" + str.tostring(tp3_pct_diff, "#.##") + "%",
                     style=label.style_label_left, color=color.new(tp3_color,40), textcolor=color.white)

                lf1 := linefill.new(entry_line, sl_line,  color.new(red_c,   95))
                lf2 := linefill.new(entry_line, tp3_line, color.new(green_c, 95))

                fire_sell_alert := true

        else
            b.set_right(bar_index)
            boxes_u.get(i).set_right(bar_index)
            boxes_l.get(i).set_right(bar_index)
            centerLines.get(i).set_x2(bar_index)

// ============================================================================
// LINE EXTENSION + LABEL MOVE + TP/SL HIT TRACKING
// ============================================================================
var bool fire_tp1_alert = false
var bool fire_tp2_alert = false
var bool fire_tp3_alert = false
var bool fire_sl_alert  = false

fire_tp1_alert := false
fire_tp2_alert := false
fire_tp3_alert := false
fire_sl_alert  := false

if not new_breakout and not tp3_done and trade_open
    int lx = bar_index + label_offset
    line.set_x2(entry_line,  lx), label.set_x(entry_label, lx)
    line.set_x2(sl_line,     lx), label.set_x(sl_label,    lx)
    line.set_x2(tp1_line,    lx), label.set_x(tp1_label,   lx)
    line.set_x2(tp2_line,    lx), label.set_x(tp2_label,   lx)
    line.set_x2(tp3_line,    lx), label.set_x(tp3_label,   lx)

    float tp1_val = line.get_y1(tp1_line)
    float tp2_val = line.get_y1(tp2_line)
    float tp3_val = line.get_y1(tp3_line)
    float sl_val  = line.get_y1(sl_line)

    if not na(tp1_val) and not na(entry_price)
        if trade_dir == 1
            if high >= tp1_val and not tp1_hit
                float tp1_pct = (tp1_val - entry_price) / entry_price * 100
                label.new(bar_index, tp1_val, "✔ TP1✅  +" + str.tostring(tp1_pct, "#.##") + "%", style=label.style_label_up, color=tp1_color, textcolor=color.black, size=size.small)
                tp1_hit       := true
                tp1_hit_count += 1
                cur_tp1_pct   := math.abs(tp1_pct)
                fire_tp1_alert := true
                if not trade_counted
                    array.push(trades_history, true)
                    if array.size(trades_history) > trades_limit
                        array.shift(trades_history)
                    trade_counted := true

            if high >= tp2_val and not tp2_hit
                float tp2_pct = (tp2_val - entry_price) / entry_price * 100
                label.new(bar_index, tp2_val, "✔ TP2✅  +" + str.tostring(tp2_pct, "#.##") + "%", style=label.style_label_up, color=tp2_color, textcolor=color.black, size=size.small)
                tp2_hit       := true
                tp2_hit_count += 1
                cur_tp2_pct   := math.abs(tp2_pct)
                fire_tp2_alert := true

            if high >= tp3_val
                float tp3_pct = (tp3_val - entry_price) / entry_price * 100
                label.new(bar_index, tp3_val, "✔ TP3 HIT ✅  +" + str.tostring(tp3_pct, "#.##") + "%", style=label.style_label_down, color=tp3_color, textcolor=color.black, size=size.small)
                tp3_hit_count += 1
                cur_tp3_pct   := math.abs(tp3_pct)
                fire_tp3_alert := true
                f_close_trade(cur_tp1_pct, cur_tp2_pct, cur_tp3_pct, 0.0)
                line.delete(entry_line),  label.delete(entry_label)
                line.delete(sl_line),     label.delete(sl_label)
                line.delete(tp1_line),    label.delete(tp1_label)
                line.delete(tp2_line),    label.delete(tp2_label)
                line.delete(tp3_line),    label.delete(tp3_label)
                linefill.delete(lf1),     linefill.delete(lf2)
                tp3_done   := true
                trade_open := false

            else if low <= sl_val
                if not tp1_hit and not tp2_hit
                    float sl_pct = (entry_price - sl_val) / entry_price * 100
                    label.new(bar_index, sl_val, "SL HIT ❌  -" + str.tostring(sl_pct, "#.##") + "%", style=label.style_label_up, color=sl_color, textcolor=color.white, size=size.small)
                    fire_sl_alert := true
                    if not trade_counted
                        array.push(trades_history, false)
                        if array.size(trades_history) > trades_limit
                            array.shift(trades_history)
                        trade_counted := true
                    cur_sl_pct := math.abs(sl_pct)
                f_close_trade(cur_tp1_pct, cur_tp2_pct, 0.0, cur_sl_pct)
                line.delete(entry_line),  label.delete(entry_label)
                line.delete(sl_line),     label.delete(sl_label)
                line.delete(tp1_line),    label.delete(tp1_label)
                line.delete(tp2_line),    label.delete(tp2_label)
                line.delete(tp3_line),    label.delete(tp3_label)
                linefill.delete(lf1),     linefill.delete(lf2)
                tp3_done   := true
                trade_open := false

        else if trade_dir == -1
            if low <= tp1_val and not tp1_hit
                float tp1_pct = (entry_price - tp1_val) / entry_price * 100
                label.new(bar_index, tp1_val, "✔ TP1✅  +" + str.tostring(tp1_pct, "#.##") + "%", style=label.style_label_down, color=tp1_color, textcolor=color.black, size=size.small)
                tp1_hit       := true
                tp1_hit_count += 1
                cur_tp1_pct   := math.abs(tp1_pct)
                fire_tp1_alert := true
                if not trade_counted
                    array.push(trades_history, true)
                    if array.size(trades_history) > trades_limit
                        array.shift(trades_history)
                    trade_counted := true

            if low <= tp2_val and not tp2_hit
                float tp2_pct = (entry_price - tp2_val) / entry_price * 100
                label.new(bar_index, tp2_val, "✔ TP2✅  +" + str.tostring(tp2_pct, "#.##") + "%", style=label.style_label_down, color=tp2_color, textcolor=color.black, size=size.small)
                tp2_hit       := true
                tp2_hit_count += 1
                cur_tp2_pct   := math.abs(tp2_pct)
                fire_tp2_alert := true

            if low <= tp3_val
                float tp3_pct = (entry_price - tp3_val) / entry_price * 100
                label.new(bar_index, tp3_val, "✔ TP3 HIT ✅  +" + str.tostring(tp3_pct, "#.##") + "%", style=label.style_label_up, color=tp3_color, textcolor=color.black, size=size.small)
                tp3_hit_count += 1
                cur_tp3_pct   := math.abs(tp3_pct)
                fire_tp3_alert := true
                f_close_trade(cur_tp1_pct, cur_tp2_pct, cur_tp3_pct, 0.0)
                line.delete(entry_line),  label.delete(entry_label)
                line.delete(sl_line),     label.delete(sl_label)
                line.delete(tp1_line),    label.delete(tp1_label)
                line.delete(tp2_line),    label.delete(tp2_label)
                line.delete(tp3_line),    label.delete(tp3_label)
                linefill.delete(lf1),     linefill.delete(lf2)
                tp3_done   := true
                trade_open := false

            else if high >= sl_val
                if not tp1_hit and not tp2_hit
                    float sl_pct = (sl_val - entry_price) / entry_price * 100
                    label.new(bar_index, sl_val, "SL HIT ❌  -" + str.tostring(sl_pct, "#.##") + "%", style=label.style_label_down, color=sl_color, textcolor=color.white, size=size.small)
                    fire_sl_alert := true
                    if not trade_counted
                        array.push(trades_history, false)
                        if array.size(trades_history) > trades_limit
                            array.shift(trades_history)
                        trade_counted := true
                    cur_sl_pct := math.abs(sl_pct)
                f_close_trade(cur_tp1_pct, cur_tp2_pct, 0.0, cur_sl_pct)
                line.delete(entry_line),  label.delete(entry_label)
                line.delete(sl_line),     label.delete(sl_label)
                line.delete(tp1_line),    label.delete(tp1_label)
                line.delete(tp2_line),    label.delete(tp2_label)
                line.delete(tp3_line),    label.delete(tp3_label)
                linefill.delete(lf1),     linefill.delete(lf2)
                tp3_done   := true
                trade_open := false

// ============================================================================
// BREAKOUT ARROWS
// ============================================================================
plotshape(upbreak   != 0 ? upbreak   : na, "Bullish Breakout", shape.labelup,   location.absolute, green_c, text="▲", textcolor=chart.fg_color)
plotshape(downbreak != 0 ? downbreak : na, "Bearish Breakout", shape.labeldown, location.absolute, red_c,   text="▼", textcolor=chart.fg_color)

// ============================================================================
// ALERT VALUES — current TP1/TP2/TP3/SL levels, exposed as HIDDEN plots so
// {{plot("TP1")}}, {{plot("TP2")}}, {{plot("TP3")}}, {{plot("SL")}} work in
// the alert "Message" box (must match the titles below exactly).
// ============================================================================
float _tp1v = line.get_y1(tp1_line)
float _tp2v = line.get_y1(tp2_line)
float _tp3v = line.get_y1(tp3_line)
float _slv  = line.get_y1(sl_line)

plot(_tp1v, title="TP1", display=display.none, editable=false)
plot(_tp2v, title="TP2", display=display.none, editable=false)
plot(_tp3v, title="TP3", display=display.none, editable=false)
plot(_slv,  title="SL",  display=display.none, editable=false)

// ============================================================================
// ALERT MESSAGE TEMPLATES
// ============================================================================
buy_msg  = "🟢 BUY SIGNAL\n🪙 {{ticker}} • {{interval}}\n💰 Entry: {{close}}\n🎯 TP1: {{plot(\"TP1\")}}\n🚀 TP2: {{plot(\"TP2\")}}\n🏆 TP3: {{plot(\"TP3\")}}\n🛑 SL : {{plot(\"SL\")}}\n⚡ Crypto Signals"
sell_msg = "🔴 SELL SIGNAL\n🪙 {{ticker}} • {{interval}}\n💰 Entry: {{close}}\n🎯 TP1: {{plot(\"TP1\")}}\n🚀 TP2: {{plot(\"TP2\")}}\n🏆 TP3: {{plot(\"TP3\")}}\n🛑 SL : {{plot(\"SL\")}}\n⚡ Crypto Signals"

tp1_msg  = "✅ TP1 HIT\n🪙 {{ticker}} • {{interval}}\n💰 Price: {{close}}\n⚡ Crypto Signals"
tp2_msg  = "✅ TP2 HIT\n🪙 {{ticker}} • {{interval}}\n💰 Price: {{close}}\n⚡ Crypto Signals"
tp3_msg  = "🏆 TP3 HIT (Trade Closed)\n🪙 {{ticker}} • {{interval}}\n💰 Price: {{close}}\n⚡ Crypto Signals"
sl_msg   = "🛑 SL HIT (Trade Closed)\n🪙 {{ticker}} • {{interval}}\n💰 Price: {{close}}\n⚡ Crypto Signals"

// ============================================================================
// ALERTS  (use alert() so each fires exactly once, on its own trigger bar —
// alertcondition() is kept too so the levels still show up in "Create Alert")
// ============================================================================
if fire_buy_alert
    alert(buy_msg, alert.freq_once_per_bar_close)

if fire_sell_alert
    alert(sell_msg, alert.freq_once_per_bar_close)

if fire_tp1_alert
    alert(tp1_msg, alert.freq_once_per_bar_close)

if fire_tp2_alert
    alert(tp2_msg, alert.freq_once_per_bar_close)

if fire_tp3_alert
    alert(tp3_msg, alert.freq_once_per_bar_close)

if fire_sl_alert
    alert(sl_msg, alert.freq_once_per_bar_close)

alertcondition(upbreak   != 0, "Bullish Breakout", "Bullish Breakout Detected")
alertcondition(downbreak != 0, "Bearish Breakout", "Bearish Breakout Detected")
alertcondition(fire_tp1_alert, "TP1 Hit", "Take Profit 1 Hit")
alertcondition(fire_tp2_alert, "TP2 Hit", "Take Profit 2 Hit")
alertcondition(fire_tp3_alert, "TP3 Hit", "Take Profit 3 Hit")
alertcondition(fire_sl_alert,  "SL Hit",  "Stop Loss Hit")

// ============================================================================
// STATISTICS DASHBOARD (Win / Lose / Win Rate + Active Profile row)
// ============================================================================
if show_dashboard
    win_count  = 0
    lose_count = 0
    if array.size(trades_history) > 0
        for i = 0 to array.size(trades_history) - 1
            if array.get(trades_history, i)
                win_count += 1
            else
                lose_count += 1

    total_trades = win_count + lose_count
    win_rate     = total_trades > 0 ? (win_count / total_trades) * 100 : 0.0

    tpos = dash_position == "Top Right"    ? position.top_right    :
           dash_position == "Top Left"     ? position.top_left     :
           dash_position == "Bottom Right" ? position.bottom_right : position.bottom_left

    var table t = table.new(tpos, 2, 7, bgcolor=color.new(#1a1a1a,10), border_width=1, border_color=color.new(#00ffbb,50))

    if barstate.islast
        table.cell(t,0,0,"📊 Last "+str.tostring(trades_limit), text_color=color.white, text_size=size.small, bgcolor=color.new(#00ffbb,70), text_halign=text.align_center)
        table.cell(t,1,0,"Trades", text_color=color.white, text_size=size.small, bgcolor=color.new(#00ffbb,70), text_halign=text.align_center)
        table.cell(t,0,1,"Counted", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#2a2a2a,20))
        table.cell(t,1,1,str.tostring(total_trades)+"/"+str.tostring(trades_limit), text_color=color.new(#00ffbb,0), text_size=size.normal, text_halign=text.align_center, bgcolor=color.new(#2a2a2a,20))
        table.cell(t,0,2,"✅ Win", text_color=color.new(#00ff00,0), text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#1a3a1a,20))
        table.cell(t,1,2,str.tostring(win_count), text_color=color.new(#00ff00,0), text_size=size.normal, text_halign=text.align_center, bgcolor=color.new(#1a3a1a,20))
        table.cell(t,0,3,"❌ Lose", text_color=color.new(#ff0000,0), text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#3a1a1a,20))
        table.cell(t,1,3,str.tostring(lose_count), text_color=color.new(#ff0000,0), text_size=size.normal, text_halign=text.align_center, bgcolor=color.new(#3a1a1a,20))
        table.cell(t,0,4,"📈 Win Rate", text_color=color.new(#ffd700,0), text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#2a2a1a,20))
        wrc = win_rate >= 60 ? #00ff00 : win_rate >= 40 ? #ffaa00 : #ff0000
        table.cell(t,1,4,str.tostring(win_rate,"#.##")+"%", text_color=color.new(wrc,0), text_size=size.normal, text_halign=text.align_center, bgcolor=color.new(#2a2a1a,20))
        table.cell(t,0,5,"Status", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#1a1a2a,20))
        bool is_active = trade_open and not tp3_done
        table.cell(t,1,5, is_active ? "🟢 ACTIVE" : "⚪ WAIT", text_color=color.new(is_active ? #00ff00 : #888888,0), text_size=size.small, text_halign=text.align_center, bgcolor=color.new(#1a1a2a,20))
        table.cell(t,0,6,"🧭 Profile", text_color=color.white, text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#1a2a3a,20))
        table.cell(t,1,6, active_profile_label, text_color=color.new(#00ffbb,0), text_size=size.small, text_halign=text.align_center, bgcolor=color.new(#1a2a3a,20))

// ============================================================================
// PERCENTAGE / SL DASHBOARD  (NET column removed — Count only, 5 columns)
// ============================================================================
if show_pts_dashboard
    ppos = pts_position == "Top Right"    ? position.top_right    :
           pts_position == "Top Left"     ? position.top_left     :
           pts_position == "Bottom Right" ? position.bottom_right : position.bottom_left

    pts_text_size = pts_size_input == "Tiny"   ? size.tiny   :
                     pts_size_input == "Small"  ? size.small  :
                     pts_size_input == "Normal" ? size.normal : size.large

    var table pt = table.new(ppos, 5, 2,
         bgcolor      = color.new(#1a1a1a, 10),
         border_width = 1,
         border_color = color.new(#00ffbb, 50))

    if barstate.islast
        float pct_sum_tp1 = 0.0
        float pct_sum_tp2 = 0.0
        float pct_sum_tp3 = 0.0
        float pct_sum_sl  = 0.0
        int   cnt_tp1 = 0
        int   cnt_tp2 = 0
        int   cnt_tp3 = 0
        int   cnt_sl  = 0
        int   n = array.size(hist_tp1)
        if n > 0
            for i = 0 to n - 1
                float v1_ = array.get(hist_tp1, i)
                float v2_ = array.get(hist_tp2, i)
                float v3_ = array.get(hist_tp3, i)
                float vs_ = array.get(hist_sl,  i)
                pct_sum_tp1 += v1_
                pct_sum_tp2 += v2_
                pct_sum_tp3 += v3_
                pct_sum_sl  += vs_
                cnt_tp1 += v1_ > 0 ? 1 : 0
                cnt_tp2 += v2_ > 0 ? 1 : 0
                cnt_tp3 += v3_ > 0 ? 1 : 0
                cnt_sl  += vs_ > 0 ? 1 : 0

        table.cell(pt, 0, 0, "⚡ Last " + str.tostring(trades_limit),
             text_color=color.white, text_size=pts_text_size, bgcolor=color.new(#00ffbb,70), text_halign=text.align_center)
        table.cell(pt, 1, 0, "🎯 TP1",
             text_color=color.new(tp1_color,0), text_size=pts_text_size, bgcolor=color.new(#00ffbb,70), text_halign=text.align_center)
        table.cell(pt, 2, 0, "🚀 TP2",
             text_color=color.new(tp2_color,0), text_size=pts_text_size, bgcolor=color.new(#00ffbb,70), text_halign=text.align_center)
        table.cell(pt, 3, 0, "🏆 TP3",
             text_color=color.new(tp3_color,0), text_size=pts_text_size, bgcolor=color.new(#00ffbb,70), text_halign=text.align_center)
        table.cell(pt, 4, 0, "✘ SL",
             text_color=color.new(#ff4444,0), text_size=pts_text_size, bgcolor=color.new(#00ffbb,70), text_halign=text.align_center)

        table.cell(pt, 0, 1, "Count",
             text_color=color.white, text_size=pts_text_size, bgcolor=color.new(#2a2a2a,20), text_halign=text.align_left)
        table.cell(pt, 1, 1, str.tostring(cnt_tp1) + "x",
             text_color=color.new(tp1_color,0), text_size=pts_text_size, bgcolor=color.new(#1a3a1a,20), text_halign=text.align_center)
        table.cell(pt, 2, 1, str.tostring(cnt_tp2) + "x",
             text_color=color.new(tp2_color,0), text_size=pts_text_size, bgcolor=color.new(#2a1a2a,20), text_halign=text.align_center)
        table.cell(pt, 3, 1, str.tostring(cnt_tp3) + "x",
             text_color=color.new(tp3_color,0), text_size=pts_text_size, bgcolor=color.new(#2a2a1a,20), text_halign=text.align_center)
        table.cell(pt, 4, 1, str.tostring(cnt_sl) + "x",
             text_color=color.new(#ff4444,0), text_size=pts_text_size, bgcolor=color.new(#3a1a1a,20), text_halign=text.align_center)
