// ============================================================ //
// Opening Range Breakout (ORB) Indicator with Premarket High
// Pine Script v6
//
// Triggers when ALL conditions are met:
// 1. Price closes above the 9:30–10:00 AM EST opening range high
// 2. Current bar volume >= 1.5x the avg volume of the opening range
// 3. Price is above VWAP
// 4. Bar is within the first 2 hours of the session (before 11:30 AM EST)
//
// Visuals:
// - Horizontal line at the opening range high
// - Horizontal line at the premarket high (4:00 AM - 9:30 AM EST)
// - Green triangle below breakout bar
// - Light green background when all conditions are met
//
// Alert:
// - Fires on bar close when all conditions are met
// - Dynamic message includes: Symbol, Price, Time
// ============================================================ //
//@version=6
indicator(title="ORB Breakout – 30 Min with PM High", shorttitle="ORB Breakout + PM", overlay=true)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
volumeMultiplier = input.float(
     defval  = 1.5, 
     title   = "Volume Multiplier (vs OR avg)", 
     minval  = 1.0, 
     step    = 0.1, 
     tooltip = "Current bar volume must exceed this multiple of the opening range average volume."
 )

orLineColor = input.color(
     defval = color.orange, 
     title  = "OR High Line Color"
 )

orLineWidth = input.int(
     defval = 2, 
     title  = "OR High Line Width", 
     minval = 1, 
     maxval = 4
 )

pmLineColor = input.color(
     defval = color.purple, 
     title  = "Premarket High Line Color"
 )

pmLineWidth = input.int(
     defval = 2, 
     title  = "Premarket High Line Width", 
     minval = 1, 
     maxval = 4
 )

// ─────────────────────────────────────────────
// SESSION / TIME HELPERS
// ─────────────────────────────────────────────
// NYSE regular session timezone
TZ = "America/New_York"

// Premarket session: 4:00 AM – 9:30 AM EST
isPremarket = not na(time("1", "0400-0930", TZ))

// Opening range: 9:30 – 10:00 AM EST
isORBar = not na(time("1", "0930-1000", TZ))

// Within the first 2 trading hours: 9:30 – 11:30 AM EST
isWithin2Hours = not na(time("1", "0930-1130", TZ))

// Detect the very first bar of the regular session (9:30 candle)
isSessionOpen = not na(time("1", "0930-0931", TZ))

// ─────────────────────────────────────────────
// PREMARKET HIGH TRACKING
// ─────────────────────────────────────────────
var float pmHigh = na
var float currentPmHigh = na

// Reset tracking variable when moving into a new premarket session
if isPremarket and not isPremarket[1]
    currentPmHigh := na

// Continually find highest high during the premarket window
if isPremarket
    currentPmHigh := na(currentPmHigh) ? high : math.max(currentPmHigh, high)

// Lock in the final premarket high right at the 9:30 AM market open
if isSessionOpen
    pmHigh := currentPmHigh

// ─────────────────────────────────────────────
// OPENING RANGE HIGH & VOLUME TRACKING
// ─────────────────────────────────────────────
// Persistent variables – reset each new session
var float orHigh     = na // highest high of the 9:30-10:00 range
var float orVolSum   = 0.0 // sum of volume during OR
var int   orBarCount = 0   // number of bars in the OR
var float orAvgVol   = na  // average bar volume during OR
var bool  orComplete = false // true once 10:00 AM has passed

// Reset on the 9:30 bar so the OR is always fresh each day
if isSessionOpen
    orHigh     := na
    orVolSum   := 0.0
    orBarCount := 0
    orAvgVol   := na
    orComplete := false

// Accumulate OR data while inside the opening range window
if isORBar
    orHigh     := na(orHigh) ? high : math.max(orHigh, high)
    orVolSum   += volume
    orBarCount += 1

// Once we step past 10:00 AM, lock in the average OR volume
if not isORBar and not orComplete and not na(orHigh)
    orAvgVol   := orBarCount > 0 ? orVolSum / orBarCount : na
    orComplete := true

// ─────────────────────────────────────────────
// VWAP
// ─────────────────────────────────────────────
// Built-in session VWAP (resets each day automatically)
vwapValue = ta.vwap(hlc3)

// ─────────────────────────────────────────────
// BREAKOUT CONDITIONS
// ─────────────────────────────────────────────
// 1. Close breaks above the opening range high (OR must be complete)
priceBreakout = orComplete and not na(orHigh) and close > orHigh

// 2. Current bar volume >= volumeMultiplier × average OR volume
volumeCondition = not na(orAvgVol) and volume >= (orAvgVol * volumeMultiplier)

// 3. Price is above VWAP
aboveVWAP = not na(vwapValue) and close > vwapValue

// 4. Bar is within the first 2 hours of the session (before 11:30 AM)
timeCondition = isWithin2Hours

// ── ALL conditions met ──
allConditionsMet = priceBreakout and volumeCondition and aboveVWAP and timeCondition

// ─────────────────────────────────────────────
// VISUALS
// ─────────────────────────────────────────────
// 1. Horizontal line at the premarket high (displays only during regular session)
plot(
     series    = not isPremarket and not na(pmHigh) ? pmHigh : na, 
     title     = "Premarket High", 
     color     = pmLineColor, 
     linewidth = pmLineWidth, 
     style     = plot.style_linebr
 )

// 2. Horizontal line at the opening range high
plot(
     series    = orComplete ? orHigh : na, 
     title     = "OR High", 
     color     = orLineColor, 
     linewidth = orLineWidth, 
     style     = plot.style_linebr // breaks between sessions
 )

// 3. Green triangle on the breakout bar
plotshape(
     series   = allConditionsMet, 
     title    = "Breakout Signal", 
     style    = shape.triangleup, 
     location = location.belowbar, 
     color    = color.new(color.green, 0), 
     size     = size.normal, 
     text     = "ORB"
 )

// 4. Light-green background when all conditions are met
bgcolor(
     color = allConditionsMet ? color.new(color.green, 88) : na, 
     title = "Breakout Background"
 )

// Optional: plot VWAP for visual reference
plot(
     series    = vwapValue, 
     title     = "VWAP", 
     color     = color.new(color.blue, 30), 
     linewidth = 1, 
     style     = plot.style_line
 )

// ─────────────────────────────────────────────
// ALERT FUNCTIONALITY (v6 Standard)
// ─────────────────────────────────────────────
if allConditionsMet and barstate.isconfirmed
    alertMessage = "ORB Breakout 🚀\nSymbol: " + syminfo.ticker + "\nPrice: " + str.tostring(close) + "\nTime: " + str.tostring(time, "yyyy-MM-dd HH:mm")
    alert(alertMessage, alert.freq_once_per_bar_close)
