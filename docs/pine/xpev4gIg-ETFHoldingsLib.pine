// Examples 

[vea1, vea2, vea3, vea4] = vea_get() // Example from VEA 
[spy1, spy2, spy3, spy4] = spy_get() // Example from SPY 

var table example_table = table.new(position.middle_center, 9, 15, bgcolor = color.black, frame_color = color.white, frame_width = 3) 

table.cell(example_table, 1, 1, text = "VEA Holdings", bgcolor = color.black, text_color = color.white)
table.cell(example_table, 2, 1, text = "VEA Holdings \n Breakdown by %", bgcolor = color.black, text_color = color.white)
table.cell(example_table, 3, 1, text = "VEA Sectors", bgcolor = color.black, text_color = color.white)
table.cell(example_table, 4, 1, text = "VEA Sectors \n Breakdown by %", bgcolor = color.black, text_color = color.white)

table.cell(example_table, 5, 1, text = "SPY Holdings", bgcolor = color.black, text_color = color.white)
table.cell(example_table, 6, 1, text = "SPY Holdings \n Breakdown by %", bgcolor = color.black, text_color = color.white)
table.cell(example_table, 7, 1, text = "SPY Sectors", bgcolor = color.black, text_color = color.white)
table.cell(example_table, 8, 1, text = "SPY Sectors \n Breakdown by %", bgcolor = color.black, text_color = color.white)

for i = 0 to array.size(vea1) - 1 
	table.cell(example_table, 1, 2 + i, text = str.tostring(array.get(vea1, i)), bgcolor = color.black, text_color = color.white)
	table.cell(example_table, 2, 2 + i, text = str.tostring(array.get(vea2, i)), bgcolor = color.black, text_color = color.white)

for i = 0 to array.size(vea3) - 1 
	table.cell(example_table, 3, 2 + i, text = str.tostring(array.get(vea3, i)), bgcolor = color.black, text_color = color.white)
	table.cell(example_table, 4, 2 + i, text = str.tostring(array.get(vea4, i)), bgcolor = color.black, text_color = color.white)


for i = 0 to array.size(spy1) - 1 
	table.cell(example_table, 5, 2 + i, text = str.tostring(array.get(spy1, i)), bgcolor = color.black, text_color = color.white)
	table.cell(example_table, 6, 2 + i, text = str.tostring(array.get(spy2, i)), bgcolor = color.black, text_color = color.white)

for i = 0 to array.size(spy3) - 1 
	table.cell(example_table, 7, 2 + i, text = str.tostring(array.get(spy3, i)), bgcolor = color.black, text_color = color.white)
	table.cell(example_table, 8, 2 + i, text = str.tostring(array.get(spy4, i)), bgcolor = color.black, text_color = color.white)

