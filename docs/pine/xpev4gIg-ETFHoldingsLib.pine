// LAST UPDATE: June 2026 (41/46 ETFs refreshed via Alpha Vantage ETF_PROFILE; ARKK, BRK, FNGG, FNGU, MOON still on Nov 2023 data — pending re-pull)
// NEXT SCHEDULED UPDATE: December 2026 

// Bringing more fundamental data to pinescript, one index at a time!
// The following library contains over 15 different US based ETF's, their top 10 holdings and a breakdown of their top 10 holdings as well as a breakdown of their sector holdings. 
// Each function will export the information into 4 different arrays, 2 floats and 2 strings. The order is: 
// 1) String array of held tickers 
// 2) Float array of composition of held tickers in % 
// 3) String array of sectors 
// 4) Float array of composition of held sectors in % 
// No input data is required, you just call the ETF you want the data from. 

// © Steversteves
//@version=6
// @description: Contains the top 10 holdings of various ETFs, including the weighted % of the holding. 
library("ETFHoldingsLib")

// @function: pulls SPY ETF data
// @returns: tickers held (string array), percent ticker holding (float array), sectors (string array), percent secture positioning (float array)
export spy_get() =>
	string[] tickers_held = array.from("NVDA", "AAPL", "MSFT", "AMZN", "GOOGL", "AVGO", "GOOG", "META", "MU", "TSLA")
	float[] perc_ticker_holding = array.from(7.60, 6.79, 4.28, 3.62, 3.19, 2.85, 2.57, 1.93, 1.87, 1.67)
	string[] sector_weighting = array.from("Basic Materials", "Consumer Cyclical", "Financial Services", "Real Estate", "Consumer Defensive", "Healthcare", "Utilities", "Communication Services", "Energy", "Industrials", "Technology")
	float[] perc_sector_weighting = array.from(1.80, 9.30, 10.40, 0.00, 4.80, 8.80, 2.30, 9.70, 3.10, 8.80, 37.30)
	[tickers_held, perc_ticker_holding, sector_weighting, perc_sector_weighting]

