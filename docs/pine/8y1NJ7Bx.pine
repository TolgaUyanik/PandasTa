        0  => "ROFEX:DLRF2026"   // Jan 2026
        1  => "ROFEX:DLRG2026"   // Feb 2026
        2  => "ROFEX:DLRH2026"   // Mar 2026
        3  => "ROFEX:DLRJ2026"   // Apr 2026
        4  => "ROFEX:DLRK2026"   // May 2026
        5  => "ROFEX:DLRM2026"   // Jun 2026
        6  => "ROFEX:DLRN2026"   // Jul 2026
        7  => "ROFEX:DLRQ2026"   // Aug 2026
        8  => "ROFEX:DLRU2026"   // Sep 2026
        9  => "ROFEX:DLRV2026"   // Oct 2026
        10 => "ROFEX:DLRX2026"   // Nov 2026
        => ""

export getDolarFuturesShort(int index) =>
    switch index
        0  => "DLR Ene26"
        1  => "DLR Feb26"
        2  => "DLR Mar26"
        3  => "DLR Abr26"
        4  => "DLR May26"
        5  => "DLR Jun26"
        6  => "DLR Jul26"
        7  => "DLR Ago26"
        8  => "DLR Sep26"
        9  => "DLR Oct26"
        10 => "DLR Nov26"
