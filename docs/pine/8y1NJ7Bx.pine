// ============================================================================
// DUALES DATA (2 instruments) - Tickers starting with 'M'
// ============================================================================
export getDualesCount() =>
    2

export getDualesTicker(int index) =>
    switch index
        0  => "BCBA:M27F6"
        1  => "BCBA:M30A6"
        => ""

export getDualesTickerShort(int index) =>
    switch index
        0  => "M27F6"
        1  => "M30A6"
        => ""

export getDualesMaturityPrice(int index) =>
    switch index
        0  => 129.41   // M27F6
        1  => 109.47   // M30A6
        => 0.0

export getDualesMaturityTimestamp(int index) =>
    switch index
        0  => timestamp(2026, 2, 27, 0, 0)   // M27F6
        1  => timestamp(2026, 4, 30, 0, 0)   // M30A6
        => 0

// ============================================================================
// DOLAR FUTURES DATA (MATBAROFEX)
// ============================================================================
export getDolarFuturesCount() =>
    11

export getDolarFuturesTicker(int index) =>
