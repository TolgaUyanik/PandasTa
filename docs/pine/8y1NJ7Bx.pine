//@version=6
//@description Library containing LECAP, BONCAP, and DUALES data for Argentina Fixed Rate Treasury Notes and Bonds. Updated periodically with ticker information, maturity prices, and maturity dates.

// ============================================================================
// ENGLISH DESCRIPTION
// ============================================================================
// LECAPS-BONCAP-DUALES Library
// 
// This library provides centralized data for Argentine fixed-rate treasury 
// instruments (LECAPs, BONCAPs, and DUALES) traded on the Buenos Aires Stock Exchange (BCBA).
//
// CONTENTS:
// - LECAP tickers (S prefix): Zero-coupon treasury notes
// - BONCAP tickers (T prefix): Fixed-rate treasury bonds  
// - DUALES tickers (M prefix): Dual-rate bonds (TAMAR-linked)
// - Dólar Futures contracts from MatbaRofex exchange
// - Maturity prices (px_finish) established at public auction
// - Maturity dates for each instrument
//
// Last Updated: 2026-02-11
//
// ============================================================================
// DESCRIPCIÓN EN ESPAÑOL
// ============================================================================
// Biblioteca LECAPS-BONCAP-DUALES
//
// Esta biblioteca provee datos centralizados para instrumentos de renta fija
// del Tesoro argentino (LECAPs, BONCAPs y DUALES) operados en BCBA.
//
// CONTENIDO:
// - Tickers LECAP (prefijo S): Letras del Tesoro cupón cero
// - Tickers BONCAP (prefijo T): Bonos del Tesoro a tasa fija
// - Tickers DUALES (prefijo M): Bonos duales (vinculados a TAMAR)
// - Contratos de Dólar Futuro del mercado MatbaRofex
// - Precios de vencimiento (px_finish) establecidos en licitación
// - Fechas de vencimiento para cada instrumento
//
// Última actualización: 2026-02-11
//
// ============================================================================

library("LECAPS_BONCAP_DUALES_Library", overlay=true)

// ============================================================================
// LECAP DATA (9 instruments) - Tickers starting with 'S'
// ============================================================================
export getLecapCount() =>
    9

export getLecapTicker(int index) =>
    switch index
        0  => "BCBA:S27F6"
        1  => "BCBA:S17A6"
        2  => "BCBA:S16M6"
        3  => "BCBA:S30A6"
        4  => "BCBA:S29Y6"
        5  => "BCBA:S31L6"
        6  => "BCBA:S31G6"
        7  => "BCBA:S30O6"
        8  => "BCBA:S30N6"
        => ""

export getLecapTickerShort(int index) =>
    switch index
        0  => "S27F6"
        1  => "S17A6"
        2  => "S16M6"
        3  => "S30A6"
        4  => "S29Y6"
        5  => "S31L6"
        6  => "S31G6"
        7  => "S30O6"
        8  => "S30N6"
        => ""

export getLecapMaturityPrice(int index) =>
    switch index
        0  => 125.84   // S27F6
        1  => 110.13   // S17A6
        2  => 104.62   // S16M6
        3  => 127.49   // S30A6
        4  => 132.04   // S29Y6
        5  => 117.68   // S31L6
        6  => 127.06   // S31G6
        7  => 135.28   // S30O6
        8  => 129.89   // S30N6
        => 0.0

export getLecapMaturityTimestamp(int index) =>
    switch index
        0  => timestamp(2026, 2, 27, 0, 0)   // S27F6
        1  => timestamp(2026, 4, 17, 0, 0)   // S17A6
        2  => timestamp(2026, 3, 16, 0, 0)   // S16M6
        3  => timestamp(2026, 4, 30, 0, 0)   // S30A6
        4  => timestamp(2026, 5, 29, 0, 0)   // S29Y6
        5  => timestamp(2026, 7, 31, 0, 0)   // S31L6
        6  => timestamp(2026, 8, 31, 0, 0)   // S31G6
        7  => timestamp(2026, 10, 30, 0, 0)  // S30O6
        8  => timestamp(2026, 11, 30, 0, 0)  // S30N6
        => 0

// ============================================================================
// BONCAP DATA (6 instruments) - Tickers starting with 'T'
