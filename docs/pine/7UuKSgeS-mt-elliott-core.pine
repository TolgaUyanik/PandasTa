//@version=6
library("mt_elliott_core", overlay=false)

// ─────────────────────────────────────────────────────────────────────────────
// EWO (FastEMA - SlowEMA, geglättet)
export ewo(simple int maFastLen, simple int maSlowLen, simple int smoothLen) =>
    float fast = ta.ema(close, maFastLen)
    float slow = ta.ema(close, maSlowLen)
    float raw  = fast - slow
    float out  = ta.ema(raw, smoothLen)
    out

// ─────────────────────────────────────────────────────────────────────────────
// Markttechnik: Phase 1/2/3/5 (über Pivots, ohne valuewhen)
export mt_phase_num(simple int _len, simple float _minGap) =>
    float ph = ta.pivothigh(high, _len, _len)
    float pl = ta.pivotlow (low,  _len, _len)

    var float lastHigh = na
    var float prevHigh = na
    var float lastLow  = na
    var float prevLow  = na

    if not na(ph)
        bool acceptH = na(lastHigh) or math.abs(ph - lastHigh) >= _minGap
        if acceptH
            prevHigh := lastHigh
            lastHigh := ph

    if not na(pl)
        bool acceptL = na(lastLow) or math.abs(pl - lastLow) >= _minGap
        if acceptL
            prevLow := lastLow
            lastLow := pl

    bool hh = not na(lastHigh) and not na(prevHigh) and lastHigh > prevHigh
    bool hl = not na(lastLow)  and not na(prevLow)  and lastLow  > prevLow
    bool ll = not na(lastLow)  and not na(prevLow)  and lastLow  < prevLow
    bool lh = not na(lastHigh) and not na(prevHigh) and lastHigh < prevHigh

    bool upTrend   = hh and hl
    bool downTrend = ll and lh

    int pn = 1
    if upTrend
        pn := (not na(lastHigh) and close >= lastHigh) ? 3 : (not na(lastLow) and close > lastLow ? 2 : 5)
    else if downTrend
        pn := (not na(lastLow)  and close <= lastLow)  ? 3 : (not na(lastHigh) and close < lastHigh ? 2 : 5)
    pn

// ─────────────────────────────────────────────────────────────────────────────
// Phase → Farbe (grün/gelb/rot/dunkelgrün; sonst grau)
export mt_color_from_phase(simple int _len, simple float _minGap) =>
    int pn = mt_phase_num(_len, _minGap)
    int sPH = ta.barssince(not na(ta.pivothigh(high, _len, _len)))
    int sPL = ta.barssince(not na(ta.pivotlow (low,  _len, _len)))
    bool lastIsLow = sPL < sPH

    color darkGr = color.rgb(0, 100, 0)
    color outCol = color.new(color.gray, 0)
    if pn == 3
        outCol := lastIsLow ? color.new(color.green, 0) : color.new(color.red, 0)
    else if pn == 2
        outCol := color.new(color.yellow, 0)
    else if pn == 5
        outCol := darkGr
    outCol

// ─────────────────────────────────────────────────────────────────────────────
// Fortschritt der aktuellen Phase in % (0..999), ohne valuewhen
export mt_phase_progress_pct(simple int _len, simple float _minGap) =>
    float ph = ta.pivothigh(high, _len, _len)
    float pl = ta.pivotlow (low,  _len, _len)

    var float lastHigh = na
    var float prevHigh = na
    var float lastLow  = na
    var float prevLow  = na

    if not na(ph)
        bool acceptH = na(lastHigh) or math.abs(ph - lastHigh) >= _minGap
        if acceptH
            prevHigh := lastHigh
            lastHigh := ph

    if not na(pl)
        bool acceptL = na(lastLow) or math.abs(pl - lastLow) >= _minGap
        if acceptL
            prevLow := lastLow
            lastLow := pl

    int sPH = ta.barssince(not na(ph))
    int sPL = ta.barssince(not na(pl))
    bool lastIsLow = sPL < sPH

    float start = lastIsLow ? lastLow : lastHigh
    float ref   = lastIsLow ? (na(lastHigh) ? prevHigh : lastHigh) : (na(lastLow) ? prevLow : lastLow)

    float curr  = na(start) or na(ref) ? na : math.abs(close - start)
    float denom = na(start) or na(ref) or ref == start ? na : math.abs(ref - start)
    int pct     = na(denom) ? na : int(math.round(math.max(0.0, math.min(999.0, curr / denom * 100.0))))
    pct

// ─────────────────────────────────────────────────────────────────────────────
// P1-Anchor (Close) – beim Eintritt in Phase 1
export anchor_p1_close(simple int len, simple float minGap) =>
    var float anc = na
    int pn = mt_phase_num(len, minGap)
    bool enterP1 = pn == 1 and nz(pn[1]) != 1
    if enterP1
        anc := close
    else
        anc := nz(anc[1], anc)
    anc

// ─────────────────────────────────────────────────────────────────────────────
// P1-Anchor (Pivot-H/L) – beim Eintritt in Phase 1 (korrekte Block-IFs)
export anchor_p1_pivot(simple int len, simple float minGap) =>
    var float anc = na

    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow (low,  len, len)

    var float keepLastL = na
    var float keepLastH = na
    if not na(pl)
        keepLastL := pl
    if not na(ph)
        keepLastH := ph

    int  pn        = mt_phase_num(len, minGap)
    bool enteredP1 = pn == 1 and nz(pn[1]) != 1

    if enteredP1
        int  sPH       = ta.barssince(not na(ph))
        int  sPL       = ta.barssince(not na(pl))
        bool lastIsLow = sPL < sPH
        float candidate = lastIsLow ? keepLastL : keepLastH
        anc := na(candidate) ? close : candidate
    else
        anc := nz(anc[1], anc)

    anc

// ─────────────────────────────────────────────────────────────────────────────
// Gruppierung fürs OneRow-Band (0=grün,1=gelb,2=rot,3=grau) + Prozent
export row_group_from_ewo(series float ewoValue, series float atrValue, simple float strongPct, simple float neutralPct) =>
    int grp = 3
    color bg = color.new(color.gray, 60)
    float pct = atrValue == 0 ? 0.0 : math.abs(ewoValue) / atrValue * 100.0
    if pct >= strongPct
        if ewoValue > 0
            grp := 0
            bg  := color.lime
        else if ewoValue < 0
            grp := 2
            bg  := color.red
        else
            grp := 3
            bg  := color.new(color.gray, 60)
    else if pct >= neutralPct
        grp := 1
        bg  := color.yellow
    [grp, bg, pct]

// ─────────────────────────────────────────────────────────────────────────────
// EWO 3/5 an Preis-Pivots (ZigZag-ähnlich), ohne valuewhen
export wave_event_pivot_aligned(series float ewoSeries, simple int left, simple int right, simple float divTolPct, simple int minBarsGap) =>
    float ph = ta.pivothigh(high, left, right)
    float pl = ta.pivotlow (low,  left, right)
    int   phBar = not na(ph) ? bar_index - right : na
    int   plBar = not na(pl) ? bar_index - right : na
    float ewoPH = not na(phBar) ? ewoSeries[right] : na
    float ewoPL = not na(plBar) ? ewoSeries[right] : na
    float prPH  = not na(phBar) ? high[right] : na
    float prPL  = not na(plBar) ? low[right]  : na

    var float upMaxMag   = na
    var float upMaxPrice = na
    var int   upMaxBar   = na

    var float dnMaxMag   = na
    var float dnMaxPrice = na
    var int   dnMaxBar   = na

    int   waveId  = na
    int   waveBar = na
    float waveEwo = na

    if ta.crossunder(ewoSeries, 0)
        upMaxMag   := na
        upMaxPrice := na
        upMaxBar   := na
    if ta.crossover(ewoSeries, 0)
        dnMaxMag   := na
        dnMaxPrice := na
        dnMaxBar   := na

    if not na(phBar) and ewoPH > 0
        bool isNewUp3 = na(upMaxMag) or (ewoPH > upMaxMag)
        if isNewUp3
            upMaxMag   := ewoPH
            upMaxPrice := prPH
            upMaxBar   := phBar
            waveId     := 3
            waveBar    := phBar
            waveEwo    := ewoPH
        else
            float thrUp    = nz(upMaxMag, 0) * (1.0 - divTolPct * 0.01)
            bool farEnough = na(upMaxBar) ? true : (phBar - upMaxBar) >= minBarsGap
            bool priceHH   = not na(prPH) and not na(upMaxPrice) and prPH > upMaxPrice
            bool isW5      = farEnough and priceHH and ewoPH <= thrUp
            if isW5
                waveId  := 5
                waveBar := phBar
                waveEwo := ewoPH

    if not na(plBar) and ewoPL < 0
        float mag = math.abs(ewoPL)
        bool isNewDn3 = na(dnMaxMag) or (mag > dnMaxMag)
        if isNewDn3
            dnMaxMag   := mag
            dnMaxPrice := prPL
            dnMaxBar   := plBar
            waveId     := -3
            waveBar    := plBar
            waveEwo    := ewoPL
        else
            float thrDn    = nz(dnMaxMag, 0) * (1.0 - divTolPct * 0.01)
            bool farEnough = na(dnMaxBar) ? true : (plBar - dnMaxBar) >= minBarsGap
            bool priceLL   = not na(prPL) and not na(dnMaxPrice) and prPL < dnMaxPrice
            bool isM5      = farEnough and priceLL and mag <= thrDn
            if isM5
                waveId  := -5
                waveBar := plBar
                waveEwo := ewoPL

    [waveId, waveBar, waveEwo]
