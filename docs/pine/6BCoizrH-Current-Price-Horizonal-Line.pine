//@version=6
indicator("Current Price Horizonal Line", overlay=true)

lineColor = input.color(color.blue, title="Line Color")
lineWidth = input.int(2, minval=1, maxval=5, title="Line Width")
lineStyleOpt = input.string("Dotted", title="Line Style", options=["Solid", "Dashed", "Dotted"])

lineStyle = lineStyleOpt == "Solid" ? line.style_solid : lineStyleOpt == "Dashed" ? line.style_dashed : line.style_dotted

var line currentLine = na

if not na(currentLine)
    line.delete(currentLine)

if bar_index == last_bar_index
    // currentLine := line.new(x1 = bar_index - 500, y1 = close, x2 = bar_index + 500, y2 = close, color = lineColor, width = lineWidth, style = lineStyle)
    currentLine := line.new(x1=bar_index, y1=close, x2=bar_index + 1, y2=close, xloc=xloc.bar_index, extend=extend.both, color=lineColor, width=lineWidth, style=lineStyle)
