//@version=6
// @description Library holding exact envelope band percentages for stocks Q-Z
library("EnvelopeLibrary_QZ", overlay=true)

export getPct_Q_Z(string symbol, string tf) =>
    float val = -1.0
    val := switch symbol
        "PIDILITIND" => tf == "D" ? 1.75 : tf == "W" ? 3.50 : tf == "M" ? 8.00  : tf == "3M" ? 17.00 : tf == "6M" ? 25.00 : 35.00
        "PIIND"      => tf == "D" ? 2.50 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 18.00 : tf == "6M" ? 28.00 : 38.00
        "PNB"        => tf == "D" ? 3.00 : tf == "W" ? 7.00 : tf == "M" ? 15.00 : tf == "3M" ? 20.00 : tf == "6M" ? 24.00 : 30.00
        "POLYCAB"    => tf == "D" ? 2.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 30.00 : 40.00
        "POWERGRID"  => tf == "D" ? 3.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 14.00 : tf == "6M" ? 13.00 : 17.00
        "RELIANCE"   => tf == "D" ? 1.50 : tf == "W" ? 3.00 : tf == "M" ? 8.00  : tf == "3M" ? 14.00 : tf == "6M" ? 18.00 : 31.00
        "SBIN"       => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 9.00  : tf == "3M" ? 17.00 : tf == "6M" ? 22.00 : 30.00
        "SIEMENS"    => tf == "D" ? 2.00 : tf == "W" ? 4.50 : tf == "M" ? 10.00 : tf == "3M" ? 15.00 : tf == "6M" ? 25.00 : 35.00
        "SONACOMS"   => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 24.00 : tf == "6M" ? 30.00 : 40.00
        "SRF"        => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 12.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 45.00
        "SUNPHARMA"  => tf == "D" ? 3.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 13.00 : tf == "6M" ? 21.00 : 35.00
        "SUPREMEIND" => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 35.00
        "SUZLON"     => tf == "D" ? 3.00 : tf == "W" ? 7.00 : tf == "M" ? 19.00 : tf == "3M" ? 30.00 : tf == "6M" ? 40.00 : 55.00
        "SWIGGY"     => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 10.00 : tf == "3M" ? 0.00  : tf == "6M" ? 0.00  : 0.00
        "TATACHEM"   => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 20.00 : tf == "6M" ? 28.00 : 35.00
        "TATACOMM"   => tf == "D" ? 3.00 : tf == "W" ? 7.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 35.00
        "TATACONSUM" => tf == "D" ? 0.00 : tf == "W" ? 4.00 : tf == "M" ? 10.00 : tf == "3M" ? 15.00 : tf == "6M" ? 25.00 : 30.00
        "TATAPOWER"  => tf == "D" ? 4.00 : tf == "W" ? 8.00 : tf == "M" ? 12.00 : tf == "3M" ? 22.00 : tf == "6M" ? 28.00 : 35.00
        "TATASTEEL"  => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 9.00  : tf == "3M" ? 18.00 : tf == "6M" ? 28.00 : 35.00
        "TCS"        => tf == "D" ? 1.50 : tf == "W" ? 3.00 : tf == "M" ? 7.00  : tf == "3M" ? 12.00 : tf == "6M" ? 18.00 : 22.00
        "TECHM"      => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 10.00 : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 35.00
        "TITAN"      => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 18.00 : tf == "6M" ? 30.00 : 50.00
        "TRENT"      => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 32.00
        "TVSMOTOR"   => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 10.00 : tf == "3M" ? 20.00 : tf == "6M" ? 27.00 : 40.00
        "ULTRACEMCO" => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 15.00 : tf == "6M" ? 21.00 : 26.00
        "UNIONBANK"  => tf == "D" ? 2.00 : tf == "W" ? 6.00 : tf == "M" ? 15.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 40.00
        "UPL"        => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 9.00  : tf == "3M" ? 17.00 : tf == "6M" ? 25.00 : 30.00
        "VBL"        => tf == "D" ? 3.00 : tf == "W" ? 7.00 : tf == "M" ? 13.00 : tf == "3M" ? 18.00 : tf == "6M" ? 20.00 : 30.00
        "VEDL"       => tf == "D" ? 3.00 : tf == "W" ? 7.00 : tf == "M" ? 12.00 : tf == "3M" ? 21.00 : tf == "6M" ? 35.00 : 45.00
        "VOLTAS"     => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 40.00
        "WAAREEENER" => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 9.00  : tf == "3M" ? 0.00  : tf == "6M" ? 0.00  : 0.00
        "WIPRO"      => tf == "D" ? 3.00 : tf == "W" ? 4.00 : tf == "M" ? 6.00  : tf == "3M" ? 15.00 : tf == "6M" ? 25.00 : 30.00
        "YESBANK"    => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 16.00 : tf == "3M" ? 26.00 : tf == "6M" ? 0.00  : 0.00
        "ZYDUSLIFE"  => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 10.00 : tf == "3M" ? 20.00 : tf == "6M" ? 28.00 : 35.00
        => -1.0
    val