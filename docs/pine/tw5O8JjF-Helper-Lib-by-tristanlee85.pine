//@version=6
//@description   This library offers various functions and types based on the algorithmic 
//               concepts as authored by ICT.
library("helpers")

const string DATE_FORMAT      = "MM-dd (E)"
const string TIME_FORMAT      = "HH:mm"
const string NUMBER_FORMAT    = "#.0000"
const string DEFAULT_TIMEZONE = "America/New_York"
const string DEFAULT_INTERVAL = "1"

__debug(bool enabled = false, array<string> stack, string s, bool expr, string arg1 = na, string arg2 = na, string arg3 = na, string arg4 = na, string arg5 = na) =>
    if enabled
        array<string> msg = array.new_string(1, str.format("\n{0}", s))
        
        if not na(arg1)
            msg.push(str.format("- {0}", arg1))
        if not na(arg2)
            msg.push(str.format("- {0}", arg2))
        if not na(arg3)
            msg.push(str.format("- {0}", arg3))
        if not na(arg4)
            msg.push(str.format("- {0}", arg4))
        if not na(arg5)
            msg.push(str.format("- {0}", arg5))

        if expr
            string prefix = "\n"
            if array.size(stack) > 0
                prefix := "\n[" + array.join(stack, "::") + "] "
            log.info(prefix + msg.join("\n"))

// Returns the value if it is not `na`, otherwise returns the default value.
val(string v, string d) =>
    not na(v) ? v : d

// #region ———————————————————— Debugging

// @function    Returns a string of the key/value set, suitable for debug logging
// @param       key
// @param       value
// @returns     A string formatted as "{key}: {value}"
export kv(string key, string value) => str.format("{0}: {1}", key, value)
export kv(string key, int value) => kv(key, str.tostring(value))
export kv(string key, float value) => kv(key, str.tostring(value))
export kv(string key, bool value) => kv(key, str.tostring(value))

// @type         A debug logging utility with group support
// @field        enabled 
export type Debugger
    bool enabled = false
    array<string> _debugGroupStack

// @function    Enable/Disable debug logging
// @param       enable Set to `true` by default.
export method enable(Debugger this, bool enable = true) =>
    this.enabled := enable

// @function    Creates a group label for nested debug() invocations
// @param       label
export method group(Debugger this, string label) =>
    if na(this._debugGroupStack)
        this._debugGroupStack := array.new_string()
    array.push(this._debugGroupStack, label)

// @function    Ends the specified debug group
// @param       label
export method groupEnd(Debugger this, string label) =>
    if array.size(this._debugGroupStack) > 0
        last = array.pop(this._debugGroupStack)
        if last != label
            log.warning(str.format("[log] Unmatched group end: expected '{0}', got '{1}'", last, label))

// @function    Logs the param values if debug mode is enabled
// @param       s Title of the log message
// @param       arg* Additional values to log (up to 5)
export method log(Debugger this, string s, string arg1 = na, string arg2 = na, string arg3 = na, string arg4 = na, string arg5 = na) =>
    __debug(this.enabled, this._debugGroupStack, s, true, arg1, arg2, arg3, arg4, arg5)

// @function    Same behavior as debug() except will only log if the passed expression is true
// @param       expr Boolean expression to determine if debug logs should be logged
// @param       s Title of the log message
// @param       arg* Additional values to log (up to 5)
export method logIf(Debugger this, bool expr, string s, string arg1 = na, string arg2 = na, string arg3 = na, string arg4 = na, string arg5 = na) =>
    __debug(this.enabled, this._debugGroupStack, s, expr, arg1, arg2, arg3, arg4, arg5)

// #endregion

// #region ———————————————————— Enumerations

// @enum           Options for extending across sessions
// @field          CURRENT_SESSION    Current Session
// @field          NEXT_SESSION       Next Session
// @field          CURRENT_BAR        Current Bar
export enum SessionExtendType
    CURRENT_SESSION = "Current Session"
    NEXT_SESSION    = "Next Session"
    CURRENT_BAR     = "Current Bar"

// @enum           Provides line style options for chart drawing
// @field          SOLID   Solid line style
// @field          DASH    Dashed line style
// @field          DOTS    Dotted line style
export enum LineStyleType
    SOLID = "Solid"
    DASH  = "Dashed"
    DOTS  = "Dotted"

// @enum           Horizontal text align options
// @field          LEFT    Left align
// @field          CENTER  Center align
// @field          RIGHT   Right align
export enum HAlignType
    LEFT   = "left"
    CENTER = "center"
    RIGHT  = "right"

// @enum           Vertical text align options
// @field          TOP     Top align
// @field          MIDDLE  Middle align
// @field          BOTTOM  Bottom align
export enum VAlignType
    TOP   = "top"
    MIDDLE = "middle"
    BOTTOM  = "bottom"

// @enum           Text size options
// @field          TINY    Tiny text size
// @field          SMALL   Small text size
// @field          NORMAL  Normal text size
// @field          LARGE   Large text size
// @field          HUGE    Huge text size
export enum TextSizeType
    TINY   = "Tiny"
    SMALL  = "Small"
    NORMAL = "Normal"
    LARGE  = "Large"
    HUGE   = "Huge"

// @enum           Indicates market sentiment
// @field          BULLISH    Bullish sentiment represented as "+"
// @field          BEARISH    Bearish sentiment represented as "-"
export enum SentimentType
    BULLISH = "+"
    BEARISH = "-"

// @enum           Identifies the type of swing point
// @field          HIGH   A high swing point
// @field          LOW    A low swing point
export enum SwingPointType
    HIGH = "High"
    LOW  = "Low"

// @enum           Identifiers for various PD arrays
// @field          FVG         Fair Value Gap (abbreviated)
// @field          FVG_FULL    Full description of Fair Value Gap
// @field          IFVG        Inversion Fair Value Gap (abbreviated)
// @field          IFVG_FULL   Full description of Inversion Fair Value Gap
// @field          VI          Volume Imbalance (abbreviated)
// @field          VI_FULL     Full description of Volume Imbalance
// @field          LV          Liquidity Void (abbreviated)
// @field          LV_FULL     Full description of Liquidity Void
// @field          OB          Order Block (abbreviated)
// @field          OB_FULL     Full description of Order Block
// @field          BRKR        Breaker (abbreviated)
// @field          BRKR_FULL   Full description of Breaker
export enum PDArrayType
    FVG       = "FVG"
    FVG_FULL  = "Fair Value Gap"
    IFVG      = "IFVG"
    IFVG_FULL = "Inversion Fair Value Gap"
    VI        = "VI"
    VI_FULL   = "Volume Imbalance"
    LV        = "LV"
    LV_FULL   = "Liquidity Void"
    OB        = "OB"
    OB_FULL   = "Order Block"
    BRKR      = "BRKR"
    BRKR_FULL = "Breaker"

// #endregion

// #region ———————————————————— Text, style, and label formatting functions

// @function     Returns the corresponding line style constant for the given LineStyleType
// @param        opt   The selected line style type
// @returns      The Pine Script line style constant
export style_getLineStyleFromType(LineStyleType opt) =>
    result = switch opt
        LineStyleType.SOLID => line.style_solid
        LineStyleType.DASH  => line.style_dashed
        LineStyleType.DOTS  => line.style_dotted

// @function     Returns the corresponding text size constant for the given TextSizeType
// @param        opt   The selected text size type
// @returns      The Pine Script text size constant
export style_getTextSizeFromType(TextSizeType opt) =>
    result = switch opt
        TextSizeType.TINY   => size.tiny
        TextSizeType.SMALL  => size.small
        TextSizeType.NORMAL => size.normal
        TextSizeType.LARGE  => size.large
        TextSizeType.HUGE   => size.huge

// @function     Returns the corresponding horizontal text align constant for the given HAlignType
// @param        t   The selected text align type
// @param        invert Whether to invert the text alignment type (left > right | right > left) 
// @returns      The Pine Script text align constant
export style_getTextHAlignFromType(HAlignType t, bool invert = false) =>
    result = switch t
        HAlignType.LEFT   => not invert ? text.align_left : text.align_right
        HAlignType.CENTER => text.align_center
        HAlignType.RIGHT  => not invert ? text.align_right : text.align_left

// @function     Returns the corresponding vertical text align constant for the given VAlignType
// @param        t   The selected text align type
// @param        invert Whether to invert the text alignment type (top > bottom | bottom > top) 
// @returns      The Pine Script text align constant
export style_getTextVAlignFromType(VAlignType t, bool invert = false) =>
    result = switch t
        VAlignType.TOP     => not invert ? text.align_top : text.align_bottom
        VAlignType.MIDDLE  => text.align_center
        VAlignType.BOTTOM  => not invert ? text.align_bottom : text.align_top

// @function     Used to produce a string with the sentiment and PD array type (e.g., "+FVG")
// @param        sentiment   The sentiment value (e.g., SentimentType.BULLISH)
// @param        pd          The price data array (e.g., PDArrayType.FVG)
// @returns      A formatted string with the sentiment and PD array (e.g., "+FVG")
export format_sentimentType(SentimentType sentiment, PDArrayType pd) => str.format("{0}{1}", str.tostring(sentiment), str.tostring(pd))
// #endregion

// #region ———————————————————— Time formatting functions

// @function     Formats a UNIX timestamp into a date and time string based on predefined formats
// @param        timestamp   The UNIX timestamp to format
// @returns      A formatted string as "MM-dd (E) - HH:mm"
export format_timeToString(int timestamp) =>
    string dateStr = str.format_time(timestamp, DATE_FORMAT, DEFAULT_TIMEZONE)
    string timeStr = str.format_time(timestamp, TIME_FORMAT, DEFAULT_TIMEZONE)
    str.format("{0} - {1}", dateStr, timeStr)

// @function     Determines session start and end times based on a given session range and timezone
// @param        session    The session string (e.g., "1300-1400")
// @param        timezone   The timezone identifier (default is "America/New_York")
// @param        interval   The time interval (default is "1" minute)
// @returns      A tuple `[current time, session start, session end]` if within session; otherwise, `na`
// export parseSessionToTime(string session, string timezone = na, string interval = na) =>
//     var string tz    = val(timezone, DEFAULT_TIMEZONE)
//     var string intvl = val(interval, DEFAULT_INTERVAL)
//     varip int t = time(intvl, session, tz)

//     // The goal here is to take a session (e.g., "1300-1400") and turn it into start and end
//     // timestamps

//     // Splitting session to [HHmm, HHmm]
//     // varip array<string> start_end = str.split(session, "-")
//     // varip string start_HHmm = start_end.get(0)
//     // varip string end_HHmm = start_end.get(1)
//     varip float start_HH = str.tonumber(str.substring(session, 0, 2))
//     varip float start_mm = str.tonumber(str.substring(session, 2, 4))
//     varip float end_HH = str.tonumber(str.substring(session, 5, 7))
//     varip float end_mm = str.tonumber(str.substring(session, 7, 9))
//     varip int domInc = start_HH == 0 ? 1 : 0 // Midnight hour increments to the next day

//     if not na(t)
//         start  = timestamp(tz, year(t), month(t), dayofmonth(t) + domInc, int(start_HH), int(start_mm))
//         end    = timestamp(tz, year(t), month(t), dayofmonth(t) + domInc, int(end_HH), int(end_mm))
//         [t, start, end]

// @function     Parses a session string (e.g., "1300-1400") to start/end hour and minute numbers
// @param        session    The session string (e.g., "1300-1400")
// @returns      A tuple `[start_HH, start_mm, end_HH, end_mm]` of float values
export parseSessionString(string session) =>
    float start_HH = str.tonumber(str.substring(session, 0, 2))
    float start_mm = str.tonumber(str.substring(session, 2, 4))
    float end_HH = str.tonumber(str.substring(session, 5, 7))
    float end_mm = str.tonumber(str.substring(session, 7, 9))
    [start_HH, start_mm, end_HH, end_mm]

// @function     Returns [year, month, day] for a timestamp in DEFAULT_TIMEZONE
getDatePartsInTz(int ts) =>
    // e.g. "2025-11-21"
    string d = str.format_time(ts, "yyyy-MM-dd", DEFAULT_TIMEZONE)
    int y = int(str.tonumber(str.substring(d, 0, 4)))
    int m = int(str.tonumber(str.substring(d, 5, 7)))
    int day = int(str.tonumber(str.substring(d, 8, 10)))
    [y, m, day]

// #endregion

// #region ———————————————————— Types and methods

// @type         Defines a trading session with a name and time range. When creating a new instance of this type, you MUST call init() immediately.
// @field        name        A display-friendly name (e.g., "NY AM")
// @field        session     A string defining the session time range (e.g., "1300-1400")
// @field        enabled     Optional flag for custom logic; defaults to false
// @field        start       UNIX time representing the session start (set via isActive())
// @field        end         UNIX time representing the session end (set via isActive())
export type Session
    string name
    string session
    bool   enabled = false
    int    start
    int    end
    int    _t
    float  _start_HH
    float  _start_mm
    float  _end_HH
    float  _end_mm

// @function     Initializes the session and validates the configuration. This MUST be called immediately after creating a new instance.
// @param        this    The Session object reference
// @returns      The Session object (chainable) or throws a runtime error if invalid
export method init(Session this) =>
    if this.enabled
        if str.length(this.session) == 0
            runtime.error(str.format(
              "Invalid time range for session '{0}'. Either configure a time or disable the session.", 
              this.name))
        else
            string err = na
            [start_HH, start_mm, end_HH, end_mm] = parseSessionString(this.session)
            this._start_HH := start_HH
            this._start_mm := start_mm
            this._end_HH := end_HH
            this._end_mm := end_mm

            // TODO validate the parsed session to ensure there's no overlap

            if not na(err)
                runtime.error(str.format("Invalid session for {0}: {1}.", this.name, err))
    log.info(str.format("{0}, {1}", this._start_HH, this._end_HH))
    this

// @function     Determines if the session is active based on the current bar time
// @param        this    The Session object reference
// @returns      `true` if the session is currently active; `false` otherwise
export method isActive(Session this, int _time = time) =>
    log.info(str.format("Checking if current time ({0}) is in session {1}", str.format_time(_time, "HH:mm:ssZ", DEFAULT_TIMEZONE), this.session))
    int t = time(DEFAULT_INTERVAL, this.session, DEFAULT_TIMEZONE)
    log.info(na(t) ? "Not in session" : "In session")

    if na(this._start_HH)
        runtime.error("Session instance is incomplete. Did you forget to call init()?")

    // Current time is not valid for this session, but a start time is set, indicating
    // the session just ended. Reset the session for next use.
    if na(t) and not na(this.start)
        log.info("Session has ended")
        this.start := na
        this.end   := na
    
    // Current time is valid for the session in its reset state, indicating the start 
    // of the new session.
    else if not na(t) and na(this.start)
        [y, m, d] = getDatePartsInTz(t)
        this.start  := timestamp(DEFAULT_TIMEZONE, y, m, d, int(this._start_HH), int(this._start_mm))
        this.end    := timestamp(DEFAULT_TIMEZONE, y, m, d, int(this._end_HH), int(this._end_mm))
    
    // Returns true for active session
    not na(t)

// @type         Represents a price inefficiency (gap) with details on sentiment and price levels
// @field        type        The sentiment of the gap (e.g., SentimentType.BULLISH)
// @field        name        A display-friendly name (e.g., "+FVG")
// @field        startTime   UNIX time value for the gap's start
// @field        endTime     UNIX time value for the gap's end
// @field        startIndex  Bar index where the gap starts
// @field        endIndex    Bar index where the gap ends
// @field        gapLow      The lowest price level of the gap
// @field        gapHigh     The highest price level of the gap
// @field        ce          The consequent encroachment level of the gap
export type Gap
    SentimentType type
    string        name
    int           startTime
    int           endTime
    int           startIndex
    int           endIndex
    float         gapLow
    float         gapHigh
    float         ce

// @type         Represents a swing point with details on type and price level
// @field        type        The type of swing point (e.g., SwingPointType.HIGH)
// @field        time        UNIX time value for the swing point
// @field        barIdx      Bar index where the swing point occurs
// @field        price       The price level of the swing point which is either the high or low of the middle bar
export type SwingPoint
    SwingPointType type
    int            time
    int            barIdx
    float          price

// @type         Combines a line and box type to produce a line with a label that is properly aligned
// @field        x           The X-axis starting point as a bar index
// @field        y           The Y-axis starting point as the price level
// @field        color       Both the line and text color
// @field        width       Thickness of the line
// @field        label       Text to display
// @field        showLabel   Boolean to conditionally show/hide the label (default is false)
// @field        lineStyle   The style of the line        
export type LineLabel
    int           x
    float         y
    color         color
    int           width
    string        label = ""
    bool          showLabel = false
    LineStyleType lineStyle = LineStyleType.SOLID
    TextSizeType  textSize = TextSizeType.SMALL
    box           _b
    line          _l

// @function     Draws the line and optional label
// @param        this    The LineLabel object reference
// @returns      The LineLabel object (chainable)
export method draw(LineLabel this, string xloc = xloc.bar_index ) =>
    string textSize = style_getTextSizeFromType(this.textSize)
    string textHAlign = text.align_right
    string textVAlign = text.align_bottom
    this._l := line.new(
      x1=this.x, y1=this.y, x2=this.x, y2=this.y, xloc=xloc,
      color=this.color, style=style_getLineStyleFromType(this.lineStyle), width=this.width)
    if this.showLabel
        this._b := box.new(
          left=this.x, top=this.y, right=this.x, bottom=this.y, xloc=xloc,
          bgcolor=color.new(color.black, 100), border_width=0,
          text=this.label, text_color=this.color, text_size=textSize, text_halign=textHAlign, text_valign=textVAlign)
    this

// @function     Extends the line and label right to the specified bar index
// @param        this    The LineLabel object reference
// @param        x       The bar index to extend to
// @returns      The LineLabel object (chainable)
export method extend(LineLabel this, int x) =>
    this._l.set_x2(x)
    this._b.set_right(x)

// @function     Removes the line and label from the chart
// @param        this    The LineLabel object reference
// @returns      
export method destroy(LineLabel this) =>
    this._l.delete()
    if not na(this._b)
        this._b.delete()

// #endregion

// #region ———————————————————— Gap type and detection functions

// @function     Checks if the previous bars form a Fair Value Gap (FVG)
// @param        includeVI   If true, includes Volume Imbalance in the FVG calculation
// @param        barIdx      The index of the bar to check from (default is 0 for the current bar)
// @returns      A Gap object if a FVG is detected; otherwise, `na`
export isFVG(bool includeVI = true, int barIdx = 0) =>
    i       = barIdx
    Gap fvg = na

    if barstate.isconfirmed and high[1 + i] > high[2 + i] and low[i] > high[2 + i]
        float gapTop    = includeVI and close[i] > open[i] and open[i] > close[1 + i] ? open[i] : low[i]
        float gapBottom = includeVI and open[2 + i] < close[2 + i] and close[2 + i] < open[1 + i] ? close[2 + i] : high[2 + i]
        fvg := Gap.new(SentimentType.BULLISH,
                      format_sentimentType(SentimentType.BULLISH, PDArrayType.FVG),
                      time[2 + i], time[i],
                      bar_index[2 + i], bar_index[i],
                      gapBottom, gapTop,
                      math.avg(gapBottom, gapTop))
    else if barstate.isconfirmed and low[1 + i] < low[2 + i] and high[i] < low[2 + i]
        float gapTop    = includeVI and open[2 + i] > close[2 + i] and close[2 + i] > open[1 + i] ? close[2 + i] : low[2 + i]
        float gapBottom = includeVI and open[i] > close[i] and open[i] < close[1 + i] ? open[i] : high[i]
        fvg := Gap.new(SentimentType.BEARISH,
                      format_sentimentType(SentimentType.BEARISH, PDArrayType.FVG),
                      time[2 + i], time[i],
                      bar_index[2 + i], bar_index[i],
                      gapBottom, gapTop,
                      math.avg(gapBottom, gapTop))
    fvg

// @function     Checks if the previous bars form a Volume Imbalance (VI)
// @param        barIdx   The index of the bar to check from (default is 0 for the current bar)
// @returns      A Gap object if a VI is detected; otherwise, `na`
export isVolumeImbalance(int barIdx = 0) =>
    i      = barIdx
    Gap vi = na

    if barstate.isconfirmed and open[i] > close[1 + i] and close[i] > close[1 + i] and close[1 + i] > open[1 + i]
        vi := Gap.new(SentimentType.BULLISH,
                     format_sentimentType(SentimentType.BULLISH, PDArrayType.VI),
                     time[2 + i], time[i],
                     bar_index[2 + i], bar_index[i],
                     close[1 + i], open[i],
                     math.avg(close[1 + i], open[i]))
    else if barstate.isconfirmed and open[i] < close[1 + i] and close[i] < close[1 + i] and close[1 + i] < open[1 + i]
        vi := Gap.new(SentimentType.BEARISH,
                     format_sentimentType(SentimentType.BEARISH, PDArrayType.VI),
                     time[2 + i], time[i],
                     bar_index[2 + i], bar_index[i],
                     open[i], close[1 + i],
                     math.avg(open[i], close[1 + i]))
    vi

// @function     Checks if the previous bars form a Liquidity Void (LV)
// @param        barIdx   The index of the bar to check from (default is 0 for the current bar)
// @returns      A Gap object if an LV is detected; otherwise, `na`
export isLiquidityVoid(int barIdx = 0) =>
    i      = barIdx
    Gap lv = na

    if barstate.isconfirmed and low[i] > high[1 + i]
        lv := Gap.new(SentimentType.BULLISH,
                     format_sentimentType(SentimentType.BULLISH, PDArrayType.LV),
                     time[2 + i], time[i],
                     bar_index[2 + i], bar_index[i],
                     high[1 + i], low[i],
                     math.avg(high[1 + i], low[i]))
    else if barstate.isconfirmed and high[i] < low[1 + i]
        lv := Gap.new(SentimentType.BEARISH,
                     format_sentimentType(SentimentType.BULLISH, PDArrayType.LV),
                     time[2 + i], time[i],
                     bar_index[2 + i], bar_index[i],
                     high[i], low[1 + i],
                     math.avg(high[i], low[1 + i]))
    lv

// @function     Checks if the previous bars form a swing point
// @param        barIdx   The index of the bar to check from (default is 0 for the current bar)
// @returns      A SwingPoint object if a swing point is detected; otherwise, `na`
export isSwingPoint(int barIdx = 0) =>
    i = barIdx
    SwingPoint swingPoint = na

    if barstate.isconfirmed and high[1 + i] > high[i] and high[1 + i] > high[2 + i]
        swingPoint := SwingPoint.new(SwingPointType.HIGH, time[1 + i], bar_index[1 + i], high[1 + i])
    else if barstate.isconfirmed and low[1 + i] < low[i] and low[1 + i] < low[2 + i]
        swingPoint := SwingPoint.new(SwingPointType.LOW, time[1 + i], bar_index[1 + i], low[1 + i])
    swingPoint

// #endregion