// Original: alpine_trader
// Low-zone detection added

//@version=6
indicator(
     title = "ADR% - Average Daily Range % with Low Zone",
     shorttitle = "ADR% Compression Zone",
     overlay = false
)

//──────────────────────────────────────────────────────────────────────────────
// Settings
//──────────────────────────────────────────────────────────────────────────────

adrLength = input.int(
     20,
     title = "ADR Length",
     minval = 1
)

floorLookback = input.int(
     90,
     title = "Low-zone lookback, days",
     minval = 20,
     tooltip = "The lookback period used to determine the local ADR floor"
)

floorPercentile = input.float(
     10.0,
     title = "Floor percentile",
     minval = 1,
     maxval = 30,
     step = 1,
     tooltip = "For example, 10 represents the lowest 10% of ADR values over the selected lookback period"
)

zoneTolerance = input.float(
     15.0,
     title = "Low-zone tolerance, %",
     minval = 0,
     step = 1,
     tooltip = "How far ADR may rise above the local floor while still being considered inside the low zone"
)

showBackground = input.bool(
     true,
     title = "Highlight low zone"
)

showFloor = input.bool(
     true,
     title = "Show calculated floor"
)

//──────────────────────────────────────────────────────────────────────────────
// Daily calculations
// Calculations are performed in the daily context, regardless of the chart timeframe.
//──────────────────────────────────────────────────────────────────────────────

calculateAdrAndFloor(
     int adrPeriod,
     int floorPeriod,
     float percentile
) =>
    float currentAdr =
         100 * (ta.sma(high / low, adrPeriod) - 1)

    // Exclude the current bar so today's ADR does not move
    // the reference floor used to evaluate itself.
    float currentFloor =
         ta.percentile_nearest_rank(
             currentAdr[1],
             floorPeriod,
             percentile
         )

    [currentAdr, currentFloor]

[adr, adrFloor] = request.security(
     syminfo.tickerid,
     "D",
     calculateAdrAndFloor(
         adrLength,
         floorLookback,
         floorPercentile
     ),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

//──────────────────────────────────────────────────────────────────────────────
// Low zone
//──────────────────────────────────────────────────────────────────────────────

lowZoneThreshold = adrFloor * (1 + zoneTolerance / 100)

inLowZone =
     not na(lowZoneThreshold) and
     adr <= lowZoneThreshold

// True only on the first bar after entering the low zone.
enteredLowZone =
     inLowZone and
     not inLowZone[1]

//──────────────────────────────────────────────────────────────────────────────
// Display
//──────────────────────────────────────────────────────────────────────────────

plot(
     adr,
     title = "ADR",
     color = color.orange,
     linewidth = 2
)

plot(
     showFloor ? adrFloor : na,
     title = "ADR Local Floor",
     color = color.new(color.aqua, 25),
     linewidth = 1
)

plot(
     showFloor ? lowZoneThreshold : na,
     title = "Low-zone Threshold",
     color = color.new(color.yellow, 15),
     linewidth = 1
)

bgcolor(
     showBackground and inLowZone
         ? color.new(color.green, 88)
         : na,
     title = "ADR Low Zone"
)

plotshape(
     enteredLowZone ? adr : na,
     title = "Entered Low Zone",
     style = shape.labelup,
     location = location.absolute,
     color = color.green,
     text = "LOW",
     textcolor = color.white,
     size = size.tiny
)

// Hidden numeric representation of the low-zone state for alert placeholders.
plot(
     inLowZone ? 1 : 0,
     title = "InLowZone",
     display = display.none
)

//──────────────────────────────────────────────────────────────────────────────
// Alert
//──────────────────────────────────────────────────────────────────────────────

alertcondition(
     enteredLowZone,
     title = "ADR entered low zone",
     message = "ADR% entered its local low zone on {{ticker}}"
)