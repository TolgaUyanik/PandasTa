//@version=6
indicator("New York 6 PM High & Low", overlay = true, max_lines_count = 500)

// ─────────────────────────────────────────────
// Settings
// ─────────────────────────────────────────────
string timeZone = "America/New_York"

int projectionDays = input.int(
     30,
     "Projection length in days",
     minval = 1,
     maxval = 365
)

bool keepPrevious = input.bool(
     true,
     "Keep previous 6 PM levels"
)

color highColor = input.color(color.red, "High line color")
color lowColor  = input.color(color.lime, "Low line color")

int lineWidth = input.int(
     2,
     "Line width",
     minval = 1,
     maxval = 5
)

// 30 calendar days expressed in milliseconds.
int projectionMilliseconds = projectionDays * 24 * 60 * 60 * 1000

// Detect the candle that opens at 6:00 PM New York time.
bool isNewYork6PM =
     hour(time, timeZone) == 18 and
     minute(time, timeZone) == 0

// Store the most recent lines.
var line highLine = na
var line lowLine  = na

// Wait until the 6 PM candle closes so its final high and low are known.
if isNewYork6PM and barstate.isconfirmed
    if not keepPrevious
        if not na(highLine)
            line.delete(highLine)

        if not na(lowLine)
            line.delete(lowLine)

    int lineStart = time
    int lineEnd   = time + projectionMilliseconds

    highLine := line.new(
         x1 = lineStart,
         y1 = high,
         x2 = lineEnd,
         y2 = high,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = highColor,
         width = lineWidth
    )

    lowLine := line.new(
         x1 = lineStart,
         y1 = low,
         x2 = lineEnd,
         y2 = low,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = lowColor,
         width = lineWidth
    )