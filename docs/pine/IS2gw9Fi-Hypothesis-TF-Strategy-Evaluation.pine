//                               ,,,,,,,,,,,, ,,                                    {||}          
//                                  ,,,,,,,,,                                       {||}                                                                                                                                  
//                                                                                  {||} 
//                                                                                  {||} 

//@version=6
indicator("Hypothesis TF Strategy Evaluation", overlay = true)

// User inputs:
// quantile_length: window size for calculating quartiles Q1 and Q3
// stats_lookback: how many bars back to use for ROC classification and stats
quantile_length = input.int(20, "Quantile Window Length", minval = 5)
stats_lookback  = input.int(500, "Lookback Range for ROC Classification", minval = 10)

// Calculate 1-period Rate of Change (ROC) on close prices
roc = ta.roc(close, 1)

// --- Function to calculate quantile (e.g. Q1=0.25, Q3=0.75) of an array ---
f_quantile(float[] arr, float q) =>
    sorted = array.copy(arr)              // copy and sort to avoid modifying original array
    array.sort(sorted, order.ascending)
    index = math.round((array.size(sorted) - 1) * q)  // position of quantile
    array.get(sorted, index)

// --- Function to compute average of values in an array ---
f_avg(float[] arr) =>
    sz = array.size(arr)
    sz == 0 ? na : array.sum(arr) / sz

// --- Function to compute sample variance of array given its mean ---
f_var(float[] arr, float mean) =>
    sz = array.size(arr)
    if sz <= 1
        na
    else
        sum_sq = 0.0
        for i = 0 to sz - 1
            x = array.get(arr, i)
            sum_sq += math.pow(x - mean, 2)
        sum_sq / (sz - 1)

// --- Welch's t-statistic between two samples (means, variances, sample sizes) ---
// Used to test if means of two groups differ significantly, allowing unequal variances
f_t_stat(float mean1, float var1, int n1, float mean2, float var2, int n2) =>
    t_num = mean1 - mean2
    t_denom = math.sqrt(var1 / n1 + var2 / n2)
    t_denom == 0 ? na : t_num / t_denom

// --- Function to add significance stars based on t-statistic ---
// "*" for 95% significance, "**" for 99% significance, "" otherwise
signif(t) =>
    abs_t = math.abs(t)
    abs_t > 2.576 ? "**" : abs_t > 1.96 ? "*" : ""

// === Per-bar rolling calculation of Q1 and Q3 for current bar ===
float q1 = na
float q3 = na

if bar_index >= quantile_length
    float[] window = array.new_float()
    for i = 0 to quantile_length - 1
        array.push(window, close[i])
    q1 := f_quantile(window, 0.25)  // 25th percentile (Q1)
    q3 := f_quantile(window, 0.75)  // 75th percentile (Q3)

// === Arrays to collect ROC values grouped by close price relative to Q1/Q3 ===
var float[] above_q3 = array.new_float()
var float[] below_q1 = array.new_float()
var float[] between  = array.new_float()

// At last bar, compute groups for last stats_lookback bars
if barstate.islast and bar_index > stats_lookback + quantile_length
    for i = 0 to stats_lookback - 1
        float[] w = array.new_float()
        for j = 0 to quantile_length - 1
            array.push(w, close[i + j])
        q1_ = f_quantile(w, 0.25)
        q3_ = f_quantile(w, 0.75)

        // Categorize ROC[i] by whether close[i] > Q3, < Q1, or in between
        if close[i + 1] > q3_
            array.push(above_q3, roc[i])
        else if close[i + 1] < q1_
            array.push(below_q1, roc[i])
        else
            array.push(between, roc[i])

    // Calculate mean, variance, and count (N) for each group
    avg_above = f_avg(above_q3)
    avg_below = f_avg(below_q1)
    avg_middle = f_avg(between)

    var_above = f_var(above_q3, avg_above)
    var_below = f_var(below_q1, avg_below)
    var_middle = f_var(between, avg_middle)

    n_above = array.size(above_q3)
    n_below = array.size(below_q1)
    n_middle = array.size(between)

    // Calculate Welch's t-statistics between groups for hypothesis testing
    t_above_vs_middle = f_t_stat(avg_above, var_above, n_above, avg_middle, var_middle, n_middle)
    t_below_vs_middle = f_t_stat(avg_below, var_below, n_below, avg_middle, var_middle, n_middle)
    t_above_vs_below  = f_t_stat(avg_above, var_above, n_above, avg_below, var_below, n_below)

    // === TABLE 1: Summary of groups (bottom right) showing mean ROC and sample size N ===
    var table summary = table.new(position.bottom_right, 3, 4, frame_color=color.gray, bgcolor=color.new(color.white, 85))
    table.cell(summary, 0, 0, "Group", text_color=color.white)
    table.cell(summary, 1, 0, "Avg ROC", text_color=color.white)
    table.cell(summary, 2, 0, "N", text_color=color.white)

    table.cell(summary, 0, 1, "Above Q3", text_color=color.green)
    table.cell(summary, 1, 1, str.tostring(avg_above, format.percent), text_color=color.green)
    table.cell(summary, 2, 1, str.tostring(n_above), text_color=color.green)

    table.cell(summary, 0, 2, "Between", text_color=color.gray)
    table.cell(summary, 1, 2, str.tostring(avg_middle, format.percent), text_color=color.gray)
    table.cell(summary, 2, 2, str.tostring(n_middle), text_color=color.gray)

    table.cell(summary, 0, 3, "Below Q1", text_color=color.red)
    table.cell(summary, 1, 3, str.tostring(avg_below, format.percent), text_color=color.red)
    table.cell(summary, 2, 3, str.tostring(n_below), text_color=color.red)

    // === TABLE 2: Hypothesis Testing Matrix (top right) showing pairwise Welch t-test results and significance stars ===
    var table mat = table.new(position.top_right, 4, 4, border_width=1, frame_color=color.gray, bgcolor=color.new(color.white, 85))

    // Table headers
    table.cell(mat, 0, 0, "vs", text_color=color.white, text_halign=text.align_center)
    table.cell(mat, 1, 0, "Above Q3", text_color=color.green)
    table.cell(mat, 2, 0, "Between", text_color=color.gray)
    table.cell(mat, 3, 0, "Below Q1", text_color=color.red)

    table.cell(mat, 0, 1, "Above Q3", text_color=color.green)
    // Diagonal: show group name + N
    table.cell(mat, 1, 1, "Above Q3\n(N=" + str.tostring(n_above) + ")", text_color=color.green)
    // Off-diagonal: t-statistic and significance star
    table.cell(mat, 2, 1, "t=" + str.tostring(t_above_vs_middle, "#.##") + signif(t_above_vs_middle), text_color=color.green)
    table.cell(mat, 3, 1, "t=" + str.tostring(t_above_vs_below, "#.##") + signif(t_above_vs_below), text_color=color.green)

    table.cell(mat, 0, 2, "Between", text_color=color.gray)
    table.cell(mat, 1, 2, "t=" + str.tostring(-t_above_vs_middle, "#.##") + signif(t_above_vs_middle), text_color=color.gray)
    table.cell(mat, 2, 2, "Between\n(N=" + str.tostring(n_middle) + ")", text_color=color.gray)
    table.cell(mat, 3, 2, "t=" + str.tostring(t_below_vs_middle, "#.##") + signif(t_below_vs_middle), text_color=color.gray)

    table.cell(mat, 0, 3, "Below Q1", text_color=color.red)
    table.cell(mat, 1, 3, "t=" + str.tostring(-t_above_vs_below, "#.##") + signif(t_above_vs_below), text_color=color.red)
    table.cell(mat, 2, 3, "t=" + str.tostring(-t_below_vs_middle, "#.##") + signif(t_below_vs_middle), text_color=color.red)
    table.cell(mat, 3, 3, "Below Q1\n(N=" + str.tostring(n_below) + ")", text_color=color.red)

// === Plot Q1 and Q3 lines on the chart for visual reference ===
plot(q1, title = "Q1", color = color.red, linewidth = 2)
plot(q3, title = "Q3", color = color.green, linewidth = 2)

barc = close[1] > q3 ? color.green : close[1] < q1 ? color.red : color.gray
barcolor(barc)

// ===================================================================================
// NOTE:
// This script is intended as a tool for evaluating trend-following strategies by 
// testing whether mean returns (ROC) differ significantly across price quantile groups.

// It is not a trading strategy itself, but rather a statistical evaluation framework
// to help assess the validity of hypotheses such as "returns differ significantly when
// price is above Q3 vs between vs below Q1".

// The hypothesis testing uses Welch's t-test and displays significance stars:
// - * = significant at 95% confidence
// - ** = significant at 99% confidence

// Use this script as part of your strategy development process or research.
// ===================================================================================

