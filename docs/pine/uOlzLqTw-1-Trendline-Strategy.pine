//@version=6
strategy(
   "1 Trendline Strategy", 
   shorttitle = "1 Trendline Strategy", 
   overlay = true, 
   max_lines_count = 500, 
   max_bars_back = 5000, 
   initial_capital = 10000,
   default_qty_type = strategy.cash, 
   default_qty_value = 1000,
   pyramiding = 1,
   commission_type = strategy.commission.percent,
   commission_value = 0.05,
   margin_long = 10,
   margin_short = 10
   )

// --- INPUTS ---
len   = input.int   (6        , "Period  "      , tooltip = "Lookback period for Pivots", group = "Core Settings")
space = input.float(4.0      , "Padding"       , tooltip = "Padding distance for liquidity zone", step = 0.1, group = "Core Settings")

// Trend Filter Settings
use_filter = input.bool(false, "Use Trend Filter", group = "Trend Filter")
tf_ema     = input.timeframe("240", "Trend Higher Timeframe", group = "Trend Filter")
len_ema    = input.int(250, "Trend EMA Length", group = "Trend Filter")
slope_lookback = input.int(1, "EMA Slope Lookback Bars", group = "Trend Filter")

// Risk Management Inputs
atr_length = input.int(14, "ATR Length for Stops", group = "Risk Management")
sl_mult    = input.float(7.0, "Stop Loss ATR Multiplier", group = "Risk Management", step = 0.1)
tp_mult    = input.float(20.0, "Take Profit ATR Multiplier", group = "Risk Management", step = 0.1)

color_bull = #00bcd4
color_bear = #ff9800

// --- TREND FILTER CALCULATION ---
htf_ema = request.security(syminfo.tickerid, tf_ema, ta.ema(close, len_ema), barmerge.gaps_off, barmerge.lookahead_off)
ema_slope = htf_ema - htf_ema[slope_lookback]

trend_long_allowed  = not use_filter or (close > htf_ema and ema_slope > 0)
trend_short_allowed = not use_filter or (close < htf_ema and ema_slope < 0)

// --- CORE CALCULATION ---
ph = ta.pivothigh(high, len, len)
pl = ta.pivotlow (low , len, len)

type store
    float src
    int   n

type draw
    line[] upln
    line[] dnln

var store[] upbin = array.new<store>()
var store[] dnbin = array.new<store>()
var draw d = draw.new(array.new<line>(), array.new<line>())

atr = ta.atr(200)
trade_atr = ta.atr(atr_length)

method slope(line ln) =>
    x = ln.get_x2() - ln.get_x1()
    y = ln.get_y2() - ln.get_y1()
    y / x

vol() => math.min(atr * 0.1, close * (0.1/100))

var bool broken = false
var bool plup = false
var bool pldn = false

plup := false
pldn := false

// --- LIQUIDITY UPPER LINES LOGIC ---
if not na(ph)
    bool remove = false
    var bool valid = false
    upbin.unshift(store.new(high[len], bar_index[len]))
    if upbin.size() > 1
        current = upbin.get(0)
        before  = upbin.get(1)
        if current.src < before.src
            if broken == true
                valid := true
            else
                valid := false
                if upbin.size() > 3
                    if upbin.get(1).src < upbin.get(2).src and upbin.get(1).src < upbin.get(3).src and upbin.get(0).src < upbin.get(2).src and upbin.get(0).src < upbin.get(3).src
                        valid := true
        if valid == true
            d.upln.unshift(line.new(x1 = before.n, x2 = current.n, y1 = before.src, y2 = current.src, color = color_bear))
            d.upln.unshift(line.new(x1 = before.n, x2 = current.n, y1 = before.src - vol() * space, y2 = current.src - vol() * space, color = color_bear))
            ln = d.upln.get(1)
            for i = 0 to (bar_index - before.n)
                slp = ln.slope()
                ln.set_x2(bar_index[i])
                ln.set_y2(ln.get_y2() - slp)
                if low[i] > ln.get_y2()
                    remove := true
                    break
            if remove == true
                d.upln.get(0).delete()
                d.upln.get(1).delete()
                d.upln.clear()
                upbin.clear()
                broken := true
            else
                d.upln.get(0).delete()
                d.upln.get(1).delete()   
                d.upln.clear()
                d.upln.unshift(line.new(x1 = before.n, x2 = current.n, y1 = before.src, y2 = current.src, color = color_bear))
                d.upln.unshift(line.new(x1 = before.n, x2 = current.n, y1 = before.src - vol() * space, y2 = current.src - vol() * space, color = color_bear))
                linefill.new(d.upln.get(0), d.upln.get(1), color = color.new(color_bear, 85))
                upbin.clear()
                broken := false

if d.upln.size() > 1
    btm = d.upln.get(0)
    top = d.upln.get(1)
    if low > top.get_y2()
        d.upln.clear()
        broken := true
        upbin.clear()
        plup := true
    if d.upln.size() > 1
        slup = top.slope()
        sldn = btm.slope()
        top.set_x2(bar_index)
        top.set_y2(top.get_y2() + slup)
        btm.set_x2(bar_index)
        btm.set_y2(btm.get_y2() + sldn)

// --- LIQUIDITY LOWER LINES LOGIC ---
if not na(pl)
    bool remove = false
    var bool valid = false
    dnbin.unshift(store.new(low[len], bar_index[len]))
    if dnbin.size() > 1
        current = dnbin.get(0)
        before  = dnbin.get(1)
        if current.src > before.src
            if broken == true
                valid := true
            else
                valid := false
                if dnbin.size() > 3
                    if dnbin.get(1).src > dnbin.get(2).src and dnbin.get(1).src > dnbin.get(3).src and dnbin.get(0).src > dnbin.get(2).src and dnbin.get(0).src > dnbin.get(3).src
                        valid := true
        if valid == true
            d.dnln.unshift(line.new(x1 = before.n, x2 = current.n, y1 = before.src, y2 = current.src, color = color_bull))
            d.dnln.unshift(line.new(x1 = before.n, x2 = current.n, y1 = before.src + vol() * space, y2 = current.src + vol() * space, color = color_bull))
            ln = d.dnln.get(1)
            for i = 0 to (bar_index - before.n)
                slp = ln.slope()
                ln.set_x2(bar_index[i])
                ln.set_y2(ln.get_y2() - slp)
                if high[i] < ln.get_y2()
                    remove := true
                    break
            if remove == true
                d.dnln.get(0).delete()
                d.dnln.get(1).delete()
                d.dnln.clear()
                dnbin.clear()
                broken := true
            else
                d.dnln.get(0).delete()
                d.dnln.get(1).delete()   
                d.dnln.clear()
                d.dnln.unshift(line.new(x1 = before.n, x2 = current.n, y1 = before.src, y2 = current.src, color = color_bull))
                d.dnln.unshift(line.new(x1 = before.n, x2 = current.n, y1 = before.src + vol() * space, y2 = current.src + vol() * space, color = color_bull))
                linefill.new(d.dnln.get(0), d.dnln.get(1), color = color.new(color_bull, 85))
                dnbin.clear()
                broken := false

if d.dnln.size() > 1
    btm = d.dnln.get(0)
    top = d.dnln.get(1)
    if high < btm.get_y2()
        d.dnln.clear()
        broken := true
        dnbin.clear()
        pldn := true
    if d.dnln.size() > 1
        slup = top.slope()
        sldn = btm.slope()
        top.set_x2(bar_index)
        top.set_y2(top.get_y2() + slup)
        btm.set_x2(bar_index)
        btm.set_y2(btm.get_y2() + sldn)

// --- STRATEGY EXECUTION ---
var float long_sl_price = na
var float long_tp_price = na
var float short_sl_price = na
var float short_tp_price = na

if (plup == true and trend_long_allowed == true and strategy.position_size == 0)
    long_sl_price := close - (trade_atr * sl_mult)
    long_tp_price := close + (trade_atr * tp_mult)
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=long_sl_price, limit=long_tp_price)

if (pldn == true and trend_short_allowed == true and strategy.position_size == 0)
    short_sl_price := close + (trade_atr * sl_mult)
    short_tp_price := close - (trade_atr * tp_mult)
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=short_sl_price, limit=short_tp_price)

plot(use_filter ? htf_ema : na, "HTF Trend EMA", color=ema_slope > 0 ? color.blue : color.white, linewidth=2)
plot(strategy.position_size != 0 ? strategy.position_avg_price : na, "ТВХ", color=color.blue, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size > 0 ? long_sl_price : na, "Long SL", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size > 0 ? long_tp_price : na, "Long TP", color=color.green, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size < 0 ? short_sl_price : na, "Short SL", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size < 0 ? short_tp_price : na, "Short TP", color=color.green, style=plot.style_linebr, linewidth=2)