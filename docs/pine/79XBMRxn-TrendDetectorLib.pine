//@version=6
library("TrendDetector_Lib", overlay = true)

// -----------------------------------------------------------------------------
// Public API
// -----------------------------------------------------------------------------

// @method Converts a string timeframe into a user-friendly format.
// @param timeframe (string) The timeframe to convert (e.g., "15", "60", "240").
// @returns (string) The formatted timeframe (e.g., "15M", "1H", "4H").
export method formatTF(string timeframe) =>
    float tfNum = str.tonumber(timeframe)
    if not na(tfNum)
        tfNum < 60 ? timeframe + "M" : str.tostring(tfNum / 60) + "H"  // Numeric minutes → M, hours → H
    else
        // Handle non-numeric inputs like "D", "W", "1D", "1W", "1H", "1M"
        string tfUpper = timeframe
        int n = str.length(tfUpper)
        string unit = n > 0 ? str.upper(str.substring(tfUpper, n - 1, n)) : ""
        string prefix = n > 1 ? str.substring(tfUpper, 0, n - 1) : ""
        bool hasNumPrefix = not na(str.tonumber(prefix))
        unit == "D" ? (hasNumPrefix ? prefix + "D" : "1D") :
         unit == "W" ? (hasNumPrefix ? prefix + "W" : "1W") :
         unit == "H" ? (hasNumPrefix ? prefix + "H" : "1H") :
         unit == "M" ? (hasNumPrefix ? prefix + "M" : "1M") :
         timeframe

// @function Computes a Moving Average value based on type and length.
// @param type   (string) One of: "SMA", "EMA", "RMA", "WMA", "VWMA".
// @param src    (series float) Source series for MA (e.g., close).
// @param len    (simple int) Length of the MA.
// @returns (float) The computed MA series.
export f_ma(simple string type, series float src, simple int len) =>
    type == "SMA" ? ta.sma(src, len) :
     type == "EMA" ? ta.ema(src, len) :
     type == "RMA" ? ta.rma(src, len) :
     type == "WMA" ? ta.wma(src, len) :
     ta.vwma(src, len)

// @function Computes a timeframe-synchronized MA using request.security.
// @param symbol  (string) Symbol identifier, typically syminfo.tickerid.
// @param tf      (simple string) Timeframe (e.g., "15", "60", "240").
// @param type    (simple string) MA type (SMA/EMA/RMA/WMA/VWMA).
// @param src     (series float) Source series.
// @param len     (simple int) MA length.
// @param waitTF  (bool) If true, waits for TF close (gaps_on) to remove gaps.
// @returns (float) The MA series aligned to the requested timeframe.
f_tf_ma(string symbol, simple string tf, simple string type, series float src, simple int len, simple bool waitTF) =>
    request.security(symbol, tf, f_ma(type, src, len), waitTF ? barmerge.gaps_on : barmerge.gaps_off)

// @function Fills the provided table with Trend Detector contents.
// @desc This renderer does NOT plot and does NOT create tables; call from indicator after your table exists.
// @param tbl                 (table) Existing table to render into.
// @param trendDetectorSwitch (bool) Master toggle to draw the table content.
// @param frameColor          (color) Table frame color.
// @param frameWidth          (int)   Table frame width (0–5).
// @param borderColor         (color) Table border color.
// @param borderWidth         (int)   Table border width (0–5).
// @param textColor           (color) Table text color.
// @param symbol              (string) Symbol id (e.g., syminfo.tickerid).
// @param ma1ShowTrendData    (bool) Show MA #1 in table.
// @param ma1Type             (string) MA #1 type.
// @param ma1Length           (int) MA #1 length.
// @param ma1Source           (series float) MA #1 source.
// @param ma1Timeframe        (string) MA #1 timeframe.
// @param ma1WaitTF           (bool) MA #1 wait TF close (remove gaps).
// @param ma2ShowTrendData    (bool) Show MA #2 in table.
// @param ma2Type             (string) MA #2 type.
// @param ma2Length           (int) MA #2 length.
// @param ma2Source           (series float) MA #2 source.
// @param ma2Timeframe        (string) MA #2 timeframe.
// @param ma2WaitTF           (bool) MA #2 wait TF close (remove gaps).
// @param ma3ShowTrendData    (bool) Show MA #3 in table.
// @param ma3Type             (string) MA #3 type.
// @param ma3Length           (int) MA #3 length.
// @param ma3Source           (series float) MA #3 source.
// @param ma3Timeframe        (string) MA #3 timeframe.
// @param ma3WaitTF           (bool) MA #3 wait TF close (remove gaps).
export render(table tbl,
              bool trendDetectorSwitch,
              color frameColor, int frameWidth, color borderColor, int borderWidth, color textColor,
              bool ma1ShowTrendData, simple string ma1Timeframe, series float ma1Value,
              bool ma2ShowTrendData, simple string ma2Timeframe, series float ma2Value,
              bool ma3ShowTrendData, simple string ma3Timeframe, series float ma3Value) =>
    float ma1NonNaNValue = fixnan(ma1Value)
    float ma2NonNaNValue = fixnan(ma2Value)
    float ma3NonNaNValue = fixnan(ma3Value)

    // Determine rows to render and whether to show
    int trueCounter = 0
    if ma1ShowTrendData
        trueCounter += 1
    if ma2ShowTrendData
        trueCounter += 1
    if ma3ShowTrendData
        trueCounter += 1

    if trueCounter > 0 and trendDetectorSwitch and not na(tbl)
        // Basic styling
        tbl.set_frame_color(frameColor)
        tbl.set_frame_width(frameWidth)
        tbl.set_border_color(borderColor)
        tbl.set_border_width(borderWidth)
        tbl.cell_set_text(0, 0, "Term")
        tbl.cell_set_text_color(0, 0, textColor)
        tbl.cell_set_text(1, 0, "Trend")
        tbl.cell_set_text_color(1, 0, textColor)

        int i = 1
        if ma1ShowTrendData
            tbl.cell_set_text(0, i, "Short\n" + ma1Timeframe.formatTF())
            tbl.cell_set_text_color(0, i, textColor)
            tbl.cell_set_text(1, i, close >= ma1NonNaNValue ? "Up ▲" : "Down ▼")
            tbl.cell_set_text_color(1, i, close >= ma1NonNaNValue ? color.new(color.green, 60) : color.new(color.red, 60))
            i += 1

        if ma2ShowTrendData
            tbl.cell_set_text(0, i, "Mid\n" + ma2Timeframe.formatTF())
            tbl.cell_set_text_color(0, i, textColor)
            tbl.cell_set_text(1, i, close >= ma2NonNaNValue ? "Up ▲" : "Down ▼")
            tbl.cell_set_text_color(1, i, close >= ma2NonNaNValue ? color.new(color.green, 60) : color.new(color.red, 60))
            i += 1

        if ma3ShowTrendData
            tbl.cell_set_text(0, i, "Long\n" + ma3Timeframe.formatTF())
            tbl.cell_set_text_color(0, i, textColor)
            tbl.cell_set_text(1, i, close >= ma3NonNaNValue ? "Up ▲" : "Down ▼")
            tbl.cell_set_text_color(1, i, close >= ma3NonNaNValue ? color.new(color.green, 60) : color.new(color.red, 60))