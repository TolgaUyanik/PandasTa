//@version=5

// @description methods for printing all footprint objects
library("footpint_droving")
import dboichenko/footprint_type/2 as footprint_type
// Support function {
decim(value)=>
    prec = 0
    if syminfo.type == "crypto"
        prec:= 3
    math.round(value,prec)

get_row_line()=>
    res = ""
    for i = 0 to 15
        res+="—"

calculated_volume(total_volume,volume_)=>
    symbol = "░"
    result = ""
    procent = volume_/total_volume*100
    if procent != 0
        for i = 1 to procent
            result+=symbol
    [result,procent]
//}

//inner_logic_print droving{
method print_info(footprint_type.Footprint_info info,footprint_type.Footprint_bar foot_bar,footprint_type.Value_area val_area,footprint_type.Support_objects sup)=>
    total_vol = foot_bar.total_vol
    delta_vol = foot_bar.foot_buy_vol - foot_bar.foot_sell_vol
    vah_price = val_area.vah_price
    poc_price = val_area.poc_price
    val_price = val_area.val_price

    buy_total_proc_v = foot_bar.foot_buy_vol/total_vol*100
    sell_total_proc_v = foot_bar.foot_sell_vol/total_vol*100

    buy_sell_proc = foot_bar.foot_sell_vol == 0. ? "-" : str.tostring(foot_bar.foot_buy_vol/foot_bar.foot_sell_vol*100,format = format.percent)
    buy_total_proc = total_vol == 0. ? "-" : str.tostring(foot_bar.foot_buy_vol/total_vol*100,format = format.percent)
    sell_total_proc = total_vol == 0. ? "-" : str.tostring(foot_bar.foot_sell_vol/total_vol*100,format = format.percent)
    total_change =  na(total_vol[1])  ? "-" : str.tostring(total_vol/total_vol[1]*100,format = format.percent)
    delta_total_proc = total_vol == 0. ? "-" : str.tostring(delta_vol/total_vol*100,format = format.percent)
    delta_change = na(delta_vol[1])  ? "-" : str.tostring(delta_vol/delta_vol[1]*100,format = format.percent)

    sell_color = sell_total_proc_v>=sell_total_proc_v[1] ? sup.consts.color_title_buy:sup.consts.color_title_sell
    buy_color = buy_total_proc_v>=buy_total_proc_v[1] ? sup.consts.color_title_buy:sup.consts.color_title_sell
    
    info.total := label.new(bar_index,low,str.format("Total: {0}\nBuy: {1}",decim(total_vol),buy_total_proc),textcolor =buy_color,style = label.style_label_upper_left,size = size.normal,color = sup.consts.color_title_none,yloc=yloc.belowbar,textalign = text.align_left)
    info.delta := label.new(bar_index,low,str.format("Delta: {0}\nSell: {1}",decim(delta_vol),sell_total_proc),textcolor = sell_color, style = label.style_label_upper_right,size = size.normal,color = sup.consts.color_title_none,yloc=yloc.belowbar,textalign = text.align_left)
    if sup.inp.show_summary_footprint  
        info.summary_label := label.new(bar_index,low-foot_bar.row_size*5,str.format(
         "\n\n\nCum Total: {0}\nCum Delta: {1}\n\n
         Total buy: {2}\nTotal sell: {3}\n
         Cum Buy: {4}\nCum Sell: {5}\n\n
         Procent (buy / sell): {6}\nProcent(total / total prev): {7}\nProcent(delta / delta prev): {8}\nProcent(delta / total): {9}\n\n
         VAH price: {10}\nPOC price: {11}\nVAL price: {12}{13}",
         decim(info.var_info.cum_total),decim(info.var_info.cum_delta),
         decim(foot_bar.foot_buy_vol),decim(foot_bar.foot_sell_vol),
         decim(info.var_info.cum_buy_vol),decim(info.var_info.cum_sell_vol),
         buy_sell_proc,total_change,delta_change,delta_total_proc,
         na(vah_price)  ? "-": str.tostring(vah_price),na(poc_price)  ? "-": str.tostring(poc_price),na(val_price) ? "-": str.tostring(val_price),sup.dop_info),
         textalign= text.align_left,textcolor = chart.fg_color,color = sup.consts.color_title_none,style =  label.style_arrowdown,size = size.normal,yloc=yloc.belowbar)
        
    
    if sup.show_table_cond
        table.cell(info.var_info.cum_info, column = 1, row = 0, text = "Cumulative:",text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 2, row = 0, text = "Last:",text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 0, row = 1, text = "Total:",text_valign = text.align_center,text_halign = text.align_left,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 1, row = 1, text = str.tostring(info.var_info.cum_total,format = format.volume),text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 2, row = 1, text = str.tostring(total_vol,format = format.volume),text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 0, row = 2, text = "Delta:",text_valign = text.align_center,text_halign = text.align_left,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 1, row = 2, text = str.tostring(info.var_info.cum_delta,format = format.volume),text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 2, row = 2, text = str.tostring(delta_vol,format = format.volume),text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 0, row = 3, text = "Buy volume:",text_valign = text.align_center,text_halign = text.align_left,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 1, row = 3, text = str.tostring(info.var_info.cum_buy_vol,format = format.volume) + " | "+ str.tostring(info.var_info.cum_buy_vol/info.var_info.cum_total*100,format = format.percent),text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 2, row = 3, text = str.tostring(foot_bar.foot_buy_vol,format = format.volume) + " | "+ str.tostring(foot_bar.foot_buy_vol/total_vol*100,format = format.percent),text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 0, row = 4, text = "Sell volume:",text_valign = text.align_center,text_halign = text.align_left,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 1, row = 4, text = str.tostring(info.var_info.cum_sell_vol,format = format.volume)+ " | "+ str.tostring(info.var_info.cum_sell_vol/info.var_info.cum_total*100,format = format.percent),text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)
        table.cell(info.var_info.cum_info, column = 2, row = 4, text = str.tostring(foot_bar.foot_sell_vol,format = format.volume)+ " | "+ str.tostring(foot_bar.foot_sell_vol/total_vol*100,format = format.percent),text_valign = text.align_center,text_halign = text.align_center,text_color = chart.fg_color)

method print_row_line(footprint_type.Footprint_row foot_row,footprint_type.Support_objects sup)=>
    foot_row.row_line := label.new(bar_index,foot_row.price,get_row_line(),color = sup.consts.color_title_none,textcolor =  sup.row_line_color,style = label.style_label_center)

method print_footrpint(footprint_type.Footprint_row foot_row,row_size,footprint_type.Support_objects sup)=> 
    level = foot_row.price
    foot_row.buy_vol_box := box.new(bar_index,level+row_size,bar_index,level,text = str.format("{0} {1}",decim(foot_row.buy_vol),foot_row.imbalance_buy?sup.consts.imbalance_high_char:""),text_color = color.green,border_color = sup.consts.color_title_none,bgcolor=sup.consts.color_title_none,text_size = size.normal,text_halign= text.align_left)
    foot_row.sell_vol_box := box.new(bar_index,level+row_size,bar_index,level,text = str.format("{1} {0}",decim(foot_row.sell_vol),foot_row.imbalance_sell ? sup.consts.imbalance_low_char : ""),text_color = color.red,border_color = sup.consts.color_title_none,bgcolor=sup.consts.color_title_none,text_size = size.normal,text_halign= text.align_right)
    if sup.inp.new_imbalance_cond
        if foot_row.imbalance_buy
            alert(str.format("New imbalance buy on price: {0}",level),alert.freq_all)
        if foot_row.imbalance_sell
            alert(str.format("New imbalance sell on price: {0}",level),alert.freq_all)

method print_vp(footprint_type.Footprint_row foot_row,total_vol,row_size,footprint_type.Support_objects sup)=> 
    level = foot_row.price
    
    [count_buy,transparency_volume_buy] = calculated_volume(total_vol,foot_row.buy_vol)
    [count_sell,transparency_volume_sell] = calculated_volume(total_vol,foot_row.sell_vol)
    foot_row.buy_vp_box := box.new(bar_index,level+row_size,bar_index,level,text = str.format("{0}",count_buy),text_color = color.new(color.green,transparency_volume_buy),text_size = size.small,text_halign= text.align_left,border_color = sup.consts.color_title_none,bgcolor=sup.consts.color_title_none)
    foot_row.sell_vp_box := box.new(bar_index,level+row_size,bar_index,level,text = str.format("{0}",count_sell),text_color = color.new(color.red,transparency_volume_sell),text_size = size.small,text_halign= text.align_right,border_color = sup.consts.color_title_none,bgcolor=sup.consts.color_title_none)

method delete_old_imbalance_line(footprint_type.Imbalance_line imba_line,footprint_type.Support_objects sup)=>
    for [index,old_buy_line] in imba_line.var_imba_line.cum_buy_line
        y = old_buy_line.get_y2()
        x2 = old_buy_line.get_x2()
        if y >= low and y <= high and bar_index < x2
            old_buy_line.set_x2(bar_index)
            //imba_line.var_imba_line.cum_buy_line.remove(index)
            if sup.inp.stop_past_imbalance_line_cond
                alert(str.format("Stop past imbalance line buy on price: {0}",y),alert.freq_all)
    for [index,old_sell_line] in imba_line.var_imba_line.cum_sell_line
        y = old_sell_line.get_y2()
        x2 = old_sell_line.get_x2()
        if y >= low and y <= high and bar_index < x2
            old_sell_line.set_x2(bar_index)
            //imba_line.var_imba_line.cum_sell_line.remove(index)
            if sup.inp.stop_past_imbalance_line_cond
                alert(str.format("Stop past imbalance line sell on price: {0}",y),alert.freq_all)

method print_imbalance_line(footprint_type.Imbalance_line imba_line,footprint_type.Support_objects sup)=>
    for price_row in imba_line.buy_price_line
        imba_line.var_imba_line.cum_buy_line.push(line.new(bar_index,price_row,bar_index+500,price_row,color = sup.consts.color_line_buy,style = line.style_arrow_right))
        if sup.inp.new_imbalance_line_cond
            alert(str.format("New imbalance line buy on price: {0}",price_row),alert.freq_all)
    for price_row in imba_line.sell_price_line
        imba_line.var_imba_line.cum_sell_line.push(line.new(bar_index,price_row,bar_index+500,price_row,color = sup.consts.color_line_sell,style = line.style_arrow_right))
        if sup.inp.new_imbalance_line_cond
            alert(str.format("New imbalance line sell on price: {0}",price_row),alert.freq_all)

method print_va_line(footprint_type.Value_area val_area, footprint_type.Support_objects sup)=>
    if sup.inp.show_vah
        val_area.vah_label :=  label.new(bar_index,val_area.vah_price,"VAH",color = sup.consts.color_title_none,textcolor = chart.fg_color,size = size.small,style = label.style_label_lower_left)
        val_area.vah_line := line.new(bar_index,val_area.vah_price,bar_index+1,val_area.vah_price,color = sup.inp.color_vah,style = line.style_dotted,width=2)
    if sup.inp.show_poc 
        val_area.poc_label := label.new(bar_index,val_area.poc_price,"POC",color = sup.consts.color_title_none,textcolor = chart.fg_color,size = size.small,style = label.style_label_lower_left)
        val_area.poc_level := line.new(bar_index,val_area.poc_price,bar_index+1,val_area.poc_price,color = sup.inp.color_poc,style = line.style_dotted,width=2)
    if sup.inp.show_val
        val_area.val_label := label.new(bar_index, val_area.val_price,"VAL",color = sup.consts.color_title_none,textcolor = chart.fg_color,size = size.small,style = label.style_label_lower_left)
        val_area.val_line := line.new(bar_index, val_area.val_price,bar_index+1, val_area.val_price,color = sup.inp.color_val,style = line.style_dotted,width=2)
//}

//method print droving{
//@function printing all footprint objects
//@param foot_bar instance of Footprint_bar type
//@param sup instance of Support_objects type
//@returns Void.
export method print_droving(footprint_type.Footprint_bar foot_bar,footprint_type.Support_objects sup)=> 
    row_size = foot_bar.row_size

    foot_bar.info.print_info(foot_bar,foot_bar.val_area,sup)
    foot_bar.val_area.print_va_line(sup)

    foot_bar.imba_line.delete_old_imbalance_line(sup)
    foot_bar.imba_line.print_imbalance_line(sup)

    for row in foot_bar.foot_rows
        row.print_row_line(sup)
        if not row.empty
            row.print_footrpint(row_size,sup)
            if sup.inp.show_volume_profile
                row.print_vp(foot_bar.total_vol,row_size,sup)
    
//}