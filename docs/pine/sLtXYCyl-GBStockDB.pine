export getInfo(string sym) =>
    string fc = str.substring(sym, 0, 1)
    [sAE, iAE, mAE, cAE] = AE(sym)
    [sFJ, iFJ, mFJ, cFJ] = FJ(sym)
    [sKN, iKN, mKN, cKN] = KN(sym)
    [sOS, iOS, mOS, cOS] = OS(sym)
    [sTZ, iTZ, mTZ, cTZ] = TZ(sym)
    bool isAE = str.contains("ABCDE", fc)
    bool isFJ = str.contains("FGHIJ", fc)
    bool isKN = str.contains("KLMN",  fc)
    bool isOS = str.contains("OPQRS", fc)
    string s = isAE ? sAE : isFJ ? sFJ : isKN ? sKN : isOS ? sOS : sTZ
    string i = isAE ? iAE : isFJ ? iFJ : isKN ? iKN : isOS ? iOS : iTZ
    int    m = isAE ? mAE : isFJ ? mFJ : isKN ? mKN : isOS ? mOS : mTZ
    string c = isAE ? cAE : isFJ ? cFJ : isKN ? cKN : isOS ? cOS : cTZ
    string sf  = na(s) ? syminfo.sector      : s
    string if2 = na(i) ? syminfo.industry    : i
    string cf  = na(c) ? syminfo.description : c
    [sf, if2, m, cf]