//@version=5
indicator("BTC vs MSTR Performance", overlay=false)

baseSymbol = input.symbol("NASDAQ:MSTR", "MSTR Symbol")
compareSymbol = input.symbol("BINANCE:BTCUSDT", "BTC Symbol")
lookback = input.int(30, "Vergleichszeitraum (Tage)", minval=1)

mstr = request.security(baseSymbol, timeframe.period, close)
btc = request.security(compareSymbol, timeframe.period, close)

mstr_perf = (mstr - mstr[lookback]) / mstr[lookback] * 100
btc_perf = (btc - btc[lookback]) / btc[lookback] * 100

perf_diff = mstr_perf - btc_perf

plot(perf_diff, title="MSTR Outperformance vs BTC (%)", color=perf_diff >= 0 ? color.green : color.red, linewidth=2)
hline(0, "Neutral", color=color.gray, linestyle=hline.style_dashed)