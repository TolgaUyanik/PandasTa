//
// @function  TRUE is tuesday
// @param x   no
// @returns   TRUE is tuesday else FALSE
export isTuesday() =>  
    //
    //OneDay =  (timeframe.period == "D") and (dayofweek.tuesday == DayOfWeek(0)) //Wenn Tageschart verwendet wird ist es um einen Tag verschoben (Grund nicht gefunden). Einfach auf Montag geändert. 
    //OneDay =  (timeframe.period == "D") and (dayofweek.tuesday == dayofweek(time(timeframe.period, syminfo.session, syminfo.timezone),syminfo.timezone)) //Wenn Tageschart verwendet wird ist es um einen Tag verschoben (Grund nicht gefunden). Einfach auf Montag geändert. 
    //OneDay =  (timeframe.period == "D") and (dayofweek.tuesday == dayofweek(time,"GMT ") //Wenn Tageschart verwendet wird ist es um einen Tag verschoben (Grund nicht gefunden). Einfach auf Montag geändert. 
    Tuesday   =  (dayofweek == dayofweek.tuesday)
    Weekle =  (timeframe.period == "W")
    //
    Tuesday or Weekle //Der Rückgabewert der Funktion ist TRUE wenn das Bit Tuesday belegt ist oder Feiertage waren

//
///////////////////////////////////////////////////////////////////////////////////////
//
// @function  RSI calulation
// @param src RSI Source
// @param len RSI Length
// @returns   RSI Value
export Rsi(float src,int len) =>
    var HistoryOpenInterest = array.new<float>(2) //Array mit einem Element
    //
    array.set(HistoryOpenInterest,1,array.get(HistoryOpenInterest,0))//Array 0 in Array 1 kopieren
    array.set(HistoryOpenInterest,0,src)//Aktuellen Wert in Array 0 kopieren
    //
    //HistoryOpenInterest[0] - HistoryOpenInterest[1]
    u = math.max(array.get(HistoryOpenInterest,0) - array.get(HistoryOpenInterest,1), 0) // upward change
    d = math.max(array.get(HistoryOpenInterest,1) - array.get(HistoryOpenInterest,0), 0) // downward change
    //
    rs = ta.rma(u, len) / ta.rma(d, len)
    res = 100 - 100 / (1 + rs)
    //
////////////////////////////////////////////////////////////////////////////////////////
//
// @function  Index calulation
// @param netPos Source
// @param weeks Length
// @returns "COT Index"
export CalcIndex(float netPos,simple int weeks) =>
    minNetPos = ta.lowest(netPos, weeks)
    maxNetPos = ta.highest(netPos, weeks)
    if maxNetPos != minNetPos
        100 * (netPos - minNetPos) / (maxNetPos - minNetPos)
    else
        na     
//
///////////////////////////////////////////////////////////////////////////////////////
//
// @function  TRUE is tuesday
// @param x   no
// @returns   RSI Stochastik
export RsiStock(float src,simple int len, int smoothK) =>
    rsi = Rsi(src,len)
    k = ta.sma(ta.stoch(rsi, rsi, rsi, len), smoothK)
///////////////////////////////////////////////////////////////////////////////////////
//
// @function  Use Offset for Day time frame
// @param x   no
// @returns   Offset
export Offset() =>
    Offset = 0
    if (timeframe.period == "D")
        Offset := 1 //Eine Kerze zurückspringen da der Tageschart erst am nächsten Tag um 0 Uhr
    else
        Offset := 0
///////////////////////////////////////////////////////////////////////////////////////
//
// @function  Calc different in Percent
// @param x   Actual Data , Last Data
// @returns   Change in percent
export PercentChange(float Data,float LastData) =>
    DiffrentData = Data - LastData 
    PercentData = (DiffrentData/LastData) * 100
    if LastData < Data
        res = math.abs(PercentData)
    else
        res = math.abs(PercentData) * -1

