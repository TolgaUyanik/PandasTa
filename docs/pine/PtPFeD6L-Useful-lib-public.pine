library("Useful_lib_public")
//
//////////////////////////////////////////////////////////////////////////////////////
//
// @function  count bars for one for the diffrent time frames
// @param x   no 
// @returns   number of bars for one day
export CountBarsOfDay() =>
    //Wieviel Kerzen hat ein Tag
    bars = switch timeframe.period
        "D"     => 1                    // 1Tag             
        "240"   => (24 * 60) / 240      // 4h
        "180"   => (24 * 60) / 180      // 3h
        "120"   => (24 * 60) / 120      // 2h
        "60"    => (24 * 60) / 60       // 1h
        "45"    => (24 * 60) / 45       // 45min
        "30"    => (24 * 60) / 30       // 30min
        "15"    => (24 * 60) / 15       // 15min
        "5"     => (24 * 60) / 5        // 5min
        "3"     => (24 * 60) / 3        // 3min
        "1"     => (24 * 60) / 1        // 1min
        => 1                            // else
//
///////////////////////////////////////////////////////////////////////////////////////
//
// @function  Index number for the las bar for one day
// @param x   no
// @returns   TRUE is that the last bar from day 
export LastBarsOfDay() =>
    //Uhrzeit wann die letzte Kerze vom Tag schließt
    endOfDay = switch timeframe.period           
        "240"   => 2200     // 4h Stundenchart 22 Uhr
        "180"   => 2100     // 3h Stundenchart 21 Uhr
        //Restlichen timeframes schliessen immer um 24 Uhr
        => 0000             // else    

    SameTime = (hour(time_close)*60 + minute(time_close)==(60*(endOfDay/100)+endOfDay%100))?true:false
    lastBarsOfDay = SameTime  or (timeframe.period == "D") or (timeframe.period == "W")
