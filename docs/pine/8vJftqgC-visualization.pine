library("visualization", overlay = true)

//@section INPUTS
//@description Control which visualization features are enabled
enable_taglines = input.bool(true, "Enable Tag Lines", group="Visualization Controls")
enable_textlabel = input.bool(true, "Enable Labels", group="Visualization Controls")
enable_boxes = input.bool(true, "Enable Boxes", group="Visualization Controls")

//@section VISUALIZATION TOOLS
//@description Contains functions for creating visual elements like labels, lines, and boxes

//@function Creates a textLabel with line at specified price level
//@param message Text to display in the textLabel. If starts with '$', price included. Empty = no textLabel
//@param priceLevel Price level for textLabel and line positioning
//@param showCondition Condition to display the textLabel and line
//@param labelPosition Label position ("above", "below")
//@param labelSize Label size
//@param offsetX X-axis offset for textLabel and line
//@param textColor Text color
//@param bgColor Background color
//@param lineWidth Line width
//@param lineStyle Line style
//@returns void
export method tagLine(
   string message, 
   float priceLevel = close, 
   bool showCondition = true, 
   string labelPosition = "above", 
   string labelSize = size.small, 
   int offsetX = 10, 
   color textColor = #000000, 
   color bgColor = #787B8625, 
   int lineWidth = 2, 
   string lineStyle = line.style_solid ) =>

    var label tagLabel = na
    var line tagLine = na
    
    labelStyle = labelPosition == "above" ? label.style_label_down : labelPosition == "below" ? label.style_label_up : label.style_label_left

    if showCondition and barstate.islast
        displayMessage = message

        if str.contains(message, "%")
            percentDiff = ((priceLevel - close) / close) * 100
            displayMessage := str.replace_all(message, "%", str.tostring(percentDiff, format.percent) + " ")
        
        if str.contains(displayMessage, "$")
            displayMessage := str.replace_all(displayMessage, "$", str.tostring(priceLevel) + " ")

        if str.length(displayMessage) > 0
            if na(tagLabel)
                tagLabel := label.new(x = bar_index + offsetX / 2, y = priceLevel, text = displayMessage, style = labelStyle, textcolor = textColor, color = bgColor, size = labelSize)
        if na(tagLine)
            tagLine := line.new(x1 = bar_index, x2 = bar_index + offsetX, y1 = priceLevel, y2 = priceLevel, width = lineWidth, color = textColor, style = lineStyle)
    else
        tagLabel.delete()
        line.delete(tagLine)
        tagLabel := na
        tagLine := na

//@function Creates dynamic labels with optional arrows and tooltips
//@param message Message to show (prefix with "!" to hide arrow)
//@param showCondition Display condition
//@param labelPosition Label labelPosition ("above", "below")
//@param textColor Text color
//@param tooltip Optional tooltip text to show on hover
//@returns void
export textLabel(string message = "", bool showCondition = true, string labelPosition = "", color textColor = #7c15b4, string tooltip = na) =>

    if showCondition
        hideArrow = str.startswith(message, "!")
        cleanMessage = hideArrow ? str.replace(message, "!", "") : message
        yPosition = labelPosition == "above" ? high : labelPosition == "below" ? low : close
        formattedMessage = hideArrow ? cleanMessage : (yPosition == high ? "▼\n" + cleanMessage : yPosition == low ? "▲\n" + cleanMessage : "◄ " + cleanMessage)
        
        // Use custom tooltip if provided, otherwise default to bar index
        tooltipText = na(tooltip) ? str.format("{0}", bar_index) : tooltip
        
        label.new(x = bar_index, y = yPosition, text = formattedMessage, tooltip = tooltipText, color = na, textcolor = na(textColor) ? labelPosition == "above" ? color.red : labelPosition == "below" ? color.green : color.black : textColor, size = size.small, yloc = labelPosition == "above" ? yloc.abovebar : labelPosition == "below" ? yloc.belowbar : yloc.price, style = labelPosition == "above" ? label.style_arrowdown : labelPosition == "below" ? label.style_arrowup : label.style_label_left)

//@function Creates a box around price range
//@param showCondition Condition to draw the box
//@param topValue Optional custom top value
//@param bottomValue Optional custom bottom value
//@param barsBack Number of bars to look back
//@param borderColor Box border color
//@param bgColor Box background color
//@returns box Box object
export box(bool showCondition, float topValue = na, float bottomValue = na, int barsBack = 1, color borderColor = #bc2c1a, color bgColor = #787B8625) =>
    
    atrValue = ta.atr(30) * 0.2
    percentage = close * 0.02
    minValue = math.min(atrValue, percentage)
    
    highestPrice = ta.highest(high, barsBack)
    lowestPrice = ta.lowest(low, barsBack)
    
    top = na(topValue) ? highestPrice + minValue : topValue
    bottom = na(bottomValue) ? lowestPrice - minValue : bottomValue
    
    left = bar_index - barsBack
    right = bar_index + 1
    
    if showCondition
        box.new(left, top, right, bottom, border_color = borderColor, xloc = xloc.bar_index, bgcolor = bgColor, border_style = line.style_dotted)

//@section USAGE EXAMPLES
//@description Examples demonstrating the usage of visualization tools

// TagLine Examples
if barstate.islast and enable_taglines
    // Example 1: Basic price level with current close (only if taglines enabled)
    tagLine("Current Price: $", close, true)

    // Example 2: Support level with percentage distance
    tagLine("Support %", low[1], low[1] < close, "below", size.small, 12, color.green)

    // Example 3: Resistance with custom styling
    tagLine("Resistance $", high[1], high[1] > close, "above", size.normal, 15, color.red, color.new(color.red, 70), 2, line.style_dashed)

    // Example 4: Moving average with dynamic position
    ema = ta.ema(close, 14)
    tagLine("EMA: $", ema, true, close > ema ? "below" : "above", size.small, 10, color.blue)

    // Example 5: ATR-based volatility bands
    atr = ta.atr(14)
    tagLine("Upper Band %", high + atr, true, "above", size.tiny, 8, color.purple, color.new(color.purple, 80))

// Label Examples (only if labels enabled)
if barstate.islast and enable_textlabel
    // Example 1: Basic textLabel with arrow
    textLabel("Price Action", true, "above")
    
    // Example 2: Custom colored textLabel below bar
    textLabel("Support Found", true, "below", color.green)
    
    // Example 3: Label without arrow
    textLabel("!No Arrow", true)
    
    // Example 4: Conditional textLabel
    textLabel("Breakout", high > high[1], "above", color.red)

// Box Examples (only if boxes enabled)
if enable_boxes
    // Example 1: Basic price range box
    condition = close > open and close[1] > open[1] and close[2] > open[2]
    box(condition)