//@version=6

// @description Professional library for creating customizable trade management visualizations
//              (Entry, Stop Loss, Take Profit lines and labels). Supports 4 visual styles with
//              configurable prices, R:R ratios, percentages, and direction-based label positioning.
library("tp_sl_drawing_lib_v2")

// ─── Constants ─────────────────────────────────────────────
color TRANS_COLOR = color.rgb(33, 149, 243, 100)

// ─── Utility Functions ─────────────────────────────────────
// @function Converts a style string to a Pine Script line style constant.
// @param str (string) One of "Dotted", "Dashed", "Solid".
// @returns   (int) The corresponding line.style_* constant.
get_line_style(string str) =>
    switch str
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        "Solid"  => line.style_solid
        =>
            runtime.error("Unknown line style: " + str)
            line.style_solid

// ─── Types ─────────────────────────────────────────────────

// @type V1 drawing container with left/center/right labels per line.
//       Traditional multi-label style with full positional flexibility.
export type tradeDrawingsV1
    line entryLine
    label entryLeft
    label entryCenter
    label entryRight
    line tp1Line
    label tp1Left
    label tp1Center
    label tp1Right
    line tp2Line
    label tp2Left
    label tp2Center
    label tp2Right
    line tp3Line
    label tp3Left
    label tp3Center
    label tp3Right
    line slLine
    label slLeft
    label slCenter
    label slRight


// ─── V1 Functions ──────────────────────────────────────────

shrink_line_v1(int start_idx, int min_bars_label_length, line ln, label centerLabel, label rightLabel) =>
    length_to_set = bar_index - start_idx < min_bars_label_length ? min_bars_label_length : bar_index - start_idx

    if not na(ln)
        ln.set_x2(x = start_idx + length_to_set)
    if not na(centerLabel)
        centerLabel.set_x(x = start_idx + math.floor(length_to_set / 2))
    if not na(rightLabel)
        rightLabel.set_x(x = start_idx + length_to_set)

draw_trade_tp_sl_v1(int direction,
                 float ep,
                 float tp1,
                 float tp2,
                 float tp3,
                 float sl,
                 float rrr,
                 float tp1_perc,
                 float tp2_perc,
                 float tp3_perc,
                 string sizeInfo,
                 int patternStartBarIdx,
                 int tp_sl_line_length,
                 bool show_tp1,
                 bool show_tp2,
                 bool show_tp3,
                 bool show_sl,
                 bool show_ep,
                 bool show_size_info,
                 string tp_sl_label_pos,
                 string tp_sl_price_pos,
                 string tp_sl_rrr_pos,
                 string tp_sl_perc_pos,
                 string tp_sl_qty_pos,
                 string tp1_style,
                 string tp2_style,
                 string tp3_style,
                 string sl_style,
                 string ep_style,
                 int tp1_thickness,
                 int tp2_thickness,
                 int tp3_thickness,
                 int sl_thickness,
                 int ep_thickness,
                 color tp1_color,
                 color tp2_color,
                 color tp3_color,
                 color sl_color,
                 color ep_color) =>

    drawings = tradeDrawingsV1.new()
    line_size = math.min(tp_sl_line_length == 0? bar_index - patternStartBarIdx - 1 : tp_sl_line_length, 499)

    // set the new drawings
    // lines
    if not na(tp1) and show_tp1
        drawings.tp1Line := line.new(x1=bar_index, y1=tp1, x2=bar_index + line_size, y2=tp1, color=tp1_color, style = get_line_style(tp1_style), width=tp1_thickness)
    if not na(tp2) and show_tp2
        drawings.tp2Line := line.new(x1=bar_index, y1=tp2, x2=bar_index + line_size, y2=tp2, color=tp2_color, style = get_line_style(tp2_style), width=tp2_thickness)
    if not na(tp3) and show_tp3
        drawings.tp3Line := line.new(x1=bar_index, y1=tp3, x2=bar_index + line_size, y2=tp3, color=tp3_color, style = get_line_style(tp3_style), width=tp3_thickness)
    if show_sl
        drawings.slLine := line.new(x1=bar_index, y1=sl, x2=bar_index + line_size, y2=sl, color=sl_color, style = get_line_style(sl_style), width=sl_thickness)
    if show_ep
        drawings.entryLine := line.new(x1=bar_index, y1=ep, x2=bar_index + line_size, y2=ep, color=ep_color, style = get_line_style(ep_style), width=ep_thickness)
    // labels
    if show_sl
        // EP - PRICE - RRR - SIZE_INFO
        string leftStr = ""
        if tp_sl_label_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += "SL"
        if tp_sl_price_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += str.tostring(sl, format.mintick)
        if leftStr != ""
            drawings.slLeft := label.new(x=bar_index, y=sl, text=leftStr, style=label.style_label_lower_left, color = TRANS_COLOR, textalign=text.align_left, textcolor=sl_color)

        string centerStr = ""
        if tp_sl_label_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += "SL"
        if tp_sl_price_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += str.tostring(sl, format.mintick)
        if centerStr != ""
            my_x = bar_index + math.floor((bar_index - patternStartBarIdx) / 2)
            drawings.slCenter := label.new(x=my_x, y=sl, text=centerStr, style=label.style_label_down, color = TRANS_COLOR, textalign=text.align_center, textcolor=sl_color)

        string rightStr = ""
        if tp_sl_label_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += "SL"
        if tp_sl_price_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += str.tostring(sl, format.mintick)
        if rightStr != ""
            my_x = bar_index + bar_index - patternStartBarIdx
            drawings.slRight := label.new(x=my_x, y=sl, text=rightStr, style=label.style_label_lower_right, color = TRANS_COLOR, textalign=text.align_right, textcolor=sl_color)


    if not na(tp1) and show_tp1
        // EP - PRICE - RRR - SIZE_INFO
        string leftStr = ""
        if tp_sl_label_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += "TP1"
        if tp_sl_price_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += str.tostring(tp1, format.mintick)
        if tp_sl_perc_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += na(tp1_perc)? "" : str.tostring(tp1_perc, '#') + "%"
        if leftStr != ""
            drawings.tp1Left := label.new(x=bar_index, y=tp1, text=leftStr, style=label.style_label_lower_left, color = TRANS_COLOR, textalign=text.align_left, textcolor=tp1_color)

        string centerStr = ""
        if tp_sl_label_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += "TP1"
        if tp_sl_price_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += str.tostring(tp1, format.mintick)
        if tp_sl_perc_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += na(tp1_perc)? "" : str.tostring(tp1_perc, '#') + "%"
        if centerStr != ""
            my_x = bar_index + math.floor((bar_index - patternStartBarIdx) / 2)
            drawings.tp1Center := label.new(x=my_x, y=tp1, text=centerStr, style=label.style_label_down, color = TRANS_COLOR, textalign=text.align_center, textcolor=tp1_color)

        string rightStr = ""
        if tp_sl_label_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += "TP1"
        if tp_sl_price_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += str.tostring(tp1, format.mintick)
        if tp_sl_perc_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += na(tp1_perc)? "" : str.tostring(tp1_perc, '#') + "%"
        if rightStr != ""
            my_x = bar_index + bar_index - patternStartBarIdx
            drawings.tp1Right := label.new(x=my_x, y=tp1, text=rightStr, style=label.style_label_lower_right, color = TRANS_COLOR, textalign=text.align_right, textcolor=tp1_color)

    if not na(tp2) and show_tp2
        // EP - PRICE - RRR - SIZE_INFO
        string leftStr = ""
        if tp_sl_label_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += "TP2"
        if tp_sl_price_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += str.tostring(tp2, format.mintick)
        if tp_sl_perc_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += na(tp2_perc)? "" : str.tostring(tp2_perc, '#') + "%"
        if leftStr != ""
            drawings.tp2Left := label.new(x=bar_index, y=tp2, text=leftStr, style=label.style_label_lower_left, color = TRANS_COLOR, textalign=text.align_left, textcolor=tp2_color)

        string centerStr = ""
        if tp_sl_label_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += "TP2"
        if tp_sl_price_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += str.tostring(tp2, format.mintick)
        if tp_sl_perc_pos == "Center"// and SHOW_tp2_perc
            if centerStr != ""
                centerStr += " - "
            centerStr += na(tp2_perc)? "" : str.tostring(tp2_perc, '#') + "%"
        if centerStr != ""
            my_x = bar_index + math.floor((bar_index - patternStartBarIdx) / 2)
            drawings.tp2Center := label.new(x=my_x, y=tp2, text=centerStr, style=label.style_label_down, color = TRANS_COLOR, textalign=text.align_center, textcolor=tp2_color)

        string rightStr = ""
        if tp_sl_label_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += "TP2"
        if tp_sl_price_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += str.tostring(tp2, format.mintick)
        if tp_sl_perc_pos == "Right"// and SHOW_tp2_perc
            if rightStr != ""
                rightStr += " - "
            rightStr += na(tp2_perc)? "" : str.tostring(tp2_perc, '#') + "%"
        if rightStr != ""
            my_x = bar_index + bar_index - patternStartBarIdx
            drawings.tp2Right := label.new(x=my_x, y=tp2, text=rightStr, style=label.style_label_lower_right, color = TRANS_COLOR, textalign=text.align_right, textcolor=tp2_color)

    if not na(tp3) and show_tp3
        // EP - PRICE - RRR - SIZE_INFO
        string leftStr = ""
        if tp_sl_label_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += "TP3"
        if tp_sl_price_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += str.tostring(tp3, format.mintick)
        if tp_sl_perc_pos == "Left"// and SHOW_tp2_perc
            if leftStr != ""
                leftStr += " - "
            leftStr += na(tp3_perc)? "" : str.tostring(tp3_perc, '#') + "%"
        if leftStr != ""
            drawings.tp3Left := label.new(x=bar_index, y=tp3, text=leftStr, style=label.style_label_lower_left, color = TRANS_COLOR, textalign=text.align_left, textcolor=tp3_color)

        string centerStr = ""
        if tp_sl_label_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += "TP3"
        if tp_sl_price_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += str.tostring(tp3, format.mintick)
        if tp_sl_perc_pos == "Center"// and SHOW_tp2_perc
            if centerStr != ""
                centerStr += " - "
            centerStr += na(tp3_perc)? "" : str.tostring(tp3_perc, '#') + "%"
        if centerStr != ""
            my_x = bar_index + math.floor((bar_index - patternStartBarIdx) / 2)
            drawings.tp3Center := label.new(x=my_x, y=tp3, text=centerStr, style=label.style_label_down, color = TRANS_COLOR, textalign=text.align_center, textcolor=tp3_color)

        string rightStr = ""
        if tp_sl_label_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += "TP3"
        if tp_sl_price_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += str.tostring(tp3, format.mintick)
        if tp_sl_perc_pos == "Right"// and SHOW_tp2_perc
            if rightStr != ""
                rightStr += " - "
            rightStr += na(tp3_perc)? "" : str.tostring(tp3_perc, '#') + "%"
        if rightStr != ""
            my_x = bar_index + bar_index - patternStartBarIdx
            drawings.tp3Right := label.new(x=my_x, y=tp3, text=rightStr, style=label.style_label_lower_right, color = TRANS_COLOR, textalign=text.align_right, textcolor=tp3_color)

    if show_ep
        // EP - PRICE - RRR - SIZE_INFO
        string leftStr = ""
        if tp_sl_label_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += "EP"
        if tp_sl_price_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += str.tostring(ep, format.mintick)
        if tp_sl_rrr_pos == "Left"
            if leftStr != ""
                leftStr += " - "
            leftStr += str.tostring(rrr, '#.##') + "R"
        if tp_sl_qty_pos == "Left" and show_size_info
            if leftStr != ""
                leftStr += " - "
            leftStr += sizeInfo
        if leftStr != ""
            drawings.entryLeft := label.new(x=bar_index, y=ep, text=leftStr, style=label.style_label_lower_left, color = TRANS_COLOR, textalign=text.align_left, textcolor=ep_color)

        string centerStr = ""
        if tp_sl_label_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += "EP"
        if tp_sl_price_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += str.tostring(ep, format.mintick)
        if tp_sl_rrr_pos == "Center"
            if centerStr != ""
                centerStr += " - "
            centerStr += str.tostring(rrr, '#.##') + "R"
        if tp_sl_qty_pos == "Center" and show_size_info
            if centerStr != ""
                centerStr += " - "
            centerStr += sizeInfo
        if centerStr != ""
            my_x = bar_index + math.floor((bar_index - patternStartBarIdx) / 2)
            drawings.entryCenter := label.new(x=my_x, y=ep, text=centerStr, style=label.style_label_down, color = TRANS_COLOR, textalign=text.align_center, textcolor=ep_color)

        string rightStr = ""
        if tp_sl_label_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += "EP"
        if tp_sl_price_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += str.tostring(ep, format.mintick)
        if tp_sl_rrr_pos == "Right"
            if rightStr != ""
                rightStr += " - "
            rightStr += str.tostring(rrr, '#.##') + "R"
        if tp_sl_qty_pos == "Right" and show_size_info
            if rightStr != ""
                rightStr += " - "
            rightStr += sizeInfo
        if rightStr != ""
            my_x = bar_index + bar_index - patternStartBarIdx
            drawings.entryRight := label.new(x=my_x, y=ep, text=rightStr, style=label.style_label_lower_right, color = TRANS_COLOR, textalign=text.align_right, textcolor=ep_color)

    drawings

draw_bad_rrr_v1(float ep,
                     float rrr,
                     int min_bars_label_length,
                     int ep_thickness,
                     color ep_color) =>

    drawings = tradeDrawingsV1.new()
    // draw normally
    my_x = bar_index + math.floor((min_bars_label_length) / 2)
    drawings.entryLine := line.new(x1=bar_index, y1=ep, x2=bar_index + min_bars_label_length, y2=ep, color=ep_color, width=ep_thickness)
    drawings.entryCenter := label.new(x=my_x, y=ep, text="Bad R/R: " + str.tostring(rrr, '#.##'), style=label.style_label_down, color = ep_color, textalign=text.align_center, textcolor=color.white)

    drawings

remove_trade_drawings_v1(tradeDrawingsV1 drawings) =>
    drawings.entryLine.delete()
    drawings.entryLeft.delete()
    drawings.entryCenter.delete()
    drawings.entryRight.delete()
    drawings.tp1Line.delete()
    drawings.tp1Left.delete()
    drawings.tp1Center.delete()
    drawings.tp1Right.delete()
    drawings.tp2Line.delete()
    drawings.tp2Left.delete()
    drawings.tp2Center.delete()
    drawings.tp2Right.delete()
    drawings.tp3Line.delete()
    drawings.tp3Left.delete()
    drawings.tp3Center.delete()
    drawings.tp3Right.delete()
    drawings.slLine.delete()
    drawings.slLeft.delete()
    drawings.slCenter.delete()
    drawings.slRight.delete()

remove_trade_drawings_labels_v1(tradeDrawingsV1 drawings) =>
    drawings.entryLeft.delete()
    drawings.entryCenter.delete()
    drawings.entryRight.delete()
    drawings.tp1Left.delete()
    drawings.tp1Center.delete()
    drawings.tp1Right.delete()
    drawings.tp2Left.delete()
    drawings.tp2Center.delete()
    drawings.tp2Right.delete()
    drawings.tp3Left.delete()
    drawings.tp3Center.delete()
    drawings.tp3Right.delete()
    drawings.slLeft.delete()
    drawings.slCenter.delete()
    drawings.slRight.delete()


// @type V2 drawing container with a single label per line (compact).
//       Modern streamlined style with tooltips. More memory-efficient than V1.
export type tradeDrawingsV2
    line entryLine
    label entryLabel
    line tp1Line
    label tp1Label
    line tp2Line
    label tp2Label
    line tp3Line
    label tp3Label
    line slLine
    label slLabel

// ─── V2 Functions ──────────────────────────────────────────

shrink_line_v2(int start_idx, int min_bars_label_length, line ln, label rightLabel) =>
    length_to_set = bar_index - start_idx < min_bars_label_length ? min_bars_label_length : bar_index - start_idx

    if not na(ln)
        ln.set_x2(x = start_idx + length_to_set)
    if not na(rightLabel)
        rightLabel.set_x(x = start_idx + length_to_set)

draw_bad_rrr_v2(float ep,
                         float rrr,
                         int min_bars_label_length,
                         int ep_thickness,
                         color ep_color) =>

    drawings = tradeDrawingsV2.new()
    // draw normally
    drawings.entryLine := line.new(x1=bar_index, y1=ep, x2=bar_index + min_bars_label_length, y2=ep, color=ep_color, width=ep_thickness)
    drawings.entryLabel := label.new(x=bar_index + min_bars_label_length, y=ep, text="Bad R/R: " + str.tostring(rrr, '#.##'), style=label.style_label_left, color = ep_color, textalign=text.align_center, textcolor=color.white)

    drawings

remove_trade_drawings_v2(tradeDrawingsV2 drawings) =>
    drawings.entryLine.delete()
    drawings.entryLabel.delete()
    drawings.tp1Line.delete()
    drawings.tp1Label.delete()
    drawings.tp2Line.delete()
    drawings.tp2Label.delete()
    drawings.tp3Line.delete()
    drawings.tp3Label.delete()
    drawings.slLine.delete()
    drawings.slLabel.delete()

remove_trade_drawings_labels_v2(tradeDrawingsV2 drawings) =>
    drawings.entryLabel.delete()
    drawings.tp1Label.delete()
    drawings.tp2Label.delete()
    drawings.tp3Label.delete()
    drawings.slLabel.delete()

draw_trade_tp_sl_v2(int direction,
                 float ep,
                 float tp1,
                 float tp2,
                 float tp3,
                 float sl,
                 float rrr,
                 float tp1_perc,
                 float tp2_perc,
                 float tp3_perc,
                 string sizeInfo,
                 int patternStartBarIdx,
                 int tp_sl_line_length,
                 bool show_tp1,
                 bool show_tp2,
                 bool show_tp3,
                 bool show_sl,
                 bool show_ep,
                 bool show_size_info,
                 string tp_sl_label_pos,
                 string tp_sl_price_pos,
                 string tp_sl_rrr_pos,
                 string tp_sl_perc_pos,
                 string tp_sl_qty_pos,
                 string tp1_style,
                 string tp2_style,
                 string tp3_style,
                 string sl_style,
                 string ep_style,
                 int tp1_thickness,
                 int tp2_thickness,
                 int tp3_thickness,
                 int sl_thickness,
                 int ep_thickness,
                 color tp1_color,
                 color tp2_color,
                 color tp3_color,
                 color sl_color,
                 color buy_color,
                 color sell_color) =>

    drawings = tradeDrawingsV2.new()
    line_size = math.min(tp_sl_line_length == 0? bar_index - patternStartBarIdx - 1 : tp_sl_line_length, 499)

    // lines
    if not na(tp1) and show_tp1
        drawings.tp1Line := line.new(x1=bar_index, y1=tp1, x2=bar_index + line_size, y2=tp1, color=tp1_color, style = get_line_style(tp1_style), width=tp1_thickness)
    if not na(tp2) and show_tp2
        drawings.tp2Line := line.new(x1=bar_index, y1=tp2, x2=bar_index + line_size, y2=tp2, color=tp2_color, style = get_line_style(tp2_style), width=tp2_thickness)
    if not na(tp3) and show_tp3
        drawings.tp3Line := line.new(x1=bar_index, y1=tp3, x2=bar_index + line_size, y2=tp3, color=tp3_color, style = get_line_style(tp3_style), width=tp3_thickness)
    if show_sl
        drawings.slLine := line.new(x1=bar_index, y1=sl, x2=bar_index + line_size, y2=sl, color=sl_color, style = get_line_style(sl_style), width=sl_thickness)
    if show_ep
        drawings.entryLine := line.new(x1=bar_index, y1=ep, x2=bar_index + line_size, y2=ep, color=(direction == 1 ? buy_color : sell_color), style = get_line_style(ep_style), width=ep_thickness)

    // direction-based label positioning
    // Long (direction == 1): SL below entry → label below SL, TP above entry → label above TP, EP label below line
    // Short (direction == -1): SL above entry → label above SL, TP below entry → label below TP, EP label above line
    bool sl_below  = direction == 1
    bool tp_above  = direction == 1
    bool ep_below  = direction == 1

    // labels
    if show_sl
        string slStr = ""
        if tp_sl_label_pos != "Off"
            slStr += "SL"
        if tp_sl_price_pos != "Off"
            if slStr != ""
                slStr += ": "
            slStr += str.tostring(sl, format.mintick)
        if slStr != ""
            slStr += " "
            drawings.slLabel := label.new(x=bar_index + line_size, y=sl, text=slStr, style=(sl_below ? label.style_label_upper_right : label.style_label_lower_right), color = TRANS_COLOR, textalign=text.align_right, textcolor=sl_color, tooltip = "Stop Loss: " + str.tostring(sl, format.mintick))

    bool single_tp = show_tp1 and not show_tp2 and not show_tp3

    if not na(tp1) and show_tp1
        string tp1Str = ""
        if tp_sl_label_pos != "Off"
            tp1Str += single_tp ? "TP" : "TP1"
        if tp_sl_price_pos != "Off"
            if tp1Str != ""
                tp1Str += ": "
            tp1Str += str.tostring(tp1, format.mintick)
        if tp_sl_perc_pos != "Off" and not na(tp1_perc)
            if tp1Str != ""
                tp1Str += " - "
            tp1Str += str.tostring(tp1_perc, '#') + "%"
        if tp1Str != ""
            tp1Str += " "
            drawings.tp1Label := label.new(x=bar_index + line_size, y=tp1, text=tp1Str, style=(tp_above ? label.style_label_lower_right : label.style_label_upper_right), color = TRANS_COLOR, textalign=text.align_right, textcolor=tp1_color, tooltip = (single_tp ? "Take Profit: " : "Take Profit 1: ") + str.tostring(tp1, format.mintick))

    if not na(tp2) and show_tp2
        string tp2Str = ""
        if tp_sl_label_pos != "Off"
            tp2Str += "TP2"
        if tp_sl_price_pos != "Off"
            if tp2Str != ""
                tp2Str += ": "
            tp2Str += str.tostring(tp2, format.mintick)
        if tp_sl_perc_pos != "Off" and not na(tp2_perc)
            if tp2Str != ""
                tp2Str += " - "
            tp2Str += str.tostring(tp2_perc, '#') + "%"
        if tp2Str != ""
            tp2Str += " "
            drawings.tp2Label := label.new(x=bar_index + line_size, y=tp2, text=tp2Str, style=(tp_above ? label.style_label_lower_right : label.style_label_upper_right), color = TRANS_COLOR, textalign=text.align_right, textcolor=tp2_color, tooltip = "Take Profit 2: " + str.tostring(tp2, format.mintick))

    if not na(tp3) and show_tp3
        string tp3Str = ""
        if tp_sl_label_pos != "Off"
            tp3Str += "TP3"
        if tp_sl_price_pos != "Off"
            if tp3Str != ""
                tp3Str += ": "
            tp3Str += str.tostring(tp3, format.mintick)
        if tp_sl_perc_pos != "Off" and not na(tp3_perc)
            if tp3Str != ""
                tp3Str += " - "
            tp3Str += str.tostring(tp3_perc, '#') + "%"
        if tp3Str != ""
            tp3Str += " "
            drawings.tp3Label := label.new(x=bar_index + line_size, y=tp3, text=tp3Str, style=(tp_above ? label.style_label_lower_right : label.style_label_upper_right), color = TRANS_COLOR, textalign=text.align_right, textcolor=tp3_color, tooltip = "Take Profit 3: " + str.tostring(tp3, format.mintick))

    if show_ep
        string epStr = ""
        if tp_sl_label_pos != "Off"
            epStr += (direction == 1 ? "BUY" : "SELL")
        if tp_sl_price_pos != "Off"
            if epStr != ""
                epStr += ": "
            epStr += str.tostring(ep, format.mintick)
        if tp_sl_rrr_pos != "Off"
            if epStr != ""
                epStr += " - "
            epStr += str.tostring(rrr, '#.##') + "R"
        if show_size_info and sizeInfo != ""
            epStr += "\n" + sizeInfo
        if epStr != ""
            epStr += " "
            drawings.entryLabel := label.new(x=bar_index + line_size, y=ep, text=epStr, style=(ep_below ? label.style_label_upper_right : label.style_label_lower_right), color = TRANS_COLOR, textalign=text.align_right, textcolor=(direction == 1 ? buy_color : sell_color), tooltip = "Entry: " + str.tostring(ep, format.mintick))

    drawings

// @type V3 drawing container with directional arrows and bar-level indicators.
//       Advanced style with ▲/▼ arrows and separate bar-level entry markers.
export type tradeDrawingsV3
    line entryLine
    label entryLabelLine
    label entryLabelBar
    line tp1Line
    label tp1Label
    line tp2Line
    label tp2Label
    line tp3Line
    label tp3Label
    line slLine
    label slLabel

// ─── V3 Functions ──────────────────────────────────────────

draw_trade_tp_sl_v3(int direction,
                 float ep,
                 float tp1,
                 float tp2,
                 float tp3,
                 float sl,
                 float rrr,
                 float tp1_perc,
                 float tp2_perc,
                 float tp3_perc,
                 string sizeInfo,
                 int patternStartBarIdx,
                 int tp_sl_line_length,
                 bool show_tp1,
                 bool show_tp2,
                 bool show_tp3,
                 bool show_sl,
                 bool show_ep,
                 bool show_size_info,
                 string tp_sl_label_pos,
                 string tp_sl_price_pos,
                 string tp_sl_rrr_pos,
                 string tp_sl_perc_pos,
                 string tp_sl_qty_pos,
                 string tp1_style,
                 string tp2_style,
                 string tp3_style,
                 string sl_style,
                 string ep_style,
                 int tp1_thickness,
                 int tp2_thickness,
                 int tp3_thickness,
                 int sl_thickness,
                 int ep_thickness,
                 color tp1_color,
                 color tp2_color,
                 color tp3_color,
                 color sl_color,
                 color buy_color,
                 color sell_color) =>

    drawings = tradeDrawingsV3.new()
    line_size = math.min(tp_sl_line_length == 0? bar_index - patternStartBarIdx - 1 : tp_sl_line_length, 499)

    // lines
    if not na(tp1) and show_tp1
        drawings.tp1Line := line.new(x1=bar_index, y1=tp1, x2=bar_index + line_size, y2=tp1, color=tp1_color, style = get_line_style(tp1_style), width=tp1_thickness)
    if not na(tp2) and show_tp2
        drawings.tp2Line := line.new(x1=bar_index, y1=tp2, x2=bar_index + line_size, y2=tp2, color=tp2_color, style = get_line_style(tp2_style), width=tp2_thickness)
    if not na(tp3) and show_tp3
        drawings.tp3Line := line.new(x1=bar_index, y1=tp3, x2=bar_index + line_size, y2=tp3, color=tp3_color, style = get_line_style(tp3_style), width=tp3_thickness)
    if show_sl
        drawings.slLine := line.new(x1=bar_index, y1=sl, x2=bar_index + line_size, y2=sl, color=sl_color, style = get_line_style(sl_style), width=sl_thickness)
    if show_ep
        drawings.entryLine := line.new(x1=bar_index, y1=ep, x2=bar_index + line_size, y2=ep, color=(direction == 1 ? buy_color : sell_color), style = get_line_style(ep_style), width=ep_thickness)

    // labels
    if show_sl
        // new format SL
        string slStr = "SL "
        drawings.slLabel := label.new(x=bar_index + line_size, y=sl, text=slStr, style=label.style_none, color = TRANS_COLOR, textalign=text.align_right, textcolor=sl_color, tooltip = "Stop Loss: " + str.tostring(sl, format.mintick))

    if not na(tp1) and show_tp1
        // new format TP 1
        string tp1Str = "TP 1  "
        drawings.tp1Label := label.new(x=bar_index + line_size, y=tp1, text=tp1Str, style=label.style_none, color = TRANS_COLOR, textalign=text.align_right, textcolor=tp1_color, tooltip = "Take Profit 1: " + str.tostring(tp1, format.mintick))

    if not na(tp2) and show_tp2
        // new format TP 2
        string tp2Str = "TP 2  "
        drawings.tp2Label := label.new(x=bar_index + line_size, y=tp2, text=tp2Str, style=label.style_none, color = TRANS_COLOR, textalign=text.align_right, textcolor=tp2_color, tooltip = "Take Profit 2: " + str.tostring(tp2, format.mintick))

    if not na(tp3) and show_tp3
        // new format TP 3
        string tp3Str = "TP 3  "
        drawings.tp3Label := label.new(x=bar_index + line_size, y=tp3, text=tp3Str, style=label.style_none, color = TRANS_COLOR, textalign=text.align_right, textcolor=tp3_color, tooltip = "Take Profit 3: " + str.tostring(tp3, format.mintick))

    if show_ep
        // new format EP\nRR
        string epStr = (direction == 1 ? "▲ " : "▼ ") + str.tostring(rrr, '#.##') + "R" + (show_size_info? "\n" + sizeInfo : "")
        drawings.entryLabelLine := label.new(x=bar_index + line_size, y=ep, text=epStr, style=label.style_label_left, color = (direction == 1 ? buy_color : sell_color), textalign=text.align_left, textcolor=color.white, tooltip = "Entry: " + str.tostring(ep, format.mintick))
        drawings.entryLabelBar := label.new(x=bar_index, y = na, yloc=(direction == 1 ? yloc.belowbar : yloc.abovebar), text=(direction == 1 ? "▲" : "▼"), textcolor=color.white, style=(direction == 1 ? label.style_label_up : label.style_label_down), color = (direction == 1 ? buy_color : sell_color), tooltip = "Entry: " + str.tostring(ep, format.mintick))
    drawings

shrink_line_v3(int start_idx, int min_bars_label_length, line ln, label rightLabel) =>
    length_to_set = bar_index - start_idx < min_bars_label_length ? min_bars_label_length : bar_index - start_idx

    if not na(ln)
        ln.set_x2(x = start_idx + length_to_set)
    if not na(rightLabel)
        rightLabel.set_x(x = start_idx + length_to_set)

draw_bad_rrr_v3(float ep,
                         float rrr,
                         int min_bars_label_length,
                         int ep_thickness,
                         color ep_color) =>

    drawings = tradeDrawingsV3.new()
    // draw normally
    drawings.entryLine := line.new(x1=bar_index, y1=ep, x2=bar_index + min_bars_label_length, y2=ep, color=ep_color, width=ep_thickness)
    drawings.entryLabelLine := label.new(x=bar_index + min_bars_label_length, y=ep, text="Bad R/R: " + str.tostring(rrr, '#.##'), style=label.style_label_left, color = ep_color, textalign=text.align_center, textcolor=color.white)

    drawings

remove_trade_drawings_v3(tradeDrawingsV3 drawings) =>
    drawings.entryLine.delete()
    drawings.entryLabelLine.delete()
    drawings.entryLabelBar.delete()
    drawings.tp1Line.delete()
    drawings.tp1Label.delete()
    drawings.tp2Line.delete()
    drawings.tp2Label.delete()
    drawings.tp3Line.delete()
    drawings.tp3Label.delete()
    drawings.slLine.delete()
    drawings.slLabel.delete()

remove_trade_drawings_labels_v3(tradeDrawingsV3 drawings) =>
    drawings.entryLabelLine.delete()
    drawings.entryLabelBar.delete()
    drawings.tp1Label.delete()
    drawings.tp2Label.delete()
    drawings.tp3Label.delete()
    drawings.slLabel.delete()

// @type V4 drawing container with direction-based label positioning and price display.
//       Compact like V2, but respects tp_sl_price_pos/tp_sl_rrr_pos parameters.
//       Labels are positioned away from the entry line (above/below) based on trade direction.
//       Entry label always sits above the line with format "▲ 1.50R  ·  309.21".
export type tradeDrawingsV4
    line entryLine
    label entryLabel
    line tp1Line
    label tp1Label
    line tp2Line
    label tp2Label
    line tp3Line
    label tp3Label
    line slLine
    label slLabel

// ─── V4 Functions ──────────────────────────────────────────

shrink_line_v4(int start_idx, int min_bars_label_length, line ln, label rightLabel) =>
    length_to_set = bar_index - start_idx < min_bars_label_length ? min_bars_label_length : bar_index - start_idx

    if not na(ln)
        ln.set_x2(x = start_idx + length_to_set)
    if not na(rightLabel)
        rightLabel.set_x(x = start_idx + length_to_set)

extend_line_v4(line ln, label rightLabel) =>
    if not na(ln)
        ln.set_x2(x = bar_index)
    if not na(rightLabel)
        rightLabel.set_x(x = bar_index)

draw_bad_rrr_v4(float ep,
                         float rrr,
                         int min_bars_label_length,
                         int ep_thickness,
                         color ep_color) =>

    drawings = tradeDrawingsV4.new()
    drawings.entryLine := line.new(x1=bar_index, y1=ep, x2=bar_index + min_bars_label_length, y2=ep, color=ep_color, width=ep_thickness)
    drawings.entryLabel := label.new(x=bar_index + min_bars_label_length, y=ep, text="Bad R/R: " + str.tostring(rrr, '#.##'), style=label.style_label_left, color = ep_color, textalign=text.align_center, textcolor=color.white)

    drawings

remove_trade_drawings_v4(tradeDrawingsV4 drawings) =>
    drawings.entryLine.delete()
    drawings.entryLabel.delete()
    drawings.tp1Line.delete()
    drawings.tp1Label.delete()
    drawings.tp2Line.delete()
    drawings.tp2Label.delete()
    drawings.tp3Line.delete()
    drawings.tp3Label.delete()
    drawings.slLine.delete()
    drawings.slLabel.delete()

remove_trade_drawings_labels_v4(tradeDrawingsV4 drawings) =>
    drawings.entryLabel.delete()
    drawings.tp1Label.delete()
    drawings.tp2Label.delete()
    drawings.tp3Label.delete()
    drawings.slLabel.delete()

draw_trade_tp_sl_v4(int direction,
                 float ep,
                 float tp1,
                 float tp2,
                 float tp3,
                 float sl,
                 float rrr,
                 float tp1_perc,
                 float tp2_perc,
                 float tp3_perc,
                 string sizeInfo,
                 int patternStartBarIdx,
                 int tp_sl_line_length,
                 bool show_tp1,
                 bool show_tp2,
                 bool show_tp3,
                 bool show_sl,
                 bool show_ep,
                 bool show_size_info,
                 string tp_sl_label_pos,
                 string tp_sl_price_pos,
                 string tp_sl_rrr_pos,
                 string tp_sl_perc_pos,
                 string tp_sl_qty_pos,
                 string tp1_style,
                 string tp2_style,
                 string tp3_style,
                 string sl_style,
                 string ep_style,
                 int tp1_thickness,
                 int tp2_thickness,
                 int tp3_thickness,
                 int sl_thickness,
                 int ep_thickness,
                 color tp1_color,
                 color tp2_color,
                 color tp3_color,
                 color sl_color,
                 color buy_color,
                 color sell_color) =>

    drawings = tradeDrawingsV4.new()
    line_size = math.min(tp_sl_line_length == 0? bar_index - patternStartBarIdx - 1 : tp_sl_line_length, 499)

    // label styles for direction-based positioning (away from entry)
    // Long (direction == 1): SL is below entry → label below SL line, TP is above entry → label above TP line
    // Short (direction == -1): SL is above entry → label above SL line, TP is below entry → label below TP line
    bool sl_below = direction == 1
    bool tp_above = direction == 1

    // lines
    if not na(tp1) and show_tp1
        drawings.tp1Line := line.new(x1=bar_index, y1=tp1, x2=bar_index + line_size, y2=tp1, color=tp1_color, style = get_line_style(tp1_style), width=tp1_thickness)
    if not na(tp2) and show_tp2
        drawings.tp2Line := line.new(x1=bar_index, y1=tp2, x2=bar_index + line_size, y2=tp2, color=tp2_color, style = get_line_style(tp2_style), width=tp2_thickness)
    if not na(tp3) and show_tp3
        drawings.tp3Line := line.new(x1=bar_index, y1=tp3, x2=bar_index + line_size, y2=tp3, color=tp3_color, style = get_line_style(tp3_style), width=tp3_thickness)
    if show_sl
        drawings.slLine := line.new(x1=bar_index, y1=sl, x2=bar_index + line_size, y2=sl, color=sl_color, style = get_line_style(sl_style), width=sl_thickness)
    if show_ep
        drawings.entryLine := line.new(x1=bar_index, y1=ep, x2=bar_index + line_size, y2=ep, color=(direction == 1 ? buy_color : sell_color), style = get_line_style(ep_style), width=ep_thickness)

    // labels — all use style_none so text stays anchored at the line end regardless of zoom
    if show_sl
        string slStr = ""
        if tp_sl_label_pos != "Off"
            slStr += "SL"
        if tp_sl_price_pos != "Off"
            if slStr != ""
                slStr += ": "
            slStr += str.tostring(sl, format.mintick)
        if slStr != ""
            drawings.slLabel := label.new(x=bar_index + line_size, y=sl, text=slStr, style=label.style_none, color = TRANS_COLOR, textalign=text.align_left, textcolor=sl_color, tooltip = "Stop Loss: " + str.tostring(sl, format.mintick))

    bool single_tp = show_tp1 and not show_tp2 and not show_tp3

    if not na(tp1) and show_tp1
        string tp1Str = ""
        if tp_sl_label_pos != "Off"
            tp1Str += single_tp ? "TP" : "TP 1"
        if tp_sl_price_pos != "Off"
            if tp1Str != ""
                tp1Str += ": "
            tp1Str += str.tostring(tp1, format.mintick)
        if tp_sl_perc_pos != "Off" and not na(tp1_perc)
            if tp1Str != ""
                tp1Str += " - "
            tp1Str += str.tostring(tp1_perc, '#') + "%"
        if tp1Str != ""
            drawings.tp1Label := label.new(x=bar_index + line_size, y=tp1, text=tp1Str, style=label.style_none, color = TRANS_COLOR, textalign=text.align_left, textcolor=tp1_color, tooltip = (single_tp ? "Take Profit: " : "Take Profit 1: ") + str.tostring(tp1, format.mintick))

    if not na(tp2) and show_tp2
        string tp2Str = ""
        if tp_sl_label_pos != "Off"
            tp2Str += "TP 2"
        if tp_sl_price_pos != "Off"
            if tp2Str != ""
                tp2Str += ": "
            tp2Str += str.tostring(tp2, format.mintick)
        if tp_sl_perc_pos != "Off" and not na(tp2_perc)
            if tp2Str != ""
                tp2Str += " - "
            tp2Str += str.tostring(tp2_perc, '#') + "%"
        if tp2Str != ""
            drawings.tp2Label := label.new(x=bar_index + line_size, y=tp2, text=tp2Str, style=label.style_none, color = TRANS_COLOR, textalign=text.align_left, textcolor=tp2_color, tooltip = "Take Profit 2: " + str.tostring(tp2, format.mintick))

    if not na(tp3) and show_tp3
        string tp3Str = ""
        if tp_sl_label_pos != "Off"
            tp3Str += "TP 3"
        if tp_sl_price_pos != "Off"
            if tp3Str != ""
                tp3Str += ": "
            tp3Str += str.tostring(tp3, format.mintick)
        if tp_sl_perc_pos != "Off" and not na(tp3_perc)
            if tp3Str != ""
                tp3Str += " - "
            tp3Str += str.tostring(tp3_perc, '#') + "%"
        if tp3Str != ""
            drawings.tp3Label := label.new(x=bar_index + line_size, y=tp3, text=tp3Str, style=label.style_none, color = TRANS_COLOR, textalign=text.align_left, textcolor=tp3_color, tooltip = "Take Profit 3: " + str.tostring(tp3, format.mintick))

    if show_ep
        string epStr = (direction == 1 ? "▲" : "▼")
        if tp_sl_rrr_pos != "Off"
            epStr += " (" + str.tostring(rrr, '#.##') + "R)"
        if tp_sl_price_pos != "Off"
            epStr += ": " + str.tostring(ep, format.mintick)
        if show_size_info and sizeInfo != ""
            epStr += "\n" + sizeInfo
        drawings.entryLabel := label.new(x=bar_index + line_size, y=ep, text=epStr, style=label.style_none, color = TRANS_COLOR, textalign=text.align_left, textcolor=(direction == 1 ? buy_color : sell_color), tooltip = "Entry: " + str.tostring(ep, format.mintick))

    drawings

// @type Unified container holding one of the versioned drawing types.
//       Allows a single interface for all drawing versions.
export type tradeDrawingsUnion
    tradeDrawingsV1 v1
    tradeDrawingsV2 v2
    tradeDrawingsV3 v3
    tradeDrawingsV4 v4

// ─── Export Functions ──────────────────────────────────────

// @function Adjusts line lengths and label positions to match elapsed bars since trade start.
// @param version               (int) Drawing version (1-4).
// @param start_idx             (int) Bar index where the trade started.
// @param min_bars_label_length (int) Minimum line length in bars.
// @param drawings              (tradeDrawingsUnion) The drawings to adjust.
export shrink_lines(int version, int start_idx, int min_bars_label_length, tradeDrawingsUnion drawings) =>
    switch version
        1 =>
            shrink_line_v1(start_idx, min_bars_label_length, drawings.v1.entryLine, drawings.v1.entryCenter, drawings.v1.entryRight)
            shrink_line_v1(start_idx, min_bars_label_length, drawings.v1.tp1Line, drawings.v1.tp1Center, drawings.v1.tp1Right)
            shrink_line_v1(start_idx, min_bars_label_length, drawings.v1.tp2Line, drawings.v1.tp2Center, drawings.v1.tp2Right)
            shrink_line_v1(start_idx, min_bars_label_length, drawings.v1.tp3Line, drawings.v1.tp3Center, drawings.v1.tp3Right)
            shrink_line_v1(start_idx, min_bars_label_length, drawings.v1.slLine, drawings.v1.slCenter, drawings.v1.slRight)
        2 =>
            shrink_line_v2(start_idx, min_bars_label_length, drawings.v2.entryLine, drawings.v2.entryLabel)
            shrink_line_v2(start_idx, min_bars_label_length, drawings.v2.tp1Line, drawings.v2.tp1Label)
            shrink_line_v2(start_idx, min_bars_label_length, drawings.v2.tp2Line, drawings.v2.tp2Label)
            shrink_line_v2(start_idx, min_bars_label_length, drawings.v2.tp3Line, drawings.v2.tp3Label)
            shrink_line_v2(start_idx, min_bars_label_length, drawings.v2.slLine, drawings.v2.slLabel)
        3 =>
            shrink_line_v3(start_idx, min_bars_label_length, drawings.v3.entryLine, drawings.v3.entryLabelLine)
            shrink_line_v3(start_idx, min_bars_label_length, drawings.v3.tp1Line, drawings.v3.tp1Label)
            shrink_line_v3(start_idx, min_bars_label_length, drawings.v3.tp2Line, drawings.v3.tp2Label)
            shrink_line_v3(start_idx, min_bars_label_length, drawings.v3.tp3Line, drawings.v3.tp3Label)
            shrink_line_v3(start_idx, min_bars_label_length, drawings.v3.slLine, drawings.v3.slLabel)
        4 =>
            shrink_line_v4(start_idx, min_bars_label_length, drawings.v4.entryLine, drawings.v4.entryLabel)
            shrink_line_v4(start_idx, min_bars_label_length, drawings.v4.tp1Line, drawings.v4.tp1Label)
            shrink_line_v4(start_idx, min_bars_label_length, drawings.v4.tp2Line, drawings.v4.tp2Label)
            shrink_line_v4(start_idx, min_bars_label_length, drawings.v4.tp3Line, drawings.v4.tp3Label)
            shrink_line_v4(start_idx, min_bars_label_length, drawings.v4.slLine, drawings.v4.slLabel)

// @function Extends all trade lines and labels to the current bar. Call each bar while a trade is open.
// @param version  (int) Drawing version (currently only V4 supported).
// @param drawings (tradeDrawingsUnion) The drawings to extend.
export extend_lines(int version, tradeDrawingsUnion drawings) =>
    switch version
        4 =>
            extend_line_v4(drawings.v4.entryLine, drawings.v4.entryLabel)
            extend_line_v4(drawings.v4.tp1Line, drawings.v4.tp1Label)
            extend_line_v4(drawings.v4.tp2Line, drawings.v4.tp2Label)
            extend_line_v4(drawings.v4.tp3Line, drawings.v4.tp3Label)
            extend_line_v4(drawings.v4.slLine, drawings.v4.slLabel)

// @function Draws a "Bad R/R" indicator when the risk/reward ratio is insufficient.
// @param version              (int) Drawing version (1-4).
// @param ep                   (float) Entry price.
// @param rrr                  (float) Risk/reward ratio.
// @param min_bars_label_length (int) Line length in bars.
// @param ep_thickness         (int) Entry line width.
// @param ep_color             (color) Entry line color.
// @returns                    (tradeDrawingsUnion) The created drawings.
export draw_bad_rrr(int version,
     float ep,
     float rrr,
     int min_bars_label_length,
     int ep_thickness,
     color ep_color) =>

    ret = tradeDrawingsUnion.new()
    switch version
        1 => ret.v1 := draw_bad_rrr_v1(ep, rrr, min_bars_label_length, ep_thickness, ep_color)
        2 => ret.v2 := draw_bad_rrr_v2(ep, rrr, min_bars_label_length, ep_thickness, ep_color)
        3 => ret.v3 := draw_bad_rrr_v3(ep, rrr, min_bars_label_length, ep_thickness, ep_color)
        4 => ret.v4 := draw_bad_rrr_v4(ep, rrr, min_bars_label_length, ep_thickness, ep_color)
    ret

// @function Removes all drawings (lines and labels) for a trade.
// @param version  (int) Drawing version (1-4).
// @param drawings (tradeDrawingsUnion) The drawings to remove.
export remove_trade_drawings(int version, tradeDrawingsUnion drawings) =>
    switch version
        1 => remove_trade_drawings_v1(drawings.v1)
        2 => remove_trade_drawings_v2(drawings.v2)
        3 => remove_trade_drawings_v3(drawings.v3)
        4 => remove_trade_drawings_v4(drawings.v4)

// @function Removes only labels (keeps lines) for a trade.
// @param version  (int) Drawing version (1-4).
// @param drawings (tradeDrawingsUnion) The drawings whose labels to remove.
export remove_trade_drawings_labels(int version, tradeDrawingsUnion drawings) =>
    switch version
        1 => remove_trade_drawings_labels_v1(drawings.v1)
        2 => remove_trade_drawings_labels_v2(drawings.v2)
        3 => remove_trade_drawings_labels_v3(drawings.v3)
        4 => remove_trade_drawings_labels_v4(drawings.v4)

// @function Creates a complete trade visualization with entry, stop loss, and up to 3 take profit levels.
// @param version             (int) Drawing version: 1 = traditional, 2 = compact, 3 = arrows, 4 = compact with prices.
// @param direction           (int) Trade direction: 1 = long/buy, -1 = short/sell.
// @param ep                  (float) Entry price.
// @param tp1                 (float) Take profit 1 price.
// @param tp2                 (float) Take profit 2 price.
// @param tp3                 (float) Take profit 3 price.
// @param sl                  (float) Stop loss price.
// @param rrr                 (float) Risk/reward ratio.
// @param tp1_perc            (float) TP1 percentage of total reward.
// @param tp2_perc            (float) TP2 percentage of total reward.
// @param tp3_perc            (float) TP3 percentage of total reward.
// @param sizeInfo            (string) Position size info text.
// @param patternStartBarIdx  (int) Bar index where the pattern started.
// @param tp_sl_line_length   (int) Line length in bars (0 = auto from pattern start).
// @param show_tp1            (bool) Show TP1 line and label.
// @param show_tp2            (bool) Show TP2 line and label.
// @param show_tp3            (bool) Show TP3 line and label.
// @param show_sl             (bool) Show SL line and label.
// @param show_ep             (bool) Show entry line and label.
// @param show_size_info      (bool) Show position size info on entry label.
// @param tp_sl_label_pos     (string) Label text position: "Off", "Left", "Center", "Right". V4 treats any non-"Off" as on.
// @param tp_sl_price_pos     (string) Price display position: "Off", "Left", "Center", "Right". V4 treats any non-"Off" as on.
// @param tp_sl_rrr_pos       (string) R:R ratio position: "Off", "Left", "Center", "Right". V4 treats any non-"Off" as on.
// @param tp_sl_perc_pos      (string) TP percentage position: "Off", "Left", "Center", "Right". V4 treats any non-"Off" as on.
// @param tp_sl_qty_pos       (string) Position size position: "Off", "Left", "Center", "Right".
// @param tp1_style           (string) TP1 line style: "Solid", "Dashed", "Dotted".
// @param tp2_style           (string) TP2 line style.
// @param tp3_style           (string) TP3 line style.
// @param sl_style            (string) SL line style.
// @param ep_style            (string) Entry line style.
// @param tp1_thickness       (int) TP1 line width (1-4).
// @param tp2_thickness       (int) TP2 line width.
// @param tp3_thickness       (int) TP3 line width.
// @param sl_thickness        (int) SL line width.
// @param ep_thickness        (int) Entry line width.
// @param tp1_color           (color) TP1 color.
// @param tp2_color           (color) TP2 color.
// @param tp3_color           (color) TP3 color.
// @param sl_color            (color) SL color.
// @param ep_color            (color) Entry color (used by V1).
// @param buy_color           (color) Buy/long entry color (used by V2-V4).
// @param sell_color          (color) Sell/short entry color (used by V2-V4).
// @returns                   (tradeDrawingsUnion) The created drawings.
export draw_trade_tp_sl(int version,
     int direction,
     float ep,
     float tp1,
     float tp2,
     float tp3,
     float sl,
     float rrr,
     float tp1_perc,
     float tp2_perc,
     float tp3_perc,
     string sizeInfo,
     int patternStartBarIdx,
     int tp_sl_line_length,
     bool show_tp1,
     bool show_tp2,
     bool show_tp3,
     bool show_sl,
     bool show_ep,
     bool show_size_info,
     string tp_sl_label_pos,
     string tp_sl_price_pos,
     string tp_sl_rrr_pos,
     string tp_sl_perc_pos,
     string tp_sl_qty_pos,
     string tp1_style,
     string tp2_style,
     string tp3_style,
     string sl_style,
     string ep_style,
     int tp1_thickness,
     int tp2_thickness,
     int tp3_thickness,
     int sl_thickness,
     int ep_thickness,
     color tp1_color,
     color tp2_color,
     color tp3_color,
     color sl_color,
     color ep_color,
     color buy_color,
     color sell_color) =>
    // create a new tradeDrawingsUnion
    ret = tradeDrawingsUnion.new()
    switch version
        1 => ret.v1 := draw_trade_tp_sl_v1(direction, ep, tp1, tp2, tp3, sl, rrr, tp1_perc, tp2_perc, tp3_perc, sizeInfo, patternStartBarIdx, tp_sl_line_length, show_tp1, show_tp2, show_tp3, show_sl, show_ep, show_size_info, tp_sl_label_pos, tp_sl_price_pos, tp_sl_rrr_pos, tp_sl_perc_pos, tp_sl_qty_pos, tp1_style, tp2_style, tp3_style, sl_style, ep_style, tp1_thickness, tp2_thickness, tp3_thickness, sl_thickness, ep_thickness, tp1_color, tp2_color, tp3_color, sl_color, ep_color)
        2 => ret.v2 := draw_trade_tp_sl_v2(direction, ep, tp1, tp2, tp3, sl, rrr, tp1_perc, tp2_perc, tp3_perc, sizeInfo, patternStartBarIdx, tp_sl_line_length, show_tp1, show_tp2, show_tp3, show_sl, show_ep, show_size_info, tp_sl_label_pos, tp_sl_price_pos, tp_sl_rrr_pos, tp_sl_perc_pos, tp_sl_qty_pos, tp1_style, tp2_style, tp3_style, sl_style, ep_style, tp1_thickness, tp2_thickness, tp3_thickness, sl_thickness, ep_thickness, tp1_color, tp2_color, tp3_color, sl_color, buy_color, sell_color)
        3 => ret.v3 := draw_trade_tp_sl_v3(direction, ep, tp1, tp2, tp3, sl, rrr, tp1_perc, tp2_perc, tp3_perc, sizeInfo, patternStartBarIdx, tp_sl_line_length, show_tp1, show_tp2, show_tp3, show_sl, show_ep, show_size_info, tp_sl_label_pos, tp_sl_price_pos, tp_sl_rrr_pos, tp_sl_perc_pos, tp_sl_qty_pos, tp1_style, tp2_style, tp3_style, sl_style, ep_style, tp1_thickness, tp2_thickness, tp3_thickness, sl_thickness, ep_thickness, tp1_color, tp2_color, tp3_color, sl_color, buy_color, sell_color)
        4 => ret.v4 := draw_trade_tp_sl_v4(direction, ep, tp1, tp2, tp3, sl, rrr, tp1_perc, tp2_perc, tp3_perc, sizeInfo, patternStartBarIdx, tp_sl_line_length, show_tp1, show_tp2, show_tp3, show_sl, show_ep, show_size_info, tp_sl_label_pos, tp_sl_price_pos, tp_sl_rrr_pos, tp_sl_perc_pos, tp_sl_qty_pos, tp1_style, tp2_style, tp3_style, sl_style, ep_style, tp1_thickness, tp2_thickness, tp3_thickness, sl_thickness, ep_thickness, tp1_color, tp2_color, tp3_color, sl_color, buy_color, sell_color)
    ret
