//@version=6
// Regime Quadrant Map [XWiseTrade]
// Original work by XWiseTrade. Licensed under Mozilla Public License 2.0.
indicator("Regime Quadrant Map [XWiseTrade]", overlay = false, precision = 2)

// ─────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────
grpVol   = "Volatility Axis (ATR Z-Score)"
atrLen   = input.int(14,  "ATR length",              minval = 2,  group = grpVol)
zLen     = input.int(100, "Z-score lookback",        minval = 20, group = grpVol, tooltip = "Window over which the current ATR is ranked against its own history. Larger = slower, more stable regime reads.")
volHi    = input.float(0.5, "High-volatility threshold (Z)", step = 0.1, group = grpVol, tooltip = "ATR Z-score above this = high-volatility state.")

grpTrend = "Trend Axis (Efficiency Ratio)"
erLen    = input.int(20,  "Efficiency Ratio length",  minval = 2,  group = grpTrend, tooltip = "Net directional move divided by the total path travelled. 1 = perfectly efficient trend, 0 = pure noise.")
erHi     = input.float(0.35, "Trending threshold (ER)", step = 0.05, minval = 0, maxval = 1, group = grpTrend, tooltip = "Efficiency Ratio above this = trending state.")

grpView  = "Display"
showTable = input.bool(true,  "Show regime label",   group = grpView)
tblPos    = input.string("top_right", "Label position", options = ["top_right","top_left","bottom_right","bottom_left"], group = grpView)

// ─────────────────────────────────────────────────────────────
// VOLATILITY AXIS  —  ATR ranked as a Z-score against its own history
// Rationale: raw ATR is not comparable across instruments or eras.
// Z-scoring ATR against its own recent distribution turns it into a
// self-referential "is volatility unusually high/low right now" measure.
// ─────────────────────────────────────────────────────────────
atr    = ta.atr(atrLen)
atrAvg = ta.sma(atr, zLen)
atrSd  = ta.stdev(atr, zLen)
volZ   = atrSd > 0 ? (atr - atrAvg) / atrSd : 0.0
isHiVol = volZ > volHi

// ─────────────────────────────────────────────────────────────
// TREND AXIS  —  Efficiency Ratio (net move / total path)
// Rationale: this measures HOW the price got where it is, not just
// direction. A market can drift up over 20 bars via a clean trend
// (high ER) or via violent back-and-forth (low ER). The two demand
// opposite tactics even at the same net slope.
// ─────────────────────────────────────────────────────────────
netMove   = math.abs(close - close[erLen])
pathSum   = math.sum(math.abs(close - close[1]), erLen)
er        = pathSum > 0 ? netMove / pathSum : 0.0
isTrend   = er > erHi

// ─────────────────────────────────────────────────────────────
// QUADRANT CLASSIFICATION
//   Trend + LowVol  -> Grind      (steady trend, ride it)
//   Trend + HiVol   -> Expansion  (violent trend, momentum)
//   Range + LowVol  -> Coil       (compression, await breakout)
//   Range + HiVol   -> Chop       (whipsaw, stand aside)
// ─────────────────────────────────────────────────────────────
regime = isTrend and not isHiVol ? "GRIND"
     : isTrend and isHiVol       ? "EXPANSION"
     : not isTrend and not isHiVol ? "COIL"
     : "CHOP"

cGrind     = color.new(#26a69a, 0)
cExpansion = color.new(#ffb300, 0)
cCoil      = color.new(#42a5f5, 0)
cChop      = color.new(#ef5350, 0)

regimeCol = regime == "GRIND" ? cGrind : regime == "EXPANSION" ? cExpansion : regime == "COIL" ? cCoil : cChop

// ─────────────────────────────────────────────────────────────
// PLOTS  —  two axes on the same pane, zero reference lines
// ─────────────────────────────────────────────────────────────
plot(volZ, "ATR Z-score",        color = color.new(#ab47bc, 0), linewidth = 2)
plot(er,   "Efficiency Ratio",   color = color.new(#78909c, 0), linewidth = 2)
hline(volHi, "Vol threshold",    color = color.new(#ab47bc, 60), linestyle = hline.style_dashed)
hline(erHi,  "Trend threshold",  color = color.new(#78909c, 60), linestyle = hline.style_dashed)
hline(0,     "Zero",             color = color.new(color.gray, 70))

// background tint by regime
bgcolor(color.new(regimeCol, 88), title = "Regime tint")

// ─────────────────────────────────────────────────────────────
// REGIME LABEL
// ─────────────────────────────────────────────────────────────
var table t = na
if showTable
    if na(t)
        t := table.new(tblPos, 1, 2, border_width = 1)
    table.cell(t, 0, 0, "REGIME", text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(t, 0, 1, regime,   text_color = color.white, bgcolor = regimeCol, text_size = size.large)

// ─────────────────────────────────────────────────────────────
// ALERTS  —  fire when the regime changes
// ─────────────────────────────────────────────────────────────
regimeChanged = regime != regime[1]
alertcondition(regimeChanged, "Regime change", "Regime changed to a new quadrant")

// These are descriptive regime classifications for discretionary use,
// not buy/sell signals.
