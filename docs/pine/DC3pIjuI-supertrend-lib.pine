//@version=5
library("supertrend_lib", overlay=true)

// @function Calculates Supertrend values
// @param length ATR Length
// @param factor ATR Multiplier/Factor
// @returns [supertrendLine, direction] where direction is 1 for bullish, -1 for bearish
export calculate(simple int length, simple float factor) =>
    [supertrend, direction] = ta.supertrend(factor, length)
    [supertrend, direction]
