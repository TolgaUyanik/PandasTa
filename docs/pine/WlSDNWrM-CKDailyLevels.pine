//@version=6
// @description Daily S1 S2 R1 R2 levels for CK Magic Trade
library("CKDailyLevels", overlay=false)

// @function Returns S1, S2, R1, R2 for selected date.
// @param dateKey Date in YYYYMMDD format.
// @returns [s1, s2, r1, r2]
export getLevels(series int dateKey) =>
    float s1 = na
    float s2 = na
    float r1 = na
    float r2 = na

    if dateKey == 20260715
        s1 := 25100.0
        s2 := 25050.0
        r1 := 25200.0
        r2 := 25280.0

    else if dateKey == 20260716
        s1 := 25220.0
        s2 := 25170.0
        r1 := 25340.0
        r2 := 25410.0

    [s1, s2, r1, r2]