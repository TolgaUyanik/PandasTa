//@version=6
import Kevinroku/AmendLogic_CSS/1 as css

library("AmendLogic_PERF", overlay=true)

// ══════════════════════════════════════════════════════
// HELPER
// ══════════════════════════════════════════════════════

f_getAlpha(val, minVal, maxVal) =>
    rangea = maxVal - minVal
    rangea == 0 ? 50 : (
         val >= 0 ?
             100 - math.round((val / maxVal) * 100) :
             100 - math.round((val / minVal) * 100)
     )

// ══════════════════════════════════════════════════════
// PROFIT TABLE
// ══════════════════════════════════════════════════════

export ProfitTable(float equity) =>
    int prec = 0

    var table monthlyProfitTable = table(na)

    // ── Period Detection ──────────────────────────────
    bool newMonth = month(time) != month(time[1])
    bool newYear  = year(time)  != year(time[1])

    // ── Bar P&L ───────────────────────────────────────
    float profitLossPercent = equity / equity[1] - 1
    float ProfitLoss        = equity - equity[1]

    // ── Running Accumulators ──────────────────────────
    float currentMonthProfit = 0.0
    float currentYearProfit  = 0.0
    float currentMonthPnL    = 0.0
    float currentYearPnL     = 0.0

    currentMonthProfit := newMonth ? 0.0 : currentMonthProfit[1] + ProfitLoss
    currentYearProfit  := newYear  ? 0.0 : currentYearProfit[1]  + ProfitLoss
    currentMonthPnL    := newMonth ? 0.0 : (1 + currentMonthPnL[1]) * (1 + profitLossPercent) - 1
    currentYearPnL     := newYear  ? 0.0 : (1 + currentYearPnL[1])  * (1 + profitLossPercent) - 1

    // ── Storage Arrays ────────────────────────────────
    var float[] monthlyProfit      = array.new_float(0)
    var int[]   monthlyProfitCount = array.new_int(0)
    var float[] yearlyProfit       = array.new_float(0)
    var int[]   yearlyProfitCount  = array.new_int(0)

    var float[] monthlyPnLs      = array.new_float(0)
    var int[]   monthlyPnLsCount = array.new_int(0)
    var float[] yearlyPnLs       = array.new_float(0)
    var int[]   yearlyPnLsCount  = array.new_int(0)

    bool pnlComputed = false

    // ── Monthly Push ──────────────────────────────────
    if not na(currentMonthProfit[1]) and (newMonth or barstate.islast)
        if pnlComputed[1]
            array.pop(monthlyProfit)
            array.pop(monthlyProfitCount)
        array.push(monthlyProfit,      currentMonthProfit[1])
        array.push(monthlyProfitCount, time[1])

    if not na(currentMonthPnL[1]) and (newMonth or barstate.islast)
        if pnlComputed[1]
            array.pop(monthlyPnLs)
            array.pop(monthlyPnLsCount)
        array.push(monthlyPnLs,      currentMonthPnL[1])
        array.push(monthlyPnLsCount, time[1])

    // ── Yearly Push ───────────────────────────────────
    if not na(currentYearProfit[1]) and (newYear or barstate.islast)
        if pnlComputed[1]
            array.pop(yearlyProfit)
            array.pop(yearlyProfitCount)
        array.push(yearlyProfit,      currentYearProfit[1])
        array.push(yearlyProfitCount, time[1])

    if not na(currentYearPnL[1]) and (newYear or barstate.islast)
        if pnlComputed[1]
            array.pop(yearlyPnLs)
            array.pop(yearlyPnLsCount)
        array.push(yearlyPnLs,      currentYearPnL[1])
        array.push(yearlyPnLsCount, time[1])

    // ── Min/Max für Heatmap-Skalierung ────────────────
    float minMonthPnL = array.min(monthlyPnLs)
    float maxMonthPnL = array.max(monthlyPnLs)
    float minYearPnL  = array.min(yearlyPnLs)
    float maxYearPnL  = array.max(yearlyPnLs)

    pnlComputed := barstate.islast ? true : (pnlComputed[1] ? pnlComputed[1] : false)

    // ══════════════════════════════════════════════════
    // TABLE RENDER
    // ══════════════════════════════════════════════════

    if barstate.islast

        monthlyProfitTable := table.new(
             position     = position.bottom_right,
             columns      = 14,
             rows         = array.size(yearlyProfit) + 1,
             bgcolor      = css.getColor('gray', 15),     // #030620 — tiefdunkler Chip-BG
             frame_color  = css.getColor('blue', 85),     // #0161EF — subtile Brand-Rahmung
             frame_width  = 1,
             border_color = css.getColor('gray', 75),
             border_width = 1)

        // ── Header ────────────────────────────────────
        table.cell(monthlyProfitTable,  0, 0, "Y|M",
             text_color      = css.getColor('blue', 0),   // Primary Brand
             text_size       = size.small,
             bgcolor         = css.getColor('gray', 15),
             text_formatting = text.format_bold)

        string[] months = array.from(
             "Jan","Feb","Mar","Apr","May","Jun",
             "Jul","Aug","Sep","Oct","Nov","Dec")
        for i = 0 to 11
            table.cell(monthlyProfitTable, i + 1, 0, array.get(months, i),
                 text_color      = css.getColor('black', 40),
                 text_size       = size.small,
                 bgcolor         = css.getColor('gray', 15),
                 text_formatting = text.format_bold)

        table.cell(monthlyProfitTable, 13, 0, "Year",
             text_color      = css.getColor('blue', 0),   // Primary Brand — hebt sich ab
             text_size       = size.small,
             bgcolor         = css.getColor('gray', 15),
             text_formatting = text.format_bold)

        // ── Year Rows ─────────────────────────────────
        for yearIndex = 0 to array.size(yearlyProfit) - 1
            yearPnL = array.get(yearlyPnLs, yearIndex)
            if not na(yearPnL) and yearPnL != 0
                yearAlpha   = f_getAlpha(yearPnL, minYearPnL, maxYearPnL)
                // BG: subtiler Tint (min. 88% transp.), Text: volle Farbe
                yearBg      = yearPnL > 0
                     ? css.getColor('green', math.max(yearAlpha, 88))
                     : css.getColor('red',   math.max(yearAlpha, 88))
                yearTextClr = yearPnL > 0
                     ? css.getColor('green', 0)  // #00C896 voll
                     : css.getColor('red',   0)  // #FF3B5C voll

                // Jahr-Index-Zelle
                table.cell(monthlyProfitTable, 0, yearIndex + 1,
                     str.tostring(year(array.get(yearlyProfitCount, yearIndex))),
                     text_color      = css.getColor('black', 50),
                     text_size       = size.small,
                     bgcolor         = css.getColor('gray', 15),
                     text_formatting = text.format_bold)

                // Jahr-PnL-Zelle
                string yearlyReturnPercent =
                     str.tostring(math.round(array.get(yearlyPnLs, yearIndex) * 100, 0)) + "%"
                table.cell(monthlyProfitTable, 13, yearIndex + 1, yearlyReturnPercent,
                     text_color      = yearTextClr,
                     text_size       = size.small,
                     bgcolor         = yearBg,
                     text_formatting = text.format_bold)

        // ── Month Cells ───────────────────────────────
        for monthIndex = 0 to array.size(monthlyProfit) - 1
            monthPnL = array.get(monthlyPnLs, monthIndex)
            if not na(monthPnL) and monthPnL != 0
                monthAlpha   = f_getAlpha(monthPnL, minMonthPnL, maxMonthPnL)
                // BG: subtiler Tint (min. 88% transp.), Text: volle Farbe
                monthBg      = monthPnL > 0
                     ? css.getColor('green', math.max(monthAlpha, 88))
                     : css.getColor('red',   math.max(monthAlpha, 88))
                monthTextClr = monthPnL > 0
                     ? css.getColor('green', 0)
                     : css.getColor('red',   0)

                string monthlyReturnPercent =
                     str.tostring(math.round(array.get(monthlyPnLs, monthIndex) * 100, 0)) + "%"
                monthRow    = year(array.get(monthlyProfitCount,  monthIndex)) - year(array.get(yearlyProfitCount, 0)) + 1
                monthColumn = month(array.get(monthlyProfitCount, monthIndex))

                table.cell(monthlyProfitTable, monthColumn, monthRow, monthlyReturnPercent,
                     text_color = monthTextClr,
                     text_size  = size.small,
                     bgcolor    = monthBg)
