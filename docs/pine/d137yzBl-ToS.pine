	string sNa = na
	txt += 
		 "\n" + "For `string sNa = na`, sNa.toS(nz=\"--\") returns a placeholder for na value: "   
		//  + sNa.toS(nz = "--") + ", \n na(sNa.toS()) = "  
		//  + str.tostring( na(sNa.toS())) + " = \"\""

	txt += "\n -------------- simple types .toS () ------------------- \n"
	txt+= "b	.toS()		: " +	b		.toS()		+ "\n"
	txt+= "i	.toS()		: " +	i		.toS()		+ "\n"
	txt+= "f	.toS()		: " +	f		.toS()		+ "\n"
	txt+= "s	.toS()		: " +	s		.toS()		+ "\n"
	txt+= "color.toS(\"HEX\")		 " +	i_clr		.toS("HEX")		+ ", RGB "
	txt+= "color.toS(\"RGB\")		: " +	i_clr		.toS("RGB")		+ "\n"
	txt+= "color.toS()		: " +	i_clr		.toS()		+ "\n"
	txt+= "lnB	.toS()	: " +	lnB		.toS()		+ "\n"
	txt+= "lnT	.toS()	: " +	lnT		.toS()		+ "\n"
	txt+= "lblB	.toS()	: " +	lblB	.toS(print_text = true)			+ "\n"
	txt+= "lblT	.toS()	: " +	lblT	.toS()			+ "\n"
	txt+= "bxB	.toS()	: " +	bxB		.toS()		+ "\n"
	txt+= "bxT	.toS()	: " +	bxT		.toS()				+ "\n"
 
	//}


	// ━━━━━ test toShortString() ━━━━━{

	txt += "\n\n -------- TEST toShortString() -------- \n\n"
	txt += "\n12" 									+ "-->" + toShortString(12)
	txt += "\n12,350" 								+ "-->" + toShortString(12350)
	txt += "\n12,350,000" 							+ "-->" + toShortString(12350000)
	txt += "\n12,350,000,000" 						+ "-->" + toShortString(12350000000)
	txt += "\n12,350,000,000,000" 					+ "-->" + toShortString(12350000000000)
	txt += "\n12,350,000,000,000,000" 				+ "-->" + toShortString(12350000000000000)
	txt += "\n12,350,000,000,000,000,000" 			+ "-->" + toShortString(12350000000000000000)
	txt += "\n12,350,000,000,000,000,000,000" 		+ "-->" + toShortString(12350000000000000000000)
	//}

	// --- draw table --- {
	// TEST ALL 
	t = table.new(position.bottom_center, 2, 1, bgcolor = color.rgb(245, 243, 149), border_color = color.black, border_width = 1, frame_color = color.black, frame_width = 1)
	table.cell(t,0,0, text_halign = text.align_left,width = i_cell1W, height = 100 , text_font_family = font.family_monospace)
	table.cell(t,1,0, text_halign = text.align_left,width = i_cell2W, height = 100 , text_font_family = font.family_monospace)

	// table.cell_set_text(t, 0, 0, txt.wrap(i_WrapTo, i_WrapPrefix, i_WrapPostfix))
	table.cell_set_text(t, 0, 0, txt)
	// table.cell_set_text(t, 0, 0, txt)
	table.cell_set_text(t, 1, 0, "")
	table.cell_set_text_size(t, 1, 0, size.small)

	//}
