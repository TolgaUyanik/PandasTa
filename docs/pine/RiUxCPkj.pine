//@version=6
indicator("Bitcoin Critical State Indicator (BCSI)", overlay=false)

//=====================================================
// INPUTS
//=====================================================

growthLookback   = input.int(365, "Growth Period")
accelLookback    = input.int(90, "Acceleration Period")
volLookback      = input.int(365, "Volatility Period")
entropyLookback  = input.int(180, "Entropy Window")
cycleLength      = input.int(1460, "Bitcoin Cycle (days)")

//=====================================================
// UTILITIES
//=====================================================

normalize(src, minVal, maxVal) =>
    x = (src - minVal) / (maxVal - minVal)
    math.max(0.0, math.min(100.0, x * 100.0))

//=====================================================
// 1. GROWTH SCORE
//=====================================================

growth = (close / close[growthLookback] - 1.0) * 100

growthScore = normalize(growth, -50, 500)

//=====================================================
// 2. ACCELERATION SCORE
//=====================================================

acceleration = growth - growth[accelLookback]

accelScore = normalize(acceleration, -100, 200)

//=====================================================
// 3. BUBBLE PRESSURE
//=====================================================

trend = ta.linreg(math.log(close), 500, 0)

bubblePressure = math.log(close) - trend

pressureScore =
     normalize(
         bubblePressure,
         -1.0,
         1.0)

//=====================================================
// 4. VOLATILITY COMPRESSION
//=====================================================

atrNow = ta.atr(100)
atrPast = ta.sma(ta.atr(100), volLookback)

compression = atrPast / atrNow

compressionScore =
     normalize(
         compression,
         0.5,
         3.0)

//=====================================================
// 5. CYCLE SCORE
//=====================================================

genesis = timestamp(2009, 1, 3)

DAY_MS = 86400000

daysSinceGenesis =
     (time - genesis) / DAY_MS

cyclePos =
     daysSinceGenesis % cycleLength

cycleScore =
     normalize(
         cyclePos,
         0,
         cycleLength)

//=====================================================
// 6. ENTROPY APPROXIMATION
//=====================================================

// Approximation:
// Lower volatility in returns -> lower entropy

ret = math.log(close / close[1])

retStd =
     ta.stdev(
         ret,
         entropyLookback)

entropyScore =
     100 -
     normalize(
         retStd,
         0.01,
         0.15)

//=====================================================
// 7. FRACTAL STRESS
//=====================================================

hurstApprox =
     ta.correlation(
         close,
         close[50],
         200)

stressScore =
     normalize(
         hurstApprox,
         -1,
         1)

//=====================================================
// FINAL SCORE
//=====================================================

BCSI =
     0.20 * growthScore +
     0.15 * accelScore +
     0.20 * pressureScore +
     0.10 * compressionScore +
     0.10 * cycleScore +
     0.10 * entropyScore +
     0.15 * stressScore

//=====================================================
// REGIME DETECTOR
//=====================================================

string regime = "NEUTRAL"

if BCSI < 20
    regime := "CAPITULATION"
else if BCSI < 40
    regime := "ACCUMULATION"
else if BCSI < 60
    regime := "EXPANSION"
else if BCSI < 80
    regime := "BUBBLE"
else
    regime := "CRITICAL"

//=====================================================
// PLOTS
//=====================================================

plot(BCSI, "BCSI", color=color.white, linewidth=3)

hline(20, color=color.green)
hline(40, color=color.blue)
hline(60, color=color.yellow)
hline(80, color=color.red)

//=====================================================
// BACKGROUND
//=====================================================

bgcolor(
     BCSI < 20 ? color.new(color.green, 85) :
     BCSI < 40 ? color.new(color.blue, 85) :
     BCSI < 60 ? color.new(color.yellow, 85) :
     BCSI < 80 ? color.new(color.orange, 85) :
                 color.new(color.red, 85))

//=====================================================
// TABLE
//=====================================================

var table t =
     table.new(
         position.top_right,
         2,
         9)

if barstate.islast

    table.cell(t,0,0,"BCSI")
    table.cell(t,1,0,str.tostring(BCSI,"#.1"))

    table.cell(t,0,1,"Growth")
    table.cell(t,1,1,str.tostring(growthScore,"#.0"))

    table.cell(t,0,2,"Acceleration")
    table.cell(t,1,2,str.tostring(accelScore,"#.0"))

    table.cell(t,0,3,"Pressure")
    table.cell(t,1,3,str.tostring(pressureScore,"#.0"))

    table.cell(t,0,4,"Compression")
    table.cell(t,1,4,str.tostring(compressionScore,"#.0"))

    table.cell(t,0,5,"Cycle")
    table.cell(t,1,5,str.tostring(cycleScore,"#.0"))

    table.cell(t,0,6,"Entropy")
    table.cell(t,1,6,str.tostring(entropyScore,"#.0"))

    table.cell(t,0,7,"Stress")
    table.cell(t,1,7,str.tostring(stressScore,"#.0"))

    table.cell(t,0,8,"State")
    table.cell(t,1,8,regime)