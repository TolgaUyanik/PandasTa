//@version=6
indicator("BB with Heikin Ashi + Reversal Check", overlay=true,scale = scale.none)

//=== Inputs ===
main     = input.symbol("BINANCE:BTCUSDT.P", "Main Symbol")
maintf   = input.timeframe("15", "Timeframe")
length   = input.int(20, "BB Length", minval=1)
maType   = input.string("SMA", "Basis MA Type", options=["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"])
mult     = input.float(2.0, minval=0.001, maxval=50, title="StdDev")
offset   = input.int(0, "Offset", minval=-500, maxval=500)

//=== Function: Moving Average ===
ma(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

//=== Get Heikin Ashi data from security ===
haTicker = ticker.heikinashi(main)
[haOpen, haHigh, haLow, haClose] = request.security(haTicker, maintf, [open, high, low, close])

//=== Calculate BB inside the same timeframe (security BB) ===
[basis, upper, lower] = request.security(haTicker, maintf, [ma(close, length, maType), ma(close, length, maType) + mult * ta.stdev(close, length), ma(close, length, maType) - mult * ta.stdev(close, length)])


//=== Plot Heikin Ashi Candle ===
candleColor = haClose >= haOpen ? color.new(color.green, 0) : color.new(color.red, 0)
plotcandle(haOpen, haHigh, haLow, haClose, color=candleColor, title="Heikin Ashi Candle")

//=== Plot BB ===
plot(basis, "Basis", color=color.blue, offset=offset)
p1 = plot(upper, "Upper", color=color.red, offset=offset)
p2 = plot(lower, "Lower", color=color.green, offset=offset)
fill(p1, p2, title="Background", color=color.rgb(33, 150, 243, 90))

//=== Track if price has passed under p2 or above p1 recently ===
var bool wasBelowP2 = false
var bool wasAboveP1 = false

// === Update status with swap logic ===
if haLow < lower
    wasBelowP2 := true
    wasAboveP1 := false
else if haHigh > upper
    wasAboveP1 := true
    wasBelowP2 := false



bgcolor(wasAboveP1?color.rgb(255, 82, 82, 90):wasBelowP2?color.rgb(76, 175, 79, 90):color.rgb(76, 175, 79, 100))

//=== Long Condition: Pass under p2 then reverse up ===
bbLowerUp   = lower > lower[1]
candleUp    = ta.rising(haClose,1) and haClose>haHigh[1]
longSignal  = wasBelowP2 and candleUp and haClose > lower
// longSignal  = wasBelowP2 and bbLowerUp and candleUp and haClose > lower

//=== Short Condition: Pass over p1 then reverse down ===
bbUpperDown = upper < upper[1]
candleDown  = ta.falling(haClose,1) and haClose<haLow[1]
shortSignal = wasAboveP1 and candleDown and haClose < upper
// shortSignal = wasAboveP1 and bbUpperDown and candleDown and haClose < upper

//=== Plot Signals ===
plotshape(longSignal, title="Long Signal", style=shape.labelup, location=location.belowbar,
     color=color.new(color.green, 0), size=size.tiny, text="▲",force_overlay=true)
plotshape(shortSignal, title="Short Signal", style=shape.labeldown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.tiny, text="▼",force_overlay=true)

//=== Alerts ===
alertcondition(longSignal, title="BB Reversal Up", message="Price reversed up after passing below BB Lower!")
alertcondition(shortSignal, title="BB Reversal Down", message="Price reversed down after passing above BB Upper!")
