//@version=6
indicator("Hourly Minute Lines", overlay=true, max_lines_count=500, max_labels_count=500)

//#region inputs
showLine1 = input.bool(true, "Line 1")
minute1 = input.int(9, "Line 1 Minute", minval=0, maxval=59)
color1 = input.color(color.yellow, "Line 1 Color")
width1 = input.int(2, "Line 1 Width", minval=1, maxval=5)
style1 = input.string("Solid", "Line 1 Style", options=["Solid", "Dashed", "Dotted"])

showLine2 = input.bool(true, "Line 2")
minute2 = input.int(30, "Line 2 Minute", minval=0, maxval=59)
color2 = input.color(color.orange, "Line 2 Color")
width2 = input.int(3, "Line 2 Width", minval=1, maxval=5)
style2 = input.string("Solid", "Line 2 Style", options=["Solid", "Dashed", "Dotted"])

showLine3 = input.bool(false, "Line 3")
minute3 = input.int(45, "Line 3 Minute", minval=0, maxval=59)
color3 = input.color(color.white, "Line 3 Color")
width3 = input.int(2, "Line 3 Width", minval=1, maxval=5)
style3 = input.string("Solid", "Line 3 Style", options=["Solid", "Dashed", "Dotted"])

showHourMark = input.bool(true, "showHourMark", group="Hour Mark")
hourColor = input.color(color.blue, "hourColor", group="Hour Mark")
hourWidth = input.int(2, "hourWidth", minval=1, maxval=5, group="Hour Mark")
hourStyle = input.string("Solid", "hourStyle", options=["Solid", "Dashed", "Dotted"], group="Hour Mark")



showBosChoch = input.bool(true, "Enable BOS/CHOCH Detection")
swingLookback = input.int(5, "Swing Lookback", minval=3, maxval=20)
bullLabelColor = input.color(color.green, "Bullish B Label Color")
bearLabelColor = input.color(color.red, "Bearish B Label Color")
labelSizeInput = input.string("large", "B Label Size", options=["small", "normal", "large", "huge"])

var bool cycleStarted = false
var bool bFiredThisCycle = false
//#endregion

//#region helpers
getLineStyle(string style) =>
    switch style
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

getLabelSize(string sizeName) =>
    switch sizeName
        "small" => size.small
        "normal" => size.normal
        "huge" => size.huge
        => size.large

shouldDrawLine(int targetMinute) =>
    minute(time) == targetMinute

isTriggerMinute = (showLine1 and minute(time) == minute1) or (showLine2 and minute(time) == minute2) or (showLine3 and minute(time) == minute3)

getStructure(float lastSwingHigh1, float lastSwingHigh2, float lastSwingLow1, float lastSwingLow2) =>
    bool isUpTrend = not na(lastSwingHigh1) and not na(lastSwingHigh2) and not na(lastSwingLow1) and not na(lastSwingLow2) and (lastSwingHigh1 > lastSwingHigh2 and lastSwingLow1 > lastSwingLow2)
    bool isDownTrend = not na(lastSwingHigh1) and not na(lastSwingHigh2) and not na(lastSwingLow1) and not na(lastSwingLow2) and (lastSwingHigh1 < lastSwingHigh2 and lastSwingLow1 < lastSwingLow2)
    [isUpTrend, isDownTrend]
//#endregion

//#region line storage
var array<line> drawnLines = array.new<line>()
cleanupBars = 300
//#endregion

//#region swing tracking
pivotHigh = ta.pivothigh(high, swingLookback, swingLookback)
pivotLow = ta.pivotlow(low, swingLookback, swingLookback)

var array<float> swingHighs = array.new<float>()
var array<int> swingHighBars = array.new<int>()
var array<float> swingLows = array.new<float>()
var array<int> swingLowBars = array.new<int>()

if not na(pivotHigh)
    swingHighs.push(pivotHigh)
    swingHighBars.push(bar_index - swingLookback)
    if swingHighs.size() > 5
        swingHighs.shift()
        swingHighBars.shift()

if not na(pivotLow)
    swingLows.push(pivotLow)
    swingLowBars.push(bar_index - swingLookback)
    if swingLows.size() > 5
        swingLows.shift()
        swingLowBars.shift()
//#endregion

//#region Vertical Lines
drawLine(int minuteValue, color clr, int w, string style) =>
    if shouldDrawLine(minuteValue)
        line.new(bar_index, low - 5, bar_index, high + 5, color=clr, width=w, style=getLineStyle(style))

if showLine1
    drawLine(minute1, color1, width1, style1)
if showLine2
    drawLine(minute2, color2, width2, style2)
if showLine3
    drawLine(minute3, color3, width3, style3)

if isTriggerMinute
    cycleStarted := true
    bFiredThisCycle := false
//#endregion

//#region Hour Mark
bool onHighTF = not timeframe.isintraday
bool newHour = onHighTF ? bar_index != bar_index[1] : hour != hour[1]
if showHourMark and newHour
    line.new(bar_index, low - 5, bar_index, high + 5, color=hourColor, width=hourWidth, style=getLineStyle(hourStyle))
//#endregion



//#region BOS/CHOCH Detection
//@function Detects BOS/CHOCH conditions from stored swing highs and lows.
//@returns A tuple of [bullishSignal, bearishSignal].
f_detectBosChoch() =>
    int shSize = swingHighs.size()
    int slSize = swingLows.size()
    if shSize < 5 or slSize < 5
        [false, false]
    else
        float sh1 = swingHighs.get(shSize - 1)
        float sh2 = swingHighs.get(shSize - 2)
        float sl1 = swingLows.get(slSize - 1)
        float sl2 = swingLows.get(slSize - 2)

        [isUpTrend, isDownTrend] = getStructure(sh1, sh2, sl1, sl2)

        float psh1 = swingHighs.get(shSize - 4)
        float psh2 = swingHighs.get(shSize - 3)
        float psl1 = swingLows.get(slSize - 4)
        float psl2 = swingLows.get(slSize - 3)

        [wasUpTrend, wasDownTrend] = getStructure(psh1, psh2, psl1, psl2)

        [isUpTrend and wasDownTrend, isDownTrend and wasUpTrend]
//#endregion

//#region BOS/CHOCH Labels
if showBosChoch and barstate.isconfirmed and cycleStarted and not bFiredThisCycle
    [showBull, showBear] = f_detectBosChoch()
    if showBull
        label.new(bar_index, low, "B", color=bullLabelColor, style=label.style_label_up, textcolor=color.white, size=getLabelSize(labelSizeInput))
        bFiredThisCycle := true
    if showBear
        label.new(bar_index, high, "B", color=bearLabelColor, style=label.style_label_down, textcolor=color.white, size=getLabelSize(labelSizeInput))
        bFiredThisCycle := true
//#endregion

//#region cleanup
if barstate.islast
    if drawnLines.size() > 0
        for i = drawnLines.size() - 1 to 0 by 1
            l = drawnLines.get(i)
            if bar_index - line.get_x1(l) > cleanupBars
                line.delete(l)
                drawnLines.remove(i)
//#endregion