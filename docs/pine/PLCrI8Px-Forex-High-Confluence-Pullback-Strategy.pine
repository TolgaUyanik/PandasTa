//@version=6
strategy("Forex High-Confluence Pullback Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.00002)

// ==========================================
// INPUTS & PARAMETERS
// ==========================================

// 1. Trend & Strength Filters
emaLength   = input.int(200, title="200 Macro EMA Length", group="Trend Filters")
adxLength   = input.int(14, title="ADX Length", group="Trend Filters")
adxThresh   = input.int(25, title="ADX Threshold (Strong Trend)", group="Trend Filters")

// 2. Stochastic RSI Parameters
smoothK     = input.int(3, title="Stoch RSI Smooth K", group="Stochastic RSI Pullback")
smoothD     = input.int(3, title="Stoch RSI Smooth D", group="Stochastic RSI Pullback")
lengthRSI   = input.int(14, title="RSI Length", group="Stochastic RSI Pullback")
lengthStoch = input.int(14, title="Stochastic Length", group="Stochastic RSI Pullback")
osLevel     = input.int(20, title="Oversold Level (Long)", group="Stochastic RSI Pullback")
obLevel     = input.int(80, title="Overbought Level (Short)", group="Stochastic RSI Pullback")

// 3. Risk Management (ATR Based)
atrLength   = input.int(14, title="ATR Length", group="Risk Management")
atrMult     = input.float(1.5, title="ATR Multiplier for SL/TP", group="Risk Management")

// 4. Session Filter (London & NY Sessions Combined)
sessionInput = input.session("0700-2100:23456", title="Allowed Trading Session (UTC/Broker Time)", group="Session Filter")

// ==========================================
// INDICATOR CALCULATION
// ==========================================

// 200 EMA
ema200 = ta.ema(close, emaLength)
plot(ema200, color=color.new(color.blue, 30), title="200 EMA", linewidth=2)

// ADX Calculation
[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)

// Stochastic RSI Calculation
rsiVal = ta.rsi(close, lengthRSI)
stochRSI = ta.stoch(rsiVal, rsiVal, rsiVal, lengthStoch)
k = ta.sma(stochRSI, smoothK)
d = ta.sma(k, smoothD) // Fixed: changed 'd' to 'smoothD'

// ATR for Volatility-Based Stops
atr = ta.atr(atrLength)

// ==========================================
// TRADING CONDITIONS
// ==========================================

// Session Check
inSession = not na(time(timeframe.period, sessionInput))

// Trend & Strength Filters
macroBullish = close > ema200
macroBearish = close < ema200
trendStrong  = adx > adxThresh

// Pullback Triggers (Stochastic RSI Crosses)
longPullback  = ta.crossover(k, osLevel) or (k < osLevel and ta.crossover(k, d))
shortPullback = ta.crossunder(k, obLevel) or (k > obLevel and ta.crossunder(k, d))

// Combined Entry Signals
longCondition  = macroBullish and trendStrong and longPullback and inSession and strategy.position_size == 0
shortCondition = macroBearish and trendStrong and shortPullback and inSession and strategy.position_size == 0

// ==========================================
// CLEAN VISUAL SIGNALS (NOISLESS)
// ==========================================
// Small, clean entry shapes directly above/below the triggering candles
plotshape(longCondition, title="Clean Buy Arrow", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(shortCondition, title="Clean Sell Arrow", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// ==========================================
// TRADE EXECUTION & RISK MANAGEMENT
// ==========================================

var float entrySL = na
var float entryTP = na

if (longCondition)
    entrySL := close - (atr * atrMult)
    entryTP := close + (atr * atrMult)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    entrySL := close + (atr * atrMult)
    entryTP := close - (atr * atrMult)
    strategy.entry("Short", strategy.short)

if (strategy.position_size > 0)
    strategy.exit("Exit Long", "Long", stop=entrySL, limit=entryTP)

if (strategy.position_size < 0)
    strategy.exit("Exit Short", "Short", stop=entrySL, limit=entryTP)

if (strategy.position_size == 0)
    entrySL := na
    entryTP := na

plot(entrySL, style=plot.style_linebr, color=color.new(color.red, 50), title="Active Stop Loss", linewidth=1)
plot(entryTP, style=plot.style_linebr, color=color.new(color.green, 50), title="Active Take Profit", linewidth=1)