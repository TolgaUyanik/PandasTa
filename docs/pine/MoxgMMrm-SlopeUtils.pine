//@version=6
// Name the library. This is what you will use to import it later.
library('SlopeUtils', overlay = false)

// @function Calculates a normalized slope based on price change relative to ATR.
// @param src        (series float) The source input (e.g., close).
// @param atr_series (series float) The ATR value for normalization.
// @param length     (simple int)   The lookback period for the slope calculation.
// @returns          (float)        The normalized slope value.
export calcSlope(series float src, series float atr_series, simple int length) =>
    // Prevent division by zero if ATR or length is 0
    if atr_series == 0 or length == 0
        na
    else // The active logic from your snippet
        float normalizedSlope = (src - src[length]) / (atr_series * length)
        normalizedSlope


// @function Calculates a statistically sound slope using Linear Regression.
// @param src     (series float) The source input (e.g., close or SMA).
// @param length  (simple int)   The lookback period.
// @param use_atr (bool)         Whether to normalize the slope by ATR.
// @returns       (float)        The slope of the regression line.
export calcLinRegSlope(series float src, simple int length, float atr_val) =>

    // ta.linreg returns the price value on the line. 
    // The difference between the current value and the previous value on the line is the slope.
    float lrValue     = ta.linreg(src, length, 0)
    float lrPrevValue = ta.linreg(src, length, 1)
    float rawSlope    = lrValue - lrPrevValue
    
    // Normalize by ATR if requested to allow comparison between different assets
    float result = atr_val != 0 ? rawSlope / atr_val : rawSlope
    result