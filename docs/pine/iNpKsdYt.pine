//@version=5
indicator(title="Scout Regiment - MACD", shorttitle="SCTI-MACD")

// 输入选项
// 主要设置
source = input.source(close, title="来源", group="主要设置")
fastLength = input.int(13, minval=1, title="快速EMA周期", group="主要设置")
slowLength = input.int(34, minval=1, title="慢速EMA周期", group="主要设置")
signalLength = input.int(9, minval=1, title="信号线周期", group="主要设置")

// 多周期设置
useCurrentRes = input.bool(true, title="使用当前图表周期?", group="多周期设置")
resCustom = input.timeframe(title="使用不同周期? (取消勾选上方选项)", defval="60", group="多周期设置")

// 显示选项
smd = input.bool(true, title="显示MACD线和信号线?", group="显示选项")
sd = input.bool(true, title="在MACD穿越信号线时显示圆点?", group="显示选项")
sh = input.bool(true, title="显示直方图?", group="显示选项")
macd_colorChange = input.bool(true, title="MACD线颜色根据穿越而变化?", group="显示选项")
hist_colorChange = input.bool(true, title="直方图显示4种颜色?", group="显示选项")

// MACD 计算
res = useCurrentRes ? timeframe.period : resCustom
fastMA = ta.ema(source, fastLength)
slowMA = ta.ema(source, slowLength)
macd = fastMA - slowMA
signal = ta.sma(macd, signalLength)
hist = macd - signal
[outMacD, outSignal, outHist] = request.security(syminfo.tickerid, res, [macd, signal, hist])

// 颜色逻辑
histA_IsUp = outHist > outHist[1] and outHist > 0
histA_IsDown = outHist < outHist[1] and outHist > 0
histB_IsDown = outHist < outHist[1] and outHist <= 0
histB_IsUp = outHist > outHist[1] and outHist <= 0
macd_IsAbove = outMacD >= outSignal

plot_color = hist_colorChange ? histA_IsUp ? color.aqua : histA_IsDown ? color.blue : histB_IsDown ? color.red : histB_IsUp ? color.maroon : color.yellow : color.gray
macd_color = macd_colorChange ? (macd_IsAbove ? color.lime : color.red) : color.red
signal_color = macd_colorChange ? color.yellow : color.lime

// 绘图
plot(smd ? outMacD : na, title="MACD", color=macd_color, linewidth=2)
plot(smd ? outSignal : na, title="信号线", color=signal_color, style=plot.style_line, linewidth=2)
plot(sh ? outHist : na, title="直方图", color=plot_color, style=plot.style_columns, linewidth=4)
plot(sd and smd and ta.cross(outMacD, outSignal) ? outSignal : na, title="交叉点", style=plot.style_circles, linewidth=4, color=macd_color)
hline(0, '零线', linestyle=hline.style_solid, linewidth=2, color=color.new(color.white, 50))

// 背离设置 - 直方图背离
show_hist_div = input.bool(false,title="显示直方图背离信号", group="直方图背离设置")
hist_divsrc = input.string("影线", title="价格参考", options=["影线", "实体"], group="直方图背离设置")
hist_lbR = input.int(5, title="右侧回溯", minval=1, group="直方图背离设置")
hist_lbL = input.int(5, title="左侧回溯", minval=1, group="直方图背离设置")
hist_rangeUpper = input.int(60, title="最大回溯范围", minval=5, group="直方图背离设置")
hist_rangeLower = input.int(5, title="最小回溯范围", minval=1, group="直方图背离设置")
hist_plotBull = input.bool(true, title="显示常规看涨背离", group="直方图背离设置")
hist_plotHiddenBull = input.bool(false, title="显示隐藏看涨背离", group="直方图背离设置")
hist_plotBear = input.bool(true, title="显示常规看跌背离", group="直方图背离设置")
hist_plotHiddenBear = input.bool(false, title="显示隐藏看跌背离", group="直方图背离设置")

// 背离设置 - MACD线背离
show_macd_div = input.bool(false, title="显示MACD线背离信号", group="MACD线背离设置")
macd_divsrc = input.string("影线", title="价格参考", options=["影线", "实体"], group="MACD线背离设置")
macd_lbR = input.int(5, title="右侧回溯", minval=1, group="MACD线背离设置")
macd_lbL = input.int(5, title="左侧回溯", minval=1, group="MACD线背离设置")
macd_rangeUpper = input.int(60, title="最大回溯范围", minval=5, group="MACD线背离设置")
macd_rangeLower = input.int(5, title="最小回溯范围", minval=1, group="MACD线背离设置")
macd_plotBull = input.bool(true, title="显示常规看涨背离", group="MACD线背离设置")
macd_plotHiddenBull = input.bool(false, title="显示隐藏看涨背离", group="MACD线背离设置")
macd_plotBear = input.bool(true, title="显示常规看跌背离", group="MACD线背离设置")
macd_plotHiddenBear = input.bool(false, title="显示隐藏看跌背离", group="MACD线背离设置")

// 颜色定义
bullColor = color.new(#00ff00, 0)
bearColor = color.new(#FF00FF, 0)
hiddenBullColor = color.new(#8BDE7A, 0)
hiddenBearColor = color.new(#DEA7A6, 0)
textColor = color.new(#ffffff, 0)
noneColor = color.new(color.white, 100)

// 直方图背离逻辑
hist_osc = outHist
hist_plFound = na(ta.pivotlow(hist_osc, hist_lbL, hist_lbR)) ? false : true
hist_phFound = na(ta.pivothigh(hist_osc, hist_lbL, hist_lbR)) ? false : true

_inRange(cond, rangeLower, rangeUpper) =>
    bars = ta.barssince(cond == true)
    rangeLower <= bars and bars <= rangeUpper

hist_srch = hist_divsrc == "影线" ? high : math.max(close, open)
hist_srcl = hist_divsrc == "影线" ? low : math.min(close, open)

// 直方图常规看涨背离
hist_oscHL = hist_osc[hist_lbR] > ta.valuewhen(hist_plFound, hist_osc[hist_lbR], 1) and _inRange(hist_plFound[1], hist_rangeLower, hist_rangeUpper)
hist_priceLL = hist_srcl[hist_lbR] < ta.valuewhen(hist_plFound, hist_srcl[hist_lbR], 1)
hist_bullCond = hist_plotBull and hist_priceLL and hist_oscHL and hist_plFound and show_hist_div
plot(hist_plFound and show_hist_div ? hist_osc[hist_lbR] : na, offset=-hist_lbR, title="直方图常规看涨背离", linewidth=2, color=(hist_bullCond ? bullColor : noneColor))
plotshape(hist_bullCond ? hist_osc[hist_lbR] : na, offset=-hist_lbR, title="直方图常规看涨背离标签", text=" H涨 ", style=shape.labelup, location=location.absolute, color=color.new(#00ff00, 60), textcolor=textColor, size=size.small)

// 直方图隐藏看涨背离
hist_oscLL = hist_osc[hist_lbR] < ta.valuewhen(hist_plFound, hist_osc[hist_lbR], 1) and _inRange(hist_plFound[1], hist_rangeLower, hist_rangeUpper)
hist_priceHL = hist_srcl[hist_lbR] > ta.valuewhen(hist_plFound, hist_srcl[hist_lbR], 1)
hist_hiddenBullCond = hist_plotHiddenBull and hist_priceHL and hist_oscLL and hist_plFound and show_hist_div
plot(hist_plFound and show_hist_div ? hist_osc[hist_lbR] : na, offset=-hist_lbR, title="直方图隐藏看涨背离", linewidth=2, color=(hist_hiddenBullCond ? hiddenBullColor : noneColor))
plotshape(hist_hiddenBullCond ? hist_osc[hist_lbR] : na, offset=-hist_lbR, title="直方图隐藏看涨背离标签", text=" H隐藏看涨 ", style=shape.labelup, location=location.absolute, color=color.rgb(33, 150, 243, 20), textcolor=textColor, size=size.small)

// 直方图常规看跌背离
hist_oscLH = hist_osc[hist_lbR] < ta.valuewhen(hist_phFound, hist_osc[hist_lbR], 1) and _inRange(hist_phFound[1], hist_rangeLower, hist_rangeUpper)
hist_priceHH = hist_srch[hist_lbR] > ta.valuewhen(hist_phFound, hist_srch[hist_lbR], 1)
hist_bearCond = hist_plotBear and hist_priceHH and hist_oscLH and hist_phFound and show_hist_div
plot(hist_phFound and show_hist_div ? hist_osc[hist_lbR] : na, offset=-hist_lbR, title="直方图常规看跌背离", linewidth=2, color=(hist_bearCond ? bearColor : noneColor))
plotshape(hist_bearCond ? hist_osc[hist_lbR] : na, offset=-hist_lbR, title="直方图常规看跌背离标签", text=" H跌 ", style=shape.labeldown, location=location.absolute, color=color.new(#FF00FF, 60), textcolor=textColor, size=size.small)

// 直方图隐藏看跌背离
hist_oscHH = hist_osc[hist_lbR] > ta.valuewhen(hist_phFound, hist_osc[hist_lbR], 1) and _inRange(hist_phFound[1], hist_rangeLower, hist_rangeUpper)
hist_priceLH = hist_srch[hist_lbR] < ta.valuewhen(hist_phFound, hist_srch[hist_lbR], 1)
hist_hiddenBearCond = hist_plotHiddenBear and hist_priceLH and hist_oscHH and hist_phFound and show_hist_div
plot(hist_phFound and show_hist_div ? hist_osc[hist_lbR] : na, offset=-hist_lbR, title="直方图隐藏看跌背离", linewidth=2, color=(hist_hiddenBearCond ? hiddenBearColor : noneColor))
plotshape(hist_hiddenBearCond ? hist_osc[hist_lbR] : na, offset=-hist_lbR, title="直方图隐藏看跌背离标签", text=" H隐藏看跌 ", style=shape.labeldown, location=location.absolute, color=color.new(#DEA7A6, 20), textcolor=textColor, size=size.small)

// MACD线背离逻辑
macd_osc = outMacD
macd_plFound = na(ta.pivotlow(macd_osc, macd_lbL, macd_lbR)) ? false : true
macd_phFound = na(ta.pivothigh(macd_osc, macd_lbL, macd_lbR)) ? false : true

macd_srch = macd_divsrc == "影线" ? high : math.max(close, open)
macd_srcl = macd_divsrc == "影线" ? low : math.min(close, open)

// MACD线常规看涨背离
macd_oscHL = macd_osc[macd_lbR] > ta.valuewhen(macd_plFound, macd_osc[macd_lbR], 1) and _inRange(macd_plFound[1], macd_rangeLower, macd_rangeUpper)
macd_priceLL = macd_srcl[macd_lbR] < ta.valuewhen(macd_plFound, macd_srcl[macd_lbR], 1)
macd_bullCond = macd_plotBull and macd_priceLL and macd_oscHL and macd_plFound and show_macd_div
plot(macd_plFound and show_macd_div ? macd_osc[macd_lbR] : na, offset=-macd_lbR, title="MACD线常规看涨背离", linewidth=2, color=(macd_bullCond ? bullColor : noneColor))
plotshape(macd_bullCond ? macd_osc[macd_lbR] : na, offset=-macd_lbR, title="MACD线常规看涨背离标签", text=" M涨 ", style=shape.labelup, location=location.absolute, color=color.new(#00ff00, 60), textcolor=textColor, size=size.small)

// MACD线隐藏看涨背离
macd_oscLL = macd_osc[macd_lbR] < ta.valuewhen(macd_plFound, macd_osc[macd_lbR], 1) and _inRange(macd_plFound[1], macd_rangeLower, macd_rangeUpper)
macd_priceHL = macd_srcl[macd_lbR] > ta.valuewhen(macd_plFound, macd_srcl[macd_lbR], 1)
macd_hiddenBullCond = macd_plotHiddenBull and macd_priceHL and macd_oscLL and macd_plFound and show_macd_div
plot(macd_plFound and show_macd_div ? macd_osc[macd_lbR] : na, offset=-macd_lbR, title="MACD线隐藏看涨背离", linewidth=2, color=(macd_hiddenBullCond ? hiddenBullColor : noneColor))
plotshape(macd_hiddenBullCond ? macd_osc[macd_lbR] : na, offset=-macd_lbR, title="MACD线隐藏看涨背离标签", text=" M隐藏看涨 ", style=shape.labelup, location=location.absolute, color=color.rgb(33, 150, 243, 20), textcolor=textColor, size=size.small)

// MACD线常规看跌背离
macd_oscLH = macd_osc[macd_lbR] < ta.valuewhen(macd_phFound, macd_osc[macd_lbR], 1) and _inRange(macd_phFound[1], macd_rangeLower, macd_rangeUpper)
macd_priceHH = macd_srch[macd_lbR] > ta.valuewhen(macd_phFound, macd_srch[macd_lbR], 1)
macd_bearCond = macd_plotBear and macd_priceHH and macd_oscLH and macd_phFound and show_macd_div
plot(macd_phFound and show_macd_div ? macd_osc[macd_lbR] : na, offset=-macd_lbR, title="MACD线常规看跌背离", linewidth=2, color=(macd_bearCond ? bearColor : noneColor))
plotshape(macd_bearCond ? macd_osc[macd_lbR] : na, offset=-macd_lbR, title="MACD线常规看跌背离标签", text=" M跌 ", style=shape.labeldown, location=location.absolute, color=color.new(#FF00FF, 60), textcolor=textColor, size=size.small)

// MACD线隐藏看跌背离
macd_oscHH = macd_osc[macd_lbR] > ta.valuewhen(macd_phFound, macd_osc[macd_lbR], 1) and _inRange(macd_phFound[1], macd_rangeLower, macd_rangeUpper)
macd_priceLH = macd_srch[macd_lbR] < ta.valuewhen(macd_phFound, macd_srch[macd_lbR], 1)
macd_hiddenBearCond = macd_plotHiddenBear and macd_priceLH and macd_oscHH and macd_phFound and show_macd_div
plot(macd_phFound and show_macd_div ? macd_osc[macd_lbR] : na, offset=-macd_lbR, title="MACD线隐藏看跌背离", linewidth=2, color=(macd_hiddenBearCond ? hiddenBearColor : noneColor))
plotshape(macd_hiddenBearCond ? macd_osc[macd_lbR] : na, offset=-macd_lbR, title="MACD线隐藏看跌背离标签", text=" M隐藏看跌 ", style=shape.labeldown, location=location.absolute, color=color.new(#DEA7A6, 20), textcolor=textColor, size=size.small)