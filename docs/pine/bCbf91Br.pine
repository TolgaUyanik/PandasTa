//@version=6
indicator("Larry Williams's Market Structure", overlay=true, max_labels_count=500)

// ===== 기본 설정 =====
useDateFilter = input.bool(true, "Use Date Filter", group="Date Setting")
startDate = input.time(timestamp("2025-01-01"), "Start", confirm=false, group="Date Setting")
endDate = input.time(timestamp("2025-07-31"), "End", confirm=false, group="Date Setting")

isInDateRange = useDateFilter ? (time >= startDate and time <= endDate) : true

var int highBar = -1
var float highHigh = -1
var float highLow = -1

var int lowBar = -1
var float lowHigh = -1
var float lowLow = -1

type Pivot
    int Bar
    float Price
    int Grade
    label id = na

var highs = array.new<Pivot>()
var lows = array.new<Pivot>()
var highsCount = 0
var lowsCount = 0

set_pivot(arr, i, isHigh) =>
    current = array.get(arr, i)

    if current.Grade == 1
        current.Grade := 2
        if isHigh
            label.set_color(current.id, color.rgb(255, 128, 0, 25))
            label.set_style(current.id, label.style_text_outline)
            label.set_text(current.id, "2")
            //current.id := label.new(current.Bar, current.Price, text="2",color = color.rgb(255, 128, 0, 25),style=label.style_text_outline,size=size.tiny)
        else
            label.set_color(current.id, color.rgb(0, 128, 0, 25))
            label.set_style(current.id, label.style_text_outline)
            label.set_text(current.id, "2")
            //current.id := label.new(current.Bar, current.Price, text="2",color = color.rgb(0, 128, 0, 25),style=label.style_text_outline,size=size.tiny)

    else
        current.Grade := 3
        label.set_text(current.id, "3")
        if isHigh
            label.set_style(current.id, label.style_label_down)
        else    
            label.set_style(current.id, label.style_label_up)

    array.set(arr, i, current) 


if isInDateRange and not barstate.isrealtime
    isHighPoint = highBar == -1 and high[2] < high[1] and high[1] > high
    isLowPoint = lowBar == -1 and low[2] > low[1] and low[1] < low

    if isHighPoint
        highBar := bar_index[1]
        highHigh := high[1]
        highLow := low[1]

    if highBar != -1
        if highHigh < high
            highBar := -1
            highHigh := -1
            highLow := -1
        else 
            if low < highLow
                array.push(highs, Pivot.new(highBar, highHigh, 1, label.new(highBar, highHigh, text="1", style=label.style_none,size=size.tiny)))
                highsCount := array.size(highs)
                highBar := -1
                highHigh := -1
                highLow := -1
    
                if highsCount > 2
                    upgraded = false
                    for i = 1 to highsCount - 1
                                
                        current = array.get(highs, i)

                        if current.Grade != 1
                            continue
                    
                        currentBar = current.Bar
                        currentPrice = current.Price
                        currentGrade = current.Grade

                        loop = true
                        checkLeft = false
                        checkRight = false

                        // 왼쪽 검사
                        if i > 0
                            for j = 0 to i - 1
                                shift = i - 1 - j
                                left = array.get(highs, shift)
                                
                                // 왼쪽에 있는 라벨만 검사
                                if left.Bar < currentBar
                                    if left.Price > currentPrice or currentGrade < left.Grade
                                        loop := false
                                        break
                                    if left.Price < currentPrice
                                        checkLeft := true
                                        break

                        if loop and i < highsCount - 1
                            for j = i + 1 to highsCount - 1
                                right = array.get(highs, j)

                                // 오른쪽에 있는 라벨만 검사
                                if right.Bar > currentBar
                                    if right.Price > currentPrice or currentGrade < right.Grade
                                        loop := false
                                        break
                                    if right.Price < currentPrice
                                        checkRight := true
                                        break

                            // 모든 조건이 맞으면 업그레이드
                            if checkLeft and checkRight
                                set_pivot(highs, i, true)
                                upgraded := true

                    if upgraded
                        for i = 1 to highsCount - 1
                            
                            current = array.get(highs, i)

                            if current.Grade != 2
                                continue
                        
                            currentBar = current.Bar
                            currentPrice = current.Price

                            loop = true
                            checkLeft = false
                            checkRight = false

                            // 왼쪽 검사
                            if i > 0
                                for j = 0 to i - 1
                                    shift = i - 1 - j
                                    left = array.get(highs, shift)
                                
                                    // 왼쪽에 있는 라벨만 검사
                                    if left.Bar < currentBar
                                        if left.Price > currentPrice or left.Grade == 3
                                            loop := false
                                            break
                                        if left.Price < currentPrice and left.Grade == 2
                                            checkLeft := true
                                            break

                            if loop and i < highsCount - 1
                                for j = i + 1 to highsCount - 1
                                    right = array.get(highs, j)
                                    
                                    // 오른쪽에 있는 라벨만 검사
                                    if right.Bar > currentBar
                                        if right.Price > currentPrice or right.Grade == 3
                                            loop := false
                                            break
                                        if right.Price < currentPrice and right.Grade == 2
                                            checkRight := true
                                            break

                                // 모든 조건이 맞으면 3으로 업그레이드
                                if checkLeft and checkRight
                                    set_pivot(highs, i, true)


    if isLowPoint
        lowBar := bar_index[1]
        lowHigh := high[1]
        lowLow := low[1]

    if lowBar != -1
        if low < lowLow
            lowBar := -1
            lowHigh := -1
            lowLow := -1
        else 
            if lowHigh < high
                array.push(lows, Pivot.new(lowBar, lowLow, 1, label.new(lowBar, lowLow, text="1", style=label.style_none,size=size.tiny)))
                lowsCount := array.size(lows)
                lowBar := -1
                lowHigh := -1
                lowLow := -1

                if lowsCount > 2
                    upgraded = false
                    for i = 1 to lowsCount - 1
                                
                        current = array.get(lows, i)

                        if current.Grade != 1
                            continue
                    
                        currentBar = current.Bar
                        currentPrice = current.Price
                        currentGrade = current.Grade

                        loop = true
                        checkLeft = false
                        checkRight = false

                        for j = 0 to i - 1
                            shift = i - 1 - j
                            left = array.get(lows, shift)

                            // 왼쪽에 있는 라벨만 검사
                            if left.Bar < currentBar
                                if left.Price < currentPrice or current.Grade < left.Grade
                                    loop := false
                                    break
                                if left.Price > currentPrice
                                    checkLeft := true
                                    break

                        if loop and i < lowsCount - 1
                            for j = i + 1 to lowsCount - 1
                                right = array.get(lows, j)
                                
                                // 오른쪽에 있는 라벨만 검사
                                if right.Bar > currentBar
                                    if right.Price < currentPrice or current.Grade < right.Grade
                                        loop := false
                                        break
                                    if right.Price > currentPrice
                                        checkRight := true
                                        break

                            // 모든 조건이 맞으면 업그레이드
                            if checkLeft and checkRight
                                set_pivot(lows, i, false)
                                upgraded := true

                    if upgraded
                        for i = 1 to lowsCount - 1
                            
                            current = array.get(lows, i)

                            if current.Grade != 2
                                continue
                        
                            currentBar = current.Bar
                            currentPrice = current.Price

                            loop = true
                            checkLeft = false
                            checkRight = false

                            // 왼쪽 검사
                            for j = 0 to i - 1
                                shift = i - 1 - j
                                left = array.get(lows, shift)
                            
                                // 왼쪽에 있는 라벨만 검사
                                if left.Bar < currentBar
                                    if left.Price < currentPrice
                                        loop := false
                                        break
                                    if left.Price > currentPrice and left.Grade == 2
                                        checkLeft := true
                                        break

                            if loop and i < lowsCount - 1
                                for j = i + 1 to lowsCount - 1
                                    right = array.get(lows, j)
                                
                                    // 오른쪽에 있는 라벨만 검사
                                    if right.Bar > currentBar
                                        if right.Price < currentPrice
                                            loop := false
                                            break
                                        if right.Price > currentPrice and right.Grade == 2
                                            checkRight := true
                                            break

                                // 모든 조건이 맞으면 3으로 업그레이드
                                if checkLeft and checkRight
                                    set_pivot(lows, i, false)

    if highsCount > 2
        for i = 0 to highsCount - 1
            current = array.get(highs, i)

            if current.Grade == 2 and na(current.id)
                current.id := label.new(current.Bar, current.Price, text="2",color = color.rgb(255, 128, 0, 25),style=label.style_text_outline,size=size.tiny)
            else if current.Grade == 3 and na(current.id)
                current.id := label.new(current.Bar, current.Price, text="3",color = color.rgb(255, 128, 0, 35),style=label.style_label_down,size=size.tiny)
            array.set(highs, i, current)

    if lowsCount > 2
        for i = 0 to lowsCount - 1
            current = array.get(lows, i)

            if current.Grade == 2 and na(current.id)
                current.id := label.new(current.Bar, current.Price, text="2",color = color.rgb(0, 128, 0, 25),style=label.style_text_outline,size=size.tiny)
            else if current.Grade == 3 and na(current.id)
                current.id := label.new(current.Bar, current.Price, text="3",color = color.rgb(0, 128, 0, 35),style=label.style_label_up,size=size.tiny)
            array.set(lows, i, current)


