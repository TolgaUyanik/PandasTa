//@version=6
indicator("AmberWaves EMA Pack", shorttitle="AW EMA Pack", overlay=true)

group_ema9   = "EMA 9"
group_ema10  = "EMA 10"
group_ema20  = "EMA 20"
group_ema48  = "EMA 48"
group_ema50  = "EMA 50"
group_ema200 = "EMA 200"
group_sma200 = "SMA 200"

showEma9   = input.bool(true, "Show EMA 9", group=group_ema9)
showEma10  = input.bool(true, "Show EMA 10", group=group_ema10)
showEma20  = input.bool(true, "Show EMA 20", group=group_ema20)
showEma48  = input.bool(true, "Show EMA 48", group=group_ema48)
showEma50  = input.bool(true, "Show EMA 50", group=group_ema50)
showEma200 = input.bool(true, "Show EMA 200", group=group_ema200)
showSma200 = input.bool(true, "Show SMA 200", group=group_sma200)

colorEma9   = input.color(color.aqua,   "Color", group=group_ema9)
colorEma10  = input.color(color.blue,   "Color", group=group_ema10)
colorEma20  = input.color(color.green,  "Color", group=group_ema20)
colorEma48  = input.color(color.orange, "Color", group=group_ema48)
colorEma50  = input.color(color.yellow, "Color", group=group_ema50)
colorEma200 = input.color(color.red,    "Color", group=group_ema200)
colorSma200 = input.color(color.white,  "Color", group=group_sma200)

widthEma9   = input.int(1, "Width", minval=1, maxval=5, group=group_ema9)
widthEma10  = input.int(1, "Width", minval=1, maxval=5, group=group_ema10)
widthEma20  = input.int(1, "Width", minval=1, maxval=5, group=group_ema20)
widthEma48  = input.int(1, "Width", minval=1, maxval=5, group=group_ema48)
widthEma50  = input.int(1, "Width", minval=1, maxval=5, group=group_ema50)
widthEma200 = input.int(1, "Width", minval=1, maxval=5, group=group_ema200)
widthSma200 = input.int(1, "Width", minval=1, maxval=5, group=group_sma200)

ema9   = ta.ema(close, 9)
ema10  = ta.ema(close, 10)
ema20  = ta.ema(close, 20)
ema48  = ta.ema(close, 48)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
sma200 = ta.sma(close, 200)

plot(showEma9   ? ema9   : na, title="EMA 9",   color=colorEma9,   linewidth=widthEma9)
plot(showEma10  ? ema10  : na, title="EMA 10",  color=colorEma10,  linewidth=widthEma10)
plot(showEma20  ? ema20  : na, title="EMA 20",  color=colorEma20,  linewidth=widthEma20)
plot(showEma48  ? ema48  : na, title="EMA 48",  color=colorEma48,  linewidth=widthEma48)
plot(showEma50  ? ema50  : na, title="EMA 50",  color=colorEma50,  linewidth=widthEma50)
plot(showEma200 ? ema200 : na, title="EMA 200", color=colorEma200, linewidth=widthEma200)
plot(showSma200 ? sma200 : na, title="SMA 200", color=colorSma200, linewidth=widthSma200)
