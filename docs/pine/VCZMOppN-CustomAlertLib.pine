//@version=5
// @description Custom alert formatting library
library("CustomAlertLib", overlay=true)

// @function Formats and triggers custom alerts with placeholders
// @param format String containing the alert format template
// @param message String containing the alert message
// @param freq (optional) Alert frequency as string, defaults to "once_per_bar_close"
// @returns void
export customAlert(string format, string message, simple string freq = "once_per_bar_close") =>
    formattedMessage = if str.contains(format, "{default}")
        str.replace_all(format, "{default}", message)
    else
        format
    
    formattedMessage := str.replace_all(formattedMessage, "{ticker}", syminfo.ticker)
    formattedMessage := str.replace_all(formattedMessage, "{close}", str.tostring(close))
    formattedMessage := str.replace_all(formattedMessage, "{interval}", timeframe.period)  // Added interval placeholder
    
    if freq == "once_per_bar"
        alert(formattedMessage, alert.freq_once_per_bar)
    else if freq == "once_per_bar_close"
        alert(formattedMessage, alert.freq_once_per_bar_close)
    else if freq == "all"
        alert(formattedMessage, alert.freq_all)
    else
        alert(formattedMessage, alert.freq_once_per_bar_close)  // default case
