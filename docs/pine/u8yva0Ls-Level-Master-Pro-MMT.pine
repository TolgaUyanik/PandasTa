//@version=6
indicator("Level Master Pro+ [MMT]", overlay=true, max_lines_count=500, max_labels_count=500)

// Input settings
maxHistoricalPivotsInput = input.int(title="Number of Pivots Back", defval=1, minval=1, maxval=200, display=display.none)
pivotTimeframe = input.timeframe("1D", "Pivot Timeframe", display = display.none)
showLabelsInput = input.bool(title="Show Labels", defval=true, group="Labels", display=display.none)
showPricesInput = input.bool(title="Show Prices", defval=true, group="Labels", display=display.none)
positionLabelsInput = input.string("Right", "Labels Position", options=["Left", "Right"], group="Labels", display=display.none)

// Enhanced Line Styling Options
extendToBarInput = input.bool(title="Extend to Current Bar", defval=false, group="Line Style", display=display.none)
linewidthInput = input.int(title="Line Width", defval=1, minval=1, maxval=10, group="Line Style", display=display.none)
lineStyleInput = input.string(title="Line Style", defval="Solid", options=["Solid", "Dashed", "Dotted"], group="Line Style", display=display.none)
lineTransparencyInput = input.int(title="Line Transparency", defval=0, minval=0, maxval=100, group="Line Style", display=display.none)

// Label Styling Options
labelSizeInput = input.string(title="Label Size", defval="Normal", options=["Tiny", "Small", "Normal", "Large", "Huge"], group="Label Style", display=display.none)
labelTransparencyInput = input.int(title="Label Background Transparency", defval=100, minval=0, maxval=100, group="Label Style", display=display.none)

DEFAULT_COLOR_BULL = color.green
DEFAULT_COLOR_BEAR = color.red
DEFAULT_COLOR_PIVOT = color.yellow
DEFAULT_COLOR_BC_TC = color.purple
pColorInput = input.color(DEFAULT_COLOR_PIVOT, "P‏", inline="P", group="Levels", display=display.none)
pShowInput = input.bool(true, "", inline="P", group="Levels", display=display.none)
prevCloseColorInput = input.color(color.teal, "PC", inline="P", group="Levels", display=display.none)
prevCloseShowInput = input.bool(true, "", inline="P", group="Levels", display=display.none)
s1ColorInput = input.color(DEFAULT_COLOR_BULL, "S1", inline="S1/R1", group="Levels", display=display.none)
s1ShowInput = input.bool(true, "", inline="S1/R1", group="Levels", display=display.none)
r1ColorInput = input.color(DEFAULT_COLOR_BEAR, "R1", inline="S1/R1", group="Levels", display=display.none)
r1ShowInput = input.bool(true, "", inline="S1/R1", group="Levels", display=display.none)
s2ColorInput = input.color(DEFAULT_COLOR_BULL, "S2", inline="S2/R2", group="Levels", display=display.none)
s2ShowInput = input.bool(true, "", inline="S2/R2", group="Levels", display=display.none)
r2ColorInput = input.color(DEFAULT_COLOR_BEAR, "R2", inline="S2/R2", group="Levels", display=display.none)
r2ShowInput = input.bool(true, "", inline="S2/R2", group="Levels", display=display.none)
s3ColorInput = input.color(DEFAULT_COLOR_BULL, "S3", inline="S3/R3", group="Levels", display=display.none)
s3ShowInput = input.bool(true, "", inline="S3/R3", group="Levels", display=display.none)
r3ColorInput = input.color(DEFAULT_COLOR_BEAR, "R3", inline="S3/R3", group="Levels", display=display.none)
r3ShowInput = input.bool(true, "", inline="S3/R3", group="Levels", display=display.none)
s4ColorInput = input.color(DEFAULT_COLOR_BULL, "S4", inline="S4/R4", group="Levels", display=display.none)
s4ShowInput = input.bool(true, "", inline="S4/R4", group="Levels", display=display.none)
r4ColorInput = input.color(DEFAULT_COLOR_BEAR, "R4", inline="S4/R4", group="Levels", display=display.none)
r4ShowInput = input.bool(true, "", inline="S4/R4", group="Levels", display=display.none)
s5ColorInput = input.color(DEFAULT_COLOR_BULL, "S5", inline="S5/R5", group="Levels", display=display.none)
s5ShowInput = input.bool(true, "", inline="S5/R5", group="Levels", display=display.none)
r5ColorInput = input.color(DEFAULT_COLOR_BEAR, "R5", inline="S5/R5", group="Levels", display=display.none)
r5ShowInput = input.bool(true, "", inline="S5/R5", group="Levels", display=display.none)
s6ColorInput = input.color(DEFAULT_COLOR_BULL, "S6", inline="S6/R6", group="Levels", display=display.none)
s6ShowInput = input.bool(true, "", inline="S6/R6", group="Levels", display=display.none)
r6ColorInput = input.color(DEFAULT_COLOR_BEAR, "R6", inline="S6/R6", group="Levels", display=display.none)
r6ShowInput = input.bool(true, "", inline="S6/R6", group="Levels", display=display.none)
bcColorInput = input.color(DEFAULT_COLOR_BC_TC, "BC", inline="BC/TC", group="Levels", display=display.none)
bcShowInput = input.bool(true, "", inline="BC/TC", group="Levels", display=display.none)
tcColorInput = input.color(DEFAULT_COLOR_BC_TC, "TC", inline="BC/TC", group="Levels", display=display.none)
tcShowInput = input.bool(true, "", inline="BC/TC", group="Levels", display=display.none)


type graphicSettings
    string levelName
    color levelColor
    bool showLevel

var graphicSettingsArray = array.from(graphicSettings.new("Pivot", pColorInput, pShowInput), graphicSettings.new("R1", r1ColorInput, r1ShowInput), graphicSettings.new("S1", s1ColorInput, s1ShowInput), graphicSettings.new("R2", r2ColorInput, r2ShowInput), graphicSettings.new("S2", s2ColorInput, s2ShowInput), graphicSettings.new("R3", r3ColorInput, r3ShowInput), graphicSettings.new("S3", s3ColorInput, s3ShowInput), graphicSettings.new("R4", r4ColorInput, r4ShowInput), graphicSettings.new("S4", s4ColorInput, s4ShowInput), graphicSettings.new("R5", r5ColorInput, r5ShowInput), graphicSettings.new("S5", s5ColorInput, s5ShowInput), graphicSettings.new("R6", r6ColorInput, r6ShowInput), graphicSettings.new("S6", s6ColorInput, s6ShowInput), graphicSettings.new("PC", prevCloseColorInput, prevCloseShowInput), graphicSettings.new("BC", bcColorInput, bcShowInput), graphicSettings.new("TC", tcColorInput, tcShowInput))

type pivotGraphic
    line pivotLine
    label pivotLabel

method delete(pivotGraphic graphic) =>
    graphic.pivotLine.delete()
    graphic.pivotLabel.delete()

pivotTimeframeChangeCounter(condition) =>
    var count = 0
    if condition and bar_index > 0
        count += 1
    count


// Convert string inputs to Pine Script constants
getLineStyle() =>
    switch lineStyleInput
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

getLabelSize() =>
    switch labelSizeInput
        "Tiny" => size.tiny
        "Small" => size.small
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

var drawnGraphics = matrix.new<pivotGraphic>()

[securityPivots, securityPivotCounter, prevClose, highPrev, lowPrev] = request.security(syminfo.tickerid, pivotTimeframe, [ta.pivot_point_levels("Traditional", timeframe.change(pivotTimeframe)), pivotTimeframeChangeCounter(timeframe.change(pivotTimeframe)), close[1], high[1], low[1]], lookahead=barmerge.lookahead_on)

pivotPointsArray = securityPivots

// Calculate R6 and S6 manually
p = array.get(securityPivots, 0)
r4 = array.get(securityPivots, 7)
s4 = array.get(securityPivots, 8)
pivot_range = highPrev - lowPrev
r6 = r4 + 2 * pivot_range
s6 = s4 - 2 * pivot_range
temp_bc = (highPrev + lowPrev) / 2
temp_tc = 2 * p - temp_bc
bc = math.min(temp_bc, temp_tc)
tc = math.max(temp_bc, temp_tc)

affixOldPivots(endTime, endBarIndex) =>
    if drawnGraphics.rows() > 0
        lastGraphics = drawnGraphics.row(drawnGraphics.rows() - 1)
        for graphic in lastGraphics
            if extendToBarInput
                graphic.pivotLine.set_x2(x=endBarIndex)
                if positionLabelsInput == "Right"
                    graphic.pivotLabel.set_xloc(x=endBarIndex, xloc=xloc.bar_index)
            else
                graphic.pivotLine.set_x2(endTime)
                if positionLabelsInput == "Right"
                    graphic.pivotLabel.set_x(endTime)

_drawPivotLevel(newGraphics, startTime, startBarIndex, levelValue, levelSettings) =>
    if not na(levelValue) and levelSettings.showLevel
        lineEndTime = startTime + timeframe.in_seconds(pivotTimeframe) * 1000

        lineColor = color.new(levelSettings.levelColor, lineTransparencyInput)
        labelBgColor = color.new(color.white, labelTransparencyInput)
        
        pivotLine = if extendToBarInput
            line.new(x1=startBarIndex, y1=levelValue, x2=bar_index + 1, y2=levelValue, xloc=xloc.bar_index, color=lineColor, width=linewidthInput, style=getLineStyle())
        else
            line.new(x1=startTime, y1=levelValue, x2=lineEndTime, y2=levelValue, xloc=xloc.bar_time, color=lineColor, width=linewidthInput, style=getLineStyle())
        
        pivotLabel = if extendToBarInput
            label.new(x=positionLabelsInput == "Left" ? startBarIndex + 1: bar_index + 1, y=levelValue, text=(showLabelsInput ? levelSettings.levelName + " " : "") + (showPricesInput ? "(" + str.tostring(levelValue, format.mintick) + ")" : ""), style=positionLabelsInput == "Left" ? label.style_label_right : label.style_label_left, textcolor=levelSettings.levelColor, color=labelBgColor, size=getLabelSize(), xloc=xloc.bar_index)
        else
            label.new(x=positionLabelsInput == "Left" ? startTime : lineEndTime, y=levelValue, text=(showLabelsInput ? levelSettings.levelName + " " : "") + (showPricesInput ? "(" + str.tostring(levelValue, format.mintick) + ")" : ""), style=positionLabelsInput == "Left" ? label.style_label_right : label.style_label_left, textcolor=levelSettings.levelColor, color=labelBgColor, size=getLabelSize(), xloc=xloc.bar_time)
        
        newGraphics.push(pivotGraphic.new(pivotLine, pivotLabel))


drawNewPivots(startTime, startBarIndex) =>
    newGraphics = array.new<pivotGraphic>()
    
    for [index, coord] in pivotPointsArray
        levelSettings = graphicSettingsArray.get(index)
        _drawPivotLevel(newGraphics, startTime, startBarIndex, coord, levelSettings)
    
    // Draw R6 level
    if r6ShowInput
        levelSettings = graphicSettingsArray.get(11)
        _drawPivotLevel(newGraphics, startTime, startBarIndex, r6, levelSettings)
    
    // Draw S6 level
    if s6ShowInput
        levelSettings = graphicSettingsArray.get(12)
        _drawPivotLevel(newGraphics, startTime, startBarIndex, s6, levelSettings)
    
    if prevCloseShowInput
        levelSettings = graphicSettingsArray.get(13)
        _drawPivotLevel(newGraphics, startTime, startBarIndex, prevClose, levelSettings)

    if bcShowInput
        levelSettings = graphicSettingsArray.get(14)
        _drawPivotLevel(newGraphics, startTime, startBarIndex, bc, levelSettings)
    
    if tcShowInput
        levelSettings = graphicSettingsArray.get(15)
        _drawPivotLevel(newGraphics, startTime, startBarIndex, tc, levelSettings)
    
    drawnGraphics.add_row(array_id=newGraphics)
    
    if drawnGraphics.rows() > maxHistoricalPivotsInput
        oldGraphics = drawnGraphics.remove_row(0)
        for graphic in oldGraphics
            graphic.delete()

securityPivotDrawConditionStatic = securityPivotCounter != securityPivotCounter[1]

if securityPivotDrawConditionStatic
    affixOldPivots(time, bar_index)
    drawNewPivots(time, bar_index)

if extendToBarInput and drawnGraphics.rows() > 0
    lastGraphics = drawnGraphics.row(drawnGraphics.rows() - 1)
    for graphic in lastGraphics
        graphic.pivotLine.set_x2(bar_index + 1)
        if positionLabelsInput == "Right"
            graphic.pivotLabel.set_x(bar_index + 1)

var FIRST_BAR_TIME = time
if barstate.islastconfirmedhistory and drawnGraphics.columns() == 0
    if not na(securityPivots) and securityPivotCounter > 0 and not extendToBarInput
        drawNewPivots(FIRST_BAR_TIME, bar_index)
    else
        runtime.error("Not enough data to calculate Pivot Points.")