//@version=6
indicator("SMC Market Structure [2CR/2CG + FVG/OB]", overlay = true, max_bars_back = 5000, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// --- User Inputs ---
grp_2cr = "2CR / 2CG Settings"
color2CRLabelBg = input.color(color.new(color.red, 0), "2CR Label BG", group = grp_2cr)
color2CGLabelBg = input.color(color.new(color.green, 0), "2CG Label BG", group = grp_2cr)
color2CRText = input.color(color.white, "2CR Text Color", group = grp_2cr)
color2CGText = input.color(color.white, "2CG Text Color", group = grp_2cr)
show2CRLabelBg = input.bool(true, "Show 2CR / 2CG Label BG", group = grp_2cr)
show2CRZone = input.bool(true, "Show 2CR / 2CG Yellow Zone", group = grp_2cr)
max2CRZones = input.int(80, "Max 2CR / 2CG Zones", minval = 0, maxval = 250, group = grp_2cr)
color2CRZone = input.color(color.new(color.yellow, 90), "2CR Zone Color", group = grp_2cr)
color2CGZone = input.color(color.new(color.yellow, 90), "2CG Zone Color", group = grp_2cr)

grp_bos = "BOS Settings"
colorBullBOS = input.color(color.new(#22C55E, 0), "Bullish BOS Line", group = grp_bos)
colorBearBOS = input.color(color.new(#F43F5E, 0), "Bearish BOS Line", group = grp_bos)
bosPreviewLineStyleInput = input.string("Dashed", "Waiting BOS Line Style", options = ["Solid", "Dashed", "Dotted"], group = grp_bos)
bosLineStyleInput = input.string("Solid", "Confirmed BOS Line Style", options = ["Solid", "Dashed", "Dotted"], group = grp_bos)
bosPreviewLineWidth = input.int(1, "Waiting BOS Line Width", minval = 1, maxval = 5, group = grp_bos)
bosLineWidth = input.int(2, "Confirmed BOS Line Width", minval = 1, maxval = 5, group = grp_bos)
bosTextColor = input.color(color.white, "BOS Text Color", group = grp_bos)
bosBullLabelBg = input.color(color.new(#14532D, 5), "Bullish BOS Label BG", group = grp_bos)
bosBearLabelBg = input.color(color.new(#881337, 5), "Bearish BOS Label BG", group = grp_bos)
showBOSLabelBg = input.bool(true, "Show BOS Label BG", group = grp_bos)

grp_choch = "CHoCH Settings"
colorBullCHoCH = input.color(color.new(#38BDF8, 0), "Bullish CHoCH Line", group = grp_choch)
colorBearCHoCH = input.color(color.new(#F59E0B, 0), "Bearish CHoCH Line", group = grp_choch)
chochLineStyleInput = input.string("Solid", "CHoCH Line Style", options = ["Solid", "Dashed", "Dotted"], group = grp_choch)
chochLineWidth = input.int(2, "CHoCH Line Width", minval = 1, maxval = 5, group = grp_choch)
chochTextColor = input.color(color.white, "CHoCH Text Color", group = grp_choch)
chochBullLabelBg = input.color(color.new(#0C4A6E, 5), "Bullish CHoCH Label BG", group = grp_choch)
chochBearLabelBg = input.color(color.new(#78350F, 5), "Bearish CHoCH Label BG", group = grp_choch)
showCHoCHLabelBg = input.bool(true, "Show CHoCH Label BG", group = grp_choch)
showCurrentPendingCHoCH = input.bool(true, "Show Current P.CHoCH", group = grp_choch)
showPreviousPendingCHoCH = input.bool(true, "Show Previous P.CHoCH", group = grp_choch)

grp_dual = "Dual CHoCH Settings"
colorDualCHoCH = input.color(color.new(#C084FC, 0), "Dual CHoCH Line", group = grp_dual)
dualChochLineStyleInput = input.string("Dashed", "Dual CHoCH Line Style", options = ["Solid", "Dashed", "Dotted"], group = grp_dual)
dualChochLineWidth = input.int(2, "Dual CHoCH Line Width", minval = 1, maxval = 5, group = grp_dual)
dualChochTextColor = input.color(color.white, "Dual CHoCH Text Color", group = grp_dual)
dualChochLabelBg = input.color(color.new(#581C87, 5), "Dual CHoCH Label BG", group = grp_dual)
