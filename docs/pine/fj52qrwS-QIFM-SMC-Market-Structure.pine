showCurrentBosFib = input.bool(true, "Show Current Fib", group = grp_fib)
showPreviousBosFib = input.bool(true, "Show Previous Fibs", group = grp_fib)
maxPreviousBosFibs = input.int(8, "Max Previous Fibs", minval = 0, maxval = 25, group = grp_fib)
showFibTrendLine = false
fibTrendLineStyleInput = "Dotted"
fibTrendLineWidth = 1
fibTrendColor = color.new(#64748B, 100)
fibLevelLineStyleInput = input.string("Solid", "Fib Level Line Style", options = ["Solid", "Dashed", "Dotted"], group = grp_fib)
fibLevelLineWidth = input.int(1, "Fib Level Line Width", minval = 1, maxval = 5, group = grp_fib)
showFibLevelLabels = input.bool(true, "Show Fib Level Text", group = grp_fib)
showFibLevel0 = false
fibLevel0Value = 0.0
fibLevel0Color = color.new(#CBD5E1, 100)
showFibLevel236 = false
fibLevel236Value = 0.236
fibLevel236Color = color.new(#94A3B8, 100)
showFibLevel382 = false
fibLevel382Value = 0.382
fibLevel382Color = color.new(#60A5FA, 100)
showFibLevel50 = input.bool(true, "Show Level 0.5", group = grp_fib)
fibLevel50Value = input.float(0.5, "Level 0.5 Value", step = 0.001, group = grp_fib)
fibLevel50Color = input.color(color.new(#A78BFA, 10), "Level 0.5 Color", group = grp_fib)
showFibLevel618 = input.bool(true, "Show Level 0.618", group = grp_fib)
fibLevel618Value = input.float(0.618, "Level 0.618 Value", step = 0.001, group = grp_fib)
fibLevel618Color = input.color(color.new(#34D399, 10), "Level 0.618 Color", group = grp_fib)
showFibLevel786 = input.bool(true, "Show Level 0.7", group = grp_fib)
fibLevel786Value = input.float(0.7, "Level 0.7 Value", step = 0.001, group = grp_fib)
fibLevel786Color = input.color(color.new(#FBBF24, 10), "Level 0.7 Color", group = grp_fib)
showFibLevel1 = input.bool(true, "Show Level 1", group = grp_fib)
fibLevel1Value = input.float(1.0, "Level 1 Value", step = 0.001, group = grp_fib)
fibLevel1Color = input.color(color.new(#CBD5E1, 30), "Level 1 Color", group = grp_fib)
showFibZone = false
fibZoneFromValue = 0.5
fibZoneToValue = 1.0
fibZoneColor = color.new(#F59E0B, 100)

grp_fvg = "FVG Settings"
showFVG = input.bool(true, "Show Structure-Leg FVGs", group = grp_fvg)
showBullishFVG = input.bool(true, "Show Bullish FVGs", group = grp_fvg)
showBearishFVG = input.bool(true, "Show Bearish FVGs", group = grp_fvg)
showUnfilledFVG = input.bool(true, "Show Current Unfilled FVGs", group = grp_fvg)
showFilledFVGHistory = input.bool(true, "Show Filled Historical FVGs", group = grp_fvg)
maxFVGZones = input.int(100, "Max FVG / OB Pairs", minval = 0, maxval = 100, group = grp_fvg)
fvgScanLookback = input.int(1000, "Maximum Leg Scan Bars", minval = 10, maxval = 4996, group = grp_fvg)
fvgMitigationInput = input.string("Full Fill", "FVG Mitigation", options = ["Full Fill", "First Touch"], group = grp_fvg)
bullishFVGColor = input.color(color.new(#14B8A6, 84), "Bullish FVG Color", group = grp_fvg)
bearishFVGColor = input.color(color.new(#F97316, 84), "Bearish FVG Color", group = grp_fvg)
filledBullishFVGColor = input.color(color.new(#14B8A6, 94), "Filled Bullish FVG Color", group = grp_fvg)
filledBearishFVGColor = input.color(color.new(#F97316, 94), "Filled Bearish FVG Color", group = grp_fvg)
fvgBorderColor = input.color(color.new(#CBD5E1, 55), "FVG Border Color", group = grp_fvg)
showFVGText = input.bool(true, "Show FVG Text", group = grp_fvg)
fvgTextColor = input.color(color.new(#F8FAFC, 5), "FVG Text Color", group = grp_fvg)

grp_ob = "Order Block Settings"
showOB = input.bool(true, "Show Order Blocks", group = grp_ob)
showBullishOB = input.bool(true, "Show Bullish OBs", group = grp_ob)
showBearishOB = input.bool(true, "Show Bearish OBs", group = grp_ob)
showUnfilledOB = input.bool(true, "Show Current OBs", group = grp_ob)
showFilledOBHistory = input.bool(true, "Show Historical OBs", group = grp_ob)
bullishOBColor = input.color(color.new(#3B82F6, 86), "Bullish OB Color", group = grp_ob)
bearishOBColor = input.color(color.new(#E11D48, 86), "Bearish OB Color", group = grp_ob)
filledBullishOBColor = input.color(color.new(#3B82F6, 95), "Historical Bullish OB Color", group = grp_ob)
filledBearishOBColor = input.color(color.new(#E11D48, 95), "Historical Bearish OB Color", group = grp_ob)
obBorderColor = input.color(color.new(#E2E8F0, 55), "OB Border Color", group = grp_ob)
showOBText = input.bool(true, "Show OB Text", group = grp_ob)
obTextColor = input.color(color.new(#F8FAFC, 5), "OB Text Color", group = grp_ob)

grp_levels = "Previous Day / Week Levels"
showPreviousDayLevels = input.bool(true, "Show Previous Day High / Low", group = grp_levels)
previousDayHighColor = input.color(color.new(#22D3EE, 12), "Previous Day High Color", group = grp_levels)
previousDayLowColor = input.color(color.new(#06B6D4, 12), "Previous Day Low Color", group = grp_levels)
previousDayLineWidth = input.int(1, "Previous Day Line Width", minval = 1, maxval = 4, group = grp_levels)
alertPreviousDayHighHit = input.bool(true, "Alert When PDH Hits", group = grp_levels)
alertPreviousDayLowHit = input.bool(true, "Alert When PDL Hits", group = grp_levels)
showPreviousWeekLevels = input.bool(true, "Show Previous Week High / Low", group = grp_levels)
previousWeekHighColor = input.color(color.new(#F59E0B, 8), "Previous Week High Color", group = grp_levels)
previousWeekLowColor = input.color(color.new(#F97316, 8), "Previous Week Low Color", group = grp_levels)
previousWeekLineWidth = input.int(2, "Previous Week Line Width", minval = 1, maxval = 4, group = grp_levels)

grp_candle = "Candle Analysis"
showCandlePanel = input.bool(true, "Show Live OHLC Panel", group = grp_candle)
colorCandlesByAnalysis = input.bool(false, "Color Candles by Classification", group = grp_candle)
analysisBullColor = input.color(color.new(#22C55E, 0), "Bullish Candle Color", group = grp_candle)
analysisBearColor = input.color(color.new(#EF4444, 0), "Bearish Candle Color", group = grp_candle)
analysisDojiColor = input.color(color.new(#94A3B8, 0), "Doji Candle Color", group = grp_candle)
analysisFullInsideColor = input.color(color.new(#F59E0B, 0), "Full-Range Inside Color", group = grp_candle)
analysisBodyInsideColor = input.color(color.new(#FDE047, 0), "Body-Inside Color", group = grp_candle)
analysisPanelBg = input.color(color.new(#0F172A, 12), "Panel Background", group = grp_candle)
analysisPanelText = input.color(color.new(#F8FAFC, 0), "Panel Text Color", group = grp_candle)

// --- Definitions ---
isBearishCandle(_open, _close) =>
    _close < _open

isBullishCandle(_open, _close) =>
    _close > _open

isRed = isBearishCandle(open, close)
isGreen = isBullishCandle(open, close)
isDoji = close == open
isFullRangeInside = bar_index > 0 and high <= high[1] and low >= low[1]
isBodyInsidePreviousRange = bar_index > 0 and open >= low[1] and open <= high[1] and close >= low[1] and close <= high[1]
isBodyOnlyInside = isBodyInsidePreviousRange and not isFullRangeInside

lineStyleFromInput(styleName) =>
    styleName == "Dotted" ? line.style_dotted : styleName == "Dashed" ? line.style_dashed : line.style_solid

visibleColor(_color, _visible) =>
    _visible ? _color : color.new(_color, 100)

fibLevelPrice(_zeroPrice, _onePrice, _levelValue) =>
    _zeroPrice + (_onePrice - _zeroPrice) * _levelValue

newFibLine(_left, _right, _price, _color, _style, _width, _visible) =>
    line.new(_left, _price, _right, _price, color = visibleColor(_color, _visible), style = _style, width = _width)

newFibLabel(_right, _price, _levelValue, _color, _visible) =>
    label.new(_right, _price, str.tostring(_levelValue), style = label.style_none, color = color.new(_color, 100), textcolor = visibleColor(_color, _visible), size = size.tiny)

setFibLineVisible(_line, _color, _visible) =>
    if not na(_line)
        line.set_color(_line, visibleColor(_color, _visible))

setFibLabelVisible(_label, _color, _visible) =>
    if not na(_label)
        label.set_textcolor(_label, visibleColor(_color, _visible))

setFibBoxVisible(_box, _color, _visible) =>
    if not na(_box)
        box.set_bgcolor(_box, visibleColor(_color, _visible))
        box.set_border_color(_box, color.new(_color, 100))

bosPreviewLineStyle = lineStyleFromInput(bosPreviewLineStyleInput)
bosLineStyle = lineStyleFromInput(bosLineStyleInput)
chochLineStyle = lineStyleFromInput(chochLineStyleInput)
dualChochLineStyle = lineStyleFromInput(dualChochLineStyleInput)
fibTrendLineStyle = lineStyleFromInput(fibTrendLineStyleInput)
fibLevelLineStyle = lineStyleFromInput(fibLevelLineStyleInput)

newWaitingBosLine(_idx, _level, _color) =>
    line.new(_idx, _level, math.max(bar_index, _idx + 1), _level, color = color.new(_color, 50), style = bosPreviewLineStyle, width = bosPreviewLineWidth)

refreshWaitingBosLine(_line, _idx, _level) =>
    if not na(_line)
        line.set_xy1(_line, _idx, _level)
        line.set_xy2(_line, math.max(bar_index, _idx + 1), _level)

extendActiveChochLine(_line, _level) =>
    if not na(_line) and not na(_level)
        line.set_xy2(_line, bar_index, _level)

color2CRLabelColor = show2CRLabelBg ? color2CRLabelBg : color.new(color2CRLabelBg, 100)
color2CGLabelColor = show2CRLabelBg ? color2CGLabelBg : color.new(color2CGLabelBg, 100)
bosBullLabelColor = showBOSLabelBg ? bosBullLabelBg : color.new(bosBullLabelBg, 100)
bosBearLabelColor = showBOSLabelBg ? bosBearLabelBg : color.new(bosBearLabelBg, 100)
chochBullLabelColor = showCHoCHLabelBg ? chochBullLabelBg : color.new(chochBullLabelBg, 100)
chochBearLabelColor = showCHoCHLabelBg ? chochBearLabelBg : color.new(chochBearLabelBg, 100)
dualChochLabelColor = showDualChochLabelBg ? dualChochLabelBg : color.new(dualChochLabelBg, 100)

// --- State Variables ---
var int trend = 0 // 1 for Bullish, -1 for Bearish

var float bosLevel = na
var int bosIdx = na
var bool waitingForBOSBreak = false

var float chochLevel = na
var int chochIdx = na
var float lastChochFibAnchorLevel = na
var int lastChochFibAnchorIdx = na
var line activeChochPointLine = na
var label activeChochPointLabel = na
var int activeChochPointDir = 0

var float dualChochLevel = na
var int dualChochIdx = na

var float currentExtreme = na
var int currentExtremeIdx = na
var float retracementExtreme = na
var int retracementExtremeIdx = na
var float main2CRHigh = na
var float main2CRLow = na
var int main2CRIdx = na

var float main2CGHigh = na
var float main2CGLow = na
var int main2CGIdx = na

var line activeFibTrendLine = na
var line activeFibLevel0Line = na
var line activeFibLevel236Line = na
var line activeFibLevel382Line = na
var line activeFibLevel50Line = na
var line activeFibLevel618Line = na
var line activeFibLevel786Line = na
var line activeFibLevel1Line = na
var label activeFibLevel0Label = na
var label activeFibLevel236Label = na
var label activeFibLevel382Label = na
var label activeFibLevel50Label = na
var label activeFibLevel618Label = na
var label activeFibLevel786Label = na
var label activeFibLevel1Label = na
var box activeFibZoneBox = na
var float activeFvgFibBandLow = na
var float activeFvgFibBandHigh = na
var line activeWaitingBosLine = na
var line[] previousFibLines = array.new_line()
var label[] previousFibLabels = array.new_label()
var box[] previousFibBoxes = array.new_box()
var box[] twoCRZoneBoxes = array.new_box()
var box[] fvgBoxes = array.new_box()
var box[] obBoxes = array.new_box()
var int[] fvgDirections = array.new_int()
var int[] fvgOriginIndices = array.new_int()
var bool[] fvgIsActive = array.new_bool()

deleteLineObject(_line) =>
    if not na(_line)
        line.delete(_line)

deleteLabelObject(_label) =>
    if not na(_label)
        label.delete(_label)

deleteBoxObject(_box) =>
    if not na(_box)
        box.delete(_box)

deletePreviousFibObjects() =>
    while array.size(previousFibLines) > 0
        line oldLine = array.shift(previousFibLines)
        line.delete(oldLine)
    while array.size(previousFibLabels) > 0
        label oldLabel = array.shift(previousFibLabels)
        label.delete(oldLabel)
    while array.size(previousFibBoxes) > 0
        box oldBox = array.shift(previousFibBoxes)
        box.delete(oldBox)

trimPreviousFibObjects(_maxFibs) =>
    while array.size(previousFibBoxes) > _maxFibs
        box oldBox = array.shift(previousFibBoxes)
        box.delete(oldBox)
        for i = 0 to 3
            if array.size(previousFibLines) > 0
                line oldLine = array.shift(previousFibLines)
                line.delete(oldLine)
        for i = 0 to 3
            if array.size(previousFibLabels) > 0
                label oldLabel = array.shift(previousFibLabels)
                label.delete(oldLabel)

trim2CRZoneObjects(_maxZones) =>
    while array.size(twoCRZoneBoxes) > _maxZones
        box oldBox = array.shift(twoCRZoneBoxes)
        box.delete(oldBox)

trimFVGObjects(_maxZones) =>
    while array.size(fvgBoxes) > _maxZones
        box oldBox = array.shift(fvgBoxes)
        box.delete(oldBox)
        box oldOBBox = array.shift(obBoxes)
        box.delete(oldOBBox)
        array.shift(fvgDirections)
        array.shift(fvgOriginIndices)
        array.shift(fvgIsActive)

fvgAlreadyStored(_originIdx, _direction) =>
    bool found = false
    if array.size(fvgBoxes) > 0
        for i = 0 to array.size(fvgBoxes) - 1
            if array.get(fvgOriginIndices, i) == _originIdx and array.get(fvgDirections, i) == _direction
                found := true
                break
    found

fvgWasMitigated(_originIdx, _top, _bottom, _direction) =>
    bool mitigated = false
    if _originIdx < bar_index
        for futureIdx = _originIdx + 1 to bar_index
            int futureOffset = bar_index - futureIdx
            if _direction == 1
                float mitigationPrice = fvgMitigationInput == "First Touch" ? _top : _bottom
                if low[futureOffset] <= mitigationPrice
                    mitigated := true
                    break
            else
                float mitigationPrice = fvgMitigationInput == "First Touch" ? _bottom : _top
                if high[futureOffset] >= mitigationPrice
                    mitigated := true
                    break
    mitigated

scanConfirmedLegForFVGs(_startIdx, _endIdx, _direction) =>
    if (showFVG or showOB) and maxFVGZones > 0 and not na(_startIdx) and not na(_endIdx)
        int legStart = math.min(_startIdx, _endIdx)
        int legEnd = math.max(_startIdx, _endIdx)
        int scanStart = math.max(legStart, bar_index - fvgScanLookback)
        bool directionVisible = _direction == 1 ? (showFVG and showBullishFVG) or (showOB and showBullishOB) : (showFVG and showBearishFVG) or (showOB and showBearishOB)
        if directionVisible and scanStart <= legEnd
            int lastMainIdx = na
            bool insideTwoBarsBack = false
            bool insideOneBarBack = false
            for candleIdx = scanStart to legEnd
                int candleOffset = bar_index - candleIdx
                int lastMainOffset = na(lastMainIdx) ? na : bar_index - lastMainIdx
                bool isInsideMainCandle = not na(lastMainIdx) and high[candleOffset] <= high[lastMainOffset] and low[candleOffset] >= low[lastMainOffset]
                if not isInsideMainCandle
                    lastMainIdx := candleIdx

                if candleIdx >= scanStart + 2
                    int secondCandleOffset = candleOffset + 1
                    int firstCandleOffset = candleOffset + 2
                    int candleBeforeFirstOffset = firstCandleOffset + 1
                    bool firstBodyInsidePrevious = false
                    if candleIdx - 2 > 0
                        bool firstOpenInsidePrevious = open[firstCandleOffset] >= low[candleBeforeFirstOffset] and open[firstCandleOffset] <= high[candleBeforeFirstOffset]
                        bool firstCloseInsidePrevious = close[firstCandleOffset] >= low[candleBeforeFirstOffset] and close[firstCandleOffset] <= high[candleBeforeFirstOffset]
                        firstBodyInsidePrevious := firstOpenInsidePrevious and firstCloseInsidePrevious
                    bool secondInsideFirst = high[secondCandleOffset] <= high[firstCandleOffset] and low[secondCandleOffset] >= low[firstCandleOffset]
                    bool thirdInsideFirst = high[candleOffset] <= high[firstCandleOffset] and low[candleOffset] >= low[firstCandleOffset]
                    bool thirdInsideSecond = high[candleOffset] <= high[secondCandleOffset] and low[candleOffset] >= low[secondCandleOffset]
                    bool hasNoInsideCandles = not firstBodyInsidePrevious and not insideTwoBarsBack and not insideOneBarBack and not isInsideMainCandle and not secondInsideFirst and not thirdInsideFirst and not thirdInsideSecond
                    bool hasWickImbalance = _direction == 1 ? low[candleOffset] > high[firstCandleOffset] : high[candleOffset] < low[firstCandleOffset]
                    bool hasBodyConfirmation = _direction == 1 ? close[candleOffset] > high[secondCandleOffset] : close[candleOffset] < low[secondCandleOffset]
                    if hasNoInsideCandles and hasWickImbalance and hasBodyConfirmation and not fvgAlreadyStored(candleIdx, _direction)
                        float fvgTop = _direction == 1 ? low[candleOffset] : low[firstCandleOffset]
                        float fvgBottom = _direction == 1 ? high[firstCandleOffset] : high[candleOffset]
                        float orderBlockTop = high[firstCandleOffset]
                        float orderBlockBottom = low[firstCandleOffset]
                        bool fibBandReady = not na(activeFvgFibBandLow) and not na(activeFvgFibBandHigh)
                        bool fvgInsideFibBand = fibBandReady and fvgBottom >= activeFvgFibBandLow and fvgTop <= activeFvgFibBandHigh
                        bool obInsideFibBand = fibBandReady and orderBlockBottom >= activeFvgFibBandLow and orderBlockTop <= activeFvgFibBandHigh
                        if fvgInsideFibBand and obInsideFibBand and not fvgWasMitigated(candleIdx, fvgTop, fvgBottom, _direction)
                            color zoneColor = _direction == 1 ? bullishFVGColor : bearishFVGColor
                            color orderBlockColor = _direction == 1 ? bullishOBColor : bearishOBColor
                            bool showThisFVG = showFVG and (_direction == 1 ? showBullishFVG : showBearishFVG)
                            bool showThisOB = showOB and (_direction == 1 ? showBullishOB : showBearishOB)
                            string zoneText = showFVGText ? "FVG" : ""
                            string orderBlockText = showOBText ? "OB" : ""
                            int zoneLeft = candleIdx - 2
                            box newFVGBox = box.new(zoneLeft, fvgTop, bar_index, fvgBottom, border_color = visibleColor(fvgBorderColor, showThisFVG and showUnfilledFVG), bgcolor = visibleColor(zoneColor, showThisFVG and showUnfilledFVG), text = zoneText, text_color = visibleColor(fvgTextColor, showThisFVG and showUnfilledFVG and showFVGText), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
                            box newOBBox = box.new(zoneLeft, orderBlockTop, bar_index, orderBlockBottom, border_color = visibleColor(obBorderColor, showThisOB and showUnfilledOB), bgcolor = visibleColor(orderBlockColor, showThisOB and showUnfilledOB), text = orderBlockText, text_color = visibleColor(obTextColor, showThisOB and showUnfilledOB and showOBText), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
                            array.push(fvgBoxes, newFVGBox)
                            array.push(obBoxes, newOBBox)
                            array.push(fvgDirections, _direction)
                            array.push(fvgOriginIndices, candleIdx)
                            array.push(fvgIsActive, true)
                            trimFVGObjects(maxFVGZones)

                insideTwoBarsBack := insideOneBarBack
                insideOneBarBack := isInsideMainCandle

updateFVGObjects() =>
    if array.size(fvgBoxes) > 0
        for i = array.size(fvgBoxes) - 1 to 0
            box currentBox = array.get(fvgBoxes, i)
            box currentOBBox = array.get(obBoxes, i)
            int direction = array.get(fvgDirections, i)
            bool isActive = array.get(fvgIsActive, i)
            bool showThisFVG = showFVG and (direction == 1 ? showBullishFVG : showBearishFVG)
            bool showThisOB = showOB and (direction == 1 ? showBullishOB : showBearishOB)
            if isActive
                float zoneTop = box.get_top(currentBox)
                float zoneBottom = box.get_bottom(currentBox)
                float mitigationPrice = direction == 1 ? (fvgMitigationInput == "First Touch" ? zoneTop : zoneBottom) : (fvgMitigationInput == "First Touch" ? zoneBottom : zoneTop)
                bool isMitigated = direction == 1 ? low <= mitigationPrice : high >= mitigationPrice
                if isMitigated
                    if showFilledFVGHistory or showFilledOBHistory
                        color historyColor = direction == 1 ? filledBullishFVGColor : filledBearishFVGColor
                        color orderBlockHistoryColor = direction == 1 ? filledBullishOBColor : filledBearishOBColor
                        box.set_right(currentBox, bar_index)
                        box.set_bgcolor(currentBox, visibleColor(historyColor, showThisFVG and showFilledFVGHistory))
                        box.set_border_color(currentBox, visibleColor(color.new(fvgBorderColor, 80), showThisFVG and showFilledFVGHistory))
                        box.set_text_color(currentBox, visibleColor(fvgTextColor, showThisFVG and showFilledFVGHistory and showFVGText))
                        box.set_right(currentOBBox, bar_index)
                        box.set_bgcolor(currentOBBox, visibleColor(orderBlockHistoryColor, showThisOB and showFilledOBHistory))
                        box.set_border_color(currentOBBox, visibleColor(color.new(obBorderColor, 80), showThisOB and showFilledOBHistory))
                        box.set_text_color(currentOBBox, visibleColor(obTextColor, showThisOB and showFilledOBHistory and showOBText))
                        array.set(fvgIsActive, i, false)
                    else
                        box.delete(currentBox)
                        box.delete(currentOBBox)
                        array.remove(fvgBoxes, i)
                        array.remove(obBoxes, i)
                        array.remove(fvgDirections, i)
                        array.remove(fvgOriginIndices, i)
                        array.remove(fvgIsActive, i)
                else
                    color activeColor = direction == 1 ? bullishFVGColor : bearishFVGColor
                    color orderBlockActiveColor = direction == 1 ? bullishOBColor : bearishOBColor
                    box.set_right(currentBox, bar_index)
                    box.set_bgcolor(currentBox, visibleColor(activeColor, showThisFVG and showUnfilledFVG))
                    box.set_border_color(currentBox, visibleColor(fvgBorderColor, showThisFVG and showUnfilledFVG))
                    box.set_text_color(currentBox, visibleColor(fvgTextColor, showThisFVG and showUnfilledFVG and showFVGText))
                    box.set_right(currentOBBox, bar_index)
                    box.set_bgcolor(currentOBBox, visibleColor(orderBlockActiveColor, showThisOB and showUnfilledOB))
                    box.set_border_color(currentOBBox, visibleColor(obBorderColor, showThisOB and showUnfilledOB))
                    box.set_text_color(currentOBBox, visibleColor(obTextColor, showThisOB and showUnfilledOB and showOBText))
    true

expireUnrespectedStructureZones() =>
    if array.size(fvgBoxes) > 0
        for i = array.size(fvgBoxes) - 1 to 0
            if array.get(fvgIsActive, i)
                box expiredFVG = array.get(fvgBoxes, i)
                box expiredOB = array.get(obBoxes, i)
                int direction = array.get(fvgDirections, i)
                bool showThisFVG = showFVG and (direction == 1 ? showBullishFVG : showBearishFVG)
                bool showThisOB = showOB and (direction == 1 ? showBullishOB : showBearishOB)
                if showFilledFVGHistory or showFilledOBHistory
                    color historyColor = direction == 1 ? filledBullishFVGColor : filledBearishFVGColor
                    color orderBlockHistoryColor = direction == 1 ? filledBullishOBColor : filledBearishOBColor
                    box.set_right(expiredFVG, bar_index)
                    box.set_bgcolor(expiredFVG, visibleColor(historyColor, showThisFVG and showFilledFVGHistory))
                    box.set_border_color(expiredFVG, visibleColor(color.new(fvgBorderColor, 80), showThisFVG and showFilledFVGHistory))
                    box.set_text_color(expiredFVG, visibleColor(fvgTextColor, showThisFVG and showFilledFVGHistory and showFVGText))
                    box.set_right(expiredOB, bar_index)
                    box.set_bgcolor(expiredOB, visibleColor(orderBlockHistoryColor, showThisOB and showFilledOBHistory))
                    box.set_border_color(expiredOB, visibleColor(color.new(obBorderColor, 80), showThisOB and showFilledOBHistory))
                    box.set_text_color(expiredOB, visibleColor(obTextColor, showThisOB and showFilledOBHistory and showOBText))
                    array.set(fvgIsActive, i, false)
                else
                    box.delete(expiredFVG)
                    box.delete(expiredOB)
                    array.remove(fvgBoxes, i)
                    array.remove(obBoxes, i)
                    array.remove(fvgDirections, i)
                    array.remove(fvgOriginIndices, i)
                    array.remove(fvgIsActive, i)
    true

storeActiveFibAsPrevious() =>
    if not na(activeFibTrendLine)
        array.push(previousFibLines, activeFibTrendLine)
    if not na(activeFibLevel0Line)
        array.push(previousFibLines, activeFibLevel0Line)
    if not na(activeFibLevel236Line)
        array.push(previousFibLines, activeFibLevel236Line)
    if not na(activeFibLevel382Line)
        array.push(previousFibLines, activeFibLevel382Line)
    if not na(activeFibLevel50Line)
        array.push(previousFibLines, activeFibLevel50Line)
    if not na(activeFibLevel618Line)
        array.push(previousFibLines, activeFibLevel618Line)
    if not na(activeFibLevel786Line)
        array.push(previousFibLines, activeFibLevel786Line)
    if not na(activeFibLevel1Line)
        array.push(previousFibLines, activeFibLevel1Line)
    if not na(activeFibLevel0Label)
        array.push(previousFibLabels, activeFibLevel0Label)
    if not na(activeFibLevel236Label)
        array.push(previousFibLabels, activeFibLevel236Label)
    if not na(activeFibLevel382Label)
        array.push(previousFibLabels, activeFibLevel382Label)
    if not na(activeFibLevel50Label)
        array.push(previousFibLabels, activeFibLevel50Label)
    if not na(activeFibLevel618Label)
        array.push(previousFibLabels, activeFibLevel618Label)
    if not na(activeFibLevel786Label)
        array.push(previousFibLabels, activeFibLevel786Label)
    if not na(activeFibLevel1Label)
        array.push(previousFibLabels, activeFibLevel1Label)
    if not na(activeFibZoneBox)
        array.push(previousFibBoxes, activeFibZoneBox)

deleteActiveFibObjects() =>
    deleteLineObject(activeFibTrendLine)
    deleteLineObject(activeFibLevel0Line)
    deleteLineObject(activeFibLevel236Line)
    deleteLineObject(activeFibLevel382Line)
    deleteLineObject(activeFibLevel50Line)
    deleteLineObject(activeFibLevel618Line)
    deleteLineObject(activeFibLevel786Line)
    deleteLineObject(activeFibLevel1Line)
    deleteLabelObject(activeFibLevel0Label)
    deleteLabelObject(activeFibLevel236Label)
    deleteLabelObject(activeFibLevel382Label)
    deleteLabelObject(activeFibLevel50Label)
    deleteLabelObject(activeFibLevel618Label)
    deleteLabelObject(activeFibLevel786Label)
    deleteLabelObject(activeFibLevel1Label)
    deleteBoxObject(activeFibZoneBox)

prepareActiveFibSlot() =>
    if showPreviousBosFib and maxPreviousBosFibs > 0
        setFibLineVisible(activeFibTrendLine, fibTrendColor, showFibTrendLine)
        setFibLineVisible(activeFibLevel0Line, fibLevel0Color, showFibLevel0)
        setFibLineVisible(activeFibLevel236Line, fibLevel236Color, showFibLevel236)
        setFibLineVisible(activeFibLevel382Line, fibLevel382Color, showFibLevel382)
        setFibLineVisible(activeFibLevel50Line, fibLevel50Color, showFibLevel50)
        setFibLineVisible(activeFibLevel618Line, fibLevel618Color, showFibLevel618)
        setFibLineVisible(activeFibLevel786Line, fibLevel786Color, showFibLevel786)
        setFibLineVisible(activeFibLevel1Line, fibLevel1Color, showFibLevel1)
        setFibLabelVisible(activeFibLevel0Label, fibLevel0Color, showFibLevelLabels and showFibLevel0)
        setFibLabelVisible(activeFibLevel236Label, fibLevel236Color, showFibLevelLabels and showFibLevel236)
        setFibLabelVisible(activeFibLevel382Label, fibLevel382Color, showFibLevelLabels and showFibLevel382)
        setFibLabelVisible(activeFibLevel50Label, fibLevel50Color, showFibLevelLabels and showFibLevel50)
        setFibLabelVisible(activeFibLevel618Label, fibLevel618Color, showFibLevelLabels and showFibLevel618)
        setFibLabelVisible(activeFibLevel786Label, fibLevel786Color, showFibLevelLabels and showFibLevel786)
        setFibLabelVisible(activeFibLevel1Label, fibLevel1Color, showFibLevelLabels and showFibLevel1)
        setFibBoxVisible(activeFibZoneBox, fibZoneColor, showFibZone)
        storeActiveFibAsPrevious()
        trimPreviousFibObjects(maxPreviousBosFibs)
    else
        deletePreviousFibObjects()
        deleteActiveFibObjects()

bool draw2CR = false
bool draw2CG = false

updateFVGObjects()

if barstate.isfirst
    trend := 1
    currentExtreme := high
    currentExtremeIdx := bar_index
    chochLevel := low
    chochIdx := bar_index
    lastChochFibAnchorLevel := low
    lastChochFibAnchorIdx := bar_index

// --- Main Logic ---
int currentTrend = trend
bool stateChanged = false

// Track the developing candle in real time; body-close rules settle when the bar closes.
if currentTrend == 1
    if not waitingForBOSBreak
        if na(currentExtreme) or high > currentExtreme
            currentExtreme := high
            currentExtremeIdx := bar_index
            main2CRHigh := na
            main2CRLow := na
            main2CRIdx := na

        bool isValid2CR = false
        bool isInsideMain2CR = not na(main2CRLow) and high <= main2CRHigh and low >= main2CRLow
        if isRed
            if na(main2CRLow)
                main2CRHigh := high
                main2CRLow := low
                main2CRIdx := bar_index
            else if bar_index == main2CRIdx + 1
                if close < main2CRLow
                    isValid2CR := true
                else if not isInsideMain2CR
                    main2CRHigh := high
                    main2CRLow := low
                    main2CRIdx := bar_index
            else if close < main2CRLow or not isInsideMain2CR
                main2CRHigh := high
                main2CRLow := low
                main2CRIdx := bar_index
        else if not na(main2CRLow) and not isInsideMain2CR
            main2CRHigh := na
            main2CRLow := na
            main2CRIdx := na

        if isValid2CR
            bosLevel := currentExtreme
            bosIdx := currentExtremeIdx

            float fibStartLevel = lastChochFibAnchorLevel
            int fibStartIdx = lastChochFibAnchorIdx
            float fibEndLevel = currentExtreme
            int fibEndIdx = currentExtremeIdx
            activeFvgFibBandLow := na
            activeFvgFibBandHigh := na
            if not na(fibStartLevel) and not na(fibEndLevel)
                float filterFib50Price = fibLevelPrice(fibEndLevel, fibStartLevel, 0.5)
                float filterFib1Price = fibLevelPrice(fibEndLevel, fibStartLevel, 1.0)
                activeFvgFibBandLow := math.min(filterFib50Price, filterFib1Price)
                activeFvgFibBandHigh := math.max(filterFib50Price, filterFib1Price)
            if showBosFib and not na(fibStartLevel) and not na(fibStartIdx) and not na(fibEndLevel) and not na(fibEndIdx)
                prepareActiveFibSlot()
                activeFibTrendLine := na
                activeFibLevel0Line := na
                activeFibLevel236Line := na
                activeFibLevel382Line := na
                activeFibLevel50Line := na
                activeFibLevel618Line := na
                activeFibLevel786Line := na
                activeFibLevel1Line := na
                activeFibLevel0Label := na
                activeFibLevel236Label := na
                activeFibLevel382Label := na
                activeFibLevel50Label := na
                activeFibLevel618Label := na
                activeFibLevel786Label := na
                activeFibLevel1Label := na
                activeFibZoneBox := na
                float fibRange = math.abs(fibEndLevel - fibStartLevel)
                if fibRange > 0
                    int fibLeft = math.min(fibStartIdx, fibEndIdx)
                    int fibRight = math.max(bar_index, fibLeft + 1)
                    float fibZeroPrice = fibEndLevel
                    float fibOnePrice = fibStartLevel
                    float fibLevel50Price = fibLevelPrice(fibZeroPrice, fibOnePrice, fibLevel50Value)
                    float fibLevel618Price = fibLevelPrice(fibZeroPrice, fibOnePrice, fibLevel618Value)
                    float fibLevel786Price = fibLevelPrice(fibZeroPrice, fibOnePrice, fibLevel786Value)
                    float fibLevel1Price = fibLevelPrice(fibZeroPrice, fibOnePrice, fibLevel1Value)
                    bool showCurrentFib = showCurrentBosFib
                    // Invisible tracker keeps previous-Fib history without drawing a zone.
                    activeFibZoneBox := box.new(fibLeft, fibZeroPrice, fibRight, fibZeroPrice, border_color = color.new(fibZoneColor, 100), bgcolor = color.new(fibZoneColor, 100))
                    activeFibLevel50Line := newFibLine(fibLeft, fibRight, fibLevel50Price, fibLevel50Color, fibLevelLineStyle, fibLevelLineWidth, showCurrentFib and showFibLevel50)
                    activeFibLevel618Line := newFibLine(fibLeft, fibRight, fibLevel618Price, fibLevel618Color, fibLevelLineStyle, fibLevelLineWidth, showCurrentFib and showFibLevel618)
                    activeFibLevel786Line := newFibLine(fibLeft, fibRight, fibLevel786Price, fibLevel786Color, fibLevelLineStyle, fibLevelLineWidth, showCurrentFib and showFibLevel786)
                    activeFibLevel1Line := newFibLine(fibLeft, fibRight, fibLevel1Price, fibLevel1Color, fibLevelLineStyle, fibLevelLineWidth, showCurrentFib and showFibLevel1)
                    activeFibLevel50Label := newFibLabel(fibRight, fibLevel50Price, fibLevel50Value, fibLevel50Color, showCurrentFib and showFibLevelLabels and showFibLevel50)
                    activeFibLevel618Label := newFibLabel(fibRight, fibLevel618Price, fibLevel618Value, fibLevel618Color, showCurrentFib and showFibLevelLabels and showFibLevel618)
                    activeFibLevel786Label := newFibLabel(fibRight, fibLevel786Price, fibLevel786Value, fibLevel786Color, showCurrentFib and showFibLevelLabels and showFibLevel786)
                    activeFibLevel1Label := newFibLabel(fibRight, fibLevel1Price, fibLevel1Value, fibLevel1Color, showCurrentFib and showFibLevelLabels and showFibLevel1)

            waitingForBOSBreak := true
            retracementExtreme := low
            retracementExtremeIdx := bar_index
            deleteLineObject(activeWaitingBosLine)
            activeWaitingBosLine := newWaitingBosLine(bosIdx, bosLevel, colorBullBOS)
            draw2CR := true
            if show2CRZone and max2CRZones > 0
                box new2CRZone = box.new(main2CRIdx, math.max(high, main2CRHigh), bar_index, math.min(low, main2CRLow), border_color = color.new(color2CRZone, 100), bgcolor = color2CRZone)
                array.push(twoCRZoneBoxes, new2CRZone)
                trim2CRZoneObjects(max2CRZones)
            main2CRHigh := na
            main2CRLow := na
            main2CRIdx := na
    else
        if low < retracementExtreme
            retracementExtreme := low
            retracementExtremeIdx := bar_index

        if close > bosLevel
            expireUnrespectedStructureZones()
            scanConfirmedLegForFVGs(retracementExtremeIdx, bar_index, 1)
            deleteLineObject(activeWaitingBosLine)
            activeWaitingBosLine := na
            line.new(bosIdx, bosLevel, bar_index, bosLevel, color = colorBullBOS, style = bosLineStyle, width = bosLineWidth)
            label.new(math.round(math.avg(bosIdx, bar_index)), bosLevel, "BOS", style = label.style_label_down, color = bosBullLabelColor, textcolor = bosTextColor, size = size.tiny)
            chochLevel := retracementExtreme
            chochIdx := retracementExtremeIdx
            dualChochLevel := na
            main2CRHigh := na
            main2CRLow := na
            main2CRIdx := na
            if not na(activeChochPointLine)
                if showPreviousPendingCHoCH
                    line.set_color(activeChochPointLine, activeChochPointDir == 1 ? color.new(colorBullCHoCH, 75) : color.new(colorBearCHoCH, 75))
                else
                    line.delete(activeChochPointLine)
            if not na(activeChochPointLabel)
                if showPreviousPendingCHoCH
                    label.set_color(activeChochPointLabel, activeChochPointDir == 1 ? color.new(chochBullLabelBg, showCHoCHLabelBg ? 75 : 100) : color.new(chochBearLabelBg, showCHoCHLabelBg ? 75 : 100))
                    label.set_textcolor(activeChochPointLabel, color.new(chochTextColor, 60))
                else
                    label.delete(activeChochPointLabel)
            activeChochPointLine := line.new(chochIdx, chochLevel, bar_index, chochLevel, color = showCurrentPendingCHoCH ? colorBearCHoCH : color.new(colorBearCHoCH, 100), style = chochLineStyle, width = chochLineWidth)
            activeChochPointLabel := label.new(chochIdx, chochLevel, "P.CHoCH", style = label.style_label_up, color = showCurrentPendingCHoCH ? chochBearLabelColor : color.new(chochBearLabelBg, 100), textcolor = showCurrentPendingCHoCH ? chochTextColor : color.new(chochTextColor, 100), size = size.tiny)
            activeChochPointDir := -1
            lastChochFibAnchorLevel := chochLevel
            lastChochFibAnchorIdx := chochIdx
            waitingForBOSBreak := false
            currentExtreme := high
            currentExtremeIdx := bar_index
            bosLevel := na
            stateChanged := true

    if not stateChanged and not na(chochLevel)
        extendActiveChochLine(activeChochPointLine, chochLevel)
        if close < chochLevel and close[1] < chochLevel
            expireUnrespectedStructureZones()
            scanConfirmedLegForFVGs(currentExtremeIdx, bar_index, -1)
            deleteLineObject(activeWaitingBosLine)
            activeWaitingBosLine := na
            line.new(chochIdx, chochLevel, bar_index, chochLevel, color = colorBearCHoCH, style = chochLineStyle, width = chochLineWidth)
            label.new(math.round(math.avg(chochIdx, bar_index)), chochLevel, "CHoCH", style = label.style_label_up, color = chochBearLabelColor, textcolor = chochTextColor, size = size.tiny)
            lastChochFibAnchorLevel := currentExtreme
            lastChochFibAnchorIdx := currentExtremeIdx
            dualChochLevel := currentExtreme
            dualChochIdx := currentExtremeIdx
            trend := -1
            waitingForBOSBreak := false
            chochLevel := na
            bosLevel := na
            main2CRHigh := na
            main2CRLow := na
            main2CRIdx := na
            main2CGHigh := na
            main2CGLow := na
            main2CGIdx := na
            currentExtreme := low
            currentExtremeIdx := bar_index
            stateChanged := true

    if not stateChanged and not na(dualChochLevel)
        if close < dualChochLevel and close[1] < dualChochLevel
            expireUnrespectedStructureZones()
            scanConfirmedLegForFVGs(currentExtremeIdx, bar_index, -1)
            deleteLineObject(activeWaitingBosLine)
            activeWaitingBosLine := na
            line.new(dualChochIdx, dualChochLevel, bar_index, dualChochLevel, color = colorDualCHoCH, style = dualChochLineStyle, width = dualChochLineWidth)
            label.new(math.round(math.avg(dualChochIdx, bar_index)), dualChochLevel, "DUAL CHoCH", style = label.style_label_up, color = dualChochLabelColor, textcolor = dualChochTextColor, size = size.tiny)
            lastChochFibAnchorLevel := currentExtreme
            lastChochFibAnchorIdx := currentExtremeIdx
            dualChochLevel := currentExtreme
            dualChochIdx := currentExtremeIdx
            trend := -1
            waitingForBOSBreak := false
            chochLevel := na
            bosLevel := na
            main2CRHigh := na
            main2CRLow := na
            main2CRIdx := na
            main2CGHigh := na
            main2CGLow := na
            main2CGIdx := na
            currentExtreme := low
            currentExtremeIdx := bar_index
            stateChanged := true

else if currentTrend == -1
    if not waitingForBOSBreak
        if na(currentExtreme) or low < currentExtreme
            currentExtreme := low
            currentExtremeIdx := bar_index
            main2CGHigh := na
            main2CGLow := na
            main2CGIdx := na

        bool isValid2CG = false
        bool isInsideMain2CG = not na(main2CGHigh) and high <= main2CGHigh and low >= main2CGLow
        if isGreen
            if na(main2CGHigh)
                main2CGHigh := high
                main2CGLow := low
                main2CGIdx := bar_index
            else if bar_index == main2CGIdx + 1
                if close > main2CGHigh
                    isValid2CG := true
                else if not isInsideMain2CG
                    main2CGHigh := high
                    main2CGLow := low
                    main2CGIdx := bar_index
            else if close > main2CGHigh or not isInsideMain2CG
                main2CGHigh := high
                main2CGLow := low
                main2CGIdx := bar_index
        else if not na(main2CGHigh) and not isInsideMain2CG
            main2CGHigh := na
            main2CGLow := na
            main2CGIdx := na

        if isValid2CG
            bosLevel := currentExtreme
            bosIdx := currentExtremeIdx

            float fibStartLevel = lastChochFibAnchorLevel
            int fibStartIdx = lastChochFibAnchorIdx
            float fibEndLevel = currentExtreme
            int fibEndIdx = currentExtremeIdx
            activeFvgFibBandLow := na
            activeFvgFibBandHigh := na
            if not na(fibStartLevel) and not na(fibEndLevel)
                float filterFib50Price = fibLevelPrice(fibEndLevel, fibStartLevel, 0.5)
                float filterFib1Price = fibLevelPrice(fibEndLevel, fibStartLevel, 1.0)
                activeFvgFibBandLow := math.min(filterFib50Price, filterFib1Price)
                activeFvgFibBandHigh := math.max(filterFib50Price, filterFib1Price)
            if showBosFib and not na(fibStartLevel) and not na(fibStartIdx) and not na(fibEndLevel) and not na(fibEndIdx)
                prepareActiveFibSlot()
                activeFibTrendLine := na
                activeFibLevel0Line := na
                activeFibLevel236Line := na
                activeFibLevel382Line := na
                activeFibLevel50Line := na
                activeFibLevel618Line := na
                activeFibLevel786Line := na
                activeFibLevel1Line := na
                activeFibLevel0Label := na
                activeFibLevel236Label := na
                activeFibLevel382Label := na
                activeFibLevel50Label := na
                activeFibLevel618Label := na
                activeFibLevel786Label := na
                activeFibLevel1Label := na
                activeFibZoneBox := na
                float fibRange = math.abs(fibEndLevel - fibStartLevel)
                if fibRange > 0
                    int fibLeft = math.min(fibStartIdx, fibEndIdx)
                    int fibRight = math.max(bar_index, fibLeft + 1)
                    float fibZeroPrice = fibEndLevel
                    float fibOnePrice = fibStartLevel
                    float fibLevel50Price = fibLevelPrice(fibZeroPrice, fibOnePrice, fibLevel50Value)
                    float fibLevel618Price = fibLevelPrice(fibZeroPrice, fibOnePrice, fibLevel618Value)
                    float fibLevel786Price = fibLevelPrice(fibZeroPrice, fibOnePrice, fibLevel786Value)
                    float fibLevel1Price = fibLevelPrice(fibZeroPrice, fibOnePrice, fibLevel1Value)
                    bool showCurrentFib = showCurrentBosFib
                    // Invisible tracker keeps previous-Fib history without drawing a zone.
                    activeFibZoneBox := box.new(fibLeft, fibZeroPrice, fibRight, fibZeroPrice, border_color = color.new(fibZoneColor, 100), bgcolor = color.new(fibZoneColor, 100))
                    activeFibLevel50Line := newFibLine(fibLeft, fibRight, fibLevel50Price, fibLevel50Color, fibLevelLineStyle, fibLevelLineWidth, showCurrentFib and showFibLevel50)
                    activeFibLevel618Line := newFibLine(fibLeft, fibRight, fibLevel618Price, fibLevel618Color, fibLevelLineStyle, fibLevelLineWidth, showCurrentFib and showFibLevel618)
                    activeFibLevel786Line := newFibLine(fibLeft, fibRight, fibLevel786Price, fibLevel786Color, fibLevelLineStyle, fibLevelLineWidth, showCurrentFib and showFibLevel786)
                    activeFibLevel1Line := newFibLine(fibLeft, fibRight, fibLevel1Price, fibLevel1Color, fibLevelLineStyle, fibLevelLineWidth, showCurrentFib and showFibLevel1)
                    activeFibLevel50Label := newFibLabel(fibRight, fibLevel50Price, fibLevel50Value, fibLevel50Color, showCurrentFib and showFibLevelLabels and showFibLevel50)
                    activeFibLevel618Label := newFibLabel(fibRight, fibLevel618Price, fibLevel618Value, fibLevel618Color, showCurrentFib and showFibLevelLabels and showFibLevel618)
                    activeFibLevel786Label := newFibLabel(fibRight, fibLevel786Price, fibLevel786Value, fibLevel786Color, showCurrentFib and showFibLevelLabels and showFibLevel786)
                    activeFibLevel1Label := newFibLabel(fibRight, fibLevel1Price, fibLevel1Value, fibLevel1Color, showCurrentFib and showFibLevelLabels and showFibLevel1)

            waitingForBOSBreak := true
            retracementExtreme := high
            retracementExtremeIdx := bar_index
            deleteLineObject(activeWaitingBosLine)
            activeWaitingBosLine := newWaitingBosLine(bosIdx, bosLevel, colorBearBOS)
            draw2CG := true
            if show2CRZone and max2CRZones > 0
                box new2CGZone = box.new(main2CGIdx, math.max(high, main2CGHigh), bar_index, math.min(low, main2CGLow), border_color = color.new(color2CGZone, 100), bgcolor = color2CGZone)
                array.push(twoCRZoneBoxes, new2CGZone)
                trim2CRZoneObjects(max2CRZones)
            main2CGHigh := na
            main2CGLow := na
            main2CGIdx := na
    else
        if high > retracementExtreme
            retracementExtreme := high
            retracementExtremeIdx := bar_index

        if close < bosLevel
            expireUnrespectedStructureZones()
            scanConfirmedLegForFVGs(retracementExtremeIdx, bar_index, -1)
            deleteLineObject(activeWaitingBosLine)
            activeWaitingBosLine := na
            line.new(bosIdx, bosLevel, bar_index, bosLevel, color = colorBearBOS, style = bosLineStyle, width = bosLineWidth)
            label.new(math.round(math.avg(bosIdx, bar_index)), bosLevel, "BOS", style = label.style_label_up, color = bosBearLabelColor, textcolor = bosTextColor, size = size.tiny)
            chochLevel := retracementExtreme
            chochIdx := retracementExtremeIdx
            dualChochLevel := na
            main2CGHigh := na
            main2CGLow := na
            main2CGIdx := na
            if not na(activeChochPointLine)
                if showPreviousPendingCHoCH
                    line.set_color(activeChochPointLine, activeChochPointDir == 1 ? color.new(colorBullCHoCH, 75) : color.new(colorBearCHoCH, 75))
                else
                    line.delete(activeChochPointLine)
            if not na(activeChochPointLabel)
                if showPreviousPendingCHoCH
                    label.set_color(activeChochPointLabel, activeChochPointDir == 1 ? color.new(chochBullLabelBg, showCHoCHLabelBg ? 75 : 100) : color.new(chochBearLabelBg, showCHoCHLabelBg ? 75 : 100))
                    label.set_textcolor(activeChochPointLabel, color.new(chochTextColor, 60))
                else
                    label.delete(activeChochPointLabel)
            activeChochPointLine := line.new(chochIdx, chochLevel, bar_index, chochLevel, color = showCurrentPendingCHoCH ? colorBullCHoCH : color.new(colorBullCHoCH, 100), style = chochLineStyle, width = chochLineWidth)
            activeChochPointLabel := label.new(chochIdx, chochLevel, "P.CHoCH", style = label.style_label_down, color = showCurrentPendingCHoCH ? chochBullLabelColor : color.new(chochBullLabelBg, 100), textcolor = showCurrentPendingCHoCH ? chochTextColor : color.new(chochTextColor, 100), size = size.tiny)
            activeChochPointDir := 1
            lastChochFibAnchorLevel := chochLevel
            lastChochFibAnchorIdx := chochIdx
            waitingForBOSBreak := false
            currentExtreme := low
            currentExtremeIdx := bar_index
            bosLevel := na
            stateChanged := true

    if not stateChanged and not na(chochLevel)
        extendActiveChochLine(activeChochPointLine, chochLevel)
        if close > chochLevel and close[1] > chochLevel
            expireUnrespectedStructureZones()
            scanConfirmedLegForFVGs(currentExtremeIdx, bar_index, 1)
            deleteLineObject(activeWaitingBosLine)
            activeWaitingBosLine := na
            line.new(chochIdx, chochLevel, bar_index, chochLevel, color = colorBullCHoCH, style = chochLineStyle, width = chochLineWidth)
            label.new(math.round(math.avg(chochIdx, bar_index)), chochLevel, "CHoCH", style = label.style_label_down, color = chochBullLabelColor, textcolor = chochTextColor, size = size.tiny)
            lastChochFibAnchorLevel := currentExtreme
            lastChochFibAnchorIdx := currentExtremeIdx
            dualChochLevel := currentExtreme
            dualChochIdx := currentExtremeIdx
            trend := 1
            waitingForBOSBreak := false
            chochLevel := na
            bosLevel := na
            main2CRHigh := na
            main2CRLow := na
            main2CRIdx := na
            main2CGHigh := na
            main2CGLow := na
            main2CGIdx := na
            currentExtreme := high
            currentExtremeIdx := bar_index
            stateChanged := true

    if not stateChanged and not na(dualChochLevel)
        if close > dualChochLevel and close[1] > dualChochLevel
            expireUnrespectedStructureZones()
            scanConfirmedLegForFVGs(currentExtremeIdx, bar_index, 1)
            deleteLineObject(activeWaitingBosLine)
            activeWaitingBosLine := na
            line.new(dualChochIdx, dualChochLevel, bar_index, dualChochLevel, color = colorDualCHoCH, style = dualChochLineStyle, width = dualChochLineWidth)
            label.new(math.round(math.avg(dualChochIdx, bar_index)), dualChochLevel, "DUAL CHoCH", style = label.style_label_down, color = dualChochLabelColor, textcolor = dualChochTextColor, size = size.tiny)
            lastChochFibAnchorLevel := currentExtreme
            lastChochFibAnchorIdx := currentExtremeIdx
            dualChochLevel := currentExtreme
            dualChochIdx := currentExtremeIdx
            trend := 1
            waitingForBOSBreak := false
            chochLevel := na
            bosLevel := na
            main2CRHigh := na
            main2CRLow := na
            main2CRIdx := na
            main2CGHigh := na
            main2CGLow := na
            main2CGIdx := na
            currentExtreme := high
            currentExtremeIdx := bar_index
            stateChanged := true

// --- Visual Markers ---
plotshape(draw2CR, title="2CR", style=shape.labeldown, location=location.abovebar, color=color2CRLabelColor, text="2CR", textcolor=color2CRText, size=size.tiny)
plotshape(draw2CG, title="2CG", style=shape.labelup, location=location.belowbar, color=color2CGLabelColor, text="2CG", textcolor=color2CGText, size=size.tiny)

// Previous completed session levels. Indicators recalculate this data on every
// live price update, while request.security keeps the reference periods stable.
float previousDayHigh = request.security(syminfo.tickerid, "D", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float previousDayLow = request.security(syminfo.tickerid, "D", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float previousWeekHigh = request.security(syminfo.tickerid, "W", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float previousWeekLow = request.security(syminfo.tickerid, "W", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
bool newTradingDay = timeframe.change("D")
bool newTradingWeek = timeframe.change("W")
bool previousDayHighTouchedNow = not na(previousDayHigh) and high >= previousDayHigh and low <= previousDayHigh
bool previousDayLowTouchedNow = not na(previousDayLow) and high >= previousDayLow and low <= previousDayLow
bool previousDayHighTouchedPreviousBar = not na(previousDayHigh) and high[1] >= previousDayHigh and low[1] <= previousDayHigh
bool previousDayLowTouchedPreviousBar = not na(previousDayLow) and high[1] >= previousDayLow and low[1] <= previousDayLow
bool previousDayHighHitAlert = showPreviousDayLevels and alertPreviousDayHighHit and previousDayHighTouchedNow and not previousDayHighTouchedPreviousBar
bool previousDayLowHitAlert = showPreviousDayLevels and alertPreviousDayLowHit and previousDayLowTouchedNow and not previousDayLowTouchedPreviousBar
var line currentPDHLine = na
var line currentPDLLine = na
var line currentPWHLine = na
var line currentPWLLine = na
var label currentPDHLabel = na
var label currentPDLLabel = na
var label currentPWHLabel = na
var label currentPWLLabel = na

if showPreviousDayLevels and not na(previousDayHigh) and not na(previousDayLow)
    if newTradingDay or na(currentPDHLine) or na(currentPDLLine)
        deleteLineObject(currentPDHLine)
        deleteLineObject(currentPDLLine)
        deleteLabelObject(currentPDHLabel)
        deleteLabelObject(currentPDLLabel)
        currentPDHLine := line.new(bar_index, previousDayHigh, bar_index + 1, previousDayHigh, color = previousDayHighColor, width = previousDayLineWidth)
        currentPDLLine := line.new(bar_index, previousDayLow, bar_index + 1, previousDayLow, color = previousDayLowColor, width = previousDayLineWidth)
        currentPDHLabel := label.new(bar_index + 1, previousDayHigh, "PDH", style = label.style_label_left, color = color.new(previousDayHighColor, 78), textcolor = previousDayHighColor, size = size.tiny)
        currentPDLLabel := label.new(bar_index + 1, previousDayLow, "PDL", style = label.style_label_left, color = color.new(previousDayLowColor, 78), textcolor = previousDayLowColor, size = size.tiny)
    else
        line.set_xy2(currentPDHLine, bar_index + 1, previousDayHigh)
        line.set_xy2(currentPDLLine, bar_index + 1, previousDayLow)
        label.set_xy(currentPDHLabel, bar_index + 1, previousDayHigh)
        label.set_xy(currentPDLLabel, bar_index + 1, previousDayLow)
else
    deleteLineObject(currentPDHLine)
    deleteLineObject(currentPDLLine)
    deleteLabelObject(currentPDHLabel)
    deleteLabelObject(currentPDLLabel)
    currentPDHLine := na
    currentPDLLine := na
    currentPDHLabel := na
    currentPDLLabel := na

if showPreviousWeekLevels and not na(previousWeekHigh) and not na(previousWeekLow)
    if newTradingWeek or na(currentPWHLine) or na(currentPWLLine)
        deleteLineObject(currentPWHLine)
        deleteLineObject(currentPWLLine)
        deleteLabelObject(currentPWHLabel)
        deleteLabelObject(currentPWLLabel)
        currentPWHLine := line.new(bar_index, previousWeekHigh, bar_index + 1, previousWeekHigh, color = previousWeekHighColor, width = previousWeekLineWidth)
        currentPWLLine := line.new(bar_index, previousWeekLow, bar_index + 1, previousWeekLow, color = previousWeekLowColor, width = previousWeekLineWidth)
        currentPWHLabel := label.new(bar_index + 1, previousWeekHigh, "PWH", style = label.style_label_left, color = color.new(previousWeekHighColor, 78), textcolor = previousWeekHighColor, size = size.tiny)
        currentPWLLabel := label.new(bar_index + 1, previousWeekLow, "PWL", style = label.style_label_left, color = color.new(previousWeekLowColor, 78), textcolor = previousWeekLowColor, size = size.tiny)
    else
        line.set_xy2(currentPWHLine, bar_index + 1, previousWeekHigh)
        line.set_xy2(currentPWLLine, bar_index + 1, previousWeekLow)
        label.set_xy(currentPWHLabel, bar_index + 1, previousWeekHigh)
        label.set_xy(currentPWLLabel, bar_index + 1, previousWeekLow)
else
    deleteLineObject(currentPWHLine)
    deleteLineObject(currentPWLLine)
    deleteLabelObject(currentPWHLabel)
    deleteLabelObject(currentPWLLabel)
    currentPWHLine := na
    currentPWLLine := na
    currentPWHLabel := na
    currentPWLLabel := na

alertcondition(previousDayHighHitAlert, title = "PDH Hit", message = "Price touched the current Previous Day High.")
alertcondition(previousDayLowHitAlert, title = "PDL Hit", message = "Price touched the current Previous Day Low.")

// --- Optional OHLC Candle Analysis ---
color analyzedCandleColor = isFullRangeInside ? analysisFullInsideColor : isBodyOnlyInside ? analysisBodyInsideColor : isGreen ? analysisBullColor : isRed ? analysisBearColor : analysisDojiColor
barcolor(colorCandlesByAnalysis ? analyzedCandleColor : na, title = "OHLC Candle Classification")

bool direct2CRCloseTest = bar_index > 0 and isRed and close[1] < open[1] and close < low[1]
bool direct2CGCloseTest = bar_index > 0 and isGreen and close[1] > open[1] and close > high[1]
float candleRange = high - low
float candleBody = math.abs(close - open)
float candleBodyPercent = candleRange > 0 ? candleBody / candleRange * 100.0 : 0.0
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
string candleTypeText = isGreen ? "Bullish (C > O)" : isRed ? "Bearish (C < O)" : "Doji (C = O)"
string insideTypeText = isFullRangeInside ? "Full-range inside" : isBodyOnlyInside ? "Body inside only" : "Not inside"
string directPairText = direct2CRCloseTest ? "Direct 2CR close passed" : direct2CGCloseTest ? "Direct 2CG close passed" : "No direct pair close"
varip int liveTickCount = 0
if barstate.isnew
    liveTickCount := 1
else
    liveTickCount += 1

// Eight compact rows are about 70% of the former 12-row live panel.
var table candleAnalysisTable = table.new(position.top_right, 2, 8, border_width = 1)
if barstate.islast
    if showCandlePanel
        table.cell(candleAnalysisTable, 0, 0, "Candle", bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 1, 0, barstate.isconfirmed ? "CLOSED" : "LIVE #" + str.tostring(liveTickCount), bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 0, 1, "Type", bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 1, 1, candleTypeText, bgcolor = analysisPanelBg, text_color = analyzedCandleColor, text_size = size.tiny)
        table.cell(candleAnalysisTable, 0, 2, "O / H", bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 1, 2, str.tostring(open, format.mintick) + " / " + str.tostring(high, format.mintick), bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 0, 3, "L / C", bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 1, 3, str.tostring(low, format.mintick) + " / " + str.tostring(close, format.mintick), bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 0, 4, "Body", bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 1, 4, str.tostring(candleBodyPercent, "#.##") + "%", bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 0, 5, "Wicks U/L", bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 1, 5, str.tostring(upperWick, format.mintick) + " / " + str.tostring(lowerWick, format.mintick), bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 0, 6, "Inside", bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 1, 6, insideTypeText, bgcolor = analysisPanelBg, text_color = analyzedCandleColor, text_size = size.tiny)
        table.cell(candleAnalysisTable, 0, 7, "Pair", bgcolor = analysisPanelBg, text_color = analysisPanelText, text_size = size.tiny)
        table.cell(candleAnalysisTable, 1, 7, directPairText, bgcolor = analysisPanelBg, text_color = direct2CRCloseTest ? color2CRLabelBg : direct2CGCloseTest ? color2CGLabelBg : analysisPanelText, text_size = size.tiny)
    else
        table.clear(candleAnalysisTable, 0, 0, 1, 7)
  