//@version=6
indicator("ATR% Multiple from 50-MA", shorttitle="ATR% x 50MA", overlay=true)

// ─── Inputs ────────────────────────────────────────────────
atrLen         = input.int(14, "ATR Length", minval=1)
maLen          = input.int(50, "MA Length", minval=1)
src            = input.source(close, "Source")

showMultiple   = input.bool(true, "Show ATR% Multiple From MA")
showPctGain    = input.bool(true, "Show % Gain From MA")
showAtrPct     = input.bool(true, "Show ATR %")
addSpaceUnder  = input.bool(false, "Add space underneath")

textColor      = input.color(color.white, "Text Color")
textSizeInput  = input.string("Normal", "Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"])

tablePos       = input.string("Top Right", "Table Position", 
     options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"])

// Map text size
textSize = textSizeInput == "Tiny"   ? size.tiny   :
           textSizeInput == "Small"  ? size.small  :
           textSizeInput == "Normal" ? size.normal :
           textSizeInput == "Large"  ? size.large  : size.huge

// ─── Calculations ──────────────────────────────────────────
atrValue     = ta.atr(atrLen)
atrPct       = (atrValue / src) * 100
ma50         = ta.sma(src, maLen)
pctGainMA    = ((src - ma50) / ma50) * 100
atrMultiple  = atrPct != 0 ? pctGainMA / atrPct : na

// ─── Table (fully transparent, no outline) ─────────────────
var table infoTable = table.new(
     tablePos == "Top Left"     ? position.top_left :
     tablePos == "Top Right"    ? position.top_right :
     tablePos == "Bottom Left"  ? position.bottom_left :
                                  position.bottom_right,
     columns = 2, rows = 4,
     bgcolor = color.new(color.black, 100),
     border_width = 0,
     frame_width = 0)

if barstate.islast
    table.clear(infoTable, 0, 0, 1, 3)

    row = 0

    // ATR% Multiple From MA
    if showMultiple
        table.cell(infoTable, 0, row, "ATR% Multiple From MA", 
             text_color = textColor, text_size = textSize, text_halign = text.align_left)
        table.cell(infoTable, 1, row, str.tostring(atrMultiple, "#.##"), 
             text_color = textColor, text_size = textSize, text_halign = text.align_right)
        row += 1

    // % Gain From MA
    if showPctGain
        table.cell(infoTable, 0, row, "% Gain From MA", 
             text_color = textColor, text_size = textSize, text_halign = text.align_left)
        table.cell(infoTable, 1, row, str.tostring(pctGainMA, "#.#") + "%", 
             text_color = textColor, text_size = textSize, text_halign = text.align_right)
        row += 1

    // ATR %
    if showAtrPct
        table.cell(infoTable, 0, row, "ATR %", 
             text_color = textColor, text_size = textSize, text_halign = text.align_left)
        table.cell(infoTable, 1, row, str.tostring(atrPct, "#.##") + "%", 
             text_color = textColor, text_size = textSize, text_halign = text.align_right)
        row += 1

    // Optional space underneath
    if addSpaceUnder
        table.cell(infoTable, 0, row, " ", text_color = textColor, text_size = textSize)
        table.cell(infoTable, 1, row, " ", text_color = textColor, text_size = textSize)