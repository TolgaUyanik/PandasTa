//@version=6
indicator("100-Candle Look-Back Marker", overlay = true)

// ─── Settings ───────────────────────────────────────────────────────────────
lookBackBars = 100                      // How many candles back to mark
lineColor    = color.gray               // Marker colour
lineStyle    = line.style_dotted        // Marker line style
lineWidth    = 1                        // Marker thickness
// ────────────────────────────────────────────────────────────────────────────

// Persistent line ID
var line lbLine = na

// Every bar: delete the old marker and draw a new one 100 bars back
if not na(lbLine)
    line.delete(lbLine)

// Use high / low of current bar just to give the line a visible height;   
// `extend.both` makes it span the full pane anyway.
lbLine := line.new(
     x1      = bar_index - lookBackBars,
     y1      = high, 
     x2      = bar_index - lookBackBars,
     y2      = low,
     xloc    = xloc.bar_index,
     extend  = extend.both,
     color   = lineColor,
     style   = lineStyle,
     width   = lineWidth)