//@version=6
strategy("All time - 52w breakout strategy", overlay=true,
         initial_capital=100000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         calc_on_every_tick=false)

// === Inputs ===
emaFastLen  = input.int(100,   "Fast EMA Length")
emaSlowLen  = input.int(200,   "Slow EMA Length")
exitPct     = input.float(3.0, "Exit % below EMA 100")
startDate   = input.time(timestamp("1990-01-01"), "Start Date")
endDate     = input.time(timestamp("2026-01-01"), "End Date")

// === EMAs ===
ema100 = ta.ema(close, emaFastLen)
ema200 = ta.ema(close, emaSlowLen)

// === 52-Week High (strictly previous bars only) ===
week52High = ta.highest(high, 252)[1]

// === Previous bar was at or below 52W high ===
prevBarBelowKey = high[1] <= week52High

// === Bull candle closing above 52W high ===
isBullCandle   = close > open
breakoutCandle = close > week52High and isBullCandle

// === EMA filter ===
emaTrendOK = ema100 > ema200

// === Date filter ===
withinDateRange = time >= startDate and time <= endDate

// === Entry ===
longCondition = breakoutCandle and prevBarBelowKey and emaTrendOK and withinDateRange and strategy.position_size == 0

if longCondition
    strategy.entry("Long", strategy.long)

// === Exit: entire candle body below EMA100 AND close 3%+ below EMA100 ===
bodyBelowEMA = math.max(open, close) < ema100
exitTrigger  = bodyBelowEMA and (close < ema100 * (1 - exitPct / 100))

if strategy.position_size > 0 and exitTrigger
    strategy.close("Long")