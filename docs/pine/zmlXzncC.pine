//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  SMOOTHED HEIKEN ASHI STRATEGY v1
//  Lógica pedida:
//  • Vela ROJA del indicador  -> cierra compras / entra en VENTA (confirmación)
//  • Se mantiene en venta hasta que aparece una vela VERDE (cierra la venta)
//  • Entra en COMPRA cuando aparece la 2a vela verde consecutiva
//  • Simétrico para las ventas (2a vela roja consecutiva = entrada corta)
//
//  "Velas de confirmación" = 2 por defecto (la 2a vela del nuevo color abre
//  posición). Cámbialo a 1 si quieres entrar con la primera vela.
//  ⚠️ Haz backtest y demo antes de usar dinero real.
// ═══════════════════════════════════════════════════════════════════════════

strategy("Smoothed Heiken Ashi Strategy v1",
     shorttitle = "SHA Strategy",
     overlay = true,
     initial_capital = 10000,
     currency = currency.USD,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     slippage = 2,
     process_orders_on_close = true)

// ─────────────────────────── INPUTS ───────────────────────────
grpHA = "Smoothed Heiken Ashi"
len1  = input.int(10, "Suavizado 1: EMA sobre OHLC",   minval = 1, group = grpHA)
len2  = input.int(10, "Suavizado 2: EMA sobre las HA", minval = 1, group = grpHA)
showHA = input.bool(true, "Dibujar velas Heiken Ashi suavizadas", group = grpHA)

grpSig = "Señales"
confirmBars = input.int(2, "Velas de confirmación para ENTRAR", minval = 1, group = grpSig)
exitFirst   = input.bool(true, "SALIR con la primera vela contraria", group = grpSig)
allowLong   = input.bool(true, "Permitir compras", group = grpSig)
allowShort  = input.bool(true, "Permitir ventas",  group = grpSig)

grpTime   = "Rango del backtest"
startDate = input.time(timestamp("1 Jan 2024 00:00 +0000"), "Inicio", group = grpTime)
endDate   = input.time(timestamp("31 Dec 2027 23:59 +0000"), "Fin",   group = grpTime)

// ──────────────── CÁLCULO SMOOTHED HEIKEN ASHI ────────────────
// Paso 1: suavizar el precio con EMA
oS = ta.ema(open,  len1)
hS = ta.ema(high,  len1)
lS = ta.ema(low,   len1)
cS = ta.ema(close, len1)

// Paso 2: Heiken Ashi sobre el precio suavizado
haC = (oS + hS + lS + cS) / 4
var float haO = na
haO := na(haO[1]) ? (oS + cS) / 2 : (haO[1] + haC[1]) / 2
haH = math.max(hS, math.max(haO, haC))
haL = math.min(lS, math.min(haO, haC))

// Paso 3: segundo suavizado sobre las velas HA
o2 = ta.ema(haO, len2)
c2 = ta.ema(haC, len2)
h2 = ta.ema(haH, len2)
l2 = ta.ema(haL, len2)

isGreen = c2 > o2
isRed   = c2 < o2

// ─────────────────── CONTEO DE VELAS CONSECUTIVAS ───────────────────
var int gc = 0
var int rc = 0
gc := isGreen ? gc + 1 : 0
rc := isRed   ? rc + 1 : 0

inDate = time >= startDate and time <= endDate

// ─────────────────────────── SEÑALES ───────────────────────────
longEntry  = gc == confirmBars and allowLong  and inDate
shortEntry = rc == confirmBars and allowShort and inDate
exitLong   = exitFirst and isRed   and strategy.position_size > 0
exitShort  = exitFirst and isGreen and strategy.position_size < 0

// Primero salir con la vela contraria...
if exitLong
    strategy.close("Long", comment = "1a vela roja")
if exitShort
    strategy.close("Short", comment = "1a vela verde")

// ...y entrar solo con la vela de confirmación
if longEntry
    strategy.entry("Long", strategy.long)
if shortEntry
    strategy.entry("Short", strategy.short)

// ─────────────────────────── VISUAL ───────────────────────────
plotcandle(showHA ? o2 : na, showHA ? h2 : na, showHA ? l2 : na, showHA ? c2 : na,
     "Smoothed HA",
     color      = isGreen ? color.new(color.green, 60) : color.new(color.red, 60),
     wickcolor  = isGreen ? color.new(color.green, 40) : color.new(color.red, 40),
     bordercolor = isGreen ? color.new(color.green, 40) : color.new(color.red, 40))

plotshape(longEntry,  "Compra", shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(shortEntry, "Venta",  shape.triangledown, location.abovebar, color.red,   size = size.small)

// ─────────────────────────── ALERTAS ───────────────────────────
alertcondition(longEntry,  "SHA: COMPRA",       "Smoothed HA: entrada en COMPRA")
alertcondition(shortEntry, "SHA: VENTA",        "Smoothed HA: entrada en VENTA")
alertcondition(exitLong,   "SHA: cerrar compra", "Smoothed HA: cerrar COMPRA (vela roja)")
alertcondition(exitShort,  "SHA: cerrar venta",  "Smoothed HA: cerrar VENTA (vela verde)")