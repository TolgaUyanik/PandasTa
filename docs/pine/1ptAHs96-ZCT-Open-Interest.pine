//@version=6
indicator("ZC Momentum Filter", format = format.volume)

ema1Length = input.int(60,  title = "EMA 1 Length")
ema2Length = input.int(240, title = "EMA 2 Length")

oiTicker   = syminfo.prefix + ":" + syminfo.ticker + "_OI"
oiSecurity = request.security(oiTicker, timeframe.period,
     close, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
oi = oiSecurity > 0 ? oiSecurity * close : na

plot(oi, title = "OI", color = #EFEFEF, linewidth = 2)

ema1 = ta.ema(oi, ema1Length)
ema2 = ta.ema(oi, ema2Length)

ema1Plot = plot(ema1, title = "EMA 1", color = na)
ema2Plot = plot(ema2, title = "EMA 2", color = na)

greenTransparent = color.new(#78B870, 36)
purpleTransparent = color.new(#7858B8, 36)

fill(ema1Plot, ema2Plot, color = ema1 > ema2 ? greenTransparent : purpleTransparent)