//@version=6
indicator("SPY, QQQ, VIX Table Status", overlay=true)

// === INPUTS ===
tablePosOpt = input.string("Top Right", title="Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])
getTablePos(_pos) => _pos == "Top Left" ? position.top_left : _pos == "Bottom Right" ? position.bottom_right : _pos == "Bottom Left" ? position.bottom_left : position.top_right
tablePos = getTablePos(tablePosOpt)

// Show/hide rows
showSPY = input.bool(true, "Show SPY")
showQQQ = input.bool(true, "Show QQQ")
showVIX = input.bool(true, "Show VIX")

// Show/hide columns
showDaily   = input.bool(true, "Show Daily")
show1HrMTF  = input.bool(true, "Show 1Hr MTF")
show10m512  = input.bool(true, "Show 10min (5/12)")
show10m3450 = input.bool(true, "Show 10min (34/50)")

// Style
headerColor    = input.color(color.gray, "Header BG Color")
headerOpacity  = input.int(70, "Header Opacity", minval=0, maxval=100)
spyRowColor    = input.color(color.blue, "SPY Row BG")
qqqRowColor    = input.color(color.orange, "QQQ Row BG")
vixRowColor    = input.color(color.fuchsia, "VIX Row BG")
textColor      = input.color(color.white, "Row Font Color")

// === FUNCTIONS ===
src = hl2
trendColor(cond) => cond ? color.green : color.red
trendLabel(cond) => cond ? "Bullish" : "Bearish"

getTrend(sym, tf, len1, len2) =>
    ema1 = request.security(sym, tf, ta.ema(src, len1))
    ema2 = request.security(sym, tf, ta.ema(src, len2))
    source = request.security(sym, tf, src)
    source > ema1 and ema1 > ema2

getPrice(sym) => request.security(sym, "1", close)
getOpen(sym) => request.security(sym, "D", open)
getClose(sym) => request.security(sym, "D", close)
getPriceStr(sym) =>
    p = getPrice(sym)
    sym == "VIX" ? str.tostring(p, "#.##") : "$" + str.tostring(p, "#.##")

// === CALCULATIONS ===
getAll(sym) =>
    priceStr = getPriceStr(sym)
    t512  = getTrend(sym, "10", 5, 12)
    t3450 = getTrend(sym, "10", 34, 50)
    t1hr  = getTrend(sym, "60", 34, 50)
    tDay  = getClose(sym) > getOpen(sym)
    [priceStr, t512, t3450, t1hr, tDay]

[spyPrice, spy512, spy3450, spy1hr, spyDay] = getAll("SPY")
[qqqPrice, qqq512, qqq3450, qqq1hr, qqqDay] = getAll("QQQ")
[vixPrice, vix512, vix3450, vix1hr, vixDay] = getAll("VIX")

// === TABLE ===
var table t = table.new(tablePos, columns=6, rows=4, border_width=1)

// Move drawRow function **outside** the if block
drawRow(row, name, price, b512, b3450, b1hr, bday, bg) =>
    table.cell(t, 0, row, text=name, bgcolor=bg, text_color=textColor)
    table.cell(t, 1, row, text=price, bgcolor=bg, text_color=textColor)
    if show10m512
        table.cell(t, 2, row, text=trendLabel(b512), bgcolor=trendColor(b512), text_color=color.white)
    if show10m3450
        table.cell(t, 3, row, text=trendLabel(b3450), bgcolor=trendColor(b3450), text_color=color.white)
    if show1HrMTF
        table.cell(t, 4, row, text=trendLabel(b1hr), bgcolor=trendColor(b1hr), text_color=color.white)
    if showDaily
        table.cell(t, 5, row, text=trendLabel(bday), bgcolor=trendColor(bday), text_color=color.white)

// === TABLE DRAWING ===
if bar_index % 5 == 0
    // Header row
    headerBG = color.new(headerColor, headerOpacity)
    table.cell(t, 0, 0, text="SYMBOL", text_color=color.white, bgcolor=headerBG, text_size=size.normal)
    table.cell(t, 1, 0, text="CURRENT PRICE", text_color=color.white, bgcolor=headerBG, text_size=size.normal)
    if show10m512
        table.cell(t, 2, 0, text="10 MIN (5/12)", text_color=color.white, bgcolor=headerBG, text_size=size.normal)
    if show10m3450
        table.cell(t, 3, 0, text="10 MIN (34/50)", text_color=color.white, bgcolor=headerBG, text_size=size.normal)
    if show1HrMTF
        table.cell(t, 4, 0, text="1 Hr MTF", text_color=color.white, bgcolor=headerBG, text_size=size.normal)
    if showDaily
        table.cell(t, 5, 0, text="DAILY", text_color=color.white, bgcolor=headerBG, text_size=size.normal)

    // Draw each row
    if showSPY
        drawRow(1, "SPY", spyPrice, spy512, spy3450, spy1hr, spyDay, spyRowColor)
    if showQQQ
        drawRow(2, "QQQ", qqqPrice, qqq512, qqq3450, qqq1hr, qqqDay, qqqRowColor)
    if showVIX
        drawRow(3, "VIX", vixPrice, vix512, vix3450, vix1hr, vixDay, vixRowColor)
