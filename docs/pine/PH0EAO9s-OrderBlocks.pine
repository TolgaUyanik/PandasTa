//@version=6

// @description This library will create order blocks according to the settings provided.
library("OrderBlocks")

import mickes/Touched/14

//@type Holds the visual elements or the zone.
//@field Boxes All the visual boxes.
//@field Lines All the visual lines.
//@field Labels All the visual labels.
export type Visual
    array<box> Boxes
    array<line> Lines
    array<label> Labels
//@type Holds the values for visuals for the zone and to handle interactions (retests, false breakouts and breakouts).
//@field BaseTimeClose The time close for the start of the zone.
//@field FoundTimeClose The time close for the zone when it's found.
//@field ChartBaseTime The time for the start of the zone according to the chart bar.
//@field High The maximimum price of the zone.
//@field Low The minimum price of the zone.
//@field ReactionLimit Set a factor (%) of the Average True Range (of length 14) that the total reaction must have.
//@field TouchedZone Zone object that will be created and sent to the library 'Touched'.
//@field Visual An object that holds the visual elements for the zone.
//@field Type Defines if the found zone is bullish (1) or bearish (-1).
export type Zone
    int BaseTimeClose
    int FoundTimeClose
    int ChartBaseTime
    float High
    float Low
    float ReactionLimit
    Touched.Zone TouchedZone
    Visual Visual
    int SourceTimeframeSeconds
    int Type // -1 = bearish, 1 = bullish
    int LatestRetestBarIndex
    int LatestFalseBreakoutBarIndex
    int LatestBreakoutBarIndex
    int BarIndex
    bool Removed
//@type Holds the values for the charts zones.
//@field Index The current index to use when a new zone appears. This is changed when a new zone appears.
//@field Maximum The maximum number of zones to show.
//@field Zones The currently active zones.
//@field Removes Reprsents the zones that will be replaced.
export type Zones
    int Index
    int Maximum
    array<Zone> Zones
    array<Zone> Removes
//@type The settings for the creation of order blocks. You will need to set all the containing values in here.
//@field TakeOut Set to true if you want the base candle of the order block to have to be highet or lower (take out) then the previous candle.
//@field ReactionFactor Set the factor (%) of the Average True Range (of length 14) that the total reaction must have.
//@field Type The type of the order block. Can be "Both", "Bullish" or "Bearish".
//@field ConsecutiveRisingOrFalling Set to true if you want the 3 candles in the reaction to be consecutivly rising or falling.
//@field FairValueGap Set to true if the last and the 3rd (base) candles wicks to don't overlap and create a so called fair value gap or an imbalance.
//@field MaximumZones Define the maximum of active order blocks.
//@field KeepHistoryZones Set to true if you want removed (replaced or broken) zones to be drawn.
//@field Bull The color of bullish order blocks.
//@field Bear The color of bearish order blocks.
//@field ShowReaction Set if a line should be drawn at the reaction limit.
//@field RemoveBrokenZones Enable to remove broken order blocks.
//@field CreateCreationZone Set to true if you want a box with a border to be drawn at the creation of the zone. This is usefull when the order blocks come from a higher timeframe, but not from a lower. If this is false the 'Draw()' function will start at 'time - time_close'.
//@field AlertRetests Enable if you want alerts to fire when the 'Touched' library signals that a retest of the order block has occured.
//@field AlertFalseBreakouts Enable if you want alerts to fire when the 'Touched' library signals that a false breakout of the order block has occured.
//@field AlertBreakouts Enable if you want alerts to fire when the 'Touched' library signals that a breakout of the order block has occured.
//@field AlertMessageFormat Set the format of the fired alert uppon 'Touched' library signals. Need to be in the format of '{0} on order block from ...' where '{0}' is replaced with 'retest', 'false breakout' or 'breakout'.
//@field KeepHistoryLabels Set if labels should be kept on historical zones and not only active zones.
export type Settings
    bool TakeOut
    float ReactionFactor
    string Type // "Both", "Bullish" or "Bearish"
    bool ConsecutiveRisingOrFalling
    bool FairValueGap
    int MaximumZones
    bool KeepHistoryZones
    color Bull
    color Bear
    bool ShowReaction
    bool RemoveBrokenZones
    bool CreateCreationZone
    bool AlertRetests
    bool AlertFalseBreakouts
    bool AlertBreakouts
    string AlertMessageFormat
    bool KeepHistoryLabels

_hl21 = hl2[1]
_hl22 = hl2[2]
_high2 = high[2]
_low2 = low[2]
_timeClose = time_close
_time2 = time[2]
_timeClose2 = time_close[2]
_atr = ta.atr(14)
var _timeframeSeconds = timeframe.in_seconds(timeframe.period)
var _mainTimeframeSeconds = timeframe.in_seconds(timeframe.main_period)

// @function Replaces a zone in the 'Zones' field in the 'Zones' type.
// @param zone The current zone.
// @param zones The bucket of the zones created.
// @param settings Set all values in this parameter to define the settings for the order blocks.
export Replace(Zones zones, Zone zone, Settings settings) =>
    replacedZone = zones.Zones.get(zones.Index)
    if not na(replacedZone) and na(replacedZone.LatestBreakoutBarIndex)
        zones.Removes.push(replacedZone)
    zones.Zones.set(zones.Index, zone)
    zones.Index := (zones.Index + 1) % settings.MaximumZones
method RemoveVisuals(Zone zone, Settings settings) =>
    if not zone.Removed
        for [i, b] in zone.Visual.Boxes
            if settings.KeepHistoryZones
                if i == 0 // only edit the zone box
                    b.set_right(time)
                    b.set_extend(extend.none)
            else
                b.delete()
        if not settings.KeepHistoryZones
            for l in zone.Visual.Lines
                l.delete()
        if not settings.KeepHistoryLabels
            for l in zone.Visual.Labels
                l.delete()
        zone.Removed := true
// @function Removes the zone in 'zones.Remove' and its visuals. The visuals will be replaced if 'settings.KeepHistoryZones' is true.
// @param zones The current zone.
// @param settings Set all values in this parameter to define the settings for the order blocks.
export Remove(Zones zones, Settings settings) =>
    for remove in zones.Removes
        if not na(remove)
            remove.RemoveVisuals(settings)
    zones.Removes.clear()
// @function Draws all the required visuals for the 'zone' according to the 'settings'.
// @param zones The zone to be drawn.
// @param settings set all values in this parameter to define the settings for the order block creation.
export Draw(Zone zone, Settings settings) =>
    var timeDifference = timeframe.in_seconds(timeframe.main_period) * 1000 // needed because how tradingview draws to the next candle if the time value is 'time_close'
    c = switch zone.Type
        -1 => settings.Bear
        1 => settings.Bull
    zone.Visual.Boxes.push(box.new(zone.ChartBaseTime, zone.High, zone.FoundTimeClose, zone.Low, xloc = xloc.bar_time, bgcolor = color.new(c, 70), border_width = 0, extend = extend.right))
    if settings.CreateCreationZone
        end = if zone.SourceTimeframeSeconds == _mainTimeframeSeconds
            zone.BaseTimeClose
        else if zone.SourceTimeframeSeconds > _mainTimeframeSeconds
            zone.BaseTimeClose - timeDifference
        zone.Visual.Boxes.push(box.new(zone.ChartBaseTime, zone.High, end, zone.Low, xloc = xloc.bar_time, bgcolor = na, border_color = c))
    if settings.ShowReaction
        reactionLimit = switch zone.Type
            -1 => zone.High - zone.ReactionLimit
            1 => zone.Low + zone.ReactionLimit
        end = if zone.SourceTimeframeSeconds == _mainTimeframeSeconds
            zone.FoundTimeClose - timeDifference
        else if zone.SourceTimeframeSeconds > _mainTimeframeSeconds
            zone.FoundTimeClose - timeDifference
        else
            zone.ChartBaseTime + timeDifference
        line.new(zone.ChartBaseTime, reactionLimit, end, reactionLimit, xloc = xloc.bar_time, color = c)
method Interaction(Zone zone, Touched.Touch touch, color c = na, string lbl = na) =>
    interacted = false
    if touch.Down
        if not na(lbl)
            zone.Visual.Labels.push(label.new(bar_index - touch.ExtremeIndexBack, low[touch.ExtremeIndexBack], lbl, color = c, style = label.style_label_up))
        interacted := true
    if touch.Up
        if not na(lbl)
            zone.Visual.Labels.push(label.new(bar_index - touch.ExtremeIndexBack, high[touch.ExtremeIndexBack], lbl, color = c))
        interacted := true
    interacted
// @function Creates an order block if one is found according to the settings parameter.
// @param settings set all values in this parameter to define the settings for the order block creation.
export Interactions(array<Zone> zones, Settings settings) =>
    for zone in zones
        if na(zone)
            continue
        if zone.Removed
            continue
        if zone.Interaction(Touched.Retest(zone.TouchedZone, 30), color.new(color.blue, 30), "R")
            zone.LatestRetestBarIndex := bar_index
            if settings.AlertRetests
                alert(str.format(settings.AlertMessageFormat, "retest"), alert.freq_once_per_bar_close)
        if zone.Interaction(Touched.FalseBreakout(zone.TouchedZone, 30), color.new(color.orange, 30), "FB")
            zone.LatestFalseBreakoutBarIndex := bar_index
            if settings.AlertFalseBreakouts
                alert(str.format(settings.AlertMessageFormat, "false breakout"), alert.freq_once_per_bar_close)
        if zone.Interaction(Touched.Breakout(zone.TouchedZone, 50), color.new(color.red, 30), "B")
            zone.LatestBreakoutBarIndex := bar_index
            if settings.RemoveBrokenZones
                zone.RemoveVisuals(settings)
            if settings.AlertBreakouts
                alert(str.format(settings.AlertMessageFormat, "breakout"), alert.freq_once_per_bar_close)
CreateUp(Settings settings) =>
    satisfied = true
    for i = 2 to 1
        if settings.ConsecutiveRisingOrFalling
            [previous, current] = switch i
                2 => [_hl21, _hl22]
                1 => [hl2, _hl21]
            if previous < current
                satisfied := false
                break

    if settings.FairValueGap
        if _high2 >= low
            satisfied := false
    satisfied
CreateDown(Settings settings) =>
    satisfied = true
    for i = 2 to 1
        if settings.ConsecutiveRisingOrFalling
            [previous, current] = switch i
                2 => [_hl21, _hl22]
                1 => [hl2, _hl21]
            if previous > current
                satisfied := false
                break

    if settings.FairValueGap
        if _low2 <= high
            satisfied := false
    satisfied
// @function Creates pivots (high and low) to be passed to 'Create()'.
// @param settings set all values in this parameter to define the settings for the order block creation.
// @returns a tuple containing two pivot values (high and low) or 'na'
export Pivots(Settings settings) =>
    [ta.pivothigh(settings.TakeOut ? 1 : 0, 2), ta.pivotlow(settings.TakeOut ? 1 : 0, 2)]
// @function Creates an order block if one is found according to the settings parameter.
// @param settings set all values in this parameter to define the settings for the order block creation.
// @param pivotHigh The high pivot to use.
// @param pivotLow The low pivot to use.
// @returns a Zone object if an order block is found, na otherwise
export Create(Settings settings, float pivotHigh, float pivotLow) =>
    chartTime2 = time(timeframe.main_period)[2]
    reactionLimit = _atr * settings.ReactionFactor
    widthUp = high - _low2
    widthDown = _high2 - low
    zone = Zone.new(_timeClose2, _timeClose, chartTime2, _high2, _low2, reactionLimit, Touched.Zone.new(_high2, _low2, _time2), Visual.new(array.new<box>(), array.new<line>(), array.new<label>()), _timeframeSeconds)
    create = false
    if widthUp >= reactionLimit
        if not na(pivotLow) and barstate.isconfirmed // only create an order block if the HTF bar is closed
            if settings.Type == "Both" or settings.Type == "Bullish"
                if CreateUp(settings)
                    zone.Type := 1
                    create := true
    if widthDown >= reactionLimit
        if not na(pivotHigh) and barstate.isconfirmed // only create an order block if the HTF bar is closed
            if settings.Type == "Both" or settings.Type == "Bearish"
                if CreateDown(settings)
                    zone.Type := -1
                    create := true
    if create
        zone