//@version=6
strategy("sebbiottino  Trailing Stop so good ger40 1m ", overlay=true)

// INPUT
length = input.int(20, "Length")
mult = input.float(0.2, "Band Multiplier")
emaLength = input.int(15, "EMA Length")

// CALC
src = close
lag = math.floor((length - 1) / 2)

zlema = ta.ema(src + (src - src[lag]), length)
volatility = ta.highest(ta.atr(length), length * 3) * mult

upper = zlema + volatility
lower = zlema - volatility

// EMA FILTER
ema = ta.ema(close, emaLength)
longFilter = close > ema
shortFilter = close < ema

// TREND
var int trend = 0

if ta.crossover(close, upper) and longFilter
    trend := 1

if ta.crossunder(close, lower) and shortFilter
    trend := -1

// ENTRY
longEntry = ta.crossover(close, zlema) and trend == 1 and longFilter
shortEntry = ta.crossunder(close, zlema) and trend == -1 and shortFilter

if longEntry
    strategy.entry("LONG", strategy.long)

if shortEntry
    strategy.entry("SHORT", strategy.short)

// TRAILING STOP BASED ON BAND
var float longStop = na
var float shortStop = na

if strategy.position_size > 0
    longStop := na(longStop) ? lower : math.max(longStop, lower)
    strategy.exit("LX", "LONG", stop=longStop)

if strategy.position_size < 0
    shortStop := na(shortStop) ? upper : math.min(shortStop, upper)
    strategy.exit("SX", "SHORT", stop=shortStop)

if strategy.position_size == 0
    longStop := na
    shortStop := na

// PLOTS (NO LINES REMOVED AS REQUESTED)
plotshape(longEntry, style=shape.labelup, location=location.belowbar, color=color.green, text="BUY")
plotshape(shortEntry, style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL")

plot(strategy.position_size > 0 ? longStop : na, color=color.green, title="Long Stop")
plot(strategy.position_size < 0 ? shortStop : na, color=color.red, title="Short Stop")