//@version=6
indicator("Edo Reaction Zones", overlay=true, max_labels_count=200)

// --------------------------- INPUTS ---------------------------
grpE = "EMAs"
len1 = input.int(9,   "EMA 1", minval=1, group=grpE)
len2 = input.int(20,  "EMA 2", minval=1, group=grpE)
len3 = input.int(50,  "EMA 3", minval=1, group=grpE)
len4 = input.int(100, "EMA 4", minval=1, group=grpE)
len5 = input.int(200, "EMA 5", minval=1, group=grpE)

grpZ = "Reaction Zones"
showZones   = input.bool(true, "Show reaction zones", group=grpZ)
atrLen      = input.int(14, "ATR length", minval=1, group=grpZ)
zoneMult    = input.float(0.6, "Zone width (ATR x)", minval=0.1, step=0.1, group=grpZ)
zoneTransp  = input.int(85, "Zone transparency", minval=0, maxval=100, group=grpZ)

grpR = "Reaction Tracking"
reactBars = input.int(5,   "Confirmation window (bars)", minval=1, group=grpR)
reactMult = input.float(0.5, "Move to confirm (ATR x)", minval=0.1, step=0.1, group=grpR)

grpM = "Cross Markers (secondary)"
showCrosses = input.bool(true, "Show EMA cross markers", group=grpM)

grpD = "Dashboard"
showDash  = input.bool(true, "Show dashboard", group=grpD)
dashPos   = input.string("top_right", "Position", options=["top_left","top_right","bottom_left","bottom_right"], group=grpD)
dashTheme = input.string("Dark", "Theme", options=["Dark","Light"], group=grpD)

// --------------------------- CORE ---------------------------
ema1 = ta.ema(close, len1)
ema2 = ta.ema(close, len2)
ema3 = ta.ema(close, len3)
ema4 = ta.ema(close, len4)
ema5 = ta.ema(close, len5)

atr  = ta.atr(atrLen)
half = atr * zoneMult

// -- EMA lines --
plot(ema1, "EMA 1", color=color.new(color.lime,   0), linewidth=1)
plot(ema2, "EMA 2", color=color.new(color.yellow, 0), linewidth=1)
plot(ema3, "EMA 3", color=color.new(color.aqua,   0), linewidth=2)
plot(ema4, "EMA 4", color=color.new(color.orange, 0), linewidth=2)
plot(ema5, "EMA 5", color=color.new(color.red,    0), linewidth=3)

// -- ATR-adaptive reaction zones (bands that breathe with volatility) --
f_zoneCol(src) => color.new(close >= src ? color.green : color.red, zoneTransp)
u1 = plot(showZones ? ema1 + half : na, "Zone 1 up", color=color.new(color.gray, 100))
d1 = plot(showZones ? ema1 - half : na, "Zone 1 dn", color=color.new(color.gray, 100))
u2 = plot(showZones ? ema2 + half : na, "Zone 2 up", color=color.new(color.gray, 100))
d2 = plot(showZones ? ema2 - half : na, "Zone 2 dn", color=color.new(color.gray, 100))
u3 = plot(showZones ? ema3 + half : na, "Zone 3 up", color=color.new(color.gray, 100))
d3 = plot(showZones ? ema3 - half : na, "Zone 3 dn", color=color.new(color.gray, 100))
u4 = plot(showZones ? ema4 + half : na, "Zone 4 up", color=color.new(color.gray, 100))
d4 = plot(showZones ? ema4 - half : na, "Zone 4 dn", color=color.new(color.gray, 100))
u5 = plot(showZones ? ema5 + half : na, "Zone 5 up", color=color.new(color.gray, 100))
d5 = plot(showZones ? ema5 - half : na, "Zone 5 dn", color=color.new(color.gray, 100))
fill(u1, d1, color=showZones ? f_zoneCol(ema1) : na)
fill(u2, d2, color=showZones ? f_zoneCol(ema2) : na)
fill(u3, d3, color=showZones ? f_zoneCol(ema3) : na)
fill(u4, d4, color=showZones ? f_zoneCol(ema4) : na)
fill(u5, d5, color=showZones ? f_zoneCol(ema5) : na)

// ------------------- STRUCTURE / EMA STACK (-4..+4) -------------------
f_pair(fast, slow) => fast > slow ? 1 : -1
score = f_pair(ema1, ema2) + f_pair(ema2, ema3) + f_pair(ema3, ema4) + f_pair(ema4, ema5)
stackState = score >= 3 ? "Bull Stack" : score <= -3 ? "Bear Stack" : "Mixed"
stackCol   = score >= 3 ? color.new(color.green, 0) : score <= -3 ? color.new(color.red, 0) : color.new(color.gray, 0)

// ------------------- ACTIVE ZONE (nearest EMA) -------------------
dd1 = math.abs(close - ema1)
dd2 = math.abs(close - ema2)
dd3 = math.abs(close - ema3)
dd4 = math.abs(close - ema4)
dd5 = math.abs(close - ema5)
mind = math.min(dd1, math.min(dd2, math.min(dd3, math.min(dd4, dd5))))
activeEma  = mind == dd1 ? ema1 : mind == dd2 ? ema2 : mind == dd3 ? ema3 : mind == dd4 ? ema4 : ema5
activeName = mind == dd1 ? "EMA " + str.tostring(len1) : mind == dd2 ? "EMA " + str.tostring(len2) : mind == dd3 ? "EMA " + str.tostring(len3) : mind == dd4 ? "EMA " + str.tostring(len4) : "EMA " + str.tostring(len5)
activeRole = close >= activeEma ? "Support" : "Resistance"
roleCol    = close >= activeEma ? color.new(color.green, 0) : color.new(color.red, 0)
distATR    = atr > 0 ? mind / atr : 0.0

// ------------------- REACTION TRACKING -------------------
inZone = low <= activeEma + half and high >= activeEma - half
var int    trkBar  = na
var float  trkEma  = na
var string trkRole = na
var string lastReaction    = "-"
var color  lastReactionCol = color.new(color.gray, 0)

newTouch = inZone and na(trkBar)
if newTouch
    trkBar  := bar_index
    trkEma  := activeEma
    trkRole := activeRole

reactionConfirmed = false
reactionBull = false
if not na(trkBar)
    if trkRole == "Support"
        if close >= trkEma + reactMult * atr
            reactionConfirmed := true
            reactionBull := true
        else if close < trkEma - half
            lastReaction := "Break down"
            lastReactionCol := color.new(color.red, 0)
            trkBar := na
    else
        if close <= trkEma - reactMult * atr
            reactionConfirmed := true
            reactionBull := false
        else if close > trkEma + half
            lastReaction := "Break up"
            lastReactionCol := color.new(color.green, 0)
            trkBar := na
    if reactionConfirmed
        lastReaction := reactionBull ? "Bounce up (" + activeName + ")" : "Bounce down (" + activeName + ")"
        lastReactionCol := reactionBull ? color.new(color.green, 0) : color.new(color.red, 0)
        trkBar := na
    else if not na(trkBar) and bar_index - trkBar > reactBars
        trkBar := na

// ------------------- CROSS MARKERS (secondary, optional) -------------------
gc = ta.crossover(ema3, ema5)
dc = ta.crossunder(ema3, ema5)
xu = ta.crossover(ema1, ema2)
xd = ta.crossunder(ema1, ema2)
plotshape(showCrosses and xu, "Fast cross up",   location=location.belowbar, color=color.new(color.lime, 20), style=shape.xcross,  size=size.tiny)
plotshape(showCrosses and xd, "Fast cross down",  location=location.abovebar, color=color.new(color.red, 20),  style=shape.xcross,  size=size.tiny)
plotshape(showCrosses and gc, "Golden cross",     location=location.belowbar, color=color.new(color.yellow, 0),style=shape.diamond, size=size.small)
plotshape(showCrosses and dc, "Death cross",      location=location.abovebar, color=color.new(color.maroon, 0),style=shape.diamond, size=size.small)

// ------------------- ALERTS -------------------
stackChanged = stackState != stackState[1]
alertcondition(newTouch,          "Reaction zone entered",  "Edo Reaction Zones - price entered a reaction zone on {{ticker}}")
alertcondition(reactionConfirmed, "Reaction confirmed",     "Edo Reaction Zones - a zone reaction was confirmed on {{ticker}}")
alertcondition(stackChanged,      "Stack structure change", "Edo Reaction Zones - EMA stack structure changed on {{ticker}}")

// ------------------- DASHBOARD (canonical panel) -------------------
pos = dashPos == "top_left" ? position.top_left : dashPos == "bottom_left" ? position.bottom_left : dashPos == "bottom_right" ? position.bottom_right : position.top_right
dark  = dashTheme == "Dark"
hdrBg = dark ? color.rgb(20, 20, 20)    : color.rgb(235, 235, 235)
hdrTx = dark ? color.white               : color.black
lblBg = dark ? color.rgb(40, 40, 40)     : color.rgb(215, 215, 215)
lblTx = dark ? color.rgb(210, 210, 210)  : color.rgb(25, 25, 25)
frmCol = dark ? color.rgb(54, 58, 69)    : color.rgb(178, 181, 190)
brdCol = dark ? color.rgb(67, 70, 81)    : color.rgb(200, 203, 218)

f_row(tbl, r, lbl, val, vcol) =>
    table.cell(tbl, 0, r, lbl, text_color=lblTx, bgcolor=lblBg, text_size=size.small)
    table.cell(tbl, 1, r, val, text_color=color.white, bgcolor=vcol, text_size=size.small)

var table dash = table.new(pos, 2, 6, frame_color=frmCol, frame_width=1, border_color=brdCol, border_width=1)
if showDash and barstate.islast
    table.clear(dash, 0, 0, 1, 5)
    table.cell(dash, 0, 0, "EDO REACTION ZONES", text_color=hdrTx, bgcolor=hdrBg, text_size=size.small)
    table.cell(dash, 1, 0, "", bgcolor=hdrBg)
    f_row(dash, 1, "Structure",   stackState, stackCol)
    f_row(dash, 2, "Alignment",   (score > 0 ? "+" : "") + str.tostring(score), stackCol)
    f_row(dash, 3, "Active zone", activeName + " - " + activeRole, roleCol)
    f_row(dash, 4, "Dist (ATR)",  str.tostring(distATR, "0.00") + "x", color.rgb(80, 80, 80))
    f_row(dash, 5, "Last react.", lastReaction, lastReactionCol)
