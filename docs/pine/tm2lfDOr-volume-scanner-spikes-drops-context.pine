//@version=5
indicator("Volume Scanner (Spikes & Drops) [Context]", overlay=true)

// === Настройки ===
length         = input.int(20, "Период объема (N баров)", minval=1)
thresholdUp    = input.float(1.5, "Порог роста объема (x раз)", minval=0.1)
thresholdDn    = input.float(0.5, "Порог падения объема (x раз)", minval=0.01)
showBG         = input.bool(true, "Фоновая подсветка")
useContext     = input.bool(true, "Учитывать контекст (локальные экстремумы)")
contextLookback = input.int(10, "Контекст: период для локального high/low", minval=1)
minGap         = input.int(20, "Мин. расстояние между сигналами (в барах)", minval=1)

// === Переменные ===
var int lastSignalUp  = na
var int lastSignalDn  = na

// === Логика объема ===
volMA       = ta.sma(volume, length)
volSpikeUp  = volume > volMA * thresholdUp
volDropDown = volume < volMA * thresholdDn

// === Контекст цены ===
contextUp   = not useContext or high >= ta.highest(high, contextLookback)
contextDown = not useContext or low  <= ta.lowest(low,  contextLookback)

// === Условия сигнала ===
canShowUp   = volSpikeUp and contextUp   and (na(lastSignalUp) or bar_index - lastSignalUp > minGap)
canShowDown = volDropDown and contextDown and (na(lastSignalDn) or bar_index - lastSignalDn > minGap)

// === Подсветка фоном ===
color bgColorUp = na
color bgColorDn = na

if showBG
    if canShowUp
        bgColorUp := color.new(color.green, 85)
    if canShowDown
        bgColorDn := color.new(color.red, 85)

bgcolor(bgColorUp)
bgcolor(bgColorDn)

// === Обновление последних сигналов ===
if canShowUp
    lastSignalUp := bar_index

if canShowDown
    lastSignalDn := bar_index
