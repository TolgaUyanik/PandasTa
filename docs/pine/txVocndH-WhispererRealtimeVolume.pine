// Modified by andre_007 to create a library for use in other scripts.
// It is a simplified version of the original script, with the volume calculation extracted into a function for better reusability.

//@version=6
library("WhispererRealtimeVolume")

// @function mw_upDownVolumeRealtime
// @description Calculates the up volume, down volume, and neutral volume in real-time based on the closing price and volume of the current bar.
// @param useNeutralVolume (bool) - If true, neutral volume is included in the calculation. Default is false.
// @returns (float, float, float) - Returns the up volume, down volume, and neutral volume as a tuple.
export mw_upDownVolumeRealtime(bool useNeutralVolume=false) =>
    
    varip float mw_volUp = 0.
    varip float mw_volDn = 0.
    varip float mw_volNt = 0.
    varip float mw_prevClose = na
    varip float mw_prevVolume = na
    varip int mw_prevPolarity = 0
    
    if barstate.isnew
        mw_volUp := 0.
        mw_volDn := 0.
        mw_volNt := 0.
        mw_prevClose := nz(close[1])
        mw_prevVolume := 0.
        mw_prevPolarity := nz(mw_prevPolarity[1])
    
    mw_newVolume = volume - nz(mw_prevVolume)
    
    if close > mw_prevClose
        mw_prevPolarity := 1
        mw_volUp := mw_volUp + mw_newVolume
    else if close < mw_prevClose
        mw_prevPolarity := -1
        mw_volDn := mw_volDn + mw_newVolume
    else
        if (not useNeutralVolume)
            if mw_prevPolarity == 1
                mw_volUp := mw_volUp + mw_newVolume
            else if mw_prevPolarity == -1
                mw_volDn := mw_volDn + mw_newVolume
            else
                mw_volNt := mw_volNt + mw_newVolume
        else
            mw_volNt := mw_volNt + mw_newVolume
    
    mw_prevClose := close
    mw_prevVolume := volume
    
    [mw_volUp, mw_volDn, mw_volNt]

export displayStartLine(color startLineColor, int startLineWidth, string startLineStyle, bool displayStartLine, float y1, float y2) =>
    var bool firstBar = true

    if barstate.isrealtime and firstBar and displayStartLine
        line.new(bar_index, y1, bar_index, y2, extend = extend.right, color = startLineColor, width = startLineWidth, style = startLineStyle)    
        firstBar := false

