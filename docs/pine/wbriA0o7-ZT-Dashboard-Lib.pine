//@version=5
// v2.2 (2026-05-28): library title renamed AFZT_Dashboard_v2 → AFZT_Dashboard_Lib →
// "ZT_Dashboard_Lib" — TV content-fingerprints any republish under the banned AFZT_
// namespace. Dropping the AFZT_ prefix to "ZT_" mirrors KLP's net-new naming. No
// functional change; renderFlow/renderOps signatures unchanged.
library("ZT_Dashboard_Lib", overlay=false)

// ─── Internal cell helpers ───────────────────────────────────────────────────
_dK(table t, int r, string k, string sz, color tc, color bk) =>
    table.cell(t, 0, r, k, text_color=tc, bgcolor=bk, text_size=sz, text_halign=text.align_left)

_dV(table t, int r, string v, string sz, color vc, color bv) =>
    table.cell(t, 1, r, v, text_color=vc, bgcolor=bv, text_size=sz, text_halign=text.align_left)

_dR(table t, int r, string k, string v, string sz, color tc, color bk, color vc, color bv) =>
    _dK(t, r, k, sz, tc, bk), _dV(t, r, v, sz, vc, bv)

_dH(table t, int r, string k, string v, string sz, color tg, color bh) =>
    table.cell(t, 0, r, k, text_color=tg, bgcolor=bh, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=tg, bgcolor=bh, text_size=sz, text_halign=text.align_right)

_dHV(table t, int r, string k, string v, string sz, color tg, color bh, color vc) =>
    table.cell(t, 0, r, k, text_color=tg, bgcolor=bh, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, bgcolor=bh, text_size=sz, text_halign=text.align_right)

_dS(table t, int r, string k, string sz, color tg, color bh) =>
    table.cell(t, 0, r, k, text_color=tg, bgcolor=bh, text_size=sz, text_halign=text.align_left)
    table.cell(t, 1, r, "───", text_color=color.new(tg, 60), bgcolor=bh, text_size=sz)

// ─── FLOW tab ────────────────────────────────────────────────────────────────
export renderFlow(
     table   t,          string  sz,
     color   bh,         color   bk,         color   bv,    color  tc,  color  tg,
     int     tradeState, int     gradeCode,   int     zoneCode,  int  zoneTFCode,
     int     touchCount, int     zoneAgeBars,
     float   entry,      float   stop,
     bool    showTPs,    float   tp1,  float  tp2,  float  tp3, float tp4, float tp5,
     int     tpMask,
     float   unrealR,    int     dec,
     bool    showStats,  float   winPct,  int wins,  int losses, int be,
     int     minTrades,  float   expR,
     bool    showIchi,   int     pvc,    int   cb,
     bool    bullActive, bool    bearActive,
     int     bullPvc,    int     bullCb,  int  bearPvc,  int bearCb,
     bool    showRec,    int     recMinN,  int  volReg,
     array<int>   lrN,   array<float> lrSumR,
     bool    showPack,   string  bullPackLog,  string  bearPackLog,
     string  packMeta ) =>

    // ── Header ──
    string _ss = tradeState==1?"▲ LONG":tradeState==-1?"▼ SHORT":"── FLAT"
    color  _sc = tradeState==1?color.new(color.teal,10):tradeState==-1?color.new(color.red,10):color.new(color.gray,40)
    _dHV(t,0,"ALPHA FLOW",_ss,sz,tg,bh,_sc)

    // ── Grade ──
    int    _gc = gradeCode
    string _gr = _gc==5?"Very Strong":_gc==4?"Strong":_gc==3?"Moderate":_gc==2?"Weak":_gc==1?"Very Weak":"—"
    color  _gC = _gc>=4?color.new(color.teal,10):_gc==3?color.new(color.orange,10):color.new(color.red,20)
    _dR(t,1,"Grade",_gr,sz,tc,bk,_gC,bv)

    // ── Zone ──
    string _zs = zoneCode==1?"DZ1":zoneCode==2?"SZ1":zoneCode==3?"Auto-D":zoneCode==4?"Auto-S":"—"
    string _ts = zoneTFCode==1?"1m":zoneTFCode==2?"3m":zoneTFCode==3?"5m":zoneTFCode==4?"15m":zoneTFCode==5?"30m":zoneTFCode==6?"1H":zoneTFCode==7?"4H":zoneTFCode==8?"D":zoneTFCode==9?"W":"—"
    _dR(t,2,"Zone",_zs+" "+_ts,sz,tc,bk,tg,bv)
    _dR(t,3,"Touch / Age",str.tostring(touchCount)+" / "+str.tostring(zoneAgeBars)+"b",sz,tc,bk,tg,bv)

    // ── Entry / Stop ──
    color  _xc = tradeState!=0?color.new(color.red,10):tc
    _dR(t,4,"Entry",not na(entry)?str.tostring(entry,"#.##"):"—",sz,tc,bk,tg,bv)
    _dR(t,5,"Stop", not na(stop) ?str.tostring(stop, "#.##"):"—",sz,tc,bk,_xc,bv)

    // ── TPs ──
    int _r = 6
    if showTPs
        bool _h1=tpMask%2>=1, _h2=math.floor(tpMask/2)%2>=1, _h3=math.floor(tpMask/4)%2>=1
        bool _h4=math.floor(tpMask/8)%2>=1, _h5=math.floor(tpMask/16)%2>=1
        color _hC = color.new(color.teal,10)
        string _t1=not na(tp1)?str.tostring(tp1,"#.##"):"—"
        string _t2=not na(tp2)?str.tostring(tp2,"#.##"):"—"
        string _t3=not na(tp3)?str.tostring(tp3,"#.##"):"—"
        string _t4=not na(tp4)?str.tostring(tp4,"#.##"):"—"
        string _t5=not na(tp5)?str.tostring(tp5,"#.##"):"—"
        _dR(t,_r,  "TP1",_h1?"✓ "+_t1:_t1,sz,tc,bk,_h1?_hC:tg,bv)
        _dR(t,_r+1,"TP2",_h2?"✓ "+_t2:_t2,sz,tc,bk,_h2?_hC:tg,bv)
        _dR(t,_r+2,"TP3",_h3?"✓ "+_t3:_t3,sz,tc,bk,_h3?_hC:tg,bv)
        _dR(t,_r+3,"TP4",_h4?"✓ "+_t4:_t4,sz,tc,bk,_h4?_hC:tg,bv)
        _dR(t,_r+4,"TP5",_h5?"✓ "+_t5:_t5,sz,tc,bk,_h5?_hC:tg,bv)
        _r := _r + 5

    // ── Unrealized R ──
    color  _uc = not na(unrealR)?(unrealR>0?color.new(color.teal,10):unrealR<0?color.new(color.red,10):tg):tc
    _dR(t,_r,"Unreal R",not na(unrealR)?str.tostring(math.round(unrealR,dec))+"R":"—",sz,tc,bk,_uc,bv)
    _r := _r + 1

    // ── Stats ──
    if showStats
        _dS(t,_r,"Stats",sz,tg,bh)
        _r := _r + 1
        string _ws = not na(winPct)?str.tostring(math.round(winPct*100,0))+"% ("+str.tostring(wins)+"W "+str.tostring(losses)+"L "+str.tostring(be)+"B)":"< "+str.tostring(minTrades)+" trades"
        _dR(t,_r,  "Win%", _ws,sz,tc,bk,tg,bv)
        _dR(t,_r+1,"Exp R",not na(expR)?str.tostring(math.round(expR,dec))+"R":"—",sz,tc,bk,tg,bv)
        _r := _r + 2

    // ── Ichimoku ──
    if showIchi
        _dS(t,_r,"Ichimoku",sz,tg,bh)
        _r := _r + 1
        bool   _inT  = bullActive or bearActive
        int    _pvc2 = _inT?(bullActive?bullPvc:bearPvc):pvc
        int    _cb2  = _inT?(bullActive?bullCb:bearCb):cb
        color  _cbC  = _cb2==1?color.new(color.teal,20):_cb2==-1?color.new(color.red,20):color.new(color.gray,40)
        color  _pvC  = _pvc2==1?color.new(color.teal,20):_pvc2==-1?color.new(color.red,20):color.new(color.orange,20)
        bool   _bA   = _cb2==1 and _pvc2==1, _beA = _cb2==-1 and _pvc2==-1
        color  _aC   = _bA?color.new(color.teal,10):_beA?color.new(color.red,10):color.new(color.gray,50)
        _dR(t,_r,  "Cloud Bias",    _cb2==1?"Bull":_cb2==-1?"Bear":"Neutral",  sz,tc,bk,_cbC,bv)
        _dR(t,_r+1,"Price vs Cloud",_pvc2==1?"Above":_pvc2==-1?"Below":"Inside",sz,tc,bk,_pvC,bv)
        _dR(t,_r+2,"Alignment",     _bA?"✓ Bull":_beA?"✓ Bear":"—",           sz,tc,bk,_aC,bv)
        _dR(t,_r+3,"Mode",          _inT?"@ Entry":"Live",                      sz,tc,bk,tg,bv)
    _r := _r + 4

    // ── Local Rec ──
    if showRec
        int   _cL=(volReg*2+((pvc==1  and cb==1) ?1:0))*9
        int   _cS=(6+volReg*2+((pvc==-1 and cb==-1)?1:0))*9
        int   _pL=-1,_pS=-1,_nL=0,_nS=0
        float _rL=-9.9e9,_rS=-9.9e9
        for _ri=0 to 8
            int   _nLi=array.get(lrN,_cL+_ri), _nSi=array.get(lrN,_cS+_ri)
            if _nLi>=recMinN
                float _a=array.get(lrSumR,_cL+_ri)/_nLi
                if _a>_rL
                    _rL:=_a,_pL:=_ri,_nL:=_nLi
            if _nSi>=recMinN
                float _a=array.get(lrSumR,_cS+_ri)/_nSi
                if _a>_rS
                    _rS:=_a,_pS:=_ri,_nS:=_nSi
        string _rLS=_pL<0?"—":"S"+str.tostring(_pL/3+1)+"/BE"+str.tostring(_pL%3)+"  "+str.tostring(math.round(_rL,2))+"R n="+str.tostring(_nL)
        string _rSS=_pS<0?"—":"S"+str.tostring(_pS/3+1)+"/BE"+str.tostring(_pS%3)+"  "+str.tostring(math.round(_rS,2))+"R n="+str.tostring(_nS)
        color _rcL=_pL>=0?(_rL>0?color.new(color.teal,10):color.new(color.red,20)):color.new(color.gray,50)
        color _rcS=_pS>=0?(_rS>0?color.new(color.teal,10):color.new(color.red,20)):color.new(color.gray,50)
        table.cell(t,0,_r,"Cloud Rec",   text_color=tg,bgcolor=bh,text_size=sz,text_halign=text.align_left)
        table.cell(t,1,_r,"Local(Chart)",text_color=color.new(tg,40),bgcolor=bh,text_size=sz,text_halign=text.align_right)
        _dR(t,_r+1,"L Rec",_rLS,sz,tc,bk,_rcL,bv)
        _dR(t,_r+2,"S Rec",_rSS,sz,tc,bk,_rcS,bv)
        _r := _r + 3

    // ── TV Pack row (Phase G-TV) ──
    if showPack
        string _pt = bullActive?bullPackLog:bearActive?bearPackLog:"—"
        color  _pc = str.contains(_pt,"TV PACK: P")?color.new(color.teal,10):str.contains(_pt,"fallback")?color.new(color.orange,20):color.new(color.gray,50)
        _dS(t,_r,"TV Pack",sz,tg,bh)
        _dR(t,_r+1,"Status", _pt,                                   sz,tc,bk,_pc,bv)
        _dR(t,_r+2,"Version",packMeta != "—" ? packMeta : "pending",sz,tc,bk,tg, bv)

// ─── OPS tab ─────────────────────────────────────────────────────────────────
export renderOps(
     table  t,          string  sz,
     color  bh,         color   bk,    color  bv,  color  tc,  color  tg,
     bool   bullActive, bool    bearActive,
     bool   flowL,      bool    flowS,
     int    volReg,
     bool   dz1En,      bool    dz1Br, bool   sz1En, bool  sz1Br,
     int    tradeState, string  bullSetup,  string  bearSetup,
     float  confidence, int     zoneCode,
     float  lastR,      int     lastOut,    int     dec ) =>

    _dH(t,0,"ALPHA FLOW","OPS",sz,tg,bh)
    _dS(t,1,"ENGINE STATE",sz,tg,bh)
    string _ms=bullActive?"LONG Active":bearActive?"SHORT Active":flowL?"Flow Ready L":flowS?"Flow Ready S":"Scanning"
    color  _mc=bullActive?color.new(color.teal,10):bearActive?color.new(color.red,10):flowL or flowS?color.new(color.orange,20):tc
    color  _vc=volReg==2?color.new(color.orange,20):volReg==0?color.new(color.gray,30):color.new(color.teal,30)
    _dR(t,2,"Mode",      _ms,sz,tc,bk,_mc,bv)
    _dR(t,3,"Vol Regime",volReg==2?"High Vol":volReg==0?"Low Vol":"Normal",sz,tc,bk,_vc,bv)
    _dR(t,4,"Zones",     (dz1En and not dz1Br?"DZ1 ✓":dz1En?"DZ1 ✗":"—")+" / "+(sz1En and not sz1Br?"SZ1 ✓":sz1En?"SZ1 ✗":"—"),sz,tc,bk,tg,bv)
    _dR(t,5,"Last Bar",  str.tostring(bar_index),sz,tc,bk,tg,bv)
    _dS(t,6,"TICK HEALTH",sz,tg,bh)
    _dR(t,7, "State",    "Realtime",sz,tc,bk,color.new(color.teal,20),bv)
    _dR(t,8, "Coverage", "—",sz,tc,bk,tg,bv)
    _dR(t,9, "Feed Gap", "—",sz,tc,bk,tg,bv)
    _dR(t,10,"Status",   "OK",sz,tc,bk,color.new(color.teal,20),bv)
    _dS(t,11,"SIGNAL STATUS",sz,tg,bh)
    string _ls=tradeState==1?(na(bullSetup)?"—":bullSetup):tradeState==-1?(na(bearSetup)?"—":bearSetup):(na(bullSetup) and na(bearSetup)?"—":na(bullSetup)?bearSetup:bullSetup)
    string _cf=not na(confidence)?str.tostring(math.round(confidence*100,0))+"%":"—"
    string _zc=zoneCode==1?"DZ1":zoneCode==2?"SZ1":zoneCode==3?"Auto-D":zoneCode==4?"Auto-S":"—"
    _dR(t,12,"Last Setup",str.length(_ls)>20?str.substring(_ls,0,20)+"…":_ls,sz,tc,bk,tg,bv)
    _dR(t,13,"Confidence",_cf,sz,tc,bk,tg,bv)
    _dR(t,14,"Zone",      _zc,sz,tc,bk,tg,bv)
    _dS(t,15,"LAST TRADE",sz,tg,bh)
    color  _lc=not na(lastR)?(lastR>0?color.new(color.teal,10):color.new(color.red,10)):tc
    string _lo=lastOut==1?"Win":lastOut==-1?"Loss":lastOut==0 and not na(lastR)?"BE":"—"
    _dR(t,16,"Result", not na(lastR)?str.tostring(math.round(lastR,dec))+"R":"—",sz,tc,bk,_lc,bv)
    _dR(t,17,"Outcome",_lo,sz,tc,bk,_lc,bv)
