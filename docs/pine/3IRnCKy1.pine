//@version=6
// ═══════════════════════════════════════════════════════════════════
// Smart Money Confluence Suite — EQH/EQL, Order Blocks, FVG & Sweeps
// ───────────────────────────────────────────────────────────────────
// Multi-timeframe Smart Money Concepts toolkit that combines:
//   • Equal Highs / Equal Lows (EQH/EQL) detection on 4H and Daily
//     timeframes, with automatic mitigation when price trades through
//     a level.
//   • Fair Value Gap (FVG) zones, plotted automatically on 3-bar
//     imbalances.
//   • Order Block (OB) detection for the last bullish/bearish
//     candle preceding a break of structure, with auto-invalidation
//     once price closes through the block.
//   • Liquidity sweep detection (candle coloring) based on swing
//     high/low pivots.
// Designed for discretionary and semi-systematic traders applying
// liquidity- and structure-based confluence to futures and index
// markets (e.g. Russell 2000, Nasdaq, ES/MES/MNQ).
// ═══════════════════════════════════════════════════════════════════
indicator("Smart Money Confluence Suite [EQH/EQL, OB/FVG, Sweeps]", shorttitle="SMC Confluence Suite", overlay=true, max_lines_count=500, max_boxes_count=200, max_labels_count=500)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1. INPUTS DE CONFIGURACIÓN
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
groupEQ = "EQH/EQL Multi-TF Real"
showEQH_4H = input.bool(true, "Mostrar EQH 4H", group=groupEQ)
showEQL_4H = input.bool(true, "Mostrar EQL 4H", group=groupEQ)
showEQH_D  = input.bool(true, "Mostrar EQH Daily", group=groupEQ)
showEQL_D  = input.bool(true, "Mostrar EQL Daily", group=groupEQ)
eqTolerance = input.float(0.0008, "Tolerancia EQ", step=0.0001, group=groupEQ)
mitigateALL = input.bool(true, "Mitigación Automática Total", group=groupEQ)

groupCol = "Colores y Estética EQ"
colorEQH = input.color(color.red, "Color EQH (Altos)", group=groupCol)
colorEQL = input.color(color.green, "Color EQL (Bajos)", group=groupCol)
widthEQ  = input.int(2, "Grosor Líneas", minval=1, group=groupCol)

groupFVG = "Zonas OB & FVG"
bullFVG_col = input.color(color.new(color.teal, 85), "FVG Alcista", group=groupFVG)
bearFVG_col = input.color(color.new(color.orange, 85), "FVG Bajista", group=groupFVG)
bullOB_col  = input.color(color.new(color.green, 80), "OB Alcista", group=groupFVG)
bearOB_col  = input.color(color.new(color.red, 80), "OB Bajista", group=groupFVG)

groupSweep = "Liquidity Sweep"
showSweep = input.bool(true, "Mostrar Sweeps (Color Vela)", group=groupSweep)
swingLen  = input.int(5, "Fuerza del Swing", minval=3, group=groupSweep)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2. LÓGICA DE DETECCIÓN (MTF REAL)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_checkEQH() => math.abs(high - high[1]) <= (high * 0.0008)
f_checkEQL() => math.abs(low - low[1]) <= (low * 0.0008)

isEQH_4H = request.security(syminfo.tickerid, "240", f_checkEQH())
valEQH_4H = request.security(syminfo.tickerid, "240", high)
isEQL_4H = request.security(syminfo.tickerid, "240", f_checkEQL())
valEQL_4H = request.security(syminfo.tickerid, "240", low)

isEQH_D = request.security(syminfo.tickerid, "D", f_checkEQH())
valEQH_D = request.security(syminfo.tickerid, "D", high)
isEQL_D = request.security(syminfo.tickerid, "D", f_checkEQL())
valEQL_D = request.security(syminfo.tickerid, "D", low)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3. DIBUJO DE NIVELES
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var line l4H_H = na, var label lb4H_H = na
var line l4H_L = na, var label lb4H_L = na
var line lD_H  = na, var label lbD_H  = na
var line lD_L  = na, var label lbD_L  = na

if showEQH_4H and isEQH_4H
    line.delete(l4H_H), label.delete(lb4H_H)
    l4H_H := line.new(bar_index-10, valEQH_4H, bar_index, valEQH_4H, color=colorEQH, width=widthEQ, extend=extend.right)
    lb4H_H := label.new(bar_index, valEQH_4H, "EQH 4H", textcolor=colorEQH, style=label.style_label_down, color=color.new(color.white,100), size=size.small)

if showEQL_4H and isEQL_4H
    line.delete(l4H_L), label.delete(lb4H_L)
    l4H_L := line.new(bar_index-10, valEQL_4H, bar_index, valEQL_4H, color=colorEQL, width=widthEQ, extend=extend.right)
    lb4H_L := label.new(bar_index, valEQL_4H, "EQL 4H", textcolor=colorEQL, style=label.style_label_up, color=color.new(color.white,100), size=size.small)

if showEQH_D and isEQH_D
    line.delete(lD_H), label.delete(lbD_H)
    lD_H := line.new(bar_index-10, valEQH_D, bar_index, valEQH_D, color=colorEQH, width=widthEQ+1, extend=extend.right)
    lbD_H := label.new(bar_index, valEQH_D, "EQH Daily", textcolor=colorEQH, style=label.style_label_down, color=color.new(color.white,100), size=size.small)

if showEQL_D and isEQL_D
    line.delete(lD_L), label.delete(lbD_L)
    lD_L := line.new(bar_index-10, valEQL_D, bar_index, valEQL_D, color=colorEQL, width=widthEQ+1, extend=extend.right)
    lbD_L := label.new(bar_index, valEQL_D, "EQL Daily", textcolor=colorEQL, style=label.style_label_up, color=color.new(color.white,100), size=size.small)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4. SWEEPS, ZONAS Y MITIGACIÓN
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
swh = ta.pivothigh(high, swingLen, swingLen)
swl = ta.pivotlow(low, swingLen, swingLen)
var float lastH = na
var float lastL = na

if not na(swh)
    lastH := swh
if not na(swl)
    lastL := swl

bullSweep = showSweep and not na(lastL) and low < lastL and close > lastL
bearSweep = showSweep and not na(lastH) and high > lastH and close < lastH
barcolor(bullSweep ? color.lime : bearSweep ? color.orange : na)

var box[] bOB = array.new_box()
var box[] sOB = array.new_box()

if low > high[2]
    box.new(bar_index-2, high[2], bar_index, low, bgcolor=bullFVG_col, border_color=na)
if high < low[2]
    box.new(bar_index-2, high, bar_index, low[2], bgcolor=bearFVG_col, border_color=na)

if close > open and close[1] < open[1] and high > high[1]
    array.push(bOB, box.new(bar_index-1, high[1], bar_index, low[1], bgcolor=bullOB_col, border_color=bullOB_col, extend=extend.right))
if close < open and close[1] > open[1] and low < low[1]
    array.push(sOB, box.new(bar_index-1, high[1], bar_index, low[1], bgcolor=bearOB_col, border_color=bearOB_col, extend=extend.right))

if mitigateALL
    if not na(l4H_H) and high > line.get_y1(l4H_H)
        line.delete(l4H_H), label.delete(lb4H_H), l4H_H := na
    if not na(l4H_L) and low < line.get_y1(l4H_L)
        line.delete(l4H_L), label.delete(lb4H_L), l4H_L := na
    if not na(lD_H) and high > line.get_y1(lD_H)
        line.delete(lD_H), label.delete(lbD_H), lD_H := na
    if not na(lD_L) and low < line.get_y1(lD_L)
        line.delete(lD_L), label.delete(lbD_L), lD_L := na

    if array.size(bOB) > 0
        for i = array.size(bOB) - 1 to 0
            b = array.get(bOB, i)
            if close < box.get_bottom(b)
                box.delete(b), array.remove(bOB, i)
            else
                box.set_right(b, bar_index)
    if array.size(sOB) > 0
        for i = array.size(sOB) - 1 to 0
            b = array.get(sOB, i)
            if close > box.get_top(b)
                box.delete(b), array.remove(sOB, i)
            else
                box.set_right(b, bar_index)
