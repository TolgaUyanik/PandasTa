//@version=6

// @description Helper functions for trading sessions. TradingView doesn't provide correct data when 
// calling some of the convenience methods like session.ismarket when you are looking at futures charts. 
// This library corrects those mistakes by providing functions with the same names as the TradingView defaults 
// That reference a custom defined set of session hours for futures. It also provides a way for consumers to 
// customize the map values by calling getSessionMap() and then overwriting (or adding) custom session 
// definitions.
library("Session", overlay=true)

import jmosullivan/Table/1

// Helper functions first

parseHm(hhmm) =>
    h = int(str.tonumber(str.substring(hhmm, 0, 2)))
    m = int(str.tonumber(str.substring(hhmm, 2, 4)))
    [h, m]

// Helper: Returns true if the *current bar* ends exactly at the end of the
// active "market" session segment defined by sessionString (today).
sessionBarEndsAtSegmentEnd(string sessionString) =>
    if str.length(sessionString) == 0
        false
    else
        parts     = str.split(sessionString, ":")
        rangesStr = array.get(parts, 0)
        ranges    = str.split(rangesStr, ",")

        // safer: cast to int to avoid type surprises in arithmetic later
        barMs    = int(timeframe.in_seconds(timeframe.period)) * 1000
        barEndTs = time + barMs

        foundLast = false

        for i = 0 to array.size(ranges) - 1
            seg      = array.get(ranges, i)         // "0900-1130"
            segParts = str.split(seg, "-")
            segStart = array.get(segParts, 0)
            segEnd   = array.get(segParts, 1)

            [sh, sm] = parseHm(segStart)
            [eh, em] = parseHm(segEnd)

            // These are already series int in exchange tz
            y = year, mth = month, d = dayofmonth

            segStartTs = timestamp(syminfo.timezone, y, mth, d, sh, sm)
            segEndTs   = timestamp(syminfo.timezone, y, mth, d, eh, em)

            inThisSeg  = time >= segStartTs and time < segEndTs
            if inThisSeg
                foundLast := barEndTs == segEndTs
                break

        foundLast

// @function Returns a map of the futures rth & eth session hours. The map is keyed with symbol:session format (eg. ES:market or ES:overnight).
// @returns A map of futures symbols and their associated session hours. 
export getSessionMap() =>
	map<string, string> symbols = map.new<string, string>()
    // Group the futures symbols that have the same hours
	rth = '0900-1730:123456'
	eth = '1730-0900:123456'
	symbols.put('FESX:market', rth)
	symbols.put('FESX:overnight', eth)
