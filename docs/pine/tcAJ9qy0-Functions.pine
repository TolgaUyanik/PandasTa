// @description: Nothing special. Just some functions I like to use...
library("Functions")


// @function Half Candles
// @returns half candles (difference between open and close)
export half_candle() =>
    half_candle = open + ((close - open) / 2)
    half_candle
//

// @function Ehlers Super Smoother
// @param source Source
// @returns super smoothed moving average
export super_smoother(float source, int len) =>
	var PIxSQRT2 = math.pi * math.sqrt(2)
    a1 = math.exp(-PIxSQRT2 / len)
    c3 = -a1 * a1
    c2 = 2 * a1 * math.cos(PIxSQRT2 / len)
    c1 = 1 - c2 - c3
    ss = 0.0
    ss := c1 * (source + nz(source[1])) / 2 + c2 * nz(ss[1]) + c3 * nz(ss[2])
    ss
//

// @function Ehlers early onset trend
// @param length Length (default = 1)
// @param K Factor (default = 0.8)
// @returns Ehlers early onset trend
export quotient(int length = 1, float K = 0.8)=>
    PI = 2 * math.pi
    angle = 0.707 * 2 * PI / 100
    alpha1 = (math.cos(angle) + math.sin(angle) - 1) / math.cos(angle)
    a1 = math.exp(-1.414 * PI / length)
    b1 = 2 * a1 * math.cos( 1.414 * PI / length)
    c2 = b1
    c3 = -a1 * a1
    c1 = 1 - c2 - c3
    HP = 0.00
    Filt = 0.00
    Pk = 0.00
    HP:= math.pow((1-alpha1/2),2) * (close - (2*close[1]) + close[2]) + 2 * (1-alpha1)*nz(HP[1]) - math.pow((1-alpha1),2) * nz(HP[2])
    Filt:= c1 * (HP + nz(HP[1]))/2 + c2*nz(Filt[1]) + c3*nz(Filt[2])
    Pk:= math.abs(Filt) > 0.991 *nz(Pk[1]) ? math.abs(Filt) : 0.991 * nz(Pk[1])
    X = nz(Filt / Pk)   
    q = (X + K) / (K * X + 1) 
    q
//

// @function Ehlers 2 Pole Butterworth Filter
// @param length Length
// @param src Source
// @returns Ehlers 2 Pole Butterworth Filter
export butterworth_2Pole(float src, int length) =>
    a = math.exp(-math.sqrt(2) * math.pi / length)
    b = 2 * a * math.cos(math.sqrt(2) * math.pi / length)
    bf = 0.0
    bf := b * nz(bf[1]) - math.pow(a, 2) * nz(bf[2]) + ((1 - b + math.pow(a, 2)) / 4) * (src + 2 * nz(src[1]) + nz(src[2]))
    bf
//

// @function Ehler's Hann Moving Average
// @param length Length
// @param src Source
// @returns Ehler's Hann Moving Average
export hann_ma(float src, int length) =>
    hann = 0.0
    coef = 0.0
    for i = 1 to length by 1
        cosine = 1 - math.cos(2 * math.pi * i / (length + 1))
        hann += cosine * nz(src[i - 1])
        coef += cosine
    hann := coef != 0 ? hann / coef : 0
    hann
//

// @function Ehlers Optimum Elliptic Filter
// @param src Source
// @returns Ehlers Optimum Elliptic Filter
export oef(float src) =>
    float oef = 0.0
    oef := 0.13785 * src + 0.0007 * nz(src[1]) + 0.13785 * nz(src[2]) + 1.2103 * nz(oef[1]) - 0.4867 * nz(oef[2])
    oef
//

// @function Ehlers Modified Optimum Elliptic Filter
// @param src Source
// @returns Ehlers Modified Optimum Elliptic Filter
export moef(float src) =>
    src1 = nz(src[1], src)
    src2 = nz(src[2], src1)
    src3 = nz(src[3], src2)

    moef = src
    moef := 0.13785 * (2 * src - src1) + 0.0007 * (2 * src1 - src2) + 0.13785 * (2 * src2 - src3) + 1.2103 * nz(moef[1], moef) - 0.4867 * nz(moef[2], moef)
    moef
//

// @function Advanced RSI
// @param src Source
// @param length Length (default = 14)
// @returns ARSI
export arsi(float src, int length = 14) =>
    upper = ta.highest(src, length)
    lower = ta.lowest(src, length)
    r = upper - lower
    d = src - src[1]
    diff = upper > upper[1] ? r : lower < lower[1] ? -r : d
    num = ta.rma(diff, length)
    den = ta.rma(math.abs(diff), length)
    arsi = num / den * 50 + 50
    arsi
//

// @function Smooth Range
// @param src Source
// @param length Length
// @param multi Multiplikator (default 3.0)
// @returns Smooth Range
export smoothrng(float src, int length, float multi) =>
    wper = length * 2 - 1
    avrng = ta.rma(math.abs(src - src[1]), length)
    smoothrng = ta.rma(avrng, wper) * multi
    smoothrng
//

// @function Donchian Channel incl. switch (as used in Turtle Trade Channels)
// @param length Length
// @returns upper, average, lower, dc_switch
export donchian(int length) =>
    upper = ta.highest(high, length)
    lower = ta.lowest(low, length)
    basis = math.avg(upper, lower)
    dc_switch = ta.barssince(high>=upper[1])<=ta.barssince(low<=lower[1]) ? lower : upper
    [upper, basis, lower, dc_switch]
//




