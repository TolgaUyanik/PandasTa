//@version=5
strategy("TrenchWrld BB + RSI Live Radar Strategy", shorttitle="TW BB RSI RADAR", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.06, pyramiding=0, calc_on_every_tick=true, process_orders_on_close=false)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bbLength = input.int(20, "Bollinger Band Length", minval=1)
bbMult = input.float(2.0, "Bollinger Band Multiplier", step=0.1)

rsiLength = input.int(14, "RSI Length", minval=1)
rsiOversold = input.float(30.0, "RSI Oversold Level", step=0.5)
rsiOverbought = input.float(70.0, "RSI Overbought Level", step=0.5)

tradeMode = input.string("Both", "Trade Mode", options=["Long Only", "Short Only", "Both"])
entryStyle = input.string("Reclaim Band", "Entry Style", options=["Touch Band", "Reclaim Band"])

takeProfitPct = input.float(3.0, "Take Profit %", step=0.1, minval=0.1)
stopLossPct = input.float(1.5, "Stop Loss %", step=0.1, minval=0.1)

useTrendFilter = input.bool(true, "Use 200 EMA Trend Filter")
emaLength = input.int(200, "EMA Length", minval=1)

showBands = input.bool(true, "Show Bollinger Bands")
showEMA = input.bool(true, "Show EMA")
showTradeLines = input.bool(true, "Show TP/SL Lines")
showConfirmedSignals = input.bool(true, "Show Confirmed Entry Signals")
showLiveWatchSignals = input.bool(true, "Show Live Watch Signals")
showRadar = input.bool(true, "Show Live Setup Radar")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CALCULATIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

basis = ta.sma(close, bbLength)
dev = bbMult * ta.stdev(close, bbLength)

upperBand = basis + dev
lowerBand = basis - dev

rsi = ta.rsi(close, rsiLength)
ema = ta.ema(close, emaLength)

bandRange = upperBand - lowerBand
bandPosition = bandRange != 0 ? ((close - lowerBand) / bandRange) * 100 : 50

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TREND FILTER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullTrend = close > ema
bearTrend = close < ema

longTrendAllowed = not useTrendFilter or bullTrend
shortTrendAllowed = not useTrendFilter or bearTrend

allowLong = tradeMode == "Long Only" or tradeMode == "Both"
allowShort = tradeMode == "Short Only" or tradeMode == "Both"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIVE WATCH CONDITIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

nearLowerBand = bandPosition <= 25
nearUpperBand = bandPosition >= 75
middleZone = bandPosition > 25 and bandPosition < 75

rsiBullish = rsi > 50
rsiBearish = rsi < 50
rsiHot = rsi >= rsiOverbought
rsiCold = rsi <= rsiOversold

liveWatchLong = allowLong and longTrendAllowed and nearLowerBand and rsi <= 45 and strategy.position_size == 0
liveWatchShort = allowShort and shortTrendAllowed and nearUpperBand and rsi >= 55 and strategy.position_size == 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONFIRMED ENTRY CONDITIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

longTouchCondition = close <= lowerBand and rsi <= rsiOversold
shortTouchCondition = close >= upperBand and rsi >= rsiOverbought

longReclaimCondition = close[1] < lowerBand[1] and close > lowerBand and rsi > rsiOversold
shortReclaimCondition = close[1] > upperBand[1] and close < upperBand and rsi < rsiOverbought

longSignal = entryStyle == "Touch Band" ? longTouchCondition : longReclaimCondition
shortSignal = entryStyle == "Touch Band" ? shortTouchCondition : shortReclaimCondition

enterLong = allowLong and longSignal and longTrendAllowed and strategy.position_size == 0
enterShort = allowShort and shortSignal and shortTrendAllowed and strategy.position_size == 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STRATEGY ORDERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if enterLong
    strategy.entry("Long", strategy.long)

if enterShort
    strategy.entry("Short", strategy.short)

entryPrice = strategy.position_avg_price

longTakeProfit = entryPrice * (1 + takeProfitPct / 100)
longStopLoss = entryPrice * (1 - stopLossPct / 100)

shortTakeProfit = entryPrice * (1 - takeProfitPct / 100)
shortStopLoss = entryPrice * (1 + stopLossPct / 100)

if strategy.position_size > 0
    strategy.exit("Long TP/SL", from_entry="Long", limit=longTakeProfit, stop=longStopLoss)

if strategy.position_size < 0
    strategy.exit("Short TP/SL", from_entry="Short", limit=shortTakeProfit, stop=shortStopLoss)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIVE RADAR LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

biasText = bullTrend and rsiBullish ? "BULLISH" : bearTrend and rsiBearish ? "BEARISH" : bullTrend and rsiBearish ? "BULLISH PULLBACK" : bearTrend and rsiBullish ? "BEARISH BOUNCE" : "NEUTRAL"

locationText = nearUpperBand ? "Near Upper Band" : nearLowerBand ? "Near Lower Band" : "Middle / No-Man's Land"

rsiText = rsiHot ? "Overbought" : rsiCold ? "Oversold" : rsiBullish ? "Above 50" : "Below 50"

actionText = liveWatchLong ? "WATCH LONG" : liveWatchShort ? "WATCH SHORT" : enterLong ? "CONFIRMED LONG" : enterShort ? "CONFIRMED SHORT" : middleZone ? "WAIT - NO TRADE" : "WAIT FOR CONFIRMATION"

longTrigger = math.max(lowerBand, basis)
shortTrigger = math.min(upperBand, basis)

invalidationLong = lowerBand
invalidationShort = upperBand

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PLOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plot(showBands ? basis : na, title="BB Basis", color=color.gray)
plot(showBands ? upperBand : na, title="Upper Bollinger Band", color=color.blue)
plot(showBands ? lowerBand : na, title="Lower Bollinger Band", color=color.blue)

plot(showEMA ? ema : na, title="EMA Trend Filter", color=color.orange, linewidth=2)

plotshape(showLiveWatchSignals and liveWatchLong, title="Watch Long", style=shape.triangleup, location=location.belowbar, color=color.yellow, text="WATCH LONG", textcolor=color.black, size=size.small)

plotshape(showLiveWatchSignals and liveWatchShort, title="Watch Short", style=shape.triangledown, location=location.abovebar, color=color.yellow, text="WATCH SHORT", textcolor=color.black, size=size.small)

plotshape(showConfirmedSignals and enterLong, title="Confirmed Long", style=shape.labelup, location=location.belowbar, color=color.green, text="LONG", textcolor=color.white, size=size.small)

plotshape(showConfirmedSignals and enterShort, title="Confirmed Short", style=shape.labeldown, location=location.abovebar, color=color.red, text="SHORT", textcolor=color.white, size=size.small)

plot(showTradeLines and strategy.position_size > 0 ? longTakeProfit : na, title="Long Take Profit", color=color.green, linewidth=2, style=plot.style_linebr)

plot(showTradeLines and strategy.position_size > 0 ? longStopLoss : na, title="Long Stop Loss", color=color.red, linewidth=2, style=plot.style_linebr)

plot(showTradeLines and strategy.position_size < 0 ? shortTakeProfit : na, title="Short Take Profit", color=color.green, linewidth=2, style=plot.style_linebr)

plot(showTradeLines and strategy.position_size < 0 ? shortStopLoss : na, title="Short Stop Loss", color=color.red, linewidth=2, style=plot.style_linebr)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RADAR TABLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var table radar = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast and showRadar
    table.cell(radar, 0, 0, "TW RADAR", text_color=color.white, bgcolor=color.black)
    table.cell(radar, 1, 0, "LIVE", text_color=color.white, bgcolor=color.black)

    table.cell(radar, 0, 1, "Bias", text_color=color.white)
    table.cell(radar, 1, 1, biasText, text_color=color.white)

    table.cell(radar, 0, 2, "Action", text_color=color.white)
    table.cell(radar, 1, 2, actionText, text_color=color.white)

    table.cell(radar, 0, 3, "Band Position", text_color=color.white)
    table.cell(radar, 1, 3, str.tostring(bandPosition, "#.##") + "% - " + locationText, text_color=color.white)

    table.cell(radar, 0, 4, "RSI", text_color=color.white)
    table.cell(radar, 1, 4, str.tostring(rsi, "#.##") + " - " + rsiText, text_color=color.white)

    table.cell(radar, 0, 5, "Long Trigger", text_color=color.white)
    table.cell(radar, 1, 5, str.tostring(longTrigger, format.mintick), text_color=color.white)

    table.cell(radar, 0, 6, "Short Trigger", text_color=color.white)
    table.cell(radar, 1, 6, str.tostring(shortTrigger, format.mintick), text_color=color.white)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(liveWatchLong, title="WATCH LONG Setup Forming", message="TrenchWrld BB RSI: WATCH LONG setup forming now.")

alertcondition(liveWatchShort, title="WATCH SHORT Setup Forming", message="TrenchWrld BB RSI: WATCH SHORT setup forming now.")

alertcondition(enterLong, title="CONFIRMED LONG Entry", message="TrenchWrld BB RSI: Confirmed LONG entry.")

alertcondition(enterShort, title="CONFIRMED SHORT Entry", message="TrenchWrld BB RSI: Confirmed SHORT entry.")