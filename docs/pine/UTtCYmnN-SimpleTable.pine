//@version=6

// @description A library for rendering simple tables as easily as possible.
library("SimpleTable", overlay = true)


//#region 🟦🟦🟦  HELPER TYPES  🟦🟦🟦

// @type o_column
// @description A wrapper for a single table column.
// @field a_values (array<string>) The column values.
type o_column
    array<string> a_values
//#endregion HELPER TYPES


//#region 🟦🟦🟦  HELPER METHODS  🟦🟦🟦

method m_addColumn(map<int, o_column> _self, array<string> _a_column, int _colIndex, int _maxRows) =>
    // Track outputs for this column attempt.
    int _nextIndex = _colIndex
    int _nextMaxRows = _maxRows
    // Only add valid, non-empty columns.
    if not na(_a_column)
        int _columnSize = _a_column.size()
        if _columnSize > 0
            // Store the column and update the max row count.
            _self.put(_colIndex, o_column.new(a_values=_a_column))
            if _columnSize > _nextMaxRows
                _nextMaxRows := _columnSize
            _nextIndex += 1
    // Return the updated counters to the caller.
    [_nextIndex, _nextMaxRows]
//#endregion HELPER METHODS


//#region 🟦🟦🟦  `f_drawTableFromColumnArrays` -- CREATE A TABLE FROM UP TO TEN STRING ARRAYS  🟦🟦🟦

// @function Fills a single table column with string values, leaving remaining rows blank.
// @param _self        (table) The table to populate.
// @param _columnIndex (int) The target column index.
// @param _a_column    (array<string>) The column values to display.
// @param _startRow    (int) The first row index to draw.
// @param _maxRows     (int) The total number of rows in the table.
// @param _textAlign   (string) The text alignment for each cell.
// @param _textSize    (string) The text size for each cell.
// @param _textColor   (color) The text colour for each cell.
// @param _cellBg      (color) The background colour for each cell.
// @returns No explicit return. The table is modified as a side-effect.
method m_fillColumn(table _self, int _columnIndex, array<string> _a_column, int _startRow, int _maxRows, string _textAlign, string _textSize, color _textColor, color _cellBg) =>
    // Pre-calculate column bounds.
    int _columnSize = _a_column.size()
    // Render each row within the allowed range.
    if _maxRows > _startRow
        for _row = _startRow to _maxRows - 1
            // Resolve the cell text or fallback to blank.
            string _cellText = _row < _columnSize ? _a_column.get(_row) : ""
            // Draw the cell into the table.
            _self.cell(_columnIndex, _row, _cellText, text_halign=_textAlign, text_size=_textSize, text_color=_textColor, bgcolor=_cellBg)

// @function Renders a table using up to ten string arrays. The table size is derived from the number of non-na arrays and the maximum length across the supplied arrays.
// @param _a_col1          (array<string>) Column 1 values. Supply na to omit.
// @param _a_col2          (array<string>) Column 2 values. Supply na to omit.
// @param _a_col3          (array<string>) Column 3 values. Supply na to omit.
// @param _a_col4          (array<string>) Column 4 values. Supply na to omit.
// @param _a_col5          (array<string>) Column 5 values. Supply na to omit.
// @param _a_col6          (array<string>) Column 6 values. Supply na to omit.
// @param _a_col7          (array<string>) Column 7 values. Supply na to omit.
// @param _a_col8          (array<string>) Column 8 values. Supply na to omit.
// @param _a_col9          (array<string>) Column 9 values. Supply na to omit.
// @param _a_col10         (array<string>) Column 10 values. Supply na to omit.
// @param _position        (TablePosition) Table position on the chart. Default is top right.
// @param _textSize        (TableTextSize) Text size for all cells. Default is normal.
// @param _textAlign       (TableTextAlign) Horizontal alignment for all cells. Default is left.
// @param _textColor       (color) Text colour for all cells. Default is chart foreground color.
// @param _cellBgColor     (color) Background colour for all cells. Uses a default if na. Default is gray 90%.
// @param _hasHeaderRow    (bool) If true, row 0 is treated as a header. Default is true.
// @param _headerBgColor   (color) Background colour for the header row. Uses a default if na. Default is gray 75%.
// @param _headerTextColor (color) Text colour for the header row. Uses a default if na.
// @param _borderWidth     (int) Table border width. Must be non-negative. Default is 1.
// @returns The table object, so the caller can store the table ID if required.
export f_drawTableFromColumnArrays(array<string> _a_col1 = na, array<string> _a_col2 = na, array<string> _a_col3 = na, array<string> _a_col4 = na, array<string> _a_col5 = na, array<string> _a_col6 = na, array<string> _a_col7 = na, array<string> _a_col8 = na, array<string> _a_col9 = na, array<string> _a_col10 = na, string _position = position.top_right, string _textSize = size.normal, string _textAlign = text.align_left, color _textColor = chart.fg_color, color _cellBgColor = na, color _headerBgColor = na, color _headerTextColor = na, bool _hasHeaderRow = true, int _borderWidth = 1) =>
    // Note: You CAN pass the built-in constants such as text.align_left but you need to not use quotes, even though they're strings, 'cos they're not literal strings.  
    // Resolve optional styling defaults.
    color _cellBg = na(_cellBgColor) ? color.new(color.gray, 90) : _cellBgColor
    color _headerBg = na(_headerBgColor) ? color.new(color.gray, 75) : _headerBgColor
    color c_headerText = na(_headerTextColor) ? _textColor : _headerTextColor
    int _safeBorderWidth = _borderWidth < 0 ? 0 : _borderWidth

    // Build the column map and gather size metadata. 
    // We store the arrays in a map internally just to make it neater to iterate through them.
    // We don't want to make the caller supply a map or some special type. Just string arrays.
    map<int, o_column> map_columns = map.new<int, o_column>()
    [_colIndex1, _maxRows1] = map_columns.m_addColumn(_a_col1, 0, 0)
    [_colIndex2, _maxRows2] = map_columns.m_addColumn(_a_col2, _colIndex1, _maxRows1)
    [_colIndex3, _maxRows3] = map_columns.m_addColumn(_a_col3, _colIndex2, _maxRows2)
    [_colIndex4, _maxRows4] = map_columns.m_addColumn(_a_col4, _colIndex3, _maxRows3)
    [_colIndex5, _maxRows5] = map_columns.m_addColumn(_a_col5, _colIndex4, _maxRows4)
    [_colIndex6, _maxRows6] = map_columns.m_addColumn(_a_col6, _colIndex5, _maxRows5)
    [_colIndex7, _maxRows7] = map_columns.m_addColumn(_a_col7, _colIndex6, _maxRows6)
    [_colIndex8, _maxRows8] = map_columns.m_addColumn(_a_col8, _colIndex7, _maxRows7)
    [_colIndex9, _maxRows9] = map_columns.m_addColumn(_a_col9, _colIndex8, _maxRows8)
    [_colIndex10, _maxRows10] = map_columns.m_addColumn(_a_col10, _colIndex9, _maxRows9)
    int _colCount = _colIndex10
    int _maxRows  = _maxRows10

    // Create or resize the table on the last bar only, for performance, since tables are not visible on historical bars.
    var table _t = na
    var int   _cachedCols = na
    var int   _cachedRows = na
    var bool  _prevHasHeaderRow      = false
    var bool  _headerSettingIsCached = false
    var map<int, int> map_cachedColumnSizes = map.new<int, int>()
    bool _didRecreate = false
    bool _didShrink   = false
    if barstate.islast and _colCount > 0 and _maxRows > 0
        if na(_t)
            _t := table.new(_position, _colCount, _maxRows, border_width=_safeBorderWidth)
            _cachedCols := _colCount
            _cachedRows := _maxRows
            _prevHasHeaderRow := _hasHeaderRow
            _headerSettingIsCached := true
            _didRecreate := true
        else if _colCount != _cachedCols or _maxRows != _cachedRows
            _t := table.new(_position, _colCount, _maxRows, border_width=_safeBorderWidth)
            _cachedCols := _colCount
            _cachedRows := _maxRows
            _prevHasHeaderRow := _hasHeaderRow
            _headerSettingIsCached := true
            _didRecreate := true

    if barstate.islast and not na(_t)
        // Detect column shrinks so we can clear only when needed.
        if not _didRecreate
            for _col = 0 to _cachedCols - 1
                o_column _column = map_columns.get(_col)
                if na(_column)
                    continue
                int _currentSize = _column.a_values.size()
                int _previousSize = map_cachedColumnSizes.get(_col)
                if na(_previousSize)
                    _previousSize := _currentSize
                if _currentSize < _previousSize
                    _didShrink := true
                map_cachedColumnSizes.put(_col, _currentSize)
        // Clear the table only when header mode toggles or a column shrinks without a rebuild.
        if not _didRecreate and ((_headerSettingIsCached and _prevHasHeaderRow != _hasHeaderRow) or _didShrink)
            _t.clear(start_column=0, start_row=0, end_column=_cachedCols - 1, end_row=_cachedRows - 1)
        _prevHasHeaderRow := _hasHeaderRow
        _headerSettingIsCached := true
        // Calculate row bounds for the current draw.
        int _rowsToDraw = _cachedRows
        if _maxRows < _cachedRows
            _rowsToDraw := _maxRows
        // Render the header row if enabled.
        if _rowsToDraw > 0 and _hasHeaderRow
            for _col = 0 to _cachedCols - 1
                o_column _column = map_columns.get(_col)
                if na(_column)
                    continue
                array<string> _values = _column.a_values
                string _headerText = _values.size() > 0 ? _values.get(0) : ""
                _t.cell(_col, 0, _headerText, text_halign=_textAlign, text_size=_textSize, text_color=c_headerText, bgcolor=_headerBg)
        // Render body rows beneath the header.
        int _startRow = _hasHeaderRow ? 1 : 0
        for _col = 0 to _cachedCols - 1
            o_column _column = map_columns.get(_col)
            if na(_column)
                continue
            _t.m_fillColumn(_col, _column.a_values, _startRow, _rowsToDraw, _textAlign, _textSize, _textColor, _cellBg)

    // Return the table handle to the caller.
    _t
//#endregion `f_drawTableFromColumnArrays` -- CREATE A TABLE FROM UP TO TEN STRING ARRAYS
    

//#region 🟧🟧🟧  EXAMPLE USAGE  🟧🟧🟧
const string G_EXAMPLE = "EXAMPLE USAGE"

string in_demoPosition = input.string(defval=position.top_right, title="Demo Table Position", group=G_EXAMPLE,
  options=[position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right],
  tooltip="Where the demo table is anchored on the chart.")
string in_demoTextSize = input.string(defval=size.normal, title="Demo Text Size", group=G_EXAMPLE,
  options=[size.tiny, size.small, size.normal, size.large, size.huge],
  tooltip="Text size used for all demo cells.")
string in_demoTextAlign = input.string(defval=text.align_left, title="Demo Text Align", group=G_EXAMPLE,
  options=[text.align_left, text.align_center, text.align_right],
  tooltip="Horizontal alignment for demo table text.")
color in_demoTextColor = input.color(defval=color.white, title="Demo Text Colour", group=G_EXAMPLE,
  tooltip="Text colour for the demo table cells.")
color in_demoCellBg = input.color(defval=color.black, title="Demo Cell Background", group=G_EXAMPLE,
  tooltip="Background colour for the demo table cells.")
bool in_demoHasHeader = input.bool(defval=true, title="Demo Has Header Row", group=G_EXAMPLE,
  tooltip="If true, the first row is styled as a header.")
color in_demoHeaderBg = input.color(defval=color.gray, title="Demo Header Background", group=G_EXAMPLE,
  tooltip="Background colour for the header row (row 0) in the demo table.")
color in_demoHeaderText = input.color(defval=color.white, title="Demo Header Text Colour", group=G_EXAMPLE,
  tooltip="Text colour for the header row (row 0) in the demo table.")
int in_demoBorderWidth = input.int(defval=1, title="Demo Border Width", minval=0, group=G_EXAMPLE,
  tooltip="Table border width. Set to 0 for no border.")

var array<string> a_col1 = na
var array<string> a_col2 = na
var array<string> a_col3 = na

if barstate.islast
    a_col1 := array.from("Symbol", "BTCUSD", "AAPL")
    a_col2 := array.from("Price", str.tostring(request.security("BTCUSD", timeframe.period, close)), str.tostring(request.security("AAPL", timeframe.period, close)))
    a_col3 := array.from("Notes", "Volatile", "US Tech")

table t_demo = f_drawTableFromColumnArrays(
  _a_col1=a_col1,
  _a_col2=a_col2,
  _a_col3=a_col3,
  _position=in_demoPosition,
  _textSize=in_demoTextSize,
  _textAlign=in_demoTextAlign,
  _textColor=in_demoTextColor,
  _cellBgColor=in_demoCellBg,
  _headerBgColor=in_demoHeaderBg,
  _headerTextColor=in_demoHeaderText,
  _hasHeaderRow=in_demoHasHeader,
  _borderWidth=in_demoBorderWidth)

//#endregion  EXAMPLE USAGE 