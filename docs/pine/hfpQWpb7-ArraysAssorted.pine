//@version=6

// @description A library providing array utility methods.
library("ArraysAssorted", overlay = true)


// 🟥🟥🟥  GENERAL INPUTS  🟥🟥🟥
// Which example plots to show
string in_showExample = input.string(defval="m_getHighestLowestFloat", title="Show Example Usage", group="EXAMPLE USAGE", 
  options=["Off", "m_getHighestLowestFloat"], tooltip="Show example plots demonstrating the library usage")
bool showExample1 = in_showExample == "m_getHighestLowestFloat"

//#region 🟢🟢🟢🟢🟢🟢  METHOD 1 `m_getHighestLowestFloat`  🟢🟢🟢🟢🟢🟢

// 🟦🟦🟦 TYPE DEFINITIONS 🟦🟦🟦
export enum HighestLowest  // Whether to return the highest value or lowest value in the range.
	highest
	lowest

export enum FirstLast  // Whether to return the first (lowest index) or last (highest index) occurrence of the extreme value.
	first
	last

// @method                Finds the highest or lowest value in a float array within a rolling lookback window, and returns the value along with the offset (number of elements back from the end of the array) of its first or last occurrence.
// @param _self           (array<float>) The array of float values to search for extremes.
// @param _highestLowest  (HighestLowest) Whether to search for the highest or lowest value. Use the enum value HighestLowest.highest or HighestLowest.lowest.
// @param _lookbackIndexes   (int) The number of array elements to include in the rolling lookback window. Must be positive. Note: Array elements only correspond to bars if the consuming script always adds exactly one element on consecutive bars.
// @param _offset         (int) The number of array elements back from the end of the array to start the lookback window. A value of zero means no offset. The _offset parameter offsets both the beginning and end of the range.
// @param _firstLastType  (FirstLast) Whether to return the offset of the first (lowest index) or last (highest index) occurrence of the extreme value. Use FirstLast.first or FirstLast.last.
// @returns               (tuple<float, int>) A tuple containing the highest or lowest value and its offset -- the number of elements back from the end of the array. If not found, returns [na, na]. NOTE: The _offsetFromEndOfArray value is not affected by the _offset parameter. In other words, it is not the offset from the end of the range but from the end of the array. This number may or may not have any relation to the number of *bars* back, depending on how the array is populated. The calling code needs to figure that out.
export method m_getHighestLowestFloat(array<float> _self, HighestLowest _highestLowest, int _lookbackIndexes, int _offset, FirstLast _firstLastType) =>
    if _lookbackIndexes <= 0
        runtime.error("Lookback bars must be a positive integer")
    int _arraySize = _self.size()
    if _arraySize == 0  // Catch empty arrays.
        [na, na]
    else
        // Calculate the slice boundaries with offset
        int _sliceEnd = math.max(0, _arraySize - _offset)
        int _sliceStart = math.max(0, _sliceEnd - _lookbackIndexes)
        // Ensure we have a valid slice
        if _sliceStart >= _sliceEnd
            [na, na]
        else
            // Create a slice of the array for the lookback window
            array<float> _sliceArray = _self.slice(_sliceStart, _sliceEnd)
            // Use built-in functions to find extreme value
            float _highestLowestValue = switch _highestLowest
                HighestLowest.highest => _sliceArray.max()
                HighestLowest.lowest => _sliceArray.min()
                => na
            // Find the index of the occurrence of this value in the slice
            int _relativeIndex = switch _firstLastType
                FirstLast.first => _sliceArray.indexof(_highestLowestValue)
                FirstLast.last => _sliceArray.lastindexof(_highestLowestValue)
                => -1
            // Calculate the offset from the end of the *array* (not the slice)
            int _arrayIndex = _relativeIndex != -1 ? _sliceStart + _relativeIndex : -1
            int _offsetFromEndOfArray = _arrayIndex != -1 ? (_arraySize - 1) - _arrayIndex : -1
            [_highestLowestValue, _offsetFromEndOfArray]


//#region 🟧🟧🟧 EXAMPLE USAGE 🟧🟧🟧

// Example inputs for demonstration
int in_lookbackElements = input.int(defval=20, title="Lookback Bars", minval=1, maxval=100, group="EXAMPLE USAGE", 
  tooltip="Number of bars to look back for finding extremes within rolling window")
int in_offset = input.int(defval=0, title="Offset", minval=0, maxval=100, group="EXAMPLE USAGE", 
  tooltip="Number of bars back from the most recent bar to start the lookback window. 0 = most recent bar.")

// Example arrays
var array<float> a_highs = array.new<float>()  // Array of highs.
var array<float> a_lows = array.new<float>()  // Array of lows.

// Store each bar's high and low values
a_highs.push(high)
a_lows.push(low)

// Call the method to find highest highs and lowest lows within the range defined by the user's inputs.
[highestValue, highestOffset] = a_highs.m_getHighestLowestFloat(HighestLowest.highest, in_lookbackElements, in_offset, FirstLast.first)
[lowestValue, lowestOffset] = a_lows.m_getHighestLowestFloat(HighestLowest.lowest, in_lookbackElements, in_offset, FirstLast.first)

// Plot the results
plot(series=showExample1 ? highestValue : na, title="Highest Value", color=color.yellow, display=display.all)
plot(series=showExample1 ? highestOffset : na, title="Highest Offset", color=color.yellow, display=display.data_window)
plot(series=showExample1 ? lowestValue : na, title="Lowest Value", color=color.lime, display=display.all)
plot(series=showExample1 ? lowestOffset : na, title="Lowest Offset", color=color.lime, display=display.data_window)

// Example labels
// Note that we don't do any label management in this simple example, so labels are drawn on top of one another until the extreme value changes.
if showExample1
    if not na(lowestValue) and not na(lowestOffset)
        label.new(
          x=bar_index - lowestOffset, 
          y=lowestValue, 
          text="LOW\n" + str.tostring(lowestValue, "#.####") + "\nOffset: " + str.tostring(lowestOffset), 
          style=label.style_label_up, 
          color=color.new(color.lime, 50), 
          textcolor=color.new(color.white, 50), 
          size=size.small
          )

    if not na(highestValue) and not na(highestOffset)
        label.new(
          x=bar_index - highestOffset, 
          y=highestValue, 
          text="HIGH\n" + str.tostring(highestValue, "#.####") + "\nOffset: " + str.tostring(highestOffset), 
          style=label.style_label_down, 
          color=color.new(color.yellow, 50), 
          textcolor=color.new(color.black, 50), 
          size=size.small
          )    

          
//#endregion EXAMPLE USAGE

//#endregion METHOD `m_getHighestLowestFloat`