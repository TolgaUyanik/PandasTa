//@version=6
indicator(
     title      = "EMA 8/21 + EMA 200 Trend and Sideways Filter",
     shorttitle = "EMA 8/21 + Trend Filter",
     overlay    = true
)

//─────────────────────────────────────────────────────────────────────
// EMA settings
//─────────────────────────────────────────────────────────────────────
source      = input.source(close, "EMA Source", group = "EMA Settings")
fastLength  = input.int(8, "Fast EMA Length", minval = 1, group = "EMA Settings")
slowLength  = input.int(21, "Slow EMA Length", minval = 1, group = "EMA Settings")
trendLength = input.int(200, "Trend EMA Length", minval = 1, group = "EMA Settings")

//─────────────────────────────────────────────────────────────────────
// Trend-filter settings
//─────────────────────────────────────────────────────────────────────
useTrendFilter = input.bool(
     true,
     "Enable EMA 200 Trend Filter",
     group = "Trend Filter"
)

//─────────────────────────────────────────────────────────────────────
// Sideways-filter settings
//─────────────────────────────────────────────────────────────────────
useSidewaysFilter = input.bool(
     true,
     "Enable Sideways Filter",
     group = "Sideways Filter"
)

adxLength = input.int(
     14,
     "ADX Length",
     minval = 1,
     group = "Sideways Filter"
)

adxSmoothing = input.int(
     14,
     "ADX Smoothing",
     minval = 1,
     group = "Sideways Filter"
)

minimumADX = input.float(
     20.0,
     "Minimum ADX for Entry",
     minval = 1.0,
     step = 0.5,
     group = "Sideways Filter",
     tooltip = "Entries are blocked when ADX is below this value. Higher values allow signals only during stronger trends."
)

showSidewaysBackground = input.bool(
     false,
     "Highlight Sideways Market",
     group = "Sideways Filter"
)

//─────────────────────────────────────────────────────────────────────
// Display settings
//─────────────────────────────────────────────────────────────────────
confirmAtClose = input.bool(
     true,
     "Confirm Signals at Candle Close",
     group = "Display and Signals"
)

showExitLabels = input.bool(
     true,
     "Show Take-Profit / Exit Labels",
     group = "Display and Signals"
)

showTrendFill = input.bool(
     true,
     "Show EMA 8/21 Trend Fill",
     group = "Display and Signals"
)

showTrendBackground = input.bool(
     false,
     "Show EMA 200 Trend Background",
     group = "Display and Signals"
)

colorCandles = input.bool(
     false,
     "Color Candles by Trend",
     group = "Display and Signals"
)

//─────────────────────────────────────────────────────────────────────
// EMA calculations
//─────────────────────────────────────────────────────────────────────
fastEMA  = ta.ema(source, fastLength)
slowEMA  = ta.ema(source, slowLength)
trendEMA = ta.ema(source, trendLength)

//─────────────────────────────────────────────────────────────────────
// ADX calculations
//─────────────────────────────────────────────────────────────────────
[plusDI, minusDI, adxValue] = ta.dmi(adxLength, adxSmoothing)

isTrending = adxValue >= minimumADX
isSideways = adxValue < minimumADX

sidewaysFilterPassed = not useSidewaysFilter or isTrending

//─────────────────────────────────────────────────────────────────────
// EMA crossover conditions
//─────────────────────────────────────────────────────────────────────
signalConfirmed = not confirmAtClose or barstate.isconfirmed

bullishCross = ta.crossover(fastEMA, slowEMA) and signalConfirmed
bearishCross = ta.crossunder(fastEMA, slowEMA) and signalConfirmed

//─────────────────────────────────────────────────────────────────────
// EMA 200 trend conditions
//─────────────────────────────────────────────────────────────────────
bullishTrend = close > trendEMA
bearishTrend = close < trendEMA

buyTrendPassed = not useTrendFilter or bullishTrend
sellTrendPassed = not useTrendFilter or bearishTrend

//─────────────────────────────────────────────────────────────────────
// Final entry conditions
//
// Buy:
// 1. EMA 8 crosses above EMA 21
// 2. Price is above EMA 200 when trend filter is enabled
// 3. ADX is high enough when sideways filter is enabled
//
// Sell:
// 1. EMA 8 crosses below EMA 21
// 2. Price is below EMA 200 when trend filter is enabled
// 3. ADX is high enough when sideways filter is enabled
//─────────────────────────────────────────────────────────────────────
buySignal = (
     bullishCross and
     buyTrendPassed and
     sidewaysFilterPassed
)

sellSignal = (
     bearishCross and
     sellTrendPassed and
     sidewaysFilterPassed
)

//─────────────────────────────────────────────────────────────────────
// Trade-state tracking
//
//  1 = Long position
// -1 = Short position
//  0 = No tracked position
//─────────────────────────────────────────────────────────────────────
var int tradeState = 0

// Exits are not blocked by the trend or sideways filters.
exitLong = bearishCross and tradeState == 1
exitShort = bullishCross and tradeState == -1

if exitLong or exitShort
    tradeState := 0

if buySignal
    tradeState := 1
else if sellSignal
    tradeState := -1

//─────────────────────────────────────────────────────────────────────
// EMA plots
//─────────────────────────────────────────────────────────────────────
fastPlot = plot(
     fastEMA,
     title = "EMA 8",
     color = color.aqua,
     linewidth = 2
)

slowPlot = plot(
     slowEMA,
     title = "EMA 21",
     color = color.orange,
     linewidth = 2
)

plot(
     trendEMA,
     title = "EMA 200",
     color = color.purple,
     linewidth = 3
)

//─────────────────────────────────────────────────────────────────────
// EMA 8/21 fill
//─────────────────────────────────────────────────────────────────────
emaFillColor = fastEMA >= slowEMA
     ? color.new(color.green, 90)
     : color.new(color.red, 90)

fill(
     fastPlot,
     slowPlot,
     color = showTrendFill ? emaFillColor : na,
     title = "EMA 8/21 Trend Fill"
)

//─────────────────────────────────────────────────────────────────────
// Entry signals
//─────────────────────────────────────────────────────────────────────
plotshape(
     buySignal,
     title = "Buy Signal",
     style = shape.labelup,
     location = location.belowbar,
     color = color.green,
     text = "BUY",
     textcolor = color.white,
     size = size.small
)

plotshape(
     sellSignal,
     title = "Sell Signal",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.red,
     text = "SELL",
     textcolor = color.white,
     size = size.small
)

//─────────────────────────────────────────────────────────────────────
// Take-profit / exit signals
//─────────────────────────────────────────────────────────────────────
plotshape(
     showExitLabels and exitLong,
     title = "Exit Long",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.orange,
     text = "TP LONG",
     textcolor = color.white,
     size = size.tiny
)

plotshape(
     showExitLabels and exitShort,
     title = "Exit Short",
     style = shape.labelup,
     location = location.belowbar,
     color = color.orange,
     text = "TP SHORT",
     textcolor = color.white,
     size = size.tiny
)

//─────────────────────────────────────────────────────────────────────
// Background indicators
//─────────────────────────────────────────────────────────────────────
trendBackgroundColor = bullishTrend
     ? color.new(color.green, 94)
     : color.new(color.red, 94)

bgcolor(
     showTrendBackground ? trendBackgroundColor : na,
     title = "EMA 200 Trend Background"
)

bgcolor(
     showSidewaysBackground and isSideways
     ? color.new(color.gray, 88)
     : na,
     title = "Sideways Market Background"
)

//─────────────────────────────────────────────────────────────────────
// Candle colors
//─────────────────────────────────────────────────────────────────────
candleColor = bullishTrend
     ? color.new(color.green, 40)
     : color.new(color.red, 40)

barcolor(colorCandles ? candleColor : na)

//─────────────────────────────────────────────────────────────────────
// Data-window values
//─────────────────────────────────────────────────────────────────────
plot(
     adxValue,
     title = "ADX Value",
     display = display.data_window
)

//─────────────────────────────────────────────────────────────────────
// Alerts
//─────────────────────────────────────────────────────────────────────
alertcondition(
     buySignal,
     title = "EMA Buy Signal",
     message = "BUY: EMA 8 crossed above EMA 21, trend and sideways filters passed on {{ticker}} at {{close}}."
)

alertcondition(
     sellSignal,
     title = "EMA Sell Signal",
     message = "SELL: EMA 8 crossed below EMA 21, trend and sideways filters passed on {{ticker}} at {{close}}."
)

alertcondition(
     exitLong,
     title = "Exit Long",
     message = "EXIT LONG: EMA 8 crossed below EMA 21 on {{ticker}} at {{close}}."
)

alertcondition(
     exitShort,
     title = "Exit Short",
     message = "EXIT SHORT: EMA 8 crossed above EMA 21 on {{ticker}} at {{close}}."
)