// ©Greatwhite - Enhanced with Advanced Fractals - Fixed Price Display

//@version=6
indicator('Zig Zag with HHLL & Fractals', overlay = true, max_bars_back = 500)

// Zig Zag Settings
prd1 = input.int(defval = 8, title = 'ZigZag Period 1', minval = 2, maxval = 20, group = "Zig Zag Settings")
prd2 = input.int(defval = 20, title = 'ZigZag Period 2', minval = 2, maxval = 50, group = "Zig Zag Settings")
showzz = input.string(defval = 'Show Both', title = 'Show Zig Zags', options = ['Show Zig Zag 1', 'Show Zig Zag 2', 'Show Both', 'Show None'], group = "Display Options")
showhhll = input.string(defval = 'Show Both', title = 'Show HHLL', options = ['Show HHLL 1', 'Show HHLL 2', 'Show Both', 'Show None'], group = "Display Options")
showprice = input(defval = true, title = 'Show Price on HH/LL Labels', group = "Display Options")

// Fractal Settings
showFractals = input.bool(defval = false, title = 'Show Fractals', group = "Fractal Settings")
n = input.int(title="📌 Fractal Period", defval=2, minval=2, group = "Fractal Settings")

// Price Format Settings - Updated
priceFormat = input.string(defval = 'Auto (mintick)', title = 'Price Format', options = ['Auto (mintick)', 'Custom Decimals'], group = "Price Format")
decimals = input.int(defval = 2, title = 'Custom Decimal Places', minval = 0, maxval = 8, group = "Price Format")

// Color Settings
upcol1 = input(defval = color.lime, title = 'Zig Zag 1 Up Color', group = "Colors")
dncol1 = input(defval = color.red, title = 'Zig Zag 1 Down Color', group = "Colors")
upcol2 = input(defval = color.blue, title = 'Zig Zag 2 Up Color', group = "Colors")
dncol2 = input(defval = color.purple, title = 'Zig Zag 2 Down Color', group = "Colors")
txtcol = input(defval = color.black, title = 'Text Color', group = "Colors")
fractalUpColor = input(defval = color.olive, title = 'Fractal Up Color', group = "Colors")
fractalDownColor = input(defval = color.maroon, title = 'Fractal Down Color', group = "Colors")

// Line Style Settings
zz1style = input.string(defval = 'Dashed', title = 'Zig Zag 1 Line Style', options = ['Dashed', 'Dotted'], group = "Line Styles")
zz1width = input.int(defval = 2, title = 'Zig zag 1 Line Width', minval = 1, maxval = 4, group = "Line Styles")
zz2width = input.int(defval = 3, title = 'Zig zag 2 Line Width', minval = 1, maxval = 6, group = "Line Styles")

// Improved Price Formatting Function
formatPrice(price) =>
    if priceFormat == 'Auto (mintick)'
        // Use format.mintick for accurate price display across all currency pairs
        str.tostring(price, format.mintick)
    else
        // Use custom decimal places
        decimals == 0 ? str.tostring(price, '#') : str.tostring(price, '#.' + str.repeat('#', decimals))

// Zig Zag Logic
float ph1 = ta.highestbars(high, prd1) == 0 ? high : na
float pl1 = ta.lowestbars(low, prd1) == 0 ? low : na
float ph2 = ta.highestbars(high, prd2) == 0 ? high : na
float pl2 = ta.lowestbars(low, prd2) == 0 ? low : na

var dir1 = 0
var dir2 = 0
iff_1 = bool(pl1) and na(ph1) ? -1 : dir1
dir1 := bool(ph1) and na(pl1) ? 1 : iff_1
iff_2 = bool(pl2) and na(ph2) ? -1 : dir2
dir2 := bool(ph2) and na(pl2) ? 1 : iff_2

var max_array_size = 10 // [5, 2] matrix
var zigzag1 = array.new_float(0)
var zigzag2 = array.new_float(0)
oldzigzag1 = array.copy(zigzag1)
oldzigzag2 = array.copy(zigzag2)

add_to_zigzag(pointer, value, bindex) =>
    array.unshift(pointer, bindex)
    array.unshift(pointer, value)
    if array.size(pointer) > max_array_size
        array.pop(pointer)
        array.pop(pointer)

update_zigzag(pointer, value, bindex, dir) =>
    if array.size(pointer) == 0
        add_to_zigzag(pointer, value, bindex)
    else
        if dir == 1 and value > array.get(pointer, 0) or dir == -1 and value < array.get(pointer, 0)
            array.set(pointer, 0, value)
            array.set(pointer, 1, bindex)
        0.

dir1changed = ta.change(dir1)
if bool(ph1) or bool(pl1)
    if bool(dir1changed)
        add_to_zigzag(zigzag1, dir1 == 1 ? ph1 : pl1, bar_index)
    else
        update_zigzag(zigzag1, dir1 == 1 ? ph1 : pl1, bar_index, dir1)

dir2changed = ta.change(dir2)
if bool(ph2) or bool(pl2)
    if bool(dir2changed)
        add_to_zigzag(zigzag2, dir2 == 1 ? ph2 : pl2, bar_index)
    else
        update_zigzag(zigzag2, dir2 == 1 ? ph2 : pl2, bar_index, dir2)

// Advanced Fractal Logic
upFractal =
 ((high[n+2] < high[n]) and (high[n+1] < high[n]) and (high[n-1] < high[n]) and (high[n-2] < high[n])) or
 ((high[n+3] < high[n]) and (high[n+2] < high[n]) and (high[n+1] == high[n]) and (high[n-1] < high[n]) and (high[n-2] < high[n])) or
 ((high[n+4] < high[n]) and (high[n+3] < high[n]) and (high[n+2] == high[n]) and (high[n+1] <= high[n]) and (high[n-1] < high[n]) and (high[n-2] < high[n])) or
 ((high[n+5] < high[n]) and (high[n+4] < high[n]) and (high[n+3] == high[n]) and (high[n+2] == high[n]) and (high[n+1] <= high[n]) and (high[n-1] < high[n]) and (high[n-2] < high[n])) or
 ((high[n+6] < high[n]) and (high[n+5] < high[n]) and (high[n+4] == high[n]) and (high[n+3] <= high[n]) and (high[n+2] == high[n]) and (high[n+1] <= high[n]) and (high[n-1] < high[n]) and (high[n-2] < high[n]))

dnFractal =
 ((low[n+2] > low[n]) and (low[n+1] > low[n]) and (low[n-1] > low[n]) and (low[n-2] > low[n])) or
 ((low[n+3] > low[n]) and (low[n+2] > low[n]) and (low[n+1] == low[n]) and (low[n-1] > low[n]) and (low[n-2] > low[n])) or
 ((low[n+4] > low[n]) and (low[n+3] > low[n]) and (low[n+2] == low[n]) and (low[n+1] >= low[n]) and (low[n-1] > low[n]) and (low[n-2] > low[n])) or
 ((low[n+5] > low[n]) and (low[n+4] > low[n]) and (low[n+3] == low[n]) and (low[n+2] == low[n]) and (low[n+1] >= low[n]) and (low[n-1] > low[n]) and (low[n-2] > low[n])) or
 ((low[n+6] > low[n]) and (low[n+5] > low[n]) and (low[n+4] == low[n]) and (low[n+3] >= low[n]) and (low[n+2] == low[n]) and (low[n+1] >= low[n]) and (low[n-1] > low[n]) and (low[n-2] > low[n]))

// Zig Zag 1 Plotting
if array.size(zigzag1) >= 6
    var line zzline1 = na
    var label zzlabel1 = na
    if array.get(zigzag1, 0) != array.get(oldzigzag1, 0) or array.get(zigzag1, 1) != array.get(oldzigzag1, 1)
        if array.get(zigzag1, 2) == array.get(oldzigzag1, 2) and array.get(zigzag1, 3) == array.get(oldzigzag1, 3)
            line.delete(zzline1)
            label.delete(zzlabel1)
        if showzz == 'Show Zig Zag 1' or showzz == 'Show Both'
            zzline1 := line.new(x1 = math.round(array.get(zigzag1, 1)), y1 = array.get(zigzag1, 0), x2 = math.round(array.get(zigzag1, 3)), y2 = array.get(zigzag1, 2), color = dir1 == 1 ? upcol1 : dncol1, width = zz1width, style = zz1style == 'Dashed' ? line.style_dashed : line.style_dotted)
        if showhhll == 'Show HHLL 1' or showhhll == 'Show Both'
            hhlltxt = dir1 == 1 ? array.get(zigzag1, 0) > array.get(zigzag1, 4) ? 'HH' : 'LH' : array.get(zigzag1, 0) < array.get(zigzag1, 4) ? 'LL' : 'HL'
            hhlltxt := showprice ? hhlltxt + '\n' + formatPrice(array.get(zigzag1, 0)) : hhlltxt
            labelcol = dir1 == 1 ? array.get(zigzag1, 0) > array.get(zigzag1, 4) ? upcol1 : dncol1 : array.get(zigzag1, 0) < array.get(zigzag1, 4) ? dncol1 : upcol1
            zzlabel1 := label.new(x = math.round(array.get(zigzag1, 1)), y = array.get(zigzag1, 0), text = hhlltxt, color = labelcol, textcolor = txtcol, style = dir1 == 1 ? label.style_label_down : label.style_label_up)

// Zig Zag 2 Plotting
if array.size(zigzag2) >= 6
    var line zzline2 = na
    var label zzlabel2 = na
    if array.get(zigzag2, 0) != array.get(oldzigzag2, 0) or array.get(zigzag2, 1) != array.get(oldzigzag2, 1)
        if array.get(zigzag2, 2) == array.get(oldzigzag2, 2) and array.get(zigzag2, 3) == array.get(oldzigzag2, 3)
            line.delete(zzline2)
            label.delete(zzlabel2)
        if showzz == 'Show Zig Zag 2' or showzz == 'Show Both'
            zzline2 := line.new(x1 = math.round(array.get(zigzag2, 1)), y1 = array.get(zigzag2, 0), x2 = math.round(array.get(zigzag2, 3)), y2 = array.get(zigzag2, 2), color = dir2 == 1 ? upcol2 : dncol2, width = zz2width)
        if showhhll == 'Show HHLL 2' or showhhll == 'Show Both'
            hhlltxt = dir2 == 1 ? array.get(zigzag2, 0) > array.get(zigzag2, 4) ? 'HH' : 'LH' : array.get(zigzag2, 0) < array.get(zigzag2, 4) ? 'LL' : 'HL'
            hhlltxt := showprice ? hhlltxt + '\n' + formatPrice(array.get(zigzag2, 0)) : hhlltxt
            labelcol = dir2 == 1 ? array.get(zigzag2, 0) > array.get(zigzag2, 4) ? upcol2 : dncol2 : array.get(zigzag2, 0) < array.get(zigzag2, 4) ? dncol2 : upcol2
            zzlabel2 := label.new(x = math.round(array.get(zigzag2, 1)), y = array.get(zigzag2, 0), text = hhlltxt, color = labelcol, textcolor = txtcol, style = dir2 == 1 ? label.style_label_down : label.style_label_up)

// Advanced Fractal Plotting
plotshape(showFractals and upFractal, 
          title="📌 Up-Fractal", 
          style=shape.triangleup, 
          location=location.abovebar, 
          offset=-n, 
          color=color.new(fractalUpColor, 25))

plotshape(showFractals and dnFractal, 
          title="📌 Down-Fractal", 
          style=shape.triangledown, 
          location=location.belowbar, 
          offset=-n, 
          color=color.new(fractalDownColor, 25))