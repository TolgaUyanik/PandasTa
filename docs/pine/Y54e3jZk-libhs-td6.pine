//@version=6
// @description Library Overview Data for logger
library("libhs_td6")

int mq1=1
int mq2=2
int mq3=3
int mq4=4
int mq5=5
int mq6=6
int mqs=7
int rowLevel=8

const string o_skiplog = '^skip^'
const string tab2='  '
const string tab4='    '

export method helpData(matrix<string> dbus, int row)=>
    [dbus.get(row,mq1), dbus.get(row,mq2), dbus.get(row,mq3), dbus.get(row,mq4), dbus.get(row,mq5), dbus.get(row,mq6), dbus.get(row,mqs), dbus.get(row,rowLevel)]


export splitQ(string data)=>
    q2pos=str.pos(data,'@q2=')
    q3pos=str.pos(data,'@q3=')
    q4pos=str.pos(data,'@q4=')
    q5pos=str.pos(data,'@q5=')
    q6pos=str.pos(data,'@q6=')
    end=str.length(data)
    m1= str.substring(data,0,na(q2pos)?na(q3pos)?na(q4pos)?na(q5pos)?na(q6pos)?end:q6pos:q5pos:q4pos:q3pos:q2pos)
    m2= na(q2pos) ? '' : str.substring(data,q2pos+4,na(q3pos)?na(q4pos)?na(q5pos)?na(q6pos)?end:q6pos:q5pos:q4pos:q3pos)
    m3= na(q3pos) ? '' : str.substring(data,q3pos+4,na(q4pos)?na(q5pos)?na(q6pos)?end:q6pos:q5pos:q4pos)
    m4= na(q4pos) ? '' : str.substring(data,q4pos+4,na(q5pos)?na(q6pos)?end:q6pos:q5pos)
    m5= na(q5pos) ? '' : str.substring(data,q5pos+4,na(q6pos)?end:q6pos)
    m6= na(q6pos) ? '' : str.substring(data,q6pos+4,end)
    [m1,m2,m3,m4,m5,m6]

export getLibraryHelp(matrix<string> dbus, bool fillData=true) =>
    var _filled=false
    var helpBus = array.new<string>(0)

    if fillData and not _filled
        helpBus.push('')//do not display
        helpBus.push('### To get help on fields, methods and usage:')
        helpBus.push('')
        helpBus.push('import GETpacman/logger/4 as logger')
        helpBus.push('')
        helpBus.push('// Hover mouse over any of the functions to see library fields, methods and help right in the code editor')
        helpBus.push('')
        helpBus.push('logger.overview()')
        helpBus.push('logger.sampleCode()')
        helpBus.push('logger.fields()')
        helpBus.push('logger.methods()')

        for zx=0 to helpBus.size()-1
            data=helpBus.get(zx)
            [m1,m2,m3,m4,m5,m6]=splitQ(data)
            
            dbus.set(zx, mq1, m1)
            dbus.set(zx, mq2, m2)
            dbus.set(zx, mq3, m3)
            dbus.set(zx, mq4, m4)
            dbus.set(zx, mq5, m5)
            dbus.set(zx, mq6, m6)
        _filled:=true
        
    helpBus.clear()




