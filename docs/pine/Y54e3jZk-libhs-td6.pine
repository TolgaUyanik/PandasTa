        helpBus.push('@q2=method logx ( q,            msg,       status=na,     log=true,     tooltip=na, tipStatus=na,      font=na, tv=time)')
        helpBus.push('@q2=method logx ( q,   lvl,     msg,       status=na,     log=true,     tooltip=na, tipStatus=na,      font=na, tv=time)')
        helpBus.push('@q2=method logx ( q,   lvl,     msg, cq,   status=na,     log=true,     tooltip=na, tipStatus=na,      font=na, tv=time)')
        helpBus.push('@q2=method logx ( q,            msg, cq,   status=na,     log=true,     tooltip=na, tipStatus=na,      font=na, tv=time)')
        helpBus.push('')
        helpBus.push(' ● Row Management : ')        //  zh==70
        helpBus.push(' ◼︎ Resize / cleasr the queues')
        helpBus.push('@q2=method clear(),@q3=Clears all the queue, including bar_index and time queues, of existing messages')
        helpBus.push('@q2=method resize (rows=40)@q3=Resizes the message queues. If size is decreased then removes the oldest message.')
        helpBus.push('')
        helpBus.push('◼︎ Undo logged messages.')     //  zh==75
        helpBus.push('@q2=method undo (rows=1)')
        helpBus.push('@q3==> In normal logging, removes last as many nows')
        helpBus.push('@q3==> In asynchornous logging, removes last as many nows, from each queue')
        helpBus.push('@q3=        Simirlar to undo0(rows)')
        helpBus.push(' ◼︎ Undo asynchronously logged messages from all queues (only if asynchronous logging is enabled)')    //  zh==80
        helpBus.push('@q2=method undo0 (rows=1)')
        helpBus.push('')
        helpBus.push(' ◼︎ Undo asynchronously logged messages from Q1 to 6 (only if asynchronous logging is enabled)')       //  zh==83
        helpBus.push('@q2=method undo1 (rows=1)')
        helpBus.push('@q2=method undo2 (rows=1)')
        helpBus.push('@q2=method undo3 (rows=1)')
        helpBus.push('@q2=method undo4 (rows=1)')
        helpBus.push('@q2=method undo5 (rows=1)')
        helpBus.push('@q2=method undo6 (rows=1)')
        helpBus.push('')
        helpBus.push(' ◼︎ Undo asynchronously logged messages from specified Q (only if asynchronous logging is enabled)')   //  zh==91
        helpBus.push('@q2=method undoq(int q, int rows=1)')
        helpBus.push('')
        helpBus.push(" ● Don't forget to display ●")                //  zh==94
        helpBus.push('@q2=method showLog (position=position.bottom_right, hhalign, hvalign, hsize, thalign, tvalign, tsize, show, log attach)')
        helpBus.push('@q2=method showColors (position=position.bottom_left, showColors=true)')
        helpBus.push('')
        helpBus.push('@q2=method showColors (bool show) @q2=Display Color Table at Bottom Left of chart, if show is true')
        helpBus.push('@q2=method showColors (position=position.bottom_left) @q2=Display Color Table at position specified, show is passed as true')
        helpBus.push('@q2=method showColors (string position, bool show) @q2=Display Color Table at position specified, and if show is true')
        helpBus.push('')
        helpBus.push(' ● Attaching Console : ')        //  zh==102
        helpBus.push(' ◼︎ Attaches a console to Logx, or moves already attached console around Logx')
        helpBus.push("@q2=method attach (log attach, string position='anywhere')")
        helpBus.push('')
        helpBus.push(' ◼︎ Detaches the attached console from Logx.')     //  zh==106
        helpBus.push('@q2=method detach (log attachment)')
        helpBus.push('')
        helpBus.push('')
        helpBus.push(' ● Settings via methods : ')      //  zh==110
        helpBus.push('@q2=method setColors   (color[] c)')
        helpBus.push('@q2=method setColorsHC (color[] c)')
        helpBus.push('@q2=method setColorsBG (color[] c)')
        helpBus.push(' ◼︎ Set the color corresponding to Level Number')  //  zh==114
        helpBus.push('@q2=method setColor    (int e, color fg, color bg, color hc)')
        helpBus.push('')
        helpBus.push(' ◼︎ Reset level names used for corresponding Level Number')   //  zh==117 
        helpBus.push("@q2=method resetLevelNames (prefix='Level ', suffix='')")
        helpBus.push('@q2=method setLevelNames   (string[] names)')
        helpBus.push('@q2=method setLevelName    (int e, string levelName)')
        helpBus.push('')
        helpBus.push(' ◼︎ Removes log level names (and corresponding colors) from end of level name dB.')    //  zh==122
        helpBus.push('@q2=method removeLogLevels (count=1) @q3=Removes log level names (and corresponding colors) from end of level name dB')
        helpBus.push('@q2=method keepLogLevelsUpto (lvl=7) @q3=Keeps log level names (and corresponding colors) upto specified level number')
        helpBus.push('')    //  zh==125

        for zx=0 to helpBus.size()-1
            data=helpBus.get(zx)
            [m1,m2,m3,m4,m5,m6]=splitQ(data)

            dbus.set(zx,0,data)
            dbus.set(zx, mq1, m1)
            dbus.set(zx, mq2, m2)
            dbus.set(zx, mq3, m3)
            dbus.set(zx, mq4, m4)
            dbus.set(zx, mq5, m5)
            dbus.set(zx, mq6, m6)

        _filled:=true
        
    helpBus.clear()


export getLibraryUsage(matrix<string> dbus, bool fillData=true) =>
    var _filled=false
    var helpBus = array.new<string>(0)

    if fillData and not _filled
        helpBus.push('')//do not display
        helpBus.push('## **Console Sample Code**')  //  zh==1
        helpBus.push('Console = A sleek single cell logging with a limit of 40960 characters. When you dont need a large logging capability.')
        helpBus.push('')
        helpBus.push('//@version=6')
        helpBus.push('indicator("demo.Console", overlay=true)')
        helpBus.push('plot(na)')
        helpBus.push('')
        helpBus.push('import GETpacman/logger/4 as logger')
        helpBus.push('')
        helpBus.push('// Uncomment below line, then, hover mouse over console.log(), to see help info about this method')
        helpBus.push('//console.log()')
        helpBus.push('')
        helpBus.push("ip_showTable = input.bool  (true,          'Show Console?  ')")
        helpBus.push("ip_position  = input.string(position.bottom_right,'Position', options=[position.top_right,  position.bottom_left, position.bottom_right])")
        helpBus.push("ip_tsize     = input.string(size.auto,        'Text Size', options=[size.auto,size.tiny,size.small,size.normal,size.large,size.huge])")
        helpBus.push("ip_hsize     = ip_tsize")
        helpBus.push("ip_hhalign   = text.align_left")
        helpBus.push("ip_hvalign   = text.align_top")
        helpBus.push("ip_thalign   = text.align_left")
        helpBus.push("ip_tvalign   = text.align_top")
        helpBus.push('')
        helpBus.push('var console = logger.log.new()  ')    
        helpBus.push("console.init()   // init() should be called as first line after variable declaration")
        helpBus.push('')
        helpBus.push('if barstate.isfirst')
        helpBus.push('    console.markNewBar:=true')
        helpBus.push('    console.pageOnEveryBar:=false')
        helpBus.push('    console.showBarIndex:=false')
        helpBus.push('    console.frameColor:=color.red')
        helpBus.push('')
        helpBus.push('')
        helpBus.push('// Lets log some sample messges')
        helpBus.push('')
        helpBus.push("console.log('Hello  World')")
        helpBus.push("console.log('Hello  World is in status', 'Hello World')")
        helpBus.push("console.log('Status persists if we dont pass status message or pass it as na')")
        helpBus.push("console.log('We can set a tooltip too', 'Hello World has a tooltip',na,true,'I am a tooltip in console message, hover over me','Hello World as tooltip of status')")
        helpBus.push("console.log('This message will be skipped', na, false)")
        helpBus.push('')
        helpBus.push('')
        helpBus.push('console.showBarIndex:=true')
        helpBus.push("console.log(logger.trace,'This is sample TRACE message')")
        helpBus.push('console.showDateTime:=true')
        helpBus.push("console.debug('This is a sample DEBUG message')")
        helpBus.push('')
        helpBus.push("console.log(2,'Message is split across Q1 to Q6', 3,' this is q2', 4,' this is q3', logger.error, 'this is q4')")
        helpBus.push('console.showLogLevelNames:=true')
        helpBus.push("console.info('above message did not appear completely as we logged to 4 different queues, and only 1st queue is displayed')")
        helpBus.push('')
        helpBus.push('console.showBarIndex:=false')
        helpBus.push('console.showDateTime:=false')
        helpBus.push('console.showLogLevels:=false')
        helpBus.push('')
        helpBus.push("console.fatal('This is sample FATAL message ')")
        helpBus.push("console.warning('this is sample WARNING message')")
        helpBus.push('')
        helpBus.push("console.debug('There are lots of repeated messages in displayed in console, because on each bar, script is running and logging the messages.')")
        helpBus.push("console.debug('Setting PageOnEveryBar will clear the messages on each bar, which, for console is set to be false/off')")
        helpBus.push('')
        helpBus.push('// Settings can be changed anytime before show method is called., they take effect from the point they are called.')
        helpBus.push('console.frameColor:=color.blue')
        helpBus.push('')
        helpBus.push('//this wont throw error but is not used for console')
        helpBus.push('console.showHeader:=false')
        helpBus.push('')
        helpBus.push('// This should be the last line of your code, after all methods and settings have been dealt with.')
        helpBus.push('// No need to put inside barstate.islast condition, as its built in to do that, viz call itself on last bar only')
        helpBus.push('console.showLog(ip_position,ip_hhalign, ip_hvalign, ip_tsize,ip_thalign, ip_tvalign, ip_tsize,show=ip_showTable)')
        helpBus.push('')        //  zh==69

    if fillData and not _filled
        helpBus.push('## **Logx Sample Code**') //  zh==70
        helpBus.push('Logx = Multiple columns logging with a limit of 40960 characters each message. When you need to log large number of messages.')
        helpBus.push('')
        helpBus.push('//@version=6')
        helpBus.push('indicator("demo.Logx", overlay=true)')
        helpBus.push('plot(na)')
        helpBus.push('')
        helpBus.push('import GETpacman/logger/4 as logger')
        helpBus.push('')
        helpBus.push('// Uncomment below line, then, hover mouse over logx.log(), to see help info about this method')
        helpBus.push('//logx.log()')
        helpBus.push("ip_showTable = input.bool  (true,          'Show Logx?  ')")
        helpBus.push("ip_position  = input.string(position.bottom_right,'Position', options=[position.top_right, position.bottom_left, position.bottom_right])")
        helpBus.push("ip_tsize     = input.string(size.auto,        'Text Size', options=[size.auto,size.tiny,size.small,size.normal,size.large,size.huge])")
        helpBus.push('ip_hsize     = ip_tsize')
        helpBus.push('ip_hhalign   = text.align_left')
        helpBus.push('ip_hvalign   = text.align_top')
        helpBus.push('ip_thalign   = text.align_left')
        helpBus.push('ip_tvalign   = text.align_top')
        helpBus.push('')
        helpBus.push('var logx = logger.log.new()')  
        helpBus.push('logx.init(isConsole=false)  // init() should be called as first line after variable declaration')
        helpBus.push('')
        helpBus.push('if barstate.isfirst')
        helpBus.push('    logx.markNewBar:=false')
        helpBus.push('    logx.pageOnEveryBar:=true')
        helpBus.push('    logx.showBarIndex:=false')
        helpBus.push('    logx.showDateTime:=false')
        helpBus.push('    logx.frameColor:=color.green')
        helpBus.push("    logx.headerQ1:='Demo Q1'")
        helpBus.push("    logx.headerQ2:='Demo Q2'")
        helpBus.push("    logx.headerQ3:='Demo Q3'")
        helpBus.push('    logx.showQ4:=true')
        helpBus.push("    logx.headerQ4:='Demo q4'")
        helpBus.push('')
        helpBus.push('')
        helpBus.push('// Lets log some sample messges')
        helpBus.push('')
        helpBus.push("logx.log('Hello  World')")
        helpBus.push("logx.log('Hello  World is in status', 'Hello World')")
        helpBus.push("logx.log('Status persists if we dont pass status message or pass it as na')")
        helpBus.push("logx.log('We can set a tooltip too', 'Hello World has a tooltip',na, true,'I am a tooltip in logx message, hover over me','Hello World as tooltip of status')")
        helpBus.push("logx.log('This message will be skipped', na, false)")
        helpBus.push('')
        helpBus.push("logx.log(logger.trace,'This is a sample TRACE message')")
        helpBus.push("logx.debug('This is a sample DEBUG message')")
        helpBus.push('')
        helpBus.push("logx.log(2,'Different', 3,' colored', 4,' message', logger.error, 'across different queues', status='With Status set to this text')")
        helpBus.push('logx.showBarIndex:=true')
        helpBus.push('logx.showDateTime:=true')
        helpBus.push("logx.log(logger.trace, 2,'Different', 3,' colored', 4,' message', logger.error, 'across different queue, but BarIndex/DateTime different colored now ', status='With Status set to this text')")
        helpBus.push('')
        helpBus.push('logx.highlightText:=true')
        helpBus.push("logx.fatal('This is sample FATAL message with highlighting on')")
        helpBus.push("logx.warning('this is sample WARNING message  with highlighting on')")
        helpBus.push('logx.highlightText:=false')
        helpBus.push('')
        helpBus.push('// Settings can be changed anytime before show method is called., they take effect from the point they are called.')
        helpBus.push('logx.frameColor:=color.olive')
        helpBus.push('')
        helpBus.push('// This should be the last line of your code, after all methods and settings have been dealt with.')
        helpBus.push('// No need to put inside barstate.islast condition, as its built in to do that, viz call itself on last bar only')
        helpBus.push('logx.showLog(ip_position,ip_hhalign, ip_hvalign, ip_tsize,ip_thalign, ip_tvalign, ip_tsize,show=ip_showTable)')
        helpBus.push('')        //  zh==133

        for zx=0 to helpBus.size()-1
            data=helpBus.get(zx)
            [m1,m2,m3,m4,m5,m6]=splitQ(data)
            
            dbus.set(zx,0,data)
            dbus.set(zx, mq1, m1)
            dbus.set(zx, mq2, m2)
            dbus.set(zx, mq3, m3)
            dbus.set(zx, mq4, m4)
            dbus.set(zx, mq5, m5)
            dbus.set(zx, mq6, m6)

        _filled:=true
        
    helpBus.clear()

export getLibraryOverview(matrix<string> dbus, bool fillData=true) =>
    var _filled=false
    var helpBus = array.new<string>(0)

    if fillData and not _filled
        helpBus.push('')//do not display
        helpBus.push('▼ Library Overview ▼')    //  zh==1
        helpBus.push('')
        helpBus.push(' Logging can be done in two modes:')
        helpBus.push('◼︎ Console')
        helpBus.push('◼︎ Logx')
        helpBus.push('')
        helpBus.push('### Console')             //  zh==7
        helpBus.push('In this mode, logs are printed in a single cell of 40K characters, with a status bar.')
        helpBus.push('To enable this mode, use field `IsConsole:=true`')
        helpBus.push('There is buffer overrun protection while displaying the logs. Limit is 40,960 characters, as set by TradingView')
        helpBus.push('')
        helpBus.push('### Logx')                //  zh==12
        helpBus.push('In this mode, logs are printed across 6 queues, with option of logging to each queue independently.')
        helpBus.push('To enable this mode, use field `IsConsole:=false`')
        helpBus.push('')
        helpBus.push('### Log Levels')          //  zh==16
        helpBus.push('Each row of log can be set to log levels (36 provided, with 7 named), which are then used to color the rows/messages accordingly.')
        helpBus.push('Each row will have a log level (level.INFO = 3 if ommitted), with 7 levels specified as below:')
        helpBus.push('- 1 = TRACE      Gray')
        helpBus.push('- 2 = DEBUG      Green')
        helpBus.push('- 3 = INFO       Blue')
        helpBus.push('- 4 = WARNING    White')
        helpBus.push('- 5 = ERROR      Yellow')
        helpBus.push('- 6 = CRITICIAL  Orange')
        helpBus.push('- 7 = FATAL      Red')
        helpBus.push('')
        helpBus.push('There are 36 levels provided, with first 7 named as above, with rest named as LVL X, with X being 8 to 36.')
        helpBus.push('If you need more levels, or need to rename the levels, or need to redefine the colors, use methods/fields provided in the library')
        helpBus.push('If there are no colors defined for respective log level, that level will not be assigned to the row.')
        helpBus.push('• Level 0 is not used, hence when setting up your name names, or level numbers, index 0 of array will be ignored. Always setup your input array from index 1')
        helpBus.push('• Default 36 levels provided, which means internal array index 0 is not used and 1 to 36 are used, making it easy to use the level, but needing array size 37.')
        helpBus.push('')
        helpBus.push('### Colors')          //  zh==33
        helpBus.push('There are two modes of displaying the color:')
        helpBus.push('◼︎ Normal')
        helpBus.push('◼︎ Highlight')
        helpBus.push('')
        helpBus.push(' Normal: Using the Foreground/Background colors are expected')
        helpBus.push(' Highlight: Using the Foreground color as background color and a white/black/gray color as foreground color.')
        helpBus.push(' • If both HighlightText and ColorText set to true, then HighlightText will be taken as chosen option')
        helpBus.push('')
        helpBus.push('Color/Level Numbers always start from 1')
        helpBus.push('Color/Level Number 0 will be invisible, which hides the message, hence this is not allowed to be set for any message, as messages not visible can cause confusion.')
        helpBus.push('')
        helpBus.push('• Use method showColors() to display colors in a table, and correspinding log level names.')
        helpBus.push('')
        helpBus.push('### Asynchronous Mode (field `asyncLogging`)')    //  zh==47
        helpBus.push('In this mode, each of the message queue will run independently. This is a mode more relevant to Log and not to console.')
        helpBus.push('For example, Q1 could have four messages, Q2 could have three messages and Q3 just two of them.')
        helpBus.push('In this example, each queue will display messages at different row as they are independent.')
        helpBus.push('Where as in normal mode, the fourth row will display the last message of each queue, as all rows are getting some messages, or logged as empty if no messages.')
        helpBus.push('')
        helpBus.push('To enable, either call any of async mode logging methods such as logx, log1 etc., or set field asyncLogging:=true')
        helpBus.push('Using log() method in asynchronous mode will carry on logging all messages to end of each queue, if they are not not set to na.')
        helpBus.push('Using log0() will log all messages to end of each queue, even if its not enpty.')
        helpBus.push('')
        helpBus.push('### Reverting messages')          //  zh==57
        helpBus.push('Messages can be reverted using undo(), undoq(), undo1() and similar functions.')
        helpBus.push('undo() will remove messages from all rows, only if in normal mode and not in async mode.')
        helpBus.push('undoq(), undo1().. will remove messages for invdividual queues.')
        helpBus.push('')
        helpBus.push('### Attaching Console to Logx')   //  zh==62
        helpBus.push('There may be need for attaching a console to log or vice versa. This can be done using the same library.')
        helpBus.push('Look at code demo to see how this looks.')
        helpBus.push('')
        helpBus.push('### Auto Indenting')              //  zh==66
        helpBus.push('To indent logs further in at each level, set tabSizeQ to anything in between 1 to 8')
        helpBus.push('Setting this to 0 disables auto indenting. Library limits max tab size to 8')
        helpBus.push('')
        helpBus.push('### Defaults used in library')    //  zh==70
        helpBus.push('◼︎ MAXCHARS = 40960')
        helpBus.push('◼︎ maxTABsize = 8')                //  zh==72

        for zx=0 to helpBus.size()-1
            data=helpBus.get(zx)
            [m1,m2,m3,m4,m5,m6]=splitQ(data)
            
            dbus.set(zx, mq1, m1)
            dbus.set(zx, mq2, m2)
            dbus.set(zx, mq3, m3)
            dbus.set(zx, mq4, m4)
            dbus.set(zx, mq5, m5)
            dbus.set(zx, mq6, m6)

        _filled:=true
        
    helpBus.clear()