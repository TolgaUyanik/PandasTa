////Library

// @function Checks if the rate of change is slowing down (deceleration).
// @param data (float) The data series to check.
// @returns (bool) True if the absolute difference between the last two points is smaller than the previous difference.
export isSlowDown(float data) => math.abs(data[0] - data[1]) < math.abs(data[1] - data[2]) ? true : false

// @function Checks if the current value is the lowest in the given length.
// @param data (float) The data series to check.
// @param maeLength (int) The lookback length.
// @returns (bool) True if current value is the lowest.
export isMin(float data, int maeLength) => ta.lowest(data, maeLength) == data[0] ? true : false

// @function Checks if the current value is the highest in the given length.
// @param data (float) The data series to check.
// @param maeLength (int) The lookback length.
// @returns (bool) True if current value is the highest.
export isMax(float data, int maeLength) => ta.highest(data, maeLength) == data[0] ? true : false

// @function Checks if a minimum has formed and the price has started to rise (pivot low).
// @param data (float) The data series to check.
// @param maeLength (int) The lookback length.
// @returns (bool) True if the previous bar was the lowest and current bar is higher or equal.
export isMinStopped(float data, int maeLength) => ta.lowest(data, maeLength) == data[1] and data[1] <= data[0] ? true : false

// @function Checks if a maximum has formed and the price has started to fall (pivot high).
// @param data (float) The data series to check.
// @param maeLength (int) The lookback length.
// @returns (bool) True if the previous bar was the highest and current bar is lower or equal.
export isMaxStopped(float data, int maeLength) => ta.highest(data, maeLength) == data[1] and data[1] >= data[0] ? true : false

// @function Checks for a minimum at a specific distance in the past, confirming a stop.
// @param data (float) The data series to check.
// @param maeLength (int) The lookback length for the lowest calculation.
// @param distance (int) The specific bar index back to check for the low.
// @returns (bool) True if the low was at the specific distance and price has turned up.
export isLongMinStopped(float data, int maeLength, int distance) => ta.lowest(data, maeLength) == data[distance] and data[1] <= data[0] ? true : false

// @function Checks for a maximum at a specific distance in the past, confirming a stop.
// @param data (float) The data series to check.
// @param maeLength (int) The lookback length for the highest calculation.
// @param distance (int) The specific bar index back to check for the high.
// @returns (bool) True if the high was at the specific distance and price has turned down.
export isLongMaxStopped(float data, int maeLength, int distance) => ta.highest(data, maeLength) == data[distance] and data[1] >= data[0] ? true : false

// @function Checks if a boolean value exists in a range, skipping the current bar.
// @param data (bool) The boolean series to check.
// @param findRange (int) The lookback range.
// @param findValue (bool) The value (true/false) to search for.
// @returns (bool) True if found in the range [1..findRange].
export isMachedInRangeSkipCurrent(bool data, int findRange, bool findValue) =>
    p_result = false
    for i = 1 to findRange
        if data[i] == findValue
            p_result := true
            break
    p_result

// @function Checks if a boolean value exists in a range including the current bar.
// @param data (bool) The boolean series to check.
// @param findRange (int) The lookback range.
// @param findValue (bool) The value (true/false) to search for.
// @returns (bool) True if found in the range [0..findRange].
export isMachedInRange(bool data, int findRange, bool findValue) =>
    p_result = false
    for i = 0 to findRange
        if data[i] == findValue
            p_result := true
            break
    p_result

// @function Checks if a specific color exists in a series of colors within a range.
// @param data (series color) The color series to check.
// @param findRange (int) The lookback range.
// @param findValue (color) The color to search for.
// @returns (bool) True if the color is found.
export isMachedColorInRange(series color data, int findRange, color findValue) =>
    p_result = false
    for i = 0 to findRange
        if data[i] == findValue
            p_result := true
            break
    p_result

// @function Counts occurrences of a boolean value within a range.
// @param data (bool) The boolean series to check.
// @param findRange (int) The lookback range.
// @param findValue (bool) The value to count.
// @returns (int) The number of occurrences.
export countMachedInRange(bool data, int findRange, bool findValue) =>
    p_result = 0
    for i = 0 to findRange
        if data[i] == findValue
            p_result := p_result + 1
    p_result

// @function Determines a color based on the acceleration and direction of the data.
// @param data (float) The data series.
// @returns (color) Calculated color (aqua, red, white, purple, blue).
export getColor(float data) =>
    distance = math.abs(data[1] - data[2]) - math.abs(data - data[1])
    return_color = distance < 0 ? data > data[1] ? color.aqua : color.red : distance == 0 ? color.white : data < data[1] ? color.purple : color.blue

// @function Determines a complex color based on velocity, acceleration and direction.
// @param data (float) The data series.
// @returns (color) Calculated color based on momentum logic.
export getColorNew(float data) => 
    distance = math.abs(data[1] - data[2]) - math.abs(data - data[1])
    velocity = math.abs(data - data[1]) / math.abs(data[1] - data[2]) 
    speed_color = color.purple
    if data > data[1] // going up
        speed_color := distance < 0 ? color.lime : velocity < 0.2 ? color.white : color.teal
    if data < data[1] // going down
        speed_color := distance < 0 ? color.red : velocity < 0.2 ? color.white : color.yellow
    if data == data[1]
        speed_color := color.yellow
    speed_color

// @function Checks if the color transition indicates an improvement (e.g. Navy/Red to White/Lime/Teal).
// @param color_data (color) The color series.
// @returns (bool) True if the color state improved.
export isColorBetter(color color_data) => (color_data[1] == color.navy or color_data[1] == color.red) and (color_data == color.white or color_data == color.lime or color_data == color.teal) ? true : false

// @function Checks if the color transition indicates a worsening state.
// @param color_data (color) The color series.
// @returns (bool) True if the color state worsened.
export isColorWorst(color  color_data) => (color_data[1] == color.lime or color_data[1] == color.teal) and (color_data == color.white or color_data == color.navy or color_data == color.red) ? true : false

// @function Checks if the color transition indicates an improvement from White.
// @param color_data (color) The color series.
// @returns (bool) True if transitioning from White to Lime/Teal.
export isColorBetter2(color color_data) => (color_data[1] == color.white) and (color_data == color.lime or color_data == color.teal) ? true : false

// @function Checks if the color transition indicates a worsening from White.
// @param color_data (color) The color series.
// @returns (bool) True if transitioning from White to White/Navy/Red.
export isColorWorst2(color color_data) => (color_data[1] == color.white) and (color_data == color.white or color_data == color.navy or color_data == color.red) ? true : false

// @function Checks if the data has decreased over the last 3 bars (2 steps).
// @param data (float) The data series.
// @returns (bool) True if data[2] < data[1] < data[0].
export isDecreased2Bar(float data) => result = data[2] < data[1] and data[1] < data[0]

// @function Checks if a boolean series has been continuously true with limited exceptions.
// @param targetSeries (bool) The series to check.
// @param range2Find (int) The range to check.
// @param howManyException (int) Allowed number of 'false' values in the range.
// @returns (bool) True if the series is mostly true.
export isContinuousAdvance(bool targetSeries, int range2Find, int howManyException) =>
    isTrue = true
    expCount = 0
    for i=0 to range2Find - 1
        if targetSeries[i] == false
            expCount += 1
    if (expCount != howManyException or expCount == 0) or not (targetSeries[0] == true and targetSeries[range2Find - 1] == true)
        isTrue := false
    isTrue

// @function Checks if a series matches a specific boolean state continuously.
// @param targetSeries (bool) The series to check.
// @param range2Find (int) The range to check.
// @param truefalse (bool) The state (true/false) that should NOT be present (logic seems inverted in code: breaks if matches truefalse).
// @returns (bool) Returns true if the `truefalse` value is NEVER found (Continuous Opposite).
export isContinuous(bool targetSeries, int range2Find, bool truefalse) =>
    isTrue = true
    for i=0 to range2Find - 1
        if not na(targetSeries[i]) and targetSeries[i] == truefalse
            isTrue := false
            continue
    isTrue

// @function Checks continuity starting from the previous bar (skipping current).
// @param targetSeries (bool) The series to check.
// @param range2Find (int) The range to check.
// @param truefalse (bool) The state that breaks continuity.
// @returns (bool) True if continuous from index 1.
export isContinuousNotNow(bool targetSeries, int range2Find, bool truefalse) =>
    isTrue = true
    for i=1 to range2Find 
        if not na(targetSeries[i]) and targetSeries[i] == truefalse
            isTrue := false
            continue
    isTrue

// @function Checks continuity of two factors (wrapper for isContinuous).
// @param targetSeries (bool) The series to check.
// @param range2Find (int) The range to check.
// @param truefalse (bool) The state that breaks continuity.
// @returns (bool) True if continuous.
export isContinuousTwoFactors(bool targetSeries, int range2Find, bool truefalse) =>
    isTrue = true
    for i=0 to range2Find - 1
        if not na(targetSeries[i]) and targetSeries[i] == truefalse
            isTrue := false
            continue
    isTrue

// @function Checks if an event occurred within a specific historical window relative to the current bar.
// @param startDataBarIndex (int) The starting bar index of the event.
// @param neededDataBarIndex (int) The target bar index.
// @param currentBarIndex (int) The current bar index.
// @returns (bool) True if the indices align within range.
export findEventInRange(int startDataBarIndex, int neededDataBarIndex, int currentBarIndex) =>
    result = false
    if startDataBarIndex < neededDataBarIndex and currentBarIndex > neededDataBarIndex
        result := true
    result

// @function Finds the minimum value among four float inputs.
// @param firstdata (float) First value.
// @param secondata (float) Second value.
// @param thirddata (float) Third value.
// @param forthdata (float) Fourth value.
// @returns (float) The minimum value.
export findMin(float firstdata, float secondata,float thirddata,float forthdata) =>
    result = firstdata
    if result > secondata
        result := secondata
    if result > thirddata
        result := thirddata
    if result > forthdata
        result := forthdata
    // if result > fifthdata
    //     result := fifthdata
    result

// @function Finds the maximum value among four float inputs.
// @param firstdata (float) First value.
// @param secondata (float) Second value.
// @param thirddata (float) Third value.
// @param forthdata (float) Fourth value.
// @returns (float) The maximum value.
export findMax(float firstdata, float  secondata=0, float thirddata=0, float forthdata=0) =>
    result = firstdata
    if result < secondata
        result := secondata
    if result < thirddata
        result := thirddata
    if result < forthdata
        result := forthdata
    // if result < fifthdata
    //     result := fifthdata
    result


Var_Func(src, length) =>
    valpha = 2 / (length + 1)
    vud1 = src > src[1] ? src - src[1] : 0
    vdd1 = src < src[1] ? src[1] - src : 0
    vUD = math.sum(vud1, 9)
    vDD = math.sum(vdd1, 9)
    vCMO = nz((vUD - vDD) / (vUD + vDD))
    VAR = 0.0
    VAR := nz(valpha * math.abs(vCMO) * src) + (1 - valpha * math.abs(vCMO)) * nz(VAR[1])
    VAR
Wwma_Func(src, length) =>
    wwalpha = 1 / length
    WWMA = 0.0
    WWMA := wwalpha * src + (1 - wwalpha) * nz(WWMA[1])
    WWMA

Zlema_Func(src, length) =>
    zxLag = length / 2 == math.round(length / 2) ? length / 2 : (length - 1) / 2
    zxEMAData = src + src - src[zxLag]
    ZLEMA = ta.ema(zxEMAData, length)
    ZLEMA

Tsf_Func(src, length) =>
    lrc = ta.linreg(src, length, 0)
    lrc1 = ta.linreg(src, length, 1)
    lrs = lrc - lrc1
    TSF = ta.linreg(src, length, 0) + lrs
    TSF


EMA(x, t) =>
    EMA1 = x
    EMA1 := na(EMA1[1]) ? x : (x - nz(EMA1[1])) * (2 / (t + 1)) + nz(EMA1[1])
    EMA1

// @function Calculates various types of Moving Averages based on the string selector.
// @param src (float) The input source series.
// @param length (int) The length of the moving average.
// @param mav (string) The type of MA ('SMA', 'EMA', 'RMA', 'VWMA', 'WMA', 'DEMA', 'TEMA', 'TMA', 'VAR', 'WWMA', 'ZLEMA', 'TSF', 'HULL', 'TILL'). Default is 'EMA'.
// @returns (float) The calculated moving average.
export getMA(float src,simple int length,string mav='EMA') =>
    sma = ta.sma(src, length)
    ema = ta.ema(src, length)
    rma = ta.rma(src, length)
    vwma = ta.vwma(src, length)
    wma = ta.wma(src, length)
    DEMA = 2 * ta.ema(src, length) - ta.ema(ta.ema(src, length), length)
    tma = ta.sma(ta.sma(src, math.ceil(length / 2)), math.floor(length / 2) + 1)
    VAR = Var_Func(src, length)
    WWMA = Wwma_Func(src, length)
    ZLEMA = Zlema_Func(src, length)
    TSF = Tsf_Func(src, length)
    HMA = ta.wma(2 * ta.wma(src, length / 2) - ta.wma(src, length), math.round(math.sqrt(length)))
    TEMA = 3 * (EMA(src, length) - EMA(EMA(src, length), length)) + EMA(EMA(EMA(src, length), length), length)  

    T3a1 = 0.7 //input.float(0.7, 'TILLSON T3 Volume Factor', step=0.1, group='ATR Supertrend', inline = 'ATR')
    T3e1 = ta.ema(src, length)
    T3e2 = ta.ema(T3e1, length)
    T3e3 = ta.ema(T3e2, length)
    T3e4 = ta.ema(T3e3, length)
    T3e5 = ta.ema(T3e4, length)
    T3e6 = ta.ema(T3e5, length)
    T3c1 = -T3a1 * T3a1 * T3a1
    T3c2 = 3 * T3a1 * T3a1 + 3 * T3a1 * T3a1 * T3a1
    T3c3 = -6 * T3a1 * T3a1 - 3 * T3a1 - 3 * T3a1 * T3a1 * T3a1
    T3c4 = 1 + 3 * T3a1 + T3a1 * T3a1 * T3a1 + 3 * T3a1 * T3a1
    T3 = T3c1 * T3e6 + T3c2 * T3e5 + T3c3 * T3e4 + T3c4 * T3e3

    ma = 0.0
    if mav == 'SMA'
        ma := sma
        ma

    if mav == 'EMA'
        ma := ema
        ma

    if mav == 'RMA'
        ma := rma
        ma

    if mav == 'VWMA'
        ma := vwma
        ma

    if mav == 'WMA'
        ma := wma
        ma

    if mav == 'DEMA'        
        ma := DEMA
        ma

    if mav == 'TEMA'
        ma := TEMA
        ma

    if mav == 'TMA'
        ma := tma
        ma

    if mav == 'VAR'
        
        ma := VAR
        ma

    if mav == 'WWMA'
        
        ma := WWMA
        ma

    if mav == 'ZLEMA'
        

        ma := ZLEMA
        ma

    if mav == 'TSF'
        
        ma := TSF
        ma

    if mav == 'HULL'
        
        ma := HMA
        ma

    if mav == 'TILL'
        
        ma := T3
        ma
    ma


////////////////////////////////////////////////////////////////////////////////////////////
////

// functions 
//
matrix_get(A, i, j, nrows) =>
    // Get the value of the element of an implied 2d matrix
    //input: 
    // A :: array: pseudo 2d matrix A = [[column_0],[column_1],...,[column_(n-1)]]
    // i :: integer: row number
    // j :: integer: column number
    // nrows :: integer: number of rows in the implied 2d matrix
    array.get(A, i + nrows * j)
//
matrix_set(A, value, i, j, nrows) =>
    // Set a value to the element of an implied 2d matrix
    //input: 
    // A :: array, changed on output: pseudo 2d matrix A = [[column_0],[column_1],...,[column_(n-1)]]
    // value :: float: the new value to be set
    // i :: integer: row number
    // j :: integer: column number
    // nrows :: integer: number of rows in the implied 2d matrix
    array.set(A, i + nrows * j, value)
//
transpose(A, nrows, ncolumns) =>
    // Transpose an implied 2d matrix
    // input:
    // A :: array: pseudo 2d matrix A = [[column_0],[column_1],...,[column_(n-1)]]
    // nrows :: integer: number of rows in A
    // ncolumns :: integer: number of columns in A
    // output:
    // AT :: array: pseudo 2d matrix with implied dimensions: _ncolums x _nrows
    var AT = array.new_float(nrows * ncolumns, 0)
    for i = 0 to nrows - 1 by 1
        for j = 0 to ncolumns - 1 by 1
            matrix_set(AT, matrix_get(A, i, j, nrows), j, i, ncolumns)
    AT
//
multiply(A, B, nrowsA, ncolumnsA, ncolumnsB) =>
    // Calculate scalar product of two matrices
    // input: 
    // A :: array: pseudo 2d matrix
    // B :: array: pseudo 2d matrix
    // nrowsA :: integer: number of rows in A
    // ncolumnsA :: integer: number of columns in A
    // ncolumnsB :: integer: number of columns in B
    // output:
    // C:: array: pseudo 2d matrix with implied dimensions nrowsA x ncolumnsB
    var C = array.new_float(nrowsA * ncolumnsB, 0)
    int   nrowsB   = ncolumnsA
    float elementC = 0.0
    for i     = 0 to nrowsA - 1    by 1
        for j = 0 to ncolumnsB - 1 by 1
            elementC     := 0
            for k = 0 to ncolumnsA - 1 by 1
                elementC += matrix_get(A, i, k, nrowsA) * matrix_get(B, k, j, nrowsB)
            matrix_set(C, elementC, i, j, nrowsA)
    C
//
vnorm(X, n) =>
    //Square norm of vector X with size n
    float norm = 0.0
    for i = 0 to n - 1 by 1
        norm += math.pow(array.get(X, i), 2)
    math.sqrt(norm)
//
qr_diag(A, nrows, ncolumns) =>
    //QR Decomposition with Modified Gram-Schmidt Algorithm (Column-Oriented)
    // input:
    // A :: array: pseudo 2d matrix A = [[column_0],[column_1],...,[column_(n-1)]]
    // nrows :: integer: number of rows in A
    // ncolumns :: integer: number of columns in A
    // output:
    // Q: unitary matrix, implied dimenstions nrows x ncolumns
    // R: upper triangular matrix, implied dimansions ncolumns x ncolumns
    var Q     = array.new_float(nrows    * ncolumns, 0)
    var R     = array.new_float(ncolumns * ncolumns, 0)
    var a     = array.new_float(nrows, 0)
    var q     = array.new_float(nrows, 0)
    float r   = 0.0
    float aux = 0.0
    //get first column of A and its norm:
    for i = 0 to nrows - 1 by 1
        array.set(a, i, matrix_get(A, i, 0, nrows))
    r := vnorm(a, nrows)
    //assign first diagonal element of R and first column of Q
    matrix_set(R, r, 0, 0, ncolumns)
    for i = 0 to nrows - 1 by 1
        matrix_set(Q, array.get(a, i) / r, i, 0, nrows)
    if  ncolumns != 1
        //repeat for the rest of the columns
        for k = 1     to ncolumns - 1 by 1
            for i = 0 to nrows - 1    by 1
                array.set(a, i, matrix_get(A, i, k, nrows))
            for j = 0 to k - 1        by 1
                //get R_jk as scalar product of Q_j column and A_k column:
                r := 0
                for i  = 0 to nrows - 1 by 1
                    r += matrix_get(Q, i, j, nrows) * array.get(a, i)
                matrix_set(R, r, j, k, ncolumns)
                //update vector _a
                for i = 0 to nrows - 1 by 1
                    aux := array.get(a, i) - r * matrix_get(Q, i, j, nrows)
                    array.set(a, i, aux)
            //get diagonal R_kk and Q_k column
            r := vnorm(a, nrows)
            matrix_set(R, r, k, k, ncolumns)
            for i = 0 to nrows - 1 by 1
                matrix_set(Q, array.get(a, i) / r, i, k, nrows)
    [Q, R]
//
pinv(A, nrows, ncolumns) =>
//Pseudoinverse of matrix A calculated using QR decomposition
// Input: 
// A:: array: implied as a (nrows x ncolumns) matrix A = [[column_0],[column_1],...,[column_(ncolumns-1)]]
// Output: 
// Ainv:: array implied as a (ncolumns x nrows) matrix A = [[row_0],[row_1],...,[row_(nrows-1)]]
// ----
// First find the QR factorization of A: A = QR,
// where R is upper triangular matrix.
// Then Ainv = R^-1*Q^T.
// ----
    [_Q, _R] = qr_diag(A, nrows, ncolumns)
    QT = transpose(_Q, nrows, ncolumns)
    // Calculate Rinv:
    var Rinv = array.new_float(ncolumns * ncolumns, 0)
    float r = 0.0
    matrix_set(Rinv, 1 / matrix_get(_R, 0, 0, ncolumns), 0, 0, ncolumns)
    if ncolumns != 1
        for j = 1 to ncolumns - 1 by 1
            for i = 0 to j - 1 by 1
                r := 0.0
                for k = i to j - 1 by 1
                    r += matrix_get(Rinv, i, k, ncolumns) * matrix_get(_R, k, j, ncolumns)
                matrix_set(Rinv, r, i, j, ncolumns)
            for k = 0 to j - 1 by 1
                matrix_set(Rinv, -matrix_get(Rinv, k, j, ncolumns) / matrix_get(_R, j, j, ncolumns), k, j, ncolumns)
            matrix_set(Rinv, 1 / matrix_get(_R, j, j, ncolumns), j, j, ncolumns)
    //
    Ainv = multiply(Rinv, QT, ncolumns, ncolumns, nrows)
    Ainv
//
mae(x, xhat) =>
    // Mean Average Error
    // x    :: array float, original data
    // xhat :: array float, model estimate
    // output
    // nrmse:: float
    float mae = 0.0
    if array.size(x) != array.size(xhat)
        mae := na
    else
        int N = array.size(x)
        for i = 0 to N - 1 by 1
            mae += math.abs(array.get(x, i) - array.get(xhat, i)) / N
    mae
//

// @function Calculates Modular Regression / Polynomial Regression using Matrix operations.
// @param mrb_src (float) The input source series.
// @param mrb_window (int) The window size (lookback period).
// @param mrb_degree (int) The degree of the polynomial.
// @returns ([float, float, float]) A tuple containing: [Trend Value, Forecast Value, Mean Absolute Error].
export mr(float mrb_src, int mrb_window, int  mrb_degree) =>
    // Vandermonde matrix with implied dimensions (mrb_window x mrb_degree+1)
    // Linear form: J = [ [z]^0, [z]^1, ... [z]^mrb_degree], with z = [ (1-mrb_window)/2 to (mrb_window-1)/2 ] 
    J = array.new_float(mrb_window * (mrb_degree + 1), 0)
    for i = 0 to mrb_window - 1 by 1
        for j = 0 to mrb_degree by 1
            matrix_set(J, math.pow(i, j), i, j, mrb_window)
    // Vector of raw datapoints:
    var Y_raw = array.new_float(mrb_window, na)
    for j = 0 to mrb_window - 1 by 1
        array.set(Y_raw, j, mrb_src[mrb_window - 1 - j])
    // Calculate polynomial coefficients which minimize the loss function
    C = pinv(J, mrb_window, mrb_degree + 1)
    a_coef = multiply(C, Y_raw, mrb_degree + 1, mrb_window, 1)
    // For smoothing, approximate the last point (i.e. z=mrb_window-1) by a0
    float Y = 0.0
    for i = 0 to mrb_degree by 1
        Y += array.get(a_coef, i) * math.pow(mrb_window - 1, i)
    // Trend Direction Forecast
    float Y_f = 0.0
    for i = 0 to mrb_degree by 1
        Y_f += array.get(a_coef, i) * math.pow(mrb_window, i)
    // Calculates data estimate (needed for rmse)
    Y_hat = multiply(J, a_coef, mrb_window, mrb_degree + 1, 1)
    err  = mae(Y_raw, Y_hat)
    [Y, Y_f, err]


RMA(x, t) =>
    EMA1 = x
    EMA1 := na(EMA1[1]) ? x : (x - nz(EMA1[1])) * (1/t) + nz(EMA1[1])
    EMA1

// @function Calculates a Bandpass Filter / Dominant Cycle amplitude.
// @param maeLength (int) The length used for internal calculations (cycle period).
// @param bpw (float) Bandwidth parameter.
// @param mult (float) Multiplier for the final output.
// @returns (float) The calculated cycle amplitude.
export bpDom(int maeLength, float bpw, float mult) =>
    HP = 0.0
    BP = 0.0
    Peak = 0.0
    Real = 0.0
    counter = 0.0
    DC = 0.0
    alpha2 = (math.cos(0.25 * bpw * 2 * math.pi / maeLength) + math.sin(0.25 * bpw * 2 * math.pi  / maeLength) - 1) / math.cos(0.25 * bpw * 2 * math.pi / maeLength)
    HP := (1 + alpha2 / 2) * (close - nz(close[1])) + (1 - alpha2) * nz(HP[1])
    beta1 = math.cos(2 * math.pi / maeLength)
    gamma1 = 1 / math.cos(2 * math.pi * bpw / maeLength)
    alpha1 = gamma1 - math.sqrt(gamma1 * gamma1 - 1)
    BP := 0.5 * (1 - alpha1) * (HP - nz(HP[2])) + beta1 * (1 + alpha1) * nz(BP[1]) - alpha1 * nz(BP[2])
    BP := bar_index == 1 or bar_index == 2  ? 0 : BP
    Peak := 0.991 * Peak
    Peak := math.abs(BP) > Peak ? math.abs(BP) : Peak
    Real := Peak != 0 ?  BP / Peak : Real
    DC := nz(DC[1])
    DC := DC < 6 ? 6 : DC
    counter := counter[1] + 1
    if ta.crossover(Real, 0) or ta.crossunder(Real, 0)
        DC := 2 * counter
        if 2 * counter > 1.25 * nz(DC[1])
            DC := 1.25 * DC[1]
        if 2 * counter < 0.8 * nz(DC[1])
            DC := 0.8 * nz(DC[1])
        counter := 0
    temp_out = mult * DC
    temp_out

// Helper for SMI calculation (assumed dependency)
emaEma(src, length) => ta.ema(ta.ema(src, length), length)

// @function Calculates the Stochastic Momentum Index (SMI).
// @param _close (float) Close price.
// @param _high (float) High price.
// @param _low (float) Low price.
// @param _lenthK (int) The length for the K smoothing (Main).
// @param _lengthD (int) The length for the D smoothing (Signal).
// @returns (float) The Stochastic Momentum Index value.
export getSMI(float _close, float _high, float _low, int _lenthK, int _lengthD) =>
    _highestHigh = ta.highest(_high, _lenthK)
    _lowestLow =   ta.lowest(_low, _lenthK)
    _highestLowestRange = _highestHigh - _lowestLow
    _relativeRange = _close - (_highestHigh + _lowestLow) / 2
    _smi = 200 * (emaEma(_relativeRange, _lengthD) / emaEma(_highestLowestRange, _lengthD))
    _smi