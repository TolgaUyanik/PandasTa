//@version=6

// @description A comprehensive validation framework for Pine Script strategies and indicators. This library provides
//   centralised validation capabilities for common trading system requirements including position sizing, risk management,
//   signal processing, and configuration validation. Designed to improve code maintainability and provide consistent
//   error handling across complex trading strategies.
library("ValidationUtilities")

const int VERSION = 2  // Matches TradingView import version

//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  CORE VALIDATION FRAMEWORK  ]------
//----------------------------------------------------------------------------------------------------------------------------- //

// ------[  Validation Framework UDT  ]------ //

// @type            		Centralised validation framework for consistent error handling across trading systems
// @field errors    		<array<string>> Collection of validation error messages that prevent strategy execution
// @field warnings  		<array<string>> Collection of validation warning messages that suggest improvements
// @field has_errors 		<bool> Whether any validation errors were found (stops execution when true)
// @field has_warnings 		<bool> Whether any validation warnings were found (shows alerts but continues execution)
export type ValidationFramework
    array<string> errors
    array<string> warnings
    bool has_errors     = false
    bool has_warnings   = false

// ------[  Core Framework Methods  ]------ //

// @function        		Initialises the validation framework, clearing any existing state
// @param self      		<ValidationFramework> The framework instance to initialise
// @returns         		None (initialises internal arrays and resets flags)
export method init(ValidationFramework self) =>
    self.errors   := array.new<string>()
    self.warnings := array.new<string>()
    self.has_errors := false
    self.has_warnings := false

// @function        		Adds a validation error with consistent formatting for critical issues that prevent execution
// @param self      		<ValidationFramework> The framework instance
// @param category  		<string> Category of the error (e.g., 'TP Settings', 'Entry Configuration', 'Position Sizing')
// @param message   		<string> Detailed error message explaining the specific issue
// @returns         		None (adds error to collection and sets has_errors flag)
export method add_error(ValidationFramework self, string category, string message) =>
    formatted_error = str.format('[{0}] {1}', category, message)
    self.errors.push(formatted_error)
    self.has_errors := true

// @function        		Adds a validation warning with consistent formatting for issues that suggest improvements
// @param self      		<ValidationFramework> The framework instance
// @param category  		<string> Category of the warning (e.g., 'Risk Management', 'Performance')
// @param message   		<string> Detailed warning message explaining the potential issue
// @returns         		None (adds warning to collection and sets has_warnings flag)
export method add_warning(ValidationFramework self, string category, string message) =>
    formatted_warning = str.format('[{0}] {1}', category, message)
    self.warnings.push(formatted_warning)
    self.has_warnings := true

// @function        		Triggers runtime errors for all collected validation errors, stopping script execution
// @param self      		<ValidationFramework> The framework instance
// @returns         		None (triggers runtime.error for first error found, with count of additional errors)
// @note                 Kept for back-compatibility and existing version pins. For a click-free surface that lists every
//                       collected issue at once, prefer render_banner() + issues_as_text() over the single-string halt.
export method trigger_errors(ValidationFramework self) =>
    if self.has_errors and self.errors.size() > 0
        first_error = self.errors.get(0)
        additional_count = self.errors.size() - 1
        
        if additional_count > 0
            runtime.error(str.format('{0}\n\n({1} additional configuration error{2} detected. Please review all settings.)',
              first_error, str.tostring(additional_count), additional_count > 1 ? 's' : ''))
        else
            runtime.error(first_error)

// @function        		Displays runtime warnings without stopping execution using chart labels
// @param self      		<ValidationFramework> The framework instance
// @param yloc_arg 			<string> yloc argument for label.new (e.g. yloc.abovebar, yloc.belowbar)
// @returns         		None (displays warnings via label if any exist, then clears warnings to avoid repetition)
// @note                 Shows only the first warning plus a "+N more" tail. For a full priority-ordered surface that lists
//                       every collected error and/or warning, prefer render_banner() + issues_as_text().
export method display_warnings(ValidationFramework self, string yloc_arg = yloc.belowbar) =>
    if self.has_warnings and self.warnings.size() > 0
        warning_text = self.warnings.get(0) // Display first warning
        if self.warnings.size() > 1
            warning_text += str.format('\n(+{0} more warnings)', str.tostring(self.warnings.size() - 1))
        
        label.new(bar_index, yloc_arg == yloc.abovebar ? high : low, warning_text,
          yloc = yloc_arg,
          color = color.new(#EC7298, 20),
          style = yloc_arg == yloc.abovebar ? label.style_label_down : label.style_label_up,
          textcolor = color.new(#4A001F, 0),
          size = size.small)
        
        // Clear warnings after display to avoid repetition on subsequent bars
        self.warnings.clear()
        self.has_warnings := false

// @function        		Joins the framework's collected items into a single body string for a banner or log line
// @param self      		<ValidationFramework> The framework instance
// @param include_errors 	<bool> Whether to include collected errors (prefixed "✕ ")
// @param include_warnings 	<bool> Whether to include collected warnings (prefixed "⚠ ")
// @returns         		<string> One item per line ("✕ [cat] msg" / "⚠ [cat] msg"); empty string when nothing selected
export method issues_as_text(ValidationFramework self, bool include_errors = true, bool include_warnings = true) =>
    string body = ""
    if include_errors and not na(self.errors) and self.errors.size() > 0
        for i = 0 to self.errors.size() - 1
            body += (body == "" ? "" : "\n") + "✕ " + self.errors.get(i)
    if include_warnings and not na(self.warnings) and self.warnings.size() > 0
        for i = 0 to self.warnings.size() - 1
            body += (body == "" ? "" : "\n") + "⚠ " + self.warnings.get(i)
    body

// @function        		Draws a rich, click-free status banner (bold title row + left-aligned body row) as a 1×2 table
// @param title     		<string> Banner headline, rendered bold in the top row
// @param body      		<string> Multi-line body text, left-aligned in the bottom row (caller supplies curated content)
// @param ypos      		<string> Table position (e.g. position.middle_center, position.top_center)
// @param bg_color  		<color> Background colour; when na a dark-mode-aware default is used
// @param dark_mode 		<bool> Selects the default background when bg_color is na (dark vs light chart theme)
// @returns         		None (creates/updates a table on the chart; the preferred surface over trigger_errors/display_warnings)
// @note                 Call every bar the surface may change. Passing an empty title AND body clears the cells, so a
//                       previously-rendered banner does not linger once its condition no longer holds (the table object
//                       persists but becomes invisible). This lets a caller drive it from a single unconditional call.
export render_banner(string title, string body, string ypos = position.middle_center, color bg_color = na, bool dark_mode = false) =>
    var table tbl_banner = table.new(ypos, columns = 1, rows = 2, frame_width = 1, frame_color = color.new(color.gray, 50), force_overlay = true)
    if title == "" and body == ""
        table.clear(tbl_banner, 0, 0, 0, 1)
    else
        color resolved_bg = not na(bg_color) ? bg_color : (dark_mode ? color.new(color.black, 20) : color.new(#4A001F, 10))
        table.cell(tbl_banner, 0, 0, title, text_size = size.large,  text_color = color.white, bgcolor = resolved_bg, text_formatting = text.format_bold)
        table.cell(tbl_banner, 0, 1, body,  text_size = size.normal, text_color = color.white, bgcolor = resolved_bg, text_halign = text.align_left)

//#endregion

//==================================================================//
//#region                 UTILITY FUNCTIONS                         //
//==================================================================//

//───────────────────────── bounded buffer ─────────────────────────//

// @function        		Pushes a value to a float array and evicts the oldest entry if the array exceeds a limit (FIFO bounded buffer)
// @param arr       		<array<float>> The array to modify
// @param val       		<float> Value to push
// @param limit     		<int> Maximum array size
// @returns         		<array<float>> The modified array (for chaining)
export push_limited(array<float> arr, float val, int limit) =>
    arr.push(val)
    if arr.size() > limit
        arr.shift()
    arr

// @function        		Pushes a value to an int array and evicts the oldest entry if the array exceeds a limit (FIFO bounded buffer)
// @param arr       		<array<int>> The array to modify
// @param val       		<int> Value to push
// @param limit     		<int> Maximum array size
// @returns         		<array<int>> The modified array (for chaining)
export push_limited(array<int> arr, int val, int limit) =>
    arr.push(val)
    if arr.size() > limit
        arr.shift()
    arr

//──────────────────────── precision guards ────────────────────────//

// @function        		Returns a precision-floored value to prevent division by zero (safe denominator guard)
// @param value     		<float> The denominator value to guard
// @param floor     		<float> Minimum allowed value (default 1e-9 — the smallest safe epsilon for Pine comparisons)
// @returns         		<float> The guarded denominator, guaranteed >= floor
export safe_denominator(float value, float floor = 1e-9) =>
    math.max(value, floor)

//#endregion

//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  SELECTION AND CONFIGURATION VALIDATION  ]------
//----------------------------------------------------------------------------------------------------------------------------- //

// @function        		Validates that only one boolean flag is true among a set (exclusive selection validation)
// @param self      		<ValidationFramework> The framework instance
// @param category  		<string> Category for error reporting (e.g., 'Distance Settings', 'Signal Configuration')
// @param item_name 		<string> Name of the item being validated (e.g., 'Entry Distance', 'TP1 Distance', 'Signal Source')
// @param flags     		<array<bool>> Array of boolean flags to check for exclusive selection
// @param flag_names 		<array<string>> Names corresponding to each flag (e.g., "Percentage", "ATR", "High/Low")
// @param selection_type 	<string> Describes what is being selected (e.g., "calculation method", "signal type", "option")
// @returns         		None (adds error if validation fails - either no selection or multiple selections)
export method validate_exclusive_selection(ValidationFramework self, string category, string item_name, bool[] flags, string[] flag_names, string selection_type = "method") =>
    enabled_count = 0
    enabled_options = array.new<string>()
    
    for i = 0 to flags.size() - 1
        if flags.get(i)
            enabled_count += 1
            enabled_options.push(flag_names.get(i))
    
    if enabled_count == 0
        self.add_error(category, str.format('{0}: No {1} is enabled. Please select exactly one {1}.', item_name, selection_type))
    else if enabled_count > 1
        options_text = enabled_options.join(', ')
        self.add_error(category, str.format('{0}: Multiple {1}s enabled ({2}). Please select exactly one {1}.', item_name, selection_type, options_text))

// @function        		Validates that numerical values are in strictly ascending order (for TP levels, thresholds, etc.)
// @param self      		<ValidationFramework> The framework instance
// @param category  		<string> Category for error reporting (e.g., 'Take Profit Settings', 'Threshold Configuration')
// @param values    		<array<float>> Array of values to check (na values are ignored in comparison)
// @param labels    		<array<string>> Labels corresponding to each value (e.g., 'TP1', 'TP2', 'TP3')
// @param value_type 		<string> Type of value being validated (e.g., 'distance', 'percentage', 'price level')
// @param strict    		<bool> If true, values must be strictly greater (val > prev_val). If false, equal values allowed (val >= prev_val)
// @returns         		None (adds error if values are not in proper ascending order)
export method validate_ascending_order(ValidationFramework self, string category, float[] values, string[] labels, string value_type, bool strict = true) =>
    for i = 1 to values.size() - 1
        current_val = values.get(i)
        previous_val = values.get(i - 1)
        
        if not na(current_val) and not na(previous_val)
            condition_met = strict ? current_val <= previous_val : current_val < previous_val
            comparison_text = strict ? "must be strictly greater than" : "must be greater than or equal to"
            if condition_met
                current_label = labels.get(i)
                previous_label = labels.get(i - 1)
                self.add_error(category, str.format('{0} {1} ({2}) {3} {4} {1} ({5})',
                  current_label, value_type, str.tostring(current_val), comparison_text, previous_label, str.tostring(previous_val)))

// @function        		Validates that a lookback/window parameter meets a derived minimum requirement
// @param self      		<ValidationFramework> The framework instance
// @param category  		<string> Category for error reporting (e.g., 'Configuration', 'Lookback Settings')
// @param param_name 		<string> Name of the parameter being validated (e.g., 'Lookback', 'Window Size')
// @param lookback  		<int> The actual lookback/window value to validate
// @param minimum_required 	<int> The minimum required value (caller computes this externally since derivation formulas vary)
// @param fix_hint  		<string> Optional hint explaining how to fix the issue (e.g., "Increase Lookback to 50+ or reduce Dimension")
// @returns         		<bool> Whether the lookback meets the minimum requirement
export method validate_minimum_lookback(ValidationFramework self, string category, string param_name, int lookback, int minimum_required, string fix_hint = "") =>
    valid = lookback >= minimum_required
    if not valid
        message = str.format("{0} ({1}) is below the required minimum ({2}).", param_name, str.tostring(lookback), str.tostring(minimum_required))
        if fix_hint != ""
            message += " " + fix_hint
        self.add_error(category, message)
    valid

// @function        		Detects if an input.source() is likely unconnected using the 2-bar close heuristic
// @param self      		<ValidationFramework> The framework instance
// @param category  		<string> Category for error reporting (e.g., 'Data Streams', 'Signal Configuration')
// @param source_name 		<string> Name of the source being validated (e.g., 'Main Data Stream', 'Signal Source')
// @param source_value 		<float> The source value to check (from input.source())
// @param is_enabled 		<bool> Whether the feature using this source is enabled (skips validation when false)
// @returns         		<bool> Whether the source appears connected (true = connected or check skipped, false = unconnected)
export method validate_source_connected(ValidationFramework self, string category, string source_name, float source_value, bool is_enabled = true) =>
    connected = true
    if is_enabled and source_value == close and source_value[1] == close[1]
        self.add_error(category, str.format("{0} is unconnected (defaulting to close). Please connect a valid data source.", source_name))
        connected := false
    connected

//#endregion

//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  ALLOCATION AND PERCENTAGE VALIDATION  ]------
//----------------------------------------------------------------------------------------------------------------------------- //

// @function        				Validates allocation percentages for proper distribution and range (comprehensive allocation validation)
// @param self      				<ValidationFramework> The framework instance
// @param category  				<string> Category for error reporting (e.g., 'Take Profit Settings', 'Portfolio Allocation')
// @param item_name 				<string> Name of the allocation system being validated (e.g., 'Take Profit Levels', 'Position Distribution')
// @param allocations 				<array<float>> Array of allocation percentages (0-1 scale, e.g., 0.5 for 50%)
// @param labels    				<array<string>> Labels for each allocation (e.g., 'TP1', 'TP2', 'Asset A')
// @param allow_partial_allocation  <bool> Whether total allocation less than 100% is acceptable (e.g. for TPs with SL backup)
// @param required_total_allocation <float> If not na, checks if total allocation matches this exact value (e.g. 1.0 for full allocation)
// @returns         				None (adds errors for invalid allocations, warnings for suboptimal distributions)
export method validate_allocations(ValidationFramework self, string category, string item_name, float[] allocations, string[] labels, bool allow_partial_allocation, float required_total_allocation = na) =>
    total_allocation = 0.0
    
    // Validate individual allocations for range and negative values
    for i = 0 to allocations.size() - 1
        allocation = allocations.get(i)
        label = labels.get(i)
        
        if allocation < 0
            self.add_error(category, str.format('{0} - {1} allocation cannot be negative ({2}%)', item_name, label, str.tostring(allocation * 100, '#.##')))
        else if allocation > 1.0001 // Allow for minor float inaccuracies
            self.add_error(category, str.format('{0} - {1} allocation cannot exceed 100% ({2}%)', item_name, label, str.tostring(allocation * 100, '#.##')))
        
        total_allocation += allocation
    
    // Validate total allocation constraints
    if total_allocation > 1.0001 // Using 1.0001 to account for potential floating point sum inaccuracies
        self.add_error(category, str.format('{0} - Total allocation ({1}%) exceeds 100%. Please adjust allocations.', item_name, str.tostring(total_allocation * 100, '#.##')))
    else if not allow_partial_allocation and total_allocation < 0.9999 // Using 0.9999 for similar reasons
        self.add_warning(category, str.format('{0} - Total allocation ({1}%) is less than 100%. The remainder may be unmanaged or handled by other mechanisms (e.g., stop loss).', item_name, str.tostring(total_allocation * 100, '#.##')))
    
    // Validate exact allocation requirements if specified
    if not na(required_total_allocation) and (total_allocation < required_total_allocation - 0.0001 or total_allocation > required_total_allocation + 0.0001)
        self.add_error(category, str.format('{0} - Total allocation ({1}%) does not meet the required total of {2}%.', item_name, str.tostring(total_allocation * 100, '#.##'), str.tostring(required_total_allocation * 100, '#.##')))

//#endregion

//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  POSITION SIZING AND RISK VALIDATION  ]------
//----------------------------------------------------------------------------------------------------------------------------- //

// @function        						Validates order size against account and position limits for risk management
// @param self      						<ValidationFramework> The framework instance
// @param category  						<string> Category for error reporting (e.g., 'Position Sizing', 'Risk Management')
// @param order_size						<float> Proposed order size (in units of asset, e.g., number of shares, contracts)
// @param price_at_order 					<float> Price at which the order would be valued (e.g., close, entry_price, limit_price)
// @param account_equity 					<float> Current account equity available for trading
// @param max_position_size_asset 			<float> Maximum allowed position size in units of asset (regulatory or strategy limit)
// @param max_risk_per_trade_equity_perc 	<float> Maximum percentage of equity to risk on this trade (e.g. 50 for 50%)
// @returns         						<bool> Whether order size is valid (returns true if no errors added, false if constraints violated)
export method validate_order_size_constraints(ValidationFramework self, string category, float order_size, float price_at_order, float account_equity, float max_position_size_asset, float max_risk_per_trade_equity_perc = 50.0) =>
    initial_error_count = self.errors.size()
    
    // Calculate position value and percentage of equity
    position_value = order_size * price_at_order
    position_equity_perc = (position_value / account_equity) * 100
    
    // Validate against absolute constraints
    if position_value > account_equity
        self.add_error(category, str.format('Order value ({0}) exceeds account equity ({1}). Order size: {2} units at {3} price.', str.tostring(position_value), str.tostring(account_equity), str.tostring(order_size), str.tostring(price_at_order)))
    
    if order_size > max_position_size_asset
        self.add_error(category, str.format('Order size ({0} units) exceeds maximum allowed position size ({1} units).', str.tostring(order_size), str.tostring(max_position_size_asset)))
    
    // Validate against risk percentage constraints
    if position_equity_perc > max_risk_per_trade_equity_perc
        self.add_warning(category, str.format('Position size represents {0}% of account equity, which is above the suggested {1}% risk threshold. Consider reducing size.', str.tostring(position_equity_perc, '#.##'), str.tostring(max_risk_per_trade_equity_perc, '#.##')))
    
    self.errors.size() == initial_error_count // True if no new errors were added

// @function        						Validates position sizing with multipliers for Martingale/Anti-Martingale risk management
// @param self      						<ValidationFramework> The framework instance
// @param category  						<string> Category for the validation messages (e.g., 'Martingale Risk', 'Position Scaling')
// @param base_size_asset 					<float> Base position size in units of asset (before multipliers applied)
// @param current_multiplier 				<float> Current size multiplier being applied (e.g., 2.0 for double sizing, 0.5 for half sizing)
// @param price_at_order 					<float> Price at which the order would be valued (for calculating position value)
// @param account_equity 					<float> Current account equity available
// @param warning_threshold_equity_perc 	<float> Equity percentage for a warning (e.g., 25.0 for 25% - suggests caution)
// @param error_threshold_equity_perc 		<float> Equity percentage for an error (e.g., 50.0 for 50% - high risk)
// @param critical_threshold_equity_perc 	<float> Equity percentage for a critical error (e.g., 75.0 for 75% - dangerous risk)
// @param high_multiplier_threshold 		<float> Multiplier value considered high risk (e.g., 5.0 for 5x sizing)
// @returns         						<bool> Whether position sizing risk is acceptable (returns true if no errors added)
export method validate_multiplied_sizing_risk(ValidationFramework self, string category, float base_size_asset, float current_multiplier, float price_at_order, float account_equity, float warning_threshold_equity_perc = 25.0, float error_threshold_equity_perc = 50.0, float critical_threshold_equity_perc = 75.0, float high_multiplier_threshold = 5.0) =>
    initial_error_count = self.errors.size()
    
    // Calculate effective position metrics
    effective_position_value = base_size_asset * current_multiplier * price_at_order
    risk_percentage_of_equity = (effective_position_value / account_equity) * 100
    
    // Progressive risk level validation
    if risk_percentage_of_equity >= critical_threshold_equity_perc
        self.add_error(category, str.format('CRITICAL RISK: Position (base {0} * mult {1} at price {2}) represents {3}% of account equity. This exceeds safe trading limits ({4}%).', str.tostring(base_size_asset), str.tostring(current_multiplier), str.tostring(price_at_order), str.tostring(risk_percentage_of_equity, '#.#'), str.tostring(critical_threshold_equity_perc, '#.#')))
    else if risk_percentage_of_equity >= error_threshold_equity_perc
        self.add_error(category, str.format('HIGH RISK: Position represents {0}% of account equity. Consider reducing size multipliers. Limit: {1}%.', str.tostring(risk_percentage_of_equity, '#.#'), str.tostring(error_threshold_equity_perc, '#.#')))
    else if risk_percentage_of_equity >= warning_threshold_equity_perc
        self.add_warning(category, str.format('Elevated risk: Position represents {0}% of account equity. Monitor carefully. Threshold: {1}%.', str.tostring(risk_percentage_of_equity, '#.#'), str.tostring(warning_threshold_equity_perc, '#.#')))
    
    // Multiplier-specific risk validation
    if current_multiplier > high_multiplier_threshold
        self.add_warning(category, str.format('Size multiplier is {0}x. High multipliers (>{1}x) can lead to rapid account depletion during losing streaks.', str.tostring(current_multiplier, '#.#'), str.tostring(high_multiplier_threshold, '#.#')))
    
    self.errors.size() == initial_error_count // True if no new errors were added

//#endregion

//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  TIMING AND SEQUENCE VALIDATION  ]------
//----------------------------------------------------------------------------------------------------------------------------- //

// @function        			Validates entry timing and cooldown conditions for trade management
// @param self      			<ValidationFramework> The framework instance
// @param category  			<string> Category for the validation messages (e.g., 'Entry Timing', 'Trade Management')
// @param bars_since_last_event <int> Bars since the last relevant event (e.g., trade exit, signal)
// @param cooldown_required 	<int> Required cooldown period in bars before new action allowed
// @param has_entry_signal 		<bool> Whether a valid entry signal currently exists
// @param event_name 			<string> Name of the event that triggered the cooldown (e.g., "trade exit", "signal reversal")
// @returns         			<bool> Whether entry timing is valid (returns true if conditions allow new entry)
export method validate_timing_cooldown(ValidationFramework self, string category, int bars_since_last_event, int cooldown_required, bool has_entry_signal, string event_name = "trade exit") =>
    valid_timing = true
    
    // Validate cooldown period completion
    if bars_since_last_event < cooldown_required
        remaining_bars = cooldown_required - bars_since_last_event
        self.add_warning(category, str.format('Entry blocked: {0} more bar{1} required for {2} cooldown period to complete.', str.tostring(remaining_bars), remaining_bars > 1 ? 's' : '', event_name))
        valid_timing := false
    
    // Validate signal presence
    if not has_entry_signal
        self.add_warning(category, 'No valid entry signal present. Check signal configuration and market conditions.')
        valid_timing := false 
    
    valid_timing

// @function        		Validates that configuration values are within acceptable ranges
// @param self      		<ValidationFramework> The framework instance
// @param category  		<string> Category for error reporting (e.g., 'Configuration', 'Input Validation')
// @param item_name 		<string> Name of the configuration item (e.g., 'ATR Lookback', 'Stop Loss %')
// @param value     		<float> The value to validate
// @param min_value 		<float> Minimum acceptable value (inclusive)
// @param max_value 		<float> Maximum acceptable value (inclusive)
// @param optimal_min 		<float> Optimal minimum value for warnings (na to disable)
// @param optimal_max 		<float> Optimal maximum value for warnings (na to disable)
// @param value_unit 		<string> Unit description for the value (e.g., 'bars', '%', 'multiplier')
// @returns         		<bool> Whether the value is within acceptable range
export method validate_range(ValidationFramework self, string category, string item_name, float value, float min_value, float max_value, float optimal_min = na, float optimal_max = na, string value_unit = "") =>
    valid = true
    unit_text = value_unit == "" ? "" : " " + value_unit
    
    // Hard range validation
    if value < min_value
        self.add_error(category, str.format('{0} value ({1}{2}) is below minimum allowed ({3}{2}).', item_name, str.tostring(value), unit_text, str.tostring(min_value)))
        valid := false
    else if value > max_value
        self.add_error(category, str.format('{0} value ({1}{2}) exceeds maximum allowed ({3}{2}).', item_name, str.tostring(value), unit_text, str.tostring(max_value)))
        valid := false
    
    // Optimal range validation
    if valid and not na(optimal_min) and value < optimal_min
        self.add_warning(category, str.format('{0} value ({1}{2}) is below optimal minimum ({3}{2}). Consider increasing for better performance.', item_name, str.tostring(value), unit_text, str.tostring(optimal_min)))
    
    if valid and not na(optimal_max) and value > optimal_max
        self.add_warning(category, str.format('{0} value ({1}{2}) exceeds optimal maximum ({3}{2}). Consider reducing for better stability.', item_name, str.tostring(value), unit_text, str.tostring(optimal_max)))
    
    valid

// @function        		Validates that a user-selected timeframe is sufficiently higher than the chart timeframe
// @param self      		<ValidationFramework> The framework instance
// @param category  		<string> Category for error reporting (e.g., 'Timeframe', 'HTF Settings')
// @param selected_tf 		<string> The user-selected timeframe string (from input.timeframe())
// @param min_multiplier 	<float> Minimum required timeframe multiplier (1.0 = at least same as chart, 2.0 = at least 2x, etc.)
// @returns         		<int> The timeframe multiplier (selected_tf seconds / chart seconds) for downstream use
export method validate_higher_timeframe(ValidationFramework self, string category, string selected_tf, float min_multiplier = 1.0) =>
    multiplier = int(timeframe.in_seconds(selected_tf) / timeframe.in_seconds(timeframe.period))
    if multiplier < min_multiplier
        self.add_error(category, str.format("Timeframe ({0}) is not high enough. Requires at least {1}x the chart timeframe (current: {2}x).", selected_tf, str.tostring(min_multiplier, "#.#"), str.tostring(multiplier)))
    multiplier

//#endregion

//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  SPECIALIZED TRADING VALIDATION  ]------
//----------------------------------------------------------------------------------------------------------------------------- //

// @function        		Validates Martingale/Anti-Martingale parameters for logical consistency and risk management
// @param self      		<ValidationFramework> The framework instance
// @param category  		<string> Category for error reporting (e.g., 'Martingale Settings', 'Position Scaling')
// @param multiplier 		<float> The sizing multiplier per streak step (e.g., 2.0 for doubling, 1.5 for 50% increase)
// @param min_streak 		<int> Minimum consecutive results before scaling begins (e.g., 2 means scaling starts on 2nd loss)
// @param max_streak 		<int> Maximum number of times the multiplier is applied (caps escalation)
// @param scaling_type 		<string> Type of scaling being validated (e.g., "Win streak", "Loss streak", "Custom scaling")
// @returns         		<bool> Whether the Martingale settings are valid and safe
export method validate_martingale_settings(ValidationFramework self, string category, float multiplier, int min_streak, int max_streak, string scaling_type = "Scaling") =>
    valid = true
    
    // Validate multiplier range
    if multiplier < 0.1
        self.add_error(category, str.format('{0} multiplier ({1}) is too low. Minimum value is 0.1.', scaling_type, str.tostring(multiplier)))
        valid := false
    else if multiplier > 10
        self.add_warning(category, str.format('{0} multiplier ({1}) is very high. This may lead to excessive risk.', scaling_type, str.tostring(multiplier)))
    
    // Validate streak parameters
    if min_streak < 1
        self.add_error(category, str.format('{0} minimum streak ({1}) must be at least 1.', scaling_type, str.tostring(min_streak)))
        valid := false
    
    if max_streak < min_streak
        self.add_error(category, str.format('{0} maximum streak ({1}) cannot be less than minimum streak ({2}).', scaling_type, str.tostring(max_streak), str.tostring(min_streak)))
        valid := false
    else if max_streak > 10
        self.add_warning(category, str.format('{0} maximum streak ({1}) is very high. This may lead to excessive risk escalation.', scaling_type, str.tostring(max_streak)))
    
    // Calculate and warn about maximum possible escalation
    if valid and multiplier > 1.0
        max_escalation = math.pow(multiplier, max_streak)
        if max_escalation > 100
            self.add_warning(category, str.format('{0}: Maximum possible size escalation is {1}x at {2} streak. Consider reducing multiplier or max streak.', scaling_type, str.tostring(max_escalation, '#.#'), str.tostring(max_streak)))
    
    valid

// @function        					Validates signal source configuration for completeness and logical consistency
// @param self      					<ValidationFramework> The framework instance
// @param category  					<string> Category for error reporting (e.g., 'Signal Configuration', 'Strategy Setup')
// @param signal_name 					<string> Name of the signal source being validated (e.g., 'Signal 1', 'EMA Cross', 'Custom Indicator')
// @param is_enabled 					<bool> Whether the signal source is enabled
// @param has_data_stream 				<bool> Whether a data stream is properly connected
// @param requires_secondary_stream 	<bool> Whether this signal type requires a secondary data stream
// @param has_secondary_stream 			<bool> Whether a secondary data stream is connected
// @param entry_mappings_configured 	<bool> Whether entry signal mappings are properly configured
// @param exit_mappings_configured 		<bool> Whether exit signal mappings are properly configured
// @param active_in_regimes 			<bool> Whether the signal is active in at least one market regime (when regime filtering enabled)
// @returns         					<bool> Whether signal configuration is valid and complete
export method validate_signal_configuration(ValidationFramework self, string category, string signal_name, bool is_enabled, bool has_data_stream, bool requires_secondary_stream, bool has_secondary_stream, bool entry_mappings_configured, bool exit_mappings_configured, bool active_in_regimes = true) =>
    valid = true
    
    if is_enabled
        // Validate data stream connections
        if not has_data_stream
            self.add_error(category, str.format('{0}: Data stream not connected. Please select a valid data source.', signal_name))
            valid := false
        
        if requires_secondary_stream and not has_secondary_stream
            self.add_error(category, str.format('{0}: Secondary data stream required but not connected.', signal_name))
            valid := false
        
        // Validate signal mappings
        if not entry_mappings_configured and not exit_mappings_configured
            self.add_warning(category, str.format('{0}: No signal mappings configured. This signal will never generate any signals.', signal_name))
        
        // Validate regime activity
        if not active_in_regimes
            self.add_warning(category, str.format('{0}: Signal is inactive in all market regimes. It will never generate signals when regime filter is enabled.', signal_name))
    
    valid

//#endregion

//==================================================================//
//#region                 LIBRARY CHART DEMO                        //
//==================================================================//

// Runs representative validations and displays results in a chart table.
// This block only executes when the library itself is added to a chart;
// consumers importing the library are unaffected.

//─────────────────────────── demo types ───────────────────────────//

type DemoResult
    string name
    bool   passed
    string status

demo_check(string name, bool condition, string status) =>
    DemoResult.new(name, condition, status)

demo_vf() =>
    vf = ValidationFramework.new()
    vf.init()
    vf

//───────────────────── run validation checks ──────────────────────//

var arr_demo = array.new<DemoResult>()

if barstate.isfirst
    // Selection & Configuration
    vf1 = demo_vf()
    vf1.validate_exclusive_selection("Test", "Mode", array.from(true, false, false), array.from("A", "B", "C"), "method")
    arr_demo.push(demo_check("Exclusive selection — valid input", not vf1.has_errors, "No errors"))

    vf2 = demo_vf()
    vf2.validate_exclusive_selection("Test", "Mode", array.from(true, true, false), array.from("A", "B", "C"), "method")
    arr_demo.push(demo_check("Exclusive selection — conflict detected", vf2.has_errors, "Error caught"))

    vf3 = demo_vf()
    vf3.validate_ascending_order("Test", array.from(1.0, 2.0, 3.0), array.from("TP1", "TP2", "TP3"), "level")
    arr_demo.push(demo_check("Ascending order — valid sequence", not vf3.has_errors, "No errors"))

    // Allocation
    vf4 = demo_vf()
    vf4.validate_allocations("Test", "TP", array.from(0.4, 0.3, 0.3), array.from("A", "B", "C"), true)
    arr_demo.push(demo_check("Allocations — valid 100%", not vf4.has_errors, "No errors"))

    vf5 = demo_vf()
    vf5.validate_allocations("Test", "TP", array.from(0.5, 0.4, 0.3), array.from("A", "B", "C"), true)
    arr_demo.push(demo_check("Allocations — over 100%", vf5.has_errors, "Error caught"))

    // Range & Timing
    vf6 = demo_vf()
    vf6.validate_range("Test", "ATR Lookback", 14.0, 1.0, 500.0, 10.0, 50.0, "bars")
    arr_demo.push(demo_check("Range check — valid value", not vf6.has_errors, "No errors"))

    vf7 = demo_vf()
    vf7.validate_range("Test", "ATR Lookback", 5.0, 1.0, 500.0, 10.0, 50.0, "bars")
    arr_demo.push(demo_check("Range check — below optimal", vf7.has_warnings, "Warning raised"))

    // Position Sizing
    vf8 = demo_vf()
    vf8.validate_order_size_constraints("Test", 300.0, 50.0, 10000.0, 500.0, 50.0)
    arr_demo.push(demo_check("Order size — exceeds equity", vf8.has_errors, "Error caught"))

    vf9 = demo_vf()
    vf9.validate_martingale_settings("Test", 2.0, 1, 5)
    arr_demo.push(demo_check("Martingale settings — valid", not vf9.has_errors, "No errors"))

    // Signal
    vf10 = demo_vf()
    vf10.validate_signal_configuration("Test", "RSI", true, true, false, false, false, false)
    arr_demo.push(demo_check("Signal config — no mappings", vf10.has_warnings, "Warning raised"))

//────────────────────── render results table ──────────────────────//

color C_DEMO_PASS    = color.new(#7272ED, 0)
color C_DEMO_FAIL    = color.new(#C94264, 0)
color C_DEMO_BG_PASS = color.new(#7272ED, 85)
color C_DEMO_BG_FAIL = color.new(#C94264, 85)
color C_DEMO_HDR     = color.new(#4242C9, 80)

var table tbl_demo = table.new(
    position.middle_center, columns=3, rows=13,
    bgcolor=color.new(#4A001F, 10),
    border_color=color.new(color.gray, 50),
    border_width=1, force_overlay=true
)

if barstate.islast
    // Banner demonstration — render_banner() is the preferred rich, click-free surface. issues_as_text() turns the
    // framework's collected items into the banner body. Placed top-centre so it does not overlap the results table.
    vf_warn = demo_vf()
    vf_warn.add_warning("Risk", "Position represents 35% of equity — monitor carefully.")
    vf_warn.add_warning("Config", "ATR Lookback (8) is below optimal minimum (10 bars).")
    // Preview colour only (the GYTS warning pink). Consumers should source banner colours from ColourUtilities' GYTS
    // palette rather than a raw hex; this library deliberately stays free of a ColourUtilities dependency.
    render_banner("Configuration warnings", vf_warn.issues_as_text(false, true), position.top_center, color.new(#EC7298, 10))

    // Table header
    string sz = size.normal
    color c_magnolia = color.new(#F8F4FF, 0)
    table.cell(tbl_demo, 0, 0, "", text_size=sz, bgcolor=C_DEMO_HDR)
    table.cell(tbl_demo, 1, 0, "Validation Check", text_color=c_magnolia, text_size=sz, text_halign=text.align_left, bgcolor=C_DEMO_HDR)
    table.cell(tbl_demo, 2, 0, "Result", text_color=c_magnolia, text_size=sz, bgcolor=C_DEMO_HDR)

    int pass_count = 0
    int fail_count = 0

    for i = 0 to arr_demo.size() - 1
        r = arr_demo.get(i)
        int row = i + 1
        color row_bg = r.passed ? C_DEMO_BG_PASS : C_DEMO_BG_FAIL
        color row_fg = r.passed ? C_DEMO_PASS : C_DEMO_FAIL

        table.cell(tbl_demo, 0, row, r.passed ? "✓" : "✗", text_color=row_fg, text_size=sz, bgcolor=row_bg)
        table.cell(tbl_demo, 1, row, r.name, text_color=c_magnolia, text_size=sz, text_halign=text.align_left, bgcolor=row_bg)
        table.cell(tbl_demo, 2, row, r.status, text_color=row_fg, text_size=sz, bgcolor=row_bg)

        if r.passed
            pass_count += 1
        else
            fail_count += 1

    int total = pass_count + fail_count
    int summary_row = arr_demo.size() + 1
    bool all_passed = fail_count == 0
    color summary_bg = all_passed ? C_DEMO_BG_PASS : C_DEMO_BG_FAIL
    color summary_fg = all_passed ? C_DEMO_PASS : C_DEMO_FAIL

    table.cell(tbl_demo, 0, summary_row, all_passed ? "✓" : "✗", text_color=summary_fg, text_size=sz, bgcolor=summary_bg)
    table.cell(tbl_demo, 1, summary_row, str.format("{0}/{1} checks passed", pass_count, total), text_color=c_magnolia, text_size=sz, text_halign=text.align_left, bgcolor=summary_bg)
    table.cell(tbl_demo, 2, summary_row, "SUMMARY", text_color=c_magnolia, text_size=sz, bgcolor=summary_bg)

    log.info(str.format("ValidationUtilities Demo: {0}/{1} checks passed", pass_count, total))

//#endregion