//@version=6
indicator("HMA Trend Line (Croc Signal Line)", overlay=true)

// ---- PARAMETERS ----
len = input.int(21, title="Signal Line Period")
src = input(close, title="Source Price")
colorLine = input.color(color.yellow, title="Trend Line Color")

// ---- HULL MOVING AVERAGE ----
hma = ta.hma(src, len)

// ---- PLOT TREND LINE ----
plot(hma, color=colorLine, linewidth=2, title="HMA Trend Line")

