//@version=6
// ============================================================
//  PM GAP SCANNER — 10 тикеров, индивидуальные пороги
//  Алерт, когда цена на премаркете ушла от вчерашнего RTH-клоуза
//  больше чем на порог этого тикера (в пунктах или в %).
//
//  ВАЖНО: применять на 1-минутном графике US-акции
//  с ВКЛЮЧЁННЫМ "Extended trading hours".
//
//  Порог у тикера = 0  →  берётся общий порог из настроек.
// ============================================================
indicator("Oybek stats", overlay = false)

// ─────────────── Настройки ───────────────
gS   = "Настройки"
mode = input.string("Пункты", "Порог считать в", options = ["Пункты", "Проценты"], group = gS)
thrA = input.float(1.0, "Общий порог, пункты ($)", minval = 0.01, step = 0.01, group = gS)
thrP = input.float(3.0, "Общий порог, %",          minval = 0.01, step = 0.1,  group = gS)
dirn = input.string("Обе стороны", "Направление гэпа", options = ["Обе стороны", "Только вверх", "Только вниз"], group = gS)
pre  = input.session("0400-0930", "Окно премаркета (ET)", group = gS)
once = input.bool(true, "Не более 1 алерта на тикер в день", group = gS)
tblOn = input.bool(true, "Показывать таблицу", group = gS)

// ─────────────── Тикеры и их пороги ───────────────
gT = "Тикеры и пороги (0 = общий)"
s01 = input.symbol("NASDAQ:AAPL", "1",  group = gT, inline = "1")
x01 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "1")
s02 = input.symbol("NASDAQ:TSLA", "2",  group = gT, inline = "2")
x02 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "2")
s03 = input.symbol("NASDAQ:NVDA", "3",  group = gT, inline = "3")
x03 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "3")
s04 = input.symbol("NASDAQ:AMD",  "4",  group = gT, inline = "4")
x04 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "4")
s05 = input.symbol("NASDAQ:AMZN", "5",  group = gT, inline = "5")
x05 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "5")
s06 = input.symbol("NASDAQ:META", "6",  group = gT, inline = "6")
x06 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "6")
s07 = input.symbol("NASDAQ:MSFT", "7",  group = gT, inline = "7")
x07 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "7")
s08 = input.symbol("NASDAQ:INTC", "8",  group = gT, inline = "8")
x08 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "8")
s09 = input.symbol("NYSE:BA",     "9",  group = gT, inline = "9")
x09 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "9")
s10 = input.symbol("NYSE:F",      "10", group = gT, inline = "10")
x10 = input.float(0.0, "", minval = 0, step = 0.01, group = gT, inline = "10")

// ─────────────── Ядро ───────────────
f_scan(sym, thrOwn) =>
    ext = ticker.modify(sym, session = session.extended)
    px  = request.security(ext, timeframe.period, close)

    isPre = not na(time(timeframe.period, pre,         "America/New_York"))
    isRth = not na(time(timeframe.period, "0930-1600", "America/New_York"))

    // вчерашний клоуз = последняя цена основной сессии
    var float pdc = na
    if isRth and not na(px)
        pdc := px

    diff = px - pdc
    pct  = 100.0 * diff / pdc
    val  = mode == "Пункты" ? math.abs(diff) : math.abs(pct)
    thrD = mode == "Пункты" ? thrA : thrP
    thr  = thrOwn > 0 ? thrOwn : thrD
    dOk  = dirn == "Обе стороны" or (dirn == "Только вверх" and diff > 0) or (dirn == "Только вниз" and diff < 0)

    var bool fired = false
    if isPre and not isPre[1]
        fired := false

    trig = isPre and dOk and not na(pdc) and not na(px) and val >= thr and (not once or not fired)
    if trig
        fired := true

    msg = sym + "  " + (diff > 0 ? "+" : "") + str.tostring(diff, "#.##") + " (" + (pct > 0 ? "+" : "") + str.tostring(pct, "#.##") + "%)  клоуз " + str.tostring(pdc, "#.##") + " → " + str.tostring(px, "#.##") + "  [порог " + str.tostring(thr, "#.##") + "]"
    [diff, pct, trig, msg]

[d01, p01, t01, m01] = f_scan(s01, x01)
[d02, p02, t02, m02] = f_scan(s02, x02)
[d03, p03, t03, m03] = f_scan(s03, x03)
[d04, p04, t04, m04] = f_scan(s04, x04)
[d05, p05, t05, m05] = f_scan(s05, x05)
[d06, p06, t06, m06] = f_scan(s06, x06)
[d07, p07, t07, m07] = f_scan(s07, x07)
[d08, p08, t08, m08] = f_scan(s08, x08)
[d09, p09, t09, m09] = f_scan(s09, x09)
[d10, p10, t10, m10] = f_scan(s10, x10)

if t01
    alert(m01, alert.freq_once_per_bar)
if t02
    alert(m02, alert.freq_once_per_bar)
if t03
    alert(m03, alert.freq_once_per_bar)
if t04
    alert(m04, alert.freq_once_per_bar)
if t05
    alert(m05, alert.freq_once_per_bar)
if t06
    alert(m06, alert.freq_once_per_bar)
if t07
    alert(m07, alert.freq_once_per_bar)
if t08
    alert(m08, alert.freq_once_per_bar)
if t09
    alert(m09, alert.freq_once_per_bar)
if t10
    alert(m10, alert.freq_once_per_bar)

// ─────────────── Таблица ───────────────
var table tb = table.new(position.top_right, 3, 11, border_width = 1)

f_row(r, sym, d, p, hit) =>
    if tblOn and barstate.islast
        c  = na(d) ? color.gray : d > 0 ? color.new(color.green, 0) : color.new(color.red, 0)
        bg = hit ? color.new(color.yellow, 70) : color.new(color.black, 100)
        table.cell(tb, 0, r, sym, text_color = color.silver, text_size = size.small, bgcolor = bg)
        table.cell(tb, 1, r, na(d) ? "—" : str.tostring(d, "#.##"), text_color = c, text_size = size.small, bgcolor = bg)
        table.cell(tb, 2, r, na(p) ? "—" : str.tostring(p, "#.##") + "%", text_color = c, text_size = size.small, bgcolor = bg)

if tblOn and barstate.islast
    table.cell(tb, 0, 0, "Тикер", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, "Δ $",   text_color = color.white, text_size = size.small)
    table.cell(tb, 2, 0, "Δ %",   text_color = color.white, text_size = size.small)

f_row(1,  s01, d01, p01, t01)
f_row(2,  s02, d02, p02, t02)
f_row(3,  s03, d03, p03, t03)
f_row(4,  s04, d04, p04, t04)
f_row(5,  s05, d05, p05, t05)
f_row(6,  s06, d06, p06, t06)
f_row(7,  s07, d07, p07, t07)
f_row(8,  s08, d08, p08, t08)
f_row(9,  s09, d09, p09, t09)
f_row(10, s10, d10, p10, t10)