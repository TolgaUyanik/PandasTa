//@version=6
indicator("WT + Stoch RSI Reversal Combo", overlay=false)

// === Toggles ===
showWTLines     = input.bool(true,  "Show WaveTrend Lines")
showWTHist      = input.bool(true,  "Show Histogram")
showWTCrosses   = input.bool(true,  "Show WT Crosses")
showStoch       = input.bool(true,  "Show Stochastic RSI")
showComboSignals= input.bool(true,  "Show Combined Buy/Sell Signals")
showLevelLines  = input.bool(true,  "Show Horizontal Lines")

// === WaveTrend Inputs ===
n1 = input.int(10,  "Channel Length")
n2 = input.int(21,  "Average Length")
obLevel1 = input.int(60,  "Over Bought Level 1")
obLevel2 = input.int(30,  "Over Bought Level 2") // relaxed to see signal
osLevel1 = input.int(-60, "Over Sold Level 1")
osLevel2 = input.int(-30, "Over Sold Level 2")   // relaxed to see signal
useLag = input.bool(true, "Use Laguerre Smoothing")
gamma = input.float(0.02, "Laguerre Gamma", step=0.001)

// === WT Core ===
lag(g, p) =>
    L0 = 0.0, L0 := (1 - g)*p + g*nz(L0[1])
    L1 = 0.0, L1 := -g*L0 + nz(L0[1]) + g*nz(L1[1])
    L2 = 0.0, L2 := -g*L1 + nz(L1[1]) + g*nz(L2[1])
    L3 = 0.0, L3 := -g*L2 + nz(L2[1]) + g*nz(L3[1])
    (L0 + 2*L1 + 2*L2 + L3) / 6

ap = hlc3
esa = ta.ema(ap, n1)
d = ta.ema(math.abs(ap - esa), n1)
ci = (ap - esa) / (0.015 * d)
tci = ta.ema(ci, n2)
output = lag(gamma, tci)
wt1 = useLag ? output : tci
wt2 = ta.sma(wt1, 4)
wt3 = wt1 - wt2

// === WT Plots
plot(showWTLines ? wt1 : na, "WT1", color=color.teal)
plot(showWTLines ? wt2 : na, "WT2", color=color.orange)

histColor = wt3 >= 0 ? (wt3 > wt3[1] ? #26A69A : #B2DFDB) : (wt3 > wt3[1] ? #FFCDD2 : #EF5350)
plot(showWTHist ? wt3 : na, "Histogram", style=plot.style_columns, color=histColor)

// === Stochastic RSI Inputs ===
stochSrc      = input.source(close, "Stoch RSI Source")
stochLength   = input.int(14, "Stoch Length")
rsiLength     = input.int(14, "RSI Length")
kSmoothing    = input.int(3, "K Smoothing")
dSmoothing    = input.int(3, "D Smoothing")
useAvgK       = input.bool(true, "Use avg(K,D) as K")
stochOB       = input.int(50, "Stoch RSI Overbought %", minval=1, maxval=100)
stochOS       = input.int(50, "Stoch RSI Oversold %", minval=0, maxval=99)

rsiVal = ta.rsi(stochSrc, rsiLength)
kLine = ta.sma(ta.stoch(rsiVal, rsiVal, rsiVal, stochLength), kSmoothing)
dLine = ta.sma(kLine, dSmoothing)
kFinal = useAvgK ? (kLine + dLine)/2 : kLine

plot(showStoch ? kFinal : na, "%K", color=color.blue)
plot(showStoch ? dLine : na,  "%D", color=color.orange)

// === Combo Buy/Sell Logic
wtBuy = ta.crossover(wt1, wt2) and wt1 < osLevel2
wtSell = ta.crossunder(wt1, wt2) and wt1 > obLevel2
stochBuy = ta.crossover(kFinal, dLine) and kFinal < stochOS
stochSell = ta.crossunder(kFinal, dLine) and kFinal > stochOB

comboBuy = showComboSignals and wtBuy and stochBuy
comboSell = showComboSignals and wtSell and stochSell

plotshape(comboBuy, title="BUY", style=shape.triangleup, location=location.bottom, color=color.lime, size=size.small)
plotshape(comboSell, title="SELL", style=shape.triangledown, location=location.top, color=color.red, size=size.small)

// === Alerts
alertcondition(comboBuy, title="Buy Alert", message="WT + Stoch RSI Combo BUY Signal")
alertcondition(comboSell, title="Sell Alert", message="WT + Stoch RSI Combo SELL Signal")

// === Level Lines
plot(showLevelLines ? obLevel1 : na, "OB1", color=color.gray, style=plot.style_line)
plot(showLevelLines ? obLevel2 : na, "OB2", color=color.gray, style=plot.style_line)
plot(showLevelLines ? osLevel1 : na, "OS1", color=color.gray, style=plot.style_line)
plot(showLevelLines ? osLevel2 : na, "OS2", color=color.gray, style=plot.style_line)
plot(showLevelLines ? 100 : na, "Upper 100", color=color.white, style=plot.style_line)
plot(showLevelLines ? -100 : na, "Lower -100", color=color.white, style=plot.style_line)