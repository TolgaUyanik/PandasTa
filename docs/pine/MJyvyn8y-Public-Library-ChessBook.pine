    // === BLACK vs 1.d4: 1...d5 into a Queen's Gambit Declined setup ===
    // Every entry here ends on a White move, because it is Black -- us -- to reply.
    _map_book.put("d2d4", "d7d5|g8f6")                                  // 1...d5 (QGD) or 1...Nf6 (Indian).
    _map_book.put("d2d4 d7d5 c2c4", "e7e6")                            // 2...e6, the QGD.
    _map_book.put("d2d4 d7d5 g1f3", "g8f6")                            // 2.Nf3 Nf6, a quiet setup.
    _map_book.put("d2d4 d7d5 b1c3", "g8f6")                            // 2.Nc3 Nf6.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3", "g8f6")                 // 3.Nc3 Nf6.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 g1f3", "g8f6")                 // 3.Nf3 Nf6.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 c1g5", "f8e7")      // 4.Bg5 Be7, the classical QGD.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 g1f3", "f8e7")      // 4.Nf3 Be7.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 g1f3 g8f6 b1c3", "f8e7")      // Same shape by a different move order: ...Be7.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 g1f3 g8f6 b1c3 f8e7 c1g5", "e8g8")  // 5...O-O.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 g1f3 g8f6 b1c3 f8e7 c1g5 e8g8 e2e3", "b8d7")  // 6...Nbd7.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 c1g5 f8e7 e2e3", "e8g8")  // 5.e3 O-O, Black castles.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 c1g5 f8e7 e2e3 e8g8 g1f3", "b8d7")  // 6...Nbd7, the classical QGD plan.

    // === BLACK vs 1.d4 with 1...Nf6 move orders (Nimzo-Indian flavour) ===
    // Entries ending on a White move. Black -- us -- to reply.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3", "f8b4")                 // 3.Nc3 Bb4, the Nimzo-Indian.
    _map_book.put("d2d4 g8f6 g1f3 e7e6 c2c4", "f8b4")                 // Bogo/Nimzo shape: ...Bb4+ ideas.
