    _map_book.put("e2e4 g8f6 e4e5 f6d5 d2d4 d7d6 g1f3 g7g6", "f1c4")  // 5.Bc4 eyeing the loose knight.

    // === WHITE vs 1...d6 / 1...g6: Pirc and Modern ===
    _map_book.put("e2e4 d7d6", "d2d4")                                  // 2.d4.
    _map_book.put("e2e4 d7d6 d2d4 g8f6", "b1c3")                        // 3.Nc3 guarding e4.
    _map_book.put("e2e4 d7d6 d2d4 g8f6 b1c3 g7g6", "g1f3")             // 4.Nf3, the classical Pirc.
    _map_book.put("e2e4 d7d6 d2d4 g8f6 b1c3 e7e5", "g1f3")             // 4.Nf3, a Philidor by another door.
    _map_book.put("e2e4 d7d6 d2d4 g8f6 b1c3 g7g6 g1f3 f8g7", "f1e2")  // 5.Be2.
    _map_book.put("e2e4 d7d6 d2d4 g8f6 b1c3 g7g6 g1f3 f8g7 f1e2 e8g8", "e1g1")  // 6.O-O.
    _map_book.put("e2e4 d7d6 d2d4 g8f6 b1c3 g7g6 g1f3 f8g7 f1e2 e8g8 e1g1 c8g4", "c1e3")  // 7.Be3, steady.
    _map_book.put("e2e4 g7g6", "d2d4")                                  // Modern: 2.d4.
