    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 d7d5 b1c3 f8e7 c1g5 e8g8 e2e3", "b8d7")  // 6...Nbd7.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7", "f1g2")  // (White) 5.Bg2 in the Queen's Indian.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7 f1g2 f8e7", "e1g1")  // (White) 6.O-O.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7 f1g2 f8e7 e1g1 e8g8", "b1c3")  // (White) 7.Nc3.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3", "c8b7")      // 4...Bb7.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7 f1g2", "f8e7")  // 5...Be7.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7 f1g2 f8e7 e1g1", "e8g8")  // 6...O-O.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7 f1g2 f8e7 e1g1 e8g8 b1c3", "f6e4")  // 7...Ne4, the Queen's Indian's point.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7 f1g2 f8e7 e1g1 e8g8 b1c3 f6e4 d1c2", "e4c3")  // 8...Nxc3.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7 f1g2 f8e7 e1g1 e8g8 b1c3 f6e4 d1c2 e4c3 c2c3", "c7c5")  // 9...c5, the standard strike.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3 f8b4 e2e3 e8g8 f1d3", "d7d5")  // 5...d5, the classical Nimzo centre.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3 f8b4 e2e3 e8g8 f1d3 d7d5 g1f3", "c7c5")  // 6...c5.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3 f8b4 e2e3 e8g8 f1d3 d7d5 g1f3 c7c5 e1g1", "b8c6")  // 7...Nc6, the main Nimzo tabiya.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3 f8b4 d1c2 e8g8 a2a3", "b4c3")  // 5...Bxc3, giving the bishop on our terms.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3 f8b4 d1c2 e8g8 a2a3 b4c3 c2c3", "b7b6")  // 6...b6, the classical Qc2 Nimzo.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3 f8b4 g1f3", "e8g8")      // 4.Nf3 O-O.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3 f8b4 f2f3", "d7d5")      // 4.f3 d5, hitting back in the centre.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3 f8b4 c1g5", "h7h6")      // 4.Bg5 h6, putting the question first.

    // === BLACK vs 1.d4: London, Trompowsky, Catalan, and the quiet systems ===
    _map_book.put("d2d4 d7d5 c1f4", "g8f6")                            // London: 2...Nf6.
    _map_book.put("d2d4 d7d5 c1f4 g8f6 e2e3", "c7c5")                 // 3...c5, the standard counter.
