    _map_book.put("e2e4 c7c5 b1c3 b8c6 g2g3 g7g6 f1g2 f8g7 d2d3", "d7d6")  // 5...d6.
    _map_book.put("e2e4 c7c5 b1c3 b8c6 g2g3 g7g6 f1g2 f8g7 d2d3 d7d6 f2f4", "e7e6")  // 6...e6, keeping f5 under control.
    _map_book.put("e2e4 c7c5 b1c3 b8c6 g2g3 g7g6 f1g2 f8g7 d2d3 d7d6 f2f4 e7e6 g1f3", "g8e7")  // 7...Nge7, the flexible square.
    _map_book.put("e2e4 c7c5 b1c3 b8c6 g2g3 g7g6 f1g2 f8g7 d2d3 d7d6 f2f4 e7e6 g1f3 g8e7 e1g1", "e8g8")  // 8...O-O.
