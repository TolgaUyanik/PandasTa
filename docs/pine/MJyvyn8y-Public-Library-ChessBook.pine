    _map_book.put("e2e4 e7e5 g1f3 b8c6 b1c3 g8f6 f1b5", "f8b4")      // The same Spanish Four Knights by the Nf3 door.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 b1c3 g8f6 f1b5 f8b4 e1g1", "e8g8")  // 5...O-O.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 b1c3 g8f6 f1b5 f8b4 e1g1 e8g8 d2d3", "d7d6")  // 6...d6.
    _map_book.put("e2e4 e7e5 f1c4", "g8f6")                            // Bishop's Opening: 2...Nf6 hitting e4.
    _map_book.put("e2e4 e7e5 f1c4 g8f6 d2d3", "b8c6")                 // 3...Nc6.
    _map_book.put("e2e4 e7e5 f1c4 g8f6 d2d3 b8c6 g1f3", "f8c5")      // 4...Bc5, the quiet Italian by another door.
