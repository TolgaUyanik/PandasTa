    _map_book.put("e2e4 g7g6 d2d4 f8g7 b1c3 d7d6 g1f3 g8f6", "f1e2")  // 5.Be2, back into the classical Pirc.

    // === WHITE vs 1...b6 / 1...Nc6: Owen and Nimzowitsch ===
    _map_book.put("e2e4 b7b6", "d2d4")                                  // Owen: 2.d4, take the centre for free.
    _map_book.put("e2e4 b7b6 d2d4 c8b7", "f1d3")                        // 3.Bd3 guarding e4.
    _map_book.put("e2e4 b7b6 d2d4 c8b7 f1d3 e7e6", "g1f3")             // 4.Nf3.
    _map_book.put("e2e4 b8c6", "g1f3")                                  // Nimzowitsch: 2.Nf3, no fancy tricks needed.
    _map_book.put("e2e4 b8c6 g1f3 d7d5", "e4d5")                        // 3.exd5.
    _map_book.put("e2e4 b8c6 g1f3 d7d5 e4d5 d8d5", "b1c3")             // 4.Nc3 hitting the queen.
    _map_book.put("e2e4 b8c6 g1f3 e7e5", "f1c4|f1b5")                  // The main line by another door: 3.Bc4 or 3.Bb5.

    // === WHITE with 1.d4: Queen's Gambit shapes ===
