    _map_book.put("g2g3", "d7d5")                                      // 1...d5.
    _map_book.put("g2g3 d7d5 f1g2", "g8f6")                            // 2...Nf6.
    _map_book.put("b1c3", "d7d5")                                      // Van Geet: 1...d5.
