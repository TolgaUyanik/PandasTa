    _map_book.put("d2d4 d7d5 g1f3 g8f6 c1f4", "c7c5")                 // London again: 3...c5.
    _map_book.put("d2d4 d7d5 g1f3 g8f6 e2e3", "e7e6")                 // Colle territory: 3...e6.
    _map_book.put("d2d4 d7d5 g1f3 g8f6 e2e3 e7e6 f1d3", "c7c5")      // 4...c5, the freeing move.
    _map_book.put("d2d4 d7d5 g1f3 g8f6 g2g3", "e7e6")                 // 3...e6.
    _map_book.put("d2d4 d7d5 e2e3", "g8f6")                            // 2...Nf6.
    _map_book.put("d2d4 d7d5 e2e3 g8f6 f1d3", "c7c5")                 // 3...c5.
    _map_book.put("d2d4 d7d5 g2g3", "g8f6")                            // 2...Nf6.
    _map_book.put("d2d4 d7d5 g2g3 g8f6 f1g2", "e7e6")                 // 3...e6.
