    _map_book.put("c2c4 e7e5 b1c3 g8f6 g1f3 b8c6 g2g3 d7d5 c4d5 f6d5 f1g2 d5b6 e1g1", "f8e7")  // 7...Be7.
    _map_book.put("c2c4 e7e5 b1c3 g8f6 g1f3 b8c6 g2g3 d7d5 c4d5 f6d5 f1g2 d5b6 e1g1 f8e7 d2d3", "e8g8")  // 8...O-O.
    _map_book.put("c2c4 e7e5 g2g3", "g8f6")                            // 2...Nf6.
