//@version=6
//@description The opening book for the chess consumer, kept separate from ChessAI so the openings can grow without republishing the brain. Each entry pairs the moves played so far with our reply. Some entries offer several replies separated by "|", and every reply is a legal move in its position.
library("Public_Library_ChessBook", overlay = true)


//#region 🟩🟩🟩🟩🟩🟩  OPENING BOOK  🟩🟩🟩🟩🟩🟩

// Key = the moves played so far (both sides, lowercase, one space between, e2e4 = from e2 to e4). Value = our reply in the same style.
// The empty-string key holds White's very first move.
// A value with "|" (e.g. "e2e4|d2d4") offers a choice the consumer picks between. No "|" means one fixed move.
// Every reply must be legal in its position.
// An entry's key has an even half-move count when we reply as White, odd when as Black.

//@function Builds and returns the opening book, grouped by opening.
// Call once on the chart's first bar and hold the result in a var so it isn't rebuilt every bar.
//@returns  A map: give it the moves played so far as one string, get back our reply move(s).
export buildOpeningBook() =>
    map<string, string> _map_book = map.new<string, string>()

    // === WHITE: first move (fork between the two main first moves) ===
    _map_book.put("", "e2e4|d2d4")  // We open 1.e4 or 1.d4.

    // === WHITE vs 1...e5: Italian / Giuoco Piano ===
    _map_book.put("e2e4 e7e5", "g1f3")                                  // 2.Nf3 attacking e5.
    _map_book.put("e2e4 e7e5 g1f3 b8c6", "f1c4|f1b5")                   // 3.Bc4 (Italian) or 3.Bb5 (Ruy Lopez).
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5", "c2c3|d2d3")       // 4.c3 preparing d4, or the quiet 4.d3.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6", "d2d3")             // 4.d3 vs the Two Knights, quiet and sound.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 c2c3 g8f6", "d2d3")  // 5.d3 keeping it solid.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 c2c3 d7d6", "d2d4")  // 5.d4 striking the centre.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 d2d3 g8f6", "b1c3")  // 5.Nc3, a quiet Italian.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 c2c3 g8f6 d2d3 d7d6", "e1g1")  // 6.O-O, castle short.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3 f8c5", "e1g1")  // 5.O-O in the Two Knights, quiet setup.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3 f8e7", "e1g1")  // 5.O-O vs the passive Be7.
    _map_book.put("e2e4 e7e5 g1f3 g8f6", "b1c3")                        // vs Petroff move order, 3.Nc3 into a Four Knights.
    _map_book.put("e2e4 e7e5 g1f3 g8f6 b1c3 b8c6", "f1c4")             // 4.Bc4 into an Italian-ish Four Knights.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 c2c3 g8f6 d2d3 d7d6 e1g1 e8g8", "f1e1")  // 7.Re1, the quiet regroup.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 c2c3 g8f6 d2d3 d7d6 e1g1 c8g4", "h2h3")  // 7.h3 putting the question.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3 f8e7 e1g1 e8g8", "f1e1")  // 6.Re1 in the quiet Two Knights.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3 f8c5 e1g1 e8g8", "c2c3")  // 6.c3 preparing d4.

    // === WHITE vs 1...e5: Ruy Lopez shape if Black allows Nc6 then we go Bb5-style via Italian move order kept simple ===
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8e7", "d2d4")             // 4.d4 when Black plays the passive Be7.

    // === WHITE vs 1...e5: Ruy Lopez (reached when the book's move-3 choice picks f1b5) ===
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6", "b5a4")             // 4.Ba4, the main-line retreat.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 g8f6", "e1g1")            // 4.O-O, the Berlin.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6", "e1g1")  // 5.O-O, the Closed Ruy.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7", "f1e1")  // 6.Re1, the main line.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5", "a4b3")  // 7.Bb3, the main line.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 d7d6", "c2c3")  // 8.c3, the Closed Ruy proper.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 e8g8", "c2c3")  // 8.c3 vs early castling.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 g8f6 e1g1 f6e4", "f1e1")  // 5.Re1, the open Berlin.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 g8f6 e1g1 f6e4 f1e1 e4d6", "f3e5")  // 6.Nxe5, the main anti-Berlin.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 g8f6 e1g1 f6e4 f1e1 e4d6 f3e5 f8e7", "b5f1")  // 7.Bf1, the odd-looking book move.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 g8f6 e1g1 f6e4 f1e1 e4d6 f3e5 f8e7 b5f1 c6e5", "e1e5")  // 8.Rxe5.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 g8f6 e1g1 f6e4 f1e1 e4d6 f3e5 f8e7 b5f1 c6e5 e1e5 e8g8", "d2d4")  // 9.d4.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 d7d6 c2c3 e8g8", "h2h3")  // 9.h3, the tabiya.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 d7d6 c2c3 e8g8 h2h3 c6a5", "b3c2")  // 10.Bc2, the Chigorin.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 d7d6 c2c3 e8g8 h2h3 c6a5 b3c2 c7c5", "d2d4")  // 11.d4.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 d7d6 c2c3 e8g8 h2h3 c6a5 b3c2 c7c5 d2d4 d8c7", "b1d2")  // 12.Nbd2, still the main line.

    // === WHITE vs 1...e5: quiet-Italian continuations (both Two Knights and Giuoco keys) ===
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3 d7d6", "e1g1")  // 5.O-O when Black holds back the bishop.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 d2d3 g8f6 b1c3 d7d6", "e1g1")  // 6.O-O.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 d2d3 g8f6 b1c3 d7d6 e1g1 e8g8", "c1e3")  // 7.Be3, offering the trade.

    // === WHITE vs 1...c5: Open Sicilian first moves ===
    _map_book.put("e2e4 c7c5", "g1f3|b1c3")  // 2.Nf3 (Open) or 2.Nc3 (Closed Sicilian).
    _map_book.put("e2e4 c7c5 g1f3 d7d6", "d2d4")                        // 3.d4, the Open Sicilian.
    _map_book.put("e2e4 c7c5 g1f3 b8c6", "d2d4")                        // 3.d4 vs ...Nc6.
    _map_book.put("e2e4 c7c5 g1f3 e7e6", "d2d4")                        // 3.d4 vs ...e6.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4", "f3d4")             // 5.Nxd4 recapturing.
    _map_book.put("e2e4 c7c5 g1f3 b8c6 d2d4 c5d4", "f3d4")             // 5.Nxd4.
    _map_book.put("e2e4 c7c5 g1f3 e7e6 d2d4 c5d4", "f3d4")             // 5.Nxd4.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6", "b1c3")  // 5.Nc3 guarding e4.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6", "f1e2")  // 6.Be2 vs the Najdorf, solid.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 g7g6", "f1e2")  // 6.Be2 vs the Dragon, keeping it calm.
    _map_book.put("e2e4 c7c5 g1f3 b8c6 d2d4 c5d4 f3d4 g8f6", "b1c3")  // 5.Nc3.
    _map_book.put("e2e4 c7c5 g1f3 e7e6 d2d4 c5d4 f3d4 g8f6", "b1c3")  // 5.Nc3.

    // === WHITE vs 1...c5: Closed Sicilian (reached when the book's move-2 choice picks b1c3) ===
    _map_book.put("e2e4 c7c5 b1c3 b8c6", "g2g3")  // 3.g3, the classical Closed setup.
    _map_book.put("e2e4 c7c5 b1c3 b8c6 g2g3 g7g6", "f1g2")  // 4.Bg2.
    _map_book.put("e2e4 c7c5 b1c3 d7d6", "g2g3")  // 3.g3.
    _map_book.put("e2e4 c7c5 b1c3 e7e6", "g2g3")  // 3.g3, same recipe vs ...e6.
    _map_book.put("e2e4 c7c5 b1c3 b8c6 g2g3 g7g6 f1g2 f8g7", "d2d3")  // 5.d3.
    _map_book.put("e2e4 c7c5 b1c3 b8c6 g2g3 g7g6 f1g2 f8g7 d2d3 d7d6", "f2f4")  // 6.f4, the Closed's pawn storm begins.
    _map_book.put("e2e4 c7c5 b1c3 b8c6 g2g3 g7g6 f1g2 f8g7 d2d3 d7d6 f2f4 e7e6", "g1f3")  // 7.Nf3.
    _map_book.put("e2e4 c7c5 b1c3 b8c6 g2g3 g7g6 f1g2 f8g7 d2d3 d7d6 f2f4 e7e6 g1f3 g8e7", "e1g1")  // 8.O-O.
    _map_book.put("e2e4 c7c5 b1c3 d7d6 g2g3 b8c6", "f1g2")  // 4.Bg2, transposing to the main Closed.
    _map_book.put("e2e4 c7c5 b1c3 e7e6 g2g3 b8c6", "f1g2")  // 4.Bg2.

    // === WHITE vs the Sicilian: deeper Open lines ===
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6 f1e2 e7e5", "d4b3")  // 7.Nb3, the Najdorf main retreat.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6 f1e2 e7e5 d4b3 f8e7", "e1g1")  // 8.O-O.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6 f1e2 e7e5 d4b3 f8e7 e1g1 e8g8", "c1e3")  // 9.Be3.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6 f1e2 e7e5 d4b3 f8e7 e1g1 e8g8 c1e3 c8e6", "d1d2")  // 10.Qd2, calm development.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 g7g6 f1e2 f8g7", "e1g1")  // 7.O-O vs the Dragon.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 g7g6 f1e2 f8g7 e1g1 e8g8", "c1e3")  // 8.Be3.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 g7g6 f1e2 f8g7 e1g1 e8g8 c1e3 b8c6", "d4b3")  // 9.Nb3, sidestepping the tricks on d4.
    _map_book.put("e2e4 c7c5 g1f3 b8c6 d2d4 c5d4 f3d4 g8f6 b1c3 e7e5", "d4b5")  // 6.Ndb5 vs the Sveshnikov, the only testing move.
    _map_book.put("e2e4 c7c5 g1f3 b8c6 d2d4 c5d4 f3d4 g8f6 b1c3 e7e5 d4b5 d7d6", "c1g5")  // 7.Bg5.
    _map_book.put("e2e4 c7c5 g1f3 b8c6 d2d4 c5d4 f3d4 g8f6 b1c3 d7d6", "c1g5")  // 6.Bg5, the Richter-Rauzer.
    _map_book.put("e2e4 c7c5 g1f3 b8c6 d2d4 c5d4 f3d4 g8f6 b1c3 d7d6 c1g5 e7e6", "d1d2")  // 7.Qd2.
    _map_book.put("e2e4 c7c5 g1f3 b8c6 d2d4 c5d4 f3d4 g8f6 b1c3 g7g6", "f1e2")  // 6.Be2, keeping the Dragon quiet.
    _map_book.put("e2e4 c7c5 g1f3 e7e6 d2d4 c5d4 f3d4 g8f6 b1c3 b8c6", "f1e2")  // 6.Be2, the quiet Four Knights Sicilian.
    _map_book.put("e2e4 c7c5 g1f3 e7e6 d2d4 c5d4 f3d4 a7a6", "f1d3")  // 5.Bd3 vs the Kan.
    _map_book.put("e2e4 c7c5 g1f3 e7e6 d2d4 c5d4 f3d4 b8c6", "b1c3")  // 5.Nc3 vs the Taimanov.
    _map_book.put("e2e4 c7c5 g1f3 e7e6 d2d4 c5d4 f3d4 b8c6 b1c3 d8c7", "f1e2")  // 6.Be2.

    // === WHITE vs 1...e6: French, exchange-ish / solid ===
    _map_book.put("e2e4 e7e6", "d2d4")                                  // 2.d4 the main centre.
    _map_book.put("e2e4 e7e6 d2d4 d7d5", "b1c3")                        // 3.Nc3, the main line.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 g8f6", "e4e5")             // 4.e5 the Steinitz.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 f8b4", "e4e5")             // 4.e5 vs the Winawer.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 g8f6 e4e5 f6d7", "f2f4")  // 5.f4, the big Steinitz centre.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 f8b4 e4e5 c7c5", "a2a3")  // 5.a3 putting the question to the Winawer bishop.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 f8b4 e4e5 c7c5 a2a3 b4c3", "b2c3")  // 6.bxc3.

    // === WHITE vs 1...c6: Caro-Kann, main line ===
    _map_book.put("e2e4 c7c6", "d2d4")                                  // 2.d4.
    _map_book.put("e2e4 c7c6 d2d4 d7d5", "b1c3")                        // 3.Nc3 the classical.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4", "c3e4")             // 4.Nxe4 recapturing.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 c8f5", "e4g3")  // 5.Ng3 hitting the bishop, the main line.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 b8d7", "g1f3")  // 5.Nf3, the Smyslov line.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 g8f6", "e4f6")  // 5.Nxf6+, doubling the pawns.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 d5e4", "c3e4")             // Rubinstein French: 4.Nxe4.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 d5e4 c3e4 b8d7", "g1f3")  // 5.Nf3.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 d5e4 c3e4 b8d7 g1f3 g8f6", "e4f6")  // 6.Nxf6+.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 d5e4 c3e4 b8d7 g1f3 g8f6 e4f6 d7f6", "f1d3")  // 7.Bd3.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 g8f6 e4e5 f6d7 f2f4 c7c5", "g1f3")  // 6.Nf3, holding the big centre.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 g8f6 e4e5 f6d7 f2f4 c7c5 g1f3 b8c6", "c1e3")  // 7.Be3.
    _map_book.put("e2e4 e7e6 d2d4 d7d5 b1c3 f8b4 e4e5 c7c5 a2a3 b4c3 b2c3 g8e7", "g1f3")  // 7.Nf3, the calm Winawer (no Qg4 fireworks).
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 c8f5 e4g3 f5g6", "h2h4")  // 6.h4, the classical Caro squeeze.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 c8f5 e4g3 f5g6 h2h4 h7h6", "g1f3")  // 7.Nf3.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 c8f5 e4g3 f5g6 h2h4 h7h6 g1f3 b8d7", "h4h5")  // 8.h5 nudging the bishop.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 c8f5 e4g3 f5g6 h2h4 h7h6 g1f3 b8d7 h4h5 g6h7", "f1d3")  // 9.Bd3 offering the trade.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 c8f5 e4g3 f5g6 h2h4 h7h6 g1f3 b8d7 h4h5 g6h7 f1d3 h7d3", "d1d3")  // 10.Qxd3, the classical tabiya.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 b8d7 g1f3 g8f6", "e4f6")  // 6.Nxf6+ in the Smyslov line.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 b8d7 g1f3 g8f6 e4f6 d7f6", "f3e5")  // 7.Ne5, the annoying outpost.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 g8f6 e4f6 e7f6", "c2c3")  // 6.c3, solid vs ...exf6.
    _map_book.put("e2e4 c7c6 d2d4 d7d5 b1c3 d5e4 c3e4 g8f6 e4f6 g7f6", "c2c3")  // 6.c3, same recipe vs ...gxf6.

    // === WHITE vs 1...e5 sidelines: Philidor, Petroff move order, Latvian, Elephant ===
    _map_book.put("e2e4 e7e5 g1f3 d7d6", "d2d4")                        // Philidor: 3.d4 claiming the centre.
    _map_book.put("e2e4 e7e5 g1f3 d7d6 d2d4 e5d4", "f3d4")             // 4.Nxd4.
    _map_book.put("e2e4 e7e5 g1f3 d7d6 d2d4 g8f6", "b1c3")             // 4.Nc3 guarding e4.
    _map_book.put("e2e4 e7e5 g1f3 d7d6 d2d4 e5d4 f3d4 g8f6", "b1c3")  // 5.Nc3.
    _map_book.put("e2e4 e7e5 g1f3 d7d6 d2d4 g8f6 b1c3 b8d7", "f1c4")  // 5.Bc4 vs the Hanham setup.
    _map_book.put("e2e4 e7e5 g1f3 d7d6 d2d4 e5d4 f3d4 g8f6 b1c3 f8e7", "f1e2")  // 6.Be2, calm development.
    _map_book.put("e2e4 e7e5 g1f3 g8f6 b1c3 f8b4", "f1c4")             // 4.Bc4 when Black pins the knight.
    _map_book.put("e2e4 e7e5 g1f3 g8f6 b1c3 b8c6 f1c4 f8c5", "d2d3")  // 5.d3, the quiet Italian Four Knights.
    _map_book.put("e2e4 e7e5 g1f3 g8f6 b1c3 b8c6 f1c4 f8b4", "e1g1")  // 5.O-O.
    _map_book.put("e2e4 e7e5 g1f3 g8f6 b1c3 b8c6 f1c4 f8c5 d2d3 d7d6", "e1g1")  // 6.O-O.
    _map_book.put("e2e4 e7e5 g1f3 g8f6 b1c3 b8c6 f1c4 f8c5 d2d3 e8g8", "e1g1")  // 6.O-O.
    _map_book.put("e2e4 e7e5 g1f3 f7f5", "f3e5")                        // Latvian Gambit: 3.Nxe5 takes the free pawn.
    _map_book.put("e2e4 e7e5 g1f3 f7f5 f3e5 d8f6", "d2d4")             // 4.d4 propping the knight.
    _map_book.put("e2e4 e7e5 g1f3 f7f5 f3e5 d8f6 d2d4 d7d6", "e5c4")  // 5.Nc4 stepping back with the pawn in hand.
    _map_book.put("e2e4 e7e5 g1f3 d7d5", "e4d5")                        // Elephant Gambit: 3.exd5, just take.
    _map_book.put("e2e4 e7e5 g1f3 d7d5 e4d5 e5e4", "d1e2")             // 4.Qe2 winning the stray e-pawn.

    // === WHITE vs 1...d5: Scandinavian ===
    _map_book.put("e2e4 d7d5", "e4d5")                                  // 2.exd5.
    _map_book.put("e2e4 d7d5 e4d5 d8d5", "b1c3")                        // 3.Nc3 hitting the queen.
    _map_book.put("e2e4 d7d5 e4d5 g8f6", "d2d4")                        // 3.d4, keeping the extra pawn for now.
    _map_book.put("e2e4 d7d5 e4d5 d8d5 b1c3 d5a5", "d2d4")             // 4.d4, the main-line centre.
    _map_book.put("e2e4 d7d5 e4d5 d8d5 b1c3 d5d6", "d2d4")             // 4.d4 vs the modern ...Qd6.
    _map_book.put("e2e4 d7d5 e4d5 d8d5 b1c3 d5d8", "d2d4")             // 4.d4 vs the shy retreat.
    _map_book.put("e2e4 d7d5 e4d5 d8d5 b1c3 d5a5 d2d4 g8f6", "g1f3")  // 5.Nf3.
    _map_book.put("e2e4 d7d5 e4d5 d8d5 b1c3 d5a5 d2d4 c7c6", "g1f3")  // 5.Nf3.
    _map_book.put("e2e4 d7d5 e4d5 d8d5 b1c3 d5a5 d2d4 g8f6 g1f3 c8f5", "f1c4")  // 6.Bc4 developing with tempo on f7.
    _map_book.put("e2e4 d7d5 e4d5 d8d5 b1c3 d5a5 d2d4 g8f6 g1f3 c8g4", "h2h3")  // 6.h3 putting the question.
    _map_book.put("e2e4 d7d5 e4d5 g8f6 d2d4 f6d5", "g1f3")             // 4.Nf3, solid.
    _map_book.put("e2e4 d7d5 e4d5 g8f6 d2d4 f6d5 g1f3 g7g6", "c2c4")  // 5.c4 kicking the knight.
    _map_book.put("e2e4 d7d5 e4d5 g8f6 d2d4 f6d5 g1f3 g7g6 c2c4 d5b6", "b1c3")  // 6.Nc3.

    // === WHITE vs 1...Nf6: Alekhine ===
    _map_book.put("e2e4 g8f6", "e4e5")                                  // 2.e5 chasing the knight.
    _map_book.put("e2e4 g8f6 e4e5 f6d5", "d2d4")                        // 3.d4.
    _map_book.put("e2e4 g8f6 e4e5 f6d5 d2d4 d7d6", "g1f3")             // 4.Nf3, the restrained main line.
