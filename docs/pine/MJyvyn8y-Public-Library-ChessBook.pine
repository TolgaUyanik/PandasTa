    _map_book.put("e2e4 e7e5 d2d4 e5d4 d1d4 b8c6 d4e3", "g8f6")      // 4...Nf6.
    _map_book.put("e2e4 e7e5 d2d4 e5d4 d1d4 b8c6 d4a4", "g8f6")      // 4...Nf6.
    _map_book.put("e2e4 e7e5 d2d4 e5d4 c2c3", "d7d5")                 // Danish declined: 3...d5, the safe answer.
