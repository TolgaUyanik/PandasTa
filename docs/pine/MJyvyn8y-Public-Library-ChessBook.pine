    _map_book.put("d2d4 g8f6 c2c4 e7e6 b1c3 f8b4 d1c2", "e8g8")  // 4.Qc2 O-O.

    // === BLACK vs 1.d4 with 1...Nf6 (reached when the book's reply choice picks g8f6) ===
    _map_book.put("d2d4 g8f6 c2c4", "e7e6")                            // 2...e6, into Nimzo/QGD structures.
    _map_book.put("d2d4 g8f6 g1f3", "e7e6")                            // 2.Nf3 e6, flexible.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3", "d7d5|b7b6")            // 3...d5 (QGD) or 3...b6 (Queen's Indian).
