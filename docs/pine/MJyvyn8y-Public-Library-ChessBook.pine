    _map_book.put("e2e4 e7e5 d2d4 e5d4 c2c3 d7d5 e4d5 d8d5 c3d4", "b8c6")  // 5...Nc6, comfortable development.
    _map_book.put("e2e4 e7e5 d2d4 e5d4 g1f3", "b8c6")                 // The Scotch by another door.
    _map_book.put("e2e4 e7e5 d2d4 e5d4 g1f3 b8c6 f3d4", "g8f6")      // 4...Nf6.
    _map_book.put("e2e4 e7e5 d2d4 e5d4 g1f3 b8c6 f3d4 g8f6 d4c6", "b7c6")  // 5...bxc6 towards the centre.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 c2c3", "d7d5")                 // Ponziani: 3...d5, striking back at once.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 c2c3 d7d5 e4d5", "d8d5")      // 4...Qxd5 (c3 took the knight's square, so no fork).
    _map_book.put("e2e4 e7e5 g1f3 b8c6 c2c3 d7d5 d1a4", "f7f6")      // 4.Qa4 f6, holding everything.
    _map_book.put("e2e4 e7e5 d1h5", "b8c6")                            // The Wayward Queen: 2...Nc6 guards e5.
    _map_book.put("e2e4 e7e5 d1h5 b8c6 f1c4", "g7g6")                 // 3...g6 hitting the queen and covering f7.
    _map_book.put("e2e4 e7e5 d1h5 b8c6 f1c4 g7g6 h5f3", "g8f6")      // 4...Nf6, developing with more tempo.

    // === BLACK vs 1.e4: Scotch and Ruy continuations ===
    _map_book.put("e2e4 e7e5 g1f3 b8c6 d2d4 e5d4 f3d4 g8f6 b1c3", "f8b4")  // 5.Nc3 Bb4, the Scotch Four Knights.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 d2d4 e5d4 f3d4 g8f6 d4c6 b7c6 e4e5", "d8e7")  // 6...Qe7 pinning the e-pawn.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 d2d4 e5d4 f3d4 g8f6 d4c6 b7c6 e4e5 d8e7 d1e2", "f6d5")  // 7...Nd5, the main Scotch tabiya.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5c6 d7c6 e1g1", "f7f6")  // Exchange Ruy: 5...f6 shoring up e5.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5c6 d7c6 e1g1 f7f6 d2d4", "e5d4")  // 6...exd4.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5c6 d7c6 e1g1 f7f6 d2d4 e5d4 f3d4", "c6c5")  // 7...c5 nudging the knight.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5c6 d7c6 e1g1 f7f6 d2d4 e5d4 f3d4 c6c5 d4e2", "d8d1")  // 8...Qxd1, happy to trade into the endgame.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 d7d6 c2c3 e8g8 h2h3", "c6a5")  // 9...Na5, the Chigorin.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 d7d6 c2c3 e8g8 h2h3 c6a5 b3c2", "c7c5")  // 10...c5.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 d7d6 c2c3 e8g8 h2h3 c6a5 b3c2 c7c5 d2d4", "d8c7")  // 11...Qc7, the classical Chigorin tabiya.

    // === BLACK vs 1.e4: more Sicilian roads ===
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6 f1e2 e7e5 d4b3", "f8e7")  // 7...Be7.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6 f1e2 e7e5 d4b3 f8e7 e1g1", "e8g8")  // 8...O-O.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6 f1e2 e7e5 d4b3 f8e7 e1g1 e8g8 c1e3", "c8e6")  // 9...Be6, the main Najdorf plan.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 f1b5", "c8d7")                 // Moscow check: 3...Bd7, the least fuss.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 f1b5 c8d7 b5d7", "d8d7")      // 4...Qxd7.
    _map_book.put("e2e4 c7c5 c2c3 g8f6 e4e5", "f6d5")                 // Alapin: 3...Nd5.
    _map_book.put("e2e4 c7c5 c2c3 g8f6 e4e5 f6d5 d2d4", "c5d4")      // 4...cxd4.
    _map_book.put("e2e4 c7c5 c2c3 g8f6 e4e5 f6d5 d2d4 c5d4 g1f3", "b8c6")  // 5...Nc6.
    _map_book.put("e2e4 c7c5 c2c3 g8f6 e4e5 f6d5 d2d4 c5d4 g1f3 b8c6 c3d4", "d7d6")  // 6...d6 chipping at the centre.
    _map_book.put("e2e4 c7c5 d2d4", "c5d4")                            // Smith-Morra: take first, decline after.
    _map_book.put("e2e4 c7c5 d2d4 c5d4 c2c3", "g8f6")                 // 3...Nf6! declines into an Alapin we already know.
    _map_book.put("e2e4 c7c5 d2d4 c5d4 c2c3 g8f6 e4e5", "f6d5")      // 4...Nd5.
    _map_book.put("e2e4 c7c5 d2d4 c5d4 c2c3 g8f6 e4e5 f6d5 c3d4", "d7d6")  // 5...d6.
