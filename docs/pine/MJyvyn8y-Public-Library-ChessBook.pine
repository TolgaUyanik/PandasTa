    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 c7c5", "c4d5")             // Tarrasch: 4.cxd5.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 c7c5 c4d5 e6d5", "g1f3")  // 5.Nf3.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 c7c5 c4d5 e6d5 g1f3 b8c6", "g2g3")  // 6.g3, Rubinstein's squeeze on d5.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 c7c5 c4d5 e6d5 g1f3 b8c6 g2g3 g8f6", "f1g2")  // 7.Bg2.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 c7c5 c4d5 e6d5 g1f3 b8c6 g2g3 g8f6 f1g2 f8e7", "e1g1")  // 8.O-O.
    _map_book.put("d2d4 d7d5 c2c4 e7e5", "d4e5")                        // Albin: 3.dxe5, just take.
    _map_book.put("d2d4 d7d5 c2c4 e7e5 d4e5 d5d4", "g1f3")             // 4.Nf3, keeping the extra pawn safely.
    _map_book.put("d2d4 d7d5 c2c4 c7c5", "c4d5")                        // Symmetric ...c5: 3.cxd5.
    _map_book.put("d2d4 d7d5 c2c4 c7c5 c4d5 d8d5", "g1f3")             // 4.Nf3, gaining time on the queen.
    _map_book.put("d2d4 d7d5 c2c4 b8c6", "g1f3")                        // Chigorin: 3.Nf3, sensible development.

    // === BLACK vs 1.e4: 1...e5 into Italian / Ruy setups ===
    _map_book.put("e2e4", "e7e5|c7c5")                                  // 1...e5 or the Sicilian 1...c5.
    _map_book.put("e2e4 e7e5 g1f3", "b8c6")                             // 2...Nc6 defending e5.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4", "f8c5|g8f6")            // 3...Bc5 (Italian) or 3...Nf6 (Two Knights).
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5", "a7a6")                  // 3...a6, the Ruy Lopez main line.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4", "g8f6")       // 5...Nf6 the main line.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5c6", "d7c6")       // 5...dxc6 the Exchange Ruy.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 c2c3", "g8f6")       // 4...Nf6.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 d2d3", "g8f6")       // 4...Nf6 vs the quiet d3 Italian.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 e1g1", "g8f6")       // 4...Nf6 when White castles early.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 b1c3", "g8f6")                  // Four Knights: 3...Nf6.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 b1c3 g8f6 f1c4", "f8c5")       // 4.Bc4 Bc5, Italian Four Knights.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1", "f8e7")  // Closed Ruy: 5.O-O Be7.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 d2d4", "e5d4")                 // Scotch: 3...exd4.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 d2d4 e5d4 f3d4", "g8f6")      // 4...Nf6.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 d2d4 e5d4 f1c4", "f8c5")      // Scotch Gambit: 4...Bc5.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 c2c3 g8f6 d2d3", "d7d6")  // 5...d6, completing the quiet Italian wall.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 c2c3 g8f6 d2d3 d7d6 e1g1", "e8g8")  // 6...O-O.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3 f8c5 e1g1", "e8g8")  // 5...O-O in the quiet Two Knights.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3 f8e7 e1g1", "e8g8")  // 5...O-O.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1", "b7b5")  // 6...b5 pushing the bishop.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3", "d7d6")  // 7...d6.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1b5 a7a6 b5a4 g8f6 e1g1 f8e7 f1e1 b7b5 a4b3 d7d6 c2c3", "e8g8")  // 8...O-O, reaching the standard Closed Ruy position.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 d2d4 e5d4 f3d4 g8f6 d4c6", "b7c6")  // 5...bxc6 recapturing towards the centre.

    // === BLACK vs 1.e4: the Sicilian (reached when the book's reply choice picks c7c5) ===
    _map_book.put("e2e4 c7c5 g1f3", "d7d6")                            // 2...d6, the Najdorf/Scheveningen complex.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4", "c5d4")                 // 3...cxd4.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4", "g8f6")      // 4...Nf6 hitting e4.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3", "a7a6")  // 5...a6, the Najdorf.
    _map_book.put("e2e4 c7c5 b1c3", "b8c6")                            // vs the Closed Sicilian: 2...Nc6.
    _map_book.put("e2e4 c7c5 c2c3", "g8f6")                            // vs the Alapin: 2...Nf6 hitting e4.
    _map_book.put("e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6 f1e2", "e7e5")  // 6...e5, the Najdorf main reply to Be2.

    // === BLACK vs 1.e4: the Two Knights, including the 4.Ng5 attack on f7 ===
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3", "f8c5|f8e7")  // 4...Bc5 or the solid 4...Be7.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 f3g5", "d7d5")       // 4.Ng5 hits f7. 4...d5 is the only good reply.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 f3g5 d7d5 e4d5", "c6a5")  // 5...Na5, NOT 5...Nxd5 (the Fried Liver falls on that).
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 f3g5 d7d5 e4d5 c6a5 c4b5", "c7c6")  // 6...c6 blocking the check.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 f3g5 d7d5 e4d5 c6a5 c4b5 c7c6 d5c6", "b7c6")  // 7...bxc6.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 f3g5 d7d5 e4d5 c6a5 c4b5 c7c6 d5c6 b7c6 b5e2", "h7h6")  // 8...h6 asking the knight.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 f3g5 d7d5 e4d5 c6a5 c4b5 c7c6 d5c6 b7c6 b5e2 h7h6 g5f3", "e5e4")  // 9...e4, the pawn we get for our trouble.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d4", "e5d4")       // 4.d4 exd4, keep it simple.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 b1c3", "f8c5")       // 4.Nc3 Bc5, the Italian Four Knights.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 b1c3 f8c5 d2d3", "d7d6")  // 5...d6.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3 f8c5 e1g1 e8g8 c2c3", "d7d6")  // 6...d6 in the quiet Two Knights.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 d2d3 f8e7 e1g1 e8g8 f1e1", "d7d6")  // 6...d6.

    // === BLACK vs 1.e4: quiet-Italian and choice-line continuations ===
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 d2d3 g8f6 b1c3", "d7d6")  // 5...d6, the solid wall.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 d2d3 g8f6 b1c3 d7d6 e1g1", "e8g8")  // 6...O-O.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 d2d3 g8f6 b1c3 d7d6 e1g1 e8g8 c1e3", "c5b6")  // 7...Bb6 keeping the good bishop.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 b2b4", "c5b6")       // Evans Gambit declined: 4...Bb6, no thanks.
    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 b2b4 c5b6 a2a4", "a7a6")  // 5...a6 making room.
