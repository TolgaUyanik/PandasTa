    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 f8g7", "e2e4")  // 4.e4, the King's Indian main centre.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 f8g7 e2e4 d7d6", "g1f3")  // 5.Nf3.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 g1f3 g8f6 b1c3 f8e7", "c1g5")  // 5.Bg5, back into the classical QGD.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 g1f3 g8f6 b1c3 f8e7 c1g5 e8g8", "e2e3")  // 6.e3.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 g1f3 g8f6 b1c3 f8e7 c1g5 e8g8 e2e3 b8d7", "a1c1")  // 7.Rc1.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 d7d5 b1c3 f8e7", "c1g5")  // 5.Bg5, the same QGD by the Indian door.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 d7d5 b1c3 f8e7 c1g5 e8g8", "e2e3")  // 6.e3.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 d7d5 b1c3 f8e7 c1g5 e8g8 e2e3 b8d7", "a1c1")  // 7.Rc1.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7 f1g2 f8e7 e1g1 e8g8 b1c3 f6e4", "d1c2")  // 8.Qc2, questioning the knight.
    _map_book.put("d2d4 g8f6 c2c4 e7e6 g1f3 b7b6 g2g3 c8b7 f1g2 f8e7 e1g1 e8g8 b1c3 f6e4 d1c2 e4c3", "c2c3")  // 9.Qxc3.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 c1g5 f8e7 e2e3 e8g8 g1f3 b8d7", "a1c1")  // 7.Rc1, Capablanca's move.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 c1g5 f8e7 e2e3 e8g8 g1f3 b8d7 a1c1 c7c6", "f1d3")  // 8.Bd3.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 c1g5 f8e7 e2e3 e8g8 g1f3 b8d7 a1c1 c7c6 f1d3 d5c4", "d3c4")  // 9.Bxc4.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 c1g5 f8e7 e2e3 e8g8 g1f3 b8d7 a1c1 c7c6 f1d3 d5c4 d3c4 f6d5", "g5e7")  // 10.Bxe7, the freeing sequence.
    _map_book.put("d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 c1g5 f8e7 e2e3 e8g8 g1f3 b8d7 a1c1 c7c6 f1d3 d5c4 d3c4 f6d5 g5e7 d8e7", "e1g1")  // 11.O-O.
    _map_book.put("d2d4 d7d5 c2c4 c7c6 g1f3 g8f6 b1c3 d5c4", "a2a4")  // 5.a4, stopping ...b5 in the Slav.
    _map_book.put("d2d4 d7d5 c2c4 c7c6 g1f3 g8f6 b1c3 d5c4 a2a4 c8f5", "e2e3")  // 6.e3.
    _map_book.put("d2d4 d7d5 c2c4 c7c6 g1f3 g8f6 b1c3 d5c4 a2a4 c8f5 e2e3 e7e6", "f1c4")  // 7.Bxc4.
    _map_book.put("d2d4 d7d5 c2c4 c7c6 g1f3 g8f6 b1c3 d5c4 a2a4 c8f5 e2e3 e7e6 f1c4 f8b4", "e1g1")  // 8.O-O, the main-line Slav.
    _map_book.put("d2d4 d7d5 c2c4 c7c6 g1f3 g8f6 b1c3 e7e6", "e2e3")  // 5.e3, the Semi-Slav kept quiet.
    _map_book.put("d2d4 d7d5 c2c4 c7c6 g1f3 g8f6 b1c3 e7e6 e2e3 b8d7", "f1d3")  // 6.Bd3.
    _map_book.put("d2d4 d7d5 c2c4 c7c6 g1f3 g8f6 b1c3 e7e6 e2e3 b8d7 f1d3 d5c4", "d3c4")  // 7.Bxc4, into the Meran.
    _map_book.put("d2d4 d7d5 c2c4 c7c6 g1f3 g8f6 b1c3 e7e6 e2e3 b8d7 f1d3 d5c4 d3c4 b7b5", "c4d3")  // 8.Bd3, the main retreat.
    _map_book.put("d2d4 d7d5 c2c4 d5c4 g1f3 g8f6 e2e3 e7e6 f1c4 c7c5", "e1g1")  // 6.O-O in the QGA.
    _map_book.put("d2d4 d7d5 c2c4 d5c4 g1f3 g8f6 e2e3 e7e6 f1c4 c7c5 e1g1 a7a6", "d1e2")  // 7.Qe2, eyeing e4 and the c-file.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 f8g7 e2e4 d7d6 g1f3 e8g8", "f1e2")  // 6.Be2, the classical King's Indian.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 f8g7 e2e4 d7d6 g1f3 e8g8 f1e2 e7e5", "e1g1")  // 7.O-O, the main line.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 f8g7 e2e4 d7d6 g1f3 e8g8 f1e2 e7e5 e1g1 b8c6", "d4d5")  // 8.d5 closing the centre.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 f8g7 e2e4 d7d6 g1f3 e8g8 f1e2 e7e5 e1g1 b8c6 d4d5 c6e7", "b2b4")  // 9.b4, the Bayonet.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 d7d5", "c4d5")             // Grunfeld: 4.cxd5.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 d7d5 c4d5 f6d5", "e2e4")  // 5.e4, the Exchange centre.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 d7d5 c4d5 f6d5 e2e4 d5c3", "b2c3")  // 6.bxc3.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 d7d5 c4d5 f6d5 e2e4 d5c3 b2c3 f8g7", "g1f3")  // 7.Nf3.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 d7d5 c4d5 f6d5 e2e4 d5c3 b2c3 f8g7 g1f3 c7c5", "a1b1")  // 8.Rb1, the modern main line.
    _map_book.put("d2d4 g8f6 c2c4 g7g6 b1c3 d7d5 c4d5 f6d5 e2e4 d5c3 b2c3 f8g7 g1f3 c7c5 a1b1 e8g8", "f1e2")  // 9.Be2.
    _map_book.put("d2d4 g8f6 c2c4 c7c5", "d4d5")                        // Benoni: 3.d5, gaining space.
    _map_book.put("d2d4 g8f6 c2c4 c7c5 d4d5 e7e6", "b1c3")             // 4.Nc3.
    _map_book.put("d2d4 g8f6 c2c4 c7c5 d4d5 e7e6 b1c3 e6d5", "c4d5")  // 5.cxd5.
    _map_book.put("d2d4 g8f6 c2c4 c7c5 d4d5 e7e6 b1c3 e6d5 c4d5 d7d6", "e2e4")  // 6.e4.
    _map_book.put("d2d4 g8f6 c2c4 c7c5 d4d5 e7e6 b1c3 e6d5 c4d5 d7d6 e2e4 g7g6", "g1f3")  // 7.Nf3.
    _map_book.put("d2d4 g8f6 c2c4 c7c5 d4d5 e7e6 b1c3 e6d5 c4d5 d7d6 e2e4 g7g6 g1f3 f8g7", "f1e2")  // 8.Be2.
    _map_book.put("d2d4 g8f6 c2c4 c7c5 d4d5 e7e6 b1c3 e6d5 c4d5 d7d6 e2e4 g7g6 g1f3 f8g7 f1e2 e8g8", "e1g1")  // 9.O-O, the classical Benoni.
    _map_book.put("d2d4 g8f6 c2c4 c7c5 d4d5 b7b5", "c4b5")             // Benko: 4.cxb5, take and hold.
    _map_book.put("d2d4 g8f6 c2c4 c7c5 d4d5 b7b5 c4b5 a7a6", "b5a6")  // 5.bxa6.
    _map_book.put("d2d4 g8f6 c2c4 c7c5 d4d5 b7b5 c4b5 a7a6 b5a6 c8a6", "b1c3")  // 6.Nc3, a pawn to the good.
    _map_book.put("d2d4 f7f5", "g2g3")                                  // Dutch: 2.g3, the fianchetto recipe.
    _map_book.put("d2d4 f7f5 g2g3 g8f6", "f1g2")                        // 3.Bg2.
    _map_book.put("d2d4 f7f5 g2g3 g8f6 f1g2 e7e6", "g1f3")             // 4.Nf3, the Classical Dutch shape.
    _map_book.put("d2d4 f7f5 g2g3 g8f6 f1g2 e7e6 g1f3 f8e7", "e1g1")  // 5.O-O.
    _map_book.put("d2d4 f7f5 g2g3 g8f6 f1g2 e7e6 g1f3 f8e7 e1g1 e8g8", "c2c4")  // 6.c4.
    _map_book.put("d2d4 f7f5 g2g3 g8f6 f1g2 e7e6 g1f3 f8e7 e1g1 e8g8 c2c4 d7d6", "b1c3")  // 7.Nc3.
    _map_book.put("d2d4 f7f5 g2g3 g8f6 f1g2 g7g6", "g1f3")             // 4.Nf3 vs the Leningrad.
    _map_book.put("d2d4 f7f5 g2g3 g8f6 f1g2 g7g6 g1f3 f8g7", "e1g1")  // 5.O-O.
    _map_book.put("d2d4 f7f5 g2g3 g8f6 f1g2 g7g6 g1f3 f8g7 e1g1 e8g8", "c2c4")  // 6.c4.
