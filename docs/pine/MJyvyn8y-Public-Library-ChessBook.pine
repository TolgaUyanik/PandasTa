    _map_book.put("e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 d2d4", "e5d4")       // 4.d4 exd4.

    // === BLACK vs 1.e4: King's Gambit, Vienna, Bishop's Opening, Centre Game ===
