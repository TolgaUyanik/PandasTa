//@version=5
strategy("SERHAN1-WMA + RSI + Trailing Scalp (Date Filter)",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100)

//=====================================================
// TARİH FİLTRESİ
//=====================================================
startDate = input.time(timestamp("2020-01-01 00:00"), "Başlangıç Tarihi")
endDate   = input.time(timestamp("2030-12-31 23:59"), "Bitiş Tarihi")

inDateRange = time >= startDate and time <= endDate

//=====================================================
// GİRDİLER
//=====================================================
fastLen = input.int(9, title="Hızlı WMA", minval=1)
slowLen = input.int(21, title="Yavaş WMA", minval=1)
rsiLen  = input.int(14, title="RSI Periyodu", minval=1)

trailPerc = input.float(
     1.5,
     title="İz Süren Stop %",
     minval=0,
     step=0.1) / 100

//=====================================================
// HESAPLAMALAR
//=====================================================
fastWMA = ta.wma(close, fastLen)
slowWMA = ta.wma(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)

//=====================================================
// KOŞULLAR
//=====================================================
longCondition =
     ta.crossover(fastWMA, slowWMA) and
     close > fastWMA and
     close > slowWMA and
     rsiVal > 50

shortCondition =
     ta.crossunder(fastWMA, slowWMA) and
     close < fastWMA and
     close < slowWMA and
     rsiVal < 50

//=====================================================
// GİRİŞLER
//=====================================================
if inDateRange and longCondition
    strategy.entry("Long", strategy.long, comment="L")

if inDateRange and shortCondition
    strategy.entry("Short", strategy.short, comment="S")

//=====================================================
// TRAILING STOP
//=====================================================
if strategy.position_size > 0 and trailPerc > 0
    strategy.exit(
         "Exit Long",
         "Long",
         trail_points = close * trailPerc / syminfo.mintick,
         trail_offset = 0)

if strategy.position_size < 0 and trailPerc > 0
    strategy.exit(
         "Exit Short",
         "Short",
         trail_points = close * trailPerc / syminfo.mintick,
         trail_offset = 0)

//=====================================================
// GRAFİK
//=====================================================
plot(fastWMA, color=color.blue, title="Hızlı WMA")
plot(slowWMA, color=color.orange, title="Yavaş WMA")