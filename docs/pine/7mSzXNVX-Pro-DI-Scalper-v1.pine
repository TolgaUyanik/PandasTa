//@version=6
indicator("Pro DI Scalper v1", overlay=true)

//=====================
// INPUTS
//=====================
diLen     = input.int(14, "DI Length", minval=1)
adxSmooth = input.int(14, "ADX Smoothing", minval=1)
adxFilter = input.float(20.0, "Minimum ADX", step=0.5)

//=====================
// DMI
//=====================
[diPlus, diMinus, adx] = ta.dmi(diLen, adxSmooth)
//=====================
// ATR
//=====================
atrLength = input.int(14, "ATR Length")
atrMultSL = input.float(1.5, "SL ATR Multiplier", step=0.1)

atr = ta.atr(atrLength)
//=====================
// TARGET MULTIPLIERS
//=====================
tp1Mult = input.float(1.0, "TP1 ATR", step=0.1)
tp2Mult = input.float(2.0, "TP2 ATR", step=0.1)
tp3Mult = input.float(3.0, "TP3 ATR", step=0.1)

//=====================
// SIGNALS
//=====================
buyCross  = ta.crossover(diPlus, diMinus)
sellCross = ta.crossunder(diPlus, diMinus)

buySignal  = buyCross and adx > adxFilter
sellSignal = sellCross and adx > adxFilter

//=====================
// SIGNAL LOCK
//=====================
var int trend = 0

if buySignal and trend != 1
    trend := 1

if sellSignal and trend != -1
    trend := -1

finalBuy  = buySignal and trend == 1 and trend[1] != 1
finalSell = sellSignal and trend == -1 and trend[1] != -1
//=====================
// ATR STOP LOSS
//=====================
var float buySL = na
var float sellSL = na

if finalBuy
    buySL := close - atr * atrMultSL
    sellSL := na

if finalSell
    sellSL := close + atr * atrMultSL
    buySL := na
//=====================
// TARGETS
//=====================
var float buyTP1 = na
var float buyTP2 = na
var float buyTP3 = na

var float sellTP1 = na
var float sellTP2 = na
var float sellTP3 = na

if finalBuy
    buyTP1 := close + atr * tp1Mult
    buyTP2 := close + atr * tp2Mult
    buyTP3 := close + atr * tp3Mult

    sellTP1 := na
    sellTP2 := na
    sellTP3 := na

if finalSell
    sellTP1 := close - atr * tp1Mult
    sellTP2 := close - atr * tp2Mult
    sellTP3 := close - atr * tp3Mult

    buyTP1 := na
    buyTP2 := na
    buyTP3 := na

//=====================
// PLOTS
//=====================
plotshape(finalBuy,
     title="BUY",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.lime,
     text="BUY",
     size=size.small)

plotshape(finalSell,
     title="SELL",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     size=size.small)
plot(buySL,
     title="BUY SL",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr)

plot(sellSL,
     title="SELL SL",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr)
plot(buyTP1, "Buy TP1", color=color.green, linewidth=1, style=plot.style_linebr)
plot(buyTP2, "Buy TP2", color=color.green, linewidth=1, style=plot.style_linebr)
plot(buyTP3, "Buy TP3", color=color.green, linewidth=2, style=plot.style_linebr)

plot(sellTP1, "Sell TP1", color=color.orange, linewidth=1, style=plot.style_linebr)
plot(sellTP2, "Sell TP2", color=color.orange, linewidth=1, style=plot.style_linebr)
plot(sellTP3, "Sell TP3", color=color.orange, linewidth=2, style=plot.style_linebr)

//=====================
// BAR COLOR
//=====================
barcolor(
 trend==1 ? color.new(color.lime,70) :
 trend==-1 ? color.new(color.red,70) : na)

//=====================
// ALERTS
//=====================
alertcondition(finalBuy,"BUY","DI BUY")
alertcondition(finalSell,"SELL","DI SELL")