// @function  restoreValues : Restores reduced prime number values in an array to their original state, for example `7001, 13, 19, 27, 39, 43, 57, 69, 79, 7103, 9, 21` is restored to `7001, 7013, 7019, 7027, 7039, 7043, 7057, 7069, 7079, 7103, 7109, 7021`
// @param    `iArray`       : array to process
// @param    `iShow`        : bool, pass `true` if you want to see a part of the array through `log.info()`
// @param    `iFrom`        : first index of array, shown through `log.info()`
// @param    `iTo`          : last index of array, shown through `log.info()`
// @returns   Initial array with restored prime number values
export method restoreValues(array<int>iArray, bool iShow=false, int iFrom=0, int iTo=200) => 
    aSize = iArray.size() 
    if barstate.isfirst and aSize > 0
        floored_1 = math.floor(iArray.first() / 100) *  100 
        for [index, value] in iArray       
            if index != 0 
                floored_2 = math.floor(value / 100) *  100 
                if floored_2 > floored_1 
                    floored_1 := floored_2
                    0
                else 
                    iArray.set(index, value + floored_1)
                    0
        if iShow
            log.info(str.tostring(iArray.slice(math.min(aSize -1, iFrom), math.min(aSize -1, iTo))))


var table tab = table.new(position.middle_center, 1, 1, bgcolor=color(na))
if barstate.islast 
    tab.cell(0, 0, 'Prime Numbers 1.096.031 -> 1.340.011', text_color=chart.fg_color, text_size = 50)