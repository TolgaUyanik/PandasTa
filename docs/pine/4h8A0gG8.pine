//@version=6
indicator('HOLY Vegas Channels', overlay=true, timeframe= '')
xianshi = input.string(title='===vegas隧道===', options = ["第一通道","第二通道","第三通道","前二通道","三通道","不绘制"],defval = "三通道" )
tf = input.float(title = '图表周期', defval = 0.0, step = 0.1)
x = input.float(title = '均线周期', defval = 0.0, step = 0.1)
multiplier = x == 0 ? 1 : x/tf
A1 = math.round(144* multiplier)
A2 = math.round(169* multiplier)
B1 = math.round(288* multiplier)
B2 = math.round(338* multiplier)
C1 = math.round(576* multiplier)
C2 = math.round(676* multiplier)
xianshi4 = input.bool(title='===EMA===', defval=true)
ema = input.int(20,"Ema长度")

pine_ema(src, length) =>  
    alpha = 2 / (length + 1)
    sum = 0.0
    sum := na(sum[1]) ? src : alpha * src + (1 - alpha) * nz(sum[1])
ema2 = pine_ema(close, A1)
ema3 = pine_ema(close, A2)
ema4 = pine_ema(close, B1)
ema5 = pine_ema(close, B2)
ema6 = pine_ema(close, C1)
ema7 = pine_ema(close, C2)
ma = ta.ema(close, ema)
channel1 = input(title='隧道1', defval=color.rgb(101, 143, 197, 94))
channel2 = input(title='隧道2', defval=color.rgb(175, 142, 82, 92))
channel3 = input(title='隧道3', defval=color.rgb(105, 45, 73, 95))
a1 = plot(xianshi=="第一通道" or xianshi=="前二通道" or xianshi=="三通道"?ema2:na, title='A组1', color=color.new(#19d1e9, 100), linewidth=2)
b1 = plot(xianshi=="第一通道" or xianshi=="前二通道" or xianshi=="三通道"?ema3:na, title='A组2', color=color.new(#38f1b3, 100), linewidth=2)
c1 = plot(xianshi=="第二通道" or xianshi=="前二通道" or xianshi=="三通道"?ema4:na, title='B组1', color=color.new(#ec4310, 100), linewidth=2)
d1 = plot(xianshi=="第二通道" or xianshi=="前二通道" or xianshi=="三通道"?ema5:na, title='B组2', color=color.new(#e93b0f, 100), linewidth=2)
f1 = plot(xianshi=="第三通道" or xianshi=="三通道"?ema6:na, title='C组1', color=color.new(#e41c5f, 100), linewidth=2)
g1 = plot(xianshi=="第三通道" or xianshi=="三通道"?ema7:na, title='C组2', color=color.new(#eb138a, 100), linewidth=2)
g2 = plot(xianshi4==true?ma:na, title='20EMA', color=color.new(#434651, 0), linewidth=2)
fill(a1, b1, color = xianshi=="第一通道" or xianshi=="前二通道" or xianshi=="三通道" ? color.new(channel1, 40) : na)

fill(c1, d1, color = xianshi=="第二通道" or xianshi=="前二通道" or xianshi=="三通道" ? color.new(channel2, 40) : na)

fill(f1, g1, color = xianshi=="第三通道" or xianshi=="三通道" ? color.new(channel3, 40) : na)