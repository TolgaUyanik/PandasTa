//@version=5
library("WYCKOFF_SHARED_LIB", overlay=false)

// ============================================================================
// WYCKOFF_SHARED_LIB v1.3.3 (WRIS-COMPLIANT: PURE + EXTENDED, COMPILE-SAFE)
//
// CHANGELOG v1.3.3
// - ALIGN: range touch primitives now match B2 Engine semantics (<= / >= instead of strict < / >)
// - ADD: B2 event constants + classifiers (FACT enums only: BO/FBO; no Spring/UT here)
// - ADD: extra invariants + tiny math helpers (pure)
// - KEEP: no ta.* calls, no rendering, stateless primitives only
//
// HARD RULES:
// - No ta.* calls
// - No drawing (plot/line/label/box/table)
// - Stateless primitives only (caller owns state)
// - Deterministic / Replay-safe by construction
//
// PARSER SAFETY RULES:
// - All Type.new(...) MUST be single-line (no multiline args)
// - Loop-based exports MUST use block bodies (if/else/for), not ternary+paren blocks
//
// SEMANTIC LOCKS:
// - effortPerResult field in WaveMetrics == EPR (Effort-per-Result proxy) = partRel / ampATR
// - inv_price_order passes when hi == lo (width=0 allowed; caller decides validity threshold)
//
// DF/RF POLICY NOTE:
// - This library exports primitives/constants only. No DF state, no latches.
// ============================================================================


// ─────────────────────────────────────────────────────────────────────────────
// CONSTANTS
export EPS() => 1e-10


// ─────────────────────────────────────────────────────────────────────────────
// NA / ZERO POLICY (OFFICIAL)
//
// Provide both families; caller must choose explicitly.
// - fail-loud: returns na on invalid/na inputs (preferred for Facts)
// - fail-soft: returns 0 on invalid/na inputs (use only when necessary)
// ─────────────────────────────────────────────────────────────────────────────

// NA helpers
export nz0(float x) => na(x) ? 0.0 : x
export nzi0(int x) => na(x) ? 0 : x
export is_ok_f(float x) => not na(x)
export is_ok_i(int x) => not na(x)

// Division / ratio (fail-loud)
export div_na(float num, float den) => (na(num) or na(den) or den == 0.0) ? na : (num / den)
export div_eps_na(float num, float den) => (na(num) or na(den)) ? na : (num / math.max(den, EPS()))
export ratio_na(float a, float b) => div_eps_na(a, b)

// Division / ratio (fail-soft)
export div0(float num, float den) => (na(num) or na(den) or den == 0.0) ? 0.0 : (num / den)
export div_eps0(float num, float den) => (na(num) or na(den)) ? 0.0 : (num / math.max(den, EPS()))
export ratio0(float a, float b) => div_eps0(a, b)

// Clamp
export clamp(float x, float lo, float hi) => (na(x) or na(lo) or na(hi)) ? na : math.min(math.max(x, lo), hi)
export clamp01(float x) => na(x) ? na : (x < 0.0 ? 0.0 : x > 1.0 ? 1.0 : x)

// Optional helpers (pure)
export atr_tol(float atr, float mult) => (na(atr) or na(mult)) ? na : (atr * mult)
export near_level(float px, float lvl, float tol) => (na(px) or na(lvl) or na(tol)) ? false : (math.abs(px - lvl) <= tol)

// Sign helpers (pure)
export sgn(float x) => na(x) ? 0 : (x > 0 ? 1 : x < 0 ? -1 : 0)
export bool_to_int(bool b) => b ? 1 : 0

// Tiny math helpers (pure)
export fmin(float a, float b) => (na(a) or na(b)) ? na : math.min(a, b)
export fmax(float a, float b) => (na(a) or na(b)) ? na : math.max(a, b)
export imin(int a, int b) => (na(a) or na(b)) ? na : math.min(a, b)
export imax(int a, int b) => (na(a) or na(b)) ? na : math.max(a, b)
export within(float x, float lo, float hi) => (na(x) or na(lo) or na(hi)) ? false : (x >= lo and x <= hi)


// ─────────────────────────────────────────────────────────────────────────────
// INVARIANTS / GUARDS (PURE FLAGS) — return 1 pass, 0 fail
export inv_pos_int(int x) => (na(x) or x <= 0) ? 0 : 1
export inv_nonneg_int(int x) => (na(x) or x < 0) ? 0 : 1
export inv_nonneg_float(float x) => (na(x) or x < 0.0) ? 0 : 1

// FIXED: hi==lo is allowed (width=0); fail only when hi < lo
export inv_price_order(float hi, float lo) => (na(hi) or na(lo) or hi < lo) ? 0 : 1

// Naming fix: "finite" in Pine context is effectively "not na"
export inv_not_na(float x) => na(x) ? 0 : 1
export inv_finite(float x) => inv_not_na(x)  // backward compat alias

// One-hot invariant helpers
export inv_onehot3(int b1, int b2, int b3) =>
    if na(b1) or na(b2) or na(b3)
        0
    else
        int s = (b1 != 0 ? 1 : 0) + (b2 != 0 ? 1 : 0) + (b3 != 0 ? 1 : 0)
        s == 1 ? 1 : 0


// ─────────────────────────────────────────────────────────────────────────────
// BIT / FIELD HELPERS (PURE)
//
// get_bit(x,b) => 0/1
// get_field(x,shift,mask) => extracted integer field
// set_bit(x,b,on) => updated integer
//
// NOTE (Pine v5):
// - No bitwise operators like &, |, ~
// - Implemented via arithmetic: bit = floor(x / 2^b) % 2
// - All helpers are deterministic, stateless, replay-safe
// ─────────────────────────────────────────────────────────────────────────────

// Return bit b (0/1)
export get_bit(int x, int b) =>
    if na(x) or na(b) or b < 0 or b > 30
        0
    else
        int(math.floor(x / math.pow(2, b)) % 2)

// Extract field: (x >> shift) & mask
export get_field(int x, int shift, int mask) =>
    if na(x) or na(shift) or na(mask) or shift < 0 or mask < 0
        0
    else
        int(math.floor(x / math.pow(2, shift)) % (mask + 1))

// Set or clear bit b in integer x, return updated integer
export set_bit(int x, int b, bool on) =>
    if na(x) or na(b) or b < 0 or b > 30
        x
    else
        int bitVal = int(math.pow(2, b))
        int hasBit = int(math.floor(x / bitVal) % 2)
        if on
            if hasBit == 1
                x
            else
                x + bitVal
        else
            if hasBit == 1
                x - bitVal
            else
                x


// ─────────────────────────────────────────────────────────────────────────────
// B2 EVENT ENUMS (FACT ENUMS ONLY — BO/FBO; NO Spring/UT here)
export B2_EVT_NONE() => 0
export B2_EVT_BO_UP() => 10
export B2_EVT_BO_DN() => 11
export B2_EVT_FBO_UP() => 20
export B2_EVT_FBO_DN() => 21

export b2_evt_is_bo(int e) => (e == B2_EVT_BO_UP() or e == B2_EVT_BO_DN())
export b2_evt_is_fbo(int e) => (e == B2_EVT_FBO_UP() or e == B2_EVT_FBO_DN())
export b2_evt_dir(int e) =>
    if na(e)
        0
    else
        if e == B2_EVT_BO_UP() or e == B2_EVT_FBO_UP()
            1
        else if e == B2_EVT_BO_DN() or e == B2_EVT_FBO_DN()
            -1
        else
            0


// ─────────────────────────────────────────────────────────────────────────────
// TYPES
export type WaveMetrics
    int dir
    int lenBars
    float startPx
    float endPx
    float amp
    float ampATR
    float speed
    float eff
    float partRel
    float effortPerResult  // SEMANTIC LOCK: EPR = partRel / ampATR (proxy)

export type WaveCompare
    float amp_ratio
    float speed_ratio
    float eff_ratio
    float partRel_ratio
    float epr_ratio

export type EVR
    int state  // +1 harmony, -1 divergence, 0 neutral/unknown

export type BreakEvent
    int event       // 1 if event else 0
    int kind        // +1 BOS, -1 CHOCH, 0 BRK/unknown
    int dir         // +1 up, -1 down, 0 none
    float level
    float px
    float partRel
    float ftATR      // follow-through or result-relative (caller contract; recommended = followThroughATR)
    int barIndex

export type StructState
    int bias         // +1 bull, -1 bear, 0 neutral
    int lastHighKind // +2 HH, -2 LH, 0 unknown
    int lastLowKind  // +1 HL, -1 LL, 0 unknown
    float swingHiPx
    int swingHiIdx
    float swingLoPx
    int swingLoIdx

export type RangeState
    int state    // 0 none, 1 candidate, 2 qualified
    int birthIdx
    float hi
    float lo
    int testsH
    int testsL


// ─────────────────────────────────────────────────────────────────────────────
// WAVE CORE (PURE)
export wave_dir(float startPx, float endPx) => (na(startPx) or na(endPx)) ? 0 : (endPx > startPx ? 1 : endPx < startPx ? -1 : 0)
export wave_amp(float startPx, float endPx) => (na(startPx) or na(endPx)) ? na : math.abs(endPx - startPx)
export wave_amp_atr(float amp, float atr) => div_eps_na(amp, atr)
export wave_speed(float ampATR, int lenBars) => (na(ampATR) or na(lenBars) or lenBars <= 0) ? na : (ampATR / lenBars)

// NOTE(contract): path must be caller-provided as cumulative absolute movement proxy (sum(abs(delta))).
export wave_eff(float amp, float path) => (na(amp) or na(path) or path <= 0.0) ? na : clamp01(amp / path)

// EPR = partRel / ampATR (proxy)
export wave_epr(float partRel, float ampATR) => (na(partRel) or na(ampATR) or ampATR <= 0.0) ? na : (partRel / ampATR)


// ─────────────────────────────────────────────────────────────────────────────
// BUILDERS (ALL .new(...) SINGLE-LINE)
export build_wave_metrics(int dir, int lenBars, float startPx, float endPx, float ampATR, float speed, float eff, float partRel, float epr) => WaveMetrics.new(dir, lenBars, startPx, endPx, (na(startPx) or na(endPx)) ? na : math.abs(endPx - startPx), ampATR, speed, eff, partRel, epr)
export build_break_event(int event, int kind, int dir, float level, float px, float partRel, float ftATR, int barIndex) => BreakEvent.new(event, kind, dir, level, px, partRel, ftATR, barIndex)
export build_struct_state(int bias, int lastHighKind, int lastLowKind, float hiPx, int hiIdx, float loPx, int loIdx) => StructState.new(bias, lastHighKind, lastLowKind, hiPx, hiIdx, loPx, loIdx)
export build_range_state(int state, int birthIdx, float hi, float lo, int testsH, int testsL) => RangeState.new(state, birthIdx, hi, lo, testsH, testsL)


// ─────────────────────────────────────────────────────────────────────────────
// COMPARISONS (PURE) — SINGLE-LINE CONSTRUCTOR
export compare_waves(WaveMetrics w0, WaveMetrics w1) => WaveCompare.new(ratio_na(w0.ampATR, w1.ampATR), ratio_na(w0.speed, w1.speed), ratio_na(w0.eff, w1.eff), ratio_na(w0.partRel, w1.partRel), ratio_na(w0.effortPerResult, w1.effortPerResult))


// ─────────────────────────────────────────────────────────────────────────────
// PROGRESSION FLAGS (PURE)
export strengthening_same_dir(WaveCompare c) => (na(c.amp_ratio) or na(c.speed_ratio)) ? false : (c.amp_ratio > 1.0 and c.speed_ratio > 1.0)
export weakening_same_dir(WaveCompare c) => (na(c.amp_ratio) or na(c.epr_ratio)) ? false : (c.amp_ratio < 1.0 and c.epr_ratio > 1.0)
export improving_pullback(WaveCompare c) => (na(c.amp_ratio) or na(c.speed_ratio) or na(c.eff_ratio)) ? false : (c.amp_ratio < 1.0 and c.speed_ratio < 1.0 and c.eff_ratio >= 1.0)
export worsening_pullback(WaveCompare c) => (na(c.amp_ratio) or na(c.speed_ratio) or na(c.eff_ratio)) ? false : (c.amp_ratio > 1.0 and c.speed_ratio > 1.0 and c.eff_ratio < 1.0)


// ─────────────────────────────────────────────────────────────────────────────
// EVR CLASSIFY (PURE)
export evr_by_levels(bool effHi, bool resHi) => EVR.new((na(effHi) or na(resHi)) ? 0 : (((effHi and resHi) or ((not effHi) and (not resHi))) ? 1 : -1))
export evr_by_waves(float volSum0, float ampATR0, float volSum1, float ampATR1) => EVR.new((na(volSum0) or na(ampATR0) or na(volSum1) or na(ampATR1)) ? 0 : (volSum0 > volSum1 and ampATR0 > ampATR1 ? 1 : (volSum0 > volSum1 and not (ampATR0 > ampATR1) ? -1 : 0)))
export evr_state_from_rel(float effortRel, float resultRel, float thrEff, float thrRes) => (na(effortRel) or na(resultRel) or na(thrEff) or na(thrRes)) ? 0 : (((effortRel >= thrEff and resultRel >= thrRes) or (effortRel < thrEff and resultRel < thrRes)) ? 1 : -1)


// ─────────────────────────────────────────────────────────────────────────────
// KEY-LEVEL / BREAK PRIMITIVES (PURE)
export key_hc(bool isBreak, float effortRel, float thrHigh) => (na(effortRel) or na(thrHigh)) ? 0 : (((isBreak and effortRel >= thrHigh) or ((not isBreak) and effortRel < thrHigh)) ? 1 : -1)
export break_is_bos(int kind) => kind == 1
export break_is_choch(int kind) => kind == -1
export break_is_brk(int kind) => kind == 0


// ─────────────────────────────────────────────────────────────────────────────
// RANGE PRIMITIVES (PURE)
//
// NOTE v1.3.3: touch semantics aligned to B2 Engine:
// - hit_upper: high >= hi - tolTouch AND close <= hi
// - hit_lower: low  <= lo + tolTouch AND close >= lo
// (previously used strict close < hi / close > lo)
// ─────────────────────────────────────────────────────────────────────────────
export hit_upper(float high, float close, float hi, float tol) => (na(high) or na(close) or na(hi) or na(tol)) ? false : (high >= (hi - tol) and close <= hi)
export hit_lower(float low, float close, float lo, float tol) => (na(low) or na(close) or na(lo) or na(tol)) ? false : (low <= (lo + tol) and close >= lo)

// Spring/Upthrust remain “behavioral” primitives; caller decides tol semantics (touch vs break tol)
export is_spring(float low, float close, float lo, float tol) => (na(low) or na(close) or na(lo) or na(tol)) ? false : (low < (lo - tol) and close > (lo + tol))
export is_upthrust(float high, float close, float hi, float tol) => (na(high) or na(close) or na(hi) or na(tol)) ? false : (high > (hi + tol) and close < (hi - tol))


// ─────────────────────────────────────────────────────────────────────────────
// GATE HELPERS / SCORING (PURE)
export gate_pass(bool cond) => cond ? 1 : 0
export score3(int a, int b, int c) => nzi0(a) + nzi0(b) + nzi0(c)
export score4(int a, int b, int c, int d) => nzi0(a) + nzi0(b) + nzi0(c) + nzi0(d)
export ratio_ge(float a, float b, float minRatio) => (na(a) or na(b) or na(minRatio)) ? false : (ratio_na(a, b) >= minRatio)
export ratio_le(float a, float b, float maxRatio) => (na(a) or na(b) or na(maxRatio)) ? false : (ratio_na(a, b) <= maxRatio)
export epr_worse_by_ratio(float eprNow, float eprRef, float minRatio) => (na(eprNow) or na(eprRef) or na(minRatio)) ? false : (ratio_na(eprNow, eprRef) >= minRatio)


// ─────────────────────────────────────────────────────────────────────────────
// STRUCTURE HELPERS (PURE)
export struct_bias_update(int prevBias, int lastHighKind, int lastLowKind) => ((lastHighKind == 2 and lastLowKind == 1) ? 1 : ((lastHighKind == -2 and lastLowKind == -1) ? -1 : prevBias))


// ─────────────────────────────────────────────────────────────────────────────
// EXTREMENESS PRIMITIVES (PURE, STATELESS)
//
// Caller provides history arrays.
// latestFirst=true  => index 0 is most recent
// latestFirst=false => index 0 is oldest
// NOTE(contract): caller MUST cap/prune arrays to avoid max-size limits.
// ─────────────────────────────────────────────────────────────────────────────
export arr_has_n(float[] a, int n) => (na(n) or n <= 0) ? false : (array.size(a) >= n)

// Is x the highest among last n values in array a (ignores na items)
export is_highest_in_last_n(float x, float[] a, int n, bool latestFirst) =>
    if na(x) or not arr_has_n(a, n)
        false
    else
        bool ok = true
        int sz = array.size(a)
        int lim = math.min(n, sz)
        for i = 0 to lim - 1
            int idx = latestFirst ? i : (sz - lim + i)
            float v = array.get(a, idx)
            if not na(v) and v > x
                ok := false
        ok

// Is x the lowest among last n values in array a (ignores na items)
export is_lowest_in_last_n(float x, float[] a, int n, bool latestFirst) =>
    if na(x) or not arr_has_n(a, n)
        false
    else
        bool ok = true
        int sz = array.size(a)
        int lim = math.min(n, sz)
        for i = 0 to lim - 1
            int idx = latestFirst ? i : (sz - lim + i)
            float v = array.get(a, idx)
            if not na(v) and v < x
                ok := false
        ok

// Rank: 1 = best. For highs: higher_is_better=true. For lows: higher_is_better=false.
export rank_in_last_n(float x, float[] a, int n, bool latestFirst, bool higher_is_better) =>
    if na(x) or not arr_has_n(a, n)
        na
    else
        int sz = array.size(a)
        int lim = math.min(n, sz)
        int worse = 0
        for i = 0 to lim - 1
            int idx = latestFirst ? i : (sz - lim + i)
            float v = array.get(a, idx)
            if not na(v)
                if higher_is_better
                    if v > x
                        worse += 1
                else
                    if v < x
                        worse += 1
        1 + worse

// Convenience wrappers
export rank_high(float x, float[] highs, int n, bool latestFirst) => rank_in_last_n(x, highs, n, latestFirst, true)
export rank_low(float x, float[] lows, int n, bool latestFirst) => rank_in_last_n(x, lows, n, latestFirst, false)
export is_highest_high(float x, float[] highs, int n, bool latestFirst) => is_highest_in_last_n(x, highs, n, latestFirst)
export is_lowest_low(float x, float[] lows, int n, bool latestFirst) => is_lowest_in_last_n(x, lows, n, latestFirst)


// ─────────────────────────────────────────────────────────────────────────────
// BACKWARD-COMPAT ALIASES (v1.2.x compatibility)
// Keep old names so existing scripts don’t break.
// These keep the old "return 0 on invalid" semantics.
export safe_div(float num, float den) => div0(num, den)
export safe_div_eps(float num, float den) => div_eps0(num, den)
export safe_ratio(float a, float b) => ratio0(a, b)
