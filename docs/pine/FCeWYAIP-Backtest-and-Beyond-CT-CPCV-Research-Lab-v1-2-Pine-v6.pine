     f_tablePosition(helpTablePositionInput),
     2,
     10,
     border_width = 1,
     bgcolor = color.new(color.black, tableTransparency)
)

// ============================================================================
// RESEARCH INTEGRITY TABLE
// ============================================================================
//
// PURPOSE
// -------
// Research Integrity measures the credibility of the research configuration.
//
// It does NOT measure whether the strategy is profitable.
//
// It asks:
//
//   "How much confidence should the user place in these CPCV results?"
//
// COMPONENTS
// ----------
//
// 1. Sample Size
//    Rewards a sufficiently large historical sample.
//
// 2. Training and Test Coverage
//    Requires enough observations for the CPCV splits.
//
// 3. Positive-Path Consistency
//    Rewards strategies that remain profitable across multiple reconstructed
//    out-of-sample paths.
//
// 4. Lower-Tail Robustness
//    Rewards a positive or tolerable pessimistic path result.
//
// 5. Drawdown Severity
//    Rewards research outcomes whose typical drawdown remains manageable.
//
// IMPORTANT
// ---------
// A high Research Integrity score does not prove future profitability.
//
// It means the validation process has fewer obvious weaknesses.
//
// A low score means attractive performance should be treated cautiously.
//
// ============================================================================

var table integrityTable = table.new(
     f_tablePosition(integrityTablePositionInput),
     2,
     8,
     border_width = 1,
     bgcolor = color.new(color.black, tableTransparency)
)

// ============================================================================
// GENERAL HELPERS
// ============================================================================

f_direction(float rawPosition) =>
    directionMode == "Long Only" ? math.max(rawPosition, 0.0) :
     directionMode == "Short Only" ? math.min(rawPosition, 0.0) :
     rawPosition


f_enabled(int modelIndex) =>
    switch modelIndex
        0 => enable1
        1 => enable2
        2 => enable3
        3 => enable4
        4 => enable5
        5 => enable6
        6 => enable7
        7 => enable8
        8 => enable9
        9 => enable10
        => false


f_modelName(int modelIndex) =>
    switch modelIndex
        0 => name1
        1 => name2
        2 => name3
        3 => name4
        4 => name5
        5 => name6
        6 => name7
        7 => name8
        8 => name9
        9 => name10
        => "Unknown"


f_metricShortName() =>
    selectionMetric == "Ulcer Performance" ? "ULCER" :
     selectionMetric == "Compound Return" ? "RETURN" :
     str.upper(selectionMetric)


f_metricHint() =>
    switch selectionMetric
        "Sharpe" =>
            "Return / total volatility.\nUseful standard, but upside volatility is also penalized."

        "Sortino" =>
            "Return / downside deviation.\nUseful for directional and trend strategies."

        "Calmar" =>
            "Annualized return / maximum drawdown.\nFocuses on growth versus capital pain."

        "Omega" =>
            "Positive returns / absolute negative returns.\nUseful for skewed distributions."

        "Ulcer Performance" =>
            "Annualized return / Ulcer Index.\nPenalizes deep and persistent drawdowns."

        "Compound Return" =>
            "Total compounded return.\nNo volatility or drawdown adjustment."

        =>
            "Unknown metric"


f_safeSharpe(float sumReturn, float sumSquared, int observations) =>
    float result = na

    if observations > 1
        float mean = sumReturn / observations
        float variance = math.max(
             (sumSquared - observations * mean * mean) / (observations - 1),
             0.0
        )
        float deviation = math.sqrt(variance)
        result := deviation > 0.0 ? mean / deviation * math.sqrt(annualization) : na

    result


f_groupForIndex(int sampleIndex, int totalBars, int groups) =>
    math.min(
         int(math.floor(sampleIndex * groups / math.max(totalBars, 1))),
         groups - 1
    )


f_groupStart(int groupIndex, int totalBars, int groups) =>
    int(math.floor(groupIndex * totalBars / groups))


f_groupEnd(int groupIndex, int totalBars, int groups) =>
    int(math.floor((groupIndex + 1) * totalBars / groups)) - 1


f_isTestGroup(int groupIndex, int testA, int testB) =>
    groupIndex == testA or groupIndex == testB


f_isValidTrainingIndex(
     int sampleIndex,
     int totalBars,
     int groups,
     int testA,
     int testB
) =>
    int groupIndex = f_groupForIndex(sampleIndex, totalBars, groups)

    int startA = f_groupStart(testA, totalBars, groups)
    int endA = f_groupEnd(testA, totalBars, groups)

    int startB = f_groupStart(testB, totalBars, groups)
    int endB = f_groupEnd(testB, totalBars, groups)

    bool invalidTest = f_isTestGroup(groupIndex, testA, testB)

    bool purgeA = sampleIndex >= math.max(startA - purgeBars, 0) and sampleIndex < startA
    bool embargoA = sampleIndex > endA and sampleIndex <= math.min(endA + embargoBars, totalBars - 1)

    bool purgeB = sampleIndex >= math.max(startB - purgeBars, 0) and sampleIndex < startB
    bool embargoB = sampleIndex > endB and sampleIndex <= math.min(endB + embargoBars, totalBars - 1)

    not (invalidTest or purgeA or embargoA or purgeB or embargoB)


f_getExposure(int sampleIndex, int modelIndex) =>
    int flatIndex = sampleIndex * MODEL_COUNT + modelIndex

    flatIndex >= 0 and flatIndex < array.size(modelExposure)
         ? array.get(modelExposure, flatIndex)
         : na


f_metricFromStats(
     float sharpe,
     float sortino,
     float calmar,
     float omega,
     float ulcerPerformance,
     float compoundedReturn
) =>
    switch selectionMetric
        "Sharpe" => nz(sharpe, -1000000.0)
        "Sortino" => nz(sortino, -1000000.0)
        "Calmar" => nz(calmar, -1000000.0)
        "Omega" => nz(omega, -1000000.0)
        "Ulcer Performance" => nz(ulcerPerformance, -1000000.0)
        "Compound Return" => compoundedReturn
        => nz(sharpe, -1000000.0)


// Returns:
// objective, Sharpe, compounded return, maximum drawdown, observations.
f_evaluateModel(
     int modelIndex,
     int testA,
     int testB,
     bool training,
     int totalBars
) =>
    float sumR = 0.0
    float sumR2 = 0.0
    float sumDownsideSquared = 0.0
    float grossPositive = 0.0
    float grossNegative = 0.0
    float cumulativeLog = 0.0

    float equity = 1.0
    float peak = 1.0
    float maxDrawdown = 0.0
    float ulcerSquaredSum = 0.0

    float previousExposure = 0.0
    bool previousIncluded = false

    int observations = 0

    for sampleIndex = 0 to totalBars - 1
        int groupIndex = f_groupForIndex(sampleIndex, totalBars, groupCount)

        bool include = training
             ? f_isValidTrainingIndex(sampleIndex, totalBars, groupCount, testA, testB)
             : f_isTestGroup(groupIndex, testA, testB)

        if include
            float assetR = array.get(assetReturns, sampleIndex)
            float exposure = f_getExposure(sampleIndex, modelIndex)

            if not na(assetR) and not na(exposure)
                if not previousIncluded
                    previousExposure := 0.0

                float turnover = math.abs(exposure - previousExposure)
                float netR = exposure * assetR - turnover * COST_RATE

                sumR += netR
                sumR2 += netR * netR
                cumulativeLog += netR
                observations += 1

                if netR < 0.0
                    sumDownsideSquared += netR * netR
                    grossNegative += math.abs(netR)
                else
                    grossPositive += netR

                equity *= math.exp(netR)
                peak := math.max(peak, equity)

                float drawdown = peak > 0.0 ? equity / peak - 1.0 : 0.0
                maxDrawdown := math.min(maxDrawdown, drawdown)
                ulcerSquaredSum += drawdown * drawdown

                previousExposure := exposure
                previousIncluded := true
        else
            previousExposure := 0.0
            previousIncluded := false

    float meanReturn = observations > 0 ? sumR / observations : na
    float sharpe = f_safeSharpe(sumR, sumR2, observations)

    float downsideDeviation = observations > 0
         ? math.sqrt(sumDownsideSquared / observations)
         : na

    float sortino = not na(downsideDeviation) and downsideDeviation > 0.0
         ? meanReturn / downsideDeviation * math.sqrt(annualization)
         : na

    float compoundedReturn = math.exp(cumulativeLog) - 1.0

    float annualizedReturn = observations > 0 and equity > 0.0
         ? math.pow(equity, float(annualization) / observations) - 1.0
         : na

    float calmar = not na(annualizedReturn) and math.abs(maxDrawdown) > 0.000001
         ? annualizedReturn / math.abs(maxDrawdown)
         : na

    float omega = grossNegative > 0.0 ? grossPositive / grossNegative : na

    float ulcerIndex = observations > 0
         ? math.sqrt(ulcerSquaredSum / observations)
         : na

    float ulcerPerformance = not na(annualizedReturn) and not na(ulcerIndex) and ulcerIndex > 0.000001
         ? annualizedReturn / ulcerIndex
         : na

    float objective = f_metricFromStats(
         sharpe,
         sortino,
         calmar,
         omega,
         ulcerPerformance,
         compoundedReturn
    )

    [objective, sharpe, compoundedReturn, maxDrawdown, observations]


f_findSplit(int groupA, int groupB) =>
    int lowGroup = math.min(groupA, groupB)
    int highGroup = math.max(groupA, groupB)
    int result = -1

    if array.size(splitGroupA) > 0
        for splitIndex = 0 to array.size(splitGroupA) - 1
            if array.get(splitGroupA, splitIndex) == lowGroup and array.get(splitGroupB, splitIndex) == highGroup
                result := splitIndex

    result


f_median(array<float> source) =>
    float result = na
    int count = array.size(source)

    if count > 0
        array<float> work = array.copy(source)
        array.sort(work, order.ascending)

        int middle = int(math.floor(count / 2))

        result := count % 2 == 1
             ? array.get(work, middle)
             : (array.get(work, middle - 1) + array.get(work, middle)) / 2.0

    result


f_percentile(array<float> source, float percentile) =>
    float result = na
    int count = array.size(source)

    if count > 0
        array<float> work = array.copy(source)
        array.sort(work, order.ascending)

        float bounded = math.max(math.min(percentile, 1.0), 0.0)
        int index = int(math.floor(bounded * (count - 1)))

        result := array.get(work, index)

    result


f_percent(float value) =>
    na(value) ? "—" : str.tostring(value * 100.0, "#.##") + "%"


f_number(float value) =>
    na(value) ? "—" : str.tostring(value, "#.###")


f_metricColor(float value) =>
    na(value) ? color.silver :
     value > 0.0 ? color.lime :
     value < 0.0 ? color.red :
     color.silver


f_setCell(
     table target,
     int column,
     int row,
     string cellText,
     color textColor,
     color backgroundColor
) =>
    table.cell(
         target,
         column,
         row,
         cellText,
         text_color = textColor,
         bgcolor = backgroundColor,
         text_size = activeTableTextSize
    )

// ============================================================================
// CANDIDATE 1 — EMA 5/20 CROSSOVER
// ============================================================================
//
// FAMILY
// ------
// Trend following.
//
// CONSTRUCTION
// ------------
// Compares a fast exponential moving average with a slower EMA.
//
// LONG
// ----
// Fast EMA is above the slow EMA.
//
// SHORT
// -----
// Fast EMA is below the slow EMA.
//
// IMPLEMENTATION
// --------------
// The strategy remains continuously long or short except during initialization.
// It tends to react quickly and may whipsaw in sideways markets.
//
// USER REPLACEMENT
// ----------------
// Users may replace the desired-position logic but must preserve the output:
// +1 long, 0 flat, -1 short.

float emaFast1 = ta.ema(close, fast1)
float emaSlow1 = ta.ema(close, slow1)
float desired1 = f_direction(emaFast1 > emaSlow1 ? 1.0 : emaFast1 < emaSlow1 ? -1.0 : 0.0)


// ============================================================================
// CANDIDATE 2 — EMA 10/30 CROSSOVER
// ============================================================================
//
// A moderately fast EMA trend model. It uses the same state rules as Candidate
// 1 but reacts more slowly, attempting to reduce some short-term noise.

float emaFast2 = ta.ema(close, fast2)
float emaSlow2 = ta.ema(close, slow2)
float desired2 = f_direction(emaFast2 > emaSlow2 ? 1.0 : emaFast2 < emaSlow2 ? -1.0 : 0.0)


// ============================================================================
// CANDIDATE 3 — EMA 20/50 CROSSOVER
// ============================================================================
//
// An intermediate trend model intended to represent medium-horizon directional
// behavior. Long above, short below, with no discretionary interpretation.

float emaFast3 = ta.ema(close, fast3)
float emaSlow3 = ta.ema(close, slow3)
float desired3 = f_direction(emaFast3 > emaSlow3 ? 1.0 : emaFast3 < emaSlow3 ? -1.0 : 0.0)


// ============================================================================
// CANDIDATE 4 — EMA 50/100 CROSSOVER
// ============================================================================
//
// A slower trend model. It generally trades less often than the shorter EMA
// candidates and may respond poorly to sudden reversals.

float emaFast4 = ta.ema(close, fast4)
float emaSlow4 = ta.ema(close, slow4)
float desired4 = f_direction(emaFast4 > emaSlow4 ? 1.0 : emaFast4 < emaSlow4 ? -1.0 : 0.0)


// ============================================================================
// CANDIDATE 5 — EMA 50/200 CROSSOVER
// ============================================================================
//
// A classic long-horizon trend benchmark, commonly associated with the
// so-called golden-cross and death-cross relationship.
//
// It is intentionally included as a slow, recognizable baseline rather than a
// claim that 50/200 is universally optimal.

float emaFast5 = ta.ema(close, fast5)
float emaSlow5 = ta.ema(close, slow5)
float desired5 = f_direction(emaFast5 > emaSlow5 ? 1.0 : emaFast5 < emaSlow5 ? -1.0 : 0.0)

// NOTE ON STATEFUL CANDIDATES:
// RSI, Donchian, and Bollinger candidates carry persistent position state that
// evolves across the full chart history. When a test segment begins, the
// position carried into it was formed on earlier (possibly purged) bars.
// Turnover cost is reset at each segment boundary, but the strategy's internal
// state is not. This is a minor state carry-over, not a return look-ahead, and
// it applies only to path-persistent candidates.
//
// ============================================================================
// CANDIDATE 6 — RSI MEAN REVERSION
// ============================================================================
//
// FAMILY
// ------
// Oscillator-based mean reversion.
//
// CONSTRUCTION
// ------------
// Uses RSI with classic 30/70 extreme levels and a 50 center-line exit.
//
// LONG ENTRY
// ----------
// RSI crosses below the oversold level.
//
// LONG EXIT
// ---------
// RSI later crosses above the center-line exit level.
//
// SHORT ENTRY
// -----------
// RSI crosses above the overbought level.
//
// SHORT EXIT
// ----------
// RSI later crosses below the center-line exit level.
//
// STATE LOGIC
// -----------
// This is not a one-bar signal. The position persists until the corresponding
// exit condition occurs.
//
// EXPECTED BEHAVIOR
// -----------------
// Often more suitable for ranging markets. Strong trends can continue through
// an extreme reading and inflict the traditional lesson that “oversold” does
// not mean “legally required to rise.”

float rsiValue = ta.rsi(close, rsiLength)
var float desired6Raw = 0.0

if desired6Raw == 0.0
    if ta.crossunder(rsiValue, rsiOversold)
        desired6Raw := 1.0
    else if ta.crossover(rsiValue, rsiOverbought)
        desired6Raw := -1.0
else if desired6Raw > 0.0 and ta.crossover(rsiValue, rsiExit)
    desired6Raw := 0.0
else if desired6Raw < 0.0 and ta.crossunder(rsiValue, rsiExit)
    desired6Raw := 0.0

float desired6 = f_direction(desired6Raw)


// ============================================================================
// CANDIDATE 7 — MACD TREND
// ============================================================================
//
// FAMILY
// ------
// Momentum and trend following.
//
// CONSTRUCTION
// ------------
// Uses the classic MACD relationship:
// fast EMA minus slow EMA, compared with an EMA signal line.
//
// LONG
// ----
// MACD line is above its signal line.
//
// SHORT
// -----
// MACD line is below its signal line.
//
// STATE LOGIC
// -----------
// Continuously holds the direction implied by the MACD/signal relationship.
// It can capture sustained momentum but commonly whipsaws in flat conditions.

[macdLine, macdSignalLine, macdHistogram] = ta.macd(
     close,
     macdFast,
     macdSlow,
     macdSignal
)

float desired7 = f_direction(
     macdLine > macdSignalLine ? 1.0 :
     macdLine < macdSignalLine ? -1.0 :
     0.0
)


// ============================================================================
// CANDIDATE 8 — DONCHIAN BREAKOUT
// ============================================================================
//
// FAMILY
// ------
// Price-channel breakout and trend following.
//
// CONSTRUCTION
// ------------
// Uses a longer entry channel and a shorter exit channel.
//
// LONG ENTRY
// ----------
// Close breaks above the prior entry-channel high.
//
// LONG EXIT
// ---------
// Close breaks below the prior exit-channel low.
//
// SHORT ENTRY
// -----------
// Close breaks below the prior entry-channel low.
//
// SHORT EXIT
// ----------
// Close breaks above the prior exit-channel high.
//
// IMPORTANT IMPLEMENTATION DETAIL
// -------------------------------
// Channels use [1], so the current bar is not allowed to define and break its
// own threshold simultaneously. That would be a tiny hindsight machine wearing
// a respectable breakout hat.

float donUpperEntry = ta.highest(high, donEntryLength)[1]
float donLowerEntry = ta.lowest(low, donEntryLength)[1]
float donUpperExit = ta.highest(high, donExitLength)[1]
float donLowerExit = ta.lowest(low, donExitLength)[1]

var float desired8Raw = 0.0

if desired8Raw == 0.0
    if close > donUpperEntry
        desired8Raw := 1.0
    else if close < donLowerEntry
        desired8Raw := -1.0
else if desired8Raw > 0.0 and close < donLowerExit
    desired8Raw := 0.0
else if desired8Raw < 0.0 and close > donUpperExit
    desired8Raw := 0.0

float desired8 = f_direction(desired8Raw)


// ============================================================================
// CANDIDATE 9 — SUPERTREND
// ============================================================================
//
// FAMILY
// ------
// ATR-adjusted trend following.
//
// CONSTRUCTION
// ------------
// Uses TradingView's built-in Supertrend calculation with an ATR period and
// volatility multiplier.
//
// LONG
// ----
// Supertrend direction is bullish.
//
// SHORT
// -----
// Supertrend direction is bearish.
//
// EXPECTED BEHAVIOR
// -----------------
// Adapts its reversal threshold to volatility. It can remain in large trends
// but is vulnerable to repeated flips during choppy conditions.

[supertrendValue, supertrendDirection] = ta.supertrend(
     stFactor,
     stAtrLength
)

float desired9 = f_direction(
     supertrendDirection < 0 ? 1.0 :
     supertrendDirection > 0 ? -1.0 :
     0.0
)


// ============================================================================
// CANDIDATE 10 — BOLLINGER-BAND MEAN REVERSION
// ============================================================================
//
// FAMILY
// ------
// Volatility-envelope mean reversion.
//
// CONSTRUCTION
// ------------
// Builds upper and lower bands around a simple moving-average basis.
//
// LONG ENTRY
// ----------
// Close crosses below the lower band.
//
// LONG EXIT
// ---------
// Close crosses back above the basis.
//
// SHORT ENTRY
// -----------
// Close crosses above the upper band.
//
// SHORT EXIT
// ----------
// Close crosses back below the basis.
//
// EXPECTED BEHAVIOR
// -----------------
// Often performs better in oscillating markets. Strong breakouts can remain
// outside the bands for long periods, because price has never signed a contract
// promising to return politely to its average.

float bbBasis = ta.sma(close, bbLength)
float bbDeviation = ta.stdev(close, bbLength) * bbMult
float bbUpper = bbBasis + bbDeviation
float bbLower = bbBasis - bbDeviation

var float desired10Raw = 0.0

if desired10Raw == 0.0
    if ta.crossunder(close, bbLower)
        desired10Raw := 1.0
    else if ta.crossover(close, bbUpper)
        desired10Raw := -1.0
else if desired10Raw > 0.0 and ta.crossover(close, bbBasis)
    desired10Raw := 0.0
else if desired10Raw < 0.0 and ta.crossunder(close, bbBasis)
    desired10Raw := 0.0

float desired10 = f_direction(desired10Raw)


// ============================================================================
// RETURN AND EXPOSURE GENERATION
// ============================================================================

float assetLogReturn =
     close > 0.0 and close[1] > 0.0
     ? math.log(close / close[1])
     : na

float realizedBarVol = ta.stdev(assetLogReturn, volLength)
float annualizedBarVol = realizedBarVol * math.sqrt(annualization)

float leverage =
     useVolTarget and not na(annualizedBarVol) and annualizedBarVol > 0.0
     ? math.min(
         (targetAnnualVol / 100.0) / annualizedBarVol,
         maxLeverage
       )
     : 1.0

// Position used for bar t is based on information available by bar t-1.
float exposure1 = desired1[1] * leverage[1]
float exposure2 = desired2[1] * leverage[1]
float exposure3 = desired3[1] * leverage[1]
float exposure4 = desired4[1] * leverage[1]
float exposure5 = desired5[1] * leverage[1]
float exposure6 = desired6[1] * leverage[1]
float exposure7 = desired7[1] * leverage[1]
float exposure8 = desired8[1] * leverage[1]
float exposure9 = desired9[1] * leverage[1]
float exposure10 = desired10[1] * leverage[1]

bool inResearchWindow =
     time >= startTime and
     time <= endTime and
     bar_index > 2 and
     not na(assetLogReturn)


// Store completed bars only.
if inResearchWindow and barstate.isconfirmed
    // Make room before pushing so the collection never briefly exceeds its cap.
    if array.size(assetReturns) >= maxBars
        array.shift(assetReturns)

        for modelIndex = 0 to MODEL_COUNT - 1
            array.shift(modelExposure)

    array.push(assetReturns, assetLogReturn)

    array.push(modelExposure, exposure1)
    array.push(modelExposure, exposure2)
    array.push(modelExposure, exposure3)
    array.push(modelExposure, exposure4)
    array.push(modelExposure, exposure5)
    array.push(modelExposure, exposure6)
    array.push(modelExposure, exposure7)
    array.push(modelExposure, exposure8)
    array.push(modelExposure, exposure9)
    array.push(modelExposure, exposure10)


// ============================================================================
// CPCV CALCULATION
// ============================================================================

if barstate.islast
    array.clear(splitGroupA)
    array.clear(splitGroupB)
    array.clear(splitModel)

    array.clear(splitTrainMetric)
    array.clear(splitTrainSharpe)
    array.clear(splitTestMetric)
    array.clear(splitTestReturn)
    array.clear(splitTestDD)

    array.clear(pathSplitMap)

    array.clear(pathMetric)
    array.clear(pathSharpe)
    array.clear(pathReturn)
    array.clear(pathDD)
    array.clear(pathBars)

    int totalBars = array.size(assetReturns)
    int expectedSplits = int(groupCount * (groupCount - 1) / 2)
    int pathCount = groupCount - 1

    bool enoughData =
         totalBars >= groupCount * math.max(minTestBars, 2) and
         totalBars >= minTrainBars + 2 * minTestBars

    if enoughData
        int splitIndex = 0
 
        // --------------------------------------------------------------------
        // Generate every pairwise test split: C(N,2).
        // --------------------------------------------------------------------
        for testA = 0 to groupCount - 2
            for testB = testA + 1 to groupCount - 1
                array.push(splitGroupA, testA)
                array.push(splitGroupB, testB)

                float bestObjective = -1000000000.0
                float bestTrainSharpe = na
                int bestModel = -1

                // Candidate selection uses purged and embargoed training data.
                for modelIndex = 0 to MODEL_COUNT - 1
                    if f_enabled(modelIndex)
                        [evalObjective, evalTrainSharpe, _, _, evalTrainObservations] = f_evaluateModel(
                             modelIndex,
                             testA,
                             testB,
                             true,
                             totalBars
                        )

                        bool passesSharpeFilter = not useTrainSharpeFilter or nz(evalTrainSharpe, -1000000.0) >= minTrainSharpe
                        bool eligible = evalTrainObservations >= minTrainBars and passesSharpeFilter

                        if eligible and evalObjective > bestObjective
                            bestObjective := evalObjective
                            bestTrainSharpe := evalTrainSharpe
                            bestModel := modelIndex

                float testMetricValue = na
                float testReturnValue = na
                float testDDValue = na
                int testObservations = 0

                if bestModel >= 0
                    [testObjective, _, evaluatedReturn, evaluatedDD, evaluatedObservations] = f_evaluateModel(
                         bestModel,
                         testA,
                         testB,
                         false,
                         totalBars
                    )

                    testMetricValue := testObjective
                    testReturnValue := evaluatedReturn
                    testDDValue := evaluatedDD
                    testObservations := evaluatedObservations

                array.push(splitModel, bestModel)
                array.push(splitTrainMetric, bestObjective)
                array.push(splitTrainSharpe, bestTrainSharpe)

                array.push(
                     splitTestMetric,
                     testObservations >= minTestBars ? testMetricValue : na
                )

                array.push(
                     splitTestReturn,
                     testObservations >= minTestBars ? testReturnValue : na
                )

                array.push(
                     splitTestDD,
                     testObservations >= minTestBars ? testDDValue : na
                )

                splitIndex += 1

        // --------------------------------------------------------------------
        // Build a valid round-robin CPCV path allocation.
        //
        // Each path is one round of a round-robin tournament:
        // • Every group appears exactly once in every path.
        // • Every pairwise split appears exactly once across all paths.
        // • N must be even, hence the available choices 4, 6, and 8.
        // --------------------------------------------------------------------
        for mapIndex = 0 to groupCount * pathCount - 1
            array.push(pathSplitMap, -1)

        array<int> teams = array.new<int>()

        for groupIndex = 0 to groupCount - 1
            array.push(teams, groupIndex)

        for pathIndex = 0 to pathCount - 1
            for pairIndex = 0 to int(groupCount / 2) - 1
                int groupA = array.get(teams, pairIndex)
                int groupB = array.get(teams, groupCount - 1 - pairIndex)
                int sourceSplit = f_findSplit(groupA, groupB)

                array.set(
                     pathSplitMap,
                     groupA * pathCount + pathIndex,
                     sourceSplit
                )

                array.set(
                     pathSplitMap,
                     groupB * pathCount + pathIndex,
                     sourceSplit
                )

            // Rotate every team except the first fixed team.
            int rotatingTeam = array.pop(teams)
            array.insert(teams, 1, rotatingTeam)

        // --------------------------------------------------------------------
        // Reconstruct complete out-of-sample paths.
        // --------------------------------------------------------------------
        for pathIndex = 0 to pathCount - 1
            float sumR = 0.0
            float sumR2 = 0.0
            float sumDownsideSquared = 0.0
            float grossPositive = 0.0
            float grossNegative = 0.0
            float cumulativeLog = 0.0

            float equity = 1.0
            float peak = 1.0
            float maxDrawdown = 0.0
            float ulcerSquaredSum = 0.0

            float previousExposure = 0.0
            int previousSourceSplit = -1
            int observations = 0

            for sampleIndex = 0 to totalBars - 1
                int groupIndex = f_groupForIndex(
                     sampleIndex,
                     totalBars,
                     groupCount
                )

                int sourceSplit = array.get(
                     pathSplitMap,
                     groupIndex * pathCount + pathIndex
                )

                if sourceSplit >= 0
                    int chosenModel = array.get(splitModel, sourceSplit)

                    if chosenModel >= 0
                        float assetR = array.get(assetReturns, sampleIndex)
                        float exposure = f_getExposure(sampleIndex, chosenModel)

                        if sourceSplit != previousSourceSplit
                            previousExposure := 0.0

                        if not na(assetR) and not na(exposure)
                            float turnover = math.abs(exposure - previousExposure)
                            float netR = exposure * assetR - turnover * COST_RATE

                            sumR += netR
                            sumR2 += netR * netR
                            cumulativeLog += netR
                            observations += 1

                            if netR < 0.0
                                sumDownsideSquared += netR * netR
                                grossNegative += math.abs(netR)
                            else
                                grossPositive += netR

                            equity *= math.exp(netR)
                            peak := math.max(peak, equity)

                            float drawdown = peak > 0.0
                                 ? equity / peak - 1.0
                                 : 0.0

                            maxDrawdown := math.min(maxDrawdown, drawdown)
                            ulcerSquaredSum += drawdown * drawdown

                            previousExposure := exposure
                            previousSourceSplit := sourceSplit

            float meanReturn = observations > 0 ? sumR / observations : na
            float reconstructedSharpe = f_safeSharpe(sumR, sumR2, observations)

            float downsideDeviation = observations > 0
                 ? math.sqrt(sumDownsideSquared / observations)
                 : na

            float reconstructedSortino = not na(downsideDeviation) and downsideDeviation > 0.0
                 ? meanReturn / downsideDeviation * math.sqrt(annualization)
                 : na

            float reconstructedReturn = math.exp(cumulativeLog) - 1.0

            float annualizedReturn = observations > 0 and equity > 0.0
                 ? math.pow(equity, float(annualization) / observations) - 1.0
                 : na

            float reconstructedCalmar = not na(annualizedReturn) and math.abs(maxDrawdown) > 0.000001
                 ? annualizedReturn / math.abs(maxDrawdown)
                 : na

            float reconstructedOmega = grossNegative > 0.0
                 ? grossPositive / grossNegative
                 : na

            float ulcerIndex = observations > 0
                 ? math.sqrt(ulcerSquaredSum / observations)
                 : na

            float reconstructedUlcer = not na(annualizedReturn) and not na(ulcerIndex) and ulcerIndex > 0.000001
                 ? annualizedReturn / ulcerIndex
                 : na

            float reconstructedMetric = f_metricFromStats(
                 reconstructedSharpe,
                 reconstructedSortino,
                 reconstructedCalmar,
                 reconstructedOmega,
                 reconstructedUlcer,
                 reconstructedReturn
            )

            array.push(pathMetric, reconstructedMetric)
            array.push(pathSharpe, reconstructedSharpe)
            array.push(pathReturn, reconstructedReturn)
            array.push(pathDD, maxDrawdown)
            array.push(pathBars, observations)

    // ========================================================================
    // TABLE OUTPUTS
    // ========================================================================
    //
    // SPLIT DIAGNOSTICS
    // -----------------
    // Each row is one training/test experiment.
    //
    // SPLIT:
    // Sequential split number.
    //
    // TEST:
    // Two chronological groups held out as test data.
    //
    // MODEL:
    // Candidate selected using training data only.
    //
    // TRAIN METRIC:
    // Selected optimization metric on training observations.
    //
    // TEST METRIC:
    // Same metric on untouched test observations.
    //
    // TEST RETURN:
    // Compounded return across the held-out segments.
    //
    // MAX DD:
    // Largest peak-to-trough loss during the evaluated test sequence.
    //
    // Warning sign:
    // Excellent training metric combined with poor test performance.
    //
    // PATH DIAGNOSTICS
    // ----------------
    // Each row is one reconstructed full out-of-sample history.
    //
    // Focus on:
    // 1. Median path.
    // 2. Lower-tail path.
    // 3. Positive-path rate.
    // 4. Maximum drawdown.
    //
    // Do not choose a strategy because one path achieved enlightenment.

    table.clear(splitTable, 0, 0, 6, 30)
    table.clear(pathTable, 0, 0, 6, 11)
    table.clear(helpTable, 0, 0, 1, 9)
    table.clear(integrityTable, 0, 0, 1, 7)

    const color TABLE_HEADER = color.rgb(35, 75, 130)

    color headerBackground = color.new(
        TABLE_HEADER,
        tableTransparency
    )

    color regularBackground = color.new(
         color.black,
         tableTransparency
    )

    color warningBackground = color.new(
         color.orange,
         70
    )

    // ------------------------------------------------------------------------
    // Plain-English results guide.
    // ------------------------------------------------------------------------
    activeTableTextSize := f_tableTextSize(helpTableTextSizeInput)

    if showHelpTable
        f_setCell(helpTable, 0, 0, "HOW TO READ THE RESULTS", color.white, headerBackground)
        f_setCell(helpTable, 1, 0, selectionMetric, color.aqua, headerBackground)

        f_setCell(helpTable, 0, 1, "1", color.aqua, regularBackground)
        f_setCell(helpTable, 1, 1, "Do not judge by the best split.", color.white, regularBackground)

        f_setCell(helpTable, 0, 2, "2", color.aqua, regularBackground)
        f_setCell(helpTable, 1, 2, "Focus on median paths.", color.white, regularBackground)

        f_setCell(helpTable, 0, 3, "3", color.aqua, regularBackground)
        f_setCell(helpTable, 1, 3, "Inspect the worst path.", color.white, regularBackground)

        f_setCell(helpTable, 0, 4, "4", color.aqua, regularBackground)
        f_setCell(helpTable, 1, 4, "Check the positive-path rate.", color.white, regularBackground)

        f_setCell(helpTable, 0, 5, "5", color.aqua, regularBackground)
        f_setCell(helpTable, 1, 5, "Compare return with drawdown.", color.white, regularBackground)

        f_setCell(helpTable, 0, 6, "GREEN", color.lime, regularBackground)
        f_setCell(helpTable, 1, 6, "Median and tail are positive.", color.white, regularBackground)

        f_setCell(helpTable, 0, 7, "YELLOW", color.yellow, regularBackground)
        f_setCell(helpTable, 1, 7, "Median positive; tail fragile.", color.white, regularBackground)

        f_setCell(helpTable, 0, 8, "RED", color.red, regularBackground)
        f_setCell(helpTable, 1, 8, "Median or most paths failed.", color.white, regularBackground)

        f_setCell(helpTable, 0, 9, "METRIC", color.aqua, regularBackground)
        f_setCell(helpTable, 1, 9, f_metricHint(), color.silver, regularBackground)

    // ------------------------------------------------------------------------
    // Split Diagnostics table.
    // ------------------------------------------------------------------------
    activeTableTextSize := f_tableTextSize(splitTableTextSizeInput)

    if showSplitTable
        f_setCell(splitTable, 0, 0, "SPLIT", color.white, headerBackground)
        f_setCell(splitTable, 1, 0, "TEST", color.white, headerBackground)
        f_setCell(splitTable, 2, 0, "MODEL", color.white, headerBackground)
        f_setCell(splitTable, 3, 0, "TRAIN " + f_metricShortName(), color.white, headerBackground)
        f_setCell(splitTable, 4, 0, "TEST " + f_metricShortName(), color.white, headerBackground)
        f_setCell(splitTable, 5, 0, "TEST RETURN", color.white, headerBackground)
        f_setCell(splitTable, 6, 0, "MAX DD", color.white, headerBackground)

        int splitRows = math.min(array.size(splitModel), 28)

        if splitRows > 0
            for rowIndex = 0 to splitRows - 1
                int testA = array.get(splitGroupA, rowIndex)
                int testB = array.get(splitGroupB, rowIndex)
                int selected = array.get(splitModel, rowIndex)

                float trainMetricValue = array.get(splitTrainMetric, rowIndex)
                float testMetricValue = array.get(splitTestMetric, rowIndex)
                float testRet = array.get(splitTestReturn, rowIndex)
                float testDrawdown = array.get(splitTestDD, rowIndex)

                int tableRow = rowIndex + 1

                f_setCell(splitTable, 0, tableRow, str.tostring(rowIndex + 1), color.silver, regularBackground)

                f_setCell(
                     splitTable,
                     1,
                     tableRow,
                     "G" + str.tostring(testA + 1) + "+G" + str.tostring(testB + 1),
                     color.white,
                     regularBackground
                )

                f_setCell(
                     splitTable,
                     2,
                     tableRow,
                     selected >= 0 ? f_modelName(selected) : "NO MODEL",
                     selected >= 0 ? color.aqua : color.red,
                     regularBackground
                )

                f_setCell(splitTable, 3, tableRow, f_number(trainMetricValue), f_metricColor(trainMetricValue), regularBackground)
                f_setCell(splitTable, 4, tableRow, f_number(testMetricValue), f_metricColor(testMetricValue), regularBackground)
                f_setCell(splitTable, 5, tableRow, f_percent(testRet), f_metricColor(testRet), regularBackground)
                f_setCell(splitTable, 6, tableRow, f_percent(testDrawdown), color.orange, regularBackground)

        if not enoughData
            f_setCell(splitTable, 0, 1, "INSUFFICIENT DATA", color.white, warningBackground)
            f_setCell(splitTable, 1, 1, str.tostring(totalBars) + " stored bars", color.white, warningBackground)

    // ------------------------------------------------------------------------
    // Path Diagnostics and Research Integrity calculations.
    //
    // Research Integrity depends on reconstructed path statistics. Therefore,
    // this block must run when either the Path Diagnostics table or the
    // Research Integrity table is visible.
    // ------------------------------------------------------------------------
    activeTableTextSize := f_tableTextSize(pathTableTextSizeInput)

    if showPathTable or showIntegrityTable
        f_setCell(pathTable, 0, 0, "PATH", color.white, headerBackground)
        f_setCell(pathTable, 1, 0, f_metricShortName(), color.white, headerBackground)
        f_setCell(pathTable, 2, 0, selectionMetric == "Sharpe" ? "" : "SHARPE", color.white, headerBackground)
        f_setCell(pathTable, 3, 0, "RETURN", color.white, headerBackground)
        f_setCell(pathTable, 4, 0, "MAX DD", color.white, headerBackground)
        f_setCell(pathTable, 5, 0, "BARS", color.white, headerBackground)
        f_setCell(pathTable, 6, 0, "RESULT", color.white, headerBackground)

        int availablePaths = array.size(pathMetric)

        if availablePaths > 0
            int positivePaths = 0

            for pathIndex = 0 to availablePaths - 1
                float metricValue = array.get(pathMetric, pathIndex)
                float sharpeValue = array.get(pathSharpe, pathIndex)
                float returnValue = array.get(pathReturn, pathIndex)
                float drawdownValue = array.get(pathDD, pathIndex)
                int observations = array.get(pathBars, pathIndex)

                positivePaths += returnValue > 0.0 ? 1 : 0

                string status =
                     returnValue > 0.0 and metricValue > 0.0
                     ? "POSITIVE"
                     : "FAILED"

                color statusColor = status == "POSITIVE" ? color.lime : color.red
                int tableRow = pathIndex + 1

                f_setCell(pathTable, 0, tableRow, "P" + str.tostring(pathIndex + 1), color.white, regularBackground)
                f_setCell(pathTable, 1, tableRow, f_number(metricValue), f_metricColor(metricValue), regularBackground)
                f_setCell( pathTable,2, tableRow,selectionMetric == "Sharpe" ? "" : f_number(sharpeValue),selectionMetric == "Sharpe" ? color.new(color.white, 100) : f_metricColor(sharpeValue),regularBackground)
                f_setCell(pathTable, 3, tableRow, f_percent(returnValue), f_metricColor(returnValue), regularBackground)
                f_setCell(pathTable, 4, tableRow, f_percent(drawdownValue), color.orange, regularBackground)
                f_setCell(pathTable, 5, tableRow, str.tostring(observations), color.silver, regularBackground)
                f_setCell(pathTable, 6, tableRow, status, statusColor, regularBackground)

            float medianMetric = f_median(pathMetric)
            float lowerMetric = f_percentile(pathMetric, 0.10)
            float medianReturn = f_median(pathReturn)
            float lowerReturn = f_percentile(pathReturn, 0.10)

            float positiveRate = availablePaths > 0
                 ? float(positivePaths) / availablePaths
                 : na

            // ================================================================
            // RESEARCH INTEGRITY CALCULATION
            // ================================================================
            //
            // The score is intentionally transparent rather than mysterious.
            //
            // Maximum score: 100 points.
            //
            // Sample Size:          25 points
            // Coverage:             25 points
            // Positive Paths:       25 points
            // Lower-Tail Quality:   15 points
            // Drawdown Severity:    10 points
            //
            // The score evaluates the research setup and result consistency.
            // It is not a prediction of future profits.
            // ================================================================

            float requiredSample =
                 groupCount * math.max(minTestBars, 2) * 4.0

            float sampleIntegrity =
                 math.min(
                     float(totalBars) / math.max(requiredSample, 1.0),
                     1.0
                 ) * 25.0

            float coverageIntegrity =
                 enoughData
                 ? 25.0
                 : 0.0

            float pathIntegrity =
                 nz(positiveRate, 0.0) * 25.0

            float tailIntegrity =
                 lowerMetric > 0.0
                 ? 15.0
                 : medianMetric > 0.0
                     ? 7.5
                     : 0.0

            float medianPathDrawdown = f_median(pathDD)
            float absoluteMedianDrawdown = math.abs(nz(medianPathDrawdown, -1.0))

            float drawdownIntegrity =
                 absoluteMedianDrawdown <= 0.20
                 ? 10.0
                 : absoluteMedianDrawdown <= 0.35
                     ? 5.0
                     : 0.0

            float researchIntegrity =
                 math.min(
                     sampleIntegrity +
                     coverageIntegrity +
                     pathIntegrity +
                     tailIntegrity +
                     drawdownIntegrity,
                     100.0
                 )

            string integrityGrade =
                 researchIntegrity >= 85.0
                 ? "EXCELLENT"
                 : researchIntegrity >= 70.0
                     ? "GOOD"
                     : researchIntegrity >= 50.0
                         ? "CAUTION"
                         : "WEAK"

            color integrityColor =
                 integrityGrade == "EXCELLENT"
                 ? color.lime
                 : integrityGrade == "GOOD"
                     ? color.aqua
                     : integrityGrade == "CAUTION"
                         ? color.yellow
                         : color.red

            string sampleStatus =
                 sampleIntegrity >= 25.0
                 ? "Sufficient sample"
                 : "Limited sample"

            string pathStatus =
                 positiveRate >= 0.80
                 ? "Strong path consistency"
                 : positiveRate >= 0.60
                     ? "Mixed path consistency"
                     : "Weak path consistency"

            string tailStatus =
                 lowerMetric > 0.0
                 ? "Positive lower tail"
                 : medianMetric > 0.0
                     ? "Fragile lower tail"
                     : "Negative lower tail"

            string drawdownStatus =                    
                 absoluteMedianDrawdown <= 0.20
                 ? "Controlled median drawdown"
                 : absoluteMedianDrawdown <= 0.35
                     ? "Elevated median drawdown"
                     : "Severe median drawdown"

            // Research Integrity has an independent text-size control.
            activeTableTextSize := f_tableTextSize(integrityTableTextSizeInput)

            f_setCell(integrityTable, 0, 0, "RESEARCH INTEGRITY", color.white, headerBackground)
            f_setCell(integrityTable, 1, 0, str.tostring(researchIntegrity, "#.0") + "%", integrityColor, headerBackground)

            f_setCell(integrityTable, 0, 1, "GRADE", color.white, regularBackground)
            f_setCell(integrityTable, 1, 1, integrityGrade, integrityColor, regularBackground)

            f_setCell(integrityTable, 0, 2, "SAMPLE", color.aqua, regularBackground)
            f_setCell(integrityTable, 1, 2, sampleStatus, color.white, regularBackground)

            f_setCell(integrityTable, 0, 3, "COVERAGE", color.aqua, regularBackground)
            f_setCell(integrityTable, 1, 3, enoughData ? "Training/test coverage valid" : "Insufficient coverage", enoughData ? color.lime : color.red, regularBackground)

            f_setCell(integrityTable, 0, 4, "PATHS", color.aqua, regularBackground)
            f_setCell(integrityTable, 1, 4, pathStatus, positiveRate >= 0.80 ? color.lime : positiveRate >= 0.60 ? color.yellow : color.red, regularBackground)

            f_setCell(integrityTable, 0, 5, "TAIL", color.aqua, regularBackground)
            f_setCell(integrityTable, 1, 5, tailStatus, lowerMetric > 0.0 ? color.lime : medianMetric > 0.0 ? color.yellow : color.red, regularBackground)

            f_setCell(integrityTable, 0, 6, "DRAWDOWN", color.aqua, regularBackground)
            f_setCell(integrityTable, 1, 6, drawdownStatus, absoluteMedianDrawdown <= 0.20 ? color.lime : absoluteMedianDrawdown <= 0.35 ? color.yellow : color.red, regularBackground)

            f_setCell(integrityTable, 0, 7, "MEANING", color.aqua, regularBackground)
            f_setCell(integrityTable, 1, 7, "Research confidence — not expected profit", color.silver, regularBackground)

            string verdict = medianMetric > 0.0 and lowerMetric > 0.0 and positiveRate >= 0.80 ? "ROBUST" : medianMetric > 0.0 and positiveRate >= 0.60 ? "FRAGILE" : "FAILED"

            color verdictColor = verdict == "ROBUST" ? color.lime : verdict == "FRAGILE" ? color.yellow : color.red

            // Restore the independent Path Diagnostics text size before its
            // median and lower-tail summary rows are populated.
            activeTableTextSize := f_tableTextSize(pathTableTextSizeInput)

            int summaryRow = availablePaths + 2

            f_setCell(pathTable, 0, summaryRow, "MEDIAN", color.white, headerBackground)
            f_setCell(pathTable, 1, summaryRow, f_number(medianMetric), f_metricColor(medianMetric), headerBackground)
            f_setCell(pathTable, 2, summaryRow, "Positive", color.white, headerBackground)
            f_setCell(pathTable, 3, summaryRow, f_percent(positiveRate), f_metricColor(positiveRate - 0.5), headerBackground)
            f_setCell(pathTable, 4, summaryRow, f_percent(medianReturn), f_metricColor(medianReturn), headerBackground)
            f_setCell(pathTable, 5, summaryRow, "N=" + str.tostring(groupCount), color.aqua, headerBackground)
            f_setCell(pathTable, 6, summaryRow, verdict, verdictColor, headerBackground)

            int tailRow = summaryRow + 1

            f_setCell(pathTable, 0, tailRow, "WORST PATH", color.white, headerBackground)
            f_setCell(pathTable, 1, tailRow, f_number(lowerMetric), f_metricColor(lowerMetric), headerBackground)
            f_setCell(pathTable, 2, tailRow, "Worst Return", color.white, headerBackground)
            f_setCell(pathTable, 3, tailRow, f_percent(lowerReturn), f_metricColor(lowerReturn), headerBackground)
            f_setCell(pathTable, 4, tailRow, "Splits", color.white, headerBackground)
            f_setCell(pathTable, 5, tailRow, str.tostring(expectedSplits), color.aqua, headerBackground)
            f_setCell(pathTable, 6, tailRow, "φ=" + str.tostring(pathCount), color.aqua, headerBackground)

        else
            activeTableTextSize := f_tableTextSize(pathTableTextSizeInput)

            f_setCell(pathTable, 0, 1, "NO VALID PATHS", color.white, warningBackground)
            f_setCell(pathTable, 1, 1, str.tostring(totalBars) + " stored bars", color.white, warningBackground)

    // Path calculations may run solely to support Research Integrity.
    // Clear either visual table when its own visibility control is disabled.
    if not showPathTable
        table.clear(pathTable, 0, 0, 6, 11)

    if not showIntegrityTable
        table.clear(integrityTable, 0, 0, 1, 7)


// ============================================================================
// DATA-WINDOW OUTPUTS
// ============================================================================

float medianPathMetric =
     array.size(pathMetric) > 0
     ? f_median(pathMetric)
     : na

float lowerPathMetric =
     array.size(pathMetric) > 0
     ? f_percentile(pathMetric, 0.10)
     : na



hline(
     0.0,
     "Zero",
     color = color.gray,
     linestyle = hline.style_dotted
)
