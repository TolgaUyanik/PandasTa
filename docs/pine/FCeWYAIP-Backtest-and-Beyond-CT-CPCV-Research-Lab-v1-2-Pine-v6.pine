string name3 = input.string("EMA 20/50 — Medium", "", group = GRP_EMA, inline = "c3", tooltip = "Display name used in the Split Diagnostics table.\n\nChanging the name does not change the strategy logic.")
int fast3 = input.int(20, "Fast", minval = 1, group = GRP_EMA, inline = "p3", tooltip = "Fast exponential moving-average period.\n\nSmaller values react more quickly but may increase noise and turnover.")
int slow3 = input.int(50, "Slow", minval = 2, group = GRP_EMA, inline = "p3", tooltip = "Slow exponential moving-average period.\n\nLarger values produce a slower trend reference and may reduce short-term whipsaws.")

bool enable4 = input.bool(true, "Enable 4", group = GRP_EMA, inline = "c4", tooltip = "Includes Candidate 4 in CPCV model selection.\n\nWhen disabled, this candidate is ignored during every training split.")
string name4 = input.string("EMA 50/100 — Medium/Long", "", group = GRP_EMA, inline = "c4", tooltip = "Display name used in the Split Diagnostics table.\n\nChanging the name does not change the strategy logic.")
int fast4 = input.int(50, "Fast", minval = 1, group = GRP_EMA, inline = "p4", tooltip = "Fast exponential moving-average period.\n\nSmaller values react more quickly but may increase noise and turnover.")
int slow4 = input.int(100, "Slow", minval = 2, group = GRP_EMA, inline = "p4", tooltip = "Slow exponential moving-average period.\n\nLarger values produce a slower trend reference and may reduce short-term whipsaws.")

bool enable5 = input.bool(true, "Enable 5", group = GRP_EMA, inline = "c5", tooltip = "Includes Candidate 5 in CPCV model selection.\n\nWhen disabled, this candidate is ignored during every training split.")
string name5 = input.string("EMA 50/200 — Long", "", group = GRP_EMA, inline = "c5", tooltip = "Display name used in the Split Diagnostics table.\n\nChanging the name does not change the strategy logic.")
int fast5 = input.int(50, "Fast", minval = 1, group = GRP_EMA, inline = "p5", tooltip = "Fast exponential moving-average period.\n\nSmaller values react more quickly but may increase noise and turnover.")
int slow5 = input.int(200, "Slow", minval = 2, group = GRP_EMA, inline = "p5", tooltip = "Slow exponential moving-average period.\n\nLarger values produce a slower trend reference and may reduce short-term whipsaws.")


string GRP_CLASSIC = "6. Candidates 6–10 — Classic Strategies"

bool enable6 = input.bool(true, "Enable 6", group = GRP_CLASSIC, inline = "c6", tooltip = "Includes Candidate 6 in CPCV model selection.\n\nWhen disabled, this candidate is ignored during every training split.")
string name6 = input.string("RSI Reversion", "", group = GRP_CLASSIC, inline = "c6", tooltip = "Display name used in the Split Diagnostics table.\n\nChanging the name does not change the strategy logic.")
int rsiLength = input.int(14, "RSI Length", minval = 2, group = GRP_CLASSIC, tooltip = "Number of bars used to calculate RSI.\n\nShorter values react faster. Longer values produce a smoother oscillator.")
float rsiOversold = input.float(30.0, "RSI Oversold", group = GRP_CLASSIC, tooltip = "RSI level used to trigger long mean-reversion entries when crossed downward.\n\nLower values require a more extreme downside reading.")
float rsiOverbought = input.float(70.0, "RSI Overbought", group = GRP_CLASSIC, tooltip = "RSI level used to trigger short mean-reversion entries when crossed upward.\n\nHigher values require a more extreme upside reading.")
float rsiExit = input.float(50.0, "RSI Exit Level", group = GRP_CLASSIC, tooltip = "RSI center level used to exit open mean-reversion positions.\n\nThe default 50 level represents a return toward neutral momentum.")

bool enable7 = input.bool(true, "Enable 7", group = GRP_CLASSIC, inline = "c7", tooltip = "Includes Candidate 7 in CPCV model selection.\n\nWhen disabled, this candidate is ignored during every training split.")
string name7 = input.string("MACD Trend", "", group = GRP_CLASSIC, inline = "c7", tooltip = "Display name used in the Split Diagnostics table.\n\nChanging the name does not change the strategy logic.")
int macdFast = input.int(12, "MACD Fast", minval = 1, group = GRP_CLASSIC, inline = "m7", tooltip = "Fast EMA period used in the MACD calculation.\n\nSmaller values make MACD react more quickly.")
int macdSlow = input.int(26, "Slow", minval = 2, group = GRP_CLASSIC, inline = "m7", tooltip = "Slow EMA period used in the MACD calculation.\n\nLarger values create a slower trend reference.")
int macdSignal = input.int(9, "Signal", minval = 1, group = GRP_CLASSIC, inline = "m7", tooltip = "EMA period applied to the MACD line.\n\nShorter values create faster signal changes; longer values smooth them.")

bool enable8 = input.bool(true, "Enable 8", group = GRP_CLASSIC, inline = "c8", tooltip = "Includes Candidate 8 in CPCV model selection.\n\nWhen disabled, this candidate is ignored during every training split.")
string name8 = input.string("Donchian 20/10", "", group = GRP_CLASSIC, inline = "c8", tooltip = "Display name used in the Split Diagnostics table.\n\nChanging the name does not change the strategy logic.")
int donEntryLength = input.int(20, "Donchian Entry", minval = 2, group = GRP_CLASSIC, inline = "d8", tooltip = "Lookback used to define breakout-entry channel highs and lows.\n\nLonger values require a larger breakout.")
int donExitLength = input.int(10, "Exit", minval = 2, group = GRP_CLASSIC, inline = "d8", tooltip = "Lookback used to define the shorter exit channel.\n\nSmaller values usually exit trends more quickly.")

bool enable9 = input.bool(true, "Enable 9", group = GRP_CLASSIC, inline = "c9", tooltip = "Includes Candidate 9 in CPCV model selection.\n\nWhen disabled, this candidate is ignored during every training split.")
string name9 = input.string("Supertrend 3/10", "", group = GRP_CLASSIC, inline = "c9", tooltip = "Display name used in the Split Diagnostics table.\n\nChanging the name does not change the strategy logic.")
float stFactor = input.float(3.0, "Supertrend Factor", minval = 0.1, step = 0.1, group = GRP_CLASSIC, inline = "s9", tooltip = "ATR multiplier used to position the Supertrend reversal threshold.\n\nLarger values create wider thresholds and fewer direction changes.")
int stAtrLength = input.int(10, "ATR", minval = 1, group = GRP_CLASSIC, inline = "s9", tooltip = "ATR lookback used by Supertrend.\n\nShorter values react faster to volatility changes; longer values are smoother.")

bool enable10 = input.bool(true, "Enable 10", group = GRP_CLASSIC, inline = "c10", tooltip = "Includes Candidate 10 in CPCV model selection.\n\nWhen disabled, this candidate is ignored during every training split.")
string name10 = input.string("Bollinger Reversion", "", group = GRP_CLASSIC, inline = "c10", tooltip = "Display name used in the Split Diagnostics table.\n\nChanging the name does not change the strategy logic.")
int bbLength = input.int(20, "BB Length", minval = 2, group = GRP_CLASSIC, inline = "b10", tooltip = "Lookback used for the Bollinger basis and standard deviation.\n\nShorter values react faster; longer values produce smoother bands.")
float bbMult = input.float(2.0, "Deviation", minval = 0.1, step = 0.1, group = GRP_CLASSIC, inline = "b10", tooltip = "Number of standard deviations used to place the upper and lower bands.\n\nLarger values create wider bands and fewer entry signals.")


string GRP_DISPLAY = "7. Display & Tables"

// IMPORTANT:
// Tables assigned to the same chart position can overlap and conceal one
// another. Give each visible table a different position unless overlapping
// tables are intentional. Apparently even research tables require assigned
// seating.

// ----------------------------------------------------------------------------
// Split Diagnostics controls.
// ----------------------------------------------------------------------------

bool showSplitTable = input.bool(
     true,
     "Show Split Diagnostics",
     group = GRP_DISPLAY,
     inline = "splitShow"
)

string splitTablePositionInput = input.string(
     "Top Right",
     "Position",
     options = [
          "Top Left",
          "Top Center",
          "Top Right",
          "Middle Left",
          "Middle Center",
          "Middle Right",
          "Bottom Left",
          "Bottom Center",
          "Bottom Right"
     ],
     group = GRP_DISPLAY,
     inline = "splitPosition"
)

string splitTableTextSizeInput = input.string(
     "Small",
     "Text Size",
     options = [
          "Tiny",
          "Small",
          "Normal",
          "Large",
