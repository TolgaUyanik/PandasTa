// ============================================================================
// TABLE DISPLAY HELPERS
// ============================================================================
//
// Pine uses built-in position and size constants rather than the readable text
// shown in input menus.
//
// These functions translate the user's dropdown selections into the constants
// required by table.new() and table.cell().
//
// ============================================================================

f_tablePosition(string selectedPosition) =>
    switch selectedPosition
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.top_right


f_tableTextSize(string selectedSize) =>
    switch selectedSize
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.small


// f_setCell() reads this value whenever it creates a table cell.
//
// The value is changed immediately before each table is populated, allowing
// every table to use its own independent text-size setting without repeating
// the size argument in every individual cell call.
var string activeTableTextSize = size.small


// ============================================================================
// CONSTANTS AND STORAGE
// ============================================================================

int MODEL_COUNT = 10
float COST_RATE = costBps / 10000.0

var array<float> assetReturns = array.new<float>()
var array<float> modelExposure = array.new<float>()

var array<int> splitGroupA = array.new<int>()
var array<int> splitGroupB = array.new<int>()
var array<int> splitModel = array.new<int>()

var array<float> splitTrainMetric = array.new<float>()
var array<float> splitTrainSharpe = array.new<float>()
var array<float> splitTestMetric = array.new<float>()
var array<float> splitTestReturn = array.new<float>()
var array<float> splitTestDD = array.new<float>()

var array<int> pathSplitMap = array.new<int>()

var array<float> pathMetric = array.new<float>()
var array<float> pathSharpe = array.new<float>()
var array<float> pathReturn = array.new<float>()
var array<float> pathDD = array.new<float>()
var array<int> pathBars = array.new<int>()

var table splitTable = table.new(
     f_tablePosition(splitTablePositionInput),
     7,
     31,
     border_width = 1,
     bgcolor = color.new(color.black, tableTransparency)
)

var table pathTable = table.new(
     f_tablePosition(pathTablePositionInput),
     7,
     12,
     border_width = 1,
     bgcolor = color.new(color.black, tableTransparency)
)

