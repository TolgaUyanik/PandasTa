//@version=5
indicator("Momentum 8% 4% 9M", overlay=true)

// Calculate daily percentage change from previous close
dailyChangePercent = (close - close[1]) / close[1] * 100

// Background color highlighting for big moves
isUp8Percent = dailyChangePercent >= 8
isDown4Percent = dailyChangePercent <= -4

// Background highlight for big price moves (green/red)
bgcolor(isUp8Percent ? color.new(color.green, 85) : na)
bgcolor(isDown4Percent ? color.new(color.red, 85) : na)

// Condition for high volume days (>= 9 million)
isHighVolume = volume >= 9000000

// Plot a small yellow upward triangle below the bar for high volume days
plotshape(isHighVolume, style=shape.triangleup, location=location.belowbar, color=color.yellow, size=size.tiny)

// Note: Removed label creation code and volLabels array to avoid clutter/performance issues
