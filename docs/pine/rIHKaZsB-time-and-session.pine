// @function Returns the highest value of the specified source during the current postmarket trading session
// @param source The data series to evaluate, defaults to high
// @param persist A boolean indicating whether to retain the last value outside of postmarket hours, defaults to true
// @returns The highest value during the current postmarket trading session, or na if the timeframe is not suitable
export postmarket_session_high(float source = high, bool persist = true)=>
	int start_of_session = nz(ta.barssince(session.islastbar_regular[1])) + 1
	float postmarket_high = ta.highest(source, start_of_session)
	var float highest = na

	if not (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly) and session.ispostmarket
		highest := postmarket_high
	if not (persist or session.ispostmarket)
		highest := na

	highest

// @function Returns the lowest value of the specified source during the current postmarket trading session
// @param source The data series to evaluate, defaults to low
// @param persist A boolean indicating whether to retain the last value outside of postmarket hours, defaults to true
// @returns The lowest value during the current postmarket trading session, or na if the timeframe is not suitable
export postmarket_session_low(float source = low, bool persist = true)=>
	int start_of_session = nz(ta.barssince(session.islastbar_regular[1])) + 1
	float postmarket_low = ta.lowest(source, start_of_session)
	var float lowest = na

	if not (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly) and session.ispostmarket
		lowest := postmarket_low
	if not (persist or session.ispostmarket)
		lowest := na

	lowest

// @function Returns the highest value of the specified source during the current weekly session. Can fail on lower timeframes.
// @param source The data series to evaluate, defaults to high
// @returns The highest value during the current weekly session, or na if the timeframe is not suitable
export weekly_high(float source = high)=>
	var bool initialized = false

	if not (timeframe.ismonthly or timeframe.isweekly)
		int start_of_week = nz(ta.barssince(weekofyear != weekofyear[1])) + 1
		float weekly_high = ta.highest(source, start_of_week)
		weekly_high
	else
		float(na)

// @function Returns the lowest value of the specified source during the current weekly session. Can fail on lower timeframes.
// @param source The data series to evaluate, defaults to low
// @returns The lowest value during the current weekly session, or na if the timeframe is not suitable
export weekly_low(float source = low)=>
	if not (timeframe.ismonthly or timeframe.isweekly)
		int start_of_week = nz(ta.barssince(weekofyear != weekofyear[1])) + 1
		float weekly_low = ta.lowest(source, start_of_week)
		weekly_low
	else
		float(na)

// @function Returns the highest value of the specified source during the current monthly session. Can fail on lower timeframes.
// @param source The data series to evaluate, defaults to high
// @returns The highest value during the current monthly session, or na if the timeframe is not suitable
export monthly_high(float source = high)=>
	int start_of_month = nz(ta.barssince(month != month[1])) + 1
	float monthly_high = ta.highest(source, start_of_month)
	monthly_high

// @function Returns the lowest value of the specified source during the current monthly session. Can fail on lower timeframes.
// @param source The data series to evaluate, defaults to low
// @returns The lowest value during the current monthly session, or na if the timeframe is not suitable
export monthly_low(float source = low)=>
	int start_of_month = nz(ta.barssince(month != month[1])) + 1
	float monthly_low = ta.lowest(source, start_of_month)
	monthly_low

// @function Returns the highest value of the specified source during the current yearly session. Can fail on lower timeframes.
// @param source The data series to evaluate, defaults to high
// @returns The highest value during the current yearly session, or na if the timeframe is not suitable
export yearly_high(float source = high)=>
	int start_of_year = nz(ta.barssince(year != year[1])) + 1
	float yearly_high = ta.highest(source, start_of_year)
	yearly_high

// @function Returns the lowest value of the specified source during the current yearly session. Can fail on lower timeframes.
// @param source The data series to evaluate, defaults to low
// @returns The lowest value during the current yearly session, or na if the timeframe is not suitable
export yearly_low(float source = low)=>
	int start_of_year = nz(ta.barssince(year != year[1])) + 1
	float yearly_low = ta.lowest(source, start_of_year)
	yearly_low
