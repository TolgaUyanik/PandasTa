//@version=5

// @description Provides functions for checking time and session-based conditions and retrieving session-specific high and low values.
library("time_and_session")

// @function Checks if the current time is within the specified trading session
// @param session The trading session, defined using input.session()
// @param timeframe The timeframe to use, defaults to the current chart's timeframe
// @param timezone The timezone to use, defaults to the symbol's timezone
// @returns A boolean indicating whether the current time is within the specified trading session
export is_session(string session, string timeframe = "", string timezone = syminfo.timezone) =>
	time == time(timeframe, session, timezone)

// @function Checks if the current time is within a specified date range
// @param start_time The start time, defined using input.time()
// @param end_time The end time, defined using input.time()
// @returns A boolean indicating whether the current time is within the specified date range
export is_date_range(int start_time, int end_time)=>
	time >= start_time and time <= end_time

// @function Checks if the current day of the week matches any of the specified days
// @param sunday A boolean indicating whether to check for Sunday
// @param monday A boolean indicating whether to check for Monday
// @param tuesday A boolean indicating whether to check for Tuesday
// @param wednesday A boolean indicating whether to check for Wednesday
// @param thursday A boolean indicating whether to check for Thursday
// @param friday A boolean indicating whether to check for Friday
// @param saturday A boolean indicating whether to check for Saturday
// @returns A boolean indicating whether the current day of the week matches any of the specified days
export is_day_of_week(bool sunday = false, bool monday = false, bool tuesday = false, bool wednesday = false, bool thursday = false, bool friday = false, bool saturday = false)=>
	(dayofweek == dayofweek.monday and monday) 
	 or (dayofweek == dayofweek.tuesday and tuesday)
	 or (dayofweek == dayofweek.wednesday and wednesday)
	 or (dayofweek == dayofweek.thursday and thursday)
	 or (dayofweek == dayofweek.friday and friday)
	 or (dayofweek == dayofweek.saturday and saturday)
	 or (dayofweek == dayofweek.sunday and sunday)

// @function Returns the highest value of the specified source during the current daily session
// @param source The data series to evaluate, defaults to high
// @returns The highest value during the current daily session, or na if the timeframe is not suitable
export daily_high(float source = high)=>
	if not (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly)
		int start_of_session = nz(ta.barssince(session.isfirstbar)) + 1
		float daily_high = ta.highest(source, start_of_session)
		daily_high
	else
		float(na)

// @function Returns the lowest value of the specified source during the current daily session
// @param source The data series to evaluate, defaults to low
// @returns The lowest value during the current daily session, or na if the timeframe is not suitable
export daily_low(float source = low)=>
	if not (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly)
		int start_of_session = nz(ta.barssince(session.isfirstbar)) + 1
		float daily_low = ta.lowest(source, start_of_session)
		daily_low
	else
		float(na)

// @function Returns the highest value of the specified source during the current regular trading session
// @param source The data series to evaluate, defaults to high
// @param persist A boolean indicating whether to retain the last value outside of regular market hours, defaults to true
// @returns The highest value during the current regular trading session, or na if the timeframe is not suitable
export regular_session_high(float source = high, bool persist = true)=>
	int start_of_session = nz(ta.barssince(session.isfirstbar_regular)) + 1
	float regular_high = ta.highest(source, start_of_session)
	var float highest = na

	if not (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly) and session.ismarket
		highest := regular_high
	if not (persist or session.ismarket)
		highest := na

	highest

// @function Returns the lowest value of the specified source during the current regular trading session
// @param source The data series to evaluate, defaults to low
// @param persist A boolean indicating whether to retain the last value outside of regular market hours, defaults to true
// @returns The lowest value during the current regular trading session, or na if the timeframe is not suitable
export regular_session_low(float source = low, bool persist = true)=>
	int start_of_session = nz(ta.barssince(session.isfirstbar_regular)) + 1
	float regular_low = ta.lowest(source, start_of_session)
	var float lowest = na

	if not (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly) and session.ismarket
		lowest := regular_low
	if not (persist or session.ismarket)
		lowest := na

	lowest

