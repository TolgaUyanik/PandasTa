// ============================================================
// SHOOTING STAR REVERSAL STRATEGY — XAUUSD 15m
// Pine Script v6
// Backtested: Feb 2025 – Apr 2026 | 73.1% win rate (28 trades)
// Logic: Upper wick >= 3x body, small lower wick, after uptrend
// Entry: SHORT on close of shooting star candle
// SL: above wick high + 0.5x body
// TP: 3x body below entry
// ============================================================

//@version=6
strategy(
     title            = "Shooting Star Reversal [XAUUSD 15m]",
     shorttitle        = "SS Reversal",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 10,
     commission_type   = strategy.commission.cash_per_order,
     commission_value  = 0.5,
     slippage          = 2
     )

// ─────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────
grp1 = "Shooting Star Settings"
wickMultiplier  = input.float(3.0,  "Min Wick-to-Body Ratio",  minval=1.5, maxval=10.0, step=0.5, group=grp1,
     tooltip="Upper wick must be this many times larger than the candle body")
maxLowerWick    = input.float(1.0,  "Max Lower Wick (× body)", minval=0.1, maxval=3.0,  step=0.1, group=grp1,
     tooltip="Lower wick must be smaller than this multiple of the body")
minBodySize     = input.float(2.0,  "Min Body Size ($)",       minval=0.1, step=0.5,    group=grp1,
     tooltip="Minimum candle body in dollars — filters out doji-like candles")
uptrendBars     = input.int(5,      "Uptrend Lookback (bars)", minval=3,   maxval=20,   group=grp1,
     tooltip="How many bars back to check for an uptrend before the shooting star")

grp2 = "Risk Management"
slMultiplier    = input.float(0.5,  "SL Buffer (× body above wick high)", minval=0.1, maxval=3.0, step=0.1, group=grp2)
tpMultiplier    = input.float(3.0,  "TP (× body below entry)",            minval=1.0, maxval=10.0, step=0.5, group=grp2)

grp3 = "Session Filter (NY Time)"
useSessionFilter = input.bool(false, "Only trade during session?", group=grp3)
sessionStart     = input.int(7,  "Session Start Hour (server time)", minval=0, maxval=23, group=grp3)
sessionEnd       = input.int(20, "Session End Hour (server time)",   minval=0, maxval=23, group=grp3)

grp4 = "Display"
showLabels  = input.bool(true,  "Show Entry Labels",    group=grp4)
showSLTP    = input.bool(true,  "Show SL/TP Lines",     group=grp4)
showSignal  = input.bool(true,  "Highlight Signal Bar", group=grp4)

// ─────────────────────────────────────────
// CANDLE COMPONENTS
// ─────────────────────────────────────────
bodySize   = math.abs(close - open)
upperWick  = high - math.max(open, close)
lowerWick  = math.min(open, close) - low
isBull     = close > open
isBear     = close < open

// ─────────────────────────────────────────
// UPTREND CONDITION
// close of current bar is higher than close N bars ago
// ─────────────────────────────────────────
uptrend = close > close[uptrendBars]

// ─────────────────────────────────────────
// SHOOTING STAR CONDITIONS
// ─────────────────────────────────────────
cond_minBody    = bodySize >= minBodySize
cond_upperWick  = upperWick >= bodySize * wickMultiplier
cond_lowerWick  = lowerWick < bodySize * maxLowerWick
cond_uptrend    = uptrend

// Session filter
inSession = (hour >= sessionStart and hour < sessionEnd)
cond_session = useSessionFilter ? inSession : true

isShootingStar = cond_minBody and cond_upperWick and cond_lowerWick and cond_uptrend and cond_session

// ─────────────────────────────────────────
// ENTRY, SL, TP CALCULATION
// ─────────────────────────────────────────
// Entry  : close of the shooting star bar (SHORT)
// SL     : wick high + (body × slMultiplier)
// TP     : entry - (body × tpMultiplier)

entryPrice = close
slPrice    = high + (bodySize * slMultiplier)
tpPrice    = close - (bodySize * tpMultiplier)

// ─────────────────────────────────────────
// STRATEGY EXECUTION
// Only one trade at a time (no pyramiding)
// ─────────────────────────────────────────
noOpenTrade = strategy.position_size == 0

if isShootingStar and noOpenTrade
    strategy.entry("SS Short", strategy.short, comment="▼ SHORT")
    strategy.exit(
         "SS Exit",
         from_entry = "SS Short",
         stop       = slPrice,
         limit      = tpPrice,
         comment_profit = "✔ TP",
         comment_loss   = "✖ SL"
         )

// ─────────────────────────────────────────
// VISUALS — Signal Bar Highlight
// ─────────────────────────────────────────
bgColor = isShootingStar and showSignal ? color.new(color.orange, 80) : na
bgcolor(bgColor)

// ─────────────────────────────────────────
// VISUALS — SL/TP Lines (drawn on signal bar)
// ─────────────────────────────────────────
// We draw lines from signal bar extending 20 bars to the right
var line slLine = na
var line tpLine = na
var line entryLine = na

if isShootingStar and noOpenTrade and showSLTP
    // Delete previous lines
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(entryLine)
        line.delete(entryLine)

    slLine    := line.new(bar_index, slPrice,    bar_index + 20, slPrice,    color=color.new(color.red,   20), width=1, style=line.style_dashed)
    tpLine    := line.new(bar_index, tpPrice,    bar_index + 20, tpPrice,    color=color.new(color.green, 20), width=1, style=line.style_dashed)
    entryLine := line.new(bar_index, entryPrice, bar_index + 20, entryPrice, color=color.new(color.white, 40), width=1, style=line.style_dotted)

// ─────────────────────────────────────────
// VISUALS — Labels
// ─────────────────────────────────────────
if isShootingStar and showLabels
    rr = (entryPrice - tpPrice) / (slPrice - entryPrice)
    labelTxt = "🌠 SHOOTING STAR\n▼ Entry:  " + str.tostring(entryPrice, "#.##") +
               "\n🛑 SL:     " + str.tostring(slPrice, "#.##") +
               "\n🎯 TP:     " + str.tostring(tpPrice, "#.##") +
               "\n📐 RR:     1:" + str.tostring(rr, "#.#")
    label.new(
         bar_index, high + (high * 0.001),
         text      = labelTxt,
         style     = label.style_label_down,
         color     = color.new(color.orange, 10),
         textcolor = color.white,
         size      = size.small
         )

// ─────────────────────────────────────────
// VISUALS — Plot shooting star marker on chart
// ─────────────────────────────────────────
plotshape(
     isShootingStar,
     title    = "Shooting Star",
     location = location.abovebar,
     style    = shape.triangledown,
     color    = color.new(color.orange, 0),
     size     = size.small
     )

// ─────────────────────────────────────────
// INFO TABLE (top-right corner)
// ─────────────────────────────────────────
var table infoTable = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "SHOOTING STAR", text_color=color.white,  bgcolor=color.new(color.orange, 10), text_size=size.normal)
    table.cell(infoTable, 1, 0, "REVERSAL",       text_color=color.orange, bgcolor=color.new(color.orange, 10), text_size=size.normal)

    table.cell(infoTable, 0, 1, "Wick Ratio",     text_color=color.gray,   bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(wickMultiplier, "#.#") + "× body", text_color=color.white, bgcolor=color.new(color.black, 30), text_size=size.small)

    table.cell(infoTable, 0, 2, "Min Body",       text_color=color.gray,   bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(infoTable, 1, 2, "$" + str.tostring(minBodySize, "#.#"),    text_color=color.white, bgcolor=color.new(color.black, 30), text_size=size.small)

    table.cell(infoTable, 0, 3, "SL Buffer",      text_color=color.gray,   bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(slMultiplier, "#.#") + "× body above high", text_color=color.red, bgcolor=color.new(color.black, 30), text_size=size.small)

    table.cell(infoTable, 0, 4, "TP Target",      text_color=color.gray,   bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(tpMultiplier, "#.#") + "× body below entry", text_color=color.green, bgcolor=color.new(color.black, 30), text_size=size.small)

    table.cell(infoTable, 0, 5, "Uptrend Bars",   text_color=color.gray,   bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(uptrendBars) + " bars",       text_color=color.white, bgcolor=color.new(color.black, 30), text_size=size.small)

    posSize = strategy.position_size
    posColor = posSize < 0 ? color.red : posSize > 0 ? color.green : color.gray
    posText  = posSize < 0 ? "SHORT ACTIVE" : posSize > 0 ? "LONG ACTIVE" : "FLAT"
    table.cell(infoTable, 0, 6, "Position",       text_color=color.gray,   bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(infoTable, 1, 6, posText,          text_color=posColor,     bgcolor=color.new(color.black, 30), text_size=size.small)
