//@version=6
strategy("DCA Grid 15 Orders - 1.1% Step - 1.8% TP",
     overlay=true,
     pyramiding=15,
     initial_capital=10000,
     default_qty_type=strategy.cash,
     default_qty_value=100)

// Inputs
baseOrder      = input.float(100, "Base Order Size ($)")
gridStep       = input.float(1.1, "Grid Step (%)")
takeProfit     = input.float(1.8, "Take Profit (%)")
multiplier     = input.float(1.2, "Size Multiplier")
maxOrders      = input.int(15, "Max Orders")

// Variables
var int orderCount = 0
var float lastEntryPrice = na

// Start first position
if strategy.position_size == 0
    strategy.entry("Long_1", strategy.long, qty = baseOrder / close)
    orderCount := 1
    lastEntryPrice := close

// Additional DCA orders
if strategy.position_size > 0 and orderCount < maxOrders
    nextBuyPrice = lastEntryPrice * (1 - gridStep / 100)

    if low <= nextBuyPrice
        orderQtyCash = baseOrder * math.pow(multiplier, orderCount)
        strategy.entry("Long_" + str.tostring(orderCount + 1),
             strategy.long,
             qty = orderQtyCash / close)

        lastEntryPrice := nextBuyPrice
        orderCount += 1

// Average Entry
avgPrice = strategy.position_avg_price

// Take Profit
tpPrice = avgPrice * (1 + takeProfit / 100)

if strategy.position_size > 0
    strategy.exit("TP", limit = tpPrice)

// Reset after exit
if strategy.position_size == 0 and strategy.position_size[1] > 0
    orderCount := 0
    lastEntryPrice := na

// Plot
plot(strategy.position_size > 0 ? avgPrice : na,
     color=color.yellow,
     linewidth=2,
     title="Average Price")

plot(strategy.position_size > 0 ? tpPrice : na,
     color=color.green,
     linewidth=2,
     title="Take Profit")
