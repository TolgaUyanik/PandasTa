// @version=6
// @description A library containing Random value generating helper functions.
library("random_values", overlay = true)

import kaigouthro/into/2

// @function Helper function for random number generator.
// @param min (float) The minimum value for the random number.
// @param max (float) The maximum value for the random number.
// @returns   (float) A random float number between min and max.
num(float min, float max) =>
    math.random(min, max)

var const string letters = "abcdefghijklmnopqrstuvwxyz"

// @function Helper function for letter generator.
// @param num (int) An integer representing the letter to be generated (1-26).
// @returns     (string) The corresponding letter.
__letter(int num) =>
    if num < 1 or num > 26
        ""
    else if num == 26
        "z"
    else
        str.substring(letters,num-1,num)    
    
// @function Random letter generator.
// @returns  (string) A random lowercase letter.
export letter() =>
    var pick = 0
    max_bars_back(pick,2)
    pick := int(math.random(0,25))
    str.substring(letters,pick,pick+1)    
    
// @function Random word generator.
// @param size (int) The desired length of the word. If 0 or not provided, a random length between 3 and 10 is used.
// @returns      (string) A random word.
export word(int size = 0) =>
    int _size = size <= 0 ? into.i(num(3, 10)) : size
    string word = ""
    for i = 0 to _size - 1
        word += letter()
    word

// @function Random words generator.
// @param size (int) The number of words to generate. If 0 or not provided, a random number between 3 and 10 is used.
// @returns      (string) A string of random words separated by spaces.
export words(int size = 20) =>
    int _size = size <= 0 ? into.i(num(3, 10)) : size
    array<string> words = array.new<string>()
    for i = 0 to _size - 1
        words.push( word())
    array.join(words, " ")

// @function Random boolean generator.
// @returns  (bool) A random boolean value (true or false).
export boolVal() =>
    into.b(int(num(0, 1.9999999999)))

// @function Random float number generator.
// @param min       (float) The minimum float value. Defaults to 0.
// @param max       (float) The maximum float value. Defaults to 100.
// @param precision (int)   The number of decimal places. Defaults to 2.
// @returns         (float) A random float number.
export floatVal(float min = 0, float max = 100, int precision = 2) =>
    math.round(num(min, max), precision)

// @function Random integer number generator.
// @param min (int) The minimum integer value. Defaults to 1.
// @param max (int) The maximum integer value. Defaults to 100.
// @returns     (int) A random integer number.
export intVal(int min = 1, int max = 100) =>
    into.i(num(min, max))

// @function Random string array generator.
// @param size (int) The desired size of the array. If 0 or not provided, a random size between 3 and 10 is used.
// @returns      (array<string>) An array of random words.
export stringArray(int size = 0) =>
    int _size = size <= 0 ? int(num(3, 10)) : size
    array<string> str_arr = array.new<string>()
    for i = 0 to _size - 1
        str_arr.push( word())
    str_arr

// @function Random float array generator.
// @param size      (int)   The desired size of the array. If 0 or not provided, a random size between 3 and 10 is used.
// @param min       (float) The minimum float value. Defaults to 0.
// @param max       (float) The maximum float value. Defaults to 100.
// @param precision (int)   The number of decimal places. Defaults to 2.
// @returns         (array<float>) An array of random float numbers.
export floatArray(int size = 0, float min = 0, float max = 100, int precision = 2) =>
    int _size = size <= 0 ? int(num(3, 10)) : size
    array<float> float_arr = array.new<float>()
    for i = 0 to _size - 1
        float_arr.push(math.round(math.random(min, max), precision))
    float_arr

// @function Random integer array generator.
// @param size (int) The desired size of the array. If 0 or not provided, a random size between 3 and 10 is used.
// @param min  (int) The minimum integer value. Defaults to 1.
// @param max  (int) The maximum integer value. Defaults to 100.
// @returns      (array<int>) An array of random integer numbers.
export intArray(int size = 0, int min = 1, int max = 100) =>
    int _size = size <= 0 ? int(num(3, 10)) : size
    array<int> int_arr = array.new<int>()
    for i = 0 to _size - 1
        int_arr.push( intVal(min, max))
    int_arr

// @function Random boolean array generator.
// @param size (int) The desired size of the array. If 0 or not provided, a random size between 3 and 10 is used.
// @returns      (array<bool>) An array of random boolean values.
export boolArray(int size = 0) =>
    int _size = size <= 0 ? int(num(3, 10)) : size
    array<bool> bool_arr = array.new<bool>()
    for i = 0 to _size - 1
        bool_arr.push( boolVal())
    bool_arr


// @function get a random color
// @description Returns a random color from the colors array.
// @returns (color) A random color.
export get_color() =>
    var const color[] colors = array.from(color.aqua, color.black, color.blue, color.fuchsia, color.gray, color.green, color.lime, color.maroon, color.navy, color.olive, color.purple, color.red, color.silver, color.teal, color.white, color.yellow)
    // Array of colors (internal library variable)
    colors.get( math.round(math.random(-0.49,colors.size() -0.51)))

// @function get a random dayofweek
// @description Returns a random dayofweek value from the dayofweeks array.
// @returns (int) A random dayofweek value.
export get_dayofweek() =>
    var const int[] dayofweeks = array.from(dayofweek.sunday, dayofweek.monday, dayofweek.tuesday, dayofweek.wednesday, dayofweek.thursday, dayofweek.friday, dayofweek.saturday)
    dayofweeks.get( math.round(math.random(-0.49,dayofweeks.size() -0.51)))

// @function get a random extend
// @description Returns a random extend value.
// @returns (string) A random extend value.
export get_extend() =>
    var const string[] extends = array.from(extend.none, extend.left, extend.right, extend.both)
    extends.get( math.round(math.random(-0.49,extends.size() -0.51)))

// @function get a random labelstyle(
// @description Returns a random label style.
// @returns (string) A random label style.
export get_labelstyle() => 
    var const string[] styles = array.from(label.style_arrowdown, label.style_arrowup, label.style_circle, label.style_cross, label.style_diamond, label.style_flag, label.style_label_center, label.style_label_down, label.style_label_left, label.style_label_lower_left, label.style_label_lower_right, label.style_label_right, label.style_label_up, label.style_label_upper_left, label.style_label_upper_right, label.style_none, label.style_square, label.style_text_outline, label.style_triangledown, label.style_triangleup, label.style_xcross)
    styles.get( math.round(math.random(-0.49,styles.size() -0.51)))

// @function get a random linestyle
// @description Returns a random line style.
// @returns (string) A random line style.
export get_linestyle() =>
    var const string[] linestyles = array.from(line.style_solid, line.style_dotted, line.style_dashed, line.style_arrow_left, line.style_arrow_right, line.style_arrow_both)
    linestyles.get( math.round(math.random(-0.49,linestyles.size() -0.51)))

// @function get a random location
// @description Returns a random location value.
// @returns (string) A random location value.
export get_location() =>
    var const string[] locations = array.from(location.abovebar, location.belowbar, location.top, location.bottom, location.absolute)
    locations.get( math.round(math.random(-0.49,locations.size() -0.51)))

// @function get a random position
// @description Returns a random position value.
// @returns (string) A random position value.
export get_position() =>
    var const string[] positions = array.from(position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right)
    positions.get( math.round(math.random(-0.49,positions.size() -0.51)))

// @function get a random shape
// @description Returns a random shape value.
// @returns (string) A random shape value.
export get_shape() =>
    var const string[] shapes = array.from(shape.xcross, shape.cross, shape.circle, shape.triangleup, shape.triangledown, shape.flag, shape.arrowup, shape.arrowdown, shape.labelup, shape.labeldown, shape.square, shape.diamond)
    shapes.get( math.round(math.random(-0.49,shapes.size() -0.51)))

// @function get a random size
// @description Returns a random size value.
// @returns (string) A random size value.
export get_size() =>
    var const string[] sizes = array.from(size.auto, size.tiny, size.small, size.normal, size.large, size.huge)
    sizes.get( math.round(math.random(-0.49,sizes.size() -0.51)))

// @function get a box/tablecell random textalign
// @description Returns a random text alignment value.
// @returns (string) A random text alignment value.
export get_textalign() =>
    var const string[] textaligns = array.from(text.align_center, text.align_left, text.align_right, text.align_top, text.align_bottom)
    textaligns.get( math.round(math.random(-0.49,textaligns.size() -0.51)))

// @function get a label's random textalign
// @description Returns a random text alignment value.
// @returns (string) A random text alignment value.
export get_labeltextalign() =>
    var const string[] textaligns = array.from(text.align_center, text.align_left, text.align_right)
    textaligns.get( math.round(math.random(-0.49,textaligns.size() -0.51)))


// @function get a random fontfamily
// @description Returns a random font family value.
// @returns (string) A random font family value.
export get_fontfamily() =>
    var string[] fontfamilies = array.from(font.family_default, font.family_monospace)
    fontfamilies.get( math.round(math.random(-0.49,fontfamilies.size() -0.51)))

