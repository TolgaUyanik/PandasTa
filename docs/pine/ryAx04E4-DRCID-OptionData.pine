//@version=6
//────────────────────────────────────────────
//  DRCID CLUB (A-OPTIONDATA-I)
//  Centralized NSE Option Data Library
//────────────────────────────────────────────
library("DRCID_OptionData")

//────────────────────────────────────────────
// 1️⃣ MASTER STRIKE DATA
//────────────────────────────────────────────
export get_StrikeData(string symbol) =>
    float base  = na
    float step  = na
    float lot   = na
    float ref   = na
    float extra = na

    // 🔹 NIFTY
    if symbol == "NIFTY"
        base  := 25500
        step  := 50
        lot   := 65
        ref   := 25700
        extra := 0

    // 🔹 BANKNIFTY
    else if symbol == "BANKNIFTY"
        base  := 56000
        step  := 100
        lot   := 30
        ref   := 56500
        extra := 0

    // 👉 Add more symbols here

    [base, step, lot, ref, extra]


//────────────────────────────────────────────
// 2️⃣ AUTO ATM CALCULATION
//────────────────────────────────────────────
export getATM(float price, float step) =>
    na(step) ? na : math.round(price / step) * step


//────────────────────────────────────────────
// 3️⃣ AUTO WEEKLY EXPIRY (THURSDAY)
//────────────────────────────────────────────
export getWeeklyExpiry() =>
    int todayWeek = dayofweek
    int daysToThu = dayofweek.thursday - todayWeek
    daysToThu := daysToThu < 0 ? daysToThu + 7 : daysToThu
    int expiryTime = timenow + daysToThu * 24 * 60 * 60 * 1000
    str.format("{0,date,dd-MMM-yyyy}", expiryTime)


//────────────────────────────────────────────
// 4️⃣ MANUAL EXPIRY FORMATTER
//────────────────────────────────────────────
export formatManualExpiry(string d, string m, string y) =>
    fullYear = "20" + y
    d + "-" + m + "-" + fullYear


//────────────────────────────────────────────
// 5️⃣ UNIFIED OPTION DATA ENGINE
//    useRefATM  → true  = manual ATM (ref)
//                  false = auto ATM
//    useManualExp → true  = manual expiry
//                   false = weekly expiry
//────────────────────────────────────────────
export getOptionData(
     string symbol,
     float  price,
     bool   useRefATM,
     bool   useManualExp,
     string d,
     string m,
     string y) =>

    [base, step, lot, ref, extra] = get_StrikeData(symbol)

    // ATM Mode
    atm = useRefATM ? ref : getATM(price, step)

    // Expiry Mode
    expiry = useManualExp ? formatManualExpiry(d, m, y)
                          : getWeeklyExpiry()

    [base, step, lot, atm, expiry]

var int GLOBAL_EXPIRY_TIME = timestamp("2026-03-30 00:00")

export getGlobalExpiry() =>
    str.format("{0,date,dd/MM/yyyy}", GLOBAL_EXPIRY_TIME)