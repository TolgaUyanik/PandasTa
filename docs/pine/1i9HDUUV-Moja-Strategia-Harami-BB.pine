//@version=5
strategy("Moja Strategia Harami BB", overlay=true, initial_capital=1000, default_qty_type=strategy.cash, default_qty_value=100)

// === Using Heikin Ashi prices from chart ===
ha_open  = open
ha_high  = high
ha_low   = low
ha_close = close

// === Bollinger Bands ===
bbLen = input.int(20, "BB Length")
bbMult = input.float(2.0, "BB Multiplier")

basis = ta.sma(ha_close, bbLen)
dev = ta.stdev(ha_close, bbLen) * bbMult
upperBB = basis + dev
lowerBB = basis - dev

plot(basis, "BB Basis", color=color.blue)
p1 = plot(upperBB, "Upper BB")
p2 = plot(lowerBB, "Lower BB")
fill(p1,p2,color=color.new(color.blue, 85))

// === Candle body ranges ===
prev_high = math.max(ha_open[1], ha_close[1])
prev_low  = math.min(ha_open[1], ha_close[1])
curr_high = math.max(ha_open, ha_close)
curr_low  = math.min(ha_open, ha_close)

// === First candle touches BB ===
firstTouchLower = ha_low[1] <= lowerBB[1]
firstTouchUpper = ha_high[1] >= upperBB[1]

// === Harami Body Inside ===
bodyInside = curr_high <= prev_high and curr_low >= prev_low

// === Signal Logic ===
bullSignal = firstTouchLower and (ha_close[1] < ha_open[1]) and bodyInside
bearSignal = firstTouchUpper and (ha_close[1] > ha_open[1]) and bodyInside

// === Strategy Logic ===
// Otwieranie pozycji Long
if (bullSignal)
    strategy.entry("Long", strategy.long)

// Otwieranie pozycji Short
if (bearSignal)
    strategy.entry("Short", strategy.short)

// Zamykanie pozycji na sztywnych wartościach TP = 40 i SL = 20
strategy.exit("TP/SL Long", from_entry="Long", profit=40, loss=20)
strategy.exit("TP/SL Short", from_entry="Short", profit=40, loss=20)

// === Plot Signals ===
plotshape(bullSignal, style=shape.labelup, location=location.belowbar,
     color=color.lime, text="Bull Harami", size=size.large)

plotshape(bearSignal, style=shape.labeldown, location=location.abovebar,
     color=color.red, text="Bear Harami", size=size.large)

// === Alerts ===
alertcondition(bullSignal, "Bull Harami Reversal",
     "Bullish Harami – First candle touched lower BB")

alertcondition(bearSignal, "Bear Harami Reversal",
     "Bearish Harami – First candle touched upper BB")