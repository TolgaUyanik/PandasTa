//@version=5

library("SessionAndKillZoneLibrary_TradingFinder" , overlay = true)
export SessionDetector(string Session_Name, string Session_Time, string KillZone_Time,
 bool Session_Show, bool KillZone_Show, string AreaUpdate, bool MoreInfo, color Session_Color, color Info_Color) =>
	var int Bar       = 0
	var int Time      = 0
	var float Open    = 0.0
	var float High    = 0.0
	var float Low     = 0.0
	var float Close   = 0.0
	var line Top      = na
	var line Bottom   = na
    var int LockLowEx = 1
    var int LockHighEx= 1	
	var bool HighTouchAlert = false
	var bool LowTouchAlert  = false
	var line First    = na
	var line End      = na 
	var line Arrow    = na
	var box Fill      = na	
	var label Name    = na
	var label Info    = na
	var float ATR     = 0.0
	var int BarInfo   = 0
	var int TimeInfo  = 0
	var float Vol     = 0.0
	var string Bar_Text  = ''
	var string Time_Text = ''
	var string Vol_Text  = ''
	atr      = ta.atr(4999)
	SessTime = math.sign(nz(time(timeframe.period, Session_Time, 'UTC+0')))
	KillTime = math.sign(nz(time(timeframe.period, KillZone_Time, 'UTC+0')))
	FillTime = KillZone_Show ? KillTime : SessTime
	if BarInfo == 0
		Bar_Text := '0' + ' bar, '
	else if BarInfo == 1
		Bar_Text := '1' + ' bar, '
	else if BarInfo > 1
		Bar_Text := str.tostring(BarInfo ) + ' bars, '

	if TimeInfo < 60
		Time_Text := str.tostring(TimeInfo) + 'm'
	else if TimeInfo >= 60
		if  (TimeInfo % 60) == 0 
			Time_Text := str.tostring(TimeInfo/60) + 'h'
		else  
			Time_Text := str.tostring( int(TimeInfo/60) ) + 'h ' + str.tostring(TimeInfo % 60) + 'm'

	if Vol <= 1000
		Vol_Text := '\nVol ' + str.tostring(Vol + volume)  
	else if Vol > 1000
		Vol_Text := '\nVol ' + str.tostring((Vol+ volume) / 1000) + 'K'


	if  (SessTime[1] == 0 and SessTime == 1)
		ATR  := atr
		Bar  := bar_index
		High := high
		Low  := low
		Open := open
	    LockLowEx := 1
        LockHighEx:= 1
		Time := time[1]
		BarInfo   := bar_index - Bar
		TimeInfo  := (time - Time) / (60 * 1000)
		Vol       := volume 
	if SessTime == 0
		Bar      := 0
		Time     := 0
		BarInfo  := 0
		TimeInfo := 0
		Vol      := 0.0
		Bar_Text  := ''
		Time_Text := ''
		Vol_Text  := ''

	if AreaUpdate == 'Session'
		if (SessTime[1] == 1 and SessTime == 1)
			High := math.max(high , High) 
			Low :=   math.min(low , Low)
	else if AreaUpdate == 'Kill Zone' and KillZone_Show
	    if (KillTime[1] == 1 and KillTime == 1)
			High := math.max(high , High) 
			Low :=   math.min(low , Low)
	else 
		if (SessTime[1] == 1 and SessTime == 1)
			High := math.max(high , High) 
			Low :=   math.min(low , Low)		

    if (SessTime > SessTime[1]) and Session_Show		
		Top    := line.new(Bar, High, Bar, High, color = Session_Color , style = line.style_dotted)
		Bottom := line.new(Bar,  Low, Bar,  Low, color = Session_Color , style = line.style_dotted)
		Name   := label.new(Bar, High , text = Session_Name ,xloc = xloc.bar_index, yloc = yloc.price, 
		 size = size.small ,textcolor = Session_Color, color = color.rgb(255, 255, 255, 100))
		if MoreInfo
			First  := line.new(Bar,  Low, Bar,  Low - 2*ATR  , color = Info_Color , style = line.style_solid , width = 2)
			End    := line.new(Bar,  Low, Bar,  Low - 2*ATR  , color = Info_Color , style = line.style_solid , width = 2)
			Arrow  := line.new(Bar,  Low - ATR , Bar,  Low - ATR , color = Info_Color, style = line.style_arrow_right , width = 2)
			Info   := label.new(Bar,  Low - ATR, text = Bar_Text + Time_Text + Vol_Text , style = label.style_label_up , color = #f0f0f093, size = size.small )
	

	if (SessTime == 1 and SessTime == SessTime[1]) and Session_Show
        if high <= High and LockHighEx == 1
            Top.set_y1(High)
            Top.set_xy2(bar_index, High)
            Name.set_xy(math.round(math.avg(Bar,bar_index)), High)
        else      
            LockHighEx := 0
        if low >= Low and LockLowEx == 1
            Bottom.set_y1(Low)
            Bottom.set_xy2(bar_index, Low)
        else
            LockLowEx := 0
			
		Fill.set_top(High)
		Fill.set_bottom(Low)
		First.set_y1(Low)
		First.set_y2(Low - 2*ATR)
		End.set_y1(Low)
		End.set_y2(Low - 2*ATR)
		Arrow.set_y1(Low - ATR)
		Arrow.set_y2(Low - ATR)
		Info.set_y(Low - ATR)


    if (FillTime > FillTime[1]) and Session_Show
		Fill := box.new(Bar, High,Bar,  Low, border_color = #ffffff00, bgcolor = color.new(Session_Color, 95) )

	
	if (FillTime == 1 and FillTime == FillTime[1]) and Session_Show 
		Fill.set_right(bar_index)
		End.set_x1(bar_index)
		End.set_x2(bar_index)
		Arrow.set_x2(bar_index)
		Info.set_text(Bar_Text + Time_Text + Vol_Text)
		Info.set_x(Bar  + math.round(BarInfo/2))
		BarInfo   := bar_index - Bar + 1
		TimeInfo  := (time - Time) / (60 * 1000)
		Vol       := Vol + volume


	if (SessTime[1] == 1 and SessTime == 0)
		Close := close[1]

	if LockLowEx[1] == 1 and LockLowEx == 0
		LowTouchAlert := true
	else
		LowTouchAlert := false

	if LockHighEx[1] == 1 and LockHighEx == 0
		HighTouchAlert := true
	else
		HighTouchAlert := false	
		
	[SessTime, KillTime, Open, High, Low, Close, LowTouchAlert, HighTouchAlert]