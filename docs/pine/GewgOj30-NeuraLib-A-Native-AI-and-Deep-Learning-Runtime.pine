export method pushNextReturnRow(WindowDataset self, FeatureBuilder featureBuilder, float currentValue, float futureValue) =>
    self.pushRow(featureBuilder.toArray(), array.from(_nextReturnValue(currentValue, futureValue)))


// @function                Adds a feature row with a next-direction classification target.
