    _applyColumnScaleProfile(targetTensor, _computeFlatScaleProfile(self.targetStoreArray, self.rowCount, self.targetCount, 0, self.rowCount, self.targetScalerKind, self.targetScalerEpsilon, self.maxRows, self.headIndex), self.targetCount, targetTensor.name, true)


// @function                Converts all available RollingDataset windows into one scaled Batch.
// @param self              (RollingDataset) Input tensor consumed by the model or operation.
// @param targetOffset      (simple int) Number of rows after each window used to select the target row.
export method unrollBatch(RollingDataset self, simple int targetOffset = 0) =>
    Batch raw = _unrollRollingBatchRaw(self, targetOffset)
    int inputProfileRows = self.rowCount
    Batch.new(_applyColumnScaleProfile(raw.inputTensor, _computeFlatScaleProfile(self.featureStoreArray, self.rowCount, self.featureCount, 0, inputProfileRows, self.inputScalerKind, self.inputScalerEpsilon, self.maxRows, self.headIndex), self.featureCount, raw.inputTensor.name), _applyColumnScaleProfile(raw.targetTensor, _computeFlatScaleProfile(self.targetStoreArray, self.rowCount, self.targetCount, 0, self.rowCount, self.targetScalerKind, self.targetScalerEpsilon, self.maxRows, self.headIndex), self.targetCount, raw.targetTensor.name), raw.batchRows)


// @function                Returns the training windows from a RollingDataset using scaler profiles fit only on training rows.
// @param self              (RollingDataset) Input tensor consumed by the model or operation.
// @param validationWindows (simple int) Number of final temporal windows held out for validation.
// @param targetOffset      (simple int) Number of rows after each window used to select the target row.
export method trainBatch(RollingDataset self, simple int validationWindows = 1, simple int targetOffset = 0) =>
    int totalWindows = _rollingWindowCount(self.rowCount, self.timeSteps, targetOffset)
    int valWindows = math.min(math.max(validationWindows, 0), totalWindows)
    int trainWindows = math.max(totalWindows - valWindows, 0)
    int profileRows = trainWindows > 0 ? math.min(self.rowCount, trainWindows + math.max(self.timeSteps, 1) - 1) : self.rowCount
    int targetProfileRows = trainWindows > 0 ? math.min(self.rowCount, profileRows + math.max(targetOffset, 0)) : self.rowCount
    Batch raw = _sliceRollingBatchRaw(self, 0, trainWindows, targetOffset)
    _scaleFlatBatchRange(raw, self.featureStoreArray, self.targetStoreArray, self.rowCount, self.featureCount, self.targetCount, profileRows, self.inputScalerKind, self.targetScalerKind, self.inputScalerEpsilon, self.targetScalerEpsilon, self.maxRows, self.headIndex, targetProfileRows)


// @function                Returns held-out RollingDataset windows scaled from the training profile.
// @param self              (RollingDataset) Input tensor consumed by the model or operation.
// @param validationWindows (simple int) Number of final temporal windows held out for validation.
// @param targetOffset      (simple int) Number of rows after each window used to select the target row.
export method validationBatch(RollingDataset self, simple int validationWindows = 1, simple int targetOffset = 0) =>
    int totalWindows = _rollingWindowCount(self.rowCount, self.timeSteps, targetOffset)
    int valWindows = math.min(math.max(validationWindows, 0), totalWindows)
    int trainWindows = math.max(totalWindows - valWindows, 0)
    int profileRows = trainWindows > 0 ? math.min(self.rowCount, trainWindows + math.max(self.timeSteps, 1) - 1) : self.rowCount
    int targetProfileRows = trainWindows > 0 ? math.min(self.rowCount, profileRows + math.max(targetOffset, 0)) : self.rowCount
    Batch raw = _sliceRollingBatchRaw(self, trainWindows, valWindows, targetOffset)
    _scaleFlatBatchRange(raw, self.featureStoreArray, self.targetStoreArray, self.rowCount, self.featureCount, self.targetCount, profileRows, self.inputScalerKind, self.targetScalerKind, self.inputScalerEpsilon, self.targetScalerEpsilon, self.maxRows, self.headIndex, targetProfileRows)


// @function                Clears stored values and resets object counters.
