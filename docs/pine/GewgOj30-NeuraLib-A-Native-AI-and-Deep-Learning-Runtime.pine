export method softmax(GraphBlock self, int source, string name = "softmax") =>
    _blockAddOp(self, GraphOpKind.softmax, source, -1, -1, 0.0, 0, 0, 0, ActivationKind.softmax, InitKind.zeros, name)


// @function                Reshapes, flattens, slices, or concatenates tensors while preserving value order where applicable.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method transpose(GraphBlock self, int source, string name = "transpose") =>
    _blockAddOp(self, GraphOpKind.transpose, source, -1, -1, 0.0, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Appends a layer-normalization layer or graph node.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param epsilon           (float) Small denominator guard used for numeric stability.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method layerNorm(GraphBlock self, int source, float epsilon = 1e-7, string name = "layer_norm") =>
    _blockAddOp(self, GraphOpKind.layerNorm, source, -1, -1, epsilon, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Appends a dropout layer or graph node that is active during training mode.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param rate              (float) Dropout rate for dropout APIs, or learning rate where used by optimizers.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method dropout(GraphBlock self, int source, float rate, string name = "dropout") =>
    _blockAddOp(self, GraphOpKind.dropout, source, -1, -1, rate, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Adds a causal attention mask node to a GraphBlock.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method causalMask(GraphBlock self, int source, string name = "causal_mask") =>
    _blockAddOp(self, GraphOpKind.causalMask, source, -1, -1, 0.0, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Reshapes, flattens, slices, or concatenates tensors while preserving value order where applicable.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param startRow          (simple int) The starting index for the specified dimension.
