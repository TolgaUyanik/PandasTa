// @function                Adds one validated feature and target row to dataset storage.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param featureRowArray   (array<float>) Feature values for one dataset row.
// @param targetRowArray    (array<float>) Ordered values used to build the requested tensor, shape, or configuration.
export method pushRow(WindowDataset self, array<float> featureRowArray, array<float> targetRowArray) =>
    int packed = _pushFlatDatasetRow(self.featureStoreArray, self.targetStoreArray, featureRowArray, targetRowArray, self.featureCount, self.targetCount, self.maxRows, self.rowCount, self.headIndex)
    int base = math.max(self.maxRows, 1) + 1
    self.rowCount := int(math.floor(packed / base))
    self.headIndex := packed % base
    self


// @function                Adds one FeatureBuilder row and target row to dataset storage.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param featureBuilder    (FeatureBuilder) Builder containing the feature row to store.
// @param targetRowArray    (array<float>) Ordered values used to build the requested tensor, shape, or configuration.
export method pushBuilderRow(WindowDataset self, FeatureBuilder featureBuilder, array<float> targetRowArray) =>
    self.pushRow(featureBuilder.toArray(), targetRowArray)


// @function                Adds a feature row with a next-return target.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param featureBuilder    (FeatureBuilder) Builder containing the feature row to store.
// @param currentValue      (float) Current price or value used as the reference point.
