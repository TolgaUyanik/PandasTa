export method pushNextDirectionRow(WindowDataset self, FeatureBuilder featureBuilder, float currentValue, float futureValue, float threshold = 0.0, bool zeroOne = true) =>
    self.pushRow(featureBuilder.toArray(), array.from(_nextDirectionValue(currentValue, futureValue, threshold, zeroOne)))


// @function                Checks whether enough rows or windows are available for training.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param minRows           (simple int) Minimum stored rows required before the dataset is considered ready.
export method ready(WindowDataset self, simple int minRows = 1) =>
    self.rowCount >= minRows


// @function                Returns the current number of stored values, rows, or windows.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
export method size(WindowDataset self) =>
    self.rowCount


// @function                Constructs a setInputScaler to normalize input data, ensuring features maintain a balanced distribution for optimal training convergence.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param kind              (ScalerKind) Scaling mode to apply to dataset columns.
// @param epsilon           (float) Small denominator guard used for numeric stability.
export method setInputScaler(WindowDataset self, ScalerKind kind, float epsilon = 1e-7) =>
    self.inputScalerKind := kind == ScalerKind.runningZScore ? ScalerKind.zScore : kind
    self.inputScalerEpsilon := math.max(epsilon, DEFAULT_EPSILON)
    self


// @function                Constructs a setTargetScaler to normalize input data, ensuring features maintain a balanced distribution for optimal training convergence.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param kind              (ScalerKind) Scaling mode to apply to dataset columns.
