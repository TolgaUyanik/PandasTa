// @param minWindows        (simple int) Minimum temporal windows required before the dataset is ready.
// @param targetOffset      (simple int) Number of rows after each window used to select the target row.
export method ready(RollingDataset self, simple int minWindows = 1, simple int targetOffset = 0) =>
    self.windowCount(targetOffset) >= math.max(minWindows, 0)


// @function                Returns the current number of stored values, rows, or windows.
