    float lastLoss
    float lastMetric1
    float lastMetric2
    float gradNorm
    float learningRate
    int stepCount
    int sampleCount
    int epochCount
    int lastBatchRows
    bool lastStepRan

export type HistoryBuffer
    int maxLength
    array<float> lossHistoryArray
    array<float> metric1HistoryArray
    array<float> metric2HistoryArray

export type LossResult
    float value
    Tensor gradTensor
    Tensor unreducedTensor

export type PredictionMoments
    Tensor meanTensor
    Tensor varianceTensor
    int sampleCount

export type GraphBlock
    string name
    array<GraphOpKind> opArray
