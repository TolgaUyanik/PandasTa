    _blockAddOp(self, GraphOpKind.sliceRows, source, -1, -1, 0.0, startRow, rowCount, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Reshapes, flattens, slices, or concatenates tensors while preserving value order where applicable.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param top               (int) Graph node id for the first row block.
// @param bottom            (int) Graph node id for the second row block.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method concatRows(GraphBlock self, int top, int bottom, string name = "concat_rows") =>
    _blockAddOp(self, GraphOpKind.concatRows, top, bottom, -1, 0.0, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Reshapes, flattens, slices, or concatenates tensors while preserving value order where applicable.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param startCol          (simple int) The starting index for the specified dimension.
// @param colCount          (simple int) Number of columns to extract.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method sliceCols(GraphBlock self, int source, simple int startCol, simple int colCount, string name = "slice_cols") =>
    _blockAddOp(self, GraphOpKind.sliceCols, source, -1, -1, 0.0, startCol, colCount, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Reshapes, flattens, slices, or concatenates tensors while preserving value order where applicable.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param left              (int) Input tensor consumed by the model or operation.
// @param right             (int) Input tensor consumed by the model or operation.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method concatCols(GraphBlock self, int left, int right, string name = "concat_cols") =>
    _blockAddOp(self, GraphOpKind.concatCols, left, right, -1, 0.0, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Adds a graph node that sums values across rows.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method reduceRows(GraphBlock self, int source, string name = "reduce_rows") =>
    _blockAddOp(self, GraphOpKind.reduceRows, source, -1, -1, 0.0, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Adds a graph node that sums values across columns.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method reduceCols(GraphBlock self, int source, string name = "reduce_cols") =>
    _blockAddOp(self, GraphOpKind.reduceCols, source, -1, -1, 0.0, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Pools flattened sequence features by temporal average.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param timeSteps         (simple int) The number of sequential historical steps.
// @param featureCount      (simple int) Number of features stored per row or time step.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method globalAvgPool1d(GraphBlock self, int source, simple int timeSteps, simple int featureCount, string name = "global_avg_pool1d") =>
    _blockAddOp(self, GraphOpKind.globalAvgPool1d, source, -1, -1, 0.0, timeSteps, featureCount, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Pools flattened sequence features by temporal maximum.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param timeSteps         (simple int) The number of sequential historical steps.
// @param featureCount      (simple int) Number of features stored per row or time step.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method globalMaxPool1d(GraphBlock self, int source, simple int timeSteps, simple int featureCount, string name = "global_max_pool1d") =>
    _blockAddOp(self, GraphOpKind.globalMaxPool1d, source, -1, -1, 0.0, timeSteps, featureCount, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Adds a scaled attention-score node to a GraphBlock.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param query             (int) Graph node id containing query vectors.
// @param key               (int) Graph node id containing key vectors.
// @param causal            (bool) When true, masks future columns in attention scores.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method attentionScore(GraphBlock self, int query, int key, bool causal = false, string name = "attention_score") =>
    _blockAddOp(self, GraphOpKind.attentionScore, query, key, -1, 0.0, causal ? 1 : 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Adds an attention-weighted value aggregation node to a GraphBlock.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param weights           (int) Graph node id containing attention weights.
// @param value             (int) Value to store, queue, scale, or wrap.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method attentionApply(GraphBlock self, int weights, int value, string name = "attention_apply") =>
    _blockAddOp(self, GraphOpKind.attentionApply, weights, value, -1, 0.0, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)


// @function                Adds a Conv1D graph node with explicit kernel and bias nodes.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param kernelNode        (int) Graph node id containing convolution or recurrent kernel weights.
// @param biasNode          (int) Graph node id containing bias weights.
// @param timeSteps         (simple int) The number of sequential historical steps.
// @param featureCount      (simple int) Number of features stored per row or time step.
// @param kernelSize        (simple int) Width of the Conv1D sliding window.
// @param stride            (simple int) Step size between Conv1D applications.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method conv1d(GraphBlock self, int source, int kernelNode, int biasNode, simple int timeSteps, simple int featureCount, simple int kernelSize, simple int stride = 1, string name = "conv1d") =>
    _blockAddOp(self, GraphOpKind.conv1d, source, kernelNode, biasNode, stride, timeSteps, featureCount, kernelSize, ActivationKind.linear, InitKind.zeros, name)


// @function                Adds an LSTM scan node to a GraphBlock.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param kernelNode        (int) Graph node id containing convolution or recurrent kernel weights.
// @param biasNode          (int) Graph node id containing bias weights.
// @param timeSteps         (simple int) The number of sequential historical steps.
// @param featureCount      (simple int) Number of features stored per row or time step.
// @param units             (simple int) Number of output or recurrent hidden units.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method scanLstm(GraphBlock self, int source, int kernelNode, int biasNode, simple int timeSteps, simple int featureCount, simple int units, string name = "lstm") =>
    _blockAddOp(self, GraphOpKind.scanLstm, source, kernelNode, biasNode, 0.0, timeSteps, featureCount, units, ActivationKind.linear, InitKind.zeros, name)


// @function                Adds a GRU scan node to a GraphBlock.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param source            (int) Source graph node id consumed by the new operation.
// @param kernelNode        (int) Graph node id containing convolution or recurrent kernel weights.
// @param biasNode          (int) Graph node id containing bias weights.
// @param timeSteps         (simple int) The number of sequential historical steps.
// @param featureCount      (simple int) Number of features stored per row or time step.
// @param units             (simple int) Number of output or recurrent hidden units.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method scanGru(GraphBlock self, int source, int kernelNode, int biasNode, simple int timeSteps, simple int featureCount, simple int units, string name = "gru") =>
    _blockAddOp(self, GraphOpKind.scanGru, source, kernelNode, biasNode, 0.0, timeSteps, featureCount, units, ActivationKind.linear, InitKind.zeros, name)


// @function                Marks a GraphBlock node as the block output.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param node              (int) Graph node id to mark as the block output.
// @param outputFeatureCount (int) Number of features stored per row or time step.
export method output(GraphBlock self, int node, int outputFeatureCount = 0) =>
    self.outputNode := node
    self.outFeatures := outputFeatureCount
    self


// @function                Creates a GraphBlock input node or Sequential input shape.
// @param model             (Sequential) Sequential model receiving the input shape block.
// @param inputDimsArray    (array<int>) Ordered values used to build the requested tensor, shape, or configuration.
// @param name              (string) Optional input block name used for graph diagnostics.
export method input(Sequential model, array<int> inputDimsArray, string name = "input") =>
    int featureCount = _computeSize(inputDimsArray)
    GraphBlock block = graphBlock(name)
    int x = block.input("x")
    block.output(x, featureCount)
    model.blockArray.push(block)
    model


_denseGraphBlock(int inputFeatures, int units, ActivationKind activationKind, string name) =>
    GraphBlock block = graphBlock(name)
    int x = block.input("x")
    int w = block.param(inputFeatures, units, activationKind == ActivationKind.relu or activationKind == ActivationKind.leakyRelu or activationKind == ActivationKind.elu or activationKind == ActivationKind.geluApprox or activationKind == ActivationKind.swish ? InitKind.heUniform : InitKind.xavierUniform, "kernel")
    int b = block.param(1, units, InitKind.zeros, "bias")
    int z = block.add(block.matmul(x, w, "matmul"), b, "affine")
    int y = activationKind == ActivationKind.linear ? z : block.activate(z, activationKind, 0.01, "output")
    block.output(y, units)


// @function                Appends a dense affine layer to the Sequential model.
// @param model             (Sequential) Sequential model receiving the dense layer.
// @param units             (simple int) Number of output or recurrent hidden units.
// @param activationKind    (ActivationKind) Activation function applied by the layer or operation.
// @param name              (string) Optional layer name used for graph diagnostics.
// @example
// model.dense(64, nl.ActivationKind.relu)
export method dense(Sequential model, simple int units, ActivationKind activationKind = ActivationKind.linear, string name = "dense") =>
    int inputFeatures = _sequentialOutputFeatureCount(model)
    if inputFeatures <= 0
        runtime.error("dense() requires input() or prior known output shape.")
    model.blockArray.push(_denseGraphBlock(inputFeatures, math.max(units, 1), activationKind, name))
    model


// @function                Adds a dense action-value output head to a Sequential model.
// @param model             (Sequential) Sequential model receiving the Q-value output head.
// @param actionCount       (simple int) Number of Q-value outputs to produce.
// @param activationKind    (ActivationKind) Activation function applied by the layer or operation.
// @param name              (string) Optional head name used for graph diagnostics.
export method qHead(Sequential model, simple int actionCount, ActivationKind activationKind = ActivationKind.linear, string name = "q_head") =>
    model.dense(actionCount, activationKind, name)


// @function                Appends an activation layer to the Sequential model.
// @param model             (Sequential) Sequential model receiving the activation layer.
// @param activationKind    (ActivationKind) Activation function applied by the layer or operation.
// @param alpha             (float) Negative slope or activation-specific coefficient used by supported activations.
// @param name              (string) Optional activation layer name used for graph diagnostics.
export method activation(Sequential model, ActivationKind activationKind, float alpha = 0.01, string name = "activation") =>
    int currentOutputFeatures = _sequentialOutputFeatureCount(model)
    GraphBlock block = graphBlock(name)
    int x = block.input("x")
    int y = block.activate(x, activationKind, alpha, "output")
    block.output(y, currentOutputFeatures)
    model.blockArray.push(block)
    model


// @function                Appends a dropout layer or graph node that is active during training mode.
// @param model             (Sequential) Sequential model receiving the dropout layer.
// @param rate              (float) Dropout rate for dropout APIs, or learning rate where used by optimizers.
// @param name              (string) Optional dropout layer name used for graph diagnostics.
export method dropout(Sequential model, float rate, string name = "dropout") =>
    int currentOutputFeatures = _sequentialOutputFeatureCount(model)
    GraphBlock block = graphBlock(name)
    int x = block.input("x")
    int y = block.dropout(x, rate, "output")
    block.output(y, currentOutputFeatures)
    model.blockArray.push(block)
    model


// @function                Appends a layer-normalization layer or graph node.
// @param model             (Sequential) Sequential model receiving the layer-normalization layer.
// @param name              (string) Optional layer-normalization name used for graph diagnostics.
export method layerNorm(Sequential model, string name = "layer_norm") =>
    int currentOutputFeatures = _sequentialOutputFeatureCount(model)
    GraphBlock block = graphBlock(name)
    int x = block.input("x")
    int y = block.layerNorm(x, DEFAULT_EPSILON, "output")
    block.output(y, currentOutputFeatures)
    model.blockArray.push(block)
    model


// @function                Reshapes, flattens, slices, or concatenates tensors while preserving value order where applicable.
// @param model             (Sequential) Sequential model receiving the flatten passthrough block.
// @param name              (string) Optional flatten block name used for graph diagnostics.
export method flatten(Sequential model, string name = "flatten") =>
    int currentOutputFeatures = _sequentialOutputFeatureCount(model)
    GraphBlock block = graphBlock(name)
    int x = block.input("x")
    block.output(x, currentOutputFeatures)
    model.blockArray.push(block)
    model


// @function                Reshapes, flattens, slices, or concatenates tensors while preserving value order where applicable.
// @param model             (Sequential) Sequential model receiving the reshape passthrough block.
// @param outputDimsArray   (array<int>) Ordered values used to build the requested tensor, shape, or configuration.
// @param name              (string) Optional reshape block name used for graph diagnostics.
export method reshape(Sequential model, array<int> outputDimsArray, string name = "reshape") =>
    int currentOutputFeatures = _sequentialOutputFeatureCount(model)
    int nextFeatureCount = _computeSize(outputDimsArray)
    if nextFeatureCount != currentOutputFeatures
        runtime.error("reshape size mismatch.")
    GraphBlock block = graphBlock(name)
    int x = block.input("x")
    block.output(x, nextFeatureCount)
    model.blockArray.push(block)
    model


// @function                Appends a prepared GraphBlock to a Sequential model.
// @param model             (Sequential) Sequential model receiving the prepared GraphBlock.
// @param graphBlock        (GraphBlock) Graph block to append to the model.
export method block(Sequential model, GraphBlock graphBlock) =>
    model.blockArray.push(_cloneBlock(graphBlock))
    model


// @function                Appends a prepared GraphBlock to a Sequential model.
// @param model             (Sequential) Sequential model receiving the prepared GraphBlock.
// @param graphBlock        (GraphBlock) Graph block to append to the model.
// @param outputDimsArray   (array<int>) Ordered values used to build the requested tensor, shape, or configuration.
export method block(Sequential model, GraphBlock graphBlock, array<int> outputDimsArray) =>
    GraphBlock blockCopy = _cloneBlock(graphBlock)
    blockCopy.outFeatures := _computeSize(outputDimsArray)
    model.blockArray.push(blockCopy)
    model


// @function                Prepares the model for training by linking the architecture with the selected optimizer and loss function parameters.
// @param model             (Sequential) Sequential model linked to the compile configuration.
// @param compileConfig     (CompileConfig) Loss, optimizer, metric, schedule, and training options for the model.
// @example
// model.compile(neuralib.compileConfig())
export method compile(Sequential model, CompileConfig compileConfig) =>
    model.compileConfig := compileConfig
    CompileConfig cfg = model.compileConfig
    model.historyBuffer := historyBuffer(cfg.historyLengthConfig)
    if not model.built
        _sequentialBuild(model, _rng(1))
    model.compiled := true
    model


// @function                Initializes all model parameters with the supplied RNG stream.
// @param model             (Sequential) Sequential model whose parameters are initialized.
// @param rng               (RngStream) Random stream used for parameter initialization.
export method build(Sequential model, RngStream rng) =>
    _sequentialBuild(model, rng)


// @function                Advances the internal state logic by applying accumulated gradients and updating network parameters.
// @param model             (Sequential) Sequential model whose accumulated gradients are applied.
export method step(Sequential model) =>
    _sequentialStep(model)


// @function                Propagates inputs forward through the computational graph to generate network predictions and intermediate activations.
// @param model             (Sequential) Sequential model used for the forward pass.
// @param inputTensor       (Tensor) Model inputs or feature values.
// @param trainingMode      (bool) When true, enables training-time behavior such as dropout.
export method forward(Sequential model, Tensor inputTensor, bool trainingMode = false) =>
    Tensor outputTensor = _runModelForwardTensor(model, inputTensor, trainingMode)
    model.lastInputTensor := inputTensor
    model.lastOutputTensor := outputTensor
    model.lastForwardTrainingMode := trainingMode
    outputTensor


// @function                Runs one supervised training pass on the supplied input and target tensors.
// @param model             (Sequential) Sequential model updated by the training batch.
// @param inputTensor       (Tensor) Model inputs or feature values.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
export method trainOnBatch(Sequential model, Tensor inputTensor, Tensor targetTensor) =>
    if not model.compiled
        model.compile(compileConfig())
    CompileConfig cfg = model.compileConfig
    if cfg.trainOnlyLastConfirmedHistoryConfig and not barstate.islastconfirmedhistory
        TrainStats stats = model.trainStats
        stats.lastStepRan := false
        model.trainStats := stats
        model
    else
        _runModelBackward(model, inputTensor, targetTensor, true)


// @function                Traverses the computational graph in reverse to compute gradients via automatic differentiation.
// @param model             (Sequential) Sequential model that receives gradients without stepping.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
export method backward(Sequential model, Tensor targetTensor) =>
    _requireInputShape(model, model.lastInputTensor, "backward")
    _runModelBackward(model, model.lastInputTensor, targetTensor, false)


// @function                Runs inference through the current model weights and returns model outputs.
// @param model             (Sequential) Sequential model used for deterministic inference.
// @param inputTensor       (Tensor) Model inputs or feature values.
// @example
// pred = model.predict(inputTensor)
export method predict(Sequential model, Tensor inputTensor) =>
    model.forward(inputTensor, false)


// @function                Runs inference through the current model weights and returns model outputs.
// @param model             (Sequential) Sequential model sampled with dropout enabled.
// @param inputTensor       (Tensor) Model inputs or feature values.
// @param samples           (simple int) Number of stochastic forward passes for Monte Carlo dropout.
export method predictMC(Sequential model, Tensor inputTensor, simple int samples = 10) =>
    int safeSamples = math.max(samples, 1)
    Tensor first = _runModelForwardTensor(model, inputTensor, true, 0)
    array<float> sumArray = _cloneFloatArray(first.valuesArray)
    array<float> sumSqArray = array.new<float>()
    for value in first.valuesArray
        sumSqArray.push(value * value)
    if safeSamples > 1
        for sampleIndex = 1 to safeSamples - 1
            Tensor sampleTensor = _runModelForwardTensor(model, inputTensor, true, sampleIndex)
            for i = 0 to sumArray.size() - 1
                float value = sampleTensor.valuesArray.get(i)
                sumArray.set(i, sumArray.get(i) + value)
                sumSqArray.set(i, sumSqArray.get(i) + value * value)
    array<float> meanArray = array.new<float>()
    array<float> varArray = array.new<float>()
    for i = 0 to sumArray.size() - 1
        float meanValue = sumArray.get(i) / safeSamples
        meanArray.push(meanValue)
        varArray.push(math.max(sumSqArray.get(i) / safeSamples - meanValue * meanValue, 0.0))
    model.lastInputTensor := inputTensor
    model.lastOutputTensor := first
    model.lastForwardTrainingMode := true
    PredictionMoments.new(Tensor.new("", meanArray, _shapeFrom(first.shape.dimsArray)), Tensor.new("", varArray, _shapeFrom(first.shape.dimsArray)), safeSamples)


// @function                Runs inference and returns the configured loss against targets.
// @param model             (Sequential) Sequential model evaluated against the supplied targets.
// @param inputTensor       (Tensor) Model inputs or feature values.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
export method evaluate(Sequential model, Tensor inputTensor, Tensor targetTensor) =>
    CompileConfig cfg = model.compileConfig
    Tensor prediction = model.predict(inputTensor)
    _requireTargetShape(prediction, targetTensor, "evaluate")
    _lossFromKind(cfg.lossKindConfig, prediction, targetTensor, cfg.reductionKindConfig)


// @function                Executes the training loop, feeding data batches through the network to iteratively improve performance metrics.
// @param model             (Sequential) Sequential model trained from the WindowDataset batch.
// @param dataset           (WindowDataset) Dataset used to produce the training batch.
// @example
// model.fitDataset(dataset)
export method fitDataset(Sequential model, WindowDataset dataset) =>
    Batch batch = dataset.toBatch()
    model.trainOnBatch(batch.inputTensor, batch.targetTensor)


// @function                Executes the training loop, feeding data batches through the network to iteratively improve performance metrics.
// @param model             (Sequential) Sequential model trained from the RollingDataset windows.
// @param dataset           (RollingDataset) Dataset used to produce the training batch.
// @param targetOffset      (simple int) Number of rows after each window used to select the target row.
export method fitRollingDataset(Sequential model, RollingDataset dataset, simple int targetOffset = 0) =>
    Batch batch = dataset.unrollBatch(targetOffset)
    model.trainOnBatch(batch.inputTensor, batch.targetTensor)


// @function                Advances the internal state logic by applying accumulated gradients and updating network parameters.
// @param model             (Sequential) Sequential model whose parameters are softly updated.
// @param sourceModel       (Sequential) Model whose parameters are copied into the target model.
// @param tau               (float) Interpolation factor for soft target updates, clamped to [0, 1].
export method softUpdateFrom(Sequential model, Sequential sourceModel, float tau) =>
    model.paramBank.softUpdateFrom(sourceModel.paramBank, tau)
    model


// @function                Returns a copy of all trainable model weights.
// @param model             (Sequential) Sequential model whose weights are copied.
export method getWeightsArray(Sequential model) =>
    _cloneFloatArray(model.paramBank.valuesArray)


// @function                Copies supplied weight values into the model parameter bank.
// @param model             (Sequential) Sequential model receiving the supplied weight values.
// @param weightsArray      (array<float>) Ordered values used to build the requested tensor, shape, or configuration.
export method setWeightsArray(Sequential model, array<float> weightsArray) =>
    int count = math.min(weightsArray.size(), model.paramBank.valuesArray.size())
    for i = 0 to count - 1
        model.paramBank.valuesArray.set(i, weightsArray.get(i))
    model


// @function                Calculates mse loss and its gradient for the supplied predictions and targets.
// @param predictionTensor  (Tensor) Model predictions to score against targets.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
// @param reductionKind     (ReductionKind) Reduction mode applied to per-element losses.
export mse(Tensor predictionTensor, Tensor targetTensor, ReductionKind reductionKind = ReductionKind.mean) =>
    _pairLossInternal(predictionTensor, targetTensor, LossKind.mse, 1.0, reductionKind)


// @function                Calculates mae loss and its gradient for the supplied predictions and targets.
// @param predictionTensor  (Tensor) Model predictions to score against targets.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
// @param reductionKind     (ReductionKind) Reduction mode applied to per-element losses.
export mae(Tensor predictionTensor, Tensor targetTensor, ReductionKind reductionKind = ReductionKind.mean) =>
    _pairLossInternal(predictionTensor, targetTensor, LossKind.mae, 1.0, reductionKind)


// @function                Calculates huber loss and its gradient for the supplied predictions and targets.
// @param predictionTensor  (Tensor) Model predictions to score against targets.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
// @param delta             (float) Huber transition point between quadratic and linear error.
// @param reductionKind     (ReductionKind) Reduction mode applied to per-element losses.
export huber(Tensor predictionTensor, Tensor targetTensor, float delta = 1.0, ReductionKind reductionKind = ReductionKind.mean) =>
    _pairLossInternal(predictionTensor, targetTensor, LossKind.huber, delta, reductionKind)


