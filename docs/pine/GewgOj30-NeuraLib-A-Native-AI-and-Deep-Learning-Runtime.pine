export method clear(RollingDataset self) =>
    self.featureStoreArray.clear()
    self.targetStoreArray.clear()
    self.rowCount := 0
    self.headIndex := 0
    self


// @function                Creates a GraphBlock input node or Sequential input shape.
// @param self              (GraphBlock) Input tensor consumed by the model or operation.
// @param name              (string) Optional name stored on the returned tensor, block, layer, or dataset.
export method input(GraphBlock self, string name = "x") =>
    int node = _blockAddOp(self, GraphOpKind.input, -1, -1, -1, 0.0, 0, 0, 0, ActivationKind.linear, InitKind.zeros, name)
    self.inputNode := node
    node


