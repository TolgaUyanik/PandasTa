// @function                Calculates quantileLoss loss and its gradient for the supplied predictions and targets.
// @param predictionTensor  (Tensor) Model predictions to score against targets.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
// @param quantile          (float) Quantile level used by pinball loss.
// @param reductionKind     (ReductionKind) Reduction mode applied to per-element losses.
export quantileLoss(Tensor predictionTensor, Tensor targetTensor, float quantile, ReductionKind reductionKind = ReductionKind.mean) =>
    _pairLossInternal(predictionTensor, targetTensor, LossKind.quantile, quantile, reductionKind)


// @function                Calculates weighted multi-horizon squared error and gradients.
// @param predictionTensor  (Tensor) Model predictions to score against targets.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
// @param horizonWeightsTensor (Tensor) Per-horizon weights applied to each prediction error.
// @param reductionKind     (ReductionKind) Reduction mode applied to per-element losses.
export multiHorizonWeighted(Tensor predictionTensor, Tensor targetTensor, Tensor horizonWeightsTensor, ReductionKind reductionKind = ReductionKind.mean) =>
    int count = _pairValueCount(predictionTensor, targetTensor)
    int weightCount = horizonWeightsTensor.valuesArray.size()
    float gradScale = _reductionGradScale(count, reductionKind)
    array<float> lossValuesArray = array.new<float>()
    array<float> gradValuesArray = array.new<float>()
    for i = 0 to count - 1
        float weight = weightCount == 0 ? 1.0 : horizonWeightsTensor.valuesArray.get(math.min(i, weightCount - 1))
        float diff = predictionTensor.valuesArray.get(i) - targetTensor.valuesArray.get(i)
        lossValuesArray.push(weight * diff * diff)
        gradValuesArray.push(2.0 * weight * diff * gradScale)
    _makeLossResult(lossValuesArray, gradValuesArray, _pairShape(predictionTensor, targetTensor, count), reductionKind)


// @function                Calculates sharpeLoss loss and its gradient for the supplied predictions and targets.
// @param predictionTensor  (Tensor) Model predictions to score against targets.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
// @param reductionKind     (ReductionKind) Reduction mode applied to per-element losses.
export sharpeLoss(Tensor predictionTensor, Tensor targetTensor, ReductionKind reductionKind = ReductionKind.mean) =>
    _sharpeLoss(predictionTensor, targetTensor, reductionKind)


// @function                Computes a metric value for predictions and targets.
// @param metricKind        (MetricKind) Loss or metric selected for model scoring.
// @param predictionTensor  (Tensor) Model predictions to score against targets.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
export metricValue(MetricKind metricKind, Tensor predictionTensor, Tensor targetTensor) =>
    _metricFromKind(metricKind, predictionTensor, targetTensor)
