export method toArray(FeatureBuilder self) =>
    _cloneFloatArray(self.valuesArray)


// @function                Returns the current number of stored values, rows, or windows.
// @param self              (FeatureBuilder) Input tensor consumed by the model or operation.
export method size(FeatureBuilder self) =>
