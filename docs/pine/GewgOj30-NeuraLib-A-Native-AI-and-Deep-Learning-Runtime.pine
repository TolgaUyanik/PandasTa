// @function                Restores scaled target values to the dataset target scale.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param targetTensor      (Tensor) Expected targets used for loss, metrics, training, or inverse scaling.
export method inverseScaleTarget(WindowDataset self, Tensor targetTensor) =>
    _applyColumnScaleProfile(targetTensor, _computeFlatScaleProfile(self.targetStoreArray, self.rowCount, self.targetCount, 0, self.rowCount, self.targetScalerKind, self.targetScalerEpsilon, self.maxRows, self.headIndex), self.targetCount, targetTensor.name, true)


// @function                Converts all stored WindowDataset rows into one scaled Batch.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
export method toBatch(WindowDataset self) =>
    Batch raw = _sliceFlatBatch(self.featureStoreArray, self.targetStoreArray, self.rowCount, self.featureCount, self.targetCount, 0, self.rowCount, self.maxRows, self.headIndex)
    _scaleBatch(raw, _computeFlatScaleProfile(self.featureStoreArray, self.rowCount, self.featureCount, 0, self.rowCount, self.inputScalerKind, self.inputScalerEpsilon, self.maxRows, self.headIndex), _computeFlatScaleProfile(self.targetStoreArray, self.rowCount, self.targetCount, 0, self.rowCount, self.targetScalerKind, self.targetScalerEpsilon, self.maxRows, self.headIndex))


// @function                Returns the most recent WindowDataset rows as one scaled Batch.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param batchSize         (simple int) Preferred mini-batch size for training configuration.
export method lastBatch(WindowDataset self, simple int batchSize) =>
    int rows = math.min(math.max(batchSize, 0), self.rowCount)
    int startRow = math.max(self.rowCount - rows, 0)
    Batch raw = _sliceFlatBatch(self.featureStoreArray, self.targetStoreArray, self.rowCount, self.featureCount, self.targetCount, startRow, rows, self.maxRows, self.headIndex)
    _scaleBatch(raw, _computeFlatScaleProfile(self.featureStoreArray, self.rowCount, self.featureCount, 0, self.rowCount, self.inputScalerKind, self.inputScalerEpsilon, self.maxRows, self.headIndex), _computeFlatScaleProfile(self.targetStoreArray, self.rowCount, self.targetCount, 0, self.rowCount, self.targetScalerKind, self.targetScalerEpsilon, self.maxRows, self.headIndex))


// @function                Returns the training portion of a WindowDataset using scaler profiles fit only on training rows.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param validationRows    (simple int) Number of final rows held out for validation.
export method trainBatch(WindowDataset self, simple int validationRows = 1) =>
    int valRows = math.min(math.max(validationRows, 0), self.rowCount)
    int rows = math.max(self.rowCount - valRows, 0)
    Batch raw = _sliceFlatBatch(self.featureStoreArray, self.targetStoreArray, self.rowCount, self.featureCount, self.targetCount, 0, rows, self.maxRows, self.headIndex)
    _scaleFlatBatchRange(raw, self.featureStoreArray, self.targetStoreArray, self.rowCount, self.featureCount, self.targetCount, rows, self.inputScalerKind, self.targetScalerKind, self.inputScalerEpsilon, self.targetScalerEpsilon, self.maxRows, self.headIndex)


// @function                Returns the held-out WindowDataset rows scaled from the training profile.
// @param self              (WindowDataset) Input tensor consumed by the model or operation.
// @param validationRows    (simple int) Number of final rows held out for validation.
export method validationBatch(WindowDataset self, simple int validationRows = 1) =>
    int valRows = math.min(math.max(validationRows, 0), self.rowCount)
    int trainRows = math.max(self.rowCount - valRows, 0)
    Batch raw = _sliceFlatBatch(self.featureStoreArray, self.targetStoreArray, self.rowCount, self.featureCount, self.targetCount, trainRows, valRows, self.maxRows, self.headIndex)
    _scaleFlatBatchRange(raw, self.featureStoreArray, self.targetStoreArray, self.rowCount, self.featureCount, self.targetCount, trainRows, self.inputScalerKind, self.targetScalerKind, self.inputScalerEpsilon, self.targetScalerEpsilon, self.maxRows, self.headIndex)


