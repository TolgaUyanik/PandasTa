//@version=6

// @description NeuraLib is a matrix-first, auto-differentiating machine learning runtime for Pine Script models, graph blocks, data processing, training, evaluation, and inference.
// It provides tensors, MatrixTensor operations, differentiable graph execution, optimizers, losses, metrics, datasets, scaling, validation splits, early stopping, and Sequential model helpers.
// Users can start with dense models or build custom architectures from the same runtime primitives used by model extensions.
library("NeuraLib", false)

const float DEFAULT_EPSILON = 1e-7
const float DEFAULT_INIT_SCALE = 0.05


export enum ActivationKind
    linear     = "Linear"
    relu       = "ReLU"
    leakyRelu  = "Leaky ReLU"
    elu        = "ELU"
    geluApprox = "GELU Approx"
    sigmoid    = "Sigmoid"
    tanh       = "Tanh"
    softplus   = "Softplus"
    swish      = "Swish"
    softmax    = "Softmax"

export enum LossKind
    mse                          = "MSE"
    mae                          = "MAE"
    huber                        = "Huber"
    logCosh                      = "LogCosh"
    binaryCrossEntropy           = "Binary Cross Entropy"
    binaryCrossEntropyFromLogits = "Binary Cross Entropy From Logits"
    categoricalCrossEntropy      = "Categorical Cross Entropy"
    softmaxCrossEntropyFromLogits = "Softmax Cross Entropy From Logits"
    directional                  = "Directional"
    quantile                     = "Quantile"
    multiHorizonWeighted         = "Multi Horizon Weighted"
    sharpe                       = "Sharpe"

export enum OptimizerKind
    sgd      = "SGD"
    momentum = "Momentum"
    rmsprop  = "RMSProp"
    adam     = "Adam"
    adamW    = "AdamW"

export enum MetricKind
    mae                 = "MAE"
    rmse                = "RMSE"
    directionalAccuracy = "Directional Accuracy"
    binaryAccuracy      = "Binary Accuracy"
    binaryAccuracyFromLogits = "Binary Accuracy From Logits"
    categoricalAccuracy = "Categorical Accuracy"
    cosineSimilarity    = "Cosine Similarity"

export enum ScalerKind
    none          = "None"
    zScore        = "Z Score"
    minMax        = "Min Max"
    runningZScore = "Running Z Score"

export enum InitKind
    zeros         = "Zeros"
    ones          = "Ones"
    uniform       = "Uniform"
    normal        = "Normal"
    xavierUniform = "Xavier Uniform"
    xavierNormal  = "Xavier Normal"
    heUniform     = "He Uniform"
    heNormal      = "He Normal"
    lecunUniform  = "Lecun Uniform"

export enum ReductionKind
    none = "None"
    mean = "Mean"
    sum  = "Sum"

export enum ScheduleKind
    constant     = "Constant"
    stepDecay    = "Step Decay"
    cosineDecay  = "Cosine Decay"
    warmupCosine = "Warmup Cosine"

export enum GraphOpKind
    input           = "Input"
    param           = "Param"
    constScalar     = "Const Scalar"
    constMatrix     = "Const Matrix"
    matmul          = "MatMul"
    add             = "Add"
    subtract        = "Subtract"
    multiply        = "Multiply"
    divide          = "Divide"
    scale           = "Scale"
    activation      = "Activation"
    softmax         = "Softmax"
    transpose       = "Transpose"
    layerNorm       = "Layer Norm"
    dropout         = "Dropout"
    causalMask      = "Causal Mask"
    sliceRows       = "Slice Rows"
    concatRows      = "Concat Rows"
    sliceCols       = "Slice Columns"
    concatCols      = "Concat Columns"
    reduceRows      = "Reduce Rows"
    reduceCols      = "Reduce Columns"
    globalAvgPool1d = "Global Avg Pool1D"
    globalMaxPool1d = "Global Max Pool1D"
    attentionScore  = "Attention Score"
    attentionApply  = "Attention Apply"
    conv1d          = "Conv1D"
    scanLstm        = "Scan LSTM"
    scanGru         = "Scan GRU"
    identity        = "Identity"

export type Shape
    array<int> dimsArray
    array<int> stridesArray
    int rank
    int size

export type Tensor
    string name
    array<float> valuesArray
    Shape shape

export type MatrixTensor
    string name
    matrix<float> valuesMatrix
    int rows
    int cols
    bool preferVector

export type RngStream
    int seed
    int state
    int streamId

export type Scaler
    ScalerKind scalerKind
    float mean
    float variance
    float minValue
    float maxValue
    float epsilon
    int samplesSeen

export type FeatureBuilder
    string name
    array<float> valuesArray
    string lastFeatureName

export type Batch
    Tensor inputTensor
    Tensor targetTensor
    int batchRows

export type EarlyStopper
    float bestValue
    int waitCount
    int patience
    float minDelta
    bool improved
    bool stopped

export type WindowDataset
    string name
    int featureCount
    int targetCount
    int maxRows
    array<float> featureStoreArray
    array<float> targetStoreArray
    int rowCount
    ScalerKind inputScalerKind
    ScalerKind targetScalerKind
    float inputScalerEpsilon
    float targetScalerEpsilon
    int headIndex = 0

export type RollingDataset
    string name
    int timeSteps
    int featureCount
    int targetCount
    int maxRows
    array<float> featureStoreArray
    array<float> targetStoreArray
    int rowCount
    ScalerKind inputScalerKind
    ScalerKind targetScalerKind
    float inputScalerEpsilon
    float targetScalerEpsilon
    int headIndex = 0

type ScaleProfile
    ScalerKind kind
    array<float> meanArray
    array<float> varianceArray
    array<float> minArray
    array<float> maxArray
    float epsilon

export type ParamRef
    string name
    int startIndex
    int length
    Shape shape

export type ParamBank
    array<float> valuesArray
    array<float> gradsArray
    array<int> startsArray
    array<int> lengthsArray

export type OptimizerState
    OptimizerKind optimizerKind
    float learningRate
    float beta1
    float beta2
    float epsilon
    float momentum
    float rho
    float weightDecay
    float clipNorm
    float clipValue
    int stepCount
    array<float> aux1Array
    array<float> aux2Array
    array<float> auxMaxArray

export type ScheduleState
    ScheduleKind scheduleKind
    float baseLearningRate
    float minLearningRate
    float gamma
    int warmupSteps
    int decaySteps

export type CompileConfig
    LossKind lossKindConfig
    OptimizerState optimizerStateConfig
    ScheduleState scheduleStateConfig
    array<MetricKind> metricArrayConfig
    ReductionKind reductionKindConfig
