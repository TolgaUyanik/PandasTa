//@version=5
library("Harmonic_Chart_Pattern_Library_TradingFinder", overlay = true)

// ZigZag Function 
ZigZag(n) =>

    Open = open
    High = high
    Low = low
    Close = close 
    Bar_Index = bar_index
    PP = n 
    var string TypePoint0 = ''
    var string TypePoint1 = ''
    var string TypePoint2 = ''
    var string TypePoint3 = ''
    var string TypePoint4 = ''
    var string TypePoint5 = ''
    var string TypePoint6 = ''
    var string TypePoint7 = ''
    var string TypePoint8 = ''
    var string TypePoint9 = ''

    var float PricePoint0 = 0.0
    var float PricePoint1 = 0.0
    var float PricePoint2 = 0.0
    var float PricePoint3 = 0.0
    var float PricePoint4 = 0.0
    var float PricePoint5 = 0.0
    var float PricePoint6 = 0.0
    var float PricePoint7 = 0.0
    var float PricePoint8 = 0.0
    var float PricePoint9 = 0.0

    var int IndexPoint0 = 0 
    var int IndexPoint1 = 0 
    var int IndexPoint2 = 0 
    var int IndexPoint3 = 0 
    var int IndexPoint4 = 0 
    var int IndexPoint5 = 0 
    var int IndexPoint6 = 0 
    var int IndexPoint7 = 0
    var int IndexPoint8 = 0 
    var int IndexPoint9 = 0

    var ArrayType = array.new_string()
    var ArrayValue = array.new_float()
    var ArrayIndex =  array.new_int()
    var Line = array.new_line()

    HighPivot = ta.pivothigh(PP,PP)
    LowPivot = ta.pivotlow(PP,PP)

    HighValue = ta.valuewhen(HighPivot ,high[PP], 0)
    LowValue = ta.valuewhen(LowPivot ,low[PP], 0)

    HighIndex = ta.valuewhen(HighPivot ,bar_index[PP], 0)
    LowIndex = ta.valuewhen(LowPivot ,bar_index[PP], 0)


    Correct_HighPivot = 0.0
    Correct_LowPivot =  0.0


    PASS = 0

    if HighPivot  and  LowPivot
        if ArrayType.size() == 0
            PASS := 1
        else if ArrayType.size() >= 1
            if ((ArrayType.get(ArrayType.size() - 1)) == "L" or
                 (ArrayType.get(ArrayType.size() - 1)) == "LL")
                if LowPivot < ArrayValue.get(ArrayType.size() - 1)
                    array.remove(ArrayType,ArrayType.size() - 1)
                    array.remove(ArrayValue,ArrayValue.size() - 1)
                    array.remove(ArrayIndex,ArrayIndex.size() - 1) 
                    array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < LowValue ? "HL" : "LL" : "L")///////////////////////////////Here
                    array.push(ArrayValue, LowValue)
                    array.push(ArrayIndex, LowIndex)
                    Correct_LowPivot :=  LowValue
                else 
                    array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < HighValue ? "HH" : "LH" : "H" ) ///////////////////////////////Here
                    array.push(ArrayValue, HighValue)
                    array.push(ArrayIndex, HighIndex)
                Correct_HighPivot := HighValue  
            else if (ArrayType.get(ArrayType.size() - 1)) == "H" or 
                 (ArrayType.get(ArrayType.size() - 1)) == "HH"
                if HighPivot > ArrayValue.get(ArrayType.size() - 1)
                    array.remove(ArrayType,ArrayType.size() - 1)
                    array.remove(ArrayValue,ArrayValue.size() - 1)
                    array.remove(ArrayIndex,ArrayIndex.size() - 1)
                    array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < HighValue ? "HH" : "LH" : "H")///////////////////////////////Here
                    array.push(ArrayValue, HighValue)
                    array.push(ArrayIndex, HighIndex)
                    Correct_HighPivot := HighValue  
                else 
                    array.push(ArrayType,ArrayType.size()>2?  ArrayValue.get(ArrayType.size() - 2) < LowValue ? "HL" : "LL" : "L")///////////////////////////////Here
                    array.push(ArrayValue, LowValue)
                    array.push(ArrayIndex, LowIndex)
                Correct_LowPivot :=  LowValue    
            else if (ArrayType.get(ArrayType.size() - 1)) == "LH"
                if HighPivot < ArrayValue.get(ArrayType.size() - 1)
                    array.push(ArrayType,ArrayType.size()>2?  ArrayValue.get(ArrayType.size() - 2) < LowValue ? "HL" : "LL" : "L")///////////////////////////////Here
                    array.push(ArrayValue, LowValue)
                    array.push(ArrayIndex, LowIndex)
                    Correct_LowPivot :=  LowValue 
                else if HighPivot > ArrayValue.get(ArrayType.size() - 1)
                    if close < ArrayValue.get(ArrayType.size() - 1)
                        array.remove(ArrayType,ArrayType.size() - 1)
                        array.remove(ArrayValue,ArrayValue.size() - 1)
                        array.remove(ArrayIndex,ArrayIndex.size() - 1)
                        array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < HighValue ? "HH" : "LH" : "H")///////////////////////////////Here
                        array.push(ArrayValue, HighValue)
                        array.push(ArrayIndex, HighIndex)
                        Correct_HighPivot := HighValue  
                    else if close > ArrayValue.get(ArrayType.size() - 1)
                        array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < LowValue ? "HL" : "LL" : "L")///////////////////////////////Here
                        array.push(ArrayValue, LowValue)
                        array.push(ArrayIndex, LowIndex)
                        Correct_LowPivot :=  LowValue
            else if (ArrayType.get(ArrayType.size() - 1)) == "HL"
                if LowPivot > ArrayValue.get(ArrayType.size() - 1)
                    array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < HighValue ? "HH" : "LH" : "H" ) ///////////////////////////////Here
                    array.push(ArrayValue, HighValue)
                    array.push(ArrayIndex, HighIndex)
                    Correct_HighPivot := HighValue                       
                else if LowPivot < ArrayValue.get(ArrayType.size() - 1)
                    if close > ArrayValue.get(ArrayType.size() - 1)
                        array.remove(ArrayType,ArrayType.size() - 1)
                        array.remove(ArrayValue,ArrayValue.size() - 1)
                        array.remove(ArrayIndex,ArrayIndex.size() - 1) 
                        array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < LowValue ? "HL" : "LL" : "L")///////////////////////////////Here
                        array.push(ArrayValue, LowValue)
                        array.push(ArrayIndex, LowIndex)
                        Correct_LowPivot :=  LowValue
                    else if close < ArrayValue.get(ArrayType.size() - 1)
                        array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < HighValue ? "HH" : "LH" : "H")///////////////////////////////Here
                        array.push(ArrayValue, HighValue)
                        array.push(ArrayIndex, HighIndex)
                        Correct_HighPivot := HighValue                         
    else if  HighPivot 
        if ArrayType.size() == 0
            array.insert(ArrayType, 0, "H")
            array.insert(ArrayValue, 0, HighValue)
            array.insert(ArrayIndex, 0, HighIndex)
            Correct_HighPivot := HighValue
        else if ArrayType.size() >= 1
            if ((ArrayType.get(ArrayType.size() - 1)) == "L" or
                 (ArrayType.get(ArrayType.size() - 1)) == "HL" or
                 (ArrayType.get(ArrayType.size() - 1)) == "LL")
                if HighPivot > ArrayValue.get(ArrayType.size() - 1)
                    array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < HighValue ? "HH" : "LH" : "H" ) ///////////////////////////////Here
                    array.push(ArrayValue, HighValue)
                    array.push(ArrayIndex, HighIndex)
                    Correct_HighPivot := HighValue
                else if  HighPivot < ArrayValue.get(ArrayType.size() - 1)
                    array.remove(ArrayType,ArrayType.size() - 1)
                    array.remove(ArrayValue,ArrayValue.size() - 1)
                    array.remove(ArrayIndex,ArrayIndex.size() - 1) 
                    array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < LowValue ? "HL" : "LL" : "L")///////////////////////////////Here
                    array.push(ArrayValue, LowValue)
                    array.push(ArrayIndex, LowIndex)
                    Correct_LowPivot :=  LowValue                         
            else if (ArrayType.get(ArrayType.size() - 1)) == "H" or 
                 (ArrayType.get(ArrayType.size() - 1)) == "HH" or 
                 (ArrayType.get(ArrayType.size() - 1)) == "LH"
                if (ArrayValue.get(ArrayValue.size() - 1)) < HighValue
                    array.remove(ArrayType,ArrayType.size() - 1)
                    array.remove(ArrayValue,ArrayValue.size() - 1)
                    array.remove(ArrayIndex,ArrayIndex.size() - 1)
                    array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < HighValue ? "HH" : "LH" : "H")///////////////////////////////Here
                    array.push(ArrayValue, HighValue)
                    array.push(ArrayIndex, HighIndex)
                    Correct_HighPivot := HighValue               
    else if LowPivot 
        if ArrayType.size() == 0
            array.insert(ArrayType, 0, "L")
            array.insert(ArrayValue, 0, LowValue)
            array.insert(ArrayIndex, 0, LowIndex)
            Correct_LowPivot :=  LowValue
        else if ArrayType.size() >= 1
            if (ArrayType.get(ArrayType.size() - 1)) == "H" or 
                 (ArrayType.get(ArrayType.size() - 1)) == "HH" or 
                 (ArrayType.get(ArrayType.size() - 1)) == "LH"
                if LowPivot < ArrayValue.get(ArrayType.size() - 1)
                    array.push(ArrayType,ArrayType.size()>2?  ArrayValue.get(ArrayType.size() - 2) < LowValue ? "HL" : "LL" : "L")///////////////////////////////Here
                    array.push(ArrayValue, LowValue)
                    array.push(ArrayIndex, LowIndex)
                    Correct_LowPivot :=  LowValue
                else if LowPivot > ArrayValue.get(ArrayType.size() - 1)
                    array.remove(ArrayType,ArrayType.size() - 1)
                    array.remove(ArrayValue,ArrayValue.size() - 1)
                    array.remove(ArrayIndex,ArrayIndex.size() - 1)
                    array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < HighValue ? "HH" : "LH" : "H")///////////////////////////////Here
                    array.push(ArrayValue, HighValue)
                    array.push(ArrayIndex, HighIndex)
                    Correct_HighPivot := HighValue                        
            else if (ArrayType.get(ArrayType.size() - 1)) == "L" or 
                 (ArrayType.get(ArrayType.size() - 1)) == "HL" or 
                 (ArrayType.get(ArrayType.size() - 1)) == "LL"
                if (ArrayValue.get(ArrayValue.size() - 1)) > LowValue
                    array.remove(ArrayType,ArrayType.size() - 1)
                    array.remove(ArrayValue,ArrayValue.size() - 1)
                    array.remove(ArrayIndex,ArrayIndex.size() - 1) 
                    array.push(ArrayType,ArrayType.size()>2? ArrayValue.get(ArrayType.size() - 2) < LowValue ? "HL" : "LL" : "L")///////////////////////////////Here
                    array.push(ArrayValue, LowValue)
                    array.push(ArrayIndex, LowIndex)
                    Correct_LowPivot :=  LowValue

    
    if ArrayType.size() > 11
        TypePoint0 := ArrayType.get(ArrayType.size() - 1)
        TypePoint1 := ArrayType.get(ArrayType.size() - 2)
        TypePoint2 := ArrayType.get(ArrayType.size() - 3)
        TypePoint3 := ArrayType.get(ArrayType.size() - 4)
        TypePoint4 := ArrayType.get(ArrayType.size() - 5)
        TypePoint5 := ArrayType.get(ArrayType.size() - 6)
        TypePoint6 := ArrayType.get(ArrayType.size() - 7)
        TypePoint7 := ArrayType.get(ArrayType.size() - 8)
        TypePoint8 := ArrayType.get(ArrayType.size() - 9)
        TypePoint9 := ArrayType.get(ArrayType.size() - 10)

        PricePoint0 := ArrayValue.get(ArrayType.size() - 1)
        PricePoint1 := ArrayValue.get(ArrayType.size() - 2)
        PricePoint2 := ArrayValue.get(ArrayType.size() - 3)
        PricePoint3 := ArrayValue.get(ArrayType.size() - 4)
        PricePoint4 := ArrayValue.get(ArrayType.size() - 5)
        PricePoint5 := ArrayValue.get(ArrayType.size() - 6)
        PricePoint6 := ArrayValue.get(ArrayType.size() - 7)
        PricePoint7 := ArrayValue.get(ArrayType.size() - 8)
        PricePoint8 := ArrayValue.get(ArrayType.size() - 9)
        PricePoint9 := ArrayValue.get(ArrayType.size() - 10)

        IndexPoint0 := ArrayIndex.get(ArrayType.size() - 1) 
        IndexPoint1 := ArrayIndex.get(ArrayType.size() - 2)
        IndexPoint2 := ArrayIndex.get(ArrayType.size() - 3) 
        IndexPoint3 := ArrayIndex.get(ArrayType.size() - 4) 
        IndexPoint4 := ArrayIndex.get(ArrayType.size() - 5) 
        IndexPoint5 := ArrayIndex.get(ArrayType.size() - 6) 
        IndexPoint6 := ArrayIndex.get(ArrayType.size() - 7) 
        IndexPoint7 := ArrayIndex.get(ArrayType.size() - 8) 
        IndexPoint8 := ArrayIndex.get(ArrayType.size() - 9) 
        IndexPoint9 := ArrayIndex.get(ArrayType.size() - 10) 
    [TypePoint0, TypePoint1, TypePoint2, TypePoint3, TypePoint4, TypePoint5, TypePoint6, TypePoint7, TypePoint8, TypePoint9, 
     PricePoint0, PricePoint1, PricePoint2, PricePoint3, PricePoint4, PricePoint5, PricePoint6, PricePoint7, PricePoint8, PricePoint9,
     IndexPoint0, IndexPoint1, IndexPoint2, IndexPoint3, IndexPoint4, IndexPoint5, IndexPoint6, IndexPoint7, IndexPoint8, IndexPoint9]


// Fibonacci Level Detector Function
Fibo(float Point_0,float Point_1,float Fibo_minRatio,float Fibo_maxRatio) =>
    var float Fibo_maxPrice = 0 
    var float Fibo_minPrice = 0 
    Delta = Point_1 - Point_0
    if Delta > 0
        Fibo_maxPrice :=  Point_0 + (Delta * Fibo_maxRatio)
        Fibo_minPrice :=  Point_0 + (Delta * Fibo_minRatio)
    else if Delta < 0 
        Fibo_minPrice :=  Point_0 - (math.abs(Delta) * Fibo_maxRatio)
        Fibo_maxPrice :=  Point_0 - (math.abs(Delta) * Fibo_minRatio)
    [Fibo_maxPrice, Fibo_minPrice]

// CandleStick Confirmation Function
CandleConfirmation(Type, MainConfirm, FP) =>
    var bool CandleConfirm = false 
    var bool Permit = true 
    Body = math.abs(close - open) / (high - low)

    if Permit and MainConfirm

        if Type == 'Bullish'
            if close > high[1] and Body > 0.6
                CandleConfirm := true
                Permit := false

        if Type == 'Bearish'
            if close < low[1] and Body > 0.6
                CandleConfirm := true
                Permit := false

    else 
        CandleConfirm := false

    if FP != FP[1]
        Permit := true
    [CandleConfirm]



// XABCD Harmonic Pattern Detector Function
export XABCD(string Name, string Type, bool Show, color Color , color Color_DPointBu, color Color_DPointBe, int LineWidth, string LabelSize  ,bool ShVF ,bool FLPC, int FLPCPeriod, int Pivot , 
 float ABXAmin, float ABXAmax, float BCABmin, float BCABmax, float CDBCmin, float CDBCmax, float CDXAmin, float CDXAmax) =>
    //Show Valid Format
    var string DT = ''
    var float DP = 0.0
    var int DI = 0
    var int FP = 0
    var bool Permit = true
    var bool Pattern = false
    var bool PatternFormation = false
    var bool Alert = false 
    var int n = 0
    if FLPC //Formation Last Pivot Confirmation
        if FLPCPeriod < Pivot
            n := FLPCPeriod
        else
            n := Pivot - 1
    HIGHEST = bar_index > n + 1 ?  ta.highest(n + 1) : high
    LOWEST  = bar_index > n + 1 ?   ta.lowest(n + 1) : low
    //Main Line
    var line XALine = na 
    var line ABLine = na 
    var line BCLine = na 
    var line CDLine = na   
    //Sub Line 
    var line XBLine = na 
    var line ACLine = na 
    var line BDLine = na 
    var line XDLine = na
    //Main Label
    var label XLabel = na 
    var label ALabel = na    
    var label BLabel = na 
    var label CLabel = na   
    var label DLabel = na 
    var label NameLabel   = na
    //Sub Label
    var label ABXALabel = na 
    var label BCABLabel = na 
    var label CDBCLabel = na 
    var label CDXALabel = na 

    
    //ZigZag Function Call
    [TypePoint0, TypePoint1, TypePoint2, TypePoint3, TypePoint4, TypePoint5, TypePoint6, TypePoint7, TypePoint8, TypePoint9, 
     PricePoint0, PricePoint1, PricePoint2, PricePoint3, PricePoint4, PricePoint5, PricePoint6, PricePoint7, PricePoint8, PricePoint9,
     IndexPoint0, IndexPoint1, IndexPoint2, IndexPoint3, IndexPoint4, IndexPoint5, IndexPoint6, IndexPoint7, IndexPoint8, IndexPoint9] = ZigZag(Pivot)
    // Necessary Point
    XT = TypePoint3
    XP = PricePoint3
    XI = IndexPoint3
    AT = TypePoint2
    AP = PricePoint2
    AI = IndexPoint2 
    BT = TypePoint1
    BP = PricePoint1
    BI = IndexPoint1
    CT = TypePoint0
    CP = PricePoint0
    CI = IndexPoint0
    //Fibonacci Level Function Call
    [ABXA_max,ABXA_min ] = Fibo(AP, XP, ABXAmin, ABXAmax)
    [BCAB_max,BCAB_min ] = Fibo(BP, AP,  BCABmin, BCABmax)
    [CDBC_max,CDBC_min ] = Fibo(CP, BP, CDBCmin, CDBCmax)
    [CDXA_max,CDXA_min ] = Fibo(AP, XP, CDXAmin, CDXAmax)

    //Bearish Pattern
    if Type == 'Bearish' 
        if ShVF  and bar_index - CI > 0 // Show Valid Format
            if ta.highest(bar_index - CI) > CDXA_max
                Permit := false
        if XP > AP and XP > BP and (BP >= ABXA_min and BP <= ABXA_max) and (CP >= BCAB_min and CP <= BCAB_max) 
            if (high >= CDBC_min and high <= CDBC_max) and (high >= CDXA_min and high <= CDXA_max)
                Pattern := true
                if Permit == true
                    DP := high
                    DI := bar_index
                    FP := XI
                    Permit := false 
            else
                Pattern := false
        if Permit[1 + n] and Pattern[n] and HIGHEST == DP and DI > CI and CI > BI and BI > AI  and Show
            XALine := line.new(XI , XP, AI, AP,width = LineWidth ,color = Color) 
            ABLine := line.new(AI , AP, BI, BP,width = LineWidth ,color = Color) 
            BCLine := line.new(BI , BP, CI, CP,width = LineWidth ,color = Color) 
            CDLine := line.new(CI , CP, DI, DP,width = LineWidth ,color = Color)
            XBLine := line.new(XI, XP, BI, BP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            ACLine := line.new(AI, AP, CI, CP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            BDLine := line.new(BI, BP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            XDLine := line.new(XI, XP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted)
            XLabel := label.new(XI , XP, 'X', textcolor = color.white,size = LabelSize,color = Color) 
            ALabel := label.new(AI , AP, 'A', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            BLabel := label.new(BI , BP, 'B', textcolor = color.white,size = LabelSize,color = Color) 
            CLabel := label.new(CI , CP, 'C', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            DLabel := label.new(DI,  DP, 'D', textcolor = color.white,size = LabelSize, color = Color_DPointBe) 
            NameLabel := label.new(BI , XP > DP ? math.avg(XP, BP) : math.avg(BP, DP) , Name , textcolor = color.white, style = label.style_label_center, size = LabelSize,color = #787b86)
            ABXALabel := label.new(math.round(math.avg(XI, BI)) ,XBLine.get_price(math.round(math.avg(XI, BI))),  str.tostring((math.abs((AP - BP) / (XP - AP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            BCABLabel := label.new(math.round(math.avg(AI, CI)) ,ACLine.get_price(math.round(math.avg(AI, CI))),  str.tostring((math.abs((BP - CP) / (AP - BP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            CDBCLabel := label.new(math.round(math.avg(BI, DI)) ,BDLine.get_price(math.round(math.avg(BI, DI))),  str.tostring((math.abs((CP - DP) / (BP - CP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize)  
            CDXALabel := label.new(math.round(math.avg(XI, DI)) ,XDLine.get_price(math.round(math.avg(XI, DI))),  str.tostring((math.abs((AP - DP) / (XP - AP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            PatternFormation := true
    //Bullish Pattern
    if Type == 'Bullish'
        if ShVF  and bar_index - CI > 0 // Show Valid Format
            if ta.lowest(bar_index - CI) < CDXA_min
                Permit := false
        if XP < AP and XP < BP and (BP >= ABXA_min and BP <= ABXA_max) and (CP >= BCAB_min and CP <= BCAB_max) 
            if (low >= CDBC_min and low <= CDBC_max) and (low >= CDXA_min and low <= CDXA_max)
                Pattern := true
                if Permit == true
                    DP := low
                    DI := bar_index
                    FP := XI                    
                    Permit := false            
            else
                Pattern := false
        if Permit[1 + n] and Pattern[n] and LOWEST == DP  and DI > CI and CI > BI and BI > AI  and Show
            XALine := line.new(XI , XP, AI, AP,width = LineWidth ,color = Color) 
            ABLine := line.new(AI , AP, BI, BP,width = LineWidth ,color = Color) 
            BCLine := line.new(BI , BP, CI, CP,width = LineWidth ,color = Color) 
            CDLine := line.new(CI , CP, DI, DP,width = LineWidth ,color = Color)
            XBLine := line.new(XI, XP, BI, BP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            ACLine := line.new(AI, AP, CI, CP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            BDLine := line.new(BI, BP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            XDLine := line.new(XI, XP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted)
            XLabel := label.new(XI , XP, 'X', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            ALabel := label.new(AI , AP, 'A', textcolor = color.white,size = LabelSize,color = Color) 
            BLabel := label.new(BI , BP, 'B', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            CLabel := label.new(CI , CP, 'C', textcolor = color.white,size = LabelSize,color = Color) 
            DLabel := label.new(DI,  DP, 'D', textcolor = color.white, style = label.style_label_up,size = LabelSize, color = Color_DPointBu)
            NameLabel := label.new(BI , XP > DP ? math.avg(DP, BP) : math.avg(XP, BP) , Name , textcolor = color.white, style = label.style_label_center, size = LabelSize,color = #787b86)
            ABXALabel := label.new(math.round(math.avg(XI, BI)) ,XBLine.get_price(math.round(math.avg(XI, BI))),  str.tostring((math.abs((AP - BP) / (XP - AP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            BCABLabel := label.new(math.round(math.avg(AI, CI)) ,ACLine.get_price(math.round(math.avg(AI, CI))),  str.tostring((math.abs((BP - CP) / (AP - BP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            CDBCLabel := label.new(math.round(math.avg(BI, DI)) ,BDLine.get_price(math.round(math.avg(BI, DI))),  str.tostring((math.abs((CP - DP) / (BP - CP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize)  
            CDXALabel := label.new(math.round(math.avg(XI, DI)) ,XDLine.get_price(math.round(math.avg(XI, DI))),  str.tostring((math.abs((AP - DP) / (XP - AP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            PatternFormation := true 
    //Reset Patterns       
    if FP != XI
        Permit := true
        PatternFormation := false 

    //CandleStick Confirmation Function Call
    [CandleConfirm] = CandleConfirmation(Type, PatternFormation, FP)

    // Formation Alert 
    if PatternFormation[1] == false and PatternFormation
        Alert := true
    else
        Alert := false

    //Return 
    [Alert, CandleConfirm]

// 0XABCD Harmonic Pattern Detector Function
export OXABCD(string Name, string Type, bool Show, color Color, color Color_DPointBu, color Color_DPointBe , int LineWidth, string LabelSize  ,bool ShVF ,bool FLPC, int FLPCPeriod, int Pivot , 
 float ABXAmin, float ABXAmax, float BCABmin, float BCABmax, float CDBCmin, float CDBCmax) =>
    //Show Valid Format
    var string DT = ''
    var float DP = 0.0
    var int DI = 0
    var int FP = 0
    var bool Permit = true
    var bool Pattern = false
    var bool PatternFormation = false
    var bool Alert = false 
    var int n = 0
    if FLPC //Formation Last Pivot Confirmation
        if FLPCPeriod < Pivot
            n := FLPCPeriod
        else
            n := Pivot - 1
    HIGHEST = bar_index > n + 1 ?  ta.highest(n + 1) : high
    LOWEST  = bar_index > n + 1 ?   ta.lowest(n + 1) : low
    //Main Line
    var line OXLine = na
    var line XALine = na 
    var line ABLine = na 
    var line BCLine = na 
    var line CDLine = na   
    //Sub Line 
    var line XBLine = na 
    var line ACLine = na 
    var line BDLine = na 
    var line XDLine = na
    //Main Label
    var label OLabel = na
    var label XLabel = na 
    var label ALabel = na    
    var label BLabel = na 
    var label CLabel = na   
    var label DLabel = na 
    var label NameLabel   = na
    //Sub Label
    var label ABXALabel = na 
    var label BCABLabel = na 
    var label CDBCLabel = na 
    var label CDXALabel = na 

    
    //ZigZag Function Call 
    [TypePoint0, TypePoint1, TypePoint2, TypePoint3, TypePoint4, TypePoint5, TypePoint6, TypePoint7, TypePoint8, TypePoint9, 
     PricePoint0, PricePoint1, PricePoint2, PricePoint3, PricePoint4, PricePoint5, PricePoint6, PricePoint7, PricePoint8, PricePoint9,
     IndexPoint0, IndexPoint1, IndexPoint2, IndexPoint3, IndexPoint4, IndexPoint5, IndexPoint6, IndexPoint7, IndexPoint8, IndexPoint9] = ZigZag(Pivot)
    // Necessary Point
    OT = TypePoint4
    OP = PricePoint4
    OI = IndexPoint4    
    XT = TypePoint3
    XP = PricePoint3
    XI = IndexPoint3
    AT = TypePoint2
    AP = PricePoint2
    AI = IndexPoint2 
    BT = TypePoint1
    BP = PricePoint1
    BI = IndexPoint1
    CT = TypePoint0
    CP = PricePoint0
    CI = IndexPoint0
    //Fibonacci Level Function Call
    [ABXA_max,ABXA_min ] = Fibo(AP, XP, ABXAmin, ABXAmax)
    [BCAB_max,BCAB_min ] = Fibo(BP, AP,  BCABmin, BCABmax)
    [CDBC_max,CDBC_min ] = Fibo(CP, BP, CDBCmin, CDBCmax)

    //Bearish Pattern
    if Type == 'Bearish' 
        if ShVF  and bar_index - CI > 0 // Show Valid Format
            if ta.highest(bar_index - CI) > CDBC_max
                Permit := false
        if  XP > OP and XP > AP and (BP >= ABXA_min and BP <= ABXA_max) and (CP >= BCAB_min and CP <= BCAB_max) //
            if (high >= CDBC_min and high <= CDBC_max) 
                Pattern := true
                if Permit == true
                    DP := high
                    DI := bar_index
                    FP := OI
                    Permit := false 
            else
                Pattern := false
        if Permit[1 + n] and Pattern[n] and HIGHEST == DP and DI > CI and CI > BI and BI > AI  and Show
            OXLine := line.new(OI , OP, XI, XP,width = LineWidth ,color = Color) 
            XALine := line.new(XI , XP, AI, AP,width = LineWidth ,color = Color) 
            ABLine := line.new(AI , AP, BI, BP,width = LineWidth ,color = Color) 
            BCLine := line.new(BI , BP, CI, CP,width = LineWidth ,color = Color) 
            CDLine := line.new(CI , CP, DI, DP,width = LineWidth ,color = Color)
            XBLine := line.new(XI, XP, BI, BP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            ACLine := line.new(AI, AP, CI, CP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            BDLine := line.new(BI, BP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            ALabel := label.new(OI , OP, '0', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            XLabel := label.new(XI , XP, 'X', textcolor = color.white,size = LabelSize,color = Color) 
            ALabel := label.new(AI , AP, 'A', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            BLabel := label.new(BI , BP, 'B', textcolor = color.white,size = LabelSize,color = Color) 
            CLabel := label.new(CI , CP, 'C', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            DLabel := label.new(DI,  DP, 'D', textcolor = color.white,size = LabelSize, color = Color_DPointBe) 
            NameLabel := label.new(AI , OP , Name , textcolor = color.white, style = label.style_label_center, size = LabelSize,color = #787b86)
            ABXALabel := label.new(math.round(math.avg(XI, BI)) ,XBLine.get_price(math.round(math.avg(XI, BI))),  str.tostring((math.abs((AP - BP) / (XP - AP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            BCABLabel := label.new(math.round(math.avg(AI, CI)) ,ACLine.get_price(math.round(math.avg(AI, CI))),  str.tostring((math.abs((BP - CP) / (AP - BP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            CDBCLabel := label.new(math.round(math.avg(BI, DI)) ,BDLine.get_price(math.round(math.avg(BI, DI))),  str.tostring((math.abs((CP - DP) / (BP - CP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize)  
            PatternFormation := true
    //Bullish Pattern
    if Type == 'Bullish'
        if ShVF  and bar_index - CI > 0 // Show Valid Format
            if ta.lowest(bar_index - CI) < CDBC_min
                Permit := false
        if XP < OP and XP < AP and (BP >= ABXA_min and BP <= ABXA_max) and (CP >= BCAB_min and CP <= BCAB_max) // 
            if (low >= CDBC_min and low <= CDBC_max) 
                Pattern := true
                if Permit == true
                    DP := low
                    DI := bar_index
                    FP := OI                    
                    Permit := false            
            else
                Pattern := false
        if Permit[1 + n] and Pattern[n] and LOWEST == DP  and DI > CI and CI > BI and BI > AI  and Show
            OXLine := line.new(OI , OP, XI, XP,width = LineWidth ,color = Color)
            XALine := line.new(XI , XP, AI, AP,width = LineWidth ,color = Color) 
            ABLine := line.new(AI , AP, BI, BP,width = LineWidth ,color = Color) 
            BCLine := line.new(BI , BP, CI, CP,width = LineWidth ,color = Color) 
            CDLine := line.new(CI , CP, DI, DP,width = LineWidth ,color = Color)
            XBLine := line.new(XI, XP, BI, BP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            ACLine := line.new(AI, AP, CI, CP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            BDLine := line.new(BI, BP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            OLabel := label.new(OI , OP, '0', textcolor = color.white,size = LabelSize,color = Color) 
            XLabel := label.new(XI , XP, 'X', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            ALabel := label.new(AI , AP, 'A', textcolor = color.white,size = LabelSize,color = Color) 
            BLabel := label.new(BI , BP, 'B', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            CLabel := label.new(CI , CP, 'C', textcolor = color.white,size = LabelSize,color = Color) 
            DLabel := label.new(DI,  DP, 'D', textcolor = color.white, style = label.style_label_up,size = LabelSize, color = Color_DPointBu) 
            NameLabel := label.new(AI , OP , Name , textcolor = color.white, style = label.style_label_center, size = LabelSize,color = #787b86)
            ABXALabel := label.new(math.round(math.avg(XI, BI)) ,XBLine.get_price(math.round(math.avg(XI, BI))),  str.tostring((math.abs((AP - BP) / (XP - AP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            BCABLabel := label.new(math.round(math.avg(AI, CI)) ,ACLine.get_price(math.round(math.avg(AI, CI))),  str.tostring((math.abs((BP - CP) / (AP - BP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            CDBCLabel := label.new(math.round(math.avg(BI, DI)) ,BDLine.get_price(math.round(math.avg(BI, DI))),  str.tostring((math.abs((CP - DP) / (BP - CP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize)  
            PatternFormation := true 
    //Reset Patterns       
    if FP != OI
        Permit := true
        PatternFormation := false 

    //CandleStick Confirmation Function Call
    [CandleConfirm] = CandleConfirmation(Type, PatternFormation, FP)

    // Formation Alert 
    if PatternFormation[1] == false and PatternFormation
        Alert := true
    else
        Alert := false

    //Return 
    [Alert, CandleConfirm]


// ABCD Harmonic Pattern Detector Function
export ABCD(string Name, string Type, bool Show, color Color, color Color_DPointBu, color Color_DPointBe , int LineWidth, string LabelSize  ,bool ShVF ,bool FLPC, int FLPCPeriod, int Pivot , 
 float BCABmin, float BCABmax, float CDBCmin, float CDBCmax) =>
    //Show Valid Format
    var string DT = ''
    var float DP = 0.0
    var int DI = 0
    var int FP = 0
    var bool Permit = true
    var bool Pattern = false
    var bool PatternFormation = false
    var bool Alert = false 
    var int n = 0
    if FLPC //Formation Last Pivot Confirmation
        if FLPCPeriod < Pivot
            n := FLPCPeriod
        else
            n := Pivot - 1
    HIGHEST = bar_index > n + 1 ?  ta.highest(n + 1) : high
    LOWEST  = bar_index > n + 1 ?   ta.lowest(n + 1) : low
    //Main Line 
    var line ABLine = na 
    var line BCLine = na 
    var line CDLine = na   
    //Sub Line 
    var line ACLine = na 
    var line BDLine = na 
    //Main Label
    var label ALabel = na    
    var label BLabel = na 
    var label CLabel = na   
    var label DLabel = na 
    var label NameLabel   = na
    //Sub Label
    var label BCABLabel = na 
    var label CDBCLabel = na 


    
    //ZigZag Function Call
    [TypePoint0, TypePoint1, TypePoint2, TypePoint3, TypePoint4, TypePoint5, TypePoint6, TypePoint7, TypePoint8, TypePoint9, 
     PricePoint0, PricePoint1, PricePoint2, PricePoint3, PricePoint4, PricePoint5, PricePoint6, PricePoint7, PricePoint8, PricePoint9,
     IndexPoint0, IndexPoint1, IndexPoint2, IndexPoint3, IndexPoint4, IndexPoint5, IndexPoint6, IndexPoint7, IndexPoint8, IndexPoint9] = ZigZag(Pivot)
    // Necessary Point
    AT = TypePoint2
    AP = PricePoint2
    AI = IndexPoint2 
    BT = TypePoint1
    BP = PricePoint1
    BI = IndexPoint1
    CT = TypePoint0
    CP = PricePoint0
    CI = IndexPoint0
    //Fibonacci Level Function Call
    [BCAB_max,BCAB_min ] = Fibo(BP, AP,  BCABmin, BCABmax)
    [CDBC_max,CDBC_min ] = Fibo(CP, BP, CDBCmin, CDBCmax)
 

    //Bearish Pattern
    if Type == 'Bearish' 
        if ShVF  and bar_index - CI > 0 // Show Valid Format
            if ta.highest(bar_index - CI) > CDBC_max
                Permit := false
        if AP < BP and (CP >= BCAB_min and CP <= BCAB_max) 
            if (high >= CDBC_min and high <= CDBC_max) 
                Pattern := true
                if Permit == true
                    DP := high
                    DI := bar_index
                    FP := AI
                    Permit := false 
            else
                Pattern := false
        if Permit[1 + n] and Pattern[n] and HIGHEST == DP and DI > CI and CI > BI and BI > AI  and ((BP - AP) * 0.975 <= (DP - CP) and (BP - AP) * 1.025 >= (DP - CP)) and Show
            ABLine := line.new(AI , AP, BI, BP,width = LineWidth ,color = Color) 
            BCLine := line.new(BI , BP, CI, CP,width = LineWidth ,color = Color) 
            CDLine := line.new(CI , CP, DI, DP,width = LineWidth ,color = Color)
            ACLine := line.new(AI, AP, CI, CP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            BDLine := line.new(BI, BP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            ALabel := label.new(AI , AP, 'A', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            BLabel := label.new(BI , BP, 'B', textcolor = color.white,size = LabelSize,color = Color) 
            CLabel := label.new(CI , CP, 'C', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            DLabel := label.new(DI,  DP, 'D', textcolor = color.white,size = LabelSize, color = Color_DPointBe) 
            NameLabel := label.new(CI , AP , Name , textcolor = color.white, style = label.style_label_center, size = LabelSize,color = #787b86)
            BCABLabel := label.new(math.round(math.avg(AI, CI)) ,ACLine.get_price(math.round(math.avg(AI, CI))),  str.tostring((math.abs((BP - CP) / (AP - BP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            CDBCLabel := label.new(math.round(math.avg(BI, DI)) ,BDLine.get_price(math.round(math.avg(BI, DI))),  str.tostring((math.abs((CP - DP) / (BP - CP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize)  
            PatternFormation := true
    //Bullish Pattern
    if Type == 'Bullish'
        if ShVF  and bar_index - CI > 0 // Show Valid Format
            if ta.lowest(bar_index - CI) < CDBC_min
                Permit := false
        if AP > BP and (CP >= BCAB_min and CP <= BCAB_max) 
            if (low >= CDBC_min and low <= CDBC_max) 
                Pattern := true
                if Permit == true
                    DP := low
                    DI := bar_index
                    FP := AI                    
                    Permit := false            
            else
                Pattern := false
        if Permit[1 + n] and Pattern[n] and LOWEST == DP  and DI > CI and CI > BI and BI > AI  and ((AP - BP) * 0.975 <= (CP - DP) and (AP - BP) * 1.025 >= (CP - DP)) and Show
            ABLine := line.new(AI , AP, BI, BP,width = LineWidth ,color = Color) 
            BCLine := line.new(BI , BP, CI, CP,width = LineWidth ,color = Color) 
            CDLine := line.new(CI , CP, DI, DP,width = LineWidth ,color = Color)
            ACLine := line.new(AI, AP, CI, CP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            BDLine := line.new(BI, BP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            ALabel := label.new(AI , AP, 'A', textcolor = color.white,size = LabelSize,color = Color) 
            BLabel := label.new(BI , BP, 'B', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            CLabel := label.new(CI , CP, 'C', textcolor = color.white,size = LabelSize,color = Color) 
            DLabel := label.new(DI,  DP, 'D', textcolor = color.white, style = label.style_label_up,size = LabelSize, color = Color_DPointBu) 
            NameLabel := label.new(CI , AP , Name , textcolor = color.white, style = label.style_label_center, size = LabelSize,color = #787b86)
            BCABLabel := label.new(math.round(math.avg(AI, CI)) ,ACLine.get_price(math.round(math.avg(AI, CI))),  str.tostring((math.abs((BP - CP) / (AP - BP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            CDBCLabel := label.new(math.round(math.avg(BI, DI)) ,BDLine.get_price(math.round(math.avg(BI, DI))),  str.tostring((math.abs((CP - DP) / (BP - CP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize)  
            PatternFormation := true 
    //Reset Patterns       
    if FP != AI
        Permit := true
        PatternFormation := false 

    //CandleStick Confirmation Function Call
    [CandleConfirm] = CandleConfirmation(Type, PatternFormation, FP)

    // Formation Alert 
    if PatternFormation[1] == false and PatternFormation
        Alert := true
    else
        Alert := false

    //Return 
    [Alert, CandleConfirm]


// Three Drive Harmonic Pattern
export ThreeDrv(string Name, string Type, bool Show, color Color, color Color_DPointBu, color Color_DPointBe , int LineWidth, string LabelSize  ,bool ShVF ,bool FLPC, int FLPCPeriod, int Pivot , 
 float a21amin, float a21amax, float b32bmin, float b32bmax) =>


    var string DT = ''
    var float DP = 0.0
    var int DI = 0
    var int FP = 0
    var bool Permit = true
    var bool Pattern = false
    var bool PatternFormation = false
    var bool Alert = false 
    var int n = 0
    if FLPC //Formation Last Pivot Confirmation
        if FLPCPeriod < Pivot
            n := FLPCPeriod
        else
            n := Pivot - 1
    HIGHEST = bar_index > n + 1 ?  ta.highest(n + 1) : high
    LOWEST  = bar_index > n + 1 ?   ta.lowest(n + 1) : low
    //Main Line
    var line OXLine = na
    var line XALine = na 
    var line ABLine = na 
    var line BCLine = na 
    var line CDLine = na   
    //Sub Line 
    var line XBLine = na 
    var line ACLine = na 
    var line BDLine = na 
    var line XDLine = na
    //Main Label
    var label XLabel = na 
    var label BLabel = na 
    var label DLabel = na 
    var label NameLabel   = na
    //Sub Label
    var label a21aLabel = na 
    var label b32bLabel = na 
 

    
    //ZigZag Function Call 
    [TypePoint0, TypePoint1, TypePoint2, TypePoint3, TypePoint4, TypePoint5, TypePoint6, TypePoint7, TypePoint8, TypePoint9, 
     PricePoint0, PricePoint1, PricePoint2, PricePoint3, PricePoint4, PricePoint5, PricePoint6, PricePoint7, PricePoint8, PricePoint9,
     IndexPoint0, IndexPoint1, IndexPoint2, IndexPoint3, IndexPoint4, IndexPoint5, IndexPoint6, IndexPoint7, IndexPoint8, IndexPoint9] = ZigZag(Pivot)
    // Necessary Point
    OT = TypePoint4
    OP = PricePoint4
    OI = IndexPoint4    
    XT = TypePoint3
    XP = PricePoint3
    XI = IndexPoint3
    AT = TypePoint2
    AP = PricePoint2
    AI = IndexPoint2 
    BT = TypePoint1
    BP = PricePoint1
    BI = IndexPoint1
    CT = TypePoint0
    CP = PricePoint0
    CI = IndexPoint0
    //Fibonacci Level Function Call
    [a21a_max,a21a_min ] = Fibo(AP, XP, a21amin, a21amax)
    [b32b_max,b32b_min ] = Fibo(CP, BP, b32bmin, b32bmax)


    //Bearish Pattern
    if Type == 'Bearish' 
        if ShVF  and bar_index - CI > 0 // Show Valid Format
            if ta.highest(bar_index - CI) > b32b_max
                Permit := false
        if  XP > OP and OP < AP and CP > AP and (ShVF ? ((XP-OP) >= (BP - AP) * 1.33) : true) and (BP >= a21a_min and BP <= a21a_max) 
            if (high >= b32b_min and high <= b32b_max) 
                Pattern := true
                if Permit == true
                    DP := high
                    DI := bar_index
                    FP := OI
                    Permit := false 
            else
                Pattern := false
        if Permit[1 + n] and Pattern[n] and HIGHEST == DP and DI > CI and CI > BI and BI > AI  and Show
            OXLine := line.new(OI , OP, XI, XP,width = LineWidth ,color = Color) 
            XALine := line.new(XI , XP, AI, AP,width = LineWidth ,color = Color) 
            ABLine := line.new(AI , AP, BI, BP,width = LineWidth ,color = Color) 
            BCLine := line.new(BI , BP, CI, CP,width = LineWidth ,color = Color) 
            CDLine := line.new(CI , CP, DI, DP,width = LineWidth ,color = Color)
            XBLine := line.new(XI, XP, BI, BP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            BDLine := line.new(BI, BP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            XLabel := label.new(XI , XP, '1', textcolor = color.white,size = LabelSize,color = Color)             
            BLabel := label.new(BI , BP, '2', textcolor = color.white,size = LabelSize,color = Color)             
            DLabel := label.new(DI,  DP, '3', textcolor = color.white,size = LabelSize, color = Color_DPointBe) 
            NameLabel := label.new(CI , AP , Name , textcolor = color.white, style = label.style_label_center, size = LabelSize,color = #787b86)
            a21aLabel := label.new(math.round(math.avg(XI, BI)) ,XBLine.get_price(math.round(math.avg(XI, BI))),  str.tostring((math.abs((AP - BP) / (XP - AP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            b32bLabel := label.new(math.round(math.avg(BI, DI)) ,BDLine.get_price(math.round(math.avg(BI, DI))),  str.tostring((math.abs((DP - CP) / (CP - BP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            PatternFormation := true
    //Bullish Pattern 
    if Type == 'Bullish'
        if ShVF  and bar_index - CI > 0 // Show Valid Format
            if ta.lowest(bar_index - CI) < b32b_min
                Permit := false
        if XP < OP and OP > AP and CP < AP and (ShVF ? ((OP-XP) >= (AP - BP) * 1.33) : true) and (BP >= a21a_min and BP <= a21a_max) 
            if (low >= b32b_min and low <= b32b_max) 
                Pattern := true
                if Permit == true
                    DP := low
                    DI := bar_index
                    FP := OI                    
                    Permit := false            
            else
                Pattern := false
        if Permit[1 + n] and Pattern[n] and LOWEST == DP  and DI > CI and CI > BI and BI > AI  and Show
            OXLine := line.new(OI , OP, XI, XP,width = LineWidth ,color = Color)
            XALine := line.new(XI , XP, AI, AP,width = LineWidth ,color = Color) 
            ABLine := line.new(AI , AP, BI, BP,width = LineWidth ,color = Color) 
            BCLine := line.new(BI , BP, CI, CP,width = LineWidth ,color = Color) 
            CDLine := line.new(CI , CP, DI, DP,width = LineWidth ,color = Color)
            XBLine := line.new(XI, XP, BI, BP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            BDLine := line.new(BI, BP, DI, DP,width =  LineWidth == 1 ? 1 : LineWidth - 1 ,color = color.new(Color,35) , style = line.style_dotted) 
            XLabel := label.new(XI , XP, '1', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            BLabel := label.new(BI , BP, '2', textcolor = color.white, style = label.style_label_up,size = LabelSize,color = Color) 
            DLabel := label.new(DI,  DP, '3', textcolor = color.white, style = label.style_label_up,size = LabelSize, color = Color_DPointBu) 
            NameLabel := label.new(CI , AP , Name , textcolor = color.white, style = label.style_label_center, size = LabelSize,color = #787b86)
            a21aLabel := label.new(math.round(math.avg(XI, BI)) ,XBLine.get_price(math.round(math.avg(XI, BI))),  str.tostring((math.abs((AP - BP) / (XP - AP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            b32bLabel := label.new(math.round(math.avg(BI, DI)) ,BDLine.get_price(math.round(math.avg(BI, DI))),  str.tostring((math.abs((DP - CP) / (CP - BP))), '#.###'),textcolor = color.white , style = label.style_label_center ,color = Color,size = LabelSize) 
            PatternFormation := true 
    //Reset Patterns       
    if FP != OI
        Permit := true
        PatternFormation := false 

    //CandleStick Confirmation Function Call
    [CandleConfirm] = CandleConfirmation(Type, PatternFormation, FP)

    // Formation Alert 
    if PatternFormation[1] == false and PatternFormation
        Alert := true
    else
        Alert := false

    //Return 
    [Alert, CandleConfirm]