//@version=6
// @description A library for risk management and position sizing calculations.
library("RiskManager")

// @function Calculates the optimal position size (number of shares/contracts) based on account risk.
// @param account_size The total account balance in your account currency (simple float).
// @param risk_pct The percentage of the account to risk per trade (simple float, e.g., 1.0 for 1%).
// @param entry_price The planned entry price for the trade (series float).
// @param stop_loss The planned stop-loss price for the trade (series float).
// @returns The calculated position size (series float). Returns 0 if stop loss equals entry price to avoid division by zero.
export calc_position_size(simple float account_size, simple float risk_pct, series float entry_price, series float stop_loss) =>
    // Step 1: Calculate the exact dollar amount we are willing to lose
    float risk_amount = account_size * (risk_pct / 100.0)
    
    // Step 2: Calculate the risk per single share/coin
    float risk_per_unit = math.abs(entry_price - stop_loss)
    
    // Step 3: Divide the total risk amount by the risk per unit to get our position size
    float position_size = risk_per_unit > 0 ? (risk_amount / risk_per_unit) : 0.0
    
    // Return the final size
    position_size