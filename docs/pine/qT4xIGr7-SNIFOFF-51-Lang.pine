            "mob_vz_mod"      => "معتدل"
            "mob_vz_low"      => "منخفض"
            => ""
    else if lang == "Italiano"
        switch key
            "x_label"         => "Coordinata X "
            "y_label"         => "Coordinata Y "
            "align_lbl"       => "Allin.: "
            "vol_title_geo"   => "VOLUME  ·  Geometria"
            "vol_title_intra" => "VOLUME  ·  Intrabar"
            "vol_valid_lbl"   => "Validi: "
            "vol_bars_lbl"    => " barre"
            "vol_lock_msg"    => "Aggiorna a Essential o superiore per sbloccare il volume intrabar"
