// ══════════════════════════════════════════════════════════════════════════════════
// 4. f_trMom — Efficiency momentum labels (4 states)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates efficiency momentum labels.
// @param en The English momentum label (Accelerating, Sharpening, Steady, Fading).
// @param lang The dashboard language.
// @returns The translated momentum label.
export f_trMom(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "Accelerating" => "Hızlanıyor"
            "Sharpening"   => "Keskinleşiyor"
            "Steady"       => "Sabit"
            "Fading"       => "Zayıflıyor"
            => en
    else if lang == "العربية"
        switch en
            "Accelerating" => "تسارع"
            "Sharpening"   => "تحسّن"
            "Steady"       => "مستقر"
            "Fading"       => "تراجع"
            => en
    else if lang == "Italiano"
        switch en
            "Accelerating" => "In accelerazione"
            "Sharpening"   => "In miglioramento"
            "Steady"       => "Stabile"
            "Fading"       => "In esaurimento"
            => en
    else
        en

