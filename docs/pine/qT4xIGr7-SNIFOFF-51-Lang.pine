// @function Translates volume scenario display labels.
// @param en The English scenario label from f_volScenarioMsg output.
// @param lang The dashboard language.
// @returns The translated scenario label.
export f_trVol(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "⚡ Full Buy Confirmation"  => "⚡ Tam Alış Onayı"
            "⚡ Full Sell Confirmation" => "⚡ Tam Satış Onayı"
            "✓ Healthy Buy Support"     => "✓ Sağlıklı Alış Desteği"
            "✓ Healthy Sell Support"    => "✓ Sağlıklı Satış Desteği"
            "◆ Weak Buy Support"        => "◆ Zayıf Alış Desteği"
            "◆ Weak Sell Support"       => "◆ Zayıf Satış Desteği"
            "⚠ Major Sell Counter"      => "⚠ Güçlü Satış Karşıtlığı"
            "⚠ Major Buy Counter"       => "⚠ Güçlü Alış Karşıtlığı"
            "⚠ Sell Pressure Growing"   => "⚠ Satış Baskısı Artıyor"
            "⚠ Buy Pressure Growing"    => "⚠ Alış Baskısı Artıyor"
            "◇ Normal Correction"       => "◇ Normal Düzeltme"
            "💥 Breakout Candidate"     => "💥 Kırılım Adayı"
            "● Dead Market"             => "● Ölü Piyasa"
            "🧲 Fair Value Magnet"      => "🧲 Adil Değer Mıknatısı"
            "🛡 Demand Absorption"      => "🛡 Talep Emilimi"
            "📤 Supply Distribution"    => "📤 Arz Dağılımı"
            "💢 Selling Capitulation"   => "💢 Satış Teslimiyeti"
            "💢 Buying Exhaustion"      => "💢 Alış Tükenmesi"
            "⚠ Volume Divergence"       => "⚠ Hacim Sapması"
            "🔍 Quiet Accumulation"     => "🔍 Sessiz Birikim"
            "🔍 Quiet Distribution"     => "🔍 Sessiz Dağıtım"
