// ══════════════════════════════════════════════════════════════════════════════════
// SNIFOFF_51_Lang — Multilingual dictionary for Smart Trader, SNIF-OFF 5.1
// Distribution: Invite-only
// Languages: English, Türkçe, العربية, Italiano
// Architecture: Each function returns English unchanged when lang == "English",
//   otherwise switch-maps to the target language. Unmapped inputs fall through
//   to English (=> en) for forward-compatibility.
// Extensibility: To add a new language, append an else-if branch to each function.
//   No changes needed in the consuming indicator.
// ══════════════════════════════════════════════════════════════════════════════════

//@version=6

// @description Multilingual translation layer for Smart Trader, SNIF-OFF 5.1, Trade Finder.
//   Provides 13 exported functions covering all dashboard labels, status badges,
//   and 3 narrative engines (trend, efficiency, volume) in 4 languages.
//   Consumed by the main indicator via import and i18n.f_*() calls.
library("SNIFOFF_51_Lang", overlay = false)

// ══════════════════════════════════════════════════════════════════════════════════
// 1. f_trSig — Trend Engine signal labels (11 states)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates trend engine signal labels from English to the selected language.
// @param en The English signal label from the _sigTxt priority chain.
// @param lang The dashboard language selected by the user.
// @returns The translated signal label string.
export f_trSig(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "⚡ Bullish Reversal Confirmed ▲" => "⚡ Yükseliş Dönüşü Onaylandı ▲"
            "⚡ Bearish Reversal Confirmed ▼" => "⚡ Düşüş Dönüşü Onaylandı ▼"
            "▲ Bullish Reversal Forming"      => "▲ Yükseliş Dönüşü Oluşuyor"
            "▼ Bearish Reversal Forming"      => "▼ Düşüş Dönüşü Oluşuyor"
            "▲▲ Strong Uptrend"               => "▲▲ Güçlü Yükseliş Trendi"
            "▼▼ Strong Downtrend"             => "▼▼ Güçlü Düşüş Trendi"
            "▲ Hidden Bullish Bias"           => "▲ Gizli Yükseliş Eğilimi"
            "▼ Hidden Bearish Bias"           => "▼ Gizli Düşüş Eğilimi"
            "▲ Uptrend Active"                => "▲ Yükseliş Trendi Aktif"
            "▼ Downtrend Active"              => "▼ Düşüş Trendi Aktif"
            "◆ No Clear Trend"                => "◆ Net Trend Yok"
            => en
    else if lang == "العربية"
        switch en
            "⚡ Bullish Reversal Confirmed ▲" => "⚡ انعكاس صعودي مؤكد ▲"
            "⚡ Bearish Reversal Confirmed ▼" => "⚡ انعكاس هبوطي مؤكد ▼"
            "▲ Bullish Reversal Forming"      => "▲ انعكاس صعودي يتشكّل"
            "▼ Bearish Reversal Forming"      => "▼ انعكاس هبوطي يتشكّل"
            "▲▲ Strong Uptrend"               => "▲▲ اتجاه صعودي قوي"
            "▼▼ Strong Downtrend"             => "▼▼ اتجاه هبوطي قوي"
            "▲ Hidden Bullish Bias"           => "▲ ميل صعودي خفي"
            "▼ Hidden Bearish Bias"           => "▼ ميل هبوطي خفي"
            "▲ Uptrend Active"                => "▲ اتجاه صعودي نشط"
            "▼ Downtrend Active"              => "▼ اتجاه هبوطي نشط"
            "◆ No Clear Trend"                => "◆ لا اتجاه واضح"
            => en
    else if lang == "Italiano"
        switch en
            "⚡ Bullish Reversal Confirmed ▲" => "⚡ Inversione Rialzista Confermata ▲"
            "⚡ Bearish Reversal Confirmed ▼" => "⚡ Inversione Ribassista Confermata ▼"
            "▲ Bullish Reversal Forming"      => "▲ Inversione Rialzista in Formazione"
            "▼ Bearish Reversal Forming"      => "▼ Inversione Ribassista in Formazione"
            "▲▲ Strong Uptrend"               => "▲▲ Forte Trend Rialzista"
            "▼▼ Strong Downtrend"             => "▼▼ Forte Trend Ribassista"
            "▲ Hidden Bullish Bias"           => "▲ Bias Rialzista Nascosto"
            "▼ Hidden Bearish Bias"           => "▼ Bias Ribassista Nascosto"
            "▲ Uptrend Active"                => "▲ Trend Rialzista Attivo"
            "▼ Downtrend Active"              => "▼ Trend Ribassista Attivo"
            "◆ No Clear Trend"                => "◆ Nessun Trend Chiaro"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 2. f_trConv — Conviction level labels (3 states)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates conviction level labels.
// @param en The English conviction label (HIGH, MODERATE, LOW).
// @param lang The dashboard language.
// @returns The translated conviction label.
export f_trConv(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "HIGH"     => "YÜKSEK"
            "MODERATE" => "ORTA"
            "LOW"      => "DÜŞÜK"
            => en
    else if lang == "العربية"
        switch en
            "HIGH"     => "عالي"
            "MODERATE" => "متوسط"
            "LOW"      => "منخفض"
            => en
    else if lang == "Italiano"
        switch en
            "HIGH"     => "ALTA"
            "MODERATE" => "MODERATA"
            "LOW"      => "BASSA"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 3. f_trCoup — Efficiency coupling labels (19 states)
