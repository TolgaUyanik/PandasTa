// @function Translates efficiency coupling labels.
// @param en The English coupling label from the _effCoupledMsg matrix.
// @param lang The dashboard language.
// @returns The translated coupling label.
export f_trCoup(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "⚡ BULL SURGE"          => "⚡ BOĞA DALGASI"
            "⚡ BEAR SURGE"          => "⚡ AYI DALGASI"
            "BULL CONFIRMED"         => "BOĞA ONAYLANDI"
            "BEAR CONFIRMED"         => "AYI ONAYLANDI"
            "Bull Active"            => "Boğa Aktif"
            "Bear Active"            => "Ayı Aktif"
            "Bull Stalling"          => "Boğa Duraklamada"
            "Bear Stalling"          => "Ayı Duraklamada"
            "⚠ STRONG BEAR COUNTER" => "⚠ GÜÇLÜ AYI KARŞITLIĞI"
            "⚠ STRONG BULL COUNTER" => "⚠ GÜÇLÜ BOĞA KARŞITLIĞI"
            "Bear Pressure"          => "Ayı Baskısı"
            "Bull Pressure"          => "Boğa Baskısı"
            "Mild Resistance"        => "Hafif Direnç"
            "Mild Support"           => "Hafif Destek"
            "Noise"                  => "Gürültü"
            "Extreme Move"           => "Aşırı Hareket"
            "Strong Move"            => "Güçlü Hareket"
            "Normal"                 => "Normal"
            "Indecisive"             => "Kararsız"
            => en
    else if lang == "العربية"
        switch en
            "⚡ BULL SURGE"          => "⚡ موجة صعود"
            "⚡ BEAR SURGE"          => "⚡ موجة هبوط"
            "BULL CONFIRMED"         => "صعود مؤكد"
            "BEAR CONFIRMED"         => "هبوط مؤكد"
            "Bull Active"            => "صعود نشط"
            "Bear Active"            => "هبوط نشط"
            "Bull Stalling"          => "صعود متوقف"
            "Bear Stalling"          => "هبوط متوقف"
            "⚠ STRONG BEAR COUNTER" => "⚠ ضغط هبوطي قوي"
            "⚠ STRONG BULL COUNTER" => "⚠ ضغط صعودي قوي"
            "Bear Pressure"          => "ضغط هبوطي"
            "Bull Pressure"          => "ضغط صعودي"
            "Mild Resistance"        => "مقاومة خفيفة"
            "Mild Support"           => "دعم خفيف"
            "Noise"                  => "ضوضاء"
            "Extreme Move"           => "حركة متطرفة"
            "Strong Move"            => "حركة قوية"
            "Normal"                 => "عادي"
            "Indecisive"             => "متردد"
            => en
    else if lang == "Italiano"
        switch en
            "⚡ BULL SURGE"          => "⚡ ONDATA RIALZISTA"
            "⚡ BEAR SURGE"          => "⚡ ONDATA RIBASSISTA"
            "BULL CONFIRMED"         => "RIALZO CONFERMATO"
            "BEAR CONFIRMED"         => "RIBASSO CONFERMATO"
            "Bull Active"            => "Rialzo Attivo"
            "Bear Active"            => "Ribasso Attivo"
            "Bull Stalling"          => "Rialzo in Stallo"
            "Bear Stalling"          => "Ribasso in Stallo"
            "⚠ STRONG BEAR COUNTER" => "⚠ FORTE CONTRASTO RIBASSISTA"
            "⚠ STRONG BULL COUNTER" => "⚠ FORTE CONTRASTO RIALZISTA"
            "Bear Pressure"          => "Pressione Ribassista"
            "Bull Pressure"          => "Pressione Rialzista"
            "Mild Resistance"        => "Lieve Resistenza"
            "Mild Support"           => "Lieve Supporto"
            "Noise"                  => "Rumore"
            "Extreme Move"           => "Movimento Estremo"
            "Strong Move"            => "Movimento Forte"
            "Normal"                 => "Normale"
            "Indecisive"             => "Indeciso"
            => en
    else
