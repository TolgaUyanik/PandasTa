    else if lang == "العربية"
        switch en
            "⚡ Full Buy Confirmation"  => "⚡ تأكيد شراء كامل"
            "⚡ Full Sell Confirmation" => "⚡ تأكيد بيع كامل"
            "✓ Healthy Buy Support"     => "✓ دعم شراء صحي"
            "✓ Healthy Sell Support"    => "✓ دعم بيع صحي"
            "◆ Weak Buy Support"        => "◆ دعم شراء ضعيف"
            "◆ Weak Sell Support"       => "◆ دعم بيع ضعيف"
            "⚠ Major Sell Counter"      => "⚠ ضغط بيع كبير"
            "⚠ Major Buy Counter"       => "⚠ ضغط شراء كبير"
            "⚠ Sell Pressure Growing"   => "⚠ ضغط البيع يتزايد"
            "⚠ Buy Pressure Growing"    => "⚠ ضغط الشراء يتزايد"
            "◇ Normal Correction"       => "◇ تصحيح عادي"
            "💥 Breakout Candidate"     => "💥 مرشح للاختراق"
            "● Dead Market"             => "● سوق ميت"
            "🧲 Fair Value Magnet"      => "🧲 مغناطيس القيمة العادلة"
            "🛡 Demand Absorption"      => "🛡 امتصاص الطلب"
            "📤 Supply Distribution"    => "📤 توزيع العرض"
            "💢 Selling Capitulation"   => "💢 استسلام البيع"
            "💢 Buying Exhaustion"      => "💢 إرهاق الشراء"
            "⚠ Volume Divergence"       => "⚠ تباين الحجم"
            "🔍 Quiet Accumulation"     => "🔍 تجميع هادئ"
            "🔍 Quiet Distribution"     => "🔍 توزيع هادئ"
            => en
    else if lang == "Italiano"
        switch en
            "⚡ Full Buy Confirmation"  => "⚡ Conferma Acquisto Totale"
            "⚡ Full Sell Confirmation" => "⚡ Conferma Vendita Totale"
            "✓ Healthy Buy Support"     => "✓ Supporto Acquisti Sano"
            "✓ Healthy Sell Support"    => "✓ Supporto Vendite Sano"
            "◆ Weak Buy Support"        => "◆ Supporto Acquisti Debole"
            "◆ Weak Sell Support"       => "◆ Supporto Vendite Debole"
            "⚠ Major Sell Counter"      => "⚠ Forte Pressione di Vendita"
            "⚠ Major Buy Counter"       => "⚠ Forte Pressione di Acquisto"
            "⚠ Sell Pressure Growing"   => "⚠ Pressione di Vendita in Aumento"
            "⚠ Buy Pressure Growing"    => "⚠ Pressione di Acquisto in Aumento"
            "◇ Normal Correction"       => "◇ Correzione Normale"
            "💥 Breakout Candidate"     => "💥 Candidato al Breakout"
            "● Dead Market"             => "● Mercato Fermo"
            "🧲 Fair Value Magnet"      => "🧲 Magnete del Valore Equo"
            "🛡 Demand Absorption"      => "🛡 Assorbimento della Domanda"
            "📤 Supply Distribution"    => "📤 Distribuzione dell'Offerta"
            "💢 Selling Capitulation"   => "💢 Capitolazione delle Vendite"
            "💢 Buying Exhaustion"      => "💢 Esaurimento degli Acquisti"
            "⚠ Volume Divergence"       => "⚠ Divergenza dei Volumi"
            "🔍 Quiet Accumulation"     => "🔍 Accumulo Silenzioso"
            "🔍 Quiet Distribution"     => "🔍 Distribuzione Silenziosa"
            => en
