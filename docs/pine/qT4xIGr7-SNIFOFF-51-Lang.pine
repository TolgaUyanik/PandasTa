// ══════════════════════════════════════════════════════════════════════════════════
// 6. f_trVolZone — Volume zone display string builder
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the directional arrow + intensity label for the volume zone cell.
// @param zone The volume zone classification (extreme/strong/normal/weak).
// @param delta The delta direction integer (+1 buyers, -1 sellers, 0 balanced).
// @param lang The dashboard language.
// @returns The composed volume zone display string.
export f_trVolZone(string zone, int delta, string lang) =>
    string _arrow = delta > 0 ? "▲ " : delta < 0 ? "▼ " : "◆ "
    string _label = ""
    if lang == "Türkçe"
        _label := zone == "extreme" ? "Patlayıcı Hacim" : zone == "strong" ? "Yüksek Hacim" : zone == "normal" ? "Orta Hacim" : "Çok Düşük Hacim"
    else if lang == "العربية"
        _label := zone == "extreme" ? "حجم انفجاري" : zone == "strong" ? "حجم مرتفع" : zone == "normal" ? "حجم معتدل" : "حجم منخفض جداً"
    else if lang == "Italiano"
        _label := zone == "extreme" ? "Volume Esplosivo" : zone == "strong" ? "Volume Elevato" : zone == "normal" ? "Volume Moderato" : "Volume Molto Basso"
    else
        _label := zone == "extreme" ? "Explosive Volume" : zone == "strong" ? "Elevated Volume" : zone == "normal" ? "Moderate Volume" : "Very Low Volume"
    _arrow + _label

// ══════════════════════════════════════════════════════════════════════════════════
// 7. f_trPocCons — POC consensus display string builder
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the volume center agreement label.
// @param count The number of agreeing scales (1-6).
// @param lang The dashboard language.
// @returns The composed POC consensus display string.
export f_trPocCons(int count, string lang) =>
    if lang == "Türkçe"
        count >= 3 ? str.tostring(count) + " / 6 Ölçek Uyumlu" : count == 2 ? "2 / 6 Ölçek Uyumlu" : "Ölçekler Uyumsuz"
    else if lang == "العربية"
        count >= 3 ? str.tostring(count) + " من 6 مقاييس متوافقة" : count == 2 ? "2 من 6 مقاييس متوافقة" : "المقاييس غير متوافقة"
    else if lang == "Italiano"
        count >= 3 ? str.tostring(count) + " su 6 Scale Concordi" : count == 2 ? "2 su 6 Scale Concordi" : "Scale Discordi"
    else
        count >= 3 ? str.tostring(count) + " of 6 Scales Agree" : count == 2 ? "2 of 6 Scales Agree" : "Scales Disagree"

// ══════════════════════════════════════════════════════════════════════════════════
// 8. f_trTitle — Dashboard section title translator (3 titles)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates dashboard module header titles.
// @param en The English section title.
// @param lang The dashboard language.
// @returns The translated section title.
export f_trTitle(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "TREND ENGINE  ·  Multi-Scale Direction" => "TREND MOTORU  ·  Çoklu Ölçek Yönü"
            "EFFICIENCY  ·  Move Quality"             => "VERİMLİLİK  ·  Hareket Kalitesi"
            "VOLUME INSIGHT  ·  Market Pressure"      => "HACİM ANALİZİ  ·  Piyasa Baskısı"
            => en
    else if lang == "العربية"
        switch en
            "TREND ENGINE  ·  Multi-Scale Direction" => "محرك الاتجاه  ·  تحليل متعدد المقاييس"
            "EFFICIENCY  ·  Move Quality"             => "الكفاءة  ·  جودة الحركة"
            "VOLUME INSIGHT  ·  Market Pressure"      => "تحليل الحجم  ·  ضغط السوق"
            => en
    else if lang == "Italiano"
        switch en
            "TREND ENGINE  ·  Multi-Scale Direction" => "MOTORE DI TREND  ·  Direzione Multi-Scala"
            "EFFICIENCY  ·  Move Quality"             => "EFFICIENZA  ·  Qualità del Movimento"
            "VOLUME INSIGHT  ·  Market Pressure"      => "ANALISI VOLUMI  ·  Pressione di Mercato"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 9. f_trBadge — Dashboard status badge translator (4 badges)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates status badge labels (ACTIVE, LOCKED, LIVE, HIST).
// @param en The English badge label.
// @param lang The dashboard language.
// @returns The translated badge label.
export f_trBadge(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "● ACTIVE" => "● AKTİF"
            "○ LOCKED" => "○ KİLİTLİ"
            "● LIVE"   => "● CANLI"
            "○ HIST"   => "○ GEÇMİŞ"
            => en
    else if lang == "العربية"
        switch en
            "● ACTIVE" => "● نشط"
            "○ LOCKED" => "○ مقفل"
            "● LIVE"   => "● مباشر"
            "○ HIST"   => "○ سابق"
            => en
    else if lang == "Italiano"
        switch en
            "● ACTIVE" => "● ATTIVO"
            "○ LOCKED" => "○ BLOCCATO"
            "● LIVE"   => "● LIVE"
            "○ HIST"   => "○ STORICO"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 10. f_trVolLabel — Volume data row labels (7 labels)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates volume data row cell labels.
// @param en The English label (Total, Buy, Sell, Group, Maximum, Minimum, Control).
// @param lang The dashboard language.
// @returns The translated data row label.
export f_trVolLabel(string en, string lang) =>
    if lang == "Türkçe"
        switch en
            "Total"   => "Toplam"
            "Buy"     => "Alış"
            "Sell"    => "Satış"
            "Group"   => "Grup"
            "Maximum" => "Maksimum"
            "Minimum" => "Minimum"
            "Control" => "Kontrol"
            => en
    else if lang == "العربية"
        switch en
            "Total"   => "إجمالي"
            "Buy"     => "شراء"
            "Sell"    => "بيع"
            "Group"   => "مجموعة"
            "Maximum" => "أقصى"
            "Minimum" => "أدنى"
            "Control" => "تحكم"
            => en
    else if lang == "Italiano"
        switch en
            "Total"   => "Totale"
            "Buy"     => "Acquisti"
            "Sell"    => "Vendite"
            "Group"   => "Gruppo"
            "Maximum" => "Massimo"
            "Minimum" => "Minimo"
            "Control" => "Controllo"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 11. f_trendNarrative — Trend situation narrative (3-part: state + structure + conviction)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds a human-readable trend situation summary for the dashboard narrative row.
// @param cas Cascade active flag.
// @param casDir Cascade direction (+1 bullish, -1 bearish).
// @param div Divergence active flag.
// @param smD Micro direction from slope engine.
// @param algn Alignment score (-6 to +6).
// @param mBias Macro bias active flag.
// @param mBiasDir Macro bias direction.
// @param conv Conviction label string (HIGH, MODERATE, LOW).
// @param lang The dashboard language.
// @returns A 3-line narrative string (state + structure + conviction).
export f_trendNarrative(bool cas, int casDir, bool div, int smD, int algn, bool mBias, int mBiasDir, string conv, string lang) =>
    bool _tr = lang == "Türkçe"
    bool _ar = lang == "العربية"
    bool _it = lang == "Italiano"
    string _p1 = ""
    if cas
        _p1 := casDir > 0 ? (_tr ? "Yükseliş dönüşü onaylandı." : _ar ? "انعكاس صعودي مؤكد." : _it ? "Inversione rialzista confermata." : "Bullish reversal confirmed.") : (_tr ? "Düşüş dönüşü onaylandı." : _ar ? "انعكاس هبوطي مؤكد." : _it ? "Inversione ribassista confermata." : "Bearish reversal confirmed.")
    else if div
        _p1 := smD > 0 ? (_tr ? "Yükseliş dönüşü oluşuyor." : _ar ? "انعكاس صعودي يتشكّل." : _it ? "Inversione rialzista in formazione." : "Bullish reversal forming.") : (_tr ? "Düşüş dönüşü oluşuyor." : _ar ? "انعكاس هبوطي يتشكّل." : _it ? "Inversione ribassista in formazione." : "Bearish reversal forming.")
    else if algn >= 5
        _p1 := _tr ? "Güçlü yükseliş trendi kuruldu." : _ar ? "اتجاه صعودي قوي مُؤسَّس." : _it ? "Forte trend rialzista consolidato." : "Strong uptrend established."
    else if algn <= -5
        _p1 := _tr ? "Güçlü düşüş trendi kuruldu." : _ar ? "اتجاه هبوطي قوي مُؤسَّس." : _it ? "Forte trend ribassista consolidato." : "Strong downtrend established."
    else if mBias
        _p1 := mBiasDir > 0 ? (_tr ? "Gizli yükseliş eğilimi tespit edildi." : _ar ? "تم رصد ميل صعودي خفي." : _it ? "Rilevato bias rialzista nascosto." : "Hidden bullish bias detected.") : (_tr ? "Gizli düşüş eğilimi tespit edildi." : _ar ? "تم رصد ميل هبوطي خفي." : _it ? "Rilevato bias ribassista nascosto." : "Hidden bearish bias detected.")
    else if algn >= 3
        _p1 := _tr ? "Yükseliş trendi aktif." : _ar ? "اتجاه صعودي نشط." : _it ? "Trend rialzista attivo." : "Uptrend active."
    else if algn <= -3
        _p1 := _tr ? "Düşüş trendi aktif." : _ar ? "اتجاه هبوطي نشط." : _it ? "Trend ribassista attivo." : "Downtrend active."
    else
        _p1 := _tr ? "Net trend yok." : _ar ? "لا اتجاه واضح." : _it ? "Nessun trend chiaro." : "No clear trend."
    string _p2 = ""
    if cas
        _p2 := casDir > 0 ? (_tr ? "Kısa ve orta vade yukarı dönerken geniş yapı hâlâ düşüş yönlü." : _ar ? "المدى القصير والمتوسط انعطف صعوداً بينما الهيكل الأوسع لا يزال هبوطياً." : _it ? "Il breve e medio termine si sono girati al rialzo mentre la struttura più ampia è ancora ribassista." : "Short and mid-term have turned up while the broader structure is still bearish.") : (_tr ? "Kısa ve orta vade aşağı dönerken geniş yapı hâlâ yükseliş yönlü." : _ar ? "المدى القصير والمتوسط انعطف هبوطاً بينما الهيكل الأوسع لا يزال صعودياً." : _it ? "Il breve e medio termine si sono girati al ribasso mentre la struttura più ampia è ancora rialzista." : "Short and mid-term have turned down while the broader structure is still bullish.")
    else if div
        _p2 := smD > 0 ? (_tr ? "Kısa vade yukarı döndü ama geniş trend henüz takip etmedi." : _ar ? "المدى القصير انعطف صعوداً لكن الاتجاه الأوسع لم يتبعه بعد." : _it ? "Il breve termine si è girato al rialzo ma il trend più ampio non ha ancora seguito." : "Short-term has turned up but the broader trend hasn't followed yet.") : (_tr ? "Kısa vade aşağı döndü ama geniş trend henüz takip etmedi." : _ar ? "المدى القصير انعطف هبوطاً لكن الاتجاه الأوسع لم يتبعه بعد." : _it ? "Il breve termine si è girato al ribasso ma il trend più ampio non ha ancora seguito." : "Short-term has turned down but the broader trend hasn't followed yet.")
    else if algn >= 5 or algn <= -5
        _p2 := _tr ? "Tüm zaman dilimlerinde neredeyse tam uzlaşı — çok net yönsel konsensüs." : _ar ? "اتفاق شبه كامل عبر جميع الأُطُر الزمنية — إجماع اتجاهي واضح جداً." : _it ? "Consenso quasi totale su tutti gli orizzonti temporali — direzione molto chiara." : "Near-total agreement across all time horizons — very clear directional consensus."
    else if mBias
        _p2 := mBiasDir > 0 ? (_tr ? "Kısa vadeli gürültü altında yatan yükseliş yönünü maskeliyor." : _ar ? "الضوضاء قصيرة المدى تُخفي الاتجاه الصعودي الكامن." : _it ? "Il rumore di breve termine maschera la direzione rialzista sottostante." : "Short-term noise is masking the underlying bullish direction.") : (_tr ? "Kısa vadeli sıçramalar altında yatan düşüş yönünü maskeliyor." : _ar ? "الارتدادات قصيرة المدى تُخفي الاتجاه الهبوطي الكامن." : _it ? "I rimbalzi di breve termine mascherano la direzione ribassista sottostante." : "Short-term bounces are masking the underlying bearish direction.")
    else if algn >= 3 or algn <= -3
        _p2 := _tr ? "Zaman dilimlerinin çoğunluğu yön konusunda hemfikir." : _ar ? "غالبية الأُطُر الزمنية متفقة على الاتجاه." : _it ? "La maggioranza degli orizzonti temporali concorda sulla direzione." : "Majority of time horizons agree on the direction."
    else
        _p2 := _tr ? "Piyasa belirgin bir yön olmadan yatay hareket ediyor." : _ar ? "السوق يتحرك جانبياً بدون اتجاه مهيمن." : _it ? "Il mercato si muove lateralmente senza una direzione dominante." : "The market is moving sideways without a dominant direction."
    string _p3 = ""
    if cas or div
        _p3 := conv == "HIGH" ? (_tr ? "Arkasındaki hareketler güçlü — ciddiye alın." : _ar ? "التحركات وراء هذا قوية — خذها بجدية." : _it ? "I movimenti dietro questo segnale sono forti — da prendere seriamente." : "The moves behind this are powerful — take it seriously.") : conv == "MODERATE" ? (_tr ? "Normal güçle gelişiyor — yakından izleyin." : _ar ? "يتطور بقوة عادية — راقب عن كثب." : _it ? "Si sviluppa con forza normale — monitorare attentamente." : "Developing with normal strength — watch closely.") : (_tr ? "Sinyal mevcut ama hareketler zayıf — teyit bekleyin." : _ar ? "الإشارة موجودة لكن التحركات ضعيفة — انتظر التأكيد." : _it ? "Il segnale è presente ma i movimenti sono deboli — attendere conferma." : "The signal is present but the moves are weak — wait for confirmation.")
    else if mBias
        _p3 := conv == "HIGH" ? (_tr ? "Altında yatan hareketler güçlü — eğilim yakında yüzeye çıkabilir." : _ar ? "التحركات الكامنة قوية — الميل قد يظهر قريباً." : _it ? "I movimenti sottostanti sono forti — il bias potrebbe emergere presto." : "The underlying moves are strong — the bias may surface soon.") : conv == "MODERATE" ? (_tr ? "Normal güç — eğilim gerçek ama acil değil." : _ar ? "قوة عادية — الميل حقيقي لكن ليس عاجلاً." : _it ? "Forza normale — il bias è reale ma non urgente." : "Normal strength — the bias is real but not urgent.") : (_tr ? "Hareketler sessiz — sabır gerekli." : _ar ? "التحركات هادئة — الصبر مطلوب." : _it ? "I movimenti sono tranquilli — serve pazienza." : "The moves are quiet — patience needed.")
    else if algn >= 3 or algn <= -3
        _p3 := conv == "HIGH" ? (_tr ? "Hareketler güçlü ve kararlı — yüksek güven." : _ar ? "التحركات قوية وحاسمة — ثقة عالية." : _it ? "Movimenti forti e decisi — alta fiducia." : "Moves are powerful and decisive — high confidence.") : conv == "MODERATE" ? (_tr ? "Normal momentum — sağlıklı ama olağanüstü değil." : _ar ? "زخم عادي — صحي لكن ليس استثنائياً." : _it ? "Momentum normale — sano ma non eccezionale." : "Normal momentum — healthy but not exceptional.") : (_tr ? "Yön var ama momentum zayıf — aşırı risk almayın." : _ar ? "الاتجاه موجود لكن الزخم ضعيف — لا تبالغ في المخاطرة." : _it ? "La direzione c'è ma il momentum è debole — non esporsi troppo." : "Direction is there but momentum is thin — don't overcommit.")
    else
        _p3 := conv == "HIGH" ? (_tr ? "Hareketler güçleniyor — kırılım yakın olabilir." : _ar ? "التحركات تكتسب قوة — اختراق قد يكون قريباً." : _it ? "I movimenti si stanno rafforzando — un breakout potrebbe essere vicino." : "Moves are gaining strength — a breakout may be near.") : conv == "MODERATE" ? (_tr ? "Dalgalı koşulların devamı beklenir." : _ar ? "توقع استمرار الظروف المتقلبة." : _it ? "Attendersi il proseguimento di condizioni instabili." : "Expect continued choppy conditions.") : (_tr ? "Zayıf, yönsüz piyasa — netlik için beklemek en iyisi." : _ar ? "سوق ضعيف بلا اتجاه — الأفضل الانتظار حتى تتضح الرؤية." : _it ? "Mercato debole e senza direzione — meglio attendere chiarezza." : "Weak, directionless market — best to wait for clarity.")
    _p1 + "\n" + _p2 + "\n" + _p3

// ══════════════════════════════════════════════════════════════════════════════════
// 12. f_effNarrative — Efficiency situation narrative (2-part: situation + trajectory)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds a human-readable efficiency situation summary.
// @param rz Rank zone string (extreme/strong/normal/weak).
// @param al Aligned flag (bar direction matches trend).
// @param op Opposed flag (bar direction opposes trend).
// @param td Trend direction (+1, -1, 0).
// @param mom Momentum label string (Accelerating, Sharpening, Steady, Fading).
// @param lang The dashboard language.
// @returns A 2-line narrative string (situation + trajectory).
export f_effNarrative(string rz, bool al, bool op, int td, string mom, string lang) =>
    bool _tr = lang == "Türkçe"
    bool _ar = lang == "العربية"
    bool _it = lang == "Italiano"
    string _sit = ""
    if al
        if rz == "extreme"
            _sit := td > 0 ? (_tr ? "Yükseliş trendini ileriye taşıyan patlayıcı hareket." : _ar ? "حركة انفجارية تدفع الاتجاه الصعودي للأمام." : _it ? "Movimento esplosivo che spinge il trend rialzista." : "Explosive move driving the uptrend forward.") : (_tr ? "Düşüş trendini ileriye taşıyan patlayıcı hareket." : _ar ? "حركة انفجارية تدفع الاتجاه الهبوطي للأمام." : _it ? "Movimento esplosivo che spinge il trend ribassista." : "Explosive move driving the downtrend forward.")
        else if rz == "strong"
            _sit := td > 0 ? (_tr ? "Yükseliş trendini destekleyen güçlü hareket." : _ar ? "حركة قوية تدعم الاتجاه الصعودي." : _it ? "Movimento forte a supporto del trend rialzista." : "Strong move supporting the uptrend.") : (_tr ? "Düşüş trendini destekleyen güçlü hareket." : _ar ? "حركة قوية تدعم الاتجاه الهبوطي." : _it ? "Movimento forte a supporto del trend ribassista." : "Strong move supporting the downtrend.")
        else if rz == "normal"
            _sit := td > 0 ? (_tr ? "Yükseliş yönünde normal hareket." : _ar ? "حركة عادية في اتجاه الصعود." : _it ? "Movimento normale in direzione rialzista." : "Normal move in uptrend direction.") : (_tr ? "Düşüş yönünde normal hareket." : _ar ? "حركة عادية في اتجاه الهبوط." : _it ? "Movimento normale in direzione ribassista." : "Normal move in downtrend direction.")
        else
            _sit := td > 0 ? (_tr ? "Yükseliş trendi zar zor ilerliyor." : _ar ? "الاتجاه الصعودي بالكاد يتقدم." : _it ? "Il trend rialzista avanza a malapena." : "The uptrend is barely making headway.") : (_tr ? "Düşüş trendi zar zor ilerliyor." : _ar ? "الاتجاه الهبوطي بالكاد يتقدم." : _it ? "Il trend ribassista avanza a malapena." : "The downtrend is barely making headway.")
    else if op
        if rz == "extreme"
            _sit := td > 0 ? (_tr ? "Yükseliş trendini tehdit eden aşırı karşı hareket." : _ar ? "حركة معاكسة متطرفة تهدد الاتجاه الصعودي." : _it ? "Contromovimento estremo che minaccia il trend rialzista." : "Extreme counter-move threatening the uptrend.") : (_tr ? "Düşüş trendini tehdit eden aşırı karşı hareket." : _ar ? "حركة معاكسة متطرفة تهدد الاتجاه الهبوطي." : _it ? "Contromovimento estremo che minaccia il trend ribassista." : "Extreme counter-move threatening the downtrend.")
        else if rz == "strong"
            _sit := td > 0 ? (_tr ? "Yükseliş trendine karşı belirgin baskı." : _ar ? "ضغط كبير ضد الاتجاه الصعودي." : _it ? "Pressione significativa contro il trend rialzista." : "Significant push against the uptrend.") : (_tr ? "Düşüş trendine karşı belirgin baskı." : _ar ? "ضغط كبير ضد الاتجاه الهبوطي." : _it ? "Pressione significativa contro il trend ribassista." : "Significant push against the downtrend.")
        else if rz == "normal"
            _sit := td > 0 ? (_tr ? "Yükseliş trendi içinde küçük geri çekilme." : _ar ? "تراجع طفيف ضمن الاتجاه الصعودي." : _it ? "Lieve ritracciamento all'interno del trend rialzista." : "Minor pullback within the uptrend.") : (_tr ? "Düşüş trendi içinde hafif sıçrama." : _ar ? "ارتداد خفيف ضمن الاتجاه الهبوطي." : _it ? "Leggero rimbalzo all'interno del trend ribassista." : "Light bounce within the downtrend.")
        else
            _sit := _tr ? "Trend karşıtı önemsiz hareket — gürültü." : _ar ? "حركة ضئيلة ضد الاتجاه — ضوضاء." : _it ? "Movimento irrilevante contro il trend — rumore." : "Negligible move against the trend — noise."
    else
        if rz == "extreme"
            _sit := _tr ? "Trendsiz piyasada patlayıcı hareket." : _ar ? "حركة انفجارية في سوق بلا اتجاه." : _it ? "Movimento esplosivo in un mercato senza trend." : "Explosive move in a trendless market."
        else if rz == "strong"
            _sit := _tr ? "Yerleşik trend olmadan güçlü hareket." : _ar ? "حركة قوية بدون اتجاه مؤسَّس." : _it ? "Movimento forte senza un trend consolidato." : "Strong move without an established trend."
        else if rz == "normal"
            _sit := _tr ? "Net trend olmadan olağan aktivite." : _ar ? "نشاط عادي بدون اتجاه واضح." : _it ? "Attività ordinaria senza un trend chiaro." : "Ordinary activity with no clear trend."
        else
            _sit := _tr ? "Düz, yönsüz piyasa." : _ar ? "سوق مسطح بلا اتجاه." : _it ? "Mercato piatto e senza direzione." : "Flat, directionless market."
    string _trj = ""
    if al
        _trj := mom == "Accelerating" ? (_tr ? "Kalite yükseliyor — güçlü devam beklenir." : _ar ? "الجودة ترتفع بسرعة — استمرار قوي متوقع." : _it ? "La qualità è in forte aumento — continuazione attesa." : "Quality surging — strong continuation expected.") : mom == "Sharpening" ? (_tr ? "Kalite artıyor — sağlıklı trend davranışı." : _ar ? "الجودة تتحسن — سلوك اتجاه صحي." : _it ? "La qualità migliora — comportamento sano del trend." : "Quality improving — healthy trend behavior.") : mom == "Steady" ? (_tr ? "Kalite istikrarlı — stres belirtisi yok." : _ar ? "الجودة مستقرة — لا علامات إجهاد." : _it ? "Qualità stabile — nessun segno di stress." : "Quality is stable — no signs of stress.") : (_tr ? "Kalite düşüyor — tükenme belirtilerine dikkat." : _ar ? "الجودة تتراجع — انتبه لعلامات الإرهاق." : _it ? "La qualità sta calando — attenzione ai segnali di esaurimento." : "Quality declining — watch for exhaustion.")
    else if op
        if rz == "weak"
            _trj := ""
        else
            _trj := mom == "Accelerating" ? (_tr ? "Kalite hızla yükseliyor — trend üzerindeki baskı artıyor." : _ar ? "الجودة ترتفع بسرعة — الضغط على الاتجاه يتزايد." : _it ? "La qualità sale rapidamente — la pressione sul trend aumenta." : "Quality rising fast — pressure on the trend is building.") : mom == "Sharpening" ? (_tr ? "Kalite yavaş yavaş artıyor — trendi dikkatle izleyin." : _ar ? "الجودة تتحسن تدريجياً — راقب الاتجاه بعناية." : _it ? "La qualità migliora gradualmente — monitorare il trend con attenzione." : "Quality gradually improving — watch the trend carefully.") : mom == "Steady" ? (_tr ? "Muhtemelen normal düzeltme, dönüş değil." : _ar ? "على الأرجح تصحيح عادي وليس انعكاساً." : _it ? "Probabilmente una correzione normale, non un'inversione." : "Likely a normal correction, not a reversal.") : (_tr ? "Kalite düşüyor — trend bunu absorbe etmeli." : _ar ? "الجودة تتراجع — الاتجاه يجب أن يمتص هذا." : _it ? "La qualità cala — il trend dovrebbe assorbire questo movimento." : "Quality fading — the trend should absorb this.")
    else
        _trj := mom == "Accelerating" ? (_tr ? "Kalite yükseliyor — yeni bir trend oluşuyor olabilir." : _ar ? "الجودة ترتفع — اتجاه جديد قد يتشكل." : _it ? "La qualità è in forte aumento — un nuovo trend potrebbe formarsi." : "Quality surging — a new trend may be forming.") : mom == "Sharpening" ? (_tr ? "Kalite yavaşça artıyor — kırılıma dikkat." : _ar ? "الجودة تتحسن ببطء — ترقب اختراقاً." : _it ? "La qualità migliora lentamente — attenzione a un possibile breakout." : "Quality slowly improving — watch for a breakout.") : mom == "Steady" ? (_tr ? "Momentum değişimi yok — katalizör bekleniyor." : _ar ? "لا تحول في الزخم — بانتظار محفز." : _it ? "Nessun cambiamento nel momentum — in attesa di un catalizzatore." : "No momentum shift — waiting for a catalyst.") : (_tr ? "Kalite düşüyor — dalgalı seyir beklenir." : _ar ? "الجودة تتراجع — توقع استمرار التقلبات." : _it ? "La qualità cala — attendersi volatilità persistente." : "Quality declining — expect continued choppy action.")
    _sit + "\n" + _trj

// ══════════════════════════════════════════════════════════════════════════════════
// 13. f_volNarrative — Volume situation narrative (3-part: what + why + outlook + live alert)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds a human-readable 3-line volume situation summary.
// @param sid Scenario ID (S1–S16).
// @param td Trend direction (+1, -1, 0).
// @param vz Volume zone string (extreme/strong/normal/weak).
// @param pocCon Volume center consensus count (0-6).
// @param pocMidPrice Consensus center price (weighted average of cluster).
// @param conv Conviction label (HIGH, MODERATE, LOW).
// @param mom Efficiency momentum label.
// @param liveAlert Explosive bar [0] volume spike flag.
// @param lang The dashboard language.
// @returns A multi-line narrative string (live alert prefix + what + why + outlook).
export f_volNarrative(string sid, int td, int pocCon, float pocMidPrice, string conv, string mom, bool liveAlert, string lang) =>
    bool _tr = lang == "Türkçe"
    bool _ar = lang == "العربية"
    bool _it = lang == "Italiano"
    string _poc = str.tostring(pocMidPrice, format.mintick)
    string _pocN = str.tostring(pocCon)
    string _p1 = switch sid
        "S1"  => td > 0 ? (_tr ? "Olağanüstü alış baskısı yükseliş trendini tamamen doğruluyor." : _ar ? "ضغط شراء استثنائي يؤكد الاتجاه الصعودي بالكامل." : _it ? "Pressione d'acquisto eccezionale conferma pienamente il trend rialzista." : "Exceptional buying pressure fully confirms the uptrend.") : (_tr ? "Olağanüstü satış baskısı düşüş trendini tamamen doğruluyor." : _ar ? "ضغط بيع استثنائي يؤكد الاتجاه الهبوطي بالكامل." : _it ? "Pressione di vendita eccezionale conferma pienamente il trend ribassista." : "Exceptional selling pressure fully confirms the downtrend.")
        "S2"  => td > 0 ? (_tr ? "Sağlam alış hacmi yükseliş trendini destekliyor." : _ar ? "حجم شراء قوي يدعم الاتجاه الصعودي." : _it ? "Solido volume d'acquisto sostiene il trend rialzista." : "Solid buying volume supports the uptrend.") : (_tr ? "Sağlam satış hacmi düşüş trendini destekliyor." : _ar ? "حجم بيع قوي يدعم الاتجاه الهبوطي." : _it ? "Solido volume di vendita sostiene il trend ribassista." : "Solid selling volume supports the downtrend.")
        "S3"  => td > 0 ? (_tr ? "Alışlar yükseliş trendini destekliyor ama hacim dikkat çekici değil." : _ar ? "الشراء يدعم الاتجاه الصعودي لكن الحجم غير ملفت." : _it ? "Gli acquisti favoriscono il trend rialzista ma il volume non è rilevante." : "Buying favors the uptrend but volume is unremarkable.") : (_tr ? "Satışlar düşüş trendini destekliyor ama hacim dikkat çekici değil." : _ar ? "البيع يدعم الاتجاه الهبوطي لكن الحجم غير ملفت." : _it ? "Le vendite favoriscono il trend ribassista ma il volume non è rilevante." : "Selling favors the downtrend but volume is unremarkable.")
        "S4"  => td > 0 ? (_tr ? "Aşırı satış baskısı yükseliş trendine karşı itiyor." : _ar ? "ضغط بيع متطرف يدفع ضد الاتجاه الصعودي." : _it ? "Pressione di vendita estrema spinge contro il trend rialzista." : "Extreme selling pressure is pushing against the uptrend.") : (_tr ? "Aşırı alış baskısı düşüş trendine karşı itiyor." : _ar ? "ضغط شراء متطرف يدفع ضد الاتجاه الهبوطي." : _it ? "Pressione d'acquisto estrema spinge contro il trend ribassista." : "Extreme buying pressure is pushing against the downtrend.")
        "S5"  => td > 0 ? (_tr ? "Yükseliş trendine karşı belirgin satış birikimi." : _ar ? "بيع كبير يتراكم ضد الاتجاه الصعودي." : _it ? "Significativo accumulo di vendite contro il trend rialzista." : "Significant selling is building against the uptrend.") : (_tr ? "Düşüş trendine karşı belirgin alış birikimi." : _ar ? "شراء كبير يتراكم ضد الاتجاه الهبوطي." : _it ? "Significativo accumulo d'acquisti contro il trend ribassista." : "Significant buying is building against the downtrend.")
        "S6"  => td > 0 ? (_tr ? "Yükseliş trendine karşı küçük satış — muhtemelen gürültü." : _ar ? "بيع طفيف ضد الاتجاه الصعودي — على الأرجح ضوضاء." : _it ? "Vendite minori contro il trend rialzista — probabilmente rumore." : "Minor selling against the uptrend — likely noise.") : (_tr ? "Düşüş trendine karşı küçük alış — muhtemelen gürültü." : _ar ? "شراء طفيف ضد الاتجاه الهبوطي — على الأرجح ضوضاء." : _it ? "Acquisti minori contro il trend ribassista — probabilmente rumore." : "Minor buying against the downtrend — likely noise.")
        "S7"  => _tr ? "Net trend olmadan aşırı tek taraflı hacim — kırılım adayı." : _ar ? "حجم متطرف من جانب واحد بدون اتجاه واضح — مرشح للاختراق." : _it ? "Volume estremo unilaterale senza trend — candidato al breakout." : "Extreme one-sided volume without a clear trend — breakout candidate."
        "S8"  => _tr ? "Hacim minimum ve dengeli — iki taraftan da anlamlı baskı yok." : _ar ? "الحجم ضئيل ومتوازن — لا ضغط ذو معنى من أي طرف." : _it ? "Volume minimo e bilanciato — nessuna pressione significativa da nessun lato." : "Volume is minimal and balanced — no meaningful pressure from either side."
        "S9"  => _tr ? "Fiyat, " + _poc + " seviyesindeki güçlü çoklu ölçekli hacim merkezinden uzaklaştı." : _ar ? "السعر ابتعد عن مركز حجم قوي متعدد المقاييس عند " + _poc + "." : _it ? "Il prezzo si è allontanato da un forte centro di volume multi-scala a " + _poc + "." : "Price has moved away from a strong multi-scale volume center at " + _poc + "."
        "S10" => _tr ? "Dip seviyelerde yoğun alış tespit edildi — talep arzı emiyor." : _ar ? "شراء كثيف مكتشف بالقرب من القيعان — الطلب يمتص العرض." : _it ? "Forti acquisti rilevati vicino ai minimi — la domanda assorbe l'offerta." : "Heavy buying detected near the lows — demand is absorbing supply."
        "S11" => _tr ? "Tepe seviyelerde yoğun satış tespit edildi — arz talebi bastırıyor." : _ar ? "بيع كثيف مكتشف بالقرب من القمم — العرض يطغى على الطلب." : _it ? "Forti vendite rilevate vicino ai massimi — l'offerta sovrasta la domanda." : "Heavy selling detected near the highs — supply is overwhelming demand."
        "S12" => _tr ? "Dip seviyelerde aşırı hacimle panik satışı — olası teslimiyet." : _ar ? "بيع ذعر بحجم متطرف قرب القيعان — استسلام محتمل." : _it ? "Vendite di panico con volume estremo vicino ai minimi — possibile capitolazione." : "Panic selling at extreme volume near the lows — possible capitulation."
        "S13" => _tr ? "Tepe seviyelerde aşırı hacimle tükenme alışı — olası zirve." : _ar ? "شراء إرهاق بحجم متطرف قرب القمم — قمة محتملة." : _it ? "Acquisti da esaurimento con volume estremo vicino ai massimi — possibile blow-off top." : "Exhaustion buying at extreme volume near the highs — possible blow-off top."
        "S14" => td > 0 ? (_tr ? "Yükseliş trendi devam ediyor ama hacim katılımı düşüyor." : _ar ? "الاتجاه الصعودي مستمر لكن مشاركة الحجم تتراجع." : _it ? "Il trend rialzista continua ma la partecipazione in volume cala." : "The uptrend continues but volume participation is declining.") : (_tr ? "Düşüş trendi devam ediyor ama hacim katılımı düşüyor." : _ar ? "الاتجاه الهبوطي مستمر لكن مشاركة الحجم تتراجع." : _it ? "Il trend ribassista continua ma la partecipazione in volume cala." : "The downtrend continues but volume participation is declining.")
        "S15" => _tr ? "Dip seviyelerde minimum dikkatle sessiz alış — olası birikim." : _ar ? "شراء هادئ قرب القيعان بأدنى اهتمام — تجميع محتمل." : _it ? "Acquisti silenziosi vicino ai minimi con minima attenzione — possibile accumulo." : "Quiet buying near the lows with minimal attention — possible accumulation."
        "S16" => _tr ? "Tepe seviyelerde minimum dikkatle sessiz satış — olası dağıtım." : _ar ? "بيع هادئ قرب القمم بأدنى اهتمام — توزيع محتمل." : _it ? "Vendite silenziose vicino ai massimi con minima attenzione — possibile distribuzione." : "Quiet selling near the highs with minimal attention — possible distribution."
        => _tr ? "Hacim koşulları dikkat çekici değil." : _ar ? "ظروف الحجم عادية." : _it ? "Le condizioni di volume non sono rilevanti." : "Volume conditions are unremarkable."
    string _p2 = switch sid
        "S1"  => _tr ? "Hacim, yakın geçmişin en üst diliminde ve tamamen trendle aynı yönde akıyor." : _ar ? "الحجم في أعلى شريحة من التاريخ الأخير ويتدفق بالكامل مع الاتجاه." : _it ? "Il volume è nella fascia più alta della storia recente e fluisce interamente con il trend." : "Volume ranks in the top tier of recent history and flows entirely with the trend."
        "S2"  => _tr ? "Hacim ortalamanın üzerinde ve sağlıklı yönsel akışta — stres belirtisi yok." : _ar ? "الحجم فوق المتوسط مع تدفق اتجاهي صحي — لا علامات إجهاد." : _it ? "Il volume è sopra la media con un flusso direzionale sano — nessun segno di stress." : "Volume is above average with healthy directional flow — no signs of stress."
        "S3"  => _tr ? "Yön doğru ama arkasındaki hacim güven vermek için yeterli değil." : _ar ? "الاتجاه صحيح لكن الحجم وراءه ليس قوياً بما يكفي لبث الثقة." : _it ? "La direzione è corretta ma il volume non è sufficiente a infondere fiducia." : "Direction is correct but volume behind it is not strong enough to inspire confidence."
        "S4"  => _tr ? "Trend karşıtı hacim aşırı seviyelere ulaştı — bu normal gürültü değil." : _ar ? "الحجم ضد الاتجاه وصل لمستويات متطرفة — هذه ليست ضوضاء عادية." : _it ? "Il volume contro il trend ha raggiunto livelli estremi — non è rumore ordinario." : "Volume against the trend has reached extreme levels — this is not normal noise."
        "S5"  => _tr ? "Karşı taraf ortalamanın üzerinde hacim taahhüdüyle güçleniyor." : _ar ? "الطرف المقابل يكتسب قوة بالتزام حجم فوق المتوسط." : _it ? "Il lato opposto guadagna forza con un impegno di volume sopra la media." : "The opposing side is gaining strength with above-average volume commitment."
        "S6"  => _tr ? "Bu karşı hareketin arkasındaki hacim zayıf — trend kolayca absorbe etmeli." : _ar ? "الحجم وراء هذه الحركة المعاكسة ضعيف — الاتجاه يجب أن يمتصها بسهولة." : _it ? "Il volume dietro questo contromovimento è debole — il trend dovrebbe assorbirlo facilmente." : "The volume behind this counter-move is weak — the trend should absorb it easily."
        "S7"  => _tr ? "Bir taraf, takip edecek yerleşik trend olmadan aşırı hacim taahhüt ediyor." : _ar ? "طرف واحد يلتزم بحجم متطرف بدون اتجاه مؤسس ليتبعه." : _it ? "Un lato sta impegnando volume estremo senza un trend consolidato da seguire." : "One side is committing extreme volume without an established trend to follow."
        "S8"  => _tr ? "Ne alıcılar ne satıcılar taahhüt ediyor — piyasa bekleme modunda." : _ar ? "لا المشترون ولا البائعون ملتزمون — السوق في وضع الانتظار." : _it ? "Né compratori né venditori si impegnano — il mercato è in modalità di attesa." : "Neither buyers nor sellers are committing — the market is in wait-and-see mode."
        "S9"  => _tr ? "6 ölçeğin " + _pocN + " tanesi hacim merkezini " + _poc + " yakınında tutuyor — bu seviye mıknatıs görevi görüyor." : _ar ? _pocN + " من 6 مقاييس لديها مركز حجمها قرب " + _poc + " — هذا المستوى يعمل كمغناطيس." : _it ? _pocN + " su 6 scale hanno il centro di volume vicino a " + _poc + " — questo livello agisce come un magnete." : _pocN + " of 6 grouping scales have their volume center near " + _poc + " — this level acts as a magnet."
        "S10" => _tr ? "En yoğun alış, fiyat aralığının alt kısmında yoğunlaşmış — alıcılar bu tabanı savunuyor." : _ar ? "أثقل شراء يتركز قرب أسفل النطاق — المشترون يدافعون عن هذا القاع." : _it ? "Gli acquisti più pesanti si concentrano nella parte bassa del range — i compratori difendono questo livello." : "The heaviest buying is concentrated near the bottom of the range — buyers are defending this floor."
        "S11" => _tr ? "En yoğun satış, fiyat aralığının üst kısmında yoğunlaşmış — satıcılar bu tavanı kısıtlıyor." : _ar ? "أثقل بيع يتركز قرب أعلى النطاق — البائعون يحدّون هذا السقف." : _it ? "Le vendite più pesanti si concentrano nella parte alta del range — i venditori limitano questo tetto." : "The heaviest selling is concentrated near the top of the range — sellers are capping this ceiling."
        "S12" => _tr ? "Maksimum satış hacmi aşırı yoğunlukla diplere vuruyor — genellikle son yıkamayı işaret eder." : _ar ? "أقصى حجم بيع يضرب القيعان بكثافة متطرفة — غالباً يشير إلى التصفية النهائية." : _it ? "Il volume massimo di vendita colpisce i minimi con intensità estrema — spesso segna il flush finale." : "Maximum selling volume is hitting the lows with extreme intensity — this often marks the final flush."
        "S13" => _tr ? "Maksimum alış hacmi aşırı yoğunlukla zirvelere vuruyor — genellikle son itişi işaret eder." : _ar ? "أقصى حجم شراء يضرب القمم بكثافة متطرفة — غالباً يشير إلى الدفعة النهائية." : _it ? "Il volume massimo d'acquisto colpisce i massimi con intensità estrema — spesso segna la spinta finale." : "Maximum buying volume is hitting the highs with extreme intensity — this often marks the final push."
        "S14" => _tr ? "Trend yapısı sağlam ama daha az katılımcı sürüyor — temel zayıflıyor." : _ar ? "هيكل الاتجاه سليم لكن عدد أقل من المشاركين يقوده — الأساس يضعف." : _it ? "La struttura del trend è intatta ma meno partecipanti lo guidano — le fondamenta si indeboliscono." : "The trend structure is intact but fewer participants are driving it — the foundation is weakening."
        "S15" => _tr ? "Çoklu ölçekli diplerde küçük ama ısrarlı alış, sessiz pozisyonlamayı işaret ediyor." : _ar ? "شراء صغير لكن مستمر قرب قيعان متعددة المقاييس يشير لتموضع هادئ." : _it ? "Acquisti piccoli ma persistenti vicino ai minimi multi-scala suggeriscono un posizionamento silenzioso." : "Small but persistent buying near multi-scale lows suggests quiet positioning."
        "S16" => _tr ? "Çoklu ölçekli zirvelerde küçük ama ısrarlı satış, sessiz çıkışı işaret ediyor." : _ar ? "بيع صغير لكن مستمر قرب قمم متعددة المقاييس يشير لتخارج هادئ." : _it ? "Vendite piccole ma persistenti vicino ai massimi multi-scala suggeriscono un disimpegno silenzioso." : "Small but persistent selling near multi-scale highs suggests quiet unwinding."
        => _tr ? "Belirgin bir hacim deseni tespit edilmedi." : _ar ? "لم يُكتشف نمط حجم مميز." : _it ? "Nessun pattern di volume distintivo rilevato." : "No distinctive volume pattern detected."
    string _p3 = switch sid
        "S1"  => conv == "HIGH" ? (_tr ? "Güçlü devam beklenir — hacim, trend ve momentum tamamen uyumlu." : _ar ? "استمرار قوي متوقع — الحجم والاتجاه والزخم متوافقون بالكامل." : _it ? "Forte continuazione attesa — volume, trend e momentum sono pienamente allineati." : "Strong continuation expected — volume, trend, and momentum are fully aligned.") : (_tr ? "Devam muhtemel ama herhangi bir hacim dönüşüne dikkat." : _ar ? "الاستمرار مرجح لكن انتبه لأي انعكاس في الحجم كتحذير." : _it ? "Continuazione probabile ma attenzione a qualsiasi inversione del volume." : "Continuation likely but watch for any volume reversal as a warning.")
        "S2"  => _tr ? "Trend devamı için sağlıklı koşullar — acil endişe yok." : _ar ? "ظروف صحية لاستمرار الاتجاه — لا مخاوف فورية." : _it ? "Condizioni sane per la continuazione del trend — nessuna preoccupazione immediata." : "Healthy conditions for trend continuation — no immediate concerns."
        "S3"  => _tr ? "Taze hacim olmadan trend durabilir — eklemeden önce daha güçlü taahhüt bekleyin." : _ar ? "الاتجاه قد يتوقف بدون حجم جديد — انتظر التزاماً أقوى قبل الإضافة." : _it ? "Il trend potrebbe arrestarsi senza volume fresco — attendere un impegno più forte prima di aggiungere." : "The trend may stall without fresh volume — wait for stronger commitment before adding."
        "S4"  => conv == "HIGH" ? (_tr ? "Trend ciddi tehdit altında — pozisyonu azaltmayı düşünün." : _ar ? "الاتجاه تحت تهديد جدي — فكر في تقليل التعرض." : _it ? "Il trend è sotto seria minaccia — considerare di ridurre l'esposizione." : "The trend is under serious threat — consider reducing exposure.") : (_tr ? "Belirgin baskı — stopları sıkılaştırın ve yakından izleyin." : _ar ? "ضغط كبير — شدّد وقف الخسارة وراقب عن كثب." : _it ? "Pressione significativa — stringere gli stop e monitorare attentamente." : "Significant pressure — tighten stops and monitor closely.")
        "S5"  => _tr ? "Mevcut trende artan risk — yeni girişlerde temkinli olun." : _ar ? "خطر متزايد على الاتجاه الحالي — كن حذراً مع الدخول الجديد." : _it ? "Rischio crescente per il trend attuale — cautela con le nuove entrate." : "Growing risk to the current trend — be cautious with new entries."
        "S6"  => _tr ? "Normal piyasa nefes alması — trend sorunsuz devam etmeli." : _ar ? "تنفس عادي للسوق — الاتجاه يجب أن يستأنف بدون مشاكل." : _it ? "Normale respiro del mercato — il trend dovrebbe riprendere senza problemi." : "Normal market breathing — the trend should resume without issue."
        "S7"  => _tr ? "Yönsel kırılımı izleyin — trend teyit edildiğinde hareket güçlü olabilir." : _ar ? "راقب اختراقاً اتجاهياً — عندما يتأكد الاتجاه قد تكون الحركة قوية." : _it ? "Monitorare un breakout direzionale — quando il trend si conferma il movimento potrebbe essere forte." : "Watch for a directional breakout — when the trend confirms, the move could be powerful."
        "S8"  => _tr ? "Şu anda avantaj yok — hacim dönene kadar sabır en iyi strateji." : _ar ? "لا ميزة حالياً — الصبر أفضل استراتيجية حتى يعود الحجم." : _it ? "Nessun vantaggio al momento — la pazienza è la migliore strategia finché il volume non ritorna." : "No edge exists right now — patience is the best strategy until volume returns."
        "S9"  => _tr ? "Taze hacim daha ileriye itmezse\nfiyatın " + _poc + " seviyesine çekilmesi beklenir." : _ar ? "توقع أن ينجذب السعر نحو " + _poc + "\nما لم يدفعه حجم جديد أبعد." : _it ? "Attendersi che il prezzo graviti verso " + _poc + "\na meno che volume fresco non lo spinga oltre." : "Expect price to gravitate toward " + _poc + "\nunless fresh volume pushes further."
        "S10" => _tr ? "Bu desteğin arkasında gerçek hacim var — buradan sıçramalar daha yüksek güvenle gelir." : _ar ? "هذا الدعم وراءه حجم حقيقي — الارتدادات من هنا تحمل ثقة أعلى." : _it ? "Questo supporto ha volume reale dietro — i rimbalzi da qui hanno maggiore affidabilità." : "This support has real volume behind it — bounces from here carry higher conviction."
        "S11" => _tr ? "Bu direncin arkasında gerçek hacim var — buradan reddedişler daha yüksek güvenle gelir." : _ar ? "هذه المقاومة وراءها حجم حقيقي — الرفض من هنا يحمل ثقة أعلى." : _it ? "Questa resistenza ha volume reale dietro — i rifiuti da qui hanno maggiore affidabilità." : "This resistance has real volume behind it — rejections from here carry higher conviction."
        "S12" => _tr ? "Aşırı panik satışı genellikle dönüşü önceler — ama önce trend teyidini bekleyin." : _ar ? "البيع الذعري المتطرف غالباً يسبق انعكاساً — لكن انتظر تأكيد الاتجاه أولاً." : _it ? "Le vendite di panico estreme spesso precedono un'inversione — ma attendere prima la conferma del trend." : "Extreme panic selling often precedes a reversal — but wait for trend confirmation first."
        "S13" => _tr ? "Aşırı coşkulu alış genellikle geri çekilmeyi önceler — kâr almayı düşünün." : _ar ? "الشراء المتحمس المتطرف غالباً يسبق تراجعاً — فكر في جني الأرباح." : _it ? "Gli acquisti euforici estremi spesso precedono un ritracciamento — considerare di prendere profitto." : "Extreme euphoric buying often precedes a pullback — consider taking profits."
        "S14" => mom == "Fading" ? (_tr ? "Hacim ve hareket kalitesi birlikte bozuluyor — trend gücünü kaybediyor." : _ar ? "الحجم وجودة الحركة كلاهما يتدهور — الاتجاه يفقد زخمه." : _it ? "Volume e qualità del movimento si deteriorano insieme — il trend perde forza." : "Volume and move quality are both deteriorating — the trend is losing steam.") : (_tr ? "Hacim inceliyor — her iki yönde hızlanmaya dikkat." : _ar ? "الحجم يتضاءل — راقب تسارعاً في أي اتجاه." : _it ? "Il volume si assottiglia — attenzione a un'accelerazione in entrambe le direzioni." : "Volume is thinning — watch for acceleration in either direction.")
        "S15" => _tr ? "Bu birikim gerçekse, trend değişimi gelişebilir — yükselen hacmi izleyin." : _ar ? "إذا كان هذا التجميع حقيقياً فقد يتطور تحول في الاتجاه — راقب ارتفاع الحجم." : _it ? "Se questo accumulo è reale, potrebbe svilupparsi un cambio di trend — monitorare il volume in aumento." : "If this accumulation is real, a trend shift may develop — watch for rising volume."
        "S16" => _tr ? "Bu dağıtım gerçekse, trend değişimi gelişebilir — yükselen hacmi izleyin." : _ar ? "إذا كان هذا التوزيع حقيقياً فقد يتطور تحول في الاتجاه — راقب ارتفاع الحجم." : _it ? "Se questa distribuzione è reale, potrebbe svilupparsi un cambio di trend — monitorare il volume in aumento." : "If this distribution is real, a trend shift may develop — watch for rising volume."
        => _tr ? "Hacim davranışındaki değişiklikleri izleyin." : _ar ? "راقب التغيرات في سلوك الحجم." : _it ? "Monitorare i cambiamenti nel comportamento del volume." : "Monitor for changes in volume behavior."
    string _live = liveAlert ? (_tr ? "🔴 CANLI UYARI: Mevcut mumda patlayıcı hacim artışı tespit edildi.\n" : _ar ? "🔴 تنبيه مباشر: ارتفاع حجم انفجاري مكتشف على الشمعة الحالية.\n" : _it ? "🔴 ALLERTA LIVE: Picco esplosivo di volume rilevato sulla candela attuale.\n" : "🔴 LIVE ALERT: Explosive volume spike detected on the current candle.\n") : ""
    str.replace_all(_live + _p1 + "\n" + _p2 + "\n" + _p3, " — ", "\n— ")

// ══════════════════════════════════════════════════════════════════════════════════
// 14. f_trTipDash — Dashboard tooltips: mobile (12) + desktop header (6)
// Keys: mob_hdr, mob_live, mob_tick, mob_price, mob_align, mob_sig, mob_conv,
//       mob_coup, mob_eta, mob_mom, mob_vscn, mob_vzone,
//       hdr, live, tick, price, xcoord, ycoord
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for dashboard-level cells.
// @param key Tooltip key identifier (see header for valid keys).
// @param lang The dashboard language selected by the user.
// @returns The translated tooltip string. Empty string for unknown keys.
export f_trTipDash(string key, string lang) =>
    if lang == "Türkçe"
        switch key
            "mob_hdr"   => "Akıllı Tüccar — kompakt mobil panel. Tüm modüllerden en önemli verileri tek bakışta gösterir."
            "mob_live"  => "Canlı durumu. Dolu nokta (●) = gerçek zamanlı mum. Boş nokta (○) = geçmiş veri."
            "mob_tick"  => "Aktif enstrüman sembolü."
            "mob_price" => "Enstrümanın yerel para biriminde son fiyat."
            "mob_align" => "Trend uyum puanı. +6 = tüm zaman dilimlerinde tam yükseliş konsensüsü. −6 = tam düşüş. 0'a yakın = net yön yok."
            "mob_sig"   => "Mevcut trend okuması. Dönüş Onaylandı = büyük dönüş. Dönüş Oluşuyor = erken sinyaller. Güçlü Yükseliş/Düşüş = çok net yön. Gizli Eğilim = gürültü arkasında yapısal eğilim. Aktif = trend mevcut. Net Trend Yok = yatay."
            "mob_conv"  => "Trendin arkasındaki hareketlerin gücü. YÜKSEK = güçlü, kararlı momentum. ORTA = normal güç. DÜŞÜK = yön var ama hareketler zayıf."
            "mob_coup"  => "Bu mumun hareket kalitesinin trendle ilişkisi. DALGA = trendle olağanüstü hareket. ONAYLANDI = sağlam uyum. Aktif = normal. Duraklamada = zayıf. Baskı/Karşıtlık = trende karşı hareket."
            "mob_eta"   => "Hareket kalitesi yüzdesi. Ok yönü gösterir: ▲ = yükseliş mumu, ▼ = düşüş mumu. Yüksek değerler = daha temiz, daha kararlı hareket."
            "mob_mom"   => "Hareket kalitesi trendi. Hızlanıyor = kalite artışı. Keskinleşiyor = kademeli iyileşme. Sabit = değişim yok. Zayıflıyor = bozulma — olası tükenme."
            "mob_vscn"  => "Mevcut hacim baskısı senaryosu. Tam Onay = hacim trendi tamamen destekliyor. Karşıtlık = hacim trende karşı. Kırılım Adayı = aşırı tek taraflı hacim. Ölü Piyasa = anlamlı aktivite yok. Hacim Sapması = trend devam ederken hacim düşüyor."
            "mob_vzone" => "Hacim yoğunluğu ve baskın taraf. ▲ = alıcılar önde, ▼ = satıcılar önde, ◆ = dengeli. Patlayıcı = en üst %5. Yüksek = en üst %25. Orta = ortalama. Düşük = en alt %25."
            "hdr"       => "Gösterge kimliği. Bu panel sıfır yeniden boyamayla yalnızca canlı hesaplamalar gösterir — değerler yalnızca gerçek zamanlı mumda güncellenir."
            "live"      => "Canlı durumu. Dolu nokta (●) = gerçek zamanlı mum aktif. Boş nokta (○) = geçmiş veri, değerler sabit."
            "tick"      => "Aktif enstrüman. $ ön eki grafikteki aktif sembolü belirtir."
            "price"     => "Piyasanın yerel para biriminde son fiyat. Her sembol, borsa ve varlık sınıfına otomatik uyum sağlar."
            "xcoord"    => "X-Koordinat — piyasanın ne kadar hareket fırsatı sunduğunu ölçer. Yüksek değerler zaman içinde daha fazla volatilite biriktiği anlamına gelir. Mevcut hareket döngüsünün olgunluğunu değerlendirmek için kullanın."
            "ycoord"    => "Y-Koordinat — başlangıçtan itibaren net fiyat hareketi. Pozitif = fiyat yukarı, negatif = aşağı. Piyasanın volatilitesini yönsel ilerlemeye ne kadar etkin dönüştürdüğünü değerlendirmek için Y'yi X ile karşılaştırın."
            => ""
    else if lang == "العربية"
        switch key
            "mob_hdr"   => "المتداول الذكي — لوحة متنقلة مدمجة. تعرض أهم البيانات من جميع الوحدات في نظرة واحدة."
            "mob_live"  => "حالة البث. النقطة الممتلئة (●) = شمعة فورية. النقطة الفارغة (○) = بيانات تاريخية."
            "mob_tick"  => "رمز الأداة النشطة."
            "mob_price" => "أحدث سعر بعملة الأداة المحلية."
            "mob_align" => "درجة توافق الاتجاه. +6 = إجماع صعودي كامل عبر جميع الأُطُر الزمنية. −6 = هبوطي كامل. قريب من 0 = لا اتجاه واضح."
            "mob_sig"   => "قراءة الاتجاه الحالية. انعكاس مؤكد = انعكاس كبير. انعكاس يتشكل = إشارات مبكرة. صعود/هبوط قوي = اتجاه واضح جداً. ميل خفي = ميل هيكلي خلف الضوضاء. نشط = اتجاه موجود. لا اتجاه واضح = جانبي."
            "mob_conv"  => "مدى قوة التحركات وراء الاتجاه. عالي = زخم قوي وحاسم. متوسط = قوة عادية. منخفض = الاتجاه موجود لكن التحركات ضعيفة."
            "mob_coup"  => "كيف ترتبط جودة حركة هذه الشمعة بالاتجاه الحالي. موجة = حركة استثنائية مع الاتجاه. مؤكد = توافق قوي. نشط = عادي. متوقف = ضعيف. ضغط/معاكسة = حركة ضد الاتجاه."
            "mob_eta"   => "نسبة جودة الحركة. السهم يشير للاتجاه: ▲ = شمعة صعودية، ▼ = شمعة هبوطية. قيم أعلى = حركة أنظف وأكثر حسماً."
            "mob_mom"   => "اتجاه جودة الحركة. تسارع = جودة مرتفعة. تحسّن = تحسن تدريجي. مستقر = ثابت. تراجع = تدهور — إرهاق محتمل."
            "mob_vscn"  => "سيناريو ضغط الحجم الحالي. تأكيد كامل = الحجم يدعم الاتجاه بالكامل. معاكسة = الحجم يعارض الاتجاه. مرشح للاختراق = حجم متطرف من جانب واحد. سوق ميت = لا نشاط ذو معنى. تباين الحجم = الاتجاه مستمر لكن الحجم يتراجع."
            "mob_vzone" => "كثافة الحجم والجانب المهيمن. ▲ = المشترون في الصدارة، ▼ = البائعون في الصدارة، ◆ = متوازن. انفجاري = أعلى 5%. مرتفع = أعلى 25%. معتدل = متوسط. منخفض = أدنى 25%."
            "hdr"       => "هوية المؤشر. تعرض هذه اللوحة حسابات فورية فقط بدون إعادة رسم — القيم تتحدث فقط على الشمعة الفورية."
            "live"      => "حالة البث. النقطة الممتلئة (●) = الشمعة الفورية نشطة. النقطة الفارغة (○) = بيانات تاريخية، القيم ثابتة."
            "tick"      => "الأداة النشطة. البادئة $ تشير إلى الرمز النشط على الرسم البياني."
            "price"     => "أحدث سعر بالعملة المحلية للسوق. يتكيف تلقائياً مع أي رمز أو بورصة أو فئة أصول."
            "xcoord"    => "إحداثي X — يقيس مقدار فرصة الحركة المتاحة في السوق. قيم أعلى تعني تراكم تقلبات أكثر بمرور الوقت. استخدمه لتقييم نضج دورة الحركة الحالية."
            "ycoord"    => "إحداثي Y — صافي حركة السعر منذ البداية. موجب = السعر ارتفع، سالب = انخفض. قارن Y مع X لتقييم مدى فعالية تحويل السوق لتقلباته إلى تقدم اتجاهي."
            => ""
    else if lang == "Italiano"
        switch key
            "mob_hdr"   => "Smart Trader — pannello mobile compatto. Mostra i dati più importanti da tutti i moduli in un colpo d'occhio."
            "mob_live"  => "Stato live. Cerchio pieno (●) = candela in tempo reale. Cerchio vuoto (○) = dati storici."
            "mob_tick"  => "Simbolo dello strumento attivo."
            "mob_price" => "Ultimo prezzo nella valuta nativa dello strumento."
            "mob_align" => "Punteggio di allineamento del trend. +6 = consenso rialzista completo su tutti gli orizzonti temporali. −6 = ribassista completo. Vicino a 0 = nessuna direzione chiara."
            "mob_sig"   => "Lettura del trend attuale. Inversione Confermata = inversione maggiore. Inversione in Formazione = segnali precoci. Forte Rialzo/Ribasso = direzione molto chiara. Bias Nascosto = inclinazione strutturale mascherata dal rumore. Attivo = trend presente. Nessun Trend Chiaro = laterale."
            "mob_conv"  => "Quanto sono potenti i movimenti dietro il trend. ALTA = momentum forte e deciso. MODERATA = forza normale. BASSA = la direzione esiste ma i movimenti sono deboli."
            "mob_coup"  => "Come la qualità del movimento di questa candela si relaziona al trend. ONDATA = movimento eccezionale con il trend. CONFERMATO = allineamento solido. Attivo = normale. In Stallo = debole. Pressione/Contrasto = movimento contro il trend."
            "mob_eta"   => "Percentuale di qualità del movimento. La freccia indica la direzione: ▲ = candela rialzista, ▼ = candela ribassista. Valori più alti = movimento più pulito e deciso."
            "mob_mom"   => "Andamento della qualità del movimento. In accelerazione = qualità in forte aumento. In miglioramento = miglioramento graduale. Stabile = nessun cambiamento. In esaurimento = deterioramento — possibile esaurimento."
            "mob_vscn"  => "Scenario di pressione del volume attuale. Conferma Totale = il volume supporta completamente il trend. Contrasto = il volume si oppone al trend. Candidato al Breakout = volume estremo unilaterale. Mercato Fermo = nessuna attività significativa. Divergenza del Volume = il trend continua ma il volume diminuisce."
            "mob_vzone" => "Intensità del volume e lato dominante. ▲ = compratori in testa, ▼ = venditori in testa, ◆ = bilanciato. Esplosivo = top 5%. Elevato = top 25%. Moderato = nella media. Basso = bottom 25%."
            "hdr"       => "Identità dell'indicatore. Questo pannello mostra solo calcoli live senza ridisegno — i valori si aggiornano esclusivamente sulla candela in tempo reale."
            "live"      => "Stato live. Cerchio pieno (●) = elaborazione attiva della candela in tempo reale. Cerchio vuoto (○) = visualizzazione di dati storici con valori congelati."
            "tick"      => "Strumento attivo. Il prefisso $ indica il ticker attivo sul grafico."
            "price"     => "Ultimo prezzo nella valuta nativa del mercato. Si adatta automaticamente a qualsiasi simbolo, borsa o classe di asset."
            "xcoord"    => "Coordinata X — misura quanta opportunità di movimento ha avuto il mercato. Valori più alti significano più volatilità accumulata nel tempo. Usala per valutare la maturità del ciclo di movimento attuale."
            "ycoord"    => "Coordinata Y — il movimento netto del prezzo dall'inizio. Positivo = il prezzo è salito, negativo = è sceso. Confronta Y con X per valutare quanto efficacemente il mercato ha convertito la sua volatilità in progresso direzionale."
            => ""
    else
        switch key
            "mob_hdr"   => "Smart Trader — compact mobile dashboard. Shows the most actionable data from all modules in one glance."
            "mob_live"  => "Live status. Filled dot (●) = realtime candle. Empty dot (○) = historical data."
            "mob_tick"  => "Active instrument ticker symbol."
            "mob_price" => "Latest price in the instrument's native currency."
            "mob_align" => "Trend alignment score. +6 = full bullish consensus across all time horizons. −6 = full bearish. Near 0 = no clear direction."
            "mob_sig"   => "Current trend reading. Reversal Confirmed = major reversal. Reversal Forming = early signs. Strong Up/Downtrend = very clear direction. Hidden Bias = structural tilt masked by noise. Active = trend present. No Clear Trend = sideways."
            "mob_conv"  => "How powerful the moves behind the trend are. HIGH = strong, decisive momentum. MODERATE = normal strength. LOW = direction exists but moves are weak."
            "mob_coup"  => "How this candle's move quality relates to the current trend. SURGE = exceptional with-trend move. CONFIRMED = solid alignment. Active = normal. Stalling = weak. Pressure/Counter = move opposing the trend."
            "mob_eta"   => "Move quality percentage. Arrow shows direction: ▲ = bullish bar, ▼ = bearish bar. Higher values = cleaner, more decisive move."
            "mob_mom"   => "Move quality trend. Accelerating = surging quality. Sharpening = gradually improving. Steady = stable. Fading = deteriorating — possible exhaustion."
            "mob_vscn"  => "Current volume pressure scenario. Full Confirmation = volume fully supports trend. Counter = volume fights trend. Breakout Candidate = extreme one-sided volume. Dead Market = no meaningful activity. Volume Divergence = trend continues but volume declining."
            "mob_vzone" => "Volume intensity and dominant side. ▲ = buyers lead, ▼ = sellers lead, ◆ = balanced. Explosive = top 5%. Elevated = top 25%. Moderate = average. Low = bottom 25%."
            "hdr"       => "Indicator identity. This panel shows live-only calculations with zero repaint — values update exclusively on the realtime candle."
            "live"      => "Live status. Filled dot (●) = actively processing the current realtime candle. Empty dot (○) = viewing historical data where values are frozen."
            "tick"      => "Current instrument. The $ prefix denotes the active ticker on your chart."
            "price"     => "Latest price in the native currency of the market. Automatically adapts to any symbol, exchange, or asset class."
            "xcoord"    => "X-Coordinate — measures how much movement opportunity the market has had. Higher values mean more volatility has accumulated over time. Use this to assess how mature the current move cycle is."
            "ycoord"    => "Y-Coordinate — the net price movement since the start. Positive = price moved up, negative = down. Compare Y against X to evaluate how effectively the market converted its volatility into directional progress."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 15. f_trTipTrend — Trend Engine tooltips (6 keys)
// Keys: tr_title, tr_badge, tr_sig, tr_align, tr_conv_sfx, tr_narr
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Trend Engine cells.
// @param key Tooltip key identifier.
// @param lang The dashboard language selected by the user.
// @returns The translated tooltip string. Empty string for unknown keys.
export f_trTipTrend(string key, string lang) =>
    if lang == "Türkçe"
        switch key
            "tr_title"    => "Trend yönü modülü. Piyasanın yükselişte mi, düşüşte mi yoksa yatay mı olduğunu ve bu okumanın ne kadar güvenilir olduğunu gösterir. Herhangi bir işlem yapmadan önce ilk kontrol noktanız olarak kullanın."
            "tr_badge"    => "Modül durumu. Trend yönü analizi her mumda gerçek zamanlı çalışıyor."
            "tr_sig"      => "Mevcut trend okuması. Güçlü Yükseliş/Düşüş = çok net trend. Yükseliş/Düşüş Aktif = trend mevcut. Dönüş Onaylandı = büyük bir trend dönüşü oluşuyor — yakından izleyin. Dönüş Oluşuyor = olası dönüşün erken sinyalleri. Gizli Eğilim = kısa vadeli gürültüye rağmen büyük resim trendde. Net Trend Yok = piyasanın şu anda yönü yok."
            "tr_align"    => "Trendin arkasındaki uzlaşı düzeyi. +6 = maksimum yükseliş uzlaşısı. −6 = maksimum düşüş uzlaşısı. 0'a yakın = karışık — piyasanın net yönü yok."
            "tr_conv_sfx" => ". Trendin arkasındaki hareketlerin gücünü gösterir. YÜKSEK = güçlü, kararlı momentum. ORTA = normal güç. DÜŞÜK = yön var ama hareketler zayıf — temkinli olun."
            "tr_narr"     => "Mevcut trend durumunun sade dilde özeti. Piyasa yönünü ve okumanın güvenilirliğini okunabilir bir cümlede açıklar."
            => ""
    else if lang == "العربية"
        switch key
            "tr_title"    => "وحدة اتجاه السوق. تُظهر ما إذا كان السوق في صعود أو هبوط أو حركة جانبية، ومدى موثوقية هذه القراءة. استخدمها كأول فحص قبل أي صفقة."
            "tr_badge"    => "حالة الوحدة. تحليل اتجاه السوق يعمل على كل شمعة في الوقت الفعلي."
            "tr_sig"      => "قراءة الاتجاه الحالية. صعود/هبوط قوي = اتجاه واضح جداً. صعود/هبوط نشط = اتجاه موجود. انعكاس مؤكد = انعكاس كبير يتشكل — انتبه جيداً. انعكاس يتشكل = إشارات مبكرة لانعكاس محتمل. ميل خفي = الصورة الكبرى في اتجاه رغم الضوضاء قصيرة المدى. لا اتجاه واضح = السوق بلا اتجاه حالياً."
            "tr_align"    => "مستوى الاتفاق وراء الاتجاه. +6 = أقصى إجماع صعودي. −6 = أقصى إجماع هبوطي. قريب من 0 = مختلط — السوق بلا اتجاه واضح."
            "tr_conv_sfx" => ". يُظهر مدى قوة التحركات وراء الاتجاه. عالي = زخم قوي وحاسم. متوسط = قوة عادية. منخفض = الاتجاه موجود لكن التحركات ضعيفة — كن حذراً."
            "tr_narr"     => "ملخص بلغة بسيطة لوضع الاتجاه الحالي. يصف اتجاه السوق ومدى موثوقية القراءة في جملة واحدة مقروءة."
            => ""
    else if lang == "Italiano"
        switch key
            "tr_title"    => "Modulo direzione del trend. Mostra se il mercato è in rialzo, ribasso o laterale, e quanto è affidabile questa lettura. Usalo come primo controllo prima di qualsiasi operazione."
            "tr_badge"    => "Stato del modulo. L'analisi della direzione del trend è attiva su ogni candela in tempo reale."
            "tr_sig"      => "Lettura del trend attuale. Forte Rialzo/Ribasso = trend molto chiaro. Rialzo/Ribasso Attivo = trend presente. Inversione Confermata = un'importante inversione si sta formando — prestare molta attenzione. Inversione in Formazione = segnali precoci di possibile inversione. Bias Nascosto = il quadro generale è in trend nonostante il rumore di breve. Nessun Trend Chiaro = il mercato non ha direzione al momento."
            "tr_align"    => "Livello di accordo dietro il trend. +6 = massimo consenso rialzista. −6 = massimo consenso ribassista. Vicino a 0 = misto — il mercato non ha una direzione chiara."
            "tr_conv_sfx" => ". Mostra quanto sono potenti i movimenti dietro il trend. ALTA = momentum forte e deciso. MODERATA = forza normale. BASSA = la direzione c'è ma i movimenti sono deboli — cautela."
            "tr_narr"     => "Riepilogo in linguaggio semplice della situazione del trend attuale. Descrive la direzione del mercato e l'affidabilità della lettura in una frase leggibile."
            => ""
    else
        switch key
            "tr_title"    => "Trend direction module. Shows whether the market is trending up, down, or sideways, and how confident that reading is. Use this as your first check before taking any trade."
            "tr_badge"    => "Module status. Trend direction analysis is running on every candle in real time."
            "tr_sig"      => "The current trend reading. Strong Uptrend/Downtrend = very clear trend. Uptrend/Downtrend Active = trend present. Reversal Confirmed = a major trend reversal is forming — pay close attention. Reversal Forming = early signs of a possible reversal. Hidden Bias = the bigger picture is trending despite short-term noise. No Clear Trend = market has no direction right now."
            "tr_align"    => "How much agreement there is behind the trend. +6 = maximum bullish agreement. −6 = maximum bearish agreement. Near 0 = mixed — the market has no clear direction."
            "tr_conv_sfx" => ". Shows how powerful the moves behind the trend are. HIGH = strong, decisive momentum. MODERATE = normal strength. LOW = the direction is there but the moves are weak — be cautious."
            "tr_narr"     => "Plain-language summary of the current trend situation. Describes the market direction and how confident the reading is in one readable sentence."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 16. f_trTipEff — Efficiency module tooltips (6 keys)
// Keys: eff_title, eff_badge, eff_coup, eff_pct, eff_mom, eff_narr
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Efficiency module cells.
// @param key Tooltip key identifier.
// @param lang The dashboard language selected by the user.
// @returns The translated tooltip string. Empty string for unknown keys.
export f_trTipEff(string key, string lang) =>
    if lang == "Türkçe"
        switch key
            "eff_title" => "Hareket kalitesi modülü. Her mumun enerjisinin ne kadarının net yönsel harekete dönüştüğünü gösterir. Fiyat hareketinin temiz ve kararlı mı yoksa gürültülü ve kararsız mı olduğunu değerlendirmek için kullanın."
            "eff_badge" => "Modül durumu. Hareket kalitesi analizi her mumda gerçek zamanlı çalışıyor."
            "eff_coup"  => "Bu mumun hareket kalitesinin trendle ilişkisini gösterir. BOĞA/AYI DALGASI = trendle olağanüstü güçlü hareket. ONAYLANDI = sağlam uyum. Aktif = normal destek. Duraklamada = yön doğru ama zayıf. Ayı/Boğa Baskısı = trende karşı güçlü hareket — temkinli olun. GÜÇLÜ KARŞITLIK = aşırı karşıt hareket. Hafif Direnç/Destek = orta düzeyde karşı hareket. Gürültü = zayıf karşıt hareket, dikkate almayın."
            "eff_pct"   => "Hareket kalitesi yüzdesi. Ok yönü gösterir: ▲ = yükseliş, ▼ = düşüş. Yüksek değerler daha temiz, kararlı hareket demektir. Düşük değerler dalgalı, kararsız hareket demektir. Sistem bunu yakın geçmişle otomatik karşılaştırarak soldaki hücredeki durumu belirler."
            "eff_mom"   => "Piyasa hareket kalitesinin iyileşip iyileşmediğini gösterir. Hızlanıyor = hareketler çok daha temiz — olası trend kırılımı. Keskinleşiyor = kalitede kademeli iyileşme. Sabit = önemli değişiklik yok. Zayıflıyor = hareketler daha karmaşık — trend tükenebilir."
            "eff_narr"  => "Mevcut hareket kalitesi durumunun sade dilde özeti. Yönsel bağlamı, verimlilik düzeyini ve kalite trendini okunabilir bir açıklamada birleştirir."
            => ""
    else if lang == "العربية"
        switch key
            "eff_title" => "وحدة جودة الحركة. تُظهر مقدار طاقة كل شمعة التي تحولت إلى حركة اتجاهية واضحة. استخدمها لتقييم ما إذا كانت حركة السعر نظيفة وحاسمة أم مضطربة ومترددة."
            "eff_badge" => "حالة الوحدة. تحليل جودة الحركة يعمل على كل شمعة في الوقت الفعلي."
            "eff_coup"  => "يُظهر كيف ترتبط جودة حركة هذه الشمعة بالاتجاه الحالي. موجة صعود/هبوط = حركة استثنائية مع الاتجاه. مؤكد = توافق قوي. نشط = دعم عادي. متوقف = الاتجاه صحيح لكن ضعيف. ضغط هبوطي/صعودي = حركة قوية ضد الاتجاه — كن حذراً. ضغط قوي = حركة معاكسة متطرفة. مقاومة/دعم خفيف = حركة معاكسة معتدلة. ضوضاء = حركة معاكسة ضعيفة، تجاهلها."
            "eff_pct"   => "نسبة جودة الحركة. السهم يشير للاتجاه: ▲ = صعودي، ▼ = هبوطي. قيم أعلى تعني حركة أنظف وأكثر حسماً. قيم أقل تعني حركة مضطربة ومترددة. النظام يقارنها تلقائياً بالتاريخ الأخير لتحديد الحالة المعروضة في الخلية اليسرى."
            "eff_mom"   => "يُظهر ما إذا كانت جودة حركة السوق تتحسن أو تتدهور. تسارع = الحركات أنظف بكثير — اختراق محتمل. تحسّن = تحسن تدريجي في الجودة. مستقر = لا تغيير كبير. تراجع = الحركات أكثر فوضى — الاتجاه قد يُرهق."
            "eff_narr"  => "ملخص بلغة بسيطة لوضع جودة الحركة الحالي. يجمع السياق الاتجاهي ومستوى الكفاءة واتجاه الجودة في وصف واحد مقروء."
            => ""
    else if lang == "Italiano"
        switch key
            "eff_title" => "Modulo qualità del movimento. Mostra quanta energia di ogni candela si è convertita in un movimento direzionale chiaro. Usalo per valutare se l'azione del prezzo è pulita e decisa o rumorosa e indecisa."
            "eff_badge" => "Stato del modulo. L'analisi della qualità del movimento è attiva su ogni candela in tempo reale."
            "eff_coup"  => "Mostra come la qualità del movimento di questa candela si relaziona al trend attuale. ONDATA RIALZISTA/RIBASSISTA = movimento eccezionalmente forte con il trend. CONFERMATO = allineamento solido. Attivo = supporto normale. In Stallo = direzione corretta ma debole. Pressione Ribassista/Rialzista = movimento forte contro il trend — cautela. FORTE CONTRASTO = movimento opposto estremo. Lieve Resistenza/Supporto = contromovimento moderato. Rumore = movimento opposto debole, ignorare."
            "eff_pct"   => "Percentuale di qualità del movimento. La freccia indica la direzione: ▲ = rialzista, ▼ = ribassista. Valori più alti significano movimento più pulito e deciso. Valori più bassi significano azione instabile e indecisa. Il sistema la confronta automaticamente con la storia recente per determinare lo stato mostrato nella cella a sinistra."
            "eff_mom"   => "Mostra se la qualità del movimento del mercato sta migliorando o peggiorando. In accelerazione = movimenti molto più puliti — possibile breakout del trend. In miglioramento = miglioramento graduale della qualità. Stabile = nessun cambiamento significativo. In esaurimento = movimenti più disordinati — il trend potrebbe esaurirsi."
            "eff_narr"  => "Riepilogo in linguaggio semplice della situazione attuale della qualità del movimento. Combina il contesto direzionale, il livello di efficienza e l'andamento della qualità in una descrizione leggibile."
            => ""
    else
        switch key
            "eff_title" => "Move quality module. Shows how much of each candle's energy was converted into a clear directional move. Use this to assess whether price action is clean and decisive or noisy and indecisive."
            "eff_badge" => "Module status. Move quality analysis is running on every candle in real time."
            "eff_coup"  => "Shows how this candle's move quality relates to the current trend. BULL/BEAR SURGE = exceptionally strong move with the trend. CONFIRMED = solid alignment. Active = normal support. Stalling = direction ok but weak. Bear/Bull Pressure = strong move against the trend — be cautious. STRONG COUNTER = extreme opposing move. Mild Resistance/Support = moderate counter-move. Noise = weak opposing move, ignore."
            "eff_pct"   => "Move quality percentage. Arrow shows direction: ▲ = bullish, ▼ = bearish. Higher values mean a cleaner, more decisive move. Lower values mean choppy, indecisive action. The system automatically compares this against recent history to determine the status shown in the cell to the left."
            "eff_mom"   => "Shows whether market move quality is improving or deteriorating. Accelerating = moves are getting much cleaner — possible trend breakout. Sharpening = gradual improvement in quality. Steady = no significant change. Fading = moves are getting messier — trend may be exhausting."
            "eff_narr"  => "Plain-language summary of the current move quality situation. Combines the directional context, efficiency level, and quality trend into one readable description."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 17. f_trTipVol — Volume decomposition tooltips (11 keys)
// Keys: vol_title_geo, vol_title_intra, vol_badge, vol_badge_lock,
//       vol_lock_tip, vol_tf_a, vol_tf_b, vol_total, vol_buy, vol_sell, vol_delta
// NOTE: vol_tf_a + i_volIntraTf + vol_tf_b = full TF-invalid tooltip
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Volume decomposition cells.
// @param key Tooltip key identifier.
// @param lang The dashboard language selected by the user.
// @returns The translated tooltip string. Empty string for unknown keys.
export f_trTipVol(string key, string lang) =>
    if lang == "Türkçe"
        switch key
            "vol_title_geo"   => "Hacim ayrıştırma modülü. Mumun şeklini kullanarak mevcut mumun hacminin alış ve satış baskısı arasında nasıl dağıldığını gösterir."
            "vol_title_intra" => "Hassas alış/satış sınıflandırması için alt zaman dilimi verileri kullanan hacim ayrıştırması. Essential plan veya üstü gerektirir. Geçerli çubuk sayısı doğru çubuk içi veriye sahip çubukları gösterir."
            "vol_badge"       => "Modül durumu. Hacim sınıflandırması her mumda gerçek zamanlı çalışıyor."
            "vol_badge_lock"  => "Bu yöntem Essential plan veya üstünü gerektirir. Geometri'ye geçin veya planınızı yükseltin."
            "vol_lock_tip"    => "Çubuk içi hacim, Essential plan ve üstünde mevcut olan alt zaman dilimi verilerine erişim gerektirir. Ayarlarda Geometri yöntemine geçebilirsiniz — tüm planlarda çalışır."
            "vol_tf_a"        => "Seçilen çubuk içi zaman dilimi ("
            "vol_tf_b"        => ") çizelge zaman diliminden düşük değil. Daha düşük bir zaman dilimi seçin veya daha yüksek bir çizelge zaman dilimine geçin. Şu an Geometri yöntemi otomatik olarak kullanılıyor."
            "vol_total"       => "Ayrıştırma öncesi mevcut mumun toplam hacmi. Mumlar arasında karşılaştırarak yaklaşan hareketlere işaret edebilecek hacim artışlarını veya kurumalarını tespit edin."
            "vol_buy"         => "Mevcut mumda tahmini alış baskısı. Satışa göre daha yüksek değerler talebin arzı emdiğini gösterir. Geri çekilmelerde alış hakimiyetine dikkat edin — genellikle birikimi işaret eder."
            "vol_sell"        => "Mevcut mumda tahmini satış baskısı. Alışa göre daha yüksek değerler arzın talebi bastırdığını gösterir. Yükselişlerde satış hakimiyetine dikkat edin — genellikle dağıtımı işaret eder."
            "vol_delta"       => "Net hacim dengesi. Pozitif = alıcılar hakim, negatif = satıcılar hakim. Mevcut yönü teyit etmek veya sorgulamak için trend sinyaliyle birlikte kullanın."
            => ""
    else if lang == "العربية"
        switch key
            "vol_title_geo"   => "وحدة تحليل الحجم. تُظهر كيف ينقسم حجم الشمعة الحالية بين ضغط الشراء والبيع باستخدام شكل الشمعة."
            "vol_title_intra" => "تحليل الحجم باستخدام بيانات إطار زمني أدنى لتصنيف دقيق للشراء/البيع. يتطلب خطة Essential أو أعلى. الشموع الصالحة تُظهر عدد الشموع ذات البيانات الدقيقة."
            "vol_badge"       => "حالة الوحدة. تصنيف الحجم يعمل على كل شمعة في الوقت الفعلي."
            "vol_badge_lock"  => "هذه الطريقة تتطلب خطة Essential أو أعلى. انتقل إلى الهندسي أو قم بترقية خطتك."
            "vol_lock_tip"    => "حجم داخل الشمعة يتطلب الوصول لبيانات إطار زمني أدنى المتاحة في خطة Essential وأعلى. يمكنك التبديل إلى الطريقة الهندسية في الإعدادات — تعمل مع جميع الخطط."
            "vol_tf_a"        => "الإطار الزمني المختار ("
            "vol_tf_b"        => ") ليس أقل من إطار الرسم البياني. اختر إطاراً أقل أو انتقل لإطار رسم بياني أعلى. حالياً يُستخدم الهندسي تلقائياً."
            "vol_total"       => "إجمالي حجم الشمعة الحالية قبل أي تحليل. قارن بين الشموع لرصد ارتفاعات أو جفاف في الحجم قد تشير لحركات قادمة."
            "vol_buy"         => "ضغط الشراء المقدر على الشمعة الحالية. قيم أعلى مقارنة بالبيع تشير إلى أن الطلب يمتص العرض. راقب هيمنة الشراء أثناء التراجعات — غالباً تشير للتجميع."
            "vol_sell"        => "ضغط البيع المقدر على الشمعة الحالية. قيم أعلى مقارنة بالشراء تشير إلى أن العرض يطغى على الطلب. راقب هيمنة البيع أثناء الصعود — غالباً تشير للتوزيع."
            "vol_delta"       => "صافي توازن الحجم. موجب = المشترون مهيمنون، سالب = البائعون مهيمنون. استخدمه مع إشارة الاتجاه لتأكيد أو مساءلة الاتجاه الحالي."
            => ""
    else if lang == "Italiano"
        switch key
            "vol_title_geo"   => "Modulo di scomposizione del volume. Mostra come il volume della candela corrente si distribuisce tra pressione di acquisto e di vendita utilizzando la forma della candela."
            "vol_title_intra" => "Scomposizione del volume con dati a timeframe inferiore per una classificazione precisa acquisti/vendite. Richiede piano Essential o superiore. Le barre valide indicano quante barre hanno dati intrabar accurati."
            "vol_badge"       => "Stato del modulo. La classificazione del volume è attiva su ogni candela in tempo reale."
            "vol_badge_lock"  => "Questo metodo richiede il piano Essential o superiore. Passa a Geometria o aggiorna il tuo piano."
            "vol_lock_tip"    => "Il volume intrabar richiede l'accesso a dati a timeframe inferiore disponibili con piano Essential e superiore. Puoi passare al metodo Geometria nelle impostazioni — funziona con tutti i piani."
            "vol_tf_a"        => "Il timeframe intrabar selezionato ("
            "vol_tf_b"        => ") non è inferiore al timeframe del grafico. Scegli un timeframe inferiore o passa a un timeframe del grafico superiore. Il metodo Geometria viene utilizzato automaticamente."
            "vol_total"       => "Volume totale sulla candela corrente prima di qualsiasi scomposizione. Confronta tra le candele per individuare picchi o cali di volume che potrebbero segnalare movimenti imminenti."
            "vol_buy"         => "Pressione d'acquisto stimata sulla candela corrente. Valori più alti rispetto alle vendite suggeriscono che la domanda sta assorbendo l'offerta. Osserva la dominanza degli acquisti durante i ritracciamenti — spesso segnala accumulo."
            "vol_sell"        => "Pressione di vendita stimata sulla candela corrente. Valori più alti rispetto agli acquisti suggeriscono che l'offerta sta sopraffacendo la domanda. Osserva la dominanza delle vendite durante i rialzi — spesso segnala distribuzione."
            "vol_delta"       => "Bilancio netto del volume. Positivo = compratori dominano, negativo = venditori dominano. Usalo insieme al segnale di trend per confermare o mettere in discussione la direzione attuale."
            => ""
    else
        switch key
            "vol_title_geo"   => "Volume decomposition module. Shows how the current candle's volume splits between buying and selling pressure using the candle's shape."
            "vol_title_intra" => "Volume decomposition using lower-timeframe data for precise buy/sell classification. Requires Essential plan or higher. Valid bars shows how many bars have accurate intrabar data."
            "vol_badge"       => "Module status. Volume classification is running on every candle in real time."
            "vol_badge_lock"  => "This method requires Essential plan or higher. Switch to Geometry or upgrade your plan."
            "vol_lock_tip"    => "Intrabar volume requires access to lower-timeframe data which is available on Essential plan and above. You can switch to Geometry method in the settings — it works on all plans."
            "vol_tf_a"        => "The selected intrabar timeframe ("
            "vol_tf_b"        => ") is not lower than the chart timeframe. Choose a lower timeframe or switch to a higher chart timeframe. Geometry method is being used automatically."
            "vol_total"       => "Total volume on the current candle before any decomposition. Compare across candles to spot volume spikes or dry-ups that may signal upcoming moves."
            "vol_buy"         => "Estimated buying pressure on the current candle. Higher values relative to Sell suggest demand is absorbing supply. Watch for Buy dominance during pullbacks — it often signals accumulation."
            "vol_sell"        => "Estimated selling pressure on the current candle. Higher values relative to Buy suggest supply is overwhelming demand. Watch for Sell dominance during rallies — it often signals distribution."
            "vol_delta"       => "Net volume balance. Positive = buyers dominate, negative = sellers dominate. Use this alongside the trend signal to confirm or question the current direction."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 18. f_trTipFp — Footprint tooltips (15 keys, 6 parameterized with group size)
// Static keys: fp_title_geo, fp_title_intra, fp_badge, fp_badge_lock,
//              fp_lock_tip, fp_col_group, fp_col_max, fp_col_min, fp_col_ctrl
// Parameterized keys (gs embedded): fp_group, fp_max_buy, fp_min_buy,
//                                    fp_poc, fp_max_sell, fp_min_sell
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Volume Footprint cells.
// @param key Tooltip key identifier.
// @param gs Group size string (e.g. "3", "47"). Pass "" for static keys.
// @param lang The dashboard language selected by the user.
// @returns The translated tooltip string. Empty string for unknown keys.
export f_trTipFp(string key, string gs, string lang) =>
    if lang == "Türkçe"
        switch key
            "fp_title_geo"   => "Hacim ayak izi modülü. Her gruplama döneminde en yoğun alış ve satışın nerede gerçekleştiğini gösterir ve en yüksek toplam hacme sahip fiyat seviyesini belirler. Hacmin fiyat seviyeleri arasında nasıl dağıldığını tahmin etmek için mum şeklini kullanır."
            "fp_title_intra" => "Alt zaman dilimi verilerini kullanarak gerçek alış/satış hacmini hesaplayan hacim ayak izi. Her gruplama döneminde her fiyat seviyesindeki tam alış ve satış hacmini gösterir. Essential veya üstü plan gerektirir."
            "fp_badge"       => "Modül durumu. Hacim ayak izi analizi her gruplama ölçeğinde gerçek zamanlı çalışıyor."
            "fp_badge_lock"  => "Çubuk içi ayak izi Essential veya üstü TradingView planı gerektirir. Ayarlarda Geometri'ye geçin — tüm planlarda çalışır."
            "fp_lock_tip"    => "Çubuk içi ayak izi, alt zaman dilimi verilerini kullanarak gerçek alış/satış hacmini hesaplar — Essential veya üstü TradingView planı gerektirir. Ayarlarda Ayak İzi Yöntemini Geometri'ye çevirebilirsiniz — tüm planlarda çalışır ve tahmini hacim dağılımı sunar."
            "fp_col_group"   => "Mum gruplama ölçeği. Her grup bu kadar son kapalı mumu kapsar."
            "fp_col_max"     => "Bu gruplama döneminde en yüksek tahmini alış ve satış hacminin gerçekleştiği fiyat seviyesi."
            "fp_col_min"     => "Bu gruplama döneminde en düşük tahmini alış ve satış hacminin gerçekleştiği fiyat seviyesi."
            "fp_col_ctrl"    => "Bu gruplama dönemindeki en yüksek toplam hacme sahip fiyat seviyesi. En çok işlem gören fiyattır — önemli bir destek veya direnç referansı."
            "fp_group"       => "Gruplama ölçeği: " + gs + " kapalı mum. Büyük gruplar daha yapısal hacim kalıplarını yakalar."
            "fp_max_buy"     => gs + " mumlu grupta en yoğun alış baskısının gerçekleştiği fiyat seviyesi. Bir fiyat seviyesindeki yüksek değerler güçlü talep emilimini gösterir."
            "fp_min_buy"     => gs + " mumlu grupta en az alış aktivitesinin olduğu fiyat seviyesi. Bir seviyede düşük alış zayıf talep demektir — fiyat burada tutunamayabilir."
            "fp_poc"         => gs + " mumlu grupta en yüksek toplam işlem hacmine sahip fiyat seviyesi. Mıknatıs görevi görür — fiyat bu seviyeyi tekrar ziyaret etme eğilimindedir. Birden fazla grup aynı seviyede uzlaştığında sinyal çok güçlüdür."
            "fp_max_sell"    => gs + " mumlu grupta en yoğun satış baskısının gerçekleştiği fiyat seviyesi. Bir fiyat seviyesindeki yüksek değerler güçlü arz dağılımını gösterir."
            "fp_min_sell"    => gs + " mumlu grupta en az satış aktivitesinin olduğu fiyat seviyesi. Bir seviyede düşük satış zayıf arz demektir — fiyat buradan kolayca geçebilir."
            => ""
    else if lang == "العربية"
        switch key
            "fp_title_geo"   => "وحدة بصمة الحجم. تُظهر أين حدث أثقل شراء وبيع ضمن كل فترة تجميع، وتحدد مستوى السعر ذا أعلى حجم إجمالي. تستخدم شكل الشمعة لتقدير كيفية توزيع الحجم عبر مستويات السعر."
            "fp_title_intra" => "بصمة الحجم باستخدام بيانات الإطار الزمني الأدنى لحساب حجم الشراء/البيع الحقيقي. تُظهر حجم الشراء والبيع الدقيق عند كل مستوى سعر ضمن كل فترة تجميع. تتطلب خطة Essential أو أعلى."
            "fp_badge"       => "حالة الوحدة. تحليل بصمة الحجم يعمل على كل مقياس تجميع في الوقت الفعلي."
            "fp_badge_lock"  => "بصمة داخل الشمعة تتطلب خطة TradingView Essential أو أعلى. انتقل إلى الهندسي في الإعدادات — يعمل مع جميع الخطط."
            "fp_lock_tip"    => "بصمة داخل الشمعة تستخدم بيانات الإطار الزمني الأدنى لحساب حجم الشراء/البيع الحقيقي — تتطلب خطة TradingView Essential أو أعلى. يمكنك تبديل طريقة البصمة إلى الهندسي في الإعدادات — يعمل مع جميع الخطط ويوفر توزيع حجم تقديري."
            "fp_col_group"   => "مقياس تجميع الشموع. كل مجموعة تغطي هذا العدد من الشموع المغلقة الأخيرة."
            "fp_col_max"     => "مستوى السعر الذي حدث فيه أعلى حجم شراء وبيع مقدر ضمن فترة التجميع هذه."
            "fp_col_min"     => "مستوى السعر الذي حدث فيه أدنى حجم شراء وبيع مقدر ضمن فترة التجميع هذه."
            "fp_col_ctrl"    => "مستوى السعر ذو أعلى حجم إجمالي ضمن فترة التجميع هذه. هو السعر الأكثر تداولاً — مرجع دعم أو مقاومة رئيسي."
            "fp_group"       => "مقياس التجميع: " + gs + " شمعة مغلقة. المجموعات الأكبر تلتقط أنماط حجم أكثر هيكلية."
            "fp_max_buy"     => "مستوى السعر الذي حدث فيه أثقل ضغط شراء في مجموعة " + gs + " شمعة. القيم العالية عند مستوى سعر تشير إلى امتصاص طلب قوي."
            "fp_min_buy"     => "مستوى السعر ذو أقل نشاط شراء في مجموعة " + gs + " شمعة. شراء منخفض عند مستوى يشير لطلب ضعيف — السعر قد لا يصمد هنا."
            "fp_poc"         => "مستوى السعر ذو أعلى حجم تداول إجمالي في مجموعة " + gs + " شمعة. يعمل كمغناطيس — السعر يميل لإعادة زيارة هذا المستوى. عندما تتفق مجموعات متعددة على نفس المستوى تكون الإشارة قوية جداً."
            "fp_max_sell"    => "مستوى السعر الذي حدث فيه أثقل ضغط بيع في مجموعة " + gs + " شمعة. القيم العالية عند مستوى سعر تشير إلى توزيع عرض قوي."
            "fp_min_sell"    => "مستوى السعر ذو أقل نشاط بيع في مجموعة " + gs + " شمعة. بيع منخفض عند مستوى يشير لعرض ضعيف — السعر قد يخترق بسهولة."
            => ""
    else if lang == "Italiano"
        switch key
            "fp_title_geo"   => "Modulo impronta dei volumi. Mostra dove si sono concentrati gli acquisti e le vendite più intensi in ogni periodo di raggruppamento, e identifica il livello di prezzo con il volume totale più alto. Usa la forma della candela per stimare la distribuzione del volume sui livelli di prezzo."
            "fp_title_intra" => "Impronta dei volumi con dati intrabar per calcolare il volume reale di acquisto/vendita. Mostra il volume esatto di acquisto e vendita ad ogni livello di prezzo in ogni periodo di raggruppamento. Richiede piano Essential o superiore."
            "fp_badge"       => "Stato del modulo. L'analisi dell'impronta dei volumi è attiva su ogni scala di raggruppamento in tempo reale."
            "fp_badge_lock"  => "L'impronta intrabar richiede il piano TradingView Essential o superiore. Passa a Geometria nelle impostazioni — funziona con tutti i piani."
            "fp_lock_tip"    => "L'impronta intrabar utilizza dati a timeframe inferiore per calcolare il volume reale di acquisto/vendita — richiede piano TradingView Essential o superiore. Puoi cambiare il Metodo Impronta a Geometria nelle impostazioni — funziona con tutti i piani e fornisce una distribuzione stimata del volume."
            "fp_col_group"   => "La scala di raggruppamento delle candele. Ogni gruppo copre questo numero di candele chiuse recenti."
            "fp_col_max"     => "Il livello di prezzo dove si è verificato il volume stimato più alto di acquisto e vendita in questo periodo di raggruppamento."
            "fp_col_min"     => "Il livello di prezzo dove si è verificato il volume stimato più basso di acquisto e vendita in questo periodo di raggruppamento."
            "fp_col_ctrl"    => "Il livello di prezzo con il volume totale più alto in questo periodo di raggruppamento. È il prezzo più scambiato — un riferimento chiave di supporto o resistenza."
            "fp_group"       => "Scala di raggruppamento: " + gs + " candele chiuse. Gruppi più grandi catturano pattern di volume più strutturali."
            "fp_max_buy"     => "Il livello di prezzo con la pressione d'acquisto più intensa nel gruppo di " + gs + " candele. Valori alti indicano forte assorbimento della domanda."
            "fp_min_buy"     => "Il livello di prezzo con la minore attività d'acquisto nel gruppo di " + gs + " candele. Acquisti bassi suggeriscono domanda debole — il prezzo potrebbe non tenere qui."
            "fp_poc"         => "Il livello di prezzo con il volume totale scambiato più alto nel gruppo di " + gs + " candele. Agisce come un magnete — il prezzo tende a rivisitare questo livello. Quando più gruppi concordano, il segnale è molto forte."
            "fp_max_sell"    => "Il livello di prezzo con la pressione di vendita più intensa nel gruppo di " + gs + " candele. Valori alti indicano forte distribuzione dell'offerta."
            "fp_min_sell"    => "Il livello di prezzo con la minore attività di vendita nel gruppo di " + gs + " candele. Vendite basse suggeriscono offerta debole — il prezzo potrebbe sfondare facilmente."
            => ""
    else
        switch key
            "fp_title_geo"   => "Volume footprint module. Shows where the heaviest buying and selling occurred within each grouping period, and identifies the price level with the most total volume. Uses the candle shape to estimate how volume distributes across price levels."
            "fp_title_intra" => "Volume footprint using intrabar data to calculate real buy/sell volume. Shows exact buy and sell volume at every price level within each grouping period. Requires Essential plan or higher."
            "fp_badge"       => "Module status. Volume footprint analysis is running on every grouping scale in real time."
            "fp_badge_lock"  => "Intrabar footprint requires Essential or higher TradingView plan. Switch to Geometry in the settings — it works on all plans."
            "fp_lock_tip"    => "Intrabar footprint uses lower-timeframe data to calculate real buy/sell volume — requires Essential or higher TradingView plan. You can switch the Footprint Method to Geometry in the settings — it works on all plans and provides estimated volume distribution."
            "fp_col_group"   => "The candle grouping scale. Each group covers this many recently closed candles."
            "fp_col_max"     => "The price level where the highest estimated buying and selling volume occurred within this group period."
            "fp_col_min"     => "The price level where the lowest estimated buying and selling volume occurred within this group period."
            "fp_col_ctrl"    => "The price level with the highest total volume within this group period. This is the most traded price — a key support or resistance reference."
            "fp_group"       => "Grouping scale: " + gs + " closed candles. Larger groups capture more structural volume patterns."
            "fp_max_buy"     => "The price level where the heaviest buying pressure occurred in the " + gs + "-candle group. High values at a price level indicate strong demand absorption."
            "fp_min_buy"     => "The price level with the least buying activity in the " + gs + "-candle group. Low buying at a level suggests weak demand — price may not hold here."
            "fp_poc"         => "The price level with the highest total traded volume in the " + gs + "-candle group. Acts as a magnet — price tends to revisit this level. When multiple groups agree on the same level, the signal is very strong."
            "fp_max_sell"    => "The price level where the heaviest selling pressure occurred in the " + gs + "-candle group. High values at a price level indicate strong supply distribution."
            "fp_min_sell"    => "The price level with the least selling activity in the " + gs + "-candle group. Low selling at a level suggests weak supply — price may break through easily."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 19. f_trTipVi — Volume Insight tooltips (6 keys)
// Keys: vi_title, vi_badge, vi_scenario, vi_zone, vi_poc, vi_narr
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Volume Insight cells.
// @param key Tooltip key identifier.
// @param lang The dashboard language selected by the user.
// @returns The translated tooltip string. Empty string for unknown keys.
export f_trTipVi(string key, string lang) =>
    if lang == "Türkçe"
        switch key
            "vi_title"    => "Hacim baskısı analizi. Alış/satış dengesini, hacim yoğunluğunu ve tüm gruplama ölçeklerindeki yapısal hacim dağılımını birleştirerek kimin kontrolde olduğunu ve bundan sonra ne bekleneceğini değerlendirir."
            "vi_badge"    => "Modül durumu. Hacim baskısı analizi her mumda gerçek zamanlı çalışıyor."
            "vi_scenario" => "Mevcut hacim senaryosu. Şu anda tespit edilen baskın hacim kalıbını gösterir. Tam Onay = hacim trendi tamamen destekliyor. Karşıtlık = hacim trende karşı. Teslimiyet = diplerde panik satışı. Tükenme = zirvelerde coşkulu alış. Adil Değer Mıknatısı = birden fazla gruplama ölçeği aynı hacim merkezinde uzlaşıyor. Emilim = alıcılar desteği savunuyor. Dağılım = satıcılar direnci kısıtlıyor."
            "vi_zone"     => "Hacim yoğunluğu ve yönü. Ok baskın tarafı gösterir: ▲ = alıcılar, ▼ = satıcılar, ◆ = dengeli. Patlayıcı = geçmişin en üst %5'i. Yüksek = en üst %25. Orta = ortalama. Çok Düşük = en alt %25."
            "vi_poc"      => "Kaç gruplama ölçeğinin hacim merkezini aynı fiyat seviyesi yakınında tuttuğunu gösterir. 4 veya üzeri = çok güçlü uzlaşı. 2 = kısmi uzlaşı. Ölçekler Uyumsuz = dağınık."
            "vi_narr"     => "Mevcut hacim durumunun sade dilde özeti. Hacmin ne yaptığını, yapısal olarak neden önemli olduğunu ve bundan sonra ne bekleneceğini okunabilir bir açıklamada anlatır."
            => ""
    else if lang == "العربية"
        switch key
            "vi_title"    => "تحليل ضغط الحجم. يجمع بين توازن الشراء/البيع وكثافة الحجم وتوزيع الحجم الهيكلي عبر جميع مقاييس التجميع لتقييم من يسيطر وماذا يُتوقع بعد ذلك."
            "vi_badge"    => "حالة الوحدة. تحليل ضغط الحجم يعمل على كل شمعة في الوقت الفعلي."
            "vi_scenario" => "سيناريو الحجم الحالي. يُظهر نمط الحجم المهيمن المكتشف الآن. تأكيد كامل = الحجم يدعم الاتجاه بالكامل. معاكسة = الحجم يعارض الاتجاه. استسلام = بيع ذعر عند القيعان. إرهاق = شراء متحمس عند القمم. مغناطيس القيمة العادلة = مقاييس تجميع متعددة تتفق على نفس مركز الحجم. امتصاص = المشترون يدافعون عن الدعم. توزيع = البائعون يحدّون المقاومة."
            "vi_zone"     => "كثافة الحجم والاتجاه. السهم يُظهر الجانب المهيمن: ▲ = المشترون، ▼ = البائعون، ◆ = متوازن. انفجاري = أعلى 5% من التاريخ. مرتفع = أعلى 25%. معتدل = متوسط. منخفض جداً = أدنى 25%."
            "vi_poc"      => "يُظهر عدد مقاييس التجميع التي لديها مركز حجمها قرب نفس مستوى السعر. 4 أو أكثر = اتفاق قوي جداً. 2 = اتفاق جزئي. المقاييس غير متوافقة = متفرقة."
            "vi_narr"     => "ملخص بلغة بسيطة لوضع الحجم الحالي. يصف ما يفعله الحجم، ولماذا يهم هيكلياً، وماذا يُتوقع بعد ذلك — كل ذلك في وصف واحد مقروء."
            => ""
    else if lang == "Italiano"
        switch key
            "vi_title"    => "Analisi della pressione del volume. Combina il bilancio acquisti/vendite, l'intensità del volume e la distribuzione strutturale su tutte le scale di raggruppamento per valutare chi è in controllo e cosa aspettarsi."
            "vi_badge"    => "Stato del modulo. L'analisi della pressione del volume è attiva su ogni candela in tempo reale."
            "vi_scenario" => "Lo scenario di volume attuale. Mostra il pattern dominante rilevato ora. Conferma Totale = il volume supporta pienamente il trend. Contrasto = il volume si oppone. Capitolazione = vendite di panico ai minimi. Esaurimento = acquisti euforici ai massimi. Magnete del Valore Equo = più scale concordano sullo stesso centro di volume. Assorbimento = compratori difendono il supporto. Distribuzione = venditori limitano la resistenza."
            "vi_zone"     => "Intensità e direzione del volume. La freccia mostra il lato dominante: ▲ = compratori, ▼ = venditori, ◆ = bilanciato. Esplosivo = top 5% dello storico. Elevato = top 25%. Moderato = nella media. Molto Basso = bottom 25%."
            "vi_poc"      => "Mostra quante scale di raggruppamento hanno il centro di volume vicino allo stesso livello di prezzo. 4 o più = accordo molto forte. 2 = accordo parziale. Scale Discordi = disperso."
            "vi_narr"     => "Riepilogo in linguaggio semplice della situazione del volume attuale. Descrive cosa sta facendo il volume, perché è strutturalmente importante e cosa aspettarsi — tutto in una descrizione leggibile."
            => ""
    else
        switch key
            "vi_title"    => "Volume pressure analysis. Combines buying/selling balance, volume intensity, and structural volume distribution across all grouping scales to assess who is in control and what to expect next."
            "vi_badge"    => "Module status. Volume pressure analysis is running on every candle in real time."
            "vi_scenario" => "The current volume scenario. Shows the dominant volume pattern detected right now. Full Confirmation = volume fully supports the trend. Counter = volume fights the trend. Capitulation = panic selling at lows. Exhaustion = euphoric buying at highs. Fair Value Magnet = multiple grouping scales agree on the same volume center. Absorption = buyers defending support. Distribution = sellers capping resistance."
            "vi_zone"     => "Volume intensity and direction. Arrow shows dominant side: ▲ = buyers, ▼ = sellers, ◆ = balanced. Explosive = top 5% of history. Elevated = top 25%. Moderate = average. Very Low = bottom 25%."
            "vi_poc"      => "Shows how many grouping scales have their volume center near the same price level. 4 or higher = very strong agreement. 2 = partial agreement. Scales Disagree = scattered."
            "vi_narr"     => "Plain-language summary of the current volume situation. Describes what volume is doing, why it matters structurally, and what to expect next — all in one readable description."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 20. f_trTrendDesc — Trend state description + conviction suffix for tooltip
// Replaces inline _descTxt + _convSuffix in the indicator.
// Returns the complete conviction cell tooltip as a single string.
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the trend state description with conviction suffix for the tooltip.
// @param cas Cascade active flag.
// @param casDir Cascade direction (+1 bullish, -1 bearish).
// @param div Divergence active flag.
// @param smD Micro direction from slope engine.
// @param algn Alignment score (-6 to +6).
// @param mBias Macro bias active flag.
// @param mBiasDir Macro bias direction.
// @param lang The dashboard language.
// @returns Complete tooltip string (description + conviction explanation).
export f_trTrendDesc(bool cas, int casDir, bool div, int smD, int algn, bool mBias, int mBiasDir, string lang) =>
    bool _tr = lang == "Türkçe"
    bool _ar = lang == "العربية"
    bool _it = lang == "Italiano"
    string _d = ""
    if cas
        _d := casDir > 0 ? (_tr ? "Birden fazla katmanda yükseliş dönüşü onaylandı" : _ar ? "انعكاس صعودي مؤكد عبر طبقات متعددة" : _it ? "Inversione rialzista confermata su più livelli" : "Bullish reversal confirmed across multiple layers") : (_tr ? "Birden fazla katmanda düşüş dönüşü onaylandı" : _ar ? "انعكاس هبوطي مؤكد عبر طبقات متعددة" : _it ? "Inversione ribassista confermata su più livelli" : "Bearish reversal confirmed across multiple layers")
    else if div
        _d := smD > 0 ? (_tr ? "Kısa vade yükselişe dönüyor, uzun vade hâlâ düşüşte" : _ar ? "المدى القصير يتحول صعوداً، المدى الطويل لا يزال هبوطياً" : _it ? "Il breve termine si gira al rialzo, il lungo termine è ancora ribassista" : "Short-term turning bullish, long-term still bearish") : (_tr ? "Kısa vade düşüşe dönüyor, uzun vade hâlâ yükselişte" : _ar ? "المدى القصير يتحول هبوطاً، المدى الطويل لا يزال صعودياً" : _it ? "Il breve termine si gira al ribasso, il lungo termine è ancora rialzista" : "Short-term turning bearish, long-term still bullish")
    else if mBias
        _d := mBiasDir > 0 ? (_tr ? "Kısa vadeli gürültü arkasında yükseliş eğilimi" : _ar ? "ميل صعودي كامن خلف ضوضاء قصيرة المدى" : _it ? "Bias rialzista sottostante dietro il rumore di breve termine" : "Underlying bullish bias behind short-term noise") : (_tr ? "Kısa vadeli sıçramalar arkasında düşüş eğilimi" : _ar ? "ميل هبوطي كامن خلف ارتدادات قصيرة المدى" : _it ? "Bias ribassista sottostante dietro i rimbalzi di breve termine" : "Underlying bearish bias behind short-term bounces")
    else if algn == 6
        _d := _tr ? "Tüm zaman dilimleri yükselişte" : _ar ? "جميع الأُطُر الزمنية صعودية" : _it ? "Tutti gli orizzonti temporali rialzisti" : "All time horizons bullish"
    else if algn == -6
        _d := _tr ? "Tüm zaman dilimleri düşüşte" : _ar ? "جميع الأُطُر الزمنية هبوطية" : _it ? "Tutti gli orizzonti temporali ribassisti" : "All time horizons bearish"
    else if algn == 5
        _d := _tr ? "Neredeyse tüm zaman dilimleri yükselişte" : _ar ? "معظم الأُطُر الزمنية صعودية" : _it ? "Quasi tutti gli orizzonti temporali rialzisti" : "Nearly all time horizons bullish"
    else if algn == -5
        _d := _tr ? "Neredeyse tüm zaman dilimleri düşüşte" : _ar ? "معظم الأُطُر الزمنية هبوطية" : _it ? "Quasi tutti gli orizzonti temporali ribassisti" : "Nearly all time horizons bearish"
    else if algn >= 3
        _d := _tr ? "Zaman dilimlerinin çoğunluğu yükselişte" : _ar ? "غالبية الأُطُر الزمنية صعودية" : _it ? "La maggioranza degli orizzonti temporali è rialzista" : "Majority of time horizons bullish"
    else if algn <= -3
        _d := _tr ? "Zaman dilimlerinin çoğunluğu düşüşte" : _ar ? "غالبية الأُطُر الزمنية هبوطية" : _it ? "La maggioranza degli orizzonti temporali è ribassista" : "Majority of time horizons bearish"
    else
        _d := _tr ? "Net yön yok" : _ar ? "لا اتجاه واضح" : _it ? "Nessuna direzione chiara" : "No clear direction"
    string _sfx = _tr ? ". Trendin arkasındaki hareketlerin gücünü gösterir. YÜKSEK = güçlü, kararlı momentum. ORTA = normal güç. DÜŞÜK = yön var ama hareketler zayıf — temkinli olun." : _ar ? ". يُظهر مدى قوة التحركات وراء الاتجاه. عالي = زخم قوي وحاسم. متوسط = قوة عادية. منخفض = الاتجاه موجود لكن التحركات ضعيفة — كن حذراً." : _it ? ". Mostra quanto sono potenti i movimenti dietro il trend. ALTA = momentum forte e deciso. MODERATA = forza normale. BASSA = la direzione c'è ma i movimenti sono deboli — cautela." : ". Shows how powerful the moves behind the trend are. HIGH = strong, decisive momentum. MODERATE = normal strength. LOW = the direction is there but the moves are weak — be cautious."
    _d + _sfx

// ══════════════════════════════════════════════════════════════════════════════════
// 21. f_trInlineLabel — Remaining inline multilingual labels (17 keys)
