strategy('Buy Sell First Hour Strategy', overlay = true) //, calc_bars_count=900)
strategy.risk.max_intraday_filled_orders(2)


var float low_price = na
var float yestlow = na
var float yesthigh = na
var float yestlow2 = na
var float yestlow3 = na

var float yesthigh2 = na
var float yestopen = na
var float open_price = na
var float yestclose = na
var float yestclose2 = na
var float beforeyestlow = na
var float beforeyesthigh = na
var float high_price = na
var int high_time = na
var int low_time = na

is_new_day = ta.change(time('D'))

if bool(is_new_day)
    high_price := high
    high_time := time
    low_price := low
    low_time := time
    open_price := open
    yestclose := close[1]
    yestclose2 := yestclose[1]
    yestopen := open_price[1]
    yestlow := low_price[1]
    yestlow2 := yestlow[1]
    yestlow3 := yestlow2[1]
    yesthigh := high_price[1]
    yesthigh2 := yesthigh[1]
    beforeyestlow := yestlow[1]
    beforeyesthigh := yesthigh[1]
    beforeyesthigh
else
    if high > high_price
        high_price := high
        high_time := time
        high_time
    if low < low_price
        low_time := time
        low_price := low
        low_price

closetime = '1500-1501'
closeminute = time(timeframe.period, closetime)
dclose = ta.valuewhen(bool(closeminute), open[0], 0)




scalping = input.bool(true, 'take trades')
shorting = input.bool(true, 'shorting')


//if close>open
ll = ta.lowest(low, 2)
hh = ta.highest(high, 3)
hh2 = ta.highest(high, 2)
half = (high - low) / 2 + low




sm2 = ta.sma(close, 200)
avoid = hour == 7 and close == 21941.75 or yesthigh > sm2 and ll > yestlow

gap = close == 30582.25
if shorting and (bool(is_new_day) or hour == 18 and high > sm2 and high < high[1] and low > low[1]) and scalping and open > close and low - 20 > yestlow and (yestlow < sm2 or gap)
    strategy.entry('s', strategy.short, stop = low - 2)

if (bool(is_new_day) or hour == 18 and high < sm2 and high > high[1] and low > low[1]) and scalping and open + 3 < close
    strategy.entry('l', strategy.long, stop = high + 2)



if hour == 14
    strategy.close('s')

if hour == 14
    strategy.close('l')

if hour == 1 or close < open and high < high[1] and low > low[1]
    strategy.cancel('l')

if hour == 8 and low < sm2
    strategy.close('l')



if scalping and hour == 7 and strategy.position_size < 0 and close < strategy.position_avg_price
    strategy.exit('stop', from_entry = 's', stop = strategy.position_avg_price)
