//@version=6

// @description Bibliothèque pour calculer les zones de support/résistance basées sur le volume (fractales)
library("volSRCore")

// ═════════════════════════════════════════════
// 🔧 HELPER FUNCTIONS
// ═════════════════════════════════════════════

// @function Convertit une string de timeframe en format Pine
// @param tfInput String du timeframe ('Chart', '1m', '5m', '1h', 'D', etc.)
// @returns String au format Pine Script timeframe
export tfStringToFormat(string tfInput) =>
    string result = na
    if tfInput == 'Chart'
        result := timeframe.period
    else if tfInput == '1m'
        result := '1'
    else if tfInput == '3m'
        result := '3'
    else if tfInput == '5m'
        result := '5'
    else if tfInput == '15m'
        result := '15'
    else if tfInput == '30m'
        result := '30'
    else if tfInput == '45m'
        result := '45'
    else if tfInput == '1h'
        result := '60'
    else if tfInput == '2h'
        result := '120'
    else if tfInput == '3h'
        result := '180'
    else if tfInput == '4h'
        result := '240'
    else if tfInput == '6h'
        result := '360'
    else if tfInput == '8h'
        result := '480'
    else if tfInput == '12h'
        result := '720'
    else if tfInput == 'D'
        result := 'D'
    else if tfInput == '3D'
        result := '3D'
    else if tfInput == 'W'
        result := 'W'
    else if tfInput == '2W'
        result := '2W'
    else if tfInput == '1M'
        result := '1M'
    else if tfInput == '12M'
        result := '12M'
    result

// @function Convertit le timeframe actuel en minutes
// @returns Float - minutes du timeframe actuel
export resInMinutes() =>
    float result = timeframe.multiplier * (timeframe.isseconds ? 1. / 60 : timeframe.isminutes ? 1. : timeframe.isdaily ? 60. * 24 : timeframe.isweekly ? 60. * 24 * 7 : timeframe.ismonthly ? 60. * 24 * 30.4375 : na)
    result

// ═════════════════════════════════════════════
// 📊 FRACTAL DETECTION (Volume-based)
// ═════════════════════════════════════════════

// @function Détecte une fractale haussière (résistance potentielle)
// @param tfHigh Series high du timeframe
// @param tfVol Series volume du timeframe
// @param tfVolMA Series volume MA du timeframe
// @returns Bool - true si fractale haussière détectée
export fractalUp(float tfHigh, float tfVol, float tfVolMA) =>
    bool isUp = tfHigh[3] > tfHigh[4] and tfHigh[4] > tfHigh[5] and tfHigh[2] < tfHigh[3] and tfHigh[1] < tfHigh[2] and tfVol[3] > tfVolMA[3]
    isUp

// @function Détecte une fractale baissière (support potentiel)
// @param tfLow Series low du timeframe
// @param tfVol Series volume du timeframe
// @param tfVolMA Series volume MA du timeframe
// @returns Bool - true si fractale baissière détectée
export fractalDown(float tfLow, float tfVol, float tfVolMA) =>
    bool isDown = tfLow[3] < tfLow[4] and tfLow[4] < tfLow[5] and tfLow[2] > tfLow[3] and tfLow[1] > tfLow[2] and tfVol[3] > tfVolMA[3]
    isDown

// ═════════════════════════════════════════════
// 🎯 FRACTAL LEVELS CALCULATION
// ═════════════════════════════════════════════

// @function Calcule le niveau de résistance (fractale haussière)
// @param tfHigh Series high
// @param tfVol Series volume
// @param tfVolMA Series volume MA
// @returns Float - niveau de résistance
export calcFractalUpLevel(float tfHigh, float tfVol, float tfVolMA) =>
    bool isUp = fractalUp(tfHigh, tfVol, tfVolMA)
    var float fractalUpLevel = na
    if isUp
        fractalUpLevel := tfHigh[3]
    fractalUpLevel

// @function Calcule le niveau de support (fractale baissière)
// @param tfLow Series low
// @param tfVol Series volume
// @param tfVolMA Series volume MA
// @returns Float - niveau de support
export calcFractalDownLevel(float tfLow, float tfVol, float tfVolMA) =>
    bool isDown = fractalDown(tfLow, tfVol, tfVolMA)
    var float fractalDownLevel = na
    if isDown
        fractalDownLevel := tfLow[3]
    fractalDownLevel

// ═════════════════════════════════════════════
// 📦 ZONE CALCULATION (Open/Close based)
// ═════════════════════════════════════════════

// @function Calcule la zone de résistance (entre High et Open/Close)
// @param tfHigh Series high
// @param tfOpen Series open
// @param tfClose Series close
// @param tfVol Series volume
// @param tfVolMA Series volume MA
// @returns Float - limite basse de la zone de résistance
export calcResistanceZone(float tfHigh, float tfOpen, float tfClose, float tfVol, float tfVolMA) =>
    bool isUp = fractalUp(tfHigh, tfVol, tfVolMA)
    var float resZone = na
    if isUp
        if tfClose[3] >= tfOpen[3]
            resZone := tfClose[3]
        else
            resZone := tfOpen[3]
    resZone

// @function Calcule la zone de support (entre Low et Open/Close)
// @param tfLow Series low
// @param tfOpen Series open
// @param tfClose Series close
// @param tfVol Series volume
// @param tfVolMA Series volume MA
// @returns Float - limite haute de la zone de support
export calcSupportZone(float tfLow, float tfOpen, float tfClose, float tfVol, float tfVolMA) =>
    bool isDown = fractalDown(tfLow, tfVol, tfVolMA)
    var float supZone = na
    if isDown
        if tfClose[3] >= tfOpen[3]
            supZone := tfOpen[3]
        else
            supZone := tfClose[3]
    supZone

// ═════════════════════════════════════════════
// 🔍 PIVOT BAR INDEX DETECTION
// ═════════════════════════════════════════════

// @function Détecte le changement de barre sur un timeframe donné
// @param tfRes String du timeframe
// @returns Bool - true si nouvelle barre détectée
export tfNewBar(simple string tfRes) =>
    bool newBar = ta.change(time(tfRes)) != 0
    newBar

// @function Calcule le bar_index il y a N barres du timeframe cible
// @param tfRes String du timeframe
// @param barsBack Int - nombre de barres en arrière (1, 3, 5, etc.)
// @returns Int - bar_index à ce moment
export tfBarIndexBack(simple string tfRes, simple int barsBack) =>
    bool newBar = tfNewBar(tfRes)
    int biBack = ta.valuewhen(newBar, bar_index, barsBack)
    biBack

// @function Calcule le nombre de barres chart entre 2 barres du TF cible
// @param tfRes String du timeframe
// @param startBar Int - barre de départ (ex: 1)
// @param endBar Int - barre de fin (ex: 5)
// @returns Int - nombre de barres chart dans cet intervalle
export tfBarsRange(simple string tfRes, simple int startBar, simple int endBar) =>
    int bi1 = tfBarIndexBack(tfRes, startBar)
    int bi2 = tfBarIndexBack(tfRes, endBar)
    int barsRange = (bar_index - bi2) - (bar_index - bi1)
    barsRange

// @function Trouve le bar_index exact du plus haut dans une plage donnée
// @param startBarsBack Int - début du scan en bars back
// @param rangeSize Int - taille de la plage à scanner
// @param maxBarsBack Int - limite max_bars_back (ex: 4999)
// @returns Int - bar_index du plus haut, ou maxBarsBack si hors limite
export calcPivotHighBarIndex(simple int startBarsBack, simple int rangeSize, simple int maxBarsBack) =>
    int pivotBi = na
    if startBarsBack > maxBarsBack or (startBarsBack + rangeSize) > maxBarsBack
        pivotBi := maxBarsBack
    else
        int offset = math.abs(ta.highestbars(high, nz(rangeSize, 1)))[startBarsBack]
        pivotBi := offset + startBarsBack
    pivotBi

// @function Trouve le bar_index exact du plus bas dans une plage donnée
// @param startBarsBack Int - début du scan en bars back
// @param rangeSize Int - taille de la plage à scanner
// @param maxBarsBack Int - limite max_bars_back (ex: 4999)
// @returns Int - bar_index du plus bas, ou maxBarsBack si hors limite
export calcPivotLowBarIndex(simple int startBarsBack, simple int rangeSize, simple int maxBarsBack) =>
    int pivotBi = na
    if startBarsBack > maxBarsBack or (startBarsBack + rangeSize) > maxBarsBack
        pivotBi := maxBarsBack
    else
        int offset = math.abs(ta.lowestbars(low, nz(rangeSize, 1)))[startBarsBack]
        pivotBi := offset + startBarsBack
    pivotBi

// ═════════════════════════════════════════════
// 🔔 PRICE INTERACTION DETECTION
// ═════════════════════════════════════════════

// @function Détecte les interactions du prix avec les zones S/R
// @param resLevel Float - niveau de résistance
// @param resZone Float - zone de résistance
// @param supLevel Float - niveau de support
// @param supZone Float - zone de support
// @returns [bool, bool, bool, bool, bool, bool] - EntersResZone, TestsResAsSupport, EntersSupZone, TestsSupAsRes, BreaksRes, BreaksSup
export detectPriceInteraction(float resLevel, float resZone, float supLevel, float supZone) =>
    bool entersResZone = ta.crossover(close, resZone)
    bool testsResAsSupport = ta.crossunder(close, resLevel)
    bool entersSupZone = ta.crossunder(close, supZone)
    bool testsSupAsRes = ta.crossover(close, supLevel)
    bool breaksResistance = ta.crossover(close, resLevel)
    bool breaksSupport = ta.crossunder(close, supLevel)
    
    [entersResZone, testsResAsSupport, entersSupZone, testsSupAsRes, breaksResistance, breaksSupport]

// ═════════════════════════════════════════════
// 🎯 COMPLETE S/R CALCULATION WRAPPER
// ═════════════════════════════════════════════

// @function Calcule tous les niveaux S/R à partir de données MTF déjà récupérées
// @param tfOpen Float - open du TF
// @param tfHigh Float - high du TF
// @param tfLow Float - low du TF
// @param tfClose Float - close du TF
// @param tfVol Float - volume du TF
// @param volMaLength Int - longueur MA volume
// @returns [float, float, float, float, bool, bool] - ResLevel, ResZone, SupLevel, SupZone, IsFractalUp, IsFractalDown
export calcSRLevelsFromData(float tfOpen, float tfHigh, float tfLow, float tfClose, float tfVol, simple int volMaLength) =>
    // Volume MA
    float tfVolMA = ta.sma(tfVol, volMaLength)
    
    // Fractal detection
    bool isFractalUp = fractalUp(tfHigh, tfVol, tfVolMA)
    bool isFractalDown = fractalDown(tfLow, tfVol, tfVolMA)
    
    // Levels
    float resLevel = calcFractalUpLevel(tfHigh, tfVol, tfVolMA)
    float supLevel = calcFractalDownLevel(tfLow, tfVol, tfVolMA)
    
    // Zones
    float resZone = calcResistanceZone(tfHigh, tfOpen, tfClose, tfVol, tfVolMA)
    float supZone = calcSupportZone(tfLow, tfOpen, tfClose, tfVol, tfVolMA)
    
    [resLevel, resZone, supLevel, supZone, isFractalUp, isFractalDown]

// @function Détecte un changement de fractale (nouveau S/R trouvé)
// @param resLevel Float - niveau de résistance actuel
// @param supLevel Float - niveau de support actuel
// @returns [bool, bool] - NewResistance, NewSupport
export detectNewSR(float resLevel, float supLevel) =>
    bool newRes = resLevel != resLevel[1]
    bool newSup = supLevel != supLevel[1]
    [newRes, newSup]