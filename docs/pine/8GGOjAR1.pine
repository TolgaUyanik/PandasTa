//@version=5
library("EMTIA_MASTER_LIB", overlay=false)

// TREND
export trendUp(float emaFast, float emaSlow) =>
    emaFast > emaSlow

// RSI
export rsiHealthy(float rsi) =>
    rsi >= 45 and rsi <= 65

// ADX
export adxStrong(float adx, float diPlus, float diMinus) =>
    adx >= 18 and diPlus > diMinus

// MACRO SLOPE
export macroSlope(float emaFast, float emaSlow) =>
    (emaFast / emaSlow) > (emaFast[1] / emaSlow[1])

// STRUCTURE
export structureBull(bool hh, bool hl) =>
    hh and hl

// SCORE
export calcScore(bool weeklyTrend, bool dailyTrend, bool adxOk, bool rsiOk, bool structureOk, bool macroOk) =>
    int score = 0
    if weeklyTrend
        score += 1
    if dailyTrend
        score += 1
    if adxOk
        score += 1
    if rsiOk
        score += 1
    if structureOk
        score += 1
    if macroOk
        score += 1
    score
