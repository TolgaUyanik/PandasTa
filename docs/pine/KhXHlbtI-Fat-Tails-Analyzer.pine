//@version=6
indicator('Fat Tails Analyzer', overlay = false, shorttitle = 'Fat Tails')

// This indicator visualizes the presence of "fat tails" in asset returns,
// a phenomenon where extreme price movements occur more frequently than
// predicted by a normal distribution. It calculates logarithmic returns,
// their rolling mean and standard deviation, and the excess kurtosis.
// Extreme event thresholds are plotted, along with normal distribution bands
// for comparison. A table displays key statistical metrics.

// --- Inputs ---
// Period for calculating returns, mean, and standard deviation.
length = input.int(252, 'Lookback Period (Bars)', minval = 30, tooltip = 'Number of bars used for calculating mean, standard deviation, and kurtosis.')
// Threshold in standard deviations to identify "fat tail" events.
threshold = input.float(2.5, 'Fat Tail Threshold (Std Devs)', minval = 1.5, maxval = 5, step = 0.1, tooltip = 'Number of standard deviations from the mean to define extreme (fat tail) events.')
// Option to display normal distribution bands (+/- 2 standard deviations).
plotNormal = input.bool(true, 'Show Normal Distribution Bands?', tooltip = 'Toggle visibility of +/- 2 standard deviation lines, representing a normal distribution\'s typical range.')

plotKurtosis = input.bool(false, 'Show Kurtosis Plot?', tooltip="When enabled, only the Excess Kurtosis line will be visible in the main pane. Other plots will be hidden to prevent scale distortion and ensure clear readability of Kurtosis values.")

// --- Returns Calculation ---
// Calculate logarithmic returns: ln(Close / Close[1])
// Log returns are preferred in financial analysis for their additive properties and better statistical behavior. [2, 3]
returns = math.log(close / close[1])

// Calculate rolling mean and standard deviation of returns over the specified length.
mean = ta.sma(returns, length)
stddev = ta.stdev(returns, length)

// --- Fat Tail Event Identification ---
// Define upper and lower bands for "fat tail" events based on the threshold.
upperBand = mean + threshold * stddev
lowerBand = mean - threshold * stddev

// Identify if the current return falls into the "fat tail" regions.
isFatTailUp = returns > upperBand
isFatTailDown = returns < lowerBand

// --- Visualization ---
// 1. Plot Returns as a Histogram
// Green for positive returns, Red for negative returns.
plot(not plotKurtosis ? returns : na, 'Returns', returns >= 0 ? color.new(color.green, 20) : color.new(color.red, 20), style = plot.style_columns)

// 2. Plot Fat Tail Threshold Lines
// These lines visually mark the boundaries for extreme events.
plot(not plotKurtosis ? upperBand : na, 'Upper Fat Tail Threshold', color.new(color.purple, 0), linewidth = 2, style = plot.style_line)
plot(not plotKurtosis ? lowerBand : na, 'Lower Fat Tail Threshold', color.new(color.purple, 0), linewidth = 2, style = plot.style_line)

// 3. Plot Normal Distribution Bands (for comparison)
// These lines represent the +/- 2 standard deviation range of a normal distribution.
// They help to visually compare actual market behavior to theoretical normality. [4, 5]
plot(not plotKurtosis and plotNormal ? mean + 2 * stddev : na, 'Normal +2σ', color.new(color.silver, 50), linewidth = 1, style = plot.style_line)
plot(not plotKurtosis and plotNormal ? mean - 2 * stddev : na, 'Normal -2σ', color.new(color.silver, 50), linewidth = 1, style = plot.style_line)

// 4. Plot Markers for Anomalous Events (Optional, currently commented out)
// These shapes highlight individual bars where returns exceed the fat tail thresholds.

// plotshape(isFatTailUp, "Anomalous Upward Spike", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
// plotshape(isFatTailDown, "Anomalous Downward Spike", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// --- Kurtosis Calculation ---
// Function to calculate the rolling kurtosis (excess kurtosis) of returns.
// Kurtosis measures the "tailedness" of the distribution.
// A value > 0 indicates "fat tails" (leptokurtic distribution), meaning more observations
// in the tails and around the mean than a normal distribution. [6]
kurtosis() =>
    // Calculate the fourth central moment
    sum4 = 0.0
    for i = 0 to length - 1 by 1
        sum4 := sum4 + math.pow(returns[i] - mean, 4)
        sum4
    // Calculate kurtosis and subtract 3 for excess kurtosis (relative to normal distribution)
    sum4 / length / math.pow(stddev, 4) - 3

k = kurtosis()

// Plot Excess Kurtosis on a separate Y-axis scale within the same pane.
// This allows its potentially large values to be visible without distorting the returns plot,
// as kurtosis values can be significantly different in magnitude from returns.
plot(plotKurtosis ?  k : na, "Excess Kurtosis", color.new(color.blue, 0), linewidth=2, style=plot.style_line)

// --- Display Statistics Table ---
// Create a table to display key statistical metrics at the bottom right of the chart.
var table statsTable = table.new(position.bottom_right, 2, 4, bgcolor = color.new(color.purple, 80), border_width = 1, border_color = color.gray)

if barstate.islast
    // Add a title row to the table.
    table.cell(statsTable, 0, 0, 'Fat Tails Analyzer Stats', text_color = color.white, text_halign = text.align_center)

    // Update table cells with current statistics.
    table.cell(statsTable, 0, 1, 'Mean:', text_color = color.white, text_halign = text.align_left)
    table.cell(statsTable, 1, 1, str.tostring(mean, '#.#####'), text_color = color.white, text_halign = text.align_right)

    table.cell(statsTable, 0, 2, 'Std Dev:', text_color = color.white, text_halign = text.align_left)
    table.cell(statsTable, 1, 2, str.tostring(stddev, '#.#####'), text_color = color.white, text_halign = text.align_right)

    // Highlight kurtosis based on its value (positive indicates fat tails).
    table.cell(statsTable, 0, 3, 'Kurtosis:', text_color = color.white, text_halign = text.align_left, bgcolor = k > 0 ? color.new(color.red, 50) : color.new(color.blue, 50))
    table.cell(statsTable, 1, 3, str.tostring(k, '#.##'), text_color = color.white, text_halign = text.align_right, bgcolor = k > 0 ? color.new(color.red, 50) : color.new(color.blue, 50))
