//@version=6
indicator("Max Position Size Calculator (HoD/LoD)", overlay=true)

// === Inputs ===
max_loss    = input.float(100.0, title="Max Loss Amount ($)", tooltip="Maximum amount of money you are willing to lose on this trade.")
table_pos   = input.string("Bottom Right", title="Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"])
bg_color    = input(color.new(color.black, 80), title="Background Color")
text_color  = input(color.white, title="Text Color")

// Stop Dist % Colors
grp_colors       = "Stop Dist % Colors"
use_static_color = input.bool(false, title="Use Static Colors for Stop Dist %", group=grp_colors)
col_static_long  = input.color(color.green, title="Static Color (Long)", group=grp_colors)
col_static_short = input.color(color.red,   title="Static Color (Short)", group=grp_colors)
col_dist_1       = input.color(color.aqua,   title="< 1% Color (Dynamic)", group=grp_colors)
col_dist_2       = input.color(color.green,  title="1% - 1.5% Color (Dynamic)", group=grp_colors)
col_dist_3       = input.color(color.yellow, title="1.5% - 2% Color (Dynamic)", group=grp_colors)
col_dist_4       = input.color(color.red,    title="2%+ Color (Dynamic)", group=grp_colors)

// === Intraday HoD / LoD Tracking ===
var float hod = na
var float lod = na

// Check for a new trading day (Evaluates to a boolean)
is_new_day = time("D") != time("D")[1]

// Update HoD and LoD
if is_new_day
    hod := high
    lod := low
else
    hod := math.max(hod, high)
    lod := math.min(lod, low)

// === Calculations ===
// Risk per share assumes entry at current close and stop loss at LoD (for Long) or HoD (for Short)
risk_long  = close - lod
risk_short = hod - close

// Calculate max shares (using math.floor to ensure we don't exceed the max loss risk)
max_shares_long  = risk_long > 0 ? math.floor(max_loss / risk_long) : 0
max_shares_short = risk_short > 0 ? math.floor(max_loss / risk_short) : 0

// Total Capital Required for the position
pos_size_long  = max_shares_long * close
pos_size_short = max_shares_short * close

// Distance Percentage Calculations
lod_dist_pct = risk_long > 0 ? (risk_long / close) * 100 : 0
hod_dist_pct = risk_short > 0 ? (risk_short / close) * 100 : 0

// Color Logic for Percentages
get_dist_color(pct) =>
    if pct < 1.0
        col_dist_1
    else if pct < 1.5
        col_dist_2
    else if pct < 2.0
        col_dist_3
    else
        col_dist_4

// Apply either static or dynamic color based on user input
color_long_dist  = use_static_color ? col_static_long : get_dist_color(lod_dist_pct)
color_short_dist = use_static_color ? col_static_short : get_dist_color(hod_dist_pct)

// === Table Rendering ===
pos = switch table_pos
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right

// Create a table with 3 columns and 6 rows (Expanded for the empty top row)
var table t = table.new(pos, 3, 6, bgcolor=bg_color, border_width=1, border_color=color.gray)

if barstate.islast
    // Row 0: Empty Row on Top (Spacer)
    table.cell(t, 0, 0, "")
    table.cell(t, 1, 0, "")
    table.cell(t, 2, 0, "")

    // Row 1: Headers
    table.cell(t, 0, 1, "Risk: $" + str.tostring(max_loss, "#.##"), text_color=color.orange, text_halign=text.align_left)
    table.cell(t, 1, 1, "LONG", text_color=color.green, text_halign=text.align_center)
    table.cell(t, 2, 1, "SHORT", text_color=color.red, text_halign=text.align_center)

    // Row 2: % Distance 
    table.cell(t, 0, 2, "Stop Dist %", text_color=text_color, text_halign=text.align_left)
    table.cell(t, 1, 2, str.tostring(lod_dist_pct, "#.##") + "%", text_color=color_long_dist, text_halign=text.align_center)
    table.cell(t, 2, 2, str.tostring(hod_dist_pct, "#.##") + "%", text_color=color_short_dist, text_halign=text.align_center)

    // Row 3: Stop Levels
    table.cell(t, 0, 3, "Stop", text_color=text_color, text_halign=text.align_left)
    table.cell(t, 1, 3, str.tostring(lod, "#.##"), text_color=color.green, text_halign=text.align_center)
    table.cell(t, 2, 3, str.tostring(hod, "#.##"), text_color=color.red, text_halign=text.align_center)

    // Row 4: Shares
    table.cell(t, 0, 4, "Shares", text_color=text_color, text_halign=text.align_left)
    table.cell(t, 1, 4, str.tostring(max_shares_long, "#"), text_color=color.green, text_halign=text.align_center)
    table.cell(t, 2, 4, str.tostring(max_shares_short, "#"), text_color=color.red, text_halign=text.align_center)
    
    // Row 5: Capital Required
    table.cell(t, 0, 5, "Capital", text_color=color.gray, text_halign=text.align_left)
    table.cell(t, 1, 5, "$" + str.tostring(pos_size_long, "#"), text_color=color.gray, text_halign=text.align_center)
    table.cell(t, 2, 5, "$" + str.tostring(pos_size_short, "#"), text_color=color.gray, text_halign=text.align_center)