lev_19 = input.string("", "Levels 19 Input")

show_20 = input.bool(true, "Show Levels for Stock 20")
sym_20 = input.string("", "Stock 20 Symbol")
lev_20 = input.string("", "Levels 20 Input")

// === Flexible color logic for notes ===
getColor(note) =>
    n = str.lower(str.trim(note))
    n := str.replace_all(n, "\\s{2,}", " ") 
    col = if str.contains(n, "cautionary") or str.contains(n, "critical")
        color.red
    else if str.contains(n, "daily 200 ema")
        color.new(color.yellow, 0)
    else if str.contains(n, "daily 50 ema")
        color.new(color.blue, 0)
    else if str.contains(n, "daily 34 ema")
        color.new(color.gray, 0)
    else if str.contains(n, "daily 9 ema") or str.contains(n, "daily 9ema")
        color.new(color.green, 0)
    else
        defaultLevelColor  // Use user-selected default color instead of hardcoded white
    col

// === Draw a single level line AND a label ===
drawLevel(levelVal, noteStr, showFlag, showAllLabelsFlag) =>
    log.info("DEBUG: drawLevel - Called for Level: {0}, Note: '{1}', showFlag: {2}, bar_index: {3}, barstate.islast: {4}, showAllLabelsFlag: {5}", 
             levelVal, noteStr, showFlag, bar_index, barstate.islast, showAllLabelsFlag) 
    
    if not na(levelVal) and showFlag 
        col = getColor(noteStr)
        lineStyle = getLineStyle(defaultLineStyle)
        
        // Draw the line extending across the entire chart
        line.new(bar_index - 1, levelVal, bar_index, levelVal, color=col, width=1, extend=extend.both, style=lineStyle)

        // Generate label text
        string labelText = str.tostring(levelVal, format.mintick) 
        if str.length(noteStr) > 0 
            labelText := labelText + " (" + noteStr + ")"
        
        // --- Label Visibility Logic ---
        color labelTextColor = color.white 
        color labelBackgroundColor = col   

        if (color.r(col) + color.g(col) + color.b(col) > 400) 
            labelTextColor := color.black
        // --- End Label Visibility Logic ---

        // Only draw label on the LAST bar for right-side visibility and less clutter
        // AND ONLY IF showAllLabelsFlag IS TRUE
        if barstate.islast and showAllLabelsFlag
            int labelX = bar_index + 60 // 60 bars to the right
            
            log.info("DEBUG: Creating label on LAST BAR - Text: '{0}', X_BarIndex: {1}, Y_Price: {2}, BgColor_RGB: ({3},{4},{5}), TextColor_RGB: ({6},{7},{8})", 
                     labelText, labelX, levelVal, 
                     color.r(labelBackgroundColor), color.g(labelBackgroundColor), color.b(labelBackgroundColor),
                     color.r(labelTextColor), color.g(labelTextColor), color.b(labelTextColor))

            label.new(x=labelX, y=levelVal, 
                      text=labelText, 
                      xloc=xloc.bar_index, 
                      yloc=yloc.price,     
                      color=labelBackgroundColor, 
                      textcolor=labelTextColor,   
                      style=label.style_label_left, 
                      size=size.small)
            
            log.info("DEBUG: Label successfully attempted for Level: {0} on LAST BAR", levelVal)
    else
        log.info("DEBUG: drawLevel - Skipping due to na(levelVal) or showFlag=false. Level: {0}, ShowFlag: {1}, bar_index: {2}", levelVal, showFlag, bar_index)


// === Parse and draw all levels for one stock input ===
drawLevels(raw, showFlag, showAllLabelsFlag) => 
    log.info("DEBUG: drawLevels - Raw input string: '{0}'", raw)
    normalizedSpaces = str.replace_all(raw, "\\s+", " ")
    log.info("DEBUG: drawLevels - After normalizing spaces: '{0}'", normalizedSpaces)

    temp = str.replace_all(normalizedSpaces, "([^\\s])=", "$1 =")
    temp := str.replace_all(temp, " =([^\\s])", "= $1")
    log.info("DEBUG: drawLevels - After adding spaces around '=': '{0}'", temp)

    safe = str.replace_all(temp, "=", "##")
    safe := str.trim(safe)
    log.info("DEBUG: drawLevels - After replacing '=' and final trim: '{0}'", safe)

    tokens = str.split(safe, " ")
    log.info("DEBUG: drawLevels - Number of tokens found: {0}", array.size(tokens))

    int i = 0 
    while i < array.size(tokens)
        part = str.trim(array.get(tokens, i))
        log.info("DEBUG: drawLevels - Processing token {0}: '{1}'", i, part)

        float level = na
        string note = ""

        if str.contains(part, "##daily") 
            string levelStr = str.trim(str.replace(part, "##daily", "")) 
            level := str.tonumber(levelStr)

            string notePart1 = i + 1 < array.size(tokens) ? str.trim(array.get(tokens, i + 1)) : ""
            string notePart2 = i + 2 < array.size(tokens) ? str.trim(array.get(tokens, i + 2)) : ""
            
            if str.length(notePart1) > 0 and str.length(notePart2) > 0
                note := "daily " + notePart1 + " " + notePart2
                i += 2 
            else if str.length(notePart1) > 0 
                note := "daily " + notePart1
                i += 1
            else
                note := "daily"
            
            log.info("DEBUG: drawLevels - Found '##daily': LevelStr='{0}', Reconstructed Note='{1}'", levelStr, note)

        else if str.contains(part, "##")
            parts = str.split(part, "##")
            string levelStr = str.trim(array.get(parts, 0))
            level := str.tonumber(levelStr)
            note := array.size(parts) > 1 ? str.trim(array.get(parts, 1)) : ""
            log.info("DEBUG: drawLevels - Found ##: LevelStr='{0}', Note='{1}'", levelStr, note)
        else
            level := str.tonumber(part)
            note := ""
            log.info("DEBUG: drawLevels - No ##: Attempted number='{0}', Level={1}", part, level)

        if not na(level)
            drawLevel(level, note, showFlag, showAllLabelsFlag)

        i += 1

// === Conditional rendering for each stock ===
lowerSym = str.lower(syminfo.ticker)

if lowerSym == str.lower(sym_1) and show_1
    drawLevels(lev_1, true, showLabels)
if lowerSym == str.lower(sym_2) and show_2
