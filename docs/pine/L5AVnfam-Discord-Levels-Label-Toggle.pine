lev_16 = input.string("", "Levels 16 Input")

show_17 = input.bool(true, "Show Levels for Stock 17")
sym_17 = input.string("", "Stock 17 Symbol")
lev_17 = input.string("", "Levels 17 Input")

show_18 = input.bool(true, "Show Levels for Stock 18")
