//@version=5
indicator("Discord Levels (Extended)", overlay=true, max_lines_count=500, max_labels_count=500) 

log.info("Indicator Start (Labels)")

// === Global Settings ===
bool showLabels = input.bool(true, "Show Price Labels", tooltip="Enable or disable price labels next to level lines.")
color defaultLevelColor = input.color(color.white, "Default Level Color", tooltip="Default color for levels without specific notes")
string defaultLineStyle = input.string("Solid", "Default Line Style", options=["Solid", "Dashed", "Dotted"])

// === Convert line style string to Pine Script constant ===
getLineStyle(styleStr) =>
    styleStr == "Dashed" ? line.style_dashed : styleStr == "Dotted" ? line.style_dotted : line.style_solid

// === Inputs for 20 stocks ===
show_1 = input.bool(true, "Show Levels for Stock 1")
sym_1 = input.string("", "Stock 1 Symbol")
lev_1 = input.string("", "Levels 1 Input")

