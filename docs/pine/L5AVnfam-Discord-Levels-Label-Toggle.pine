lev_9 = input.string("", "Levels 9 Input")

show_10 = input.bool(true, "Show Levels for Stock 10")
sym_10 = input.string("", "Stock 10 Symbol")
lev_10 = input.string("", "Levels 10 Input")

show_11 = input.bool(true, "Show Levels for Stock 11")
sym_11 = input.string("", "Stock 11 Symbol")
lev_11 = input.string("", "Levels 11 Input")

show_12 = input.bool(true, "Show Levels for Stock 12")
sym_12 = input.string("", "Stock 12 Symbol")
lev_12 = input.string("", "Levels 12 Input")

