//@version=5
indicator("FVG 9:31–10:00 AM ET", overlay=true)

// === USER INPUT: Extend FVG Box to the Right ===
extendBars = input.int(0, title="Extend FVG Box (Bars)", minval=0, tooltip="Number of bars to extend the FVG box to the right")

// === HARD-CODED TIME WINDOW (Eastern Time) ===
startHour = 9
startMin  = 31
endHour   = 10
endMin    = 0

// === DAILY RESET: Only one FVG per day ===
var bool fvgDetectedToday = false
if ta.change(time("D"))
    fvgDetectedToday := false

// === REFERENCE TIME USING BAR[2] (FVG forms at bar_index - 2) ===
fvgBarTime = time[2]
y = year(fvgBarTime)
m = month(fvgBarTime)
d = dayofmonth(fvgBarTime)

startTime = timestamp("America/New_York", y, m, d, startHour, startMin)
endTime   = timestamp("America/New_York", y, m, d, endHour, endMin)

inTimeWindow = fvgBarTime >= startTime and fvgBarTime <= endTime

// === FVG DETECTION: 3-bar imbalance pattern ===
bullFVG = low[1] > high[3]  // Bullish FVG: gap up
bearFVG = high[1] < low[3]  // Bearish FVG: gap down
isFVG = (bullFVG or bearFVG) and inTimeWindow and not fvgDetectedToday

// === VARIABLES FOR BOX AND ZONE TRACKING ===
var box  fvgBox = na
var float fvgTop = na
var float fvgBot = na

// === DRAW FVG IF DETECTED ===
if isFVG
    // Define FVG zone price levels
    fvgTop := bullFVG ? low[1] : low[3]
    fvgBot := bullFVG ? high[3] : high[1]
    
    // Define box boundaries fixed to FVG formation time with extension
    leftBar = bar_index - 3    // Bar [3], start of FVG pattern
    rightBar = bar_index - 1 + extendBars    // Bar [1] plus extension

    // Draw semi-transparent purple box covering the FVG formation bars
    fvgBox := box.new(
         left=leftBar,
         right=rightBar,
         top=fvgTop,
         bottom=fvgBot,
         bgcolor=color.new(color.purple, 70),
         border_color=color.purple,
         xloc=xloc.bar_index
     )

    // Add label above or below FVG
    label.new(
         x=bar_index - 2,    // Bar [2], middle of FVG
         y=bullFVG ? fvgTop + syminfo.mintick * 3 : fvgBot - syminfo.mintick * 3,
         text="FVG",
         style=bullFVG ? label.style_label_down : label.style_label_up,
         size=size.small,
         color=color.purple,
         textcolor=color.white,
         xloc=xloc.bar_index
     )

    // Mark as detected for the day
    fvgDetectedToday := true

// === ALERT CONDITION: Price re-enters FVG zone ===
bool inFvgZone = not na(fvgTop) and not na(fvgBot) and high >= fvgBot and low <= fvgTop
alertcondition(inFvgZone, 
     title="FVG Retest Alert", 
     message="Price is retesting the 9:31–10:00 AM Fair Value Gap zone.")