//@version=6
// @description Common Library
library("CL", overlay=true)

export type TCandle
    varip int barIndex = na
    varip int timeOpen = na
    varip int timeClose = na
    varip float open = na
    varip float high = na
    varip float low = na
    varip float close = na
    varip bool isFixed = false
    varip float realBodyUpperPrice = na
    varip float realBodyLowerPrice = na
    varip int barIndex_ctf = na //ctf = Current Time Frame

export method updateRealBodyPrices(TCandle candle) =>
    if candle.open < candle.close
        //陽線の場合
        candle.realBodyUpperPrice := candle.close
        candle.realBodyLowerPrice := candle.open
    else
        //陰線または十字線の場合
        candle.realBodyUpperPrice := candle.open
        candle.realBodyLowerPrice := candle.close

export method indexOfBarIndex(TCandle[] candle_array, int barIndex) =>
    int idxReturn = (candle_array.size() - 1) - (candle_array.last().barIndex - barIndex)

export method getCandleByBarIndex(TCandle[] candle_array, int barIndex) =>
    TCandle cReturn = na
    int idx = candle_array.indexOfBarIndex(barIndex)
    if idx >= 0 and idx < candle_array.size()
        cReturn := candle_array.get(idx)
    cReturn

export type TCandleSet
    varip string tickerid
    varip string timeframe
    varip TCandle currentCandle = na
    varip TCandle lastFixedCandle = na
    varip TCandle[] candleArray
    varip int minBarIndex = na
    varip int minCandleCount = na

export newCandleSet(string tickerid, string timeframe) =>
    TCandleSet candleSet = TCandleSet.new(tickerid=tickerid, timeframe=timeframe)
    candleSet.candleArray := array.new<TCandle>(size=0)
    candleSet

export type TPivot
    varip int barIndex
    varip float price
    varip bool isHigh
    varip bool isFixed = false
    varip int barIndex_ctf
    varip int timeOpen

export method copyTo(TPivot src, TPivot dest) =>
    dest.barIndex := src.barIndex
    dest.price := src.price
    dest.isHigh := src.isHigh
    dest.isFixed := src.isFixed
    dest.barIndex_ctf := src.barIndex_ctf
    dest.timeOpen := src.timeOpen

export type TTrendReversalPoint
    varip int id = na
    varip int trendDirection = na
    varip int barIndex
    varip float price_Highest = na          //最高値
    varip int barIndex_Highest = na
    varip int barIndex_ctf_Highest = na
    varip float price_Lowest = na           //最高値
    varip int barIndex_Lowest = na           
    varip int barIndex_ctf_Lowest = na           
    varip float price_HigherLow = na        //押し安値
    varip int barIndex_HigherLow = na        
    varip int barIndex_ctf_HigherLow = na        
    varip float price_LowerHigh = na        //戻り高値
    varip int barIndex_LowerHigh = na        
    varip int barIndex_ctf_LowerHigh = na        
    varip float price_FirstHigherLow = na   //トレンド転換直後の押し安値
    varip int barIndex_FirstHigherLow = na   
    varip int barIndex_ctf_FirstHigherLow = na   
    varip float price_FirstLowerHigh = na   //トレンド転換直後の戻り高値
    varip int barIndex_FirstLowerHigh = na   
    varip int barIndex_ctf_FirstLowerHigh = na   
    varip bool isDeleted = false
    varip int barIndex_Created_ctf = na
    varip int barIndex_Deleted_ctf = na
    varip int barIndex_ctf
    varip int timeReversal
    varip int barIndexValid = na
    varip int barIndexSnapshotValid = na

export method copyPivotHL_LHtoFirst(TTrendReversalPoint trp) =>
    trp.price_FirstHigherLow := trp.price_HigherLow
    trp.barIndex_FirstHigherLow := trp.barIndex_HigherLow
    trp.price_FirstLowerHigh := trp.price_LowerHigh
    trp.barIndex_FirstLowerHigh := trp.barIndex_LowerHigh

export method copyTo(TTrendReversalPoint src, TTrendReversalPoint dest) =>
    dest.trendDirection := src.trendDirection
    dest.barIndex := src.barIndex
    dest.barIndex_ctf := src.barIndex_ctf
    dest.price_Highest := src.price_Highest
    dest.barIndex_Highest := src.barIndex_Highest
    dest.barIndex_ctf_Highest := src.barIndex_ctf_Highest
    dest.price_Lowest := src.price_Lowest
    dest.barIndex_Lowest := src.barIndex_Lowest
    dest.barIndex_ctf_Lowest := src.barIndex_ctf_Lowest
    dest.price_HigherLow := src.price_HigherLow
    dest.barIndex_HigherLow := src.barIndex_HigherLow
    dest.barIndex_ctf_HigherLow := src.barIndex_ctf_HigherLow
    dest.price_LowerHigh := src.price_LowerHigh
    dest.barIndex_LowerHigh := src.barIndex_LowerHigh
    dest.barIndex_ctf_LowerHigh := src.barIndex_ctf_LowerHigh
    dest.price_FirstHigherLow := src.price_FirstHigherLow
    dest.barIndex_FirstHigherLow := src.barIndex_FirstHigherLow
    dest.barIndex_ctf_FirstHigherLow := src.barIndex_ctf_FirstHigherLow
    dest.price_FirstLowerHigh := src.price_FirstLowerHigh
    dest.barIndex_FirstLowerHigh := src.barIndex_FirstLowerHigh
    dest.barIndex_ctf_FirstLowerHigh := src.barIndex_ctf_FirstLowerHigh
    dest.isDeleted := src.isDeleted
    dest.barIndex_Created_ctf := src.barIndex_Created_ctf
    dest.barIndex_Deleted_ctf := src.barIndex_Deleted_ctf
    dest.timeReversal := src.timeReversal



export type TPoolManager
	varip TCandle[] all_candle = na
	varip TCandle[] pool_candle = na
	varip TPivot[] all_pivot = na
	varip TPivot[] pool_pivot = na
	varip TTrendReversalPoint[] all_trp = na
	varip TTrendReversalPoint[] pool_trp = na

export newPoolManager() =>
	TPoolManager poolManager = TPoolManager.new()
	poolManager.all_candle := array.new<TCandle>(size=0)
	poolManager.pool_candle := array.new<TCandle>(size=0)
	poolManager.all_pivot := array.new<TPivot>(size=0)
	poolManager.pool_pivot := array.new<TPivot>(size=0)
	poolManager.all_trp := array.new<TTrendReversalPoint>(size=0)
	poolManager.pool_trp := array.new<TTrendReversalPoint>(size=0)
	poolManager

export method newCandleFromPool(TPoolManager poolManager) =>
    TCandle candleNew = na
    if poolManager.pool_candle.size() == 0
        candleNew := TCandle.new()
        poolManager.all_candle.push(candleNew)
        true
    else
        candleNew := poolManager.pool_candle.shift()
        candleNew.barIndex := na
        candleNew.timeOpen := na
        candleNew.timeClose := na
        candleNew.open := na
        candleNew.high := na
        candleNew.low := na
        candleNew.close := na
        candleNew.isFixed := false
        candleNew.realBodyUpperPrice := na
        candleNew.realBodyLowerPrice := na
        candleNew.barIndex_ctf := na
        true
    candleNew

export method newPivotFromPool(TPoolManager poolManager) =>
    TPivot pivotNew = na
    if poolManager.pool_pivot.size() == 0
        pivotNew := TPivot.new()
        poolManager.all_pivot.push(pivotNew)
        true
    else
        pivotNew := poolManager.pool_pivot.shift()
        pivotNew.barIndex := na
        pivotNew.price := na
        pivotNew.isHigh := false
        pivotNew.isFixed := false
        pivotNew.barIndex_ctf := na
        pivotNew.timeOpen := na
        true
    pivotNew

export method newTrendReversalPointFromPool(TPoolManager poolManager) =>
    TTrendReversalPoint trpNew = na
    if poolManager.pool_trp.size() == 0
        trpNew := TTrendReversalPoint.new()
        poolManager.all_trp.push(trpNew)
    else
        trpNew := poolManager.pool_trp.shift()
        trpNew.id := na
        trpNew.trendDirection := na
        trpNew.barIndex := na
        trpNew.price_Highest := na
        trpNew.barIndex_Highest := na
        trpNew.barIndex_ctf_Highest := na
        trpNew.price_Lowest := na
        trpNew.barIndex_Lowest := na
        trpNew.barIndex_ctf_Lowest := na
        trpNew.price_HigherLow := na
        trpNew.barIndex_HigherLow := na
        trpNew.barIndex_ctf_HigherLow := na
        trpNew.price_LowerHigh := na
        trpNew.barIndex_LowerHigh := na
        trpNew.barIndex_ctf_LowerHigh := na
        trpNew.price_FirstHigherLow := na
        trpNew.barIndex_FirstHigherLow := na
        trpNew.barIndex_ctf_FirstHigherLow := na
        trpNew.price_FirstLowerHigh := na
        trpNew.barIndex_FirstLowerHigh := na
        trpNew.barIndex_ctf_FirstLowerHigh := na
        trpNew.isDeleted := false
        trpNew.barIndex_Created_ctf := na
        trpNew.barIndex_Deleted_ctf := na
        trpNew.barIndex_ctf := na
        trpNew.timeReversal := na
        trpNew.barIndexSnapshotValid := na
    trpNew

export method newTrendReversalPoint(TPoolManager poolManager, int trendDirection, int barIndex, int barIndex_ctf, int time_reversal) =>
    TTrendReversalPoint trpNew = poolManager.newTrendReversalPointFromPool()
    trpNew.trendDirection := trendDirection
    trpNew.barIndex := barIndex
    trpNew.barIndex_ctf := barIndex_ctf
    trpNew.barIndex_Created_ctf := bar_index
    trpNew.timeReversal := time_reversal
    trpNew
