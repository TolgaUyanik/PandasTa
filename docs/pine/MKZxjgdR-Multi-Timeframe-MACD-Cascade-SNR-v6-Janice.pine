//@version=6
strategy("Multi-Timeframe MACD Cascade & SNR v6", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

var_ema_len    = input.int(52, title="EMA Length", group="EMA Settings")
vol_ma_len     = input.int(20, title="Volume MA Length", group="Volume Settings")
vol_multiplier = input.float(1.5, title="Volume Multiplier", group="Volume Settings")

ema52 = ta.ema(close, var_ema_len)
plot(ema52, color=color.blue, title="EMA 52")

f_macd_cross(_src) =>
    [macdLine, signalLine, _] = ta.macd(_src, 12, 26, 9)
    cross_up   = ta.crossover(macdLine, 0)
    cross_down = ta.crossunder(macdLine, 0)
    [cross_up, cross_down]

[m15_up, m15_down]   = request.security(syminfo.tickerid, "15", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)
[m30_up, m30_down]   = request.security(syminfo.tickerid, "30", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)
[m45_up, m45_down]   = request.security(syminfo.tickerid, "45", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)
[h1_up,  h1_down]    = request.security(syminfo.tickerid, "60", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)
[m90_up, m90_down]   = request.security(syminfo.tickerid, "90", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)
[h2_up,  h2_down]    = request.security(syminfo.tickerid, "120", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)
[h3_up,  h3_down]    = request.security(syminfo.tickerid, "180", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)
[h4_up,  h4_down]    = request.security(syminfo.tickerid, "240", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)
[h8_up,  h8_down]    = request.security(syminfo.tickerid, "480", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)
[h12_up, h12_down]   = request.security(syminfo.tickerid, "720", f_macd_cross(close), barmerge.gaps_off, barmerge.lookahead_off)

var bool count_bullish_cascade = false
var bool count_bearish_cascade = false

if m15_up
    count_bullish_cascade := true
if count_bullish_cascade and m30_up
    count_bullish_cascade := true
if count_bullish_cascade and m45_up
    count_bullish_cascade := true

bullish_momentum = count_bullish_cascade and (h1_up or m90_up or h2_up or h3_up or h4_up or h8_up or h12_up)

if m15_down
    count_bearish_cascade := true
if count_bearish_cascade and m30_down
    count_bearish_cascade := true
if count_bearish_cascade and m45_down
    count_bearish_cascade := true

bearish_momentum = count_bearish_cascade and (h1_down or m90_down or h2_down or h3_down or h4_down or h8_down or h12_down)

f_snr_zone() =>
    top_zone_high = high
    top_zone_low  = math.max(open, close)
    bot_zone_high = math.min(open, close)
    bot_zone_low  = low
    [top_zone_high, top_zone_low, bot_zone_high, bot_zone_low]

[snr_t_h, snr_t_l, snr_b_h, snr_b_l] = request.security(syminfo.tickerid, "240", f_snr_zone(), barmerge.gaps_off, barmerge.lookahead_off)

plot(snr_t_h, color=color.new(color.red, 50), title="4H SNR Resistance Top")
plot(snr_t_l, color=color.new(color.red, 70), title="4H SNR Resistance Bottom")
plot(snr_b_h, color=color.new(color.green, 70), title="4H SNR Support Top")
plot(snr_b_l, color=color.new(color.green, 50), title="4H SNR Support Bottom")

vol_ma = ta.sma(volume, vol_ma_len)
high_volume = volume > (vol_ma * vol_multiplier)

bool buy_condition  = bullish_momentum and (low <= snr_b_h and high >= snr_b_l) and (close >= ema52 * 0.998 and close <= ema52 * 1.002) and high_volume and close > open
bool sell_condition = bearish_momentum and (high >= snr_t_l and low <= snr_t_h) and (close >= ema52 * 0.998 and close <= ema52 * 1.002) and high_volume and close < open

if buy_condition
    strategy.entry("Buy", strategy.long)
    count_bullish_cascade := false

if sell_condition
    strategy.entry("Sell", strategy.short)
    count_bearish_cascade := false

if strategy.position_size > 0
    strategy.exit("Exit Buy", "Buy", stop=snr_b_l - ta.atr(14), limit=snr_t_l)
if strategy.position_size < 0
    strategy.exit("Exit Sell", "Sell", stop=snr_t_h + ta.atr(14), limit=snr_b_h)