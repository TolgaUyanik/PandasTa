//@version=6
indicator(
     "Trinity 5-Minute Candle",
     overlay = true,
     max_boxes_count = 100,
     max_lines_count = 100
)

// ============================================================================
// Inputs
// ============================================================================

candleCount = input.int(
     20,
     "Number of 5-minute candles",
     minval = 3,
     maxval = 90
)

rightOffset = input.int(
     5,
     "Distance from chart",
     minval = 1,
     maxval = 100
)

candleWidth = input.int(
     2,
     "Candle width",
     minval = 1,
     maxval = 5
)

candleSpacing = input.int(
     1,
     "Space between candles",
     minval = 0,
     maxval = 5
)

bullBodyColor = input.color(
     color.rgb(38, 166, 154),
     "Bullish body"
)

bearBodyColor = input.color(
     color.rgb(239, 83, 80),
     "Bearish body"
)

bullBorderColor = input.color(
     color.rgb(38, 166, 154),
     "Bullish border"
)

bearBorderColor = input.color(
     color.rgb(239, 83, 80),
     "Bearish border"
)

bullWickColor = input.color(
     color.rgb(38, 166, 154),
     "Bullish wick"
)

bearWickColor = input.color(
     color.rgb(239, 83, 80),
     "Bearish wick"
)

borderWidth = input.int(
     1,
     "Body border width",
     minval = 1,
     maxval = 4
)

wickWidth = input.int(
     1,
     "Wick width",
     minval = 1,
     maxval = 4
)

// ============================================================================
// Chart timeframe autodetection
// ============================================================================

int chartTfSeconds = timeframe.in_seconds()

bool supportedChartTf =
     chartTfSeconds == 5 or
     chartTfSeconds == 10 or
     chartTfSeconds == 15 or
     chartTfSeconds == 30 or
     chartTfSeconds == 60

if not supportedChartTf
    runtime.error(
         "Trinity 5-Minute Candle supports 5-second, 10-second, 15-second, 30-second, and 1-minute charts only."
    )

// ============================================================================
// Stored 5-minute OHLC data
// ============================================================================

var array<float> fiveMinuteOpens  = array.new_float()
var array<float> fiveMinuteHighs  = array.new_float()
var array<float> fiveMinuteLows   = array.new_float()
var array<float> fiveMinuteCloses = array.new_float()

// Opening timestamp of the exchange-aligned 5-minute period.
int currentFiveMinuteTime = time("5")

// A new synthetic candle begins whenever the 5-minute timestamp changes.
//
// Number of chart bars per 5-minute candle:
//
// 5-second chart:  60 bars
// 10-second chart: 30 bars
// 15-second chart: 20 bars
// 30-second chart: 10 bars
// 1-minute chart:   5 bars
bool newFiveMinuteCandle =
     ta.change(currentFiveMinuteTime) != 0

// ============================================================================
// Build synthetic 5-minute candles
// ============================================================================

if array.size(fiveMinuteOpens) == 0
    // Initialize the first available 5-minute candle.
    array.push(fiveMinuteOpens, open)
    array.push(fiveMinuteHighs, high)
    array.push(fiveMinuteLows, low)
    array.push(fiveMinuteCloses, close)

else if newFiveMinuteCandle
    // Start a new synthetic 5-minute candle.
    array.push(fiveMinuteOpens, open)
    array.push(fiveMinuteHighs, high)
    array.push(fiveMinuteLows, low)
    array.push(fiveMinuteCloses, close)

else
    // Update the currently active 5-minute candle.
    int lastIndex =
         array.size(fiveMinuteOpens) - 1

    float existingHigh =
         array.get(fiveMinuteHighs, lastIndex)

    float existingLow =
         array.get(fiveMinuteLows, lastIndex)

    array.set(
         fiveMinuteHighs,
         lastIndex,
         math.max(existingHigh, high)
    )

    array.set(
         fiveMinuteLows,
         lastIndex,
         math.min(existingLow, low)
    )

    array.set(
         fiveMinuteCloses,
         lastIndex,
         close
    )

// Retain only the maximum selectable number of candles.
if array.size(fiveMinuteOpens) > 90
    array.shift(fiveMinuteOpens)
    array.shift(fiveMinuteHighs)
    array.shift(fiveMinuteLows)
    array.shift(fiveMinuteCloses)

// ============================================================================
// Drawing-object storage
// ============================================================================

var array<box> candleBodies = array.new_box()
var array<line> candleWicks = array.new_line()

// ============================================================================
// Clear previous drawings
// ============================================================================

clearDrawings() =>
    while array.size(candleBodies) > 0
        box.delete(array.pop(candleBodies))

    while array.size(candleWicks) > 0
        line.delete(array.pop(candleWicks))

// ============================================================================
// Draw the 5-minute candle panel
// ============================================================================

if barstate.islast
    clearDrawings()

    int availableCandles =
         array.size(fiveMinuteOpens)

    int candlesToDraw =
         math.min(candleCount, availableCandles)

    int firstDataIndex =
         availableCandles - candlesToDraw

    int candleStep =
         candleWidth + candleSpacing

    // bar_index drawings cannot extend more than approximately
    // 500 chart bars into the future.
    int requiredFutureBars =
         rightOffset +
         ((candlesToDraw - 1) * candleStep) +
         candleWidth

    if requiredFutureBars > 499
        runtime.error(
             "The current candle width, spacing, distance, and candle-count settings place the panel more than 499 chart bars into the future. Reduce one of those settings."
        )

    for displayIndex = 0 to candlesToDraw - 1
        int dataIndex =
             firstDataIndex + displayIndex

        float candleOpen =
             array.get(fiveMinuteOpens, dataIndex)

        float candleHigh =
             array.get(fiveMinuteHighs, dataIndex)

        float candleLow =
             array.get(fiveMinuteLows, dataIndex)

        float candleClose =
             array.get(fiveMinuteCloses, dataIndex)

        bool bullish =
             candleClose >= candleOpen

        color bodyColor =
             bullish
             ? bullBodyColor
             : bearBodyColor

        color bodyBorderColor =
             bullish
             ? bullBorderColor
             : bearBorderColor

        color wickColor =
             bullish
             ? bullWickColor
             : bearWickColor

        // Oldest candle appears on the left.
        // Newest candle appears on the right.
        int candleLeft =
             bar_index +
             rightOffset +
             displayIndex * candleStep

        int candleRight =
             candleLeft + candleWidth

        int wickX =
             candleLeft +
             int(math.floor(candleWidth / 2.0))

        float bodyTop =
             math.max(candleOpen, candleClose)

        float bodyBottom =
             math.min(candleOpen, candleClose)

        line newWick = line.new(
             x1 = wickX,
             y1 = candleHigh,
             x2 = wickX,
             y2 = candleLow,
             xloc = xloc.bar_index,
             extend = extend.none,
             color = wickColor,
             style = line.style_solid,
             width = wickWidth
        )

        box newBody = box.new(
             left = candleLeft,
             top = bodyTop,
             right = candleRight,
             bottom = bodyBottom,
             xloc = xloc.bar_index,
             border_color = bodyBorderColor,
             border_width = borderWidth,
             bgcolor = bodyColor
        )

        array.push(candleWicks, newWick)
        array.push(candleBodies, newBody)