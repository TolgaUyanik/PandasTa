//@version=6
indicator(
     "Stop ATR A [20] [2,00] - Estilo Profit",
     shorttitle = "Stop ATR Profit",
     overlay = true,
     behind_chart = false
)

//==================================================
// CONFIGURAÇÕES
//==================================================
periodo = input.int(
     20,
     title = "Período",
     minval = 1,
     group = "Stop ATR"
)

desvio = input.float(
     2.0,
     title = "Desvio",
     minval = 0.1,
     step = 0.1,
     group = "Stop ATR"
)

mostrarSinais = input.bool(
     true,
     title = "Mostrar sinais de reversão",
     group = "Sinais"
)

confirmarFechamento = input.bool(
     true,
     title = "Confirmar somente no fechamento",
     group = "Sinais"
)

corAlta = input.color(
     color.lime,
     title = "Cor da tendência de alta",
     group = "Aparência"
)

corBaixa = input.color(
     color.yellow,
     title = "Cor da tendência de baixa",
     group = "Aparência"
)

espessura = input.int(
     2,
     title = "Espessura da linha",
     minval = 1,
     maxval = 5,
     group = "Aparência"
)

//==================================================
// TRUE RANGE
//==================================================
trueRange = math.max(
     high - low,
     math.max(
         math.abs(high - close[1]),
         math.abs(low - close[1])
     )
)

//==================================================
// ATR ARITMÉTICO
// Profit: Tipo de média = Aritmética
//==================================================
atrAritmetico = ta.sma(trueRange, periodo)
distanciaATR   = atrAritmetico * desvio

// Stops candidatos, calculados com base no fechamento.
stopCompraCandidato = close - distanciaATR
stopVendaCandidato  = close + distanciaATR

//==================================================
// CONTROLE DE TENDÊNCIA
//  1 = tendência de alta
// -1 = tendência de baixa
//==================================================
var int tendencia = 0
var float stopATR = na

mediaReferencia = ta.sma(close, periodo)

podeAtualizar = confirmarFechamento ? barstate.isconfirmed : true

if podeAtualizar and not na(atrAritmetico)

    // Inicialização do indicador
    if tendencia == 0
        tendencia := close >= mediaReferencia ? 1 : -1

        stopATR := tendencia == 1
             ? stopCompraCandidato
             : stopVendaCandidato

    // Tendência de alta:
    // stop fica abaixo do preço e somente pode subir.
    else if tendencia == 1

        stopAnterior = stopATR

        // Reversão somente se o candle fechar abaixo da linha.
        if close < stopAnterior
            tendencia := -1
            stopATR := stopVendaCandidato
        else
            stopATR := math.max(
                 stopAnterior,
                 stopCompraCandidato
             )

    // Tendência de baixa:
    // stop fica acima do preço e somente pode cair.
    else

        stopAnterior = stopATR

        // Reversão somente se o candle fechar acima da linha.
        if close > stopAnterior
            tendencia := 1
            stopATR := stopCompraCandidato
        else
            stopATR := math.min(
                 stopAnterior,
                 stopVendaCandidato
             )

//==================================================
// SINAIS DE REVERSÃO
//==================================================
reversaoAlta =
     podeAtualizar and
     tendencia == 1 and
     tendencia[1] == -1

reversaoBaixa =
     podeAtualizar and
     tendencia == -1 and
     tendencia[1] == 1

//==================================================
// PLOTAGEM EM DEGRAUS
//==================================================
plot(
     stopATR,
     title = "Stop ATR",
     color = tendencia == 1 ? corAlta : corBaixa,
     linewidth = espessura,
     style = plot.style_stepline
)

//==================================================
// MARCAÇÕES NO GRÁFICO
//==================================================
plotshape(
     mostrarSinais and reversaoAlta,
     title = "Reversão para alta",
     text = "ALTA",
     style = shape.labelup,
     location = location.belowbar,
     color = color.new(color.green, 0),
     textcolor = color.white,
     size = size.tiny
)

plotshape(
     mostrarSinais and reversaoBaixa,
     title = "Reversão para baixa",
     text = "BAIXA",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.new(color.red, 0),
     textcolor = color.white,
     size = size.tiny
)

//==================================================
// ALERTAS
//==================================================
alertcondition(
     reversaoAlta,
     title = "Stop ATR — reversão para alta",
     message = "O candle fechou acima do Stop ATR. Reversão para tendência de alta."
)

alertcondition(
     reversaoBaixa,
     title = "Stop ATR — reversão para baixa",
     message = "O candle fechou abaixo do Stop ATR. Reversão para tendência de baixa."
)