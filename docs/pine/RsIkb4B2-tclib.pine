export momentum(series float source, int period_bar_length) =>
    old_price = source[period_bar_length - 1]
    100 * ((source - old_price) / old_price) / math.sqrt(period_bar_length - 1)

export smooth_atr(float atr_high, float atr_low, float atr_close, int smoothing_period) =>
    tr = math.max(atr_high - atr_low, atr_close[1] - atr_low, atr_high - atr_close[1])
    atr = super_smoother(tr, smoothing_period)
    atr

export atr_tick_multiple(float atr, float multiple) =>
    math.round((atr * multiple) / syminfo.mintick)