//@version=6
library("tclib")

export super_smoother(series float data, int smoothing_period) =>
    float filt = na

    a1 = math.exp(-math.sqrt(2) * math.pi / smoothing_period)
    c2 = 2 * a1 * math.cos(math.sqrt(2) * math.pi / smoothing_period)
    c3 = -a1 * a1
    c1 = 1 - c2 - c3

    filt := c1 * (nz(data, 0) + nz(data[1], 0)) / 2 + c2 * nz(filt[1], 0) + c3 * nz(filt[2], 0)
    
    filt

export upside_semivol(series float val, series float mean, int smoothing_period) =>
    sqr_upside_dev = math.pow(math.max(0, val - mean), 2)
    smooth_sqr_upside_dev = super_smoother(sqr_upside_dev, smoothing_period)
    semivol = math.sqrt(math.max(0, smooth_sqr_upside_dev))
    semivol

export downside_semivol(series float val, series float mean, int smoothing_period) =>
    sqr_downside_dev = math.pow(math.max(0, mean - val), 2)
    smooth_sqr_downside_dev = super_smoother(sqr_downside_dev, smoothing_period)
    semivol = math.sqrt(math.max(0, smooth_sqr_downside_dev))
    semivol

