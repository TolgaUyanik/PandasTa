//@version=5

// @description Provides a function to scale down a matrix into a smaller square format were its values are averaged to mantain matrix topology.
library("MatrixScaleDown")

// @function scale a matrix to a new smaller square size.
// @param	mat		Source matrix.
// @param	size	New matrix size.
// @returns New matrix with scaled down size. Source values will be averaged together.
export method scale_down (matrix<float> mat, int size) =>
	int _rsize = mat.rows()
	int _csize = mat.columns()
	//
	switch
		_rsize < 1 => runtime.error('Source matrix must have atleast 1 row!')
		_csize < 1 => runtime.error('Source matrix must have atleast 1 column!')
		_rsize <= size => runtime.error('Source matrix must have more rows than target size!')
		_csize <= size => runtime.error('Source matrix must have more columns than target size!')
	//
	float _rstep = size / _rsize
	float _cstep = size / _csize
	float _step_fr = _rstep * _rstep
	matrix<float> _nmat = matrix.new<float>(size, size, 0.0)
	for _r = 0 to _rsize-1
		int _tr = math.floor(_r * _rstep)
		for _c = 0 to _csize-1
			int _tc = math.floor(_c * _cstep)
			float _rc_value = mat.get(_r, _c) * _step_fr
			float _trc_value = _nmat.get(_tr, _tc) + _rc_value
			_nmat.set(_tr, _tc, _trc_value)
			// log.info(str.format('\n\t{0} ({3}) to {1}:{2}', _trc_value, _tr, _tc, _rc_value))
	_nmat

var TAB = table.new(position.bottom_right, 5, 5, #000000)
var m0 = matrix.new<float>(14, 14, 1.0)
if barstate.isfirst
	m0.add_row(4, array.new<float>(m0.columns(), 0.5))
	m0.add_col(9, array.new<float>(m0.rows(), 0.5))
var m1 = m0.scale_down(5)
if barstate.isfirst

	for _i = 0 to 4
		for _j = 0 to 4
			TAB.cell(_j, _i, str.tostring(m1.get(_i, _j), '#.##'))