//@version=6
// @description A library of Pine Script™ style functions.
library(title = 'StyleLibrary')

//#region Enumerations

// @enum                    An enumeration of box border styles.
// @field dashed            Dashed line style.
// @field dotted            Dotted line style.
// @field solid             Solid line style.
export enum boxBorderEnum
	dashed = 'Dashed'
	dotted = 'Dotted'
	solid = 'Solid'

// @enum                    An enumeration of extend styles.
// @field both              Extend drawing to both the left and right.
// @field left              Extend drawing to the left.
// @field none              Do not extend the drawing.
// @field right             Extend drawing to the right.
export enum extendEnum
    both = 'Both'
    left = 'Left'
    none = 'None'
    right = 'Right'

// @enum                    An enumeration of text font family styles.
// @field default           Default text font family.
// @field monospace         Monospace text font family.
export enum fontEnum
    default = 'Default'
    monospace = 'Monospace'

// @enum                    An enumeration of label styles.
// @field arrowDown         An Arrow Down label style.
// @field arrowUp           Arrow Up label style.
// @field circle            Circle label style.
// @field cross             Cross label style.
// @field diamond           Diamond label style.
// @field flag              Flag label style.
// @field center            Label Center label style.
// @field down              Label Down label style.
// @field left              Label Left label style.
// @field lowerLeft         Label Lower Left label style.
// @field lowerRight        Label Lower Right label style.
// @field right             Label Right label style.
// @field up                Label Up label style.
// @field upperLeft         Label Upper Left label style.
// @field upperRight        Label Upper Right label style.
// @field none              None label style.
// @field square            Square label style.
// @field textOutline       Text Outline label style.
// @field triangleDown      Triangle Down label style.
// @field triangleUp        Triangle Up label style.
// @field xCross            XCross label style.
export enum labelEnum
	arrowDown = 'Arrow Down'
	arrowUp = 'Arrow Up'
	circle = 'Circle'
	cross = 'Cross'
	diamond = 'Diamond'
	flag = 'Flag'
	center = 'Label Center'
	down = 'Label Down'
	left = 'Label Left'
	lowerLeft = 'Label Lower Left'
	lowerRight = 'Label Lower Right'
	right = 'Label Right'
	up = 'Label Up'
	upperLeft = 'Label Upper Left'
	upperRight = 'Label Upper Right'
	none = 'None'
	square = 'Square'
	textOutline = 'Text Outline'
	triangleDown = 'Triangle Down'
	triangleUp = 'Triangle Up'
	xCross = 'XCross'

// @enum                    An enumeration of line styles.
// @field arrowBoth         Solid line with an arrow on both points.
// @field arrowLeft         Solid line with an arrow on the first point.
// @field arrowRight        Solid line with an arrow on the second point.
// @field dashed            Dashed line style.
// @field dotted            Dotted line style.
// @field solid             Solid line style.
export enum lineEnum
    arrowBoth = 'Arrow Both'
    arrowLeft = 'Arrow Left'
    arrowRight = 'Arrow Right'
	dashed = 'Dashed'
	dotted = 'Dotted'
	solid = 'Solid'

// @enum                    An enumeration of plot styles.
// @field area              Area plot style.
// @field areaBreak         Area Break plot style.
// @field circles           Circles plot style.
// @field columns           Columns plot style.
// @field cross             Cross plot style.
// @field histogram         Histogram plot style.
// @field line              Line plot style.
// @field lineBreak         Line Break plot style.
// @field stepline          Stepline plot style.
// @field steplineDiamond   Stepline Diamond plot style.
export enum plotEnum
    area = 'Area'
    areaBreak = 'Area Break'
    circles = 'Circles'
    columns = 'Columns'
    cross = 'Cross'
    histogram = 'Histogram'
    line = 'Line'
    lineBreak = 'Line Break'
    stepline = 'Stepline'
    steplineDiamond = 'Stepline Diamond'

// @enum                    An enumeration of plot line styles.
// @field solid             Dashed line style.
// @field dashed            Dotted line style.
// @field dotted            Solid line style.
export enum plotLineEnum
    solid = 'Solid'
    dashed = 'Dashed'
    dotted = 'Dotted'

// @enum                    An enumeration of table position styles.
// @field bottomCenter      Binds the table to the bottom center edge in the screen.
// @field bottomLeft        Binds the table to the bottom left edge of the screen.
// @field bottomRight       Binds the table to the bottom right edge of the screen.
// @field middleCenter      Binds the table to the center of the screen
// @field middleLeft        Binds the table to the center left edge of the screen.
// @field middleRight       Binds the table to the center right edge of the screen.
// @field topCenter         Binds the table to the top edge in the screen.
// @field topLeft           Binds the table to the top left edge of the screen.
// @field topRight          Binds the table to the top right edge of the screen.
export enum positionEnum
    bottomCenter = 'Bottom Center'
    bottomLeft = 'Bottom Left'
    bottomRight = 'Bottom Right'
    middleCenter = 'Middle Center'
    middleLeft = 'Middle Left'
    middleRight = 'Middle Right'
    topCenter = 'Top Center'
    topLeft = 'Top Left'
    topRight = 'Top Right'

// @enum                    An enumeration of size styles.
// @field tiny              Tiny size style.
// @field small             Small size style.
// @field normal            Normal size style.
// @field large             Large size style.
// @field huge              Huge size style.
// @field auto              Auto size style.
// @field custom            Custom size style.
export enum sizeEnum
	tiny = 'Tiny'
	small = 'Small'
	normal = 'Normal'
	large = 'Large'
	huge = 'Huge'
	auto = 'Auto'
    custom = 'Custom'

// @enum                    An enumeration of horizontal text align styles.
// @field center            Text alignment to the center.
// @field left              Text alignment to the left.
// @field right             Text alignment to the right.
export enum textHAlignEnum
    center = 'Center'
    left = 'Left'
    right = 'Right'

// @enum                    An enumeration of vertical text align styles.
// @field bottom            Text alignment to the bottom.
// @field center            Text alignment to the center.
// @field top               Text alignment to the top.
export enum textVAlignEnum
    bottom = 'Bottom'
    center = 'Center'
    top = 'Top'

// @enum                    An enumeration of text wrap styles.
// @field auto              Automatic wrapping mode for text.
// @field none              Disabled wrapping mode for text.
export enum textWrapEnum
    auto = 'Auto'
    none = 'None'

//#endregion

//#region Types

// @type                    A type for custom numeric size values.
// @field tiny              Numeric size of the tiny size. Using `7` for labels, `8` for boxes and tables is recommended. Default is `8`.
// @field small             Numeric size of the small size. Using `10` for labels, boxes, and tables is recommended. Default is `10`.
// @field normal            Numeric size of the normal size. Using `12` for labels, or `14` for boxes and tables is recommended. Default is `14`.
// @field large             Numeric size of the large size. Using `18` for labels, or `20` for boxes and tables is recommended. Default is `20`.
// @field huge              Numeric size of the huge size. Using `24` for labels, or `36` for boxes and tables is recommended. Default is `36`.
// @field auto              Numeric size of the auto size. Using `0` for labels, boxes, and tables is recommended. Default is `0`.
// @field custom            Numeric size of a custom size. Default is `14`.
export type sizeNumericType
    int tiny = 8
    int small = 10
    int normal = 14
    int large = 20
    int huge = 36
    int auto = 0
    int custom = 14

//#endregion

//#region Functions

// @function                Takes a `string` and returns the corresponding built-in line style variable.
//
//                          Used in the `style` and `border_style` parameter for 
//                          [box.set_border_style()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_border_style) and
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new) respectively.
// @param style             A `string` representing a built-in line style variable.
// @returns                 The respective built-in line style variable.
//
//                          `'Dashed'`, `'Dotted'`, `'Solid'`.
//
//                          Strings are not case sensitive. Default is `''`.
// 
// **Usage**
//                          ```
//                          boxBorderInput = input.enum(sty.boxBorderEnum.solid, 'Box Border Style') 
//                          newBoxBorder = sty.boxBorder(str.tostring(boxBorderInput))
//                          ```
export method boxBorder(string style = '') =>
    switch str.upper(style)
        'DASHED' => line.style_dashed
        'DOTTED' => line.style_dotted
        'SOLID' => line.style_solid
        => line.style_solid

// @function                Takes a `boxBorderEnum` and returns the corresponding built-in line style variable.
//
//                          Used in the `style` and `border_style` parameter for 
//                          [box.set_border_style()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_border_style) and
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new) respectively.
// @param style             A `boxBorderEnum` representing a built-in line style variable.
// @returns                 The respective built-in line style variable.
//
// **Usage**
//                          ```
//                          boxBorderInput = input.enum(sty.boxBorderEnum.solid, 'Box Border Style') 
//                          newBoxBorder = sty.boxBorder(boxBorderInput)
//                          ```
export method boxBorder(boxBorderEnum style) =>
    switch style
        boxBorderEnum.dashed => line.style_dashed
        boxBorderEnum.dotted => line.style_dotted
        boxBorderEnum.solid => line.style_solid

// @function                Takes a `string` and returns the corresponding built-in extend style variable.
// 
//                          Used in the `extend` paramater for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new), 
//                          [box.set_extend()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_extend), 
//                          [line.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_line.new), and 
//                          [line.set_extend()](https://www.tradingview.com/pine-script-reference/v6/#fun_line.set_extend).
// @param style             Optional. A `string` representing a built-in extend style: 
// 
//                          `'Both'`, `'Left'`, `'None'`, `'Right'`.
// 
//                          Strings are not case sensitive. Default is `''`.
// @returns                 The respective built-in extend style variable. Misspelt or an empty `style` paramater 
//                          string will return `extend.none`.
// 
// **Usage**
//                          ```
//                          extendInput = input.enum(str.tostring(sty.extendEnum.right), 'Text Align') 
//                          ```
export method extend(string style = '') =>
    switch str.upper(style)
        'BOTH' => extend.both
        'LEFT' => extend.left
        'NONE' => extend.none
        'RIGHT' => extend.right
        => extend.none

// @function                Takes an `extendEnum` and returns the corresponding built-in extend style variable.
// 
//                          Used in the `extend` paramater for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new), 
//                          [box.set_extend()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_extend), 
//                          [line.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_line.new), and 
//                          [line.set_extend()](https://www.tradingview.com/pine-script-reference/v6/#fun_line.set_extend).
// @param style             An `extendEnum` representing a built-in extend style.
// @returns                 The respective built-in extend style variable.
//
// **Usage**
//                          ```
//                          extendInput = input.enum(sty.extendEnum.right, 'Text Align') 
//                          ```
export method extend(extendEnum style) =>
    switch style
        extendEnum.both => extend.both
        extendEnum.left => extend.left
        extendEnum.none => extend.none
        extendEnum.right => extend.right

// @function                Takes a `string` and returns the corresponding built-in font style variable.
//
//                          Used in the `text_font_family` parameter for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new), 
//                          [box.set_text_font_family()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_font_family), 
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new), 
//                          [label.set_text_font_family()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_text_font_family), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and
//                          [table.cell_set_text_font_family()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_font_family).
// @param style             Optional. A `string` representing a built-in font style: 
//
//                          `'Default'`, `'Monospace'`.
//
//                          Strings are not case sensitive. Default is `''`.
// @returns                 The respective built-in font style variable. Misspelt or an empty `style` parameter 
//                          string will return `font.family_default`.
//
// **Usage**
//                          ```
//                          fontInput = input.enum(sty.fontEnum.default, 'Text Font Family') 
//                          newFont = sty.font(str.tostring(fontInput))
//                          ```
export method font(string style = '') =>
    switch str.upper(style)
        'DEFAULT' => font.family_default
        'MONOSPACE' => font.family_monospace
        => font.family_default

// @function                Takes a `fontEnum` and returns the corresponding built-in font style variable.
//
//                          Used in the `text_font_family` parameter for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new), 
//                          [box.set_text_font_family()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_font_family), 
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new), 
//                          [label.set_text_font_family()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_text_font_family), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and
//                          [table.cell_set_text_font_family()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_font_family).
// @param style             A `fontEnum` representing a built-in font style.
// @returns                 The respective built-in font style variable.
//
// **Usage**
//                          ```
//                          fontInput = input.enum(sty.fontEnum.default, 'Text Font Family') 
//                          newFont = sty.font(fontInput)
//                          ```
export method font(fontEnum style) =>
    switch style
        fontEnum.default => font.family_default
        fontEnum.monospace => font.family_monospace

// @function                Takes a `string` and returns the corresponding built-in label style variable.
//
//                          Used in the `style` parameter for 
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new), and
//                          [label.set_style()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_style).
// @param style             Optional. A `string` representing a built-in label style variable: 
//
//                          `'Arrow Down'`, `'Arrow Up'`, `'Circle'`, `'Cross'`, `'Diamond'`, `'Flag'`, 
//                          `'Label Center'`, `'Label Down'`, `'Label Left'`, `'Label Lower Left'`, 
//                          `'Label Lower Right'`, `'Label Right'`, `'Label Up'`, `'Label Upper Left'`, 
//                          `'Label Upper Right'`, `'None'`, `'Square'`, `'Text Outline'`, `'Triangle Down'`, 
//                          `'Triangle Up'`, `'XCross'`.
//
//                          Strings are not case sensitive. Default is `''`.
// @returns                 The respective built-in label style variable. Misspelt or an empty `style` parameter 
//                          string will return `label.style_label_down`.
//
// **Usage**
//                          ```
//                          labelInput = input.enum(sty.labelStyle.center, 'Label Style') 
//                          newLabel = sty.label(str.tostring(labelInput))
//                          ```
export method label(string style = '') =>
    switch str.upper(style)
        'ARROW DOWN' => label.style_arrowdown
        'ARROW UP' => label.style_arrowup
        'CIRCLE' => label.style_circle
        'CROSS' => label.style_cross
        'DIAMOND' => label.style_diamond
        'FLAG' => label.style_flag
        'LABEL CENTER' => label.style_label_center
        'LABEL DOWN' => label.style_label_down
        'LABEL LEFT' => label.style_label_left
        'LABEL LOWER LEFT' => label.style_label_lower_left
        'LABEL LOWER RIGHt' => label.style_label_lower_right
        'LABEL RIGHT' => label.style_label_right
        'LABEL UP' => label.style_label_up
        'LABEL UPPER LEFT' => label.style_label_upper_left
        'LABEL UPPER RIGHT' => label.style_label_upper_right
        'NONE' => label.style_none
        'SQUARE' => label.style_square
        'TEXT OUTLINE' => label.style_text_outline
        'TRIANGLE DOWN' => label.style_triangledown
        'TRIANGLE UP' => label.style_triangleup
        'XCROSS' => label.style_xcross
        => label.style_label_down

// @function                Takes a `labelEnum` and returns the corresponding built-in label style variable.
//
//                          Used in the `style` parameter for 
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new), and
//                          [label.set_style()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_style).
// @param style             A `labelEnum` representing a 
//                          built-in label [style](https://www.tradingview.com/pine-script-docs/concepts/text-and-shapes/#positioning-labels) 
//                          variable. 
// @returns                 The respective built-in label style variable.
//
// **Usage**
//                          ```
//                          labelInput = input.enum(sty.labelEnum.center, 'Label Style') 
//                          newLabel = sty.label(labelInput)
//                          ```
export method label(labelEnum style) =>
    switch style
        labelEnum.arrowDown => label.style_arrowdown
        labelEnum.arrowUp => label.style_arrowup
        labelEnum.circle => label.style_circle
        labelEnum.cross => label.style_cross
        labelEnum.diamond => label.style_diamond
        labelEnum.flag => label.style_flag
        labelEnum.center => label.style_label_center
        labelEnum.down => label.style_label_down
        labelEnum.left => label.style_label_left
        labelEnum.lowerLeft => label.style_label_lower_left
        labelEnum.lowerRight => label.style_label_lower_right
        labelEnum.right => label.style_label_right
        labelEnum.up => label.style_label_up
        labelEnum.upperLeft => label.style_label_upper_left
        labelEnum.upperRight => label.style_label_upper_right
        labelEnum.none => label.style_none
        labelEnum.square => label.style_square
        labelEnum.textOutline => label.style_text_outline
        labelEnum.triangleDown => label.style_triangledown
        labelEnum.triangleUp => label.style_triangleup
        labelEnum.xCross => label.style_xcross

// @function                Takes a `string` and returns the corresponding built-in line style variable.
//
//                          Used in the `style` parameter for 
//                          [line.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_line.new), 
//                          [line.set_style()](https://www.tradingview.com/pine-script-reference/v6/#fun_line.set_style), 
//
//                          Used in the `line_style` parameter for 
//                          [polyline.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_polyline.new).
// @param style             Optional. A `string` representing a built-in line style: 
//
//                          `'Arrow Both'`, `'Arrow Left'`, `'Arrow Right'`, `'Dashed'`, `'Dotted'`, `'Solid'`.
//
//                          Strings are not case sensitive. Default is `''`.
// @returns                 The respective built-in line style variable. Misspelt or an empty `style` parameter 
//                          string will return `line.style_solid`.
//
// **Usage**
//                          ```
//                          lineInput = input.enum(sty.lineEnum.solid, 'Line Style') 
//                          newLineStyle = sty.line(str.tostring(lineInput))
//                          ```
export method line(string style = '') =>
    switch str.upper(style)
        'ARROW BOTH' => line.style_arrow_both 
        'ARROW LEFT' => line.style_arrow_left 
        'ARROW RIGHT' => line.style_arrow_right 
        'DASHED' => line.style_dashed
        'DOTTED' => line.style_dotted
        'SOLID' => line.style_solid
        => line.style_solid

// @function                Takes a `lineEnum` and returns the corresponding built-in line style variable.
//
//                          Used in the `style` parameter for 
//                          [line.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_line.new) and
//                          [line.set_style()](https://www.tradingview.com/pine-script-reference/v6/#fun_line.set_style). 
// @param style             A `lineEnum` representing a built-in line style variable.
// @returns                 The respective built-in line style variable.
//
// **Usage**
//                          ```
//                          lineInput = input.enum(sty.lineEnum.solid, 'Line Style') 
//                          newLineStyle = sty.line(lineInput)
//                          ```
export method line(lineEnum style) =>
    switch style
        lineEnum.arrowBoth => line.style_arrow_both
        lineEnum.arrowLeft => line.style_arrow_left
        lineEnum.arrowRight => line.style_arrow_right
        lineEnum.dashed => line.style_dashed
        lineEnum.dotted => line.style_dotted
        lineEnum.solid => line.style_solid

// @function                Takes a `string` and returns the corresponding built-in position style variable.
//
//                          Used in the `position` parameter for 
//                          [table.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.new) and 
//                          [table.set_position()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.set_position).
// @param style             Optional. A `string` representing a built-in position style: 
//
//                          `'Bottom Center'`, `'Bottom Left'`, `'Bottom Right'`, `'Middle Center'`, `'Middle Left'`, 
//                          `'Middle Right'`, `'Top Center'`, `'Top Left'`, `'Top Right'`.
// 
//                          Strings are not case sensitive. Default is `''`.
// @returns                 The respective built-in position style variable. Misspelt or an empty `style` parameter 
//                          string will return `position.top_right`.
//
// **Usage**
//                          ```
//                          positionInput = input.enum(sty.positionEnum.none, 'Position') 
//                          newPosition = sty.position(str.tostring(positionInput))
//                          ```
export method position(string style = '') =>
    switch str.upper(style)
        'BOTTOM CENTER' => position.bottom_center
        'BOTTOM LEFT' => position.bottom_left
        'BOTTOM RIGHT' => position.bottom_right
        'MIDDLE CENTER' => position.middle_center
        'MIDDLE LEFT' => position.middle_left
        'MIDDLE RIGHT' => position.middle_right
        'TOP CENTER' => position.top_center
        'TOP LEFT' => position.top_left
        'TOP RIGHT' => position.top_right
        => position.top_right

// @function                Takes a `positionEnum` and returns the corresponding built-in position style variable. 
//
//                          Used in the `position` parameter for 
//                          [table.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.new),  
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and
//                          [table.set_position()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.set_position).
// @param style             A `positionEnum` representing a built-in position style.
// @returns                 The respective built-in position style variable.
//
// **Usage**
//                          ```
//                          positionInput = input.enum(sty.positionEnum.none, 'Position') 
//                          newPosition = sty.position(positionInput)
//                          ```
export method position(positionEnum style) =>
    switch style
        positionEnum.bottomCenter => position.bottom_center
        positionEnum.bottomLeft => position.bottom_left
        positionEnum.bottomRight => position.bottom_right
        positionEnum.middleCenter => position.middle_center
        positionEnum.middleLeft => position.middle_left
        positionEnum.middleRight => position.middle_right
        positionEnum.topCenter => position.top_center
        positionEnum.topLeft => position.top_left
        positionEnum.topRight => position.top_right

// Using `Size()` instead of `size()` for these function names because of warnings about shadowing `array.size()`.

// @function                Takes a `string` and returns the corresponding built-in size `const string` style variable.
//
//                          Used in the `size` parameter for 
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new), 
//                          [label.set_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_size), 
//                          [plotchar()](https://www.tradingview.com/pine-script-reference/v6/#fun_plotchar) and 
//                          [plotshape()](https://www.tradingview.com/pine-script-reference/v6/#fun_plotshape).
//
//                          Used in the `text_size` parameter for
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new),  
//                          [box.set_text_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_size), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and
//                          [table.cell_set_text_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_size).
// @param style             Optional. A `string` representing a built-in size style: 
// 
//                          `'Tiny'`, `'Small'`, `'Normal'`, `'Large'`, `'Huge'`, `'Auto'`.
// 
//                          Strings are not case sensitive. Default is `''`.
// @returns                 The respective built-in size style variable. Misspelt or an empty `style` parameter 
//                          string will return `size.normal`.
//
// **Usage**
//                          ```
//                          sizeInput = input.enum(sty.sizeEnum.normal, 'Size') 
//                          newSize = sty.sizeConst(str.tostring(sizeInput))
//                          ```
export method sizeConst(string style = '') =>
    switch str.upper(style)
        'TINY' => size.tiny
        'SMALL' => size.small
        'NORMAL' => size.normal
        'LARGE' => size.large
        'HUGE' => size.huge
        'AUTO' => size.auto
        => size.normal

// @function                Takes a `sizeEnum` and returns the corresponding built-in size `const string` style variable.
//
//                          Used in the `size` parameter for 
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new), 
//                          [label.set_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_size), 
//                          [plotchar()](https://www.tradingview.com/pine-script-reference/v6/#fun_plotchar) and 
//                          [plotshape()](https://www.tradingview.com/pine-script-reference/v6/#fun_plotshape).
//
//                          Used in the `text_size` parameter for
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new),  
//                          [box.set_text_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_size), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and
//                          [table.cell_set_text_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_size).
// @param style             A `sizeEnum` representing a built-in size style variable.
// @returns                 The respective built-in size style variable. Using `sizeEnum.custom` will return `size.normal`.
//
// **Usage**
//                          ```
//                          sizeInput = input.enum(sty.sizeEnum.normal, 'Size') 
//                          newSize = sty.sizeConst(sizeInput)
//                          ```
export method sizeConst(sizeEnum style) =>
    switch style
        sizeEnum.tiny => size.tiny
        sizeEnum.small => size.small
        sizeEnum.normal => size.normal
        sizeEnum.large => size.large
        sizeEnum.huge => size.huge
        sizeEnum.auto => size.auto
        => size.normal 

// @function                Size text based on numeric sizing using `int`s instead of the built-in `const string` size
//                          style variables. Takes a `sizeEnum` and returns an `int` numeric size.
//
//                          Used in the `text_size` parameter for 
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new) and
//                          [label.set_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_size).
//
//                          Used in the `text_size` parameter for
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new),  
//                          [box.set_text_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_size), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and
//                          [table.cell_set_text_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_size).
// @param style             A `sizeEnum` representing a built-in or custom size.
// @param Label             A `bool` toggle between the different recommended numeric sizes for `box` and `table` text, 
//                          or the numeric sizes for `label` text. This parameter's name is capitalized to avoid 
//                          conflicting with the `label` type.
// @param customSize        Optional. Set a numeric size other than one of the recommended numeric sizes.
// 
//                          Default is `14`.
// @returns                 An `int` representing a numeric size for `box`, `table`, or `label` text.
// 
// **Usage**
//                          ```
//                          sizeInput = input.enum(sty.sizeEnum.custom, 'Size')
//                          sizeNumericInput = input.int(14, 'Custom')
//                          newSize = sty.sizeNumeric(sizeInput, false, sizeNumericInput)
//                          ```
export method sizeNumeric(sizeEnum style, bool Label, int customSize = 14) =>
    if Label
        switch style
            sizeEnum.tiny => 8
            sizeEnum.small => 10
            sizeEnum.normal => 14
            sizeEnum.large => 18
            sizeEnum.huge => 24
            sizeEnum.auto => 0
            sizeEnum.custom => customSize
    else
        switch style
            sizeEnum.tiny => 8
            sizeEnum.small => 10
            sizeEnum.normal => 14
            sizeEnum.large => 20
            sizeEnum.huge => 36
            sizeEnum.auto => 0
            sizeEnum.custom => customSize

// @function                Takes a `sizeEnum` and returns an `int` numeric size.
//
//                          Used in the `size` parameter for 
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new) and
//                          [label.set_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_size).
//
//                          Used in the `text_size` parameter for
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new),  
//                          [box.set_text_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_size), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and
//                          [table.cell_set_text_size()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_size).
// @param style             A `sizeEnum` representing a built-in or custom size.
// @param sizes             A `sizeNumericType` that holds custom numeric size `int` values for each of the built-in
//                          sizes and a custom numeric size.
// @returns                 An `int` representing a numeric size for `box`, `table`, or `label` text.
// 
// **Usage**
//                          ```
//                          sizeInput = input.enum(sty.sizeEnum.custom, 'Size')
//                          newSizeNumericType = sty.sizeNumericType.new(8, 10, 14, 20, 26, 0, 40)
//                          newSize = sty.sizeNumeric(sizeInput, newSizeNumericType)
//                          ```
export method sizeNumeric(sizeEnum style, sizeNumericType sizes) =>
    switch style
        sizeEnum.tiny => sizes.tiny
        sizeEnum.small => sizes.small
        sizeEnum.normal => sizes.normal
        sizeEnum.large => sizes.large
        sizeEnum.huge => sizes.huge
        sizeEnum.auto => sizes.auto
        sizeEnum.custom => sizes.custom

// @function                Takes two `bool` inputs and applies the corresponding built-in text format style to a `label`.
// @param formatLabel       The 'label' to apply the new text formatting onto.
// @param bold              A `bool` representing the `text.format_bold` built-in text format style.
// @param italic            A `bool` representing the `text.format_italic` built-in text format style.
// @returns                 Applies the respective built-in text format style. When both inputs are `false`,
//                          `textFormat()` returns `text.format_none`.
//
// **Usage**
//                          ```
//                          textBoldFormatInput = input.bool(true, 'Text Bold Format')
//                          textItalicFormatInput = input.bool(true, 'Text Italic Format')
//                          formatLabel = label.new(bar_index, close, 'Format Text')
//                          formatLabel.textFormat(textBoldFormatInput, textItalicFormatInput)
//                          ```
export method textFormat(label formatLabel, bool bold, bool italic) =>
    switch
        bold and not italic => formatLabel.set_text_formatting(text.format_bold)
        italic and not bold => formatLabel.set_text_formatting(text.format_italic)
        bold and italic => formatLabel.set_text_formatting(text.format_bold + text.format_italic)
        => formatLabel.set_text_formatting(text.format_none)

// @function                Takes two `bool` inputs and applies the corresponding built-in text format style to a `box`. 
// @param formatBox         The 'box' to apply the new text formatting onto.
// @param bold              A `bool` representing the `text.format_bold` built-in text format style.
// @param italic            A `bool` representing the `text.format_italic` built-in text format style.
// @returns                 Applies the respective built-in text format style. When both inputs are `false`,
//                          `textFormat()` returns `text.format_none`.
//
// **Usage**
//                          ```
//                          textBoldFormatInput = input.bool(true, 'Text Bold Format')
//                          textItalicFormatInput = input.bool(true, 'Text Italic Format')
//                          formatBox = box.new(left = bar_index - 1, top = high, right = bar_index, bottom = low, text = 'Format Text')
//                          formatBox.textFormat(textBoldFormatInput, textItalicFormatInput)
//                          ```
export method textFormat(box formatBox, bool bold, bool italic) =>
    switch
        bold and not italic => formatBox.set_text_formatting(text.format_bold)
        italic and not bold => formatBox.set_text_formatting(text.format_italic)
        bold and italic => formatBox.set_text_formatting(text.format_bold + text.format_italic)
        => formatBox.set_text_formatting(text.format_none)

// @function                Takes two `bool` inputs and applies the corresponding built-in text format style to a cell in a `table`. 
// @param formatTable       The 'table' to apply the new text formatting onto.
// @param column            A `int` to select the zero-indexed column of the table cell to apply text formatting onto.
// @param row               A `int` to select the zero-indexed row of the table cell to apply text formatting onto.
// @param bold              A `bool` representing the `text.format_bold` built-in text format style.
// @param italic            A `bool` representing the `text.format_italic` built-in text format style.
// @returns                 Applies the respective built-in text format style. When both inputs are `false`,
//                          `textFormat()` returns `text.format_none`.
//
// **Usage**
//                          ```
//                          textBoldFormatInput = input.bool(true, 'Text Bold Format')
//                          textItalicFormatInput = input.bool(true, 'Text Italic Format')
//                          table newTable = table.new(position.bottom_right, 1, 1)
//                          newTable.cell_set_text(0, 0, 'Format Text')
//                          newTable.textFormat(0, 0, textBoldFormatInput, textItalicFormatInput)
//                          ```
export method textFormat(table formatTable, int column, int row, bool bold, bool italic) =>
    switch
        bold and not italic => formatTable.cell_set_text_formatting(column, row, text.format_bold)
        italic and not bold => formatTable.cell_set_text_formatting(column, row, text.format_italic)
        bold and italic => formatTable.cell_set_text_formatting(column, row, text.format_bold + text.format_italic)
        => formatTable.cell_set_text_formatting(column, row, text.format_none)

// @function                Takes a `string` and returns the corresponding built-in text horizontal or vertical align style variable.
//
//                          Used in the `textalign` paramater for
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new) and
//                          [label.set_textalign()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_textalign).
//
//                          Used in the `text_halign` parameter for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new), 
//                          [box.set_text_halign()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_halign), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and 
//                          [table.cell_set_text_halign()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_halign).
// 
//                          Used in the `text_valign` parameter for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new), 
//                          [box.set_text_valign()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_valign), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and 
//                          [table.cell_set_text_valign()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_valign).
// @param style             Optional. A `string` representing a built-in text horizontal or vertical align style:
//
//                          `'Bottom'`, `'Center'`, `'Left'`, `'Right'`, `'Top'`.
//
//                          Strings are not case sensitive. Default is `''`.
// @returns                 The respective built-in text horizontal align style variable. Misspelt or an empty `style` 
//                          paramater string will return `text.align_center`.
//
// **Usage**
//                          ```
//                          textAlignInput = input.enum(sty.textHAlignEnum.center, 'Text Horizontal Align') 
//                          newTextAlign = sty.textAlign(str.tostring(textAlignInput))
//                          ```
export method textAlign(string style = '') =>
    switch str.upper(style)
        'BOTTOM' => text.align_bottom
        'LEFT' => text.align_left
        'RIGHT' => text.align_right
        'TOP' => text.align_top
        => text.align_center

// @function                Takes a `textHAlignEnum` and returns the corresponding built-in text horizontal align style variable.
//
//                          Used in the `textalign` paramater for
//                          [label.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.new) and
//                          [label.set_textalign()](https://www.tradingview.com/pine-script-reference/v6/#fun_label.set_textalign).
//
//                          Used in the `text_halign` parameter for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new), 
//                          [box.set_text_halign()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_halign), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and 
//                          [table.cell_set_text_halign()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_halign).
//
// @param style             A `textHAlignEnum` representing a built-in text horizontal align style.
// @returns                 The respective built-in text Hiontal align style variable.
//
// **Usage**
//                          ```
//                          textHAlignInput = input.enum(sty.textHAlignEnum.center, 'Text Horizontal Align') 
//                          newTextHAlign = sty.textAlign(textHAlignInput)
//                          ```
export method textAlign(textHAlignEnum style) =>
    switch style
        textHAlignEnum.center => text.align_center
        textHAlignEnum.left => text.align_left
        textHAlignEnum.right => text.align_right

// @function                Takes a `textVAlignEnum` and returns the corresponding built-in text vertical align style variable.
//
//                          Used in the `text_valign` parameter for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new), 
//                          [box.set_text_valign()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_valign), 
//                          [table.cell()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell), and 
//                          [table.cell_set_text_valign()](https://www.tradingview.com/pine-script-reference/v6/#fun_table.cell_set_text_valign).
// @param style             A `textVAlignEnum` representing a built-in text vertical align style.
// @returns                 The respective built-in text vertical align style variable.
//
// **Usage**
//                          ```
//                          textVAlignInput = input.enum(sty.textVAlignEnum.center, 'Text Vertical Align') 
//                          newTextAlign = sty.textAlign(textVAlignInput)
//                          ```
export method textAlign(textVAlignEnum style) =>
    switch style
        textVAlignEnum.bottom => text.align_bottom
        textVAlignEnum.center => text.align_center
        textVAlignEnum.top => text.align_top

// @function                Takes a `string` and returns the corresponding built-in text wrap style variable.
//
//                          Used in the `text_wrap` parameter for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new) and 
//                          [box.set_text_wrap()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_wrap). 
// @param style             Optional. A `string` representing a built-in text wrap style:
//
//                          `'AUTO'`, `'NONE'`.
//
//                          Strings are not case sensitive. Default is `''`.
// @returns                 The respective built-in text wrap style variable. Misspelt or an empty `style` 
//                          paramater string will return `text.wrap_none`.
//
// **Usage**
//                          ```
//                          textWrapInput = input.enum(sty.textWrapEnum.auto, 'Text Wrap') 
//                          newTextWrap = sty.textAlign(str.tostring(textWrapInput))
//                          ```
export method textWrap(string style = '') => 
    switch str.upper(style)
        'AUTO' => text.wrap_auto
        'NONE' => text.wrap_none

// @function                Takes a `textWrapEnum` and returns the corresponding built-in text wrap style variable.
//
//                          Used in the `text_wrap` parameter for 
//                          [box.new()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.new) and 
//                          [box.set_text_wrap()](https://www.tradingview.com/pine-script-reference/v6/#fun_box.set_text_wrap). 
// @param style             A `textWrapEnum` representing a built-in text wrap style.
// @returns                 The respective built-in text wrap style variable.
//
// **Usage**
//                          ```
//                          textWrapInput = input.enum(sty.textWrapEnum.auto, 'Text Wrap') 
//                          newTextWrap = sty.textAlign(textWrapInput)
//                          ```
export method textWrap(textWrapEnum style) => 
    switch style
        textWrapEnum.auto => text.wrap_auto
        textWrapEnum.none => text.wrap_none

//#endregion
