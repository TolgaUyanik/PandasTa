//@version=6
strategy("My strategy", overlay=true, fill_orders_on_standard_ohlc = true)

longCondition = ta.crossover(ta.sma(close, 14), ta.sma(close, 28))
if (longCondition)
    strategy.entry("My Long Entry Id", strategy.long)

shortCondition = ta.crossunder(ta.sma(close, 14), ta.sma(close, 28))
if (shortCondition)
    strategy.entry("My Short Entry Id", strategy.short)
//@version=6
// "longCondition"
// ("Welcome Back! - Multi-Timeframe Highs and Lows", overlay=true)

// Example trading strategy based on SMA crossovers
f_getHighLow(tf) =>
    [h, l] = request.security(syminfo.tickerid, tf, [high, low])
    var float high_level = na
    var float low_level = na
    // Detect if a new period has started
    is_new_period = false
    if tf == "D"
        is_new_period := ta.change(time("D")) != 0
        // welcome back message
    else
        is_new_period := ta.change(time) != 0

    // Update high/low at the start of each period
    if is_new_period
        high_level := h
        low_level := l
    else
        high_level := na(high_level) ? h : math.max(high_level, h)
        low_level := na(low_level) ? l : math.min(low_level, l)
    [high_level, low_level]

// Retrieve levels for each timeframe
[d_high, d_low] = request.security(syminfo.tickerid, "D", [high, low])
[h_high, h_low] = request.security(syminfo.tickerid, "60", [high, low])
[m30_high, m30_low] = request.security(syminfo.tickerid, "30", [high, low])
[m15_high, m15_low] = request.security(syminfo.tickerid, "15", [high, low])

// Plot the levels with different colors
plot(d_high, color=color.orange, title="Daily High", linewidth=2)
plot(d_low, color=color.orange, title="Daily Low", linewidth=2)

plot(h_high, color=color.blue, title="Hourly High", linewidth=2)
plot(h_low, color=color.blue, title="Hourly Low", linewidth=2)

plot(m30_high, color=color.green, title="30 Min High", linewidth=2)
plot(m30_low, color=color.green, title="30 Min Low", linewidth=2)

plot(m15_high, color=color.red, title="15 Min High", linewidth=2)
plot(m15_low, color=color.red, title="15 Min Low", linewidth=2)