//@version=6
strategy("SOL SuperTrend Strategy (News-Based)", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
atrLen    = input.int(10,  "ATR Period (SuperTrend)")
atrMult   = input.float(3.0, "ATR Multiplier (SuperTrend)")

support1  = input.float(60.0,  "Support 1 — Key floor")
support2  = input.float(74.5,  "Support 2 — Baseline (74-75)")
support3  = input.float(68.57, "Support 3 — Lower BB")
res1      = input.float(82.0,  "Resistance 1 — Congestion zone mid")
res2      = input.float(96.0,  "Resistance 2 / TP1")
res3      = input.float(121.0, "Resistance 3 / TP2")

slPct     = input.float(5.0,  "Stop-Loss %",  minval=0.5)
tp1Pct    = input.float(15.0, "TP1 %",        minval=1.0)
tp2Pct    = input.float(35.0, "TP2 %",        minval=1.0)

// ─── SUPERTREND ───────────────────────────────────────────────────────────────
[supertrend, direction] = ta.supertrend(atrMult, atrLen)

// ─── FILTERS ─────────────────────────────────────────────────────────────────
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
trendUp = ema50 > ema200

rsi           = ta.rsi(close, 14)
rsiOverbought = rsi > 75
rsiOversold   = rsi < 45

volMA   = ta.sma(volume, 20)
highVol = volume > volMA * 1.2

// ─── ENTRY CONDITIONS ────────────────────────────────────────────────────────
longCondition  = ta.crossunder(direction, 0)
                 and close > support2
                 and trendUp
                 and highVol
                 and not rsiOverbought

shortCondition = ta.crossover(direction, 0)
                 and close < res1
                 and not trendUp
                 and highVol
                 and not rsiOversold

// ─── STRATEGY EXECUTION ──────────────────────────────────────────────────────
if longCondition
    sl  = close * (1 - slPct  / 100)
    tp1 = close * (1 + tp1Pct / 100)
    tp2 = close * (1 + tp2Pct / 100)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP1", "Long", limit=tp1, stop=sl, qty_percent=50)
    strategy.exit("Long TP2", "Long", limit=tp2, stop=sl, qty_percent=50)

if shortCondition
    sl  = close * (1 + slPct  / 100)
    tp1 = close * (1 - tp1Pct / 100)
    tp2 = close * (1 - tp2Pct / 100)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP1", "Short", limit=tp1, stop=sl, qty_percent=50)
    strategy.exit("Short TP2", "Short", limit=tp2, stop=sl, qty_percent=50)

// ─── PLOTS ───────────────────────────────────────────────────────────────────
plot(supertrend, "SuperTrend", color=direction == -1 ? color.green : color.red, linewidth=2)
plot(ema50,  "EMA 50",  color=color.orange, linewidth=1)
plot(ema200, "EMA 200", color=color.blue,   linewidth=1)

hline(support1, "Support $60",    color=color.new(color.green,  60), linestyle=hline.style_dashed)
hline(support2, "Support $74.5",  color=color.new(color.green,  40), linestyle=hline.style_dashed)
hline(support3, "Support $68.57", color=color.new(color.green,  70), linestyle=hline.style_dotted)
hline(res1,     "Res $82",        color=color.new(color.orange, 40), linestyle=hline.style_dashed)
hline(res2,     "TP1 $96",        color=color.new(color.red,    40), linestyle=hline.style_dashed)
hline(res3,     "TP2 $121",       color=color.new(color.red,    20), linestyle=hline.style_dashed)

plotshape(longCondition,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.green, text="BUY",  textcolor=color.white, size=size.small)
plotshape(shortCondition, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.red,   text="SELL", textcolor=color.white, size=size.small)

// ─── INFO TABLE ──────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "LEVEL",       text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 0, "PRICE",        text_color=color.gray,   text_size=size.small)
    table.cell(t, 0, 1, "Key Support",  text_color=color.green,  text_size=size.small)
    table.cell(t, 1, 1, "$60.00",       text_color=color.green,  text_size=size.small)
    table.cell(t, 0, 2, "BB Support",   text_color=color.green,  text_size=size.small)
    table.cell(t, 1, 2, "$68.57",       text_color=color.green,  text_size=size.small)
    table.cell(t, 0, 3, "Baseline Sup", text_color=color.green,  text_size=size.small)
    table.cell(t, 1, 3, "$74-75",       text_color=color.green,  text_size=size.small)
    table.cell(t, 0, 4, "Congestion",   text_color=color.orange, text_size=size.small)
    table.cell(t, 1, 4, "$79-85",       text_color=color.orange, text_size=size.small)
    table.cell(t, 0, 5, "TP1",          text_color=color.red,    text_size=size.small)
    table.cell(t, 1, 5, "$96",          text_color=color.red,    text_size=size.small)
    table.cell(t, 0, 6, "TP2",          text_color=color.red,    text_size=size.small)
    table.cell(t, 1, 6, "$121",         text_color=color.red,    text_size=size.small)