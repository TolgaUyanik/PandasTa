//@version=6

// @description Provides a simple function to return a daily bias based on the break of the morning range
library("TCTDailyBiasLibrary")

// @enum                An enumeration of bias states
// @field neutral       Represents a "neutral" bias, meaning neither high or low has been broken
// @field bullish       Represents a "bullish" bias, meaning only the high was broken
// @field bearish       Represents a "bearish" bias, meaning only the low was broken
// @field indecisive    Represents a "indecisive" bias, meaning both the high and low were broken
export enum bias
    neutral
    bullish
    bearish
    indecisive

// @function Returns the daily bias based on the break of the morning range
// @returns bias
export getDailyBias() =>
    var int sessionStartTime = na
    var float sessionHigh = na
    var float sessionLow = na
    var bool bullishBroken = false
    var bool bearishBroken = false

    // Detect session start at 5:00 AM
    if na(sessionStartTime) and hour == 5 and minute == 0
        sessionStartTime := time
        sessionHigh := high
        sessionLow := low
        bullishBroken := false
        bearishBroken := false

    // Update session high/low dynamically during 5 AM - 9 AM
    if not na(sessionStartTime) and hour >= 5 and hour < 9
        sessionHigh := math.max(sessionHigh, high)
        sessionLow := math.min(sessionLow, low)

    // Track if high or low is broken before 3 PM
    if hour >= 5 and hour < 15
        if high > sessionHigh
			bullishBroken := true
        if low < sessionLow
			bearishBroken := true

    // Determine bias
    bullishBroken and bearishBroken ? bias.indecisive : bullishBroken ? bias.bullish : bearishBroken ? bias.bearish : bias.neutral
