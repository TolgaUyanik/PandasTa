//@version=5
indicator("Impulse Alert - Supply (Sell) [Fixed]", overlay=true)

// === INPUTS ===
impulseCandleCount = input.int(2, title="Number of Large Candles")
bodySizeMultiplier = input.float(1.5, title="Body Size Multiplier (vs avg)", minval=0.5)
singleCandlePipThreshold = input.float(30.0, title="Single Candle Impulse Threshold (pips)", minval=1)

// === CALCULATIONS ===
body = math.abs(close - open)
highLowRange = high - low
avgBody = ta.sma(body, 20)

// Convert highLowRange to pips (assuming 5-digit broker for forex)
pipValue = syminfo.mintick * 10000
rangePips = highLowRange / pipValue

// Large candle check and impulse tracking (bearish)
largeCandle = body > avgBody * bodySizeMultiplier
singleImpulse = rangePips >= singleCandlePipThreshold and close < open

// Detect impulse sequence
var impulseCount = 0
impulseCount := largeCandle and close < open ? impulseCount + 1 : 0

multiCandleImpulse = impulseCount >= impulseCandleCount

// Final Alert Condition
showAlert = multiCandleImpulse or singleImpulse

bgcolor(showAlert ? color.new(color.red, 85) : na)
plotshape(showAlert, title="Impulse Alert", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)
alertcondition(showAlert, title="Supply Zone Impulse Alert", message="Bearish impulse detected on {{ticker}} @ {{interval}}")
