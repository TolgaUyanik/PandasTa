//@version=6
// @description This library provides a function to calculate a moving average based on Chebyshev-Gauss Quadrature.
// This method samples price data more intensely from the beginning and end of the lookback window,
// giving it a unique character that responds quickly to recent changes while also having a long "memory" of the trend's start.
library(title = 'CGMA')

// /**
//  * Calculates the Chebyshev-Gauss Moving Average.
//  * @param src The source series (e.g., `close`).
//  * @param len The lookback length.
//  * @param nodes The number of quadrature nodes. Higher values provide a smoother, more accurate approximation.
//  * @returns The calculated CG-MA value.
//  */
export f_cgma(float src, int len, int nodes) =>
    sum_f = 0.0
    if bar_index < len - 1
        na // Not enough historical bars available
    else // Sum the interpolated values at each Chebyshev node
        for i = 1 to nodes by 1
            // 1. Calculate the i-th Chebyshev node (x_i), which lies in the interval [-1, 1].
            x_i = math.cos((2.0 * i - 1.0) / (2.0 * nodes) * math.pi)

            // 2. Map the node from the [-1, 1] interval to the lookback window interval [0, len-1].
            t_i = (x_i + 1.0) / 2.0 * (len - 1.0)

            // 3. Perform linear interpolation to find the price at the fractional index t_i.
            i_floor = math.floor(t_i)
            i_ceil = math.ceil(t_i)
            f_xi = if i_floor == i_ceil
                src[i_floor]
            else
                val_floor = src[i_floor]
                val_ceil = src[i_ceil]
                if na(val_floor) or na(val_ceil)
                    na
                else
                    val_floor + (t_i - i_floor) * (val_ceil - val_floor)

            if na(f_xi)
                sum_f := na
                break

            // 4. Add the interpolated value to our sum.
            sum_f := sum_f + f_xi
            sum_f

    // 5. The final MA is the arithmetic mean of the sampled values.
    sum_f / nodes
