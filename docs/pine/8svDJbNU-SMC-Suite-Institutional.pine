//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  INSTITUTIONAL MARKET DASHBOARD (IMD) — V4 · OPTIMIZADO + MODO NO TRADE
//  V1 dashboard MTF · V2 Smart Money · V3 decisión · V4 optimización + NO TRADE
// ─────────────────────────────────────────────────────────────────────────────
//  OPTIMIZACIONES V4:
//   · Series base (ATR/EMA/RSI/MACD/Vol) calculadas UNA vez y reutilizadas.
//   · request.security por TF activable/desactivable → menos llamadas, menos CPU.
//   · Render y agregaciones concentrados; sin cálculos duplicados entre módulos.
//   · Modo NO TRADE como filtro maestro que anula señales y alertas de entrada.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Institutional Market Dashboard v4", "IMD v4", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ── ① TABLA · posición, tamaño, fuente, transparencia ───────────────────────
grpTbl   = "① Tabla"
posIn    = input.string("Superior derecha", "Posición", group = grpTbl,
     options = ["Superior izquierda", "Superior centro", "Superior derecha",
                "Media izquierda", "Media centro", "Media derecha",
                "Inferior izquierda", "Inferior centro", "Inferior derecha"])
txtIn    = input.string("Normal", "Tamaño del texto", group = grpTbl,
     options = ["Pequeño", "Normal", "Grande", "Enorme"])
transp   = input.int(10, "Transparencia del fondo (%)", 0, 100, group = grpTbl)
viewMode = input.string("Completo", "Modo de vista", options = ["Completo", "Compacto"],
     group = grpTbl, tooltip = "Compacto: solo NO TRADE, decisión y resumen esencial.")

// ── ② TEMA Y COLORES ────────────────────────────────────────────────────────
grpTheme = "② Tema y colores"
mode     = input.string("Oscuro", "Modo", options = ["Oscuro", "Claro"], group = grpTheme)
useCustom= input.bool(false, "Usar colores personalizados", group = grpTheme)
cBullIn  = input.color(#26a69a, "Alcista",  inline = "c1", group = grpTheme)
cBearIn  = input.color(#ef5350, "Bajista",  inline = "c1", group = grpTheme)
cNeutIn  = input.color(#ffb300, "Neutral",  inline = "c2", group = grpTheme)
cHeadIn  = input.color(#1e88e5, "Cabecera", inline = "c2", group = grpTheme)

// ── ③ SECCIONES (activar/desactivar módulos) ────────────────────────────────
grpSec   = "③ Secciones visibles"
showTF   = input.bool(true, "Filas por temporalidad",  group = grpSec)
showSum  = input.bool(true, "Resumen institucional",   group = grpSec)
showSMC  = input.bool(true, "Smart Money (V2)",        group = grpSec)
showV3   = input.bool(true, "Decisión (V3)",           group = grpSec)
showDraw = input.bool(true, "Dibujos SMC en el gráfico (FVG/OB/Liq/PD)", group = grpSec,
     tooltip = "Apágalo para máximo rendimiento: el panel sigue, se ocultan los dibujos.")

// ── ④ DATOS MTF (optimización de request.security) ──────────────────────────
grpData  = "④ Datos multi-timeframe"
liveMode = input.bool(false, "Modo tiempo real (permite micro-repaint vela en curso)", group = grpData,
     tooltip = "OFF (recomendado): no-repaint estricto (última vela HTF cerrada).")
skipLower= input.bool(true, "Excluir TFs inferiores a la del gráfico", group = grpData)
en1  = input.bool(true, "1m",  inline = "t1", group = grpData)
en5  = input.bool(true, "5m",  inline = "t1", group = grpData)
en15 = input.bool(true, "15m", inline = "t1", group = grpData)
en30 = input.bool(true, "30m", inline = "t2", group = grpData)
en60 = input.bool(true, "1H",  inline = "t2", group = grpData)
en240= input.bool(true, "4H",  inline = "t2", group = grpData)
enD  = input.bool(true, "1D",  inline = "t3", group = grpData)

// ── ⑤ PARÁMETROS DE CÁLCULO ─────────────────────────────────────────────────
grpCalc  = "⑤ Cálculo"
emaFastL = input.int(20,  "EMA rápida",  2, 200, group = grpCalc)
emaMidL  = input.int(50,  "EMA media",   2, 300, group = grpCalc)
emaSlowL = input.int(200, "EMA lenta",   2, 400, group = grpCalc)
rsiL     = input.int(14,  "RSI",         2, 100, group = grpCalc)
adxL     = input.int(14,  "ADX / DI",    2, 100, group = grpCalc)
atrL     = input.int(14,  "ATR",         2, 100, group = grpCalc)
slopeL   = input.int(3,   "Barras pendiente EMA", 1, 20, group = grpCalc)

// ── ⑥-⑩ SMC ─────────────────────────────────────────────────────────────────
grpMS    = "⑥ SMC · Estructura"
extLen   = input.int(25, "Pivot externo", 5, 100, group = grpMS)
intLen   = input.int(5,  "Pivot interno", 2, 30,  group = grpMS)
showMSlbl= input.bool(true, "Etiquetas HH/HL/LH/LL y BOS/CHoCH", group = grpMS)
grpLQ    = "⑦ SMC · Liquidez"
eqTol    = input.float(0.12, "Tolerancia Equal H/L (× ATR)", 0.02, 1.0, 0.02, group = grpLQ)
grpFV    = "⑧ SMC · Fair Value Gaps"
fvgMinATR= input.float(0.2, "Tamaño mínimo FVG (× ATR)", 0.05, 3, 0.05, group = grpFV)
fvgMax   = input.int(6, "Máx. FVG por dirección", 1, 15, group = grpFV)
grpOB    = "⑨ SMC · Order Blocks"
obMax    = input.int(3, "Máx. OB por dirección", 1, 8, group = grpOB)
grpPD    = "⑩ SMC · Premium / Discount"
pdOffset = input.int(6, "Distancia barra P/D (velas)", 2, 30, group = grpPD)

// ── ⑪ DECISIÓN + ⑫ NO TRADE ─────────────────────────────────────────────────
grpV3    = "⑪ Decisión"
qMinAplus= input.int(85, "Umbral Setup A+", 70, 100, group = grpV3)
grpNT    = "⑫ Modo NO TRADE"
ntAdx    = input.float(18, "ADX mínimo (por debajo = lateral)", 5, 40, group = grpNT)
ntAtrPct = input.float(0.10, "ATR mínimo (% del precio)", 0.01, 2.0, 0.01, group = grpNT,
     tooltip = "Si ATR < este % del precio, se considera volatilidad demasiado baja.")
ntAlign  = input.int(55, "Alineación mínima de TFs (%)", 30, 90, group = grpNT)
ntRisk   = input.int(60, "Riesgo máximo tolerado", 30, 100, group = grpNT)
ntRange  = input.int(20, "Velas de rango para 'rango prolongado'", 5, 100, group = grpNT)

// ═══════════════════════════════════════════════════════════════════════════
//  MÓDULO · TEMA Y FORMATO (reutilizable)
// ═══════════════════════════════════════════════════════════════════════════
f_theme() =>
    dark = mode == "Oscuro"
    bg   = dark ? color.new(#0e0e12, transp) : color.new(#f5f5f7, transp)
    txt  = dark ? color.new(#e8e8ea, 0)      : color.new(#1a1a1a, 0)
    grid = dark ? color.new(#2a2a33, 0)      : color.new(#d0d0d5, 0)
    head = useCustom ? cHeadIn : (dark ? #1e88e5 : #1565c0)
    bull = useCustom ? cBullIn : #26a69a
    bear = useCustom ? cBearIn : #ef5350
    neut = useCustom ? cNeutIn : #ffb300
    [bg, txt, grid, head, bull, bear, neut]

f_txtSize() =>
    switch txtIn
        "Pequeño" => size.small
        "Normal"  => size.normal
        "Grande"  => size.large
        => size.huge

f_pos() =>
    switch posIn
        "Superior izquierda" => position.top_left
        "Superior centro"    => position.top_center
        "Superior derecha"   => position.top_right
        "Media izquierda"    => position.middle_left
        "Media centro"       => position.middle_center
        "Media derecha"      => position.middle_right
        "Inferior izquierda" => position.bottom_left
        "Inferior centro"    => position.bottom_center
        => position.bottom_right

// ═══════════════════════════════════════════════════════════════════════════
//  MÓDULO · SERIES BASE COMPARTIDAS (se calculan UNA sola vez · optimización)
//  Todos los módulos (V2 SMC y V3 decisión) leen de aquí. Cero duplicación.
// ═══════════════════════════════════════════════════════════════════════════
atr      = ta.atr(atrL)
emaFast  = ta.ema(close, emaFastL)
rsiCur   = ta.rsi(close, rsiL)
volSma   = ta.sma(volume, 20)
relVol   = nz(volSma) > 0 ? volume / volSma : 1.0
[mlCur, msCur, histCur] = ta.macd(close, 12, 26, 9)
[diP, diM, adxCur]      = ta.dmi(adxL, adxL)

// ═══════════════════════════════════════════════════════════════════════════
//  MÓDULO · TENDENCIA MTF (para request.security)
// ═══════════════════════════════════════════════════════════════════════════
f_norm(float x, float scale) =>
    s = math.max(scale, syminfo.mintick)
    math.max(0.0, math.min(1.0, 0.5 + x / (2.0 * s)))

f_trendBundle() =>
    eF = ta.ema(close, emaFastL)
    eM = ta.ema(close, emaMidL)
    eS = ta.ema(close, emaSlowL)
    rs = ta.rsi(close, rsiL)
    at = ta.atr(atrL)
    [ml, sg, hi] = ta.macd(close, 12, 26, 9)
    [dp, dm, ax] = ta.dmi(adxL, adxL)
    vs = ta.sma(volume, 20)
    rv = nz(vs) > 0 ? volume / vs : 1.0
    f1 = f_norm(eF - eM, at * 1.5)
    f2 = f_norm(eM - eS, at * 2.0)
    f3 = f_norm(close - eS, at * 3.0)
    f4 = f_norm(eF - eF[slopeL], at * 1.0)
    f5 = math.max(0.0, math.min(1.0, rs / 100.0))
    f6 = f_norm(hi, at * 0.5)
    f7 = f_norm(dp - dm, 40.0)
    vd = close >= open ? 1.0 : 0.0
    f8 = 0.5 + (vd - 0.5) * math.min(rv, 2.0) / 2.0
    ae = nz(at[3]) > 0 ? at / at[3] : 1.0
    f9 = 0.5 + (vd - 0.5) * math.max(0.0, math.min(1.0, ae - 1.0))
    ix = math.max(0.0, math.min(100.0, f1*15 + f2*15 + f3*10 + f4*10 + f5*15 + f6*15 + f7*10 + f8*5 + f9*5))
    mc1 = (rs - 50.0) / 50.0
    mc2 = math.max(-1.0, math.min(1.0, hi / math.max(at * 0.5, syminfo.mintick)))
    mo = math.max(0.0, math.min(100.0, 50.0 + 25.0 * (mc1 + mc2)))
    [ix, mo, ax]

f_bundleSel(simple bool live) =>
    [i, m, a] = f_trendBundle()
    [live ? i : i[1], live ? m : m[1], live ? a : a[1]]

f_class(float idx) =>
    na(idx) ? "—" : idx >= 75 ? "Muy Alcista" : idx >= 60 ? "Alcista" :
     idx > 40 ? "Neutral" : idx > 25 ? "Bajista" : "Muy Bajista"

f_scoreColor(float idx, color bl, color be, color ne, color tx) =>
    na(idx) ? tx : idx >= 60 ? bl : idx <= 40 ? be : ne
// ── request.security: envoltorio único; TF desactivada devuelve na (0 coste útil)
lh = liveMode ? barmerge.lookahead_off : barmerge.lookahead_on
f_htf(simple string tf, simple bool en) =>
    float ri = na
    float rm = na
    float ra = na
    if en
        [x, y, z] = request.security(syminfo.tickerid, tf, f_bundleSel(liveMode), gaps = barmerge.gaps_off, lookahead = lh)
        ri := x
        rm := y
        ra := z
    [ri, rm, ra]

[i1,  m1,  a1 ] = f_htf("1",   en1)
[i5,  m5,  a5 ] = f_htf("5",   en5)
[i15, m15, a15] = f_htf("15",  en15)
[i30, m30, a30] = f_htf("30",  en30)
[i60, m60, a60] = f_htf("60",  en60)
[i240,m240,a240]= f_htf("240", en240)
[iD,  mD,  aD ] = f_htf("D",   enD)

var string[] tfNames = array.from("1m", "5m", "15m", "30m", "1H", "4H", "1D")
var int[]    tfSecs  = array.from(60, 300, 900, 1800, 3600, 14400, 86400)
idxArr = array.from(i1, i5, i15, i30, i60, i240, iD)
momArr = array.from(m1, m5, m15, m30, m60, m240, mD)
adxArr = array.from(a1, a5, a15, a30, a60, a240, aD)

chartSecs = timeframe.in_seconds(timeframe.period)
n = array.size(idxArr)
cnt = 0
sumI = 0.0
sumM = 0.0
sumA = 0.0
bullCnt = 0
bearCnt = 0
for i = 0 to n - 1
    v = array.get(idxArr, i)
    excluded = (skipLower and array.get(tfSecs, i) < chartSecs) or na(v)
    if not excluded
        cnt  += 1
        sumI += v
        sumM += array.get(momArr, i)
        sumA += array.get(adxArr, i)
        if v >= 55
            bullCnt += 1
        else if v <= 45
            bearCnt += 1
avgIdx = cnt > 0 ? sumI / cnt : na
avgMom = cnt > 0 ? sumM / cnt : na
avgAdx = cnt > 0 ? sumA / cnt : na
alignPct   = cnt > 0 ? math.round(100.0 * math.max(bullCnt, bearCnt) / cnt) : 0
strength   = na(avgIdx) ? 0.0 : math.abs(avgIdx - 50.0) / 50.0
confidence = cnt > 0 ? math.round(100.0 * (0.6 * (math.max(bullCnt, bearCnt) / cnt) + 0.4 * strength)) : 0
mktState   = cnt == 0 ? "Sin datos" :
     avgAdx >= 25 and alignPct >= 70 ? "Tendencia fuerte" :
     avgAdx >= 20 ? "Tendencia" : alignPct < 55 ? "Rango / Indeciso" : "Transición"
     // ═══════════════════════════════════════════════════════════════════════════
//  V2 · SMART MONEY CONCEPTS  (usa las series base · no recalcula ta.*)
// ═══════════════════════════════════════════════════════════════════════════
[bg, txt, grid, head, bull, bear, neut] = f_theme()
tsz = f_txtSize()

// ── SMC-1 · ESTRUCTURA (externa + interna) ─────────────────────────────────
phE = ta.pivothigh(high, extLen, extLen)
plE = ta.pivotlow(low,  extLen, extLen)
phI = ta.pivothigh(high, intLen, intLen)
plI = ta.pivotlow(low,  intLen, intLen)

var float extHi = na
var float extLo = na
var float prevExtHi = na
var float prevExtLo = na
var int   extHiBar = na
var int   extLoBar = na
var bool  extHiBroken = false
var bool  extLoBroken = false
var int   extTrend = 0
var string swingTxt = "—"
var string lastBOS = "—"
var string lastCHoCH = "—"

if not na(phE)
    prevExtHi := extHi
    extHi := phE
    extHiBar := bar_index - extLen
    extHiBroken := false
    swingTxt := na(prevExtHi) ? "H" : phE > prevExtHi ? "HH" : "LH"
    if showMSlbl and showDraw
        label.new(extHiBar, phE, swingTxt, style = label.style_label_down,
             color = color.new(color.white, 100), textcolor = neut, size = size.tiny)
if not na(plE)
    prevExtLo := extLo
    extLo := plE
    extLoBar := bar_index - extLen
    extLoBroken := false
    swingTxt := na(prevExtLo) ? "L" : plE > prevExtLo ? "HL" : "LL"
    if showMSlbl and showDraw
        label.new(extLoBar, plE, swingTxt, style = label.style_label_up,
             color = color.new(color.white, 100), textcolor = neut, size = size.tiny)

f_msLine(int fb, float p, string t, color c) =>
    if showMSlbl and showDraw
        line.new(fb, p, bar_index, p, color = c, style = line.style_dashed, width = 1)
        label.new(bar_index, p, t, style = label.style_label_left,
             color = color.new(c, 85), textcolor = c, size = size.tiny)

bool extBOSbull = false
bool extBOSbear = false
bool chochBull  = false
bool chochBear  = false
if barstate.isconfirmed and not na(extHi) and not extHiBroken and close > extHi
    extHiBroken := true
    if extTrend == 1
        extBOSbull := true
        lastBOS := "BOS ▲ (externo)"
        f_msLine(extHiBar, extHi, "BOS ▲", bull)
    else
        chochBull := true
        extTrend := 1
        lastCHoCH := "CHoCH ▲"
        f_msLine(extHiBar, extHi, "CHoCH ▲", bull)
if barstate.isconfirmed and not na(extLo) and not extLoBroken and close < extLo
    extLoBroken := true
    if extTrend == -1
        extBOSbear := true
        lastBOS := "BOS ▼ (externo)"
        f_msLine(extLoBar, extLo, "BOS ▼", bear)
    else
        chochBear := true
        extTrend := -1
        lastCHoCH := "CHoCH ▼"
        f_msLine(extLoBar, extLo, "CHoCH ▼", bear)

var float intHi = na
var float intLo = na
var bool  intHiBroken = false
var bool  intLoBroken = false
bool intBOSbull = false
bool intBOSbear = false
if not na(phI)
    intHi := phI
    intHiBroken := false
if not na(plI)
    intLo := plI
    intLoBroken := false
if barstate.isconfirmed and not na(intHi) and not intHiBroken and close > intHi
    intHiBroken := true
    intBOSbull := true
if barstate.isconfirmed and not na(intLo) and not intLoBroken and close < intLo
    intLoBroken := true
    intBOSbear := true

structTxt = extTrend == 1 ? "Alcista" : extTrend == -1 ? "Bajista" : "Indefinida"
structCol = extTrend == 1 ? bull : extTrend == -1 ? bear : neut

// ── SMC-2 · LIQUIDEZ ───────────────────────────────────────────────────────
type Lq
    float price
    int   side
    bool  eq
    bool  swept
    line  ln
    label lb
var array<Lq> liqs = array.new<Lq>()
var string lastSweep = "—"

f_addLq(float p, int side, bool eq, color c) =>
    if showDraw and not na(p)
        ln = line.new(bar_index, p, bar_index + 3, p, color = c, width = eq ? 2 : 1,
             style = eq ? line.style_solid : line.style_dotted)
        lb = label.new(bar_index + 3, p, eq ? (side == 1 ? "EQH" : "EQL") : (side == 1 ? "BSL" : "SSL"),
             style = label.style_label_left, color = color.new(c, 90), textcolor = c, size = size.tiny)
        array.push(liqs, Lq.new(p, side, eq, false, ln, lb))
        if array.size(liqs) > 16
            old = array.shift(liqs)
            line.delete(old.ln)
            label.delete(old.lb)

if not na(phE)
    isEq = not na(prevExtHi) and math.abs(phE - prevExtHi) <= eqTol * atr
    f_addLq(isEq ? math.max(phE, prevExtHi) : phE, 1, isEq, isEq ? neut : color.new(#90a4ae, 0))
if not na(plE)
    isEq = not na(prevExtLo) and math.abs(plE - prevExtLo) <= eqTol * atr
    f_addLq(isEq ? math.min(plE, prevExtLo) : plE, -1, isEq, isEq ? neut : color.new(#90a4ae, 0))

bool sweepUp = false
bool sweepDn = false
int liqAbove = 0
int liqBelow = 0
if array.size(liqs) > 0
    i = 0
    while i < array.size(liqs)
        lv = array.get(liqs, i)
        removed = false
        if not lv.swept and not na(lv.ln)
            line.set_x2(lv.ln, bar_index + 3)
            label.set_x(lv.lb, bar_index + 3)
        if barstate.isconfirmed and not lv.swept
            if lv.side == 1 and high > lv.price and close <= lv.price
                lv.swept := true
                sweepUp := true
                lastSweep := (lv.eq ? "EQH" : "BSL") + " ⚡"
                if not na(lv.ln)
                    line.set_color(lv.ln, color.new(color.gray, 45))
                    label.set_text(lv.lb, "swept ⚡")
            else if lv.side == -1 and low < lv.price and close >= lv.price
                lv.swept := true
                sweepDn := true
                lastSweep := (lv.eq ? "EQL" : "SSL") + " ⚡"
                if not na(lv.ln)
                    line.set_color(lv.ln, color.new(color.gray, 45))
                    label.set_text(lv.lb, "swept ⚡")
            else if lv.side == 1 and close > lv.price
                if not na(lv.ln)
                    line.delete(lv.ln)
                    label.delete(lv.lb)
                array.remove(liqs, i)
                removed := true
            else if lv.side == -1 and close < lv.price
                if not na(lv.ln)
                    line.delete(lv.ln)
                    label.delete(lv.lb)
                array.remove(liqs, i)
                removed := true
        if not removed
            if not lv.swept
                if lv.price > close
                    liqAbove += 1
                else
                    liqBelow += 1
            i += 1

// ── SMC-3 · FAIR VALUE GAPS ────────────────────────────────────────────────
type Fvg
    int   dir
    float top
    float bot
    int   state
    box   bx
var array<Fvg> fvgs = array.new<Fvg>()
int fvgBull = 0
int fvgBear = 0

f_addFvg(int dir, float top, float bot) =>
    box b = na
    if showDraw
        b := box.new(bar_index - 1, top, bar_index, bot,
             bgcolor = color.new(dir == 1 ? bull : bear, 82),
             border_color = color.new(dir == 1 ? bull : bear, 55), border_width = 1)
    array.push(fvgs, Fvg.new(dir, top, bot, 0, b))
    cntD = 0
    if array.size(fvgs) > 0
        for k = array.size(fvgs) - 1 to 0
            ff = array.get(fvgs, k)
            if ff.dir == dir and ff.state == 0
                cntD += 1
                if cntD > fvgMax
                    if not na(ff.bx)
                        box.delete(ff.bx)
                    array.remove(fvgs, k)

if barstate.isconfirmed and low > high[2] and (low - high[2]) >= fvgMinATR * atr
    f_addFvg(1, low, high[2])
if barstate.isconfirmed and high < low[2] and (low[2] - high) >= fvgMinATR * atr
    f_addFvg(-1, low[2], high)

if array.size(fvgs) > 0
    i = 0
    while i < array.size(fvgs)
        f = array.get(fvgs, i)
        keep = true
        if f.state == 0
            if not na(f.bx)
                box.set_right(f.bx, bar_index)
            if barstate.isconfirmed
                mid = (f.top + f.bot) / 2
                if f.dir == 1 and low <= mid
                    f.state := 1
                if f.dir == -1 and high >= mid
                    f.state := 1
                inv = f.dir == 1 ? close < f.bot : close > f.top
                if inv
                    f.state := 2
                if f.state != 0
                    if not na(f.bx)
                        box.delete(f.bx)
                    array.remove(fvgs, i)
                    keep := false
        if keep
            if f.state == 0
                if f.dir == 1
                    fvgBull += 1
                else
                    fvgBear += 1
            i += 1

// ── SMC-4 · ORDER BLOCKS ───────────────────────────────────────────────────
type Ob
    int   dir
    float top
    float bot
    bool  mitig
    box   bx
    label lb
var array<Ob> obs = array.new<Ob>()

f_addOb(int dir) =>
    float top = na
    float bot = na
    if dir == 1
        for j = 1 to extLen
            if close[j] < open[j]
                top := high[j]
                bot := low[j]
                break
    else
        for j = 1 to extLen
            if close[j] > open[j]
                top := high[j]
                bot := low[j]
                break
    if not na(top)
        box b = na
        label l = na
        if showDraw
            b := box.new(bar_index - 1, top, bar_index, bot,
                 bgcolor = color.new(dir == 1 ? bull : bear, 78),
                 border_color = color.new(dir == 1 ? bull : bear, 30), border_width = 1)
            l := label.new(bar_index, (top + bot) / 2, dir == 1 ? "OB+" : "OB-",
                 style = label.style_label_left, color = color.new(dir == 1 ? bull : bear, 60),
                 textcolor = color.white, size = size.tiny)
        array.push(obs, Ob.new(dir, top, bot, false, b, l))
        cntD = 0
        if array.size(obs) > 0
            for k = array.size(obs) - 1 to 0
                oo = array.get(obs, k)
                if oo.dir == dir and not oo.mitig
                    cntD += 1
                    if cntD > obMax
                        if not na(oo.bx)
                            box.delete(oo.bx)
                        if not na(oo.lb)
                            label.delete(oo.lb)
                        array.remove(obs, k)

if extBOSbull or chochBull
    f_addOb(1)
if extBOSbear or chochBear
    f_addOb(-1)

bool priceInOB = false
string obTxt = "—"
color obCol = neut
if array.size(obs) > 0
    i = 0
    while i < array.size(obs)
        o = array.get(obs, i)
        rm = false
        if not o.mitig
            if not na(o.bx)
                box.set_right(o.bx, bar_index)
                if not na(o.lb)
                    label.set_x(o.lb, bar_index)
            inside = close <= o.top and close >= o.bot
            if inside
                priceInOB := true
                obTxt := o.dir == 1 ? "Precio en OB+" : "Precio en OB-"
                obCol := o.dir == 1 ? bull : bear
            if barstate.isconfirmed
                mit = o.dir == 1 ? close < o.bot : close > o.top
                if mit
                    o.mitig := true
                    if not na(o.bx)
                        box.delete(o.bx)
                    if not na(o.lb)
                        label.delete(o.lb)
                    array.remove(obs, i)
                    rm := true
        if not rm
            i += 1
if obTxt == "—" and array.size(obs) > 0
    lastO = array.get(obs, array.size(obs) - 1)
    obTxt := lastO.dir == 1 ? "OB+ activo" : "OB- activo"
    obCol := lastO.dir == 1 ? bull : bear

// ── SMC-5 · PREMIUM / DISCOUNT ─────────────────────────────────────────────
var box pdPrem = na
var box pdEq   = na
var box pdDisc = na
var line pdMark = na
string pdTxt = "—"
color  pdCol = neut
float  pdFrac = na
if not na(extHi) and not na(extLo) and extHi > extLo
    rng = extHi - extLo
    pdFrac := (close - extLo) / rng
    pdTxt := pdFrac > 0.55 ? "Premium" : pdFrac < 0.45 ? "Discount" : "Equilibrium"
    pdCol := pdFrac > 0.55 ? bear : pdFrac < 0.45 ? bull : neut
    if showDraw and barstate.islast
        if not na(pdPrem)
            box.delete(pdPrem)
        if not na(pdEq)
            box.delete(pdEq)
        if not na(pdDisc)
            box.delete(pdDisc)
        if not na(pdMark)
            line.delete(pdMark)
        L = bar_index + pdOffset
        R = bar_index + pdOffset + 3
        pdPrem := box.new(L, extHi, R, extLo + rng * 0.55, bgcolor = color.new(bear, 70), border_color = color.new(bear, 40))
        pdEq   := box.new(L, extLo + rng * 0.55, R, extLo + rng * 0.45, bgcolor = color.new(neut, 60), border_color = color.new(neut, 30))
        pdDisc := box.new(L, extLo + rng * 0.45, R, extLo, bgcolor = color.new(bull, 70), border_color = color.new(bull, 40))
        pdMark := line.new(L, close, R, close, color = color.white, width = 2)
// ═══════════════════════════════════════════════════════════════════════════
//  V3 · SISTEMA DE DECISIÓN  (reutiliza series base · sin recalcular ta.*)
// ═══════════════════════════════════════════════════════════════════════════
biasBull = not na(avgIdx) and avgIdx >= 50
biasBear = not na(avgIdx) and avgIdx <  50

// ── 1 · CALIDAD DE ENTRADA (0-100 · confluencia, NO probabilidad) ───────────
f_qualityScore() =>
    s = 0
    s += (biasBull and avgIdx >= 60) or (biasBear and avgIdx <= 40) ? 15 : (na(avgIdx) ? 0 : 5)
    s += (biasBull and avgMom >= 55) or (biasBear and avgMom <= 45) ? 10 : 0
    s += (biasBull and extBOSbull) or (biasBear and extBOSbear) ? 12 : 0
    s += (biasBull and str.contains(lastCHoCH, "▲")) or (biasBear and str.contains(lastCHoCH, "▼")) ? 8 : 0
    s += (biasBull and liqAbove > 0) or (biasBear and liqBelow > 0) ? 10 : 0
    s += priceInOB and ((biasBull and obCol == bull) or (biasBear and obCol == bear)) ? 12 : (priceInOB ? 4 : 0)
    s += (biasBull and fvgBull > 0) or (biasBear and fvgBear > 0) ? 10 : 0
    s += (biasBull and pdTxt == "Discount") or (biasBear and pdTxt == "Premium") ? 8 : (pdTxt == "Equilibrium" ? 3 : 0)
    s += relVol >= 1.2 ? 8 : relVol >= 1.0 ? 4 : 0
    s += alignPct >= 80 ? 7 : alignPct >= 65 ? 4 : 0
    math.max(0, math.min(100, s))
qualityScore = f_qualityScore()
qualityClass = qualityScore >= qMinAplus ? "A+ Setup" : qualityScore >= 70 ? "A Setup" :
     qualityScore >= 55 ? "B Setup" : qualityScore >= 40 ? "C Setup" : "No operar"
qualityCol   = qualityScore >= qMinAplus ? bull : qualityScore >= 55 ? neut : bear

// ── 2 · CONTINUACIÓN (0-100) ────────────────────────────────────────────────
f_continuation() =>
    c = 0.0
    c += (na(avgMom) ? 0.0 : math.abs(avgMom - 50) / 50) * 25
    c += math.min(relVol, 2.0) / 2.0 * 20
    body = math.abs(close - open)
    rngC = math.max(high - low, syminfo.mintick)
    c += (body / rngC) * 20
    slopeN = math.abs(emaFast - emaFast[slopeL]) / math.max(atr, syminfo.mintick)
    c += math.min(slopeN, 1.0) * 20
    atrExpC = nz(atr[3]) > 0 ? atr / atr[3] : 1.0
    c += math.max(0.0, math.min(1.0, atrExpC - 1.0)) * 15
    math.round(math.max(0, math.min(100, c)))
contIdx = f_continuation()

// ── 3 · AGOTAMIENTO (0-100) ─────────────────────────────────────────────────
f_exhaustion() =>
    e = 0.0
    e += (rsiCur >= 75 or rsiCur <= 25) ? 22 : (rsiCur >= 68 or rsiCur <= 32) ? 12 : 0
    distE = math.abs(close - emaFast) / math.max(atr, syminfo.mintick)
    e += math.min(distE / 4.0, 1.0) * 22
    divBear = high > high[1] and rsiCur < rsiCur[1] and rsiCur > 60
    divBull = low  < low[1]  and rsiCur > rsiCur[1] and rsiCur < 40
    e += (divBear or divBull) ? 20 : 0
    e += relVol < 0.8 ? 18 : relVol < 1.0 ? 9 : 0
    slowLoss = math.abs(close - close[slopeL]) < math.abs(close[slopeL] - close[slopeL * 2]) ? 18 : 0
    e += slowLoss
    math.round(math.max(0, math.min(100, e)))
exhIdx = f_exhaustion()

// ── 4 · FUERZA INSTITUCIONAL (Compra % / Venta %) ───────────────────────────
f_institutional() =>
    body = close - open
    rngI = math.max(high - low, syminfo.mintick)
    impuls = body / rngI
    vel = (close - close[slopeL]) / math.max(atr, syminfo.mintick)
    persist = 0
    for k = 0 to 4
        persist += close[k] >= open[k] ? 1 : -1
    persistN = persist / 5.0
    volW = math.min(relVol, 2.0) / 2.0
    raw = (impuls * 0.35 + math.max(-1.0, math.min(1.0, vel)) * 0.30 + persistN * 0.35) * volW
    bp = math.round(math.max(0, math.min(100, 50 + raw * 50)))
    [bp, 100 - bp]
[buyersPct, sellersPct] = f_institutional()

// ── 5 · RIESGO (0-100) ──────────────────────────────────────────────────────
f_risk() =>
    rk = 0
    rk += exhIdx >= 65 ? 30 : exhIdx >= 45 ? 15 : 0
    rk += qualityScore < 45 ? 25 : qualityScore < 60 ? 12 : 0
    rk += alignPct < 55 ? 20 : alignPct < 70 ? 10 : 0
    rk += (biasBull and pdTxt == "Premium") or (biasBear and pdTxt == "Discount") ? 15 : 0
    rk += relVol < 0.8 ? 10 : 0
    math.max(0, math.min(100, rk))
riskScore = f_risk()
riskClass = riskScore >= 80 ? "Extremo" : riskScore >= 60 ? "Alto" :
     riskScore >= 40 ? "Medio" : riskScore >= 20 ? "Bajo" : "Muy Bajo"
riskCol   = riskScore >= 60 ? bear : riskScore >= 40 ? neut : bull

// ── 6 · CHECKLIST (10 condiciones) ──────────────────────────────────────────
chkBOS   = (biasBull and extBOSbull) or (biasBear and extBOSbear)
chkCHoCH = (biasBull and str.contains(lastCHoCH, "▲")) or (biasBear and str.contains(lastCHoCH, "▼"))
chkFVG   = (biasBull and fvgBull > 0) or (biasBear and fvgBear > 0)
chkOB    = priceInOB
chkLiq   = (biasBull and liqAbove > 0) or (biasBear and liqBelow > 0)
chkMom   = (biasBull and avgMom >= 55) or (biasBear and avgMom <= 45)
chkTrend = (biasBull and avgIdx >= 60) or (biasBear and avgIdx <= 40)
chkVol   = relVol >= 1.0
chkPD    = (biasBull and pdTxt == "Discount") or (biasBear and pdTxt == "Premium")
chkTF    = alignPct >= 70
checkCount = (chkBOS ? 1 : 0) + (chkCHoCH ? 1 : 0) + (chkFVG ? 1 : 0) + (chkOB ? 1 : 0) + (chkLiq ? 1 : 0) +
             (chkMom ? 1 : 0) + (chkTrend ? 1 : 0) + (chkVol ? 1 : 0) + (chkPD ? 1 : 0) + (chkTF ? 1 : 0)

// ═══════════════════════════════════════════════════════════════════════════
//  V4 · MODO NO TRADE  (filtro maestro · evalúa 10 condiciones adversas)
// ═══════════════════════════════════════════════════════════════════════════
// Rango prolongado: cuántas de las últimas ntRange velas quedaron dentro del
// rango de la estructura externa (sin romper extremos).
rangeCount = 0
if not na(extHi) and not na(extLo)
    for k = 0 to math.min(ntRange - 1, bar_index)
        if high[k] <= extHi and low[k] >= extLo
            rangeCount += 1
rangePct = ntRange > 0 ? rangeCount / ntRange : 0.0

atrPctPrice = close > 0 ? (atr / close) * 100 : 0.0        // ATR como % del precio
bodyRatio   = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0.0

// ── Las 10 condiciones NO TRADE (cada una con su motivo textual) ────────────
nt1  = mktState == "Rango / Indeciso"                              // mercado lateral
nt2  = not na(avgAdx) and avgAdx < ntAdx                           // ADX muy bajo
nt3  = cnt > 0 and alignPct < ntAlign                             // TFs divididas
nt4  = contIdx < 30 and exhIdx > 55                              // volatilidad/impulso pobre
nt5  = atrPctPrice < ntAtrPct                                    // ATR extremadamente bajo
nt6  = bodyRatio < 0.25 and relVol < 1.0                         // velas pequeñas/indecisas
nt7  = rangePct >= 0.8                                           // rango prolongado
nt8  = bullCnt > 0 and bearCnt > 0 and math.abs(bullCnt - bearCnt) <= 1  // señales contradictorias
nt9  = riskScore >= ntRisk                                       // riesgo elevado
nt10 = extTrend == 0                                             // falta de estructura

noTrade = nt1 or nt2 or nt3 or nt4 or nt5 or nt6 or nt7 or nt8 or nt9 or nt10

// Construcción de la lista de motivos (solo los activos)
f_reasons() =>
    s = ""
    s := s + (nt1  ? "• Mercado lateral\n"          : "")
    s := s + (nt2  ? "• ADX bajo\n"                 : "")
    s := s + (nt3  ? "• Temporalidades divididas\n" : "")
    s := s + (nt4  ? "• Impulso débil / agotado\n"  : "")
    s := s + (nt5  ? "• ATR extremadamente bajo\n"  : "")
    s := s + (nt6  ? "• Velas pequeñas\n"           : "")
    s := s + (nt7  ? "• Rango prolongado\n"         : "")
    s := s + (nt8  ? "• Señales contradictorias\n"  : "")
    s := s + (nt9  ? "• Riesgo elevado\n"           : "")
    s := s + (nt10 ? "• Falta de estructura\n"      : "")
    s
reasons = f_reasons()

// ── FILTRO MAESTRO: NO TRADE anula señales y alertas de entrada ─────────────
isAplus     = not noTrade and qualityScore >= qMinAplus and checkCount >= 8
trendFlip   = chochBull or chochBear
riskHighNew = riskScore >= 60 and riskScore[1] < 60
extBull     = not na(avgIdx) and avgIdx >= 80 and not noTrade
extBear     = not na(avgIdx) and avgIdx <= 20 and not noTrade
highConf    = not noTrade and confidence >= 80 and checkCount >= 7
ntEnter     = noTrade and not noTrade[1]     // entra en NO TRADE
ntExit      = not noTrade and noTrade[1]     // sale de NO TRADE

// ═══════════════════════════════════════════════════════════════════════════
//  RENDER DEL DASHBOARD  (solo en la última vela · modo compacto/completo)
// ═══════════════════════════════════════════════════════════════════════════
compact = viewMode == "Compacto"
var table dash = table.new(f_pos(), 3, 46, border_width = 1)

f_sumRow(int row, string k, string v, color vc) =>
    table.cell(dash, 0, row, k, text_color = txt, bgcolor = bg, text_size = tsz, text_halign = text.align_left)
    table.cell(dash, 1, row, v, text_color = vc, bgcolor = bg, text_size = tsz)
    table.merge_cells(dash, 1, row, 2, row)

f_chk(bool ok) => ok ? "✓" : "✗"

if barstate.islast
    table.clear(dash, 0, 0, 2, 45)
    r = 0
    // ── AVISO NO TRADE (enorme, siempre arriba del todo) ────────────────────
    if noTrade
        table.cell(dash, 0, r, "⛔  NO TRADE  ⛔", text_color = color.white,
             bgcolor = color.new(bear, 0), text_size = size.huge, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 2, r)
        r += 1
        table.cell(dash, 0, r, "Motivos:\n" + reasons + "Esperar mejor oportunidad.",
             text_color = color.white, bgcolor = color.new(bear, 75),
             text_size = tsz, text_halign = text.align_left)
        table.merge_cells(dash, 0, r, 2, r)
        r += 1
    else
        table.cell(dash, 0, r, "✅ CONDICIONES OPERABLES", text_color = color.white,
             bgcolor = color.new(bull, 20), text_size = tsz, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 2, r)
        r += 1

    // ── Cabecera ────────────────────────────────────────────────────────────
    table.cell(dash, 0, r, "IMD · MERCADO", text_color = color.white, bgcolor = head,
         text_size = tsz, text_halign = text.align_left)
    table.merge_cells(dash, 0, r, 2, r)
    r += 1

    // ── Filas por TF (solo en modo completo) ────────────────────────────────
    if showTF and not compact
        table.cell(dash, 0, r, "TF",     text_color = txt, bgcolor = bg, text_size = tsz)
        table.cell(dash, 1, r, "Índice", text_color = txt, bgcolor = bg, text_size = tsz)
        table.cell(dash, 2, r, "Estado", text_color = txt, bgcolor = bg, text_size = tsz)
        r += 1
        for i = 0 to n - 1
            v    = array.get(idxArr, i)
            excl = (skipLower and array.get(tfSecs, i) < chartSecs) or na(v)
            cc   = f_scoreColor(v, bull, bear, neut, txt)
            table.cell(dash, 0, r, array.get(tfNames, i), text_color = txt, bgcolor = bg, text_size = tsz)
            table.cell(dash, 1, r, excl ? "—" : str.tostring(math.round(v)),
                 text_color = excl ? txt : color.white, bgcolor = excl ? bg : color.new(cc, 15), text_size = tsz)
            table.cell(dash, 2, r, excl ? "—" : f_class(v), text_color = cc, bgcolor = bg, text_size = tsz)
            r += 1

    // ── Resumen ──────────────────────────────────────────────────────────────
    if showSum
        domCol = f_scoreColor(avgIdx, bull, bear, neut, txt)
        table.cell(dash, 0, r, "── RESUMEN ──", text_color = color.white, bgcolor = grid, text_size = tsz, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 2, r)
        r += 1
        f_sumRow(r, "Mercado", na(avgIdx) ? "—" : f_class(avgIdx) + " (" + str.tostring(math.round(avgIdx)) + ")", domCol)
        r += 1
        f_sumRow(r, "Confianza", str.tostring(confidence) + "%", confidence >= 70 ? bull : confidence >= 45 ? neut : bear)
        r += 1
        if not compact
            f_sumRow(r, "Alineación TFs", str.tostring(alignPct) + "% (" + str.tostring(math.max(bullCnt, bearCnt)) + "/" + str.tostring(cnt) + ")", domCol)
            r += 1
        f_sumRow(r, "Estado", mktState, txt)
        r += 1

    // ── Smart Money (solo completo) ─────────────────────────────────────────
    if showSMC and not compact
        table.cell(dash, 0, r, "── SMART MONEY ──", text_color = color.white, bgcolor = grid, text_size = tsz, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 2, r)
        r += 1
        f_sumRow(r, "Estructura", structTxt + " · " + swingTxt, structCol)
        r += 1
        f_sumRow(r, "Último BOS", lastBOS, lastBOS == "—" ? txt : structCol)
        r += 1
        f_sumRow(r, "Último CHoCH", lastCHoCH, lastCHoCH == "—" ? txt : (str.contains(lastCHoCH, "▲") ? bull : bear))
        r += 1
        f_sumRow(r, "Liquidez", "▲" + str.tostring(liqAbove) + "  ▼" + str.tostring(liqBelow), neut)
        r += 1
        f_sumRow(r, "Último barrido", lastSweep, lastSweep == "—" ? txt : neut)
        r += 1
        f_sumRow(r, "Order Block", obTxt, obCol)
        r += 1
        f_sumRow(r, "FVG válidos", "▲" + str.tostring(fvgBull) + "  ▼" + str.tostring(fvgBear), neut)
        r += 1
        pdShow = na(pdFrac) ? "—" : pdTxt + " (" + str.tostring(math.round(pdFrac * 100)) + "%)"
        f_sumRow(r, "Premium/Discount", pdShow, pdCol)
        r += 1

    // ── Decisión ─────────────────────────────────────────────────────────────
    if showV3
        table.cell(dash, 0, r, "── DECISIÓN ──", text_color = color.white, bgcolor = grid, text_size = tsz, text_halign = text.align_center)
        table.merge_cells(dash, 0, r, 2, r)
        r += 1
        // Calidad y señal: si NO TRADE, se fuerza a "—" (no muestra compra/venta)
        f_sumRow(r, "Calidad", noTrade ? "— (bloqueado)" : str.tostring(qualityScore) + "/100 · " + qualityClass, noTrade ? txt : qualityCol)
        r += 1
        if not compact
            f_sumRow(r, "Continuación", str.tostring(contIdx) + "/100", contIdx >= 55 ? bull : neut)
            r += 1
            f_sumRow(r, "Agotamiento", str.tostring(exhIdx) + "/100", exhIdx >= 60 ? bear : exhIdx >= 40 ? neut : bull)
            r += 1
        f_sumRow(r, "Fuerza inst.", "Compra " + str.tostring(buyersPct) + "% / Venta " + str.tostring(sellersPct) + "%", buyersPct >= 50 ? bull : bear)
        r += 1
        f_sumRow(r, "Riesgo", riskClass + " (" + str.tostring(riskScore) + ")", riskCol)
        r += 1
        f_sumRow(r, "Checklist", str.tostring(checkCount) + "/10", checkCount >= 8 ? bull : checkCount >= 5 ? neut : bear)
        r += 1
        if not compact
            chkTxt1 = "BOS " + f_chk(chkBOS) + "  CHoCH " + f_chk(chkCHoCH) + "  FVG " + f_chk(chkFVG) + "  OB " + f_chk(chkOB) + "  Liq " + f_chk(chkLiq)
            chkTxt2 = "Mom " + f_chk(chkMom) + "  Ten " + f_chk(chkTrend) + "  Vol " + f_chk(chkVol) + "  P/D " + f_chk(chkPD) + "  TF " + f_chk(chkTF)
            table.cell(dash, 0, r, chkTxt1, text_color = txt, bgcolor = bg, text_size = size.tiny, text_halign = text.align_left)
            table.merge_cells(dash, 0, r, 2, r)
            r += 1
            table.cell(dash, 0, r, chkTxt2, text_color = txt, bgcolor = bg, text_size = size.tiny, text_halign = text.align_left)
            table.merge_cells(dash, 0, r, 2, r)
            r += 1
        // Señal de entrada SOLO si no hay NO TRADE
        if isAplus
            table.cell(dash, 0, r, "★ ENTRADA A+ (" + (biasBull ? "COMPRA" : "VENTA") + ") ★", text_color = color.white,
                 bgcolor = biasBull ? bull : bear, text_size = tsz, text_halign = text.align_center)
            table.merge_cells(dash, 0, r, 2, r)

// ═══════════════════════════════════════════════════════════════════════════
//  ALERTAS  (las de entrada quedan anuladas por NO TRADE en su propia condición)
// ═══════════════════════════════════════════════════════════════════════════
alertcondition(extBOSbull or extBOSbear, "SMC · BOS externo",       "IMD: BOS externo en {{ticker}}")
alertcondition(chochBull or chochBear,   "SMC · CHoCH",             "IMD: CHoCH en {{ticker}}")
alertcondition(sweepUp or sweepDn,       "SMC · Liquidity Sweep",   "IMD: barrido de liquidez en {{ticker}}")
alertcondition(trendFlip,                "V3 · Cambio tendencia",   "IMD: cambio de tendencia (CHoCH) en {{ticker}}")
alertcondition(isAplus,                  "V3 · Entrada A+",         "IMD: Setup A+ ({{ticker}}) — confluencia alta, gestionar riesgo")
alertcondition(riskHighNew,              "V3 · Riesgo alto",        "IMD: riesgo ALTO en {{ticker}}")
alertcondition(highConf,                 "V4 · Alta confianza",     "IMD: alta confianza en {{ticker}}")
alertcondition(extBull,                  "V4 · Extremo alcista",    "IMD: mercado extremadamente alcista en {{ticker}}")
alertcondition(extBear,                  "V4 · Extremo bajista",    "IMD: mercado extremadamente bajista en {{ticker}}")
alertcondition(ntEnter,                  "V4 · Activación NO TRADE","IMD: NO TRADE activado en {{ticker}}")
alertcondition(ntExit,                   "V4 · Salida NO TRADE",    "IMD: NO TRADE desactivado — condiciones mejoran en {{ticker}}")

// ── Exports (ventana de datos) ──────────────────────────────────────────────
plot(avgIdx,       "Índice dominante", display = display.data_window)
plot(confidence,   "Confianza",        display = display.data_window)
plot(qualityScore, "Calidad",          display = display.data_window)
plot(riskScore,    "Riesgo",           display = display.data_window)
plot(noTrade ? 1 : 0, "NO TRADE",      display = display.data_window)