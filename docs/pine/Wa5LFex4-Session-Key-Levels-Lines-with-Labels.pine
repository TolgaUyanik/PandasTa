//@version=5
indicator("Session Key Levels Lines (with Labels)", overlay=true, max_lines_count=10, max_labels_count=10)

myTZ = "America/New_York"

// --- Detect sessions ---
inPremkt   = not na(time(timeframe.period, "0400-0930:1234567", myTZ))
inRTH      = not na(time(timeframe.period, "0930-1600:1234567", myTZ))
inLastHour = not na(time(timeframe.period, "1500-1600:1234567", myTZ))
newDay     = ta.change(time("D", myTZ)) != 0

// --- Premarket High/Low ---
var float preHigh = na
var float preLow  = na
if newDay
    preHigh := na
    preLow  := na
if inPremkt
    preHigh := na(preHigh) ? high : math.max(preHigh, high)
    preLow  := na(preLow)  ? low  : math.min(preLow, low)

// --- RTH OHLC + open tracking ---
var float sessOpen  = na
var float sessHigh  = na
var float sessLow   = na
var float sessClose = na

// Previous session values
var float prevOpen  = na
var float prevHigh  = na
var float prevLow   = na
var float prevClose = na

// Last hour swing hi/lo of prev RTH
var float swingHigh     = na
var float swingLow      = na
var float prevSwingHigh = na
var float prevSwingLow  = na

// On RTH session start
isRTHStart = inRTH and not inRTH[1]
isRTHEnd   = inRTH[1] and not inRTH
if isRTHStart
    sessOpen := open
    sessHigh := high
    sessLow  := low
    swingHigh := na
    swingLow  := na

// During RTH, track session high/low/close
if inRTH
    sessHigh := na(sessHigh) ? high : math.max(sessHigh, high)
    sessLow  := na(sessLow)  ? low  : math.min(sessLow, low)
    sessClose := close

// On RTH end, update previous session values
if isRTHEnd
    prevOpen      := sessOpen
    prevHigh      := sessHigh
    prevLow       := sessLow
    prevClose     := sessClose
    prevSwingHigh := swingHigh
    prevSwingLow  := swingLow
    sessOpen      := na
    sessHigh      := na
    sessLow       := na
    sessClose     := na

// Track swings in last RTH hour (15:00–16:00)
if inLastHour and inRTH
    swingHigh := na(swingHigh) ? high : math.max(swingHigh, high)
    swingLow  := na(swingLow)  ? low  : math.min(swingLow, low)

// --- Declare all persistent lines and labels ---
var line linePremktHigh  = na
var line linePremktLow   = na
var line linePrevHigh    = na
var line linePrevLow     = na
var line linePrevClose   = na
var line lineSessOpen    = na
var line lineSwingHigh   = na
var line lineSwingLow    = na

var label labelPremktHigh  = na
var label labelPremktLow   = na
var label labelPrevHigh    = na
var label labelPrevLow     = na
var label labelPrevClose   = na
var label labelSessOpen    = na
var label labelSwingHigh   = na
var label labelSwingLow    = na

// --- Utility: Draw line ---
f_draw_line(l, price, clr, w, s) =>
    if not na(price)
        if na(l)
            line.new(bar_index - 1, price, bar_index + 1, price, color=clr, width=w, style=s, extend=extend.right)
        else
            line.set_xy1(l, bar_index - 1, price)
            line.set_xy2(l, bar_index + 1, price)
            l
    else
        if not na(l)
            line.delete(l)
        na

// --- Utility: Draw label at right edge ---
f_draw_label(lb, price, txt, clr) =>
    if not na(price) and barstate.islast
        if not na(lb)
            label.delete(lb)
        label.new(bar_index + 10, price, txt, xloc.bar_index, yloc.price, color=clr, textcolor=color.white, size=size.small, style=label.style_label_left)
    else
        if not na(lb)
            label.delete(lb)
        na

// --- Plot all lines and labels ---
showPremkt = not inPremkt and not na(preHigh) and not na(preLow)

linePremktHigh := f_draw_line(linePremktHigh, showPremkt ? preHigh : na, color.red, 2, line.style_dashed)
linePremktLow  := f_draw_line(linePremktLow,  showPremkt ? preLow  : na, color.red, 2, line.style_dashed)
labelPremktHigh := f_draw_label(labelPremktHigh, showPremkt ? preHigh : na, "Premkt High", color.red)
labelPremktLow  := f_draw_label(labelPremktLow,  showPremkt ? preLow  : na, "Premkt Low", color.red)

linePrevHigh  := f_draw_line(linePrevHigh,  not na(prevHigh)  ? prevHigh  : na, color.orange, 2, line.style_solid)
linePrevLow   := f_draw_line(linePrevLow,   not na(prevLow)   ? prevLow   : na, color.orange, 2, line.style_solid)
linePrevClose := f_draw_line(linePrevClose, not na(prevClose) ? prevClose : na, color.yellow, 2, line.style_dotted)
labelPrevHigh  := f_draw_label(labelPrevHigh,  not na(prevHigh)  ? prevHigh  : na, "Prev RTH High", color.orange)
labelPrevLow   := f_draw_label(labelPrevLow,   not na(prevLow)   ? prevLow   : na, "Prev RTH Low", color.orange)
labelPrevClose := f_draw_label(labelPrevClose, not na(prevClose) ? prevClose : na, "Prev RTH Close", color.yellow)

lineSessOpen := f_draw_line(lineSessOpen, not na(sessOpen) ? sessOpen : na, color.fuchsia, 2, line.style_dashed)
labelSessOpen := f_draw_label(labelSessOpen, not na(sessOpen) ? sessOpen : na, "Curr RTH Open", color.fuchsia)

lineSwingHigh := f_draw_line(lineSwingHigh, not na(prevSwingHigh) ? prevSwingHigh : na, color.aqua, 2, line.style_solid)
lineSwingLow  := f_draw_line(lineSwingLow,  not na(prevSwingLow)  ? prevSwingLow  : na, color.aqua, 2, line.style_solid)
labelSwingHigh := f_draw_label(labelSwingHigh, not na(prevSwingHigh) ? prevSwingHigh : na, "Prev Last Hr High", color.aqua)
labelSwingLow  := f_draw_label(labelSwingLow,  not na(prevSwingLow)  ? prevSwingLow  : na, "Prev Last Hr Low", color.aqua)