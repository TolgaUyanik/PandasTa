//@version=6

// @description Supporting Utility Library for the Live Economic Calendar by toodegrees Indicator; database with the first 500 Forex Factory News Event types.
library("forex_factory_events_id_A")

// @function Converts a number to Forex Factory News title (first 500).
// @param ID Identifier of the Forex Factory News Event. Please see the library for more information.
// @returns Returns the title of the Forex Factory News Event.
export ff_titleA(string ID) =>
	TITLE = switch ID
		"1"   => "1-y Loan Prime Rate"
		"2"   => "10-y Bond Auction"
		"3"   => "30-y Bond Auction"
		"4"   => "5-y Loan Prime Rate"
