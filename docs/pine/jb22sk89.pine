
// @version=5
// @description Libreria Monty3192 - MontyTrader
library("Monty3192_Library")

// @function Calcula la suma de inv,pre,sum_lot,pre_pro
// @returns inv,pre,sum_lot,pre_pro
export calc_func(float inversion1,float inversion2,float inversion3,float inversion4,float inversion5,float inversion6,float inversion7,
				 float inversion8,float inversion9,float inversion10,float  precio1,float precio2,float precio3,float precio4,float precio5,
				 float precio6,float precio7,float precio8,float precio9,float precio10, bool act_1,bool act_2,bool act_3,bool act_4,
				 bool act_5,bool act_6,bool act_7,bool act_8,bool act_9,bool act_10) =>


    inv_1  = act_1  ? inversion1  : nz(na)
    inv_2  = act_2  ? inversion2  : nz(na)
    inv_3  = act_3  ? inversion3  : nz(na)
    inv_4  = act_4  ? inversion4  : nz(na)
    inv_5  = act_5  ? inversion5  : nz(na)
    inv_6  = act_6  ? inversion6  : nz(na)
    inv_7  = act_7  ? inversion7  : nz(na)
    inv_8  = act_8  ? inversion8  : nz(na)
    inv_9  = act_9  ? inversion9  : nz(na)
    inv_10 = act_10 ? inversion10 : nz(na)


    pre_1  = act_1   ? precio1  : nz(na)
    pre_2  = act_2   ? precio2  : nz(na)
    pre_3  = act_3   ? precio2  : nz(na)
    pre_4  = act_4   ? precio4  : nz(na)
    pre_5  = act_5   ? precio5  : nz(na)
    pre_6  = act_6   ? precio6  : nz(na)
    pre_7  = act_7   ? precio7  : nz(na)
    pre_8  = act_8   ? precio8  : nz(na)
    pre_9  = act_9   ? precio9  : nz(na)
    pre_10 = act_10  ? precio10 : nz(na)


    suma_inversion = nz(inv_1) + nz(inv_2) + nz(inv_3) + nz(inv_4)  + nz(inv_5) + nz(inv_6) + nz(inv_7) + nz(inv_8) + nz(inv_9) + nz(inv_10) 
    suma_precio    = nz(pre_1) + nz(pre_2) + nz(pre_3) + nz(pre_4)  + nz(pre_5) + nz(pre_6) + nz(pre_7) + nz(pre_8) + nz(pre_9) + nz(pre_10)



    lote_primero = act_1  ? nz(inversion1  / precio1) : nz(na)
    lote_segundo = act_2  ? nz(inversion2  / precio2) : nz(na)
    lote_tercero = act_3  ? nz(inversion3  / precio3) : nz(na)
    lote_cuarto  = act_4  ? nz(inversion4  / precio4) : nz(na)
    lote_quinto  = act_5  ? nz(inversion5  / precio5) : nz(na)
    lote_sexto   = act_6  ? nz(inversion6  / precio6) : nz(na)
    lote_septimo = act_7  ? nz(inversion7  / precio7) : nz(na)
    lote_octavo  = act_8  ? nz(inversion8  / precio8) : nz(na)
    lote_noveno  = act_9  ? nz(inversion9  / precio9) : nz(na)
    lote_decimo  = act_10 ? nz(inversion10 / precio10): nz(na)

    suma_lotes       = lote_primero + lote_segundo + lote_tercero + lote_cuarto + lote_quinto + lote_sexto + lote_septimo + lote_octavo + lote_noveno + lote_decimo
    precio_promedio  = suma_inversion / suma_lotes

    [suma_inversion,suma_precio,suma_lotes,precio_promedio]

// @function Calcula la suma de inv,pre,sum_lot,pre_pro
// @returns inv,pre,sum_lot,pre_pro


calc_func(inversion1,inversion2,inversion3,inversion4,inversion5,inversion6,inversion7,inversion8,inversion9,inversion10, precio1,precio2,precio3,precio4,precio5,precio6,precio7,precio8,precio9,precio10) =>

    suma_inversion = nz(inversion1) + nz(inversion2) + nz(inversion3) + nz(inversion4) + nz(inversion5) + nz(inversion6) + nz(inversion7) + nz(inversion8) + nz(inversion9) + nz(inversion10) 
    suma_precio    = nz(precio1) + nz(precio2) + nz(precio3) + nz(precio4)  + nz(precio5) + nz(precio6) + nz(precio7) + nz(precio8) + nz(precio9) + nz(precio10)

    lote_primero = nz(inversion1  / precio1)
    lote_segundo = nz(inversion2  / precio2)
    lote_tercero = nz(inversion3  / precio3)
    lote_cuarto  = nz(inversion4  / precio4)
    lote_quinto  = nz(inversion5  / precio5)
    lote_sexto   = nz(inversion6  / precio6)
    lote_septimo = nz(inversion7  / precio7)
    lote_octavo  = nz(inversion8  / precio8)
    lote_noveno  = nz(inversion9  / precio9)
    lote_decimo  = nz(inversion10 / precio10)

    suma_lotes       = lote_primero + lote_segundo + lote_tercero + lote_cuarto + lote_quinto + lote_sexto + lote_septimo + lote_octavo + lote_noveno + lote_decimo
    precio_promedio  = suma_inversion / suma_lotes

    [suma_inversion,suma_precio,suma_lotes,precio_promedio]

// @function Calcula la suma de inv,pre,sum_lot,pre_pro
// @returns inv,pre,sum_lot,pre_pro

export simple_calc_func(float[] inversiones, float[] precios, bool[] activos) =>

    inv_suma = 0.0
    pre_suma = 0.0
    lote_suma = 0.0

    for i = 0 to 9
        inv_actual = array.get(activos,i) ? array.get(inversiones,i) : na
        pre_actual = array.get(activos,i) ? array.get(precios,i) : na
        
        inv_suma := inv_suma + nz(inv_actual)
        pre_suma := pre_suma + nz(pre_actual)
        
        lote_actual = array.get(activos,i) ? nz(array.get(inversiones,i) / array.get(precios,i)) : na
        lote_suma := lote_suma + nz(lote_actual)

    precio_promedio = inv_suma != 0 ? inv_suma / lote_suma : na

    [inv_suma, pre_suma, lote_suma, precio_promedio]

// @function Calcula el rendimiento
// @returns rendimiento de 10 posiciones

export rend_func(float p1,float p2,float p3,float p4,float p5,float p6,float p7,float p8,float p9,float p10,float po)=>
    rend_1 = math.abs(((  p1 - po)   / p1 )  * 100)
    rend_2 = math.abs(((  p2 - po)   / p2 )  * 100)
    rend_3 = math.abs(((  p3 - po)   / p3 )  * 100)
    rend_4 = math.abs(((  p4 - po)   / p4 )  * 100)
    rend_5 = math.abs(((  p5 - po)   / p5 )  * 100)
    rend_6 = math.abs(((  p6 - po)   / p6 )  * 100)
    rend_7 = math.abs(((  p7 - po)   / p7 )  * 100)
    rend_8 = math.abs(((  p8 - po)   / p8 )  * 100)
    rend_9 = math.abs(((  p9 - po)   / p9 )  * 100)
    rend_10 = math.abs((( p10 - po)  / p10)  * 100)

    [rend_1,rend_2,rend_3,rend_4,rend_5,rend_6,rend_7,rend_8,rend_9,rend_10]



// @function Dibuja las lineas de las posiciones
// @returns Lineas de posiciones

export f_drawLine(bool cond,int x1,float  y1,int x2,float y2,color colorr,string txt,color txtcol,bool act,int offset, string txts,int ls) =>
    var line id = na

    // Linea pre de compra
    if cond and act
        if txt != "0" 
            id := line.new(na, na, na, na, xloc = xloc.bar_index, style =  line.style_solid)
            line.set_x1(id ,x1)
            line.set_y1(id ,y1)
            line.set_x2(id ,x2)
            line.set_y2(id ,y2)
            line.set_extend(id , extend.both)

            line.set_color(id, colorr)
            line.set_width(id, ls)

            structure_lbl = label.new(bar_index + offset, y1, txt == "0" ? "" : txt
              , color = colorr
              , textcolor = txtcol
              , style =  label.style_none
              , size = txts)
    else if cond

        if txt != "0" 
            id := line.new(na, na, na, na, xloc = xloc.bar_index, style =  line.style_dotted)
            line.set_x1(id ,x1)
            line.set_y1(id ,y1)
            line.set_x2(id ,x2)
            line.set_y2(id ,y2)
            line.set_extend(id , extend.both)

            line.set_color(id, colorr)
            line.set_width(id, ls)

            structure_lbl = label.new(bar_index + offset, y1, txt == "0" ? "" : txt
              , color = colorr
              , textcolor = txtcol
              , style =  label.style_none
              , size = txts)



    // Linea pre promedio
    else
        if txt != "0" 
            id := line.new(na, na, na, na, xloc = xloc.bar_index, style = line.style_dashed )
            line.set_x1(id ,x1)
            line.set_y1(id ,y1)
            line.set_x2(id ,x2)
            line.set_y2(id ,y2)
            line.set_extend(id , extend.both)

            line.set_color(id, colorr)
            line.set_width(id, ls)

            structure_lbl = label.new(bar_index + offset, y1, txt == "0" ? "" : txt
              , color = colorr
              , textcolor = txtcol
              , style = label.style_none
              , size = txts)

// @function Dibuja las lineas de las proyecciones
// @returns Lineas de proyecciones

export f_Vline(bool cond,int x1,float y1,int x2,float y2,color colorr,string txt, bool sel, string txts,color txtc,int size,color bxcol ) =>
    var line id = na
    var box bx  = na

    // Linea proyección
    if cond and sel
        if txt != "0"

            //Linea
            id := line.new(na, na, na, na, xloc = xloc.bar_index, style =  line.style_arrow_right)
            line.set_x1(id ,x1)
            line.set_y1(id ,y1)
            line.set_x2(id ,x2)
            line.set_y2(id ,y2)    
            line.set_color(id, colorr)
            line.set_width(id, size)


            //caja
            bx := box.new(x1 - size,y2,x2 + size,y1,xloc = xloc.bar_index, bgcolor = bxcol,border_color = color.rgb(255, 255, 255, 100),
                         text = txt,text_size = txts ,text_color = txtc,text_valign = text.align_center )


// @function Consigue el ATH
// @returns ATH y cierre
export get_all_time_high() =>
    h  = 0.0
    t  = 0
    c  = close
    h := bar_index == 0 ? high : high > h[1] ? high : h[1]
    t := bar_index == 0 ? time : high > h[1] ? time : t[1]
    
    [h,c]

// @function Linea simple de precio
// @returns linea horizontal

export f_sLine(bool cond,int x1,float y1,int x2,float y2,color colorr,float txt,int size,int off,color txtcol, string txts) =>
    var line id = na

    // Linea proyección
    if cond 
        
        //Linea
        id := line.new(na, na, na, na, xloc = xloc.bar_index, style =  line.style_solid)
        line.set_x1(id ,x1)
        line.set_y1(id ,y1)
        line.set_x2(id ,x2)
        line.set_y2(id ,y2)    
        line.set_color(id, colorr)
        line.set_width(id, size)

        structure_lbl = label.new(bar_index + off, y1, txt == 0 ? str.tostring(0,"#.##") : str.tostring(txt,"#.##"), color = colorr, textcolor = txtcol, style = label.style_none, size = txts)