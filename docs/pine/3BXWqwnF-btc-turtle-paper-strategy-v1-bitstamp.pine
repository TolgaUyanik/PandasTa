//@version=5
strategy(
     "BTC Turtle Paper Strategy v1 - Bitstamp",
     overlay=true,
     initial_capital=10000,
     currency=currency.USD,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     slippage=5,
     pyramiding=0,
     process_orders_on_close=false,
     max_labels_count=500,
     max_boxes_count=500,
     max_lines_count=500)
// Use this on TradingView symbol BITSTAMP:BTCUSD, 1D timeframe.
// This is a visual/paper strategy only. It does not send broker/exchange orders.
variant = input.string(
     "A_baseline_channel10",
     "Variant",
     options=[
         "A_baseline_channel10",
         "A_partial33_tp2p0_be_rest_channel10",
         "A_partial50_tp2p0_be_rest_channel10",
         "A_partial50_tp1p5_be_rest_channel10"
     ])
breakoutDays = input.int(20, "Breakout days", minval=2)
exitDays = input.int(10, "Channel exit days", minval=2)
atrLen = input.int(20, "ATR length", minval=2)
atrMult = input.float(1.5, "ATR stop multiplier", minval=0.1, step=0.1)
maLen = input.int(50, "SMA filter", minval=2)
riskPct = input.float(0.5, "Visual risk per trade, %", minval=0.01, step=0.01)
showTradeBoxes = input.bool(true, "Show long-position style boxes")
showLabels = input.bool(true, "Show entry/exit labels")
isPartial33 = variant == "A_partial33_tp2p0_be_rest_channel10"
isPartial50Tp2 = variant == "A_partial50_tp2p0_be_rest_channel10"
isPartial50Tp15 = variant == "A_partial50_tp1p5_be_rest_channel10"
usePartial = isPartial33 or isPartial50Tp2 or isPartial50Tp15
partialPct = isPartial33 ? 33.0 : usePartial ? 50.0 : 0.0
partialR = isPartial50Tp15 ? 1.5 : usePartial ? 2.0 : na
atr20 = ta.atr(atrLen)
smaFilter = ta.sma(close, maLen)
breakoutLevel = ta.highest(high[1], breakoutDays)
channelExitLevel = ta.lowest(low[1], exitDays)
filterOk = close > smaFilter
entrySignal = strategy.position_size == 0 and filterOk and close > breakoutLevel
channelExitSignal = strategy.position_size > 0 and close < channelExitLevel
var float pendingAtr = na
var float entryPrice = na
var float initialStop = na
var float activeStop = na
var float riskPerBtc = na
var float partialTarget = na
var bool partialTaken = false
var int entryBar = na
var box rewardBox = na
var box riskBox = na
var line partialLine = na
var line stopLine = na
if entrySignal
    pendingAtr := atr20
    strategy.entry("LONG", strategy.long, comment="Entry")
positionOpened = strategy.position_size > 0 and strategy.position_size[1] == 0
positionClosed = strategy.position_size == 0 and strategy.position_size[1] > 0
positionReduced = strategy.position_size > 0 and strategy.position_size < strategy.position_size[1]
if positionOpened
    entryPrice := strategy.position_avg_price
    initialStop := entryPrice - atrMult * pendingAtr
    activeStop := initialStop
    riskPerBtc := entryPrice - initialStop
    partialTarget := usePartial ? entryPrice + partialR * riskPerBtc : na
    partialTaken := false
    entryBar := bar_index
    if showLabels
        label.new(
             bar_index,
             low,
             "LONG\nentry " + str.tostring(entryPrice, format.mintick) + "\nstop " + str.tostring(initialStop, format.mintick),
             style=label.style_label_up,
             textcolor=color.white,
             color=color.new(color.green, 0))
    if showTradeBoxes
        riskBox := box.new(
             left=bar_index,
             top=entryPrice,
             right=bar_index,
             bottom=initialStop,
             bgcolor=color.new(color.red, 83),
             border_color=color.new(color.red, 25))
        rewardBox := box.new(
             left=bar_index,
             top=entryPrice,
             right=bar_index,
             bottom=entryPrice,
             bgcolor=color.new(color.green, 86),
             border_color=color.new(color.green, 25))
        stopLine := line.new(bar_index, initialStop, bar_index, initialStop, color=color.new(color.red, 0), width=1, style=line.style_dashed)
        if usePartial
            partialLine := line.new(bar_index, partialTarget, bar_index, partialTarget, color=color.new(color.teal, 0), width=1, style=line.style_dotted)
if positionReduced and usePartial and not partialTaken
    partialTaken := true
    activeStop := math.max(activeStop, entryPrice)
    if showLabels
        label.new(
             bar_index,
             high,
             "partial " + str.tostring(partialPct, "#") + "%\nstop BE",
             style=label.style_label_down,
             textcolor=color.white,
             color=color.new(color.teal, 0))
if strategy.position_size > 0
    if usePartial and not partialTaken
        strategy.exit("Partial TP", from_entry="LONG", limit=partialTarget, qty_percent=partialPct, comment="Partial TP")
    strategy.exit("Stop", from_entry="LONG", stop=activeStop, comment=partialTaken ? "BE Stop" : "Stop")
if channelExitSignal
    strategy.close("LONG", comment="Channel Exit")
if strategy.position_size > 0 and showTradeBoxes
    box.set_right(riskBox, bar_index)
    box.set_right(rewardBox, bar_index)
    box.set_top(rewardBox, math.max(high, entryPrice))
    box.set_bottom(rewardBox, entryPrice)
    line.set_x2(stopLine, bar_index)
    line.set_y1(stopLine, activeStop)
    line.set_y2(stopLine, activeStop)
    if usePartial
        line.set_x2(partialLine, bar_index)
if positionClosed
    tradeNo = strategy.closedtrades - 1
    exitPrice = strategy.closedtrades.exit_price(tradeNo)
    entryClosed = strategy.closedtrades.entry_price(tradeNo)
    profitPct = strategy.closedtrades.profit_percent(tradeNo)
    resultR = riskPerBtc > 0 ? (exitPrice - entryClosed) / riskPerBtc : na
    if showLabels
        label.new(
             bar_index,
             high,
             "EXIT\n" + str.tostring(profitPct, "#.##") + "%\n~" + str.tostring(resultR, "#.##") + "R",
             style=label.style_label_down,
             textcolor=color.white,
             color=profitPct >= 0 ? color.new(color.green, 0) : color.new(color.red, 0))
    entryPrice := na
    initialStop := na
    activeStop := na
    riskPerBtc := na
    partialTarget := na
    partialTaken := false
    entryBar := na
    rewardBox := na
    riskBox := na
    partialLine := na
    stopLine := na
plot(breakoutLevel, "20D breakout level", color=color.new(color.green, 15), linewidth=1)
plot(channelExitLevel, "10D channel exit level", color=color.new(color.orange, 15), linewidth=1)
plot(smaFilter, "SMA 50", color=color.new(color.blue, 20), linewidth=1)
plot(strategy.position_size > 0 ? activeStop : na, "Active stop", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(strategy.position_size > 0 and usePartial and not partialTaken ? partialTarget : na, "Partial TP", color=color.new(color.teal, 0), linewidth=2, style=plot.style_linebr)
bgcolor(filterOk ? color.new(color.green, 95) : color.new(color.red, 96), title="SMA filter regime")
if barstate.islast
    tfWarning = timeframe.isdaily ? "" : "\nSwitch chart to 1D for intended v1 logic."
    status = strategy.position_size > 0 ? "LONG / HOLD" : entrySignal ? "ENTRY SIGNAL" : "NO ACTION"
    tableText = "BTC Turtle Paper v1\n" + variant + "\nStatus: " + status + tfWarning
    var table infoTable = table.new(position.top_right, 1, 1, border_width=1)
    table.cell(infoTable, 0, 0, tableText, text_color=color.white, bgcolor=color.new(color.black, 15))