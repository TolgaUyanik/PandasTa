//@version=6
// @description Target Trend BUY/SELL mode with entry, SL, and 3 target levels.
// Adapted from Target Trend by BigBeluga: https://www.tradingview.com/script/QoUmKd1H-Target-Trend-BigBeluga/
// Call via request.security() per timeframe.
library("lib_trend_mode", overlay=true)

// Calculate trend data: mode (BUY/SELL), entry, SL, targets, and hit flags.
// len: trend detection SMA length, tgt: target offset (0 default)
// Returns: [trend(1=BUY/0=SELL), sl, entry, t1, t2, t3, t1_hit, t2_hit, t3_hit]
export get_trend_data(simple int len, simple int tgt) =>
    var bool trend = true
    float trend_value = na

    // ATR for stop loss and target calculations
    float atr_value = ta.sma(ta.atr(200), 200) * 0.8

    // SMA bands for trend detection
    float sma_high = ta.sma(high, len) + atr_value
    float sma_low  = ta.sma(low, len) - atr_value

    // Trend detection via crossovers
    if ta.crossover(close, sma_high) and barstate.isconfirmed
        trend := true
    if ta.crossunder(close, sma_low) and barstate.isconfirmed
        trend := false

    trend_value := trend ? sma_low : sma_high

    // Signal detection
    bool signal_up   = trend and not trend[1]
    bool signal_down = not trend and trend[1]

    // Stored levels
    var float stored_entry = na
    var float stored_t1 = na
    var float stored_t2 = na
    var float stored_t3 = na
    var bool t1_hit = false
    var bool t2_hit = false
    var bool t3_hit = false

    if signal_up or signal_down
        stored_entry := close
        float atr_mult = atr_value * (trend ? 1.0 : -1.0)
        stored_t1 := close + atr_mult * (5 + tgt)
        stored_t2 := close + atr_mult * (10 + tgt * 2)
        stored_t3 := close + atr_mult * (15 + tgt * 3)
        t1_hit := false
        t2_hit := false
        t3_hit := false

    // Check if targets have been hit
    if trend
        if high >= stored_t1
            t1_hit := true
        if high >= stored_t2
            t2_hit := true
        if high >= stored_t3
            t3_hit := true
    else
        if low <= stored_t1
            t1_hit := true
        if low <= stored_t2
            t2_hit := true
        if low <= stored_t3
            t3_hit := true

    [trend ? 1.0 : 0.0, trend_value, stored_entry, stored_t1, stored_t2, stored_t3, t1_hit ? 1.0 : 0.0, t2_hit ? 1.0 : 0.0, t3_hit ? 1.0 : 0.0]
