//@version=6
strategy("Optimized Doji Breakout Strategy (Short Only) V6", overlay=true, initial_capital=100000)

// --- 1. Dynamic R:R Optimizer (ATR) ---
atr_length = input.int(14, title="ATR Length for Optimization")
atr_value = ta.atr(atr_length)
atr_ma = ta.sma(atr_value, 20)

// If current market volatility is higher than average, use a bigger reward (1:3). Otherwise, use a safer target (1:1.5).
optimized_rr = atr_value > atr_ma ? 3.0 : 1.5

// --- 2. Doji Candle Logic ---
candle_body = math.abs(close - open)
candle_range = high - low
isDoji = candle_range > 0 and (candle_body / candle_range) <= 0.10

// Plot "D" on the chart after confirmation
plotshape(isDoji and barstate.isconfirmed, title="Doji Label", style=shape.labeldown, location=location.abovebar, color=color.orange, text="D", textcolor=color.white)

// --- 3. Strategy Variables ---
var float d_high = 0.0
var float entry_price = 0.0
var float sl_price = 0.0
var float tp_price = 0.0
var bool trigger_sell_next_candle = false

// Look for a closed Doji candle
if isDoji and barstate.isconfirmed
    trigger_sell_next_candle := true
    d_high := high // Lock the Stop Loss level to the HIGH of this verified D candle

// --- 4. Entry Logic ---
// Check if the candle immediately AFTER the Doji is red (bearish)
bool is_red_followup = close < open 

// Corrected syntax: Using the standard variable strategy.position_size without parentheses
if trigger_sell_next_candle and strategy.position_size == 0 and is_red_followup
    entry_price := open 
    sl_price := d_high // Stop loss at the D candle's high
    float risk = sl_price - entry_price // Risk for a short trade is Stop Loss minus Entry Price
    
    // Dynamic Take Profit based on market volatility optimizer (Subtracting because targets are lower for short trades)
    tp_price := entry_price - (risk * optimized_rr) 
    
    // Execute Sell Order (Short Entry)
    strategy.entry("Doji Sell", strategy.short)
    strategy.exit("Exit TP/SL", from_entry="Doji Sell", limit=tp_price, stop=sl_price)

// Cancel trigger if the immediate next candle fails to be red
if trigger_sell_next_candle and not is_red_followup
    trigger_sell_next_candle := false

if strategy.position_size == 0
    trigger_sell_next_candle := false

// --- 5. Emergency Green Candle Exit ---
// If we are in a sell trade and a candle closes green, exit the trade immediately
bool is_green_candle = close >= open

if strategy.position_size < 0 and is_green_candle and barstate.isconfirmed
    strategy.close("Doji Sell", comment="Exit: Green Candle Close")

// Reset tracking when flat
if strategy.position_size == 0
    d_high := 0.0
