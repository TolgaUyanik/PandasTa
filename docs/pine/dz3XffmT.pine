//@version=6
indicator("Session Range Box (x3) + ZMB", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════
// SESSIONE 1 — MATTINA
// ══════════════════════════════════════════════════════════════════════
s1StartHour = input.int(9,  "Ora inizio", minval=0, maxval=23, group="Sessione 1 (mattina)")
s1StartMin  = input.int(0,  "Minuto inizio", minval=0, maxval=59, group="Sessione 1 (mattina)")
s1EndHour   = input.int(10, "Ora fine", minval=0, maxval=23, group="Sessione 1 (mattina)")
s1EndMin    = input.int(0,  "Minuto fine", minval=0, maxval=59, group="Sessione 1 (mattina)")
s1TZ        = input.string("Europe/Rome", "Fuso orario", group="Sessione 1 (mattina)")
s1Extend    = input.int(50, "Estensione linee (barre)", minval=0, group="Sessione 1 (mattina)")

s1BoxColor      = input.color(color.new(color.gray, 70), "Colore box (riempimento)", group="Sessione 1 (mattina)")
s1BoxBorderCol  = input.color(color.new(color.gray, 100), "Colore bordo box", group="Sessione 1 (mattina)")
s1HighLineColor = input.color(color.red, "Colore linea massimo", group="Sessione 1 (mattina)")
s1LowLineColor  = input.color(color.red, "Colore linea minimo", group="Sessione 1 (mattina)")
s1LineStyleSel  = input.string("Tratteggiata", "Stile linee", options=["Continua", "Tratteggiata", "Punteggiata"], group="Sessione 1 (mattina)")
s1LineWidth     = input.int(1, "Spessore linee", minval=1, maxval=4, group="Sessione 1 (mattina)")

// ══════════════════════════════════════════════════════════════════════
// SESSIONE 2 — POMERIGGIO
// ══════════════════════════════════════════════════════════════════════
s2StartHour = input.int(15, "Ora inizio", minval=0, maxval=23, group="Sessione 2 (pomeriggio)")
s2StartMin  = input.int(30, "Minuto inizio", minval=0, maxval=59, group="Sessione 2 (pomeriggio)")
s2EndHour   = input.int(16, "Ora fine", minval=0, maxval=23, group="Sessione 2 (pomeriggio)")
s2EndMin    = input.int(30, "Minuto fine", minval=0, maxval=59, group="Sessione 2 (pomeriggio)")
s2TZ        = input.string("Europe/Rome", "Fuso orario", group="Sessione 2 (pomeriggio)")
s2Extend    = input.int(50, "Estensione linee (barre)", minval=0, group="Sessione 2 (pomeriggio)")

s2BoxColor      = input.color(color.new(color.gray, 70), "Colore box (riempimento)", group="Sessione 2 (pomeriggio)")
s2BoxBorderCol  = input.color(color.new(color.gray, 100), "Colore bordo box", group="Sessione 2 (pomeriggio)")
s2HighLineColor = input.color(color.red, "Colore linea massimo", group="Sessione 2 (pomeriggio)")
s2LowLineColor  = input.color(color.red, "Colore linea minimo", group="Sessione 2 (pomeriggio)")
s2LineStyleSel  = input.string("Tratteggiata", "Stile linee", options=["Continua", "Tratteggiata", "Punteggiata"], group="Sessione 2 (pomeriggio)")
s2LineWidth     = input.int(1, "Spessore linee", minval=1, maxval=4, group="Sessione 2 (pomeriggio)")

getLineStyle(sel) =>
    sel == "Tratteggiata" ? line.style_dashed : sel == "Punteggiata" ? line.style_dotted : line.style_solid

// ══════════════════════════════════════════════════════════════════════
// SESSIONE 3 — NOTTE (01:00-06:00, solo box, niente linee, niente break color)
// ══════════════════════════════════════════════════════════════════════
s3StartHour = input.int(1, "Ora inizio", minval=0, maxval=23, group="Sessione 3 (notte)")
s3StartMin  = input.int(0, "Minuto inizio", minval=0, maxval=59, group="Sessione 3 (notte)")
s3EndHour   = input.int(6, "Ora fine", minval=0, maxval=23, group="Sessione 3 (notte)")
s3EndMin    = input.int(0, "Minuto fine", minval=0, maxval=59, group="Sessione 3 (notte)")
s3TZ        = input.string("Europe/Rome", "Fuso orario", group="Sessione 3 (notte)")

s3BoxColor     = input.color(color.new(color.gray, 70), "Colore box (riempimento)", group="Sessione 3 (notte)")
s3BoxBorderCol = input.color(color.new(#1a1a1a, 20), "Colore bordo box", group="Sessione 3 (notte)")

// ══════════════════════════════════════════════════════════════════════
// LIVELLO ZMB — ORE 15:55
// ══════════════════════════════════════════════════════════════════════
zmbHour     = input.int(15, "Ora", minval=0, maxval=23, group="Linea ZMB")
zmbMin      = input.int(55, "Minuto", minval=0, maxval=59, group="Linea ZMB")
zmbTZ       = input.string("Europe/Rome", "Fuso orario", group="Linea ZMB")
zmbSource   = input.string("Close", "Prezzo di riferimento", options=["Close", "Open", "High", "Low"], group="Linea ZMB")
zmbExtend   = input.int(100, "Estensione linea (barre)", minval=0, group="Linea ZMB")
zmbLineCol  = input.color(color.red, "Colore linea", group="Linea ZMB")
zmbLineStyleSel = input.string("Continua", "Stile linea", options=["Continua", "Tratteggiata", "Punteggiata"], group="Linea ZMB")
zmbLineWidth    = input.int(1, "Spessore linea", minval=1, maxval=4, group="Linea ZMB")
zmbLabelCol = input.color(color.red, "Colore etichetta", group="Linea ZMB")
zmbTextCol  = input.color(color.white, "Colore testo etichetta", group="Linea ZMB")

// ══════════════════════════════════════════════════════════════════════
// COLORI ROTTURA RANGE (solo sessioni 1 e 2)
// ══════════════════════════════════════════════════════════════════════
breakDownColor = input.color(color.new(color.red, 60),  "Colore rottura ribassista (sell)", group="Rottura range")
breakUpColor   = input.color(color.new(color.blue, 60), "Colore rottura rialzista (buy)", group="Rottura range")

// ── STATO SESSIONE 1 ─────────────────────────────────────────────────────
s1InSession = time(timeframe.period, str.format("{0,number,#00}{1,number,#00}-{2,number,#00}{3,number,#00}", s1StartHour, s1StartMin, s1EndHour, s1EndMin), s1TZ) != 0
var bool s1WasInSession = false
var box   s1Box = na
var float s1High = na
var float s1Low  = na
var int   s1SB   = na
var bool  s1Broken = false

if s1InSession and not s1WasInSession
    s1High := high
    s1Low  := low
    s1SB := bar_index
    s1Broken := false
    s1Box := box.new(bar_index, high, bar_index, low, border_color=s1BoxBorderCol, bgcolor=s1BoxColor, extend=extend.none)

if s1InSession
    s1High := math.max(s1High, high)
    s1Low  := math.min(s1Low, low)
    if not na(s1Box)
        box.set_rightbottom(s1Box, bar_index, s1Low)
        box.set_lefttop(s1Box, s1SB, s1High)

if not s1InSession and s1WasInSession
    if not na(s1Box)
        box.set_right(s1Box, bar_index - 1)
    line.new(bar_index - 1, s1High, bar_index + s1Extend, s1High, color=s1HighLineColor, style=getLineStyle(s1LineStyleSel), width=s1LineWidth)
    line.new(bar_index - 1, s1Low,  bar_index + s1Extend, s1Low,  color=s1LowLineColor,  style=getLineStyle(s1LineStyleSel), width=s1LineWidth)

if not s1InSession and not na(s1Box) and not s1Broken
    if close < s1Low
        box.set_bgcolor(s1Box, breakDownColor)
        s1Broken := true
    else if close > s1High
        box.set_bgcolor(s1Box, breakUpColor)
        s1Broken := true

s1WasInSession := s1InSession

// ── STATO SESSIONE 2 ─────────────────────────────────────────────────────
s2InSession = time(timeframe.period, str.format("{0,number,#00}{1,number,#00}-{2,number,#00}{3,number,#00}", s2StartHour, s2StartMin, s2EndHour, s2EndMin), s2TZ) != 0
var bool s2WasInSession = false
var box   s2Box = na
var float s2High = na
var float s2Low  = na
var int   s2SB   = na
var bool  s2Broken = false

if s2InSession and not s2WasInSession
    s2High := high
    s2Low  := low
    s2SB := bar_index
    s2Broken := false
    s2Box := box.new(bar_index, high, bar_index, low, border_color=s2BoxBorderCol, bgcolor=s2BoxColor, extend=extend.none)

if s2InSession
    s2High := math.max(s2High, high)
    s2Low  := math.min(s2Low, low)
    if not na(s2Box)
        box.set_rightbottom(s2Box, bar_index, s2Low)
        box.set_lefttop(s2Box, s2SB, s2High)

if not s2InSession and s2WasInSession
    if not na(s2Box)
        box.set_right(s2Box, bar_index - 1)
    line.new(bar_index - 1, s2High, bar_index + s2Extend, s2High, color=s2HighLineColor, style=getLineStyle(s2LineStyleSel), width=s2LineWidth)
    line.new(bar_index - 1, s2Low,  bar_index + s2Extend, s2Low,  color=s2LowLineColor,  style=getLineStyle(s2LineStyleSel), width=s2LineWidth)

if not s2InSession and not na(s2Box) and not s2Broken
    if close < s2Low
        box.set_bgcolor(s2Box, breakDownColor)
        s2Broken := true
    else if close > s2High
        box.set_bgcolor(s2Box, breakUpColor)
        s2Broken := true

s2WasInSession := s2InSession

// ── STATO SESSIONE 3 (niente linee, niente break color) ─────────────────
s3InSession = time(timeframe.period, str.format("{0,number,#00}{1,number,#00}-{2,number,#00}{3,number,#00}", s3StartHour, s3StartMin, s3EndHour, s3EndMin), s3TZ) != 0
var bool s3WasInSession = false
var box   s3Box = na
var float s3High = na
var float s3Low  = na
var int   s3SB   = na

if s3InSession and not s3WasInSession
    s3High := high
    s3Low  := low
    s3SB := bar_index
    s3Box := box.new(bar_index, high, bar_index, low, border_color=s3BoxBorderCol, bgcolor=s3BoxColor, extend=extend.none)

if s3InSession
    s3High := math.max(s3High, high)
    s3Low  := math.min(s3Low, low)
    if not na(s3Box)
        box.set_rightbottom(s3Box, bar_index, s3Low)
        box.set_lefttop(s3Box, s3SB, s3High)

if not s3InSession and s3WasInSession
    if not na(s3Box)
        box.set_right(s3Box, bar_index - 1)

s3WasInSession := s3InSession

// ── LIVELLO ZMB ───────────────────────────────────────────────────────────
zmbBarTime = time("D", str.format("{0,number,#00}{1,number,#00}-{2,number,#00}{3,number,#00}", zmbHour, zmbMin, zmbHour, zmbMin + 1), zmbTZ)
zmbIsBar   = zmbBarTime != 0 and (na(zmbBarTime[1]) or zmbBarTime != zmbBarTime[1])

zmbPrice = zmbSource == "Close" ? close : zmbSource == "Open" ? open : zmbSource == "High" ? high : low

if zmbIsBar
    line.new(bar_index, zmbPrice, bar_index + zmbExtend, zmbPrice, color=zmbLineCol, style=getLineStyle(zmbLineStyleSel), width=zmbLineWidth)
    label.new(bar_index + zmbExtend, zmbPrice, "ZMB", style=label.style_label_left, color=zmbLabelCol, textcolor=zmbTextCol, size=size.small)
