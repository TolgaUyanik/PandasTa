//@version=6
// strategy_archetype: first_principles
// Overnight Gap Capture — process_orders_on_close=true, calc_on_order_fills=true
//
// Bar N:  flat → strategy.entry fires at close[N]
// Bar N close: entry fills, calc_on_order_fills re-evals but position_size[1]==0 so no close
// Bar N+1: position_size>0 AND position_size[1]==0 → strategy.close fires at close[N+1]

strategy("Overnight Gap Capture", overlay=true, process_orders_on_close=true, calc_on_order_fills=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.0, slippage=2)

inSession = not na(time("", "0930-1559", "America/New_York"))

if inSession and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0 and strategy.position_size[1] == 0
    strategy.close("Long")

plot(strategy.position_size > 0 ? close : na, "Position", style=plot.style_circles, linewidth=2, color=color.new(color.blue, 40))