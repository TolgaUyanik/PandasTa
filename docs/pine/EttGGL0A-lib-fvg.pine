// PUBLISH #2 of 4 (depends on lib_smt). Publish privately on TradingView, then set the
// import version numbers in the downstream files to the published version.
import Danieltrade29292/lib_smt/1 as st

// @description Fair Value Gap engine — detection, testing/inversion lifecycle, HTF nesting filters, entry-candidate selection, stop-loss derivation, and FVG drawing — extracted 1:1 from rewrite_strategy.pine.
library("lib_fvg", overlay = true)

export enum FVGFilterReason
    FullyNestedInHTF                = "fully nested in HTF"
    PartiallyNestedInUntestedHTF    = "partially nested in untested HTF"
    NearbyHTF                       = "nearby HTF"
    OverriddenByNewerLTF            = "overridden by newer LTF"  // soft-park for HTF when a newer LTF takes priority
    Expired                         = "expired"
    ReInversed                      = "re-inversed"
    InversionTooFar                 = "inversion too far"
    MaxTestsExceeded                = "max tests exeeded"
    UsingTradeClosed                = "used by trade (closed)"
    InversedWithoutSMT              = "inversed w/o SMT" // (§3.8) iFVG predates the current SMT — permanently unusable, wiped eagerly
    ReplacedByNewerFVG              = "replaced by newer FVG in same TF" // single-FVG-per-TF mode: newer FVG on same TF evicts the old one

export enum EntryFilterReason
    NoValidSMT                    = "no valid SMT"
    NoSession                     = "not in session"
    NoIntraSMTZone                = "in no-intra-SMT zone"
    SessionLocked                 = "session lock active"
    DayLocked                     = "day lock active"
    TP1BeforeFill                 = "TP1 hit before limit fill"   // pending limit cancelled — price reached TP1 before the order filled
    WrongSession                  = "trading disabled for session"
    InvalidOnInversionPosActive   = "invalidated on inversion, position already active" // gate: filled position present, no new entries
    PendingPosBetterEntry         = "replaced by FVG closer to price"                   // §3.2 true upgrade: pending limit replaced by nearer iFVG
    PendingPosReversal            = "cancelled — SMT direction reversed"
    InvalidOnInversionBetterEntry = "invalidated on inversion, used higher prio FVG"    // inversed[] cleanup after market pipeline
    InsufficientQty               = "entry candidate: SL distance excessive ➔ high risk ➔ qty < 3"
    BlockedByUntestedHTF          = "close inside untested HTF"                         // §3.9 close-inside-untested-HTF — transient, re-evaluated each bar
    OutsidePrevSessionRange       = "entry chases breakout of previous session range"  // London → Asia.h/l, NY → London.h/l, inclusive at boundary

///////////////////////////////////////////////////////////////////////////////////////////////////
//#region                        FVG declaration
///////////////////////////////////////////////////////////////////////////////////////////////////

export type Bar
    float o
    float h
    float l
    float c
    float top
    float btm
    int   t_open = time
    int   i_open = bar_index
    int   t_close = time
    int   i_close = bar_index
    box   bar_box = na
    label bar_label = na

// FVGFillState — what price has done to this gap (pure price-action, independent of strategy role)
export enum FVGFillState
    Untested   = "untested"                          // gap detected, never price-tested
    Tested     = "tested"                       // bar body overlapped gap (test_count > 0, not yet inversed)
    Inversed   = "inversed"                     // bar closed through the gap
    Retested   = "retested"                     // price touched the entry edge after inversion
    ReInversed = "re-inversed"                  // bar closed back through entry edge — terminal price-action invalidation

// FVGLifecycle — what role this FVG has in the strategy pipeline
export enum FVGLifecycle
    WaitForInverse  = "wait for inverse" // in items[] — eligible for inversion, not yet inversed
    InversedWaitingForRetest   = "wait for retest"  // in inversed[] — inversed but not yet selected as entry candidate
    UsedForSetup    = "entry pending"    // selected as entry candidate; limit placed and pending fill (TouchLimit)
    Upgraded        = "upgraded"         // was UsedForSetup but replaced by a closer iFVG (§3.2); order cancelled
    UsedForTrade    = "in-trade"         // position filled; FVG is being monitored until position closes
    Invalidated     = "invalidated"      // system-rejected: gate check failure, pre-SMT, session block, etc.

export enum FVGTestedByMode
    Body = "body" // requires FVG timeframe candle to open/close within the bar
    Wick = "wick" // FVG timeframe wick inside the FVG is enough to count a test (wait for HTF FVG close to count test)

// 1. FVG Data Structure
export type FVG
    bool        is_bullish_original       // original direction
    bool        is_bullish_post_inverse   // inversed direction
    string      tf
    int         tf_id
    chart.point top_left
    chart.point bottom_right
    float       hh                        // for check if FVG highest high equals session high => SL at ll
    float       ll                        // for check if FVG lowest low equals session low => SL at hh
    int         deprecate_at
    float       sl_level                    = na
    bool        is_active                   = true
    int         test_count                  = 0     // used for bars_to_inverse (test_count + 1)
    int         first_test_idx              = na
    bool        is_inversed                 = false
    bool        has_touched                 = false // For Rejection Entry Tracking
    box         fvg_box                     = na
    label       tooltip_label               = na    // hover anchor for detailed reason text

    // flags for more efficient drawing
    bool        hidden                      = false
    bool        draw_signal_inversed        = false
    bool        draw_signal_text            = false
    bool        draw_signal_highlight       = false
    bool        draw_signal_set_candidate   = false
    bool        draw_signal_reset_candidate = false

    FVGFillState      fill_state            = FVGFillState.Untested  // price-action state of the gap
    FVGLifecycle      lifecycle             = FVGLifecycle.WaitForInverse  // strategy pipeline role
    FVGFilterReason   filter_reason         = na  // reason for invalidation or filter skip
    EntryFilterReason entry_filter_reason   = na
    Bar               tf_inversion_bar      = na
    int               inversion_idx         = na

export method equals(FVG this, FVG other) =>
    if na(this) != na(other) // only one is na
        false
    else if na(this) // other must also be na
        true
    else // else they equal on same timeframe and when detected on same bar_index
        this.top_left.time == other.top_left.time and this.tf_id == other.tf_id

export method remove(FVG[] this, FVG item) =>
    int i = this.size() -1
    while i >= 0
        FVG fvg = this.get(i)
        if fvg.equals(item)
            this.remove(i)
            break
        i -= 1

// §3.9 — Unified spatial relationship check: this (LTF) vs one HTF FVG.
// Resolves formation time internally and returns the exact FVGFilterReason to stamp, or na if no relation.
//
// LTF newer (this confirmed after htf_fvg) → htf_fvg gets OverriddenByNewerLTF
// HTF newer (htf_fvg confirmed after this) → this gets one of:
//   FullyNestedInHTF             — both LTF edges inside HTF gap (when check_nested=true)
//   PartiallyNestedInUntestedHTF — only LTF entry edge inside HTF gap, HTF untested (when check_untested=true)
//   NearbyHTF                    — entry edge strictly outside HTF gap but within nearby_threshold (pass 0 to suppress)
//
// Caller: assign the returned reason to this when reason != OverriddenByNewerLTF, else assign to htf_fvg.
// entry edge: top_left for bullish-post-inverse, bottom_right for bearish-post-inverse.
export method check_nested_in(FVG this, FVG htf_fvg, bool check_nested, bool check_untested, bool check_nearby, float nearby_threshold, bool check_newer_ltf) =>

    bool  ltf_is_newer      = check_newer_ltf and this.bottom_right.time > htf_fvg.bottom_right.time

    bool entry_edge_nearby = false
    bool entry_edge_inside = false
    bool opposite_edge_inside = false

    if this.is_bullish_post_inverse
        float entry_edge        = this.top_left.price
        float opposite_edge     = this.bottom_right.price
        float htf_entry_edge    = htf_fvg.top_left.price
        float htf_opposite_edge = htf_fvg.bottom_right.price

        entry_edge_inside      := htf_opposite_edge <= entry_edge and entry_edge <= htf_entry_edge
        // nearby: entry edge strictly below htf bottom (outside gap), within threshold
        entry_edge_nearby      := check_nearby and not entry_edge_inside
                                   and entry_edge >= htf_opposite_edge - nearby_threshold
                                   and entry_edge <  htf_opposite_edge
        opposite_edge_inside   := htf_opposite_edge <= opposite_edge and opposite_edge <= htf_entry_edge
    else
        float entry_edge        = this.bottom_right.price
        float opposite_edge     = this.top_left.price
        float htf_entry_edge    = htf_fvg.bottom_right.price
        float htf_opposite_edge = htf_fvg.top_left.price

        entry_edge_inside      := htf_opposite_edge >= entry_edge and entry_edge >= htf_entry_edge
        // nearby: entry edge strictly above htf top (outside gap), within threshold
        entry_edge_nearby      := check_nearby and not entry_edge_inside
                                   and entry_edge <= htf_opposite_edge + nearby_threshold
                                   and entry_edge >  htf_opposite_edge
        opposite_edge_inside   := htf_opposite_edge >= opposite_edge and opposite_edge >= htf_entry_edge

    bool fully_nested = check_nested   and entry_edge_inside and opposite_edge_inside
    bool partial      = check_untested and entry_edge_inside and not opposite_edge_inside and check_untested and htf_fvg.test_count == 0
    bool nearby       = check_nearby   and not entry_edge_inside and not opposite_edge_inside and entry_edge_nearby and nearby_threshold > 0

    if ltf_is_newer
        FVGFilterReason.OverriddenByNewerLTF
    else if fully_nested
        FVGFilterReason.FullyNestedInHTF
    else if partial
        FVGFilterReason.PartiallyNestedInUntestedHTF
    else if nearby
        FVGFilterReason.NearbyHTF
    else
        na // not nested, not overridden



export method distance_to_price_post_inverse(FVG this, float price) =>
    if this.is_bullish_post_inverse
        price - this.top_left.price
    else
        this.bottom_right.price - price

export method is_higher_tf_or_closer_to_price_than(FVG this, FVG other) =>
    if na(this)
        false
    else if na(other)
        true
    else
        this.tf_id > other.tf_id // same timeframe -> seek closest to price
         or this.tf_id == other.tf_id and this.distance_to_price_post_inverse(close) < other.distance_to_price_post_inverse(close)

