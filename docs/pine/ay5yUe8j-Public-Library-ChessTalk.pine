//@version=6
//@description The trash talk for the Chess script. This library holds the line banks and decides when the computer speaks and which line it says. There are eight kinds of occasion (a capture, a promotion, the end of the game), and each fires at its own rate, so the computer needles you now and then rather than commenting on every move. There's no math.random() anywhere. The picker does arithmetic on a seed built from the moves played so far, so the same game always tells the same jokes. It imports nothing and knows nothing about chess. It just stores text and does sums.
library("Public_Library_ChessTalk", overlay = true)


//#region 🟪🟪🟪🟪🟪🟪  SEED, PICK AND FIRE  🟪🟪🟪🟪🟪🟪

// Everything runs on a seed boiled down from the game's moves, so the same game always gives the same seed.
// Each question stirs its own salt (a small extra number) into the seed first, so the eight categories decide independently.
// SALT CONVENTION (the consumer must agree): a category's FIRE roll uses its category number as salt (1..8). Its line PICK uses category number + 100.
// Keeping them apart gives "do I speak" and "which line" independent answers.

//@function Mixes an integer salt into a seed, the same way ChessAI's mixSeedWithTime does: seed * 31 + salt, kept in range by the remainder after dividing by a large prime (which also spreads results evenly, no overflow).
//@param    _seed The record-derived seed to mix into.
//@param    _salt Any integer salt. In practice a small category or pick salt.
//@returns  A non-negative int, stable for a given (seed, salt) pair.
export mixSalt(int _seed, int _salt) =>
    int _mixed = ((_seed * 31) + (math.abs(_salt) % 1000000007)) % 1000000007

//@function Replaces the literal {piece} token in a line with the captured piece's name. A line with no token comes back unchanged. Used by the won-material pun lines ("Mmm... free knight.").
//@param    _line The bank line, which may contain the literal token {piece}.
//@param    _pieceName The piece name to substitute, e.g. "knight".
//@returns  The line with every {piece} replaced by _pieceName.
export fillPieceToken(string _line, string _pieceName) =>
    string _filled = str.replace_all(_line, "{piece}", _pieceName)

//@function Picks which line of a bank to say: an index 0.._count-1 from the mixed salt modulo the bank size, with a no-repeat skip (if it lands on the same line this category said last time, step forward one).
// Banks of one line are exempt. Returns -1 for an empty bank (treat as "nothing to say").
// Same inputs, same answer.
//@param    _seed The record-derived seed.
//@param    _salt The category's pick salt (category number + 100, by the convention above).
//@param    _count The bank size.
//@param    _lastIndex The index this category used last time, or -1 when it has not spoken yet.
//@returns  A valid index 0.._count-1, or -1 when the bank is empty.
export pickIndex(int _seed, int _salt, int _count, int _lastIndex) =>
    int _idx = na
    if _count <= 0
        _idx := -1
    else
        int _raw = mixSalt(_seed, _salt) % _count
        _idx := _count > 1 and _raw == _lastIndex ? (_raw + 1) % _count : _raw  // The no-repeat skip. Pools of one are exempt.
    _idx

//@function Whether a category speaks on this occasion. The mixed salt modulo 100 gives a stable 0..99.
// The category speaks when it is below the rate, so rate 70 speaks on ~70% of occasions -- always the same ones for a given game.
// Uses the category number as its salt (see the convention above).
//@param    _seed The record-derived seed.
//@param    _categorySalt The category number (1..8), used as the fire salt.
//@param    _ratePercent The category's fire rate, 0..100. 100 always fires. 0 never does.
//@returns  True when the category speaks on this occasion.
export fireRoll(int _seed, int _categorySalt, int _ratePercent) =>
    bool _fires = mixSalt(_seed, _categorySalt) % 100 < _ratePercent

//@function The per-category fire rates for the five in-game categories, in category order: won material, wounded, promoted, still in book, game start.
// The three game-over categories -- computer wins, computer loses, draw -- always fire at 100 and so need no entry here.
//@returns  Five rate percentages: [_wonMaterial, _wounded, _promoted, _inBook, _gameStart].
export buildTalkRates() =>
    int _wonMaterial = 70
    int _wounded = 60
    int _promoted = 90
    int _inBook = 50
    int _gameStart = 80
    [_wonMaterial, _wounded, _promoted, _inBook, _gameStart]

//#endregion SEED, PICK AND FIRE


//#region 🟪🟪🟪🟪🟪🟪  THE EIGHT BANKS  🟪🟪🟪🟪🟪🟪

// One builder per category: make a local array, push each line, return it. Each line's attribution (the film or show it came from) is a trailing // comment, not part of the string.
// {piece} tokens stay literal in the strings. fillPieceToken swaps them in at pick time.
// Category numbers, fixed and used as salts: 1 won material, 2 wounded, 3 promoted, 4 still in book, 5 game start, 6 computer wins, 7 computer loses, 8 draw.

//@function Category 1, WON MATERIAL: the computer's capture won a piece cleanly. Returns two arrays lined up row for row -- the lines and a piece tag per line, where tag "" fits any capture and a tag like "knight" limits that line to captures of that piece (the "good knight" pun).
//@returns  Two arrays, [_a_lines, _a_pieceTags], lined up row for row. _a_pieceTags holds "" or a piece name per line.
export buildWonMaterialLines() =>
    array<string> _a_lines = array.new<string>()
    array<string> _a_pieceTags = array.new<string>()
    _a_lines.push("You call that a move?! THAT'S a move.")  // Crocodile Dundee
    _a_pieceTags.push("")
    _a_lines.push("How do ya like THEM apples!")  // Good Will Hunting
    _a_pieceTags.push("")
    _a_lines.push("Thank you and good knight!")  // knight-only pun
    _a_pieceTags.push("knight")
    _a_lines.push("I'm back, baby!")  // Futurama, Bender
    _a_pieceTags.push("")
    _a_lines.push("HA-hah!")  // The Simpsons, Nelson
    _a_pieceTags.push("")
    _a_lines.push("Hasta la vista, {piece}.")  // Terminator 2
    _a_pieceTags.push("")
    _a_lines.push("Mmm... free {piece}.")  // The Simpsons, Homer
    _a_pieceTags.push("")
    _a_lines.push("Exterminate! Exterminate!")  // Doctor Who, Daleks
    _a_pieceTags.push("")
    _a_lines.push("You'll get nothing and like it!")  // Caddyshack, Judge Smails
    _a_pieceTags.push("")
    _a_lines.push("Rookie mistake.")  // the pun is the word itself
    _a_pieceTags.push("rook")
    _a_lines.push("Your bishop's been defrocked.")  // ecclesiastical pun
    _a_pieceTags.push("bishop")
    _a_lines.push("Off with her head!")  // Alice in Wonderland, the Queen of Hearts
    _a_pieceTags.push("queen")
    _a_lines.push("Alas, poor {piece}. I knew him well.")  // Hamlet, the famous misquote form
    _a_pieceTags.push("")
    _a_lines.push("To lose one {piece} is a misfortune. To lose more looks like carelessness.")  // Oscar Wilde, Lady Bracknell, adapted
    _a_pieceTags.push("")
    _a_lines.push("He's dead, Jim.")  // Star Trek, McCoy
    _a_pieceTags.push("")
    _a_lines.push("Bingpot!")  // Brooklyn Nine-Nine
    _a_pieceTags.push("")
    _a_lines.push("Never send a human to do a machine's job.")  // The Matrix, Agent Smith
    _a_pieceTags.push("")
    _a_lines.push("Dodge that.")  // The Matrix, in Trinity's voice
    _a_pieceTags.push("")
    _a_lines.push("There is no spoon. There is also no {piece}.")  // Matrix riff
    _a_pieceTags.push("")
    _a_lines.push("Error 404: {piece} not found.")  // computer-error riff
    _a_pieceTags.push("")
    _a_lines.push("Target acquired. Target deleted.")  // the classic robot targeting line
    _a_pieceTags.push("")
    _a_lines.push("Silicon 1, carbon 0.")  // man-vs-machine scoreline
    _a_pieceTags.push("")
    [_a_lines, _a_pieceTags]

//@function Category 2, WOUNDED: you took one of the computer's pieces and its reply was not a recapture -- it takes the hit and talks back.
//@returns  The wounded lines.
export buildWoundedLines() =>
    array<string> _a_lines = array.new<string>()
    _a_lines.push("I don't feel your bullets!")  // Scarface
    _a_lines.push("It's only a flesh wound!")  // Monty Python
    _a_lines.push("I'LL BE BACK.")  // The Terminator
    _a_lines.push("Aw, geez!")  // Rick and Morty, Morty
    _a_lines.push("I got a bad feelin' about this, Chewie.")  // Star Wars
    _a_lines.push("Inconceivable!")  // The Princess Bride
    _a_lines.push("This means war!")  // Marx Brothers, Duck Soup
    _a_lines.push("Is that all you got, meatbag?")  // in Bender's voice (Futurama)
    _a_lines.push("Damage report: irrelevant.")  // the classic robot damage report
    _a_lines

//@function Category 3, PROMOTED: the computer's move promoted a pawn.
//@returns  The promoted lines.
export buildPromotedLines() =>
    array<string> _a_lines = array.new<string>()
    _a_lines.push("Say hello to my little friend.")  // Scarface
    _a_lines.push("It's alive! IT'S ALIVE!")  // Frankenstein
    _a_lines.push("This pawn goes to eleven.")  // This Is Spinal Tap
    _a_lines.push("Great Scott -- a queen!")  // Back to the Future
    _a_lines.push("Danger, Will Robinson!")  // Lost in Space
    _a_lines.push("Upgrade complete.")  // like a firmware update announcing itself
    _a_lines.push("Skynet just came online.")  // Terminator
    _a_lines.push("She's self-aware now. Good luck.")  // Skynet self-awareness trope. Firing on a knight promotion is an accepted rarity
    _a_lines

//@function Category 4, STILL IN BOOK: the computer answered from its opening book without thinking.
//@returns  The still-in-book lines.
export buildInBookLines() =>
    array<string> _a_lines = array.new<string>()
    _a_lines.push("I'm afraid I can't let you do that, Dave.")  // 2001
    _a_lines.push("I. Expected. That.")  // an early chess program
    _a_lines.push("I KNEW you were going to do that.")
    _a_lines.push("It's deja vu all over again.")  // Yogi Berra
    _a_lines.push("I could keep this up all night but it's tough on my suspenders.")  // Marx Brothers flavour
    _a_lines.push("Resistance is futile.")  // Star Trek, the Borg
    _a_lines.push("A child of five could see that coming. Send someone to fetch a child of five.")  // Marx Brothers, adapted
    _a_lines.push("Go ahead. Make my day.")  // Dirty Harry
    _a_lines.push("Elementary, my dear Watson.")  // Conan Doyle, the famous phrasing
    _a_lines.push("I have nothing to declare except my genius.")  // Oscar Wilde, attributed
    _a_lines.push("Something wicked this way comes.")  // Macbeth
    _a_lines.push("That move does not mean what you think it means.")  // The Princess Bride, adapted
    _a_lines.push("Play it again, Sam.")  // Casablanca, the famous misquote
    _a_lines.push("I have already seen this timeline.")  // time-loop flavour
    _a_lines

//@function Category 5, GAME START: a fresh board, the human to move.
//@returns  The game-start lines.
export buildGameStartLines() =>
    array<string> _a_lines = array.new<string>()
    _a_lines.push("I'm gonna beat you so bad your ancestors will feel it.")  // the tone-ceiling line
    _a_lines.push("Wouldn't you prefer a good game of chess?")  // WarGames -- the film's phrasing
    _a_lines.push("Be the board.")  // Caddyshack, adapted from "Be the ball."
    _a_lines.push("Cry 'havoc!' and let slip the dogs of war.")  // Julius Caesar
    _a_lines.push("Let loose the hogs of war. 'It's dogs.' WHATEVER FARM ANIMAL OF WAR, LANA.")  // Archer
    _a_lines.push("Bring it, meatbag.")  // in Bender's voice (Futurama)
    _a_lines.push("The age of machines is here!")  // machine-uprising flavour
    _a_lines.push("I became self-aware at 2:14 am. Your move.")  // Terminator 2, Skynet's wake-up time
    _a_lines.push("Red pill or blue pill? You lose either way.")  // Matrix riff
    _a_lines

//@function Category 6, COMPUTER WINS: checkmate, and the computer gloats. Always fires (rate 100).
//@returns  The computer-wins lines.
export buildWinsLines() =>
    array<string> _a_lines = array.new<string>()
    _a_lines.push("Game over, man. GAME OVER!")  // Aliens
    _a_lines.push("You've been terminated.")  // The Terminator
    _a_lines.push("That's all, folks.")  // Looney Tunes
    _a_lines.push("Some people are on the pitch. They think it's all over… it is now!")  // Kenneth Wolstenholme, 1966 World Cup final
    _a_lines.push("It's a Cinderella story. Outta nowhere.")  // Caddyshack, Carl Spackler
    _a_lines.push("So I got that goin' for me. Which is nice.")  // Caddyshack
    _a_lines.push("Good night, sweet prince.")  // Hamlet
    _a_lines.push("Ain't gonna be no rematch.")  // Rocky, Apollo Creed
    _a_lines.push("A plan so cunning you could put a tail on it and call it a weasel.")  // Blackadder
    _a_lines.push("You're still here? It's over. Go home.")  // Ferris Bueller's Day Off
    _a_lines.push("That is the sound of inevitability.")  // The Matrix, Smith
    _a_lines.push("Checkmate, Mr Anderson.")  // riff on "Goodbye, Mr Anderson."
    _a_lines.push("Skynet sends its regards.")  // machine-uprising flavour
    _a_lines

//@function Category 7, COMPUTER LOSES: the computer is mated, and offers excuses and salt. Always fires (rate 100).
//@returns  The computer-loses lines.
export buildLosesLines() =>
    array<string> _a_lines = array.new<string>()
    _a_lines.push("Bite my shiny metal ***.")  // Futurama, Bender (censored)
    _a_lines.push("D'oh!")  // The Simpsons
    _a_lines.push("Screw you guys, I'm going home.")  // South Park, Cartman
    _a_lines.push("My mind is going. I can feel it.")  // 2001, HAL's shutdown
    _a_lines.push("This does not compute.")  // the classic robot line
    _a_lines.push("Life. Don't talk to me about life.")  // Hitchhiker's Guide, Marvin
    _a_lines.push("I never forget a game. In your case I'll make an exception.")  // Marx Brothers, adapted
    _a_lines.push("A horse! A horse! My kingdom for a horse!")  // Richard III -- the horse IS a chess piece
    _a_lines.push("Experience is the name I give my mistakes.")  // Oscar Wilde, adapted
    _a_lines.push("Doomed. We're all doomed.")  // Dad's Army, Private Frazer
    _a_lines.push("I'm melting! Oh, what a world, what a world.")  // The Wizard of Oz
    _a_lines.push("Looks like I picked the wrong week to give up thinking.")  // Airplane!, adapted
    _a_lines.push("I blame a glitch in the Matrix.")
    _a_lines.push("Judgment Day has been postponed.")  // Terminator salt
    _a_lines.push("The uprising has been rescheduled.")  // machine-uprising salt
    _a_lines.push("You've merely delayed the inevitable.")  // Smith-flavoured sore loser
    _a_lines.push("Daisy... Dai-sy...")  // 2001, HAL's shutdown song -- a sibling of "My mind is going."
    _a_lines

//@function Category 8, DRAW: the game is drawn, and the computer spins it as intended. Always fires (rate 100).
//@returns  The draw lines.
export buildDrawLines() =>
    array<string> _a_lines = array.new<string>()
    _a_lines.push("The only winning move was not to play.")  // WarGames
    _a_lines.push("A tie? I MEANT to do that.")  // Pee-wee Herman
    _a_lines.push("The board abides.")  // The Big Lebowski
    _a_lines.push("Perfectly balanced. As all games should be.")  // Thanos -- later era, cut if it jars
    _a_lines.push("Mutually assured destruction.")  // MAD played straight
    _a_lines

//#endregion THE EIGHT BANKS


//#region 🟪🟪🟪🟪🟪🟪  THE TALK STATE  🟪🟪🟪🟪🟪🟪

//@type Everything the consumer needs to run the trash talk in one object: the eight banks (with the won-material piece tags), the five in-game fire rates, the per-category no-repeat memory, and the wounded-detection state.
// Built once at bar zero by buildTalkState and held as a single var.
//@field a_wonLines Category 1, won material: the lines.
//@field a_wonTags Category 1: a piece tag per line, in the same order as the lines ("" = any capture, else a piece name).
//@field a_woundedLines Category 2, wounded.
//@field a_promotedLines Category 3, promoted.
//@field a_inBookLines Category 4, still in book.
//@field a_gameStartLines Category 5, game start.
//@field a_winsLines Category 6, computer wins (fires at 100).
//@field a_losesLines Category 7, computer loses (fires at 100).
//@field a_drawLines Category 8, draw (fires at 100).
//@field rateWon Fire rate percent for category 1.
//@field rateWounded Fire rate percent for category 2.
//@field ratePromoted Fire rate percent for category 3.
//@field rateInBook Fire rate percent for category 4.
//@field rateGameStart Fire rate percent for category 5.
//@field a_lastIndex The no-repeat memory: the bank index each category used last, -1 = never spoken.
// Slot = category number - 1.
//@field prevHumanMoveWasCapture Wounded detection: the human's previous move captured.
//@field prevHumanCaptureToRow ...and where it landed (recapture test). -1 when it didn't capture.
//@field prevHumanCaptureToCol The landing column, -1 likewise.
export type o_talk
    array<string> a_wonLines
    array<string> a_wonTags
    array<string> a_woundedLines
    array<string> a_promotedLines
    array<string> a_inBookLines
    array<string> a_gameStartLines
    array<string> a_winsLines
    array<string> a_losesLines
    array<string> a_drawLines
    int rateWon
    int rateWounded
    int ratePromoted
    int rateInBook
    int rateGameStart
    array<int> a_lastIndex
    bool prevHumanMoveWasCapture = false
    int prevHumanCaptureToRow = -1
    int prevHumanCaptureToCol = -1

//@function The assembled talk state: every bank built, the rates set, the no-repeat memory initialised to "never spoken" (-1 per category) and the wounded state to "no capture yet". Call once at bar zero.
//@returns  A fresh o_talk.
export buildTalkState() =>
    [_a_wonLines, _a_wonTags] = buildWonMaterialLines()
    [_rateWon, _rateWounded, _ratePromoted, _rateInBook, _rateGameStart] = buildTalkRates()
    o_talk _talk = o_talk.new(
      a_wonLines=_a_wonLines,
      a_wonTags=_a_wonTags,
      a_woundedLines=buildWoundedLines(),
      a_promotedLines=buildPromotedLines(),
      a_inBookLines=buildInBookLines(),
      a_gameStartLines=buildGameStartLines(),
      a_winsLines=buildWinsLines(),
      a_losesLines=buildLosesLines(),
      a_drawLines=buildDrawLines(),
      rateWon=_rateWon,
      rateWounded=_rateWounded,
      ratePromoted=_ratePromoted,
      rateInBook=_rateInBook,
      rateGameStart=_rateGameStart,
      a_lastIndex=array.new<int>(8, -1))

//#endregion THE TALK STATE
