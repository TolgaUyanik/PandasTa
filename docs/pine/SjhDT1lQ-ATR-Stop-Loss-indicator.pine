//@version=6
indicator("ATR Stop Loss % indicator", shorttitle="ATR Stop Loss %", overlay=false)

// ── Inputs ──────────────────────────────────────────────
atrLength     = input.int(14, "ATR Length", minval=1, group="ATR Settings")
atrMultiplier = input.float(2.0, "ATR Multiplier (N)", minval=0.1, step=0.1, group="ATR Settings")

// ── Calculations ──────────────────────────────────────────
atrValue = ta.atr(atrLength)

// Stop loss distance as % of current price: (ATR x N) / Close x 100
stopLossPct = atrValue * atrMultiplier / close * 100

// ── Plot (line chart) ───────────────────────────────────────
plot(stopLossPct, title="Stop Loss (%)", color=color.new(color.orange, 0), linewidth=2, style=plot.style_line)

// Optional average line for reference
showAvg = input.bool(true, "Show Average Line", group="Display Options")
avgLength = input.int(50, "Average Length", minval=1, group="Display Options")
avgStopLossPct = ta.sma(stopLossPct, avgLength)
plot(showAvg ? avgStopLossPct : na, title="Average Stop Loss (%)", color=color.new(color.gray, 40), linewidth=1, style=plot.style_line)