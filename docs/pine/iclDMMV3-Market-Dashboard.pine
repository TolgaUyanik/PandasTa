//@version=6
indicator("Market Dashboard", shorttitle="MD", overlay=true)

// ================================
// USER INPUTS
// ================================

// Table Position Settings
table_position = input.string("Top Right", "Table Position", 
     options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], 
     group="Display Settings")

// Text Size Settings
text_size_option = input.string("Normal", "Text Size", 
     options=["Tiny", "Small", "Normal", "Large", "Huge"], 
     group="Display Settings")

// Volume Analysis Inputs
cvd_length = input.int(14, "CVD Period", minval=1, group="Indicators")
volume_threshold = input.float(1.5, "Volume Threshold Multiplier", minval=0.1, step=0.1, group="Indicators")

// ATR Inputs
atr_length = input.int(14, "ATR Period", minval=1, group="Indicators")

// RSI Inputs
rsi_length = input.int(14, "RSI Period", minval=1, group="Indicators")
rsi_overbought = input.int(70, "RSI Overbought", minval=50, maxval=100, group="Indicators")
rsi_oversold = input.int(30, "RSI Oversold", minval=0, maxval=50, group="Indicators")

// MACD Inputs
macd_fast = input.int(12, "MACD Fast", minval=1, group="Indicators")
macd_slow = input.int(26, "MACD Slow", minval=1, group="Indicators")
macd_signal = input.int(9, "MACD Signal", minval=1, group="Indicators")

// ================================
// CALCULATIONS
// ================================

// ATR Calculation
atr = ta.atr(atr_length)

// Volume Delta Calculation
volume_up = volume * (close > open ? 1 : 0)
volume_down = volume * (close < open ? 1 : 0)
delta_volume = volume_up - volume_down

// Cumulative Volume Delta (CVD)
var float cvd = 0.0
cvd := cvd + delta_volume

// RSI Calculation
rsi = ta.rsi(close, rsi_length)

// MACD Calculation
[macd_line, signal_line, macd_histogram] = ta.macd(close, macd_fast, macd_slow, macd_signal)

// Volume Analysis
high_volume = volume > ta.sma(volume, 20) * volume_threshold

// Market Session Detection
is_asian_session() =>
    hour >= 21 or hour < 6

is_london_session() =>
    hour >= 6 and hour < 14

is_ny_session() =>
    hour >= 14 and hour < 21

get_current_session() =>
    if is_ny_session()
        "NEW YORK"
    else if is_london_session()
        "LONDON"
    else if is_asian_session()
        "ASIAN"
    else
        "CLOSED"

get_session_color() =>
    if is_ny_session()
        color.blue
    else if is_london_session()
        color.green
    else if is_asian_session()
        color.orange
    else
        color.gray

// ================================
// TABLE POSITION CONVERSION
// ================================

get_table_position() =>
    switch table_position
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.top_right

get_text_size() =>
    switch text_size_option
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

// ================================
// MARKET DASHBOARD TABLE
// ================================

var table dashboard_table = table.new(get_table_position(), 3, 7, 
     bgcolor=color.new(color.white, 0), 
     border_width=2, 
     border_color=color.new(color.gray, 0),
     frame_width=1,
     frame_color=color.new(color.black, 0))

if barstate.islast
    // Header Row
    table.cell(dashboard_table, 0, 0, "Indicator", 
         text_color=color.white, 
         bgcolor=color.new(color.gray, 20), 
         text_size=get_text_size())
    table.cell(dashboard_table, 1, 0, "Value", 
         text_color=color.white, 
         bgcolor=color.new(color.gray, 20), 
         text_size=get_text_size())
    table.cell(dashboard_table, 2, 0, "Signal", 
         text_color=color.white, 
         bgcolor=color.new(color.gray, 20), 
         text_size=get_text_size())
    
    // Market Session Row
    table.cell(dashboard_table, 0, 1, "Session", 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    table.cell(dashboard_table, 1, 1, str.tostring(hour, "#") + ":00 UTC", 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    table.cell(dashboard_table, 2, 1, get_current_session(), 
         text_color=color.white, 
         bgcolor=color.new(get_session_color(), 0), 
         text_size=get_text_size())
    
    // RSI Row
    table.cell(dashboard_table, 0, 2, "RSI", 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    table.cell(dashboard_table, 1, 2, str.tostring(rsi, "#.##"), 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    
    rsi_signal = rsi > rsi_overbought ? "OVERBOUGHT" : rsi < rsi_oversold ? "OVERSOLD" : "NEUTRAL"
    rsi_color = rsi > rsi_overbought ? color.red : rsi < rsi_oversold ? color.green : color.gray
    table.cell(dashboard_table, 2, 2, rsi_signal, 
         text_color=color.white, 
         bgcolor=color.new(rsi_color, 0), 
         text_size=get_text_size())
    
    // MACD Row
    table.cell(dashboard_table, 0, 3, "MACD", 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    table.cell(dashboard_table, 1, 3, str.tostring(macd_line, "#.####"), 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    
    macd_signal_text = macd_line > signal_line ? "BULLISH" : "BEARISH"
    macd_color = macd_line > signal_line ? color.green : color.red
    table.cell(dashboard_table, 2, 3, macd_signal_text, 
         text_color=color.white, 
         bgcolor=color.new(macd_color, 0), 
         text_size=get_text_size())
    
    // CVD Row
    table.cell(dashboard_table, 0, 4, "CVD", 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    table.cell(dashboard_table, 1, 4, str.tostring(cvd, "#"), 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    
    cvd_signal_text = delta_volume > 0 ? "BUY PRESSURE" : "SELL PRESSURE"
    cvd_color = delta_volume > 0 ? color.green : color.red
    table.cell(dashboard_table, 2, 4, cvd_signal_text, 
         text_color=color.white, 
         bgcolor=color.new(cvd_color, 0), 
         text_size=get_text_size())
    
    // Volume Row
    table.cell(dashboard_table, 0, 5, "Volume", 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    table.cell(dashboard_table, 1, 5, str.tostring(volume, "#"), 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    
    volume_signal_text = high_volume ? "HIGH VOLUME" : "NORMAL"
    volume_color = high_volume ? color.orange : color.gray
    table.cell(dashboard_table, 2, 5, volume_signal_text, 
         text_color=color.white, 
         bgcolor=color.new(volume_color, 0), 
         text_size=get_text_size())
    
    // ATR Row
    table.cell(dashboard_table, 0, 6, "ATR", 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    table.cell(dashboard_table, 1, 6, str.tostring(atr, "#.####"), 
         text_color=color.black, 
         bgcolor=color.new(color.white, 0), 
         text_size=get_text_size())
    table.cell(dashboard_table, 2, 6, "VOLATILITY", 
         text_color=color.white, 
         bgcolor=color.new(color.blue, 0), 
         text_size=get_text_size())