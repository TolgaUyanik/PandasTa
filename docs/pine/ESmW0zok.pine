//@version=6
strategy("EMA + MACD Pullback Trend Strategy",
     overlay=true,
     initial_capital=100,
     pyramiding=0,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     calc_on_every_tick=true,
     process_orders_on_close=true)

//====================================================
// INPUTS GENERALES
//====================================================
direccion = input.string("Compra y Venta", "Dirección de entrada", options=["Solo Compra", "Solo Venta", "Compra y Venta"])

riesgoPct = input.float(1.0, "Riesgo por operación (% cuenta)", minval=0.1, step=0.1)

slTipo = input.string("% del precio", "Stop Loss", options=["% del precio", "ATR"])
slPct = input.float(1.0, "SL %", minval=0.1, step=0.1)
atrLen = input.int(14, "ATR período", minval=1)
atrMultSL = input.float(1.5, "ATR x SL", minval=0.1, step=0.1)

tpTipo = input.string("Ratio respecto al SL", "Take Profit", options=["% del precio", "Ratio respecto al SL"])
tpPct = input.float(2.0, "TP %", minval=0.1, step=0.1)
rr = input.float(2.0, "Ratio TP/SL", minval=0.1, step=0.1)

activarBreakeven = input.bool(true, "Activar Breakeven")
beTriggerR = input.float(1.0, "Breakeven al alcanzar X R", minval=0.1, step=0.1)

activarTrailing = input.bool(true, "Activar Trailing Stop")
trailTriggerR = input.float(1.5, "Trailing al alcanzar X R", minval=0.1, step=0.1)
trailDistTipo = input.string("% del precio", "Distancia trailing", options=["% del precio", "ATR"])
trailDistPct = input.float(0.5, "Trailing %", minval=0.1, step=0.1)
trailAtrMult = input.float(1.0, "ATR x trailing", minval=0.1, step=0.1)

//====================================================
// INPUTS DE INDICADORES
//====================================================
emaFastLen = input.int(20, "EMA rápida", minval=1)
emaSlowLen = input.int(50, "EMA lenta", minval=1)

usarADX = input.bool(true, "Usar filtro ADX")
adxLen = input.int(14, "ADX período", minval=1)
adxMin = input.float(18.0, "ADX mínimo", minval=1)

macdFast = input.int(12, "MACD fast", minval=1)
macdSlow = input.int(26, "MACD slow", minval=1)
macdSignalLen = input.int(9, "MACD signal", minval=1)

usarRSIFiltro = input.bool(false, "Usar filtro RSI")
rsiLen = input.int(14, "RSI período", minval=1)
rsiLongMin = input.float(50, "RSI mínimo long", minval=1, maxval=99)
rsiShortMax = input.float(50, "RSI máximo short", minval=1, maxval=99)

//====================================================
// CÁLCULOS BASE
//====================================================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atr = ta.atr(atrLen)
rsi = ta.rsi(close, rsiLen)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignalLen)

//====================================================
// CRUCES CALCULADOS GLOBALMENTE
//====================================================
crossPriceAboveFast = ta.crossover(close, emaFast)
crossPriceBelowFast = ta.crossunder(close, emaFast)
crossMacdBull = ta.crossover(macdLine, macdSignal)
crossMacdBear = ta.crossunder(macdLine, macdSignal)

//====================================================
// FILTROS DE RÉGIMEN
//====================================================
trendUp = emaFast > emaSlow
trendDown = emaFast < emaSlow

adxOk = not usarADX or adx > adxMin
rsiLongOk = not usarRSIFiltro or rsi > rsiLongMin
rsiShortOk = not usarRSIFiltro or rsi < rsiShortMax

permitirLong = direccion == "Solo Compra" or direccion == "Compra y Venta"
permitirShort = direccion == "Solo Venta" or direccion == "Compra y Venta"

//====================================================
// SETUPS DE ENTRADA
//====================================================
// Long: tendencia + MACD alcista + gatillo por cruce o pullback/reclaim
macdBullState = macdLine > macdSignal and macdHist >= 0
macdBearState = macdLine < macdSignal and macdHist <= 0

pullbackLong = low <= emaFast and close > emaFast and close > open
pullbackShort = high >= emaFast and close < emaFast and close < open

gatilloLong = crossPriceAboveFast or pullbackLong or crossMacdBull
gatilloShort = crossPriceBelowFast or pullbackShort or crossMacdBear

longCond = permitirLong and trendUp and macdBullState and adxOk and rsiLongOk and gatilloLong
shortCond = permitirShort and trendDown and macdBearState and adxOk and rsiShortOk and gatilloShort

//====================================================
// GESTIÓN DE RIESGO Y TAMAÑO DE POSICIÓN
//====================================================
riskCapital = strategy.equity * (riesgoPct / 100.0)

f_slDistance(entryPrice) =>
    slTipo == "% del precio" ? entryPrice * (slPct / 100.0) : atr * atrMultSL

f_tpDistance(entryPrice, slDistance) =>
    tpTipo == "% del precio" ? entryPrice * (tpPct / 100.0) : slDistance * rr

f_trailDistance(price) =>
    trailDistTipo == "% del precio" ? price * (trailDistPct / 100.0) : atr * trailAtrMult

f_qty(entryPrice, slDistance) =>
    slDistance > 0 ? riskCapital / slDistance : 0.0

//====================================================
// ENTRADAS
//====================================================
sinPosicion = strategy.position_size == 0

if longCond and sinPosicion
    entryPrice = close
    slDistance = f_slDistance(entryPrice)
    qty = f_qty(entryPrice, slDistance)
    if qty > 0
        strategy.entry("Long", strategy.long, qty=qty)

if shortCond and sinPosicion
    entryPrice = close
    slDistance = f_slDistance(entryPrice)
    qty = f_qty(entryPrice, slDistance)
    if qty > 0
        strategy.entry("Short", strategy.short, qty=qty)

//====================================================
// GESTIÓN DINÁMICA DE SALIDAS
//====================================================
var float longInitialSL = na
var float shortInitialSL = na

enLong = strategy.position_size > 0
enShort = strategy.position_size < 0

if enLong and na(longInitialSL)
    longInitialSL := strategy.position_avg_price - f_slDistance(strategy.position_avg_price)

if enShort and na(shortInitialSL)
    shortInitialSL := strategy.position_avg_price + f_slDistance(strategy.position_avg_price)

if not enLong
    longInitialSL := na

if not enShort
    shortInitialSL := na

//----------- LONG EXIT -----------
if enLong
    entry = strategy.position_avg_price
    slDist = entry - longInitialSL
    tpDist = f_tpDistance(entry, slDist)

    baseSL = longInitialSL
    tpPrice = entry + tpDist

    profitNow = close - entry
    currentR = slDist > 0 ? profitNow / slDist : 0.0

    beSL = activarBreakeven and currentR >= beTriggerR ? entry : baseSL

    trailDist = f_trailDistance(close)
    trailSL = activarTrailing and currentR >= trailTriggerR ? close - trailDist : na

    finalSL = beSL
    if activarTrailing and currentR >= trailTriggerR
        finalSL := math.max(beSL, trailSL)

    strategy.exit("Long Exit", from_entry="Long", stop=finalSL, limit=tpPrice)

//----------- SHORT EXIT -----------
if enShort
    entry = strategy.position_avg_price
    slDist = shortInitialSL - entry
    tpDist = f_tpDistance(entry, slDist)

    baseSL = shortInitialSL
    tpPrice = entry - tpDist

    profitNow = entry - close
    currentR = slDist > 0 ? profitNow / slDist : 0.0

    beSL = activarBreakeven and currentR >= beTriggerR ? entry : baseSL

    trailDist = f_trailDistance(close)
    trailSL = activarTrailing and currentR >= trailTriggerR ? close + trailDist : na

    finalSL = beSL
    if activarTrailing and currentR >= trailTriggerR
        finalSL := math.min(beSL, trailSL)

    strategy.exit("Short Exit", from_entry="Short", stop=finalSL, limit=tpPrice)

//====================================================
// PLOTS
//====================================================
plot(emaFast, "EMA Rápida", color=color.orange)
plot(emaSlow, "EMA Lenta", color=color.blue)

plotshape(longCond and sinPosicion, title="Señal Long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, text="L")
plotshape(shortCond and sinPosicion, title="Señal Short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="S")
