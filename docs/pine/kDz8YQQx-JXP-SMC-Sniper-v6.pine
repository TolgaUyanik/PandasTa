//@version=6
indicator("JXP SMC Sniper v6", overlay=true, max_lines_count=500, max_labels_count=500)

// =========================
// INPUTS
// =========================

swingLength     = input.int(6, "Swing Length", minval=2)
fastLen         = input.int(8, "Fast EMA", minval=1)
slowLen         = input.int(21, "Slow EMA", minval=1)
rsiLen          = input.int(14, "RSI Length", minval=1)
pullbackBars    = input.int(6, "Pullback Lookback", minval=1)
cooldownBars    = input.int(10, "Cooldown Bars", minval=1)
maxSignalsDay   = input.int(15, "Max Signals Per Day", minval=1, maxval=100)

// Session expansion
sessionMode = input.string(
     "All Sessions",
     "Session Mode",
     options=["All Sessions", "New York", "London", "Asia", "Custom"])

nySession     = input.session("0930-1600", "New York Session")
londonSession = input.session("0300-1100", "London Session")
asiaSession   = input.session("2000-0300", "Asia Session")
customSession = input.session("0930-1600", "Custom Session")

// Display
showDashboard  = input.bool(true, "Show Dashboard")
showStructure  = input.bool(true, "Show BOS / CHoCH")
showSignalBars = input.bool(true, "Highlight Signal Bars")
showSessionBg  = input.bool(false, "Show Session Background")

// Stats
trackStats     = input.bool(true, "Track Signal Stats")
atrLen         = input.int(14, "Stats ATR Length", minval=1)
tpAtrMult      = input.float(1.5, "Stats Target ATR", step=0.1)
slAtrMult      = input.float(1.0, "Stats Stop ATR", step=0.1)
statMaxBars    = input.int(20, "Bars To Judge Signal", minval=1)

// Volume
volLen         = input.int(20, "Volume Average Length", minval=1)
volStrongMult  = input.float(1.2, "Strong Volume Multiplier", step=0.1)

// =========================
// COLORS - CLEAN FAMOUS STYLE
// =========================

fastColor = color.rgb(0, 210, 255)
slowColor = color.rgb(255, 190, 0)
vwapColor = color.rgb(255, 225, 0)

bullColor = color.rgb(0, 230, 150)
bearColor = color.rgb(160, 0, 25)

dashGreen = color.rgb(0, 255, 150)
dashRed   = color.rgb(255, 45, 85)
dashBg    = color.new(color.black, 8)
leftBg    = color.new(color.rgb(90, 90, 100), 55)

// =========================
// CORE
// =========================

emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
vwapVal = ta.vwap(close)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)

plot(emaFast, color=fastColor, linewidth=2, title="Fast EMA")
plot(emaSlow, color=slowColor, linewidth=2, title="Slow EMA")
plot(vwapVal, color=vwapColor, linewidth=3, title="VWAP")

// =========================
// SESSION LOGIC
// =========================

activeSession =
     sessionMode == "New York" ? nySession :
     sessionMode == "London"   ? londonSession :
     sessionMode == "Asia"     ? asiaSession :
     sessionMode == "Custom"   ? customSession :
     "0000-2359"

inSession = sessionMode == "All Sessions" ? true : not na(time(timeframe.period, activeSession))

bgcolor(showSessionBg and inSession ? color.new(color.teal, 92) : na)

// =========================
// STRUCTURE
// =========================

ph = ta.pivothigh(high, swingLength, swingLength)
pl = ta.pivotlow(low, swingLength, swingLength)

var float lastHigh = na
var float lastLow  = na

var int lastHighBar = na
var int lastLowBar  = na

var int bias = 0
var int armed = 0
var int armedBar = na

if not na(ph)
    lastHigh := ph
    lastHighBar := bar_index - swingLength

if not na(pl)
    lastLow := pl
    lastLowBar := bar_index - swingLength

// =========================
// STRUCTURE BREAK LOGIC
// =========================

crossOverHigh = ta.crossover(close, lastHigh)
crossUnderLow = ta.crossunder(close, lastLow)

bullBreak = not na(lastHigh) and crossOverHigh
bearBreak = not na(lastLow) and crossUnderLow

bullCHOCH = bullBreak and bias == -1
bearCHOCH = bearBreak and bias == 1

bullBOS = bullBreak and bias != -1
bearBOS = bearBreak and bias != 1

// =========================
// DRAW STRUCTURE
// =========================

if bullBreak
    bias := 1
    armed := 1
    armedBar := bar_index

    if showStructure and not na(lastHighBar)
        line.new(
             lastHighBar,
             lastHigh,
             bar_index,
             lastHigh,
             color=color.new(bullColor, 0),
             style=line.style_dotted,
             width=2)

        label.new(
             math.floor((lastHighBar + bar_index) / 2),
             lastHigh,
             bullCHOCH ? "CHoCH" : "BOS",
             style=label.style_none,
             textcolor=bullColor,
             size=size.tiny)

if bearBreak
    bias := -1
    armed := -1
    armedBar := bar_index

    if showStructure and not na(lastLowBar)
        line.new(
             lastLowBar,
             lastLow,
             bar_index,
             lastLow,
             color=color.new(bearColor, 0),
             style=line.style_dotted,
             width=2)

        label.new(
             math.floor((lastLowBar + bar_index) / 2),
             lastLow,
             bearCHOCH ? "CHoCH" : "BOS",
             style=label.style_none,
             textcolor=bearColor,
             size=size.tiny)

// =========================
// FILTERS
// =========================

bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow

bullVWAP = close > vwapVal
bearVWAP = close < vwapVal

bullRSI = rsiVal > 50
bearRSI = rsiVal < 50

volAvg = ta.sma(volume, volLen)
strongVolume = volume > volAvg * volStrongMult
weakVolume = volume < volAvg

// =========================
// PULLBACK ENTRY LOGIC
// =========================

recentBull = armed == 1 and not na(armedBar) and bar_index - armedBar <= pullbackBars + cooldownBars
recentBear = armed == -1 and not na(armedBar) and bar_index - armedBar <= pullbackBars + cooldownBars

longPullback = ta.lowest(low, pullbackBars) <= emaFast
shortPullback = ta.highest(high, pullbackBars) >= emaFast

longReclaim = close > emaFast
shortReclaim = close < emaFast

rawBuy =
     recentBull and
     bullTrend and
     bullVWAP and
     bullRSI and
     longPullback and
     longReclaim and
     inSession

rawSell =
     recentBear and
     bearTrend and
     bearVWAP and
     bearRSI and
     shortPullback and
     shortReclaim and
     inSession

// =========================
// COOLDOWN / DAILY LIMIT
// =========================

var int lastSignalBar = na
var int signalCount = 0

newDay = ta.change(time("D"))

if newDay != 0
    signalCount := 0

coolingDown = not na(lastSignalBar) and bar_index - lastSignalBar <= cooldownBars

canSignal =
     not coolingDown and
     signalCount < maxSignalsDay

buySignal = rawBuy and canSignal
sellSignal = rawSell and canSignal

// =========================
// STATS ENGINE
// =========================

var int hitCount = 0
var int missCount = 0

var array<int> dirs = array.new_int()
var array<float> targets = array.new_float()
var array<float> stops = array.new_float()
var array<int> expiries = array.new_int()

if trackStats and array.size(dirs) > 0
    openCount = array.size(dirs)

    for x = 0 to openCount - 1
        i = openCount - 1 - x

        dir = array.get(dirs, i)
        target = array.get(targets, i)
        stop = array.get(stops, i)
        expiry = array.get(expiries, i)

        longHit = dir == 1 and high >= target
        longMiss = dir == 1 and low <= stop

        shortHit = dir == -1 and low <= target
        shortMiss = dir == -1 and high >= stop

        expired = bar_index > expiry

        resultHit = longHit or shortHit
        resultMiss = longMiss or shortMiss or expired

        if resultHit or resultMiss
            if resultHit and not resultMiss
                hitCount += 1
            else
                missCount += 1

            array.remove(dirs, i)
            array.remove(targets, i)
            array.remove(stops, i)
            array.remove(expiries, i)

if buySignal
    array.push(dirs, 1)
    array.push(targets, close + atrVal * tpAtrMult)
    array.push(stops, close - atrVal * slAtrMult)
    array.push(expiries, bar_index + statMaxBars)

if sellSignal
    array.push(dirs, -1)
    array.push(targets, close - atrVal * tpAtrMult)
    array.push(stops, close + atrVal * slAtrMult)
    array.push(expiries, bar_index + statMaxBars)

if buySignal or sellSignal
    lastSignalBar := bar_index
    signalCount += 1

totalClosed = hitCount + missCount
hitRate = totalClosed > 0 ? hitCount * 100.0 / totalClosed : na

// =========================
// SIGNALS
// =========================

plotshape(
     buySignal,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=bullColor,
     text="BUY",
     textcolor=color.black,
     size=size.small)

plotshape(
     sellSignal,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=bearColor,
     text="SELL",
     textcolor=color.white,
     size=size.small)

buyBarColor = color.new(color.rgb(0, 230, 150), 78)
sellBarColor = color.new(color.rgb(160, 0, 25), 78)

barcolor(
     showSignalBars and buySignal ? buyBarColor :
     showSignalBars and sellSignal ? sellBarColor :
     na)

// =========================
// DASHBOARD CALCULATIONS
// =========================

currentDir = armed != 0 ? armed : bullTrend ? 1 : -1

trendOK = currentDir == 1 ? bullTrend : bearTrend
vwapOK = currentDir == 1 ? bullVWAP : bearVWAP
rsiOK = currentDir == 1 ? bullRSI : bearRSI
structureOK = currentDir == 1 ? bias == 1 : bias == -1

qualityScore =
     (trendOK ? 25 : 0) +
     (structureOK ? 25 : 0) +
     (vwapOK ? 20 : 0) +
     (rsiOK ? 20 : 0) +
     (strongVolume ? 10 : 0)

strengthDots =
     qualityScore >= 80 ? "●●●" :
     qualityScore >= 60 ? "●●○" :
     qualityScore >= 40 ? "●○○" :
     "○○○"

trendTxt = bullTrend ? "BULLISH" : "BEARISH"
structureTxt = bias == 1 ? "BULLISH" : bias == -1 ? "BEARISH" : "NEUTRAL"
momentumTxt = "RSI " + str.tostring(rsiVal, "#.0")
vwapTxt = close > vwapVal ? "BULLISH" : "BEARISH"
volumeTxt = strongVolume ? "STRONG" : weakVolume ? "WEAK" : "NORMAL"

sessionTxt = inSession ? "ACTIVE" : "CLOSED"
armedTxt = armed == 1 ? "LONG" : armed == -1 ? "SHORT" : "NONE"

signalTxt =
     buySignal ? "BUY" :
     sellSignal ? "SELL" :
     coolingDown ? "COOLDOWN" :
     rawBuy ? "LONG READY" :
     rawSell ? "SHORT READY" :
     "WAIT"

hitRateTxt = na(hitRate) ? "N/A" : str.tostring(hitRate, "#.0") + "%"
hitsTxt = str.tostring(hitCount) + " / " + str.tostring(missCount)
signalLimitTxt = str.tostring(signalCount) + " / " + str.tostring(maxSignalsDay)

// =========================
// DASHBOARD
// =========================

var table dash = table.new(position.top_right, 2, 13, border_width=1)

f_row(row, left, right, rightBg, rightTextColor) =>
    table.cell(dash, 0, row, left, bgcolor=leftBg, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, row, right, bgcolor=rightBg, text_color=rightTextColor, text_size=size.small)

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "JXP SMC SNIPER", bgcolor=dashBg, text_color=dashGreen, text_size=size.small)
    table.cell(dash, 1, 0, timeframe.period, bgcolor=dashBg, text_color=color.white, text_size=size.small)

    f_row(1, "Trend", trendTxt, bullTrend ? color.new(color.green, 70) : color.new(color.red, 70), bullTrend ? dashGreen : dashRed)
    f_row(2, "Structure", structureTxt, bias == 1 ? color.new(color.green, 70) : bias == -1 ? color.new(color.red, 70) : color.new(color.gray, 70), bias == 1 ? dashGreen : bias == -1 ? dashRed : color.white)
    f_row(3, "Momentum", momentumTxt, rsiVal > 50 ? color.new(color.green, 75) : color.new(color.red, 75), rsiVal > 50 ? dashGreen : dashRed)
    f_row(4, "VWAP", vwapTxt, close > vwapVal ? color.new(color.green, 70) : color.new(color.red, 70), close > vwapVal ? dashGreen : dashRed)
    f_row(5, "Volume", volumeTxt, strongVolume ? color.new(color.green, 70) : color.new(color.gray, 75), strongVolume ? dashGreen : color.white)
    f_row(6, "Strength", strengthDots, color.new(color.black, 20), qualityScore >= 60 ? dashGreen : dashRed)
    f_row(7, "Quality", str.tostring(qualityScore), color.new(color.black, 20), qualityScore >= 70 ? dashGreen : qualityScore >= 50 ? color.yellow : dashRed)
    f_row(8, "Hit Rate", hitRateTxt, color.new(color.black, 20), na(hitRate) ? color.white : hitRate >= 60 ? dashGreen : dashRed)
    f_row(9, "Hits / Misses", hitsTxt, color.new(color.black, 20), color.white)
    f_row(10, "Signal", signalTxt, buySignal ? color.new(color.green, 45) : sellSignal ? color.new(color.red, 45) : color.new(color.black, 20), buySignal ? dashGreen : sellSignal ? dashRed : color.white)
    f_row(11, "Session", sessionTxt, inSession ? color.new(color.green, 70) : color.new(color.red, 70), inSession ? dashGreen : dashRed)
    f_row(12, "Signals", signalLimitTxt, color.new(color.black, 20), signalCount >= maxSignalsDay ? dashRed : color.white)

// =========================
// ALERTS
// =========================

alertcondition(
     buySignal,
     title="BUY ALERT",
     message="JXP SMC BUY")

alertcondition(
     sellSignal,
     title="SELL ALERT",
     message="JXP SMC SELL")

alertcondition(
     bullBOS or bearBOS or bullCHOCH or bearCHOCH,
     title="STRUCTURE ALERT",
     message="JXP SMC BOS / CHoCH detected")