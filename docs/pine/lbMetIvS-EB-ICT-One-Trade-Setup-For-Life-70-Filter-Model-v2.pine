//@version=5
strategy("EB ICT One Trade Setup For Life - 70% Filter Model v2",
     overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=0.5,
     commission_type=strategy.commission.percent,
     commission_value=0.01,
     max_labels_count=500,
     max_boxes_count=500)

//====================
// INPUTS
//====================
riskRR          = input.float(1.5, "Risk Reward", step=0.25)
minScore        = input.float(85.0, "Minimum Entry Score", step=5)
emaLen          = input.int(200, "EMA Trend Length")
swingLen        = input.int(5, "Swing Length")
atrLen          = input.int(14, "ATR Length")
slAtrBuffer     = input.float(0.4, "SL ATR Buffer", step=0.1)
useKillZone     = input.bool(true, "Use Kill Zones")
useTrendFilter  = input.bool(true, "Use EMA 200 Filter")
useRejection    = input.bool(true, "Require Rejection Candle")
maxBarsSetup    = input.int(40, "Max Bars After Sweep")
showZones       = input.bool(true, "Show Zones")

londonSession   = input.session("0700-1200", "London KZ")
nySession       = input.session("1300-2000", "NY KZ")

//====================
// SESSION
//====================
inLondon = not na(time(timeframe.period, londonSession))
inNY = not na(time(timeframe.period, nySession))
inKZ = inLondon or inNY
sessionOK = useKillZone ? inKZ : true

//====================
// TREND / ATR
//====================
ema200 = ta.ema(close, emaLen)
atr = ta.atr(atrLen)

bullTrend = close > ema200 and ema200 > ema200[5]
bearTrend = close < ema200 and ema200 < ema200[5]

//====================
// SWINGS
//====================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastHigh = na
var float lastLow = na

if not na(ph)
    lastHigh := ph

if not na(pl)
    lastLow := pl

//====================
// SWEEP
//====================
buySweep = sessionOK and not na(lastLow) and low < lastLow and close > lastLow
sellSweep = sessionOK and not na(lastHigh) and high > lastHigh and close < lastHigh

var int dir = 0
var bool sweepFound = false
var bool displacementFound = false
var bool fvgFound = false
var bool mssFound = false
var bool bosFound = false
var bool traded = false

var float sweepLevel = na
var int sweepBar = na

var float fvgTop = na
var float fvgBot = na
var int fvgBar = na

if buySweep
    dir := 1
    sweepFound := true
    displacementFound := false
    fvgFound := false
    mssFound := false
    bosFound := false
    traded := false
    sweepLevel := low
    sweepBar := bar_index

if sellSweep
    dir := -1
    sweepFound := true
    displacementFound := false
    fvgFound := false
    mssFound := false
    bosFound := false
    traded := false
    sweepLevel := high
    sweepBar := bar_index

setupAlive = sweepFound and bar_index - sweepBar <= maxBarsSetup

//====================
// DISPLACEMENT
//====================
body = math.abs(close - open)
avgBody = ta.sma(math.abs(close - open), 20)
rangeBig = high - low > atr * 0.8

bullDisp = setupAlive and dir == 1 and close > open and body > avgBody * 1.8 and rangeBig
bearDisp = setupAlive and dir == -1 and close < open and body > avgBody * 1.8 and rangeBig

if bullDisp or bearDisp
    displacementFound := true

//====================
// FVG
//====================
bullFVG = displacementFound and dir == 1 and low > high[2]
bearFVG = displacementFound and dir == -1 and high < low[2]

if bullFVG
    fvgTop := low
    fvgBot := high[2]
    fvgBar := bar_index
    fvgFound := true

if bearFVG
    fvgTop := low[2]
    fvgBot := high
    fvgBar := bar_index
    fvgFound := true

fvgActive = fvgFound and bar_index - fvgBar <= 25

//====================
// MSS / BOS
//====================
bullMSS = setupAlive and dir == 1 and close > ta.highest(high, 10)[1]
bearMSS = setupAlive and dir == -1 and close < ta.lowest(low, 10)[1]

if bullMSS or bearMSS
    mssFound := true

bullBOS = setupAlive and dir == 1 and mssFound and close > ta.highest(high, 20)[1]
bearBOS = setupAlive and dir == -1 and mssFound and close < ta.lowest(low, 20)[1]

if bullBOS or bearBOS
    bosFound := true

//====================
// RETEST + REJECTION
//====================
bullRetest = fvgActive and dir == 1 and low <= fvgTop and close > fvgBot
bearRetest = fvgActive and dir == -1 and high >= fvgBot and close < fvgTop

bullReject = close > open and close > high[1]
bearReject = close < open and close < low[1]

rejectOKBuy = useRejection ? bullReject : true
rejectOKSell = useRejection ? bearReject : true

//====================
// SCORE
//====================
score = 0.0
score += sweepFound ? 25 : 0
score += displacementFound ? 20 : 0
score += fvgFound ? 10 : 0
score += mssFound ? 20 : 0
score += bosFound ? 15 : 0
score += (bullRetest or bearRetest) ? 10 : 0

trendOKBuy = useTrendFilter ? bullTrend : true
trendOKSell = useTrendFilter ? bearTrend : true

buySignal = score >= minScore and dir == 1 and bullRetest and mssFound and bosFound and trendOKBuy and rejectOKBuy
sellSignal = score >= minScore and dir == -1 and bearRetest and mssFound and bosFound and trendOKSell and rejectOKSell

//====================
// SL / TP
//====================
buySL = math.min(sweepLevel, low) - atr * slAtrBuffer
sellSL = math.max(sweepLevel, high) + atr * slAtrBuffer

buyRisk = close - buySL
sellRisk = sellSL - close

buyTP = close + buyRisk * riskRR
sellTP = close - sellRisk * riskRR

if buySignal and not traded and buyRisk > syminfo.mintick
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY EXIT", "BUY", stop=buySL, limit=buyTP)
    traded := true

if sellSignal and not traded and sellRisk > syminfo.mintick
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL EXIT", "SELL", stop=sellSL, limit=sellTP)
    traded := true

//====================
// VISUALS
//====================
plot(ema200, "EMA 200", color=color.gray)

if buySweep
    label.new(bar_index, low, "BUY SWEEP", style=label.style_label_up, color=color.green, textcolor=color.white)

if sellSweep
    label.new(bar_index, high, "SELL SWEEP", style=label.style_label_down, color=color.red, textcolor=color.white)

if buySignal
    label.new(bar_index, low, "BUY A+\nScore " + str.tostring(score), style=label.style_label_up, color=color.lime, textcolor=color.black)

if sellSignal
    label.new(bar_index, high, "SELL A+\nScore " + str.tostring(score), style=label.style_label_down, color=color.red, textcolor=color.white)

if showZones and fvgFound and bar_index == fvgBar
    box.new(bar_index, fvgTop, bar_index + 25, fvgBot, bgcolor=color.new(color.gray, 80), border_color=color.gray)

//====================
// DASHBOARD
//====================
var table dash = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast
    table.cell(dash, 0, 0, "EB ICT 70% MODEL", text_color=color.white, bgcolor=color.blue)
    table.cell(dash, 1, 0, "v2", text_color=color.white, bgcolor=color.blue)

    table.cell(dash, 0, 1, "Direction")
    table.cell(dash, 1, 1, dir == 1 ? "BUY" : dir == -1 ? "SELL" : "NONE")

    table.cell(dash, 0, 2, "Score")
    table.cell(dash, 1, 2, str.tostring(score))

    table.cell(dash, 0, 3, "Sweep")
    table.cell(dash, 1, 3, sweepFound ? "YES" : "NO")

    table.cell(dash, 0, 4, "FVG")
    table.cell(dash, 1, 4, fvgFound ? "YES" : "NO")

    table.cell(dash, 0, 5, "MSS/BOS")
    table.cell(dash, 1, 5, (mssFound ? "MSS " : "") + (bosFound ? "BOS" : ""))

    table.cell(dash, 0, 6, "KZ")
    table.cell(dash, 1, 6, inKZ ? "OPEN" : "CLOSED")