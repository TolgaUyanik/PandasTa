//@version=6
indicator("Weekday Body Center Letters", overlay=true, max_boxes_count=500)

textSizeInput = input.string("Small", "Font Size", options=["Tiny", "Small", "Normal", "Large", "Huge"])
fontFamilyInput = input.string("Default", "Font Family", options=["Default", "Monospace"])
weekdayDateSource = input.string("Candle Close", "Weekday Date Source", options=["Candle Close", "Candle Open"])
bullTextColor = input.color(color.new(color.lime, 0), "Bull Candle Text Color")
bearTextColor = input.color(color.new(color.red, 0), "Bear Candle Text Color")
maxVisibleLetters = input.int(300, "Maximum Visible Letters", minval=1, maxval=500)

textSize = textSizeInput == "Tiny" ? size.tiny :
     textSizeInput == "Small" ? size.small :
     textSizeInput == "Normal" ? size.normal :
     textSizeInput == "Large" ? size.large :
     size.huge

fontFamily = fontFamilyInput == "Monospace" ? font.family_monospace : font.family_default

weekdayTime = weekdayDateSource == "Candle Close" and not na(time_close) ? time_close : time

weekdayText =
     dayofweek(weekdayTime) == dayofweek.monday ? "M" :
     dayofweek(weekdayTime) == dayofweek.tuesday ? "T" :
     dayofweek(weekdayTime) == dayofweek.wednesday ? "W" :
     dayofweek(weekdayTime) == dayofweek.thursday ? "Th" :
     dayofweek(weekdayTime) == dayofweek.friday ? "F" :
     dayofweek(weekdayTime) == dayofweek.saturday ? "S" :
     "S"

isBullCandle = close >= open
letterColor = isBullCandle ? bullTextColor : bearTextColor
bodyTop = math.max(open, close)
bodyBottom = math.min(open, close)
isDoji = bodyTop == bodyBottom
boxTop = isDoji ? bodyTop + syminfo.mintick : bodyTop
boxBottom = isDoji ? bodyBottom - syminfo.mintick : bodyBottom
boxLeft = bar_index - 1
boxRight = bar_index + 1

var box[] weekdayBoxes = array.new_box()

weekdayBox = box.new(
     left=boxLeft,
     top=boxTop,
     right=boxRight,
     bottom=boxBottom,
     xloc=xloc.bar_index,
     border_color=color.new(color.white, 100),
     bgcolor=color.new(color.white, 100),
     text=weekdayText,
     text_color=letterColor,
     text_size=textSize,
     text_halign=text.align_center,
     text_valign=text.align_center,
     text_font_family=fontFamily)

array.push(weekdayBoxes, weekdayBox)

if array.size(weekdayBoxes) > maxVisibleLetters
    box.delete(array.shift(weekdayBoxes))
