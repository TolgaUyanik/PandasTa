//@version=6
// Professional Anchored Volume Weighted Average Price (AVWAP) with Multi-Level Standard Deviation Bands
// 专业级锚定成交量加权平均价 (AVWAP) 及多阶标准差通道
indicator("专业级锚定成交量加权平均价 (AVWAP) 及多阶标准差通道", overlay=true)

// ============================================================================
// 1. INPUT PARAMETERS / 输入参数设置
// ============================================================================

// --- Anchor Date Settings / 锚定日期设置 ---
inline_anchor_date = "锚定日期"
anchor_year  = input.int(2024, title="年", inline=inline_anchor_date)
anchor_month = input.int(9,    title="月", inline=inline_anchor_date, minval=1, maxval=12)
anchor_day   = input.int(24,   title="日", inline=inline_anchor_date, minval=1, maxval=31)

// Calculate Anchor Epoch Timestamp / 计算锚定起始时间戳
anchor_timestamp = timestamp(anchor_year, anchor_month, anchor_day, 0, 0, 0)

// --- Deviation Bands Display Controls / 标准差偏差带显示控制 ---
group_low_bandwidth  = "低级别偏差带 (0.5 & 1.0)"
show_band05 = input.bool(true, title="显示 ±0.5 偏差带", group=group_low_bandwidth)
show_band10 = input.bool(true, title="显示 ±1.0 偏差带", group=group_low_bandwidth)

group_mid_bandwidth  = "中级别偏差带 (1.5 & 2.0)"
show_band15 = input.bool(true, title="显示 ±1.5 偏差带", group=group_mid_bandwidth)
show_band20 = input.bool(true, title="显示 ±2.0 偏差带", group=group_mid_bandwidth)

group_high_bandwidth = "高级别偏差带 (2.5 & 3.0)"
show_band25 = input.bool(true, title="显示 ±2.5 偏差带", group=group_high_bandwidth)
show_band30 = input.bool(true, title="显示 ±3.0 偏差带", group=group_high_bandwidth)

// ============================================================================
// 2. AVWAP CORE QUANTITATIVE CALCULATION / AVWAP 核心量化计算
// ============================================================================

// State variable to trigger calculation after anchor time / 标记当前 K 线是否已达到或过锚定时间
var bool is_anchored = false
if time >= anchor_timestamp and not is_anchored
    is_anchored := true

// Cumulative metric persistent variables / 声明历史累加状态变量
var float cum_price_volume  = 0.0  // Cumulative Price-Volume Product / 价格-成交量加权累加值
var float cum_volume        = 0.0  // Cumulative Total Volume / 成交量总累加值
var float cum_squared_pv    = 0.0  // Cumulative Squared Price-Volume Product / 价格平方与成交量加权累加值

if is_anchored
    // Calculate Typical Price: (High + Low + Close) / 3 / 计算典型价格 (HLC3)
    typical_price = hlc3
    
    // Accumulate volume and weighted price metrics / 累加价格与成交量权重数据
    cum_price_volume := cum_price_volume + typical_price * volume
    cum_volume       := cum_volume + volume
    cum_squared_pv   := cum_squared_pv + typical_price * typical_price * volume

// Calculate Volume Weighted Average Price (VWAP) & Standard Deviation / 计算 AVWAP 与标准差
avwap_value = cum_volume > 0 ? cum_price_volume / cum_volume : na
variance    = cum_volume > 0 ? math.max(0.0, (cum_squared_pv / cum_volume) - math.pow(avwap_value, 2)) : 0.0
stdev_value = math.sqrt(variance)

// ============================================================================
// 3. CHART VISUALIZATION & PLOTTING / 图表视觉化与绘制
// ============================================================================

// Plot Primary Anchored VWAP Benchmark / 绘制主 AVWAP 基准线
plot(avwap_value, title="VWAP", color=color.blue, linewidth=2)

// Plot 6-Tier Standard Deviation Bands / 绘制 6 阶标准差通道带
plot(is_anchored and show_band05 ? avwap_value + 0.5 * stdev_value : na, title="+0.5 Deviation", color=color.new(color.green, 50))
plot(is_anchored and show_band05 ? avwap_value - 0.5 * stdev_value : na, title="-0.5 Deviation", color=color.new(color.green, 50))

plot(is_anchored and show_band10 ? avwap_value + 1.0 * stdev_value : na, title="+1.0 Deviation", color=color.new(color.green, 20))
plot(is_anchored and show_band10 ? avwap_value - 1.0 * stdev_value : na, title="-1.0 Deviation", color=color.new(color.green, 20))

plot(is_anchored and show_band15 ? avwap_value + 1.5 * stdev_value : na, title="+1.5 Deviation", color=color.new(color.orange, 50))
plot(is_anchored and show_band15 ? avwap_value - 1.5 * stdev_value : na, title="-1.5 Deviation", color=color.new(color.orange, 50))

plot(is_anchored and show_band20 ? avwap_value + 2.0 * stdev_value : na, title="+2.0 Deviation", color=color.new(color.orange, 20))
plot(is_anchored and show_band20 ? avwap_value - 2.0 * stdev_value : na, title="-2.0 Deviation", color=color.new(color.orange, 20))

plot(is_anchored and show_band25 ? avwap_value + 2.5 * stdev_value : na, title="+2.5 Deviation", color=color.new(color.red, 50))
plot(is_anchored and show_band25 ? avwap_value - 2.5 * stdev_value : na, title="-2.5 Deviation", color=color.new(color.red, 50))

plot(is_anchored and show_band30 ? avwap_value + 3.0 * stdev_value : na, title="+3.0 Deviation", color=color.new(color.red, 20))
plot(is_anchored and show_band30 ? avwap_value - 3.0 * stdev_value : na, title="-3.0 Deviation", color=color.new(color.red, 20))