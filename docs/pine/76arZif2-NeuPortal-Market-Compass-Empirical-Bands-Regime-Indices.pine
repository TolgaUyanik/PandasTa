//@version=6
// ============================================================================
//  NeuPortal Market Compass
//  One instrumented overlay for any symbol and any timeframe: trend curves
//  (EMA / VWAP), a Bollinger envelope, an EMPIRICAL forward distribution band
//  (core 50% / wide 80% read straight off THIS chart's own historical moves,
//  not sigma * sqrt-t), and a regime dashboard (RSI, ADX, ATR, band width and
//  the honest number of INDEPENDENT windows the band rests on).
//
//  Why empirical: a parametric band assumes normal, independent returns. Real
//  markets have fat tails and volatility clustering, so a sqrt-t band is wrong
//  in both directions depending on the horizon. This reads the quantiles from
//  the data instead, and prints how much independent history stands behind it.
//
//  Educational tool. Not financial advice. No method reliably beats a liquid
//  market; this instruments the chart, it does not predict it.
// ============================================================================
indicator("NeuPortal Market Compass", overlay = true, max_boxes_count = 30, max_lines_count = 30, max_labels_count = 30)

// ------------------------------- inputs -------------------------------------
gT = "Trend curves"
showEma  = input.bool(true,  "Show EMAs",              group = gT)
len1     = input.int(20,     "EMA fast", minval = 1,   group = gT)
len2     = input.int(50,     "EMA mid",  minval = 1,   group = gT)
len3     = input.int(200,    "EMA slow", minval = 1,   group = gT)
showVwap = input.bool(false, "Show VWAP",              group = gT)

gB = "Empirical forecast band"
showBand = input.bool(true,  "Show empirical band",                     group = gB)
H        = input.int(24,     "Horizon (bars ahead)", minval = 1, maxval = 400, group = gB)
LB       = input.int(1000,   "History window (bars)", minval = 50,      group = gB)
coreClr  = input.color(color.rgb(94, 234, 212), "Core 50% color",       group = gB)
wideClr  = input.color(color.rgb(124, 92, 255), "Wide 80% color",       group = gB)

gV = "Volatility envelope"
showBb = input.bool(true,  "Show Bollinger",           group = gV)
bbLen  = input.int(20,     "BB length", minval = 1,    group = gV)
bbMult = input.float(2.0,  "BB mult",   minval = 0.1,  group = gV)

gD = "Dashboard"
showTab = input.bool(true, "Show dashboard",           group = gD)
tabPos  = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = gD)
rsiLen  = input.int(14, "RSI length", minval = 1,      group = gD)
adxLen  = input.int(14, "ADX length", minval = 1,      group = gD)
atrLen  = input.int(14, "ATR length", minval = 1,      group = gD)
tintBg  = input.bool(false, "Tint background by regime", group = gD)

// ------------------------------ curves --------------------------------------
ema1 = ta.ema(close, len1)
ema2 = ta.ema(close, len2)
ema3 = ta.ema(close, len3)
plot(showEma ? ema1 : na, "EMA fast", color = color.new(color.orange, 0), linewidth = 2)
plot(showEma ? ema2 : na, "EMA mid",  color = color.new(color.blue, 0),   linewidth = 2)
plot(showEma ? ema3 : na, "EMA slow", color = color.new(color.gray, 0),   linewidth = 2)
vwapv = ta.vwap(hlc3)
plot(showVwap ? vwapv : na, "VWAP", color = color.new(color.fuchsia, 0), linewidth = 1)

bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
plot(showBb ? bbBasis + bbDev : na, "BB upper", color = color.new(color.gray, 45))
plot(showBb ? bbBasis - bbDev : na, "BB lower", color = color.new(color.gray, 45))

// -------------------------- oscillators / indices ---------------------------
rsiv = ta.rsi(close, rsiLen)
[diPlus, diMinus, adxv] = ta.dmi(adxLen, adxLen)
atrv   = ta.atr(atrLen)
atrPct = atrv / close * 100.0

// ----------------------- empirical forward band -----------------------------
// Distribution of realised H-bar log returns over the history window, read as
// quantiles. Percentages are 0-100 (percentile_linear_interpolation contract).
hret   = math.log(close / close[H])
qMid   = ta.percentile_linear_interpolation(hret, LB, 50)
qCoreL = ta.percentile_linear_interpolation(hret, LB, 25)
qCoreH = ta.percentile_linear_interpolation(hret, LB, 75)
qWideL = ta.percentile_linear_interpolation(hret, LB, 10)
qWideH = ta.percentile_linear_interpolation(hret, LB, 90)
coreLo = close * math.exp(qCoreL)
coreHi = close * math.exp(qCoreH)
wideLo = close * math.exp(qWideL)
wideHi = close * math.exp(qWideH)
medv   = close * math.exp(qMid)
indep  = int(LB / H)
bandW  = (wideHi - wideLo) / close * 100.0

var box  coreBox = na
var box  wideBox = na
var line medLine = na
if showBand and barstate.islast
    if not na(coreBox)
        box.delete(coreBox)
        box.delete(wideBox)
        line.delete(medLine)
    x2 = bar_index + H
    wideBox := box.new(bar_index, wideHi, x2, wideLo, border_color = color.new(wideClr, 55), bgcolor = color.new(wideClr, 88))
    coreBox := box.new(bar_index, coreHi, x2, coreLo, border_color = color.new(coreClr, 25), bgcolor = color.new(coreClr, 76))
    medLine := line.new(bar_index, medv, x2, medv, color = color.new(coreClr, 0), width = 2)

// -------------------------------- regime ------------------------------------
up     = close > ema1 and ema1 > ema2
down   = close < ema1 and ema1 < ema2
strong = adxv >= 25
regime = up ? (strong ? "Uptrend (strong)" : "Uptrend") : down ? (strong ? "Downtrend (strong)" : "Downtrend") : "Range / no trend"
regCol = up ? color.new(color.teal, 0) : down ? color.new(color.red, 0) : color.new(color.gray, 0)
bgcolor(tintBg ? (up ? color.new(color.teal, 92) : down ? color.new(color.red, 92) : na) : na)

// ------------------------------ dashboard -----------------------------------
f_pos(s) => s == "Top right" ? position.top_right : s == "Top left" ? position.top_left : s == "Bottom right" ? position.bottom_right : position.bottom_left
fmt(v) => v >= 100 ? str.tostring(v, "#,###") : v >= 1 ? str.tostring(v, "#,###.00") : str.tostring(v, "0.######")
var table dash = na
if showTab and barstate.islast
    if not na(dash)
        table.delete(dash)
    dash := table.new(f_pos(tabPos), 2, 11, border_width = 1, frame_color = color.new(color.gray, 55), frame_width = 1)
    table.cell(dash, 0, 0, "NEUPORTAL", text_color = color.white, bgcolor = color.new(color.purple, 0), text_size = size.small)
    table.cell(dash, 1, 0, "Market Compass", text_color = color.new(color.teal, 0), text_size = size.small)
    table.cell(dash, 0, 1, "Regime", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, regime, text_color = regCol, text_size = size.small)
    table.cell(dash, 0, 2, "RSI(" + str.tostring(rsiLen) + ")", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, str.tostring(rsiv, "#.0"), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 3, "ADX(" + str.tostring(adxLen) + ")", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 3, str.tostring(adxv, "#.0") + (strong ? " strong" : " weak"), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 4, "ATR %", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(atrPct, "#.00") + " %", text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 5, "Median " + str.tostring(H) + "b", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 5, fmt(medv), text_color = color.new(color.teal, 0), text_size = size.small)
    table.cell(dash, 0, 6, "Core 50%", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 6, fmt(coreLo) + " - " + fmt(coreHi), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 7, "Wide 80%", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 7, fmt(wideLo) + " - " + fmt(wideHi), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 8, "Band width", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 8, str.tostring(bandW, "#.0") + " %", text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 9, "Indep. windows", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 9, str.tostring(indep), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 10, "empirical, not sqrt-t", text_color = color.new(color.gray, 25), text_size = size.tiny)
    table.cell(dash, 1, 10, "band from " + str.tostring(indep) + " windows", text_color = color.new(color.gray, 25), text_size = size.tiny)

// -------------------------------- alerts ------------------------------------
alertcondition(ta.crossover(close, ema2),  "Cross above EMA mid", "Price crossed above EMA mid")
alertcondition(ta.crossunder(close, ema2), "Cross below EMA mid", "Price crossed below EMA mid")
alertcondition(high >= wideHi, "Reached wide 80% top",    "Price reached the top of the empirical 80% band")
alertcondition(low  <= wideLo, "Reached wide 80% bottom", "Price reached the bottom of the empirical 80% band")
