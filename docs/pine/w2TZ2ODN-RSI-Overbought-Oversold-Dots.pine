//@version=6
indicator("RSI Overbought/Oversold Dots", shorttitle = "RSI Dots", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// Simple RSI-based marker: plots a dot on the price chart whenever RSI
// crosses into overbought or oversold territory.

g_rsi = "RSI"
rsiSrc        = input.source(close, "Source", group = g_rsi)
rsiLen        = input.int(14, "RSI Length", minval = 1, group = g_rsi)
rsiOverbought = input.int(70, "Overbought level", minval = 50, maxval = 100, group = g_rsi)
rsiOversold   = input.int(30, "Oversold level", minval = 0, maxval = 50, group = g_rsi)
lookbackBars  = input.int(200, "Lookback bars for extreme tracking (compares across separate RSI waves)", minval = 10, group = g_rsi)

g_vis = "Visuals"
dotSize      = input.string("Tiny", "Bubble size", options = ["Tiny", "Small", "Normal"], group = g_vis)
showZone     = input.bool(true, "Draw a zone box at the extreme (extends right for retest)", group = g_vis)
zoneAtrMult  = input.float(0.25, "Zone thickness (x ATR)", minval = 0.05, step = 0.05, group = g_vis)
obColor      = input.color(color.green, "Overbought bubble color", group = g_vis)
osColor      = input.color(color.red, "Oversold bubble color", group = g_vis)
obZoneColor  = input.color(color.green, "Overbought zone color", group = g_vis)
osZoneColor  = input.color(color.red, "Oversold zone color", group = g_vis)

rsiVal = ta.rsi(rsiSrc, rsiLen)
atrVal = ta.atr(14)

isOverbought = rsiVal > rsiOverbought
isOversold   = rsiVal < rsiOversold

dotSizeVal = dotSize == "Tiny" ? size.tiny : dotSize == "Normal" ? size.normal : size.small

// compare against the rolling highest/lowest RSI over the lookback window,
// not just the current streak - so a new bubble only appears when this bar
// is the most overbought/oversold point seen across the last N bars,
// including separate earlier waves that already ended
rollingHighRsi = ta.highest(rsiVal, lookbackBars)
rollingLowRsi  = ta.lowest(rsiVal, lookbackBars)

newObPeak   = isOverbought and rsiVal >= rollingHighRsi
newOsTrough = isOversold and rsiVal <= rollingLowRsi

var label obLabel = na
var label osLabel = na
var box   obZone  = na
var box   osZone  = na

obTextCol = color.r(obColor) + color.g(obColor) + color.b(obColor) > 380 ? color.black : color.white
osTextCol = color.r(osColor) + color.g(osColor) + color.b(osColor) > 380 ? color.black : color.white

if newObPeak
    if not na(obLabel)
        label.delete(obLabel)
    obLabel := label.new(bar_index, high, "RSI Overbought " + str.tostring(rsiVal, "#.#") + "%", style = label.style_label_down, color = color.new(obColor, 0), textcolor = obTextCol, size = dotSizeVal, tooltip = "RSI overbought: " + str.tostring(rsiVal, "#.#"))
    if showZone
        if not na(obZone)
            box.delete(obZone)
        obZone := box.new(bar_index, high, bar_index, high - zoneAtrMult * atrVal, border_color = color.new(obZoneColor, 30), bgcolor = color.new(obZoneColor, 85), extend = extend.right)
if newOsTrough
    if not na(osLabel)
        label.delete(osLabel)
    osLabel := label.new(bar_index, low, "RSI Oversold " + str.tostring(rsiVal, "#.#") + "%", style = label.style_label_up, color = color.new(osColor, 0), textcolor = osTextCol, size = dotSizeVal, tooltip = "RSI oversold: " + str.tostring(rsiVal, "#.#"))
    if showZone
        if not na(osZone)
            box.delete(osZone)
        osZone := box.new(bar_index, low + zoneAtrMult * atrVal, bar_index, low, border_color = color.new(osZoneColor, 30), bgcolor = color.new(osZoneColor, 85), extend = extend.right)

alertcondition(isOverbought and not isOverbought[1], title = "RSI Overbought", message = "RSI entered overbought territory")
alertcondition(isOversold and not isOversold[1], title = "RSI Oversold", message = "RSI entered oversold territory")