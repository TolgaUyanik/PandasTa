//@version=5
indicator("Order Block Finder (5-min Demand Zones)", overlay=true)

lookback = input.int(20, title="Lookback Bars")
bodyThreshold = input.float(0.3, title="Body Size % Threshold")

isBullish = close > open
bodySize = math.abs(close - open)
candleRange = high - low
smallBody = bodySize < (candleRange * bodyThreshold)

// Detect Bullish OB
bullOB = isBullish and smallBody and ta.lowest(low, lookback) == low
plotshape(bullOB, location=location.belowbar, style=shape.triangleup, color=color.green, size=size.small)
bgcolor(bullOB ? color.new(color.green, 85) : na, title="Bullish OB Background")
