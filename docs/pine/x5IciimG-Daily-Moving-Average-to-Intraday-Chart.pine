//@version=6
indicator('Daily Moving Average to Intraday Chart', overlay = true)


sma200 = ta.sma(close, 200)
sma100 = ta.sma(close, 100)
sma50 = ta.sma(close, 50)
ema20 = ta.ema(close, 20)

plot1 = request.security(syminfo.tickerid, 'D', sma200)
plot2 = request.security(syminfo.tickerid, 'D', sma100)
plot3 = request.security(syminfo.tickerid, 'D', sma50)
plot4 = request.security(syminfo.tickerid, 'D', ema20)

plot(plot1, linewidth = 2, color = color.new(color.yellow, 0))
plot(plot2, linewidth = 2, color = color.new(color.orange, 0))
plot(plot3, linewidth = 2, color = color.new(#21d4f3, 0))
plot(plot4, linewidth = 2, color = color.new(color.lime, 0))
