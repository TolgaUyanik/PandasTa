//@version=5
indicator("Flexi MA Heat Zones", overlay=true)

// ╔══════════════════════════════════════╗
// ║       USER INPUTS & CONFIGURATION   ║
// ╚══════════════════════════════════════╝

// MA Type
ma_type = input.string("EMA", title="Moving Average Type", options=["EMA", "SMA", "WMA", "VWMA"])

// MA Lengths
group_ma_lengths = "➤ MA Length Settings"
ma1_length = input.int(20, title="MA1 Length", group=group_ma_lengths)
ma2_length = input.int(50, title="MA2 Length", group=group_ma_lengths)
ma3_length = input.int(100, title="MA3 Length", group=group_ma_lengths)
ma4_length = input.int(200, title="MA4 Length", group=group_ma_lengths)
ma5_length = input.int(5, title="MA5 Length", group=group_ma_lengths)

// Visibility Toggles
group_visibility = "➤ Display Options"
enableAllHeatmaps = input.bool(true, "Enable All Heatmaps", group=group_visibility)
showHeatmap_MA1_MA2 = input.bool(true, "Show Heatmap: MA1 & MA2", group=group_visibility)
showHeatmap_MA3_MA4 = input.bool(true, "Show Heatmap: MA3 & MA4", group=group_visibility)
showHeatmap_MA5_MA1 = input.bool(true, "Show Heatmap: MA5 & MA1", group=group_visibility)

// Transparency
group_transparency = "➤ Heatmap Transparency"
transp_MA1_MA2 = input.int(70, "MA1-MA2 Heatmap", minval=0, maxval=100, group=group_transparency)
transp_MA3_MA4 = input.int(85, "MA3-MA4 Heatmap", minval=0, maxval=100, group=group_transparency)
transp_MA5_MA1 = input.int(60, "MA5-MA1 Heatmap", minval=0, maxval=100, group=group_transparency)

// MA Colors
ma1_color = input.color(color.orange, "MA1 Color", inline="ma1", group="➤ MA Line Colors")
ma2_color = input.color(color.yellow, "MA2 Color", inline="ma1", group="➤ MA Line Colors")
ma3_color = input.color(color.blue, "MA3 Color", inline="ma3", group="➤ MA Line Colors")
ma4_color = input.color(color.green, "MA4 Color", inline="ma3", group="➤ MA Line Colors")
ma5_color = input.color(color.silver, "MA5 Color", inline="ma5", group="➤ MA Line Colors")

// Heatmap Colors
group_heatmap_colors = "➤ Heatmap Colors"
heatmap1_bull_color = input.color(color.aqua, "MA1-MA2 Bullish", inline="h1", group=group_heatmap_colors)
heatmap1_bear_color = input.color(color.purple, "Bearish", inline="h1", group=group_heatmap_colors)

heatmap2_bull_color = input.color(color.teal, "MA3-MA4 Bullish", inline="h2", group=group_heatmap_colors)
heatmap2_bear_color = input.color(color.orange, "Bearish", inline="h2", group=group_heatmap_colors)

heatmap3_bull_color = input.color(color.lime, "MA5-MA1 Bullish", inline="h3", group=group_heatmap_colors)
heatmap3_bear_color = input.color(color.maroon, "Bearish", inline="h3", group=group_heatmap_colors)

// ╔══════════════════════════════════════╗
// ║         MA CALCULATION LOGIC        ║
// ╚══════════════════════════════════════╝

get_ma(src, len) =>
    switch ma_type
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "WMA" => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        => na

// ╔══════════════════════════════════════╗
// ║           MA PLOTS & FILLS          ║
// ╚══════════════════════════════════════╝

ma1 = get_ma(close, ma1_length)
ma2 = get_ma(close, ma2_length)
ma3 = get_ma(close, ma3_length)
ma4 = get_ma(close, ma4_length)
ma5 = get_ma(close, ma5_length)

// Always show all MA lines
ma1_plot = plot(ma1, title="MA1", color=ma1_color)
ma2_plot = plot(ma2, title="MA2", color=ma2_color, linewidth=2)
ma3_plot = plot(ma3, title="MA3", color=ma3_color)
ma4_plot = plot(ma4, title="MA4", color=ma4_color)
ma5_plot = plot(ma5, title="MA5", color=ma5_color)

// Conditional fills (top-level, no if-scope)
fill(ma1_plot, ma2_plot,
     color=(enableAllHeatmaps and showHeatmap_MA1_MA2) ? color.new(ma1 > ma2 ? heatmap1_bull_color : heatmap1_bear_color, transp_MA1_MA2) : na,
     title="MA1-MA2 Heatmap")

fill(ma3_plot, ma4_plot,
     color=(enableAllHeatmaps and showHeatmap_MA3_MA4) ? color.new(ma3 > ma4 ? heatmap2_bull_color : heatmap2_bear_color, transp_MA3_MA4) : na,
     title="MA3-MA4 Heatmap")

fill(ma5_plot, ma1_plot,
     color=(enableAllHeatmaps and showHeatmap_MA5_MA1) ? color.new(ma5 > ma1 ? heatmap3_bull_color : heatmap3_bear_color, transp_MA5_MA1) : na,
     title="MA5-MA1 Heatmap")
