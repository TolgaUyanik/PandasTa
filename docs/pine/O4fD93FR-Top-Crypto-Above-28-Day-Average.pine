//@version=6
indicator("Top Crypto Above 28-Day Average", shorttitle="CRYPTOTW", overlay=false)

// Input parameters
show_table = input.bool(false, "Show Results Table")
table_position = input.string("top_right", "Table Position", options=["top_left", "top_right", "bottom_left", "bottom_right"])
max_display = input.int(28, "Max Cryptos to Display", minval=1, maxval=50)
current_batch = input.string("Top40", "Current Batch", options=["Top40", "Mid40", "Low40"])
batch_size = input.int(40, "Batch Size (Max 40)", minval=10, maxval=40)

// Define top 120 crypto symbols by market cap with above at least $20 million trading volume(excluding major stablecoins)
// Updated batches based on current market cap rankings
get_crypto_batch(batch_num) =>
    symbols = array.new<string>()
    
    if batch_num == "Top40"
        // Batch 1: Top 40 cryptos
        array.push(symbols, "BTCUSDT")
        array.push(symbols, "ETHUSDT")
        array.push(symbols, "XRPUSDT")
        array.push(symbols, "BNBUSDT")
        array.push(symbols, "SOLUSDT")
        array.push(symbols, "DOGEUSDT")
        array.push(symbols, "TRXUSDT")
        array.push(symbols, "ADAUSDT")
        array.push(symbols, "HYPEUSDT")
        array.push(symbols, "XLMUSDT")
        array.push(symbols, "SUIUSDT")
        array.push(symbols, "LINKUSDT")
        array.push(symbols, "HBARUSDT")
        array.push(symbols, "BCHUSDT")
        array.push(symbols, "AVAXUSDT")
        array.push(symbols, "WEETHUSDT")
        array.push(symbols, "SHIBUSDT")
        array.push(symbols, "WETHUSDT")
        array.push(symbols, "LTCUSDT")
        array.push(symbols, "TONUSDT")
        array.push(symbols, "BSC-USDUSDT")
        array.push(symbols, "DOTUSDT")
        array.push(symbols, "WBTUSDT")
        array.push(symbols, "UNIUSDT")
        array.push(symbols, "XMRUSDT")
        array.push(symbols, "BGBUSDT")
        array.push(symbols, "PEPEUSDT")
        array.push(symbols, "AAVEUSDT")
        array.push(symbols, "TAOUSDT")
        array.push(symbols, "CROUSDT")
        array.push(symbols, "ETCUSDT")
        array.push(symbols, "NEARUSDT")
        array.push(symbols, "APTUSDT")
        array.push(symbols, "PIUSDT")
        array.push(symbols, "ONDOUSDT")
        array.push(symbols, "ICPUSDT")
        array.push(symbols, "JITOSOLUSDT")
        array.push(symbols, "OKBUSDT")
        array.push(symbols, "BONKUSDT")
        array.push(symbols, "ALGOUSDT")
    
    else if batch_num == "Mid40"
        // Batch 2: Cryptos 41-80
        array.push(symbols, "MNTUSDT")
        array.push(symbols, "ENAUSDT")
        array.push(symbols, "KASUSDT")
        array.push(symbols, "ARBUSDT")
        array.push(symbols, "VETUSDT")
        array.push(symbols, "ATOMUSDT")
        array.push(symbols, "POLUSDT")
        array.push(symbols, "RENDERUSDT")
        array.push(symbols, "SEIUSDT")
        array.push(symbols, "FETUSDT")
        array.push(symbols, "TRUMPUSDT")
        array.push(symbols, "WLDUSDT")
        array.push(symbols, "FILUSDT")
        array.push(symbols, "FTNUSDT")
        array.push(symbols, "PENGUUSDT")
        array.push(symbols, "QNTUSDT")
        array.push(symbols, "SPXUSDT")
        array.push(symbols, "JUPUSDT")
        array.push(symbols, "PUMPUSDT")
        array.push(symbols, "JLPUSDT")
        array.push(symbols, "TIAUSDT")
        array.push(symbols, "FARTCOINUSDT")
        array.push(symbols, "FLRUSDT")
        array.push(symbols, "INJUSDT")
        array.push(symbols, "XDCUSDT")
        array.push(symbols, "STXUSDT")
        array.push(symbols, "IPUSDT")
        array.push(symbols, "CRVUSDT")
        array.push(symbols, "OPUSDT")
        array.push(symbols, "NEXOUSDT")
        array.push(symbols, "SUSDT")
        array.push(symbols, "FLOKIUSDT")
        array.push(symbols, "VIRTUALUSDT")
        array.push(symbols, "IMXUSDT")
        array.push(symbols, "GRTUSDT")
        array.push(symbols, "WIFUSDT")
        array.push(symbols, "KAIAUSDT")
        array.push(symbols, "LDOUSDT")
        array.push(symbols, "ENSUSDT")
        array.push(symbols, "AUSDT")

    else if batch_num == "Low40"
        // Batch 3: Cryptos 81-120
        array.push(symbols, "IOTAUSDT")
        array.push(symbols, "THETAUSDT")
        array.push(symbols, "CAKEUSDT")
        array.push(symbols, "GALAUSDT")
        array.push(symbols, "MSOLUSDT")
        array.push(symbols, "PYUSDUSDT")
        array.push(symbols, "JASMYUSDT")
        array.push(symbols, "SANDUSDT")
        array.push(symbols, "AEROUSDT")
        array.push(symbols, "PYTHUSDT")
        array.push(symbols, "XTZUSDT")
        array.push(symbols, "RAYUSDT")
        array.push(symbols, "PENDLEUSDT")
        array.push(symbols, "ZECUSDT")
        array.push(symbols, "BTTUSDT")
        array.push(symbols, "JTOUSDT")
        array.push(symbols, "FLOWUSDT")
        array.push(symbols, "MORPHOUSDT")
        array.push(symbols, "HNTUSDT")
        array.push(symbols, "MANAUSDT")
        array.push(symbols, "XCNUSDT")
        array.push(symbols, "BRETTUSDT")
        array.push(symbols, "MOGUSDT")
        array.push(symbols, "ABUSDT")
        array.push(symbols, "BSVUSDT")
        array.push(symbols, "COREUSDT")
        array.push(symbols, "RUNEUSDT")
        array.push(symbols, "MUSDT")
        array.push(symbols, "APEUSDT")
        array.push(symbols, "RSRUSDT")
        array.push(symbols, "ETHFIUSDT")
        array.push(symbols, "CFXUSDT")
        array.push(symbols, "STRKUSDT")
        array.push(symbols, "DYDXUSDT")
        array.push(symbols, "ARUSDT")
        array.push(symbols, "DEEPUSDT")
        array.push(symbols, "NEOUSDT")
        array.push(symbols, "EGLDUSDT")
        array.push(symbols, "COMPUSDT")
        array.push(symbols, "EIGENUSDT")
    
    symbols

// Get current batch symbols
current_symbols = get_crypto_batch(current_batch)

// Limit to batch_size to stay under 40 request limit
symbols_to_check = array.new<string>()
max_symbols = math.min(batch_size, array.size(current_symbols))
for i = 0 to max_symbols - 1
    array.push(symbols_to_check, array.get(current_symbols, i))

// Pre-calculate all security data on every bar for consistency
var prices = array.new<float>()
var ma28s = array.new<float>()

// Clear and recalculate arrays on every bar
array.clear(prices)
array.clear(ma28s)

// Get all price data consistently on every bar
for i = 0 to array.size(symbols_to_check) - 1
    symbol = array.get(symbols_to_check, i)
    [c, ma28] = request.security(symbol, timeframe.period, [close, ta.sma(close, 28)], lookahead=barmerge.lookahead_off)
    array.push(prices, c)
    array.push(ma28s, ma28)

// Calculate count of cryptos above 28-day MA
total_above_ma = 0
for i = 0 to array.size(symbols_to_check) - 1
    price = array.get(prices, i)
    ma28 = array.get(ma28s, i)
    if price > ma28
        total_above_ma += 1

// Variables for table display
var above_ma_symbols = array.new<string>()
var above_ma_prices = array.new<float>()
var above_ma_changes = array.new<float>()

// Update detailed arrays on last bar for table display
if barstate.islast
    array.clear(above_ma_symbols)
    array.clear(above_ma_prices)
    array.clear(above_ma_changes)
    
    // Check each crypto and store detailed data
    for i = 0 to array.size(symbols_to_check) - 1
        symbol = array.get(symbols_to_check, i)
        price = array.get(prices, i)
        ma28 = array.get(ma28s, i)
        
        if price > ma28
            change_pct = (price - ma28) / ma28 * 100
            
            // Store results
            array.push(above_ma_symbols, str.replace(symbol, "USDT", ""))
            array.push(above_ma_prices, price)
            array.push(above_ma_changes, change_pct)

// Plot current batch count
plot(total_above_ma, title="Cryptos Above 28-Day MA", color=color.blue, linewidth=2)

// Reference lines based on batch (all batches have 40 cryptos)
hline(30, title="75% of Batch", color=color.green, linestyle=hline.style_solid)
hline(20, title="50% of Batch", color=color.gray, linestyle=hline.style_dashed)
hline(10, title="25% of Batch", color=color.red, linestyle=hline.style_dotted)

// Create table if enabled (only on last bar)
if show_table and barstate.islast
    pos = table_position == "top_left" ? position.top_left : 
          table_position == "top_right" ? position.top_right :
          table_position == "bottom_left" ? position.bottom_left : position.bottom_right
    
    table_rows = math.min(max_display + 1, array.size(above_ma_symbols) + 1)
    t = table.new(pos, 4, table_rows, 
                  bgcolor=color.white, border_width=1, border_color=color.gray)
    
    // Table headers
    table.cell(t, 0, 0, "Crypto", text_color=color.black, text_size=size.small, bgcolor=color.silver)
    table.cell(t, 1, 0, "Price", text_color=color.black, text_size=size.small, bgcolor=color.silver)
    table.cell(t, 2, 0, "vs 28MA", text_color=color.black, text_size=size.small, bgcolor=color.silver)
    table.cell(t, 3, 0, "Status", text_color=color.black, text_size=size.small, bgcolor=color.silver)
    
    // Fill table with data
    display_count = math.min(max_display, array.size(above_ma_symbols))
    for i = 0 to display_count - 1
        symbol = array.get(above_ma_symbols, i)
        price = array.get(above_ma_prices, i)
        change = array.get(above_ma_changes, i)
        
        // Format price
        price_str = price > 1 ? str.format("{0,number,#.##}", price) : str.format("{0,number,#.####}", price)
        
        // Format change percentage
        change_str = str.format("+{0,number,#.##}%", change)
        
        // Color based on strength above MA
        cell_color = change > 10 ? color.new(color.green, 80) : change > 5 ? color.new(color.lime, 80) : color.new(color.yellow, 80)
        
        table.cell(t, 0, i + 1, symbol, text_color=color.black, text_size=size.small)
        table.cell(t, 1, i + 1, price_str, text_color=color.black, text_size=size.small)
        table.cell(t, 2, i + 1, change_str, text_color=color.black, text_size=size.small, bgcolor=cell_color)
        table.cell(t, 3, i + 1, "Above", text_color=color.green, text_size=size.small)

// Background color based on batch performance
batch_total = 40  // All batches have 40 cryptos
strong_threshold = math.round(batch_total * 0.7)  // 70% threshold
moderate_threshold = math.round(batch_total * 0.5)  // 50% threshold

bgcolor(total_above_ma > strong_threshold ? color.new(color.green, 90) : total_above_ma > moderate_threshold ? color.new(color.yellow, 90) : color.new(color.red, 90), title="Batch Strength Background")

// Alert conditions for batch performance
alertcondition(total_above_ma > strong_threshold, title="Strong Batch Performance", 
               message="{{current_batch}} batch showing strong performance: {{total_above_ma}}/{{batch_total}} above 28-day MA")
alertcondition(total_above_ma < 10, title="Weak Batch Performance", 
               message="{{current_batch}} batch showing weak performance: {{total_above_ma}}/{{batch_total}} above 28-day MA")