//@version=6
indicator("Volume Delta + RSI Confluence Signals", overlay=true, max_labels_count=500)

// === Inputs ===
showHistogram = input.bool(true, "Show Delta Histogram")
rsiLen      = input.int(14, "RSI Length")
smoothLen   = input.int(8, "RSI Smoothing Length")
useBias     = input.bool(true, "Use EMA200 Bias Filter")

// === EMA Bias ===
ema200 = ta.ema(close, 200)
bullBias = close > ema200
bearBias = close < ema200

// === Approximate Volume Delta ===
upVol   = close > open ? volume : 0.0
downVol = close < open ? volume : 0.0
delta   = upVol - downVol

openVol = 0.0
maxVol  = math.max(delta, 0)
minVol  = math.min(delta, 0)
lastVol = delta
col = lastVol > 0 ? color.teal : color.red

// === Always plot, control visibility with transparency ===
hline(0, "Zero Line")
plotcandle(openVol, maxVol, minVol, lastVol, "Volume Delta",
     color=showHistogram ? col : color.new(color.teal, 100),
     bordercolor=showHistogram ? col : color.new(color.teal, 100),
     wickcolor=showHistogram ? col : color.new(color.teal, 100))

// === RSI with smoothing ===
rsiRaw    = ta.rsi(close, rsiLen)
rsiSmooth = ta.ema(rsiRaw, smoothLen)

rsiCrossUp   = ta.crossover(rsiSmooth, rsiSmooth[1])
rsiCrossDown = ta.crossunder(rsiSmooth, rsiSmooth[1])

rsiBullReject = rsiSmooth < 50 and rsiCrossUp
rsiBearReject = rsiSmooth > 50 and rsiCrossDown

// === Confluence ===
buySignal  = (delta > 0) and rsiBullReject and (not useBias or bullBias)
sellSignal = (delta < 0) and rsiBearReject and (not useBias or bearBias)

// === Plot Buy/Sell on Main Chart ===
plotshape(buySignal, title="Buy", location=location.belowbar,
          color=color.green, style=shape.triangleup, size=size.small, text="BUY")

plotshape(sellSignal, title="Sell", location=location.abovebar,
          color=color.red, style=shape.triangledown, size=size.small, text="SELL")
