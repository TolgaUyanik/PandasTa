//@version=6
library("WeightedVolumeUtils", overlay = false)

// @function Returns the input value (placeholder function).
// @param x A float value.
// @returns The same float value passed as input.
export fun(float x) =>
    x

// @function Gets volume of the given symbol on the current chart's timeframe.
// @param s A string representing the symbol (e.g., "BSE:HDFCBANK").
// @returns Volume of the symbol on the current timeframe.
sym(s) =>
    request.security(s, timeframe.period, volume)

// @function Calculates the weighted volume for BSE index based on top constituent stocks.
// @returns Weighted volume value based on fixed weights for BSE SENSEX stocks.
export weightedBSEVolume() =>
    (15.66 * sym('BSE:HDFCBANK') +
     10.88 * sym('BSE:ICICIBANK') +
     10.24 * sym('BSE:RELIANCE') +
      5.75 * sym('BSE:INFY') +
      5.37 * sym('BSE:BHARTIARTL') +
      4.23 * sym('BSE:ITC') +
      4.20 * sym('BSE:LT') +
      3.74 * sym('BSE:TCS') +
      3.63 * sym('BSE:AXISBANK') +
      3.49 * sym('BSE:KOTAKBANK') +
      3.25 * sym('BSE:SBIN') +
      2.78 * sym('BSE:M_M') +
      2.42 * sym('BSE:BAJFINANCE') +
      2.25 * sym('BSE:HINDUNILVR') +
      2.12 * sym('BSE:SUNPHARMA') +
      1.81 * sym('BSE:NTPC') +
      1.78 * sym('BSE:HCLTECH') +
      1.74 * sym('BSE:MARUTI') +
      1.74 * sym('BSE:ETERNAL')) / 100

// @function Returns the adjusted volume for SENSEX or regular volume otherwise.
// @returns Weighted BSE volume if current symbol is SENSEX, else raw volume.
export getAdjustedVolume() =>
    syminfo.ticker == "SENSEX" ? weightedBSEVolume() : nz(volume)
