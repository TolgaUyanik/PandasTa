//@version=6
indicator('Trend & Momentum Strategy Lite', overlay = true, max_labels_count = 100, max_lines_count = 100)

// === UI Options ===
labelOffset = input.int(12, 'Vertical Label Offset', group = 'Appearance')
transparencyLevel = input.int(92, 'Background Transparency', group = 'Appearance')

// === Toggle Elements ===
showCandle = input.bool(true, 'Enable Candlestick Advisor', group = 'Candlestick Analysis')
showExtraMA = input.bool(true, 'Enable Extra Moving Average', group = 'Extra Moving Average')

// === Core Engine Settings ===
fastLen = input.int(10, 'Fast EMA Length', group = 'Core Engine')
slowLen = input.int(20, 'Slow EMA Length', group = 'Core Engine')
rsiLen = input.int(14, 'RSI Momentum Length', group = 'Core Engine')

// === Extra Moving Average Settings ===
extraMALen = input.int(50, 'Extra MA Length', group = 'Extra Moving Average')
extraMAType = input.string('EMA', 'Extra MA Type', options = ['EMA', 'SMA'], group = 'Extra Moving Average')
extraMAColor = input.color(color.yellow, 'Extra MA Color', group = 'Extra Moving Average')

// === Risk Management Settings ===
atrLen = input.int(14, 'ATR Length', group = 'Risk Management')
slMultiplier = input.float(1.8, 'SL ATR Multiplier', step = 0.1, group = 'Risk Management')
tpRatio = input.float(2.0, 'Reward Ratio', step = 0.1, group = 'Risk Management')

// === Technical Calculations ===
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsiVal = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

// حساب المتوسط المتحرك الإضافي بناءً على نوعه المختار
float extraMA = extraMAType == 'EMA' ? ta.ema(close, extraMALen) : ta.sma(close, extraMALen)

longCondition = ta.crossover(emaFast, emaSlow) and rsiVal > 52
shortCondition = ta.crossunder(emaFast, emaSlow) and rsiVal < 48

var float entryP = na
var float slP = na
var float tpP = na

if longCondition
    entryP := close
    slP := close - atr * slMultiplier
    tpP := entryP + (entryP - slP) * tpRatio

if shortCondition
    entryP := close
    slP := close + atr * slMultiplier
    tpP := entryP - (slP - entryP) * tpRatio

barcolor(emaFast > emaSlow ? color.new(#00ffbb, 0) : color.new(#ff1100, 0))

// === Plot Extra Moving Average ===
plot(showExtraMA ? extraMA : na, title = 'Extra Moving Average', color = extraMAColor, linewidth = 2)

// === Candlestick Advisor ===
isEngulfingBullish = close > open and close[1] < open[1] and showCandle
isEngulfingBearish = close < open and close[1] > open[1] and showCandle

if isEngulfingBullish and emaFast > emaSlow and barstate.isconfirmed
    label.new(bar_index, low, 'Engulfing', color=color.new(color.green, 100), textcolor=color.green, style=label.style_label_up, size=size.small)
if isEngulfingBearish and emaFast < emaSlow and barstate.isconfirmed
    label.new(bar_index, high, 'Engulfing', color=color.new(color.red, 100), textcolor=color.red, style=label.style_label_down, size=size.small)

// === Target Plots ===
p_sl = plot(slP, 'Stop Loss', color = color.new(#ff1100, 30), style = plot.style_linebr, linewidth = 1)
p_tp = plot(tpP, 'Take Profit', color = color.new(#00ffbb, 30), style = plot.style_linebr, linewidth = 1)
p_en = plot(entryP, 'Entry', color = color.new(color.white, 90), style = plot.style_linebr)

fill(p_en, p_tp, color = color.new(#00ffbb, transparencyLevel), title = 'Profit Zone')
fill(p_en, p_sl, color = color.new(#ff1100, transparencyLevel), title = 'Loss Zone')

// === Dashboard Labels ===
y_offset = atr * (labelOffset / 100)

if longCondition and barstate.isconfirmed
    label.new(bar_index, low - y_offset, text = 'BUY SIGNAL\nEntry: ' + str.tostring(entryP, '#.#####'), color = #00ffbb, style = label.style_label_up, textcolor = color.black, size = size.small)

if shortCondition and barstate.isconfirmed
    label.new(bar_index, high + y_offset, text = 'SELL SIGNAL\nEntry: ' + str.tostring(entryP, '#.#####'), color = #ff1100, style = label.style_label_down, textcolor = color.white, size = size.small)