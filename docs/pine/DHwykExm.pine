//@version=6
// =============================================================================
//  ATR POSITION SIZE & RISK MANAGER v1.0
// =============================================================================
//  Que hace: calcula el tamano de posicion para arriesgar un % fijo de la
//  cuenta con un stop basado en ATR, y dibuja entrada / SL / TP en el chart
//  con una tabla de numeros (riesgo en divisa, lotes, distancias).
//
//  Util para: prop firms (FTMO, FundedNext...) donde el daily loss es ley,
//  y para cualquier trader que dimensione por volatilidad en vez de a ojo.
//
//  Como funciona:
//   - Stop distance = ATR x multiplicador.
//   - Lotaje = (balance x riesgo%) / (distancia del SL en ticks x valor tick).
//   - El TP se dibuja a R:R configurable.
//
//  Aviso honesto: syminfo.pointvalue es una aproximacion del valor del tick
//  en la divisa de tu cuenta. En forex con divisa de cuenta distinta de la
//  contraparte del par puede desviarse unos puntos porcentuales. Verifica el
//  primer trade en demo.
//  Licencia: open source, uso libre con atribucion.
// =============================================================================

indicator("ATR Position Size & Risk Manager", shorttitle="ATR Risk", overlay=true)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
grpA = "Account"
i_balance = input.float(10000.0, "Account balance", minval=0, group=grpA)
i_riskPct = input.float(1.0, "Risk per trade (%)", minval=0.1, maxval=10.0, step=0.1, group=grpA)

grpR = "Risk model"
i_atrLen = input.int(14, "ATR length", minval=1, group=grpR)
i_atrMul = input.float(1.0, "Stop = ATR x", minval=0.1, step=0.1, group=grpR)
i_rr     = input.float(2.0, "Take profit (R:R)", minval=0.5, step=0.5, group=grpR)
i_dir    = input.string("Long", "Direction", options=["Long", "Short"], group=grpR)

grpV = "Visual"
i_showLines = input.bool(true, "Show entry/SL/TP lines", group=grpV)

// -----------------------------------------------------------------------------
// Calculo
// -----------------------------------------------------------------------------
atrVal    = ta.atr(i_atrLen)
slDist    = atrVal * i_atrMul
riskMoney = i_balance * i_riskPct / 100.0

// Valor de 1 unidad de riesgo por lote: ticks del SL x valor del tick
tickCount = slDist / syminfo.mintick
lots      = tickCount > 0 and syminfo.pointvalue > 0 ? riskMoney / (tickCount * syminfo.pointvalue) : 0.0

isLong   = i_dir == "Long"
entry    = close
slPrice  = isLong ? entry - slDist : entry + slDist
tpPrice  = isLong ? entry + slDist * i_rr : entry - slDist * i_rr

// -----------------------------------------------------------------------------
// Lineas (ultima vela)
// -----------------------------------------------------------------------------
var line entryLine = na
var line slLine    = na
var line tpLine    = na

if barstate.islast and i_showLines
    x1 = bar_index
    x2 = bar_index + 20
    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tpLine)
    entryLine := line.new(x1, entry,   x2, entry,   color=color.new(color.blue, 0),  style=line.style_solid,  width=1)
    slLine    := line.new(x1, slPrice, x2, slPrice, color=color.new(color.red, 0),   style=line.style_dashed, width=2)
    tpLine    := line.new(x1, tpPrice, x2, tpPrice, color=color.new(color.teal, 0),  style=line.style_dashed, width=2)

// -----------------------------------------------------------------------------
// Tabla resumen
// -----------------------------------------------------------------------------
var table t = table.new(position.top_right, 2, 6, border_width=1)

if barstate.islast
    bgHead = color.new(color.gray, 80)
    table.cell(t, 0, 0, "Risk $",      text_color=color.white, bgcolor=bgHead, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(riskMoney, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "Size (units)", text_color=color.white, bgcolor=bgHead, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(math.round(lots, 2)), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "SL dist",     text_color=color.white, bgcolor=bgHead, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(slDist, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "Entry",       text_color=color.white, bgcolor=bgHead, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(entry, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "SL",          text_color=color.white, bgcolor=bgHead, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(slPrice, format.mintick), text_color=color.new(color.red, 0), text_size=size.small)
    table.cell(t, 0, 5, "TP (" + str.tostring(i_rr) + "R)", text_color=color.white, bgcolor=bgHead, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(tpPrice, format.mintick), text_color=color.new(color.teal, 0), text_size=size.small)

// Plot invisible para que el escala del chart incluya SL/TP
plot(i_showLines ? slPrice : na, "SL level", display=display.none)
plot(i_showLines ? tpPrice : na, "TP level", display=display.none)
