//@version=6
indicator("Distance From High %", overlay = true)

// ─── Inputs ───────────────────────────────────────────────
grp        = "Display"
tablePos   = input.string("Top Right", "Panel position",
                 options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grp)
rightMargin = input.float(3.0, "Right margin (avoid axis labels)", minval = 0, maxval = 20, step = 0.5, group = grp)
txtColor   = input.color(color.rgb(80, 90, 105),  "Label text", group = grp)
valColor   = input.color(color.rgb(20, 20, 20),   "Value text", group = grp)
grpC       = "Vis. High color threshold"
visThresh  = input.float(25.0, "Threshold (%)", minval = 0, step = 0.5, group = grpC)
pctColor   = input.color(#ef5350, "Color at/above threshold", group = grpC)
pctColorLo = input.color(#ffeb3b, "Color below threshold",    group = grpC)
showATH    = input.bool(true, "Show ATH",          group = grp)
showVis    = input.bool(true, "Show Visible High", group = grp)

f_pos(s) =>
    s == "Top Left"     ? position.top_left     :
     s == "Bottom Right" ? position.bottom_right :
     s == "Bottom Left"  ? position.bottom_left  : position.top_right

f_pct(_pct) =>
    string arrow = _pct > 0 ? "▲ " : _pct < 0 ? "▼ " : ""
    str.format("{0}{1,number,#.##}%", arrow, math.abs(_pct))

// ─── All-time high (highest high over all loaded bars) ───
var float ath = na
ath := na(ath) ? high : math.max(ath, high)

// ─── Table: col0 label | col1 value | col2 change | col3 spacer ───
var table t = table.new(f_pos(tablePos), 4, 3)

if barstate.islast
    float price = close

    // Visible high: walk back until we exit the visible window
    int lt = chart.left_visible_bar_time
    int rt = chart.right_visible_bar_time
    float visHi = na
    for i = 0 to bar_index
        int tt = time[i]
        if tt <= rt and tt >= lt
            visHi := na(visHi) ? high[i] : math.max(visHi, high[i])
        if tt < lt
            break

    float athPct = (price - ath)   / ath   * 100.0
    float visPct = (price - visHi) / visHi * 100.0

    table.clear(t, 0, 0, 3, 2)

    int r = 0
    // Current
    table.cell(t, 0, r, "Current", text_color = txtColor, text_halign = text.align_left)
    table.cell(t, 1, r, str.format("{0,number,#.##}", price), text_color = valColor, text_halign = text.align_left)
    table.cell(t, 2, r, "", text_color = pctColor, text_halign = text.align_left)
    table.cell(t, 3, r, "", width = rightMargin)
    r += 1

    if showATH
        table.cell(t, 0, r, "ATH", text_color = txtColor, text_halign = text.align_left)
        table.cell(t, 1, r, str.format("{0,number,#.##}", ath), text_color = valColor, text_halign = text.align_left)
        table.cell(t, 2, r, f_pct(athPct), text_color = pctColor, text_halign = text.align_left)
        table.cell(t, 3, r, "", width = rightMargin)
        r += 1

    if showVis
        color visClr = math.abs(visPct) >= visThresh ? pctColor : pctColorLo
        table.cell(t, 0, r, "Visible High", text_color = txtColor, text_halign = text.align_left)
        table.cell(t, 1, r, str.format("{0,number,#.##}", visHi), text_color = valColor, text_halign = text.align_left)
        table.cell(t, 2, r, f_pct(visPct), text_color = visClr, text_halign = text.align_left)
        table.cell(t, 3, r, "", width = rightMargin)
        r += 1