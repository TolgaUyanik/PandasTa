//@version=6
indicator("SPY $1 and $5 Levels", overlay = true, max_lines_count = 500)

// Settings
levelsAboveBelow = input.int(20, "Levels Above/Below", minval = 5, maxval = 100)

thinColor  = input.color(color.new(color.gray, 40), "$1 Level Color")
thickColor = input.color(color.new(color.white, 0), "$5 Level Color")

thinWidth  = input.int(1, "$1 Line Width", minval = 1, maxval = 4)
thickWidth = input.int(3, "$5 Line Width", minval = 1, maxval = 4)

// Store lines
var line[] levelLines = array.new_line()

if barstate.islast
    // Delete old lines before redrawing
    if array.size(levelLines) > 0
        for i = 0 to array.size(levelLines) - 1
            line.delete(array.get(levelLines, i))

    array.clear(levelLines)

    // Nearest whole-dollar SPY price
    centerLevel = int(math.round(close))

    for offset = -levelsAboveBelow to levelsAboveBelow
        levelPrice = centerLevel + offset

        // 740, 745, 750, 755, etc.
        isFiveDollarLevel = levelPrice % 5 == 0

        levelLine = line.new(
             x1 = bar_index - 1,
             y1 = levelPrice,
             x2 = bar_index,
             y2 = levelPrice,
             xloc = xloc.bar_index,
             extend = extend.both,
             color = isFiveDollarLevel ? thickColor : thinColor,
             style = line.style_solid,
             width = isFiveDollarLevel ? thickWidth : thinWidth
         )

        array.push(levelLines, levelLine)