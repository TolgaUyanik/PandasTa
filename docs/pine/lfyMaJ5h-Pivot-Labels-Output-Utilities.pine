//@version=6

//@description Shared pivot label-output helpers for MYNAMEISBRANDON Pine scripts, including pivot text builders, label object managers, and live stack output helpers.

library("Pivot_Labels_Output_Utilities", true)

// this link provides code to a private script that gives basic framework for the code in this library: https://www.tradingview.com/chart/1uEXnqHO/

// ==============================================================================================
// 📚 LIBRARY MAP
// ==============================================================================================
//
// Pivot_Labels_Output_Utilities is currently organized into:
//
// • Label Size Helpers
// • Numeric Formatting Helpers
// • Static Label Plot Helpers
// • Directional Label Object Helpers
// • Local Pivot Reflow Record Helpers
// • Pivot Text Helpers
// • Early Pivot Label Helpers
// • Live Stack Text Helpers
// • Live Stack Label Object Helpers
//
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Label Size Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable label-size resolution for label-driven Pine scripts.
//
// 🧠 USER-FACING MODEL:
//     This region helps scripts:
//
//     • convert a simple UI string into the matching Pine label size
//     • reuse one consistent size resolver across:
//          confirmed pivot labels
//          local pivot labels
//          current RSI above-bar labels
//          early pivot labels
//          live stack labels
//
// 🧰 OUTPUT OPTIONS:
//     • size.tiny
//     • size.small
//     • size.normal
//     • size.large
//     • size.huge
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Label Size Resolver
// ──────────────────────────────────────────────

// @function Resolves a Pine label size from a string input
// @param sizeIn Size string. Expected values: "Tiny", "Small", "Normal", "Large", or "Huge"
// @returns Pine label size enum
export labelSizeFromString(simple string sizeIn) =>
    switch sizeIn
        "Tiny"  => size.tiny
        "Small" => size.small
        "Large" => size.large
        "Huge"  => size.huge
        => size.normal

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// import MYNAMEISBRANDON/PivotLabelsOutput_Utilities/1 as PLutils
//
// pivotLblSize = PLutils.labelSizeFromString("Normal")

// ==============================================================================================
// 🔴 END REGION: Label Size Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Numeric Formatting Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable numeric helpers for label-safe percent and compact-price
//     formatting used by pivot and live-label systems.
//
// 🧠 USER-FACING MODEL:
//     This region helps scripts:
//
//     • calculate percent change safely
//     • format percent output compactly
//     • format price values using significant-figure style abbreviations
//
// 🧰 OUTPUT OPTIONS:
//     • percent-change float
//     • label-safe percent string
//     • compact number string
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Internal Leading-Zero Trimmer
// ──────────────────────────────────────────────
_labelStripLeadingZero(string s) =>
    str.startswith(s, "0.") ? str.substring(s, 1) :
     str.startswith(s, "-0.") ? "-" + str.substring(s, 2) :
     s

// ──────────────────────────────────────────────
// 🟦 Subregion: Percent Change Resolver
// ──────────────────────────────────────────────

// @function Returns percent change from prev to curr
// @param curr Current value
// @param prev Previous reference value
// @returns Percent change or na when invalid
export labelPercentChange(
     float curr,
     float prev) =>

    na(curr) or na(prev) or prev == 0 ? na : ((curr - prev) / prev) * 100.0

// ──────────────────────────────────────────────
// 🟦 Subregion: Percent Formatter
// ──────────────────────────────────────────────

// @function Formats a percent value for compact label output
// @param p Percent value
// @returns Formatted percent string
export labelFormatPercent(float p) =>
    if na(p)
        "n/a"
    else
        float absVal =
             math.abs(p)

        string raw =
             absVal % 1 == 0 ? str.tostring(absVal, "#.") : str.tostring(absVal, "#.##")

        string trimmed =
             _labelStripLeadingZero(raw)

        (p < 0 ? "-" : "") + trimmed + "%"

// ──────────────────────────────────────────────
// 🟦 Subregion: Compact Number Formatter
// ──────────────────────────────────────────────

// @function Formats a number using significant-figure style suffix output
// @param x Value to format
// @param sig Significant figures to preserve
// @returns Compact number string
export labelFormatCompactNumber(
     float x,
     simple int sig) =>

    bool isNeg =
         x < 0

    float val =
         math.abs(x)

    float scale =
         val >= 1e9 ? 1e9 :
         val >= 1e6 ? 1e6 :
         val >= 1e3 ? 1e3 :
         1.0

    string suffix =
         scale == 1e9 ? "B" :
         scale == 1e6 ? "M" :
         scale == 1e3 ? "k" :
         ""

    float scaled =
         val / scale

    int digitsBeforeDecimal =
         scaled >= 1 ? int(math.floor(math.log10(scaled)) + 1) : 0

    int decimals =
         math.max(sig - digitsBeforeDecimal, 0)

    string hashes =
         str.repeat("#", decimals)

    string fmt =
         decimals == 0 ? "#." : "#." + hashes

    string strVal =
         str.tostring(scaled, fmt)

    (isNeg ? "-" : "") + strVal + suffix

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// float pct = PLutils.labelPercentChange(close, open)
// string pctTxt = PLutils.labelFormatPercent(pct)
// string pxTxt = PLutils.labelFormatCompactNumber(close, 4)

// ==============================================================================================
// 🔴 END REGION: Numeric Formatting Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Static Label Plot Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides one-shot label plot helpers for directional pivot labels and
//     above-bar labels.
//
// 🧠 USER-FACING MODEL:
//     This region helps scripts:
//
//     • create a confirmed or local pivot label on a specific pivot bar
//     • create a simple above-bar informational label
//
// 📎 NOTES:
//     • These helpers create labels directly
//     • They are best suited for one-time pivot labels rather than live last-bar
//       update loops
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Pivot Label Plotter
// ──────────────────────────────────────────────

// @function Creates a pivot label on a specific bar
// @param x Label x position
// @param y Label y position
// @param txt Label text
// @param textColor Label text color
// @param isHigh True for a high-side label, false for a low-side label
// @param sizeIn Label size string
// @returns Created label reference
export plotPivotLabel(
     int x,
     float y,
     string txt,
     color textColor,
     bool isHigh,
     simple string sizeIn) =>

    label.new(
         x=x,
         y=y,
         text=txt,
         textcolor=textColor,
         color=na,
         style=isHigh ? label.style_label_down : label.style_label_up,
         size=labelSizeFromString(sizeIn),
         yloc=isHigh ? yloc.abovebar : yloc.belowbar)

// ──────────────────────────────────────────────
// 🟦 Subregion: Above-Bar Label Plotter
// ──────────────────────────────────────────────

// @function Creates an above-bar informational label
// @param x Label x position
// @param y Label y position
// @param txt Label text
// @param textColor Label text color
// @param sizeIn Label size string
// @returns Created label reference
export plotAboveBarLabel(
     int x,
     float y,
     string txt,
     color textColor,
     simple string sizeIn) =>

    label.new(
         x=x,
         y=y,
         text=txt,
         textcolor=textColor,
         color=na,
         style=label.style_label_down,
         size=labelSizeFromString(sizeIn),
         yloc=yloc.abovebar)

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// newLbl = PLutils.plotPivotLabels(
//      pivotIdx,
//      pivotPrice,
//      pivotText,
//      pivotColor,
//      true,
//      "Normal")

// ==============================================================================================
// 🔴 END REGION: Static Label Plot Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Directional Label Object Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable live label-object lifecycle helpers for directional
//     high-side and low-side labels.
//
// 🧠 USER-FACING MODEL:
//     This region helps scripts:
//
//     • create a directional label when it should exist
//     • update that label in place as text or position changes
//     • delete that label when it should no longer exist
//
// 📎 NOTES:
//     • Good fit for early pivot labels or other live directional labels
//     • Uses xloc.bar_index
//     • Uses label.style_label_down / label.style_label_up based on side
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Directional Label Manager
// ──────────────────────────────────────────────

// @function Creates, updates, or deletes a directional label object
// @param lbl Existing label reference
// @param show Whether the label should exist
// @param x Label x position
// @param y Label y position
// @param txt Label text
// @param textColor Label text color
// @param isHigh True for a high-side label, false for a low-side label
// @param sizeIn Label size string
// @returns Updated label reference
export manageDirectionalLabel(
     label lbl,
     bool show,
     int x,
     float y,
     string txt,
     color textColor,
     bool isHigh,
     simple string sizeIn) =>

    label out =
         lbl

    if show
        if na(out)
            out := label.new(
                 x=x,
                 y=y,
                 text=txt,
                 xloc=xloc.bar_index,
                 yloc=isHigh ? yloc.abovebar : yloc.belowbar,
                 style=isHigh ? label.style_label_down : label.style_label_up,
                 textcolor=textColor,
                 size=labelSizeFromString(sizeIn),
                 color=na)
        else
            label.set_xy(out, x, y)
            label.set_text(out, txt)
            label.set_textcolor(out, textColor)
            label.set_style(out, isHigh ? label.style_label_down : label.style_label_up)
            label.set_size(out, labelSizeFromString(sizeIn))
            label.set_color(out, na)
            label.set_yloc(out, isHigh ? yloc.abovebar : yloc.belowbar)
    else
        if not na(out)
            label.delete(out)
            out := na

    out

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// earlyHighLbl := PLutils.manageDirectionalLabel(
//      earlyHighLbl,
//      showEarlyHigh,
//      earlyHighIdx,
//      earlyHighPrice,
//      earlyHighText,
//      earlyHighColor,
//      true,
//      "Normal")

// ==============================================================================================
// 🔴 END REGION: Directional Label Object Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Local Pivot Reflow Record Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable local-pivot record helpers for scripts that store local
//     pivot labels first, then reflow/render them later in visual pivot-index order.
//
// 🧠 USER-FACING MODEL:
//     This region helps scripts:
//
//     • track local pivot records by pivot index
//     • keep local pivot records sorted left-to-right
//     • update existing records when the same pivot index appears again
//     • prune old records outside the active tracking window
//     • delete local records near confirmed major pivots
//     • manage the label object attached to each stored local pivot record
//
// 📎 NOTES:
//     • These helpers do not detect pivots.
//     • These helpers do not decide HH / LH / HL / LL structure.
//     • These helpers do not decide final label color.
//     • Calling scripts remain responsible for their pivot engine, structure model,
//       comparison logic, and final color decisions.
//
// ==============================================================================================

// ──────────────────────────────────────────────
// 🟦 Subregion: Index Cleanup Helpers
// ──────────────────────────────────────────────

// @function Returns true when an index is within _gap bars of any stored index
// @param idxArr Array of stored bar indexes
// @param idx Candidate bar index
// @param gap Maximum allowed distance
// @returns True if candidate index is near any stored index
export localPivotIsIdxNearAny(
     array<int> idxArr,
     int idx,
     int gap) =>

    bool found =
         false

    int i =
         array.size(idxArr) - 1

    while i >= 0 and not found
        if math.abs(array.get(idxArr, i) - idx) <= gap
            found := true

        i -= 1

    found

// @function Removes stored indexes older than the minimum index to keep
// @param idxArr Array of stored bar indexes
// @param minIdxToKeep Oldest bar index allowed to remain
// @returns True after cleanup
export localPivotPruneOldStoredIdxs(
     array<int> idxArr,
     int minIdxToKeep) =>

    int i =
         array.size(idxArr) - 1

    while i >= 0
        if array.get(idxArr, i) < minIdxToKeep
            array.remove(idxArr, i)

        i -= 1

    true

// ──────────────────────────────────────────────
// 🟦 Subregion: Record Delete Helpers
// ──────────────────────────────────────────────

// @function Deletes one local pivot record at a specific array position
// @param lblArr Array of label handles
// @param idxArr Array of pivot indexes
// @param priceArr Array of pivot prices
// @param oscArr Array of pivot oscillator values
// @param lenArr Array of pivot lengths
// @param i Array position to delete
// @returns True after deletion
export localPivotDeleteRecordAt(
     array<label> lblArr,
     array<int> idxArr,
     array<float> priceArr,
     array<float> oscArr,
     array<int> lenArr,
     int i) =>

    label lbl =
         array.get(lblArr, i)

    if not na(lbl)
        label.delete(lbl)

    array.remove(lblArr, i)
    array.remove(idxArr, i)
    array.remove(priceArr, i)
    array.remove(oscArr, i)
    array.remove(lenArr, i)

    true

// @function Prunes local pivot records older than the minimum index to keep
// @param lblArr Array of label handles
// @param idxArr Array of pivot indexes
// @param priceArr Array of pivot prices
// @param oscArr Array of pivot oscillator values
// @param lenArr Array of pivot lengths
// @param minIdxToKeep Oldest pivot index allowed to remain
// @returns True after cleanup
export localPivotPruneRecords(
     array<label> lblArr,
     array<int> idxArr,
     array<float> priceArr,
     array<float> oscArr,
     array<int> lenArr,
     int minIdxToKeep) =>

    int count =
         math.min(array.size(idxArr), math.min(array.size(priceArr), math.min(array.size(oscArr), math.min(array.size(lenArr), array.size(lblArr)))))

    int i =
         count - 1

    while i >= 0
        if array.get(idxArr, i) < minIdxToKeep
            localPivotDeleteRecordAt(
                 lblArr,
                 idxArr,
                 priceArr,
                 oscArr,
                 lenArr,
                 i)

        i -= 1

    true

// @function Deletes local pivot records within _gap bars of a confirmed pivot index
// @param lblArr Array of label handles
// @param idxArr Array of pivot indexes
// @param priceArr Array of pivot prices
// @param oscArr Array of pivot oscillator values
// @param lenArr Array of pivot lengths
// @param pivotIdx Confirmed pivot index used as the collision reference
// @param gap Maximum distance from the confirmed pivot index
// @returns True after cleanup
export localPivotDeleteRecordsNear(
     array<label> lblArr,
     array<int> idxArr,
     array<float> priceArr,
     array<float> oscArr,
     array<int> lenArr,
     int pivotIdx,
     int gap) =>

    int count =
         math.min(array.size(idxArr), math.min(array.size(priceArr), math.min(array.size(oscArr), math.min(array.size(lenArr), array.size(lblArr)))))

    int i =
         count - 1

    while i >= 0
        int storedIdx =
             array.get(idxArr, i)

        if math.abs(storedIdx - pivotIdx) <= gap
            localPivotDeleteRecordAt(
                 lblArr,
                 idxArr,
                 priceArr,
                 oscArr,
                 lenArr,
                 i)

        i -= 1

    true

// ──────────────────────────────────────────────
// 🟦 Subregion: Record Upsert Helper
// ──────────────────────────────────────────────

// @function Inserts or updates a local pivot record while keeping records sorted by pivot index
// @param lblArr Array of label handles
// @param idxArr Array of pivot indexes
// @param priceArr Array of pivot prices
// @param oscArr Array of pivot oscillator values
// @param lenArr Array of pivot lengths
// @param idx Pivot index
// @param price Pivot price
// @param oscVal Pivot oscillator value
// @param pivotLen Pivot length
// @param maxRecords Maximum records allowed in the arrays
// @returns True after upsert
export localPivotUpsertRecord(
     array<label> lblArr,
     array<int> idxArr,
     array<float> priceArr,
     array<float> oscArr,
     array<int> lenArr,
     int idx,
     float price,
     float oscVal,
     int pivotLen,
     int maxRecords) =>

    bool found =
         false

    int foundAt =
         na

    int count =
         array.size(idxArr)

    int i =
         0

    while i < count and not found
        int storedIdx =
             array.get(idxArr, i)

        if storedIdx == idx
            found := true
            foundAt := i

        i += 1

    if found
        array.set(priceArr, foundAt, price)
        array.set(oscArr, foundAt, oscVal)
        array.set(lenArr, foundAt, pivotLen)
    else
        int insertAt =
             0

        bool searchingInsert =
             true

        while searchingInsert and insertAt < array.size(idxArr)
            int storedIdx =
                 array.get(idxArr, insertAt)

            if storedIdx < idx
                insertAt += 1
            else
                searchingInsert := false

        label emptyLbl =
             na

        array.insert(lblArr, insertAt, emptyLbl)
        array.insert(idxArr, insertAt, idx)
        array.insert(priceArr, insertAt, price)
        array.insert(oscArr, insertAt, oscVal)
        array.insert(lenArr, insertAt, pivotLen)

    while array.size(idxArr) > maxRecords
        localPivotDeleteRecordAt(
             lblArr,
             idxArr,
             priceArr,
             oscArr,
             lenArr,
             0)

    true

// ──────────────────────────────────────────────
// 🟦 Subregion: Major Reference Lookup Helper
// ──────────────────────────────────────────────

// @function Finds the nearest same-side major pivot reference to the left of a local pivot
// @param idxArr Array of major pivot indexes
// @param priceArr Array of major pivot prices
// @param oscArr Array of major pivot oscillator values
// @param idx Local pivot index
// @returns found flag, best index, best price, best oscillator value
export localPivotNearestMajorRefToLeft(
     array<int> idxArr,
     array<float> priceArr,
     array<float> oscArr,
     int idx) =>

    bool found =
         false

    int bestIdx =
         na

    float bestPrice =
         na

    float bestOsc =
         na

    int count =
         math.min(array.size(idxArr), math.min(array.size(priceArr), array.size(oscArr)))

    int i =
         0

    while i < count
        int candidateIdx =
             array.get(idxArr, i)

        if candidateIdx < idx and (na(bestIdx) or candidateIdx > bestIdx)
            found := true
            bestIdx := candidateIdx
            bestPrice := array.get(priceArr, i)
            bestOsc := array.get(oscArr, i)

        i += 1

    [found, bestIdx, bestPrice, bestOsc]

// ──────────────────────────────────────────────
// 🟦 Subregion: Record Label Manager
// ──────────────────────────────────────────────

// @function Creates, updates, or deletes the label attached to one local pivot record
// @param lbl Existing label handle
// @param show Whether the label should exist
// @param isHigh True for high-side label, false for low-side label
// @param idx Label x position
// @param price Label y position
// @param txt Final label text
// @param textColor Final label text color
// @param labelSize Label size string
// @returns Updated label handle
export localPivotManageRecordLabel(
     label lbl,
     bool show,
     bool isHigh,
     int idx,
     float price,
     string txt,
     color textColor,
     simple string labelSize) =>

    label out =
         lbl

    if show and not na(idx) and not na(price)
        if na(out)
            out := plotPivotLabel(
                 idx,
                 price,
                 txt,
                 textColor,
                 isHigh,
                 labelSize)
        else
            label.set_xy(out, idx, price)
            label.set_text(out, txt)
            label.set_textcolor(out, textColor)
            label.set_size(out, labelSizeFromString(labelSize))
            label.set_style(out, isHigh ? label.style_label_down : label.style_label_up)
            label.set_yloc(out, isHigh ? yloc.abovebar : yloc.belowbar)
            label.set_color(out, na)

        out
    else
        if not na(out)
            label.delete(out)

        na

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// PLutils.localPivotUpsertRecord(
//      localHighLblArr,
//      localHighIdxArr,
//      localHighPriceArr,
//      localHighRsiArr,
//      localHighLenArr,
//      localHighIdx,
//      localHighPrice,
//      localHighRsi,
//      localHighLen,
//      LOCAL_PIVOT_RECORD_MAX)
//
// localHighLbl := PLutils.localPivotManageRecordLabel(
//      localHighLbl,
//      showLocalHigh,
//      true,
//      localHighIdx,
//      localHighPrice,
//      localHighText,
//      localHighColor,
//      "Small")

// ==============================================================================================
// 🔴 END REGION: Local Pivot Reflow Record Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Pivot Text Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable text builders for pivot labels, alert messages, and the
//     current RSI / SMA above-bar label so output stays consistent across scripts.
//
// 🧠 USER-FACING MODEL:
//     This region helps scripts:
//
//     • format confirmed pivot label text
//     • format local pivot label text
//     • format confirmed pivot alert text
//     • format current RSI / SMA above-bar text
//
// 📎 NOTES:
//     • Structure resolution remains script-level
//     • Color resolution remains script-level
//     • These helpers only assemble the final text shown to the user
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Confirmed Pivot Text Builder
// ──────────────────────────────────────────────

// @function Builds confirmed pivot label text
// @param mode Label mode. Expected values: "Full" or "RSI Only"
// @param priceText Formatted pivot price
// @param priceStruct Price-side structure tag
// @param rsiText Formatted pivot RSI
// @param oscStruct RSI-side structure tag
// @param percentText Formatted percent-change text
// @param pivotLen Pivot length value
// @param showLen Whether pivot length should be shown
// @returns Confirmed pivot label text
export buildMajorPivotLabelText(
     simple string mode,
     string priceText,
     string priceStruct,
     string rsiText,
     string oscStruct,
     string percentText,
     int pivotLen,
     bool showLen) =>

    string priceLine =
         priceText + " " + priceStruct

    string rsiLine =
         rsiText + " " + oscStruct

    string lenLine =
         showLen ? "\n(" + str.tostring(pivotLen) + ")" : ""

    mode == "RSI Only"
         ? rsiLine + lenLine
         : priceLine + "\n" + rsiLine + "\n" + percentText + lenLine

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// pivotTxt = PLutils.buildMajorPivotLabelsText(
//      in_majorPivotLabelMode,
//      highPivotPriceText,
//      highPriceStruct,
//      highPivotRsiText,
//      highOscStruct,
//      highPivotPctText,
//      highPivotLen,
//      in_showMajorPivotLength)


// ──────────────────────────────────────────────
// 🟦 Subregion: Local Pivot Text Builder
// ──────────────────────────────────────────────

// @function Builds local pivot label text
// @param priceText Formatted local pivot price
// @param priceStruct Price-side structure tag
// @param rsiText Formatted local pivot RSI
// @param rsiStruct RSI-side structure tag
// @param pivotLen Pivot length value
// @param showPrice Whether the price line should be shown
// @param showLen Whether pivot length should be shown
// @returns Local pivot label text
export buildLocalPivotLabelText(
     string priceText,
     string priceStruct,
     string rsiText,
     string rsiStruct,
     int pivotLen,
     bool showPrice,
     bool showLen) =>

    string pinLine =
         "📍\n"

    string priceLine =
         showPrice ? priceText + " " + priceStruct + "\n" : ""

    string rsiLine =
         rsiText + " " + rsiStruct

    string lenLine =
         showLen ? "\n(" + str.tostring(pivotLen) + ")" : ""

    pinLine + priceLine + rsiLine + lenLine

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// localPivotTxt = PLutils.buildLocalPivotLabelsText(
//      localHighPriceText,
//      localHighPriceStruct,
//      localHighRsiText,
//      localHighRsiStruct,
//      localHighLen,
//      in_showLocalPivotPrice,
//      in_showLocalPivotLength)


// ──────────────────────────────────────────────
// 🟦 Subregion: Pivot Alert Text Builder
// ──────────────────────────────────────────────

// @function Builds confirmed pivot alert text
// @param isHigh True for a high pivot, false for a low pivot
// @param priceText Formatted pivot price
// @param pctText Formatted percent-change text
// @param rsiText Formatted pivot RSI
// @param structTag RSI-side structure tag
// @param rsiValue Raw RSI value at the pivot
// @param rsiOB Overbought level
// @param rsiOS Oversold level
// @returns Alert message text
export buildPivotAlertText(
     bool isHigh,
     string priceText,
     string pctText,
     string rsiText,
     string structTag,
     float rsiValue,
     int rsiOB,
     int rsiOS) =>

    string prefix =
         isHigh ? "📈 High Pivot Confirmed: " : "📉 Low Pivot Confirmed: "

    string condition =
         isHigh ? (rsiValue >= rsiOB ? " (RSI Overbought)" : "") :
         (rsiValue <= rsiOS ? " (RSI Oversold)" : "")

    prefix + "Price=" + priceText + ", Change=" + pctText + ", RSI=" + rsiText + " " + structTag + condition

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// highPivotAlertTxt = PLutils.buildPivotAlertText(
//      true,
//      highPivotPriceText,
//      highPivotPctText,
//      highPivotRsiText,
//      highOscStruct,
//      highPivotRsi,
//      in_rsiOverbought,
//      in_rsiOversold)


// ──────────────────────────────────────────────
// 🟦 Subregion: Current RSI Above-Bar Text Builder
// ──────────────────────────────────────────────

// @function Builds current RSI / SMA above-bar label text
// @param currRsiText Formatted current RSI text
// @param structTag Current live structure tag
// @param smaText Formatted SMA text
// @returns Current RSI above-bar label text
export buildCurrentRsiAboveBarText(
     string currRsiText,
     string structTag,
     string smaText) =>

    string line1 =
         structTag == "" ? currRsiText : currRsiText + " " + structTag

    line1 + "\n" + smaText

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// currentAboveBarTxt = PLutils.buildCurrentRsiAboveBarText(
//      currentRsiText,
//      currentRsiStruct,
//      currentRsiSmaText)

// ==============================================================================================
// 🔴 END REGION: Pivot Text Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Early Pivot Label Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable output helpers for early pivot labels.
//
// 🧠 USER-FACING MODEL:
//     This region helps scripts:
//
//     • resolve the active emoji for current-candidate vs carried-forward state
//
// 📎 NOTES:
//     • This region intentionally stops at early-label output primitives
//     • Full early-label text assembly remains script-level
//     • Structure comparisons and color resolution remain script-level
//     • This keeps the library reusable across scripts that use different
//       structure-tag and color models
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Early Pivot Emoji Resolver
// ──────────────────────────────────────────────

// @function Returns the early-pivot emoji for the active side and candidate state
// @param isHigh True for a high-side early label, false for a low-side early label
// @param isCurrentCandidateBar True when the candidate bar is the current bar
// @returns Early-pivot emoji
export earlyPivotEmoji(
     bool isHigh,
     bool isCurrentCandidateBar) =>

    isHigh ? (isCurrentCandidateBar ? "⚡" : "🚩") :
     (isCurrentCandidateBar ? "🚦" : "🚩")

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// earlyEmoji = PLutils.earlyPivotEmoji(
//      true,
//      earlyHighIdx == bar_index)

// ==============================================================================================
// 🔴 END REGION: Early Pivot Label Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Live Stack Text Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable EM-space padding, delta formatting, and center-block
//     text building for live stack labels.
//
// 🧠 USER-FACING MODEL:
//     This region helps scripts:
//
//     • build padded live-stack lines
//     • format signed delta text
//     • format move glyphs
//     • build the center live-stack block
//
// 📎 NOTES:
//     • Anchor selection and color decisions remain script-level
//     • This region focuses only on output formatting
//
// ──────────────────────────────────────────────
// 🟦 Subregion: Internal Spacer Helpers
// ──────────────────────────────────────────────
_stackSpacer(int n) =>
    str.repeat(" ", math.min(math.max(n, 0), 100))

_stackPadLine(string txt, int pad) =>
    _stackSpacer(pad) + txt

_stackAddNewlines(string txt, int linesBefore, int linesAfter) =>
    string result = ""

    for i = 0 to linesBefore - 1
        result += "\n"

    result += txt

    for i = 0 to linesAfter - 1
        result += "\n"

    result

// ──────────────────────────────────────────────
// 🟦 Subregion: Signed Round Text Resolver
// ──────────────────────────────────────────────

// @function Returns a rounded signed text value for live-stack display
// @param x Value to round
// @returns Signed rounded text
export stackSignedRoundText(float x) =>
    na(x) ? "" :
     math.round(x) > 0 ? "+" + str.tostring(math.abs(math.round(x))) :
     math.round(x) < 0 ? "-" + str.tostring(math.abs(math.round(x))) :
     "0"

// ──────────────────────────────────────────────
// 🟦 Subregion: Move Glyph Resolver
// ──────────────────────────────────────────────

// @function Returns the move glyph used by live-stack delta text
// @param delta Delta value
// @returns Move glyph
export stackMoveGlyph(float delta) =>
    na(delta) ? "" :
     delta > 0 ? "➕" :
     delta < 0 ? "➖" :
     "•"

// ──────────────────────────────────────────────
// 🟦 Subregion: Generic Delta Text Builder
// ──────────────────────────────────────────────

// @function Builds padded delta text for the live stack
// @param change Delta value
// @param structTag Structure tag to append
// @param isPercent Whether the delta should be formatted as a percent
// @param pad EM-space padding count
// @returns Padded delta text
export stackDeltaText(
     float change,
     string structTag,
     bool isPercent,
     int pad) =>

    string glyph =
         stackMoveGlyph(change)

    string structPart =
         na(structTag) or structTag == "" ? "" : " " + structTag

    string valueText =
         na(change)
         ? ""
         : isPercent
         ? labelFormatPercent(math.abs(change))
         : str.tostring(math.round(math.abs(change)))

    string base =
         na(change)
         ? (na(structTag) or structTag == "" ? "" : structTag)
         : glyph + valueText + structPart

    _stackPadLine(base, pad)

// ──────────────────────────────────────────────
// 🟦 Subregion: RSI Delta Text Builder
// ──────────────────────────────────────────────

// @function Builds padded RSI-delta text for the live stack
// @param delta RSI delta value
// @param structTag Structure tag to append
// @param pad EM-space padding count
// @returns Padded RSI-delta text
export stackRsiDiffText(
     float delta,
     string structTag,
     int pad) =>

    string glyph =
         stackMoveGlyph(delta)

    string deltaText =
         na(delta) ? "" : str.tostring(math.abs(math.round(delta)))

    string structPart =
         na(structTag) or structTag == "" ? "" : " " + structTag

    string base =
         na(delta)
         ? (na(structTag) or structTag == "" ? "" : structTag)
         : glyph + deltaText + structPart

    _stackPadLine(base, pad)

// ──────────────────────────────────────────────
// 🟦 Subregion: Center Block Text Builder
// ──────────────────────────────────────────────

// @function Builds the live-stack center block text
// @param price Current price
// @param rsiVal Current RSI value
// @param rsiDelta Current bar-to-bar RSI delta
// @param rsiSma Current RSI SMA value
// @param rsiSmaDelta Current bar-to-bar RSI SMA delta
// @param anchorTag Active anchor tag such as "➜H" or "➜L"
// @param pad EM-space padding count
// @param sigFigs Significant figures used for price formatting
// @returns Center live-stack text block
export stackCenterText(
     float price,
     float rsiVal,
     float rsiDelta,
     float rsiSma,
     float rsiSmaDelta,
     string anchorTag,
     int pad,
     simple int sigFigs) =>

    string priceText =
         labelFormatCompactNumber(price, sigFigs) + anchorTag

    string rsiText =
         "RSI " + str.tostring(math.round(rsiVal))

    string rsiDeltaText =
         na(rsiDelta) ? "" : " (" + stackSignedRoundText(rsiDelta) + ")"

    string smaText =
         na(rsiSma) ? "SMA na" : "SMA " + str.tostring(math.round(rsiSma))

    string smaDeltaText =
         na(rsiSmaDelta) ? "" : " (" + stackSignedRoundText(rsiSmaDelta) + ")"

    _stackPadLine(priceText, pad) + "\n" +
     _stackPadLine(rsiText + rsiDeltaText, pad) + "\n" +
     _stackPadLine(smaText + smaDeltaText, pad)

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// stackMidText = PLutils.stackCenterText(
//      close,
//      rsi,
//      rsi - rsi[1],
//      currentRsiSma20,
//      currentRsiSma20 - currentRsiSma20[1],
//      "➜H",
//      17,
//      4)

// ==============================================================================================
// 🔴 END REGION: Live Stack Text Helpers
// ==============================================================================================

// ==============================================================================================
// 🟢 REGION: Live Stack Label Object Helpers
// ==============================================================================================
//
// 📌 PURPOSE:
//     Provides reusable center-label lifecycle helpers for live stack labels.
//
// 🧠 USER-FACING MODEL:
//     This region helps scripts:
//
//     • create a live center-style stack label when it should exist
//     • update that label in place as text or position changes
//     • delete that label when it should no longer exist
//
// 📎 NOTES:
//     • Uses yloc.price
//     • Uses label.style_label_center
//     • Applies optional blank-line spacing before and after the text block
//

// ──────────────────────────────────────────────
// 🟦 Subregion: Center Label Manager
// ──────────────────────────────────────────────

// @function Creates, updates, or deletes a center-style live-stack label
// @param lblPrev Existing label reference
// @param show Whether the label should exist
// @param yVal Label y position
// @param txt Label text
// @param textColor Label text color
// @param xPos Label x position
// @param linesBefore Blank lines inserted before the text block
// @param linesAfter Blank lines inserted after the text block
// @param sizeIn Label size string
// @returns Updated label reference
export manageCenterLabel(
     label lblPrev,
     bool show,
     float yVal,
     string txt,
     color textColor,
     int xPos,
     int linesBefore,
     int linesAfter,
     simple string sizeIn) =>

    label lblOut =
         lblPrev

    if show
        string textWithSpacing =
             _stackAddNewlines(txt, linesBefore, linesAfter)

        if na(lblOut)
            lblOut := label.new(
                 x=xPos,
                 y=yVal,
                 text=textWithSpacing,
                 xloc=xloc.bar_index,
                 yloc=yloc.price,
                 style=label.style_label_center,
                 textcolor=textColor,
                 size=labelSizeFromString(sizeIn),
                 color=color.new(color.black, 100))
        else
            label.set_xy(lblOut, xPos, yVal)
            label.set_text(lblOut, textWithSpacing)
            label.set_textcolor(lblOut, textColor)
            label.set_size(lblOut, labelSizeFromString(sizeIn))
            label.set_color(lblOut, color.new(color.black, 100))
    else
        if not na(lblOut)
            label.delete(lblOut)
            lblOut := na

    lblOut

// ──────────────────────────────────────────────
// 🟦 Subregion: Example Usage
// ──────────────────────────────────────────────
//
// Example:
//
// stackMidLbl := PLutils.manageCenterLabel(
//      stackMidLbl,
//      showStackMid,
//      close,
//      stackMidText,
//      stackMidColor,
//      bar_index,
//      0,
//      2,
//      "Normal")

// ==============================================================================================
// 🔴 END REGION: Live Stack Label Object Helpers
// ==============================================================================================