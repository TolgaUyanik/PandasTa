//@version=5
indicator("Support/Resistance MTF Merge Zones", overlay=true, max_boxes_count=50) 

// Input Settings
lookback = input.int(10, "Lookback Period", minval=5, maxval=30)
merge_percent = input.float(0.5, "Zone Merge %", minval=0.1, maxval=2.0)
min_count = input.int(2, "Min Levels for Zone", minval=2, maxval=5)
box_opacity = input.int(7, "Box Opacity", minval=0, maxval=100)

// Colors
res_color = input.color(color.red, "Resistance")
sup_color = input.color(color.blue, "Support")
strong_color = input.color(color.orange, "Strong Zone")

// Get pivots - using lookback from input
h1_high = request.security(syminfo.tickerid, "60", ta.highest(high, lookback*2))
h1_low = request.security(syminfo.tickerid, "60", ta.lowest(low, lookback*2))

h4_high = request.security(syminfo.tickerid, "240", ta.highest(high, lookback*2))
h4_low = request.security(syminfo.tickerid, "240", ta.lowest(low, lookback*2))

d1_high = request.security(syminfo.tickerid, "D", ta.highest(high, lookback*2))
d1_low = request.security(syminfo.tickerid, "D", ta.lowest(low, lookback*2))

// Current timeframe
curr_high = ta.highest(high, lookback*2)
curr_low = ta.lowest(low, lookback*2)

// Store recent values
var float h1 = na, var float h2 = na, var float h3 = na, var float h4 = na
var float h5 = na, var float h6 = na, var float h7 = na, var float h8 = na
var float l1 = na, var float l2 = na, var float l3 = na, var float l4 = na
var float l5 = na, var float l6 = na, var float l7 = na, var float l8 = na

// Update highs when they change
if h1_high != h1_high[1]
    h8 := h7, h7 := h6, h6 := h5, h5 := h4
    h4 := h3, h3 := h2, h2 := h1, h1 := h1_high

if h4_high != h4_high[1] and h4_high != h1
    h8 := h7, h7 := h6, h6 := h5, h5 := h4
    h4 := h3, h3 := h2, h2 := h1, h1 := h4_high

if d1_high != d1_high[1] and d1_high != h1 and d1_high != h2
    h8 := h7, h7 := h6, h6 := h5, h5 := h4
    h4 := h3, h3 := h2, h2 := h1, h1 := d1_high

// Update lows when they change
if h1_low != h1_low[1]
    l8 := l7, l7 := l6, l6 := l5, l5 := l4
    l4 := l3, l3 := l2, l2 := l1, l1 := h1_low

if h4_low != h4_low[1] and h4_low != l1
    l8 := l7, l7 := l6, l6 := l5, l5 := l4
    l4 := l3, l3 := l2, l2 := l1, l1 := h4_low

if d1_low != d1_low[1] and d1_low != l1 and d1_low != l2
    l8 := l7, l7 := l6, l6 := l5, l5 := l4
    l4 := l3, l3 := l2, l2 := l1, l1 := d1_low

// Clear old boxes
var box b1 = na, var box b2 = na, var box b3 = na, var box b4 = na, var box b5 = na
box.delete(b1), box.delete(b2), box.delete(b3), box.delete(b4), box.delete(b5)

// Draw zones on last bar
if barstate.islast
    current_price = close
    
    // Check resistance zones (highs)
    if not na(h1) and not na(h2)
        diff = math.abs(h1 - h2) / h1 * 100
        if diff <= merge_percent
            top = math.max(h1, h2)
            bot = math.min(h1, h2)
            count = 2
            
            // Check h3
            if not na(h3) and math.abs(h3 - h1) / h1 * 100 <= merge_percent
                top := math.max(top, h3)
                bot := math.min(bot, h3)
                count += 1
            
            if count >= min_count
                // Determine color based on position relative to current price
                is_above = bot > current_price
                col = count >= 3 ? strong_color : (is_above ? res_color : sup_color)
                b1 := box.new(bar_index - 200, top, bar_index + 50, bot, bgcolor=color.new(col, 100 - box_opacity), border_color=color.new(col, 50), border_width=1)
    
    // Check support zones (lows)
    if not na(l1) and not na(l2)
        diff = math.abs(l1 - l2) / l1 * 100
        if diff <= merge_percent
            top = math.max(l1, l2)
            bot = math.min(l1, l2)
            count = 2
            
            // Check l3
            if not na(l3) and math.abs(l3 - l1) / l1 * 100 <= merge_percent
                top := math.max(top, l3)
                bot := math.min(bot, l3)
                count += 1
            
            if count >= min_count
                // Determine color based on position relative to current price
                is_below = top < current_price
                col = count >= 3 ? strong_color : (is_below ? sup_color : res_color)
                b2 := box.new(bar_index - 200, top, bar_index + 50, bot, bgcolor=color.new(col, 100 - box_opacity), border_color=col, border_width=2)
    
    // Additional zones with h4-h6
    if not na(h4) and not na(h5)
        diff = math.abs(h4 - h5) / h4 * 100
        if diff <= merge_percent
            top = math.max(h4, h5)
            bot = math.min(h4, h5)
            count = 2
            
            if not na(h6) and math.abs(h6 - h4) / h4 * 100 <= merge_percent
                top := math.max(top, h6)
                bot := math.min(bot, h6)
                count += 1
            
            if count >= min_count
                is_above = bot > current_price
                col = count >= 3 ? strong_color : (is_above ? res_color : sup_color)
                b3 := box.new(bar_index - 200, top, bar_index + 50, bot, bgcolor=color.new(col, 100 - box_opacity), border_color=col, border_width=2)
    
    // Additional zones with l4-l6
    if not na(l4) and not na(l5)
        diff = math.abs(l4 - l5) / l4 * 100
        if diff <= merge_percent
            top = math.max(l4, l5)
            bot = math.min(l4, l5)
            count = 2
            
            if not na(l6) and math.abs(l6 - l4) / l4 * 100 <= merge_percent
                top := math.max(top, l6)
                bot := math.min(bot, l6)
                count += 1
            
            if count >= min_count
                is_below = top < current_price
                col = count >= 3 ? strong_color : (is_below ? sup_color : res_color)
                b4 := box.new(bar_index - 200, top, bar_index + 50, bot, bgcolor=color.new(col, 100 - box_opacity), border_color=col, border_width=2)

// Show stored levels count
plotchar(not na(h1) ? 1 : 0, "Has H1", "", location.top, display = display.none)
plotchar(not na(l1) ? 1 : 0, "Has L1", "", location.bottom, display = display.none)