//@version=6
indicator("ADR vs ATR Dashboard v1.2", shorttitle="ADR-ATR", overlay=true)

//=============================================================================
// ADR vs ATR DASHBOARD v1.2
//=============================================================================

// CALCULATION INPUTS
int adrLength = input.int(20, "ADR Length", minval=2, group="Calculations")
int atrLength = input.int(14, "ATR Length", minval=1, group="Calculations")
float lowThreshold = input.float(90.0, "Lower Threshold (%)", minval=0.0, step=1.0, group="Calculations")
float highThreshold = input.float(110.0, "Upper Threshold (%)", minval=0.0, step=1.0, group="Calculations")

// LAYOUT INPUTS
string locationInput = input.string(
     "Top Right",
     "Dashboard Location",
     options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"],
     group="Dashboard Layout")

string sizeInput = input.string(
     "Normal",
     "Text Size",
     options=["Tiny", "Small", "Normal", "Large"],
     group="Dashboard Layout")

bool showDifference = input.bool(true, "Show ATR Minus ADR", group="Dashboard Layout")
bool showPercentage = input.bool(true, "Show ATR / ADR Percentage", group="Dashboard Layout")

// COLOR INPUTS
color dashboardBg = input.color(color.black, "Dashboard Background", group="Dashboard Colors")
color headerBg = input.color(color.rgb(40, 40, 40), "Header Background", group="Dashboard Colors")
color labelBg = input.color(color.rgb(18, 18, 18), "Label Background", group="Dashboard Colors")
color normalText = input.color(color.white, "Normal Text", group="Dashboard Colors")
color lowColor = input.color(color.lime, "Below ADR Color", group="Dashboard Colors")
color balancedColor = input.color(color.yellow, "Balanced Color", group="Dashboard Colors")
color highColor = input.color(color.red, "Above ADR Color", group="Dashboard Colors")
color statusText = input.color(color.black, "Status Text", group="Dashboard Colors")
color borderColor = input.color(color.gray, "Border Color", group="Dashboard Colors")

// MAP INPUTS TO PINE CONSTANTS
string dashboardPosition = switch locationInput
    "Top Left"     => position.top_left
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right
    => position.top_right

string dashboardTextSize = switch sizeInput
    "Tiny"  => size.tiny
    "Small" => size.small
    "Large" => size.large
    => size.normal

// DAILY CALCULATIONS
float dailyATR = request.security(
     syminfo.tickerid,
     "D",
     ta.atr(atrLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float dailyADR = request.security(
     syminfo.tickerid,
     "D",
     ta.sma(high[1] - low[1], adrLength),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

float atrMinusAdr = dailyATR - dailyADR
float atrAdrPct = dailyADR > 0 ? dailyATR / dailyADR * 100.0 : na

bool belowAdr = not na(atrAdrPct) and atrAdrPct < lowThreshold
bool aboveAdr = not na(atrAdrPct) and atrAdrPct > highThreshold

string condition = na(atrAdrPct) ? "No Data" : belowAdr ? "ATR Below ADR" : aboveAdr ? "ATR Above ADR" : "Balanced"
color conditionBg = na(atrAdrPct) ? color.gray : belowAdr ? lowColor : aboveAdr ? highColor : balancedColor

string atrText = na(dailyATR) ? "N/A" : str.tostring(dailyATR, format.mintick)
string adrText = na(dailyADR) ? "N/A" : str.tostring(dailyADR, format.mintick)
string differenceText = na(atrMinusAdr) ? "N/A" : str.tostring(atrMinusAdr, format.mintick)
string percentageText = na(atrAdrPct) ? "N/A" : str.tostring(atrAdrPct, "#.0") + "%"

// DASHBOARD
var table dashboard = table.new(
     dashboardPosition,
     2,
     7,
     bgcolor=dashboardBg,
     frame_color=borderColor,
     frame_width=1,
     border_color=borderColor,
     border_width=1)

if barstate.islast
    table.cell(dashboard, 0, 0, "ADR vs ATR", bgcolor=headerBg, text_color=normalText, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 0, syminfo.ticker, bgcolor=headerBg, text_color=normalText, text_size=dashboardTextSize)

    table.cell(dashboard, 0, 1, "Daily ATR (" + str.tostring(atrLength) + ")", bgcolor=labelBg, text_color=normalText, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 1, atrText, bgcolor=dashboardBg, text_color=normalText, text_size=dashboardTextSize)

    table.cell(dashboard, 0, 2, "Daily ADR (" + str.tostring(adrLength) + ")", bgcolor=labelBg, text_color=normalText, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 2, adrText, bgcolor=dashboardBg, text_color=normalText, text_size=dashboardTextSize)

    table.cell(dashboard, 0, 3, showDifference ? "ATR - ADR" : "", bgcolor=showDifference ? labelBg : dashboardBg, text_color=normalText, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 3, showDifference ? differenceText : "", bgcolor=dashboardBg, text_color=normalText, text_size=dashboardTextSize)

    table.cell(dashboard, 0, 4, showPercentage ? "ATR / ADR" : "", bgcolor=showPercentage ? labelBg : dashboardBg, text_color=normalText, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 4, showPercentage ? percentageText : "", bgcolor=showPercentage ? conditionBg : dashboardBg, text_color=showPercentage ? statusText : normalText, text_size=dashboardTextSize)

    table.cell(dashboard, 0, 5, "Condition", bgcolor=labelBg, text_color=normalText, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 5, condition, bgcolor=conditionBg, text_color=statusText, text_size=dashboardTextSize)

    table.cell(dashboard, 0, 6, "Thresholds", bgcolor=labelBg, text_color=normalText, text_size=dashboardTextSize)
    table.cell(dashboard, 1, 6, "<" + str.tostring(lowThreshold, "#") + "% / >" + str.tostring(highThreshold, "#") + "%", bgcolor=dashboardBg, text_color=normalText, text_size=dashboardTextSize)