//@version=6
indicator(title="Share Size Finder", shorttitle="TV / ATR", overlay=false)
length = input.int(title="Length", defval=14, minval=1)
smoothing = input.string(title="Smoothing", defval="RMA", options=["RMA", "SMA", "EMA", "WMA"])
target_value = input.float(defval = 100, title="Target Value ($)", minval=1)
candles = input.int(title="Return Timeframe (Candles)", defval=2, minval=1)
//input options for atr smoothing
ma_function(source, length) =>
	switch smoothing
		"RMA" => ta.rma(source, length)
		"SMA" => ta.sma(source, length)
		"EMA" => ta.ema(source, length)
		=> ta.wma(source, length)
//atr value
atr = ta.atr(length)
//target / number of candles / value calculation
result = target_value/candles/atr
	//ATR chart
	//plot(ma_function(ta.tr(true), length), title = "ATR", color=color.new(#B71C1C, 0))
//create 5x2 table
var table table1 = table.new(position.top_right,5,2,color.blue, border_width = 0)
//update cells
	//column 1
table.cell(table1, 0,0, text="Target", text_color=color.white, bgcolor=color.blue, text_size = size.small)
table.cell(table1, 0,1, str.tostring(target_value, "$##,###"), text_color=color.white, bgcolor=color.blue, text_size = size.small)
	//column 2
table.cell(table1, 1,0, text="Candles", text_color=color.white, bgcolor=color.blue, text_size = size.small)
table.cell(table1, 1,1, str.tostring(candles), text_color=color.white, bgcolor=color.blue, text_size = size.small)
	//column 3
table.cell(table1, 2,0, text="Shares", text_color=color.white, bgcolor=color.blue, text_size = size.small)
table.cell(table1, 2,1, str.tostring(result, "##,###"), text_color=color.white, bgcolor=color.blue, text_size = size.small)
	//column 4
table.cell(table1, 3,0, text="Cost", text_color=color.white, bgcolor=color.blue, text_size = size.small)
cost=close*result
cost_hl2=(high + low)/2*result
table.cell(table1, 3,1, text=str.tostring(cost, "$##,###.00"), text_color=color.white, bgcolor=color.blue, text_size = size.small)
	//column 5
table.cell(table1, 4,0, text="Exit", text_color=color.white, bgcolor=color.blue, text_size = size.small)
//exit (close)
target_price = (cost+target_value)/result
formatted_target_price = target_price < 1 ? str.tostring(target_price, "$#.0000") : str.tostring(target_price, "$##,###.00")
table.cell(table1, 4,1, text=formatted_target_price, text_color=color.white, bgcolor=color.blue, text_size = size.small)
//plot exit for candle 1/2 price
//target_price_hl2 = (cost_hl2+target_value)/result
//plot(target_price_hl2, color = color.purple)
//plot exit for candle close price
plot(target_price, color=color.purple)
