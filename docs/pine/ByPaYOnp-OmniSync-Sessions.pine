//@version=6
indicator("OmniSync Sessions", shorttitle = "OmniSync Sessions", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ────────────────────────────────────────
// SETTINGS
// ────────────────────────────────────────
asiaColor   = input.color(color.new(#e65100, 0), "Asia Color", display = display.data_window)
londonColor = input.color(color.new(#1b5e20, 0), "London Color", display = display.data_window)
nyColor     = input.color(color.new(#0c3299,  0), "NY Color", display = display.data_window)

showLive = input.bool(true, "Show Live Session Levels", group="Display Options", display = display.data_window)

futureBars = math.max(1, math.ceil(45 / timeframe.multiplier))
labelStagger = math.max(1, math.round(futureBars * 0.3)) // nudges D/W/M and 4H/1H labels right of session labels so they don't stack exactly on top of each other

asiaSession   = input.session("1800-0445", "Asia Session", display = display.data_window)
londonSession = input.session("0300-1145", "London Session", display = display.data_window)
nySession     = input.session("0930-1545", "New York Session", display = display.data_window)

maxHighs = input.int(1, "Max visible completed highs (per session)", minval=1, maxval=12, display = display.data_window)
maxLows  = input.int(1, "Max visible completed lows (per session)",  minval=1, maxval=12, display = display.data_window)

liveUpdateCompletedLines = input.bool(true, "Update Completed Session Lines in Real Time", group="Display Options", display = display.data_window)
updateLabelsLive = input.bool(false, "Also Move Labels to Current Price (can get busy)", group="Display Options", display = display.data_window)

// ── Master line toggles (per session) ──
showAsiaLines   = input.bool(true, "Show Asia Session Lines",   group="Session Lines", display = display.data_window)
showLondonLines = input.bool(true, "Show London Session Lines", group="Session Lines", display = display.data_window)
showNYLines     = input.bool(true, "Show NY Session Lines",     group="Session Lines", display = display.data_window)

// ── FVG settings ──
showAsiaFVG   = input.bool(true, "Show Asia FVG",   group="FVG", display = display.data_window)
showLondonFVG = input.bool(true, "Show London FVG", group="FVG", display = display.data_window)
showNYFVG     = input.bool(true, "Show NY FVG",     group="FVG", display = display.data_window)
fvgMitigatedTransp = input.int(85, "Mitigated FVG Transparency", minval=0, maxval=95, group="FVG", display = display.data_window)
extendFvgLive = input.bool(true, "Extend FVG Lines Live (into future)", group="FVG", display = display.data_window)
maxFvgHistory = input.int(2, "Max visible historical FVGs (per session)", minval=1, maxval=10, group="FVG", display = display.data_window)

// ── Previous D/W/M Levels settings ──
showDailyLevels   = input.bool(true, "Show Previous Day High/Low",   group="Previous D/W/M Levels", display = display.data_window)
dailyLevelColor   = input.color(color.new(#3d54f1, 0), "Daily Color", group="Previous D/W/M Levels", display = display.data_window)
showDaily50       = input.bool(true, "Show Daily 50% (EQ)",           group="Previous D/W/M Levels", display = display.data_window)

showWeeklyLevels  = input.bool(true, "Show Previous Week High/Low",   group="Previous D/W/M Levels", display = display.data_window)
weeklyLevelColor  = input.color(color.new(#6a9af4, 0), "Weekly Color", group="Previous D/W/M Levels", display = display.data_window)
showWeekly50      = input.bool(true, "Show Weekly 50% (EQ)",          group="Previous D/W/M Levels", display = display.data_window)

showMonthlyLevels = input.bool(true, "Show Previous Month High/Low",  group="Previous D/W/M Levels", display = display.data_window)
monthlyLevelColor = input.color(color.new(#f79b1e, 0), "Monthly Color", group="Previous D/W/M Levels", display = display.data_window)
showMonthly50     = input.bool(true, "Show Monthly 50% (EQ)",         group="Previous D/W/M Levels", display = display.data_window)

prevLevelsExtendLive = input.bool(true, "Extend Prev D/W/M Levels Live", group="Previous D/W/M Levels", display = display.data_window)

// ── Previous 4H / 1H Levels settings ──
show4HLevels    = input.bool(true, "Show Previous 4H High/Low", group="Intraday HTF Levels", display = display.data_window)
fourHLevelColor = input.color(color.new(#ffffff, 0), "4H Color", group="Intraday HTF Levels", display = display.data_window)
show1HLevels    = input.bool(true, "Show Previous 1H High/Low", group="Intraday HTF Levels", display = display.data_window)
oneHLevelColor  = input.color(color.new(#e02f65, 0), "1H Color", group="Intraday HTF Levels", display = display.data_window)

// ── Custom Level settings ──
showCustomLevels  = input.bool(false, "Show Custom Levels", group="Custom Levels", display = display.data_window)
customHighPrice   = input.float(0.0, "Custom High Price", group="Custom Levels", display = display.data_window)
customLowPrice    = input.float(0.0, "Custom Low Price",  group="Custom Levels", display = display.data_window)
customLevelColor  = input.color(color.new(#ffffff, 0), "Custom Level Color", group="Custom Levels", display = display.data_window)
customHighLabelTxt = input.string("Custom H", "Custom High Label", group="Custom Levels", display = display.data_window)
customLowLabelTxt  = input.string("Custom L", "Custom Low Label",  group="Custom Levels", display = display.data_window)

// ── Custom Timeframe Level settings ──
showCustomTF   = input.bool(true, "Show Previous Custom TF High/Low", group="Custom Timeframe Level", display = display.data_window)
customTF       = input.timeframe("30", "Custom Timeframe", group="Custom Timeframe Level", display = display.data_window)
customTFColor  = input.color(color.new(#ffeb3b, 0), "Custom TF Color", group="Custom Timeframe Level", display = display.data_window)

// ────────────────────────────────────────
// PER-SESSION ARRAYS — completed (previous) levels only
// Each session keeps its own pool so toggles / trimming
// never interfere with other sessions.
// ────────────────────────────────────────
var array<line>  asiaCompHighLines  = array.new<line>()
var array<label> asiaCompHighLabels = array.new<label>()
var array<line>  asiaCompLowLines   = array.new<line>()
var array<label> asiaCompLowLabels  = array.new<label>()

var array<line>  londonCompHighLines  = array.new<line>()
var array<label> londonCompHighLabels = array.new<label>()
var array<line>  londonCompLowLines   = array.new<line>()
var array<label> londonCompLowLabels  = array.new<label>()

var array<line>  nyCompHighLines  = array.new<line>()
var array<label> nyCompHighLabels = array.new<label>()
var array<line>  nyCompLowLines   = array.new<line>()
var array<label> nyCompLowLabels  = array.new<label>()

// ────────────────────────────────────────
// HELPER FUNCTIONS - Add / trim a completed level in a given session's array
// ────────────────────────────────────────
addLevel(array<line> linesArr, array<label> labelsArr, int maxCount, int barIdx, float price, color col, string txt) =>
    if not na(price)
        ln = line.new(barIdx, price, bar_index + futureBars, price, color = col, width = 1)
        lb = label.new(bar_index + futureBars, price, txt, textcolor = col, style = label.style_none, size = size.small, textalign = text.align_right)
        array.push(linesArr,  ln)
        array.push(labelsArr, lb)
        while array.size(linesArr) > maxCount
            line.delete(array.shift(linesArr))
            label.delete(array.shift(labelsArr))

clearLevels(array<line> linesArr, array<label> labelsArr) =>
    while array.size(linesArr) > 0
        line.delete(array.shift(linesArr))
        label.delete(array.shift(labelsArr))

// Hide a session's completed line/label while that same session is
// currently active (the live temp line already covers that info),
// and restore its normal color once the session ends.
hideWhileActive(array<line> linesArr, array<label> labelsArr, bool active, color col) =>
    k = 0
    while k < array.size(linesArr)
        line.set_color(array.get(linesArr, k), active ? color(na) : col)
        k += 1
    m = 0
    while m < array.size(labelsArr)
        label.set_textcolor(array.get(labelsArr, m), active ? color(na) : col)
        m += 1

// Archive the current FVG box/midline into a session's history instead of
// deleting it outright; trims to the configured max history length.
addFvgToHistory(array<box> boxArr, array<line> midArr, array<bool> bullArr, array<bool> mitArr, int maxCount, box b, line m, bool isBull, bool isMit) =>
    if not na(b)
        array.push(boxArr, b)
        array.push(midArr, m)
        array.push(bullArr, isBull)
        array.push(mitArr, isMit)
        while array.size(boxArr) > maxCount
            box.delete(array.shift(boxArr))
            line.delete(array.shift(midArr))
            array.shift(bullArr)
            array.shift(mitArr)

clearFvgHistory(array<box> boxArr, array<line> midArr, array<bool> bullArr, array<bool> mitArr) =>
    while array.size(boxArr) > 0
        box.delete(array.shift(boxArr))
        line.delete(array.shift(midArr))
        array.shift(bullArr)
        array.shift(mitArr)

// Check every not-yet-mitigated FVG in a session's history and fade it
// once price closes through it, same rule as the active FVG uses.
checkFvgHistoryMitigation(array<box> boxArr, array<bool> bullArr, array<bool> mitArr, color col, int mitTransp) =>
    n = 0
    while n < array.size(boxArr)
        if not array.get(mitArr, n)
            b = array.get(boxArr, n)
            isBull = array.get(bullArr, n)
            topPrice = box.get_top(b)
            btmPrice = box.get_bottom(b)
            if isBull and close < btmPrice
                array.set(mitArr, n, true)
                box.set_bgcolor(b, color.new(col, mitTransp))
            else if not isBull and close > topPrice
                array.set(mitArr, n, true)
                box.set_bgcolor(b, color.new(col, mitTransp))
        n += 1

// ────────────────────────────────────────
// CURRENT SESSION TRACKING + TEMPORARY LINES
// ────────────────────────────────────────
var float asiaHigh    = na
var float asiaLow     = na
var int   asiaHighBar = na
var int   asiaLowBar  = na

var float londonHigh    = na
var float londonLow     = na
var int   londonHighBar = na
var int   londonLowBar  = na

var float nyHigh    = na
var float nyLow     = na
var int   nyHighBar = na
var int   nyLowBar  = na

var line asiaHighTempLine = na
var line asiaLowTempLine  = na
var label asiaHighTempLabel = na
var label asiaLowTempLabel  = na

var line londonHighTempLine = na
var line londonLowTempLine  = na
var label londonHighTempLabel = na
var label londonLowTempLabel  = na

var line nyHighTempLine = na
var line nyLowTempLine  = na
var label nyHighTempLabel = na
var label nyLowTempLabel  = na

// ────────────────────────────────────────
// FVG PER-SESSION STATE
// ────────────────────────────────────────
var box   asiaFvgBox   = na
var line  asiaFvgMid   = na
var bool  asiaFvgFound = false
var bool  asiaFvgMit   = false
var float asiaFvgTop   = na
var float asiaFvgBtm   = na
var bool  asiaFvgBull  = false

var box   londonFvgBox   = na
var line  londonFvgMid   = na
var bool  londonFvgFound = false
var bool  londonFvgMit   = false
var float londonFvgTop   = na
var float londonFvgBtm   = na
var bool  londonFvgBull  = false

var box   nyFvgBox   = na
var line  nyFvgMid   = na
var bool  nyFvgFound = false
var bool  nyFvgMit   = false
var float nyFvgTop   = na
var float nyFvgBtm   = na
var bool  nyFvgBull  = false

var array<box>  asiaFvgHistBoxes = array.new<box>()
var array<line> asiaFvgHistMids  = array.new<line>()
var array<bool> asiaFvgHistBull  = array.new<bool>()
var array<bool> asiaFvgHistMit   = array.new<bool>()

var array<box>  londonFvgHistBoxes = array.new<box>()
var array<line> londonFvgHistMids  = array.new<line>()
var array<bool> londonFvgHistBull  = array.new<bool>()
var array<bool> londonFvgHistMit   = array.new<bool>()

var array<box>  nyFvgHistBoxes = array.new<box>()
var array<line> nyFvgHistMids  = array.new<line>()
var array<bool> nyFvgHistBull  = array.new<bool>()
var array<bool> nyFvgHistMit   = array.new<bool>()

// ────────────────────────────────────────
// PREVIOUS D/W/M LEVELS STATE
// ────────────────────────────────────────
var line  dailyHighLine  = na
var line  dailyLowLine   = na
var line  daily50Line    = na
var label dailyHighLabel = na
var label dailyLowLabel  = na
var label daily50Label   = na

var line  weeklyHighLine  = na
var line  weeklyLowLine   = na
var line  weekly50Line    = na
var label weeklyHighLabel = na
var label weeklyLowLabel  = na
var label weekly50Label   = na

var line  monthlyHighLine  = na
var line  monthlyLowLine   = na
var line  monthly50Line    = na
var label monthlyHighLabel = na
var label monthlyLowLabel  = na
var label monthly50Label   = na

// Previous (fully closed) day/week/month high & low.
// Instead of pulling this via request.security's higher-timeframe
// indirection (which was returning inconsistent, still-drifting values
// that didn't match the native Monthly chart), we track it ourselves —
// the same proven technique already used for Asia/London/NY: accumulate
// high/low bar-by-bar on the chart's own data, capture the finished
// value the moment a new period starts, then reset for the new period.
var float prevDayHigh = na
var float prevDayLow  = na
var float prevWeekHigh = na
var float prevWeekLow  = na
var float prevMonthHigh = na
var float prevMonthLow  = na

var float curDayHigh = na
var float curDayLow  = na
var float curWeekHigh = na
var float curWeekLow  = na
var float curMonthHigh = na
var float curMonthLow  = na

newDay   = ta.change(time("D")) != 0
newWeek  = ta.change(time("W")) != 0
newMonth = ta.change(time("M")) != 0

if newDay
    if not na(curDayHigh)
        prevDayHigh := curDayHigh
        prevDayLow  := curDayLow
    curDayHigh := high
    curDayLow  := low
else
    curDayHigh := na(curDayHigh) ? high : math.max(curDayHigh, high)
    curDayLow  := na(curDayLow)  ? low  : math.min(curDayLow, low)

if newWeek
    if not na(curWeekHigh)
        prevWeekHigh := curWeekHigh
        prevWeekLow  := curWeekLow
    curWeekHigh := high
    curWeekLow  := low
else
    curWeekHigh := na(curWeekHigh) ? high : math.max(curWeekHigh, high)
    curWeekLow  := na(curWeekLow)  ? low  : math.min(curWeekLow, low)

if newMonth
    if not na(curMonthHigh)
        prevMonthHigh := curMonthHigh
        prevMonthLow  := curMonthLow
    curMonthHigh := high
    curMonthLow  := low
else
    curMonthHigh := na(curMonthHigh) ? high : math.max(curMonthHigh, high)
    curMonthLow  := na(curMonthLow)  ? low  : math.min(curMonthLow, low)

// Previous 4H / 1H high-low — same self-tracking pattern as D/W/M above.
var line  fourHHighLine  = na
var line  fourHLowLine   = na
var label fourHHighLabel = na
var label fourHLowLabel  = na

var line  oneHHighLine  = na
var line  oneHLowLine   = na
var label oneHHighLabel = na
var label oneHLowLabel  = na

var float prev4HHigh = na
var float prev4HLow  = na
var float cur4HHigh  = na
var float cur4HLow   = na

var float prev1HHigh = na
var float prev1HLow  = na
var float cur1HHigh  = na
var float cur1HLow   = na

new4H = ta.change(time("240")) != 0
new1H = ta.change(time("60"))  != 0

if new4H
    if not na(cur4HHigh)
        prev4HHigh := cur4HHigh
        prev4HLow  := cur4HLow
    cur4HHigh := high
    cur4HLow  := low
else
    cur4HHigh := na(cur4HHigh) ? high : math.max(cur4HHigh, high)
    cur4HLow  := na(cur4HLow)  ? low  : math.min(cur4HLow, low)

if new1H
    if not na(cur1HHigh)
        prev1HHigh := cur1HHigh
        prev1HLow  := cur1HLow
    cur1HHigh := high
    cur1HLow  := low
else
    cur1HHigh := na(cur1HHigh) ? high : math.max(cur1HHigh, high)
    cur1HLow  := na(cur1HLow)  ? low  : math.min(cur1HLow, low)

// Previous custom-timeframe high/low — same self-tracking pattern,
// generalized to whatever timeframe the user picks in settings.
var float prevCustomTFHigh = na
var float prevCustomTFLow  = na
var float curCustomTFHigh  = na
var float curCustomTFLow   = na

newCustomTF = ta.change(time(customTF)) != 0

if newCustomTF
    if not na(curCustomTFHigh)
        prevCustomTFHigh := curCustomTFHigh
        prevCustomTFLow  := curCustomTFLow
    curCustomTFHigh := high
    curCustomTFLow  := low
else
    curCustomTFHigh := na(curCustomTFHigh) ? high : math.max(curCustomTFHigh, high)
    curCustomTFLow  := na(curCustomTFLow)  ? low  : math.min(curCustomTFLow, low)

// ────────────────────────────────────────
// SESSION DETECTION
// ────────────────────────────────────────
inAsia   = not na(time(timeframe.period, asiaSession, "America/New_York"))
inLondon = not na(time(timeframe.period, londonSession, "America/New_York"))
inNY     = not na(time(timeframe.period, nySession, "America/New_York"))

bullGap = low > high[2] and close[1] > high[2]
bearGap = high < low[2] and close[1] < low[2]

// ────────────────────────────────────────
// ASIA - current session
// ────────────────────────────────────────
if not showAsiaLines
    // Master toggle off: clear any live temp lines and completed levels for Asia
    if not na(asiaHighTempLine)
        line.delete(asiaHighTempLine)
        label.delete(asiaHighTempLabel)
        asiaHighTempLine := na
        asiaHighTempLabel := na
    if not na(asiaLowTempLine)
        line.delete(asiaLowTempLine)
        label.delete(asiaLowTempLabel)
        asiaLowTempLine := na
        asiaLowTempLabel := na
    clearLevels(asiaCompHighLines, asiaCompHighLabels)
    clearLevels(asiaCompLowLines, asiaCompLowLabels)
else
    if inAsia
        asiaHigh    := na(asiaHigh)    ? high : math.max(asiaHigh, high)
        asiaLow     := na(asiaLow)     ? low  : math.min(asiaLow, low)
        asiaHighBar := high == asiaHigh ? bar_index : asiaHighBar
        asiaLowBar  := low  == asiaLow  ? bar_index : asiaLowBar

        if showLive
            if not na(asiaHighTempLine)
                line.delete(asiaHighTempLine[1])
                label.delete(asiaHighTempLabel[1])
            asiaHighTempLine := line.new(bar_index, asiaHigh, bar_index + futureBars, asiaHigh, color=asiaColor, width=1, style=line.style_dashed)
            asiaHighTempLabel := label.new(bar_index + futureBars, asiaHigh, "Asia H (live)", textcolor=asiaColor, style=label.style_none, size=size.small, textalign=text.align_right)

            if not na(asiaLowTempLine)
                line.delete(asiaLowTempLine[1])
                label.delete(asiaLowTempLabel[1])
            asiaLowTempLine := line.new(bar_index, asiaLow, bar_index + futureBars, asiaLow, color=asiaColor, width=1, style=line.style_dashed)
            asiaLowTempLabel := label.new(bar_index + futureBars, asiaLow, "Asia L (live)", textcolor=asiaColor, style=label.style_none, size=size.small, textalign=text.align_right)

    if not inAsia and inAsia[1]
        addLevel(asiaCompHighLines, asiaCompHighLabels, maxHighs, asiaHighBar, asiaHigh, asiaColor, "Asia H")
        addLevel(asiaCompLowLines,  asiaCompLowLabels,  maxLows,  asiaLowBar,  asiaLow,  asiaColor, "Asia L")
        asiaHigh := na
        asiaLow  := na
        if not na(asiaHighTempLine)
            line.delete(asiaHighTempLine)
            label.delete(asiaHighTempLabel)
            asiaHighTempLine := na
            asiaHighTempLabel := na
        if not na(asiaLowTempLine)
            line.delete(asiaLowTempLine)
            label.delete(asiaLowTempLabel)
            asiaLowTempLine := na
            asiaLowTempLabel := na

// Asia FVG: reset "found" flag at session start so a new first FVG can be captured
if inAsia and not inAsia[1]
    asiaFvgFound := false

if not showAsiaFVG
    if not na(asiaFvgBox)
        box.delete(asiaFvgBox)
        line.delete(asiaFvgMid)
        asiaFvgBox := na
        asiaFvgMid := na
    clearFvgHistory(asiaFvgHistBoxes, asiaFvgHistMids, asiaFvgHistBull, asiaFvgHistMit)
    asiaFvgFound := false
else if inAsia and not asiaFvgFound and (bullGap or bearGap)
    addFvgToHistory(asiaFvgHistBoxes, asiaFvgHistMids, asiaFvgHistBull, asiaFvgHistMit, maxFvgHistory, asiaFvgBox, asiaFvgMid, asiaFvgBull, asiaFvgMit)
    asiaFvgBull := bullGap
    asiaFvgTop  := bullGap ? low  : low[2]
    asiaFvgBtm  := bullGap ? high[2] : high
    asiaFvgBox  := box.new(bar_index - 2, asiaFvgTop, bar_index, asiaFvgBtm, border_color = na, bgcolor = color.new(asiaColor, 70))
    asiaFvgMid  := line.new(bar_index - 2, math.avg(asiaFvgTop, asiaFvgBtm), bar_index, math.avg(asiaFvgTop, asiaFvgBtm), color = asiaColor, style = line.style_dashed, width = 1)
    asiaFvgFound := true
    asiaFvgMit   := false

if showAsiaFVG and asiaFvgFound and not na(asiaFvgBox)
    if not asiaFvgMit
        if asiaFvgBull and close < asiaFvgBtm
            asiaFvgMit := true
            asiaFvgBox.set_bgcolor(color.new(asiaColor, fvgMitigatedTransp))
        else if not asiaFvgBull and close > asiaFvgTop
            asiaFvgMit := true
            asiaFvgBox.set_bgcolor(color.new(asiaColor, fvgMitigatedTransp))
    if extendFvgLive
        asiaFvgBox.set_right(bar_index + futureBars)
        asiaFvgMid.set_x2(bar_index + futureBars)
    else if inAsia
        asiaFvgBox.set_right(bar_index)
        asiaFvgMid.set_x2(bar_index)

// ────────────────────────────────────────
// LONDON - current session
// ────────────────────────────────────────
if not showLondonLines
    if not na(londonHighTempLine)
        line.delete(londonHighTempLine)
        label.delete(londonHighTempLabel)
        londonHighTempLine := na
        londonHighTempLabel := na
    if not na(londonLowTempLine)
        line.delete(londonLowTempLine)
        label.delete(londonLowTempLabel)
        londonLowTempLine := na
        londonLowTempLabel := na
    clearLevels(londonCompHighLines, londonCompHighLabels)
    clearLevels(londonCompLowLines, londonCompLowLabels)
else
    if inLondon
        londonHigh    := na(londonHigh)    ? high : math.max(londonHigh, high)
        londonLow     := na(londonLow)     ? low  : math.min(londonLow, low)
        londonHighBar := high == londonHigh ? bar_index : londonHighBar
        londonLowBar  := low  == londonLow  ? bar_index : londonLowBar

        if showLive
            if not na(londonHighTempLine)
                line.delete(londonHighTempLine[1])
                label.delete(londonHighTempLabel[1])
            londonHighTempLine := line.new(bar_index, londonHigh, bar_index + futureBars, londonHigh, color=londonColor, width=1, style=line.style_dashed)
            londonHighTempLabel := label.new(bar_index + futureBars, londonHigh, "London H (live)", textcolor=londonColor, style=label.style_none, size=size.small, textalign=text.align_right)

            if not na(londonLowTempLine)
                line.delete(londonLowTempLine[1])
                label.delete(londonLowTempLabel[1])
            londonLowTempLine := line.new(bar_index, londonLow, bar_index + futureBars, londonLow, color=londonColor, width=1, style=line.style_dashed)
            londonLowTempLabel := label.new(bar_index + futureBars, londonLow, "London L (live)", textcolor=londonColor, style=label.style_none, size=size.small, textalign=text.align_right)

    if not inLondon and inLondon[1]
        addLevel(londonCompHighLines, londonCompHighLabels, maxHighs, londonHighBar, londonHigh, londonColor, "London H")
        addLevel(londonCompLowLines,  londonCompLowLabels,  maxLows,  londonLowBar,  londonLow,  londonColor, "London L")
        londonHigh := na
        londonLow  := na
        if not na(londonHighTempLine)
            line.delete(londonHighTempLine)
            label.delete(londonHighTempLabel)
            londonHighTempLine := na
            londonHighTempLabel := na
        if not na(londonLowTempLine)
            line.delete(londonLowTempLine)
            label.delete(londonLowTempLabel)
            londonLowTempLine := na
            londonLowTempLabel := na

// London FVG
if inLondon and not inLondon[1]
    londonFvgFound := false

if not showLondonFVG
    if not na(londonFvgBox)
        box.delete(londonFvgBox)
        line.delete(londonFvgMid)
        londonFvgBox := na
        londonFvgMid := na
    clearFvgHistory(londonFvgHistBoxes, londonFvgHistMids, londonFvgHistBull, londonFvgHistMit)
    londonFvgFound := false
else if inLondon and not londonFvgFound and (bullGap or bearGap)
    addFvgToHistory(londonFvgHistBoxes, londonFvgHistMids, londonFvgHistBull, londonFvgHistMit, maxFvgHistory, londonFvgBox, londonFvgMid, londonFvgBull, londonFvgMit)
    londonFvgBull := bullGap
    londonFvgTop  := bullGap ? low  : low[2]
    londonFvgBtm  := bullGap ? high[2] : high
    londonFvgBox  := box.new(bar_index - 2, londonFvgTop, bar_index, londonFvgBtm, border_color = na, bgcolor = color.new(londonColor, 70))
    londonFvgMid  := line.new(bar_index - 2, math.avg(londonFvgTop, londonFvgBtm), bar_index, math.avg(londonFvgTop, londonFvgBtm), color = londonColor, style = line.style_dashed, width = 1)
    londonFvgFound := true
    londonFvgMit   := false

if showLondonFVG and londonFvgFound and not na(londonFvgBox)
    if not londonFvgMit
        if londonFvgBull and close < londonFvgBtm
            londonFvgMit := true
            londonFvgBox.set_bgcolor(color.new(londonColor, fvgMitigatedTransp))
        else if not londonFvgBull and close > londonFvgTop
            londonFvgMit := true
            londonFvgBox.set_bgcolor(color.new(londonColor, fvgMitigatedTransp))
    if extendFvgLive
        londonFvgBox.set_right(bar_index + futureBars)
        londonFvgMid.set_x2(bar_index + futureBars)
    else if inLondon
        londonFvgBox.set_right(bar_index)
        londonFvgMid.set_x2(bar_index)

// ────────────────────────────────────────
// NEW YORK - current session
// ────────────────────────────────────────
if not showNYLines
    if not na(nyHighTempLine)
        line.delete(nyHighTempLine)
        label.delete(nyHighTempLabel)
        nyHighTempLine := na
        nyHighTempLabel := na
    if not na(nyLowTempLine)
        line.delete(nyLowTempLine)
        label.delete(nyLowTempLabel)
        nyLowTempLine := na
        nyLowTempLabel := na
    clearLevels(nyCompHighLines, nyCompHighLabels)
    clearLevels(nyCompLowLines, nyCompLowLabels)
else
    if inNY
        nyHigh    := na(nyHigh)    ? high : math.max(nyHigh, high)
        nyLow     := na(nyLow)     ? low  : math.min(nyLow, low)
        nyHighBar := high == nyHigh ? bar_index : nyHighBar
        nyLowBar  := low  == nyLow  ? bar_index : nyLowBar

        if showLive
            if not na(nyHighTempLine)
                line.delete(nyHighTempLine[1])
                label.delete(nyHighTempLabel[1])
            nyHighTempLine := line.new(bar_index, nyHigh, bar_index + futureBars, nyHigh, color=nyColor, width=1, style=line.style_dashed)
            nyHighTempLabel := label.new(bar_index + futureBars, nyHigh, "NY H (live)", textcolor=nyColor, style=label.style_none, size=size.small, textalign=text.align_right)

            if not na(nyLowTempLine)
                line.delete(nyLowTempLine[1])
                label.delete(nyLowTempLabel[1])
            nyLowTempLine := line.new(bar_index, nyLow, bar_index + futureBars, nyLow, color=nyColor, width=1, style=line.style_dashed)
            nyLowTempLabel := label.new(bar_index + futureBars, nyLow, "NY L (live)", textcolor=nyColor, style=label.style_none, size=size.small, textalign=text.align_right)

    if not inNY and inNY[1]
        addLevel(nyCompHighLines, nyCompHighLabels, maxHighs, nyHighBar, nyHigh, nyColor, "New York H")
        addLevel(nyCompLowLines,  nyCompLowLabels,  maxLows,  nyLowBar,  nyLow,  nyColor, "New York L")
        nyHigh := na
        nyLow  := na
        if not na(nyHighTempLine)
            line.delete(nyHighTempLine)
            label.delete(nyHighTempLabel)
            nyHighTempLine := na
            nyHighTempLabel := na
        if not na(nyLowTempLine)
            line.delete(nyLowTempLine)
            label.delete(nyLowTempLabel)
            nyLowTempLine := na
            nyLowTempLabel := na

// NY FVG
if inNY and not inNY[1]
    nyFvgFound := false

if not showNYFVG
    if not na(nyFvgBox)
        box.delete(nyFvgBox)
        line.delete(nyFvgMid)
        nyFvgBox := na
        nyFvgMid := na
    clearFvgHistory(nyFvgHistBoxes, nyFvgHistMids, nyFvgHistBull, nyFvgHistMit)
    nyFvgFound := false
else if inNY and not nyFvgFound and (bullGap or bearGap)
    addFvgToHistory(nyFvgHistBoxes, nyFvgHistMids, nyFvgHistBull, nyFvgHistMit, maxFvgHistory, nyFvgBox, nyFvgMid, nyFvgBull, nyFvgMit)
    nyFvgBull := bullGap
    nyFvgTop  := bullGap ? low  : low[2]
    nyFvgBtm  := bullGap ? high[2] : high
    nyFvgBox  := box.new(bar_index - 2, nyFvgTop, bar_index, nyFvgBtm, border_color = na, bgcolor = color.new(nyColor, 70))
    nyFvgMid  := line.new(bar_index - 2, math.avg(nyFvgTop, nyFvgBtm), bar_index, math.avg(nyFvgTop, nyFvgBtm), color = nyColor, style = line.style_dashed, width = 1)
    nyFvgFound := true
    nyFvgMit   := false

if showNYFVG and nyFvgFound and not na(nyFvgBox)
    if not nyFvgMit
        if nyFvgBull and close < nyFvgBtm
            nyFvgMit := true
            nyFvgBox.set_bgcolor(color.new(nyColor, fvgMitigatedTransp))
        else if not nyFvgBull and close > nyFvgTop
            nyFvgMit := true
            nyFvgBox.set_bgcolor(color.new(nyColor, fvgMitigatedTransp))
    if extendFvgLive
        nyFvgBox.set_right(bar_index + futureBars)
        nyFvgMid.set_x2(bar_index + futureBars)
    else if inNY
        nyFvgBox.set_right(bar_index)
        nyFvgMid.set_x2(bar_index)

// ────────────────────────────────────────
// PREVIOUS DAY HIGH/LOW
// ────────────────────────────────────────
if not showDailyLevels
    if not na(dailyHighLine)
        line.delete(dailyHighLine)
        label.delete(dailyHighLabel)
        line.delete(dailyLowLine)
        label.delete(dailyLowLabel)
        dailyHighLine := na
        dailyHighLabel := na
        dailyLowLine := na
        dailyLowLabel := na
    if not na(daily50Line)
        line.delete(daily50Line)
        label.delete(daily50Label)
        daily50Line := na
        daily50Label := na
else
    if newDay
        if not na(dailyHighLine)
            line.delete(dailyHighLine)
            label.delete(dailyHighLabel)
            line.delete(dailyLowLine)
            label.delete(dailyLowLabel)
        dailyHighLine  := line.new(bar_index, prevDayHigh, bar_index, prevDayHigh, color = dailyLevelColor, width = 1)
        dailyHighLabel := label.new(bar_index, prevDayHigh, "PDH", textcolor = dailyLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)
        dailyLowLine   := line.new(bar_index, prevDayLow, bar_index, prevDayLow, color = dailyLevelColor, width = 1)
        dailyLowLabel  := label.new(bar_index, prevDayLow, "PDL", textcolor = dailyLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)
        if not na(daily50Line)
            line.delete(daily50Line)
            label.delete(daily50Label)
            daily50Line := na
            daily50Label := na
        if showDaily50
            eqPrice = math.avg(prevDayHigh, prevDayLow)
            daily50Line  := line.new(bar_index, eqPrice, bar_index, eqPrice, color = color.new(dailyLevelColor, 50), style = line.style_dashed, width = 1)
            daily50Label := label.new(bar_index, eqPrice, "PD-EQ", textcolor = dailyLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)

    if not na(dailyHighLine)
        dailyRightEdge = prevLevelsExtendLive ? bar_index + futureBars : bar_index
        dailyHighLine.set_x2(dailyRightEdge)
        dailyHighLabel.set_x(dailyRightEdge + labelStagger)
        dailyLowLine.set_x2(dailyRightEdge)
        dailyLowLabel.set_x(dailyRightEdge + labelStagger)
        if showDaily50 and not na(daily50Line)
            daily50Line.set_x2(dailyRightEdge)
            daily50Label.set_x(dailyRightEdge + labelStagger)

// ────────────────────────────────────────
// PREVIOUS WEEK HIGH/LOW
// ────────────────────────────────────────
if not showWeeklyLevels
    if not na(weeklyHighLine)
        line.delete(weeklyHighLine)
        label.delete(weeklyHighLabel)
        line.delete(weeklyLowLine)
        label.delete(weeklyLowLabel)
        weeklyHighLine := na
        weeklyHighLabel := na
        weeklyLowLine := na
        weeklyLowLabel := na
    if not na(weekly50Line)
        line.delete(weekly50Line)
        label.delete(weekly50Label)
        weekly50Line := na
        weekly50Label := na
else
    if newWeek
        if not na(weeklyHighLine)
            line.delete(weeklyHighLine)
            label.delete(weeklyHighLabel)
            line.delete(weeklyLowLine)
            label.delete(weeklyLowLabel)
        weeklyHighLine  := line.new(bar_index, prevWeekHigh, bar_index, prevWeekHigh, color = weeklyLevelColor, width = 1)
        weeklyHighLabel := label.new(bar_index, prevWeekHigh, "PWH", textcolor = weeklyLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)
        weeklyLowLine   := line.new(bar_index, prevWeekLow, bar_index, prevWeekLow, color = weeklyLevelColor, width = 1)
        weeklyLowLabel  := label.new(bar_index, prevWeekLow, "PWL", textcolor = weeklyLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)
        if not na(weekly50Line)
            line.delete(weekly50Line)
            label.delete(weekly50Label)
            weekly50Line := na
            weekly50Label := na
        if showWeekly50
            eqPriceW = math.avg(prevWeekHigh, prevWeekLow)
            weekly50Line  := line.new(bar_index, eqPriceW, bar_index, eqPriceW, color = color.new(weeklyLevelColor, 50), style = line.style_dashed, width = 1)
            weekly50Label := label.new(bar_index, eqPriceW, "PW-EQ", textcolor = weeklyLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)

    if not na(weeklyHighLine)
        weeklyRightEdge = prevLevelsExtendLive ? bar_index + futureBars : bar_index
        weeklyHighLine.set_x2(weeklyRightEdge)
        weeklyHighLabel.set_x(weeklyRightEdge + labelStagger)
        weeklyLowLine.set_x2(weeklyRightEdge)
        weeklyLowLabel.set_x(weeklyRightEdge + labelStagger)
        if showWeekly50 and not na(weekly50Line)
            weekly50Line.set_x2(weeklyRightEdge)
            weekly50Label.set_x(weeklyRightEdge + labelStagger)

// ────────────────────────────────────────
// PREVIOUS MONTH HIGH/LOW
// ────────────────────────────────────────
if not showMonthlyLevels
    if not na(monthlyHighLine)
        line.delete(monthlyHighLine)
        label.delete(monthlyHighLabel)
        line.delete(monthlyLowLine)
        label.delete(monthlyLowLabel)
        monthlyHighLine := na
        monthlyHighLabel := na
        monthlyLowLine := na
        monthlyLowLabel := na
    if not na(monthly50Line)
        line.delete(monthly50Line)
        label.delete(monthly50Label)
        monthly50Line := na
        monthly50Label := na
else
    if newMonth
        if not na(monthlyHighLine)
            line.delete(monthlyHighLine)
            label.delete(monthlyHighLabel)
            line.delete(monthlyLowLine)
            label.delete(monthlyLowLabel)
        monthlyHighLine  := line.new(bar_index, prevMonthHigh, bar_index, prevMonthHigh, color = monthlyLevelColor, width = 1)
        monthlyHighLabel := label.new(bar_index, prevMonthHigh, "PMH", textcolor = monthlyLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)
        monthlyLowLine   := line.new(bar_index, prevMonthLow, bar_index, prevMonthLow, color = monthlyLevelColor, width = 1)
        monthlyLowLabel  := label.new(bar_index, prevMonthLow, "PML", textcolor = monthlyLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)
        if not na(monthly50Line)
            line.delete(monthly50Line)
            label.delete(monthly50Label)
            monthly50Line := na
            monthly50Label := na
        if showMonthly50
            eqPriceM = math.avg(prevMonthHigh, prevMonthLow)
            monthly50Line  := line.new(bar_index, eqPriceM, bar_index, eqPriceM, color = color.new(monthlyLevelColor, 50), style = line.style_dashed, width = 1)
            monthly50Label := label.new(bar_index, eqPriceM, "PM-EQ", textcolor = monthlyLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)

    if not na(monthlyHighLine)
        monthlyRightEdge = prevLevelsExtendLive ? bar_index + futureBars : bar_index
        monthlyHighLine.set_x2(monthlyRightEdge)
        monthlyHighLabel.set_x(monthlyRightEdge + labelStagger)
        monthlyLowLine.set_x2(monthlyRightEdge)
        monthlyLowLabel.set_x(monthlyRightEdge + labelStagger)
        if showMonthly50 and not na(monthly50Line)
            monthly50Line.set_x2(monthlyRightEdge)
            monthly50Label.set_x(monthlyRightEdge + labelStagger)

// ────────────────────────────────────────
// PREVIOUS 4H HIGH/LOW
// ────────────────────────────────────────
if not show4HLevels
    if not na(fourHHighLine)
        line.delete(fourHHighLine)
        label.delete(fourHHighLabel)
        line.delete(fourHLowLine)
        label.delete(fourHLowLabel)
        fourHHighLine := na
        fourHHighLabel := na
        fourHLowLine := na
        fourHLowLabel := na
else
    if new4H
        if not na(fourHHighLine)
            line.delete(fourHHighLine)
            label.delete(fourHHighLabel)
            line.delete(fourHLowLine)
            label.delete(fourHLowLabel)
        fourHHighLine  := line.new(bar_index, prev4HHigh, bar_index, prev4HHigh, color = fourHLevelColor, width = 1)
        fourHHighLabel := label.new(bar_index, prev4HHigh, "P4H-H", textcolor = fourHLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)
        fourHLowLine   := line.new(bar_index, prev4HLow, bar_index, prev4HLow, color = fourHLevelColor, width = 1)
        fourHLowLabel  := label.new(bar_index, prev4HLow, "P4H-L", textcolor = fourHLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)

    if not na(fourHHighLine)
        fourHRightEdge = prevLevelsExtendLive ? bar_index + futureBars : bar_index
        fourHHighLine.set_x2(fourHRightEdge)
        fourHHighLabel.set_x(fourHRightEdge + labelStagger * 2)
        fourHLowLine.set_x2(fourHRightEdge)
        fourHLowLabel.set_x(fourHRightEdge + labelStagger * 2)

// ────────────────────────────────────────
// PREVIOUS 1H HIGH/LOW
// ────────────────────────────────────────
if not show1HLevels
    if not na(oneHHighLine)
        line.delete(oneHHighLine)
        label.delete(oneHHighLabel)
        line.delete(oneHLowLine)
        label.delete(oneHLowLabel)
        oneHHighLine := na
        oneHHighLabel := na
        oneHLowLine := na
        oneHLowLabel := na
else
    if new1H
        if not na(oneHHighLine)
            line.delete(oneHHighLine)
            label.delete(oneHHighLabel)
            line.delete(oneHLowLine)
            label.delete(oneHLowLabel)
        oneHHighLine  := line.new(bar_index, prev1HHigh, bar_index, prev1HHigh, color = oneHLevelColor, width = 1)
        oneHHighLabel := label.new(bar_index, prev1HHigh, "P1H-H", textcolor = oneHLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)
        oneHLowLine   := line.new(bar_index, prev1HLow, bar_index, prev1HLow, color = oneHLevelColor, width = 1)
        oneHLowLabel  := label.new(bar_index, prev1HLow, "P1H-L", textcolor = oneHLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)

    if not na(oneHHighLine)
        oneHRightEdge = prevLevelsExtendLive ? bar_index + futureBars : bar_index
        oneHHighLine.set_x2(oneHRightEdge)
        oneHHighLabel.set_x(oneHRightEdge + labelStagger * 3)
        oneHLowLine.set_x2(oneHRightEdge)
        oneHLowLabel.set_x(oneHRightEdge + labelStagger * 3)

// ────────────────────────────────────────
// CUSTOM HIGH/LOW LEVEL
// Manually-set price levels, independent toggle/color.
// ────────────────────────────────────────
var line  customHighLine  = na
var line  customLowLine   = na
var label customHighLabel = na
var label customLowLabel  = na

if not showCustomLevels
    if not na(customHighLine)
        line.delete(customHighLine)
        label.delete(customHighLabel)
        line.delete(customLowLine)
        label.delete(customLowLabel)
        customHighLine := na
        customHighLabel := na
        customLowLine := na
        customLowLabel := na
else
    if na(customHighLine)
        customHighLine  := line.new(bar_index, customHighPrice, bar_index, customHighPrice, color = customLevelColor, width = 1)
        customHighLabel := label.new(bar_index, customHighPrice, customHighLabelTxt, textcolor = customLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)
        customLowLine   := line.new(bar_index, customLowPrice, bar_index, customLowPrice, color = customLevelColor, width = 1)
        customLowLabel  := label.new(bar_index, customLowPrice, customLowLabelTxt, textcolor = customLevelColor, style = label.style_none, size = size.small, textalign = text.align_right)

    // Keep the price in sync if the input is edited after creation
    customHighLine.set_y1(customHighPrice)
    customHighLine.set_y2(customHighPrice)
    customHighLabel.set_y(customHighPrice)
    customLowLine.set_y1(customLowPrice)
    customLowLine.set_y2(customLowPrice)
    customLowLabel.set_y(customLowPrice)

    customRightEdge = prevLevelsExtendLive ? bar_index + futureBars : bar_index
    customHighLine.set_x2(customRightEdge)
    customHighLabel.set_x(customRightEdge + labelStagger * 4)
    customLowLine.set_x2(customRightEdge)
    customLowLabel.set_x(customRightEdge + labelStagger * 4)

// ────────────────────────────────────────
// PREVIOUS CUSTOM TIMEFRAME HIGH/LOW
// ────────────────────────────────────────
var line  customTFHighLine  = na
var line  customTFLowLine   = na
var label customTFHighLabel = na
var label customTFLowLabel  = na

customTFHighTxt = "P" + customTF + "-H"
customTFLowTxt  = "P" + customTF + "-L"

if not showCustomTF
    if not na(customTFHighLine)
        line.delete(customTFHighLine)
        label.delete(customTFHighLabel)
        line.delete(customTFLowLine)
        label.delete(customTFLowLabel)
        customTFHighLine := na
        customTFHighLabel := na
        customTFLowLine := na
        customTFLowLabel := na
else
    if newCustomTF
        if not na(customTFHighLine)
            line.delete(customTFHighLine)
            label.delete(customTFHighLabel)
            line.delete(customTFLowLine)
            label.delete(customTFLowLabel)
        customTFHighLine  := line.new(bar_index, prevCustomTFHigh, bar_index, prevCustomTFHigh, color = customTFColor, width = 1)
        customTFHighLabel := label.new(bar_index, prevCustomTFHigh, customTFHighTxt, textcolor = customTFColor, style = label.style_none, size = size.small, textalign = text.align_right)
        customTFLowLine   := line.new(bar_index, prevCustomTFLow, bar_index, prevCustomTFLow, color = customTFColor, width = 1)
        customTFLowLabel  := label.new(bar_index, prevCustomTFLow, customTFLowTxt, textcolor = customTFColor, style = label.style_none, size = size.small, textalign = text.align_right)

    if not na(customTFHighLine)
        customTFRightEdge = prevLevelsExtendLive ? bar_index + futureBars : bar_index
        customTFHighLine.set_x2(customTFRightEdge)
        customTFHighLabel.set_x(customTFRightEdge + labelStagger * 5)
        customTFLowLine.set_x2(customTFRightEdge)
        customTFLowLabel.set_x(customTFRightEdge + labelStagger * 5)

// ────────────────────────────────────────
// CHECK MITIGATION ON ARCHIVED (HISTORICAL) FVGs
// ────────────────────────────────────────
checkFvgHistoryMitigation(asiaFvgHistBoxes, asiaFvgHistBull, asiaFvgHistMit, asiaColor, fvgMitigatedTransp)
checkFvgHistoryMitigation(londonFvgHistBoxes, londonFvgHistBull, londonFvgHistMit, londonColor, fvgMitigatedTransp)
checkFvgHistoryMitigation(nyFvgHistBoxes, nyFvgHistBull, nyFvgHistMit, nyColor, fvgMitigatedTransp)

// ────────────────────────────────────────
// HIDE EACH SESSION'S COMPLETED LINE WHILE THAT SAME
// SESSION IS CURRENTLY ACTIVE (avoids redundant clutter
// with the live temp line during that session)
// ────────────────────────────────────────
hideWhileActive(asiaCompHighLines, asiaCompHighLabels, inAsia, asiaColor)
hideWhileActive(asiaCompLowLines, asiaCompLowLabels, inAsia, asiaColor)
hideWhileActive(londonCompHighLines, londonCompHighLabels, inLondon, londonColor)
hideWhileActive(londonCompLowLines, londonCompLowLabels, inLondon, londonColor)
hideWhileActive(nyCompHighLines, nyCompHighLabels, inNY, nyColor)
hideWhileActive(nyCompLowLines, nyCompLowLabels, inNY, nyColor)

// ────────────────────────────────────────
// LIVE-UPDATE COMPLETED SESSION H/L LINES
// ────────────────────────────────────────
if liveUpdateCompletedLines
    i0 = 0
    while i0 < array.size(asiaCompHighLines)
        line.set_x2(array.get(asiaCompHighLines, i0), bar_index)
        i0 += 1
    i1 = 0
    while i1 < array.size(asiaCompLowLines)
        line.set_x2(array.get(asiaCompLowLines, i1), bar_index)
        i1 += 1
    i2 = 0
    while i2 < array.size(londonCompHighLines)
        line.set_x2(array.get(londonCompHighLines, i2), bar_index)
        i2 += 1
    i3 = 0
    while i3 < array.size(londonCompLowLines)
        line.set_x2(array.get(londonCompLowLines, i3), bar_index)
        i3 += 1
    i4 = 0
    while i4 < array.size(nyCompHighLines)
        line.set_x2(array.get(nyCompHighLines, i4), bar_index)
        i4 += 1
    i5 = 0
    while i5 < array.size(nyCompLowLines)
        line.set_x2(array.get(nyCompLowLines, i5), bar_index)
        i5 += 1

if updateLabelsLive
    j0 = 0
    while j0 < array.size(asiaCompHighLabels)
        label.set_x(array.get(asiaCompHighLabels, j0), bar_index)
        j0 += 1
    j1 = 0
    while j1 < array.size(asiaCompLowLabels)
        label.set_x(array.get(asiaCompLowLabels, j1), bar_index)
        j1 += 1
    j2 = 0
    while j2 < array.size(londonCompHighLabels)
        label.set_x(array.get(londonCompHighLabels, j2), bar_index)
        j2 += 1
    j3 = 0
    while j3 < array.size(londonCompLowLabels)
        label.set_x(array.get(londonCompLowLabels, j3), bar_index)
        j3 += 1
    j4 = 0
    while j4 < array.size(nyCompHighLabels)
        label.set_x(array.get(nyCompHighLabels, j4), bar_index)
        j4 += 1
    j5 = 0
    while j5 < array.size(nyCompLowLabels)
        label.set_x(array.get(nyCompLowLabels, j5), bar_index)
        j5 += 1
