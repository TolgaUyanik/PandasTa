//@version=6
// ╔════════════════════════════════════════════════════════════════════╗
// ║                     CRS by TQ — Pro (v1.3)                         ║
// ║                     © 2025 tradequo                                 ║
// ║  Comparative Relative Strength (CRS) indicator for professionals.  ║
// ║  • Benchmark-relative momentum tracking                            ║
// ║  • Dual MA structure:                                              ║
// ║       – MA1 active in all modes (core bias filter)                 ║
// ║       – MA2 auto-derived (Chart Start only)                        ║
// ║  • Supports Chart Start & daily session anchoring (US/EU/Asia)     ║
// ╚════════════════════════════════════════════════════════════════════╝

indicator("CRS by TQ — Pro", shorttitle="CRS by TQ — Pro", overlay=false, max_bars_back=5000)

// === General ===
benchSym = input.symbol("ES1!", "Benchmark (click to search)", confirm=true, tooltip="Opens TradingView symbol search.", group="General")
showSessionMarks = input.bool(true, "Show session anchor markers", group="General")
useFill = input.bool(true, "Fill between CRS and MA1", group="General")

// === Sessions ===
sessionMode = input.string("Chart Start (no daily reset)", "Active Session Anchor",
     options=["Chart Start (no daily reset)","US (New York)","Europe (London)","Asia (Tokyo)"],
     tooltip="Chart Start = anchor at first visible bar (no daily reset). Other modes reset CRS each day at the session open.",
     group="Sessions")
usWin   = input.session("0930-1600", "US (New York) Window", group="Sessions")
euWin   = input.session("0800-1630", "Europe (London) Window", group="Sessions")
asiaWin = input.session("0900-1500", "Asia (Tokyo) Window", group="Sessions")

// === CRS Moving Averages (lines & colors) ===
crsMaType1   = input.string("WMA", "CRS MA1 Type", options=["SMA","EMA","WMA","RMA"], group="CRS Moving Averages")
crsMaLength1 = input.int(65, "CRS MA1 Length", minval=1, group="CRS Moving Averages")
ma1Color     = input.color(color.rgb(180,180,180), "CRS MA1 Color", group="CRS Moving Averages")

// MA2 auto-derived from timeframe/session normalization logic
autoDays = input.int(5, "CRS MA2 base days (N)", minval=1, group="CRS Moving Averages",
     tooltip="Auto-derived length = days × session-minutes ÷ timeframe-minutes (intraday). On Daily+ optionally uses N directly.")
autoSessionMinutes = input.int(390, "CRS MA2 session minutes/day", minval=1, group="CRS Moving Averages", tooltip="US RTH = 390; 24 h = 1440.")
autoRoundMode = input.string("Round", "CRS MA2 rounding", options=["Round","Ceil","Floor"], group="CRS Moving Averages", tooltip="How minutes→bars are rounded on odd timeframes.")
autoUseDaysOnHTF = input.bool(true, "CRS MA2: use N bars directly on Daily+", group="CRS Moving Averages")
crsMaType2 = input.string("EMA", "CRS MA2 Type", options=["SMA","EMA","WMA","RMA"],
     tooltip="Length is auto-derived from a normalized day-length formula (also available as a separate indicator).",
     group="CRS Moving Averages")
ma2Color   = input.color(color.new(color.rgb(28,77,112), 40), "CRS MA2 Color", group="CRS Moving Averages")

// CRS line bias colors (+ fill opacity)
upColor   = input.color(color.rgb(42,111,158), "CRS Up Color (#2a6f9e)", group="CRS Moving Averages")
downColor = input.color(color.rgb(78,67,57),  "CRS Down Color (#4e4339)", group="CRS Moving Averages")
fillAlpha = input.int(85, "Fill opacity (0–100)", minval=0, maxval=100, group="CRS Moving Averages")

// === Benchmark (same TF) ===
benchClose = request.security(benchSym, timeframe.period, close)

// === Session masks ===
inSessUS_ms = time(timeframe.period, usWin, "America/New_York")
inSessEU_ms = time(timeframe.period, euWin, "Europe/London")
inSessAS_ms = time(timeframe.period, asiaWin, "Asia/Tokyo")
inSess_ms = sessionMode == "US (New York)" ? inSessUS_ms : sessionMode == "Europe (London)" ? inSessEU_ms : sessionMode == "Asia (Tokyo)" ? inSessAS_ms : na
isSessionAnchored = sessionMode != "Chart Start (no daily reset)"
inSess     = isSessionAnchored ? not na(inSess_ms) : false
prevInSess = isSessionAnchored ? not na(inSess_ms[1]) : false
sessOpen   = isSessionAnchored and inSess and not prevInSess

// === Base anchors ===
var float baseCur_chart = na
var float baseBench_chart = na
if not isSessionAnchored
    if na(baseCur_chart) and not na(close)
        baseCur_chart := close
    if na(baseBench_chart) and not na(benchClose)
        baseBench_chart := benchClose

var float baseCur_sess = na
var float baseBench_sess = na
if isSessionAnchored
    if na(baseCur_sess) or sessOpen
        baseCur_sess := close
        baseBench_sess := benchClose

baseCur   = isSessionAnchored ? baseCur_sess   : baseCur_chart
baseBench = isSessionAnchored ? baseBench_sess : baseBench_chart

// === CRS Calculation ===
ready       = not na(baseCur) and not na(baseBench) and baseCur != 0 and baseBench != 0
ratioCur    = ready ? close / baseCur : na
ratioBench  = ready ? benchClose / baseBench : na
crs         = ready and ratioBench != 0 ? ((ratioCur / ratioBench) - 1.0) * 100.0 : na

// === Helper functions ===
ma(src,len,type) => type=="EMA" ? ta.ema(src,len) : type=="WMA" ? ta.wma(src,len) : type=="RMA" ? ta.rma(src,len) : ta.sma(src,len)
auto_round(x) => autoRoundMode=="Ceil" ? math.ceil(x) : autoRoundMode=="Floor" ? math.floor(x) : math.round(x)

// === CRS MA1 (always active) & MA2 (Chart Start only) ===
crsMA1 = ma(crs, crsMaLength1, crsMaType1)
tfSec  = timeframe.in_seconds(timeframe.period)
tfMin  = math.max(tfSec / 60.0, 1.0/60.0)
isIntra = timeframe.isintraday
autoLenFloat = (autoDays * autoSessionMinutes) / tfMin
autoLenBars  = isIntra ? int(math.max(1, auto_round(autoLenFloat))) : (autoUseDaysOnHTF ? autoDays : int(math.max(1, auto_round(autoLenFloat))))
crsMA2 = not isSessionAnchored ? ma(crs, autoLenBars, crsMaType2) : na

// === Plots ===
lineUp = upColor
lineDn = downColor
pCRS   = plot(crs, title="CRS (%)", linewidth=2, color=na(crsMA1) or na(crs) ? lineUp : (crs >= crsMA1 ? lineUp : lineDn))
pMA1   = plot(crsMA1, title="CRS MA1", linewidth=2, color=ma1Color)
pMA2   = plot(crsMA2, title="CRS MA2 (auto-derived, Chart Start only)", linewidth=2, color=not isSessionAnchored ? ma2Color : na)
fillColor = (not useFill or na(crs) or na(crsMA1)) ? na : (crs >= crsMA1 ? color.new(lineUp, fillAlpha) : color.new(lineDn, fillAlpha))
fill(pCRS, pMA1, color=isSessionAnchored ? color.new(fillColor, 0) : fillColor)

// === Alerts ===
alertcondition(ta.crossover(crs, crsMA1), "CRS crosses above MA1", "CRS > MA1 (Bullish RS shift)")
alertcondition(ta.crossunder(crs, crsMA1), "CRS crosses below MA1", "CRS < MA1 (Bearish RS shift)")
alertcondition(not isSessionAnchored and ta.crossover(crs, crsMA2), "CRS crosses above MA2", "CRS > MA2 (Bullish RS shift)")
alertcondition(not isSessionAnchored and ta.crossunder(crs, crsMA2), "CRS crosses below MA2", "CRS < MA2 (Bearish RS shift)")
alertcondition(not isSessionAnchored and ta.crossover(crsMA1, crsMA2), "MA1 crosses above MA2", "CRS MA1 > CRS MA2 (Bullish bias)")
alertcondition(not isSessionAnchored and ta.crossunder(crsMA1, crsMA2), "MA1 crosses below MA2", "CRS MA1 < CRS MA2 (Bearish bias)")

// === Session markers ===
var label sessLbl = na
if showSessionMarks and isSessionAnchored and sessOpen
    yVal = na(crs) ? 0 : crs
    tag = sessionMode == "US (New York)" ? "NY ⏱" : sessionMode == "Europe (London)" ? "EU ⏱" : "AS ⏱"
    sessLbl := label.new(bar_index, yVal, tag, style=label.style_label_down, textcolor=color.white, color=color.new(color.black, 85))

// === Benchmark label (top-right corner) ===
var table benchTR = table.new(position.top_right, 1, 1, frame_color=color.new(color.black,70), frame_width=1)
if barstate.islast
    txt = "Benchmark: " + benchSym + (not isSessionAnchored ? "\nMA2 len ≈ " + str.tostring(autoLenBars) : "\nSession mode: MA2 hidden, MA1 active")
    table.cell(benchTR, 0, 0, txt, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black,75))
