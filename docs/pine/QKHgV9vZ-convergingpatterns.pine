//@version=6

// @description Library having implementation of converging chart patterns
library('convergingpatterns', overlay = true)

import Trendoscope/ZigzagLite/3 as zg
import Trendoscope/LineWrapper/2 as wr
import Trendoscope/ohlc/3 as o
import Trendoscope/abstractchartpatterns/10 as p

// @type Object containing properties for pattern scanning
// @field baseProperties Object of Base Scan Properties
// @field convergingDistanceMultiplier when multiplied with pattern size gets the max number of bars within which the pattern should converge 
export type ScanProperties
	p.ScanProperties baseProperties
	float convergingDistanceMultiplier = 1.0


// @function Returns pattern name based on type
// @param patternType integer value representing pattern type
// @returns string name of the pattern
export getPatternNameByType(int patternType) =>
    switch patternType
        1 => 'Rising Wedge (Contracting)'
        2 => 'Falling Wedge (Contracting)'
        3 => 'Converging Triangle'
        4 => 'Descending Triangle (Contracting)'
        5 => 'Ascending Triangle (Contracting)'
        => 'Error'

method check(p.Pattern this, ScanProperties properties) =>
    firstIndex = this.points.first().index
    lastIndex = this.points.last().index
    firstTime = this.points.first().time
    lastTime = this.points.last().time
    this.trendLine1.p1 := chart.point.new(firstTime, firstIndex, this.trendLine1.get_price(firstIndex))
    this.trendLine1.p2 := chart.point.new(lastTime, lastIndex, this.trendLine1.get_price(lastIndex))

    this.trendLine2.p1 := chart.point.new(firstTime, firstIndex, this.trendLine2.get_price(firstIndex))
    this.trendLine2.p2 := chart.point.new(lastTime, lastIndex, this.trendLine2.get_price(lastIndex))

    for [i, point] in this.points
        currentTrendLine = i % 2 == 1 ? properties.baseProperties.numberOfPivots == 6 ? this.trendLine1 : this.trendLine2 : properties.baseProperties.numberOfPivots == 6 ? this.trendLine2 : this.trendLine1
        point.price := currentTrendLine.get_price(point.index)
        point.price

    startDiff = math.abs(this.trendLine1.p1.price - this.trendLine2.p1.price)
    endDiff = math.abs(this.trendLine1.p2.price - this.trendLine2.p2.price)
    bars = this.trendLine1.p2.index - this.trendLine1.p1.index

    rateOfConverge = (startDiff - endDiff) / bars
    numberOfBarsToConverge = endDiff / rateOfConverge

    isConverging = numberOfBarsToConverge > 0 and numberOfBarsToConverge < bars * properties.convergingDistanceMultiplier
    isConverging

method resolvePatternName(p.Pattern this, ScanProperties properties) =>
    t1p1 = this.trendLine1.p1.price
    t1p2 = this.trendLine1.p2.price
    t2p1 = this.trendLine2.p1.price
    t2p2 = this.trendLine2.p2.price

    upperAngle = t1p1 > t2p1 ? (t1p2 - math.min(t2p1, t2p2)) / (t1p1 - math.min(t2p1, t2p2)) : (t2p2 - math.min(t1p1, t1p2)) / (t2p1 - math.min(t1p1, t1p2))
    lowerAngle = t1p1 > t2p1 ? (t2p2 - math.max(t1p1, t1p2)) / (t2p1 - math.max(t1p1, t1p2)) : (t1p2 - math.max(t2p1, t2p2)) / (t1p1 - math.max(t2p1, t2p2))

    upperLineDir = upperAngle > 1 + properties.baseProperties.flatRatio ? 1 : upperAngle < 1 - properties.baseProperties.flatRatio ? -1 : 0
    lowerLineDir = lowerAngle > 1 + properties.baseProperties.flatRatio ? -1 : lowerAngle < 1 - properties.baseProperties.flatRatio ? 1 : 0

    invalid = math.sign(t1p1 - t2p1) != math.sign(t1p2 - t2p2)
    this.patternType := invalid ? 0 : upperLineDir > 0 and lowerLineDir > 0 ? 1 : upperLineDir < 0 and lowerLineDir < 0 ? 2 : upperLineDir < 0 and lowerLineDir > 0 ? 3 : lowerLineDir == 0 ? upperLineDir < 0 ? 4 : -1 : upperLineDir == 0 ? lowerLineDir > 0 ? 5 : -2 : -3
    if this.patternType < 0
        log.info('Wrong Type detected {0}, Dirs : {1}, {2}, Invalid : {7}, Prices: {3}, {4}, {5}. {6}', this.patternType, upperLineDir, lowerLineDir, t1p1, t1p2, t2p1, t2p2, invalid)
        this.patternType := 0
        this.patternType
    this

method find(array<chart.point> points, ScanProperties sProperties, p.DrawingProperties dProperties, array<o.OHLC> ohlcArray = na) =>
    properties = sProperties.baseProperties
    validPattern = properties.numberOfPivots == 6 ? p.checkBarRatio(points.get(1), points.get(3), points.get(5), properties) and p.checkBarRatio(points.get(0), points.get(2), points.get(4), properties) : p.checkBarRatio(points.get(0), points.get(2), points.get(4), properties) and properties.filters.checkSize(points)
    p.Pattern currentPattern = na
    if validPattern
        validPattern := false
        trendPointArray1 = array.from(points.get(0), points.get(2), points.get(4))
        trendPointArray2 = properties.numberOfPivots == 6 ? array.from(points.get(1), points.get(3), points.get(5)) : array.from(points.get(1), points.get(3))

        firstIndex = points.first().index
        lastIndex = points.last().index
        firstDirection = points.get(0).price > points.get(1).price ? 1 : -1
        [valid1, trendLine1] = trendPointArray1.inspect(firstIndex, lastIndex, math.sign(firstDirection), ohlcArray)
        [valid2, trendLine2] = trendPointArray2.inspect(firstIndex, lastIndex, math.sign(-firstDirection), ohlcArray)
        if valid1 and valid2
            lastDir = points.last().price > points.get(points.size() - 2).price ? 1 : -1
            currentPattern := p.Pattern.new(lastDir, points, trendLine1, trendLine2, dProperties)
            isConverging = currentPattern.check(sProperties)

            if isConverging
                currentPattern.resolvePatternName(sProperties)
                allowedLastPivotDirection = na(properties.allowedLastPivotDirections) ? 0 : properties.allowedLastPivotDirections.size() <= currentPattern.patternType ? 0 : properties.allowedLastPivotDirections.get(currentPattern.patternType)

                allowedPattern = (na(properties.allowedPatterns) ? true : properties.allowedPatterns.size() <= currentPattern.patternType ? false : currentPattern.patternType > 0 ? properties.allowedPatterns.get(currentPattern.patternType) : false) and (allowedLastPivotDirection == 0 or allowedLastPivotDirection == lastDir)
                if allowedPattern
                    validPattern := true
                    if na(properties.themeColors)
                        properties.themeColors := array.from(color.blue)
                        properties.themeColors

                    if properties.themeColors.size() == 0
                        properties.themeColors.push(color.blue)

                    patternColor = properties.themeColors.shift()
                    properties.themeColors.push(patternColor)
                    ratioDiff = properties.numberOfPivots == 6 ? p.getRatioDiff(points.get(1), points.get(3), points.get(5)) : p.getRatioDiff(points.get(0), points.get(2), points.get(4))
                    currentPattern.patternColor := patternColor
                    currentPattern.ratioDiff := ratioDiff
                    currentPattern.trendLine1.color := patternColor
                    currentPattern.trendLine2.color := patternColor

                    currentPattern.trendLine1.width := dProperties.patternLineWidth
                    currentPattern.trendLine2.width := dProperties.patternLineWidth

                    currentPattern.patternName := getPatternNameByType(currentPattern.patternType)
                    currentPattern.patternName
    [validPattern, currentPattern]

// @function find converging patterns for given zigzag
// @param this Current zigzag Object
// @param sProperties ScanProperties Object
// @param dProperties DrawingProperties Object
// @param patterns array of existing patterns to check for duplicates
// @param ohlcArray array of OHLC values for historical reference
// @returns string name of the pattern
export method find(zg.Zigzag this, ScanProperties sProperties, p.DrawingProperties dProperties, array<p.Pattern> patterns = na, array<o.OHLC> ohlcArray = na) =>
    properties = sProperties.baseProperties
    p6 = this.zigzagPivots.get(0 + properties.offset).point.copy()
    p5 = this.zigzagPivots.get(1 + properties.offset).point.copy()
    p4 = this.zigzagPivots.get(2 + properties.offset).point.copy()
    p3 = this.zigzagPivots.get(3 + properties.offset).point.copy()
    p2 = this.zigzagPivots.get(4 + properties.offset).point.copy()
    p1 = properties.numberOfPivots == 6 ? this.zigzagPivots.get(5 + properties.offset).point.copy() : na

    p.Pattern currentPattern = na
    array<chart.point> points = properties.numberOfPivots == 6 ? array.from(p1, p2, p3, p4, p5, p6) : array.from(p2, p3, p4, p5, p6)
    ignorePattern = false
    existingPattern = false

    for [index, pattern] in patterns
        startBar = pattern.points.first().index
        endBar = pattern.points.last().index
        currentStartBar = points.first().index
        currentLastBar = points.last().index

        if currentStartBar > startBar and currentStartBar < endBar and properties.avoidOverlap
            ignorePattern := true
            break
        match = true
        for i = 0 to properties.numberOfPivots - 2 by 1
            cp = points.get(i)
            ep = pattern.points.get(i)
            if cp.index != ep.index
                match := false
                break
        if match
            existingPattern := true
            existingPattern

    validPattern = not(ignorePattern or existingPattern)
    if validPattern
        [valid, pattern] = points.find(sProperties, dProperties, ohlcArray)
        validPattern := valid
        currentPattern := pattern
        currentPattern

    [validPattern, currentPattern]
