// =============================================================================
// SMC v18 ALERT - NQ Scalper (Entries-Only Indicator)
//
// BASE: SMC v17 Alert indicator.
//
// CHANGES vs v17:
//   - Thursday skip REMOVED. Indicator now trades Mon-Fri.
//     (skipDay forced to false - was: estDay == dayofweek.thursday)
//   - Everything else identical to v17.
//
// ALERT SETUP:
//   1. Create Alert -> Condition: "SMC v18 Alert - Entries Only"
//   2. Webhook URL: your Cloudflare tunnel + /webhook
//   3. Expiration: Open-ended, Frequency: Once per bar close
//   4. The alert() message auto-replaces the Message field
//
// SIGNALS (entries only):
//   Long entry  -> {"event":"entry","side":"long"}
//   Short entry -> {"event":"entry","side":"short"}
//
// TRADOVATE: ATM ON, TP=60 ticks, SL=100 ticks, qty=1 mini, Shift+B/Shift+S
// =============================================================================

//@version=6
indicator("SMC v18 Alert - Entries Only", overlay=true, max_bars_back=500)

// Inputs
grpTrend   = "Trend"
fastLen    = input.int(9,     "Fast EMA",     group=grpTrend, minval=3)
trendLen   = input.int(21,    "Trend EMA",    group=grpTrend, minval=10)
macroLen   = input.int(50,    "Macro EMA",    group=grpTrend, minval=30)

grpExit    = "TP / SL (virtual - for dashboard)"
tpTicks    = input.int(60,    "Take Profit (ticks)",  group=grpExit, minval=10)
slTicks    = input.int(100,   "Stop Loss (ticks)",    group=grpExit, minval=10)
coolBars   = input.int(2,     "Cooldown Bars",        group=grpExit, minval=0)
streakMax  = input.int(3,     "Max Consecutive Losses", group=grpExit, minval=1, maxval=5)
streakPause= input.int(12,    "Pause After Streak",   group=grpExit, minval=1, maxval=30)

grpFilter  = "Filters"
minBody    = input.int(30,    "Min Candle Body %",    group=grpFilter, minval=10, maxval=80)
volLen     = input.int(20,    "Volume SMA Length",    group=grpFilter, minval=5)
volMult    = input.float(0.8, "Volume Multiplier",    group=grpFilter, minval=0.3, step=0.1)
rsiLen     = input.int(14,    "RSI Length",           group=grpFilter, minval=2)
rsiOB      = input.int(75,    "RSI Overbought",       group=grpFilter, minval=55, maxval=90)
rsiOS      = input.int(25,    "RSI Oversold",         group=grpFilter, minval=10, maxval=45)

grpRisk    = "Risk"
useDailyCap = input.bool(true, "Daily Loss Cap",      group=grpRisk)
dailyCapUSD = input.float(1000,"Max Daily Loss ($)",  group=grpRisk, minval=100, maxval=5000, step=100)
lastEntryH  = input.int(14,    "Last Entry Hour",     group=grpRisk, minval=9, maxval=16)
forceCloseH = input.int(15,    "Force Close Hour",    group=grpRisk, minval=12, maxval=16)
forceCloseM = input.int(45,    "Force Close Min",     group=grpRisk, minval=0, maxval=59)

grpSession = "Session"
useSessionFilt = input.bool(true, "Skip Lunch Chop",  group=grpSession)

// Calculations
tickVal    = syminfo.mintick
tpPoints   = tpTicks * tickVal
slPoints   = slTicks * tickVal
tickDollar = syminfo.pointvalue * syminfo.mintick

fastEma  = ta.ema(close, fastLen)
trendEma = ta.ema(close, trendLen)
macroEma = ta.ema(close, macroLen)
rsiVal   = ta.rsi(close, rsiLen)
vwapVal  = ta.vwap(hlc3)

volSma = ta.sma(volume, volLen)
volOk  = volume >= volSma * volMult

// Time
estH    = hour(time, "America/New_York")
estM    = minute(time, "America/New_York")
estTime = estH * 100 + estM

estDay      = dayofweek(time, "America/New_York")
skipHour    = estH == 4 or estH == 6 or estH == 7
skipDay     = false
entryTimeOk = estTime < lastEntryH * 100 and not skipHour and not skipDay
forceCloseTime = forceCloseH * 100 + forceCloseM

inLunchChop = estH == 12
sessionOk   = not useSessionFilt or not inLunchChop

// EMA stack + quality
emaStackLong  = fastEma > trendEma and trendEma > macroEma
emaStackShort = fastEma < trendEma and trendEma < macroEma

candleRange = high - low
candleBody  = math.abs(close - open)
bodyPctVal  = candleRange > 0 ? (candleBody / candleRange) * 100.0 : 0.0

bullCandle = close > open and bodyPctVal >= minBody
bearCandle = close < open and bodyPctVal >= minBody

rsiLongOk  = rsiVal < rsiOB
rsiShortOk = rsiVal > rsiOS

vwapLongOk  = close > vwapVal
vwapShortOk = close < vwapVal

priceAboveTrend = close > trendEma
priceBelowTrend = close < trendEma

momActiveLong  = close > close[1]
momActiveShort = close < close[1]

prevBarBull = close[1] > open[1]
prevBarBear = close[1] < open[1]

emaPullLong  = low <= fastEma and close > fastEma and bullCandle
emaPullShort = high >= fastEma and close < fastEma and bearCandle

// Signal conditions
longSignal = barstate.isconfirmed and emaStackLong and emaPullLong and vwapLongOk and momActiveLong and prevBarBull and priceAboveTrend and volOk and rsiLongOk and entryTimeOk and sessionOk

shortSignal = barstate.isconfirmed and emaStackShort and emaPullShort and vwapShortOk and momActiveShort and prevBarBear and priceBelowTrend and volOk and rsiShortOk and entryTimeOk and sessionOk

// Virtual position state (used for visuals + Day P&L tracking only)
var int   posDir          = 0
var float virtualEntry    = na
var float tpLevel         = na
var float slLevel         = na
var int   barsSinceExit   = 999
var int   lossStreak      = 0
var int   barsSinceStreak = 999
var int   barsInTrade     = 0
var float dailyPnL        = 0.0
var int   lastTradeDay    = 0
var bool  streakDayStop   = false
var bool  showLongEntry   = false
var bool  showShortEntry  = false
var bool  showExit        = false

if barstate.isconfirmed
    showLongEntry  := false
    showShortEntry := false
    showExit       := false

    // Daily reset
    tradeDay = dayofmonth(time, "America/New_York") * 100 + month(time, "America/New_York")
    if tradeDay != lastTradeDay
        dailyPnL      := 0.0
        lastTradeDay  := tradeDay
        streakDayStop := false
        lossStreak    := 0   // BUGFIX: was carried over; a day ending on losses
                             // would inherit the count and trip the streak-pause
                             // early. Each day now gets a fresh 3-loss budget.

    barsSinceExit   += 1
    barsSinceStreak += 1
    if posDir != 0
        barsInTrade += 1

    // Virtual exit detection (NO ALERT - bot's ATM handles real exits)
    if posDir != 0
        tpHit  = false
        slHit  = false
        eodHit = estTime >= forceCloseTime

        if posDir == 1
            tpHit := high >= tpLevel
            slHit := low  <= slLevel
        else
            tpHit := low  <= tpLevel
            slHit := high >= slLevel

        if tpHit or slHit or eodHit
            float tradePnL = 0.0
            if tpHit and not slHit
                tradePnL := tpTicks * tickDollar - 5.0
            else if slHit
                tradePnL := -(slTicks * tickDollar) - 5.0
            else
                tradePnL := (close - virtualEntry) * syminfo.pointvalue * posDir - 5.0

            dailyPnL += tradePnL
            if tradePnL < 0
                lossStreak += 1
                if lossStreak >= streakMax
                    barsSinceStreak := 0
                    streakDayStop   := true
            else
                lossStreak := 0

            // EXIT ALERT REMOVED - Tradovate ATM handles exits locally
            // alert(exitAction, alert.freq_all)  <-- intentionally deleted

            posDir        := 0
            virtualEntry  := na
            tpLevel       := na
            slLevel       := na
            barsSinceExit := 0
            barsInTrade   := 0
            showExit      := true

    dailyCapOk_now = (not useDailyCap) or dailyPnL > -dailyCapUSD
    streakOk_now   = (lossStreak < streakMax or barsSinceStreak >= streakPause) and not streakDayStop
    canTrade_now   = barsSinceExit >= coolBars and streakOk_now and posDir == 0 and dailyCapOk_now

    // Entry alerts ONLY
    if longSignal and canTrade_now
        posDir       := 1
        virtualEntry := close
        tpLevel      := close + tpPoints
        slLevel      := close - slPoints
        barsInTrade  := 0
        showLongEntry := true
        alert('{"event":"entry","side":"long"}', alert.freq_all)

    else if shortSignal and canTrade_now
        posDir       := -1
        virtualEntry := close
        tpLevel      := close - tpPoints
        slLevel      := close + slPoints
        barsInTrade  := 0
        showShortEntry := true
        alert('{"event":"entry","side":"short"}', alert.freq_all)

// Plots
plot(fastEma,  "9 EMA",  color=color.new(color.aqua, 0),   linewidth=1)
plot(trendEma, "21 EMA", color=color.new(color.white, 0),  linewidth=2)
plot(macroEma, "50 EMA", color=color.new(color.orange, 0), linewidth=2)
plot(vwapVal,  "VWAP",   color=color.new(color.yellow, 20), linewidth=1)

tpLine = posDir != 0 ? tpLevel : na
slLine = posDir != 0 ? slLevel : na
plot(tpLine, "TP", color=color.green, style=plot.style_linebr, linewidth=2)
plot(slLine, "SL", color=color.red,   style=plot.style_linebr, linewidth=2)

plotshape(showLongEntry and barstate.isconfirmed, style=shape.triangleup,
     location=location.belowbar, color=color.new(color.green, 0), size=size.small, title="Long Entry")
plotshape(showShortEntry and barstate.isconfirmed, style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 0), size=size.small, title="Short Entry")
plotshape(showExit and barstate.isconfirmed, style=shape.xcross,
     location=location.abovebar, color=color.new(color.yellow, 0), size=size.tiny, title="Virtual Exit")

bgcolor(inLunchChop and useSessionFilt ? color.new(color.red, 95) : na)

// Dashboard
var table panel = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(panel, 0, 0, "MODE", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 0, "ENTRIES ONLY", text_color=color.lime, text_size=size.small)

    table.cell(panel, 0, 1, "STACK", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 1, emaStackLong ? "BULL" : emaStackShort ? "BEAR" : "NONE",
         text_color=emaStackLong ? color.green : emaStackShort ? color.red : color.gray, text_size=size.small)

    table.cell(panel, 0, 2, "RSI", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 2, str.tostring(rsiVal, "#.0"), text_color=color.white, text_size=size.small)

    table.cell(panel, 0, 3, "POS (virtual)", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 3, posDir == 1 ? "LONG" : posDir == -1 ? "SHORT" : "FLAT",
         text_color=posDir == 1 ? color.green : posDir == -1 ? color.red : color.gray, text_size=size.small)

    table.cell(panel, 0, 4, "DAY P&L", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 4, "$" + str.tostring(dailyPnL, "#.00"),
         text_color=dailyPnL >= 0 ? color.green : color.red, text_size=size.small)

    table.cell(panel, 0, 5, "STREAK", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 5, streakDayStop ? "STOP" : lossStreak > 0 ? str.tostring(lossStreak) + "L" : "OK",
         text_color=streakDayStop ? color.red : lossStreak > 0 ? color.orange : color.green, text_size=size.small)

    table.cell(panel, 0, 6, "SESSION", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 6, inLunchChop ? "LUNCH" : "ACTIVE",
         text_color=inLunchChop ? color.red : color.green, text_size=size.small)

    table.cell(panel, 0, 7, "TARGET", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 7, "$" + str.tostring(tpTicks * 5, "#") + " / -$" + str.tostring(slTicks * 5, "#"),
         text_color=color.yellow, text_size=size.small)
