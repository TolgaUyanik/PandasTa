//@version=5
strategy("GrowWithCare FINAL 5S MASTER STRATEGY", overlay=true, pyramiding=0, initial_capital=100000)

//====================================================
// INPUTS
//====================================================

emaLen = input.int(48, title="EMA Length")

tradeQty = input.float(1.0, title="Trade Quantity")

// TIMEFRAMES
microTF = input.timeframe("5S", title="5S TF")
oneMinTF = input.timeframe("1", title="1M TF")

fastTF = input.timeframe("15S", title="15S TF")
entryTF = input.timeframe("5", title="5M TF")

trendTF = input.timeframe("15", title="15M TF")

// SL TIMEFRAMES
slTF1 = input.timeframe("5", title="5M SL")
slTF2 = input.timeframe("15", title="15M SL")
slTF3 = input.timeframe("60", title="1H SL")
slTF4 = input.timeframe("240", title="4H SL")
slTF5 = input.timeframe("D", title="1D SL")

// FILTERS
useADX = input.bool(true, title="Use ADX")
adxLen = input.int(14, title="ADX Length")
adxLevel = input.float(20.0, title="ADX Level")

useCompression = input.bool(true, title="Use Compression")
compressionATR = input.float(0.30, title="Compression ATR")

manualHold = input.bool(false, title="Manual Trend Hold")

manualSLStage = input.string("AUTO", title="Manual SL Stage", options=["AUTO","5M","15M","1H","4H","1D"])

//====================================================
// EMA VALUES
//====================================================

// 5S
microHighEMA = request.security(syminfo.tickerid, microTF, ta.ema(high, emaLen))
microLowEMA = request.security(syminfo.tickerid, microTF, ta.ema(low, emaLen))

// 1M
oneMinHighEMA = request.security(syminfo.tickerid, oneMinTF, ta.ema(high, emaLen))
oneMinLowEMA = request.security(syminfo.tickerid, oneMinTF, ta.ema(low, emaLen))

// 15S
fastHighEMA = request.security(syminfo.tickerid, fastTF, ta.ema(high, emaLen))
fastLowEMA = request.security(syminfo.tickerid, fastTF, ta.ema(low, emaLen))

// 5M
entryHighEMA = request.security(syminfo.tickerid, entryTF, ta.ema(high, emaLen))
entryLowEMA = request.security(syminfo.tickerid, entryTF, ta.ema(low, emaLen))

// 15M
trendHighEMA = request.security(syminfo.tickerid, trendTF, ta.ema(high, emaLen))
trendLowEMA = request.security(syminfo.tickerid, trendTF, ta.ema(low, emaLen))

// SL STRUCTURE
slHigh1 = request.security(syminfo.tickerid, slTF1, ta.ema(high, emaLen))
slLow1 = request.security(syminfo.tickerid, slTF1, ta.ema(low, emaLen))

slHigh2 = request.security(syminfo.tickerid, slTF2, ta.ema(high, emaLen))
slLow2 = request.security(syminfo.tickerid, slTF2, ta.ema(low, emaLen))

slHigh3 = request.security(syminfo.tickerid, slTF3, ta.ema(high, emaLen))
slLow3 = request.security(syminfo.tickerid, slTF3, ta.ema(low, emaLen))

slHigh4 = request.security(syminfo.tickerid, slTF4, ta.ema(high, emaLen))
slLow4 = request.security(syminfo.tickerid, slTF4, ta.ema(low, emaLen))

slHigh5 = request.security(syminfo.tickerid, slTF5, ta.ema(high, emaLen))
slLow5 = request.security(syminfo.tickerid, slTF5, ta.ema(low, emaLen))

//====================================================
// ATR
//====================================================

atrValue = ta.atr(14)

//====================================================
// COMPRESSION FILTER
//====================================================

emaDistance = math.abs(fastHighEMA - entryHighEMA)

compressionFilter = emaDistance > (atrValue * compressionATR)

//====================================================
// ADX
//====================================================

[diplus, diminus, adxValue] = ta.dmi(adxLen, adxLen)

adxFilter = adxValue > adxLevel

//====================================================
// MICRO TREND
//====================================================

microBull = microHighEMA > oneMinHighEMA
microBear = microLowEMA < oneMinLowEMA

//====================================================
// FAST TREND
//====================================================

fastBull = fastHighEMA > entryHighEMA
fastBear = fastLowEMA < entryLowEMA

//====================================================
// DOUBLE CONFIRMATION
//====================================================

doubleBull = microBull and fastBull

doubleBear = microBear and fastBear

//====================================================
// BUY SELL SIGNALS
//====================================================

buyCross = ta.crossover(fastHighEMA, entryHighEMA)

sellCross = ta.crossunder(fastLowEMA, entryLowEMA)

buyTrend = close > trendHighEMA

sellTrend = close < trendLowEMA

buySignal = buyCross and buyTrend and doubleBull and (useADX ? adxFilter : true) and (useCompression ? compressionFilter : true)

sellSignal = sellCross and sellTrend and doubleBear and (useADX ? adxFilter : true) and (useCompression ? compressionFilter : true)

//====================================================
// TREND STRUCTURE
//====================================================

above1M = close > oneMinHighEMA
below1M = close < oneMinLowEMA

above5M = close > slHigh1
below5M = close < slLow1

above15M = close > slHigh2
below15M = close < slLow2

above1H = close > slHigh3
below1H = close < slLow3

above4H = close > slHigh4
below4H = close < slLow4

above1D = close > slHigh5
below1D = close < slLow5

//====================================================
// STOP LOSS
//====================================================

var float longSL = na
var float shortSL = na

var string activeSL = "5M"

// LONG SL
if manualHold

    if manualSLStage == "5M"
        longSL := slLow1
        activeSL := "5M"

    else if manualSLStage == "15M"
        longSL := slLow2
        activeSL := "15M"

    else if manualSLStage == "1H"
        longSL := slLow3
        activeSL := "1H"

    else if manualSLStage == "4H"
        longSL := slLow4
        activeSL := "4H"

    else if manualSLStage == "1D"
        longSL := slLow5
        activeSL := "1D"

    else

        if above1D
            longSL := slLow5
            activeSL := "1D"

        else if above4H
            longSL := slLow4
            activeSL := "4H"

        else if above1H
            longSL := slLow3
            activeSL := "1H"

        else if above15M
            longSL := slLow2
            activeSL := "15M"

        else
            longSL := slLow1
            activeSL := "5M"

else

    if above1D
        longSL := slLow5
        activeSL := "1D"

    else if above4H
        longSL := slLow4
        activeSL := "4H"

    else if above1H
        longSL := slLow3
        activeSL := "1H"

    else if above15M
        longSL := slLow2
        activeSL := "15M"

    else
        longSL := slLow1
        activeSL := "5M"

// SHORT SL
if below1D
    shortSL := slHigh5

else if below4H
    shortSL := slHigh4

else if below1H
    shortSL := slHigh3

else if below15M
    shortSL := slHigh2

else
    shortSL := slHigh1

//====================================================
// ENTRIES
//====================================================

if buySignal and strategy.position_size <= 0
    strategy.entry("LONG", strategy.long, qty=tradeQty)

if sellSignal and strategy.position_size >= 0 and not manualHold
    strategy.entry("SHORT", strategy.short, qty=tradeQty)

//====================================================
// EXITS
//====================================================

if strategy.position_size > 0
    strategy.exit("LONG EXIT", from_entry="LONG", stop=longSL)

if strategy.position_size < 0
    strategy.exit("SHORT EXIT", from_entry="SHORT", stop=shortSL)

//====================================================
// REVERSAL EXIT
//====================================================

if strategy.position_size > 0 and doubleBear
    strategy.close("LONG")

if strategy.position_size < 0 and doubleBull
    strategy.close("SHORT")

//====================================================
// VISUALS
//====================================================

plot(entryHighEMA, color=color.green, title="5M EMA HIGH")

plot(entryLowEMA, color=color.red, title="5M EMA LOW")

plot(longSL, color=color.yellow, title="LONG SL")

plot(shortSL, color=color.orange, title="SHORT SL")

plotshape(buySignal, title="BUY", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)

plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

//====================================================
// STATUS
//====================================================

microStatus = microBull ? "BULL" : microBear ? "BEAR" : "SIDE"

fastStatus = fastBull ? "BULL" : fastBear ? "BEAR" : "SIDE"

trendState = doubleBull ? "STRONG BULL" : doubleBear ? "STRONG BEAR" : "SIDEWAYS"

//====================================================
// DASHBOARD
//====================================================

var table dashboard = table.new(position.bottom_left, 2, 13, border_width=1)

if barstate.islast

    table.cell(dashboard, 0, 0, "5S->1M")
    table.cell(dashboard, 1, 0, microStatus, bgcolor=microBull ? color.green : microBear ? color.red : color.yellow)

    table.cell(dashboard, 0, 1, "15S->5M")
    table.cell(dashboard, 1, 1, fastStatus, bgcolor=fastBull ? color.green : fastBear ? color.red : color.yellow)

    table.cell(dashboard, 0, 2, "TREND")
    table.cell(dashboard, 1, 2, trendState, bgcolor=doubleBull ? color.green : doubleBear ? color.red : color.orange)

    table.cell(dashboard, 0, 3, "ADX")
    table.cell(dashboard, 1, 3, str.tostring(adxValue, "#.##"), bgcolor=adxValue > 20 ? color.green : color.red)

    table.cell(dashboard, 0, 4, "COMP")
    table.cell(dashboard, 1, 4, compressionFilter ? "EXPAND" : "COMPRESS", bgcolor=compressionFilter ? color.green : color.orange)

    table.cell(dashboard, 0, 5, "ACTIVE SL")
    table.cell(dashboard, 1, 5, activeSL)

    table.cell(dashboard, 0, 6, "1M")
    table.cell(dashboard, 1, 6, above1M ? "BULL" : "BEAR", bgcolor=above1M ? color.green : color.red)

    table.cell(dashboard, 0, 7, "5M")
    table.cell(dashboard, 1, 7, above5M ? "BULL" : "BEAR", bgcolor=above5M ? color.green : color.red)

    table.cell(dashboard, 0, 8, "15M")
    table.cell(dashboard, 1, 8, above15M ? "BULL" : "BEAR", bgcolor=above15M ? color.green : color.red)

    table.cell(dashboard, 0, 9, "1H")
    table.cell(dashboard, 1, 9, above1H ? "BULL" : "BEAR", bgcolor=above1H ? color.green : color.red)

    table.cell(dashboard, 0, 10, "4H")
    table.cell(dashboard, 1, 10, above4H ? "BULL" : "BEAR", bgcolor=above4H ? color.green : color.red)

    table.cell(dashboard, 0, 11, "1D")
    table.cell(dashboard, 1, 11, above1D ? "BULL" : "BEAR", bgcolor=above1D ? color.green : color.red)

    table.cell(dashboard, 0, 12, "POSITION")
    table.cell(dashboard, 1, 12, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT")