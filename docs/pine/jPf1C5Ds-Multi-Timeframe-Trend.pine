// @version=5
// @description Multi-Timeframe Trend Indicator for 5m, 15m, 1h, 4h, and Daily
indicator("Multi-Timeframe Trend", overlay=false)

// Function to determine trend based on RSI and MA
f_getTrend(tf) =>
    close_tf = request.security(symbol=syminfo.tickerid, timeframe=tf, expression=close, gaps=barmerge.gaps_off)
    rsi = ta.rsi(close_tf, 14)
    ma50 = ta.sma(close_tf, 50)
    ma200 = ta.sma(close_tf, 200)
    
    trend = rsi > 50 and ma50 > ma200 ? "Bullish" : rsi < 50 and ma50 < ma200 ? "Bearish" : "Neutral"
    trend

// Get trends for each timeframe
trend_5m = f_getTrend("5")
trend_15m = f_getTrend("15")
trend_1h = f_getTrend("60")
trend_4h = f_getTrend("240")
trend_daily = f_getTrend("D")

// Create a table to display trends
var table t = table.new(position.top_right, 2, 6, border_width=1)

// Table headers
table.cell(t, 0, 0, "Timeframe", bgcolor=color.gray, text_color=color.white)
table.cell(t, 1, 0, "Trend", bgcolor=color.gray, text_color=color.white)

// Table rows for each timeframe
table.cell(t, 0, 1, "5m", bgcolor=color.black, text_color=color.white)
table.cell(t, 1, 1, trend_5m, bgcolor=trend_5m == "Bullish" ? color.green : trend_5m == "Bearish" ? color.red : color.yellow, text_color=color.white)

table.cell(t, 0, 2, "15m", bgcolor=color.black, text_color=color.white)
table.cell(t, 1, 2, trend_15m, bgcolor=trend_15m == "Bullish" ? color.green : trend_15m == "Bearish" ? color.red : color.yellow, text_color=color.white)

table.cell(t, 0, 3, "1h", bgcolor=color.black, text_color=color.white)
table.cell(t, 1, 3, trend_1h, bgcolor=trend_1h == "Bullish" ? color.green : trend_1h == "Bearish" ? color.red : color.yellow, text_color=color.white)

table.cell(t, 0, 4, "4h", bgcolor=color.black, text_color=color.white)
table.cell(t, 1, 4, trend_4h, bgcolor=trend_4h == "Bullish" ? color.green : trend_4h == "Bearish" ? color.red : color.yellow, text_color=color.white)

table.cell(t, 0, 5, "Daily", bgcolor=color.black, text_color=color.white)
table.cell(t, 1, 5, trend_daily, bgcolor=trend_daily == "Bullish" ? color.green : trend_daily == "Bearish" ? color.red : color.yellow, text_color=color.white)