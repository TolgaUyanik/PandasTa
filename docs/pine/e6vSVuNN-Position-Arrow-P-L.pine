//@version=6
indicator("Position Arrow (P/L %)", overlay = true)

// ── Positions (per ticker) ──────────
// Fill in a symbol + purchase price + quantity per slot. The arrow only
// shows when the chart's symbol matches a slot — nothing carries over.
g1 = "Positions"
sym1 = input.string("", "Symbol 1", group = g1, inline = "1")
prc1 = input.float(0.0, "Price", group = g1, inline = "1", minval = 0)
qty1 = input.float(0.0, "Qty", group = g1, inline = "1", minval = 0)
sym2 = input.string("", "Symbol 2", group = g1, inline = "2")
prc2 = input.float(0.0, "Price", group = g1, inline = "2", minval = 0)
qty2 = input.float(0.0, "Qty", group = g1, inline = "2", minval = 0)
sym3 = input.string("", "Symbol 3", group = g1, inline = "3")
prc3 = input.float(0.0, "Price", group = g1, inline = "3", minval = 0)
qty3 = input.float(0.0, "Qty", group = g1, inline = "3", minval = 0)
sym4 = input.string("", "Symbol 4", group = g1, inline = "4")
prc4 = input.float(0.0, "Price", group = g1, inline = "4", minval = 0)
qty4 = input.float(0.0, "Qty", group = g1, inline = "4", minval = 0)
sym5 = input.string("", "Symbol 5", group = g1, inline = "5")
prc5 = input.float(0.0, "Price", group = g1, inline = "5", minval = 0)
qty5 = input.float(0.0, "Qty", group = g1, inline = "5", minval = 0)
sym6 = input.string("", "Symbol 6", group = g1, inline = "6")
prc6 = input.float(0.0, "Price", group = g1, inline = "6", minval = 0)
qty6 = input.float(0.0, "Qty", group = g1, inline = "6", minval = 0)
sym7 = input.string("", "Symbol 7", group = g1, inline = "7")
prc7 = input.float(0.0, "Price", group = g1, inline = "7", minval = 0)
qty7 = input.float(0.0, "Qty", group = g1, inline = "7", minval = 0)
sym8 = input.string("", "Symbol 8", group = g1, inline = "8")
prc8 = input.float(0.0, "Price", group = g1, inline = "8", minval = 0)
qty8 = input.float(0.0, "Qty", group = g1, inline = "8", minval = 0)

// ── Appearance ──────────
g2 = "Appearance"
rightOff   = input.int(10, "Distance from last candle (bars)", minval = 1, maxval = 100, group = g2)
arrowColor = input.color(color.rgb(41, 98, 255), "Arrow color", group = g2)
lineWidth  = input.int(2, "Line width", minval = 1, maxval = 10, group = g2)
sizeOpt    = input.string("normal", "Label size", options = ["tiny", "small", "normal", "large", "huge"], group = g2)

// ── Find this chart's entry price + quantity ──────────
matches(s) => str.upper(str.trim(s)) == syminfo.ticker

entryPrice = matches(sym1) and prc1 > 0 ? prc1 :
     matches(sym2) and prc2 > 0 ? prc2 :
     matches(sym3) and prc3 > 0 ? prc3 :
     matches(sym4) and prc4 > 0 ? prc4 :
     matches(sym5) and prc5 > 0 ? prc5 :
     matches(sym6) and prc6 > 0 ? prc6 :
     matches(sym7) and prc7 > 0 ? prc7 :
     matches(sym8) and prc8 > 0 ? prc8 : na

qty = matches(sym1) and prc1 > 0 ? qty1 :
     matches(sym2) and prc2 > 0 ? qty2 :
     matches(sym3) and prc3 > 0 ? qty3 :
     matches(sym4) and prc4 > 0 ? qty4 :
     matches(sym5) and prc5 > 0 ? qty5 :
     matches(sym6) and prc6 > 0 ? qty6 :
     matches(sym7) and prc7 > 0 ? qty7 :
     matches(sym8) and prc8 > 0 ? qty8 : na

// ── Auto-contrast text color ──────────
// Perceived brightness of the arrow color decides black vs white text.
lum = 0.299 * color.r(arrowColor) + 0.587 * color.g(arrowColor) + 0.114 * color.b(arrowColor)
txtColor = lum > 150 ? color.black : color.white

// ── Label size mapping ──────────
labelSize = switch sizeOpt
    "tiny"   => size.tiny
    "small"  => size.small
    "large"  => size.large
    "huge"   => size.huge
    => size.normal

// ── Drawing ──────────
// Vertical arrow in the empty space right of the last candle:
// from the purchase price straight down/up to the current price.
var line  arrow = na
var label tag   = na

if barstate.islast
    line.delete(arrow)
    label.delete(tag)

    if not na(entryPrice)
        x   = bar_index + rightOff
        pct = (close - entryPrice) / entryPrice * 100
        txt = (pct >= 0 ? "▲ +" : "▼ ") + str.tostring(pct, "0.00") + "%"

        // Total gain/loss in USD (needs Qty > 0 in the matching slot)
        if not na(qty) and qty > 0
            usd = (close - entryPrice) * qty
            txt += "\n" + (usd >= 0 ? "+$" : "-$") + str.tostring(math.abs(usd), "#,##0.00")

        arrow := line.new(x, entryPrice, x, close,
             xloc  = xloc.bar_index,
             color = arrowColor,
             style = line.style_arrow_right,
             width = lineWidth)

        // Gain: arrow points up → box below it (pointer up at the arrow's base).
        // Loss: arrow points down → box above it (pointer down at the arrow's base).
        tag := label.new(x, entryPrice, txt,
             xloc      = xloc.bar_index,
             style     = pct >= 0 ? label.style_label_up : label.style_label_down,
             color     = arrowColor,
             textcolor = txtColor,
             size      = labelSize)