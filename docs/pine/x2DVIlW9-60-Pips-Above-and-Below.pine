//@version=6
indicator("60 Pips Above and Below", overlay=true)
// Calculate pip size
GetPipSize() => syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)
// Define pip distance
pipDistance = 600
// Calculate exact price levels
upperLine = close + (pipDistance * GetPipSize())
lowerLine = close - (pipDistance * GetPipSize())
// Plot the lines dynamically on the last bar
var line upLine = na
var line dnLine = na
if barstate.islast
    line.delete(upLine)
    line.delete(dnLine)
    upLine := line.new(bar_index - 1, upperLine, bar_index, upperLine, color=color.red, width=2, extend=extend.right)
    dnLine := line.new(bar_index - 1, lowerLine, bar_index, lowerLine, color=color.red, width=2, extend=extend.right)
    