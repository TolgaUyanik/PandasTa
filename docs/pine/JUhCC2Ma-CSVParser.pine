// ━━━━━━  getPropArS(objProp, prop) ━━━━━━ {
// @function Returns a string array of values for a given property name `prop`. Looks for a key `prop` in objProps.mpObj 
// if finds <prop, obj> pair returns obj.arS, otherwise returns na. Returns a reference to the original, not a copy.
_getPropArS(obj, prop) =>
    if not na(obj)
        objP = obj.mpObj.get(prop) // not checking existense of child mpS, mpObj, arS. Obj must  be initialised 
        if not na(objP)
            objP.arS
        else 
            na

