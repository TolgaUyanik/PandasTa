// --- init() ---{
// @function Initializes objProps obj (creates child maps and arrays)
export method init(objProps this) => this.mpS := map.new<string,string>(), this.arS := array.new<string>(), this.mpObj := map.new<string,objProps1 >() , this 
method init(objProps0 this) => this.mpS := map.new<string,string>(), this.arS := array.new<string>(), this.mpObj := map.new<string,objProps1 >() , this 
method init(objProps1 this) => this.mpS := map.new<string,string>(), this.arS := array.new<string>(), this.mpObj := map.new<string,objProps2 >() , this 
