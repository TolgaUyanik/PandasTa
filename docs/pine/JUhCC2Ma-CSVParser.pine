// ━━━━━━ toT(objProps) ━━━━━━ {
BG_CLR1 = color.rgb(248, 255, 156, 12)
BG_CLR2 = color.rgb(255, 228, 50, 16)
BG_HIGHL1 = color.rgb(255, 228, 50, 16)

_bgC(N) =>  N%2 == 0 ? BG_CLR1 : BG_CLR2

// --- _toT(objPropsN, ...) --- {
// @function Outputs arS and mpS to matrices for autotable(). 
_toT(this, N, nz) =>
    _nz = na(nz) ? "--" : nz

    
    mxS         = matrix.new<string > (0, N, "") 
    mxMerge     = matrix.new<string > (0, N, "") 
    mxBgClr     = matrix.new<color  > (0, N, _bgC(N)) 
    _ar         = array.new<string  > (N,"")
    _arMerge    = array.concat(array.new<string> (2,""), array.new<string> (N-2,"L"))
    _arBgClr    = array.new<color   > (N, _bgC(N))

    for [k,v] in this.mpS
        _ar.set(0, k)
        _ar.set(1, v)
        mxS.add_row(array_id = _ar)
        mxMerge.add_row(array_id = _arMerge)
        mxBgClr.add_row(array_id = _arBgClr)

    _ar.set(0, "arS\nsz=" + str.tostring(this.arS.size()))
    _ar.set(1, this.arS.toS(separator = "; ", nz = _nz))
    mxS.add_row(array_id = _ar)
    mxMerge.add_row(array_id = _arMerge)
    mxBgClr.add_row(array_id = _arBgClr)

    [mxS, mxMerge, mxBgClr]

// END OF _toT}

// --- addMxObj() ---{
// @function  Concatenates output matrices prepared by _toT for arS and mpS with output matrices for mpObj
// (prepared by child objProps.toT())
// @param k Key (for mpObj)
_addMxObj(mxS, mxMerge, mxBgClr, mxObjS, mxObjMerge, mxObjBgClr, k, N) =>
    r = mxObjS.rows()
    _arC = array.new<string>(r, "")
    _arC.set(0, k)
    _arMergeC = array.new<string>(r, "U")
    _arMergeC.set(0, "")
    _arBgClrC = array.new<color>(r, _bgC(N))
    _arBgClrC.set(0, BG_HIGHL1) // highlight obj name

    mxObjS.add_col(0, _arC)
    mxObjMerge.add_col(0, _arMergeC)
    mxObjBgClr.add_col(0, _arBgClrC)

    mxS.concat(mxObjS)
    mxMerge.concat(mxObjMerge)
    mxBgClr.concat(mxObjBgClr)

    [mxS, mxMerge, mxBgClr]
//}

// --- toT(objProps9, ...) --- {
// @function Outputs objProps to string matrices for further display using autotable().
// @returns A tuple [mxS, mxMerge, mxBgClr] - value, merge and color matrix (autotable() parameters)
export method toT(objProps9 this, string nz = "--") => _toT(this, 2, nz)
//}

// --- toT(objProps8, ...) --- {
// @function Outputs objProps to string matrices for further display using autotable().
// @returns A tuple [mxS, mxMerge, mxBgClr] - value, merge and color matrix (autotable() parameters)
export method toT(objProps8 this, string nz = "--") =>
    const int N = 3
    [mxS, mxMerge, mxBgClr] = _toT(this, N, nz)

    for [k,v] in this.mpObj
        [mxObjS, mxObjMerge, mxObjBgClr] = v.toT(nz = nz)
        _addMxObj(mxS, mxMerge, mxBgClr, mxObjS, mxObjMerge, mxObjBgClr, k, N)
    [mxS, mxMerge, mxBgClr]
//}

