// ━━━━━━ parseConfig() ━━━━━━ {
// @function Reads config text into objProps0. Config syntax:
//  objLvl1(1,2,3,prop1=val1, prop2 = val2, 4, objLvl2-1(prop11 = val11, 22, prop22 = val22, objLvl3(222,333)))
// i.e.
// - text before brackets - obj name 
// - brackets - new child obj
// - values within brackets without "=" - array values 
// - values within brackets with "=" - property values (go to mpS map)
// - values within brackets with brackets - child objects
// These symbols cannot be used for names or values: =,()
// Quotes are not interpreted, processed in the same way as any normal letter

// Unlike _parseConfig() function, methods objProps.parseConfig() are always called with last_separator = "("
// so no `last_separator` param needed for them


const string rgxNAME    = "[A-Za-z0-9-\._]+\s*\(" // name with optional spaces and opening bracket, e.g. "TF1.2 ("
const string rgxNEWVAL  = "[\)\(\,=]" // "(" - new obj, "," - new val
const string rgxNEWVAL_OR_QUOTE  = "[\)\(\,=\"]" // "(" - new obj, "," - new val
const string rgxVAL     = "\s*(['\"A-Za-z0-9-\._]+\s*(,|\))|(,|\)))" // part between = and , or )


method l25(string s) => str.substring(s,0,math.min(str.length(s),25)) + (str.length(s) > 25 ? "..." : "")

// --- _parseConfig() ---{
// @function Parses for arS and mpS values, populates arS and mpS with read values and returns remainder and _last_separator. 
// (parsing for child objProps remains outside since no recursion in PineScript). Quotation marks are ignored unless 
// they occur within mpS values (i.e. after "=" sign.) In that case quoted text is imported as a property value and all 
// surrounding text is ignored. E.g. `msg = buy "milk" (a=15,  length(21,31)` ) 
// @param last_separator Last separator before s or a special value ">" meaning  ignore next value if empty 
// (e.g. "))" and ")," should lead to adding na to arS). Normally _parseConfig() is called upon encountering "(" meaning 
// child objProps object, but in cases like "OBJ1(arItem11, OBJ2(arItem21, arItem22), arItem12)" parser imports 
// first item of OBJ1.arS, then creates <"OBJ2', OBJ2> pair in OBJ1.mpObj then continues parsing adding arItem12 as 
// second item to OBJ1.arS, last_separator will be "," in on this last step.  
// @returns tuple [parsed value , _lastSeparator, remainder of the string]
_parseConfig(this, s, last_separator) =>
    finish = false
    b = ""
    m = last_separator
    _lastSeparator = switch last_separator 
        ")" => ">" // means ignore next value if empty
        "(" => "<" 
        => last_separator 
    e = s // remainder of the string to parse

    while e != "" and _lastSeparator != "(" and _lastSeparator != ")" //  "" or ")" - finished parsing current object, going up to parent, "(" - going down (i.e. new child objProps)
        [b1, m1, e1] = e.feedRgx(rgxNEWVAL)
        // log.info("\n--- FEED --- \nls>>> {3}\nb1>>> {0}\nm1>>> <{1}>\ne1>>> {2}...", b1, m1, e1.l25(), _lastSeparator)
        _b1 = b1.trim2()
        e := e1

        // --- arS item "" or ")" ---
        if m1 == "" or m1 == ")" 
            if  not( _lastSeparator == ">" and _b1 == "")  // ignore if empty 
                this.arS.push(_b1) // if found no separator the whole string is imported as an array item
            _lastSeparator := ")" // ticket to exit....
            ["", ")", e1] // exiting loop, do not care of e or  _lastSeparator

        // --- mpS item ---
        else if m1 == "="
            _b1 := _b1.firstNonSpaceGroup()
            if _b1 == "" 
                runtime.error("parseConfig objProps0:\nSyntax error, property name is empty, before \"" 
                              + m1 + str.substring(e1,0,20) + "...\""
                              )

            [b2, m2, e2] = e1.feedRgx(rgxNEWVAL_OR_QUOTE)
            if m2 != "," and m2 != ")" and m2 != "\""
                runtime.error(str.format("CSVParser: Started reading a pair <{0}, {1}> and found \"{2}\" before closing 
                                  separator (comma or closing bracket) and outside quotation", _b1, b2.trim2().l25(), m2 ))
            // log.info("\n--- FEED1 --- \n<b2>>> {0}\nm2>>> <{1}>\ne2>>> {2}...", b2, m2, e2.l25())

            // if quoted text found - store it as value and ignore surroundings from "=" till "," or ")" 
            if m2 == "\""
                [b3, m3, e3] = e2.feedTillQuote() // only quoted text (b3) will be stored as porperty value
                [b4, m4, e4] = e3.feedRgx(rgxNEWVAL)  // not looking for quotations anymore, b4 will be ignored 
                if m4 != "," and m4 != ")"
                    runtime.error(str.format("CSVParser: after a <{0}, {1}> pair expecting ','or ')', but found `{2}`", _b1, b3.trim2().l25(), m4 ))
                this.mpS.put(_b1, b3.trim2()) 
                e := e4
                _lastSeparator := m4
                ["", m4, e4] 

            else // no quotations
                this.mpS.put(_b1, b2.trim2())
                e := e2
                _lastSeparator := m2
                ["", _lastSeparator, e2] // _b1 and b2 are already processed, no need to return

        // --- arS item "," ---
        else if m1 == ","
            if  not( _lastSeparator == ">" and _b1 == "")  // ignore if empty 
                this.arS.push(_b1)
            _lastSeparator := ","
            e := e1 
            ["", ",", e1] // continue looping, no need to return anything

        else if m1 == "("
            e := e1 
            b:= _b1
            _lastSeparator := "(" // loop exit ticket....
            [_b1, m1, e1] // _b1 will be used as key for new child objProps

// }

 
// --- parseConfig9() ---{
// @function Reads config text into objProps (unnamed values into arS, named into mpS, sub-levels into mpObj)
method parseConfig(objProps9 this, string s) =>  _parseConfig(this, s, "(")
// }

// --- parseConfig8() ---{
// @function Reads config text into objProps (unnamed values into arS, named into mpS, sub-levels into mpObj)
method parseConfig(objProps8 this, string s) =>
    _lastSeparator = "("
    e = s
    while e != "" and _lastSeparator != ""  
        // parse for array (arS) item and map pairs (mpS)
        [b1, m1, e1] = _parseConfig(this, e, _lastSeparator) 
        _lastSeparator := m1
        e := e1
        if _lastSeparator == ")"
            break

        if m1 == "("
            // populate child objProps 
            _o = objProps9.new().init()
            [b2, m2, e2] = _o.parseConfig(e1) 
            this.mpObj.put(b1, _o) 
            _lastSeparator := ")"
            e := e2
    ["", ")", e]
// }


