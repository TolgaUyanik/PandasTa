// ━━━━━━  getPropVal(objProp, prop) ━━━━━━ {
// @function Checks if there is an array of values for property `prop` and returns its `id`'s  element or na if not found
// @param this (objProps) objProps object containing array of property values in a child objProp object corresponding to propertty name.
// @param prop (string) Name of the property 
// @param id (int) Id of the element to be returned from the array pf property values
_getPropVal(objProps, prop, id) =>
    _propObj = objProps.mpObj.get(prop)
    if not na(_propObj)
        if _propObj.arS.size() > id
            _val  = _propObj.arS.get(id)

