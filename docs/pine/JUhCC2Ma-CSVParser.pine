// +++ objProps9 +++ {
// @type  Object for storing values read from CSV relating to a particular object or property name.
// @field mpS (map(<string, string>) Stores property values as <key, value> pairs 
// @field arS (string[])  Array of values 
// @field mpObj (map(<string, objProps... >) Stores objProps objects containing properties's data as <property name, objProp...> pairs   
export type objProps9
    map<string, string>         mpS
    string[]                    arS
// END OF objProps9 type}

