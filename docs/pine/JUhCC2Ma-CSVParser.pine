//@version=5

// @description Reads a CSV configuration text into an objProps object according to simple syntax rules. 
// Principles: 
//          - all values read from config text are stored as strings
//          - opbjProps of each level have 
//              - child array<string> arS for storing values without names (e.g. "12,23" --> array [12,23]) 
//              - map<string, string> mpS for storing items with names (e.g. "key = value") "kew=value" --> <key,value> map pair)
//              - and map<string, objPropsN> for storing nested objects. Nested brackets create nested ObjProps objects.
//                   (e.g. "TF1(tf=60)" creates a <"TF1, objProps0Obj> pair in mpObj, and "tf=60" is added to 
//                  objProps1Obj.mpS as <"tf", "60">)
//             - Supports 10 level deep nested brackets which are imported int objProp (top level), objProps0, objProps1,.. objProp9 object types.

// FUNCTIONS: 
// - objProps.parseConfig(string config) - imports CSV configuration text (config) into objProps object
// - objProps.getPropAr() (exists for all levels of objProps) - returnes objProps.arS array for `prop` property if found 
//      (as a key in mpObj map)
// - objProps.toT() - displays a table with the contents of the objProps object (for config debug)

// --- SYNTAX ---- 
// Example: "TF1=60: Length(13,21,31,50) Type(EMA, EMA, SMA, EMA) Width(1,1,1) Color (#aaff9933, #00FF0000)"
// After property names in brackets go up to 6 values for the 6 mas. If less are given they are set to the first ma's 
// and the remaining get their values from normal script settings.
//
// NB: 
//          - If objects or properties with duplicate names are encountered only the latest is imported 
//                (e.g. for "TF1(length(12,22)), TF1(tf=240)" only "TF1(tf=240)" will be imported
//          - Line breakes are not regarded as part of syntax (i.e. values are imported with line breaks, you can supply
//              but multi level lines containing separator symbols ")" or "," will cause errors (parser stops reading property value at them) 
//          - In multilne key names only first non space line (trimmed) is taken as a key.
//          - ")," (or ") ," and similar) does not create an na array item while ",," does. (",)" creates an na array item) 
//
// You can play around and test your config text using demo in this library, just edit your text in script settings
// and see how it is parsed into objProps objects.


library("CSVParser")
import moebius1977/ToS/1 as TOSTRING
import moebius1977/ToStringAr/1 as TOSTRINGAR
import moebius1977/Autotable/1 as AT
import moebius1977/RegexLib/1


// --- CSV config constants ---{ 

// --- keys --- 
// names of all possible properties in config, looks for parts like "Length(1,1,1,1) "
const string P_TYPE = "type"
const string P_LENGTH = "length"
const string P_WIDTH = "width"
const string P_CLR = "color"

// --- regex --- 
const string RG_TF_PFX = "TF\\d="
const string RG_PROPS =          "(?i)("            // case insensitive
                              + P_LENGTH + "|"
                              + P_WIDTH + "|"
                              + P_TYPE + "|"
                              + P_CLR   
                              + ")\\([^\\()]*\\)"  




//}


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                   PARSER HELPER FUNCTIONS                                    ┃{

// ━━━━━ trim2() ━━━━━ {
// @function Like str.trim() but also trims line breaks ("\n" and "\r")
method trim2(string s) =>
    s1 = str.trim(str.match(s,"\\S(.|\\s)*"))
    while str.length(s1) > 0 
        i = str.length(s1) - 1
        lastChar = str.substring(s1, i)
        if lastChar == "\n" // or lastChar == "\r"  \r has no special meaning in pine
            s1 := str.trim(str.substring(s1, 0, i))
        else
            break
    s1
// END OF trim2 }

// --------- method firstNonSpaceGroup()--------- {
// @function Like srr.trim() but also trims line breaks. Used to trim map keys in parseConfig()
// functions. For multiline keys returns just the first part.
method firstNonSpaceGroup(string this) => str.match(this, "\\S+")
// END OF firstNonSpaceGroup() }

// --- feedTillQuote() ---{
// @function Feeds text until next unescaped quotation mark. Unescapes quotation marks in the feeded part if `unescape` is true
// @returns a tuple [read text (with unescaped quotation marks by default), quotation mark if found or na if not, end of the string]
method feedTillQuote(string this, bool unescape = true) =>
    _s = str.replace_all(this, "\\\"", "〟")
    [b, m, e] = _s.feedRgx("\"")

    _b = str.replace_all(b, "〟", unescape ? "\"" : "\\\"")
    _e = str.replace_all(e, "〟", "\\\"")

    [_b, m, _e]

// END OF _feedTillQuote}

// --------- nzs()--------- {
// @function Like nz() but for strings. Returns `nz` arg (default = "") if _s is na.
export nzs(string _s, string nz = "") => na(_s) ? nz : _s
// END OF nzs() }

// ^^^ END OF HELPER METHODS }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 
// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                   PARSER TYPE AND METHODS                                    ┃{


