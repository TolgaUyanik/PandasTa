// ╔════════════════════════════════════════════════════════════════════════╗
// ║  The Kyber Cell's • SQUEEZE PRO  —  TTM Squeeze ＋ ALMA ＋ VWAP         ║
// ║  Pine Script™ v6 | © 2025 Kyber Cell Labs                              ║
// ╠════════════════════════════════════════════════════════════════════════╣
// ║  WHAT THIS OVERLAY GIVES YOU                                           ║
// ║    • In-chart re-build of John Carter’s TTM Squeeze                    ║
// ║    • Candles coloured by LR-momentum (replaces the classic histogram)  ║
// ║    • Squeeze-status dots — new palette                                 ║
// ║         Blue  → Orange → Red → Green                                   ║
// ║         cool    warming  ready   fire                                  ║
// ║    • Optional backdrop stays green while bullish expansion lasts,      ║
// ║      red while bearish expansion lasts                                 ║
// ║    • ALMA (Arnaud Legoux MA) ribbon for smooth trend confirmation that ║
// ║        follows closely to the middle of the BB and KC EMAs             ║
// ║    • Scroll-aware VWAP with optional ±σ bands                          ║
// ║    • Configurable ▲/▼ or ↑/↓ labels on the exact squeeze-fire bar      ║
// ║    • Configurable Histogram overlay using trend (bull/bear) or         ║
// ║        traditional TTM Squeeze histogram bar overlay                   ║
// ║    • Configurable histogram overlay using Momentum, EMA-trend, or      ║
// ║        HMA-trend bar colors                                            ║
// ║    • Dots can be placed above or below bars                            ║
// ║    • Added Momentum line overlay that shows the same momentum          ║
// ║        as a traditional TTM Squeeze indicator                          ║
// ║                                                                        ║
// ║  QUICK WORKFLOW                                                        ║
// ║    1) Watch dots walk Blue → Orange → Red                              ║
// ║    2) When dot flips Green, enter with bar-colour bias                 ║
// ║    3) Use ALMA + VWAP as extra confirmation                            ║
// ║    4) Exit when momentum flips sign or backdrop disappears             ║
// ║                                                                        ║
// ║  KEY INPUT GROUPS (Settings → Inputs)                                  ║
// ║    • Squeeze length, BB σ, three KC multipliers                        ║
// ║    • ALMA length, offset, sigma                                        ║
// ║    • VWAP on/off, deviation σ bands                                    ║
// ║    • Entry-marker shape, size, colours, ATR padding                    ║
// ║    • Price Action bar signals (crosses) from Chris Capre's method      ║
// ║                                                                        ║
// ║  DISCLAIMER — Educational use only.  Not financial advice.             ║
// ╚════════════════════════════════════════════════════════════════════════╝

//@version=6
indicator("The Kyber Cell's – TTM Squeeze Pro", overlay=true, max_bars_back=500, max_labels_count=500)

// ==== INPUTS ====
// TTM Squeeze parameters
lenSqueeze   = input.int(20,   "Squeeze length", tooltip="Used to calculate Bollinger Bands and Keltner Channels", group="Squeeze Settings")
bbMult       = input.float(2.0,"BB σ", tooltip="Standard deviation multiplier for Bollinger Bands", group="Squeeze Settings")
kcMultH      = input.float(1.0,"KC-High", tooltip="High multiplier for Keltner Channel", group="Squeeze Settings")
kcMultM      = input.float(1.5,"KC-Mid", tooltip="Mid multiplier for Keltner Channel", group="Squeeze Settings")
kcMultL      = input.float(2.0,"KC-Low", tooltip="Low multiplier for Keltner Channel", group="Squeeze Settings")

// ALMA parameters
lenAlma      = input.int(50,   "ALMA len", tooltip="Length of the Arnaud Legoux Moving Average", group="ALMA Settings")
almaOff      = input.float(0.85,"ALMA off", tooltip="Offset for ALMA curve shape", group="ALMA Settings")
almaSig      = input.float(6,   "ALMA σ", tooltip="Sigma for ALMA smoothing", group="ALMA Settings")

// VWAP parameters
showVwap     = input.bool(true,"Plot VWAP", tooltip="Enable or disable VWAP line on the chart", group="VWAP Settings")
vwapSigma    = input.float(0.0, "VWAP bands σ (0 = hide)", tooltip="VWAP standard deviation bands (0 to hide bands)", group="VWAP Settings")

// ==== MOMENTUM OVERLAY ====
// Momentum Overlay settings
group_momentum = "Momentum Overlay"

showMomentumLine = input.bool(false, "Show Momentum Line", group=group_momentum, tooltip="Smooth EMA-tracked momentum overlaid near price for directional reference. Based on TTM Squeeze histogram formula.")
momLineStyle     = input.string("Normalize", "Momentum Line Style", options=["Normalize", "Add to Price"], group=group_momentum, tooltip="Choose how the line is positioned: 'Normalize' centers around the BB mean; 'Add to Price' pushes line upward from bar prices.")
momSmoothLen     = input.int(8, "Momentum Smoothing EMA", minval=1, group=group_momentum, tooltip="Length of the EMA used to smooth the raw momentum line. Recommended: 8–14.")
momColor         = input.color(color.silver, "Momentum Line Color", group=group_momentum)

// Entry‐marker controls
showMarks    = input.bool(true, "Show entry markers", tooltip="Show or hide entry marker labels on squeeze fire", group="Entry Markers")
markShape    = input.string("Arrow","Marker shape",options=["Triangle","Arrow"], tooltip="Shape for entry markers (Arrow or Triangle)", group="Entry Markers")
markSizeInp  = input.string("Tiny", "Marker size",  options=["Tiny","Small","Normal","Large","Huge"], tooltip="Size of the entry markers", group="Entry Markers")
markPadAtr   = input.float(0.35, "Marker padding × ATR", tooltip="ATR multiplier for marker vertical offset", group="Entry Markers")
colLong      = input.color(color.green,"Long colour", group="Entry Markers")
colShort     = input.color(color.red,  "Short colour", group="Entry Markers")

// Limit‐target settings
showLimit    = input.bool(false,"Show limit target (experimental)", tooltip="Show or hide limit target line after squeeze fire", group="Limit Target")
limitAtrLen  = input.int(20,   "Limit ATR length",   inline="limit", tooltip="ATR length for limit target calculation", group="Limit Target")
limitMult    = input.float(2.0,"Limit ATR multiple", inline="limit", tooltip="ATR multiplier for limit target distance", group="Limit Target")
limitColor   = input.color(color.blue,"Limit line colour", group="Limit Target")

// Protective‐stop settings
showStop     = input.bool(false, "Show protective stop (experimental)", tooltip="Show or hide protective stop line after squeeze fire", group="Protective Stop")
stopMode     = input.string("Swing","Stop method",options=["Swing","ATR"], tooltip="Stop method: Swing or ATR-based", group="Protective Stop")
swingLen     = input.int(5,    "Swing look-back",    inline="swing", tooltip="Look-back bars for swing high/low stop", group="Protective Stop")
atrLen       = input.int(20,   "ATR length",         inline="atr", tooltip="ATR length for stop calculation", group="Protective Stop")
atrMult      = input.float(1.5,"ATR multiple",step=0.1,inline="atr", tooltip="ATR multiplier for ATR-based stop", group="Protective Stop")
stopColor    = input.color(color.gray,"Stop line colour", group="Protective Stop")

// Bar-color mode
barColorMode = input.string("Momentum", "Bar-overlay mode", options = ["Momentum", "Trend"], tooltip="Choose bar coloring by momentum or trend", group="Bar Coloring")


// MTF panel toggles
showMtfPanel = input.bool(false,"Show MTF Squeeze Panel", group="MTF Squeeze Panel")
showMtf1     = input.bool(true,"1-minute", group="MTF Squeeze Panel")
showMtf5     = input.bool(true,"5-minute", group="MTF Squeeze Panel")
showMtf15    = input.bool(true,"15-minute", group="MTF Squeeze Panel")
showMtf30    = input.bool(true,"30-minute", group="MTF Squeeze Panel")
showMtf60    = input.bool(true,"60-minute", group="MTF Squeeze Panel")
showMtf2H    = input.bool(true,"2-hour", group="MTF Squeeze Panel")
showMtf4H    = input.bool(true,"4-hour", group="MTF Squeeze Panel")
showMtfD     = input.bool(true,"Daily", group="MTF Squeeze Panel")
showMtfW     = input.bool(true,"Weekly", group="MTF Squeeze Panel")
showMtfM     = input.bool(true,"Monthly", group="MTF Squeeze Panel")

// Dot‐color inputs for Squeeze tiers
colLowComp   = input.color(color.blue, "Low Compression", group="Dot Colors")
colMedComp   = input.color(color.rgb(255,102,0), "Medium Compression", group="Dot Colors")
colHighComp  = input.color(color.red, "High Compression", group="Dot Colors")
colRelease   = input.color(color.green, "Release", group="Dot Colors")

// MTF Squeeze Panel color overrides (use constant colors directly)
mtfColorLow    = input.color(color.blue, "MTF Low Compression Color", group="MTF Squeeze Panel")
mtfColorMedium = input.color(color.rgb(255,102,0), "MTF Medium Compression Color", group="MTF Squeeze Panel")
mtfColorHigh   = input.color(color.red, "MTF High Compression Color", group="MTF Squeeze Panel")
mtfColorFire   = input.color(color.green, "MTF Release Color", group="MTF Squeeze Panel")

// ==== HELPER FUNCTIONS ====
enumSize   = markSizeInp=="Small"?size.small:markSizeInp=="Normal"?size.normal:markSizeInp=="Large"?size.large:markSizeInp=="Huge"?size.huge:size.tiny
shapeLong  = markShape=="Arrow"?label.style_arrowup:label.style_triangleup
shapeShort = markShape=="Arrow"?label.style_arrowdown:label.style_triangledown
kc(mid,rng,m) => [mid+rng*m,mid-rng*m]

// ==== SQUEEZE AND BAND CALCULATIONS ====
// Basic SMA and BB calculations
smaClose   = ta.sma(close,lenSqueeze)
bbDev      = bbMult * ta.stdev(close,lenSqueeze)
bbTop      = smaClose + bbDev
bbBot      = smaClose - bbDev

// Use SMA of TR for Keltner Channels
devKC               = ta.sma(ta.tr(true),lenSqueeze)
[kcHiTop,kcHiBot]   = kc(smaClose,devKC,kcMultH)
[kcMidTop,kcMidBot] = kc(smaClose,devKC,kcMultM)
[kcLoTop,kcLoBot]   = kc(smaClose,devKC,kcMultL)

// Squeeze/run logic
tight  = bbBot>=kcHiBot and bbTop<=kcHiTop
medium = bbBot>=kcMidBot and bbTop<=kcMidTop
loose  = bbBot>=kcLoBot and bbTop<=kcLoTop
squeezeFired   = not (tight or medium or loose)

// ==== MOMENTUM AND TREND CALCULATIONS ====
// Momentum calculation
mom = ta.linreg(close - math.avg(math.avg(ta.highest(high,lenSqueeze),ta.lowest(low,lenSqueeze)),smaClose),lenSqueeze,0)
// ==== MOMENTUM OVERLAY ====
// Momentum Line Smoothing and Plotting
momEma = ta.ema(mom, momSmoothLen)
momNormalized = momLineStyle == "Normalize" ? momEma + smaClose : momEma + close
plot(showMomentumLine ? momNormalized : na, "Momentum Line", color=momColor, linewidth=2)
// Smooth and anchor momentum for cleaner overlay
smoothedMom = ta.ema(mom, 6)
anchoredMom = smoothedMom + smaClose  // smaClose already defined earlier

// Trend calculations for bar colors
emaFast     = ta.ema(close,8)
emaSlow     = ta.ema(close,21)
ttmBarCol   = close>emaSlow?color.rgb(50,150,255):(close<emaSlow?color.rgb(255,70,70):color.gray)

// ==== BAR COLOR DETERMINATION ====
chosenColor = barColorMode=="Momentum"? (mom>0?(mom>nz(mom[1])?color.aqua:color.blue):(mom<nz(mom[1])?color.red:color.yellow)) : ttmBarCol

// ==== SQUEEZE DOT PLOTTING ====
// Squeeze tier dots plotted with exclusive tiers
plotshape(loose,  title="Low Compression Dot",    location=location.abovebar, style=shape.circle, color=colLowComp,  size=size.tiny)
plotshape(medium, title="Medium Compression Dot", location=location.abovebar, style=shape.circle, color=colMedComp,  size=size.tiny)
plotshape(tight,  title="High Compression Dot",   location=location.abovebar, style=shape.circle, color=colHighComp, size=size.tiny)
plotshape(squeezeFired,   title="Release Dot",            location=location.abovebar, style=shape.circle, color=colRelease,  size=size.tiny)

// ==== SQUEEZE BACKDROP LOGIC ====
fired     = squeezeFired and (loose[1] or medium[1] or tight[1])
var dir   = 0
var inRun = false
if fired
    dir   := mom>=0?1:-1
    inRun := true
else
    if mom*dir<=0 or tight or medium or loose
        inRun := false
bgcolor(inRun?(dir==1?color.new(color.green,75):color.new(color.red,75)):na)

// ==== MOMENTUM LINE ====
// (Legacy momentum line plot removed in favor of new overlay)

// ==== ALMA AND VWAP PLOTTING ====
plot(ta.alma(close,lenAlma,almaOff,almaSig), title="ALMA Ribbon", color=color.blue, linewidth=1, style=plot.style_line)
// VWAP variables — each must be declared with its type
var float vwap   = na
var float vwapUp = na
var float vwapDn = na
isAnchor = time==chart.left_visible_bar_time
[vTmp,uTmp,dTmp] = ta.vwap(hlc3,isAnchor,vwapSigma)
vwap   := showVwap?vTmp:na
vwapUp := showVwap and vwapSigma!=0?uTmp:na
vwapDn := showVwap and vwapSigma!=0?dTmp:na
plot(vwap, title="VWAP", color=color.orange, linewidth=2, style=plot.style_line, display=showVwap ? display.all : display.none)
uPlot=plot(vwapUp, title="VWAP Upper Band", color=color.green, style=plot.style_line, display=showVwap and vwapSigma != 0 ? display.all : display.none)
dPlot=plot(vwapDn, title="VWAP Lower Band", color=color.green, style=plot.style_line, display=showVwap and vwapSigma != 0 ? display.all : display.none)
fill(uPlot,dPlot,color.new(color.green,90),title="VWAP bands")

// ==== ENTRY MARKER LABELS ====
goLong  = fired and mom>=0
goShort = fired and mom<0
padPx   = ta.atr(lenSqueeze)*markPadAtr
if showMarks and goLong
    label.new(bar_index,high+padPx,"Long",yloc=yloc.price,style=shapeLong,size=enumSize,color=colLong)
if showMarks and goShort
    label.new(bar_index,low-padPx,"Short",yloc=yloc.price,style=shapeShort,size=enumSize,color=colShort)

// ==== PROTECTIVE STOP LOGIC ====
atr20     = ta.atr(atrLen)
swingStop = goLong?ta.lowest(low,swingLen)-syminfo.mintick:goShort?ta.highest(high,swingLen)+syminfo.mintick:na
atrStop   = goLong?close-atrMult*atr20:goShort?close+atrMult*atr20:na
stopPrice = stopMode=="Swing"?swingStop:atrStop
var float activeStop = na
if goLong or goShort
    activeStop := stopPrice
if not inRun
    activeStop := na

// ==== LIMIT TARGET LINE LOGIC ====
var float activeLimit = na
limitAtr  = ta.atr(limitAtrLen)
limitBar  = goLong?close+limitAtr*limitMult:goShort?close-limitAtr*limitMult:na
if goLong or goShort
    activeLimit := limitBar
if not inRun
    activeLimit := na
limitSeries = showLimit and not na(activeLimit)?activeLimit:na
plot(limitSeries, title="Limit Target", style=plot.style_line, linewidth=1, color=limitColor, display=showLimit ? display.all : display.none)

// ==== MTF SQUEEZE PANEL LOGIC ====
mtfCSV0 = (showMtfM?"M,":"") + (showMtfW?"W,":"") + (showMtfD?"D,":"") + (showMtf4H?"4H,":"") + (showMtf2H?"2H,":"") + (showMtf60?"60,":"") + (showMtf30?"30,":"") + (showMtf15?"15,":"") + (showMtf5?"5,":"") + (showMtf1?"1,":"")
mtfCSV  = str.endswith(mtfCSV0,",")? str.substring(mtfCSV0,0,str.length(mtfCSV0)-1):mtfCSV0
tfList  = str.split(mtfCSV,",")
nCols   = array.size(tfList)
var table mtfTbl = table.new(position.top_center, nCols, 1, frame_color=color.gray, border_width=1)

if showMtfPanel and nCols > 0
    tier = tight ? 0 : medium ? 1 : loose ? 2 : 3
    for i = 0 to nCols - 1
        rawTf = array.get(tfList, i)
        tfLen = str.length(rawTf)
        isH   = str.substring(rawTf, tfLen - 1, tfLen) == "H"
        base  = isH ? str.substring(rawTf, 0, tfLen - 1) : rawTf
        resTf = isH ? str.tostring(str.tonumber(base) * 60) : base
        code  = request.security(syminfo.tickerid, resTf, tier)
        bg    = code == 0 ? mtfColorHigh : code == 1 ? mtfColorMedium : code == 2 ? mtfColorLow : mtfColorFire
        table.cell(mtfTbl, i, 0, text=rawTf, bgcolor=bg, text_color=color.white, text_size=size.large)

// ==== STOP LINE PLOT AND ALERTS ====
stopSeries = showStop and not na(activeStop)?activeStop:na
plot(stopSeries, title="Stop", style=plot.style_line, linewidth=1, color=stopColor, display=showStop ? display.all : display.none)
alertcondition(goLong, title="Squeeze Long",  message="{{ticker}} - Long GO! on {{interval}}")
alertcondition(goShort,title="Squeeze Short", message="{{ticker}} - Short GO! on {{interval}}")

// ==== BAR COLORING ====
barcolor(chosenColor)