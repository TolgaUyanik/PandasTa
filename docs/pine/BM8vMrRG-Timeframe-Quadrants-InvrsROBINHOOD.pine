//@version=5
indicator("Timeframe Quadrants | InvrsROBINHOOD", overlay=true)

// —————— User Inputs ——————
// Group for general settings
string group_general = "General Settings"
string timeframe_choice = input.string("Day", "Timeframe", options=["Minute", "Hour","Day", "Week", "Month", "Year"], group=group_general, tooltip="Select the timeframe to divide into four quadrants.")
string display_method = input.string("Background Color", "Display Method", options=["Background Color", "Bar Overlay"], group=group_general, tooltip="Choose how to display the quadrants.")

// Timezone settings
string tz_method = input.string("Dropdown", "Timezone Method", options=["Dropdown", "Custom UTC Offset"], group=group_general, tooltip="Choose how to set the timezone.")
string dropdown_timezone = input.string("America/New_York", "  ↳ from Dropdown", options=["UTC", "America/New_York", "America/Chicago", "America/Los_Angeles", "Europe/London", "Europe/Paris", "Asia/Tokyo", "Asia/Hong_Kong", "Australia/Sydney"], group=group_general, tooltip="Select a standard timezone from the list. Used if 'Dropdown' is selected.")
int custom_utc_offset = input.int(-4, "  ↳ Custom UTC Offset", group=group_general, tooltip="Enter a custom UTC offset (e.g., -5 for UTC-5, 8 for UTC+8). Used if 'Custom UTC Offset' is selected.")

// Determine the final timezone string to use
var string final_timezone = ""
if tz_method == "Dropdown"
    final_timezone := dropdown_timezone
else
    // Construct the "Etc/GMT" string. Note the inverted sign for GMT standard.
    // Etc/GMT+5 is UTC-5, Etc/GMT-5 is UTC+5.
    if custom_utc_offset == 0
        final_timezone := "UTC"
    else
        string gmt_offset_str = custom_utc_offset > 0 ? "Etc/GMT-" + str.tostring(custom_utc_offset) : "Etc/GMT+" + str.tostring(math.abs(custom_utc_offset))
        final_timezone := gmt_offset_str

// Group for color settings
string group_colors = "Quadrant Colors"
int transparency = input.int(85, "Transparency %", minval=0, maxval=100, group=group_colors, tooltip="Set the transparency for the quadrant colors.")
color color_q1 = input.color(color.green, "Quadrant 1", group=group_colors, inline="q1")
color color_q2 = input.color(color.yellow, "Quadrant 2", group=group_colors, inline="q2")
color color_q3 = input.color(color.blue, "Quadrant 3", group=group_colors, inline="q3")
color color_q4 = input.color(color.purple, "Quadrant 4", group=group_colors, inline="q4")

// —————— Quadrant Logic ——————
// Declare the variable with an explicit 'color' type
var color quadrant_color = na

// Determine the quadrant based on the selected timeframe
if timeframe_choice == "Hour"
    // Hourly quadrants are divided into 15-minute blocks.
    int minute_in_tz = minute(time, final_timezone)
    if minute_in_tz >= 0 and minute_in_tz < 15
        quadrant_color := color_q1
    else if minute_in_tz >= 15 and minute_in_tz < 30
        quadrant_color := color_q2
    else if minute_in_tz >= 30 and minute_in_tz < 45
        quadrant_color := color_q3
    else // minute 45-59
        quadrant_color := color_q4

else if timeframe_choice == "Minute"
    // Minute quadrants are divided into 15-second blocks.
    int second_in_tz = second(time, final_timezone)
    if second_in_tz >= 0 and second_in_tz < 15
        quadrant_color := color_q1
    else if second_in_tz >= 15 and second_in_tz < 30
        quadrant_color := color_q2
    else if second_in_tz >= 30 and second_in_tz < 45
        quadrant_color := color_q3
    else // second 45-59
        quadrant_color := color_q4

else if timeframe_choice == "Day"
    // Daily quadrants are divided into 6-hour blocks in the specified timezone.
    int hour_in_tz = hour(time, final_timezone)
    if hour_in_tz >= 0 and hour_in_tz <= 5
        quadrant_color := color_q1
    else if hour_in_tz >= 6 and hour_in_tz <= 11
        quadrant_color := color_q2
    else if hour_in_tz >= 12 and hour_in_tz <= 17
        quadrant_color := color_q3
    else
        quadrant_color := color_q4

else if timeframe_choice == "Week"
    // Weekly quadrants are divided into four 42-hour blocks, starting Sunday 00:00.
    // We calculate the total hours passed since Sunday 00:00 in the specified timezone.
    int current_day_of_week_in_tz = dayofweek(time, final_timezone) // Sunday is 1, Monday is 2, etc.
    int hour_in_tz = hour(time, final_timezone)
    
    // Total hours from the start of Sunday (Sunday at 00:00 is hour 0 of the week)
    int hours_since_week_start = (current_day_of_week_in_tz - 1) * 24 + hour_in_tz

    if hours_since_week_start < 42
        quadrant_color := color_q1
    else if hours_since_week_start < 84
        quadrant_color := color_q2
    else if hours_since_week_start < 126
        quadrant_color := color_q3
    else // hours 126 to 167
        quadrant_color := color_q4

else if timeframe_choice == "Month"
    // Monthly quadrants are divided into approximate weeks.
    if dayofmonth >= 1 and dayofmonth <= 7
        quadrant_color := color_q1
    else if dayofmonth >= 8 and dayofmonth <= 14
        quadrant_color := color_q2
    else if dayofmonth >= 15 and dayofmonth <= 21
        quadrant_color := color_q3
    else // Day 22 onwards
        quadrant_color := color_q4

else if timeframe_choice == "Year"
    // Yearly quadrants are the calendar quarters.
    if month >= 1 and month <= 3
        quadrant_color := color_q1
    else if month >= 4 and month <= 6
        quadrant_color := color_q2
    else if month >= 7 and month <= 9
        quadrant_color := color_q3
    else // Months 10-12
        quadrant_color := color_q4

// —————— Vertical Line Logic ——————
// This section draws a vertical line at the beginning of the selected timeframe period.

// Detect the start of a new period by checking for a change in the date component in the selected timezone.
bool is_new_minute = ta.change(minute(time, final_timezone)) != 0
bool is_new_hour = ta.change(hour(time, final_timezone)) != 0
bool is_new_day = ta.change(dayofmonth(time, final_timezone)) != 0
// For the week, we define the start as Sunday 00:00. We detect this by checking if the current bar is a Sunday and the previous bar was not.
bool is_new_week = dayofweek(time, final_timezone) == dayofweek.sunday and dayofweek(time[1], final_timezone) != dayofweek.sunday
bool is_new_month = ta.change(month(time, final_timezone)) != 0
bool is_new_year = ta.change(year(time, final_timezone)) != 0

// Determine when to draw the line based on user's timeframe selection
bool draw_line = (timeframe_choice == "Minute" and is_new_minute) or
                 (timeframe_choice == "Hour" and is_new_hour) or
                 (timeframe_choice == "Day" and is_new_day) or
                 (timeframe_choice == "Week" and is_new_week) or
                 (timeframe_choice == "Month" and is_new_month) or
                 (timeframe_choice == "Year" and is_new_year)


// —————— Display Logic ——————
// Create a new color with the user-defined transparency
color final_quadrant_color = color.new(quadrant_color, transparency)

// Determine the color to use for the quadrant background
color background_color_to_plot = display_method == "Background Color" ? final_quadrant_color : na
// Determine the color to use for the bar overlay
color bar_color_to_plot = display_method == "Bar Overlay" ? final_quadrant_color : na

// If a vertical line should be drawn, it takes precedence for the background color.
color final_background_color = draw_line ? color.new(color.black, 40) : background_color_to_plot

// Apply the colors
bgcolor(final_background_color, title="Quadrant Background")
barcolor(bar_color_to_plot, title="Quadrant Bar Color")
