//@version=5
// @description A library for trading with mathematical indicators as described by J. Welles Wilder Jr. in 1978
library("New_Concepts_in_Technical_Trading_Systems")

// @function calculates the parabolic SAR for the given series. Uses defaults as described by Wilder
// @param highSeries the series of high price values
// @param lowSeries the series of low price values
// @param closeSeries the series of close price values
// @param start the initial acceleration factor
// @param increment amount the acceleration factor is incremented each step
// @param max the maximum acceleration factor
// @returns the value of the stop and reverse price
export psar(series float highSeries = high, series float lowSeries = low, series float closeSeries = close, float start = 0.02, float increment = 0.02, float max = 0.2) =>
	var float result = na
    var float maxMin = na
    var float acceleration = na
    var bool isBelow = na
    bool isFirstTrendBar = false
    
    if bar_index == 1
        if closeSeries > closeSeries[1]
            isBelow := true
            maxMin := highSeries
            result := lowSeries[1]
        else
            isBelow := false
            maxMin := lowSeries
            result := highSeries[1]
        isFirstTrendBar := true
        acceleration := start
    
    result := result + acceleration * (maxMin - result)
    
    if isBelow
        if result > lowSeries
            isFirstTrendBar := true
            isBelow := false
            result := math.max(highSeries, maxMin)
            maxMin := lowSeries
            acceleration := start
    else
        if result < highSeries
            isFirstTrendBar := true
            isBelow := true
            result := math.min(lowSeries, maxMin)
            maxMin := highSeries
            acceleration := start
            
    if not isFirstTrendBar
        if isBelow
            if highSeries > maxMin
                maxMin := highSeries
                acceleration := math.min(acceleration + increment, max)
        else
            if lowSeries < maxMin
                maxMin := lowSeries
                acceleration := math.min(acceleration + increment, max)
    
    if isBelow
        result := math.min(result, lowSeries[1])
        if bar_index > 1
            result := math.min(result, lowSeries[2])
        
    else
        result := math.max(result, highSeries[1])
        if bar_index > 1
            result := math.max(result, highSeries[2])

// @function calculates the momentum value, representing an acceleration of the current trend direction
// @param closeSeries the series of close price values
// @returns the value of the momentum
export momentum(series float closeSeries = close) =>
	closeSeries - closeSeries[2]

// @function calculates the trend balance point for the next candle when short
// @param closeSeries the series of close price values
// @returns the point the price must close above in order to reverse the current position
export nextTrendBalancePointShort(series float closeSeries = close) =>
	mom = momentum(closeSeries)
	closeSeries[1] + math.max(mom[1], mom[2])

// @function calculates the trend balance point for the next candle when long
// @param closeSeries the series of close price values
// @returns the point the price must close below in order to reverse the current position
export nextTrendBalancePointLong(series float closeSeries = close) =>
	mom = momentum(closeSeries)
	closeSeries[1] + math.min(mom[1], mom[2])

