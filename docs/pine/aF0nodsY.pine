//@version=6
// =========================
// 参数设置
// =========================
groupTrend = "趋势条件"
groupVCP   = "VCP条件"
groupVol   = "量能条件"
groupPivot = "突破条件"
groupPlot  = "图形显示"

maShortLen = input.int(10, "短均线", minval=1, group=groupTrend)
maMidLen   = input.int(20, "中均线", minval=1, group=groupTrend)
maLongLen  = input.int(50, "长均线", minval=1, group=groupTrend)

lookback1  = input.int(80, "大周期观察长度", minval=20, group=groupVCP)
lookback2  = input.int(40, "中周期观察长度", minval=10, group=groupVCP)
lookback3  = input.int(20, "小周期观察长度", minval=5, group=groupVCP)

maxPullback1 = input.float(0.30, "第一次最大回撤(30%=0.30)", step=0.01, group=groupVCP)
maxPullback2 = input.float(0.18, "第二次最大回撤(18%=0.18)", step=0.01, group=groupVCP)
maxPullback3 = input.float(0.10, "第三次最大回撤(10%=0.10)", step=0.01, group=groupVCP)

volShortLen = input.int(10, "短量均", minval=1, group=groupVol)
volLongLen  = input.int(50, "长量均", minval=5, group=groupVol)
breakVolMul = input.float(1.5, "突破放量倍数", step=0.1, group=groupVol)

pivotLen    = input.int(20, "突破平台长度", minval=5, group=groupPivot)
stopATRLen  = input.int(14, "ATR长度", minval=1, group=groupPivot)
stopATRMult = input.float(1.5, "ATR止损倍数", step=0.1, group=groupPivot)

showPivotLine = input.bool(true, "显示Pivot线", group=groupPlot)
showLabels    = input.bool(true, "显示标签", group=groupPlot)
showBg        = input.bool(true, "信号背景着色", group=groupPlot)

// =========================
// 趋势条件
// =========================
maShort = ta.sma(close, maShortLen)
maMid   = ta.sma(close, maMidLen)
maLong  = ta.sma(close, maLongLen)

trendUp = close > maLong and maShort > maMid and maMid > maLong

// =========================
// VCP收缩判定
// 核心思路：三个周期内回撤逐级变小
// =========================
hh1 = ta.highest(high, lookback1)
ll1 = ta.lowest(low, lookback1)
pullback1 = hh1 > 0 ? (hh1 - ll1) / hh1 : na

hh2 = ta.highest(high, lookback2)
ll2 = ta.lowest(low, lookback2)
pullback2 = hh2 > 0 ? (hh2 - ll2) / hh2 : na

hh3 = ta.highest(high, lookback3)
ll3 = ta.lowest(low, lookback3)
pullback3 = hh3 > 0 ? (hh3 - ll3) / hh3 : na

// 回撤逐级收缩
contraction = pullback1 <= maxPullback1 and
              pullback2 <= maxPullback2 and
              pullback3 <= maxPullback3 and
              pullback1 > pullback2 and
              pullback2 > pullback3

// 低点抬高（简化版）
higherLow = ll3 > ll2 * 0.98 and ll2 > ll1 * 0.95

vcpCore = contraction and higherLow

// =========================
// 量能条件
// 回调量缩、突破放量
// =========================
volShort = ta.sma(volume, volShortLen)
volLong  = ta.sma(volume, volLongLen)

volDryUp = volShort < volLong
breakoutVol = volume > volShort * breakVolMul

// =========================
// Pivot突破位
// =========================
pivot = ta.highest(high[1], pivotLen)   // 用前N天高点作为突破位
breakout = close > pivot and high > pivot

// 突破确认
vcpBreakout = trendUp and vcpCore and breakout and breakoutVol

// =========================
// 风险控制：止损位
// =========================
atr = ta.atr(stopATRLen)
stopPrice = close - atr * stopATRMult

// 失效逻辑：跌回pivot下方
failedBreakout = ta.crossunder(close, pivot)

// =========================
// 绘图
// =========================
plot(maShort, color=color.new(color.blue, 0), title="MA Short")
plot(maMid,   color=color.new(color.orange, 0), title="MA Mid")
plot(maLong,  color=color.new(color.yellow, 0), title="MA Long")

plot(showPivotLine ? pivot : na, color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr, title="Pivot")

bgcolor(showBg and vcpCore ? color.new(color.teal, 90) : na)
bgcolor(showBg and vcpBreakout ? color.new(color.green, 82) : na)
bgcolor(showBg and failedBreakout ? color.new(color.red, 85) : na)

// 买点信号
plotshape(vcpBreakout, title="VCP Breakout", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.large, text="VCP")

// 失效信号
plotshape(failedBreakout, title="Failed Breakout", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal, text="Fail")

// 标签
if showLabels and vcpBreakout
    label.new(bar_index, low, 
      "VCP突破\nPivot: " + str.tostring(pivot, format.mintick) +
      "\n止损参考: " + str.tostring(stopPrice, format.mintick),
      style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white)

if showLabels and failedBreakout
    label.new(bar_index, high, 
      "跌回Pivot下方\n注意假突破",
      style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)

// =========================
// 提醒条件
// =========================
alertcondition(vcpCore, title="VCP结构形成", message="VCP结构已形成，关注突破机会")
alertcondition(vcpBreakout, title="VCP突破", message="VCP突破信号出现")
alertcondition(failedBreakout, title="VCP失败", message="价格跌回Pivot下方，注意假突破")// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
