//@version=6
// -----------------------------------------------------------------------------
// Previous Day Levels & Stats (PDH/PDL) - High and Low, Wicks, Gaps
// by Market Slice
//
// Shows how your symbol has historically behaved at yesterday's high and low,
// based on yesterday's candle color and on where today opened: inside
// yesterday's range, gapped above the prior day high, or gapped below the
// prior day low. Every statistic is counted from the symbol's full daily
// history using bar-close-confirmed events. Levels and stats roll to the
// just-completed day at the market close, so evening and pre-market
// preparation always shows the right day. Optional visuals: prior-day
// OHLC level lines, a large prior-day candle, a projection of yesterday's
// candle across today, and typical-run levels.
//
// Full methodology is explained in the published description.
// -----------------------------------------------------------------------------
indicator("Previous Day Levels & Stats (PDH/PDL) - High and Low, Wicks, Gaps", shorttitle = "PD Levels & Stats [Market Slice]", overlay = true, max_boxes_count = 20, max_lines_count = 30)

// ============================== INPUTS =======================================
grpT = "Table"
tblPosIn  = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right", "Middle left"], group = grpT)
tblSizeIn = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = grpT, tooltip = "Size of the table text.")
tblFocusIn = input.bool(true, "After the open, show only the matching section", group = grpT, tooltip = "Once today's 9:30 open classifies the day, the table shows only the section that applies - the inside-open rows or the gap rows. The full table returns at the 4:00 close for next-day preparation (needs extended-hours bars on the chart, same as the level flip). Off: both sections always show, with the non-applicable one dimmed.")

grpE = "Extension yardstick"
adrLen = input.int(20, "ADR length (days)", minval = 2, maxval = 200, group = grpE, tooltip = "The Runs past level row measures each break day's run past the level in multiples of the average daily range (high minus low), then converts to dollars at today's average. This sets how many days that average covers.")

grpL = "Prior-Day OHLC Lines"
showLines = input.bool(false, "Show level lines", group = grpL, tooltip = "Extends yesterday's open, high, low, and close as level lines across today. Independent of the other two visuals.")
lineSpanIn  = input.string("RTH only (9:30-16:00)", "Line span", options = ["Full session", "RTH only (9:30-16:00)", "Right of large candle", "Right of current price"], group = grpL, tooltip = "Where the lines run across today. Right of large candle starts them at the glyph (or at the live bar when the glyph floats by price); Right of current price starts them at the live bar. Both end at 16:00.")
lineStyleIn = input.string("Dashed", "Line style", options = ["Solid", "Dashed", "Dotted"], group = grpL)
lineWidthIn = input.int(1, "Line width", minval = 1, maxval = 4, group = grpL)
lineMatch   = input.bool(true, "Match prior-day color", group = grpL, tooltip = "On: lines take yesterday's candle color. Off: the fixed color below.")
lineColorIn = input.color(color.new(#787B86, 30), "Line color", group = grpL)
lineLabels  = input.bool(false, "Level labels (PDO/PDH/PDL/PDC)", group = grpL, tooltip = "Tiny tags at the line ends so stacked levels stay identifiable.")

grpG = "Prior-Day Candle - Large Visual"
showGlyph    = input.bool(false, "Show large candle", group = grpG, tooltip = "A large glyph of yesterday's candle - body, wicks, color.")
glyphPlaceIn = input.string("Before RTH open (9:30)", "Placement", options = ["Before RTH open (9:30)", "Before the day's first bar", "Right of current price", "Left of current price"], group = grpG, tooltip = "Before RTH open locks the glyph just left of today's 9:30 bar - over the last pre-market bars when those are shown (it floats right of price until 9:30 arrives). Before the day's first bar anchors it left of the day's very first bar. Right/Left of current price float it with the live bar - Left sits over recent bars, so Shaded or Hollow reads best there.")
glyphDist    = input.int(3, "Distance from price (bars)", minval = 1, maxval = 100, group = grpG, tooltip = "Used by the Right/Left of current price placements.")
glyphWidth   = input.int(8, "Candle width (bars)", minval = 3, maxval = 30, group = grpG)
glyphStyleIn = input.string("Shaded", "Appearance", options = ["Shaded", "Solid", "Hollow"], group = grpG, tooltip = "Shaded: translucent body. Solid: opaque body. Hollow: outline only.")

grpP = "Prior-Day Candle - Projection Overlay"
showProj    = input.bool(true, "Show projection", group = grpP, tooltip = "Projects yesterday's candle over today's session - its body edges and wick zones are exactly the levels the table counts. Intraday charts only; the table works on any timeframe.")
projWinIn   = input.string("RTH (9:30-16:00)", "Projection window", options = ["RTH (9:30-16:00)", "Full day", "Pre-market (4:00-9:30)", "Post-market (16:00-20:00)", "Custom"], group = grpP, tooltip = "Which part of today the projection covers. Presets are US-stock exchange hours; Custom takes any HHMM-HHMM session for other markets (an overnight session rolls its end to tomorrow).")
projSessIn  = input.session("0930-1600", "Custom session", group = grpP)
projStyleIn = input.string("Layered glow", "Appearance", options = ["Layered glow", "Blocks", "Outline only", "Filled"], group = grpP, tooltip = "Layered glow: faint body fill, halo'd edges, wick zones fading to the extremes. Blocks: flat body block with lighter wick blocks. Outline only: quiet box outline. Filled: bold translucent block.")
blkMatch    = input.bool(true, "Match prior-day color (Blocks)", group = grpP, tooltip = "On: the Blocks appearance tints from yesterday's candle color. Off: the fixed body/wick colors below.")
blkBodyIn   = input.color(color.new(#26A69A, 60), "Body", inline = "blk", group = grpP)
blkWickIn   = input.color(color.new(#26A69A, 85), "Wick", inline = "blk", group = grpP, tooltip = "Blocks appearance only.")
showMid     = input.bool(false, "Body midline (50% of open-close)", group = grpP, tooltip = "Dotted line at the middle of yesterday's body - the equilibrium level.")

grpR = "Typical-Run Levels"
showRuns  = input.bool(false, "Show typical-run levels", group = grpR, tooltip = "Lines at the table's Typical run past level distances - PDH plus the run and PDL minus the run. Drawn only on days that opened inside the prior day's range (the stat describes inside-open break days), so they appear once today's 9:30 open confirms an inside day.")
runShowIn = input.string("Median", "Show", options = ["Median", "1-in-4 (P75)", "Both"], group = grpR, tooltip = "Median is the typical run. 1-in-4 is the distance only a quarter of held breaks exceed.")
runMedColIn = input.color(#FFEB3B, "Median", inline = "rm", group = grpR)
runMedWidth = input.int(1, "", minval = 1, maxval = 4, inline = "rm", group = grpR)
runMedStyle = input.string("Glow", "", options = ["Glow", "Solid", "Dashed", "Dotted"], inline = "rm", group = grpR)
runP75ColIn = input.color(color.new(#FFEB3B, 45), "1-in-4", inline = "rp", group = grpR)
runP75Width = input.int(1, "", minval = 1, maxval = 4, inline = "rp", group = grpR)
runP75Style = input.string("Dashed", "", options = ["Glow", "Solid", "Dashed", "Dotted"], inline = "rp", group = grpR, tooltip = "Color, width, and style per line. Glow draws a soft halo of the chosen color under the line. The lines keep these colors in every table theme.")

grpK = "Colors"
themeIn = input.string("Tide", "Table theme", options = ["Tide", "Ember", "Slate", "Paper"], group = grpK, tooltip = "Preset looks for the stats table only. Tide and Ember shade cell backgrounds by how far a stat sits from 50/50; Slate carries that in the text color instead; Paper is built for light charts. Candle and typical-run line colors are set by their own inputs and are not changed by the theme.")
bullColIn = input.color(#26A69A, "Bull", inline = "bb", group = grpK)
bearColIn = input.color(#EF5350, "Bear", inline = "bb", group = grpK, tooltip = "Yesterday's candle color, used by all three visuals (lines can override via Match prior-day color).")

// ============================== THEME ENGINE =================================
// Themes style the TABLE only. Typical-run line colors always come from their
// inputs, and bull/bear candle colors stay on their own inputs - both carry
// chart meaning the table look should not override.
color AMBER = #FAC775
color DIMC  = #787B86
color PANEL = #1A1E2B
color BRDC  = #2A2E39

bool  thMono   = themeIn == "Slate"
color tPanel  = themeIn == "Tide" ? #0F1722 : themeIn == "Slate" ? #0D1420 : themeIn == "Paper" ? #FBFAF6 : PANEL
color tBorder = themeIn == "Tide" ? #1E2A38 : themeIn == "Slate" ? #1C2433 : themeIn == "Paper" ? #DDD8CA : BRDC
color tLabel  = themeIn == "Tide" ? #8FA3B0 : themeIn == "Slate" ? #9AA3B5 : themeIn == "Paper" ? #6D6A5F : #9BA0AE
color tAccent = themeIn == "Tide" ? #2FBFA5 : themeIn == "Slate" ? #7FB2FF : themeIn == "Paper" ? #B78A2E : AMBER
color tHdrTxt = themeIn == "Paper" ? #4A2020 : #E6E8EE
// heat ramps: background blends base -> deep accent; ink shifts within one
// family (no light/dark flip). Slate keeps the panel flat and grades ink only.
color tBaseBg = themeIn == "Tide" ? #12202A : themeIn == "Slate" ? tPanel : themeIn == "Paper" ? #F7F3E8 : #241F1A
color tHotBg  = themeIn == "Tide" ? #12806E : themeIn == "Slate" ? tPanel : themeIn == "Paper" ? #E0B45F : #9A6A1C
color tInkLo  = themeIn == "Tide" ? #B6C3C9 : themeIn == "Slate" ? #6B7588 : themeIn == "Paper" ? #5A5645 : #B9BDC9
color tInkHi  = themeIn == "Tide" ? #E2F7F1 : themeIn == "Slate" ? #7FE0B0 : themeIn == "Paper" ? #2D1F06 : #F6E6C0

// ============================== DAILY-CONTEXT STATS ==========================
// Runs inside the "D" security context. On each daily bar: the CONDITION is
// the color of the PRIOR daily bar; today is classified by where it OPENED
// relative to the prior bar's range (inside / gap up / gap down); EVENTS are
// measured on THIS bar. The whole result array is [1]-offset at the return
// line, so the chart only ever reads accumulators as of the last COMPLETED
// daily bar. Array index map is documented at the chart-side extraction.
f_dailyStats() =>
    float prevO = open[1]
    float prevH = high[1]
    float prevL = low[1]
    float prevC = close[1]
    bool  prevRed   = prevC < prevO
    bool  prevGreen = prevC > prevO
    float prevBodyTop = math.max(prevO, prevC)
    float prevBodyBot = math.min(prevO, prevC)
    bool  hasUpWick = prevH > prevBodyTop
    bool  hasDnWick = prevL < prevBodyBot
    // ADR yardstick - computed unconditionally every bar (ta.* consistency).
    // prevAdr excludes this bar's own range from its own yardstick.
    float rngAdr  = ta.sma(high - low, adrLen)
    float prevAdr = rngAdr[1]
    bool  okRng   = not na(prevAdr) and prevAdr > 0
    // ---- open-location classification (vs prior bar's range) ----
    bool openInside = open <= prevH and open >= prevL
    bool gapUp      = open > prevH
    bool gapDn      = open < prevL
    // ---- inside-open events, PDH side ----
    bool insWRejH  = openInside and hasUpWick and high >= prevBodyTop and high < prevH and close < prevBodyTop
    bool insWInH   = openInside and hasUpWick and high >= prevBodyTop and high < prevH and close >= prevBodyTop
    bool insBFailH = openInside and high >= prevH and close <= prevH
    bool insBHeldH = openInside and high >= prevH and close > prevH
    // ---- inside-open events, PDL side ----
    bool insWRejL  = openInside and hasDnWick and low <= prevBodyBot and low > prevL and close > prevBodyBot
    bool insWInL   = openInside and hasDnWick and low <= prevBodyBot and low > prevL and close <= prevBodyBot
    bool insBFailL = openInside and low <= prevL and close >= prevL
    bool insBHeldL = openInside and low <= prevL and close < prevL
    // ---- gap-up events (opened above PDH) ----
    bool guNever = gapUp and low > prevH
    bool guWDeep = gapUp and low <= prevH and low >= prevBodyTop
    bool guWRej  = guWDeep and close > prevH
    bool guBRej  = gapUp and low < prevBodyTop and close > prevH
    bool guCWick = gapUp and close <= prevH and close >= prevBodyTop
    bool guCBody = gapUp and close < prevBodyTop and close >= prevBodyBot
    bool guCFar  = gapUp and close < prevBodyBot and close >= prevL
    bool guCThru = gapUp and close < prevL
    // ---- gap-down events (opened below PDL) ----
    bool gdNever = gapDn and high < prevL
    bool gdWDeep = gapDn and high >= prevL and high <= prevBodyBot
    bool gdWRej  = gdWDeep and close < prevL
    bool gdBRej  = gapDn and high > prevBodyBot and close < prevL
    bool gdCWick = gapDn and close >= prevL and close <= prevBodyBot
    bool gdCBody = gapDn and close > prevBodyBot and close <= prevBodyTop
    bool gdCFar  = gapDn and close > prevBodyTop and close <= prevH
    bool gdCThru = gapDn and close > prevH
    // ---- accumulators: prior-RED condition ----
    var int nR = 0
    var int contR = 0
    var int nInR = 0
    var int wRejHR = 0
    var int wInHR = 0
    var int bFailHR = 0
    var int bHeldHR = 0
    var int wRejLR = 0
    var int wInLR = 0
    var int bFailLR = 0
    var int bHeldLR = 0
    var int nGuR = 0
    var int nevGuR = 0
    var int wDeepGuR = 0
    var int wRejGuR = 0
    var int bRejGuR = 0
    var int cWickGuR = 0
    var int cBodyGuR = 0
    var int cFarGuR = 0
    var int cThruGuR = 0
    var int nGdR = 0
    var int nevGdR = 0
    var int wDeepGdR = 0
    var int wRejGdR = 0
    var int bRejGdR = 0
    var int cWickGdR = 0
    var int cBodyGdR = 0
    var int cFarGdR = 0
    var int cThruGdR = 0
    var array<float> extHR = array.new_float()
    var array<float> extLR = array.new_float()
    // ---- accumulators: prior-GREEN condition ----
    var int nG = 0
    var int contG = 0
    var int nInG = 0
    var int wRejHG = 0
    var int wInHG = 0
    var int bFailHG = 0
    var int bHeldHG = 0
    var int wRejLG = 0
    var int wInLG = 0
    var int bFailLG = 0
    var int bHeldLG = 0
    var int nGuG = 0
    var int nevGuG = 0
    var int wDeepGuG = 0
    var int wRejGuG = 0
    var int bRejGuG = 0
    var int cWickGuG = 0
    var int cBodyGuG = 0
    var int cFarGuG = 0
    var int cThruGuG = 0
    var int nGdG = 0
    var int nevGdG = 0
    var int wDeepGdG = 0
    var int wRejGdG = 0
    var int bRejGdG = 0
    var int cWickGdG = 0
    var int cBodyGdG = 0
    var int cFarGdG = 0
    var int cThruGdG = 0
    var array<float> extHG = array.new_float()
    var array<float> extLG = array.new_float()
    if prevRed and not na(prevO)
        nR += 1
        contR    += close < open ? 1 : 0
        nInR     += openInside ? 1 : 0
        wRejHR   += insWRejH ? 1 : 0
        wInHR    += insWInH ? 1 : 0
        bFailHR  += insBFailH ? 1 : 0
        bHeldHR  += insBHeldH ? 1 : 0
        wRejLR   += insWRejL ? 1 : 0
        wInLR    += insWInL ? 1 : 0
        bFailLR  += insBFailL ? 1 : 0
        bHeldLR  += insBHeldL ? 1 : 0
        nGuR     += gapUp ? 1 : 0
        nevGuR   += guNever ? 1 : 0
        wDeepGuR += guWDeep ? 1 : 0
        wRejGuR  += guWRej ? 1 : 0
        bRejGuR  += guBRej ? 1 : 0
        cWickGuR += guCWick ? 1 : 0
        cBodyGuR += guCBody ? 1 : 0
        cFarGuR  += guCFar ? 1 : 0
        cThruGuR += guCThru ? 1 : 0
        nGdR     += gapDn ? 1 : 0
        nevGdR   += gdNever ? 1 : 0
        wDeepGdR += gdWDeep ? 1 : 0
        wRejGdR  += gdWRej ? 1 : 0
        bRejGdR  += gdBRej ? 1 : 0
        cWickGdR += gdCWick ? 1 : 0
        cBodyGdR += gdCBody ? 1 : 0
        cFarGdR  += gdCFar ? 1 : 0
        cThruGdR += gdCThru ? 1 : 0
        if insBHeldH and okRng
            array.push(extHR, (high - prevH) / prevAdr)
        if insBHeldL and okRng
            array.push(extLR, (prevL - low) / prevAdr)
    if prevGreen and not na(prevO)
        nG += 1
        contG    += close > open ? 1 : 0
        nInG     += openInside ? 1 : 0
        wRejHG   += insWRejH ? 1 : 0
        wInHG    += insWInH ? 1 : 0
        bFailHG  += insBFailH ? 1 : 0
        bHeldHG  += insBHeldH ? 1 : 0
        wRejLG   += insWRejL ? 1 : 0
        wInLG    += insWInL ? 1 : 0
        bFailLG  += insBFailL ? 1 : 0
        bHeldLG  += insBHeldL ? 1 : 0
        nGuG     += gapUp ? 1 : 0
        nevGuG   += guNever ? 1 : 0
        wDeepGuG += guWDeep ? 1 : 0
        wRejGuG  += guWRej ? 1 : 0
        bRejGuG  += guBRej ? 1 : 0
        cWickGuG += guCWick ? 1 : 0
        cBodyGuG += guCBody ? 1 : 0
        cFarGuG  += guCFar ? 1 : 0
        cThruGuG += guCThru ? 1 : 0
        nGdG     += gapDn ? 1 : 0
        nevGdG   += gdNever ? 1 : 0
        wDeepGdG += gdWDeep ? 1 : 0
        wRejGdG  += gdWRej ? 1 : 0
        bRejGdG  += gdBRej ? 1 : 0
        cWickGdG += gdCWick ? 1 : 0
        cBodyGdG += gdCBody ? 1 : 0
        cFarGdG  += gdCFar ? 1 : 0
        cThruGdG += gdCThru ? 1 : 0
        if insBHeldH and okRng
            array.push(extHG, (high - prevH) / prevAdr)
        if insBHeldL and okRng
            array.push(extLG, (prevL - low) / prevAdr)
    float medHR = array.size(extHR) > 0 ? array.percentile_nearest_rank(extHR, 50) : na
    float p75HR = array.size(extHR) > 0 ? array.percentile_nearest_rank(extHR, 75) : na
    float medLR = array.size(extLR) > 0 ? array.percentile_nearest_rank(extLR, 50) : na
    float p75LR = array.size(extLR) > 0 ? array.percentile_nearest_rank(extLR, 75) : na
    float medHG = array.size(extHG) > 0 ? array.percentile_nearest_rank(extHG, 50) : na
    float p75HG = array.size(extHG) > 0 ? array.percentile_nearest_rank(extHG, 75) : na
    float medLG = array.size(extLG) > 0 ? array.percentile_nearest_rank(extLG, 50) : na
    float p75LG = array.size(extLG) > 0 ? array.percentile_nearest_rank(extLG, 75) : na
    // Select the set that applies TOMORROW (this bar's color), so the prior-
    // bar copy of this array carries the set for yesterday's color. A doji
    // (close == open) carries the most recent non-doji color forward; slot 38
    // hands that effective color to the chart so the header, glyph,
    // projection, and lines all tint with it.
    var bool condG = false
    if close > open
        condG := true
    else if close < open
        condG := false
    bool iG = condG
    array<float> a = array.new_float()
    array.push(a, iG ? nG : nR)                //  0 condition days
    array.push(a, iG ? contG : contR)          //  1 continued same color
    array.push(a, iG ? nInG : nInR)            //  2 opened inside
    array.push(a, iG ? wRejHG : wRejHR)        //  3 in: wick rejected, PDH side
    array.push(a, iG ? wInHG : wInHR)          //  4 in: reached wick, closed in it, PDH
    array.push(a, iG ? bFailHG : bFailHR)      //  5 in: broke but failed, PDH
    array.push(a, iG ? bHeldHG : bHeldHR)      //  6 in: broke and held, PDH
    array.push(a, iG ? medHG : medHR)          //  7 in: median run ratio, PDH
    array.push(a, iG ? p75HG : p75HR)          //  8 in: P75 run ratio, PDH
    array.push(a, iG ? wRejLG : wRejLR)        //  9 in: wick rejected, PDL side
    array.push(a, iG ? wInLG : wInLR)          // 10 in: reached wick, closed in it, PDL
    array.push(a, iG ? bFailLG : bFailLR)      // 11 in: broke but failed, PDL
    array.push(a, iG ? bHeldLG : bHeldLR)      // 12 in: broke and held, PDL
    array.push(a, iG ? medLG : medLR)          // 13 in: median run ratio, PDL
    array.push(a, iG ? p75LG : p75LR)          // 14 in: P75 run ratio, PDL
    array.push(a, iG ? nGuG : nGuR)            // 15 gap-up days
    array.push(a, iG ? nevGuG : nevGuR)        // 16 gu: never re-entered
    array.push(a, iG ? wDeepGuG : wDeepGuR)    // 17 gu: pullback stopped in wick
    array.push(a, iG ? wRejGuG : wRejGuR)      // 18 gu: wick rejected (closed back above)
    array.push(a, iG ? bRejGuG : bRejGuR)      // 19 gu: body rejected (closed back above)
    array.push(a, iG ? cWickGuG : cWickGuR)    // 20 gu: closed in upper wick
    array.push(a, iG ? cBodyGuG : cBodyGuR)    // 21 gu: closed in body
    array.push(a, iG ? cFarGuG : cFarGuR)      // 22 gu: closed in lower wick
    array.push(a, iG ? cThruGuG : cThruGuR)    // 23 gu: closed below PDL
    array.push(a, iG ? nGdG : nGdR)            // 24 gap-down days
    array.push(a, iG ? nevGdG : nevGdR)        // 25 gd: never re-entered
    array.push(a, iG ? wDeepGdG : wDeepGdR)    // 26 gd: pullback stopped in wick
    array.push(a, iG ? wRejGdG : wRejGdR)      // 27 gd: wick rejected (closed back below)
    array.push(a, iG ? bRejGdG : bRejGdR)      // 28 gd: body rejected (closed back below)
    array.push(a, iG ? cWickGdG : cWickGdR)    // 29 gd: closed in lower wick
    array.push(a, iG ? cBodyGdG : cBodyGdR)    // 30 gd: closed in body
    array.push(a, iG ? cFarGdG : cFarGdR)      // 31 gd: closed in upper wick
    array.push(a, iG ? cThruGdG : cThruGdR)    // 32 gd: closed above PDH
    array.push(a, rngAdr[1])                   // 33 today's completed-days ADR
    array.push(a, open)                        // 34 pd open  (after [1] offset)
    array.push(a, high)                        // 35 pd high
    array.push(a, low)                         // 36 pd low
    array.push(a, close)                       // 37 pd close
    array.push(a, condG ? 1.0 : 0.0)           // 38 effective condition (1 = green; a doji carries the prior color)
    // Two copies travel to the chart in one delivery: slots 0-38 are the
    // prior completed day's set (this array as of one bar ago) and slots
    // 39-77 are this bar's own set. Regular-hours bars read the first copy;
    // pre/post-market bars read the second, so the display flips to the
    // just-finished day at the close instead of waiting for the next open.
    array<float> prevA = a[1]
    array<float> m = na
    if not na(prevA)
        m := array.copy(prevA)
        array.concat(m, a)
    m

array<float> S = request.security(syminfo.tickerid, "D", f_dailyStats(), lookahead = barmerge.lookahead_on)

// Which copy applies to this bar: regular-hours bars read the prior completed
// day (base 0); pre/post-market bars read the just-completed day (base 39).
// 24-hour markets have no pre/post-market, so they always stay on base 0.
bool ethBar = timeframe.isintraday and (session.ispremarket or session.ispostmarket)
int baseIdx = ethBar ? 39 : 0
f_g(int i) => na(S) ? na : array.get(S, baseIdx + i)

// chart-side extraction (index map mirrors the pushes above)
// 0: condition-day count / 1: continued same color - accumulated, not displayed (short tooltips)
float sIn      = f_g(2)
float sWRejH   = f_g(3)
// 4: reached upper wick, closed in it - accumulated, not displayed
float sBFailH  = f_g(5)
float sBHeldH  = f_g(6)
float sMedH    = f_g(7)
float sP75H    = f_g(8)
float sWRejL   = f_g(9)
// 10: reached lower wick, closed in it - accumulated, not displayed
float sBFailL  = f_g(11)
float sBHeldL  = f_g(12)
float sMedL    = f_g(13)
float sP75L    = f_g(14)
float sNGu     = f_g(15)
float sNevGu   = f_g(16)
// 17: pullback stopped in wick - accumulated, not displayed
float sWRejGu  = f_g(18)
float sBRejGu  = f_g(19)
float sCWickGu = f_g(20)
float sCBodyGu = f_g(21)
float sCFarGu  = f_g(22)
float sCThruGu = f_g(23)
float sNGd     = f_g(24)
float sNevGd   = f_g(25)
// 26: pullback stopped in wick - accumulated, not displayed
float sWRejGd  = f_g(27)
float sBRejGd  = f_g(28)
float sCWickGd = f_g(29)
float sCBodyGd = f_g(30)
float sCFarGd  = f_g(31)
float sCThruGd = f_g(32)
float sAdr     = f_g(33)
float pdO      = f_g(34)
float pdH      = f_g(35)
float pdL      = f_g(36)
float pdC      = f_g(37)

// Which condition applies TODAY = yesterday's color. A doji yesterday has
// no color of its own: the effective condition (slot 38) carries the most
// recent non-doji color, and every visual tints with it; only the table
// header goes neutral and flags the doji.
bool yRed   = pdC < pdO
bool yGreen = pdC > pdO
bool yDoji  = not na(pdO) and not na(pdC) and not yRed and not yGreen
bool yEffG  = f_g(38) == 1.0
color pdCol = yEffG ? bullColIn : bearColIn

// today's session bounds + open classification (shared by table and visuals)
var int dayStartT   = na
var int dayStartIdx = na
var int rthStartIdx = na
var float rthOpen   = na
if timeframe.change("D")
    dayStartT   := time
    dayStartIdx := bar_index
    rthStartIdx := na
    rthOpen     := na
if na(rthStartIdx) and timeframe.isintraday and time >= timestamp(syminfo.timezone, year, month, dayofmonth, 9, 30)
    rthStartIdx := bar_index
    rthOpen     := open
int dayEndT = time_close("D")
// 0 = unknown (before today's 9:30 open, on non-intraday charts, or on any
// pre/post-market bar - once the prior day flips at the close, the open that
// pairs with it is the NEXT session's, which doesn't exist yet), 1 = opened
// inside prior day's range, 2 = gapped above PDH, 3 = gapped below PDL
int openClass = ethBar or na(rthOpen) or na(pdH) or na(pdL) ? 0 : rthOpen > pdH ? 2 : rthOpen < pdL ? 3 : 1

// ============================== TABLE (themed intensity) =====================
f_pct(float a, float b) => not na(b) and b > 0 ? 100.0 * a / b : na
// conviction: distance from a coin flip, 0..1 (0 = 50/50, 1 = always or never)
f_conv(float pct) => na(pct) ? na : math.min(math.abs(pct - 50.0) / 50.0, 1.0)
f_convAdr(float x) => na(x) ? na : math.min(x, 1.0)
// cell style from conviction: background and ink blend toward the theme's
// deep accent - one text family the whole range, no light/dark flip
f_cellBg(float t) =>
    na(t) ? color.new(tPanel, 100) : color.from_gradient(t, 0.0, 1.0, tBaseBg, tHotBg)
f_cellInk(float t) =>
    na(t) ? tLabel : color.from_gradient(t, 0.0, 1.0, tInkLo, tInkHi)
f_pos(string s) =>
    s == "Top right"     ? position.top_right     :
     s == "Top left"      ? position.top_left      :
     s == "Bottom right"  ? position.bottom_right  :
     s == "Bottom left"   ? position.bottom_left   :
     s == "Middle right"  ? position.middle_right  : position.middle_left
f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : size.normal
f_v(float pct) => na(pct) ? "-" : str.tostring(pct, "#") + "%"
f_c(float v)   => na(v) ? "0" : str.tostring(v, "#")
f_d(float v)   => na(v) ? "-" : "~$" + str.tostring(v, format.mintick)

// The table is deleted and rebuilt on every update - the same pattern the
// live-layer boxes and lines below already use. A fresh table means the
// section-header merges always happen on brand-new cells (re-merging an
// already-merged cell is a Pine runtime error) and lets focus mode change
// which sections exist from one render to the next.
var table tbl = na

// grid row builder: label cell + PDH value cell + PDL value cell, each styled
// from its conviction by the theme engine, with its own tooltip (global scope
// - Pine does not allow function declarations inside local blocks)
f_row(int rowIdx, string lbl, string lblTip, string vH, float tH, string tipH, bool dimH, string vL, float tL, string tipL, bool dimL, string tsz) =>
    string fam = thMono ? font.family_monospace : font.family_default
    table.cell(tbl, 0, rowIdx, " " + lbl, text_color = dimH and dimL ? color.new(tLabel, 55) : tLabel, text_size = tsz, tooltip = lblTip == "" ? tipH + " / " + tipL : lblTip, text_halign = text.align_left)
    table.cell(tbl, 1, rowIdx, vH + " ", text_color = dimH ? color.new(tLabel, 35) : f_cellInk(tH), text_size = tsz, tooltip = tipH, text_halign = text.align_right, bgcolor = dimH ? color.new(tPanel, 100) : f_cellBg(tH), text_font_family = fam)
    table.cell(tbl, 2, rowIdx, vL + " ", text_color = dimL ? color.new(tLabel, 35) : f_cellInk(tL), text_size = tsz, tooltip = tipL, text_halign = text.align_right, bgcolor = dimL ? color.new(tPanel, 100) : f_cellBg(tL), text_font_family = fam)
f_sect(int rowIdx, string txt, string tip, bool active) =>
    table.cell(tbl, 0, rowIdx, txt, text_color = active ? tAccent : tLabel, text_size = size.tiny, tooltip = tip, text_halign = text.align_center, bgcolor = color.new(tAccent, active ? 88 : 100))

if barstate.islast and not na(S)
    if not na(tbl)
        table.delete(tbl)
    tbl := table.new(f_pos(tblPosIn), 3, 14, bgcolor = tPanel, frame_color = tBorder, frame_width = 1, border_color = tBorder, border_width = 1)
    string tsz = f_size(tblSizeIn)
    string condW = yGreen ? "green" : "red"
    // active-section flags from today's open classification (neutral until 9:30)
    bool actIns = openClass == 1
    bool actGap = openClass == 2 or openClass == 3
    bool dimIns = actGap
    bool dimGu  = openClass == 1 or openClass == 3
    bool dimGd  = openClass == 1 or openClass == 2
    // focus mode: once the 9:30 open classifies the day, draw only the
    // matching section; any ETH bar resets openClass to 0 (see above),
    // which re-expands the table to both sections for preparation
    bool focusOn = tblFocusIn and openClass != 0
    bool showIns = not focusOn or openClass == 1
    bool showGap = not focusOn or openClass != 1
    // derived counts
    float gHeldGu  = sNGu - (sCWickGu + sCBodyGu + sCFarGu + sCThruGu)
    float gHeldGd  = sNGd - (sCWickGd + sCBodyGd + sCFarGd + sCThruGd)
    float cInsGu   = sCWickGu + sCBodyGu + sCFarGu
    float cInsGd   = sCWickGd + sCBodyGd + sCFarGd
    float backGu   = sNGu - sNevGu
    float backGd   = sNGd - sNevGd
    // percentages
    float pWRejH   = f_pct(sWRejH, sIn)
    float pWRejL   = f_pct(sWRejL, sIn)
    float pBFailH  = f_pct(sBFailH, sIn)
    float pBFailL  = f_pct(sBFailL, sIn)
    float pBHeldH  = f_pct(sBHeldH, sIn)
    float pBHeldL  = f_pct(sBHeldL, sIn)
    float pGHeldGu = f_pct(gHeldGu, sNGu)
    float pGHeldGd = f_pct(gHeldGd, sNGd)
    float pBackGu  = f_pct(backGu, sNGu)
    float pBackGd  = f_pct(backGd, sNGd)
    float pWRejGu  = f_pct(sWRejGu, sNGu)
    float pWRejGd  = f_pct(sWRejGd, sNGd)
    float pBRejGu  = f_pct(sBRejGu, sNGu)
    float pBRejGd  = f_pct(sBRejGd, sNGd)
    float pCInsGu  = f_pct(cInsGu, sNGu)
    float pCInsGd  = f_pct(cInsGd, sNGd)
    float pCThruGu = f_pct(sCThruGu, sNGu)
    float pCThruGd = f_pct(sCThruGd, sNGd)
    // extension dollars (median ratio x today's ADR)
    float dMedH = sMedH * sAdr
    float dP75H = sP75H * sAdr
    float dMedL = sMedL * sAdr
    float dP75L = sP75L * sAdr
    // ---- header: 3-cell stepped fade in yesterday's color ----
    string hdrTxt = yDoji ? "AFTER A DOJI DAY*" : yGreen ? "AFTER A GREEN DAY" : "AFTER A RED DAY"
    string hdrTip = yDoji ? "Yesterday closed exactly where it opened - a doji, neither red nor green. Data for the table on doji days is set to the color of the candle prior to the doji day." : "What today has historically done after the prior day being a " + condW + " day."
    color hdrCol = yDoji ? tLabel : pdCol
    table.cell(tbl, 0, 0, hdrTxt, text_color = tHdrTxt, text_size = tsz, tooltip = hdrTip, text_halign = text.align_left, bgcolor = color.new(hdrCol, 70))
    table.cell(tbl, 1, 0, "", text_size = tsz, tooltip = hdrTip, bgcolor = color.new(hdrCol, 84))
    table.cell(tbl, 2, 0, "", text_size = tsz, tooltip = hdrTip, bgcolor = color.new(hdrCol, 93))
    table.cell(tbl, 0, 1, "", text_size = tsz)
    table.cell(tbl, 1, 1, "PDH", text_color = tLabel, text_size = size.tiny, text_halign = text.align_right, tooltip = "This column is in relation to the prior day high level.")
    table.cell(tbl, 2, 1, "PDL", text_color = tLabel, text_size = size.tiny, text_halign = text.align_right, tooltip = "This column is in relation to the prior day low level.")
    // ---- section: opened inside ----
    if showIns
        f_sect(2, "OPENED INSIDE", "Days that opened inside the prior day's range.", actIns)
        table.merge_cells(tbl, 0, 2, 2, 2)
        f_row(3, "Wick rejected", "Traded into the wick but never broke PDH or PDL, then closed back inside the body.",
             f_v(pWRejH), f_conv(pWRejH), "Opened inside, traded into the upper wick, never broke PDH, closed back below the wick. Based on " + f_c(sIn) + " inside-open days.", dimIns,
             f_v(pWRejL), f_conv(pWRejL), "Opened inside, traded into the lower wick, never broke PDL, closed back above the wick. Based on " + f_c(sIn) + " inside-open days.", dimIns, tsz)
        f_row(4, "Broke but failed", "Broke PDH or PDL but closed the day back inside the previous day's candle.",
             f_v(pBFailH), f_conv(pBFailH), "Opened inside, broke above PDH, closed back below it. Based on " + f_c(sIn) + " inside-open days.", dimIns,
             f_v(pBFailL), f_conv(pBFailL), "Opened inside, broke below PDL, closed back above it. Based on " + f_c(sIn) + " inside-open days.", dimIns, tsz)
        f_row(5, "Broke & held beyond", "Broke PDH or PDL and closed the day beyond the previous day's candle.",
             f_v(pBHeldH), f_conv(pBHeldH), "Opened inside, broke above PDH, and closed the day above it. Based on " + f_c(sIn) + " inside-open days.", dimIns,
             f_v(pBHeldL), f_conv(pBHeldL), "Opened inside, broke below PDL, and closed the day below it. Based on " + f_c(sIn) + " inside-open days.", dimIns, tsz)
        f_row(6, "Typical run past level", "The typical (median) distance price runs past PDH or PDL when a break holds, shown in today's dollars.",
             f_d(dMedH), f_convAdr(sMedH), "Typical (median) run past PDH when a break holds, in today's dollars. About 1 in 4 run further than " + f_d(dP75H) + ". From " + f_c(sBHeldH) + " held breaks.", dimIns,
             f_d(dMedL), f_convAdr(sMedL), "Typical (median) run past PDL when a break holds, in today's dollars. About 1 in 4 run further than " + f_d(dP75L) + ". From " + f_c(sBHeldL) + " held breaks.", dimIns, tsz)
    // ---- section: gapped past the level ----
    if showGap
        f_sect(7, "GAPPED PAST THE LEVEL", "Days that opened beyond the level - gap-up days in the PDH column, gap-down days in the PDL column.", actGap)
        table.merge_cells(tbl, 0, 7, 2, 7)
        f_row(8, "Gap fill", "Price came back and touched the PDH or PDL it gapped past.",
             f_v(pBackGu), f_conv(pBackGu), "Gapped above PDH and price traded back down to touch PDH during the day. Counted when the day's low reaches the level - not the close, and not the prior day's closing price. Based on " + f_c(sNGu) + " gap-up days.", dimGu,
             f_v(pBackGd), f_conv(pBackGd), "Gapped below PDL and price traded back up to touch PDL during the day. Counted when the day's high reaches the level - not the close, and not the prior day's closing price. Based on " + f_c(sNGd) + " gap-down days.", dimGd, tsz)
        f_row(9, "Wick rejected", "Pulled back into the wick only, then closed back beyond PDH or PDL.",
             f_v(pWRejGu), f_conv(pWRejGu), "Gapped above PDH, pulled back into the upper wick only, and closed back above PDH. Based on " + f_c(sNGu) + " gap-up days.", dimGu,
             f_v(pWRejGd), f_conv(pWRejGd), "Gapped below PDL, pulled back into the lower wick only, and closed back below PDL. Based on " + f_c(sNGd) + " gap-down days.", dimGd, tsz)
        f_row(10, "Body rejected", "Pulled back into the body, but still closed back beyond PDH or PDL.",
             f_v(pBRejGu), f_conv(pBRejGu), "Gapped above PDH, pulled back into the body, and still closed back above PDH. Based on " + f_c(sNGu) + " gap-up days.", dimGu,
             f_v(pBRejGd), f_conv(pBRejGd), "Gapped below PDL, pulled back into the body, and still closed back below PDL. Based on " + f_c(sNGd) + " gap-down days.", dimGd, tsz)
        f_row(11, "Closed back inside", "Closed the day back inside the previous day's range.",
             f_v(pCInsGu), f_conv(pCInsGu), "Gapped above PDH but closed the day back inside the prior day's range. Based on " + f_c(sNGu) + " gap-up days.", dimGu,
             f_v(pCInsGd), f_conv(pCInsGd), "Gapped below PDL but closed the day back inside the prior day's range. Based on " + f_c(sNGd) + " gap-down days.", dimGd, tsz)
        f_row(12, "Closed through", "Closed on the far side of the previous day's range - the full reversal.",
             f_v(pCThruGu), f_conv(pCThruGu), "Gapped above PDH and closed below PDL - the full reversal. Based on " + f_c(sNGu) + " gap-up days.", dimGu,
             f_v(pCThruGd), f_conv(pCThruGd), "Gapped below PDL and closed above PDH - the full reversal. Based on " + f_c(sNGd) + " gap-down days.", dimGd, tsz)
        f_row(13, "Gap held", "Gapped past PDH or PDL and closed the day still on that side of the previous day's candle, regardless of what happened in between.",
             f_v(pGHeldGu), f_conv(pGHeldGu), "Gapped above PDH and closed the day still above it, regardless of what happened in between - includes days that never pulled back and days that pulled back and recovered. Based on " + f_c(sNGu) + " gap-up days.", dimGu,
             f_v(pGHeldGd), f_conv(pGHeldGd), "Gapped below PDL and closed the day still below it, regardless of what happened in between - includes days that never pulled back and days that pulled back and recovered. Based on " + f_c(sNGd) + " gap-down days.", dimGd, tsz)

// ============================== PRIOR-DAY CANDLE =============================
f_lstyle(string s) => s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

// live-layer registries (delete-and-recreate on last bar)
var array<box>   lvBoxes  = array.new<box>()
var array<line>  lvLines  = array.new<line>()
var array<label> lvLabels = array.new<label>()
f_clearLive() =>
    if array.size(lvBoxes) > 0
        for i = 0 to array.size(lvBoxes) - 1
            box.delete(array.get(lvBoxes, i))
        array.clear(lvBoxes)
    if array.size(lvLines) > 0
        for i = 0 to array.size(lvLines) - 1
            line.delete(array.get(lvLines, i))
        array.clear(lvLines)
    if array.size(lvLabels) > 0
        for i = 0 to array.size(lvLabels) - 1
            label.delete(array.get(lvLabels, i))
        array.clear(lvLabels)
f_box(int l, float t, int r, float b, color brd, color bg) =>
    array.push(lvBoxes, box.new(l, t, r, b, xloc = xloc.bar_time, border_color = brd, bgcolor = bg))
f_hline(int l, float y, int r, color c, int w, string sty) =>
    array.push(lvLines, line.new(l, y, r, y, xloc = xloc.bar_time, color = c, width = w, style = sty))

// "HHMM-HHMM" -> today's start/end timestamps in exchange time; an end at or
// before the start is treated as an overnight session and rolls to tomorrow
f_sessTimes(string s) =>
    int h1 = math.round(str.tonumber(str.substring(s, 0, 2)))
    int m1 = math.round(str.tonumber(str.substring(s, 2, 4)))
    int h2 = math.round(str.tonumber(str.substring(s, 5, 7)))
    int m2 = math.round(str.tonumber(str.substring(s, 7, 9)))
    int t1 = timestamp(syminfo.timezone, year, month, dayofmonth, h1, m1)
    int t2 = timestamp(syminfo.timezone, year, month, dayofmonth, h2, m2)
    t2 := t2 <= t1 ? t2 + 86400000 : t2
    [t1, t2]

// one O/H/L/C level line + optional end label (global scope - Pine does not
// allow function declarations inside local blocks)
f_lvl(int x1, float y, int x2, color c, string nm) =>
    f_hline(x1, y, x2, c, lineWidthIn, f_lstyle(lineStyleIn))
    if lineLabels
        array.push(lvLabels, label.new(x2, y, nm, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = DIMC, size = size.tiny))

// typical-run level line - Glow draws a soft halo of the chosen color under
// the core line; other styles draw the core line only
f_runline(int x1, float y, int x2, color c, int w, string sty) =>
    if sty == "Glow"
        f_hline(x1, y, x2, color.new(c, 87), w + 4, line.style_solid)
        f_hline(x1, y, x2, c, w, line.style_solid)
    else
        f_hline(x1, y, x2, c, w, f_lstyle(sty))

if barstate.islast and timeframe.isintraday and not na(pdO) and not na(dayStartT)
    f_clearLive()
    float bTop = math.max(pdO, pdC)
    float bBot = math.min(pdO, pdC)
    bool  hasUpW = pdH > bTop
    bool  hasDnW = pdL < bBot
    color noC = color.new(pdCol, 100)
    int rthS = timestamp(syminfo.timezone, year, month, dayofmonth, 9, 30)
    int rthE = timestamp(syminfo.timezone, year, month, dayofmonth, 16, 0)
    // ---- projection window ----
    int projStart = rthS
    int projEnd   = rthE
    if projWinIn == "Full day"
        projStart := dayStartT
        projEnd   := dayEndT
    if projWinIn == "Pre-market (4:00-9:30)"
        projStart := timestamp(syminfo.timezone, year, month, dayofmonth, 4, 0)
        projEnd   := rthS
    if projWinIn == "Post-market (16:00-20:00)"
        projStart := rthE
        projEnd   := timestamp(syminfo.timezone, year, month, dayofmonth, 20, 0)
    if projWinIn == "Custom"
        [cs, ce] = f_sessTimes(projSessIn)
        projStart := cs
        projEnd   := ce
    // ---- PROJECTION OVERLAY ----
    if showProj
        if projStyleIn == "Layered glow"
            // ambient-soft: faint body fill, halo'd body edges, wick zones
            // fading outward in 3 steps all the way to the extremes
            f_box(projStart, bTop, projEnd, bBot, noC, color.new(pdCol, 96))
            f_hline(projStart, bTop, projEnd, color.new(pdCol, 87), 5, line.style_solid)
            f_hline(projStart, bTop, projEnd, color.new(pdCol, 30), 1, line.style_solid)
            f_hline(projStart, bBot, projEnd, color.new(pdCol, 87), 5, line.style_solid)
            f_hline(projStart, bBot, projEnd, color.new(pdCol, 30), 1, line.style_solid)
            if hasUpW
                float s = (pdH - bTop) / 3.0
                f_box(projStart, bTop + s,     projEnd, bTop,         noC, color.new(pdCol, 90))
                f_box(projStart, bTop + 2 * s, projEnd, bTop + s,     noC, color.new(pdCol, 93))
                f_box(projStart, pdH,          projEnd, bTop + 2 * s, noC, color.new(pdCol, 96))
            if hasDnW
                float s = (bBot - pdL) / 3.0
                f_box(projStart, bBot,         projEnd, bBot - s,     noC, color.new(pdCol, 90))
                f_box(projStart, bBot - s,     projEnd, bBot - 2 * s, noC, color.new(pdCol, 93))
                f_box(projStart, bBot - 2 * s, projEnd, pdL,          noC, color.new(pdCol, 96))
        if projStyleIn == "Blocks"
            // flat blocks: one body block + lighter wick blocks, no lines
            color bodyC = blkMatch ? color.new(pdCol, 60) : blkBodyIn
            color wickC = blkMatch ? color.new(pdCol, 85) : blkWickIn
            array.push(lvBoxes, box.new(projStart, bTop, projEnd, bBot, xloc = xloc.bar_time, border_color = color.new(bodyC, 100), bgcolor = bodyC))
            if hasUpW
                array.push(lvBoxes, box.new(projStart, pdH, projEnd, bTop, xloc = xloc.bar_time, border_color = color.new(wickC, 100), bgcolor = wickC))
            if hasDnW
                array.push(lvBoxes, box.new(projStart, bBot, projEnd, pdL, xloc = xloc.bar_time, border_color = color.new(wickC, 100), bgcolor = wickC))
        if projStyleIn == "Outline only"
            // quiet outline: body box outline + dashed extremes, nothing filled
            array.push(lvBoxes, box.new(projStart, bTop, projEnd, bBot, xloc = xloc.bar_time, border_color = color.new(pdCol, 30), bgcolor = noC))
            if hasUpW
                f_hline(projStart, pdH, projEnd, color.new(pdCol, 45), 1, line.style_dashed)
            if hasDnW
                f_hline(projStart, pdL, projEnd, color.new(pdCol, 45), 1, line.style_dashed)
        if projStyleIn == "Filled"
            // bold translucent block + dashed extremes
            array.push(lvBoxes, box.new(projStart, bTop, projEnd, bBot, xloc = xloc.bar_time, border_color = color.new(pdCol, 30), bgcolor = color.new(pdCol, 75)))
            if hasUpW
                f_hline(projStart, pdH, projEnd, color.new(pdCol, 45), 1, line.style_dashed)
            if hasDnW
                f_hline(projStart, pdL, projEnd, color.new(pdCol, 45), 1, line.style_dashed)
        if showMid
            f_hline(projStart, (bTop + bBot) / 2.0, projEnd, color.new(pdCol, 55), 1, line.style_dotted)
    // ---- TYPICAL-RUN LEVELS (inside-open days only; hidden until 9:30 confirms) ----
    if showRuns and openClass == 1
        bool doMed = runShowIn == "Median" or runShowIn == "Both"
        bool doP75 = runShowIn != "Median"
        float rMedH = sMedH * sAdr
        float rMedL = sMedL * sAdr
        float rP75H = sP75H * sAdr
        float rP75L = sP75L * sAdr
        if doMed and not na(rMedH)
            f_runline(projStart, pdH + rMedH, projEnd, runMedColIn, runMedWidth, runMedStyle)
        if doMed and not na(rMedL)
            f_runline(projStart, pdL - rMedL, projEnd, runMedColIn, runMedWidth, runMedStyle)
        if doP75 and not na(rP75H)
            f_runline(projStart, pdH + rP75H, projEnd, runP75ColIn, runP75Width, runP75Style)
        if doP75 and not na(rP75L)
            f_runline(projStart, pdL - rP75L, projEnd, runP75ColIn, runP75Width, runP75Style)
    // ---- LARGE GLYPH ----
    if showGlyph
        int gl = 0
        if glyphPlaceIn == "Before RTH open (9:30)"
            // locked left of the 9:30 bar once RTH starts (sits over the last
            // pre-market bars when shown); floats right of price until then
            gl := na(rthStartIdx) ? bar_index + glyphDist : rthStartIdx - (glyphWidth + 2)
        else if glyphPlaceIn == "Before the day's first bar"
            gl := dayStartIdx - (glyphWidth + 2)
        else if glyphPlaceIn == "Right of current price"
            gl := bar_index + glyphDist
        else
            gl := bar_index - glyphDist - glyphWidth
        int gr = gl + glyphWidth
        int wx = gl + glyphWidth / 2
        color gFill = glyphStyleIn == "Solid" ? pdCol : glyphStyleIn == "Hollow" ? noC : color.new(pdCol, 65)
        array.push(lvBoxes, box.new(gl, bTop, gr, bBot, xloc = xloc.bar_index, border_color = pdCol, bgcolor = gFill))
        if hasUpW
            array.push(lvLines, line.new(wx, bTop, wx, pdH, xloc = xloc.bar_index, color = pdCol, width = 1))
        if hasDnW
            array.push(lvLines, line.new(wx, pdL, wx, bBot, xloc = xloc.bar_index, color = pdCol, width = 1))
    // ---- OHLC LEVEL LINES ----
    if showLines
        color lc = lineMatch ? color.new(pdCol, 40) : lineColorIn
        int lnStart = dayStartT
        int lnEnd   = dayEndT
        if lineSpanIn == "RTH only (9:30-16:00)"
            lnStart := rthS
            lnEnd   := rthE
        if lineSpanIn == "Right of large candle"
            // start at the glyph: anchored glyph -> from its session start;
            // floating glyph (or glyph off) -> from the live bar
            lnStart := time
            if showGlyph and glyphPlaceIn == "Before the day's first bar"
                lnStart := dayStartT
            if showGlyph and glyphPlaceIn == "Before RTH open (9:30)" and not na(rthStartIdx)
                lnStart := rthS
            lnEnd   := rthE
        if lineSpanIn == "Right of current price"
            lnStart := time
            lnEnd   := rthE
        f_lvl(lnStart, pdO, lnEnd, lc, "PDO")
        f_lvl(lnStart, pdH, lnEnd, lc, "PDH")
        f_lvl(lnStart, pdL, lnEnd, lc, "PDL")
        f_lvl(lnStart, pdC, lnEnd, lc, "PDC")
