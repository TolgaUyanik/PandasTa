//@version=6
// @description Full asset correlation library for SMT divergence detection. Drop-in replacement for fstarcapital/AssetCorrelationUtils/11.
library("EKAssetCorrelation", overlay=true)

// @type Core asset pairing structure for triad/dyad configurations
// @field primary The primary (chart) asset ticker ID
// @field secondary The secondary correlated asset ticker ID
// @field tertiary The tertiary correlated asset ticker ID (empty for dyad)
// @field quaternary The quaternary correlated asset ticker ID (empty unless quad mode)
// @field invertSecondary Whether secondary asset should be inverted for divergence calc
// @field invertTertiary Whether tertiary asset should be inverted for divergence calc
// @field invertQuaternary Whether quaternary asset should be inverted for divergence calc
export type AssetPairing
    string primary        = ""
    string secondary      = ""
    string tertiary       = ""
    string quaternary     = ""
    bool   invertSecondary = false
    bool   invertTertiary  = false
    bool   invertQuaternary = false

// @type Full asset resolution result with mode detection and computed values
// @field detected Whether auto-detection succeeded
// @field isTriadMode True if triad (3 assets), false if dyad (2 assets)
// @field isQuadMode True if quad (4 assets)
// @field primary The resolved primary asset ticker ID
// @field secondary The resolved secondary asset ticker ID
// @field tertiary The resolved tertiary asset ticker ID (empty for dyad)
// @field quaternary The resolved quaternary asset ticker ID (empty unless quad mode)
// @field invertSecondary Computed inversion flag for secondary asset
// @field invertTertiary Computed inversion flag for tertiary asset
// @field invertQuaternary Computed inversion flag for quaternary asset
// @field assetCategory String describing the detected asset category
export type AssetConfig
    bool   detected        = false
    bool   isTriadMode     = true
    bool   isQuadMode      = false
    string primary         = ""
    string secondary       = ""
    string tertiary        = ""
    string quaternary      = ""
    bool   invertSecondary = false
    bool   invertTertiary  = false
    bool   invertQuaternary = false
    string assetCategory   = "unknown"

// @function Detects Index Futures (NQ/ES/YM/RTY + micro variants)
// @param ticker The ticker string to check (typically syminfo.ticker)
// @returns AssetPairing with secondary and tertiary assets configured
export detectIndicesFutures(string ticker) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "NQ") and not str.contains(ticker, "MNQ")
        result.secondary := "CME_MINI:ES1!"
        result.tertiary := "CBOT_MINI:YM1!"
        result.quaternary := "CME_MINI:RTY1!"
        result.invertTertiary := false
    else if str.contains(ticker, "ES") and not str.contains(ticker, "MES")
        result.secondary := "CME_MINI:NQ1!"
        result.tertiary := "CBOT_MINI:YM1!"
        result.quaternary := "CME_MINI:RTY1!"
        result.invertTertiary := false
    else if str.contains(ticker, "YM") and not str.contains(ticker, "MYM")
        result.secondary := "CME_MINI:NQ1!"
        result.tertiary := "CME_MINI:ES1!"
        result.quaternary := "CME_MINI:RTY1!"
        result.invertTertiary := false
    else if str.contains(ticker, "RTY") and not str.contains(ticker, "M2K")
        result.secondary := "CBOT_MINI:YM1!"
        result.tertiary := "CME_MINI:ES1!"
        result.quaternary := "CME_MINI:NQ1!"
        result.invertTertiary := false
    else if str.contains(ticker, "MNQ")
        result.secondary := "CME_MINI:ES1!"
        result.tertiary := "CBOT_MINI:YM1!"
        result.quaternary := "CME_MINI:RTY1!"
        result.invertTertiary := false
    else if str.contains(ticker, "MES")
        result.secondary := "CME_MINI:NQ1!"
        result.tertiary := "CBOT_MINI:YM1!"
        result.quaternary := "CME_MINI:RTY1!"
        result.invertTertiary := false
    else if str.contains(ticker, "MYM")
        result.secondary := "CME_MINI:NQ1!"
        result.tertiary := "CME_MINI:ES1!"
        result.quaternary := "CME_MINI:RTY1!"
        result.invertTertiary := false
    else if str.contains(ticker, "M2K")
        result.secondary := "CBOT_MINI:YM1!"
        result.tertiary := "CME_MINI:ES1!"
        result.quaternary := "CME_MINI:NQ1!"
        result.invertTertiary := false
    result

// @function Detects Metal Futures (GC/SI/HG + micro variants)
// @param ticker The ticker string to check
// @returns AssetPairing with secondary and tertiary assets configured
export detectMetalsFutures(string ticker) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "GC") and not str.contains(ticker, "MGC")
        result.secondary := "COMEX:SI1!"
        result.tertiary := "COMEX:HG1!"
        result.quaternary := "FOREXCOM:XAUEUR"
        result.invertTertiary := false
    else if str.contains(ticker, "SI") and not str.contains(ticker, "SIL")
        result.secondary := "COMEX:GC1!"
        result.tertiary := "COMEX:HG1!"
        result.quaternary := "OANDA:XAGEUR"
        result.invertTertiary := false
    else if str.contains(ticker, "HG") and not str.contains(ticker, "MHG")
        result.secondary := "COMEX:GC1!"
        result.tertiary := "COMEX:SI1!"
        result.invertTertiary := false
    else if str.contains(ticker, "MGC")
        result.secondary := "COMEX_MINI:SIL1!"
        result.tertiary := "COMEX_MINI:MHG1!"
        result.quaternary := "FOREXCOM:XAUEUR"
        result.invertTertiary := false
    else if str.contains(ticker, "SIL")
        result.secondary := "COMEX_MINI:MGC1!"
        result.tertiary := "COMEX_MINI:MHG1!"
        result.quaternary := "OANDA:XAGEUR"
        result.invertTertiary := false
    else if str.contains(ticker, "MHG")
        result.secondary := "COMEX_MINI:MGC1!"
        result.tertiary := "COMEX_MINI:SIL1!"
        result.invertTertiary := false
    result

// @function Detects Metal Futures in Quad Mode (Gold->SI/XAUEUR/XAUGBP, Silver->GC/XAGEUR/XAGGBP)
// @param ticker The ticker string to check
// @returns AssetPairing with futures secondary + GXT cross-pairs as tertiary/quaternary (empty for copper)
export detectMetalsFuturesQuad(string ticker) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "GC") and not str.contains(ticker, "MGC")
        result.secondary := "COMEX:SI1!"
        result.tertiary := "FOREXCOM:XAUEUR"
        result.quaternary := "FOREXCOM:XAUGBP"
    else if str.contains(ticker, "SI") and not str.contains(ticker, "SIL")
        result.secondary := "COMEX:GC1!"
        result.tertiary := "OANDA:XAGEUR"
        result.quaternary := "OANDA:XAGGBP"
    else if str.contains(ticker, "MGC")
        result.secondary := "COMEX_MINI:SIL1!"
        result.tertiary := "FOREXCOM:XAUEUR"
        result.quaternary := "FOREXCOM:XAUGBP"
    else if str.contains(ticker, "SIL")
        result.secondary := "COMEX_MINI:MGC1!"
        result.tertiary := "OANDA:XAGEUR"
        result.quaternary := "OANDA:XAGGBP"
    result

// @function Detects Metal Futures in GXT Mode (Gold->XAUEUR/XAUGBP, Silver->XAGEUR/XAGGBP)
// @param ticker The ticker string to check
// @returns AssetPairing with GXT secondary and tertiary assets (empty for copper)
export detectMetalsFuturesGxt(string ticker) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "GC") and not str.contains(ticker, "MGC")
        result.secondary := "FOREXCOM:XAUEUR"
        result.tertiary := "FOREXCOM:XAUGBP"
    else if str.contains(ticker, "SI") and not str.contains(ticker, "SIL")
        result.secondary := "OANDA:XAGEUR"
        result.tertiary := "OANDA:XAGGBP"
    else if str.contains(ticker, "MGC")
        result.secondary := "FOREXCOM:XAUEUR"
        result.tertiary := "FOREXCOM:XAUGBP"
    else if str.contains(ticker, "SIL")
        result.secondary := "OANDA:XAGEUR"
        result.tertiary := "OANDA:XAGGBP"
    result

// @function Detects Forex Futures (6E/6B + micro variants)
// @param ticker The ticker string to check
// @returns AssetPairing with secondary and tertiary assets configured
export detectForexFutures(string ticker) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "6E") and not str.contains(ticker, "M6E")
        result.secondary := "CME:6B1!"
        result.tertiary := "TVC:DXY"
        result.invertTertiary := true
    else if str.contains(ticker, "6B") and not str.contains(ticker, "M6B")
        result.secondary := "CME:6E1!"
        result.tertiary := "TVC:DXY"
        result.invertTertiary := true
    else if str.contains(ticker, "M6E")
        result.secondary := "CME:M6B1!"
        result.tertiary := "TVC:DXY"
        result.invertTertiary := true
    else if str.contains(ticker, "M6B")
        result.secondary := "CME:M6E1!"
        result.tertiary := "TVC:DXY"
        result.invertTertiary := true
    result

// @function Detects Energy Futures (CL/RB/HO + micro variants)
// @param ticker The ticker string to check
// @returns AssetPairing with secondary and tertiary assets configured
export detectEnergyFutures(string ticker) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "CL") and not str.contains(ticker, "MCL")
        result.secondary := "NYMEX:RB1!"
        result.tertiary := "NYMEX:HO1!"
        result.invertTertiary := false
    else if str.contains(ticker, "RB") and not str.contains(ticker, "MRB")
        result.secondary := "NYMEX:CL1!"
        result.tertiary := "NYMEX:HO1!"
        result.invertTertiary := false
    else if str.contains(ticker, "HO") and not str.contains(ticker, "MHO")
        result.secondary := "NYMEX:CL1!"
        result.tertiary := "NYMEX:RB1!"
        result.invertTertiary := false
    else if str.contains(ticker, "MCL")
        result.secondary := "NYMEX:RB1!"
        result.tertiary := "NYMEX:HO1!"
        result.invertTertiary := false
    else if str.contains(ticker, "MRB")
        result.secondary := "NYMEX:CL1!"
        result.tertiary := "NYMEX:HO1!"
        result.invertTertiary := false
    else if str.contains(ticker, "MHO")
        result.secondary := "NYMEX:CL1!"
        result.tertiary := "NYMEX:RB1!"
        result.invertTertiary := false
    result

// @function Detects Treasury Futures (ZB/ZF/ZN)
// @param ticker The ticker string to check
// @returns AssetPairing with secondary and tertiary assets configured
export detectTreasuryFutures(string ticker) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "ZB")
        result.secondary := "CBOT:ZF1!"
        result.tertiary := "CBOT:ZN1!"
        result.invertTertiary := false
    else if str.contains(ticker, "ZF")
        result.secondary := "CBOT:ZB1!"
        result.tertiary := "CBOT:ZN1!"
        result.invertTertiary := false
    else if str.contains(ticker, "ZN")
        result.secondary := "CBOT:ZB1!"
        result.tertiary := "CBOT:ZF1!"
        result.invertTertiary := false
    result

// @function Detects CME Crypto Futures (BTC/ETH + micro variants)
// @param ticker The ticker string to check
// @returns AssetPairing with secondary and tertiary assets configured
export detectCryptoFutures(string ticker) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "BTC") and not str.contains(ticker, "MBT")
        result.secondary := "CME:ETH1!"
        result.tertiary := "CRYPTOCAP:TOTAL3"
        result.invertTertiary := false
    else if str.contains(ticker, "ETH") and not str.contains(ticker, "MET")
        result.secondary := "CME:BTC1!"
        result.tertiary := "CRYPTOCAP:TOTAL3"
        result.invertTertiary := false
    else if str.contains(ticker, "MBT")
        result.secondary := "CME:ETH1!"
        result.tertiary := "CRYPTOCAP:TOTAL3"
        result.invertTertiary := false
    else if str.contains(ticker, "MET")
        result.secondary := "CME:BTC1!"
        result.tertiary := "CRYPTOCAP:TOTAL3"
        result.invertTertiary := false
    result

// @function Detects CAD Forex Futures (6C + micro variants)
// @param ticker The ticker string to check
// @returns AssetPairing with secondary and tertiary assets configured
export detectCADFutures(string ticker) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "6C") and not str.contains(ticker, "M6C")
        result.secondary := "FOREXCOM:USDCAD"
        result.tertiary := "TVC:DXY"
        result.invertSecondary := true
        result.invertTertiary := true
    else if str.contains(ticker, "M6C")
        result.secondary := "FOREXCOM:USDCAD"
        result.tertiary := "TVC:DXY"
        result.invertSecondary := true
        result.invertTertiary := true
    result

// @function Detects Forex CFD pairs (EUR/GBP/DXY, USD/JPY/CHF triads)
// @param ticker The ticker string to check
// @param tickerId The full ticker ID (syminfo.tickerid) for primary asset
// @returns AssetPairing with secondary and tertiary assets configured
export detectForexCFD(string ticker, string tickerId) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "EURUSD")
        result.primary := tickerId
        result.secondary := "FOREXCOM:GBPUSD"
        result.tertiary := "TVC:DXY"
        result.invertTertiary := true
    else if str.contains(ticker, "GBPUSD")
        result.primary := tickerId
        result.secondary := "FOREXCOM:EURUSD"
        result.tertiary := "TVC:DXY"
        result.invertTertiary := true
    else if str.contains(ticker, "DXY")
        result.primary := "FOREXCOM:EURUSD"
        result.secondary := "FOREXCOM:GBPUSD"
        result.tertiary := tickerId
        result.invertTertiary := true
    else if str.contains(ticker, "USDJPY")
        result.primary := tickerId
        result.secondary := "FOREXCOM:USDCHF"
        result.tertiary := "TVC:DXY"
        result.invertTertiary := false
    else if str.contains(ticker, "USDCHF")
        result.primary := tickerId
        result.secondary := "FOREXCOM:USDJPY"
        result.tertiary := "TVC:DXY"
        result.invertTertiary := false
    else if str.contains(ticker, "GBPJPY")
        result.primary := tickerId
        result.secondary := "FOREXCOM:EURJPY"
        result.tertiary := "TVC:JXY"
        result.invertTertiary := true
    else if str.contains(ticker, "EURJPY")
        result.primary := tickerId
        result.secondary := "FOREXCOM:GBPJPY"
        result.tertiary := "TVC:JXY"
        result.invertTertiary := true
    else if str.contains(ticker, "USDCAD")
        result.primary := tickerId
        result.secondary := "TVC:DXY"
        result.tertiary := "CME:6C1!"
        result.invertTertiary := true
    result

// @function Detects major Crypto assets (BTC, ETH, SOL, XRP, alts)
// @param ticker The ticker string to check
// @param tickerId The full ticker ID for primary asset
// @returns AssetPairing with secondary and tertiary assets configured
export detectCrypto(string ticker, string tickerId) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "BTC")
        result.primary := tickerId
        result.secondary := "BITGET:ETHUSDT.P"
        result.tertiary := "CRYPTOCAP:TOTAL3"
        result.invertTertiary := false
    else if str.contains(ticker, "ETH") and not str.contains(ticker, "METH")
        result.primary := tickerId
        result.secondary := "BITGET:BTCUSDT.P"
        result.tertiary := "CRYPTOCAP:TOTAL3"
        result.invertTertiary := false
    else if str.contains(ticker, "SOL")
        result.primary := tickerId
        result.secondary := "BITGET:XRPUSDT.P"
        result.tertiary := "CRYPTOCAP:TOTAL3"
        result.invertTertiary := false
    else if str.contains(ticker, "XRP")
        result.primary := tickerId
        result.secondary := "BITGET:SOLUSDT.P"
        result.tertiary := "CRYPTOCAP:TOTAL3"
        result.invertTertiary := false
    else if str.contains(ticker, "ZEC")
        result.primary := "BITGET:ZECUSDT.P"
        result.secondary := "BITGET:BTCUSDT.P"
        result.tertiary := "BITGET:ETHUSDT.P"
        result.invertTertiary := false
    else if str.contains(ticker, "DOGE")
        result.primary := "BITGET:DOGEUSDT.P"
        result.secondary := "BITGET:BTCUSDT.P"
        result.tertiary := "BITGET:ETHUSDT.P"
        result.invertTertiary := false
    else if str.contains(ticker, "ADA")
        result.primary := "BITGET:ADAUSDT.P"
        result.secondary := "BITGET:BTCUSDT.P"
        result.tertiary := "BITGET:ETHUSDT.P"
        result.invertTertiary := false
    else if str.contains(ticker, "BNB")
        result.primary := "BITGET:BNBUSDT.P"
        result.secondary := "BITGET:BTCUSDT.P"
        result.tertiary := "BITGET:ETHUSDT.P"
        result.invertTertiary := false
    else if str.contains(ticker, "TAO")
        result.primary := "BITGET:TAOUSDT.P"
        result.secondary := "BITGET:BTCUSDT.P"
        result.tertiary := "BITGET:ETHUSDT.P"
        result.invertTertiary := false
    result

// @function Detects Metals CFD (XAU/XAG/Copper + EUR/GBP cross-pairs)
// @param ticker The ticker string to check
// @param tickerId The full ticker ID for primary asset
// @returns AssetPairing with secondary and tertiary assets configured
export detectMetalsCFD(string ticker, string tickerId) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "XAUUSD")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAGUSD"
        result.tertiary := "FOREXCOM:COPPER"
        result.invertTertiary := false
    else if str.contains(ticker, "COPPER")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUUSD"
        result.tertiary := "FOREXCOM:XAGUSD"
        result.invertTertiary := false
    else if str.contains(ticker, "XAGUSD")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUUSD"
        result.tertiary := "FOREXCOM:COPPER"
        result.invertTertiary := false
    else if str.contains(ticker, "XAUEUR")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUUSD"
        result.tertiary := "FOREXCOM:XAUGBP"
        result.invertTertiary := false
    else if str.contains(ticker, "XAUGBP")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUUSD"
        result.tertiary := "FOREXCOM:XAUEUR"
        result.invertTertiary := false
    else if str.contains(ticker, "XAGEUR")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAGUSD"
        result.tertiary := "OANDA:XAGGBP"
        result.invertTertiary := false
    else if str.contains(ticker, "XAGGBP")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAGUSD"
        result.tertiary := "OANDA:XAGEUR"
        result.invertTertiary := false
    result

// @function Detects Metals CFD in GXT Mode (XAUUSD->XAUEUR/XAUGBP, XAGUSD->XAGEUR/XAGGBP)
// @param ticker The ticker string to check
// @param tickerId The full ticker ID for primary asset
// @returns AssetPairing with GXT secondary and tertiary assets (empty for copper)
export detectMetalsCFDGxt(string ticker, string tickerId) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "XAUUSD")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUEUR"
        result.tertiary := "FOREXCOM:XAUGBP"
    else if str.contains(ticker, "XAGUSD")
        result.primary := tickerId
        result.secondary := "OANDA:XAGEUR"
        result.tertiary := "OANDA:XAGGBP"
    else if str.contains(ticker, "XAUEUR")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUUSD"
        result.tertiary := "FOREXCOM:XAUGBP"
    else if str.contains(ticker, "XAUGBP")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUUSD"
        result.tertiary := "FOREXCOM:XAUEUR"
    else if str.contains(ticker, "XAGEUR")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAGUSD"
        result.tertiary := "OANDA:XAGGBP"
    else if str.contains(ticker, "XAGGBP")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAGUSD"
        result.tertiary := "OANDA:XAGEUR"
    result

// @function Detects Metals CFD in Quad Mode (XAUUSD->XAGUSD/XAUEUR/XAUGBP, etc.)
// @param ticker The ticker string to check
// @param tickerId The full ticker ID for primary asset
// @returns AssetPairing with quad assets (empty for copper)
export detectMetalsCFDQuad(string ticker, string tickerId) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "XAUUSD")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAGUSD"
        result.tertiary := "FOREXCOM:XAUEUR"
        result.quaternary := "FOREXCOM:XAUGBP"
    else if str.contains(ticker, "XAGUSD")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUUSD"
        result.tertiary := "OANDA:XAGEUR"
        result.quaternary := "OANDA:XAGGBP"
    else if str.contains(ticker, "XAUEUR")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUUSD"
        result.tertiary := "FOREXCOM:XAGUSD"
        result.quaternary := "FOREXCOM:XAUGBP"
    else if str.contains(ticker, "XAUGBP")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAUUSD"
        result.tertiary := "FOREXCOM:XAGUSD"
        result.quaternary := "FOREXCOM:XAUEUR"
    else if str.contains(ticker, "XAGEUR")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAGUSD"
        result.tertiary := "FOREXCOM:XAUUSD"
        result.quaternary := "OANDA:XAGGBP"
    else if str.contains(ticker, "XAGGBP")
        result.primary := tickerId
        result.secondary := "FOREXCOM:XAGUSD"
        result.tertiary := "FOREXCOM:XAUUSD"
        result.quaternary := "OANDA:XAGEUR"
    result

// @function Detects Indices CFD (NAS100/SP500/DJ30)
// @param ticker The ticker string to check
// @param tickerId The full ticker ID for primary asset
// @returns AssetPairing with secondary and tertiary assets configured
export detectIndicesCFD(string ticker, string tickerId) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "NAS100")
        result.primary := tickerId
        result.secondary := "VANTAGE:SP500FT"
        result.tertiary := "VANTAGE:DJ30FT"
        result.invertTertiary := false
    else if str.contains(ticker, "SP500")
        result.primary := tickerId
        result.secondary := "VANTAGE:NAS100FT"
        result.tertiary := "VANTAGE:DJ30FT"
        result.invertTertiary := false
    else if str.contains(ticker, "DJ30")
        result.primary := tickerId
        result.secondary := "VANTAGE:NAS100FT"
        result.tertiary := "VANTAGE:SP500FT"
        result.invertTertiary := false
    result

// @function Detects EU Stock Indices (GER40/EU50) - Dyad only
// @param ticker The ticker string to check
// @param tickerId The full ticker ID for primary asset
// @returns AssetPairing with secondary asset configured (tertiary empty for dyad)
export detectEUStocks(string ticker, string tickerId) =>
    AssetPairing result = AssetPairing.new()
    if str.contains(ticker, "GER40")
        result.primary := tickerId
        result.secondary := "FOREXCOM:EU50"
        result.invertSecondary := false
    else if str.contains(ticker, "EU50")
        result.primary := tickerId
        result.secondary := "FOREXCOM:GER40"
        result.invertSecondary := false
    result

// @function Returns default fallback assets (chart ticker only, no correlation)
// @param tickerId The full ticker ID for primary asset
// @returns AssetPairing with chart ticker as primary, empty secondary/tertiary (no correlation)
export getDefaultFallback(string tickerId) =>
    AssetPairing result = AssetPairing.new()
    result.primary := tickerId
    result.secondary := ""
    result.tertiary := ""
    result.invertTertiary := false
    result

// @function Applies futures session modifier to ticker WITH back adjustment
// @param tickerStr The ticker to modify
// @param sessionType The session type (syminfo.session)
// @returns Modified ticker string with session and backadjustment.on applied
export applySessionModifierWithBackadjust(string tickerStr, string sessionType) =>
    ticker.modify(tickerStr, session = sessionType, backadjustment = backadjustment.on)

// @function Applies futures session modifier to ticker WITHOUT back adjustment
// @param tickerStr The ticker to modify
// @param sessionType The session type (syminfo.session)
// @returns Modified ticker string with session and backadjustment.off applied
export applySessionModifierNoBackadjust(string tickerStr, string sessionType) =>
    ticker.modify(tickerStr, session = sessionType, backadjustment = backadjustment.off)

// @function Checks if a pairing represents a valid triad (3 assets)
// @param pairing The AssetPairing to check
// @returns True if tertiary is non-empty (triad mode), false for dyad
export isTriadMode(AssetPairing pairing) =>
    pairing.tertiary != ""

// @function Extracts clean ticker string from full ticker ID
// @param tickerId The full ticker ID (e.g., "BITGET:BTCUSDT.P")
// @returns Clean ticker string (e.g., "BTCUSDT.P")
export getAssetTicker(string tickerId) =>
    str.tostring(syminfo.ticker(tickerId))

// @function Resolves triad asset assignments with proper inversion flags
// @param chartTickerId The current chart's ticker ID (syminfo.tickerid)
// @param pairing The detected AssetPairing
// @returns Tuple [primaryAsset, secondaryAsset, tertiaryAsset, invertSecondary, invertTertiary]
export resolveTriad(string chartTickerId, AssetPairing pairing) =>
    string primaryAsset   = chartTickerId
    string secondaryAsset = chartTickerId
    string tertiaryAsset  = chartTickerId
    bool   invertSecondary = false
    bool   invertTertiary  = false
    bool isAsset1 = str.contains(chartTickerId, pairing.primary) or pairing.primary == ""
    bool isAsset2 = str.contains(chartTickerId, pairing.secondary)
    bool isAsset3 = str.contains(chartTickerId, pairing.tertiary)
    if isAsset1 or (not isAsset2 and not isAsset3)
        secondaryAsset := pairing.secondary
        tertiaryAsset := pairing.tertiary
    else if isAsset2
        secondaryAsset := pairing.primary != "" ? pairing.primary : chartTickerId
        tertiaryAsset := pairing.tertiary
    else if isAsset3
        secondaryAsset := pairing.primary != "" ? pairing.primary : chartTickerId
        tertiaryAsset := pairing.secondary
    if (isAsset1 or isAsset2) and pairing.invertTertiary
        invertTertiary := true
    if isAsset3 and pairing.invertTertiary
        invertSecondary := true
        invertTertiary := true
    [primaryAsset, secondaryAsset, tertiaryAsset, invertSecondary, invertTertiary]

// @function Resolves dyad asset assignment with proper inversion flag
// @param chartTickerId The current chart's ticker ID
// @param pairing The detected AssetPairing (dyad: tertiary is empty)
// @returns Tuple [primaryAsset, secondaryAsset, invertSecondary]
export resolveDyad(string chartTickerId, AssetPairing pairing) =>
    string primaryAsset   = chartTickerId
    string secondaryAsset = chartTickerId
    bool   invertSecondary = false
    bool isAsset1 = str.contains(chartTickerId, pairing.primary) or pairing.primary == ""
    bool isAsset2 = str.contains(chartTickerId, pairing.secondary)
    if isAsset1 or not isAsset2
        secondaryAsset := pairing.secondary
    else if isAsset2
        secondaryAsset := pairing.primary != "" ? pairing.primary : chartTickerId
    if (isAsset1 or isAsset2) and pairing.invertSecondary
        invertSecondary := true
    [primaryAsset, secondaryAsset, invertSecondary]

// @function Resolves quad asset assignments with proper inversion flags (4 assets)
// @param chartTickerId The current chart's ticker ID (syminfo.tickerid)
// @param pairing The detected AssetPairing with quaternary populated
// @returns Tuple [primaryAsset, secondaryAsset, tertiaryAsset, quaternaryAsset, invertSecondary, invertTertiary, invertQuaternary]
export resolveQuad(string chartTickerId, AssetPairing pairing) =>
    string primaryAsset    = chartTickerId
    string secondaryAsset  = chartTickerId
    string tertiaryAsset   = chartTickerId
    string quaternaryAsset = chartTickerId
    bool   invertSecondary  = false
    bool   invertTertiary   = false
    bool   invertQuaternary = false
    bool isAsset1 = str.contains(chartTickerId, pairing.primary) or pairing.primary == ""
    bool isAsset2 = str.contains(chartTickerId, pairing.secondary)
    bool isAsset3 = str.contains(chartTickerId, pairing.tertiary)
    bool isAsset4 = str.contains(chartTickerId, pairing.quaternary)
    if isAsset1 or (not isAsset2 and not isAsset3 and not isAsset4)
        secondaryAsset := pairing.secondary
        tertiaryAsset := pairing.tertiary
        quaternaryAsset := pairing.quaternary
    else if isAsset2
        secondaryAsset := pairing.primary != "" ? pairing.primary : chartTickerId
        tertiaryAsset := pairing.tertiary
        quaternaryAsset := pairing.quaternary
    else if isAsset3
        secondaryAsset := pairing.primary != "" ? pairing.primary : chartTickerId
        tertiaryAsset := pairing.secondary
        quaternaryAsset := pairing.quaternary
    else if isAsset4
        secondaryAsset := pairing.primary != "" ? pairing.primary : chartTickerId
        tertiaryAsset := pairing.secondary
        quaternaryAsset := pairing.tertiary
    if (isAsset1 or isAsset2) and pairing.invertTertiary
        invertTertiary := true
    if (isAsset1 or isAsset2 or isAsset3) and pairing.invertQuaternary
        invertQuaternary := true
    if isAsset3 and pairing.invertTertiary
        invertSecondary := true
        invertTertiary := true
    if isAsset4 and pairing.invertQuaternary
        invertSecondary := true
        invertTertiary := true
        invertQuaternary := true
    [primaryAsset, secondaryAsset, tertiaryAsset, quaternaryAsset, invertSecondary, invertTertiary, invertQuaternary]

// @function Main auto-detection entry point. Detects asset category and returns fully resolved config.
// @param ticker The ticker string to check (typically syminfo.ticker)
// @param tickerId The full ticker ID (typically syminfo.tickerid)
// @param assetType The asset type (typically syminfo.type)
// @param sessionType The session type for futures (typically syminfo.session)
// @param useBackadjust Whether to apply back adjustment for futures session alignment
// @param gxtMode When true, metals use currency-cross triads instead of standard metal correlations
// @param quadMode When true, metals use futures secondary + GXT cross-pairs as tertiary/quaternary. Takes priority over gxtMode for metals.
// @returns AssetConfig with fully resolved assets, inversion flags, and detection status
export resolveAssets(string ticker, string tickerId, string assetType, string sessionType, bool useBackadjust, bool gxtMode = false, bool quadMode = false) =>
    AssetConfig config = AssetConfig.new()
    AssetPairing pairing = AssetPairing.new()
    bool found = false
    string category = "unknown"
    if assetType == "futures"
        if str.contains(ticker, "NQ") or str.contains(ticker, "ES") or str.contains(ticker, "YM") or str.contains(ticker, "RTY") or str.contains(ticker, "MNQ") or str.contains(ticker, "MES") or str.contains(ticker, "MYM") or str.contains(ticker, "M2K")
            pairing := detectIndicesFutures(ticker)
            if pairing.secondary != ""
                found := true
                category := "index_futures"
        if not found and (str.contains(ticker, "GC") or str.contains(ticker, "SI") or str.contains(ticker, "HG") or str.contains(ticker, "MGC") or str.contains(ticker, "SIL") or str.contains(ticker, "MHG"))
            if quadMode
                pairing := detectMetalsFuturesQuad(ticker)
                if pairing.secondary != ""
                    found := true
                    category := "metal_futures_quad"
            if not found and gxtMode
                pairing := detectMetalsFuturesGxt(ticker)
                if pairing.secondary != ""
                    found := true
                    category := "metal_futures_gxt"
            if not found
                pairing := detectMetalsFutures(ticker)
                if pairing.secondary != ""
                    found := true
                    category := "metal_futures"
        if not found and (str.contains(ticker, "6E") or str.contains(ticker, "6B") or str.contains(ticker, "M6E") or str.contains(ticker, "M6B"))
            pairing := detectForexFutures(ticker)
            if pairing.secondary != ""
                found := true
                category := "forex_futures"
        if not found and (str.contains(ticker, "CL") or str.contains(ticker, "RB") or str.contains(ticker, "HO") or str.contains(ticker, "MCL") or str.contains(ticker, "MRB") or str.contains(ticker, "MHO"))
            pairing := detectEnergyFutures(ticker)
            if pairing.secondary != ""
                found := true
                category := "energy_futures"
        if not found and (str.contains(ticker, "ZB") or str.contains(ticker, "ZF") or str.contains(ticker, "ZN"))
            pairing := detectTreasuryFutures(ticker)
            if pairing.secondary != ""
                found := true
                category := "treasury_futures"
        if not found and (str.contains(ticker, "BTC") or str.contains(ticker, "ETH") or str.contains(ticker, "MBT") or str.contains(ticker, "MET"))
            pairing := detectCryptoFutures(ticker)
            if pairing.secondary != ""
                found := true
                category := "crypto_futures"
        if not found and (str.contains(ticker, "6C") or str.contains(ticker, "M6C"))
            pairing := detectCADFutures(ticker)
            if pairing.secondary != ""
                found := true
                category := "cad_futures"
    else
        if str.contains(ticker, "EURUSD") or str.contains(ticker, "GBPUSD") or str.contains(ticker, "DXY") or str.contains(ticker, "USDJPY") or str.contains(ticker, "USDCHF") or str.contains(ticker, "GBPJPY") or str.contains(ticker, "EURJPY") or str.contains(ticker, "USDCAD")
            pairing := detectForexCFD(ticker, tickerId)
            if pairing.secondary != ""
                found := true
                category := "forex_cfd"
        if not found and (str.contains(ticker, "BTC") or str.contains(ticker, "ETH") or str.contains(ticker, "SOL") or str.contains(ticker, "XRP") or str.contains(ticker, "DOGE") or str.contains(ticker, "ADA") or str.contains(ticker, "BNB") or str.contains(ticker, "TAO") or str.contains(ticker, "ZEC"))
            pairing := detectCrypto(ticker, tickerId)
            if pairing.secondary != ""
                found := true
                category := "crypto"
        if not found and (str.contains(ticker, "XAUUSD") or str.contains(ticker, "XAGUSD") or str.contains(ticker, "COPPER") or str.contains(ticker, "XAUEUR") or str.contains(ticker, "XAUGBP") or str.contains(ticker, "XAGEUR") or str.contains(ticker, "XAGGBP"))
            if quadMode
                pairing := detectMetalsCFDQuad(ticker, tickerId)
                if pairing.secondary != ""
                    found := true
                    category := "metal_cfd_quad"
            if not found and gxtMode
                pairing := detectMetalsCFDGxt(ticker, tickerId)
                if pairing.secondary != ""
                    found := true
                    category := "metal_cfd_gxt"
            if not found
                pairing := detectMetalsCFD(ticker, tickerId)
                if pairing.secondary != ""
                    found := true
                    category := "metal_cfd"
        if not found and (str.contains(ticker, "NAS100") or str.contains(ticker, "SP500") or str.contains(ticker, "DJ30"))
            pairing := detectIndicesCFD(ticker, tickerId)
            if pairing.secondary != ""
                found := true
                category := "index_cfd"
        if not found and (str.contains(ticker, "GER40") or str.contains(ticker, "EU50"))
            pairing := detectEUStocks(ticker, tickerId)
            if pairing.secondary != ""
                found := true
                category := "eu_stocks"
    if not found
        pairing := getDefaultFallback(tickerId)
        category := "fallback"
    bool isTriad = pairing.tertiary != ""
    bool isQuad = quadMode and pairing.quaternary != ""
    if isQuad
        [primary, secondary, tertiary, quaternary, invSec, invTert, invQuat] = resolveQuad(tickerId, pairing)
        if assetType == "futures" and useBackadjust
            secondary := applySessionModifierWithBackadjust(secondary, sessionType)
            tertiary := applySessionModifierWithBackadjust(tertiary, sessionType)
            quaternary := applySessionModifierWithBackadjust(quaternary, sessionType)
        else if assetType == "futures"
            secondary := applySessionModifierNoBackadjust(secondary, sessionType)
            tertiary := applySessionModifierNoBackadjust(tertiary, sessionType)
            quaternary := applySessionModifierNoBackadjust(quaternary, sessionType)
        config.primary := primary
        config.secondary := secondary
        config.tertiary := tertiary
        config.quaternary := quaternary
        config.invertSecondary := invSec
        config.invertTertiary := invTert
        config.invertQuaternary := invQuat
    else if isTriad
        [primary, secondary, tertiary, invSec, invTert] = resolveTriad(tickerId, pairing)
        if assetType == "futures" and useBackadjust
            secondary := applySessionModifierWithBackadjust(secondary, sessionType)
            tertiary := applySessionModifierWithBackadjust(tertiary, sessionType)
        else if assetType == "futures"
            secondary := applySessionModifierNoBackadjust(secondary, sessionType)
            tertiary := applySessionModifierNoBackadjust(tertiary, sessionType)
        config.primary := primary
        config.secondary := secondary
        config.tertiary := tertiary
        config.invertSecondary := invSec
        config.invertTertiary := invTert
    else
        [primary, secondary, invSec] = resolveDyad(tickerId, pairing)
        if assetType == "futures" and useBackadjust
            secondary := applySessionModifierWithBackadjust(secondary, sessionType)
        else if assetType == "futures"
            secondary := applySessionModifierNoBackadjust(secondary, sessionType)
        config.primary := primary
        config.secondary := secondary
        config.tertiary := ""
        config.invertSecondary := invSec
        config.invertTertiary := false
    config.detected := found
    config.isTriadMode := isTriad
    config.isQuadMode := isQuad
    config.assetCategory := category
    config

// @function Simplified auto-detection using current chart's syminfo values
// @param gxtMode When true, metals use currency-cross triads instead of standard metal correlations
// @param quadMode When true, metals use futures secondary + GXT cross-pairs as tertiary/quaternary
// @returns AssetConfig with fully resolved assets, inversion flags, and detection status
export resolveCurrentChart(bool gxtMode = false, bool quadMode = false) =>
    resolveAssets(syminfo.ticker, syminfo.tickerid, syminfo.type, syminfo.session, true, gxtMode, quadMode)
