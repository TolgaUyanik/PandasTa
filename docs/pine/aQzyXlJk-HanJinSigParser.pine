// © richardgong1988 — shared geometry helpers for the 26 signal pack.
// Publish on TradingView, then import as:  richardgong1988/HanJinSigParser/1

//@version=6
library("HanJinSigParser", overlay = true)

// Upper / lower wick as fraction of current bar's range.
export wickFracs() =>
    rng = high - low
    up  = rng > 0 ? (high - math.max(open, close)) / rng : na
    lo  = rng > 0 ? (math.min(open, close) - low)  / rng : na
    [up, lo]

// Body length as fraction of current bar's range.
export bodyFrac() =>
    rng = high - low
    rng > 0 ? math.abs(close - open) / rng : na

// +1 bullish body, -1 bearish, 0 doji — at history offset `off`.
export bodyDirAt(series int off) =>
    close[off] > open[off] ? 1 : close[off] < open[off] ? -1 : 0

// Does bar `outer` fully contain bar `inner` (H/L range)?
export contains(series int outer, series int inner) =>
    high[outer] >= high[inner] and low[outer] <= low[inner]
