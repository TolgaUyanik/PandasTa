//@version=6
library("GBB_lib_utils", overlay = false)

//=====================================================================
// GBB-lib-utils (Pine Script v6)
//=====================================================================

// @function gbb_moving_average_source
// @description Calculates the moving average of a source series.
// @param _source (series float)
// @param _length (int)
// @param _ma_type (string)
// @returns (series) Moving average series
export gbb_moving_average_source(series float _source, int _length, string _ma_type = 'EMA') =>
    switch _ma_type
        'SMA' => ta.sma(_source, _length)
        'EMA' => ta.ema(_source, _length)
        'WMA' => ta.wma(_source, _length)
        'SMMA (RMA)' => ta.rma(_source, _length)
        'VWMA' => ta.vwma(_source, _length)
        => ta.ema(_source, _length) // fallback

// @function gbb_tf_to_display
// @description Converts minutes and TF string into a short standard label.
// @param tf_minutes (float)
// @param tf_string (string)
// @returns (string) Timeframe label (M1,H1,D1,...)
export gbb_tf_to_display(float tf_minutes, string tf_string = '15') =>
    switch
        tf_minutes == 1     => "M1"
        tf_minutes == 3     => "M3"
        tf_minutes == 5     => "M5"
        tf_minutes == 15    => "M15"
        tf_minutes == 30    => "M30"
        tf_minutes == 60    => "H1"
        tf_minutes == 240   => "H4"
        tf_minutes == 1440  => "D1"
        tf_minutes == 10080 => "W1"
        tf_minutes == 43200 => "MN"
        => tf_string

// @function gbb_convert_bars
// @description Formats a number of bars into a duration (days, hours, minutes + bar count).
// @param _bars (int)
// @returns (string)
export gbb_convert_bars(int _bars) =>
    _minutes_per_bar = timeframe.in_seconds() / 60
    _total_minutes = _bars * _minutes_per_bar
    _days = math.floor(_total_minutes / 1440)
    _hours = math.floor((_total_minutes % 1440) / 60)
    _minutes = math.floor(_total_minutes % 60)
    _result_text = ""
    if _days > 0
        _result_text += str.tostring(_days) + "d "
    if _hours > 0
        _result_text += str.tostring(_hours) + "h "
    if _minutes > 0
        _result_text += str.tostring(_minutes) + "min "
    _result_text += "(" + str.tostring(_bars) + " bars)"
    _result_text

// @function gbb_goldorak_init
// @description Builds a contextual message about the current timeframe and optional 5-level TF.
// @param _tf5Levels_input (string) Alternative timeframe ("" = current timeframe).
// @returns (string, string, float) [tf_display, message, current_minutes]
export gbb_goldorak_init(string _tf5Levels_input) =>
    _tf_string = timeframe.period
    _tf_minutes = timeframe.in_seconds(_tf_string) / 60
    _tf_display = gbb_tf_to_display(_tf_minutes, _tf_string)

    tf_string_5levels = (_tf5Levels_input == "" ? timeframe.period : _tf5Levels_input)
    _tf_minutes_5levels = timeframe.in_seconds(tf_string_5levels) / 60
    _tf_5levels = gbb_tf_to_display(_tf_minutes_5levels, tf_string_5levels)

    _message = "" + _tf_display + ":" + _tf_5levels + ""
    [_tf_display, _message, _tf_minutes]

//─────────────────────────────────────────────────────────────────────
// Example usage
//────────────────────────────────────────────────────────────────────-
//
// //@version=6
// import GBB_lib_utils as gbb
// indicator("Example GBB_lib_utils", overlay = true)
//
// // Initialize and get the TF label
// [tf_label, msg, tf_minutes] = gbb.gbb_goldorak_init("")
//
// // Convert a number of bars into a duration string
// bars_text = gbb.gbb_convert_bars(100)
//
// // Display the message and the duration on the chart
// label.new(bar_index, high, text = msg, style = label.style_label_up, color = color.new(color.green, 70))
// label.new(bar_index, low, text = bars_text, style = label.style_label_down, color = color.new(color.orange, 70))
//
// // Convert another timeframe into a label
// my_tf = gbb.gbb_tf_to_display(60, "60") // returns "H1"
// plotchar(close > open, title="Example condition", char="✓")
//
