//@version=6
indicator("SR Breakout Auto TP/SL v6", overlay=true, max_lines_count=100, max_labels_count=100)

//====================
// INPUTS
//====================
pivotLen = input.int(5, "Pivot Length", minval=2)
extendBars = input.int(50, "Line Length", minval=10)

//====================
// PIVOTS
//====================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float resistance = na
var float support = na

var line resLine = na
var line supLine = na

// Update Resistance
if not na(ph)
    resistance := ph
    line.delete(resLine)
    resLine := line.new(bar_index-pivotLen, resistance, bar_index+extendBars, resistance, color=color.red, width=2)

// Update Support
if not na(pl)
    support := pl
    line.delete(supLine)
    supLine := line.new(bar_index-pivotLen, support, bar_index+extendBars, support, color=color.lime, width=2)

//====================
// BREAKOUTS
//====================
buySignal =
     not na(resistance) and
     close > resistance and
     close[1] <= resistance

sellSignal =
     not na(support) and
     close < support and
     close[1] >= support

//====================
// TRADE LINES
//====================
var line entryLine = na
var line slLine = na
var line tpLine = na

var label signalLabel = na

//====================
// BUY
//====================
if buySignal

    entry = close
    sl = support
    risk = entry - sl
    tp = entry + risk

    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tpLine)

    entryLine := line.new(bar_index, entry, bar_index+extendBars, entry, color=color.blue, width=2)
    slLine := line.new(bar_index, sl, bar_index+extendBars, sl, color=color.red, width=2)
    tpLine := line.new(bar_index, tp, bar_index+extendBars, tp, color=color.green, width=2)

    label.delete(signalLabel)
    signalLabel := label.new(bar_index, low, "BUY",
         style=label.style_label_up,
         color=color.green,
         textcolor=color.rgb(253, 16, 16))

//====================
// SELL
//====================
if sellSignal

    entry = close
    sl = resistance
    risk = sl - entry
    tp = entry - risk

    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tpLine)

    entryLine := line.new(bar_index, entry, bar_index+extendBars, entry, color=color.blue, width=2)
    slLine := line.new(bar_index, sl, bar_index+extendBars, sl, color=color.red, width=2)
    tpLine := line.new(bar_index, tp, bar_index+extendBars, tp, color=color.green, width=2)

    label.delete(signalLabel)
    signalLabel := label.new(bar_index, high, "SELL",
         style=label.style_label_down,
         color=color.red,
         textcolor=color.rgb(242, 20, 20))

//====================
// ALERTS
//====================
alertcondition(buySignal,
     title="BUY Breakout",
     message="BUY Breakout confirmed")

alertcondition(sellSignal,
     title="SELL Breakout",
     message="SELL Breakout confirmed")

//====================
// PLOTS
//====================
plotshape(buySignal,
     style=shape.triangleup,
     location=location.belowbar,
     color=color.lime,
     size=size.small)

plotshape(sellSignal,
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     size=size.small)
