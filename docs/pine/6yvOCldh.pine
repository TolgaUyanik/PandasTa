//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 前日四本値取得
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

previousDailyOpen = request.security(
     syminfo.tickerid,
     "D",
     open[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

previousDailyHigh = request.security(
     syminfo.tickerid,
     "D",
     high[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

previousDailyLow = request.security(
     syminfo.tickerid,
     "D",
     low[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

previousDailyClose = request.security(
     syminfo.tickerid,
     "D",
     close[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 前週四本値取得
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

previousWeeklyOpen = request.security(
     syminfo.tickerid,
     "W",
     open[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

previousWeeklyHigh = request.security(
     syminfo.tickerid,
     "W",
     high[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

previousWeeklyLow = request.security(
     syminfo.tickerid,
     "W",
     low[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

previousWeeklyClose = request.security(
     syminfo.tickerid,
     "W",
     close[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 前月四本値取得
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

previousMonthlyOpen = request.security(
     syminfo.tickerid,
     "M",
     open[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

previousMonthlyHigh = request.security(
     syminfo.tickerid,
     "M",
     high[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

previousMonthlyLow = request.security(
     syminfo.tickerid,
     "M",
     low[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

previousMonthlyClose = request.security(
     syminfo.tickerid,
     "M",
     close[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 日・週・月ラインの開始時間
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

dailyStartTime = time("D")
weeklyStartTime = time("W")
monthlyStartTime = time("M")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// アジア高安半値の計算
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

inAsia = not na(
     time(
         timeframe.period,
         asiaSession,
         asiaTimezone
     )
)

asiaStarted = inAsia and not inAsia[1]

var int asiaStartTime = na
var float asiaHigh = na
var float asiaLow = na
var float asiaMid = na

if asiaStarted
    asiaStartTime := time
    asiaHigh := high
    asiaLow := low
    asiaMid := (asiaHigh + asiaLow) / 2.0

else if inAsia
    asiaHigh := na(asiaHigh) ? high : math.max(asiaHigh, high)
    asiaLow := na(asiaLow) ? low : math.min(asiaLow, low)
    asiaMid := (asiaHigh + asiaLow) / 2.0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ライン変数
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var line dailyOpenLine = na
var line dailyHighLine = na
var line dailyLowLine = na
var line dailyCloseLine = na

var line weeklyOpenLine = na
var line weeklyHighLine = na
var line weeklyLowLine = na
var line weeklyCloseLine = na

var line monthlyOpenLine = na
var line monthlyHighLine = na
var line monthlyLowLine = na
var line monthlyCloseLine = na

var line asiaHighLine = na
var line asiaLowLine = na
var line asiaMidLine = na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ラベル変数
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var label dailyOpenLabel = na
var label dailyHighLabel = na
var label dailyLowLabel = na
var label dailyCloseLabel = na

var label weeklyOpenLabel = na
var label weeklyHighLabel = na
var label weeklyLowLabel = na
var label weeklyCloseLabel = na

var label monthlyOpenLabel = na
var label monthlyHighLabel = na
var label monthlyLowLabel = na
var label monthlyCloseLabel = na

var label asiaHighLabel = na
var label asiaLowLabel = na
var label asiaMidLabel = na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 最新バーでだけ全ラインを作成
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if barstate.islast
    line.delete(dailyOpenLine)
    line.delete(dailyHighLine)
    line.delete(dailyLowLine)
    line.delete(dailyCloseLine)

    line.delete(weeklyOpenLine)
    line.delete(weeklyHighLine)
    line.delete(weeklyLowLine)
    line.delete(weeklyCloseLine)

    line.delete(monthlyOpenLine)
    line.delete(monthlyHighLine)
    line.delete(monthlyLowLine)
    line.delete(monthlyCloseLine)

    line.delete(asiaHighLine)
    line.delete(asiaLowLine)
    line.delete(asiaMidLine)

    label.delete(dailyOpenLabel)
    label.delete(dailyHighLabel)
    label.delete(dailyLowLabel)
    label.delete(dailyCloseLabel)

    label.delete(weeklyOpenLabel)
    label.delete(weeklyHighLabel)
    label.delete(weeklyLowLabel)
    label.delete(weeklyCloseLabel)

    label.delete(monthlyOpenLabel)
    label.delete(monthlyHighLabel)
    label.delete(monthlyLowLabel)
    label.delete(monthlyCloseLabel)

    label.delete(asiaHighLabel)
    label.delete(asiaLowLabel)
    label.delete(asiaMidLabel)

    dailyOpenLine := f_drawLine(
         showDaily and showDailyOpen,
         dailyStartTime,
         previousDailyOpen,
         dailyOpenColor,
         dailyWidth,
         dailyStyle
     )

    dailyHighLine := f_drawLine(
         showDaily and showDailyHigh,
         dailyStartTime,
         previousDailyHigh,
         dailyHighColor,
         dailyWidth,
         dailyStyle
     )

    dailyLowLine := f_drawLine(
         showDaily and showDailyLow,
         dailyStartTime,
         previousDailyLow,
         dailyLowColor,
         dailyWidth,
         dailyStyle
     )

    dailyCloseLine := f_drawLine(
         showDaily and showDailyClose,
         dailyStartTime,
         previousDailyClose,
         dailyCloseColor,
         dailyWidth,
         dailyStyle
     )

    weeklyOpenLine := f_drawLine(
         showWeekly and showWeeklyOpen,
         weeklyStartTime,
         previousWeeklyOpen,
         weeklyOpenColor,
         weeklyWidth,
         weeklyStyle
     )

    weeklyHighLine := f_drawLine(
         showWeekly and showWeeklyHigh,
         weeklyStartTime,
         previousWeeklyHigh,
         weeklyHighColor,
         weeklyWidth,
         weeklyStyle
     )

    weeklyLowLine := f_drawLine(
         showWeekly and showWeeklyLow,
         weeklyStartTime,
         previousWeeklyLow,
         weeklyLowColor,
         weeklyWidth,
         weeklyStyle
     )

    weeklyCloseLine := f_drawLine(
         showWeekly and showWeeklyClose,
         weeklyStartTime,
         previousWeeklyClose,
         weeklyCloseColor,
         weeklyWidth,
         weeklyStyle
     )

    monthlyOpenLine := f_drawLine(
         showMonthly and showMonthlyOpen,
         monthlyStartTime,
         previousMonthlyOpen,
         monthlyOpenColor,
         monthlyWidth,
         monthlyStyle
     )

    monthlyHighLine := f_drawLine(
         showMonthly and showMonthlyHigh,
         monthlyStartTime,
         previousMonthlyHigh,
         monthlyHighColor,
         monthlyWidth,
         monthlyStyle
     )

    monthlyLowLine := f_drawLine(
         showMonthly and showMonthlyLow,
         monthlyStartTime,
         previousMonthlyLow,
         monthlyLowColor,
         monthlyWidth,
         monthlyStyle
     )

    monthlyCloseLine := f_drawLine(
         showMonthly and showMonthlyClose,
         monthlyStartTime,
         previousMonthlyClose,
         monthlyCloseColor,
         monthlyWidth,
         monthlyStyle
     )

    asiaHighLine := f_drawLine(
         showAsia and showAsiaHigh,
         asiaStartTime,
         asiaHigh,
         asiaHighColor,
         asiaWidth,
         asiaStyle
     )

    asiaLowLine := f_drawLine(
         showAsia and showAsiaLow,
         asiaStartTime,
         asiaLow,
         asiaLowColor,
         asiaWidth,
         asiaStyle
     )

    asiaMidLine := f_drawLine(
         showAsia and showAsiaMid,
         asiaStartTime,
         asiaMid,
         asiaMidColor,
         asiaWidth,
         asiaStyle
     )

    dailyOpenLabel := f_drawLabel(
         showLabels and showDaily and showDailyOpen,
         previousDailyOpen,
         "前日始値",
         dailyOpenColor,
         labelOffsetMinutes
     )

    dailyHighLabel := f_drawLabel(
         showLabels and showDaily and showDailyHigh,
         previousDailyHigh,
         "前日高値",
         dailyHighColor,
         labelOffsetMinutes
     )

    dailyLowLabel := f_drawLabel(
         showLabels and showDaily and showDailyLow,
         previousDailyLow,
         "前日安値",
         dailyLowColor,
         labelOffsetMinutes
     )

    dailyCloseLabel := f_drawLabel(
         showLabels and showDaily and showDailyClose,
         previousDailyClose,
         "前日終値",
         dailyCloseColor,
         labelOffsetMinutes
     )

    weeklyOpenLabel := f_drawLabel(
         showLabels and showWeekly and showWeeklyOpen,
         previousWeeklyOpen,
         "前週始値",
         weeklyOpenColor,
         labelOffsetMinutes
     )

    weeklyHighLabel := f_drawLabel(
         showLabels and showWeekly and showWeeklyHigh,
         previousWeeklyHigh,
         "前週高値",
         weeklyHighColor,
         labelOffsetMinutes
     )

    weeklyLowLabel := f_drawLabel(
         showLabels and showWeekly and showWeeklyLow,
         previousWeeklyLow,
         "前週安値",
         weeklyLowColor,
         labelOffsetMinutes
     )

    weeklyCloseLabel := f_drawLabel(
         showLabels and showWeekly and showWeeklyClose,
         previousWeeklyClose,
         "前週終値",
         weeklyCloseColor,
         labelOffsetMinutes
     )

    monthlyOpenLabel := f_drawLabel(
         showLabels and showMonthly and showMonthlyOpen,
         previousMonthlyOpen,
         "前月始値",
         monthlyOpenColor,
         labelOffsetMinutes
     )

    monthlyHighLabel := f_drawLabel(
         showLabels and showMonthly and showMonthlyHigh,
         previousMonthlyHigh,
         "前月高値",
         monthlyHighColor,
         labelOffsetMinutes
     )

    monthlyLowLabel := f_drawLabel(
         showLabels and showMonthly and showMonthlyLow,
         previousMonthlyLow,
         "前月安値",
         monthlyLowColor,
         labelOffsetMinutes
     )

    monthlyCloseLabel := f_drawLabel(
         showLabels and showMonthly and showMonthlyClose,
         previousMonthlyClose,
         "前月終値",
         monthlyCloseColor,
         labelOffsetMinutes
     )

    asiaHighLabel := f_drawLabel(
         showLabels and showAsia and showAsiaHigh,
         asiaHigh,
         "アジア高値",
         asiaHighColor,
         labelOffsetMinutes
     )

    asiaLowLabel := f_drawLabel(
         showLabels and showAsia and showAsiaLow,
