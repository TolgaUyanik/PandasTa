         "アジア安値",
         asiaLowColor,
         labelOffsetMinutes
     )

    asiaMidLabel := f_drawLabel(
         showLabels and showAsia and showAsiaMid,
         asiaMid,
         "アジア半値",
         asiaMidColor,
         labelOffsetMinutes
     )