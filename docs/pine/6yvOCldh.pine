//@version=6
indicator(
     "前足四本値＋アジア高安半値【完全水平線版】",
     overlay = true,
     max_lines_count = 50,
     max_labels_count = 50
)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 関数
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_style(string styleName) =>
    styleName == "実線" ? line.style_solid :
     styleName == "破線" ? line.style_dashed :
     line.style_dotted

f_drawLine(
     bool enabled,
     int startTime,
     float price,
     color lineColor,
     int lineWidth,
     string styleName
 ) =>
    line result = na

    if enabled and not na(startTime) and not na(price)
        result := line.new(
             x1 = startTime,
             y1 = price,
             x2 = time + 60000,
             y2 = price,
             xloc = xloc.bar_time,
             extend = extend.right,
             color = lineColor,
             width = lineWidth,
             style = f_style(styleName)
         )

    result

f_drawLabel(
     bool enabled,
     float price,
     string labelText,
     color textColor,
     int offsetMinutes
 ) =>
    label result = na

    if enabled and not na(price)
        result := label.new(
             x = time + offsetMinutes * 60000,
             y = price,
             text = labelText,
             xloc = xloc.bar_time,
             yloc = yloc.price,
             style = label.style_label_left,
             color = color.new(color.black, 100),
             textcolor = textColor,
             size = size.small
         )

    result

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
