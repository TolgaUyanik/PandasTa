     "タイムゾーン",
     options = [
         "Asia/Tokyo",
         "Asia/Hong_Kong",
         "Asia/Singapore",
         "Etc/UTC",
         "Europe/London",
         "America/New_York"
     ],
     group = groupAsia
)

asiaWidth = input.int(
     1,
     "アジアラインの太さ",
     minval = 1,
     maxval = 5,
     group = groupAsia
)

asiaStyle = input.string(
