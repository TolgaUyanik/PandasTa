// ═══════════════════════════════════════════════════════════════
// 📦 Lib_Alerts - Alert Library (Webhook Payloads)
// Pine Script v6 Library
// ═══════════════════════════════════════════════════════════════
// This library includes:
//   • Exchange specific JSON payload generators
//   • Standard JSON payload generators
//   • Multi-Pair (MP) TP/SL JSON support
//   • Standard TP/SL and AMEND format support
//   • Partial Exit alerts
//   • Alert message formatting helpers
//
// ⚠️ v6 LIMITATIONS:
//   • alert() calls remain in the main script (cannot call alert() in library)
//   • This library only PRODUCES JSON strings; the main script sends them
//
// 📌 USAGE:
//   import YourTradingViewName/Lib_SW_Alerts/1 as alrt
//   Crypto: string json = alrt.enterLong(botCfg, 100.0, tpsl)
//   Forex:  string json = alrt.swb_buy(swbCfg, 0.01, na)
//   alert(json, alert.freq_once_per_bar)
// ═══════════════════════════════════════════════════════════════

//@version=6
library('Lib_SW_Alerts', overlay = true)

// ═══════════════════════════════════════════════════════════════
// 📐 USER-DEFINED TYPES
// ═══════════════════════════════════════════════════════════════

// ── Bot Connection Configuration ──
export type BotConfig
    string exchangeName    // Exchange name (e.g., 'ExchangeB')
    string symbolInput     // Symbol (e.g., 'BTCUSDT')
    string botName         // Bot name
    string tfStr           // Timeframe string
    string botID           // Bot ID
    bool   useMultiPair    // Is Multi-Pair mode active
    int    leverage        // Leverage value

// ── TP/SL Alert Configuration (for MP mode) ──
export type AlertTPSL
    float  tp1_pct
    float  tp1_port
    float  tp2_pct
    float  tp2_port
    float  tp3_pct
    float  tp3_port
    float  sl_pct

// ═══════════════════════════════════════════════════════════════
// 🔧 JSON GENERATION FUNCTIONS
// ═══════════════════════════════════════════════════════════════

// Generate Bot code (ENTER-LONG_exchange_symbol_botname_tf_botid)
// @param action Action code (e.g., 'ENTER-LONG', 'EXIT-SHORT', etc.)
// @param cfg Bot configuration
// @returns Formatted code string
export buildCode(string action, BotConfig cfg) =>
    action + '_' + cfg.exchangeName + '_' + cfg.symbolInput + '_' + cfg.botName + '_' + cfg.tfStr + '_' + cfg.botID

// Generate MP TP/SL JSON part
// @param tpsl TP/SL configuration
// @returns JSON string (,"takeProfits":[...],"stopLoss":{...})
export buildMPTPSL(AlertTPSL tpsl) =>
    ',"takeProfits":[' +
     '{"priceDeviation":' + str.tostring(tpsl.tp1_pct / 100, '#.######') +
     ',"portfolio":' + str.tostring(tpsl.tp1_port / 100, '#.######') + '},' +
     '{"priceDeviation":' + str.tostring(tpsl.tp2_pct / 100, '#.######') +
     ',"portfolio":' + str.tostring(tpsl.tp2_port / 100, '#.######') + '},' +
     '{"priceDeviation":' + str.tostring(tpsl.tp3_pct / 100, '#.######') +
     ',"portfolio":' + str.tostring(tpsl.tp3_port / 100, '#.######') + '}]' +
     ',"stopLoss":{"priceDeviation":' + str.tostring(tpsl.sl_pct / 100, '#.######') + '}'

// ═══════════════════════════════════════════════════════════════
// 📡 ENTRY ALERTS
// ═══════════════════════════════════════════════════════════════

// Long entry alert JSON
// @param cfg Bot configuration
// @param amount Trade amount (USDT)
// @param tpsl TP/SL configuration (for MP mode, if na not added)
// @param isDCA Is DCA entry
// @returns JSON string
export enterLong(BotConfig cfg, float amount, AlertTPSL tpsl) =>
    string code = buildCode('ENTER-LONG', cfg)
    string mpPart = cfg.useMultiPair and not na(tpsl) ? buildMPTPSL(tpsl) : ''
    '{"code":"' + code + '","orderType":"market","amountPerTradeType":"quote","amountPerTrade":' +
     str.tostring(amount) + ',"leverage":' + str.tostring(cfg.leverage) +
     mpPart + ',"reduceOnly":false,"placeConditionalOrdersOnExchange":false}'

// Short entry alert JSON
// @param cfg Bot configuration
// @param amount Trade amount (USDT)
// @param tpsl TP/SL configuration (for MP mode)
// @returns JSON string
export enterShort(BotConfig cfg, float amount, AlertTPSL tpsl) =>
    string code = buildCode('ENTER-SHORT', cfg)
    string mpPart = cfg.useMultiPair and not na(tpsl) ? buildMPTPSL(tpsl) : ''
    '{"code":"' + code + '","orderType":"market","amountPerTradeType":"quote","amountPerTrade":' +
     str.tostring(amount) + ',"leverage":' + str.tostring(cfg.leverage) +
     mpPart + ',"reduceOnly":false,"placeConditionalOrdersOnExchange":false}'

// ═══════════════════════════════════════════════════════════════
// 📡 EXIT ALERTS
// ═══════════════════════════════════════════════════════════════

// Long full exit alert JSON
// @param cfg Bot configuration
// @returns JSON string
export exitLong(BotConfig cfg) =>
    '{"code":"' + buildCode('EXIT-LONG', cfg) + '"}'

// Short full exit alert JSON
// @param cfg Bot configuration
// @returns JSON string
export exitShort(BotConfig cfg) =>
    '{"code":"' + buildCode('EXIT-SHORT', cfg) + '"}'

// Long partial exit alert JSON (Force Exit)
// @param cfg Bot configuration
// @param totalNotional Current total position volume
// @param pctClose Percentage to close (100 = full)
// @returns JSON string
export exitLongPartial(BotConfig cfg, float totalNotional, float pctClose) =>
    string code = buildCode('EXIT-LONG-FORCE', cfg)
    float exitAmount = totalNotional * (pctClose / 100.0)
    '{"code":"' + code + '","amountPerTradeType":"quote","amountPerTrade":' +
     str.tostring(exitAmount) + ',"reduceOnly":true}'

// Short partial exit alert JSON (Force Exit)
// @param cfg Bot configuration
// @param totalNotional Current total position volume
// @param pctClose Percentage to close
// @returns JSON string
export exitShortPartial(BotConfig cfg, float totalNotional, float pctClose) =>
    string code = buildCode('EXIT-SHORT-FORCE', cfg)
    float exitAmount = totalNotional * (pctClose / 100.0)
    '{"code":"' + code + '","amountPerTradeType":"quote","amountPerTrade":' +
     str.tostring(exitAmount) + ',"reduceOnly":true}'

// ═══════════════════════════════════════════════════════════════
// 📊 MP TP/SL CONFIGURATION HELPERS
// ═══════════════════════════════════════════════════════════════

// Create Normal TP/SL configuration (for Long L1 entry)
// @returns AlertTPSL UDT
export buildTPSL_Normal(float tp1_pct, float tp1_port, float tp2_pct, float tp2_port, float tp3_pct, float tp3_port, float sl_pct) =>
    AlertTPSL.new(tp1_pct, tp1_port, tp2_pct, tp2_port, tp3_pct, tp3_port, sl_pct)

// Create DCA TP/SL configuration
// @returns AlertTPSL UDT
export buildTPSL_DCA(float dca_tp1_pct, float dca_tp1_port, float dca_tp2_pct, float dca_tp2_port, float dca_tp3_pct, float dca_tp3_port, float dca_sl_pct) =>
    AlertTPSL.new(dca_tp1_pct, dca_tp1_port, dca_tp2_pct, dca_tp2_port, dca_tp3_pct, dca_tp3_port, dca_sl_pct)

// Select correct TP/SL based on level (normal vs DCA)
// @param level Current DCA level
// @param normalTPSL Normal entry TP/SL
// @param dcaTPSL DCA entry TP/SL
// @returns Appropriate AlertTPSL
export selectTPSL(int level, AlertTPSL normalTPSL, AlertTPSL dcaTPSL) =>
    level > 1 ? dcaTPSL : normalTPSL

// ═══════════════════════════════════════════════════════════════
// 📝 MESSAGE FORMATTING HELPERS
// ═══════════════════════════════════════════════════════════════

// Format PnL ($ and color)
// @param pnl PnL value
// @returns Formatted string
export formatPnL(float pnl) =>
    (pnl >= 0 ? '+' : '') + str.tostring(pnl, '#.##') + '$'

// Format Percentage
// @param pct Percentage value
// @returns Formatted string
export formatPct(float pct) =>
    str.tostring(pct, '#.##') + '%'

// Format Price (based on symbol precision)
// @param price Price value
// @returns Formatted string
export formatPrice(float price) =>
    str.tostring(price, '#.########')

// Create Trade Summary (for label content)
// @param isLong Is Long
// @param level DCA level
// @param price Entry price
// @param amount Trade amount
// @param leverage Leverage
// @returns (emoji) Level - price - amount
export buildEntryLabel(bool isLong, int level, float price, float amount, int leverage) =>
    string dir = isLong ? '🟢' : '🔴'
    string lvlStr = level == 1 ? 'L1' : 'DCA' + str.tostring(level - 1)
    dir + ' ' + lvlStr + ' @ ' + formatPrice(price) + '\n' +
     str.tostring(amount, '#.##') + '$ (' + str.tostring(leverage) + 'x)'

// Create TP Exit Label
// @param isLong Is Long
// @param tpNum TP number (1, 2, 3)
// @param price Exit price
// @param pnl PnL value
// @param isDCA Is DCA TP
// @returns Formatted label string
export buildTPLabel(bool isLong, int tpNum, float price, float pnl, bool isDCA) =>
    string dir = isLong ? '🟢' : '🔴'
    string prefix = isDCA ? 'DCA-' : ''
    dir + ' ' + prefix + 'TP' + str.tostring(tpNum) + ' @ ' + formatPrice(price) + '\n' +
     'PnL: ' + formatPnL(pnl)

// Create SL Exit Label
export buildSLLabel(bool isLong, float price, float pnl, bool isTrailing) =>
    string dir = isLong ? '🟢' : '🔴'
    string slType = isTrailing ? 'TS' : 'SL'
    dir + ' ' + slType + ' @ ' + formatPrice(price) + '\n' +
     'PnL: ' + formatPnL(pnl)

// Create Force Exit Label
export buildForceExitLabel(bool isLong, float price, float pnl) =>
    string dir = isLong ? '🟡' : '🟡'
    dir + ' FE @ ' + formatPrice(price) + '\n' +
     'PnL: ' + formatPnL(pnl)

// Create Swing Reversal Label
export buildSwingLabel(bool isLong, float price, float pnl) =>
    string dir = isLong ? '🔄🟢' : '🔄🔴'
    dir + ' SR @ ' + formatPrice(price) + '\n' +
     'PnL: ' + formatPnL(pnl)

// ═══════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════
// 🔵 AutoStrategy (FOREX) ALERT SYSTEM
// ═══════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════

// ── AutoStrategy Connection Configuration ──
export type SWBotConfig
    string licenseKey      // License key
    string secretKey       // Secret key (optional - not sent if empty)
    string symbol          // Pair (e.g., 'XAUUSD', 'EURUSD')
    float  pipValue        // Price value of 1 pip (XAUUSD: 0.01)
    float  contractSize    // Contract size (XAUUSD: 100)
    bool   useBrokerTPSL   // Send Broker TP/SL
    bool   useMultiPos     // Multi-Position mode (3 separate orders)

// ═══════════════════════════════════════════════════════════════
// 🔧 SWB JSON BUILDER HELPERS
// ═══════════════════════════════════════════════════════════════

// Secret key JSON fragment (returns '' if empty)
export swb_secretPart(SWBotConfig cfg) =>
    cfg.secretKey != '' ? ',"secretKey":"' + cfg.secretKey + '"' : ''

// Base JSON structure
// @param cfg SWBot configuration
// @param action Action type ('BUY', 'SELL', 'CLOSE_LONG', etc.)
// @returns JSON start
export swb_base(SWBotConfig cfg, string action) =>
    '{"license":"' + cfg.licenseKey + '"' + swb_secretPart(cfg) +
     ',"symbol":"' + cfg.symbol + '","action":"' + action + '"'

// ═══════════════════════════════════════════════════════════════
// 📡 SWB ENTRY ALERTS (BUY / SELL)
// ═══════════════════════════════════════════════════════════════

// BUY (Long entry) alert
// @param cfg SWBot configuration
// @param lotSize Lot amount
// @param slPrice SL price (if na, SL not added)
// @returns JSON string
export swb_buy(SWBotConfig cfg, float lotSize, float slPrice) =>
    string slPart = not na(slPrice) ? ',"sl":' + str.tostring(slPrice, format.mintick) : ''
    swb_base(cfg, 'BUY') + ',"volume":' + str.tostring(lotSize, '#.##') + slPart + '}'

// SELL (Short entry) alert
// @param cfg SWBot configuration
// @param lotSize Lot amount
// @param slPrice SL price (if na, SL not added)
// @returns JSON string
export swb_sell(SWBotConfig cfg, float lotSize, float slPrice) =>
    string slPart = not na(slPrice) ? ',"sl":' + str.tostring(slPrice, format.mintick) : ''
    swb_base(cfg, 'SELL') + ',"volume":' + str.tostring(lotSize, '#.##') + slPart + '}'

// BUY with TP/SL (in pips)
// @param slPips SL distance (pips)
// @param tpPips TP distance (pips)
// @returns JSON string
export swb_buy_tpsl(SWBotConfig cfg, float lotSize, float slPips, float tpPips) =>
    swb_base(cfg, 'BUY') + ',"volume":' + str.tostring(lotSize, '#.##') +
     ',"slPips":' + str.tostring(slPips, '#.#') +
     ',"tpPips":' + str.tostring(tpPips, '#.#') + '}'

// SELL with TP/SL (in pips)
export swb_sell_tpsl(SWBotConfig cfg, float lotSize, float slPips, float tpPips) =>
    swb_base(cfg, 'SELL') + ',"volume":' + str.tostring(lotSize, '#.##') +
     ',"slPips":' + str.tostring(slPips, '#.#') +
     ',"tpPips":' + str.tostring(tpPips, '#.#') + '}'

// ═══════════════════════════════════════════════════════════════
// 📡 SWB EXIT ALERTS (CLOSE)
// ═══════════════════════════════════════════════════════════════

// CLOSE_LONG (Long full exit)
export swb_closeLong(SWBotConfig cfg) =>
    swb_base(cfg, 'CLOSE_LONG') + '}'

// CLOSE_SHORT (Short full exit)
export swb_closeShort(SWBotConfig cfg) =>
    swb_base(cfg, 'CLOSE_SHORT') + '}'

// CLOSE_LONG partial (in lots)
// @param lotToClose Lot amount to close
export swb_closeLongPartial(SWBotConfig cfg, float lotToClose) =>
    swb_base(cfg, 'CLOSE_LONG') + ',"volume":' + str.tostring(lotToClose, '#.##') + '}'

// CLOSE_SHORT partial (in lots)
export swb_closeShortPartial(SWBotConfig cfg, float lotToClose) =>
    swb_base(cfg, 'CLOSE_SHORT') + ',"volume":' + str.tostring(lotToClose, '#.##') + '}'

// ═══════════════════════════════════════════════════════════════
// 📡 SWB AMEND (Modify Position) ALERTS
// ═══════════════════════════════════════════════════════════════

// AMEND_LONG - SL and TP update (price based)
// @param slPrice New SL price
// @param tpPrice New TP price
export swb_amendLong(SWBotConfig cfg, float slPrice, float tpPrice) =>
    string slPart = not na(slPrice) ? ',"sl":' + str.tostring(slPrice, format.mintick) : ''
    string tpPart = not na(tpPrice) ? ',"tp":' + str.tostring(tpPrice, format.mintick) : ''
    swb_base(cfg, 'AMEND_LONG') + slPart + tpPart + '}'

// AMEND_SHORT - SL and TP update (price based)
export swb_amendShort(SWBotConfig cfg, float slPrice, float tpPrice) =>
    string slPart = not na(slPrice) ? ',"sl":' + str.tostring(slPrice, format.mintick) : ''
    string tpPart = not na(tpPrice) ? ',"tp":' + str.tostring(tpPrice, format.mintick) : ''
    swb_base(cfg, 'AMEND_SHORT') + slPart + tpPart + '}'

// AMEND_LONG - Only SL update
export swb_amendSLLong(SWBotConfig cfg, float slPrice) =>
    swb_base(cfg, 'AMEND_LONG') + ',"sl":' + str.tostring(slPrice, format.mintick) + '}'

// AMEND_SHORT - Only SL update
export swb_amendSLShort(SWBotConfig cfg, float slPrice) =>
    swb_base(cfg, 'AMEND_SHORT') + ',"sl":' + str.tostring(slPrice, format.mintick) + '}'

// AMEND_LONG - With Trailing Stop
// @param slPrice SL price (broker trailing start point)
export swb_amendTrailingLong(SWBotConfig cfg, float slPrice) =>
    swb_base(cfg, 'AMEND_LONG') + ',"sl":' + str.tostring(slPrice, format.mintick) +
     ',"trailingStopLoss":true}'

// AMEND_SHORT - With Trailing Stop
export swb_amendTrailingShort(SWBotConfig cfg, float slPrice) =>
    swb_base(cfg, 'AMEND_SHORT') + ',"sl":' + str.tostring(slPrice, format.mintick) +
     ',"trailingStopLoss":true}'

// ═══════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════
// 🟡  WEBHOOK SIGNAL TRADING (CRYPTO)
// ═══════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════

export type ExchangeConfigA
    string symbol       // "BTCUSDT"
    string strategyId   // 'ten alınan Strategy ID
    int    maxLag       // 5-300, default 20

// 📡  ENTRY ALERTS (OPEN)
// @param cfg  configuration
// @param qtyInCoin Trade amount in Coin
export exchA_openLong(ExchangeConfigA cfg, float qtyInCoin) =>
    '{"symbol":"' + cfg.symbol + '","side":"Buy","orderType":"Market","qty":"' + str.tostring(qtyInCoin, '#.######') + '","amount_type":"absolute.quantity","max_lag":' + str.tostring(cfg.maxLag) + ',"strategy_id":"' + cfg.strategyId + '"}'

export exchA_openShort(ExchangeConfigA cfg, float qtyInCoin) =>
    '{"symbol":"' + cfg.symbol + '","side":"Sell","orderType":"Market","qty":"' + str.tostring(qtyInCoin, '#.######') + '","amount_type":"absolute.quantity","max_lag":' + str.tostring(cfg.maxLag) + ',"strategy_id":"' + cfg.strategyId + '"}'

// 📡  EXIT ALERTS (CLOSE)
export exchA_closeLong(ExchangeConfigA cfg) =>
    '{"symbol":"' + cfg.symbol + '","side":"Sell","orderType":"Market","qty":"100","amount_type":"position.percentage","max_lag":' + str.tostring(cfg.maxLag) + ',"strategy_id":"' + cfg.strategyId + '"}'

export exchA_closeShort(ExchangeConfigA cfg) =>
    '{"symbol":"' + cfg.symbol + '","side":"Buy","orderType":"Market","qty":"100","amount_type":"position.percentage","max_lag":' + str.tostring(cfg.maxLag) + ',"strategy_id":"' + cfg.strategyId + '"}'

export exchA_closeLongPartial(ExchangeConfigA cfg, float pct) =>
    '{"symbol":"' + cfg.symbol + '","side":"Sell","orderType":"Market","qty":"' + str.tostring(pct, '#.##') + '","amount_type":"position.percentage","max_lag":' + str.tostring(cfg.maxLag) + ',"strategy_id":"' + cfg.strategyId + '"}'

export exchA_closeShortPartial(ExchangeConfigA cfg, float pct) =>
    '{"symbol":"' + cfg.symbol + '","side":"Buy","orderType":"Market","qty":"' + str.tostring(pct, '#.##') + '","amount_type":"position.percentage","max_lag":' + str.tostring(cfg.maxLag) + ',"strategy_id":"' + cfg.strategyId + '"}'

export type ExchangeConfigB
    string symbol       // "BTCUSDT"
    string signalId     //  signal_id
    string uid          //  UID
    string positionSide // "long"/"short"/"both" (Hedge vs One-Way)

// Helper for  base JSON
export exchB_base(ExchangeConfigB cfg) =>
    ',"positionSide":"' + cfg.positionSide + '","orderType":"market","signal_id":"' + cfg.signalId + '","UID":"' + cfg.uid + '"}'

// 📡  ENTRY ALERTS (OPEN)
export exchB_openLong(ExchangeConfigB cfg, float qtyInCoin) =>
    '{"symbol":"' + cfg.symbol + '","side":"buy","qty":"' + str.tostring(qtyInCoin, '#.######') + '"' + exchB_base(cfg)

export exchB_openShort(ExchangeConfigB cfg, float qtyInCoin) =>
    '{"symbol":"' + cfg.symbol + '","side":"sell","qty":"' + str.tostring(qtyInCoin, '#.######') + '"' + exchB_base(cfg)

// 📡  EXIT ALERTS (CLOSE)
export exchB_closeLong(ExchangeConfigB cfg, float qtyInCoin) =>
    '{"symbol":"' + cfg.symbol + '","side":"sell","qty":"' + str.tostring(qtyInCoin, '#.######') + '"' + exchB_base(cfg)

export exchB_closeShort(ExchangeConfigB cfg, float qtyInCoin) =>
    '{"symbol":"' + cfg.symbol + '","side":"buy","qty":"' + str.tostring(qtyInCoin, '#.######') + '"' + exchB_base(cfg)

export exchB_closeLongPartial(ExchangeConfigB cfg, float partialQty) =>
    '{"symbol":"' + cfg.symbol + '","side":"sell","qty":"' + str.tostring(partialQty, '#.######') + '"' + exchB_base(cfg)

export exchB_closeShortPartial(ExchangeConfigB cfg, float partialQty) =>
    '{"symbol":"' + cfg.symbol + '","side":"buy","qty":"' + str.tostring(partialQty, '#.######') + '"' + exchB_base(cfg)