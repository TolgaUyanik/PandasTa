library("FvgCalculations", true)

// FvgCalculations Library
// v2, 2025.06.12

// This code's style is based on the recommendations from the Pine Script User Manual's Style guide:
//    https://www.tradingview.com/pine-script-docs/writing/style-guide/



import no1x/FvgTypes/2 as types 



//#region ———————————————————— Functions


// @function                        Requests historical bar data for specific previous bars from a specified higher timeframe.
//                                  It fetches H[1], L[1], T[1] (for the bar before last) and H[3], L[3], T[3] (for the bar three periods prior)
//                                  from the requested `timeframe`. This is typically used to identify FVG patterns on MTF/HTF.
// @param timeframe (simple string) The higher timeframe to request data from (e.g., "60" for 1-hour, "D" for Daily).
// @returns         (tuple)         A tuple containing: [htfHigh1, htfLow1, htfTime1, htfHigh3, htfLow3, htfTime3].
//                  - `htfHigh1` (series float): High of the bar at index 1 (one bar before the last completed bar on `timeframe`).
//                  - `htfLow1`  (series float): Low of the bar at index 1.
//                  - `htfTime1` (series int)  : Time of the bar at index 1.
//                  - `htfHigh3` (series float): High of the bar at index 3 (three bars before the last completed bar on `timeframe`).
//                  - `htfLow3`  (series float): Low of the bar at index 3.
//                  - `htfTime3` (series int)  : Time of the bar at index 3.
export requestMultiTFBarData(simple string timeframe) => // 'simple' is fine here as it's a direct input-like string
    request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], high[3], low[3], time[3]], lookahead = barmerge.lookahead_on)


// @function                                Detects a Fair Value Gap (FVG) on a higher timeframe (MTF/HTF) using pre-fetched bar data.
// @param htfHigh1        (series float)    High of the first relevant bar (typically `high[1]`) from the higher timeframe.
// @param htfLow1         (series float)    Low of the first relevant bar (typically `low[1]`) from the higher timeframe.
// @param htfTime1        (series int)      Time of the first relevant bar (typically `time[1]`) from the higher timeframe.
// @param htfHigh3        (series float)    High of the third relevant bar (typically `high[3]`) from the higher timeframe.
// @param htfLow3         (series float)    Low of the third relevant bar (typically `low[3]`) from the higher timeframe.
// @param htfTime3        (series int)      Time of the third relevant bar (typically `time[3]`) from the higher timeframe.
// @param tfAtr           (series float)    ATR value for the higher timeframe, used for Large Volume (LV) FVG classification.
// @param classifyLV      (bool)            If true, FVGs will be assessed to see if they qualify as Large Volume. Type inferred as simple.
// @param lvAtrMultiplier (float)           The ATR multiplier used to define if an FVG is Large Volume. Type inferred as simple.
// @param tfType          (types.tfType)    The timeframe type (e.g., `types.tfType.MTF`, `types.tfType.HTF`) of the FVG being detected. Type inferred as simple.
// @returns               (types.fvgObject) An `fvgObject` instance if an FVG is detected, otherwise `na`.
export detectMultiTFFvg(
     series float htfHigh1, series float htfLow1, series int htfTime1,
     series float htfHigh3, series float htfLow3, series int htfTime3,
     series float tfAtr,    bool classifyLV,      float lvAtrMultiplier, types.tfType tfType
     ) =>
    types.fvgObject fvg = na

    if not na(htfTime1) and not na(htfTime3)
        bool isHtfLow1Valid  = not na(htfLow1)
        bool isHtfHigh3Valid = not na(htfHigh3)
        bool isHtfHigh1Valid = not na(htfHigh1)
        bool isHtfLow3Valid  = not na(htfLow3)

        bool isMultiTFBullishImbalance = isHtfLow1Valid  and isHtfHigh3Valid and htfLow1  > htfHigh3
        bool isMultiTFBearishImbalance = isHtfHigh1Valid and isHtfLow3Valid  and htfHigh1 < htfLow3

        if isMultiTFBullishImbalance
            fvg := types.fvgObject.new()
            float fvgTop       = htfLow1
            float fvgBottom    = htfHigh3
            fvg.isBullish     := true
            fvg.top           := fvgTop
            fvg.bottom        := fvgBottom
            fvg.startTime     := int(htfTime3)
            fvg.tfType        := tfType
            fvg.currentTop    := fvgTop
            fvg.currentBottom := fvgBottom
            if classifyLV and not na(tfAtr) and tfAtr > 0
                float fvgSize = fvgTop - fvgBottom
                if fvgSize / tfAtr >= lvAtrMultiplier
                    fvg.isLV := true
        else if isMultiTFBearishImbalance
            fvg := types.fvgObject.new()
            float fvgTop       = htfLow3
            float fvgBottom    = htfHigh1
            fvg.isBullish     := false
            fvg.top           := fvgTop
            fvg.bottom        := fvgBottom
            fvg.startTime     := int(htfTime3)
            fvg.tfType        := tfType
            fvg.currentTop    := fvgTop
            fvg.currentBottom := fvgBottom
            if classifyLV and not na(tfAtr) and tfAtr > 0
                float fvgSize = fvgTop - fvgBottom
                if fvgSize / tfAtr >= lvAtrMultiplier
                    fvg.isLV := true
    fvg


// @function                                Detects a Fair Value Gap (FVG) on the current (LTF - Low Timeframe) chart.
// @param classifyLV      (bool)            If true, FVGs will be assessed to see if they qualify as Large Volume. Type inferred as simple.
// @param lvAtrMultiplier (float)           The ATR multiplier used to define if an FVG is Large Volume. Type inferred as simple.
// @param currentAtr      (series float)    ATR value for the current timeframe, used for LV FVG classification.
// @returns               (types.fvgObject) An `fvgObject` instance if an FVG is detected, otherwise `na`.
export detectFvg(bool classifyLV, float lvAtrMultiplier, series float currentAtr) =>
    types.fvgObject fvg = na
    bool isBullishImbalance = low > high[2] and barstate.isconfirmed
    bool isBearishImbalance = high < low[2] and barstate.isconfirmed

    if isBullishImbalance
        fvg := types.fvgObject.new()
        float fvgTop       = low
        float fvgBottom    = high[2]
        fvg.isBullish     := true
        fvg.top           := fvgTop
        fvg.bottom        := fvgBottom
        fvg.startTime     := time[2]
        fvg.tfType        := types.tfType.LTF
        fvg.currentTop    := fvgTop
        fvg.currentBottom := fvgBottom
        if classifyLV and not na(currentAtr) and currentAtr > 0
            float fvgSize = fvgTop - fvgBottom
            if fvgSize / currentAtr >= lvAtrMultiplier
                fvg.isLV := true
    else if isBearishImbalance
        fvg := types.fvgObject.new()
        float fvgTop       = low[2]
        float fvgBottom    = high
        fvg.isBullish     := false
        fvg.top           := fvgTop
        fvg.bottom        := fvgBottom
        fvg.startTime     := time[2]
        fvg.tfType        := types.tfType.LTF
        fvg.currentTop    := fvgTop
        fvg.currentBottom := fvgBottom
        if classifyLV and not na(currentAtr) and currentAtr > 0
            float fvgSize = fvgTop - fvgBottom
            if fvgSize / currentAtr >= lvAtrMultiplier
                fvg.isLV := true
    fvg


// @function                         Checks if an FVG has been fully mitigated by the current bar's price action.
// @param isBullish   (bool)         True if the FVG being checked is bullish, false if bearish. Type inferred as simple.
// @param fvgTop      (float)        The top price level of the FVG. Type inferred as simple.
// @param fvgBottom   (float)        The bottom price level of the FVG. Type inferred as simple.
// @param currentHigh (series float) The high price of the current bar.
// @param currentLow  (series float) The low price of the current bar.
// @returns           (series bool)  True if the FVG is considered fully mitigated, false otherwise.
export checkMitigation(bool isBullish, float fvgTop, float fvgBottom, series float currentHigh, series float currentLow) =>
    bool isNowMitigated = false
    if isBullish and not na(fvgBottom)
        isNowMitigated := currentLow <= fvgBottom
    else if not isBullish and not na(fvgTop)
        isNowMitigated := currentHigh >= fvgTop
    isNowMitigated


// @function                              Checks for partial mitigation of an FVG by the current bar's price action.
//                                        It determines if the price has entered the FVG and returns the new fill level.
// @param isBullish        (bool)         True if the FVG being checked is bullish, false if bearish. Type inferred as simple.
// @param currentBoxTop    (float)        The current top of the FVG box (this might have been adjusted by previous partial fills). Type inferred as simple.
// @param currentBoxBottom (float)        The current bottom of the FVG box (similarly, might be adjusted). Type inferred as simple.
// @param currentHigh      (series float) The high price of the current bar.
// @param currentLow       (series float) The low price of the current bar.
// @returns                (series float) The new price level to which the FVG has been filled (e.g., currentLow for a bullish FVG). Returns `na` if no new partial fill occurred on this bar.
export checkPartialMitigation(bool isBullish, float currentBoxTop, float currentBoxBottom, series float currentHigh, series float currentLow) =>
    float newLevel = na
    if isBullish
        if not na(currentBoxTop) and currentLow < currentBoxTop
            newLevel := currentLow
    else
        if not na(currentBoxBottom) and currentHigh > currentBoxBottom
            newLevel := currentHigh
    newLevel


// @function                        Checks if the current bar's price interacts with the given FVG.
//                                  Interaction means the price touches or crosses into the FVG's
//                                  current (possibly partially filled) range.
// @param fvg     (types.fvgObject) The FVG object to check. Its `isMitigated`, `isVisible`, `isBullish`, `currentTop`, and `currentBottom` fields are used.
// @param highVal (series float)    The high price of the current bar.
// @param lowVal  (series float)    The low price of the current bar.
// @returns       (bool)            True if price interacts with the FVG, false otherwise.
export fvgInteractionCheck(types.fvgObject fvg, series float highVal, series float lowVal) =>
    bool interacts = false
    if not fvg.isMitigated and fvg.isVisible 
        interacts := (fvg.isBullish and lowVal <= fvg.currentTop) or (not fvg.isBullish and highVal >= fvg.currentBottom)
    interacts
//#endregion
