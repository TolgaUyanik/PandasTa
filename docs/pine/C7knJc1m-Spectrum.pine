//@version=5
import RezzaHmt/Complex/1 as cx

library('Spectrum', true)

// Constants
const float logR            = 1.442695040889  // LOG2(X)/LOGe(X)

// --- Preliminary Functions ---
//@function         Creates an array of complex type objects from a float type array.
//@param data       The float type array of input data.
//@param polar      Initialization coordinates; the default is false (cartesian).
//@returns          The complex type array of converted data.
export method toComplex(array <float> data, bool polar = false) =>
    int             n       = data.size()
    out                     = array.new <cx.complex> (n, na)
    
    for [i, element] in data
        out.set(i, cx.complex.new(element, 0, polar))
        
    out
    
//@function         Performs scalar addition of a given float type array and a simple float value.
//@param data       The float type array of input data.
//@param value      The simple float type value to be added.
//@param end        The last index of the input array (exclusive) on which the operation is performed.
//@param start      The first index of the input array (inclusive) on which the operation is performed; the default value is 0.
//@param step       The step by which the function iterates over the input data array between the specified boundaries; the default value is 1.
//@returns          The modified input array.
export method sAdd(array <float> data, float value, int end, int start = 0, int step = 1) =>
    for i = start to (end - 1) by step
        data.set(i, data.get(i) + value)
        
    data
    
//@function         Performs scalar multiplication of a given float type array and a simple float value.
//@param data       The float type array of input data.
//@param value      The simple float type value to be added.
//@param end        The last index of the input array (exclusive) on which the operation is performed.
//@param start      The first index of the input array (inclusive) on which the operation is performed; the default value is 0.
//@param step       The step by which the function iterates over the input data array between the specified boundaries; the default value is 1.
//@returns          The modified input array.
export method sMult(array <float> data, float value, int end, int start = 0, int step = 1) =>
    for i = start to (end - 1) by step
        data.set(i, data.get(i) * value)
        
    data
    
//@function         Performs elementwise multiplication of two given complex type arrays.
//@param data       the first complex type array of input data. 
//@param data02     The second complex type array of input data.
//@param end        The last index of the input arrays (exclusive) on which the operation is performed.
//@param start      The first index of the input arrays (inclusive) on which the operation is performed; the default value is 0.
//@param step       The step by which the function iterates over the input data array between the specified boundaries; the default value is 1.
//@returns          The modified first input array.
export method eMult(array <cx.complex> data, array <cx.complex> data02, int end, int start = 0, int step = 1) =>
    for i = start to (end - 1) by step
        data.set(i, data.get(i).multC(data02.get(i)))
        
    data
    
//@function         Performs elementwise conjugation on a given complex type array.
//@param data       The complex type array of input data.
//@param end        The last index of the input array (exclusive) on which the operation is performed.
//@param start      The first index of the input array (inclusive) on which the operation is performed; the default value is 0.
//@param step       The step by which the function iterates over the input data array between the specified boundaries; the default value is 1.
//@returns          The modified input array.
export method eCon(array <cx.complex> data, int end, int start = 0, int step = 1) =>
    for i = start to (end - 1) by step
        data.set(i, data.get(i).con())
        
    data
    
//@function         Creates a complex type array of zeros.
//@param length     The size of array to be created.
export method zeros(int length) =>
    out                     = array.new <cx.complex> (length, cx.complex.new(0, 0, false))
    out
    
// --- Main Functions ---
//@function         Rearranges a complex type array based on the bit-reverse permutations of its size after zero-padding.
//@param data       The complex type array of input data.
//@returns          The modified input array.
export method bitReverse(array <cx.complex> data) =>
    int             n       = data.size()
    
    if n > 2
        int         k       = math.floor(math.log(n - 1) * logR) + 1
        int         m       = int(math.pow(2, k))
        
        if m > n
            data.concat(zeros(m - n))  // Zero-padding
            
        tmp                 = data.copy()  // cx.complex.new()
        prm                 = array.new <int> (1, 0)  // Permutations table
        
        for i = 1 to k  // Calculating the permutations of size n in k iterations
            j = prm.size()
            prm.sMult(2, j)
            prm.concat(prm)
            prm.sAdd(1, 2 * j, j)
            
        for [i, element] in prm  // Rearrangement
            data.set(i, tmp.get(element))
            
        // for [i, element] in prm
        //     if i < element
        //         tmp         := data.get(i)
        //         data.set(i, data.get(element))
        //         data.set(element, tmp)
                
    data
    
//@function         Calculates Fourier Transform of a time series using Cooley-Tukey Radix-2 Decimation in Time FFT algorithm, https://wikipedia.org/wiki/Cooley–Tukey_FFT_algorithm.
//@param data       The complex type array of input data.
//@param inverse    Set to -1 for FFT and to 1 for iFFT.
//@returns          The modified input array containing the FFT result.
export method R2FFT(array <cx.complex> data, int inverse = -1) =>
    data.bitReverse()
    int             n       = data.size()  // A power of 2
    
    if n > 1
        int         m       = 2  // Initial DFT size
        float       w       = inverse * 2.0 * math.pi / n  // Base frequency
        tmp                 = cx.complex.new()
        LUT                 = array.new <cx.complex> (n / 2, na)  // Look-up Table for twiddle factors
        
        for [i, element] in LUT
            LUT.set(i, cx.complex.new(1, i * w, true).toCart())  // exp(j * (-2 * π / n) * i) = exp(j * w * i) = LUT(i)  where  j = √-1, i = 0 to n/2
            
        for k = 0 to math.floor(math.log(n - 1) * logR)
            int     h       = m / 2  // Half the current DFT size
            int     s       = n / m  // Step by which twiddle factor index iterates 
            
            for i = 0 to n - 1 by m
                int u       = 0  // Twiddle factor index
                
                for j = i to i + h - 1  // 'j' iterates over the half first points of the m-sized DFTs, where 'i' indicates the first point of each of the DFTs
                    tmp     :=  LUT.get(u).multC(data.get(j + h))  // 'h' is used to access the other half of the DFTs
                    data.set(j + h, data.get(j).subC(tmp))
                    data.set(j,     data.get(j).addC(tmp))
                    u       += s
                    
            m *= 2  // Obtaining the DFT size for next stage
            
    data
    
// Flow graph of 8-point DFT using the Radix-2 DIT algorithm
// Note that the input is in bit-reversed order

//    data(0)      data(4)      data(2)      data(6)      data(1)      data(5)      data(3)      data(7)
//       |            |            |            |            |            |            |            |      ———
//       |          ×L(0)          |          ×L(0)          |          ×L(0)          |          ×L(0)                                 // The result of this multiplication is stored in 'tmp';  LUT(u) = L(u)
//       |            |            |            |            |            |            |            |
//       |\          /|            |\          /|            |\          /|            |\          /|
//       | \        / |            | \        / |            | \        / |            | \        / |                                   // There are LOG2(n) stages in total. Each stage containing n/2 2-point DFTs called butterflies.
//       |  \      /  |            |  \      /  |            |  \      /  |            |  \      /  |    srage 1
//       |   \    /   |            |   \    /   |            |   \    /   |            |   \    /   |       -
//       |    \  /    |            |    \  /    |            |    \  /    |            |    \  /    |     m = 2                         // Indicates the size of the DFTs in each stage and equals 2 raised to the power of 'stage number'.
//       |     \/     |            |     \/     |            |     \/     |            |     \/     |     h = 1
//       |     /\    ×-1           |     /\    ×-1           |     /\    ×-1           |     /\    ×-1    i = 0-7 by 2 (4 executions)
//       |    /  \    |            |    /  \    |            |    /  \    |            |    /  \    |     u = 0-0 by 4
//       |   /    \   |            |   /    \   |            |   /    \   |            |   /    \   |
//       |  /      \  |            |  /      \  |            |  /      \  |            |  /      \  |
//       | /        \ |            | /        \ |            | /        \ |            | /        \ |
//       |/          \|            |/          \|            |/          \|            |/          \|
//       |            |            |            |            |            |            |            |      ———
//       |            |          ×L(0)        ×L(2)          |            |          ×L(0)        ×L(2)
//       |            |            |            |            |            |            |            |
//       |\           |\          /|           /|            |\           |\          /|           /|
//       |  \         |  \      /  |         /  |            |  \         |  \      /  |         /  |
//       |    \       |    \  /    |       /    |            |    \       |    \  /    |       /    |    srage 2
//       |      \     |     /\     |     /      |            |      \     |     /\     |     /      |       -
//       |        \   |   /    \   |   /        |            |        \   |   /    \   |   /        |     m = 4
//       |          \ | /        \ | /          |            |          \ | /        \ | /          |     h = 2
//       |          / | \        / | \          |            |          / | \        / | \          |     i = 0-7 by 4 (2 executions)
//       |        /   |   \    /   |   \        |            |        /   |   \    /   |   \        |     u = 0-2 by 2
//       |      /     |     \/    ×-1    \     ×-1           |      /     |     \/    ×-1    \     ×-1
//       |    /       |    /  \    |       \    |            |    /       |    /  \    |       \    |
//       |  /         |  /      \  |         \  |            |  /         |  /      \  |         \  |
//       |/           |/          \|           \|            |/           |/          \|           \|
//       |            |            |            |            |            |            |            |      ———
//       |            |            |            |          ×L(0)        ×L(1)        ×L(2)        ×L(3)
//       |            |            |            |            |            |            |            |
//       |  \         |  \         |  \         |  \      /  |         /  |         /  |         /  |
//       |      \     |      \     |      \     |     /\     |     /      |     /      |     /      |
//       |          \ |          \ |          \ | /        \ | /          | /          | /          |    srage 3
//       |            | \          | \        / | \        / | \        / |          / |            |       -
//       |            |     \      |     \/     |     \/     |     \/     |      /     |            |     m = 8
//       |            |         \  |  /      \  |  /      \  |  /      \  |  /         |            |     h = 4
//       |            |         /  |  \      /  |  \      /  |  \      /  |  \         |            |     i = 0-7 by 8 (1 execution)
//       |            |     /      |     /\     |     /\     |     /\     |      \     |            |     u = 0-3 by 1
//       |            | /          | /        \ | /        \ | /        \ |          \ |            |
//       |          / |          / |          / | \        / | \          | \          | \          |
//       |      /     |      /     |      /     |     \/    ×-1    \     ×-1    \     ×-1    \     ×-1
//       |  /         |  /         |  /         |  /      \  |         \  |         \  |         \  |
//       |            |            |            |            |            |            |            |
//       |            |            |            |            |            |            |            |
//     FFT(0)       FFT(1)       FFT(2)       FFT(3)       FFT(4)       FFT(5)       FFT(6)       FFT(7)

//@function         Calculates Fourier Transform of a time series using Leo Bluestein's FFT algorithm, https://wikipedia.org/wiki/Chirp_Z-transform#Bluestein.27s_algorithm. This function is nearly 4 times slower than the R2FFT function in practice.
//@param data       The complex type array of input data.
//@param inverse    Set to -1 for FFT and to 1 for iFFT.
//@returns          The modified input array containing the FFT result.
export method LBFFT(array <cx.complex> data, int inverse = -1) =>
    int             n       = data.size()
    
    if n > 1
        int         k       = math.floor(math.log(2 * n - 2) * logR) + 1
        int         m       = int(math.pow(2, k))  // Linear convolution of 2 n-sized series results in a series of size 2n-1. The goal is to find a power of 2 that satisfies the imposed size limit.
        float       w       = inverse * math.pi / n
        CHR                 = array.new <cx.complex> (n, na)  // Chirp signal
        
        for [i, element] in CHR
            CHR.set(i, cx.complex.new(1, -math.pow(i, 2) * w, true).toCart())
            
        B                   = CHR.copy()
        B.concat(zeros(m - 2 * n + 1))
        CHR.reverse()
        B.concat(CHR)
        CHR.reverse()
        B.pop()
        CHR.eCon(n)
        data.eMult(CHR, n)  // A
        data.concat(zeros(m - n))  // Cyclic convolution will only be equal to linear convolution if there is enough zero elements at one side to prevent overlapping.
        R2FFT(data, -1)
        R2FFT(B, -1)
        data.eMult(B, m)
        R2FFT(data, 1)
        data.eMult(CHR, n)  // Applying phase factor
        scaleFactor         = cx.complex.new(1 / m, 0, false)
        
        for i = 0 to n - 1
            data.set(i, data.get(i).multC(scaleFactor))  // Applying scale factor
            
        for i = 1 to m - n
            data.remove(n)  // Removing extra elements
            
    data
    
//@function         This is the original DFT algorithm. It is not suggested to be used regularly.
//@param data       The complex type array of input data.
//@param inverse    Set to -1 for DFT and to 1 for iDFT.
//@returns          The complex type array of DFT result.
export method DFT(array <cx.complex> data, int inverse = -1) =>
    int             n       = data.size()
    float           w       = inverse * 2.0 * math.pi / n
    tmp                     = cx.complex.new(0, 0, false)
    out                     = array.new <cx.complex> (n, na)
    
    for k = 0 to n - 1
        for i = 0 to n - 1
            corFactor       = cx.complex.new(1, i * k * w, true).toCart()
            tmp             := tmp.addC(data.get(i).multC(corFactor))
            
        out.set(k, tmp)
        tmp                 := cx.complex.new(0, 0, false)
        
    out
    
