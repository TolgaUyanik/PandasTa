//@version=6
indicator("6 Custom EMA Ribbon", shorttitle="6 EMA Ribbon", overlay=true)

//─────────────────────────────────────────────
// General Settings
//─────────────────────────────────────────────
source = input.source(close, "EMA Source")

//─────────────────────────────────────────────
// EMA 1 Settings
//─────────────────────────────────────────────
showEMA1  = input.bool(true, "Show EMA 1", group="EMA 1")
ema1Length = input.int(5, "Length", minval=1, group="EMA 1")
ema1Color  = input.color(color.blue, "Colour", group="EMA 1")
ema1Width  = input.int(2, "Line Width", minval=1, maxval=5, group="EMA 1")

//─────────────────────────────────────────────
// EMA 2 Settings
//─────────────────────────────────────────────
showEMA2  = input.bool(true, "Show EMA 2", group="EMA 2")
ema2Length = input.int(8, "Length", minval=1, group="EMA 2")
ema2Color  = input.color(color.red, "Colour", group="EMA 2")
ema2Width  = input.int(2, "Line Width", minval=1, maxval=5, group="EMA 2")

//─────────────────────────────────────────────
// EMA 3 Settings
//─────────────────────────────────────────────
showEMA3  = input.bool(true, "Show EMA 3", group="EMA 3")
ema3Length = input.int(13, "Length", minval=1, group="EMA 3")
ema3Color  = input.color(color.green, "Colour", group="EMA 3")
ema3Width  = input.int(2, "Line Width", minval=1, maxval=5, group="EMA 3")

//─────────────────────────────────────────────
// EMA 4 Settings
//─────────────────────────────────────────────
showEMA4  = input.bool(true, "Show EMA 4", group="EMA 4")
ema4Length = input.int(21, "Length", minval=1, group="EMA 4")
ema4Color  = input.color(color.orange, "Colour", group="EMA 4")
ema4Width  = input.int(2, "Line Width", minval=1, maxval=5, group="EMA 4")

//─────────────────────────────────────────────
// EMA 5 Settings
//─────────────────────────────────────────────
showEMA5  = input.bool(true, "Show EMA 5", group="EMA 5")
ema5Length = input.int(34, "Length", minval=1, group="EMA 5")
ema5Color  = input.color(color.purple, "Colour", group="EMA 5")
ema5Width  = input.int(2, "Line Width", minval=1, maxval=5, group="EMA 5")

//─────────────────────────────────────────────
// EMA 6 Settings
//─────────────────────────────────────────────
showEMA6  = input.bool(true, "Show EMA 6", group="EMA 6")
ema6Length = input.int(55, "Length", minval=1, group="EMA 6")
ema6Color  = input.color(color.yellow, "Colour", group="EMA 6")
ema6Width  = input.int(2, "Line Width", minval=1, maxval=5, group="EMA 6")

//─────────────────────────────────────────────
// EMA Calculations
//─────────────────────────────────────────────
ema1 = ta.ema(source, ema1Length)
ema2 = ta.ema(source, ema2Length)
ema3 = ta.ema(source, ema3Length)
ema4 = ta.ema(source, ema4Length)
ema5 = ta.ema(source, ema5Length)
ema6 = ta.ema(source, ema6Length)

//─────────────────────────────────────────────
// EMA Plots
//─────────────────────────────────────────────
plot(showEMA1 ? ema1 : na, title="EMA 1", color=ema1Color, linewidth=ema1Width)
plot(showEMA2 ? ema2 : na, title="EMA 2", color=ema2Color, linewidth=ema2Width)
plot(showEMA3 ? ema3 : na, title="EMA 3", color=ema3Color, linewidth=ema3Width)
plot(showEMA4 ? ema4 : na, title="EMA 4", color=ema4Color, linewidth=ema4Width)
plot(showEMA5 ? ema5 : na, title="EMA 5", color=ema5Color, linewidth=ema5Width)
plot(showEMA6 ? ema6 : na, title="EMA 6", color=ema6Color, linewidth=ema6Width)