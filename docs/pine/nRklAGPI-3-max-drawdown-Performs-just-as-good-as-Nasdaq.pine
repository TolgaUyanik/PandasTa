//@version=6
strategy("", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 0, currency = currency.USD, initial_capital = 7500, pyramiding = 0, calc_on_order_fills = false)

leverage = input.float(1.0, "Base Leverage", minval = 0.1, step = 0.1)
crashTriggerPerc = input.float(20.0, "Crash Trigger Drop From SPX ATH (%)", minval = 1.0, step = 0.5) / 100
athStaleBars = input.int(116, "No SPX ATH Bars Before 200 EMA Extension Filter", minval = 1)
emaExtensionPerc = input.float(5.0, "Required Extension Above SPX 200 EMA (%)", minval = 0.0, step = 0.25) / 100

spxClose = request.security("SPY", "D", close)
spxLow = request.security("SPY", "D", low)
spxShortMA = ta.sma(spxClose, 7)
spxLongMA = ta.sma(spxClose, 107)
spx21ema = ta.ema(spxClose, 21)
spx200ema = ta.ema(spxClose, 200)

qqqClose = request.security("QQQ", "D", close)
qqqLow = request.security("QQQ", "D", low)
qqq14ema = ta.ema(qqqClose, 10)
qqq21ema = ta.ema(qqqClose, 21)
qqq50sma = ta.sma(qqqClose, 50)

btcClose = request.security("INDEX:BTCUSD", "D", close)
btcLow = request.security("INDEX:BTCUSD", "D", low)

btc10ema = ta.ema(btcClose, 10)
btc21ema = ta.ema(btcClose, 21)
btc50sma = ta.sma(btcClose, 50)

btcTrendFlip = btc10ema > btc21ema
btcHoldingStructure = btcLow > btc21ema
btcMomentum = btcClose > btcClose[1]

btcBullish = btcTrendFlip and btcHoldingStructure and btcMomentum
btcAssist = btcBullish and spxClose > spxShortMA

shortMA = ta.sma(close, 7)
longMA = ta.sma(close, 107)
_14ema = ta.ema(close, 14)
_21ema = ta.ema(close, 21)
_50sma = ta.sma(close, 50)
_200sma = ta.sma(close, 200)

var float qqqPriceAtEntry = na
var float spxAllTimeHigh = na
var int spxBarsSinceAth = 0
var bool crashArmed = false
var bool recoveryHoldActive = false
var float recoveryAthTarget = na

spxNewAthNow = na(spxAllTimeHigh) or spxClose >= spxAllTimeHigh

if spxNewAthNow
    spxBarsSinceAth := 0
else
    spxBarsSinceAth += 1

spxNoAthSixMonths = spxBarsSinceAth >= athStaleBars
spxExtendedAbove200Ema = spxClose > spx200ema * (1 + emaExtensionPerc)
athStaleEntryFilter = not spxNoAthSixMonths or spxExtendedAbove200Ema

spxPriorAth = nz(spxAllTimeHigh, spxClose)
spxDrawdownFromAth = spxPriorAth > 0 ? 1 - spxClose / spxPriorAth : 0
spxCrash20Plus = not na(spxAllTimeHigh) and spxDrawdownFromAth >= crashTriggerPerc

if spxCrash20Plus
    crashArmed := true

if strategy.position_size > 0 and spxCrash20Plus and not recoveryHoldActive
    recoveryHoldActive := true
    recoveryAthTarget := spxPriorAth

longLossPerc = input.float(title = "Long Stop Loss (%)", minval = 0.0, step = 0.1, defval = 3.5) / 100

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    qqqPriceAtEntry := qqqClose

    if crashArmed
        recoveryHoldActive := true
        recoveryAthTarget := spxPriorAth

spxReachedRecoveryAth = recoveryHoldActive and not na(recoveryAthTarget) and spxClose >= recoveryAthTarget

if spxReachedRecoveryAth
    recoveryHoldActive := false
    recoveryAthTarget := na
    crashArmed := false

if not recoveryHoldActive and not na(spxAllTimeHigh) and spxClose >= spxAllTimeHigh
    crashArmed := false

spxAllTimeHigh := na(spxAllTimeHigh) ? spxClose : math.max(spxAllTimeHigh, spxClose)

longStopPrice = nz(qqqPriceAtEntry) * (1 - longLossPerc)

getADX() =>
    [p, m, a] = ta.dmi(13, 13)
    a

spxLowAbove21Ema4daysInARow = spxLow > spx21ema and spxLow[1] > spx21ema[1] and spxLow[2] > spx21ema[2] and spxLow[3] > spx21ema[3]
qqqLowAboveKeyEmas = qqqLow > qqq14ema and qqqLow > qqq21ema
qqqNotShowingWeakness = not (qqqClose < qqqClose[1] and qqqClose < qqqClose[2] and qqqClose < qqqClose[3])
spxAdxValue = request.security("SPX", "D", getADX())
isTrending = spxAdxValue > 16

longCondition = spxLowAbove21Ema4daysInARow and qqqLowAboveKeyEmas and qqqNotShowingWeakness and isTrending
enhancedLongCondition = longCondition or btcAssist

spxBearishCross = spxShortMA < spxLongMA[1]
spxPriceWeak = spxClose < spxShortMA
qqqPriceWeak = qqqClose < qqq21ema
trendEstablishedLooseStop = spxBearishCross and spxPriceWeak and qqqPriceWeak

stopLevelHit = qqqLow < longStopPrice
belowFiftySMA = qqqLow < qqq50sma
initialBuyTightStop = not na(qqqPriceAtEntry) and stopLevelHit and belowFiftySMA

inLosingTrade = strategy.position_size > 0 and not na(qqqPriceAtEntry) and qqqClose < qqqPriceAtEntry
inWinningTrade = strategy.position_size > 0 and not na(qqqPriceAtEntry) and qqqClose >= qqqPriceAtEntry

losingTradeFastExit = inLosingTrade and qqqClose < qqq21ema and spxClose < spxShortMA
winningTradeNormalExit = inWinningTrade and (trendEstablishedLooseStop or initialBuyTightStop)

forceRecoveryHold = recoveryHoldActive and not spxReachedRecoveryAth

exitCondition = not forceRecoveryHold and (losingTradeFastExit or winningTradeNormalExit)

startDate = input.int(title = "Start Date", defval = 10, minval = 1, maxval = 24)
startMonth = input.int(title = "Start Month", defval = 3, minval = 1, maxval = 12)
startYear = input.int(title = "Start Year", defval = 2001, minval = 1920, maxval = 2500)
inDateRange = time >= timestamp(syminfo.timezone, startYear, startMonth, startDate, 0, 0)

entryQty = (strategy.equity * leverage) / close

if enhancedLongCondition and athStaleEntryFilter and inDateRange and strategy.position_size <= 0
    strategy.entry("Buy", strategy.long, qty = entryQty)

if exitCondition and inDateRange
    strategy.close_all()

if strategy.position_size == 0
    qqqPriceAtEntry := na
    recoveryHoldActive := false
    recoveryAthTarget := na

r = color.r(chart.bg_color)
g = color.g(chart.bg_color)
b = color.b(chart.bg_color)
bool darkMode = r < 80 and g < 80 and b < 80

color color21ema = color.green
color colorShortMA = color.new(color.purple, 30)
color colorLongMA = color.new(color.blue, 35)
color buyBackground = color.new(#5fe9f3, 50)

plot(_14ema, color = color.new(color.black, 0), title = "14 EMA")
plot(_21ema, color = color21ema, title = "21 EMA")
plot(_50sma, color = color.new(color.red, 0), title = "50 SMA")
plot(_200sma, color = color.new(color.gray, 0), title = "200 SMA")
plot(shortMA, color = colorShortMA, title = "7 SMA")
plot(longMA, color = colorLongMA, title = "107 SMA")

bgcolor(strategy.position_size > 0 ? buyBackground : na)