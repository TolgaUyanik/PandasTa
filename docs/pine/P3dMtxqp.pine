//@version=6
// @description Multi-Timeframe Utilities Library: conversions, Fibonacci, TF sorting, MTF helpers, color gradients, demo table
library("MTFToolkit")

// ====================================================================
// TIMEFRAME CONVERSIONS
// ====================================================================
export timeframeToMinutes(string tf) =>
    tfC = str.trim(tf)
    (tfC == "1D" or tfC == "D") ? 1440 :
     tfC == "2D" ? 2880 :
     tfC == "3D" ? 4320 :
     tfC == "5D" ? 7200 :
     (tfC == "1W" or tfC == "W") ? 10080 :
     tfC == "2W" ? 20160 :
     (tfC == "1M" or tfC == "M") ? 43800 :
     tfC == "2M" ? 87600 :
     str.endswith(tfC,"m") ? float(str.tonumber(str.replace(tfC,"m",""))) :
     str.endswith(tfC,"h") ? float(str.tonumber(str.replace(tfC,"h",""))*60) :
     na

export minutesToTimeframe(float minutes) =>
    minutes <= 1440 ? str.tostring(int(minutes)) + "m" :
     minutes <= 10080 ? str.tostring(int(minutes/1440)) + "D" :
     str.tostring(int(minutes/43800)) + "M"

export timeframeToSeconds(string tf) =>
    timeframeToMinutes(tf)*60.0

export secondsToTimeframe(float seconds) =>
    minutesToTimeframe(seconds/60.0)

// ====================================================================
// FIBONACCI FUNCTIONS
// ====================================================================
export fiboGenerate(int n) =>
    var arr = array.new_float()
    array.push(arr,1)
    if n>1
        array.push(arr,1)
    for i=2 to n-1
        array.push(arr, array.get(arr,i-1)+array.get(arr,i-2))
    arr

export fiboMapToTV(array<float> arrFibo) =>
    var arrTV = array.new_string()
    for i=0 to array.size(arrFibo)-1
        val = array.get(arrFibo,i)
        tfStr = val <= 1440 ? str.tostring(int(val)) + "m" :
                 val <= 10080 ? str.tostring(int(val/1440)) + "D" :
                               str.tostring(int(val/43800)) + "M"
        array.push(arrTV, tfStr)
    arrTV

// ====================================================================
// ARRAY UTILITIES
// ====================================================================
export arrayMergeUnique(array<string> arr1, array<string> arr2) =>
    var arr = array.copy(arr1)
    for i=0 to array.size(arr2)-1
        v = array.get(arr2,i)
        if not array.includes(arr,v)
            array.push(arr,v)
    arr

export arrayFilterMax(array<string> arr, float maxMinutes) =>
    var arrF = array.new_string()
    for i=0 to array.size(arr)-1
        tf = array.get(arr,i)
        if timeframeToMinutes(tf) <= maxMinutes
            array.push(arrF, tf)
    arrF

export arraySortTF(array<string> tf_array, array<string> show_array, bool ascending) =>
    n = array.size(tf_array)
    tmp_arr = array.new_float()
    for i=0 to n-1
        array.push(tmp_arr, timeframeToMinutes(array.get(tf_array,i)))
    for i=1 to n-1
        key_tf = array.get(tf_array, i)
        key_show = array.get(show_array, i)
        key_min = array.get(tmp_arr, i)
        j = i-1
        cmp = ascending ? array.get(tmp_arr,j) > key_min : array.get(tmp_arr,j) < key_min
        while j >= 0 and cmp
            array.set(tmp_arr, j+1, array.get(tmp_arr,j))
            array.set(tf_array, j+1, array.get(tf_array,j))
            array.set(show_array, j+1, array.get(show_array,j))
            j -= 1
            if j >= 0
                cmp := ascending ? array.get(tmp_arr,j) > key_min : array.get(tmp_arr,j) < key_min
        array.set(tmp_arr, j+1, key_min)
        array.set(tf_array, j+1, key_tf)
        array.set(show_array, j+1, key_show)

// ====================================================================
// MTF UTILITIES
// ====================================================================
export masterTF(array<string> arr) =>
    maxVal = 0.0
    maxTF = ""
    for i=0 to array.size(arr)-1
        tf = array.get(arr,i)
        m = timeframeToMinutes(tf)
        if not na(m) and m>maxVal
            maxVal := m
            maxTF := tf
    maxTF

export slaveTF(array<string> arr) =>
    var arrS = array.new_string()
    master = masterTF(arr)
    for i=0 to array.size(arr)-1
        tf = array.get(arr,i)
        if tf != master
            array.push(arrS, tf)
    arrS

export isTFIncreasing(string prevTF, string nextTF) =>
    timeframeToMinutes(nextTF) > timeframeToMinutes(prevTF)

export TFScore(array<float> values) =>
    size = array.size(values)
    if size == 0
        na
    else
        sum = 0.0
        for i = 0 to size - 1
            sum += array.get(values, i)
        sum / size

// ====================================================================
// COLOR UTILITIES
// ====================================================================
export gradient_triangular(float value = 0.0, float mid_point = 50.0,
                           color min_color = color.black,
                           color mid_color = color.white,
                           color max_color = color.black) =>
    color _col = na
    if value <= mid_point
        _col := color.from_gradient(value, 0.0, mid_point, min_color, mid_color)
    else
        _col := color.from_gradient(value, mid_point, 100.0, mid_color, max_color)
    _col

export TFColorGradient(float tf_val, float min_val, float max_val) =>
    norm = math.max(0.0, math.min(100.0, (tf_val - min_val) / (max_val - min_val) * 100.0))
    gradient_triangular(norm, 50.0, color.red, color.yellow, color.lime)

export TFColorGradientEx(float tf_val,
                         float min_val, float mid_val, float max_val,
                         color low_color, color mid_color, color high_color) =>
    norm = math.max(0.0, math.min(100.0, (tf_val - min_val) / (max_val - min_val) * 100.0))
    mid_norm = (mid_val - min_val) / (max_val - min_val) * 100.0
    gradient_triangular(norm, mid_norm, low_color, mid_color, high_color)

// ====================================================================
// DEMO / TEST TABLE
// ====================================================================
export demoTable(array<string> tf_arr, array<bool> show_arr, string dashboard_position, bool horizontal_table, bool show_header) =>
    pos = dashboard_position=="Top Left"    ? position.top_left :
          dashboard_position=="Top Right"   ? position.top_right :
          dashboard_position=="Bottom Left" ? position.bottom_left :
          dashboard_position=="Bottom Right"? position.bottom_right :
          dashboard_position=="Top Center"  ? position.top_center :
          dashboard_position=="Bottom Center"? position.bottom_center :
          dashboard_position=="Middle Right"? position.middle_right : position.middle_left

    n_active = 0
    for i=0 to array.size(tf_arr)-1
        if array.get(show_arr,i)
            n_active += 1

    cols = horizontal_table ? (n_active + 1) : 3
    rows = horizontal_table ? 3 : (n_active + (show_header ? 1 : 0))

    var table t = na
    if na(t)
        t := table.new(pos, cols, rows, frame_color=color.gray, frame_width=1, border_width=1, border_color=color.gray)
    table.clear(t, 0,0,cols-1,rows-1)

    if show_header
        if horizontal_table
            table.cell(t,0,0,"TF",text_color=color.white)
            table.cell(t,0,1,"Trend",text_color=color.white)
            table.cell(t,0,2,"Val",text_color=color.white)
        else
            table.cell(t,0,0,"TF",text_color=color.white)
            table.cell(t,1,0,"Trend",text_color=color.white)
            table.cell(t,2,0,"Val",text_color=color.white)

    for j=0 to array.size(tf_arr)-1
        if not array.get(show_arr,j)
            continue
        tf = array.get(tf_arr,j)
        tf_val = timeframeToMinutes(tf)
        icon = tf_val>1440 ? "🟢" : tf_val>60 ? "🟡" : "🔴"
        label = tf_val>1440 ? str.tostring(int(tf_val/1440))+"D" :
                 tf_val>60   ? str.tostring(int(tf_val/60))+"H" :
                              str.tostring(int(tf_val))+"m"
        if horizontal_table
            table.cell(t,j+1,0,label,bgcolor=TFColorGradient(tf_val,0,10080))
            table.cell(t,j+1,1,icon)
            table.cell(t,j+1,2,str.tostring(tf_val))
        else
            table.cell(t,0,j+(show_header?1:0),label,bgcolor=TFColorGradient(tf_val,0,10080))
            table.cell(t,1,j+(show_header?1:0),icon)
            table.cell(t,2,j+(show_header?1:0),str.tostring(tf_val))
    t  // retourne le tableau pour usage ultérieur
