//@version=5

// @description library to call alert with parameters specified  
library("alert_format")


//@type NamedValues type holds string parameters with their names 
export type NamedValues
    array<string> names
    array<string> values
    string default_format = na

// @function Creates new empty NamedValues instance
// @returns empty NamedValues instance
export NamedValues_new() => 
    NamedValues.new(array.new_string(), array.new_string())

// @function Changes default format
// @param format Format for all param values (2 decimals by default)
// @returns Self
export method with_format(NamedValues this, string format) =>
    this.default_format := format
    this

// @function Adds string value
// @param name Parameter name
// @param value Parameter value
// @returns Self
export method with_value(NamedValues this, string name, string value) =>
    array.push(this.names, name)
    array.push(this.values, value)
    this

export method with_timeframe(NamedValues this, string name) =>
    out_str = timeframe.isminutes ? (timeframe.multiplier % 60 != 0 ? timeframe.period + " min" : str.tostring(timeframe.in_seconds() / 3600) + "h") : timeframe.period
    with_value(this, name, out_str)

export method with_line(NamedValues this, string name) =>
    array.push(this.names, name)
    array.push(this.values, na)
    this

method format(NamedValues this, float value) =>
    na(this.default_format) ? str.tostring(math.round_to_mintick(value)) : str.tostring(value, this.default_format)

// @function Adds float value
// @param name Parameter name
// @param value Parameter value
// @returns Self
export method with_value(NamedValues this, string name, float value) =>
    array.push(this.names, name)
    array.push(this.values, this.format(value))
    this

// @function Adds float value
// @param name Parameter name
// @param value Parameter value
// @returns Self
export method with_value(NamedValues this, string name, float value, string format) =>
    array.push(this.names, name)
    array.push(this.values, str.tostring(value, format))
    this

export method with_value_range(NamedValues this, string name, float value1, float value2) =>
    this.with_value(name, str.format("{0}-{1}", this.format(value1), this.format(value2)))

export method with_value_range(NamedValues this, string name, float value1, float value2, string format) =>
    this.with_value(name, str.format("{0}-{1}", str.tostring(value1, format), str.tostring(value2, format)))

export method to_string(NamedValues this) =>
    string result = ""
    if array.size(this.names) != array.size(this.values)
        runtime.error("Error: Arrays must be same size")
    else
        for i = 0 to array.size(this.names) - 1
            param_name = array.get(this.names, i)
            param_value = array.get(this.values, i)
            result += na(param_value) ? param_name : param_name + "" + param_value + "\n"
    result

export method to_json(NamedValues this) =>
    string result = "{"
    if array.size(this.names) != array.size(this.values)
        runtime.error("Error: Arrays must be same size")
    else
        for i = 0 to array.size(this.names) - 1
            param_name = array.get(this.names, i)
            param_value = array.get(this.values, i)
            param_value := str.replace_all(param_value, "\n", "\\n")
            postfix = i == array.size(this.names) - 1 ? "" :  ", "
            result += str.format("\"{0}\":\"{1}\"{2}", param_name, param_value, postfix)
    result += "}"
    result

// @function alert with named parameters message 
// @param message Message header that prefixes named parameters
// @param named_values Named values 
// @param freq Determines the allowed frequency of the alert trigger (see @alert). @alert.freq_once_per_bar_close by default
export alert_format(string message, NamedValues named_values, string freq = alert.freq_once_per_bar_close) =>
    string result = message + "\n"
    if array.size(named_values.names) != array.size(named_values.values)
        runtime.error("Error: Arrays must be same size")
    else
        for i = 0 to array.size(named_values.names) - 1
            param_name = array.get(named_values.names, i)
            param_value = array.get(named_values.values, i)
            result += param_name + ": " + param_value + "\n"
    switch freq
        alert.freq_all => alert(result, alert.freq_all)
        alert.freq_once_per_bar => alert(result, alert.freq_once_per_bar)
        alert.freq_once_per_bar_close => alert(result, alert.freq_once_per_bar_close)
