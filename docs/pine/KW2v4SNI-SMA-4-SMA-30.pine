//@version=6
strategy(
     "SMA(4)/SMA(30)",
     overlay = true,
     initial_capital = 100000,
     currency = currency.USD,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     process_orders_on_close = true // voer orders uit op de bar-close
)

// Timeframefilter: gebruik dit alleen op een daily chart
// Wil je de strategie forceren op daily, dan kun je in de strategy settings "Timeframe" = 1D zetten.

// Bronprijs (close)
src = close

// SMA's
smaShortLen = 4
smaLongLen  = 30

smaShort = ta.sma(src, smaShortLen)
smaLong  = ta.sma(src, smaLongLen)

// Cross-voorwaarden: op bar-close
longCondition  = ta.crossover(smaShort, smaLong)   // SMA(4) kruist boven SMA(30)
flatCondition  = ta.crossunder(smaShort, smaLong)  // SMA(4) kruist onder SMA(30)

// Plot SMA's
plot(smaShort, title = "SMA 4", color = color.new(color.white, 0), linewidth = 1)
plot(smaLong,  title = "SMA 30", color = color.new(color.yellow, 0), linewidth = 1)

// Signalen tonen op de chart (optioneel)
plotshape(longCondition, title="Buy", style=shape.triangleup, location=location.belowbar,
          color=color.new(color.green, 0), size=size.tiny, text="BUY")
plotshape(flatCondition, title="Sell", style=shape.triangledown, location=location.abovebar,
          color=color.new(color.red, 0), size=size.tiny, text="SELL")

// Entry & exit logica
// Eén positie tegelijk, altijd volledig in of volledig uit
if (longCondition)
    // Als er nog geen positie is, ga long bij close
    if strategy.position_size <= 0
        strategy.entry("Long", strategy.long)

if (flatCondition)
    // Sluit de longpositie volledig bij close
    if strategy.position_size > 0
        strategy.close("Long")