//@version=6
indicator("Updated VWAP, EMAs, MACD & Alerts", overlay=true)

// --- 1. EMA Calculations & Plots ---
ema9Value = ta.ema(close, 9)
ema20Value = ta.ema(close, 20)
ema200Value = ta.ema(close, 200)

plot(ema9Value, title="EMA 9", color=color.aqua, linewidth=1)
plot(ema20Value, title="EMA 20", color=color.blue, linewidth=1)
plot(ema200Value, title="EMA 200", color=color.maroon, linewidth=2)

// --- 2. Fixed Rolling VWAP Calculation ---
// We calculate a true rolling volume-weighted average price based on the selected period
vwapPeriod = input.int(14, "VWAP Rolling Period", minval=1)
typicalPrice = (high + low + close) / 3
typicalPriceVolume = typicalPrice * volume

sumTypicalVolume = math.sum(typicalPriceVolume, vwapPeriod)
sumVolume = math.sum(volume, vwapPeriod)

// Fallback preventer: If volume is 0 on a fast 10-second bar, default to typical price to avoid NaN breaks
vwapValue = sumVolume > 0 ? sumTypicalVolume / sumVolume : typicalPrice

// Plot corrected VWAP on the chart
plot(vwapValue, title="VWAP", color=color.purple, linewidth=2)

// --- 3. MACD Calculation Filter ---
fastLength = input.int(12, "MACD Fast Length")
slowLength = input.int(26, "MACD Slow Length")
signalLength = input.int(9, "MACD Signal Length")

fastMA = ta.ema(close, fastLength)
slowMA = ta.ema(close, slowLength)
macdLine = fastMA - slowMA
signalLine = ta.ema(macdLine, signalLength)

// --- 4. Advanced Trend Capture Logic ---
macdCrossUp = ta.crossover(macdLine, signalLine)
macdIsBullish = macdLine > signalLine

// Define a clean structural breakout: Price clearing both short-term EMAs
priceBreakout = ta.crossover(close, ema9Value) and close > ema20Value

// COMBINED ENTRY: Trigger on the MACD bottom crossover OR on a price breakout while MACD is already bullish
rawBuySignal = (macdCrossUp) or (macdIsBullish and priceBreakout)

// Filter out duplicate arrows so it only triggers ONCE at the start of the upward movement
var int lastSignalBar = 0
crossUp = false

if rawBuySignal and (bar_index - lastSignalBar > 3)
    crossUp := true
    lastSignalBar := bar_index

// Exit/Sell Trigger: Crossunder the rolling VWAP level OR breaking below the long-term 200 EMA
crossDown = ta.crossunder(close, vwapValue) or ta.crossunder(close, ema200Value)

// --- 5. Visual Shapes on Chart ---
plotshape(crossUp, title="Cross Up (Buy Signal)", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(crossDown, title="Cross Down (Trend Break)", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// --- 6. Alert Conditions for TradingView's Text-to-Speech Engine ---
alertcondition(crossUp, title="Full Trend Buy Signal Aligned", message="yes")
alertcondition(crossDown, title="Trend Breakdown Exit Signal", message="no")
