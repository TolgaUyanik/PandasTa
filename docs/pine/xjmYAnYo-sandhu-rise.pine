//@version=6
strategy("3 SMA Band Alert Candle Break Strategy - All Historical Trades", overlay=true, pyramiding=0, calc_on_order_fills=true, max_lines_count=500, max_labels_count=500)

// ===== Inputs =====
smaLen = input.int(5, "SMA Length", minval=1)
showTargets = input.bool(true, "Show 1:1 / 1:2 / 1:3 Targets")
showSL = input.bool(true, "Show Stop Loss Line")
markAlertCandle = input.bool(true, "Mark Alert Candle")
markEntry = input.bool(true, "Mark Entry Candle")
extendBars = input.int(20, "Line Extend Bars", minval=1)

// ===== SMA Band =====
smaHigh  = ta.sma(high, smaLen)
smaLow   = ta.sma(low, smaLen)
smaClose = ta.sma(close, smaLen)

plot(smaHigh,  "SMA 5 High",  color=color.red,   linewidth=2)
plot(smaLow,   "SMA 5 Low",   color=color.green, linewidth=2)
plot(smaClose, "SMA 5 Close", color=color.blue,  linewidth=2)

// ===== Band boundaries =====
bandTop = math.max(smaHigh, math.max(smaLow, smaClose))
bandBot = math.min(smaHigh, math.min(smaLow, smaClose))

// ===== Alert candle condition =====
// Complete candle must remain fully outside the SMA band.
alertAbove = low > bandTop
alertBelow = high < bandBot
isAlertCandle = alertAbove or alertBelow

// ===== Latest active setup storage =====
var float activeAlertHigh = na
var float activeAlertLow = na
var float activeAlertRange = na
var int   activeAlertBar = na
var int   activeDirection = 0   // -1 = sell setup, +1 = buy setup

// New alert candle replaces only the currently active pending setup.
// Old completed trades stay visible on chart.
if isAlertCandle and strategy.position_size == 0
    activeAlertHigh := high
    activeAlertLow := low
    activeAlertRange := high - low
    activeAlertBar := bar_index
    activeDirection := alertAbove ? -1 : 1

// ===== Entry conditions =====
sellTrigger = strategy.position_size == 0 and activeDirection == -1 and not na(activeAlertLow) and low < activeAlertLow and bar_index > activeAlertBar
buyTrigger  = strategy.position_size == 0 and activeDirection == 1 and not na(activeAlertHigh) and high > activeAlertHigh and bar_index > activeAlertBar

// ===== Alert candle marks =====
plotshape(
     markAlertCandle and isAlertCandle and alertAbove,
     title="Sell Alert Candle",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.new(color.red, 0),
     textcolor=color.white,
     text="ALERT\nSELL",
     size=size.small)

plotshape(
     markAlertCandle and isAlertCandle and alertBelow,
     title="Buy Alert Candle",
     style=shape.labelup,
     location=location.belowbar,
     color=color.new(color.green, 0),
     textcolor=color.white,
     text="ALERT\nBUY",
     size=size.small)

// ===== Entry execution + historical drawings =====
if sellTrigger
    float entryPrice = activeAlertLow
    float tradeSL = activeAlertHigh
    float tradeRange = activeAlertRange
    float tp1 = entryPrice - tradeRange * 1.0
    float tp2 = entryPrice - tradeRange * 2.0
    float tp3 = entryPrice - tradeRange * 3.0

    strategy.entry("Short", strategy.short, stop=activeAlertLow, alert_message="SELL entry triggered")
    strategy.exit("Short Exit", "Short", stop=tradeSL, limit=tp1, alert_message="SELL exit/target/sl triggered")

    if markEntry
        label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.maroon, textcolor=color.white)

    if showSL
        line.new(bar_index, tradeSL, bar_index + extendBars, tradeSL, extend=extend.none, color=color.red, width=2, style=line.style_dashed)
        label.new(bar_index, tradeSL, "SL (Alert High)", style=label.style_label_left, color=color.red, textcolor=color.white)

    if showTargets
        line.new(bar_index, tp1, bar_index + extendBars, tp1, extend=extend.none, color=color.green, width=2, style=line.style_dotted)
        line.new(bar_index, tp2, bar_index + extendBars, tp2, extend=extend.none, color=color.green, width=2, style=line.style_dotted)
        line.new(bar_index, tp3, bar_index + extendBars, tp3, extend=extend.none, color=color.green, width=2, style=line.style_dotted)
        label.new(bar_index, tp1, "1:1", style=label.style_label_left, color=color.green, textcolor=color.white)
        label.new(bar_index, tp2, "1:2", style=label.style_label_left, color=color.green, textcolor=color.white)
        label.new(bar_index, tp3, "1:3", style=label.style_label_left, color=color.green, textcolor=color.white)

    activeAlertHigh := na
    activeAlertLow := na
    activeAlertRange := na
    activeAlertBar := na
    activeDirection := 0

if buyTrigger
    float entryPrice = activeAlertHigh
    float tradeSL = activeAlertLow
    float tradeRange = activeAlertRange
    float tp1 = entryPrice + tradeRange * 1.0
    float tp2 = entryPrice + tradeRange * 2.0
    float tp3 = entryPrice + tradeRange * 3.0

    strategy.entry("Long", strategy.long, stop=activeAlertHigh, alert_message="BUY entry triggered")
    strategy.exit("Long Exit", "Long", stop=tradeSL, limit=tp1, alert_message="BUY exit/target/sl triggered")

    if markEntry
        label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.lime, textcolor=color.black)

    if showSL
        line.new(bar_index, tradeSL, bar_index + extendBars, tradeSL, extend=extend.none, color=color.red, width=2, style=line.style_dashed)
        label.new(bar_index, tradeSL, "SL (Alert Low)", style=label.style_label_left, color=color.red, textcolor=color.white)

    if showTargets
        line.new(bar_index, tp1, bar_index + extendBars, tp1, extend=extend.none, color=color.green, width=2, style=line.style_dotted)
        line.new(bar_index, tp2, bar_index + extendBars, tp2, extend=extend.none, color=color.green, width=2, style=line.style_dotted)
        line.new(bar_index, tp3, bar_index + extendBars, tp3, extend=extend.none, color=color.green, width=2, style=line.style_dotted)
        label.new(bar_index, tp1, "1:1", style=label.style_label_left, color=color.green, textcolor=color.white)
        label.new(bar_index, tp2, "1:2", style=label.style_label_left, color=color.green, textcolor=color.white)
        label.new(bar_index, tp3, "1:3", style=label.style_label_left, color=color.green, textcolor=color.white)

    activeAlertHigh := na
    activeAlertLow := na
    activeAlertRange := na
    activeAlertBar := na
    activeDirection := 0

// ===== Entry marks using plotshape too =====
plotshape(
     markEntry and buyTrigger,
     title="Buy Entry",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.new(color.lime, 0),
     size=size.large,
     text="BUY")

plotshape(
     markEntry and sellTrigger,
     title="Sell Entry",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.new(color.maroon, 0),
     size=size.large,
     text="SELL")

// ===== Alerts =====
alertcondition(isAlertCandle and alertAbove, title="Sell Setup Alert Candle", message="Alert candle formed above SMA band")
alertcondition(isAlertCandle and alertBelow, title="Buy Setup Alert Candle", message="Alert candle formed below SMA band")
alertcondition(sellTrigger, title="Sell Entry Trigger", message="Sell entry triggered on alert candle low break")
alertcondition(buyTrigger, title="Buy Entry Trigger", message="Buy entry triggered on alert candle high break")

if sellTrigger
    alert("SELL entry: alert candle low broken", alert.freq_once_per_bar_close)

if buyTrigger
    alert("BUY entry: alert candle high broken", alert.freq_once_per_bar_close)
