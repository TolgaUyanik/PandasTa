// @version=6

// @description BarCore is a foundational library for technical analysis, providing essential functions for evaluating the structural properties of candlesticks and inter-bar relationships. 
// It prioritizes ratio-based metrics (0.0 to 1.0) over absolute prices, making it asset-agnostic and ideal for robust pattern recognition, momentum analysis, and volume-weighted pressure evaluation.
//
// Key modules:
// - Structure & Range: High-precision bar and body metrics with relative positioning.
// - Wick Dynamics: Absolute and relative wick analysis for identifying price rejection.
// - Inter-bar Logic: Containment, coverage, and quantitative price overlap (Ratio-based).
// - Gap Intelligence: Real body and price gaps with customizable significance thresholds.
// - Flow & Pressure: Volume-weighted buying/selling pressure and Money Flow metrics.
library(title = "BarCore")

// ====================================================================================
// BAR STRUCTURE: COLOR & BASIC RANGE METRICS
// ====================================================================================

// @function Checks if the bar is a bullish (up) bar, where close is greater than open.
// @returns bool True if the bar closed higher than it opened.
export isBuyingBar() =>
    close > open

// @function Checks if the bar is a bearish (down) bar, where close is less than open.
// @returns bool True if the bar closed lower than it opened.
export isSellingBar() =>
    close < open

// @function Calculates the absolute midpoint of the bar's total range (High + Low) / 2.
// @returns float The midpoint price of the bar.
export barMidpoint() => 
    hl2

// @function Calculates the absolute size of the bar's total range (High to Low).
// @returns float The absolute difference between high and low.
export barRange() =>
    high - low

// @function Calculates half of the bar's total range size.
// @returns float Half the bar's range size.
export barRangeMidpoint() => 
    barRange() / 2

// @function Returns the higher price between the open and close.
// @returns float The top of the real body.
export realBodyHigh() =>
    math.max(open, close)

// @function Returns the lower price between the open and close.
// @returns float The bottom of the real body.
export realBodyLow() =>
    math.min(open, close)

// @function Calculates the absolute midpoint of the bar's real body.
// @returns float The midpoint price of the real body.
export realBodyMidpoint() =>
    (open + close) / 2

// @function Calculates the absolute size of the bar's real body.
// @returns float The absolute difference between open and close.
export realBodyRange() =>
    math.abs(open - close)

// @function Calculates half of the bar's real body size.
// @returns float Half the real body size.
export realBodyRangeMidpoint() => 
    realBodyRange() / 2

// ====================================================================================
// WICK RANGES
// ====================================================================================

// @function Calculates the absolute size of the upper wick.
// @returns float The range from high to the real body high.
export upperWickRange() => 
    high - realBodyHigh()

// @function Calculates the absolute size of the lower wick.
// @returns float The range from the real body low to low.
export lowerWickRange() => 
    realBodyLow() - low

// ====================================================================================
// BAR RATIOS
// ====================================================================================

// @function Returns the location of the open price relative to the bar's total range (0.0 at low to 1.0 at high).
// @returns float The ratio of the distance from low to open, divided by the total range.
export openRatio() =>
    float barRange = barRange()
    barRange == 0 ? 0 : (open - low) / barRange

// @function Returns the location of the close price relative to the bar's total range (0.0 at low to 1.0 at high).
// @returns float The ratio of the distance from low to close, divided by the total range.
export closeRatio() =>
    float barRange = barRange()
    barRange == 0 ? 0 : (close - low) / barRange

// @function Calculates the ratio of the real body size to the total bar range.
// @returns float The real body size divided by the bar range. Returns 0 if barRange is 0.
export realBodyRatio() => 
    float barRange = barRange()
    barRange == 0 ? 0 : realBodyRange() / barRange

// @function Calculates the ratio of the upper wick size to the total bar range.
// @returns float The upper wick size divided by the bar range. Returns 0 if barRange is 0.
export upperWickRatio() => 
    float barRange = barRange()
    barRange == 0 ? 0 : upperWickRange() / barRange

// @function Calculates the ratio of the lower wick size to the total bar range.
// @returns float The lower wick size divided by the bar range. Returns 0 if barRange is 0.
export lowerWickRatio() => 
    float barRange = barRange()
    barRange == 0 ? 0 : lowerWickRange() / barRange

// @function Calculates the ratio of the upper wick size to the real body size.
// @returns float The upper wick size divided by the real body size. Returns 0 if realBodyRange is 0.
export upperWickToBodyRatio() =>
    float realBodyRange = realBodyRange()
    realBodyRange == 0 ? 0 : upperWickRange() / realBodyRange

// @function Calculates the ratio of the lower wick size to the real body size.
// @returns float The lower wick size divided by the real body size. Returns 0 if realBodyRange is 0.
export lowerWickToBodyRatio() =>
    float realBodyRange = realBodyRange()
    realBodyRange == 0 ? 0 : lowerWickRange() / realBodyRange
    
// @function Calculates the ratio of the total wick range (Upper Wick + Lower Wick) to the total bar range.
// @returns float The total wick range expressed as a ratio of the bar's total range. Returns 0 if barRange is 0.
export totalWickRatio() =>
    float barRange = barRange()
    // Total Wick Range = Total Range - Real Body Range
    float totalWickRange = barRange - realBodyRange()
    barRange == 0 ? 0 : totalWickRange / barRange

// @function Checks if the current bar's real body range is larger than the previous bar's real body range (body expansion).
// @returns bool True if realBodyRange() > realBodyRange()[1].
export isBodyExpansion() =>
    float realBodyRange = realBodyRange()
    realBodyRange > realBodyRange[1]

// @function Checks if the current bar's real body range is smaller than the previous bar's real body range (body contraction).
// @returns bool True if realBodyRange() < realBodyRange()[1].
export isBodyContraction() =>
    float realBodyRange = realBodyRange()
    realBodyRange < realBodyRange[1]
 
// ====================================================================================
// INTER-BAR RELATIONSHIPS
// ====================================================================================

// @function Checks if the current bar's range is entirely within the previous bar's range.
// @param inclusive If true, allows equality (<=, >=). Default is false.
// @returns bool True if High < High[1] AND Low > Low[1].
export isWithinPrevBar(bool inclusive = false) =>
    inclusive ? (high <= high[1] and low >= low[1]) : (high < high[1] and low > low[1])

// @function Checks if the current bar's range fully covers the entire previous bar's range.
// @param inclusive If true, allows equality (<=, >=). Default is false.
// @returns bool True if High > High[1] AND Low < Low[1].
export isCoveringPrevBar(bool inclusive = false) =>
    inclusive ? (high >= high[1] and low <= low[1]) : (high > high[1] and low < low[1])

// @function Checks if the current bar's real body is entirely inside the previous bar's real body.
// @param inclusive If true, allows equality (<=, >=). Default is false.
// @returns bool True if the current body is contained inside the previous body.
export isWithinPrevBody(bool inclusive = false) =>
    float rbHigh = realBodyHigh()
    float rbLow = realBodyLow()
    inclusive ? (rbHigh <= rbHigh[1] and rbLow >= rbLow[1]) : (rbHigh < rbHigh[1] and rbLow > rbLow[1])

// @function Checks if the current bar's real body fully covers the previous bar's real body.
// @param inclusive If true, allows equality (<=, >=). Default is false.
// @returns bool True if the current body fully covers the previous body.
export isCoveringPrevBody(bool inclusive = false) =>
    float rbHigh = realBodyHigh()
    float rbLow = realBodyLow()
    inclusive ? (rbHigh >= rbHigh[1] and rbLow <= rbLow[1]) : (rbHigh > rbHigh[1] and rbLow < rbLow[1])

// @function Checks if the current bar's open price falls within the real body range of the previous bar.
// @param inclusive If true, includes the boundary prices. Default is false.
// @returns bool True if the open price is between the previous bar's real body high and real body low.
export isOpenWithinPrevBody(bool inclusive = false) => 
    float prbHigh = realBodyHigh()[1]
    float prbLow = realBodyLow()[1]
    inclusive ? (open <= prbHigh and open >= prbLow) : (open < prbHigh and open > prbLow)

// @function Checks if the current bar's close price falls within the real body range of the previous bar.
// @param inclusive If true, includes the boundary prices. Default is false.
// @returns bool True if the close price is between the previous bar's real body high and real body low.
export isCloseWithinPrevBody(bool inclusive = false) => 
    float prbHigh = realBodyHigh()[1]
    float prbLow = realBodyLow()[1]
    inclusive ? (close <= prbHigh and close >= prbLow) : (close < prbHigh and close > prbLow)

// @function Checks if the previous bar's open price falls within the current bar's real body range.
// @param inclusive If true, includes the boundary prices. Default is false.
// @returns bool True if open[1] is between the current bar's real body high and real body low.
export isPrevOpenWithinBody(bool inclusive = false) => 
    float rbHigh = realBodyHigh()
    float rbLow = realBodyLow()
    inclusive ? (open[1] <= rbHigh and open[1] >= rbLow) : (open[1] < rbHigh and open[1] > rbLow)

// @function Checks if the previous bar's closing price falls within the current bar's real body range.
// @param inclusive If true, includes the boundary prices. Default is false.
// @returns bool True if close[1] is between the current bar's real body high and real body low.
export isPrevCloseWithinBody(bool inclusive = false) => 
    float rbHigh = realBodyHigh()
    float rbLow = realBodyLow()
    inclusive ? (close[1] <= rbHigh and close[1] >= rbLow) : (close[1] < rbHigh and close[1] > rbLow)

// @function Checks if there is any price overlap between the current bar's range and the previous bar's range.
// @returns bool True if the current bar's range has any intersection with the previous bar's range.
export isOverlappingPrevBar() =>
    not (low > high[1] or high < low[1])

// @function Calculates the percentage of the current real body that overlaps with the previous real body.
// @returns float The overlap ratio (0.0 to 1.0). 1.0 means the current body is entirely within the previous body's price range.
export bodyOverlapRatio() =>
    float realBodyHigh = realBodyHigh()
    float realBodyLow = realBodyLow()
    float intersectionMax = math.min(realBodyHigh, realBodyHigh[1])
    float intersectionMin = math.max(realBodyLow, realBodyLow[1])
    float intersectionRange = math.max(0.0, intersectionMax - intersectionMin)
    float currentBodyRange = realBodyHigh - realBodyLow
    currentBodyRange == 0 ? 0.0 : intersectionRange / currentBodyRange

// ====================================================================================
// INTER-BAR GAPS
// ====================================================================================

// @function Checks for a complete price gap up where the current bar's low is strictly above the previous bar's high, meaning there is zero price overlap between the two bars.
// @returns bool True if the current low is greater than the previous high.
export isCompletePriceGapUp() =>
    // Current bar's entire range is completely above the previous bar's entire range.
    low > high[1]

// @function Checks for a complete price gap down where the current bar's high is strictly below the previous bar's low, meaning there is zero price overlap between the two bars.
// @returns bool True if the current high is less than the previous low.
export isCompletePriceGapDown() =>
    // Current bar's entire range is completely below the previous bar's entire range.
    high < low[1]

// @function Checks for a gap between the current and previous real bodies.
// @returns bool True if the current body is completely above the previous body.
export isRealBodyGapUp() =>
    realBodyLow() > realBodyHigh()[1]

// @function Checks for a gap between the current and previous real bodies.
// @returns bool True if the current body is completely below the previous body.
export isRealBodyGapDown() =>
    realBodyHigh() < realBodyLow()[1]

// @function Calculates the percentage difference between the current open and the previous close, expressed as a decimal ratio.
// @returns float The gap ratio (positive for gap up, negative for gap down). Returns 0 if the previous close is 0.
export gapRatio() =>
    float prevClose = close[1]
    prevClose == 0 ? 0 : (open - prevClose) / prevClose

// @function Calculates the percentage difference between the current open and the previous close.
// @returns float The gap percentage (positive for gap up, negative for gap down). Returns 0 if previous close is 0.
export gapPercentage() =>
    gapRatio() * 100

// @function Checks for a basic gap up, where the current bar's open is strictly higher than the previous bar's close. This is the minimum condition for a gap up.
// @returns bool True if the current open is greater than the previous close (i.e., gapRatio is positive).
export isGapUp() =>
    gapRatio() > 0

// @function Checks for a basic gap down, where the current bar's open is strictly lower than the previous bar's close. This is the minimum condition for a gap down.
// @returns bool True if the current open is less than the previous close (i.e., gapRatio is negative).
export isGapDown() =>
    gapRatio() < 0

// @function Checks if the current bar opened significantly higher than the previous close, as defined by a minimum percentage ratio.
// @param minRatio The minimum required gap percentage ratio. Default is 0.03 (3%).
// @returns bool True if the gap ratio (open vs. previous close) is greater than or equal to the minimum ratio.
export isSignificantGapUp(float minRatio = 0.03) =>
    gapRatio() >= minRatio

// @function Checks if the current bar opened significantly lower than the previous close, as defined by a minimum percentage ratio.
// @param minRatio The minimum required gap percentage ratio. Default is 0.03 (3%).
// @returns bool True if the absolute value of the gap ratio (open vs. previous close) is greater than or equal to the minimum ratio.
export isSignificantGapDown(float minRatio = 0.03) =>
    gapRatio() <= -minRatio

// @function Calculates the absolute distance from the current bar's High to the previous bar's Close, representing one of the components of the True Range.
// @returns float The absolute difference: |High - Close[1]|.
export trueRangeComponentHigh() =>
    math.abs(high - close[1])

// @function Calculates the absolute distance from the current bar's Low to the previous bar's Close, representing one of the components of the True Range.
// @returns float The absolute difference: |Low - Close[1]|.
export trueRangeComponentLow() =>
    math.abs(low - close[1])

// ====================================================================================
// WICK AND BODY PROPERTY HELPERS
// ====================================================================================

// @function Checks if the upper wick is significantly long relative to the total range.
// @param minRatio Minimum ratio of the wick to the total bar range. Default is 0.7 (70%).
// @returns bool True if the upper wick dominates the bar's range.
export isUpperWickDominant(float minRatio = 0.7) =>
    upperWickRatio() >= minRatio

// @function Checks if the upper wick is very small relative to the total range.
// @param maxRatio Maximum ratio of the wick to the total bar range. Default is 0.05 (5%).
// @returns bool True if the upper wick is negligible.
export isUpperWickNegligible(float maxRatio = 0.05) =>
    upperWickRatio() <= maxRatio

// @function Checks if the lower wick is significantly long relative to the total range.
// @param minRatio Minimum ratio of the wick to the total bar range. Default is 0.7 (70%).
// @returns bool True if the lower wick dominates the bar's range.
export isLowerWickDominant(float minRatio = 0.7) =>
    lowerWickRatio() >= minRatio

// @function Checks if the lower wick is very small relative to the total range.
// @param maxRatio Maximum ratio of the wick to the total bar range. Default is 0.05 (5%).
// @returns bool True if the lower wick is negligible.
export isLowerWickNegligible(float maxRatio = 0.05) =>
    lowerWickRatio() <= maxRatio

// @function Checks if the upper and lower wicks are roughly equal in length.
// @param maxTolerance Maximum allowable percentage difference between the two wicks. Default is 0.15 (15%).
// @returns bool True if wicks are symmetric within the tolerance level.
export isSymmetric(float maxTolerance = 0.15) =>
    // Calculates the absolute difference between wicks normalized by the total range.
    float barRange = barRange()
    // Returns true for zero-range bar or if the normalized difference is within tolerance.
    (barRange == 0.0) or ((math.abs(upperWickRange() - lowerWickRange()) / barRange) <= maxTolerance)

// @function Candle with a very large body relative to the total range (minimal wicks).
// @param minRatio Minimum body size ratio. Default is 0.9 (90%).
// @returns bool True if the bar has minimal wicks (Marubozu body).
export isMarubozuBody(float minRatio = 0.9) => 
    realBodyRatio() >= minRatio

// @function Candle with a large body relative to the total range.
// @param minRatio Minimum body size ratio. Default is 0.6 (60%).
// @returns bool True if the bar has a large body.
export isLargeBody(float minRatio = 0.6) => 
    realBodyRatio() >= minRatio

// @function Candle with a small body relative to the total range.
// @param maxRatio Maximum body size ratio. Default is 0.4 (40%).
// @returns bool True if the bar has small body.
export isSmallBody(float maxRatio = 0.4) => 
    realBodyRatio() <= maxRatio

// @function Candle with a very small body relative to the total range (indecision).
// @param maxRatio Maximum body size ratio. Default is 0.1 (10%).
// @returns bool True if the bar has a very small body.
export isDojiBody(float maxRatio = 0.1) => 
    // Body ratio must be less than the max, and range must be non-zero.
    realBodyRatio() <= maxRatio and barRange() > 0.0

// @function Checks if the lower wick is significantly extended relative to the real body size.
// @param minRatio Minimum required ratio of the lower wick length to the real body size. Default is 2.0 (Lower wick must be at least twice the body's size).
// @returns bool True if the lower wick's length is at least `minRatio` times the size of the real body.
export isLowerWickExtended(float minRatio = 2.0) => 
    lowerWickToBodyRatio() >= minRatio

// @function Checks if the upper wick is significantly extended relative to the real body size.
// @param minRatio Minimum required ratio of the upper wick length to the real body size. Default is 2.0 (Upper wick must be at least twice the body's size).
// @returns bool True if the upper wick's length is at least `minRatio` times the size of the real body.
export isUpperWickExtended(float minRatio = 2.0) => 
    upperWickToBodyRatio() >= minRatio

// ====================================================================================
// MOMENTUM & FORCE HELPERS (BASED ON PRICE LOCATION)
// ====================================================================================

// @function Checks for a bar with strong bullish momentum (open near low, close near high), indicating high conviction.
// @param minCloseRatio Minimum required ratio for the close location (relative to range, e.g., 0.7 means close must be in the top 30%). Default is 0.7 (70%).
// @param maxOpenRatio Maximum allowed ratio for the open location (relative to range, e.g., 0.3 means open must be in the bottom 30%). Default is 0.3 (30%).
// @returns bool True if the bar is bullish, opened in the low extreme, and closed in the high extreme.
export isStrongBuyingBar(float minCloseRatio = 0.7, float maxOpenRatio = 0.3) =>
    bool isStrongUpperClose = closeRatio() >= minCloseRatio
    bool isStrongBottomOpen = openRatio() <= maxOpenRatio
    isBuyingBar() and isStrongUpperClose and isStrongBottomOpen

// @function Checks for a bar with strong bearish momentum (open near high, close near low), indicating high conviction.
// @param maxCloseRatio Maximum allowed ratio for the close location (relative to range, e.g., 0.3 means close must be in the bottom 30%). Default is 0.3 (30%).
// @param minOpenRatio Minimum required ratio for the open location (relative to range, e.g., 0.7 means open must be in the top 30%). Default is 0.7 (70%).
// @returns bool True if the bar is bearish, opened in the high extreme, and closed in the low extreme.
export isStrongSellingBar(float maxCloseRatio = 0.3, float minOpenRatio = 0.7) =>
    bool isStrongBottomClose = closeRatio() <= maxCloseRatio
    bool isStrongUpperOpen = openRatio() >= minOpenRatio
    isSellingBar() and isStrongBottomClose and isStrongUpperOpen

// @function Identifies a bar that is technically bullish but shows significant weakness, characterized by a failure to close near the high and a small body size.
// @param maxCloseRatio Maximum allowed ratio for the close location relative to the range (e.g., 0.6 means the close must be in the bottom 60% of the bar's range). Default is 0.6 (60%).
// @param maxBodyRatio Maximum allowed ratio for the real body size relative to the bar's range (e.g., 0.4 means the body is small). Default is 0.4 (40%).
// @returns bool True if the bar is bullish, but its close is weak and its body is small.
export isWeakBuyingBar(float maxCloseRatio = 0.6, float maxBodyRatio = 0.4) =>
    bool isWeakClose = closeRatio() <= maxCloseRatio 
    bool isSmallBody = isSmallBody(maxRatio = maxBodyRatio)
    isBuyingBar() and isWeakClose and isSmallBody

// @function Identifies a bar that is technically bearish but shows significant weakness, characterized by a failure to close near the low and a small body size.
// @param minCloseRatio Minimum required ratio for the close location relative to the range (e.g., 0.4 means the close must be in the top 60% of the bar's range). Default is 0.4 (40%).
// @param maxBodyRatio Maximum allowed ratio for the real body size relative to the bar's range (e.g., 0.4 means the body is small). Default is 0.4 (40%).
// @returns bool True if the bar is bearish, but its close is weak and its body is small.
export isWeakSellingBar(float minCloseRatio = 0.4, float maxBodyRatio = 0.4) =>
    bool isWeakClose = closeRatio() >= minCloseRatio 
    bool isSmallBody = isSmallBody(maxRatio = maxBodyRatio)
    isSellingBar() and isWeakClose and isSmallBody

// ====================================================================================
// QUANTITATIVE MOMENTUM MEASURES (VOLUME & PRICE BASED)
// ====================================================================================

// @function Measures the net pressure of buyers vs. sellers within the bar, normalized to the bar's range.
// @returns float A value between -1.0 (strong selling) and +1.0 (strong buying), representing the strength and direction of the close relative to the open.
export balanceOfPower() =>
    float barRange = barRange()
    // Returns 0 if the bar has zero range
    barRange == 0 ? 0 : (close - open) / barRange

// @function Measures the net buying volume pressure based on the close location and volume.
// @returns float A numerical value representing the volume weighted buying pressure.
export buyingPressure() => 
    float barRange = barRange()
    // Pressure is calculated as Volume * (distance from low to close / total range)
    barRange == 0 ? 0 : volume * (close - low) / barRange

// @function Measures the net selling volume pressure based on the close location and volume.
// @returns float A numerical value representing the volume weighted selling pressure.
export sellingPressure() =>
    float barRange = barRange()
    // Pressure is calculated as Volume * (distance from high to close / total range)
    barRange == 0 ? 0 : volume * (high - close) / barRange

// @function Calculates the Money Flow Multiplier (MFM), which is the price component of Money Flow and CMF. 
// @returns float A normalized value from -1.0 (strong selling) to +1.0 (strong buying), representing the net directional pressure.
export moneyFlowMultiplier() => 
    // Calculate the distance of the close from the midpoint of the bar's range:
    float netDirection = (close - low) - (high - close)
    float barRange = barRange()
    // Normalizes net direction by range. Returns 0 for zero-range bars (as corrected previously).
    barRange == 0 ? 0 : netDirection / barRange

// @function Calculates the Money Flow Volume (MFV), which is the Money Flow Multiplier weighted by the bar's volume.
// @returns float A numerical value representing the volume-weighted money flow. Positive = buying dominance; negative = selling dominance.
export moneyFlowVolume() => 
    moneyFlowMultiplier() * volume

// @function Checks for basic accumulation on the current bar, requiring both positive Money Flow Volume and a buying bar (closing higher than opening).
// @returns bool True if the bar exhibits buying dominance through its internal range location and is a buying bar.
export isAccumulationBar() =>
    moneyFlowVolume() > 0 and isBuyingBar()

// @function Checks for basic distribution on the current bar, requiring both negative Money Flow Volume and a selling bar (closing lower than opening).
// @returns bool True if the bar exhibits selling dominance through its internal range location and is a selling bar.
export isDistributionBar() =>
    moneyFlowVolume() < 0 and isSellingBar()