//@version=5
library("APExitManager", overlay = true)

// ──────────────────────────────────────────────
// Exported Function - All parameters are now used
// ──────────────────────────────────────────────
export apExitManager(string entryID, bool isLong, float rangeSize, float rangeHigh, float rangeLow, 
                     string slMethod, string tpMethod, 
                     float slPercent, float tpPercent, 
                     float atrMultSL, float atrMultTP,
                     int stackedCount = 5, float stackedTotalPercent = 2.0,
                     bool usePartial = false, float partialPct = 50.0,
                     int atrLength = 14, int superLength = 7, float superFactor = 8.0) =>

    string posID = entryID + (isLong ? "_Long" : "_Short")

    // Entry
    if isLong
        strategy.entry(posID, strategy.long, comment = entryID)
    else
        strategy.entry(posID, strategy.short, comment = entryID)

    // === STOP LOSS ===
    float rangeSL = isLong ? rangeHigh - slPercent * rangeSize : rangeLow + slPercent * rangeSize

    float atrVal = ta.atr(atrLength)
    float atrSL  = isLong ? close - atrVal * atrMultSL : close + atrVal * atrMultSL

    [st, stDir] = ta.supertrend(superFactor, superLength)
    float stSL   = isLong ? (stDir == -1 ? st : rangeSL) : (stDir == 1 ? st : rangeSL)

    float activeSL = switch slMethod
        "Range"      => rangeSL
        "ATR"        => atrSL
        "Supertrend" => stSL
        => rangeSL

    strategy.exit(posID + "_SL", from_entry = posID, stop = activeSL)

    // === TAKE PROFIT ===
    float baseTP = isLong ? rangeHigh + tpPercent * rangeSize : rangeLow - tpPercent * rangeSize

    // Use atrMultTP to scale TP when using Range method
    if tpMethod == "Range"
        baseTP := isLong ? rangeHigh + (tpPercent * rangeSize * atrMultTP) : rangeLow - (tpPercent * rangeSize * atrMultTP)

    switch tpMethod
        "Range" =>
            strategy.exit(posID + "_TP", from_entry = posID, limit = baseTP, stop = activeSL)

        "Partial" =>
            // usePartial is now utilized here
            if usePartial
                strategy.exit(posID + "_Partial", from_entry = posID, qty_percent = partialPct, limit = baseTP, stop = activeSL)
                strategy.exit(posID + "_Remainder", from_entry = posID, limit = baseTP * 1.5, stop = activeSL)
            else
                strategy.exit(posID + "_TP", from_entry = posID, limit = baseTP, stop = activeSL)

        "Stacked" =>
            float step = (baseTP - strategy.position_avg_price) / stackedCount * stackedTotalPercent
            for i = 1 to stackedCount
                float level = isLong ? strategy.position_avg_price + i * step : strategy.position_avg_price - i * step
                float qtyP  = i == stackedCount ? 100 : 100.0 / stackedCount
                strategy.exit(posID + "_TP" + str.tostring(i), from_entry = posID, qty_percent = qtyP, limit = level, stop = activeSL)

    // Return active SL and TP for plotting in main strategy
    [activeSL, baseTP]