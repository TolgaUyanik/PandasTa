//@version=6
indicator(" HOLY QEQE MOD ", overlay=false, max_lines_count=1)

// ============================================================
// 輸入參數
// ============================================================
group_primary = "Primary QQE Settings"
rsiLengthPrimary = input.int(6, "RSI Length", group=group_primary, minval=1)
rsiSmoothingPrimary = input.int(5, "RSI Smoothing", group=group_primary, minval=1)
qqeFactorPrimary = input.float(3.0, "QQE Factor", group=group_primary, minval=0.001)
thresholdPrimary = input.float(3.0, "Threshold", group=group_primary, minval=0)
sourcePrimary = input.source(close, "RSI Source", group=group_primary) 

group_secondary = "Secondary QQE Settings"
rsiLengthSecondary = input.int(6, "RSI Length", group=group_secondary, minval=1)
rsiSmoothingSecondary = input.int(5, "RSI Smoothing", group=group_secondary, minval=1)
qqeFactorSecondary = input.float(1.61, "QQE Factor", group=group_secondary, minval=0.001)
thresholdSecondary = input.float(3.0, "Threshold", group=group_secondary, minval=0)
sourceSecondary = input.source(close, "RSI Source", group=group_secondary)

group_bollinger = "Bollinger Bands Settings"
bollingerLength = input.int(50, "Length", group=group_bollinger, minval=1)
bollingerMultiplier = input.float(0.35, "Multiplier", group=group_bollinger, step=0.1, minval=0.001, maxval=5)

group_display = "Display Settings"
showPrimaryLine = input.bool(false, "顯示 Primary QQE 線", group=group_display)
showBollingerFill = input.bool(true, "顯示 Bollinger 通道區域", group=group_display)
showZeroLine = input.bool(true, "顯示零軸線", group=group_display)
colorUp = input.color(#00c3ff, "上升訊號顏色", group=group_display)
colorDown = input.color(#ff0062, "下降訊號顏色", group=group_display)
colorNeutral = input.color(color.new(#707070, 20), "中性顏色", group=group_display)

// ============================================================
// QQE 核心計算函式
// ============================================================
calculateQQE(rsiLength, smoothingFactor, qqeFactor, source) =>
    wildersLength = rsiLength * 2 - 1
    rsi = ta.rsi(source, rsiLength)
    smoothedRsi = ta.ema(rsi, smoothingFactor)
    atrRsi = math.abs(smoothedRsi[1] - smoothedRsi)
    smoothedAtrRsi = ta.ema(atrRsi, wildersLength)
    dynamicAtrRsi = smoothedAtrRsi * qqeFactor

    var float longBand = 0.0
    var float shortBand = 0.0
    var int trendDirection = 0

    newShortBand = smoothedRsi + dynamicAtrRsi
    newLongBand = smoothedRsi - dynamicAtrRsi

    longBand := smoothedRsi[1] > longBand[1] and smoothedRsi > longBand[1] ? math.max(longBand[1], newLongBand) : newLongBand
    shortBand := smoothedRsi[1] < shortBand[1] and smoothedRsi < shortBand[1] ? math.min(shortBand[1], newShortBand) : newShortBand

    longBandCross = ta.cross(longBand[1], smoothedRsi)

    if ta.cross(smoothedRsi, shortBand[1])
        trendDirection := 1
    else if longBandCross
        trendDirection := -1

    qqeTrendLine = trendDirection == 1 ? longBand : shortBand
    [qqeTrendLine, smoothedRsi, trendDirection]

// ============================================================
// 主計算
// ============================================================
[primaryQQETrendLine, primaryRSI, primaryTrend] = calculateQQE(rsiLengthPrimary, rsiSmoothingPrimary, qqeFactorPrimary, sourcePrimary)
[secondaryQQETrendLine, secondaryRSI, secondaryTrend] = calculateQQE(rsiLengthSecondary, rsiSmoothingSecondary, qqeFactorSecondary, sourceSecondary)

// Bollinger Bands
bollingerBasis = ta.sma(primaryQQETrendLine - 50, bollingerLength)
bollingerDeviation = bollingerMultiplier * ta.stdev(primaryQQETrendLine - 50, bollingerLength)
bollingerUpper = bollingerBasis + bollingerDeviation
bollingerLower = bollingerBasis - bollingerDeviation

// ============================================================
// 訊號條件
// ============================================================
primaryBreakUp = (primaryRSI - 50) > bollingerUpper and (primaryRSI - 50) > thresholdPrimary
primaryBreakDown = (primaryRSI - 50) < bollingerLower and (primaryRSI - 50) < -thresholdPrimary

upSignal = secondaryRSI - 50 > thresholdSecondary and primaryBreakUp
downSignal = secondaryRSI - 50 < -thresholdSecondary and primaryBreakDown

// ============================================================
// 顏色
// ============================================================
rsiColorPrimary = primaryBreakUp ? color.new(colorUp, 0) : primaryBreakDown ? color.new(colorDown, 0) : colorNeutral
rsiColorSecondary = upSignal ? colorUp : downSignal ? colorDown : colorNeutral
trendLineColor = secondaryTrend == 1 ? color.new(colorUp, 30) : color.new(colorDown, 30)

// ============================================================
// 繪圖
// ============================================================
plot(showZeroLine ? 0 : na, "Zero Line", color=color.gray)

bbUpperPlot = plot(showBollingerFill ? bollingerUpper : na, "BB Upper", color=color.new(color.gray, 70))
bbLowerPlot = plot(showBollingerFill ? bollingerLower : na, "BB Lower", color=color.new(color.gray, 70))
fill(bbUpperPlot, bbLowerPlot, color=color.new(color.gray, 90), title="Bollinger 通道區域")

plot(secondaryQQETrendLine - 50, "Secondary QQE Trend Line", color=trendLineColor, linewidth=2)
plot(secondaryRSI - 50, "Secondary RSI Histogram", style=plot.style_columns, color=rsiColorSecondary)

plot(showPrimaryLine ? primaryQQETrendLine - 50 : na, "Primary QQE Trend Line", color=color.new(color.white, 40), linewidth=1)
plot(showPrimaryLine ? primaryRSI - 50 : na, "Primary RSI", color=rsiColorPrimary, linewidth=1)

plot(upSignal ? secondaryRSI - 50 : na, "QQE Up Signal", style=plot.style_columns, color=colorUp)
plot(downSignal ? secondaryRSI - 50 : na, "QQE Down Signal", style=plot.style_columns, color=colorDown)
// === 主圖 BUY / SELL 標示 ===
plotshape(
     upSignal and not upSignal[1] ? secondaryRSI - 80 : na,
     title="QQE L",
     text="L",
     style=shape.labelup,
     location=location.absolute,
     color=color.rgb(0, 109, 212),
     textcolor=color.white,
     size=size.tiny)

plotshape(
     downSignal and not downSignal[1] ? secondaryRSI - 20 : na,
     title="QQE S",
     text="S",
     style=shape.labeldown,
     location=location.absolute,
     color=color.red,
     textcolor=color.white,
     size=size.tiny)
// ============================================================
// Alerts
// ============================================================
alertcondition(ta.crossover(primaryRSI, 50), "Primary RSI 上穿 50", "Primary RSI crossed above 50")
alertcondition(ta.crossunder(primaryRSI, 50), "Primary RSI 下穿 50", "Primary RSI crossed below 50")
alertcondition(ta.crossover(primaryRSI, 50), "Primary RSI 上穿 50", "Primary RSI crossed above 50")
alertcondition(ta.crossunder(primaryRSI, 50), "Primary RSI 下穿 50", "Primary RSI crossed below 50")

alertcondition(
    upSignal and not upSignal[1],
    "QQE 做多",
    "🟢 JAY QQE PRO\n\n幣種：{{ticker}}\n時間：{{interval}}\n\n訊號：做多\n價格：{{close}}"
)

alertcondition(
    downSignal and not downSignal[1],
    "QQE 做空",
    "🔴 JAY QQE PRO\n\n幣種：{{ticker}}\n時間：{{interval}}\n\n訊號：做空\n價格：{{close}}"
)
