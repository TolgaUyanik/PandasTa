// @version=6

// @description Fluent data holder object with retrieval and modification functions
library('ToolsFluent', overlay = false)

// @type Fluent - General purpose data holder object 
// @field msi map<string, int> String key, integer value data holder map. Default: na
// @field msf map<string, float> String key, float value data holder map. Default: na
// @field msb map<string, bool> String key, boolean value data holder map. Default: na
// @field mss map<string, string> String key, string value data holder map. Default: na
// @field msc map<string, color> String key, color value data holder map. Default: na
// @field aii array<int> Integer key, integer value data holder array. Default: na
// @field aif array<float> Integer key, float value data holder array. Default: na
// @field aib array<bool> Integer key, boolean value data holder array. Default: na
// @field ais array<string> Integer key, string value data holder array. Default: na
// @field aic array<color> Integer key, color value data holder array. Default: na
// @field aibx array<box> Integer key, box value data holder array. Default: na
// @field ail array<line> Integer key, line value data holder array. Default: na
// @field ailb array<label> Integer key, label value data holder array. Default: na
// @field ait array<table> Integer key, table value data holder array. Default: na
// @field ailf array<linefill> Integer key, linefill value data holder array. Default: na
export type Fluent
	map<string, int> msi = na
	map<string, float> msf = na
    map<string, bool> msb = na
    map<string, string> mss = na
    map<string, color> msc = na
    array<int> aii = na
    array<float> aif = na
    array<bool> aib = na
    array<string> ais = na
    array<color> aic = na
    array<box> aibx = na
    array<line> ail = na
    array<label> ailb = na
    array<table> ait = na
    array<linefill> ailf = na

// @function Initalise Fluent object
// @param msi map<string, int> String key, integer value data holder map. Default: na
// @param msf map<string, float> String key, float value data holder map. Default: na
// @param msb map<string, bool> String key, boolean value data holder map. Default: na
// @param mss map<string, string> String key, string value data holder map. Default: na
// @param msc map<string, color> String key, color value data holder map. Default: na
// @param aii array<int> Integer key, integer value data holder array. Default: na
// @param aif array<float> Integer key, float value data holder array. Default: na
// @param aib array<bool> Integer key, boolean value data holder array. Default: na
// @param ais array<string> Integer key, string value data holder array. Default: na
// @param aic array<color> Integer key, color value data holder array. Default: na
// @param aibx array<box> Integer key, box value data holder array. Default: na
// @param ail array<line> Integer key, line value data holder array. Default: na
// @param ailb array<label> Integer key, label value data holder array. Default: na
// @param ait array<table> Integer key, table value data holder array. Default: na
// @param ailf array<linefill> Integer key, linefill value data holder array. Default: na
export method init(Fluent this, map<string, int> msi = na, map<string, float> msf = na, map<string, bool> msb = na, map<string, string> mss = na, map<string, color> msc = na, array<int> aii = na, array<float> aif = na, array<bool> aib = na, array<string> ais = na, array<color> aic = na, array<box> aibx = na, array<line> ail = na, array<label> ailb = na, array<table> ait = na, array<linefill> ailf = na) =>
    this.msi := not na(msi) ? msi : (not na(this.msi) ? this.msi : map.new<string, int>())
    this.msf := not na(msf) ? msf : (not na(this.msf) ? this.msf : map.new<string, float>())
    this.msb := not na(msb) ? msb : (not na(this.msb) ? this.msb : map.new<string, bool>())
    this.mss := not na(mss) ? mss : (not na(this.mss) ? this.mss : map.new<string, string>())
    this.msc := not na(msc) ? msc : (not na(this.msc) ? this.msc : map.new<string, color>())
    this.aii := not na(aii) ? aii : (not na(this.aii) ? this.aii : array.new<int>())
    this.aif := not na(aif) ? aif : (not na(this.aif) ? this.aif : array.new<float>())
    this.aib := not na(aib) ? aib : (not na(this.aib) ? this.aib : array.new<bool>())
    this.ais := not na(ais) ? ais : (not na(this.ais) ? this.ais : array.new<string>())
    this.aic := not na(aic) ? aic : (not na(this.aic) ? this.aic : array.new<color>())
    this.aibx := not na(aibx) ? aibx : (not na(this.aibx) ? this.aibx : array.new<box>())
    this.ail := not na(ail) ? ail : (not na(this.ail) ? this.ail : array.new<line>())
    this.ailb := not na(ailb) ? ailb : (not na(this.ailb) ? this.ailb : array.new<label>())
    this.ait := not na(ait) ? ait : (not na(this.ait) ? this.ait : array.new<table>())
    this.ailf := not na(ailf) ? ailf : (not na(this.ailf) ? this.ailf : array.new<linefill>())

// Get
// @function Returns Fluent object key's value or default value when key not found
// @param fluent Fluent object
// @param string|int key Key/Index to be set
// @param default int|float|bool|string|color|box|line|labrl|table|linefill Default value to be returned when key not exists
// @returns int|float|bool|string|color|box|line|labrl|table|linefill
export method get(Fluent this, string key, int default) =>
    if not na(this.msi) and this.msi.contains(key)
        this.msi.get(key)
    else
        default
export method get(Fluent this, string key, float default) =>
    if not na(this.msf) and this.msf.contains(key)
        this.msf.get(key)
    else
        default
export method get(Fluent this, string key, bool default) =>
    if not na(this.msb) and this.msb.contains(key)
        this.msb.get(key)
    else
        default
export method get(Fluent this, string key, string default) =>
    if not na(this.mss) and this.mss.contains(key)
        this.mss.get(key)
    else
        default
export method get(Fluent this, string key, color default) =>
    if not na(this.msc) and this.msc.contains(key)
        this.msc.get(key)
    else
        default
export method get(Fluent this, int key, int default) =>
    if not na(this.aii) and key <= array.size(this.aii) - 1
        this.aii.get(key)
    else
        default
export method get(Fluent this, int key, float default) =>
    if not na(this.aif) and key <= array.size(this.aif) - 1 
        this.aif.get(key)
    else
        default
export method get(Fluent this, int key, bool default) =>
    if not na(this.aib) and key <= array.size(this.aib) - 1
        this.aib.get(key)
    else
        default
export method get(Fluent this, int key, string default) =>
    if not na(this.ais) and key <= array.size(this.ais) - 1
        this.ais.get(key)
    else
        default
export method get(Fluent this, int key, color default) =>
    if not na(this.aic) and key <= array.size(this.aic) - 1
        this.aic.get(key)
    else
        default
export method get(Fluent this, int key, box default) =>
    if not na(this.aibx) and key <= array.size(this.aibx) - 1
        this.aibx.get(key)
    else
        default
export method get(Fluent this, int key, line default) =>
    if not na(this.ail) and key <= array.size(this.ail) - 1
        this.ail.get(key)
    else
        default
export method get(Fluent this, int key, label default) =>
    if not na(this.ailb) and key <= array.size(this.ailb) - 1
        this.ailb.get(key)
    else
        default
export method get(Fluent this, int key, table default) =>
    if not na(this.ait) and key <= array.size(this.ait) - 1
        this.ait.get(key)
    else
        default
export method get(Fluent this, int key, linefill default) =>
    if not na(this.ailf) and key <= array.size(this.ailf) - 1
        this.ailf.get(key)
    else
        default

// Set
// @function Sets Fluent object key's value
// @param fluent Fluent Fluent object
// @param key string|int Key/Index to be set
// @param value int|float|bool|string|color|box|line|labrl|table|linefill Value to be set
export method set(Fluent this, string key, int value) =>
    if na(this.msi)
        this.msi := map.new<string, int>()
    this.msi.put(key, value)
export method set(Fluent this, string key, float value) =>
    if na(this.msf)
        this.msf := map.new<string, float>()
    this.msf.put(key, value)
export method set(Fluent this, string key, bool value) =>
    if na(this.msb)
        this.msb := map.new<string, bool>()
    this.msb.put(key, value)
export method set(Fluent this, string key, string value) =>
    if na(this.mss)
        this.mss := map.new<string, string>()
    this.mss.put(key, value)
export method set(Fluent this, string key, color value) =>
    if na(this.msc)
        this.msc := map.new<string, color>()
    this.msc.put(key, value)
export method set(Fluent this, int key, int value) =>
    if na(this.aii)
        this.aii := array.new<int>()
    this.aii.set(key, value)
export method set(Fluent this, int key, float value) =>
    if na(this.aif)
        this.aif := array.new<float>()
    this.aif.set(key, value)
export method set(Fluent this, int key, bool value) =>
    if na(this.aib)
        this.aib := array.new<bool>()
    this.aib.set(key, value)
export method set(Fluent this, int key, string value) =>
    if na(this.ais)
        this.ais := array.new<string>()
    this.ais.set(key, value)
export method set(Fluent this, int key, color value) =>
    if na(this.aic)
        this.aic := array.new<color>()
    this.aic.set(key, value)
export method set(Fluent this, int key, box value) =>
    if na(this.aibx)
        this.aibx := array.new<box>()
    this.aibx.set(key, value)
export method set(Fluent this, int key, line value) =>
    if na(this.ail)
        this.ail := array.new<line>()
    this.ail.set(key, value)
export method set(Fluent this, int key, label value) =>
    if na(this.ailb)
        this.ailb := array.new<label>()
    this.ailb.set(key, value)
export method set(Fluent this, int key, table value) =>
    if na(this.ait)
        this.ait := array.new<table>()
    this.ait.set(key, value)
export method set(Fluent this, int key, linefill value) =>
    if na(this.ailf)
        this.ailf := array.new<linefill>()
    this.ailf.set(key, value)

// @function Appends(push) value to the related array
// @param fluent Fluent Fluent object
// @param value int|float|bool|string|color|box|line|label|table|linefill Value to be pushed
export method append(Fluent this, int value) =>
    if na(this.aii)
        this.aii  := array.from(value)
    this.aii.push(value)
export method append(Fluent this, float value) =>
    if na(this.aif)
        this.aif  := array.from(value)
    this.aif.push(value)
export method append(Fluent this, bool value) =>
    if na(this.aib)
        this.aib  := array.from(value)
    this.aib.push(value)
export method append(Fluent this, string value) =>
    if na(this.ais)
        this.ais  := array.from(value)
    this.ais.push(value)
export method append(Fluent this, color value) =>
    if na(this.aic)
        this.aic  := array.from(value)
    this.aic.push(value)
export method append(Fluent this, box value) =>
    if na(this.aibx)
        this.aibx  := array.from(value)
    this.aibx.push(value)
export method append(Fluent this, line value) =>
    if na(this.ail)
        this.ail  := array.from(value)
    this.ail.push(value)
export method append(Fluent this, label value) =>
    if na(this.ailb)
        this.ailb  := array.from(value)
    this.ailb.push(value)
export method append(Fluent this, table value) =>
    if na(this.ait)
        this.ait  := array.from(value)
    this.ait.push(value)
export method append(Fluent this, linefill value) =>
    if na(this.ailf)
        this.ailf := array.from(value)
    this.ailf.push(value)

// @function Prepends(unshift) value to the related array
// @param fluent Fluent Fluent object
// @param value int|float|bool|string|color|box|line|label|table|linefill Value to be pushed
export method prepend(Fluent this, int value) =>
    if na(this.aii)
        this.aii  := array.from(value)
    this.aii.unshift(value)
export method prepend(Fluent this, float value) =>
    if na(this.aif)
        this.aif  := array.from(value)
    this.aif.unshift(value)
export method prepend(Fluent this, bool value) =>
    if na(this.aib)
        this.aib  := array.from(value)
    this.aib.unshift(value)
export method prepend(Fluent this, string value) =>
    if na(this.ais)
        this.ais  := array.from(value)
    this.ais.unshift(value)
export method prepend(Fluent this, color value) =>
    if na(this.aic)
        this.aic  := array.from(value)
    this.aic.unshift(value)
export method prepend(Fluent this, box value) =>
    if na(this.aibx)
        this.aibx  := array.from(value)
    this.aibx.unshift(value)
export method prepend(Fluent this, line value) =>
    if na(this.ail)
        this.ail  := array.from(value)
    this.ail.unshift(value)
export method prepend(Fluent this, label value) =>
    if na(this.ailb)
        this.ailb  := array.from(value)
    this.ailb.unshift(value)
export method prepend(Fluent this, table value) =>
    if na(this.ait)
        this.ait  := array.from(value)
    this.ait.unshift(value)
export method prepend(Fluent this, linefill value) =>
    if na(this.ailf)
        this.ailf  := array.from(value)    
    this.ailf.unshift(value)