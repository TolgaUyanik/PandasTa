//@version=6
strategy("Double Tap v25 (Neckline BOS + Reversal + Dynamic Stops/TP + Auto RR)", overlay=true)

//=============================
// INPUTS
//=============================
buffer      = input.float(0.25, "Level Buffer")
enableScout = input.bool(true, "Enable Early BOS Scout")

// Dynamic Risk
atrLen  = input.int(14, "ATR Length")
atrMult = input.float(1.0, "ATR Stop Mult")
rrTarget = input.float(2.0, "RR Target")
trailATR = input.float(1.0, "ATR Trail Mult")

atr = ta.atr(atrLen)

//=============================
// SESSIONS
//=============================
session1 = not na(time(timeframe.period, "0930-1100"))
session2 = not na(time(timeframe.period, "1400-1600"))
inSession = session1 or session2
inPM      = not na(time(timeframe.period, "0400-0930"))

//=============================
// PRIOR DAY (NYSE)
//=============================
var float dayHigh = na
var float dayLow  = na
inNYFull = not na(time(timeframe.period, "0930-1600"))

if inNYFull
    dayHigh := na(dayHigh) ? high : math.max(dayHigh, high)
    dayLow  := na(dayLow)  ? low  : math.min(dayLow, low)

var float pdHigh = na
var float pdLow  = na
newDay = ta.change(dayofmonth) != 0

if newDay
    pdHigh := dayHigh
    pdLow  := dayLow
    dayHigh := na
    dayLow := na

pdMid = (pdHigh + pdLow) / 2

//=============================
// PREMARKET
//=============================
var float pmHigh = na
var float pmLow  = na

if newDay
    pmHigh := na
    pmLow := na

if inPM
    pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
    pmLow  := na(pmLow) ? low : math.min(pmLow, low)

//=============================
// HOD / LOD
//=============================
var float hod = na
var float lod = na

if newDay
    hod := high
    lod := low
else
    hod := math.max(hod, high)
    lod := math.min(lod, low)

//=============================
// WICK LOGIC
//=============================
body      = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

wickLong  = lowerWick > body * 1.5 and close > open
wickShort = upperWick > body * 1.5 and close < open

//=============================
// VALID WICKS (REVERSAL)
//=============================
validWickLong =
     wickLong and (
         (not na(pdLow) and low <= pdLow + buffer and low >= pdLow - buffer) or
         (not na(pmLow) and low <= pmLow + buffer and low >= pmLow - buffer)
     )

validWickShort =
     wickShort and (
         (not na(pdHigh) and high >= pdHigh - buffer and high <= pdHigh + buffer) or
         (not na(pmHigh) and high >= pmHigh - buffer and high <= pmHigh + buffer)
     )

//=============================
// BIAS
//=============================
bullBias = not na(pdMid) and close > pdMid
bearBias = not na(pdMid) and close < pdMid

//=============================
// REVERSAL ENGINE
//=============================
sweepLow  = validWickLong and close > pdLow
sweepHigh = validWickShort and close < pdHigh

var int revTrades = 0
if newDay
    revTrades := 0

revLong  = sweepLow  and bullBias and inSession and revTrades < 3
revShort = sweepHigh and bearBias and inSession and revTrades < 3

//=============================
// BOS ENGINE (WITH NECKLINE)
//=============================
validTime = bar_index > 10

bosUp =
     validTime and (
         (not na(pmHigh) and close > pmHigh) or
         (not na(pdHigh) and close > pdHigh) or
         (close > hod[1] and bar_index > 20)
     )

bosDown =
     validTime and (
         (not na(pmLow) and close < pmLow) or
         (not na(pdLow) and close < pdLow) or
         (close < lod[1] and bar_index > 20)
     )

var float bosHigh = na
var float bosLow  = na
var bool bosActiveLong  = false
var bool bosActiveShort = false

if bosUp
    bosHigh := high
    bosActiveLong := true

if bosDown
    bosLow := low
    bosActiveShort := true

//=============================
// EARLY BOS SCOUT
//=============================
var int scoutTrades = 0
if newDay
    scoutTrades := 0

scoutLong  = enableScout and bosUp and bullBias and inSession and scoutTrades < 1
scoutShort = enableScout and bosDown and bearBias and inSession and scoutTrades < 1

pullbackLong  = bosActiveLong and low < bosHigh and wickLong
pullbackShort = bosActiveShort and high > bosLow and wickShort

//=============================
// NECKLINE LOGIC
//=============================
var float bosNecklineLong  = na
var float bosNecklineShort = na

if pullbackLong
    bosNecklineLong := high
if pullbackShort
    bosNecklineShort := low

var int bosTrades = 0
if newDay
    bosTrades := 0

//=============================
// NECKLINE VISUALS
//=============================
var line neckLineLong  = na
var line neckLineShort = na

if pullbackLong and not na(bosNecklineLong)
    line.delete(neckLineLong)
    neckLineLong := line.new(bar_index, bosNecklineLong, bar_index+10, bosNecklineLong, color=color.lime, width=2)

if pullbackShort and not na(bosNecklineShort)
    line.delete(neckLineShort)
    neckLineShort := line.new(bar_index, bosNecklineShort, bar_index+10, bosNecklineShort, color=color.red, width=2)

bosLongSignal  = not na(bosNecklineLong)  and close > bosNecklineLong  and bullBias and inSession and bosTrades < 3
bosShortSignal = not na(bosNecklineShort) and close < bosNecklineShort and bearBias and inSession and bosTrades < 3

if bosLongSignal
    bosActiveLong := false
    bosNecklineLong := na

if bosShortSignal
    bosActiveShort := false
    bosNecklineShort := na

//=============================
// EXECUTION
//=============================
if revLong
    strategy.entry("CALL_REV", strategy.long)
    revTrades += 1
if revShort
    strategy.entry("PUT_REV", strategy.short)
    revTrades += 1

if scoutLong
    strategy.entry("CALL_SCOUT", strategy.long)
    scoutTrades += 1
if scoutShort
    strategy.entry("PUT_SCOUT", strategy.short)
    scoutTrades += 1

if bosLongSignal
    strategy.entry("CALL_BOS", strategy.long)
    bosTrades += 1
if bosShortSignal
    strategy.entry("PUT_BOS", strategy.short)
    bosTrades += 1

//=============================
// DYNAMIC STOPS / TP
//=============================
longStop  = strategy.position_avg_price - (atr * atrMult)
shortStop = strategy.position_avg_price + (atr * atrMult)

longTP1  = strategy.position_avg_price + (atr * atrMult)
longTP2  = strategy.position_avg_price + (atr * atrMult * rrTarget)

shortTP1 = strategy.position_avg_price - (atr * atrMult)
shortTP2 = strategy.position_avg_price - (atr * atrMult * rrTarget)

trailLong  = close - (atr * trailATR)
trailShort = close + (atr * trailATR)

//=============================
// EXIT LOGIC
//=============================
if strategy.position_size > 0
    strategy.exit("TP1 Long", from_entry="", limit=longTP1, stop=longStop)
    strategy.exit("TP2 Long", from_entry="", limit=longTP2, trail_price=trailLong)

if strategy.position_size < 0
    strategy.exit("TP1 Short", from_entry="", limit=shortTP1, stop=shortStop)
    strategy.exit("TP2 Short", from_entry="", limit=shortTP2, trail_price=trailShort)

//=============================
// VISUAL STOP LINES
//=============================
plot(strategy.position_size > 0 ? longStop : na,  color=color.red,   style=plot.style_linebr, linewidth=2)
plot(strategy.position_size < 0 ? shortStop : na, color=color.red,   style=plot.style_linebr, linewidth=2)
plot(strategy.position_size > 0 ? longTP1 : na,   color=color.green, style=plot.style_linebr)
plot(strategy.position_size > 0 ? longTP2 : na,   color=color.green, style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortTP1 : na,  color=color.green, style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortTP2 : na,  color=color.green, style=plot.style_linebr)

//=============================
// AUTO RR DISPLAY
//=============================
var label rrLabel = na
if strategy.position_size != 0
    label.delete(rrLabel)
    rr = strategy.position_size > 0 ? (longTP2 - strategy.position_avg_price) / (strategy.position_avg_price - longStop) :
                                      (strategy.position_avg_price - shortTP2) / (shortStop - strategy.position_avg_price)
    rrLabel := label.new(bar_index, high, "RR: " + str.tostring(rr, "#.##"), style=label.style_label_down, color=color.black, textcolor=color.white)

//=============================
// TP BOXES
//=============================
var box tpBox = na
if strategy.position_size > 0
    box.delete(tpBox)
    tpBox := box.new(left=bar_index, right=bar_index+10, top=longTP2, bottom=longTP1, bgcolor=color.new(color.green, 85), border_color=color.green)

if strategy.position_size < 0
    box.delete(tpBox)
    tpBox := box.new(left=bar_index, right=bar_index+10, top=shortTP1, bottom=shortTP2, bgcolor=color.new(color.red, 85), border_color=color.red)

//=============================
// VISUAL SIGNALS
//=============================
plotshape(revLong,  location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(revShort, location=location.abovebar, color=color.red,   style=shape.triangledown, size=size.small)
plotshape(bosLongSignal,  location=location.belowbar, color=color.lime, style=shape.arrowup, size=size.normal)
plotshape(bosShortSignal, location=location.abovebar, color=color.orange, style=shape.arrowdown, size=size.normal)
plotshape(scoutLong,  location=location.belowbar, color=color.blue, style=shape.circle, size=size.small)
plotshape(scoutShort, location=location.abovebar, color=color.purple, style=shape.circle, size=size.small)

// Levels
plot(pdHigh, color=color.red)
plot(pdLow,  color=color.green)
plot(pdMid,  color=color.gray)
plot(not inPM ? pmHigh : na, color=color.orange, style=plot.style_linebr)
plot(not inPM ? pmLow  : na, color=color.orange, style=plot.style_linebr)