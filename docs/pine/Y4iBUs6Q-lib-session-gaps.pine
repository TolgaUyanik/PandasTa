//@version=5
// v29 - published as v1

// @description simple lib to calculate the gaps between sessions
library("lib_session_gaps", overlay = true)

// @function calculates the time gap between this and previous session (in case of irregular end of previous session, considering extended sessions)
// @returns the time gap between this and previous session in ms (time - time_close[1])
export time_gap() =>
	if session.isfirstbar and barstate.isnew
		time - time_close[1]
	else
		0

// @function calculates the bars missing between this and previous session (in case of irregular end of previous session, considering extended sessions)
// @returns the bars virtually missing between this and previous session (time gap / bar size in ms)
export bar_gap() => 
	time_gap() / timeframe.in_seconds() / 1000	


///////////////////////// DEMO /////////////////////////	

gap_ms = time_gap()
gap_bars = bar_gap()

var int prev_close_confirmed = na
if session.islastbar and barstate.isconfirmed
	prev_close_confirmed := time_close
if session.isfirstbar and barstate.isnew
	if prev_close_confirmed != time_close[1]
		label.new(chart.point.now(low), 'irregular', color = color.red, style = label.style_label_up)
		prev_close_confirmed := time_close[1]
	if dayofweek == dayofweek.monday and time - prev_close_confirmed > 20 * 60 * 60 * 1000
		label.new(chart.point.now(low), 'after\nweekend', color = color.yellow, style = label.style_label_up)

	if gap_ms > 0
		label.new(chart.point.now(high), str.format('gap\nhours: {0}\nbars: {1}', gap_ms / 1000 / 60 / 60, gap_bars))
