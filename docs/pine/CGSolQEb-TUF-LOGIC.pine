//@version=5

// @description 3VL Implementation (TUF stands for True, Uncertain, False.)
library("TUF_LOGIC")

// @type Three Value Logic (T.U.F.), or trilean. Can be True (1), Uncertain (0), or False (-1).
// @field v Value of the trilean variable. Can be True (1), Uncertain (0), or False (-1).
export type tri
	int v = 0

// @function Ensures that the type is never na/undefined. Useful if you are using a higher timeframe..
// @returns Converts na trilean objects to default valued objects.
export method safe(tri self)=>
	if na(self)
		tri.new()
	else
		self

// @function Ensures a valid trilean variable. This works by clamping the variable to the range associated with the trilean type.
// @returns Validated trilean object.
export method validate(series tri self)=>
	tri.new(math.min(math.max(self.v, -1), 1))

// @function Converts a trilean object into a boolean object. True -> True, Uncertain -> na, False -> False.
// @returns A boolean variable.
export method to_bool(series tri self)=>
	int trilean = self.validate().v
	bool new_bool = switch
		trilean == 1 => true
		trilean == 0 => na
		trilean == -1 => false
		=> na
	new_bool

// @function Negates the trilean object. True -> False, Uncertain -> Uncertain, False -> True
// @returns Negated trilean object.
export method NOT(series tri self)=>
	tri.new(self.validate().v * -1)

// @function Logical AND operation for trilean objects.
// @param self The first trilean object.
// @param comparator The second trilean object to compare with.
// @returns `tri` Result of the AND operation as a trilean object.
export method AND(series tri self, series tri comparator)=>
	tri.new(math.min(self.validate().v, comparator.validate().v))

// @function Logical OR operation for trilean objects.
// @param self The first trilean object.
// @param comparator The second trilean object to compare with.
// @returns `tri` Result of the OR operation as a trilean object.
export method OR(series tri self, series tri comparator)=>
	tri.new(math.max(self.validate().v, comparator.validate().v))

// @function Logical EQUALITY operation for trilean objects.
// @param self The first trilean object.
// @param comparator The second trilean object to compare with.
// @returns `tri` Result of the EQUALITY operation as a trilean object, True if both are equal, False otherwise.
export method EQUALITY(series tri self, series tri comparator)=>
	tri.new(self.validate().v == comparator.validate().v ? 1 : -1)

// @function Logical XOR (Exclusive OR) operation for trilean objects.
// @param self The first trilean object.
// @param comparator The second trilean object to compare with.
// @returns `tri` Result of the XOR operation as a trilean object.
export method XOR(series tri self, series tri comparator)=>
	self.OR(comparator).AND(self.AND(comparator).NOT())

// @function Material implication using Kleene's logic for trilean objects.
// @param self The antecedent trilean object.
// @param comparator The consequent trilean object.
// @returns `tri` Result of the implication operation as a trilean object.
export method IMP_K(series tri self, series tri comparator)=>
	self.NOT().OR(comparator)

// @function Logical implication using Łukasiewicz's logic for trilean objects.
// @param self The antecedent trilean object.
// @param comparator The consequent trilean object.
// @returns `tri` Result of the implication operation as a trilean object.
export method IMP_L(series tri self, series tri comparator)=>
	tri.new(math.min(1, 1 - self.validate().v + comparator.validate().v))

// @function Logical implication using RM3 logic for trilean objects.
// @param self The antecedent trilean object.
// @param comparator The consequent trilean object.
// @returns `tri` Result of the RM3 implication as a trilean object.
export method IMP_RM3(series tri self, series tri comparator)=>
	int valid_self = self.validate().v
	int valid_comparator = comparator.validate().v
    if valid_self == -1
		tri.new(1)
	else if valid_self == 0 and valid_comparator == 0
		tri.new(0)
	else if valid_comparator == 1
		tri.new(1)
	else
		tri.new(-1)

// @function Evaluates to True if the trilean object is either True or Uncertain, False otherwise.
// @param self The trilean object to evaluate.
// @returns `tri` Result of the operation as a trilean object.
export method MA(series tri self)=>
	tri.new(self.validate().v > -1 ? 1 : -1)

// @function Evaluates to True if the trilean object is True, False otherwise.
// @param self The trilean object to evaluate.
// @returns `tri` Result of the operation as a trilean object.
export method LA(series tri self)=>
	tri.new(self.validate().v > 0 ? 1 : -1)

// @function Evaluates to True if the trilean object is Uncertain, False otherwise.
// @param self The trilean object to evaluate.
// @returns `tri` Result of the operation as a trilean object.
export method IA(series tri self)=>
	tri.new(self.validate().v == 0 ? 1 : -1)

// @function Evaluates the unanimity between two trilean values.
// @param self The first trilean value.
// @param comparator The second trilean value.
// @returns `tri` Returns True if both values are True, False if both are False, and Uncertain otherwise.
export method UNANIMOUS(series tri self, series tri comparator)=>
	int valid_self = self.validate().v
	int valid_comparator = comparator.validate().v
	if valid_self == 1 and valid_comparator == 1
		tri.new(1)
	else if valid_self == -1 and valid_comparator == -1
		tri.new(-1)
	else
		tri.new(0)

// @function Evaluates the unanimity among an array of trilean values.
// @param self The array of trilean values.
// @returns `tri` Returns True if all values are True, False if all are False, and Uncertain otherwise.
export method UNANIMOUS(series tri[] self)=>
	if self.size() == 0
		tri.new(0)
	else
		int first_value = self.get(0).validate().v
		bool unanimous = true
		for i = 1 to self.size() - 1
			if self.get(i).validate().v != first_value
				unanimous := false
				break

		if unanimous
			tri.new(first_value)
		else
			tri.new(0)

// EXAMPLE {

float rsi = ta.rsi(close, 14)
float mfi = ta.mfi(close, 14)
[_, st] = ta.supertrend(3, 10)

tri rsi_state = tri.new(rsi > 69 ? 1 : rsi < 31 ? -1 : 0)
tri mfi_state = tri.new(mfi > 69 ? 1 : mfi < 31 ? -1 : 0)
tri st_state = tri.new(int(st)).NOT()

tri[] states = array.from(rsi_state, mfi_state, st_state)

plot(states.UNANIMOUS().v)

// }