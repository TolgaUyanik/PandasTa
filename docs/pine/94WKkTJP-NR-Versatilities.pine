//@version = 6
import TradingView/ta/9 as ta

// @description Versatilities (aka, Versatile Utilities) includes:
//  - Seventeen Price Variants returned as a tuple,
//  - Eight Smoothing functions rolled into one,
//  - Pick any Past Value from any series with offset,
//  - Or just the previous value from any series.
library('NR_Versatilities')

// @function Fetches past value from src that came len distance ago
// @param src source series
// @param len lookback distance - (optional) default is 1
// @returns latest src if len <= 0, else src[len] (rounded-to-mintick)
export pastVal(series float src, int len = 1) =>
    math.round_to_mintick(len <= 0 ? src : nz(src[len], src))

// @function Fetches past value from src that came len distance ago
// @param src source series
// @returns previous value in the series if found, else current value
export previous(series float src) =>
    pastVal(src)

// @function Computes Several different averages using current and previous OHLC values
// @returns Map of Eighteen Uncommon Combinations of single and two-bar OHLC averages (rounded-to-mintick)
export price_variants() =>
    op = math.round_to_mintick(open)
    hi = math.round_to_mintick(high)
    lo = math.round_to_mintick(low)
    cl = math.round_to_mintick(close)
    avrng = math.round_to_mintick(hl2)
    pivot = math.round_to_mintick(hlc3)
    pvtcl = math.round_to_mintick(hlcc4)
    avbar = math.round_to_mintick(ohlc4)
    prcMA = math.round_to_mintick(math.avg(math.avg(avrng, pivot, pvtcl, avbar), (2 * op + 3 * (hi + lo) + 5 * cl) / 13))
    oc2 = math.round_to_mintick(math.avg(op, cl))
    pcoc2 = math.round_to_mintick(math.avg(nz(cl[1]), oc2))
    pooc2 = math.round_to_mintick(math.avg(nz(op[1]), oc2))
    popc2 = math.round_to_mintick(math.avg(nz(op[1]), nz(cl[1])))
    poc3 = math.round_to_mintick(math.avg(math.avg(popc2, oc2), pcoc2, pooc2))
    pivot2b = math.round_to_mintick(math.avg(nz(cl[1]), avrng)) // two-bar pivot
    pchlc2 = math.round_to_mintick(math.avg(nz(cl[1]), pivot))
    pcohlc2 = math.round_to_mintick(math.avg(nz(cl[1]), avbar))
    phpl2 = math.round_to_mintick(math.avg(nz(hi[1]), nz(lo[1])))
    phplhl2 = math.round_to_mintick(math.avg(phpl2, avrng))
    phplpc2 = math.round_to_mintick(math.avg(phpl2, nz(cl[1])))
    phplpcpc2 = math.round_to_mintick(math.avg(phplpc2, nz(cl[1])))
    pophplpc2 = math.round_to_mintick(math.avg(phpl2, nz(op[1])))
    avg2b = math.round_to_mintick(math.avg(pophplpc2, avbar))
    prcMA2b = math.round_to_mintick(math.avg(popc2, poc3, math.avg(pivot2b, pchlc2, pcohlc2, phpl2, phplhl2, phplpc2, phplpcpc2, pophplpc2)))
    priceMA = math.round_to_mintick(math.avg(prcMA, avg2b, prcMA2b))
    price = math.round_to_mintick(math.avg(math.avg(prcMA, oc2), math.avg(pcoc2, pooc2, popc2, poc3, pivot2b), math.avg(pchlc2, pcohlc2, phpl2), math.avg(phplhl2, phplpc2, phplpcpc2, pophplpc2, avg2b), math.avg(prcMA2b, priceMA)))
    pricemap = map.new<string, float>()

    pricemap.put('prcMA', prcMA)
    pricemap.put('oc2', oc2)
    pricemap.put('pcoc2', pcoc2)
    pricemap.put('pooc2', pooc2)
    pricemap.put('popc2', popc2)
    pricemap.put('poc3', poc3)
    pricemap.put('pivot2b', pivot2b)
    pricemap.put('pchlc2', pchlc2)
    pricemap.put('pcohlc2', pcohlc2)
    pricemap.put('phpl2', phpl2)
    pricemap.put('phplhl2', phplhl2)
    pricemap.put('phplpc2', phplpc2)
    pricemap.put('phplpcpc2', phplpcpc2)
    pricemap.put('pophplpc2', pophplpc2)
    pricemap.put('avg2b', avg2b)
    pricemap.put('prcMA2b', prcMA2b)
    pricemap.put('priceMA', priceMA)
    pricemap.put('price', price)
    // [prcMA, oc2, pcoc2, pooc2, popc2, poc3, pivot2b, pchlc2, pcohlc2, phpl2, phplhl2, phplpc2, phplpcpc2, pophplpc2, avg2b, prcMA2b, priceMA, price]
    pricemap

// @function Dynamically computes Eight different MAs and returns a Map containing Nine MAs
// @param masrc source series to compute MA
// @param malen lookback distance for MA
// @param lsmaoff optional LSMA offset - default is 0
// @param almasgm optional ALMA sigma - default is 5
// @param almaoff optional ALMA offset - default is 0.5
// @param almaflr optional ALMA floor flag - default is false
// @returns Map of MAs - 'ALMA', 'EMA', 'HMA', 'LSMA', 'RMA', 'SMA', 'SWMA', 'WMA', 'ALL' (rounded-to-mintick)
export dynamic_MA(series float masrc, int malen, int lsmaoff = 0, float almasgm = 5, float almaoff = 0.5, bool almaflr = false) =>
	alma = ta.alma(masrc, malen, almaoff, almasgm, almaflr)
    ema = ta.ema(masrc, malen)
    hma = ta.hma(masrc, malen)
    lsma = ta.linreg(masrc, malen, lsmaoff)
    rma = ta.rma(masrc, malen)
    sma = ta.sma(masrc, malen)
    swma = ta.swma(masrc)
    wma = ta.wma(masrc, malen)
    avgma = math.avg(alma, ema, hma, lsma, rma, sma, swma, wma)
    dyna_ma_map = map.new<string, float>()
        
	dyna_ma_map.put('ALMA', math.round_to_mintick(alma))
	dyna_ma_map.put('EMA', math.round_to_mintick(ema))
	dyna_ma_map.put('HMA', math.round_to_mintick(hma))
	dyna_ma_map.put('LSMA', math.round_to_mintick(lsma))
	dyna_ma_map.put('RMA', math.round_to_mintick(rma))
	dyna_ma_map.put('SMA', math.round_to_mintick(sma))
	dyna_ma_map.put('SWMA', math.round_to_mintick(swma))
	dyna_ma_map.put('WMA', math.round_to_mintick(wma))
	dyna_ma_map.put('ALL', math.round_to_mintick(avgma))
	dyna_ma_map

// EoF