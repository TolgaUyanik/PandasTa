//@version=5
indicator("Gold 3min Trading Pro [XAU/USD]", overlay=false, max_labels_count=100, max_lines_count=50)

// === カスタム関数 ===

// マルチタイムフレーム移動平均取得
f_get_mtf_ma(timeframe_str, source, length, ma_type) =>
    ma_value = ma_type == "EMA" ? ta.ema(source, length) : ta.sma(source, length)
    request.security(syminfo.tickerid, timeframe_str, ma_value, lookahead=barmerge.lookahead_off)

// 大トレンド方向判定（上位時間軸）
f_major_trend_direction(m15_fast, m15_slow, h1_fast, h1_slow, h4_fast, h4_slow) =>
    m15_trend = m15_fast > m15_slow ? 1 : -1
    h1_trend = h1_fast > h1_slow ? 1 : -1
    h4_trend = h4_fast > h4_slow ? 1 : -1
    trend_score = m15_trend + h1_trend + h4_trend
    trend_strength = math.abs(trend_score)
    trend_direction = trend_score > 0 ? 1 : -1
    [trend_direction, trend_strength]

// 短期トレンド分析（3分足専用）
f_short_term_trend(price, ma5, ma13, ma21) =>
    uptrend = price > ma5 and ma5 > ma13 and ma13 > ma21
    downtrend = price < ma5 and ma5 < ma13 and ma13 < ma21
    consolidation = not uptrend and not downtrend
    [uptrend ? 1 : downtrend ? -1 : 0, consolidation]

// ストキャスティクス計算（手動実装）
f_stochastic(length) =>
    lowest_low = ta.lowest(low, length)
    highest_high = ta.highest(high, length)
    k_percent = highest_high != lowest_low ? (close - lowest_low) / (highest_high - lowest_low) * 100 : 50
    k_percent

// スキャルピング用モメンタム
f_scalping_momentum(rsi_val, stoch_k, volume_ratio) =>
    momentum_score = 0.0
    if rsi_val > 70 and stoch_k > 80 and volume_ratio > 1.5
        momentum_score := -2
    else if rsi_val < 30 and stoch_k < 20 and volume_ratio > 1.5
        momentum_score := 2
    else if rsi_val > 60 and stoch_k > 70
        momentum_score := -1
    else if rsi_val < 40 and stoch_k < 30
        momentum_score := 1
    momentum_score

// 3分足専用エントリー判定
f_scalp_entry_signal(major_trend, short_trend, momentum, price_action, volume_spike) =>
    long_signal = major_trend == 1 and short_trend >= 0 and momentum >= 1 and price_action == 1 and volume_spike
    short_signal = major_trend == -1 and short_trend <= 0 and momentum <= -1 and price_action == -1 and volume_spike
    [long_signal, short_signal]

// 価格アクション分析（3分足用）
f_price_action_3min(open_val, high_val, low_val, close_val) =>
    body_size = math.abs(close_val - open_val)
    total_range = high_val - low_val
    body_ratio = total_range > 0 ? body_size / total_range : 0
    
    strong_bull = close_val > open_val and body_ratio > 0.7 and body_size > ta.atr(14) * 0.3
    strong_bear = close_val < open_val and body_ratio > 0.7 and body_size > ta.atr(14) * 0.3
    
    strong_bull ? 1 : strong_bear ? -1 : 0

// 利確・損切りレベル（3分足専用）
f_scalp_levels(entry_price, atr_val, trend_strength, is_long) =>
    atr_multiplier = trend_strength == 3 ? 1.5 : trend_strength == 2 ? 1.2 : 1.0
    quick_target = is_long ? entry_price + atr_val * atr_multiplier * 0.5 : entry_price - atr_val * atr_multiplier * 0.5
    main_target = is_long ? entry_price + atr_val * atr_multiplier : entry_price - atr_val * atr_multiplier
    stop_loss = is_long ? entry_price - atr_val * 0.6 : entry_price + atr_val * 0.6
    [quick_target, main_target, stop_loss]

// MACD計算（追加指標）
f_macd(source, fast_length, slow_length, signal_length) =>
    fast_ma = ta.ema(source, fast_length)
    slow_ma = ta.ema(source, slow_length)
    macd_line = fast_ma - slow_ma
    signal_line = ta.ema(macd_line, signal_length)
    histogram = macd_line - signal_line
    [macd_line, signal_line, histogram]

// ボラティリティフィルター（新機能）
f_volatility_filter(atr_val, atr_ma) =>
    volatility_ratio = atr_val / atr_ma
    high_vol = volatility_ratio > 1.3
    low_vol = volatility_ratio < 0.7
    [high_vol, low_vol, volatility_ratio]

// === ユーザー設定 ===
show_scalp_signals = input.bool(true, title="Show 3min Scalping Signals")
show_trend_filter = input.bool(true, title="Show Trend Filter Info")
show_performance = input.bool(true, title="Show Performance Stats")
use_time_filter = input.bool(true, title="Use Trading Session Filter")
show_alerts = input.bool(true, title="Show Alerts")

ma_type = input.string("EMA", options=["EMA", "SMA"], title="Moving Average Type")
fast_ma = input.int(5, title="Fast MA (3min)", minval=3, maxval=10)
medium_ma = input.int(13, title="Medium MA (3min)", minval=8, maxval=20)
slow_ma = input.int(21, title="Slow MA (3min)", minval=15, maxval=30)

rsi_length = input.int(9, title="RSI Length (3min)", minval=5, maxval=14)
stoch_length = input.int(9, title="Stochastic Length", minval=5, maxval=14)
volume_threshold = input.float(1.8, title="Volume Spike Threshold", minval=1.2, maxval=3.0)

take_profit_pct = input.float(1.5, title="Take Profit %", minval=0.5, maxval=3.0, step=0.1)
stop_loss_pct = input.float(0.8, title="Stop Loss %", minval=0.3, maxval=2.0, step=0.1)
max_bars_in_trade = input.int(20, title="Max Bars in Trade", minval=5, maxval=50)

use_volatility_filter = input.bool(true, title="Use Volatility Filter")
min_volatility = input.float(1.1, title="Minimum Volatility Ratio", minval=0.8, maxval=2.0)

show_levels = input.bool(false, title="Show TP/SL Levels")
level_display_bars = input.int(10, title="Level Display Duration", minval=5, maxval=30)

// === マルチタイムフレーム計算 ===
m15_ma_fast = f_get_mtf_ma("15", close, 8, ma_type)
m15_ma_slow = f_get_mtf_ma("15", close, 21, ma_type)

h1_ma_fast = f_get_mtf_ma("60", close, 8, ma_type)
h1_ma_slow = f_get_mtf_ma("60", close, 21, ma_type)

h4_ma_fast = f_get_mtf_ma("240", close, 8, ma_type)
h4_ma_slow = f_get_mtf_ma("240", close, 21, ma_type)

// === 3分足メイン計算 ===
ma_fast_3m = ma_type == "EMA" ? ta.ema(close, fast_ma) : ta.sma(close, fast_ma)
ma_medium_3m = ma_type == "EMA" ? ta.ema(close, medium_ma) : ta.sma(close, medium_ma)
ma_slow_3m = ma_type == "EMA" ? ta.ema(close, slow_ma) : ta.sma(close, slow_ma)

rsi_3m = ta.rsi(close, rsi_length)
stoch_k = f_stochastic(stoch_length)
stoch_d = ta.sma(stoch_k, 3)
atr_3m = ta.atr(14)
atr_ma = ta.sma(atr_3m, 20)

[macd_line, macd_signal, macd_histogram] = f_macd(close, 12, 26, 9)

volume_ma = ta.sma(volume, 20)
volume_ratio = volume > 0 and volume_ma > 0 ? volume / volume_ma : 1
volume_spike = volume_ratio > volume_threshold

[high_volatility, low_volatility, vol_ratio] = f_volatility_filter(atr_3m, atr_ma)
volatility_ok = use_volatility_filter ? vol_ratio >= min_volatility : true

[major_trend, major_strength] = f_major_trend_direction(m15_ma_fast, m15_ma_slow, h1_ma_fast, h1_ma_slow, h4_ma_fast, h4_ma_slow)

[short_trend_direction, is_consolidation] = f_short_term_trend(close, ma_fast_3m, ma_medium_3m, ma_slow_3m)

scalp_momentum = f_scalping_momentum(rsi_3m, stoch_k, volume_ratio)

price_action_signal = f_price_action_3min(open, high, low, close)

london_session = (hour >= 17 and hour <= 23) or (hour >= 0 and hour < 1)
ny_session = (hour >= 22) or (hour >= 0 and hour < 6)
active_session = london_session or ny_session
time_filter_ok = use_time_filter ? active_session : true

[scalp_long_raw, scalp_short_raw] = f_scalp_entry_signal(major_trend, short_trend_direction, scalp_momentum, price_action_signal, volume_spike)
scalp_long = scalp_long_raw and time_filter_ok and volatility_ok
scalp_short = scalp_short_raw and time_filter_ok and volatility_ok

[quick_tp_long, main_tp_long, sl_long] = f_scalp_levels(close, atr_3m, major_strength, true)
[quick_tp_short, main_tp_short, sl_short] = f_scalp_levels(close, atr_3m, major_strength, false)

stoch_cross_up = ta.crossover(stoch_k, stoch_d) and stoch_k < 30
stoch_cross_down = ta.crossunder(stoch_k, stoch_d) and stoch_k > 70

macd_bull_cross = ta.crossover(macd_line, macd_signal)
macd_bear_cross = ta.crossunder(macd_line, macd_signal)

// === パフォーマンス統計 ===
var int total_signals = 0
var int long_signals = 0
var int short_signals = 0
var float avg_rsi_at_signal = 0.0
var int bars_since_last_signal = 0

if scalp_long or scalp_short
    total_signals += 1
    avg_rsi_at_signal := (avg_rsi_at_signal * (total_signals - 1) + rsi_3m) / total_signals
    bars_since_last_signal := 0
    if scalp_long
        long_signals += 1
    if scalp_short
        short_signals += 1
else
    bars_since_last_signal += 1

var float last_long_price = na
var float last_short_price = na
var int last_long_bar = na
var int last_short_bar = na

if scalp_long
    last_long_price := close
    last_long_bar := bar_index

if scalp_short
    last_short_price := close
    last_short_bar := bar_index

current_market_score = (rsi_3m > 50 ? 1 : -1) + (stoch_k > 50 ? 1 : -1) + major_trend + short_trend_direction
market_strength = math.abs(current_market_score)
market_direction = current_market_score > 0 ? 1 : -1

// === 視覚的要素とプロット ===
hline(70, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(30, "Oversold", color=color.green, linestyle=hline.style_dashed)
hline(50, "Midline", color=color.gray, linestyle=hline.style_dotted)

plot(rsi_3m, title="RSI", color=color.blue, linewidth=2)
plot(stoch_k, title="Stoch %K", color=color.orange, linewidth=1)
plot(stoch_d, title="Stoch %D", color=color.yellow, linewidth=1)

plotchar(macd_histogram > 0 ? 100 : na, title="MACD Bull", char="▲", location=location.top, color=color.lime, size=size.tiny)
plotchar(macd_histogram < 0 ? 0 : na, title="MACD Bear", char="▼", location=location.bottom, color=color.red, size=size.tiny)

bgcolor(volume_spike ? color.new(color.yellow, 90) : na, title="Volume Spike")

trend_color = major_trend == 1 ? color.new(color.green, 95) : major_trend == -1 ? color.new(color.red, 95) : color.new(color.gray, 95)
bgcolor(show_trend_filter ? trend_color : na, title="Major Trend Background")

// === シグナル表示 ===
plotshape(show_scalp_signals and scalp_long, title="Long Signal", style=shape.triangleup, location=location.bottom, color=color.new(color.lime, 0), size=size.normal, text="LONG")

plotshape(show_scalp_signals and scalp_short, title="Short Signal", style=shape.triangledown, location=location.top, color=color.new(color.red, 0), size=size.normal, text="SHORT")

// 追加確認シグナル
plotshape(stoch_cross_up and major_trend == 1 and not scalp_long, title="Stoch Bullish Cross", style=shape.circle, location=location.bottom, color=color.new(color.blue, 30), size=size.tiny)

plotshape(stoch_cross_down and major_trend == -1 and not scalp_short, title="Stoch Bearish Cross", style=shape.circle, location=location.top, color=color.new(color.purple, 30), size=size.tiny)

// === 情報テーブル表示 ===
if show_performance and barstate.islast
    var table info_table = table.new(position.top_right, 3, 10, bgcolor=color.new(color.white, 80), border_width=2)
    
    table.cell(info_table, 0, 0, "GOLD 3min Pro Stats", text_color=color.black, text_size=size.normal, bgcolor=color.new(color.blue, 80))
    table.cell(info_table, 1, 0, "", text_color=color.black)
    table.cell(info_table, 2, 0, "", text_color=color.black)
    
    table.cell(info_table, 0, 1, "Total Signals:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(total_signals), text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 1, "", text_color=color.black)
    
    table.cell(info_table, 0, 2, "Long Signals:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 2, str.tostring(long_signals), text_color=color.green, text_size=size.small)
    table.cell(info_table, 2, 2, str.tostring(total_signals > 0 ? math.round(long_signals / total_signals * 100) : 0) + "%", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 3, "Short Signals:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 3, str.tostring(short_signals), text_color=color.red, text_size=size.small)
    table.cell(info_table, 2, 3, str.tostring(total_signals > 0 ? math.round(short_signals / total_signals * 100) : 0) + "%", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 4, "Major Trend:", text_color=color.black, text_size=size.small)
    trend_text = major_trend == 1 ? "BULLISH" : major_trend == -1 ? "BEARISH" : "NEUTRAL"
    trend_text_color = major_trend == 1 ? color.green : major_trend == -1 ? color.red : color.orange
    table.cell(info_table, 1, 4, trend_text, text_color=trend_text_color, text_size=size.small)
    table.cell(info_table, 2, 4, "(" + str.tostring(major_strength) + "/3)", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 5, "Short Trend:", text_color=color.black, text_size=size.small)
    short_trend_text = short_trend_direction == 1 ? "UP" : short_trend_direction == -1 ? "DOWN" : "CONSOLIDATION"
    short_trend_color = short_trend_direction == 1 ? color.green : short_trend_direction == -1 ? color.red : color.orange
    table.cell(info_table, 1, 5, short_trend_text, text_color=short_trend_color, text_size=size.small)
    table.cell(info_table, 2, 5, "", text_color=color.black)
    
    table.cell(info_table, 0, 6, "Current RSI:", text_color=color.black, text_size=size.small)
    rsi_text_color = rsi_3m > 70 ? color.red : rsi_3m < 30 ? color.green : color.blue
    table.cell(info_table, 1, 6, str.tostring(math.round(rsi_3m, 1)), text_color=rsi_text_color, text_size=size.small)
    table.cell(info_table, 2, 6, "", text_color=color.black)
    
    table.cell(info_table, 0, 7, "Volatility:", text_color=color.black, text_size=size.small)
    vol_text_color = high_volatility ? color.red : low_volatility ? color.blue : color.green
    vol_status = high_volatility ? "HIGH" : low_volatility ? "LOW" : "NORMAL"
    table.cell(info_table, 1, 7, vol_status, text_color=vol_text_color, text_size=size.small)
    table.cell(info_table, 2, 7, str.tostring(math.round(vol_ratio, 2)), text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 8, "Session:", text_color=color.black, text_size=size.small)
    session_text = london_session and ny_session ? "OVERLAP" : london_session ? "LONDON" : ny_session ? "NEW YORK" : "QUIET"
    session_color = london_session or ny_session ? color.green : color.orange
    table.cell(info_table, 1, 8, session_text, text_color=session_color, text_size=size.small)
    table.cell(info_table, 2, 8, "", text_color=color.black)
    
    table.cell(info_table, 0, 9, "Last Signal:", text_color=color.black, text_size=size.small)
    bars_ago_text = bars_since_last_signal == 0 ? "NOW" : str.tostring(bars_since_last_signal) + " bars ago"
    table.cell(info_table, 1, 9, bars_ago_text, text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 9, "", text_color=color.black)

// === 追加の視覚的改善 ===
// 強いトレンド時の背景色
strong_bull_bg = major_trend == 1 and major_strength == 3 and short_trend_direction == 1
strong_bear_bg = major_trend == -1 and major_strength == 3 and short_trend_direction == -1

bgcolor(strong_bull_bg ? color.new(color.green, 97) : na, title="Strong Bull Trend")
bgcolor(strong_bear_bg ? color.new(color.red, 97) : na, title="Strong Bear Trend")

// 高ボラティリティ時の警告
plotchar(high_volatility and volume_spike, title="High Activity Warning", char="!", location=location.top, color=color.new(color.yellow, 0), size=size.large)

// RSIの極値でのマーク
plotchar(rsi_3m > 80, title="RSI Extremely Overbought", char="⚠", location=location.top, color=color.red, size=size.small)
plotchar(rsi_3m < 20, title="RSI Extremely Oversold", char="⚠", location=location.bottom, color=color.green, size=size.small)

// === RSIダイバージェンス検出（簡易版）===
rsi_higher_high = rsi_3m > rsi_3m[1] and rsi_3m[1] > rsi_3m[2] and high > high[1] and high[1] > high[2]
rsi_lower_low = rsi_3m < rsi_3m[1] and rsi_3m[1] < rsi_3m[2] and low < low[1] and low[1] < low[2]
rsi_bull_div = rsi_lower_low and close > close[2]
rsi_bear_div = rsi_higher_high and close < close[2]

plotchar(rsi_bull_div, title="RSI Bullish Divergence", char="D", location=location.bottom, color=color.green, size=size.small)
plotchar(rsi_bear_div, title="RSI Bearish Divergence", char="D", location=location.top, color=color.red, size=size.small)

// === パフォーマンス強化されたシグナル ===
enhanced_long = scalp_long and (rsi_bull_div or stoch_cross_up or macd_bull_cross)
enhanced_short = scalp_short and (rsi_bear_div or stoch_cross_down or macd_bear_cross)

plotshape(enhanced_long, title="Enhanced Long", style=shape.labelup, location=location.bottom, color=color.new(color.lime, 0), textcolor=color.white, text="STRONG LONG", size=size.small)
plotshape(enhanced_short, title="Enhanced Short", style=shape.labeldown, location=location.top, color=color.new(color.red, 0), textcolor=color.white, text="STRONG SHORT", size=size.small)

// === 改良されたアラート条件 ===
premium_long = scalp_long and major_strength >= 2 and volume_ratio > 2.0 and not is_consolidation
premium_short = scalp_short and major_strength >= 2 and volume_ratio > 2.0 and not is_consolidation

// 転換点アラート
trend_reversal_up = major_trend == 1 and major_trend[1] != 1 and major_strength >= 2
trend_reversal_down = major_trend == -1 and major_trend[1] != -1 and major_strength >= 2

// === 市場状況インジケーター ===
market_condition = ""
market_condition_color = color.gray

if major_strength == 3 and not is_consolidation
    market_condition := "TRENDING"
    market_condition_color := major_trend == 1 ? color.green : color.red
else if high_volatility and volume_spike
    market_condition := "VOLATILE"
    market_condition_color := color.orange  
else if is_consolidation
    market_condition := "RANGING"
    market_condition_color := color.gray
else
    market_condition := "MIXED"
    market_condition_color := color.yellow

// === アラート設定 ===
alertcondition(scalp_long, title="Scalp Long Signal", message="GOLD 3min LONG Signal")
alertcondition(scalp_short, title="Scalp Short Signal", message="GOLD 3min SHORT Signal")
alertcondition(enhanced_long, title="Enhanced Long Signal", message="GOLD: ENHANCED LONG Signal - Multiple Confirmations")
alertcondition(enhanced_short, title="Enhanced Short Signal", message="GOLD: ENHANCED SHORT Signal - Multiple Confirmations")
alertcondition(premium_long, title="Premium Long Signal", message="GOLD: High-quality LONG signal with strong confirmation")
alertcondition(premium_short, title="Premium Short Signal", message="GOLD: High-quality SHORT signal with strong confirmation")
alertcondition(stoch_cross_up and major_trend == 1, title="Stoch Bullish Cross", message="GOLD: Stochastic bullish crossover")
alertcondition(stoch_cross_down and major_trend == -1, title="Stoch Bearish Cross", message="GOLD: Stochastic bearish crossover")
alertcondition(volume_spike and high_volatility, title="High Activity Alert", message="GOLD: High volume and volatility")
alertcondition(trend_reversal_up, title="Major Trend Reversal UP", message="GOLD: Major trend turned BULLISH")
alertcondition(trend_reversal_down, title="Major Trend Reversal DOWN", message="GOLD: Major trend turned BEARISH")

// === エクスポート用の値（他のスクリプトで使用する場合）===
export_long_signal = scalp_long
export_short_signal = scalp_short
export_enhanced_long = enhanced_long
export_enhanced_short = enhanced_short
export_major_trend = major_trend
export_rsi = rsi_3m
export_volatility_ratio = vol_ratio

// プロット用にエクスポート値を隠しプロット（他スクリプトから参照可能）
plot(export_long_signal ? 100 : na, title="Export Long", display=display.none)
plot(export_short_signal ? 0 : na, title="Export Short", display=display.none)
plot(export_major_trend, title="Export Trend", display=display.none)