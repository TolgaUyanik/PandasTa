//@version=6
indicator('Universal Valuation | Lyro RS', 'Universal Valuation | Lyro RS', overlay = false, precision = 2)


// Import Libraries
import LyroRS/LMAs/1 as DynamicMA

//─────────────────────────────────────────────────────────────────────────────────────────────────────────────
//─██████─────────████████──████████─████████████████───██████████████───────████████████████───██████████████─
//─██░░██─────────██░░░░██──██░░░░██─██░░░░░░░░░░░░██───██░░░░░░░░░░██───────██░░░░░░░░░░░░██───██░░░░░░░░░░██─
//─██░░██─────────████░░██──██░░████─██░░████████░░██───██░░██████░░██───────██░░████████░░██───██░░██████████─
//─██░░██───────────██░░░░██░░░░██───██░░██────██░░██───██░░██──██░░██───────██░░██────██░░██───██░░██─────────
//─██░░██───────────████░░░░░░████───██░░████████░░██───██░░██──██░░██───────██░░████████░░██───██░░██████████─
//─██░░██─────────────████░░████─────██░░░░░░░░░░░░██───██░░██──██░░██───────██░░░░░░░░░░░░██───██░░░░░░░░░░██─
//─██░░██───────────────██░░██───────██░░██████░░████───██░░██──██░░██───────██░░██████░░████───██████████░░██─
//─██░░██───────────────██░░██───────██░░██──██░░██─────██░░██──██░░██───────██░░██──██░░██─────────────██░░██─
//─██░░██████████───────██░░██───────██░░██──██░░██████─██░░██████░░██───────██░░██──██░░██████─██████████░░██─
//─██░░░░░░░░░░██───────██░░██───────██░░██──██░░░░░░██─██░░░░░░░░░░██───────██░░██──██░░░░░░██─██░░░░░░░░░░██─
//─██████████████───────██████───────██████──██████████─██████████████───────██████──██████████─██████████████─
//─────────────────────────────────────────────────────────────────────────────────────────────────────────────
//                                                 LyroRS v1.0


// Group Names
indicator_settings_g = "𝗜𝗡𝗗𝗜𝗖𝗔𝗧𝗢𝗥 𝗦𝗘𝗧𝗧𝗜𝗡𝗚𝗦"
thresholds_g = "𝗧𝗛𝗥𝗘𝗦𝗛𝗢𝗟𝗗𝗦"
display_g = '𝗗𝗜𝗦𝗣𝗟𝗔𝗬'
tables_g = "𝐓𝐀𝐁𝐋𝐄"


//  ╔════════════════════════════════╗  //
//  ║             INPUTS             ║  //
//  ╚════════════════════════════════╝  //




// Indicator Settings
len = 180
source = input.source(close, "Source", tooltip="Select the data series used for indicator calculations..", group=indicator_settings_g)
andromeda_length = input.int(200, 'Andromeda Length', display = display.status_line, group = indicator_settings_g, tooltip = 'Sets the length for calculating Andromeda section.', minval=1)
sentinel_length = input.int(150, 'Sentinel Length', display = display.status_line, group = indicator_settings_g, tooltip = 'Sets the length of the Sentinel category used in calculations.', minval=1)
nexus_length = input.int(150, 'Nexus Length', display = display.status_line, group = indicator_settings_g, tooltip = 'Sets the period length for the Nexus section calculation.', minval=1)


smoothing_length = input.int(5, 'Smoothing Length', group= indicator_settings_g, tooltip = 'Sets the smoothening length for the plotting of the indicator. Set "1", for no smoothing.', minval=1)



uvth = input.float(-2, 'Undervalued Threshold', group= thresholds_g , minval = -3, tooltip = "Threshold for showing the market as under valued (Over Sold).")
ovth = input.float(2, 'Overvalued Threshold', group= thresholds_g, maxval= 3, tooltip = "Threshold for showing the market as over valued (Over Bought).")



// Display
signal = input.string('Valuation', 'Signal', options = ['Valuation', 'Trend'], group = display_g, tooltip = 'Select a signal that either evaluates the market (overbought/oversold) or gives a clear direction (bull/bear).')
ColMode_v = input.string("Classic", "Color Palette Choice", inline="drop", group=display_g, options=[
 "Classic", "Mystic", "Magma", "Viridis", "Accented", 'Royal'], tooltip="Select a custom color palette to refine the indicator's visual appearance. This setting allows you to tailor chart colors for improved clarity and enhanced overall aesthetics.")


cpyn_v           = input.bool  (false,             "Custom Palette",  group = display_g, tooltip= "Choose a pre-defined color scheme to standardize your chart's aesthetics. These schemes are optimized for visual clarity and consistency, enhancing overall readability.")
cpv_UpC        = input.color (#00ff00,         "Custom Oversold Color", inline = "Custom Palette",   group = display_g) 
cpv_DnC        = input.color (#ff0000,         "Custom Overbought Color", inline = "Custom Palette",   group = display_g)


// Tables
fo = input.bool(true, 'Force Overlay?', display = display.none, group =tables_g, tooltip = 'Allows forcing the overlay of the table on the chart.')
enable_table = input.bool(true, '', display = display.none, group =tables_g, inline= "T1")
pos_table = input.string('Middle Right', 'Universal Valuation Table', options = ['Top Left', 'Middle Left', 'Bottom Left', 'Top Right', 'Middle Right', 'Bottom Right', 'Top Center', 'Bottom Center'], group = tables_g, display = display.none, inline= "T1")
table_size_input = input.string("Small", '', options= ["Huge", "Large", "Normal", "Small", "Tiny"], group= tables_g, tooltip= "Settings for the universal valuation table.", display = display.none, inline= "T1")




//  ╔════════════════════════════════╗  //
//  ║            COLORS              ║  //
//  ╚════════════════════════════════╝  //

// Defining Colors
color v_UpC = na
color v_DnC = na

// Color Switching
switch ColMode_v
    "Classic" =>
        v_UpC := color.rgb(0, 255, 187)
        v_DnC := #ff0000a9
    "Magma" =>
        v_UpC := #ffdb00
        v_DnC := #400b0b

    "Viridis" =>
        v_UpC := #fde725
        v_DnC := #35b779

    "Mystic" =>
        v_UpC := #30FDCF
        v_DnC := #E117B7

    "Accented" =>
        v_UpC := #9618F7
        v_DnC := #FF0078
    "Royal" =>
        v_UpC := #FFC107
        v_DnC := #673AB7



// Custom Colors
if cpyn_v
    v_UpC := cpv_UpC
    v_DnC := cpv_DnC




//  ╔════════════════════════════════╗  //
//  ║            TABLES              ║  //
//  ╚════════════════════════════════╝  //

// Defining Table Size
var string table_size = na


// Switching Table Size
switch table_size_input
    "Huge" =>
        table_size := size.huge
    "Large" =>
        table_size :=  size.large
    "Normal" =>
        table_size :=  size.normal
    "Small" =>
        table_size :=  size.small
    "Tiny" =>
        table_size :=  size.tiny


// Position Switching
pot(position) =>
    var pos = switch position
        'Top Left' => position.top_left
        'Middle Left' => position.middle_left
        'Bottom Left' => position.bottom_left
        'Top Right' => position.top_right
        'Middle Right' => position.middle_right
        'Bottom Right' => position.bottom_right
        'Top Center' => position.top_center
        'Bottom Center' => position.bottom_center
    pos


//  ╔════════════════════════════════╗  //
//  ║           FUNCTIONS            ║  //
//  ╚════════════════════════════════╝  //

// Zsocres
zscore(src, len) =>
    x = src
    h = DynamicMA.SMA(src, len)
    o = ta.stdev(src, len)
    (x-h)/o


// Defining Risk Ratios
type ratios
	float srt = na
	float srp = na
	float omg = na

// Risk Ratios function
method calc(float src, simple int len) =>
    array<float> a_prtr = array.new<float>()
    array<float> a_nrtr = array.new<float>()
    array<float> a_rtr = array.new<float>()
    float rtr = src / src[1] - 1

    for i = 0 to len - 1 by 1
        if rtr[i] < 0.
            a_nrtr.push(rtr[i])
        else
            a_prtr.push(rtr[i])

        a_rtr.push(rtr[i])

    ratios rapr = ratios.new(math.round(a_rtr.avg() / a_nrtr.stdev() * math.sqrt(len), 2), math.round(a_rtr.avg() / a_rtr.stdev() * math.sqrt(len), 2), math.round(a_prtr.sum() / a_nrtr.sum() * -1, 2))

    rapr

// Custom ROC
RoC(src, len) =>
    var float c_roc = na
    if len != 0
        c_roc := src[len - 1] - src[len]
    else
        c_roc := src - src
    c_roc


// Coloring Function
coloring(src) =>
    color.from_gradient(src, -3, 3, v_UpC, v_DnC)

// Signal To emoji Function
signal_emojis(signal) =>
    var string emoji = na
    var color emoji_bg = na

    if signal >= -1 and signal <= 1
        emoji := '🟡'
        emoji_bg := color.yellow
        emoji_bg

    else if signal >= -1.5 and signal <= -1 or signal <= 1.5 and signal >= 1
        emoji := '🟡🟠'
        emoji_bg := color.rgb(237, 218, 45)

    else if signal <= -1.5
        emoji := '🟢'
        emoji_bg := color.green
        emoji_bg

    else if signal <= -2
        emoji := '🟢🟢'
        emoji_bg := color.lime
        emoji_bg
    else if signal >= 1.5
        emoji := '🔴'
        emoji_bg := #e40b0b
        emoji_bg
    else if signal >= 2
        emoji := '🔴🔴'
        emoji_bg := #a80808
        emoji_bg

    [emoji, emoji_bg]


//  ╔════════════════════════════════╗  //
//  ║           INDICATORS           ║  //
//  ╚════════════════════════════════╝  //

// Risk Ratios
src = source
ratios rapr = src.calc(len)
srp = rapr.srp
srt = rapr.srt
omg = rapr.omg

// RSI
rsi = ta.rsi(source, 70)

// ROC
roc = ta.roc(source, 30)

// BB%
bbp_mult = 2
bbp_basis = ta.sma(source, 120)
bbp_dev = bbp_mult * ta.stdev(source, 120)
bbp_upper = bbp_basis + bbp_dev
bbp_lower = bbp_basis - bbp_dev
bbp = (source - bbp_lower) / (bbp_upper - bbp_lower)

// CCI
cci = ta.cci(source, 120)

// Crosby Ratio
type HA
	float o = na
	float h = na
	float l = na
	float c = na

ha(o, h, l, c) =>
    var HA x = HA.new()
    x.c := (o + h + l + c) / 4
    field_0 = x.o
    field_1 = x.o
    field_2 = x.c
    x.o := na(field_0[1]) ? (o + c) / 2 : (nz(field_1[1]) + nz(field_2[1])) / 2
    x.h := math.max(h, math.max(x.o, x.c))
    x.l := math.min(l, math.min(x.o, x.c))
    x

haCandle = ha(open, high, low, close)
haOpen   = haCandle.o
haHigh   = haCandle.h
haLow    = haCandle.l
haClose  = haCandle.c

length = 30
atr = ta.atr(length)
Hclose = haClose[0]
Smooth_heikin = math.avg(Hclose, Hclose[1], Hclose[2], Hclose[3], Hclose[4])
Ma = ta.sma(Smooth_heikin, length)
height = Ma - Ma[1]
atan2(y, x) =>
    var float angle = 0.0
    if x > 0
        angle := math.atan(y / x)
        angle
    else
        if x < 0 and y >= 0
            angle := math.atan(y / x) + math.pi
            angle
        else
            if x < 0 and y < 0
                angle := math.atan(y / x) - math.pi
                angle
            else
                if x == 0 and y > 0
                    angle := math.pi / 2
                    angle
                else
                    if x == 0 and y < 0
                        angle := -math.pi / 2
                        angle
    angle

Crosby_ratio = atan2(100 * height, length * atr) * 180 / (2 * math.pi)



//  ╔════════════════════════════════╗  //
//  ║      FUNCTION EXECUTIONS       ║  //
//  ╚════════════════════════════════╝  //

// Z Score Function Applied
price_z = zscore(source, andromeda_length)
rsi_z = zscore(rsi, andromeda_length)
roc_z = zscore(roc, andromeda_length)
bbp_z = zscore(bbp, sentinel_length)
cci_z = zscore(cci, sentinel_length)
crosby_z = zscore(Crosby_ratio, sentinel_length)
srp_z = zscore(srp, nexus_length)
srt_z = zscore(srt, nexus_length)
omg_z = zscore(omg, nexus_length)

// Universal Valuation Average
universal_valuation = math.avg(srp_z, srt_z, omg_z, price_z, rsi_z, roc_z, bbp_z, cci_z)


//  ╔════════════════════════════════╗  //
//  ║           ROUNDINGS            ║  //
//  ╚════════════════════════════════╝  //

// UVM Andromeda
final_rsi_z = math.round(rsi_z, 2)
final_roc_z = math.round(roc_z, 2)
final_price_z = math.round(price_z, 2) 

// UVM Sentinel
final_bbp_z = math.round(bbp_z, 2)
final_cci_z = math.round(cci_z, 2)
final_crosby_z = math.round(crosby_z, 2)

// UVM Nexus
final_srp_z = math.round(srp_z, 2)
final_srt_z = math.round(srt_z, 2)
final_omg_z = math.round(omg_z, 2)

// Unival Rounding
unival_ = math.round(universal_valuation, 2)


//  ╔════════════════════════════════╗  //
//  ║            DEFINING            ║  //
//  ╚════════════════════════════════╝  //

final_universal_valuation = math.round(DynamicMA.SMA(unival_, smoothing_length), 2)
UVM_Andromeda = math.round(math.avg(final_rsi_z, final_roc_z, final_price_z), 2)
UVM_Sentinel = math.round(math.avg(final_price_z, final_cci_z, final_crosby_z), 2)
UVM_Nexus = math.round(math.avg(final_srp_z, final_srt_z, final_omg_z), 2)



//  ╔════════════════════════════════╗  //
//  ║           CONDITIONS           ║  //
//  ╚════════════════════════════════╝  //

// Background Coloring Condition
var color bgColorVal = na
color bct = signal == "Valuation" ? coloring(final_universal_valuation) : final_universal_valuation > 0 ? v_UpC : v_DnC





// Conditions for colors
if final_universal_valuation <= uvth
    bgColorVal := v_UpC
else if final_universal_valuation >= ovth
    bgColorVal := v_DnC
else
    bgColorVal := na


// Conditions for Text & Emoji
var string wdvt = na
var color wdvt_bg = na
if final_universal_valuation >= -1 and final_universal_valuation <= 1
    wdvt := '𝑵𝒆𝒖𝒕𝒓𝒂𝒍 🟡'
    wdvt_bg := color.yellow
    wdvt_bg

else if final_universal_valuation <= -1.5
    wdvt := '𝑼𝒏𝒅𝒆𝒓𝒗𝒂𝒍𝒖𝒆𝒅 🟢'
    wdvt_bg := color.green
    wdvt_bg
else if final_universal_valuation >= -1.5 and final_universal_valuation <= -1 or final_universal_valuation <= 1.5 and final_universal_valuation >= 1
    wdvt := '𝑪𝒂𝒖𝒕𝒊𝒐𝒏 𝒁𝒐𝒏𝒆 🟡🟠'
    wdvt_bg := color.lime
    wdvt_bg

else if final_universal_valuation <= -2
    wdvt := '𝑺𝒕𝒓𝒐𝒏𝒈𝒍𝒚 𝑼𝒏𝒅𝒆𝒓𝒗𝒂𝒍𝒖𝒆𝒅 🟢🟢'
    wdvt_bg := color.lime
    wdvt_bg
else if final_universal_valuation >= 1.5
    wdvt := '𝑶𝒗𝒆𝒓𝒗𝒂𝒍𝒖𝒆𝒅 🔴'
    wdvt_bg := #e40b0b
    wdvt_bg
else if final_universal_valuation >= 2
    wdvt := '𝑺𝒕𝒓𝒐𝒏𝒈𝒍𝒚 𝑶𝒗𝒆𝒓𝒗𝒂𝒍𝒖𝒆𝒅 🔴🔴'
    wdvt_bg := #a80808
    wdvt_bg

//  ╔════════════════════════════════╗  //
//  ║            TABLES              ║  //
//  ╚════════════════════════════════╝  //

var table unival_table = na
var table stats_table = na

if fo // 'fo' is an input, but used in an if block, not directly in table.new
    unival_table := table.new(pot(pos_table), 100, 100, frame_width = 2, frame_color = color.gray, force_overlay = true, border_color = color.gray, border_width = 1)
    unival_table
else
    unival_table := table.new(pot(pos_table), 100, 100, frame_width = 5, frame_color = #000000, force_overlay = false)
    unival_table

if enable_table
    table.cell(unival_table, 0, 0, '𝓤𝓥 | 𝓛𝓎𝓻𝓸 𝓡𝓢 ', text_color = color.white, bgcolor = #000000, text_size=table_size)
    table.cell(unival_table, 1, 0, '5 Bars:', text_color = color.white, bgcolor = #000000, text_size=table_size)
    table.cell(unival_table, 2, 0, '4 Bars:', text_color = color.white, bgcolor = #000000, text_size=table_size)
    table.cell(unival_table, 3, 0, '3 Bars:', text_color = color.white, bgcolor = #000000, text_size=table_size)
    table.cell(unival_table, 4, 0, '2 Bars:', text_color = color.white, bgcolor = #000000, text_size=table_size)
    table.cell(unival_table, 5, 0, '1 Bar:', text_color = color.white, bgcolor = #000000, text_size=table_size)
    table.cell(unival_table, 6, 0, 'Live Bar:', text_color = color.white, bgcolor = #000000, text_size=table_size)

    table.cell(unival_table, 0, 1, 'UV:', text_color = color.white, bgcolor= #000000, text_size=table_size)
    table.cell(unival_table, 0, 2, 'RoC:', text_color = color.white, bgcolor= #000000, text_size=table_size)
    table.cell(unival_table, 0, 3, 'Signal:', text_color = color.white, bgcolor= #000000, text_size=table_size)

    table.cell(unival_table, 0, 4, 'UVM Andromeda:', text_color = color.white, bgcolor= #000000, text_size=table_size)
    table.cell(unival_table, 0, 5, '', text_color = color.white, bgcolor= #000000, text_size=table_size)
    table.cell(unival_table, 0, 6, '', text_color = color.white, bgcolor= #000000, text_size=table_size)


    table.cell(unival_table, 0, 7, 'UVM Sentinel:', text_color = color.white, bgcolor= #000000, text_size=table_size)
    table.cell(unival_table, 0, 8, '', text_color = color.white, bgcolor= #000000, text_size=table_size)
    table.cell(unival_table, 0, 9, '', text_color = color.white, bgcolor= #000000, text_size=table_size)


    table.cell(unival_table, 0, 10, 'UVM Nexus:', text_color = color.white, bgcolor= #000000, text_size=table_size)
    table.cell(unival_table, 0, 11, '', text_color = color.white, bgcolor= #000000, text_size=table_size)
    table.cell(unival_table, 0, 12, '', text_color = color.white, bgcolor= #000000, text_size=table_size)



    // Final Universal Valuation
    [uv_emoji, uv_emoji_bg] = signal_emojis(final_universal_valuation)

    table.cell(unival_table, 6, 1, str.tostring(final_universal_valuation), text_color = color.white, bgcolor = coloring(final_universal_valuation), text_size=table_size)
    table.cell(unival_table, 5, 1, str.tostring(final_universal_valuation[1]), text_color = color.white, bgcolor = coloring(final_universal_valuation)[1], text_size=table_size)
    table.cell(unival_table, 4, 1, str.tostring(final_universal_valuation[2]), text_color = color.white, bgcolor = coloring(final_universal_valuation)[2], text_size=table_size)
    table.cell(unival_table, 3, 1, str.tostring(final_universal_valuation[3]), text_color = color.white, bgcolor = coloring(final_universal_valuation)[3], text_size=table_size)
    table.cell(unival_table, 2, 1, str.tostring(final_universal_valuation[4]), text_color = color.white, bgcolor = coloring(final_universal_valuation)[4], text_size=table_size)
    table.cell(unival_table, 1, 1, str.tostring(final_universal_valuation[5]), text_color = color.white, bgcolor = coloring(final_universal_valuation)[5], text_size=table_size)


    table.cell(unival_table, 6, 2, str.tostring(math.round(RoC(final_universal_valuation, 0), 2)), text_color = color.white, bgcolor = coloring(final_universal_valuation), text_size=table_size)
    table.cell(unival_table, 5, 2, str.tostring(math.round(RoC(final_universal_valuation, 1), 2)), text_color = color.white, bgcolor = coloring(final_universal_valuation)[1], text_size=table_size)
    table.cell(unival_table, 4, 2, str.tostring(math.round(RoC(final_universal_valuation, 2), 2)), text_color = color.white, bgcolor = coloring(final_universal_valuation)[2], text_size=table_size)
    table.cell(unival_table, 3, 2, str.tostring(math.round(RoC(final_universal_valuation, 3), 2)), text_color = color.white, bgcolor = coloring(final_universal_valuation)[3], text_size=table_size)
    table.cell(unival_table, 2, 2, str.tostring(math.round(RoC(final_universal_valuation, 4), 2)), text_color = color.white, bgcolor = coloring(final_universal_valuation)[4], text_size=table_size)
    table.cell(unival_table, 1, 2, str.tostring(math.round(RoC(final_universal_valuation, 5), 2)), text_color = color.white, bgcolor = coloring(final_universal_valuation)[5], text_size=table_size)

    table.cell(unival_table, 6, 3, str.tostring(uv_emoji), text_color = color.white, bgcolor= uv_emoji_bg, text_size=table_size)
    table.cell(unival_table, 5, 3, str.tostring(uv_emoji[1]), text_color = color.white, bgcolor= uv_emoji_bg[1], text_size=table_size)
    table.cell(unival_table, 4, 3, str.tostring(uv_emoji[2]), text_color = color.white, bgcolor= uv_emoji_bg[2], text_size=table_size)
    table.cell(unival_table, 3, 3, str.tostring(uv_emoji[3]), text_color = color.white, bgcolor= uv_emoji_bg[3], text_size=table_size)
    table.cell(unival_table, 2, 3, str.tostring(uv_emoji[4]), text_color = color.white, bgcolor= uv_emoji_bg[4], text_size=table_size)
    table.cell(unival_table, 1, 3, str.tostring(uv_emoji[5]), text_color = color.white, bgcolor= uv_emoji_bg[5], text_size=table_size)



    // UVM Andromeda
    [UVM_Andromeda_emoji, UVM_Andromeda_emoji_bg] = signal_emojis(UVM_Andromeda)

    table.cell(unival_table, 6, 4, str.tostring(UVM_Andromeda), text_color = color.white, bgcolor = coloring(UVM_Andromeda), text_size=table_size)
    table.cell(unival_table, 5, 4, str.tostring(UVM_Andromeda[1]), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[1], text_size=table_size)
    table.cell(unival_table, 4, 4, str.tostring(UVM_Andromeda[2]), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[2], text_size=table_size)
    table.cell(unival_table, 3, 4, str.tostring(UVM_Andromeda[3]), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[3], text_size=table_size)
    table.cell(unival_table, 2, 4, str.tostring(UVM_Andromeda[4]), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[4], text_size=table_size)
    table.cell(unival_table, 1, 4, str.tostring(UVM_Andromeda[5]), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[5], text_size=table_size)


    table.cell(unival_table, 6, 5, str.tostring(math.round(RoC(UVM_Andromeda, 0), 2)), text_color = color.white, bgcolor = coloring(final_universal_valuation), text_size=table_size)
    table.cell(unival_table, 5, 5, str.tostring(math.round(RoC(UVM_Andromeda, 1), 2)), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[1], text_size=table_size)
    table.cell(unival_table, 4, 5, str.tostring(math.round(RoC(UVM_Andromeda, 2), 2)), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[2], text_size=table_size)
    table.cell(unival_table, 3, 5, str.tostring(math.round(RoC(UVM_Andromeda, 3), 2)), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[3], text_size=table_size)
    table.cell(unival_table, 2, 5, str.tostring(math.round(RoC(UVM_Andromeda, 4), 2)), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[4], text_size=table_size)
    table.cell(unival_table, 1, 5, str.tostring(math.round(RoC(UVM_Andromeda, 5), 2)), text_color = color.white, bgcolor = coloring(UVM_Andromeda)[5], text_size=table_size)

    table.cell(unival_table, 6, 6, str.tostring(UVM_Andromeda_emoji), text_color = color.white, bgcolor= UVM_Andromeda_emoji_bg, text_size=table_size)
    table.cell(unival_table, 5, 6, str.tostring(UVM_Andromeda_emoji[1]), text_color = color.white, bgcolor= UVM_Andromeda_emoji_bg[1], text_size=table_size)
    table.cell(unival_table, 4, 6, str.tostring(UVM_Andromeda_emoji[2]), text_color = color.white, bgcolor= UVM_Andromeda_emoji_bg[2], text_size=table_size)
    table.cell(unival_table, 3, 6, str.tostring(UVM_Andromeda_emoji[3]), text_color = color.white, bgcolor= UVM_Andromeda_emoji_bg[3], text_size=table_size)
    table.cell(unival_table, 2, 6, str.tostring(UVM_Andromeda_emoji[4]), text_color = color.white, bgcolor= UVM_Andromeda_emoji_bg[4], text_size=table_size)
    table.cell(unival_table, 1, 6, str.tostring(UVM_Andromeda_emoji[5]), text_color = color.white, bgcolor= UVM_Andromeda_emoji_bg[5], text_size=table_size)




    // UVM Sentinel
    [UVM_Sentinel_emoji, UVM_Sentinel_emoji_bg] = signal_emojis(UVM_Sentinel)

    table.cell(unival_table, 6, 7, str.tostring(UVM_Sentinel), text_color = color.white, bgcolor = coloring(UVM_Sentinel), text_size=table_size)
    table.cell(unival_table, 5, 7, str.tostring(UVM_Sentinel[1]), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[1], text_size=table_size)
    table.cell(unival_table, 4, 7, str.tostring(UVM_Sentinel[2]), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[2], text_size=table_size)
    table.cell(unival_table, 3, 7, str.tostring(UVM_Sentinel[3]), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[3], text_size=table_size)
    table.cell(unival_table, 2, 7, str.tostring(UVM_Sentinel[4]), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[4], text_size=table_size)
    table.cell(unival_table, 1, 7, str.tostring(UVM_Sentinel[5]), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[5], text_size=table_size)


    table.cell(unival_table, 6, 8, str.tostring(math.round(RoC(UVM_Sentinel, 0), 2)), text_color = color.white, bgcolor = coloring(final_universal_valuation), text_size=table_size)
    table.cell(unival_table, 5, 8, str.tostring(math.round(RoC(UVM_Sentinel, 1), 2)), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[1], text_size=table_size)
    table.cell(unival_table, 4, 8, str.tostring(math.round(RoC(UVM_Sentinel, 2), 2)), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[2], text_size=table_size)
    table.cell(unival_table, 3, 8, str.tostring(math.round(RoC(UVM_Sentinel, 3), 2)), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[3], text_size=table_size)
    table.cell(unival_table, 2, 8, str.tostring(math.round(RoC(UVM_Sentinel, 4), 2)), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[4], text_size=table_size)
    table.cell(unival_table, 1, 8, str.tostring(math.round(RoC(UVM_Sentinel, 5), 2)), text_color = color.white, bgcolor = coloring(UVM_Sentinel)[5], text_size=table_size)

    table.cell(unival_table, 6, 9, str.tostring(UVM_Sentinel_emoji), text_color = color.white, bgcolor= UVM_Sentinel_emoji_bg, text_size=table_size)
    table.cell(unival_table, 5, 9, str.tostring(UVM_Sentinel_emoji[1]), text_color = color.white, bgcolor= UVM_Sentinel_emoji_bg[1], text_size=table_size)
    table.cell(unival_table, 4, 9, str.tostring(UVM_Sentinel_emoji[2]), text_color = color.white, bgcolor= UVM_Sentinel_emoji_bg[2], text_size=table_size)
    table.cell(unival_table, 3, 9, str.tostring(UVM_Sentinel_emoji[3]), text_color = color.white, bgcolor= UVM_Sentinel_emoji_bg[3], text_size=table_size)
    table.cell(unival_table, 2, 9, str.tostring(UVM_Sentinel_emoji[4]), text_color = color.white, bgcolor= UVM_Sentinel_emoji_bg[4], text_size=table_size)
    table.cell(unival_table, 1, 9, str.tostring(UVM_Sentinel_emoji[5]), text_color = color.white, bgcolor= UVM_Sentinel_emoji_bg[5], text_size=table_size)




    // UVM Nexus
    [UVM_Nexus_emoji, UVM_Nexus_emoji_bg] = signal_emojis(UVM_Nexus)

    table.cell(unival_table, 6, 10, str.tostring(UVM_Nexus), text_color = color.white, bgcolor = coloring(UVM_Nexus), text_size=table_size)
    table.cell(unival_table, 5, 10, str.tostring(UVM_Nexus[1]), text_color = color.white, bgcolor = coloring(UVM_Nexus)[1], text_size=table_size)
    table.cell(unival_table, 4, 10, str.tostring(UVM_Nexus[2]), text_color = color.white, bgcolor = coloring(UVM_Nexus)[2], text_size=table_size)
    table.cell(unival_table, 3, 10, str.tostring(UVM_Nexus[3]), text_color = color.white, bgcolor = coloring(UVM_Nexus)[3], text_size=table_size)
    table.cell(unival_table, 2, 10, str.tostring(UVM_Nexus[4]), text_color = color.white, bgcolor = coloring(UVM_Nexus)[4], text_size=table_size)
    table.cell(unival_table, 1, 10, str.tostring(UVM_Nexus[5]), text_color = color.white, bgcolor = coloring(UVM_Nexus)[5], text_size=table_size)


    table.cell(unival_table, 6, 11, str.tostring(math.round(RoC(UVM_Nexus, 0), 2)), text_color = color.white, bgcolor = coloring(final_universal_valuation), text_size=table_size)
    table.cell(unival_table, 5, 11, str.tostring(math.round(RoC(UVM_Nexus, 1), 2)), text_color = color.white, bgcolor = coloring(UVM_Nexus)[1], text_size=table_size)
    table.cell(unival_table, 4, 11, str.tostring(math.round(RoC(UVM_Nexus, 2), 2)), text_color = color.white, bgcolor = coloring(UVM_Nexus)[2], text_size=table_size)
    table.cell(unival_table, 3, 11, str.tostring(math.round(RoC(UVM_Nexus, 3), 2)), text_color = color.white, bgcolor = coloring(UVM_Nexus)[3], text_size=table_size)
    table.cell(unival_table, 2, 11, str.tostring(math.round(RoC(UVM_Nexus, 4), 2)), text_color = color.white, bgcolor = coloring(UVM_Nexus)[4], text_size=table_size)
    table.cell(unival_table, 1, 11, str.tostring(math.round(RoC(UVM_Nexus, 5), 2)), text_color = color.white, bgcolor = coloring(UVM_Nexus)[5], text_size=table_size)

    table.cell(unival_table, 6, 12, str.tostring(UVM_Nexus_emoji), text_color = color.white, bgcolor= UVM_Nexus_emoji_bg, text_size=table_size)
    table.cell(unival_table, 5, 12, str.tostring(UVM_Nexus_emoji[1]), text_color = color.white, bgcolor= UVM_Nexus_emoji_bg[1], text_size=table_size)
    table.cell(unival_table, 4, 12, str.tostring(UVM_Nexus_emoji[2]), text_color = color.white, bgcolor= UVM_Nexus_emoji_bg[2], text_size=table_size)
    table.cell(unival_table, 3, 12, str.tostring(UVM_Nexus_emoji[3]), text_color = color.white, bgcolor= UVM_Nexus_emoji_bg[3], text_size=table_size)
    table.cell(unival_table, 2, 12, str.tostring(UVM_Nexus_emoji[4]), text_color = color.white, bgcolor= UVM_Nexus_emoji_bg[4], text_size=table_size)
    table.cell(unival_table, 1, 12, str.tostring(UVM_Nexus_emoji[5]), text_color = color.white, bgcolor= UVM_Nexus_emoji_bg[5], text_size=table_size)


    table.cell(unival_table, 0, 13, "Market is currently " + wdvt, text_color = color.white, bgcolor= coloring(final_universal_valuation), text_size=table_size)



    // Table Merging Part
    table.merge_cells(unival_table, 0, 4, 0, 6)
    table.merge_cells(unival_table, 0, 7, 0, 9)
    table.merge_cells(unival_table, 0, 10, 0, 12)
    table.merge_cells(unival_table, 0, 13, 6, 13)



//  ╔════════════════════════════════╗  //
//  ║           PLOTTINGS            ║  //
//  ╚════════════════════════════════╝  //

// Defining the Value Zones
h3 = plot(-3, 'High Value Line', color = #29df4a9b, display= display.pane)
h2 = plot(-2, 'Slightly High Value Line', color = #0ba5b98d, display= display.pane)
h1 = plot(-1, 'Value Line', color = #3ca91881, display= display.pane)
h0 = plot(0, 'Zero Line Line', color = #7373758f, display= display.pane)
h4 = plot(1, 'Low Value Line', color = #ffe60070, display= display.pane)
h5 = plot(2, 'Slightly No Value Line', color = #c1620e86, display= display.pane)
h6 = plot(3, 'No Value Line', color = #910000, display= display.pane)

// Filling in Zones
fill(h5, h6, color = #a2000056, title= "Low Value Zone Highlight")
fill(h3, h2, color = #0d6e226e, title= "High Value Zone Highlight")

// Main plotting & Filling
t1 = plot(final_universal_valuation, color = bct, linewidth = 2, title="Universal Valuation Value")
plot(final_universal_valuation, color = color.new(bct, 85), linewidth = 5, title="Glow layer 1", display = display.pane)
plot(final_universal_valuation, color = color.new(bct, 90), linewidth = 10, title="Glow layer 2", display = display.pane)

fill    (h0, t1, final_universal_valuation, 0,   color.new(bct, 30), color.new(chart.bg_color, 50),  display =  display.all, title="Shading")


// Plotting Value & Filling
bgcolor(color.new(bgColorVal, 80), force_overlay= true, title= "Back Ground Color Overlay")
bgcolor(color.new(bgColorVal, 80), force_overlay= false, title= "Back Ground Color No Overlay")


// Alerts
alertcondition(final_universal_valuation <= uvth, 'Market Undervalued', 'Market Undervalued')
alertcondition(final_universal_valuation >= ovth, 'Market Overvalued', 'Market Overvalued')

// Candle Plotting & Bar Coloring
plotcandle(
     open, high, low, close, 
     wickcolor = color.gray, 
     title='Candle Plotting', 
     display= display.pane, 
     color= bct, 
     force_overlay = true, 
     bordercolor= bct)

barcolor(bct, title= "Bar Coloring")