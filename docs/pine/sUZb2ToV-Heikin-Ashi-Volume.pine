//@version=6
indicator(
     title                = "Heikin Ashi Volume", 
     shorttitle           = "HA Vol", 
     explicit_plot_zorder = true, 
     overlay              = false
     )

//#region :::::::::: User Inputs ::::::::::
// Volume Threshold Level
int volumeThreshold = input.int(
     defval = 10000, 
     title  = "Volume Threshold", 
     group  = "Volume Threshold"
     )

bool isThresholdVisible = input.bool(
     defval = true, 
     title  = "Display Volume Threshold Level", 
     group  = "Volume Threshold"
     )

color volumeThresholdLineColor = input.color(
     defval = color.rgb(255, 255, 0, 50), 
     title  = "Volume Threshold Line Color",
     group  = "Volume Threshold"
     )

// Bar Color Change Selections
bool isColoredByThreshold = input.bool(
     defval = true, 
     title  = "Color Volume Bars Based on Volume Threshold", 
     group  = "Volume Bar Colors"
     )

bool isColorGradientUsed = input.bool(
      defval  = false, 
      title   = "Use Color Gradient Under Threshold",
      tooltip = "Color gradually lightens as it approaches threshold value.", 
      group   = "Volume Bar Colors",
      active  = isColoredByThreshold
      )

// Bullish Colors
color bullishOverThresholdColor = input.color(
     defval = color.rgb( 38, 139, 210), 
     title  = "Bullish Over Threshold Color", 
     group  = "Volume Bar Colors"
     )

color bullishUnderThresholdColor = input.color(
     defval = color.rgb(0, 68, 124), 
     title  = "Bullish Under Threshold Color", 
     group  = "Volume Bar Colors",
     active = isColoredByThreshold
     )

// Bearish Colors
color bearishOverThresholdColor = input.color(
     defval = color.rgb(220,  50,  47), 
     title  = "Bearish Over Threshold Color", 
     group  = "Volume Bar Colors"
     )

color bearishUnderThresholdColor = input.color(
     defval = color.rgb(146, 2, 0), 
     title  = "Bearish Under Threshold Color",
     group  = "Volume Bar Colors",
     active = isColoredByThreshold
     )

//#endregion

//#region :::::::::: Call Heikin Ashi Open & Close Data ::::::::::  
[haOpen, haClose] = request.security(
     symbol     = ticker.heikinashi(syminfo.tickerid), 
     timeframe  = timeframe.period, 
     expression = [open, close]
     )
//#endregion

//#region :::::::::: Script Logic ::::::::::
// Define bullish, increasing volume, and over threshold states.
bool isBullish       = haOpen    <  haClose
bool isOverThreshold = volume[0] >= volumeThreshold

// Determine the correct bar color based on the bar's state.
var color barColor  = na

if          isColoredByThreshold and     isBullish     and isOverThreshold
    barColor := bullishOverThresholdColor

else if     isColoredByThreshold and     isBullish and not isOverThreshold
    barColor := isColorGradientUsed ? color.from_gradient(
           value        = volume, 
           bottom_value = volumeThreshold / 2, 
           top_value    = volumeThreshold, 
           bottom_color = bullishUnderThresholdColor, 
           top_color    = bullishOverThresholdColor) : bullishUnderThresholdColor

else if     isColoredByThreshold and not isBullish and     isOverThreshold
    barColor := bearishOverThresholdColor

else if     isColoredByThreshold and not isBullish and not isOverThreshold 
    barColor := isColorGradientUsed ? color.from_gradient(
           value        = volume, 
           bottom_value = volumeThreshold / 2, 
           top_value    = volumeThreshold, 
           bottom_color = bearishUnderThresholdColor, 
           top_color    = bearishOverThresholdColor) : bearishUnderThresholdColor

else if not isColoredByThreshold and     isBullish
    barColor := bullishOverThresholdColor

else if not isColoredByThreshold and not isBullish
    barColor := bearishOverThresholdColor

//#endregion

//#region :::::::::: Plots ::::::::::
// Plot volume threshold line.
hline(
     price     = isThresholdVisible ? volumeThreshold : na, 
     color     = volumeThresholdLineColor, 
     linestyle = hline.style_dashed, 
     linewidth = 1, 
     editable  = false
     )
     
//Plot Heikin Ashi volume bars.
plot(
   series     = volume,
   color      = barColor,
   style      = plot.style_columns,
   editable   = false
   )

//#endregion
