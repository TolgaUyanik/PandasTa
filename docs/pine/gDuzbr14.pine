//@version=6
// AQUILE REALI — Days/Weeks + Highs and Lows
// Daily and weekly H/L: Previous / Current / Both
// Labels offset to the right and staggered PER CATEGORY: never overlapping,
// even when prices coincide.
indicator("Aquile Reali — Days and Weeks", overlay=true, max_lines_count=500, max_labels_count=100)

// ---------- DAY VERTICALS ----------
showGiorno = input.bool(true, "DAY vertical lines", group="Day Verticals")
colGiornoI = input.color(color.new(color.red, 0),  "Day open", group="Day Verticals")
colGiornoF = input.color(color.new(color.red, 50), "Day close", group="Day Verticals")

// ---------- WEEK VERTICALS ----------
showSett = input.bool(true, "WEEK vertical lines", group="Week Verticals")
colSettI = input.color(color.new(color.green, 0),  "Week open", group="Week Verticals")
colSettF = input.color(color.new(color.green, 50), "Week close", group="Week Verticals")

// ---------- LABELS ----------
offBase = input.int(10, "Label distance from last bar (bars)", minval=2, maxval=60, group="Labels")
gapCat  = input.int(35, "Spacing between categories (bars)", minval=5, maxval=200, group="Labels",
     tooltip="Each category (prev day, current day, prev week, current week) is placed further to the right than the previous one by this number of bars, so they never overlap even at identical prices.")
szLabel = input.string("normal", "Text size", options=["small","normal","large"], group="Labels")
sizeLab = szLabel == "small" ? size.small : szLabel == "large" ? size.large : size.normal
showData = input.bool(true, "Show DATE on vertical lines", group="Labels")
colDataG = input.color(color.new(color.red, 0),   "Day date color",  group="Labels")
colDataS = input.color(color.new(color.green, 0), "Week date color", group="Labels")

// ---------- DAY H/L ----------
modoG  = input.string("Previous", "DAY High/Low", options=["Off","Previous","Current","Both"], group="Day H/L")
colPDH = input.color(#2962ff, "PDH (previous day)", group="Day H/L")
colPDL = input.color(#2962ff, "PDL (previous day)", group="Day H/L")
colDH  = input.color(color.new(#2962ff, 40), "Current day high", group="Day H/L")
colDL  = input.color(color.new(#2962ff, 40), "Current day low", group="Day H/L")

// ---------- WEEK H/L ----------
modoS  = input.string("Previous", "WEEK High/Low", options=["Off","Previous","Current","Both"], group="Week H/L")
colPWH = input.color(#d4a843, "PWH (previous week)", group="Week H/L")
colPWL = input.color(#5b9dd9, "PWL (previous week)", group="Week H/L")
colWH  = input.color(color.new(#d4a843, 40), "Current week high", group="Week H/L")
colWL  = input.color(color.new(#5b9dd9, 40), "Current week low", group="Week H/L")

fusoIT = "Europe/Rome"
nuovoGiorno    = ta.change(time("D", fusoIT)) != 0
nuovaSettimana = ta.change(time("W", fusoIT)) != 0

usaPD = modoG == "Previous" or modoG == "Both"
usaDA = modoG == "Current"  or modoG == "Both"
usaPW = modoS == "Previous" or modoS == "Both"
usaWA = modoS == "Current"  or modoS == "Both"

// per-category bar offset: increasing, so labels never touch
offPD = offBase                 // previous day  (closest)
offDA = offBase + gapCat        // current day
offPW = offBase + gapCat * 2    // previous week
offWA = offBase + gapCat * 3    // current week  (farthest)

fmt(p) => str.tostring(p, format.mintick)
fData() =>
    g = dayofmonth(time, fusoIT)
    m = month(time, fusoIT)
    (g < 10 ? "0" + str.tostring(g) : str.tostring(g)) + "/" + (m < 10 ? "0" + str.tostring(m) : str.tostring(m))

// ================= VERTICALS =================
if showSett and nuovaSettimana
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=colSettI, width=3)
    line.new(bar_index - 1, low[1], bar_index - 1, high[1], extend=extend.both, color=colSettF, style=line.style_dashed, width=2)
    if showData
        // date on the green line (week open)
        label.new(bar_index, high, "Week " + fData(), style=label.style_label_down, color=color.new(color.white, 100), textcolor=colDataS, size=sizeLab, textalign=text.align_center)
if showGiorno and nuovoGiorno and not nuovaSettimana
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=colGiornoI, width=2)
    if showData
        // date on the red line (day open)
        label.new(bar_index, high, fData(), style=label.style_label_down, color=color.new(color.white, 100), textcolor=colDataG, size=sizeLab, textalign=text.align_center)
if showGiorno and nuovoGiorno and not (showSett and nuovaSettimana)
    line.new(bar_index - 1, low[1], bar_index - 1, high[1], extend=extend.both, color=colGiornoF, style=line.style_dashed, width=1)

// ================= TRACKING =================
var float dHi = na, var float dLo = na, var int dHiBar = na, var int dLoBar = na
var float wHi = na, var float wLo = na, var int wHiBar = na, var int wLoBar = na

// PREVIOUS
var line lnPDH = na, var line lnPDL = na, var label lbPDH = na, var label lbPDL = na
var line lnPWH = na, var line lnPWL = na, var label lbPWH = na, var label lbPWL = na
// CURRENT
var line lnDH = na, var line lnDL = na, var label lbDH = na, var label lbDL = na
var line lnWH = na, var line lnWL = na, var label lbWH = na, var label lbWL = na

// line from the extreme up to "off" bars to the right + price label
drawPrev(fromBar, price, col, txt, off) =>
    ln = line.new(fromBar, price, bar_index + off, price, color=col, width=1, style=line.style_solid)
    lb = label.new(bar_index + off, price, txt + " " + fmt(price), style=label.style_none, textcolor=col, size=sizeLab, textalign=text.align_left)
    [ln, lb]

// ---- DAY change ----
if nuovoGiorno
    if usaPD and not na(dHi)
        line.delete(lnPDH), label.delete(lbPDH), line.delete(lnPDL), label.delete(lbPDL)
        [a,b] = drawPrev(dHiBar, dHi, colPDH, "PDH", offPD)
        [c,d] = drawPrev(dLoBar, dLo, colPDL, "PDL", offPD)
        lnPDH := a, lbPDH := b, lnPDL := c, lbPDL := d
    // reset to the values of the FIRST candle of the new day
    dHi := high, dLo := low, dHiBar := bar_index, dLoBar := bar_index
// ALWAYS compare (even on the reset candle), so the initial high/low is not lost
if not na(dHi) and high > dHi
    dHi := high, dHiBar := bar_index
if not na(dLo) and low < dLo
    dLo := low, dLoBar := bar_index

// ---- WEEK change ----
if nuovaSettimana
    if usaPW and not na(wHi)
        line.delete(lnPWH), label.delete(lbPWH), line.delete(lnPWL), label.delete(lbPWL)
        [a,b] = drawPrev(wHiBar, wHi, colPWH, "PWH", offPW)
        [c,d] = drawPrev(wLoBar, wLo, colPWL, "PWL", offPW)
        lnPWH := a, lbPWH := b, lnPWL := c, lbPWL := d
    // reset to the values of the FIRST candle of the new week
    wHi := high, wLo := low, wHiBar := bar_index, wLoBar := bar_index
// ALWAYS compare (even on the reset candle)
if not na(wHi) and high > wHi
    wHi := high, wHiBar := bar_index
if not na(wLo) and low < wLo
    wLo := low, wLoBar := bar_index

// PREVIOUS: keep the labels offset to the right, each at its own offset
if not na(lnPDH)
    line.set_x2(lnPDH, bar_index + offPD), label.set_x(lbPDH, bar_index + offPD)
    line.set_x2(lnPDL, bar_index + offPD), label.set_x(lbPDL, bar_index + offPD)
if not na(lnPWH)
    line.set_x2(lnPWH, bar_index + offPW), label.set_x(lbPWH, bar_index + offPW)
    line.set_x2(lnPWL, bar_index + offPW), label.set_x(lbPWL, bar_index + offPW)

// CURRENT day
if usaDA and not na(dHi)
    if na(lnDH)
        lnDH := line.new(dHiBar, dHi, bar_index + offDA, dHi, color=colDH, style=line.style_dotted, width=1)
        lnDL := line.new(dLoBar, dLo, bar_index + offDA, dLo, color=colDL, style=line.style_dotted, width=1)
        lbDH := label.new(bar_index + offDA, dHi, "DH " + fmt(dHi), style=label.style_none, textcolor=colDH, size=sizeLab, textalign=text.align_left)
        lbDL := label.new(bar_index + offDA, dLo, "DL " + fmt(dLo), style=label.style_none, textcolor=colDL, size=sizeLab, textalign=text.align_left)
    line.set_xy1(lnDH, dHiBar, dHi), line.set_xy2(lnDH, bar_index + offDA, dHi)
    line.set_xy1(lnDL, dLoBar, dLo), line.set_xy2(lnDL, bar_index + offDA, dLo)
    label.set_xy(lbDH, bar_index + offDA, dHi), label.set_text(lbDH, "DH " + fmt(dHi))
    label.set_xy(lbDL, bar_index + offDA, dLo), label.set_text(lbDL, "DL " + fmt(dLo))

// CURRENT week
if usaWA and not na(wHi)
    if na(lnWH)
        lnWH := line.new(wHiBar, wHi, bar_index + offWA, wHi, color=colWH, style=line.style_dotted, width=1)
        lnWL := line.new(wLoBar, wLo, bar_index + offWA, wLo, color=colWL, style=line.style_dotted, width=1)
        lbWH := label.new(bar_index + offWA, wHi, "WH " + fmt(wHi), style=label.style_none, textcolor=colWH, size=sizeLab, textalign=text.align_left)
        lbWL := label.new(bar_index + offWA, wLo, "WL " + fmt(wLo), style=label.style_none, textcolor=colWL, size=sizeLab, textalign=text.align_left)
    line.set_xy1(lnWH, wHiBar, wHi), line.set_xy2(lnWH, bar_index + offWA, wHi)
    line.set_xy1(lnWL, wLoBar, wLo), line.set_xy2(lnWL, bar_index + offWA, wLo)
    label.set_xy(lbWH, bar_index + offWA, wHi), label.set_text(lbWH, "WH " + fmt(wHi))
    label.set_xy(lbWL, bar_index + offWA, wLo), label.set_text(lbWL, "WL " + fmt(wLo))

