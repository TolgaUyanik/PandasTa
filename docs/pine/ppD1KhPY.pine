//@version=6

// @description TODO: add library description here
library("AnnualizedReturnCalculator")

// 年化收益率计算函数
// @param isStartTime 开始时间的BOOL值变量（用于标记策略开始时间）
// @param enableLog 是否输出日志
// @returns [annualizedReturn, annualizedReturn_equity, annualizedReturn_maxPosition, totalProfit, avgPositionValue] 
//          返回持仓基准年化收益率、资金基准年化收益率、最大持仓基准年化收益率、总收益、平均资金占用
export calculateAnnualizedReturn(bool isStartTime, bool enableLog) =>
    // 1. 跟踪总净利润（已平仓利润）
    totalClosedProfit = strategy.netprofit

    // 2. 计算未平仓盈利（当前持仓浮盈）
    openProfit = strategy.openprofit

    // 3. 计算资金占用（持仓实际占用的资金）
    // 持仓数量 × 平均入场价（绝对值，避免多空符号影响）
    positionValue = math.abs(strategy.position_size * strategy.position_avg_price)

    // 4. 计算运行天数（时间戳转换）
    var float startTime = 0.0
    if isStartTime and startTime == 0.0
        startTime := time  // 开始时间戳（毫秒）
    T = (time - startTime) / 86400000  // 转换为天数

    // 5. 跟踪平均资金占用（仅统计有持仓时的资金占用）
    var float sumPositionValue = 0.0  // 累计资金占用
    var int positionBarCount = 0  // 有持仓的K线数
    var float maxPositionValue = 0.0  // 最大资金占用

    // 只在有持仓时才统计资金占用
    if strategy.position_size != 0
        positionBarCount += 1
        sumPositionValue += positionValue  // 累加当前资金占用
        maxPositionValue := math.max(maxPositionValue, positionValue)  // 更新最大资金占用

    // 计算平均资金占用（基于有持仓的时间）
    avgPositionValue = positionBarCount > 0 ? sumPositionValue / positionBarCount : 0

    // 备用计算方法：使用初始资金作为基准
    avgCapitalUsage = avgPositionValue > 0 ? avgPositionValue : strategy.equity

    // 6. 计算总收益率（基于资金占用）
    // 总收益 = 已平仓利润 + 未平仓盈利
    totalProfit = totalClosedProfit + openProfit

    // 使用多种方法计算收益率
    R_avgPosition = avgPositionValue > 0 ? totalProfit / avgPositionValue : 0  // 基于平均持仓资金
    R_equity = strategy.equity > 0 ? totalProfit / strategy.initial_capital : 0  // 基于初始资金
    R_maxPosition = maxPositionValue > 0 ? totalProfit / maxPositionValue : 0  // 基于最大持仓资金

    // 选择最合适的收益率计算方法
    R = avgPositionValue > 0 ? R_avgPosition : R_equity

    // 7. 计算年化收益率
    annualizedReturn = T > 0 ? math.pow(1 + R_avgPosition, 365 / T) - 1 : 0     // 基于平均持仓资金的年化收益率：将持仓期间的收益率按复利方式年化
    annualizedReturn_equity = T > 0 ? math.pow(1 + R_equity, 365 / T) - 1 : 0    // 基于初始资金的年化收益率：将基于初始资金的收益率按复利方式年化
    annualizedReturn_maxPosition = T > 0 ? math.pow(1 + R_maxPosition, 365 / T) - 1 : 0  // 基于最大持仓资金的年化收益率

    // 8. 输出详细的策略统计信息（可选）
    if enableLog and barstate.islastconfirmedhistory 
        log.info("=== 策略统计详情 ===")
        log.info("初始资金: {0}", str.tostring(strategy.initial_capital, "#.##"))
        log.info("当前权益: {0}", str.tostring(strategy.equity, "#.##"))
        log.info("当前持仓大小: {0}", str.tostring(strategy.position_size, "#.######"))
        log.info("当前持仓价值: {0}", str.tostring(positionValue, "#.##"))
        log.info("=== 资金占用统计 ===")
        log.info("有持仓的K线数: {0}", str.tostring(positionBarCount))
        log.info("资金占用（平均）: {0}", str.tostring(avgPositionValue, "#.##"))
        log.info("资金占用（最大）: {0}", str.tostring(maxPositionValue, "#.##"))
        log.info("=== 收益统计 ===")
        log.info("已平仓利润: {0}", str.tostring(totalClosedProfit, "#.##"))
        log.info("未平仓盈利: {0}", str.tostring(openProfit, "#.##"))
        log.info("总收益（含浮盈）: {0}", str.tostring(totalProfit, "#.##"))
        log.info("=== 收益率计算 ===")
        log.info("运行天数: {0}", str.tostring(T, "#.0"))
        log.info("收益率（基于平均持仓）: {0}%", str.tostring(R_avgPosition * 100, "#.##"))
        log.info("收益率（基于初始资金）: {0}%", str.tostring(R_equity * 100, "#.##"))
        log.info("收益率（基于最大持仓）: {0}%", str.tostring(R_maxPosition * 100, "#.##"))
        log.info("年化收益率（平均持仓基准）: {0}%", str.tostring(annualizedReturn * 100, "#.##"))
        log.info("年化收益率（资金基准）: {0}%", str.tostring(annualizedReturn_equity * 100, "#.##"))
        log.info("年化收益率（最大持仓基准）: {0}%", str.tostring(annualizedReturn_maxPosition * 100, "#.##"))
        log.info("=== 风险统计 ===")
        log.info("历史最大回测：{0}", str.tostring(strategy.max_drawdown))
    
    // 返回计算结果
    [annualizedReturn, annualizedReturn_equity, annualizedReturn_maxPosition, totalProfit, avgPositionValue]