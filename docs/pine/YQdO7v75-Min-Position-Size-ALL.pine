// Public API
// type_: "contract" | "notional" (aka "quote")
// broker_: "binance" | "bybit"
normalizeType(t) =>
    tl = str.lower(t)
    tl == "contracts" or tl == "qty" or tl == "quantity" ? "contract" :
     tl == "quote" or tl == "value" or tl == "notion"      ? "notional" :
     tl

normalizeBroker(b) =>
    str.lower(b)

// --- public API (pure return, no :=)
export getMinPositionSize(string symbol_,string type_,string broker_) =>
    s  = symbol_                       
    t  = normalizeType(type_)
    br = normalizeBroker(broker_)
    br == "binance" ? _getMin_Binance(s, t) :
     br == "bybit"   ? _getMin_Bybit(s, t)   :
     na
