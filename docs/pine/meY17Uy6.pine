//@version=5
library("MonthlyPnLTable", overlay=true)

// Function to calculate and store monthly P&L
// currentClose: The closing price of the current bar (e.g., 'close')
// initialOpenPrice: The opening price of the very first bar of the dataset,
//                   which should be initialized and passed from the main script.
// monthsToDisplay: The number of months to keep in the P&L history.
export monthlyPnL(float currentClose, float initialOpenPrice, int monthsToDisplay) =>
    var array<float> pnls = array.new_float(0)
    var array<int> pnlMonths = array.new_int(0)
    var array<int> pnlYears = array.new_int(0)
    var float prevMonthClose = na
    var bool isFirstMonthProcessed = false

    // Detect new month
    bool newMonth = month != month[1]

    if newMonth
        float currentPnl = 0.0
        int _year = year[1]
        int _month = month[1]
        bool pnlCalculatedThisBar = false

        if not isFirstMonthProcessed
            // Use initialOpenPrice passed from the main script for the very first P&L calculation
            if not na(initialOpenPrice) and not na(currentClose[1])
                currentPnl := initialOpenPrice == 0 ? 0.0 : ((currentClose[1] - initialOpenPrice) / initialOpenPrice) * 100
                prevMonthClose := currentClose[1]
                isFirstMonthProcessed := true
                pnlCalculatedThisBar := true
            else if not na(currentClose[1]) 
                // If initialOpenPrice is NA for some reason, just set prevMonthClose
                prevMonthClose := currentClose[1]
        else 
            if not na(prevMonthClose) and not na(currentClose[1])
                currentPnl := prevMonthClose == 0 ? 0.0 : ((currentClose[1] - prevMonthClose) / prevMonthClose) * 100
                prevMonthClose := currentClose[1]
                pnlCalculatedThisBar := true
            else if not na(currentClose[1]) 
                prevMonthClose := currentClose[1]

        if pnlCalculatedThisBar
            array.unshift(pnls, currentPnl)
            array.unshift(pnlMonths, _month)
            array.unshift(pnlYears, _year)

            while array.size(pnls) > monthsToDisplay
                array.pop(pnls)
                array.pop(pnlMonths)
                array.pop(pnlYears)
    
    [pnls, pnlMonths, pnlYears] // Return the arrays

// Function to display the P&L table
export displayPnLTable(array<float> pnls, array<int> pnlMonths, array<int> pnlYears, 
                       string textSizeOption, color labelColor) =>
    
    var table pnlDisplayTable = na

    if barstate.islast and timeframe.in_seconds(timeframe.period) <= 86400 // display restriction for daily or intraday timeframes
        if not na(pnlDisplayTable) 
            table.delete(pnlDisplayTable)
        
        int numDataRows = array.size(pnls)

        // Cumulative P&L Calculation
        float cumulativePnl = 0.0
        if array.size(pnls) > 0
            for i = 0 to array.size(pnls) - 1
                cumulativePnl += array.get(pnls, i)

        // Adjusted tableRows calculation
        int tableRows = numDataRows > 0 ? numDataRows + 2 : 2 
        
        pnlDisplayTable := table.new(position.bottom_right, 2, tableRows, border_width=1)

        // Determine actual text size
        string actualTextSize = textSizeOption == "Tiny" ? size.tiny :
                               textSizeOption == "Small" ? size.small :
                               textSizeOption == "Normal" ? size.normal :
                               textSizeOption == "Large" ? size.large :
                               textSizeOption == "Huge" ? size.huge : size.normal

        // Cumulative P&L Row (Index 0)
        table.cell(pnlDisplayTable, 0, 0, "Total P&L", text_size=actualTextSize, text_color=labelColor, bgcolor=color.new(color.gray, 70))
        table.cell(pnlDisplayTable, 1, 0, str.tostring(cumulativePnl, "0.00") + "%", text_size=actualTextSize, text_color=labelColor, bgcolor=color.new(color.gray, 70))

        // Header Row (Index 1)
        table.cell(pnlDisplayTable, 0, 1, "Month", text_size=actualTextSize, text_color=labelColor, bgcolor=color.new(color.gray, 50))
        table.cell(pnlDisplayTable, 1, 1, "P&L", text_size=actualTextSize, text_color=labelColor, bgcolor=color.new(color.gray, 50))

        // Monthly Data Rows (Starting from Index 2)
        if numDataRows > 0
            for i = 0 to numDataRows - 1
                int yearVal = array.get(pnlYears, i)
                int monthVal = array.get(pnlMonths, i)
                float pnlVal = array.get(pnls, i)

                string periodStr = str.tostring(yearVal) + "-" + (monthVal < 10 ? "0" : "") + str.tostring(monthVal)
                string pnlStr = str.tostring(pnlVal, "0.00") + "%" 

                table.cell(pnlDisplayTable, 0, i + 2, periodStr, text_size=actualTextSize, text_color=labelColor)
                table.cell(pnlDisplayTable, 1, i + 2, pnlStr, text_size=actualTextSize, text_color=labelColor)