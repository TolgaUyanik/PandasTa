//@version=6
strategy("Options Confluence – Backtest Strategy", overlay=true)

// ==========================
// 🔹 INPUTS
// ==========================
emaLen      = input.int(13, "EMA Length")
ceLen       = input.int(22, "Chandelier ATR Period")
ceMult      = input.float(3.0, "Chandelier Multiplier")
bosLookback = input.int(10, "BOS Lookback")

// ==========================
// 🔹 EMA
// ==========================
ema13 = ta.ema(close, emaLen)
plot(ema13, color=color.blue, title="EMA 13")

// ==========================
// 🔹 VWAP (Corrected)
// ==========================
vwapValue = ta.vwap
plot(vwapValue, color=color.orange, title="VWAP")

// ==========================
// 🔹 CHANDELIER EXIT
// ==========================
atr = ceMult * ta.atr(ceLen)

longStop  = ta.highest(high, ceLen) - atr
shortStop = ta.lowest(low, ceLen) + atr

var int ceDir = 1
ceDir := close > shortStop[1] ? 1 :
         close < longStop[1] ? -1 :
         ceDir

// ==========================
// 🔹 BOS
// ==========================
highestHigh = ta.highest(high[1], bosLookback)
lowestLow   = ta.lowest(low[1], bosLookback)

bosBull = close > highestHigh
bosBear = close < lowestLow

// ==========================
// 🔹 ENTRY CONDITIONS
// ==========================
callEntry =
     strategy.position_size == 0 and
     close > ema13 and
     close > vwapValue and
     ceDir == 1 and
     bosBull

putEntry =
     strategy.position_size == 0 and
     close < ema13 and
     close < vwapValue and
     ceDir == -1 and
     bosBear

// ==========================
// 🔹 EXIT CONDITIONS
// ==========================
callExit =
     strategy.position_size > 0 and
     (close < ema13 or ceDir == -1)

putExit =
     strategy.position_size < 0 and
     (close > ema13 or ceDir == 1)

// ==========================
// 🔹 EXECUTION
// ==========================
if callEntry
    strategy.entry("CALL", strategy.long)

if putEntry
    strategy.entry("PUT", strategy.short)

if callExit
    strategy.close("CALL")

if putExit
    strategy.close("PUT")

// ==========================
// 🔹 VISUAL SIGNALS
// ==========================
plotshape(callEntry, location=location.belowbar,
     color=color.lime, style=shape.labelup, text="CALL")

plotshape(putEntry, location=location.abovebar,
     color=color.red, style=shape.labeldown, text="PUT")

plotshape(callExit, location=location.abovebar,
     color=color.green, style=shape.labeldown, text="EXIT")

plotshape(putExit, location=location.belowbar,
     color=color.maroon, style=shape.labelup, text="EXIT")