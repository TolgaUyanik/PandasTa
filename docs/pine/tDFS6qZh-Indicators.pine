//@version=6
library("Indicators")

// Indicators Library
// ==================
// 1. cmf (Chaikin's money flow)
// 2. cmma (close minus moving average)
// 3. macd (moving average convergence/divergence)
// 4. stochK (stochastic %K)
// 5. williamsR (William's %R)
// 6. volatility_risk

//======================
// Imports
//======================
import HuntGatherTrade/MathHelpers/2 as MH

//======================
// Indicators
//======================

//===== Chaikin's Money Flow (cmf) 
// @function Calculates the Chaikin's Money Flow.
// @param simple int lookback The lookback period for smoothing. Default is 1.
// @param simple int n_to_smooth The volume smoothing period. Default is 50.
// @returns float The Money Flow value.
export cmf(simple int lookback=1, simple int n_to_smooth=50) =>
    ii         = high != low ? 100 * ((2 * close - high - low) / (high - low)) * volume : 0
    ii_smoothed= ta.sma(ii, lookback)
    v_smoothed = n_to_smooth > 1 ? ta.ema(volume, n_to_smooth) : ta.sma(volume, lookback)
    (v_smoothed != 0) ? (ii_smoothed / v_smoothed) : 0

//===== Close Minus Moving Average (cmma)
// @function Calculates the CMMA (Close Minus Moving Average) indicator.
// @param simple int lookback The moving average lookback period for log(close). Default is 1.
// @param simple int atr_length The ATR length for normalization. Default is 252.
// @returns float The CMMA value.
export cmma(simple int lookback=1, simple int atr_length=252) =>
    log_close = math.log(close)
    log_ma    = ta.sma(log_close, lookback)[1]
    atr_value = MH.calculateATR(atr_length, true)
    denom     = atr_value > 0.0 ? atr_value * math.sqrt(lookback + 1.0) : na
    raw_cmma  = (log_close - log_ma) / (denom + 1e-15)
    100.0 * MH.CDF(raw_cmma) - 50.0

//===== Moving Average Convergence/Divergence (macd)
// @function Calculates the normalized and scaled MACD.
// @param series float c The input price series.
// @param simple int fast_length The length of the fast EMA. Default is 12.
// @param simple int slow_length The length of the slow EMA. Default is 26.
// @param simple int n_to_smooth The length of the smoothing EMA for the signal line. Default is 9.
// @returns [float, float, float] A tuple containing [macd_n, macd_s, macd_diff].
export macd(simple int fast_length=12, simple int slow_length=26, simple int n_to_smooth=9) =>
    atr252      = MH.calculateATR(252, false)
    long_sum    = ta.ema(close, slow_length)
    short_sum   = ta.ema(close, fast_length)
    diff_val    = (0.5 * (slow_length - 1.0)) - (0.5 * (fast_length - 1.0))
    denom       = math.sqrt(math.abs(diff_val)) * atr252
    first_scale = (short_sum - long_sum) / (denom + 1e-15)
    macd_n      = 100 * MH.CDF(first_scale) - 50
    macd_s      = ta.ema(macd_n, n_to_smooth)
    macd_diff   = macd_n - macd_s
    [macd_n, macd_s, macd_diff]

//===== stochastic %K
// @function Calculates a simplified Stochastic Oscillator.
// Uses: 100 * ta.sma((close - lowest_low) / (highest_high - lowest_low), n_to_smooth)
// @param simple int length The lookback length. Default is 14.
// @param simple int n_to_smooth The smoothing period. Default is 3.
// @returns float The Stochastic %K value.
export stochK(simple int length=10, simple int n_to_smooth=6) =>
    lowest_low   = ta.lowest(low, length)
    highest_high = ta.highest(high, length)
    raw          = (close - lowest_low) / (highest_high - lowest_low)
    100.0 * ta.sma(raw, n_to_smooth)

//===== williams_r
// @function Calculates the Williams %R using the stochK function.
// Uses: -1 * (100 - stoch(length, 1))
// @param simple int length The lookback length. Default is 14.
// @returns float The Williams %R value.
export williamsR(simple int length=14) =>
    -1 * (100 - stochK(length, 1))

//===== volatility_risk
// @function Calculates a volatility-based risk measure.
// @param simple int atr_length The ATR lookback period. Default is 5.
// @param simple int n_to_smooth The smoothing period for both average and standard deviation. Default is 252.
// @returns [float, float] Returns [NDlr, NDlr_diff]:
//          NDlr: Normalized Daily Loss Range (ATR * pointvalue)
//          NDlr_diff: Difference between NDlr and NDlr_threshold (NDlr - (NDlr_avg + NDlr_std))
//                     A value <= 0 indicates NDlr <= NDlr_threshold
export volatility_risk(simple int atr_length=5, simple int lookback=252) =>
    atr_val        = MH.calculateATR(atr_length, false)
    NDlr           = atr_val * syminfo.pointvalue
    NDlr_avg       = ta.sma(NDlr, lookback)
    NDlr_std       = ta.stdev(NDlr, lookback)
    NDlr_threshold = NDlr_avg + NDlr_std
    NDlr - NDlr_threshold
