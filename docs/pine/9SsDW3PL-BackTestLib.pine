//@version=6

// @description Allows backtesting indicator performance. Tracks typical metrics such as won/loss, profit factor, draw down, etc. Trading View strategy library provides similar (and more comprehensive)
// functionality but only works with strategies. This libary was created to address performance tracking within indicators.
//
// Two primary outputs are generated:
// 1. Summary Table: Displays overall performance metrics for the indicator over the chart's loaded timeframe and history
// 2. Details Table: Displays a table of individual trade entries and exits. This table can grow larger than the available chart space. It does have a max number of rows supported. I haven't
//    found a way to add scroll bars or scroll bar equivalents yet.
library("BackTestLib") 

//@type backtesterData - container for backtest performance metrics
//@field tradesArray Array of strings with entries for each individual trade and its results
//@field pointsBalance Running sum of backtest points won/loss results
//@field drawDown Running sum of backtest total draw down points
//@field maxDrawDown Running sum of backtest total draw down points
//@field maxRunup Running sum of max points won over the backtest
//@field numWins Number of wins of current backtes set
//@field numLoss Number of losses of current backtes set
//@field pointsWon Running sum of points won to date
//@field pointsLost Running sum of points lost to date
//@field entrySide Current entry long/short
//@field tradeActive Indicates if a trade is currently active
//@field tradeComplete Indicates if a trade just exited (due to stop loss or take profit)
//@field entryPrice Current trade entry price
//@field entryTime Current trade entry time
//@field sl Current trade stop loss
//@field tp Current trade take profit
//@field defaultStopLoss Default trade stop loss to apply
//@field defaultTakeProfit Default trade take profit to apply
//@field useTrailingStop Trailing stop enabled
//@field useTrailingStopToBreakEven When trailing stop active, trailing stop will increase no further than the entry price
//@field trailingStopActivation When trailing stop active, trailing will begin once price exceeds base stop loss by this number of points
//@field trailingStopOffset When trailing stop active, it will trail the max price achieved by this number of points
//@field resultType Current trade won/lost
//@field exitPrice Current trade exit price
//@field resultPoints Current trade points won/lost
//@field summaryTable Table to deisplay summary info
//@field tradesTable Table to display per trade info
export type backtesterData
    array<string> tradesArray
    varip float pointsBalance = 0.0
    varip float drawDown = 0.0
    varip float maxDrawDown = 0.0
    varip float maxRunup = 0.0
    varip int numWins = 0
    varip int numLoss = 0
    varip float pointsWon = 0.0
    varip float pointsLost = 0.0

    varip string entrySide = ""
    varip bool tradeActive = false
    varip bool tradeComplete = false
    varip float entryPrice = 0.0
    varip int entryTime = 0
    varip float sl = 0
    varip float tp = 0
    varip float defaultStopLoss = 0.0
    varip float defaultTakeProfit = 0.0
    varip bool useTrailingStop = false
    varip bool useTrailingStopToBreakEven = false
    varip int trailingStopActivation = 0
    varip int trailingStopOffset = 0

    varip string resultType = ""
    varip float exitPrice = na
    varip float resultPoints = 0.0

    table summaryTable = na
    table tradesTable = na


//@function f_init Initialize the backtest data type. Called prior to using the backtester functions
//@param data backtesterData to initialize
//@param _defaultStopLoss Default trade stop loss to apply
//@param _defaultTakeProfit Default trade take profit to apply
//@param _useTrailingStop Trailing stop enabled
//@param _useTraingStopToBreakEven When trailing stop active, trailing stop will increase no further than the entry price
//@param _trailingStopActivation When trailing stop active, trailing will begin once price exceeds base stop loss by this number of points
//@param _trailingStopOffset When trailing stop active, it will trail the max price achieved by this number of points
//@returns Initialized data set
export f_init(backtesterData data, float _defaultStopLoss, float _defaultTakeProfit, bool _useTrailingStop, bool _useTraingStopToBreakEven, int _trailingStopActivation, int _trailingStopOffset) =>
    data.pointsBalance := 0.0
    data.tradesArray := array.new<string>()
    data.drawDown := 0.0
    data.maxDrawDown := 0.0
    data.maxRunup := 0.0
    data.numWins := 0
    data.numLoss := 0
    data.pointsWon := 0.0
    data.pointsLost := 0.0

    data.entrySide := ""
    data.tradeActive := false
    data.tradeComplete := false
    data.entryPrice := 0.0
    data.entryTime := 0
    data.sl := 0
    data.tp := 0
    data.defaultStopLoss := _defaultStopLoss
    data.defaultTakeProfit := _defaultTakeProfit
    data.useTrailingStop := _useTrailingStop
    data.useTrailingStopToBreakEven := _useTraingStopToBreakEven
    data.trailingStopActivation := _trailingStopActivation
    data.trailingStopOffset := _trailingStopOffset

    data.resultType := ""
    data.exitPrice := na
    data.resultPoints := 0.0
    data

//@function f_buildResultStr Helper function to construct a string of resutling data for exit tooltip labels
export f_buildResultStr(string _resultType, float _price, float _resultPoints, int _numWins, float _pointsWon, int _numLoss, float _pointsLost) =>
    _str = _resultType + ": " + str.tostring(_resultPoints) + " pts"
    _str += "\nPrice: " + str.tostring(_price)
    _str += "\nWon: " + str.tostring(_numWins) + "   Pts: " + str.tostring(_pointsWon)
    _str += "\nLost: " + str.tostring(_numLoss) + "   Pts: " + str.tostring(_pointsLost)

//@function f_buildResultLabel Helper function to construct an Exit label for display on the chart
export f_buildResultLabel(backtesterData data, bool labelVertical, int labelOffset, bool long) =>
    yLabel = math.round(data.exitPrice)
    xLabel = bar_index - labelOffset
    labelStyle = label.style_label_right
    if labelVertical
        yLabel := math.round(long ? data.exitPrice - labelOffset : data.exitPrice + labelOffset)
        xLabel := bar_index
        labelStyle := long ? label.style_label_up : label.style_label_down

    label.new(x=xLabel, y=yLabel, text="EXIT: " + data.resultType,
         tooltip=f_buildResultStr(data.resultType, data.exitPrice, data.resultPoints, data.numWins, data.pointsWon, data.numLoss, data.pointsLost),
         color=data.resultType == "SL" ? color.new(color.red, 50) : color.new(color.green, 50),
         style = labelStyle,
         textcolor=color.white, text_formatting=text.format_bold, force_overlay=true)

//@function f_updateTrailingStop Helper function to advance the trailing stop as price action dictates
//@returns Updated stop loss for current price action
export f_updateTrailingStop(float _entryPrice, float _curPrice, float _sl, float _tp, float trailingStopActivationInput, float trailingStopOffsetInput, bool useTrailingStopToBreakEven) =>
    newStopLoss = _sl
    if _sl < _tp and _curPrice > _sl
        // Long with current price above the stop loss
        pointsToEntryPrice = _curPrice - _entryPrice
        if pointsToEntryPrice >= trailingStopActivationInput
            newStopLoss := math.max(_sl, _curPrice - trailingStopOffsetInput)
            if useTrailingStopToBreakEven
                newStopLoss := math.min(_entryPrice, newStopLoss)
    else if _sl > _tp and _curPrice < _sl
        // Short with current price below the stop loss
        pointsToEntryPrice = _entryPrice - _curPrice
        if pointsToEntryPrice >= trailingStopActivationInput
            newStopLoss := math.min(_sl, _curPrice + trailingStopOffsetInput)
            if useTrailingStopToBreakEven
                newStopLoss := math.max(_entryPrice, newStopLoss)
    newStopLoss

//@function f_enterShort Helper function to enter a short and collect data necessary for tracking the trade entry
//@returns Updated backtest data
export f_enterShort(backtesterData data, float entryPrice, float fixedStopLoss=na) =>
    data.entrySide := "Short"
    data.tradeActive := true
    data.entryPrice := entryPrice
    data.entryTime := time
    data.tp := entryPrice - data.defaultTakeProfit
    data.sl := not na(fixedStopLoss) ? fixedStopLoss : entryPrice + data.defaultStopLoss
    data

//@function f_enterLong Helper function to enter a long and collect data necessary for tracking the trade entry
//@returns Updated backtest data
export f_enterLong(backtesterData data, float entryPrice, float fixedStopLoss=na) =>
    data.entrySide := "Long"
    data.tradeActive := true
    data.entryPrice := entryPrice
    data.entryTime := time
    data.tp := entryPrice + data.defaultTakeProfit
    data.sl := not na(fixedStopLoss) ? fixedStopLoss : entryPrice - data.defaultStopLoss
    data

//@function f_enterLong Helper function to exit a trade and update/reset tracking data
//@returns Updated backtest data
export f_exitTrade(backtesterData data) =>
    // Complete the trade exit cleanup
    data.tradeActive := false
    data.tradeComplete := false
    data.entrySide := ""
    data.entryPrice := 0.0
    data.entryTime := 0
    data.sl := 0
    data.tp := 0
    data

//@function f_updateStatsOnTradeExit Helper function to record the results of the current trade exit
//@returns Updated backtest data
f_updateStatsOnTradeExit(backtesterData data) =>
    longTrade = data.entrySide == "Long"
    
    data.resultPoints := longTrade ? data.exitPrice - data.entryPrice : data.entryPrice - data.exitPrice
    data.pointsBalance += data.resultPoints
    win = longTrade ? data.exitPrice >= data.entryPrice : data.exitPrice <= data.entryPrice
    if win
        data.numWins += 1
        data.resultType := longTrade ? (data.exitPrice >= data.tp ? "TP" : "TSL") : (data.exitPrice <= data.tp ? "TP" : "TSL")
        data.pointsWon += data.resultPoints
        if data.pointsBalance > data.maxRunup
            data.maxRunup := data.pointsBalance
    else
        data.numLoss += 1
        data.resultType := "SL"
        data.pointsLost -= data.resultPoints
        data.drawDown := data.maxRunup - data.pointsBalance
        if data.drawDown > data.maxDrawDown
            data.maxDrawDown := data.drawDown

        // Update table of results
    data.tradesArray := na(data.tradesArray) ? array.new<string>() : data.tradesArray
    data.tradesArray.unshift(str.tostring(data.exitPrice))
    data.tradesArray.unshift(str.tostring(data.entryPrice))
    data.tradesArray.unshift(str.format_time(data.entryTime, "HH:mm", "America/New_York"))
    data.tradesArray.unshift(str.format_time(data.entryTime, "yyyy-MM-dd", "America/New_York"))
    data.tradesArray.unshift(str.tostring(data.resultPoints))
    data.tradesArray.unshift(data.resultType)
    data.tradesArray.unshift(str.tostring(data.numWins + data.numLoss))
    data

//@function f_checkTradeConditionForExit Helper function to determine if provided condition indicates an exit
//@param condition When true trade will exit
//@param enableRealTime When true trade will evaluate if barstate is relatime or barstate is confirmed; otherwise just checks on is confirmed
//@returns Updated backtest data
export f_checkTradeConditionForExit(backtesterData data, bool condition, float curPrice, bool enableRealTime=false) =>
    longTrade = data.entrySide == "Long"
    dataCopy = data // prevent function args can't be mutable error

    if condition and data.tradeActive and not data.tradeComplete and ((enableRealTime and barstate.isrealtime) or barstate.isconfirmed)
        data.tradeComplete := true
        data.exitPrice := curPrice
        dataCopy := f_updateStatsOnTradeExit(data)
    dataCopy

//@function f_checkTrade Helper function to determine if current price action dictates stop loss or take profit exit
//@param enableRealTime When true trade will evaluate if barstate is relatime or barstate is confirmed; otherwise just checks on is confirmed
//@returns Updated backtest data
export f_checkTrade(backtesterData data, float curPrice, float curLow, float curHigh, bool enableRealTime=false) =>
    longTrade = data.entrySide == "Long"
    dataCopy = data // prevent function args can't be mutable error

    if data.tradeActive and not data.tradeComplete and ((enableRealTime and barstate.isrealtime) or barstate.isconfirmed)
        _low = enableRealTime and barstate.isrealtime ? curPrice : curLow
        _high = enableRealTime and barstate.isrealtime ? curPrice : curHigh

        if longTrade ? _low <= data.sl : _high >= data.sl
            data.exitPrice := data.sl
            data.tradeComplete := true
            dataCopy := f_updateStatsOnTradeExit(data)
        else if longTrade ? _high >= data.tp : _low <= data.tp
            data.exitPrice := data.tp
            data.tradeComplete := true
            dataCopy := f_updateStatsOnTradeExit(data)
        else if data.useTrailingStop
            // TODO should curPrice be longTrade ? _high : _low
            dataCopy.sl := f_updateTrailingStop(data.entryPrice, curPrice, data.sl, data.tp, data.trailingStopActivation, data.trailingStopOffset, data.useTrailingStopToBreakEven)
    dataCopy

//@function f_fillCell Helper function to construct result table cells
//@returns Table cell
export f_fillCell(table _table, int _column, int _row, string _title, string _value, color _bgcolor, color _txtcolor, string _text_size) =>
    _cellText = _title == "" ? _value : _title + "\n" + _value
    table.cell(_table, _column, _row, _cellText, bgcolor=_bgcolor, text_color=_txtcolor, text_size=_text_size)

//@function f_fillCell Helper function to populate result table
//@returns Updated backtest data
export f_prepareStatsTable(backtesterData data, bool drawTesterSummary, bool drawTesterDetails, string summaryTableTextSize, string detailsTableTextSize, bool displayRowZero=true, string summaryTableLocation, string detailsTableLocation) =>
    numTrades = data.numWins + data.numLoss
    data.summaryTable := na(data.summaryTable) ? table.new(summaryTableLocation, 5, 4, border_width=1, force_overlay=true) : data.summaryTable

    numTradeTableCols = 7
    maxRowsInTradeTable = 20
    data.tradesTable := na(data.tradesTable) ? table.new(detailsTableLocation, numTradeTableCols, maxRowsInTradeTable, border_width=1, force_overlay=true) : data.tradesTable

    // Draw stats table
    if barstate.islast
        tableBgColor = color.new(color.black, 70)
        if drawTesterSummary
            totalPoints = data.pointsWon - data.pointsLost
            profitFactor = data.pointsWon / ((data.pointsLost >= 1) ? data.pointsLost : na)
            gainToPainRatio = data.pointsBalance / ((data.pointsLost >= 1) ? data.pointsLost : na)
            row = 0
            if displayRowZero
                f_fillCell(data.summaryTable, 0, row, "Stop Loss", str.tostring(data.defaultStopLoss), tableBgColor, color.gray, summaryTableTextSize)
                f_fillCell(data.summaryTable, 1, row, "Take Profit", str.tostring(data.defaultTakeProfit), tableBgColor, color.gray, summaryTableTextSize)
                f_fillCell(data.summaryTable, 2, row, "TS Act", data.useTrailingStop ? str.tostring(data.trailingStopActivation) : "-", tableBgColor, color.gray, summaryTableTextSize)
                f_fillCell(data.summaryTable, 3, row, "TS Offset", data.useTrailingStop ? str.tostring(data.trailingStopOffset) : "-", tableBgColor, color.gray, summaryTableTextSize)
                f_fillCell(data.summaryTable, 4, row, data.useTrailingStopToBreakEven ? "TS Break" : "", data.useTrailingStopToBreakEven ? "Even Only" : "", tableBgColor, color.gray, summaryTableTextSize)
                row += 1

            f_fillCell(data.summaryTable, 0, row, "Num Won", str.tostring(data.numWins), tableBgColor, color.white, summaryTableTextSize)
            f_fillCell(data.summaryTable, 1, row, "Pts Won", str.tostring(data.pointsWon, "#.#"), tableBgColor, color.white, summaryTableTextSize)
            f_fillCell(data.summaryTable, 2, row, "Win Rate", str.tostring(data.numWins / ((numTrades >= 1) ? numTrades : na) * 100, "#.#") + "%", tableBgColor, color.white, summaryTableTextSize)
            f_fillCell(data.summaryTable, 3, row, "PF", str.tostring(profitFactor, "#.##"), tableBgColor, color.white, summaryTableTextSize)
            f_fillCell(data.summaryTable, 4, row, "Max Runup", str.tostring(data.maxRunup, "#.#") + " Pts", tableBgColor, color.white, summaryTableTextSize)
            row += 1

            f_fillCell(data.summaryTable, 0, row, "Num Lost", str.tostring(data.numLoss), tableBgColor, color.white, summaryTableTextSize)
            f_fillCell(data.summaryTable, 1, row, "Pts Lost", str.tostring(data.pointsLost, "#.#"), tableBgColor, color.white, summaryTableTextSize)
            f_fillCell(data.summaryTable, 2, row, "Total", (data.pointsBalance > 0 ? "+" : "") + str.tostring(data.pointsBalance) + " Pts", data.pointsBalance > 0 ? color.new(color.green, 50) : color.new(color.red, 50), color.white, summaryTableTextSize)
            f_fillCell(data.summaryTable, 3, row, "GtP", str.tostring(gainToPainRatio, "#.##"), tableBgColor, color.white, summaryTableTextSize)
            f_fillCell(data.summaryTable, 4, row, "Max DD", str.tostring(data.maxDrawDown, "#.#") + " Pts", tableBgColor, color.white, summaryTableTextSize)

        if drawTesterDetails
            f_fillCell(data.tradesTable, 0, 0, "", "ID", tableBgColor, color.white, detailsTableTextSize)
            f_fillCell(data.tradesTable, 1, 0, "", "Type", tableBgColor, color.white, detailsTableTextSize)
            f_fillCell(data.tradesTable, 2, 0, "", "Result", tableBgColor, color.white, detailsTableTextSize)
            f_fillCell(data.tradesTable, 3, 0, "", "Date", tableBgColor, color.white, detailsTableTextSize)
            f_fillCell(data.tradesTable, 4, 0, "", "Time", tableBgColor, color.white, detailsTableTextSize)
            f_fillCell(data.tradesTable, 5, 0, "", "Entry", tableBgColor, color.white, detailsTableTextSize)
            data.tradesArray := na(data.tradesArray) ? array.new<string>() : data.tradesArray
            numTradesArrayEntries = array.size(data.tradesArray)
            if not na(data.tradesArray) and numTradesArrayEntries > numTradeTableCols
                tableRow = 0
                for i = 0 to numTradesArrayEntries - 1 by numTradeTableCols
                    if tableRow < maxRowsInTradeTable - 1
                        id = str.tostring(array.get(data.tradesArray, i + 0))
                        exitType = str.tostring(array.get(data.tradesArray, i + 1))
                        result = str.tostring(array.get(data.tradesArray, i + 2))
                        enterDate = str.tostring(array.get(data.tradesArray, i + 3))
                        enterTime = str.tostring(array.get(data.tradesArray, i + 4))
                        enter = str.tostring(array.get(data.tradesArray, i + 5))
                        exit = str.tostring(array.get(data.tradesArray, i + 6))
                        textColor = str.tonumber(result) >= 0 ? color.green : color.red
                        f_fillCell(data.tradesTable, 0, tableRow, "", id, tableBgColor, textColor, detailsTableTextSize)
                        f_fillCell(data.tradesTable, 1, tableRow, "", exitType, tableBgColor, textColor, detailsTableTextSize)
                        f_fillCell(data.tradesTable, 2, tableRow, "", result, tableBgColor, textColor, detailsTableTextSize)
                        f_fillCell(data.tradesTable, 3, tableRow, "", enterDate, tableBgColor, textColor, detailsTableTextSize)
                        f_fillCell(data.tradesTable, 4, tableRow, "", enterTime, tableBgColor, textColor, detailsTableTextSize)
                        f_fillCell(data.tradesTable, 5, tableRow, "", enter, tableBgColor, textColor, detailsTableTextSize)
                        tableRow += 1
    data