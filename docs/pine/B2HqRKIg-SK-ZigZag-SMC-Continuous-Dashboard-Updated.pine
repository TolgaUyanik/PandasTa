//@version=6
indicator("SK ZigZag SMC Continuous Dashboard", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// --- اختيار اللغة ---
lang = input.string("العربية", title="Language | اللغة", options=["العربية", "English"])
is_ar = lang == "العربية"

// ==========================================================================================
// 1. إعدادات نظام SK ZigZag Fib SMC
// ==========================================================================================
length = input.int(10, title="ZigZag Length | طول الزجزاج")

// === قائمة كل التايم فريمز المتاحة للاختيار ===
var string G_TF = "Timeframes | الفريمات"
show_1m  = input.bool(false, title="1m | دقيقة", group=G_TF)
show_5m  = input.bool(false, title="5m | 5 دقائق", group=G_TF)
show_15m = input.bool(false, title="15m | 15 دقيقة", group=G_TF)
show_30m = input.bool(false, title="30m | 30 دقيقة", group=G_TF)
show_1h  = input.bool(true,  title="1h | 1 ساعة", group=G_TF)
show_4h  = input.bool(false, title="4h | 4 ساعات", group=G_TF)
show_1d  = input.bool(false, title="1d | يومي", group=G_TF)
show_1w  = input.bool(false, title="1w | أسبوعي", group=G_TF)

// === ألوان الفريمات ===
var string G_COLORS = "Colors | الألوان"
color_1m  = input.color(color.new(#FFF59D, 0), title="Color 1m | لون 1 دقيقة", group=G_COLORS)
color_5m  = input.color(color.new(#84FFFF, 0), title="Color 5m | لون 5 دقائق", group=G_COLORS)
color_15m = input.color(color.new(#FF8A80, 0), title="Color 15m | لون 15 دقيقة", group=G_COLORS)
color_30m = input.color(color.new(#B388FF, 0), title="Color 30m | لون 30 دقيقة", group=G_COLORS)
color_1h  = input.color(color.new(#FFD180, 0), title="Color 1h | لون 1 ساعة", group=G_COLORS)
color_4h  = input.color(color.new(#CCFF90, 0), title="Color 4h | لون 4 ساعات", group=G_COLORS)
color_1d  = input.color(color.new(#8C9EFF, 0), title="Color 1d | لون يومي", group=G_COLORS)
color_1w  = input.color(color.new(#F8BBD0, 0), title="Color 1w | لون أسبوعي", group=G_COLORS)

// === شيك بوكس لاختيار نسب الفيبوناتشي ===
var string G_FIB = "Fibonacci Levels | الفيبوناتشي"
use_500 = input.bool(true, title="Level 0.500 | مستوى", group=G_FIB)
use_559 = input.bool(true, title="Level 0.559 | مستوى", group=G_FIB)
use_618 = input.bool(true, title="Level 0.618 | مستوى", group=G_FIB)
use_667 = input.bool(true, title="Level 0.667 | مستوى", group=G_FIB)

// --- نصوص الشارت המترجمة ---
txt_wait_buy = is_ar ? "⏳ انتظار الاختبار ⏳\n🟢 منطقة شراء 🟢\n(0.500 - 0.667)\n🎯 الهدف: C" : "⏳ WAITING FOR TEST ⏳\n🟢 BC BUY ZONE 🟢\n(0.500 - 0.667)\n🎯 Target: C"
txt_wait_sell = is_ar ? "⏳ انتظار الاختبار ⏳\n🔴 منطقة بيع 🔴\n(0.500 - 0.667)\n🎯 الهدف: C" : "⏳ WAITING FOR TEST ⏳\n🔴 BC SELL ZONE 🔴\n(0.500 - 0.667)\n🎯 Target: C"
txt_act_buy = is_ar ? "✨ تفعيل الشراء ✨\n(0.500 - 0.667)\n🚀 الهدف: C" : "✨ ACTIVATED BUY ✨\n(0.500 - 0.667)\n🚀 Target: C"
txt_act_sell = is_ar ? "✨ تفعيل البيع ✨\n(0.500 - 0.667)\n🚀 الهدف: C" : "✨ ACTIVATED SELL ✨\n(0.500 - 0.667)\n🚀 Target: C"

type WaveSequence
    string tf
    int seq_type        
    float p0
    float pA
    float pB
    int bB
    float t138
    float t1618
    float t1809
    float t200
    bool is_c_drawn
    color tf_color
    label lbl0
    label lblA
    label lblB
    line ln0A
    line lnAB
    line lnT1
    line lnT2
    line lnT3
    line lnT4
    label lblT1
    label lblT2
    label lblT3
    label lblT4
    bool is_a_broken
    float extreme_p
    int extreme_b
    box bc_zone
    bool is_bc_touched

var WaveSequence[] active_sequences = array.new<WaveSequence>(0)

get_zz_data() =>
    ph = ta.pivothigh(high, length, length)
    pl = ta.pivotlow(low, length, length)
    [ph, pl]

[ph_1m, pl_1m]   = request.security(syminfo.tickerid, "1", get_zz_data(), barmerge.gaps_on, barmerge.lookahead_off)
[ph_5m, pl_5m]   = request.security(syminfo.tickerid, "5", get_zz_data(), barmerge.gaps_on, barmerge.lookahead_off)
[ph_15m, pl_15m] = request.security(syminfo.tickerid, "15", get_zz_data(), barmerge.gaps_on, barmerge.lookahead_off)
[ph_30m, pl_30m] = request.security(syminfo.tickerid, "30", get_zz_data(), barmerge.gaps_on, barmerge.lookahead_off)
[ph_1h, pl_1h]   = request.security(syminfo.tickerid, "60", get_zz_data(), barmerge.gaps_on, barmerge.lookahead_off)
[ph_4h, pl_4h]   = request.security(syminfo.tickerid, "240", get_zz_data(), barmerge.gaps_on, barmerge.lookahead_off)
[ph_1d, pl_1d]   = request.security(syminfo.tickerid, "D", get_zz_data(), barmerge.gaps_on, barmerge.lookahead_off)
[ph_1w, pl_1w]   = request.security(syminfo.tickerid, "W", get_zz_data(), barmerge.gaps_on, barmerge.lookahead_off)

check_retracement(float p0, float pA, float pB, int s_type, float wave_0A, bool u500, bool u559, bool u618, bool u667) =>
    is_valid = false
    actual_ratio = wave_0A != 0 ? (pA - pB) / wave_0A : 0.0
    if (s_type == 1 and pB > p0) or (s_type == -1 and pB < p0)
        if u500 and actual_ratio >= 0.500 and actual_ratio < 0.559
            is_valid := true
        if u559 and actual_ratio >= 0.559 and actual_ratio < 0.618
            is_valid := true
        if u618 and actual_ratio >= 0.618 and actual_ratio < 0.667
            is_valid := true
        if u667 and actual_ratio >= 0.667 and actual_ratio <= 1.000
            is_valid := true
    is_valid

process_tf(string tf_name, float ph_val, float pl_val, float[] p_arr, int[] b_arr, int[] t_arr, int last_b, color main_color) =>
    int returned_last = last_b
    if not na(ph_val)
        array.unshift(p_arr, ph_val), array.unshift(b_arr, bar_index - length), array.unshift(t_arr, 1)
    if not na(pl_val)
        array.unshift(p_arr, pl_val), array.unshift(b_arr, bar_index - length), array.unshift(t_arr, -1)
    if array.size(p_arr) > 10
        array.pop(p_arr), array.pop(b_arr), array.pop(t_arr)
        
    if array.size(p_arr) >= 3
        pB = array.get(p_arr, 0), bB = array.get(b_arr, 0), tB = array.get(t_arr, 0)
        pA = array.get(p_arr, 1), bA = array.get(b_arr, 1), tA = array.get(t_arr, 1)
        p0 = array.get(p_arr, 2), b0 = array.get(b_arr, 2), t0 = array.get(t_arr, 2)
        
        if bB != last_b
            wave_0A = pA - p0
            valid = false
            int s_type = t0 == -1 and tA == 1 and tB == -1 ? 1 : (t0 == 1 and tA == -1 and tB == 1 ? -1 : 0)
            
            if s_type != 0
                valid := check_retracement(p0, pA, pB, s_type, wave_0A, use_500, use_559, use_618, use_667)
                
            if valid
                returned_last := bB
                t1 = pB + (wave_0A * 1.38)
                t2 = pB + (wave_0A * 1.618)
                t3 = pB + (wave_0A * 1.809)
                t4 = pB + (wave_0A * 2.0)
                end_bar = bB + 30
                
                t1_text = "TP1 1.38 [" + tf_name + "] @ " + str.tostring(t1, "#.#")
                t2_text = "TP2 1.618 [" + tf_name + "] @ " + str.tostring(t2, "#.#")
                t3_text = "TP3 1.809 [" + tf_name + "] @ " + str.tostring(t3, "#.#")
                t4_text = "TP4 2.0 [" + tf_name + "] @ " + str.tostring(t4, "#.#")
                
                l0 = label.new(b0, p0, "0 [" + tf_name + "]", color=main_color, textcolor=color.black, style=s_type == 1 ? label.style_label_up : label.style_label_down, size=size.small)
                lA = label.new(bA, pA, "A [" + tf_name + "]", color=main_color, textcolor=color.black, style=s_type == 1 ? label.style_label_down : label.style_label_up, size=size.small)
                lB = label.new(bB, pB, "B [" + tf_name + "]", color=main_color, textcolor=color.black, style=s_type == 1 ? label.style_label_up : label.style_label_down, size=size.small)
                
                l0A = line.new(b0, p0, bA, pA, color=main_color, width=2)
                lAB = line.new(bA, pA, bB, pB, color=main_color, width=2)
                
                lt1 = line.new(bB, t1, end_bar, t1, color=main_color, style=line.style_dashed, width=1)
                lblt1 = label.new(end_bar, t1, t1_text, color=main_color, textcolor=color.black, style=label.style_label_left, size=size.small)
                
                lt2 = line.new(bB, t2, end_bar, t2, color=main_color, style=line.style_dotted, width=1)
                lblt2 = label.new(end_bar, t2, t2_text, color=main_color, textcolor=color.black, style=label.style_label_left, size=size.small)

                lt3 = line.new(bB, t3, end_bar, t3, color=main_color, style=line.style_dashed, width=1)
                lblt3 = label.new(end_bar, t3, t3_text, color=main_color, textcolor=color.black, style=label.style_label_left, size=size.small)

                lt4 = line.new(bB, t4, end_bar, t4, color=main_color, style=line.style_dotted, width=1)
                lblt4 = label.new(end_bar, t4, t4_text, color=main_color, textcolor=color.black, style=label.style_label_left, size=size.small)
                
                WaveSequence new_seq = WaveSequence.new(tf_name, s_type, p0, pA, pB, bB, t1, t2, t3, t4, false, main_color, l0, lA, lB, l0A, lAB, lt1, lt2, lt3, lt4, lblt1, lblt2, lblt3, lblt4, false, pA, bA, box(na), false)
                array.push(active_sequences, new_seq)
    returned_last

var float[] p_1m = array.new_float(0), var int[] b_1m = array.new_int(0), var int[] t_1m = array.new_int(0), var int last_b_1m = 0
var float[] p_5m = array.new_float(0), var int[] b_5m = array.new_int(0), var int[] t_5m = array.new_int(0), var int last_b_5m = 0
var float[] p_15m = array.new_float(0), var int[] b_15m = array.new_int(0), var int[] t_15m = array.new_int(0), var int last_b_15m = 0
var float[] p_30m = array.new_float(0), var int[] b_30m = array.new_int(0), var int[] t_30m = array.new_int(0), var int last_b_30m = 0
var float[] p_1h = array.new_float(0), var int[] b_1h = array.new_int(0), var int[] t_1h = array.new_int(0), var int last_b_1h = 0
var float[] p_4h = array.new_float(0), var int[] b_4h = array.new_int(0), var int[] t_4h = array.new_int(0), var int last_b_4h = 0
var float[] p_1d = array.new_float(0), var int[] b_1d = array.new_int(0), var int[] t_1d = array.new_int(0), var int last_b_1d = 0
var float[] p_1w = array.new_float(0), var int[] b_1w = array.new_int(0), var int[] t_1w = array.new_int(0), var int last_b_1w = 0

if show_1m
    last_b_1m  := process_tf("1m", ph_1m, pl_1m, p_1m, b_1m, t_1m, last_b_1m, color_1m) 
if show_5m
    last_b_5m  := process_tf("5m", ph_5m, pl_5m, p_5m, b_5m, t_5m, last_b_5m, color_5m) 
if show_15m
    last_b_15m := process_tf("15m", ph_15m, pl_15m, p_15m, b_15m, t_15m, last_b_15m, color_15m) 
if show_30m
    last_b_30m := process_tf("30m", ph_30m, pl_30m, p_30m, b_30m, t_30m, last_b_30m, color_30m) 
if show_1h
    last_b_1h  := process_tf("1h", ph_1h, pl_1h, p_1h, b_1h, t_1h, last_b_1h, color_1h) 
if show_4h
    last_b_4h  := process_tf("4h", ph_4h, pl_4h, p_4h, b_4h, t_4h, last_b_4h, color_4h) 
if show_1d
    last_b_1d  := process_tf("1d", ph_1d, pl_1d, p_1d, b_1d, t_1d, last_b_1d, color_1d) 
if show_1w
    last_b_1w  := process_tf("1w", ph_1w, pl_1w, p_1w, b_1w, t_1w, last_b_1w, color_1w) 

if array.size(active_sequences) > 0
    for i = array.size(active_sequences) - 1 to 0
        WaveSequence seq = array.get(active_sequences, i)
        
        bool is_invalidated = false
        if seq.seq_type == 1 and low < seq.p0
            is_invalidated := true
        else if seq.seq_type == -1 and high > seq.p0
            is_invalidated := true
            
        if is_invalidated
            label.delete(seq.lbl0), label.delete(seq.lblA), label.delete(seq.lblB)
            line.delete(seq.ln0A), label.delete(seq.lblT1), label.delete(seq.lblT2), label.delete(seq.lblT3), label.delete(seq.lblT4)
            line.delete(seq.lnAB), line.delete(seq.lnT1), line.delete(seq.lnT2), line.delete(seq.lnT3), line.delete(seq.lnT4)
            if not na(seq.bc_zone)
                box.delete(seq.bc_zone)
            array.remove(active_sequences, i)
        else if not seq.is_c_drawn
            
            if not seq.is_a_broken
                if seq.seq_type == 1 and high > seq.pA
                    seq.is_a_broken := true
                    seq.extreme_p := high
                    seq.extreme_b := bar_index
                else if seq.seq_type == -1 and low < seq.pA
                    seq.is_a_broken := true
                    seq.extreme_p := low
                    seq.extreme_b := bar_index

            if seq.is_a_broken
                if not seq.is_bc_touched
                    if seq.seq_type == 1 and high > seq.extreme_p
                        seq.extreme_p := high
                        seq.extreme_b := bar_index
                    else if seq.seq_type == -1 and low < seq.extreme_p
                        seq.extreme_p := low
                        seq.extreme_b := bar_index
                
                float w_B_Ext = seq.extreme_p - seq.pB
                float lvl_500 = seq.extreme_p - (w_B_Ext * 0.500)
                float lvl_667 = seq.extreme_p - (w_B_Ext * 0.667)
                
                float top_lvl = math.max(lvl_500, lvl_667)
                float bot_lvl = math.min(lvl_500, lvl_667)
                
                if not seq.is_bc_touched
                    if seq.seq_type == 1 and low <= top_lvl
                        seq.is_bc_touched := true
                    else if seq.seq_type == -1 and high >= bot_lvl
                        seq.is_bc_touched := true
                
                color bg_c = seq.seq_type == 1 ? color.new(color.green, 85) : color.new(color.red, 85)
                color br_c = seq.seq_type == 1 ? color.new(color.green, 50) : color.new(color.red, 50)
                color txt_c = seq.seq_type == 1 ? color.new(color.green, 0) : color.new(color.red, 0) 
                
                string txt = seq.seq_type == 1 ? txt_wait_buy : txt_wait_sell
                
                if seq.is_bc_touched
                    bg_c := seq.seq_type == 1 ? color.new(#00E5FF, 50) : color.new(#EA00FF, 50)
                    br_c := seq.seq_type == 1 ? color.new(#00E5FF, 0) : color.new(#EA00FF, 0)
                    txt_c := color.new(color.white, 0) 
                    txt := seq.seq_type == 1 ? txt_act_buy : txt_act_sell

                if na(seq.bc_zone)
                    seq.bc_zone := box.new(seq.extreme_b, top_lvl, bar_index + 5, bot_lvl, border_color=br_c, bgcolor=bg_c, text=txt, text_size=size.small, text_color=txt_c)
                else
                    box.set_top(seq.bc_zone, top_lvl)
                    box.set_bottom(seq.bc_zone, bot_lvl)
                    box.set_left(seq.bc_zone, seq.extreme_b)
                    box.set_right(seq.bc_zone, bar_index + 5)
                    box.set_bgcolor(seq.bc_zone, bg_c)
                    box.set_border_color(seq.bc_zone, br_c)
                    box.set_text(seq.bc_zone, txt)
                    box.set_text_color(seq.bc_zone, txt_c)

            if seq.seq_type == 1 and high >= seq.t138
                label.new(bar_index, high, "C [" + seq.tf + "]", color=seq.tf_color, textcolor=color.black, style=label.style_label_down, size=size.small)
                line.new(seq.bB, seq.pB, bar_index, high, color=seq.tf_color, width=2)
                seq.is_c_drawn := true
                array.remove(active_sequences, i)
            else if seq.seq_type == -1 and low <= seq.t138
                label.new(bar_index, low, "C [" + seq.tf + "]", color=seq.tf_color, textcolor=color.black, style=label.style_label_up, size=size.small)
                line.new(seq.bB, seq.pB, bar_index, low, color=seq.tf_color, width=2)
                seq.is_c_drawn := true
                array.remove(active_sequences, i)

// === نظام SMC اللحظي (واستخراج الإشارات للوحة) ===
var float last_ph = na
var int last_ph_b = na
var bool ph_broken = true 

var float last_pl = na
var int last_pl_b = na
var bool pl_broken = true

var int chart_trend = 0

// إشارات التداول الخاصة باللوحة
var bool smc_buy = false
var bool smc_sell = false
smc_buy := false
smc_sell := false

c_ph = ta.pivothigh(high, length, length)
c_pl = ta.pivotlow(low, length, length)

if not na(c_ph)
    last_ph := c_ph
    last_ph_b := bar_index - length
    ph_broken := false

if not na(c_pl)
    last_pl := c_pl
    last_pl_b := bar_index - length
    pl_broken := false

if not na(last_ph) and not ph_broken and close > last_ph
    smc_buy := true
    if chart_trend == 1 
        line.new(last_ph_b, last_ph, bar_index, last_ph, color=color.new(color.teal, 30), style=line.style_dashed, width=1)
        label.new(math.round((last_ph_b + bar_index) / 2), last_ph, "BOS", color=color.new(color.white, 100), textcolor=color.teal, style=label.style_label_down, size=size.tiny)
    else 
        chart_trend := 1
        line.new(last_ph_b, last_ph, bar_index, last_ph, color=color.teal, style=line.style_solid, width=2)
        label.new(math.round((last_ph_b + bar_index) / 2), last_ph, "CHoCH", color=color.new(color.white, 100), textcolor=color.teal, style=label.style_label_down, size=size.tiny)
    ph_broken := true 

if not na(last_pl) and not pl_broken and close < last_pl
    smc_sell := true
    if chart_trend == -1 
        line.new(last_pl_b, last_pl, bar_index, last_pl, color=color.new(color.red, 30), style=line.style_dashed, width=1)
        label.new(math.round((last_pl_b + bar_index) / 2), last_pl, "BOS", color=color.new(color.white, 100), textcolor=color.red, style=label.style_label_up, size=size.tiny)
    else 
        chart_trend := -1
        line.new(last_pl_b, last_pl, bar_index, last_pl, color=color.red, style=line.style_solid, width=2)
        label.new(math.round((last_pl_b + bar_index) / 2), last_pl, "CHoCH", color=color.new(color.white, 100), textcolor=color.red, style=label.style_label_up, size=size.tiny)
    pl_broken := true

// ==========================================================================================
// 2. إعدادات ورسم اللوحة الذكية (ميزة الدخول المستمر وتحديد مكان اللوحة)
// ==========================================================================================
var string G_DASH = "Dashboard Settings | إعدادات اللوحة"
lot_size = input.float(0.01, title="Lot Size | حجم اللوت", group=G_DASH)
rr_ratio = input.float(1.5, title="R:R Ratio | نسبة الهدف للمخاطرة", group=G_DASH)
atr_length = input.int(14, title="ATR Length | فترة الـ ATR للستوب", group=G_DASH)
dash_pos_str = input.string("top_right", title="Dashboard Position | مكان اللوحة", options=["top_right", "top_left", "top_center", "bottom_right", "bottom_left", "bottom_center", "middle_right", "middle_left"], group=G_DASH)

// --- نصوص اللوحة المترجمة ---
txt_stats_today = is_ar ? "إحصائيات اليوم" : "Today's Stats"
txt_total_signals = is_ar ? "إجمالي إشارات اليوم" : "Total Signals Today"
txt_tp_hits = is_ar ? "✔ (TP) ضربت الهدف" : "✔ TP Hits"
txt_sl_hits = is_ar ? "✘ (SL) ضربت الستوب" : "✘ SL Hits"
txt_be_hits = is_ar ? "⚖ (BE) بريك إيفن" : "⚖ Break-Even (BE)"
txt_net_profit = is_ar ? "صافي اليوم $" : "Net Profit $"
txt_win_rate = is_ar ? "نسبة الفوز:" : "Win Rate:"
txt_buys = is_ar ? "(BUY) صفقات شراء" : "Buy Trades"
txt_sells = is_ar ? "(SELL) صفقات بيع" : "Sell Trades"

txt_tp = is_ar ? "(TP) الهدف" : "Target (TP)"
txt_entry = is_ar ? "سعر الدخول" : "Entry Price"
txt_sl = is_ar ? "(SL) الستوب" : "Stop Loss (SL)"
txt_current_pnl = is_ar ? "الآن — ربح/خسارة" : "Current PnL"
txt_lot_size = is_ar ? "حجم اللوت:" : "Lot Size:"
txt_trade_status = is_ar ? "حالة الصفقة:" : "Trade Status:"

// --- نصوص حالة الصفقة ---
txt_buy_act = is_ar ? "شراء نشط !!" : "BUY ACTIVE !!"
txt_sell_act = is_ar ? "بيع نشط !!" : "SELL ACTIVE !!"
txt_wait = is_ar ? "جاري الدخول ⏳" : "WAITING ⏳"
txt_hit_tp = is_ar ? "جابت الهدف ✔️" : "HIT TP ✔️"
txt_hit_sl = is_ar ? "ضربت الستوب ❌" : "HIT SL ❌"
txt_hit_be = is_ar ? "بريك إيفن ⚖️" : "HIT BE ⚖️"

atr_val = ta.atr(atr_length)

// --- تتبع إحصائيات اليوم للوحة ومتابعة الصفقة النشطة ---
var int today_buys = 0
var int today_sells = 0
var int dash_tp_hits = 0
var int dash_sl_hits = 0
var int dash_be_hits = 0
var float dash_net_profit = 0.0

// متغيرات الذاكرة للصفقة الحالية
var int active_trade = 0 
var float saved_entry = na
var float saved_tp = na
var float saved_sl = na
var float initial_risk = na
var bool is_be_active = false
var int bars_in_trade = 0

// الحالة الحالية كنص
var string current_status_str = txt_wait

// تصفير الإحصائيات مع بداية اليوم الجديد
if time("D") != time("D")[1]
    today_buys := 0
    today_sells := 0
    dash_tp_hits := 0
    dash_sl_hits := 0
    dash_be_hits := 0
    dash_net_profit := 0.0

if active_trade != 0
    bars_in_trade += 1

// --- ميزة الدخول المستمر (Continuous Trading) ---
bool go_buy = smc_buy or (active_trade == 0 and chart_trend == 1)
bool go_sell = smc_sell or (active_trade == 0 and chart_trend == -1)

if active_trade == 0
    if go_buy
        active_trade := 1
        saved_entry := close
        
        float struct_sl = last_pl - 0.5 
        float atr_sl = close - (atr_val * 2)
        saved_sl := math.max(struct_sl, atr_sl)
        
        initial_risk := math.abs(saved_entry - saved_sl)
        
        if initial_risk < 1.0
            initial_risk := 1.0
            saved_sl := saved_entry - 1.0
            
        saved_tp := saved_entry + (initial_risk * rr_ratio)
        is_be_active := false
        today_buys += 1
        bars_in_trade := 0
        current_status_str := txt_buy_act
        
    else if go_sell
        active_trade := -1
        saved_entry := close
        
        float struct_sl = last_ph + 0.5 
        float atr_sl = close + (atr_val * 2)
        saved_sl := math.min(struct_sl, atr_sl)
        
        initial_risk := math.abs(saved_sl - saved_entry)
        
        if initial_risk < 1.0
            initial_risk := 1.0
            saved_sl := saved_entry + 1.0
            
        saved_tp := saved_entry - (initial_risk * rr_ratio)
        is_be_active := false
        today_sells += 1
        bars_in_trade := 0
        current_status_str := txt_sell_act
else
    // يتم الفحص بعد الشمعة اللي دخلنا فيها
    if bars_in_trade > 0
        if active_trade == 1
            if not is_be_active and high >= saved_entry + initial_risk
                saved_sl := saved_entry
                is_be_active := true
                
            if low <= saved_sl
                active_trade := 0
                if is_be_active
                    dash_be_hits += 1
                    current_status_str := txt_hit_be
                else
                    dash_sl_hits += 1
                    dash_net_profit -= (initial_risk * lot_size * 100)
                    current_status_str := txt_hit_sl
            else if high >= saved_tp
                active_trade := 0
                dash_tp_hits += 1
                dash_net_profit += (initial_risk * rr_ratio * lot_size * 100)
                current_status_str := txt_hit_tp
                
        else if active_trade == -1
            if not is_be_active and low <= saved_entry - initial_risk
                saved_sl := saved_entry
                is_be_active := true
                
            if high >= saved_sl
                active_trade := 0
                if is_be_active
                    dash_be_hits += 1
                    current_status_str := txt_hit_be
                else
                    dash_sl_hits += 1
                    dash_net_profit -= (initial_risk * lot_size * 100)
                    current_status_str := txt_hit_sl
            else if low <= saved_tp
                active_trade := 0
                dash_tp_hits += 1
                dash_net_profit += (initial_risk * rr_ratio * lot_size * 100)
                current_status_str := txt_hit_tp

total_signals = today_buys + today_sells
win_rate = total_signals > 0 ? (dash_tp_hits / total_signals) * 100 : 0.0

// --- حسابات الربح وقت الصفقة النشطة فقط ---
pip_value = lot_size * 100 
current_profit = active_trade == 1 ? (close - saved_entry) * pip_value : active_trade == -1 ? (saved_entry - close) * pip_value : 0.0
profit_str = active_trade != 0 ? (current_profit >= 0 ? "+$" + str.tostring(current_profit, "#.##") : "-$" + str.tostring(math.abs(current_profit), "#.##")) : "$0.00"
profit_color = active_trade == 0 ? color.gray : current_profit > 0 ? color.green : current_profit < 0 ? color.red : color.gray

// --- إعداد نصوص وألوان اللوحة ---
entry_color = active_trade == 1 ? color.green : active_trade == -1 ? color.red : color.white
display_entry = active_trade != 0 ? str.tostring(saved_entry, "#.##") : "---"
display_tp = active_trade != 0 ? str.tostring(saved_tp, "#.##") : "---"
display_sl = active_trade != 0 ? str.tostring(saved_sl, "#.##") : "---"

// تنسيق صافي اليوم عشان يبان صح (مكسب أو خسارة)
dash_net_str = dash_net_profit >= 0 ? "+$" + str.tostring(dash_net_profit, "#.##") : "-$" + str.tostring(math.abs(dash_net_profit), "#.##")
dash_net_color = dash_net_profit > 0 ? color.green : dash_net_profit < 0 ? color.red : color.white

// --- رسم اللوحة الشاملة (بمكان ديناميكي بناءً على اختيارك) ---
var table dash = table.new(dash_pos_str, 5, 14, border_color=color.new(color.gray, 80), border_width=1)

if barstate.islast
    // --- رأس اللوحة ---
    table.cell(dash, 0, 0, "♦ ZIGZAG SMC GOLD ♦", text_color=color.orange, bgcolor=color.black, text_size=size.large)
    table.merge_cells(dash, 0, 0, 4, 0)

    // ================= القسم الأيمن: إحصائيات اليوم =================
    table.cell(dash, 3, 1, txt_stats_today, text_color=color.orange, bgcolor=color.black)
    table.cell(dash, 4, 1, str.tostring(year) + "/" + str.tostring(month) + "/" + str.tostring(dayofmonth), text_color=color.yellow, bgcolor=color.black)
    
    table.cell(dash, 3, 2, txt_total_signals, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 4, 2, str.tostring(total_signals), text_color=color.white, bgcolor=color.black)
    
    table.cell(dash, 3, 3, txt_tp_hits, text_color=color.white, bgcolor=color.new(color.green, 80))
    table.cell(dash, 4, 3, str.tostring(dash_tp_hits), text_color=color.green, bgcolor=color.new(color.green, 80))
    
    table.cell(dash, 3, 4, txt_sl_hits, text_color=color.white, bgcolor=color.new(color.red, 80))
    table.cell(dash, 4, 4, str.tostring(dash_sl_hits), text_color=color.red, bgcolor=color.new(color.red, 80))
    
    table.cell(dash, 3, 5, txt_be_hits, text_color=color.white, bgcolor=color.new(color.yellow, 80))
    table.cell(dash, 4, 5, str.tostring(dash_be_hits), text_color=color.yellow, bgcolor=color.new(color.yellow, 80))
    
    table.cell(dash, 3, 8, txt_net_profit, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 4, 8, dash_net_str, text_color=dash_net_color, bgcolor=color.black, text_size=size.large)
    
    table.cell(dash, 3, 9, txt_win_rate, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 4, 9, str.tostring(win_rate, "#.#") + "%", text_color=color.green, bgcolor=color.black)
    
    table.cell(dash, 3, 10, txt_buys, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 4, 10, str.tostring(today_buys), text_color=color.green, bgcolor=color.black)
    
    table.cell(dash, 3, 11, txt_sells, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 4, 11, str.tostring(today_sells), text_color=color.red, bgcolor=color.black)

    // ================= القسم الأيسر: تفاصيل الصفقة =================
    table.cell(dash, 0, 1, syminfo.ticker + " " + str.tostring(timeframe.period), text_color=color.orange, bgcolor=color.black)
    table.cell(dash, 1, 1, str.tostring(close, "#.##"), text_color=color.green, bgcolor=color.black)
    
    table.cell(dash, 0, 2, txt_tp, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 2, display_tp, text_color=color.green, bgcolor=color.black)
    
    table.cell(dash, 0, 3, txt_entry, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 3, display_entry, text_color=entry_color, bgcolor=color.black)
    
    table.cell(dash, 0, 4, txt_sl, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 4, display_sl, text_color=color.red, bgcolor=color.black)
    
    table.cell(dash, 0, 6, txt_current_pnl, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 6, profit_str, text_color=profit_color, bgcolor=color.black, text_size=size.large)
    
    table.cell(dash, 0, 8, txt_lot_size, text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 8, str.tostring(lot_size), text_color=color.white, bgcolor=color.black)
    
    table.cell(dash, 0, 10, txt_trade_status, text_color=color.white, bgcolor=color.black)
    
    signal_txt = active_trade != 0 ? (active_trade == 1 ? txt_buy_act : txt_sell_act) : current_status_str
    signal_bg = active_trade == 1 ? color.new(color.green, 70) : active_trade == -1 ? color.new(color.red, 70) : color.black
    signal_text_color = active_trade == 1 ? color.green : active_trade == -1 ? color.red : color.gray
    table.cell(dash, 1, 10, signal_txt, text_color=signal_text_color, bgcolor=signal_bg, text_size=size.large)