//@version=6
indicator("EMA 8/17 + BEST Supertrend CCI Strategy", shorttitle="EMA-STC Strategy", overlay=true, max_labels_count=500)

// ============================= INPUTS =============================
grpEMA = "EMA Settings"
srcInput   = input.source(close, "Source", group=grpEMA)
emaFastLen = input.int(8,  "EMA Fast Length", group=grpEMA)
emaSlowLen = input.int(17, "EMA Slow Length", group=grpEMA)

grpSTC = "BEST Supertrend CCI Settings"
cciPeriod   = input.int(28, "CCI Period", group=grpSTC)
cciMidline  = input.float(0, "CCI Mid Line Pivot", group=grpSTC)
stFactor    = input.float(3, "Supertrend Factor", group=grpSTC)
stPeriod    = input.int(3, "Supertrend Period (ATR)", group=grpSTC)

grpTrade = "Trade Management"
rrRatio        = input.float(1.4, "Risk : Reward Ratio", group=grpTrade)
swingLookback  = input.int(10, "Swing Lookback (bars)", minval=1, group=grpTrade, tooltip="SL is placed at the most recent swing low (for BUY) / swing high (for SELL) over this many bars.")

grpMisc = "Extras"
showNoWick  = input.bool(true, "Show No-Wick Candle Markers", group=grpMisc)

// ============================= EMA (calculated, not plotted) =============================
emaFast = ta.ema(srcInput, emaFastLen)
emaSlow = ta.ema(srcInput, emaSlowLen)

bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)

// ============================= BEST SUPERTREND CCI (calculated, not plotted) =============================
[stLine, stDir] = ta.supertrend(stFactor, stPeriod)
cciVal = ta.cci(srcInput, cciPeriod)

// direction < 0 => uptrend, direction > 0 => downtrend (Pine convention)
var color stcColor = color.gray
bool upConfirm   = stDir < 0 and cciVal > cciMidline
bool downConfirm = stDir > 0 and cciVal < cciMidline

if upConfirm
    stcColor := color.new(color.green, 0)
if downConfirm
    stcColor := color.new(color.red, 0)

colorChanged = stcColor != stcColor[1]

// ============================= RECENT SWING LEVELS (for SL) =============================
swingLow  = ta.lowest(low, swingLookback)
swingHigh = ta.highest(high, swingLookback)

// ============================= TRADE STATE =============================
var int   posDir     = 0     // 1 = long, -1 = short, 0 = flat
var float entryPrice = na
var float slPrice    = na
var float tpPrice    = na

buyCondition  = bullCross and stcColor == color.new(color.green, 0) and posDir != 1
sellCondition = bearCross and stcColor == color.new(color.red, 0)   and posDir != -1

bool exitSignal = false

// ---- check exits for an existing position ----
if posDir == 1
    if colorChanged and stcColor != color.new(color.green, 0)
        exitSignal := true
    else if not na(tpPrice) and high >= tpPrice
        exitSignal := true
    else if not na(slPrice) and low <= slPrice
        exitSignal := true
else if posDir == -1
    if colorChanged and stcColor != color.new(color.red, 0)
        exitSignal := true
    else if not na(tpPrice) and low <= tpPrice
        exitSignal := true
    else if not na(slPrice) and high >= slPrice
        exitSignal := true

if exitSignal
    posDir     := 0
    entryPrice := na
    slPrice    := na
    tpPrice    := na

// ---- new entries only when flat ----
if posDir == 0
    if buyCondition
        float risk = close - swingLow
        if risk > 0
            posDir     := 1
            entryPrice := close
            slPrice    := swingLow
            tpPrice    := entryPrice + risk * rrRatio
    else if sellCondition
        float risk = swingHigh - close
        if risk > 0
            posDir     := -1
            entryPrice := close
            slPrice    := swingHigh
            tpPrice    := entryPrice - risk * rrRatio

// ============================= CLEAN LABELS: BUY / SELL / EXIT =============================
if buyCondition and posDir == 1
    label.new(bar_index, low - (high - low) * 0.5, "🟢 BUY", style=label.style_label_up, color=color.new(color.green, 85), textcolor=color.green, size=size.small, text_formatting=text.format_bold)

if sellCondition and posDir == -1
    label.new(bar_index, high + (high - low) * 0.5, "🔴 SELL", style=label.style_label_down, color=color.new(color.red, 85), textcolor=color.red, size=size.small, text_formatting=text.format_bold)

if exitSignal
    label.new(bar_index, close, "🚪 EXIT", style=label.style_label_down, color=color.new(color.purple, 85), textcolor=color.purple, size=size.small, text_formatting=text.format_bold)

// ============================= NO-WICK CANDLE MARKERS =============================
noUpperWick = high == math.max(open, close)
noLowerWick = low  == math.min(open, close)
noWick      = noUpperWick or noLowerWick

plotshape(showNoWick and noWick, title="No-Wick Candle", style=shape.diamond, location=location.abovebar, color=color.new(color.yellow, 0), size=size.tiny)

// ============================= ALERTS =============================
alertcondition(buyCondition and posDir == 1,  title="BUY Signal",  message="EMA 8/17 + Supertrend CCI: BUY Entry")
alertcondition(sellCondition and posDir == -1, title="SELL Signal", message="EMA 8/17 + Supertrend CCI: SELL Entry")
alertcondition(exitSignal, title="EXIT Signal", message="EMA 8/17 + Supertrend CCI: EXIT Trade")
