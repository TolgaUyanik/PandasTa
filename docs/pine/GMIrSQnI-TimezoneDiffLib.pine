//@version=6

library("TimezoneDiffLib", overlay=false)

// Function to calculate the current time difference in hours (float) between two timezones.
// Returns: (time in tz1) - (time in tz2) in hours, reflecting current offsets (incl. DST).
// Usage: Assumes valid IANA/UTC strings; errors if invalid (returns na).
export get_tz_diff(string tz1, string tz2) =>
    if na(tz1) or na(tz2)
        na
    else
        // Get fractional hours in each TZ for current time (timenow)
        h1 = hour(timenow, tz1) + minute(timenow, tz1) / 60.0 + second(timenow, tz1) / 3600.0
        h2 = hour(timenow, tz2) + minute(timenow, tz2) / 60.0 + second(timenow, tz2) / 3600.0
        // Difference (tz1 - tz2); wrap to -12..12 if needed, but raw is fine
        h1 - h2