//@version=6
indicator("BD Inside Bars", overlay=true)

var float refHigh = na
var float refLow = na

detectionMethod = input.string(
    "Compare with last non-inside bar",
    title="Detection method",
    options=[
        "Compare with previous bar (classic)",
        "Compare with last non-inside bar"
    ]
)

isInsideBar = false

float compareHigh = detectionMethod == "Compare with previous bar (classic)" ? high[1] : refHigh
float compareLow  = detectionMethod == "Compare with previous bar (classic)" ? low[1]  : refLow

if not na(compareHigh) and not na(compareLow)
    isInsideBar := high <= compareHigh and low >= compareLow
else
    isInsideBar := false

if not isInsideBar and detectionMethod == "Compare with last non-inside bar"
    refHigh := high
    refLow := low

barcolor(isInsideBar ? color.new(color.white, 100) : na)
