//@version=6

// @description TODO: Volatility and short term price analysis functions
library("FastMetrix",overlay = false)

// @description TODO: finds immediate slope of source with smoothing, not recommended for volatile sources
export slope(float source, int smoothing) =>
    slope = ta.sma(source - source[1],smoothing)
    slope

// @description TODO: Returns integral of funcx - funcy from start to end period 
export integral(float topfunction, float bottomfunction, int start, int end) =>
    z_array = array.new_float()
    for i = start to end 
        z = topfunction[i] - bottomfunction[i] 
        array.push(z_array,z)
    integral = array.sum(z_array)
    integral

//@description TODO: Find absolute value of x - y (deviation)
export deviation(float x, float y) =>
    deviation = math.abs(x-y)
    deviation 


// @description TODO: Important long term EMAs to guage general direction
// @function TODO: return important exponential long term moving averages and derivatives/variables
// @param TODO: [ema, isaboveema, isbelowema, emaslope, emadeviation]
export getema(int len) =>
    ema= ta.ema(close,len)
    isaboveema = (close > ema)? true : false 
    isbelowema = (close < ema)? true : false 
    emaslope = slope(ema,10)
    emadeviation = math.abs(close - ema)
    [ema, isaboveema, isbelowema, emaslope]


// @description TODO: Short term simple moving averages, gauge short term movement
// @function TODO: return requested sma
// @param TODO: [sma, isabovesma, isbelowsma,crossingupsma, crossingdwnsma]
export getsma(int len) =>
    sma = ta.sma(close, len)
    bool isabovesma = (close > sma) ? true : false
    bool isbelowsma = (close < sma) ? true : false
    crossingupsma = ta.crossover(close, sma)
    crossingdwnsma = ta.crossover(close, sma)
    [sma, isabovesma, isbelowsma,crossingupsma, crossingdwnsma]


//@description TODO: Keltner Channels indicator, finds optimal multiplier based on standard deviation.
// @function TODO: Return Keltner Channels variables and calculations
// @param TODO: defval mult 2.8, defval len 75
export kc(float mult, int len) =>
    [midkc,uprkc,lwrkc] = ta.kc(close,len,mult)
    kcwidth = ta.kcw(close,len,mult)
    bool isbelowkc = (close < lwrkc) ? true : false
    bool isabovekc = (close > uprkc) ? true : false
    [midkc,uprkc,lwrkc,kcwidth,isbelowkc,isabovekc]


//@description TODO: Bollinger bands
//@function TODO: returns bollinger bands with optimal settings
//@param TODO: [midbb,upperbb,lowerbb,bbexpansionup,bbexpansiondown]
export bollinger(int len, float mult) =>
    [midbb, upperbb, lowerbb] = ta.bb(close,len,mult)
    bbwidth = upperbb - lowerbb
    bbexpansionup = (bbwidth>bbwidth[5] and close>upperbb)? true : false
    bbexpansiondown = (bbwidth<bbwidth[5] and close<lowerbb)? true : false
    [midbb,upperbb,lowerbb,bbexpansionup,bbexpansiondown]


//@description TODO: Volatility metrics
//@function TODO: Returns volatility indicators based on atr 
// @param TODO: [shortatr,shortatravg,longatr,volpop]
export volatility(int atrlen, int smoothing) =>
    shortatr = ta.atr(atrlen)
    shortatravg = ta.sma(shortatr,smoothing)
    volpop = (ta.barssince(shortatr<shortatravg) > 3)
    [shortatr,shortatravg,volpop]


// @description TODO: Premarket fib creator
// @param TODO: [topfib,bottomfib,midfib,uppermidfib,lowermidfib]
export premarketfib() =>
    barsinsession = ta.barssince(session.isfirstbar) + 1
    sessionhigh = ta.highest(barsinsession)
    sessionlow = ta.lowest(barsinsession)
    premarkethigh = ta.valuewhen(session.ispremarket,sessionhigh,0)
    premarketlow = ta.valuewhen(session.ispremarket,sessionlow,0)
    topfib = session.ispremarket ? sessionhigh : premarkethigh
    bottomfib = session.ispremarket ? sessionlow : premarketlow
    fibwidth = topfib - bottomfib
    midfib = bottomfib + fibwidth*.5
    uppermidfib = bottomfib + fibwidth*.625
    lowermidfib = bottomfib + fibwidth*.375
    [topfib,bottomfib,midfib,uppermidfib,lowermidfib]


//@description TODO: util to count number of times condition met in session 
export countinday(bool xcondition) =>
    var int x = 0
    if session.isfirstbar
        x := 0
    if xcondition
        x += 1
    x

//@description TODO: util to count number of times condition met in period
export countinsession(bool condition, int n) =>
    var int x = 0
    for i = 1 to n 
        if condition 
            x += 1 
        if not condition 
            x -+ 1 
    x 