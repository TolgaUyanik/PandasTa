//@version=6
// ============================================================================
//  Previous Day High Low — Key Levels, Reach Stats & Alerts [LunqFX]
// ----------------------------------------------------------------------------
//  ONE idea: the high and low of the previous higher-timeframe candle — and
//  how often price actually goes there.
//
//    UNTESTED / TESTED — untested levels still hold their pull; tested ones
//                        are spent (dashed, dimmed).
//    RANGE SHADING     — the previous day's and week's range is filled, so you
//                        instantly see balance (inside) vs expansion (outside).
//    REACH STATS       — on THIS symbol, in what % of days price reaches the
//                        previous day's high / low, and how often it closes
//                        through it (break) instead of rejecting.
//
//  NON-REPAINTING: levels and stats come from COMPLETED higher-timeframe
//  candles with lookahead off.
// ============================================================================
indicator("Previous Day High Low — Key Levels, Reach Stats & Alerts [LunqFX]",
     "Key Levels [LunqFX]", overlay = true, max_lines_count = 40, max_labels_count = 40, max_boxes_count = 60)

// ─────────────────────────────────────────────────────────────────────────
//  PALETTE — tuned for a LIGHT GREY chart background (#b8b8b8)
//  Muted candles, vivid levels, charcoal cards: strong contrast on grey.
// ─────────────────────────────────────────────────────────────────────────
HI_C    = #E11D48            // resistance levels — vivid crimson
HI_B    = #FF5C7A
LO_C    = #0369A1            // support levels — deep blue
LO_B    = #3AA0DC
AMBER   = #B45309            // day range fill
INDIGO  = #4338CA            // week range fill
CU_LO   = #6FAFA2            // candle up — muted sea green
CU_HI   = #0E8A72
CD_LO   = #D08A98            // candle down — muted rose
CD_HI   = #A31A3C
CARD    = #16181D            // charcoal card
CARD_2  = #22252D
TXT     = #F5F7FA
MUTE    = #A2ACBD

// ─────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────
gL      = "Levels"
useD    = input.bool(true,  "Previous Day (PDH / PDL)",   group = gL)
useW    = input.bool(true,  "Previous Week (PWH / PWL)",  group = gL)
useM    = input.bool(false, "Previous Month (PMH / PML)", group = gL)
hideTst = input.bool(false, "Hide tested levels",         group = gL)

gS      = "Reach Statistics"
statN   = input.int(100, "Days in stats window", minval = 20, maxval = 500, group = gS)

gV      = "Visuals"
showRng = input.bool(true, "Shade previous range (day / week)", group = gV)
rngOp   = input.int(86, "Range fill transparency", minval = 65, maxval = 99, group = gV)
glowOn  = input.bool(true, "Glow on untested levels", group = gV)
minW    = input.int(60, "Level width (bars)", minval = 10, maxval = 500, group = gV, tooltip = "How far left the levels and range shading stretch. Lower = shorter, tidier lines.")
extR    = input.int(16, "Extend right (bars)", minval = 0, maxval = 100, group = gV)
wD      = input.int(3, "Day line width",   minval = 1, maxval = 6, group = gV)
wW      = input.int(4, "Week line width",  minval = 1, maxval = 7, group = gV)
wM      = input.int(5, "Month line width", minval = 1, maxval = 8, group = gV)
candOn  = input.bool(true, "Custom candles", group = gV)

gP      = "Dashboard"
showHUD = input.bool(true, "Show dashboard strip", group = gP)
hudPos  = input.string("Bottom Center","Position", options=["Bottom Center","Top Center","Bottom Right","Bottom Left","Top Right"], group = gP)

// ─────────────────────────────────────────────────────────────────────────
//  LEVELS
// ─────────────────────────────────────────────────────────────────────────
// Canonical non-repainting pattern for previous-period values:
// lookahead_on together with the [1] offset. The offset guarantees the value
// comes from a COMPLETED candle, so there is no future leak, while the level
// is the correct previous one (lookahead_off + [1] would be a period stale).
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ─────────────────────────────────────────────────────────────────────────
//  REACH STATISTICS
// ─────────────────────────────────────────────────────────────────────────
[pctH, pctL, brkH, brkL] = request.security(syminfo.tickerid, "D",
     [ta.sma(high >= high[1] ? 1.0 : 0.0, statN)[1] * 100,
      ta.sma(low  <= low[1]  ? 1.0 : 0.0, statN)[1] * 100,
      ta.sma(close > high[1] ? 1.0 : 0.0, statN)[1] * 100,
      ta.sma(close < low[1]  ? 1.0 : 0.0, statN)[1] * 100],
     lookahead = barmerge.lookahead_on)
brkRateH = nz(pctH) > 0 ? math.min(100.0, brkH / pctH * 100.0) : na
brkRateL = nz(pctL) > 0 ? math.min(100.0, brkL / pctL * 100.0) : na

// ─────────────────────────────────────────────────────────────────────────
//  PERIOD STATE
// ─────────────────────────────────────────────────────────────────────────
newD = ta.change(time("D")) != 0
newW = ta.change(time("W")) != 0
newM = ta.change(time("M")) != 0
var bool tPdh = false
var bool tPdl = false
var bool tPwh = false
var bool tPwl = false
var bool tPmh = false
var bool tPml = false
if newD
    tPdh := false
    tPdl := false
if newW
    tPwh := false
    tPwl := false
if newM
    tPmh := false
    tPml := false

// visual TESTED state updates live — a level price is trading through is
// tested right now, not only after the candle closes
if not na(pdh) and not tPdh and high >= pdh
    tPdh := true
if not na(pdl) and not tPdl and low <= pdl
    tPdl := true
if not na(pwh) and not tPwh and high >= pwh
    tPwh := true
if not na(pwl) and not tPwl and low <= pwl
    tPwl := true
if not na(pmh) and not tPmh and high >= pmh
    tPmh := true
if not na(pml) and not tPml and low <= pml
    tPml := true

// alerts stay on CLOSED bars only, so they never fire early
var bool aPdh = false
var bool aPdl = false
if newD
    aPdh := false
    aPdl := false
hitPdh = false
hitPdl = false
if barstate.isconfirmed
    if not na(pdh) and not aPdh and high >= pdh
        aPdh := true
        hitPdh := true
    if not na(pdl) and not aPdl and low <= pdl
        aPdl := true
        hitPdl := true

// ─────────────────────────────────────────────────────────────────────────
//  DRAW
// ─────────────────────────────────────────────────────────────────────────
var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()
var array<box>   bxs = array.new<box>()

drawRange(float hi, float lo, color c, int steps) =>
    if showRng and not na(hi) and not na(lo) and hi > lo
        x1 = bar_index - minW
        x2 = bar_index + extR
        gh = (hi - lo) / steps
        for s = 0 to steps - 1
            yA = lo + gh * s
            yB = lo + gh * (s + 1)
            edge = math.min(s, steps - 1 - s) / (steps / 2.0)
            op   = math.min(99, math.round(rngOp - (1.0 - edge) * 10))
            array.push(bxs, box.new(x1, yB, x2, yA, border_color = color.new(c, 100), bgcolor = color.new(c, op)))

// xoff gives each timeframe its own label column on the right, so levels that
// sit at almost the same price never stack their labels on top of each other
drawLevel(float price, string name, bool isHigh, bool tested, int w, int xoff) =>
    if not na(price) and not (tested and hideTst)
        col = isHigh ? HI_C : LO_C
        x1  = bar_index - minW
        x2  = bar_index + extR + xoff
        if not tested and glowOn
            array.push(lns, line.new(x1, price, x2, price, color = color.new(col, 80), width = w + 6))
        array.push(lns, line.new(x1, price, x2, price, color = color.new(col, tested ? 58 : 0), width = w, style = tested ? line.style_dashed : line.style_solid))
        array.push(lbs, label.new(x2, price, "  " + name + (tested ? " ✕" : "") + "   " + str.tostring(price, format.mintick) + "  ", style = label.style_label_left, color = color.new(CARD, tested ? 38 : 0), textcolor = tested ? color.new(TXT, 50) : (isHigh ? HI_B : LO_B), size = size.large))

if barstate.islast
    if array.size(lns) > 0
        for i = 0 to array.size(lns) - 1
            line.delete(array.get(lns, i))
        array.clear(lns)
    if array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.delete(array.get(lbs, i))
        array.clear(lbs)
    if array.size(bxs) > 0
        for i = 0 to array.size(bxs) - 1
            box.delete(array.get(bxs, i))
        array.clear(bxs)
    if useW
        drawRange(pwh, pwl, INDIGO, 10)
    if useD
        drawRange(pdh, pdl, AMBER, 10)
    gap = math.max(10, minW / 4)
    if useM
        drawLevel(pmh, "PMH", true,  tPmh, wM, gap * 2)
        drawLevel(pml, "PML", false, tPml, wM, gap * 2)
    if useW
        drawLevel(pwh, "PWH", true,  tPwh, wW, gap)
        drawLevel(pwl, "PWL", false, tPwl, wW, gap)
    if useD
        drawLevel(pdh, "PDH", true,  tPdh, wD, 0)
        drawLevel(pdl, "PDL", false, tPdl, wD, 0)

// ─────────────────────────────────────────────────────────────────────────
//  NEAREST UNTESTED MAGNET
// ─────────────────────────────────────────────────────────────────────────
lvPrice = array.from(pdh, pdl, pwh, pwl, pmh, pml)
lvName  = array.from("PDH", "PDL", "PWH", "PWL", "PMH", "PML")
lvTest  = array.from(tPdh, tPdl, tPwh, tPwl, tPmh, tPml)
lvOn    = array.from(useD, useD, useW, useW, useM, useM)

bestAbove   = 1e18
bestAboveNm = "—"
bestBelow   = -1e18
bestBelowNm = "—"
for i = 0 to 5
    p = array.get(lvPrice, i)
    if array.get(lvOn, i) and not array.get(lvTest, i) and not na(p)
        if p > close and p < bestAbove
            bestAbove   := p
            bestAboveNm := array.get(lvName, i)
        if p < close and p > bestBelow
            bestBelow   := p
            bestBelowNm := array.get(lvName, i)

hasAbove = bestAbove < 1e17
hasBelow = bestBelow > -1e17
dAbove   = hasAbove and close != 0 ? (bestAbove - close) / close * 100 : na
dBelow   = hasBelow and close != 0 ? (close - bestBelow) / close * 100 : na
pullUp   = nz(dAbove, 1e9) <= nz(dBelow, 1e9)

// ─────────────────────────────────────────────────────────────────────────
//  CANDLES  (muted so the vivid levels stay the hero)
// ─────────────────────────────────────────────────────────────────────────
atr14 = ta.atr(14)
isUp  = close >= open
str_  = math.min(1.0, math.abs(close - open) / (atr14 * 0.5 + 1e-9))
cBody = isUp ? color.from_gradient(str_, 0, 1, CU_LO, CU_HI) : color.from_gradient(str_, 0, 1, CD_LO, CD_HI)
cEdge = isUp ? CU_HI : CD_HI
plotcandle(candOn ? open : na, high, low, close, title = "Candles", color = cBody, wickcolor = cEdge, bordercolor = cEdge)

// ─────────────────────────────────────────────────────────────────────────
//  DASHBOARD — horizontal strip (a different shape entirely)
// ─────────────────────────────────────────────────────────────────────────
hudPosition(string s) =>
    switch s
        "Bottom Center" => position.bottom_center
        "Top Center"    => position.top_center
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        => position.top_right

pct(float v) =>
    na(v) ? "—" : str.tostring(math.round(v)) + "%"

var table hud = na
if showHUD and barstate.islast
    if not na(hud)
        table.delete(hud)
    hud := table.new(hudPosition(hudPos), 5, 2, bgcolor = CARD, border_color = CARD_2, border_width = 1, frame_width = 0)

    inRange = not na(pdh) and not na(pdl) and close <= pdh and close >= pdl
    rngTx   = na(pdh) or na(pdl) ? "—" : inRange ? "INSIDE RANGE" : close > pdh ? "▲ EXPANSION" : "▼ EXPANSION"
    rngCol  = na(pdh) or na(pdl) ? MUTE : inRange ? #E8B923 : close > pdh ? HI_B : LO_B
    magTx   = not hasAbove and not hasBelow ? "—" : pullUp ? "▲ " + bestAboveNm + "  " + str.tostring(bestAbove, format.mintick) : "▼ " + bestBelowNm + "  " + str.tostring(bestBelow, format.mintick)
    magCol  = pullUp ? HI_B : LO_B

    // row 0 = small captions, row 1 = big values
    table.cell(hud, 0, 0, "  KEY LEVELS  ", text_color = MUTE,  text_size = size.small,  text_halign = text.align_left,   bgcolor = CARD_2)
    table.cell(hud, 0, 1, "  LunqFX  ",     text_color = TXT,   text_size = size.normal, text_halign = text.align_left,   bgcolor = CARD)

    table.cell(hud, 1, 0, "  DAY RANGE  ",  text_color = MUTE,  text_size = size.small,  text_halign = text.align_center, bgcolor = CARD_2)
    table.cell(hud, 1, 1, "  " + rngTx + "  ", text_color = rngCol, text_size = size.large, text_halign = text.align_center, bgcolor = CARD)

    table.cell(hud, 2, 0, "  NEAREST MAGNET  ", text_color = MUTE, text_size = size.small, text_halign = text.align_center, bgcolor = CARD_2)
    table.cell(hud, 2, 1, "  " + magTx + "  ", text_color = magCol, text_size = size.large, text_halign = text.align_center, bgcolor = CARD)

    table.cell(hud, 3, 0, "  PDH REACHED  ", text_color = MUTE, text_size = size.small, text_halign = text.align_center, bgcolor = CARD_2)
    table.cell(hud, 3, 1, "  " + pct(pctH) + " · brk " + pct(brkRateH) + "  ", text_color = HI_B, text_size = size.large, text_halign = text.align_center, bgcolor = CARD)

    table.cell(hud, 4, 0, "  PDL REACHED  ", text_color = MUTE, text_size = size.small, text_halign = text.align_center, bgcolor = CARD_2)
    table.cell(hud, 4, 1, "  " + pct(pctL) + " · brk " + pct(brkRateL) + "  ", text_color = LO_B, text_size = size.large, text_halign = text.align_center, bgcolor = CARD)

// ─────────────────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────────────────
alertcondition(hitPdh, "Previous Day High reached", "LunqFX Key Levels: PDH reached")
alertcondition(hitPdl, "Previous Day Low reached",  "LunqFX Key Levels: PDL reached")
