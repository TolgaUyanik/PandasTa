//@version=5

// @description TODO: Delete array type especially for drawings
library('DeleteArrayType')

// 0. Library
// 1. Examples

//#region ———————————————————— 0. Library
// @function TODO: Delete array<label>
// @param x TODO: array<label>
// @returns TODO: label.delete()
export method deleteLabel(array<label> id = na) =>
    for index = 0 to id.size() - 1
        label.delete(id.get(index))

// @function TODO: Delete array<line>
// @param x TODO: array<line>
// @returns TODO: line.delete()
export method deleteLine(array<line> id = na) =>
    for index = 0 to id.size() - 1
        line.delete(id.get(index))

// @function TODO: Delete array<linefill>
// @param x TODO: array<linefill>
// @returns TODO: linefill.delete()
export method deleteLineFill(array<linefill> id = na) =>
    for index = 0 to id.size() - 1
        linefill.delete(id.get(index))

// @function TODO: Delete array<polyline>
// @param x TODO: array<polyline>
// @returns TODO: polyline.delete()
export method deletePolyLine(array<polyline> id = na) =>
    for index = 0 to id.size() - 1
        polyline.delete(id.get(index))

// @function TODO: Delete array<box>
// @param x TODO: array<box>
// @returns TODO: box.delete()
export method deleteBox(array<box> id = na) =>
    for index = 0 to id.size() - 1
        box.delete(id.get(index))

// @function TODO: Delete array<table>
// @param x TODO: array<table>
// @returns TODO: table.delete()
export method deleteTable(array<table> id = na) =>
    for index = 0 to id.size() - 1
        table.delete(id.get(index))
//#endregion

//#region ———————————————————— 1. Examples
var arrayLabel    = array.new<label>(6),    arrayLabel.deleteLabel()
var arrayLine     = array.new<line>(6),     arrayLine.deleteLine()
var arrayPolyLine = array.new<polyline>(6), arrayPolyLine.deletePolyLine()
var arrayLineFill = array.new<linefill>(5), arrayLineFill.deleteLineFill()
var arrayBox      = array.new<box>(4),      arrayBox.deleteBox()
var arrayTable    = array.new<table>(4),    arrayTable.deleteTable()
//#endregion
