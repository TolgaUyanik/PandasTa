//@version=6
indicator("Volume Delta (Inverted Red + Dual ATR MAs)", format=format.volume, overlay=false)

import TradingView/ta/8

// ── Inputs
lowerTimeframeTooltip = "The indicator scans lower timeframe data to approximate up and down volume used in the delta calculation."
useCustomTimeframeInput = input.bool(true, "Use custom timeframe", tooltip = lowerTimeframeTooltip)
lowerTimeframeInput = input.timeframe("1S", "Timeframe")

maLength        = input.int(13, "MA Length for Volume Delta", minval=1)
maTypeDelta     = input.string("SMA", "MA Type for Volume Delta", options=["SMA", "EMA", "WMA", "RMA"])

atrLength       = input.int(13, "ATR Length for Volume Delta", minval=1)

// First ATR MA
maAtrLength1    = input.int(13, "ATR MA Length 1", minval=1)
maTypeAtr1      = input.string("SMA", "ATR MA Type 1", options=["SMA", "EMA", "WMA", "RMA"])

// Second ATR MA
maAtrLength2    = input.int(34, "ATR MA Length 2", minval=1)
maTypeAtr2      = input.string("EMA", "ATR MA Type 2", options=["SMA", "EMA", "WMA", "RMA"])

comparisonChoice = input.string("ATR", "Brightness Based On", options=["ATR", "MA", "ATR-MA1", "ATR-MA2"])

// ── Determine timeframe
var string lowerTimeframe = switch
    useCustomTimeframeInput => lowerTimeframeInput
    timeframe.isseconds     => "1S"
    timeframe.isintraday    => "1"
    timeframe.isdaily       => "5"
    => "60"

// ── Request volume delta values
[openVolume, maxVolume, minVolume, lastVolume] = ta.requestVolumeDelta(lowerTimeframe)

// ── Flip negative values
isDown   = lastVolume <= 0
adjOpen  = isDown ? -openVolume : openVolume
adjMax   = isDown ? -maxVolume  : maxVolume
adjMin   = isDown ? -minVolume  : minVolume
adjLast  = isDown ? -lastVolume : lastVolume

// ── Selectable MA function
maFunction(src, len, maType) =>
    maType == "SMA" ? ta.sma(src, len) : maType == "EMA" ? ta.ema(src, len) : maType == "WMA" ? ta.wma(src, len) : ta.rma(src, len)

// ── MA of adjusted lastVolume
maDelta  = maFunction(adjLast, maLength, maTypeDelta)

// ── ATR of adjLast (raw)
volTr  = math.abs(adjLast - adjLast[1])
volAtr = ta.rma(volTr, atrLength)

// ── Two ATR MAs
maVolAtr1 = maFunction(volAtr, maAtrLength1, maTypeAtr1)
maVolAtr2 = maFunction(volAtr, maAtrLength2, maTypeAtr2)

// ── Pick threshold based on user choice
threshold = comparisonChoice == "ATR"      ? volAtr : comparisonChoice == "MA"       ? maDelta : comparisonChoice == "ATR-MA1"  ? maVolAtr1 : maVolAtr2  // ATR-MA2 option

// ── Dynamic brightness
colBase = isDown ? color.red : color.teal
col     = adjLast >= threshold ? color.new(colBase, 0) : color.new(colBase, 50)

// ── Plot candles
hline(0)
plotcandle(adjOpen, adjMax, adjMin, adjLast, "Volume Delta", color=col, bordercolor=col, wickcolor=col)

// ── Plot only the brightness threshold line
plot(comparisonChoice == "MA"       ? maDelta    : na, color=color.purple, linewidth=1, title="MA of Volume Delta")
plot(comparisonChoice == "ATR"      ? volAtr     : na, color=color.orange, linewidth=1, title="ATR of Volume Delta")
plot(comparisonChoice == "ATR-MA1"  ? maVolAtr1  : na, color=color.yellow, linewidth=1, title="ATR MA 1")
plot(comparisonChoice == "ATR-MA2"  ? maVolAtr2  : na, color=color.blue,   linewidth=1, title="ATR MA 2")

// ── Safety check
var float cumVol = 0.
cumVol += nz(volume)
if barstate.islast and cumVol == 0
    runtime.error("The data vendor doesn't provide volume data for this symbol.")
