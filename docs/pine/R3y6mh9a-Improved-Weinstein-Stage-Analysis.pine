//@version=6
indicator('Enhanced Weinstein Stage Analysis - Institutional', overlay = true, max_bars_back = 500, shorttitle = 'InstStages')

// === COLOR SETTINGS ===
// Stages (Background)
stage1_bg_col = input.color(color.purple, 'Stage 1 (Basing) BG', group = 'Colors - Stages')
stage2_bg_col = input.color(color.lime, 'Stage 2 (Advancing) BG', group = 'Colors - Stages')
stage3_bg_col = input.color(color.orange, 'Stage 3 (Topping) BG', group = 'Colors - Stages')
stage4_bg_col = input.color(color.red, 'Stage 4 (Declining) BG', group = 'Colors - Stages')
// Moving Average (by Stage)
ma_stage1_col = input.color(color.purple, 'MA in Stage 1', group = 'Colors - Moving Average')
ma_stage2_col = input.color(color.lime, 'MA in Stage 2', group = 'Colors - Moving Average')
ma_stage3_col = input.color(color.orange, 'MA in Stage 3', group = 'Colors - Moving Average')
ma_stage4_col = input.color(color.red, 'MA in Stage 4', group = 'Colors - Moving Average')
ma_default_col = input.color(color.gray, 'MA Default', group = 'Colors - Moving Average')
// Relative Strength
rs_line_col = input.color(color.blue, 'RS Line', group = 'Colors - Relative Strength')
rs_ma_col = input.color(color.blue, 'RS MA Line', group = 'Colors - Relative Strength')
rs_baseline_col = input.color(color.gray, 'RS Baseline (100)', group = 'Colors - Relative Strength')
rs_threshold_col = input.color(color.red, 'RS Threshold', group = 'Colors - Relative Strength')
// Volume Spikes
vol_strong_col = input.color(color.red, 'Strong Volume Spike', group = 'Colors - Volume')
vol_moderate_col = input.color(color.yellow, 'Moderate Volume Spike', group = 'Colors - Volume')
// Labels
label_text_col = input.color(color.black, 'Label Text', group = 'Colors - Labels')
// Table colors
buy_col = input.color(color.lime, 'Signal: BUY', group = 'Colors - Table')
sell_col = input.color(color.red, 'Signal: SELL', group = 'Colors - Table')
wait_col = input.color(color.gray, 'Signal: WAIT', group = 'Colors - Table')
strength_high_col = input.color(color.lime, 'Strength: HIGH', group = 'Colors - Table')
strength_med_col = input.color(color.yellow, 'Strength: MED', group = 'Colors - Table')
strength_low_col = input.color(color.red, 'Strength: LOW', group = 'Colors - Table')
rs_cell_strong_col = input.color(color.blue, 'RS Cell (Strong)', group = 'Colors - Table')
rs_cell_default_col = input.color(color.gray, 'RS Cell (Default)', group = 'Colors - Table')
vol_cell_low_col = input.color(color.gray, 'Vol Cell (Low)', group = 'Colors - Table')
slope_up_col = input.color(color.lime, 'Slope: Up', group = 'Colors - Table')
slope_down_col = input.color(color.red, 'Slope: Down', group = 'Colors - Table')
slope_flat_col = input.color(color.gray, 'Slope: Flat', group = 'Colors - Table')
htf_yes_col = input.color(color.lime, 'HTF: Aligned', group = 'Colors - Table')
htf_no_col = input.color(color.red, 'HTF: Conflict', group = 'Colors - Table')

// === USER SETTINGS ===
// Core Settings
ma_len = input.int(30, minval = 10, title = 'MA Length (30 for weekly, 150 for daily)', group = 'Core Settings')
ma_type = input.string('SMA', options = ['SMA', 'EMA'], title = 'MA Type', group = 'Core Settings')
stage_confirm = input.int(3, minval = 1, title = 'Stage Confirmation Bars', group = 'Core Settings')
ma_slope_threshold = input.float(0.05, minval = 0.01, step = 0.01, title = 'MA Slope Threshold (%)', group = 'Core Settings')
signal_mode = input.string('Balanced', options = ['Conservative', 'Balanced', 'Aggressive'], title = 'Signal Mode', group = 'Core Settings')
rsi_filter_enabled = input.bool(true, title = 'Use RSI Trend Filter', group = 'Core Settings')
rsi_filter_level = input.int(50, minval = 30, maxval = 80, title = 'RSI Trend Filter Level', group = 'Core Settings')
show_stage_change_labels = input.bool(true, title = 'Show Stage Change Quality Labels', group = 'Core Settings')
// Volume Settings
show_vol = input.bool(true, title = 'Show Volume Analysis', group = 'Volume')
vol_mult = input.float(2.0, minval = 1.0, step = 0.1, title = 'Volume Spike Multiple', group = 'Volume')
vol_percentile_threshold = input.int(60, minval = 50, maxval = 95, title = 'Volume Percentile Threshold', group = 'Volume')
// Relative Strength Settings
rs_symbol = input.symbol('SPY', 'Relative Strength Symbol', group = 'Relative Strength')
rs_period = input.int(14, minval = 5, title = 'RS Smoothing Period', group = 'Relative Strength')
rs_threshold = input.float(105, minval = 95, step = 1, title = 'RS Outperformance Threshold', group = 'Relative Strength')
// Visual Settings
show_stage_bg = input.bool(true, title = 'Show Stage Background', group = 'Visual')
show_labels = input.bool(true, title = 'Show Stage Labels', group = 'Visual')
show_table = input.bool(true, title = 'Show Info Table', group = 'Visual')
dynamic_transparency = input.bool(true, title = 'Dynamic Transparency', group = 'Visual')
// Multi-timeframe
htf_confirmation = input.bool(false, title = 'Higher Timeframe Confirmation', group = 'Multi-Timeframe')
htf_timeframe = input.timeframe('1W', title = 'Higher Timeframe', group = 'Multi-Timeframe')
// Company Info Display
// === COMPANY INFO DISPLAY ===
// === COMPANY INFO DISPLAY ===
show_company_info = input.bool(true, title = "Show Company Parameters", group = "Company Info")

// ---------- helpers ----------
fmt_num(float x) =>
    if na(x)
        "-"
    else if math.abs(x) >= 1000000000000
        str.tostring(x / 1000000000000, "#.##") + "T"
    else if math.abs(x) >= 1000000000
        str.tostring(x / 1000000000, "#.##") + "B"
    else if math.abs(x) >= 10000000
        str.tostring(x / 10000000, "#.##") + "Cr"
    else if math.abs(x) >= 100000
        str.tostring(x / 100000, "#.##") + "L"
    else
        str.tostring(x, "#.##")

fmt_pct(float x) =>
    if na(x)
        "-"
    else
        str.tostring(x, "#.##") + "%"

display_val(string x) =>
    x == "" ? "-" : x

safe_growth(float curr, float prev) =>
    if na(curr) or na(prev) or prev == 0
        na
    else
        ((curr - prev) / math.abs(prev)) * 100

// ---------- company header ----------
company_name = syminfo.description != "" ? syminfo.description : syminfo.ticker

// ---------- sector / industry / free float lookup ----------
string company_sector = "-"
string company_industry = "-"
string company_free_float = "-"

// ---------- market cap ----------
shares_out = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol = true)
market_cap_val = not na(shares_out) ? shares_out * close : na
company_market_cap = fmt_num(market_cap_val)

// ---------- quarterly fundamentals ----------
// Current and previous quarterly values
// ---------- quarterly fundamentals ----------
// Use gaps = barmerge.gaps_on so a value only appears on the bar where a new quarter is reported.
// Then use valuewhen() to capture the latest 4 distinct quarterly prints.

sales_fq_raw = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ", gaps = barmerge.gaps_on, ignore_invalid_symbol = true)
profit_fq_raw = request.financial(syminfo.tickerid, "NET_INCOME", "FQ", gaps = barmerge.gaps_on, ignore_invalid_symbol = true)
opinc_fq_raw = request.financial(syminfo.tickerid, "OPERATING_INCOME", "FQ", gaps = barmerge.gaps_on, ignore_invalid_symbol = true)

// Distinct quarter events
new_sales_q = not na(sales_fq_raw)
new_profit_q = not na(profit_fq_raw)
new_opinc_q = not na(opinc_fq_raw)

// Latest 8 distinct quarterly values (needed for YoY comparison)
sales_0 = ta.valuewhen(new_sales_q, sales_fq_raw, 0)
sales_1 = ta.valuewhen(new_sales_q, sales_fq_raw, 1)
sales_2 = ta.valuewhen(new_sales_q, sales_fq_raw, 2)
sales_3 = ta.valuewhen(new_sales_q, sales_fq_raw, 3)
sales_4 = ta.valuewhen(new_sales_q, sales_fq_raw, 4)
sales_5 = ta.valuewhen(new_sales_q, sales_fq_raw, 5)
sales_6 = ta.valuewhen(new_sales_q, sales_fq_raw, 6)
sales_7 = ta.valuewhen(new_sales_q, sales_fq_raw, 7)

profit_0 = ta.valuewhen(new_profit_q, profit_fq_raw, 0)
profit_1 = ta.valuewhen(new_profit_q, profit_fq_raw, 1)
profit_2 = ta.valuewhen(new_profit_q, profit_fq_raw, 2)
profit_3 = ta.valuewhen(new_profit_q, profit_fq_raw, 3)
profit_4 = ta.valuewhen(new_profit_q, profit_fq_raw, 4)
profit_5 = ta.valuewhen(new_profit_q, profit_fq_raw, 5)
profit_6 = ta.valuewhen(new_profit_q, profit_fq_raw, 6)
profit_7 = ta.valuewhen(new_profit_q, profit_fq_raw, 7)

op_income_0 = ta.valuewhen(new_opinc_q, opinc_fq_raw, 0)
op_income_1 = ta.valuewhen(new_opinc_q, opinc_fq_raw, 1)
op_income_2 = ta.valuewhen(new_opinc_q, opinc_fq_raw, 2)
op_income_3 = ta.valuewhen(new_opinc_q, opinc_fq_raw, 3)

// OPM
opm_0 = not na(sales_0) and sales_0 != 0 ? (op_income_0 / sales_0) * 100 : na
opm_1 = not na(sales_1) and sales_1 != 0 ? (op_income_1 / sales_1) * 100 : na
opm_2 = not na(sales_2) and sales_2 != 0 ? (op_income_2 / sales_2) * 100 : na
opm_3 = not na(sales_3) and sales_3 != 0 ? (op_income_3 / sales_3) * 100 : na

// YoY = compare with same quarter last year
profit_yoy_0 = safe_growth(profit_0, profit_4)
profit_yoy_1 = safe_growth(profit_1, profit_5)
profit_yoy_2 = safe_growth(profit_2, profit_6)
profit_yoy_3 = safe_growth(profit_3, profit_7)

sales_yoy_0 = safe_growth(sales_0, sales_4)
sales_yoy_1 = safe_growth(sales_1, sales_5)
sales_yoy_2 = safe_growth(sales_2, sales_6)
sales_yoy_3 = safe_growth(sales_3, sales_7)

// QoQ = compare with immediately previous quarter
profit_qoq_0 = safe_growth(profit_0, profit_1)
profit_qoq_1 = safe_growth(profit_1, profit_2)
profit_qoq_2 = safe_growth(profit_2, profit_3)
profit_qoq_3 = safe_growth(profit_3, profit_4)

sales_qoq_0 = safe_growth(sales_0, sales_1)
sales_qoq_1 = safe_growth(sales_1, sales_2)
sales_qoq_2 = safe_growth(sales_2, sales_3)
sales_qoq_3 = safe_growth(sales_3, sales_4)

// quarter labels: latest quarter first
q_label_0 = "Q0"
q_label_1 = "Q-1"
q_label_2 = "Q-2"
q_label_3 = "Q-3"

// rows used by company table
company_q1 = q_label_0 + "|" + fmt_num(profit_0) + "|" + fmt_pct(profit_yoy_0) + "|" + fmt_pct(profit_qoq_0) + "|" + fmt_num(sales_0) + "|" + fmt_pct(sales_yoy_0) + "|" + fmt_pct(sales_qoq_0) + "|" + fmt_pct(opm_0)
company_q2 = q_label_1 + "|" + fmt_num(profit_1) + "|" + fmt_pct(profit_yoy_1) + "|" + fmt_pct(profit_qoq_1) + "|" + fmt_num(sales_1) + "|" + fmt_pct(sales_yoy_1) + "|" + fmt_pct(sales_qoq_1) + "|" + fmt_pct(opm_1)
company_q3 = q_label_2 + "|" + fmt_num(profit_2) + "|" + fmt_pct(profit_yoy_2) + "|" + fmt_pct(profit_qoq_2) + "|" + fmt_num(sales_2) + "|" + fmt_pct(sales_yoy_2) + "|" + fmt_pct(sales_qoq_2) + "|" + fmt_pct(opm_2)
company_q4 = q_label_3 + "|" + fmt_num(profit_3) + "|" + fmt_pct(profit_yoy_3) + "|" + fmt_pct(profit_qoq_3) + "|" + fmt_num(sales_3) + "|" + fmt_pct(sales_yoy_3) + "|" + fmt_pct(sales_qoq_3) + "|" + fmt_pct(opm_3)

// === CORE CALCULATIONS ===
// Enhanced Moving Average
ma = ma_type == 'SMA' ? ta.sma(close, ma_len) : ta.ema(close, ma_len)
ma_slope = ta.change(ma, 1) / ma[1] * 100
ma_rising = ma_slope > ma_slope_threshold
ma_falling = ma_slope < -ma_slope_threshold
ma_flat = math.abs(ma_slope) <= ma_slope_threshold
price_above_ma = close > ma
price_below_ma = close < ma

// === ENHANCED STAGE LOGIC ===
var int current_stage = 0
var int confirmation_counter = 0
stage_candidate = price_above_ma and ma_flat ? 1 : price_above_ma and ma_rising ? 2 : price_below_ma and ma_flat ? 3 : price_below_ma and ma_falling ? 4 : nz(current_stage[1], 0)
if bar_index == 0
    current_stage := 0
    confirmation_counter := 0
if stage_candidate == nz(stage_candidate[1], 0)
    confirmation_counter := nz(confirmation_counter[1], 0) + 1
else
    confirmation_counter := 1
current_stage := confirmation_counter >= stage_confirm ? stage_candidate : nz(current_stage[1], 0)
stage_name = current_stage == 1 ? 'Stage 1: Basing' : current_stage == 2 ? 'Stage 2: Advancing' : current_stage == 3 ? 'Stage 3: Topping' : current_stage == 4 ? 'Stage 4: Declining' : 'Transition'
current_stage_change = ta.change(current_stage)
stage_changed = current_stage_change != 0

// === VOLUME ANALYSIS ===
vol_sma_20 = ta.sma(volume, 20)
vol_sma_50 = ta.sma(volume, 50)
vol_percentile = ta.percentrank(volume, 50)
vol_spike_strong = volume > vol_sma_20 * vol_mult * 1.5 and vol_percentile > 80
vol_spike_moderate = volume > vol_sma_20 * vol_mult and vol_percentile > vol_percentile_threshold
vol_trend_up = vol_sma_20 > vol_sma_50
vol_confirmed = vol_spike_strong or (vol_spike_moderate and vol_trend_up)

// === ENHANCED RELATIVE STRENGTH ===
rs_security = request.security(rs_symbol, timeframe.period, close, gaps = barmerge.gaps_off)
rs_valid = not na(rs_security) and rs_security > 0
rs_ratio = rs_valid ? close / close[ma_len] / (rs_security / rs_security[ma_len]) : na
rs_normalized = rs_valid ? rs_ratio * 100 : na
rs_sma = ta.sma(rs_normalized, rs_period)
rs_momentum_raw = ta.change(rs_normalized, 5)
rs_momentum = rs_valid ? rs_momentum_raw : na
rs_strong = rs_normalized > rs_threshold and rs_momentum > 0
rs_up = rs_normalized > rs_sma

// === MULTI-TIMEFRAME CONFIRMATION ===
htf_stage = htf_confirmation ? request.security(syminfo.tickerid, htf_timeframe, current_stage) : current_stage
htf_aligned = current_stage == htf_stage or not htf_confirmation

// === INSTITUTIONAL SIGNAL ENGINE ===
rsi_value = ta.rsi(close, 14)
rsi_filter_pass = not rsi_filter_enabled or rsi_value >= rsi_filter_level

signal_score = 0.0
signal_score += current_stage == 2 ? 2.0 : current_stage == 4 ? -2.0 : 0.0
signal_score += rs_strong ? 2.0 : rs_up ? 1.0 : 0.0
signal_score += vol_spike_strong ? 2.0 : vol_spike_moderate ? 1.0 : 0.0
signal_score += ma_rising and price_above_ma ? 1.0 : 0.0
signal_score += ma_falling and price_below_ma ? 1.0 : 0.0
signal_score += htf_aligned ? 1.0 : 0.0
signal_score += rsi_filter_pass ? 1.0 : 0.0

buy_threshold = signal_mode == 'Conservative' ? 6.0 : signal_mode == 'Balanced' ? 5.0 : 4.0
sell_threshold = signal_mode == 'Conservative' ? -4.0 : signal_mode == 'Balanced' ? -3.0 : -2.0

crossover_signal = ta.crossover(close, ma)
crossunder_signal = ta.crossunder(close, ma)

long_signal = current_stage == 2 and price_above_ma and ma_rising and rs_strong and vol_confirmed and htf_aligned and crossover_signal and rsi_filter_pass and signal_score >= buy_threshold
short_signal = current_stage == 4 and price_below_ma and ma_falling and not rs_up and vol_confirmed and htf_aligned and crossunder_signal and signal_score <= sell_threshold
signal_state = long_signal ? 'LONG' : short_signal ? 'SHORT' : 'NEUTRAL'

// === STAGE CHANGE QUALITY ===
stage_change_quality = 'No Change'
if stage_changed
    if current_stage == 2 and vol_spike_strong and rs_strong and ma_rising
        stage_change_quality := 'High Quality Acceleration'
    else if current_stage == 4 and vol_spike_strong and ma_falling and not rs_up
        stage_change_quality := 'High Quality Breakdown'
    else if current_stage == 2
        stage_change_quality := 'Moderate Advance'
    else if current_stage == 4
        stage_change_quality := 'Moderate Breakdown'
    else if current_stage == 1
        stage_change_quality := 'Base Formation'
    else
        stage_change_quality := 'Low Quality Transition'

// === VISUAL ENHANCEMENTS ===
stage_strength = math.abs(ma_slope) * 20
base_transparency = dynamic_transparency ? math.max(70, 90 - stage_strength) : 80
stage_bg_color = show_stage_bg ? current_stage == 1 ? color.new(stage1_bg_col, base_transparency) : current_stage == 2 ? color.new(stage2_bg_col, base_transparency) : current_stage == 3 ? color.new(stage3_bg_col, base_transparency) : current_stage == 4 ? color.new(stage4_bg_col, base_transparency) : na : na
ma_color = current_stage == 2 ? ma_stage2_col : current_stage == 4 ? ma_stage4_col : current_stage == 1 ? ma_stage1_col : current_stage == 3 ? ma_stage3_col : ma_default_col
signal_text = long_signal ? 'LONG' : short_signal ? 'SHORT' : 'WAIT'

// === PLOTTING ===
plot(ma, color = ma_color, linewidth = 2, title = 'Enhanced MA')
bgcolor(stage_bg_color, title = 'Stage Background')
plotshape(vol_spike_strong and show_vol, style = shape.triangleup, location = location.belowbar, color = color.new(vol_strong_col, 0), size = size.normal, title = 'Strong Volume Spike')
plotshape(vol_spike_moderate and show_vol and not vol_spike_strong, style = shape.triangleup, location = location.belowbar, color = color.new(vol_moderate_col, 0), size = size.small, title = 'Moderate Volume Spike')
plotshape(long_signal, style = shape.triangleup, location = location.belowbar, color = color.new(buy_col, 0), size = size.tiny, title = 'Institutional Long')
plotshape(short_signal, style = shape.triangledown, location = location.abovebar, color = color.new(sell_col, 0), size = size.tiny, title = 'Institutional Short')
plotshape(
    stage_changed and show_stage_change_labels and vol_spike_strong,
    style = shape.labelup,
    location = location.abovebar,
    color = current_stage == 2 ? color.new(buy_col, 0) : color.new(sell_col, 0),
    size = size.tiny,
    text = "SC",
    textcolor = color.white,
    title = "Stage Change Quality"
)

plot(rs_normalized, color = rs_line_col, linewidth = 1, title = 'Relative Strength', display = display.pane)
plot(rs_sma, color = color.new(rs_ma_col, 50), linewidth = 1, title = 'RS MA', display = display.pane)
hline(100, 'RS Baseline', color = rs_baseline_col, linestyle = hline.style_dashed)
hline(rs_threshold, 'RS Threshold', color = rs_threshold_col, linestyle = hline.style_dotted)
var label stage_label = na
if bar_index == 0
    stage_label := label.new(bar_index, high, '', color = color.new(color.white, 20), textcolor = label_text_col, size = size.normal, yloc = yloc.abovebar)
    stage_label
if show_labels and (stage_changed or barstate.islast)
    label.set_xy(stage_label, bar_index, high * 1.02)
    label_text = stage_name + (htf_confirmation and not htf_aligned ? ' (HTF Conflict)' : '') + ' | ' + signal_state + ' | ' + stage_change_quality
    label.set_text(stage_label, label_text)
    label.set_color(stage_label, stage_bg_color)
    label.set_textcolor(stage_label, label_text_col)

// === ENHANCED INFO TABLE ===
var table info_table = na
if bar_index == 0
    info_table := table.new(position.top_right, 5, 3, border_width = 1, frame_width = 1, frame_color = color.gray)
    info_table
if barstate.islast and show_table
    // Header row
    table.cell(info_table, 0, 0, 'Metric', bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
    table.cell(info_table, 1, 0, 'Current', bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
    table.cell(info_table, 2, 0, 'Signal', bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
    table.cell(info_table, 3, 0, 'Strength', bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
    table.cell(info_table, 4, 0, 'HTF', bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
    // Stage row
    table.cell(info_table, 0, 1, 'Stage', bgcolor = color.new(color.gray, 80), text_size = size.small)
    table.cell(info_table, 1, 1, str.tostring(current_stage), bgcolor = stage_bg_color, text_size = size.small)
    signal_color = long_signal ? buy_col : short_signal ? sell_col : wait_col
    table.cell(info_table, 2, 1, signal_text, bgcolor = color.new(signal_color, 80), text_size = size.small)
    // Strength indicators
    strength_score = (rs_strong ? 1 : 0) + (vol_spike_moderate ? 1 : 0) + (ma_rising and current_stage == 2 ? 1 : 0)
    strength_text = strength_score >= 2 ? 'HIGH' : strength_score == 1 ? 'MED' : 'LOW'
    strength_color = strength_score >= 2 ? strength_high_col : strength_score == 1 ? strength_med_col : strength_low_col
    table.cell(info_table, 3, 1, strength_text, bgcolor = color.new(strength_color, 80), text_size = size.small)
    table.cell(info_table, 4, 1, htf_aligned ? '✓' : '✗', bgcolor = color.new(htf_aligned ? htf_yes_col : htf_no_col, 80), text_size = size.small)
    // Details row
    rs_text = 'RS: ' + str.tostring(math.round(rs_normalized, 1))
    table.cell(info_table, 0, 2, 'Details', bgcolor = color.new(color.gray, 80), text_size = size.small)
    table.cell(info_table, 1, 2, rs_text, bgcolor = color.new(rs_strong ? rs_cell_strong_col : rs_cell_default_col, 80), text_size = size.small)
    vol_text = 'Vol: ' + (vol_spike_strong ? 'HIGH' : vol_spike_moderate ? 'MED' : 'LOW')
    vol_color = vol_spike_strong ? vol_strong_col : vol_spike_moderate ? vol_moderate_col : vol_cell_low_col
    table.cell(info_table, 2, 2, vol_text, bgcolor = color.new(vol_color, 80), text_size = size.small)
    score_text = 'Score: ' + str.tostring(math.round(signal_score, 1))
    score_bg = long_signal ? buy_col : short_signal ? sell_col : color.gray
    table.cell(info_table, 3, 2, score_text, bgcolor = color.new(score_bg, 80), text_size = size.small)
    confirm_text = str.tostring(confirmation_counter) + '/' + str.tostring(stage_confirm)
    table.cell(info_table, 4, 2, confirm_text, bgcolor = color.new(color.gray, 80), text_size = size.small)

// === COMPANY PARAMETERS BOX ===

// === COMPANY PARAMETERS BOX ===
company_q1_array = str.split(company_q1, "|")
company_q2_array = str.split(company_q2, "|")
company_q3_array = str.split(company_q3, "|")
company_q4_array = str.split(company_q4, "|")

company_row_value(array<string> arr, int idx) =>
    array.size(arr) > idx ? array.get(arr, idx) : "-"

company_name_display = company_name
// Create table once
var table company_table = table.new(position.bottom_right, 8, 8, border_width = 1, frame_width = 1, frame_color = color.gray)

if barstate.islast and show_company_info
    table.clear(company_table, 0, 0, 7, 7)

    // ===== TOP INFO ROWS =====
    table.cell(company_table, 0, 0, "Company", bgcolor = color.new(color.gray, 20), text_color = color.white, text_size = size.small)
    table.cell(company_table, 1, 0, company_name_display, bgcolor = color.new(color.black, 70), text_color = color.white, text_size = size.small)

    table.cell(company_table, 0, 1, "Free Float", bgcolor = color.new(color.gray, 20), text_color = color.white, text_size = size.small)
    table.cell(company_table, 1, 1, display_val(company_free_float), bgcolor = color.new(color.black, 70), text_color = color.white, text_size = size.small)

    table.cell(company_table, 2, 0, "Market Cap", bgcolor = color.new(color.gray, 20), text_color = color.white, text_size = size.small)
    table.cell(company_table, 3, 0, display_val(company_market_cap), bgcolor = color.new(color.black, 70), text_color = color.white, text_size = size.small)

    table.cell(company_table, 2, 1, "Sector", bgcolor = color.new(color.gray, 20), text_color = color.white, text_size = size.small)
    table.cell(company_table, 3, 1, display_val(company_sector), bgcolor = color.new(color.black, 70), text_color = color.white, text_size = size.small)

    table.cell(company_table, 4, 0, "Industry", bgcolor = color.new(color.gray, 20), text_color = color.white, text_size = size.small)
    table.cell(company_table, 5, 0, display_val(company_industry), bgcolor = color.new(color.black, 70), text_color = color.white, text_size = size.small)

    // ===== QUARTERLY HEADER =====
    table.cell(company_table, 0, 3, "FQ", bgcolor = color.new(color.gray, 35), text_color = color.white, text_size = size.small)
    table.cell(company_table, 1, 3, "Net Profit", bgcolor = color.new(color.gray, 35), text_color = color.white, text_size = size.small)
    table.cell(company_table, 2, 3, "YoY", bgcolor = color.new(color.gray, 35), text_color = color.white, text_size = size.small)
    table.cell(company_table, 3, 3, "QoQ", bgcolor = color.new(color.gray, 35), text_color = color.white, text_size = size.small)
    table.cell(company_table, 4, 3, "Sales", bgcolor = color.new(color.gray, 35), text_color = color.white, text_size = size.small)
    table.cell(company_table, 5, 3, "YoY", bgcolor = color.new(color.gray, 35), text_color = color.white, text_size = size.small)
    table.cell(company_table, 6, 3, "QoQ", bgcolor = color.new(color.gray, 35), text_color = color.white, text_size = size.small)
    table.cell(company_table, 7, 3, "OPM%", bgcolor = color.new(color.gray, 35), text_color = color.white, text_size = size.small)

    // ===== Q1 =====
    for i = 0 to 7
        table.cell(company_table, i, 4, company_row_value(company_q1_array, i), bgcolor = color.new(color.black, 80), text_color = color.white, text_size = size.small)

    // ===== Q2 =====
    for i = 0 to 7
        table.cell(company_table, i, 5, company_row_value(company_q2_array, i), bgcolor = color.new(color.black, 80), text_color = color.white, text_size = size.small)

    // ===== Q3 =====
    for i = 0 to 7
        table.cell(company_table, i, 6, company_row_value(company_q3_array, i), bgcolor = color.new(color.black, 80), text_color = color.white, text_size = size.small)

    // ===== Q4 =====
    for i = 0 to 7
        table.cell(company_table, i, 7, company_row_value(company_q4_array, i), bgcolor = color.new(color.black, 80), text_color = color.white, text_size = size.small)
                    // === ENHANCED ALERTS ===
alertcondition(long_signal, 'Long Entry - Institutional', 'Institutional long signal: Stage 2 confirmed with strong RS, volume, and trend alignment')
alertcondition(short_signal, 'Short Entry - Institutional', 'Institutional short signal: Stage 4 confirmed with weakening trend and volume support')
alertcondition(stage_changed and vol_spike_strong, 'Stage Change - High Volume', 'A stage change occurred with high volume. Review the quality of the transition.')
alertcondition(rs_strong and rs_momentum > 0, 'Strong RS Signal', 'Relative strength is strong and rising.')
