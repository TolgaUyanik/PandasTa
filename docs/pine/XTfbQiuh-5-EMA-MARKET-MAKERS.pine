//@version=6
indicator("5 EMA MARKET MAKERS", overlay=true)

// ———————————————————— 1. HARD-CODED CALCULATIONS ————————————————————
ema5   = ta.ema(close, 5)
ema13  = ta.ema(close, 13)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
ema800 = ta.ema(close, 800)

// Hard-coded Colors
col5   = color.green
col13  = color.red
col50  = color.blue
col200 = color.white
col800 = color.purple

// ———————————————————— 2. USER INPUTS (STYLE ONLY) ————————————————————
getLineStyle(styleStr) =>
    switch styleStr
        "Dotted" => plot.linestyle_dotted
        "Dashed" => plot.linestyle_dashed
        => plot.linestyle_solid

styleGroup = "Line Styles & Thickness"

// 5 EMA Style Inputs
style5Str  = input.string("Solid", "5 EMA Line Style", options=["Solid", "Dotted", "Dashed"], group=styleGroup)
width5     = input.int(1, "5 EMA Line Width", minval=1, maxval=5, group=styleGroup)

// 13 EMA Style Inputs
style13Str = input.string("Solid", "13 EMA Line Style", options=["Solid", "Dotted", "Dashed"], group=styleGroup)
width13    = input.int(1, "13 EMA Line Width", minval=1, maxval=5, group=styleGroup)

// 50 EMA Style Inputs
style50Str = input.string("Solid", "50 EMA Line Style", options=["Solid", "Dotted", "Dashed"], group=styleGroup)
width50    = input.int(2, "50 EMA Line Width", minval=1, maxval=5, group=styleGroup)

// 200 EMA Style Inputs
style200Str = input.string("Solid", "200 EMA Line Style", options=["Solid", "Dotted", "Dashed"], group=styleGroup)
width200    = input.int(2, "200 EMA Line Width", minval=1, maxval=5, group=styleGroup)

// 800 EMA Style Inputs
style800Str = input.string("Solid", "800 EMA Line Style", options=["Solid", "Dotted", "Dashed"], group=styleGroup)
width800    = input.int(3, "800 EMA Line Width", minval=1, maxval=5, group=styleGroup)

// ———————————————————— 3. PLOTS ————————————————————
plot(ema5,   title="5 EMA",   color=col5,   linewidth=width5,   linestyle=getLineStyle(style5Str))
plot(ema13,  title="13 EMA",  color=col13,  linewidth=width13,  linestyle=getLineStyle(style13Str))
plot(ema50,  title="50 EMA",  color=col50,  linewidth=width50,  linestyle=getLineStyle(style50Str))
plot(ema200, title="200 EMA", color=col200, linewidth=width200, linestyle=getLineStyle(style200Str))
plot(ema800, title="800 EMA", color=col800, linewidth=width800, linestyle=getLineStyle(style800Str))