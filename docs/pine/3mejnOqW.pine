//@version=6
//by DieciTrader

indicator('ST HA', overlay = true)

Factor = input.int(2, minval = 1, maxval = 100)
Pd = input.int(10, minval = 1, maxval = 100)

openHAPrev = (open[3] + close[3]) / 2
closeHAPrev = (open[2] + high[2] + low[2] + close[2]) / 4

ha_handle = ticker.heikinashi(syminfo.tickerid)
openHA = request.security(ha_handle, timeframe.period, open, lookahead = barmerge.lookahead_off)
closeHA = request.security(ha_handle, timeframe.period, close, lookahead = barmerge.lookahead_off)
highHA = request.security(ha_handle, timeframe.period, high, lookahead = barmerge.lookahead_off)
lowHA = request.security(ha_handle, timeframe.period, low, lookahead = barmerge.lookahead_off)
atrHA = request.security(ha_handle, timeframe.period, ta.atr(Pd), lookahead = barmerge.lookahead_off)

hl2HA = (highHA + lowHA) / 2

MUp = hl2HA - Factor * atrHA
MDn = hl2HA + Factor * atrHA
Mclose = closeHA

MTrendUp = 0.0
MTrendDown = 0.0
Mlinecolor = color(na)
BGlinecolor = color(na)

golong = bool(na)
goshort = bool(na)
up = float(na)
down = float(na)

MTsl = 0.0
MTrend = 0.0

MTrendUp := Mclose[1] > MTrendUp[1] ? math.max(MUp, MTrendUp[1]) : MUp
MTrendDown := Mclose[1] < MTrendDown[1] ? math.min(MDn, MTrendDown[1]) : MDn

MTrend := Mclose > MTrendDown[1] ? 1 : Mclose < MTrendUp[1] ? -1 : nz(MTrend[1], 1)
MTsl := MTrend == 1 ? MTrendUp : MTrendDown

Mlinecolor := MTrend == 1 ? color.green : color.red
plot(MTsl, color = Mlinecolor, style = plot.style_line, linewidth = 1)
bgcolor(Mlinecolor)


BGlinecolor := close > MTsl[1] ? color.green : color.red

golong := close > MTsl // and Trend == 1 //and MTrend == 1
goshort := close < MTsl // and Trend == -1 //and MTrend == -1

alertcondition(golong, title = 'ST HA Long', message = 'ST HA Long')
alertcondition(goshort, title = 'ST HA Short', message = 'ST HA Short')
