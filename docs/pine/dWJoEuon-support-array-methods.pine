//@version=5
library("support_array_methods")
// @function delete duplicate element from array
// @param _array array for delete duplicate
// @returns duplicate-free array
export method unic(array<string> _array)=>
    temp = array.new<string>()
    for [i,v] in _array
        if not temp.includes(v)
            temp.push(v)
    _array.clear()
    _array.concat(temp)
export method unic(array<float> _array)=>
    temp = array.new<float>()
    for [i,v] in _array
        if not temp.includes(v)
            temp.push(v)
    _array.clear()
    _array.concat(temp)
