export method unic(array<bool> _array)=>
    temp = array.new<bool>()
    for [i,v] in _array
        if not temp.includes(v)
            temp.push(v)
    _array.clear()
    _array.concat(temp)

export identical(int [] firsts,int [] seconds)=>
    bool result = na
    if firsts.size() == seconds.size()
        for [index,value] in firsts
            if value != seconds.get(index)
                result := false
                break        
            else
                result := true
    else
        result := false 
    result
