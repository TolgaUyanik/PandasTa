library("lib_math", overlay=true)

///////////////////////////////////////////////////////////////////
//                             RANGES
///////////////////////////////////////////////////////////////////

//@function checks if a given value is within a range (max, min)
export in_range(float value, float max, float min = 0) => min <= value and value <= max
//@function checks if a given value is within a range (max, min)
export in_range(int   value, int   max, int   min = 0) => min <= value and value <= max

//@function checks if a given range (max1, min1) is within another range (max2, min2)
export in_range(float max1, float min1, float max2, float min2) => min2 <= min1 and min1 <= max2 and min2 <= max1 and max1 <= max2
//@function checks if a given range (max1, min1) is within another range (max2, min2)
export in_range(int   max1, int   min1, int   max2, int   min2) => min2 <= min1 and min1 <= max2 and min2 <= max1 and max1 <= max2

//@function checks if a given range (max1, min1) overlaps another range (max2, min2)
export range_overlap(float max1, float min1, float max2, float min2) => min1 < max2 and max1 > min2
//@function checks if a given range (max1, min1) overlaps another range (max2, min2)
export range_overlap(int   max1, int   min1, int   max2, int   min2) => min1 < max2 and max1 > min2


//@function convert value in range A to value in range B
//@param x the input data series within range 1, to be mapped to range 2
//@param max1 the maximum value in range 1 (origin)
//@param min1 the minimum value in range 1 (origin)
//@param max2 the maximum value in range 2 (target)
//@param min2 the minimum value in range 2 (target)
export mapping_linear(float x, float max1 = 100, float min1 = 0, float max2 = 1, float min2 = -1) =>
	min2 + (max2 - min2) * (x - min1) / (max1 - min1)
        

//@function fully customizable version of mapping_sigmoid (upper, lower, center, range_ratio, speed). This version adjusts the lower range's speed for imbalanced upper/lower range sizes, so the slope before and after crossing the center stays the same
//@param speed_scale defines the slope of the sigmoid curve (how fast x values are approaching the bounds)
//@param upper_bound the maximum value for input values towards positive infinity 
//@param lower_bound the minimum value for input values towards negative infinity 
//@param center the center value
export mapping_sigmoid(float x, float speed_scale = 1, float upper_bound = 1, float lower_bound = -1, float center = 0) =>
    x > 0
     ? (upper_bound - center) * ( - math.exp( speed_scale * -x                                                 ) + 1) + center
     : (center - lower_bound) * (   math.exp( speed_scale *  x * (upper_bound - center)/(center - lower_bound) ) - 1) + center

//@function simplified version of mapping_sigmoid, no adjusted lower range speed, equal range size (center to edge, i.e. actually half range)
//@param speed_scale defines the slope of the sigmoid curve (how fast x values are approaching the bounds)
//@param range_size instead of defining separate upper_bound/lower_bound, we add this value above and below the center to get balanced range sizes
//@param center the center value
export mapping_sigmoid_fast(float x, float speed_scale = 1, float range_size = 1, float center = 0) =>
    x > 0
     ? range_size * ( - math.exp( speed_scale * -x ) + 1) + center
     : range_size * (   math.exp( speed_scale *  x ) - 1) + center

//@function simplified version of mapping_sigmoid, with a fixed output range -1 | 0 | 1
//@param speed_scale defines the slope of the sigmoid curve (how fast x values are approaching the bounds)
export mapping_sigmoid_1_0_1(float x, float speed_scale = 1) =>
    x > 0
     ? - math.exp( speed_scale * - x ) + 1
     :   math.exp( speed_scale *   x ) - 1

//@function simplified version of mapping_sigmoid, with a fixed output range 0 | 0,5 | 1
//@param speed_scale defines the slope of the sigmoid curve (how fast x values are approaching the bounds)
export mapping_sigmoid_0_05_1(float x, float speed_scale = 1) =>
    x > 0
     ? ( - math.exp( speed_scale * -x ) + 1) / 2 + 0.5
     : (   math.exp( speed_scale *  x ) - 1) / 2 + 0.5

//@function simplified version of mapping_sigmoid, with a fixed positive output range 0 | 1 (negative x inputs default to 0)
//@param scale defines the slope of the sigmoid curve (how fast x values are approaching the bounds)
export mapping_sigmoid_upper_0_1(float x, float scale = 1) =>
    x < 0 ? 0 : - math.exp( scale * - x ) + 1



///////////////////////////////////////////////////////////////////
//            continous STATISTICS (with reset signal)
///////////////////////////////////////////////////////////////////


//@description Calculates a mean value over time, with option to reset, this is not using the history operator, so won't trigger max_bars_back errors
//@param value series to track
//@param reset flag to reset tracking
//@return returns average/mean of value since last reset
export mean(float value, bool reset = false) =>
    var sum = 0.0
    var len = 0
    var last = 0.0

    if reset
        sum := last
        len := 1
    
    len := len + 1
    sum := sum + value
    last := value
    sum / len

//@description calculates the vwap manually, this is not using the history operator, so won't trigger max_bars_back errors
//@param value series to track
//@param reset flag to reset tracking
//@return returns vwap of value and volume since last reset
export vwap(float value, bool reset) =>
    // Initialize cumulative price and volume
    var cum_price_volume = 0.0
    var cum_volume = 0.0

    if reset
        cum_price_volume := 0.0    
        cum_volume := 0.0

    // Calculate conditional VWAP only when the session is active
    cum_price_volume    := cum_price_volume + (value * volume)
    cum_volume          := cum_volume + volume
    
    vwap = cum_price_volume / cum_volume
    vwap

//@description Calculates the variance of a value over time, with option to reset, this is not using the history operator, so won't trigger max_bars_back errors
//@param value series to track
//@param reset flag to reset tracking
//@return returns variance of value since last reset
export variance(float value, bool reset) =>
    var avg = 0.0
    var sum = 0.0
    var len = 0
    var last = 0.0

    if reset
        avg := last
        sum := last
        len := 1
    
    last := value
    len := len + 1
    avg := mean(value, reset)
    sum := sum + math.pow(value - avg, 2)
    sum / len


//@description Calculates the std deviation, this is not using the history operator, so won't trigger max_bars_back errors
//@param value series to track
//@param reset flag to reset tracking
//@return stddev how far the values deviate from the trend
export stddev(float value, bool reset)=>
    math.sqrt(variance(value, reset))


//@description Calculates the linear regression of a value over time, with option to reset
//@param value series to track
//@param reset flag to reset tracking
//@return [slope, y1, y2, length] where slope is the trend direction, y1 is the value a time of reset, y2 is the value on the current bar, len is the x-length of the regression line
export linreg(float value, bool reset) =>
    var sum_x = 0.0
    var sum_y = 0.0
    var sum_xy = 0.0
    var sum_x2 = 0.0
    var len = 0

    if reset
        sum_x := 0.0
        sum_y := 0.0
        sum_xy := 0.0
        sum_x2 := 0.0
        len := 0

    len := len + 1
    sum_x  += len
    sum_y  += value
    sum_xy += len * value
    sum_x2 += len * len

    slope = (len * sum_xy - sum_x * sum_y) / math.max(len * sum_x2 - sum_x * sum_x, 0.0000000001)
    y1 = (sum_y - slope * sum_x) / len // y1 = intercept
    y2 = y1 + slope * len
    
    [slope, y1, y2, len] // x1 = 0, x2 = len

//Get trendline coordinates

//@description Calculates the trend correlation, deviation and start and end coordinates of a trendline, this is not using the history operator, so won't trigger max_bars_back errors
//@param value series to track
//@param reset flag to reset tracking
//@return [slope, correlation, stddev, y1 , y2, len] where slope is the trend direction, correlation is a measurement for how well the values fit to the trendline (positive means ), stddev is how far the values deviate from the trend, y1 is the y-coordinate at trend line start, y2 is the y-coordinate at trend line end, len is the x-length of the trend line, x1 would be the time where reset is true and x2 would be the current time
export trend(float value, bool reset)=>
    var len = 1
    var last = value // modification, so we consider the session open as well
    var float sum_wma  = na
    var float sum_sma  = na
    var float sum_sma2 = na

    if reset
        len   := 1
        sum_wma  := last
        sum_sma  := last
        sum_sma2 := last * last
    last := value    

    len   += 1    
    half_len = (len+1)/2
    sum_sma  += value
    sum_sma2 += value * value
    sum_wma  += value * len // weighted MA => increased significance of recent price data => regression line slope

    sma = sum_sma / len // simle moving average
    sma2 = sum_sma2 / len
    wma = sum_wma / len / half_len // weighted moving average, weight is time/bar_index, centered via division by half_len

    cov   = (wma - sma) * half_len // covariance (how well the averages align)
    stddev = math.sqrt(sma2 - sma * sma) // stddev = root of [avg of (squared)value - (squared)avg of value]
    
    // squared pearson correlation coefficient (r²) (adapted to bars as time representation)
    // => correlation coefficient => indicates how well line fits the values 0-1, however 1 might be overfitting
    correlation = cov / (stddev * (math.sqrt(len*len - 1) / (2 * math.sqrt(3))))

    y1 = 4 * sma - 3 * wma
    y2 = 3 * wma - 2 * sma
    slope = (y2 - y1) / len

    [slope, correlation, stddev, y1 , y2, len]




///////////////////////////////////////////////////////////////////
//                             DEMO
///////////////////////////////////////////////////////////////////

var label demo_warning = label.new(bar_index,na,'for correct demo display,\nuse this in intraday timeframes', color = color.red, style = label.style_label_left, force_overlay = true)
if not timeframe.isintraday
    demo_warning.set_xy(bar_index + 1, close)

// new_day = timeframe.change('D') // delayed one bar ... :(
new_day = dayofweek[1] != dayofweek
var last_start = bar_index
var day_start = bar_index
var last_y1 = open
var day_y1 = open
if new_day
    last_y1 := day_y1
    day_y1 := open
    last_start := day_start
    day_start := bar_index

mean = mean(close, new_day)
vwap = vwap(close, new_day)
variance = variance(close, new_day)
stddev1 = stddev(close, new_day)
[linreg1_slope, linreg1_y1, linreg1_y2, linreg1_len] = linreg(close, new_day)
[linreg_h_slope, linreg_h_y1, linreg_h_y2, linreg_h_len] = linreg(high, new_day)
[linreg_l_slope, linreg_l_y1, linreg_l_y2, linreg_l_len] = linreg(low, new_day)
[slope, correlation, stddev, y1 , y2, linreg2_len] = trend(close, new_day)

bars = day_start - last_start + 1
tv_stddev = ta.stdev(close, bars)
tv_mean = ta.sma(close, bars)
tv_vwap = ta.vwap(close, new_day)
tv_correlation = ta.correlation(close, bar_index, bars)
tv_y2 = ta.linreg(close, bars, 0)
tv_var = ta.variance(close, bars, biased = false)
tv_y1 = tv_mean + (tv_mean - tv_y2)
tv_slope = (tv_y2 - tv_y1) / bars

if new_day and bar_index > bars
    line.new(bar_index, 0, bar_index, 1, extend = extend.both, style = line.style_dotted, force_overlay = true)

    line.new(last_start, mean[1], day_start, mean[1], force_overlay = true)
    // label.new(day_start, y2[1], str.format('mean: {0} | {6}\nslope: {1} | {8}\ncorrelation: {2} | {7}\nstddev: {3} | {4} | {5}', mean[1], slope[1], correlation[1], stddev[1], tv_stddev[1], tv_stddev_unbiased[1], tv_mean[1], tv_correlation[1], tv_slope[1]), textcolor = color.white, style = label.style_label_left, force_overlay = true)
    label.new(day_start, y2[1], str.format('mean: {0} | {6}\nslope: {1} | {8}\ncorrelation: {2} | {7}\nstddev: {3} | {4} | {5}', mean[1], slope[1], correlation[1], stddev[1], tv_stddev[1], tv_stddev[1], tv_mean[1], tv_correlation[1], tv_slope[1]), textcolor = color.white, style = label.style_label_left, force_overlay = true)

var tv_trendline     = line.new(na,na,na,na, force_overlay = true, color = color.fuchsia, width = 2              )
var trendline        = line.new(na,na,na,na, force_overlay = true, color = color.red                             )
var linregline       = line.new(na,na,na,na, force_overlay = true, color = color.purple                          )
var linregline_highs = line.new(na,na,na,na, force_overlay = true, color = color.green, style = line.style_dotted)
var linregline_lows  = line.new(na,na,na,na, force_overlay = true, color = color.red  , style = line.style_dotted)
var x1 = bar_index

if not barstate.isfirst
    if new_day
        tv_trendline.copy()
        trendline.copy()
        linregline.copy()
        linregline_highs.copy()
        linregline_lows.copy()
        x1 := bar_index

    trendline.set_xy1(x1, y1)
    trendline.set_xy2(bar_index, y2)
    tv_trendline.set_xy1(x1, tv_y1)
    tv_trendline.set_xy2(bar_index, tv_y2)
    linregline.set_xy1(x1, linreg1_y1)
    linregline.set_xy2(bar_index, linreg1_y2)
    linregline_highs.set_xy1(x1, linreg_h_y1)
    linregline_highs.set_xy2(bar_index, linreg_h_y2)
    linregline_lows.set_xy1(x1, linreg_l_y1)
    linregline_lows.set_xy2(bar_index, linreg_l_y2)


plot(tv_vwap, 'tv_vwap', color.blue, linewidth = 2, style = plot.style_linebr, force_overlay = true)
plot(vwap   , 'vwap'   , color.red , linewidth = 2, style = plot.style_linebr, force_overlay = true)
