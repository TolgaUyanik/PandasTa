//@version=5

// @description Contains functions for concatenation and wrapping of strings:
// - concatTrunc concatTrunc2() - Concatenate via a separator up to a given length (default - 4096) truncating from left or right. concatTrunc2 returns also the number of overflowing chars (in a tuple)
// - print()  - A powerful concatenate function truncating chars from left or right and/or lines from top or bottom .  By default just adds new lines respecting max length.
// - wrap() - Wraps each line of the text adding prefix/postfix. If resulting string exceeds max length truncates from the end adding "[...]"
// - scroll() -  Returns a range of lines from the source string. 
library("StrConcatWrap")
import moebius1977/RegexLib/1


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          StringLib LIBRARY FUNCTIONS                         ┃ {



// _̿_̿_̿_̿_̿_̿_̿  concatTrunc() / concatTrunc2()   _̿_̿_̿_̿_̿_̿_̿  {
// Concatenate truncating from left or right 

// ━━━━━ method concatTrunc2() ━━━━━ {
// @function Concatenates two strings leaving _max_length chars truncating from left/right. 
// (cuts off from the end of the string by default). 
// @param this string to which txt is added  
// @param txt string to be added to this  
// @param max_length (int) (Optional) max length of string, default: 4096  
// @param separator (string) (Optional) If both this and txt are non empty separator is added in between. Usually "\n" is used. 
// @param truncate_left (bool) (Optional) if true truncates left string (this), if false - txt. Default - false (truncates txt)  
// @param ignore_empty_strings (bool) (Optional) if true and one of `this` or `txt` is empty just returns the other, if false - adds separator.
// @returns (tuple [string, int]) A tuple [concatenated string, number of chars exceeding max_length (including separator)]
// e.g. if `this` is 4095 chars and separator is 2 chars then 4095+2=4097 exceeds default max_length = 4096 by 1, so
// [this, 1] will be returned, even if , e.g. `txt` is empty and  `ignore_empty_strings` is true
export method concatTrunc2(string this
						  , string txt
						  , string separator = ""
						  , int max_length = 4096
						  , bool truncate_left = false
						  , bool ignore_empty_strings = true
						  ) =>
	_s_out = ""
	_thisSepL =  str.length(this) + str.length(separator)
	d =math.max(0, _thisSepL + str.length(txt) - max_length)
	if d > 0 
		if ignore_empty_strings and (txt =="" or this == "")
			// truncate source if necessary 
			_t = this+txt
			if not truncate_left
				[str.substring(_t, 0, max_length), d]
			else 
				[str.substring(_t, math.max(0, str.length(_t)-max_length),str.length(_t)), d]
		else 
			if not truncate_left 
				if  _thisSepL < max_length  
					// negative d is ok since str.substtring() can accept `to` higher than string length 
					thisSep = this + separator 
					_s_out := thisSep + str.substring(txt, 0, str.length(txt)- d) // cut out last d chars from _txt
					[_s_out, d]
				else // this + separator alone exceed max_length, let's truncate this if necessary
					[str.substring(this, 0, max_length), d]
			else if truncate_left 
				if str.length(separator) + str.length(txt) < max_length
					sepTxt =  separator +txt
					_s_out := str.substring(this, d)  + sepTxt // cut out first d chars from thisSep
					[_s_out, d]
				else
					[str.substring(txt, math.max(0, str.length(txt)-max_length),str.length(txt)), d]
	else
		if ignore_empty_strings and (txt =="" or this == "")
			[this+txt, d]
		else
			[this+separator+txt, d]

// END OF concat }

// ━━━━━ method concatTrunc() ━━━━━ {
// @function Concatenates two strings leaving _max_length chars truncating from left/right. 
// (cuts off from the end of the string by default)
// @param this string to which txt is added  
// @param txt string to be added to this  
// @param max_length max length of string, default: 4096  
// @param separator If both this and txt are non empty separator is added in between. Usually "\n" is used. 
// @param truncate_left if true truncates left string (this), if false - txt. Default - false (truncates txt)  
// @param ignore_empty_strings (bool) (Optional) if true and one of `this` or `txt` is empty just returns the other, if false - adds separator.
// @returns (string) Resulting string
export method concatTrunc(string this
						  , string txt
						  , string separator = ""
						  , int max_length = 4096
						  , bool truncate_left = false
						  , bool ignore_empty_strings = true
						  ) =>
	[_resS, _resB] = this.concatTrunc2(txt, separator, max_length, truncate_left, ignore_empty_strings)
	_resS
// END OF concat }

// Δ̲Δ̲Δ̲ END OF concatTrunc() / concatTrunc2() Δ̲Δ̲Δ̲ }

// ━━━━━ method printLines(string s, string txt ) ━━━━━ {
// @function Adds up to  `max_lines` lines from `txt` to `this` observing `max_length`, truncating from left or right
// (truncating source strings `this` and/or `txt` themselves if necessary). 
// @param this (string) Print outputs `txt` to the end of `this`
// @param txt (string) Print outputs `txt` to the end of `this`
// @param max_length (int) (Optional) Chars in excess of `max_length` will be truncated (ending chars by default, see `truncate_left` arg). Default: 4096
// @param max_lines (int) (Optional) Lines in excess of `max_lines` will be truncated (from end by default, see `truncate_left` arg). Default: 4096
// @param line_break_regex (string) (Optional) A regex expression used to search for linebrakes. Default is  "(\\n|\\r|\\r\\n)" 
// @param line_break (string) (Optional) A string added as a line break. Default is "\n".
// @param truncate_left (bool) (Optional) If true chars in excess of `max_length` will be truncated from the beginning , if false - from the end. Default: false. 
// @param ignore_empty_strings (bool) (Optional) If false a line break will be added (as an empty string), if false `this` will not change.
// @param add_line_numbers (bool) (Optional) If true adds number before each line. Default format: "LN0001". Custom fomat can be set with `line_number_format'. 
// @param line_numbers_format (string) (Optional) Line number format (like in `str.format()`). Default: `"LN{0000: }"`
// @param print_to_last_line (string) (Optional) If true will add text to the last line (notwithout adding line break before the first added line). Default: false.
// @returns `[outS, intLenthOverflow, n]` where `outS` = `this` + added lines, 
// `intLenthOverflow` = number of truncated chars (including separator),
// e.g. if `this` is 4095 chars and separator is 2 chars then 4095+2=4097 exceeds default max_length = 4096 by 1, so
// [this, 1] will be returned, even if , e.g. `txt` is empty and  `ignore_empty_strings` is true, 
// and n - number of added lines
method printLines(string this
				  , string	txt
				  , int		max_length				= 4096
				  , int		max_lines 				= 99999999999
				  , string	line_break_regex		= "(\\n|\\r|\\r\\n)"
				  , string	line_break				= "\n"
				  , bool	truncate_left			= false
				  , bool	ignore_empty_strings	= true
				  , bool 	add_line_numbers 		= false
				  , string 	line_number_format 		= "LN{0000}: "
				  , int 	start_line_number 		= 1
				  , bool 	print_to_last_line 		= false
				  ) => 

	n =  0 // count added lines
	d = 0 // max_length exceeded by (chars)
	_line_break = line_break
	// add line number to the first string, truncating from the right regardless of truncate_left settings.
	// outS = concatTrunc(add_line_numbers ? str.format(line_number_format, n) : "", this, "", max_length, truncate_left = false, ignore_empty_strings = true)
	first_run = true
	outS = this
	endS = txt // start with adding lines from this one by one 
	while endS != "" and n  < max_lines and (d <= 0 or truncate_left == true)
		[_begS, _lnbrS, _endS] = endS.feedRgx(line_break_regex) // feed a line into _begS
		n+=  1 // _begS may be empty if endS starts with line break, then empty line is added 
		if add_line_numbers
			if outS == "" and ignore_empty_strings == true // in this case no separator/linebreak is added before the first line, so have to add line number manually.
				_line_break :=  ""
				outS := str.format(line_number_format, start_line_number + n)
			else
				_line_break := line_break + str.format(line_number_format, start_line_number + n) // hope this will not exceed 4096 at least ... :)

		[_outS, _d] = outS.concatTrunc2 (_begS, first_run and print_to_last_line ? "" :  _line_break, max_length, truncate_left, true)
		d := _d
		outS := _outS
		endS := _endS
		first_run := false

	[outS, d, n] 
// END OF printLines() }

// ━━━━━ method print(string s, string txt ) ━━━━━ {
// @function A powerful concatenate function truncating chars from left or right and/or lines from top or bottom. In simplest form (`this.print(txt)`) just adds `txt` to the end of `this`  (NB! does not change `this`)
// starting from new line. If `print_to_last_line` is true then concatenates. Can truncate for _max_length 
// (from right by default) and max_lines (truncating from top or bottom). 
// (First removes excessive lines (over `max_lines`) then concatenates truncating for `max_length`.)
// `print()` looks for all kinds of line breaks (`\r`, `\n` or `\r\n`) and replaces them with `\n`.
// kinds )
// @param this (string) Print outputs `txt` to the end of `this`
// @param txt (string) Print outputs `txt` to the end of `this`
// @param max_length (int) (Optional) Chars in excess of `max_length` will be truncated (ending chars by default, see `truncate_left` arg). Default: 4096
// @param max_lines (int) (Optional) Lines in excess of `max_lines` will be truncated (from end by default, see `truncate_left` arg). Default: 4096
// @param truncate_left (bool) (Optional) If true chars in excess of `max_length` will be truncated from the beginning , if false - from the end. Default: false. 
// @param truncate_top (bool) (Optional) If true lines in excess of `max_lines` will be truncated from the top, if false - from the bottom. Default: false. 
// @param truncate_lines_src (bool) (Optional) If true and either `this` or `txt` exceed `max_lines` they will be 
// truncated (excessive lines removed). (Characters in excess of max_length will be truncated regardless). 
// If truncate_top and txt has more than max_lines lines excessive lines will be truncated from the top. (if truncate_top escessive lines from `this` will be truncated regardless of truncate_src)
// If not truncate_top and this has more than max_lines lines excessive lines will be truncated from the bottom. (if not truncate_top escessive lines from `txt` will be truncated regardless of truncate_src)
// @param add_line_numbers (bool) (Optional) If true adds number before each line. Default format: "LN0001". Custom fomat can be set with `line_number_format'. 
// @param line_numbers_format (string) (Optional) Line number format (like in `str.format()`). Default: `"LN{0000: }"`
// @param print_to_last_line (string) (Optional) If true will add text to the last line (notwithout adding line break before the first added line). Default: false.
export method print(string this
			  , string txt
			  , int max_length = 4096
			  , int max_lines = 4096
			//   , bool truncate_src = false
			  , bool truncate_left = false
			  , bool truncate_top = false
			  , bool truncate_lines_src = true
			  , bool add_line_numbers = false
			  , string line_number_format = "LN{0000}: "
			  , bool print_to_last_line = false
			//   , bool print_below = true
			  ) =>
	const string rgxLNBR = "(\\n|\\r|\\r\\n)"
	const string LNBR = "\n"
	lineCountThis = this.countRgx(rgxLNBR)+1
	lineCountTxt = txt.countRgx(rgxLNBR)+1
	lnBrAdj = print_to_last_line and (this != "" and txt != "") ? 1 : 0
	lineExcess = math.max(0, lineCountThis + lineCountTxt - max_lines - lnBrAdj ) // number of escessive lines if any. Will be truncated.

	// if - logic with feedRgx(), else - without for now
	// lineExcess <=0 means no lines to truncate, can be processed with normal truncate_top = false branch
	if not truncate_top or lineExcess <=0	// truncate bottom
		// log.info("\n--- not truncate_top or lineExcess <=0 ---\n")
		[_out1, _intLengthOverflow1, _addedLines1] = "".printLines(
														  txt						= this		
														  , max_length				= max_length				
														  , max_lines				= truncate_lines_src ? max_lines : 9999999999				
														  , line_break_regex		= rgxLNBR						
														  , line_break				= LNBR				
														  , truncate_left			= truncate_left					
														  , ignore_empty_strings	= true
														  , add_line_numbers		= add_line_numbers
														  , line_number_format		= line_number_format
														  , start_line_number		= 1
														  , print_to_last_line		= false
														  )							
		if (_intLengthOverflow1 <= 0 or truncate_left == true) and  _addedLines1 <= max_lines  and txt != "" // there is room to add more lines from txt
			[_out2, _intLengthOverflow2, _addedLines2] = _out1.printLines(
														  txt						= txt		
														  , max_length				= max_length				
														  , max_lines				= max_lines - _addedLines1 + (max_lines >= lineCountThis?  lnBrAdj : 0)			
														  , line_break_regex		= rgxLNBR						
														  , line_break				= LNBR				
														  , truncate_left			= truncate_left					
														  , ignore_empty_strings	= true
														  , add_line_numbers		= add_line_numbers
														  , line_number_format		= line_number_format
														  , start_line_number		= _addedLines1 + 1
														  , print_to_last_line		= print_to_last_line
														  )							
			// log.info("\n _addedLines1 = {0}, _addedLines2 = {1}, \n_out2\n---\n{2}", _addedLines1, _addedLines2, _out2)
			_out2
		else
			_out1
	else // truncate from top, truncate source, lineExcess is > 0 in this branch
		if lineCountTxt == max_lines and lnBrAdj == 0  // just print txt
			// log.info("\n--- lineCountTxt == max_lines ---\n")
			[_out1, _intLengthOverflow1, _addedLines1] = "".printLines(
														  txt						= txt		
														  , max_length				= max_length				
														  , max_lines				= truncate_lines_src ? max_lines : 9999999999		
														  , line_break_regex		= rgxLNBR						
														  , line_break				= LNBR				
														  , truncate_left			= truncate_left					
														  , ignore_empty_strings	= true
														  , add_line_numbers		= add_line_numbers
														  , line_number_format		= line_number_format
														  , start_line_number		= lineCountThis + 1
														  , print_to_last_line		= print_to_last_line
														  )	
			_out1						

		else if lineCountTxt > max_lines // take last max_lines lines from txt
			// log.info("\n--- lineCountTxt > max_lines ---\n")
			// truncate txt 
			if truncate_lines_src  // print last max_line lines from txt
				[lnbrS, lnBrPos, lnbrL] = txt.matchRgx(rgxLNBR, lineCountTxt- max_lines)
				_txt = str.substring(txt, lnBrPos + str.length(lnbrS))
				[_out1, _intLengthOverflow1, _addedLines1] = "".printLines(
														  txt						= _txt		
														  , max_length				= max_length				
														  , max_lines				= max_lines				
														  , line_break_regex		= rgxLNBR						
														  , line_break				= LNBR				
														  , truncate_left			= truncate_left					
														  , ignore_empty_strings	= true
														  , add_line_numbers		= add_line_numbers
														  , line_number_format		= line_number_format
														  , start_line_number		= lineExcess +1
														  , print_to_last_line		= print_to_last_line
														  )							
				// log.info("lnBrPos = {0}, _txt=\n {1}", lnBrPos, _txt)
				_out1
				
			else // txt has too many lines, but no truncating, print it all 
				// log.info("\n--- txt has too many lines ---\n")
				[_out1, _intLengthOverflow1, _addedLines1] = "".printLines(
														  txt						= txt		
														  , max_length				= max_length				
														  , max_lines				= 999999999999				
														  , line_break_regex		= rgxLNBR						
														  , line_break				= LNBR				
														  , truncate_left			= truncate_left					
														  , ignore_empty_strings	= true
														  , add_line_numbers		= add_line_numbers
														  , line_number_format		= line_number_format
														  , start_line_number		= lineCountThis + 1
														  , print_to_last_line		= print_to_last_line
														  )	
				_out1						

		else // ( lineCountTxt < max_lines or (lineCountTxt == max_lines and lnBrAdj != 0) ) but lineExcess > 0 - have to truncate lines from top of this
			// log.info("\n--- lineCountTxt < max_lines but lineExcess > 0 ---\n")
			// truncate this and add txt
			// print last (lineCountThis - lineExcess) lines from this 
			[lnbrS, lnBrPos, lnbrL] = this.matchRgx(rgxLNBR, lineExcess)
			_this = str.substring(this,lnBrPos + str.length(lnbrS))

			[_out1, _intLengthOverflow1, _addedLines1] = "".printLines(
														  txt						= _this		
														  , max_length				= max_length				
														  , max_lines				= 999999999999				
														  , line_break_regex		= rgxLNBR						
														  , line_break				= LNBR				
														  , truncate_left			= truncate_left					
														  , ignore_empty_strings	= true
														  , add_line_numbers		= add_line_numbers
														  , line_number_format		= line_number_format
														  , start_line_number		= lineExcess + 1
														  , print_to_last_line		= print_to_last_line
														  )	

			// print the whole of txt 
			[_out2, _intLengthOverflow2, _addedLines2] = _out1.printLines(
														  txt						= txt		
														  , max_length				= max_length				
														  , max_lines				= 999999999999				
														  , line_break_regex		= rgxLNBR						
														  , line_break				= LNBR				
														  , truncate_left			= truncate_left					
														  , ignore_empty_strings	= true
														  , add_line_numbers		= add_line_numbers
														  , line_number_format		= line_number_format
														  , start_line_number		= lineCountThis + 1
														  , print_to_last_line		= print_to_last_line
														  )	
			_out2
//}

// ━━━━━ method wrap() ━━━━━ {
// @function Wraps a string `this` to `wrap_width` regardless of linebreaks (treating them just as any other char).
// Adds `breaker_prefix` to the end of each line (before "\n") and `breaker_postfix` to the beginning of each line 
// (after "\n")" (i.e. `breaker_prefix`'es are effectively added to the end of each line (but the last) and 
// `breaker_postfix`'es to the beginning of new line starting from second).
// If with breakers the line exceeds 4096 it is truncated from the right and "[...]" is added at the end.
// @param wrap_width (series int) Width of each line (chars).
// @param breaker_prefix (series string) (Optional) Text to add at the end of each line. (Default = "")
// @param breaker_postfix (series string) (Optional) Text to add after the each added line break at the beginning of next line. (Default = "")
// @returns a tuple [outS, addedBreaks] where outS is the wrapped text and addedBreaks is the number of added line breaks.
method _wrapLine2(string this, int wrap_width, string breaker_prefix = "", string breaker_postfix = "") =>
    l =  str.length(this)
	if not na(this)  // same as this == ""
        if wrap_width < l
            breaker = breaker_prefix + "\n" + breaker_postfix
            breaker_length = str.length(breaker)
            breaksN = int(l / wrap_width)
            // adding breakers may lead to overflow. Truncate and add [...] in this case
            resultL = l + breaksN * breaker_length
            adjBreaksN =  resultL > 4096 ? int   (
									  		     (4096 - 5) / (wrap_width +breaker_length) 
									  		     )
									  		     : breaksN
            s = ""
            for i = 0 to adjBreaksN-1
                s += str.substring(this, (wrap_width) * i, math.min(wrap_width * (i+1),l)) + (i == adjBreaksN ? "" : breaker)
            s+= str.substring(this, (wrap_width) * adjBreaksN, (wrap_width) * adjBreaksN + math.min(wrap_width, 4091 - str.length(s)))
            s += resultL > 4096 ? "[...]" : "" 
			[s, adjBreaksN]
        else 
			[this, 0] // if string shorter than wrap length
    else
        ["", 0] // if this = na


// @function Wraps a string `this` to `wrap_width` regardless of linebreaks (treating them just as any other char).
// Adds `breaker_prefix` to the end of each line (before "\n") and `breaker_postfix` to the beginning of each line 
// (after "\n")" (i.e. `breaker_prefix`'es are effectively added to the end of each line (but the last) and 
// `breaker_postfix`'es to the beginning of new line starting from second).
// If with breakers the line exceeds 4096 it is truncated from the right and "[...]" is added at the end.
// @param wrap_width (series int) Width of each line (chars).
// @param breaker_prefix (series string) (Optional) Text to add at the end of each line. (Default = "")
// @param breaker_postfix (series string) (Optional) Text to add after the each added line break at the beginning of next line. (Default = "")
// @returns the wrapped text 
method _wrapLine(string this, int wrap_width, string breaker_prefix = "", string breaker_postfix = "") =>
	[s, n] = _wrapLine2(this, wrap_width, breaker_prefix, breaker_postfix)
	s


// @function Wraps each line of `this` to wrap_width adding breaker_prefix to the end of each line (before "\n") and 
// breaker_postfix to the beginning of each line (after "\n")" (i.e. breaker_prefix'es are effectively added to 
// the end of each line (but the last) and breaker_postfix'es to the beginning of new line starting from second).
// If with breakers the line exceeds 4096 it is truncated from the right and "[...]" is added at the end.
// @param wrap_width (series int) Width of each line (chars).
// @param breaker_prefix (series string) (Optional) Text to add at the end of each line. (Default = "")
// @param breaker_postfix (series string) (Optional) Text to add after the each added line break at the beginning of next line. (Default = "")
// @returns the wrapped text 
export method wrap(
					 string 	this
					 , int 		wrap_width
					 , string	breaker_prefix = ""
					 , string	breaker_postfix = ""
					 , string	line_postfix = ""
					 , int 		max_length = 4096
					 ) =>


	lnPostfixLen = str.length(line_postfix) 						
	// get first line
	_in = this
	_res = "" 
	j = 0 
	while _in != "" 

		[_line, _lnBr, _end] = _in.feedRgx("(\\r|\\n|\\r\\n)")
		j+=1


		// wrap line and concatenate to _res
		[_wrappedLine, _addedBreaksN] = _line._wrapLine2(wrap_width, breaker_prefix, breaker_postfix)
		[__res, _overflowCharsN] =	_res.concatTrunc2(_wrappedLine, "\n")
		_res := __res

		// if there is room and something will be added further - add line_postfix
		if _addedBreaksN > 0 and str.length(_res) + lnPostfixLen < max_length and _end != ""  
			_res += line_postfix

		// continue on the remainder of the string
		_in := _end

	_res

 
// END OF wrap() } 

// ━━━━━ method scroll() ━━━━━ {
//{
// @function Scrolls the text (this) by returning a given number of lines (`lines_in_window`) starting from `start_line`.
// Can add line numbers and/or a header line in the form "Starting from line ... out of total ... lines, ... chars"
// @param start_line		(int) (Optional) Start line		
// @param lines_in_window	(int) (Optional) Number of lines to read and return
// @param show_line_numbers	(bool) (Optional) If true preceeds each line with a line number in the form "LN0001}: "
// @param show_header		(bool) (Optional) If true shows the header string in the form 
// "Starting from line {0} out of total {1} lines, {2} chars" followed by a separator line "----------".	
export method scroll(string this
					  , int start_line = 1
					  , int lines_in_window = 20
					  , bool show_line_numbers = false
					  , bool show_header = true
					  ) =>
	const string rgxLNBR = "(\\n|\\r|\\r\\n)"
	lineCountThis = this.countRgx(rgxLNBR)+1
	_outS = if show_header
		str.format("Starting from line {0} out of total {1} lines, {2} chars", start_line, lineCountThis, str.length(this)) + "\n-----------\n"
	else
		""
	_lnNo = math.max(0, start_line-1)
	if start_line <= lineCountThis and lines_in_window > 0 
		startPos = if start_line <= 1
			0
		else
			[m,p, l] = this.matchRgx(rgxLNBR, start_line-1)
			p+l

		_endS = str.substring(this, startPos)
		
		while _endS != "" and _lnNo < start_line + lines_in_window -1
			_lnNo+=1
			[b, m, e] = _endS.feedRgx(rgxLNBR)
			_endS := e
			_outS := _outS.print(
								  (show_line_numbers ? str.format("LN{0, number, 0000}: ", _lnNo) : "")
								  + b) 


	_outS


// END OF scroll()}





// ┃ ^^^ END OF StringLib LIBRARY FUNCTIONS                                       ┃}
