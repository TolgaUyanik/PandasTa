//@version=6
indicator("Rolling CAGR (Custom Years)", overlay=false)

years_back = input.int(10, title="Lookback Period (Years)", minval=1, maxval=50)

var float price_n_years_ago = na
price_n_years_ago := na

curr_year = year(time)
curr_month = month(time)
curr_day = dayofmonth(time)

target_year = curr_year - years_back

// Look for date match N years back
for i = 1 to 3000
    past_time = time[i]
    if na(past_time)
        break
    past_year = year(past_time)
    past_month = month(past_time)
    past_day = dayofmonth(past_time)

    if past_year == target_year and past_month == curr_month and math.abs(past_day - curr_day) <= 1
        price_n_years_ago := close[i]
        break

// CAGR calculation
cagr = (not na(price_n_years_ago) and price_n_years_ago > 0) ? (math.pow(close / price_n_years_ago, 1 / years_back) - 1) : na

// Plot CAGR
plot(cagr * 100, title="Rolling CAGR (%)", color=color.teal, linewidth=2)
hline(0, "Zero Line", color=color.gray)