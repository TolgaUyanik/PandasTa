//@version=6
// =====================================================================
//  GEX LEVELS
//  Paste your levels and it draws each as a horizontal line (extends
//  across the chart) with a semi-transparent box around it (level +/- a
//  half-width), a text tag on the line, and a coloured price tag on the
//  Y-AXIS (price scale).
//
//  ACCEPTED FORMATS (you can mix both, line by line):
//
//  1) FLAT LIST (recommended) — label, price, label, price, ...
//     Any number of pairs, comma separated, on one line or spread over
//     several lines. Colour is auto-assigned from keywords in the label
//     (Call -> colour 1, Put -> colour 2, HVL/Gamma -> colour 3,
//     GEX -> colour 4, Max/Min -> colour 5, anything else -> default).
//        Call Resistance, 30000, Put Support, 28000, HVL, 29270,
//        1D Min, 28732.22, 1D Max, 29597.78, GEX 1, 28800, GEX 2, 28900
//
//  2) LEGACY PER-LINE FORMAT — price, colour, label   (one per line)
//     price  : the level, e.g. 720
//     colour : a NUMBER 1-5 choosing one of the 5 customisable colours.
//              Optional - blank/invalid uses the default colour.
//     label  : optional text, no commas, e.g. Call Wall
//        720, 1, Call Wall
//        715, 2, Put Wall
//.
//  Blank lines are ignored. Note: Y-axis price tags support up to 20
//  levels (lines/boxes/text are unlimited up to 500).
// =====================================================================
indicator('GEX Levels', overlay = true, max_lines_count = 500, max_boxes_count = 1000, max_labels_count = 500)

// ─── Levels input ────────────────────────────────────────────────────
grpData = 'Levels'
csvInput = input.text_area(defval = 'Call Resistance, 30000, Put Support, 28000\nHVL, 29270, 1D Min, 28732.22\n1D Max, 29597.78\nCall Resistance 0DTE, 28575, Put Support 0DTE, 28500\nHVL 0DTE, 29100, Gamma Wall 0DTE, 28575\nGEX 1, 28800, GEX 2, 28900\nGEX 3, 29000, GEX 4, 29250\nGEX 5, 29500, GEX 6, 28700\nGEX 7, 28300, GEX 8, 28600\nGEX 9, 28400, GEX 10, 29750', title = 'Levels', group = grpData, tooltip = 'Flat format: label, price, label, price, ...\n(colour is auto-picked from the label\'s keywords)\n\nAlso accepts the legacy per-line format:\nprice, colour, label\n\nBlank lines are ignored.')

// ─── 5 customisable colours ──────────────────────────────────────────
grpCol = 'Colours (1=Call, 2=Put, 3=HVL/Gamma, 4=GEX, 5=Max/Min)'
c1 = input.color(color.new(#089981, 0), '1', group = grpCol, inline = 'a')
c2 = input.color(color.new(#f23645, 0), '2', group = grpCol, inline = 'a')
c3 = input.color(color.new(#2962ff, 0), '3', group = grpCol, inline = 'a')
c4 = input.color(color.new(#ff9800, 0), '4', group = grpCol, inline = 'a')
c5 = input.color(color.new(#9c27b0, 0), '5', group = grpCol, inline = 'a')
defIdx = input.int(1, 'Default colour (unmatched labels)', minval = 1, maxval = 5, group = grpCol)

// ─── Style ───────────────────────────────────────────────────────────
grpStyle = 'Style'
opacityPct = input.int(40, 'Box opacity %', minval = 0, maxval = 100, group = grpStyle, tooltip = 'Fill opacity of the box around each level.')
halfWidth = input.float(0.5, 'Box half-width (price)', minval = 0.0, step = 0.1, group = grpStyle, tooltip = 'Box spans level ± this. 0.5 → 719.5 to 720.5 for a 720 level. Set 0 to hide the box.')
lineWidth = input.int(1, 'Line width', minval = 1, maxval = 5, group = grpStyle)
lineStyleS = input.string('Solid', 'Line style', options = ['Solid', 'Dashed', 'Dotted'], group = grpStyle)
showBorder = input.bool(false, 'Box border', group = grpStyle)

// ─── Text (sits on the line, like the line-tool text feature) ────────
grpText = 'Text'
showText = input.bool(true, 'Show text on line', group = grpText)
showPrice = input.bool(false, 'Include price in text', group = grpText)
textVPos = input.string('On line', 'Vertical position', options = ['Above line', 'On line', 'Below line'], group = grpText, tooltip = '\'On line\' centres the text vertically on the line (line through the middle of the text).')
textOffset = input.int(3, 'Text offset (bars from right edge)', minval = -100, group = grpText, tooltip = 'Where along the line the text sits. Higher = further left over the chart; 0 = right edge; negative = into the right margin.')
tSizeS = input.string('Small', 'Text size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = grpText)

// ─── Y-axis tags ─────────────────────────────────────────────────────
grpAxis = 'Y-axis'
showAxis = input.bool(true, 'Show price tags on Y-axis', group = grpAxis, tooltip = 'Adds the level\'s price to the price scale, coloured to match. Supports up to 20 levels.')

// ─── Maps ────────────────────────────────────────────────────────────
lStyle = lineStyleS == 'Dashed' ? line.style_dashed : lineStyleS == 'Dotted' ? line.style_dotted : line.style_solid
tSize = tSizeS == 'Tiny' ? size.tiny : tSizeS == 'Normal' ? size.normal : tSizeS == 'Large' ? size.large : size.small
// Text is carried by an invisible box centred on the level, so vertical
// alignment is exact: center -> text sits ON the line (line through the
// middle of the text); top/bottom -> above/below the line.
tVal = textVPos == 'Above line' ? text.align_top : textVPos == 'Below line' ? text.align_bottom : text.align_center
fillTransp = 100 - opacityPct

colOf(idx) =>
    idx == 1 ? c1 : idx == 2 ? c2 : idx == 3 ? c3 : idx == 4 ? c4 : c5

// ─── Stores ──────────────────────────────────────────────────────────
var array<line> lns = array.new_line()
var array<box> bxs = array.new_box()
var array<float> pxArr = array.new_float() // level prices (for y-axis plots)
var array<int> ixArr = array.new_int() // colour indices (for y-axis plots)

// ─── Helpers ─────────────────────────────────────────────────────────
trim(s) =>
    result = s
    while str.length(result) > 0 and str.substring(result, 0, 1) == ' '
        result := str.substring(result, 1)
        result
    while str.length(result) > 0 and str.substring(result, str.length(result) - 1, str.length(result)) == ' '
        result := str.substring(result, 0, str.length(result) - 1)
        result
    result

// Auto-pick a colour index (1-5) from keywords in the label.
colourForLabel(lbl) =>
    lc = str.lower(lbl)
    int idx = defIdx
    if str.contains(lc, 'call')
        idx := 1
        idx
    else if str.contains(lc, 'put')
        idx := 2
        idx
    else if str.contains(lc, 'hvl') or str.contains(lc, 'gamma')
        idx := 3
        idx
    else if str.contains(lc, 'gex')
        idx := 4
        idx
    else if str.contains(lc, 'max') or str.contains(lc, 'min')
        idx := 5
        idx
    idx

// Draws one level (line + box + text) and records it for the y-axis tags.
addLevel(price, idx, name) =>
    col = colOf(idx)

    // box: level +/- half-width, full chart width
    bx = box.new(left = bar_index, top = price + halfWidth, right = bar_index + 1, bottom = price - halfWidth, border_color = showBorder ? col : color.new(col, 100), border_width = 1, bgcolor = color.new(col, fillTransp), extend = extend.both, xloc = xloc.bar_index)
    array.push(bxs, bx)

    // line: exact level, full chart width
    ln = line.new(x1 = bar_index, y1 = price, x2 = bar_index + 1, y2 = price, xloc = xloc.bar_index, extend = extend.both, color = col, width = lineWidth, style = lStyle)
    array.push(lns, ln)

    // text carried by an invisible box centred on the level,
    // so it sits exactly ON the line (vertically centred)
    if showText
        txt = showPrice and name != '' ? str.tostring(price) + '  ' + name : showPrice ? str.tostring(price) : name
        if txt != ''
            hwT = math.max(halfWidth, syminfo.mintick)
            txBar = bar_index - textOffset
            tb = box.new(left = txBar - 1, top = price + hwT, right = txBar + 1, bottom = price - hwT, border_color = color.new(col, 100), bgcolor = color.new(col, 100), text = txt, text_color = col, text_size = tSize, text_halign = text.align_center, text_valign = tVal, xloc = xloc.bar_index)
            array.push(bxs, tb)

    array.push(pxArr, price)
    array.push(ixArr, idx)

// ─── Build on the last bar ───────────────────────────────────────────
if barstate.islast
    // wipe previous drawings/data
    if array.size(lns) > 0
        for i = 0 to array.size(lns) - 1 by 1
            line.delete(array.get(lns, i))
    if array.size(bxs) > 0
        for i = 0 to array.size(bxs) - 1 by 1
            box.delete(array.get(bxs, i))
    array.clear(lns)
    array.clear(bxs)
    array.clear(pxArr)
    array.clear(ixArr)

    lines = str.split(csvInput, '\n')
    if array.size(lines) > 0
        for li = 0 to array.size(lines) - 1 by 1
            rawLine = trim(str.replace_all(array.get(lines, li), 'r', ''))
            if str.length(rawLine) > 0
                toks = str.split(rawLine, ',')
                nt = array.size(toks)
                first = trim(array.get(toks, 0))
                firstNum = str.tonumber(first)

                if not na(firstNum) and nt <= 3
                    // legacy per-line format: price, colour, label
                    price = firstNum
                    ci = nt > 1 ? str.tonumber(trim(array.get(toks, 1))) : na
                    idx = na(ci) ? defIdx : int(math.round(ci))
                    idx := idx < 1 or idx > 5 ? defIdx : idx
                    name = nt > 2 ? trim(array.get(toks, 2)) : ''
                    addLevel(price, idx, name)
                else // flat format: label, price, label, price, ...
                    j = 0
                    while j < nt - 1
                        lbl = trim(array.get(toks, j))
                        pr = str.tonumber(trim(array.get(toks, j + 1)))
                        if not na(pr) and lbl != ''
                            idx = colourForLabel(lbl)
                            addLevel(pr, idx, lbl)
                            j := j + 2
                            j
                        else
                            j := j + 1
                            j

// ─── Y-axis price tags (price scale only, up to 20 levels) ───────────
gp(i) =>
    showAxis and i < array.size(pxArr) ? array.get(pxArr, i) : na
gc(i) =>
    i < array.size(ixArr) ? colOf(array.get(ixArr, i)) : na

plot(gp(0), 'Lvl 1', color = gc(0), display = display.price_scale, editable = false)
plot(gp(1), 'Lvl 2', color = gc(1), display = display.price_scale, editable = false)
plot(gp(2), 'Lvl 3', color = gc(2), display = display.price_scale, editable = false)
plot(gp(3), 'Lvl 4', color = gc(3), display = display.price_scale, editable = false)
plot(gp(4), 'Lvl 5', color = gc(4), display = display.price_scale, editable = false)
plot(gp(5), 'Lvl 6', color = gc(5), display = display.price_scale, editable = false)
plot(gp(6), 'Lvl 7', color = gc(6), display = display.price_scale, editable = false)
plot(gp(7), 'Lvl 8', color = gc(7), display = display.price_scale, editable = false)
plot(gp(8), 'Lvl 9', color = gc(8), display = display.price_scale, editable = false)
plot(gp(9), 'Lvl 10', color = gc(9), display = display.price_scale, editable = false)
plot(gp(10), 'Lvl 11', color = gc(10), display = display.price_scale, editable = false)
plot(gp(11), 'Lvl 12', color = gc(11), display = display.price_scale, editable = false)
plot(gp(12), 'Lvl 13', color = gc(12), display = display.price_scale, editable = false)
plot(gp(13), 'Lvl 14', color = gc(13), display = display.price_scale, editable = false)
plot(gp(14), 'Lvl 15', color = gc(14), display = display.price_scale, editable = false)
plot(gp(15), 'Lvl 16', color = gc(15), display = display.price_scale, editable = false)
plot(gp(16), 'Lvl 17', color = gc(16), display = display.price_scale, editable = false)
plot(gp(17), 'Lvl 18', color = gc(17), display = display.price_scale, editable = false)
plot(gp(18), 'Lvl 19', color = gc(18), display = display.price_scale, editable = false)
plot(gp(19), 'Lvl 20', color = gc(19), display = display.price_scale, editable = false)
