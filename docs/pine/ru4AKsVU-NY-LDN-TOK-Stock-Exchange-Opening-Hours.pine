//@version=6
indicator("NY/LDN/TOK Stock Exchange Opening Hours + Silver Bullet", overlay=true)

// === PARAMÈTRES ===
// Activation/désactivation des lignes
show_ny = input.bool(true, "Afficher NYSE (New York)")
show_london = input.bool(true, "Afficher LSE (Londres)")
show_tokyo = input.bool(true, "Afficher TSE (Tokyo)")

// Couleurs paramétrables
ny_color = input.color(color.blue, "Couleur NYSE")
london_color = input.color(color.red, "Couleur Londres")
tokyo_color = input.color(color.yellow, "Couleur Tokyo")

// Affichage des sessions futures
show_future = input.bool(true, "Afficher sessions futures (J+1)")

// Silver Bullet periods
show_silver_bullet = input.bool(false, "Afficher Silver Bullet Periods")
sb_ny_color = input.color(color.new(color.blue, 80), "Couleur Silver Bullet NY")
sb_london_color = input.color(color.new(color.red, 80), "Couleur Silver Bullet London")
sb_tokyo_color = input.color(color.new(color.yellow, 80), "Couleur Silver Bullet Tokyo")

// === VARIABLES ===
var line[] ny_lines = array.new<line>()
var line[] london_lines = array.new<line>()
var line[] tokyo_lines = array.new<line>()
var box[] sb_ny_boxes = array.new<box>()
var box[] sb_london_boxes = array.new<box>()
var box[] sb_tokyo_boxes = array.new<box>()

// === FONCTIONS UTILITAIRES ===
// Calculer le timestamp pour une heure spécifique dans un fuseau donné
get_market_time(target_year, target_month, target_day, target_hour, target_minute, timezone_str) =>
    timestamp(timezone_str, target_year, target_month, target_day, target_hour, target_minute)

// Vérifier si un jour est un jour de semaine (lundi à vendredi)
is_weekday(timestamp_val) =>
    day_of_week = dayofweek(timestamp_val)
    day_of_week >= 2 and day_of_week <= 6

// === FONCTION PRINCIPALE ===
// Dessiner les lignes d'ouverture pour une période donnée
draw_opening_lines() =>
    // Vérifier que le timeframe est strictement inférieur à 1H (60 minutes)
    if timeframe.in_seconds() < 3600 and barstate.islast
        // Nettoyer les anciennes lignes et boxes
        for line_item in ny_lines
            line.delete(line_item)
        for line_item in london_lines
            line.delete(line_item)
        for line_item in tokyo_lines
            line.delete(line_item)
        for box_item in sb_ny_boxes
            box.delete(box_item)
        for box_item in sb_london_boxes
            box.delete(box_item)
        for box_item in sb_tokyo_boxes
            box.delete(box_item)
        
        array.clear(ny_lines)
        array.clear(london_lines)
        array.clear(tokyo_lines)
        array.clear(sb_ny_boxes)
        array.clear(sb_london_boxes)
        array.clear(sb_tokyo_boxes)
        
        // Calculer les dates à traiter (7 jours en arrière, aujourd'hui, 2 jours en avant)
        for i = -7 to (show_future ? 2 : 0)
            check_timestamp = timenow + i * 24 * 60 * 60 * 1000
            check_year = year(check_timestamp)
            check_month = month(check_timestamp)
            check_day = dayofmonth(check_timestamp)
            
            // Vérifier si c'est un jour de semaine
            if is_weekday(check_timestamp)
                // New York : 9h30 + Silver Bullet 10:00-11:00 + PM Silver Bullet 14:00-15:00
                if show_ny
                    ny_time = get_market_time(check_year, check_month, check_day, 9, 30, "America/New_York")
                    ny_line = line.new(x1=ny_time, y1=low, x2=ny_time, y2=high, color=ny_color, width=1, style=line.style_dotted, extend=extend.both, xloc=xloc.bar_time)
                    array.push(ny_lines, ny_line)
                    
                    // Silver Bullet NY AM: 10:00-11:00 EST/EDT
                    if show_silver_bullet
                        sb_ny_start = get_market_time(check_year, check_month, check_day, 10, 0, "America/New_York")
                        sb_ny_end = get_market_time(check_year, check_month, check_day, 11, 0, "America/New_York")
                        sb_ny_box = box.new(left=sb_ny_start, top=high*1.05, right=sb_ny_end, bottom=low*0.95, bgcolor=sb_ny_color, border_color=color.new(color.white, 100), border_width=0, xloc=xloc.bar_time)
                        array.push(sb_ny_boxes, sb_ny_box)
                        
                        // Silver Bullet NY PM: 14:00-15:00 EST/EDT (Afternoon session)
                        sb_ny_pm_start = get_market_time(check_year, check_month, check_day, 14, 0, "America/New_York")
                        sb_ny_pm_end = get_market_time(check_year, check_month, check_day, 15, 0, "America/New_York")
                        sb_ny_pm_box = box.new(left=sb_ny_pm_start, top=high*1.05, right=sb_ny_pm_end, bottom=low*0.95, bgcolor=sb_ny_color, border_color=color.new(color.white, 100), border_width=0, xloc=xloc.bar_time)
                        array.push(sb_ny_boxes, sb_ny_pm_box)
                
                // Londres : 8h00 + Silver Bullet 8:00-9:00
                if show_london
                    london_time = get_market_time(check_year, check_month, check_day, 8, 0, "Europe/London")
                    london_line = line.new(x1=london_time, y1=low, x2=london_time, y2=high, color=london_color, width=1, style=line.style_dotted, extend=extend.both, xloc=xloc.bar_time)
                    array.push(london_lines, london_line)
                    
                    // Silver Bullet London: 8:00-9:00 GMT/BST
                    if show_silver_bullet
                        sb_london_start = get_market_time(check_year, check_month, check_day, 8, 0, "Europe/London")
                        sb_london_end = get_market_time(check_year, check_month, check_day, 9, 0, "Europe/London")
                        sb_london_box = box.new(left=sb_london_start, top=high*1.05, right=sb_london_end, bottom=low*0.95, bgcolor=sb_london_color, border_color=color.new(color.white, 100), border_width=0, xloc=xloc.bar_time)
                        array.push(sb_london_boxes, sb_london_box)
                
                // Tokyo : 9h00 + Silver Bullet 9:00-10:00
                if show_tokyo
                    tokyo_time = get_market_time(check_year, check_month, check_day, 9, 0, "Asia/Tokyo")
                    tokyo_line = line.new(x1=tokyo_time, y1=low, x2=tokyo_time, y2=high, color=tokyo_color, width=1, style=line.style_dotted, extend=extend.both, xloc=xloc.bar_time)
                    array.push(tokyo_lines, tokyo_line)
                    
                    // Silver Bullet Tokyo: 9:00-10:00 JST
                    if show_silver_bullet
                        sb_tokyo_start = get_market_time(check_year, check_month, check_day, 9, 0, "Asia/Tokyo")
                        sb_tokyo_end = get_market_time(check_year, check_month, check_day, 10, 0, "Asia/Tokyo")
                        sb_tokyo_box = box.new(left=sb_tokyo_start, top=high*1.05, right=sb_tokyo_end, bottom=low*0.95, bgcolor=sb_tokyo_color, border_color=color.new(color.white, 100), border_width=0, xloc=xloc.bar_time)
                        array.push(sb_tokyo_boxes, sb_tokyo_box)

// Exécuter la fonction
draw_opening_lines()

// === LÉGENDE DANS LE COIN BAS DROIT ===
var table legend_table = table.new(position.bottom_right, 1, 6, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if barstate.islast
    // Vérifier le timeframe avant d'afficher la légende
    if timeframe.in_seconds() < 3600
        // Titre
        table.cell(legend_table, 0, 0, "BOURSES", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 50))
        
        // Entrées pour chaque bourse (seulement si activées)
        row = 1
        if show_ny
            table.cell(legend_table, 0, row, "NY", text_color=ny_color, text_size=size.small)
            row += 1
        if show_london
            table.cell(legend_table, 0, row, "LND", text_color=london_color, text_size=size.small)
            row += 1
        if show_tokyo
            table.cell(legend_table, 0, row, "TOK", text_color=tokyo_color, text_size=size.small)
            row += 1
        
        // Indication des sessions futures si activées
        if show_future
            table.cell(legend_table, 0, row, "Future: ON", text_color=color.green, text_size=size.tiny)
            row += 1
            
        // Indication Silver Bullet si activé
        if show_silver_bullet
            table.cell(legend_table, 0, row, "Silver Bullet: ON", text_color=color.orange, text_size=size.tiny)
    else
        // Message pour timeframes trop élevés
        table.cell(legend_table, 0, 0, "Timeframe trop élevé", text_color=color.red, text_size=size.small, bgcolor=color.new(color.gray, 50))
        table.cell(legend_table, 0, 1, "Utilisez < 1H", text_color=color.orange, text_size=size.tiny)