//@version=6
// @description ML Library for lightweight strategies. Implements k-NN with matrix storage.
library("PineML_v6", overlay=true)

// ==========================================
// 1. Дефиниране на структурите (Types)
// ==========================================

// Основният обект, който съхранява състоянието на модела
export type KNN_Model
    int k_neighbors           // Колко съседа да търсим
    int max_history           // Максимален размер на обучителната извадка
    matrix<float> features    // Матрица с исторически данни
    array<float> labels       // Масив с исторически резултати
    int feature_count         // Брой на входните сигнали

// ==========================================
// 2. Методи за Инициализация
// ==========================================

// @function Създава нов модел
// @param k Брой съседи (напр. 5)
// @param history Дълбочина на паметта (напр. 1000 бара)
// @param features Брой променливи, които ще следим
export method new_model(int k, int history, int features) =>
    // Създаваме празна матрица и масив
    m = matrix.new<float>(0, features) 
    l = array.new<float>(0)
    KNN_Model.new(k, history, m, l, features)

// ==========================================
// 3. Методи за Обучение (Data Ingestion)
// ==========================================

// @function Добавя нови данни към паметта на модела
// @param model Инстанцията на модела
// @param feature_array Масив с текущите стойности на индикаторите
// @param label Резултатът (класът), свързан с тези данни
export method train(KNN_Model model, array<float> feature_array, float label) =>
    // Валидация на размера
    if array.size(feature_array)!= model.feature_count
        runtime.error("Features count mismatch!")
    
    // Добавяне към матрицата и масива
    matrix.add_row(model.features, matrix.rows(model.features), feature_array)
    array.push(model.labels, label)
    
    // Управление на паметта (Sliding Window)
    // Ако сме надвишили лимита, трием най-старите данни
    if matrix.rows(model.features) > model.max_history
        matrix.remove_row(model.features, 0)
        array.shift(model.labels)

// ==========================================
// 4. Методи за Прогнозиране (Prediction)
// ==========================================

// @function Изчислява прогноза на база текущите данни
export method predict(KNN_Model model, array<float> query_features) =>
    int history_size = matrix.rows(model.features)
    
    // Ако нямаме достатъчно данни, връщаме 0
    if history_size < model.k_neighbors
        float(0.0)
    else
        // 1. Изчисляване на разстоянията
        array<float> distances = array.new<float>(history_size)
        
        // ОПТИМИЗАЦИЯ: Използваме цикъл, но трябва да сме внимателни с времето
        // Тук се случва тежката математика
        for i = 0 to history_size - 1
            float dist_sum = 0.0
            // Вземаме реда от матрицата
            array<float> row = matrix.row(model.features, i)
            
            for j = 0 to model.feature_count - 1
                // Евклидово разстояние (без sqrt за бързина)
                float d = array.get(row, j) - array.get(query_features, j)
                dist_sum += d * d
            
            array.set(distances, i, dist_sum)
            
        // 2. Намиране на най-близките съседи
        // array.sort_indices връща индексите на елементите, сортирани по стойност
        // Това е много по-бързо от ръчно сортиране
        array<int> sorted_indices = array.sort_indices(distances)
        
        // 3. Гласуване (Voting)
        float prediction_score = 0.0
        
        for i = 0 to model.k_neighbors - 1
            int neighbor_idx = array.get(sorted_indices, i)
            float neighbor_label = array.get(model.labels, neighbor_idx)
            prediction_score += neighbor_label
            
        // Връщаме средната стойност на съседите
        // Ако лейбълите са -1 и 1, положителен резултат значи Buy сигнал
        prediction_score / model.k_neighbors