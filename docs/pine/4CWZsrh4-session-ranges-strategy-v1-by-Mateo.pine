//@version=6
indicator("Pro Session Range Boxes", overlay=true)

// ============================================================================
// INPUTS & NON-DISTRACTING PALETTE
// ============================================================================
grpAsia   = "Asia Session"
showAsia  = input.bool(true, "Show Asia", group=grpAsia)
asiaTime  = input.session("1900-0300:1234567", "Asia Time (EST)", group=grpAsia)
c_asia    = #7E57C2 // Soft Lavender

grpLon    = "London Session"
showLon   = input.bool(true, "Show London", group=grpLon)
lonTime   = input.session("0300-0800:1234567", "London Time (EST)", group=grpLon)
c_lon     = #26A69A // Muted Teal

grpNyAm   = "NY AM Session"
showNyAm  = input.bool(true, "Show NY AM", group=grpNyAm)
nyAmTime  = input.session("0800-1200:1234567", "NY AM Time (EST)", group=grpNyAm)
c_nyAm    = #FFA726 // Warm Amber

grpNyPm   = "NY PM Session"
showNyPm  = input.bool(true, "Show NY PM", group=grpNyPm)
nyPmTime  = input.session("1200-1700:1234567", "NY PM Time (EST)", group=grpNyPm)
c_nyPm    = #78909C // Muted Slate Blue

// ============================================================================
// SESSION DETECTION
// ============================================================================
inAsia = showAsia and not na(time(timeframe.period, asiaTime, "America/New_York"))
inLon  = showLon  and not na(time(timeframe.period, lonTime,  "America/New_York"))
inNyAm = showNyAm and not na(time(timeframe.period, nyAmTime, "America/New_York"))
inNyPm = showNyPm and not na(time(timeframe.period, nyPmTime, "America/New_York"))

// ============================================================================
// BACKGROUND HIGHLIGHTS (FULL CHART HEIGHT)
// ============================================================================
bgcolor(inAsia ? color.new(c_asia, 92) : na, title="Asia Zone")
bgcolor(inLon  ? color.new(c_lon, 92)  : na, title="London Zone")
bgcolor(inNyAm ? color.new(c_nyAm, 92) : na, title="NY AM Zone")
bgcolor(inNyPm ? color.new(c_nyPm, 92) : na, title="NY PM Zone")

// ============================================================================
// SESSION OPEN LABELS & BOUNDARY LINES
// ============================================================================
asiaStart = inAsia and not inAsia[1]
lonStart  = inLon  and not inLon[1]
nyAmStart = inNyAm and not inNyAm[1]
nyPmStart = inNyPm and not inNyPm[1]

if asiaStart
    label.new(bar_index, high, text="ASIA", xloc=xloc.bar_index, yloc=yloc.abovebar, 
              color=c_asia, textcolor=color.white, style=label.style_label_down, size=size.small)

if lonStart
    label.new(bar_index, high, text="LONDON", xloc=xloc.bar_index, yloc=yloc.abovebar, 
              color=c_lon, textcolor=color.white, style=label.style_label_down, size=size.small)

if nyAmStart
    label.new(bar_index, high, text="NY AM", xloc=xloc.bar_index, yloc=yloc.abovebar, 
              color=c_nyAm, textcolor=color.white, style=label.style_label_down, size=size.small)

if nyPmStart
    label.new(bar_index, high, text="NY PM", xloc=xloc.bar_index, yloc=yloc.abovebar, 
              color=c_nyPm, textcolor=color.white, style=label.style_label_down, size=size.small)