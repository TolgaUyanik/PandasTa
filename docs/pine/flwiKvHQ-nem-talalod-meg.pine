//@version=5
strategy("5 perces bot v2.3 - FINAL FIX", overlay=true, pyramiding=1, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ==========================================
// INPUTOK
// ==========================================
a          = input.float(2.2,  "UT Bot Key Value", step=0.1)
atr_len    = input.int(10,    "ATR Period")

use_ema_filter   = input.bool(true,  "5 perces EMA 200 Filter")
ema_trend_len    = input.int(200,    "5min EMA Trend Length")
ema_fast_len     = input.int(21,     "5min EMA Fast Length")

use_1min_ema     = input.bool(true,  "1 perces EMA szűrő")
ema_1min_len     = input.int(21,     "1min EMA Length")

use_htf          = input.bool(true,  "15 perces EMA 200 Filter")
htf_ema_len      = input.int(200,    "15min EMA Length")

use_adx          = input.bool(true,  "ADX Filter")
adx_len          = input.int(14,     "ADX Length")
adx_threshold    = input.int(23,     "Minimum ADX")

use_distance     = input.bool(true,  "EMA Distance Filter")
distance_filter  = input.float(0.001, "Min Distance", step=0.0001)

tp_percent       = input.float(1.5,  "Take Profit (%)", step=0.1)
sl_percent       = input.float(1.0,  "Stop Loss (%)", step=0.1)

// ==========================================
// ⏰ IDŐSZŰRŐ
// ==========================================
start_hour = 3
end_hour   = 15

h = hour(time)
time_allowed = (h >= start_hour and h < end_hour)

// ==========================================
// INDIKÁTOROK
// ==========================================
src = close

xATR = ta.atr(atr_len)
nLoss = a * xATR

// ==========================================
// UT TRAIL (FIXED)
// ==========================================
var float trail = na
prev = nz(trail[1])

if (src > prev and src[1] > prev)
    trail := math.max(prev, src - nLoss)
else if (src < prev and src[1] < prev)
    trail := math.min(prev, src + nLoss)
else
    if (src > prev)
        trail := src - nLoss
    else
        trail := src + nLoss

// ==========================================
// EMA-k
// ==========================================
ema_fast  = ta.ema(src, ema_fast_len)
ema_trend = ta.ema(src, ema_trend_len)

// HTF EMA-k
ema_1min  = request.security(syminfo.tickerid, "1", ta.ema(close, ema_1min_len))
htf_ema   = request.security(syminfo.tickerid, "15", ta.ema(close, htf_ema_len))

// ADX
[_, _, adx] = ta.dmi(adx_len, adx_len)

// Distance
distance = math.abs(src - ema_fast) / src

// ==========================================
// BELÉPÉS (FIXED)
// ==========================================
long_condition = ta.crossover(src, trail) and src > ema_fast and (use_ema_filter ? src > ema_trend : true) and (use_1min_ema ? src > ema_1min : true) and (use_htf ? src > htf_ema : true) and (use_adx ? adx > adx_threshold : true) and (use_distance ? distance > distance_filter : true)

short_condition = ta.crossover(trail, src) and src < ema_fast and (use_ema_filter ? src < ema_trend : true) and (use_1min_ema ? src < ema_1min : true) and (use_htf ? src < htf_ema : true) and (use_adx ? adx > adx_threshold : true) and (use_distance ? distance > distance_filter : true)

// ==========================================
// BELÉPÉS
// ==========================================
if (long_condition and time_allowed)
    strategy.entry("Long", strategy.long)

if (short_condition and time_allowed)
    strategy.entry("Short", strategy.short)

// ==========================================
// TP / SL
// ==========================================
if (strategy.position_size > 0)
    strategy.exit("Long Exit", "Long", limit=strategy.position_avg_price * (1 + tp_percent/100), stop=strategy.position_avg_price * (1 - sl_percent/100))

if (strategy.position_size < 0)
    strategy.exit("Short Exit", "Short", limit=strategy.position_avg_price * (1 - tp_percent/100), stop=strategy.position_avg_price * (1 + sl_percent/100))

// ==========================================
// EMA EXIT
// ==========================================
if (strategy.position_size > 0 and ta.crossunder(ema_fast, ema_trend))
    strategy.close("Long", comment="EMA Exit")

if (strategy.position_size < 0 and ta.crossover(ema_fast, ema_trend))
    strategy.close("Short", comment="EMA Exit")

// ==========================================
// NAPI ZÁRÁS
// ==========================================
if (h >= end_hour)
    strategy.close_all(comment="Napi Zárás")

// ==========================================
// MEGJELENÍTÉS
// ==========================================
plot(ema_trend, color=color.blue, linewidth=2)
plot(ema_fast, color=color.orange, linewidth=1)
plot(use_htf ? htf_ema : na, color=color.purple, linewidth=2)

bgcolor(not time_allowed ? color.new(color.red, 80) : na)