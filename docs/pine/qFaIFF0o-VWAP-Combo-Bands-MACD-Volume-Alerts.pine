//@version=5
indicator("VWAP Combo: Bands + MACD + Volume + Alerts", overlay=true)

// === VWAP + Bands ===
typicalPrice = (high + low + close) / 3
vwap = ta.vwap(typicalPrice)
lookback = 20  // Period to calculate standard deviation

// Standard Deviation for Bands
var float sum = na
var float stdDev = na

sum := ta.sma(math.pow(close - vwap, 2), lookback)
stdDev := math.sqrt(sum)

bandMultiplier = 1.5  // Adjust for tighter/wider bands
upperBand = vwap + (bandMultiplier * stdDev)
lowerBand = vwap - (bandMultiplier * stdDev)

// Plot VWAP and Bands
plot(vwap, title="VWAP", color=color.blue, linewidth=2)
plot(upperBand, title="Upper Band", color=color.gray)
plot(lowerBand, title="Lower Band", color=color.gray)

// === MACD Histogram (Candle Coloring) ===
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
macdHist = macdLine - signalLine

macdBull = macdHist > 0
macdBear = macdHist < 0
barcolor(macdBull ? color.lime : macdBear ? color.red : na)

// === Volume Spike Detection ===
vol = volume
volMA = ta.sma(vol, 20)
isSpike = vol > volMA * 1.5
plotshape(isSpike ? low : na, title="Volume Spike", location=location.belowbar, color=color.orange, style=shape.triangleup, size=size.small)

// === VWAP Cross and Bounce Logic ===
crossAbove = ta.crossover(close, vwap)
crossBelow = ta.crossunder(close, vwap)

bounceUp = close > vwap and ta.lowest(close, 3)[1] < vwap
bounceDown = close < vwap and ta.highest(close, 3)[1] > vwap

// === Alert Conditions ===
alertcondition(crossAbove, title="VWAP Cross Up", message="Price crossed ABOVE VWAP!")
alertcondition(crossBelow, title="VWAP Cross Down", message="Price crossed BELOW VWAP!")
alertcondition(bounceUp, title="VWAP Bounce Up", message="Price BOUNCED UP off VWAP!")
alertcondition(bounceDown, title="VWAP Bounce Down", message="Price BOUNCED DOWN off VWAP!")
alertcondition(crossAbove and macdBull and isSpike, title="VWAP Combo Signal", message="VWAP Cross UP + Bullish MACD + Volume Spike")
