// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Combined Indicator: CUI + Delta + YinYang Backgrounds + Adaptive Ichimoku Cloud + EMA Fill Area

//@version=6
indicator("CUI + Delta + YinYang + Adaptive Ichimoku + EMA Fill", shorttitle="CUI+YY+Ichi+EMA", overlay=true)

// =========================================================================
// 1. CHANNEL MIDLINE SETTINGS
// =========================================================================
group_cc    = "Channel Settings"
len_cc      = input.int(60, "HMA Length", minval = 2, group = group_cc)
decayChDown = input.float(0.038, "Channel: Down-Decel (Ceiling × ATR)", minval = 0.0, step = 0.05, group = group_cc)
decayChUp   = input.float(0.038, "Channel: Up-Decel (Floor × ATR)", minval = 0.0, step = 0.05, group = group_cc)

// =========================================================================
// 2. CHANDE KROLL STOP SETTINGS
// =========================================================================
group_ck    = "Chande Kroll Stop"
loP         = input.int(9, title="Length (P)", inline="ck_1", group = group_ck)
lox         = input.float(1.0, title="Multiplier (X)", inline="ck_1", step=0.1, group = group_ck)
loQ         = input.int(10, title="Length (Q)", inline="ck_1", group = group_ck)

// =========================================================================
// 3. ANGLE MARKET STRUCTURE SETTINGS
// =========================================================================
group_ms    = "Angle MarketStructure"
ms_length   = input.int(5, "Length", group = group_ms)
ms_angle    = input.float(0.1, "Angle", step = 0.01, maxval = 1., minval = 0, inline = "ms_1", group = group_ms)
ms_col1     = input.color(#f23645, "Pivot High", inline = "ms_1", group = group_ms)
ms_col2     = input.color(#089981, "Pivot Low", inline = "ms_1", group = group_ms)

// =========================================================================
// 4. QUANTUM RIBBON LITE + BB TREND MAGIC SETTINGS
// =========================================================================
group_bb    = "BB Trend Magic"
i_bb_src    = input.source(close, "BB Source", group = group_bb)
i_bb_length = input.int(20, "BB Length", group = group_bb)
i_bb_mult   = input.float(2.0, "BB Mult", group = group_bb)
i_bb_linewidth = input.int(2, "Linewidth", group = group_bb)

group_rib   = "Ribbon Styles"
i_bull_color = input.color(#87ceeb, "Bullish Ribbon", group = group_rib) 
i_bear_color = input.color(color.yellow, "Bearish Ribbon", group = group_rib) 
i_ribbon_opacity = input.int(60, "Base Opacity", minval=0, maxval=100, step=5, tooltip="0=Transparent, 100=Solid. The script automatically applies a gradient effect.", group=group_rib)

// =========================================================================
// 5. VOLUME DELTA SETTINGS
// =========================================================================
group_delta = "Volume Delta"
deltaBar    = input.bool(true, "Show Delta Bar", inline = "bar", group = group_delta)
offset      = input.int(15, "Offset", inline = "bar", group = group_delta)
period      = input.int(20, "Period", group = group_delta)
colUp       = input.color(#2962ff, "Buy Volume Color", inline = "color", group = group_delta)
colDn       = input.color(#c2185b, "Sell Volume Color", inline = "color", group = group_delta)

// =========================================================================
// 6. YINYANG RSI VOLUME TREND BACKGROUNDS SETTINGS
// =========================================================================
group_yy    = "YinYang Backgrounds"
show_yy     = input.bool(true, "Show YinYang Backgrounds", group = group_yy)
yy_len      = input.int(80, "Trend Length:", tooltip="How far back should we span this indicator?\nThis length effects all lengths of the indicator", group = group_yy)
yy_sl_mult  = input.float(0.1, "Stoploss Multiplier %:", tooltip="How far from the purchase lines should the stop loss be", group = group_yy)
yy_res_col  = input.color(color.new(color.green, 70), "Resistance (Short) Color", group = group_yy)
yy_sup_col  = input.color(color.new(color.orange, 70), "Support (Long) Color", group = group_yy)

// =========================================================================
// 7. ADAPTIVE ICHIMOKU CLOUD SETTINGS
// =========================================================================
group_ichi    = "Adaptive Ichimoku"
chikou_up_col = input.color(color.new(#065F4C, 0), "Lagging Span Bullish", group = group_ichi)
chikou_dn_col = input.color(color.new(color.red, 0), "Lagging Span Bearish", group = group_ichi)

tenkanPeriods = 9
kijunPeriods  = 26
senkouPeriods = 52
displacement  = 26

// =========================================================================
// 8. EMA FILL AREA SETTINGS
// =========================================================================
group_emafill = "EMA Fill Area"
show_emafill  = input.bool(true, title="Show EMA Fill Background", group=group_emafill)
emafill_src   = input.source(close, title="Source", group=group_emafill)
ema1_len      = input.int(100, title="EMA-1", group=group_emafill)
ema2_len      = input.int(200, title="EMA-2", group=group_emafill)


// =========================================================================
// FUNCTIONS
// =========================================================================

// HMA helper function for Channel Midline
hma(src, length) =>
    l1 = math.max(length, 2)
    wma1 = ta.wma(src, l1)
    wma2 = ta.wma(src, math.max(l1 / 2, 1))
    raw = 2.0 * wma2 - wma1
    ta.wma(raw, math.round(math.sqrt(l1)))

// Ribbon layers function
f_calculate_ribbon_layers(fast, slow, width) =>
    total_range = slow - width - fast
    spacing = total_range / 4.0
    s1 = fast
    l1 = s1 + width
    s2 = math.round(fast + spacing)
    l2 = s2 + width
    s3 = math.round(fast + spacing * 2)
    l3 = s3 + width
    s4 = math.round(fast + spacing * 3)
    l4 = s4 + width
    s5 = math.round(slow - width)
    l5 = slow
    [s1, l1, s2, l2, s3, l3, s4, l4, s5, l5]

// Volume Delta Calculation Function
volumeDelta(p)=>
    volumeBuy   = 0.
    volumeSell  = 0.
    for i = 0 to p
        if close[i] > open[i]
            volumeBuy += volume[i]
        else 
            volumeSell += volume[i]
    totalVol = volumeBuy + volumeSell
    volumeBuy / totalVol * 100

// Donchian Function for Ichimoku
donchian(len) => math.avg(ta.highest(high, len), ta.lowest(low, len))


// =========================================================================
// CALCULATIONS & PLOTTING
// =========================================================================

// -------------------------------------------------------------------------
// 1. CHANNEL MIDLINE
// -------------------------------------------------------------------------
baseTop = hma(high, len_cc)
baseBot = hma(low, len_cc)
atr_cc  = ta.atr(len_cc)
stepDn  = decayChDown * atr_cc
stepUp  = decayChUp * atr_cc

var float ceilCh = na
ceilCh := na(ceilCh[1]) ? baseTop : baseTop > ceilCh[1] ? baseTop : math.max(baseTop, ceilCh[1] - stepDn)

var float floorCh = na
floorCh := na(floorCh[1]) ? baseBot : baseBot < floorCh[1] ? baseBot : math.min(baseBot, floorCh[1] + stepUp)

midCh = (ceilCh + floorCh) / 2.0

plot(midCh, "Channel Midline", color = color.black, linewidth = 2)

// -------------------------------------------------------------------------
// 2. CHANDE KROLL STOP
// -------------------------------------------------------------------------
first_low_stop  = ta.lowest(high, loP) + lox * ta.atr(loP)
stop_long       = ta.lowest(first_low_stop, loQ)

plot(stop_long, color=#9C27B0, linewidth=2, title="Stop Long")

// -------------------------------------------------------------------------
// 3. ANGLE MARKET STRUCTURE
// -------------------------------------------------------------------------
var float phVal = na
var float plVal = na

ph = ta.pivothigh(ms_length, ms_length)
pl = ta.pivotlow(ms_length, ms_length)

atr_ms  = ta.atr(200) * ms_angle

if not na(ph)
    phVal := high[ms_length]
    
if not na(pl)
    plVal := low[ms_length]

if na(ph)
    phVal -= atr_ms
if na(pl)
    plVal += atr_ms

if ta.crossover(high, phVal)
    phVal := float(na)

if ta.crossunder(low, plVal)
    plVal := float(na)

plotshape(not na(ph) ? ph : na, "PivotHigh", shape.circle, location.absolute, offset = -ms_length, color = color.new(ms_col1, 80), size = size.small, display = display.none)
plotshape(not na(ph) ? ph : na, "PivotHigh", shape.cross, location.absolute, offset = -ms_length, color = color.new(ms_col1, 20), size = size.tiny)
plotshape(not na(pl) ? pl : na, "PivotLow", shape.circle, location.absolute, offset = -ms_length, color = color.new(ms_col2, 80), size = size.small, display = display.none)
plotshape(not na(pl) ? pl : na, "PivotLow", shape.xcross, location.absolute, offset = -ms_length, color = color.new(ms_col2, 20), size = size.tiny)

// -------------------------------------------------------------------------
// 4. QUANTUM RIBBON LITE + BB TREND MAGIC
// -------------------------------------------------------------------------
ribbon_base_transp = 100 - i_ribbon_opacity

ema_fast_base = 21
ema_slow_base = 60
pair_width = 7

[ma_len1, ma_len2, ma_len3, ma_len4, ma_len5, ma_len6, ma_len7, ma_len8, ma_len9, ma_len10] = f_calculate_ribbon_layers(ema_fast_base, ema_slow_base, pair_width)

// EMAs for Ribbon
mashort1 = ta.ema(close, ma_len1)
malong1  = ta.ema(close, ma_len2)
mashort2 = ta.ema(close, ma_len3)
malong2  = ta.ema(close, ma_len4)
mashort3 = ta.ema(close, ma_len5)
malong3  = ta.ema(close, ma_len6)
mashort4 = ta.ema(close, ma_len7)
malong4  = ta.ema(close, ma_len8)
mashort5 = ta.ema(close, ma_len9)
malong5  = ta.ema(close, ma_len10)

// BB Trend Magic Logic
var int BB_DIR_UP = 1
var int BB_DIR_DN = -1

[bb_middle, bb_upper, bb_lower] = ta.bb(i_bb_src, i_bb_length, i_bb_mult)

float bb_magic = bb_lower
bb_magic := nz(bb_magic[1], bb_magic)

var int bb_dir = BB_DIR_DN

if close < bb_magic and bb_dir == BB_DIR_UP
    bb_dir := BB_DIR_DN

if close > bb_magic and bb_dir == BB_DIR_DN
    bb_dir := BB_DIR_UP

if bb_lower > bb_magic and bb_dir == BB_DIR_UP
    bb_magic := bb_lower

if bb_upper < bb_magic and bb_dir == BB_DIR_DN
    bb_magic := bb_upper

// Quantum Ribbon Visuals
f_get_color(is_bull, layer) =>
    base_col = is_bull ? i_bull_color : i_bear_color
    factor = 1.0 - ((layer - 1) * 0.15)
    color.rgb(math.round(color.r(base_col) * factor), math.round(color.g(base_col) * factor), math.round(color.b(base_col) * factor))

cloudcolor1 = f_get_color(mashort1 >= malong1, 1)
cloudcolor2 = f_get_color(mashort2 >= malong2, 2)
cloudcolor3 = f_get_color(mashort3 >= malong3, 3)
cloudcolor4 = f_get_color(mashort4 >= malong4, 4)
cloudcolor5 = f_get_color(mashort5 >= malong5, 5)

plot1 = plot(mashort1, color=na, display=display.none)
plot2 = plot(malong1, color=na, display=display.none)
plot3 = plot(mashort2, color=na, display=display.none)
plot4 = plot(malong2, color=na, display=display.none)
plot5 = plot(mashort3, color=na, display=display.none)
plot6 = plot(malong3, color=na, display=display.none)
plot7 = plot(mashort4, color=na, display=display.none)
plot8 = plot(malong4, color=na, display=display.none)
plot9 = plot(mashort5, color=na, display=display.none)
plot10 = plot(malong5, color=na, display=display.none)

t1 = math.max(0, math.min(100, ribbon_base_transp - 10))
t2 = math.max(0, math.min(100, ribbon_base_transp - 5))
t3 = math.max(0, math.min(100, ribbon_base_transp))
t4 = math.max(0, math.min(100, ribbon_base_transp + 5))
t5 = math.max(0, math.min(100, ribbon_base_transp + 10))

fill(plot1, plot2, color=color.new(cloudcolor1, t1), title="Cloud 1")
fill(plot3, plot4, color=color.new(cloudcolor2, t2), title="Cloud 2")
fill(plot5, plot6, color=color.new(cloudcolor3, t3), title="Cloud 3")
fill(plot7, plot8, color=color.new(cloudcolor4, t4), title="Cloud 4")
fill(plot9, plot10, color=color.new(cloudcolor5, t5), title="Cloud 5")

// BB Trend Magic Visuals
bb_color = bb_dir == BB_DIR_UP ? color.rgb(0, 121, 107, 20) : color.rgb(211, 47, 47, 20)
plot(bb_magic, "BB Magic", bb_color, i_bb_linewidth)

// -------------------------------------------------------------------------
// 5. VOLUME DELTA
// -------------------------------------------------------------------------
BuyPer      = volumeDelta(period)
DeltaColor  = color.from_gradient(BuyPer, 40, 60, colDn, colUp)
atr_delta   = ta.atr(200) * 2

if barstate.islast
    if deltaBar
        label.delete(
             label.new(bar_index+5+offset, hl2
                     , "Sell: " + str.tostring(100-BuyPer, format.percent) + "\nBuy: " + str.tostring(BuyPer, format.percent) 
                     , color = color(na)
                     , textcolor = DeltaColor
                     , style = label.style_label_left)[1]
         )

        top_delta  = hl2 + atr_delta
        bot_delta  = hl2 - atr_delta
        step_delta = (top_delta - bot_delta) / 100

        box.delete(
             box.new(bar_index+2+offset, hl2+atr_delta, bar_index+5+offset, hl2-atr_delta, bgcolor = colDn, border_color = chart.bg_color)[1]
         )
        box.delete(
             box.new(bar_index+2+offset, bot_delta+step_delta*BuyPer, bar_index+5+offset, bot_delta, bgcolor = colUp, border_color = chart.bg_color)[1]
         )
        line.delete(
             line.new(bar_index+2+offset, hl2, bar_index+5+offset, hl2, force_overlay = true, color = chart.bg_color, style = line.style_dotted)[1]
         )

// -------------------------------------------------------------------------
// 6. YINYANG RSI VOLUME TREND BACKGROUNDS
// -------------------------------------------------------------------------
// Mid Line
midHigh     = ta.vwma(ta.highest(high, yy_len), yy_len)
midLow      = ta.vwma(ta.lowest(low, yy_len), yy_len)
mid         = math.avg(midHigh, midLow)
midSmoothed = ta.ema(mid, yy_len)

// Volume Filtered
avgVol          = ta.vwma(volume, yy_len)
volDiff         = volume / avgVol
midVolSmoothed  = ta.vwma(midSmoothed * volDiff, 3)

// RSI Filtered
midDifference = ta.sma(midHigh - midLow, yy_len)
midRSI        = ta.rsi(midVolSmoothed, yy_len) * 0.01
midAdd        = midRSI * midDifference

// Calculate Zones
purchaseZoneHigh  = midSmoothed + midAdd
purchaseZoneLow   = midSmoothed - midAdd
purchaseZoneBasis = math.avg(purchaseZoneHigh, purchaseZoneLow)

// Create Stop Loss Locations
stopLossHigh = purchaseZoneHigh * (1 + (yy_sl_mult * 0.01))
stopLossLow  = purchaseZoneLow * (1 - (yy_sl_mult * 0.01))

// Determine Colors based on Toggle Input
yy_short_color = show_yy ? yy_res_col : na
yy_long_color  = show_yy ? yy_sup_col : na

// Hidden Line Plots for Background Filling
shortLine           = plot(purchaseZoneHigh, display=display.none)
shortStopLossLine   = plot(stopLossHigh, display=display.none) 
fill(shortLine, shortStopLossLine, color = yy_short_color, title="YY Short Background")

longLine            = plot(purchaseZoneLow, display=display.none)
longStopLossLine    = plot(stopLossLow, display=display.none) 
fill(longLine, longStopLossLine, color = yy_long_color, title="YY Long Background")

// -------------------------------------------------------------------------
// 7. ADAPTIVE ICHIMOKU CLOUD (STRICT CROSS)
// -------------------------------------------------------------------------
tenkan  = donchian(tenkanPeriods)
kijun   = donchian(kijunPeriods)
senkouA = math.avg(tenkan, kijun)
senkouB = donchian(senkouPeriods)

// Lagging Span (Chikou Span) value is the current close price
chikou = close

// --- Persistent State Cross Logic ---
// We use a 'var' trend tracker so the color ONLY updates on a true cross event
var int trend = 0

if ta.crossover(chikou, kijun)
    trend := 1
else if ta.crossunder(chikou, kijun)
    trend := -1

// Initialize the state for the very beginning of the chart before any crosses happen
if trend == 0
    trend := chikou > kijun ? 1 : -1

// Dynamic color logic using user inputs
chikouColor = trend == 1 ? chikou_up_col : chikou_dn_col

// --- Hidden Plots for Cloud Fill ---
// Plotted to exist for the fill, but completely hidden from the chart and Style menu
p1 = plot(senkouA, offset=displacement - 1, title="Senkou Span A", display=display.none, editable=false)
p2 = plot(senkouB, offset=displacement - 1, title="Senkou Span B", display=display.none, editable=false)

// Cloud fill is left in the menu but unchecked by default using display.none
fill(p1, p2, color=senkouA > senkouB ? color.new(#089981, 90) : color.new(color.red, 90), title="Cloud Fill", display=display.none)

// --- Plotting the Lagging Span ---
plot(chikou, offset=-displacement + 1, color=chikouColor, title="Lagging Span")

// --- Tiny Circle Head Logic ---
isUp   = ta.rising(chikou, 1)
isDown = ta.falling(chikou, 1)

plotshape(isUp ? chikou : na, offset=-displacement + 1, style=shape.circle, location=location.absolute, color=chikouColor, size=size.tiny, title="Tip Circle Up", show_last=1)
plotshape(isDown ? chikou : na, offset=-displacement + 1, style=shape.circle, location=location.absolute, color=chikouColor, size=size.tiny, title="Tip Circle Down", show_last=1)

// -------------------------------------------------------------------------
// 8. EMA FILL AREA
// -------------------------------------------------------------------------
pema1 = ta.ema(emafill_src, ema1_len)
pema2 = ta.ema(emafill_src, ema2_len)

ema1plot = plot(pema1, display=display.none, editable=false)
ema2plot = plot(pema2, display=display.none, editable=false)

// Uses a conditional check against the boolean toggle to hide or show the fill
emaFillColor = show_emafill ? (pema1 > pema2 ? color.new(color.gray, 75) : color.new(color.gray, 75)) : na
fill(ema1plot, ema2plot, color=emaFillColor, editable=true, title="EMA Fill Background")

// =========================================================================
// 9. ALERTS: STOP LONG & BB MAGIC CROSS
// =========================================================================

// ta.cross returns 'true' when series1 and series2 intersect in EITHER direction
bool lines_crossed = ta.cross(stop_long, bb_magic)

// Only alertcondition() is used here to force the UI to default to this specific condition
alertcondition(lines_crossed, title="Stop Long & BB Magic Crossed", message="Alert: Stop Long line and BB Trend Magic line have crossed!")
