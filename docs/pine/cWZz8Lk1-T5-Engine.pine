//@version=6
library("T5_Engine", overlay=false)

export run(
    series float ema50,
    series float ema200,
    series float atrPct,
    series float emaGapPct,
    series float btcEma50,
    series float btcEma200,
    series bool  isBarClose,
    series bool  crossUp21_50,
    series bool  crossDown21_50,

    bool  useBTCFilter,
    bool  useSpreadFilter,
    float minSpreadPctFixed,
    bool  useAdaptiveSpread,
    float spreadBaseMinPct,
    float spreadAtrK,

    float atrLowTh,
    float atrHighTh
) =>
    // Regime
    bool regimeBull = ema50 > ema200
    bool regimeBear = ema50 < ema200

    // BTC filter
    bool longBTCFilterOK  = (not useBTCFilter) or (btcEma50 > btcEma200)
    bool shortBTCFilterOK = (not useBTCFilter) or (btcEma50 < btcEma200)

    // Spread gate
    float minSpreadPct = minSpreadPctFixed
    if useAdaptiveSpread
        minSpreadPct := math.max(
            minSpreadPctFixed,
            math.max(spreadBaseMinPct, spreadAtrK * atrPct)
        )

    bool spreadOK = (not useSpreadFilter) or (emaGapPct >= minSpreadPct)

    // Entries
    bool longEntry  = isBarClose and crossUp21_50   and regimeBull and longBTCFilterOK  and spreadOK
    bool shortEntry = isBarClose and crossDown21_50 and regimeBear and shortBTCFilterOK and spreadOK

    // ATR buckets
    bool isLow  = atrPct < atrLowTh
    bool isHigh = atrPct > atrHighTh
    bool isMid  = not isLow and not isHigh

    float tp1_mult = isLow ? 0.90 : isMid ? 0.80 : 0.70
    float sl_mult  = isLow ? 2.60 : isMid ? 2.40 : 2.20

    // ✅ ALL arguments affect output
    [longEntry, shortEntry, regimeBull, regimeBear, tp1_mult, sl_mult]
