// CB_CandleLib — Shared Candlestick Pattern Library
// Version: 2.0.0 | Ayres Financial Intelligence System
// Classification: EXTERNAL_DETERMINISTIC | execution_location: external:tradingview
// Built: 2026-03-22 | Revised for Pine Script v6: 2026-03-22
//
// Publish to TradingView under account reidbotayres as a protected library.
// All three strategy indicators import this library. Publish FIRST.

//@version=6
library("CB_CandleLib", overlay = true)

// ---------------------------------------------------------------
// BODY / WICK HELPERS
// ---------------------------------------------------------------

export bodySize() =>
    math.abs(close - open)

export candleRange() =>
    high - low

export bodyRatio() =>
    float r = candleRange()
    r == 0.0 ? 0.0 : bodySize() / r

export upperWick() =>
    high - math.max(open, close)

export lowerWick() =>
    math.min(open, close) - low

export isBullish() =>
    close > open

export isBearish() =>
    close < open

export hasStrongBody(float minRatio = 0.55) =>
    bodyRatio() >= minRatio

export avgBody(int length = 14) =>
    ta.sma(bodySize(), length)

// ---------------------------------------------------------------
// BULLISH REVERSAL PATTERNS
// ---------------------------------------------------------------

export bullishEngulfing() =>
    bool prevBear = isBearish()[1]
    bool curBull  = isBullish()
    curBull and prevBear and open <= close[1] and close >= open[1] and bodySize() > bodySize()[1]

export hammer() =>
    float lw = lowerWick()
    float uw = upperWick()
    float bs = bodySize()
    bs > 0.0 and lw >= 2.0 * bs and uw <= bs * 0.3 and close >= open

export invertedHammer() =>
    float lw = lowerWick()
    float uw = upperWick()
    float bs = bodySize()
    bs > 0.0 and uw >= 2.0 * bs and lw <= bs * 0.3

export bullishPinBar() =>
    float cr = candleRange()
    float lw = lowerWick()
    float uw = upperWick()
    cr > 0.0 and lw / cr >= 0.65 and uw <= cr * 0.15

export morningStar() =>
    bool b2Bear = isBearish()[2]
    bool b0Bull = isBullish()
    float midOpen  = open[2]
    float midClose = close[2]
    b2Bear and bodySize()[1] <= bodySize()[2] * 0.35 and b0Bull and close >= (midOpen + midClose) / 2.0

export bullishHarami() =>
    bool prevBear = isBearish()[1]
    bool curBull  = isBullish()
    curBull and prevBear and open > close[1] and close < open[1] and bodySize() < bodySize()[1] * 0.5

export threeWhiteSoldiers() =>
    bool c0 = isBullish()
    bool c1 = isBullish()[1]
    bool c2 = isBullish()[2]
    bool priceOk = close > close[1] and close[1] > close[2]
    bool wicksOk = upperWick() <= bodySize() * 0.25 and upperWick()[1] <= bodySize()[1] * 0.25
    c0 and c1 and c2 and priceOk and wicksOk

// ---------------------------------------------------------------
// BEARISH REVERSAL PATTERNS
// ---------------------------------------------------------------

export bearishEngulfing() =>
    bool prevBull = isBullish()[1]
    bool curBear  = isBearish()
    curBear and prevBull and open >= close[1] and close <= open[1] and bodySize() > bodySize()[1]

export shootingStar() =>
    float uw = upperWick()
    float lw = lowerWick()
    float bs = bodySize()
    bs > 0.0 and uw >= 2.0 * bs and lw <= bs * 0.3 and isBearish()

export bearishPinBar() =>
    float cr = candleRange()
    float uw = upperWick()
    float lw = lowerWick()
    cr > 0.0 and uw / cr >= 0.65 and lw <= cr * 0.15

export eveningStar() =>
    bool b2Bull = isBullish()[2]
    bool b0Bear = isBearish()
    float midOpen  = open[2]
    float midClose = close[2]
    b2Bull and bodySize()[1] <= bodySize()[2] * 0.35 and b0Bear and close <= (midOpen + midClose) / 2.0

export bearishHarami() =>
    bool prevBull = isBullish()[1]
    bool curBear  = isBearish()
    curBear and prevBull and open < close[1] and close > open[1] and bodySize() < bodySize()[1] * 0.5

export threeBlackCrows() =>
    bool c0 = isBearish()
    bool c1 = isBearish()[1]
    bool c2 = isBearish()[2]
    bool priceOk = close < close[1] and close[1] < close[2]
    bool wicksOk = lowerWick() <= bodySize() * 0.25 and lowerWick()[1] <= bodySize()[1] * 0.25
    c0 and c1 and c2 and priceOk and wicksOk

// ---------------------------------------------------------------
// INDECISION / CONTINUATION PATTERNS
// ---------------------------------------------------------------

export doji(float maxBodyRatio = 0.10) =>
    float cr = candleRange()
    cr > 0.0 and bodyRatio() <= maxBodyRatio

export longLeggedDoji() =>
    float cr = candleRange()
    doji(0.08) and upperWick() >= cr * 0.35 and lowerWick() >= cr * 0.35

export dragonflyDoji() =>
    doji(0.08) and lowerWick() >= candleRange() * 0.70

export gravestoneDoji() =>
    doji(0.08) and upperWick() >= candleRange() * 0.70

export insideBar() =>
    high <= high[1] and low >= low[1]

export outsideBar() =>
    high > high[1] and low < low[1]

// ---------------------------------------------------------------
// COMPOSITE SCORES — used to populate technical_score.candlestick_pattern
// Returns 0 (none), 1 (weak/multi-candle), 2 (strong single-candle)
// ---------------------------------------------------------------

export bullishPatternScore() =>
    bool bEng = bullishEngulfing()
    bool bPin = bullishPinBar()
    bool bHam = hammer()
    if bEng or bPin or bHam
        2
    else if morningStar() or threeWhiteSoldiers() or bullishHarami() or invertedHammer()
        1
    else
        0

export bearishPatternScore() =>
    bool bEng = bearishEngulfing()
    bool bPin = bearishPinBar()
    bool bStar = shootingStar()
    if bEng or bPin or bStar
        2
    else if eveningStar() or threeBlackCrows() or bearishHarami()
        1
    else
        0

export bullishPatternName() =>
    if bullishEngulfing()
        "bullish_engulfing"
    else if bullishPinBar()
        "bullish_pin_bar"
    else if hammer()
        "hammer"
    else if morningStar()
        "morning_star"
    else if threeWhiteSoldiers()
        "three_white_soldiers"
    else if bullishHarami()
        "bullish_harami"
    else if invertedHammer()
        "inverted_hammer"
    else
        "none"

export bearishPatternName() =>
    if bearishEngulfing()
        "bearish_engulfing"
    else if bearishPinBar()
        "bearish_pin_bar"
    else if shootingStar()
        "shooting_star"
    else if eveningStar()
        "evening_star"
    else if threeBlackCrows()
        "three_black_crows"
    else if bearishHarami()
        "bearish_harami"
    else
        "none"

// ---------------------------------------------------------------
// VISUAL DEBUG OVERLAY — set to false in production
// ---------------------------------------------------------------

bool SHOW_LABELS = input.bool(false, "Show Pattern Labels (debug)")

if SHOW_LABELS
    if bullishEngulfing()
        label.new(bar_index, low, "BullEng", style = label.style_label_up,
             color = color.green, textcolor = color.white, size = size.tiny)
    if bearishEngulfing()
        label.new(bar_index, high, "BearEng", style = label.style_label_down,
             color = color.red, textcolor = color.white, size = size.tiny)
    if bullishPinBar()
        label.new(bar_index, low, "BullPin", style = label.style_label_up,
             color = color.teal, textcolor = color.white, size = size.tiny)
    if bearishPinBar()
        label.new(bar_index, high, "BearPin", style = label.style_label_down,
             color = color.orange, textcolor = color.white, size = size.tiny)
    if hammer()
        label.new(bar_index, low, "Hammer", style = label.style_label_up,
             color = color.lime, textcolor = color.black, size = size.tiny)
    if shootingStar()
        label.new(bar_index, high, "ShootStar", style = label.style_label_down,
             color = color.maroon, textcolor = color.white, size = size.tiny)
    if morningStar()
        label.new(bar_index, low, "MornStar", style = label.style_label_up,
             color = color.aqua, textcolor = color.black, size = size.tiny)
    if eveningStar()
        label.new(bar_index, high, "EveStar", style = label.style_label_down,
             color = color.purple, textcolor = color.white, size = size.tiny)
    if doji()
        label.new(bar_index, high, "Doji", style = label.style_label_down,
             color = color.gray, textcolor = color.white, size = size.tiny)
