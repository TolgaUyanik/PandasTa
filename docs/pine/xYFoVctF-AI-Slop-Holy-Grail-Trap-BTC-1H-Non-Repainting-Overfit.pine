//@version=6
strategy("AI Slop Holy Grail Trap - BTC 1H Non-Repainting Overfit", overlay=true, pyramiding=0, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1, margin_long=1, margin_short=1, process_orders_on_close=true, calc_on_every_tick=false, use_bar_magnifier=false)

// Input group labels 
string G_CAP  = "0 · Period · Capital"
string G_FILT = "1 · Trend & State Filters"
string G_BRK  = "2 · Pullback & Breakout"
string G_COIL = "3 · Coil & Reset"
string G_HOT  = "4 · Hot Continuation"
string G_VIEW = "5 · Visuals"

// ── 0 · Period · Capital ──────────────────────────────────────────────
int    startTime   = input.time(1514764800000, "Start Time", group=G_CAP, inline="win")  // 2018-01-01 UTC
int    endTime     = input.time(1893456000000, "End Time",   group=G_CAP, inline="win", tooltip="Backtest window. Entries fire only inside the window; any position still open at the end is closed.")  // 2030-01-01 UTC
float  leverage    = input.float(1.0, "Leverage", minval=1.0, maxval=125.0, step=0.5, group=G_CAP, tooltip="Multiplies margin into position size.\nNotional = Base Entry Amount (margin) × leverage.")
float  baseAmount  = input.float(50.0, "Base Entry Amount", minval=0.0, group=G_CAP, inline="amt")
string amountUnit  = input.string("%", "", options=["%", "$"], group=G_CAP, inline="amt", tooltip="Margin committed to one standard entry.\n% = percent of current equity (compounding).\n$ = fixed currency amount (no compounding).")
bool   useVarSizing = input.bool(false, "Variable Position Sizing", group=G_CAP, tooltip="Off (default for this fixed-equity build): every entry uses exactly the base amount.\nOn: each entry's margin scales with its rule's risk multiplier (base × multiplier).")

// Sizing & window helpers. stateMult is the per-rule risk multiplier; with
// Variable Position Sizing off it is ignored and every entry uses the base amount.
bool inWindow = time >= startTime and time <= endTime
qtyFor(float stateMult) =>
    float margin = (amountUnit == "%" ? strategy.equity * baseAmount / 100.0 : baseAmount) * (useVarSizing ? stateMult : 1.0)
    math.max(margin, 0.0) * leverage / close

// ── 1 · Trend & State Filters ─────────────────────────────────────────
pEff13Min = input.float(0.1039, "Min efficiency · 13-bar", minval=0.03, maxval=0.25, step=0.001, group=G_FILT)
pEff21Min = input.float(0.0795, "Min efficiency · 21-bar", minval=0.03, maxval=0.20, step=0.001, group=G_FILT)
pRangeWideAtr = input.float(2.67, "Wide-range threshold (ATR)", minval=1.20, maxval=4.50, step=0.01, group=G_FILT)
pAtrPctMin = input.float(0.00236, "Min ATR % of price", minval=0.0008, maxval=0.0060, step=0.0001, group=G_FILT)
pMacro21Tol = input.float(0.0199, "Macro slope tolerance · HMA21", minval=0.0, maxval=0.08, step=0.001, group=G_FILT)
pMacro55Tol = input.float(0.01, "Macro slope tolerance · HMA55", minval=0.0, maxval=0.05, step=0.001, group=G_FILT)
pTrend13Min = input.float(0.0262, "Min trend slope · HMA13", minval=0.0, maxval=0.10, step=0.001, group=G_FILT)
pSoft55Tol = input.float(0.0233, "Soft-trend slope tolerance · HMA55", minval=0.0, maxval=0.08, step=0.001, group=G_FILT)
pOverFastAtr = input.float(1.127, "Overextension · fast (ATR)", minval=0.50, maxval=2.00, step=0.01, group=G_FILT)
pOverSlowAtr = input.float(2.116, "Overextension · slow (ATR)", minval=1.20, maxval=3.60, step=0.01, group=G_FILT)

// ── 2 · Pullback & Breakout ───────────────────────────────────────────
pPullRange34Min = input.float(0.80, "Pullback min range position · 34", minval=0.50, maxval=0.98, step=0.01, group=G_BRK)
pBreakRet12Min = input.float(0.0196, "Breakout min 12-bar return", minval=0.000, maxval=0.060, step=0.001, group=G_BRK)
pBreakVolMin = input.float(1.19, "Breakout min relative volume", minval=0.40, maxval=2.20, step=0.01, group=G_BRK)
pBreakEff13Min = input.float(0.18, "Breakout min efficiency · 13", minval=0.02, maxval=0.40, step=0.01, group=G_BRK)

// ── 3 · Coil & Reset ──────────────────────────────────────────────────
pCoilRangeMax = input.float(2.962, "Coil max range (ATR)", minval=1.40, maxval=5.80, step=0.01, group=G_COIL)
pCoilEff13Max = input.float(0.467, "Coil max efficiency · 13", minval=0.15, maxval=0.80, step=0.01, group=G_COIL)
pCoilAcc13Min = input.float(0.32, "Coil min acceleration · 13", minval=-0.10, maxval=0.90, step=0.01, group=G_COIL)
pH21ClosePosMin = input.float(0.735, "HMA21 reset min close position", minval=0.45, maxval=0.96, step=0.01, group=G_COIL)

// ── 4 · Hot Continuation ──────────────────────────────────────────────
pHotRsiMin = input.float(70.78, "Hot continuation min RSI", minval=55.0, maxval=82.0, step=0.5, group=G_HOT)
pHotDist8Min = input.float(1.512, "Hot continuation min distance · HMA8 (ATR)", minval=0.60, maxval=2.80, step=0.01, group=G_HOT)

prevClose = nz(close[1], close)
tr = math.max(high - low, math.max(math.abs(high - prevClose), math.abs(low - prevClose)))
atr8 = ta.sma(tr, 8)
atr21 = ta.sma(tr, 21)
atrPct = atr8 / close
atrRatio = atr21 > 0.0 ? atr8 / atr21 : na
vol21 = ta.sma(volume, 21)
volRel = vol21 > 0.0 ? volume / vol21 : 0.0

hma5 = ta.wma(2.0 * ta.wma(close, 2) - ta.wma(close, 5), 2)
hma8 = ta.wma(2.0 * ta.wma(close, 4) - ta.wma(close, 8), 3)
hma13 = ta.wma(2.0 * ta.wma(close, 6) - ta.wma(close, 13), 4)
hma21 = ta.wma(2.0 * ta.wma(close, 10) - ta.wma(close, 21), 5)
hma34 = ta.wma(2.0 * ta.wma(close, 17) - ta.wma(close, 34), 6)
hma55 = ta.wma(2.0 * ta.wma(close, 27) - ta.wma(close, 55), 7)
hma89 = ta.wma(2.0 * ta.wma(close, 44) - ta.wma(close, 89), 9)

prevHigh = nz(high[1], high)
prevLow = nz(low[1], low)
hi8 = ta.highest(prevHigh, 8)
hi13 = ta.highest(prevHigh, 13)
hi21 = ta.highest(prevHigh, 21)
hi34 = ta.highest(prevHigh, 34)
hi55 = ta.highest(prevHigh, 55)
lo8 = ta.lowest(prevLow, 8)
lo13 = ta.lowest(prevLow, 13)
lo34 = ta.lowest(prevLow, 34)
lo55 = ta.lowest(prevLow, 55)
hi14 = ta.highest(high, 14)
lo14 = ta.lowest(low, 14)

barRange = math.max(high - low, syminfo.mintick)
closePos = (close - low) / barRange
bodyPct = math.abs(close - open) / barRange
upperWick = (high - math.max(open, close)) / barRange
lowerWick = (math.min(open, close) - low) / barRange
range13 = math.max(hi13 - lo13, syminfo.mintick)
range34 = math.max(hi34 - lo34, syminfo.mintick)
range55 = math.max(hi55 - lo55, syminfo.mintick)
rangePos13 = (close - lo13) / range13
rangePos34 = (close - lo34) / range34
rangePos55 = (close - lo55) / range55

absChange = math.abs(close - prevClose)
eff13Den = ta.sma(absChange, 13) * 13.0
eff21Den = ta.sma(absChange, 21) * 21.0
eff13 = eff13Den > 0.0 ? math.abs(close - close[13]) / eff13Den : 0.0
eff21 = eff21Den > 0.0 ? math.abs(close - close[21]) / eff21Den : 0.0

slope5 = (hma5 - hma5[2]) / atr8
slope8 = (hma8 - hma8[3]) / atr8
slope13 = (hma13 - hma13[3]) / atr8
slope21 = (hma21 - hma21[5]) / atr8
slope55 = (hma55 - hma55[8]) / atr8
acc5 = ((hma5 - hma5[2]) - (hma5[2] - hma5[4])) / atr8
acc13 = ((hma13 - hma13[3]) - (hma13[3] - hma13[6])) / atr8
dist8 = (close - hma8) / atr8
dist13 = (close - hma13) / atr8
dist21 = (close - hma21) / atr8
dist55 = (close - hma55) / atr8
h55h89 = (hma55 - hma89) / atr8

stackUp = hma5 > hma8 and hma8 > hma13 and hma13 > hma21
stackDn = hma5 < hma8 and hma8 < hma13 and hma13 < hma21
macroUp = hma13 > hma21 and hma21 > hma34 and slope21 > -pMacro21Tol
macroDn = hma13 < hma21 and hma21 < hma34 and slope21 < pMacro21Tol
trendUp = stackUp and macroUp and slope13 > pTrend13Min
trendDn = stackDn and macroDn and slope13 < -pTrend13Min
trendUpSoft = hma8 > hma21 and hma13 > hma34 and close > hma55 and slope55 > -pSoft55Tol
macroBull = close > hma55 and hma21 > hma55 and hma55 > hma89 and slope55 > -pMacro55Tol
macroBear = close < hma55 and hma21 < hma55 and hma55 < hma89 and slope55 < pMacro55Tol
rangeWide = range13 / atr8 > pRangeWideAtr
notDeadChop = eff13 > pEff13Min or eff21 > pEff21Min or rangeWide
volOk = atrPct > pAtrPctMin and atr8 > syminfo.mintick
overUp = dist8 > pOverFastAtr or dist21 > pOverSlowAtr
overDn = dist8 < -pOverFastAtr or dist21 < -pOverSlowAtr
rsi14 = ta.rsi(close, 14)
stoch14 = hi14 - lo14 > 0.0 ? (close - lo14) / (hi14 - lo14) : na
stochSlope = stoch14 - stoch14[3]
bbMid20 = ta.sma(close, 20)
bbSd20 = ta.stdev(close, 20)
bbWidth20 = bbMid20 > 0.0 ? 4.0 * bbSd20 / bbMid20 : na

ret6 = close / close[6] - 1.0
ret12 = close / close[12] - 1.0
ret21 = close / close[21] - 1.0
ret34 = close / close[34] - 1.0
rankLen = 340
eff21Rank = ta.percentrank(eff21, rankLen) / 100.0
ret34Rank = ta.percentrank(ret34, rankLen) / 100.0
slope21Rank = ta.percentrank(slope21, rankLen) / 100.0
volRelRank = ta.percentrank(volRel, rankLen) / 100.0
bbWidth20Rank = ta.percentrank(bbWidth20, rankLen) / 100.0
breakLong = close > hi8 and closePos > 0.62 and bodyPct > 0.28
pullLong = low <= hma13 + 0.25 * atr8 and close > hma8 and closePos > 0.58
pullRangeOk = rangePos34 > pPullRange34Min
breakDrive = ret34 > 0.025
breakExhaust = ret12 > 0.045 and volRel > 2.20 and dist21 > 1.40
lBreakThrustUnderExpRisk = slope5 > 1.10 and dist13 < 1.25 and volRel < 2.00
lBreakLateEffRangeRisk = eff21 > 0.56 and slope5 > 1.10 and rangePos55 > 0.88
lBreakEffWickRisk = eff21 > 0.60 and dist21 > 1.00 and upperWick > 0.20
freshDrive = ret34 > 0.012 and (ret12 > 0.004 or acc13 > 0.02)
coilBreak = trendUpSoft and close > hi8 and closePos > 0.68 and bodyPct > 0.28 and range13 / atr8 < pCoilRangeMax and eff13 < pCoilEff13Max and ret6 > -0.002 and ret21 > -0.006 and volRel > 0.55 and volRel < 2.10 and dist8 > -0.10 and dist21 < 1.05 and acc13 > pCoilAcc13Min
h21Reset = macroBull and trendUpSoft and low <= hma21 + 0.20 * atr8 and close > hma13 and closePos > pH21ClosePosMin and dist21 < 0.65 and dist21 > -0.40 and rangePos34 > 0.75 and eff13 < 0.55 and ret34 > 0.004 and ret12 > -0.012 and volRel > 0.45 and volRel < 1.80 and (hma55 - hma89) / atr8 < 1.10 and acc5 > -0.45
midChaseLong = dist21 >= 1.30 and dist21 < 1.80
weakMaturePull = (hma55 - hma89) / atr8 > 1.00 and bodyPct < 0.45
quietMaturePull = eff13 > 0.60 and volRel < 1.00 and (hma55 - hma89) / atr8 > 0.55
h21ResetRiskCut = acc5 < -0.10
h21ResetQuietTopRisk = rangePos55 > 0.90 and volRel < 0.95
maturePullFail = slope55 > 0.85 and acc5 < -0.45 and ret34 > 0.020
breakShort = close < lo8 and closePos < 0.34 and bodyPct > 0.30
bearSpreadOk = (hma55 - hma89) / atr8 >= -0.70
bearFlush = trendDn and breakShort and rangePos34 < 0.32 and ret34 < -0.035 and ret12 < -0.012 and volRel > 1.60 and volRel < 3.00 and lowerWick >= 0.18 and bearSpreadOk and not overDn
sFlushShallowEff = dist21 > -1.20 and eff13 >= 0.55
sFlushRangeKnifeRisk = range34 / atr8 < 7.00 and lowerWick > 0.24 and h55h89 < -0.35
sFlushLowEffFailRisk = slope5 > -1.20 and eff13 > 0.55 and eff21 < 0.55
bearRallyReject = macroBear and hma8 < hma21 and hma13 < hma34 and high >= hma34 - 0.10 * atr8 and close < hma8 and closePos < 0.46 and upperWick > 0.42 and ret6 > -0.006 and ret12 > -0.015 and ret12 < 0.004 and dist21 > -1.20 and rangePos34 < 0.70 and acc5 < 0.20 and volRel > 0.45 and volRel < 2.80
bearSlide = macroBear and hma8 < hma21 and hma13 < hma34 and close < hma8 and high >= hma21 - 0.20 * atr8 and closePos < 0.46 and upperWick > 0.38 and ret6 > -0.018 and ret12 < 0.006 and ret34 < -0.012 and dist21 > -1.20 and dist21 < 0.70 and rangePos34 < 0.72 and acc5 < 0.05 and close < open and slope5 < 0.00 and slope8 < -0.15 and volRel > 0.35 and volRel < 2.60 and not overDn
sSlideNoRejectFallRisk = upperWick < 0.54 and slope8 < -0.55 and slope55 < -0.40
sSlideLowRangeStallRisk = rangePos55 < 0.10 and acc5 > -0.50 and eff21 < 0.45
sSlideDeepNormalRisk = dist55 < -2.00 and volRel >= 0.95 and volRel < 1.50
mixedAuctionFailShort = not (macroBull and trendUpSoft) and not (macroBear and trendDn) and high >= hi8 - 0.05 * atr8 and close < hma13 and closePos < 0.32 and bodyPct > 0.22 and rangePos34 > 0.45 and acc13 < 0.10 and dist21 > -0.75 and dist21 < 1.10 and ret12 < 0.020 and volRel > 0.75 and volRel < 2.60 and upperWick > 0.52 and eff13 < 0.30
shelfFailShort = not trendUp and high >= hma34 - 0.10 * atr8 and close < hma13 and closePos < 0.38 and upperWick > 0.34 and rangePos34 > 0.50 and rangePos34 < 0.76 and rangePos55 > 0.42 and rangePos55 < 0.82 and dist21 > -0.85 and dist21 < 0.85 and dist55 <= -0.15 and ret21 < 0.020 and ret34 > -0.045 and ret34 < 0.030 and eff13 < 0.34 and volRel > 0.40 and volRel < 2.30 and acc5 <= -0.10 and slope55 < 0.20 and h55h89 > 0.15
sShelfResidualRisk = dist55 < -0.70 and ret34 > -0.025 and ret34 < 0.025
washoutLong = not trendDn and rangePos34 < 0.00 and dist21 >= -1.20 and dist21 < -0.50 and volRel >= 0.80 and volRel < 1.20
deepWashLong = not trendDn and rangePos34 < 0.00 and ret34 < -0.060 and dist21 >= -1.80 and dist21 < -0.35 and volRel >= 0.80 and volRel < 2.10 and (volRel < 1.80 or dist21 < -0.80)
r21ReclaimLong = not trendDn and low <= hma21 and close > hma21 and closePos > 0.60 and bodyPct > 0.00 and rangePos34 >= 0.30 and rangePos34 < 0.70 and dist21 >= 0.65 and dist21 < 1.70 and ret34 >= -0.090 and ret34 < -0.018 and volRel >= 0.75 and volRel < 2.10 and eff13 < 0.30 and acc5 > 0.10
lR21SoftLowEffRisk = volRel < 1.50 and slope8 > 0.00 and eff13 < 0.20
c21CompactLong = not trendDn and low <= hma21 and close > hma21 and closePos > 0.58 and rangePos34 >= 0.45 and rangePos34 < 0.88 and dist21 >= -0.20 and dist21 < 0.80 and ret34 >= -0.020 and ret34 < 0.040 and volRel >= 0.70 and volRel < 2.10 and range13 / atr8 < 2.20 and eff13 < 0.28 and acc5 > -0.55
c21ExtendedHold = rangePos34 > 0.48 and rangePos55 > 0.48 and closePos > 0.75 and lowerWick > 0.45 and volRel > 1.50 and volRel < 2.40 and slope21 > 0.35 and dist55 > 0.30 and ret21 > -0.012 and ret34 > -0.012 and not macroBear
c21ResidualRisk = slope21 < -0.05 and rangePos55 > 0.70
deepPullReclaimLong = not trendDn and low <= hma21 and close > hma21 and closePos > 0.58 and rangePos34 >= 0.00 and rangePos34 < 0.40 and dist21 >= -0.60 and dist21 < 0.35 and ret21 <= -0.024 and ret34 >= -0.050 and ret34 < 0.010 and volRel >= 0.35 and volRel < 1.20 and range13 / atr8 < 4.50 and eff13 < 0.28 and acc5 > 0.35
rallyH21RejectShort = not trendUp and high >= hma21 and close < hma21 and closePos < 0.48 and rangePos34 >= 0.45 and rangePos34 < 0.88 and dist21 >= -0.60 and dist21 < 0.35 and ret21 >= 0.011 and ret34 >= -0.050 and ret34 < 0.010 and volRel >= 1.00 and volRel < 2.60 and eff13 < 0.28 and acc5 < 0.10
quietTrendContinueLong = not trendDn and not macroBear and range55 / atr8 < 7.20 and atr8 / atr21 < 0.81 and close > hma13 and slope8 > 0.12 and slope8 < 0.61 and rangePos55 > 0.72 and closePos > 0.52 and volRel > 0.35 and volRel < 1.60 and dist21 > -0.35 and dist21 < 1.40 and ret21 > -0.040 and ret34 < 0.055 and eff21 < 0.55
h13CompactReclaimLong = not trendDn and low <= hma13 and close > hma13 and closePos > 0.58 and rangePos34 >= 0.00 and rangePos34 < 0.40 and dist21 >= -0.20 and dist21 < 0.80 and ret34 >= -0.020 and ret34 < 0.040 and volRel >= 0.35 and volRel < 1.20 and range13 / atr8 < 3.40 and range34 / atr8 < 3.80 and eff13 < 0.55 and acc5 > 0.35
rallyExhaustShort = not macroBull and ret21 > 0.045 and eff21 > 0.55 and slope21 > 0.22 and volRel < 0.95 and dist21 < 2.40 and rangePos55 > 0.35 and ret34 < 0.16
sRupExtendedHold = rangePos55 > 0.86 and ret21 > 0.045 and ret34 > 0.040 and dist55 > 1.20 and dist21 < 0.80 and volRel < 1.20
upperPumpFailShort = not macroBear and not trendDn and rangePos55 > 0.90 and rangePos34 > 0.65 and ret21 > 0.080 and eff21 > 0.38 and volRel < 0.75 and dist21 > -3.20 and dist21 < 2.20 and dist55 > -0.50 and dist55 < 3.50 and rsi14 > 58.0 and bbWidth20Rank > 0.55 and range55 / atr8 > 5.00 and (closePos < 0.55 or upperWick > 0.28) and slope21 > -3.00
highRangeQuietFadeShort = not macroBear and not trendDn and rangePos55 > 0.86 and rangePos34 > 0.74 and ret21 > 0.035 and volRel < 0.95 and slope21 < 0.30 and dist21 > 0.00 and dist21 < 0.45 and rsi14 > 58.0 and dist55 > -0.80 and dist55 < 2.60 and (closePos < 0.55 or upperWick > 0.36)
bullPauseTightShort = macroBull and not trendDn and rangePos34 > 0.82 and rangePos55 > 0.82 and dist21 > -1.20 and dist21 < 0.45 and dist55 > 0.50 and dist55 < 2.30 and ret21 > 0.000 and ret21 < 0.020 and upperWick > 0.48 and closePos < 0.45 and volRel > 0.35 and volRel < 1.25 and eff21 < 0.50 and rsi14 > 52.0 and rsi14 < 68.0 and slope55 > 0.40 and slope55 < 1.70
bearLowContinuationShort = macroBear and not trendUp and rangePos34 < 0.24 and rangePos55 < 0.20 and dist21 > 0.60 and dist21 < 1.50 and dist55 > -1.00 and dist55 < 0.40 and ret21 > -0.035 and ret21 < 0.004 and ret34 > -0.040 and ret34 < 0.010 and volRel > 1.20 and volRel < 2.20 and closePos > 0.62 and eff21 > 0.25 and slope21 < -0.35 and upperWick < 0.48
volumePivotLong = not macroBear and not trendDn and rangePos34 > 0.05 and rangePos34 < 0.34 and rangePos55 > 0.05 and rangePos55 < 0.40 and ret34 > -0.070 and ret34 < 0.006 and ret21 > -0.055 and ret21 < 0.045 and volRel > 1.70 and volRel < 4.30 and dist55 > 1.90 and dist55 < 4.40 and dist21 > -0.10 and dist21 < 2.25 and closePos > 0.46 and (lowerWick > 0.25 or close > prevHigh or low <= hma8 + 0.15 * atr8 and close > hma8) and eff21 < 0.70 and upperWick < 0.70
bearMidAccelShort = macroBear and not trendUp and ret21 > -0.027 and ret21 < -0.018 and ret34 <= -0.021 and rangePos34 < 0.32 and rangePos55 < 0.30 and eff21 > 0.42 and slope8 < -0.50 and slope21 < -0.05 and dist55 < -0.50 and dist21 > -1.55 and dist21 < 0.95 and volRel > 0.35 and volRel < 2.20 and closePos > 0.10 and closePos < 0.80 and upperWick <= 0.23
neutralRangeEdgeShort = not trendDn and not trendUp and rangePos55 > 0.88 and rangePos34 > 0.68 and eff21Rank < 0.42 and ret34Rank > 0.52 and ret34Rank < 0.98 and dist21 > -0.95 and dist21 < 2.20 and slope21Rank > 0.18 and slope21Rank < 0.90 and high >= hi21 - 0.30 * atr8 and closePos < 0.38 and upperWick > 0.30 and volRelRank > 0.06 and volRelRank < 0.90
nEdgeCarryHold = macroBull and upperWick > 0.70 and lowerWick < 0.05 and ret21 > 0.003 and ret21 < 0.007 and ret34 > 0.008 and ret34 < 0.018 and rangePos34 > 0.82 and rangePos34 < 0.88 and rangePos55 > 0.86 and rangePos55 < 0.90
bearLowerTailLong = macroBear and not trendDn and rangePos55 > 0.12 and rangePos55 < 0.34 and rangePos34 < 0.52 and rangePos13 < 0.80 and ret21 > -0.018 and ret21 < -0.005 and ret34 > -0.065 and ret34 < 0.018 and dist21 > -0.20 and dist21 < 0.75 and low <= hma21 + 0.35 * atr8 and slope21 > -0.75 and slope21 < 0.20 and lowerWick > 0.42 and upperWick < 0.30 and closePos > 0.62 and bodyPct < 0.66 and acc5 > -0.35 and eff21 < 0.45 and volRel > 0.60 and volRel < 2.60
hotContinueLong = not macroBear and not trendDn and rangePos34 > 0.70 and rangePos13 > 0.68 and dist8 > pHotDist8Min and dist21 > 0.60 and rsi14 > pHotRsiMin and stoch14 > 0.72 and ret6 > 0.004 and ret21 > -0.006 and slope8 > 0.70 and slope13 > 0.25 and acc5 > -0.55 and close > hma8 and hma8 > hma13 and (close > hi8 or closePos > 0.62 or bodyPct > 0.42) and upperWick < 0.42 and range13 / atr8 < 6.80 and bbWidth20Rank < 0.92 and volRel > 0.35 and volRel < 3.40
