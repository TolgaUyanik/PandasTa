    ruleNow := "S_BCLX"

if inWindow and sideNow == 1
    strategy.entry("L", strategy.long, qty=qtyFor(riskNow), comment=ruleNow)
    entryBar := bar_index
    activeHold := holdNow
    activeRule := ruleNow
    entryClose := close
    entryAtr := atr8
    activeLow := low
else if inWindow and sideNow == -1
    strategy.entry("S", strategy.short, qty=qtyFor(riskNow), comment=ruleNow)
    entryBar := bar_index
    activeHold := holdNow
    activeRule := ruleNow
    entryClose := close
    entryAtr := atr8
    activeLow := low

if strategy.position_size != 0
    activeLow := na(activeLow) ? low : math.min(activeLow, low)

holdBars = not na(entryBar) ? bar_index - entryBar : na
h21DrawdownAtr = not na(entryClose) and not na(entryAtr) and entryAtr > 0.0 and not na(activeLow) ? (activeLow - entryClose) / entryAtr : 0.0
longH21Slip = strategy.position_size > 0 and activeRule == "L_H21R" and not na(holdBars) and holdBars >= 2 and holdBars <= 4 and h21DrawdownAtr < -0.80 and close < hma21
longCoilTimeCarry = strategy.position_size > 0 and not na(holdBars) and activeRule == "L_COIL" and holdBars >= activeHold and holdBars < 72 and not macroBear and rangePos55 > 0.35 and dist21 > -1.85 and ret21 > -0.040 and ret34 > -0.045 and h55h89 > -0.85 and close > hma55 - 1.80 * atr8
longCoilRecoveryCarry = strategy.position_size > 0 and not na(holdBars) and activeRule == "L_COIL" and holdBars >= activeHold and holdBars < 96 and h21DrawdownAtr > -2.60 and rangePos55 > 0.12 and dist21 > -3.10 and ret21 > -0.085 and ret34 > -0.095 and h55h89 > -1.65
longCarryMfeAtr = not na(entryClose) and not na(entryAtr) and entryAtr > 0.0 ? (high - entryClose) / entryAtr : 0.0
longCarryEdgeAtr = not na(entryClose) and not na(entryAtr) and entryAtr > 0.0 ? (close - entryClose) / entryAtr : 0.0
longC21ImpulseTimeCarry = strategy.position_size > 0 and not na(holdBars) and activeRule == "L_C21C" and activeHold <= 8 and holdBars >= activeHold and holdBars < 24 and longCarryMfeAtr > 3.00 and longCarryEdgeAtr > 1.20 and not macroBear and ret34 > -0.015 and close > hma34 - 0.30 * atr8
longPullTimeCarry = strategy.position_size > 0 and not na(holdBars) and activeRule == "L_PULL" and activeHold >= 28 and holdBars >= activeHold and holdBars < activeHold + 6 and close > entryClose and not macroBear and rangePos55 > 0.56 and ret21 < 0.004 and ret34 > 0.004 and h55h89 > 0.10 and dist21 > -1.95
longTimeCarry = (strategy.position_size > 0 and not na(holdBars) and holdBars >= activeHold and holdBars < activeHold + 6 and close > entryClose and ((activeRule == "L_OSNAP" and activeHold > 4 and rangePos34 > 0.24 and dist21 > -0.85 and ret34 > -0.050 and h55h89 > -1.10 and slope21 > -2.00) or (activeRule == "L_OSNAP" and activeHold == 4 and rangePos34 > 0.50 and rangePos34 < 0.75 and rangePos55 > 0.50 and dist21 > -0.10 and ret21 > -0.012 and ret34 > -0.012 and h55h89 > -0.60 and slope21 > -1.20) or (activeRule == "L_C21C" and activeHold >= 26 and rangePos34 > 0.50 and dist21 > -0.20 and ret21 > 0.020 and ret34 > 0.035 and h55h89 > -0.20) or ((activeRule == "L_PULL" and activeHold >= 28 and rangePos55 > 0.70 and dist21 > -0.65 and ret34 > 0.015 and h55h89 > 0.70) or (activeRule == "L_PULL" and activeHold >= 28 and holdBars < activeHold + 6 and rangePos55 > 0.76 and dist21 > 0.60 and ret21 > -0.002 and ret34 > 0.015 and closePos > 0.58 and h55h89 > 0.05)) or ((activeRule == "L_TAILQ" and activeHold >= 9 and holdBars < activeHold + 2 and macroBull and rangePos34 > 0.68 and rangePos34 < 0.78 and rangePos55 > 0.68 and rangePos55 < 0.78 and dist21 > 0.00 and dist55 > 1.70 and ret21 > 0.015 and ret34 > 0.005 and closePos > 0.25 and closePos < 0.42 and acc5 < -2.00) or (activeRule == "L_TAILQ" and activeHold >= 9 and holdBars < activeHold + 2 and macroBull and rangePos34 > 0.40 and rangePos34 < 0.50 and rangePos55 > 0.40 and rangePos55 < 0.50 and dist21 > -1.45 and dist55 > 0.20 and ret21 > 0.005 and ret34 > 0.000 and volRel > 1.50 and closePos < 0.25 and bodyPct > 0.55 and acc5 < -1.50)))) or longCoilTimeCarry or longCoilRecoveryCarry or longC21ImpulseTimeCarry or longPullTimeCarry
longTimed = strategy.position_size > 0 and not na(entryBar) and bar_index - entryBar >= activeHold and not longTimeCarry
shortPumpTopTimeCarry = strategy.position_size < 0 and not na(holdBars) and activeRule == "S_PTOP" and holdBars >= activeHold and holdBars < 48 and close < entryClose and not macroBull and ret21 < 0.090 and ret34 < 0.120 and rangePos55 < 1.18 and dist55 < 3.80 and close < hma34 + 1.00 * atr8
shortCarryMfeAtr = not na(entryClose) and not na(entryAtr) and entryAtr > 0.0 and not na(activeLow) ? (entryClose - activeLow) / entryAtr : 0.0
shortCarryEdgeAtr = not na(entryClose) and not na(entryAtr) and entryAtr > 0.0 ? (entryClose - close) / entryAtr : 0.0
shortHighRangeImpulseCarry = strategy.position_size < 0 and not na(holdBars) and activeRule == "S_HIRANGE" and holdBars >= activeHold and holdBars < 72 and shortCarryMfeAtr > 2.40 and shortCarryEdgeAtr > 0.8 and ret21 < 0.090 and ret34 < 0.135 and close < hma34 + 0.80 * atr8
shortBmidImpulseCarry = strategy.position_size < 0 and not na(holdBars) and activeRule == "S_BMID" and holdBars >= activeHold and holdBars < 144 and close < entryClose and shortCarryMfeAtr > 1.20 and shortCarryEdgeAtr > 0.45 and not macroBull and ret21 < 0.030 and ret34 < 0.055 and close < hma34 + 0.85 * atr8
shortTimeCarry = (strategy.position_size < 0 and not na(holdBars) and activeRule == "S_NEDGE" and activeHold > 12 and holdBars >= 30 and holdBars < 31 and close < entryClose and macroBear and rangePos34 > 0.20 and rangePos34 < 0.36 and dist21 > 0.80 and dist55 < 0.20 and ret21 < -0.005 and ret34 < -0.005 and volRel < 0.80) or shortPumpTopTimeCarry or shortHighRangeImpulseCarry or shortBmidImpulseCarry
shortTimed = strategy.position_size < 0 and not na(entryBar) and bar_index - entryBar >= activeHold and not shortTimeCarry
longC21TrendCarry = strategy.position_size > 0 and activeRule == "L_C21C" and activeHold >= 26 and not na(holdBars) and holdBars >= 20 and close > entryClose and macroBull and trendUp and rangePos34 > 0.90 and ret21 > 0.030 and ret34 > 0.045 and closePos > 0.55
longRotationTake = strategy.position_size > 0 and not na(entryBar) and bar_index - entryBar >= 5 and dist8 > 1.10 and close < hma5 and upperWick > 0.22 and not longC21TrendCarry
shortRotationTake = strategy.position_size < 0 and not na(entryBar) and bar_index - entryBar >= 4 and dist8 < -0.95 and close > hma5 and lowerWick > 0.22
shortMfeAtr = not na(entryClose) and not na(entryAtr) and entryAtr > 0.0 and not na(activeLow) ? (entryClose - activeLow) / entryAtr : 0.0
shortGivebackAtr = not na(entryAtr) and entryAtr > 0.0 and not na(activeLow) ? (close - activeLow) / entryAtr : 0.0
shortBank = strategy.position_size < 0 and activeRule == "S_REJECT" and (activeHold <= 8 or holdBars >= 60) and not na(holdBars) and holdBars >= 3 and shortMfeAtr > 0.80 and shortGivebackAtr > 0.45 and closePos > 0.55
shortFlushBank = strategy.position_size < 0 and activeRule == "S_FLUSH" and not na(holdBars) and holdBars >= 4 and shortMfeAtr > 1.00 and shortGivebackAtr > 0.60 and closePos > 0.55 and close > hma5 and close < entryClose
shortFlushReclaim = strategy.position_size < 0 and activeRule == "S_FLUSH" and not na(entryBar) and bar_index - entryBar >= 4 and bar_index - entryBar <= 8 and close > strategy.position_avg_price and close > hma8 and closePos > 0.72 and lowerWick < 0.14
shortRejectReclaim = strategy.position_size < 0 and activeRule == "S_REJECT" and not na(entryBar) and bar_index - entryBar >= 3 and bar_index - entryBar <= 5 and close > strategy.position_avg_price and dist13 > 0.25 and closePos > 0.80 and upperWick < 0.20
longPullStructureCarry = strategy.position_size > 0 and not na(holdBars) and activeRule == "L_PULL" and activeHold >= 28 and holdBars < activeHold and close > entryClose and not macroBear and rangePos55 > 0.62 and ret34 > 0.008 and h55h89 > 0.20 and dist21 > -1.90
longGapCarry = (strategy.position_size > 0 and not na(entryClose) and close > entryClose and ((activeRule == "L_OSNAP" and activeHold > 4 and dist21 > -1.40 and rangePos34 > 0.18) or (activeRule == "L_C21C" and dist21 > -1.60 and rangePos34 > 0.50 and ret34 > 0.000 and not macroBear and (ret21 > 0.005 or (holdBars >= 20 and ret21 > 0.003 and ret34 > 0.010 and lowerWick > 0.50 and h55h89 > 0.80))) or (activeRule == "L_PULL" and dist21 > -1.60 and rangePos55 > 0.70 and ret34 > 0.015 and not macroBear and (ret21 > 0.015 or (holdBars >= 23 and ret21 > 0.010 and h55h89 > 1.40))))) or longPullStructureCarry
longShockCarry = strategy.position_size > 0 and activeRule == "L_OSNAP" and activeHold == 7 and not na(holdBars) and holdBars <= 6 and macroBear and dist21 > -0.35 and rangePos34 > 0.03 and rangePos34 < 0.20
longInvalid = strategy.position_size > 0 and activeRule != "L_WASH" and activeRule != "L_DWASH" and activeRule != "L_LOWC" and activeRule != "L_LOWX" and activeRule != "L_LOWB2" and activeRule != "L_LOWD2" and activeRule != "L_LOWM" and activeRule != "L_MBASE" and activeRule != "L_BDIP" and activeRule != "L_BSHK" and activeRule != "L_MBOD" and activeRule != "L_MNWK" and activeRule != "L_MBT" and activeRule != "L_STAIL" and activeRule != "L_SREC" and activeRule != "L_NLR" and activeRule != "L_BACX" and activeRule != "L_BDL" and activeRule != "L_BDS" and not longShockCarry and not longGapCarry and not longTimeCarry and not na(entryBar) and bar_index - entryBar >= 3 and (close < hma34 - 0.55 * atr8 or (dist8 > 1.45 and close < hma5 and upperWick > 0.30))
shortInvalid = strategy.position_size < 0 and not shortTimeCarry and (activeRule != "S_REJECT" or activeHold <= 8 or holdBars >= 60) and not na(entryBar) and bar_index - entryBar >= 3 and (close > hma34 + 0.55 * atr8 or (dist8 < -1.35 and close > hma5 and lowerWick > 0.30))
if longH21Slip
    strategy.close("L", comment=activeRule + " slip")
else if longRotationTake
    strategy.close("L", comment=activeRule + " rotation")
else if longTimed
    strategy.close("L", comment=activeRule + " time")
else if longInvalid
    strategy.close("L", comment=activeRule + " structure")
if shortBank
    strategy.close("S", comment=activeRule + " bank")
else if shortFlushBank
    strategy.close("S", comment=activeRule + " bank")
else if shortFlushReclaim
    strategy.close("S", comment=activeRule + " reclaim")
else if shortRotationTake
    strategy.close("S", comment=activeRule + " rotation")
else if shortRejectReclaim
    strategy.close("S", comment=activeRule + " reclaim")
else if shortTimed
    strategy.close("S", comment=activeRule + " time")
else if shortInvalid
    strategy.close("S", comment=activeRule + " structure")

if not inWindow and strategy.position_size != 0
    strategy.close_all(comment="Window end")

longExitSlip = longH21Slip
longExitRotation = not longExitSlip and longRotationTake
longExitTime = not longExitSlip and not longExitRotation and longTimed
longExitStructure = not longExitSlip and not longExitRotation and not longExitTime and longInvalid
shortExitBank = shortBank
shortExitFlushBank = not shortExitBank and shortFlushBank
shortExitReclaim = not shortExitBank and not shortExitFlushBank and shortFlushReclaim
shortExitRotation = not shortExitBank and not shortExitFlushBank and not shortExitReclaim and shortRotationTake
shortExitRejectReclaim = not shortExitBank and not shortExitFlushBank and not shortExitReclaim and not shortExitRotation and shortRejectReclaim
shortExitTime = not shortExitBank and not shortExitFlushBank and not shortExitReclaim and not shortExitRotation and not shortExitRejectReclaim and shortTimed
shortExitStructure = not shortExitBank and not shortExitFlushBank and not shortExitReclaim and not shortExitRotation and not shortExitRejectReclaim and not shortExitTime and shortInvalid

longStructureLine = strategy.position_size > 0 and activeRule != "L_WASH" and activeRule != "L_DWASH" and activeRule != "L_LOWC" and activeRule != "L_LOWX" and activeRule != "L_LOWB2" and activeRule != "L_LOWD2" and activeRule != "L_LOWM" and activeRule != "L_MBASE" and activeRule != "L_BDIP" and activeRule != "L_BSHK" and activeRule != "L_MBOD" and activeRule != "L_MNWK" and activeRule != "L_MBT" and activeRule != "L_STAIL" and activeRule != "L_SREC" and activeRule != "L_NLR" and activeRule != "L_BACX" and activeRule != "L_BDL" and activeRule != "L_BDS" and not na(holdBars) and holdBars >= 3 ? hma34 - 0.55 * atr8 : na
shortStructureLine = strategy.position_size < 0 and not na(holdBars) and holdBars >= 3 ? hma34 + 0.55 * atr8 : na
longH21SlipLine = strategy.position_size > 0 and activeRule == "L_H21R" and not na(holdBars) and holdBars >= 2 and holdBars <= 4 ? hma21 : na
longRotationLine = strategy.position_size > 0 and not na(holdBars) and holdBars >= 5 and dist8 > 1.10 ? hma5 : na
shortRotationLine = strategy.position_size < 0 and not na(holdBars) and holdBars >= 4 and dist8 < -0.95 ? hma5 : na
activeEntryLine = strategy.position_size != 0 ? strategy.position_avg_price : na

// ── Visual layer ──────────────────────────────────────────────────────
bool  showTrend   = input.bool(true, "Trend HMAs (21 / 55)",        group=G_VIEW)
bool  showLevels  = input.bool(false, "Entry price line",            group=G_VIEW)
bool  showStops  = input.bool(true, "Stop price line",            group=G_VIEW)
bool  showSignals = input.bool(true, "Entry markers",               group=G_VIEW)
bool  showStateBg = input.bool(true, "Market-state background",      group=G_VIEW)
bool  showStats   = input.bool(true, "Stats panel",                 group=G_VIEW)
color longColor   = input.color(#10b981, "Long",  group=G_VIEW, inline="palette")
color shortColor  = input.color(#f43f5e, "Short", group=G_VIEW, inline="palette")

color OPT_PROFIT  = #22c55e
color OPT_LOSS    = #ef4444
color OPT_NEUTRAL = #6b7280
color OPT_BASE    = #9aa0b5
color OPT_INK     = #0f0f12
color OPT_LINE    = #27272a
color OPT_FRAME   = #3f3f46
color OPT_DIM     = #a1a1aa

bool  isLong  = strategy.position_size > 0.0
bool  isShort = strategy.position_size < 0.0
bool  inPos   = isLong or isShort
color stateCol = macroBull ? longColor : macroBear ? shortColor : OPT_NEUTRAL

plot(showTrend ? hma21 : na, "HMA 21", color=color.new(stateCol, 20), linewidth=2)
plot(showTrend ? hma55 : na, "HMA 55", color=color.new(OPT_BASE, 55), linewidth=1)


plot(showLevels and inPos ? activeEntryLine : na, "Entry price", color=color.new(OPT_BASE, 0), linewidth=1, style=plot.style_linebr)

// Structure stop — the real invalidation level (close beyond hma34 ∓ 0.55·ATR).
// The series is na when no position holds it (and for the long rules that exit on
// time instead), so circles only print while the hma34 stop is actually live.
plot(showStops ? longStructureLine  : na, "Structure stop (long)",  color=color.new(shortColor, 0), linewidth=1, style=plot.style_circles)
plot(showStops ? shortStructureLine : na, "Structure stop (short)", color=color.new(shortColor, 0), linewidth=1, style=plot.style_circles)

// Slip stop — L_H21R early cut at hma21 (only on bars 2–4 of an L_H21R long).
plot(showStops ? longH21SlipLine : na, "Slip stop (HMA21)", color=color.new(shortColor, 0), linewidth=1, style=plot.style_circles)

// Rotation exit — overextension take at hma5 (only while rotation is armed).
plot(showStops ? longRotationLine  : na, "Rotation exit (long)",  color=color.new(shortColor, 0), linewidth=1, style=plot.style_circles)
plot(showStops ? shortRotationLine : na, "Rotation exit (short)", color=color.new(shortColor, 0), linewidth=1, style=plot.style_circles)

bgcolor(showStateBg and macroBull ? color.new(longColor, 95) : showStateBg and macroBear ? color.new(shortColor, 95) : na, title="Market state")

// Entry markers
plotshape(showSignals and sideNow == 1,  title="Long entry",  style=shape.labelup,   location=location.belowbar, color=longColor,  text="▲", textcolor=color.white, size=size.tiny)
plotshape(showSignals and sideNow == -1, title="Short entry", style=shape.labeldown, location=location.abovebar, color=shortColor, text="▼", textcolor=color.white, size=size.tiny)


var table panel = table.new(position.bottom_right, 2, 4,
     frame_width=1, frame_color=color.new(OPT_FRAME, 0),
     border_width=1, border_color=color.new(OPT_LINE, 0),
     bgcolor=color.new(OPT_INK, 0))
statRow(int r, string lbl, string val, color valCol) =>
    table.cell(panel, 0, r, " " + lbl, text_color=color.new(OPT_DIM, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, r, val + " ", text_color=valCol, text_size=size.small, text_halign=text.align_right)
if showStats
    float netPct = strategy.initial_capital > 0.0 ? strategy.netprofit / strategy.initial_capital * 100.0 : 0.0
    float winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0
    statRow(0, "Position", isLong ? "LONG" : isShort ? "SHORT" : "FLAT", isLong ? longColor : isShort ? shortColor : color.new(OPT_DIM, 0))
    statRow(1, "PnL %",    (netPct >= 0.0 ? "+" : "") + str.tostring(netPct, "0.0") + "%", netPct >= 0.0 ? OPT_PROFIT : OPT_LOSS)
    statRow(2, "Win rate", strategy.closedtrades > 0 ? str.tostring(winRate, "0") + "%" : "—", winRate >= 50.0 ? OPT_PROFIT : color.new(OPT_DIM, 0))
    statRow(3, "Trades",   str.tostring(strategy.closedtrades), color.new(OPT_DIM, 0))
