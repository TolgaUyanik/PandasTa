//@version=5

// @description Cumulative Relative Strength Index
library("CRSI")

// @function Calculates cumulative relative strength index 
// @param source
// @param window length
// @param cumulative length
// @returns crsi
export crsi(int length, int cumlength, series float source) =>	
	up = ta.rma(math.max(ta.change(source), 0), length)
	down = ta.rma(-math.min(ta.change(source), 0), length)
	rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))
	rsi := math.sum(rsi, cumlength)
	rsi
