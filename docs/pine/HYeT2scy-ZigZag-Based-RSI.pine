//@version=6
indicator('ZigZag Trend RSI', shorttitle = 'ZZ-RSI', overlay = false, max_bars_back = 500)

// Input parameters
zigzag_length = input.int(12, 'ZigZag Length', minval = 1, maxval = 100)
zigzag_dev = input.float(5.0, 'ZigZag Deviation %', minval = 0.1, maxval = 50.0)
rsi_length = input.int(14, 'RSI Length', minval = 1, maxval = 100)
ob_level = input.int(70, 'Overbought Level', minval = 50, maxval = 95)
os_level = input.int(30, 'Oversold Level', minval = 5, maxval = 50)

// Colors
bullish_color = input.color(color.green, 'Bullish Color')
bearish_color = input.color(color.red, 'Bearish Color')
neutral_color = input.color(color.gray, 'Neutral Color')
ob_color = input.color(color.red, 'Overbought Color')
os_color = input.color(color.lime, 'Oversold Color')

// ZigZag calculation
var float last_pivot_high = na
var float last_pivot_low = na
var int last_pivot_high_bar = na
var int last_pivot_low_bar = na
var int trend_direction = 0 // 1 for uptrend, -1 for downtrend, 0 for neutral

// Calculate pivots
pivot_high = ta.pivothigh(high, zigzag_length, zigzag_length)
pivot_low = ta.pivotlow(low, zigzag_length, zigzag_length)

// Track significant pivots based on deviation
if not na(pivot_high)
    if na(last_pivot_high) or pivot_high > last_pivot_high * (1 + zigzag_dev / 100)
        last_pivot_high := pivot_high
        last_pivot_high_bar := bar_index - zigzag_length
        last_pivot_high_bar

if not na(pivot_low)
    if na(last_pivot_low) or pivot_low < last_pivot_low * (1 - zigzag_dev / 100)
        last_pivot_low := pivot_low
        last_pivot_low_bar := bar_index - zigzag_length
        last_pivot_low_bar

// Determine trend direction based on zigzag pattern
if not na(last_pivot_high) and not na(last_pivot_low)
    if not na(last_pivot_high_bar) and not na(last_pivot_low_bar)
        if last_pivot_high_bar > last_pivot_low_bar
            // Last significant move was to a high - potential uptrend
            if na(trend_direction[1]) or trend_direction[1] <= 0
                trend_direction := 1
                trend_direction
        else // Last significant move was to a low - potential downtrend  
            if na(trend_direction[1]) or trend_direction[1] >= 0
                trend_direction := -1
                trend_direction
    else
        trend_direction := trend_direction[1]
        trend_direction
else
    trend_direction := trend_direction[1]
    trend_direction

// Create trend-based price series for RSI calculation
var float trend_price = close
if trend_direction == 1
    // In uptrend, use close price but emphasize upward moves
    trend_price := close + (close > close[1] ? (close - close[1]) * 0.5 : 0)
    trend_price
else if trend_direction == -1
    // In downtrend, use close price but emphasize downward moves  
    trend_price := close - (close < close[1] ? (close[1] - close) * 0.5 : 0)
    trend_price
else
    trend_price := close
    trend_price

// Calculate RSI based on trend-adjusted price
trend_rsi = ta.rsi(trend_price, rsi_length)

// Determine overbought/oversold conditions based on trend
var float dynamic_ob = ob_level
var float dynamic_os = os_level

if trend_direction == 1
    // In uptrend, be more lenient with overbought (allow higher RSI)
    dynamic_ob := ob_level + 10
    dynamic_os := os_level + 5
    dynamic_os
else if trend_direction == -1
    // In downtrend, be more lenient with oversold (allow lower RSI)
    dynamic_ob := ob_level - 5
    dynamic_os := os_level - 10
    dynamic_os
else
    dynamic_ob := ob_level
    dynamic_os := os_level
    dynamic_os

// Signal generation
is_overbought = trend_rsi >= dynamic_ob
is_oversold = trend_rsi <= dynamic_os

// Color determination
rsi_color = trend_direction == 1 ? bullish_color : trend_direction == -1 ? bearish_color : neutral_color

// Plotting
hline(50, 'Midline', color = color.gray, linestyle = hline.style_dashed)
hline(ob_level, 'Standard OB', color = color.red, linestyle = hline.style_dotted, linewidth = 1)
hline(os_level, 'Standard OS', color = color.lime, linestyle = hline.style_dotted, linewidth = 1)

plot(dynamic_ob, 'Dynamic OB', color = color.red, linewidth = 2)
plot(dynamic_os, 'Dynamic OS', color = color.lime, linewidth = 2)
plot(trend_rsi, 'Trend RSI', color = rsi_color, linewidth = 2)

// Background coloring for signals
bgcolor(is_overbought ? color.new(ob_color, 90) : is_oversold ? color.new(os_color, 90) : na)

// Signal shapes
plotshape(is_overbought and not is_overbought[1], style = shape.triangledown, location = location.top, color = ob_color, size = size.small, title = 'Overbought Signal')
plotshape(is_oversold and not is_oversold[1], style = shape.triangleup, location = location.bottom, color = os_color, size = size.small, title = 'Oversold Signal')

// Table for trend information
var table info_table = table.new(position.top_right, 2, 3, bgcolor = color.white, border_width = 1)
if barstate.islast
    table.cell(info_table, 0, 0, 'Trend', text_color = color.black, text_size = size.small)
    table.cell(info_table, 1, 0, trend_direction == 1 ? 'Bullish' : trend_direction == -1 ? 'Bearish' : 'Neutral', text_color = trend_direction == 1 ? color.green : trend_direction == -1 ? color.red : color.gray, text_size = size.small)

    table.cell(info_table, 0, 1, 'RSI', text_color = color.black, text_size = size.small)
    table.cell(info_table, 1, 1, str.tostring(trend_rsi, '#.##'), text_color = color.black, text_size = size.small)

    table.cell(info_table, 0, 2, 'Signal', text_color = color.black, text_size = size.small)
    table.cell(info_table, 1, 2, is_overbought ? 'OB' : is_oversold ? 'OS' : 'Neutral', text_color = is_overbought ? color.red : is_oversold ? color.lime : color.gray, text_size = size.small)

// Alerts
alertcondition(is_overbought and not is_overbought[1], title = 'Overbought Alert', message = 'ZigZag Trend RSI: Overbought condition detected')
alertcondition(is_oversold and not is_oversold[1], title = 'Oversold Alert', message = 'ZigZag Trend RSI: Oversold condition detected')
alertcondition(trend_direction != trend_direction[1] and trend_direction == 1, title = 'Trend Bullish', message = 'ZigZag Trend RSI: Trend turned bullish')
alertcondition(trend_direction != trend_direction[1] and trend_direction == -1, title = 'Trend Bearish', message = 'ZigZag Trend RSI: Trend turned bearish')
