//@version=6
library("Tables")

export MonthlyPnLTable(string fontSize = size.small) =>
    series bool monthChanged = month(time) != month(time[1])
    series bool yearChanged  = year(time)  != year(time[1])
    
    series float equity = strategy.equity
    
    series float pnl = (equity / equity[1]) - 1
    
    series float currentMonthPnL = 0.0
    series float currentYearPnL  = 0.0
    
    currentMonthPnL := monthChanged ? 0.0 : (1 + currentMonthPnL[1]) * (1 + pnl) - 1 
    currentYearPnL := yearChanged ? 0.0 : (1 + currentYearPnL[1]) * (1 + pnl) - 1  
    
    var monthPnL  = array.new_float(0)
    var monthTime = array.new_int(0)
    
    var yearPnL  = array.new_float(0)
    var yearTime = array.new_int(0)
    
    series bool lastComputed = false
    
    if (not na(currentMonthPnL[1]) and (monthChanged or barstate.islastconfirmedhistory))
        if (lastComputed[1])
            array.pop(monthPnL)
            array.pop(monthTime)
            
        array.push(monthPnL , currentMonthPnL[1])
        array.push(monthTime, time[1])
    
    if (not na(currentYearPnL[1]) and (yearChanged or barstate.islastconfirmedhistory))
        if (lastComputed[1])
            array.pop(yearPnL)
            array.pop(yearTime)
            
        array.push(yearPnL , currentYearPnL[1])
        array.push(yearTime, time[1])
    
    lastComputed := barstate.islastconfirmedhistory ? true : false
    
    // Monthly P&L Table    
    var monthly_table = table(na)
    
    if (barstate.islastconfirmedhistory)
        monthly_table := table.new(position.bottom_right, columns = 14, rows = array.size(yearPnL) + 1, border_width = 1)
    
        table.cell(monthly_table, 0,  0, syminfo.tickerid + ' ' + timeframe.period, bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 1,  0, "Jan",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 2,  0, "Feb",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 3,  0, "Mar",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 4,  0, "Apr",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 5,  0, "May",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 6,  0, "Jun",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 7,  0, "Jul",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 8,  0, "Aug",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 9,  0, "Sep",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 10, 0, "Oct",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 11, 0, "Nov",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 12, 0, "Dec",  bgcolor = #cccccc, text_size=fontSize)
        table.cell(monthly_table, 13, 0, "Year", bgcolor = #999999, text_size=fontSize)
    
        for yi = 0 to array.size(yearPnL) - 1
            table.cell(monthly_table, 0,  yi + 1, str.tostring(year(array.get(yearTime, yi))), bgcolor = #cccccc, text_size=fontSize)
            
            y_color = array.get(yearPnL, yi) > 0 ? color.new(color.teal, transp = 40) : color.new(color.gray, transp = 40)
            table.cell(monthly_table, 13, yi + 1, str.tostring(math.round(array.get(yearPnL, yi) * 100, 2)), bgcolor = y_color, text_color=color.new(color.white, 0),text_size=fontSize)
            
        for mi = 0 to array.size(monthTime) - 1
            m_row   = year(array.get(monthTime, mi)) - year(array.get(yearTime, 0)) + 1
            m_col   = month(array.get(monthTime, mi)) 
            m_color = array.get(monthPnL, mi) > 0 ? color.new(color.teal, transp = 40) : color.new(color.maroon, transp = 40)
            
            table.cell(monthly_table, m_col, m_row, str.tostring(math.round(array.get(monthPnL, mi) * 100, 2)), bgcolor = m_color, text_color=color.new(color.white, 0), text_size=fontSize)

