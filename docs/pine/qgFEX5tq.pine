//@version=6

// @description Display utilities for showing info on chart
library("NexusLibsDisplay", overlay=true)

// @function Creates info table with symbol and timeframe
// @param showPair Show symbol
// @param showTF Show timeframe
// @param txtColor Text color
// @param bgColor Background color
// @returns Table
export createInfoTable(bool showPair = true, bool showTF = true, color txtColor = #6a9eebff, color bgColor = #056656) =>
    var table info = table.new(position.top_center, 1, 1)
    
    string displayText = ""
    if showPair
        displayText += syminfo.ticker
    if showPair and showTF
        displayText += " | "
    if showTF
        displayText += timeframe.period
    
    table.cell(info, 0, 0, displayText, 
         text_color=txtColor,
         text_size=size.large,
         bgcolor=color.new(bgColor, 85))
    
    info

// @function Shows custom text on chart
// @param txt Text to display
// @param posX X position
// @param posY Y position
// @param txtColor Text color
// @returns Label
export showText(string txt, int posX, float posY, color txtColor = color.white) =>
    label.new(x=posX, y=posY, text=txt, style=label.style_none,
         textcolor=txtColor, size=size.normal, textalign=text.align_center)