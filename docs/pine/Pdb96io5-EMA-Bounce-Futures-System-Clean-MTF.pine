//@version=6
indicator("EMA Bounce Futures System - Clean MTF", overlay=true, max_lines_count=100, max_labels_count=100)

//====================
// Inputs
//====================
mode = input.string(
     "Auto",
     "Mode",
     options=["Auto", "Scalp", "Intraday", "Swing"])

showEMAs = input.bool(true, "Show EMAs")
showVWAP = input.bool(true, "Show VWAP")
showOnlyLatest = input.bool(true, "Show Only Latest Setup")
lineBars = input.int(35, "Line Length", minval=10)

maxEntryDistanceTicks = input.int(
     20,
     "Max Entry Distance From Bounce EMA",
     minval=1)

htf = input.timeframe(
     "15",
     "Higher Timeframe To Check")

//====================
// VWAP Approach Alerts
//====================
vwapAlertGroup = "VWAP Approach Alerts"

enableVWAPAlerts = input.bool(
     true,
     "Enable VWAP Approach Alerts",
     group=vwapAlertGroup)

vwapApproachTicks = input.int(
     20,
     "Alert Distance From VWAP (Ticks)",
     minval=1,
     group=vwapAlertGroup)

vwapAlertAtBarClose = input.bool(
     false,
     "Wait For Bar Close",
     group=vwapAlertGroup)

showVWAPApproachFlags = input.bool(
     true,
     "Show VWAP Approach Flags",
     group=vwapAlertGroup)

//====================
// Display / Flag Toggles
//====================
showEntries = input.bool(
     true,
     "Show Entry/TP Levels")

showStops = input.bool(
     true,
     "Show Stop Levels")

showSignalFlags = input.bool(
     true,
     "Show LONG/SHORT Signal Flags")

showHTFFlags = input.bool(
     true,
     "Show HTF? Flags")

showLevelLabels = input.bool(
     true,
     "Show Price Text Labels")

showInfoTable = input.bool(
     true,
     "Show Info Table")

//====================
// Colors
//====================
colema8   = color.rgb(0, 210, 0)
colEMA21  = color.rgb(255, 20, 25)
colEMA50  = color.rgb(255, 130, 20)
colEMA100 = color.rgb(20, 220, 235)
colEMA200 = color.rgb(45, 35, 255)
colVWAP   = color.rgb(220, 20, 220)

colEntry = color.white
colStop  = color.red
colTP1   = color.lime
colTP2   = color.aqua
colTP3   = color.fuchsia

//====================
// Mode Helpers
//====================
tfSec = timeframe.in_seconds(timeframe.period)

autoMode =
     tfSec <= 300  ? "Scalp" :
     tfSec <= 1800 ? "Intraday" :
     "Swing"

activeMode = mode == "Auto" ? autoMode : mode

isScalp = activeMode == "Scalp"
isIntraday = activeMode == "Intraday"
isSwing = activeMode == "Swing"

bounceLen = isScalp ? 9 : isIntraday ? 21 : 50
trendLen  = isScalp ? 50 : isIntraday ? 100 : 200
swingLen  = isScalp ? 4 : isIntraday ? 8 : 14

tp1R = isScalp ? 0.75 : isIntraday ? 1.00 : 1.50
tp2R = isScalp ? 1.25 : isIntraday ? 2.00 : 3.00
tp3R = isScalp ? 2.00 : isIntraday ? 3.00 : 5.00

//====================
// EMAs / VWAP
//====================
ema8   = ta.ema(close, 8)
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

vwapVal = ta.vwap(close)

plot(
     showEMAs ? ema8 : na,
     "EMA 9",
     color=colema8)

plot(
     showEMAs ? ema21 : na,
     "EMA 21",
     color=colEMA21)

plot(
     showEMAs ? ema50 : na,
     "EMA 50",
     color=colEMA50)

plot(
     showEMAs ? ema100 : na,
     "EMA 100",
     color=colEMA100)

plot(
     showEMAs ? ema200 : na,
     "EMA 200",
     color=colEMA200)

plot(
     showVWAP ? vwapVal : na,
     "VWAP",
     color=colVWAP,
     linewidth=2)

//====================
// VWAP Approach Detection
//====================

// Distance between the current price and VWAP,
// automatically measured using the contract's tick size.
vwapDistanceTicks =
     math.abs(close - vwapVal) /
     syminfo.mintick

// Price must have previously been outside the selected
// distance and then enter the VWAP approach zone.
enteredVWAPZone =
     not na(vwapDistanceTicks[1]) and
     vwapDistanceTicks <= vwapApproachTicks and
     vwapDistanceTicks[1] > vwapApproachTicks

// Determines which side price approached VWAP from.
approachingFromAbove =
     close[1] > vwapVal[1]

approachingFromBelow =
     close[1] < vwapVal[1]

// Optional bar-close confirmation.
vwapAlertTimingOK =
     not vwapAlertAtBarClose or
     barstate.isconfirmed

newVWAPApproach =
     enableVWAPAlerts and
     not na(vwapVal) and
     enteredVWAPZone and
     vwapAlertTimingOK

vwapApproachFromAbove =
     newVWAPApproach and
     approachingFromAbove

vwapApproachFromBelow =
     newVWAPApproach and
     approachingFromBelow

//====================
// VWAP Dynamic Alerts
//====================
if vwapApproachFromAbove
    alert(
         "VWAP APPROACH FROM ABOVE | " +
         syminfo.ticker +
         " | Price: " +
         str.tostring(close, format.mintick) +
         " | VWAP: " +
         str.tostring(vwapVal, format.mintick) +
         " | Distance: " +
         str.tostring(vwapDistanceTicks, "#.0") +
         " ticks",
         alert.freq_once_per_bar)

if vwapApproachFromBelow
    alert(
         "VWAP APPROACH FROM BELOW | " +
         syminfo.ticker +
         " | Price: " +
         str.tostring(close, format.mintick) +
         " | VWAP: " +
         str.tostring(vwapVal, format.mintick) +
         " | Distance: " +
         str.tostring(vwapDistanceTicks, "#.0") +
         " ticks",
         alert.freq_once_per_bar)

// Selectable conditions in TradingView's alert menu.
alertcondition(
     vwapApproachFromAbove,
     "VWAP Approach From Above",
     "{{ticker}} is approaching VWAP from above. Current price: {{close}}")

alertcondition(
     vwapApproachFromBelow,
     "VWAP Approach From Below",
     "{{ticker}} is approaching VWAP from below. Current price: {{close}}")

alertcondition(
     newVWAPApproach,
     "Any VWAP Approach",
     "{{ticker}} is approaching VWAP. Current price: {{close}}")

//====================
// VWAP Approach Flags
//====================
plotshape(
     showVWAPApproachFlags and vwapApproachFromAbove,
     title="VWAP Approach From Above Flag",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.new(colVWAP, 10),
     text="VWAP ↓",
     textcolor=color.white,
     size=size.tiny)

plotshape(
     showVWAPApproachFlags and vwapApproachFromBelow,
     title="VWAP Approach From Below Flag",
     style=shape.labelup,
     location=location.belowbar,
     color=color.new(colVWAP, 10),
     text="VWAP ↑",
     textcolor=color.white,
     size=size.tiny)

//====================
// Utility Functions
//====================
f_emaFromLen(_len) =>
    _len == 9 ? ema8 :
     _len == 21 ? ema21 :
     _len == 50 ? ema50 :
     _len == 100 ? ema100 :
     ema200

f_priceLabel(_prefix, _price, _entry) =>
    ticks =
         math.abs(_price - _entry) /
         syminfo.mintick

    dollars =
         ticks *
         syminfo.mintick *
         syminfo.pointvalue

    _prefix +
     " " +
     str.tostring(_price) +
     " | " +
     str.tostring(ticks, "#") +
     "t | $" +
     str.tostring(dollars, "#")

//====================
// Trend Logic
//====================
trendEMA = f_emaFromLen(trendLen)
bounceEMA = f_emaFromLen(bounceLen)

strongBull =
     close > trendEMA and
     ema8 > ema21

strongBear =
     close < trendEMA and
     ema8 < ema21

earlyBull =
     close > ema21 and
     ema8 > ema8[1]

earlyBear =
     close < ema21 and
     ema8 < ema8[1]

bullTrend = strongBull or earlyBull
bearTrend = strongBear or earlyBear

//====================
// Bounce Detection
//====================
touch9Long =
     low <= ema8 and
     close > ema8

touch21Long =
     low <= ema21 and
     close > ema21

touch50Long =
     low <= ema50 and
     close > ema50

touch100Long =
     low <= ema100 and
     close > ema100

touch9Short =
     high >= ema8 and
     close < ema8

touch21Short =
     high >= ema21 and
     close < ema21

touch50Short =
     high >= ema50 and
     close < ema50

touch100Short =
     high >= ema100 and
     close < ema100

longBounceEMA =
     isSwing ?
         touch100Long ? 100 :
         touch50Long  ? 50 :
         touch21Long  ? 21 :
         na :
     touch9Long  ? 9 :
     touch21Long ? 21 :
     touch50Long ? 50 :
     na

shortBounceEMA =
     isSwing ?
         touch100Short ? 100 :
         touch50Short  ? 50 :
         touch21Short  ? 21 :
         na :
     touch9Short  ? 9 :
     touch21Short ? 21 :
     touch50Short ? 50 :
     na

longTouch = not na(longBounceEMA)
shortTouch = not na(shortBounceEMA)

selectedLongEMA =
     f_emaFromLen(
         nz(longBounceEMA, bounceLen))

selectedShortEMA =
     f_emaFromLen(
         nz(shortBounceEMA, bounceLen))

//====================
// Entry Quality Logic
//====================
entryDistanceTicks =
     math.abs(close - bounceEMA) /
     syminfo.mintick

entryCloseEnough =
     entryDistanceTicks <=
     maxEntryDistanceTicks

bullishRejection =
     close > open and
     low <= selectedLongEMA and
     close > selectedLongEMA and
     (close - low) > (high - close)

bearishRejection =
     close < open and
     high >= selectedShortEMA and
     close < selectedShortEMA and
     (high - close) > (close - low)

longSignal =
     bullTrend and
     longTouch and
     bullishRejection and
     entryCloseEnough

shortSignal =
     bearTrend and
     shortTouch and
     bearishRejection and
     entryCloseEnough

//====================
// Trade Levels
//====================
longEntry = close
longStop = ta.lowest(low, swingLen)
longRisk = longEntry - longStop

shortEntry = close
shortStop = ta.highest(high, swingLen)
shortRisk = shortStop - shortEntry

//====================
// HTF Check
//====================
htfEMA21 =
     request.security(
         syminfo.tickerid,
         htf,
         ta.ema(close, 21))

htfEMA50 =
     request.security(
         syminfo.tickerid,
         htf,
         ta.ema(close, 50))

htfBull =
     close > htfEMA21 and
     htfEMA21 > htfEMA50

htfBear =
     close < htfEMA21 and
     htfEMA21 < htfEMA50

deepLongReject50 =
     low <= ema50 and
     close > ema50 and
     close > open and
     (close - low) > (high - close)

deepLongReject100 =
     low <= ema100 and
     close > ema100 and
     close > open and
     (close - low) > (high - close)

deepShortReject50 =
     high >= ema50 and
     close < ema50 and
     close < open and
     (high - close) > (close - low)

deepShortReject100 =
     high >= ema100 and
     close < ema100 and
     close < open and
     (high - close) > (close - low)

ltfDeepLongBounce =
     deepLongReject50 or
     deepLongReject100

ltfDeepShortBounce =
     deepShortReject50 or
     deepShortReject100

displacementUp =
     close[1] > ema50 and
     close[2] < ema50

displacementDown =
     close[1] < ema50 and
     close[2] > ema50

checkHTFLong =
     ltfDeepLongBounce and
     htfBull and
     displacementUp

checkHTFShort =
     ltfDeepShortBounce and
     htfBear and
     displacementDown

newHTFLong =
     checkHTFLong and
     not checkHTFLong[1]

newHTFShort =
     checkHTFShort and
     not checkHTFShort[1]

alertcondition(
     newHTFLong,
     "Check HTF Long Setup",
     "Possible higher-timeframe LONG bounce. Check 15m/30m/1H.")

alertcondition(
     newHTFShort,
     "Check HTF Short Setup",
     "Possible higher-timeframe SHORT bounce. Check 15m/30m/1H.")

if newHTFLong and showHTFFlags
    label.new(
         bar_index,
         low,
         "HTF?",
         style=label.style_label_up,
         color=color.blue,
         textcolor=color.white,
         size=size.small)

if newHTFShort and showHTFFlags
    label.new(
         bar_index,
         high,
         "HTF?",
         style=label.style_label_down,
         color=color.blue,
         textcolor=color.white,
         size=size.small)

//====================
// Persistent Objects
//====================
var line entryLine = na
var line stopLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na

var label entryLbl = na
var label stopLbl = na
var label tp1Lbl = na
var label tp2Lbl = na
var label tp3Lbl = na
var label signalLbl = na

var int activeDir = 0
var bool tradeActive = false
var bool stopHit = false
var float activeEntry = na
var float activeStop = na

f_clear() =>
    line.delete(entryLine)
    line.delete(stopLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)

    label.delete(entryLbl)
    label.delete(stopLbl)
    label.delete(tp1Lbl)
    label.delete(tp2Lbl)
    label.delete(tp3Lbl)
    label.delete(signalLbl)

f_level(_price, _color, _text, _entry) =>
    labelOffset =
         syminfo.mintick * 12

    labelText =
         f_priceLabel(
             _text,
             _price,
             _entry)

    isStopObject =
         _text == "STOP"

    isEntryObject =
         _text == "ENTRY" or
         _text == "TP1" or
         _text == "TP2" or
         _text == "TP3"

    drawLine =
         isStopObject ? showStops :
         isEntryObject ? showEntries :
         true

    newLine =
         drawLine ?
         line.new(
             bar_index,
             _price,
             bar_index + lineBars,
             _price,
             color=_color,
             width=2,
             style=line.style_dotted) :
         na

    newLbl =
         drawLine and showLevelLabels ?
         label.new(
             bar_index,
             _price + labelOffset,
             labelText,
             style=label.style_none,
             textcolor=_color,
             size=size.small) :
         na

    [newLine, newLbl]

f_finishStoppedTrade() =>
    if not na(stopLine)
        line.set_width(stopLine, 5)
        line.set_color(stopLine, color.red)
        line.set_x2(stopLine, bar_index)

    if not na(entryLine)
        line.set_x2(entryLine, bar_index)

    if not na(tp1Line)
        line.set_x2(tp1Line, bar_index)
        line.set_color(
             tp1Line,
             color.new(colTP1, 80))

    if not na(tp2Line)
        line.set_x2(tp2Line, bar_index)
        line.set_color(
             tp2Line,
             color.new(colTP2, 80))

    if not na(tp3Line)
        line.set_x2(tp3Line, bar_index)
        line.set_color(
             tp3Line,
             color.new(colTP3, 80))

//====================
// Long Setup
//====================
if longSignal and longRisk > 0
    if showOnlyLatest
        f_clear()

    tp1 = longEntry + longRisk * tp1R
    tp2 = longEntry + longRisk * tp2R
    tp3 = longEntry + longRisk * tp3R

    activeDir := 1
    tradeActive := true
    stopHit := false
    activeEntry := longEntry
    activeStop := longStop

    signalLbl :=
         showSignalFlags ?
         label.new(
             bar_index,
             low,
             "LONG EMA" +
             str.tostring(longBounceEMA),
             style=label.style_label_left,
             color=color.new(colTP1, 70),
             textcolor=color.white,
             size=size.normal) :
         na

    [newEntryLine, newEntryLbl] =
         f_level(
             longEntry,
             colEntry,
             "ENTRY",
             longEntry)

    [newStopLine, newStopLbl] =
         f_level(
             longStop,
             colStop,
             "STOP",
             longEntry)

    [newTP1Line, newTP1Lbl] =
         f_level(
             tp1,
             colTP1,
             "TP1",
             longEntry)

    [newTP2Line, newTP2Lbl] =
         f_level(
             tp2,
             colTP2,
             "TP2",
             longEntry)

    [newTP3Line, newTP3Lbl] =
         f_level(
             tp3,
             colTP3,
             "TP3",
             longEntry)

    entryLine := newEntryLine
    entryLbl := newEntryLbl

    stopLine := newStopLine
    stopLbl := newStopLbl

    tp1Line := newTP1Line
    tp1Lbl := newTP1Lbl

    tp2Line := newTP2Line
    tp2Lbl := newTP2Lbl

    tp3Line := newTP3Line
    tp3Lbl := newTP3Lbl

//====================
// Short Setup
//====================
if shortSignal and shortRisk > 0
    if showOnlyLatest
        f_clear()

    tp1 = shortEntry - shortRisk * tp1R
    tp2 = shortEntry - shortRisk * tp2R
    tp3 = shortEntry - shortRisk * tp3R

    activeDir := -1
    tradeActive := true
    stopHit := false
    activeEntry := shortEntry
    activeStop := shortStop

    signalLbl :=
         showSignalFlags ?
         label.new(
             bar_index,
             high,
             "SHORT EMA" +
             str.tostring(shortBounceEMA),
             style=label.style_label_left,
             color=color.new(colStop, 70),
             textcolor=color.white,
             size=size.normal) :
         na

    [newEntryLine, newEntryLbl] =
         f_level(
             shortEntry,
             colEntry,
             "ENTRY",
             shortEntry)

    [newStopLine, newStopLbl] =
         f_level(
             shortStop,
             colStop,
             "STOP",
             shortEntry)

    [newTP1Line, newTP1Lbl] =
         f_level(
             tp1,
             colTP1,
             "TP1",
             shortEntry)

    [newTP2Line, newTP2Lbl] =
         f_level(
             tp2,
             colTP2,
             "TP2",
             shortEntry)

    [newTP3Line, newTP3Lbl] =
         f_level(
             tp3,
             colTP3,
             "TP3",
             shortEntry)

    entryLine := newEntryLine
    entryLbl := newEntryLbl

    stopLine := newStopLine
    stopLbl := newStopLbl

    tp1Line := newTP1Line
    tp1Lbl := newTP1Lbl

    tp2Line := newTP2Line
    tp2Lbl := newTP2Lbl

    tp3Line := newTP3Line
    tp3Lbl := newTP3Lbl

//====================
// Stop-Hit Management
//====================
longStopHit =
     tradeActive and
     activeDir == 1 and
     not stopHit and
     low <= activeStop

shortStopHit =
     tradeActive and
     activeDir == -1 and
     not stopHit and
     high >= activeStop

newStopHit =
     longStopHit or
     shortStopHit

if newStopHit
    stopHit := true
    tradeActive := false
    f_finishStoppedTrade()

//====================
// Info Table
//====================
var table info =
     table.new(
         position.top_right,
         1,
         1)

if barstate.islast
    if showInfoTable
        table.cell(
             info,
             0,
             0,
             "EMA Bounce Mode: " +
             activeMode +
             "\nBounce: EMA " +
             str.tostring(bounceLen) +
             "\nTrend: EMA " +
             str.tostring(trendLen) +
             "\nVWAP Distance: " +
             str.tostring(vwapDistanceTicks, "#.0") +
             " ticks",
             text_color=color.white,
             bgcolor=color.new(color.black, 20))
    else
        table.cell(
             info,
             0,
             0,
             "",
             text_color=color.white,
             bgcolor=color.new(color.black, 100))