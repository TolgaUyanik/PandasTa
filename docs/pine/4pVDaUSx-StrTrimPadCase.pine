//@version=5

// @description Contains various functions for manipulation with strings:
// - padright() / padleft() - Pad a string to the right or left with a given char.
// - toUppercase() / toLowercase() - Converts all the letters in the string to uppercase / lowercase
// - nz(string) - like nz(), replaces na with a supplied string
library("StrTrimPadCase")


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          StringLib LIBRARY FUNCTIONS                         ┃ {



// ━━━━━ nz━━━━━ {
// @function Similar to nz() but for strings. However, since `string(na)` is the same as `""` 
// there is no such thing as `na` for strings. So, the function just replaces `""` with `replacement`.
// @param replacement (string) (Optional) A string returned when `s` is `""` / `na`. Default: `""`
export nz(string s, string replacement= "") => na(s) ? replacement : s // is the same as s == "" ? ...
// END OF nz() }

// ━━━━━ toUppercase() / toLowercase() ━━━━━ {
const string sUppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
const string sLowercase = "abcdefghijklmnopqrstuvwxyz"

_toUc(string char) =>
	n = str.pos(sLowercase, char)
	na(n) ? char : str.substring(sUppercase, n, n+1)

_toLc(string char) =>
	n = str.pos(sUppercase, char)
	na(n) ? char : str.substring(sLowercase, n, n+1)



// @function Converts a string to uppercase 
export method toUppercase(string s) =>
	_l = str.length(s) 
	if _l > 0 
		s1 = ""
		for i = 0 to _l-1
			_c = str.substring(s, i, i+1)
			s1+=_toUc(_c)

// @function Converts a string to uppercase 
export method toLowercase(string s) =>
	_l = str.length(s) 
	if _l > 0 
		s1 = ""
		for i = 0 to _l-1
			_c = str.substring(s, i, i+1)
			s1+=_toLc(_c)
// END OF toUppercase() / toLowercase() }

// ━━━━━ trim2() ━━━━━ {
// @function Like str.trim() but also trims line breaks ("\n")
export method trim2(string s) =>
    s1 = str.trim(str.match(s,"\\S(.|\\s)*"))
    while str.length(s1) > 0 
        i = str.length(s1) - 1
        lastChar = str.substring(s1, i)
        if lastChar == "\n" // or lastChar == "\r"  \r has no special meaning in pine
            s1 := str.trim(str.substring(s1, 0, i))
        else
            break
    s1
// END OF trim2 }

// _̿_̿_̿_̿_̿_̿_̿  padright() / padleft() _̿_̿_̿_̿_̿_̿_̿ {
// pad string left or right by repeating a char  

// ━━━━━ method padright() ━━━━━ {
// @function pads a string up to `length` by adding `char`'s (spaces by default) to the end. (the first char of  `char`
// string is used). Respects max string length of 4096. 
// @param char (string) A char to pad with. (if string longer than one char is supplied uses the first char)
export method padright(string this, int length, simple string char = " ") =>
	_length = math.min(length, 4096)
	_char = char == "" ? " " : str.substring(char, 0, 1)
	__s = this
	if str.length(this) < _length
		for i = 0 to _length - str.length(this) -1 
			__s :=  __s + _char
	__s

// END OF padright }

// ━━━━━ method padleft() ━━━━━━━━━━------ {
// @function pads a string up to `length` by adding `char`'s (spaces by default) to the beginning(the first char of  
// `char` string is used). Respects max string length of 4096.  
// @param char (string) A char to pad with. (if string longer than one char is supplied uses the first char)
export method padleft(string this, int length, simple string char = " ") =>
	_length = math.min(length, 4096)
	_char = char == "" ? " " : str.substring(char, 0, 1)
	__s = this
	if str.length(this) < _length
		for i = 0 to _length - str.length(this) -1 
			__s :=  _char + __s
	__s

// END OF padleft }

// Δ̲Δ̲Δ̲ END OF padright() / padleft()  Δ̲Δ̲Δ̲ }


// ┃ ^^^ END OF StringLib LIBRARY FUNCTIONS                                       ┃}
