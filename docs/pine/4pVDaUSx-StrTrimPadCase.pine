	table.cell(t,0,2, text_halign = text.align_left, text_valign = text.align_top, width = iCell0Wsmaller, 	height = iRow2H, text_font_family = font.family_monospace)
	table.cell(t,1,2, text_halign = text.align_left, text_valign = text.align_top, width = iCell0Wsmaller, 	height = iRow2H, text_font_family = font.family_monospace)
	table.cell(t,2,2, text_halign = text.align_left, text_valign = text.align_top, width = iCell0Wsmaller, 	height = iRow2H, text_font_family = font.family_monospace)
	table.cell(t,3,2, text_halign = text.align_left, text_valign = text.align_top, width = iCol1W		 , 	height = iRow2H, text_font_family = font.family_monospace)
	table.cell(t,0,3, text_halign = text.align_left, text_valign = text.align_top, width = iCell0Wsmaller, 	height = iRow3H, text_font_family = font.family_monospace)
	table.cell(t,1,3, text_halign = text.align_left, text_valign = text.align_top, width = iCell0Wsmaller, 	height = iRow3H, text_font_family = font.family_monospace)
	table.cell(t,2,3, text_halign = text.align_left, text_valign = text.align_top, width = iCell0Wsmaller, 	height = iRow3H, text_font_family = font.family_monospace)
	table.cell(t,3,3, text_halign = text.align_left, text_valign = text.align_top, width = iCol1W		 , 	height = iRow3H, text_font_family = font.family_monospace)
	table.cell(t,0,4, text_halign = text.align_left, text_valign = text.align_top, width = iCell0Wsmaller, 	height = iRow4H, text_font_family = font.family_monospace)
	table.cell(t,1,4, text_halign = text.align_left, text_valign = text.align_top, width = iCell0Wsmaller, 	height = iRow4H, text_font_family = font.family_monospace)
	table.cell(t,2,4, text_halign = text.align_left, text_valign = text.align_top, width = iCell0Wsmaller, 	height = iRow4H, text_font_family = font.family_monospace)
	table.cell(t,3,4, text_halign = text.align_left, text_valign = text.align_top, width = iCol1W		 , 	height = iRow4H, text_font_family = font.family_monospace)

	// merge first 3 cells in header rows
