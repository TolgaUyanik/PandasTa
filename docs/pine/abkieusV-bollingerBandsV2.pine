//@version=6

// @description Bollinger bands related functions
library('bollingerBandsV2', true)
import AlgoTrader_Pro/formattingUtilities/12 as fu
import AlgoTrader_Pro/dataTableUtilities/13 as du
import AlgoTrader_Pro/movingAveragesUtilities/3 as mu

// CONSTANTS
//--------------

int LINE_TRANSPARENCY = 40
int BB_LINEWIDTH = 1
int BB_B_LINEWIDTH = 3
float VOLATILITY_COLOR_LIMIT = 0.04
int BBVOL_LOOKBACK = 7
int BBVOL_MA_LENGTH = 28

// Moving averages
float mas_source = close
int ma_slow_length = 200
int ma_med_length = 100
int ma_fast_length = 50

dataTable_map = map.new<string, string>()

var GROUP_VOLATILITY = 'VOLATILITY ================================'
var GROUP_DATATABLE = 'DATA TABLE ================================'
var DATATABLE_TITLE = 'VOLATILITY'

BB_LINE_STYLE = plot.style_line

// INPUTS
//-----------
float source_input = input.source(close, 'Source', group = GROUP_VOLATILITY)
int length_input = input.int(200, 'Length', group = GROUP_VOLATILITY)
float stdv1_input = input.float(1, 'Std Devs for Band 1', minval = 1, group = GROUP_VOLATILITY)
float stdv2_input = input.float(2, 'Std Devs for Band 2', minval = 1, group = GROUP_VOLATILITY)
float stdv3_input = input.float(3, 'Std Devs for Band 3', minval = 1, group = GROUP_VOLATILITY)
float stdv4_input = input.float(4, 'Std Devs for Band 4', minval = 1, group = GROUP_VOLATILITY)
float stdv5_input = input.float(5, 'Std Devs for Band 5', minval = 1, group = GROUP_VOLATILITY)
float stdv6_input = input.float(6, 'Std Devs for Band 6', minval = 1, group = GROUP_VOLATILITY)
float stdv7_input = input.float(7, 'Std Devs for Band 7', minval = 1, group = GROUP_VOLATILITY)
bool show_bbVol_shading_input = input.bool(true, 'Show Volatility Shading', inline = 'shading', group = GROUP_VOLATILITY)
int shading_transparency_input = input.int(90, '| Transp', inline = 'shading', group = GROUP_VOLATILITY)
bool show_bb_input = input.bool(true, 'Show BB Bands', inline = 'lines', group = GROUP_VOLATILITY)
int bb_transparency_input = input.int(50, '| Transp', inline = 'lines', group = GROUP_VOLATILITY)
string trend_direction_input = input.string('Long', 'Trend Direction', options = ['Long', 'Short', 'Neutral'], group = GROUP_VOLATILITY)
bool show_data_table_input = input.bool(true, 'Show Data Table', group = GROUP_DATATABLE)
string tableYpos_input = input.string('Middle', 'Position', inline = 'p', options = ['Top', 'Middle', 'Bottom'], group = GROUP_DATATABLE)
string tableXpos_input = input.string('Left', '', inline = 'p', options = ['Left', 'Center', 'Right'], group = GROUP_DATATABLE)
string table_textSize_input = input.string('Small', 'Text Size', options = ['Auto', 'Tiny', 'Small', 'Normal'], group = GROUP_DATATABLE)

// Colors
color UPPER_BB_COLOR = color.new(color.red, bb_transparency_input)
color BASIS_COLOR = color.new(color.gray, bb_transparency_input)
color LOWER_BB_COLOR = color.new(color.green, bb_transparency_input)
color VOL_GOINGUP_COLOR = color.new(color.green, shading_transparency_input)
color VOL_GOINGDOWN_COLOR = color.new(color.red, shading_transparency_input)
color COLOR_TRANSP = color.new(color.gray, 100)


// FUNCTIONS
//---------------
get_bollinger_bands(src, length, m1, m2, m3, m4, m5, m6, m7) =>

    var bbLevelsMap = map.new<string, float>()

    // Create basis
    float basis = ta.ema(src, length)

    // Create bands
    float dev1 = m1 * ta.stdev(src, length)
    float dev2 = m2 * ta.stdev(src, length)
    float dev3 = m3 * ta.stdev(src, length)
    float dev4 = m4 * ta.stdev(src, length)
    float dev5 = m5 * ta.stdev(src, length)
    float dev6 = m6 * ta.stdev(src, length)
    float dev7 = m7 * ta.stdev(src, length)

    // Put values in map
    bbLevelsMap.put('u7', basis + dev7)
    bbLevelsMap.put('u6', basis + dev6)
    bbLevelsMap.put('u5', basis + dev5)
    bbLevelsMap.put('u4', basis + dev4)
    bbLevelsMap.put('u3', basis + dev3)
    bbLevelsMap.put('u2', basis + dev2)
    bbLevelsMap.put('u1', basis + dev1)
    bbLevelsMap.put('b', basis)
    bbLevelsMap.put('l1', basis - dev1)
    bbLevelsMap.put('l2', basis - dev2)
    bbLevelsMap.put('l3', basis - dev3)
    bbLevelsMap.put('l4', basis - dev4)
    bbLevelsMap.put('l5', basis - dev5)
    bbLevelsMap.put('l6', basis - dev6)
    bbLevelsMap.put('l7', basis - dev7)

    // Calculate ranges and add to the map
    bb_sd_range = bbLevelsMap.get('u1')  - bbLevelsMap.get('l1')
    bb_half_sd_range = bb_sd_range / 2
    bbLevelsMap.put('bb_sd_range', bb_sd_range)
    bbLevelsMap.put('bb_half_sd_range', bb_half_sd_range)

    // Return map
    bbLevelsMap


get_volatility(bb_highest, bb_lowest, ma_length, lookback) =>

    // Get bb range 
    bb_range = bb_highest - bb_lowest

    // Get the change in the range 
    bb_range_prev = bb_range[lookback]
    bb_range_change = (bb_range - bb_range_prev) / bb_range_prev

    // Make the vaolatility indicator be the sma of the range change
    volatility = ta.ema(bb_range_change, ma_length)
    //volatility = bb_range_change

    // Generate the up and down volatility indicators
    volatility_goingUp = volatility > volatility[lookback]
    volatility_goingDown = volatility < volatility[lookback]

    [volatility, volatility_goingUp, volatility_goingDown]

get_mas_dataTable(dataTable_map, direction_flag, comment_txt, bbVol) =>

    // Define the color for the direction 
    color_1_txt = bbVol > 0 ? 'green' : bbVol < 0 ? 'red' : 'white'

    color_2_txt__0 = str.lower(direction_flag)
    color_2_txt = switch color_2_txt__0
        'long' => 'green'
        'short' => 'red'
        'neutral' => 'yellow'

    dataTable_map.put('sub_title', '')

    dataTable_map.put('item_1', 'Volatilty Change')
    dataTable_map.put('data_1', fu.toPercentageString(bbVol, 1))
    dataTable_map.put('color_1', color_1_txt)
    dataTable_map.put('comment_1', '')

    dataTable_map.put('item_2', 'Direction')
    dataTable_map.put('data_2', direction_flag)
    dataTable_map.put('color_2', color_2_txt)
    dataTable_map.put('comment_2', comment_txt)




    dataTable_map

get_direction_flag(bbVol, bbVol_goingUp, bbVol_goingDown, trend_direction, ma_reference) =>

    // Definitions
    bool longTrend = trend_direction == 'Long'
    bool shortTrend = trend_direction == 'Short'
    bool neutralTrend = trend_direction == 'Neutral'

    bool ma_upTrend = close > ma_reference
    bool ma_dnTrend = close < ma_reference


// Directions
// long =
// 	 longTrend and bbVol_goingUp or 
// 	 (neutralTrend and bbVol_goingUp)

// short = 
// 	 (neutralTrend and bbVol_goingDown) or 
// 	 (shortTrend and bbVol_goingUp) or 
// 	 (shortTrend and bbVol_goingDown)

    long = ma_upTrend and bbVol > 0
    short = ma_dnTrend and bbVol > 0
    neutral = bbVol < 0

    direction_flag = long ? 'Long' : short ? 'Short' : 'Neutral'

    comment_txt = long ? 'Above MA with increasing Vol and ' + trend_direction + ' Trend' : short ? 'Below MA with increasing Vol and ' + trend_direction + ' Trend' : neutral ? 'Consolidating, decreasing Vol with ' + trend_direction + ' Trend' : ''

    [direction_flag, comment_txt]


//-----------------------------------------------------------------------------
// EXPORTS
//-----------------------------------------------------------------------------
// @function: 						Calculates 7 sets of bollinger bands, with 7 different standard deviations
// @param stdv1 (simple int): 		standard deviation 1
// @param stdv2 (simple int): 		standard deviation 2
// @param stdv3 (simple int): 		standard deviation 3
// @param stdv4 (simple int): 		standard deviation 4
// @param stdv5 (simple int): 		standard deviation 5
// @param stdv6 (simple int): 		standard deviation 6
// @param stdv7 (simple int): 		standard deviation 7
// @param length (simple int): 		Length for the bands
// @param source (simple float): 	source for the calculation
// @returns: 						Returns 8 levels plus the range of all the levels.
export get_multiple_bollinger_bands(float stdv1, float stdv2, float stdv3, float stdv4, float stdv5, float stdv6, float stdv7, simple int length, float source) =>
    get_bollinger_bands(source, length, stdv1, stdv2, stdv3, stdv4, stdv5, stdv6, stdv7)


// @function: 							Provides a volatility indicator based on Bollinger Bands, and indicates wheather the volatility is increasing or decreasing.
// @param bb_highest (simple float):	Top Bollinger Band on which to calculate the range.
// @param bb_lowest (simple float): 	Bottom Bollinger Band on which to calculate the range.
// @param ma_length (simple int): 		Length to use in the smoothing of Bollinger Bands range.
// @param lookback (simple int): 		Lookback period to identify a change in the Bollinger Bands range.
// @returns: 						Returns 8 levels plus the range of all the levels.
export get_bb_volatility(float bb_highest, float bb_lowest, simple int ma_length, int lookback) =>
    [bbVol, bbVol_goingUp, bbVol_goingDown] = get_volatility(bb_highest, bb_lowest, ma_length, lookback)
    [bbVol, bbVol_goingUp, bbVol_goingDown]

// @function: 						Generates Bollinger Bands Volatility 
// @param source (float): 			Source for Bollinger Bands
// @param length (int): 			Length for Bollinger Bands
// @param stdv1 (int): 				Standard Deviation 1
// @param stdv2 (int): 				Standard Deviation 2
// @param stdv3 (int): 				Standard Deviation 3
// @param stdv4 (int): 				Standard Deviation 4
// @param stdv5 (int): 				Standard Deviation 5
// @param stdv6 (int): 				Standard Deviation 6
// @param stdv7 (int): 				Standard Deviation 7
// @param bbVol_ma_length (int): 	Length for the movinga average of the bb volatility
// @param bbVol_lookback (int): 	Lookback period for the bb volatility
// @param plot_labels (bool): 		Plot labels
// @param bars_to_right (int): 		Bars to the right for the labels
// @param include_levels (bool): 	Flag to include levels in the labels
// @param trend_direction (string): Current direction of the trend
// @returns: 						Returns a map with the levels, plus direction flag and the data table 
export get_bbVolatility_data(float source, simple int length, int stdv1, int stdv2, int stdv3, int stdv4, int stdv5, int stdv6, int stdv7, string trend_direction) =>

    // Get bollinger bands
    bb_map = get_bollinger_bands(source, length, stdv1, stdv2, stdv3, stdv4, stdv5, stdv6, stdv7)

    // Get Volatility
    [bbVol, bbVol_goingUp, bbVol_goingDown] = get_bb_volatility(bb_map.get('u7'), bb_map.get('l7'), BBVOL_MA_LENGTH, BBVOL_LOOKBACK)

    // Get moving averages
    [mas_levelsMap, mas_direction, mas_dataTableMap] = mu.get_movingAverages_data(mas_source, ma_slow_length, ma_med_length, ma_fast_length)
    ma_slow = mas_levelsMap.get('ma_slow')

    // Get Direction Flag 
    [direction_flag, comment_txt] = get_direction_flag(bbVol, bbVol_goingUp, bbVol_goingDown, trend_direction, ma_slow)

    // Get Data Table Map
    data_table_map = map.new<string, string>()
    data_table_map := get_mas_dataTable(data_table_map, direction_flag, comment_txt, bbVol)

    [bb_map, direction_flag, data_table_map, bbVol, bbVol_goingUp, bbVol_goingDown]



// CALCULATIONS
//---------------
bb_map = get_bollinger_bands(source_input, length_input, stdv1_input, stdv2_input, stdv3_input, stdv4_input, stdv5_input, stdv6_input, stdv7_input)

[bbVol, bbVol_goingUp, bbVol_goingDown] = get_bb_volatility(bb_map.get('u7'), bb_map.get('l7'), BBVOL_MA_LENGTH, BBVOL_LOOKBACK)


// Get Moving averages
[mas_levelsMap, mas_direction, mas_dataTableMap] = mu.get_movingAverages_data(mas_source, ma_slow_length, ma_med_length, ma_fast_length)
ma_slow = mas_levelsMap.get('ma_slow')


[direction_flag, comment_txt] = get_direction_flag(bbVol, bbVol_goingUp, bbVol_goingDown, trend_direction_input, ma_slow)



// Create and show the data table
if show_data_table_input
    dataTable_map := get_mas_dataTable(dataTable_map, direction_flag, comment_txt, bbVol)
    du.generate_dataTable(dataTable_map, DATATABLE_TITLE, tableYpos_input, tableXpos_input, table_textSize_input)

// PLOTS 
//---------------

// BB Bands 
ln_u7 = plot(bb_map.get('u7'), 'u7', UPPER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('u6'), 'u6', UPPER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('u5'), 'u5', UPPER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('u4'), 'u4', UPPER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('u3'), 'u3', UPPER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('u2'), 'u2', UPPER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('u1'), 'u1', UPPER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('b'), 'b', BASIS_COLOR, math.max(1, BB_B_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('l1'), 'l1', LOWER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('l2'), 'l2', LOWER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('l3'), 'l3', LOWER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('l4'), 'l4', LOWER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('l5'), 'l5', LOWER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
plot(bb_map.get('l6'), 'l6', LOWER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)
ln_l7 = plot(bb_map.get('l7'), 'l7', LOWER_BB_COLOR, math.max(1, BB_LINEWIDTH), BB_LINE_STYLE)

// Volatility 
volatility_color = color.from_gradient(bbVol, -VOLATILITY_COLOR_LIMIT, VOLATILITY_COLOR_LIMIT, VOL_GOINGDOWN_COLOR, VOL_GOINGUP_COLOR)
fill(ln_u7, ln_l7, volatility_color, 'volatility', display = show_bbVol_shading_input ? display.all : display.none)
