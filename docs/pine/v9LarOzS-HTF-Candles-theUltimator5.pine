//@version=6
indicator("HTF Candles [theUltimator5]", overlay=true, max_boxes_count = 250, max_lines_count = 500, max_labels_count = 250)

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════
// 📊 HIGHER TIMEFRAME CANDLE OVERLAY INDICATOR WITH PATTERN DETECTION
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════
//
// This indicator displays higher timeframe candles overlaid on your current chart.
// For example: View 1-hour candles while on a 1-minute chart
//
// Features:
// • Candle bodies show open-to-close range with customizable colors
// • Wicks extend to show the true high and low of each HTF period
// • Real-time updates as the current HTF candle develops
// • Fully customizable colors, transparency, and line thickness
// • Separate fill and border colors for maximum customization
// • Candle pattern detection on HTF candles
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════


// USER SETTINGS


// Choose the higher timeframe to display (must be higher than your current chart timeframe)
higher_timeframe = input.timeframe("D", title="Higher Timeframe", 
                                  tooltip="Select timeframe to overlay (e.g., '60' for 1-hour, '240' for 4-hour, '1D' for daily)")

// Bullish candle fill color
bullish_fill_color = input.color(color.lime, title="Bullish Fill Color", 
                                 tooltip="Fill color for bullish candle bodies (close > open)")

// Bullish candle border/line color
bullish_line_color = input.color(color.lime, title="Bullish Line Color",
                                 tooltip="Border and wick color for bullish candles")

// Bearish candle fill color
bearish_fill_color = input.color(color.red, title="Bearish Fill Color",
                                 tooltip="Fill color for bearish candle bodies (close < open)")

// Bearish candle border/line color
bearish_line_color = input.color(color.rgb(255,120,120), title="Bearish Line Color",
                                 tooltip="Border and wick color for bearish candles")

// Transparency control for candle body fill
candle_body_transparency = input.int(95, title="Candle Body Transparency", minval=0, maxval=100, 
                                  tooltip="0 = Solid fill, 100 = Completely transparent (outline only)")

// Line thickness control
line_thickness = input.int(2, title="Line Thickness", minval=1, maxval=10,
                          tooltip="Thickness of candle borders and wicks (1-10)")

// PATTERN VISIBILITY INPUTS

show_patterns = input.bool(true, title="Show Candle Patterns", tooltip="Enable/disable candle pattern detection on HTF candles")

// Individual pattern toggles
show_doji = input.bool(false, title="Doji", group="Pattern Selection")
show_evening_star = input.bool(false, title="Evening Star", group="Pattern Selection")
show_morning_star = input.bool(false, title="Morning Star", group="Pattern Selection")
show_shooting_star = input.bool(false, title="Shooting Star", group="Pattern Selection")
show_hammer = input.bool(false, title="Hammer", group="Pattern Selection")
show_inverted_hammer = input.bool(false, title="Inverted Hammer", group="Pattern Selection")
show_bearish_harami = input.bool(false, title="Bearish Harami", group="Pattern Selection")
show_bullish_harami = input.bool(false, title="Bullish Harami", group="Pattern Selection")
show_bearish_engulfing = input.bool(false, title="Bearish Engulfing", group="Pattern Selection")
show_bullish_engulfing = input.bool(false, title="Bullish Engulfing", group="Pattern Selection")
show_piercing_line = input.bool(false, title="Piercing Line", group="Pattern Selection")
show_bullish_belt = input.bool(false, title="Bullish Belt", group="Pattern Selection")
show_bullish_kicker = input.bool(false, title="Bullish Kicker", group="Pattern Selection")
show_bearish_kicker = input.bool(false, title="Bearish Kicker", group="Pattern Selection")
show_hanging_man = input.bool(false, title="Hanging Man", group="Pattern Selection")
show_dark_cloud_cover = input.bool(false, title="Dark Cloud Cover", group="Pattern Selection")
show_bull_sweeps = input.bool(false, title="Bull Sweeps", group="Pattern Selection")
show_bear_sweeps = input.bool(false, title="Bear Sweeps", group="Pattern Selection")

// Pattern display options
pattern_text_size = input.string("small", title="Pattern Text Size", options=["tiny", "small", "normal", "large"])

// Sweep display options
label_color_bullish = input.color(color.lime, title="Bullish Sweep Label Color")
label_color_bearish = input.color(color.red, title="Bearish Sweep Label Color")

// Doji-specific settings
doji_sensitivity = input.float(0.05, title="Doji Sensitivity", minval=0.01, maxval=0.5, step=0.01, 
                              tooltip="Lower values = more sensitive doji detection. 0.1 = body is 10% or less of total range")


// DETECTION & VARIABLES

// Detect when a new higher timeframe candle begins
new_htf_candle_started = timeframe.change(higher_timeframe)

// Get actual HTF values for positioning labels (independent of plotted candles)
htf_high_actual = request.security(syminfo.tickerid, higher_timeframe, high, lookahead=barmerge.lookahead_off)
htf_low_actual = request.security(syminfo.tickerid, higher_timeframe, low, lookahead=barmerge.lookahead_off)

// Variables to store the current HTF candle's OHLC data
var float current_htf_open_price = na    // Opening price of current HTF candle
var float current_htf_high_price = na    // Highest price reached in current HTF candle
var float current_htf_low_price = na     // Lowest price reached in current HTF candle  
var float current_htf_close_price = na   // Current closing price of HTF candle
var int htf_candle_start_bar = na        // Bar index where current HTF candle started

// Arrays to store HTF OHLC history for pattern detection
var array<float> htf_open = array.new<float>()
var array<float> htf_high = array.new<float>()
var array<float> htf_low = array.new<float>()
var array<float> htf_close = array.new<float>()
var array<int> htf_bar_index = array.new<int>()

// Drawing objects for the current HTF candle
var box hidden_boundary_box = na         // Hidden box (used for structure, not visible)
var box visible_candle_body = na         // Visible candle body (open to close)
var line upper_shadow_line = na          // Upper wick (body top to high)
var line lower_shadow_line = na          // Lower wick (body bottom to low)

// Color variables for current candle
var color current_fill_color = na
var color current_line_color = na


// Function to get HTF OHLC values with specified index offset
get_htf_open(index) => array.size(htf_open) > index ? array.get(htf_open, array.size(htf_open) - 1 - index) : na
get_htf_high(index) => array.size(htf_high) > index ? array.get(htf_high, array.size(htf_high) - 1 - index) : na
get_htf_low(index) => array.size(htf_low) > index ? array.get(htf_low, array.size(htf_low) - 1 - index) : na
get_htf_close(index) => array.size(htf_close) > index ? array.get(htf_close, array.size(htf_close) - 1 - index) : na
get_htf_bar_index(index) => array.size(htf_bar_index) > index ? array.get(htf_bar_index, array.size(htf_bar_index) - 1 - index) : na


// Function to detect liquidity sweeps using HTF data
detect_sweeps() =>
    var bool bullishLiquiditySweep = false
    var bool bearishLiquiditySweep = false
    var string sweep_text = ""
    
    // Updated condition: Check both show_patterns AND individual sweep toggles
    if show_patterns and (show_bull_sweeps or show_bear_sweeps) and array.size(htf_close) >= 2
        // Get current and previous HTF values
        htf_o = get_htf_open(0)
        htf_h = get_htf_high(0)
        htf_l = get_htf_low(0)
        htf_c = get_htf_close(0)
        
        htf_o1 = get_htf_open(1)
        htf_h1 = get_htf_high(1)
        htf_l1 = get_htf_low(1)
        htf_c1 = get_htf_close(1)
        
        // Define Strict Liquidity Sweep Conditions Only
        bullishLiquiditySweep := show_bull_sweeps and htf_l < htf_l1 and htf_c > htf_h1  // Sweep low then close above previous high
        bearishLiquiditySweep := show_bear_sweeps and htf_h > htf_h1 and htf_c < htf_l1  // Sweep high then close below previous low
        
        // Determine sweep text (always use full length)
        if bullishLiquiditySweep
            sweep_text := "Bull Sweep"
        else if bearishLiquiditySweep
            sweep_text := "Bear Sweep"
    
    [bullishLiquiditySweep, bearishLiquiditySweep, sweep_text]


// Function to detect patterns using HTF data
detect_patterns() =>
    var bool doji = false
    var bool evening_star = false
    var bool morning_star = false
    var bool shooting_star = false
    var bool hammer = false
    var bool inverted_hammer = false
    var bool bearish_harami = false
    var bool bullish_harami = false
    var bool bearish_engulfing = false
    var bool bullish_engulfing = false
    var bool piercing_line = false
    var bool bullish_belt = false
    var bool bullish_kicker = false
    var bool bearish_kicker = false
    var bool hanging_man = false
    var bool dark_cloud_cover = false
    var string pattern_text = ""
    
    if show_patterns and array.size(htf_close) >= 3
        // Get current and previous HTF values
        htf_o = get_htf_open(0)
        htf_h = get_htf_high(0)
        htf_l = get_htf_low(0)
        htf_c = get_htf_close(0)
        
        htf_o1 = get_htf_open(1)
        htf_h1 = get_htf_high(1)
        htf_l1 = get_htf_low(1)
        htf_c1 = get_htf_close(1)
        
        htf_o2 = get_htf_open(2)
        htf_h2 = get_htf_high(2)
        htf_l2 = get_htf_low(2)
        htf_c2 = get_htf_close(2)
        
        // Calculate highest/lowest for some patterns
        htf_upper = na(htf_h1) ? htf_h : math.max(htf_h, htf_h1)
        htf_lower = na(htf_l1) ? htf_l : math.min(htf_l, htf_l1)
        
        // Pattern detection logic (with individual toggles)
        candle_range = htf_h - htf_l
        body_size = math.abs(htf_o - htf_c)
        doji := show_doji and candle_range > 0 and body_size <= (candle_range * doji_sensitivity)
        
        evening_star := show_evening_star and not na(htf_c2) and htf_c2 > htf_o2 and math.min(htf_o1, htf_c1) > htf_c2 and htf_o < math.min(htf_o1, htf_c1) and htf_c < htf_o
        
        morning_star := show_morning_star and not na(htf_c2) and htf_c2 < htf_o2 and math.max(htf_o1, htf_c1) < htf_c2 and htf_o > math.max(htf_o1, htf_c1) and htf_c > htf_o
        
        shooting_star := show_shooting_star and not na(htf_o1) and htf_o1 < htf_c1 and htf_o > htf_c1 and htf_h - math.max(htf_o, htf_c) >= math.abs(htf_o - htf_c) * 3 and math.min(htf_c, htf_o) - htf_l <= math.abs(htf_o - htf_c)
        
        hammer := show_hammer and ((htf_h - htf_l) > 3 * (htf_o - htf_c)) and ((htf_c - htf_l) / (.001 + htf_h - htf_l) > 0.6) and ((htf_o - htf_l) / (.001 + htf_h - htf_l) > 0.6)
        
        inverted_hammer := show_inverted_hammer and ((htf_h - htf_l) > 3 * (htf_o - htf_c)) and ((htf_h - htf_c) / (.001 + htf_h - htf_l) > 0.6) and ((htf_h - htf_o) / (.001 + htf_h - htf_l) > 0.6)
        
        bearish_harami := show_bearish_harami and not na(htf_c1) and htf_c1 > htf_o1 and htf_o > htf_c and htf_o <= htf_c1 and htf_o1 <= htf_c and htf_o - htf_c < htf_c1 - htf_o1
        
        bullish_harami := show_bullish_harami and not na(htf_o1) and htf_o1 > htf_c1 and htf_c > htf_o and htf_c <= htf_o1 and htf_c1 <= htf_o and htf_c - htf_o < htf_o1 - htf_c1
        
        bearish_engulfing := show_bearish_engulfing and not na(htf_c1) and htf_c1 > htf_o1 and htf_o > htf_c and htf_o >= htf_c1 and htf_o1 >= htf_c and htf_o - htf_c > htf_c1 - htf_o1
        
        bullish_engulfing := show_bullish_engulfing and not na(htf_o1) and htf_o1 > htf_c1 and htf_c > htf_o and htf_c >= htf_o1 and htf_c1 >= htf_o and htf_c - htf_o > htf_o1 - htf_c1
        
        piercing_line := show_piercing_line and not na(htf_c1) and htf_c1 < htf_o1 and htf_o < htf_l1 and htf_c > htf_c1 + ((htf_o1 - htf_c1) / 2) and htf_c < htf_o1
        
        bullish_belt := show_bullish_belt and htf_l == htf_o and htf_o < htf_lower and htf_o < htf_c and htf_c > ((htf_h1 - htf_l1) / 2) + htf_l1
        
        bullish_kicker := show_bullish_kicker and not na(htf_o1) and htf_o1 > htf_c1 and htf_o >= htf_o1 and htf_c > htf_o
        
        bearish_kicker := show_bearish_kicker and not na(htf_o1) and htf_o1 < htf_c1 and htf_o <= htf_o1 and htf_c <= htf_o
        
        hanging_man := show_hanging_man and ((htf_h - htf_l > 4 * (htf_o - htf_c)) and ((htf_c - htf_l) / (.001 + htf_h - htf_l) >= 0.75) and ((htf_o - htf_l) / (.001 + htf_h - htf_l) >= 0.75)) and not na(htf_h1) and not na(htf_h2) and htf_h1 < htf_o and htf_h2 < htf_o
        
        dark_cloud_cover := show_dark_cloud_cover and not na(htf_c1) and htf_c1 > htf_o1 and ((htf_c1 + htf_o1) / 2) > htf_c and htf_o > htf_c and htf_o > htf_c1 and htf_c > htf_o1 and ((htf_o - htf_c) / (.001 + (htf_h - htf_l)) > 0.6)
        
        // Determine which pattern to display
        pattern_text := ""
        if doji
            pattern_text := "Doji"
        else if evening_star
            pattern_text := "Evening\nStar"
        else if morning_star
            pattern_text := "Morning\nStar"
        else if shooting_star
            pattern_text := "Shooting\nStar"
        else if hammer
            pattern_text := "Hammer"
        else if inverted_hammer
            pattern_text := "Inverted\nHammer"
        else if bearish_harami
            pattern_text := "Bearish\nHarami"
        else if bullish_harami
            pattern_text := "Bullish\nHarami"
        else if bearish_engulfing
            pattern_text := "Bearish\nEngulfing"
        else if bullish_engulfing
            pattern_text := "Bullish\nEngulfing"
        else if piercing_line
            pattern_text := "Piercing\nLine"
        else if bullish_belt
            pattern_text := "Bullish\nBelt"
        else if bullish_kicker
            pattern_text := "Bullish\nKicker"
        else if bearish_kicker
            pattern_text := "Bearish\nKicker"
        else if hanging_man
            pattern_text := "Hanging\nMan"
        else if dark_cloud_cover
            pattern_text := "Dark\nCloudCover"
    
    [doji, evening_star, morning_star, shooting_star, hammer, inverted_hammer, bearish_harami, bullish_harami, bearish_engulfing, bullish_engulfing, piercing_line, bullish_belt, bullish_kicker, bearish_kicker, hanging_man, dark_cloud_cover, pattern_text]


if new_htf_candle_started
    // Store completed HTF candle data in arrays (if not first candle)
    if not na(current_htf_open_price)
        // Add to arrays and maintain size limit
        array.push(htf_open, current_htf_open_price)
        array.push(htf_high, current_htf_high_price)
        array.push(htf_low, current_htf_low_price)
        array.push(htf_close, current_htf_close_price)
        array.push(htf_bar_index, htf_candle_start_bar)
        
        // Limit array size to last 50 candles for performance
        if array.size(htf_open) > 50
            array.shift(htf_open)
            array.shift(htf_high)
            array.shift(htf_low)
            array.shift(htf_close)
            array.shift(htf_bar_index)
        
        // Detect patterns on the completed candle
        [doji, evening_star, morning_star, shooting_star, hammer, inverted_hammer, bearish_harami, bullish_harami, bearish_engulfing, bullish_engulfing, piercing_line, bullish_belt, bullish_kicker, bearish_kicker, hanging_man, dark_cloud_cover, pattern_text] = detect_patterns()
        
        // Detect sweeps on the completed candle
        [bullishSweep, bearishSweep, sweep_text] = detect_sweeps()
           
        // Display pattern if detected
        if show_patterns and pattern_text != ""
            pattern_color = color.white
            label_style = label.style_label_up
            
            // Position labels directly at candle extremes (offset = 0)
            y_position = htf_low_actual
            
            // Determine color and position based on pattern type
            if evening_star or shooting_star or bearish_harami or bearish_engulfing or bearish_kicker or hanging_man or dark_cloud_cover
                pattern_color := color.red
                label_style := label.style_label_down
                y_position := htf_high_actual
            else if morning_star or hammer or inverted_hammer or bullish_harami or bullish_engulfing or piercing_line or bullish_belt or bullish_kicker
                pattern_color := color.lime
                label_style := label.style_label_up
                y_position := htf_low_actual
            else if doji
                // Doji uses same positioning as other patterns (default to low)
                pattern_color := color.white
                label_style := label.style_label_up
                y_position := htf_low_actual
            
            // Create pattern label with specific handling for doji
            if doji
                // Special white label with black text for doji patterns
                label.new(
                     x=math.round((htf_candle_start_bar + bar_index) / 2),
                     y=y_position,
                     text=pattern_text,
                     color=color.white,
                     textcolor=color.black,
                     style=label_style,
                     size=pattern_text_size == "tiny" ? size.tiny : pattern_text_size == "small" ? size.small : pattern_text_size == "normal" ? size.normal : size.large
                 )
            else
                // All other patterns use white text
                label.new(
                     x=math.round((htf_candle_start_bar + bar_index) / 2),
                     y=y_position,
                     text=pattern_text,
                     color=pattern_color,
                     textcolor=color.white,
                     style=label_style,
                     size=pattern_text_size == "tiny" ? size.tiny : pattern_text_size == "small" ? size.small : pattern_text_size == "normal" ? size.normal : size.large
                 )
        
        // Display sweep labels if detected (with positioning to avoid pattern overlap)
        // Updated condition: Check both show_patterns AND individual sweep toggles
        if show_patterns and (show_bull_sweeps or show_bear_sweeps) and sweep_text != ""
            sweep_x_position = math.round((htf_candle_start_bar + bar_index) / 2)
            
            // Determine if we have a pattern that would conflict with sweep positioning
            has_bullish_pattern = morning_star or hammer or inverted_hammer or bullish_harami or bullish_engulfing or piercing_line or bullish_belt or bullish_kicker
            has_bearish_pattern = evening_star or shooting_star or bearish_harami or bearish_engulfing or bearish_kicker or hanging_man or dark_cloud_cover
            has_neutral_pattern = doji
            
            // Use small fixed offset only when patterns would overlap
            small_offset = ta.atr(20) * 1
            
            if bullishSweep
                // For bullish sweeps, check if there's a conflicting pattern below
                sweep_y_offset = has_bullish_pattern or has_neutral_pattern ? small_offset : 0
                label.new(
                     x=sweep_x_position,
                     y=htf_low_actual - sweep_y_offset,
                     text=sweep_text,
                     style=label.style_label_up,
                     color=label_color_bullish,
                     textcolor=color.white,
                     size=size.small
                 )
            else if bearishSweep
                // For bearish sweeps, check if there's a conflicting pattern above
                sweep_y_offset = has_bearish_pattern or has_neutral_pattern ? small_offset : 0
                label.new(
                     x=sweep_x_position,
                     y=htf_high_actual + sweep_y_offset,
                     text=sweep_text,
                     style=label.style_label_down,
                     color=label_color_bearish,
                     textcolor=color.white,
                     size=size.small
                 )
    
    // Store the initial OHLC values for the new HTF candle
    current_htf_open_price := open
    current_htf_high_price := high
    current_htf_low_price := low
    current_htf_close_price := close
    htf_candle_start_bar := bar_index
    
    // Determine candle colors based on whether it's bullish or bearish
    is_bullish = current_htf_close_price >= current_htf_open_price
    current_fill_color := is_bullish ? bullish_fill_color : bearish_fill_color
    current_line_color := is_bullish ? bullish_line_color : bearish_line_color

    // Create the main candle body box (from open to close price)
    visible_candle_body := box.new(
         left=bar_index, 
         right=bar_index + 1,
         top=math.max(current_htf_open_price, current_htf_close_price), 
         bottom=math.min(current_htf_open_price, current_htf_close_price),
         bgcolor=color.new(current_fill_color, candle_body_transparency),
         border_color=current_line_color, 
         border_width=line_thickness
     )

    // Create upper wick (from candle body top to high price) - always create regardless of length
    wick_center_position = bar_index
    
    upper_shadow_line := line.new(
         x1=wick_center_position, 
         y1=math.max(current_htf_open_price, current_htf_close_price),
         x2=wick_center_position, 
         y2=current_htf_high_price,
         color=current_line_color, 
         width=line_thickness
     )
    
    // Create lower wick (from candle body bottom to low price) - always create regardless of length
    lower_shadow_line := line.new(
         x1=wick_center_position, 
         y1=math.min(current_htf_open_price, current_htf_close_price),
         x2=wick_center_position, 
         y2=current_htf_low_price,
         color=current_line_color, 
         width=line_thickness
     )

else
    // Update the OHLC values as new bars come in within the same HTF period
    current_htf_high_price := math.max(current_htf_high_price, high)  // Track highest price
    current_htf_low_price := math.min(current_htf_low_price, low)     // Track lowest price
    current_htf_close_price := close                                   // Update closing price
    
    // Update candle colors based on current open vs close relationship
    is_bullish = current_htf_close_price >= current_htf_open_price
    current_fill_color := is_bullish ? bullish_fill_color : bearish_fill_color
    current_line_color := is_bullish ? bullish_line_color : bearish_line_color

    // Update the hidden boundary box (not visible but maintains structure)
    if not na(hidden_boundary_box)
        box.set_right(hidden_boundary_box, bar_index + 1)
        box.set_top(hidden_boundary_box, current_htf_high_price)
        box.set_bottom(hidden_boundary_box, current_htf_low_price)
        box.set_bgcolor(hidden_boundary_box, color.new(current_fill_color, 100))  // 100% transparent
        box.set_border_color(hidden_boundary_box, color.new(current_line_color, 100))

    // Update the visible candle body with current open/close prices
    if not na(visible_candle_body)
        box.set_right(visible_candle_body, bar_index + 1)
        box.set_top(visible_candle_body, math.max(current_htf_open_price, current_htf_close_price))
        box.set_bottom(visible_candle_body, math.min(current_htf_open_price, current_htf_close_price))
        box.set_bgcolor(visible_candle_body, color.new(current_fill_color, candle_body_transparency))
        box.set_border_color(visible_candle_body, current_line_color)
    
    // Calculate center position for wicks (middle of the HTF candle period)
    wick_center_position = math.round((htf_candle_start_bar + bar_index) / 2)
    
    // Remove old wick lines before creating new ones
    if not na(upper_shadow_line)
        line.delete(upper_shadow_line)
    if not na(lower_shadow_line)
        line.delete(lower_shadow_line)
    
    // Use tolerance for floating-point comparisons (especially important for doji candles)
    tolerance = syminfo.mintick * 0.1
    
    // Upper wick needed if high is significantly above both open and close
    upper_wick_needed = (current_htf_high_price > current_htf_open_price + tolerance) and 
                       (current_htf_high_price > current_htf_close_price + tolerance)
    
    // Lower wick needed if low is significantly below both open and close  
    lower_wick_needed = (current_htf_low_price < current_htf_open_price - tolerance) and 
                       (current_htf_low_price < current_htf_close_price - tolerance)
    
    if upper_wick_needed
        upper_shadow_line := line.new(
             x1=wick_center_position, 
             y1=math.max(current_htf_open_price, current_htf_close_price),
             x2=wick_center_position, 
             y2=current_htf_high_price,
             color=current_line_color, 
             width=line_thickness
         )
    
    if lower_wick_needed
        lower_shadow_line := line.new(
             x1=wick_center_position, 
             y1=math.min(current_htf_open_price, current_htf_close_price),
             x2=wick_center_position, 
             y2=current_htf_low_price,
             color=current_line_color, 
             width=line_thickness
         )