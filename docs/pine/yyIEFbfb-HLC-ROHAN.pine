//@version=6
indicator("HLC ROHAN", overlay=true, precision=2, max_labels_count=500)

//==============================================================================
// INPUTS
//==============================================================================
// System Settings
atrPeriod   = input.int(10, "ATR Length", minval=1, group="Supertrend Settings")
factor      = input.float(3.0, "Factor", minval=0.01, step=0.01, group="Supertrend Settings")
ema_01_len  = input.int(7, "Fast EMA", minval=1, maxval=500, group="EMA Settings")
ema_02_len  = input.int(21, "Slow EMA", minval=1, maxval=500, group="EMA Settings")
ema_03_len  = input.int(50, "EMA 50", minval=1, maxval=500, group="EMA Settings")
ema_04_len  = input.int(200, "EMA 200", minval=1, maxval=500, group="EMA Settings")
ema_src     = input.source(close, "Source", group="EMA Settings")

// Lalu Bhai Settings
rsi_len     = input.int(15, "RSI Length (Kailash)", group="Lalu Bhai Settings")
stoch_k_len = input.int(14, "Stoch %K Length (SHIV)", group="Lalu Bhai Settings")
stoch_d_len = input.int(3, "Stoch %D Smooth (PARVATI)", group="Lalu Bhai Settings")
ema_lalu_len= input.int(10, "EMA Length (DRV)", group="Lalu Bhai Settings")

//==============================================================================
// CALCULATIONS
//==============================================================================
// Core Indicators
[supertrend, direction] = ta.supertrend(factor, atrPeriod)

ema_01 = ta.ema(ema_src, ema_01_len)
ema_02 = ta.ema(ema_src, ema_02_len)
ema_03 = ta.ema(ema_src, ema_03_len)
ema_04 = ta.ema(ema_src, ema_04_len)

// Lalu Bhai Core
rsi15    = ta.rsi(close, rsi_len)
ema10    = ta.ema(close, ema_lalu_len)
k        = ta.stoch(close, high, low, stoch_k_len)
d        = ta.sma(k, stoch_d_len)
close1   = close[1]
close2   = close[2]

currentAvg     = (high + low + close) / 3.0
prevAvg        = (high[1] + low[1] + close[1]) / 3.0
yesterdayRange = high[1] - low[1]
fib382_level   = (38.2 * yesterdayRange) / 100.0 + close[1]
openAboveFib382 = open > fib382_level

// HLC Logic
hlcHigher = high > high[1] and low > low[1] and close > close[1] and close > high[1] and currentAvg > prevAvg and close > prevAvg
hlcLower  = high < high[1] and low < low[1] and close < close[1] and close < low[1] and currentAvg < prevAvg and close < prevAvg

var int lastPatternState = 0  // 0 = None, 1 = Bullish, -1 = Bearish
canShowHigher = hlcHigher and lastPatternState != 1
canShowLower  = hlcLower  and lastPatternState != -1

if canShowHigher
    lastPatternState := 1
else if canShowLower
    lastPatternState := -1

CRH = close > high[1] and currentAvg > high[1]
CRL = close < low[1] and currentAvg < low[1]
Hgp = low > prevAvg
Lgp = high < prevAvg
GZ  = close > low[1] and close > close[1] and close > prevAvg
RZ  = close < low[1] and close < close[1] and close < prevAvg

BS_Day1 = close > currentAvg and close > high[1] and close > prevAvg
SS_Day1 = close < currentAvg and close < low[1] and close < prevAvg
BS_Day2 = open > close[1] and close > high[1]
SS_Day2 = open < close[1] and close < low[1]

var float floorValue = na
var float ceilingValue = na
bool confirmedBS = false
bool confirmedSS = false

bool potentialBS = BS_Day1
bool potentialSS = SS_Day1

if potentialBS[1] and BS_Day2
    floorValue := low[1]
    confirmedBS := true
else if potentialSS[1] and SS_Day2
    ceilingValue := high[1]
    confirmedSS := true

cross_fast_up   = ta.crossover(ema_01, ema_02)
cross_fast_down = ta.crossunder(ema_01, ema_02)
cross_slow_up   = ta.crossover(ema_03, ema_04)
cross_slow_down = ta.crossunder(ema_03, ema_04)

bullish_confirmation = direction < 0 and ema_01 > ema_02 and canShowHigher
bearish_confirmation = direction >= 0 and ema_01 < ema_02 and canShowLower
priceNearFib382      = math.abs(close - fib382_level) / close <= 0.005

//==============================================================================
// PLOTS & VISUALS
//==============================================================================
upTrend    = plot(direction < 0 ? supertrend : na, "Up Trend", color=#00FF00, style=plot.style_linebr, linewidth=2)
downTrend  = plot(direction < 0 ? na : supertrend, "Down Trend", color=#FF0000, style=plot.style_linebr, linewidth=2)
bodyMiddle = plot((open + close) / 2.0, "Body Middle", display=display.none)

fill(upTrend, bodyMiddle, color.new(color.green, 90), "Uptrend Background")
fill(downTrend, bodyMiddle, color.new(color.red, 90), "Downtrend Background")

plot(ema_01, "Fast EMA", #00FF00, 2)
plot(ema_02, "Slow EMA", #FF0000, 2)
plot(ema_03, "EMA 50", #0000FF, 2)
plot(ema_04, "EMA 200", #FF00FF, 3)

bgcolor(ema_01 > ema_02 and ema_03 > ema_04 ? color.new(color.green, 95) : ema_01 < ema_02 and ema_03 < ema_04 ? color.new(color.red, 95) : color.new(color.gray, 95))

plotshape(cross_fast_up, "Fast Bullish Cross", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(cross_fast_down, "Fast Bearish Cross", shape.triangledown, location.abovebar, color.red, size=size.normal)
plotshape(cross_slow_up, "Slow Bullish Cross", shape.triangleup, location.belowbar, color.blue, size=size.normal)
plotshape(cross_slow_down, "Slow Bearish Cross", shape.triangledown, location.abovebar, color.purple, size=size.normal)

plotshape(canShowHigher, "HLC Higher", shape.labelup, location.belowbar, color.new(#4CAF50, 85), text="HLC↑", textcolor=color.white)
plotshape(canShowLower, "HLC Lower", shape.labeldown, location.abovebar, color.new(#F44336, 85), text="HLC↓", textcolor=color.white)
plotshape(CRH, "CRH", shape.flag, location.belowbar, color.new(#2196F3, 85), text="CRH", textcolor=color.white)
plotshape(CRL, "CRL", shape.flag, location.abovebar, color.new(#FF9800, 85), text="CRL", textcolor=color.white)
plotshape(Hgp, "Hgp", shape.triangleup, location.belowbar, color.new(#9C27B0, 85), text="Hgp", textcolor=color.white, size=size.small)
plotshape(Lgp, "Lgp", shape.triangledown, location.abovebar, color.new(#607D8B, 85), text="Lgp", textcolor=color.white, size=size.small)
plotshape(GZ, "GZ", shape.triangleup, location.belowbar, color.new(#9C27B0, 85), text="GZ", textcolor=color.white, size=size.small)
plotshape(RZ, "RZ", shape.triangledown, location.abovebar, color.new(#607D8B, 85), text="RZ", textcolor=color.white, size=size.small)
plotshape(BS_Day1, "BS Setup", shape.triangleup, location.belowbar, color.new(#dad1e9, 0), text="BS", textcolor=color.white, size=size.small)
plotshape(SS_Day1, "SS Setup", shape.triangledown, location.abovebar, color.new(#f43b02, 0), text="SS", textcolor=color.white, size=size.small)
plotshape(openAboveFib382, "Open Above Fib 38.2%", shape.circle, location.belowbar, color.green, text="O>A\n38.2%", textcolor=color.white, size=size.large)
plotshape(bullish_confirmation, "Strong Bullish Confirmation", shape.labelup, location.belowbar, color.green, text="STRONG\nBULL", textcolor=color.white)
plotshape(bearish_confirmation, "Strong Bearish Confirmation", shape.labeldown, location.abovebar, color.red, text="STRONG\nBEAR", textcolor=color.white)
plotshape(priceNearFib382, "Near Fib 38.2%", shape.diamond, location.abovebar, color.new(#FF6B6B, 0), text="38.2%", textcolor=color.white, size=size.small)

//==============================================================================
// DRAWING OBJECTS
//==============================================================================
var line openToFibLine = na
if openAboveFib382
    line.delete(openToFibLine)
    openToFibLine := line.new(bar_index, open, bar_index, fib382_level, color=color.green, width=2, style=line.style_dashed)

var line floorLine = na
if confirmedBS
    line.delete(floorLine)
    floorLine := line.new(bar_index-1, floorValue, bar_index, floorValue, color=color.new(#dad1e9, 0), width=2, style=line.style_dashed, extend=extend.right)
    label.new(bar_index, low, "Floor: " + str.tostring(floorValue, format.mintick), color=color.new(#dad1e9, 0), textcolor=color.white, style=label.style_label_up)
else if not na(floorLine)
    line.set_x2(floorLine, bar_index)

var line ceilingLine = na
if confirmedSS
    line.delete(ceilingLine)
    ceilingLine := line.new(bar_index-1, ceilingValue, bar_index, ceilingValue, color=color.new(#f43b02, 0), width=2, style=line.style_dashed, extend=extend.right)
    label.new(bar_index, high, "Ceiling: " + str.tostring(ceilingValue, format.mintick), color=color.new(#f43b02, 0), textcolor=color.white, style=label.style_label_down)
else if not na(ceilingLine)
    line.set_x2(ceilingLine, bar_index)

var line fib382Line = line.new(bar_index-1, fib382_level, bar_index, fib382_level, color=color.new(#FF6B6B, 0), width=2, style=line.style_dashed, extend=extend.right)
line.set_x2(fib382Line, bar_index)
line.set_y1(fib382Line, fib382_level)
line.set_y2(fib382Line, fib382_level)

//==============================================================================
// COMBINED DASHBOARD
//==============================================================================
var label fibLabel = na
var label rangeLabel = na
var table infoTable = table.new(position.top_right, 2, 13, bgcolor=color.new(#1e222d, 10), border_width=1, border_color=color.gray)

if barstate.islast
    label.delete(fibLabel)
    label.delete(rangeLabel)
    
    fibLabel := label.new(bar_index, fib382_level, "38.2%: " + str.tostring(fib382_level, format.mintick), color=color.new(#FF6B6B, 0), textcolor=color.white, style=label.style_label_left, size=size.small)
    rangeLabel := label.new(bar_index, high, "Yesterday's Range: " + str.tostring(yesterdayRange, format.mintick) + "\n(" + str.tostring(yesterdayRange/close*100, "%.2f") + "%)\nFib 38.2%: " + str.tostring(fib382_level, format.mintick) + "\nOpen " + (openAboveFib382 ? ">" : "≤") + " Fib: " + str.tostring(open, format.mintick), color=color.new(#FFD700, 0), textcolor=color.white, style=label.style_label_down)

    // Header: Lalu Bhai Section
    table.cell(infoTable, 0, 0, "LALUBHAI", bgcolor=color.blue, text_color=color.white)
    table.cell(infoTable, 1, 0, "Value", bgcolor=color.blue, text_color=color.white)
    
    // Lalu Bhai Dashboard Cells
    table.cell(infoTable, 0, 1, "Kailash (RSI)", text_color=color.white)
    table.cell(infoTable, 1, 1, str.tostring(rsi15, "#.##"), bgcolor=rsi15 >= 50 ? color.green : color.red, text_color=color.white)
    
    table.cell(infoTable, 0, 2, "Current Close", text_color=color.white)
    table.cell(infoTable, 1, 2, str.tostring(close, "#.##"), bgcolor=color.blue, text_color=color.white)
    
    table.cell(infoTable, 0, 3, "1 Day Ago Close", text_color=color.white)
    table.cell(infoTable, 1, 3, str.tostring(close1, "#.##"), bgcolor=close > close1 ? color.green : color.red, text_color=color.white)
    
    table.cell(infoTable, 0, 4, "2 Days Ago Close", text_color=color.white)
    table.cell(infoTable, 1, 4, str.tostring(close2, "#.##"), bgcolor=close > close2 ? color.green : color.red, text_color=color.white)
    
    table.cell(infoTable, 0, 5, "SHIV (Stoch K)", text_color=color.white)
    table.cell(infoTable, 1, 5, str.tostring(k, "#.##"), bgcolor=k >= d ? color.green : color.red, text_color=color.white)
    
    table.cell(infoTable, 0, 6, "PARVATI (Stoch D)", text_color=color.white)
    table.cell(infoTable, 1, 6, str.tostring(d, "#.##"), bgcolor=d >= 50 ? color.green : color.red, text_color=color.white)
    
    table.cell(infoTable, 0, 7, "DRV (EMA 10)", text_color=color.white)
    table.cell(infoTable, 1, 7, str.tostring(ema10, "#.##"), bgcolor=close > ema10 ? color.green : color.red, text_color=color.white)

    // Header: System Analytics Section
    table.cell(infoTable, 0, 8, "FLOOR / CEILING", bgcolor=color.purple, text_color=color.white)
    table.cell(infoTable, 1, 8, "LEVELS", bgcolor=color.purple, text_color=color.white)
    
    table.cell(infoTable, 0, 9, "Floor / Ceiling:", text_color=color.white)
    table.cell(infoTable, 1, 9, "F: " + str.tostring(floorValue, format.mintick) + " | C: " + str.tostring(ceilingValue, format.mintick), text_color=color.yellow)
    
    table.cell(infoTable, 0, 10, "EMAs Trend:", text_color=color.white)
    table.cell(infoTable, 1, 10, (ema_01 > ema_02 ? "Fast: Bull" : "Fast: Bear") + " | " + (ema_03 > ema_04 ? "Slow: Bull" : "Slow: Bear"), text_color=ema_01 > ema_02 ? color.green : color.red)
    
    table.cell(infoTable, 0, 11, "Supertrend:", text_color=color.white)
    table.cell(infoTable, 1, 11, (direction < 0 ? "Bullish" : "Bearish") + " (" + str.tostring(supertrend, format.mintick) + ")", text_color=direction < 0 ? color.green : color.red)
    
    table.cell(infoTable, 0, 12, "Fib 38.2% Status:", text_color=color.white)
    table.cell(infoTable, 1, 12, openAboveFib382 ? "OPEN > FIB" : "OPEN ≤ FIB", text_color=openAboveFib382 ? color.green : color.red)

//==============================================================================
// ALERTS
//==============================================================================
alertcondition(canShowHigher, "HLC Higher Alert", "HLC Higher pattern detected")
alertcondition(canShowLower, "HLC Lower Alert", "HLC Lower pattern detected")
alertcondition(CRH, "CRH Alert", "CRH breakout detected")
alertcondition(CRL, "CRL Alert", "CRL breakout detected")
alertcondition(Hgp, "Hgp Alert", "Low above previous average")
alertcondition(Lgp, "Lgp Alert", "High below previous average")
alertcondition(BS_Day1, "BS Setup Alert", "Buy Setup detected")
alertcondition(SS_Day1, "SS Setup Alert", "Sell Setup detected")
alertcondition(confirmedBS, "Floor Alert", "Floor level confirmed")
alertcondition(confirmedSS, "Ceiling Alert", "Ceiling level confirmed")
alertcondition(cross_fast_up, "Fast EMA Bullish Cross", "Fast EMA bullish crossover")
alertcondition(cross_fast_down, "Fast EMA Bearish Cross", "Fast EMA bearish crossunder")
alertcondition(cross_slow_up, "Slow EMA Bullish Cross", "Slow EMA bullish crossover")
alertcondition(cross_slow_down, "Slow EMA Bearish Cross", "Slow EMA bearish crossunder")
alertcondition(openAboveFib382, "Open Above Fib 38.2%", "Today's open above Fibonacci 38.2% level")
alertcondition(direction[1] != direction, "Supertrend Trend Change", "Supertrend changed direction")
alertcondition(bullish_confirmation, "Strong Bullish Confirmation", "Strong bullish confirmation")
alertcondition(bearish_confirmation, "Strong Bearish Confirmation", "Strong bearish confirmation")
alertcondition(priceNearFib382, "Price Near Fib 38.2%", "Price near Fibonacci 38.2% level")

if confirmedBS and not confirmedBS[1]
    alert("New floor level at: " + str.tostring(floorValue, format.mintick), alert.freq_once_per_bar_close)
if confirmedSS and not confirmedSS[1]
    alert("New ceiling level at: " + str.tostring(ceilingValue, format.mintick), alert.freq_once_per_bar_close)
if openAboveFib382 and not openAboveFib382[1]
    alert("Today's open above Fib 38.2% level! Open: " + str.tostring(open, format.mintick) + " > Fib: " + str.tostring(fib382_level, format.mintick), alert.freq_once_per_bar_close)