//@version=5
// v1.1.2 (2026-05-28): library title renamed AFZT_Settings_public → AFZT_Settings_Lib →
// "ZT_Settings_Lib" — TV content-fingerprints any republish under the banned AFZT_
// namespace. Dropping the AFZT_ prefix to "ZT_" mirrors KLP's net-new naming. No
// functional change; getInstrumentSettings() signature unchanged.
library("ZT_Settings_Lib", overlay=false)

// Profiles (must match Core)
PROFILE_ES = 0
PROFILE_NQ = 1
PROFILE_RTY = 2
PROFILE_YM = 3
PROFILE_CL = 4
PROFILE_NG = 5
PROFILE_GC = 6
PROFILE_SIL = 7
PROFILE_BTC = 8
PROFILE_6E = 9
PROFILE_CUSTOM = 10

// Tuning (must match Core)
TUNING_LOOSE = 0
TUNING_DEFAULT = 1
TUNING_STRICT = 2

// Returns array<float>(12)
// idx 0..11 meanings unchanged from Core.
export getInstrumentSettings(int profileCode, int tuningCode) =>
    float[] settings = array.new_float(12, 0.0)

    if profileCode == PROFILE_ES or profileCode == PROFILE_YM or profileCode == PROFILE_RTY
        array.set(settings, 0, 1.20)
        array.set(settings, 1, 0.20)
        array.set(settings, 2, 1.20)
        array.set(settings, 3, 80.0)
        array.set(settings, 4, 10.0)
        array.set(settings, 5, 20.0)
        array.set(settings, 6, 2.0)
        array.set(settings, 7, 25.0)
        array.set(settings, 8, 2.0)
        array.set(settings, 9, 0.55)
        if profileCode == PROFILE_ES
            array.set(settings, 10, 8.0)
        else if profileCode == PROFILE_YM
            array.set(settings, 10, 10.0)
        else if profileCode == PROFILE_RTY
            array.set(settings, 10, 10.0)

        if profileCode == PROFILE_ES
            array.set(settings, 11, 100.0)
        else if profileCode == PROFILE_YM
            array.set(settings, 11, 300.0)
        else if profileCode == PROFILE_RTY
            array.set(settings, 11, 200.0)

    else if profileCode == PROFILE_NQ
        array.set(settings, 0, 1.25)
        array.set(settings, 1, 0.20)
        array.set(settings, 2, 1.20)
        array.set(settings, 3, 80.0)
        array.set(settings, 4, 10.0)
        array.set(settings, 5, 20.0)
        array.set(settings, 6, 2.0)
        array.set(settings, 7, 25.0)
        array.set(settings, 8, 2.0)
        array.set(settings, 9, 0.55)
        array.set(settings, 10, 35.0)
        array.set(settings, 11, 600.0)

    else if profileCode == PROFILE_CL
        array.set(settings, 0, 1.25)
        array.set(settings, 1, 0.22)
        array.set(settings, 2, 1.25)
        array.set(settings, 3, 100.0)
        array.set(settings, 4, 10.0)
        array.set(settings, 5, 25.0)
        array.set(settings, 6, 3.0)
        array.set(settings, 7, 30.0)
        array.set(settings, 8, 4.0)
        array.set(settings, 9, 0.60)
        array.set(settings, 10, 10.0)
        array.set(settings, 11, 40.0)

    else if profileCode == PROFILE_NG
        array.set(settings, 0, 1.35)
        array.set(settings, 1, 0.25)
        array.set(settings, 2, 1.30)
        array.set(settings, 3, 120.0)
        array.set(settings, 4, 8.0)
        array.set(settings, 5, 12.0)
        array.set(settings, 6, 5.0)
        array.set(settings, 7, 12.0)
        array.set(settings, 8, 10.0)
        array.set(settings, 9, 0.65)
        array.set(settings, 10, 10.0)
        array.set(settings, 11, 100.0)

    else if profileCode == PROFILE_GC
        array.set(settings, 0, 1.20)
        array.set(settings, 1, 0.20)
        array.set(settings, 2, 1.20)
        array.set(settings, 3, 80.0)
        array.set(settings, 4, 10.0)
        array.set(settings, 5, 20.0)
        array.set(settings, 6, 2.0)
        array.set(settings, 7, 30.0)
        array.set(settings, 8, 2.0)
        array.set(settings, 9, 0.55)
        array.set(settings, 10, 20.0)
        array.set(settings, 11, 400.0)

    else if profileCode == PROFILE_SIL
        array.set(settings, 0, 1.25)
        array.set(settings, 1, 0.22)
        array.set(settings, 2, 1.25)
        array.set(settings, 3, 100.0)
        array.set(settings, 4, 10.0)
        array.set(settings, 5, 20.0)
        array.set(settings, 6, 2.0)
        array.set(settings, 7, 30.0)
        array.set(settings, 8, 2.0)
        array.set(settings, 9, 0.55)
        array.set(settings, 10, 10.0)
        array.set(settings, 11, 400.0)

    else if profileCode == PROFILE_BTC
        array.set(settings, 0, 1.35)
        array.set(settings, 1, 0.25)
        array.set(settings, 2, 1.30)
        array.set(settings, 3, 120.0)
        array.set(settings, 4, 8.0)
        array.set(settings, 5, 12.0)
        array.set(settings, 6, 5.0)
        array.set(settings, 7, 12.0)
        array.set(settings, 8, 10.0)
        array.set(settings, 9, 0.65)
        array.set(settings, 10, 30.0)
        array.set(settings, 11, 250.0)

    else if profileCode == PROFILE_6E
        array.set(settings, 0, 1.15)
        array.set(settings, 1, 0.18)
        array.set(settings, 2, 1.15)
        array.set(settings, 3, 80.0)
        array.set(settings, 4, 12.0)
        array.set(settings, 5, 20.0)
        array.set(settings, 6, 1.0)
        array.set(settings, 7, 30.0)
        array.set(settings, 8, 2.0)
        array.set(settings, 9, 0.55)
        array.set(settings, 10, 5.0)
        array.set(settings, 11, 50.0)

    else
        array.set(settings, 0, 1.20)
        array.set(settings, 1, 0.20)
        array.set(settings, 2, 1.20)
        array.set(settings, 3, 80.0)
        array.set(settings, 4, 10.0)
        array.set(settings, 5, 20.0)
        array.set(settings, 6, 2.0)
        array.set(settings, 7, 25.0)
        array.set(settings, 8, 2.0)
        array.set(settings, 9, 0.55)
        array.set(settings, 10, 10.0)
        array.set(settings, 11, 100.0)
    if tuningCode == TUNING_LOOSE
        array.set(settings, 0, array.get(settings, 0) * 0.92)
        array.set(settings, 1, array.get(settings, 1) * 1.25)
        array.set(settings, 9, array.get(settings, 9) * 0.82)
    else if tuningCode == TUNING_STRICT
        array.set(settings, 0, array.get(settings, 0) * 1.13)
        array.set(settings, 1, array.get(settings, 1) * 0.75)
        array.set(settings, 9, array.get(settings, 9) * 1.18)

    settings
