//@version=5

// @description Provide Take profit and Stop loss values depending on source.
library("AdaptivePNL", overlay = true)

//
// Price source helpers
//

const string NONE_PRICE = "none"
const string LOW_HIGH_PRICE = "low/high"
const string HIGH_LOW_PRICE = "high/low"
const string CLOSE_PRICE = "close"
const string HL2_PRICE = "hl2"
const string HLC3_PRICE = "hlc3"
const string OHLC4_PRICE = "ohlc4"
const string HLCC4_PRICE = "hlcc4"
const string SL_ATR_PRICE = "SL:ATR(n)"
const string TP_ATR_PRICE = "TP:ATR(n)"

// @function Get price value by selected price type
// @param type price type from @TakeProfitPriceTypes() or @StopLossPriceTypes()
// @param relativePrice price to which is added/substracted ATR value
// @param atrLen ATR length
// @returns Requested price value
export Price(string type, series float relativePrice = close, int atrLen = 14) =>
    atr = ta.atr(atrLen)
    switch type
        HIGH_LOW_PRICE => strategy.position_size > 0 ? high : low
        LOW_HIGH_PRICE => strategy.position_size > 0 ? low : high
        CLOSE_PRICE => close
        HL2_PRICE => hl2
        HLC3_PRICE => hlc3
        OHLC4_PRICE => ohlc4
        HLCC4_PRICE => hlcc4
        SL_ATR_PRICE => strategy.position_size == 0 ? na : (strategy.position_size > 0 ? relativePrice + atr : relativePrice - atr)
        TP_ATR_PRICE => strategy.position_size == 0 ? na : (strategy.position_size > 0 ? relativePrice - atr : relativePrice + atr)
        => na

// @function Calculates high of a trading series.
// @param val Series to use (`high` is used if no argument is supplied).
// @returns The all-time high for the series.
tradeHigh(float val = high) =>
    ath = strategy.position_size == 0 ? float(na) : val
    ath := na(ath) ? float(na) : (ath[1] > ath ? ath[1] : ath)


// @function Calculates low of a trading series.
// @param val Series to use (`low` is used if no argument is supplied).
// @returns The all-time low for the series.
tradeLow(float val = low) =>
    atl = strategy.position_size == 0 ? float(na) : val
    atl := na(atl) ? float(na) : (atl[1] < atl ? atl[1] : atl)


// @function Bars count trade is open
// @returns Bars count since last entry
barsSinceLastEntry() =>
    strategy.opentrades > 0 ? bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) : na

//
// TAKE PROFIT
//

// @function Lineary changed profit
// @param initPerc Initial profit value in percent unit
// @param stepPerc Amount of change per every bar since last entry. Posiitive value will decrease profit in time.
// @returns Profit value lineary increased/decreased since last entry. If there is no opened trade, value is NaN
LinearProfit(simple float initPerc, simple float stepPerc) =>
    if strategy.position_size > 0
        strategy.opentrades.entry_price(0) * (1 + initPerc - stepPerc * barsSinceLastEntry())
    else if strategy.position_size < 0
        strategy.opentrades.entry_price(0) / (1 + initPerc - stepPerc * barsSinceLastEntry())
    else
        float(na)

// @function Profit adapted to lowest/highest value of given source and lineary changes after it
// @param initPerc Initial profit value in percent unit
// @param stepPerc Amount of change per every bar since last entry. Posiitive value will decrease profit in time.
// @param source Source according to is profit adapted. If it reach high, profit is increased for long positions, same for lowest price and short positions.
// @returns Profit value lineary increased/decreased and adjusted since last entry. If there is no active trade, value is NaN
export TakeProfit(simple float initPerc, simple float stepPerc, series float source = na) =>
    th = tradeHigh(source)
    tl = tradeLow(source)
    if na(source)
        LinearProfit(initPerc, stepPerc)
    else if strategy.position_size > 0
        th * (1 + initPerc - stepPerc * barsSinceLastEntry())
    else if strategy.position_size < 0
        tl / (1 + initPerc - stepPerc * barsSinceLastEntry())
    else
        float(na)

//
// STOP LOSS
//
    
// @function Lineary changed stop loss
// @param initPerc Initial stop loss value in percent unit
// @param stepPerc Amount of change per every bar since last entry. Posiitive value will increase stop loss in time.
// @returns Stop loss value lineary increased/decreased since last entry. If there is no opened trade, value is NaN
LinearStopLoss(simple float initPerc, simple float stepPerc) =>
    if strategy.position_size > 0
        strategy.opentrades.entry_price(0) / (1 + initPerc - stepPerc * barsSinceLastEntry())
    else if strategy.position_size < 0
        strategy.opentrades.entry_price(0) * (1 + initPerc - stepPerc * barsSinceLastEntry())
    else
        float(na)

// @function Stop loss adapted to highest/lowest value of given source and lineary changes after it
// @param initPerc Initial stop loss value in percent unit
// @param stepPerc Amount of change per every bar since last entry. Posiitive value will increase stop loss in time.
// @param source Source according to is stop loss adapted. If it reach high, stop loss is increased for long positions, same for low and short positions.
// @returns Stop loss value lineary increased/decreased and adjusted since last entry. If there is no active trade, value is NaN
export StopLoss(simple float initPerc, simple float stepPerc, series float source = na) =>
    th = tradeHigh(source)
    tl = tradeLow(source)
    if na(source)
        LinearStopLoss(initPerc, stepPerc)
    else if strategy.position_size > 0
        th / (1 + initPerc - stepPerc * barsSinceLastEntry())
    else if strategy.position_size < 0
        tl * (1 + initPerc - stepPerc * barsSinceLastEntry())
    else
        float(na)

//
// HELPERS
//


// @function Truncate quantity to required number of digits. It's truncate, not round, it simply zeroes digits after required amount. Truncate did not exceeds amount.
// @param price Price at which position is opened. Close price for market orders or stop price for stop limit orders.
// @param digits Number of digits.
// @returns Quantity truncate
export TruncateQuantity(float price, int digits) =>
    if digits < 0
        runtime.error("Unable truncate quantity to negative number of digits")

    qty = strategy.default_entry_qty(price)
    mult = math.pow(10, digits)
    // truncate to required digits
    float(int(qty * mult)) / mult


// @function Concerts given price to number of pips. Useful for parameters which reauires pips count, e.g. Convert relative price like `price * offset_percent / 100` to trail_offset.
// @param price Price will be converted to number of pips.
// @returns Number of pips which represents given price.
export PriceToPips(float price) =>
    pipSize = syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)
    price / pipSize