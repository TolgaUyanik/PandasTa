// @version=6
// @description
// This library provides a novel smoothing function for time-series data, serving as an alternative to SMA and EMA. Additionally, it provides some statistical processing, using moving averages as expected values in statistics.
// 'Approximate Gaussian Smoothing' (AGS) is designed to apply weights to time-series data that closely resemble Gaussian smoothing weights. it is easier to calculate than the similar ALMA.
// 
// The formula is:
// AGS-MA = (EMA + EMA(EMA) + EMA(EMA(EMA)) + EMA(EMA(EMA(EMA)))) / 4
// The EMA parameter alpha is 5 / (N + 4), using time period N (or length).
//
library("ApproximateGaussianSmoothing", overlay = true)

//#region Library functions
// @function                Calculate moving average using AGS.
// @param src               Series of values to process.
// @param length            Number of bars (length).
// @returns                 Moving average.
export ma(series float src, simple int length) =>
    sma = ta.sma(src, length)
    alpha = 5 / (length + 4)
    float es1 = na
    float es2 = na
    float es3 = na
    float es4 = na
    es1 := na(es1[1]) ? sma : alpha * src + (1 - alpha) * es1[1]
    es2 := na(es2[1]) ? es1 : alpha * es1 + (1 - alpha) * es2[1]
    es3 := na(es3[1]) ? es2 : alpha * es2 + (1 - alpha) * es3[1]
    es4 := na(es4[1]) ? es3 : alpha * es3 + (1 - alpha) * es4[1]
    (es1 + es2 + es3 + es4) / 4

// @function                Calculate mean and variance using AGS.
// @param src               Series of values to process.
// @param length            Number of bars (length).
// @returns                 Mean and variance.
export analyze(series float src, simple int length) =>
	mean = ma(src, length)
	variance = ma(src * src, length) - mean * mean
	[mean, variance]

// @function                Calculate mean and variance covariance matrix using AGS.
// @param dimensions        Dimensions of sources to process.
// @param sources           Series of values to process.
// @param length            Number of bars (length).
// @returns                 Mean and variance covariance matrix.
export analyze(simple int dimensions, series float[] sources, simple int length) =>
    if dimensions < 1 or dimensions > 10
        runtime.error("In the 'analyze()' function. Supported dimensions are 1 to 10.")

    size = sources.size()
    s0 = size > 0 ? sources.get(0) : na
    s1 = size > 1 ? sources.get(1) : na
    s2 = size > 2 ? sources.get(2) : na
    s3 = size > 3 ? sources.get(3) : na
    s4 = size > 4 ? sources.get(4) : na
    s5 = size > 5 ? sources.get(5) : na
    s6 = size > 6 ? sources.get(6) : na
    s7 = size > 7 ? sources.get(7) : na
    s8 = size > 8 ? sources.get(8) : na
    s9 = size > 9 ? sources.get(9) : na

    mean = array.new<float>(dimensions, na)
    vcm = matrix.new<float>(dimensions, dimensions, na)

    if dimensions > 0
        m = ma(s0, length)
        vcm.set(0, 0, ma(s0 * s0, length) - m * m)
        mean.set(0, m)
    
    if dimensions > 1
        m = ma(s1, length)
        vcm.set(0, 1, ma(s0 * s1, length) - mean.get(0) * m)
        vcm.set(1, 1, ma(s1 * s1, length) - m * m)
        mean.set(1, m)

    if dimensions > 2
        m = ma(s2, length)
        vcm.set(0, 2, ma(s0 * s2, length) - mean.get(0) * m)
        vcm.set(1, 2, ma(s1 * s2, length) - mean.get(1) * m)
        vcm.set(2, 2, ma(s2 * s2, length) - m * m)
        mean.set(2, m)

    if dimensions > 3
        m = ma(s3, length)
        vcm.set(0, 3, ma(s0 * s3, length) - mean.get(0) * m)
        vcm.set(1, 3, ma(s1 * s3, length) - mean.get(1) * m)
        vcm.set(2, 3, ma(s2 * s3, length) - mean.get(2) * m)
        vcm.set(3, 3, ma(s3 * s3, length) - m * m)
        mean.set(3, m)

    if dimensions > 4
        m = ma(s4, length)
        vcm.set(0, 4, ma(s0 * s4, length) - mean.get(0) * m)
        vcm.set(1, 4, ma(s1 * s4, length) - mean.get(1) * m)
        vcm.set(2, 4, ma(s2 * s4, length) - mean.get(2) * m)
        vcm.set(3, 4, ma(s3 * s4, length) - mean.get(3) * m)
        vcm.set(4, 4, ma(s4 * s4, length) - m * m)
        mean.set(4, m)

    if dimensions > 5
        m = ma(s5, length)
        vcm.set(0, 5, ma(s0 * s5, length) - mean.get(0) * m)
        vcm.set(1, 5, ma(s1 * s5, length) - mean.get(1) * m)
        vcm.set(2, 5, ma(s2 * s5, length) - mean.get(2) * m)
        vcm.set(3, 5, ma(s3 * s5, length) - mean.get(3) * m)
        vcm.set(4, 5, ma(s4 * s5, length) - mean.get(4) * m)
        vcm.set(5, 5, ma(s5 * s5, length) - m * m)
        mean.set(5, m)

    if dimensions > 6
        m = ma(s6, length)
        vcm.set(0, 6, ma(s0 * s6, length) - mean.get(0) * m)
        vcm.set(1, 6, ma(s1 * s6, length) - mean.get(1) * m)
        vcm.set(2, 6, ma(s2 * s6, length) - mean.get(2) * m)
        vcm.set(3, 6, ma(s3 * s6, length) - mean.get(3) * m)
        vcm.set(4, 6, ma(s4 * s6, length) - mean.get(4) * m)
        vcm.set(5, 6, ma(s5 * s6, length) - mean.get(5) * m)
        vcm.set(6, 6, ma(s6 * s6, length) - m * m)
        mean.set(6, m)

    if dimensions > 7
        m = ma(s7, length)
        vcm.set(0, 7, ma(s0 * s7, length) - mean.get(0) * m)
        vcm.set(1, 7, ma(s1 * s7, length) - mean.get(1) * m)
        vcm.set(2, 7, ma(s2 * s7, length) - mean.get(2) * m)
        vcm.set(3, 7, ma(s3 * s7, length) - mean.get(3) * m)
        vcm.set(4, 7, ma(s4 * s7, length) - mean.get(4) * m)
        vcm.set(5, 7, ma(s5 * s7, length) - mean.get(5) * m)
        vcm.set(6, 7, ma(s6 * s7, length) - mean.get(6) * m)
        vcm.set(7, 7, ma(s7 * s7, length) - m * m)
        mean.set(7, m)

    if dimensions > 8
        m = ma(s8, length)
        vcm.set(0, 8, ma(s0 * s8, length) - mean.get(0) * m)
        vcm.set(1, 8, ma(s1 * s8, length) - mean.get(1) * m)
        vcm.set(2, 8, ma(s2 * s8, length) - mean.get(2) * m)
        vcm.set(3, 8, ma(s3 * s8, length) - mean.get(3) * m)
        vcm.set(4, 8, ma(s4 * s8, length) - mean.get(4) * m)
        vcm.set(5, 8, ma(s5 * s8, length) - mean.get(5) * m)
        vcm.set(6, 8, ma(s6 * s8, length) - mean.get(6) * m)
        vcm.set(7, 8, ma(s7 * s8, length) - mean.get(7) * m)
        vcm.set(8, 8, ma(s8 * s8, length) - m * m)
        mean.set(8, m)

    if dimensions > 9
        m = ma(s9, length)
        vcm.set(0, 9, ma(s0 * s9, length) - mean.get(0) * m)
        vcm.set(1, 9, ma(s1 * s9, length) - mean.get(1) * m)
        vcm.set(2, 9, ma(s2 * s9, length) - mean.get(2) * m)
        vcm.set(3, 9, ma(s3 * s9, length) - mean.get(3) * m)
        vcm.set(4, 9, ma(s4 * s9, length) - mean.get(4) * m)
        vcm.set(5, 9, ma(s5 * s9, length) - mean.get(5) * m)
        vcm.set(6, 9, ma(s6 * s9, length) - mean.get(6) * m)
        vcm.set(7, 9, ma(s7 * s9, length) - mean.get(7) * m)
        vcm.set(8, 9, ma(s8 * s9, length) - mean.get(8) * m)
        vcm.set(9, 9, ma(s9 * s9, length) - m * m)
        mean.set(9, m)

    for i = 1 to dimensions - 1
        for j = 0 to i - 1
            vcm.set(i, j, vcm.get(j, i))

    [mean, vcm]

// @function                Calculate linear regression using AGS.
// @param src1              Series of values to process.
// @param src2              Series of values to process.
// @param length            Number of bars (length).
// @returns                 Slope, intercept and MSE.
export linreg(series float src1, series float src2, simple int length) =>
    [mean, vcm] = analyze(2, array.from(src1, src2), length)
    slope = vcm.get(0, 1) / vcm.get(0, 0)
    intercept = mean.get(1) - slope * mean.get(0)
    cc = vcm.get(0, 1) / math.sqrt(vcm.get(0, 0) * vcm.get(1, 1))
    mse = vcm.get(1, 1) * (1 - cc * cc)
    [slope, intercept, mse]

// @function                Calculate correlation using AGS.
// @param src1              Series of values to process.
// @param src2              Series of values to process.
// @param length            Number of bars (length).
// @returns                 Correlation coefficient.
export correlation(series float src1, series float src2, simple int length) =>
    [mean, vcm] = analyze(2, array.from(src1, src2), length)
    vcm.get(0, 1) / math.sqrt(vcm.get(0, 0) * vcm.get(1, 1))

//#endregion

//#region Example code
length = input.int(50, "Length")
sigma = input.float(1.0, "Sigma")
[mean, variance] = analyze(close, length)
dev = math.sqrt(variance) * sigma

plot0 = plot(mean, "AGS-MA", color.yellow)
plot1 = plot(mean + dev, "", #00000000, editable = false)
plot2 = plot(mean - dev, "", #00000000, editable = false)
fill(plot1, plot0, mean + dev, mean, #00000000, color.new(color.fuchsia, 30))
fill(plot0, plot2, mean, mean - dev, color.new(color.fuchsia, 30), #00000000)
//#endregion