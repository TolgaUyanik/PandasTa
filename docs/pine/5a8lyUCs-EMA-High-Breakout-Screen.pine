//@version=6
indicator("EMA High Breakout Screen", overlay=true)

// Calculate the 4-period EMA of the High
ema4_high = ta.ema(high, 4)

// Scan Condition: Close > 4 EMA High, preceded by 3 Closes < 4 EMA High
c0_above = close > ema4_high
c1_below = close[1] < ema4_high[1]
c2_below = close[2] < ema4_high[2]
c3_below = close[3] < ema4_high[3]

condition = c0_above and c1_below and c2_below and c3_below

// Paint bar green on chart
barcolor(condition ? color.green : na)

// Plot for chart & screener export
plot(ema4_high, title="4 EMA High", color=color.orange, linewidth=1)
plot(condition ? 1 : 0, title="Breakout Signal", display=display.none)