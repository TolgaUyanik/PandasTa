//@version=6
indicator("ADR & LoD", overlay = true)

// =========================================================================
// INPUTS
// =========================================================================
grp_gen        = "General"
show_empty_row = input.bool(false, "Show Empty Row (Avoid overlapping)", group = grp_gen)

grp_adr    = "ADR% Settings"
show_adrp  = input.bool(true,  "Show ADR%",   group = grp_adr)
adrp_len   = input.int(20,     "ADR% Length", minval = 1, group = grp_adr)
color_adrp = input.color(color.aqua, "ADR% Color", group = grp_adr)

grp_atr   = "ATR Settings"
show_atr  = input.bool(false, "Show ATR",   group = grp_atr)
atr_len   = input.int(14,     "ATR Length", minval = 1, group = grp_atr)
color_atr = input.color(color.orange, "ATR Color", group = grp_atr)

grp_lod        = "LoD Dist Settings"
show_lod_dist  = input.bool(true, "Show LoD dist", group = grp_lod)
color_lod_dist = input.color(color.red, "LoD dist Color", group = grp_lod)

// =========================================================================
// CALCULATIONS (timeframe independent)
// =========================================================================
// One security call returns both daily stats.
// [1] + lookahead_on = value of the last closed daily bar, identical on
// history and in real time -> no repainting, no intrabar drift.
[adr_ratio, atr_val] = request.security(syminfo.tickerid, "D",
     [ta.sma(high / low, adrp_len)[1], ta.atr(atr_len)[1]],
     lookahead = barmerge.lookahead_on)

adrp = 100 * (adr_ratio - 1)

// RTH-only daily bar. Because the request uses a regular-session ticker,
// extended-hours ticks never enter this series:
//   - during RTH  -> rth_c is the developing (live) RTH price, rth_l the
//                    developing session low, so the value updates tick by tick
//   - pre/post     -> the RTH bar is not open, so both freeze on the last
//                    completed RTH session
rth_tid        = ticker.modify(syminfo.tickerid, session.regular)
[rth_c, rth_l] = request.security(rth_tid, "D", [close, low])

lod_dist = na(rth_c) or rth_c == 0 ? na : 100 * (rth_c - rth_l) / rth_c

// =========================================================================
// TABLE
// =========================================================================
// Table is drawn only on the 5-minute and the 1-day chart.
is_5m      = timeframe.isminutes and timeframe.multiplier == 5
is_1d      = timeframe.isdaily   and timeframe.multiplier == 1
show_table = is_5m or is_1d

var table info_table = show_table ? table.new(position.top_right, 2, 4, border_width = 0) : na

fmt(float v, string suffix) =>
    na(v) ? "n/a" : str.tostring(v, "0.00") + suffix

addRow(int r, string label, string value, color c) =>
    table.cell(info_table, 0, r, label, text_color = c, text_halign = text.align_left)
    table.cell(info_table, 1, r, value, text_color = c, text_halign = text.align_right)

if show_table and barstate.islast
    table.clear(info_table, 0, 0, 1, 3)   // removes stale rows when toggling
    int r = 0

    if show_empty_row
        table.cell(info_table, 0, r, "")
        table.cell(info_table, 1, r, "")
        r += 1

    if show_adrp
        addRow(r, "ADR%", fmt(adrp, "%"), color_adrp)
        r += 1

    if show_atr
        addRow(r, "ATR", fmt(atr_val, ""), color_atr)
        r += 1

    if show_lod_dist
        addRow(r, "LoD dist", fmt(lod_dist, "%"), color_lod_dist)
// Chart updated in this version.