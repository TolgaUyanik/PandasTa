//@version=5
indicator("William's Awesome Oscillator (AO) - Log-scaled", shorttitle="Log AO", overlay=false,
         format=format.price, precision=4)

// ──────── USER INPUTS ────────
fastLen     = input.int(5,  "Fast SMA length")
slowLen     = input.int(34, "Slow SMA length")
showPct     = input.bool(true,  "Display as % of price")
logBase     = input.string("Natural (ln)",
              options = ["Natural (ln)", "Base‑10 (log10)"], title="Logarithm base")

// ──────── PRICE SERIES ON LOG SCALE ────────
medianPrice   = (high + low) / 2                               // Williams uses median price
logPrice      = logBase == "Natural (ln)" ? math.log(medianPrice)
                                              : math.log10(medianPrice)

// ──────── MOVING AVERAGES & OSCILLATOR ────────
fastMA_log    = ta.sma(logPrice, fastLen)
slowMA_log    = ta.sma(logPrice, slowLen)
ao_log        = fastMA_log - slowMA_log                        // Δ(log price)

// ──────── OPTIONAL PERCENT EXPRESSION ────────
//  Δ(log price) ≈ %change, but we can invert exactly:
ao_pct        = (math.exp(fastMA_log) - math.exp(slowMA_log)) / math.exp(slowMA_log) * 100

plotSeries    = showPct ? ao_pct : ao_log

// ──────── PLOTTING ────────
// Colour logic: greener bar = current value > previous value, otherwise red
isUp  = plotSeries > plotSeries[1]
barCol = isUp ? #26A69A : #EF5350

plot(plotSeries,
     title      = "Log AO",
     style      = plot.style_histogram,
     color      = barCol,
     linewidth  = 2)

hline(0, color=color.gray, linestyle=hline.style_dotted, title="Zero line")

