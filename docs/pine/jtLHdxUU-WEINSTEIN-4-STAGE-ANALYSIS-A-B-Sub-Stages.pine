// Doc_K and Stephem_K (Combined 4-Stage Weinstein Analysis - unified BUY/SELL signal framework with A/B sub-stages)

//@version=6
indicator('WEINSTEIN 4-STAGE ANALYSIS (A/B Sub-Stages)', overlay = false)

grp_table = 'Table Settings'
tablePos = input.string('top_right', 'Table Position', options = ['top_right', 'top_left', 'bottom_right', 'bottom_left', 'top_center', 'bottom_center', 'middle_right', 'middle_left'], group = grp_table)
textSize = input.string('normal', 'Text Size', options = ['tiny', 'small', 'normal', 'large', 'huge'], group = grp_table)

grp_visual = 'Visual Signals'
showLabels = input.bool(true, 'Show Buy/Sell Labels', group = grp_visual)
showBG = input.bool(true, 'Highlight Stage Background', group = grp_visual)
text_color = input.color(color.white, 'Label Text Color', group = grp_visual)
lineWeight = input.int(10, 'Ribbon Thickness', minval = 1, maxval = 100, group = grp_visual)

grp_stage = 'Stage Classification'
slopeLen = input.int(21, '200 SMA Slope Lookback (Bars)', minval = 5, group = grp_stage, tooltip = 'Window used to measure whether the 200-day SMA is rising, flat, or falling')
risingThreshPct = input.float(0.5, 'Rising Threshold (%)', minval = 0.0, step = 0.1, group = grp_stage, tooltip = '200 SMA must have risen by at least this % over the slope lookback to count as Stage 2 structure')
fallingThreshPct = input.float(0.5, 'Falling Threshold (%)', minval = 0.0, step = 0.1, group = grp_stage, tooltip = '200 SMA must have fallen by at least this % over the slope lookback to count as Stage 4 structure')

grp_sub = 'Sub-Stage Classification (A/B)'
flatThreshPct = input.float(0.15, 'Flat Slope Threshold (%)', minval = 0.0, step = 0.05, group = grp_sub, tooltip = 'Slope magnitude below this counts as flattened - used for the 1A/1B split')
lateAdvanceWeeks = input.int(35, 'Late-Stage 2 Weeks Threshold', minval = 1, group = grp_sub, tooltip = 'Weeks spent in Stage 2 beyond which the advance is considered late (2B)')
extendedPctThresh = input.float(25.0, 'Extended Above 50 SMA (%)', minval = 0.0, step = 1.0, group = grp_sub, tooltip = 'Price this far above the 50 SMA also counts as late/extended Stage 2B')
lateDeclineWeeks = input.int(35, 'Late-Stage 4 Weeks Threshold', minval = 1, group = grp_sub)
steepDeclineSlopePct = input.float(1.5, 'Steep Decline Slope (%)', minval = 0.0, step = 0.1, group = grp_sub, tooltip = '200 SMA slope magnitude beyond this, combined with volume contraction, marks Stage 4B')
supportLookback = input.int(10, 'Stage 3 Support Break Lookback (Bars)', minval = 2, group = grp_sub, tooltip = 'A close below the lowest low of this many prior bars flags a Stage 3B breakdown')

grp_vol = 'Volume Confirmation'
volLen = input.int(50, 'Volume Average Length', minval = 1, group = grp_vol)
volMult = input.float(1.2, 'Volume Expansion Multiplier', minval = 1.0, step = 0.1, group = grp_vol, tooltip = 'Volume above (avg x this) reads as Expansion; below (avg / this) reads as Contraction')

grp_rs = 'Relative Strength'
benchSymbol = input.symbol('SPY', 'Benchmark Symbol', group = grp_rs)
rsLen = input.int(21, 'RS Lookback (Bars)', minval = 1, group = grp_rs)

grp_sector = 'Sector Trend'
overrideSector = input.bool(false, 'Override Auto Sector (Manual)', group = grp_sector)
manualSectorSymbol = input.symbol('XLK', 'Manual Sector ETF (if Override ON)', group = grp_sector)

grp_alert = 'Alert Settings'
alertWindow = input.int(3, 'Alert Window (Days)', minval = 1, group = grp_alert, tooltip = 'Keep firing window alerts for this many days after a fresh Buy/Sell signal')

f_getAutoSector() =>
    string sec = syminfo.sector
    string result = 'XLY'
    if sec == 'Commercial Services'
        result := 'XLI'
    if sec == 'Communications'
        result := 'XLC'
    if sec == 'Consumer Durables'
        result := 'XLY'
    if sec == 'Consumer Non-Durables'
        result := 'XLP'
    if sec == 'Consumer Services'
        result := 'XLY'
    if sec == 'Distribution Services'
        result := 'XLI'
    if sec == 'Electronic Technology'
        result := 'XLK'
    if sec == 'Energy Minerals'
        result := 'XLE'
    if sec == 'Finance'
        result := 'XLF'
    if sec == 'Health Services'
        result := 'XLV'
    if sec == 'Health Technology'
        result := 'XLV'
    if sec == 'Industrial Services'
        result := 'XLI'
    if sec == 'Non-Energy Minerals'
        result := 'XLB'
    if sec == 'Process Industries'
        result := 'XLB'
    if sec == 'Producer Manufacturing'
        result := 'XLI'
    if sec == 'Retail Trade'
        result := 'XLY'
    if sec == 'Technology Services'
        result := 'XLK'
    if sec == 'Transportation'
        result := 'XLI'
    if sec == 'Utilities'
        result := 'XLU'
    result

autoSectorSymbol = f_getAutoSector()
sectorETFSymbol = overrideSector ? manualSectorSymbol : autoSectorSymbol
sectorDisplayName = overrideSector ? 'Manual Override' : (syminfo.sector == '' ? 'Unclassified' : syminfo.sector)

sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

slopePct = (sma200 - sma200[slopeLen]) / sma200[slopeLen] * 100
risingMA = slopePct > risingThreshPct
fallingMA = slopePct < -fallingThreshPct

aboveMA = close > sma200 and sma50 > sma200
belowMA = close < sma200 and sma50 < sma200

avgVol = ta.sma(volume, volLen)
volState = volume > avgVol * volMult ? 'Expansion' : volume < avgVol / volMult ? 'Contraction' : 'Neutral'

benchClose = request.security(benchSymbol, timeframe.period, close, lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)
stockReturn = close / close[rsLen] - 1
benchReturn = benchClose / benchClose[rsLen] - 1
rsState = stockReturn > benchReturn ? 'Outperform' : 'Underperform'

sectorClose = request.security(sectorETFSymbol, timeframe.period, close, lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)
sectorSma50 = ta.sma(sectorClose, 50)
sectorState = sectorClose > sectorSma50 ? 'Strong' : 'Weak'

var int stage = 1

if risingMA and aboveMA
    stage := 2
else if fallingMA and belowMA
    stage := 4
else if stage == 2
    stage := 3
else if stage == 4
    stage := 1

stageNames = array.from('', 'Stage 1: Basing', 'Stage 2: Advancing', 'Stage 3: Topping', 'Stage 4: Declining')
stageName = array.get(stageNames, stage)

stageColors = array.new_color(0)
array.push(stageColors, color.new(color.blue, 0))
array.push(stageColors, color.new(color.blue, 0))
array.push(stageColors, color.new(color.green, 0))
array.push(stageColors, color.new(color.orange, 0))
array.push(stageColors, color.new(color.red, 0))
stageColor = array.get(stageColors, stage)

buySignal = stage == 2 and stage[1] != 2
sellSignal = stage == 3 and stage[1] == 2
stage4Confirmed = stage == 4 and stage[1] != 4

var int stageDays = 0
stageDays := stage == stage[1] ? stageDays + 1 : 1
weeksInStage = stageDays / 5.0

extPct = (close - sma50) / sma50 * 100
support = ta.lowest(low[1], supportLookback)
brokeSupport = close < support

string subStage = ''
string subAction = ''
color subColorRaw = color.gray

if stage == 1 and slopePct < -flatThreshPct
    subStage := '1A'
    subAction := 'Avoid (Dead Money)'
    subColorRaw := color.navy
else if stage == 1
    subStage := '1B'
    subAction := 'Watchlist / Prepare'
    subColorRaw := color.blue
else if stage == 2 and (weeksInStage > lateAdvanceWeeks or extPct > extendedPctThresh)
    subStage := '2B'
    subAction := 'Hold / Tighten Stops'
    subColorRaw := color.olive
else if stage == 2
    subStage := '2A'
    subAction := 'Primary BUY Zone'
    subColorRaw := color.green
else if stage == 3 and (brokeSupport or fallingMA)
    subStage := '3B'
    subAction := 'Sell Remaining on Rallies'
    subColorRaw := color.maroon
else if stage == 3
    subStage := '3A'
    subAction := 'Trim 50% Position'
    subColorRaw := color.orange
else if stage == 4 and (weeksInStage > lateDeclineWeeks or (volState == 'Contraction' and slopePct < -steepDeclineSlopePct))
    subStage := '4B'
    subAction := 'Cash / Stay Out (No Bottom Fish)'
    subColorRaw := color.maroon
else if stage == 4
    subStage := '4A'
    subAction := 'Exit Longs / Short'
    subColorRaw := color.red

subColor = color.new(subColorRaw, 0)

fullSubStageName = switch subStage
    '1A' => 'Stage 1A: Early Base'
    '1B' => 'Stage 1B: Late Base'
    '2A' => 'Stage 2A: Early Advance'
    '2B' => 'Stage 2B: Late Advance'
    '3A' => 'Stage 3A: Early Top'
    '3B' => 'Stage 3B: Late Top'
    '4A' => 'Stage 4A: Early Decline'
    '4B' => 'Stage 4B: Late Decline'
    => stageName

var int lastBuyDay = na
var int lastBuyMonth = na
var int lastBuyYear = na
var int lastSellDay = na
var int lastSellMonth = na
var int lastSellYear = na

if buySignal
    lastBuyDay := dayofmonth
    lastBuyMonth := month
    lastBuyYear := year
if sellSignal
    lastSellDay := dayofmonth
    lastSellMonth := month
    lastSellYear := year

buyWindowActive = buySignal or (stage == 2 and stageDays <= alertWindow)
sellWindowActive = sellSignal or (stage == 3 and stageDays <= alertWindow)

plotshape(buySignal and showLabels, 'Buy Signal', shape.labelup, location.belowbar, color.new(color.green, 0), text = 'BUY', textcolor = text_color, size = size.small, force_overlay = true)
plotshape(sellSignal and showLabels, 'Sell Signal', shape.labeldown, location.abovebar, color.new(color.red, 0), text = 'SELL', textcolor = text_color, size = size.small, force_overlay = true)
bgcolor(showBG ? color.new(stageColor, 90) : na, force_overlay = true)

alertcondition(buySignal, title = 'BUY Signal - Stage 2 Entry', message = 'BUY: {{ticker}} entered Stage 2 (Advancing)')
alertcondition(sellSignal, title = 'SELL Signal - Stage 3 Entry', message = 'SELL: {{ticker}} entered Stage 3 (Topping) from Stage 2')
alertcondition(stage4Confirmed, title = 'Stage 4 Confirmed (Decline)', message = '{{ticker}} confirmed Stage 4 (Declining)')
alertcondition(buyWindowActive, title = 'Buy Window Alert', message = '{{ticker}} in early Stage 2 (Day {{plot_1}})')
alertcondition(sellWindowActive, title = 'Sell Window Alert', message = '{{ticker}} in early Stage 3 (Day {{plot_1}})')

alertcondition(subStage == '1B' and subStage[1] == '1A', title = 'Enter Stage 1B - Late Base', message = '{{ticker}} entered Stage 1B: Late Base - Watchlist / Prepare')
alertcondition(subStage == '2A' and subStage[1] != '2A', title = 'Enter Stage 2A - Early Advance', message = '{{ticker}} entered Stage 2A: Early Advance - Primary BUY Zone')
alertcondition(subStage == '2B' and subStage[1] == '2A', title = 'Enter Stage 2B - Late Advance', message = '{{ticker}} entered Stage 2B: Late Advance - Tighten Stops')
alertcondition(subStage == '3A' and subStage[1] != '3A', title = 'Enter Stage 3A - Early Top', message = '{{ticker}} entered Stage 3A: Early Top - Trim 50% Position')
alertcondition(subStage == '3B' and subStage[1] == '3A', title = 'Enter Stage 3B - Late Top', message = '{{ticker}} entered Stage 3B: Late Top - Sell Remaining on Rallies')
alertcondition(subStage == '4A' and subStage[1] != '4A', title = 'Enter Stage 4A - Early Decline', message = '{{ticker}} entered Stage 4A: Early Decline - Exit Longs / Short')
alertcondition(subStage == '4B' and subStage[1] == '4A', title = 'Enter Stage 4B - Late Decline', message = '{{ticker}} entered Stage 4B: Late Decline - Cash / Stay Out')

getPos(p) =>
    switch p
        'top_right'     => position.top_right
        'top_left'      => position.top_left
        'bottom_right'  => position.bottom_right
        'bottom_left'   => position.bottom_left
        'top_center'    => position.top_center
        'bottom_center' => position.bottom_center
        'middle_right'  => position.middle_right
        'middle_left'   => position.middle_left
        => position.top_right

getSize(s) =>
    switch s
        'tiny'   => size.tiny
        'small'  => size.small
        'normal' => size.normal
        'large'  => size.large
        'huge'   => size.huge
        => size.normal

var table stageTable = table.new(position.top_right, 2, 11, border_width = 1, border_color = color.gray, force_overlay = true)

f_cell(_row, _title, _val, _color) =>
    table.cell(stageTable, 0, _row, _title, bgcolor = color.new(color.gray, 20), text_color = color.white, text_size = getSize(textSize))
    table.cell(stageTable, 1, _row, _val, bgcolor = _color, text_color = color.white, text_size = getSize(textSize))

if barstate.islast
    table.set_position(stageTable, getPos(tablePos))
    f_cell(0, 'Current Stage', stageName, color.new(stageColor, 40))
    f_cell(1, 'Sub-Stage', fullSubStageName, color.new(subColor, 30))
    f_cell(2, 'Recommended Action', subAction, color.new(subColor, 60))
    f_cell(3, 'Days in Stage', str.tostring(stageDays) + ' (' + str.tostring(weeksInStage, '#.#') + ' wk)', color.new(color.gray, 60))
    f_cell(4, '50 SMA vs 200 SMA', sma50 > sma200 ? '50 > 200' : '50 < 200', sma50 > sma200 ? color.new(color.green, 60) : color.new(color.red, 60))
    f_cell(5, '200 SMA Slope', (risingMA ? 'Rising ' : fallingMA ? 'Falling ' : 'Flat ') + str.tostring(slopePct, '#.##') + '%', risingMA ? color.new(color.green, 60) : fallingMA ? color.new(color.red, 60) : color.new(color.gray, 60))
    f_cell(6, 'Extension vs 50 SMA', str.tostring(extPct, '#.##') + '%', extPct > extendedPctThresh ? color.new(color.orange, 60) : color.new(color.gray, 60))
    f_cell(7, 'Volume', volState, volState == 'Expansion' ? color.new(color.green, 60) : volState == 'Contraction' ? color.new(color.gray, 60) : color.new(color.gray, 70))
    f_cell(8, 'RS vs Benchmark (' + syminfo.ticker(benchSymbol) + ')', rsState, rsState == 'Outperform' ? color.new(color.green, 60) : color.new(color.red, 60))
    f_cell(9, sectorDisplayName + ' (' + sectorETFSymbol + ')', sectorState, sectorState == 'Strong' ? color.new(color.green, 60) : color.new(color.red, 60))
    string lastBuySeen = not na(lastBuyDay) ? str.tostring(lastBuyDay) + '/' + str.tostring(lastBuyMonth) + '/' + str.tostring(lastBuyYear) : 'Never'
    string lastSellSeen = not na(lastSellDay) ? str.tostring(lastSellDay) + '/' + str.tostring(lastSellMonth) + '/' + str.tostring(lastSellYear) : 'Never'
    f_cell(10, 'Last BUY / SELL', lastBuySeen + '  /  ' + lastSellSeen, color.new(color.gray, 70))

plot(stageDays, title = 'Days in Stage Counter', display = display.none)
plot(0, 'Stage Ribbon', color = subColor, linewidth = math.max(1, lineWeight), style = plot.style_line, histbase = -1)