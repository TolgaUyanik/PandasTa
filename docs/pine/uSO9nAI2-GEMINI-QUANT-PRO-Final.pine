//@version=5
strategy("GEMINI QUANT PRO - Final", overlay=true, initial_capital=1000, default_qty_type=strategy.cash, currency=currency.USD)

//━━━━━━━━━━━━━━━━━━━
// 1. SETTINGS & INPUTS
//━━━━━━━━━━━━━━━━━━━
group_ema = "EMA Settings (Backend)"
ema44_len  = input.int(44, "EMA 44 Length", group=group_ema)
ema200_len = input.int(200, "EMA 200 Length", group=group_ema)

group_risk = "Risk Management (Pro)"
tp1_mult = input.float(1.5, "TP1 Profit Ratio (RR)", group=group_risk)
tp2_mult = input.float(3.0, "TP2 Profit Ratio (RR)", group=group_risk)
tp3_mult = input.float(5.0, "TP3 Profit Ratio (RR)", group=group_risk)
sl_buffer = input.float(0.2, "SL Buffer (%)", group=group_risk) / 100

//━━━━━━━━━━━━━━━━━━━
// 2. MULTI-TIMEFRAME TREND LOGIC
//━━━━━━━━━━━━━━━━━━━
f_get_trend(_tf) =>
    _c = request.security(syminfo.tickerid, _tf, close)
    _e = request.security(syminfo.tickerid, _tf, ta.ema(close, ema200_len))
    _c > _e ? 1 : -1

trend1D  = f_get_trend("D")
trend4H  = f_get_trend("240")
trend1H  = f_get_trend("60")
trend15M = f_get_trend("15")

//━━━━━━━━━━━━━━━━━━━
// 3. EMA RETEST LOGIC
//━━━━━━━━━━━━━━━━━━━
ema44  = ta.ema(close, ema44_len)
ema200 = ta.ema(close, ema200_len)

// Bullish Retest
bull_retest = low <= ema44 and close > ema44 and close > ema200

// Bearish Retest
bear_retest = high >= ema44 and close < ema44 and close < ema200

// Volume Filter
vol_filter = volume > ta.sma(volume, 20)

//━━━━━━━━━━━━━━━━━━━
// 4. TRADE CONDITIONS
//━━━━━━━━━━━━━━━━━━━
long_condition  = bull_retest and trend1D == 1 and trend4H == 1 and vol_filter
short_condition = bear_retest and trend1D == -1 and trend4H == -1 and vol_filter

//━━━━━━━━━━━━━━━━━━━
// 5. TARGET & STOPLOSS
//━━━━━━━━━━━━━━━━━━━
var float entry_price = na
var float sl  = na
var float tp1 = na
var float tp2 = na
var float tp3 = na

// BUY ENTRY
if long_condition and strategy.position_size == 0
    entry_price := close
    sl := low * (1 - sl_buffer)

    risk = entry_price - sl

    tp1 := entry_price + (risk * tp1_mult)
    tp2 := entry_price + (risk * tp2_mult)
    tp3 := entry_price + (risk * tp3_mult)

    strategy.entry("Long", strategy.long)

// SELL ENTRY
if short_condition and strategy.position_size == 0
    entry_price := close
    sl := high * (1 + sl_buffer)

    risk = sl - entry_price

    tp1 := entry_price - (risk * tp1_mult)
    tp2 := entry_price - (risk * tp2_mult)
    tp3 := entry_price - (risk * tp3_mult)

    strategy.entry("Short", strategy.short)

//━━━━━━━━━━━━━━━━━━━
// 6. EXIT SYSTEM
//━━━━━━━━━━━━━━━━━━━
strategy.exit("TP/SL Long", from_entry="Long", stop=sl, limit=tp3)
strategy.exit("TP/SL Short", from_entry="Short", stop=sl, limit=tp3)

//━━━━━━━━━━━━━━━━━━━
// 7. DASHBOARD TABLE
//━━━━━━━━━━━━━━━━━━━
var table panel = table.new(
     position.top_right,
     2,
     6,
     bgcolor=color.new(color.black, 10),
     border_width=1,
     border_color=color.gray)

// Function
f_fill(_r, _txt, _val) =>
    _col = _val == 1 ? color.new(color.green, 20) : color.new(color.red, 20)
    _status = _val == 1 ? "BULLISH" : "BEARISH"

    table.cell(panel, 0, _r, _txt, text_color=color.white)
    table.cell(panel, 1, _r, _status, bgcolor=_col, text_color=color.white)

// Dashboard Update
if barstate.islast

    // Header
    table.cell(panel, 0, 0, "TIMEFRAME",
         text_color=color.white,
         bgcolor=color.new(color.gray, 50))

    table.cell(panel, 1, 0, "STATUS",
         text_color=color.white,
         bgcolor=color.new(color.gray, 50))

    // Trend Rows
    f_fill(1, "01 DAY", trend1D)
    f_fill(2, "04 HRS", trend4H)
    f_fill(3, "01 HRS", trend1H)
    f_fill(4, "15 MIN", trend15M)

    // Signal Row
    signalText = long_condition or short_condition ? "ENTRY NOW" : "SCANNING"

    signalColor = long_condition ?
         color.green :
         short_condition ?
         color.red :
         color.gray

    table.cell(panel, 0, 5, "SIGNAL", text_color=color.white)

    table.cell(panel, 1, 5,
         signalText,
         bgcolor=signalColor,
         text_color=color.white)

//━━━━━━━━━━━━━━━━━━━
// 8. VISUAL SIGNALS
//━━━━━━━━━━━━━━━━━━━
plotshape(
     long_condition,
     title="BUY",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.green,
     size=size.small,
     text="BUY")

plotshape(
     short_condition,
     title="SELL",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     size=size.small,
     text="SELL")

//━━━━━━━━━━━━━━━━━━━
// 9. TP & SL LINES
//━━━━━━━━━━━━━━━━━━━
plot(strategy.position_size != 0 ? sl : na,
     title="Stop Loss",
     color=color.red,
     linewidth=2,
     style=plot.style_linebr)

plot(strategy.position_size != 0 ? tp1 : na,
     title="TP1",
     color=color.green,
     linewidth=1,
     style=plot.style_linebr)

plot(strategy.position_size != 0 ? tp2 : na,
     title="TP2",
     color=color.green,
     linewidth=1,
     style=plot.style_linebr)

plot(strategy.position_size != 0 ? tp3 : na,
     title="TP3",
     color=color.green,
     linewidth=2,
     style=plot.style_linebr)

//━━━━━━━━━━━━━━━━━━━
// 10. EMA PLOTS
//━━━━━━━━━━━━━━━━━━━
plot(ema44, title="EMA 44", color=color.orange, linewidth=2)
plot(ema200, title="EMA 200", color=color.blue, linewidth=2)
