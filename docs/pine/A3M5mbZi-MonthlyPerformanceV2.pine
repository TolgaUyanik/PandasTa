//@version=6
library('MonthlyPerformanceV2', true)

export trackAndDraw(float initialCapital, bool showInPercentage) =>
    // --- A. DEKLARASI VARIABEL & TABEL ---
    // Max rows Pine Script table = 500. Kita pakai 1 baris header + max 19 tahun = 20 baris.
    int MAX_YEARS = 19
    var table results_table = table.new(position.bottom_right, 14, MAX_YEARS + 1, border_width = 1)
    var all_monthly_profits = array.new_float()
    var all_month_start_equities = array.new_float()
    var all_month_numbers = array.new_int()
    var all_year_numbers = array.new_int()
    var float month_start_equity = initialCapital

    // --- B. LOGIKA UTAMA ---
    bool isNewDay = dayofweek != dayofweek[1]
    bool isNewMonth = month != month[1]

    if isNewDay or isNewMonth
        if isNewMonth
            float last_month_profit = strategy.equity[1] - month_start_equity
            array.push(all_monthly_profits, last_month_profit)
            array.push(all_month_start_equities, month_start_equity)
            array.push(all_month_numbers, month[1])
            array.push(all_year_numbers, year[1])
            month_start_equity := strategy.equity[1]

        table.clear(results_table, 0, 0)

        // Header
        table.cell(results_table, 0, 0, 'Year', bgcolor = color.gray, text_color = color.white, text_size = size.small)
        array<string> month_names = array.from('Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec')
        for i = 0 to 11 by 1
            table.cell(results_table, i + 1, 0, array.get(month_names, i), bgcolor = color.gray, text_color = color.white, text_size = size.small)
        table.cell(results_table, 13, 0, 'Total', bgcolor = color.blue, text_color = color.white, text_size = size.small)

        if array.size(all_year_numbers) > 0
            unique_years = array.new_int()
            for y in all_year_numbers
                if not array.includes(unique_years, y)
                    array.push(unique_years, y)
            array.sort(unique_years)

            // --- BATASI JUMLAH TAHUN AGAR TIDAK MELEBIHI KAPASITAS TABEL ---
            int total_years = array.size(unique_years)
            int start_year_idx = math.max(0, total_years - MAX_YEARS)
            // Hanya tampilkan MAX_YEARS tahun terbaru
            display_years = array.new_int()
            for dy = start_year_idx to total_years - 1 by 1
                array.push(display_years, array.get(unique_years, dy))

            for y_idx = 0 to array.size(display_years) - 1 by 1
                int current_year = array.get(display_years, y_idx)
                int table_row = y_idx + 1  // baris tabel (1-based karena baris 0 = header)

                table.cell(results_table, 0, table_row, str.tostring(current_year), bgcolor = color.gray, text_color = color.white, text_size = size.small)

                float year_start_equity = na
                float year_end_equity = na

                for i = 0 to array.size(all_monthly_profits) - 1 by 1
                    if array.get(all_year_numbers, i) == current_year
                        float month_profit = array.get(all_monthly_profits, i)
                        float current_month_start_equity = array.get(all_month_start_equities, i)
                        int month_number = array.get(all_month_numbers, i)

                        float profit_pct = month_profit / current_month_start_equity * 100

                        string cell_text = ''
                        if showInPercentage
                            cell_text := str.tostring(profit_pct, '#.##') + '%'
                        else
                            float profit_in_usd = profit_pct / 100 * initialCapital
                            cell_text := str.tostring(profit_in_usd, '$#,###.##')

                        color cell_color = profit_pct >= 0 ? color.new(color.green, 50) : color.new(color.red, 50)
                        table.cell(results_table, month_number, table_row, cell_text, bgcolor = cell_color, text_color = color.white, text_size = size.small)

                        if na(year_start_equity)
                            year_start_equity := current_month_start_equity
                        year_end_equity := current_month_start_equity + month_profit

                // --- Total Tahunan ---
                string total_cell_text = ''
                if not na(year_start_equity) and not na(year_end_equity)
                    float yearly_total_pct = (year_end_equity / year_start_equity - 1) * 100

                    if showInPercentage
                        total_cell_text := str.tostring(yearly_total_pct, '#.##') + '%'
                    else
                        float total_profit_in_usd = yearly_total_pct / 100 * initialCapital
                        float total_equity_in_usd = initialCapital + total_profit_in_usd
                        total_cell_text := str.tostring(total_equity_in_usd, '$#,###.##')

                    color total_color = yearly_total_pct >= 0 ? color.new(color.green, 30) : color.new(color.red, 30)
                    table.cell(results_table, 13, table_row, total_cell_text, bgcolor = total_color, text_color = color.white, text_size = size.small)

            // --- Bulan Berjalan ---
            // Cek apakah tahun saat ini ada di dalam display_years
            int current_year_display_idx = array.indexof(display_years, year)
            if current_year_display_idx >= 0
                int row_to_update = current_year_display_idx + 1
                float running_month_profit = strategy.equity - month_start_equity
                float running_profit_pct = running_month_profit / month_start_equity * 100

                string running_cell_text = ''
                if showInPercentage
                    running_cell_text := str.tostring(running_profit_pct, '#.##') + '%'
                else
                    float running_profit_in_usd = running_profit_pct / 100 * initialCapital
                    running_cell_text := str.tostring(running_profit_in_usd, '$#,###.##')

                color running_cell_color = running_profit_pct >= 0 ? color.new(color.green, 80) : color.new(color.red, 80)
                table.cell(results_table, month, row_to_update, running_cell_text, bgcolor = running_cell_color, text_color = color.white, text_size = size.small)