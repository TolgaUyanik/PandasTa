//@version=6
library("PivotLibrary222", overlay=true)
//@description A comprehensive library for detecting, managing, and analyzing pivot points (highs and lows) based on calculated strength.

// ============================================================================================= //
// ==========                           Exported User Defined Types                       ========= //
// ============================================================================================= //
// @type Represents a detected pivot high.
export type pivotHighInfo
    int    abs_index
    float  price
    int    strength
    label  label_id // Stores the ID of the label marking the pivot.
	float time         // new
    int bars_since_last
    float amplitude
    string cycle_phase_id
    bool is_confirmed

// @type Represents a detected pivot low.
export type pivotLowInfo
    int    abs_index
    float  price
    int    strength
    label  label_id // Stores the ID of the label marking the pivot.
	float time         // new
    int bars_since_last
    float amplitude
    string cycle_phase_id
    bool is_confirmed

// ============================================================================================= //
// ==========                           Exported Functions                              ========= //
// ============================================================================================= //



// @function Determines the strength of a pivot (low or high).
// @param _pivotCandidateRelativeIndex The relative bar index of the pivot candidate.
// @param _type "low" for a pivot low, "high" for a pivot high.
// @param _maxStrength The maximum number of bars to check on either side for strength.
// @returns An array containing [leftStrength, rightStrength].
export f_determinePivotStrength(int _pivotCandidateRelativeIndex, string _type, int _maxStrength) =>
    int leftStrength = 0, int rightStrength = 0
    float priceAtPivot = _type == "low" ? low[_pivotCandidateRelativeIndex] : high[_pivotCandidateRelativeIndex]

    // Calculate left strength
    for i = 1 to _maxStrength
        if _pivotCandidateRelativeIndex + i >= bar_index
            break
        float currentPrice = _type == "low" ? low[_pivotCandidateRelativeIndex + i] : high[_pivotCandidateRelativeIndex + i]
        if (_type == "low" and currentPrice < priceAtPivot) or (_type == "high" and currentPrice > priceAtPivot)
            break
        leftStrength := i

    // Calculate right strength
    for i = 1 to _maxStrength
        if _pivotCandidateRelativeIndex - i < 0
            break
        float currentPrice = _type == "low" ? low[_pivotCandidateRelativeIndex - i] : high[_pivotCandidateRelativeIndex - i]
        if (_type == "low" and currentPrice < priceAtPivot) or (_type == "high" and currentPrice > priceAtPivot)
            break
        rightStrength := i
    
    [leftStrength, rightStrength]

// @function Gets a plotting color based on pivot strength.
// @param _strength The calculated pivot strength.
// @returns A color for plotting.
export f_getPlotColorForStrength(int _strength) =>
    color plotColor = na
    if _strength >= 31
        plotColor := color.new(color.white, 0)
    else if _strength >= 21
        plotColor := color.new(color.red, 0)
    else if _strength >= 16
        plotColor := color.new(color.orange, 0)
    else if _strength >= 11
        plotColor := color.new(color.yellow, 0)
    else if _strength >= 7
        plotColor := color.new(color.lime, 0)
    else if _strength >= 4
        plotColor := color.new(color.aqua, 0)
    else
        plotColor := color.new(color.blue, 0)
    plotColor



// @function Updates an existing pivot LOW's strength and its corresponding chart label.
// @param f_pivotLows The array of pivotLowInfo objects.
// @param f_pivotLowInfoIndex The index of the pivot to update in the array.
// @param f_newStrength The new (increased) strength of the pivot.
// @param f_showLabels A boolean to control if labels should be updated.
export f_updateExistingPivotLow(array<pivotLowInfo> f_pivotLows, int f_pivotLowInfoIndex, int f_newStrength, bool f_showLabels) =>
    pivotLowInfo currentPivot = array.get(f_pivotLows, f_pivotLowInfoIndex)
    currentPivot.strength := f_newStrength
    array.set(f_pivotLows, f_pivotLowInfoIndex, currentPivot)
    
    string strengthText = str.tostring(currentPivot.strength)
    color plotColor = f_getPlotColorForStrength(currentPivot.strength)
    
    label existingLabel = currentPivot.label_id
    if not na(existingLabel) and f_showLabels
        existingLabel.set_textcolor(plotColor)
        existingLabel.set_text("↟ \n" + strengthText)
        existingLabel.set_tooltip("Pivot Low (AbsIdx: " + str.tostring(currentPivot.abs_index) + ", Strength: " + strengthText + ")")

// @function Updates an existing pivot HIGH's strength and its corresponding chart label.
// @param f_pivotHighs The array of pivotHighInfo objects.
// @param f_pivotHighInfoIndex The index of the pivot to update in the array.
// @param f_newStrength The new (increased) strength of the pivot.
// @param f_showLabels A boolean to control if labels should be updated.
export f_updateExistingPivotHigh(array<pivotHighInfo> f_pivotHighs, int f_pivotHighInfoIndex, int f_newStrength, bool f_showLabels) =>
    pivotHighInfo currentPivot = array.get(f_pivotHighs, f_pivotHighInfoIndex)
    currentPivot.strength := f_newStrength
    array.set(f_pivotHighs, f_pivotHighInfoIndex, currentPivot)
    
    string strengthText = str.tostring(currentPivot.strength)
    color plotColor = f_getPlotColorForStrength(currentPivot.strength)
    
    label existingLabel = currentPivot.label_id
    if not na(existingLabel) and f_showLabels
        existingLabel.set_textcolor(plotColor)
        existingLabel.set_text("↡ \n" + strengthText)
        existingLabel.set_tooltip("Pivot High (AbsIdx: " + str.tostring(currentPivot.abs_index) + ", Strength: " + strengthText + ")")

// @function Finds and processes pivot lows.
// @param f_pivotLows The array of pivotLowInfo objects to read from and modify.
// @param f_minStrength Minimum strength required for a new pivot to be recorded.
// @param f_maxStrength Maximum strength to search for when determining pivot strength.
// @param f_showLabels A boolean to control if new labels should be created.
export f_findPivotLows(array<pivotLowInfo> f_pivotLows, int f_minStrength, int f_maxStrength, bool f_showLabels) =>
    if array.size(f_pivotLows) > 0
        for i = array.size(f_pivotLows) - 1 to 0
            pivotLowInfo currentPivot = array.get(f_pivotLows, i)
            int pivotRelativeIndex = bar_index - currentPivot.abs_index
            if pivotRelativeIndex > f_maxStrength + 1 or pivotRelativeIndex < 0 
                continue
            
            [newLeftStrength, newRightStrength] = f_determinePivotStrength(pivotRelativeIndex, "low", f_maxStrength)
            int newStrength = math.min(newLeftStrength, newRightStrength)
            
            if newStrength > currentPivot.strength
                f_updateExistingPivotLow(f_pivotLows, i, newStrength, f_showLabels)

    int pivotCandidateRelativeIndex = f_minStrength 
    int pivotCandidateAbsIndex = bar_index - pivotCandidateRelativeIndex
    
    [leftStrength, rightStrength] = f_determinePivotStrength(pivotCandidateRelativeIndex, "low", f_maxStrength)
    int determinedStrength = math.min(leftStrength, rightStrength)
    
    if determinedStrength >= f_minStrength
        float pivotPrice = low[pivotCandidateRelativeIndex]
        int existingPivotIndex = -1
        if array.size(f_pivotLows) > 0
            for i = 0 to array.size(f_pivotLows) - 1
                if array.get(f_pivotLows, i).abs_index == pivotCandidateAbsIndex
                    existingPivotIndex := i
                    break

        if existingPivotIndex == -1
            pivotLowInfo newPivot = pivotLowInfo.new()
            newPivot.abs_index := pivotCandidateAbsIndex
            newPivot.price := pivotPrice
            newPivot.strength := determinedStrength
			newPivot.time := time[pivotCandidateRelativeIndex]
			// Calculate bars since last pivot
			int lastPivotIndex = array.size(f_pivotLows) > 0 ? array.get(f_pivotLows, array.size(f_pivotLows) - 1).abs_index : na
			newPivot.bars_since_last := not na(lastPivotIndex) ? newPivot.abs_index - lastPivotIndex : na
			// Amplitude from previous pivot
			float lastPivotPrice = array.size(f_pivotLows) > 0 ? array.get(f_pivotLows, array.size(f_pivotLows) - 1).price : na
			newPivot.amplitude := not na(lastPivotPrice) ? math.abs(newPivot.price - lastPivotPrice) : na

			// Initialize classification values
			newPivot.cycle_phase_id := ""
			newPivot.is_confirmed := false
            
            label labelToPush = na
            if f_showLabels
                color plotColor = f_getPlotColorForStrength(determinedStrength)
                string strengthText = str.tostring(determinedStrength)
                labelToPush := label.new(x=newPivot.abs_index, y=newPivot.price, text="↟ \n" + strengthText, xloc=xloc.bar_index, yloc=yloc.belowbar, style=label.style_none, color=plotColor, textcolor=plotColor, size=size.normal, tooltip="Pivot Low (AbsIdx: " + str.tostring(newPivot.abs_index) + ", Strength: " + strengthText + ")")
            newPivot.label_id := labelToPush
            array.push(f_pivotLows, newPivot)
        else
            pivotLowInfo existingPivot = array.get(f_pivotLows, existingPivotIndex)
            if determinedStrength > existingPivot.strength or (determinedStrength == existingPivot.strength and pivotPrice < existingPivot.price)
                f_updateExistingPivotLow(f_pivotLows, existingPivotIndex, determinedStrength, f_showLabels)

// @function Finds and processes pivot highs.
// @param f_pivotHighs The array of pivotHighInfo objects to read from and modify.
// @param f_minStrength Minimum strength required for a new pivot to be recorded.
// @param f_maxStrength Maximum strength to search for when determining pivot strength.
// @param f_showLabels A boolean to control if new labels should be created.
export f_findPivotHighs(array<pivotHighInfo> f_pivotHighs, int f_minStrength, int f_maxStrength, bool f_showLabels) =>
    if array.size(f_pivotHighs) > 0
        for i = array.size(f_pivotHighs) - 1 to 0
            pivotHighInfo currentPivot = array.get(f_pivotHighs, i)
            int pivotRelativeIndex = bar_index - currentPivot.abs_index
            if pivotRelativeIndex > f_maxStrength + 1 or pivotRelativeIndex < 0 
                continue
            
            [newLeftStrength, newRightStrength] = f_determinePivotStrength(pivotRelativeIndex, "high", f_maxStrength)
            int newStrength = math.min(newLeftStrength, newRightStrength)
            
            if newStrength > currentPivot.strength
                f_updateExistingPivotHigh(f_pivotHighs, i, newStrength, f_showLabels)

    int pivotCandidateRelativeIndex = f_minStrength 
    int pivotCandidateAbsIndex = bar_index - pivotCandidateRelativeIndex
    
    [leftStrength, rightStrength] = f_determinePivotStrength(pivotCandidateRelativeIndex, "high", f_maxStrength)
    int determinedStrength = math.min(leftStrength, rightStrength)
    
    if determinedStrength >= f_minStrength
        float pivotPrice = high[pivotCandidateRelativeIndex]
        int existingPivotIndex = -1
        if array.size(f_pivotHighs) > 0
            for i = 0 to array.size(f_pivotHighs) - 1
                if array.get(f_pivotHighs, i).abs_index == pivotCandidateAbsIndex
                    existingPivotIndex := i
                    break

        if existingPivotIndex == -1
            pivotHighInfo newPivot = pivotHighInfo.new()
            newPivot.abs_index := pivotCandidateAbsIndex
            newPivot.price := pivotPrice
            newPivot.strength := determinedStrength
			newPivot.time := time[pivotCandidateRelativeIndex]
			// Assign bars_since_last and amplitude to mirror lows
			int lastHighIndex = array.size(f_pivotHighs) > 0 ? array.get(f_pivotHighs, array.size(f_pivotHighs) - 1).abs_index : na
			newPivot.bars_since_last := not na(lastHighIndex) ? newPivot.abs_index - lastHighIndex : na
			float lastHighPrice = array.size(f_pivotHighs) > 0 ? array.get(f_pivotHighs, array.size(f_pivotHighs) - 1).price : na
			newPivot.amplitude := not na(lastHighPrice) ? math.abs(newPivot.price - lastHighPrice) : na
			newPivot.cycle_phase_id := ""
			newPivot.is_confirmed := false				

            
            label labelToPush = na
            if f_showLabels
                color plotColor = f_getPlotColorForStrength(determinedStrength)
                string strengthText = str.tostring(determinedStrength)
                labelToPush := label.new(x=newPivot.abs_index, y=newPivot.price, text="↡ \n" + strengthText, xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_none, color=plotColor, textcolor=plotColor, size=size.normal, tooltip="Pivot High (AbsIdx: " + str.tostring(newPivot.abs_index) + ", Strength: " + strengthText + ")")
            newPivot.label_id := labelToPush
            array.push(f_pivotHighs, newPivot)
        else
            pivotHighInfo existingPivot = array.get(f_pivotHighs, existingPivotIndex)
            if determinedStrength > existingPivot.strength or (determinedStrength == existingPivot.strength and pivotPrice > existingPivot.price)
                f_updateExistingPivotHigh(f_pivotHighs, existingPivotIndex, determinedStrength, f_showLabels)
