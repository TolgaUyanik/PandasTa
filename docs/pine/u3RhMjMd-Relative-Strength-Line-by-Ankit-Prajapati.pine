//@version=5
indicator("Relative Strength Line (0–100 Scale)", overlay=false)

// === User Inputs ===
benchmarkSymbol = input.symbol("NSE:NIFTY", "Benchmark Index (e.g., NIFTY, BANKNIFTY, NIFTY500)")
length = input.int(100, "RS Window Length", minval=10, maxval=500)

// === Benchmark Close Price ===
benchmarkClose = request.security(benchmarkSymbol, timeframe.period, close)

// === RS Line Calculation ===
rsLine = close / benchmarkClose

// === Normalization to 0–100 ===
lowestRS = ta.lowest(rsLine, length)
highestRS = ta.highest(rsLine, length)
rsNormalized = 100 * (rsLine - lowestRS) / (highestRS - lowestRS)

// === Plotting ===
plot(rsNormalized, title = "Relative Strength (0–100)", color = color.orange, linewidth = 2)
hline(70, "Leadership Zone (70+)", color = color.green)
hline(50, "Neutral Zone (50)", color = color.gray)
hline(30, "Weak Zone (<30)", color = color.red)



