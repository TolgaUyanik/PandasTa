//@version=6
indicator("Session Time Lines (DE)", overlay=true, max_lines_count=500)

tz         = input.string("Europe/Berlin", "Timezone")
lineColor  = input.color(color.new(color.gray, 0), "Line Color")
lineWidth  = input.int(1, "Line Width", minval=1, maxval=4)
rollNext   = input.bool(true, "Auf naechsten Tag rollen wenn heute alles vorbei")

show08   = input.bool(true, "08:00")
show09   = input.bool(true, "09:00")
show1030 = input.bool(true, "10:30")
show1230 = input.bool(true, "12:30")
show14   = input.bool(true, "14:00")
show15   = input.bool(true, "15:00")

var line ln08   = na
var line ln09   = na
var line ln1030 = na
var line ln1230 = na
var line ln14   = na
var line ln15   = na

manage(bool enabled, int targetTime, int nowTime, line prevLine) =>
    line.delete(prevLine)
    line result = na
    if enabled and nowTime < targetTime
        result := line.new(x1=targetTime, y1=0, x2=targetTime, y2=1, xloc=xloc.bar_time, extend=extend.both, color=lineColor, style=line.style_dashed, width=lineWidth)
    result

if barstate.islast
    nowTime = time

    y  = year(nowTime, tz)
    mo = month(nowTime, tz)
    d  = dayofmonth(nowTime, tz)

    dayOffsetMs = 24 * 60 * 60 * 1000

    t08_today   = timestamp(tz, y, mo, d,  8,  0)
    t09_today   = timestamp(tz, y, mo, d,  9,  0)
    t1030_today = timestamp(tz, y, mo, d, 10, 30)
    t1230_today = timestamp(tz, y, mo, d, 12, 30)
    t14_today   = timestamp(tz, y, mo, d, 14,  0)
    t15_today   = timestamp(tz, y, mo, d, 15,  0)

    lastTarget = math.max(show08 ? t08_today : 0, show09 ? t09_today : 0, show1030 ? t1030_today : 0, show1230 ? t1230_today : 0, show14 ? t14_today : 0, show15 ? t15_today : 0)
    rolled = rollNext and lastTarget > 0 and nowTime >= lastTarget

    offset = rolled ? dayOffsetMs : 0

    t08   = t08_today   + offset
    t09   = t09_today   + offset
    t1030 = t1030_today + offset
    t1230 = t1230_today + offset
    t14   = t14_today   + offset
    t15   = t15_today   + offset

    ln08   := manage(show08,   t08,   nowTime, ln08)
    ln09   := manage(show09,   t09,   nowTime, ln09)
    ln1030 := manage(show1030, t1030, nowTime, ln1030)
    ln1230 := manage(show1230, t1230, nowTime, ln1230)
    ln14   := manage(show14,   t14,   nowTime, ln14)
    ln15   := manage(show15,   t15,   nowTime, ln15)
