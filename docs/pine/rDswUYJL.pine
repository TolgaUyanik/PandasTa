//@version=6

// @description TODO: add library description here
library("SessionRangeLibrary", overlay = true)

export type Data
	float drh
	float drl
	float idrh
	float idrl
	float mid

updateDRH(Data data) =>
	if (na(data.drh))
		data.drh:= high
	else
		data.drh:= math.max(data.drh, high)

updateDRL(Data data) =>
	if (na(data.drl))
		data.drl:= low
	else
		data.drl:= math.min(data.drl, low)

updateIDRH(Data data) =>
	if (na(data.idrh))
		data.idrh:= close
	else
		data.idrh:= math.max(data.idrh, close)

updateIDRL(Data data) =>
	if (na(data.idrl))
		data.idrl:= close
	else
		data.idrl:= math.min(data.idrl, close)

updateMid(Data data) =>
	data.mid:= data.idrh - (data.idrh - data.idrl) / 2 

export update(string session) =>
	var Data data = na
	isSessionValid = not na(time('', session))
	isFirstBar = isSessionValid and not isSessionValid[1]
	isLastBar = isSessionValid[1] and not isSessionValid
	if (isFirstBar)
		data:= Data.new()
	if (isSessionValid)
		updateDRH(data)
		updateDRL(data)
		updateIDRH(data)
		updateIDRL(data)
	if (isLastBar)
		updateMid(data)
		data
	else
		na

