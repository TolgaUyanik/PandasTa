//@version=6
indicator("Percentage Price Oscillator Navigator [MarkitTick]", overlay = false, max_labels_count = 500)

// ── INPUTS ─────────────────────────────────────────────────────
var string GRP_CORE = "⚙️ Core"
i_fastLen   = input.int(12, "Fast Len", minval = 1, group = GRP_CORE)
i_slowLen   = input.int(26, "Slow Len", minval = 1, group = GRP_CORE)
i_sigLen    = input.int(9,  "Signal Len", minval = 1, group = GRP_CORE)
i_maType    = input.string("EMA", "MA Type", options = ["EMA", "SMA"], group = GRP_CORE)
i_src       = input.source(close, "Source", group = GRP_CORE)

var string GRP_FILT = "🕯️ Filters"
i_useHtf    = input.bool(false, "HTF Confirm", group = GRP_FILT)
i_htf       = input.timeframe("240", "HTF", group = GRP_FILT)
i_useAdx    = input.bool(false, "ADX Strength Filter", group = GRP_FILT)
i_adxLen    = input.int(14, "ADX Len", minval = 1, group = GRP_FILT)
i_adxMin    = input.float(20.0, "ADX Min", minval = 0, group = GRP_FILT)
i_useVola   = input.bool(false, "Volatility Filter", group = GRP_FILT)
i_atrLen    = input.int(14, "ATR Len", minval = 1, group = GRP_FILT)
i_atrMult   = input.float(1.0, "ATR Min Mult (vs Avg)", minval = 0.1, step = 0.1, group = GRP_FILT)
i_useVol    = input.bool(false, "Volume Filter", group = GRP_FILT)
i_volLen    = input.int(20, "Vol MA Len", minval = 1, group = GRP_FILT)
i_volMult   = input.float(1.0, "Vol Min Mult (vs Avg)", minval = 0.1, step = 0.1, group = GRP_FILT)
i_useSlope  = input.bool(false, "Histogram Slope Filter", group = GRP_FILT)
i_slopeBars = input.int(2, "Slope Confirm Bars", minval = 1, group = GRP_FILT)

var string GRP_TRADE = "📐 Trade Tools"
i_lockSignal = input.bool(false, "🔒 Lock Signal", group = GRP_TRADE, tooltip = "Freeze current signal · block new ones")
i_slAtrMult  = input.float(1.5, "SL ATR Mult", minval = 0.1, step = 0.1, group = GRP_TRADE)
i_tp1RR      = input.float(1.0, "TP1 R:R", minval = 0.1, step = 0.1, group = GRP_TRADE)
i_tp2RR      = input.float(2.0, "TP2 R:R", minval = 0.1, step = 0.1, group = GRP_TRADE)
i_tp3RR      = input.float(3.0, "TP3 R:R", minval = 0.1, step = 0.1, group = GRP_TRADE)
i_extBars    = input.int(50, "Extend Bars", minval = 10, group = GRP_TRADE)

var string GRP_VIS = "🎨 Visuals"
i_showHist  = input.bool(true, "Show Histogram", group = GRP_VIS)
i_showZero  = input.bool(true, "Show Zero Line", group = GRP_VIS)
i_showCandles = input.bool(true, "Heatmap Candles", group = GRP_VIS)
i_showChartSignals = input.bool(true, "Chart Signals", group = GRP_VIS)
i_showLevels = input.bool(true, "Show Trade Levels", group = GRP_VIS)

var string GRP_DASH = "📊 Dashboard"
i_showDash  = input.bool(true, "Show Dashboard", group = GRP_DASH)
i_dashPos   = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = GRP_DASH)

var string GRP_WH = "🔔 Alerts"
i_actionBull = input.string("ppo_bull", "↑ Bull Cross Action", group = GRP_WH)
i_actionBear = input.string("ppo_bear", "↓ Bear Cross Action", group = GRP_WH)
i_actionZeroUp = input.string("ppo_zero_up", "0+ Zero Cross Up Action", group = GRP_WH)
i_actionZeroDn = input.string("ppo_zero_dn", "0- Zero Cross Dn Action", group = GRP_WH)
i_actionTp1  = input.string("tp1_hit", "◆ TP1 Hit Action", group = GRP_WH)
i_actionTp2  = input.string("tp2_hit", "✦ TP2 Hit Action", group = GRP_WH)
i_actionTp3  = input.string("tp3_hit", "◆ TP3 Hit Action", group = GRP_WH)

var string GRP_COL = "🌈 Colors"
c_ppoLine   = input.color(#2196f3, "PPO Line", group = GRP_COL)
c_sigLine   = input.color(#ff9800, "Signal Line", group = GRP_COL)
c_histPos   = input.color(color.new(#26a69a, 0), "Hist Pos", group = GRP_COL)
c_histPosW  = input.color(color.new(#26a69a, 60), "Hist Pos Weak", group = GRP_COL)
c_histNeg   = input.color(color.new(#ef5350, 0), "Hist Neg", group = GRP_COL)
c_histNegW  = input.color(color.new(#ef5350, 60), "Hist Neg Weak", group = GRP_COL)
_mt741b  = input.color(color.new(#787b86, 50), "Zero Line", group = GRP_COL)
c_candleBull = input.color(#26a69a, "Candle Bull", group = GRP_COL)
c_candleBear = input.color(#ef5350, "Candle Bear", group = GRP_COL)
c_candleNeut = input.color(#787b86, "Candle Neutral", group = GRP_COL)
c_slColor   = input.color(#ef5350, "SL Line", group = GRP_COL)
c_entryColor = input.color(#2196f3, "Entry Line", group = GRP_COL)
c_tp1Color  = input.color(color.new(#26a69a, 40), "TP1 Line", group = GRP_COL)
c_tp2Color  = input.color(color.new(#26a69a, 20), "TP2 Line", group = GRP_COL)
c_tp3Color  = input.color(color.new(#26a69a, 0),  "TP3 Line", group = GRP_COL)
c_riskFill  = input.color(color.new(#ef5350, 80), "Risk Fill", group = GRP_COL)
c_rewardFill = input.color(color.new(#26a69a, 85), "Reward Fill", group = GRP_COL)
C_DASH_HDR  = input.color(color.new(#3a2a6d, 55), "Dash Header", group = GRP_COL)
_mt741a   = input.color(color.new(#0a0f1a, 10), "Dash BG", group = GRP_COL)
C_DASH_TXT  = input.color(color.new(#ffffff, 0), "Dash Text", group = GRP_COL)
C_SUP       = input.color(#26a69a, "Bull Value", group = GRP_COL)
C_RES       = input.color(#ef5350, "Bear Value", group = GRP_COL)

// ── CORE LOGIC ─────────────────────────────────────────────────
f_ma(float src, int len, string t) =>
    float _ema = ta.ema(src, len)
    float _sma = ta.sma(src, len)
    t == "EMA" ? _ema : _sma

fastMa = f_ma(i_src, i_fastLen, i_maType)
slowMa = f_ma(i_src, i_slowLen, i_maType)
ppo    = 100 * (fastMa - slowMa) / slowMa
sig    = f_ma(ppo, i_sigLen, i_maType)
hist   = ppo - sig

htfPpoRaw = request.security(syminfo.tickerid, i_htf, ppo[1], lookahead = barmerge.lookahead_on)
htfConfirmBull = not i_useHtf or htfPpoRaw > 0
htfConfirmBear = not i_useHtf or htfPpoRaw < 0

[_diPlus, _diMinus, adxVal] = ta.dmi(i_adxLen, i_adxLen)
adxOk = not i_useAdx or adxVal >= i_adxMin

atrVal = ta.atr(i_atrLen)
atrAvg = ta.sma(atrVal, i_atrLen)
volaOk = not i_useVola or atrVal >= atrAvg * i_atrMult

volAvg = ta.sma(volume, i_volLen)
volOk = not i_useVol or volume >= volAvg * i_volMult

histRising = hist > hist[1]
histFallingConfirmed = ta.falling(hist, i_slopeBars)
histRisingConfirmed  = ta.rising(hist, i_slopeBars)
slopeOkBull = not i_useSlope or histRisingConfirmed
slopeOkBear = not i_useSlope or histFallingConfirmed

smartFilterBull = adxOk and volaOk and volOk and slopeOkBull
smartFilterBear = adxOk and volaOk and volOk and slopeOkBear

bullCross = ta.crossover(ppo, sig) and htfConfirmBull and smartFilterBull and barstate.isconfirmed
bearCross = ta.crossunder(ppo, sig) and htfConfirmBear and smartFilterBear and barstate.isconfirmed
zeroCrossUp = ta.crossover(ppo, 0) and barstate.isconfirmed
zeroCrossDn = ta.crossunder(ppo, 0) and barstate.isconfirmed

histColor = hist >= 0 ? (histRising ? c_histPos : c_histPosW) : (histRising ? c_histNeg : c_histNegW)

var bool inLongTrade  = false
var bool inShortTrade = false
var float entryPrice = na
var float slPrice    = na
var float tp1Price   = na
var float tp2Price   = na
var float tp3Price   = na
var int   lastSignalBar = na

bool _locked = i_lockSignal and barstate.islast

atrForLevels = ta.atr(i_atrLen)
bool newLongSignal  = bullCross and not _locked
bool newShortSignal = bearCross and not _locked

if newLongSignal
    entryPrice := close[1]
    slPrice    := entryPrice - atrForLevels * i_slAtrMult
    float _risk = entryPrice - slPrice
    tp1Price   := entryPrice + _risk * i_tp1RR
    tp2Price   := entryPrice + _risk * i_tp2RR
    tp3Price   := entryPrice + _risk * i_tp3RR
    inLongTrade  := true
    inShortTrade := false
    lastSignalBar := bar_index

if newShortSignal
    entryPrice := close[1]
    slPrice    := entryPrice + atrForLevels * i_slAtrMult
    float _risk = slPrice - entryPrice
    tp1Price   := entryPrice - _risk * i_tp1RR
    tp2Price   := entryPrice - _risk * i_tp2RR
    tp3Price   := entryPrice - _risk * i_tp3RR
    inShortTrade := true
    inLongTrade  := false
    lastSignalBar := bar_index

bool tp1Hit = inLongTrade and not na(tp1Price) ? high >= tp1Price : inShortTrade and not na(tp1Price) ? low <= tp1Price : false
bool tp2Hit = inLongTrade and not na(tp2Price) ? high >= tp2Price : inShortTrade and not na(tp2Price) ? low <= tp2Price : false
bool tp3Hit = inLongTrade and not na(tp3Price) ? high >= tp3Price : inShortTrade and not na(tp3Price) ? low <= tp3Price : false

candleBull = hist >= 0
candleColor = histColor
candleWick  = candleBull ? c_candleBull : c_candleBear
candleBorder = candleBull ? c_candleBull : c_candleBear

// ── ALERTS ─────────────────────────────────────────────────────
string _bullInner = str.format(
     '"action":"{0}","ticker":"{1}","tf":"{2}","direction":"long","ppo":"{3}","signal":"{4}"',
     i_actionBull, syminfo.tickerid, timeframe.period,
     str.tostring(ppo, "#.####"), str.tostring(sig, "#.####"))
string bullPayload = "{" + _bullInner + "}"

string _bearInner = str.format(
     '"action":"{0}","ticker":"{1}","tf":"{2}","direction":"short","ppo":"{3}","signal":"{4}"',
     i_actionBear, syminfo.tickerid, timeframe.period,
     str.tostring(ppo, "#.####"), str.tostring(sig, "#.####"))
string bearPayload = "{" + _bearInner + "}"

string _zeroUpInner = str.format(
     '"action":"{0}","ticker":"{1}","tf":"{2}","ppo":"{3}"',
     i_actionZeroUp, syminfo.tickerid, timeframe.period, str.tostring(ppo, "#.####"))
string zeroUpPayload = "{" + _zeroUpInner + "}"

string _zeroDnInner = str.format(
     '"action":"{0}","ticker":"{1}","tf":"{2}","ppo":"{3}"',
     i_actionZeroDn, syminfo.tickerid, timeframe.period, str.tostring(ppo, "#.####"))
string zeroDnPayload = "{" + _zeroDnInner + "}"

if bullCross and barstate.isconfirmed
    alert(bullPayload, alert.freq_once_per_bar_close)
if bearCross and barstate.isconfirmed
    alert(bearPayload, alert.freq_once_per_bar_close)
if zeroCrossUp and barstate.isconfirmed
    alert(zeroUpPayload, alert.freq_once_per_bar_close)
if zeroCrossDn and barstate.isconfirmed
    alert(zeroDnPayload, alert.freq_once_per_bar_close)

string _tp1Inner = str.format(
     '"action":"{0}","ticker":"{1}","tf":"{2}","tp":"{3}","entry":"{4}"',
     i_actionTp1, syminfo.tickerid, timeframe.period,
     str.tostring(tp1Price, format.mintick), str.tostring(entryPrice, format.mintick))
string tp1Payload = "{" + _tp1Inner + "}"

string _tp2Inner = str.format(
     '"action":"{0}","ticker":"{1}","tf":"{2}","tp":"{3}","entry":"{4}"',
     i_actionTp2, syminfo.tickerid, timeframe.period,
     str.tostring(tp2Price, format.mintick), str.tostring(entryPrice, format.mintick))
string tp2Payload = "{" + _tp2Inner + "}"

string _tp3Inner = str.format(
     '"action":"{0}","ticker":"{1}","tf":"{2}","tp":"{3}","entry":"{4}"',
     i_actionTp3, syminfo.tickerid, timeframe.period,
     str.tostring(tp3Price, format.mintick), str.tostring(entryPrice, format.mintick))
string tp3Payload = "{" + _tp3Inner + "}"

if tp1Hit
    alert(tp1Payload, alert.freq_once_per_bar)
if tp2Hit
    alert(tp2Payload, alert.freq_once_per_bar)
if tp3Hit
    alert(tp3Payload, alert.freq_once_per_bar)

alertcondition(bullCross    and barstate.isconfirmed, "PPO Bull Cross", "MarkitTick — PPO Bull Cross")
alertcondition(bearCross    and barstate.isconfirmed, "PPO Bear Cross", "MarkitTick — PPO Bear Cross")
alertcondition(zeroCrossUp  and barstate.isconfirmed, "PPO Zero Cross Up", "MarkitTick — PPO Zero Cross Up")
alertcondition(zeroCrossDn  and barstate.isconfirmed, "PPO Zero Cross Dn", "MarkitTick — PPO Zero Cross Dn")
alertcondition(tp1Hit, "TP1 Hit", "MarkitTick — TP1 Hit")
alertcondition(tp2Hit, "TP2 Hit", "MarkitTick — TP2 Hit")
alertcondition(tp3Hit, "TP3 Hit", "MarkitTick — TP3 Hit")

// ── VISUALS ────────────────────────────────────────────────────
plot(i_showZero ? 0 : na, "Zero", color = _mt741b, linewidth = 1)
plot(hist, "Histogram", color = i_showHist ? histColor : na, style = plot.style_columns)
plot(ppo, "PPO", color = c_ppoLine, linewidth = 2)
plot(sig, "Signal", color = c_sigLine, linewidth = 1)

plotshape(bullCross, "Bull Cross", shape.triangleup,   location.bottom, C_SUP, size = size.tiny)
plotshape(bearCross, "Bear Cross", shape.triangledown, location.top,    C_RES, size = size.tiny)

plotcandle(open, high, low, close,
 title       = "Heatmap Candles",
 color       = i_showCandles ? candleColor : na,
 wickcolor   = i_showCandles ? candleWick : na,
 bordercolor = i_showCandles ? candleBorder : na,
 force_overlay = true)

plotshape(i_showChartSignals and bullCross, "Chart Bull Signal", shape.triangleup,   location.belowbar, C_SUP, size = size.small, force_overlay = true)
plotshape(i_showChartSignals and bearCross, "Chart Bear Signal", shape.triangledown, location.abovebar, C_RES, size = size.small, force_overlay = true)

var line   slLine    = na
var line   entryLine = na
var line   tp1Line   = na
var line   tp2Line   = na
var line   tp3Line   = na
var label  slLbl     = na
var label  entryLbl  = na
var label  tp1Lbl    = na
var label  tp2Lbl    = na
var label  tp3Lbl    = na
var linefill riskFill   = na
var linefill rewardFill = na

f_deleteLevels() =>
    line.delete(slLine),   line.delete(entryLine)
    line.delete(tp1Line),  line.delete(tp2Line),  line.delete(tp3Line)
    label.delete(slLbl),   label.delete(entryLbl)
    label.delete(tp1Lbl),  label.delete(tp2Lbl),  label.delete(tp3Lbl)
    linefill.delete(riskFill), linefill.delete(rewardFill)

if i_showLevels and (newLongSignal or newShortSignal)
    f_deleteLevels()
    int _x2 = bar_index + i_extBars
    slLine    := line.new(bar_index, slPrice,    _x2, slPrice,    color = c_slColor,    style = line.style_solid,  width = 2, force_overlay = true)
    entryLine := line.new(bar_index, entryPrice, _x2, entryPrice, color = c_entryColor, style = line.style_dashed, width = 1, force_overlay = true)
    tp1Line   := line.new(bar_index, tp1Price,   _x2, tp1Price,   color = c_tp1Color,   style = line.style_dashed, width = 1, force_overlay = true)
    tp2Line   := line.new(bar_index, tp2Price,   _x2, tp2Price,   color = c_tp2Color,   style = line.style_dashed, width = 1, force_overlay = true)
    tp3Line   := line.new(bar_index, tp3Price,   _x2, tp3Price,   color = c_tp3Color,   style = line.style_dashed, width = 1, force_overlay = true)
    slLbl     := label.new(_x2, slPrice,    "✕ SL "    + str.tostring(slPrice,    format.mintick), style = label.style_label_left, color = c_slColor,    textcolor = #ffffff, size = size.small, force_overlay = true)
    entryLbl  := label.new(_x2, entryPrice, "▶ Entry " + str.tostring(entryPrice, format.mintick), style = label.style_label_left, color = c_entryColor, textcolor = #ffffff, size = size.small, force_overlay = true)
    tp1Lbl    := label.new(_x2, tp1Price,   "◆ TP1 "   + str.tostring(tp1Price,   format.mintick), style = label.style_label_left, color = c_tp1Color,   textcolor = #ffffff, size = size.small, force_overlay = true)
    tp2Lbl    := label.new(_x2, tp2Price,   "✦ TP2 "   + str.tostring(tp2Price,   format.mintick), style = label.style_label_left, color = c_tp2Color,   textcolor = #ffffff, size = size.small, force_overlay = true)
    tp3Lbl    := label.new(_x2, tp3Price,   "◆ TP3 "   + str.tostring(tp3Price,   format.mintick), style = label.style_label_left, color = c_tp3Color,   textcolor = #ffffff, size = size.small, force_overlay = true)
    riskFill   := linefill.new(slLine, entryLine, c_riskFill)
    rewardFill := linefill.new(entryLine, tp3Line, c_rewardFill)

if i_showLevels and not na(slLine) and (i_lockSignal or bar_index <= lastSignalBar + i_extBars)
    int _extX = i_lockSignal ? bar_index + i_extBars : lastSignalBar + i_extBars
    line.set_x2(slLine,    _extX)
    line.set_x2(entryLine, _extX)
    line.set_x2(tp1Line,   _extX)
    line.set_x2(tp2Line,   _extX)
    line.set_x2(tp3Line,   _extX)
    label.set_x(slLbl,     _extX)
    label.set_x(entryLbl,  _extX)
    label.set_x(tp1Lbl,    _extX)
    label.set_x(tp2Lbl,    _extX)
    label.set_x(tp3Lbl,    _extX)

// ── DASHBOARD ──────────────────────────────────────────────────
f_barColor(float pct) =>
    pct >= 0.66 ? color.new(#26a69a, 0) : pct >= 0.33 ? color.new(#f9a825, 0) : color.new(#ef5350, 0)

f_bar(float val, float maxVal) =>
    float pct = math.min(math.max(val / maxVal, 0.0), 1.0)
    int filled = math.round(pct * 10)
    string bar = ""
    for i = 1 to 10
        bar += i <= filled ? "█" : "░"
    bar + "  " + str.tostring(math.round(pct * 100)) + "%"

var string _mt741c = switch i_dashPos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left

var table dash = table.new(_mt741c, 2, 15, border_width = 1, border_color = color.new(#2a3040, 40), frame_width = 1, frame_color = color.new(#3a2a6d, 40))

if i_showDash
    row_a = _mt741a
    row_b = color.new(_mt741a, 40)
    lbl_col = color.new(C_DASH_TXT, 25)

    table.cell(dash, 0, 0, "PPO [MT]", text_color = C_DASH_TXT, bgcolor = C_DASH_HDR, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + "  ·  " + timeframe.period, text_color = C_DASH_TXT, bgcolor = C_DASH_HDR, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 1, "  Lock", text_color = lbl_col, bgcolor = row_a, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1, (i_lockSignal ? "ACTIVE  " : "OFF  "), text_color = i_lockSignal ? C_RES : C_DASH_TXT, bgcolor = row_a, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 2, "  PPO", text_color = lbl_col, bgcolor = row_b, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2, str.tostring(ppo, "#.####") + "  ", text_color = ppo >= 0 ? C_SUP : C_RES, bgcolor = row_b, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 3, "  Signal", text_color = lbl_col, bgcolor = row_a, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3, str.tostring(sig, "#.####") + "  ", text_color = sig >= 0 ? C_SUP : C_RES, bgcolor = row_a, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 4, "  Histogram", text_color = lbl_col, bgcolor = row_b, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 4, str.tostring(hist, "#.####") + "  ", text_color = hist >= 0 ? C_SUP : C_RES, bgcolor = row_b, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 5, "  Bias", text_color = lbl_col, bgcolor = row_a, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 5, (ppo > sig ? "BULL  " : ppo < sig ? "BEAR  " : "FLAT  "), text_color = ppo > sig ? C_SUP : ppo < sig ? C_RES : C_DASH_TXT, bgcolor = row_a, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 6, "  Zero Side", text_color = lbl_col, bgcolor = row_b, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 6, (ppo >= 0 ? "ABOVE  " : "BELOW  "), text_color = ppo >= 0 ? C_SUP : C_RES, bgcolor = row_b, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 7, "  Fast/Slow Gap", text_color = lbl_col, bgcolor = row_a, text_size = size.small, text_halign = text.align_left)
    float gapPct = slowMa != 0 ? math.abs(fastMa - slowMa) / slowMa * 100 : 0.0
    table.cell(dash, 1, 7, f_bar(gapPct, 5.0), text_color = f_barColor(math.min(gapPct / 5.0, 1.0)), bgcolor = row_a, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 8, "  HTF Confirm", text_color = lbl_col, bgcolor = row_b, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 8, (not i_useHtf ? "OFF  " : (htfPpoRaw > 0 ? "BULL  " : "BEAR  ")), text_color = not i_useHtf ? C_DASH_TXT : (htfPpoRaw > 0 ? C_SUP : C_RES), bgcolor = row_b, text_size = size.small, text_halign = text.align_right)

    bool anySmartFilter = i_useAdx or i_useVola or i_useVol or i_useSlope
    table.cell(dash, 0, 9, "  Smart Filters", text_color = lbl_col, bgcolor = row_a, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 9, (not anySmartFilter ? "OFF  " : (adxOk and volaOk and volOk ? "PASS  " : "BLOCK  ")), text_color = not anySmartFilter ? C_DASH_TXT : (adxOk and volaOk and volOk ? C_SUP : C_RES), bgcolor = row_a, text_size = size.small, text_halign = text.align_right)

    bool hasActiveTrade = not na(entryPrice)
    string dirTxt = inLongTrade ? "LONG  " : inShortTrade ? "SHORT  " : "—  "
    color  dirCol = inLongTrade ? C_SUP : inShortTrade ? C_RES : C_DASH_TXT
    table.cell(dash, 0, 10, "  Position", text_color = lbl_col, bgcolor = row_b, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 10, dirTxt, text_color = dirCol, bgcolor = row_b, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 11, "  Entry", text_color = lbl_col, bgcolor = row_a, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 11, (hasActiveTrade ? str.tostring(entryPrice, format.mintick) : "—") + "  ", text_color = C_DASH_TXT, bgcolor = row_a, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 12, "  SL", text_color = lbl_col, bgcolor = row_b, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 12, (hasActiveTrade ? str.tostring(slPrice, format.mintick) : "—") + "  ", text_color = C_RES, bgcolor = row_b, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 13, "  TP1 / TP2", text_color = lbl_col, bgcolor = row_a, text_size = size.small, text_halign = text.align_left)
    string tp12Txt = hasActiveTrade ? str.tostring(tp1Price, format.mintick) + " / " + str.tostring(tp2Price, format.mintick) : "—"
    table.cell(dash, 1, 13, tp12Txt + "  ", text_color = C_SUP, bgcolor = row_a, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 14, "  TP3", text_color = lbl_col, bgcolor = row_b, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 14, (hasActiveTrade ? str.tostring(tp3Price, format.mintick) : "—") + "  ", text_color = C_SUP, bgcolor = row_b, text_size = size.small, text_halign = text.align_right)
