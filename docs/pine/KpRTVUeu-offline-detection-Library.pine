//@version=5
// @description Creates alerts for the user-selected symbol by checking if its latest bar is current by comparing it against another chart.
library("offline_detection", overlay = true, dynamic_requests = true)

string tickerInput   = input.symbol("KRAKEN:BTCUSD", "Symbol to Check for Downtime", tooltip = "Does not affect library usage and is used as a visual representation.", display = display.none)
bool   showBgInput   = input.bool(false, "Show Example: Symbol Downtime Background Color")
bool   showWarnInput = input.bool(false, "Show Example: Warning Sign")

// @function Checks if 'sym' is offline by requesting time of 'sym'.
// @param sym (const string) The user-selected symbol in the form of "PREFIX:TICKER".
// @returns True if time of 'sym' is not available.
export isItDown(string sym) =>
    float checkSecurity = request.security(ticker.standard(sym), timeframe.period, time, barmerge.gaps_on)
    bool   isItDownBool = na(checkSecurity) ? true : false

// @function Checks if 'sym' is offline by requesting time of 'sym' once.
// @param sym (const string) The user-selected symbol in the form of "PREFIX:TICKER".
// @returns True if time of 'sym' is not available and it was available in the previous bar close.
export isItDownNoSpam(string sym) =>
    float checkSecurity = request.security(ticker.standard(sym), timeframe.period, time, barmerge.gaps_on)
    bool   isItDownBool = na(checkSecurity) and not na(checkSecurity)[1] ? true : false

// @function Checks if 'sym' is online after being offline by using isItDown().
// @param sym (const string) The user-selected symbol in the form of "PREFIX:TICKER".
// @returns True if time of 'sym' is available in the current bar but wasn't prior.
export isItUp(string sym) =>
    bool isItUpBool = not isItDown(sym) and isItDown(sym)[1]

// @function Checks if isItDown() is true.
// @param sym (const string) The user-selected symbol in the form of "PREFIX:TICKER".
// @returns An alert when the symbol is not online and the time in UTC. This will continue triggering every bar close until the symbol is online.
export offlineAlert(string sym) =>
    if isItDown(sym)
        alert(sym + " did not update at " + str.tostring(hour(time)) + ":" + str.tostring(minute(time)), alert.freq_once_per_bar_close)

// @function Checks if isItDown() is true.
// @param sym (const string) The user-selected symbol in the form of "PREFIX:TICKER".
// @returns An alert when the symbol is not online and the time in UTC.
export offlineAlertNoSpam(string sym) =>
    if isItDownNoSpam(sym)
        alert(sym + " did not update at " + str.tostring(hour(time)) + ":" + str.tostring(minute(time)), alert.freq_once_per_bar_close)

// @function Checks if isItUp() is true.
// @param sym (const string) The user-selected symbol in the form of "PREFIX:TICKER".
// @returns An alert when the symbol is now online and the time in UTC.
export onlineAlert(string sym) =>
    if isItDown(sym)
        alert(sym + " started updating at " + str.tostring(hour(time)) + ":" + str.tostring(minute(time)), alert.freq_once_per_bar_close)


// @function Checks if the current chart is "CRYPTOCAP:TOTAL".
// @returns  A reminder on the chart.
export warningsign() =>
    if ticker.standard(syminfo.tickerid) != "CRYPTOCAP:TOTAL" and barstate.islast
        label.new(bar_index + 3, close, "WARNING:\nThe current chart open is not CRYPTOCAP:TOTAL.\n
                                         Using CRYPTOCAP:TOTAL is preferred\n
                                         as it is not an exchange and is an aggregate.",
                                         xloc.bar_index, yloc.price, chart.bg_color, label.style_label_left, chart.fg_color, size.huge)


// These are examples when viewing the library directly
bgFun(bgCol) =>
    line.new(time, low, time, high, xloc.bar_time, extend.both, bgCol, line.style_solid, 10)
    
    // bgcolor(isItDown(tickerInput) ? color.new(color.maroon,90) : na)
    // bgcolor(isItUp(tickerInput) ? color.new(color.green,90) : na)
if showBgInput
    if isItDown(tickerInput)
        bgFun(color.new(color.gray, 90))
    if isItUp(tickerInput)
        bgFun(color.new(color.green, 90))

if showWarnInput
    warningsign()

// alert.freq cannot be modified because it changes into a series string from an input string in a function.
// string alertFreqInput = input.string(alert.freq_once_per_bar_close, "Alert Frequency", options = [alert.freq_once_per_bar, alert.freq_once_per_bar_close, alert.freq_all], 
//                           tooltip = "once_per_bar will trigger alerts whenever the condition is true.\n\n
//                                      once_per_bar_close will trigger alerts if the condition is true bar close.\n\n
//                                      all will trigger alerts continually when the condition is met. Kind of annoying.",
//                                      display = display.none)