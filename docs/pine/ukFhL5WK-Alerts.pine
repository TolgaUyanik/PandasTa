//@version=6
library("Alerts", true)

// Alerts Library
// v1, 2024.12.06

// This code was written using the recommendations from the Pine Script™ User Manual's Style Guide:
//    https://www.tradingview.com/pine-script-docs/writing/style-guide/



//#region ———————————————————— Library functions


// @function                Converts a "string" value to an "int", raising a runtime error if the value does not 
//                          represent a whole number. Exported functions use this function to validate "string" 
//                          lists specifying condition groups. 
// @param value             (series string) The value to convert. It must represent a whole number without fractional 
//                          parts. For example, `"0"` and `" 1"` are valid, but `"0.0"` and `" 1.1"` are not. 
// @param zeroIndex         (series bool) Optional. If `true`, a `value` of "0" represents the first array index. 
//                          If `false`, a `value` of "1" represents the first index. The default is `true`.
// @returns                 (int) An "int" representing an array index for retrieving conditional values.
indexFromString(series string value, series bool zeroIndex = true) =>
    int result = int(str.tonumber(value)) - (zeroIndex ? 0 : 1)
    if na(result) or str.contains(value, ".")
        runtime.error(
             "Invalid index in list: '" + value 
             + "'. The 'string' should be a comma-separated list of numerals representing valid 'int' array indices."
         )
    result


// @function                (Overload 1 of 2) Determines a compound condition based on selected elements from a 
//                          `conditions` array.
// @param conditions        (array<bool>) An array containing the possible "bool" values to use in the compound 
//                          condition. 
// @param indexList         (series string) A "string" containing a comma-separated list of whole numbers representing 
//                          the group of `conditions` elements to use in the compound condition. For example, if the 
//                          value is `"0, 2, 4"`, and `minRequired` is `na`, the function returns `true` only if the 
//                          `conditions` elements at index 0, 2, and 4 are all `true`. If the value is an empty 
//                          "string", the function returns `false`.
// @param minRequired       (series int) Optional. Determines the minimum number of selected conditions required to 
//                          activate the compound condition. For example, if the value is 2, the function returns 
//                          `true` if at least two of the specified `conditions` elements are `true`. If the value is 
//                          `na`, the function returns `true` only if all specified elements are `true`. 
//                          The default is `na`.
// @param zeroIndex         (series bool) Optional. Specifies whether the `indexList` represents zero-based array 
//                          indices. If `true`, a value of "0" in the list represents the first array index. If `false`, 
//                          a `value` of "1" represents the first index. The default is `true`.
// @returns                 (bool) `true` if `conditions` elements in the group specified by the `indexList` are 
//                          `true`, `false` otherwise.
export getCompoundCondition(
     array<bool> conditions, series string indexList, series int minRequired = na, series bool zeroIndex = true
 ) =>
    string trimmedList = str.trim(indexList)
    if str.endswith(trimmedList, ",")
        trimmedList := str.substring(trimmedList, 0, str.length(trimmedList) - 1)
    if na(minRequired)
        bool result = str.length(trimmedList) > 0
        if result
            for strIndex in str.split(trimmedList, ",")
                if not conditions.get(indexFromString(strIndex, zeroIndex))
                    result := false
                    break
        result
    else
        if minRequired < 0
            runtime.error("When specified, the `minRequired` parameter requires a value greater than or equal to 0.")
        bool result = minRequired == 0
        int  count  = 0
        array<string> splitList = str.split(trimmedList, ",")
        if not result and splitList.size() >= minRequired
            for strIndex in splitList
                if not result and conditions.get(indexFromString(strIndex, zeroIndex))
                    count += 1
                    if count == minRequired
                        result := true
                        break
        result


// @function                (Overload 2 of 2) Determines upward and downward compound conditions based on selected 
//                          elements from `upConditions` and `downConditions` arrays.
// @param upConditions      (array<bool>) An array containing the possible "bool" values to use in the upward 
//                          compound condition.
// @param downConditions    (array<bool>) An array containing the possible "bool" values to use in the downward 
//                          compound condition.
// @param indexList         (series string) A "string" containing a comma-separated list of whole numbers representing 
//                          the `upConditions` and `downConditions` elements to use in the compound conditions. For 
//                          example, if the value is `"0, 2, 4"` and `minRequired` is `na`, the function returns `true` 
//                          for the first value only if the `upConditions` elements at index 0, 2, and 4 are all `true`. 
//                          If the value is an empty "string", the function returns `[false, false]`.
// @param minRequired       (series int) Optional. Determines the minimum number of selected conditions required to 
//                          activate either compound condition. For example, if the value is 2, the function returns 
//                          `true` for its first value if at least two of the specified `upConditions` elements are 
//                          `true`. If the value is `na`, the function returns `true` only if all specified elements 
//                          are `true`. The default is `na`.
// @param allowUp           (series bool) Optional. Controls whether the function considers upward compound conditions. 
//                          If `false`, the function ignores the `upConditions` array, and the first item in the 
//                          returned tuple is `false`. The default is `true`.
// @param allowDown         (series bool) Optional. Controls whether the function considers downward compound 
//                          conditions. If `false`, the function ignores the `downConditions` array, and the second
//                          item in the returned tuple is `false`. The default is `true`.
// @param zeroIndex         (series bool) Optional. Specifies whether the `indexList` represents zero-based array 
//                          indices. If `true`, a value of "0" in the list represents the first array index. If `false`, 
//                          a value of "1" represents the first index. The default is `true`.
// @returns                 ([bool, bool]) A tuple containing two "bool" values representing the upward and downward 
//                          compound condition states, respectively. 
export getCompoundCondition(
     array<bool> upConditions, array<bool> downConditions, series string indexList, series int minRequired = na,
     series bool allowUp = true, series bool allowDown = true, series bool zeroIndex = true
 ) =>
    string trimmedList = str.trim(indexList)
    if str.endswith(trimmedList, ",")
        trimmedList := str.substring(trimmedList, 0, str.length(trimmedList) - 1)
    if na(minRequired)
        bool notEmpty   = str.length(trimmedList) > 0
        bool upResult   = allowUp   and notEmpty
        bool downResult = allowDown and notEmpty
        if notEmpty
            for strIndex in str.split(trimmedList, ",")
                int indexNum = indexFromString(strIndex, zeroIndex)
                if upResult and not upConditions.get(indexNum)
                    upResult := false
                    if not downResult
                        break
                if downResult and not downConditions.get(indexNum)
                    downResult := false
                    if not upResult
                        break
        [upResult, downResult]
    else
        if minRequired < 0
            runtime.error("When specified, the `minRequired` parameter requires a value greater than or equal to 0.")
        bool upResult   = allowUp   and minRequired == 0
        bool downResult = allowDown and minRequired == 0
        int  upCount    = 0
        int  downCount  = 0
        array<string> splitList = str.split(trimmedList, ",")
        if not upResult and splitList.size() >= minRequired
            for strIndex in splitList
                int indexNum = indexFromString(strIndex, zeroIndex)
                if allowUp and not upResult and upConditions.get(indexNum)
                    upCount += 1
                    if upCount == minRequired
                        upResult := true
                        if downResult or not allowDown
                            break
                if allowDown and not downResult and downConditions.get(indexNum)
                    downCount += 1
                    if downCount == minRequired
                        downResult := true
                        if upResult or not allowUp
                            break
        [upResult, downResult]


// @function                (Overload 1 of 2) Creates an array of "bool" values representing compound conditions formed 
//                          by selected elements from a `conditions` array.
// @param conditions        (array<bool>) An array containing the possible "bool" values to use in each compound 
//                          condition.
// @param indexLists        (array<string>) An array of strings containing comma-separated lists of whole numbers 
//                          representing the `conditions` elements to use in each compound condition. For example, 
//                          if an item is `"0, 2, 4"`, the corresponding item in the returned array is `true` 
//                          only if the `conditions` elements at index 0, 2, and 4 are all `true`. If an item is an 
//                          empty "string", the item in the returned array is `false`.
// @param zeroIndex         (series bool) Optional. Specifies whether the "string" lists in the `indexLists` represent 
//                          zero-based array indices. If `true`, a value of "0" in a list represents the first array 
//                          index. If `false`, a value of "1" represents the first index. The default is `true`.
// @returns                 (array<bool>) An array of "bool" values representing compound condition states for each 
//                          condition group. An item in the array is `true` only if all the `conditions` elements 
//                          specified by the corresponding `indexLists` item are `true`. Otherwise, the item is `false`.
export getCompoundConditionsArray(array<bool> conditions, array<string> indexLists, series bool zeroIndex = true) =>
    array<bool> result = array.new<bool>()
    for list in indexLists
        result.push(getCompoundCondition(conditions, list, zeroIndex = zeroIndex))
    result


// @function                (Overload 2 of 2) Creates two arrays of "bool" values representing compound upward and 
//                          downward conditions formed by selected elements from `upConditions` and `downConditions` 
//                          arrays. 
// @param upConditions      (array<bool>) An array containing the possible "bool" values to use in each upward 
//                          compound condition.
// @param downConditions    (array<bool>) An array containing the possible "bool" values to use in each downward 
//                          compound condition.
// @param indexLists        (array<string>) An array of strings containing comma-separated lists of whole numbers 
//                          representing the `upConditions` and `downConditions` elements to use in each compound 
//                          condition. For example, if an item is `"0, 2, 4"`, the corresponding item in the first 
//                          returned array is `true` only if the `upConditions` elements at index 0, 2, and 4 are all 
//                          `true`. If an item is an empty "string", the items in both returned arrays are `false`.
// @param allowUp           (series bool) Optional. Controls whether the function considers upward compound conditions. 
//                          If `false`, the function ignores the `upConditions` array, and all elements in the first 
//                          returned array are `false`. The default is `true`.
// @param allowDown         (series bool) Optional. Controls whether the function considers downward compound 
//                          conditions. If `false`, the function ignores the `downConditions` array, and all elements 
//                          in the second returned array are `false`. The default is `true`.
// @param zeroIndex         (series bool) Optional. Specifies whether the "string" lists in the `indexLists` represent 
//                          zero-based array indices. If `true`, a value of "0" in a list represents the first array 
//                          index. If `false`, a value of "1" represents the first index. The default is `true`.
// @returns                 ([array<bool>, array<bool>]) A tuple containing two "bool" arrays:
//                          - The first array contains values representing upward compound condition states determined 
//                            using the `upConditions`.
//                          - The second array contains values representing downward compound condition states 
//                            determined using the `downConditions`. 
export getCompoundConditionsArray(
     array<bool> upConditions, array<bool> downConditions, array<string> indexLists, 
     series bool allowUp = true, series bool allowDown = true, series bool zeroIndex = true
 ) =>
    int numGroups = indexLists.size()
    array<bool> upResult   = array.new<bool>(allowUp   ? 0 : numGroups)
    array<bool> downResult = array.new<bool>(allowDown ? 0 : numGroups)
    if allowUp and allowDown
        for list in indexLists
            [upCond, downCond] = getCompoundCondition(upConditions, downConditions, list, zeroIndex = zeroIndex)
            upResult.push(upCond)
            downResult.push(downCond)
    else if allowUp
        for list in indexLists
            bool upCond = getCompoundCondition(upConditions, list, zeroIndex = zeroIndex)
            upResult.push(upCond)
    else if allowDown
        for list in indexLists
            bool downCond = getCompoundCondition(downConditions, list, zeroIndex = zeroIndex)
            downResult.push(downCond)
    [upResult, downResult]


// @function                (Overload 1 of 2) Creates a "string" message containing a comma-separated list of markers 
//                          representing active compound conditions formed by specified element groups from a 
//                          `conditions` array. 
// @param conditions        (array<bool>) An array containing the possible "bool" values to use in each compound 
//                          condition.
// @param indexLists        (array<string>) An array of strings containing comma-separated lists of whole numbers 
//                          representing the `conditions` elements to use in each compound condition. For example, 
//                          if an item is `"0, 2, 4"`, the corresponding marker for that item appears in the returned 
//                          "string" only if the `conditions` elements at index 0, 2, and 4 are all `true`.
// @param zeroIndex         (series bool) Optional. Specifies whether the "string" lists in the `indexLists` represent 
//                          zero-based array indices. If `true`, a value of "0" in a list represents the first array 
//                          index. If `false`, a value of "1" represents the first index. The default is `true`.
// @param groupMarkers      (array<string>) Optional. If specified, sets the marker (name) for each condition group 
//                          specified in the `indexLists` array. If `na`, the function uses the format `"M<x>"` for 
//                          each group, where "M" is short for "Marker" and `<x>` represents the one-based index for  
//                          the group (e.g., the marker for the first listed group is "M1"). The default is `na`.
// @returns                 (string) A "string" containing a list of markers corresponding to each active compound 
//                          condition.
export compoundAlertMessage(
     array<bool> conditions, array<string> indexLists, series bool zeroIndex = true, array<string> groupMarkers = na
 ) =>
    bool useDefaultNames = na(groupMarkers)
    if not useDefaultNames ? indexLists.size() != groupMarkers.size() : false
        runtime.error(
             "When the `groupMarkers` argument is not `na`, it must be an array with the same number of elements as the 
             `indexLists` array, one for each condition group."
         )
    string result = ""
    for [i, list] in indexLists
        if not getCompoundCondition(conditions, list, zeroIndex = zeroIndex)
            continue
        result += (useDefaultNames ? "M" + str.tostring(i + 1) : groupMarkers.get(i)) + ", "
    if result != ""
        result := str.substring(result, 0, str.length(result) - 2)
    result


// @function                (Overload 2 of 2) Creates two "string" messages containing comma-separated lists of markers 
//                          representing active upward and downward compound conditions formed by specified element 
//                          groups from `upConditions` and `downConditions` arrays. 
// @param upConditions      (array<bool>) An array containing the possible "bool" values to use in each upward 
//                          compound condition.
// @param downConditions    (array<bool>) An array containing the possible "bool" values to use in each downward 
//                          compound condition.
// @param indexLists        (array<string>) An array of strings containing comma-separated lists of whole numbers 
//                          representing the `upConditions` and `downConditions` element groups to use in each compound 
//                          condition. For example, if an item is `"0, 2, 4"`, the corresponding group marker for that 
//                          item appears in the first returned "string" only if the `upConditions` elements at index 0, 
//                          2, and 4 are all `true`.
// @param allowUp           (series bool) Optional. Controls whether the function considers upward compound conditions. 
//                          If `false`, the function ignores the `upConditions` array, and all elements in the first 
//                          returned array are `false`. The default is `true`.
// @param allowDown         (series bool) Optional. Controls whether the function considers downward compound 
//                          conditions. If `false`, the function ignores the `downConditions` array, and all elements 
//                          in the second returned array are `false`. The default is `true`.
// @param zeroIndex         (series bool) Optional. Specifies whether the "string" lists in the `indexLists` represent 
//                          zero-based array indices. If `true`, a value of "0" in a list represents the first array 
//                          index. If `false`, a value of "1" represents the first index. The default is `true`.
// @param groupMarkers      (array<string>) Optional. If specified, sets the name (marker) of each condition group 
//                          specified in the `indexLists` array. If `na`, the function uses the format `"M<x>"` for 
//                          each group, where "M" is short for "Marker" and `<x>` represents the one-based index for  
//                          the group (e.g., the marker for the first listed group is "M1"). The default is `na`.
// @param upChar            (series string) Optional. A "string" appended to all group markers for upward conditions to 
//                          signify direction. The default is "▲".
// @param downChar          (series string) Optional. A "string" appended to all group markers for downward conditions 
//                          to signify direction. The default is "▼".
// @returns                 ([string, string]) A tuple of "string" values containing lists of markers corresponding to 
//                          active upward and downward compound conditions, respectively. 
export compoundAlertMessage(
     array<bool> upConditions, array<bool> downConditions, array<string> indexLists, 
     series bool allowUp = true, series bool allowDown = true, series bool zeroIndex = true, 
     array<string> groupMarkers = na, series string upChar = "▲", series string downChar = "▼"
 ) =>
    bool useDefaultNames = na(groupMarkers)
    if not useDefaultNames ? indexLists.size() != groupMarkers.size() : false
        runtime.error(
             "When the `groupMarkers` argument is not `na`, it must be an array with the same number of elements as the 
             `indexLists` array, one for each condition group."
         )
    string upResult   = ""
    string downResult = ""
    if allowUp and allowDown
        for [i, list] in indexLists
            [upCond, downCond] = getCompoundCondition(upConditions, downConditions, list, zeroIndex = zeroIndex)
            if not (upCond or downCond)
                continue
            string groupText = useDefaultNames ? "M" + str.tostring(i + 1) : groupMarkers.get(i)
            if upCond
                upResult += groupText + upChar + ", "
            if downCond
                downResult += groupText + downChar + ", "
    else if allowUp
        for [i, list] in indexLists
            if not getCompoundCondition(upConditions, list, zeroIndex = zeroIndex)
                continue
            upResult += (useDefaultNames ? "M" + str.tostring(i + 1) : groupMarkers.get(i)) + upChar + ", "
    else if allowDown
        for [i, list] in indexLists
            if not getCompoundCondition(downConditions, list, zeroIndex = zeroIndex)
                continue
            downResult += (useDefaultNames ? "M" + str.tostring(i + 1) : groupMarkers.get(i)) + downChar + ", "
    if upResult != ""
        upResult := str.substring(upResult, 0, str.length(upResult) - 2)
    if downResult != ""
        downResult := str.substring(downResult, 0, str.length(downResult) - 2)
    [upResult, downResult]
//#endregion



//#region ———————————————————— Example code


string TT_LST = "Each input specifies a group of conditions to form compound upward and downward conditions. The
     input should contain any of these condition numbers, separated by commas and optional spaces (e.g., '1, 2, 4'):
     \n  1  –  Bar up/down
     \n  2  –  Fast EMA above/below slow EMA
     \n  3  –  Volume above average
     \n  4  –  Volume rising
     \n  5  –  RSI trending up/down
     \n  6  –  Low volatility
     \nEach input's title signifies the name used in the compound condition's marker. Compound conditions for empty 
     inputs are always `false`."

// Create input fields to specify three separate condition groups. The script calculates compound conditions for each 
// non-empty input list.
string conditionInput1 = input.string("1, 4, 5, 6", "M1", inline  = "01")
string conditionInput2 = input.string("",           "M2", inline  = "01")
string conditionInput3 = input.string("",           "M3", inline  = "01", tooltip = TT_LST)

// @variable An array of "string" values specifying lists of conditions to include in each compound condition. 
var array<string> conditionGroups = array.from(conditionInput1, conditionInput2, conditionInput3)

// @variable An array containing the possible "bool" values for bullish compound conditions.
array<bool> bullConditions = array.from(
     close > open,                              
     ta.ema(close, 9) > ta.ema(close, 21),       
     volume > ta.sma(volume, 20), 
     ta.rising(volume, 1), 
     math.abs(ta.rsi(close, 14) - 60) < 10, 
     ta.atr(7) < ta.atr(40)
 )
// @variable An array containing the possible "bool" values for bearish compound conditions.
array<bool> bearConditions = array.from(
     close < open, 
     ta.ema(close, 9) < ta.ema(close, 21),
     volume > ta.sma(volume, 20), 
     ta.rising(volume, 1), 
     math.abs(ta.rsi(close, 14) - 40) < 10, 
     ta.atr(7) < ta.atr(40)
 )

// Create strings for upward and downward alert messages based on the user-specified condition groups. 
[alertMsgUp, alertMsgDn] = compoundAlertMessage(bullConditions, bearConditions, conditionGroups, zeroIndex = false)

// Replace the commas in the `alertMsg*` values with line breaks to stack group markers vertically in the label text.
string labelMsgUp = str.replace_all(alertMsgUp, ", ", "\n")
string labelMsgDn = str.replace_all(alertMsgDn, ", ", "\n")

// Set alert conditions for non-empty `alertMsg*` values only on confirmed bar states.
bool triggerAlertUp = barstate.isconfirmed and alertMsgUp != ""
bool triggerAlertDn = barstate.isconfirmed and alertMsgDn != ""

// Create alert triggers and draw labels on the chart when `triggerAlertUp` or `triggerAlertDn` occurs. 
if triggerAlertUp 
    alert(alertMsgUp)
    label.new(bar_index, na, labelMsgUp, yloc = yloc.belowbar, color = color(na), textcolor = color.lime)
if triggerAlertDn 
    alert(alertMsgDn)
    label.new(bar_index, na, labelMsgDn, yloc = yloc.abovebar, color = color(na), textcolor = color.fuchsia)
//#endregion
