//@version=6
strategy("Joey Strategy", overlay=true, pyramiding=0)

// =============================
// Inputs
// =============================

length = input.int(14, "Stochastic Length", minval=1)

OverSold = input.int(30, "Oversold")

smoothK = input.int(3, "Smooth K", minval=1)
smoothD = input.int(3, "Smooth D", minval=1)

atrLength = input.int(14, "ATR Length", minval=1)
atrMultiplier = input.float(1.5, "ATR Take Profit / Stop Loss Multiplier", minval=0.1, step=0.1)

// =============================
// Stochastic Calculation
// =============================

k = ta.sma(ta.stoch(close, high, low, length), smoothK)
d = ta.sma(k, smoothD)

// Enter long when K crosses above D while K is below Oversold
longSignal = ta.crossover(k, d) and k < OverSold

// =============================
// ATR Calculation
// =============================

atr = ta.atr(atrLength)

// =============================
// Trade Variables
// =============================

var float tradeEntryPrice = na
var float tradeAtrAtEntry = na
var float takeProfitPrice = na
var float stopLossPrice = na

// =============================
// Entry
// =============================

if longSignal and strategy.position_size == 0
    strategy.entry("Enter", strategy.long, comment="Enter")

// =============================
// Detect New Position and Lock Levels
// =============================

newLongPosition = strategy.position_size > 0 and strategy.position_size[1] == 0

if newLongPosition
    tradeEntryPrice := strategy.position_avg_price
    tradeAtrAtEntry := atr

    takeProfitPrice := tradeEntryPrice + tradeAtrAtEntry * atrMultiplier
    stopLossPrice := tradeEntryPrice - tradeAtrAtEntry * atrMultiplier

// =============================
// Reset Levels When Flat
// =============================

if strategy.position_size == 0
    tradeEntryPrice := na
    tradeAtrAtEntry := na
    takeProfitPrice := na
    stopLossPrice := na

// =============================
// Exits
// =============================

if strategy.position_size > 0 and not na(takeProfitPrice) and not na(stopLossPrice)
    strategy.exit(
         "Exit",
         from_entry="Enter",
         qty_percent=100,
         limit=takeProfitPrice,
         stop=stopLossPrice,
         comment="Exit"
    )