//@version=6

// @description Condition operator evaluator + AND/OR combiner for GB-RMBP+ strategy.
// Replaces 12-branch ternary chains and the 50-branch combiner used for external filter rules.
library("GB_Cond_Lib", overlay = true)


// @function Evaluate a binary condition between two series given an operator string.
// @param v1 Left-hand series
// @param op Operator: "CrossUp", "CrossDown", ">", ">=", "<", "<=", "==",
//          "> Previous", ">= Previous", "< Previous", "<= Previous", "== Previous"
// @param v2 Right-hand series
// @returns Boolean result; false if op is unrecognized (including "🚫 None")
export eval_cond_op(float v1, string op, float v2) =>
    switch op
        "CrossUp"      => ta.crossover(v1, v2)
        "CrossDown"    => ta.crossunder(v1, v2)
        ">"            => v1 > v2
        ">="           => v1 >= v2
        "<"            => v1 < v2
        "<="           => v1 <= v2
        "=="           => v1 == v2
        "> Previous"   => v1 > v2[1]
        ">= Previous"  => v1 >= v2[1]
        "< Previous"   => v1 < v2[1]
        "<= Previous"  => v1 <= v2[1]
        "== Previous"  => v1 == v2[1]
        => false


// @function Same as eval_cond_op, but if op is unrecognized returns `default_true`
// (preserves the v1.0.77 quirk for LCond5/SCond5 which used `(make_custom ? true : true)` fallback).
// @param v1 Left-hand series
// @param op Operator string
// @param v2 Right-hand series
// @param default_true Value returned when op is "🚫 None" or unknown
export eval_cond_op_with_default(float v1, string op, float v2, bool default_true) =>
    switch op
        "CrossUp"      => ta.crossover(v1, v2)
        "CrossDown"    => ta.crossunder(v1, v2)
        ">"            => v1 > v2
        ">="           => v1 >= v2
        "<"            => v1 < v2
        "<="           => v1 <= v2
        "=="           => v1 == v2
        "> Previous"   => v1 > v2[1]
        ">= Previous"  => v1 >= v2[1]
        "< Previous"   => v1 < v2[1]
        "<= Previous"  => v1 <= v2[1]
        "== Previous"  => v1 == v2[1]
        => default_true


// @function Combine 5 condition booleans with AND, gated by 5 "use" flags.
// Matches v1.0.77 condition_function_AND exactly: if no flags are checked,
// returns (make_custom ? false : true) — the strategy's "no filters = pass" default.
// @param u1..u5 Five "use" flags
// @param c1..c5 Five condition results
// @param make_custom The make_custom strategy flag
// @returns Combined boolean
export combine_AND(bool u1, bool u2, bool u3, bool u4, bool u5, bool c1, bool c2, bool c3, bool c4, bool c5, bool make_custom) =>
    bool anyUsed = u1 or u2 or u3 or u4 or u5
    bool result = true
    if u1
        result := result and c1
    if u2
        result := result and c2
    if u3
        result := result and c3
    if u4
        result := result and c4
    if u5
        result := result and c5
    anyUsed ? result : (make_custom ? false : true)


// @function Combine 5 condition booleans with OR, gated by 5 "use" flags.
// Matches v1.0.77 condition_function_OR exactly.
export combine_OR(bool u1, bool u2, bool u3, bool u4, bool u5, bool c1, bool c2, bool c3, bool c4, bool c5, bool make_custom) =>
    bool anyUsed = u1 or u2 or u3 or u4 or u5
    bool result = false
    if u1
        result := result or c1
    if u2
        result := result or c2
    if u3
        result := result or c3
    if u4
        result := result or c4
    if u5
        result := result or c5
    anyUsed ? result : (make_custom ? false : true)


plot(na, title = "anchor", display = display.none)
