//@version=6
strategy(
    "VuManChu WT Zero Cross Strategy V1.2.3",
    overlay = true,
    pyramiding = 0,
    process_orders_on_close = true,
    default_qty_type = strategy.percent_of_equity,
    default_qty_value = 2)

//=====================================================
// INPUTS
//=====================================================

// WaveTrend
wtChannelLen = input.int(9,   "WT Channel Length", minval = 1,  group = "WaveTrend")
wtAverageLen = input.int(27,  "WT Average Length", minval = 1,  group = "WaveTrend")
wtMALen      = input.int(3,   "WT MA Length",      minval = 1,  group = "WaveTrend")
wtSource     = input.source(hlc3, "WT Source",                  group = "WaveTrend")
minSwing     = input.float(10.0,  "Min Swing Before Cross",
     minval = 1.0, step = 0.5,                                  group = "WaveTrend")

// Trend Filter
enableTrendFilter = input.bool(false, "Enable Trend Filter",    group = "Trend Filter")
emaLength         = input.int(200,   "EMA Length", minval = 1,  group = "Trend Filter")

// Take Profits
tp1Pct = input.float(50.0, "TP1 %", minval = 1, maxval = 100, step = 1, group = "Take Profits")
tp2Pct = input.float(50.0, "TP2 %", minval = 1, maxval = 100, step = 1, group = "Take Profits")
tp3Pct = input.float(50.0, "TP3 %", minval = 1, maxval = 100, step = 1, group = "Take Profits")
tp4Pct = input.float(50.0, "TP4 %", minval = 1, maxval = 100, step = 1, group = "Take Profits")
tp5Pct = input.float(50.0, "TP5 %", minval = 1, maxval = 100, step = 1, group = "Take Profits")

// Stop Loss
enableSL    = input.bool(true,     "Enable Stop Loss",                      group = "Stop Loss")
slType      = input.string("ATR",  "Stop Loss Type",
     options = ["ATR", "Fixed %", "Both"],                      group = "Stop Loss")
atrLength   = input.int(14,        "ATR Length",   minval = 1,  group = "Stop Loss")
atrMult     = input.float(2.0,     "ATR Multiplier",
     minval = 0.1, step = 0.1,                                  group = "Stop Loss")
fixedSlPct  = input.float(1.0,     "Fixed Stop %", minval = 0.01,
     step = 0.1,                                                 group = "Stop Loss")

// Visuals
showEMA    = input.bool(true, "Show EMA",           group = "Visuals")
showArrows = input.bool(true, "Show Entry Arrows",   group = "Visuals")
showTPDots = input.bool(true, "Show TP Dots",        group = "Visuals")
showSL     = input.bool(true, "Show Stop Loss Line", group = "Visuals")

//=====================================================
// WAVETREND
//=====================================================

esa = ta.ema(wtSource, wtChannelLen)
de  = ta.ema(math.abs(wtSource - esa), wtChannelLen)
ci  = (wtSource - esa) / (0.015 * de)

wt1 = ta.ema(ci, wtAverageLen)
wt2 = ta.sma(wt1, wtMALen)

//=====================================================
// SWING TRACKING
//=====================================================

var float lowestSince  = 0.0
var float highestSince = 0.0

if wt1 < 0
    lowestSince  := math.min(lowestSince, wt1)
else
    lowestSince  := 0.0

if wt1 > 0
    highestSince := math.max(highestSince, wt1)
else
    highestSince := 0.0

//=====================================================
// SIGNALS
//=====================================================

rawLong  = wt1[1] < 0 and wt1 >= 0
rawShort = wt1[1] > 0 and wt1 <= 0

longSignal  = rawLong  and lowestSince[1]  <= -minSwing
shortSignal = rawShort and highestSince[1] >=  minSwing

// TP circles
wtCrossUp   = wt1[1] - wt2[1] < 0 and wt1 - wt2 >= 0
wtCrossDown = wt1[1] - wt2[1] > 0 and wt1 - wt2 <= 0
buyCircle   = wtCrossUp   and wt1 < -60 and wt2 < -60
sellCircle  = wtCrossDown and wt1 > 60  and wt2 > 60

//=====================================================
// TREND FILTER
//=====================================================

emaFilter    = ta.ema(close, emaLength)
longAllowed  = not enableTrendFilter or close > emaFilter
shortAllowed = not enableTrendFilter or close < emaFilter

//=====================================================
// ATR
//=====================================================

atrValue = ta.atr(atrLength)

//=====================================================
// STATE
//=====================================================

var bool  inLong     = false
var bool  inShort    = false
var int   tpCount    = 0
var float entryPrice = na
var float stopLevel  = na

if strategy.position_size == 0
    inLong     := false
    inShort    := false
    tpCount    := 0
    stopLevel  := na
    entryPrice := na

//=====================================================
// STOP LEVEL CALCULATION
//=====================================================

f_calcStop(isLong, ep) =>
    atrStop   = isLong ? ep - atrValue * atrMult   : ep + atrValue * atrMult
    fixedStop = isLong ? ep * (1 - fixedSlPct / 100) : ep * (1 + fixedSlPct / 100)
    slType == "ATR"      ? atrStop   :
     slType == "Fixed %" ? fixedStop :
     isLong              ? math.max(atrStop, fixedStop) :
                           math.min(atrStop, fixedStop)

//=====================================================
// STRATEGY LOGIC
//=====================================================

if longSignal and longAllowed
    strategy.close("Short")
    strategy.entry("Long", strategy.long)
    inLong     := true
    inShort    := false
    tpCount    := 0
    entryPrice := close
    stopLevel  := enableSL ? f_calcStop(true, close) : na

else if shortSignal and shortAllowed
    strategy.close("Long")
    strategy.entry("Short", strategy.short)
    inShort    := true
    inLong     := false
    tpCount    := 0
    entryPrice := close
    stopLevel  := enableSL ? f_calcStop(false, close) : na

else if longSignal and not longAllowed and inShort
    strategy.close("Short")
    inShort    := false
    tpCount    := 0
    stopLevel  := na

else if shortSignal and not shortAllowed and inLong
    strategy.close("Long")
    inLong     := false
    tpCount    := 0
    stopLevel  := na

// Take Profits
else if inLong and sellCircle
    tpPct = tpCount == 0 ? tp1Pct :
             tpCount == 1 ? tp2Pct :
             tpCount == 2 ? tp3Pct :
             tpCount == 3 ? tp4Pct :
             tpCount == 4 ? tp5Pct : float(na)
    if not na(tpPct)
        strategy.close("Long", qty_percent = tpPct)
        tpCount += 1

else if inShort and buyCircle
    tpPct = tpCount == 0 ? tp1Pct :
             tpCount == 1 ? tp2Pct :
             tpCount == 2 ? tp3Pct :
             tpCount == 3 ? tp4Pct :
             tpCount == 4 ? tp5Pct : float(na)
    if not na(tpPct)
        strategy.close("Short", qty_percent = tpPct)
        tpCount += 1

// Stop Loss check (only when enabled)
if enableSL and not na(stopLevel)
    if inLong and low <= stopLevel
        strategy.close("Long", comment = "SL Hit")
        inLong    := false
        tpCount   := 0
        stopLevel := na

    if inShort and high >= stopLevel
        strategy.close("Short", comment = "SL Hit")
        inShort   := false
        tpCount   := 0
        stopLevel := na

// Broker-side stop order (only when enabled)
if enableSL and not na(stopLevel)
    if inLong
        strategy.exit("Long SL", from_entry = "Long", stop = stopLevel)
    if inShort
        strategy.exit("Short SL", from_entry = "Short", stop = stopLevel)

//=====================================================
// VISUALS
//=====================================================

plot(showEMA ? emaFilter : na,
     "EMA Filter", color = color.yellow, linewidth = 2)

plot(showSL and enableSL and not na(stopLevel) ? stopLevel : na,
     "Stop Loss", color = color.red, linewidth = 1,
     style = plot.style_linebr)

plotshape(
    showArrows and longSignal,
    title    = "Long Entry",
    style    = shape.arrowup,
    location = location.belowbar,
    size     = size.small,
    color    = color.green)

plotshape(
    showArrows and shortSignal,
    title    = "Short Entry",
    style    = shape.arrowdown,
    location = location.abovebar,
    size     = size.small,
    color    = color.red)

plotshape(
    showTPDots and inLong and sellCircle,
    title    = "Long TP",
    style    = shape.circle,
    location = location.abovebar,
    size     = size.tiny,
    color    = color.red)

plotshape(
    showTPDots and inShort and buyCircle,
    title    = "Short TP",
    style    = shape.circle,
    location = location.belowbar,
    size     = size.tiny,
    color    = color.green)

//=====================================================
// ALERTS
//=====================================================

alertcondition(longSignal,                          "Long Entry",   "WT1 crossed above zero")
alertcondition(shortSignal,                         "Short Entry",  "WT1 crossed below zero")
alertcondition(inLong  and sellCircle,              "Long TP",      "WT Long TP signal")
alertcondition(inShort and buyCircle,               "Short TP",     "WT Short TP signal")
alertcondition(enableSL and inLong  and low  <= stopLevel, "Long SL Hit",  "Stop loss hit on Long")
alertcondition(enableSL and inShort and high >= stopLevel, "Short SL Hit", "Stop loss hit on Short")