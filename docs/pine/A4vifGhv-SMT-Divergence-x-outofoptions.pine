//@version=5
indicator("SMT Divergence x outofoptions", shorttitle="SMT", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500, dynamic_requests = true)

//═══════════════════════════════════════════════════════════════════════════//
//                            1. INPUT PARAMETERS                            //
//═══════════════════════════════════════════════════════════════════════════//

// 1.1 SMT Divergences Settings
enableSMT = input.bool(true, "", group="SMT Divergence", inline = "1")
smtTicker = input.symbol('CME_MINI:ES1!', "", group="SMT Divergence", inline = "1")
smtCandleCheck = input.bool(false, "SMT Validation", group="SMT Divergence", inline = "2", tooltip="Validate SMT entries with candle direction")
smtDelBroken = input.bool(true, "Remove Broken SMTs",inline = "3", group="SMT Divergence")
smtLabelSize = input.string("Tiny", title="Label Size", options=["Tiny", "Small", "Normal", "Large"], inline = "4", group="SMT Divergence")

// 1.2 Bullish Style
smtBullColor = input.color(#dbdbdbb3, "", inline="7", group="SMT Divergence")
smtBullLineStyle = input.string("Solid", "+SMT", options=["Solid", "Dotted", "Dashed"], inline="7", group="SMT Divergence")
smtBullLineWidth = input.int(1, "", minval=1, maxval=5, inline="7", group="SMT Divergence")

// 1.3 Bearish Style
smtBearColor = input.color(#dbdbdbb3, "", inline="8", group="SMT Divergence")
smtBearLineStyle = input.string("Solid", "-SMT", options=["Solid", "Dotted", "Dashed"], inline="8", group="SMT Divergence")
smtBearLineWidth = input.int(1, "", minval=1, maxval=5, inline="8", group="SMT Divergence")

// 1.4 Enhanced Alert Settings
alertBullSMT = input.bool(false, "+SMT Formed", inline="alert2", group="Alerts 💥🔔")
alertBearSMT = input.bool(false, "-SMT Formed", inline="alert2", group="Alerts 💥🔔")

inputMsg = input.text_area("{{trigger}} on {{ticker}}\nCurrent Price: {{indicator}}\nTime: {{time}}\nTimeframe: {{interval}}", "", group="Alerts 💥🔔")

//═══════════════════════════════════════════════════════════════════════════//
//                            2. CONSTANTS & VARIABLES                       //
//═══════════════════════════════════════════════════════════════════════════//

// 2.1 Constants
const string FREQ = alert.freq_once_per_bar
const string SMT_TZ = "America/New_York"
var const color smt_na_color = color.new(color.gray, 100)

// 2.2 SMT Variables
var int smtLeft = 2
var int smtLeftExtended = smtLeft
var string smtTickerName = syminfo.ticker(smtTicker)
var int smtOneBar = timeframe.in_seconds() * 1000
var float lastBUsmtPrice = 0
var float lastBEsmtPrice = 0

//═══════════════════════════════════════════════════════════════════════════//
//                            3. TYPE DEFINITIONS                            //
//═══════════════════════════════════════════════════════════════════════════//

// 3.1 SMT Types
type smtDivergence
    line ln
    label lb
    float price

type smtLiquidity
    float price
    int time
    float ref_price

//═══════════════════════════════════════════════════════════════════════════//
//                            4. ARRAY DECLARATIONS                          //
//═══════════════════════════════════════════════════════════════════════════//

// 4.1 SMT Arrays
var array<smtDivergence> SMTBullish = array.new<smtDivergence>()
var array<smtDivergence> SMTBearish = array.new<smtDivergence>()
var array<smtLiquidity> smtH1 = array.new<smtLiquidity>()
var array<smtLiquidity> smtL1 = array.new<smtLiquidity>()
var array<smtLiquidity> smtH2 = array.new<smtLiquidity>()
var array<smtLiquidity> smtL2 = array.new<smtLiquidity>()

//═══════════════════════════════════════════════════════════════════════════//
//                            5. HELPER FUNCTIONS                            //
//═══════════════════════════════════════════════════════════════════════════//

// 5.1 Alert Message Function
getAlertMsg(string trigger, float ind=0.0) =>
    var string alertMsg = inputMsg
    alertMsg := str.replace_all(alertMsg, "{{exchange}}", syminfo.prefix)
    alertMsg := str.replace_all(alertMsg, "{{ticker}}", syminfo.ticker)
    alertMsg := str.replace_all(alertMsg, "{{volume}}", str.tostring(volume, format.volume))
    alertMsg := str.replace_all(alertMsg, "{{close}}", str.tostring(close, format.price))
    alertMsg := str.replace_all(alertMsg, "{{open}}", str.tostring(open, format.price))
    alertMsg := str.replace_all(alertMsg, "{{high}}", str.tostring(high, format.price))
    alertMsg := str.replace_all(alertMsg, "{{low}}", str.tostring(low, format.price))
    alertMsg := str.replace_all(alertMsg, "{{time}}", str.format_time(time, "yyyy-MM-dd", "Etc/UTC")+"T"+str.format_time(time, "HH:mm:ss", "Etc/UTC")+"Z")
    alertMsg := str.replace_all(alertMsg, "{{timenow}}", str.format_time(timenow, "yyyy-MM-dd", "Etc/UTC")+"T"+str.format_time(timenow, "HH:mm:ss", "Etc/UTC")+"Z")
    alertMsg := str.replace_all(alertMsg, "{{interval}}", timeframe.period)
    alertMsg := str.replace_all(alertMsg, "{{syminfo.currency}}", syminfo.currency)
    alertMsg := str.replace_all(alertMsg, "{{syminfo.basecurrency}}", syminfo.basecurrency)
    alertMsg := str.replace_all(alertMsg, "{{trigger}}", trigger)
    alertMsg := str.replace_all(alertMsg, "{{indicator}}", str.tostring(ind, "##.#"))
    alertMsg

// 5.2 Style Functions
getLabelSize(sizeString) =>
    switch sizeString
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.small

lineStyleSMT(s) =>
    switch s
        "Solid" => line.style_solid
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_solid

// 5.3 SMT Helper Functions
SMT_TF(t) => str.format_time(t, "MM-dd HH:mm:ss", SMT_TZ)
SMT_S(s) => str.tostring(s)

smtIsUp() => close[smtLeftExtended] > open[smtLeftExtended]
smtIsDown() => open[smtLeftExtended] > close[smtLeftExtended]

// SMT Sweep function to find liquidity levels
smtSweep(array<smtLiquidity> source, float price, bool up) =>
    smtLiquidity l = na
    while source.size() > 0
        smtLiquidity c = source.pop()
        if up ? price > c.price : price < c.price
            l := c
        else
            source.push(c)
            break
    l

// SMT Check function for liquidity validation
smtCheck(smtLiquidity l, array<smtLiquidity> ll, bool up) =>
    smtLiquidity vl = smtLiquidity.new(l.ref_price, l.time)
    int size = ll.size() - 1
    if size > 0
        for i = size to 0
            smtLiquidity last = ll.get(i)
            if last.time < l.time
                break
            if last.time > l.time and (up ? last.price < l.ref_price : last.price > l.ref_price)
                vl := last
                break
    vl

// SMT Validate SMT based on liquidity
smtValidateSMT(array<smtLiquidity> ll, smtLiquidity s, bool up) =>
    int b = 0
    if ll.size() > 0
        smtLiquidity last = ll.last()
        if ((up ? last.price > s.ref_price : last.price < s.ref_price) and last.time > s.time) == true
            int temp_b = (time - last.time) / smtOneBar
            b := temp_b <= 20 ? temp_b : 0
    b

// SMT Prune arrays based on max_bars_back
smtPruneArray(array<smtLiquidity> arr, int max_bars) =>
    if arr.size() > 0
        int current_time = time
        int max_time_diff = max_bars * timeframe.in_seconds() * 1000
        for i = arr.size() - 1 to 0 by 1
            smtLiquidity item = arr.get(i)
            if current_time - item.time > max_time_diff
                arr.remove(i)

// Draw SMT function
smtDrawSMT(int tm, float p1, float p2, bool bull, bool isValid=false)=>
    float p = bull ? lastBUsmtPrice : lastBEsmtPrice
    if enableSMT and time[smtLeftExtended] - tm > smtOneBar
        // Use separate styles for bull and bear
        line_style = bull ? lineStyleSMT(smtBullLineStyle) : lineStyleSMT(smtBearLineStyle)
        line_width = bull ? smtBullLineWidth : smtBearLineWidth
        line_color = bull ? smtBullColor : smtBearColor
        
        line l = line.new(tm, p1, time[smtLeftExtended], p2, xloc=xloc.bar_time, color=line_color, width=line_width, style=line_style)
        labelText = bull ? "+SMT" : "-SMT"
        
        label_size = getLabelSize(smtLabelSize)
        label_color = bull ? smtBullColor : smtBearColor
        
        label b = label.new(math.round(math.avg(tm, time[smtLeftExtended])), math.avg(p1, p2), labelText, color=smt_na_color, style=bull ? label.style_label_up : label.style_label_down, textcolor=label_color, xloc=xloc.bar_time, size=label_size)
        p := bull ? math.min(p1, p2) : math.max(p1, p2)
        (bull ? SMTBullish : SMTBearish).push(smtDivergence.new(l, b, p))
        
        // Alerts
        if bull and alertBullSMT and barstate.isrealtime
            alert(getAlertMsg("+SMT Formed", close), FREQ)
        else if not bull and alertBearSMT and barstate.isrealtime
            alert(getAlertMsg("-SMT Formed", close), FREQ)
    p

//═══════════════════════════════════════════════════════════════════════════//
//                            6. SMT MAIN LOGIC                              //
//═══════════════════════════════════════════════════════════════════════════//

// Clear existing SMT lines and labels when enableSMT is false
if not enableSMT
    while SMTBullish.size() > 0
        smtDivergence s = SMTBullish.pop()
        s.ln.delete()
        if not na(s.lb)
            s.lb.delete()
    while SMTBearish.size() > 0
        smtDivergence s = SMTBearish.pop()
        s.ln.delete()
        if not na(s.lb)
            s.lb.delete()

// SMT Remove broken SMTs
if smtDelBroken and enableSMT
    if high > lastBEsmtPrice and lastBEsmtPrice > 0
        lastBEsmtPrice := 0
        while SMTBearish.size() > 0
            smtDivergence la = SMTBearish.pop()
            if la.price > high
                lastBEsmtPrice := la.price
                SMTBearish.push(la)
                break
            else
                if smtDelBroken
                    la.ln.delete()
                    if not na(la.lb)
                        la.lb.delete()
    if low < lastBUsmtPrice and lastBUsmtPrice > 0
        lastBUsmtPrice := 0
        while SMTBullish.size() > 0
            smtDivergence la = SMTBullish.pop()
            if la.price < low
                lastBUsmtPrice := la.price
                SMTBullish.push(la)
                break
            else
                if smtDelBroken
                    la.ln.delete()
                    if not na(la.lb)
                        la.lb.delete()

// SMT Get data from comparison ticker
if enableSMT
    [smtHh, smtLl, smtOo, smtCc] = request.security(smtTicker, timeframe.period, [high, low, open, close])
    
    // SMT Calculate pivot highs and lows
    float smtH = ta.pivothigh(smtLeft, smtLeftExtended)
    float smtHt = ta.pivothigh(smtHh, smtLeft, smtLeftExtended)
    smtLiquidity smtS1 = not na(smtH) ? smtSweep(smtH1, smtH, true) : na
    smtLiquidity smtS2 = not na(smtHt) ? smtSweep(smtH2, smtHt, true) : na
    
    // SMT Process high sweeps
    if not na(smtS1)
        if time[smtLeftExtended] - smtS1.time > smtOneBar
            bool smtIsValid = smtIsDown() and smtOo[smtLeftExtended] > smtCc[smtLeftExtended]
            if na(smtS2)
                if smtHh[smtLeftExtended] < smtS1.ref_price and (not smtCandleCheck or smtIsValid)
                    lastBEsmtPrice := smtDrawSMT(smtS1.time, smtS1.price, smtH, false, smtIsValid)
                else if smtH2.size() > 0
                    smtLiquidity smtLast = smtH2.last()
                    if smtLast.price > smtHh[smtLeftExtended] and high[(time - smtLast.time) / smtOneBar] < smtH and (not smtCandleCheck or smtIsValid)
                        lastBEsmtPrice := smtDrawSMT(smtLast.time, smtLast.ref_price, smtH, false, smtIsValid)
            else if smtS1.time < smtS2.time and smtHh[smtLeftExtended] < smtS1.ref_price and (not smtCandleCheck or smtIsValid)
                lastBEsmtPrice := smtDrawSMT(smtS1.time, smtS1.price, smtH, false, smtIsValid)
            else if smtS1.time > smtS2.time and smtS2.ref_price > high[smtLeftExtended]
                int smtB = smtValidateSMT(smtH1, smtS2, true)
                if (smtB > 0 and smtB <= 20 ? smtHh[smtB] < smtHt : true) and (not smtCandleCheck or smtIsValid)
                    smtLiquidity smtLc = smtCheck(smtS2, smtH1, false)
                    lastBEsmtPrice := smtDrawSMT(smtLc.time, smtLc.price, high[smtLeftExtended], false, smtIsValid)
    else if not na(smtS2)
        if time[smtLeftExtended] - smtS2.time > smtOneBar
            bool smtIsValid = smtIsDown() and smtOo[smtLeftExtended] > smtCc[smtLeftExtended]
            if smtS2.ref_price > high[smtLeftExtended]
                int smtB = smtValidateSMT(smtH1, smtS2, true)
                if (smtB > 0 and smtB <= 20 ? smtHh[smtB] < smtHt : true) and (not smtCandleCheck or smtIsValid)
                    smtLiquidity smtLc = smtCheck(smtS2, smtH1, false)
                    lastBEsmtPrice := smtDrawSMT(smtLc.time, smtLc.price, high[smtLeftExtended], false, smtIsValid)
    
    // SMT Calculate pivot lows
    float smtL = ta.pivotlow(smtLeftExtended, smtLeftExtended)
    float smtLt = ta.pivotlow(smtLl, smtLeftExtended, smtLeftExtended)
    smtLiquidity smtS3 = not na(smtL) ? smtSweep(smtL1, smtL, false) : na
    smtLiquidity smtS4 = not na(smtLt) ? smtSweep(smtL2, smtLt, false) : na
    
    // SMT Process low sweeps
    if not na(smtS3)
        if time[smtLeftExtended] - smtS3.time > smtOneBar
            bool smtIsValid = smtIsUp() and smtCc[smtLeftExtended] > smtOo[smtLeftExtended]
            if na(smtS4)
                if smtLl[smtLeftExtended] > smtS3.ref_price and (not smtCandleCheck or smtIsValid)
                    lastBUsmtPrice := smtDrawSMT(smtS3.time, smtS3.price, smtL, true, smtIsValid)
                else if smtL2.size() > 0
                    smtLiquidity smtLast = smtL2.last()
                    if smtLast.price < smtLl[smtLeftExtended] and low[(time - smtLast.time) / smtOneBar] > smtL and (not smtCandleCheck or smtIsValid)
                        lastBUsmtPrice := smtDrawSMT(smtLast.time, smtLast.ref_price, smtL, true, smtIsValid)
            else if smtS3.time < smtS4.time and smtLl[smtLeftExtended] > smtS3.ref_price and (not smtCandleCheck or smtIsValid)
                lastBUsmtPrice := smtDrawSMT(smtS3.time, smtS3.price, smtL, true, smtIsValid)
            else if smtS3.time > smtS4.time and low[smtLeftExtended] > smtS4.ref_price
                int smtB = smtValidateSMT(smtL1, smtS4, false)
                if (smtB > 0 and smtB <= 20 ? smtLl[smtB] > smtLt : true) and (not smtCandleCheck or smtIsValid)
                    smtLiquidity smtLc = smtCheck(smtS4, smtL1, true)
                    lastBUsmtPrice := smtDrawSMT(smtLc.time, smtLc.price, low[smtLeftExtended], true, smtIsValid)
    else if not na(smtS4)
        if time[smtLeftExtended] - smtS4.time > smtOneBar
            bool smtIsValid = smtIsUp() and smtCc[smtLeftExtended] > smtOo[smtLeftExtended]
            if low[smtLeftExtended] > smtS4.ref_price
                int smtB = smtValidateSMT(smtL1, smtS4, false)
                if (smtB > 0 and smtB <= 20 ? smtLl[smtB] > smtLt : true) and (not smtCandleCheck or smtIsValid)
                    smtLiquidity smtLc = smtCheck(smtS4, smtL1, true)
                    lastBUsmtPrice := smtDrawSMT(smtLc.time, smtLc.price, low[smtLeftExtended], true, smtIsValid)
    
    // SMT Array Management - Prune arrays before pushing new elements
    smtPruneArray(smtH1, 20)
    smtPruneArray(smtH2, 20)
    smtPruneArray(smtL1, 20)
    smtPruneArray(smtL2, 20)
    
    // SMT Add new pivot points to arrays
    if not na(smtH)
        smtH1.push(smtLiquidity.new(smtH, time[smtLeftExtended], smtHh[smtLeftExtended]))
    if not na(smtHt)
        smtH2.push(smtLiquidity.new(smtHt, time[smtLeftExtended], high[smtLeftExtended]))
    if not na(smtL)
        smtL1.push(smtLiquidity.new(smtL, time[smtLeftExtended], smtLl[smtLeftExtended]))
    if not na(smtLt)
        smtL2.push(smtLiquidity.new(smtLt, time[smtLeftExtended], low[smtLeftExtended]))
