//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line newLine = line.new(point1, point2, xloc.bar_index)
//                          > // Store up to `3` elements and then begin to reverse roll elements.
//                          > rw.rollReverse(id = window, source = newLine, size = 3)
//                          > // Alternatively: id.rollReverse(newLine, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<line>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line newLine = line.new(point1, point2, xloc.bar_index)
//                          > // Roll up to `1000` intrabar `newLine` values into `id` in reverse order.
//                          > id.rollReverse(source = newLine, size = 1000)
//                          > // Alternatively: id.rollReverse(newLine, 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `rollReverse()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<line>() // No `var` or `varip` persistance.
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line newLine = line.new(point1, point2, xloc.bar_index)
//                          > id.rollReverse(newLine, 3) // Only reverse rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<line>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line newLine = line.new(point1, point2, xloc.bar_index)
//                          > // Reverse roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.rollReverse(newLine, 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<line>(size = 12)
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line newLine = line.new(point1, point2, xloc.bar_index)
//                          > id.rollReverse(newLine)
//                          > // `rollReverse(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<line>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line newLine = line.new(point1, point2, xloc.bar_index)
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollReverse(newLine, size = na)
//                          > ```
//
//                          Generates a runtime error if the `rollReverse(size)` parameter is smaller
//                          than the size of `id`.
//
//                          > ```
//                          > var id = array.new<line>(size = 12)
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line newLine = line.new(point1, point2, xloc.bar_index)
//                          > id.rollReverse(newLine, 3)
//                          > // Example runtime error:
//                          > // rollReverse(array<line> id, line source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<line>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line newLine = line.new(point1, point2, xloc.bar_index)
//                          > id.rollReverse(newLine, 654321)
//                          > // Example runtime error:
//                          > // rollReverse(array<line> id, line source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
export method rollReverse(array<line> id, line source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollReverse(array<line> id, line source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollReverse(array<line> id, line source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.pop().delete()

    id.unshift(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.pop().delete()
// }


// rollReverse(array<linefill> id, linefill source, int size) {
// @function                Creates a rolling window using an array object with elements in reverse order.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to insert at the beginning as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are inserted to `id` at index `0` until the array's size reaches the `size`
//                          value, then the oldest element at the last index is removed before inserting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<linefill>()
//                          > var line upper = line.new(bar_index - 1, high, bar_index, high)
//                          > var line lower = line.new(bar_index - 1, low, bar_index, low)
//                          > linefill channel = linefill.new(upper, lower, color.gray)
//                          > // Store up to `3` elements
//                          > // and then begin to reverse roll elements.
//                          > rw.rollReverse(id = window, source = channel, size = 3)
//                          > // Alternatively: id.rollReverse(channel, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<linefill>()
//                          > var line upper = line.new(bar_index - 1, high, bar_index, high)
//                          > var line lower = line.new(bar_index - 1, low, bar_index, low)
//                          > linefill channel = linefill.new(upper, lower, color.gray)
//                          > // Roll up to `1000` intrabar `channel` values into `id`.
//                          > id.rollReverse(source = channel, size = 1000)
//                          > // Alternatively: id.rollReverse(channel, 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `rollReverse()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<linefill>() // No `var` or `varip` persistance.
//                          > var line upper = line.new(bar_index - 1, high, bar_index, high)
//                          > var line lower = line.new(bar_index - 1, low, bar_index, low)
//                          > linefill channel = linefill.new(upper, lower, color.gray)
//                          > id.rollReverse(channel, 3) // Only reverse rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<linefill>()
//                          > var line upper = line.new(bar_index - 1, high, bar_index, high)
//                          > var line lower = line.new(bar_index - 1, low, bar_index, low)
//                          > linefill channel = linefill.new(upper, lower, color.gray)
//                          > // Reverse roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.rollReverse(channel, 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<linefill>(size = 12)
//                          > var line upper = line.new(bar_index - 1, high, bar_index, high)
//                          > var line lower = line.new(bar_index - 1, low, bar_index, low)
//                          > linefill channel = linefill.new(upper, lower, color.gray)
//                          > id.rollReverse(channel)
//                          > // `rollReverse(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<linefill>()
//                          > var line upper = line.new(bar_index - 1, high, bar_index, high)
//                          > var line lower = line.new(bar_index - 1, low, bar_index, low)
//                          > linefill channel = linefill.new(upper, lower, color.gray)
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollReverse(channel, size = na)
//                          > ```
//
//                          Generates a runtime error if the `rollReverse(size)` parameter is smaller
//                          than the size of `id`.
//
//                          > ```
//                          > var id = array.new<linefill>(size = 12)
//                          > var line upper = line.new(bar_index - 1, high, bar_index, high)
//                          > var line lower = line.new(bar_index - 1, low, bar_index, low)
//                          > linefill channel = linefill.new(upper, lower, color.gray)
//                          > id.rollReverse(channel, 3)
//                          > // Example runtime error:
//                          > // rollReverse(array<linefill> id, linefill source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<linefill>()
//                          > var line upper = line.new(bar_index - 1, high, bar_index, high)
//                          > var line lower = line.new(bar_index - 1, low, bar_index, low)
//                          > linefill channel = linefill.new(upper, lower, color.gray)
//                          > id.rollReverse(channel, 654321)
//                          > // Example runtime error:
//                          > // rollReverse(array<linefill> id, linefill source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
export method rollReverse(array<linefill> id, linefill source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollReverse(array<linefill> id, linefill source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollReverse(array<linefill> id, linefill source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.pop().delete()

    id.unshift(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.pop().delete()
// }


// rollReverse(array<label> id, label source, int size) {
// @function                Creates a rolling window using an array object with elements in reverse order.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
//
// @param source            The value to insert at the beginning as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are inserted to `id` at index `0` until the array's size reaches the `size`
//                          value, then the oldest element at the last index is removed before inserting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > // Store up to `3` elements and then begin to reverse roll elements.
//                          > rw.rollReverse(id = window, source = newLabel, size = 3)
//                          > // Alternatively: id.rollReverse(newLabel, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > // Roll up to `1000` intrabar `newLabel` values into `id` in reverse order.
//                          > id.rollReverse(source = newLabel, size = 1000)
//                          > // Alternatively: id.rollReverse(newLabel, 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `rollReverse()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<label>() // No `var` or `varip` persistance.
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > id.rollReverse(newLabel, 3) // Only reverse rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > // Reverse roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.rollReverse(newLabel, 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<label>(size = 12)
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > id.rollReverse(newLabel)
//                          > // `rollReverse(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollReverse(newLabel, size = na)
//                          > ```
//
//                          Generates a runtime error if the `rollReverse(size)` parameter is smaller
//                          than the size of `id`.
//
//                          > ```
//                          > var id = array.new<label>(size = 12)
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > id.rollReverse(newLabel, 3)
//                          > // Example runtime error:
//                          > // rollReverse(array<label> id, label source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > id.rollReverse(newLabel, 654321)
//                          > // Example runtime error:
//                          > // rollReverse(array<label> id, label source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
export method rollReverse(array<label> id, label source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollReverse(array<label> id, label source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollReverse(array<label> id, label source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.pop().delete()

    id.unshift(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.pop().delete()
// }



