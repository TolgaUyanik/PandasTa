//                          > // rollReverse(matrix<chart.point> id, array<chart.point> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method rollReverse(matrix<chart.point> id, array<chart.point> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "rollReverse(matrix<chart.point> id, array<chart.point> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
