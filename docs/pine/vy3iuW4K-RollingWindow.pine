// rollAscendingVarip(array<float> id, float source, int size = na) {
// @function                Creates an ascending sorted rolling window using a `varip` intrabar persistant array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                A `varip` intrabar persistant array object to use for the ascending sorted rolling window.
// @param source            The value to sort as an element to `id`. Values of `na` will not be sorted.
// @param size              Optional. The maximum size of the `id` ascending sorted rolling window array.
//
//                          New elements are sorted in `id` until it reaches same size as the `size` value, then
//                          the oldest (last sorted) element of `id` is removed before sorting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > // Roll up to `1000` intrabar `close` values into `id`.
//                          > id.rollAscendingVarip(source = close, size = 1000)
//                          > // Alternatively: id.rollAscendingVarip(close, 1000)
//                          > ```

//
//                          If `var` bar persistence is needed, use `rollAscendingVar()` instead.
//
//                          Ensure arrays are declared with `varip` keyword to store updated elements.
//                          Otherwise, applying `rollAscendingVarip()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<float>() // No `varip` persistance.
//                          > id.rollAscendingVarip(close, 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on the rolling window array from a different scope.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > // Roll up to `1000` realtime intrabar `close` values into `id`.
//                          > if barstate.isrealtime
//                          >     id.rollAscendingVarip(close, 1000)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > varip id = array.new<float>(12, 0.0)
//                          > id.rollAscendingVarip(close)
//                          > // `size` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollAscendingVarip(close, size = na)
//                          > ```
//
//                          Arrays must be in ascending order for rolled elements to be inserted at the correct index.
//
//                          > ```
//                          > var array<float> id = array.from(3.14, 1.17, 6.0) // Unsorted initalized array.
//                          > id.sort(order.ascending) // Sort it first!
//                          > id.rollAscendingVarip(bar_index)
//                          > ```
//
//                          Generates a runtime error if the `size` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > varip id = array.new<float>(12, 0.0)
//                          > id.rollAscendingVarip(close, 3)
//                          > // Example runtime error:
//                          > // rollAscendingVarip(array<float> id, float source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > id.rollAscendingVarip(close, 654321)
//                          > // Example runtime error:
//                          > // rollAscendingVarip(array<float> id, float source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > varip id = array.new<float>(size = 3)
//                          > float removedElement = id.rollAscendingVarip(close, 3)
//                          > ```
export method rollAscendingVarip(array<float> id, float source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollAscendingVarip(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollAscendingVarip(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    varip array<float> idQueue = id.copy()

    if ARRAY_SIZE_LIMIT == idQueue.size()
        oldestElement = idQueue.shift()
        id.remove(id.indexof(oldestElement))

    if not na(source) // Enqueue elements.
        idQueue.push(source)
        id.insert(id.binary_search_rightmost(source), source)

    // Dequeue elements.
    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        oldestElement = idQueue.shift()
        id.remove(id.indexof(oldestElement))
// }


