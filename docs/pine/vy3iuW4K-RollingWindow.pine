export method rollReverse(array<box> id, box source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollReverse(array<box> id, box source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if ARRAY_SIZE_LIMIT < idLastSize
        string garbageError = "rollReverse(array<box> id, box source, int size): "
          + "Size of `id` (" + str.tostring(idLastSize) + ") must not be greater than 500!"

