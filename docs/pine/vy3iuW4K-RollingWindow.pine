//@version=6
// @description This a Pine Script™ library to create rolling windows with arrays and matrices.
library(title = "RollingWindow")



const int ARRAY_SIZE_LIMIT = 100000
const int MATRIX_SIZE_LIMIT = 100000



//#region roll() Methods



// roll(array<float> id, float source, int size) {
// @function                Creates a rolling window using an array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to append as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are appended into `id` until the array's size reaches the `size` value, then
//                          the oldest element at index `0` index is removed before appending a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<float>()
//                          > // Store up to `3` elements and then begin to roll elements.
//                          > rw.roll(id = window, source = close, size = 3)
//                          > // Alternatively: window.roll(close, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > // Roll up to `1000` intrabar `close` values into `id`.
//                          > id.roll(source = close, size = 1000)
//                          > // Alternatively: id.roll(close, 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<float>() // No `var` or `varip` persistance.
//                          > id.roll(close, 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<float>()
//                          > // Roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.roll(close, 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<float>(size = 12)
//                          > id.roll(close)
//                          > // `roll(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<float>()
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.roll(close, size = na)
//                          > ```
//
//                          Generates a runtime error if the `roll(size)` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > var id = array.new<float>(size = 12)
//                          > id.roll(close, 3)
//                          > // Example runtime error:
//                          > // roll(array<float> id, float source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<float>()
//                          > id.roll(close, 654321)
//                          > // Example runtime error:
//                          > // roll(array<float> id, float source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<float>(size = 3)
//                          > float removedElement = id.roll(close, 3)
//                          > ```
export method roll(array<float> id, float source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size // All comparison operators with `na` operands resolve as `false`.
        string windowSizeError = "roll(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize // Prevents removing `id` elements by reducing the `size` parameter.
        string idSizeError = "roll(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize // Prevents pushing a 100,001st element.
        id.shift()

    id.push(source) // Enqueue element.

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.shift() // Dequeue element.
// }


// roll(array<int> id, int source, int size) {
// @function                Creates a rolling window using an array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to append as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are appended into `id` until the array's size reaches the `size` value, then
//                          the oldest element at index `0` index is removed before appending a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<int>()
//                          > // Store up to `3` elements and then begin to roll elements.
//                          > rw.roll(id = window, source = time, size = 3)
//                          > // Alternatively: window.roll(time, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<int>()
//                          > // Roll up to `1000` intrabar `time` values into `id`.
//                          > id.roll(source = time, size = 1000)
//                          > // Alternatively: id.roll(time, 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<int>() // No `var` or `varip` persistance.
//                          > id.roll(time, 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<int>()
//                          > // Roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.roll(time, 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<int>(size = 12)
//                          > id.roll(time)
//                          > // `roll(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<int>()
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.roll(time, size = na)
//                          > ```
//
//                          Generates a runtime error if the `roll(size)` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > var id = array.new<int>(size = 12)
//                          > id.roll(time, 3)
//                          > // Example runtime error:
//                          > // roll(array<int> id, int source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<int>()
//                          > id.roll(time, 654321)
//                          > // Example runtime error:
//                          > // roll(array<int> id, int source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<int>(size = 3)
//                          > int removedElement = id.roll(time, 3)
//                          > ```
export method roll(array<int> id, int source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "roll(array<int> id, int source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "roll(array<int> id, int source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.shift()

    id.push(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.shift()
// }


// roll(array<string> id, string source, int size) {
// @function                Creates a rolling window using an array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to append as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are appended into `id` until the array's size reaches the `size` value, then
//                          the oldest element at index `0` index is removed before appending a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<string>()
//                          > // Store up to `3` elements and then begin to roll elements.
//                          > rw.roll(id = window, source = str.tostring(close), size = 3)
//                          > // Alternatively: window.roll(str.tostring(close), 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<string>()
//                          > // Roll up to `1000` intrabar `str.tostring(close)` values into `id`.
//                          > id.roll(source = str.tostring(close), size = 1000)
//                          > // Alternatively: id.roll(str.tostring(close), 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<string>() // No `var` or `varip` persistance.
//                          > id.roll(str.tostring(close), 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<string>()
//                          > // Roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.roll(str.tostring(close), 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<string>(size = 12)
//                          > id.roll(str.tostring(close))
//                          > // `roll(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<string>()
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.roll(str.tostring(close), size = na)
//                          > ```
//
//                          Generates a runtime error if the `roll(size)` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > var id = array.new<string>(size = 12)
//                          > id.roll(str.tostring(close), 3)
//                          > // Example runtime error:
//                          > // roll(array<string> id, string source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<string>()
//                          > id.roll(str.tostring(close), 654321)
//                          > // Example runtime error:
//                          > // roll(array<string> id, string source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<string>(size = 3)
//                          > string removedElement = id.roll(str.tostring(close), 3)
//                          > ```
export method roll(array<string> id, string source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "roll(array<string> id, string source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "roll(array<string> id, string source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.shift()

    id.push(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.shift()
// }


// roll(array<bool> id, bool source, int size) {
// @function                Creates a rolling window using an array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to append as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are appended into `id` until the array's size reaches the `size` value, then
//                          the oldest element at index `0` index is removed before appending a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<bool>()
//                          > bool bullishBar = close > open
//                          > // Store up to `3` elements and then begin to roll elements.
//                          > rw.roll(id = window, source = bullishBar, size = 3)
//                          > // Alternatively: window.roll(bullishBar, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<bool>()
//                          > bool bullishBar = close > open
//                          > // Roll up to `1000` intrabar `bullishBar` values into `id`.
//                          > id.roll(source = bullishBar, size = 1000)
//                          > // Alternatively: id.roll(bullishBar, 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<bool>() // No `var` or `varip` persistance.
//                          > bool bullishBar = close > open
//                          > id.roll(bullishBar, 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<bool>()
//                          > bool bullishBar = close > open
//                          > // Roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.roll(bullishBar, 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<bool>(size = 12)
//                          > bool bullishBar = close > open
//                          > id.roll(bullishBar)
//                          > // `roll(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<bool>()
//                          > bool bullishBar = close > open
//                          > // Stores up to the element limit and then roll elements.
//                          > id.roll(bullishBar, size = na)
//                          > ```
//
//                          Generates a runtime error if the `roll(size)` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > var id = array.new<bool>(size = 12)
//                          > bool bullishBar = close > open
//                          > id.roll(bullishBar, 3)
//                          > // Example runtime error:
//                          > // roll(array<bool> id, bool source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<bool>()
//                          > bool bullishBar = close > open
//                          > id.roll(bullishBar, 654321)
//                          > // Example runtime error:
//                          > // roll(array<bool> id, bool source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<bool>(size = 3)
//                          > bool bullishBar = close > open
//                          > bool removedElement = id.roll(bullishBar, 3)
//                          > ```
export method roll(array<bool> id, bool source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "roll(array<bool> id, bool source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "roll(array<bool> id, bool source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.shift()

    id.push(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.shift()
// }


// roll(array<color> id, color source, int size) {
// @function                Creates a rolling window using an array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to append as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are appended into `id` until the array's size reaches the `size` value, then
//                          the oldest element at index `0` index is removed before appending a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<color>()
//                          > color gradient = color.from_gradient(close, low, high, color.red, color.green)
//                          > // Store up to `3` elements and then begin to roll elements.
//                          > rw.roll(id = window, source = gradient, size = 3)
//                          > // Alternatively: window.roll(gradient, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<color>()
//                          > color gradient = color.from_gradient(close, low, high, color.red, color.green)
//                          > // Roll up to `1000` intrabar `gradient` values into `id`.
//                          > id.roll(source = gradient, size = 1000)
//                          > // Alternatively: id.roll(gradient, 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<color>() // No `var` or `varip` persistance.
//                          > color gradient = color.from_gradient(close, low, high, color.red, color.green)
//                          > id.roll(gradient, 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<color>()
//                          > color gradient = color.from_gradient(close, low, high, color.red, color.green)
//                          > // Roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.roll(gradient, 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<color>(size = 12)
//                          > color gradient = color.from_gradient(close, low, high, color.red, color.green)
//                          > id.roll(gradient)
//                          > // `roll(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<color>()
//                          > color gradient = color.from_gradient(close, low, high, color.red, color.green)
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.roll(gradient, size = na)
//                          > ```
//
//                          Generates a runtime error if the `roll(size)` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > var id = array.new<color>(size = 12)
//                          > color gradient = color.from_gradient(close, low, high, color.red, color.green)
//                          > id.roll(gradient, 3)
//                          > // Example runtime error:
//                          > // roll(array<color> id, color source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
