        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollDescendingVar(array<int> id, int source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    var array<int> idQueue = id.copy()
    var array<int> idAscending = id.copy()

    if idQueue.size() != idLastSize
        idQueue := id.copy()
        idAscending := id.copy()

    if ARRAY_SIZE_LIMIT == idQueue.size()
        oldestElement = idQueue.shift()
        idAscending.remove(idAscending.indexof(oldestElement))
        id.remove(id.indexof(oldestElement))

    if not na(source)
        idQueue.push(source)
        int idAscendingIndex = idAscending.binary_search_rightmost(source)
        idAscending.insert(idAscendingIndex, source)
        id.insert(idLastSize - idAscendingIndex, source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        oldestElement = idQueue.shift()
        idAscending.remove(idAscending.indexof(oldestElement))
        id.remove(id.indexof(oldestElement))
// }


// rollDescendingVarip(array<float> id, float source, int size = na) {
// @function                Creates a descending sorted rolling window using a `varip` intrabar persistant array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                A `varip` intrabar persistant array object to use for the descending sorted rolling window.
// @param source            The value to sort as an element to `id`. Values of `na` will not be sorted.
// @param size              Optional. The maximum size of the `id` descending rolling window array.
//
//                          New elements are sorted in `id` until it reaches same size as the `size` value, then
//                          the oldest (last sorted) element of `id` is removed before sorting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > // Roll up to `1000` intrabar `close` values into `id`.
//                          > id.rollDescendingVarip(source = close, size = 1000)
//                          > // Alternatively: id.rollDescendingVarip(close, 1000)
//                          > ```
//
//                          If `var` bar persistence is needed, use `rollDescendingVar()` instead.
//
//                          Ensure arrays are declared with `varip` keyword to store updated elements.
//                          Otherwise, applying `rollDescendingVarip()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<float>() // No `varip` persistance.
//                          > id.rollDescendingVarip(close, 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on the rolling window array from a different scope.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > // Roll up to `1000` realtime intrabar `close` values into `id`.
//                          > if barstate.isrealtime
//                          >     id.rollDescendingVarip(close, 1000)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > varip id = array.new<float>(12, 0.0)
//                          > id.rollDescendingVarip(close)
//                          > // `size` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollDescendingVarip(close, size = na)
//                          > ```
//
//                          Arrays must be in descending order for rolled elements to be inserted at the correct index.
//
//                          > ```
//                          > var array<float> id = array.from(3.14, 1.17, 6.0) // Unsorted initalized array.
//                          > id.sort(order.descending) // Sort it first!
//                          > id.rollDescendingVarip(close)
//                          > ```
//
//                          Generates a runtime error if the `size` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > varip id = array.new<float>(12, 0.0)
//                          > id.rollDescendingVarip(close, 3)
//                          > // Example runtime error:
//                          > // rollDescendingVarip(array<float> id, float source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > id.rollDescendingVarip(close, 654321)
//                          > // Example runtime error:
//                          > // rollDescendingVarip(array<float> id, float source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > varip id = array.new<float>(size = 3)
//                          > float removedElement = id.rollDescendingVarip(close, 3)
//                          > ```
export method rollDescendingVarip(array<float> id, float source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollDescendingVarip(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollDescendingVarip(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    varip array<float> idQueue = id.copy()
    varip array<float> idAscending = id.copy()

    if idQueue.size() != idLastSize
        idQueue := id.copy()
        idAscending := id.copy()

    if ARRAY_SIZE_LIMIT == idQueue.size() // Prevent adding 100,001st elements.
        oldestElement = idQueue.shift()
        idAscending.remove(idAscending.indexof(oldestElement))
        id.remove(id.indexof(oldestElement))

    if not na(source) // Enqueue elements.
        idQueue.push(source)
        int idAscendingIndex = idAscending.binary_search_rightmost(source)
        idAscending.insert(idAscendingIndex, source) // Ascending binary insertion sort.
        // Descending binary insertion sort using the "reverse index" of an ascending sorted element.
        id.insert(idInitialSize - idAscendingIndex, source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        oldestElement = idQueue.shift()
        idAscending.remove(idAscending.indexof(oldestElement))
        id.remove(id.indexof(oldestElement))
// }


// rollDescendingVarip(array<int> id, int source, int size = na) {
// @function                Creates a descending sorted rolling window using a `varip` intrabar persistant array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                A `varip` intrabar persistant array object to use for the descending sorted rolling window.
// @param source            The value to sort as an element to `id`. Values of `na` will not be sorted.
// @param size              Optional. The maximum size of the `id` descending rolling window array.
//
//                          New elements are sorted in `id` until it reaches same size as the `size` value, then
//                          the oldest (last sorted) element of `id` is removed before sorting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<int>()
//                          > // Roll up to `1000` intrabar `time` values into `id`.
//                          > id.rollDescendingVarip(source = time, size = 1000)
//                          > // Alternatively: id.rollDescendingVarip(time, 1000)
//                          > ```
//
//                          If `var` bar persistence is needed, use `rollDescendingVar()` instead.
//
//                          Ensure arrays are declared with `varip` keyword to store updated elements.
//                          Otherwise, applying `rollDescendingVarip()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<int>() // No `varip` persistance.
//                          > id.rollDescendingVarip(time, 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on the rolling window array from a different scope.
//
//                          > ```
//                          > varip id = array.new<int>()
//                          > // Roll up to `1000` realtime intrabar `time` values into `id`.
//                          > if barstate.isrealtime
//                          >     id.rollDescendingVarip(time, 1000)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > varip id = array.new<int>(12, 0)
//                          > id.rollDescendingVarip(time)
//                          > // `size` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > varip id = array.new<int>()
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollDescendingVarip(time, size = na)
//                          > ```
//
//                          Arrays must be in descending order for rolled elements to be inserted at the correct index.
//
//                          > ```
//                          > var array<int> id = array.from(3, 1, 6) // Unsorted initalized array.
//                          > id.sort(order.descending) // Sort it first!
//                          > id.rollDescendingVarip(bar_index)
//                          > ```
//
//                          Generates a runtime error if the `size` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > varip id = array.new<int>(12, 0)
//                          > id.rollDescendingVarip(time, 3)
//                          > // Example runtime error:
//                          > // rollDescendingVarip(array<int> id, int source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > varip id = array.new<int>()
//                          > id.rollDescendingVarip(time, 654321)
//                          > // Example runtime error:
//                          > // rollDescendingVarip(array<int> id, int source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > varip id = array.new<int>(size = 3)
//                          > int removedElement = id.rollDescendingVarip(time, 3)
//                          > ```
export method rollDescendingVarip(array<int> id, int source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollDescendingVarip(array<int> id, int source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollDescendingVarip(array<int> id, int source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    varip array<int> idQueue = id.copy()
    varip array<int> idAscending = id.copy()

    if idQueue.size() != idLastSize
        idQueue := id.copy()
        idAscending := id.copy()

    if ARRAY_SIZE_LIMIT == idQueue.size()
        oldestElement = idQueue.shift()
        idAscending.remove(idAscending.indexof(oldestElement))
        id.remove(id.indexof(oldestElement))

    if not na(source)
        idQueue.push(source)
        int idAscendingIndex = idAscending.binary_search_rightmost(source)
        idAscending.insert(idAscendingIndex, source)
        id.insert(idInitialSize - idAscendingIndex, source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        oldestElement = idQueue.shift()
        idAscending.remove(idAscending.indexof(oldestElement))
        id.remove(id.indexof(oldestElement))
// }



//#endregion rollDescendingVar() and rollDescendingVarip() Methods



//#region roll() Matrix Methods



// roll(matrix<float> id, array<float> array_id, int size) {
// @function                Creates a rolling window using the rows of a matrix object.
//
//                          Removing the oldest row of a matrix and adding a new row is referred to as a *roll*.
//                          The function adds rows until the matrix is full, then begins to roll rows.
// @param id                A matrix object to use for the rolling window.
// @param array_id          The array containing values to append as a new row at index `0` into `id`.
// @param rows              Optional. The maximum number of rows in the `id` rolling window matrix.
//
//                          New rows are inserted into `id` at index `0` until the matrix rows reach the `rows` value,
//                          then the last row of `id` is removed before inserting a new row at index `0`.
//
//                          `rows = na` uses the initial number of rows in `id` as the maximum size.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window matrix on a matrix declared with `var` bar persistence.
//
//                          > ```
//                          > var id = matrix.new<float>()
//                          > var array_id = array.new<float>()
//                          > array_id.roll(close, 5)
//                          > // Store up to `3` rows of `array_id` values and then begin to roll rows.
//                          > id.roll(array_id, 3)
//                          > ```
//
//                          Create a rolling window matrix on a matrix declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = matrix.new<float>()
//                          > varip array_id = array.new<float>()
//                          > array_id.roll(close, 5)
//                          > // Roll up to `10` intrabar rows of `array_id` into `id`.
//                          > id.roll(array_id, 10)
//                          > ```
//
//                          Ensure matrices are declared with `var` or `varip` keywords to store updated rows.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = matrix.new<float>() // No `var` or `varip` persistance.
//                          > array_id = array.new<float>(5, close)
//                          > id.roll(array_id, 3) // Only rolls a single row of `array_id` into `id`.
//                          > ```
//
//                          Operate on the rolling window matrix from a different scope.
//
//                          > ```
//                          > var id = matrix.new<float>()
//                          > // Roll rows after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     var array_id = array.new<float>(5, close)
//                          >     id.roll(array_id, 3)
//                          > ```
//
//                          Matrices with initialized rows and columns can be used as a rolling window matrix.
//
//                          > ```
//                          > var id = matrix.new<float>(3, 5, 0.0)
//                          > var array_id = array.new<float>()
//                          > array_id.roll(close, 5)
//                          > // No `rows` parameter necessary, uses row size of `id` for `rows`.
//                          > id.roll(array_id)
//                          > ```
//
//                          The size of `array_id` matches the number of matrix columns.
//
//                          > ```
//                          > var id = matrix.new<float>(3, 5, 0.0) // 5 columns.
//                          > var array_id = array.new<float>()
//                          > array_id.roll(close, 5) // 5 elements (matches 5 columns).
//                          > id.roll(array_id, 3) // Rolls `array_id` into up to `3` rows of `id`.
//                          > ```
//
//                          When the matrix starts with `0` rows and `roll(rows = na)`,
//                          rows are dynamically added to the matrix up to the element limit then rolled out.
//
//                          > ```
//                          > var id = matrix.new<float>()
//                          > var array_id = array.new<float>()
//                          > array_id.roll(close, 100)
//                          > // Stores up to the element limit and then rolls rows.
//                          > id.roll(array_id)
//                          > ```
//
//                          Generates a runtime error if the `roll(rows)` parameter is smaller than the number of
//                          initialized rows in `id`.
//
//                          > ```
//                          > var id = matrix.new<float>(3, 5, 0.0)
//                          > var array_id = array.new<float>(5, close)
//                          > id.roll(array_id, 2) // Sets `rows` to a value of 2. Generates a runtime error!
//                          > // roll(matrix<float> id, array<float> array_id, int rows):
//                          > // `rows` (2) must be greater than or equal to the rows in `id` (3), or set to `na`!
//                          > ```
//
//                          A `rows` value less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = matrix.new<float>()
//                          > var array_id = array.new<float>(5, close)
//                          > id.roll(array_id, 654321)
//                          > // Example runtime error:
//                          > // roll(matrix<float> id, array<float> array_id, int rows):
//                          > // `rows` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Generates a runtime error if adding a column would exceed the 100,000 matrix size limit.
//
//                          > ```
//                          > var id = matrix.new<float>(1000, 100, 0.0) // 100,000 elements.
//                          > var array_id = array.new<float>(101, close) // 101 columns.
//                          > id.roll(array_id) // Attempting to add a column exceeds the limit.
//                          > // Example runtime error:
//                          > // roll(matrix<float> id, array<float> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method roll(matrix<float> id, array<float> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "roll(matrix<float> id, array<float> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "roll(matrix<float> id, array<float> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns()) // Add matrix columns when `id.columns() < array_id.size()`.
        while id.columns() < array_id.size()
            // Check that adding a new column won't exceed the matrix size limit.
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "roll(matrix<float> id, array<float> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    // Remove rows in case the number of new elements exceeds the matrix size limit.
    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        id.remove_row()

    if array_id.size() == id.columns() // Using `matrix.add_row(array_id)` requires `array_id.size() == id.columns()`.
        id.add_row(0, array_id) // Enqueue row.
    else // Set array elements into the matrix when `array_id.size() < id.columns()`.
        id.add_row(0) // Enqueue row.

        for [i, element] in array_id
            id.set(0, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        id.remove_row() // Dequeue row.
// }


// roll(matrix<int> id, array<int> array_id, int rows) {
// @function                Creates a rolling window using the rows of a matrix object.
//
//                          Removing the oldest row of a matrix and adding a new row is referred to as a *roll*.
//                          The function adds rows until the matrix is full, then begins to roll rows.
// @param id                A matrix object to use for the rolling window.
// @param array_id          The array containing values to append as a new row at index `0` into `id`.
// @param rows              Optional. The maximum number of rows in the `id` rolling window matrix.
//
//                          New rows are inserted into `id` at index `0` until the matrix rows reach the `rows` value,
//                          then the last row of `id` is removed before inserting a new row at index `0`.
//
//                          `rows = na` uses the initial number of rows in `id` as the maximum size.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on rows of `id`.
// ___
// **Usage**
//
//                          Create a rolling window matrix on a matrix declared with `var` bar persistence.
//
//                          > ```
//                          > var id = matrix.new<int>()
//                          > var array_id = array.new<int>()
//                          > array_id.roll(time, 5)
//                          > // Store up to `3` rows of `array_id` values and then begin to roll rows.
//                          > id.roll(array_id, 3)
//                          > ```
//
//                          Create a rolling window matrix on a matrix declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = matrix.new<int>()
//                          > varip array_id = array.new<int>()
//                          > array_id.roll(time, 5)
//                          > // Roll up to `10` intrabar rows of `array_id` into `id`.
//                          > id.roll(array_id, 10)
//                          > ```
//
//                          Ensure matrices are declared with `var` or `varip` keywords to store updated rows.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = matrix.new<int>() // No `var` or `varip` persistance.
//                          > array_id = array.new<int>(5, time)
//                          > id.roll(array_id, 3) // Only rolls a single row of `array_id` into `id`.
//                          > ```
//
//                          Operate on the rolling window matrix from a different scope.
//
//                          > ```
//                          > var id = matrix.new<int>()
//                          > // Roll rows after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     var array_id = array.new<int>(5, time)
//                          >     id.roll(array_id, 3)
//                          > ```
//
//                          Matrices with initialized rows and columns can be used as a rolling window matrix.
//
//                          > ```
//                          > var id = matrix.new<int>(3, 5, 0)
//                          > var array_id = array.new<int>()
//                          > array_id.roll(time, 5)
//                          > // No `rows` parameter necessary, uses row size of `id` for `rows`.
//                          > id.roll(array_id)
//                          > ```
//
//                          The size of `array_id` matches the number of matrix columns.
//
//                          > ```
//                          > var id = matrix.new<int>(3, 5, 0) // 5 columns.
//                          > var array_id = array.new<int>()
//                          > array_id.roll(time, 5) // 5 elements (matches 5 columns).
//                          > id.roll(array_id, 3) // Rolls `array_id` into up to `3` rows of `id`.
//                          > ```
//
//                          When the matrix starts with `0` rows and `roll(rows = na)`,
//                          rows are dynamically added to the matrix up to the element limit then rolled out.
//
//                          > ```
//                          > var id = matrix.new<int>()
//                          > var array_id = array.new<int>()
//                          > array_id.roll(time, 100)
//                          > // Stores up to the element limit and then rolls rows.
//                          > id.roll(array_id)
//                          > ```
//
//                          Generates a runtime error if the `roll(rows)` parameter is smaller than the number of
//                          initialized rows in `id`.
//
//                          > ```
//                          > var id = matrix.new<int>(3, 5, 0)
//                          > var array_id = array.new<int>(5, time)
//                          > id.roll(array_id, 2) // Sets `rows` to a value of 2. Generates a runtime error!
//                          > // roll(matrix<int> id, array<int> array_id, int rows):
//                          > // `rows` (2) must be greater than or equal to the rows in `id` (3), or set to `na`!
//                          > ```
//
//                          A `rows` value less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = matrix.new<int>()
//                          > var array_id = array.new<int>(5, time)
//                          > id.roll(array_id, 654321)
//                          > // Example runtime error:
//                          > // roll(matrix<int> id, array<int> array_id, int rows):
//                          > // `rows` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Generates a runtime error if adding a column would exceed the 100,000 matrix size limit.
//
//                          > ```
//                          > var id = matrix.new<int>(1000, 100, 0) // 100,000 elements.
//                          > var array_id = array.new<int>(101, time) // 101 columns.
//                          > id.roll(array_id) // Attempting to add a column exceeds the limit.
//                          > // Example runtime error:
//                          > // roll(matrix<int> id, array<int> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method roll(matrix<int> id, array<int> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "roll(matrix<int> id, array<int> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "roll(matrix<int> id, array<int> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the rows in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns())
        while id.columns() < array_id.size()
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "roll(matrix<int> id, array<int> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        id.remove_row()

    if array_id.size() == id.columns()
        id.add_row(0, array_id)
    else
        id.add_row(0)

        for [i, element] in array_id
            id.set(0, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        id.remove_row()
// }


// roll(matrix<string> id, array<string> array_id, int rows) {
// @function                Creates a rolling window using the rows of a matrix object.
//
//                          Removing the oldest row of a matrix and adding a new row is referred to as a *roll*.
//                          The function adds rows until the matrix is full, then begins to roll rows.
// @param id                A matrix object to use for the rolling window.
// @param array_id          The array containing values to append as a new row at index `0` into `id`.
// @param rows              Optional. The maximum number of rows in the `id` rolling window matrix.
//
//                          New rows are inserted into `id` at index `0` until the matrix rows reach the `rows` value,
//                          then the last row of `id` is removed before inserting a new row at index `0`.
//
//                          `rows = na` uses the initial number of rows in `id` as the maximum size.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on rows of `id`.
//
// **Usage**
//
//                          Create a rolling window matrix on a matrix declared with `var` bar persistence.
//
//                          > ```
//                          > var id = matrix.new<string>()
//                          > var array_id = array.new<string>()
//                          > array_id.roll(str.tostring(close), 5)
//                          > // Store up to `3` rows of `array_id` values and then begin to roll rows.
//                          > id.roll(array_id, 3)
//                          > ```
//
//                          Create a rolling window matrix on a matrix declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = matrix.new<string>()
//                          > varip array_id = array.new<string>()
//                          > array_id.roll(str.tostring(close), 5)
//                          > // Roll up to `10` intrabar rows of `array_id` into `id`.
//                          > id.roll(array_id, 10)
//                          > ```
//
//                          Ensure matrices are declared with `var` or `varip` keywords to store updated rows.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = matrix.new<string>() // No `var` or `varip` persistance.
//                          > array_id = array.new<string>(5, str.tostring(close))
//                          > id.roll(array_id, 3) // Only rolls a single row of `array_id` into `id`.
//                          > ```
//
//                          Operate on the rolling window matrix from a different scope.
//
//                          > ```
//                          > var id = matrix.new<string>()
//                          > // Roll rows after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     var array_id = array.new<string>(5, str.tostring(close))
//                          >     id.roll(array_id, 3)
//                          > ```
//
//                          Matrices with initialized rows and columns can be used as a rolling window matrix.
//
//                          > ```
//                          > var id = matrix.new<string>(3, 5, "")
//                          > var array_id = array.new<string>()
//                          > array_id.roll(str.tostring(close), 5)
//                          > // No `rows` parameter necessary, uses row size of `id` for `rows`.
//                          > id.roll(array_id)
//                          > ```
//
//                          The size of `array_id` matches the number of matrix columns.
//
//                          > ```
//                          > var id = matrix.new<string>(3, 5, "") // 5 columns.
//                          > var array_id = array.new<string>()
//                          > array_id.roll(str.tostring(close), 5) // 5 elements (matches 5 columns).
//                          > id.roll(array_id, 3) // Rolls `array_id` into up to `3` rows of `id`.
//                          > ```
//
//                          When the matrix starts with `0` rows and `roll(rows = na)`,
//                          rows are dynamically added to the matrix up to the element limit then rolled out.
//
//                          > ```
//                          > var id = matrix.new<string>()
//                          > var array_id = array.new<string>()
//                          > array_id.roll(str.tostring(close), 100)
//                          > // Stores up to the element limit and then rolls rows.
//                          > id.roll(array_id)
//                          > ```
//
//                          Generates a runtime error if the `roll(rows)` parameter is smaller than the number of
//                          initialized rows in `id`.
//
//                          > ```
//                          > var id = matrix.new<string>(3, 5, "")
//                          > var array_id = array.new<string>(5, str.tostring(close))
//                          > id.roll(array_id, 2) // Generates a runtime error!
//                          > // roll(matrix<string> id, array<string> array_id, int rows):
//                          > // `rows` (2) must be greater than or equal to the rows in `id` (3), or set to `na`!
//                          > ```
//
//                          A `rows` value less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = matrix.new<string>()
//                          > var array_id = array.new<string>(5, str.tostring(close))
//                          > id.roll(array_id, 654321)
//                          > // Example runtime error:
//                          > // roll(matrix<string> id, array<string> array_id, int rows):
//                          > // `rows` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Generates a runtime error if adding a column would exceed the 100,000 matrix size limit.
//
//                          > ```
//                          > var id = matrix.new<string>(1000, 100, "") // 100,000 elements.
//                          > var array_id = array.new<string>(101, str.tostring(close)) // 101 columns.
//                          > id.roll(array_id) // Attempting to add a column exceeds the limit.
//                          > // Example runtime error:
//                          > // roll(matrix<string> id, array<string> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method roll(matrix<string> id, array<string> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "roll(matrix<string> id, array<string> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "roll(matrix<string> id, array<string> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns())
        while id.columns() < array_id.size()
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "roll(matrix<string> id, array<string> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        id.remove_row()

    if array_id.size() == id.columns()
        id.add_row(0, array_id)
    else
        id.add_row(0)

        for [i, element] in array_id
            id.set(0, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        id.remove_row()
// }


