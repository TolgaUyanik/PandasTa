//                          > var window = array.new<table>()
//                          > var newTable = table.new(position.bottom_center, 1, 1)
//                          > // Store up to `3` elements and then begin to reverse roll elements.
//                          > rw.rollReverse(id = window, source = newTable, size = 3)
//                          > // Alternatively: id.rollReverse(newTable, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<table>()
//                          > varip newTable = table.new(position.bottom_center, 1, 1)
//                          > // Roll up to `1000` intrabar `newTable` values into `id` in reverse order.
//                          > id.rollReverse(source = newTable, size = 1000)
//                          > // Alternatively: id.rollReverse(newTable, 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `rollReverse()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<table>() // No `var` or `varip` persistance.
//                          > var newTable = table.new(position.bottom_center, 1, 1)
//                          > id.rollReverse(newTable, 3) // Only reverse rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<table>()
//                          > var newTable = table.new(position.bottom_center, 1, 1)
//                          > // Reverse roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.rollReverse(newTable, 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<table>(size = 12)
//                          > var newTable = table.new(position.bottom_center, 1, 1)
//                          > id.rollReverse(newTable)
//                          > // `rollReverse(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<table>()
//                          > var newTable = table.new(position.bottom_center, 1, 1)
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollReverse(newTable, size = na)
//                          > ```
//
//                          Generates a runtime error if the `rollReverse(size)` parameter is smaller
//                          than the size of `id`.
//
//                          > ```
//                          > var id = array.new<table>(size = 12)
//                          > var newTable = table.new(position.bottom_center, 1, 1)
//                          > id.rollReverse(newTable, 3)
//                          > // Example runtime error:
//                          > // rollReverse(array<table> id, table source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<table>()
//                          > var newTable = table.new(position.bottom_center, 1, 1)
//                          > id.rollReverse(newTable, 654321)
//                          > // Example runtime error:
//                          > // rollReverse(array<table> id, table source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
export method rollReverse(array<table> id, table source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollReverse(array<table> id, table source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollReverse(array<table> id, table source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.pop().delete()

    id.unshift(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.pop().delete()
// }


// rollReverse(array<footprint>, footprint source, int size) {
// @function                Creates a rolling window using an array object with elements in reverse order.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to insert at the beginning as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are inserted to `id` at index `0` until the array's size reaches the `size`
//                          value, then the oldest element at the last index is removed before inserting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var id = array.new<footprint>()
//                          > // Store up to `3` footprint objects and then begin to reverse roll elements.
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.rollReverse(source = reqFootprint, size = 3)
//                          > // Alternatively: id.rollReverse(reqFootprint, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.rollReverse(source = reqFootprint, size = 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `rollReverse()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<footprint>() // No `var` or `varip` persistance.
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.rollReverse(reqFootprint, 3)
//                          > ```
//
//                          Arrays with initialized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<footprint>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.rollReverse(reqFootprint)
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     // Stores up to the element limit and then rolls elements.
//                          >     id.rollReverse(reqFootprint, size = na)
//                          > ```
//
//                          Generates a runtime error if the `rollReverse(size)` parameter is smaller
//                          than the size of `id`.
//
//                          > ```
//                          > var id = array.new<footprint>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.rollReverse(reqFootprint, 3)
//                          > // Example runtime error:
//                          > // rollReverse(array<footprint> id, footprint source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.rollReverse(reqFootprint, 654321)
//                          > // Example runtime error:
//                          > // rollReverse(array<footprint> id, footprint source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<footprint>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     footprint removedElement = id.rollReverse(reqFootprint)
//                          > ```
export method rollReverse(array<footprint> id, footprint source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollReverse(array<footprint> id, footprint source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollReverse(array<footprint> id, footprint source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.pop()

    id.unshift(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.pop()
// }


// rollReverse(array<volume_row>, volume_row source, int size) {
// @function                Creates a rolling window using an array object with elements in reverse order.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to insert at the beginning as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are inserted to `id` at index `0` until the array's size reaches the `size`
//                          value, then the oldest element at the last index is removed before inserting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     rw.rollReverse(id = window, source = pocRow, size = 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     id.rollReverse(source = pocRow, size = 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `rollReverse()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<volume_row>() // No `var` or `varip` persistance.
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     id.rollReverse(pocRow, 3)
//                          > ```
//
//                          Arrays with initialized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<volume_row>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     array<volume_row> footprintRows = reqFootprint.rows()
//                          >     if footprintRows.size() > 0
//                          >         id.rollReverse(footprintRows.get(0))
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     // Stores up to the element limit and then rolls elements.
//                          >     id.rollReverse(pocRow, size = na)
//                          > ```
//
//                          Generates a runtime error if the `rollReverse(size)` parameter is smaller
//                          than the size of `id`.
//
//                          > ```
//                          > var id = array.new<volume_row>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     id.rollReverse(pocRow, 3)
//                          > // Example runtime error:
//                          > // rollReverse(array<volume_row> id, volume_row source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     id.rollReverse(pocRow, 654321)
//                          > // Example runtime error:
//                          > // rollReverse(array<volume_row> id, volume_row source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<volume_row>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     volume_row removedElement = id.rollReverse(pocRow)
//                          > ```
export method rollReverse(array<volume_row> id, volume_row source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollReverse(array<volume_row> id, volume_row source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollReverse(array<volume_row> id, volume_row source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.pop()

    id.unshift(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.pop()
// }



//#endregion rollReverse() Methods



//#region rollAscendingVar() and rollAscendingVarip() Methods



// rollAscendingVar(array<float> id, float source, int size = na) {
// @function                Creates an ascending sorted rolling window using a `var` bar persistant array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                A `var` bar persistant array object to use for the ascending sorted rolling window.
// @param source            The value to sort as an element to `id`. Values of `na` will not be sorted.
// @param size              Optional. The maximum size of the `id` ascending sorted rolling window array.
//
//                          New elements are sorted in `id` until it reaches same size as the `size` value, then
//                          the oldest (last sorted) element of `id` is removed before sorting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<float>()
//                          > // Store up to `3` elements and then begin to roll elements.
//                          > rw.rollAscendingVar(id = window, source = close, size = 3)
//                          > // Alternatively: id.rollAscendingVar(close, 3)
//                          > ```
//
//                          If `varip` intrabar persistence is needed, use `rollAscendingVarip()` instead.
//
//                          Ensure arrays are declared with `var` keyword to store updated elements.
//                          Otherwise, applying `rollAscendingVar()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<float>() // No `var` persistance.
//                          > id.rollAscendingVar(close, 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on the rolling window array from a different scope.
//
//                          > ```
//                          > var id = array.new<float>()
//                          > // Roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.rollAscendingVar(close, 3)
//                          > ```
//
//                          Initialize an array with elements, which makes the `size` parameter optional.
//
//                          > ```
//                          > var id = array.new<float>(size = 10)
//                          > // No `size` parameter necessary, uses size of `id` for `size`.
//                          > id.rollAscendingVar(close)
//                          > // Alternatively: id.rollAscendingVar(close)
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<float>()
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollAscendingVar(close, size = na)
//                          > ```
//
//                          Arrays must be in ascending order for rolled elements to be inserted at the correct index.
//
//                          > ```
//                          > var array<float> id = array.from(3.14, 1.17, 6.0) // Unsorted initalized array.
//                          > id.sort(order.ascending) // Sort it first!
//                          > id.rollAscendingVar(bar_index)
//                          > ```
//
//                          Generates a runtime error if the `size` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > var id = array.new<float>(0.0, 12.0)
//                          > id.rollAscendingVar(close, 3)
//                          > // Example runtime error:
//                          > // rollAscendingVar(array<float> id, float source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<float>()
//                          > id.rollAscendingVar(close, 654321)
//                          > // Example runtime error:
//                          > // rollAscendingVar(array<float> id, float source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<float>(size = 3)
//                          > float removedElement = id.rollAscendingVar(close, 3)
//                          > ```
export method rollAscendingVar(array<float> id, float source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollAscendingVar(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size() // Save initial size for comparison after `id` is modified.

    if size < idLastSize // Prevents inserting new elements in `id` between function calls past the set `size` value.
        string idSizeError = "rollAscendingVar(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    var array<float> idQueue = id.copy() // Intermediary array tracks the order of elements.

    if idQueue.size() != idLastSize // Ensures parity between `idQueue` when `id` is modified between roll updates.
        idQueue := id.copy()

    if ARRAY_SIZE_LIMIT == idQueue.size() // Prevents adding 100,001st elements.
        float oldestElement = idQueue.shift()
        id.remove(id.indexof(oldestElement))

    if not na(source)
        idQueue.push(source)
        id.insert(id.binary_search_rightmost(source), source) // Ascending binary insertion sort.

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        float oldestElement = idQueue.shift()
        id.remove(id.indexof(oldestElement)) // Remove oldest, sorted element.
// }


// rollAscendingVar(array<int> id, int source, int size = na) {
// @function                Creates an ascending sorted rolling window using a `var` bar persistant array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                A `var` bar persistant array object to use for the ascending sorted rolling window.
// @param source            The value to sort as an element to `id`. Values of `na` will not be sorted.
// @param size              Optional. The maximum size of the `id` ascending sorted rolling window array.
//
//                          New elements are sorted in `id` until it reaches same size as the `size` value, then
//                          the oldest (last sorted) element of `id` is removed before sorting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<int>()
//                          > // Store up to `3` elements and then begin to roll elements.
//                          > rw.rollAscendingVar(id = window, source = time, size = 3)
//                          > // Alternatively: id.rollAscendingVar(time, 3)
//                          > ```
//
//                          If `varip` intrabar persistence is needed, use `rollAscendingVarip()` instead.
//
//                          Ensure arrays are declared with `var` keyword to store updated elements.
//                          Otherwise, applying `rollAscendingVar()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<int>() // No `var` persistance.
//                          > id.rollAscendingVar(time, 3) // Only rolls a single element.
//                          > ```
//
//                          Operate on the rolling window array from a different scope.
//
//                          > ```
//                          > var id = array.new<int>()
//                          > // Roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.rollAscendingVar(time, 3)
//                          > ```
//
//                          Initialize an array with elements, which makes the `size` parameter optional.
//
//                          > ```
//                          > var id = array.new<int>(0, 6, 12)
//                          > // No `size` parameter necessary, uses size of `id` for `size`.
//                          > id.rollAscendingVar(time)
//                          > // Alternatively: id.rollAscendingVar(time)
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<int>()
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollAscendingVar(time, size = na)
//                          > ```
//
//                          Arrays must be in ascending order for rolled elements to be inserted at the correct index.
//
//                          > ```
//                          > var array<int> id = array.from(3, 1, 6) // Unsorted initalized array.
//                          > id.sort(order.ascending) // Sort it first!
//                          > id.rollAscendingVar(bar_index)
//                          > ```
//
//                          Generates a runtime error if the `size` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > var id = array.new<int>(0, 12)
//                          > id.rollAscendingVar(time, 3)
//                          > // Example runtime error:
//                          > // rollAscendingVar(array<int> id, int source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<int>()
//                          > id.rollAscendingVar(time, 654321)
//                          > // Example runtime error:
//                          > // rollAscendingVar(array<int> id, int source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<int>(size = 3)
//                          > int removedElement = id.rollAscendingVar(time, 3)
//                          > ```
export method rollAscendingVar(array<int> id, int source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollAscendingVar(array<int> id, int source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollAscendingVar(array<int> id, int source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    var array<int> idQueue = id.copy()

    if idQueue.size() != idLastSize
        idQueue := id.copy()

    if ARRAY_SIZE_LIMIT == idQueue.size()
        oldestElement = idQueue.shift()
        id.remove(id.indexof(oldestElement))

    if not na(source)
        idQueue.push(source)
        id.insert(id.binary_search_rightmost(source), source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        oldestElement = idQueue.shift()
        id.remove(id.indexof(oldestElement))
