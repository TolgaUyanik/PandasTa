// roll(array<footprint> id, footprint source, int size) {
// @function                Creates a rolling window using an array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to append as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are appended into `id` until the array's size reaches the `size` value, then
//                          the oldest element at index `0` index is removed before appending a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var id = array.new<footprint>()
//                          > // Store up to `3` footprint objects and then begin to roll elements.
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.roll(source = reqFootprint, size = 3)
//                          > // Alternatively: window.roll(reqFootprint, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.roll(source = reqFootprint, size = 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<footprint>() // No `var` or `varip` persistance.
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.roll(reqFootprint, 3)
//                          > ```
//
//                          Arrays with initialized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<footprint>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.roll(reqFootprint)
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     // Stores up to the element limit and then rolls elements.
//                          >     id.roll(reqFootprint, size = na)
//                          > ```
//
//                          Generates a runtime error if the `roll(size)` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > var id = array.new<footprint>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.roll(reqFootprint, 3)
//                          > // Example runtime error:
//                          > // roll(array<footprint> id, footprint source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     id.roll(reqFootprint, 654321)
//                          > // Example runtime error:
//                          > // roll(array<footprint> id, footprint source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<footprint>(size = 3)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     removedElement = id.roll(reqFootprint, 3)
//                          > ```
export method roll(array<footprint> id, footprint source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "roll(array<footprint> id, footprint source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "roll(array<footprint> id, footprint source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.shift()

    id.push(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.shift()
// }


// roll(array<volume_row> id, volume_row source, int size) {
// @function                Creates a rolling window using an array object.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to append as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are appended into `id` until the array's size reaches the `size` value, then
//                          the oldest element at index `0` index is removed before appending a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     rw.roll(id = window, source = pocRow, size = 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     id.roll(source = pocRow, size = 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<volume_row>() // No `var` or `varip` persistance.
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     id.roll(pocRow, 3)
//                          > ```
//
//                          Arrays with initialized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<volume_row>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//
//                          > if not na(reqFootprint)
//                          >     array<volume_row> footprintRows = reqFootprint.rows()
//                          >     if footprintRows.size() > 0
//                          >         id.roll(footprintRows.get(0))
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     // Stores up to the element limit and then rolls elements.
//                          >     id.roll(pocRow, size = na)
//                          > ```
//
//                          Generates a runtime error if the `roll(size)` parameter is smaller than the size of `id`.
//
//                          > ```
//                          > var id = array.new<volume_row>(size = 12)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     id.roll(pocRow, 3)
//                          > // Example runtime error:
//                          > // roll(array<volume_row> id, volume_row source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     id.roll(pocRow, 654321)
//                          > // Example runtime error:
//                          > // roll(array<volume_row> id, volume_row source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     removedElement = id.roll(pocRow, 3)
//                          > ```
export method roll(array<volume_row> id, volume_row source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "roll(array<volume_row> id, volume_row source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "roll(array<volume_row> id, volume_row source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize
        id.shift()

    id.push(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.shift()
// }



//#endregion roll() Methods



//#region rollReverse() Methods



// rollReverse(array<float>, float source, int size) {
// @function                Creates a rolling window using an array object with elements in reverse order.
//
//                          Removing the oldest element of an array and adding a new one is referred to as a *roll*.
//                          The function adds elements until the array is full, then begins to roll elements.
// @param id                An array object to use for the rolling window.
// @param source            The value to insert at the beginning as an element to `id`.
// @param size              Optional. The maximum size of the `id` rolling window array.
//
//                          New elements are inserted to `id` at index `0` until the array's size reaches the `size`
//                          value, then the oldest element at the last index is removed before inserting a new element.
//
//                          `size = na` uses the initial size of `id` as the maximum size of the rolling window array.
//
//                          Default is `na`.
// @returns                 The last removed element from `id`. Operates on elements of `id`.
// ___
// **Usage**
//
//                          Create a rolling window array on an array declared with `var` bar persistence.
//
//                          > ```
//                          > var window = array.new<float>()
//                          > // Store up to `3` elements and then begin to reverse roll elements.
//                          > rw.rollReverse(id = window, source = close, size = 3)
//                          > // Alternatively: id.rollReverse(close, 3)
//                          > ```
//
//                          Create a rolling window array on an array declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = array.new<float>()
//                          > // Roll up to `1000` intrabar `close` values into `id` in reverse order.
//                          > id.rollReverse(source = close, size = 1000)
//                          > // Alternatively: id.rollReverse(close, 1000)
//                          > ```
//
//                          Ensure arrays are declared with `var` or `varip` keywords to store updated elements.
//                          Otherwise, applying `rollReverse()` on them will not store rolled values.
//
//                          > ```
//                          > id = array.new<float>() // No `var` or `varip` persistance.
//                          > id.rollReverse(close, 3) // Only reverse rolls a single element.
//                          > ```
//
//                          Operate on arrays from a different scope.
//
//                          > ```
//                          > var id = array.new<float>()
//                          > // Reverse roll elements after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     id.rollReverse(close, 3)
//                          > ```
//
//                          Arrays with initalized values and sizes can be used as a rolling window array.
//
//                          > ```
//                          > var id = array.new<float>(size = 12)
//                          > id.rollReverse(close)
//                          > // `rollReverse(size)` parameter is optional for arrays with an initalized size.
//                          > ```
//
//                          When the array starts with `0` elements and `roll(size = na)`,
//                          elements are dynamically added to the array up to the element limit then rolled out.
//
//                          > ```
//                          > var id = array.new<float>()
//                          > // Stores up to the element limit and then rolls elements.
//                          > id.rollReverse(close, size = na)
//                          > ```
//
//                          Generates a runtime error if the `rollReverse(size)` parameter is smaller
//                          than the size of `id`.
//
//                          > ```
//                          > var id = array.new<float>(size = 12)
//                          > id.rollReverse(close, 3)
//                          > // Example runtime error:
//                          > // rollReverse(array<float> id, float source, int size):
//                          > // `size` (3) must be greater than or equal to the size of `id` (12), or set to `na`!
//                          > ```
//
//                          A `size` less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = array.new<float>()
//                          > id.rollReverse(close, 654321)
//                          > // Example runtime error:
//                          > // rollReverse(array<float> id, float source, int size):
//                          > // `size` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Return the last removed, rolled out, element.
//
//                          > ```
//                          > var id = array.new<float>(size = 3)
//                          > float removedElement = id.rollReverse(close, 3)
//                          > ```
export method rollReverse(array<float> id, float source, int size = na) =>
    if size < 0 or ARRAY_SIZE_LIMIT < size
        string windowSizeError = "rollReverse(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must not be less than 0 or greater than "
          + str.tostring(ARRAY_SIZE_LIMIT) + "!"

        runtime.error(windowSizeError)

    int idLastSize = id.size()
    var int idInitialSize = id.size()

    if size < idLastSize
        string idSizeError = "rollReverse(array<float> id, float source, int size): "
          + "`size` (" + str.tostring(size) + ") must be greater than or equal to the size of `id` ("
          + str.tostring(idLastSize) + "), or set to `na`!"

        runtime.error(idSizeError)

    if ARRAY_SIZE_LIMIT == idLastSize // Prevents unshifting a 100,001st element.
        id.pop()

    id.unshift(source)

    if (na(size) and idInitialSize == 0 ? na : na(size) and idInitialSize > 0 ? idLastSize : size) < id.size()
        id.pop()
// }


// rollReverse(array<int> id, int source, int size) {
