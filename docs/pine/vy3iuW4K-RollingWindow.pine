    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "rollReverse(matrix<label> id, array<label> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

