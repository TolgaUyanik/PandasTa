export method rollReverse(matrix<table> id, array<table> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "rollReverse(matrix<table> id, array<table> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "rollReverse(matrix<table> id, array<table> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns())
        while id.columns() < array_id.size()
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "rollReverse(matrix<table> id, array<table> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        id.remove_row(0)

    if array_id.size() == id.columns()
        id.add_row(id.rows(), array_id)
    else
        id.add_row(id.rows())

        for [i, element] in array_id
            id.set(id.rows() - 1, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        id.remove_row(0)
// }


// rollReverse(matrix<footprint> id, array<footprint> array_id, int rows) {
// @function                Creates a rolling window using the rows of a matrix object with rows in reverse order.
//
//                          Removing the oldest row of a matrix and adding a new row is referred to as a *roll*.

//                          The function adds rows until the matrix is full, then begins to reverse roll rows.
// @param id                A matrix object to use for the rolling window.
// @param array_id          The array containing values to append as a new row at the last index into `id`.
// @param rows              Optional. The maximum number of rows in the `id` rolling window matrix.
//
//                          New rows are inserted into `id` at index `0` until the matrix rows reach the `rows` value,
//                          then the oldest row at the last row index is removed before inserting a new row.
//
//                          `rows = na` uses the initial number of rows in `id` as the maximum rows.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on rows of `id`.
// ___
// **Usage**
//
//                          Create a rolling window matrix on a matrix declared with `var` bar persistence.
//
//                          > ```
//                          > var id = matrix.new<footprint>()
//                          > var array_id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     array_id.roll(reqFootprint, 5)
//                          >     // Store up to `3` rows of `array_id` values and then begin to reverse roll rows.
//                          >     id.rollReverse(array_id, 3)
//                          > ```
//
//                          Create a rolling window matrix on a matrix declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = matrix.new<footprint>()
//                          > varip array_id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     array_id.roll(reqFootprint, 5)
//                          >     // Reverse roll up to `10` intrabar rows of `array_id` into `id`.
//                          >     id.rollReverse(array_id, 10)
//                          > ```
//
//                          Ensure matrices are declared with `var` or `varip` keywords to store updated rows.
//                          Otherwise, applying `rollReverse()` on them will not store rolled values.
//
//                          > ```
//                          > id = matrix.new<footprint>() // No `var` or `varip` persistance.
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     var array_id = array.new<footprint>(5, reqFootprint)
//                          >     id.rollReverse(array_id, 3) // Only reverse rolls a single row of `array_id` into `id`.
//                          > ```
//
//                          Matrices with initialized rows and columns can be used as a rolling window matrix.
//
//                          > ```
//                          > var id = matrix.new<footprint>(3, 5, reqFootprint)
//                          > var array_id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     array_id.roll(reqFootprint, 5)
//                          >     // No `rows` parameter necessary, uses row size of `id` for `rows`.
//                          >     id.rollReverse(array_id)
//                          > ```
//
//                          The size of `array_id` matches the number of matrix columns.
//
//                          > ```
//                          > var id = matrix.new<footprint>(3, 5, reqFootprint) // 5 columns
//                          > var array_id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     array_id.roll(reqFootprint, 5) // 5 elements (matches 5 columns).
//                          >     id.rollReverse(array_id, 3) // Reverse rolls `array_id` into up to `3` rows of `id`.
//                          > ```
//
//                          When the matrix starts with `0` rows and `rollReverse(rows = na)`,
//                          rows are dynamically added to the matrix up to the element limit then rolled out.
//
//                          > ```
//                          > var id = matrix.new<footprint>()
//                          > var array_id = array.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     array_id.roll(reqFootprint, 100)
//                          >     // Stores up to the element limit and then reverse rolls rows.
//                          >     id.rollReverse(array_id)
//                          > ```
//
//                          Generates a runtime error if the `rollReverse(rows)` parameter is smaller than the number of
//                          initialized rows in `id`.
//
//                          > ```
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     var id = matrix.new<footprint>(3, 5, reqFootprint)
//                          >     var array_id = array.new<footprint>(5, reqFootprint)
//                          >     id.rollReverse(array_id, 2) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // rollReverse(matrix<footprint> id, array<footprint> array_id, int rows):
//                          > // `rows` (2) must be greater than or equal to the rows in `id` (3), or set to `na`!
//                          > ```
//
//                          A `rows` value less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = matrix.new<footprint>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     var array_id = array.new<footprint>(5, reqFootprint)
//                          >     id.rollReverse(array_id, 654321)
//                          > // Example runtime error:
//                          > // rollReverse(matrix<footprint> id, array<footprint> array_id, int rows):
//                          > // `rows` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Generates a runtime error if adding a column would exceed the 100,000 matrix size limit.
//
//                          > ```
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     var id = matrix.new<footprint>(1000, 100, reqFootprint) // 100,000 elements.
//                          >     var array_id = array.new<footprint>(101, reqFootprint) // 101 columns.
//                          >     id.rollReverse(array_id) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // rollReverse(matrix<footprint> id, array<footprint> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method rollReverse(matrix<footprint> id, array<footprint> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "rollReverse(matrix<footprint> id, array<footprint> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "rollReverse(matrix<footprint> id, array<footprint> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns())
        while id.columns() < array_id.size()
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "rollReverse(matrix<footprint> id, array<footprint> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        id.remove_row(0)

    if array_id.size() == id.columns()
        id.add_row(id.rows(), array_id)
    else
        id.add_row(id.rows())

        for [i, element] in array_id
            id.set(id.rows() - 1, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        id.remove_row(0)
// }


// rollReverse(matrix<volume_row> id, array<volume_row> array_id, int rows) {
// @function                Creates a rolling window using the rows of a matrix object with rows in reverse order.
//
//                          Removing the oldest row of a matrix and adding a new row is referred to as a *roll*.
//                          The function adds rows until the matrix is full, then begins to reverse roll rows.
// @param id                A matrix object to use for the rolling window.
// @param array_id          The array containing values to append as a new row at the last index into `id`.
// @param rows              Optional. The maximum number of rows in the `id` rolling window matrix.
//
//                          New rows are inserted into `id` at index `0` until the matrix rows reach the `rows` value,
//                          then the oldest row at the last row index is removed before inserting a new row.
//
//                          `rows = na` uses the initial number of rows in `id` as the maximum rows.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on rows of `id`.
// ___
// **Usage**
//
//                          Create a rolling window matrix on a matrix declared with `var` bar persistence.
//
//                          > ```
//                          > var id = matrix.new<volume_row>()
//                          > var array_id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     array_id.roll(pocRow, 5)
//                          >     // Store up to `3` rows of `array_id` values and then begin to reverse roll rows.
//                          >     id.rollReverse(array_id, 3)
//                          > ```
//
//                          Create a rolling window matrix on a matrix declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = matrix.new<volume_row>()
//                          > varip array_id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     array_id.roll(pocRow, 5)
//                          >     // Reverse roll up to `10` intrabar rows of `array_id` into `id`.
//                          > id.rollReverse(array_id, 10)
//                          > ```
//
//                          Ensure matrices are declared with `var` or `varip` keywords to store updated rows.
//                          Otherwise, applying `rollReverse()` on them will not store rolled values.
//
//                          > ```
//                          > id = matrix.new<volume_row>() // No `var` or `varip` persistance.
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row vah = reqFootprint.vah()
//                          >     volume_row val = reqFootprint.val()
//                          >     volume_row poc = reqFootprint.poc()
//                          >     array<volume_row> valueAreas = array.from(vah, val, poc)
//                          >     id.roll(valueAreas, 3) // Only reverse rolls a single row of `valueAreas` into `id`.
//                          > ```
//
//                          Matrices with initialized rows and columns can be used as a rolling window matrix.
//
//                          > ```
//                          > var id = matrix.new<volume_row>(rows = 3, columns = 3)
//                          > var array_id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     array_id.roll(pocRow, 5)
//                          >     // No `rows` parameter necessary, uses row size of `id` for `rows`.
//                          >     id.rollReverse(array_id)
//                          > ```
//
//                          The size of `array_id` matches the number of matrix columns.
//
//                          > ```
//                          > var id = matrix.new<volume_row>()
//                          > var array_id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     array_id.roll(pocRow, 5) // 5 elements (matches 5 columns).
//                          >     id.rollReverse(array_id, 3) // Reverse rolls `array_id` into up to `3` rows of `id`.
//                          > ```
//
//                          When the matrix starts with `0` rows and `rollReverse(rows = na)`,
//                          rows are dynamically added to the matrix up to the element limit then rolled out.
//
//                          > ```
//                          > var id = matrix.new<volume_row>()
//                          > var array_id = array.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     array_id.roll(pocRow, 100)
//                          >     // Stores up to the element limit and then reverse rolls rows.
//                          >     id.rollReverse(array_id)
//                          > ```
//
//                          Generates a runtime error if the `rollReverse(rows)` parameter is smaller than the number of
//                          initialized rows in `id`.
//
//                          > ```
//                          > var id = matrix.new<volume_row>(3, 5)
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     var array_id = array.new<volume_row>(5, reqFootprint.poc())
//                          >     id.rollReverse(array_id, 2) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // rollReverse(matrix<volume_row> id, array<volume_row> array_id, int rows):
//                          > // `rows` (2) must be greater than or equal to the rows in `id` (3), or set to `na`!
//                          > ```
//
//                          A `rows` value less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = matrix.new<volume_row>()
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     array<volume_row> footprintRows = reqFootprint.rows() // Number of elements vary.
//                          >     id.roll(footprintRows, 654321) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // rollReverse(matrix<volume_row> id, array<volume_row> array_id, int rows):
//                          > // `rows` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Generates a runtime error if adding a column would exceed the 100,000 matrix size limit.
//
//                          > ```
//                          > footprint reqFootprint = request.footprint(100)
//                          > if not na(reqFootprint)
//                          >     volume_row pocRow = reqFootprint.poc()
//                          >     var id = matrix.new<volume_row>(1000, 100, pocRow) // 100,000 elements.
//                          >     var array_id = array.new<volume_row>(101, pocRow) // 101 columns.
//                          >     id.rollReverse(array_id) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // rollReverse(matrix<volume_row> id, array<volume_row> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method rollReverse(matrix<volume_row> id, array<volume_row> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "rollReverse(matrix<volume_row> id, array<volume_row> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "rollReverse(matrix<volume_row> id, array<volume_row> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns())
        while id.columns() < array_id.size()
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "rollReverse(matrix<volume_row> id, array<volume_row> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        id.remove_row(0)

    if array_id.size() == id.columns()
        id.add_row(id.rows(), array_id)
    else
        id.add_row(id.rows())

        for [i, element] in array_id
            id.set(id.rows() - 1, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        id.remove_row(0)
