// roll(matrix<linefill> id, array<linefill> array_id, int rows) {
// @function                Creates a rolling window using the rows of a matrix object.
//
//                          Removing the oldest row of a matrix and adding a new row is referred to as a *roll*.
//                          The function adds rows until the matrix is full, then begins to roll rows.
// @param id                A matrix object to use for the rolling window.
// @param array_id          The array containing values to append as a new row at index `0` into `id`.
// @param rows              Optional. The maximum number of rows in the `id` rolling window matrix.
//
//                          New rows are inserted into `id` at index `0` until the matrix rows reach the `rows` value,
//                          then the last row of `id` is removed before inserting a new row at index `0`.
//
//                          `rows = na` uses the initial number of rows in `id` as the maximum size.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on rows of `id`.
// ___
// **Usage**
//
//                          Create a rolling window matrix on a matrix declared with `var` bar persistence.
//
//                          > ```
//                          > var id = matrix.new<linefill>()
//                          > var array_id = array.new<linefill>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > array_id.roll(newFill, 5)
//                          > // Store up to `3` rows of `array_id` values and then begin to roll rows.
//                          > id.roll(array_id, 3)
//                          > ```
//
//                          Create a rolling window matrix on a matrix declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = matrix.new<linefill>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > varip array_id = array.new<linefill>()
//                          > array_id.roll(newFill, 5)
//                          > // Roll up to `10` intrabar rows of `array_id` into `id`.
//                          > id.roll(array_id, 10)
//                          > ```
//
//                          Ensure matrices are declared with `var` or `varip` keywords to store updated rows.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = matrix.new<linefill>() // No `var` or `varip` persistance.
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > var array_id = array.new<linefill>(5, newFill)
//                          > id.roll(array_id, 3) // Only rolls a single row of `array_id` into `id`.
//                          > ```
//
//                          Operate on the rolling window matrix from a different scope.
//
//                          > ```
//                          > var id = matrix.new<linefill>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > // Roll rows after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     var array_id = array.new<linefill>(5, newFill)
//                          >     id.roll(array_id, 3)
//                          > ```
//
//                          Matrices with initialized rows and columns can be used as a rolling window matrix.
//
//                          > ```
//                          > var id = matrix.new<linefill>(3, 5, na)
//                          > var array_id = array.new<linefill>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > array_id.roll(newFill, 5)
//                          > // No `rows` parameter necessary, uses row size of `id` for `rows`.
//                          > id.roll(array_id)
//                          > ```
//
//                          The size of `array_id` matches the number of matrix columns.
//
//                          > ```
//                          > var id = matrix.new<linefill>(3, 5, na) // 5 columns.
//                          > var array_id = array.new<linefill>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > array_id.roll(newFill, 5) // 5 elements (matches 5 columns).
//                          > id.roll(array_id, 3) // Rolls `array_id` into up to `3` rows of `id`.
//                          > ```
//
//                          When the matrix starts with `0` rows and `roll(rows = na)`,
//                          rows are dynamically added to the matrix up to the element limit then rolled out.
//
//                          > ```
//                          > var id = matrix.new<linefill>()
//                          > var array_id = array.new<linefill>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > array_id.roll(newFill, 100)
//                          > // Stores up to the element limit and then rolls rows.
//                          > id.roll(array_id)
//                          > ```
//
//                          Generates a runtime error if the `roll(rows)` parameter is smaller than the number of
//                          initialized rows in `id`.
//
//                          > ```
//                          > var id = matrix.new<linefill>(3, 5, na)
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > var array_id = array.new<linefill>(5, newFill)
//                          > id.roll(array_id, 2) // Sets `rows` to a value of 2. Generates a runtime error!
//                          > // roll(matrix<linefill> id, array<linefill> array_id, int rows):
//                          > // `rows` (2) must be greater than or equal to the rows in `id` (3), or set to `na`!
//                          > ```
//
//                          A `rows` value less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = matrix.new<linefill>()
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > var array_id = array.new<linefill>(5, newFill)
//                          > id.roll(array_id, 654321)
//                          > // Example runtime error:
//                          > // roll(matrix<linefill> id, array<linefill> array_id, int rows):
//                          > // `rows` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Generates a runtime error if adding a column would exceed the 100,000 matrix size limit.

//
//                          > ```
//                          > var id = matrix.new<linefill>(1000, 100, na) // 100,000 elements.
//                          > chart.point point1 = chart.point.now(close)
//                          > chart.point point2 = chart.point.new(time[3], bar_index[3], close[3])
//                          > line upperLine = line.new(point1, point2, xloc.bar_index)
//                          > line lowerLine = line.new(point1, point2, xloc.bar_index)
//                          > linefill newFill = linefill.new(upperLine, lowerLine)
//                          > var array_id = array.new<linefill>(101, newFill) // 101 columns.
//                          > id.roll(array_id) // Attempting to add a column exceeds the limit.
//                          > // Example runtime error:
//                          > // roll(matrix<linefill> id, array<linefill> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method roll(matrix<linefill> id, array<linefill> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "roll(matrix<linefill> id, array<linefill> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "roll(matrix<linefill> id, array<linefill> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns())
        while id.columns() < array_id.size()
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "roll(matrix<linefill> id, array<linefill> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        for i in id.row(id.rows() - 1)
            i.delete()
        id.remove_row()

    if array_id.size() == id.columns()
        id.add_row(0, array_id)
    else
        id.add_row(0)

        for [i, element] in array_id
            id.set(0, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        for i in id.row(id.rows() - 1)
            i.delete()
        id.remove_row()
// }


// roll(matrix<label> id, array<label> array_id, int rows) {
// @function                Creates a rolling window using the rows of a matrix object.
//
//                          Removing the oldest row of a matrix and adding a new row is referred to as a *roll*.
//                          The function adds rows until the matrix is full, then begins to roll rows.
// @param id                A matrix object to use for the rolling window.
// @param array_id          The array containing values to append as a new row at index `0` into `id`.
// @param rows              Optional. The maximum number of rows in the `id` rolling window matrix.
//
//                          New rows are inserted into `id` at index `0` until the matrix rows reach the `rows` value,
//                          then the last row of `id` is removed before inserting a new row at index `0`.
//
//                          `rows = na` uses the initial number of rows in `id` as the maximum size.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on rows of `id`.
// ___
// **Usage**
//
//                          Create a rolling window matrix on a matrix declared with `var` bar persistence.
//
//                          > ```
//                          > var id = matrix.new<label>()
//                          > var array_id = array.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > array_id.roll(newLabel, 5)
//                          > // Store up to `3` rows of `array_id` values and then begin to roll rows.
//                          > id.roll(array_id, 3)
//                          > ```
//
//                          Create a rolling window matrix on a matrix declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = matrix.new<label>()
//                          > label newLabel = label.new(chart.point.now(close), str.tostring(close))
//                          > varip array_id = array.new<label>()
//                          > array_id.roll(newLabel, 5)
//                          > // Roll up to `10` intrabar rows of `array_id` into `id`.
//                          > id.roll(array_id, 10)
//                          > ```
//
//                          Ensure matrices are declared with `var` or `varip` keywords to store updated rows.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = matrix.new<label>() // No `var` or `varip` persistance.
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > var array_id = array.new<label>(5, newLabel)
//                          > id.roll(array_id, 3) // Only rolls a single row of `array_id` into `id`.
//                          > ```
//
//                          Operate on the rolling window matrix from a different scope.
//
//                          > ```
//                          > var id = matrix.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > // Roll rows after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     var array_id = array.new<label>(5, newLabel)
//                          >     id.roll(array_id, 3)
//                          > ```
//
//                          Matrices with initialized rows and columns can be used as a rolling window matrix.
//
//                          > ```
//                          > var id = matrix.new<label>(3, 5, na)
//                          > var array_id = array.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > array_id.roll(newLabel, 5)
//                          > // No `rows` parameter necessary, uses row size of `id` for `rows`.
//                          > id.roll(array_id)
//                          > ```
//
//                          The size of `array_id` matches the number of matrix columns.
//
//                          > ```
//                          > var id = matrix.new<label>(3, 5, na) // 5 columns.
//                          > var array_id = array.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > array_id.roll(newLabel, 5) // 5 elements (matches 5 columns).
//                          > id.roll(array_id, 3) // Rolls `array_id` into up to `3` rows of `id`.
//                          > ```
//
//                          When the matrix starts with `0` rows and `roll(rows = na)`,
//                          rows are dynamically added to the matrix up to the element limit then rolled out.
//
//                          > ```
//                          > var id = matrix.new<label>()
//                          > var array_id = array.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > array_id.roll(newLabel, 100)
//                          > // Stores up to the element limit and then rolls rows.
//                          > id.roll(array_id)
//                          > ```
//
//                          Generates a runtime error if the `roll(rows)` parameter is smaller than the number of
//                          initialized rows in `id`.
//
//                          > ```
//                          > var id = matrix.new<label>(3, 5, na)
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > var array_id = array.new<label>(5, newLabel)
//                          > id.roll(array_id, 2) // Sets `rows` to a value of 2. Generates a runtime error!
//                          > // roll(matrix<label> id, array<label> array_id, int rows):
//                          > // `rows` (2) must be greater than or equal to the rows in `id` (3), or set to `na`!
//                          > ```
//
//                          A `rows` value less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = matrix.new<label>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > var array_id = array.new<label>(5, newLabel)
//                          > id.roll(array_id, 654321)
//                          > // Example runtime error:
//                          > // roll(matrix<label> id, array<label> array_id, int rows):
//                          > // `rows` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Generates a runtime error if adding a column would exceed the 100,000 matrix size limit.
//
//                          > ```
//                          > var id = matrix.new<label>(1000, 100, na) // 100,000 elements.
//                          > chart.point nowPoint = chart.point.now(close)
//                          > label newLabel = label.new(nowPoint, str.tostring(nowPoint.price))
//                          > var array_id = array.new<label>(101, newLabel) // 101 columns.
//                          > id.roll(array_id) // Attempting to add a column exceeds the limit.
//                          > // Example runtime error:
//                          > // roll(matrix<label> id, array<label> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method roll(matrix<label> id, array<label> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "roll(matrix<label> id, array<label> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "roll(matrix<label> id, array<label> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns())
        while id.columns() < array_id.size()
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "roll(matrix<label> id, array<label> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        for i in id.row(id.rows() - 1)
            i.delete()
        id.remove_row()

    if array_id.size() == id.columns()
        id.add_row(0, array_id)
    else
        id.add_row(0)

        for [i, element] in array_id
            id.set(0, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        for i in id.row(id.rows() - 1)
            i.delete()
        id.remove_row()
// }


// roll(matrix<box> id, array<box> array_id, int rows) {
// @function                Creates a rolling window using the rows of a matrix object.
//
//                          Removing the oldest row of a matrix and adding a new row is referred to as a *roll*.
//                          The function adds rows until the matrix is full, then begins to roll rows.
// @param id                A matrix object to use for the rolling window.
// @param array_id          The array containing values to append as a new row at index `0` into `id`.
// @param rows              Optional. The maximum number of rows in the `id` rolling window matrix.
//
//                          New rows are inserted into `id` at index `0` until the matrix rows reach the `rows` value,
//                          then the last row of `id` is removed before inserting a new row at index `0`.
//
//                          `rows = na` uses the initial number of rows in `id` as the maximum size.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on rows of `id`.
// ___
// **Usage**
//
//                          Create a rolling window matrix on a matrix declared with `var` bar persistence.
//
//                          > ```
//                          > var id = matrix.new<box>()
//                          > var array_id = array.new<box>()
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > array_id.roll(newBox, 5)
//                          > // Store up to `3` rows of `array_id` values and then begin to roll rows.
//                          > id.roll(array_id, 3)
//                          > ```
//
//                          Create a rolling window matrix on a matrix declared with `varip` intrabar persistence.
//
//                          > ```
//                          > varip id = matrix.new<box>()
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > varip array_id = array.new<box>()
//                          > array_id.roll(newBox, 5)
//                          > // Roll up to `10` intrabar rows of `array_id` into `id`.
//                          > id.roll(array_id, 10)
//                          > ```
//
//                          Ensure matrices are declared with `var` or `varip` keywords to store updated rows.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > id = matrix.new<box>() // No `var` or `varip` persistance.
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > var array_id = array.new<box>(5, newBox)
//                          > id.roll(array_id, 3) // Only rolls a single row of `array_id` into `id`.
//                          > ```
//
//                          Matrices with initialized rows and columns can be used as a rolling window matrix.
//
//                          > ```
//                          > var id = matrix.new<box>(3, 5, na)
//                          > var array_id = array.new<box>()
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > array_id.roll(newBox, 5)
//                          > // No `rows` parameter necessary, uses row size of `id` for `rows`.
//                          > id.roll(array_id)
//                          > ```
//
//                          Operate on the rolling window matrix from a different scope.
//
//                          > ```
//                          > var id = matrix.new<box>()
//                          > var array_id = array.new<box>()
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > // Roll rows after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     array_id.roll(newBox, 5)
//                          >     id.roll(array_id, 3)
//                          > ```
//
//                          The size of `array_id` matches the number of matrix columns.
//
//                          > ```
//                          > var id = matrix.new<box>(3, 5, na) // 5 columns.
//                          > var array_id = array.new<box>()
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > array_id.roll(newBox, 5) // 5 elements (matches 5 columns).
//                          > id.roll(array_id, 3) // Rolls `array_id` into up to `3` rows of `id`.
//                          > ```
//
//                          When the matrix starts with `0` rows and `roll(rows = na)`,
//                          rows are dynamically added to the matrix up to the element limit then rolled out.
//
//                          > ```
//                          > var id = matrix.new<box>()
//                          > var array_id = array.new<box>()
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > array_id.roll(newBox, 100)
//                          > // Stores up to the element limit and then rolls rows.
//                          > id.roll(array_id)
//                          > ```
//
//                          Generates a runtime error if the `roll(rows)` parameter is smaller than the number of
//                          initialized rows in `id`.
//
//                          > ```
//                          > var id = matrix.new<box>(3, 5, na)
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > var array_id = array.new<box>(5, newBox)
//                          > id.roll(array_id, 2) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // roll(matrix<box> id, array<box> array_id, int rows):
//                          > // `rows` (2) must be greater than or equal to the rows in `id` (3), or set to `na`!
//                          > ```
//
//                          A `rows` value less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var id = matrix.new<box>()
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > var array_id = array.new<box>(5, newBox)
//                          > id.roll(array_id, 654321) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // roll(matrix<box> id, array<box> array_id, int rows):
//                          > // `rows` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Generates a runtime error if adding a column would exceed the 100,000 matrix size limit.
//
//                          > ```
//                          > var id = matrix.new<box>(1000, 100, na) // 100,000 elements.
//                          > chart.point topLeft = chart.point.new(time[3], bar_index[3], close[3])
//                          > chart.point bottomRight = chart.point.now(close)
//                          > box newBox = box.new(topLeft, bottomRight)
//                          > var array_id = array.new<box>(101, newBox) // 101 columns.
//                          > id.roll(array_id) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // roll(matrix<box> id, array<box> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method roll(matrix<box> id, array<box> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "roll(matrix<box> id, array<box> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater than "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "roll(matrix<box> id, array<box> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns())
        while id.columns() < array_id.size()
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "roll(matrix<box> id, array<box> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        for i in id.row(id.rows() - 1)
            i.delete()
        id.remove_row()

    if array_id.size() == id.columns()
        id.add_row(0, array_id)
    else
        id.add_row(0)

        for [i, element] in array_id
            id.set(0, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        for i in id.row(id.rows() - 1)
            i.delete()
        id.remove_row()
// }


// roll(matrix<polyline> id, array<polyline> array_id, int rows) {
// @function                Creates a rolling window using the rows of a matrix object.
//
//                          Removing the oldest row of a matrix and adding a new row is referred to as a *roll*.
//                          The function adds rows until the matrix is full, then begins to roll rows.
// @param id                A matrix object to use for the rolling window.
// @param array_id          The array containing values to append as a new row at index `0` into `id`.
// @param rows              Optional. The maximum number of rows in the `id` rolling window matrix.
//
//                          New rows are inserted into `id` at index `0` until the matrix rows reach the `rows` value,
//                          then the last row of `id` is removed before inserting a new row at index `0`.
//
//                          `rows = na` uses the initial number of rows in `id` as the maximum size.
//
//                          Default is `na`.
// @returns                 Does not return any value or reference. Operates on rows of `id`.
// ___
// **Usage**
//
//                          Create a rolling window matrix on a matrix declared with `var` bar persistence.
//
//                          > ```
//                          > var id = matrix.new<polyline>()
//                          > var array_id = array.new<polyline>()
//                          > var chartPoints = array.new<chart.point>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > chartPoints.roll(nowPoint, 3)
//                          > polyline newPolyline = polyline.new(chartPoints)
//                          > array_id.roll(newPolyline, 5)
//                          > // Store up to `3` rows of `array_id` values and then begin to roll rows.
//                          > id.roll(array_id, 3)
//                          > ```
//
//                          Create a rolling window matrix on a matrix declared with `varip` intrabar persistence.
//
//                          > ```
//                          > var chartPoints = array.new<chart.point>()
//                          > chartPoints.roll(chart.point.now(close), 3)
//                          > varip id = matrix.new<polyline>()
//                          > polyline newPolyline = polyline.new(chartPoints)
//                          > varip array_id = array.new<polyline>()
//                          > array_id.roll(newPolyline, 5)
//                          > // Roll up to `10` intrabar rows of `array_id` into `id`.
//                          > id.roll(array_id, 10)
//                          > ```
//
//                          Ensure matrices are declared with `var` or `varip` keywords to store updated rows.
//                          Otherwise, applying `roll()` on them will not store rolled values.
//
//                          > ```
//                          > var chartPoints = array.new<chart.point>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > chartPoints.roll(nowPoint, 3)
//                          > id = matrix.new<polyline>() // No `var` or `varip` persistance.
//                          > polyline newPolyline = polyline.new(chartPoints)
//                          > var array_id = array.new<polyline>(5, newPolyline)
//                          > id.roll(array_id, 3) // Only rolls a single row of `array_id` into `id`.
//                          > ```
//
//                          Matrices with initialized rows and columns can be used as a rolling window matrix.
//
//                          > ```
//                          > var id = matrix.new<polyline>(3, 5, na)
//                          > var array_id = array.new<polyline>()
//                          > var chartPoints = array.new<chart.point>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > chartPoints.roll(nowPoint, 3)
//                          > polyline newPolyline = polyline.new(chartPoints)
//                          > array_id.roll(newPolyline, 5)
//                          > // No `rows` parameter necessary, uses row size of `id` for `rows`.
//                          > id.roll(array_id)
//                          > ```
//
//                          Operate on the rolling window matrix from a different scope.
//
//                          > ```
//                          > var id = matrix.new<polyline>()
//                          > var array_id = array.new<polyline>()
//                          > var chartPoints = array.new<chart.point>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > chartPoints.roll(nowPoint, 3)
//                          > // Roll rows after monthly timeframe changes.
//                          > if timeframe.change("M")
//                          >     polyline newPolyline = polyline.new(chartPoints)
//                          >     array_id.roll(newPolyline, 5)
//                          >     id.roll(array_id, 3)
//                          > ```
//
//                          The size of `array_id` matches the number of matrix columns.
//
//                          > ```
//                          > var id = matrix.new<polyline>(3, 5, na) // 5 columns.
//                          > var array_id = array.new<polyline>()
//                          > var chartPoints = array.new<chart.point>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > chartPoints.roll(nowPoint, 3)
//                          > polyline newPolyline = polyline.new(chartPoints)
//                          > array_id.roll(newPolyline, 5) // 5 elements (matches 5 columns).
//                          > id.roll(array_id, 3) // Rolls `array_id` into up to `3` rows of `id`.
//                          > ```
//
//                          When the matrix starts with `0` rows and `roll(rows = na)`,
//                          rows are dynamically added to the matrix up to the element limit then rolled out.
//
//                          > ```
//                          > var id = matrix.new<polyline>()
//                          > var array_id = array.new<polyline>()
//                          > var chartPoints = array.new<chart.point>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > chartPoints.roll(nowPoint, 3)
//                          > polyline newPolyline = polyline.new(chartPoints)
//                          > array_id.roll(newPolyline, 100)
//                          > // Stores up to the element limit and then rolls rows.
//                          > id.roll(array_id)
//                          > ```
//
//                          Generates a runtime error if the `roll(rows)` parameter is smaller than the number of
//                          initialized rows in `id`.
//
//                          > ```
//                          > var chartPoints = array.new<chart.point>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > chartPoints.roll(nowPoint, 3)
//                          > var id = matrix.new<polyline>(3, 5, na)
//                          > polyline newPolyline = polyline.new(chartPoints)
//                          > var array_id = array.new<polyline>(5, newPolyline)
//                          > id.roll(array_id, 2) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // roll(matrix<polyline> id, array<polyline> array_id, int rows):
//                          > // `rows` (2) must be greater than or equal to the rows in `id` (3), or set to `na`!
//                          > ```
//
//                          A `rows` value less than `0` or larger than `100000` generates a runtime error.
//
//                          > ```
//                          > var chartPoints = array.new<chart.point>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > chartPoints.roll(nowPoint, 3)
//                          > var id = matrix.new<polyline>()
//                          > polyline newPolyline = polyline.new(chartPoints)
//                          > var array_id = array.new<polyline>(5, newPolyline)
//                          > id.roll(array_id, 654321) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // roll(matrix<polyline> id, array<polyline> array_id, int rows):
//                          > // `rows` (654321) must not be less than 0 or greater than 100,000!"
//                          > ```
//
//                          Generates a runtime error if adding a column would exceed the 100,000 matrix size limit.
//
//                          > ```
//                          > var chartPoints = array.new<chart.point>()
//                          > chart.point nowPoint = chart.point.now(close)
//                          > chartPoints.roll(nowPoint, 3)
//                          > var id = matrix.new<polyline>(1000, 100, na) // 100,000 elements.
//                          > polyline newPolyline = polyline.new(chartPoints)
//                          > var array_id = array.new<polyline>(101, newPolyline) // 101 columns.
//                          > id.roll(array_id) // Generates a runtime error!
//                          > // Example runtime error:
//                          > // roll(matrix<polyline> id, array<polyline> array_id, int rows):
//                          > // `array_id` (101) and `rows` (1000) create 101000 matrix elements! Reduce the size of -
//                          > //   `array_id` or value of `rows` to stay within the 100,000 matrix size limit!
//                          > ```
export method roll(matrix<polyline> id, array<polyline> array_id, int rows = na) =>
    if rows < 0 or MATRIX_SIZE_LIMIT < rows
        string rowsSizeError = "roll(matrix<polyline> id, array<polyline> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must not be less than 0 or greater "
          + str.tostring(MATRIX_SIZE_LIMIT) + "!"

        runtime.error(rowsSizeError)

    int idLastRows = id.rows()
    var int idInitialRows = id.rows()

    if rows < idLastRows
        string idSizeError = "roll(matrix<polyline> id, array<polyline> array_id, int rows): "
          + "`rows` (" + str.tostring(rows) + ") must be greater than or equal to the number of row in `id` ("
          + str.tostring(idLastRows) + "), or set to `na`!"

        runtime.error(idSizeError)

    if 0 < (array_id.size() - id.columns())
        while id.columns() < array_id.size()
            if (id.elements_count() + id.rows()) <= MATRIX_SIZE_LIMIT
                id.add_col()
            else
                string addColumnError = "roll(matrix<polyline> id, array<polyline> array_id, int rows): "
                  + "`array_id` (" + str.tostring(array_id.size()) + ") and `rows` (" + str.tostring(id.rows())
                  + ") create " + str.tostring(id.elements_count() + id.rows()) + " matrix elements! "
                  + "Reduce the size of `array_id` or value of `rows` to stay within the "
                  + str.tostring(MATRIX_SIZE_LIMIT) + " matrix size limit!"

                runtime.error(addColumnError)

    if MATRIX_SIZE_LIMIT < (id.elements_count() + array_id.size())
        id.remove_row()

    if array_id.size() == id.columns()
        id.add_row(0, array_id)
    else
        id.add_row(0)

        for [i, element] in array_id
            id.set(0, i, element)

    if (na(rows) and idInitialRows == 0 ? na : na(rows) and idInitialRows > 0 ? idLastRows : rows) < id.rows()
        id.remove_row()
