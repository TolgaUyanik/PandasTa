//@version=6
indicator(
     title="Opening Prices",
     shorttitle="OPENS by zeeTFX",
     overlay=true,
     max_lines_count=50,
     max_labels_count=50)

// ======================================== Helper Functions ========================================
get_style(s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

get_size(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.normal

// ======================================== Inputs ========================================
var g_GEN = "General Settings"
gmt_tz    = input.string("America/New_York", "Timezone", group=g_GEN)
label_off = input.int(1, "Opening Price Label Right Offset (Bars)", minval=1, maxval=100, group=g_GEN)

var g_LBL      = "Opening Price Label Settings"
op_lbl_size_in = input.string("Small", "Opening Price Label Font Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=g_LBL)
op_lbl_size    = get_size(op_lbl_size_in)

// --- Level 1: Midnight ---
var g_MID = "Midnight Open (00:00)"
show_mid      = input.bool(true, "Show Midnight Level", inline="M1", group=g_MID)
mid_color     = input.color(color.gray, "", inline="M1", group=g_MID)
mid_txt_color = input.color(color.gray, "Label Font Color", group=g_MID)
mid_style     = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], inline="M2", group=g_MID)
mid_width     = input.int(1, "Width", minval=1, maxval=5, inline="M2", group=g_MID)

// --- Level 2: NYSE ---
var g_MKT = "NYSE Open (09:30)"
show_mkt      = input.bool(true, "Show NYSE Level", inline="N1", group=g_MKT)
mkt_color     = input.color(color.teal, "", inline="N1", group=g_MKT)
mkt_txt_color = input.color(color.teal, "Label Font Color", group=g_MKT)
mkt_style     = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], inline="N2", group=g_MKT)
mkt_width     = input.int(1, "Width", minval=1, maxval=5, inline="N2", group=g_MKT)

// --- Level 3: Market Open ---
var g_MO = "Market Open (Option 3)"
show_mo      = input.bool(true, "Show Level", inline="L1", group=g_MO)
mo_color     = input.color(color.orange, "", inline="L1", group=g_MO)
mo_txt_color = input.color(color.orange, "Label Font Color", group=g_MO)
mo_time      = input.session("1800-1805", "Time", group=g_MO)
mo_text      = input.string("Market Open", "Label Text", group=g_MO)
mo_style     = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], inline="L2", group=g_MO)
mo_width     = input.int(1, "Width", minval=1, maxval=5, inline="L2", group=g_MO)

// --- Level 4: Custom Open ---
var g_C4 = "Market Open (Option 4)"
show_c4      = input.bool(false, "Show Level", inline="C41", group=g_C4)
c4_color     = input.color(color.teal, "", inline="C41", group=g_C4)
c4_txt_color = input.color(color.teal, "Label Font Color", group=g_C4)
c4_time      = input.session("0300-0301", "Time", group=g_C4)
c4_text      = input.string("London Open", "Label Text", group=g_C4)
c4_style     = input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], inline="C42", group=g_C4)
c4_width     = input.int(1, "Width", minval=1, maxval=5, inline="C42", group=g_C4)

// --- Level 5: Custom Open ---
var g_C5 = "Market Open (Option 5)"
show_c5      = input.bool(false, "Show Level", inline="C51", group=g_C5)
c5_color     = input.color(color.purple, "", inline="C51", group=g_C5)
c5_txt_color = input.color(color.purple, "Label Font Color", group=g_C5)
c5_time      = input.session("1300-1301", "Time", group=g_C5)
c5_text      = input.string("PM Session", "Label Text", group=g_C5)
c5_style     = input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], inline="C52", group=g_C5)
c5_width     = input.int(1, "Width", minval=1, maxval=5, inline="C52", group=g_C5)

// ======================================== Timeframe Filter ========================================
// Opening prices visible on H1 and lower only.
// Hidden above H1: H2, H4, Daily, Weekly, Monthly, etc.
chart_tf_sec = timeframe.in_seconds(timeframe.period)
allow_tf     = timeframe.isintraday and not na(chart_tf_sec) and chart_tf_sec <= 3600

// ======================================== Persistent Object Storage ========================================
var line[]  open_lines  = array.new_line(5, na)
var label[] open_labels = array.new_label(5, na)
var float[] open_prices = array.new_float(5, na)

// ======================================== Object Deletion Function ========================================
delete_level(idx) =>
    line ln = array.get(open_lines, idx)
    label lb = array.get(open_labels, idx)

    if not na(ln)
        line.delete(ln)
        array.set(open_lines, idx, na)

    if not na(lb)
        label.delete(lb)
        array.set(open_labels, idx, na)

    array.set(open_prices, idx, na)

// ======================================== Core Drawing Function ========================================
manage_level(idx, enabled, sess, label_txt, line_col, label_col, l_style, l_width) =>
    line ln = array.get(open_lines, idx)
    label lb = array.get(open_labels, idx)
    float op = array.get(open_prices, idx)

    int fallback_ms = 60000
    int tf_ms = not na(chart_tf_sec) ? int(chart_tf_sec * 1000) : fallback_ms
    int bar_ms = not na(time[1]) ? int(time - time[1]) : tf_ms

    bool in_sess = not na(time("", sess, gmt_tz))
    bool was_in_sess = bar_index > 0 ? in_sess[1] : false
    bool is_start = in_sess and not was_in_sess

    if not enabled
        delete_level(idx)

    else
        if is_start
            delete_level(idx)

            op := open
            int future_time = time + label_off * bar_ms

            ln := line.new(
                 x1=time,
                 y1=op,
                 x2=future_time,
                 y2=op,
                 xloc=xloc.bar_time,
                 extend=extend.none,
                 color=line_col,
                 style=get_style(l_style),
                 width=l_width)

            lb := label.new(
                 x=future_time,
                 y=op,
                 text=label_txt,
                 xloc=xloc.bar_time,
                 yloc=yloc.price,
                 style=label.style_label_left,
                 color=color.new(color.white, 100),
                 textcolor=label_col,
                 size=op_lbl_size)

            array.set(open_lines, idx, ln)
            array.set(open_labels, idx, lb)
            array.set(open_prices, idx, op)

        else
            if not na(ln) and not na(lb) and not na(op)
                int target_time = time + label_off * bar_ms

                line.set_x2(ln, target_time)
                line.set_y1(ln, op)
                line.set_y2(ln, op)
                line.set_color(ln, line_col)
                line.set_style(ln, get_style(l_style))
                line.set_width(ln, l_width)

                label.set_x(lb, target_time)
                label.set_y(lb, op)
                label.set_text(lb, label_txt)
                label.set_textcolor(lb, label_col)
                label.set_size(lb, op_lbl_size)
                label.set_color(lb, color.new(color.white, 100))

// ======================================== Execution ========================================
manage_level(
     0,
     allow_tf and show_mid,
     "0000-0001",
     "Midnight Open",
     mid_color,
     mid_txt_color,
     mid_style,
     mid_width)

manage_level(
     1,
     allow_tf and show_mkt,
     "0930-0931",
     "NYSE Open",
     mkt_color,
     mkt_txt_color,
     mkt_style,
     mkt_width)

manage_level(
     2,
     allow_tf and show_mo,
     mo_time,
     mo_text,
     mo_color,
     mo_txt_color,
     mo_style,
     mo_width)

manage_level(
     3,
     allow_tf and show_c4,
     c4_time,
     c4_text,
     c4_color,
     c4_txt_color,
     c4_style,
     c4_width)

manage_level(
     4,
     allow_tf and show_c5,
     c5_time,
     c5_text,
     c5_color,
     c5_txt_color,
     c5_style,
     c5_width)