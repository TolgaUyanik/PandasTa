// Pivot Points. High & Lows By Reversal Percentage
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
// The indicator identifies reversal points (pivots) by tracking significant price movements
// and confirming them based on two conditions:
// 1. Minimum Range Threshold: A potential pivot is considered if the price moves beyond
//    the 'min_range_pct' percentage of the current high (for a high pivot) or low (for a
//    low pivot), ensuring sufficient movement.
// 2. Reversal Confirmation: A pivot is confirmed if the price reverses from the potential
//    pivot by at least the 'reversal_pct' percentage of the distance between the last
//    confirmed pivot and the current potential pivot, measuring the retracement relative
//    to the prior trend's magnitude.
// The indicator alternates between tracking highs (in an uptrend) and lows (in a downtrend),
// updating the trend when a pivot is confirmed.
// The function includes management to handle multiple calls with multiple settings.
// It can be used more than once per script, and also for multiple timeframes with
// several request.security calls.
//
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

//@version=5
library('pivots', overlay = true)

// Custom types
export type pivot
	int idx = na
	int typ = na
	float prc = na
	int tme = na

type pivot_state
	string config_id = ''
	int trend = na
	float current_high = na
	int current_high_idx = na
	float current_low = na
	int current_low_idx = na
	float last_pivot_prc = na
	pivot temp_pivot = na
	pivot last_confirmed_pivot = na

// Constants
int TREND_LONG = 1
int TREND_SHORT = -1
int PIVOT_HIGH = 1
int PIVOT_LOW = -1



// Function for pivot calculation
export f_calculatePivot(series float _high, series float _low, float _min_range_pct, float _reversal_pct) =>

    // Array to store states for different configurations
    var array<pivot_state> states = array.new<pivot_state>(0)

    // Generate configuration ID : timeframe period is added for identifying when called from inside a request.security call
    string config_id = timeframe.period + '_' + str.tostring(_min_range_pct)

    // Initialize state
    pivot_state state = na
    int idx = -1
    if array.size(states) == 0
        // First configuration, create new state
        state := pivot_state.new(config_id, TREND_LONG, na, na, na, na, na, na, na)
        state
    else // Search for existing configuration
        for i = 0 to array.size(states) - 1 by 1
            if array.get(states, i).config_id == config_id
                idx := i
                break
        if idx == -1
            // New configuration, create new state
            state := pivot_state.new(config_id, TREND_LONG, na, na, na, na, na, na, na)
            state
        else // Existing configuration, get state
            state := array.get(states, idx)
            state

    // Copy state to local variables for readability
    int trend = state.trend
    float current_high = state.current_high
    int current_high_idx = state.current_high_idx
    float current_low = state.current_low
    int current_low_idx = state.current_low_idx
    float last_pivot_prc = state.last_pivot_prc
    pivot temp_pivot = state.temp_pivot
    pivot last_confirmed_pivot = state.last_confirmed_pivot

    // Local variables reset each call
    bool isNewPivot = false
    pivot new_pivot = na

    // Initialize on first bar
    if na(current_high)
        current_high := _high
        current_high_idx := bar_index
        current_low := _low
        current_low_idx := bar_index
        if trend == TREND_LONG
            temp_pivot := pivot.new(current_high_idx, PIVOT_HIGH, current_high, time)
            temp_pivot
        else
            temp_pivot := pivot.new(current_low_idx, PIVOT_LOW, current_low, time)
            temp_pivot

    // Process candle based on trend
    if trend == TREND_LONG
        if _high >= current_high
            current_high := _high
            current_high_idx := bar_index
            temp_pivot := pivot.new(current_high_idx, PIVOT_HIGH, current_high, time)
            temp_pivot
        else
            float current_reversal = current_high - _low
            float min_range_threshold = current_high * (1 - _min_range_pct / 100)
            if _low < min_range_threshold
                bool confirmed = false
                if not na(last_pivot_prc)
                    float full_distance = current_high - last_pivot_prc
                    float reversal_threshold = full_distance * (_reversal_pct / 100)
                    if current_reversal >= reversal_threshold
                        confirmed := true
                        confirmed
                else
                    confirmed := true
                    confirmed
                if confirmed
                    new_pivot := pivot.new(current_high_idx, PIVOT_HIGH, current_high, time[bar_index - current_high_idx])
                    isNewPivot := true
                    trend := TREND_SHORT
                    last_pivot_prc := current_high
                    current_low := _low
                    current_low_idx := bar_index
                    temp_pivot := pivot.new(current_low_idx, PIVOT_LOW, current_low, time)
                    temp_pivot
    else
        if _low <= current_low
            current_low := _low
            current_low_idx := bar_index
            temp_pivot := pivot.new(current_low_idx, PIVOT_LOW, current_low, time)
            temp_pivot
        else
            float current_reversal = _high - current_low
            float min_range_threshold = current_low * (1 + _min_range_pct / 100)
            if _high > min_range_threshold
                bool confirmed = false
                if not na(last_pivot_prc)
                    float full_distance = last_pivot_prc - current_low
                    float reversal_threshold = full_distance * (_reversal_pct / 100)
                    if current_reversal >= reversal_threshold
                        confirmed := true
                        confirmed
                else
                    confirmed := true
                    confirmed
                if confirmed
                    new_pivot := pivot.new(current_low_idx, PIVOT_LOW, current_low, time[bar_index - current_low_idx])
                    isNewPivot := true
                    trend := TREND_LONG
                    last_pivot_prc := current_low
                    current_high := _high
                    current_high_idx := bar_index
                    temp_pivot := pivot.new(current_high_idx, PIVOT_HIGH, current_high, time)
                    temp_pivot

    // Update last confirmed pivot
    if isNewPivot
        last_confirmed_pivot := new_pivot
        last_confirmed_pivot

    // Update state with modified values
    state.trend := trend
    state.current_high := current_high
    state.current_high_idx := current_high_idx
    state.current_low := current_low
    state.current_low_idx := current_low_idx
    state.last_pivot_prc := last_pivot_prc
    state.temp_pivot := temp_pivot
    state.last_confirmed_pivot := last_confirmed_pivot

    // Store updated state in array
    if idx == -1
        array.push(states, state)
    else
        array.set(states, idx, state)

    // Return whether a new pivot was confirmed, the new confirmed pivot, and the temporary pivot
    [isNewPivot, last_confirmed_pivot, temp_pivot]


////////////////////////////////////////////////
// Example of use
////////////////////////////////////////////////

// Inputs
min_range_pct = input.float(20.0, 'Min Range %')
reversal_pct = input.float(30.0, 'Reversal %')
ignore_wick = input.bool(true, 'Ignore wick')

h = ignore_wick ? math.max(open, close) : high
l = ignore_wick ? math.min(open, close) : low

// Call the function with high, low, and input parameters
[is_new_pivot, new_confirmed_pivot, temp_pivot] = f_calculatePivot(h, l, min_range_pct, reversal_pct)

// Variable to store previous confirmed pivot outside the function
var pivot prev_confirmed_pivot = na

// Draw the line if a new pivot is confirmed and previous pivot exists
if is_new_pivot
    if not na(prev_confirmed_pivot) and not na(new_confirmed_pivot)
        line.new(x1 = prev_confirmed_pivot.idx, y1 = prev_confirmed_pivot.prc, x2 = new_confirmed_pivot.idx, y2 = new_confirmed_pivot.prc, color = color.blue, width = 1)
    prev_confirmed_pivot := new_confirmed_pivot
    prev_confirmed_pivot
