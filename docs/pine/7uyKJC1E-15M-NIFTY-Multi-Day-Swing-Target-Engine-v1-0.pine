//@version=5
strategy("5M NIFTY Multi-Day Swing Target Engine v14", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1)

// ---- INPUTS ----
body_threshold = input.float(70.0, minval=10.0, maxval=100.0, title="Momentum Candle Body Threshold (%)")
tp_atr_mult    = input.float(3.0, title="Take Profit Target (ATR Mult)")
sl_lookback    = input.int(3, title="Trailing SL Bar Lookback")

// ---- STEP 1: GENERAL LIQUID HOURS FOR ENTRIES ----
in_entry_window = not na(time(timeframe.period, "0920-1500:23456"))

// ---- STEP 2: QUANTIFY CANDLE ANATOMY ----
atr = ta.atr(14)
candle_range = high - low
candle_body  = math.abs(close - open)

float body_percentage = candle_range > 0 ? (candle_body / candle_range) * 100 : 0.0

is_green = close > open
is_red   = close < open

// ---- STEP 3: ANYTIME MOMENTUM SCANNER ----
bool force_long_signal  = in_entry_window and is_green and (body_percentage >= body_threshold)
bool force_short_signal = in_entry_window and is_red   and (body_percentage >= body_threshold)

// ---- STEP 4: PERSISTENT RISK STATE LOGGER ----
var float swing_target = na
var float trailing_sl  = na

// ---- STEP 5: STRATEGY ROUTING & BRACKET ANCHORING ----
if force_long_signal and strategy.position_size <= 0
    strategy.entry("CE", strategy.long, comment="SWING CE 🚀")
    swing_target := close + (atr * tp_atr_mult)
    trailing_sl  := low[1] // Initial stop at previous candle low

if force_short_signal and strategy.position_size >= 0
    strategy.entry("PE", strategy.short, comment="SWING PE 📉")
    swing_target := close - (atr * tp_atr_mult)
    trailing_sl  := high[1] // Initial stop at previous candle high

// ---- STEP 6: DYNAMIC STRUCTURAL TRAILING ----
if strategy.position_size > 0
    // Trail stop behind the lowest low of the last 3 candles to give the swing room to run
    trailing_sl := math.max(trailing_sl, ta.lowest(low, sl_lookback))

if strategy.position_size < 0
    // Trail stop behind the highest high of the last 3 candles to give the swing room to run
    trailing_sl := math.min(trailing_sl, ta.highest(high, sl_lookback))

// ---- STEP 7: STRATEGY EXITS ROUTING ----
if strategy.position_size > 0
    strategy.exit("CE BRACKET", "CE", limit=swing_target, stop=trailing_sl, comment="CE EXIT")

if strategy.position_size < 0
    strategy.exit("PE BRACKET", "PE", limit=swing_target, stop=trailing_sl, comment="PE EXIT")

// Clear active memory states on total position reset
if strategy.position_size == 0
    swing_target := na
    trailing_sl  := na