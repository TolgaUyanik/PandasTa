//@version=6
// @description Library contains few data structures and methods for tracking harmonic patterns and projections via pinescript.
library("projectiontracking", overlay = true)

import Trendoscope/FibRatios/1 as fibs
import Trendoscope/HarmonicMapLib/1 as hpm

//@type Harmonic Projection Range
//@field patterns array of pattern names
//@field start Start Range
//@field end End Range
//@field status Projection Status
export type ProjectionRange
    array<string> patterns
    float start
    float end
    int status

//@type Harmonic Projection Properties
//@field fillMajorTriangles Use linefill for major triangles
//@field fillMinorTriangles Use linefill for minor triangles
//@field majorFillTransparency transparency of major triangles
//@field minorFillTransparency transparency of minor triangles
//@field showXABC Show XABC labels
//@field lblSizePivots Pivot labels size
//@field showRatios Show ratio labels
//@field useLogScaleForScan Log scale is used for scanning projections
//@field activateOnB Activate projections on reaching B
//@field activationRatio Use activation ratio for activation
//@field confirmationRatio Confirmation ratio of projection before removal
export type ProjectionProperties
    bool fillMajorTriangles
    bool fillMinorTriangles
    int majorFillTransparency
    int minorFillTransparency
    bool showXABC
    string lblSizePivots
    bool showRatios
    bool useLogScaleForScan
    bool activateOnB
    float activationRatio
    float confirmationRatio

//@type Harmonic Projection Projection drawing objects
//@field xa line xa
//@field ab line ab
//@field bc line bc
//@field xb line xb
//@field ac line ac
//@field x Pivot label x
//@field a Pivot label a
//@field b Pivot label b
//@field c Pivot label c
//@field xabRatio Label XAB Ratio
//@field abcRatio Label ABC Ratio
export type HarmonicProjectionDrawing
    line xa
    line ab
    line bc
    line xb
    line ac
    label x
    label a
    label b
    label c
    label xabRatio
    label abcRatio

//@type Harmonic Projection Projection object
//@field patternId id of the pattern
//@field dir projection direction
//@field x Pivot X
//@field a Pivot A
//@field b Pivot B
//@field c Pivot C
//@field patternColor Color in which pattern is displayed
//@field przRange PRZ Range
//@field activationPrice Projection activation price
//@field reversalPrice Projection reversal price
//@field status Projection status
//@field properties Projection properties
//@field projectionRanges array of Projection Ranges
//@field initialD Initial D pivot
//@field d Pivot D
//@field drawing HarmonicProjectionDrawing Object
export type HarmonicProjection
    int patternId
    int dir
    chart.point x
    chart.point a
    chart.point b
    chart.point c
    color patternColor
    hpm.PrzRange przRange
    float activationPrice
    float reversalPrice
    int status
    ProjectionProperties properties
    array<ProjectionRange> projectionRanges
    float initialD
    chart.point d
    HarmonicProjectionDrawing drawing

//@function erase Harmonic Projection Drawing
//@param this HarmonicProjectionDrawing object
//@returns void
export method erase(HarmonicProjectionDrawing this)=>
    line.delete(this.xa)
    line.delete(this.ab)
    line.delete(this.bc)
    line.delete(this.xb)
    line.delete(this.ac)
    label.delete(this.a)
    label.delete(this.b)
    label.delete(this.c)
    label.delete(this.x)
    label.delete(this.abcRatio)
    label.delete(this.xabRatio)

//@function erase HarmonicProjection
//@param this HarmonicProjection object
//@returns void
export method erase(HarmonicProjection this)=>this.drawing.erase()

//@function draw HarmonicProjection
//@param this HarmonicProjection object
//@returns HarmonicProjection object
export method draw(HarmonicProjection this)=>
    if(na(this.drawing))
        this.drawing := HarmonicProjectionDrawing.new()
    this.drawing.erase()
    this.drawing.xa := line.new(this.x, this.a, color= this.patternColor, width=1, style=line.style_solid)
    this.drawing.ab := line.new(this.a, this.b, color=this.patternColor, width=1, style=line.style_solid)
    this.drawing.bc := line.new(this.b, this.c, color=this.patternColor, width=1, style=line.style_solid)
    this.drawing.xb := line.new(this.x, this.b, color=this.patternColor, width=1, style=line.style_dotted)
    this.drawing.ac := line.new(this.a, this.c, color=this.patternColor, width=1, style=line.style_dotted)
    if this.properties.showXABC
        this.drawing.x := label.new(this.x, 'X', textcolor=this.patternColor, style=label.style_none, yloc=this.dir > 0 ? yloc.belowbar : yloc.abovebar, size=this.properties.lblSizePivots)
        this.drawing.a := label.new(this.a,  'A', textcolor=this.patternColor, style=label.style_none, yloc=this.dir < 0 ? yloc.belowbar : yloc.abovebar, size=this.properties.lblSizePivots)
        this.drawing.b :=label.new(this.b, 'B', textcolor=this.patternColor, style=label.style_none, yloc=this.dir > 0 ? yloc.belowbar : yloc.abovebar, size=this.properties.lblSizePivots)
        this.drawing.c := label.new(this.c, 'C', textcolor=this.patternColor, style=label.style_none, yloc=this.dir < 0 ? yloc.belowbar : yloc.abovebar, size=this.properties.lblSizePivots)
    if this.properties.showRatios
        xabRatio = fibs.retracementRatio(this.x.price,this.a.price,this.b.price,this.properties.useLogScaleForScan)
        xabRatioBar = (this.x.index + this.b.index) / 2

        abcRatio = fibs.retracementRatio(this.a.price,this.b.price,this.c.price,this.properties.useLogScaleForScan)
        abcRatioBar = (this.a.index + this.c.index) / 2

        axcRatio = fibs.retracementRatio(this.a.price,this.x.price,this.c.price,this.properties.useLogScaleForScan)
        xabRatioPrice = line.get_price(this.drawing.xb, xabRatioBar)
        abcRatioPrice = line.get_price(this.drawing.ac, abcRatioBar)

        isCypher = this.przRange.patterns.includes("Cypher")
        abcRatioLabelText = str.tostring(abcRatio) + '(ABC)' + (isCypher ? '\n' + str.tostring(axcRatio) + '(AXC)' : '')
        this.drawing.xabRatio := label.new(xabRatioBar, xabRatioPrice, str.tostring(xabRatio) + '(XAB)', textcolor=this.patternColor, style=label.style_none, yloc=yloc.price, size=this.properties.lblSizePivots)
        this.drawing.abcRatio := label.new(abcRatioBar, abcRatioPrice, abcRatioLabelText, textcolor=this.patternColor,  style=label.style_none, yloc=yloc.price, size= this.properties.lblSizePivots)
	this

//@function Convert PRZRange to Projection ranges
//@param projectionPrzRanges array of PrzRange objects
//@param dir Projection direction
//@returns array<ProjectionRange>
export method getRanges(array<hpm.PrzRange> projectionPrzRanges, int dir = 1)=>
    array<ProjectionRange> projectionRanges = array.new<ProjectionRange>()
    array<float> startArray = array.new<float>()
    for prz in projectionPrzRanges
        start = prz.prz.values.first()
        end = prz.prz.values.last()
        ProjectionRange pRange = ProjectionRange.new(prz.patterns, start, end, 0)
        projectionRanges.push(pRange)
        startArray.push(start)
    
    sortIndices = startArray.sort_indices(dir > 0? order.descending : order.ascending)
    array<ProjectionRange> resultProjectionRanges = array.new<ProjectionRange>(projectionRanges.size())
    for [index, prz] in projectionRanges
        resultProjectionRanges.set(sortIndices.get(index), prz)
    resultProjectionRanges

