//@version=6
indicator(title="Stochastic Trend Signal with MTF Filter", shorttitle="StochMTF", overlay=true)

// === Input tham số ===
periodK = input.int(14, title="%K Length", minval=1)
smoothK = input.int(3, title="%K Smoothing", minval=1)
periodD = input.int(3, title="%D Smoothing", minval=1)

// === Stochastic khung hiện tại (ẩn) ===
k = ta.sma(ta.stoch(close, high, low, periodK), smoothK)

// === Stochastic khung ngày (1D) ===
k1D_raw = request.security(syminfo.tickerid, "D", ta.stoch(close, high, low, periodK))
k1D = request.security(syminfo.tickerid, "D", ta.sma(k1D_raw, smoothK))

// === Stochastic khung tuần (1W) ===
k1W_raw = request.security(syminfo.tickerid, "W", ta.stoch(close, high, low, periodK))
k1W = request.security(syminfo.tickerid, "W", ta.sma(k1W_raw, smoothK))

// === Logic nến xác nhận đảo chiều ===
isGreenCandle = close > open
wasRedCandle = close[1] < open[1]
isRedCandle = close < open
wasGreenCandle = close[1] > open[1]

// === Tín hiệu thô ===
baseBuy = (k1D > 50) and (k <= 20) and isGreenCandle and wasRedCandle
baseSell = (k1D < 50) and (k >= 80) and isRedCandle and wasGreenCandle

// === Bộ lọc xu hướng từ khung 1W ===
buyAllowed = not (k1W < 50 and k1D > 50)
sellAllowed = not (k1W > 50 and k1D < 50)

// === Tín hiệu cuối cùng ===
buySignal = baseBuy and buyAllowed
sellSignal = baseSell and sellAllowed

// === Hiển thị nhãn cảnh báo ===
plotshape(buySignal, title="BUY Signal", location=location.belowbar, style=shape.labelup, text="BUY", textcolor=color.white, size=size.small, color=color.green)
plotshape(sellSignal, title="SELL Signal", location=location.abovebar, style=shape.labeldown, text="SELL", textcolor=color.white, size=size.small, color=color.red)

// === Nền xu hướng 1D + 1W đồng pha ===
color bgColorTrend = na
if (k1D > 50 and k1W > 50)
    bgColorTrend := color.new(color.green, 85)
else if (k1D < 50 and k1W < 50)
    bgColorTrend := color.new(color.red, 85)

bgcolor(bgColorTrend, title="Trend Zone")

// === Nền xám khi xung đột xu hướng 1D ≠ 1W ===
conflict = (k1D > 50 and k1W < 50) or (k1D < 50 and k1W > 50)
bgcolor(conflict ? color.new(color.gray, 85) : na, title="Conflict Zone")

// === Điều kiện cảnh báo TradingView ===
// === Điều kiện cảnh báo TradingView với định dạng JSON ===
alertcondition(buySignal, title="BUY Alert", message='{ "pair": "{{ticker}}", "signal": "BUY", "timeframe": "{{interval}}", "price": "{{close}}", "note": "StochaticTrendSignalMTF xác nhận" }')

alertcondition(sellSignal, title="SELL Alert", message='{ "pair": "{{ticker}}", "signal": "SELL", "timeframe": "{{interval}}", "price": "{{close}}", "note": "StochaticTrendSignalMTF xác nhận" }')

