//@version=6
// Strategy: RSI Divergence + EMA Trend Filter
strategy("RSI Divergence + EMA Filter", shorttitle="RSI Div Strat", overlay=true, pyramiding=0, default_qty_type=strategy.percent_of_equity, default_qty_value=2, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2)

// ── Inputs ────────────────────────────────────────────────────────────────────
g1 = "RSI Settings"
rsi_len       = input.int(14, "RSI Length", group=g1, minval=2)
pivot_lb      = input.int(5,  "Pivot Left Bars", group=g1, minval=2, maxval=20)
pivot_rb      = input.int(5,  "Pivot Right Bars", group=g1, minval=2, maxval=20)
rsi_ob        = input.int(70, "Overbought Level", group=g1, minval=50, maxval=90)
rsi_os        = input.int(30, "Oversold Level", group=g1, minval=10, maxval=50)
require_ob_os = input.bool(false, "Require RSI in OB/OS at First Pivot", group=g1)

g2 = "Trend Filter"
use_ema_filter = input.bool(true, "Use EMA Trend Filter", group=g2)
ema_len        = input.int(200,  "Trend EMA Length", group=g2, minval=10)

g3 = "Risk Management"
use_rr      = input.bool(false,  "Use R:R Target/Stop", group=g3)
rr_ratio    = input.float(2.0,  "Risk:Reward Ratio", group=g3, minval=0.5, step=0.1)
atr_mult_sl = input.float(1.5,  "ATR Stop Multiplier", group=g3, minval=0.5, step=0.1)
atr_len     = input.int(14,     "ATR Length", group=g3, minval=1)
use_trail   = input.bool(true, "Use Trailing ATR Stop", group=g3)
trail_mult  = input.float(2.0,  "Trailing ATR Multiplier", group=g3, minval=0.5, step=0.1)

g4 = "Display"
show_div_lines = input.bool(true, "Draw Divergence Lines", group=g4)
show_entry_lbl = input.bool(true, "Show Entry Labels", group=g4)

// ── Calculations ──────────────────────────────────────────────────────────────
rsi_val   = ta.rsi(close, rsi_len)
trend_ema = ta.ema(close, ema_len)
atr_val   = ta.atr(atr_len)

ph_price = ta.pivothigh(high, pivot_lb, pivot_rb)
pl_price = ta.pivotlow(low,  pivot_lb, pivot_rb)

var float prev_ph_p = na, var float prev_ph_r = na, var int prev_ph_bar = na
var float last_ph_p = na, var float last_ph_r = na, var int last_ph_bar = na
var float prev_pl_p = na, var float prev_pl_r = na, var int prev_pl_bar = na
var float last_pl_p = na, var float last_pl_r = na, var int last_pl_bar = na

if not na(ph_price)
    prev_ph_p   := last_ph_p
    prev_ph_r   := last_ph_r
    prev_ph_bar := last_ph_bar
    last_ph_p   := ph_price
    last_ph_r   := rsi_val[pivot_rb]
    last_ph_bar := bar_index - pivot_rb

if not na(pl_price)
    prev_pl_p   := last_pl_p
    prev_pl_r   := last_pl_r
    prev_pl_bar := last_pl_bar
    last_pl_p   := pl_price
    last_pl_r   := rsi_val[pivot_rb]
    last_pl_bar := bar_index - pivot_rb

// ── Divergence Conditions ─────────────────────────────────────────────────────
bear_div = not na(ph_price) and not na(prev_ph_p) and last_ph_p > prev_ph_p and last_ph_r < prev_ph_r and (not require_ob_os or prev_ph_r >= rsi_ob)
bull_div = not na(pl_price) and not na(prev_pl_p) and last_pl_p < prev_pl_p and last_pl_r > prev_pl_r and (not require_ob_os or prev_pl_r <= rsi_os)

above_ema    = close > trend_ema
long_signal  = bull_div and (not use_ema_filter or above_ema)
short_signal = bear_div and (not use_ema_filter or not above_ema)

// ── Divergence Lines ──────────────────────────────────────────────────────────
if show_div_lines
    if bull_div and not na(prev_pl_bar)
        line.new(prev_pl_bar, prev_pl_p, last_pl_bar, last_pl_p, color=#26a69a, width=2)
    if bear_div and not na(prev_ph_bar)
        line.new(prev_ph_bar, prev_ph_p, last_ph_bar, last_ph_p, color=#ef5350, width=2)

// ── Entries ───────────────────────────────────────────────────────────────────
if long_signal and strategy.position_size == 0
    sl_price = close - atr_mult_sl * atr_val
    tp_price = close + rr_ratio * atr_mult_sl * atr_val
    strategy.entry("Long", strategy.long)
    if use_rr
        strategy.exit("Long Exit", "Long", stop=sl_price, limit=tp_price)
    if show_entry_lbl
        label.new(bar_index, low, "LONG\nRSI Div", style=label.style_label_up, color=color.new(#26a69a, 20), textcolor=color.white, size=size.small)

if short_signal and strategy.position_size == 0
    sl_price = close + atr_mult_sl * atr_val
    tp_price = close - rr_ratio * atr_mult_sl * atr_val
    strategy.entry("Short", strategy.short)
    if use_rr
        strategy.exit("Short Exit", "Short", stop=sl_price, limit=tp_price)
    if show_entry_lbl
        label.new(bar_index, high, "SHORT\nRSI Div", style=label.style_label_down, color=color.new(#ef5350, 20), textcolor=color.white, size=size.small)

// ── Trailing Stop ─────────────────────────────────────────────────────────────
if use_trail and strategy.position_size > 0
    strategy.exit("Long Trail", "Long", trail_points=trail_mult * atr_val / syminfo.mintick, trail_offset=trail_mult * atr_val / syminfo.mintick)

if use_trail and strategy.position_size < 0
    strategy.exit("Short Trail", "Short", trail_points=trail_mult * atr_val / syminfo.mintick, trail_offset=trail_mult * atr_val / syminfo.mintick)

// ── Visual ────────────────────────────────────────────────────────────────────
plot(trend_ema, "Trend EMA", color=color.new(#2196F3, 30), linewidth=2)
plotshape(long_signal,  "Bull Div Signal", shape.triangleup,   location.belowbar, #26a69a, size=size.normal)
plotshape(short_signal, "Bear Div Signal", shape.triangledown, location.abovebar, #ef5350, size=size.normal)

pos_bg = strategy.position_size > 0 ? color.new(#26a69a, 96) : strategy.position_size < 0 ? color.new(#ef5350, 96) : na
bgcolor(pos_bg, title="Position Background")

alertcondition(long_signal,  "Long Entry",  "{{ticker}} — RSI Bullish Divergence Long Signal on {{interval}}")
alertcondition(short_signal, "Short Entry", "{{ticker}} — RSI Bearish Divergence Short Signal on {{interval}}")
