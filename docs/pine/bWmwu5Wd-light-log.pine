//@function Returns true if the INT wrapper has an active log entry.
//@param self The INT instance to check.
//@returns True if an error or message is active in the log.
export method has_error(INT self) =>
    self.e.active

//@function Returns true if the FLOAT wrapper has an active log entry.
//@param self The FLOAT instance to check.
//@returns True if an error or message is active in the log.
export method has_error(FLOAT self) =>
    self.e.active

