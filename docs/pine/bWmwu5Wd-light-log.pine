// value string {


// { helpers

//@function Generates a formatted string that optionally includes a variable name for log context.
//@param var_name Optional name of the variable to include in the log message.
//@returns A formatted string containing the variable name, or an empty string if none provided
var_name(string var_name = "")=>
    string log_value = switch
        var_name != "" and not na(var_name) => "Variable Name: " + var_name + "\n"
        => ""
    log_value


// } helpers


// { built in


//@function Converts an `int` value to a formatted string for logging or debugging.
//@param self The `int` to stringify.
//@param var_name Optional variable name to label the value.
//@returns A formatted string representation of the value.
export method value_string(int self, string var_name = "")=>
    string value_string = var_name(var_name)
    value_string += "int Value: " + str.tostring(self)
    value_string


//@function Converts a `float` value to a formatted string for logging or debugging.
//@param self The `float` to stringify.
//@param var_name Optional variable name to label the value.
//@returns A formatted string representation of the value.
export method value_string(float self, string var_name = "")=>
    string value_string = var_name(var_name)
    value_string += "float Value: " + str.tostring(self)
    value_string


//@function Converts a `bool` value to a formatted string for logging or debugging.
//@param self The `bool` to stringify.
//@param var_name Optional variable name to label the value.
//@returns A formatted string representation of the value.
export method value_string(bool self, string var_name = "")=>
    string value_string = var_name(var_name)
    value_string += "bool Value: " + str.tostring(self) 
    value_string


//@function Formats a `string` value for logging or debugging.
//@param self The `string` to log.
//@param var_name Optional variable name to label the value.
//@returns A formatted string representation of the value.
export method value_string(string self, string var_name = "")=>
    string value_string = var_name(var_name)
    value_string += "string Value: " + self
    value_string


//@function Converts a `color` to its RGBA components as a formatted string.
//@param self The `color` to describe.
//@param var_name Optional variable name to label the value.
//@returns A multi-line string with R, G, B, T values.
export method value_string(color self, string var_name = "")=>
    string r = str.tostring(color.r(self))
    string g = str.tostring(color.g(self))
    string b = str.tostring(color.b(self))
    string t = str.tostring(color.t(self))

    string value_string = var_name(var_name)
    value_string += "color Value:\n"
    value_string += "R: " + r + "\n"
    value_string += "G: " + g + "\n"
    value_string += "B: " + b + "\n"
    value_string += "T: " + t
    value_string


//@function Returns a string with the line's coordinates for logging or debugging.
//@param self The `line` to describe.
//@param var_name Optional variable name to label the value.
//@returns A multi-line string with X1, X2, Y1, Y2 values.
export method value_string(line self, string var_name = "")=>
    string x1 = str.tostring(self.get_x1())
    string x2 = str.tostring(self.get_x2())
    string y1 = str.tostring(self.get_y1())
    string y2 = str.tostring(self.get_y2())

    string value_string = var_name(var_name)
    value_string += "line Value:\n"
    value_string += "X1: " + x1 + "\n"
    value_string += "X2: " + x2 + "\n"
    value_string += "Y1: " + y1 + "\n"
    value_string += "Y2: " + y2
    value_string


//@function Returns the position and text of a `label` as a formatted string.
//@param self The `label` to describe.
//@param var_name Optional variable name to label the value.
//@returns A string showing the label’s X/Y coordinates and text.
export method value_string(label self, string var_name = "")=>
    string x = str.tostring(self.get_x())
    string y = str.tostring(self.get_y())
    string txt = self.get_text()

    string value_string = var_name(var_name)
    value_string += "label Value:\n"
    value_string += "X: " + x + "\n"
    value_string += "Y: " + y + "\n"
    value_string += "Text: " + txt
    value_string


//@function Returns the bounding box edges as a formatted string.
//@param self The `box` to describe.
//@param var_name Optional variable name to label the value.
//@returns A multi-line string with left, right, top, and bottom positions.
export method value_string(box self, string var_name = "")=>
    string left = str.tostring(self.get_left())
    string right = str.tostring(self.get_right())
    string top = str.tostring(self.get_top())
    string bottom = str.tostring(self.get_bottom())

    string value_string = var_name(var_name)
    value_string += "box Value:\n"
    value_string += "Left: " + left + "\n"
    value_string += "Right: " + right + "\n"
    value_string += "Top: " + top + "\n"
    value_string += "Bottom: " + bottom
    value_string


//@function Converts a `chart.point` to a readable string format.
//@param self The `chart.point` to describe.
//@param var_name Optional variable name to label the value.
//@returns A multi-line string with price, index, and time values.
export method value_string(chart.point self, string var_name = "")=>
    string price = str.tostring(self.price)
    string index = str.tostring(self.index)
    string tm = str.tostring(self.time)

    string value_string = var_name(var_name)
    value_string += "chart.point Value:\n"
    value_string += "Price: " + price + "\n"
    value_string += "Index: " + index + "\n"
    value_string += "Time: " + tm
    value_string


//@function Returns a formatted string of the two lines making up a `linefill`.
//@param self The `linefill` to describe.
//@param var_name Optional variable name to label the value.
//@returns A multi-line string showing line 1 and line 2 details.
export method value_string(linefill self, string var_name = "")=>
    string value_string = var_name(var_name)
    value_string += "linefill Value:\n"
    value_string += self.get_line1().value_string("Line 1")
    value_string += self.get_line2().value_string("Line 2")
    value_string


// } built in


// { extended


//@function Returns the internal state of a `Log` object as a formatted string.
//@param self The `Log` object to stringify.
//@param var_name Optional variable name for identification.
//@returns A formatted string showing the log level, activation status, and message.
method value_string(Log self, string var_name = "")=>
    string value_string = var_name(var_name)
    value_string += "\nLog Level: " + str.tostring(self.error_type) + "\n"
    value_string += "Log Active: " + str.tostring(self.active) + "\n"
    value_string += "Log Message:\n" + self.message 
    value_string


//@function Returns a formatted string of an `INT` object, including its value and error state.
//@param self The `INT` object to stringify.
//@param var_name Optional variable name for identification.
//@returns A formatted string showing the integer value and associated error state.
