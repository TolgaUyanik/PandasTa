//@version=6

//@description A lightweight logging and defensive programming library for Pine Script.
// Designed for modular and extensible scripts, this utility provides structured runtime validation,
// conditional logging, and reusable `Log` objects for centralized error propagation.
// It also introduces a typed wrapping system for all native Pine values (e.g., `INT`, `FLOAT`, `LABEL`),
// allowing values to carry errors alongside data. This enables functional-style flows with built-in 
// validation tracking, error detection (`has_error()`), and fluent chaining.
// Inspired by structured logging patterns found in systems like C#, it reduces boilerplate,
// enforces argument safety, and encourages clean, maintainable code architecture.
library("light_log")


// LIBRARY {


// enums {

//@enum Defines log severity levels used for output handling and conditional rendering.
//@field info Informational message. Non-critical status updates or helpful debug context.
//@field warning Warning message. Indicates non-fatal but unexpected or risky behavior.
//@field error Error message. Highlights significant logic errors or violations.
//@field runtime_error Runtime error. Immediately halts script execution.
export enum ErrorType
	info = "log.info()"
	warning = "log.warning()"
	error = "log.error()"
	runtime_error = "runtime.error()"


// enums }


// types {


//@type A structured object used to store and render logging messages.
//@field error_type The severity level of the message (from the ErrorType enum).
//@field message The text of the log message.
//@field active Whether the log should trigger rendering when conditionally evaluated.
export type Log
	ErrorType error_type
	string message = ""
	bool active = false


//@type A wrapped integer type with attached logging for validation or tracing.
//@field v The underlying `int` value.
//@field e Optional log object describing validation status or error context.
export type INT
    int v = na
    Log e = na


//@type A wrapped float type with attached logging for validation or tracing.
//@field v The underlying `float` value.
//@field e Optional log object describing validation status or error context.
export type FLOAT
    float v = na
    Log e = na


//@type A wrapped boolean type with attached logging for validation or tracing.
//@field v The underlying `bool` value.
//@field e Optional log object describing validation status or error context.
export type BOOL
    bool v = false
    Log e = na


//@type A wrapped string type with attached logging for validation or tracing.
//@field v The underlying `string` value.
//@field e Optional log object describing validation status or error context.
export type STRING
    string v = na
    Log e = na


//@type A wrapped color type with attached logging for validation or tracing.
//@field v The underlying `color` value.
//@field e Optional log object describing validation status or error context.
export type COLOR
    color v = na
    Log e = na


//@type A wrapped line object with attached logging for validation or tracing.
//@field v The underlying `line` value.
//@field e Optional log object describing validation status or error context.
export type LINE
    line v = na
    Log e = na


//@type A wrapped label object with attached logging for validation or tracing.
//@field v The underlying `label` value.
//@field e Optional log object describing validation status or error context.
export type LABEL
    label v = na
    Log e = na


//@type A wrapped box object with attached logging for validation or tracing.
//@field v The underlying `box` value.
//@field e Optional log object describing validation status or error context.
export type BOX
    box v = na
    Log e = na


//@type A wrapped table object with attached logging for validation or tracing.
//@field v The underlying `table` value.
//@field e Optional log object describing validation status or error context.
export type TABLE
    table v = na
    Log e = na


//@type A wrapped chart point with attached logging for validation or tracing.
//@field v The underlying `chart.point` value.
//@field e Optional log object describing validation status or error context.
export type CHART_POINT
    chart.point v = na
    Log e = na


//@type A wrapped polyline object with attached logging for validation or tracing.
//@field v The underlying `polyline` value.
//@field e Optional log object describing validation status or error context.
export type POLYLINE
    polyline v = na
    Log e = na


//@type A wrapped linefill object with attached logging for validation or tracing.
//@field v The underlying `linefill` value.
//@field e Optional log object describing validation status or error context.
export type LINEFILL
    linefill v = na
    Log e = na


// types }


// type extend {


//@function Wraps an `int` value into an `INT` struct with an optional log severity.
//@param self The raw `int` value to wrap.
//@param error_type Optional severity level to associate with the log. Default is `ErrorType.error`.
//@returns An `INT` object containing the value and a default Log instance.
export method INT(int self, ErrorType error_type = ErrorType.error) =>
    INT.new(self, Log.new(error_type))

//@function Wraps a `float` value into a `FLOAT` struct with an optional log severity.
//@param self The raw `float` value to wrap.
//@param error_type Optional severity level to associate with the log. Default is `ErrorType.error`.
//@returns A `FLOAT` object containing the value and a default Log instance.
export method FLOAT(float self, ErrorType error_type = ErrorType.error) =>
    FLOAT.new(self, Log.new(error_type))

