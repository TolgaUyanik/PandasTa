//@function Extracts the integer value from an INT wrapper.
//@param self The wrapped INT instance.
//@returns The underlying `int` value.
export method from_INT(INT self) =>
    self.v

//@function Extracts the float value from a FLOAT wrapper.
//@param self The wrapped FLOAT instance.
//@returns The underlying `float` value.
export method from_FLOAT(FLOAT self) =>
    self.v

