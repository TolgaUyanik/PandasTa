// type extend }


// casting {


//@function Converts a FLOAT wrapper to an INT wrapper, truncating the float value.
// The original log context is preserved.
//@param self The FLOAT instance to convert.
//@returns An INT wrapper with the truncated integer value and original log.
export method INT(FLOAT self) =>
    INT.new(int(self.v), self.e)

//@function Converts an INT wrapper to a FLOAT wrapper.
// The original log context is preserved.
//@param self The INT instance to convert.
//@returns A FLOAT wrapper with the float-casted value and original log.
export method FLOAT(INT self) =>
    FLOAT.new(self.v, self.e)

//@function Converts an INT wrapper to a STRING wrapper using `str.tostring()`.
// The original log context is preserved.
//@param self The INT instance to convert.
//@returns A STRING wrapper with the string representation and original log.
export method STRING(INT self) =>
    STRING.new(str.tostring(self.v), self.e)

//@function Converts a FLOAT wrapper to a STRING wrapper using `str.tostring()`.
// The original log context is preserved.
//@param self The FLOAT instance to convert.
//@returns A STRING wrapper with the string representation and original log.
export method STRING(FLOAT self) =>
    STRING.new(str.tostring(self.v), self.e)


// casting }


// utility {


//@function Utility function used when a return is syntactically required but functionally unnecessary.
//@returns Nothing. Function never executes its body.
export void_return()=>
    if false
        runtime.error("VOID")


//@function Logs the string message at a specified severity level.
//@param self The message to log.
//@param error_type The severity level to use when logging the message.
//@returns Nothing. Emits the message using the selected `log.*` or `runtime.error`.
export method log_level(string self, ErrorType error_type)=>
    switch error_type
        ErrorType.info => log.info(self)
        ErrorType.warning => log.warning(self)
        ErrorType.error => log.error(self)
        ErrorType.runtime_error => runtime.error(self)


//@function Logs the message from a `Log` object at a specified severity level.
//@param self The `Log` object containing the message.
//@param error_type The severity level to use when logging the message.
//@returns Nothing. Emits the `Log.message` using the selected `log.*` or `runtime.error`.
export method log_level(Log self, ErrorType error_type)=>
    switch error_type
        ErrorType.info => log.info(self.message)
        ErrorType.warning => log.warning(self.message)
        ErrorType.error => log.error(self.message)
        ErrorType.runtime_error => runtime.error(self.message)


// utility }


// argument errors {


//@function Throws a runtime error when a condition is met. Used for strict argument validation.
//@param condition Boolean expression that triggers the runtime error.
//@param function Name of the calling function (for formatting).
//@param argument Name of the problematic argument.
//@param message Description of the error cause.
//@returns Never returns. Halts execution if the condition is true.
export argument_error(bool condition, string function, string argument, string message)=>
    if condition
        string error_message = "Error in "
        error_message += function + "(). "
        error_message += "Argument '" + argument + "' "
        error_message += message + "."

        if condition
            runtime.error(error_message)


//@function Logs an informational message when a condition is met. Used for optional debug visibility.
//@param condition Boolean expression that triggers the log.
//@param function Name of the calling function.
//@param argument Argument name being referenced.
//@param message Informational message to log.
//@returns Nothing. Logs if the condition is true.
export argument_log_info(bool condition, string function, string argument, string message)=>
    if condition
        string info_message = "Info in "
        info_message += function + "(). "
        info_message += "Argument '" + argument + "' "
        info_message += message + "."

        if condition
            log.info(info_message)


//@function Logs a warning when a condition is met. Non-fatal but highlights potential issues.
//@param condition Boolean expression that triggers the warning.
//@param function Name of the calling function.
//@param argument Argument name being referenced.
//@param message Warning message to log.
//@returns Nothing. Logs if the condition is true.
export argument_log_warning(bool condition, string function, string argument, string message)=>
    if condition
        string warning_message = "Warning in "
        warning_message += function + "(). "
        warning_message += "Argument '" + argument + "' "
        warning_message += message + "."

        if condition
            log.warning(warning_message)


//@function Logs an error message when a condition is met. Does not halt execution.
//@param condition Boolean expression that triggers the error log.
//@param function Name of the calling function.
//@param argument Argument name being referenced.
//@param message Error message to log.
//@returns Nothing. Logs if the condition is true.
export argument_log_error(bool condition, string function, string argument, string message)=>
    if condition
        string error_message = "Info in "
        error_message += function + "(). "
        error_message += "Argument '" + argument + "' "
        error_message += message + "."

        if condition
            log.error(error_message)


// argument errors }


// logging object {


//@function Initializes a persistent (var) Log object. Ideal for global logging in scripts or modules.
//@param error_type Initial severity level (required).
//@param message Optional starting message string. Default value of ("").
//@param active Whether the log should be flagged active on initialization. Default value of (false).
//@returns A static Log object with the given parameters.
export init_static_log(ErrorType error_type, string message = "", bool active = false)=>
	argument_error(na(error_type), "init_static_log", "error_type", "field was na. Please use the ErrorType enum")
	var Log static_log = Log.new(error_type, na(message) ? "" : message, active)
	static_log


//@function Appends a newline character to the Log message. Useful for separating entries during chained writes.
//@param self The Log instance to modify.
//@returns The updated Log object with a newline appended.
export method new_line(Log self) =>
    argument_error(na(self), "write_line", "self", "Log object was na")

    self.message += "\n"
    self


//@function Appends a message to a Log object without a newline. Updates severity and active state if specified.
//@param self The Log instance being modified.
//@param message The text to append to the log.
//@param flag_active Whether to activate the log for conditional rendering. Default value of (false).
//@param error_type Optional override for the severity level. Default value of (na).
//@returns The updated Log object.
export method write(Log self, string message, bool flag_active = false, ErrorType error_type = na)=>
	argument_error(na(self), "write", "self", "Log object was na")
	argument_error(na(message), "write", "message", "string must not be na. If needed, use an empty string")

	self.error_type := switch
		not na(error_type) => error_type
		=> self.error_type

	self.message += message

	self.active := switch
		flag_active => true
		=> self.active
	self


//@function Appends a message to a Log object, prefixed with a newline for clarity.
//@param self The Log instance being modified.
//@param message The text to append to the log.
//@param flag_active Whether to activate the log for conditional rendering. Default value of (false).
//@param error_type Optional override for the severity level. Default value of (na).
//@returns The updated Log object.
export method write_line(Log self, string message, bool flag_active = false, ErrorType error_type = na)=>
	argument_error(na(self), "write_line", "self", "Log object was na")
	argument_error(na(message), "write_line", "message", "string must not be na. If needed, use an empty string")

	self.error_type := switch
		not na(error_type) => error_type
		=> self.error_type

	self.message += "\n"
	self.message += message

	self.active := switch
		flag_active => true
		=> self.active
	self


//@function Clears a Log object’s message and optionally reactivates it. Can also update the error type.
//@param self The Log instance being cleared.
//@param flag_active Whether to activate the log after clearing. Default value of (false).
//@param error_type Optional new error type to assign. If not provided, the previous type is retained. Default value of (na).
//@returns The cleared Log object.
export method clear(Log self, bool flag_active = false, ErrorType error_type = na) =>
    argument_error(na(self), "clear", "self", "Log object was na")

    self.error_type := na(error_type) ? self.error_type : error_type
    self.message := ""
    self.active := flag_active
    self


//@function Conditionally renders the log if it is active. Allows overriding error type and controlling active state afterward.
//@param self The Log instance to evaluate and render.
//@param flag_active Whether to activate the log after rendering. Default value of (false).
//@param error_type Optional error type override. Useful for contextual formatting just before rendering. Default value of (na).
//@returns The updated Log object.
export method render_condition(Log self, bool flag_active = false, ErrorType error_type = na) =>
    argument_error(na(self), "render_condition", "self", "Log object was na")
    argument_error(na(self.error_type), "render_condition", "self.error_type", "value was na")
    argument_error(na(self.message), "render_condition", "self.message", "value was na")

    if self.active
        self.error_type := na(error_type) ? self.error_type : error_type
        self.active := flag_active

        switch self.error_type
            ErrorType.info => log.info(self.message)
            ErrorType.warning => log.warning(self.message)
            ErrorType.error => log.error(self.message)
            ErrorType.runtime_error => runtime.error(self.message)
    self


//@function Immediately renders the log regardless of `active` state. Allows overriding error type and active flag.
//@param self The Log instance to render.
//@param flag_active Whether to activate the log after rendering. Default value of (false).
//@param error_type Optional error type override. Allows dynamic severity adjustment at render time. Default value of (na).
//@returns The updated Log object.
export method render_now(Log self, bool flag_active = false, ErrorType error_type = na) =>
    argument_error(na(self), "render_now", "self", "Log object was na")
    argument_error(na(self.error_type), "render_now", "self.error_type", "value was na")
    argument_error(na(self.message), "render_now", "self.message", "value was na")

    self.error_type := na(error_type) ? self.error_type : error_type
    self.active := flag_active

    switch self.error_type
        ErrorType.info => log.info(self.message)
        ErrorType.warning => log.warning(self.message)
        ErrorType.error => log.error(self.message)
        ErrorType.runtime_error => runtime.error(self.message)
    self


//@function Renders the log conditionally or unconditionally. Allows full control over render behavior.
//@param self The Log instance to render.
//@param condition If true, renders only if the log is active. If false, always renders. Default value of (false).
//@param flag_active Whether to activate the log after rendering. Default value of (false).
//@param error_type Optional error type override passed to the render methods. Default value of (na).
//@returns The updated Log object.
export render(Log self, bool condition = false, bool flag_active = false, ErrorType error_type = na) =>
    if condition
        self.render_condition(flag_active, error_type)
    else
        self.render_now(flag_active, error_type)
    self


// logging object }


// logging type wrappers {


// { INT


//@function Appends a newline character to the Log message. Useful for separating entries during chained writes.
//@param self The Log instance to modify.
//@returns The updated Log object with a newline appended.
export method new_line(INT self) =>
    argument_error(na(self.e), "write_line", "self.e", "Log object was na")

    self.e.message += "\n"
    self


//@function Appends a message to a Log object without a newline. Updates severity and active state if specified.
//@param self The Log instance being modified.
//@param message The text to append to the log.
//@param flag_active Whether to activate the log for conditional rendering. Default value of (false).
//@param error_type Optional override for the severity level. Default value of (na).
//@returns The updated Log object.
export method write(INT self, string message, bool flag_active = false, ErrorType error_type = na)=>
	argument_error(na(self.e), "write", "self.e", "Log object was na")
	argument_error(na(message), "write", "message", "string must not be na. If needed, use an empty string")

	self.e.error_type := switch
		not na(error_type) => error_type
		=> self.e.error_type

	self.e.message += message

	self.e.active := switch
		flag_active => true
		=> self.e.active
	self


//@function Appends a message to a Log object, prefixed with a newline for clarity.
//@param self The Log instance being modified.
//@param message The text to append to the log.
//@param flag_active Whether to activate the log for conditional rendering. Default value of (false).
//@param error_type Optional override for the severity level. Default value of (na).
//@returns The updated Log object.
export method write_line(INT self, string message, bool flag_active = false, ErrorType error_type = na)=>
	argument_error(na(self.e), "write_line", "self.e", "Log object was na")
	argument_error(na(message), "write_line", "message", "string must not be na. If needed, use an empty string")

	self.e.error_type := switch
		not na(error_type) => error_type
		=> self.e.error_type

	self.e.message += "\n"
	self.e.message += message

	self.e.active := switch
		flag_active => true
		=> self.e.active
	self


//@function Clears a Log object’s message and optionally reactivates it. Can also update the error type.
//@param self The Log instance being cleared.
//@param flag_active Whether to activate the log after clearing. Default value of (false).
//@param error_type Optional new error type to assign. If not provided, the previous type is retained. Default value of (na).
//@returns The cleared Log object.
export method clear(INT self, bool flag_active = false, ErrorType error_type = na) =>
    argument_error(na(self), "clear", "self", "Log object was na")

    self.e.error_type := na(error_type) ? self.e.error_type : error_type
    self.e.message := ""
    self.e.active := flag_active
    self


//@function Conditionally renders the log if it is active. Allows overriding error type and controlling active state afterward.
//@param self The Log instance to evaluate and render.
//@param flag_active Whether to activate the log after rendering. Default value of (false).
//@param error_type Optional error type override. Useful for contextual formatting just before rendering. Default value of (na).
//@returns The updated Log object.
export method render_condition(INT self, bool flag_active = false, ErrorType error_type = na) =>
    argument_error(na(self), "render_condition", "self", "Log object was na")
    argument_error(na(self.e.error_type), "render_condition", "self.e.error_type", "value was na")
    argument_error(na(self.e.message), "render_condition", "self.e.message", "value was na")

    if self.e.active
        self.e.error_type := na(error_type) ? self.e.error_type : error_type
        self.e.active := flag_active

        switch self.e.error_type
            ErrorType.info => log.info(self.e.message)
            ErrorType.warning => log.warning(self.e.message)
            ErrorType.error => log.error(self.e.message)
            ErrorType.runtime_error => runtime.error(self.e.message)
    self


//@function Immediately renders the log regardless of `active` state. Allows overriding error type and active flag.
//@param self The Log instance to render.
//@param flag_active Whether to activate the log after rendering. Default value of (false).
//@param error_type Optional error type override. Allows dynamic severity adjustment at render time. Default value of (na).
//@returns The updated Log object.
export method render_now(INT self, bool flag_active = false, ErrorType error_type = na) =>
    argument_error(na(self), "render_now", "self", "Log object was na")
    argument_error(na(self.e.error_type), "render_now", "self.e.error_type", "value was na")
    argument_error(na(self.e.message), "render_now", "self.e.message", "value was na")

    self.e.error_type := na(error_type) ? self.e.error_type : error_type
    self.e.active := flag_active

    switch self.e.error_type
        ErrorType.info => log.info(self.e.message)
        ErrorType.warning => log.warning(self.e.message)
        ErrorType.error => log.error(self.e.message)
        ErrorType.runtime_error => runtime.error(self.e.message)
    self


//@function Renders the log conditionally or unconditionally. Allows full control over render behavior.
//@param self The Log instance to render.
//@param condition If true, renders only if the log is active. If false, always renders. Default value of (false).
//@param flag_active Whether to activate the log after rendering. Default value of (false).
//@param error_type Optional error type override passed to the render methods. Default value of (na).
//@returns The updated Log object.
export render(INT self, bool condition = false, bool flag_active = false, ErrorType error_type = na) =>
    if condition
        self.e.render_condition(flag_active, error_type)
    else
        self.e.render_now(flag_active, error_type)
    self


