    value_string += self.e.value_string()
    value_string


//@function Returns a formatted string of a `LINEFILL` object, including both lines and error info.
//@param self The `LINEFILL` object to stringify.
//@param var_name Optional variable name for identification.
//@returns A formatted string of both line components and their error state.
export method value_string(LINEFILL self, string var_name = "")=>
    string value_string = var_name(var_name)
    value_string += "LINEFILL Value:\n"
    value_string += self.v.get_line1().value_string("Line 1")
    value_string += self.v.get_line2().value_string("Line 2")
    value_string += self.e.value_string()
    value_string


// } extended


