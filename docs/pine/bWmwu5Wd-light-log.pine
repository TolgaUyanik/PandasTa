        self.e.error_type := na(error_type) ? self.e.error_type : error_type
        self.e.active := flag_active
        self.e.log_level(self.e.error_type)
    self


//@function Immediately renders the log regardless of `active` state. Allows overriding error type and active flag.
//@param self The Log instance to render.
//@param flag_active Whether to activate the log after rendering. Default value of (false).
//@param error_type Optional error type override. Allows dynamic severity adjustment at render time. Default value of (na).
//@returns The updated Log object.
export method render_now(CHART_POINT self, bool flag_active = false, ErrorType error_type = na) =>
