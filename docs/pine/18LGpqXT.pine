// @version = 6
indicator("瀑布线", overlay=true)

//—— 输入参数 ——//
ma1_period = input.int(4,   "SMMA 4 周期",    minval=1)
ma2_period = input.int(6,   "SMMA 6 周期",    minval=1)
ma3_period = input.int(8,   "SMMA 8 周期",    minval=1)
ma4_period = input.int(13,  "SMMA 13 周期",   minval=1)
ma5_period = input.int(19,  "SMMA 19 周期",   minval=1)
ma6_period = input.int(24,  "SMMA 24 周期",   minval=1)

color_ma1 = input.color(color.rgb(30,144,255), "SMMA 4 颜色")    // DodgerBlue
color_ma2 = input.color(color.rgb(211, 177, 28),   "SMMA 6 颜色")    // OrangeRed
color_ma3 = input.color(color.aqua,            "SMMA 8 颜色")    // Aqua
color_ma4 = input.color(color.aqua,            "SMMA 13 颜色")
color_ma5 = input.color(color.aqua,            "SMMA 19 颜色")
color_ma6 = input.color(color.red,             "SMMA 24 颜色")

line_w = input.int(1, "线宽", minval=1)

//—— 计算 SMMA（Wilder 平滑） ——//
// Pine Script 中的 ta.rma 即 Wilder 平滑移动平均，与 MQL5 的 MODE_SMMA 等价
smma4  = ta.rma(close, ma1_period)
smma6  = ta.rma(close, ma2_period)
smma8  = ta.rma(close, ma3_period)
smma13 = ta.rma(close, ma4_period)
smma19 = ta.rma(close, ma5_period)
smma24 = ta.rma(close, ma6_period)

//—— 绘制 ——//
plot(smma4,  title="SMMA 4",  color=color_ma1, linewidth=line_w)
plot(smma6,  title="SMMA 6",  color=color_ma2, linewidth=line_w)
plot(smma8,  title="SMMA 8",  color=color_ma3, linewidth=line_w)
plot(smma13, title="SMMA 13", color=color_ma4, linewidth=line_w)
plot(smma19, title="SMMA 19", color=color_ma5, linewidth=line_w)
plot(smma24, title="SMMA 24", color=color_ma6, linewidth=line_w)