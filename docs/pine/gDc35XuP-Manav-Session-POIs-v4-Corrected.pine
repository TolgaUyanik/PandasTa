//@version=6
indicator("Manav Session POIs v5 Clean", overlay = true, max_lines_count = 20, max_labels_count = 20)

// SETTINGS
const string TZ = "America/New_York"
const string CALC_TF = "1"

bool showPD = input.bool(true, "Previous RTH High / Low")
bool showON = input.bool(true, "Overnight High / Low")
bool showAsia = input.bool(true, "Asia High / Low")
bool showLondon = input.bool(true, "London High / Low")
bool showLabels = input.bool(true, "Show Names and Prices")
int lineWidth = input.int(1, "Line Width", minval = 1, maxval = 4)

bool hideAsiaAfter1100 = input.bool(true, "Hide Asia after 11:00 AM ET")
bool hideLondonAfter1200 = input.bool(true, "Hide London after 12:00 PM ET")
bool hideONAfter1600 = input.bool(true, "Hide Overnight after 4:00 PM ET")

color pdColor = input.color(color.red, "Previous RTH Color")
color onColor = input.color(color.orange, "Overnight Color")
color asiaColor = input.color(color.blue, "Asia Color")
color londonColor = input.color(color.green, "London Color")

// SESSION DEFINITIONS — NEW YORK TIME
const string RTH_SESSION = "0930-1600:23456"
const string ON_SESSION = "1800-0930:1234567"
const string ASIA_SESSION = "2000-0500:1234567"
const string LONDON_SESSION = "0300-0930:1234567"

// SESSION CALCULATIONS
f_sessionRange(string sessionHours) =>
    bool active = not na(time(timeframe.period, sessionHours, TZ))
    bool starts = active and not active[1]
    var float sessionHigh = na
    var float sessionLow = na
    var int sessionStart = na
    if starts
        sessionHigh := high
        sessionLow := low
        sessionStart := time
    else if active
        sessionHigh := math.max(nz(sessionHigh, high), high)
        sessionLow := math.min(nz(sessionLow, low), low)
    [sessionHigh, sessionLow, sessionStart]

f_previousRTH() =>
    bool active = not na(time(timeframe.period, RTH_SESSION, TZ))
    bool starts = active and not active[1]
    bool ends = not active and active[1]
    var float currentHigh = na
    var float currentLow = na
    var float completedHigh = na
    var float completedLow = na
    if starts
        currentHigh := high
        currentLow := low
    else if active
        currentHigh := math.max(nz(currentHigh, high), high)
        currentLow := math.min(nz(currentLow, low), low)
    if ends
        completedHigh := currentHigh
        completedLow := currentLow
    [completedHigh, completedLow]

[overnightHigh, overnightLow, overnightStart] = request.security(syminfo.tickerid, CALC_TF, f_sessionRange(ON_SESSION), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[asiaHigh, asiaLow, asiaStart] = request.security(syminfo.tickerid, CALC_TF, f_sessionRange(ASIA_SESSION), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[londonHigh, londonLow, londonStart] = request.security(syminfo.tickerid, CALC_TF, f_sessionRange(LONDON_SESSION), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[completedRTHHigh, completedRTHLow] = request.security(syminfo.tickerid, CALC_TF, f_previousRTH(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

bool newOvernight = not na(overnightStart) and (na(overnightStart[1]) or overnightStart != overnightStart[1])
bool newAsia = not na(asiaStart) and (na(asiaStart[1]) or asiaStart != asiaStart[1])
bool newLondon = not na(londonStart) and (na(londonStart[1]) or londonStart != londonStart[1])

var float activePDH = na
var float activePDL = na

var line pdhLine = na
var line pdlLine = na
var line onhLine = na
var line onlLine = na
var line asiaHighLine = na
var line asiaLowLine = na
var line londonHighLine = na
var line londonLowLine = na

var label pdhLabel = na
var label pdlLabel = na
var label onhLabel = na
var label onlLabel = na
var label asiaHighLabel = na
var label asiaLowLabel = na
var label londonHighLabel = na
var label londonLowLabel = na

// DRAWING HELPERS
f_deleteLine(line lineID) =>
    if not na(lineID)
        line.delete(lineID)

f_deleteLabel(label labelID) =>
    if not na(labelID)
        label.delete(labelID)

f_newLine(int startTime, float levelPrice, color lineColor) =>
    line.new(x1 = startTime, y1 = levelPrice, x2 = time_close, y2 = levelPrice, xloc = xloc.bar_time, extend = extend.none, color = lineColor, width = lineWidth)

f_newLabel(float levelPrice, string levelName, color labelColor) =>
    label.new(x = time_close, y = levelPrice, text = levelName + "  " + str.tostring(levelPrice, format.mintick), xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = labelColor, textcolor = color.white, size = size.small)

f_updateLine(line lineID, float levelPrice) =>
    if not na(lineID) and not na(levelPrice)
        line.set_x2(lineID, time_close)
        line.set_y1(lineID, levelPrice)
        line.set_y2(lineID, levelPrice)

f_updateLabel(label labelID, float levelPrice, string levelName, color labelColor) =>
    if not na(labelID) and not na(levelPrice)
        label.set_x(labelID, time_close)
        label.set_y(labelID, levelPrice)
        label.set_text(labelID, levelName + "  " + str.tostring(levelPrice, format.mintick))
        label.set_color(labelID, labelColor)

// NEW FUTURES DAY — 6:00 PM ET
if newOvernight
    f_deleteLine(pdhLine)
    f_deleteLine(pdlLine)
    f_deleteLine(onhLine)
    f_deleteLine(onlLine)
    f_deleteLine(asiaHighLine)
    f_deleteLine(asiaLowLine)
    f_deleteLine(londonHighLine)
    f_deleteLine(londonLowLine)
    f_deleteLabel(pdhLabel)
    f_deleteLabel(pdlLabel)
    f_deleteLabel(onhLabel)
    f_deleteLabel(onlLabel)
    f_deleteLabel(asiaHighLabel)
    f_deleteLabel(asiaLowLabel)
    f_deleteLabel(londonHighLabel)
    f_deleteLabel(londonLowLabel)

    pdhLine := na
    pdlLine := na
    onhLine := na
    onlLine := na
    asiaHighLine := na
    asiaLowLine := na
    londonHighLine := na
    londonLowLine := na
    pdhLabel := na
    pdlLabel := na
    onhLabel := na
    onlLabel := na
    asiaHighLabel := na
    asiaLowLabel := na
    londonHighLabel := na
    londonLowLabel := na

    activePDH := completedRTHHigh
    activePDL := completedRTHLow

    if showPD and not na(activePDH) and not na(activePDL)
        pdhLine := f_newLine(overnightStart, activePDH, pdColor)
        pdlLine := f_newLine(overnightStart, activePDL, pdColor)
        if showLabels
            pdhLabel := f_newLabel(activePDH, "PDH", pdColor)
            pdlLabel := f_newLabel(activePDL, "PDL", pdColor)

    if showON and not na(overnightHigh) and not na(overnightLow)
        onhLine := f_newLine(overnightStart, overnightHigh, onColor)
        onlLine := f_newLine(overnightStart, overnightLow, onColor)
        if showLabels
            onhLabel := f_newLabel(overnightHigh, "ONH", onColor)
            onlLabel := f_newLabel(overnightLow, "ONL", onColor)

// ASIA — START AT 8:00 PM ET
if newAsia and showAsia and not na(asiaHigh) and not na(asiaLow)
    asiaHighLine := f_newLine(asiaStart, asiaHigh, asiaColor)
    asiaLowLine := f_newLine(asiaStart, asiaLow, asiaColor)
    if showLabels
        asiaHighLabel := f_newLabel(asiaHigh, "ASIA H", asiaColor)
        asiaLowLabel := f_newLabel(asiaLow, "ASIA L", asiaColor)

// LONDON — START AT 3:00 AM ET
if newLondon and showLondon and not na(londonHigh) and not na(londonLow)
    londonHighLine := f_newLine(londonStart, londonHigh, londonColor)
    londonLowLine := f_newLine(londonStart, londonLow, londonColor)
    if showLabels
        londonHighLabel := f_newLabel(londonHigh, "LONDON H", londonColor)
        londonLowLabel := f_newLabel(londonLow, "LONDON L", londonColor)

// KEEP ALL ACTIVE LINES AND LABELS ATTACHED TO THE LATEST CANDLE
f_updateLine(pdhLine, activePDH)
f_updateLine(pdlLine, activePDL)
f_updateLine(onhLine, overnightHigh)
f_updateLine(onlLine, overnightLow)
f_updateLine(asiaHighLine, asiaHigh)
f_updateLine(asiaLowLine, asiaLow)
f_updateLine(londonHighLine, londonHigh)
f_updateLine(londonLowLine, londonLow)

f_updateLabel(pdhLabel, activePDH, "PDH", pdColor)
f_updateLabel(pdlLabel, activePDL, "PDL", pdColor)
f_updateLabel(onhLabel, overnightHigh, "ONH", onColor)
f_updateLabel(onlLabel, overnightLow, "ONL", onColor)
f_updateLabel(asiaHighLabel, asiaHigh, "ASIA H", asiaColor)
f_updateLabel(asiaLowLabel, asiaLow, "ASIA L", asiaColor)
f_updateLabel(londonHighLabel, londonHigh, "LONDON H", londonColor)
f_updateLabel(londonLowLabel, londonLow, "LONDON L", londonColor)

// AUTOMATIC INTRADAY CLEANUP
// The < 1800 condition protects the new session lines created at 6:00 PM.
int nyTime = hour(time, TZ) * 100 + minute(time, TZ)
bool hideAsiaNow = hideAsiaAfter1100 and nyTime >= 1100 and nyTime < 1800
bool hideLondonNow = hideLondonAfter1200 and nyTime >= 1200 and nyTime < 1800
bool hideONNow = hideONAfter1600 and nyTime >= 1600 and nyTime < 1800

if hideAsiaNow
    f_deleteLine(asiaHighLine)
    f_deleteLine(asiaLowLine)
    f_deleteLabel(asiaHighLabel)
    f_deleteLabel(asiaLowLabel)
    asiaHighLine := na
    asiaLowLine := na
    asiaHighLabel := na
    asiaLowLabel := na

if hideLondonNow
    f_deleteLine(londonHighLine)
    f_deleteLine(londonLowLine)
    f_deleteLabel(londonHighLabel)
    f_deleteLabel(londonLowLabel)
    londonHighLine := na
    londonLowLine := na
    londonHighLabel := na
    londonLowLabel := na

if hideONNow
    f_deleteLine(onhLine)
    f_deleteLine(onlLine)
    f_deleteLabel(onhLabel)
    f_deleteLabel(onlLabel)
    onhLine := na
    onlLine := na
    onhLabel := na
    onlLabel := na
