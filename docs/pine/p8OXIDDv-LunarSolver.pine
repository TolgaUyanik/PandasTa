//Implements analytical approximations from Éphéméride Lunaire Parisienne (ELP2000-82B) lunar theory (Chapront-Touzé & Chapront).
//Uses truncated Fourier series of the main problem in Delaunay arguments D, l, l', F.
//Accuracy (truncated-limited)
//Distance: typically ± few 100 km
//Syzygy times: typically ± few minutes

//@version=6
library("LunarSolver", overlay = true)


// Time Helpers
export delta_t(int t_ms) =>
    float y = year(t_ms) + (month(t_ms) - 0.5) / 12.0
    float t = (y - 2000) / 100.0
    float result = na
    if y < 1950
        result := 25.0 + 30.0 * math.pow(t, 2)
    else if y < 2050
        result := 62.92 + 32.217 * t + 0.2711 * math.pow(t, 2) + 0.000015 * t * math.pow(t, 2)
    else
        result := 62.92 + 32.217 * t + 0.2711 * math.pow(t, 2) + 0.000015 * t * math.pow(t, 2)
    result

export julian_day_tt(int t_ms) =>
    float jd_utc = t_ms / 86400000.0 + 2440587.5
    jd_utc + delta_t(t_ms) / 86400.0

export jde_tt_to_utc_ms(float jde_tt) =>
    float rough_ms = (jde_tt - 2440587.5) * 86400000.0
    int rough_int = int(math.round(rough_ms))
    float dt_seconds = delta_t(rough_int)
    int(math.round(rough_ms - dt_seconds * 1000))


// Distance Solver (50-term)
export elp_true_distance_km_50(float jd_tt) =>
    float T = (jd_tt - 2451545.0) / 36525.0
    float T2 = T * T
    float T3 = T2 * T
    float T4 = T3 * T
    
    float D  = 297.8501921 + 445267.1114034 * T - 0.00000000013 * T2
    float F  =  93.2720950 + 483202.0175233 * T - 0.0000000003  * T2
    float l  = 357.5291092 + 35999.0502909 * T   - 0.0000000003 * T2
    float lp = 134.9634 + 477198.8676 * T + 0.0087414 * T2 + 0.0000019 * T3
    
    float Dr  = math.toradians(D)
    float Fr  = math.toradians(F)
    float lr  = math.toradians(l)
    float lpr = math.toradians(lp)
    
    float r = 385000.5289868033
    
    r += -20905.35504324328 * math.cos(lpr) // [0,0,1,0]
    r += -3699.1109192098975 * math.cos(2*Dr - lpr) // [2,0,-1,0]
    r += -2955.9675637102655 * math.cos(2*Dr) // [2,0,0,0]
    r += -569.9251213522874 * math.cos(2*lpr) // [0,0,2,0]
    r += 246.15847755240628 * math.cos(2*Dr - 2*lpr) // [2,0,-2,0]
    r += -204.58598380513953 * math.cos(lpr - lr) // [0,-1,1,0]
    r += -170.73307846037957 * math.cos(2*Dr + lpr) // [2,0,1,0]
    r += -152.1377114862193 * math.cos(2*Dr - lr - lpr) // [2,-1,-1,0]
    r += -129.62013867850587 * math.cos(lr - Dr) // [-1,1,0,0]
    r += 108.74270168839186 * math.cos(Dr) // [1,0,0,0]
    r += 104.75522518593684 * math.cos(Dr + lr + lpr) // [1,1,1,0]
    r += 79.66055615283707 * math.cos(lpr - 2*Fr) // [0,0,1,-2]
    r += 48.88829640301958 * math.cos(lr) // [0,1,0,0]
    r += -34.78252367148676 * math.cos(4*Dr - lpr) // [4,0,-1,0]
    r += 30.82383967858488 * math.cos(2*Dr + lr + lpr) // [2,1,1,0]
    r += 24.208482539702214 * math.cos(2*Dr + lr - lpr) // [2,1,-1,0]
    r += -23.2104301949711 * math.cos(3*lpr) // [0,0,3,0]
    r += -21.63634372538151 * math.cos(4*Dr - 2*lpr) // [4,0,-2,0]
    r += -16.674712956766612 * math.cos(Dr + 2*lr) // [1,2,0,0]
    r += 14.402688794598129 * math.cos(2*Dr - 3*lpr) // [2,0,-3,0]
    r += -12.831395086065443 * math.cos(2*Dr - lr + lpr) // [2,-1,1,0]
    r += -11.64994782787713 * math.cos(4*Dr) // [4,0,0,0]
    r += -10.444757711497783 * math.cos(2*Dr + 2*lpr) // [2,0,2,0]
    r += 10.321105570221611 * math.cos(2*Dr - 2*Fr) // [2,0,0,-2]
    r += 10.056196651111373 * math.cos(2*Dr - lr - 2*lpr) // [2,-1,-2,0]
    r += -9.884453786454122 * math.cos(2*Dr - 2*lr) // [2,-2,0,0]
    r += 8.751561179755182 * math.cos(2*Dr - lpr - 2*Fr) // [2,0,-1,-2]
    r += -8.379106718921369 * math.cos(Dr - lr) // [1,-1,0,0]
    r += -7.002691409591132 * math.cos(lr - 2*Fr) // [0,1,0,-2]
    r += 6.322003215271084 * math.cos(Dr + lr) // [1,1,0,0]
    r += 5.750854030679853 * math.cos(lr + 2*lpr) // [0,1,2,0]
    r += -4.950128396307023 * math.cos(2*Dr - 2*lr - lpr) // [2,-2,-1,0]
    r += -4.421176345788108 * math.cos(2*lpr - 2*Fr) // [0,0,2,-2]
    r += 4.13111390952 * math.cos(4*Dr - lr - lpr) // [4,-1,-1,0]
    r += 3.99767 * math.cos(2*lpr + 2*Fr) // [0,0,2,2]
    r += 3.20968 * math.cos(3*Dr - lpr) // [3,0,-1,0]
    r += 2.91464 * math.cos(2*Dr + lr + lpr) // [2,1,1,0]
    r += -2.73198 * math.cos(4*Dr - lr - 2*lpr) // [4,-1,-2,0]
    r += 2.56813 * math.cos(2*lr - lpr) // [0,2,-1,0]
    r += 2.52138 * math.cos(2*Dr + 2*lr - lpr) // [2,2,-1,0]
    r += -2.48897 * math.cos(2*Dr + lr - 2*lpr) // [2,1,-2,0]
    r += -2.14619 * math.cos(2*Dr - lr - 2*Fr) // [2,-1,0,-2]
    r += -1.97772 * math.cos(4*Dr + lpr) // [4,0,1,0]
    r += -1.93367 * math.cos(4*lpr) // [0,0,4,0]
    r += -1.87083 * math.cos(4*Dr - lr) // [4,-1,0,0]
    r += 1.75296 * math.cos(Dr - 2*lpr) // [1,0,-2,0]
    r += 1.43724 * math.cos(2*Dr + lr - 2*Fr) // [2,1,0,-2]
    r += 1.42919 * math.cos(2*Dr - 2*lpr + 2*Fr) // [2,0,-2,2]
    r += -1.35751 * math.cos(2*Dr + 2*lr) // [2,2,0,0]
    r += -1.33532 * math.cos(4*Dr - 3*lpr) // [4,0,-3,0]
    r += -1.31284 * math.cos(4*Dr + lr - lpr) // [4,1,-1,0]
    
    r


// New Moon Solver (50-term)
export elp_new_moon_solver_50(float k) =>
    float jde = 2451550.25977 + 29.530588861 * k
    float tol = 0.005
    int max_iter = 50
    
    for i = 0 to max_iter - 1
        float T = (jde - 2451545.0) / 36525.0
        float T2 = T * T
        float T3 = T2 * T
        float T4 = T3 * T
        
        float D  = 297.8501921 + 445267.1114034 * T - 0.00000000013 * T2
        float F  =  93.2720950 + 483202.0175233 * T - 0.0000000003  * T2
        float L  = 218.3164477 + 481267.88123421 * T - 0.0000000002 * T2
        float l  = 357.5291092 + 35999.0502909 * T   - 0.0000000003 * T2
        float lp = 134.9634 + 477198.8676 * T + 0.0087414 * T2 + 0.0000019 * T3
        
        float Dr  = math.toradians(D)
        float Fr  = math.toradians(F)
        float Lr  = math.toradians(L)
        float lr  = math.toradians(l)
        float lpr = math.toradians(lp)
        
        float sum_arcsec = 0.0
        
        sum_arcsec += 22639.55 * math.sin(lpr) // [0,0,1,0]
        sum_arcsec += 4586.43061 * math.sin(2*Dr - lpr) // [2,0,-1,0]
        sum_arcsec += 2369.91227 * math.sin(2*Dr) // [2,0,0,0]
        sum_arcsec += 769.02326 * math.sin(2*lpr) // [0,0,2,0]
        sum_arcsec += -666.44186 * math.sin(Dr + lr) // [0,1,0,0]
        sum_arcsec += -411.60287 * math.sin(2*Fr) // [0,0,0,2]
        sum_arcsec += 211.65487 * math.sin(2*Dr - 2*lpr) // [2,0,-2,0]
        sum_arcsec += 205.44315 * math.sin(2*Dr - lr - lpr) // [2,-1,-1,0]
        sum_arcsec += 191.95575 * math.sin(2*Dr + lpr) // [2,0,1,0]
        sum_arcsec += 164.73458 * math.sin(2*Dr - lr) // [2,-1,0,0]
        sum_arcsec += -147.32654 * math.sin(Dr + lr - lpr) // [0,1,-1,0]
        sum_arcsec += -124.98806 * math.sin(Dr) // [1,0,0,0]
        sum_arcsec += -109.38419 * math.sin(Dr + lr + lpr) // [0,1,1,0]
        sum_arcsec += 55.17801 * math.sin(2*Dr - 2*Fr) // [2,0,0,-2]
        sum_arcsec += -45.10032 * math.sin(lpr + 2*Fr) // [0,0,1,2]
        sum_arcsec += 39.53393 * math.sin(lpr - 2*Fr) // [0,0,1,-2]
        sum_arcsec += 38.42974 * math.sin(4*Dr - lpr) // [4,0,-1,0]
        sum_arcsec += 36.12364 * math.sin(3*lpr) // [0,0,3,0]
        sum_arcsec += 30.77247 * math.sin(4*Dr - 2*lpr) // [4,0,-2,0]
        sum_arcsec += -28.3981 * math.sin(2*Dr + lr - lpr) // [2,1,-1,0]
        sum_arcsec += -24.3591 * math.sin(2*Dr + lr) // [2,1,0,0]
        sum_arcsec += -18.58467 * math.sin(Dr - lpr) // [1,0,-1,0]
        sum_arcsec += 17.95512 * math.sin(Dr + 2*lr) // [1,1,0,0]
        sum_arcsec += 14.53078 * math.sin(2*Dr - lr + lpr) // [2,-1,1,0]
        sum_arcsec += 14.37964 * math.sin(2*Dr + 2*lpr) // [2,0,2,0]
        sum_arcsec += 13.89903 * math.sin(4*Dr) // [4,0,0,0]
        sum_arcsec += 13.194 * math.sin(2*Dr - 3*lpr) // [2,0,-3,0]
        sum_arcsec += -9.67938 * math.sin(Dr + lr - 2*lpr) // [0,1,-2,0]
        sum_arcsec += -9.36601 * math.sin(2*Dr - lpr + 2*Fr) // [2,0,-1,2]
        sum_arcsec += 8.60582 * math.sin(2*Dr - lr - 2*lpr) // [2,-1,-2,0]
        sum_arcsec += -8.45308 * math.sin(Dr + lpr) // [1,0,1,0]
        sum_arcsec += 8.05076 * math.sin(2*Dr - 2*lr) // [2,-2,0,0]
        sum_arcsec += -7.63041 * math.sin(Dr + lr + 2*lpr) // [0,1,2,0]
        sum_arcsec += -7.44804 * math.sin(2*lr) // [0,2,0,0]
        sum_arcsec += 7.37173 * math.sin(2*Dr - 2*lr - lpr) // [2,-2,-1,0]
        sum_arcsec += -6.38325 * math.sin(2*Dr + lpr - 2*Fr) // [2,0,1,-2]
        sum_arcsec += -5.7417 * math.sin(2*Dr + 2*Fr) // [2,0,0,2]
        sum_arcsec += 4.37416 * math.sin(4*Dr - lr - lpr) // [4,-1,-1,0]
        sum_arcsec += -3.99767 * math.sin(2*lpr + 2*Fr) // [0,0,2,2]
        sum_arcsec += -3.20968 * math.sin(3*Dr - lpr) // [3,0,-1,0]
        sum_arcsec += -2.91464 * math.sin(2*Dr + lr + lpr) // [2,1,1,0]
        sum_arcsec += 2.73198 * math.sin(4*Dr - lr - 2*lpr) // [4,-1,-2,0]
        sum_arcsec += -2.56813 * math.sin(2*lr - lpr) // [0,2,-1,0]
        sum_arcsec += -2.52138 * math.sin(2*Dr + 2*lr - lpr) // [2,2,-1,0]
        sum_arcsec += 2.48897 * math.sin(2*Dr + lr - 2*lpr) // [2,1,-2,0]
        sum_arcsec += 2.14619 * math.sin(2*Dr - lr - 2*Fr) // [2,-1,0,-2]
        sum_arcsec += 1.97772 * math.sin(4*Dr + lpr) // [4,0,1,0]
        sum_arcsec += 1.93367 * math.sin(4*lpr) // [0,0,4,0]
        sum_arcsec += 1.87083 * math.sin(4*Dr - lr) // [4,-1,0,0]
        sum_arcsec += -1.75296 * math.sin(Dr - 2*lpr) // [1,0,-2,0]
        sum_arcsec += -1.43724 * math.sin(2*Dr + lr - 2*Fr) // [2,1,0,-2]

        float moon_long_deg = L + sum_arcsec / 3600.0
        float moon_long_rad = math.toradians(moon_long_deg)
        
        float sun_long = 280.459 + 36000.7698 * T + 0.0000000003 * T2
        sun_long += 1.914 * math.sin(lr) + 0.020 * math.sin(2 * lr)
        float sun_long_rad = math.toradians(sun_long)
        
        float elongation = moon_long_rad - sun_long_rad
        elongation := elongation % (2 * math.pi)
        if elongation > math.pi
            elongation -= 2 * math.pi
        if elongation < -math.pi
            elongation += 2 * math.pi
        
        float d_jde = elongation / (0.230517 + 0.000000013 * T)
        jde -= d_jde
        
        if math.abs(elongation) < tol
            break
    
    jde


// Full Moon Solver (50-term)
export elp_full_moon_solver_50(float k) =>
    float synodic_period = 29.530588861
    float rate = 2 * math.pi / synodic_period
    float jde = 2451550.25977 + synodic_period * k + 14.7652944305
    float tol = 0.001
    int max_iter = 50
    
    for i = 0 to max_iter - 1
        float T = (jde - 2451545.0) / 36525.0
        float T2 = T * T
        float T3 = T2 * T
        float T4 = T3 * T
        
        float D  = 297.8501921 + 445267.1114034 * T - 0.00000000013 * T2
        float F  =  93.2720950 + 483202.0175233 * T - 0.0000000003  * T2
        float L  = 218.3164477 + 481267.88123421 * T - 0.0000000002 * T2
        float l  = 357.5291092 + 35999.0502909 * T   - 0.0000000003 * T2
        float lp = 134.9634 + 477198.8676 * T + 0.0087414 * T2 + 0.0000019 * T3
        
        float Dr  = math.toradians(D)
        float Fr  = math.toradians(F)
        float Lr  = math.toradians(L)
        float lr  = math.toradians(l)
        float lpr = math.toradians(lp)
        
        float sum_arcsec = 0.0
        
        sum_arcsec += 22639.55 * math.sin(lpr)
        sum_arcsec += 4586.43061 * math.sin(2*Dr - lpr)
        sum_arcsec += 2369.91227 * math.sin(2*Dr)
        sum_arcsec += 769.02326 * math.sin(2*lpr)
        sum_arcsec += -666.44186 * math.sin(lr)
        sum_arcsec += -411.60287 * math.sin(2*Fr)
        sum_arcsec += 211.65487 * math.sin(2*Dr - 2*lpr)
        sum_arcsec += 205.44315 * math.sin(2*Dr - lr - lpr)
        sum_arcsec += 191.95575 * math.sin(2*Dr + lpr)
        sum_arcsec += 164.73458 * math.sin(2*Dr - lr)
        sum_arcsec += -147.32654 * math.sin(lr - lpr)
        sum_arcsec += -124.98806 * math.sin(Dr)
        sum_arcsec += -109.38419 * math.sin(lr + lpr)
        sum_arcsec += 55.17801 * math.sin(2*Dr - 2*Fr)
        sum_arcsec += -45.10032 * math.sin(lpr + 2*Fr)
        sum_arcsec += 39.53393 * math.sin(lpr - 2*Fr)
        sum_arcsec += 38.42974 * math.sin(4*Dr - lpr)
        sum_arcsec += 36.12364 * math.sin(3*lpr)
        sum_arcsec += 30.77247 * math.sin(4*Dr - 2*lpr)
        sum_arcsec += -28.3981 * math.sin(2*Dr + lr - lpr)
        sum_arcsec += -24.3591 * math.sin(2*Dr + lr)
        sum_arcsec += -18.58467 * math.sin(Dr - lpr)
        sum_arcsec += 17.95512 * math.sin(Dr + 2*lr)
        sum_arcsec += 14.53078 * math.sin(2*Dr - lr + lpr)
        sum_arcsec += 14.37964 * math.sin(2*Dr + 2*lpr)
        sum_arcsec += 13.89903 * math.sin(4*Dr)
        sum_arcsec += 13.194 * math.sin(2*Dr - 3*lpr)
        sum_arcsec += -9.67938 * math.sin(lr - 2*lpr)
        sum_arcsec += -9.36601 * math.sin(2*Dr - lpr + 2*Fr)
        sum_arcsec += 8.60582 * math.sin(2*Dr - lr - 2*lpr)
        sum_arcsec += -8.45308 * math.sin(Dr + lpr)
        sum_arcsec += 8.05076 * math.sin(2*Dr - 2*lr)
        sum_arcsec += -7.63041 * math.sin(lr + 2*lpr)
        sum_arcsec += -7.44804 * math.sin(2*lr)
        sum_arcsec += 7.37173 * math.sin(2*Dr - 2*lr - lpr)
        sum_arcsec += -6.38325 * math.sin(2*Dr + lpr - 2*Fr)
        sum_arcsec += -5.7417 * math.sin(2*Dr + 2*Fr)
        sum_arcsec += 4.37416 * math.sin(4*Dr - lr - lpr)
        sum_arcsec += -3.99767 * math.sin(2*lpr + 2*Fr)
        sum_arcsec += -3.20968 * math.sin(3*Dr - lpr)
        sum_arcsec += -2.91464 * math.sin(2*Dr + lr + lpr)
        sum_arcsec += 2.73198 * math.sin(4*Dr - lr - 2*lpr)
        sum_arcsec += -2.56813 * math.sin(2*lr - lpr)
        sum_arcsec += -2.52138 * math.sin(2*Dr + 2*lr - lpr)
        sum_arcsec += 2.48897 * math.sin(2*Dr + lr - 2*lpr)
        sum_arcsec += 2.14619 * math.sin(2*Dr - lr - 2*Fr)
        sum_arcsec += 1.97772 * math.sin(4*Dr + lpr)
        sum_arcsec += 1.93367 * math.sin(4*lpr)
        sum_arcsec += 1.87083 * math.sin(4*Dr - lr)
        sum_arcsec += -1.75296 * math.sin(Dr - 2*lpr)
        sum_arcsec += -1.43724 * math.sin(2*Dr + lr - 2*Fr)
        
        float moon_long_deg = L + sum_arcsec / 3600.0
        float moon_long_rad = math.toradians(moon_long_deg)
        
        float sun_mean_long = 280.46646 + 36000.76983 * T + 0.0003032 * T2
        sun_mean_long := sun_mean_long % 360.0
        if sun_mean_long < 0
            sun_mean_long += 360.0
        float M_sun_deg = 357.52911 + 35999.05029 * T - 0.0001537 * T2
        M_sun_deg := M_sun_deg % 360.0
        if M_sun_deg < 0
            M_sun_deg += 360.0
        float M_sun_rad = math.toradians(M_sun_deg)
        float C = (1.914602 - 0.004817 * T - 0.000014 * T2) * math.sin(M_sun_rad)
        C += (0.019993 - 0.000101 * T) * math.sin(2 * M_sun_rad)
        C += 0.000289 * math.sin(3 * M_sun_rad)
        float sun_true_long = sun_mean_long + C
        float Omega_deg = 125.04452 - 1934.136261 * T + 0.0020708 * T2
        float Omega_rad = math.toradians(Omega_deg)
        float nutation_deg = -0.00569 - 0.00478 * math.sin(Omega_rad)
        float sun_apparent_long = sun_true_long + nutation_deg
        sun_apparent_long := sun_apparent_long % 360.0
        if sun_apparent_long < 0
            sun_apparent_long += 360.0
        float sun_long_rad = math.toradians(sun_apparent_long)
        
        float elongation = moon_long_rad - sun_long_rad
        elongation := elongation % (2 * math.pi)
        if elongation < 0
            elongation += 2 * math.pi
        
        float diff = elongation - math.pi
        
        if math.abs(diff) < tol
            break
        
        float d_jde = diff / rate
        float damper = 0.95
        jde -= damper * d_jde
    
    jde
