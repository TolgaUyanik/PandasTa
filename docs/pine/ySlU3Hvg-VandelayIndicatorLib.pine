//@version=5

// @description Art Vandelay's Indicator library
library("VandelayIndicatorLib", false)
plot(na)

// @function Schaff Trend Cycle Calculations
// @param  EEEEEE = Slengt, BBBB = FALenght, BBBBB = SLOLenght
// @returns Long : mAAAAA > mAAAAA[1] - Short : mAAAAA < mAAAAA[1]
export STC_VIL(int EEEEEE, int BBBB, int BBBBB, float AAA) =>
    var CCCCC = 0.0
    var DDD = 0.0
    var DDDDDD = 0.0
    var EEEEE = 0.0
    BBBBBB = ta.ema(close, BBBB) - ta.ema(close, BBBBB)
    CCC = ta.lowest(BBBBBB, EEEEEE)
    CCCC = ta.highest(BBBBBB, EEEEEE) - CCC
    CCCCC := CCCC > 0 ? (BBBBBB - CCC) / CCCC * 100 : nz(CCCCC[1])
    DDD := na(DDD[1]) ? CCCCC : DDD[1] + AAA * (CCCCC - DDD[1])
    DDDD = ta.lowest(DDD, EEEEEE)
    DDDDD = ta.highest(DDD, EEEEEE) - DDDD
    DDDDDD := DDDDD > 0 ? (DDD - DDDD) / DDDDD * 100 : nz(DDDDDD[1])
    EEEEE := na(EEEEE[1]) ? DDDDDD : EEEEE[1] + AAA * (DDDDDD - EEEEE[1])
    EEEEE
