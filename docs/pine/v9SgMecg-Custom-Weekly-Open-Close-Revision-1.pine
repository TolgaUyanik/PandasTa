//@version=6
indicator(title = 'Custom Weekly Open Close', shorttitle = 'Custom Weekly O/C', overlay = true)

tz = input.string('America/New_York', 'Time Zone', options = ['exchange', 'America/New_York', 'Etc/UTC', 'Europe/London'], tooltip = 'All selected times are interpreted in this time zone.')

info = input.bool(true, 'ⓘ Timing Note', tooltip = 'TradingView bars use two different time references:\n\n• Opens use bar START time.\n• Closes use bar END time.\n\nExample on a 5-minute chart:\n• 9:30 open = bar starting at 9:30\n• 4:00 close = 3:55–4:00 bar')

showWeeklyOpen = input.bool(true, 'Show Weekly Open')
showWeeklyClose = input.bool(true, 'Show Weekly Close')

openMode = input.string('First Trading Day', 'Weekly Open Mode', options = ['First Trading Day', 'Sunday Futures Open', 'Monday RTH Open', 'Custom Day'], tooltip = 'First Trading Day = first valid weekday that reaches your open time.\nSunday Futures Open = useful for Globex futures.\nMonday RTH Open = Monday regular trading hours open.\nCustom Day = use the selected custom open day.')

closeMode = input.string('Friday Close', 'Weekly Close Mode', options = ['Last Trading Day', 'Friday Close', 'Custom Day'], tooltip = 'Friday Close = normal weekly close.\nLast Trading Day = updates on the latest valid weekday close, useful when Friday is closed.\nCustom Day = use the selected custom close day.')

customOpenDay = input.string('Monday', 'Custom Open Day', options = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'])
customCloseDay = input.string('Friday', 'Custom Close Day', options = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'])

openHour = input.int(9, 'Open Hour', minval = 0, maxval = 23, tooltip = 'Open uses bar START time.\nExample on a 5-minute chart: 9:30 = the bar that begins at 9:30.')
openMinute = input.int(30, 'Open Minute', minval = 0, maxval = 59, tooltip = 'Open uses bar START time.')

closeHour = input.int(16, 'Close Hour', minval = 0, maxval = 23, tooltip = 'Close uses bar END time.\nExample on a 5-minute chart: 16:00 = the 15:55–16:00 bar.')
closeMinute = input.int(0, 'Close Minute', minval = 0, maxval = 59, tooltip = 'Close uses bar END time.')

openColor = input.color(color.rgb(46, 160, 67), 'Weekly Open Color')
closeColor = input.color(color.rgb(220, 80, 80), 'Weekly Close Color')

lineWidth = input.int(2, 'Line Width', minval = 1, maxval = 5)
showLabels = input.bool(true, 'Show Labels')

dayFromString(dayName) =>
    switch dayName
        'Sunday' => dayofweek.sunday
        'Monday' => dayofweek.monday
        'Tuesday' => dayofweek.tuesday
        'Wednesday' => dayofweek.wednesday
        'Thursday' => dayofweek.thursday
        'Friday' => dayofweek.friday

barDay = dayofweek(time, tz)
closeBarDay = dayofweek(time_close, tz)

isWeekday = barDay == dayofweek.monday or barDay == dayofweek.tuesday or barDay == dayofweek.wednesday or barDay == dayofweek.thursday or barDay == dayofweek.friday
isCloseWeekday = closeBarDay == dayofweek.monday or closeBarDay == dayofweek.tuesday or closeBarDay == dayofweek.wednesday or closeBarDay == dayofweek.thursday or closeBarDay == dayofweek.friday

isNewWeek = bool(ta.change(weekofyear(time, tz))) or bool(ta.change(year(time, tz)))

openTargetTime = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), openHour, openMinute)
closeTargetTime = timestamp(tz, year(time_close, tz), month(time_close, tz), dayofmonth(time_close, tz), closeHour, closeMinute)

crossesOpenTime = time >= openTargetTime and nz(time[1], 0) < openTargetTime
crossesCloseTime = time_close >= closeTargetTime and nz(time_close[1], 0) < closeTargetTime

var bool weeklyOpenCaptured = false
var float weeklyOpenPrice = na
var float weeklyClosePrice = na

var label weeklyOpenLabel = na
var label weeklyCloseLabel = na

if isNewWeek
    weeklyOpenCaptured := false
    weeklyOpenPrice := na
    weeklyOpenPrice

openDayAllowed = openMode == 'First Trading Day' ? isWeekday : openMode == 'Sunday Futures Open' ? barDay == dayofweek.sunday : openMode == 'Monday RTH Open' ? barDay == dayofweek.monday : barDay == dayFromString(customOpenDay)

isWeeklyOpenBar = showWeeklyOpen and not weeklyOpenCaptured and openDayAllowed and crossesOpenTime

if isWeeklyOpenBar
    weeklyOpenPrice := open
    weeklyOpenCaptured := true
    if showLabels
        label.delete(weeklyOpenLabel)
        weeklyOpenLabel := label.new(bar_index, weeklyOpenPrice, 'Weekly Open: ' + str.tostring(weeklyOpenPrice, '#.##'), style = label.style_label_right, color = openColor, textcolor = color.white, xloc = xloc.bar_index, yloc = yloc.price)
        weeklyOpenLabel

closeDayAllowed = closeMode == 'Last Trading Day' ? isCloseWeekday : closeMode == 'Friday Close' ? closeBarDay == dayofweek.friday : closeBarDay == dayFromString(customCloseDay)

isWeeklyCloseBar = showWeeklyClose and closeDayAllowed and crossesCloseTime

if isWeeklyCloseBar
    weeklyClosePrice := close
    if showLabels
        label.delete(weeklyCloseLabel)
        weeklyCloseLabel := label.new(bar_index, weeklyClosePrice, 'Weekly Close: ' + str.tostring(weeklyClosePrice, '#.##'), style = label.style_label_right, color = closeColor, textcolor = color.white, xloc = xloc.bar_index, yloc = yloc.price)
        weeklyCloseLabel

plot(showWeeklyOpen ? weeklyOpenPrice : na, title = 'Weekly Open', color = openColor, linewidth = math.max(1, lineWidth), style = plot.style_cross)
plot(showWeeklyClose ? weeklyClosePrice : na, title = 'Weekly Close', color = closeColor, linewidth = math.max(1, lineWidth), style = plot.style_cross)
