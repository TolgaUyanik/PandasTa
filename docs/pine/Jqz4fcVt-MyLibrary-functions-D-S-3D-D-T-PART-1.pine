        array.set(lable_id_ar, 25 , '0')                           
    //1_3
    if Validation_OBV_3 == true and zigzag_Indicator_3_ == true and Scan_zigzag_NO == 'zigzag_Indicator_3'
        array.set(lable_id_ar, 26 , '3')
    else if (Validation_OBV_3 == false or zigzag_Indicator_3_ == false) and Scan_zigzag_NO == 'zigzag_Indicator_3'
        array.set(lable_id_ar, 26 , '0')       
        
            
    //10 
    //1_1 
    if Validation_ADX_1 == true and zigzag_Indicator_1_ == true and Scan_zigzag_NO == 'zigzag_Indicator_1'
        array.set(lable_id_ar, 27 , '1')
