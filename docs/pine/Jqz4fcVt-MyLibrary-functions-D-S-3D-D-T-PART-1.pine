        x_P_SN_hg_9 := x_P_SN_hg_8
        x_P_SN_hg_8 := x_P_SN_hg_7
        x_P_SN_hg_7 := x_P_SN_hg_6
        x_P_SN_hg_6 := x_P_SN_hg_5
        x_P_SN_hg_5 := x_P_SN_hg_4
        x_P_SN_hg_4 := x_P_SN_hg_3
        x_P_SN_hg_3 := x_P_SN_hg_2
        x_P_SN_hg_2 := hg_

    if down == 1 and down_hg_ok

        if down[1] != 1
            x_P_SN_hg_1 := p_hg_
            x_P_SN_hg_1

        else if down[1] == 1
            x_P_SN_hg_1 := higher or not higher and hg_ > lw_ ? p_hg_ : hg_[1] + 1
            x_P_SN_hg_1

    [x_P_SN_hg_1, x_P_SN_hg_2, x_P_SN_hg_3, x_P_SN_hg_4, x_P_SN_hg_5, x_P_SN_hg_6, x_P_SN_hg_7, x_P_SN_hg_8, x_P_SN_hg_9, x_P_SN_hg_10, x_P_SN_hg_11, x_P_SN_hg_12, x_P_SN_hg_13 ,x_P_SN_hg_14 ,x_P_SN_hg_15 ,x_P_SN_hg_16 ,x_P_SN_hg_17 ,x_P_SN_hg_18 ,x_P_SN_hg_19 ,x_P_SN_hg_20 ,x_P_SN_hg_21 ,x_P_SN_hg_22 ,x_P_SN_hg_23 ,x_P_SN_hg_24 ,x_P_SN_hg_25 ,x_P_SN_hg_26 ,x_P_SN_hg_27 ,x_P_SN_hg_28 ,x_P_SN_hg_29 ,x_P_SN_hg_30]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////Update_lw_hg_last_l_last_h
export Update_lw_hg_last_l_last_h(int lw, int hg, int last_l, int last_h, int p_lw, int p_hg, int down, float Source_low, float Source_high) =>
    lw_ = lw
    hg_ = hg
    last_l_ = last_l
    last_h_ = last_h
    p_lw_ = p_lw
    p_hg_ = p_hg

    down_lw_ok = p_lw_ < hg_ and p_lw_ < lw_ ? true : false
    down_hg_ok = p_hg_ < lw_ and p_hg_ < hg_ ? true : false

    bool lower = false
    if lw_ < 300 and p_lw_ < 300
        lower := Source_low[lw_] > Source_low[p_lw_] ? true : false

    bool higher = false
    if hg_ < 300 and p_hg_ < 300
        higher := Source_high[hg_] < Source_high[p_hg_] ? true : false

    if down == 2 and down[1] == 1 and down_lw_ok and lw_ > hg_ or down == 2 and down[1] == 2 and down_lw_ok and hg_[1] < lw_[1] and hg_ < lw_
        last_l_ := lw_

    if down == 1 and down[1] == 2 and down_hg_ok and lw_ < hg_ or down == 1 and down[1] == 1 and down_hg_ok and lw_[1] < hg_[1] and lw_ < hg_
        last_h_ := hg_


    if down == 2 and down_lw_ok
        if down[1] != 2
            lw_ := p_lw_

        else if down[1] == 2
            lw_ := lower or not lower and lw_ > hg_ ? p_lw_ : lw_[1] + 1


    if down == 1 and down_hg_ok

        if down[1] != 1
            hg_ := p_hg_

        else if down[1] == 1
            hg_ := higher or not higher and hg_ > lw_ ? p_hg_ : hg_[1] + 1

    [lw_, hg_, last_l_, last_h_]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////piote price
export x1_P_y1_P_x2_P_y2_P_x3_P_y3_P_x4_P_y4_P(int lw, int hg, int last_l, int last_h, string Source) =>
    Source_ = Source

    Source_low = Source_ == 'Maximum and Minimum' ? low : Source_ == 'open' ? open : Source_ == 'high' ? high : Source_ == 'low' ? low : Source_ == 'close' ? close : Source_ == 'hl2' ? hl2 : Source_ == 'hlc3' ? hlc3 : Source_ == 'ohlc4' ? ohlc4 : na
    Source_high = Source_ == 'Maximum and Minimum' ? high : Source_ == 'open' ? open : Source_ == 'high' ? high : Source_ == 'low' ? low : Source_ == 'close' ? close : Source_ == 'hl2' ? hl2 : Source_ == 'hlc3' ? hlc3 : Source_ == 'ohlc4' ? ohlc4 : na

    x1_P = lw > hg ? hg : lw < hg ? lw : 0
    y1_P = lw > hg ? (hg < 300 ? Source_high[hg] : 0) : lw < hg ? (lw < 300 ? Source_low[lw] : 0) : 0

    x2_P = lw > hg ? lw : lw < hg ? hg : 0
    y2_P = lw > hg ? (lw < 300 ? Source_low[lw] : 0) : lw < hg ? (hg < 300 ? Source_high[hg] : 0) : 0

    x3_P = lw > hg ? last_h : lw < hg ? last_l : 0
    y3_P = lw > hg ? (last_h < 300 ? Source_high[last_h] : 0) : lw < hg ? (last_l < 300 ? Source_low[last_l] : 0) : 0

    x4_P = lw > hg ? last_l : lw < hg ? last_h : 0
    y4_P = lw > hg ? (last_l < 300 ? Source_low[last_l] : 0) : lw < hg ? (last_h < 300 ? Source_high[last_h] : 0) : 0

    [x1_P, y1_P, x2_P, y2_P, x3_P, y3_P, x4_P, y4_P]

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////piote Oscillator
////x1_P_os
export x1_P_os(int lw, int hg , int x2_D ,bool Diverjence_MACD_Line_ ,bool Diverjence_MACD_Histagram_ ,bool Diverjence_RSI_ ,bool Diverjence_Stochastic_ ,bool Diverjence_volume_ ,bool Diverjence_CCI_ ,bool Diverjence_MFI_ ,bool Diverjence_Momentum_ ,bool Diverjence_OBV_ ,bool Diverjence_ADX_ , float MACD , float hist_MACD , float RSI , float volume_ok , float Stochastic_K , float CCI , float MFI , float momentum , float OBV , float adx) =>

    var x1_P_MACD       = -1,x1_P_MACD       += 1
    var x1_P_hist_MACD  = -1,x1_P_hist_MACD  += 1
    var x1_P_RSI        = -1,x1_P_RSI        += 1
    var x1_P_volume     = -1,x1_P_volume     += 1
    var x1_P_Stochastic = -1,x1_P_Stochastic += 1
    var x1_P_CCI        = -1,x1_P_CCI        += 1
    var x1_P_MFI        = -1,x1_P_MFI        += 1
    var x1_P_Momentum   = -1,x1_P_Momentum   += 1
    var x1_P_OBV        = -1,x1_P_OBV        += 1
    var x1_P_ADX        = -1,x1_P_ADX        += 1

    x1_P_MACD       := 0
    x1_P_hist_MACD  := 0
    x1_P_RSI        := 0
    x1_P_volume     := 0
    x1_P_Stochastic := 0
    x1_P_CCI        := 0
    x1_P_MFI        := 0
    x1_P_Momentum   := 0
    x1_P_OBV        := 0
    x1_P_ADX        := 0

    if (x2_D-1) > 0
        for i = 1 to x2_D - 1 by 1
            if i < 300  
                if lw > hg
                    if x1_P_MACD < 300 and Diverjence_MACD_Line_ == true
                        if MACD[i] > MACD[x1_P_MACD] 
                            x1_P_MACD := i
                    if x1_P_hist_MACD < 300 and Diverjence_MACD_Histagram_ == true                          
                        if hist_MACD[i] > hist_MACD[x1_P_hist_MACD]
                            x1_P_hist_MACD := i
                    if x1_P_RSI < 300 and Diverjence_RSI_ == true
                        if RSI[i] > RSI[x1_P_RSI]
                            x1_P_RSI := i 
                    if x1_P_volume < 300 and Diverjence_volume_ == true
                        if volume_ok[i] > volume_ok[x1_P_volume]
                            x1_P_volume := i
                    if x1_P_Stochastic < 300 and Diverjence_Stochastic_ == true
                        if Stochastic_K[i] > Stochastic_K[x1_P_Stochastic]
                            x1_P_Stochastic := i
                    if x1_P_CCI < 300 and Diverjence_CCI_ == true
                        if CCI[i] > CCI[x1_P_CCI]
                            x1_P_CCI := i
                    if x1_P_MFI < 300 and Diverjence_MFI_ == true
                        if MFI[i] > MFI[x1_P_MFI]
                            x1_P_MFI := i
                    if x1_P_Momentum < 300 and Diverjence_Momentum_ == true
                        if momentum[i] > momentum[x1_P_Momentum]
                            x1_P_Momentum := i
                    if x1_P_OBV < 300 and Diverjence_OBV_ == true
                        if OBV[i] > OBV[x1_P_OBV]
                            x1_P_OBV := i
                    if x1_P_ADX < 300 and Diverjence_ADX_ == true
                        if adx[i] > adx[x1_P_ADX]
                            x1_P_ADX := i

                else if lw < hg
                    if x1_P_MACD < 300 and Diverjence_MACD_Line_ == true
                        if MACD[i] < MACD[x1_P_MACD]
                            x1_P_MACD := i
                    if x1_P_hist_MACD < 300 and Diverjence_MACD_Histagram_ == true
                        if hist_MACD[i] < hist_MACD[x1_P_hist_MACD]
                            x1_P_hist_MACD := i
                    if x1_P_RSI < 300 and Diverjence_RSI_ == true
                        if RSI[i] < RSI[x1_P_RSI]
                            x1_P_RSI := i
                    if x1_P_volume < 300 and Diverjence_volume_ == true
                        if volume_ok[i] < volume_ok[x1_P_volume]
                            x1_P_volume := i
                    if x1_P_Stochastic < 300 and Diverjence_Stochastic_ == true
                        if Stochastic_K[i] < Stochastic_K[x1_P_Stochastic]
                            x1_P_Stochastic := i
                    if x1_P_CCI < 300 and Diverjence_CCI_ == true
                        if CCI[i] < CCI[x1_P_CCI]
                            x1_P_CCI := i
                    if x1_P_MFI < 300 and Diverjence_MFI_ == true
                        if MFI[i] < MFI[x1_P_MFI]
                            x1_P_MFI := i
                    if x1_P_Momentum < 300 and Diverjence_Momentum_ == true
                        if momentum[i] < momentum[x1_P_Momentum]
                            x1_P_Momentum := i
                    if x1_P_OBV < 300 and Diverjence_OBV_ == true
                        if OBV[i] < OBV[x1_P_OBV]
                            x1_P_OBV := i
                    if x1_P_ADX < 300 and Diverjence_ADX_ == true
                        if adx[i] < adx[x1_P_ADX]
                            x1_P_ADX := i
    else
        x1_P_MACD       := 0
        x1_P_hist_MACD  := 0
        x1_P_RSI        := 0
        x1_P_volume     := 0
        x1_P_Stochastic := 0
        x1_P_CCI        := 0
        x1_P_MFI        := 0
        x1_P_Momentum   := 0
        x1_P_OBV        := 0
        x1_P_ADX        := 0

    [x1_P_MACD, x1_P_hist_MACD, x1_P_RSI, x1_P_volume, x1_P_Stochastic, x1_P_CCI, x1_P_MFI, x1_P_Momentum, x1_P_OBV, x1_P_ADX]

////x3_P_os
export x3_P_os(int lw, int hg, int x2_D, int x4_D ,bool Diverjence_MACD_Line_ ,bool Diverjence_MACD_Histagram_ ,bool Diverjence_RSI_ ,bool Diverjence_Stochastic_ ,bool Diverjence_volume_ ,bool Diverjence_CCI_ ,bool Diverjence_MFI_ ,bool Diverjence_Momentum_ ,bool Diverjence_OBV_ ,bool Diverjence_ADX_ , float MACD , float hist_MACD , float RSI , float volume_ok , float Stochastic_K , float CCI , float MFI , float momentum , float OBV , float adx) =>
    var x3_P_MACD       = -1,x3_P_MACD       += 1
    var x3_P_hist_MACD  = -1,x3_P_hist_MACD  += 1
    var x3_P_RSI        = -1,x3_P_RSI        += 1
    var x3_P_volume     = -1,x3_P_volume     += 1
    var x3_P_Stochastic = -1,x3_P_Stochastic += 1
    var x3_P_CCI        = -1,x3_P_CCI        += 1
    var x3_P_MFI        = -1,x3_P_MFI        += 1
    var x3_P_Momentum   = -1,x3_P_Momentum   += 1
    var x3_P_OBV        = -1,x3_P_OBV        += 1
    var x3_P_ADX        = -1,x3_P_ADX        += 1

    x3_P_MACD       := x2_D + 1
    x3_P_hist_MACD  := x2_D + 1
    x3_P_RSI        := x2_D + 1
    x3_P_volume     := x2_D + 1
    x3_P_Stochastic := x2_D + 1
    x3_P_CCI        := x2_D + 1
    x3_P_MFI        := x2_D + 1
    x3_P_Momentum   := x2_D + 1
    x3_P_OBV        := x2_D + 1
    x3_P_ADX        := x2_D + 1

    if (x4_D - x2_D) > 1
        for i = x2_D + 1 + 1 to x4_D by 1
            if i < 300  
                if lw > hg
                    if x3_P_MACD < 300 and Diverjence_MACD_Line_ == true
                        if MACD[i] > MACD[x3_P_MACD]
                            x3_P_MACD := i
                    if x3_P_hist_MACD < 300 and Diverjence_MACD_Histagram_ == true
                        if hist_MACD[i] > hist_MACD[x3_P_hist_MACD]
                            x3_P_hist_MACD := i
                    if x3_P_RSI < 300 and Diverjence_RSI_ == true
                        if RSI[i] > RSI[x3_P_RSI]
                            x3_P_RSI := i
                    if x3_P_volume < 300 and Diverjence_volume_ == true
                        if volume_ok[i] > volume_ok[x3_P_volume]
                            x3_P_volume := i
                    if x3_P_Stochastic < 300 and Diverjence_Stochastic_ == true
                        if Stochastic_K[i] > Stochastic_K[x3_P_Stochastic]
                            x3_P_Stochastic := i
                    if x3_P_CCI < 300 and Diverjence_CCI_ == true
                        if CCI[i] > CCI[x3_P_CCI]
                            x3_P_CCI := i
                    if x3_P_MFI < 300 and Diverjence_MFI_ == true
                        if MFI[i] > MFI[x3_P_MFI]
                            x3_P_MFI := i
                    if x3_P_Momentum < 300 and Diverjence_Momentum_ == true
                        if momentum[i] > momentum[x3_P_Momentum]
                            x3_P_Momentum := i
                    if x3_P_OBV < 300 and Diverjence_OBV_ == true
                        if OBV[i] > OBV[x3_P_OBV]
                            x3_P_OBV := i
                    if x3_P_ADX < 300 and Diverjence_ADX_ == true
                        if adx[i] > adx[x3_P_ADX]
                            x3_P_ADX := i

                else if lw < hg
                    if x3_P_MACD < 300 and Diverjence_MACD_Line_ == true
                        if MACD[i] < MACD[x3_P_MACD]
                            x3_P_MACD := i
                    if x3_P_hist_MACD < 300 and Diverjence_MACD_Histagram_ == true
                        if hist_MACD[i] < hist_MACD[x3_P_hist_MACD]
                            x3_P_hist_MACD := i
                    if x3_P_RSI < 300 and Diverjence_RSI_ == true
                        if RSI[i] < RSI[x3_P_RSI]
                            x3_P_RSI := i
                    if x3_P_volume < 300 and Diverjence_volume_ == true
                        if volume_ok[i] < volume_ok[x3_P_volume]
                            x3_P_volume := i
                    if x3_P_Stochastic < 300 and Diverjence_Stochastic_ == true
                        if Stochastic_K[i] < Stochastic_K[x3_P_Stochastic]
                            x3_P_Stochastic := i
                    if x3_P_CCI < 300 and Diverjence_CCI_ == true
                        if CCI[i] < CCI[x3_P_CCI]
                            x3_P_CCI := i
                    if x3_P_MFI < 300 and Diverjence_MFI_ == true
                        if MFI[i] < MFI[x3_P_MFI]
                            x3_P_MFI := i
                    if x3_P_Momentum < 300 and Diverjence_Momentum_ == true
                        if momentum[i] < momentum[x3_P_Momentum]
                            x3_P_Momentum := i
                    if x3_P_OBV < 300 and Diverjence_OBV_ == true
                        if OBV[i] < OBV[x3_P_OBV]
                            x3_P_OBV := i
                    if x3_P_ADX < 300 and Diverjence_ADX_ == true                        
                        if adx[i] < adx[x3_P_ADX]
                            x3_P_ADX := i
    else
        x3_P_MACD       := x2_D 
        x3_P_hist_MACD  := x2_D 
        x3_P_RSI        := x2_D 
        x3_P_volume     := x2_D 
        x3_P_Stochastic := x2_D 
        x3_P_CCI        := x2_D 
        x3_P_MFI        := x2_D 
        x3_P_Momentum   := x2_D 
        x3_P_OBV        := x2_D 
        x3_P_ADX        := x2_D 

    [x3_P_MACD, x3_P_hist_MACD, x3_P_RSI, x3_P_volume, x3_P_Stochastic, x3_P_CCI, x3_P_MFI, x3_P_Momentum, x3_P_OBV, x3_P_ADX]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////Err_test
export Err_test(int lw ,int hg ,int x1 ,float y1 ,int x2 ,float y2 ,float y_d ,int start ,int finish ,float Err_Rate) =>
    Err_ = false
    if lw > hg
        for i= start to finish
            if i < 300
                // x = i
                y_p = ((((y1)-(y2))/((x1)-(x2)))*((i)-(x1)))+(y1) //line price
                if y_d[i] > math.abs((y_p))*(1+Err_Rate) 
                    Err_ := true 
                    break
                else    
                    Err_ := false
                
    if lw < hg
        for i= start to finish
            if i < 300
                // x = i
                y_p = ((((y1)-(y2))/((x1)-(x2)))*((i)-(x1)))+(y1) //line price
                if y_d[i] < math.abs((y_p))*(1-Err_Rate) 
                    Err_ := true 
                    break
                else    
                    Err_ := false

    [Err_]

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////Divergence calculation
export divergence_calculation(bool Feasibility_RD, bool Feasibility_HD, bool Feasibility_ED, int lw, int hg, float Source_low, float Source_high, int x1_P_pr, int x3_P_pr, int x1_P_os, int x3_P_os, int x2_P_pr, int x4_P_pr, float oscillator , bool Fix_Err_Mid_Point_Pr , bool Fix_Err_Mid_Point_Os , float Err_Rate_permissible_Mid_Line_Pr , float Err_Rate_permissible_Mid_Line_Os , int Number_of_price_periods_R_H , float Permissible_deviation_factor_in_Pr_R_H , int Number_of_oscillator_periods_R_H , float Permissible_deviation_factor_in_OS_R_H , int Number_of_price_periods_E , float Permissible_deviation_factor_in_Pr_E , int Number_of_oscillator_periods_E , float Permissible_deviation_factor_in_OS_E) =>
    //divergence MS
    Regular_MS = false
    Hidden_MS = false
    Exaggerated_MS = false

    //divergence MS
    Regular_MN = false
    Hidden_MN = false
    Exaggerated_MN = false

    //Err_Mid_Point         
    //Err_Mid_Point_price
    y_p_  = (lw > hg) ? Source_high : Source_low          
    y2_D_pr_ = x2_P_pr < 300 ? y_p_[x2_P_pr] : 0
    y2_D_pr_line = ((x1_P_pr < 300 ? y_p_[x1_P_pr] : 0) - (x3_P_pr < 300 ? y_p_[x3_P_pr] : 0)) / (x1_P_pr - x3_P_pr) * (x2_P_pr - x1_P_pr) + (x1_P_pr < 300 ? y_p_[x1_P_pr] : 0)
    
    Err_Mid_Point_price = false
    if Fix_Err_Mid_Point_Pr == true
        if lw > hg 
            if y2_D_pr_ > y2_D_pr_line
                Err_Mid_Point_price := true
            else
                Err_Mid_Point_price := false

        else if lw < hg
            if y2_D_pr_ < y2_D_pr_line
                Err_Mid_Point_price := true
            else
                Err_Mid_Point_price := false

    //Err_Mid_Point_Oscillator           
    y2_D_os_ = (x2_P_pr < 300 ? oscillator[x2_P_pr] : 0)
    y2_D_os_line = ((x1_P_os < 300 ? oscillator[x1_P_os] : 0) - (x3_P_os < 300 ? oscillator[x3_P_os] : 0)) / (x1_P_os - x3_P_os) * (x2_P_pr - x1_P_os) + (x1_P_os < 300 ? oscillator[x1_P_os] : 0)
    
    Err_Mid_Point_Oscillator = false
    if Fix_Err_Mid_Point_Os == true
        if lw > hg 
            if y2_D_os_ > y2_D_os_line
                Err_Mid_Point_Oscillator := true
            else
                Err_Mid_Point_Oscillator := false

        else if lw < hg
            if y2_D_os_ < y2_D_os_line
                Err_Mid_Point_Oscillator := true
            else
                Err_Mid_Point_Oscillator := false 

    //Err_Mid_Line
    //Err_Mid_Line_price
    x1_p = x1_P_pr
    y1_p = (lw > hg) ? (x1_P_pr < 300 ? Source_high[x1_P_pr] : 0) : (x1_P_pr < 300 ? Source_low[x1_P_pr] : 0)
    x2_p = x3_P_pr
    y2_p = (lw > hg) ? (x3_P_pr < 300 ? Source_high[x3_P_pr] : 0) : (x3_P_pr < 300 ? Source_low[x3_P_pr] : 0)
    y_p  = (lw > hg) ? Source_high : Source_low

    Err_Mid_Line_price = false
    [Err_Mid_Line_price_] = Err_test(lw ,hg ,x1_p ,y1_p ,x2_p ,y2_p ,y_p ,x1_P_pr+1 ,x3_P_pr-1 ,Err_Rate_permissible_Mid_Line_Pr)
    if Err_Mid_Line_price_ == true
        Err_Mid_Line_price := true
    else
        Err_Mid_Line_price := false

    //Err_Mid_Line_Oscillator
    x1_o = x1_P_os
    y1_o = (x1_P_os < 300 ? oscillator[x1_P_os] : 0) 
    x2_o = x3_P_os
    y2_o = (x3_P_os < 300 ? oscillator[x3_P_os] : 0) 
    y_o  = oscillator

    Err_Mid_Line_Oscillator = false
    [Err_Mid_Line_Oscillator_] = Err_test(lw ,hg ,x1_o ,y1_o ,x2_o ,y2_o ,y_o ,x1_P_os+1 ,x3_P_os-1 ,Err_Rate_permissible_Mid_Line_Os)
    if Err_Mid_Line_Oscillator_ == true
        Err_Mid_Line_Oscillator := true
    else    
        Err_Mid_Line_Oscillator := false

    //Err_Deviation Regular_Hiden
    Deviation_Price_Regular_Hiden_Authorized = ta.sma(math.abs(open - close), Number_of_price_periods_R_H) * Permissible_deviation_factor_in_Pr_R_H
    Deviation_oscillator_Regular_Hiden_Authorized = math.abs(ta.sma(oscillator, Number_of_oscillator_periods_R_H)) * Permissible_deviation_factor_in_OS_R_H

    //Err_Deviation Exaggerated
    Deviation_Price_Exaggerated_Authorized = ta.sma(math.abs(open - close), Number_of_price_periods_E) * Permissible_deviation_factor_in_Pr_E
    Deviation_oscillator_Exaggerated_Authorized = math.abs(ta.sma(oscillator, Number_of_oscillator_periods_E)) * Permissible_deviation_factor_in_OS_E

    if (hg > lw) and (x3_P_pr != x4_P_pr) //MS
        if Feasibility_RD == true and ( (x1_P_pr < 300) and (x3_P_pr < 300) and (x1_P_os < 300) and (x3_P_os < 300) )
            Regular_MS := Source_low[x3_P_pr] > Source_low[x1_P_pr] and (math.abs(Source_low[x3_P_pr] - Source_low[x1_P_pr]) > Deviation_Price_Regular_Hiden_Authorized) and oscillator[x1_P_os] > oscillator[x3_P_os] and (math.abs(oscillator[x1_P_os] - oscillator[x3_P_os]) > Deviation_oscillator_Regular_Hiden_Authorized) and Err_Mid_Point_price == false and Err_Mid_Point_Oscillator == false and Err_Mid_Line_price == false and Err_Mid_Line_Oscillator == false ? true : false

        if Feasibility_HD == true and ( (x1_P_pr < 300) and (x3_P_pr < 300) and (x1_P_os < 300) and (x3_P_os < 300) )
            Hidden_MS := Source_low[x1_P_pr] > Source_low[x3_P_pr] and (math.abs(Source_low[x1_P_pr] - Source_low[x3_P_pr]) > Deviation_Price_Regular_Hiden_Authorized) and oscillator[x3_P_os] > oscillator[x1_P_os] and (math.abs(oscillator[x3_P_os] - oscillator[x1_P_os]) > Deviation_oscillator_Regular_Hiden_Authorized) and Err_Mid_Point_price == false and Err_Mid_Point_Oscillator == false and Err_Mid_Line_price == false and Err_Mid_Line_Oscillator == false ? true : false

        if Feasibility_ED == true and ( (x1_P_pr < 300) and (x3_P_pr < 300) and (x1_P_os < 300) and (x3_P_os < 300) )
            Exaggerated_MS := Source_low[x3_P_pr] <= Source_low[x1_P_pr] and (math.abs(Source_low[x1_P_pr] - Source_low[x3_P_pr]) <= Deviation_Price_Exaggerated_Authorized) and oscillator[x1_P_os] > oscillator[x3_P_os] and (math.abs(oscillator[x1_P_os] - oscillator[x3_P_os]) > Deviation_oscillator_Exaggerated_Authorized) and Err_Mid_Point_price == false and Err_Mid_Point_Oscillator == false and Err_Mid_Line_price == false and Err_Mid_Line_Oscillator == false ? true : false

    if (hg < lw) and (x3_P_pr != x4_P_pr) //MN
        if Feasibility_RD == true and ( (x1_P_pr < 300) and (x3_P_pr < 300) and (x1_P_os < 300) and (x3_P_os < 300) )
            Regular_MN := Source_high[x1_P_pr] > Source_high[x3_P_pr] and (math.abs(Source_high[x1_P_pr] - Source_high[x3_P_pr]) > Deviation_Price_Regular_Hiden_Authorized) and oscillator[x3_P_os] > oscillator[x1_P_os] and (math.abs(oscillator[x3_P_os] - oscillator[x1_P_os]) > Deviation_oscillator_Regular_Hiden_Authorized) and Err_Mid_Point_price == false and Err_Mid_Point_Oscillator == false and Err_Mid_Line_price == false and Err_Mid_Line_Oscillator == false ? true : false

        if Feasibility_HD == true and ( (x1_P_pr < 300) and (x3_P_pr < 300) and (x1_P_os < 300) and (x3_P_os < 300) )
            Hidden_MN := Source_high[x3_P_pr] > Source_high[x1_P_pr] and (math.abs(Source_high[x3_P_pr] - Source_high[x1_P_pr]) > Deviation_Price_Regular_Hiden_Authorized) and oscillator[x1_P_os] > oscillator[x3_P_os] and (math.abs(oscillator[x1_P_os] - oscillator[x3_P_os]) > Deviation_oscillator_Regular_Hiden_Authorized) and Err_Mid_Point_price == false and Err_Mid_Point_Oscillator == false and Err_Mid_Line_price == false and Err_Mid_Line_Oscillator == false ? true : false

        if Feasibility_ED == true and ( (x1_P_pr < 300) and (x3_P_pr < 300) and (x1_P_os < 300) and (x3_P_os < 300) )
            Exaggerated_MN := Source_high[x1_P_pr] <= Source_high[x3_P_pr] and (math.abs(Source_high[x3_P_pr] - Source_high[x1_P_pr]) <= Deviation_Price_Exaggerated_Authorized) and oscillator[x3_P_os] > oscillator[x1_P_os] and (math.abs(oscillator[x3_P_os] - oscillator[x1_P_os]) > Deviation_oscillator_Exaggerated_Authorized) and Err_Mid_Point_price == false and Err_Mid_Point_Oscillator == false and Err_Mid_Line_price == false and Err_Mid_Line_Oscillator == false ? true : false
            
    [Regular_MS, Hidden_MS, Exaggerated_MS, Regular_MN, Hidden_MN, Exaggerated_MN]

