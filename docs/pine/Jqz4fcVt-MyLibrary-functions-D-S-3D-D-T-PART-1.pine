export Search_piote_1(string [] array_id_7 , int scan_no)=>
    k = -1
    for i = 0 to 7
		if i <= array.size(array_id_7)-1
			if str.tonumber(str.match(str.substring(array.get(array_id_7 , i),scan_no-1), "^.")) == scan_no
				k := i
				break
    [k]

