library("MyLibrary_functions_D_S_3D_D_T_PART_1")

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////color_
export color_(color upcolor_txt, color upcolor, color dncolor_txt, color dncolor, string theme) =>

    [upcolor_txt_, upcolor_, dncolor_txt_, dncolor_] = if theme == 'Costom'
        [upcolor_txt, upcolor, dncolor_txt, dncolor]
    else
        if theme == 'theme_1'
            [#ffffff, #00203F, #ffffff, #00203F]
        else
            if theme == 'theme_2'
                [#000000, #F2AA4C, #000000, #F2AA4C]
            else
                if theme == 'theme_3'
                    [#ffffff, #195190, #ffffff, #195190]
                else
                    if theme == 'theme_4'
                        [#000000, #DFDFDF, #000000, #DFDFDF]
                    else
                        if theme == 'theme_5'
                            [#000000, #40E0D0, #000000, #40E0D0]
                        else
                            if theme == 'theme_6'
                                [#000000, #F3CA20, #000000, #F3CA20]
                            else
                                if theme == 'theme_7'
                                    [#000000, #8FBC0D, #000000, #8FBC0D]
                                else
                                    if theme == 'theme_8'
                                        [#ffffff, #252525, #ffffff, #252525]
                                    else
                                        if theme == 'theme_9'
                                            [#ffffff, #07042B, #ffffff, #07042B]
                                        else
                                            if theme == 'theme_10'
                                                [#ffffff, #F62937, #ffffff, #F62937]
                                            else
                                                if theme == 'theme_11'
                                                    [#ffffff, #000000, #ffffff, #000000]
                                                else
                                                    if theme == 'theme_12'
                                                        [#000000, #E0A96D, #000000, #E0A96D]
                                                    else
                                                        if theme == 'theme_13'
                                                            [#000000, #F2F2F2, #000000, #F2F2F2]
                                                        else
                                                            if theme == 'theme_14'
                                                                [#ffffff, #F53E4F, #ffffff, #F53E4F]

    [upcolor_txt_, upcolor_, dncolor_txt_, dncolor_]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
/////Source_Zigzag
export Source_Zigzag_F(string Source) =>
    Source_ = Source
    Source_Zigzag_F_low = Source_ == 'Maximum and Minimum' ? low : Source_ == 'open' ? open : Source_ == 'high' ? high : Source_ == 'low' ? low : Source_ == 'close' ? close : Source_ == 'hl2' ? hl2 : Source_ == 'hlc3' ? hlc3 : Source_ == 'ohlc4' ? ohlc4 : na
    Source_Zigzag_F_high = Source_ == 'Maximum and Minimum' ? high : Source_ == 'open' ? open : Source_ == 'high' ? high : Source_ == 'low' ? low : Source_ == 'close' ? close : Source_ == 'hl2' ? hl2 : Source_ == 'hlc3' ? hlc3 : Source_ == 'ohlc4' ? ohlc4 : na

    [Source_Zigzag_F_low, Source_Zigzag_F_high]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////p_lw_hg
export p_lw_hg(float Source_low, float Source_high, int Depth) =>
    p_lw = -ta.lowestbars(Source_low, Depth)
    p_hg = -ta.highestbars(Source_high, Depth)

    [p_lw, p_hg]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////lowing_highing
export lowing_highing(float Source_low, float Source_high, int p_lw, int p_hg, int Deviation) =>
    lowing = Source_low - Source_low[p_lw] < Deviation * syminfo.mintick
    highing = Source_high[p_hg] - Source_high < Deviation * syminfo.mintick

    [lowing, highing]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////ll_lh
export ll_lh(bool lowing, bool highing) =>
    barssince_1 = ta.barssince(lowing)
    ll = na(ta.barssince(lowing)) == true ? -1 : barssince_1
    barssince_2 = ta.barssince(highing)
    lh = na(ta.barssince(highing)) == true ? -1 : barssince_2

    [ll, lh]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////down_ll_down_lh
export down_ll_down_lh(int ll, int lh, int Backstep) =>
    down_ll = ta.barssince(lh > ll) >= Backstep
    down_lh = ta.barssince(ll > lh) >= Backstep

    [down_ll, down_lh]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////down
export down(bool down_ll, bool down_lh, int lw, int hg) =>
    down = (down_ll==true and down_lh==false) ? 1 : (down_lh==true and down_ll==false) ? 2 : (down_lh==down_ll and down_lh==false) ? lw > hg ? 1 : 2 : (down_lh==down_ll and down_lh==true) ? lw > hg ? 1 : 2 : 0

    [down]

