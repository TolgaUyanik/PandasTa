////label array
label_id(string RD_HD_EX ,string lable_id ,string Scan_zigzag_NO ,bool zigzag_Indicator_1 ,bool zigzag_Indicator_2 ,bool zigzag_Indicator_3 ,bool Validation_MACD_LINE_1 ,bool Validation_MACD_LINE_2 ,bool Validation_MACD_LINE_3 ,bool Validation_MACD_Histagram_1 ,bool Validation_MACD_Histagram_2 ,bool Validation_MACD_Histagram_3,bool Validation_RSI_1 ,bool Validation_RSI_2 ,bool Validation_RSI_3,bool Validation_Stochastic_1 ,bool Validation_Stochastic_2 ,bool Validation_Stochastic_3,bool Validation_volume_1 ,bool Validation_volume_2 ,bool Validation_volume_3,bool Validation_CCI_1 ,bool Validation_CCI_2 ,bool Validation_CCI_3,bool Validation_MFI_1 ,bool Validation_MFI_2 ,bool Validation_MFI_3,bool Validation_Momentum_1 ,bool Validation_Momentum_2 ,bool Validation_Momentum_3,bool Validation_OBV_1 ,bool Validation_OBV_2 ,bool Validation_OBV_3,bool Validation_ADX_1 ,bool Validation_ADX_2 ,bool Validation_ADX_3) =>

    zigzag_Indicator_1_ = zigzag_Indicator_1
    zigzag_Indicator_2_ = zigzag_Indicator_2
    zigzag_Indicator_3_ = zigzag_Indicator_3

    RD_id = array.new_string(30 , "")
    HD_id = array.new_string(30 , "")
    EX_id = array.new_string(30 , "")
    array.clear(RD_id),array.clear(HD_id),array.clear(EX_id)
    RD_id := str.split(str.match(str.substring(lable_id,0  ), "^.............................."), "") 
    HD_id := str.split(str.match(str.substring(lable_id,30 ), "^.............................."), "") 
    EX_id := str.split(str.match(str.substring(lable_id,60 ), "^.............................."), "") 

    lable_id_ar = array.new_string(30 , na)
    array.clear(lable_id_ar)
    lable_id_ar := RD_HD_EX == 'RD' ? array.copy(RD_id) : RD_HD_EX == 'HD' ? array.copy(HD_id) : RD_HD_EX == 'EX' ? array.copy(EX_id) : na

    //1 
    //1_1 
    if Validation_MACD_LINE_1 == true and zigzag_Indicator_1_ == true and Scan_zigzag_NO == 'zigzag_Indicator_1'
        array.set(lable_id_ar, 0 , '1')
    else if (Validation_MACD_LINE_1 == false or zigzag_Indicator_1_ == false) and Scan_zigzag_NO == 'zigzag_Indicator_1'
        array.set(lable_id_ar, 0 , '0')
    //1_2
    if Validation_MACD_LINE_2 == true and zigzag_Indicator_2_ == true and Scan_zigzag_NO == 'zigzag_Indicator_2'
        array.set(lable_id_ar, 1 , '2')
    else if (Validation_MACD_LINE_2 == false or zigzag_Indicator_2_ == false) and Scan_zigzag_NO == 'zigzag_Indicator_2'
        array.set(lable_id_ar, 1 , '0')       
    //1_3
    if Validation_MACD_LINE_3 == true and zigzag_Indicator_3_ == true and Scan_zigzag_NO == 'zigzag_Indicator_3'
        array.set(lable_id_ar, 2 , '3')
    else if (Validation_MACD_LINE_3 == false or zigzag_Indicator_3_ == false) and Scan_zigzag_NO == 'zigzag_Indicator_3'
        array.set(lable_id_ar, 2 , '0')       
                    

    //2 
    //1_1 
    if Validation_MACD_Histagram_1 == true and zigzag_Indicator_1_ == true and Scan_zigzag_NO == 'zigzag_Indicator_1'
        array.set(lable_id_ar, 3 , '1')
    else if (Validation_MACD_Histagram_1 == false or zigzag_Indicator_1_ == false) and Scan_zigzag_NO == 'zigzag_Indicator_1'
        array.set(lable_id_ar, 3 , '0')                        
    //1_2
    if Validation_MACD_Histagram_2 == true and zigzag_Indicator_2_ == true and Scan_zigzag_NO == 'zigzag_Indicator_2'
        array.set(lable_id_ar, 4 , '2')
    else if (Validation_MACD_Histagram_2 == false or zigzag_Indicator_2_ == false) and Scan_zigzag_NO == 'zigzag_Indicator_2'
        array.set(lable_id_ar, 4 , '0')                          
    //1_3
    if Validation_MACD_Histagram_3 == true and zigzag_Indicator_3_ == true and Scan_zigzag_NO == 'zigzag_Indicator_3'
        array.set(lable_id_ar, 5 , '3')
    else if (Validation_MACD_Histagram_3 == false or zigzag_Indicator_3_ == false) and Scan_zigzag_NO == 'zigzag_Indicator_3'
        array.set(lable_id_ar, 5 , '0')       
        
            
    //3 
    //1_1 
    if Validation_RSI_1 == true and zigzag_Indicator_1_ == true and Scan_zigzag_NO == 'zigzag_Indicator_1'
        array.set(lable_id_ar, 6 , '1')
    else if (Validation_RSI_1 == false or zigzag_Indicator_1_ == false) and Scan_zigzag_NO == 'zigzag_Indicator_1'
        array.set(lable_id_ar, 6 , '0')                                  
    //1_2
