NUM_hg_ ? max_bars_back_NUM_hg_ : x_P_SN_hg_23,x_P_SN_hg_24:=x_P_SN_hg_24 > max_bars_back_NUM_hg_ ? max_bars_back_NUM_hg_ : x_P_SN_hg_24,x_P_SN_hg_25:=x_P_SN_hg_25 > max_bars_back_NUM_hg_ ? max_bars_back_NUM_hg_ : x_P_SN_hg_25,x_P_SN_hg_26:=x_P_SN_hg_26 > max_bars_back_NUM_hg_ ? max_bars_back_NUM_hg_ : x_P_SN_hg_26,x_P_SN_hg_27:=x_P_SN_hg_27 > max_bars_back_NUM_hg_ ? max_bars_back_NUM_hg_ : x_P_SN_hg_27,x_P_SN_hg_28:=x_P_SN_hg_28 > max_bars_back_NUM_hg_ ? max_bars_back_NUM_hg_ : x_P_SN_hg_28,x_P_SN_hg_29:=x_P_SN_hg_29 > max_bars_back_NUM_hg_ ? max_bars_back_NUM_hg_ : x_P_SN_hg_29,x_P_SN_hg_30:=x_P_SN_hg_30 > max_bars_back_NUM_hg_ ? max_bars_back_NUM_hg_ : x_P_SN_hg_30

    if down == 1 and down[1] == 2 and down_hg_ok and lw_ < hg_ or down == 1 and down[1] == 1 and down_hg_ok and lw_[1] < hg_[1] and lw_ < hg_
        x_P_SN_hg_30 := x_P_SN_hg_29
        x_P_SN_hg_29 := x_P_SN_hg_28
        x_P_SN_hg_28 := x_P_SN_hg_27
        x_P_SN_hg_27 := x_P_SN_hg_26
        x_P_SN_hg_26 := x_P_SN_hg_25
        x_P_SN_hg_25 := x_P_SN_hg_24
        x_P_SN_hg_24 := x_P_SN_hg_23
        x_P_SN_hg_23 := x_P_SN_hg_22
        x_P_SN_hg_22 := x_P_SN_hg_21
        x_P_SN_hg_21 := x_P_SN_hg_20
        x_P_SN_hg_20 := x_P_SN_hg_19
        x_P_SN_hg_19 := x_P_SN_hg_18
        x_P_SN_hg_18 := x_P_SN_hg_17
        x_P_SN_hg_17 := x_P_SN_hg_16
        x_P_SN_hg_16 := x_P_SN_hg_15
        x_P_SN_hg_15 := x_P_SN_hg_14
        x_P_SN_hg_14 := x_P_SN_hg_13
