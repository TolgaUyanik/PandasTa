/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
//delet_scan_item
//Remove the selected self-scan and keep the rest
export delet_scan_item_1(string string_ , int NO_1 , int GAP) =>
    ARRAY_ = str.split(string_, "")
    string string__ = ''

    i = NO_1
    for re = 1 to 30
        array.set(ARRAY_ , i , '0')
        i := i + GAP
    string__ := str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.tostring(ARRAY_), ',', ''), ']', ''), '[', ''), ' ', '')

    [string__]

//save only the selected self-scan and delete the rest
export delet_scan_item_2(string string_ , int NO_1 , int GAP) =>
    ARRAY_ = str.split(string_, "")
    ARRAY_new = array.new_string(90 , '')
    string string__ = ''
    j=0
    i = NO_1
    for re = 1 to 30
        if j < NO_1
            array.set(ARRAY_new , j , '0')
            j+=1
        if i <= 89
            array.set(ARRAY_new , i , array.get(ARRAY_ , i))
        if i <= 88
            array.set(ARRAY_new , i+1 , '0')
        if i <= 87
            array.set(ARRAY_new , i+2 , '0')

        i := i + GAP
    string__ := str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.tostring(ARRAY_new), ',', ''), ']', ''), '[', ''), ' ', '')

    [string__]

/////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////
////sort
sort(indexArray_, P_idArray_, _order = order.ascending) => 

    index_sorted_indexArray_ = array.sort_indices(indexArray_ , _order)

    new_indexArray = array.new_int()
    new_P_idArray = array.new_string()
 
    for i=0 to array.size(index_sorted_indexArray_) - 1

        indexArray_Element = array.get(indexArray_, array.get(index_sorted_indexArray_, i))
        P_idArray_Element = array.get(P_idArray_ , array.get(index_sorted_indexArray_, i))

        array.insert( new_indexArray , i , indexArray_Element )
        array.insert( new_P_idArray , i , P_idArray_Element )

    [new_indexArray , new_P_idArray]

