// @description TODO: add library description here
library("drawing")

export enum textHorizontalAlignEnum
    left   = "Left"
    right  = "Right"
    center = "Center"

export method toTextAlign(textHorizontalAlignEnum input) =>
	string result = switch input
		textHorizontalAlignEnum.left  => text.align_left
		textHorizontalAlignEnum.right => text.align_right
		textHorizontalAlignEnum.center => text.align_center
		=> runtime.error("Invalid value"), na
	result

export enum textVertialAlignEnum
    top    = "Top"
    bottom = "Bottom"
    center = "Center"

export method toTextAlign(textVertialAlignEnum input) =>
	string result = switch input
		textVertialAlignEnum.top  => text.align_top
		textVertialAlignEnum.bottom => text.align_bottom
		textVertialAlignEnum.center => text.align_center
		=> runtime.error("Invalid value"), na
	result

export enum sizeEnum
    auto   = "Auto"
    tiny   = "Tiny"
    small  = "Small"
    normal = "Normal"
    large  = "Large"
    huge   = "Huge"

export method toSize(sizeEnum input) =>
	string result = switch input
		sizeEnum.tiny   => size.tiny
		sizeEnum.small  => size.small
		sizeEnum.normal => size.normal
		sizeEnum.large  => size.large
		sizeEnum.huge   => size.huge
		sizeEnum.auto   => size.auto
		=> runtime.error("Invalid size"), na
	result

//#region Line

export enum lineStyleEnum
    solid       = "_____"
    dashed      = "-----"
    dotted      = "....."
    arrow_both  =  "<--->"
    arrow_right = "---->" 
    arrow_left  = "<----"

export method toStyle(lineStyleEnum input) =>
    switch input
        lineStyleEnum.dashed      => line.style_dashed
        lineStyleEnum.dotted      => line.style_dotted
        lineStyleEnum.solid       => line.style_solid
        lineStyleEnum.arrow_both  => line.style_arrow_both
        lineStyleEnum.arrow_right => line.style_arrow_right
        lineStyleEnum.arrow_left  => line.style_arrow_left
        => line.style_solid

