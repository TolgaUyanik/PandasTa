//@version=5
indicator("ES Order Flow Bubbles", overlay=true, max_labels_count=500)

// Inputs
volumeThreshold = input.int(5000, title="Volume Threshold", minval=1)
bubbleSize = input.string("large", title="Bubble Size", options=["tiny", "small", "normal", "large", "huge"])

// Conditions
isBigVolume = volume > volumeThreshold
isBull = close >= open
isBear = close < open

// Draw bubbles
if isBigVolume and isBull
    label.new(bar_index, low, text="🟢", style=label.style_label_up, color=color.green, size=bubbleSize, textcolor=color.white)

if isBigVolume and isBear
    label.new(bar_index, high, text="🔴", style=label.style_label_down, color=color.red, size=bubbleSize, textcolor=color.white)