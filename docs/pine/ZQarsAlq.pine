// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © MINIBOSS1234
//@version=6
strategy("Roji Scalping Pattern TP1/TP2 Cent by MiniBoss", overlay=true, scale=scale.right, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1.0, pyramiding=0, margin_long=1, margin_short=1, process_orders_on_close=true, max_labels_count=500, max_lines_count=500)

string CORE="1) Core Setup"
string RISK="2) Risk / Reward"
string FILTER="3) Filters"
string VISUAL="4) Visual / Debug"

entryMode=input.string("Pattern Break","Entry Mode",options=["Pattern Break","Retest"],group=CORE)
swingLen=input.int(10,"Structure Swing Length",minval=3,maxval=30,group=CORE)
retestBars=input.int(8,"Max Bars Wait Retest",minval=1,maxval=30,group=CORE)
useContinuation=input.bool(true,"Use Continuation: RBR / DBD",group=CORE)
useReversal=input.bool(true,"Use Reversal: DBR / RBD",group=CORE)
useDoublePattern=input.bool(true,"Use Double Top / Bottom",group=CORE)
baseBars=input.int(3,"Base Bars for RBR/DBD/DBR/RBD",minval=2,maxval=8,group=CORE)
impulseLookback=input.int(4,"Impulse Lookback",minval=2,maxval=10,group=CORE)
atrLen=input.int(14,"ATR Length",minval=5,maxval=50,group=CORE)
impulseAtrMult=input.float(0.8,"Impulse ATR Mult",minval=0.2,maxval=3.0,step=0.1,group=CORE)
baseAtrMult=input.float(0.9,"Base Max ATR Mult",minval=0.2,maxval=2.0,step=0.1,group=CORE)
dtPivotLen=input.int(5,"Double Pattern Pivot Length",minval=2,maxval=15,group=CORE)
dtTolerancePoints=input.int(180,"Double Pattern Tolerance Points",minval=20,maxval=800,group=CORE)
dtMaxBars=input.int(35,"Double Pattern Max Bars",minval=10,maxval=120,group=CORE)

minSLPoints=input.int(500,"Min SL Points",minval=100,maxval=2000,group=RISK)
maxSLPoints=input.int(800,"Max SL Points",minval=200,maxval=3000,group=RISK)
slBufferPoints=input.int(80,"Structure SL Buffer Points",minval=0,maxval=500,group=RISK)
tp1RR=input.float(1.0,"TP1 RR",minval=0.5,maxval=3.0,step=0.1,group=RISK)
tp2RR=input.float(1.5,"TP2 RR",minval=1.0,maxval=5.0,step=0.1,group=RISK)
tp1QtyPercent=input.int(50,"TP1 Close Qty %",minval=10,maxval=90,group=RISK)
useBEAfterTP1=input.bool(true,"Move SL to BE after TP1",group=RISK)
beOffsetPoints=input.int(40,"BE Offset Points",minval=0,maxval=300,group=RISK)
maxTradesDay=input.int(3,"Max Trades Per Day",minval=1,maxval=20,group=RISK)
stopAfterWins=input.int(2,"Stop After Wins / Day",minval=1,maxval=10,group=RISK)
stopAfterLosses=input.int(2,"Stop After Losses / Day",minval=1,maxval=10,group=RISK)
useDailyStopRule=input.bool(true,"Use Daily Win/Loss Stop Rule",group=RISK)
researchMode=input.bool(false,"Research Mode: Ignore Daily Limits",group=RISK)

useSession=input.bool(true,"Use Trading Session",group=FILTER)
tradeSession=input.session("1430-1900","Trading Session",group=FILTER)
tradeTz=input.string("Asia/Bangkok","Session Timezone",group=FILTER)
useHTFBias=input.bool(true,"Use HTF EMA200 Bias Filter",group=FILTER)
htfTf=input.timeframe("60","HTF Bias Timeframe",group=FILTER)
useEMADirectionFilter=input.bool(true,"Use EMA Direction Filter",group=FILTER)

showEMA=input.bool(true,"Show EMA 20/50/200",group=VISUAL)
showDebug=input.bool(true,"Show Pattern Signals",group=VISUAL)
showTradeLabels=input.bool(true,"Show Trade Labels",group=VISUAL)
showLines=input.bool(true,"Show TP1/TP2/SL Lines",group=VISUAL)
showTable=input.bool(true,"Show Dashboard",group=VISUAL)
showMTFDashboard=input.bool(true,"Show MTF Trend Bias Dashboard",group=VISUAL)
mtfEmaLen=input.int(200,"MTF Bias EMA Length",minval=20,maxval=300,group=VISUAL)
neutralBuffer=input.float(0.05,"Neutral Buffer %",minval=0.01,maxval=1.0,step=0.01,group=VISUAL)
dashSize=input.string("Small","Dashboard Size",options=["Small","Medium","Large"],group=VISUAL)
f_size(string s)=>s=="Small"?size.tiny:s=="Medium"?size.small:size.normal
txtSize=f_size(dashSize)

color GREEN=color.rgb(2,133,69)
color RED=color.rgb(246,7,7)
ema20=ta.ema(close,20)
ema50=ta.ema(close,50)
ema200=ta.ema(close,200)
plot(showEMA?ema20:na,"EMA 20",color=color.new(color.teal,0))
plot(showEMA?ema50:na,"EMA 50",color=color.new(color.orange,0))
plot(showEMA?ema200:na,"EMA 200",color=color.new(color.gray,0))
emaBullOK=not useEMADirectionFilter or close>ema50 or (ema20>ema50 and ema50>ema200)
emaBearOK=not useEMADirectionFilter or close<ema50 or (ema20<ema50 and ema50<ema200)

f_bias(string tf)=>
    c=request.security(syminfo.tickerid,tf,close)
    e=request.security(syminfo.tickerid,tf,ta.ema(close,mtfEmaLen))
    d=((c-e)/e)*100.0
    t=d>neutralBuffer?"BULL":d< -neutralBuffer?"BEAR":"NEUTRAL"
    col=d>neutralBuffer?color.lime:d< -neutralBuffer?color.red:color.yellow
    [t,col,d]
[m1Bias,m1Color,m1Diff]=f_bias("1")
[m5Bias,m5Color,m5Diff]=f_bias("5")
[m15Bias,m15Color,m15Diff]=f_bias("15")
[m30Bias,m30Color,m30Diff]=f_bias("30")
[h1Bias,h1Color,h1Diff]=f_bias("60")
[h4Bias,h4Color,h4Diff]=f_bias("240")
[d1Bias,d1Color,d1Diff]=f_bias("D")
bullCount=(m1Bias=="BULL"?1:0)+(m5Bias=="BULL"?1:0)+(m15Bias=="BULL"?1:0)+(m30Bias=="BULL"?1:0)+(h1Bias=="BULL"?1:0)+(h4Bias=="BULL"?1:0)+(d1Bias=="BULL"?1:0)
bearCount=(m1Bias=="BEAR"?1:0)+(m5Bias=="BEAR"?1:0)+(m15Bias=="BEAR"?1:0)+(m30Bias=="BEAR"?1:0)+(h1Bias=="BEAR"?1:0)+(h4Bias=="BEAR"?1:0)+(d1Bias=="BEAR"?1:0)
overallBias=bullCount>bearCount?"BUY BIAS":bearCount>bullCount?"SELL BIAS":"MIXED"
overallColor=bullCount>bearCount?color.lime:bearCount>bullCount?color.red:color.yellow

inSession=not useSession or not na(time(timeframe.period,tradeSession,tradeTz))
var int tradesToday = 0
var int winsToday = 0
var int beToday = 0
var int lossesToday = 0

var int totalCustomWins = 0
var int totalCustomBE = 0
var int totalCustomLosses = 0

var int lastClosedTrades = 0

if timeframe.change("D")
    tradesToday := 0
    winsToday := 0
    beToday := 0
    lossesToday := 0

// ==========================
// LIGHTWEIGHT W / BE / L COUNTER
// Counts only newly closed trades, not the whole history every bar.
// ==========================
if strategy.closedtrades > lastClosedTrades
    for i = lastClosedTrades to strategy.closedtrades - 1
        ep = strategy.closedtrades.entry_price(i)
        xp = strategy.closedtrades.exit_price(i)
        sz = strategy.closedtrades.size(i)
        pr = strategy.closedtrades.profit(i)

        dir = sz > 0 ? 1 : -1
        movePoints = ((xp - ep) * dir) / syminfo.mintick

        isBE = math.abs(movePoints) <= beOffsetPoints + 80 or math.abs(pr) <= 0.05
        isWin = pr > 0 and not isBE
        isLoss = pr < 0 and not isBE

        if isWin
            winsToday += 1
            totalCustomWins += 1
        else if isLoss
            lossesToday += 1
            totalCustomLosses += 1
        else
            beToday += 1
            totalCustomBE += 1

    lastClosedTrades := strategy.closedtrades

dailyStop=not researchMode and useDailyStopRule and (winsToday>=stopAfterWins or lossesToday>=stopAfterLosses)
canTrade=inSession and not dailyStop and (researchMode or tradesToday<maxTradesDay) and strategy.position_size==0
htfClose=request.security(syminfo.tickerid,htfTf,close)
htfEMA200=request.security(syminfo.tickerid,htfTf,ta.ema(close,200))
buyBiasOK=not useHTFBias or htfClose>htfEMA200
sellBiasOK=not useHTFBias or htfClose<htfEMA200

pointValue=syminfo.mintick
atr=ta.atr(atrLen)
f_clamp(float v,float mn,float mx)=>math.max(mn,math.min(v,mx))
f_longSLPoints()=>int(math.round(f_clamp(((close-ta.lowest(low,swingLen))/pointValue)+slBufferPoints,minSLPoints,maxSLPoints)))
f_shortSLPoints()=>int(math.round(f_clamp(((ta.highest(high,swingLen)-close)/pointValue)+slBufferPoints,minSLPoints,maxSLPoints)))

baseHigh=ta.highest(high[1],baseBars)
baseLow=ta.lowest(low[1],baseBars)
baseOK=(baseHigh-baseLow)<=atr*baseAtrMult
preMove=close[baseBars]-close[baseBars+impulseLookback]
beforeRally=preMove>atr*impulseAtrMult
beforeDrop=preMove< -atr*impulseAtrMult
breakAboveBase=close>baseHigh and close[1]<=baseHigh
breakBelowBase=close<baseLow and close[1]>=baseLow
rbrBuy=useContinuation and beforeRally and baseOK and breakAboveBase
dbdSell=useContinuation and beforeDrop and baseOK and breakBelowBase
dbrBuy=useReversal and beforeDrop and baseOK and breakAboveBase
rbdSell=useReversal and beforeRally and baseOK and breakBelowBase

pivotLow = ta.pivotlow(low, dtPivotLen, dtPivotLen)
pivotHigh = ta.pivothigh(high, dtPivotLen, dtPivotLen)

// คำนวณ Neckline Candidate ทุกแท่งก่อน เพื่อไม่ให้ Pine เตือน
dbNeckCandidate = ta.highest(high, dtMaxBars)
dtNeckCandidate = ta.lowest(low, dtMaxBars)

var float prevLow = na
var float prevHigh = na
var float dbNeck = na
var float dtNeck = na

var int prevLowBar = na
var int prevHighBar = na

var bool waitDB = false
var bool waitDT = false

if not na(pivotLow)
    currLow = pivotLow
    currLowBar = bar_index - dtPivotLen

    if not na(prevLow) and not na(prevLowBar) and math.abs(currLow - prevLow) / pointValue <= dtTolerancePoints and currLowBar - prevLowBar <= dtMaxBars
        waitDB := true
        dbNeck := dbNeckCandidate

    prevLow := currLow
    prevLowBar := currLowBar

if not na(pivotHigh)
    currHigh = pivotHigh
    currHighBar = bar_index - dtPivotLen

    if not na(prevHigh) and not na(prevHighBar) and math.abs(currHigh - prevHigh) / pointValue <= dtTolerancePoints and currHighBar - prevHighBar <= dtMaxBars
        waitDT := true
        dtNeck := dtNeckCandidate

    prevHigh := currHigh
    prevHighBar := currHighBar

doubleBottomBuy = useDoublePattern and waitDB and not na(dbNeck) and close > dbNeck
doubleTopSell = useDoublePattern and waitDT and not na(dtNeck) and close < dtNeck

if doubleBottomBuy
    waitDB := false
    dbNeck := na

if doubleTopSell
    waitDT := false
    dtNeck := na

var bool waitBuyRetest=false
var bool waitSellRetest=false
var float buyRetestLevel=na
var float sellRetestLevel=na
var string buyPatternName=""
var string sellPatternName=""
var int buyAge=0
var int sellAge=0
rawBuy=rbrBuy or dbrBuy or doubleBottomBuy
rawSell=dbdSell or rbdSell or doubleTopSell
buyName=rbrBuy?"RBR":dbrBuy?"DBR":doubleBottomBuy?"Double Bottom":""
sellName=dbdSell?"DBD":rbdSell?"RBD":doubleTopSell?"Double Top":""
buyBreakLevel=(rbrBuy or dbrBuy)?baseHigh:dbNeck
sellBreakLevel=(dbdSell or rbdSell)?baseLow:dtNeck
if rawBuy
    waitBuyRetest:=true
    waitSellRetest:=false
    buyRetestLevel:=buyBreakLevel
    buyPatternName:=buyName
    buyAge:=0
if rawSell
    waitSellRetest:=true
    waitBuyRetest:=false
    sellRetestLevel:=sellBreakLevel
    sellPatternName:=sellName
    sellAge:=0
if waitBuyRetest
    buyAge+=1
if waitSellRetest
    sellAge+=1
if buyAge>retestBars
    waitBuyRetest:=false
if sellAge>retestBars
    waitSellRetest:=false
bullCandle=close>open
bearCandle=close<open
buyRetest=waitBuyRetest and low<=buyRetestLevel and close>=buyRetestLevel and bullCandle
sellRetest=waitSellRetest and high>=sellRetestLevel and close<=sellRetestLevel and bearCandle
buyTrigger=entryMode=="Pattern Break"?rawBuy:buyRetest
sellTrigger=entryMode=="Pattern Break"?rawSell:sellRetest
activeBuyName=entryMode=="Pattern Break"?buyName:buyPatternName
activeSellName=entryMode=="Pattern Break"?sellName:sellPatternName
longSignal=canTrade and buyBiasOK and emaBullOK and buyTrigger
shortSignal=canTrade and sellBiasOK and emaBearOK and sellTrigger

longSLPts=f_longSLPoints()
shortSLPts=f_shortSLPoints()
longRisk=longSLPts*pointValue
shortRisk=shortSLPts*pointValue
longSL=close-longRisk
longTP1=close+longRisk*tp1RR
longTP2=close+longRisk*tp2RR
shortSL=close+shortRisk
shortTP1=close-shortRisk*tp1RR
shortTP2=close-shortRisk*tp2RR
var float activeSL=na
var float activeTP1=na
var float activeTP2=na
var int activeSLPoints=na
var string activePattern=""
var bool tp1Hit=false
if strategy.position_size==0
    activeSL:=na
    activeTP1:=na
    activeTP2:=na
    activeSLPoints:=na
    activePattern:=""
    tp1Hit:=false
if longSignal
    activeSL:=longSL
    activeTP1:=longTP1
    activeTP2:=longTP2
    activeSLPoints:=longSLPts
    activePattern:=activeBuyName
    tp1Hit:=false
    strategy.entry("BUY Roji",strategy.long)
    tradesToday+=1
    waitBuyRetest:=false
if shortSignal
    activeSL:=shortSL
    activeTP1:=shortTP1
    activeTP2:=shortTP2
    activeSLPoints:=shortSLPts
    activePattern:=activeSellName
    tp1Hit:=false
    strategy.entry("SELL Roji",strategy.short)
    tradesToday+=1
    waitSellRetest:=false
beOffset=beOffsetPoints*pointValue
if strategy.position_size>0 and not na(activeSL)
    if high>=activeTP1
        tp1Hit:=true
    dynSL=useBEAfterTP1 and tp1Hit?strategy.position_avg_price+beOffset:activeSL
    strategy.exit("BUY TP1","BUY Roji",stop=dynSL,limit=activeTP1,qty_percent=tp1QtyPercent)
    strategy.exit("BUY TP2","BUY Roji",stop=dynSL,limit=activeTP2,qty_percent=100-tp1QtyPercent)
if strategy.position_size<0 and not na(activeSL)
    if low<=activeTP1
        tp1Hit:=true
    dynSL=useBEAfterTP1 and tp1Hit?strategy.position_avg_price-beOffset:activeSL
    strategy.exit("SELL TP1","SELL Roji",stop=dynSL,limit=activeTP1,qty_percent=tp1QtyPercent)
    strategy.exit("SELL TP2","SELL Roji",stop=dynSL,limit=activeTP2,qty_percent=100-tp1QtyPercent)

plotshape(showDebug and rbrBuy,title="RBR Buy",text="RBR",style=shape.labelup,location=location.belowbar,color=color.new(GREEN,0),textcolor=color.white,size=size.tiny)
plotshape(showDebug and dbrBuy,title="DBR Buy",text="DBR",style=shape.labelup,location=location.belowbar,color=color.new(color.lime,0),textcolor=color.black,size=size.tiny)
plotshape(showDebug and doubleBottomBuy,title="Double Bottom Buy",text="W",style=shape.labelup,location=location.belowbar,color=color.new(color.aqua,0),textcolor=color.black,size=size.tiny)
plotshape(showDebug and dbdSell,title="DBD Sell",text="DBD",style=shape.labeldown,location=location.abovebar,color=color.new(RED,0),textcolor=color.white,size=size.tiny)
plotshape(showDebug and rbdSell,title="RBD Sell",text="RBD",style=shape.labeldown,location=location.abovebar,color=color.new(color.orange,0),textcolor=color.black,size=size.tiny)
plotshape(showDebug and doubleTopSell,title="Double Top Sell",text="M",style=shape.labeldown,location=location.abovebar,color=color.new(color.fuchsia,0),textcolor=color.white,size=size.tiny)
// ==========================
// TP1 / TP2 / SL VISUALS
// ==========================
if showLines and longSignal
    line.new(bar_index, activeSL, bar_index + 25, activeSL, color=color.red, style=line.style_dashed, width=1)
    line.new(bar_index, activeTP1, bar_index + 25, activeTP1, color=color.new(color.lime, 0), style=line.style_dashed, width=1)
    line.new(bar_index, activeTP2, bar_index + 25, activeTP2, color=color.new(color.green, 0), style=line.style_dashed, width=2)
    label.new(bar_index + 25, activeSL, "SL", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
    label.new(bar_index + 25, activeTP1, "TP1", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny)
    label.new(bar_index + 25, activeTP2, "TP2", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)

if showLines and shortSignal
    line.new(bar_index, activeSL, bar_index + 25, activeSL, color=color.red, style=line.style_dashed, width=1)
    line.new(bar_index, activeTP1, bar_index + 25, activeTP1, color=color.new(color.lime, 0), style=line.style_dashed, width=1)
    line.new(bar_index, activeTP2, bar_index + 25, activeTP2, color=color.new(color.green, 0), style=line.style_dashed, width=2)
    label.new(bar_index + 25, activeSL, "SL", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
    label.new(bar_index + 25, activeTP1, "TP1", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny)
    label.new(bar_index + 25, activeTP2, "TP2", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)

if showTradeLabels and longSignal
    longLabelText = "BUY " + activeBuyName + "\nEntry: " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(activeSL, format.mintick) + "\nTP1: " + str.tostring(activeTP1, format.mintick) + "\nTP2: " + str.tostring(activeTP2, format.mintick) + "\nSL pts: " + str.tostring(activeSLPoints)
    label.new(bar_index, low, longLabelText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=GREEN, textcolor=color.white, size=size.small)

if showTradeLabels and shortSignal
    shortLabelText = "SELL " + activeSellName + "\nEntry: " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(activeSL, format.mintick) + "\nTP1: " + str.tostring(activeTP1, format.mintick) + "\nTP2: " + str.tostring(activeTP2, format.mintick) + "\nSL pts: " + str.tostring(activeSLPoints)
    label.new(bar_index, high, shortLabelText, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=RED, textcolor=color.white, size=size.small)

barcolor(strategy.position_size>0?color.new(GREEN,0):strategy.position_size<0?color.new(RED,0):na)

var table tb=table.new(position.top_right,2,17,bgcolor=color.new(color.black,75),frame_color=color.new(color.white,40),frame_width=1,border_color=color.new(color.white,70),border_width=1)
winTrades=strategy.wintrades
lossTrades=strategy.losstrades
totalTrades=winTrades+lossTrades

winRate = totalTrades > 0 ? (winTrades / totalTrades) * 100 : na
profitFactor = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na

customDecisionTrades = totalCustomWins + totalCustomLosses
customWinRate = customDecisionTrades > 0 ? (totalCustomWins / customDecisionTrades) * 100 : na

setupStatus=rawBuy?"BUY "+buyName:rawSell?"SELL "+sellName:buyRetest?"BUY Retest":sellRetest?"SELL Retest":"Waiting"
tradeStatus=dailyStop?"STOPPED":canTrade?"ACTIVE":"WAIT"
stopReason=researchMode?"RESEARCH MODE":winsToday>=stopAfterWins?"WIN TARGET HIT":lossesToday>=stopAfterLosses?"LOSS LIMIT HIT":"NONE"
limitText=researchMode?"UNLIMITED":str.tostring(maxTradesDay)
if barstate.islast and showTable
    table.cell(tb,0,0,"ROJI SCALP PATTERN",text_color=color.white,bgcolor=color.new(color.blue,30),text_size=txtSize)
    table.cell(tb,1,0,"Cent 10000 / 1.0",text_color=color.white,bgcolor=color.new(color.blue,30),text_size=txtSize)
    table.cell(tb,0,1,"Entry Mode",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,1,entryMode,text_color=color.aqua,text_size=txtSize)
    table.cell(tb,0,2,"Pattern",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,2,setupStatus,text_color=color.yellow,text_size=txtSize)
    table.cell(tb,0,3,"Trade Status",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,3,tradeStatus,text_color=dailyStop?color.red:canTrade?color.lime:color.yellow,text_size=txtSize)
    table.cell(tb,0,4,"Stop Reason",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,4,stopReason,text_color=researchMode?color.orange:stopReason=="NONE"?color.gray:color.red,text_size=txtSize)
    table.cell(tb,0,5,"Trades Today",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,5,str.tostring(tradesToday)+"/"+limitText,text_color=color.yellow,text_size=txtSize)
    table.cell(tb,0,6,"W / BE / L",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,6,str.tostring(winsToday)+" / "+str.tostring(beToday)+" / "+str.tostring(lossesToday),text_color=color.aqua,text_size=txtSize)
    table.cell(tb,0,7,"Session",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,7,inSession?"ON":"OFF",text_color=inSession?color.lime:color.red,text_size=txtSize)
    table.cell(tb,0,8,"HTF Bias",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,8,useHTFBias?htfTf+" EMA200":"OFF",text_color=useHTFBias?color.lime:color.orange,text_size=txtSize)
    table.cell(tb,0,9,"Dynamic SL",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,9,"L "+str.tostring(longSLPts)+" / S "+str.tostring(shortSLPts),text_color=color.orange,text_size=txtSize)
    table.cell(tb,0,10,"TP Plan",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,10,"TP1 "+str.tostring(tp1RR)+"R / TP2 "+str.tostring(tp2RR)+"R",text_color=color.aqua,text_size=txtSize)
    table.cell(tb,0,11,"BE Rule",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,11,useBEAfterTP1?"After TP1 +"+str.tostring(beOffsetPoints):"OFF",text_color=useBEAfterTP1?color.aqua:color.gray,text_size=txtSize)
    table.cell(tb,0,12,"Active Pattern",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,12,activePattern==""?"None":activePattern,text_color=color.yellow,text_size=txtSize)
    table.cell(tb,0,13,"Winrate",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,13,na(winRate)?"N/A":str.tostring(winRate,"#.##")+"%",text_color=color.lime,text_size=txtSize)
    table.cell(tb,0,14,"Profit Factor",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,14,na(profitFactor)?"N/A":str.tostring(profitFactor,"#.##"),text_color=color.aqua,text_size=txtSize)
    table.cell(tb,0,15,"Total W/BE/L",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,15,str.tostring(totalCustomWins)+" / "+str.tostring(totalCustomBE)+" / "+str.tostring(totalCustomLosses),text_color=color.aqua,text_size=txtSize)

    table.cell(tb,0,16,"Custom WR",text_color=color.white,text_size=txtSize)
    table.cell(tb,1,16,na(customWinRate)?"N/A":str.tostring(customWinRate,"#.##")+"%",text_color=color.lime,text_size=txtSize)

var table mtfTb=table.new(position.bottom_right,3,9,bgcolor=color.new(color.black,75),frame_color=color.new(color.white,40),frame_width=1,border_color=color.new(color.white,70),border_width=1)
if barstate.islast and showMTFDashboard
    table.cell(mtfTb,0,0,"TF",text_color=color.white,bgcolor=color.new(color.blue,30),text_size=txtSize)
    table.cell(mtfTb,1,0,"Bias",text_color=color.white,bgcolor=color.new(color.blue,30),text_size=txtSize)
    table.cell(mtfTb,2,0,"Diff",text_color=color.white,bgcolor=color.new(color.blue,30),text_size=txtSize)
    table.cell(mtfTb,0,1,"M1",text_color=color.white,text_size=txtSize)
    table.cell(mtfTb,1,1,m1Bias,text_color=m1Color,text_size=txtSize)
    table.cell(mtfTb,2,1,str.tostring(m1Diff,"#.##")+"%",text_color=m1Color,text_size=txtSize)
    table.cell(mtfTb,0,2,"M5",text_color=color.white,text_size=txtSize)
    table.cell(mtfTb,1,2,m5Bias,text_color=m5Color,text_size=txtSize)
    table.cell(mtfTb,2,2,str.tostring(m5Diff,"#.##")+"%",text_color=m5Color,text_size=txtSize)
    table.cell(mtfTb,0,3,"M15",text_color=color.white,text_size=txtSize)
    table.cell(mtfTb,1,3,m15Bias,text_color=m15Color,text_size=txtSize)
    table.cell(mtfTb,2,3,str.tostring(m15Diff,"#.##")+"%",text_color=m15Color,text_size=txtSize)
    table.cell(mtfTb,0,4,"M30",text_color=color.white,text_size=txtSize)
    table.cell(mtfTb,1,4,m30Bias,text_color=m30Color,text_size=txtSize)
    table.cell(mtfTb,2,4,str.tostring(m30Diff,"#.##")+"%",text_color=m30Color,text_size=txtSize)
    table.cell(mtfTb,0,5,"H1",text_color=color.white,text_size=txtSize)
    table.cell(mtfTb,1,5,h1Bias,text_color=h1Color,text_size=txtSize)
    table.cell(mtfTb,2,5,str.tostring(h1Diff,"#.##")+"%",text_color=h1Color,text_size=txtSize)
    table.cell(mtfTb,0,6,"H4",text_color=color.white,text_size=txtSize)
    table.cell(mtfTb,1,6,h4Bias,text_color=h4Color,text_size=txtSize)
    table.cell(mtfTb,2,6,str.tostring(h4Diff,"#.##")+"%",text_color=h4Color,text_size=txtSize)
    table.cell(mtfTb,0,7,"D1",text_color=color.white,text_size=txtSize)
    table.cell(mtfTb,1,7,d1Bias,text_color=d1Color,text_size=txtSize)
    table.cell(mtfTb,2,7,str.tostring(d1Diff,"#.##")+"%",text_color=d1Color,text_size=txtSize)
    table.cell(mtfTb,0,8,"TOTAL",text_color=color.white,bgcolor=color.new(color.gray,70),text_size=txtSize)
    table.cell(mtfTb,1,8,overallBias,text_color=overallColor,bgcolor=color.new(color.gray,70),text_size=txtSize)
    table.cell(mtfTb,2,8,str.tostring(bullCount)+"B/"+str.tostring(bearCount)+"S",text_color=overallColor,bgcolor=color.new(color.gray,70),text_size=txtSize)

alertcondition(longSignal,title="BUY Roji Pattern",message="BUY Roji Scalping Pattern Signal")
alertcondition(shortSignal,title="SELL Roji Pattern",message="SELL Roji Scalping Pattern Signal")
