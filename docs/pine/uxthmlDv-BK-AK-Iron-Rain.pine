//                     F O O T P R I N T   W A R F A R E
//                             v 2 . 3 . 2
// ═══════════════════════════════════════════════════════════════════════════════
//          ── Footprint Auction Logic Engine ──
//             ── Final Corrected Edition ──
// ═══════════════════════════════════════════════════════════════════════════════
//
// v2.3.2:
//   - Restored directional displacement marker colors (bull/bear), now as two
//     configurable inputs instead of one fixed color.
//
// v2.3.1 FINAL PASS:
//   - Harmonized version metadata (header/footer).
//   - Alert placeholders converted from positional {{plot_N}} to named
//     {{plot("...")}} references — immune to future plot reordering.
//
// v2.3 CORRECTION PASS:
//   - Corrected standard BSL/SSL terminology and directional sweep labels.
//   - Removed unsupported market-participant and certainty claims from UI text.
//   - Changed unoffset HTF pivots to lookahead_off.
//   - Enforced the configured opposing reclaim-delta threshold in trap detection.
//   - Corrected bullish/bearish trap-event direction storage.
//   - Corrected FVG quality/delta attribution to the displacement candle.
//   - Clamped FVG quality to a true 0-100 model score.
//   - Replaced repeated table creation with persistent tables.
//   - Corrected execution-panel FVG alignment and first-bars displacement memory.
//   - Rebuilt alert names/messages for BK AK-Iron Rain.
//   - Replaced the former delta-only absorption alert with a structured
//     high-delta rejection condition at a tracked level.
//
//   [M1] Liquidity Pool Mapper — POC/VAH/VAL + counter-flow scoring
//   [M2] Auction Cycle Engine — balanced activity, sweep phase, expansion
//   [M3] Trap + Reversal Analysis — reclaim and current-bar response factors
//   [M4] Displacement Scanner — footprint-qualified movement + FVG tracking
//   [DB] Narrative Dashboard + Setup Checklist
//
// Footprint-dependent modules require compatible TradingView footprint access
// and footprint data on the selected symbol/chart.
//
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("BK AK-Iron Rain", "♛", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │                     SECTION 1: GLOBAL INPUTS                               │
// └─────────────────────────────────────────────────────────────────────────────┘

string GRP_GLOBAL   = "═══ GLOBAL SETTINGS ═══"
string GRP_FP       = "═══ FOOTPRINT CONFIG ═══"
string GRP_LIQ      = "═══ [M1] LIQUIDITY POOL MAPPER ═══"
string GRP_MAGNET   = "═══ [M1] MAGNET LINES ═══"
string GRP_AMD      = "═══ [M2] AUCTION CYCLE ENGINE ═══"
string GRP_TRAP     = "═══ [M3] TRAP DETECTION ═══"
string GRP_DISP     = "═══ [M4] DISPLACEMENT / FVG ═══"
string GRP_SESSION  = "═══ SESSION WINDOWS ═══"
string GRP_DASH     = "═══ DASHBOARD ═══"
string GRP_ALERTS   = "═══ ALERTS ═══"

// ── Global ──
i_showClean         = input.bool(true,   "Show Clean Mode (Zones + Signals)",     group=GRP_GLOBAL)
i_showHUD           = input.bool(true,   "Show Full HUD Dashboard",               group=GRP_GLOBAL)
i_htfEnabled        = input.bool(true,   "Enable Multi-Timeframe Analysis",       group=GRP_GLOBAL)
i_htfTF             = input.timeframe("60", "Higher Timeframe",                   group=GRP_GLOBAL, tooltip="HTF for structural context. Recommended: 4-10x chart TF.")
i_atrLen            = input.int(14,      "ATR Length (Volatility Reference)",      group=GRP_GLOBAL, minval=5, maxval=50)
i_maxDrawings       = input.int(30,      "Max Drawings Per Type",                 group=GRP_GLOBAL, minval=10, maxval=80)

// ── Footprint Config ──
i_fpTickSize        = input.int(21,      "Tick Size Per Row",                     group=GRP_FP, minval=1, maxval=500, tooltip="Number of ticks aggregated into each footprint row. Smaller values provide finer detail; larger values provide broader aggregation. Use a value appropriate to the symbol and timeframe.")
i_fpVAPct           = input.int(70,      "Value Area %",                          group=GRP_FP, minval=50, maxval=90, tooltip="Percentage of volume that defines the Value Area (default 70%).")
i_fpDeltaSmoothLen  = input.int(5,       "Delta Smoothing Length",                group=GRP_FP, minval=1, maxval=20, tooltip="SMA length for smoothed delta trend.")

// ── [M1] Liquidity Pool Mapper ──
i_liqEnabled        = input.bool(true,   "Enable Liquidity Mapper",               group=GRP_LIQ)
i_pivotLen          = input.int(5,       "Pivot Detection Length",                group=GRP_LIQ, minval=2, maxval=20)
i_clusterATR        = input.float(0.3,   "Cluster Threshold (ATR Multiple)",      group=GRP_LIQ, minval=0.05, maxval=1.0, step=0.05)
i_maxLevels         = input.int(20,      "Max Liquidity Levels Tracked",          group=GRP_LIQ, minval=5, maxval=50)
i_touchWeight       = input.float(1.0,   "Touch Count Weight",                    group=GRP_LIQ, minval=0.1, maxval=3.0, step=0.1)
i_recencyWeight     = input.float(1.5,   "Recency Weight",                        group=GRP_LIQ, minval=0.1, maxval=3.0, step=0.1)
i_conflWeight       = input.float(2.0,   "Confluence Weight (Key Levels)",        group=GRP_LIQ, minval=0.1, maxval=3.0, step=0.1)
i_deltaWeight       = input.float(2.5,   "Counter-Flow Response Weight",          group=GRP_LIQ, minval=0.1, maxval=5.0, step=0.1, tooltip="Adds score when footprint delta opposes the expected attack direction while price tests a tracked level. This is contextual evidence, not proof of absorption.")
i_decayBars         = input.int(200,     "Time Decay Period (Bars)",              group=GRP_LIQ, minval=50, maxval=1000)
i_showSweptLevels   = input.bool(false,  "Show Swept Levels (Dimmed)",            group=GRP_LIQ)
i_showPOC           = input.bool(true,   "Show POC Line Per Bar",                 group=GRP_LIQ, tooltip="Draws the Point of Control from footprint data.")
i_bslColor           = input.color(color.new(#00e5ff, 20), "BSL Level Color (Above)", group=GRP_LIQ)
i_sslColor           = input.color(color.new(#ff1744, 20), "SSL Level Color (Below)", group=GRP_LIQ)
i_pocColor          = input.color(color.new(#ff9800, 40), "POC Color",            group=GRP_LIQ)

// ── [M1] Magnet Lines ──
i_magnetEnabled     = input.bool(true,   "Enable Magnet Lines",                   group=GRP_MAGNET)
i_magnetCount       = input.int(3,       "Number of Magnet Targets",              group=GRP_MAGNET, minval=1, maxval=9)
i_magnetStyle       = input.string("Solid", "Magnet Line Style",                  group=GRP_MAGNET, options=["Solid", "Dashed", "Dotted"])
i_magnetColor       = input.color(color.new(#ffd740, 0), "Magnet Line Color",     group=GRP_MAGNET)

// ── [M2] Auction Cycle Engine ──
i_amdEnabled        = input.bool(true,   "Enable Auction Cycle Model",            group=GRP_AMD)
i_accumDeltaThresh  = input.float(0.15,  "Balanced Delta Ratio Threshold",       group=GRP_AMD, minval=0.01, maxval=0.5, step=0.01, tooltip="Absolute delta divided by total footprint volume below this value is classified as balanced activity. Lower values are stricter.")
i_accumVolMult      = input.float(1.0,   "Balanced Activity Min Volume",         group=GRP_AMD, minval=0.5, maxval=3.0, step=0.1, tooltip="Footprint volume must exceed this multiple of its average before balanced activity can qualify.")
i_accumMinBars      = input.int(8,       "Minimum Balanced Bars",                 group=GRP_AMD, minval=3, maxval=30)
i_oneSidedDeltaThresh = input.float(0.5, "One-Sided Delta Ratio Threshold",      group=GRP_AMD, minval=0.2, maxval=0.9, step=0.05, tooltip="Absolute delta divided by total footprint volume above this value is labeled one-sided in the dashboard.")
i_amdBGAlpha        = input.int(92,      "Auction Cycle Background Opacity",               group=GRP_AMD, minval=85, maxval=98)
i_balancedColor     = input.color(#2962ff, "Balanced Activity Color",             group=GRP_AMD)
i_sweepColor        = input.color(#ff6d00, "Sweep Phase Color",                   group=GRP_AMD)
i_expandBullColor   = input.color(#00c853, "Bullish Expansion Color",             group=GRP_AMD)
i_expandBearColor   = input.color(#d50000, "Bearish Expansion Color",             group=GRP_AMD)

// ── [M3] Trap Detection ──
i_trapEnabled       = input.bool(true,   "Enable Trap Detection",                 group=GRP_TRAP)
i_trapMajorOnly     = input.bool(true,   "High-Confluence Responses Only",        group=GRP_TRAP, tooltip="Show trap-response markers only when the range-extreme filter and the required number of supporting factors are satisfied.")
i_trapMinConfl      = input.int(3,       "Min Confluence Factors",                group=GRP_TRAP, minval=2, maxval=6, tooltip="How many factors must stack before showing a trap-response marker.")
i_trapRangeLookback = input.int(50,      "Range Lookback (Bars)",                 group=GRP_TRAP, minval=20, maxval=200, tooltip="How many bars to measure the recent range for extremity filter.")
i_trapExtremePct    = input.float(25.0,  "Extreme Zone % (Top/Bottom)",           group=GRP_TRAP, minval=10.0, maxval=40.0, step=5.0, tooltip="Bullish responses must be in the bottom X% of the recent range; bearish responses must be in the top X%. Lower values are stricter.")
i_trapReclaimBars   = input.int(5,       "Max Bars for Reclaim",                  group=GRP_TRAP, minval=1, maxval=15)
i_reclaimDeltaMult = input.float(1.5,   "Reclaim Delta Multiplier",             group=GRP_TRAP, minval=1.0, maxval=4.0, step=0.1, tooltip="Opposing reclaim delta must exceed average absolute delta by this multiple before a trap response can qualify.")
i_trapCooldown      = input.int(10,      "Trap Cooldown (Bars)",                  group=GRP_TRAP, minval=1, maxval=50, tooltip="Minimum bars between trap signals on the same level. Prevents label stacking.")
i_trapScoreThresh   = input.int(50,      "Min Trap Score to Display",             group=GRP_TRAP, minval=10, maxval=90)
i_trapBullColor     = input.color(color.new(#00e676, 0), "Bullish Trap-Response Color",      group=GRP_TRAP)
i_trapBearColor     = input.color(color.new(#ff5252, 0), "Bearish Trap-Response Color",      group=GRP_TRAP)

// ── [M3b] REVERSAL SIGNALS — Real-time peak/valley detection ──
string GRP_REV      = "═══ [M3b] REVERSAL SIGNALS ═══"
i_revEnabled        = input.bool(true,   "Enable Reversal Signals",               group=GRP_REV)
i_revRangeLookback  = input.int(50,      "Range Lookback (Bars)",                 group=GRP_REV, minval=20, maxval=200)
i_revExtremePct     = input.float(25.0,  "Extreme Zone %",                        group=GRP_REV, minval=10.0, maxval=40.0, step=5.0, tooltip="Price must be in top/bottom X% of range to qualify.")
i_revMinFactors     = input.int(2,       "Min Reversal Factors",                  group=GRP_REV, minval=1, maxval=4, tooltip="How many current-bar factors must align: delta contraction, tracked-level response, POC rejection, and high-volume extreme.")
i_revWickRatio      = input.float(0.5,   "Min Wick Rejection Ratio",             group=GRP_REV, minval=0.3, maxval=0.8, step=0.05, tooltip="Wick must be this proportion of total bar range for rejection signal.")
i_revBullColor      = input.color(color.new(#00e5ff, 0), "Bull Reversal Arrow",   group=GRP_REV)
i_revBearColor      = input.color(color.new(#ff6d00, 0), "Bear Reversal Arrow",   group=GRP_REV)

// ── [M4] Displacement / FVG ──
i_dispEnabled       = input.bool(true,   "Enable Displacement Scanner",           group=GRP_DISP)
i_dispDeltaMult     = input.float(2.0,   "Displacement Delta vs Avg Mult",       group=GRP_DISP, minval=1.0, maxval=5.0, step=0.1, tooltip="Delta exceeding smoothed avg by this multiple = displacement.")
i_dispBodyATR       = input.float(1.2,   "Displacement Min Body (ATR Mult)",     group=GRP_DISP, minval=0.5, maxval=3.0, step=0.1)
i_fvgEnabled        = input.bool(true,   "Show Fair Value Gaps",                  group=GRP_DISP)
i_fvgMidline        = input.bool(true,   "Show FVG 50% Midline",                 group=GRP_DISP)
i_fvgMaxAge         = input.int(100,     "FVG Max Age (Bars)",                    group=GRP_DISP, minval=20, maxval=500)
i_fvgBullColor      = input.color(color.new(#00bcd4, 75), "Bullish FVG",          group=GRP_DISP)
i_fvgBearColor      = input.color(color.new(#e91e63, 75), "Bearish FVG",          group=GRP_DISP)
i_dispBullMarkerColor = input.color(color.new(#00e676, 0), "Bull Displacement Marker", group=GRP_DISP)
i_dispBearMarkerColor = input.color(color.new(#ff5252, 0), "Bear Displacement Marker", group=GRP_DISP)

// ── Sessions & Killzones ──
i_sessEnabled       = input.bool(true,   "Enable Session Context",                group=GRP_SESSION)
i_sessTimezone      = input.string("America/New_York", "Timezone",                group=GRP_SESSION, options=["America/New_York", "America/Chicago", "America/Los_Angeles", "Europe/London", "Asia/Tokyo", "Asia/Hong_Kong", "Australia/Sydney"])
i_asiaSession       = input.session("1800-0000", "Asia Session",                  group=GRP_SESSION)
i_londonKZ          = input.session("0200-0500", "London Killzone",               group=GRP_SESSION)
i_nyKZ              = input.session("0830-1100", "NY Killzone",                   group=GRP_SESSION)
i_nyLunchStart      = input.session("1200-1330", "NY Lunch (Reduced Weight)",     group=GRP_SESSION)
i_sessBoost         = input.float(1.5,   "Active Window Score Multiplier",        group=GRP_SESSION, minval=1.0, maxval=3.0, step=0.1, tooltip="Weights the configured London and New York analysis windows inside model scores. This is a user-defined preference, not a performance guarantee.")

// ── Dashboard ──
i_dashPos           = input.string("Top Right", "Dashboard Position",             group=GRP_DASH, options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])
i_dashSize          = input.string("Small", "Dashboard Size",                    group=GRP_DASH, options=["Small", "Normal", "Large"])
i_dashBGColor       = input.color(color.new(#0a0a14, 15), "Dashboard Background", group=GRP_DASH)
i_dashTextColor     = input.color(color.new(#e0e0e0, 0), "Dashboard Text Color",  group=GRP_DASH)

// ── Execution Panel ──
string GRP_EXEC     = "═══ EXECUTION PANEL ═══"
i_execEnabled       = input.bool(true,   "Enable Execution Panel",                group=GRP_EXEC)
i_execPos           = input.string("Bottom Right", "Execution Panel Position",     group=GRP_EXEC, options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])
i_execSweepWindow   = input.int(20,      "Sweep Freshness Window (Bars)",         group=GRP_EXEC, minval=5, maxval=50, tooltip="Sweep must be within this many bars to score as fresh.")
i_execMinScore      = input.int(60,      "Min Score for QUALIFIED State",         group=GRP_EXEC, minval=30, maxval=90, tooltip="Minimum internal setup score required before the panel can display a qualified directional state.")

// ── Alerts ──
i_alertTrap         = input.bool(true,   "Alert on Qualifying Trap Response",     group=GRP_ALERTS)
i_alertDisp         = input.bool(true,   "Alert on Displacement Candle",          group=GRP_ALERTS)
i_alertAMD          = input.bool(true,   "Alert on Auction Cycle Change",       group=GRP_ALERTS)
i_alertSweep        = input.bool(true,   "Alert on Liquidity Sweep",              group=GRP_ALERTS)
i_alertHighDeltaRejection = input.bool(true, "Alert on High-Delta Rejection",          group=GRP_ALERTS)


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │                     SECTION 2: USER-DEFINED TYPES                          │
// └─────────────────────────────────────────────────────────────────────────────┘

type LiquidityLevel
    float price
    int   touches
    int   firstBar
    int   lastBar
    bool  isAbove           // Above price = buy-side liquidity (BSL); below = sell-side liquidity (SSL)
    bool  isSwept
    int   sweptBar
    float score
    bool  isHTF
    bool  hasKeyConfl       // Confluence with PDH/PDL/PWH/PWL/round number
    float counterFlowScore  // Relative counter-flow response observed while price tested this level
    bool  trapFired         // Has a trap already fired for this swept level?
    int   trapFiredBar      // Bar index when trap last fired (for cooldown)
    line  drawLine
    label drawLabel

type FVGZone
    float top
    float bottom
    float mid
    bool  isBullish
    int   startBar
    bool  isFilled
    float fillPct
    float quality           // Footprint-based displacement quality
    float deltaStrength     // Absolute delta of the displacement candle
    box   drawBox
    line  drawMid

type TrapEvent
    int   bar
    float level
    bool  isBullishResponse
    int   score
    float sweepDelta        // Delta on the sweep bar
    float reclaimDelta      // Counter-delta on the reclaim bar
    label drawLabel


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │              SECTION 3: FOOTPRINT CORE + GLOBAL UTILITIES                  │
// └─────────────────────────────────────────────────────────────────────────────┘

// ═══ FOOTPRINT REQUEST — Core footprint data source ═══
footprint g_fp = request.footprint(i_fpTickSize, i_fpVAPct)
bool g_fpValid = not na(g_fp)

// ── Extract Footprint Metrics (safe — na when no data) ──
float g_buyVol    = g_fpValid ? g_fp.buy_volume()  : na
float g_sellVol   = g_fpValid ? g_fp.sell_volume() : na
float g_delta     = g_fpValid ? g_fp.delta()       : na
float g_totalVol  = g_fpValid ? g_fp.total_volume(): na

// ── POC / VAH / VAL ──
volume_row g_pocRow = g_fpValid ? g_fp.poc() : na
volume_row g_vahRow = g_fpValid ? g_fp.vah() : na
volume_row g_valRow = g_fpValid ? g_fp.val() : na

float g_pocPrice  = not na(g_pocRow) ? (g_pocRow.up_price() + g_pocRow.down_price()) / 2.0 : na
float g_vahPrice  = not na(g_vahRow) ? g_vahRow.up_price()   : na
float g_valPrice  = not na(g_valRow) ? g_valRow.down_price() : na

// ── Derived Metrics ──
float g_deltaRatio    = g_totalVol > 0 ? math.abs(g_delta) / g_totalVol : 0.0  // 0 = balanced, 1 = one-sided
float g_absDelta      = math.abs(nz(g_delta, 0.0))

// ── Smoothed References ──
float g_atr           = ta.atr(i_atrLen)
float g_avgDelta      = ta.sma(g_absDelta, i_fpDeltaSmoothLen)
float g_avgTotalVol   = ta.sma(nz(g_totalVol, 0.0), 20)
float g_smoothDelta   = ta.sma(nz(g_delta, 0.0), i_fpDeltaSmoothLen)

// ── Candle Basics (still needed for FVG geometry) ──
float g_bodySize      = math.abs(close - open)
bool  g_isBullCandle  = close > open
bool  g_isBearCandle  = close < open

// ── Session Detection ──
f_inSession(_sess) =>
    not na(time(timeframe.period, _sess, i_sessTimezone))

bool g_inAsia     = i_sessEnabled ? f_inSession(i_asiaSession)   : false
bool g_inLondonKZ = i_sessEnabled ? f_inSession(i_londonKZ)      : false
bool g_inNYKZ     = i_sessEnabled ? f_inSession(i_nyKZ)          : false
bool g_inLunch    = i_sessEnabled ? f_inSession(i_nyLunchStart)  : false
bool g_inKillzone = g_inLondonKZ or g_inNYKZ

string g_sessionLabel = g_inLondonKZ ? "LDN KZ" : g_inNYKZ ? "NY KZ" : g_inAsia ? "ASIA" : g_inLunch ? "LUNCH" : "RTH"

// ── Key Levels: PDH/PDL/PWH/PWL (global scope) ──
float g_pdh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_on)
float g_pdl = request.security(syminfo.tickerid, "D", low[1],  barmerge.gaps_off, barmerge.lookahead_on)
float g_pwh = request.security(syminfo.tickerid, "W", high[1], barmerge.gaps_off, barmerge.lookahead_on)
float g_pwl = request.security(syminfo.tickerid, "W", low[1],  barmerge.gaps_off, barmerge.lookahead_on)

f_keyLevel(_price, _atr) =>
    float threshold = _atr * 0.2
    bool nearKey = math.abs(_price - g_pdh) < threshold or math.abs(_price - g_pdl) < threshold or math.abs(_price - g_pwh) < threshold or math.abs(_price - g_pwl) < threshold
    float roundInterval = syminfo.mintick >= 1 ? 100.0 : syminfo.mintick >= 0.01 ? 1.0 : 0.001
    bool nearRound = math.abs(_price - math.round(_price / roundInterval) * roundInterval) < threshold
    nearKey or nearRound

f_sessionMult() =>
    g_inKillzone ? i_sessBoost : g_inLunch ? 0.5 : 1.0

f_lineStyle(_style) =>
    switch _style
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

f_dashPosition() =>
    switch i_dashPos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

f_execPosition() =>
    switch i_execPos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

f_dashTextSize() =>
    switch i_dashSize
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.normal

// ── Pivot Detection (still useful for structural levels) ──
float g_pivotHigh = ta.pivothigh(high, i_pivotLen, i_pivotLen)
float g_pivotLow  = ta.pivotlow(low,   i_pivotLen, i_pivotLen)

// ── HTF Pivots ──
float g_htfPH = i_htfEnabled ? request.security(syminfo.tickerid, i_htfTF, ta.pivothigh(high, i_pivotLen, i_pivotLen), barmerge.gaps_off, barmerge.lookahead_off) : na
float g_htfPL = i_htfEnabled ? request.security(syminfo.tickerid, i_htfTF, ta.pivotlow(low, i_pivotLen, i_pivotLen),   barmerge.gaps_off, barmerge.lookahead_off) : na


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │           SECTION 4: [M1] LIQUIDITY POOL MAPPER + MAGNET LINES             │
// └─────────────────────────────────────────────────────────────────────────────┘

var array<LiquidityLevel> g_liqLevels = array.new<LiquidityLevel>()

// ── Relative Level Score Calculation ──
f_calcLiqScore(_lvl) =>
    int   age         = bar_index - _lvl.firstBar
    float decayFactor = age < i_decayBars ? 1.0 : math.max(0.1, 1.0 - (age - i_decayBars) / float(i_decayBars))
    float touchScore  = math.min(_lvl.touches, 8) * i_touchWeight
    float recencyNorm = math.max(0.0, 1.0 - (bar_index - _lvl.lastBar) / float(i_decayBars))
    float recencyScore = recencyNorm * 5.0 * i_recencyWeight
    float conflScore   = _lvl.hasKeyConfl ? 5.0 * i_conflWeight : 0.0
    float htfBonus     = _lvl.isHTF ? 3.0 : 0.0
    // Footprint bonus: opposing flow during a level test increases the contextual score.
    float counterFlowBonus = math.min(10.0, _lvl.counterFlowScore * i_deltaWeight)
    (touchScore + recencyScore + conflScore + htfBonus + counterFlowBonus) * decayFactor

// ── Cluster Check ──
f_findCluster(_price) =>
    int result = -1
    float threshold = g_atr * i_clusterATR
    if array.size(g_liqLevels) > 0
        for i = 0 to array.size(g_liqLevels) - 1
            LiquidityLevel lvl = array.get(g_liqLevels, i)
            if not lvl.isSwept and math.abs(lvl.price - _price) < threshold
                result := i
                break
    result

// ── Counter-Flow Response at a Tracked Level ──
// Above-price BSL is normally approached by upward buying pressure; negative delta
// during the test is an opposing-flow response. Below-price SSL is normally approached
// by downward selling pressure; positive delta during the test is an opposing response.
// This calculation does not identify a participant or prove absorption.
f_counterFlowAtLevel(_price, _isAbove) =>
    float responseScore = 0.0
    if g_fpValid and g_totalVol > 0 and low <= _price and high >= _price
        bool opposingFlow = (_isAbove and g_delta < 0) or (not _isAbove and g_delta > 0)
        if opposingFlow
            responseScore := g_absDelta / math.max(g_avgDelta, 1.0)
    responseScore

// ── Add or Update Liquidity Level ──
f_processNewPivot(_price, _isHTF) =>
    bool _done = false
    if not na(_price) and not na(g_atr) and g_atr > 0
        int clusterIdx = f_findCluster(_price)
        if clusterIdx >= 0
            LiquidityLevel lvl = array.get(g_liqLevels, clusterIdx)
            lvl.touches  += 1
            lvl.lastBar   := bar_index
            lvl.price     := (lvl.price * (lvl.touches - 1) + _price) / lvl.touches
            lvl.isAbove   := lvl.price > close
            lvl.hasKeyConfl := lvl.hasKeyConfl or f_keyLevel(lvl.price, g_atr)
            // Retain the strongest observed counter-flow response at this level
            float absVal = f_counterFlowAtLevel(lvl.price, lvl.isAbove)
            lvl.counterFlowScore := math.max(lvl.counterFlowScore, absVal)
            lvl.score     := f_calcLiqScore(lvl)
            _done := true
        else
            LiquidityLevel newLvl = LiquidityLevel.new()
            newLvl.price           := _price
            newLvl.touches         := 1
            newLvl.firstBar        := bar_index
            newLvl.lastBar         := bar_index
            newLvl.isAbove         := _price > close
            newLvl.isSwept         := false
            newLvl.sweptBar        := 0
            newLvl.isHTF           := _isHTF
            newLvl.hasKeyConfl     := f_keyLevel(_price, g_atr)
            newLvl.counterFlowScore := f_counterFlowAtLevel(_price, _price > close)
            newLvl.trapFired       := false
            newLvl.trapFiredBar    := 0
            newLvl.score           := f_calcLiqScore(newLvl)
            newLvl.drawLine        := na
            newLvl.drawLabel       := na
            array.push(g_liqLevels, newLvl)
            if array.size(g_liqLevels) > i_maxLevels
                LiquidityLevel oldest = array.shift(g_liqLevels)
                if not na(oldest.drawLine)
                    line.delete(oldest.drawLine)
                if not na(oldest.drawLabel)
                    label.delete(oldest.drawLabel)
            _done := true
    _done

// ── Sweep Detection: Now with footprint delta context ──
f_checkSweeps() =>
    bool  anySweep   = false
    float sweepPrice = na
    bool  sweepBull  = false
    float sweepDelta = na
    if array.size(g_liqLevels) > 0
        for i = array.size(g_liqLevels) - 1 to 0
            LiquidityLevel lvl = array.get(g_liqLevels, i)
            if not lvl.isSwept
                // SSL sweep: price trades below a below-price liquidity level and closes back above
                if not lvl.isAbove and low <= lvl.price and close > lvl.price and close[1] > lvl.price
                    lvl.isSwept  := true
                    lvl.sweptBar := bar_index
                    anySweep     := true
                    sweepPrice   := lvl.price
                    sweepBull    := true   // Below-level sweep and bullish reclaim condition
                    sweepDelta   := nz(g_delta, 0.0)
                // BSL sweep: price trades above an above-price liquidity level and closes back below
                else if lvl.isAbove and high >= lvl.price and close < lvl.price and close[1] < lvl.price
                    lvl.isSwept  := true
                    lvl.sweptBar := bar_index
                    anySweep     := true
                    sweepPrice   := lvl.price
                    sweepBull    := false
                    sweepDelta   := nz(g_delta, 0.0)
                lvl.isAbove := lvl.price > close
                // Update counter-flow evidence on each touch
                if g_fpValid and low <= lvl.price and high >= lvl.price
                    float absVal = f_counterFlowAtLevel(lvl.price, lvl.isAbove)
                    lvl.counterFlowScore := math.max(lvl.counterFlowScore, absVal)
                lvl.score := f_calcLiqScore(lvl)
    [anySweep, sweepPrice, sweepBull, sweepDelta]

// ── Process Pivots ──
if i_liqEnabled
    f_processNewPivot(g_pivotHigh, false)
    f_processNewPivot(g_pivotLow,  false)
    if i_htfEnabled
        if not na(g_htfPH) and (na(g_htfPH[1]) or g_htfPH != g_htfPH[1])
            f_processNewPivot(g_htfPH, true)
        if not na(g_htfPL) and (na(g_htfPL[1]) or g_htfPL != g_htfPL[1])
            f_processNewPivot(g_htfPL, true)

// ── Run Sweep Detection ──
[g_anySweep, g_sweepPrice, g_sweepBull, g_sweepDelta] = f_checkSweeps()

// ── Sort by Score ──
f_sortLevelsByScore() =>
    int sz = array.size(g_liqLevels)
    if sz > 1
        for i = 0 to sz - 2
            for j = 0 to sz - i - 2
                LiquidityLevel a = array.get(g_liqLevels, j)
                LiquidityLevel b = array.get(g_liqLevels, j + 1)
                if b.score > a.score
                    array.set(g_liqLevels, j, b)
                    array.set(g_liqLevels, j + 1, a)
    true

if i_liqEnabled and barstate.islast
    f_sortLevelsByScore()

// ── POC Dots (highest-volume footprint row for the bar) ──
plot(i_liqEnabled and i_showPOC and i_showClean ? g_pocPrice : na, "POC", color=i_pocColor, style=plot.style_circles, linewidth=2)

// ── Value Area Zone (VAH/VAL shaded region) ──
float g_vahPlot = i_liqEnabled and i_showClean and not na(g_vahPrice) ? g_vahPrice : na
float g_valPlot = i_liqEnabled and i_showClean and not na(g_valPrice) ? g_valPrice : na
p_vah = plot(g_vahPlot, "VAH", color=color.new(#ff9800, 85), display=display.all)
p_val = plot(g_valPlot, "VAL", color=color.new(#ff9800, 85), display=display.all)
fill(p_vah, p_val, color=color.new(#ff9800, 93), title="Value Area Fill")

// ── Session Killzone Background ──
color g_kzBG = i_sessEnabled and i_showClean ? (g_inLondonKZ ? color.new(#2196f3, 95) : g_inNYKZ ? color.new(#ff9800, 95) : na) : na
bgcolor(g_kzBG, title="Killzone Background")

// ── Draw Liquidity Levels + Magnets ──
if i_liqEnabled and barstate.islast and i_showClean
    int sz = array.size(g_liqLevels)
    int magnetCount = 0
    if sz > 0
        for i = 0 to sz - 1
            LiquidityLevel lvl = array.get(g_liqLevels, i)
            if not na(lvl.drawLine)
                line.delete(lvl.drawLine)
            if not na(lvl.drawLabel)
                label.delete(lvl.drawLabel)
            if lvl.isSwept and not i_showSweptLevels
                continue
            bool isMagnet = i_magnetEnabled and not lvl.isSwept and magnetCount < i_magnetCount
            if isMagnet
                magnetCount += 1
            color lineCol     = lvl.isSwept ? color.new(color.gray, 70) : lvl.isAbove ? i_bslColor : i_sslColor
            int   lineWidth   = isMagnet ? 3 : lvl.isHTF ? 2 : 1
            string lineStyle  = lvl.isSwept ? line.style_dotted : isMagnet ? f_lineStyle(i_magnetStyle) : line.style_dashed
            color finalCol    = isMagnet ? i_magnetColor : lineCol
            int startBI       = math.max(0, bar_index - 60)
            lvl.drawLine := line.new(startBI, lvl.price, bar_index + 15, lvl.price, color=finalCol, width=lineWidth, style=lineStyle)
            // Label includes counter-flow tag, direction arrow, and hover tooltip
            string responseTag = lvl.counterFlowScore > 1.0 ? " CF" : ""
            string dirArrow = lvl.isAbove ? "↑" : "↓"
            string lblText = (isMagnet ? "◆ " + dirArrow + " " : lvl.isHTF ? "HTF " : "") + (lvl.isAbove ? "BSL " : "SSL ") + str.tostring(lvl.touches) + "x" + responseTag
            if lvl.isSwept
                lblText := "✗ SWEPT"
            string lvlTip = (lvl.isAbove ? "Buy-Side Liquidity (above)" : "Sell-Side Liquidity (below)") + "\nPrice: " + str.tostring(lvl.price, format.mintick) + "\nTouches: " + str.tostring(lvl.touches) + "\nLevel Score: " + str.tostring(lvl.score, "#.#") + "\nCounter-Flow Score: " + str.tostring(lvl.counterFlowScore, "#.##") + (lvl.hasKeyConfl ? "\n★ Key Level Confluence" : "") + (lvl.isHTF ? "\n★ HTF Level" : "")
            lvl.drawLabel := label.new(bar_index + 16, lvl.price, lblText, style=label.style_label_left, color=color.new(color.black, 100), textcolor=finalCol, size=size.tiny, tooltip=lvlTip)


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │              SECTION 5: [M2] AUCTION CYCLE STATE MODEL                     │
// │              Rule-based footprint and structure classification             │
// └─────────────────────────────────────────────────────────────────────────────┘

// States: 0 = NEUTRAL, 1 = BALANCED_ACTIVITY, 2 = SWEEP_PHASE,
//         3 = BULL_EXPANSION, 4 = BEAR_EXPANSION
var int g_amdState     = 0
var int g_amdStateBars = 0
var int g_prevAmdState = 0

// Balanced activity: limited delta dominance while total footprint volume is active.
bool g_isBalancedActivity = g_fpValid and g_deltaRatio < i_accumDeltaThresh and nz(g_totalVol, 0.0) > g_avgTotalVol * i_accumVolMult

// Directional displacement: absolute delta exceeds its smoothed reference and
// the candle body exceeds the configured ATR multiple.
bool g_isRealDisplacement = g_fpValid and g_avgDelta > 0 and g_absDelta > g_avgDelta * i_dispDeltaMult and g_bodySize > g_atr * i_dispBodyATR
bool g_isBullDisp = g_isRealDisplacement and nz(g_delta, 0.0) > 0
bool g_isBearDisp = g_isRealDisplacement and nz(g_delta, 0.0) < 0

if i_amdEnabled
    g_prevAmdState := g_amdState
    g_amdStateBars += 1
    switch g_amdState
        0 =>  // NEUTRAL → BALANCED ACTIVITY
            if g_isBalancedActivity
                g_amdState     := 1
                g_amdStateBars := 0
        1 =>  // BALANCED ACTIVITY → SWEEP PHASE or DIRECT EXPANSION
            if g_anySweep and g_amdStateBars >= i_accumMinBars
                g_amdState     := 2
                g_amdStateBars := 0
            else if g_isBullDisp and g_amdStateBars >= i_accumMinBars
                g_amdState     := 3
                g_amdStateBars := 0
            else if g_isBearDisp and g_amdStateBars >= i_accumMinBars
                g_amdState     := 4
                g_amdStateBars := 0
            else if not g_isBalancedActivity and g_amdStateBars > i_accumMinBars * 3
                g_amdState     := 0
                g_amdStateBars := 0
        2 =>  // SWEEP PHASE → DIRECTIONAL EXPANSION
            if g_isBullDisp
                g_amdState     := 3
                g_amdStateBars := 0
            else if g_isBearDisp
                g_amdState     := 4
                g_amdStateBars := 0
            else if g_amdStateBars > 12
                g_amdState     := 0
                g_amdStateBars := 0
        3 =>  // BULL EXPANSION → BALANCED, OPPOSITE EXPANSION, OR RESET
            if g_isBalancedActivity and g_amdStateBars > 5
                g_amdState     := 1
                g_amdStateBars := 0
            else if g_isBearDisp
                g_amdState     := 4
                g_amdStateBars := 0
            else if g_amdStateBars > 30
                g_amdState     := 0
                g_amdStateBars := 0
        4 =>  // BEAR EXPANSION → BALANCED, OPPOSITE EXPANSION, OR RESET
            if g_isBalancedActivity and g_amdStateBars > 5
                g_amdState     := 1
                g_amdStateBars := 0
            else if g_isBullDisp
                g_amdState     := 3
                g_amdStateBars := 0
            else if g_amdStateBars > 30
                g_amdState     := 0
                g_amdStateBars := 0

string g_amdLabel = switch g_amdState
    0 => "NEUTRAL"
    1 => "BALANCED ACTIVITY"
    2 => "SWEEP PHASE"
    3 => "EXPANSION ▲"
    4 => "EXPANSION ▼"
    => "—"

bool g_amdChanged = g_amdState != g_prevAmdState

color g_amdBG = switch g_amdState
    1 => color.new(i_balancedColor, i_amdBGAlpha)
    2 => color.new(i_sweepColor, i_amdBGAlpha)
    3 => color.new(i_expandBullColor, i_amdBGAlpha)
    4 => color.new(i_expandBearColor, i_amdBGAlpha)
    => na

bgcolor(i_amdEnabled and i_showClean ? g_amdBG : na, title="Auction Cycle Background")


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │         SECTION 6: [M3] TRAP DETECTION — RECLAIM RESPONSE SCORING         │
// │         v2.3: Dedup cooldown — one response per level per sweep event       │
// └─────────────────────────────────────────────────────────────────────────────┘

var array<TrapEvent> g_traps = array.new<TrapEvent>()

// ── Per-bar trap state (non-persistent — resets each bar) ──
int   g_lastTrapScore = 0
bool  g_lastTrapBull  = false
bool  g_lastTrapKeyLvl = false    // Was this trap at a key level (PDH/PDL/PWH/PWL)?
bool  g_lastTrapHTF    = false    // Was this an HTF level?
bool  g_lastTrapCounterFlow = false // Did the level retain counter-flow evidence?

// ── Persistent memory for dashboard context ──
var int   g_recentTrapScore    = 0      // Most recent qualifying trap-response score
var bool  g_recentTrapBull     = false
var int   g_recentTrapBar      = 0      // Bar when the recent response fired
var float g_lastSweepPrice   = na     // Most recent sweep price (persists)
var bool  g_lastSweepBull    = false
var int   g_lastSweepBar     = 0
var float g_lastSweepDeltaMem = na

// ── Update persistent sweep memory ──
if g_anySweep
    g_lastSweepPrice    := g_sweepPrice
    g_lastSweepBull     := g_sweepBull
    g_lastSweepBar      := bar_index
    g_lastSweepDeltaMem := g_sweepDelta

// ── Trap Score: footprint delta reversal and reclaim context ──
f_trapScoreFP(_sweepDelta, _reclaimDelta, _reclaimSpeed, _levelScore, _inKillzone) =>
    // Delta reversal component: 0-35
    float deltaRev = 0.0
    if (_sweepDelta > 0 and _reclaimDelta < 0) or (_sweepDelta < 0 and _reclaimDelta > 0)
        float revMagnitude = math.abs(_reclaimDelta) / math.max(math.abs(_sweepDelta), 1.0)
        deltaRev := math.min(35.0, revMagnitude * 20.0)
    // Reclaim-delta magnitude: 0-30
    float reclaimMag = g_avgDelta > 0 ? math.abs(_reclaimDelta) / g_avgDelta : 0.0
    float reclaimScore = math.min(30.0, reclaimMag * 15.0)
    // Speed: 0-15
    float speedScore = math.min(15.0, (1.0 - _reclaimSpeed / i_trapReclaimBars) * 15.0)
    // Level quality: 0-10
    float levelQual = math.min(10.0, _levelScore / 3.0)
    // Killzone bonus: 0-10
    float kzBonus = _inKillzone ? 10.0 : 0.0
    int finalScore = int(math.min(100, deltaRev + reclaimScore + speedScore + levelQual + kzBonus))
    finalScore

// ── Detect Traps (with dedup) ──
if i_trapEnabled and array.size(g_liqLevels) > 0 and g_fpValid
    for i = 0 to array.size(g_liqLevels) - 1
        LiquidityLevel lvl = array.get(g_liqLevels, i)
        if lvl.isSwept and (bar_index - lvl.sweptBar) <= i_trapReclaimBars and (bar_index - lvl.sweptBar) >= 1
            // ── DEDUP CHECK: Skip if trap already fired for this level within cooldown ──
            if lvl.trapFired and (bar_index - lvl.trapFiredBar) < i_trapCooldown
                continue
            int barsAgo = bar_index - lvl.sweptBar
            bool bullishReclaim = not lvl.isAbove and close > lvl.price
            bool bearishReclaim = lvl.isAbove and close < lvl.price
            if bullishReclaim or bearishReclaim
                float sweepD   = nz(g_delta[barsAgo], 0.0)
                float reclaimD = nz(g_delta, 0.0)
                bool deltaReversed = (sweepD < 0 and reclaimD > 0) or (sweepD > 0 and reclaimD < 0)
                bool reclaimDeltaStrong = g_avgDelta > 0 and math.abs(reclaimD) >= g_avgDelta * i_reclaimDeltaMult
                if deltaReversed and reclaimDeltaStrong
                    int score = f_trapScoreFP(sweepD, reclaimD, float(barsAgo), lvl.score, g_inKillzone)
                    if score >= i_trapScoreThresh and score > g_lastTrapScore
                        g_lastTrapScore       := score
                        g_lastTrapBull        := bullishReclaim
                        g_lastTrapKeyLvl      := lvl.hasKeyConfl
                        g_lastTrapHTF         := lvl.isHTF
                        g_lastTrapCounterFlow := lvl.counterFlowScore > 1.0
                        // Mark this level as processed for the configured cooldown.
                        lvl.trapFired    := true
                        lvl.trapFiredBar := bar_index
                        // Store the event with corrected directional state.
                        TrapEvent trap        = TrapEvent.new()
                        trap.bar              := bar_index
                        trap.level            := lvl.price
                        trap.isBullishResponse := bullishReclaim
                        trap.score            := score
                        trap.sweepDelta       := sweepD
                        trap.reclaimDelta     := reclaimD
                        trap.drawLabel        := na
                        array.push(g_traps, trap)
                        if array.size(g_traps) > 20
                            TrapEvent old = array.shift(g_traps)
                            if not na(old.drawLabel)
                                label.delete(old.drawLabel)
                        // Retain the latest qualifying response for dashboard context.
                        g_recentTrapScore := score
                        g_recentTrapBull  := bullishReclaim
                        g_recentTrapBar   := bar_index

// ── Decay recent trap-response memory after 20 bars ──
if g_recentTrapScore > 0 and (bar_index - g_recentTrapBar) > 20
    g_recentTrapScore := 0

// ── Range Extremity Data (global scope for reliable series) ──
float g_rangeHigh = ta.highest(high, math.max(i_trapRangeLookback, i_revRangeLookback))
float g_rangeLow  = ta.lowest(low, math.max(i_trapRangeLookback, i_revRangeLookback))
float g_rangeSize = g_rangeHigh - g_rangeLow

// ── Draw Trap-Response Indicators — subtle confirmation dots ──
if i_trapEnabled and i_showClean and g_lastTrapScore >= i_trapScoreThresh
    float extremeAmt = g_rangeSize * (i_trapExtremePct / 100.0)
    bool atExtreme = false
    if g_lastTrapBull and close <= (g_rangeLow + extremeAmt)
        atExtreme := true
    else if not g_lastTrapBull and close >= (g_rangeHigh - extremeAmt)
        atExtreme := true
    // Confluence count
    int conflCount = 0
    if g_lastTrapScore >= 70
        conflCount += 1
    if g_lastTrapKeyLvl
        conflCount += 1
    if g_inKillzone
        conflCount += 1
    bool cf_zone = (g_lastTrapBull and not na(g_valPrice) and close < g_valPrice) or (not g_lastTrapBull and not na(g_vahPrice) and close > g_vahPrice)
    if cf_zone
        conflCount += 1
    if g_lastTrapHTF
        conflCount += 1
    if g_lastTrapCounterFlow
        conflCount += 1
    bool showDot = not i_trapMajorOnly or (atExtreme and conflCount >= i_trapMinConfl)
    if showDot
        color dotCol = g_lastTrapBull ? color.new(i_trapBullColor, 30) : color.new(i_trapBearColor, 30)
        string dotTip = "TRAP RESPONSE " + str.tostring(g_lastTrapScore) + "/100 " + (g_lastTrapBull ? "BULLISH" : "BEARISH") + " | Δ: " + str.tostring(nz(g_delta, 0.0), "#") + " | " + str.tostring(conflCount) + "/6 factors"
        label trapMarker = label.new(bar_index, g_lastTrapBull ? low - g_atr * 0.15 : high + g_atr * 0.15, "•", style=label.style_none, textcolor=dotCol, size=size.tiny, tooltip=dotTip)
        if array.size(g_traps) > 0
            TrapEvent latestTrap = array.get(g_traps, array.size(g_traps) - 1)
            if latestTrap.bar == bar_index
                latestTrap.drawLabel := trapMarker


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │       SECTION 6b: CURRENT-BAR REVERSAL-CONDITION ENGINE                    │
// │       Uses current footprint and price-response factors; values are live.  │
// └─────────────────────────────────────────────────────────────────────────────┘

float g_revRangeHigh  = ta.highest(high, i_revRangeLookback)
float g_revRangeLow   = ta.lowest(low, i_revRangeLookback)
float g_revRangeSize  = g_revRangeHigh - g_revRangeLow
float g_revExtremeAmt = g_revRangeSize * (i_revExtremePct / 100.0)

bool g_atBottomExtreme = close <= (g_revRangeLow + g_revExtremeAmt) and g_revRangeSize > 0
bool g_atTopExtreme    = close >= (g_revRangeHigh - g_revExtremeAmt) and g_revRangeSize > 0

float g_barRange   = high - low
float g_upperWick  = high - math.max(open, close)
float g_lowerWick  = math.min(open, close) - low
float g_upperWickR = g_barRange > 0 ? g_upperWick / g_barRange : 0.0
float g_lowerWickR = g_barRange > 0 ? g_lowerWick / g_barRange : 0.0

int g_bullRevFactors = 0

// Factor 1: negative delta remains present but its magnitude contracts while
// price prints a qualifying lower-wick response.
bool g_bullDeltaExhaust = g_fpValid and nz(g_delta, 0.0) < 0 and nz(g_delta[1], 0.0) < 0 and math.abs(nz(g_delta, 0.0)) < math.abs(nz(g_delta[1], 0.0)) * 0.7 and g_lowerWickR >= i_revWickRatio
if g_bullDeltaExhaust
    g_bullRevFactors += 1

// Factor 2: price tests unswept below-price SSL and shows either positive delta
// or a qualifying lower-wick response. This is a level-response condition.
bool g_bullLevelResponse = false
if g_fpValid and array.size(g_liqLevels) > 0
    for i = 0 to array.size(g_liqLevels) - 1
        LiquidityLevel lvl = array.get(g_liqLevels, i)
        if not lvl.isSwept and not lvl.isAbove and low <= lvl.price and high >= lvl.price
            if nz(g_delta, 0.0) > 0 or g_lowerWickR >= i_revWickRatio
                g_bullLevelResponse := true
                break
if g_bullLevelResponse
    g_bullRevFactors += 1

// Factor 3: POC is in the lower portion of the bar while price closes above the midpoint.
bool g_bullPOCReject = false
if not na(g_pocPrice) and g_barRange > 0
    float pocPosInBar = (g_pocPrice - low) / g_barRange
    float closePosInBar = (close - low) / g_barRange
    if pocPosInBar < 0.35 and closePosInBar > 0.5
        g_bullPOCReject := true
if g_bullPOCReject
    g_bullRevFactors += 1

// Factor 4: unusually high footprint volume with negative delta.
bool g_bullVolClimax = g_fpValid and g_avgTotalVol > 0 and nz(g_totalVol, 0.0) > g_avgTotalVol * 2.0 and nz(g_delta, 0.0) < 0
if g_bullVolClimax
    g_bullRevFactors += 1

int g_bearRevFactors = 0

bool g_bearDeltaExhaust = g_fpValid and nz(g_delta, 0.0) > 0 and nz(g_delta[1], 0.0) > 0 and math.abs(nz(g_delta, 0.0)) < math.abs(nz(g_delta[1], 0.0)) * 0.7 and g_upperWickR >= i_revWickRatio
if g_bearDeltaExhaust
    g_bearRevFactors += 1

// Price tests unswept above-price BSL and shows either negative delta or a
// qualifying upper-wick response.
bool g_bearLevelResponse = false
if g_fpValid and array.size(g_liqLevels) > 0
    for i = 0 to array.size(g_liqLevels) - 1
        LiquidityLevel lvl = array.get(g_liqLevels, i)
        if not lvl.isSwept and lvl.isAbove and low <= lvl.price and high >= lvl.price
            if nz(g_delta, 0.0) < 0 or g_upperWickR >= i_revWickRatio
                g_bearLevelResponse := true
                break
if g_bearLevelResponse
    g_bearRevFactors += 1

bool g_bearPOCReject = false
if not na(g_pocPrice) and g_barRange > 0
    float pocPosInBar = (g_pocPrice - low) / g_barRange
    float closePosInBar = (close - low) / g_barRange
    if pocPosInBar > 0.65 and closePosInBar < 0.5
        g_bearPOCReject := true
if g_bearPOCReject
    g_bearRevFactors += 1

bool g_bearVolClimax = g_fpValid and g_avgTotalVol > 0 and nz(g_totalVol, 0.0) > g_avgTotalVol * 2.0 and nz(g_delta, 0.0) > 0
if g_bearVolClimax
    g_bearRevFactors += 1

bool g_bullReversal = i_revEnabled and g_atBottomExtreme and g_bullRevFactors >= i_revMinFactors
bool g_bearReversal = i_revEnabled and g_atTopExtreme and g_bearRevFactors >= i_revMinFactors

var int g_lastBullRevBar = na
var int g_lastBearRevBar = na
bool g_bullRevCooled = na(g_lastBullRevBar) or (bar_index - g_lastBullRevBar) > 10
bool g_bearRevCooled = na(g_lastBearRevBar) or (bar_index - g_lastBearRevBar) > 10

bool g_bullReversalEdge = g_bullReversal and g_bullRevCooled
bool g_bearReversalEdge = g_bearReversal and g_bearRevCooled

if g_bullReversalEdge
    g_lastBullRevBar := bar_index
if g_bearReversalEdge
    g_lastBearRevBar := bar_index

if i_revEnabled and i_showClean and g_bullReversalEdge
    float pctPos = g_revRangeSize > 0 ? ((close - g_revRangeLow) / g_revRangeSize) * 100.0 : 50.0
    string revTip = "⚡ BULLISH REVERSAL CONDITION\nFactors: " + str.tostring(g_bullRevFactors) + "/4"
    revTip += (g_bullDeltaExhaust ? "\n✓ Delta Contraction" : "\n✗ Delta Contraction")
    revTip += (g_bullLevelResponse ? "\n✓ Level Response" : "\n✗ Level Response")
    revTip += (g_bullPOCReject ? "\n✓ POC Rejection" : "\n✗ POC Rejection")
    revTip += (g_bullVolClimax ? "\n✓ High-Volume Extreme" : "\n✗ High-Volume Extreme")
    revTip += "\nRange Position: " + str.tostring(pctPos, "#") + "%"
    revTip += "\nΔ: " + str.tostring(nz(g_delta, 0.0), "#") + " | Vol: " + str.tostring(nz(g_totalVol, 0.0), format.volume)
    label.new(bar_index, low - g_atr * 0.4, "▲", style=label.style_none, textcolor=i_revBullColor, size=size.large, tooltip=revTip)

if i_revEnabled and i_showClean and g_bearReversalEdge
    float pctPos = g_revRangeSize > 0 ? ((close - g_revRangeLow) / g_revRangeSize) * 100.0 : 50.0
    string revTip = "⚡ BEARISH REVERSAL CONDITION\nFactors: " + str.tostring(g_bearRevFactors) + "/4"
    revTip += (g_bearDeltaExhaust ? "\n✓ Delta Contraction" : "\n✗ Delta Contraction")
    revTip += (g_bearLevelResponse ? "\n✓ Level Response" : "\n✗ Level Response")
    revTip += (g_bearPOCReject ? "\n✓ POC Rejection" : "\n✗ POC Rejection")
    revTip += (g_bearVolClimax ? "\n✓ High-Volume Extreme" : "\n✗ High-Volume Extreme")
    revTip += "\nRange Position: " + str.tostring(pctPos, "#") + "%"
    revTip += "\nΔ: " + str.tostring(nz(g_delta, 0.0), "#") + " | Vol: " + str.tostring(nz(g_totalVol, 0.0), format.volume)
    label.new(bar_index, high + g_atr * 0.4, "▼", style=label.style_none, textcolor=i_revBearColor, size=size.large, tooltip=revTip)


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │        SECTION 7: [M4] DISPLACEMENT SCANNER + FVG — FOOTPRINT QUALITY      │
// └─────────────────────────────────────────────────────────────────────────────┘

var array<FVGZone> g_fvgs = array.new<FVGZone>()

// ── FVG Quality: evaluates the middle candle that created the three-bar gap ──
f_dispQualityFP() =>
    bool fpValidMid = g_fpValid[1]
    if not fpValidMid
        0.0
    else
        float midRange  = math.max(high[1] - low[1], syminfo.mintick)
        float bodyRatio = math.min(1.0, g_bodySize[1] / midRange)
        float deltaDom  = g_totalVol[1] > 0 ? math.min(1.0, math.abs(g_delta[1]) / g_totalVol[1]) : 0.0
        float deltaMag  = g_avgDelta[1] > 0 ? math.min(3.0, g_absDelta[1] / g_avgDelta[1]) : 0.0
        float pocPos    = 0.0
        if not na(g_pocPrice[1])
            pocPos := g_isBullCandle[1] ? (g_pocPrice[1] - low[1]) / midRange : (high[1] - g_pocPrice[1]) / midRange
            pocPos := math.min(math.max(pocPos, 0.0), 1.0)
        float sessionMultMid = g_inKillzone[1] ? i_sessBoost : g_inLunch[1] ? 0.5 : 1.0
        float quality = bodyRatio * 15.0 + deltaDom * 30.0 + (deltaMag / 3.0) * 30.0 + pocPos * 25.0
        math.min(100.0, math.max(0.0, quality * sessionMultMid))

// Evaluate on every bar so Pine maintains a consistent historical series.
// The value still describes the prior (middle) candle that formed a three-bar FVG.
float g_fvgQualityCandidate = f_dispQualityFP()

// ── Detect New FVGs ──
if i_dispEnabled and i_fvgEnabled and bar_index > 2
    // Bullish FVG
    if low > high[2] and g_isBullCandle[1]
        float gapTop = low
        float gapBot = high[2]
        if gapTop - gapBot > g_atr * 0.05
            FVGZone fvg       = FVGZone.new()
            fvg.top            := gapTop
            fvg.bottom         := gapBot
            fvg.mid            := (gapTop + gapBot) / 2.0
            fvg.isBullish      := true
            fvg.startBar       := bar_index - 1
            fvg.isFilled       := false
            fvg.fillPct        := 0.0
            fvg.quality        := g_fvgQualityCandidate
            fvg.deltaStrength  := nz(g_absDelta[1], 0.0)
            fvg.drawBox        := na
            fvg.drawMid        := na
            array.push(g_fvgs, fvg)
    // Bearish FVG
    if high < low[2] and g_isBearCandle[1]
        float gapTop = low[2]
        float gapBot = high
        if gapTop - gapBot > g_atr * 0.05
            FVGZone fvg       = FVGZone.new()
            fvg.top            := gapTop
            fvg.bottom         := gapBot
            fvg.mid            := (gapTop + gapBot) / 2.0
            fvg.isBullish      := false
            fvg.startBar       := bar_index - 1
            fvg.isFilled       := false
            fvg.fillPct        := 0.0
            fvg.quality        := g_fvgQualityCandidate
            fvg.deltaStrength  := nz(g_absDelta[1], 0.0)
            fvg.drawBox        := na
            fvg.drawMid        := na
            array.push(g_fvgs, fvg)

// ── FVG Fill Tracking ──
if i_dispEnabled and i_fvgEnabled and array.size(g_fvgs) > 0
    for i = array.size(g_fvgs) - 1 to 0
        FVGZone fvg = array.get(g_fvgs, i)
        if not fvg.isFilled
            if fvg.isBullish
                if low <= fvg.mid
                    fvg.fillPct := low <= fvg.bottom ? 100.0 : ((fvg.top - low) / (fvg.top - fvg.bottom)) * 100.0
                if low <= fvg.bottom
                    fvg.isFilled := true
            else
                if high >= fvg.mid
                    fvg.fillPct := high >= fvg.top ? 100.0 : ((high - fvg.bottom) / (fvg.top - fvg.bottom)) * 100.0
                if high >= fvg.top
                    fvg.isFilled := true
        if (bar_index - fvg.startBar) > i_fvgMaxAge or fvg.isFilled
            if not na(fvg.drawBox)
                box.delete(fvg.drawBox)
            if not na(fvg.drawMid)
                line.delete(fvg.drawMid)
            array.remove(g_fvgs, i)

if array.size(g_fvgs) > i_maxDrawings
    FVGZone oldest = array.shift(g_fvgs)
    if not na(oldest.drawBox)
        box.delete(oldest.drawBox)
    if not na(oldest.drawMid)
        line.delete(oldest.drawMid)

// ── Draw FVGs (quality-differentiated) ──
if i_dispEnabled and i_fvgEnabled and i_showClean and barstate.islast and array.size(g_fvgs) > 0
    for i = 0 to array.size(g_fvgs) - 1
        FVGZone fvg = array.get(g_fvgs, i)
        if not na(fvg.drawBox)
            box.delete(fvg.drawBox)
        if not na(fvg.drawMid)
            line.delete(fvg.drawMid)
        color fvgCol = fvg.isBullish ? i_fvgBullColor : i_fvgBearColor
        // Quality scales opacity AND border width
        int alpha = int(math.max(55, 85 - fvg.quality * 0.3))
        int bWidth = fvg.quality > 60.0 ? 2 : 1
        fvg.drawBox := box.new(fvg.startBar, fvg.top, bar_index, fvg.bottom, border_color=color.new(fvgCol, alpha - 20), bgcolor=color.new(fvgCol, alpha), border_width=bWidth, text=fvg.quality > 60.0 ? "★" : "", text_color=color.new(fvgCol, alpha - 30), text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_top)
        if i_fvgMidline
            fvg.drawMid := line.new(fvg.startBar, fvg.mid, bar_index, fvg.mid, color=color.new(fvgCol, alpha - 10), style=line.style_dotted, width=1)

// ── Displacement Markers — Icon with delta tooltip ──
if i_dispEnabled and i_showClean and g_isRealDisplacement
    color dispCol = g_isBullDisp ? i_dispBullMarkerColor : i_dispBearMarkerColor
    string dispTip = (g_isBullDisp ? "BULL" : "BEAR") + " DISPLACEMENT\nΔ: " + str.tostring(nz(g_delta, 0.0), format.volume) + "\nBody: " + str.tostring(g_bodySize / g_atr, "#.##") + " ATR\nPOC: " + str.tostring(nz(g_pocPrice, 0.0), format.mintick)
    label.new(bar_index, g_isBullDisp ? low - g_atr * 0.15 : high + g_atr * 0.15, "◆", style=label.style_none, textcolor=dispCol, size=size.small, tooltip=dispTip)


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │        SHARED COMPUTATIONS — Used by both HUD and Execution Panel           │
// └─────────────────────────────────────────────────────────────────────────────┘

// ── Active liquidity level count ──
int g_activeLevels = 0
if array.size(g_liqLevels) > 0
    for i = 0 to array.size(g_liqLevels) - 1
        if not array.get(g_liqLevels, i).isSwept
            g_activeLevels += 1

// ── FVG counts ──
int g_bullFVGs = 0
int g_bearFVGs = 0
if array.size(g_fvgs) > 0
    for i = 0 to array.size(g_fvgs) - 1
        if array.get(g_fvgs, i).isBullish
            g_bullFVGs += 1
        else
            g_bearFVGs += 1

// ── Top magnet info (highest-scored unswept level) ──
string g_narrMagnet = "—"
// ── Directional magnets (highest-scored unswept level above/below) ──
float  g_magnetAbovePrice = na    // Highest-scored unswept magnet above current price
float  g_magnetBelowPrice = na    // Highest-scored unswept magnet below current price
string g_magnetAboveText  = "—"
string g_magnetBelowText  = "—"
if i_magnetEnabled and array.size(g_liqLevels) > 0
    bool foundTop = false
    for i = 0 to array.size(g_liqLevels) - 1
        LiquidityLevel lvl = array.get(g_liqLevels, i)
        if not lvl.isSwept
            float dist = lvl.price - close
            // First unswept = overall top magnet (for HUD)
            if not foundTop
                g_narrMagnet := "◆ " + str.tostring(lvl.price, format.mintick) + " (" + (dist > 0 ? "+" : "") + str.tostring(dist, format.mintick) + ")"
                foundTop := true
            // Track the highest-scored available level above and below separately
            if lvl.price > close and na(g_magnetAbovePrice)
                g_magnetAbovePrice := lvl.price
                g_magnetAboveText  := "◆ " + str.tostring(lvl.price, format.mintick) + " (+" + str.tostring(lvl.price - close, format.mintick) + ")"
            else if lvl.price < close and na(g_magnetBelowPrice)
                g_magnetBelowPrice := lvl.price
                g_magnetBelowText  := "◆ " + str.tostring(lvl.price, format.mintick) + " (" + str.tostring(lvl.price - close, format.mintick) + ")"

// ── Recent displacement tracking (persistent for exec panel) ──
var bool  g_recentDispBull = false
var int   g_recentDispBar  = na
if g_isBullDisp
    g_recentDispBull := true
    g_recentDispBar  := bar_index
else if g_isBearDisp
    g_recentDispBull := false
    g_recentDispBar  := bar_index


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │                   SECTION 8: NARRATIVE DASHBOARD                           │
// └─────────────────────────────────────────────────────────────────────────────┘

var table g_dashboard = table.new(f_dashPosition(), 2, 13, bgcolor=i_dashBGColor, border_width=1, border_color=color.new(color.white, 85), frame_width=2, frame_color=color.new(#ffd740, 50))
if barstate.isfirst
    table.merge_cells(g_dashboard, 0, 0, 1, 0)
    table.merge_cells(g_dashboard, 0, 12, 1, 12)

if i_showHUD and barstate.islast
    string narrCycle = "Phase: " + g_amdLabel + " (" + str.tostring(g_amdStateBars) + " bars)"

    string narrSweep = "No recent sweep"
    if not na(g_lastSweepPrice)
        int sweepAge = bar_index - g_lastSweepBar
        if sweepAge < 50
            narrSweep := "⚡ " + str.tostring(g_lastSweepPrice, format.mintick) + " Δ" + str.tostring(nz(g_lastSweepDeltaMem, 0.0), "#") + " (" + str.tostring(sweepAge) + " bars ago)"

    string narrFP = g_fpValid ? ("Buy: " + str.tostring(g_buyVol, format.volume) + " | Sell: " + str.tostring(g_sellVol, format.volume) + " | Δ: " + str.tostring(g_delta, format.volume)) : "NO FOOTPRINT DATA"
    color fpCol = not g_fpValid ? color.red : nz(g_delta, 0.0) > 0 ? color.lime : nz(g_delta, 0.0) < 0 ? color.red : i_dashTextColor

    string deltaTrend = g_smoothDelta > g_avgDelta * 0.3 ? " ▲ POSITIVE FLOW" : g_smoothDelta < -g_avgDelta * 0.3 ? " ▼ NEGATIVE FLOW" : ""
    string narrDeltaRegime = "Ratio: " + str.tostring(g_deltaRatio, "#.##") + (g_deltaRatio < i_accumDeltaThresh ? " ◀ BALANCED" : g_deltaRatio > i_oneSidedDeltaThresh ? " ◀ ONE-SIDED" : "") + deltaTrend

    string narrAuction = not na(g_pocPrice) ? ("POC: " + str.tostring(g_pocPrice, format.mintick) + " | VA: " + str.tostring(nz(g_valPrice, 0.0), format.mintick) + " - " + str.tostring(nz(g_vahPrice, 0.0), format.mintick)) : "—"
    string narrMagnet = g_narrMagnet

    string narrTrap = "No recent trap response"
    color trapStatusCol = i_dashTextColor
    if g_recentTrapScore > 0
        int trapAge = bar_index - g_recentTrapBar
        narrTrap := "TRAP " + str.tostring(g_recentTrapScore) + "/100 " + (g_recentTrapBull ? "▲ BULL" : "▼ BEAR") + (trapAge > 0 ? " (" + str.tostring(trapAge) + " bars)" : " NOW")
        trapStatusCol := g_recentTrapScore >= 75 ? color.red : g_recentTrapScore >= 50 ? color.orange : i_dashTextColor

    string narrDisp = g_isBullDisp ? "⬆ BULL DISPLACEMENT" : g_isBearDisp ? "⬇ BEAR DISPLACEMENT" : "—"
    color dispStatusCol = g_isBullDisp ? color.lime : g_isBearDisp ? color.red : i_dashTextColor
    string narrFVG = str.tostring(g_bullFVGs) + " Bull / " + str.tostring(g_bearFVGs) + " Bear"
    color sessCol = g_inKillzone ? color.yellow : g_inLunch ? color.gray : i_dashTextColor

    string narrative = ""
    if not g_fpValid
        narrative := "⚠ Footprint data unavailable on the current bar"
    else if g_amdState == 2
        narrative := "⚡ Tracked level swept (Δ " + str.tostring(nz(g_lastSweepDeltaMem, 0.0), "#") + ") → monitoring response"
    else if g_amdState == 3
        narrative := "▲ Bullish expansion active | review pullback structure and FVGs"
    else if g_amdState == 4
        narrative := "▼ Bearish expansion active | review retracement structure and FVGs"
    else if g_amdState == 1
        narrative := "◼ Balanced delta with active volume | reference: " + narrMagnet
    else if g_recentTrapScore >= 70
        narrative := "🪤 Strong trap-response score | require price confirmation"
    else
        string side = close > nz(g_pocPrice, close) ? "above POC" : "below POC"
        string fvgBias = g_bullFVGs > g_bearFVGs ? "Bull FVG bias" : g_bearFVGs > g_bullFVGs ? "Bear FVG bias" : "Balanced FVGs"
        narrative := "Scanning " + side + " | " + fvgBias + " | Reference: " + narrMagnet

    string textSize = f_dashTextSize()
    color cycleRowCol = switch g_amdState
        1 => i_balancedColor
        2 => i_sweepColor
        3 => i_expandBullColor
        4 => i_expandBearColor
        => i_dashTextColor

    table.cell(g_dashboard, 0, 0, "♛  FOOTPRINT", text_color=#ffd740, text_size=textSize, text_halign=text.align_center)
    table.cell(g_dashboard, 0, 1, "FLOW DATA", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 1, narrFP, text_color=fpCol, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 2, "Δ REGIME", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 2, narrDeltaRegime, text_color=g_deltaRatio < i_accumDeltaThresh ? i_balancedColor : g_deltaRatio > i_oneSidedDeltaThresh ? color.orange : i_dashTextColor, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 3, "AUCTION", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 3, narrAuction, text_color=i_pocColor, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 4, "AUCTION CYCLE", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 4, narrCycle, text_color=cycleRowCol, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 5, "SESSION", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 5, g_sessionLabel, text_color=sessCol, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 6, "LAST SWEEP", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 6, narrSweep, text_color=not na(g_lastSweepPrice) and (bar_index - g_lastSweepBar) < 50 ? color.orange : i_dashTextColor, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 7, "TRAP SCORE", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 7, narrTrap, text_color=trapStatusCol, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 8, "MAGNET #1", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 8, narrMagnet, text_color=i_magnetColor, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 9, "DISPLACEMENT", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 9, narrDisp, text_color=dispStatusCol, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 10, "ACTIVE FVGs", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 10, narrFVG, text_color=i_dashTextColor, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 11, "LIQ LEVELS", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_dashboard, 1, 11, str.tostring(g_activeLevels) + " active / " + str.tostring(array.size(g_liqLevels)) + " total", text_color=i_dashTextColor, text_size=textSize, text_halign=text.align_right)
    table.cell(g_dashboard, 0, 12, narrative, text_color=#ffd740, text_size=size.tiny, text_halign=text.align_left)


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │          SECTION 9: EXECUTION PANEL — REAL-TIME SETUP CHECKLIST            │
// │          Synthesizes model conditions into a non-probabilistic score       │
// └─────────────────────────────────────────────────────────────────────────────┘

var table g_execPanel = table.new(f_execPosition(), 3, 12, bgcolor=i_dashBGColor, border_width=1, border_color=color.new(color.white, 85), frame_width=2, frame_color=color.new(#00e5ff, 50))
if barstate.isfirst
    table.merge_cells(g_execPanel, 0, 0, 1, 0)
    for row = 2 to 9
        table.merge_cells(g_execPanel, 1, row, 2, row)
    table.merge_cells(g_execPanel, 0, 10, 2, 10)
    table.merge_cells(g_execPanel, 0, 11, 2, 11)

if i_execEnabled and barstate.islast
    // 1. Auction cycle (0-10)
    int sc_cycle = 0
    string ck_cycle = "✗"
    string ck_cycleDetail = "NEUTRAL — no active cycle"
    if g_amdState == 1
        sc_cycle := 5
        ck_cycle := "◐"
        ck_cycleDetail := "BALANCED (" + str.tostring(g_amdStateBars) + " bars)"
    else if g_amdState == 2
        sc_cycle := 10
        ck_cycle := "✓"
        ck_cycleDetail := "SWEEP PHASE"
    else if g_amdState == 3 or g_amdState == 4
        sc_cycle := 8
        ck_cycle := "✓"
        ck_cycleDetail := g_amdState == 3 ? "BULL EXPANSION" : "BEAR EXPANSION"

    // 2. Liquidity map (0-10)
    int sc_liq = 0
    string ck_liq = "✗"
    string ck_liqDetail = "No levels tracked"
    if g_activeLevels >= 5
        sc_liq := 10
        ck_liq := "✓"
        ck_liqDetail := str.tostring(g_activeLevels) + " active levels"
    else if g_activeLevels >= 2
        sc_liq := 5
        ck_liq := "◐"
        ck_liqDetail := str.tostring(g_activeLevels) + " active levels"

    // 3. Sweep freshness (0-20)
    int sc_sweep = 0
    string ck_sweep = "✗"
    string ck_sweepDetail = "No recent sweep"
    bool hasFreshSweep = not na(g_lastSweepPrice) and (bar_index - g_lastSweepBar) <= i_execSweepWindow
    if hasFreshSweep
        int sweepAge = bar_index - g_lastSweepBar
        if sweepAge <= 5
            sc_sweep := 20
            ck_sweep := "✓"
            ck_sweepDetail := "FRESH @ " + str.tostring(g_lastSweepPrice, format.mintick) + " (" + str.tostring(sweepAge) + " bars)"
        else
            sc_sweep := int(math.max(0.0, 20.0 * (1.0 - (sweepAge - 5.0) / math.max(i_execSweepWindow - 5.0, 1.0))))
            ck_sweep := "◐"
            ck_sweepDetail := "AGING @ " + str.tostring(g_lastSweepPrice, format.mintick) + " (" + str.tostring(sweepAge) + " bars)"

    // 4. Auction location (0-10)
    int sc_zone = 0
    string ck_zone = "—"
    string ck_zoneDetail = "No Value Area data"
    bool aboveVAH = not na(g_vahPrice) and close > g_vahPrice
    bool belowVAL = not na(g_valPrice) and close < g_valPrice
    bool insideVA = not aboveVAH and not belowVAL and not na(g_vahPrice) and not na(g_valPrice)
    if aboveVAH
        sc_zone := 10
        ck_zone := "✓"
        ck_zoneDetail := "ABOVE VAH — upper auction location"
    else if belowVAL
        sc_zone := 10
        ck_zone := "✓"
        ck_zoneDetail := "BELOW VAL — lower auction location"
    else if insideVA
        sc_zone := 3
        ck_zone := "◐"
        ck_zoneDetail := "INSIDE VALUE AREA"

    // 5. Recent trap response (0-20)
    int sc_trap = 0
    string ck_trap = "✗"
    string ck_trapDetail = "No recent trap response"
    if g_recentTrapScore > 0
        if g_recentTrapScore >= 75
            sc_trap := 20
            ck_trap := "✓"
            ck_trapDetail := str.tostring(g_recentTrapScore) + "/100 " + (g_recentTrapBull ? "BULL" : "BEAR") + " — STRONG AGREEMENT"
        else if g_recentTrapScore >= 50
            sc_trap := 12
            ck_trap := "◐"
            ck_trapDetail := str.tostring(g_recentTrapScore) + "/100 " + (g_recentTrapBull ? "BULL" : "BEAR") + " — MODERATE"

    // 6. Current/recent displacement (0-15)
    int sc_disp = 0
    string ck_disp = "✗"
    string ck_dispDetail = "No displacement"
    bool hasRecentDisp = not na(g_recentDispBar) and (bar_index - g_recentDispBar) <= 10
    if g_isRealDisplacement
        sc_disp := 15
        ck_disp := "✓"
        ck_dispDetail := (g_isBullDisp ? "BULL" : "BEAR") + " — Δ " + str.tostring(nz(g_delta, 0.0), "#") + " THIS BAR"
    else if hasRecentDisp
        sc_disp := 8
        ck_disp := "◐"
        int dispAge = bar_index - g_recentDispBar
        ck_dispDetail := (g_recentDispBull ? "BULL" : "BEAR") + " — " + str.tostring(dispAge) + " bars ago"

    // Directional vote is calculated before FVG scoring so the FVG must align.
    float dirVote = 0.0
    if hasFreshSweep
        dirVote += g_lastSweepBull ? 3.0 : -3.0
    if g_recentTrapScore > 0
        dirVote += g_recentTrapBull ? 2.5 : -2.5
    if hasRecentDisp
        dirVote += g_recentDispBull ? 2.0 : -2.0
    if g_avgDelta > 0 and g_smoothDelta > g_avgDelta * 0.3
        dirVote += 1.0
    else if g_avgDelta > 0 and g_smoothDelta < -g_avgDelta * 0.3
        dirVote -= 1.0
    if aboveVAH
        dirVote -= 0.5
    else if belowVAL
        dirVote += 0.5

    string dirBias = dirVote > 1.5 ? "LONG" : dirVote < -1.5 ? "SHORT" : "NEUTRAL"
    color dirCol = dirBias == "LONG" ? color.new(#00e676, 0) : dirBias == "SHORT" ? color.new(#ff5252, 0) : color.gray
    float dirAlignment = math.min(100.0, math.abs(dirVote) / 9.0 * 100.0)

    // 7. Directionally aligned FVG proximity (0-10)
    int sc_fvg = 0
    string ck_fvg = "✗"
    string ck_fvgDetail = "No aligned FVG available"
    float nearestFVGDist = 99999.0
    float nearestFVGMid = na
    bool nearestFVGBull = false
    if array.size(g_fvgs) > 0 and dirBias != "NEUTRAL"
        for i = 0 to array.size(g_fvgs) - 1
            FVGZone fvg = array.get(g_fvgs, i)
            bool directionMatches = (dirBias == "LONG" and fvg.isBullish) or (dirBias == "SHORT" and not fvg.isBullish)
            if directionMatches
                float dist = math.abs(close - fvg.mid)
                if dist < nearestFVGDist
                    nearestFVGDist := dist
                    nearestFVGMid := fvg.mid
                    nearestFVGBull := fvg.isBullish
        if not na(nearestFVGMid) and nearestFVGDist < g_atr * 2.0
            sc_fvg := 10
            ck_fvg := "✓"
            ck_fvgDetail := (nearestFVGBull ? "Bull" : "Bear") + " FVG @ " + str.tostring(nearestFVGMid, format.mintick) + " (" + str.tostring(nearestFVGDist / g_atr, "#.#") + " ATR)"
        else if not na(nearestFVGMid)
            sc_fvg := 3
            ck_fvg := "◐"
            ck_fvgDetail := "Aligned FVG @ " + str.tostring(nearestFVGMid, format.mintick) + " — " + str.tostring(nearestFVGDist / g_atr, "#.#") + " ATR away"

    // 8. Configured session window (0-5)
    int sc_session = 0
    string ck_session = "✗"
    string ck_sessionDetail = "Outside weighted windows"
    if g_inKillzone
        sc_session := 5
        ck_session := "✓"
        ck_sessionDetail := g_sessionLabel + " — configured active window"
    else if g_inLunch
        ck_sessionDetail := "LUNCH — reduced weight"
    else if g_inAsia
        sc_session := 2
        ck_session := "◐"
        ck_sessionDetail := "ASIA SESSION"

    int g_setupScore = sc_cycle + sc_liq + sc_sweep + sc_zone + sc_trap + sc_disp + sc_fvg + sc_session

    bool cycleConflict = (dirBias == "LONG" and g_amdState == 4) or (dirBias == "SHORT" and g_amdState == 3)

    string execState = "SCANNING"
    color execStateCol = color.gray
    if g_setupScore >= i_execMinScore and dirBias != "NEUTRAL" and not cycleConflict
        execState := "► QUALIFIED " + dirBias
        execStateCol := dirCol
    else if g_setupScore >= i_execMinScore and cycleConflict
        execState := "⚠ CONFLICT"
        execStateCol := color.yellow
    else if sc_sweep >= 10 or g_amdState == 2
        execState := "TRIGGERED"
        execStateCol := i_sweepColor
    else if g_amdState == 1 and g_activeLevels >= 3
        execState := "STALKING"
        execStateCol := i_balancedColor
    else if (g_amdState == 3 or g_amdState == 4) and g_amdStateBars > 15
        execState := "MANAGING"
        execStateCol := color.yellow

    color scoreCol = g_setupScore >= 80 ? color.new(#00e676, 0) : g_setupScore >= i_execMinScore ? color.new(#ffd740, 0) : g_setupScore >= 30 ? color.new(#ff9800, 0) : color.gray
    string execTxtSize = f_dashTextSize()

    table.cell(g_execPanel, 0, 0, "⚡ " + execState, text_color=execStateCol, text_size=execTxtSize, text_halign=text.align_left)
    table.cell(g_execPanel, 2, 0, str.tostring(g_setupScore) + "/100", text_color=scoreCol, text_size=execTxtSize, text_halign=text.align_right)
    table.cell(g_execPanel, 0, 1, "BIAS", text_color=color.new(i_dashTextColor, 30), text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_execPanel, 1, 1, dirBias, text_color=dirCol, text_size=execTxtSize, text_halign=text.align_center)
    table.cell(g_execPanel, 2, 1, str.tostring(dirAlignment, "#") + "% align", text_color=dirCol, text_size=size.tiny, text_halign=text.align_right)

    color ck_cycleCol = ck_cycle == "✓" ? color.new(#00e676, 0) : ck_cycle == "◐" ? color.new(#ffd740, 0) : color.new(#ff5252, 30)
    color ck_liqCol = ck_liq == "✓" ? color.new(#00e676, 0) : ck_liq == "◐" ? color.new(#ffd740, 0) : color.new(#ff5252, 30)
    color ck_sweepCol = ck_sweep == "✓" ? color.new(#00e676, 0) : ck_sweep == "◐" ? color.new(#ffd740, 0) : color.new(#ff5252, 30)
    color ck_zoneCol = ck_zone == "✓" ? color.new(#00e676, 0) : ck_zone == "◐" ? color.new(#ffd740, 0) : color.new(#ff5252, 30)
    color ck_trapCol = ck_trap == "✓" ? color.new(#00e676, 0) : ck_trap == "◐" ? color.new(#ffd740, 0) : color.new(#ff5252, 30)
    color ck_dispCol = ck_disp == "✓" ? color.new(#00e676, 0) : ck_disp == "◐" ? color.new(#ffd740, 0) : color.new(#ff5252, 30)
    color ck_fvgCol = ck_fvg == "✓" ? color.new(#00e676, 0) : ck_fvg == "◐" ? color.new(#ffd740, 0) : color.new(#ff5252, 30)
    color ck_sessionCol = ck_session == "✓" ? color.new(#00e676, 0) : ck_session == "◐" ? color.new(#ffd740, 0) : color.new(#ff5252, 30)

    table.cell(g_execPanel, 0, 2, ck_cycle + " CYCLE", text_color=ck_cycleCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_execPanel, 1, 2, ck_cycleDetail, text_color=ck_cycleCol, text_size=size.tiny, text_halign=text.align_right)
    table.cell(g_execPanel, 0, 3, ck_liq + " LIQUIDITY", text_color=ck_liqCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_execPanel, 1, 3, ck_liqDetail, text_color=ck_liqCol, text_size=size.tiny, text_halign=text.align_right)
    table.cell(g_execPanel, 0, 4, ck_sweep + " SWEEP", text_color=ck_sweepCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_execPanel, 1, 4, ck_sweepDetail, text_color=ck_sweepCol, text_size=size.tiny, text_halign=text.align_right)
    table.cell(g_execPanel, 0, 5, ck_zone + " LOCATION", text_color=ck_zoneCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_execPanel, 1, 5, ck_zoneDetail, text_color=ck_zoneCol, text_size=size.tiny, text_halign=text.align_right)
    table.cell(g_execPanel, 0, 6, ck_trap + " TRAP", text_color=ck_trapCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_execPanel, 1, 6, ck_trapDetail, text_color=ck_trapCol, text_size=size.tiny, text_halign=text.align_right)
    table.cell(g_execPanel, 0, 7, ck_disp + " DISPLACE", text_color=ck_dispCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_execPanel, 1, 7, ck_dispDetail, text_color=ck_dispCol, text_size=size.tiny, text_halign=text.align_right)
    table.cell(g_execPanel, 0, 8, ck_fvg + " FVG", text_color=ck_fvgCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_execPanel, 1, 8, ck_fvgDetail, text_color=ck_fvgCol, text_size=size.tiny, text_halign=text.align_right)
    table.cell(g_execPanel, 0, 9, ck_session + " SESSION", text_color=ck_sessionCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(g_execPanel, 1, 9, ck_sessionDetail, text_color=ck_sessionCol, text_size=size.tiny, text_halign=text.align_right)

    string objectiveText = "OBJECTIVE REF: —"
    if dirBias == "LONG" and g_magnetAboveText != "—"
        objectiveText := "OBJECTIVE REF: " + g_magnetAboveText
    else if dirBias == "SHORT" and g_magnetBelowText != "—"
        objectiveText := "OBJECTIVE REF: " + g_magnetBelowText
    else if dirBias != "NEUTRAL" and g_narrMagnet != "—"
        objectiveText := "OBJECTIVE REF: " + g_narrMagnet
    table.cell(g_execPanel, 0, 10, objectiveText, text_color=i_magnetColor, text_size=size.tiny, text_halign=text.align_left)

    string invalidationText = "INVALIDATION REF: —"
    if dirBias == "LONG" and hasFreshSweep and g_lastSweepPrice < close
        invalidationText := "INVALIDATION REF: Below " + str.tostring(g_lastSweepPrice, format.mintick) + " (sweep level)"
    else if dirBias == "SHORT" and hasFreshSweep and g_lastSweepPrice > close
        invalidationText := "INVALIDATION REF: Above " + str.tostring(g_lastSweepPrice, format.mintick) + " (sweep level)"
    else if dirBias == "LONG" and not na(g_valPrice)
        invalidationText := "INVALIDATION REF: Below " + str.tostring(g_valPrice, format.mintick) + " (VAL)"
    else if dirBias == "SHORT" and not na(g_vahPrice)
        invalidationText := "INVALIDATION REF: Above " + str.tostring(g_vahPrice, format.mintick) + " (VAH)"
    table.cell(g_execPanel, 0, 11, invalidationText, text_color=color.new(#ff5252, 20), text_size=size.tiny, text_halign=text.align_left)


// ┌─────────────────────────────────────────────────────────────────────────────┐
// │                        SECTION 10: ALERTS                                  │
// └─────────────────────────────────────────────────────────────────────────────┘

// Structured high-delta rejection: unusually large delta, opposing wick/close
// response, and interaction with at least one tracked unswept liquidity level.
bool g_touchesBelowSSL = false
bool g_touchesAboveBSL = false
if array.size(g_liqLevels) > 0
    for i = 0 to array.size(g_liqLevels) - 1
        LiquidityLevel lvl = array.get(g_liqLevels, i)
        if not lvl.isSwept and low <= lvl.price and high >= lvl.price
            if lvl.isAbove
                g_touchesAboveBSL := true
            else
                g_touchesBelowSSL := true

bool g_bullHighDeltaReject = g_fpValid and g_avgDelta > 0 and g_absDelta > g_avgDelta * 2.5 and g_delta < 0 and g_lowerWickR >= i_revWickRatio and close > (high + low) / 2.0
bool g_bearHighDeltaReject = g_fpValid and g_avgDelta > 0 and g_absDelta > g_avgDelta * 2.5 and g_delta > 0 and g_upperWickR >= i_revWickRatio and close < (high + low) / 2.0
bool g_highDeltaRejection = (g_bullHighDeltaReject and g_touchesBelowSSL) or (g_bearHighDeltaReject and g_touchesAboveBSL)

// v2.3.1: named plot placeholders — immune to plot reordering, unlike {{plot_N}}.
alertcondition(i_alertTrap and g_lastTrapScore >= i_trapScoreThresh, title="Iron Rain Trap Response", message='BK AK-Iron Rain: Trap response detected at {{close}} | Score {{plot("Trap Score")}}/100 | Delta {{plot("Bar Delta")}}')
alertcondition(i_alertDisp and g_isRealDisplacement, title="Iron Rain Displacement", message='BK AK-Iron Rain: Directional displacement detected at {{close}} | Delta {{plot("Bar Delta")}}')
alertcondition(i_alertAMD and g_amdChanged, title="Iron Rain Auction Cycle Change", message='BK AK-Iron Rain: Auction cycle state changed at {{close}} | State {{plot("Auction State")}}')
alertcondition(i_alertSweep and g_anySweep, title="Iron Rain Liquidity Sweep", message='BK AK-Iron Rain: Tracked liquidity level swept at {{close}} | Delta {{plot("Bar Delta")}}')
alertcondition(i_alertHighDeltaRejection and g_highDeltaRejection, title="Iron Rain High-Delta Rejection", message='BK AK-Iron Rain: High-delta rejection at a tracked level near {{close}} | Delta {{plot("Bar Delta")}}')

// Data-window outputs used by alerts and diagnostics.
plot(g_lastTrapScore,       "Trap Score",    display=display.data_window, color=color.new(color.white, 100))
plot(nz(g_delta, 0.0),      "Bar Delta",     display=display.data_window, color=color.new(color.white, 100))
plot(g_amdState,            "Auction State", display=display.data_window, color=color.new(color.white, 100))
plot(g_deltaRatio,          "Delta Ratio",   display=display.data_window, color=color.new(color.white, 100))
plot(nz(g_pocPrice, 0.0),   "POC Price",     display=display.data_window, color=color.new(color.white, 100))
plot(nz(g_totalVol, 0.0),   "Total Vol",     display=display.data_window, color=color.new(color.white, 100))


// ═══════════════════════════════════════════════════════════════════════════════
// END BK AK-IRON RAIN v2.3.2 — FINAL FOOTPRINT EDITION
// ═══════════════════════════════════════════════════════════════════════════════

