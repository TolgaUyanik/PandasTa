//@version=6

// @description PseudoPlot: behave like plot and fill using polyline
// This library enables line plotting by polyline like plot() and fill().
// The core of polyline() is array of chart.point array, polyline() is called in its method.
// Moreover, plotarea() makes a box in main chart, plotting data within the box is enabled.
//
// It works so slowy to manage array of chart.point, so limit the target to visible area of the chart.
// Due to polyline specifications, na and expression can not be used for colors.
//
// 1. pseudoplot
// pseudoplot() behaves like plot().
// [pine]
// //use plot()
// plot(close)
// //use pseudoplot()
// pseudoplot(close)
// [/pine]
//
// Pseudoplot has label. Label is enabled when title argument is set.
// In the example bellow, "close value" label is shown with line.
// The label is shown at right of the line when recent bar is visible.
// It is shown at 15% from the left of visible area when recent bar is not visible.
// Just set "" if you don't need label.
// [pine]
// //use plot()
// plot(close,"close value")
// //use pseudoplot
// pseudoplot(close, "close value")
// [/pine]
//
// Arguments are designed in an order as similar as possible to plot.
// [pine]
// plot(series, title, color, linewidth, style, trackprice, histbase, offset, join, editable, show_last, display, format, precision, force_overlay) → plot
// pseudoplot(series, title, ,linecolor ,linewidth, linestyle, labelbg, labeltext, labelsize, shorttitle, format, xpos_from_left, overlay) → pseudo_plot
// [/pine]
//
// 2. pseudofill
// pseudofill() behaves like fill().
// The label is shown(text only) at right of the line when recent bar is visible.
// It is shown at 10% from the left of visible area when recent bar is not visible.
// Just set "" if you don't need label.
// [pine]
// //use plot() and fill()
// p1=plot(open)
// p2=plot(close)
// fill(p1,p2)
// //use pseudofill()
// pseudofill(open,close)
// [/pine]
//
// Arguments are designed in an order as similar as possible to fill.
//[pine]
//fill(hline1, hline2, color, title, editable, fillgaps, display) → void
//pseudofill(series1, series2, fillcolor, title, linecolor, linewidth, linestyle, labeltext, labelsize, shorttitle, format, xpos_from_left, overlay) → pseudo_plot
//[/pine]
//
// 3. plotarea and its methods
// plotarea() makes a box in main chart. You can set the box position to top or bottom, and
// the box height in percentage of the range of visible high and low prices.
// x-coordinate of the box is from chart.left_visible_bar_time to chart.right_visible_bar_time,
// y-coordinate is highest and lowest price of visible bars.
// pseudoplot() and pseudofill() work as method of plotarea(box). 
// Usage is almost same as the function version, just set min and max value, y-coodinate is remapped automatically.
// hline() is also available. The y-coordinate of hline is specified as a percentage from the bottom.
// plotarea() and its associated methods are overlay=true as default.
// Depending on the drawing order of the objects, plot may become invisible, so the bgcolor of plotarea should be na or tranceparent.
// [pine]
// //1. make a plotarea
// // bgcolor should be na or transparent color.
// area=plotarea("bottom",30,"plotarea",bgcolor=na)
// //2. plot in a plotarea
// //(min=0, max=100 is omitted as it is the default.)
// area.pseudoplot(ta.rsi(close,14))
// //3. draw hlines
// area.hline(30,linestyle="dotted",linewidth=2)
// area.hline(70,linestyle="dotted",linewidth=2)
// [/pine]
//
// 4. Data structure and sub methods
// Array management is most imporant part of using polyline.
// I don't know the proper way to handle array<chart.point>, so it is managed by array<int> and array<float> as intermediate data.
// (type xy_arrays to manage bar_time and price as independent arrays.)
// method cparray() pack arrays to array<chart.point>, when array includes both chart.left_visible_bar_time and chart.right_visible_bar.time.
//
// Calling polyline is implemented as methods of array of chart.point.
// Method creates polyline object if array is not empty.
//
// [pine]
// method polyline(linecolor, linewidth, linestyle, overlay) → series polyline
// method polyline_fill(fillcolor, linecolor, linewidth, linestyle, overlay) → series polyline
// [/pine]
//
// Also calling label is implemented as methods of array of chart.point.
// Method creates label ofject if array is not empty.
// Label is located at right edge of the chart when recent bar is visible, located at left side when recent bar is invisible.
// 
// [pine]
// label(title, labelbg, labeltext, labelsize, format, shorttitle, xpos_from_left, overlay) → series label
// label_for_fill(title, labeltext, labelsize, format, shorttitle, xpos_from_left, overlay) → series label
// [/pine]
//
library("PseudoPlot")

// @type 						polyline and label.
// @field 	p 	(polyline)		polyline
// @field	l 	(label)			label
export type pseudo_plot
	polyline p
	label l

// @type 							x(bartime) and y(price or value) arrays.
// @field 	t 	(array<int>)		bar_time array.
// @field	p 	(array<float>)		price array.
export type xy_arrays
	array<int> t
	array<float> p

// @function 					make arrays of visible x(bar_time) and y(price/value).
// @param 	series 	(float)		series variable
// @returns		 	(xy_arrays)
export visible_xyInit(float series)=>
	var t=array.new_int(0,na)
	var p=array.new_float(0,na)
	if chart.left_visible_bar_time<=time and chart.right_visible_bar_time>=time
		if t.size()>0 and t.get(-1)==time
			p.set(-1,series)
		else
			t.push(time)
			p.push(series)

	if t.includes(chart.left_visible_bar_time) and t.includes(chart.right_visible_bar_time)
		xy_arrays.new(t,p)
	else
		xy_arrays.new(array.new_int(0,na),array.new_float(0,na))

// @method						remap to ypos to a range (for plotarea box).
// @param 	bottom 	(float)		bottom price to ajust.
// @param	top		(float)		top price to ajust.
// @param	min		(float)		min of src value.
// @param	max		(float)		max of src value.
// @returns		 	(xy_arrays)
export method remap(xy_arrays this,float bottom, float top, float min=0, float max=100)=>
	var xy=xy_arrays.new(array.new_int(0,na),array.new_float(0,na))
	p=array.new_float(0,na)
	if this.t.includes(chart.left_visible_bar_time) and this.t.includes(chart.right_visible_bar_time)
		diff=top-bottom
		r=max-min
		for i=0 to this.t.size()-1
			p.push((this.p.get(i)-min)/r * diff + bottom)
		xy:=xy_arrays.new(this.t,p)
	xy

// @method						convert xy_arrays to array of chart.point.
// @returns		 	(array<chart.point>)
method cparray(xy_arrays this)=>
	cp=array.new<chart.point>(0,na)
	if this.t.size()>0
		for i=0 to this.t.size()-1
			cp.push(chart.point.from_time(this.t.get(i),this.p.get(i)))
	cp

// @method 						set chart.point array to polyline, when array got ready.
// @param linecolor (color) 	color of polyline.
// @param linewidth (int) 		width of polyline.
// @param linestyle (string)	linestyle of polyline. default is line.style_solid("solid"), others line.style_dashed("dashed"), line.style_dotted("dotted").
// @param overlay   (bool)		force_overlay of polyline. default is false.
// @returns 		(polyline)
export method polyline(array<chart.point> this, color linecolor=color.blue, int linewidth=1, string linestyle="solid", bool overlay=false)=>
	if this.size()>0
		ls=switch linestyle
			"dashed"=>line.style_dashed
			"dotted"=>line.style_dotted
			=>line.style_solid
		var p=overlay?polyline.new(this,curved=false,xloc=xloc.bar_time,line_color=linecolor,line_style=ls,line_width=linewidth,force_overlay=true):
					  polyline.new(this,curved=false,xloc=xloc.bar_time,line_color=linecolor,line_style=ls,line_width=linewidth)
		p

// @method 						set chart.point array to polyline, when array got ready.
// @param linecolor (color) 	color of polyline.
// @param linewidth (int) 		width of polyline.
// @param linestyle (string)	linestyle of polyline. default is line.style_solid("solid"), others line.style_dashed("dashed"), line.style_dotted("dotted").
// @param overlay   (bool)		force_overlay of polyline. default is false.
// @returns 		(polyline)
export method polyline_fill(array<chart.point> this, color fillcolor=color.red, color linecolor=na, int linewidth=1, string linestyle="solid", bool overlay=false)=>
	if this.size()>0
		ls=switch linestyle
			"dashed"=>line.style_dashed
			"dotted"=>line.style_dotted
			=>line.style_solid
		var p=overlay?polyline.new(this,curved=false,xloc=xloc.bar_time,line_color=linecolor,fill_color=fillcolor,line_style=ls,line_width=linewidth,force_overlay=true):
					  polyline.new(this,curved=false,xloc=xloc.bar_time,line_color=linecolor,fill_color=fillcolor,line_style=ls,line_width=linewidth)
		p

// @method 						set label to the polyline, when title is not empty.
// @param title		(string) 	label text.
// @param labelbg	(color) 	color of label bg.
// @param labeltext (color)		color of label text.
// @param labelsize	(int)		size of label.
// @param format	(string)	textformat of label. default is text.format_none("none"). others text.format_bold("bold"), text.format_italic("italic"), text.format_bold+text.format_italic("bold+italic").
// @param shorttitle (string)	another label text for recent bar is not visible.
// @param xpos_from_left (int)	another label x-position(percentage from left of chart width), when recent bar is not visible. default is 15%.
// @param overlay   (bool)		force_overlay of label. default is false.
// @returns 		(label)
export method label(array<chart.point> this, string title="", color labelbg=color.blue, color labeltext=color.white, int labelsize=12, string format='none',
			 string shorttitle="", int xpos_from_left=15,
			 bool overlay=false)=>
	if this.size()>0 and str.length(title)>0
		var l=overlay?label.new(this.get(-1),na,xloc.bar_time,color=labelbg,textcolor=labeltext,force_overlay=true):
					  label.new(this.get(-1),na,xloc.bar_time,color=labelbg,textcolor=labeltext)
		l.set_size(labelsize)
		switch format
			"bold"=>l.set_text_formatting(text.format_bold)
			"italic"=>l.set_text_formatting(text.format_italic)
			"bold+italic"=>l.set_text_formatting(text.format_bold+text.format_italic)
			=>l.set_text_formatting(text.format_none)
		var i=0
		if time==chart.right_visible_bar_time
			l.set_point(this.get(-1))
			l.set_text(title)
			l.set_style(label.style_label_left)
			i:=0
		else if i>1
			xpos=int(this.size()*xpos_from_left/100)
			xpos_after=int(this.size()*(xpos_from_left+3)/100)
			xpos_after:=math.min(xpos_after,this.size()-1)
			l.set_point(this.get(xpos))
			l.set_text(str.length(shorttitle)>0 ? shorttitle : title)
			l.set_style(this.get(xpos).price < this.get(xpos_after).price ? label.style_label_upper_left : label.style_label_lower_left)
		else
			i+=1
		l

// @method 						set label to the polyline for fill, when title is not empty.
// @param title		(string) 	label text.
// @param labeltext (color)		color of label text.
// @param labelsize	(int)		size of label.
// @param format	(string)	textformat of label. default is text.format_none("none"). others text.format_bold("bold"), text.format_italic("italic"), text.format_bold+text.format_italic("bold+italic").
// @param shorttitle (string)	another label text for recent bar is not visible.
// @param xpos_from_left (int)	another label x-position(percentage from left of chart width), when recent bar is not visible. default is 10%.
// @param overlay   (bool)		force_overlay of label. default is false.
// @returns 		(label)
export method label_for_fill(array<chart.point> this, string title="", color labeltext=color.white, int labelsize=8, string format='none',
			 string shorttitle="", int xpos_from_left=15,
			 bool overlay=false)=>
	if this.size()>0 and str.length(title)>0
		var l=overlay?label.new(this.get(-1),na,xloc.bar_time,color=color.new(color.white,100),textcolor=labeltext,style=label.style_label_center,force_overlay=true):
					  label.new(this.get(-1),na,xloc.bar_time,color=color.new(color.white,100),textcolor=labeltext,style=label.style_label_center)
		l.set_size(labelsize)
		switch format
			"bold"=>l.set_text_formatting(text.format_bold)
			"italic"=>l.set_text_formatting(text.format_italic)
			"bold+italic"=>l.set_text_formatting(text.format_bold+text.format_italic)
			=>l.set_text_formatting(text.format_none)
		a=this.slice(0,int(this.size()/2))
		b=this.slice(int(this.size())/2,this.size())
		b.reverse()
		var i=0
		if time==chart.right_visible_bar_time
			l.set_xy(a.get(-1).time, math.avg(a.get(-1).price, b.get(-1).price))
			l.set_text(title)
			i:=0
		else if i>1
			xpos=int((a.size()-1)*xpos_from_left/100)
			l.set_xy(a.get(xpos).time, math.avg(a.get(xpos).price, b.get(xpos).price))
			l.set_text(str.length(shorttitle)>0 ? shorttitle : title)
		else
			i+=1
		l

// @function 					polyline like plot with label
// @param series 	(float)		series variable to plot.
// @param title		(string)	title if need label. default value is ""(disable label).
// @param linecolor (color)		color of line.
// @param linewidth (int)		width of line.
// @param linestyle (string)	style of plotting line. default is "solid", others "dashed", "dotted".
// @param labelbg	(color)		color of label bg.
// @param labeltext	(color)		color of label text.
// @param labelsize (int)		size of label text.
// @param shorttitle (string)	another label text for recent bar is not visible.
// @param format	(string)	textformat of label. default is text.format_none("none"). others text.format_bold("bold"), text.format_italic("italic"), text.format_bold+text.format_italic("bold+italic").
// @param xpos_from_left (int)	another label x-position(percentage from left of chart width), when recent bar is not visible. default is 15%.
// @param overlay	(bool)		force_overlay of polyline and label.
// @returns			(pseudo_plot)
export pseudoplot(float series, string title="", color linecolor=color.blue, int linewidth=1, string linestyle="solid",
           color labelbg=color.blue, color labeltext=color.white, int labelsize=12, string shorttitle="", string format="bold+italic", int xpos_from_left=15,
		   bool overlay=false)=>
	_linecolor=na(linecolor)?color.blue:linecolor

	vxy=visible_xyInit(series)
	vpl=vxy.cparray()

	p=vpl.polyline(_linecolor,linewidth,linestyle,overlay)
	l=vpl.label(title,labelbg,labeltext,labelsize,format,shorttitle,xpos_from_left,overlay)

	pseudo_plot.new(p,l)

// @function fill by polyline
// @param series1 	(float)		series variable to plot.
// @param series2 	(float)		series variable to plot.
// @param fillcolor (color)		color of fill.
// @param linecolor (color)		color of line.
// @param linewidth (int)		width of line.
// @param linestyle (string)	style of plotting line. default is "solid", others "dashed", "dotted".
// @param format	(string)	textformat of label. default is text.format_none("none"). others text.format_bold("bold"), text.format_italic("italic"), text.format_bold+text.format_italic("bold+italic").
// @param xpos_from_left (int)	another label x-position(percentage from left of chart width), when recent bar is not visible. default is 15%.
// @param overlay	(bool)		force_overlay of polyline and label.
// @returns			(pseudoplot)
export pseudofill(float series1, float series2, color fillcolor=color.blue, string title="", color linecolor=color.white, int linewidth=1, string linestyle="solid",
		          color labeltext=color.white, int labelsize=8, string shorttitle="", string format="bold+italic", int xpos_from_left=10,
				  bool overlay=false)=>
	_fillcolor=na(fillcolor)?color.blue:fillcolor
	_linecolor=na(linecolor)?color.white:linecolor

	vxy1=visible_xyInit(series1)
	vxy2=visible_xyInit(series2)
	vpl1=vxy1.cparray()
	vpl2=vxy2.cparray()
	vpl2.reverse()
	vpl=vpl1.concat(vpl2)

	p=vpl.polyline_fill(_fillcolor, _linecolor, linewidth, linestyle, overlay)
	l=vpl.label_for_fill(title,labeltext,labelsize,format,shorttitle,xpos_from_left,overlay)

	pseudo_plot.new(p,l)

// @function subplot area in main chart
// @param pos 		(string)	position of subplot area, bottom or top.
// @param height	(float)		percentage of visible chart heght.
// @param title 	(string)	text of area box.
// @param bordercolor (color)	color of border.
// @param borderwidth (int)		width of border.
// @param bgcolor	(string)	color of area bg.
// @param overlay	(bool)		force_overlay of polyline and label.
// @returns			(box)
export plotarea(string pos="bottom", int height=30, string title="", color bordercolor=color.white, int borderwidth=4, color bgcolor=color.yellow,
			  int textsize=12, color textcolor=color.white, string format="none",
			  bool overlay=true)=>
	var t=array.new_int(0,na)
	var h=array.new_float(0,na)
	var l=array.new_float(0,na)
	if t.size()>0 and t.get(-1)==time
		h.set(-1,high)
		l.set(-1,low)
	else
		t.push(time)
		h.push(high)
		l.push(low)

	left_index=t.indexof(chart.left_visible_bar_time)
	right_index=t.indexof(chart.right_visible_bar_time)
	if left_index!=-1 and right_index!=-1
		sh=h.slice(left_index,right_index+1)
		sl=l.slice(left_index,right_index+1)
		top=sh.max()
		bottom=sl.min()
		if pos=="bottom"
			top:=(top-bottom)*height/100+bottom
		else
			bottom:=top-(top-bottom)*height/100
		var area=overlay?box.new(chart.left_visible_bar_time,top,chart.right_visible_bar_time,bottom,xloc=xloc.bar_time,
								 border_color=bordercolor,border_width=borderwidth,bgcolor=bgcolor,text=title, text_halign=text.align_left, text_valign=text.align_top,
								 text_size=textsize,text_color=textcolor,
								 force_overlay=true):
						 box.new(chart.left_visible_bar_time,top,chart.right_visible_bar_time,bottom,xloc=xloc.bar_time,
								 border_color=bordercolor,border_width=borderwidth,bgcolor=bgcolor,text=title, text_halign=text.align_left, text_valign=text.align_top,
								 text_size=textsize,text_color=textcolor)
		switch format
			"bold"=>area.set_text_formatting(text.format_bold)
			"italic"=>area.set_text_formatting(text.format_italic)
			"bold+italic"=>area.set_text_formatting(text.format_bold+text.format_italic)
			=>area.set_text_formatting(text.format_none)
		area.set_lefttop(chart.left_visible_bar_time,top)
		area.set_rightbottom(chart.right_visible_bar_time,bottom)

		area

// @method						line like hline for method of plotarea(box).
// @param ypos_from_bottom 	(float)		percentage of box height from the bottom of box.(bottom is 0%, top is 100%).
// @param linecolor	(color)		color of line.
// @param linestyle	(string)	style of line.
// @param linewidth	(int)		width of line.
// @param overlay	(bool)		force_overlay of polyline and label.
// @returns			(line)
export method hline(box this, float ypos_from_bottom, color linecolor=color.blue, string linestyle="solid", int linewidth=1,
		   bool overlay=true)=>
	left=this.get_left()
	right=this.get_right()
	top=this.get_top()
	bottom=this.get_bottom()
	ypos=(top-bottom)*ypos_from_bottom/100 + bottom
	ls=switch linestyle
		"dashed"=>line.style_dashed
		"dotted"=>line.style_dotted
		=>line.style_solid
	var l=overlay?line.new(left,ypos,right,ypos,xloc.bar_time,color=linecolor,style=ls,width=linewidth,force_overlay=true):
				  line.new(left,ypos,right,ypos,xloc.bar_time,color=linecolor,style=ls,width=linewidth)
	l.set_x1(left)
	l.set_x2(right)
	l.set_y1(ypos)
	l.set_y2(ypos)

	l

// @method						polyline like plot with label for method of plotarea(box).
// @param series 	(float)		series variable to plot.
// @param title		(string)	title if need label. default value is ""(disable label).
// @param linecolor (color)		color of line.
// @param linewidth (int)		width of line.
// @param linestyle (string)	style of plotting line. default is "solid", others "dashed", "dotted".
// @param labelbg	(color)		color of label bg.
// @param labeltext	(color)		color of label text.
// @param labelsize (int)		size of label text.
// @param shorttitle (string)	another label text for recent bar is not visible.
// @param format	(string)	textformat of label. default is text.format_none("none"). others text.format_bold("bold"), text.format_italic("italic"), text.format_bold+text.format_italic("bold+italic").
// @param xpos_from_left (int)	another label x-position(percentage from left of chart width), when recent bar is not visible. default is 15%.
// @param overlay	(bool)		force_overlay of polyline and label.
// @returns			(pseudo_plot)
export method pseudoplot(box this, float series, string title="", color linecolor=color.blue, int linewidth=1, string linestyle="solid",
           color labelbg=color.blue, color labeltext=color.white, int labelsize=12, string shorttitle="", string format="bold+italic", int xpos_from_left=15,
		   float min=0, float max=100,
		   bool overlay=true)=>
	_linecolor=na(linecolor)?color.blue:linecolor
	vxy=visible_xyInit(series)
	_vxy=vxy.remap(this.get_bottom(),this.get_top(),min,max)
	vpl=_vxy.cparray()

	p=vpl.polyline(_linecolor,linewidth,linestyle,overlay)
	l=vpl.label(title,labelbg,labeltext,labelsize,format,shorttitle,xpos_from_left,overlay)

	pseudo_plot.new(p,l)

// @method						fill by polyline with label for method of plotarea(box).
// @param series1 	(float)		series variable to plot.
// @param series2 	(float)		series variable to plot.
// @param fillcolor (color)		color of fill.
// @param linecolor (color)		color of line.
// @param linewidth (int)		width of line.
// @param linestyle (string)	style of plotting line. default is "solid", others "dashed", "dotted".
// @param format	(string)	textformat of label. default is text.format_none("none"). others text.format_bold("bold"), text.format_italic("italic"), text.format_bold+text.format_italic("bold+italic").
// @param xpos_from_left (int)	another label x-position(percentage from left of chart width), when recent bar is not visible. default is 15%.
// @param overlay	(bool)		force_overlay of polyline and label.
// @returns			(pseudo_plot)
export method pseudofill(box this, float series1, float series2, color fillcolor=color.blue, string title="", color linecolor=color.white, int linewidth=1, string linestyle="solid",
		          color labeltext=color.white, int labelsize=8, string shorttitle="", string format="bold+italic", int xpos_from_left=10,
				  float min=0, float max=100,
				  bool overlay=true)=>
	_fillcolor=na(fillcolor)?color.blue:fillcolor
	_linecolor=na(linecolor)?color.white:linecolor

	vxy1=visible_xyInit(series1)
	vxy2=visible_xyInit(series2)
	_vxy1=vxy1.remap(this.get_bottom(),this.get_top(),min,max)
	_vxy2=vxy2.remap(this.get_bottom(),this.get_top(),min,max)
	vpl1=_vxy1.cparray()
	vpl2=_vxy2.cparray()
	vpl2.reverse()
	vpl=vpl1.concat(vpl2)

	p=vpl.polyline_fill(_fillcolor, _linecolor, linewidth, linestyle, overlay)
	l=vpl.label_for_fill(title,labeltext,labelsize,format,shorttitle,xpos_from_left,overlay)

	pseudo_plot.new(p,l)

//////////
// sample
//////////
var box=box.new(chart.left_visible_bar_time,100,chart.right_visible_bar_time,0,xloc=xloc.bar_time,text="PseudoPlot",
	  text_size=0,text_color=color.new(color.green,50),bgcolor=color.new(color.green,95),border_color=na,
	  text_font_family=font.family_monospace,text_formatting=text.format_italic)

import nazomobile/libTF/1 as tf
ctf=timeframe.period
htf1=tf.higher()

span=20
src=close

sma=ta.sma(src,span)
ema=ta.ema(src,span)

pseudoplot(sma,"",color.new(color.aqua,60),overlay=true)
pseudoplot(ema,"",color.new(color.yellow,60),overlay=true)

sma1=not na(htf1)?request.security(syminfo.tickerid,htf1,ta.sma(src,span)):na
ema1=not na(htf1)?request.security(syminfo.tickerid,htf1,ta.ema(src,span)):na

pseudoplot(sma1,htf1+":sma20",color.new(color.aqua,60),4,"solid",color.new(color.aqua,60),color.aqua,12,htf1,"bold+italic",overlay=true)
pseudoplot(ema1,htf1+":ema20",color.new(color.yellow,60),4,"solid",color.new(color.yellow,60),color.yellow,12,htf1,"bold+italic",overlay=true)

if not na(htf1)
	[_,p1,m1]=request.security(syminfo.tickerid,htf1,ta.bb(close,20,1))
	[_,p2,m2]=request.security(syminfo.tickerid,htf1,ta.bb(close,20,2))
	[_,p3,m3]=request.security(syminfo.tickerid,htf1,ta.bb(close,20,3))
	[_,p4,m4]=request.security(syminfo.tickerid,htf1,ta.bb(close,20,4))

	pseudofill(p1,p2,color.new(color.yellow,85),"+2",color.new(color.white,95),overlay=true,labeltext=color.yellow)
	pseudofill(p2,p3,color.new(color.orange,85),"",color.new(color.white,95),overlay=true)
	pseudofill(p3,p4,color.new(color.red,85),"+4",color.new(color.white,95),overlay=true,labeltext=color.red)
	pseudofill(m1,m2,color.new(color.yellow,85),"-2",color.new(color.white,95),overlay=true,labeltext=color.yellow)
	pseudofill(m2,m3,color.new(color.orange,85),"",color.new(color.white,95),overlay=true)
	pseudofill(m3,m4,color.new(color.red,85),"-4",color.new(color.white,95),overlay=true,labeltext=color.red)

pseudoplot(ta.rsi(close,7),"RSI7",color.yellow,3,labelbg=color.new(color.yellow,60),labeltext=color.yellow,format="italic")
pseudoplot(ta.rsi(close,14),"RSI14",color.orange,3,labelbg=color.new(color.orange,60),labeltext=color.orange,format="italic")

k=ta.stoch(close,high,low,14)
d=ta.sma(k,3)
sd=ta.sma(d,3)

pseudoplot(k,"%K",color.red,labelbg=color.new(color.red,60),labeltext=color.red,format="bold")
pseudoplot(d,"%D",color.green,labelbg=color.new(color.green,60),labeltext=color.green,format="bold")
pseudoplot(sd,"slow%D",color.blue,labelbg=color.new(color.blue,60),labeltext=color.blue,format="bold")

[pdi,mdi,adx]=ta.dmi(14,14)
a=plotarea("bottom",30,"DMI",color.new(color.white,80),4,color.new(color.white,95),12,color.new(color.white,70))
a.pseudoplot(pdi,"+DI",color.lime,2,labelbg=color.new(color.lime,60),labeltext=color.lime,labelsize=8)
a.pseudoplot(mdi,"-DI",color.red,2,labelbg=color.new(color.red,60),labeltext=color.red,labelsize=8)
a.pseudoplot(adx,"ADX",color.blue,2,labelbg=color.new(color.blue,60),labeltext=color.blue,labelsize=8)
a.hline(20,color.new(color.white,30),"dotted",2)
