//@version=6
// @description This library has methods that provide practical signal transmission for Pineconnector.Developed By Milvetti
library('Milvetti_Pineconnector_Library', overlay = true)


getTf(string x) =>
    v = str.tonumber(x)
    result = x
    if result==""
        result:="Chart"    

    if result=="Chart" or result=="1D" or result=="3D" or result=="1W" or result=="1M" or result=="3M" or result=="6M" or result=="12M" or result=="1S" or result=="5S" or result=="10S" or result=="15S" or result=="30S" 
        result :=result
    else if v<60
        result+="m"
    else if v>=60
        mod = v
        mod %= 60
        if mod==0 
            result:= str.tostring(v/60) + "h"
        else
            result+="m"   
    result

error(bool condition,string message)=>
	if condition==false
		runtime.error(message)


atrTsl(atrTimeframe,atrTrigger,atrPeriod,atrMultiplier,atrShift)=>
	mes = ""
	if atrTrigger!=0
		error(timeframe.in_seconds(atrTimeframe)/60>=1,"Atr Timeframe must be greater than 1")
		error(atrTrigger>0,"Atr Trigger must be greater than 0")
		error(atrPeriod>0,"Atr period must be greater than 0")
		error(atrMultiplier!=0,"Atr Multiplier cannot be equal to 0")
		error(atrShift>=0,"Atr Shift cannot be less than 0")

		mes += "atrtimeframe" + "=" + str.tostring(timeframe.in_seconds(atrTimeframe)/60) + ","
		mes += "atrperiod" + "=" + str.tostring(atrPeriod) + ","
		mes += "atrmultiplier" + "=" + str.tostring(atrMultiplier) + ","
		mes += "atrshift" + "=" + str.tostring(atrShift) + ","
		mes += "atrtrigger" + "=" + str.tostring(atrTrigger) + ","
	mes

pipsTsl(trailTrig,trailDist,trailStep)=>
	mes = ""
	if trailDist!=0
		error(trailTrig>0,"trailTrig must be greater than 0")
		error(trailDist>0,"trailDist must be greater than 0")
		error(trailStep>=0,"trailStep cannot be less than 0")
		mes += "trailtrig" + "=" + str.tostring(trailTrig) + ","
		mes += "traildist" + "=" + str.tostring(trailDist) + ","
		mes += "trailstep" + "=" + str.tostring(trailStep) + ","
	mes
breakeven(beTrigger,beOffset)=>
	mes = ""
	if beTrigger!=0
		error(beTrigger>0,"beTrigger must be greater than 0")
		mes += "betrigger" + "=" + str.tostring(beTrigger) + ","
		mes += "beoffset" + "=" + str.tostring(beOffset) + ","
	mes

filters(spread,accFilter,secret)=>
	mes = ""
	if spread!=0
		error(spread>=0,"Spread must be greater than 0")
		mes += "spread" + "=" + str.tostring(spread) + ","
	if accFilter!=0
		error(accFilter>=0,"accFilter must be greater than 0")
		mes += "accfilter" + "=" + str.tostring(accFilter) + ","
	if secret!=""
		mes += "secret" + "=" + str.tostring(secret) + ","
	mes

addslTp(sl,tp)=>
	mes = ""
	if sl!=0
		mes+= "sl" + "=" + str.tostring(sl,format.mintick) + ","
	if tp!=0
		mes+= "tp" + "=" + str.tostring(tp,format.mintick) + ","
	mes

addRisk(risk)=>
	if risk!=0
		error(risk>=0,"Risk cannot be less than 0")
		mes = "risk" + "=" + str.tostring(risk) + ","
		mes

addComment(comment,symbol)=>
	mes = "comment" + "=" + symbol + str.tostring(getTf(timeframe.period))
	if comment!=""
		mes+=comment
	mes

addPending(pending)=>
	mes = "pending" + "=" + str.tostring(pending) + ","
	mes


mainOrder(string posType, 
 string licenseId,
 string symbol = syminfo.ticker,
 float pending = 0,
 float risk,
 float sl = 0,
 float tp = 0,
 float beTrigger = 0,
 float beOffset = 0,
 int trailTrig = 0,
 int trailDist = 0,
 int trailStep = 0,
 string atrTimeframe = timeframe.period,
 float atrTrigger = 0,
 int atrPeriod = 0,
 float atrMultiplier = 1,
 float atrShift = 0,
 float spread = 0,
 float accFilter = 0,
 string secret = "",
 string comment = "")=>

	mes = ""
	mes += licenseId + ","
	mes += posType + ","
	mes += symbol + ","

	//Risk
	mes += addRisk(risk)
	//Pending
	if pending!=0
		mes += addPending(pending)
	//SL and Tp
	mes += addslTp(sl,tp)
	//Breakeven
	mes += breakeven(beTrigger,beOffset)
	// //Pips TSL
	mes += pipsTsl(trailTrig,trailDist,trailStep)
	// //ATR TSL
	mes += atrTsl(atrTimeframe,atrTrigger,atrPeriod,atrMultiplier,atrShift)
	//Filters
	mes += filters(spread,accFilter,secret)

	//Comment | Final Step
	mes += addComment(comment,symbol)
	mes	


// @function Create a buy order message
// @param licenseId License Id. This is a unique identifier found in the Pineconnector Licensing Dashboard. 
// @param symbol Symbol. Default is syminfo.ticker
// @param risk Risk. Function depends on the “Volume Type” selected in the EA 
// @param sl StopLoss. Place stop-loss. Computation is based on the Target Type selected in the EA. Default is 0(inactive)
// @param tp TakeProfit. Place take-profit. Computation is based on the Target Type selected in the EA. Default is 0(inactive)
// @param beTrigger Breakeven will be activated after the position gains this number of pips. Ensure > 0
// @param beOffset Offset from entry price. 0 means the SL will be placed exactly at entry price. 1 means 1 pip above the entry price for buy trades and 1 pip below for sell trades.
// @param trailTrig Trailing stop-loss will be activated after a trade gains this number of pips. Default is 0(inactive)
// @param trailDist SL will be opened at traildist after trailtrig is met, even if you do not have a SL placed.. Default is 0(inactive)
// @param trailStep Moves trailing stop-loss once price moves to favourable by a specified number of pips. Default is 0(inactive)
// @param atrTimeframe ATR Trailing Stop will be based on the specified timeframe in minutes and will only update once per bar close. Default is Timeframe.Period
// @param atrTrigger Activate the trigger of ATR Trailing after market moves favourably by a number of pips. Default is 0(inactive)
// @param atrPeriod ATR averaging period. Default is 0
// @param atrMultiplier Multiple of ATR to utilise in the new SL computation. Default is 1
// @param atrShift Relative shift of price information, 0 uses latest candle, 1 uses second last, etc. Default is 0
// @param spread Enter the position only if the spread is equal or less than the specified value in pips. Default is 0(inactive)
// @param accFilter Enter the position only if the account requirement is met. Default is 0(inactive)
// @param comment Comment. Add a string into the order’s comment section. Default is "Symbol+Timeframe"
export buy(string licenseId,
 string symbol = syminfo.ticker,
 float risk,
 float sl = 0,
 float tp = 0,
 float beTrigger = 0,
 float beOffset = 0,
 int trailTrig = 0,
 int trailDist = 0,
 int trailStep = 0,
 string atrTimeframe = timeframe.period,
 float atrTrigger = 0,
 int atrPeriod = 0,
 float atrMultiplier = 1,
 float atrShift = 0,
 float spread = 0,
 float accFilter = 0,
 string secret = "",
 string comment = "")=>
	
	mainOrder("buy",licenseId,symbol,0,risk,sl,tp,beTrigger,beOffset,trailTrig,trailDist,trailStep,atrTimeframe,atrTrigger,atrPeriod,atrMultiplier,atrShift,spread,accFilter,secret,comment)





