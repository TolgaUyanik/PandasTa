// @function Create a message to close all positions
// @param licenseId License Id. This is a unique identifier found in the Pineconnector Licensing Dashboard. 
// @param symbol Symbol. Default is syminfo.ticker
// @param comment Comment. Add a string into the order’s comment section. Default is "Symbol+Timeframe"
export closeAll(string licenseId, string symbol = syminfo.ticker,string comment="")=>
	mes = ""
	mes += licenseId + ","
	mes += "closeall" + ","
	mes += symbol + ","

	mes += addComment(comment,symbol)
	mes

// @function Create a message to close Long positions
// @param licenseId License Id. This is a unique identifier found in the Pineconnector Licensing Dashboard. 
// @param symbol Symbol. Default is syminfo.ticker
// @param vol Volume. Trade amount to close. Default is 0
// @param comment Comment. Add a string into the order’s comment section. Default is "Symbol+Timeframe"
export closeLong(string licenseId, string symbol = syminfo.ticker,float vol=0 ,string comment="")=>
	mes = ""
	mes += licenseId + ","
	if vol>0
		mes += "closelongvol" + ","
	else
		mes += "closelong" + ","
	mes += symbol + ","
	if vol>0
		mes += addRisk(vol)
	mes += addComment(comment,symbol)
	mes

// @function Create a message to close Long positions
// @param licenseId License Id. This is a unique identifier found in the Pineconnector Licensing Dashboard. 
// @param symbol Symbol. Default is syminfo.ticker
// @param comment Comment. Add a string into the order’s comment section. Default is "Symbol+Timeframe"
export closeLongPct(string licenseId, string symbol = syminfo.ticker,string comment="")=>
	mes = ""
	mes += licenseId + ","
	mes += "closelongpct" + ","
	mes += symbol + ","

	mes += addComment(comment,symbol)
	mes

