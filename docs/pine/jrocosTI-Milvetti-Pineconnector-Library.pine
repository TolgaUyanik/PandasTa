// @function Create a message to cancel SellLimit orders
// @param licenseId License Id. This is a unique identifier found in the Pineconnector Licensing Dashboard. 
// @param symbol Symbol. Default is syminfo.ticker
// @param comment Comment. Add a string into the order’s comment section. Default is "Symbol+Timeframe"
export cancelSellLimit(string licenseId, string symbol = syminfo.ticker,string comment="")=>
	cancel(licenseId,"selllimit",symbol,comment)

// @function Create a message to cancel SellStop orders
// @param licenseId License Id. This is a unique identifier found in the Pineconnector Licensing Dashboard. 
// @param symbol Symbol. Default is syminfo.ticker
// @param comment Comment. Add a string into the order’s comment section. Default is "Symbol+Timeframe"
export cancelSellStop(string licenseId, string symbol = syminfo.ticker,string comment="")=>
	cancel(licenseId,"sellstop",symbol,comment)


newSlTp(string licenseId, string posType, string symbol = syminfo.ticker, float sl=0, float tp=0 ,string comment="")=>
	mes = ""
	mes += licenseId + ","
	mes += "newsltp" + str.lower(posType) + ","
	mes += symbol + ","
	mes += addslTp(sl,tp)
	mes += addComment(comment,symbol)
	mes

// @function Create a meessage to change or add the sl and tp levels.
// @param licenseId License Id. This is a unique identifier found in the Pineconnector Licensing Dashboard. 
// @param symbol Symbol. Default is syminfo.ticker
// @param pending Computing pending order entry price. EA Options: Pips, Specified Price, Percentage
// @param sl StopLoss. Place stop-loss. Computation is based on the Target Type selected in the EA. Default is 0(inactive)
// @param tp TakeProfit. Place take-profit. Computation is based on the Target Type selected in the EA. Default is 0(inactive)
// @param comment Comment. Add a string into the order’s comment section. Default is "Symbol+Timeframe"
export newSlTpLong(string licenseId, string symbol = syminfo.ticker, float sl=0, float tp=0 ,string comment="")=>
	newSlTp(licenseId,"long",symbol,sl,tp,comment)

