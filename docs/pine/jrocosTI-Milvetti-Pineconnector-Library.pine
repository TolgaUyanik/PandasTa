cancel(string licenseId,string posType , string symbol = syminfo.ticker,string comment="")=>
	mes = ""
	mes += licenseId + ","
	mes += "cancel" + str.lower(posType) + ","
	mes += symbol + ","

	mes += addComment(comment,symbol)
	mes

// @function Create a message to cancel Long positions
// @param licenseId License Id. This is a unique identifier found in the Pineconnector Licensing Dashboard. 
// @param symbol Symbol. Default is syminfo.ticker
// @param comment Comment. Add a string into the order’s comment section. Default is "Symbol+Timeframe"
export cancelLong(string licenseId, string symbol = syminfo.ticker,string comment="")=>
	cancel(licenseId,"long",symbol,comment)

