//@version=5
indicator("Smart Deviation Trend Bands PRO + MTF Filter", overlay=true)

// === INPUTS ===
length = input.int(50, "SMA Length")
mult1 = input.float(1.0, "StdDev Mult 1")
mult2 = input.float(2.0, "StdDev Mult 2")
mult3 = input.float(3.0, "StdDev Mult 3")

src = close
sma = ta.sma(src, length)
std = ta.stdev(src, length)

// === Bands ===
upper1 = sma + std * mult1
lower1 = sma - std * mult1
upper2 = sma + std * mult2
lower2 = sma - std * mult2
upper3 = sma + std * mult3
lower3 = sma - std * mult3

plot(sma, color=color.blue, linewidth=2)
plot(upper1, color=color.red)
plot(lower1, color=color.green)
plot(upper2, color=color.red)
plot(lower2, color=color.green)
plot(upper3, color=color.red)
plot(lower3, color=color.green)

// === MTF TREND FILTER ===
tfFilter = input.timeframe("D", "HTF Trend Filter")
htf_sma = request.security(syminfo.tickerid, tfFilter, ta.sma(close, length))

trendUp = close > htf_sma
trendDn = close < htf_sma

plot(htf_sma, color=color.orange, linewidth=1)

// === SIGNALS ===
longSignal = ta.crossover(close, lower1) and trendUp
shortSignal = ta.crossunder(close, upper1) and trendDn

plotshape(longSignal, title="Long", style=shape.circle, location=location.belowbar, color=color.green, size=size.small)
plotshape(shortSignal, title="Short", style=shape.circle, location=location.abovebar, color=color.red, size=size.small)

// === ALERTS ===
alertcondition(longSignal, "Long Signal", "Bullish bounce + HTF trend UP")
alertcondition(shortSignal, "Short Signal", "Bearish bounce + HTF trend DOWN")
