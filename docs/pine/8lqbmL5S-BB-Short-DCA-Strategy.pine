//@version=6
strategy(
     title = "BB Short DCA Strategy",
     overlay = true,
     pyramiding = 3,
     initial_capital = 100000,
     default_qty_type = strategy.fixed)

// =====================================================
// ZAKRES TESTU
// =====================================================
startDate = timestamp(2026, 1, 1, 0, 0)

inTradeWindow = time >= startDate

// =====================================================
// USTAWIENIA
// =====================================================
bbLength      = input.int(20, title = "BB Length")
bbStd         = input.float(2.0, title = "BB StdDev")

signalAboveBB = input.float(1.0, title = "Ile % ponad BB") / 100

tpPercent     = input.float(3.0, title = "Take Profit %") / 100

// NOWE KWOTY
entry1USD     = input.float(3000, title = "Entry #1 USD")
entry2USD     = input.float(6000, title = "Entry #2 USD")
entry3USD     = input.float(12000, title = "Entry #3 USD")

// =====================================================
// BOLLINGER BANDS
// =====================================================
basis = ta.sma(close, bbLength)
dev   = ta.stdev(close, bbLength) * bbStd

upper = basis + dev
lower = basis - dev

plot(basis, color=color.yellow, title="BB Basis")
plot(upper, color=color.red, title="BB Upper")
plot(lower, color=color.green, title="BB Lower")

// =====================================================
// WARUNEK:
// świeca zamyka się >1% nad górnym BB
// =====================================================
signal = close > upper * (1 + signalAboveBB)

// =====================================================
// ZAZNACZENIE SYGNAŁÓW
// =====================================================
plotshape(
     signal and inTradeWindow,
     title = "Short Signal",
     style = shape.triangledown,
     location = location.abovebar,
     color = color.red,
     size = size.small)

// =====================================================
// ZMIENNE
// =====================================================
var float entry1Price = na
var float entry2Price = na
var float entry3Price = na

var bool entry1Opened = false
var bool entry2Opened = false
var bool entry3Opened = false

// =====================================================
// RESET po zamknięciu pozycji
// =====================================================
if strategy.position_size == 0
    entry1Opened := false
    entry2Opened := false
    entry3Opened := false

    entry1Price := na
    entry2Price := na
    entry3Price := na

// =====================================================
// ENTRY #1
// =====================================================
if signal and strategy.position_size == 0 and inTradeWindow

    qty1 = entry1USD / close

    strategy.entry(
         id = "SHORT-1",
         direction = strategy.short,
         qty = qty1)

    entry1Price := close
    entry1Opened := true

// =====================================================
// TYLKO ENTRY #1
// =====================================================
if entry1Opened and not entry2Opened

    avgPrice = entry1Price

    tpPrice = avgPrice * (1 - tpPercent)

    // TP 3%
    if low <= tpPrice
        strategy.close_all(comment = "TP AFTER ENTRY 1")

    // ENTRY #2 po wzroście 2%
    if high >= entry1Price * 1.02

        qty2 = entry2USD / close

        strategy.entry(
             id = "SHORT-2",
             direction = strategy.short,
             qty = qty2)

        entry2Price := close
        entry2Opened := true

// =====================================================
// ENTRY #1 + #2
// =====================================================
if entry1Opened and entry2Opened and not entry3Opened

    avgPrice =
         (entry1Price * entry1USD +
          entry2Price * entry2USD) /
         (entry1USD + entry2USD)

    tpPrice = avgPrice * (1 - tpPercent)

    // TP 3%
    if low <= tpPrice
        strategy.close_all(comment = "TP AFTER ENTRY 2")

    // ENTRY #3 po wzroście 4% od entry #2
    if high >= entry2Price * 1.04

        qty3 = entry3USD / close

        strategy.entry(
             id = "SHORT-3",
             direction = strategy.short,
             qty = qty3)

        entry3Price := close
        entry3Opened := true

// =====================================================
// ENTRY #1 + #2 + #3
// =====================================================
if entry1Opened and entry2Opened and entry3Opened

    avgPrice =
         (entry1Price * entry1USD +
          entry2Price * entry2USD +
          entry3Price * entry3USD) /
         (entry1USD + entry2USD + entry3USD)

    tpPrice = avgPrice * (1 - tpPercent)

    // TP 3%
    if low <= tpPrice
        strategy.close_all(comment = "TP AFTER ENTRY 3")

// =====================================================
// ŚREDNIA CENA WEJŚCIA
// =====================================================
plot(
     strategy.position_size != 0
     ? strategy.position_avg_price
     : na,
     title = "Average Entry Price",
     color = color.orange,
     linewidth = 2)