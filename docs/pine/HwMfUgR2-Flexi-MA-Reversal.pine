//@version=5
indicator(title="Flexi MA Reversal", overlay=true, max_lines_count=500)

// =====================================================================
// ============================= INPUTS ================================
// =====================================================================

// === GROUP: MA Settings ===
groupMA = "Moving Averages"

ma_type = input.string("EMA", "MA Calculation Type", options=["EMA", "SMA", "WMA", "VWMA"], group=groupMA)

// MA1 Settings
enableMa1 = input.bool(true, "Enable MA 1", inline="ma1", group=groupMA)
ma1Length  = input.int(8, "Length", inline="ma1", group=groupMA)
ma1Color   = input.color(color.silver, "", inline="ma1", group=groupMA)

// MA2 Settings
enableMa2 = input.bool(true, "Enable MA 2", inline="ma2", group=groupMA)
ma2Length  = input.int(50, "Length", inline="ma2", group=groupMA)
ma2Color   = input.color(color.orange, "", inline="ma2", group=groupMA)

// MA3 Settings
enableMa3 = input.bool(true, "Enable MA 3", inline="ma3", group=groupMA)
ma3Length  = input.int(100, "Length", inline="ma3", group=groupMA)
ma3Color   = input.color(color.green, "", inline="ma3", group=groupMA)

// === GROUP: Display Settings ===
groupDisplay = "Display Settings"
lineExtendBars = input.int(10, "Line Length (bars)", minval=1, group=groupDisplay, tooltip="Number of bars the signal/alert lines will extend")
entryWindow    = input.int(8, "Entry Window (bars)", minval=1, group=groupDisplay, tooltip="Monitor N bars after a signal for entry confirmation")
lineDisplayMode = input.string("Signal Only", "Line Display Mode", 
     options=["None", "Signal Only", "Alert Only", "Both"], group=groupDisplay, tooltip="Choose which lines to display on chart")

// === GROUP: Signal & Alert Colors ===
groupColors = "Signal & Alert Colors"
bullishSignalColor = input.color(color.green, "Bullish Signal Line", group=groupColors)
bearishSignalColor = input.color(color.red, "Bearish Signal Line", group=groupColors)
bullishAlertColor  = input.color(color.rgb(92, 213, 243), "Bullish Alert Line / Candle", group=groupColors)
bearishAlertColor  = input.color(color.rgb(248, 177, 24), "Bearish Alert Line / Candle", group=groupColors)

// === GROUP: Alerts ===
groupAlerts = "Alerts Settings"
enableAlerts = input.bool(true, "Enable TradingView Alerts", group=groupAlerts, tooltip="Generate alerts for bullish/bearish signals or entries")

// =====================================================================
// ============================= MA CALCULATION ========================
// =====================================================================

get_ma(src, len) =>
    switch ma_type
        "SMA"  => ta.sma(src, len)
        "EMA"  => ta.ema(src, len)
        "WMA"  => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        => na

ma1 = enableMa1 ? get_ma(close, ma1Length) : na
ma2 = enableMa2 ? get_ma(close, ma2Length) : na
ma3 = enableMa3 ? get_ma(close, ma3Length) : na

plot(ma1, "MA 1", color=ma1Color, linewidth=2)
plot(ma2, "MA 2", color=ma2Color, linewidth=1)
plot(ma3, "MA 3", color=ma3Color, linewidth=1)

// =====================================================================
// =========================== LINE DISPLAY TOGGLES ====================
// =====================================================================

showSignals = (lineDisplayMode == "Signal Only" or lineDisplayMode == "Both")
showAlerts  = (lineDisplayMode == "Alert Only" or lineDisplayMode == "Both")

if lineDisplayMode == "None"
    showSignals := false
    showAlerts  := false

// =====================================================================
// ========================= STATE VARIABLES ===========================
// =====================================================================

var float bullishAlertHigh = na
var float bullishAlertLow  = na
var line  activeBullishAlertLine = na
var line  lastBullishSignalLine  = na

var float bearishAlertHigh = na
var float bearishAlertLow  = na
var line  activeBearishAlertLine = na
var line  lastBearishSignalLine  = na

var float et_lastBullishSignalPrice = na
var int   et_lastBullishSignalBar   = na
var bool  et_lastBullishSignalAbove50 = false
var bool  et_lastBullishSignalBelow50 = false
var bool  et_lastBullishSignalActive  = false
var bool  et_lastBullishSignalConsumed = false

var float et_lastBearishSignalPrice = na
var int   et_lastBearishSignalBar   = na
var bool  et_lastBearishSignalAbove50 = false
var bool  et_lastBearishSignalBelow50 = false
var bool  et_lastBearishSignalActive  = false
var bool  et_lastBearishSignalConsumed = false

// =====================================================================
// ============================ BULLISH LOGIC ==========================
// =====================================================================

isBullishAlert = close < ma1 and high < ma1
if isBullishAlert
    bullishAlertHigh := high
    bullishAlertLow  := low
    if showAlerts
        if not na(activeBullishAlertLine)
            line.delete(activeBullishAlertLine)
        activeBullishAlertLine := line.new(bar_index, high, bar_index + lineExtendBars, high, width=1, color=bullishAlertColor)

isBullishSignal = not na(bullishAlertHigh) and close > bullishAlertHigh and close > ma1
if isBullishSignal
    if showSignals
        lastBullishSignalLine := line.new(bar_index, close, bar_index + lineExtendBars, close, width=2, color=bullishSignalColor)
    et_lastBullishSignalPrice := close
    et_lastBullishSignalBar   := bar_index
    et_lastBullishSignalAbove50 := close > ma2
    et_lastBullishSignalBelow50 := close < ma2
    et_lastBullishSignalActive := true
    et_lastBullishSignalConsumed := false
    bullishAlertHigh := na
    bullishAlertLow  := na
    activeBullishAlertLine := na

if not na(bullishAlertLow) and close >= ma1
    bullishAlertHigh := na
    bullishAlertLow  := na
    if not na(activeBullishAlertLine)
        line.delete(activeBullishAlertLine)
    activeBullishAlertLine := na

// =====================================================================
// ============================ BEARISH LOGIC ==========================
// =====================================================================

isBearishAlert = close > ma1 and low > ma1
if isBearishAlert
    bearishAlertHigh := high
    bearishAlertLow  := low
    if showAlerts
        if not na(activeBearishAlertLine)
            line.delete(activeBearishAlertLine)
        activeBearishAlertLine := line.new(bar_index, low, bar_index + lineExtendBars, low, width=1, color=bearishAlertColor)

isBearishSignal = not na(bearishAlertLow) and close < bearishAlertLow and close < ma1
if isBearishSignal
    if showSignals
        lastBearishSignalLine := line.new(bar_index, close, bar_index + lineExtendBars, close, width=2, color=bearishSignalColor)
    et_lastBearishSignalPrice := close
    et_lastBearishSignalBar   := bar_index
    et_lastBearishSignalAbove50 := close > ma2
    et_lastBearishSignalBelow50 := close < ma2
    et_lastBearishSignalActive := true
    et_lastBearishSignalConsumed := false
    bearishAlertHigh := na
    bearishAlertLow  := na
    activeBearishAlertLine := na

if not na(bearishAlertHigh) and close <= ma1
    bearishAlertHigh := na
    bearishAlertLow  := na
    if not na(activeBearishAlertLine)
        line.delete(activeBearishAlertLine)
    activeBearishAlertLine := na

// =====================================================================
// ========================= ENTRY DETECTION LOGIC =====================
// =====================================================================

bullishEntry = false
bearishEntry = false

if close > ma2
    if et_lastBullishSignalActive and not et_lastBullishSignalConsumed
        if bar_index - et_lastBullishSignalBar <= entryWindow
            if close > et_lastBullishSignalPrice and et_lastBullishSignalAbove50
                bullishEntry := true
                et_lastBullishSignalConsumed := true
                et_lastBullishSignalActive := false
        else
            et_lastBullishSignalActive := false

    if not bullishEntry and et_lastBearishSignalActive and not et_lastBearishSignalConsumed
        if bar_index - et_lastBearishSignalBar <= entryWindow
            if close > et_lastBearishSignalPrice and et_lastBearishSignalAbove50
                bullishEntry := true
                et_lastBearishSignalConsumed := true
                et_lastBearishSignalActive := false
        else
            et_lastBearishSignalActive := false

if close < ma2
    if et_lastBearishSignalActive and not et_lastBearishSignalConsumed
        if bar_index - et_lastBearishSignalBar <= entryWindow
            if close < et_lastBearishSignalPrice and et_lastBearishSignalBelow50
                bearishEntry := true
                et_lastBearishSignalConsumed := true
                et_lastBearishSignalActive := false
        else
            et_lastBearishSignalActive := false

    if not bearishEntry and et_lastBullishSignalActive and not et_lastBullishSignalConsumed
        if bar_index - et_lastBullishSignalBar <= entryWindow
            if close < et_lastBullishSignalPrice and et_lastBullishSignalBelow50
                bearishEntry := true
                et_lastBullishSignalConsumed := true
                et_lastBullishSignalActive := false
        else
            et_lastBullishSignalActive := false

// =====================================================================
// ========================= PLOT ENTRY TRIANGLES =====================
// =====================================================================

plotshape(bullishEntry, title="Bullish Entry", style=shape.triangleup,  location=location.belowbar, color=bullishSignalColor, size=size.tiny)
plotshape(bearishEntry, title="Bearish Entry", style=shape.triangledown, location=location.abovebar, color=bearishSignalColor, size=size.tiny)

// =====================================================================
// ========================= TRADINGVIEW ALERTS ========================
// =====================================================================

if enableAlerts
    if bullishEntry
        alert("Bullish Entry Detected!", alert.freq_once_per_bar)
    if bearishEntry
        alert("Bearish Entry Detected!", alert.freq_once_per_bar)
    if isBullishSignal
        alert("Bullish Signal Detected!", alert.freq_once_per_bar)
    if isBearishSignal
        alert("Bearish Signal Detected!", alert.freq_once_per_bar)
