//@version=5
indicator("RELIANCE: 3 Bullish Candles + VWAP", overlay=true)

// === Strategy Logic ===
bull_candle1 = close > open
bull_candle2 = close[1] > open[1]
bull_candle3 = close[2] > open[2]

vwap = ta.vwap
above_vwap = close > vwap and close[1] > vwap and close[2] > vwap

signal = bull_candle1 and bull_candle2 and bull_candle3 and above_vwap

// === Visual Feedback ===
bgcolor(signal ? color.new(color.green, 85) : na)
plotshape(signal, title="Long Signal", location=location.belowbar, style=shape.labelup, color=color.green, size=size.small, text="BUY")

// === Alert Condition ===
alertcondition(signal, title="RELIANCE Signal", message="BUY Signal on RELIANCE: 3 Bullish Candles above VWAP (15m)")