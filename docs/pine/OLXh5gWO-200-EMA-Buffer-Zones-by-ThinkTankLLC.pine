//@version=6
indicator("200 EMA + Buffer Zones by ThinkTankLLC", overlay=true)

// ── Original inputs ─────────────────────────────────────
length       = input.int(10, "Supertrend Length")
multiplier   = input.float(3.0, "Supertrend Multiplier")
emaPeriod    = input.int(200, "EMA Period")
// ── Buffer inputs ───────────────────────────────────────
innerPct     = input.float(5.0, "Strike-zone buffer % (set limit order here)", step=0.5)
outerPct     = input.float(7.0, "Early-warning % (start watching)", step=0.5)
showZones    = input.bool(true, "Show buffer zones")
useBuiltinST = input.bool(false, "Use TradingView's built-in Supertrend (fixes original calc)")

// ── Series computed once per bar (v6 requires these outside loops) ──
chg    = ta.change(close)
atrVal = ta.atr(length)
ema200 = ta.ema(close, emaPeriod)

// ── Original Supertrend (logic preserved) ───────────────
var float supertrend  = na
var float highestHigh = na
var float lowestLow   = na
for i = length to 1
    if chg[i] > 0
        highestHigh := math.max(highestHigh, high[i])
    else
        lowestLow := math.min(lowestLow, low[i])
    supertrend := chg > 0 ? lowestLow + multiplier * atrVal : highestHigh - multiplier * atrVal

// optional fix: TradingView's native supertrend
[stNative, stDir] = ta.supertrend(multiplier, length)
stFinal = useBuiltinST ? stNative : supertrend

supertrendColor = stFinal > ema200 ? color.green : color.red
emaColor        = close > ema200 ? color.green : color.red

plot(stFinal, color=supertrendColor, title="Supertrend")
plot(ema200,  color=emaColor, title="200 EMA", linewidth=2)

// ── Buffer zones around the green line ──────────────────
upIn  = ema200 * (1 + innerPct / 100)
dnIn  = ema200 * (1 - innerPct / 100)
upOut = ema200 * (1 + outerPct / 100)
dnOut = ema200 * (1 - outerPct / 100)

pUpIn  = plot(showZones ? upIn  : na, "+5% zone", color=color.new(color.green, 60))
pDnIn  = plot(showZones ? dnIn  : na, "−5% zone", color=color.new(color.green, 60))
pUpOut = plot(showZones ? upOut : na, "+7% warn", color=color.new(color.orange, 70))
pDnOut = plot(showZones ? dnOut : na, "−7% warn", color=color.new(color.orange, 70))
fill(pUpIn,  pDnIn,  color=color.new(color.green, 88),  title="Strike zone (±5%)")
fill(pUpOut, pUpIn,  color=color.new(color.orange, 93), title="Warning 5–7% upper")
fill(pDnIn,  pDnOut, color=color.new(color.orange, 93), title="Warning 5–7% lower")

// ── Distance + zone states ──────────────────────────────
dist    = (close - ema200) / ema200 * 100
absDist = math.abs(dist)
inInner = absDist <= innerPct
inOuter = absDist <= outerPct
enterInnerAbove = inInner and not inInner[1] and close > ema200
enterInnerBelow = inInner and not inInner[1] and close < ema200
enterOuter      = inOuter and not inOuter[1]
touchedEMA      = low <= ema200 and high >= ema200

// live readout, top-right
var table t = table.new(position.top_right, 1, 1)
if barstate.islast
    zoneTxt = inInner ? "⚡ STRIKE ZONE" : inOuter ? "⚠ approaching" : ""
    table.cell(t, 0, 0, str.tostring(dist, "#.##") + "% from 200 EMA " + zoneTxt,
      text_color = inInner ? color.green : inOuter ? color.orange : color.gray,
      bgcolor = color.new(color.black, 40), text_size = size.small)

// ── Original Buy/Sell signals (preserved) ───────────────
buyCondition  = ta.crossover(close, ema200) and close > stFinal
sellCondition = ta.crossunder(close, ema200) and close < stFinal
plotshape(buyCondition,  title="Buy Signal",  location=location.belowbar, color=color.green, style=shape.labelup,   text="Buy")
plotshape(sellCondition, title="Sell Signal", location=location.abovebar, color=color.red,   style=shape.labeldown, text="Sell")

// ── The never-miss-MNST-again alerts ────────────────────
alertcondition(enterOuter,      "① Approaching — inside 7%", "{{ticker}}: within 7% of the 200 EMA ({{close}}). Start watching.")
alertcondition(enterInnerAbove, "② STRIKE ZONE from above",  "{{ticker}}: entered the 5% buffer from ABOVE ({{close}}). SET THE LIMIT ORDER NOW.")
alertcondition(enterInnerBelow, "③ STRIKE ZONE from below",  "{{ticker}}: entered the 5% buffer from BELOW ({{close}}).")
alertcondition(touchedEMA,      "④ 200 EMA TOUCHED",         "{{ticker}}: tapped the 200 EMA ({{close}}). Order should already be resting.")