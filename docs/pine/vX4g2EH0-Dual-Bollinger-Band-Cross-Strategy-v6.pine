//@version=6
strategy("Dual Bollinger Band Cross Strategy v6", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// --- Inputs ---
// Slow Bollinger Band (10, 2)
int slowLength     = input.int(10, title="Slow BB Length")
float slowStdDev   = input.float(2.0, title="Slow BB StdDev")

// Fast Bollinger Band (5, 1)
int fastLength     = input.int(5, title="Fast BB Length")
float fastStdDev   = input.float(1.0, title="Fast BB StdDev")

// --- Calculations ---
// Slow BB Basis (Midline)
[slowMid, slowUpper, slowLower] = ta.bb(close, slowLength, slowStdDev)

// Fast BB Basis (Midline)
[fastMid, fastUpper, fastLower] = ta.bb(close, fastLength, fastStdDev)

// --- Plotting ---
// Only plotting the midlines as requested
plot(slowMid, color=color.blue, title="Slow BB Midline (10,2)", linewidth=2)
plot(fastMid, color=color.orange, title="Fast BB Midline (5,1)", linewidth=2)

// --- Strategy Conditions ---
// Entry: Fast midline > Slow midline AND Close > Fast midline
bool longCondition = (fastMid > slowMid) and (close > fastMid)

// Exit: Close < Slow midline
bool exitCondition = close < slowMid

// --- Execution ---
// Entry
if (longCondition)
    strategy.entry("Long", strategy.long)

// Exit
if (exitCondition)
    strategy.close("Long", comment="Exit Signal")