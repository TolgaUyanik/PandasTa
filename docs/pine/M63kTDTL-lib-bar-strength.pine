//@version=6
// @description Big bar breakout detection. Tracks last breakout event type and levels.
// Call via request.security() per timeframe.
// Event types: 0=none, 1=BULL BREAK, 2=BEAR BREAK, 3=POSS BULL, 4=POSS BEAR
library("lib_bar_strength", overlay=true)

// Detect big bar breakout events. Returns the LAST event (persists via var state).
// atrLen: ATR calculation length, atrMult: minimum bar range in ATRs
// Returns: [event_type, bar_high, bar_low, bar_mid, atr_multiple]
export detect_big_bar(simple int atrLen, simple float atrMult) =>
    var float ev_type = 0.0
    var float ev_high = na
    var float ev_low = na
    var float ev_mid = na
    var float ev_atr_x = na

    float pH = high[1]
    float pL = low[1]
    float bRange = high - low
    float atr_val = ta.atr(atrLen)
    bool isBig = bRange >= atrMult * atr_val

    bool isBullBreak = close > pH and isBig
    bool isBearBreak = close < pL and isBig
    bool isNonBrk = isBig and not isBullBreak and not isBearBreak
    bool isPossBull = isNonBrk and close > open
    bool isPossBear = isNonBrk and close < open

    if barstate.isconfirmed
        if isBullBreak
            ev_type := 1.0
            ev_high := high
            ev_low := low
            ev_mid := (high + low) / 2.0
            ev_atr_x := math.round(bRange / atr_val, 1)
        else if isBearBreak
            ev_type := 2.0
            ev_high := high
            ev_low := low
            ev_mid := (high + low) / 2.0
            ev_atr_x := math.round(bRange / atr_val, 1)
        else if isPossBull
            ev_type := 3.0
            ev_high := high
            ev_low := low
            ev_mid := (high + low) / 2.0
            ev_atr_x := math.round(bRange / atr_val, 1)
        else if isPossBear
            ev_type := 4.0
            ev_high := high
            ev_low := low
            ev_mid := (high + low) / 2.0
            ev_atr_x := math.round(bRange / atr_val, 1)

    [ev_type, ev_high, ev_low, ev_mid, ev_atr_x]
