//@version=6
indicator("Earnings [theUltimator5]", overlay = true)


// == User input ==
show_days_between = input.bool(true, title="Show Days Between Earnings")

// == Request data for earnings of current chart.  Doesn't work on symbols that don't have earnings. ==
new_earnings = (syminfo.type == 'stock' or syminfo.type == 'dr') 
     ? request.security('ESD:' + syminfo.prefix + ';' + syminfo.ticker + ';EARNINGS', 'D', close, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off) 
     : na

// === Variable to track last earnings date ===
var int last_earnings_bar = na
var int last_earnings_time = na

// === Function: Daily % Change ===
get_daily_change() =>
    (close-close[1]) > 0 ? (close - close[1]) / close[1] * 100 : (close - close[1]) / close[1] * 100

// === Function: Color by % Change ===
get_change_color(change_pct) =>
    if change_pct >= 10.0
        color.green
    else if change_pct <= -10.0
        color.red
    else if math.abs(change_pct) < 0.01
        color.gray
    else if change_pct > 0
        intensity = math.min(change_pct / 10.0, 1.0)
        transparency = math.round(100 - (intensity * 100))
        color.new(color.green, transparency)
    else
        intensity = math.min(math.abs(change_pct) / 10.0, 1.0)
        transparency = math.round(100 - (intensity * 100))
        color.new(color.red, transparency)

// === Function: Text Color that fades to white ===
get_text_color(change_pct) =>
    if change_pct >= 10.0
        color.green  // Full green at +10%
    else if change_pct <= -10.0
        color.red    // Full red at -10%
    else if math.abs(change_pct) < 0.01
        color.white  // White at 0%
    else if change_pct > 0
        // Fade from white to green (0% to +10%)
        intensity = math.min(change_pct / 10.0, 1.0)
        // Calculate RGB values: start from white (255,255,255) and move toward green (0,255,0)
        red_val = math.round(255 * (1 - intensity))    // Less red as intensity increases
        green_val = 255                                // Always full green
        blue_val = math.round(255 * (1 - intensity))   // Less blue as intensity increases
        color.rgb(red_val, green_val, blue_val)
    else
        // Fade from white to red (0% to -10%)
        intensity = math.min(math.abs(change_pct) / 10.0, 1.0)
        // Calculate RGB values: start from white (255,255,255) and move toward red (255,0,0)
        red_val = 255                                  // Always full red
        green_val = math.round(255 * (1 - intensity))  // Less green as intensity increases
        blue_val = math.round(255 * (1 - intensity))   // Less blue as intensity increases
        color.rgb(red_val, green_val, blue_val)

// === Function: Plot Price Change Labels ===
plot_price_change_label(change_pct) =>
    if not na(high) and not na(low) and high > low
        // Get the highest point across the entire visible chart
        chart_high = ta.highest(high, 5)
        chart_low = ta.lowest(low, 5)
        chart_range = chart_high - chart_low
        
        // Position label above the highest price point
        label_y = chart_high + (chart_range * 0.15)
        
        // Position "E" marker slightly below the percentage label
        e_marker_y = label_y - (chart_range * 0.05)
        
        // Create label
        if not na(label_y) and not na(change_pct)
            line_color = get_change_color(change_pct)
            text_color = get_text_color(change_pct)
            
            earnings_label = label.new(
                 x=bar_index,
                 y=label_y,
                 text=str.tostring(change_pct, "#.##") + "%\n Earnings",
                 style=label.style_none,
                 textcolor=text_color,
                 color=color.new(color.white, 20),
                 size=size.normal
             )

// === Function: Plot Days Between Earnings ===
plot_days_between_label(days_count) =>
    if not na(high) and not na(low) and high > low and show_days_between
        // Get the chart range for positioning
        chart_high = ta.highest(high, 200)
        chart_low = ta.lowest(low, 200)
        chart_range = chart_high - chart_low
        
        // Position label at the bottom of the chart
        label_y = ta.lowest(5) //- (chart_range * 0.10)
        
        // Create label showing days since last earnings (multi-line)
        if not na(label_y) and not na(days_count) and days_count > 0
            days_label = label.new(
                 x=bar_index,
                 y=label_y,
                 text=str.tostring(days_count) + " days\nsince last earnings",
                 style=label.style_none,
                 textcolor=color.yellow,
                 color=color.new(color.black, 80),
                 size=size.small
             )

// Calculate price change and background color for earnings days only
daily_change = get_daily_change()
is_earnings_day = not na(new_earnings)

// Track days between earnings
if is_earnings_day
    if not na(last_earnings_bar) and not na(last_earnings_time)
        // Calculate calendar days between earnings (milliseconds to days)
        calendar_days = math.round((time - last_earnings_time) / (1000 * 60 * 60 * 24))
        
        // Plot the days count on the current earnings date
        plot_days_between_label(calendar_days)
    
    last_earnings_bar := bar_index
    last_earnings_time := time

// Background color only on earnings days
bg_color = is_earnings_day ? color.new(get_change_color(daily_change), 70) : na
bgcolor(bg_color)

// Plot labels only on earnings days
if is_earnings_day
    plot_price_change_label(daily_change)