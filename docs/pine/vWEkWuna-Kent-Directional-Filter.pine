//@version=6
indicator("Kent Directional Filter", overlay=false, timeframe = "", timeframe_gaps = true, dynamic_requests = true)

source = input.source(close, title = "Source")
direction = input.float(4, minval=1, title="Pi Divisor", tooltip = "Calculate Price Radians.")
kappa = input.float(1.0, title="Concentration (κ)", tooltip="Controls directionality strength")
beta = input.float(0.5, title="Ellipticity (β)", tooltip="Controls ovalness of the distribution")
length = input.int(10, minval=1, title="Smoothing Length")
length2 = input.int(34, minval=1, title="Signal Length")

// Kent probability density-inspired weighting function
kent_density(src, dir, kappa, beta) =>
    // Rough approximation of directional angle in price movement
    angle = math.atan(src - src[1])
    mu = math.pi / dir  // Preferred direction: 45 degrees
    //Calculate Kent
    cos_theta = math.cos(angle - mu)
    sin_theta = math.sin(angle - mu)
    val = math.exp(kappa * cos_theta + beta * sin_theta * sin_theta)
    val

// Apply filter
value = kent_density(source, direction, kappa, beta)
kent_smoothed = ta.sma(value, length)
kent_smoothed2 = ta.sma(kent_smoothed, length2)

// Plot results
plot(value, title="Kent Raw Value", color=color.gray)
plot(kent_smoothed, title="Kent Smoothed", color=color.blue)
plot(kent_smoothed2, title="Kent Smoothed Signal", color=color.orange)
