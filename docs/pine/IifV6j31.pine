dayToCN(string day) =>
    switch day
        "Monday"    => "星期一"
        "Tuesday"   => "星期二"
        "Wednesday" => "星期三"
        "Thursday"  => "星期四"
        "Friday"    => "星期五"
        "Saturday"  => "星期六"
        "Sunday"    => "星期日"
        => day

holidayToCN(string h) =>
    switch h
        "New Year's Day"                              => "新年"
        "MLK Jr. Day"                                 => "马丁·路德·金纪念日"
        "Washington Day"                              => "华盛顿诞辰"
        "Good Friday"                                 => "耶稣受难日"
        "Memorial Day"                                => "阵亡将士纪念日"
        "Juneteenth Independence Day"                 => "六月节"
        "Columbus Day"                                => "哥伦布日"
        "Independence Day"                            => "美国独立日"
        "Labor Day"                                   => "劳动节"
        "Thanksgiving Day"                            => "感恩节"
        "Christmas Day"                               => "圣诞节"
        "Veterans Day"                                => "退伍军人节"
        "Easter Sunday"                               => "复活节"
        => h
// @type HolidayMetaData
// @field holiday `string` - The name of the holiday.
// @field dayOfYear `int` - The day of the year of the holiday.
// @field monthOfYear `int` - The month of the year of the holiday.
// @field dayOfMonth `int` - The day of the month of the holiday.
// @field weekOfMonth `int` - The week of the month of the holiday.
// @field dayOfWeek `int` - The day of the week of the holiday.
// @field lastOccurenceInMonth `bool` - Flag indicating whether the holiday is the last occurrence of the day in the month.
// @field closingTime `int` - The closing time of the holiday.
// @field utc `int` - The UTC time shift in hours.
export type HolidayMetaData
    string holiday=""
    int dayOfYear=na
    int monthOfYear=na
    int dayOfMonth=na
    int weekOfMonth=na
    int dayOfWeek=na
    bool lastOccurrenceInMonth=na

    
// @type HolidayObject
// @field holidaysMap `map<string, HolidayMetaData>` - The map of holidays.
// @field newHoliday `bool` - Flag indicating whether today is a new holiday.
// @field activeHoliday `bool` - Flag indicating whether today is an active holiday.
// @field holiday `string` - The name of the holiday. 
// @field dayString `string` - The day of the week of the holiday.
export type HolidayObject
    map<string, HolidayMetaData> holidaysMap=na
    bool newHoliday=na
    bool activeHoliday=na
    string holiday=na
    string dayString=na


// @function Helper Function to make a label
// @param nowMonthOfYear `int` - The month of the year of the holiday.
// @param nowDayOfMonth `int` - The day of the month of the holiday.
// @param dayString `string` - The day of the week of the holiday.
// @param holiday `string` - The name of the holiday.
// @returns `label` - The label object.
makeLabel(nowMonthOfYear, nowDayOfMonth, dayString, holiday) =>

    label.new(
         x=bar_index, 
         y=high, 
         text=str.replace_all(
             str.format(
                 "{0}/{1}/{2}\n{3}\n{4}\n↓", 
                 nowMonthOfYear, //0
                 nowDayOfMonth,  //1
                 year,           //2
                 dayToCN(dayString),      //3
                 holidayToCN(holiday)         //4
             ),
         ",", ""),  
         yloc=yloc.abovebar,                
         style=label.style_label_down, 
         textalign=text.align_center,
         color=#0000ff00, 
         textcolor=chart.fg_color, 
         size="normal"
     )


// @function Calculates the date of Easter Sunday for a given year using the Anonymous Gregorian algorithm.
// `Gauss Algorithm for Easter Sunday` was developed by the mathematician Carl Friedrich Gauss
// This algorithm is based on the cycles of the moon and the fact that Easter always falls on the first Sunday after the first ecclesiastical full moon that occurs on or after March 21.
// While it's not considered to be 100% accurate due to rare exceptions, it does give the correct date in most cases.
// It's important to note that Gauss's formula has been found to be inaccurate for some 21st-century years in the Gregorian calendar. Specifically, the next suggested failure years are 2038, 2051. 
// This function can be used for Good Friday (Friday before Easter), Easter Sunday, and Easter Monday (following Monday).
// https://en.wikipedia.org/wiki/Date_of_Easter#Algorithms
// @param _year `int` - The year for which to calculate the date of Easter Sunday. This should be a four-digit year (YYYY).
// @returns tuple [int month, int day] - The month (1-12) and day (1-31) of Easter Sunday for the given year.
export EasterAlgo(int _year=year) =>
    int _a = _year % 19
    int _b = math.floor(_year/100)
    int _c = _year % 100
    int _d = math.floor(_b / 4)
    int _e = _b % 4
    int _f = math.floor((_b + 8) / 25)
    int _g = math.floor((_b - _f + 1) / 3)
    int _h = (19 * _a + _b - _d - _g + 15) % 30
    int _i = math.floor(_c / 4)
    int _k = _c % 4
    int _l = (32 + 2 * _e + 2 * _i - _h - _k) % 7
    int _m = math.floor((_a + 11 * _h + 22 * _l) / 451)
    int _month = math.floor((_h + _l - 7 * _m + 114) / 31)
    int _day = ((_h + _l - 7 * _m + 114) % 31)+1
    [_month, _day]


// @function Inits the date of Easter Sunday and Good Friday for a given year.
// @returns tuple [int easterMonth, int easterDay, int goodFriday, int goodFridayMonth] - The month (1-12) and day (1-31) of Easter Sunday and Good Friday for the given year.
export easterInit() =>
    [easterMonth,easterDay] = EasterAlgo()
    int goodFriday = na
    int goodFridayMonth = na

    if easterDay-2 > 0 
        goodFriday := easterDay-2
        goodFridayMonth := easterMonth
    else
        goodFriday := 31-math.abs(easterDay-2)
        goodFridayMonth := easterMonth-1
    
    [easterDay, easterMonth, goodFriday, goodFridayMonth]


// @function Determine if a year is a leap year.
// @param _year `int` - 4 digit year to check => YYYY
// @returns `bool` - true if input year is a leap  year
export isLeapYear(int _year=year) => (_year % 4 == 0 and _year % 100 != 0) or _year % 400 == 0

    
// @function Helper function to convert UTC time.
// @param utc `int` - UTC time shift in hours.
// @returns `string`- UTC time string with shift applied.
export method timezoneHelper(int utc) =>
    if na(utc)
        runtime.error("UTC is not defined:" + str.tostring(utc))

	string utcStr = str.tostring(utc)
    string timezone = "UTC" 
	timezone += if utc > -1
        "+" + utcStr
    else
        utcStr
	timezone


// @function Function to find the week of the month of a given Unix Time.
// @returns number - The week of the month of the specified UTC time. 
export weekofmonth() =>

    int dom = dayofmonth
    int dow = dayofweek
        
    int weekOfMonth = 0
    int startOfMonthPartialWeekDayAmount = (dom-dow)%7
    if math.abs(startOfMonthPartialWeekDayAmount) > 0
        weekOfMonth += 1
    weekOfMonth += int(dom/7)
    weekOfMonth


// @function dayLightSavingsAdjustedUTC
// @param utc `int` - The normal UTC timestamp to be used for reference.
// @param adjustForDLS `bool` - Flag indicating whether to adjust for daylight savings time (DLS).
// @returns `int` - The adjusted UTC timestamp for the given normal UTC timestamp.
export dayLightSavingsAdjustedUTC(int utc=na, bool adjustForDLS=true) =>
    
    bool toAdd = false

    for i = 0 to 0
        if not adjustForDLS
            break

        if month > 3 and month < 11 
            toAdd := true
            break

        if month < 3 or month > 11
            break
            
        if month == 3 and dayofmonth >= 8
            if weekofmonth() > 1 and (dayofmonth-dayofweek) >= 8
                toAdd := true
            break

        if month == 11 and dayofmonth <= 7
            if weekofmonth() == 1 and (dayofmonth-dayofweek) <= 1
                toAdd := true
            break
    
    utc + (nz(toAdd, false) ? 1 : 0)


// @function Function gets the day of the year of a given holiday (1-366)
// @param monthOfYear `int` - The month of the year of the holiday.
// @param dayOfMonth `int` - The day of the month of the holiday.
// @param weekOfMonth `int` - The week of the month of the holiday.
// @param dayOfWeek `int` - The day of the week of the holiday.
// @param lastOccurrenceInMonth `bool` - Flag indicating whether the holiday is the last occurrence of the day in the month.
// @param holiday `string` - The name of the holiday.
// @returns `int` - The day of the year of the holiday 1-366.
export getDayOfYear(int monthOfYear=na, int dayOfMonth=na, int weekOfMonth=na, int dayOfWeek=na, bool lastOccurrenceInMonth=na, string holiday="undefined") =>

    int timestampForHoliday = na
    
    // If the day and month of the holiday are defined
    if not na(monthOfYear) and not na(dayOfMonth) and na(lastOccurrenceInMonth)
        // format time into day of the year ("DDD"), day of the month ("dd") and month of the year ("MM")
        timestampForHoliday := timestamp(year=year, month=monthOfYear, day=dayOfMonth)
        log.info("timestampForHoliday: {0}\ntime: {1}", timestampForHoliday, time)
        
    // If the week of the month, day of the week, and month of the holiday are defined
    else if not na(monthOfYear) and not na(dayOfWeek) and not na(weekOfMonth) or lastOccurrenceInMonth
        // Variables for occurrence tracking
        int occurrence = 0
        // Get the number of days in the month
        array<int> monthDays = array.from(31,isLeapYear(year)?29:28,31,30,31,30,31,31,30,31,30,31)
        // For each day of the month
        for int day = 1 to monthDays.get(monthOfYear-1)
            // Generate a timestamp for that day
            int currentTimestamp = timestamp(year=year, month=monthOfYear, day=day)
            // Check if the day is the last occurrence of the day in the month
            if lastOccurrenceInMonth
                msInDay = 86400000
                if str.format_time(currentTimestamp+(msInDay*7), "MM") != str.format_time(currentTimestamp, "MM")
                    // If the day of the week of the timestamp matches the day of the week of the holiday
                    if dayofweek(currentTimestamp) == dayOfWeek
                        // Set the timestamp for the holiday
                        timestampForHoliday := currentTimestamp
                        break
            // If the day of the week of the timestamp matches the day of the week of the holiday
            else if dayofweek(currentTimestamp) == dayOfWeek
                // Increment the count of occurrences of this day of the week
                occurrence += 1
                // If this is the correct occurrence of this day of the week
                if occurrence == weekOfMonth
                    // Set the timestamp for the holiday
                    timestampForHoliday := currentTimestamp
                    break
                // monthOfYear=5, dayOfWeek=2, weekOfMonth=5      
    // If we found a timestamp for the holiday
    if na(timestampForHoliday)
        runtime.error("Could not find a timestamp for the holiday: " + holiday)
        
    // Return the day of the year for the holiday
    int(str.tonumber(str.format_time(timestampForHoliday, "DDD")))


// @function Function to build the `holidaysMap`.
// @param holidayMap `map<string, HolidayMetaData>` - The map of holidays.
// @param holiday `string` - The name of the holiday.
// @param monthOfYear `int` - The month of the year of the holiday.
// @param weekOfMonth `int` - The week of the month of the holiday.
// @param dayOfWeek `int` - The day of the week of the holiday.
// @param dayOfMonth `int` - The day of the month of the holiday.
// @param lastOccurrenceInMonth `bool` - Flag indicating whether the holiday is the last occurrence of the day in the month.
// @returns `map<string, HolidayMetaData>` - The updated map of holidays
export method buildMap(map<string, HolidayMetaData> holidayMap, string holiday, int monthOfYear=na, int weekOfMonth=na, int dayOfWeek=na, int dayOfMonth=na, bool lastOccurrenceInMonth=na) =>
    int dayOfYear = getDayOfYear(monthOfYear, dayOfMonth, weekOfMonth, dayOfWeek, lastOccurrenceInMonth, holiday)
    holidayMap.put(holiday, HolidayMetaData.new(holiday, dayOfYear, monthOfYear, dayOfMonth, weekOfMonth, dayOfWeek, lastOccurrenceInMonth))
    holidayMap


// @function Remove an string array of Holidays from the Holidays Storage Object
// @param holidaysMap `map<string, HolidayMetaData>` - The map of holidays to be removed.
// @param holidaysArray `array<string>` - The array of holidays to be removed.
// @returns `map<string, HolidayMetaData>` - The updated map of holidays.
method removeHolidays(map<string, HolidayMetaData> holidaysMap, array<string> holidaysArray) =>
    // Remove the holidays from the storage object
    for [n,key] in holidaysArray
        if holidaysMap.contains(key)
            holidaysMap.remove(key)
    // Return the updated holidaysMap
    holidaysMap


// @function Function to add extra holidays to the `holidaysMap`.
// @param extraHolidaysArray `array<HolidayMetaData>` - The array of additional holidays to be added.
// @param holidaysMap `map<string, HolidayMetaData>` - The map of holidays.
// @returns 'map<string, HolidayMetaData>' - map of holidays.
method extraHolidays(map<string, HolidayMetaData> holidaysMap, HolidayMetaData[] extraHolidaysArray) => 
    for h in extraHolidaysArray
        holidaysMap.buildMap(h.holiday, h.monthOfYear, h.weekOfMonth, h.dayOfWeek, h.dayOfMonth, h.lastOccurrenceInMonth)
    holidaysMap
    

// @function Initializes a HolidayStorage object with predefined US holidays.
// @param utc `int` - The UTC time shift in hours.
// @param addHolidaysArray `array<HolidayMetaData>` - The array of additional holidays to be added.
// @param removeHolidaysArray `array<string>` - The array of holidays to be removed.
// @param defaultHolidays `bool` - Flag indicating whether to include the default holidays.
// @returns `map<string, HolidayMetaData>` - The map of holidays.
export holidayInit(HolidayMetaData[] addHolidaysArray=na, string[] removeHolidaysArray=na, bool defaultHolidays=true) =>
    holidaysMap = map.new<string, HolidayMetaData>()
    
    if defaultHolidays
        holidaysMap := holidaysMap
         .buildMap("DLS begin", monthOfYear=3, dayOfWeek=dayofweek.sunday, weekOfMonth=2) // DLS begins on the second Sunday of March 
         .buildMap("DLS end", monthOfYear=11, dayOfWeek=dayofweek.sunday, weekOfMonth=1) // DLS ends on the first Sunday of November 
         .buildMap("New Year's Day", monthOfYear=1, dayOfMonth=1) // New Year's Day: January 1
         .buildMap("MLK Jr. Day", monthOfYear=1, dayOfWeek=dayofweek.monday, weekOfMonth=3) // Martin Luther King Jr. Day: third Monday in January
         .buildMap("Washington Day", monthOfYear=2, dayOfWeek=dayofweek.monday, weekOfMonth=3) // Washington's Birthday (Presidents Day): third Monday in February
         .buildMap("Memorial Day", monthOfYear=5, dayOfWeek=dayofweek.monday, lastOccurrenceInMonth=true) // Memorial Day: last Monday in May
         .buildMap("Independence Day", monthOfYear=7, dayOfMonth=4) // Independence Day: July 4
         .buildMap("Juneteenth Independence Day", monthOfYear=6, dayOfMonth=19) // Juneteenth National Independence Day: June 19
         .buildMap("Labor Day", monthOfYear=9, dayOfWeek=dayofweek.monday, weekOfMonth=1) // Labor Day: first Monday in September
         .buildMap("Columbus Day", monthOfYear=10, dayOfWeek=dayofweek.monday, weekOfMonth=2) // Columbus Day: second Monday in October
         .buildMap("Veterans Day", monthOfYear=11, dayOfMonth=11) // Veterans Day: November 11 
         .buildMap("Thanksgiving Day", monthOfYear=11, dayOfWeek=dayofweek.thursday, weekOfMonth=4) // Thanksgiving Day: fourth Thursday in November
         .buildMap("Christmas Day", monthOfYear=12, dayOfMonth=25) // Christmas Day: December 25
        
        // Easter Sunday: Sunday after the first full moon after the vernal equinox
        [easterDay, easterMonth, goodFriday, goodFridayMonth] = easterInit()
        holidaysMap := holidaysMap
         .buildMap("Good Friday", monthOfYear=goodFridayMonth, dayOfMonth=goodFriday, dayOfWeek=dayofweek.friday) // Good Friday: Friday before Easter Sunday
         .buildMap("Easter Sunday", monthOfYear=easterMonth, dayOfMonth=easterDay, dayOfWeek=dayofweek.sunday) // Easter Sunday: Sunday after the first full moon after the vernal equinox
    
    if not na(addHolidaysArray)
        holidaysMap := holidaysMap.extraHolidays(addHolidaysArray)

    if not na(removeHolidaysArray)
        holidaysMap := holidaysMap.removeHolidays(removeHolidaysArray)

    // Return the instance of holidaysMap
    holidaysMap


// @function Main function to build the holidays object, this is the only function from this library that should be needed.  \
//all functionality should be available through this function.  \
//With the exception of initializing a `HolidayMetaData` object to add a holiday or early close. \  
//  \
//**Default Holidays:**  \ 
//`DLS begin`, `DLS end`, `New Year's Day`, `MLK Jr. Day`,  \
//`Washington Day`, `Memorial Day`, `Independence Day`, `Labor Day`,  \  
//`Columbus Day`, `Veterans Day`, `Thanksgiving Day`, `Christmas Day`   \ 
//  \
//**Example**
//```
//HolidayMetaData valentinesDay = HolidayMetaData.new(holiday="Valentine's Day", monthOfYear=2, dayOfMonth=14)
//HolidayMetaData stPatricksDay = HolidayMetaData.new(holiday="St. Patrick's Day", monthOfYear=3, dayOfMonth=17)
//HolidayMetaData[] addHolidaysArray = array.from(valentinesDay, stPatricksDay)
//
//string[] removeHolidaysArray = array.from("DLS begin", "DLS end")
//
//܂Holidays = Holidays(
//܂     utc=-6, 
//܂     addHolidaysArray=addHolidaysArray, 
//܂     removeHolidaysArray=removeHolidaysArray, 
//܂     adjustForDLS=true, 
//܂     displayLabel=true, 
//܂     defaultHolidays=true, 
//܂ )
//
//plot(Holidays.newHoliday ? open : na, title="newHoliday", color=color.red, linewidth=4, style=plot.style_circles)
//```
// @param utc `int` - The UTC time shift in hours
// @param addHolidaysArray `array<HolidayMetaData>` - The array of additional holidays to be added
// @param removeHolidaysArray `array<string>` - The array of holidays to be removed
// @param adjustForDLS `bool` - Flag indicating whether to adjust for daylight savings time (DLS)
// @param displayLabel `bool` - Flag indicating whether to display a label on the chart
// @param defaultHolidays `bool` - Flag indicating whether to include the default holidays
// @returns `HolidayObject` - The holidays object | Holidays = (holidaysMap: map<string, HolidayMetaData>, newHoliday: bool, holiday: string, dayString: string)
export Holidays(int utc=na, HolidayMetaData[] addHolidaysArray=na, string[] removeHolidaysArray=na, bool adjustForDLS=true, bool displayLabel=true, bool defaultHolidays=true) =>
    
    if na(utc)
        runtime.error(str.format("UTC is not defined: {0}\nMUST PROVIDE UTC TIMEZONE OFFSET. (NYSE UTC = -5)", utc))

    int _utc = dayLightSavingsAdjustedUTC(utc, adjustForDLS)
    map<string, HolidayMetaData> holidaysMap = holidayInit(addHolidaysArray, removeHolidaysArray, defaultHolidays)
    HolidayObject Holidays = HolidayObject.new(holidaysMap=holidaysMap, newHoliday=false, holiday="", dayString="")
    
    string timezone     = timezoneHelper(_utc)
    string format       = str.format_time(time, "EEEE|DDD|dd|MM", timezone)

    if timeframe.isdwm
        format := str.format_time(time, "EEEE|DDD|dd|MM")

    string[] split      = str.split(format,"|")
    string nowDay       = split.get(0)
    int nowDayOfYear    = int(str.tonumber(split.get(1)))
    int nowDayOfMonth   = int(str.tonumber(split.get(2)))
    int nowMonthOfYear  = int(str.tonumber(split.get(3)))

    string[] keys = Holidays.holidaysMap.keys()
    for key in keys

        HolidayMetaData holidayMetaData = Holidays.holidaysMap.get(key)
        int monthOfYear  = holidayMetaData.monthOfYear
        int dayOfMonth   = holidayMetaData.dayOfMonth
        int dayOfWeek    = holidayMetaData.dayOfWeek
        int dayOfYear    = holidayMetaData.dayOfYear
        string holiday   = holidayMetaData.holiday

        if na(dayOfYear) or nowDayOfYear != dayOfYear
            continue

        Holidays.holidaysMap.remove(key)
        if nowDayOfYear[1] != dayOfYear
            Holidays.newHoliday := true
            
            if displayLabel
                makeLabel(nowMonthOfYear, nowDayOfMonth, nowDay, holiday)

        if nowDayOfYear == dayOfYear
            Holidays.dayString     := nowDay
            Holidays.activeHoliday := true
            Holidays.holiday       := holiday
            
        break
            
    // return the Holidays Object
    Holidays


// Usage
HolidayMetaData valentinesDay = HolidayMetaData.new(holiday="Valentine's Day", monthOfYear=2, dayOfMonth=14)
HolidayMetaData stPatricksDay = HolidayMetaData.new(holiday="St. Patrick's Day", monthOfYear=3, dayOfMonth=17)
HolidayMetaData[] addHolidaysArray = array.from(valentinesDay, stPatricksDay)
string[] removeHolidaysArray = array.from("DLS begin", "DLS end")

Holidays = Holidays(
     utc=-6, 
     addHolidaysArray=addHolidaysArray, 
     removeHolidaysArray=removeHolidaysArray, 
     adjustForDLS=true, 
     displayLabel=true, 
     defaultHolidays=true
 )

plot(Holidays.activeHoliday ? high : na, title="activeHoliday", color=color.yellow, linewidth=3, style=plot.style_circles)
plot(Holidays.newHoliday ? high : na, title="newHoliday", color=#000000, linewidth=2, style=plot.style_circles)





