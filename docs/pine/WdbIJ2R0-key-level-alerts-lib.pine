//@version=6
library("key_level_alerts_lib", overlay=true)

// ============================================================================================
// KEY LEVEL ALERTS LIBRARY
// ============================================================================================
//
// This library provides reusable alert detection and state machine functions for SPX key levels
// (PMH, PML, YDH, YDL, YDC). It enables consistent alert behavior across multiple indicators
// by centralizing cross-and-close detection logic and alert state management.
//
// LIBRARY FEATURES:
// - Cross detection functions (shouldFireAlertAbove, shouldFireAlertBelow)
// - State machine functions (processAlertAbove, processAlertBelow)
// - Acceptable range calculation for alert filtering
// - Label text size helper function
//
// EXPORTED FUNCTIONS:
// 1. shouldFireAlertAbove(level, acceptableRange, filterEnabled) - Detects price crossed and closed above level
// 2. shouldFireAlertBelow(level, acceptableRange, filterEnabled) - Detects price crossed and closed below level
// 3. processAlertAbove(level, acceptableRange, currentState, alertEnabled, filterEnabled) - State machine for above alerts
// 4. processAlertBelow(level, acceptableRange, currentState, alertEnabled, filterEnabled) - State machine for below alerts
// 5. calculateAcceptableRange(atrValue, acceptableRangePct) - Calculates acceptable range threshold
// 6. getAlertLabelTextSize(sizeStr) - Converts size string to Pine size constant
//
// USAGE:
// Import this library and call exported functions to detect key level crosses and manage alert state.
// State variables must be maintained in the importing script (libraries cannot use var declarations).
//
// OWNER: Andrea P.
// AUTHOR: Andrea P.
// DEVELOPER: Andrea P.
// VERSION: 1.0
// LAST UPDATED: 2025-12-30
// CHANGELOG:
// v1.0 - Initial release: Extracted alert logic from spx_market_scenario_stats.pine for shared use
//

// ============================================================================================
// CROSS DETECTION FUNCTIONS
// ============================================================================================

// @function Detects if price crossed above and closed above a level on this bar
// @param level The price level to check for cross
// @param acceptableRange The maximum distance from level for close to be considered valid (used when filterEnabled=true)
// @param filterEnabled When true, checks that close is within acceptable range above level
// @returns true if price crossed and closed above the level (optionally within acceptable range)
// Detection logic:
//   Condition A: Opened below level AND closed above level (direct cross up)
//   Condition B: Opened above level, low touched/dipped to level (low <= level), closed above level
export shouldFireAlertAbove(float level, float acceptableRange, bool filterEnabled) => na(level) ? false : ((open < level and close > level) or (open > level and low <= level and close > level)) and (filterEnabled ? (close <= level + acceptableRange) : true)

// @function Detects if price crossed below and closed below a level on this bar
// @param level The price level to check for cross
// @param acceptableRange The maximum distance from level for close to be considered valid (used when filterEnabled=true)
// @param filterEnabled When true, checks that close is within acceptable range below level
// @returns true if price crossed and closed below the level (optionally within acceptable range)
// Detection logic:
//   Condition A: Opened above level AND closed below level (direct cross down)
//   Condition B: Opened below level, high touched/spiked to level (high >= level), closed below level
export shouldFireAlertBelow(float level, float acceptableRange, bool filterEnabled) => na(level) ? false : ((open > level and close < level) or (open < level and high >= level and close < level)) and (filterEnabled ? (close >= level - acceptableRange) : true)

// ============================================================================================
// ALERT STATE MACHINE FUNCTIONS
// ============================================================================================

// @function Process "crossed above" alert for a level - fires alert if transitioning from below/unknown to above
// @param level The price level to check
// @param acceptableRange The acceptable range threshold for filtering
// @param currentState Current alert state (-1=below, 0=unknown, 1=above)
// @param alertEnabled Whether the alert is enabled
// @param filterEnabled Whether to apply acceptable range filtering
// @returns [newState, shouldFire] tuple where newState is updated alert state and shouldFire indicates if alert should trigger
// State behavior:
//   - Alert fires when: state was -1 or 0 AND cross above detected AND alert enabled
//   - State updates to 1 (above) on any cross above
//   - State updates to -1 (below) on any cross below (resets for next above alert)
export processAlertAbove(float level, float acceptableRange, int currentState, bool alertEnabled, bool filterEnabled) => [shouldFireAlertAbove(level, acceptableRange, filterEnabled) and alertEnabled and (currentState == -1 or currentState == 0) ? 1 : shouldFireAlertAbove(level, acceptableRange, filterEnabled) ? 1 : shouldFireAlertBelow(level, acceptableRange, false) ? -1 : currentState, shouldFireAlertAbove(level, acceptableRange, filterEnabled) and alertEnabled and (currentState == -1 or currentState == 0)]

// @function Process "crossed below" alert for a level - fires alert if transitioning from above/unknown to below
// @param level The price level to check
// @param acceptableRange The acceptable range threshold for filtering
// @param currentState Current alert state (-1=below, 0=unknown, 1=above)
// @param alertEnabled Whether the alert is enabled
// @param filterEnabled Whether to apply acceptable range filtering
// @returns [newState, shouldFire] tuple where newState is updated alert state and shouldFire indicates if alert should trigger
// State behavior:
//   - Alert fires when: state was 1 or 0 AND cross below detected AND alert enabled
//   - State updates to -1 (below) on any cross below
//   - State updates to 1 (above) on any cross above (resets for next below alert)
export processAlertBelow(float level, float acceptableRange, int currentState, bool alertEnabled, bool filterEnabled) => [shouldFireAlertBelow(level, acceptableRange, filterEnabled) and alertEnabled and (currentState == 1 or currentState == 0) ? -1 : shouldFireAlertBelow(level, acceptableRange, filterEnabled) ? -1 : shouldFireAlertAbove(level, acceptableRange, false) ? 1 : currentState, shouldFireAlertBelow(level, acceptableRange, filterEnabled) and alertEnabled and (currentState == 1 or currentState == 0)]

// ============================================================================================
// HELPER/UTILITY FUNCTIONS
// ============================================================================================

// @function Calculates the acceptable range threshold for alert filtering based on ATR
// @param atrValue The daily ATR value
// @param acceptableRangePct The acceptable range percentage (e.g., 85 for 85%)
// @returns The acceptable range threshold in price units
// Calculation: oneFullLevel = ATR × 0.24 (24% of daily ATR = one standard key level spacing)
//              acceptableRange = (acceptableRangePct / 100) × oneFullLevel
export calculateAcceptableRange(float atrValue, float acceptableRangePct) => na(atrValue) ? 0.0 : (acceptableRangePct / 100.0) * (atrValue * 0.24)

// @function Converts a size string to Pine Script size constant for labels
// @param sizeStr The size string ("tiny", "small", "normal", "large", "huge")
// @returns The corresponding Pine Script size constant
export getAlertLabelTextSize(string sizeStr) => sizeStr == "tiny" ? size.tiny : sizeStr == "small" ? size.small : sizeStr == "normal" ? size.normal : sizeStr == "large" ? size.large : sizeStr == "huge" ? size.huge : size.small