//@version=6

// @description
// FSL Theme Library
// Provides reusable UI color themes used across FSL indicators and strategies.
// The library defines a Theme structure containing colors for table headers,
// data rows, and directional indicators. Scripts can retrieve a preset theme
// using `getTheme()` and apply consistent styling to tables and labels.
library("fsl_theme", overlay = false)

// @type Structure containing all UI color definitions used by FSL scripts. These colors are typically applied to tables, labels, and UI elements. 
export type Theme
    color header_bg
    color header_tx

    color data_bg
    color data_tx
    color data_bg_sec

    color dir_cont_bg
    color dir_cont_tx

    color dir_backw_bg
    color dir_backw_tx

    // Chart
    color bg_main
    color bg_secondary
    color border
    color grid

    // text hierarchy
    color text_secondary
    color text_muted

    // accent
    color accent

    // Bars 
    color bar_up 
    color bar_down

    // MAs
    color ma


// Identifiers for available theme presets.
export enum ThemeId
    Default

// @function Returns the Theme configuration corresponding to the selected preset.
// @param id ThemeId identifier of the theme preset.
// @returns Theme structure containing all UI color settings.
export getTheme(ThemeId id) =>
    switch id
        ThemeId.Default =>
            Theme.new(
                 #1F3D2B, #7CFFB2,   // header
                 #1A1A1A, #E6E6E6,   // data
                 #222222,              // data secondary bg
                 #1F3D2B, #7CFFB2,   // direction: continuation
                 #3A1F1F, #FF7C7C,   // direction: backward
                 #141414, #1E1E1E, #3A3A3A, #2A2A2A, // Chart
                 #A8A8A8, #7A7A7A,   // text hierarchy
                 #57C27A,              // accent
                 #2FBF71, #E34A4A,   // bars
                 #E6E6E6               // ma
            )

