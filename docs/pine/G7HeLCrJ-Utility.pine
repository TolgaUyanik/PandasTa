//@version=5

// @description A utility library for various trading tools such as signal generation, custom indicators, and multi-condition crossovers.
library("Utility")

// @function multiCrossover
// @description Detects multi-condition crossovers between two sources with threshold filters.
// @param source1 The first data series to compare.
// @param source2 The second data series to compare.
// @param threshold1 A value that source1 must exceed to trigger the crossover.
// @param threshold2 A value that source2 must exceed to trigger the crossunder.
// @returns A tuple: (crossUp, crossDown) where crossUp is a boolean for upward crossover, and crossDown is for downward crossover.
export multiCrossover(float source1, float source2, float threshold1, float threshold2) =>
    crossUp = ta.crossover(source1, source2) and source1 > threshold1
    crossDown = ta.crossunder(source1, source2) and source2 < threshold2
    [crossUp, crossDown]

// @function macdCustom
// @description Calculates custom MACD signals based on thresholds.
// @param source The price data or input series.
// @param fastLength The length of the fast EMA.
// @param slowLength The length of the slow EMA.
// @param signalLength The signal line length.
// @param macdThresh A threshold for the MACD line to confirm buy/sell signals.
// @returns A tuple: (macdBuySignal, macdSellSignal) where macdBuySignal is true when MACD crosses above, and macdSellSignal is true when MACD crosses below the signal line.
export macdCustom(float source, int fastLength, int slowLength, int signalLength, float macdThresh) =>
    [macdLine, signalLine, histLine] = ta.macd(source, fastLength, slowLength, signalLength)
    macdBuySignal = ta.crossover(macdLine, signalLine) and macdLine > macdThresh
    macdSellSignal = ta.crossunder(macdLine, signalLine) and macdLine < -macdThresh
    [macdBuySignal, macdSellSignal]

// @function combinedMacdRsi
// @description Generates combined signals from MACD and RSI indicators.
// @param source The price data or input series.
// @param fastLength The length of the fast EMA for MACD.
// @param slowLength The length of the slow EMA for MACD.
// @param signalLength The signal line length for MACD.
// @param rsiLength The length of the RSI calculation.
// @param macdThresh The threshold for MACD signals.
// @param rsiThresh The threshold for RSI signals.
// @returns A tuple: (buySignal, sellSignal) where buySignal is generated when MACD is positive and RSI is below the threshold, and sellSignal when MACD is negative and RSI is above the threshold.
export combinedMacdRsi(float source, int fastLength, int slowLength, int signalLength, int rsiLength, float macdThresh, float rsiThresh) =>
    // MACD signal
    [macdBuySignal, macdSellSignal] = macdCustom(source, fastLength, slowLength, signalLength, macdThresh)
    
    // RSI signal
    rsiValue = ta.rsi(source, rsiLength)
    
    // Combined signals
    buySignal = macdBuySignal and rsiValue < rsiThresh
    sellSignal = macdSellSignal and rsiValue > (100 - rsiThresh)
    
    [buySignal, sellSignal]

// @function movingAverageCrossover
// @description Detects crossovers between short-term and long-term moving averages.
// @param source The price data or input series.
// @param shortLength The length of the short-term moving average.
// @param longLength The length of the long-term moving average.
// @returns A tuple: (crossUp, crossDown) where crossUp is true when the short-term MA crosses above the long-term MA, and crossDown when the reverse occurs.
export movingAverageCrossover(float source, int shortLength, int longLength) =>
    shortMA = ta.sma(source, shortLength)
    longMA = ta.sma(source, longLength)
    ta.crossover(shortMA, longMA), ta.crossunder(shortMA, longMA)