//@version=6
// @description Builds JSON alert_message payloads for strategy webhooks (open, close, modify).
library("StrategyWebhookJson", overlay=true)

export enum Mode
    LocalOnly
    CloudOnly
    Both

//@type Webhook delivery configuration (secret + mode).
//@field secret Authentication secret for the webhook receiver.
//@field mode LocalOnly, CloudOnly, or Both.
export type Config
    string secret
    Mode mode

//@function Create library configuration. Store the result in a `var` in your strategy.
//@param secret Authentication secret for the webhook receiver.
//@param mode LocalOnly (no webhook JSON), CloudOnly, or Both.
//@returns Config passed to openMsg, closeMsg, and modifyMsg.
export init(string secret, Mode mode) =>
    Config.new(secret, mode)

_jsonEscape(string s) =>
    str.replace_all(str.replace_all(s, "\\", "\\\\"), "\"", "\\\"")

_buildPayload(Config cfg, string action, string signalId, string side, float volume, float price, float sl, float tp, string comment) =>
    string sidePart = side == "" ? "" : ',"side":"' + side + '"'
    string symPart = ',"symbol":"' + _jsonEscape(syminfo.ticker) + '"'
    string volPart = na(volume) ? "" : ',"volume":' + str.tostring(volume)
    string pricePart = na(price) ? "" : ',"price":' + str.tostring(price)
    string slPart = na(sl) ? "" : ',"sl":' + str.tostring(sl)
    string tpPart = na(tp) ? "" : ',"tp":' + str.tostring(tp)
    string commentPart = comment == "" ? "" : ',"comment":"' + _jsonEscape(comment) + '"'
    '{"secret":"' + _jsonEscape(cfg.secret) + '","signalId":"' + _jsonEscape(signalId) + '","action":"' + action + '"' + sidePart + symPart + volPart + pricePart + slPart + tpPart + commentPart + '}'

_cloudEnabled(Mode mode) =>
    mode == Mode.CloudOnly or mode == Mode.Both

//@function Build alert_message JSON for a new position.
//@param cfg Config from init().
//@param orderId Unique order / signal id.
//@param side "buy" or "sell".
//@param volume Lot size in the payload.
//@param sl Stop loss price.
//@param tp Take profit price.
//@returns JSON string for strategy alert_message, or "" in LocalOnly mode.
export openMsg(Config cfg, string orderId, string side, float volume, float sl, float tp) =>
    _cloudEnabled(cfg.mode) ? _buildPayload(cfg, "open", orderId, side, volume, close, sl, tp, orderId) : ""

//@function Build alert_message JSON to close a position.
//@param cfg Config from init().
//@param orderId Order id used in openMsg().
//@returns JSON string for strategy alert_message, or "" in LocalOnly mode.
export closeMsg(Config cfg, string orderId) =>
    _cloudEnabled(cfg.mode) ? _buildPayload(cfg, "close", orderId, "", na, close, na, na, orderId) : ""

//@function Build alert_message JSON to modify SL/TP.
//@param cfg Config from init().
//@param orderId Order id used in openMsg().
//@param sl New stop loss.
//@param tp New take profit.
//@returns JSON string for strategy alert_message, or "" in LocalOnly mode.
export modifyMsg(Config cfg, string orderId, float sl, float tp) =>
    _cloudEnabled(cfg.mode) ? _buildPayload(cfg, "modify", orderId, "", na, na, sl, tp, orderId) : ""
