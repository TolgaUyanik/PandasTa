//@version=5

// @description This library provides functions for generating trading alerts for `whook`
// check this -> https://github.com/germangar/whook
//
// # --- Test Cases ---
// Note: These test cases are for demonstration purposes only and may not cover all scenarios.
// // buy(string account, float amount,  string unit = "units", float leverage = 1) 
// buy("MyAccount", 100, "units", 1)
// buy("MyAccount", 1000, "USDT", 5)
// buy("MyAccount", 50, "percent", 2)
// // sell(string account, float amount,  string unit = "units", float leverage = 1) 
// sell("MyAccount", 50, "units", 1)
// sell("MyAccount", 500, "USDT", 3)
// sell("MyAccount", 25, "percent", 2)
// // set_position(string account, float amount, string unit = "units", float leverage = 1) 
// set_position("MyAccount", 100, "units", 1)
// set_position("MyAccount", 1000, "USDT", 5)
// set_position("MyAccount", 50, "percent", 2)
// // limit_buy(string account, float amount, float price, string unit = "units", float leverage = 1, string id = "") 
// limit_buy("MyAccount", 100, 10000, "units", 1, "MyBuyOrder")
// limit_buy("MyAccount", 1000, 10500, "USDT", 5)
// limit_buy("MyAccount", 50, 11000, "percent", 2)
// // limit_sell(string account, float amount, float price, string unit = "units", float leverage = 1, string id = "") 
// limit_sell("MyAccount", 50, 10000, "units", 1, "MySellOrder")
// limit_sell("MyAccount", 500, 9500, "USDT", 3)
// limit_sell("MyAccount", 25, 9000, "percent", 2)
// // close_percent(string account, float pct = 100)
// close_percent("MyAccount", 100)
// close_percent("MyAccount", 50)
library("whook")


// --- Helper Functions ---

// @function Converts a quantity to a string representation based on the specified unit.
// @param qty The quantity to convert.
// @param unit The unit of the quantity (optional, defaults to "units").
// @returns The string representation of the quantity.
_qtyToString(qty, unit = "units") =>
    if unit == "USDT"
        str.tostring(qty) + "$ "
    else if unit == "percent"
        str.tostring(qty) + "% "
    else if unit == "units"
        str.tostring(qty) + "@ "
    else
        str.tostring(qty)



// --- Trading Functions ---

// @function Sends a trading alert to execute a market buy order.
// @param account The account ID.
// @param amount The amount to buy (can be in USD, units, or percentage).
// @param unit The unit of the amount (optional, defaults to "units").
// @param leverage The leverage to use (optional, defaults to 1x).
export buy             (string account, string ticker, float amount,  string unit = "units", float leverage = 1) =>
    qty = amount
    alertMessage = account + " " + ticker + " buy " + _qtyToString(qty, unit) 
    if leverage != 1
        alertMessage += str.tostring(leverage) + 'X'
    alert(alertMessage, alert.freq_once_per_bar)

// @function Sends a trading alert to execute a market sell order.
// @param account The account ID.
// @param amount The amount to sell (can be in USD, units, or percentage).
// @param unit The unit of the amount (optional, defaults to "units").
// @param leverage The leverage to use (optional, defaults to 1x).
export sell            (string account, string ticker, float amount,  string unit = "units", float leverage = 1) =>
    qty = amount
    alertMessage = account + " " + ticker + " sell " + _qtyToString(qty, unit) 
    if leverage != 1
        alertMessage += str.tostring(leverage) + 'X'
    alert(alertMessage, alert.freq_once_per_bar)

// @function Sends a trading alert to set a position.
// @param account The account ID.
// @param amount The amount to set the position to (can be in USD, units, or percentage).
// @param unit The unit of the amount (optional, defaults to "units").
// @param leverage The leverage to use (optional, defaults to 1x).
export set_position    (string account, string ticker, float amount, string unit = "units", float leverage = 1) =>
    qty = amount
    alertMessage = account + " " + ticker + " position " + _qtyToString(qty, unit)
    if leverage != 1
        alertMessage += str.tostring(leverage) + 'X'
    alert(alertMessage, alert.freq_once_per_bar)

// @function Sends a trading alert to place a limit buy order.
// @param account The account ID.
// @param amount The amount to buy (can be in USD, units, or percentage).
// @param unit The unit of the amount (optional, defaults to "units").
// @param leverage The leverage to use (optional, defaults to 1x).
// @param price The limit price.
// @param id An optional custom ID for the limit order.
export limit_buy       (string account, string ticker, float amount, float price, string unit = "units", float leverage = 1, string id = "") =>
    qty = amount
    alertMessage = account + " " + ticker + " buy " + _qtyToString(qty, unit)
    idstring = id == "" ? "my_buy" + str.tostring(timenow) : id        
    alertMessage += " limit:" + idstring + ":" + str.tostring(price)  + " "
    if leverage != 1
        alertMessage += str.tostring(leverage) + 'X'
    alert(alertMessage, alert.freq_once_per_bar)

// @function Sends a trading alert to place a limit sell order.
// @param account The account ID.
// @param amount The amount to sell (can be in USD, units, or percentage).
// @param unit The unit of the amount (optional, defaults to "units").
// @param leverage The leverage to use (optional, defaults to 1x).
// @param price The limit price.
// @param id An optional custom ID for the limit order.
export limit_sell      (string account, string ticker, float amount, float price, string unit = "units", float leverage = 1, string id = "") =>
    qty = amount
    alertMessage = account + " " + ticker + " sell " + _qtyToString(qty, unit) 
    idstring = id == "" ? "my_sell" + str.tostring(timenow) : id        
    alertMessage += " limit:" + idstring + ":" + str.tostring(price)  + " "
    if leverage != 1
        alertMessage += str.tostring(leverage) + 'X'
    alert(alertMessage, alert.freq_once_per_bar)

// @function Sends an alert to close a position on Phemex.
// @param account The account ID.
// @param pct The percentage of the position to close (optional, defaults to 100%).
export close_percent   (string account, string ticker, float pct = 100, float price = na) => 
    pricestring =switch
        na(price) => ""
        => str.format("limit:{0}:{1}","order_str.tostring(time)",price)    
    alert(account + " " + ticker + " close " + str.tostring(pct) + "%" + pricestring, alert.freq_once_per_bar)

// @function Sends an alert to cancel a specific limit order.
// @param account The account ID.
// @param id The ID of the limit order to cancel.
export cancel          (string account, string ticker, string id) =>
    alertMessage = account + " " + ticker + " cancel:" + id
    alert(alertMessage, alert.freq_once_per_bar)

// @function Sends an alert to cancel all orders for a symbol.
// @param account The account ID.
export cancel_all      (string account, string ticker) =>
    alertMessage = account + " " + ticker + " cancel:all"
    alert(alertMessage, alert.freq_once_per_bar)