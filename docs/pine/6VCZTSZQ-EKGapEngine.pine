//@version=6
// @description Gap engine library: NWOG (New Week Opening Gaps), NDOG (New Day Opening Gaps),
//   9:30 NY Opening Range Gap, and PXH/L (Previous X High/Low) levels.
//   Extracted from qt-pro-enigma.pine to avoid TradingView compiler timeouts.
library("EKGapEngine", overlay=true)

// ============================================================================
// EXPORTED TYPES
// ============================================================================

// @type New Week Opening Gap box with all price levels and drawing references
// @field gapType Gap classification (1=Void Bull, 2=Void Bear, 3=Overlap Bull, 4=Overlap Bear)
// @field fridayClose Friday close price
// @field fridayOpen Friday open price
// @field mondayOpen Monday open price
// @field topPrice Top of gap zone
// @field bottomPrice Bottom of gap zone
// @field midPrice Midpoint of gap zone
// @field upperQuad Upper quadrant (75%) of gap zone
// @field lowerQuad Lower quadrant (25%) of gap zone
// @field gapSize Absolute size of gap
// @field startBar Bar index where gap starts
// @field creationTime Timestamp of gap creation
// @field weekEndBar Bar index where the week ended
// @field weekEnded Whether the week has ended for this NWOG
// @field nwogBox Box drawing object
// @field midLine Midline drawing object
// @field q3Line Upper quadrant line drawing object
// @field q1Line Lower quadrant line drawing object
// @field infoLabel Label drawing object
// @field isActive Whether this NWOG is still active
export type NWOGBox
    int      gapType
    float    fridayClose
    float    fridayOpen
    float    mondayOpen
    float    topPrice
    float    bottomPrice
    float    midPrice
    float    upperQuad
    float    lowerQuad
    float    gapSize
    int      startBar
    int      creationTime
    int      weekEndBar
    bool     weekEnded
    box      nwogBox
    line     midLine
    line     q3Line
    line     q1Line
    label    infoLabel
    bool     isActive

// @type New Day Opening Gap box with all price levels and drawing references
// @field isBullish Whether the gap opened bullish (today open > prev close)
// @field prevClose Previous day close price
// @field todayOpen Today open price
// @field topPrice Top of gap zone
// @field bottomPrice Bottom of gap zone
// @field midPrice Midpoint of gap zone
// @field upperQuad Upper quadrant (75%) of gap zone
// @field lowerQuad Lower quadrant (25%) of gap zone
// @field gapSize Absolute size of gap
// @field startBar Bar index where gap starts
// @field creationTime Timestamp of gap creation
// @field dayEndBar Bar index where the day ended
// @field dayEnded Whether the day has ended for this NDOG
// @field ndogBox Box drawing object
// @field midLine Midline drawing object
// @field q3Line Upper quadrant line drawing object
// @field q1Line Lower quadrant line drawing object
// @field infoLabel Label drawing object
// @field isActive Whether this NDOG is still active
export type NDOGBox
    bool     isBullish
    float    prevClose
    float    todayOpen
    float    topPrice
    float    bottomPrice
    float    midPrice
    float    upperQuad
    float    lowerQuad
    float    gapSize
    int      startBar
    int      creationTime
    int      dayEndBar
    bool     dayEnded
    box      ndogBox
    line     midLine
    line     q3Line
    line     q1Line
    label    infoLabel
    bool     isActive

// @type PXH/L level with price, time range, and mitigation state
// @field price The price level
// @field start_time Timestamp where the level starts
// @field is_high Whether this is a high (true) or low (false)
// @field broken Whether the level has been mitigated
// @field stop_time Timestamp where the level was mitigated
export type Level
    float price
    int   start_time
    bool  is_high
    bool  broken = false
    int   stop_time = na

// @type Configuration for NWOG/NDOG gap display and filtering
// @field showNwogs Enable NWOGs
// @field showVoidGaps Show void gap types
// @field showOverlapGaps Show overlap gap types
// @field showNwogLabels Show NWOG labels
// @field extensionMode NWOG extension mode ("Extend Live" or "Extend to Week Close")
// @field maxNwogCount Maximum number of NWOGs to display
// @field showNdogs Enable NDOGs
// @field showNdogLabels Show NDOG labels
// @field ndogExtensionMode NDOG extension mode ("Extend Live" or "Extend to Day Close")
// @field maxNdogCount Maximum number of NDOGs to display
// @field force1800 Force 18:00 open for NDOG calculation
// @field customOpenSession Session string for custom open time
// @field nwogColor Base color for NWOGs
// @field ndogColor Base color for NDOGs
// @field boxFillTransp Box fill transparency
// @field boxBorderTransp Box border transparency
// @field boxBorderWidth Box border width
// @field showMidline Show midline on gaps
// @field showQuadrants Show quadrant lines on gaps
// @field midLineColor Midline color
// @field quadLineColor Quadrant line color
// @field midLineStyle Midline style string ("Solid", "Dotted", "Dashed")
// @field quadLineStyle Quadrant line style string ("Solid", "Dotted", "Dashed")
// @field labelSize Label size string ("Tiny", "Small", "Normal", "Large")
// @field nwogTextColor NWOG label text color
// @field labelStyle Label style ("Simple" or "Descriptive")
// @field hideHistoryLabels Hide labels on historical gaps
// @field atrMultiplier Pre-computed ATR multiplier for NWOG size filter
// @field ndogAtrMultiplier Pre-computed ATR multiplier for NDOG size filter
// @field maxDistanceAtr Pre-computed max distance in ATR multiples
// @field onlyShowNearPrice Only show gaps near current price
// @field cleanupIntervalMs Cleanup interval in milliseconds (0 = immediate)
// @field barOffset Bar offset for right edge of drawings
export type GapConfig
    bool   showNwogs
    bool   showVoidGaps
    bool   showOverlapGaps
    bool   showNwogLabels
    string extensionMode
    int    maxNwogCount
    bool   showNdogs
    bool   showNdogLabels
    string ndogExtensionMode
    int    maxNdogCount
    bool   force1800
    string customOpenSession
    color  nwogColor
    color  ndogColor
    int    boxFillTransp
    int    boxBorderTransp
    int    boxBorderWidth
    bool   showMidline
    bool   showQuadrants
    color  midLineColor
    color  quadLineColor
    string midLineStyle
    string quadLineStyle
    string labelSize
    color  nwogTextColor
    string labelStyle
    bool   hideHistoryLabels
    float  atrMultiplier
    float  ndogAtrMultiplier
    float  maxDistanceAtr
    bool   onlyShowNearPrice
    int    cleanupIntervalMs
    int    barOffset

// @type Configuration for PXH/L (Previous X High/Low) display
// @field global_sty Global line style ("Solid", "Dotted", "Dashed")
// @field lbl_size_str Label size string ("Auto", "Tiny", "Small", "Normal", "Large")
// @field use_mono Use monospace font for labels
// @field filter_enabled Enable distance filter
// @field filter_preset Distance filter preset ("Really Close", "Balanced", "Slightly Far")
// @field filter_atr_len ATR length for distance filter
// @field show_d Show daily levels
// @field show_w Show weekly levels
// @field show_m Show monthly levels
// @field col_d Daily level color
// @field col_w Weekly level color
// @field col_m Monthly level color
// @field cnt_d Daily level count
// @field cnt_w Weekly level count
// @field cnt_m Monthly level count
// @field mode_d Daily midline mode ("None", "EQ", "Quadrants")
// @field mode_w Weekly midline mode ("None", "EQ", "Quadrants")
// @field mode_m Monthly midline mode ("None", "EQ", "Quadrants")
// @field show_lbl_d Show daily labels
// @field show_lbl_w Show weekly labels
// @field show_lbl_m Show monthly labels
export type PXHLConfig
    string global_sty
    string lbl_size_str
    bool   use_mono
    bool   filter_enabled
    string filter_preset
    int    filter_atr_len
    bool   show_d
    bool   show_w
    bool   show_m
    color  col_d
    color  col_w
    color  col_m
    int    cnt_d
    int    cnt_w
    int    cnt_m
    string mode_d
    string mode_w
    string mode_m
    bool   show_lbl_d
    bool   show_lbl_w
    bool   show_lbl_m

// @type Configuration for 9:30 NY Opening Range Gap
// @field g930_historyCount Number of historical 9:30 gaps to show
// @field g930_projEndH End hour for gap projection (NY time)
// @field g930_projEndM End minute for gap projection (NY time)
// @field g930_showBox Show gap box
// @field g930_boxColor Gap box color
// @field g930_showMid Show midline
// @field g930_midColor Midline color
// @field g930_midStyleStr Midline style string ("Solid", "Dashed", "Dotted")
// @field g930_showQuad Show quadrant lines
// @field g930_quadColor Quadrant line color
// @field g930_quadStyleStr Quadrant line style string ("Solid", "Dashed", "Dotted")
export type Gap930Config
    int    g930_historyCount
    int    g930_projEndH
    int    g930_projEndM
    bool   g930_showBox
    color  g930_boxColor
    bool   g930_showMid
    color  g930_midColor
    string g930_midStyleStr
    bool   g930_showQuad
    color  g930_quadColor
    string g930_quadStyleStr

// ============================================================================
// CONSTANTS (as functions -- libraries cannot have global constants)
// ============================================================================

// @function Gap type constant: Void Bullish
// @returns 1
export GAP_VOID_BULL() =>
    1

// @function Gap type constant: Void Bearish
// @returns 2
export GAP_VOID_BEAR() =>
    2

// @function Gap type constant: Overlap Bullish
// @returns 3
export GAP_OVERLAP_BULL() =>
    3

// @function Gap type constant: Overlap Bearish
// @returns 4
export GAP_OVERLAP_BEAR() =>
    4

// ============================================================================
// GAP HELPER FUNCTIONS
// ============================================================================

// @function Convert a style string to a line style constant
// @param styleStr Style string ("Solid", "Dashed", "Dotted")
// @returns line.style_solid, line.style_dashed, or line.style_dotted
export getLineStyle(string styleStr) =>
    styleStr == "Solid" ? line.style_solid : styleStr == "Dashed" ? line.style_dashed : line.style_dotted

// @function Convert a label size string to a size constant
// @param labelSize Label size string ("Tiny", "Small", "Normal", "Large")
// @returns size.tiny, size.small, size.normal, or size.large
export getLabelSize(string labelSize) =>
    labelSize == "Tiny" ? size.tiny : labelSize == "Small" ? size.small : labelSize == "Normal" ? size.normal : size.large

// @function Calculate approximate trading days since a timestamp
// @param creationTimestamp The creation timestamp to measure from
// @returns Approximate number of trading days elapsed
export calcTradingDaysAgo(int creationTimestamp) =>
    int msPerDay = 24 * 60 * 60 * 1000
    int calendarDays = math.floor((time - creationTimestamp) / msPerDay)
    int weeks = math.floor(calendarDays / 7)
    int remainingDays = calendarDays % 7
    int tradingDays = weeks * 5 + math.min(remainingDays, 5)
    math.max(0, tradingDays)

// @function Get the human-readable name for an NWOG gap subtype
// @param gapType Gap type constant (1-4)
// @returns String name of the gap subtype
export getNwogSubtypeName(int gapType) =>
    if gapType == GAP_VOID_BULL()
        "Void Bull"
    else if gapType == GAP_VOID_BEAR()
        "Void Bear"
    else if gapType == GAP_OVERLAP_BULL()
        "Overlap Bull"
    else if gapType == GAP_OVERLAP_BEAR()
        "Overlap Bear"
    else
        ""

// @function Build label text for an NWOG
// @param gapType Gap type constant (1-4)
// @param daysAgo Number of trading days ago the gap was created
// @param labelStyle Label style ("Simple" or "Descriptive")
// @returns Formatted label text string
export buildNwogLabelText(int gapType, int daysAgo, string labelStyle) =>
    if labelStyle == "Descriptive"
        "NWOG (" + getNwogSubtypeName(gapType) + "), " + str.tostring(daysAgo) + "d ago"
    else
        "NWOG, " + str.tostring(daysAgo) + "d ago"

// @function Build label text for an NDOG
// @param isBullish Whether the gap is bullish
// @param daysAgo Number of trading days ago the gap was created
// @param labelStyle Label style ("Simple" or "Descriptive")
// @returns Formatted label text string
export buildNdogLabelText(bool isBullish, int daysAgo, string labelStyle) =>
    if labelStyle == "Descriptive"
        "NDOG (" + (isBullish ? "Bull" : "Bear") + "), " + str.tostring(daysAgo) + "d ago"
    else
        "NDOG, " + str.tostring(daysAgo) + "d ago"

// @function Compute fill, border, mid, and quad colors for an NWOG
// @param nwogColor Base NWOG color
// @param boxFillTransp Box fill transparency (0-100)
// @param boxBorderTransp Box border transparency (0-100)
// @param midLineColor Midline color
// @param quadLineColor Quadrant line color
// @returns Tuple of [fillCol, borderCol, midCol, quadCol]
export getGapColors(color nwogColor, int boxFillTransp, int boxBorderTransp, color midLineColor, color quadLineColor) =>
    color baseColor = nwogColor
    color fillCol   = color.new(baseColor, boxFillTransp)
    color borderCol = color.new(baseColor, boxBorderTransp)
    color midCol    = midLineColor
    color quadCol   = quadLineColor
    [fillCol, borderCol, midCol, quadCol]

// @function Compute fill, border, mid, and quad colors for an NDOG
// @param ndogColor Base NDOG color
// @param boxFillTransp Box fill transparency (0-100)
// @param boxBorderTransp Box border transparency (0-100)
// @param midLineColor Midline color
// @param quadLineColor Quadrant line color
// @returns Tuple of [fillCol, borderCol, midCol, quadCol]
export getNdogColors(color ndogColor, int boxFillTransp, int boxBorderTransp, color midLineColor, color quadLineColor) =>
    color baseColor = ndogColor
    color fillCol   = color.new(baseColor, boxFillTransp)
    color borderCol = color.new(baseColor, boxBorderTransp)
    color midCol    = midLineColor
    color quadCol   = quadLineColor
    [fillCol, borderCol, midCol, quadCol]

// @function Classify a weekend gap as Void Bull/Bear or Overlap Bull/Bear
// @param friClose Friday close price
// @param friOpen Friday open price
// @param monOpen Monday open price
// @returns Gap type constant (0 if no gap)
export classifyGap(float friClose, float friOpen, float monOpen) =>
    bool gapUp      = monOpen > friClose
    bool gapDown    = monOpen < friClose
    bool friBullish = friClose > friOpen
    bool friBearish = friClose < friOpen
    int gapType = 0
    if gapUp
        gapType := friBullish ? GAP_VOID_BULL() : GAP_OVERLAP_BULL()
    else if gapDown
        gapType := friBearish ? GAP_VOID_BEAR() : GAP_OVERLAP_BEAR()
    gapType

// @function Check if a gap passes the ATR size filter
// @param gapSize Absolute size of the gap
// @param atr Current ATR value
// @param multiplier ATR multiplier threshold
// @returns true if the gap passes the filter
export passesAtrFilter(float gapSize, float atr, float multiplier) =>
    if na(atr) or atr == 0
        true
    else if multiplier == 0
        true
    else
        gapSize >= (atr * multiplier)

// @function Check if a gap is within the max price distance
// @param topPrice Top of gap zone
// @param bottomPrice Bottom of gap zone
// @param currentPrice Current price (close)
// @param atr Current ATR value
// @param onlyShowNearPrice Whether the near-price filter is enabled
// @param maxDistanceAtr Maximum distance in ATR multiples
// @returns true if within distance (or filter is disabled)
export isWithinPriceDistance(float topPrice, float bottomPrice, float currentPrice, float atr, bool onlyShowNearPrice, float maxDistanceAtr) =>
    if not onlyShowNearPrice
        true
    else if na(atr) or atr == 0
        true
    else
        float distanceToTop    = math.abs(currentPrice - topPrice)
        float distanceToBottom = math.abs(currentPrice - bottomPrice)
        float closestDistance  = math.min(distanceToTop, distanceToBottom)
        float maxDistance      = atr * maxDistanceAtr
        closestDistance <= maxDistance

// @function Check if a gap type should be displayed based on settings
// @param gapType Gap type constant (1-4)
// @param showVoidGaps Whether void gaps are enabled
// @param showOverlapGaps Whether overlap gaps are enabled
// @returns true if this gap type should be shown
export shouldDisplayGapType(int gapType, bool showVoidGaps, bool showOverlapGaps) =>
    if gapType == GAP_VOID_BULL() or gapType == GAP_VOID_BEAR()
        showVoidGaps
    else if gapType == GAP_OVERLAP_BULL() or gapType == GAP_OVERLAP_BEAR()
        showOverlapGaps
    else
        false

// ============================================================================
// NWOG/NDOG CREATION
// ============================================================================

// @function Create a new NWOG and add it to the array, removing oldest if over max count
// @param nwogArray Array of NWOGBox objects
// @param cfg GapConfig with all settings
// @param friClose Friday close price
// @param friOpen Friday open price
// @param monOpen Monday open price
// @param atrVal Current ATR value for size filtering
// @param fridayBarIdx Bar index of Friday (for left edge of box)
export createNwog(array<NWOGBox> nwogArray, GapConfig cfg, float friClose, float friOpen, float monOpen, float atrVal, int fridayBarIdx) =>
    float topVal    = math.max(friClose, monOpen)
    float bottomVal = math.min(friClose, monOpen)
    float midVal    = (topVal + bottomVal) / 2
    float gapSizeVal = math.abs(monOpen - friClose)
    float q3Val     = bottomVal + (gapSizeVal * 0.75)
    float q1Val     = bottomVal + (gapSizeVal * 0.25)

    int gapType = classifyGap(friClose, friOpen, monOpen)
    bool passesFilter = cfg.showNwogs and passesAtrFilter(gapSizeVal, atrVal, cfg.atrMultiplier) and shouldDisplayGapType(gapType, cfg.showVoidGaps, cfg.showOverlapGaps) and gapType != 0
    int leftBar = na(fridayBarIdx) ? bar_index : fridayBarIdx
    if passesFilter
        NWOGBox newNwog = NWOGBox.new(gapType, friClose, friOpen, monOpen, topVal, bottomVal, midVal, q3Val, q1Val, gapSizeVal, leftBar, time, na, false, na, na, na, na, na, true)
        array.push(nwogArray, newNwog)
        while array.size(nwogArray) > cfg.maxNwogCount
            NWOGBox oldest = array.shift(nwogArray)
            if not na(oldest.nwogBox)
                box.delete(oldest.nwogBox)
            if not na(oldest.midLine)
                line.delete(oldest.midLine)
            if not na(oldest.q3Line)
                line.delete(oldest.q3Line)
            if not na(oldest.q1Line)
                line.delete(oldest.q1Line)
            if not na(oldest.infoLabel)
                label.delete(oldest.infoLabel)

// @function Create a new NDOG and add it to the array, removing oldest if over max count
// @param ndogArray Array of NDOGBox objects
// @param cfg GapConfig with all settings
// @param prevClose Previous day close price
// @param todayOpn Today open price
// @param atrVal Current ATR value for size filtering
// @param prevDayBarIdx Bar index of previous day (for left edge of box)
export createNdog(array<NDOGBox> ndogArray, GapConfig cfg, float prevClose, float todayOpn, float atrVal, int prevDayBarIdx) =>
    float topVal    = math.max(prevClose, todayOpn)
    float bottomVal = math.min(prevClose, todayOpn)
    float midVal    = (topVal + bottomVal) / 2
    float gapSizeVal = math.abs(todayOpn - prevClose)
    float q3Val     = bottomVal + (gapSizeVal * 0.75)
    float q1Val     = bottomVal + (gapSizeVal * 0.25)

    bool  isBullishVal = todayOpn > prevClose
    bool passesFilter = cfg.showNdogs and passesAtrFilter(gapSizeVal, atrVal, cfg.ndogAtrMultiplier) and gapSizeVal > 0
    int leftBar = na(prevDayBarIdx) ? bar_index : prevDayBarIdx
    if passesFilter
        NDOGBox newNdog = NDOGBox.new(isBullishVal, prevClose, todayOpn, topVal, bottomVal, midVal, q3Val, q1Val, gapSizeVal, leftBar, time, na, false, na, na, na, na, na, true)
        array.push(ndogArray, newNdog)
        while array.size(ndogArray) > cfg.maxNdogCount
            NDOGBox oldest = array.shift(ndogArray)
            if not na(oldest.ndogBox)
                box.delete(oldest.ndogBox)
            if not na(oldest.midLine)
                line.delete(oldest.midLine)
            if not na(oldest.q3Line)
                line.delete(oldest.q3Line)
            if not na(oldest.q1Line)
                line.delete(oldest.q1Line)
            if not na(oldest.infoLabel)
                label.delete(oldest.infoLabel)

// ============================================================================
// EXTENSION / UPDATE FUNCTIONS
// ============================================================================

// @function Update all NWOG box/line/label extensions and handle cleanup
// @param nwogArray Array of NWOGBox objects
// @param cfg GapConfig with all settings
// @param dailyAtr Current daily ATR value for distance filtering
// @param shouldRunCleanup Whether cleanup should run this bar (based on interval)
export updateNwogExtensions(array<NWOGBox> nwogArray, GapConfig cfg, float dailyAtr, bool shouldRunCleanup) =>
    bool isOneMinute = timeframe.period == "1"
    if array.size(nwogArray) > 0
        for i = 0 to array.size(nwogArray) - 1
            NWOGBox nwog = array.get(nwogArray, i)
            bool isCurrent = i == array.size(nwogArray) - 1
            bool allowedByTf = not isOneMinute or isCurrent
            if nwog.isActive and allowedByTf
                bool withinDistance = isWithinPriceDistance(nwog.topPrice, nwog.bottomPrice, close, dailyAtr, cfg.onlyShowNearPrice, cfg.maxDistanceAtr)
                if withinDistance
                    [fillCol, borderCol, midCol, quadCol] = getGapColors(cfg.nwogColor, cfg.boxFillTransp, cfg.boxBorderTransp, cfg.midLineColor, cfg.quadLineColor)
                    int safeLeftBar = math.max(nwog.startBar, bar_index - 500)

                    if na(nwog.nwogBox)
                        nwog.nwogBox := box.new(safeLeftBar, nwog.topPrice, bar_index + cfg.barOffset, nwog.bottomPrice, border_color = borderCol, border_width = cfg.boxBorderWidth, bgcolor = fillCol)
                        array.set(nwogArray, i, nwog)

                    if cfg.showMidline
                        if na(nwog.midLine)
                            nwog.midLine := line.new(safeLeftBar, nwog.midPrice, bar_index + cfg.barOffset, nwog.midPrice, color = midCol, style = getLineStyle(cfg.midLineStyle), width = 1)
                            array.set(nwogArray, i, nwog)
                    else
                        if not na(nwog.midLine)
                            line.delete(nwog.midLine)
                            nwog.midLine := na
                            array.set(nwogArray, i, nwog)

                    if cfg.showQuadrants
                        if na(nwog.q3Line)
                            nwog.q3Line := line.new(safeLeftBar, nwog.upperQuad, bar_index + cfg.barOffset, nwog.upperQuad, color = quadCol, style = getLineStyle(cfg.quadLineStyle), width = 1)
                            array.set(nwogArray, i, nwog)
                        if na(nwog.q1Line)
                            nwog.q1Line := line.new(safeLeftBar, nwog.lowerQuad, bar_index + cfg.barOffset, nwog.lowerQuad, color = quadCol, style = getLineStyle(cfg.quadLineStyle), width = 1)
                            array.set(nwogArray, i, nwog)
                    else
                        if not na(nwog.q3Line)
                            line.delete(nwog.q3Line)
                            nwog.q3Line := na
                            array.set(nwogArray, i, nwog)
                        if not na(nwog.q1Line)
                            line.delete(nwog.q1Line)
                            nwog.q1Line := na
                            array.set(nwogArray, i, nwog)

                    int rightEdge = bar_index + cfg.barOffset
                    if cfg.extensionMode == "Extend to Week Close" and nwog.weekEnded
                        rightEdge := nwog.weekEndBar

                    if cfg.extensionMode == "Extend Live"
                        if not na(nwog.nwogBox)
                            box.set_right(nwog.nwogBox, bar_index + cfg.barOffset)
                        if not na(nwog.midLine)
                            line.set_x2(nwog.midLine, bar_index + cfg.barOffset)
                        if not na(nwog.q3Line)
                            line.set_x2(nwog.q3Line, bar_index + cfg.barOffset)
                        if not na(nwog.q1Line)
                            line.set_x2(nwog.q1Line, bar_index + cfg.barOffset)
                    else
                        int targetX = nwog.weekEnded ? nwog.weekEndBar : bar_index + cfg.barOffset
                        if not na(nwog.nwogBox)
                            box.set_right(nwog.nwogBox, targetX)
                        if not na(nwog.midLine)
                            line.set_x2(nwog.midLine, targetX)
                        if not na(nwog.q3Line)
                            line.set_x2(nwog.q3Line, targetX)
                        if not na(nwog.q1Line)
                            line.set_x2(nwog.q1Line, targetX)

                    bool shouldShowLabel = cfg.showNwogLabels and (cfg.extensionMode == "Extend Live" or not nwog.weekEnded) and (not cfg.hideHistoryLabels or isCurrent)
                    if shouldShowLabel
                        int daysAgo = calcTradingDaysAgo(nwog.creationTime)
                        string labelText = buildNwogLabelText(nwog.gapType, daysAgo, cfg.labelStyle)
                        if na(nwog.infoLabel)
                            nwog.infoLabel := label.new(rightEdge, nwog.midPrice, labelText, xloc.bar_index, yloc.price, color.new(color.white, 100), label.style_label_left, cfg.nwogTextColor, getLabelSize(cfg.labelSize), text.align_left)
                            array.set(nwogArray, i, nwog)
                        else
                            label.set_x(nwog.infoLabel, rightEdge)
                            label.set_text(nwog.infoLabel, labelText)
                            label.set_textcolor(nwog.infoLabel, cfg.nwogTextColor)
                    else
                        if not na(nwog.infoLabel)
                            label.delete(nwog.infoLabel)
                            nwog.infoLabel := na
                            array.set(nwogArray, i, nwog)
                else
                    if shouldRunCleanup
                        if not na(nwog.nwogBox)
                            box.delete(nwog.nwogBox)
                            nwog.nwogBox := na
                            array.set(nwogArray, i, nwog)
                        if not na(nwog.midLine)
                            line.delete(nwog.midLine)
                            nwog.midLine := na
                            array.set(nwogArray, i, nwog)
                        if not na(nwog.q3Line)
                            line.delete(nwog.q3Line)
                            nwog.q3Line := na
                            array.set(nwogArray, i, nwog)
                        if not na(nwog.q1Line)
                            line.delete(nwog.q1Line)
                            nwog.q1Line := na
                            array.set(nwogArray, i, nwog)
                        if not na(nwog.infoLabel)
                            label.delete(nwog.infoLabel)
                            nwog.infoLabel := na
                            array.set(nwogArray, i, nwog)
            else
                if not na(nwog.nwogBox)
                    box.delete(nwog.nwogBox)
                    nwog.nwogBox := na
                    array.set(nwogArray, i, nwog)
                if not na(nwog.midLine)
                    line.delete(nwog.midLine)
                    nwog.midLine := na
                    array.set(nwogArray, i, nwog)
                if not na(nwog.q3Line)
                    line.delete(nwog.q3Line)
                    nwog.q3Line := na
                    array.set(nwogArray, i, nwog)
                if not na(nwog.q1Line)
                    line.delete(nwog.q1Line)
                    nwog.q1Line := na
                    array.set(nwogArray, i, nwog)
                if not na(nwog.infoLabel)
                    label.delete(nwog.infoLabel)
                    nwog.infoLabel := na
                    array.set(nwogArray, i, nwog)

// @function Update all NDOG box/line/label extensions and handle cleanup
// @param ndogArray Array of NDOGBox objects
// @param cfg GapConfig with all settings
// @param dailyAtr Current daily ATR value for distance filtering
// @param shouldRunCleanup Whether cleanup should run this bar (based on interval)
export updateNdogExtensions(array<NDOGBox> ndogArray, GapConfig cfg, float dailyAtr, bool shouldRunCleanup) =>
    bool isOneMinute = timeframe.period == "1"
    if array.size(ndogArray) > 0
        for i = 0 to array.size(ndogArray) - 1
            NDOGBox ndog = array.get(ndogArray, i)
            bool isCurrent = i == array.size(ndogArray) - 1
            bool allowedByTf = not isOneMinute or isCurrent
            if ndog.isActive and allowedByTf
                bool withinDistance = isWithinPriceDistance(ndog.topPrice, ndog.bottomPrice, close, dailyAtr, cfg.onlyShowNearPrice, cfg.maxDistanceAtr)
                if withinDistance
                    [fillCol, borderCol, midCol, quadCol] = getNdogColors(cfg.ndogColor, cfg.boxFillTransp, cfg.boxBorderTransp, cfg.midLineColor, cfg.quadLineColor)
                    int safeLeftBar = math.max(ndog.startBar, bar_index - 500)

                    if na(ndog.ndogBox)
                        ndog.ndogBox := box.new(safeLeftBar, ndog.topPrice, bar_index + cfg.barOffset, ndog.bottomPrice, border_color = borderCol, border_width = cfg.boxBorderWidth, bgcolor = fillCol)
                        array.set(ndogArray, i, ndog)

                    if cfg.showMidline
                        if na(ndog.midLine)
                            ndog.midLine := line.new(safeLeftBar, ndog.midPrice, bar_index + cfg.barOffset, ndog.midPrice, color = midCol, style = getLineStyle(cfg.midLineStyle), width = 1)
                            array.set(ndogArray, i, ndog)
                    else
                        if not na(ndog.midLine)
                            line.delete(ndog.midLine)
                            ndog.midLine := na
                            array.set(ndogArray, i, ndog)

                    if cfg.showQuadrants
                        if na(ndog.q3Line)
                            ndog.q3Line := line.new(safeLeftBar, ndog.upperQuad, bar_index + cfg.barOffset, ndog.upperQuad, color = quadCol, style = getLineStyle(cfg.quadLineStyle), width = 1)
                            array.set(ndogArray, i, ndog)
                        if na(ndog.q1Line)
                            ndog.q1Line := line.new(safeLeftBar, ndog.lowerQuad, bar_index + cfg.barOffset, ndog.lowerQuad, color = quadCol, style = getLineStyle(cfg.quadLineStyle), width = 1)
                            array.set(ndogArray, i, ndog)
                    else
                        if not na(ndog.q3Line)
                            line.delete(ndog.q3Line)
                            ndog.q3Line := na
                            array.set(ndogArray, i, ndog)
                        if not na(ndog.q1Line)
                            line.delete(ndog.q1Line)
                            ndog.q1Line := na
                            array.set(ndogArray, i, ndog)

                    int rightEdge = bar_index + cfg.barOffset
                    if cfg.ndogExtensionMode == "Extend to Day Close" and ndog.dayEnded
                        rightEdge := ndog.dayEndBar

                    if cfg.ndogExtensionMode == "Extend Live"
                        if not na(ndog.ndogBox)
                            box.set_right(ndog.ndogBox, bar_index + cfg.barOffset)
                        if not na(ndog.midLine)
                            line.set_x2(ndog.midLine, bar_index + cfg.barOffset)
                        if not na(ndog.q3Line)
                            line.set_x2(ndog.q3Line, bar_index + cfg.barOffset)
                        if not na(ndog.q1Line)
                            line.set_x2(ndog.q1Line, bar_index + cfg.barOffset)
                    else
                        int targetX = ndog.dayEnded ? ndog.dayEndBar : bar_index + cfg.barOffset
                        if not na(ndog.ndogBox)
                            box.set_right(ndog.ndogBox, targetX)
                        if not na(ndog.midLine)
                            line.set_x2(ndog.midLine, targetX)
                        if not na(ndog.q3Line)
                            line.set_x2(ndog.q3Line, targetX)
                        if not na(ndog.q1Line)
                            line.set_x2(ndog.q1Line, targetX)

                    bool shouldShowLabel = cfg.showNdogLabels and (cfg.ndogExtensionMode == "Extend Live" or not ndog.dayEnded) and (not cfg.hideHistoryLabels or isCurrent)
                    if shouldShowLabel
                        int daysAgo = calcTradingDaysAgo(ndog.creationTime)
                        string labelText = buildNdogLabelText(ndog.isBullish, daysAgo, cfg.labelStyle)
                        if na(ndog.infoLabel)
                            ndog.infoLabel := label.new(rightEdge, ndog.midPrice, labelText, xloc.bar_index, yloc.price, color.new(color.white, 100), label.style_label_left, cfg.nwogTextColor, getLabelSize(cfg.labelSize), text.align_left)
                            array.set(ndogArray, i, ndog)
                        else
                            label.set_x(ndog.infoLabel, rightEdge)
                            label.set_text(ndog.infoLabel, labelText)
                            label.set_textcolor(ndog.infoLabel, cfg.nwogTextColor)
                    else
                        if not na(ndog.infoLabel)
                            label.delete(ndog.infoLabel)
                            ndog.infoLabel := na
                            array.set(ndogArray, i, ndog)
                else
                    if shouldRunCleanup
                        if not na(ndog.ndogBox)
                            box.delete(ndog.ndogBox)
                            ndog.ndogBox := na
                            array.set(ndogArray, i, ndog)
                        if not na(ndog.midLine)
                            line.delete(ndog.midLine)
                            ndog.midLine := na
                            array.set(ndogArray, i, ndog)
                        if not na(ndog.q3Line)
                            line.delete(ndog.q3Line)
                            ndog.q3Line := na
                            array.set(ndogArray, i, ndog)
                        if not na(ndog.q1Line)
                            line.delete(ndog.q1Line)
                            ndog.q1Line := na
                            array.set(ndogArray, i, ndog)
                        if not na(ndog.infoLabel)
                            label.delete(ndog.infoLabel)
                            ndog.infoLabel := na
                            array.set(ndogArray, i, ndog)
            else
                if not na(ndog.ndogBox)
                    box.delete(ndog.ndogBox)
                    ndog.ndogBox := na
                    array.set(ndogArray, i, ndog)
                if not na(ndog.midLine)
                    line.delete(ndog.midLine)
                    ndog.midLine := na
                    array.set(ndogArray, i, ndog)
                if not na(ndog.q3Line)
                    line.delete(ndog.q3Line)
                    ndog.q3Line := na
                    array.set(ndogArray, i, ndog)
                if not na(ndog.q1Line)
                    line.delete(ndog.q1Line)
                    ndog.q1Line := na
                    array.set(ndogArray, i, ndog)
                if not na(ndog.infoLabel)
                    label.delete(ndog.infoLabel)
                    ndog.infoLabel := na
                    array.set(ndogArray, i, ndog)

// @function Mark week end for all active NWOGs when week close rising edge detected
// @param nwogArray Array of NWOGBox objects
// @param isWeekCloseRisingEdge Whether the week close rising edge was detected this bar
export markWeekEndForNwogs(array<NWOGBox> nwogArray, bool isWeekCloseRisingEdge) =>
    if array.size(nwogArray) > 0
        for i = 0 to array.size(nwogArray) - 1
            NWOGBox nwog = array.get(nwogArray, i)
            if nwog.isActive and not nwog.weekEnded
                if isWeekCloseRisingEdge
                    nwog.weekEnded := true
                    nwog.weekEndBar := bar_index
                    array.set(nwogArray, i, nwog)

// @function Mark day end for all active NDOGs when new trading day detected
// @param ndogArray Array of NDOGBox objects
// @param isNewTradingDay Whether a new trading day started this bar
export markDayEndForNdogs(array<NDOGBox> ndogArray, bool isNewTradingDay) =>
    if array.size(ndogArray) > 0
        for i = 0 to array.size(ndogArray) - 1
            NDOGBox ndog = array.get(ndogArray, i)
            if ndog.isActive and not ndog.dayEnded
                if isNewTradingDay
                    ndog.dayEnded := true
                    ndog.dayEndBar := bar_index - 1
                    array.set(ndogArray, i, ndog)

// ============================================================================
// PXH/L FUNCTIONS
// ============================================================================

// @function Convert a size string to a size constant
// @param s Size string ("Auto", "Tiny", "Small", "Normal", "Large")
// @returns Corresponding size constant
export f_get_size(string s) =>
    switch s
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

// @function Convert a style string to a line style constant (PXH/L version)
// @param str Style string ("Solid", "Dotted", "Dashed")
// @returns Corresponding line style constant
export f_get_pxhl_style(string str) =>
    switch str
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_solid

// @function Check if a target price is within distance filter range
// @param target_price The price to check
// @param filter_enabled Whether the distance filter is enabled
// @param daily_atr Current daily ATR value
// @param filter_preset Filter preset string ("Really Close", "Balanced", "Slightly Far")
// @returns true if within distance (or filter disabled)
export f_is_within_distance(float target_price, bool filter_enabled, float daily_atr, string filter_preset) =>
    if not filter_enabled
        true
    else if na(daily_atr) or daily_atr == 0
        true
    else
        float mult = filter_preset == "Really Close" ? 0.5 : filter_preset == "Balanced" ? 1.0 : 3.0
        float dist = math.abs(close - target_price)
        dist <= (daily_atr * mult)

// @function Find the exact bar time where a high/low occurred within a period window
// @param target_price The price to find
// @param p_start Period start time
// @param p_end Period end time
// @param is_high Whether looking for a high (true) or low (false)
// @returns Timestamp of the exact bar where the price was found
export f_find_exact_in_window(float target_price, int p_start, int p_end, bool is_high) =>
    int t_exact = p_start
    if not na(target_price) and not na(p_start) and not na(p_end)
        int max_bars = 4000
        for i = 0 to max_bars
            if time[i] < p_start
                break
            if time[i] >= p_start and time[i] < p_end
                bool match = false
                if is_high
                    if math.abs(high[i] - target_price) < (syminfo.mintick * 1.5)
                        match := true
                else
                    if math.abs(low[i] - target_price) < (syminfo.mintick * 1.5)
                        match := true
                if match
                    t_exact := time[i]
                    break
    t_exact

// @function Smart-add high/low levels to an array, maintaining count limit
// @param arr Array of Level objects
// @param h High price to add
// @param l Low price to add
// @param t_start Period start time
// @param t_end Period end time
// @param count Maximum number of level pairs
export f_add_level_smart(array<Level> arr, float h, float l, int t_start, int t_end, int count) =>
    if count > 0
        int t_h_exact = f_find_exact_in_window(h, t_start, t_end, true)
        int t_l_exact = f_find_exact_in_window(l, t_start, t_end, false)

        array.unshift(arr, Level.new(l, t_l_exact, false))
        array.unshift(arr, Level.new(h, t_h_exact, true))

        while array.size(arr) > (count * 2)
            array.pop(arr)

// @function Check mitigation of levels in an array (price broke through)
// @param arr Array of Level objects to check
export f_check_mitigation(array<Level> arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            Level lvl = array.get(arr, i)
            if not lvl.broken
                if lvl.is_high and high > lvl.price
                    lvl.broken := true
                    lvl.stop_time := time[1]
                else if not lvl.is_high and low < lvl.price
                    lvl.broken := true
                    lvl.stop_time := time[1]

// @function Draw a single PXH/L level line and optional label
// @param draw_lines Array to store created line objects
// @param draw_labels Array to store created label objects
// @param t_start Start time for the line
// @param t_end End time for the line
// @param price Price level
// @param txt Label text
// @param col Line/label color
// @param sty Line style constant
// @param show_lbl Whether to show the label
// @param size_val Label size constant
// @param font_val Font family constant
// @param filter_enabled Whether distance filter is enabled
// @param daily_atr Current daily ATR
// @param filter_preset Distance filter preset string
export f_draw_single_level(array<line> draw_lines, array<label> draw_labels, int t_start, int t_end, float price, string txt, color col, string sty, bool show_lbl, string size_val, string font_val, bool filter_enabled, float daily_atr, string filter_preset) =>
    if f_is_within_distance(price, filter_enabled, daily_atr, filter_preset)
        l = line.new(t_start, price, t_end, price, xloc=xloc.bar_time, color=col, style=f_get_pxhl_style(sty))
        array.push(draw_lines, l)
        if show_lbl
            lb = label.new(t_end, price, txt, xloc=xloc.bar_time, color=color.new(color.white, 100), style=label.style_label_left, textcolor=col, size=f_get_size(size_val), text_font_family=font_val)
            array.push(draw_labels, lb)

// @function Clear all PXH/L drawing objects (lines and labels)
// @param draw_lines Array of line objects to delete
// @param draw_labels Array of label objects to delete
export f_clear_drawings(array<line> draw_lines, array<label> draw_labels) =>
    while array.size(draw_lines) > 0
        line.delete(array.pop(draw_lines))
    while array.size(draw_labels) > 0
        label.delete(array.pop(draw_labels))

// @function Draw all levels from a PXH/L level array with EQ/Quadrant support
// @param arr Array of Level objects
// @param show Whether to show this timeframe's levels
// @param mode Midline mode ("None", "EQ", "Quadrants")
// @param show_lbl Whether to show labels
// @param col Level color
// @param sty_global Global style string ("Solid", "Dotted", "Dashed")
// @param txt_base Base text for labels (e.g. "pD", "pW", "pM")
// @param txt_size_val Label size string
// @param font_val Font family constant
// @param draw_lines Array to store created line objects
// @param draw_labels Array to store created label objects
// @param filter_enabled Whether distance filter is enabled
// @param daily_atr Current daily ATR
// @param filter_preset Distance filter preset string
export f_draw_levels(array<Level> arr, bool show, string mode, bool show_lbl, color col, string sty_global, string txt_base, string txt_size_val, string font_val, array<line> draw_lines, array<label> draw_labels, bool filter_enabled, float daily_atr, string filter_preset) =>
    if show and array.size(arr) > 0
        int forward_offset = timeframe.in_seconds(timeframe.period) * 1000 * 10
        int t_future = time + forward_offset

        for i = 0 to array.size(arr) - 1
            Level lvl = array.get(arr, i)

            // --- DRAW HIGHS & LOWS ---
            int t_end_hl = lvl.broken ? lvl.stop_time : t_future
            string lbl_txt = txt_base + (lvl.is_high ? ".H" : ".L")
            string lbl_style_hl = lvl.is_high ? (lvl.broken ? label.style_label_down : label.style_label_left) : (lvl.broken ? label.style_label_up : label.style_label_left)

            if f_is_within_distance(lvl.price, filter_enabled, daily_atr, filter_preset) and lvl.start_time < t_end_hl
                l = line.new(lvl.start_time, lvl.price, t_end_hl, lvl.price, xloc=xloc.bar_time, color=col, style=f_get_pxhl_style(sty_global))
                array.push(draw_lines, l)

                if show_lbl
                    lb = label.new(t_end_hl, lvl.price, lbl_txt, xloc=xloc.bar_time, color=color.new(color.white, 100), style=lbl_style_hl, textcolor=col, size=f_get_size(txt_size_val), text_font_family=font_val)
                    array.push(draw_labels, lb)

            // --- DRAW EQ / QUADRANTS ---
            if mode != "None" and i == 0 and array.size(arr) >= 2
                Level partner = array.get(arr, 1)

                float h_price = math.max(lvl.price, partner.price)
                float l_price = math.min(lvl.price, partner.price)
                int eq_start  = math.min(lvl.start_time, partner.start_time)
                float diff    = h_price - l_price

                f_draw_single_level(draw_lines, draw_labels, eq_start, t_future, l_price + (diff * 0.5), txt_base + ".EQ", col, sty_global, show_lbl, txt_size_val, font_val, filter_enabled, daily_atr, filter_preset)

                if mode == "Quadrants"
                    f_draw_single_level(draw_lines, draw_labels, eq_start, t_future, l_price + (diff * 0.75), txt_base + ".75", col, sty_global, show_lbl, txt_size_val, font_val, filter_enabled, daily_atr, filter_preset)
                    f_draw_single_level(draw_lines, draw_labels, eq_start, t_future, l_price + (diff * 0.25), txt_base + ".25", col, sty_global, show_lbl, txt_size_val, font_val, filter_enabled, daily_atr, filter_preset)

// ============================================================================
// 9:30 NY OPENING RANGE GAP
// ============================================================================

// @function Process 9:30 NY opening range gap from 1-minute lower timeframe data.
//   Handles the entire gap creation logic: detects the 16:14 (or 15:59 for stocks) close,
//   then at 9:30 creates box/midline/quadrant drawings.
// @param cfg930 Gap930Config with all 9:30 gap settings
// @param m1_time Array of 1-minute bar timestamps from request.security_lower_tf
// @param m1_open Array of 1-minute bar open prices from request.security_lower_tf
// @param m1_close Array of 1-minute bar close prices from request.security_lower_tf
// @param g930_prevClosePrice Previous close price state (pass in, returns updated value)
// @param g930_boxArray Array to store created box objects
// @param g930_lineArray Array to store created line objects
// @param isStock Whether the symbol is a stock/fund/dr
// @param isValidTimeframe930 Whether the current timeframe is valid for 9:30 gaps (intraday <= 15min)
// @returns Updated g930_prevClosePrice value
export process_930_gap(Gap930Config cfg930, array<int> m1_time, array<float> m1_open, array<float> m1_close, float g930_prevClosePrice, array<box> g930_boxArray, array<line> g930_lineArray, bool isStock, bool isValidTimeframe930) =>
    float updatedPrevClose = g930_prevClosePrice
    int target_close_h = isStock ? 15 : 16
    int target_close_m = isStock ? 59 : 14
    if array.size(m1_time) > 0
        for i = 0 to array.size(m1_time) - 1
            t  = array.get(m1_time, i)
            op = array.get(m1_open, i)
            cl = array.get(m1_close, i)
            int ny_y  = year(t, "America/New_York")
            int ny_mo = month(t, "America/New_York")
            int ny_d  = dayofmonth(t, "America/New_York")
            int t_target_close = timestamp("America/New_York", ny_y, ny_mo, ny_d, target_close_h, target_close_m, 00)

            if t == t_target_close
                updatedPrevClose := cl

            int t_930 = timestamp("America/New_York", ny_y, ny_mo, ny_d, 9, 30, 00)
            if t == t_930
                if cfg930.g930_historyCount > 0 and not na(updatedPrevClose) and isValidTimeframe930
                    float gapHigh = math.max(updatedPrevClose, op)
                    float gapLow  = math.min(updatedPrevClose, op)
                    float diff    = gapHigh - gapLow
                    float lvl50   = gapLow + (diff * 0.50)
                    float lvl25   = gapLow + (diff * 0.25)
                    float lvl75   = gapLow + (diff * 0.75)
                    int t_end = timestamp("America/New_York", ny_y, ny_mo, ny_d, cfg930.g930_projEndH, cfg930.g930_projEndM, 0)
                    if t_end <= t
                        t_end := t + 60000
                    if cfg930.g930_showBox
                        newBox = box.new(left = t, top = gapHigh, right = t_end, bottom = gapLow, xloc = xloc.bar_time, bgcolor = cfg930.g930_boxColor, border_color = color.new(color.white, 90))
                        array.push(g930_boxArray, newBox)
                    if cfg930.g930_showMid
                        ln50 = line.new(x1 = t, y1 = lvl50, x2 = t_end, y2 = lvl50, xloc = xloc.bar_time, color = cfg930.g930_midColor, style = getLineStyle(cfg930.g930_midStyleStr))
                        array.push(g930_lineArray, ln50)
                    if cfg930.g930_showQuad
                        ln25 = line.new(x1 = t, y1 = lvl25, x2 = t_end, y2 = lvl25, xloc = xloc.bar_time, color = cfg930.g930_quadColor, style = getLineStyle(cfg930.g930_quadStyleStr))
                        array.push(g930_lineArray, ln25)
                        ln75 = line.new(x1 = t, y1 = lvl75, x2 = t_end, y2 = lvl75, xloc = xloc.bar_time, color = cfg930.g930_quadColor, style = getLineStyle(cfg930.g930_quadStyleStr))
                        array.push(g930_lineArray, ln75)
                    if array.size(g930_boxArray) > cfg930.g930_historyCount
                        box.delete(array.shift(g930_boxArray))
                    while array.size(g930_lineArray) > (cfg930.g930_historyCount * 3)
                        line.delete(array.shift(g930_lineArray))
    updatedPrevClose
