//@version=6
// @description Library holding exact envelope band percentages for stocks A-H
library("EnvelopeLibrary_AH", overlay=true)

export getPct_A_H(string symbol, string tf) =>
    float val = -1.0
    val := switch symbol
        "360ONE"     => tf == "D" ? 3.00 : tf == "W" ? 7.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 22.00 : 28.00
        "3MINDIA"    => tf == "D" ? 1.50 : tf == "W" ? 4.00 : tf == "M" ? 10.00 : tf == "3M" ? 17.00 : tf == "6M" ? 25.00 : 40.00
        "AARTIDRUGS" => tf == "D" ? 3.00 : tf == "W" ? 10.00 : tf == "M" ? 18.00 : tf == "3M" ? 30.00 : tf == "6M" ? 40.00 : 50.00
        "AARTIIND"   => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 11.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 45.00
        "AARTIPHARM" => tf == "D" ? 3.00 : tf == "W" ? 8.00 : tf == "M" ? 12.00 : tf == "3M" ? 17.00 : tf == "6M" ? 22.00 : 28.00
        "AAVAS"      => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 35.00
        "ABB"        => tf == "D" ? 2.50 : tf == "W" ? 5.00 : tf == "M" ? 11.00 : tf == "3M" ? 20.00 : tf == "6M" ? 32.00 : 40.00
        "ABBOTINDIA" => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 35.00
        "ABCAPITAL"  => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 18.00 : tf == "6M" ? 24.00 : 28.00
        "ABFRL"      => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 15.00 : tf == "6M" ? 20.00 : 25.00
        "ACC"        => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 11.00 : tf == "6M" ? 18.00 : 23.00
        "ACCELYA"    => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 25.00 : tf == "6M" ? 30.00 : 40.00
        "ACE"        => tf == "D" ? 4.00 : tf == "W" ? 8.00 : tf == "M" ? 17.00 : tf == "3M" ? 25.00 : tf == "6M" ? 40.00 : 50.00
        "ADANIENT"   => tf == "D" ? 4.00 : tf == "W" ? 10.00 : tf == "M" ? 11.00 : tf == "3M" ? 30.00 : tf == "6M" ? 45.00 : 50.00
        "ADANIPORTS" => tf == "D" ? 1.75 : tf == "W" ? 6.00 : tf == "M" ? 11.00 : tf == "3M" ? 18.00 : tf == "6M" ? 25.00 : 35.00
        "ADANIPOWER" => tf == "D" ? 3.00 : tf == "W" ? 10.00 : tf == "M" ? 15.00 : tf == "3M" ? 30.00 : tf == "6M" ? 30.00 : 35.00
        "ALKEM"      => tf == "D" ? 2.00 : tf == "W" ? 3.00 : tf == "M" ? 8.00  : tf == "3M" ? 12.00 : tf == "6M" ? 16.00 : 20.00
        "AMBUJACEM"  => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 15.00 : tf == "6M" ? 20.00 : 25.00
        "APOLLOHOSP" => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 13.00 : tf == "6M" ? 18.00 : 26.00
        "APOLLOTYRE" => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 20.00 : tf == "6M" ? 26.00 : 35.00
        "ASHOKLEY"   => tf == "D" ? 4.00 : tf == "W" ? 7.00 : tf == "M" ? 10.00 : tf == "3M" ? 16.00 : tf == "6M" ? 23.00 : 30.00
        "ASIANPAINT" => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 7.00  : tf == "3M" ? 14.00 : tf == "6M" ? 21.00 : 30.00
        "ASTRAL"     => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 9.00  : tf == "3M" ? 18.00 : tf == "6M" ? 28.00 : 35.00
        "ATHERENERG" => tf == "D" ? 0.00 : tf == "W" ? 0.00 : tf == "M" ? 15.00 : tf == "3M" ? 30.00 : tf == "6M" ? 0.00  : 0.00
        "ATUL"       => tf == "D" ? 2.50 : tf == "W" ? 4.00 : tf == "M" ? 10.00 : tf == "3M" ? 20.00 : tf == "6M" ? 35.00 : 45.00
        "AUBANK"     => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 12.00 : tf == "6M" ? 14.00 : 18.00
        "AXISBANK"   => tf == "D" ? 2.00 : tf == "W" ? 3.00 : tf == "M" ? 6.00  : tf == "3M" ? 10.00 : tf == "6M" ? 15.00 : 25.00
        "BEL"        => tf == "D" ? 2.50 : tf == "W" ? 6.00 : tf == "M" ? 14.00 : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 40.00
        "BHEL"       => tf == "D" ? 4.00 : tf == "W" ? 8.00 : tf == "M" ? 12.00 : tf == "3M" ? 20.00 : tf == "6M" ? 27.00 : 35.00
        "BPCL"       => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 12.00 : tf == "3M" ? 23.00 : tf == "6M" ? 30.00 : 40.00
        "BRITANNIA"  => tf == "D" ? 1.50 : tf == "W" ? 3.00 : tf == "M" ? 6.00  : tf == "3M" ? 15.00 : tf == "6M" ? 20.00 : 35.00
        "CIPLA"      => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 7.00  : tf == "3M" ? 15.00 : tf == "6M" ? 21.00 : 28.00
        "COALINDIA"  => tf == "D" ? 2.00 : tf == "W" ? 6.00 : tf == "M" ? 8.00  : tf == "3M" ? 12.00 : tf == "6M" ? 14.00 : 18.00
        "COFORGE"    => tf == "D" ? 2.50 : tf == "W" ? 5.00 : tf == "M" ? 15.00 : tf == "3M" ? 25.00 : tf == "6M" ? 30.00 : 35.00
        "CRAFTSMAN"  => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 15.00 : tf == "6M" ? 22.00 : 25.00
        "DLF"        => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 11.00 : tf == "3M" ? 18.00 : tf == "6M" ? 26.00 : 35.00
        "ECLERX"     => tf == "D" ? 4.00 : tf == "W" ? 9.00 : tf == "M" ? 12.00 : tf == "3M" ? 21.00 : tf == "6M" ? 26.00 : 34.00
        "EICHERMOT"  => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 9.00  : tf == "3M" ? 20.00 : tf == "6M" ? 30.00 : 45.00
        "ESCORTS"    => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 12.00 : tf == "3M" ? 25.00 : tf == "6M" ? 35.00 : 45.00
        "EXIDEIND"   => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 8.00  : tf == "3M" ? 15.00 : tf == "6M" ? 28.00 : 35.00
        "FEDERALBNK" => tf == "D" ? 2.00 : tf == "W" ? 4.00 : tf == "M" ? 9.00  : tf == "3M" ? 14.00 : tf == "6M" ? 22.00 : 30.00
        "GAIL"       => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 10.00 : tf == "3M" ? 15.00 : tf == "6M" ? 20.00 : 25.00
        "GLENMARK"   => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 35.00 : 45.00
        "GODREJCP"   => tf == "D" ? 2.50 : tf == "W" ? 4.50 : tf == "M" ? 8.00  : tf == "3M" ? 15.00 : tf == "6M" ? 21.00 : 32.00
        "GODREJPROP" => tf == "D" ? 3.00 : tf == "W" ? 6.00 : tf == "M" ? 12.00 : tf == "3M" ? 18.00 : tf == "6M" ? 24.00 : 30.00
        "GRASIM"     => tf == "D" ? 2.00 : tf == "W" ? 5.00 : tf == "M" ? 10.00 : tf == "3M" ? 17.00 : tf == "6M" ? 25.00 : 33.00
        "HAL"        => tf == "D" ? 3.00 : tf == "W" ? 5.00 : tf == "M" ? 12.00 : tf == "3M" ? 22.00 : tf == "6M" ? 30.00 : 40.00
        => -1.0
    val