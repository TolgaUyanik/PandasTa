//@version=6
indicator("IV Percentile", shorttitle="IVP", overlay=false, format=format.percent)

// Input parameters
lookback_days = input.int(252, "Lookback Days", minval=10, maxval=500, tooltip="Number of days to look back for percentile calculation")
use_vix_for_spy = input.bool(true, "Use VIX for SPY/SPX", tooltip="Use VIX data when analyzing SPY or SPX")
hv_length = input.int(30, "Historical Volatility Length", minval=5, maxval=100, tooltip="Length for historical volatility calculation")

// Function to calculate historical volatility
calc_hv(length) =>
    returns = math.log(close / close[1])
    stdev = ta.stdev(returns, length)
    hv = stdev * math.sqrt(252) * 100
    hv

// Function to get volatility data
get_volatility() =>
    current_symbol = syminfo.ticker
    // Check if we're looking at SPY/SPX and should use VIX
    if use_vix_for_spy and (current_symbol == "SPY" or current_symbol == "SPX")
        request.security("VIX", timeframe.period, close)
    else
        // For other symbols, use historical volatility as proxy
        calc_hv(hv_length)

// Get current volatility
current_vol = get_volatility()

// Calculate percentile
var vol_history = array.new<float>()

// Store volatility values
if barstate.isconfirmed
    array.push(vol_history, current_vol)
    if array.size(vol_history) > lookback_days
        array.shift(vol_history)

// Calculate IV Percentile
calc_percentile() =>
    if array.size(vol_history) < 10
        na
    else
        count_below = 0
        total_count = array.size(vol_history)
        
        for i = 0 to total_count - 1
            if array.get(vol_history, i) < current_vol
                count_below += 1
        
        percentile = count_below / total_count * 100
        percentile

iv_percentile = calc_percentile()

// Plot the main line
plot(iv_percentile, title="IV Percentile", color=color.blue, linewidth=2)

// Add horizontal reference lines
hline(80, "High IV", color=color.red, linestyle=hline.style_dashed)
hline(70, "Elevated IV", color=color.orange, linestyle=hline.style_dotted)
hline(50, "Median", color=color.gray, linestyle=hline.style_solid)
hline(30, "Low IV", color=color.orange, linestyle=hline.style_dotted)
hline(20, "Very Low IV", color=color.green, linestyle=hline.style_dashed)

// Background color based on IV level
bgcolor_color = if iv_percentile >= 80
    color.new(color.red, 90)
else if iv_percentile >= 70
    color.new(color.orange, 95)
else if iv_percentile <= 20
    color.new(color.green, 95)
else if iv_percentile <= 30
    color.new(color.lime, 97)
else
    na

bgcolor(bgcolor_color, title="IV Level Background")

// Additional plots for screener compatibility
plot(current_vol, title="Current Volatility", display=display.none)
plot(iv_percentile > 70 ? 1 : 0, title="High IV Signal", display=display.none)
plot(iv_percentile < 30 ? 1 : 0, title="Low IV Signal", display=display.none)

// Table showing current values
if barstate.islast
    var info_table = table.new(position.top_right, 2, 4, bgcolor=color.white, border_width=1, border_color=color.gray)
    
    table.cell(info_table, 0, 0, "IV Percentile:", text_color=color.black, text_size=size.small)
    
    percentile_color = iv_percentile >= 70 ? color.red : iv_percentile <= 30 ? color.green : color.black
    table.cell(info_table, 1, 0, str.tostring(iv_percentile, "#.#") + "%", text_color=percentile_color, text_size=size.small)
    
    table.cell(info_table, 0, 1, "Current Vol:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(current_vol, "#.##") + "%", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 2, "Signal:", text_color=color.black, text_size=size.small)
    
    signal_text = if iv_percentile >= 80
        "SELL PREMIUM"
    else if iv_percentile >= 70
        "High IV"
    else if iv_percentile <= 20
        "BUY PREMIUM"
    else if iv_percentile <= 30
        "Low IV"
    else
        "NEUTRAL"
        
    signal_color = iv_percentile >= 70 ? color.red : iv_percentile <= 30 ? color.green : color.orange
    table.cell(info_table, 1, 2, signal_text, text_color=signal_color, text_size=size.small)
    
    table.cell(info_table, 0, 3, "Data Points:", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 3, str.tostring(array.size(vol_history)), text_color=color.black, text_size=size.small)

// Alerts
alertcondition(ta.crossover(iv_percentile, 70), title="IV Percentile Above 70%", message="IV Percentile crossed above 70% - Consider selling premium")
alertcondition(ta.crossunder(iv_percentile, 30), title="IV Percentile Below 30%", message="IV Percentile crossed below 30% - Consider buying premium")
alertcondition(ta.crossover(iv_percentile, 80), title="IV Percentile Above 80%", message="IV Percentile crossed above 80% - High IV environment")
alertcondition(ta.crossunder(iv_percentile, 20), title="IV Percentile Below 20%", message="IV Percentile crossed below 20% - Very low IV environment")