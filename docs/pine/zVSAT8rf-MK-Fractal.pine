//@version=6
library("MK_Fractal", overlay=true)

// ==========================================
// MK CAPITAL GANN FRACTAL LIBRARY v6
// Gann Fractal formulalarini library ko'rinishida
// ==========================================

// ========== ASOSIY FORMULALAR ==========

// RESISTANCE (YUQORIGA) - Qo'llanma:
// ResCal(100, 9) = 101.00
// ResCal(100, 45) = 102.50
export ResCal(float price, float degree) =>
    float result = 0.0
    if degree != 0
        sqrt_price = math.sqrt(price)
        result := (sqrt_price + (degree / 180)) * (sqrt_price + (degree / 180))
    else
        result := 0.0
    result

// SUPPORT (PASTGA) - Qo'llanma:
// SupCal(100, 9) = 99.00
// SupCal(100, 45) = 97.50
export SupCal(float price, float degree) =>
    float result = 0.0
    if degree != 0
        sqrt_price = math.sqrt(price)
        result := (sqrt_price - (degree / 180)) * (sqrt_price - (degree / 180))
    else
        result := 0.0
    result

// ========== MASSIV HISOBLASH ==========

// Barcha 10 ta degrees uchun hisoblash
export CalcAllLevels(float price) =>
    degrees = array.from(9.0, 11.0, 18.0, 30.0, 36.0, 45.0, 54.0, 63.0, 72.0, 81.0)
    resistances = array.new<float>()
    supports = array.new<float>()
    
    for i = 0 to array.size(degrees) - 1
        deg = array.get(degrees, i)
        array.push(resistances, ResCal(price, deg))
        array.push(supports, SupCal(price, deg))
    
    [resistances, supports]

// ========== YAQINLIK TOPISH ==========

// Narx qaysi levelga eng yaqin ekanligini topish
export FindNearestLevel(float current_price, array<float> resistances, array<float> supports) =>
    var nearest_level = 0.0
    var min_distance = 999999.0
    
    // Resistance larni tekshirish
    for i = 0 to array.size(resistances) - 1
        res = array.get(resistances, i)
        distance = math.abs(current_price - res)
        if distance < min_distance
            min_distance := distance
            nearest_level := res
    
    // Support larni tekshirish
    for i = 0 to array.size(supports) - 1
        sup = array.get(supports, i)
        distance = math.abs(current_price - sup)
        if distance < min_distance
            min_distance := distance
            nearest_level := sup
    
    nearest_level

// ========== SIGNAL ANIQLASH ==========

// Narx support-ga yetkanji TRUE beradi (SIGNAL UCHUN)
export IsTouchSupport(float current_price, array<float> supports, float tolerance_pct) =>
    tolerance = current_price * (tolerance_pct / 100)
    is_touch = false
    
    for i = 0 to array.size(supports) - 1
        sup = array.get(supports, i)
        if current_price <= sup + tolerance and current_price >= sup - tolerance
            is_touch := true
            break
    
    is_touch

// Narx resistance-ga yetkanji TRUE beradi (SIGNAL UCHUN)
export IsTouchResistance(float current_price, array<float> resistances, float tolerance_pct) =>
    tolerance = current_price * (tolerance_pct / 100)
    is_touch = false
    
    for i = 0 to array.size(resistances) - 1
        res = array.get(resistances, i)
        if current_price >= res - tolerance and current_price <= res + tolerance
            is_touch := true
            break
    
    is_touch

// ========== LEVEL QAYTARISH ==========

// Spesifik degree uchun resistance va support ikkalasini qaytarish
export GetLevelByDegree(float price, float degree) =>
    res = ResCal(price, degree)
    sup = SupCal(price, degree)
    [res, sup]

// Barcha 10 degree uchun formatted string
export GetFormattedLevels(float price) =>
    degrees = array.from(9, 11, 18, 30, 36, 45, 54, 63, 72, 81)
    output = "GANN FRACTAL LEVELS:\n"
    
    for i = 0 to array.size(degrees) - 1
        deg = array.get(degrees, i)
        res = ResCal(price, deg)
        sup = SupCal(price, deg)
        output += str.format("Gr{0}: R={1} | S={2}\n", i+1, str.tostring(res, "#.##"), str.tostring(sup, "#.##"))
    
    output