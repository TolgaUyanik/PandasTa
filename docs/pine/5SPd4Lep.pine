//@version=6
// ICE CRT Core — Tier A pure functions (Modules 1–5 helpers + Module 6 math/audit)
// M0.1: extracted copy; indicator imports in M0.2 Fase A
// Publish v5: AMD params int/float (accept series from caller); series float ONLY on cSeries
// Indicator import: import OSMANYBTC/ICE_CRT_Core/5 as core
// Pine libraries cannot use built-in OHLC/bar_index — all series passed explicitly.
library("ICE_CRT_Core", true)

// ── Event / Return state constants ───────────────────────────────────────────
export const int EVENT_IDLE     = 0
export const int EVENT_OPEN     = 1
export const int EVENT_REJECTED = 2
export const int EVENT_EXPIRED  = 3

export const int RETURN_IDLE     = 0
export const int RETURN_PENDING  = 1
export const int RETURN_RETURNED = 2
export const int RETURN_EXPIRED  = 3

export const int TRADE_IDLE         = 0
export const int TRADE_OPEN         = 1
export const int TRADE_TP1_HIT      = 2
export const int TRADE_TP2_HIT      = 3
export const int TRADE_CLOSED_TP3   = 4
export const int TRADE_CLOSED_STOP  = 5
export const int TRADE_INVALID      = 6

// ── Module 1 — CRT ───────────────────────────────────────────────────────────
export calcBodySize(float o, float c) =>
    math.abs(c - o)

export calcRangeSize(float h, float l) =>
    h - l

export calcUpperWick(float h, float o, float c) =>
    h - math.max(o, c)

export calcLowerWick(float l, float o, float c) =>
    math.min(o, c) - l

export calcBodyRatio(float bodySize, float rangeSize) =>
    rangeSize > 0 ? bodySize / rangeSize : 0.0

export validateCRT(float o, float h, float l, float c, float bodyRatioMinIn, float atrValIn, float atrMultIn) =>
    bodySize   = calcBodySize(o, c)
    rangeSize  = calcRangeSize(h, l)
    upperWick  = calcUpperWick(h, o, c)
    lowerWick  = calcLowerWick(l, o, c)
    totalWicks = upperWick + lowerWick
    bodyRatio  = calcBodyRatio(bodySize, rangeSize)
    rule1 = rangeSize > 0
    rule2 = bodyRatio >= bodyRatioMinIn
    rule3 = bodySize > totalWicks
    rule4 = rangeSize >= atrValIn * atrMultIn
    valid   = rule1 and rule2 and rule3 and rule4
    crtHigh = h
    crtLow  = l
    crtMid  = (crtHigh + crtLow) / 2.0
    bullish = valid and c > o
    bearish = valid and c < o
    [valid, bullish, bearish, crtHigh, crtLow, crtMid]

export crtLabelText(bool isBullish, bool isBearish) =>
    isBullish ? "CRT Bullish" : isBearish ? "CRT Bearish" : "CRT Valid"

export crtLabelStyle(bool isBullish, bool isBearish) =>
    isBullish ? label.style_label_up : isBearish ? label.style_label_down : label.style_label_center

export crtLabelColor(bool isBullish, bool isBearish, color bullishColor, color bearishColor, color validColor) =>
    isBullish ? bullishColor : isBearish ? bearishColor : validColor

export crtLabelPrice(bool isBullish, bool isBearish, float crtHighIn, float crtLowIn, float crtMidIn) =>
    isBullish ? crtLowIn : isBearish ? crtHighIn : crtMidIn

// ── Module 2B — Grab ───────────────────────────────────────────────────────
export isGrabHigh(float level, float minGrab, float h) =>
    not na(level) and h > level and (h - level) >= minGrab

export isGrabLow(float level, float minGrab, float l) =>
    not na(level) and l < level and (level - l) >= minGrab

// ── Module 2C — Rejection ────────────────────────────────────────────────────
export isAcceptanceHigh(float level, float buffer, float c) =>
    not na(level) and c > level + buffer

export isAcceptanceLow(float level, float buffer, float c) =>
    not na(level) and c < level - buffer

export isWickRejectionHigh(float level, float wickMin, float o, float h, float l, float c) =>
    bodySize  = calcBodySize(o, c)
    rangeSize = calcRangeSize(h, l)
    upperWick = calcUpperWick(h, o, c)
    not na(level) and h > level and rangeSize > 0 and upperWick >= wickMin * rangeSize and upperWick > bodySize

export isWickRejectionLow(float level, float wickMin, float o, float h, float l, float c) =>
    bodySize  = calcBodySize(o, c)
    rangeSize = calcRangeSize(h, l)
    lowerWick = calcLowerWick(l, o, c)
    not na(level) and l < level and rangeSize > 0 and lowerWick >= wickMin * rangeSize and lowerWick > bodySize

export isNoAcceptanceHigh(float level, float h, float c) =>
    not na(level) and h > level and c <= level

export isNoAcceptanceLow(float level, float l, float c) =>
    not na(level) and l < level and c >= level

export isFollowThroughRejectionHigh(float level, int grabBarIn, float c, int barIdx) =>
    not na(level) and barIdx > grabBarIn and c <= level

export isFollowThroughRejectionLow(float level, int grabBarIn, float c, int barIdx) =>
    not na(level) and barIdx > grabBarIn and c >= level

export isRejectedHigh(float level, int grabBarIn, float wickMin, float acceptBuf, float o, float h, float l, float c, int barIdx) =>
    not isAcceptanceHigh(level, acceptBuf, c) and (isWickRejectionHigh(level, wickMin, o, h, l, c) or isNoAcceptanceHigh(level, h, c) or isFollowThroughRejectionHigh(level, grabBarIn, c, barIdx))

export isRejectedLow(float level, int grabBarIn, float wickMin, float acceptBuf, float o, float h, float l, float c, int barIdx) =>
    not isAcceptanceLow(level, acceptBuf, c) and (isWickRejectionLow(level, wickMin, o, h, l, c) or isNoAcceptanceLow(level, l, c) or isFollowThroughRejectionLow(level, grabBarIn, c, barIdx))

export eventStateName(int state) =>
    state == EVENT_IDLE ? "IDLE" : state == EVENT_OPEN ? "OPEN" : state == EVENT_REJECTED ? "REJECTED" : state == EVENT_EXPIRED ? "EXPIRED" : "?"

export processHighLevel(float level, float trackedLevel, int eventState, int grabBar, float grabLevel, float minGrab, int rejWindow, float wickMin, float acceptBuf, float o, float h, float l, float c, int barIdx) =>
    newTracked   = level
    newState     = eventState
    newGrabBar   = grabBar
    newGrabLevel = grabLevel
    grabPulse    = false
    rejectPulse  = false
    if not na(level) and (na(trackedLevel) or level != trackedLevel)
        newState     := EVENT_IDLE
        newGrabBar   := na
        newGrabLevel := na
    grabNow = isGrabHigh(level, minGrab, h)
    if newState == EVENT_IDLE and grabNow
        newState     := EVENT_OPEN
        newGrabBar   := barIdx
        newGrabLevel := level
        grabPulse    := true
    else if newState == EVENT_OPEN and grabNow and barIdx > newGrabBar
        newGrabBar   := barIdx
        newGrabLevel := level
    if newState == EVENT_OPEN
        if isAcceptanceHigh(level, acceptBuf, c)
            newState := EVENT_EXPIRED
        else if isRejectedHigh(level, newGrabBar, wickMin, acceptBuf, o, h, l, c, barIdx)
            newState    := EVENT_REJECTED
            rejectPulse := true
        else if barIdx - newGrabBar > rejWindow
            newState := EVENT_EXPIRED
    [newTracked, newState, newGrabBar, newGrabLevel, grabPulse, rejectPulse]

export processLowLevel(float level, float trackedLevel, int eventState, int grabBar, float grabLevel, float minGrab, int rejWindow, float wickMin, float acceptBuf, float o, float h, float l, float c, int barIdx) =>
    newTracked   = level
    newState     = eventState
    newGrabBar   = grabBar
    newGrabLevel = grabLevel
    grabPulse    = false
    rejectPulse  = false
    if not na(level) and (na(trackedLevel) or level != trackedLevel)
        newState     := EVENT_IDLE
        newGrabBar   := na
        newGrabLevel := na
    grabNow = isGrabLow(level, minGrab, l)
    if newState == EVENT_IDLE and grabNow
        newState     := EVENT_OPEN
        newGrabBar   := barIdx
        newGrabLevel := level
        grabPulse    := true
    else if newState == EVENT_OPEN and grabNow and barIdx > newGrabBar
        newGrabBar   := barIdx
        newGrabLevel := level
    if newState == EVENT_OPEN
        if isAcceptanceLow(level, acceptBuf, c)
            newState := EVENT_EXPIRED
        else if isRejectedLow(level, newGrabBar, wickMin, acceptBuf, o, h, l, c, barIdx)
            newState    := EVENT_REJECTED
            rejectPulse := true
        else if barIdx - newGrabBar > rejWindow
            newState := EVENT_EXPIRED
    [newTracked, newState, newGrabBar, newGrabLevel, grabPulse, rejectPulse]

// ── Module 2D — Return ───────────────────────────────────────────────────────
export returnStateName(int state) =>
    state == RETURN_IDLE ? "RET_IDLE" : state == RETURN_PENDING ? "RET_PENDING" : state == RETURN_RETURNED ? "RETURNED" : state == RETURN_EXPIRED ? "RET_EXPIRED" : "?"

export isInsideCrtRange(float crtHighIn, float crtLowIn, float buffer, float c) =>
    not na(crtHighIn) and not na(crtLowIn) and c >= crtLowIn - buffer and c <= crtHighIn + buffer

export processReturnLevel(float level, float trackedLevel, bool rejectPulseIn, int returnStateIn, int rejectBarIn, int returnBarIn, float crtHighIn, float crtLowIn, bool crtReadyIn, int retWindowIn, float crtBufIn, float c, int barIdx) =>
    newReturnState = returnStateIn
    newRejectBar   = rejectBarIn
    newReturnBar   = returnBarIn
    returnPulse    = false
    sweepPulse     = false
    if not na(level) and (na(trackedLevel) or level != trackedLevel)
        newReturnState := RETURN_IDLE
        newRejectBar   := na
        newReturnBar   := na
    if rejectPulseIn
        newReturnState := RETURN_PENDING
        newRejectBar   := barIdx
    if newReturnState == RETURN_PENDING and crtReadyIn
        if isInsideCrtRange(crtHighIn, crtLowIn, crtBufIn, c)
            newReturnState := RETURN_RETURNED
            newReturnBar   := barIdx
            returnPulse    := true
            sweepPulse     := true
        else if not na(newRejectBar) and barIdx - newRejectBar > retWindowIn
            newReturnState := RETURN_EXPIRED
    [newReturnState, newRejectBar, newReturnBar, returnPulse, sweepPulse]

export isLegitGrabOpen(int stateBefore, bool levelChanged) =>
    stateBefore == EVENT_IDLE or levelChanged

export isLegitReturnFromReject(bool rejectPulse, int returnStateBefore, int rejectBarBefore) =>
    rejectPulse or (returnStateBefore == RETURN_PENDING and not na(rejectBarBefore))

// ── Module 4 — AMD helpers ───────────────────────────────────────────────────
// Mirror legacy: int/float params (series-compatible); series float only on cSeries.

export amdInsideCrtCloseAt(int barsBack, float crtHighIn, float crtLowIn, float buffer, series float cSeries) =>
    not na(crtHighIn) and not na(crtLowIn) and cSeries[barsBack] >= crtLowIn - buffer and cSeries[barsBack] <= crtHighIn + buffer

export amdCountPreGrabInsideCrt(int grabOffsetIn, int lookbackIn, float crtHighIn, float crtLowIn, float buffer, series float cSeries) =>
    int cnt = 0
    int startOff = grabOffsetIn + 1
    if grabOffsetIn > 0 and grabOffsetIn < lookbackIn and startOff <= lookbackIn
        for i = startOff to lookbackIn
            if not na(crtHighIn) and not na(crtLowIn) and cSeries[i] >= crtLowIn - buffer and cSeries[i] <= crtHighIn + buffer
                cnt += 1
    cnt

export amdCountInsideCrtBetweenGrabSweep(int grabOffsetIn, float crtHighIn, float crtLowIn, float buffer, series float cSeries) =>
    int cnt = 0
    if grabOffsetIn > 1
        for i = 1 to grabOffsetIn - 1
            if not na(crtHighIn) and not na(crtLowIn) and cSeries[i] >= crtLowIn - buffer and cSeries[i] <= crtHighIn + buffer
                cnt += 1
    cnt

// ── Module 5 — Entry helpers ─────────────────────────────────────────────────
export entryConfirmCandleLong(float sweptLevelIn, float c, float o, bool insideCrtIn) =>
    not na(sweptLevelIn) and c > o and insideCrtIn and c > sweptLevelIn

export entryConfirmCandleShort(float sweptLevelIn, float c, float o, bool insideCrtIn) =>
    not na(sweptLevelIn) and c < o and insideCrtIn and c < sweptLevelIn

// ── Module 6 — pure struct / validate / audit (no ta.valuewhen) ──────────────
export tradeStateName(int stateIn) =>
    stateIn == TRADE_IDLE ? "IDLE" : stateIn == TRADE_OPEN ? "OPEN" : stateIn == TRADE_TP1_HIT ? "TP1" : stateIn == TRADE_TP2_HIT ? "TP2" : stateIn == TRADE_CLOSED_TP3 ? "CLOSED_TP3" : stateIn == TRADE_CLOSED_STOP ? "CLOSED_STOP" : stateIn == TRADE_INVALID ? "INVALID" : "?"

export tradeStructStopLongPure(float entryIn, float bufIn, float sweepLow, float grabLow, float tsLow, float barLow) =>
    math.min(nz(sweepLow, entryIn), nz(grabLow, entryIn), nz(tsLow, entryIn), barLow) - bufIn

export tradeStructStopShortPure(float entryIn, float bufIn, float sweepHigh, float grabHigh, float tsHigh, float barHigh) =>
    math.max(nz(sweepHigh, entryIn), nz(grabHigh, entryIn), nz(tsHigh, entryIn), barHigh) + bufIn

export tradeStructTp1Long(float entryIn, float crtHighIn, float crtLowIn, float ratioIn) =>
    entryIn + ratioIn * (crtHighIn - crtLowIn)

export tradeStructTp1Short(float entryIn, float crtHighIn, float crtLowIn, float ratioIn) =>
    entryIn - ratioIn * (crtHighIn - crtLowIn)

export tradeStructTp2Long(float crtHighIn) =>
    crtHighIn

export tradeStructTp2Short(float crtLowIn) =>
    crtLowIn

export tradeStructTp3Long(float entryIn, float crtHighIn, float pdhIn, float pwhIn) =>
    float best = crtHighIn
    if not na(pdhIn) and pdhIn > entryIn
        best := pdhIn
    if not na(pwhIn) and pwhIn > entryIn
        best := math.min(best, pwhIn)
    best

export tradeStructTp3Short(float entryIn, float crtLowIn, float pdlIn, float pwlIn) =>
    float best = crtLowIn
    if not na(pdlIn) and pdlIn < entryIn
        best := pdlIn
    if not na(pwlIn) and pwlIn < entryIn
        best := math.max(best, pwlIn)
    best

export tradeCalcRRatio(float entryIn, float stopIn, float targetIn) =>
    float risk = math.abs(entryIn - stopIn)
    float reward = math.abs(targetIn - entryIn)
    risk > 0 ? reward / risk : na

export tradeValidateLong(float entryIn, float stopIn, float tp1In, float tp2In, float tp3In, float minRRIn) =>
    stopIn < entryIn and tp1In > entryIn and tp2In >= tp1In and tp3In >= tp2In and tradeCalcRRatio(entryIn, stopIn, tp1In) >= minRRIn

export tradeValidateShort(float entryIn, float stopIn, float tp1In, float tp2In, float tp3In, float minRRIn) =>
    stopIn > entryIn and tp1In < entryIn and tp2In <= tp1In and tp3In <= tp2In and tradeCalcRRatio(entryIn, stopIn, tp1In) >= minRRIn

export tradeAuditInvalidReason(bool isLongIn, float entryIn, float stopIn, float tp1In, float tp2In, float tp3In, float minRRIn) =>
    string reason = "UNKNOWN"
    if isLongIn
        if stopIn >= entryIn
            reason := "STOP_ABOVE_ENTRY_LONG"
        else if tp1In <= entryIn
            reason := "TP1_INVALID"
        else if tp2In < tp1In
            reason := "TP2_INVALID"
        else if tp3In < tp2In
            reason := "TP3_INVALID"
        else if nz(tradeCalcRRatio(entryIn, stopIn, tp1In), 0.0) < minRRIn
            reason := "RR_TOO_LOW"
    else
        if stopIn <= entryIn
            reason := "STOP_BELOW_ENTRY_SHORT"
        else if tp1In >= entryIn
            reason := "TP1_INVALID"
        else if tp2In > tp1In
            reason := "TP2_INVALID"
        else if tp3In > tp2In
            reason := "TP3_INVALID"
        else if nz(tradeCalcRRatio(entryIn, stopIn, tp1In), 0.0) < minRRIn
            reason := "RR_TOO_LOW"
    reason

export tradeAuditOrderLongOk(float entryIn, float tp1In, float tp2In, float tp3In) =>
    entryIn < tp1In and tp1In <= tp2In and tp2In <= tp3In

export tradeAuditOrderShortOk(float entryIn, float tp1In, float tp2In, float tp3In) =>
    entryIn > tp1In and tp1In >= tp2In and tp2In >= tp3In

export tradeSimTp2OptA(bool isLongIn, float tp1In, float crtHighIn, float crtLowIn, float betaIn) =>
    isLongIn ? tp1In + betaIn * (crtHighIn - tp1In) : tp1In - betaIn * (tp1In - crtLowIn)

export tradeSimTp2OptB(bool isLongIn, float entryIn, float stopIn, float r2In) =>
    float riskR = math.abs(entryIn - stopIn)
    isLongIn ? entryIn + r2In * riskR : entryIn - r2In * riskR

export tradeSimTp2OptC(bool isLongIn, float tp1In, float tp3In, float gammaIn) =>
    isLongIn ? tp1In + gammaIn * (tp3In - tp1In) : tp1In - gammaIn * (tp1In - tp3In)

export tradeSimFailsTp2(bool isLongIn, float tp1In, float tp2In, float tp3In) =>
    isLongIn ? tp2In < tp1In or tp3In < tp2In : tp2In > tp1In or tp3In > tp2In

export tradeSimFailsRR(float entryIn, float stopIn, float tp1In, float minRRIn) =>
    nz(tradeCalcRRatio(entryIn, stopIn, tp1In), 0.0) < minRRIn

export tradeAuditRRReason(float entryIn, float stopIn, float tp1In, float minRRIn) =>
    float riskAmt   = math.abs(entryIn - stopIn)
    float rewardAmt = math.abs(tp1In - entryIn)
    float rrVal     = tradeCalcRRatio(entryIn, stopIn, tp1In)
    string reason   = "RR_OK"
    if riskAmt <= 0
        reason := "RISK_ZERO | |E-Stop|=0"
    else if rewardAmt <= 0
        reason := "REWARD_ZERO | |E-TP1|=0"
    else if nz(rrVal, 0.0) < minRRIn
        float needReward = minRRIn * riskAmt
        reason := "RR_TOO_LOW | RR=" + str.tostring(nz(rrVal, 0.0), "#.####") + "<" + str.tostring(minRRIn, "#.##") + " | need Rew>=" + str.tostring(needReward, format.mintick) + " have " + str.tostring(rewardAmt, format.mintick)
    reason

export tradeAuditRequiredReward(float riskIn, float minRRIn) =>
    minRRIn * riskIn

export tradeAuditMissingReward(float riskIn, float actualRewardIn, float minRRIn) =>
    tradeAuditRequiredReward(riskIn, minRRIn) - actualRewardIn

export tradeAuditTp1ForMinRR(bool isLongIn, float entryIn, float stopIn, float minRRIn) =>
    float reqRew = tradeAuditRequiredReward(math.abs(entryIn - stopIn), minRRIn)
    isLongIn ? entryIn + reqRew : entryIn - reqRew

export tradeAuditTp1Delta(float tp1ActualIn, float tp1NeedIn) =>
    math.abs(tp1NeedIn - tp1ActualIn)

export tradeAuditTp1NeedCrtRatio(float riskIn, float crtRangeIn, float minRRIn) =>
    crtRangeIn > 0 ? minRRIn * riskIn / crtRangeIn : na

export tradeAuditTp1ActualCrtRatio(float distEt1In, float crtRangeIn) =>
    crtRangeIn > 0 ? distEt1In / crtRangeIn : na
