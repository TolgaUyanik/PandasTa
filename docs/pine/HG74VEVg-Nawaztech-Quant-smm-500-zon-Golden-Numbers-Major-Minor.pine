indicator("Golden Numbers (Major & Minor) - Nawaztech Quant", shorttitle="Golden Numbers [NQ]", overlay=true, max_lines_count=500)

// ---- INPUT SETTINGS ----
group_major  = "Major Golden Numbers (بڑے نمبر)"
major_step   = input.int(100, title="Major Interval (e.g. 100 points)", minval=1, group=group_major, tooltip="بڑی لائنز کا فاصلہ، جیسے 100")
major_color  = input.color(color.new(#FFB300, 0), title="Major Line Color (تیز اور گہرا گولڈن)", group=group_major) // تیز اور گہرا گولڈن
major_width  = input.int(3, title="Major Line Width (موٹائی)", minval=1, maxval=5, group=group_major)

group_minor  = "Minor Golden Numbers (چھوٹے نمبر)"
minor_step   = input.int(20, title="Minor Interval (e.g. 20 points)", minval=1, group=group_minor, tooltip="چھوٹی لائنز کا فاصلہ، جیسے 20")
minor_color  = input.color(color.new(#FFD700, 0), title="Minor Line Color (بالکل گولڈن)", group=group_minor) // بالکل گولڈن
minor_width  = input.int(1, title="Minor Line Width (موٹائی)", minval=1, maxval=5, group=group_minor)

group_mid    = "Mid-Level Blue Lines (50 پوائنٹ والے زون کی موٹی لائنیں)"
mid_color    = input.color(color.new(#1E90FF, 10), title="Mid Blue Line Color", group=group_mid) // بلیو کلر
mid_width    = input.int(2, title="Mid Blue Line Width (موٹی لائن)", minval=1, maxval=5, group=group_mid)

group_view   = "Display Settings"
line_count   = input.int(8, title="Lines Above/Below Current Price", minval=1, maxval=20, group=group_view, tooltip="موجودہ قیمت کے اوپر اور نیچے کتنی لائنیں دیکھنی ہیں")

group_watermark = "Watermark Settings (بیک گراؤنڈ نام)"
show_watermark  = input.bool(true, title="Show Brand Name on Background", group=group_watermark)
watermark_color = input.color(color.new(#FFFFFF, 80), title="Name Color & Transparency", group=group_watermark) 
watermark_size  = input.string("huge", title="Watermark Size (واٹر مارک سائز)", options=["normal", "large", "huge"], group=group_watermark)

// ---- SMA SETTINGS (FLEXIBLE) ----
group_sma    = "Moving Average (SMA)"
show_sma     = input.bool(true, title="Show SMA Line", group=group_sma)
sma_length   = input.int(100, title="SMA Length (رینج تبدیل کریں)", minval=1, group=group_sma, tooltip="یہاں سے آپ SMA کی رینج اپنی مرضی کے مطابق بدل سکتے ہیں")
sma_color    = input.color(color.new(#FFD700, 0), title="SMA Color (یلو کلر)", group=group_sma) // Yellow
sma_width    = input.int(2, title="SMA Line Width (موٹائی)", minval=1, maxval=5, group=group_sma)

// ---- LOGIC TO CLEAR OLD LINES ----
var line[] active_lines = array.new_line()

if array.size(active_lines) > 0
    for i = 0 to array.size(active_lines) - 1
        line.delete(array.get(active_lines, i))
    array.clear(active_lines)

// ---- CALCULATE BASE LEVEL ----
current_price = close
start_level = math.floor((current_price - (line_count * major_step)) / minor_step) * minor_step
end_level   = math.ceil((current_price + (line_count * major_step)) / minor_step) * minor_step

// ---- DRAW MAJOR & MINOR LINES ----
for price_level = start_level to end_level by minor_step
    is_major = (math.round(price_level % major_step) == 0)
    
    current_color = is_major ? major_color : minor_color
    current_width = is_major ? major_width : minor_width
    current_style = is_major ? line.style_dashed : line.style_dotted
    
    ln = line.new(x1=bar_index, y1=price_level, x2=bar_index + 10, y2=price_level, 
                  xloc=xloc.bar_index, extend=extend.both, 
                  color=current_color, style=current_style, width=current_width)
    array.push(active_lines, ln)

// ---- DRAW MID-LEVEL 50 LINES (مثلاً 4050، 4150، 2950 والی موٹی بلیو لائنیں) ----
// یہاں ہم بیس کو 100 کے حساب سے الائن کر کے اس میں 50 جمع کر رہے ہیں تاکہ ہر 100 کے درمیان میں (.50) لائن آئے
start_major_base = math.floor(start_level / major_step) * major_step
end_major_base   = math.ceil(end_level / major_step) * major_step

for base_level = start_major_base to end_major_base by major_step
    price_50 = base_level + (major_step / 2.0)
    if price_50 >= start_level and price_50 <= end_level
        ln_mid = line.new(x1=bar_index, y1=price_50, x2=bar_index + 10, y2=price_50, 
                          xloc=xloc.bar_index, extend=extend.both, 
                          color=mid_color, style=line.style_solid, width=mid_width)
        array.push(active_lines, ln_mid)

// ---- SMA CALCULATION & PLOTTING ----
custom_sma = ta.sma(close, sma_length)
plot(show_sma ? custom_sma : na, title="Custom SMA", color=sma_color, linewidth=sma_width)

// ---- 🔒 VISUAL WATERMARK LOGIC (NAWAZTECH QUANT) ----
var table watermark_table = table.new(position.middle_center, 1, 1)
if show_watermark and barstate.islast
    table.cell(watermark_table, 0, 0, text="Nawaztech Quant", text_color=watermark_color, text_size=watermark_size)