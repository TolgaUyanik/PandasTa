//@version=6
// @description Core Helper Library for Market Structure and Benchmark Bias indicators. Encapsulates logic, types, math, and UI formatting.
library("biasHelper")

// ========================================================================== //
// 1. USER-DEFINED TYPES (UDTs)
// ========================================================================== //

export type SessionInfo
    float prevHigh       = na
    float prevLow        = na
    float currentHigh    = na
    float currentLow     = na
    float currentOpen    = na
    float prevHaOpen     = na
    float prevHaClose    = na
    bool  pushedUp       = false
    int   currentBias    = 0
    int   bullishCount   = 0
    int   bearishCount   = 0
    int   hitHighCount   = 0
    int   hitLowCount    = 0
    int   closeHighCount = 0
    int   closeLowCount  = 0

export type SessionLines
    line  highLine       = na
    line  lowLine        = na
    bool  hitHighLine    = false
    bool  hitLowLine     = false

// ========================================================================== //
// 2. CORE LOGIC METHODS (MARKET STRUCTURE)
// ========================================================================== //

// @function Evaluates market structure logic and increments corresponding counters.
// @param infoObj (SessionInfo) The data object being updated.
// @param pClose (float) The previous bar's close (close[1]) to prevent repainting.
export handleBias(SessionInfo infoObj, float pClose) =>
    if pClose > infoObj.prevHigh
        if infoObj.currentBias == 1
            infoObj.closeHighCount += 1
        infoObj.currentBias := 1
    else if pClose < infoObj.prevLow
        if infoObj.currentBias == -1
            infoObj.closeLowCount += 1
        infoObj.currentBias := -1
    else if pClose < infoObj.prevHigh and pClose > infoObj.prevLow and infoObj.currentHigh > infoObj.prevHigh and infoObj.currentLow > infoObj.prevLow
        infoObj.currentBias := -1
    else if pClose > infoObj.prevLow and pClose < infoObj.prevHigh and infoObj.currentHigh < infoObj.prevHigh and infoObj.currentLow < infoObj.prevLow
        infoObj.currentBias := 1
    else if infoObj.currentHigh <= infoObj.prevHigh and infoObj.currentLow >= infoObj.prevLow
        infoObj.currentBias := infoObj.pushedUp ? 1 : -1
    else
        infoObj.currentBias := 0

    if infoObj.currentBias == 1
        infoObj.bullishCount += 1
    else if infoObj.currentBias == -1
        infoObj.bearishCount += 1

// @function Updates OHLC tracking and triggers standard bias logic on new sessions.
// @param infoObj (SessionInfo) The tracking object.
// @param isNew (bool) True if a new session has started.
// @param pClose (float) Previous close data.
// @param cOpen (float) Current open data.
// @param cHigh (float) Current high data.
// @param cLow (float) Current low data.
export method updateData(SessionInfo infoObj, bool isNew, float pClose, float cOpen, float cHigh, float cLow) =>
    if isNew
        if not na(infoObj.currentHigh)
            handleBias(infoObj, pClose)
            infoObj.pushedUp := pClose >= infoObj.currentOpen
            
            infoObj.prevHigh    := infoObj.currentHigh
            infoObj.prevLow     := infoObj.currentLow
            infoObj.currentHigh := cHigh
            infoObj.currentLow  := cLow
            infoObj.currentOpen := cOpen
            
    if na(infoObj.currentHigh)
        infoObj.currentHigh := cHigh
        infoObj.currentLow  := cLow
    else
        infoObj.currentHigh := math.max(cHigh, infoObj.currentHigh)
        infoObj.currentLow  := math.min(cLow,  infoObj.currentLow)

// ========================================================================== //
// 3. CORE LOGIC METHODS (BENCHMARKS)
// ========================================================================== //

// @function Updates OHLC tracking and routes through the specified benchmark bias logic.
// @param infoObj (SessionInfo) The data object being updated.
// @param isNew (bool) True if a new session has started.
// @param pClose (float) Previous close data.
// @param cOpen (float) Current open data.
// @param cHigh (float) Current high data.
// @param cLow (float) Current low data.
// @param bType (string) The benchmark type identifier (e.g., "MOM", "HA", "COIN").
// @param tfSeconds (int) Timeframe in seconds to establish timing parity.
export method updateBenchmarkData(SessionInfo infoObj, bool isNew, float pClose, float cOpen, float cHigh, float cLow, string bType, int tfSeconds) =>
    if isNew
        if not na(infoObj.currentHigh)
            // Pre-process hit close counts common to all benchmarks
            if pClose > infoObj.prevHigh and infoObj.currentBias == 1
                infoObj.closeHighCount += 1
            if pClose < infoObj.prevLow and infoObj.currentBias == -1
                infoObj.closeLowCount += 1
                
            // Benchmark Routing Logic
            if bType == "MOM"
                infoObj.currentBias := pClose > infoObj.currentOpen ? 1 : pClose < infoObj.currentOpen ? -1 : 0
            
            else if bType == "HA"
                float prevHaC = (infoObj.currentOpen + infoObj.currentHigh + infoObj.currentLow + pClose) / 4
                float prevHaO = na(infoObj.prevHaOpen) ? (infoObj.currentOpen + pClose) / 2 : (infoObj.prevHaOpen + infoObj.prevHaClose) / 2
                infoObj.prevHaOpen  := prevHaO
                infoObj.prevHaClose := prevHaC
                infoObj.currentBias := prevHaC > prevHaO ? 1 : prevHaC < prevHaO ? -1 : 0
                
            else if bType == "ABULL"
                infoObj.currentBias := 1
                
            else if bType == "ABEAR"
                infoObj.currentBias := -1
                
            else if bType == "COIN"
                infoObj.currentBias := (math.round(pClose * 100) + time) % 2 == 0 ? 1 : -1
                
            else if bType == "DTD"
                int barParity = math.floor(time / (tfSeconds * 1000))
                infoObj.currentBias := barParity % 2 == 0 ? 1 : -1

            // Bias Count Accumulation
            if infoObj.currentBias == 1
                infoObj.bullishCount += 1
            else if infoObj.currentBias == -1
                infoObj.bearishCount += 1

            // State Cache
            infoObj.pushedUp    := pClose >= infoObj.currentOpen
            infoObj.prevHigh    := infoObj.currentHigh
            infoObj.prevLow     := infoObj.currentLow
            infoObj.currentHigh := cHigh
            infoObj.currentLow  := cLow
            infoObj.currentOpen := cOpen
            
    if na(infoObj.currentHigh)
        infoObj.currentHigh := cHigh
        infoObj.currentLow  := cLow
    else
        infoObj.currentHigh := math.max(cHigh, infoObj.currentHigh)
        infoObj.currentLow  := math.min(cLow,  infoObj.currentLow)

// ========================================================================== //
// 4. UNIFIED LINE PROCESSING
// ========================================================================== //

// @function Draws structural lines and evaluates active price touches against them.
// @param linesObj (SessionLines) The line tracking object.
// @param infoObj (SessionInfo) The data tracking object.
// @param isNew (bool) True if a new session has started.
// @param tRight (int) Unix time for the right x-coordinate of the line.
// @param lStyle (string) Line style to be used.
// @param currHigh (float) Current bar's high.
// @param currLow (float) Current bar's low.
// @returns A tuple [bool, bool] indicating if the high line and/or low line were hit.
export method processLines(SessionLines linesObj, SessionInfo infoObj, bool isNew, int tRight, string lStyle, float currHigh, float currLow) =>
    hitH = false
    hitL = false
    
    if isNew
        linesObj.highLine    := line.new(time, infoObj.prevHigh, tRight, infoObj.prevHigh, xloc = xloc.bar_time, color = na, style = lStyle)
        linesObj.lowLine     := line.new(time, infoObj.prevLow,  tRight, infoObj.prevLow,  xloc = xloc.bar_time, color = na, style = lStyle)
        linesObj.hitHighLine := false
        linesObj.hitLowLine  := false
        
    if not na(linesObj.highLine)
        if currHigh >= infoObj.prevHigh and not linesObj.hitHighLine
            if infoObj.currentBias == 1
                infoObj.hitHighCount += 1
            linesObj.hitHighLine := true
            hitH := true
            
        if currLow <= infoObj.prevLow and not linesObj.hitLowLine
            if infoObj.currentBias == -1
                infoObj.hitLowCount += 1
            linesObj.hitLowLine := true
            hitL := true
            
    [hitH, hitL]

// ========================================================================== //
// 5. MATH & AGGREGATION UTILITIES
// ========================================================================== //

// @function Calculates the True Close-Through Rate securely, preventing division by zero.
// @param biasCount (int) Total number of directional biases.
// @param hitCount (int) Total number of line touches.
// @param closeCount (int) Total number of successful close-throughs.
// @returns (float) The calculated true rate coefficient.
export calcTrueRate(int biasCount, int hitCount, int closeCount) =>
    float successRate   = biasCount > 0 and hitCount > 0 ? hitCount / biasCount : 0.0
    float closeThruRate = hitCount > 0 ? closeCount / hitCount : 0.0
    successRate * closeThruRate

// @function Extracts and aggregates total metric values for condensed views.
// @param infoObj (SessionInfo) The data tracking object.
// @returns A tuple [int, int, int] containing [Total Bias, Total Hits, Total Closes].
export method getTotals(SessionInfo infoObj) =>
    int tBias  = infoObj.bullishCount   + infoObj.bearishCount
    int tHit   = infoObj.hitHighCount   + infoObj.hitLowCount
    int tClose = infoObj.closeHighCount + infoObj.closeLowCount
    [tBias, tHit, tClose]

// ========================================================================== //
// 6. UI FORMATTING UTILITIES
// ========================================================================== //

// @function Converts string position input into Pine's position type.
// @param pos (string) The string input from the user options.
// @returns (string) A valid Pine position variable.
export getTablePos(string pos) =>
    switch pos
        "Bottom Center" => position.bottom_center
        "Bottom Left"   => position.bottom_left
        "Bottom Right"  => position.bottom_right
        "Middle Center" => position.middle_center
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Top Center"    => position.top_center
        "Top Left"      => position.top_left
        "Top Right"     => position.top_right
        => position.top_right

// @function Converts string size input into Pine's size type.
// @param size (string) The string input from the user options.
// @returns (string) A valid Pine size variable.
export getTableSize(string size) =>
    switch size
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
        => size.normal

// @function Formats successful hit metrics into a readable percentage string.
// @param hit (int) The numerator.
// @param biasCount (int) The denominator.
// @returns (string) A percentage string (e.g., "55.5%").
export formatResult(int hit, int biasCount) =>
    biasCount > 0 ? str.tostring(math.floor(hit / biasCount * 1000) / 10) + "%" : "0%"

// @function Formats a raw floating-point rate into a readable percentage string.
// @param value (float) The raw float multiplier (e.g., 0.55).
// @returns (string) A percentage string (e.g., "55.0%").
export formatPercent(float value) =>
    str.tostring(math.floor(value * 1000) / 10) + "%"
    