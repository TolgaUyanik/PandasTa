//@version=6

// @description some enum wrappers for style identifiers, can be used in input.enum calls to have nicer dropdown names
library("lib_input_enum", overlay = true)

/////////////////////////////////////////////////////////////////
//							  SIZE							   //
/////////////////////////////////////////////////////////////////

//@function enum representation for size identifier
export enum Size 
	TINY   = 'tiny'
	SMALL  = 'small'
    NORMAL = 'normal'
    LARGE  = 'large'
    HUGE   = 'huge'
	AUTO   = 'auto'

//@function converts Size enum to builtin size.tiny / size.small / etc., ideally used around input: to_size(input.enum(Size.SMALL, ....))
export method to_size(Size select) =>
	switch select
        Size.TINY	=> size.tiny
        Size.SMALL	=> size.small
        Size.NORMAL	=> size.normal
        Size.LARGE	=> size.large
        Size.HUGE	=> size.huge
        Size.AUTO	=> size.auto

//@function converts a string key to builtin size.tiny / size.small / etc., ideally used around input: to_size(input.string('small', ...., ['tiny', 'small', 'normal', 'large', 'huge', 'auto']))
export method to_size(string select) =>
    switch select
        'tiny' 	 => size.tiny
        'small'  => size.small
        'normal' => size.normal
        'large'  => size.large
        'huge' 	 => size.huge
        => size.auto

//@function converting a builtin size identifier to one instance smaller (except tiny and auto)
export method reduce_size(string select) =>
    switch select
        size.tiny   => size.tiny
        size.small  => size.tiny
        size.normal => size.small
        size.large  => size.normal
        size.huge   => size.large
        size.auto   => size.auto

/////////////////////////////////////////////////////////////////
//						   LINE STYLE						   //
/////////////////////////////////////////////////////////////////

//@function enum representation for line style identifier
export enum LineStyle
	SOLID  = 'solid'
	DASHED = 'dashed'
	DOTTED = 'dotted'

//@function converts LineStyle enum to builtin line.style_solid / line.style_dashed / line.style_dotted, ideally used around input: to_linestyle(input.enum(LineStyle.SOLID, ....))
export method to_linestyle(LineStyle select) =>
    switch select
        LineStyle.SOLID  => line.style_solid
        LineStyle.DASHED => line.style_dashed
        => line.style_dotted

//@function converts a string key to builtin line.style_solid / line.style_dashed / line.style_dotted, ideally used around input: to_linestyle(input.string('solid', ...., ['solid', 'dashed', 'dotted']))
export method to_linestyle(string select) =>
    switch select
        'dotted' => line.style_dotted
        'dashed' => line.style_dashed
        => line.style_solid
        

/////////////////////////////////////////////////////////////////
//						   LABEL STYLE						   //
/////////////////////////////////////////////////////////////////

//@function enum representation for line style identifier
export enum LabelStyle
	CENTER		= 'center'
	LEFT		= 'left'
	UP			= 'up'
	RIGHT		= 'right'
	DOWN		= 'down'
	LOWER_LEFT	= 'lower left'
	LOWER_RIGHT	= 'lower right'
	UPPER_LEFT	= 'upper left'
	UPPER_RIGHT	= 'upper right'

//@function converts LineStyle enum to builtin line.style_solid / line.style_dashed / line.style_dotted, ideally used around input: to_linestyle(input.enum(LineStyle.SOLID, ....))
export method to_labelstyle(LabelStyle select) =>
    switch select
		LabelStyle.CENTER		=> label.style_label_center
		LabelStyle.LEFT			=> label.style_label_left
		LabelStyle.UP			=> label.style_label_up
		LabelStyle.RIGHT		=> label.style_label_right
		LabelStyle.DOWN			=> label.style_label_down
		LabelStyle.LOWER_LEFT	=> label.style_label_lower_left
		LabelStyle.LOWER_RIGHT	=> label.style_label_lower_right
		LabelStyle.UPPER_LEFT	=> label.style_label_upper_left
		LabelStyle.UPPER_RIGHT	=> label.style_label_upper_right


//@function converts a string key to builtin line.style_solid / line.style_dashed / line.style_dotted, ideally used around input: to_linestyle(input.string('solid', ...., ['solid', 'dashed', 'dotted']))
export method to_labelstyle(string select) =>
    switch select
		'center'		=> label.style_label_center
		'left'			=> label.style_label_left
		'up'			=> label.style_label_up
		'right'			=> label.style_label_right
		'down'			=> label.style_label_down
		'lower left'	=> label.style_label_lower_left
		'lower right'	=> label.style_label_lower_right
		'upper left'	=> label.style_label_upper_left
		'upper right'	=> label.style_label_upper_right
        
        
var linestyle = input.enum(LineStyle.SOLID, 'line style').to_linestyle()
var labelstyle = input.enum(LabelStyle.LOWER_LEFT, 'label style').to_labelstyle()
var labelsize = input.enum(Size.SMALL, 'size').to_size()

int start = bar_index
int end   = bar_index + 5
var line  li = line.new(start, low, end, low, style = linestyle)
var label la = label.new(end, low, labelsize, size = labelsize, style = labelstyle)

if barstate.islast
	li.set_xy1(start, low)
	li.set_xy2(end, low)
	la.set_xy(end, low)

