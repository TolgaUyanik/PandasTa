//@version=5
library("BBWidthLib")

// ===== MA FUNCTION ===== //
ma(float source, int length, string _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)


export bbWidthState(float src, int length, float mult, string maType) =>
    basis = ma(src, length, maType)
    dev = mult * ta.stdev(src, length)
    upper = basis + dev

    width = ((upper - basis) / basis) * 100

    // ===== STATE ===== //
    string state =
         width < 0.5 ? "Slow" :
         width < 1   ? "Medium" :
         width < 2   ? "High" :
         width < 3   ? "Super High" :
         width < 4   ? "Double Super High" :
         width < 5   ? "Triple Super High" :
                       "Extreme"

    stateCode =
     state == "Slow"              ? 1 :
     state == "Medium"            ? 2 :
     state == "High"              ? 3 :
     state == "Super High"        ? 4 :
     state == "Double Super High" ? 5 :
     state == "Triple Super High" ? 6 : 7

    // ===== COLOR ===== //
    color col =
         width < 0.5 ? color.gray :
         width < 1   ? color.yellow :
         width < 2   ? color.rgb(144, 238, 144) :
         width < 3   ? color.green :
         width < 4   ? color.aqua :
         width < 5   ? color.blue :
                       color.navy

    [width, state, col]