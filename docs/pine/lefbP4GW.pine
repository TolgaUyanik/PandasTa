//@version=5
indicator("焱鑫趋势v3", overlay=true)

// === 均线 ===
ema5 = ta.ema(close, 5)
ema21 = ta.ema(close, 21)
ema55 = ta.ema(close, 55)
ema144 = ta.ema(close, 144)

// === 均线绘图 ===
plot(ema144, title="EMA 144", color=color.fuchsia)
plot(ema5,   title="EMA 5",   color=color.blue, display=display.none)
plot(ema21,  title="EMA 21",  color=color.orange, display=display.none)
plot(ema55,  title="EMA 55",  color=color.teal, display=display.none)

// === 多头 / 空头排列判断 ===
isBull = ema5 > ema21 and ema21 > ema55
isBear = ema5 < ema21 and ema21 < ema55

// === 趋势状态变量 ===
var string trend = "none"   // 可取值 "none", "bull", "bear"
var bool signalFired = false

// === 检测趋势变化，重置状态 ===
if isBull and trend != "bull"
    trend := "bull"
    signalFired := false
else if isBear and trend != "bear"
    trend := "bear"
    signalFired := false
else if not isBull and not isBear
    trend := "none"
    signalFired := false

// === 最近高低点 ===
lookback = input.int(20, "高低点回看周期")
recentHigh = ta.highest(high, lookback)
recentLow = ta.lowest(low, lookback)

// === 做多/做空首次触发条件 ===
longEntry  = trend == "bull" and close > recentHigh[1] and not signalFired and barstate.isconfirmed
shortEntry = trend == "bear" and close < recentLow[1] and not signalFired and barstate.isconfirmed

// === 一次性信号触发状态记录 ===
if longEntry or shortEntry
    signalFired := true

// === 价格触及 EMA144 警告 ===
touchRange = input.float(0.003, "触及EMA144范围（百分比）")
touch144 = math.abs(close - ema144) / ema144 < touchRange and barstate.isconfirmed

// === 图形提示 ===
plotshape(longEntry,  location=location.belowbar, style=shape.labelup,   color=color.green, text="多", textcolor=color.white)
plotshape(shortEntry, location=location.abovebar, style=shape.labeldown, color=color.red,   text="空", textcolor=color.white)
plotshape(touch144,   location=location.belowbar, style=shape.triangleup, color=color.purple, size=size.tiny, text="144")

// === 警报 ===
alertcondition(longEntry or shortEntry, title="焱鑫首次交易信号", message="焱鑫策略：首次趋势排列后触发做单信号！")
alertcondition(touch144, title="焱鑫触及EMA144警报", message="焱鑫提醒：当前价格触及EMA144附近！")
