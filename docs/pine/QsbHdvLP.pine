//@version=6
//@description Orderly 거래소 자동 거래를 위한 JSON Webhook 메시지 생성 라이브러리. Market/Limit 주문, TP/SL 설정, Percent/Absolute 수량 지정 등을 지원합니다.

library("OrderlyWebhookJSON")

//@function Market 주문 JSON 생성 (TP/SL 포함)
//@param symbol 거래 심볼 (예: "BTCUSDT")
//@param leverage 레버리지 배율 (예: 10)
//@param side "Long" 또는 "Short"
//@param position "Open" 또는 "Close"
//@param quantity_type "Percent" 또는 "Absolute"
//@param quantity 수량 값 (Percent인 경우 0-100, Absolute인 경우 실제 수량)
//@param tp_type "percent" 또는 "price"
//@param tp_value TP 값 (percent인 경우 퍼센트, price인 경우 절대가격)
//@param sl_type "percent" 또는 "price"
//@param sl_value SL 값 (percent인 경우 퍼센트, price인 경우 절대가격)
//@returns JSON 형식 문자열
export createMarketOrder(
    string symbol,
    float leverage,
    string side,
    string position,
    string quantity_type,
    float quantity,
    string tp_type,
    float tp_value,
    string sl_type,
    float sl_value
    ) =>

    string json = '{\n'
    json := json + '  "symbol": "' + symbol + '",\n'
    json := json + '  "leverage": ' + str.tostring(leverage) + ',\n'
    json := json + '  "side": "' + side + '",\n'
    json := json + '  "position": "' + position + '",\n'
    json := json + '  "order_type": "Market",\n'
    json := json + '  "order_quantity_type": "' + quantity_type + '",\n'
    json := json + '  "quantity": ' + str.tostring(quantity) + ',\n'
    json := json + '  "tp": {\n'
    json := json + '    "type": "' + tp_type + '",\n'
    json := json + '    "value": ' + str.tostring(tp_value) + '\n'
    json := json + '  },\n'
    json := json + '  "sl": {\n'
    json := json + '    "type": "' + sl_type + '",\n'
    json := json + '    "value": ' + str.tostring(sl_value) + '\n'
    json := json + '  }\n'
    json := json + '}'
    json

//@function Limit 주문 JSON 생성 (TP/SL 포함)
//@param symbol 거래 심볼 (예: "BTCUSDT")
//@param leverage 레버리지 배율 (예: 10)
//@param side "Long" 또는 "Short"
//@param position "Open" 또는 "Close"
//@param limit_price Limit 주문 가격
//@param quantity_type "Percent" 또는 "Absolute"
//@param quantity 수량 값 (Percent인 경우 0-100, Absolute인 경우 실제 수량)
//@param tp_type "percent" 또는 "price"
//@param tp_value TP 값 (percent인 경우 퍼센트, price인 경우 절대가격)
//@param sl_type "percent" 또는 "price"
//@param sl_value SL 값 (percent인 경우 퍼센트, price인 경우 절대가격)
//@returns JSON 형식 문자열
export createLimitOrder(
    string symbol,
    float leverage,
    string side,
    string position,
    float limit_price,
    string quantity_type,
    float quantity,
    string tp_type,
    float tp_value,
    string sl_type,
    float sl_value
    ) =>

    string json = '{\n'
    json := json + '  "symbol": "' + symbol + '",\n'
    json := json + '  "leverage": ' + str.tostring(leverage) + ',\n'
    json := json + '  "side": "' + side + '",\n'
    json := json + '  "position": "' + position + '",\n'
    json := json + '  "order_type": "Limit",\n'
    json := json + '  "price": ' + str.tostring(limit_price) + ',\n'
    json := json + '  "order_quantity_type": "' + quantity_type + '",\n'
    json := json + '  "quantity": ' + str.tostring(quantity) + ',\n'
    json := json + '  "tp": {\n'
    json := json + '    "type": "' + tp_type + '",\n'
    json := json + '    "value": ' + str.tostring(tp_value) + '\n'
    json := json + '  },\n'
    json := json + '  "sl": {\n'
    json := json + '    "type": "' + sl_type + '",\n'
    json := json + '    "value": ' + str.tostring(sl_value) + '\n'
    json := json + '  }\n'
    json := json + '}'
    json

//@function Market 주문 JSON 생성 (TP/SL 없음 - 간단 버전)
//@param symbol 거래 심볼 (예: "BTCUSDT")
//@param leverage 레버리지 배율 (예: 10)
//@param side "Long" 또는 "Short"
//@param position "Open" 또는 "Close"
//@param quantity_type "Percent" 또는 "Absolute"
//@param quantity 수량 값
//@returns JSON 형식 문자열
export createSimpleMarketOrder(
    string symbol,
    float leverage,
    string side,
    string position,
    string quantity_type,
    float quantity
    ) =>

    string json = '{\n'
    json := json + '  "symbol": "' + symbol + '",\n'
    json := json + '  "leverage": ' + str.tostring(leverage) + ',\n'
    json := json + '  "side": "' + side + '",\n'
    json := json + '  "position": "' + position + '",\n'
    json := json + '  "order_type": "Market",\n'
    json := json + '  "order_quantity_type": "' + quantity_type + '",\n'
    json := json + '  "quantity": ' + str.tostring(quantity) + '\n'
    json := json + '}'
    json

