//=================================================================================================================
//  POA Library를 활용해서 전용 TV 서버 에 웹훅 보내는 Library 입니다.
//=================================================================================================================

//@version=5

// @description TODO: add library description here
library("DBTV", overlay = true)

is_stock() =>
    var stocks = array.from("KRX", "NASDAQ", "ARCA", "AMEX", "NYSE")
    array.includes(stocks, syminfo.prefix)

is_korea_stock() =>
    syminfo.prefix == "KRX"

is_us_stock() =>
    var stocks = array.from("NASDAQ", "ARCA", "AMEX", "NYSE")
    array.includes(stocks, syminfo.prefix)

is_crypto() =>
    (syminfo.type == "crypto") 
 
is_futures() => 
    code = switch syminfo.prefix
        "BINANCE"   => ".P"
        "BYBIT"     => ".P"
        "BITGET"    => ".P"
        "UPBIT"     => "PERP"
        "OKX"       => ".P"
        =>".P"
    is_crypto() and str.endswith(syminfo.ticker, code)

is_spot() =>
    is_crypto() and (not is_futures())

get_price() =>
    orderprice = "{{strategy.order.price}}"
    pricescale = syminfo.pricescale
    ret = pricescale

get_ordertype() =>    
    var string ret = ""
    ret := "{{strategy.order.action}}"

get_exchange_and_code() =>
    is_stock = is_stock()    
    code = is_stock ? syminfo.currency : str.replace(syminfo.ticker, syminfo.basecurrency, "", 0)
    [syminfo.prefix, code]

get_ordertype_and_orderqty_and_orderprice_and_ordername() =>
    ["{{strategy.order.action}}", "{{strategy.order.contracts}}", "{{strategy.order.price}}", "{{strategy.order.comment}}"]

db_webhook(string ordername, string exchange, string code, string ordertype, string orderqty, string orderprice, string orderkind="limit", string accnt_no=na, string password=na, string action="order", string stopprice=na, string username="오토봇") =>                         
    json = '{' + str.format(' "MARKET":"{0}","ACCNT":"{1}", "CODE" :"{2}","ORDERTYPE":"{3}","ORDERKIND":"{4}","ORDERPRICE":"{5}","ORDERQTY":"{6}","PASSWD":"{7}"', exchange, accnt_no, code, ordertype, orderkind, orderprice, orderqty, password) + '}'

db_order(string ordertype = na, string accnt_no = na, string password=na, string code = na, string orderqty=na, string orderkind = "limit", string action = "order") =>
    [exchange, strcode] = get_exchange_and_code()
    [strordertype, strqty, orderprice, ordername] = get_ordertype_and_orderqty_and_orderprice_and_ordername()      
    if not na(ordertype)
		strordertype := ordertype
    if not na(code)
        strcode := code
    if not na(orderqty)
        strqty := orderqty
    ret = db_webhook(ordername, exchange, strcode, strordertype, strqty, orderprice, orderkind, accnt_no, password, action)

//=========================================================================================================================================
//  EXPORT
//=========================================================================================================================================
export db_buy(string accnt_no=na, string password=na, string code = na, string orderqty = na, string orderkind = "limit") => 
	db_order("buy", accnt_no, password, code, orderqty, orderkind)

export db_sell(string accnt_no=na, string password=na, string code = na, string orderqty = na, string orderkind = "limit") => 
	db_order("sell", accnt_no, password, code, orderqty, orderkind)

export db_entry(string accnt_no=na, string password=na, string code = na, string orderqty = na, string orderkind = "limit") => 
    is_buy = is_stock() or is_spot()
    is_buy  ? db_order("buy", accnt_no, password, code, orderqty, orderkind) : db_order(na, accnt_no, password, code, orderqty, orderkind, "entry")

export db_close(string accnt_no=na, string password=na, string code = na, string orderqty = na, string orderkind = "limit") => 
    is_sell = is_stock() or is_spot()
    is_sell ? db_order("sell", accnt_no, password, code, orderqty, orderkind) : db_order(na, accnt_no, password, code, orderqty, orderkind, "close")

export db_exit(string accnt_no=na, string password=na, string code = na, string orderqty = na, string orderkind = "limit") =>
    is_sell = is_stock() or is_spot()
    is_sell ? db_order("sell", accnt_no, password, code, orderqty, orderkind) : db_order(na, accnt_no, password, code, orderqty, orderkind, "exit")

export in_trade(int start_time, int end_time, bool hide_trade_line = false) =>
    allowedToTrade = (time>=start_time) and (time<=end_time)
    if barstate.islastconfirmedhistory and not hide_trade_line
        var myLine = line(na)
        line.delete(myLine)
        myLine := line.new(start_time, low, start_time, high, xloc=xloc.bar_time, color = color.rgb(255, 153, 0, 50), width = 3, extend = extend.both, style = line.style_dashed)
    allowedToTrade