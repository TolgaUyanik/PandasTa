//@version=6
library("demark_render")

// NOTE: This library is intentionally UI/plumbing only.
// It contains drawing helpers that do not encode DeMark edge logic.

export f_renderMaxBack(float lookbackBars) =>
    int(math.min(5000.0, math.max(50.0, lookbackBars)))

export f_renderExtendBars(int levelLineExtendBarsMax) =>
    _tfSec = timeframe.in_seconds(timeframe.period)
    _extendBarsF = not na(_tfSec) and _tfSec > 0 ? (30.0 * 86400.0) / _tfSec : 200.0
    // TradingView constraint: xloc.bar_index objects cannot be drawn >500 bars into the future.
    // Use 499 as a safe upper bound.
    // Also cap by user setting to avoid "infinite"-looking levels.
    int(math.max(20.0, math.min(499.0, math.min(levelLineExtendBarsMax, _extendBarsF))))

export f_upsertLevelLine(line lnIn, bool show, float y, color col, int width, string style, int levelLineExtendBarsMax) =>
    line lnOut = lnIn
    _extendBars = f_renderExtendBars(levelLineExtendBarsMax)
    _x2 = bar_index + _extendBars
    if show and not na(y)
        if na(lnOut)
            lnOut := line.new(bar_index - 1, y, _x2, y, extend=extend.none, color=col, width=width, style=style)
        else
            line.set_xy1(lnOut, bar_index - 1, y)
            line.set_xy2(lnOut, _x2, y)
            line.set_color(lnOut, col)
            line.set_width(lnOut, width)
            line.set_style(lnOut, style)
            line.set_extend(lnOut, extend.none)
    else
        if not na(lnOut)
            line.delete(lnOut)
            lnOut := na
    lnOut

export f_upsertZoneBox(box bxIn, bool show, int x1, float lo, float hi, color bg, color brd, int brdW, float lookbackBars, int levelLineExtendBarsMax) =>
    box bxOut = bxIn
    _maxBack = f_renderMaxBack(lookbackBars)
    _extendBars = f_renderExtendBars(levelLineExtendBarsMax)
    _x2 = bar_index + _extendBars
    _x1raw = not na(x1) ? x1 : (bar_index - 1)
    _x1 = int(math.max(_x1raw, bar_index - _maxBack))
    _top = hi
    _bot = lo
    if show and not na(_top) and not na(_bot)
        if na(bxOut)
            bxOut := box.new(left=_x1, top=_top, right=_x2, bottom=_bot, bgcolor=bg, border_color=brd, border_width=brdW)
        else
            box.set_lefttop(bxOut, _x1, _top)
            box.set_rightbottom(bxOut, _x2, _bot)
            box.set_bgcolor(bxOut, bg)
            box.set_border_color(bxOut, brd)
            box.set_border_width(bxOut, brdW)
    else
        if not na(bxOut)
            box.delete(bxOut)
            bxOut := na
    bxOut

f_lineAt(int p1i, float p1p, int p0i, float p0p, int x) =>
    float dx = float(p0i - p1i)
    dx == 0.0 ? na : (p1p + (float(x - p1i) / dx) * (p0p - p1p))

export f_upsertTdLine(line lnIn, bool show, int p1Idx, float p1Price, int p0Idx, float p0Price, color col, int width, string style, float lookbackBars, int levelLineExtendBarsMax) =>
    line lnOut = lnIn
    _maxBack = f_renderMaxBack(lookbackBars)
    _x1 = int(math.max(p1Idx, bar_index - _maxBack))
    _y1 = f_lineAt(p1Idx, p1Price, p0Idx, p0Price, _x1)
    _extendBars = f_renderExtendBars(levelLineExtendBarsMax)
    _x2 = bar_index + _extendBars
    _y2 = f_lineAt(p1Idx, p1Price, p0Idx, p0Price, _x2)
    if show and not na(p1Idx) and not na(p1Price) and not na(_y1) and not na(_y2)
        if na(lnOut)
            lnOut := line.new(_x1, _y1, _x2, _y2, extend=extend.none, color=col, width=width, style=style)
        else
            line.set_xy1(lnOut, _x1, _y1)
            line.set_xy2(lnOut, _x2, _y2)
            line.set_color(lnOut, col)
            line.set_width(lnOut, width)
            line.set_style(lnOut, style)
            line.set_extend(lnOut, extend.none)
    else
        if not na(lnOut)
            line.delete(lnOut)
            lnOut := na
    lnOut

export f_levelTagX(int levelLineExtendBarsMax) =>
    _extendBars = f_renderExtendBars(levelLineExtendBarsMax)
    // Put tags near the right edge (not too far into the future).
    bar_index + int(math.max(5.0, math.min(50.0, _extendBars / 6.0)))

export f_stackY(float baseY, float step, int idx, bool stackUp) =>
    baseY + step * idx * (stackUp ? 1.0 : -1.0)

export f_upsertLevelTag(label lbIn, bool show, float y, string txt, color bg, color tc, string sz, int levelLineExtendBarsMax) =>
    label lbOut = lbIn
    int xTag = f_levelTagX(levelLineExtendBarsMax)
    if show and not na(y) and txt != ""
        if na(lbOut)
            lbOut := label.new(xTag, y, txt, xloc=xloc.bar_index, style=label.style_label_left, color=bg, textcolor=tc, size=sz)
        else
            label.set_x(lbOut, xTag)
            label.set_y(lbOut, y)
            label.set_text(lbOut, txt)
            label.set_color(lbOut, bg)
            label.set_textcolor(lbOut, tc)
            label.set_style(lbOut, label.style_label_left)
            label.set_size(lbOut, sz)
    else
        if not na(lbOut)
            label.delete(lbOut)
            lbOut := na
    lbOut

export f_upsertPointTag(label lbIn, bool show, int x, float y, string txt, color bg, color tc, string sz, string sty) =>
    label lbOut = lbIn
    int _maxBarIndexDist = 5000
    int _xSafe = not na(x) ? x : bar_index
    int _xTime = ta.valuewhen(bar_index == _xSafe, time, 0)
    if show and not na(x) and not na(y) and txt != ""
        bool _useTime = math.abs(bar_index - x) > _maxBarIndexDist
        bool _haveX = _useTime ? not na(_xTime) : true
        if _haveX
            if na(lbOut)
                lbOut := label.new(_useTime ? _xTime : x, y, txt, xloc=_useTime ? xloc.bar_time : xloc.bar_index, style=sty, color=bg, textcolor=tc, size=sz)
            else
                int _curX = label.get_x(lbOut)
                bool _curIsTime = _curX > 1000000000
                if _useTime != _curIsTime
                    label.delete(lbOut)
                    lbOut := label.new(_useTime ? _xTime : x, y, txt, xloc=_useTime ? xloc.bar_time : xloc.bar_index, style=sty, color=bg, textcolor=tc, size=sz)
                else
                    label.set_x(lbOut, _useTime ? _xTime : x)
                    label.set_y(lbOut, y)
                    label.set_text(lbOut, txt)
                    label.set_color(lbOut, bg)
                    label.set_textcolor(lbOut, tc)
                    label.set_style(lbOut, sty)
                    label.set_size(lbOut, sz)
        else
            if not na(lbOut)
                label.delete(lbOut)
                lbOut := na
    else
        if not na(lbOut)
            label.delete(lbOut)
            lbOut := na
    lbOut

// --- Generic label helpers (plumbing only) ---

export f_upsertLabel(
    label lbIn,
    bool show,
    int x,
    float y,
    string txt,
    string sty,
    color bg,
    color tc,
    string sz
) =>
    label lbOut = lbIn
    if show and txt != "" and not na(y)
        if na(lbOut)
            lbOut := label.new(x, y, txt, style=sty, color=bg, textcolor=tc, size=sz)
        else
            label.set_x(lbOut, x)
            label.set_y(lbOut, y)
            label.set_text(lbOut, txt)
            label.set_style(lbOut, sty)
            label.set_color(lbOut, bg)
            label.set_textcolor(lbOut, tc)
            label.set_size(lbOut, sz)
    else
        if not na(lbOut)
            // Hide without delete to avoid churn.
            label.set_text(lbOut, "")
            label.set_color(lbOut, color.new(color.black, 100))
            label.set_textcolor(lbOut, color.new(color.black, 100))
    lbOut

export f_newLabel(
    int x,
    float y,
    string txt,
    string sty,
    color bg,
    color tc,
    string sz
) =>
    label.new(x, y, txt, style=sty, color=bg, textcolor=tc, size=sz)

// --- Geometry helpers (render-only, no DeMark logic) ---

export f_wickPad(float atr, float mintick, float pct, float fallbackTicks) =>
    na(atr) ? (mintick * fallbackTicks) : (atr * pct)

export f_dotPad(float atr, float mintick, float pct, float fallbackTicks) =>
    na(atr) ? (mintick * fallbackTicks) : (atr * pct)

export f_stackStep(float atr, float mintick, float pct, float fallbackTicks) =>
    na(atr) ? (mintick * fallbackTicks) : (atr * pct)
