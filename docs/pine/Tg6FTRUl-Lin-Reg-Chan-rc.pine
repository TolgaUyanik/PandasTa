//@version=6
indicator("Lin Reg Chan_rc", overlay = true, max_bars_back = 1000, max_lines_count = 300)

src = input.source(defval = close, title = "Source")
len = input.int(defval = 100, title = "Length", minval = 10)
devlen = input.float(defval = 2.0, title = "Deviation", minval = 0.1, step = 0.1)
channelwidth = input.float(defval = 100.0, title = "Channel Width %", minval = 10.0, maxval = 200.0, step = 5.0)
extendit = input.bool(defval = true, title = "Extend Lines")
showmiddle = input.bool(defval = true, title = "Show Middle LRC Line")
middlecol = input.color(defval = color.yellow, title = "Middle LRC Line Color")

// Line style selection
linestyle = input.string(defval = "Solid", title = "Line Style", options = ["Solid", "Dashed", "Dotted"])

showfibo = input.bool(defval = false, title = "Show Fibonacci Levels")
showbroken = input.bool(defval = true, title = "Show Broken Channel", inline = "brk")
brokencol = input.color(defval = color.blue, title = "", inline = "brk")
upcol = input.color(defval = color.lime, title = "Up/Down Trend Colors", inline = "trcols")
dncol = input.color(defval = color.red, title = "", inline = "trcols")
widt = input.int(defval = 2, title = "Line Width", minval = 1, maxval = 5)

var float[] fibo_ratios = array.new_float(0)
var color[] colors = array.new_color(2)
if barstate.isfirst
    array.unshift(colors, upcol)
    array.unshift(colors, dncol)
    array.push(fibo_ratios, 0.236)
    array.push(fibo_ratios, 0.382)
    array.push(fibo_ratios, 0.618)
    array.push(fibo_ratios, 0.786)


get_channel(src, len)=>
    mid = math.sum(src, len) / len
    slope = ta.linreg(src, len, 0) - ta.linreg(src, len, 1)
    intercept  = mid - slope * math.floor(len / 2) + ((1 - (len % 2)) / 2) * slope
    endy = intercept  + slope * (len - 1) 
    dev = 0.0
    for x = 0 to len - 1
        dev := dev + math.pow(src[x] - (slope * (len - x) + intercept), 2)
    dev := math.sqrt(dev/len)
    [intercept, endy, dev, slope]

[y1_, y2_, dev, slope] = get_channel(src, len)

width_multiplier = channelwidth / 100.0

outofchannel = (slope > 0 and close < y2_ - dev * devlen * width_multiplier) ? 0 : (slope < 0 and close > y2_ + dev * devlen * width_multiplier) ? 2 : -1

// Function to convert string selection to line style
getLineStyle(style_str) =>
    if style_str == "Solid"
        line.style_solid
    else
        if style_str == "Dashed"
            line.style_dashed
        else
            line.style_dotted

var line[] reglines = array.new_line(3)
var line[] fibolines = array.new_line(4)
for x = 0 to 2
    // Skip drawing middle line if showmiddle is false
    if x == 1 and not showmiddle
        line.delete(array.get(reglines, x))
        continue
        
    if not showbroken or outofchannel != x or na(outofchannel[1]) or outofchannel[1] != -1
        line.delete(array.get(reglines, x))
    else
        line.set_color(array.get(reglines, x), color = brokencol)
        line.set_width(array.get(reglines, x), width = 2)
        line.set_style(array.get(reglines, x), style = line.style_dotted)
        line.set_extend(array.get(reglines, x), extend = extend.none)
    
    // Use middlecol for middle line, otherwise use trend colors
    lineColor = (x == 1) ? middlecol : array.get(colors, int(math.round(math.max(math.sign(slope), 0))))
    
    // All lines use the selected style
    lineStyle = getLineStyle(linestyle)
    
    array.set(reglines, x, 
              line.new(x1 = bar_index - (len - 1), 
                       y1 = y1_ + dev * devlen * width_multiplier * (x - 1), 
                       x2 = bar_index, 
                       y2 = y2_ + dev * devlen * width_multiplier * (x - 1),
                       color = lineColor,
                       style = lineStyle,
                       width = widt,
                       extend = extendit ? extend.right : extend.none))
if showfibo
    for x = 0 to 3
        line.delete(array.get(fibolines, x))
        array.set(fibolines, x, 
                  line.new(x1 = bar_index - (len - 1), 
                           y1 = y1_ - dev * devlen * width_multiplier + dev * devlen * width_multiplier * 2 * array.get(fibo_ratios, x), 
                           x2 = bar_index, 
                           y2 = y2_ - dev * devlen * width_multiplier + dev * devlen * width_multiplier * 2 * array.get(fibo_ratios, x),
                           color = array.get(colors, int(math.round(math.max(math.sign(slope), 0)))),
                           style =  line.style_dotted,
                           width = widt,
                           extend = extendit ? extend.right : extend.none))
    
var label sidelab = label.new(x = bar_index - (len - 1), y = y1_, text = "S",  size = size.large)
txt = slope > 0 ? slope > slope[1] ? "⇑" : "⇗" : slope < 0 ? slope < slope[1] ? "⇓" : "⇘" : "⇒"
stl = slope > 0 ? slope > slope[1] ? label.style_label_up : label.style_label_upper_right : slope < 0 ? slope < slope[1] ? label.style_label_down :  label.style_label_lower_right : label.style_label_right
label.set_style(sidelab, stl)
label.set_text(sidelab, txt)
label.set_x(sidelab, bar_index - (len - 1))
label.set_y(sidelab, slope > 0 ? y1_ - dev * devlen * width_multiplier : slope < 0 ? y1_ + dev * devlen * width_multiplier : y1_)
label.set_color(sidelab, slope > 0 ? upcol : slope < 0 ? dncol : color.blue)

// FIXED: Convert outofchannel to boolean for alertcondition
channelBroken = outofchannel != -1
alertcondition(channelBroken, title='Channel Broken', message='Channel Broken')

// direction
trendisup = math.sign(slope) != math.sign(slope[1]) and slope > 0
trendisdown = math.sign(slope) != math.sign(slope[1]) and slope < 0
alertcondition(trendisup, title='Up trend', message='Up trend')
alertcondition(trendisdown, title='Down trend', message='Down trend')