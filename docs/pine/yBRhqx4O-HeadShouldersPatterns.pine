//@version=6

// @description Library for detecting Head & Shoulders patterns (both regular and inverse)
library("HeadShouldersPatterns", overlay=true)

// ==================== TYPES ====================

// @type HeadShouldersResult
// @field isValid (bool) Whether a valid pattern was found
// @field patternType (string) Type of pattern detected ("Head and Shoulders" or "Inverse Head and Shoulders")
// @field isBullish (bool) Whether the pattern is bullish (inverse H&S) or bearish (regular H&S)
// @field pointBase (float) Base point price
// @field pointLS (float) Left shoulder price
// @field pointNecklineLeft (float) Left neckline price
// @field pointHead (float) Head price
// @field pointNecklineRight (float) Right neckline price
// @field pointRS (float) Right shoulder price
// @field barBase (int) Base point bar index
// @field barLS (int) Left shoulder bar index
// @field barNecklineLeft (int) Left neckline bar index
// @field barHead (int) Head bar index
// @field barNecklineRight (int) Right neckline bar index
// @field barRS (int) Right shoulder bar index
// @field targetPrice (float) Projected target price
export type HeadShouldersResult
    bool isValid
    string patternType
    bool isBullish
    float pointBase
    float pointLS
    float pointNecklineLeft
    float pointHead
    float pointNecklineRight
    float pointRS
    int barBase
    int barLS
    int barNecklineLeft
    int barHead
    int barNecklineRight
    int barRS
    float targetPrice

// ==================== UTILITY FUNCTIONS ====================

// @function Check if head is extreme point within lookback period
// @param headPrice (float) Head price to validate
// @param headBar (int) Head bar index
// @param lookbackPeriod (int) Number of bars to check
// @param isRegularPattern (bool) True for regular H&S, false for inverse
// @returns bool True if head is extreme within lookback
validateHeadExtreme(float headPrice, int headBar, int lookbackPeriod, bool isRegularPattern) =>
    bool isExtreme = true
    int headOffset = bar_index - headBar
    int barsToCheck = math.min(lookbackPeriod, headOffset)
    
    if barsToCheck > 0 and barsToCheck < 5000  // Stay within TradingView limits
        for i = 1 to barsToCheck
            int checkOffset = headOffset + i
            if checkOffset >= 0 and checkOffset < 5000
                if isRegularPattern
                    // For regular H&S: head should be highest high in lookback
                    if high[checkOffset] > headPrice
                        isExtreme := false
                        break
                else
                    // For inverse H&S: head should be lowest low in lookback
                    if low[checkOffset] < headPrice
                        isExtreme := false
                        break
    
    isExtreme

// @function Detect Head & Shoulders pattern from 6 pivot points
// @param pivotValues (array<float>) Array of pivot values (must have at least 6 points)
// @param pivotBars (array<int>) Array of pivot bar indices
// @param zigzagLength (int) ZigZag length for lookback validation
// @returns HeadShouldersResult Pattern detection result
export detectPattern(array<float> pivotValues, array<int> pivotBars, int zigzagLength) =>
    HeadShouldersResult result = HeadShouldersResult.new()
    result.isValid := false
    
    if array.size(pivotValues) < 6
        result
    else
        // Extract 6 most recent pivot points
        int i = array.size(pivotValues) - 6
        float p0 = array.get(pivotValues, i)     // Base
        float p1 = array.get(pivotValues, i + 1) // Left Shoulder
        float p2 = array.get(pivotValues, i + 2) // Left Neckline
        float p3 = array.get(pivotValues, i + 3) // Head
        float p4 = array.get(pivotValues, i + 4) // Right Neckline
        float p5 = array.get(pivotValues, i + 5) // Right Shoulder
        
        int b0 = array.get(pivotBars, i)
        int b1 = array.get(pivotBars, i + 1)
        int b2 = array.get(pivotBars, i + 2)
        int b3 = array.get(pivotBars, i + 3)
        int b4 = array.get(pivotBars, i + 4)
        int b5 = array.get(pivotBars, i + 5)
        
        // Calculate lookback period for head validation
        int headLookbackPeriod = zigzagLength * 5
        
        // === REGULAR HEAD AND SHOULDERS VALIDATION ===
        bool isRegularHS = p1 > p0 and      // Left shoulder higher than base
                          p1 > p2 and       // Left shoulder higher than left neckline
                          p3 > p1 and       // Head higher than left shoulder
                          p3 > p5 and       // Head higher than right shoulder
                          p5 < p1 and       // Right shoulder lower than left shoulder
                          p4 < p1 and       // Right valley lower than left shoulder
                          p4 < p3 and       // Right valley lower than head
                          p0 < p2 and       // Base lower than left neckline
                          p0 < p4 and       // Base lower than right neckline
                          math.abs(p2 - p4) < (p1 - p2) * 0.1 and  // Neckline relatively flat
                          math.abs(math.abs(p1 - p2) - math.abs(p5 - p4)) < math.abs(p3 - p2) * 0.1 and  // Shoulders similar height
                          math.abs(p3 - p2) > math.abs(p1 - p2) * 1.2  // Head significantly higher
        
        // Validate head is extreme within lookback for regular H&S
        bool headExtremeRegular = false
        if isRegularHS
            headExtremeRegular := validateHeadExtreme(p3, b3, headLookbackPeriod, true)
        
        // === INVERSE HEAD AND SHOULDERS VALIDATION ===
        bool isInverseHS = p1 < p0 and      // Left shoulder lower than base
                          p1 < p2 and       // Left shoulder lower than left neckline
                          p3 < p1 and       // Head lower than left shoulder
                          p3 < p5 and       // Head lower than right shoulder
                          p5 > p1 and       // Right shoulder higher than left shoulder
                          p4 > p1 and       // Right valley higher than left shoulder
                          p4 > p3 and       // Right valley higher than head
                          p0 > p2 and       // Base higher than left neckline
                          p0 > p4 and       // Base higher than right neckline
                          math.abs(p2 - p4) < (p2 - p1) * 0.1 and  // Neckline relatively flat
                          math.abs(math.abs(p1 - p2) - math.abs(p5 - p4)) < math.abs(p3 - p2) * 0.1 and  // Shoulders similar depth
                          math.abs(p3 - p2) > math.abs(p1 - p2) * 1.2  // Head significantly lower
        
        // Validate head is extreme within lookback for inverse H&S
        bool headExtremeInverse = false
        if isInverseHS
            headExtremeInverse := validateHeadExtreme(p3, b3, headLookbackPeriod, false)
        
        // Set result if pattern is valid
        if (isRegularHS and headExtremeRegular) or (isInverseHS and headExtremeInverse)
            bool isBullishPattern = isInverseHS  // Inverse H&S is bullish, regular H&S is bearish
            
            // Calculate price target
            float targetMove = math.abs(p3 - p2)  // Distance from head to neckline
            float targetPrice = isBullishPattern ? p2 + targetMove : p2 - targetMove
            
            // Set result fields
            result.isValid := true
            result.patternType := isBullishPattern ? "Inverse Head and Shoulders" : "Head and Shoulders"
            result.isBullish := isBullishPattern
            result.pointBase := p0
            result.pointLS := p1
            result.pointNecklineLeft := p2
            result.pointHead := p3
            result.pointNecklineRight := p4
            result.pointRS := p5
            result.barBase := b0
            result.barLS := b1
            result.barNecklineLeft := b2
            result.barHead := b3
            result.barNecklineRight := b4
            result.barRS := b5
            result.targetPrice := targetPrice
        
        result
