//@version=6
indicator("Worthy Asset Strategy", overlay = true)

buy = (close < open) and close <= open*0.995 and  barstate.isconfirmed

if buy
    label.new(bar_index,low,text = 'Buy', style =label.style_label_up)
    alert('Buy {{ticker}}',alert.freq_once_per_bar)


plot(close)
