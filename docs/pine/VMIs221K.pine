//@version=6
library("MathUtils", overlay=false)

import TradingView/ta/12

// @function hyperbolic tangent
export tanh(series float x) =>
    float e2x = math.exp(2.0 * x)
    
    // Return the formula: (e^2x - 1) / (e^2x + 1)
    (e2x - 1.0) / (e2x + 1.0)

// @function normlized value by its stdev hyperbolic tangent
export stdev_tanh(series float x, int length) =>
    float stdev = ta.stdev(x, length)
    
    normalized = x / stdev
    tanh(normalized)
