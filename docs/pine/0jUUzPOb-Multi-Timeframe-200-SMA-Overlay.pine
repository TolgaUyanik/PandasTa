//@version=5
indicator("Multi-Timeframe 200 SMA Overlay", overlay=true)

// ========== SMA Fetching ==========
sma_2m   = request.security(syminfo.tickerid, "2",   ta.sma(close, 200), lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off)
sma_5m   = request.security(syminfo.tickerid, "5",   ta.sma(close, 200), lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off)
sma_10m  = request.security(syminfo.tickerid, "10",  ta.sma(close, 200), lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off)
sma_15m  = request.security(syminfo.tickerid, "15",  ta.sma(close, 200), lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off)
sma_1h   = request.security(syminfo.tickerid, "60",  ta.sma(close, 200), lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off)


// ========== Plot SMAs ==========
plot(sma_2m,  "2m SMA 200",  color=color.red,     linewidth=2)
plot(sma_5m,  "5m SMA 200",  color=color.orange,  linewidth=2)
plot(sma_10m, "10m SMA 200", color=color.yellow,  linewidth=2)
plot(sma_15m, "15m SMA 200", color=color.green,   linewidth=2)
plot(sma_1h,  "1h SMA 200",  color=color.blue,    linewidth=2)


// ========== Show Label Only On Last Bar ==========
isLastBar = bar_index == ta.highest(bar_index, 1)

// We only create labels once on the last bar
var label lbl_2m  = na
var label lbl_5m  = na
var label lbl_10m = na
var label lbl_15m = na
var label lbl_1h  = na


if isLastBar
    // Remove old labels
    label.delete(lbl_2m),  label.delete(lbl_5m),  label.delete(lbl_10m)
    label.delete(lbl_15m), label.delete(lbl_1h), 
    
    // Create new ones
    lbl_2m  := label.new(bar_index, sma_2m,  "2m SMA",  style=label.style_label_left, color=color.red,     textcolor=color.white, size=size.small)
    lbl_5m  := label.new(bar_index, sma_5m,  "5m SMA",  style=label.style_label_left, color=color.orange,  textcolor=color.white, size=size.small)
    lbl_10m := label.new(bar_index, sma_10m, "10m SMA", style=label.style_label_left, color=color.yellow,  textcolor=color.black, size=size.small)
    lbl_15m := label.new(bar_index, sma_15m, "15m SMA", style=label.style_label_left, color=color.green,   textcolor=color.white, size=size.small)
    lbl_1h  := label.new(bar_index, sma_1h,  "1h SMA",  style=label.style_label_left, color=color.blue,    textcolor=color.white, size=size.small)
