//@version=6
strategy("Ema Cross + imb", overlay=true, fill_orders_on_standard_ohlc = true)

//inputs
fast_len = input.int(9,"Fast EMA Length",group="EMA Settings")
slow_len = input.int(21,"Slow EMA Length",group="EMA Settings")

trail_len = input.int(3,"Points to trail",group="Trail Settings")

stop_pt = input.int(5,"Stop loss points",group="Risk Settings")
be_pt = input.int(3,"Breakeven at x points",group="Risk Settings")
trail_pt = input.int(5,"Trail by x points",group="Risk Settings")
buffer = input.int(1,"Buffer ticks on stop order",group="Risk Settings")

min_gap = input.int(2,"Min FVG tol in ticks",group="FVG settings")

avg_vol = ta.sma(volume,20)
range_candle = high[1]-low[1]
body_length = math.abs(close[1]-open[1])
ratio = body_length/range_candle
ema_fast = ta.ema(close,fast_len)
ema_slow = ta.ema(close,slow_len)
time_now = hour(time,"UTC-6") * 100 + minute(time, "UTC-6")
trad_time = time_now >= 730 and time_now <= 1000

//signal processing
trend_up = ema_fast[1] > ema_slow[1] and close[1] > ema_fast[1]
trend_down = ema_fast[1] < ema_slow[1] and close[1] < ema_fast[1]

bull_fvg = low[1] > high[3]
bear_fvg = high[1] < low[3]

bull_gap = low[1] - high[3]
if bull_gap < 0
    bull_gap := 0
bear_gap = low[3] - high[1]
if bear_gap < 0
    bear_gap := 0

//imbalances
bullish_imb = close[1] > open[1] and ratio > 0.65 and volume[1] > avg_vol[1]
bearish_imb = close[1] < open[1] and ratio > 0.65 and volume[1] > avg_vol[1]

//broke high/low
broke_high = high[1] > high[2]
broke_low = low[1] < low[2]

//long short signal
order_long = (
    trend_up 
    and bull_fvg 
    and bull_gap/syminfo.mintick >= min_gap
    and bullish_imb
    and broke_high
)

order_short = (
    trend_down 
    and bear_fvg 
    and bear_gap/syminfo.mintick >= min_gap
    and bearish_imb
    and broke_low
)

//place orders
if order_long and strategy.position_size == 0 and trad_time
    strategy.entry("Long Entry",strategy.long,stop=close+buffer*syminfo.mintick,comment = "Bullish order")
    strategy.exit("Long Exit","Long Entry",stop=close+buffer*syminfo.mintick-stop_pt,comment_loss="Stop Loss",trail_points = be_pt/syminfo.mintick,trail_offset=trail_pt/syminfo.mintick)

if order_short and strategy.position_size == 0 and trad_time
    strategy.entry("Short Entry",strategy.short,stop=close-buffer*syminfo.mintick,comment = "Bearish order")
    strategy.exit("Short Exit","Short Entry",stop=close+buffer*syminfo.mintick+stop_pt,comment_loss="Stop Loss",trail_points = be_pt/syminfo.mintick,trail_offset=trail_pt/syminfo.mintick)

