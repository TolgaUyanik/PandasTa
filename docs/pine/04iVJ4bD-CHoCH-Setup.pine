//@version=6
indicator("CHoCH Setup", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_polylines_count = 100)

// --- Inputs ---
string htfInput = input.timeframe("240", "Higher Timeframe (HTF)")
int binsCount = input.int(50, "Volume Profile Bins", minval = 10, maxval = 200)
int offsetInput = input.int(10, "Candle Projection Offset", minval = 1)
int diLen = input.int(14, "DI Length")
int pocCount = input.int(1, "Show Last N POC Levels", minval = 1, maxval = 50)
bool showPocBox = input.bool(true, "Show POC Box")
int rsiLength = input.int(14, "RSI Length Inside Box")

// Colors & Styles
color bullColor = input.color(#089981, "Bull Candle Color")
color bearColor = input.color(#f23645, "Bear Candle Color")

// EQ Line Options
color eqColor = input.color(color.gray, "EQ Line Color")
string eqStyleStr = input.string("Solid", "EQ Line Style", tooltip = "Options: Solid, Dashed, Dotted")
string eqStyle = eqStyleStr == "Dashed" ? line.style_dashed : eqStyleStr == "Dotted" ? line.style_dotted : line.style_solid

// CRT / Open Line Options
bool showPrevOpen = input.bool(false, "Show Previous HTF Open Line")

// Fibo Options
bool showFibo = input.bool(false, "Show Previous HTF Fibo")
color fiboColor = input.color(color.blue, "Fibo Line Color")
string fiboStyleStr = input.string("Dotted", "Fibo Line Style", options=["Solid", "Dashed", "Dotted"])
string fiboStyle = fiboStyleStr == "Dashed" ? line.style_dashed : fiboStyleStr == "Dotted" ? line.style_dotted : line.style_solid
int fiboExt = input.int(6, "Fibo Lines Extend Right")

// VWAP Option
bool showVwap = input.bool(false, "Show VWAP")
color vwapColor = input.color(color.purple, "VWAP Color")
string vwapStyleStr = input.string("Solid", "VWAP Style", options=["Solid", "Dotted", "Dashed"])
int vwapWidth = input.int(2, "VWAP Width")

// --- BLVL (Current TF CHoCH/BOS) Inputs ---
grpCore = "BLVL Core"
int len = input.int(12, "Fractal Length (odd)", minval=3, maxval=51, group=grpCore)
int barsToRight = input.int(10, "Bars to Right", minval=1, maxval=300, group=grpCore)
bool requireBody = input.bool(true, "Break = Close Beyond Level", group=grpCore)

grpBrk = "BLVL Broken Style"
color brkUpCol = input.color(color.rgb(8,153,129), "Broken UP Color", group=grpBrk)
color brkDnCol = input.color(color.new(color.red, 0), "Broken DN Color", group=grpBrk)
int brkW = input.int(1, "Broken Width", minval=1, maxval=5, group=grpBrk)
bool showChochBox = input.bool(true, "Show CHoCH EQ Box", group=grpBrk)
bool showChochVol = input.bool(true, "Show CHoCH Volume Columns", group=grpBrk)
float volMultiplierInput = input.float(0.5, "Volume Bar Height Multiplier", minval=0.1, step=0.1, group=grpBrk)
color volColUpHighInput = input.color(color.new(#089981, 0), "Volume Bullish High", group=grpBrk)
color volColUpLowInput = input.color(color.new(#089981, 60), "Volume Bullish Low", group=grpBrk)
color volColUpOppInput = input.color(color.new(#f23645, 85), "Volume Bullish Opposite", group=grpBrk)
color volColDnHighInput = input.color(color.new(#f23645, 0), "Volume Bearish High", group=grpBrk)
color volColDnLowInput = input.color(color.new(#f23645, 60), "Volume Bearish Low", group=grpBrk)
color volColDnOppInput = input.color(color.new(#089981, 85), "Volume Bearish Opposite", group=grpBrk)
int chochExt = input.int(5, "CHoCH Box Bars to Right", group=grpBrk)
int chochBoxCount = input.int(1, "Show Last N CHoCH Boxes", minval=1, maxval=50, group=grpBrk)

// --- CHoCH Fibo Zone Settings ---
grpChochFibo = "CHoCH Fibo Zone (0.382 - 0.618)"
bool showChochFibo = input.bool(true, "Show CHoCH Buy/Sell Zone", group=grpChochFibo)
color buyZoneColor = input.color(color.new(#089981, 70), "Buy Zone Color", group=grpChochFibo)
color sellZoneColor = input.color(color.new(#f23645, 70), "Sell Zone Color", group=grpChochFibo)

// --- CHoCH Box Target Levels ---
grpChochTargets = "CHoCH Target Levels"
bool showChochTargets = input.bool(true, "Show CHoCH Box Target Levels", group=grpChochTargets)
color targetBullColor = input.color(color.new(#089981, 0), "Bullish Target Color", group=grpChochTargets)
color targetBearColor = input.color(color.new(#f23645, 0), "Bearish Target Color", group=grpChochTargets)

// --- FVG Engine Settings ---
grpFvg = "FAIR VALUE GAP"
fvg_enable   = input.bool(true, "Enable FVG Engine", inline="1", group=grpFvg)
what_fvg     = input.string("FVG", "Type", inline="1", group=grpFvg, options=["FVG", "Breakers"])
fvg_num      = input.int(2, "Show Last", inline="1a", group=grpFvg, minval=0)
fvg_upcss    = input.color(color.new(#00bcd4, 80), "Bull FVG Color", inline="1", group=grpFvg)
fvg_dncss    = input.color(color.new(#ff3030, 80), "Bear FVG Color", inline="1", group=grpFvg)
fvg_src      = input.string("Close", "Mitigation", inline="3", group=grpFvg, options=["Close", "Wick", "Avg"])
fvgthresh    = input.float(0, "Threshold", group=grpFvg, inline="asd", minval=0, maxval=2, step=0.1)
fvgoverlap   = input.bool(true, "Hide Overlap", group=grpFvg)
fvgline      = input.bool(true, "Show Mid-Line", group=grpFvg)
fvgextend    = input.bool(false, "Extend FVG", group=grpFvg)
dispraid     = input.bool(true, "Display Raids", inline="raid", group=grpFvg)
showFvgSignals = input.bool(true, "Show FVG Bounce Signals", group=grpFvg)

// --- TYPES for FVG ---
type FVG
    float top     = na
    float btm     = na
    int   loc     = bar_index
    bool  isbb    = false
    int   bbloc   = na
    bool  israid  = false
    float raidy   = na
    int   raidloc = na
    int   raidx2  = na
    bool  active  = false
    color raidcs  = na

type store
    line    [] ln
    label   [] lb
    box     [] bx
    linefill[] lf

// --- HTF Bias Logic (Security Function) ---
f_get_bias() =>
    int L_htf = (len % 2 == 0) ? (len + 1) : len
    int p_htf = int(L_htf / 2)
    float phVal = ta.pivothigh(high, p_htf, p_htf)
    float plVal = ta.pivotlow(low,  p_htf, p_htf)
    
    var float upLvl = na
    var float dnLvl = na
    var int bias = 1
    
    if not na(phVal)
        upLvl := phVal
    if not na(plVal)
        dnLvl := plVal
        
    if not na(upLvl)
        if close > upLvl
            bias := 1
            upLvl := na
    if not na(dnLvl)
        if close < dnLvl
            bias := -1
            dnLvl := na
            
    bias

// --- BLVL Current TF Logic ---
int L = (len % 2 == 0) ? (len + 1) : len
int p = int(L / 2)
float phVal = ta.pivothigh(high, p, p)
float plVal = ta.pivotlow(low,  p, p)
bool phHit = not na(phVal)
bool plHit = not na(plVal)

int tfSec = timeframe.in_seconds(timeframe.period)
int extMs = tfSec * 1000 * barsToRight

var float c_upLvl = na
var int   c_upT   = na
var bool  c_upBroken = false
var line  c_upLine = na

var float c_dnLvl = na
var int   c_dnT   = na
var bool  c_dnBroken = false
var line  c_dnLine = na

var int os = 0 // +1 up, -1 down

var line[] brkLines = array.new_line()
var label[] brkLabs = array.new_label()
var box[] chochBoxes = array.new_box()
var line[] chochEqLines = array.new_line()
var box[] chochFiboZones = array.new_box()
var label[] chochFiboLabels = array.new_label()
var line[] chochExtFiboLines = array.new_line()
var label[] chochExtFiboLabels = array.new_label()

var box activeChochBox = na
var line activeChochEq = na
var box activeFiboZone = na
var label activeFiboZoneLbl = na
var line[] activeExtFiboLines = array.new_line()
var label[] activeExtFiboLabels = array.new_label()

var float globalChochEq = na
var int globalChochDir = 0
var bool starPrinted = false

var box[] activeChochVols = array.new_box()
var float maxVolInChoch = 0.0

// Zone Exit Tracking
var float activeZoneTop = na
var float activeZoneBot = na
var int activeZoneDir = 0
var float extremeExitClose = na

var float[] extFiboLevels = array.from(1.47, 1.55, 2.56, 2.6, 2.68)

if phHit
    if not na(c_upLine) and not c_upBroken
        line.delete(c_upLine)
    c_upLvl := phVal
    c_upT := time[p]
    c_upBroken := false
    c_upLine := line.new(c_upT, c_upLvl, time + extMs, c_upLvl, xloc=xloc.bar_time, color=color.new(color.gray, 50), style=line.style_dotted, width=1)

if plHit
    if not na(c_dnLine) and not c_dnBroken
        line.delete(c_dnLine)
    c_dnLvl := plVal
    c_dnT := time[p]
    c_dnBroken := false
    c_dnLine := line.new(c_dnT, c_dnLvl, time + extMs, c_dnLvl, xloc=xloc.bar_time, color=color.new(color.gray, 50), style=line.style_dotted, width=1)

if not na(c_upLine) and not c_upBroken
    line.set_x2(c_upLine, time + extMs)
if not na(c_dnLine) and not c_dnBroken
    line.set_x2(c_dnLine, time + extMs)

bool brkUp = false
bool brkDn = false
if not na(c_upLvl) and not c_upBroken
    brkUp := requireBody ? close > c_upLvl : high > c_upLvl
if not na(c_dnLvl) and not c_dnBroken
    brkDn := requireBody ? close < c_dnLvl : low < c_dnLvl

if brkUp
    c_upBroken := true
    if not na(c_upLine)
        if os == -1 // is CHoCH
            line.set_color(c_upLine, brkUpCol)
            line.set_style(c_upLine, line.style_solid)
            line.set_width(c_upLine, brkW)
            line.set_x2(c_upLine, time)
            
            starPrinted := false
            
            label lb = label.new(int(math.avg(time, c_upT)), c_upLvl, "CHoCH", xloc=xloc.bar_time, style=label.style_label_down, textcolor=brkUpCol, color=color.new(color.white, 100), size=size.small)
            array.push(brkLabs, lb)
            array.push(brkLines, c_upLine)
            
            if showChochBox
                float topVal = high
                float botVal = c_dnLvl
                float eqVal = math.avg(topVal, botVal)
                float rangeV = topVal - botVal
                
                globalChochEq := eqVal
                globalChochDir := 1
                
                if not na(activeChochBox)
                    box.set_right(activeChochBox, bar_index)
                    line.set_x2(activeChochEq, bar_index)
                    if not na(activeFiboZone)
                        box.set_right(activeFiboZone, bar_index)
                    for l in activeExtFiboLines
                        line.set_x2(l, bar_index)
                    for vl in activeChochVols
                        box.delete(vl)
                    array.clear(activeChochVols)
                    array.clear(activeExtFiboLines)
                    array.clear(activeExtFiboLabels)
                
                activeChochBox := box.new(bar_index, topVal, bar_index + chochExt, botVal, border_color=na, bgcolor=color.new(brkUpCol, 85))
                activeChochEq := line.new(bar_index, eqVal, bar_index + chochExt, eqVal, color=color.new(brkUpCol, 50), style=line.style_dashed)
                array.push(chochBoxes, activeChochBox)
                array.push(chochEqLines, activeChochEq)
                
                if showChochFibo
                    float zTop = botVal + (rangeV * 0.618)
                    float zBot = botVal + (rangeV * 0.382)
                    activeFiboZone := box.new(bar_index, zTop, bar_index + chochExt, zBot, border_color=buyZoneColor, bgcolor=buyZoneColor)
                    array.push(chochFiboZones, activeFiboZone)
                    activeFiboZoneLbl := label.new(bar_index + chochExt + 2, math.avg(zTop, zBot), "Buy Zone", style=label.style_label_left, color=#00000000, textcolor=color.white, size=size.normal)
                    array.push(chochFiboLabels, activeFiboZoneLbl)
                    
                    if showChochTargets
                        for lvl in extFiboLevels
                            float p = botVal + (rangeV * lvl)
                            line l = line.new(bar_index, p, bar_index + chochExt, p, color=targetBullColor, style=line.style_dashed)
                            label fbl = label.new(bar_index + chochExt + 2, p, str.tostring(lvl), style=label.style_label_left, color=#00000000, textcolor=targetBullColor, size=size.small)
                            array.push(chochExtFiboLines, l)
                            array.push(chochExtFiboLabels, fbl)
                            array.push(activeExtFiboLines, l)
                            array.push(activeExtFiboLabels, fbl)
                    
                    activeZoneTop := zTop
                    activeZoneBot := zBot
                    activeZoneDir := 1
                    extremeExitClose := na
                
                maxVolInChoch := volume
            
            if array.size(brkLines) > 500
                line.delete(array.shift(brkLines))
            if array.size(brkLabs) > 500
                label.delete(array.shift(brkLabs))
            if array.size(chochBoxes) > chochBoxCount
                box.delete(array.shift(chochBoxes))
                line.delete(array.shift(chochEqLines))
                if showChochFibo and array.size(chochFiboZones) > 0
                    box.delete(array.shift(chochFiboZones))
                    label.delete(array.shift(chochFiboLabels))
                if showChochFibo and showChochTargets
                    for i = 1 to 5
                        if array.size(chochExtFiboLines) > 0
                            line.delete(array.shift(chochExtFiboLines))
                            label.delete(array.shift(chochExtFiboLabels))
        else
            line.delete(c_upLine)
            
    c_upLine := na
    os := 1

if brkDn
    c_dnBroken := true
    if not na(c_dnLine)
        if os == 1 // is CHoCH
            line.set_color(c_dnLine, brkDnCol)
            line.set_style(c_dnLine, line.style_solid)
            line.set_width(c_dnLine, brkW)
            line.set_x2(c_dnLine, time)
            
            starPrinted := false
            
            label lb = label.new(int(math.avg(time, c_dnT)), c_dnLvl, "CHoCH", xloc=xloc.bar_time, style=label.style_label_up, textcolor=brkDnCol, color=color.new(color.white, 100), size=size.small)
            array.push(brkLabs, lb)
            array.push(brkLines, c_dnLine)
            
            if showChochBox
                float topVal = c_upLvl
                float botVal = low
                float eqVal = math.avg(topVal, botVal)
                float rangeV = topVal - botVal
                
                globalChochEq := eqVal
                globalChochDir := -1
                
                if not na(activeChochBox)
                    box.set_right(activeChochBox, bar_index)
                    line.set_x2(activeChochEq, bar_index)
                    if not na(activeFiboZone)
                        box.set_right(activeFiboZone, bar_index)
                    for l in activeExtFiboLines
                        line.set_x2(l, bar_index)
                    for vl in activeChochVols
                        box.delete(vl)
                    array.clear(activeChochVols)
                    array.clear(activeExtFiboLines)
                    array.clear(activeExtFiboLabels)
                    
                activeChochBox := box.new(bar_index, topVal, bar_index + chochExt, botVal, border_color=na, bgcolor=color.new(brkDnCol, 85))
                activeChochEq := line.new(bar_index, eqVal, bar_index + chochExt, eqVal, color=color.new(brkDnCol, 50), style=line.style_dashed)
                array.push(chochBoxes, activeChochBox)
                array.push(chochEqLines, activeChochEq)
                
                if showChochFibo
                    float zTop = topVal - (rangeV * 0.382)
                    float zBot = topVal - (rangeV * 0.618)
                    activeFiboZone := box.new(bar_index, zTop, bar_index + chochExt, zBot, border_color=sellZoneColor, bgcolor=sellZoneColor)
                    array.push(chochFiboZones, activeFiboZone)
                    activeFiboZoneLbl := label.new(bar_index + chochExt + 2, math.avg(zTop, zBot), "Sell Zone", style=label.style_label_left, color=#00000000, textcolor=color.white, size=size.normal)
                    array.push(chochFiboLabels, activeFiboZoneLbl)
                    
                    if showChochTargets
                        for lvl in extFiboLevels
                            float p = topVal - (rangeV * lvl)
                            line l = line.new(bar_index, p, bar_index + chochExt, p, color=targetBearColor, style=line.style_dashed)
                            label fbl = label.new(bar_index + chochExt + 2, p, str.tostring(lvl), style=label.style_label_left, color=#00000000, textcolor=targetBearColor, size=size.small)
                            array.push(chochExtFiboLines, l)
                            array.push(chochExtFiboLabels, fbl)
                            array.push(activeExtFiboLines, l)
                            array.push(activeExtFiboLabels, fbl)
                    
                    activeZoneTop := zTop
                    activeZoneBot := zBot
                    activeZoneDir := -1
                    extremeExitClose := na
                    
                maxVolInChoch := volume
            
            if array.size(brkLines) > 500
                line.delete(array.shift(brkLines))
            if array.size(brkLabs) > 500
                label.delete(array.shift(brkLabs))
            if array.size(chochBoxes) > chochBoxCount
                box.delete(array.shift(chochBoxes))
                line.delete(array.shift(chochEqLines))
                if showChochFibo and array.size(chochFiboZones) > 0
                    box.delete(array.shift(chochFiboZones))
                    label.delete(array.shift(chochFiboLabels))
                if showChochFibo and showChochTargets
                    for i = 1 to 5
                        if array.size(chochExtFiboLines) > 0
                            line.delete(array.shift(chochExtFiboLines))
                            label.delete(array.shift(chochExtFiboLabels))
        else
            line.delete(c_dnLine)
            
    c_dnLine := na
    os := -1

float localMaxVol = ta.highest(volume, 300)
localMaxVol := localMaxVol == 0 ? 1 : localMaxVol 
float volSma = ta.sma(volume, 20) 
float volMultiplier = volMultiplierInput

if not na(activeChochBox)
    box.set_right(activeChochBox, bar_index + chochExt)
    line.set_x2(activeChochEq, bar_index + chochExt)
    if showChochFibo and not na(activeFiboZone)
        box.set_right(activeFiboZone, bar_index + chochExt)
        label.set_x(activeFiboZoneLbl, bar_index + chochExt + 2)
        label.set_y(activeFiboZoneLbl, math.avg(box.get_top(activeFiboZone), box.get_bottom(activeFiboZone)))
        if showChochTargets and array.size(activeExtFiboLines) > 0
            for i = 0 to array.size(activeExtFiboLines) - 1
                line l = array.get(activeExtFiboLines, i)
                label lb = array.get(activeExtFiboLabels, i)
                line.set_x2(l, bar_index + chochExt)
                label.set_x(lb, bar_index + chochExt + 2)
    
    // Draw Volume Bars inside CHoCH Box
    if showChochVol
        float tVal = box.get_top(activeChochBox)
        float bVal = box.get_bottom(activeChochBox)
        float height = tVal - bVal
        
        float vRatio = volume / localMaxVol
        float vHeight = height * vRatio * volMultiplier 
        
        float vTop = na
        float vBot = na
        
        color volColUpHigh = volColUpHighInput
        color volColUpLow = volColUpLowInput
        color volColUpOpp = volColUpOppInput
        color volColDnHigh = volColDnHighInput
        color volColDnLow = volColDnLowInput
        color volColDnOpp = volColDnOppInput
        color borderColor = color.new(color.black, 80)
        int half_dur = int((time - nz(time[1], time - 60000)) * 0.4)
        
        color lineColor = na
        
        if globalChochDir == 1
            vBot := bVal
            vTop := bVal + vHeight
            bool isGreen = close >= open
            bool isHighVol = volume > volSma
            lineColor := isGreen ? (isHighVol ? volColUpHigh : volColUpLow) : volColUpOpp
        else
            vTop := tVal
            vBot := tVal - vHeight
            bool isRed = close < open
            bool isHighVol = volume > volSma
            lineColor := isRed ? (isHighVol ? volColDnHigh : volColDnLow) : volColDnOpp
            
        box vBox = box.new(left=time - half_dur, top=vTop, right=time + half_dur, bottom=vBot, xloc=xloc.bar_time, border_color=borderColor, border_width=1, bgcolor=lineColor)
        array.push(activeChochVols, vBox)
        
        if array.size(activeChochVols) > 500
            box.delete(array.shift(activeChochVols))

int currentBias = os != 0 ? os : 1

// --- State Variables ---
var float htfHigh = na
var float htfLow = na
var float htfOpen = na

// Detect HTF change
bool isNewHtf = ta.change(time(htfInput)) != 0

// Arrays to store historical POC data
var float[] pocPrices = array.new_float(0)
var int[] pocStartBars = array.new_int(0)
var int[] pocEndBars = array.new_int(0)

// Dynamic Binning Approach
var float[] periodPrices = array.new_float(0)
var float[] periodVols = array.new_float(0)

if isNewHtf
    if array.size(periodPrices) > 0
        float maxP = array.max(periodPrices)
        float minP = array.min(periodPrices)
        float binSize = (maxP - minP) / binsCount
        
        float[] tempVolBins = array.new_float(binsCount, 0.0)
        
        for i = 0 to array.size(periodPrices) - 1
            float p_val = array.get(periodPrices, i)
            float v = array.get(periodVols, i)
            int binIdx = binSize == 0 ? 0 : math.floor((p_val - minP) / binSize)
            binIdx := math.min(binIdx, binsCount - 1)
            binIdx := math.max(binIdx, 0)
            
            float currentBinVol = array.get(tempVolBins, binIdx)
            array.set(tempVolBins, binIdx, currentBinVol + v)
            
        float maxV = 0.0
        int maxBinIdx = 0
        for i = 0 to binsCount - 1
            if array.get(tempVolBins, i) > maxV
                maxV := array.get(tempVolBins, i)
                maxBinIdx := i
                
        float foundHvn = minP + (maxBinIdx * binSize) + (binSize / 2)
        
        array.push(pocPrices, foundHvn)
        array.push(pocStartBars, bar_index)
        array.push(pocEndBars, bar_index)
        
        if array.size(pocPrices) > pocCount
            array.shift(pocPrices)
            array.shift(pocStartBars)
            array.shift(pocEndBars)
        
    array.clear(periodPrices)
    array.clear(periodVols)

if array.size(pocEndBars) > 0
    array.set(pocEndBars, array.size(pocEndBars) - 1, bar_index)

array.push(periodPrices, hl2)
array.push(periodVols, volume)

// --- Calculations (Outside Local Blocks) ---
[s_open, s_high, s_low, s_close, p_open_htf, p_high_htf, p_low_htf, p_close_htf] = request.security(syminfo.tickerid, htfInput, [open, high, low, close, open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
htfBias = request.security(syminfo.tickerid, htfInput, f_get_bias())

up_val = ta.change(high)
down_val = -ta.change(low)
plusDM = na(up_val) ? na : (up_val > down_val and up_val > 0 ? up_val : 0)
minusDM = na(down_val) ? na : (down_val > up_val and down_val > 0 ? down_val : 0)
trur = ta.rma(ta.tr, diLen)
plus = fixnan(100 * ta.rma(plusDM, diLen) / trur)
minus = fixnan(100 * ta.rma(minusDM, diLen) / trur)

float barDelta = (close >= open ? 1 : -1) * volume
float deltaChange = barDelta
float currentRsi = ta.rsi(close, rsiLength)
float atrVal = ta.atr(14)

// VWAP Plot
plot(showVwap ? ta.vwap(close) : na, color = vwapColor, title = "VWAP", linewidth = vwapWidth)

// Track RSI history for all boxes
var float[] allRsiVals = array.new_float(0)
array.push(allRsiVals, currentRsi)
if array.size(allRsiVals) > 10000
    array.shift(allRsiVals)

// Get direction of last POC break for coloring
var int pocDir = 1 // 1 for bull, -1 for bear
float lastPoc = array.size(pocPrices) > 0 ? array.last(pocPrices) : close
bool isCrossUp = ta.crossover(close, lastPoc)
bool isCrossDn = ta.crossunder(close, lastPoc)

if isCrossUp
    pocDir := 1
else if isCrossDn
    pocDir := -1

// --- Drawing ---
var box[] drawnBoxes = array.new_box(0)
var line[] drawnMidLines = array.new_line(0)
var label[] drawnLabels = array.new_label(0)
var polyline[] drawnRsiPolys = array.new<polyline>(0)

var line[] fiboLinesArr = array.new_line(0)
var label[] fiboLabelsArr = array.new_label(0)

// Modern Table for Bias Info
var table infoTable = table.new(position.top_right, 2, 5, frame_color=color.new(color.black, 100), frame_width=1, border_width=2, border_color=#1e222d)

if barstate.isfirst
    table.merge_cells(infoTable, 0, 0, 1, 0)

if barstate.islast
    for b in drawnBoxes
        box.delete(b)
    for l in drawnMidLines
        line.delete(l)
    for lb in drawnLabels
        label.delete(lb)
    for poly in drawnRsiPolys
        polyline.delete(poly)
    for fl in fiboLinesArr
        line.delete(fl)
    for fbl in fiboLabelsArr
        label.delete(fbl)
        
    array.clear(drawnBoxes)
    array.clear(drawnMidLines)
    array.clear(drawnLabels)
    array.clear(drawnRsiPolys)
    array.clear(fiboLinesArr)
    array.clear(fiboLabelsArr)
    
    int pocSize = array.size(pocPrices)
    
    // Default values if no POC exists
    bool isGreen = currentBias == 1
    float pPrice = close
    float bottom = close - atrVal
    float top = close + atrVal
    int extEBar = bar_index
    bool rsiBullish = currentRsi >= 50
    
    if pocSize > 0
        float boxHeight = atrVal * 0.4
        
        for i = 0 to pocSize - 1
            pPrice := array.get(pocPrices, i)
            int sBar = array.get(pocStartBars, i)
            int eBar = array.get(pocEndBars, i)
            
            bool isActive = (i == pocSize - 1)
            
            extEBar := isActive ? eBar + 3 : eBar
            
            int lookback = math.max(0, bar_index - eBar)
            isGreen := isActive ? (pocDir == 1) : (close[lookback] > pPrice)
            color baseColor = isGreen ? #089981 : #f23645
            color boxBgColor = color.new(baseColor, 80)
            color borderColor = color.new(baseColor, 0)
            
            top := pPrice + boxHeight
            bottom := pPrice - boxHeight
            
            if showPocBox
                box bx = box.new(sBar, top, extEBar, bottom, border_color = borderColor, bgcolor = boxBgColor)
                array.push(drawnBoxes, bx)
            
            if showPocBox
                line midLine = line.new(sBar, pPrice, extEBar, pPrice, color = eqColor, style = eqStyle, width = 1)
                array.push(drawnMidLines, midLine)
            
            int arrLen = array.size(allRsiVals)
            int bCount = eBar - sBar + 1
            if bCount > 1 and arrLen > 0
                var chart.point[] rsiPoints = array.new<chart.point>(0)
                array.clear(rsiPoints)
                
                for j = 0 to bCount - 1
                    int targetBar = eBar - j
                    int dist = bar_index - targetBar
                    int hIdx = arrLen - 1 - dist
                    
                    if hIdx >= 0 and hIdx < arrLen
                        float rVal = array.get(allRsiVals, hIdx)
                        if not na(rVal)
                            float mY = bottom + (rVal / 100) * (top - bottom)
                            array.push(rsiPoints, chart.point.from_index(targetBar, mY))
                            
                if showPocBox and array.size(rsiPoints) > 1
                    float endRsiVal = currentRsi
                    int hIdxEnd = arrLen - 1 - math.max(0, bar_index - eBar)
                    if hIdxEnd >= 0 and hIdxEnd < arrLen
                        endRsiVal := array.get(allRsiVals, hIdxEnd)
                    
                    color rsiLineCol = isActive ? (currentRsi >= 50 ? color.lime : color.red) : (endRsiVal >= 50 ? color.lime : color.red)
                    polyline rsiPoly = polyline.new(rsiPoints, closed = false, line_color = rsiLineCol, line_width = 2)
                    array.push(drawnRsiPolys, rsiPoly)

            if isActive and showPocBox
                string infoText = "Vol Delta: " + str.tostring(deltaChange, format.volume) + "\nDI+: " + str.tostring(plus, "#.##") + "\nDI-: " + str.tostring(minus, "#.##")
                float labelY = isGreen ? bottom : top
                string lblStyle = isGreen ? label.style_label_up : label.style_label_down
                
                label lbl = label.new(extEBar, labelY, text = infoText, style = lblStyle, color = color.new(color.black, 100), textcolor = chart.fg_color)
                array.push(drawnLabels, lbl)
                
    // Dashboard logic (always shown, regardless of showPocBox)
    string trapState = ""
    color trapColor = color.gray
    
    if isGreen and rsiBullish
        trapState := "Strong Bullish"
        trapColor := #089981
    else if isGreen and not rsiBullish
        trapState := "Weak Bullish / Trap"
        trapColor := color.orange
    else if not isGreen and not rsiBullish
        trapState := "Strong Bearish"
        trapColor := #f23645
    else if not isGreen and rsiBullish
        trapState := "Weak Bearish / Trap"
        trapColor := color.orange
        
    string chochStrength = "Waiting CHoCH..."
    color chochStrCol = color.gray
    
    if not na(globalChochEq)
        if globalChochDir == -1
            if close > globalChochEq
                chochStrength := "Weak Bearish CHoCH"
                chochStrCol := color.orange
            else if close < globalChochEq and not isGreen and not rsiBullish and htfBias == -1
                chochStrength := "Strong Bearish CHoCH"
                chochStrCol := #f23645
            else
                chochStrength := "Bearish CHoCH"
                chochStrCol := color.new(#f23645, 50)
        else if globalChochDir == 1
            if close < globalChochEq
                chochStrength := "Weak Bullish CHoCH"
                chochStrCol := color.orange
            else if close > globalChochEq and isGreen and rsiBullish and htfBias == 1
                chochStrength := "Strong Bullish CHoCH"
                chochStrCol := #089981
            else
                chochStrength := "Bullish CHoCH"
                chochStrCol := color.new(#089981, 50)
    
    table.cell(infoTable, 0, 0, "CHoCH SETUP DASHBOARD", text_color=color.white, bgcolor=color.rgb(20, 24, 35), text_size=size.small, text_halign=text.align_center)
    table.cell(infoTable, 0, 1, " HTF Bias", text_color=color.new(color.white, 30), bgcolor=color.rgb(30, 36, 50), text_halign=text.align_left)
    table.cell(infoTable, 1, 1, htfBias == 1 ? "BULLISH" : "BEARISH", text_color=htfBias == 1 ? #089981 : #f23645, bgcolor=color.rgb(30, 36, 50), text_halign=text.align_right)
    table.cell(infoTable, 0, 2, " Current TF Bias", text_color=color.new(color.white, 30), bgcolor=color.rgb(30, 36, 50), text_halign=text.align_left)
    table.cell(infoTable, 1, 2, currentBias == 1 ? "BULLISH" : "BEARISH", text_color=currentBias == 1 ? #089981 : #f23645, bgcolor=color.rgb(30, 36, 50), text_halign=text.align_right)
    table.cell(infoTable, 0, 3, " POC State", text_color=color.new(color.white, 30), bgcolor=color.rgb(30, 36, 50), text_halign=text.align_left)
    table.cell(infoTable, 1, 3, trapState, text_color=trapColor, bgcolor=color.rgb(30, 36, 50), text_halign=text.align_right)
    table.cell(infoTable, 0, 4, " CHoCH Strength", text_color=color.new(color.white, 30), bgcolor=color.rgb(20, 24, 35), text_halign=text.align_left)
    table.cell(infoTable, 1, 4, chochStrength, text_color=color.white, bgcolor=chochStrCol, text_halign=text.align_center)

    // --- HTF 2 Candle Projection with Sweep Bands ---
    var box prevBody = na
    var line prevWick = na
    var line prevOpenLine = na
    var box currBody = na
    var line currWick = na
    var line sweepHighLine = na
    var line sweepLowLine = na
    
    int candleWidth = math.max(2, math.floor(offsetInput / 2))
    int gap = 2
    
    int p_startIdx = bar_index + offsetInput
    int p_endIdx = p_startIdx + candleWidth
    int p_midIdx = math.floor((p_startIdx + p_endIdx) / 2)
    
    int c_startIdx = p_endIdx + gap
    int c_endIdx = c_startIdx + candleWidth
    int c_midIdx = math.floor((c_startIdx + c_endIdx) / 2)
    
    // Previous HTF Candle
    color pColor = p_close_htf >= p_open_htf ? bullColor : bearColor
    if na(prevBody)
        prevBody := box.new(p_startIdx, p_high_htf, p_endIdx, p_low_htf, border_color = na, bgcolor = na)
        prevWick := line.new(p_midIdx, p_high_htf, p_midIdx, p_low_htf, color = na)
    box.set_lefttop(prevBody, p_startIdx, math.max(p_open_htf, p_close_htf))
    box.set_rightbottom(prevBody, p_endIdx, math.min(p_open_htf, p_close_htf))
    box.set_bgcolor(prevBody, pColor)
    box.set_border_color(prevBody, pColor)
    line.set_xy1(prevWick, p_midIdx, p_high_htf)
    line.set_xy2(prevWick, p_midIdx, p_low_htf)
    line.set_color(prevWick, pColor)
    
    if showPrevOpen
        int openEndIdx = c_endIdx + 2
        if na(prevOpenLine)
            prevOpenLine := line.new(p_midIdx, p_open_htf, openEndIdx, p_open_htf, color = color.orange, style = line.style_dotted, width = 1)
        else
            line.set_xy1(prevOpenLine, p_midIdx, p_open_htf)
            line.set_xy2(prevOpenLine, openEndIdx, p_open_htf)
    else
        if not na(prevOpenLine)
            line.delete(prevOpenLine)
            prevOpenLine := na
            
    color cColor = s_close >= s_open ? bullColor : bearColor
    if na(currBody)
        currBody := box.new(c_startIdx, s_high, c_endIdx, s_low, border_color = na, bgcolor = na)
        currWick := line.new(c_midIdx, s_high, c_midIdx, s_low, color = na)
    box.set_lefttop(currBody, c_startIdx, math.max(s_open, s_close))
    box.set_rightbottom(currBody, c_endIdx, math.min(s_open, s_close))
    box.set_bgcolor(currBody, cColor)
    box.set_border_color(currBody, cColor)
    line.set_xy1(currWick, c_midIdx, s_high)
    line.set_xy2(currWick, c_midIdx, s_low)
    line.set_color(currWick, cColor)
    
    int sweepEndIdx = c_endIdx + 2 
    if not showFibo
        if na(sweepHighLine)
            sweepHighLine := line.new(p_midIdx, p_high_htf, sweepEndIdx, p_high_htf, color = #089981, style = line.style_solid, width = 2)
            sweepLowLine := line.new(p_midIdx, p_low_htf, sweepEndIdx, p_low_htf, color = #f23645, style = line.style_solid, width = 2)
        else
            line.set_xy1(sweepHighLine, p_midIdx, p_high_htf)
            line.set_xy2(sweepHighLine, sweepEndIdx, p_high_htf)
            line.set_xy1(sweepLowLine, p_midIdx, p_low_htf)
            line.set_xy2(sweepLowLine, sweepEndIdx, p_low_htf)
    else
        if not na(sweepHighLine)
            line.delete(sweepHighLine)
            line.delete(sweepLowLine)
            sweepHighLine := na
            sweepLowLine := na

    // Fibo Levels for Previous HTF Candle based on HTF Bias
    if showFibo and not na(p_high_htf) and not na(p_low_htf)
        float hlRange = p_high_htf - p_low_htf
        var float[] fLevels = array.from(-0.23, -0.31, 0.0, 0.318, 0.618, 1.0, 1.47, 1.55, 2.56, 2.68)
        
        int fEndIdx = c_endIdx + fiboExt
        for i = 0 to array.size(fLevels) - 1
            float lvl = array.get(fLevels, i)
            
            float price = htfBias == 1 ? p_low_htf + (hlRange * lvl) : p_high_htf - (hlRange * lvl)
            
            line fl = line.new(p_startIdx, price, fEndIdx, price, color = fiboColor, style = fiboStyle)
            array.push(fiboLinesArr, fl)
            
            string lblText = str.tostring(lvl) + " (" + str.tostring(price, format.mintick) + ")"
            label fbl = label.new(fEndIdx, price, text = lblText, style = label.style_label_left, color = color.new(color.black, 100), textcolor = fiboColor, size = size.normal)
            array.push(fiboLabelsArr, fbl)

// --- ADVANCED FVG ENGINE INTEGRATION ---
var store bin = store.new(array.new<line>(), array.new<label>(), array.new<box>(), array.new<linefill>())

if barstate.islast
    for obj in bin.ln
        obj.delete()
    for obj in bin.lb
        obj.delete()
    for obj in bin.bx
        obj.delete()
    
    bin.ln.clear()
    bin.lb.clear()
    bin.bx.clear()

// Global arrays for signals
var FVG[] blFVG = array.new<FVG>()
var FVG[] brFVG = array.new<FVG>()

// --- FVG UTILITY FUNCTIONS ---
ghl() => [high[2], low[2], close[1], open[1], close, open, high, low, high[1], low[1], ta.atr(200)]

overlapFVG(FVG[] b_lFVG, FVG[] b_rFVG) =>
    if b_lFVG.size() > 1
        for i = b_lFVG.size() - 1 to 1
            stuff = b_lFVG.get(i)
            current = b_lFVG.get(0)
            switch
                stuff.btm > current.btm and stuff.btm < current.top => b_lFVG.remove(i)
                stuff.top < current.top and stuff.btm > current.btm => b_lFVG.remove(i)
                stuff.top > current.top and stuff.btm < current.btm => b_lFVG.remove(i)
                stuff.top < current.top and stuff.top > current.btm => b_lFVG.remove(i)

    if b_rFVG.size() > 1
        for i = b_rFVG.size() - 1 to 1
            stuff = b_rFVG.get(i)
            current = b_rFVG.get(0)
            switch
                stuff.btm > current.btm and stuff.btm < current.top => b_rFVG.remove(i)
                stuff.top < current.top and stuff.btm > current.btm => b_rFVG.remove(i)
                stuff.top > current.top and stuff.btm < current.btm => b_rFVG.remove(i)
                stuff.top < current.top and stuff.top > current.btm => b_rFVG.remove(i)

    if b_lFVG.size() > 0 and b_rFVG.size() > 0
        for i = b_lFVG.size() - 1 to 0
            stuff = b_lFVG.get(i)
            current = b_rFVG.get(0)
            switch
                stuff.btm > current.btm and stuff.btm < current.top => b_lFVG.remove(i)
                stuff.top < current.top and stuff.btm > current.btm => b_lFVG.remove(i)
                stuff.top > current.top and stuff.btm < current.btm => b_lFVG.remove(i)
                stuff.top < current.top and stuff.top > current.btm => b_lFVG.remove(i)

    if b_lFVG.size() > 0 and b_rFVG.size() > 0
        for i = b_rFVG.size() - 1 to 0
            stuff = b_rFVG.get(i)
            current = b_lFVG.get(0)
            switch
                stuff.btm > current.btm and stuff.btm < current.top => b_rFVG.remove(i)
                stuff.top < current.top and stuff.btm > current.btm => b_rFVG.remove(i)
                stuff.top > current.top and stuff.btm < current.btm => b_rFVG.remove(i)
                stuff.top < current.top and stuff.top > current.btm => b_rFVG.remove(i)

method dispFVG(FVG fvg, int i, bool bull) =>
    ext = fvgextend ? extend.right : extend.none
    if not fvg.isbb
        bin.bx.unshift(box.new(top = fvg.top, bottom = fvg.btm, left = fvg.loc, right = time, border_color = na, bgcolor = bull ? fvg_upcss : fvg_dncss, xloc = xloc.bar_time, extend = ext))
        if fvgline
            bin.ln.unshift(line.new(x1 = fvg.loc, x2 = time, y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), xloc = xloc.bar_time, color = color.new(bull ? fvg_upcss : fvg_dncss, 0), extend = ext))
        if dispraid
            bin.ln.unshift(line.new(x1 = fvg.raidloc, x2 = fvg.raidx2, y1 = fvg.raidy, y2 = fvg.raidy, xloc = xloc.bar_time, color = fvg.raidcs))
            bin.lb.unshift(label.new(x = int(math.avg(fvg.raidloc, fvg.raidx2)), y = fvg.raidy, text = "x", xloc = xloc.bar_time, textcolor = fvg.raidcs, style = bull ? label.style_label_up : label.style_label_down, size = size.small, color = #ffffff00))

    else
        bin.bx.unshift(box.new(top = fvg.top, bottom = fvg.btm, left = fvg.loc, right = fvg.bbloc, border_color = na, bgcolor = bull ? fvg_upcss : fvg_dncss, xloc = xloc.bar_time))
        bin.bx.unshift(box.new(top = fvg.top, bottom = fvg.btm, left = fvg.bbloc, right = time, border_color = bull ? fvg_dncss : fvg_upcss, bgcolor = bull ? fvg_dncss : fvg_upcss, xloc = xloc.bar_time, extend = ext))
        if fvgline
            bin.ln.unshift(line.new(x1 = fvg.loc, x2 = fvg.bbloc, y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), color = color.new(bull ? fvg_upcss : fvg_dncss, 0), xloc = xloc.bar_time))
            bin.ln.unshift(line.new(x1 = fvg.bbloc, x2 = time, y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), color = color.new(bull ? fvg_dncss : fvg_upcss, 0), xloc = xloc.bar_time, extend = ext, style = line.style_dashed))

dFVG() =>
    [h2, l2, c1, o1, c, o, h, l, h1, l1, fvatr] = ghl()
    bool upfvg = false
    bool dnfvg = false
    float blth = l1 + (fvatr[1] * fvgthresh)
    float brth = h1 - (fvatr[1] * fvgthresh)

    cc = ta.change(time) != 0

    switch
        what_fvg == "FVG" or what_fvg == "Breakers" =>
            if l > h2 and cc and c1 > blth
                upfvg := true
                
            if l2 > h and cc and c1 < brth
                dnfvg := true

    if upfvg[1]
        if blFVG.size() > 0
            fvg = blFVG.get(0)
            if fvg.israid == true and fvg.active == false
                fvg.active  := true
                fvg.raidloc := na
                fvg.raidx2  := na
                fvg.raidy   := na
                fvg.raidcs  := #ffffff00

        blFVG.unshift(FVG.new(top = l[1], btm = h2[1], loc = time[3]))

    if dnfvg[1]
        if brFVG.size() > 0
            fvg = brFVG.get(0)
            if fvg.israid == true and fvg.active == false
                fvg.active  := true
                fvg.raidloc := na
                fvg.raidx2  := na
                fvg.raidy   := na
                fvg.raidcs  := #ffffff00

        brFVG.unshift(FVG.new(top = l2[1], btm = h[1], loc = time[3]))

    if blFVG.size() > 0
        for [i, fvg] in blFVG
            if not fvg.isbb
                if fvg_src == "Close" ? math.min(c, o) < fvg.btm : fvg_src == "Wick" ? l < fvg.btm : fvg_src == "Avg" ? l < math.avg(fvg.top, fvg.btm) : false
                    fvg.isbb := true
                    fvg.bbloc := time
                    if what_fvg == "FVG"
                        blFVG.remove(i)
            else
                if (fvg_src == "Close" ? math.max(c, o) > fvg.top : fvg_src == "Wick" ? h > fvg.top : fvg_src == "Avg" ? h > math.avg(fvg.top, fvg.btm) : false) and what_fvg == "Breakers"
                    blFVG.remove(i)
                    
    if brFVG.size() > 0
        for [i, fvg] in brFVG
            if not fvg.isbb
                if (fvg_src == "Close" ? math.max(c, o) > fvg.top : fvg_src == "Wick" ? h > fvg.top : fvg_src == "Avg" ? h > math.avg(fvg.top, fvg.btm) : false)
                    fvg.isbb := true
                    fvg.bbloc := time
                    if what_fvg == "FVG"
                        brFVG.remove(i)
            else
                if (fvg_src == "Close" ? math.min(c, o) < fvg.btm : fvg_src == "Wick" ? l < fvg.btm : fvg_src == "Avg" ? l < math.avg(fvg.top, fvg.btm) : false) and what_fvg == "Breakers"
                    brFVG.remove(i)
                    
    if fvgoverlap
        overlapFVG(blFVG, brFVG)

    if dispraid
        for [i, fvg] in blFVG
            if not fvg.israid and not fvg.isbb
                if low < fvg.top and close > fvg.top
                    fvg.israid  := true
                    fvg.raidloc := time
                    fvg.raidx2  := time
                    fvg.raidy   := low
                    fvg.raidcs  := chart.fg_color
            else
                if low <= fvg.raidy and fvg.active == false and not fvg.isbb
                    fvg.active := true
                    fvg.raidx2 := time
                else
                    if fvg.active == false and not fvg.isbb
                        fvg.raidx2 := time

        for [i, fvg] in brFVG
            if not fvg.israid and not fvg.isbb
                if high > fvg.btm and close < fvg.btm and not fvg.isbb
                    fvg.israid  := true
                    fvg.raidloc := time
                    fvg.raidy   := high
                    fvg.raidx2  := time
                    fvg.raidcs  := chart.fg_color
            else
                if high >= fvg.raidy and fvg.active == false and not fvg.isbb
                    fvg.active := true
                    fvg.raidx2 := time
                else
                    if fvg.active == false and not fvg.isbb
                        fvg.raidx2 := time

    if barstate.islast
        if blFVG.size() > 0 and fvg_num > 0
            for i = 0 to math.min(fvg_num - 1, blFVG.size() - 1)
                fvg = blFVG.get(i)
                dispFVG(fvg, i, true)

        if brFVG.size() > 0 and fvg_num > 0
            for i = 0 to math.min(fvg_num - 1, brFVG.size() - 1)
                fvg = brFVG.get(i)
                dispFVG(fvg, i, false)

    bool bullSignal = false
    bool bearSignal = false
    bool newBullFvgAlert = false
    bool newBearFvgAlert = false
    
    if upfvg[1] and globalChochDir == 1
        newBullFvgAlert := true
        
    if dnfvg[1] and globalChochDir == -1
        newBearFvgAlert := true
    
    if globalChochDir == 1
        if close > open and low < low[1]
            for fvg in blFVG
                if not fvg.isbb
                    if low <= fvg.top and high >= fvg.btm
                        bullSignal := true

    if globalChochDir == -1
        if close < open and high > high[1]
            for fvg in brFVG
                if not fvg.isbb
                    if high >= fvg.btm and low <= fvg.top
                        bearSignal := true

    [bullSignal, bearSignal, newBullFvgAlert, newBearFvgAlert]

// --- EXECUTION ---
bool bullSignal = false
bool bearSignal = false
bool newBullAlert = false
bool newBearAlert = false

if fvg_enable
    [bullSig, bearSig, bullAl, bearAl] = dFVG()
    bullSignal := bullSig
    bearSignal := bearSig
    newBullAlert := bullAl
    newBearAlert := bearAl

plotshape(showFvgSignals and bullSignal, title="Bullish FVG Setup", style=shape.triangleup, location=location.belowbar, color=color.new(#00bcd4, 0), size=size.tiny)
plotshape(showFvgSignals and bearSignal, title="Bearish FVG Setup", style=shape.triangledown, location=location.abovebar, color=color.new(#ff3030, 0), size=size.tiny)

if newBullAlert
    alert("Bullish CHoCH Direction FVG Formed!", alert.freq_once_per_bar_close)
if newBearAlert
    alert("Bearish CHoCH Direction FVG Formed!", alert.freq_once_per_bar_close)

// --- Watermark ---
var table wmTable = table.new(position.bottom_right, 1, 1)
if barstate.isfirst
    table.cell(wmTable, 0, 0, "erdensedat", text_color=color.new(color.gray, 70), text_size=size.large)
