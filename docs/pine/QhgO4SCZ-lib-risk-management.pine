//@version=5

// @description a lib to help with dynamic position sizing
library("lib_risk_management", overlay = true)

//@function calculate the position size required to meet the account size based risk given when the stop loss is triggered
//@param risk percentage of account balance to risk (1-100)
//@param account_balance account balance in instrument currency
//@param entry_price entry price
//@param sl_price stop loss price
//@returns the position size in instrument currency that will loose the given risk percentage of the account balance when a stop loss is triggered
export position_size( float risk, float account_balance, float entry_price, float sl_price ) =>
	if entry_price > 0 and sl_price > 0 and account_balance > 0 and risk > 0
		pos_size = risk/100 * account_balance / math.abs(entry_price - sl_price)
		math.round_to_mintick(pos_size)
	else
		0

//@function converts the (current(default)/initial) account balance to the given currency at the daily rate
//@param to_currency (simple string) The currency in which the account balance is to be converted. Possible values: a three-letter string with the currency code in the ISO 4217 format (e.g. "USD"), or one of the built-in variables that return currency codes, like syminfo.currency or currency.USD.
//@param live converts the current account balance (strategy.equity) (default:true) or otherwise the initial capital (strategy.initial_capital)
//@returns the (current/initial) account balance converted to the given currency with at the current daily rate
export account_balance(simple string to_currency = syminfo.currency, bool live = true) =>
	account_balance = math.max( 0, live ? strategy.equity : strategy.initial_capital )
	account_balance *= request.currency_rate(strategy.account_currency, to_currency, ignore_invalid_currency = false)
	na(to_currency) ? account_balance : account_balance // workaround, compiler seems to optimize/remove to_currency and then complain it's not used
	

////////////////////////////////////////////////////////////////////////////////
//    		DEMO		 (convert to strategy, remove export statements)
////////////////////////////////////////////////////////////////////////////////

// risk management
var risk = input.float(1, 'Risk', minval = 0, step = 0.1, tooltip = 'account exposure (%) per trade')
var reward = input.float(2, 'Reward ratio', minval = 0, step = 0.1)
var reinvest = input.bool(false, 'Reinvest Profits?')
var flip = input.bool(false, 'Flip Trades on opposing Signal?')

ema_fast = ta.ema(close, input.int(9, 'Entry EMA fast', inline = 'ema'))
ema_slow = ta.ema(close, input.int(20, 'x slow', inline = 'ema'))
SIGNAL_BUY  = ta.crossover (ema_fast, ema_slow) and barstate.isconfirmed
SIGNAL_SELL = ta.crossunder(ema_fast, ema_slow) and barstate.isconfirmed

plot(ema_fast, 'EMA fast', color.fuchsia, display = display.pane)
plot(ema_slow, 'EMA slow', color.blue, display = display.pane)

SL_dist = input.float(1.5, 'SL distance', inline = 'ATR') * ta.atr(input.int(50, 'x ATR', inline = 'ATR'))

// long entry
if SIGNAL_BUY
	if strategy.position_size < 0 and flip
        strategy.close_all('close short(s)')

	if strategy.position_size >= 0 or flip
		entry = close
		SL = math.round_to_mintick(entry - SL_dist)
		TP = math.round_to_mintick(entry + SL_dist * reward)
		pos_size = position_size(risk, account_balance(live = reinvest), entry, SL) // risk * balance / SL_dist

		strategy.entry('long', strategy.long, qty = pos_size)
		strategy.exit ('long: exit', 'long', limit = TP, comment_profit = 'long: TP', stop  = SL, comment_loss = 'long: SL')

// short entry
if SIGNAL_SELL
    if strategy.position_size > 0 and flip
        strategy.close_all('close long(s)')

	if strategy.position_size <= 0 or flip
		entry = close
		SL = math.round_to_mintick(entry + SL_dist)
		TP = math.round_to_mintick(entry - SL_dist * reward)
		pos_size = position_size(risk, account_balance(live = reinvest), entry, SL) // risk * balance / SL_dist

		strategy.entry('short', strategy.short, qty = pos_size)
		strategy.exit ('short: exit', 'short', limit = TP, comment_profit = 'short: TP', stop  = SL, comment_loss = 'short: SL')


