//@version=6

// @description Contrarian Crowd Oscillator (CCO) Library - Multi-oscillator consensus indicator for contrarian trading signals
// @author B3AR_Trades

library('CCO_Library', overlay=false)

// ===========================================================================================================
// Exported Types
// ===========================================================================================================

// @type Individual oscillator values
// @field rsi RSI value (0-100)
// @field stochastic Stochastic value (0-100)
// @field williams Williams %R value (0-100, normalized)
// @field cci CCI percentile value (0-100)
// @field roc ROC percentile value (0-100)
// @field mfi Money Flow Index value (0-100)
export type OscillatorValues
    float rsi
    float stochastic
    float williams
    float cci
    float roc
    float mfi

// @type Consensus regime classification
// @field extreme_bearish Extreme bearish consensus (<= 20)
// @field moderate_bearish Moderate bearish consensus (20-40)
// @field mixed Mixed consensus (40-60)
// @field moderate_bullish Moderate bullish consensus (60-80)
// @field extreme_bullish Extreme bullish consensus (>= 80)
// @field regime_name Text description of current regime
// @field contrarian_signal Contrarian trading signal
export type ConsensusRegime
    bool extreme_bearish
    bool moderate_bearish
    bool mixed
    bool moderate_bullish
    bool extreme_bullish
    string regime_name
    string contrarian_signal

// @type Trading signals
// @field panic_bottom_signal Extreme bearish consensus with high strength
// @field euphoric_top_signal Extreme bullish consensus with high strength
// @field consensus_reversal_bullish Bullish consensus reversal
// @field consensus_reversal_bearish Bearish consensus reversal
// @field bearish_divergence Bearish price-consensus divergence
// @field bullish_divergence Bullish price-consensus divergence
// @field strong_consensus High consensus strength signal
export type TradingSignals
    bool panic_bottom_signal
    bool euphoric_top_signal
    bool consensus_reversal_bullish
    bool consensus_reversal_bearish
    bool bearish_divergence
    bool bullish_divergence
    bool strong_consensus

// @type Complete CCO calculation results
// @field consensus_score Main consensus score (0-100)
// @field consensus_strength Consensus strength (0-100)
// @field consensus_momentum Rate of consensus change
// @field consensus_acceleration Rate of momentum change
// @field oscillators Individual oscillator values
// @field regime Regime classification
// @field signals Trading signals
// @field position_multiplier Recommended position sizing multiplier
export type CCOResult
    float consensus_score
    float consensus_strength
    float consensus_momentum
    float consensus_acceleration
    OscillatorValues oscillators
    ConsensusRegime regime
    TradingSignals signals
    float position_multiplier

// ===========================================================================================================
// Core Oscillator Calculation Functions
// ===========================================================================================================

// @function Calculate normalized oscillator values
// @param rsi_length (int) RSI calculation period
// @param stoch_length (int) Stochastic calculation period
// @param cci_length (int) CCI calculation period
// @param williams_length (int) Williams %R calculation period
// @param roc_length (int) ROC calculation period
// @param mfi_length (int) MFI calculation period
// @param percentile_lookback (int) Lookback period for CCI/ROC percentile ranking
// @param use_rsi (bool) Include RSI in calculations
// @param use_stochastic (bool) Include Stochastic in calculations
// @param use_williams (bool) Include Williams %R in calculations
// @param use_cci (bool) Include CCI in calculations
// @param use_roc (bool) Include ROC in calculations
// @param use_mfi (bool) Include MFI in calculations
// @returns (OscillatorValues) Normalized oscillator values
export calculate_oscillators(int rsi_length, int stoch_length, int cci_length, int williams_length, int roc_length, int mfi_length, int percentile_lookback, bool use_rsi, bool use_stochastic, bool use_williams, bool use_cci, bool use_roc, bool use_mfi) =>
    float rsi_value = use_rsi ? ta.rsi(close, rsi_length) : 50
    float stoch_value = use_stochastic ? ta.stoch(close, high, low, stoch_length) : 50
    float williams_value = use_williams ? ta.wpr(williams_length) + 100 : 50
    float cci_value = use_cci ? ta.percentrank(ta.cci(close, cci_length), percentile_lookback) : 50
    float roc_value = use_roc ? ta.percentrank(ta.roc(close, roc_length), percentile_lookback) : 50
    float mfi_value = use_mfi ? ta.mfi(hlc3, mfi_length) : 50
    
    OscillatorValues.new(rsi_value, stoch_value, williams_value, cci_value, roc_value, mfi_value)

// @function Calculate weighted consensus score
// @param oscillators (OscillatorValues) Individual oscillator values
// @param use_rsi (bool) Include RSI in consensus
// @param use_stochastic (bool) Include Stochastic in consensus
// @param use_williams (bool) Include Williams %R in consensus
// @param use_cci (bool) Include CCI in consensus
// @param use_roc (bool) Include ROC in consensus
// @param use_mfi (bool) Include MFI in consensus
// @param weight_by_reliability (bool) Apply reliability-based weights
// @param consensus_smoothing (int) Smoothing period for consensus
// @returns (float) Weighted consensus score (0-100)
export calculate_consensus_score(OscillatorValues oscillators, bool use_rsi, bool use_stochastic, bool use_williams, bool use_cci, bool use_roc, bool use_mfi, bool weight_by_reliability, int consensus_smoothing) =>
    // Oscillator weights based on reliability
    float rsi_weight = weight_by_reliability ? 1.0 : 1.0
    float stoch_weight = weight_by_reliability ? 0.8 : 1.0
    float williams_weight = weight_by_reliability ? 0.7 : 1.0
    float cci_weight = weight_by_reliability ? 1.2 : 1.0
    float roc_weight = weight_by_reliability ? 1.1 : 1.0
    float mfi_weight = weight_by_reliability ? 0.9 : 1.0
    
    float total_weighted_value = 0.0
    float total_weight = 0.0
    
    if use_rsi
        total_weighted_value := total_weighted_value + oscillators.rsi * rsi_weight
        total_weight := total_weight + rsi_weight
    
    if use_stochastic
        total_weighted_value := total_weighted_value + oscillators.stochastic * stoch_weight
        total_weight := total_weight + stoch_weight
    
    if use_williams
        total_weighted_value := total_weighted_value + oscillators.williams * williams_weight
        total_weight := total_weight + williams_weight
    
    if use_cci
        total_weighted_value := total_weighted_value + oscillators.cci * cci_weight
        total_weight := total_weight + cci_weight
    
    if use_roc
        total_weighted_value := total_weighted_value + oscillators.roc * roc_weight
        total_weight := total_weight + roc_weight
    
    if use_mfi
        total_weighted_value := total_weighted_value + oscillators.mfi * mfi_weight
        total_weight := total_weight + mfi_weight
    
    float raw_consensus = total_weight > 0 ? total_weighted_value / total_weight : 50
    float consensus_score = ta.sma(raw_consensus, consensus_smoothing)
    consensus_score

// @function Calculate consensus strength (agreement between oscillators)
// @param oscillators (OscillatorValues) Individual oscillator values
// @param consensus_score (float) Current consensus score
// @param use_rsi (bool) Include RSI in strength calculation
// @param use_stochastic (bool) Include Stochastic in strength calculation
// @param use_williams (bool) Include Williams %R in strength calculation
// @param use_cci (bool) Include CCI in strength calculation
// @param use_roc (bool) Include ROC in strength calculation
// @param use_mfi (bool) Include MFI in strength calculation
// @returns (float) Consensus strength (0-100)
export calculate_consensus_strength(OscillatorValues oscillators, float consensus_score, bool use_rsi, bool use_stochastic, bool use_williams, bool use_cci, bool use_roc, bool use_mfi) =>
    array<float> oscillator_values = array.new<float>()
    
    if use_rsi
        array.push(oscillator_values, oscillators.rsi)
    if use_stochastic
        array.push(oscillator_values, oscillators.stochastic)
    if use_williams
        array.push(oscillator_values, oscillators.williams)
    if use_cci
        array.push(oscillator_values, oscillators.cci)
    if use_roc
        array.push(oscillator_values, oscillators.roc)
    if use_mfi
        array.push(oscillator_values, oscillators.mfi)
    
    int array_size = array.size(oscillator_values)
    float consensus_strength = 0.0
    
    if array_size > 1
        float mean_value = consensus_score
        float variance_sum = 0.0
        
        for i = 0 to array_size - 1
            float deviation = array.get(oscillator_values, i) - mean_value
            variance_sum := variance_sum + deviation * deviation
        
        float variance = variance_sum / array_size
        float std_dev = math.sqrt(variance)
        consensus_strength := math.max(0, 100 - std_dev * 2)
    
    consensus_strength

// @function Classify consensus regime
// @param consensus_score (float) Current consensus score
// @returns (ConsensusRegime) Regime classification
export classify_regime(float consensus_score) =>
    bool extreme_bearish = consensus_score <= 20
    bool moderate_bearish = consensus_score > 20 and consensus_score <= 40
    bool mixed = consensus_score > 40 and consensus_score < 60
    bool moderate_bullish = consensus_score >= 60 and consensus_score < 80
    bool extreme_bullish = consensus_score >= 80
    
    string regime_name = extreme_bearish ? 'PANIC BOTTOM' : moderate_bearish ? 'FEAR BUILDING' : mixed ? 'MIXED CONSENSUS' : moderate_bullish ? 'CAUTION ZONE' : 'EUPHORIC TOP'
    
    string contrarian_signal = extreme_bearish ? 'STRONG BUY' : moderate_bearish ? 'WEAK BUY' : mixed ? 'NEUTRAL' : moderate_bullish ? 'WEAK SELL' : 'STRONG SELL'
    
    ConsensusRegime.new(extreme_bearish, moderate_bearish, mixed, moderate_bullish, extreme_bullish, regime_name, contrarian_signal)

// @function Detect trading signals
// @param consensus_score (float) Current consensus score
// @param consensus_strength (float) Current consensus strength
// @param consensus_momentum (float) Consensus momentum
// @param regime (ConsensusRegime) Current regime classification
// @returns (TradingSignals) Trading signal conditions
export detect_signals(float consensus_score, float consensus_strength, float consensus_momentum, ConsensusRegime regime) =>
    // Extreme signals
    bool panic_bottom_signal = regime.extreme_bearish and consensus_strength > 80
    bool euphoric_top_signal = regime.extreme_bullish and consensus_strength > 80
    
    // Consensus reversal signals
    bool consensus_reversal_bullish = ta.crossover(consensus_score, 20) and consensus_strength > 60
    bool consensus_reversal_bearish = ta.crossunder(consensus_score, 80) and consensus_strength > 60
    
    // Divergence signals
    float price_momentum = ta.change(close, 10)
    bool price_making_highs = close == ta.highest(close, 20)
    bool price_making_lows = close == ta.lowest(close, 20)
    
    bool bearish_divergence = price_making_highs and consensus_momentum < -3 and consensus_score > 60
    bool bullish_divergence = price_making_lows and consensus_momentum > 3 and consensus_score < 40
    
    // Strong consensus
    bool strong_consensus = (regime.extreme_bearish or regime.extreme_bullish) and consensus_strength > 70
    
    TradingSignals.new(panic_bottom_signal, euphoric_top_signal, consensus_reversal_bullish, consensus_reversal_bearish, bearish_divergence, bullish_divergence, strong_consensus)

// ===========================================================================================================
// Main CCO Calculation Function
// ===========================================================================================================

// @function Calculate complete CCO analysis
// @param rsi_length (int) RSI calculation period
// @param stoch_length (int) Stochastic calculation period
// @param cci_length (int) CCI calculation period
// @param williams_length (int) Williams %R calculation period
// @param roc_length (int) ROC calculation period
// @param mfi_length (int) MFI calculation period
// @param consensus_smoothing (int) Consensus smoothing period
// @param percentile_lookback (int) Percentile ranking lookback
// @param use_rsi (bool) Include RSI
// @param use_stochastic (bool) Include Stochastic
// @param use_williams (bool) Include Williams %R
// @param use_cci (bool) Include CCI
// @param use_roc (bool) Include ROC
// @param use_mfi (bool) Include MFI
// @param weight_by_reliability (bool) Apply reliability weights
// @param detect_momentum (bool) Calculate momentum and acceleration
// @returns (CCOResult) Complete CCO analysis results
export calculate_cco(int rsi_length, int stoch_length, int cci_length, int williams_length, int roc_length, int mfi_length, int consensus_smoothing, int percentile_lookback, bool use_rsi, bool use_stochastic, bool use_williams, bool use_cci, bool use_roc, bool use_mfi, bool weight_by_reliability, bool detect_momentum) =>
    // Calculate individual oscillators
    OscillatorValues oscillators = calculate_oscillators(rsi_length, stoch_length, cci_length, williams_length, roc_length, mfi_length, percentile_lookback, use_rsi, use_stochastic, use_williams, use_cci, use_roc, use_mfi)
    
    // Calculate consensus score
    float consensus_score = calculate_consensus_score(oscillators, use_rsi, use_stochastic, use_williams, use_cci, use_roc, use_mfi, weight_by_reliability, consensus_smoothing)
    
    // Calculate consensus strength
    float consensus_strength = calculate_consensus_strength(oscillators, consensus_score, use_rsi, use_stochastic, use_williams, use_cci, use_roc, use_mfi)
    
    // Calculate momentum and acceleration
    float consensus_momentum = detect_momentum ? ta.change(consensus_score, 5) : 0
    float consensus_acceleration = detect_momentum ? ta.change(consensus_momentum, 3) : 0
    
    // Classify regime
    ConsensusRegime regime = classify_regime(consensus_score)
    
    // Detect signals
    TradingSignals signals = detect_signals(consensus_score, consensus_strength, consensus_momentum, regime)
    
    // Calculate position multiplier
    float position_multiplier = regime.extreme_bearish ? 1.5 : regime.extreme_bullish ? 0.3 : signals.strong_consensus ? 0.5 : 1.0
    
    CCOResult.new(consensus_score, consensus_strength, consensus_momentum, consensus_acceleration, oscillators, regime, signals, position_multiplier)

// ===========================================================================================================
// Convenience Functions
// ===========================================================================================================

// @function Calculate CCO with default parameters
// @returns (CCOResult) CCO result with standard settings
export calculate_cco_default() =>
    calculate_cco(14, 14, 20, 14, 12, 14, 3, 100, true, true, true, true, true, true, true, true)

// @function Get just the consensus score with default parameters
// @returns (float) Consensus score (0-100)
export cco_consensus_score() =>
    CCOResult result = calculate_cco_default()
    result.consensus_score

// @function Get just the consensus strength with default parameters
// @returns (float) Consensus strength (0-100)
export cco_consensus_strength() =>
    CCOResult result = calculate_cco_default()
    result.consensus_strength

// @function Check if in panic bottom condition
// @returns (bool) True if panic bottom signal active
export is_panic_bottom() =>
    CCOResult result = calculate_cco_default()
    result.signals.panic_bottom_signal

// @function Check if in euphoric top condition
// @returns (bool) True if euphoric top signal active
export is_euphoric_top() =>
    CCOResult result = calculate_cco_default()
    result.signals.euphoric_top_signal

// @function Check for bullish consensus reversal
// @returns (bool) True if bullish reversal detected
export bullish_consensus_reversal() =>
    CCOResult result = calculate_cco_default()
    result.signals.consensus_reversal_bullish

// @function Check for bearish consensus reversal
// @returns (bool) True if bearish reversal detected
export bearish_consensus_reversal() =>
    CCOResult result = calculate_cco_default()
    result.signals.consensus_reversal_bearish

// @function Check for bearish divergence
// @returns (bool) True if bearish divergence detected
export bearish_divergence() =>
    CCOResult result = calculate_cco_default()
    result.signals.bearish_divergence

// @function Check for bullish divergence
// @returns (bool) True if bullish divergence detected
export bullish_divergence() =>
    CCOResult result = calculate_cco_default()
    result.signals.bullish_divergence

// @function Get current regime name
// @returns (string) Current consensus regime name
export get_regime_name() =>
    CCOResult result = calculate_cco_default()
    result.regime.regime_name

// @function Get contrarian signal
// @returns (string) Current contrarian trading signal
export get_contrarian_signal() =>
    CCOResult result = calculate_cco_default()
    result.regime.contrarian_signal

// @function Get position size multiplier
// @returns (float) Recommended position sizing multiplier
export get_position_multiplier() =>
    CCOResult result = calculate_cco_default()
    result.position_multiplier