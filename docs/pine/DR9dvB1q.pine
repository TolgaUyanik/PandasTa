//@version=6
strategy(
     "EMA + RSI + ATR Strategy",
     overlay = true,
     initial_capital = 100000,
     pyramiding = 0,
     process_orders_on_close = true
)

// =====================
// Inputs
// =====================
fastEMA = input.int(5, "Fast EMA", minval = 1)
slowEMA = input.int(10, "Slow EMA", minval = 1)

rsiLength = input.int(14, "RSI Length", minval = 1)
rsiLong   = input.int(15, "Long RSI", minval = 0, maxval = 100)
rsiShort  = input.int(85, "Short RSI", minval = 0, maxval = 100)

atrLength = input.int(20, "ATR Length", minval = 1)
stopATR   = input.float(30.5, "Stop ATR", minval = 0.1)
rr        = input.float(30.5, "Risk Reward", minval = 0.1)

trailATR = input.float(30.5, "Trailing ATR", minval = 0.1)

// 거래 결과 표시
showProfitLabel = input.bool(true, "익절 거래 표시")
showLossLabel   = input.bool(true, "손실 거래 표시")
showBreakEven   = input.bool(false, "본전 거래 표시")

// =====================
// Indicators
// =====================
fastEmaValue = ta.ema(close, fastEMA)
slowEmaValue = ta.ema(close, slowEMA)

rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

// =====================
// Trend
// =====================
upTrend =
     fastEmaValue > slowEmaValue

downTrend =
     fastEmaValue < slowEmaValue

// =====================
// Entry
// =====================
longCondition =
     ta.crossover(close, fastEmaValue) and
     upTrend and
     rsiValue > rsiLong

shortCondition =
     ta.crossunder(close, fastEmaValue) and
     downTrend and
     rsiValue < rsiShort

if longCondition
    strategy.entry(
         id = "Long",
         direction = strategy.long,
         comment = "롱 진입"
    )

if shortCondition
    strategy.entry(
         id = "Short",
         direction = strategy.short,
         comment = "숏 진입"
    )

// =====================
// Exit prices
// =====================
longStop =
     strategy.position_avg_price -
     atrValue * stopATR

longTarget =
     strategy.position_avg_price +
     atrValue * stopATR * rr

shortStop =
     strategy.position_avg_price +
     atrValue * stopATR

shortTarget =
     strategy.position_avg_price -
     atrValue * stopATR * rr

// TradingView의 trail_points와 trail_offset은 틱 단위
trailTicks =
     math.max(
         1,
         math.round(
             atrValue * trailATR /
             syminfo.mintick
         )
     )

// =====================
// Exit orders
// =====================
if strategy.position_size > 0
    strategy.exit(
         id = "Long Exit",
         from_entry = "Long",
         stop = longStop,
         limit = longTarget,
         trail_points = trailTicks,
         trail_offset = trailTicks,
         comment_profit = "롱 목표가 익절",
         comment_loss = "롱 손절",
         comment_trailing = "롱 추적 익절"
    )

if strategy.position_size < 0
    strategy.exit(
         id = "Short Exit",
         from_entry = "Short",
         stop = shortStop,
         limit = shortTarget,
         trail_points = trailTicks,
         trail_offset = trailTicks,
         comment_profit = "숏 목표가 익절",
         comment_loss = "숏 손절",
         comment_trailing = "숏 추적 익절"
    )

// =====================
// Closed trade result
// =====================

// 새 거래가 청산됐는지 확인
newClosedTrade =
     strategy.closedtrades >
     strategy.closedtrades[1]

// 청산 거래 정보 저장용 변수
float closedProfit = na
float closedExitPrice = na
string closedEntryId = ""
string resultText = ""

bool profitableTrade = false
bool losingTrade = false
bool breakEvenTrade = false

if newClosedTrade
    lastTradeNumber =
         strategy.closedtrades - 1

    closedProfit :=
         strategy.closedtrades.profit(
             lastTradeNumber
         )

    closedExitPrice :=
         strategy.closedtrades.exit_price(
             lastTradeNumber
         )

    closedEntryId :=
         strategy.closedtrades.entry_id(
             lastTradeNumber
         )

    profitableTrade :=
         closedProfit > 0

    losingTrade :=
         closedProfit < 0

    breakEvenTrade :=
         closedProfit == 0

    resultText :=
         profitableTrade
         ? "익절\n" + str.tostring(closedProfit, "#.##")
         : losingTrade
         ? "손절\n" + str.tostring(closedProfit, "#.##")
         : "본전"

// =====================
// Result labels
// =====================

// 롱 거래 라벨은 청산가격 위에 표시
// 숏 거래 라벨은 청산가격 아래에 표시
if newClosedTrade
    isLongTrade =
         closedEntryId == "Long"

    if profitableTrade and showProfitLabel
        label.new(
             x = bar_index,
             y = closedExitPrice,
             text = resultText,
             style = isLongTrade
                 ? label.style_label_down
                 : label.style_label_up,
             color = color.new(color.green, 0),
             textcolor = color.white,
             size = size.small
        )

    if losingTrade and showLossLabel
        label.new(
             x = bar_index,
             y = closedExitPrice,
             text = resultText,
             style = isLongTrade
                 ? label.style_label_down
                 : label.style_label_up,
             color = color.new(color.red, 0),
             textcolor = color.white,
             size = size.small
        )

    if breakEvenTrade and showBreakEven
        label.new(
             x = bar_index,
             y = closedExitPrice,
             text = resultText,
             style = isLongTrade
                 ? label.style_label_down
                 : label.style_label_up,
             color = color.new(color.gray, 0),
             textcolor = color.white,
             size = size.small
        )

// =====================
// Plot
// =====================
plot(
     fastEmaValue,
     title = "Fast EMA",
     color = color.green,
     linewidth = 2
)

plot(
     slowEmaValue,
     title = "Slow EMA",
     color = color.red,
     linewidth = 2
)

plotshape(
     longCondition,
     title = "Long Entry",
     style = shape.triangleup,
     location = location.belowbar,
     color = color.rgb(148, 236, 194),
     size = size.small,
     text = "LONG"
)

plotshape(
     shortCondition,
     title = "Short Entry",
     style = shape.triangledown,
     location = location.abovebar,
     color = color.red,
     size = size.small,
     text = "SHORT"
)