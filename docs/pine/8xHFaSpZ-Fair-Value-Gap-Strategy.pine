//@version=6
strategy("Fair Value Gap Strategy", overlay=true, margin_long=100, margin_short=100)

// --- FVG Detection Logic ---
// Bullish FVG: High of bar 2 is lower than Low of bar 0
// This means bar 1 moved up so fast that bar 2 and bar 0 never touched.
bullishFVG = high[2] < low[0]

// Bearish FVG: Low of bar 2 is higher than High of bar 0
// This means bar 1 moved down so fast that bar 2 and bar 0 never touched.
bearishFVG = low[2] > high[0]

// --- Visualization ---
plotshape(series=bullishFVG, color=color.new(color.green, 0), style=shape.labelup, location=location.belowbar, size=size.small, title="Bullish FVG", text="FVG", textcolor=color.white)
plotshape(series=bearishFVG, color=color.new(color.red, 0), style=shape.labeldown, location=location.abovebar, size=size.small, title="Bearish FVG", text="FVG", textcolor=color.white)

// --- Strategy Entries ---
if (bullishFVG)
    strategy.entry("Long", strategy.long)

if (bearishFVG)
    strategy.entry("Short", strategy.short)

// Optional: Highlight the gap area (The "Fair Value" zone)
var box fvgBox = na
if bullishFVG
    fvgBox := box.new(left=bar_index[2], top=low[0], right=bar_index, bottom=high[2], bgcolor=color.new(color.green, 80), border_color=color.green)
if bearishFVG
    fvgBox := box.new(left=bar_index[2], top=low[2], right=bar_index, bottom=high[0], bgcolor=color.new(color.red, 80), border_color=color.red)