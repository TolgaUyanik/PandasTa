//@version=5
indicator("DA Cloud - Dynamic", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=2000)

// =====================
// Input Parameters
// =====================
sensitivity = input.int(23, "Sensitivity", minval=5, maxval=50, tooltip="Controls cloud responsiveness to price")
smoothing = input.int(23, "Smoothing", minval=1, maxval=50, tooltip="Controls the flow of cloud lines")
displacement = input.int(21, "Forward Displacement", minval=0, maxval=50)

// New adjustable parameters
volLookback = input.int(500, "Volatility Lookback", minval=50, maxval=1000, tooltip="Period for volatility baseline")
volSmoothing = input.int(22, "Volatility Smoothing", minval=1, maxval=50, tooltip="Smoothing for volatility expansion")
expansionPower = input.float(0.5, "Expansion Power", minval=0.1, maxval=2.0, step=0.1, tooltip="How dramatically clouds expand (1.0 = linear)")
rangeDivisor = input.float(2.7, "Range Divisor", minval=1.0, maxval=20.0, step=0.1, tooltip="Lower = wider clouds")

// Add max bars back setting
maxBarsBack = input.int(2000, "Max Bars Back", minval=500, maxval=5000, tooltip="How far back to calculate the cloud", group="Advanced")

// Level multipliers
level1Mult = input.float(0.5, "Level 1 Multiplier", minval=0.1, maxval=2.0, step=0.1, group="Level Spacing")
level2Mult = input.float(1.2, "Level 2 Multiplier", minval=0.5, maxval=3.0, step=0.1, group="Level Spacing")
level3Mult = input.float(2.0, "Level 3 Multiplier", minval=1.0, maxval=5.0, step=0.1, group="Level Spacing")

// Trend multipliers
trend1Mult = input.float(0.25, "Trend 1 Multiplier", minval=0.1, maxval=1.0, step=0.05, group="Trend Spacing")
trend2Mult = input.float(0.4, "Trend 2 Multiplier", minval=0.2, maxval=2.0, step=0.05, group="Trend Spacing")

// Fibonacci inputs (hidden but used in calculations)
span1 = 13
span2 = 21
span3 = 34
span4 = 55

// Colors - Back to standard colors
resistanceColor = color.new(#FF1744, 0)  // Red for top/resistance
supportColor = color.new(#4CAF50, 0)     // Green for bottom/support  
trendColor = color.new(#2196F3, 0)       // Blue for trend/median
confirmationColor = color.new(#9C27B0, 0) // Purple for confirmation

// =====================
// Dynamic Range Calculation
// =====================

// Calculate dynamic range using multiple timeframes
range1 = ta.tr(true) // True Range
range2 = ta.atr(span1)
range3 = ta.atr(span2)
range4 = ta.atr(span3)

// Weighted average range - more weight on longer timeframes for stability
avgRange = (range1 * 0.2 + range2 * 0.3 + range3 * 0.3 + range4 * 0.2)
smoothRange = ta.ema(avgRange, smoothing)

// Add volatility expansion factor - now fully adjustable
// When volatility increases, clouds should expand more dramatically
// Use nz() to handle NA values for historical data
histAvgRange = nz(avgRange, smoothRange)
volatilityBaseline = ta.sma(histAvgRange, volLookback)
volatilityRatio = histAvgRange / nz(volatilityBaseline, histAvgRange)
smoothVolRatio = ta.ema(volatilityRatio, volSmoothing)
expansionFactor = math.pow(smoothVolRatio, expansionPower)

// Final dynamic range with expansion
dynamicRange = smoothRange * expansionFactor

// =====================
// Dynamic Pivot Calculation
// =====================

// Calculate pivot points using Fibonacci periods
pivot1 = (high + low + close) / 3
pivot2 = ta.ema(pivot1, span1)
pivot3 = ta.ema(pivot1, span2)
pivot4 = ta.ema(pivot1, span3)

// Weighted pivot
dynamicPivot = (pivot2 * 0.5 + pivot3 * 0.3 + pivot4 * 0.2)

// =====================
// Cloud Level Calculations
// =====================

// Calculate sensitivity factor - now adjustable via rangeDivisor
sensFactor = sensitivity / rangeDivisor

// Dynamic resistance levels - using adjustable multipliers
rl1 = dynamicPivot + dynamicRange * (level1Mult * sensFactor)
rl2 = dynamicPivot + dynamicRange * (level2Mult * sensFactor)
rl3 = dynamicPivot + dynamicRange * (level3Mult * sensFactor)

// Dynamic support levels
sl1 = dynamicPivot - dynamicRange * (level1Mult * sensFactor)
sl2 = dynamicPivot - dynamicRange * (level2Mult * sensFactor)
sl3 = dynamicPivot - dynamicRange * (level3Mult * sensFactor)

// Channel levels (between main levels) - proper placement
rc1 = rl1 + (rl2 - rl1) * 0.382
rc2 = rl1 + (rl2 - rl1) * 0.618

sc1 = sl1 - (sl1 - sl2) * 0.382
sc2 = sl1 - (sl1 - sl2) * 0.618

// =====================
// Trend Calculation
// =====================

// Multi-timeframe trend using balanced bands
ema13 = ta.ema(close, span1)
ema21 = ta.ema(close, span2)
ema34 = ta.ema(close, span3)

trendMedian = (ema13 * 0.5 + ema21 * 0.3 + ema34 * 0.2)
trendSmooth = ta.ema(trendMedian, smoothing)

// Trend bands - using adjustable multipliers
trendUpper1 = trendSmooth + dynamicRange * trend1Mult * sensFactor
trendUpper2 = trendSmooth + dynamicRange * trend2Mult * sensFactor
trendLower1 = trendSmooth - dynamicRange * trend1Mult * sensFactor
trendLower2 = trendSmooth - dynamicRange * trend2Mult * sensFactor

// =====================
// Confirmation Line
// =====================

// Fast reactive line
ema3 = ta.ema(close, 3)
ema5 = ta.ema(close, 5)
ema8 = ta.ema(close, 8)

confirmationLine = (ema3 * 0.5 + ema5 * 0.3 + ema8 * 0.2)

// =====================
// Smoothing for Flow Effect
// =====================

// Apply additional smoothing for flowing effect
rl1_smooth = ta.ema(rl1, 3)
rl2_smooth = ta.ema(rl2, 3)
rl3_smooth = ta.ema(rl3, 3)

rc1_smooth = ta.ema(rc1, 3)
rc2_smooth = ta.ema(rc2, 3)

sl1_smooth = ta.ema(sl1, 3)
sl2_smooth = ta.ema(sl2, 3)
sl3_smooth = ta.ema(sl3, 3)

sc1_smooth = ta.ema(sc1, 3)
sc2_smooth = ta.ema(sc2, 3)

tu1_smooth = ta.ema(trendUpper1, 3)
tu2_smooth = ta.ema(trendUpper2, 3)
tl1_smooth = ta.ema(trendLower1, 3)
tl2_smooth = ta.ema(trendLower2, 3)
tm_smooth = ta.ema(trendSmooth, 3)

// =====================
// Plotting with Displacement
// =====================

// Resistance Cloud
p_rl3 = plot(rl3_smooth, "RL3", color=color.new(resistanceColor, 60), linewidth=1, offset=displacement)
p_rc2 = plot(rc2_smooth, "RC2", color=color.new(resistanceColor, 80), linewidth=1, offset=displacement)
p_rl2 = plot(rl2_smooth, "RL2", color=color.new(resistanceColor, 40), linewidth=1, offset=displacement)
p_rc1 = plot(rc1_smooth, "RC1", color=color.new(resistanceColor, 85), linewidth=1, offset=displacement)
p_rl1 = plot(rl1_smooth, "RL1", color=color.new(resistanceColor, 0), linewidth=2, offset=displacement)

// Support Cloud
p_sl1 = plot(sl1_smooth, "SL1", color=color.new(supportColor, 0), linewidth=2, offset=displacement)
p_sc1 = plot(sc1_smooth, "SC1", color=color.new(supportColor, 85), linewidth=1, offset=displacement)
p_sl2 = plot(sl2_smooth, "SL2", color=color.new(supportColor, 40), linewidth=1, offset=displacement)
p_sc2 = plot(sc2_smooth, "SC2", color=color.new(supportColor, 80), linewidth=1, offset=displacement)
p_sl3 = plot(sl3_smooth, "SL3", color=color.new(supportColor, 60), linewidth=1, offset=displacement)

// Cloud fills
fill(p_rl3, p_rl2, color=color.new(resistanceColor, 94))
fill(p_rl2, p_rl1, color=color.new(resistanceColor, 96))

fill(p_sl1, p_sl2, color=color.new(supportColor, 96))
fill(p_sl2, p_sl3, color=color.new(supportColor, 94))

// Trend Lines
plot(tu2_smooth, "TU2", color=color.new(trendColor, 80), linewidth=1, offset=displacement)
plot(tu1_smooth, "TU1", color=color.new(trendColor, 60), linewidth=1, offset=displacement)
plot(tm_smooth, "TM", color=color.new(trendColor, 0), linewidth=2, offset=displacement)
plot(tl1_smooth, "TL1", color=color.new(trendColor, 60), linewidth=1, offset=displacement)
plot(tl2_smooth, "TL2", color=color.new(trendColor, 80), linewidth=1, offset=displacement)

// Confirmation Line (not displaced)
plot(confirmationLine, "CL", color=confirmationColor, linewidth=2)

// =====================
// Touch Points
// =====================

// Get current displaced values
rl1_current = nz(rl1_smooth[displacement])
sl1_current = nz(sl1_smooth[displacement])
tm_current = nz(tm_smooth[displacement])

// Dynamic tolerance
tolerance = smoothRange * 0.1

// Detect touches
touchRL1 = math.abs(high - rl1_current) < tolerance or math.abs(low - rl1_current) < tolerance
touchSL1 = math.abs(high - sl1_current) < tolerance or math.abs(low - sl1_current) < tolerance
touchTM = math.abs(close - tm_current) < tolerance

// Draw touch points
if touchRL1 and touchSL1
    label.new(bar_index, (rl1_current + sl1_current) / 2, "●", style=label.style_label_center, color=trendColor, textcolor=trendColor, size=size.large)
else if touchRL1
    label.new(bar_index, rl1_current, "●", style=label.style_label_center, color=resistanceColor, textcolor=resistanceColor, size=size.normal)
else if touchSL1
    label.new(bar_index, sl1_current, "●", style=label.style_label_center, color=supportColor, textcolor=supportColor, size=size.normal)

// =====================
// Signals
// =====================

cloudExit = ta.crossunder(confirmationLine, rl1_current)
cloudEntry = ta.crossover(confirmationLine, sl1_current)

if cloudExit
    label.new(bar_index, high * 1.005, "Exit", style=label.style_label_down, color=resistanceColor, textcolor=color.white, size=size.small)

if cloudEntry
    label.new(bar_index, low * 0.995, "Entry", style=label.style_label_up, color=supportColor, textcolor=color.white, size=size.small)

// =====================
// Info Table
// =====================

var table infoTable = table.new(position.top_right, 2, 5)

if barstate.islast
    table.cell(infoTable, 0, 0, "DA Cloud", text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 1, 0, "Levels", text_color=color.white, text_size=size.normal)
    
    table.cell(infoTable, 0, 1, "RL1", text_color=resistanceColor, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(rl1_smooth, "#,###.##"), text_color=resistanceColor, text_size=size.small)
    
    table.cell(infoTable, 0, 2, "TM", text_color=trendColor, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(tm_smooth, "#,###.##"), text_color=trendColor, text_size=size.small)
    
    table.cell(infoTable, 0, 3, "SL1", text_color=supportColor, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(sl1_smooth, "#,###.##"), text_color=supportColor, text_size=size.small)
    
    bias = close > tm_current ? "BULLISH" : "BEARISH"
    biasColor = close > tm_current ? supportColor : resistanceColor
    table.cell(infoTable, 0, 4, "Bias", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, bias, text_color=biasColor, text_size=size.small)

// Background
bgcolor(close > tm_current ? color.new(supportColor, 98) : color.new(resistanceColor, 98))

// Fibonacci Label
if barstate.islast
    label.new(bar_index - 30, ta.highest(high, 50) * 1.005, "DA Cloud 3 13 13 21 34 55 3", style=label.style_none, textcolor=color.new(color.gray, 50), size=size.small)