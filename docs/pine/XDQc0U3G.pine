//@version=6
indicator("Performance / a", overlay=true, precision=2, format=format.percent, max_labels_count=500)
//indicator(title="Yearly Percentage Returns", overlay=false, precision=2, format=format.percent, )
color labelColor = color.new(#10bb00, 64)
color textColor = color.rgb(0, 0, 0, 48)
color labelColor2 = color.new(#0fa801, 7)
color textColor2 = color.rgb(224, 224, 224)


//string sInputDate = input.string("2024-01-01 00:00", title="Zieldatum (YYYY-MM-DD HH:mm)")
int iInputDate1 = input.time(timestamp("2024-01-01 10:00 UTC"), inline="Klickpunkt", title = "Datum 1", confirm=true)
int iInputDate2 = input.time(timestamp("2025-01-01 12:00 UTC"), inline="Klickpunkt", title = "Datum 2", confirm=true)
int iDeltaDate = (iInputDate2-iInputDate1)/3600/24/1000/365   // in Jahren
//log.info(str.tostring(iDeltaDate))


var float Price1 = na
var float Price2 = na
var int foundTime1 = na
var int foundTime2 = na
var label priceLabel1 = na
var label priceLabel2 = na
var label priceLabel3 = na

// request.security holt die 'close' und 'time' Daten vom Chart.
[currentClose, currentTime] = request.security(syminfo.tickerid, timeframe.period, [close, time], lookahead=barmerge.lookahead_on)


if na(Price1) and currentTime >= iInputDate1
    Price1 := currentClose
    foundTime1 := currentTime

if not na(Price1) and not na(foundTime1)
   
    string labelText1 = str.format_time(foundTime1, "dd.MM.yyyy") + "\nPreis  " + str.tostring(Price1, "#.##")
        
    // Wenn das Label noch nicht existiert, erstelle es.
    if na(priceLabel1)
        priceLabel1 := label.new(x=foundTime1, y=Price1, text=labelText1, xloc=xloc.bar_time, yloc=yloc.price, color=labelColor, textcolor=textColor, size=size.normal, style=label.style_label_down) 
    // Wenn das Label bereits existiert, aktualisiere es.
    else
        label.set_xy(priceLabel1, foundTime1, Price1)
        label.set_text(priceLabel1, labelText1)
        label.set_color(priceLabel1, labelColor) 
        label.set_textcolor(priceLabel1, textColor)
        label.set_size(priceLabel1, size.small) 
        label.set_style(priceLabel1, label.style_label_down)
else if not na(priceLabel1) // Wenn kein Preis gefunden oder Datum geändert, lösche Label.
    label.delete(priceLabel1)
    priceLabel1 := na


if na(Price2) and currentTime >= iInputDate2
    Price2 := currentClose
    foundTime2 := currentTime

if not na(Price2) and not na(foundTime2)
    string labelText2 = str.format_time(foundTime2, "dd.MM.yyyy") + "\nPreis  " + str.tostring(Price2, "#.##")
    
    // Wenn das Label noch nicht existiert, erstelle es.
    if na(priceLabel2)
        priceLabel2 := label.new(x=foundTime2, y=Price2, text=labelText2, xloc=xloc.bar_time, yloc=yloc.price, color=labelColor, textcolor=textColor, size=size.small, style=label.style_label_up) 
    // Wenn das Label bereits existiert, aktualisiere es.
    else
        label.set_xy(priceLabel2, foundTime2, Price2)
        label.set_text(priceLabel2, labelText2)
        label.set_color(priceLabel2, labelColor) 
        label.set_textcolor(priceLabel2, textColor)
        label.set_size(priceLabel2, size.small) 
        label.set_style(priceLabel2, label.style_label_down)
else if not na(priceLabel2) // Wenn kein Preis gefunden oder Datum geändert, lösche Label.
    label.delete(priceLabel2)
    priceLabel2 := na




string labelText3 = "**DELTA " + str.tostring((Price2-Price1), "#.## EUR  ") + str.tostring((Price2-Price1)/Price1, "#.## %") +  "\nAvg. Performance pro Jahr " + str.tostring(math.pow((Price2 / Price1), (1 / iDeltaDate)) - 1, "#.## %**")
//log.info(labelText3)

if na(priceLabel3)
    priceLabel3 := label.new(x=(foundTime1+(foundTime2-foundTime1)/2), y=Price2, text=labelText3, xloc=xloc.bar_time, yloc=yloc.price, color=labelColor2, textcolor=textColor2, size=size.small, style=label.style_label_down) 
    // Wenn das Label bereits existiert, aktualisiere es.
else
    label.set_xy(priceLabel3, (foundTime1+(foundTime2-foundTime1)/2), Price2)
    label.set_text(priceLabel3, labelText3)
    label.set_color(priceLabel3, labelColor2) 
    label.set_textcolor(priceLabel3, textColor2)
    label.set_size(priceLabel3, size.normal) 
    label.set_style(priceLabel3, label.style_label_down)



Avg_Performance = (math.pow((Price2 / Price1), (1 / iDeltaDate)) - 1)*100

color plot_color = Avg_Performance > 0 ? color.green : color.red
plot(Avg_Performance, title="Yearly Returns", style=plot.style_areabr, color=color.new(plot_color, 30))

bool longSignal = ta.rising(close, 2) and ta.rising(high, 2) and (na(volume) or ta.rising(volume, 2))
plotchar(longSignal, "Long", "▲", location.belowbar, color = na(volume) ? color.gray : color.blue, size = size.tiny)
