//@version=6
// ICE CRT Audit — debug table render only (B2.1: RR + TP1 Formula)
// Publish v1: import OSMANYBTC/ICE_CRT_Audit/1 as audit
// Render-only: no counters, no signals, no array mutation.
library("ICE_CRT_Audit", true)

export const int RR_AUDIT_DISPLAY_MAX  = 12
export const int TP1_AUDIT_DISPLAY_MAX = 12
export const int RR_AUDIT_ROW_SUM      = 13
export const int RR_AUDIT_ROW_AVG      = 14
export const int RR_AUDIT_ROW_NOTE     = 15
export const int TP1_AUDIT_ROW_SUM     = 13
export const int TP1_AUDIT_ROW_AVG     = 14
export const int TP1_AUDIT_ROW_NOTE    = 15

export renderRRAudit(
     table t,
     array<float> tradeEntries,
     array<float> tradeStops,
     array<float> tradeRisks,
     array<float> tradeTp1s,
     array<float> tradeTp1Need,
     array<float> tradeTp1Delta,
     array<float> tradeRRs,
     array<float> tradeDistEs,
     array<float> tradeDistEt1,
     array<float> tradeMissRew,
     array<string> tradeDirs,
     array<string> tradeReasons,
     float minRR,
     int failTotal,
     float avgRR,
     float avgNeedReward,
     float avgMissingRew,
     float avgEntry,
     float avgStop,
     float avgRisk,
     float avgTp1,
     float avgDistStop,
     float avgDistTp1) =>
    color rrHdrBg = color.new(color.gray, 70)
    color rrRowBg = color.new(color.black, 30)
    table.cell(t, 0, 0, "#", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 1, 0, "Dir", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 2, 0, "Entry", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 3, 0, "Stop", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 4, 0, "Risk", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 5, 0, "TP1", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 6, 0, "TP1@RR", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 7, 0, "Δ TP1", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 8, 0, "RR(TP1)", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 9, 0, "|E→Stop|", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 10, 0, "|E→TP1|", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 11, 0, "Miss Rew", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 12, 0, "Motivo RR", text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)

    int rrTradeCount = array.size(tradeEntries)
    int rrShowCount  = math.min(rrTradeCount, RR_AUDIT_DISPLAY_MAX)
    if rrShowCount > 0
        for i = 0 to rrShowCount - 1
            int rrRow = i + 1
            float rrEntry     = array.get(tradeEntries, i)
            float rrStop      = array.get(tradeStops, i)
            float rrRisk      = array.get(tradeRisks, i)
            float rrTp1       = array.get(tradeTp1s, i)
            float rrTp1Need   = array.get(tradeTp1Need, i)
            float rrTp1Delta  = array.get(tradeTp1Delta, i)
            float rrVal       = array.get(tradeRRs, i)
            float rrDistEs    = array.get(tradeDistEs, i)
            float rrDistEt1   = array.get(tradeDistEt1, i)
            float rrMissRew   = array.get(tradeMissRew, i)
            string rrDir      = array.get(tradeDirs, i)
            string rrReason   = array.get(tradeReasons, i)
            color rrFailCol   = rrVal < minRR ? color.new(color.orange, 0) : color.new(color.green, 0)
            color rrMissCol   = rrMissRew > 0 ? color.new(#F9A825, 0) : color.new(color.green, 0)
            table.cell(t, 0, rrRow, str.tostring(i + 1), text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 1, rrRow, rrDir, text_color = rrDir == "L" ? color.new(#26A69A, 0) : color.new(#EF5350, 0), text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 2, rrRow, str.tostring(rrEntry, format.mintick), text_color = color.white, text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 3, rrRow, str.tostring(rrStop, format.mintick), text_color = color.white, text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 4, rrRow, str.tostring(rrRisk, format.mintick), text_color = color.new(#B71C1C, 0), text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 5, rrRow, str.tostring(rrTp1, format.mintick), text_color = color.white, text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 6, rrRow, str.tostring(rrTp1Need, format.mintick), text_color = color.new(#F9A825, 0), text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 7, rrRow, str.tostring(rrTp1Delta, format.mintick), text_color = color.new(#FFB74D, 0), text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 8, rrRow, str.tostring(rrVal, "#.####"), text_color = rrFailCol, text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 9, rrRow, str.tostring(rrDistEs, format.mintick), text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 10, rrRow, str.tostring(rrDistEt1, format.mintick), text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 11, rrRow, str.tostring(rrMissRew, format.mintick), text_color = rrMissCol, text_size = size.tiny, bgcolor = rrRowBg)
            table.cell(t, 12, rrRow, rrReason, text_color = rrFailCol, text_size = size.tiny, bgcolor = rrRowBg)

    table.cell(t, 0, RR_AUDIT_ROW_SUM, "RR Audit Σ", text_color = color.white, text_size = size.small, bgcolor = rrHdrBg)
    table.cell(t, 1, RR_AUDIT_ROW_SUM, str.tostring(rrTradeCount) + " inv", text_color = color.new(#FFD54F, 0), text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 2, RR_AUDIT_ROW_SUM, "Invalid RR", text_color = color.silver, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 3, RR_AUDIT_ROW_SUM, str.tostring(failTotal), text_color = failTotal > 0 ? color.new(color.orange, 0) : color.new(color.green, 0), text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 4, RR_AUDIT_ROW_SUM, "Min RR", text_color = color.silver, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 5, RR_AUDIT_ROW_SUM, str.tostring(minRR, "#.##"), text_color = color.white, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 6, RR_AUDIT_ROW_SUM, "Avg RR", text_color = color.silver, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 7, RR_AUDIT_ROW_SUM, na(avgRR) ? "—" : str.tostring(avgRR, "#.####"), text_color = na(avgRR) ? color.gray : (avgRR < minRR ? color.new(color.orange, 0) : color.new(color.green, 0)), text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 8, RR_AUDIT_ROW_SUM, "need Rew", text_color = color.silver, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 9, RR_AUDIT_ROW_SUM, na(avgNeedReward) ? "—" : str.tostring(avgNeedReward, format.mintick), text_color = color.new(#F9A825, 0), text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 10, RR_AUDIT_ROW_SUM, "Avg Miss Rew", text_color = color.silver, text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 11, RR_AUDIT_ROW_SUM, na(avgMissingRew) ? "—" : str.tostring(avgMissingRew, format.mintick), text_color = na(avgMissingRew) ? color.gray : color.new(#F9A825, 0), text_size = size.tiny, bgcolor = rrHdrBg)
    table.cell(t, 12, RR_AUDIT_ROW_SUM, "TP1@RR=min", text_color = color.gray, text_size = size.tiny, bgcolor = rrHdrBg)

    table.cell(t, 0, RR_AUDIT_ROW_AVG, "Avg Entry", text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 1, RR_AUDIT_ROW_AVG, na(avgEntry) ? "—" : str.tostring(avgEntry, format.mintick), text_color = color.white, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 2, RR_AUDIT_ROW_AVG, "Avg Stop", text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 3, RR_AUDIT_ROW_AVG, na(avgStop) ? "—" : str.tostring(avgStop, format.mintick), text_color = color.white, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 4, RR_AUDIT_ROW_AVG, "Avg Risk", text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 5, RR_AUDIT_ROW_AVG, na(avgRisk) ? "—" : str.tostring(avgRisk, format.mintick), text_color = color.new(#B71C1C, 0), text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 6, RR_AUDIT_ROW_AVG, "Avg TP1", text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 7, RR_AUDIT_ROW_AVG, na(avgTp1) ? "—" : str.tostring(avgTp1, format.mintick), text_color = color.white, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 8, RR_AUDIT_ROW_AVG, "Avg |E→Stop|", text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 9, RR_AUDIT_ROW_AVG, na(avgDistStop) ? "—" : str.tostring(avgDistStop, format.mintick), text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 10, RR_AUDIT_ROW_AVG, "Avg |E→TP1|", text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 11, RR_AUDIT_ROW_AVG, na(avgDistTp1) ? "—" : str.tostring(avgDistTp1, format.mintick), text_color = color.silver, text_size = size.tiny, bgcolor = rrRowBg)
    table.cell(t, 12, RR_AUDIT_ROW_AVG, "Labels on chart", text_color = color.gray, text_size = size.tiny, bgcolor = rrRowBg)

    string rrDispNote = rrTradeCount > RR_AUDIT_DISPLAY_MAX ? "Showing " + str.tostring(RR_AUDIT_DISPLAY_MAX) + " of " + str.tostring(rrTradeCount) : "All " + str.tostring(rrTradeCount) + " trades shown"
    table.cell(t, 0, RR_AUDIT_ROW_NOTE, rrDispNote, text_color = color.gray, text_size = size.tiny, bgcolor = rrRowBg)

export renderTp1FormulaAudit(
     table t,
     array<string> tradeDirs,
     array<float> tradeCrtRanges,
     array<float> tradeRatios,
     array<float> tradeDistEt1,
     array<float> tradeDistEs,
     array<float> tradeRRs,
     array<float> tradeNeedRatios,
     array<float> tradeGapRatios,
     array<string> tradeFixAt1,
     array<float> tradeTp1AtRR,
     float minRR,
     float curTp1CrtRatio,
     int auditFixAt1,
     int auditTotal,
     float fixAt1Pct,
     int auditUnfixable,
     float needRatioMax,
     float avgNeedRatio,
     float avgGapRatio) =>
    color tp1HdrBg = color.new(color.gray, 70)
    color tp1RowBg = color.new(color.black, 30)
    table.cell(t, 0, 0, "#", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 1, 0, "Dir", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 2, 0, "CRT Rng", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 3, 0, "Ratio", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 4, 0, "|E→TP1|", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 5, 0, "|E→Stop|", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 6, 0, "RR", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 7, 0, "Need%", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 8, 0, "Gap+", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 9, 0, "Fix@1", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 10, 0, "TP1@RR", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)

    int tp1TradeCount = array.size(tradeCrtRanges)
    int tp1ShowCount  = math.min(tp1TradeCount, TP1_AUDIT_DISPLAY_MAX)
    if tp1ShowCount > 0
        for i = 0 to tp1ShowCount - 1
            int tp1Row = i + 1
            string tp1Dir       = array.get(tradeDirs, i)
            float tp1CrtRng     = array.get(tradeCrtRanges, i)
            float tp1Ratio      = array.get(tradeRatios, i)
            float tp1DistEt1    = array.get(tradeDistEt1, i)
            float tp1DistEs     = array.get(tradeDistEs, i)
            float tp1RR         = array.get(tradeRRs, i)
            float tp1NeedRatio  = array.get(tradeNeedRatios, i)
            float tp1GapRatio   = array.get(tradeGapRatios, i)
            string tp1FixAt1    = array.get(tradeFixAt1, i)
            float tp1AtRR       = array.get(tradeTp1AtRR, i)
            color tp1RRCol      = tp1RR < minRR ? color.new(color.orange, 0) : color.new(color.green, 0)
            color tp1FixCol     = tp1FixAt1 == "Y" ? color.new(color.green, 0) : color.new(color.red, 0)
            color tp1NeedCol    = na(tp1NeedRatio) ? color.gray : (tp1NeedRatio <= 1.0 ? color.new(#F9A825, 0) : color.new(color.red, 0))
            table.cell(t, 0, tp1Row, str.tostring(i + 1), text_color = color.silver, text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 1, tp1Row, tp1Dir, text_color = tp1Dir == "L" ? color.new(#26A69A, 0) : color.new(#EF5350, 0), text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 2, tp1Row, str.tostring(tp1CrtRng, format.mintick), text_color = color.white, text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 3, tp1Row, str.tostring(tp1Ratio, "#.##"), text_color = color.new(#64B5F6, 0), text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 4, tp1Row, str.tostring(tp1DistEt1, format.mintick), text_color = color.silver, text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 5, tp1Row, str.tostring(tp1DistEs, format.mintick), text_color = color.new(#B71C1C, 0), text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 6, tp1Row, str.tostring(tp1RR, "#.####"), text_color = tp1RRCol, text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 7, tp1Row, na(tp1NeedRatio) ? "—" : str.tostring(tp1NeedRatio, "#.####"), text_color = tp1NeedCol, text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 8, tp1Row, na(tp1GapRatio) ? "—" : str.tostring(tp1GapRatio, "#.####"), text_color = color.new(#FFB74D, 0), text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 9, tp1Row, tp1FixAt1, text_color = tp1FixCol, text_size = size.tiny, bgcolor = tp1RowBg)
            table.cell(t, 10, tp1Row, str.tostring(tp1AtRR, format.mintick), text_color = color.new(#F9A825, 0), text_size = size.tiny, bgcolor = tp1RowBg)

    table.cell(t, 0, TP1_AUDIT_ROW_SUM, "TP1 Form Σ", text_color = color.white, text_size = size.small, bgcolor = tp1HdrBg)
    table.cell(t, 1, TP1_AUDIT_ROW_SUM, str.tostring(tp1TradeCount) + " inv", text_color = color.new(#FFD54F, 0), text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 2, TP1_AUDIT_ROW_SUM, "Cur ratio", text_color = color.silver, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 3, TP1_AUDIT_ROW_SUM, str.tostring(curTp1CrtRatio, "#.##"), text_color = color.new(#64B5F6, 0), text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 4, TP1_AUDIT_ROW_SUM, "Fix@1.0", text_color = color.silver, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 5, TP1_AUDIT_ROW_SUM, str.tostring(auditFixAt1) + "/" + str.tostring(auditTotal), text_color = auditFixAt1 == auditTotal ? color.new(color.green, 0) : color.new(color.orange, 0), text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 6, TP1_AUDIT_ROW_SUM, na(fixAt1Pct) ? "—" : str.tostring(fixAt1Pct, "#.#") + "%", text_color = color.white, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 7, TP1_AUDIT_ROW_SUM, "Unfix", text_color = color.silver, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 8, TP1_AUDIT_ROW_SUM, str.tostring(auditUnfixable), text_color = auditUnfixable > 0 ? color.new(color.red, 0) : color.new(color.green, 0), text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 9, TP1_AUDIT_ROW_SUM, "Max Need%", text_color = color.silver, text_size = size.tiny, bgcolor = tp1HdrBg)
    table.cell(t, 10, TP1_AUDIT_ROW_SUM, needRatioMax > 0 ? str.tostring(needRatioMax, "#.####") : "—", text_color = needRatioMax > 1.0 ? color.new(color.red, 0) : color.new(#F9A825, 0), text_size = size.tiny, bgcolor = tp1HdrBg)

    table.cell(t, 0, TP1_AUDIT_ROW_AVG, "Avg Need%", text_color = color.silver, text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 1, TP1_AUDIT_ROW_AVG, na(avgNeedRatio) ? "—" : str.tostring(avgNeedRatio, "#.####"), text_color = color.new(#F9A825, 0), text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 2, TP1_AUDIT_ROW_AVG, "Avg Gap+", text_color = color.silver, text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 3, TP1_AUDIT_ROW_AVG, na(avgGapRatio) ? "—" : str.tostring(avgGapRatio, "#.####"), text_color = color.new(#FFB74D, 0), text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 4, TP1_AUDIT_ROW_AVG, "Formula", text_color = color.gray, text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 5, TP1_AUDIT_ROW_AVG, "E±r×Rng", text_color = color.gray, text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 6, TP1_AUDIT_ROW_AVG, "Need%", text_color = color.gray, text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 7, TP1_AUDIT_ROW_AVG, "minRR×Risk/Rng", text_color = color.gray, text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 8, TP1_AUDIT_ROW_AVG, "Fix@1", text_color = color.gray, text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 9, TP1_AUDIT_ROW_AVG, "Need%≤1", text_color = color.gray, text_size = size.tiny, bgcolor = tp1RowBg)
    table.cell(t, 10, TP1_AUDIT_ROW_AVG, "Labels on chart", text_color = color.gray, text_size = size.tiny, bgcolor = tp1RowBg)

    string tp1DispNote = tp1TradeCount > TP1_AUDIT_DISPLAY_MAX ? "Showing " + str.tostring(TP1_AUDIT_DISPLAY_MAX) + " of " + str.tostring(tp1TradeCount) : "All " + str.tostring(tp1TradeCount) + " trades shown"
    table.cell(t, 0, TP1_AUDIT_ROW_NOTE, tp1DispNote, text_color = color.gray, text_size = size.tiny, bgcolor = tp1RowBg)
