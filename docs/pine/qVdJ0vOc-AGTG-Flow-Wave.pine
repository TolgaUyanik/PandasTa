//@version=6
// AGTG Flow Wave
// ---------------------------------------------------------------------------
// Market-wide options-flow sentiment wave. TradingView cannot read per-stock
// option chains from Pine, so this wave is built from the CBOE put/call
// ratio (daily data): green columns rise when CALL volume is gaining
// dominance vs its trend, red columns when PUT volume is taking over.
// Background shades at sentiment extremes (contrarian zones).
// For per-ticker flow (QQQ/SPY/NDX/SPX) use the AGTG Flow page instead.
// Add this in its own pane under the AGTG Sweep Model chart.
// ---------------------------------------------------------------------------
indicator("AGTG Flow Wave", "AGTG WAVE", overlay = false)

GRN = #22E58C
RED = #EA3943
GLD = #F0C75E
MUT = #8A94A0

pcSym = input.symbol("USI:PCC", "Put/Call ratio symbol (PCC = total, PCCE = equity-only)")
fastL = input.int(5, "Fast average (days)", minval = 1)
slowL = input.int(20, "Slow average (days)", minval = 2)
lookback = input.int(252, "Extreme percentile lookback (days)", minval = 20)

pc = request.security(pcSym, "D", close, lookahead = barmerge.lookahead_off)
fast = ta.ema(pc, fastL)
slow = ta.ema(pc, slowL)
wave = slow - fast  // positive = put/call ratio falling vs trend = calls gaining

plot(wave, "Flow wave", style = plot.style_columns, color = wave >= 0 ? GRN : RED)
hline(0, color = color.new(#8A94A0, 60))

prank = ta.percentrank(pc, lookback)
// heavy puts vs the last year = fear extreme (contrarian long zone), and vice versa
bgcolor(prank >= 90 ? color.new(GRN, 88) : prank <= 10 ? color.new(RED, 88) : na)

if barstate.islast
    var table t = table.new(position.top_right, 2, 3, bgcolor = #10161D, border_width = 1, border_color = #1E2833)
    table.cell(t, 0, 0, "P/C ratio", text_color = MUT, text_size = size.small)
    table.cell(t, 1, 0, str.tostring(pc, "#.##"), text_color = GLD, text_size = size.small)
    table.cell(t, 0, 1, "Tilt", text_color = MUT, text_size = size.small)
    table.cell(t, 1, 1, wave >= 0 ? "CALLS gaining" : "PUTS gaining", text_color = wave >= 0 ? GRN : RED, text_size = size.small)
    table.cell(t, 0, 2, "1y percentile", text_color = MUT, text_size = size.small)
    table.cell(t, 1, 2, str.tostring(prank, "#") + "%" + (prank >= 90 ? " - fear extreme" : prank <= 10 ? " - complacency" : ""), text_color = prank >= 90 ? GRN : prank <= 10 ? RED : MUT, text_size = size.small)
