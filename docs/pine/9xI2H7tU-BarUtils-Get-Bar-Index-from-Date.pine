//@version=6
library('BarUtils', true)
//================================================================
// ---------- defaults you can tweak ----------
const int   BU_GRAD_WIN    = 300                         // lookback for PRIOR min/max
const bool  BU_GRAD_USELOG = true                        // log-compress by default
const color BU_COL_LOW     = color.new(color.gray,   0)  // low-end color
const color BU_COL_HIGH    = color.new(color.orange, 0)  // high-end color

// ---------- internals ----------
_clamp01(float x) =>
    math.max(0.0, math.min(1.0, x))

// Map a value to [0..1] using PRIOR window min/max (excludes current bar)
_val_to_unit_prior(float v, int win, bool useLog) =>
    float mag  = math.abs(v)                                   // intensity only
    float src  = useLog ? math.log(math.max(mag, 1e-10)) : mag // log compression
    float prev = src[1]                                        // exclude current bar
    float hi   = ta.highest(prev, win)
    float lo   = ta.lowest(prev,  win)
    float den  = hi - lo
    float t    = den > 0 ? (src - lo) / den : 0.0
    _clamp01(t)

// ---------- PUBLIC API (exported) ----------

// Usage:  color c = BU.getColorGradient(metric)
export getColorGradient(float val) =>
    float t = _val_to_unit_prior(val, BU_GRAD_WIN, BU_GRAD_USELOG)
    color.from_gradient(t, 0.0, 1.0, BU_COL_LOW, BU_COL_HIGH)

// Usage:  color c = BU.getColorGradientEx(metric, 300, true, color.gray, color.orange)
export getColorGradientEx(float val, simple int win, bool useLog, color colLow, color colHigh) =>
    float t = _val_to_unit_prior(val, win, useLog)
    color.from_gradient(t, 0.0, 1.0, colLow, colHigh)


//=================================================
// Function to get bar index from date
export getBarIndexFromDate(int targetTimestamp) =>
    // Estimate bar duration over last 20 bars
    barDuration = (time - time[20]) / 20
    barsBack = math.round((time - targetTimestamp) / barDuration)
    result = bar_index - barsBack
    result >= 0 ? result : na // Ensure result is within history

// Function to calculate rate of return
export rateOfReturn(series float source, int referenceBarIndex) =>
    barsSince = bar_index - referenceBarIndex
    barsSince >= 0 and not na(source[barsSince]) ? (source - source[barsSince]) / source[barsSince] * 100 : na

// Generic pivot high function
export pivotHighGeneric(series float src, int leftBars, int rightBars) =>
    var float ph = na
    if not na(src[rightBars]) // make sure we have enough lookahead
        isPivot = true
        for i = 1 to leftBars by 1
            if src[rightBars] <= src[rightBars + i]
                isPivot := false
                isPivot
        for i = 1 to rightBars by 1
            if src[rightBars] < src[rightBars - i]
                isPivot := false
                isPivot
        ph := isPivot ? src[rightBars] : na
        ph
    ph

// Generic pivot low function
export pivotLowGeneric(series float src, int leftBars, int rightBars) =>
    var float pl = na
    if not na(src[rightBars]) // make sure we have enough lookahead
        isPivot = true
        for i = 1 to leftBars by 1
            if src[rightBars] >= src[rightBars + i]
                isPivot := false
                isPivot
        for i = 1 to rightBars by 1
            if src[rightBars] > src[rightBars - i]
                isPivot := false
                isPivot
        pl := isPivot ? src[rightBars] : na
        pl
    pl
// Normalize `adj` onto the scale of `base` using OLS over `length` bars.
// Returns the implied/normalized series: alpha + beta * adj
export normalize(series float adj, series float base, int length) =>
    float sumX   = math.sum(adj, length)
    float sumY   = math.sum(base, length)
    float sumXY  = math.sum(adj * base, length)
    float sumX2  = math.sum(adj * adj, length)
    float meanX  = sumX / length
    float meanY  = sumY / length
    float den    = sumX2 - (sumX * sumX) / length
    bool enough  = bar_index >= length - 1
    float beta   = enough and den != 0 ? (sumXY - (sumX * sumY) / length) / den : na
    float alpha  = enough and not na(beta) ? (meanY - beta * meanX) : na
    float mapped = enough and not na(alpha) and not na(beta) ? (alpha + beta * adj) : na
    mapped

//@version=5

// Export your original Pearson R vs fitted linear regression
export pearsonR(float srcSeries, int length) =>
    var float r    = na
    var float sumX = 0.0
    var float sumY = 0.0
    var float sumXY = 0.0
    var float sumX2 = 0.0
    var float sumY2 = 0.0

    if bar_index >= length
        sumX := 0.0
        sumY := 0.0
        sumXY := 0.0
        sumX2 := 0.0
        sumY2 := 0.0
        for i = 0 to length - 1
            x = i
            y = srcSeries[i]
            sumX  += x
            sumY  += y
            sumXY += x * y
            sumX2 += x * x
            sumY2 += y * y
        meanX = sumX / length
        meanY = sumY / length
        covXY = sumXY - length * meanX * meanY
        varX  = sumX2 - length * meanX * meanX
        varY  = sumY2 - length * meanY * meanY
        denom = math.sqrt(varX * varY)
        r := denom != 0 ? covXY / denom : na
    r
