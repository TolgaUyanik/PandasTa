//@version=6
// @description A library for drawing customizable session boxes on charts. Predefined sessions include Asia, London, and New York. Supports custom session creation with adjustable time, color, and border properties.
library('SessionBox', overlay = true)


// @function Determines if the current bar falls within the specified session time and time zone.
// @param sessionTime (string) - The session time range in "HHMM-HHMM" format.
// @param sessionTimeZone (string) - The session's time zone (default: "GMT+0").
// @returns (bool) - True if the current bar is within the session, false otherwise.
isInSession(string sessionTime, string sessionTimeZone = 'GMT+0') =>
    not na(time(timeframe.period, sessionTime, sessionTimeZone))


// @function Draws a custom session box with specified parameters.
// @param sessionName (string) - Name of the session (default: "").
// @param sessionTime (string) - The session time range in "HHMM-HHMM" format.
// @param sessionZone (string) - The session's time zone (default: "GMT+0").
// @param boxColor (color) - The color of the session box (default: color.blue).
// @param boxBorderSize (int) - The thickness of the box border (default: 2).
export drawSessionBox(string sessionName = '', string sessionTime, string sessionZone = 'GMT+0', color boxColor = color.blue, int boxBorderSize = 2) =>
    var float sessionHighPrice = na
    var float sessionLowPrice = na
    var box sessionBox = na
    var label sessionLabel = na
    var int anchor = na

    // Check session status
    bool inSession = isInSession(sessionTime, sessionZone) and timeframe.isintraday
    bool sessionStart = inSession and not inSession[1]

    if sessionStart
        // Initialize session values and create a new box
        sessionHighPrice := high
        sessionLowPrice := low
        anchor := time
        sessionBox := box.new(left = bar_index, top = high, right = bar_index + 1, bottom = low, border_width = boxBorderSize, bgcolor = color.new(boxColor, 80), border_color = color.new(boxColor, 100))
        sessionLabel := label.new(anchor, sessionHighPrice, sessionName, xloc = xloc.bar_time, color = color.new(color.white, 100), textcolor = boxColor, size = size.tiny)
        sessionLabel
    if inSession
        // Update box dimensions dynamically
        sessionHighPrice := math.max(sessionHighPrice, high)
        sessionLowPrice := math.min(sessionLowPrice, low)
        box.set_top(sessionBox, sessionHighPrice)
        box.set_bottom(sessionBox, sessionLowPrice)
        box.set_right(sessionBox, bar_index + 1)
        label.set_x(sessionLabel, int(math.avg(anchor, time)))
        label.set_y(sessionLabel, sessionHighPrice)


// @function Draws a session box for the Asian session with default or customized parameters.
// @param sessionTime (string) - The session time range (default: "0000-0900").
// @param sessionZone (string) - The session's time zone (default: "GMT+0").
// @param boxColor (color) - The color of the session box (default: color.green).
// @param boxBorderSize (int) - The thickness of the box border (default: 2).
export drawAsiaSession(string sessionTime = '0000-0900', string sessionZone = 'GMT+0', color boxColor = color.green, int boxBorderSize = 2) =>
    drawSessionBox('Asia', sessionTime, sessionZone, boxColor, boxBorderSize)


// @function Draws a session box for the London session with default or customized parameters.
// @param sessionTime (string) - The session time range (default: "0700-1600").
// @param sessionZone (string) - The session's time zone (default: "GMT+0").
// @param boxColor (color) - The color of the session box (default: color.blue).
// @param boxBorderSize (int) - The thickness of the box border (default: 2).
export drawLondonSession(string sessionTime = '0700-1600', string sessionZone = 'GMT+0', color boxColor = color.blue, int boxBorderSize = 2) =>
    drawSessionBox('London', sessionTime, sessionZone, boxColor, boxBorderSize)


// @function Draws a session box for the New York session with default or customized parameters.
// @param sessionTime (string) - The session time range (default: "1300-2200").
// @param sessionZone (string) - The session's time zone (default: "GMT+0").
// @param boxColor (color) - The color of the session box (default: color.purple).
// @param boxBorderSize (int) - The thickness of the box border (default: 2).
export drawNewYorkSession(string sessionTime = '1300-2200', string sessionZone = 'GMT+0', color boxColor = color.purple, int boxBorderSize = 2) =>
    drawSessionBox('New York', sessionTime, sessionZone, boxColor, boxBorderSize)

