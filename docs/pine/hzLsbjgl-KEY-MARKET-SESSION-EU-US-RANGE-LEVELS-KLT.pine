//@version=6
indicator("Key Market Session EU/US Range Levels - KLT", overlay=true)
//Copyright by KEY LEVELS TRADING V1.0

// === DATA ===
currentYear = year(time)
currentMonth = month(time)
currentDay = dayofmonth(time)

// === ORARI SESSIONI (UTC) ===
startEU = timestamp("UTC", currentYear, currentMonth, currentDay, 8, 0)
endEU   = timestamp("UTC", currentYear, currentMonth, currentDay, 14, 0)

startUS = timestamp("UTC", currentYear, currentMonth, currentDay, 14, 30)
endUS   = timestamp("UTC", currentYear, currentMonth, currentDay, 21, 0)

// === VARIABILI MASSIMI/MINIMI SESSIONE ATTUALE ===
var float euHigh = na
var float euLow = na
var float usHigh = na
var float usLow = na

// === VARIABILI SESSIONE PRECEDENTE ===
var float euHighPrev = na
var float euLowPrev = na
var float usHighPrev = na
var float usLowPrev = na

// === VARIABILI PER LIVELLI OB/OS SALVATI ===
var float euObLast = na
var float euOsLast = na
var float usObLast = na
var float usOsLast = na

// === RICONOSCIMENTO NUOVA SESSIONE ===
newSessionEU = (time >= startEU and time < endEU) and (time[1] < startEU)
newSessionUS = (time >= startUS and time < endUS) and (time[1] < startUS)

// === AGGIORNA HIGH/LOW E SALVA PRECEDENTI ===
if newSessionEU
    euHighPrev := euHigh
    euLowPrev := euLow
    euHigh := high
    euLow := low
else if time >= startEU and time < endEU
    euHigh := math.max(euHigh, high)
    euLow := math.min(euLow, low)

if newSessionUS
    usHighPrev := usHigh
    usLowPrev := usLow
    usHigh := high
    usLow := low
else if time >= startUS and time < endUS
    usHigh := math.max(usHigh, high)
    usLow := math.min(usLow, low)

// === SESSIONI ATTIVE ===
isEU = time >= startEU and time < endEU
isUS = time >= startUS and time < endUS

// === CALCOLO LIVELLI OB/OS CORRENTI ===
highSession = isEU ? euHigh : isUS ? usHigh : na
lowSession  = isEU ? euLow  : isUS ? usLow  : na

obLevel = highSession * 0.995
osLevel = lowSession  * 1.005

ob = close >= obLevel
os = close <= osLevel

// === SALVA LIVELLI OB/OS AL TERMINE DELLA SESSIONE ===
endEUCond = time[1] < endEU and time >= endEU
if endEUCond
    euObLast := euHigh * 0.995
    euOsLast := euLow  * 1.005

endUSCond = time[1] < endUS and time >= endUS
if endUSCond
    usObLast := usHigh * 0.995
    usOsLast := usLow  * 1.005

// === COLORI ===
colorHigh = isEU ? color.orange : isUS ? color.aqua : na
colorLow  = isEU ? color.fuchsia : isUS ? color.teal : na
colorOB   = isEU ? color.orange : isUS ? color.lime : na
colorOS   = isEU ? color.orange : isUS ? color.lime : na

// === PLOT LIVELLI ATTUALI HIGH/LOW + OB/OS ===
//plot(highSession, title="Session High", color=colorHigh, linewidth=1, style=plot.style_line)
//plot(lowSession,  title="Session Low",  color=colorLow, linewidth=1, style=plot.style_line)
plot(ob ? obLevel : na, title="Overbought Level", color=colorOB, linewidth=2, style=plot.style_linebr)
plot(os ? osLevel : na, title="Oversold Level",  color=colorOS, linewidth=2, style=plot.style_linebr)

// === PLOT HIGH/LOW DELLA SESSIONE PRECEDENTE ===
plot(isEU and not na(euHighPrev) ? euHighPrev : na, title="EU High Prev", color=color.orange, linewidth=1, style=plot.style_circles)
plot(isEU and not na(euLowPrev)  ? euLowPrev  : na, title="EU Low Prev",  color=color.fuchsia, linewidth=1, style=plot.style_circles)

plot(isUS and not na(usHighPrev) ? usHighPrev : na, title="US High Prev", color=color.aqua, linewidth=1, style=plot.style_circles)
plot(isUS and not na(usLowPrev)  ? usLowPrev  : na, title="US Low Prev",  color=color.teal, linewidth=1, style=plot.style_circles)

// === PLOT OB/OS SESSIONE PRECEDENTE (CROCI) DURANTE SESSIONE OPPOSTA ===
plot(isUS and not na(euObLast) ? euObLast : na, title="EU OB Prev", color=color.white, style=plot.style_cross, linewidth=2)
plot(isUS and not na(euOsLast) ? euOsLast : na, title="EU OS Prev", color=color.white, style=plot.style_cross, linewidth=2)

plot(isEU and not na(usObLast) ? usObLast : na, title="US OB Prev", color=color.white, style=plot.style_cross, linewidth=2)
plot(isEU and not na(usOsLast) ? usOsLast : na, title="US OS Prev", color=color.white, style=plot.style_cross, linewidth=2)

