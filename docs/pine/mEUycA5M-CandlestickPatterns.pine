// Shooting Star Pattern Detection
export checkShootingStarPattern(float open, float high, float low, float close, float bodyAvg, float shadowFactor, bool upTrend) =>
    body = bodySize(0)
    bodyHi = math.max(close, open)
    bodyLo = math.min(close, open)
    smallBody = body < bodyAvg
    
    upWick = UpperWickRange(0)
    lowWick = LowerWickRange(0)
    
    verySmallBodyLowerWickAcceptable = lowWick - body < bodyAvg - body and upWick > (bodyAvg - body) * shadowFactor
    isLowerWickAcceptable = lowWick <= body or verySmallBodyLowerWickAcceptable
    isUpperWickSignificantlyLarger = body * shadowFactor <= upWick
    isSmallBodyBelowMidpoint = smallBody and body > 0 and bodyHi < (high + low) / 2
    
    shooting_star = upTrend and isSmallBodyBelowMidpoint and isLowerWickAcceptable and isUpperWickSignificantlyLarger

    shooting_star

// Helper function for checking levels
export checkLevels(float high0, float high1, float high2, float low0, float low1, float low2, int lookbackPeriod) =>
    highestLevel = ta.highest(lookbackPeriod)
    lowestLevel = ta.lowest(lookbackPeriod)
    highFilter = math.max(high0, high1, high2) >= highestLevel
    lowFilter = math.min(low0, low1, low2) <= lowestLevel
    [highFilter, lowFilter]
