    verySmallBodyUpperWickAcceptable = upWick - body < bodyAvg - body and lowWick > (bodyAvg - body) * shadowFactor
    isUpperWickAcceptable = upWick <= body or verySmallBodyUpperWickAcceptable
    isLowerWickSignificantlyLarger = body * shadowFactor <= lowWick
    isSmallBodyAboveMidpoint = smallBody and body > 0 and bodyLo > (high + low) / 2
    
    hanging_man = upTrend and isSmallBodyAboveMidpoint and isUpperWickAcceptable and isLowerWickSignificantlyLarger

