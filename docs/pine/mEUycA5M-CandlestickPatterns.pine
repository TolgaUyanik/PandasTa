//@version=5
library("CandlestickPatterns", overlay=true)

// Function to calculate body size
bodySize(int i) => math.abs(close[i] - open[i])

// Returns the bar's upper wick range
UpperWickRange(int i) =>
    high - math.max(open[i], close[i])

// Returns the bar's lower wick range
LowerWickRange(int i) =>
    math.min(open[i], close[i]) - low

// ---------------------
// ZigZag Detection
// ---------------------
export zigzag (float _low, float _high, int depth, int deviation, int backstep) =>
    hr = ta.barssince(not (_high[-ta.highestbars(depth)] - _high > deviation*syminfo.mintick)[1])
    lr = ta.barssince(not (_low - _low[-ta.lowestbars(depth)] > deviation*syminfo.mintick)[1])
    trend_direction = ta.barssince(not (hr > lr)) >= backstep? -1: 1

    zz_downtrend = trend_direction < 0 ? true: false
    zz_uptrend = trend_direction > 0 ? true: false

    var chart.point z = chart.point.now(_low)
    var chart.point z1 = chart.point.now(_low)
    var chart.point z2 = chart.point.now(_high)

    if ta.change(trend_direction)
        z1 := z2.copy()
        z2 := z.copy()

    if zz_uptrend
        if  _high > z2.price
            z2 := chart.point.now(_high)
            z := chart.point.now(_low)
        if _low < z.price
            z := chart.point.now(_low)

    if zz_downtrend
        if _low < z2.price
            z2 := chart.point.now(_low)
            z := chart.point.now(_high)
        if _high > z.price
            z := chart.point.now(_high)

    [trend_direction, z1, z2]

// ---------------------
// Trend Detection
// ---------------------
export getTrend(string trendType, float currentClose, bool zz_downtrend, bool zz_uptrend, float ema14, float ema28) =>
    bool downTrend = true
    bool upTrend = true

    if trendType == "ZigZag"
        downTrend := zz_downtrend
        upTrend := zz_uptrend
    
    if trendType == "SMA50"
        priceAvg = ta.sma(currentClose, 50)
        downTrend := currentClose < priceAvg
        upTrend := currentClose > priceAvg
    
    if trendType == "SMA50, SMA200"
        sma200 = ta.sma(currentClose, 200)
        sma50 = ta.sma(currentClose, 50)
        downTrend := currentClose < sma50 and sma50 < sma200
        upTrend := currentClose > sma50 and sma50 > sma200
    
    if trendType == "SMA50, ZigZag"
        priceAvg = ta.sma(currentClose, 50)
        downTrend := currentClose < priceAvg and zz_downtrend
        upTrend := currentClose > priceAvg and zz_uptrend
    
    if trendType == "SMA50, SMA200, ZigZag"
        sma200 = ta.sma(currentClose, 200)
        sma50 = ta.sma(currentClose, 50)
        downTrend := currentClose < sma50 and sma50 < sma200  and zz_downtrend
        upTrend := currentClose > sma50 and sma50 > sma200 and zz_uptrend
    
    if trendType == "EMA14"
        downTrend := currentClose < ema14
        upTrend := currentClose > ema14
    
    if trendType == "EMA14, EMA28"
        downTrend := currentClose < ema14 and ema14 < ema28
        upTrend := currentClose > ema14 and ema14 > ema28
    
    if trendType == "EMA14, ZigZag"
        priceAvg = ta.ema(currentClose, 50)
        downTrend := currentClose < priceAvg and zz_downtrend
        upTrend := currentClose > priceAvg and zz_uptrend
    
    if trendType == "EMA14, EMA28, ZigZag"
        downTrend := currentClose < ema14 and ema14 < ema28  and zz_downtrend
        upTrend := currentClose > ema14 and ema14 > ema28 and zz_uptrend

    [downTrend, upTrend]


// ---------------------
// Inside Bar Detection
// ---------------------
export isInside(float currentHigh, float currentLow, float currentClose, float currentOpen, float prevHigh, float prevLow) =>
    inside_pattern = currentHigh < prevHigh and currentLow > prevLow
    body_status = currentClose >= currentOpen ? 1 : -1
    [inside_pattern, inside_pattern ? body_status : 0]

// ---------------------
// Star Pattern Detection
// ---------------------
export checkMorningStar( float open0, float high0, float low0, float close0, float open1, float high1, float low1, float close1, float open2, float high2, float low2, float close2, float innerCandleThreshold, float closingMinThreshold, float closingMaxThreshold, bool useDojiFilter, float dojiSize, bool downTrend) =>
    doji_condition = true
    if useDojiFilter
        isDoji1 = math.abs(open1 - close1) <= (high1 - low1) * dojiSize
        isDoji0 = math.abs(open0 - close0) <= (high0 - low0) * dojiSize
        isDoji2 = math.abs(open2 - close2) <= (high2 - low2) * dojiSize
        doji_condition := isDoji1 and not isDoji0 and not isDoji2

    bar = math.abs(open0 - close0)
    bar_1 = math.abs(open1 - close1)
    bar_2 = math.abs(open2 - close2)

    innerCandleEngulfing = bodySize(1) <= innerCandleThreshold * bodySize(2)
    closingCandleEngulfingMin = bodySize(0) >= closingMinThreshold * bodySize(2)
    closingCandleEngulfingMax = bodySize(0) <= closingMaxThreshold * bodySize(2)

    morning_star = downTrend and 
                  bar > bar_1 and 
                  bar_2 > bar_1 and 
                  close0 > close1 and 
                  close0 > open1 and 
                  open2 > close1 and 
                  bar > (bar_2 * 0.5) and 
                  innerCandleEngulfing and 
                  closingCandleEngulfingMin and 
                  closingCandleEngulfingMax and
                  doji_condition

    morning_star

// Evening Star Pattern
export checkEveningStar(float open0, float high0, float low0, float close0, float open1, float high1, float low1, float close1, float open2, float high2, float low2, float close2, float innerCandleThreshold, float closingMinThreshold, float closingMaxThreshold, bool useDojiFilter, float dojiSize, bool upTrend) =>
    doji_condition = true
    if useDojiFilter
        isDoji1 = math.abs(open1 - close1) <= (high1 - low1) * dojiSize
        isDoji0 = math.abs(open0 - close0) <= (high0 - low0) * dojiSize
        isDoji2 = math.abs(open2 - close2) <= (high2 - low2) * dojiSize
        doji_condition := isDoji1 and not isDoji0 and not isDoji2

    bar = math.abs(open0 - close0)
    bar_1 = math.abs(open1 - close1)
    bar_2 = math.abs(open2 - close2)

    innerCandleEngulfing = bodySize(1) <= innerCandleThreshold * bodySize(2)
    closingCandleEngulfingMin = bodySize(0) >= closingMinThreshold * bodySize(2)
    closingCandleEngulfingMax = bodySize(0) <= closingMaxThreshold * bodySize(2)

    evening_star = upTrend and 
                  bar > bar_1 and 
                  bar_2 > bar_1 and 
                  close0 < close1 and 
                  close0 < open1 and 
                  open2 < close1 and 
                  bar > (bar_2 * 0.5) and 
                  innerCandleEngulfing and 
                  closingCandleEngulfingMin and 
                  closingCandleEngulfingMax and
                  doji_condition

    evening_star

// Hammer Pattern Detection
export checkHammerPattern(float open, float high, float low, float close, float bodyAvg, float shadowFactor, bool downTrend) =>
    body = bodySize(0)
    bodyHi = math.max(close, open)
    bodyLo = math.min(close, open)
    smallBody = body < bodyAvg
    
    upWick = UpperWickRange(0)
    lowWick = LowerWickRange(0)
    
    verySmallBodyUpperWickAcceptable = upWick - body < bodyAvg - body and lowWick > (bodyAvg - body) * shadowFactor
    isUpperWickAcceptable = upWick <= body or verySmallBodyUpperWickAcceptable
    isLowerWickSignificantlyLarger = body * shadowFactor <= lowWick
    isSmallBodyAboveMidpoint = smallBody and body > 0 and bodyLo > (high + low) / 2
    
    hammer = downTrend and isSmallBodyAboveMidpoint and isUpperWickAcceptable and isLowerWickSignificantlyLarger

    hammer

// Inverted Hammer Pattern Detection
export checkInvertedHammerPattern(float open, float high, float low, float close, float bodyAvg, float shadowFactor, bool downTrend) =>
    body = bodySize(0)
    bodyHi = math.max(close, open)
    bodyLo = math.min(close, open)
    smallBody = body < bodyAvg
    
    upWick = UpperWickRange(0)
    lowWick = LowerWickRange(0)
    
    verySmallBodyLowerWickAcceptable = lowWick - body < bodyAvg - body and upWick > (bodyAvg - body) * shadowFactor
    isLowerWickAcceptable = lowWick <= body or verySmallBodyLowerWickAcceptable
    isUpperWickSignificantlyLarger = body * shadowFactor <= upWick
    isSmallBodyBelowMidpoint = smallBody and body > 0 and bodyHi < (high + low) / 2
    
    inverted_hammer = downTrend and isSmallBodyBelowMidpoint and isLowerWickAcceptable and isUpperWickSignificantlyLarger

    inverted_hammer

// Hanging Man Pattern Detection
export checkHangingManPattern(float open, float high, float low, float close, float bodyAvg, float shadowFactor, bool upTrend) =>
    body = bodySize(0)
    bodyHi = math.max(close, open)
    bodyLo = math.min(close, open)
