//@version=6
indicator("NSE Pro Emotion Scanner: Fear & Greed Structural Identifier", overlay=true, max_labels_count=500)

// =========================================================================
// 1. MOVING AVERAGE SETTINGS
// =========================================================================
grp_ma    = "Moving Average Settings"
maLength  = input.int(50, title="MA Period", group=grp_ma, tooltip="Trend baseline length")
maColor   = input.color(color.new(color.blue, 0), title="MA Line Color", group=grp_ma)
maWidth   = input.int(2, title="MA Line Width", minval=1, maxval=5, group=grp_ma)

// =========================================================================
// 2. VOLUME & LIQUIDITY SETTINGS
// =========================================================================
grp_vol   = "Volume Settings (NSE Adaptive)"
volLength = input.int(20, title="Volume MA Length", group=grp_vol)
volMult   = input.float(1.5, title="Volume Climax Multiplier", step=0.1, group=grp_vol)

// =========================================================================
// 3. CANDLESTICK EMOTION SETTINGS
// =========================================================================
grp_wicks = "Candlestick Emotion Settings"
wickRatio = input.float(2.0, title="Wick to Body Ratio (Reversals)", step=0.5, group=grp_wicks)
dojiSize  = input.float(0.05, title="Doji Max Body Size (%)", step=0.01, group=grp_wicks)

// =========================================================================
// 4. VISUAL & LABEL SETTINGS
// =========================================================================
grp_vis   = "Visual Presentation Settings"
fearCol   = input.color(color.new(color.teal, 10), title="Fear (BUY) Label Color", group=grp_vis)
greedCol  = input.color(color.new(color.maroon, 10), title="Greed (SELL) Label Color", group=grp_vis)

// =========================================================================
// 5. CORE CALCULATIONS
// =========================================================================
// Moving Average
maLine = ta.sma(close, maLength)
plot(maLine, title="Trend MA", color=maColor, linewidth=maWidth)

// Volume Baseline
avgVol = ta.sma(volume, volLength)
isHighVolume = volume > (avgVol * volMult)

// Candlestick Anatomy
bodySize = math.abs(close - open)
candleRange = high - low
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

// =========================================================================
// 6. EMOTIONAL SIGNATURE LOGIC
// =========================================================================
// FEAR (Capitulation signatures like Hammers or Bullish Engulfing)
isHammer = (lowerWick >= (bodySize * wickRatio)) and (upperWick <= bodySize) and (candleRange > 0)
isBullEngulfing = (close > open) and (open <= close[1]) and (close >= open[1]) and (close[1] < open[1])
fearSignal = isHighVolume and (isHammer or isBullEngulfing)

// GREED (Euphoria signatures like Shooting Stars or Bearish Engulfing)
isShootingStar = (upperWick >= (bodySize * wickRatio)) and (lowerWick <= bodySize) and (candleRange > 0)
isBearEngulfing = (close < open) and (open >= close[1]) and (close <= open[1]) and (close[1] > open[1])
greedSignal = isHighVolume and (isShootingStar or isBearEngulfing)

// INDECISION (Doji)
isDoji = bodySize <= (candleRange * dojiSize)

// =========================================================================
// 7. VISUAL ALERTS & PLOTTING
// =========================================================================
// FEAR / BUY labels (Plotted below the bar, pointing up with a constant size)
plotshape(fearSignal, title="Fear / BUY Signal", style=shape.labelup, location=location.belowbar, color=fearCol, text="FEAR\nBUY", textcolor=color.white, size=size.small)

// GREED / SELL labels (Plotted above the bar, pointing down with a constant size)
plotshape(greedSignal, title="Greed / SELL Signal", style=shape.labeldown, location=location.abovebar, color=greedCol, text="GREED\nSELL", textcolor=color.white, size=size.small)

// CONTINUATION FLAGS (Only print if prevailing trend aligns with the MA)
bullishContinuation = close > maLine and isHighVolume and (close > open) and not greedSignal
bearishContinuation = close < maLine and isHighVolume and (close < open) and not fearSignal

plotshape(bullishContinuation and isDoji[1], title="Bullish Trend Flag", style=shape.flag, location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(bearishContinuation and isDoji[1], title="Bearish Trend Flag", style=shape.flag, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)

