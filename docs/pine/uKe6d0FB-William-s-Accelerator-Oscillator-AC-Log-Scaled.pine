//@version=5
indicator("William's Accelerator Oscillator (AC) - Log-Scaled", shorttitle="Log AC",
         overlay = false, format = format.price, precision = 4)

// ───── INPUTS ─────
fastLen   = input.int(5,  title = "Fast SMA length (AO)")
slowLen   = input.int(34, title = "Slow SMA length (AO)")
accLen    = input.int(5,  title = "SMA length (AC)", minval = 1)
showPct   = input.bool(true, title = "Display AO/AC as % of price")

logBase = input.string(defval  = "Natural (ln)", title   = "Logarithm base", options = ["Natural (ln)", "Base-10 (log10)"])

// ───── MEDIAN PRICE → LOG SPACE ─────
medianPrice = (high + low) / 2.0
logPrice    = logBase == "Natural (ln)" ? math.log(medianPrice) : math.log10(medianPrice)

// ───── AWESOME OSCILLATOR (LOG OR %) ─────
fastMA = ta.sma(logPrice, fastLen)
slowMA = ta.sma(logPrice, slowLen)
aoLog  = fastMA - slowMA

aoPct  = (math.exp(fastMA) - math.exp(slowMA)) / math.exp(slowMA) * 100.0
ao     = showPct ? aoPct : aoLog

// ───── ACCELERATION OSCILLATOR ─────
ac = ao - ta.sma(ao, accLen)

// ───── COLOURS ─────
upCol   = color.rgb( 38,166,154)   // teal‑ish
downCol = color.rgb(239, 83,  80)  // red

// ───── PLOTS ─────


plot(ac, title = "Log AC",
     style = plot.style_histogram,
     color = ac > ac[1] ? upCol : downCol,
     linewidth = 2)

hline(0.0, title = "Zero line",
      color = color.gray, linestyle = hline.style_dotted)
