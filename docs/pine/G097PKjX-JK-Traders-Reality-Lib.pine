//Traders Reality Library
//This library contains common functions used in Traders Reality indicators and scripts.
//It allows for the consolidation of common shared logic thus making management of this shared logic
//more manageable. 

//List of functions:
// calcPvsra - Calculate the pvsra candle color and return the color as well as an alert if a vector candle has apperared.
// adr - Calculate average daily range for a given length.
// adrHigh - Calculate the ADR high given an ADR.
// adrLow - Calculate the ADR Low given an ADR.
// splitSessionString - Given a session in the format 0000-0100:23456 split out the hours and minutes for start and end times of the session. 
// calcSessionStartEnd - Calculate the start and end timestamps of the session taking into consideration gmt offsets.
// drawOpenRange - Draws a box where the width is the specific market session duration and the hight is the high/low of the first candle of the session.
// drawSessionHiLo - Draws lines for the session High and Low values, updating the lines during the session as the session high and low is being established.
// calcDst - Calculate if Sydney, London or New York market sessions are in DST or not.
// timestampPreviousDayOfWeek - Timestamp of the previous Monday or Saturday given an hour and a GMT offset. Used when plotting a weekly plot or line and do not want to use security function.
// getdayOpen - Get the daily open value without using security function.
// newBar - Determine if a new session has started based on a resolution.
// toPips - Convert value to pips.
// rLabel - Draw a right aligned label.
// rLabelOffset - Draw a right aligned label with an offset.
// rLabelLastBar - Draw a right aligned label with at the last bar.
// drawLine - Draw a line and a label with a single function call.
// drawLineDO - Draw a line and a label when a new session begins where session is simply defined by resolution.
// drawPivot - Draw a line and a label for a pivot point.
// getPvsraFlagByColor - Convert a PVSRA color to an integer custom code.
// updateZones - Update boxes representing Vector Candle Zones which are areas of presumed liquidity based on vector candles (PVRSA). 
// cleanarr - Remove all na values from an array.
// calcPsyLevels - Calculate the phycological high and low series for this week for crypto or for forex. 

//Special thanks to infernixx, peshocore, and xtech5192 for their contributions to this library.sing "Traders Reality", "Pattern Watchers" or any other name that relates to Traders Reality in any way.
//@version=6

// @description This library contains common elements used in Traders Reality scripts
library("JK_Traders_Reality_Lib")

// @function calculate the pvsra candle color and return the color as well as an alert if a vector candle has apperared.
// Situation "Climax"
// Bars with volume >= 200% of the average volume of the 10 previous chart TFs, or bars
// where the product of candle spread x candle volume is >= the highest for the 10 previous
// chart time TFs.
// Default Colors:  Bull bars are green and bear bars are red.
// Situation "Volume Rising Above Average"
// Bars with volume >= 150% of the average volume of the 10 previous chart TFs.
// Default Colors:  Bull bars are blue and bear are violet.
// @param pvsraVolume the instrument volume series (obtained from request.sequrity)
// @param pvsraHigh the instrument high series (obtained from request.sequrity)
// @param pvsraLow the instrument low series (obtained from request.sequrity)
// @param pvsraClose the instrument close series (obtained from request.sequrity)
// @param pvsraOpen the instrument open series (obtained from request.sequrity)
// @param redVectorColor red vector candle color
// @param greenVectorColor green vector candle color
// @param violetVectorColor violet/pink vector candle color
// @param blueVectorColor blue vector candle color
// @param darkGreyCandleColor regular volume candle down candle color - not a vector 
// @param lightGrayCandleColor regular volume candle up candle color - not a vector
// @return [pvsraColor, alertFlag, averageVolume, volumeSpread, highestVolumeSpread]
export calcPvsra(series float pvsraVolume, series float pvsraHigh, series float pvsraLow, series float pvsraClose, series float pvsraOpen, simple color redVectorColor, simple color greenVectorColor, simple color violetVectorColor, simple color blueVectorColor, simple color darkGreyCandleColor, simple color lightGrayCandleColor) =>
    float averageVolume = math.sum(pvsraVolume[1], 10)/10.0
    float volumeSpread = pvsraVolume*(pvsraHigh - pvsraLow)
    float highestVolumeSpread = ta.highest(volumeSpread[1], 10)
    color pvsraColor = na
    bool alertFlag = false
    
    // High volume
    if pvsraVolume >= 2*averageVolume or volumeSpread >= highestVolumeSpread
        pvsraColor := pvsraClose > pvsraOpen ? greenVectorColor : redVectorColor
        alertFlag := true
    
    // Medium volume
    else if pvsraVolume >= 1.5*averageVolume
        pvsraColor := pvsraClose > pvsraOpen ? blueVectorColor : violetVectorColor
        alertFlag := true
    
    // Low volume
    else
        pvsraColor := pvsraClose > pvsraOpen ? lightGrayCandleColor : darkGreyCandleColor
        alertFlag := false
    [pvsraColor, alertFlag, averageVolume, volumeSpread, highestVolumeSpread]
    

// @fucntion Calculate average daily range for a given length
// @param length how many elements of the series to calculate on
// @param barsBack starting possition for the length calculation - current bar or some other value eg last bar
// @return adr the adr for the specified lenght
export adr(simple int length, simple int barsBack) =>
    // This is effectively an atr, which is what is used in MT4 to get those levels. FWIW, true range can be also calculated with tr(true)
    trueRange = na(high[1]) ? high - low : math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
    // Switched to SMA from RMA because somehow it matches MT4 better
    ta.sma(trueRange[barsBack], length)
    
    

// @function Calculate the ADR high given an ADR
// @param adr the adr
// @param fromDo boolean flag, if false calculate traditional adr from high low of today, if true calcualte from exchange midnight
// @return adrHigh the position of the adr high in price
export adrHigh(series float adr, simple bool fromDo) =>
    retVal = 0.0
    if not fromDo
        retVal := high - low < adr ? low + adr : close >= open ? low + adr : high
    else
        retVal := open + adr
    retVal

// @fucntion Calculate the ADR Low given an ADR
// @param adr the adr
// @param fromDo boolean flag, if false calculate traditional adr from high low of today, if true calcualte from exchange midnight
// @return adrLow the position of the adr low in price
export adrLow(series float adr, simple bool fromDo) =>
    retVal = 0.0
    if not fromDo
        retVal := high - low < adr ? high - adr : close >= open ? low : high - adr
    else
        retVal := open - adr
    retVal   

// @function given a session in the format 0000-0100:23456 split out the hours and minutes 
// @param sessXTime the session time string usually in the format 0000-0100:23456
// @return [startHour, startMin, endHour, endMin]
export splitSessionString(simple string sessXTime) =>
    //session stirng looks like this: 0000-0000:1234567 ie start time, end time, day of the week
    //we need to parse the sessXTime string into hours and min for start and end times so we can use those in the timestampfunction below

    //string times contains "0000-2300" as an example
    string times = array.get(str.split(sessXTime, ':'), 0)

    //string startTime contains "0000"
    string startTime = array.get(str.split(times, '-'), 0)
    //string endTime contains "2300"
    string endTime = array.get(str.split(times, '-'), 1)

    //now we need to get the start hour and start min, sing 0 index - hour is the characters in index 0 and index 1 while min is the chars at index 2 and 3
    string[] startTimeChars = str.split(startTime, '')
    string[] endTimeChars = str.split(endTime, '')

    //so now startHour contains 00 and start min contains 00
    string startHour = array.get(startTimeChars, 0) + array.get(startTimeChars, 1)
    string startMin = array.get(startTimeChars, 2) + array.get(startTimeChars, 3)

    //so now endHour contains 23 and end min contains 00
    string endHour = array.get(endTimeChars, 0) + array.get(endTimeChars, 1)
    string endMin = array.get(endTimeChars, 2) + array.get(endTimeChars, 3)
    [startHour, startMin, endHour, endMin]

// @function calculate the start and end timestamps of the session
// @param sessXTime the session time string usually in the format 0000-0100:23456 
// @param gmt the gmt offset string usually in the format GMT+1 or GMT+2 etc
// @return [targetstartTimeX,targetendTimeX]
export calcSessionStartEnd(simple string sessXTime, simple string gmt) =>
    [startHour, startMin, endHour, endMin] = splitSessionString(sessXTime)
    targetstartTimeX = timestamp(gmt, year, month, dayofmonth, math.round(str.tonumber(startHour)), math.round(str.tonumber(startMin)), 00)
    targetendTimeX = timestamp(gmt, year, month, dayofmonth, math.round(str.tonumber(endHour)), math.round(str.tonumber(endMin)), 00)
    time_now = timestamp(year, month, dayofmonth, hour, minute, 00) 
    midnight_exchange = timestamp(year, month, dayofmonth, 00, 00, 00)  
    int oneDay = 24 * 60 * 60 * 1000

    //if start hour is greater than end hour we are dealing with a session that starts towards the end of one day 
    //and ends the next day. ie advance the end time by 24 hours - its the next day
    bool adjusted = false
    if gmt == 'GMT+0'
        if math.round(str.tonumber(startHour)) > math.round(str.tonumber(endHour))
            if time_now - targetstartTimeX >= 0
                targetendTimeX := targetendTimeX + oneDay
                adjusted := true
                targetendTimeX
    if gmt == 'GMT+1'
        if math.round(str.tonumber(startHour)) == 0
            startHour := '24'
        if math.round(str.tonumber(endHour)) == 0
            endHour := '24'    
        if math.round(str.tonumber(startHour))-1 > math.round(str.tonumber(endHour))-1
            if time_now - targetstartTimeX >= 0
                targetendTimeX := targetendTimeX + oneDay
                adjusted := true
                targetendTimeX
    
    //now is the exchange is at some utc offset and the market session crosses days even when start hour is not greater than end hour
    //we still need to adjust the end time. 
    
    if targetstartTimeX < midnight_exchange and midnight_exchange < targetendTimeX and not adjusted
        targetendTimeX := targetendTimeX + oneDay
        targetendTimeX                
            
    [targetstartTimeX,targetendTimeX]
    

// @function draw open range for a session 
// @param sessXTime session string in the format 0000-0100:23456 
// @param sessXcol the color to be used for the opening range box shading
// @param showOrX boolean flag to toggle displaying the opening range
// @param gmt the gmt offset string usually in the format GMT+1 or GMT+2 etc
// @return void
export drawOpenRange(simple string sessXTime, simple color sessXcol, simple bool showOrX, simple string gmt)=>
    if showOrX
        // Initialize variables on bar zero only, so they preserve their values across bars.
        var hi = float(na)
        var lo = float(na)
        var box hiLoBox = na
        // Detect changes in timeframe.
        session = time(timeframe.period, sessXTime, gmt)
        bool newTF = not na(session) and na(session[1])
        if newTF
            // New bar in higher timeframe; reset values and create new lines and box.
            [targetstartTimeX,targetendTimeX] = calcSessionStartEnd(sessXTime, gmt)
            sessionDuration = math.round(math.abs(time  - targetendTimeX)/(timeframe.multiplier*60*1000))
   
            hi := high
            lo := low
            hiLoBox := box.new(bar_index, hi, timeframe.multiplier == 1? bar_index : bar_index+sessionDuration, lo, border_color = na, bgcolor = sessXcol)
            int(na)
        else
            if timeframe.multiplier == 1 and (na(session[1]) and not na(session) or session[1] < session)
                box.set_right(hiLoBox, bar_index+1)
            int(na)

// @fucntion draw the session high and low lines based on the sessions high and low - dynamically updated. includes the session label
// @param sessXTime session string in the format 0000-0100:23456 
// @param show_rectangleX show the session high and low lines 
// @param show_labelX show the session label
// @param sessXcolLabel the color to be used for the hi/low lines and label
// @param sessXLabel the session label text
// @param gmt the gmt offset string usually in the format GMT+1 or GMT+2 etc
// @param sessionLineStyle the line stile for the session high low lines 
// @return void 
export drawSessionHiLo(simple string sessXTime, simple bool showRectangleX, simple bool showLabelX, simple color sessXcolLabel, simple string sessXLabel, simple string gmt, simple string sessionLineStyle)=>
    if showRectangleX
        // Initialize variables on bar zero only, so they preserve their values across bars.
        var hi = float(0)
        var lo = float(10000000000.0)
       
        var line lineT = na
        var line lineB = na
        var label lineLabel = na
        // var box hiLoBox = na
        // Detect changes in timeframe.
        session = time(timeframe.period, sessXTime, gmt)
        sessLineStyleX = sessionLineStyle == 'Solid' ? line.style_solid : line.style_dashed
        bool newTF = not na(session) and na(session[1])
        hi := newTF ? high : not na(session) ? math.max(high, hi[1]) : hi[1]
        lo := newTF ? low : not na(session) ? math.min(low, lo[1]) : lo[1]
          
        if newTF
            beginIndex = bar_index 
            [targetstartTimeX,targetendTimeX] = calcSessionStartEnd(sessXTime, gmt)
            sessionDuration = math.round(math.abs(time  - targetendTimeX)/(timeframe.multiplier*60*1000))
        
            lineT := line.new(beginIndex, hi, timeframe.multiplier == 1? bar_index : bar_index+sessionDuration, hi, xloc=xloc.bar_index, style=sessLineStyleX, color=sessXcolLabel)
            lineB := line.new(beginIndex, lo, timeframe.multiplier == 1? bar_index : bar_index+sessionDuration, lo, xloc=xloc.bar_index, style=sessLineStyleX, color=sessXcolLabel)
            line.delete(lineT[1])
            line.delete(lineB[1])
            if showLabelX
                lineLabel := label.new(beginIndex, hi, sessXLabel, xloc=xloc.bar_index, textcolor=sessXcolLabel, style=label.style_none, size=size.normal, textalign=text.align_right)
                label.delete(lineLabel[1])
  
            int(na)
        else
            if na(session[1]) and not na(session) or session[1] < session
                if timeframe.multiplier == 1
                    line.set_x2(lineT,bar_index+1)
                    line.set_x2(lineB,bar_index+1)
                line.set_y1(lineT,hi)
                line.set_y2(lineT,hi)
                line.set_y1(lineB,lo)
                line.set_y2(lineB,lo)
                if showLabelX and not na(lineLabel)
                    label.set_y(lineLabel, hi)
            int(na)

// @function calculate market session dst on/off flags 
// @return [nyDST, ukDST, sydDST] indicating if DST is on or off for a particular region
export calcDst()=>
    int previousSunday = dayofmonth - dayofweek + 1
    bool nyDST = false
    bool ukDST = false
    bool sydDST = false
    
    if month < 3 or month > 11
        nyDST := false
        ukDST := false
        sydDST := true
    else if month > 4 and month < 10
        nyDST := true
        ukDST := true
        sydDST := false
    else if month == 3
        nyDST := previousSunday >= 8
        ukDST := previousSunday >= 24
        sydDST := true
    else if month == 4
        nyDST := true
        ukDST := true
        sydDST := previousSunday <= 0
    else if month == 10
        nyDST := true
        ukDST := previousSunday <= 24
        sydDST := previousSunday >= 0
    else // month == 11
        nyDST := previousSunday <= 0
        ukDST := false
        sydDST := true
    [nyDST, ukDST, sydDST]
    
// @function  Timestamp any of the 6 previous days in the week (such as last Wednesday at 21 hours GMT)
// @param previousDayOfWeek Monday or Satruday
// @param hourOfDay the hour of the day when psy calc is to start
// @param gmtOffset the gmt offset string usually in the format GMT+1 or GMT+2 etc
// @param oneWeekMillis the amount if time for a week in milliseconds
// @return the timestamp of the psy level calculation start time
export timestampPreviousDayOfWeek(simple string previousDayOfWeek, simple int hourOfDay, simple string gmtOffset, simple int oneWeekMillis) =>
    int dayofweekOffset = na
    int previousDayOfMonth = na
    int psySessionStartTime = na
    int returnValue = na
    //today we onlu care about Monday - forec and Saturday for crypto - if that changes in the future this code will need to be updated
    if previousDayOfWeek == "Monday"
        dayofweekOffset := (dayofweek(time, gmtOffset) - 1 + 6) % 7
    
    if previousDayOfWeek == "Saturday"
        dayofweekOffset := (dayofweek(time, gmtOffset) - 1 + 1) % 7


    previousDayOfMonth := dayofmonth(time, gmtOffset) - dayofweekOffset
    
    //based on time we are on the day where the psy levels will change - now we need to determine if we are before or after the 
    //time when the psy levels will chnge
    
    //today is Saturday or Monday dayofweekOffset will be equal to zero and we are checking if the current time is before the psy level change
    //we also need to be minful of GMTOffset. using  and hourOfDay != 00 because if we switch at midnight we dont have to do anything
    if dayofweekOffset == 0 and gmtOffset == "GMT" and hourOfDay >= hour(time,gmtOffset) and hourOfDay != 00
        //even thou today is saturday we are still not past the change time - subract a week because it is not time to change yet
        returnValue := timestamp(gmtOffset, year, month, previousDayOfMonth, hourOfDay, 00, 00) - oneWeekMillis
    //same as previous but handling GMT+1
    else if dayofweekOffset == 0 and gmtOffset == "GMT+1" and hourOfDay -1 >= hour(time,gmtOffset) //and 0 != minute(time,GMTOffset)
        returnValue := timestamp(gmtOffset, year, month, previousDayOfMonth, hourOfDay, 00, 00) - oneWeekMillis
    //default - we have already switched some time ago
    else
        returnValue := timestamp(gmtOffset, year, month, previousDayOfMonth, hourOfDay, 00, 00)
    returnValue

// @function get the daily open - basically exchange midnight
// @return the daily open value which is float price 
export getdayOpen()=>
    in_sessionDly = time('D', '24x7')
    bool isDly = ta.change(time('D')) != 0//ta.change(in_sessionDly)//in_sessionDly and not in_sessionDly[1]
    var dlyOpen = float(na)
    if isDly
        dlyOpen := open
    dlyOpen
    

// @function new_bar: check if we're on a new bar within the session in a given resolution
// @param res the desired resolution
// @return true/false is a new bar for the session has started
export newBar(simple string res) =>
    ta.change(time(res)) != 0


// @function to_pips Convert value to pips
// @param val the value to convert to pips
// @return the value in pips
export toPips(series float val) =>
    pipSizeCalc = syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)
    returnVal = val/pipSizeCalc
    returnVal

//Right_Label
// @function a function that draws a right aligned lable for a series during the current bar
// @param ry series float the y coordinate of the lable
// @param rtext the text of the label
// @param rstyle the style for the lable
// @param rcolor the color for the label
// @param valid a boolean flag that allows for turning on or off a lable
// @param labelXOffset how much to offset the label from the current position
export rLabel(series float ry, simple string rtext, simple string rstyle, simple color rcolor, simple bool valid, series int labelXOffset) =>
    var label rLabel = na
    if valid and barstate.isrealtime
        rLabel := label.new(x=labelXOffset, y=ry, text=rtext, xloc=xloc.bar_time, style=rstyle, textcolor=rcolor, textalign=text.align_right)
        label.delete(rLabel[1])
    rLabel

// @function a function that draws a right aligned lable for a series during the current bar
// @param ry series float the y coordinate of the lable
// @param rtext the text of the label
// @param rstyle the style for the lable
// @param rcolor the color for the label
// @param valid a boolean flag that allows for turning on or off a lable
// @param labelXOffset how much to offset the label from the current position
export rLabelOffset(series float ry, series string rtext, simple string rstyle, simple color rcolor, simple bool valid, series int labelOffset) =>
    if valid and barstate.isrealtime
        rLabel = label.new(x=labelOffset, y=ry, text=rtext, xloc=xloc.bar_time, style=rstyle, textcolor=rcolor, textalign=text.align_right)
        label.delete(rLabel[1])

// @function a function that draws a right aligned lable for a series only on the last bar
// @param ry series float the y coordinate of the lable
// @param rtext the text of the label
// @param rstyle the style for the lable
// @param rcolor the color for the label
// @param valid a boolean flag that allows for turning on or off a lable
// @param labelXOffset how much to offset the label from the current position
export rLabelLastBar(series float ry, series string rtext, simple string rstyle, simple color rcolor, simple bool valid, series int labelXOffset) =>
    var label rLabel = na
    if valid and barstate.islast
        rLabel := label.new(x=labelXOffset, y=ry, text=rtext, xloc=xloc.bar_time, style=rstyle, textcolor=rcolor, textalign=text.align_right)
        label.delete(rLabel[1])
    rLabel


// @function a function that draws a line and a label for a series
// @param xSeries series float the y coordinate of the line/label
// @param res the desired resolution controlling when a new line will start
// @param tag the text for the lable
// @param xColor the color for the label
// @param xStyle the style for the line
// @param xWidth the width of the line
// @param xExtend extend the line
// @param isLabelValid a boolean flag that allows for turning on or off a label
// @param labelXOffset how much to offset the label from the current position
// @param validTimeFrame a boolean flag that allows for turning on or off a line drawn
export drawLine(series float xSeries, simple string res, simple string tag, simple color xColor, simple string xStyle, simple int xWidth, simple string xExtend, simple bool isLabelValid, series int xLabelOffset, simple bool validTimeFrame) =>
    var line xLine = na

    if validTimeFrame and newBar(res) //and barstate.isnew
        xLine := line.new(bar_index, xSeries, bar_index+1, xSeries, extend=xExtend, color=xColor, style=xStyle, width=xWidth)
        line.delete(xLine[1])

    if not na(xLine) and not newBar(res)//and line.get_x2(x_line) != bar_index
        line.set_x2(xLine, bar_index)
        line.set_y1(xLine,xSeries)
        line.set_y2(xLine,xSeries)

    if isLabelValid  //showADRLabels and validTimeFrame
        xLabel = label.new(xLabelOffset, xSeries, tag, xloc=xloc.bar_time, style=label.style_none, textcolor=xColor)
        label.delete(xLabel[1])


// @function a function that draws a line and a label for the daily open series
// @param xSeries series float the y coordinate of the line/label
// @param res the desired resolution controlling when a new line will start
// @param tag the text for the lable
// @param xColor the color for the label
// @param xStyle the style for the line
// @param xWidth the width of the line
// @param xExtend extend the line
// @param isLabelValid a boolean flag that allows for turning on or off a label
// @param labelXOffset how much to offset the label from the current position
// @param validTimeFrame a boolean flag that allows for turning on or off a line drawn
export drawLineDO(series float xSeries, simple string res, simple string tag, simple color xColor, simple string xStyle, simple int xWidth, simple string xExtend, simple bool isLabelValid, series int xLabelOffset, simple bool validTimeFrame) =>
    var line xLine = na

    if newBar(res) and validTimeFrame
        line.set_x2(xLine, bar_index)
        line.set_extend(xLine, extend.none)

        xLine := line.new(bar_index, xSeries, bar_index, xSeries, extend=xExtend, color=xColor, style=xStyle, width=xWidth)
        line.delete(xLine[1])

    if not na(xLine) and line.get_x2(xLine) != bar_index
        line.set_x2(xLine, bar_index)

    if isLabelValid  //showADRLabels and validTimeFrame
        xLabel = label.new(xLabelOffset, xSeries, tag, xloc=xloc.bar_time, style=label.style_none, textcolor=xColor)
        label.delete(xLabel[1])

// @function draw a pivot line - the line starts one day into the past
// @param pivotLevel series of the pivot point
// @param res the desired resolution
// @param tag the text to appear
// @param pivotColor the color of the line
// @param pivotLabelColor the color of the label
// @param pivotStyle the line style
// @param pivotWidth the line width
// @param pivotExtend extend the line
// @param isLabelValid boolean param allows to turn label on and off
// @param validTimeFrame only draw the line and label at a valid timeframe
// @param levelStart basically when to start drawing the levels
// @param pivotLabelXOffset how much to offset the label from its current postion
// @return the pivot line series        
export drawPivot(series float pivotLevel, simple string res, simple string tag, simple color pivotColor, simple color pivotLabelColor, simple string pivotStyle, simple int pivotWidth, simple string pivotExtend, simple bool isLabelValid, simple bool validTimeFrame, series int levelStart, series int pivotLabelXOffset ) =>
    var line pivotLine = na

    // Start drawing yesterday
    if validTimeFrame and newBar(res)//and barstate.isnew
        //line.set_x2(pivot_line, bar_index)
        //line.set_extend(pivot_line, extend.none)
        pivotLine := line.new(bar_index, pivotLevel, bar_index, pivotLevel, extend=pivotExtend, color=pivotColor, style=pivotStyle, width=pivotWidth)
        line.delete(pivotLine[1])
    if not na(pivotLine) and not newBar(res)//line.get_x2(pivot_line) != bar_index
        line.set_x2(pivotLine, bar_index)
        line.set_y1(pivotLine,pivotLevel)
        line.set_y2(pivotLine,pivotLevel)
    if isLabelValid  //showADRLabels and validTimeFrame
        pivotLabel = label.new(pivotLabelXOffset, pivotLevel, tag, xloc=xloc.bar_time, style=label.style_none, textcolor=pivotLabelColor, textalign=text.align_right)

        label.delete(pivotLabel[1])
    if not barstate.islast
        line.set_x2(pivotLine, x=bar_index)
    else
        line.set_xloc(pivotLine, levelStart, time_close + 1 * 86400000, xloc=xloc.bar_time)
    pivotLine

// @function convert the pvsra color to an internal code
// @param pvsraColor the calculated pvsra color
// @param redVectorColor the user defined red vector color
// @param greenVectorColor the user defined green vector color
// @param violetVectorColor the user defined violet vector color
// @param blueVectorColor the user defined blue vector color
// @param lightGrayCandleColor the user defined regular up candle color
// @return pvsra internal code 
export getPvsraFlagByColor(series color pvsraColor, simple color redVectorColor, simple color greenVectorColor, simple color violetVectorColor, simple color blueVectorColor, simple color lightGrayCandleColor) =>
    
    pvsra = if (pvsraColor == greenVectorColor)
        3
    else if (pvsraColor == redVectorColor)
        -3
    else if (pvsraColor == blueVectorColor)
        2
    else if (pvsraColor == violetVectorColor)
        -2
    else if (pvsraColor == lightGrayCandleColor)
        1
    else
        -1
    pvsra

// @function a function that draws the unrecovered vector candle zones
// @param pvsra internal code
// @param direction above or below the current pa
// @param boxArr the array containing the boxes that need to be updated
// @param maxlevels the maximum number of boxes to draw
// @param pvsraHigh the pvsra high value series
// @param pvsraLow the pvsra low value series
// @param pvsraOpen the pvsra open value series
// @param pvsraClose the pvsra close value series
// @param transperancy the transparencfy of the vecor candle zones
// @param zoneupdatetype the zone update type
// @param zonecolor the zone color if overriden
// @param zonetype the zone type
// @param borderwidth the width of the border
// @param coloroverride if the color overriden
// @param redVectorColor the user defined red vector color
// @param greenVectorColor the user defined green vector color
// @param violetVectorColor the user defined violet vector color
// @param blueVectorColor the user defined blue vector color
// @param lightGrayCandleColor the user defined regular up candle color
export updateZones(series int pvsra, simple int direction, simple box[] boxArr, simple int maxlevels, series float pvsraHigh, series float pvsraLow, series float pvsraOpen, series float pvsraClose, simple int transperancy, simple string zoneupdatetype, simple color zonecolor, simple string zonetype, simple int borderwidth, simple bool coloroverride, simple color redVectorColor, simple color greenVectorColor, simple color violetVectorColor, simple color blueVectorColor) =>
    // Get the close at the requested resolution
    levelclose = pvsraClose[1]
    levelopen = pvsraOpen[1]
    levelhigh = pvsraHigh[1]
    levellow = pvsraLow[1]
    levelChanged = levelclose != levelclose[1]
    // Get the current length of the array containing the list of levels
    length = array.size(boxArr)

    
    CUColorBG = color.new(greenVectorColor, transperancy)  // lime, Climax up (bull) bull and bear both start with b so it would be weird hence up down
    CDColorBG = color.new(redVectorColor, transperancy)  // red, Climax down (bear)
    AUColorBG = color.new(blueVectorColor, transperancy)  //blue, Avobe average up (bull)
    ADColorBG = color.new(violetVectorColor, transperancy)  //fuchsia, Above average down (bear))

    bgColor = if coloroverride
        zonecolor
    else if pvsra == 2
        AUColorBG
    else if pvsra == -2
        ADColorBG
    else if pvsra == 3
        CUColorBG
    else if pvsra == -3
        CDColorBG
    else
        na


    // direction: 1 = above current price, 0 = below current price 

    // if we have a new level and, if it is above price AND it is higher than the previous close, or if it is below price AND it is lower than the previous level, AND it isnt in the ignorelevels array
    if (pvsra[1] < -1 or pvsra[1] > 1) //and levelChanged
        // and add a line to the lines array so that it gets printed on the chart
        top = if levelclose > levelopen
            zonetype == 'Body with wicks' ? levelhigh : levelclose
        else
            zonetype == 'Body with wicks' ? levelhigh : levelopen
        bottom = if levelclose > levelopen
            zonetype == 'Body with wicks' ? levellow : levelopen
        else
            zonetype == 'Body with wicks' ? levellow : levelclose
        array.unshift(boxArr, box.new(left=bar_index[1], top=top, right=bar_index, bottom=bottom, extend=extend.right, bgcolor=bgColor[1], border_width=borderwidth, border_color=color.rgb(255, 255, 255, 80)))
        length += 1
        length


    // if we have a new level and we have a list of existing levels
    //if levelChanged and length > 0
    if length > 0
        // go through each level
        for i = 0 to length - 1 by 1
            // get its value
            valbox = array.get(boxArr, i)

            // if val and (direction == 1 ? invalidhigher > val : invalidlower < val)
            if not na(valbox)
                valbottom = box.get_bottom(valbox)
                valtop = box.get_top(valbox)
                // if we are looking at zones above current price
                if direction == 1
                    // if the current realtime close is above both box levels
                    if pvsraClose >= valtop or pvsraHigh >= valtop
                        // delete the box and delete it from the array by setting to 'na'
                        box.delete(array.get(boxArr, i))
                        array.set(boxArr, i, na)
                    // if we wicked into it but not fully recovered it, update the box price points
                    else if pvsraHigh > valbottom and pvsraHigh < valtop and zoneupdatetype == 'Body with wicks'
                        box.set_bottom(array.get(boxArr, i), pvsraHigh)
                    else if pvsraClose > valbottom and pvsraClose < valtop and zoneupdatetype == 'Body with wicks'
                        box.set_bottom(array.get(boxArr, i), pvsraClose)
                    // if the current realtime close is above both box levels
                else if direction == 0
                    if pvsraClose <= valbottom or pvsraLow <= valbottom
                        box.delete(array.get(boxArr, i))
                        //array.remove(lineArr, i)
                        array.set(boxArr, i, na)
                    // if we wicked into it but not fully recovered it, update the box price points
                    else if pvsraLow > valbottom and pvsraLow < valtop and zoneupdatetype == 'Body with wicks'
                        box.set_top(array.get(boxArr, i), pvsraLow)
                    else if pvsraClose > valbottom and pvsraClose < valtop and zoneupdatetype == 'Body with wicks'
                        box.set_top(array.get(boxArr, i), pvsraClose)


    // if we have more than the maximum levels
    if length > maxlevels
        // reduce the list of levels
        box val = array.get(boxArr, length - 1)
        if not na(val)
            box.delete(val)
        array.pop(boxArr)

// @function clean an array from na values
// @param arr the array to clean
// @return if the array was cleaned
export cleanarr(simple box[] arr) =>
    ret = true
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1 by 1
            //included?
            if na(array.get(arr, i))
                array.remove(arr, i)
                ret
            else
                ret := false
                ret
            break
    ret

// @function calculate the psy levels
//4 hour res based on how mt4 does it
//mt4 code
//int Li_4 = iBarShift(NULL, PERIOD_H4, iTime(NULL, PERIOD_W1, Li_0)) - 2 - Offset;
//ObjectCreate("PsychHi", OBJ_TREND, 0, Time[0], iHigh(NULL, PERIOD_H4, iHighest(NULL, PERIOD_H4, MODE_HIGH, 2, Li_4)), iTime(NULL, PERIOD_W1, 0), iHigh(NULL, PERIOD_H4,
//iHighest(NULL, PERIOD_H4, MODE_HIGH, 2, Li_4)));
//so basically because the session is 8 hours and we are looking at a 4 hour resolution we only need to take the highest high an lowest low of 2 bars
//we use the gmt offset to adjust the 0000-0800 session to Sydney open which is at 2100 during dst and at 2200 otherwize. (dst - spring foward, fall back)
//keep in mind sydney is in the souther hemisphere so dst is oposite of when london and new york go into dst
// @param oneWeekMillis a constant value
// @param showPsylevels should psy levels be calculated
// @param psyType the type of Psylevels - crypto or forex
// @param sydDST is Sydney in DST
// @return [psyHi, psyLo, psyHiLabel, psyLoLabel, psySessionStartTime]       
export calcPsyLevels(simple int oneWeekMillis, simple bool showPsylevels, simple string psyType, series bool sydDST) =>
    int psySession = na
    int psySessionStartDay = na
    int psySessionStartTime = na
    bool inPsySession = false
    float psyHi = na
    float psyLo = na
    string psyHiLabel = na
    string psyLoLabel = na
    //only do the calc if the user has not disabled the psy levels
    if showPsylevels
        //4 hour res based on how mt4 does it
        //mt4 code
        //int Li_4 = iBarShift(NULL, PERIOD_H4, iTime(NULL, PERIOD_W1, Li_0)) - 2 - Offset;
        //ObjectCreate("PsychHi", OBJ_TREND, 0, Time[0], iHigh(NULL, PERIOD_H4, iHighest(NULL, PERIOD_H4, MODE_HIGH, 2, Li_4)), iTime(NULL, PERIOD_W1, 0), iHigh(NULL, PERIOD_H4,
        //iHighest(NULL, PERIOD_H4, MODE_HIGH, 2, Li_4)));
            
        //so basically because the session is 8 hours and we are looking at a 4 hour resolution we only need to take the highest high an lowest low of 2 bars
        //we use the gmt offset to adjust the 0000-0800 session to Sydney open which is at 2100 during dst and at 2200 otherwize. (dst - spring foward, fall back)
        //keep in mind sydney is in the souther hemisphere so dst is oposite of when london and new york go into dst
        if psyType == 'crypto'
            if sydDST
                psySession := time('240', '2200-0600:1', "GMT+1")
                psySessionStartTime := timestampPreviousDayOfWeek('Saturday', 22, 'GMT+1', oneWeekMillis)
            else
                psySession := time('240', '2200-0600:1', "GMT")
                psySessionStartTime := timestampPreviousDayOfWeek('Saturday', 22, 'GMT', oneWeekMillis)
        else
            psySession := time('240', '0000-0800:2', "GMT")
            psySessionStartTime := timestampPreviousDayOfWeek('Monday', 00, 'GMT', oneWeekMillis)
            
        inPsySession := na(psySession) ? false : true
        if inPsySession
            // When entering a new psy session, initialize hi/lo
            if not inPsySession[1]
                psyHi := high
                psyLo := low
                psyHiLabel := 'Psy-Hi calculating...'
                psyLoLabel := 'Psy-Lo calculating...'
            // After initialization, calculate psy hi/lo
            else
                psyHi := math.max(high, psyHi[1])
                psyLo := math.min(low, psyLo[1])
                //stylePsy := line.style_dashed //this does not work for style correctly but it does for the label which is odd
                psyHiLabel := 'Psy-Hi calculating...'
                psyLoLabel := 'Psy-Lo calculating...'
        // When not in the psy session, use the last value of psyHi and psyLo
        else
            psyHi := psyHi[1]
            psyLo := psyLo[1]
            psyHiLabel := 'Psy-Hi'
            psyLoLabel := 'Psy-Lo'
        
        [psyHi, psyLo, psyHiLabel, psyLoLabel, psySessionStartTime]

// @fucntion Calculate average daily range for a given length and take into consideration if we want the calculation to start from the daily open or use the classical definition of adr and this taking it from todays high and low
// @param length how many elements of the series to calculate on
// @param barsBack starting possition for the length calculation - current bar or some other value eg last bar
// @param fromDO boolean flag, if false calculate traditional adr from high low of today, if true calcualte from exchange midnight
// @return adr, adrLow and adrHigh  - the adr, the position of the adr High and adr Low with respect to price
export adrHiLo(simple int length, simple int barsBack, simple bool fromDO) =>
    adr = 0.0
    adrHigh = 0.0
    adrLow = 0.0
    // This is effectively an atr, which is what is used in MT4 to get those levels. FWIW, true range can be also calculated with tr(true)
    trueRange = na(high[1]) ? high - low : math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
    // Switched to SMA from RMA because somehow it matches MT4 better
    adr := ta.sma(trueRange[barsBack], length)

    
    if not fromDO
        adrHigh := high - low < adr ? low + adr : close >= open ? low + adr : high
    else
        adrHigh := open + adr
    
    if not fromDO
        adrLow := high - low < adr ? high - adr : close >= open ? low : high - adr
    else
        adrLow := open - adr
    
    [adr, adrHigh, adrLow]

// @fucntion draw the session high and low lines, a mid session line and color the session using a box. This  based on the sessions high and low - dynamically updated. includes the session label
// @param sessXTime session string in the format 0000-0100:23456 
// @param show_rectangleX show the session high and low lines 
// @param show_labelX show the session label
// @param sessXcolLabel the color to be used for the hi/low lines and label
// @param sessXLabel the session label text
// @param gmt the gmt offset string usually in the format GMT+1 or GMT+2 etc
// @param sessionLineStyle the line stile for the session high low lines 
// @param sessXcol - the color for the box color that will color the session
// @return void 
export drawSessionHiloLite(simple string sessXTime, simple bool showRectangleX, simple bool showLabelX, simple color sessXcolLabel, simple string sessXLabel, simple string gmt, simple string sessionLineStyle, simple color sessXcol)=>
    if showRectangleX
        // Initialize variables on bar zero only, so they preserve their values across bars.
        var hi = float(0)
        var lo = float(10000000000.0)
       
        var line line_t = na
        var line line_b = na
        var line line_m = na
        var label line_label = na
        var box hiLoBox = na
        currentTime = timestamp(gmt, year, month, dayofmonth, hour, minute, 00)
        // var box hiLoBox = na
        // Detect changes in timeframe.
        session = time(timeframe.period, sessXTime, gmt)
        sessLineStyleX = sessionLineStyle == 'Solid' ? line.style_solid : line.style_dashed
        bool newTF = not na(session) and na(session[1])
        hi := newTF ? high : not na(session) ? math.max(high, hi[1]) : hi[1]
        lo := newTF ? low : not na(session) ? math.min(low, lo[1]) : lo[1]
        [targetstartTimeX,targetendTimeX] = calcSessionStartEnd(sessXTime, gmt) 
        if newTF
            beginIndex = bar_index 
            
            sessionDuration = math.round(math.abs(time  - targetendTimeX)/(timeframe.multiplier*60*1000))
        
            line_t := line.new(beginIndex, hi, timeframe.multiplier == 1? bar_index : bar_index+sessionDuration, hi, xloc=xloc.bar_index, style=sessLineStyleX, color=sessXcolLabel)
            line_b := line.new(beginIndex, lo, timeframe.multiplier == 1? bar_index : bar_index+sessionDuration, lo, xloc=xloc.bar_index, style=sessLineStyleX, color=sessXcolLabel)
            line_m := line.new(beginIndex, (hi+lo)/2, timeframe.multiplier == 1? bar_index : bar_index+sessionDuration, (hi+lo)/2, xloc=xloc.bar_index, style=sessLineStyleX, color=sessXcolLabel)
            hiLoBox := box.new(bar_index, hi, timeframe.multiplier == 1? bar_index : bar_index+sessionDuration, lo, border_color = na, bgcolor = sessXcol)
            if showLabelX
                line_label := label.new(beginIndex, hi, sessXLabel, xloc=xloc.bar_index, textcolor=sessXcolLabel, style=label.style_none, size=size.normal, textalign=text.align_right)
                //label.delete(line_label[1])
            int(na)
        else
            if na(session[1]) and not na(session) or session[1] < session
                if timeframe.multiplier == 1
                    line.set_x2(line_t,bar_index+1)
                    line.set_x2(line_b,bar_index+1)
                    line.set_x2(line_m,bar_index+1)
                    box.set_right(hiLoBox, bar_index+1)
                line.set_y1(line_t,hi)
                line.set_y2(line_t,hi)
                line.set_y1(line_b,lo)
                line.set_y2(line_b,lo)
                line.set_y1(line_m,(hi+lo)/2)
                line.set_y2(line_m,(hi+lo)/2)
                box.set_top(hiLoBox,hi)
                box.set_bottom(hiLoBox,lo)
                //line.delete(sessVLineNext[1])
                if showLabelX and not na(line_label)
                    label.set_y(line_label, hi)
                
            int(na)



// @function converts milliseconds into an hh:mm string. For example, 61000 ms to '0:01:01'
// @param ms - the milliseconds to convert to hh:mm
// @return string - the converted hh:mm string
export msToHmsString(series int ms) =>
    hours = int(ms / (60*60*1000))
    minutes = int((ms - hours*60*60*1000) / (60*1000))
    minutesString = minutes <= 9 ? '0' + str.tostring(minutes) : str.tostring(minutes)
    str.tostring(hours) + ':' + minutesString 

// @function that calculates how much time is left until the next session taking the session start and end times into account. Note this function does not work on intraday sessions.
// @param openToday - timestamps of when the session opens in general - note its a series because the timestamp was created using the dst flag which is a series itself thus producing a timestamp series
// @param closeToday - timestamp of when the session closes in general - note its a series because the timestamp was created using the dst flag which is a series itself thus producing a timestamp series
// @return a countdown of when next the session opens or 'Open' if the session is open now
export countdownString(series int openToday, series int closeToday, simple bool showMarketsWeekends, simple int oneDay) =>
    string countdownString = na
    // Sunday
    if dayofweek(timenow, 'GMT') == 1 and not showMarketsWeekends
        // Countdown to next session
        countdown = openToday + oneDay - timenow
        countdownString := msToHmsString(countdown)
    // Monday - Thursday
    else if (dayofweek(timenow, 'GMT') >= 2 and dayofweek(timenow, 'GMT') <= 5 and not showMarketsWeekends) or showMarketsWeekends
        // Before today's session (countdown)
        if timenow < openToday
            countdown = openToday - timenow
            countdownString := msToHmsString(countdown)
        // During today's session (open)
        else if timenow >= openToday and timenow < closeToday
            countdownString := 'Open'
        // After today's session (countdown)
        else
            countdown = openToday + oneDay - timenow
            countdownString := msToHmsString(countdown)
    // Friday
    else if dayofweek(timenow, 'GMT') == 6 and not showMarketsWeekends
        // Before today's session (countdown)
        if timenow < openToday
            countdown = openToday - timenow
            countdownString := msToHmsString(countdown)
        // During today's session (open)
        else if timenow >= openToday and timenow < closeToday
            countdownString := 'Open'
        // After today's session (countdown)
        else
            countdown = openToday + 3*oneDay - timenow
            countdownString := msToHmsString(countdown)
    // Saturday
    else
        // Countdown to next session
        countdown = openToday + 2*oneDay - timenow
        countdownString := msToHmsString(countdown)

    countdownString

// @function that calculates how much time is left until the next session taking the session start and end times into account. special case of intraday sessions like sydney
// @param openToday - timestamps of when the session opens in general - note its a series because the timestamp was created using the dst flag which is a series itself thus producing a timestamp series
// @param closeToday - timestamp of when the session closes in general - note its a series because the timestamp was created using the dst flag which is a series itself thus producing a timestamp series
// @return a countdown of when next the session opens or 'Open' if the session is open now
export countdownStringSyd(series int sydOpenToday, series int sydCloseToday, simple bool showMarketsWeekends, simple int oneDay)=>
    string sydCountdownString = na
    // Sydney is a special case because the session starts on one day and ends the next day.
    // Sunday
    if dayofweek(timenow, 'GMT') == 1 and not showMarketsWeekends
        // Before today's session (countdown)
        if timenow < sydOpenToday
            sydCountdown = sydOpenToday - timenow
            sydCountdownString := msToHmsString(sydCountdown)
            // During today's session (open)
        else
            sydCountdownString := 'Open'
    // Monday - Thursday
    else if (dayofweek(timenow, 'GMT') >= 2 and dayofweek(timenow, 'GMT') <= 5 and not showMarketsWeekends) or showMarketsWeekends
        // During today's morning session (open)
        if timenow < sydCloseToday
            sydCountdownString := 'Open'
        // After today's morning session and before today's evening session (countdown)
        else if timenow >= sydCloseToday and timenow < sydOpenToday
            sydCountdown = sydOpenToday - timenow
            sydCountdownString := msToHmsString(sydCountdown)
        // During today's evening session (countdown)
        else
            sydCountdownString := 'Open'
    // Friday
    else if dayofweek(timenow, 'GMT') == 6 and not showMarketsWeekends
        // During today's morning session (open)
        if timenow < sydCloseToday
            sydCountdownString := 'Open'
        // After today's morning session
        else
            sydCountdown = sydOpenToday + 2*oneDay - timenow
            sydCountdownString := msToHmsString(sydCountdown)
    // Saturday
    else
        // Countdown to next session
        sydCountdown = sydOpenToday + oneDay - timenow
        sydCountdownString := msToHmsString(sydCountdown)
    sydCountdownString    

    