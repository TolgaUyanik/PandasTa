//@version=6
indicator("Market Structure & 50% Retracement", overlay=true)

// --- Inputs ---
pivotLegs = input.int(5, title="Pivot Lookback Period", minval=1)
show50Level = input.bool(true, title="Show 50% Retracement Line")

// --- Pivot Identification ---
ph = ta.pivothigh(pivotLegs, pivotLegs)
pl = ta.pivotlow(pivotLegs, pivotLegs)

// --- Tracking Structure Highs & Lows ---
var float swingHigh = na
var float swingLow  = na
var int trendDirection = 0 // 1 for Uptrend, -1 for Downtrend

if not na(ph)
    swingHigh := ph

if not na(pl)
    swingLow := pl

// --- Market Structure Break Detection ---
bullishBOS = ta.crossover(close, swingHigh)
bearishBOS = ta.crossunder(close, swingLow)

if bullishBOS
    trendDirection := 1

if bearishBOS
    trendDirection := -1

// --- 50% Retracement Calculation ---
fiftyPercentLevel = (swingHigh + swingLow) / 2.0

// --- Visual Plots ---
// Plot 50% Retracement Line
plot(show50Level and not na(fiftyPercentLevel) ? fiftyPercentLevel : na, title="50% Equilibrium Level", color=color.yellow, linewidth=2, style=plot.style_linebr)

// Break of Structure Signals
plotshape(bullishBOS, title="Bullish BOS", style=shape.labelup, location=location.belowbar, color=color.green, text="BOS / CHoCH", textcolor=color.white, size=size.small)
plotshape(bearishBOS, title="Bearish BOS", style=shape.labeldown, location=location.abovebar, color=color.red, text="BOS / CHoCH", textcolor=color.white, size=size.small)
