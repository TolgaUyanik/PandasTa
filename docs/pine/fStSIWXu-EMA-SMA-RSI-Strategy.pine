//@version=5
indicator("EMA-SMA & RSI Strategy", overlay=true)

// === INPUTS ===
emaLen = input.int(20, title="EMA Length")
smaLen = input.int(50, title="SMA Length")
rsiLen = input.int(14, title="RSI Length")

// === INDICATORS ===
ema = ta.ema(close, emaLen)
sma = ta.sma(close, smaLen)
rsi = ta.rsi(close, rsiLen)

// === BUY/SELL CONDITIONS ===
// 1. EMA crosses above SMA --> BUY
buy_cross = ta.crossover(ema, sma)

// 2. RSI < 30 --> BUY (oversold)
buy_rsi = rsi < 30

// Combined BUY condition
buySignal = buy_cross or buy_rsi

// 1. EMA crosses below SMA --> SELL
sell_cross = ta.crossunder(ema, sma)

// 2. RSI > 70 --> SELL (overbought)
sell_rsi = rsi > 70

// Combined SELL condition
sellSignal = sell_cross or sell_rsi

// === PLOTS ===
plot(ema, title="EMA", color=color.orange, linewidth=2)
plot(sma, title="SMA", color=color.blue, linewidth=2)

// === SIGNAL LABELS ===
plotshape(buySignal, title="BUY Signal", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(sellSignal, title="SELL Signal", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")
