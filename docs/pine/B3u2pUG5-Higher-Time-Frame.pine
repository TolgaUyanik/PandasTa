//@version=6

// This library is for interacting with Higher Time Frame charts
library("Higher_Time_Frame")

export type CBM
    line OpenLine = na
    line CloseLine = na
    line HOpenLine = na
    line HCloseLine = na
    line H2OpenLine = na
    line H2CloseLine = na

export type Candle
    int UID = 0
    float HighPrice = 0
    float LowPrice = 0
    float OpenPrice = 0
    float ClosePrice = 0
    int HighIndex = 0
    int LowIndex = 0
    int OpenIndex = 0
    int CloseIndex = 0
    Candle PreviousCandle = na
    float MAHigh = 0
    float MALow = 0
    float MAOpen = 0
    float MAClose = 0
    float Volume = 0
    float AvgVolume = 0
    CBM oCBM = na


//@function
export IsGreenBar(Candle oCandle) =>
    oCandle.ClosePrice > oCandle.OpenPrice

//@function
export IsRedBar(Candle oCandle) =>
    oCandle.ClosePrice < oCandle.OpenPrice

//@function
/// 1 = Green
/// -1 = Red
/// 0 = Doji
export BarColor(Candle oCandle) =>
    oCandle.ClosePrice > oCandle.OpenPrice ? 1 : oCandle.ClosePrice < oCandle.OpenPrice ? -1 : 0


export CalculateEMA(Candle oCandle, int Period, float InputValue, float MAValue) =>
    float EMAConstant1 = 2.0 / (1 + Period)
	float EMAConstant2 = 1 - (2.0 / (1 + Period))
		
	(oCandle.UID == 0 ? InputValue : InputValue * EMAConstant1 + EMAConstant2 * MAValue)