//@version=5
library("_MyLibraryV1", overlay=false)

// ─────────────────────────────────────────────
// Moving Average Stacking
// ─────────────────────────────────────────────

// Returns true when fast > mid > slow
export maStackedBull(series float src, int fastLen, int midLen, int slowLen) =>
	fast = ta.sma(src, fastLen)
    mid  = ta.sma(src, midLen)
    slow = ta.sma(src, slowLen)
    fast > mid and mid > slow

