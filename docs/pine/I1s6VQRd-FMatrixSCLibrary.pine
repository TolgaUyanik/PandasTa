// F MATRIX | SC LIBRARY  v3.0
// ═══════════════════════════════════════════════════════════════════════════════
//
// Shared bias tables + auto-computed stats for all F Matrix system scripts.
// Designed for 57 systems — lean, no redundant computation.
//
// EXPORTS:
//   Type:    SCTheme
//   Utility: defaultTheme()
//   Render:  renderSystemBias()  — full DOW/quarter/cycle/direction breakdown (DATA mode)
//            renderQuickBias()   — compact 3-row panel for today (EXEC mode)
//            renderAutoStats()   — historical stats computed from arrays (DATA mode)
//            renderEnvBias()     — BTC seasonality grid (DATA mode)
//
// NO MONTH BREAKDOWN — only DOW, quarter, cycle year per user spec.
// ═══════════════════════════════════════════════════════════════════════════════

//@version=6
library("FMatrixSCLibrary")


// ═══════════════════════════════════════════════════════════════════════════════
// THEME
// ═══════════════════════════════════════════════════════════════════════════════

export type SCTheme
    color bg    = #0F0F19
    color hdr   = #19192D
    color row   = #191923
    color row2  = #20202D
    color txt   = #C8C8C8
    color dim   = #787878
    color cyan  = #00C8FF
    color bull  = #00C864
    color bear  = #C83232
    color gold  = #FFC800
    color grid  = #282828
    color hl    = #283C5A

export defaultTheme() =>
    SCTheme.new()


// ═══════════════════════════════════════════════════════════════════════════════
// INTERNAL: aggregate helpers (not exported — used by render functions)
// ═══════════════════════════════════════════════════════════════════════════════

// DOW index from string
_dowIdx(string d) =>
    d == "Mon" ? 0 : d == "Tue" ? 1 : d == "Wed" ? 2 : d == "Thu" ? 3 : d == "Fri" ? 4 : d == "Sat" ? 5 : 6

// Quarter index from string
_qtrIdx(string q) =>
    q == "Q1" ? 0 : q == "Q2" ? 1 : q == "Q3" ? 2 : 3

// Colour for avg R value
_rCol(float v, SCTheme t) =>
    v > 0 ? t.bull : v < 0 ? t.bear : t.dim

// Colour for WR%
_wrCol(float v, SCTheme t) =>
    v >= 50 ? t.bull : t.bear


// ═══════════════════════════════════════════════════════════════════════════════
// RENDER: SYSTEM BIAS TABLE (DATA mode)
// ═══════════════════════════════════════════════════════════════════════════════
// Full breakdown by DOW (7), Quarter (4), Cycle Year (4), Direction (2).
// Highlights current DOW/Q/CY. Shows AVG R | WR% | N | L AVG | S AVG.
// Table size: 6 cols × 24 rows (1 title + 1 hdr + 3 section hdrs + 17 data + 2 direction)

export renderSystemBias(table t, float[] r, int[] wl, int[] dir, string[] dow, string[] qtr, int[] cy, int curDowIdx, int curQtr, int curCy, string sysCode, SCTheme theme) =>
    int n = array.size(r)
    if n > 0
        // ── Accumulators ──
        // DOW: 7 buckets
        float[] dR = array.new<float>(7,0.0), int[] dW = array.new<int>(7,0), int[] dN = array.new<int>(7,0)
        float[] dLR = array.new<float>(7,0.0), int[] dLN = array.new<int>(7,0)
        float[] dSR = array.new<float>(7,0.0), int[] dSN = array.new<int>(7,0)
        // Quarter: 4 buckets
        float[] qR = array.new<float>(4,0.0), int[] qW = array.new<int>(4,0), int[] qN = array.new<int>(4,0)
        float[] qLR = array.new<float>(4,0.0), int[] qLN = array.new<int>(4,0)
        float[] qSR = array.new<float>(4,0.0), int[] qSN = array.new<int>(4,0)
        // Cycle: 4 buckets
        float[] cR = array.new<float>(4,0.0), int[] cW = array.new<int>(4,0), int[] cN = array.new<int>(4,0)
        float[] cLR = array.new<float>(4,0.0), int[] cLN = array.new<int>(4,0)
        float[] cSR = array.new<float>(4,0.0), int[] cSN = array.new<int>(4,0)
        // Direction: 2 buckets (0=Long, 1=Short)
        float[] xR = array.new<float>(2,0.0), int[] xW = array.new<int>(2,0), int[] xN = array.new<int>(2,0)

        // ── Single pass ──
        for i = 0 to n - 1
            float _r  = array.get(r, i)
            int   _wl = array.get(wl, i)
            int   _di = array.get(dir, i)
            bool  isL = _di > 0

            int di = _dowIdx(array.get(dow, i))
            array.set(dR, di, array.get(dR, di) + _r), array.set(dN, di, array.get(dN, di) + 1)
            if _wl > 0
                array.set(dW, di, array.get(dW, di) + 1)
            if isL
                array.set(dLR, di, array.get(dLR, di) + _r), array.set(dLN, di, array.get(dLN, di) + 1)
            else
                array.set(dSR, di, array.get(dSR, di) + _r), array.set(dSN, di, array.get(dSN, di) + 1)

            int qi = _qtrIdx(array.get(qtr, i))
            array.set(qR, qi, array.get(qR, qi) + _r), array.set(qN, qi, array.get(qN, qi) + 1)
            if _wl > 0
                array.set(qW, qi, array.get(qW, qi) + 1)
            if isL
                array.set(qLR, qi, array.get(qLR, qi) + _r), array.set(qLN, qi, array.get(qLN, qi) + 1)
            else
                array.set(qSR, qi, array.get(qSR, qi) + _r), array.set(qSN, qi, array.get(qSN, qi) + 1)

            int ci = math.max(0, math.min(3, array.get(cy, i) - 1))
            array.set(cR, ci, array.get(cR, ci) + _r), array.set(cN, ci, array.get(cN, ci) + 1)
            if _wl > 0
                array.set(cW, ci, array.get(cW, ci) + 1)
            if isL
                array.set(cLR, ci, array.get(cLR, ci) + _r), array.set(cLN, ci, array.get(cLN, ci) + 1)
            else
                array.set(cSR, ci, array.get(cSR, ci) + _r), array.set(cSN, ci, array.get(cSN, ci) + 1)

            int xi = isL ? 0 : 1
            array.set(xR, xi, array.get(xR, xi) + _r), array.set(xN, xi, array.get(xN, xi) + 1)
            if _wl > 0
                array.set(xW, xi, array.get(xW, xi) + 1)

        // ── Render ──
        int row = 0

        table.cell(t,0,row,sysCode+" SYSTEM BIAS",text_color=theme.cyan,bgcolor=theme.bg,text_size=size.small,text_halign=text.align_center)
        table.merge_cells(t,0,row,5,row)
        row += 1

        string[] hdr = array.from("SCENARIO","AVG R","WR%","N","L AVG","S AVG")
        for c = 0 to 5
            table.cell(t,c,row,array.get(hdr,c),text_color=color.white,bgcolor=theme.hdr,text_size=size.tiny,text_halign=text.align_center)
        row += 1

        // DOW
        table.cell(t,0,row,"── DAY OF WEEK ──",text_color=theme.dim,bgcolor=theme.hdr,text_size=size.tiny), table.merge_cells(t,0,row,5,row), row += 1
        string[] dowN = array.from("Mon","Tue","Wed","Thu","Fri","Sat","Sun")
        for i = 0 to 6
            bool h = i == curDowIdx
            color bg = h ? theme.hl : (i%2==0 ? theme.row : theme.row2)
            int cnt = array.get(dN,i)
            float avg = cnt>0 ? array.get(dR,i)/cnt : 0.0
            float wr  = cnt>0 ? float(array.get(dW,i))/float(cnt)*100 : 0.0
            float la  = array.get(dLN,i)>0 ? array.get(dLR,i)/float(array.get(dLN,i)) : 0.0
            float sa  = array.get(dSN,i)>0 ? array.get(dSR,i)/float(array.get(dSN,i)) : 0.0
            table.cell(t,0,row,(h?"► ":"  ")+array.get(dowN,i),text_color=h?color.white:theme.txt,bgcolor=bg,text_size=size.tiny,text_halign=text.align_left)
            table.cell(t,1,row,str.tostring(avg,"#.##"),text_color=_rCol(avg,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,2,row,str.tostring(wr,"#.#")+"%",text_color=_wrCol(wr,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,3,row,str.tostring(cnt),text_color=theme.dim,bgcolor=bg,text_size=size.tiny)
            table.cell(t,4,row,str.tostring(la,"#.##"),text_color=_rCol(la,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,5,row,str.tostring(sa,"#.##"),text_color=_rCol(sa,theme),bgcolor=bg,text_size=size.tiny)
            row += 1

        // Quarter
        table.cell(t,0,row,"── QUARTER ──",text_color=theme.dim,bgcolor=theme.hdr,text_size=size.tiny), table.merge_cells(t,0,row,5,row), row += 1
        string[] qN2 = array.from("Q1","Q2","Q3","Q4")
        for i = 0 to 3
            bool h = i == (curQtr-1)
            color bg = h ? theme.hl : (i%2==0 ? theme.row : theme.row2)
            int cnt = array.get(qN,i)
            float avg = cnt>0 ? array.get(qR,i)/cnt : 0.0
            float wr  = cnt>0 ? float(array.get(qW,i))/float(cnt)*100 : 0.0
            float la  = array.get(qLN,i)>0 ? array.get(qLR,i)/float(array.get(qLN,i)) : 0.0
            float sa  = array.get(qSN,i)>0 ? array.get(qSR,i)/float(array.get(qSN,i)) : 0.0
            table.cell(t,0,row,(h?"► ":"  ")+array.get(qN2,i),text_color=h?color.white:theme.txt,bgcolor=bg,text_size=size.tiny,text_halign=text.align_left)
            table.cell(t,1,row,str.tostring(avg,"#.##"),text_color=_rCol(avg,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,2,row,str.tostring(wr,"#.#")+"%",text_color=_wrCol(wr,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,3,row,str.tostring(cnt),text_color=theme.dim,bgcolor=bg,text_size=size.tiny)
            table.cell(t,4,row,str.tostring(la,"#.##"),text_color=_rCol(la,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,5,row,str.tostring(sa,"#.##"),text_color=_rCol(sa,theme),bgcolor=bg,text_size=size.tiny)
            row += 1

        // Cycle Year
        table.cell(t,0,row,"── CYCLE YEAR ──",text_color=theme.dim,bgcolor=theme.hdr,text_size=size.tiny), table.merge_cells(t,0,row,5,row), row += 1
        string[] cyN = array.from("Year 1","Year 2","Year 3","Year 4")
        for i = 0 to 3
            bool h = i == (curCy-1)
            color bg = h ? theme.hl : (i%2==0 ? theme.row : theme.row2)
            int cnt = array.get(cN,i)
            float avg = cnt>0 ? array.get(cR,i)/cnt : 0.0
            float wr  = cnt>0 ? float(array.get(cW,i))/float(cnt)*100 : 0.0
            float la  = array.get(cLN,i)>0 ? array.get(cLR,i)/float(array.get(cLN,i)) : 0.0
            float sa  = array.get(cSN,i)>0 ? array.get(cSR,i)/float(array.get(cSN,i)) : 0.0
            table.cell(t,0,row,(h?"► ":"  ")+array.get(cyN,i),text_color=h?color.white:theme.txt,bgcolor=bg,text_size=size.tiny,text_halign=text.align_left)
            table.cell(t,1,row,str.tostring(avg,"#.##"),text_color=_rCol(avg,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,2,row,str.tostring(wr,"#.#")+"%",text_color=_wrCol(wr,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,3,row,str.tostring(cnt),text_color=theme.dim,bgcolor=bg,text_size=size.tiny)
            table.cell(t,4,row,str.tostring(la,"#.##"),text_color=_rCol(la,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,5,row,str.tostring(sa,"#.##"),text_color=_rCol(sa,theme),bgcolor=bg,text_size=size.tiny)
            row += 1

        // Direction
        table.cell(t,0,row,"── DIRECTION ──",text_color=theme.dim,bgcolor=theme.hdr,text_size=size.tiny), table.merge_cells(t,0,row,5,row), row += 1
        string[] xNm = array.from("Long","Short")
        for i = 0 to 1
            color bg = i%2==0 ? theme.row : theme.row2
            int cnt = array.get(xN,i)
            float avg = cnt>0 ? array.get(xR,i)/cnt : 0.0
            float wr  = cnt>0 ? float(array.get(xW,i))/float(cnt)*100 : 0.0
            table.cell(t,0,row,"  "+array.get(xNm,i),text_color=i==0?theme.bull:theme.bear,bgcolor=bg,text_size=size.tiny,text_halign=text.align_left)
            table.cell(t,1,row,str.tostring(avg,"#.##"),text_color=_rCol(avg,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,2,row,str.tostring(wr,"#.#")+"%",text_color=_wrCol(wr,theme),bgcolor=bg,text_size=size.tiny)
            table.cell(t,3,row,str.tostring(cnt),text_color=theme.dim,bgcolor=bg,text_size=size.tiny)
            table.cell(t,4,row,"",bgcolor=bg), table.cell(t,5,row,"",bgcolor=bg)
            row += 1
    true


// ═══════════════════════════════════════════════════════════════════════════════
// RENDER: QUICK BIAS PANEL (EXEC mode)
// ═══════════════════════════════════════════════════════════════════════════════
// Compact 3-row summary: today's DOW + current quarter + current cycle year.
// Answers "should I take this trade right now?" at a glance.
// Table size: 5 cols × 4 rows (1 title + 3 data)

export renderQuickBias(table t, float[] r, int[] wl, string[] dow, string[] qtr, int[] cy, int curDowIdx, int curQtr, int curCy, string sysCode, SCTheme theme) =>
    int n = array.size(r)
    if n > 0
        // Accumulate only the 3 buckets we need
        float dSumR = 0.0, int dWins = 0, int dCnt = 0
        float qSumR = 0.0, int qWins = 0, int qCnt = 0
        float cSumR = 0.0, int cWins = 0, int cCnt = 0
        int curQIdx = curQtr - 1
        int curCIdx = curCy - 1

        for i = 0 to n - 1
            float _r = array.get(r, i)
            int  _wl = array.get(wl, i)
            if _dowIdx(array.get(dow, i)) == curDowIdx
                dSumR += _r, dCnt += 1
                if _wl > 0
                    dWins += 1
            if _qtrIdx(array.get(qtr, i)) == curQIdx
                qSumR += _r, qCnt += 1
                if _wl > 0
                    qWins += 1
            if math.max(0, math.min(3, array.get(cy, i) - 1)) == curCIdx
                cSumR += _r, cCnt += 1
                if _wl > 0
                    cWins += 1

        // Render
        table.cell(t,0,0,sysCode+" BIAS",text_color=theme.cyan,bgcolor=theme.bg,text_size=size.small,text_halign=text.align_center)
        table.merge_cells(t,0,0,4,0)
        string[] hdr = array.from("","AVG R","WR%","N","BIAS")
        for c = 0 to 4
            table.cell(t,c,1,array.get(hdr,c),text_color=theme.dim,bgcolor=theme.hdr,text_size=size.tiny,text_halign=text.align_center)

        // DOW
        float dAvg = dCnt>0 ? dSumR/dCnt : 0.0
        float dWr  = dCnt>0 ? float(dWins)/float(dCnt)*100 : 0.0
        string dBias = dAvg>0.5 ? "STRONG" : dAvg>0 ? "OK" : "WEAK"
        string[] dowN = array.from("Mon","Tue","Wed","Thu","Fri","Sat","Sun")
        table.cell(t,0,2,"► "+array.get(dowN,curDowIdx),text_color=color.white,bgcolor=theme.hl,text_size=size.tiny,text_halign=text.align_left)
        table.cell(t,1,2,str.tostring(dAvg,"#.##")+"R",text_color=_rCol(dAvg,theme),bgcolor=theme.hl,text_size=size.tiny)
        table.cell(t,2,2,str.tostring(dWr,"#.#")+"%",text_color=_wrCol(dWr,theme),bgcolor=theme.hl,text_size=size.tiny)
        table.cell(t,3,2,str.tostring(dCnt),text_color=theme.dim,bgcolor=theme.hl,text_size=size.tiny)
        table.cell(t,4,2,dBias,text_color=dAvg>0?theme.bull:theme.bear,bgcolor=theme.hl,text_size=size.tiny)

        // Quarter
        float qAvg = qCnt>0 ? qSumR/qCnt : 0.0
        float qWr  = qCnt>0 ? float(qWins)/float(qCnt)*100 : 0.0
        string qBias = qAvg>0.5 ? "STRONG" : qAvg>0 ? "OK" : "WEAK"
        table.cell(t,0,3,"► Q"+str.tostring(curQtr),text_color=color.white,bgcolor=theme.row,text_size=size.tiny,text_halign=text.align_left)
        table.cell(t,1,3,str.tostring(qAvg,"#.##")+"R",text_color=_rCol(qAvg,theme),bgcolor=theme.row,text_size=size.tiny)
        table.cell(t,2,3,str.tostring(qWr,"#.#")+"%",text_color=_wrCol(qWr,theme),bgcolor=theme.row,text_size=size.tiny)
        table.cell(t,3,3,str.tostring(qCnt),text_color=theme.dim,bgcolor=theme.row,text_size=size.tiny)
        table.cell(t,4,3,qBias,text_color=qAvg>0?theme.bull:theme.bear,bgcolor=theme.row,text_size=size.tiny)

        // Cycle Year
        float cAvg = cCnt>0 ? cSumR/cCnt : 0.0
        float cWr  = cCnt>0 ? float(cWins)/float(cCnt)*100 : 0.0
        string cBias = cAvg>0.5 ? "STRONG" : cAvg>0 ? "OK" : "WEAK"
        table.cell(t,0,4,"► Y"+str.tostring(curCy),text_color=color.white,bgcolor=theme.row2,text_size=size.tiny,text_halign=text.align_left)
        table.cell(t,1,4,str.tostring(cAvg,"#.##")+"R",text_color=_rCol(cAvg,theme),bgcolor=theme.row2,text_size=size.tiny)
        table.cell(t,2,4,str.tostring(cWr,"#.#")+"%",text_color=_wrCol(cWr,theme),bgcolor=theme.row2,text_size=size.tiny)
        table.cell(t,3,4,str.tostring(cCnt),text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny)
        table.cell(t,4,4,cBias,text_color=cAvg>0?theme.bull:theme.bear,bgcolor=theme.row2,text_size=size.tiny)
    true


// ═══════════════════════════════════════════════════════════════════════════════
// RENDER: AUTO-COMPUTED STATS (DATA mode)
// ═══════════════════════════════════════════════════════════════════════════════
// Computes all stats from backtest arrays — ZERO manual fill needed.
// Only Consistency Score and DD Score must be passed as FILL constants.
// Table size: 2 cols × 20 rows

export renderAutoStats(table t, float[] r, int[] wl, int[] dir, float consistencyScore, float ddScore, string sysCode, SCTheme theme) =>
    int n = array.size(r)
    if n > 0
        // ── Compute everything ──
        int wins = 0, int losses = 0
        float sumR = 0.0, float sumWinR = 0.0, float sumLossR = 0.0
        int longs = 0, int lWins = 0, float lSumR = 0.0
        int shorts = 0, int sWins = 0, float sSumR = 0.0
        float eq = 0.0, float peakEq = 0.0, float maxDD = 0.0
        int consW = 0, int consL = 0, int maxConsW = 0, int maxConsL = 0
        int ddTrades = 0

        for i = 0 to n - 1
            float _r  = array.get(r, i)
            int   _wl = array.get(wl, i)
            int   _d  = array.get(dir, i)
            sumR += _r
            eq   += _r
            peakEq := math.max(peakEq, eq)
            float dd = peakEq - eq
            maxDD := math.max(maxDD, dd)
            if dd > 0
                ddTrades += 1

            if _wl > 0
                wins += 1, sumWinR += _r
                consW += 1, consL := 0
                maxConsW := math.max(maxConsW, consW)
            else
                losses += 1, sumLossR += _r
                consL += 1, consW := 0
                maxConsL := math.max(maxConsL, consL)

            if _d > 0
                longs += 1, lSumR += _r
                if _wl > 0
                    lWins += 1
            else
                shorts += 1, sSumR += _r
                if _wl > 0
                    sWins += 1

        float wr      = n > 0 ? float(wins) / float(n) * 100 : 0.0
        float avgR    = n > 0 ? sumR / n : 0.0
        float avgWinR = wins > 0 ? sumWinR / wins : 0.0
        float avgLosR = losses > 0 ? sumLossR / losses : 0.0
        float lWR     = longs > 0 ? float(lWins) / float(longs) * 100 : 0.0
        float sWR     = shorts > 0 ? float(sWins) / float(shorts) * 100 : 0.0
        float lAvgR   = longs > 0 ? lSumR / longs : 0.0
        float sAvgR   = shorts > 0 ? sSumR / shorts : 0.0

        // ── Render ──
        int row = 0
        table.cell(t,0,row,sysCode+" STATS",text_color=theme.cyan,bgcolor=theme.bg,text_size=size.small,text_halign=text.align_center)
        table.merge_cells(t,0,row,1,row)
        row += 1

        // Helper closure isn't available, so inline render rows
        table.cell(t,0,row,"Trades",     text_color=theme.dim,bgcolor=theme.row, text_size=size.tiny), table.cell(t,1,row,str.tostring(n),                     text_color=theme.txt, bgcolor=theme.row, text_size=size.tiny), row+=1
        table.cell(t,0,row,"Win Rate",   text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny), table.cell(t,1,row,str.tostring(wr,"#.#")+"%",          text_color=_wrCol(wr,theme),bgcolor=theme.row2,text_size=size.tiny), row+=1
        table.cell(t,0,row,"Avg R",      text_color=theme.dim,bgcolor=theme.row, text_size=size.tiny), table.cell(t,1,row,str.tostring(avgR,"#.##")+"R",       text_color=_rCol(avgR,theme),bgcolor=theme.row, text_size=size.tiny), row+=1
        table.cell(t,0,row,"Avg Win R",  text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny), table.cell(t,1,row,str.tostring(avgWinR,"#.##")+"R",    text_color=theme.bull,bgcolor=theme.row2,text_size=size.tiny), row+=1
        table.cell(t,0,row,"Avg Loss R", text_color=theme.dim,bgcolor=theme.row, text_size=size.tiny), table.cell(t,1,row,str.tostring(avgLosR,"#.##")+"R",    text_color=theme.bear,bgcolor=theme.row, text_size=size.tiny), row+=1
        table.cell(t,0,row,"Peak Equity",text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny), table.cell(t,1,row,str.tostring(peakEq,"#.##")+"R",     text_color=theme.bull,bgcolor=theme.row2,text_size=size.tiny), row+=1
        table.cell(t,0,row,"Max DD",     text_color=theme.dim,bgcolor=theme.row, text_size=size.tiny), table.cell(t,1,row,str.tostring(maxDD,"#.##")+"R",      text_color=theme.bear,bgcolor=theme.row, text_size=size.tiny), row+=1
        table.cell(t,0,row,"Consistency",text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny), table.cell(t,1,row,str.tostring(consistencyScore,"#.#")+"/10",text_color=consistencyScore>=5?theme.bull:theme.bear,bgcolor=theme.row2,text_size=size.tiny), row+=1
        table.cell(t,0,row,"DD Score",   text_color=theme.dim,bgcolor=theme.row, text_size=size.tiny), table.cell(t,1,row,str.tostring(ddScore,"#.#")+"/10",   text_color=ddScore>=5?theme.bull:theme.bear,bgcolor=theme.row, text_size=size.tiny), row+=1
        table.cell(t,0,row,"Max Consec W",text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny),table.cell(t,1,row,str.tostring(maxConsW),              text_color=theme.bull,bgcolor=theme.row2,text_size=size.tiny), row+=1
        table.cell(t,0,row,"Max Consec L",text_color=theme.dim,bgcolor=theme.row, text_size=size.tiny),table.cell(t,1,row,str.tostring(maxConsL),              text_color=theme.bear,bgcolor=theme.row, text_size=size.tiny), row+=1
        // Separator
        table.cell(t,0,row,"",bgcolor=#323232), table.cell(t,1,row,"",bgcolor=#323232), row+=1
        table.cell(t,0,row,"Long WR",   text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny), table.cell(t,1,row,str.tostring(lWR,"#.#")+"%",         text_color=_wrCol(lWR,theme),bgcolor=theme.row2,text_size=size.tiny), row+=1
        table.cell(t,0,row,"Long Avg R", text_color=theme.dim,bgcolor=theme.row, text_size=size.tiny), table.cell(t,1,row,str.tostring(lAvgR,"#.##")+"R",     text_color=_rCol(lAvgR,theme),bgcolor=theme.row, text_size=size.tiny), row+=1
        table.cell(t,0,row,"Long Net R", text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny), table.cell(t,1,row,str.tostring(lSumR,"#.##")+"R",     text_color=_rCol(lSumR,theme),bgcolor=theme.row2,text_size=size.tiny), row+=1
        table.cell(t,0,row,"Short WR",  text_color=theme.dim,bgcolor=theme.row, text_size=size.tiny), table.cell(t,1,row,str.tostring(sWR,"#.#")+"%",         text_color=_wrCol(sWR,theme),bgcolor=theme.row, text_size=size.tiny), row+=1
        table.cell(t,0,row,"Short Avg R",text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny), table.cell(t,1,row,str.tostring(sAvgR,"#.##")+"R",     text_color=_rCol(sAvgR,theme),bgcolor=theme.row2,text_size=size.tiny), row+=1
        table.cell(t,0,row,"Short Net R",text_color=theme.dim,bgcolor=theme.row, text_size=size.tiny), table.cell(t,1,row,str.tostring(sSumR,"#.##")+"R",     text_color=_rCol(sSumR,theme),bgcolor=theme.row, text_size=size.tiny), row+=1
        // Separator
        table.cell(t,0,row,"",bgcolor=#323232), table.cell(t,1,row,"",bgcolor=#323232), row+=1
        table.cell(t,0,row,"Time in DD",text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny), table.cell(t,1,row,str.tostring(ddTrades)+" trades",    text_color=theme.txt,bgcolor=theme.row2,text_size=size.tiny)
    true


// ═══════════════════════════════════════════════════════════════════════════════
// RENDER: BTC ENVIRONMENT BIAS (DATA mode)
// ═══════════════════════════════════════════════════════════════════════════════
// Hardcoded BTC monthly seasonality averages (2016-2025). Self-contained.
// No month breakdown needed — but the BTC environment grid IS by month since
// it's market context, not system performance. Shows which months favor trading.
// Table size: 14 cols × 7 rows

export renderEnvBias(table t, int curMonth, int curQtr, SCTheme theme) =>
    float[] R1D  = array.from( 1.558,-0.288, 2.778, 0.604, 0.588, 0.626,-1.189,-0.611, 1.186, 1.347, 1.148, 1.552)
    float[] R7D  = array.from( 6.232, 5.630,-0.060, 3.751, 5.577, 0.554, 1.377, 2.038,-1.237, 4.541, 2.357, 4.973)
    float[] R28D = array.from( 3.164,13.773,-0.416,11.142, 9.625, 0.320, 8.331, 1.843,-3.163,17.278, 7.676, 9.130)
    float[] RQTR = array.from( 5.507, 7.029, 2.337,11.361)

    int mIdx = curMonth - 1
    int qIdx = curQtr - 1

    // Composite
    float mx1 = 0.0, float mx7 = 0.0, float mx28 = 0.0
    for i = 0 to 11
        mx1  := math.max(mx1,  math.abs(array.get(R1D,i)))
        mx7  := math.max(mx7,  math.abs(array.get(R7D,i)))
        mx28 := math.max(mx28, math.abs(array.get(R28D,i)))

    float[] COMP = array.new<float>(12,0.0)
    for i = 0 to 11
        float n1  = mx1>0  ? array.get(R1D,i)/mx1   : 0.0
        float n7  = mx7>0  ? array.get(R7D,i)/mx7   : 0.0
        float n28 = mx28>0 ? array.get(R28D,i)/mx28 : 0.0
        array.set(COMP,i,(n1+n7+n28)/3.0)

    float curComp = array.get(COMP,mIdx)
    float curQtrR = array.get(RQTR,qIdx)

    int row = 0
    table.cell(t,0,row,"BTC SEASONALITY",text_color=theme.cyan,bgcolor=theme.bg,text_size=size.small,text_halign=text.align_center)
    table.merge_cells(t,0,row,13,row), row+=1

    string[] MO = array.from("JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC")
    table.cell(t,0,row,"",bgcolor=theme.hdr)
    for i = 0 to 11
        table.cell(t,i+1,row,array.get(MO,i),text_color=color.white,bgcolor=i==mIdx?theme.hl:theme.hdr,text_size=size.tiny,text_halign=text.align_center)
    table.cell(t,13,row,"QTR",text_color=color.white,bgcolor=theme.hdr,text_size=size.tiny,text_halign=text.align_center), row+=1

    // 1D
    table.cell(t,0,row,"1D AVG %",text_color=theme.dim,bgcolor=theme.row,text_size=size.tiny)
    for i = 0 to 11
        float v = array.get(R1D,i)
        table.cell(t,i+1,row,str.tostring(v,"#.##"),text_color=_rCol(v,theme),bgcolor=i==mIdx?theme.hl:theme.row,text_size=size.tiny)
    table.cell(t,13,row,"",bgcolor=theme.row), row+=1

    // 7D
    table.cell(t,0,row,"7D AVG %",text_color=theme.dim,bgcolor=theme.row2,text_size=size.tiny)
    for i = 0 to 11
        float v = array.get(R7D,i)
        table.cell(t,i+1,row,str.tostring(v,"#.##"),text_color=_rCol(v,theme),bgcolor=i==mIdx?theme.hl:theme.row2,text_size=size.tiny)
    table.cell(t,13,row,"",bgcolor=theme.row2), row+=1

    // 28D
    table.cell(t,0,row,"28D AVG %",text_color=theme.dim,bgcolor=theme.row,text_size=size.tiny)
    for i = 0 to 11
        float v = array.get(R28D,i)
        table.cell(t,i+1,row,str.tostring(v,"#.##"),text_color=_rCol(v,theme),bgcolor=i==mIdx?theme.hl:theme.row,text_size=size.tiny)
    table.cell(t,13,row,str.tostring(curQtrR,"#.##"),text_color=_rCol(curQtrR,theme),bgcolor=theme.row,text_size=size.tiny), row+=1

    // Composite
    table.cell(t,0,row,"COMPOSITE",text_color=color.white,bgcolor=theme.row2,text_size=size.tiny)
    for i = 0 to 11
        float v = array.get(COMP,i)
        table.cell(t,i+1,row,str.tostring(v,"#.##"),text_color=_rCol(v,theme),bgcolor=i==mIdx?theme.hl:theme.row2,text_size=size.tiny)
    table.cell(t,13,row,"Q"+str.tostring(curQtr),text_color=color.white,bgcolor=theme.row2,text_size=size.tiny), row+=1

    // Summary
    string biasStr = curComp>0.2 ? "BULLISH" : curComp<-0.2 ? "BEARISH" : "NEUTRAL"
    color biasBg = curComp>0.2 ? #00501E : curComp<-0.2 ? #641414 : #32321E
    table.cell(t,0,row,"NOW",text_color=color.white,bgcolor=biasBg,text_size=size.tiny)
    table.cell(t,1,row,array.get(MO,mIdx),text_color=color.white,bgcolor=biasBg,text_size=size.tiny)
    table.cell(t,2,row,"1D: "+str.tostring(array.get(R1D,mIdx),"#.##")+"%",text_color=color.white,bgcolor=biasBg,text_size=size.tiny)
    table.cell(t,3,row,"7D: "+str.tostring(array.get(R7D,mIdx),"#.##")+"%",text_color=color.white,bgcolor=biasBg,text_size=size.tiny)
    table.cell(t,4,row,"28D: "+str.tostring(array.get(R28D,mIdx),"#.##")+"%",text_color=color.white,bgcolor=biasBg,text_size=size.tiny)
    table.cell(t,5,row,"Q"+str.tostring(curQtr)+": "+str.tostring(curQtrR,"#.##")+"%",text_color=color.white,bgcolor=biasBg,text_size=size.tiny)
    table.cell(t,6,row,"BIAS: "+biasStr,text_color=color.white,bgcolor=biasBg,text_size=size.tiny)
    for i = 7 to 13
        table.cell(t,i,row,"",bgcolor=biasBg)
    true
