//@version=5
library("logreg_support_lib")

// Sigmoid function
export sigmoid(float z) =>
    1.0 / (1.0 + math.exp(-z))

// Deterministic PRNG in [0, 1)
export prng01(float seed1, float seed2) =>
    float r = math.sin(seed1 * 12.9898 + seed2 * 78.233) * 43758.5453
    float ab = math.abs(r)
    float rfraw = ab - math.floor(ab)
    float rf = math.max(0.0, math.min(rfraw, 0.999999))
    rf

// Normalize value to [0..1] using min/max, with NA and zero-range guards
export normalize(float value, float minval, float maxval) =>
    if na(value) or na(minval) or na(maxval)
        0.0
    else if maxval - minval == 0
        0.0
    else
        (value - minval) / (maxval - minval)

// Percentile with NA filtering on arrays
export calcpercentilefast(array<float> arr, float percentile) =>
    int size = array.size(arr)
    var array<float> clean = array.new_float(0)
    array.clear(clean)
    for i = 0 to size - 1
        float v = array.get(arr, i)
        if not na(v)
            array.push(clean, v)
    int csize = array.size(clean)
    float res = na
    if csize >= 10
        array.sort(clean, order.ascending)
        int idx = math.round((percentile / 100.0) * (csize - 1))
        res := array.get(clean, idx)
    res

// Series percentile sampling by stride
export calcpercentile_series_sampled(series float s, int length, float percentile, int stride) =>
    var array<float> tmp = array.new_float(0)
    array.clear(tmp)
    int last = math.max(math.min(length - 1, bar_index), 0)
    for i = 0 to last
        if i % stride == 0
            array.push(tmp, s[i])
    calcpercentilefast(tmp, percentile)

// Enhanced range calculation with optional logarithmic scaling
export calcRangeWithLog(float value, float minval, float maxval, bool uselog) =>
    float result = 0.0
    if uselog
        float logMin = math.log(math.max(0.001, minval))
        float logMax = math.log(math.max(0.001, maxval))
        float logVal = math.log(math.max(0.001, value))
        float logRange = logMax - logMin
        result := logRange != 0 ? (logVal - logMin) / logRange : 0.5
    else
        float rangewidth = maxval - minval
        result := rangewidth != 0 ? (value - minval) / rangewidth : 0.5
    result := math.max(0.0, math.min(1.0, result))
    result

// Momentum calculation supporting multiple types
export calcMomentumAdvanced(series float src, int length, string momType) =>
    float result = 0.0
    float prevVal = src[length]
    switch momType
        "Difference" =>
            result := src - prevVal
        "ROC" =>
            if prevVal != 0
                result := (src - prevVal) / prevVal * 100.0
            else
                result := 0.0
        "StdDev" =>
            float rawMom = src - prevVal
            float stddev = ta.stdev(src, length)
            result := stddev != 0 ? rawMom / stddev : 0.0
        "Positive Unbounded" =>
            float rawMom2 = src - prevVal
            result := math.max(0.0, rawMom2)
        "Bouncing" =>
            float ma = ta.sma(src, length)
            float distance = src - ma
            float atrnorm = ta.atr(length)
            if atrnorm != 0
                float normalized = distance / atrnorm
                result := math.sign(normalized) * math.pow(math.abs(normalized), 0.5)
            else
                result := 0.0
        =>
            result := 0.0
    result

// Type-specific momentum normalization and clamping
export normalizeMomentumByType(float rawMom, string momType, float momMin, float momMax, float momNorm) =>
    float normalized = 0.0
    switch momType
        "Difference" =>
            if momNorm != 0
                normalized := math.max(-2.0, math.min(2.0, rawMom / momNorm))
            else
                normalized := 0.0
        "StdDev" =>
            if momNorm != 0
                normalized := math.max(-2.0, math.min(2.0, rawMom / momNorm))
            else
                normalized := 0.0
        "ROC" =>
            normalized := math.max(-2.0, math.min(2.0, rawMom / 50.0))
        "Positive Unbounded" =>
            float maxAbs = math.max(math.abs(momMin), math.abs(momMax))
            if maxAbs != 0
                normalized := math.min(2.0, rawMom / maxAbs)
            else
                normalized := 0.0
        "Bouncing" =>
            normalized := math.max(-2.0, math.min(2.0, rawMom))
        =>
            normalized := 0.0
    normalized

// Extended version that supports external bouncing decay parameter
export normalizeMomentumByTypeExt(float rawMom, string momType, float momMin, float momMax, float momNorm, float bouncingdecay) =>
    float normalized = 0.0
    switch momType
        "Difference" =>
            if momNorm != 0
                normalized := math.max(-2.0, math.min(2.0, rawMom / momNorm))
            else
                normalized := 0.0
        "StdDev" =>
            if momNorm != 0
                normalized := math.max(-2.0, math.min(2.0, rawMom / momNorm))
            else
                normalized := 0.0
        "ROC" =>
            normalized := math.max(-2.0, math.min(2.0, rawMom / 50.0))
        "Positive Unbounded" =>
            float maxAbs = math.max(math.abs(momMin), math.abs(momMax))
            if maxAbs != 0
                normalized := math.min(2.0, rawMom / maxAbs)
            else
                normalized := 0.0
        "Bouncing" =>
            float base = momNorm != 0 ? (rawMom / momNorm) : rawMom
            float dist = math.min(1.0, math.abs(base))
            float weight = math.exp(-bouncingdecay * dist)
            float bounced = base * weight
            normalized := math.max(-2.0, math.min(2.0, bounced))
        =>
            normalized := 0.0
    normalized

// Rolling standard deviation helper
export calcrollingstddev(series float src, int length) =>
    float sumsq = 0.0
    float sumval = 0.0
    for i = 0 to length - 1
        float val = src[i]
        sumval += val
        sumsq += val * val
    float mean = sumval / length
    float variance = (sumsq / length) - (mean * mean)
    math.sqrt(math.max(variance, 0))

// Log buffer helper for Pine logs with flush when near length cap
export addlog(string buffer, string level, string msg) =>
    // Build line
    string prefix = "[" + str.tostring(time, "yyyy-MM-dd HH:mm") + "] " + level + ": "
    string line   = prefix + msg + "\n"

    // Working buffer
    string buf = buffer
    int bufLen  = str.length(buf)
    int lineLen = str.length(line)

    // Approximate string limit and 85% threshold
    int maxStr   = 4096
    int threshold = 3480  // ~85% of 4096

    // If buffer already at/over threshold, dump and clean
    if bufLen >= threshold
        if bufLen > 0
            log.info(buf)
        buf := ""
        bufLen := 0

    // If adding this line would overflow the string, dump and clean first
    if bufLen + lineLen >= maxStr
        if bufLen > 0
            log.info(buf)
        buf := ""

    // Append and return
    buf + line

// Feature correlation on arrays (Pearson)
export calcfeaturecorrelation(array<float> x1, array<float> x2) =>
    int n = math.min(array.size(x1), array.size(x2))
    if n < 10
        na
    else
        float sumx1 = 0.0, sumx2 = 0.0
        float sumx1sq = 0.0, sumx2sq = 0.0
        float sumx1x2 = 0.0
        for i = 0 to n - 1
            float v1 = array.get(x1, i)
            float v2 = array.get(x2, i)
            sumx1 += v1
            sumx2 += v2
            sumx1sq += v1 * v1
            sumx2sq += v2 * v2
            sumx1x2 += v1 * v2
        float meanx1 = sumx1 / n
        float meanx2 = sumx2 / n
        float cov = (sumx1x2 / n) - (meanx1 * meanx2)
        float stdx1 = math.sqrt(math.max((sumx1sq / n) - (meanx1 * meanx1), 0))
        float stdx2 = math.sqrt(math.max((sumx2sq / n) - (meanx2 * meanx2), 0))
        if stdx1 > 0 and stdx2 > 0
            cov / (stdx1 * stdx2)
        else
            0.0

// Noise ratio (coefficient of variation)
export calcnoiseratio(series float src, int lookback) =>
    float meanval = ta.sma(src, lookback)
    float stdval = ta.stdev(src, lookback)
    if math.abs(meanval) > 0
        stdval / math.abs(meanval)
    else
        na

// Compatibility score combining inverse correlation and variance diversity
export calccompatibilityscore(array<float> x1, array<float> x2) =>
    float corr = calcfeaturecorrelation(x1, x2)
    float diversity = 1.0 - math.abs(corr)
    float std1 = array.stdev(x1)
    float std2 = array.stdev(x2)
    float scalediversity = math.abs(math.log(std1 / std2 + 1)) / 2
    math.min(diversity + scalediversity * 0.2, 1.0)

// Forward/Backward return helper (explicit returnlookback)
export getfuturereturn(int offset, int returnlookback) =>
    float futureclose = na
    float currentclose = close[offset]
    if offset >= returnlookback
        futureclose := close[offset - returnlookback]
    float ret = na
    if not na(futureclose) and not na(currentclose) and currentclose != 0
        ret := (futureclose - currentclose) / currentclose
    ret

// MA dispatcher
export calculatema(series float source, int length, string matype) =>
    switch matype
        "SMA"  => ta.sma(source, length)
        "EMA"  => ta.ema(source, length)
        "WMA"  => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)
        "HMA"  => ta.hma(source, length)
        "RMA"  => ta.rma(source, length)
        => ta.ema(source, length)

// Adaptive trigger for a single source with history update
export adaptive_trigger_for_source(series float src, bool enabled, bool freeze, int lookback, float threshold, array<float> volahistory) =>
    bool triggered = false
    if enabled and not freeze
        float currentvola = calcrollingstddev(src, lookback)
        array.push(volahistory, currentvola)
        if array.size(volahistory) > lookback
            array.shift(volahistory)
        float avgvola = array.avg(volahistory)
        float stdvola = array.stdev(volahistory)
        if currentvola > avgvola + threshold * stdvola
            triggered := true
    triggered

// Multi-source adaptive trigger (5 sources). Returns true if any source triggers.
// Multi-source adaptive trigger (5 sources). Returns true if any source triggers.
export checkadaptivetrigger5(series float s1, bool enabled1, bool freeze1, array<float> hist1, series float s2, bool enabled2, bool freeze2, array<float> hist2, series float s3, bool enabled3, bool freeze3, array<float> hist3, series float s4, bool enabled4, bool freeze4, array<float> hist4, series float s5, bool enabled5, bool freeze5, array<float> hist5, int lookback, float threshold) =>
    bool t1 = adaptive_trigger_for_source(s1, enabled1, freeze1, lookback, threshold, hist1)
    bool t2 = adaptive_trigger_for_source(s2, enabled2, freeze2, lookback, threshold, hist2)
    bool t3 = adaptive_trigger_for_source(s3, enabled3, freeze3, lookback, threshold, hist3)
    bool t4 = adaptive_trigger_for_source(s4, enabled4, freeze4, lookback, threshold, hist4)
    bool t5 = adaptive_trigger_for_source(s5, enabled5, freeze5, lookback, threshold, hist5)
    t1 or t2 or t3 or t4 or t5

// Ring buffer start index helper
export ring_start_index(int rb_write_idx, int rb_count, int rb_cap) =>
    (rb_write_idx - rb_count + rb_cap + rb_cap) % rb_cap
