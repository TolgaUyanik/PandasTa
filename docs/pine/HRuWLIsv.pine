//@version=6

// @description TODO: The table displays monthly returns, profits, MDD, and number of trades.
// 월별 수익률, 수익, 최대손실폭, 거래횟수를 테이블로 나타냅니다.
library("MonthlyReturnTable")

// Input example
// 입력 예시
// Output mode and table position
// 출력 모드 및 테이블 위치
string mode          = input.string("ROI", title = "Mode", options = ["None", "ROI", "Profit", "MDD", "Trade"], group = "Monthly Return Table settings ──────────────", inline = "0", display = display.none)
string tablePosition = input.string(position.bottom_right, "Position", options = [position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group = "Monthly Return Table settings ──────────────", inline = "0", display = display.none)

// Precision and font size
// 정밀도 및 글자 크기
int precision = input.int(2, "Precision", minval = 0, group = "Monthly Return Table settings ──────────────", inline = "1", display = display.none)
int textSize  = input.int(12, "Text",     minval = 0, group = "Monthly Return Table settings ──────────────", inline = "1", display = display.none, tooltip = "Text size 0 = Auto")

// Table margins
// 테이블 여백
int marginTop    = input.int(0, "Top",    minval = 0, group = "Margin", inline = "2", display = display.none)
int marginBottom = input.int(0, "Bottom", minval = 0, group = "Margin", inline = "2", display = display.none)
int marginLeft   = input.int(0, "Left",   minval = 0, group = "Margin", inline = "3", display = display.none)
int marginRight  = input.int(0, "Right",  minval = 0, group = "Margin", inline = "3", display = display.none)

// Table colors (header, profit, loss, principal)
// 테이블 색상 (헤더, 수익, 손실, 본전)
var color colorHead = input.color(#808080, title = "Head", group = "Color", inline = "1", display = display.none)
var color colorBull = input.color(#089981, title = "Bull", group = "Color", inline = "1", display = display.none)
var color colorBear = input.color(#F23645, title = "Bear", group = "Color", inline = "1", display = display.none)
var color colorZero = input.color(#808080, title = "Zero", group = "Color", inline = "1", display = display.none)

// @function : get_table
// @param    : mode, tablePosition, precision, textSize, marginTop, marginBottom, marginLeft, marginRight, colorHead, colorBull, colorBear, colorZero
// @returns  : null, plot perfTable
export get_table(string mode = "ROI", string tablePosition = position.bottom_right, int precision = 2, int textSize = 12, int marginTop = 0, int marginBottom = 0, int marginLeft = 0, int marginRight = 0, color colorHead = #808080, color colorBull = #089981, color colorBear = #F23645, color colorZero = #808080) =>
	if mode != "None"
		// Date and result variables	
		// 날짜 및 결과 변수
		currentMonth = month(time)
		currentYear  = year(time)
		var currentMonthEquity = strategy.equity
		var currentYearEquity  = strategy.equity
		var currentMonthTrade  = strategy.closedtrades
		var currentYearTrade   = strategy.closedtrades

		// Initialize highest equity and MDD by month and year
		// 월, 연도별 최고 equity 및 MDD 초기화
		var float monthHighEquity = strategy.equity
		var float mddMonth = 0.0  
		var float yearHighEquity = strategy.equity
		var float mddYear = 0.0  

		// Array to store results and times
		// 결과와 시간을 저장하기 위한 배열
		var monthDataStack = array.new<float>(0)
		var monthTimeStack = array.new<int>(0)
		var yearDataStack  = array.new<float>(0)
		var yearTimeStack  = array.new<int>(0)

		// Detect the last candle (actually the last candle)
		// 마지막 직전 캔들 검출 (사실상 마지막 캔들)
		isLastCandle = bar_index == last_bar_index - 1

		// Accumulate the return, profit, and number of transactions starting from the second candle
		// 두번째 캔들부터 실행하여 수익률, 수익금, 거래 횟수를 누적함
		if bar_index > 0
			// Calculate Equity based on low price (reflecting the decrease from current strategy.equity to the candle low price)
			// 저가 기준 Equity 계산 (현재 strategy.equity에서 캔들 저가까지의 감소 반영)
			lowEquity = strategy.equity + strategy.position_size * (low - close)

			// Monthly best equity update (low price considered)
			// 월별 최고 equity 갱신 (저가 고려)
			monthHighEquity := math.max(monthHighEquity, lowEquity)
			// Calculate current MDD (the difference between the current equity and the monthly high equity)
			// 현재 MDD 계산 (월 최고 equity 대비 현재 equity의 낙폭)
			currentMonthMDD = (monthHighEquity - lowEquity) / monthHighEquity * 100
			// Monthly MDD update (maintain maximum drop)
			// 월별 MDD 갱신 (최대 낙폭 유지)
			mddMonth := math.max(mddMonth, currentMonthMDD)

			// Monthly best equity update (low price considered)
			// 월별 최고 equity 갱신 (저가 고려)
			yearHighEquity := math.max(yearHighEquity, lowEquity)
			// Calculate current MDD (the difference between the current equity and the highest equity of the year)
			// 현재 MDD 계산 (연 최고 equity 대비 현재 equity의 낙폭)
			currentYearMDD = (yearHighEquity - lowEquity) / yearHighEquity * 100
			// MDD update by year (maintain maximum drop)
			// 연도별 MDD 갱신 (최대 낙폭 유지)
			mddYear := math.max(mddYear, currentYearMDD)

			// When it is a new month or the last candle of the chart
			// 새로운 월이거나 차트의 마지막 캔들 일때
			if currentMonth != currentMonth[1] or isLastCandle
				// Calculate yield, profit, and number of transactions
				// 수익률, 수익금, 거래 횟수 계산
				percentMonth = (strategy.equity / currentMonthEquity - 1) * 100
				profitMonth  = strategy.equity - currentMonthEquity
				tradeMonth   = strategy.closedtrades - currentMonthTrade

				// The values ​​entered into the array are different depending on the mode
				// 모드에 따라서 배열에 들어가는 값이 다름
				monthData = switch mode
					"ROI"    => percentMonth
					"Profit" => profitMonth
					"MDD"    => mddMonth * (-1)
					"Trade"  => tradeMonth
				// Put the values ​​and current time into the monthtime array
				// 값과 현재 시간을 월시간 배열에 넣음
				array.push(monthDataStack, monthData)
				array.push(monthTimeStack, time[1])

				// Update capital, number of transactions
				// 자본, 거래 횟수 업데이트
				currentMonthEquity := strategy.equity
				currentMonthTrade := strategy.closedtrades
				monthHighEquity := strategy.equity
				mddMonth := 0

			// When it is a new year or the last candle of the chart
			// 새로운 연도거나 차트의 마지막 캔들 일때
			if currentYear != currentYear[1] or isLastCandle
				// Calculate yield, profit, and number of transactions
				// 수익률, 수익금, 거래 횟수 계산
				percentYear = (strategy.equity / currentYearEquity - 1) * 100
				profitYear  = strategy.equity - currentYearEquity
				tradeYear   = strategy.closedtrades - currentYearTrade

				// The values ​​entered into the array are different depending on the mode
				// 모드에 따라서 배열에 들어가는 값이 다름
				yearData = switch mode
					"ROI"    => percentYear
					"Profit" => profitYear
					"MDD"    => mddYear * (-1)
					"Trade"  => tradeYear
				// Put the values ​​and current time into the monthtime array
				// 값과 현재 시간을 월시간 배열에 넣음
				array.push(yearDataStack, yearData)
				array.push(yearTimeStack, time[1])

				// Update capital, number of transactions
				// 자본, 거래 횟수 업데이트        
				currentYearEquity := strategy.equity
				currentYearTrade := strategy.closedtrades
				yearHighEquity := strategy.equity
				mddYear := 0  // 연 최대 낙폭 초기화

		// Create a table from the last candle
		// 마지막 직전 캔들에서 테이블 작성
		if isLastCandle
			// Total number of years and months
			// 총 연도 수와 월 수
			yearSize = array.size(yearDataStack)
			monthSize = array.size(monthDataStack)

			// Create table
			// 테이블 생성
			var table perfTable = table.new(position = tablePosition, columns = 14 + marginRight + marginLeft, rows = yearSize + 1 + marginTop + marginBottom, border_width = 1)

			// Calculate decimal precision and format the number representation
			// 소수점 정밀도를 계산하여 숫자 표현 형식 지정
			numFormat = "#,##0"
			if mode != "Trade" and precision > 0
				numFormat += "."
				for i = 0 to precision - 1
					numFormat += "0"

			// Header
			// 헤더
			table.cell(perfTable, marginLeft, marginTop, mode,                    text_size = textSize, text_color = chart.fg_color, bgcolor = color.new(colorHead, 75), text_formatting = text.format_bold)
			for i = 1 to 12
				table.cell(perfTable, i + marginLeft, marginTop, str.tostring(i), text_size = textSize, text_color = chart.fg_color, bgcolor = color.new(colorHead, 75), text_formatting = text.format_bold)
			table.cell(perfTable, 13 + marginLeft, marginTop, "Year",             text_size = textSize, text_color = chart.fg_color, bgcolor = color.new(colorHead, 60), text_formatting = text.format_bold)

			// Extract the maximum and minimum values ​​from the year/month results to change the cell background color
			// 셀 배경색을 바꾸기 위해 연월 결과 중 최대값과 최소값 추출
			maxMonth = array.max(monthDataStack)
			minMonth = array.min(monthDataStack)
			maxYear = array.max(yearDataStack)
			minYear = array.min(yearDataStack)

			// Backtest start year
			// 백테스트 시작 연도
			minTimeYear = array.min(yearTimeStack)

			// Monthly Results
			// 월별 결과
			for i = 0 to monthSize - 1
				// Extract one data from the month time array
				// 월 시간 배열에서 데이터 하나를 빼냄
				monthTime = array.pop(monthTimeStack)
				// Extract the value to be put into the cell from the month result array
				// 월 결과 배열에서 셀에 들어갈 값을 빼냄
				data = array.pop(monthDataStack)

				// Row is the current year minus the start year + 1
				// 행은 현재 연도에서 시작 연도를 빼고 + 1
				row = year(monthTime) - year(minTimeYear) + 1
				// Column is the current month
				// 열은 현재 월
				col = month(monthTime)
				
				// Font color
				// 글자색
				textColor = data == 0 ? colorZero : (data > 0 ? colorBull : colorBear)
				// Background color adjusts transparency from text color
				// 배경색은 글자색에서 투명도를 조절함
				backColor = color.new(textColor, transp = data > 0 ? 90 - math.abs(data) / maxMonth * 40 : 90 + math.abs(data) / minMonth * 40)
				// Monthly Results
				// 월별 결과
				table.cell(perfTable, col + marginLeft, row + marginTop, str.tostring(data, numFormat), text_size = textSize, text_color = textColor, bgcolor = backColor, text_halign = text.align_right)

			// Results by year
			// 연도별 결과
			for i = marginTop to marginTop + yearSize - 1
				// Extract one data from the time array
				// 연 시간 배열에서 데이터 하나를 빼냄
				yearTime = array.pop(yearTimeStack)
				// Row is the current year minus the start year + 1, columns are only the first and last
				// 행은 현재 연도에서 시작 연도를 빼고 + 1, 열은 첫번째와 마지막만 사용
				row = year(yearTime) - year(minTimeYear) + 1
				// Extract the value to be put into the cell from the result array
				// 연 결과 배열에서 셀에 들어갈 값을 빼냄
				data = array.pop(yearDataStack)
				
				// Font color
				// 글자색
				textColor = data == 0 ? colorZero : (data > 0 ? colorBull : colorBear)
				// Background color adjusts transparency from text color
				// 배경색은 글자색에서 투명도를 조절함
				backColor = color.new(textColor, transp = data > 0 ? 90 - math.abs(data) / maxYear * 40 : 90 + math.abs(data) / minYear * 40)
				// Year display column
				// 연도 표시 열
				table.cell(perfTable, marginLeft,      row + marginTop, str.tostring(year(yearTime)),  text_size = textSize, text_color = chart.fg_color, bgcolor = color.new(colorHead, 85))
				// Results by year
				// 연도별 결과
				table.cell(perfTable, 13 + marginLeft, row + marginTop, str.tostring(data, numFormat), text_size = textSize, text_color = textColor,      bgcolor = backColor, text_halign = text.align_right)

			// Create cells on the top, bottom, left, and right as much as the margins
			// 여백 만큼 상하좌우에 셀 생성
			if marginTop > 0
				for i = 0 to marginTop - 1
					table.cell(perfTable, 0, i, text_size = textSize)

			if marginBottom > 0
				for i = marginTop + yearSize to marginTop + yearSize + marginBottom - 1
					table.cell(perfTable, 0, i + 1, text_size = textSize)

			if marginLeft > 0
				for i = 0 to marginLeft - 1
					table.cell(perfTable, i, marginTop, text_size = textSize)

			if marginRight > 0
				for i = 14 + marginLeft to 14 + marginLeft + marginRight - 1
					table.cell(perfTable, i, marginTop, text_size = textSize)