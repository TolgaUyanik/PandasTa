// @version=5
// Thanks to the "Sessions Full Markets [TradingFinder] Forex Stocks  Index 7 Time by TFlab"

// @description Library for DST-adjusted Forex session detection. Returns session state and timing for a given bar.
library("ONS_ForexSessionLib", overlay = false)

// ─────────────────────────────────────────────
// @function Detects whether DST is Active or Inactive for a given timezone.
// @param Start_Month      Month DST begins (int)
// @param Start_Day        Day-of-week DST begins (int, use dayofweek.* constants)
// @param Start_CountDay   Nth occurrence of Start_Day in Start_Month (int)
// @param End_Month        Month DST ends (int)
// @param End_Day          Day-of-week DST ends (int)
// @param End_CountDay     Nth occurrence of End_Day in End_Month (int)
// @param TimeZone         IANA timezone string, use "Australia/Sydney" to invert logic (string)
// @returns                "Active" or "Inactive" (string)
export DST_Detector(
     int    Start_Month,
     int    Start_Day,
     int    Start_CountDay,
     int    End_Month,
     int    End_Day,
     int    End_CountDay,
     string TimeZone) =>

    var int  StartCountDay  = 0
    var int  EndCountDay    = 0
    var bool S_PermitCount  = true
    var bool E_PermitCount  = true
    var bool SS_PermitCount = true
    var bool EE_PermitCount = true
    var int  S = Start_CountDay
    var int  E = End_CountDay

    Y = year
    M = month
    D = dayofweek

    if M[1] != M
        StartCountDay  := 0
        EndCountDay    := 0
        SS_PermitCount := true
        EE_PermitCount := true

    if D[1] != D
        S_PermitCount := true
        E_PermitCount := true

    if D == Start_Day and S_PermitCount
        StartCountDay += 1
        S_PermitCount := false

    if D == End_Day and E_PermitCount
        EndCountDay += 1
        E_PermitCount := false

    // Resolve "last Sunday" (count == 4, checking if a 5th exists)
    if Start_CountDay < 4 and SS_PermitCount
        S := Start_CountDay
    else if Start_CountDay == 4 and SS_PermitCount
        if StartCountDay < 4
            S := 4
        else if StartCountDay[1] == 3 and StartCountDay == 4 and dayofmonth > 23
            S := 4
            SS_PermitCount := false
        else
            S := 5

    if End_CountDay < 4 and EE_PermitCount
        E := End_CountDay
    else if End_CountDay == 4 and EE_PermitCount
        if EndCountDay < 4
            E := 4
        else if EndCountDay[1] == 3 and EndCountDay == 4 and dayofmonth > 23
            E := 4
            EE_PermitCount := false
        else
            E := 5

    bool inDST = (M == Start_Month and StartCountDay >= S)
              or (M > Start_Month and M < End_Month)
              or (M == End_Month   and EndCountDay < E)

    // Australia/Sydney: DST is INACTIVE during Northern Hemisphere summer
    TimeZone == "Australia/Sydney" ? (inDST ? 'Inactive' : 'Active')
                                   : (inDST ? 'Active'   : 'Inactive')


// ─────────────────────────────────────────────
// @function Returns DST state for Sydney, London and New York at the current bar.
// @returns  [Sydney_DST, London_DST, NewYork_DST] — each "Active" or "Inactive" (tuple of strings)
export getDSTStates() =>
    Sydney_DST  = DST_Detector( 4, dayofweek.sunday, 1, 10, dayofweek.sunday, 1, "Australia/Sydney")
    London_DST  = DST_Detector( 3, dayofweek.sunday, 4, 10, dayofweek.sunday, 4, "Europe/London")
    NewYork_DST = DST_Detector( 3, dayofweek.sunday, 2, 11, dayofweek.sunday, 1, "America/New_York")
    [Sydney_DST, London_DST, NewYork_DST]


// ─────────────────────────────────────────────
// @function Returns UTC session strings for all Forex sessions, DST-adjusted.
// @param Sydney_DST   DST state string for Sydney  ("Active"/"Inactive")
// @param London_DST   DST state string for London  ("Active"/"Inactive")
// @param NewYork_DST  DST state string for New York ("Active"/"Inactive")
// @returns [Asia, Sydney, Tokyo, Shanghai, Europe, London, NewYork, NYSE] session strings (tuple of strings)
export getForexSessionStrings(
     string Sydney_DST,
     string London_DST,
     string NewYork_DST) =>

    // Fixed sessions (no DST)
    string Tokyo    = '2300-0700'
    string Shanghai = '0100-0900'

    // Sydney / Asia
    string Sydney = Sydney_DST == 'Active' ? '2100-0500' : '2200-0600'
    string Asia   = Sydney_DST == 'Active' ? '2100-0700' : '2200-0700'

    // Europe / London
    string Europe = London_DST == 'Active' ? '0600-1500' : '0700-1600'
    string London = London_DST == 'Active' ? '0700-1500' : '0800-1600'

    // New York / NYSE
    string NewYork = NewYork_DST == 'Active' ? '1200-2000' : '1300-2100'
    string NYSE    = NewYork_DST == 'Active' ? '1330-2000' : '1430-2100'

    [Asia, Sydney, Tokyo, Shanghai, Europe, London, NewYork, NYSE]


// ─────────────────────────────────────────────
// @function Returns 1 if the bar at the current series position is inside a session, 0 otherwise.
// @param sessionStr  Session string in "HHMM-HHMM" format (string)
// @param tz          IANA or UTC offset timezone string for the session (string)
// @returns           1 if inside session, 0 if outside (int)
export isInSession(string sessionStr, string tz) =>
    math.sign(nz(time(timeframe.period, sessionStr, tz)))


// ─────────────────────────────────────────────
// @function Returns 1 if a specific bar_index is inside a session (for point-in-time lookup).
// @param targetIndex  bar_index to test (int)
// @param sessionStr   Session string "HHMM-HHMM" (string)
// @param tz           IANA or UTC offset timezone string (string)
// @returns            1 if the target bar is/was inside session, 0 otherwise (int)
export isBarInSession(int targetIndex, string sessionStr, string tz) =>
    var int result = 0
    if bar_index == targetIndex
        result := int(math.sign(nz(time(timeframe.period, sessionStr, tz))))
    result


// ─────────────────────────────────────────────
// @function One-shot helper: given the current bar, returns open/closed state for all
//           DST-adjusted Forex sessions simultaneously.
// @returns  [inAsia, inSydney, inTokyo, inShanghai, inEurope, inLondon, inNewYork, inNYSE]
//           Each value is 1 (open) or 0 (closed). (tuple of ints)
export getAllForexSessions() =>
    [Sydney_DST, London_DST, NewYork_DST] = getDSTStates()
    [Asia, Sydney, Tokyo, Shanghai, Europe, London, NewYork, NYSE] =
         getForexSessionStrings(Sydney_DST, London_DST, NewYork_DST)

    UTC = 'UTC+0'
    inAsia     = isInSession(Asia,     UTC)
    inSydney   = isInSession(Sydney,   UTC)
    inTokyo    = isInSession(Tokyo,    UTC)
    inShanghai = isInSession(Shanghai, UTC)
    inEurope   = isInSession(Europe,   UTC)
    inLondon   = isInSession(London,   UTC)
    inNewYork  = isInSession(NewYork,  UTC)
    inNYSE     = isInSession(NYSE,     UTC)

    [inAsia, inSydney, inTokyo, inShanghai, inEurope, inLondon, inNewYork, inNYSE]
