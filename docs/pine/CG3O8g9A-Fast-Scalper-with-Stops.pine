//@version=6
strategy('VWAP Mean-Reversion Scalper 1:3', overlay = true, default_qty_type = strategy.percent_of_equity, default_qty_value = 1, commission_type = strategy.commission.percent, commission_value = 0.06)

rsiLength = input.int(14, 'RSI Length')
atrLength = input.int(14, 'ATR Length')
adxLength = input.int(14, 'ADX/DI Length')
adxSmoothing = input.int(14, 'ADX Smoothing')
adxThresh = input.int(25, 'ADX Ranging Threshold (below = ranging)')
rsiLongTh = input.int(40, 'RSI Long Threshold (below = oversold)')
rsiShortTh = input.int(60, 'RSI Short Threshold (above = overbought)')
stopMult = input.float(1.0, 'Stop, x ATR')
targetMult = input.float(3.0, 'Target, x ATR')
trailActMult = input.float(2.0, 'Trail Activation, x ATR')
trailOffMult = input.float(1.2, 'Trail Offset, x ATR')

vwap = ta.vwap(close)
rsi = ta.rsi(close, rsiLength)
atr = ta.atr(atrLength)

[diplus, diminus, adx] = ta.dmi(adxLength, adxSmoothing)

plot(vwap, color = color.orange, linewidth = 2, title = 'VWAP')

isRanging = adx < adxThresh

longSetup = close < vwap and rsi < rsiLongTh and isRanging
shortSetup = close > vwap and rsi > rsiShortTh and isRanging

if longSetup and strategy.position_size == 0
    strategy.entry('Long', strategy.long)
    strategy.exit('Long Exit', 'Long', stop = close - atr * stopMult, limit = close + atr * targetMult, trail_points = atr * trailActMult / syminfo.mintick, trail_offset = atr * trailOffMult / syminfo.mintick)

if shortSetup and strategy.position_size == 0
    strategy.entry('Short', strategy.short)
    strategy.exit('Short Exit', 'Short', stop = close + atr * stopMult, limit = close - atr * targetMult, trail_points = atr * trailActMult / syminfo.mintick, trail_offset = atr * trailOffMult / syminfo.mintick)
