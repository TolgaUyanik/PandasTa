//@version=6
indicator("Previous Day + Premarket Levels (actualiza 16:30 NY)", overlay=true, max_lines_count=100, max_labels_count=100)

// *** NUEVO: ventanas de tiempo NY para decidir qué “día” usar como previo
string _TZ = "America/New_York"
after430pm   = not na(time("1", "1630-2359", _TZ))     // 16:30 → 23:59 NY
before930am  = not na(time("1", "0000-0929", _TZ))     // 00:00 → 09:29 NY
useTodayAsPrev = after430pm or before930am             // de 16:30 a 09:29 usamos D[0] como “previo”

// ─────────────── Valores diarios (hoy y ayer) ───────────────
// *** NUEVO: pedimos HOY (D[0]) y AYER (D[1]) por separado
dHigh0  = request.security(syminfo.tickerid, "D", high,  lookahead=barmerge.lookahead_on)
dLow0   = request.security(syminfo.tickerid, "D", low,   lookahead=barmerge.lookahead_on)
dOpen0  = request.security(syminfo.tickerid, "D", open,  lookahead=barmerge.lookahead_on)
dClose0 = request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_on)

dHigh1  = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
dLow1   = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
dOpen1  = request.security(syminfo.tickerid, "D", open[1],  lookahead=barmerge.lookahead_on)
dClose1 = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// *** CAMBIO: “día previo” ahora puede ser HOY (después de 16:30 y antes de 9:30) o AYER (entre 9:30–16:30)
prevHigh  = useTodayAsPrev ? dHigh0  : dHigh1
prevLow   = useTodayAsPrev ? dLow0   : dLow1
prevOpen  = useTodayAsPrev ? dOpen0  : dOpen1
prevClose = useTodayAsPrev ? dClose0 : dClose1

// ─────────────── Detectar primera barra del día actual ───────────────
var int startBarToday = na
isNewDay = ta.change(time("D")) != 0
if isNewDay
    startBarToday := bar_index

// ─────────────── Premarket (4:00 - 9:30 NY) ───────────────
inPremarket = not na(time("5", "0400-0930", _TZ))

var float pmHigh = na
var float pmLow  = na

if isNewDay
    pmHigh := na
    pmLow  := na

if inPremarket
    pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
    pmLow  := na(pmLow)  ? low  : math.min(pmLow, low)

// ─────────────── Variables persistentes para líneas ───────────────
var line lPDH = na
var line lPDL = na
var line lPDO = na
var line lPDC = na
var line lPMH = na
var line lPML = na

// ─────────────── Variables persistentes para labels ───────────────
var label labPDH = na
var label labPDL = na
var label labPDO = na
var label labPDC = na
var label labPMH = na
var label labPML = na

// ─────────────── Dibujar/actualizar líneas ───────────────
if barstate.islastconfirmedhistory and not na(startBarToday)
    // Previous Day High
    if na(lPDH)
        lPDH := line.new(startBarToday, prevHigh, bar_index, prevHigh, xloc=xloc.bar_index, extend=extend.right, color=color.green, width=1)
    else
        line.set_xy1(lPDH, startBarToday, prevHigh), line.set_xy2(lPDH, bar_index, prevHigh)

    // Previous Day Low
    if na(lPDL)
        lPDL := line.new(startBarToday, prevLow, bar_index, prevLow, xloc=xloc.bar_index, extend=extend.right, color=color.green, width=1)
    else
        line.set_xy1(lPDL, startBarToday, prevLow), line.set_xy2(lPDL, bar_index, prevLow)

    // Previous Day Open
    if na(lPDO)
        lPDO := line.new(startBarToday, prevOpen, bar_index, prevOpen, xloc=xloc.bar_index, extend=extend.right, color=color.yellow, width=1)
    else
        line.set_xy1(lPDO, startBarToday, prevOpen), line.set_xy2(lPDO, bar_index, prevOpen)

    // Previous Day Close
    if na(lPDC)
        lPDC := line.new(startBarToday, prevClose, bar_index, prevClose, xloc=xloc.bar_index, extend=extend.right, color=color.yellow, width=1)
    else
        line.set_xy1(lPDC, startBarToday, prevClose), line.set_xy2(lPDC, bar_index, prevClose)

    // Premarket High
    if not na(pmHigh)
        if na(lPMH)
            lPMH := line.new(startBarToday, pmHigh, bar_index, pmHigh, xloc=xloc.bar_index, extend=extend.right, color=color.aqua, width=1)
        else
            line.set_xy1(lPMH, startBarToday, pmHigh), line.set_xy2(lPMH, bar_index, pmHigh)

    // Premarket Low
    if not na(pmLow)
        if na(lPML)
            lPML := line.new(startBarToday, pmLow, bar_index, pmLow, xloc=xloc.bar_index, extend=extend.right, color=color.aqua, width=1)
        else
            line.set_xy1(lPML, startBarToday, pmLow), line.set_xy2(lPML, bar_index, pmLow)

// ─────────────── Dibujar labels al inicio de cada línea ───────────────
if barstate.islast and not na(startBarToday)
    // Borrar labels viejos
    for lab in array.from(labPDH, labPDL, labPDO, labPDC, labPMH, labPML)
        if not na(lab)
            label.delete(lab)

    // Crear labels
    labPDH := label.new(startBarToday, prevHigh, "PREVIOUS DAY HIGH", style=label.style_label_up, color=color.green, textcolor=color.white, xloc=xloc.bar_index)
    labPDL := label.new(startBarToday, prevLow,  "PREVIOUS DAY LOW",  style=label.style_label_up, color=color.green, textcolor=color.white, xloc=xloc.bar_index)
    labPDO := label.new(startBarToday, prevOpen, "PREVIOUS DAY OPEN", style=label.style_label_up, color=color.yellow, textcolor=color.black, xloc=xloc.bar_index)
    labPDC := label.new(startBarToday, prevClose,"PREVIOUS DAY CLOSE",style=label.style_label_up, color=color.yellow, textcolor=color.black, xloc=xloc.bar_index)

    if not na(pmHigh)
        labPMH := label.new(startBarToday, pmHigh, "PREMARKET HIGH", style=label.style_label_up, color=color.aqua, textcolor=color.black, xloc=xloc.bar_index)
    if not na(pmLow)
        labPML := label.new(startBarToday, pmLow,  "PREMARKET LOW",  style=label.style_label_down, color=color.aqua, textcolor=color.black, xloc=xloc.bar_index)
