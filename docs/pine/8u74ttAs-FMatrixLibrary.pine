// ============================================================================
// F MATRIX LIBRARY  —  v1.0
// ============================================================================
// Shared constants and functions imported by all F Matrix process scripts.
// Import with: import <username>/FMatrixLib/1 as FM
//
// CONTENTS:
//   f_family()        — system code → family number (1–7)
//   f_execMode()      — family number → execution mode string
//   f_structure()     — family number → structure type string
//   f_tfStyle()       — TF string → Scalp / Day / Swing
//   f_regimeCompat()  — is structure compatible with current regime?
//   f_riskMin/Max()   — min/max R per style
//   f_minRR()         — minimum RR per style
//   f_ddState()       — DD R amount → "OK" / "DD" / "Deep DD"
//   f_aTier()         — all 9 gates → A-Tier bool
//   f_bTier()         — 4 core gates → B-Tier bool
//   f_regColor()      — regime string → display colour
//   f_tierColor()     — "A"/"B"/"None" → display colour
// ============================================================================
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// © Rafe-Promachos-LLP

//@version=6
library("FMatrixLibrary", overlay=false)

// ╔══════════════════════════════════════════════════════════════╗
// ║  SYSTEM FAMILY DETECTION                                    ║
// ║  Family number = leading digit of system code.              ║
// ║  1A → 1, 2G → 2, 7D → 7, etc.                              ║
// ╚══════════════════════════════════════════════════════════════╝
export f_family(string code) =>
    // Returns family number 1-7. Returns 0 if unrecognised.
    int n = int(str.tonumber(str.substring(code, 0, 1)))
    n >= 1 and n <= 7 ? n : 0

// ╔══════════════════════════════════════════════════════════════╗
// ║  EXECUTION MODE  (how the system trades)                    ║
// ║  Maps to "Designed Execution Mode" column in sheet 3.       ║
// ╚══════════════════════════════════════════════════════════════╝
// 1=Breakout, 2=Mean Reversion, 3=Trend Follow, 4=Reversal, 5=Pullback, 6=Breakout, 7=Breakout
export f_execMode(int fam) => fam == 1 ? "Breakout" : fam == 2 ? "Mean Reversion" : fam == 3 ? "Trend Follow" : fam == 4 ? "Reversal" : fam == 5 ? "Pullback" : fam == 6 ? "Breakout" : fam == 7 ? "Breakout" : "Unknown"

// ╔══════════════════════════════════════════════════════════════╗
// ║  STRUCTURE TYPE  (what market structure the system needs)   ║
// ║  Maps to "Structure Type" column in sheet 3.                ║
// ╚══════════════════════════════════════════════════════════════╝
// 1→Breakout, 2→Range, 3→Trend, 4→Transition, 5→Breakout, 6→Breakout, 7→Transition
export f_structure(int fam) => fam == 1 ? "Breakout" : fam == 2 ? "Range" : fam == 3 ? "Trend" : fam == 4 ? "Transition" : fam == 5 ? "Breakout" : fam == 6 ? "Breakout" : fam == 7 ? "Transition" : "Unknown"

// ╔══════════════════════════════════════════════════════════════╗
// ║  TIMEFRAME → STYLE CLASSIFICATION                           ║
// ║  Used to match systems to their correct risk tier.          ║
// ╚══════════════════════════════════════════════════════════════╝
// Returns "Scalp" / "Day" / "Swing" / "Unknown" — TF string as returned by timeframe.period
export f_tfStyle(string tf) => tf == "1" or tf == "3" or tf == "5" or tf == "15" ? "Scalp" : tf == "60" or tf == "240" ? "Day" : tf == "D" or tf == "1D" or tf == "W" or tf == "1W" ? "Swing" : "Unknown"

// ╔══════════════════════════════════════════════════════════════╗
// ║  REGIME COMPATIBILITY CHECK                                 ║
// ║  Is this system's structure type compatible with the        ║
// ║  regime currently active on its timeframe style?            ║
// ╚══════════════════════════════════════════════════════════════╝
export f_regimeCompat(string stype, string swingReg, string dayReg, string scalpReg, string tfStyle) =>
    // stype     = f_structure() output for this system (e.g. "Trend", "Breakout")
    // swingReg  = current swing regime (e.g. "Trend")
    // dayReg    = current day regime
    // scalpReg  = current scalp regime
    // tfStyle   = f_tfStyle() output for this system's TF
    string activeReg = tfStyle == "Swing" ? swingReg : tfStyle == "Day" ? dayReg : scalpReg
    stype == activeReg

// ╔══════════════════════════════════════════════════════════════╗
// ║  RISK PARAMETERS PER STYLE                                  ║
// ╚══════════════════════════════════════════════════════════════╝
export f_riskMin(string style) =>
    // Minimum R to risk per trade
    style == "Scalp" ? 0.5 : style == "Day" ? 1.0 : 2.0   // Swing = 2.0

export f_riskMax(string style) =>
    // Maximum R to risk per trade
    style == "Scalp" ? 0.75 : style == "Day" ? 1.5 : 3.0  // Swing = 3.0

export f_minRR(string style) =>
    // Minimum risk:reward ratio required
    style == "Scalp" ? 1.5 : style == "Day" ? 2.0 : 3.0   // Swing = 1:3

// ╔══════════════════════════════════════════════════════════════╗
// ║  DD STATE                                                   ║
// ╚══════════════════════════════════════════════════════════════╝
export f_ddState(float ddR) =>
    // ddR = max R loss from peak for this system
    // "OK" = no DD, "DD" = recovering, "Deep DD" = >= 3R
    ddR <= 0.0 ? "OK" : ddR >= 3.0 ? "Deep DD" : "DD"

// ╔══════════════════════════════════════════════════════════════╗
// ║  ELIGIBILITY TIERS                                          ║
// ║  A-Tier: all 9 gates pass → best conditions                 ║
// ║  B-Tier: 4 core gates pass but A-Tier fails → degraded ok   ║
// ╚══════════════════════════════════════════════════════════════╝
export f_aTier(bool enabled, bool ddOk, bool regimeOk, bool sessOk, bool dayOk, bool quarterOk, bool yearOk, bool equityOk, bool biasOk) =>
    enabled and ddOk and regimeOk and sessOk and dayOk and quarterOk and yearOk and equityOk and biasOk

export f_bTier(bool aTier, bool enabled, bool ddOk, bool regimeOk, bool equityOk) =>
    // B-Tier = NOT A-Tier but passes the 4 core gates
    not aTier and enabled and ddOk and regimeOk and equityOk

// ╔══════════════════════════════════════════════════════════════╗
// ║  COLOUR HELPERS                                             ║
// ╚══════════════════════════════════════════════════════════════╝
// Regime → display colour (matches MRD palette)
export f_regColor(string reg) => reg == "Trend" ? color.rgb(20, 140, 70) : reg == "Breakout" ? color.rgb(60, 220, 120) : reg == "Range" ? color.rgb(255, 200, 80) : reg == "Transition" ? color.rgb(255, 160, 40) : color.rgb(80, 80, 80)

export f_tierColor(string tier) => tier == "A" ? color.rgb(50, 200, 100) : tier == "B" ? color.rgb(255, 180, 30) : color.rgb(60, 60, 60)

export f_ddColor(string state) => state == "OK" ? color.rgb(50, 200, 100) : state == "DD" ? color.rgb(255, 180, 30) : state == "Deep DD" ? color.rgb(220, 50, 50) : color.rgb(80, 80, 80)