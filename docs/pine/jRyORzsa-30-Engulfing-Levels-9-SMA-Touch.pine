//@version=6
indicator("9 SMA Touch - 30% Levels", overlay=true, max_lines_count=500)

// Inputs
smaLength = input.int(9, title="SMA Length", minval=1)
lineLength = input.int(1, title="Line Length (Bars)", minval=1)

// Calculate SMA
sma9 = ta.sma(close, smaLength)
plot(sma9, color=color.orange, linewidth=2, title="9 SMA")

// Candle calculations
candleRange = high - low

// Upper and lower 30% levels
top30Level = high - candleRange * 0.30
bottom30Level = low + candleRange * 0.30

// Candle touches the SMA
touchesSMA = low <= sma9 and high >= sma9

// Draw horizontal lines
if touchesSMA
    line.new(
         x1=bar_index,
         y1=top30Level,
         x2=bar_index + lineLength,
         y2=top30Level,
         color=color.red,
         width=2)

    line.new(
         x1=bar_index,
         y1=bottom30Level,
         x2=bar_index + lineLength,
         y2=bottom30Level,
         color=color.lime,
         width=2)
