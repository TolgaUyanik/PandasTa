//@version=6
strategy('DESTY EMA21 EMA50 PRO', overlay = true, pyramiding = 0, max_boxes_count = 500, calc_on_every_tick = true)

//==================================================
// PARAMETRES
//==================================================
rr = input.float(2.0, 'Risk Reward', step = 0.1)
minPips = input.int(10, 'SL Minimum (Pips)', minval = 1)

//==================================================
// FILTRE ECART EMA (force de tendance)
//==================================================
useGapFilter = input.bool(true, 'Activer filtre écart EMA')
minGapPipsM30 = input.float(6.0, 'Ecart minimum EMA21/EMA50 - Forex M30 (Pips)', minval = 0.0, step = 0.5)
minGapPipsH1 = input.float(10.0, 'Ecart minimum EMA21/EMA50 - Forex H1 (Pips)', minval = 0.0, step = 0.5)
minGapPipsGold = input.float(80.0, 'Ecart minimum EMA21/EMA50 - Or XAUUSD (Pips)', minval = 0.0, step = 1.0)

//==================================================
// EMA
//==================================================
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)

plot(ema21, color = color.blue, linewidth = 2, title = 'EMA 21')
plot(ema50, color = color.black, linewidth = 2, title = 'EMA 50')

//==================================================
// PIPS FOREX / OR (XAUUSD)
//==================================================
isGold = str.contains(syminfo.ticker, 'XAU')
pipValue = isGold ? 0.1 : syminfo.type == 'forex' ? 0.0001 : syminfo.mintick
minDistance = minPips * pipValue

isM30 = timeframe.period == '30'
forexGapPips = isM30 ? minGapPipsM30 : minGapPipsH1
minGapDistance = (isGold ? minGapPipsGold : forexGapPips) * pipValue

//==================================================
// TENDANCE
//==================================================
bullTrend = ema21 > ema50
bearTrend = ema21 < ema50

//==================================================
// FILTRE ECART EMA
//==================================================
emaGap = math.abs(ema21 - ema50)
gapOK = not useGapFilter or emaGap >= minGapDistance

//==================================================
// CONTACT EMA21
//==================================================
touchEMA = low <= ema21 and high >= ema21

//==================================================
// PREMIER CONTACT UNIQUEMENT
//==================================================
var bool waitLong = false
var bool waitShort = false

if bullTrend and close > ema21
    waitLong := true
    waitLong

if bearTrend and close < ema21
    waitShort := true
    waitShort

buySignal = bullTrend and touchEMA and waitLong and gapOK
sellSignal = bearTrend and touchEMA and waitShort and gapOK

if buySignal
    waitLong := false
    waitLong

if sellSignal
    waitShort := false
    waitShort

//==================================================
// BOXS
//==================================================
var box longTPBox = na
var box longSLBox = na

var box shortTPBox = na
var box shortSLBox = na

//==================================================
// BUY
//==================================================
if buySignal and strategy.position_size == 0

    entry = ema21

    sl = ema50

    if entry - sl < minDistance
        sl := entry - minDistance
        sl

    risk = entry - sl
    tp = entry + risk * rr

    strategy.entry('BUY', strategy.long)

    box.delete(longTPBox)
    box.delete(longSLBox)

    longTPBox := box.new(left = bar_index, top = tp, right = bar_index + 20, bottom = entry, bgcolor = color.new(color.blue, 80), border_color = color.blue)

    longSLBox := box.new(left = bar_index, top = entry, right = bar_index + 20, bottom = sl, bgcolor = color.new(color.gray, 80), border_color = color.gray)
    longSLBox

//==================================================
// SELL
//==================================================
if sellSignal and strategy.position_size == 0

    entry = ema21

    sl = ema50

    if sl - entry < minDistance
        sl := entry + minDistance
        sl

    risk = sl - entry
    tp = entry - risk * rr

    strategy.entry('SELL', strategy.short)

    box.delete(shortTPBox)
    box.delete(shortSLBox)

    shortTPBox := box.new(left = bar_index, top = entry, right = bar_index + 20, bottom = tp, bgcolor = color.new(color.blue, 80), border_color = color.blue)

    shortSLBox := box.new(left = bar_index, top = sl, right = bar_index + 20, bottom = entry, bgcolor = color.new(color.gray, 80), border_color = color.gray)
    shortSLBox

//==================================================
// SORTIES LONG
//==================================================
if strategy.position_size > 0

    longSL = ema50

    if strategy.position_avg_price - longSL < minDistance
        longSL := strategy.position_avg_price - minDistance
        longSL

    longRisk = strategy.position_avg_price - longSL
    longTP = strategy.position_avg_price + longRisk * rr

    strategy.exit('BUY EXIT', from_entry = 'BUY', stop = longSL, limit = longTP)

//==================================================
// SORTIES SHORT
//==================================================
if strategy.position_size < 0

    shortSL = ema50

    if shortSL - strategy.position_avg_price < minDistance
        shortSL := strategy.position_avg_price + minDistance
        shortSL

    shortRisk = shortSL - strategy.position_avg_price
    shortTP = strategy.position_avg_price - shortRisk * rr

    strategy.exit('SELL EXIT', from_entry = 'SELL', stop = shortSL, limit = shortTP)

//==================================================
// FLECHES
//==================================================
plotshape(buySignal, title = 'BUY', style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.small)

plotshape(sellSignal, title = 'SELL', style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small)

//==================================================
// ALERTES
//==================================================
alertcondition(buySignal, title = 'BUY SIGNAL', message = 'DESTY BUY EMA21')

alertcondition(sellSignal, title = 'SELL SIGNAL', message = 'DESTY SELL EMA21')
