library("MichaelsEMARoids", overlay=true)

export short(int length, series float src = close) => 
	ta.ema(src, length)
export long(int length, series float src = close) => 
	ta.ema(src, length)
export longer(int length, series float src = close) => 
	ta.ema(src, length)