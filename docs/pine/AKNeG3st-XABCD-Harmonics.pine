//@version=6

// @description Library for detecting harmonic patterns (Butterfly, Gartley, Bat, Crab)
library("XABCD_Harmonics", overlay=true)

// ==================== CONSTANTS ====================
HARMONIC_TOLERANCE = 10  // Tolerance percentage for harmonic pattern ratios

// ==================== TYPES ====================

// @type PatternResult
// @field isValid (bool) Whether a valid pattern was found
// @field patternType (string) Type of pattern detected
// @field isBullish (bool) Whether the pattern is bullish
// @field pointX (float) X point price
// @field pointA (float) A point price  
// @field pointB (float) B point price
// @field pointC (float) C point price
// @field pointD (float) D point price
// @field barX (int) X point bar index
// @field barA (int) A point bar index
// @field barB (int) B point bar index
// @field barC (int) C point bar index
// @field barD (int) D point bar index
// @field targetPrice (float) Projected target price
export type PatternResult
    bool isValid
    string patternType
    bool isBullish
    float pointX
    float pointA
    float pointB
    float pointC
    float pointD
    int barX
    int barA
    int barB
    int barC
    int barD
    float targetPrice

// ==================== UTILITY FUNCTIONS ====================

// @function Find extreme value since last pivot for D point projection
// @param pivotValues (array<float>) Array of pivot values
// @param pivotBars (array<int>) Array of pivot bar indices
// @param currentBar (int) Current bar index
// @returns [bool, float, int] [use_extreme, extreme_value, extreme_bar]
export findExtremeValue(array<float> pivotValues, array<int> pivotBars, int currentBar) =>
    if array.size(pivotValues) < 2
        [false, na, na]
    else
        int lastIndex = array.size(pivotValues) - 1
        int prevIndex = lastIndex - 1
        
        int lastBarValue = array.get(pivotBars, lastIndex)
        float lastPivotValue = array.get(pivotValues, lastIndex)
        float prevPivotValue = array.get(pivotValues, prevIndex)
        
        bool isUpwardPivot = lastPivotValue > prevPivotValue
        
        float extremeValue = lastPivotValue
        int extremeBar = lastBarValue
        int barsToCheck = currentBar - lastBarValue
        
        // Find extreme point since last pivot
        for i = 0 to barsToCheck
            float candidateValue = isUpwardPivot ? low[i] : high[i]
            if (isUpwardPivot and candidateValue < extremeValue) or 
               (not isUpwardPivot and candidateValue > extremeValue)
                extremeValue := candidateValue
                extremeBar := currentBar - i
        
        [true, extremeValue, extremeBar]

// @function Validate harmonic pattern ratios
// @param moveXA (float) XA leg movement
// @param moveAB (float) AB leg movement  
// @param moveBC (float) BC leg movement
// @param moveCD (float) CD leg movement
// @param moveDA (float) DA leg movement
// @param moveAX (float) AX leg movement
// @param projectPointD (bool) Whether projecting point D
// @returns [bool, bool, bool, bool] [isButterfly, isGartley, isBat, isCrab]
export validateHarmonicRatios(float moveXA, float moveAB, float moveBC, float moveCD, float moveDA, float moveAX, bool projectPointD) =>
    // Calculate Fibonacci ratios
    float ratioAB_XA = math.abs(moveAB / moveXA)
    float ratioBC_AB = math.abs(moveBC / moveAB)
    float ratioCD_BC = math.abs(moveCD / moveBC)
    float ratioXD_XA = math.abs(moveDA) / math.abs(moveAX)
    
    // Tolerance factors
    float toleranceFactor = (100 - HARMONIC_TOLERANCE) / 100
    float toleranceFactorHigh = (100 + HARMONIC_TOLERANCE) / 100
    
    // Butterfly pattern ratios
    bool validButterflyAB = ratioAB_XA >= 0.786 * toleranceFactor and ratioAB_XA <= 0.786 * toleranceFactorHigh
    bool validButterflyBC = ratioBC_AB >= 0.382 and ratioBC_AB <= 0.886
    bool validButterflyCD = projectPointD ? true : ratioCD_BC >= 1.618 and ratioCD_BC <= 2.24
    bool validButterflyXD = projectPointD ? true : ratioXD_XA >= 1.27 and ratioXD_XA <= 1.618
    
    // Gartley pattern ratios
    bool validGartleyAB = ratioAB_XA >= 0.618 * toleranceFactor and ratioAB_XA <= 0.618 * toleranceFactorHigh
    bool validGartleyBC = validButterflyBC
    bool validGartleyCD = projectPointD ? true : ratioCD_BC >= 1.272 and ratioCD_BC <= 1.618
    bool validGartleyXD = projectPointD ? true : ratioXD_XA >= 0.786 * toleranceFactor and ratioXD_XA <= 0.786 * toleranceFactorHigh
    
    // Bat pattern ratios
    bool validBatAB = ratioAB_XA >= 0.382 and ratioAB_XA <= 0.50
    bool validBatBC = ratioBC_AB >= 0.382 and ratioBC_AB <= 0.886
    bool validBatCD = projectPointD ? true : validButterflyCD
    bool validBatXD = projectPointD ? true : ratioXD_XA >= 0.886 * toleranceFactor and ratioXD_XA <= 0.886 * toleranceFactorHigh
    
    // Crab pattern ratios
    bool validCrabAB = ratioAB_XA >= 0.382 and ratioAB_XA <= 0.618
    bool validCrabBC = ratioBC_AB >= 0.382 and ratioBC_AB <= 0.886
    bool validCrabCD = projectPointD ? true : ratioCD_BC >= 2.24 and ratioCD_BC <= 3.618
    bool validCrabXD = projectPointD ? true : ratioXD_XA >= 1.618 * toleranceFactor and ratioXD_XA <= 1.618 * toleranceFactorHigh
    
    // Pattern identification
    bool isButterfly = validButterflyAB and validButterflyBC and validButterflyCD and validButterflyXD
    bool isGartley = validGartleyAB and validGartleyBC and validGartleyCD and validGartleyXD
    bool isBat = validBatAB and validBatBC and validBatCD and validBatXD
    bool isCrab = validCrabAB and validCrabBC and validCrabCD and validCrabXD
    
    [isButterfly, isGartley, isBat, isCrab]

// @function Detect harmonic pattern from pivot data
// @param pivotValues (array<float>) Array of pivot values
// @param pivotBars (array<int>) Array of pivot bar indices
// @param currentBar (int) Current bar index
// @param projectPointD (bool) Whether to project point D
// @param useExtremeValue (bool) Whether to use extreme value for D point
// @param extremeValue (float) Extreme value for D point
// @param extremeBar (int) Extreme bar for D point
// @returns PatternResult Pattern detection result
export detectPattern(array<float> pivotValues, array<int> pivotBars, int currentBar, bool projectPointD, bool useExtremeValue, float extremeValue, int extremeBar) =>
    PatternResult result = PatternResult.new()
    result.isValid := false
    
    if array.size(pivotValues) < 3
        result
    else
        // Define pattern points
        float pointX = na
        float pointA = na
        float pointB = na
        float pointC = na
        float pointD = na
        int barX = na
        int barA = na
        int barB = na
        int barC = na
        int barD = na
        
        // Complete 5-point pattern
        if array.size(pivotValues) >= 5
            int i = array.size(pivotValues) - 5
            pointX := array.get(pivotValues, i)
            pointA := array.get(pivotValues, i + 1)
            pointB := array.get(pivotValues, i + 2)
            pointC := array.get(pivotValues, i + 3)
            pointD := array.get(pivotValues, i + 4)
            barX := array.get(pivotBars, i)
            barA := array.get(pivotBars, i + 1)
            barB := array.get(pivotBars, i + 2)
            barC := array.get(pivotBars, i + 3)
            barD := array.get(pivotBars, i + 4)
        
        // 4-point pattern with extreme value for D
        else if array.size(pivotValues) == 4 and useExtremeValue
            int i = array.size(pivotValues) - 4
            pointX := array.get(pivotValues, i)
            pointA := array.get(pivotValues, i + 1)
            pointB := array.get(pivotValues, i + 2)
            pointC := array.get(pivotValues, i + 3)
            pointD := extremeValue
            barX := array.get(pivotBars, i)
            barA := array.get(pivotBars, i + 1)
            barB := array.get(pivotBars, i + 2)
            barC := array.get(pivotBars, i + 3)
            barD := extremeBar
        
        // 3-point pattern with projection
        else if array.size(pivotValues) == 3 and useExtremeValue and projectPointD
            int i = array.size(pivotValues) - 3
            pointX := array.get(pivotValues, i)
            pointA := array.get(pivotValues, i + 1)
            pointB := array.get(pivotValues, i + 2)
            pointC := extremeValue
            barX := array.get(pivotBars, i)
            barA := array.get(pivotBars, i + 1)
            barB := array.get(pivotBars, i + 2)
            barC := extremeBar
        
        if not na(pointX) and not na(pointA) and not na(pointB) and not na(pointC)
            // Calculate pattern movements
            float moveXA = pointA - pointX
            float moveAB = pointB - pointA
            float moveBC = pointC - pointB
            float moveCD = na(pointD) ? na : pointD - pointC
            float moveDA = na(pointD) ? na : pointA - pointD
            float moveAX = pointX - pointA
            
            // Determine pattern direction
            bool isBearishPattern = pointX > pointA and pointB > pointA and pointC < pointB
            bool isBullishPattern = pointX < pointA and pointB < pointA and pointC > pointB
            
            if isBearishPattern or isBullishPattern
                // Validate pattern ratios
                [isButterfly, isGartley, isBat, isCrab] = validateHarmonicRatios(moveXA, moveAB, moveBC, moveCD, moveDA, moveAX, projectPointD)
                
                if isButterfly or isGartley or isBat or isCrab
                    // Project point D if needed
                    if projectPointD and na(pointD)
                        float ratio = isButterfly ? 1.618 : isGartley ? 0.786 : isBat ? 2.24 : isCrab ? 1.618 : na
                        if not na(ratio)
                            float cdLength = moveBC * ratio
                            pointD := isBullishPattern ? pointC + cdLength : pointC - cdLength
                            barD := currentBar
                    
                    // Calculate target price
                    float targetMove = na(moveDA) ? na : math.abs(moveDA)
                    float targetPrice = na(targetMove) ? na : (isBullishPattern ? pointD + targetMove : pointD - targetMove)
                    
                    // Set result
                    result.isValid := true
                    result.patternType := isButterfly ? "Butterfly" : isGartley ? "Gartley" : isBat ? "Bat" : "Crab"
                    result.isBullish := isBullishPattern
                    result.pointX := pointX
                    result.pointA := pointA
                    result.pointB := pointB
                    result.pointC := pointC
                    result.pointD := pointD
                    result.barX := barX
                    result.barA := barA
                    result.barB := barB
                    result.barC := barC
                    result.barD := barD
                    result.targetPrice := targetPrice
        
        result