// =============================================================================
// FUNCTION: getCurrency
// [EN] Returns "ARS" for peso CEDEARs, "USD MEP" for dollar MEP CEDEARs
//      Returns empty string if not a valid CEDEAR
// [ES] Retorna "ARS" para CEDEARs en pesos, "USD MEP" para CEDEARs en dolares MEP
//      Retorna cadena vacia si no es un CEDEAR valido
// =============================================================================
export getCurrency(simple string cedearTicker) =>
    switch cedearTicker
        "BCBA:AAL" => "ARS"  // AAL
        "BCBA:AALD" => "USD MEP"  // AAL
        "BCBA:AAP" => "ARS"  // AAP
        "BCBA:AAPD" => "USD MEP"  // AAP
