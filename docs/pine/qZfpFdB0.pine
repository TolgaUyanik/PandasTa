// =============================================================================
// FUNCTION: isValidCedear
// [EN] Returns true if the ticker is a valid CEDEAR in this library
// [ES] Retorna verdadero si el ticker es un CEDEAR valido en esta biblioteca
// =============================================================================
export isValidCedear(simple string cedearTicker) =>
    getUnderlying(cedearTicker) != ""
