// =============================================================================
// FUNCTION: getRatio
// [EN] Returns the CEDEAR:Underlying ratio (e.g., 20.0 means 20 CEDEARs = 1 share)
//      For inverse-ratio CEDEARs (1:X), returns 1/X as a decimal (e.g., 0.3333 for 1:3)
//      Returns 0.0 if not a valid CEDEAR
// [ES] Retorna el ratio CEDEAR:Subyacente (ej: 20.0 significa 20 CEDEARs = 1 accion)
//      Para CEDEARs con ratio inverso (1:X), retorna 1/X como decimal (ej: 0.3333 para 1:3)
//      Retorna 0.0 si no es un CEDEAR valido
// =============================================================================
export getRatio(simple string cedearTicker) =>
    switch cedearTicker
        "BCBA:AAL" => 2.0  // AAL
        "BCBA:AALD" => 2.0  // AAL [USD MEP]
        "BCBA:AAP" => 14.0  // AAP
