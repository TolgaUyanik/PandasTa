//@version=6
indicator("Lalu Bhai", overlay=true)

//==============================
// Indicators
//==============================
rsi15 = ta.rsi(close, 15)
ema10 = ta.ema(close, 10)

k = ta.stoch(close, high, low, 14)
d = ta.sma(k, 3)

close1 = close[1]
close2 = close[2]

//==============================
// Colors
//==============================
color currentVs1 = close > close1 ? color.green : color.red
color currentVs2 = close > close2 ? color.green : color.red

//==============================
// Table
//==============================
var table dashboard = table.new(position.top_right, 2, 8, border_width=1)

// Header
if barstate.isfirst
    table.cell(dashboard, 0, 0, "LALUBHAI", bgcolor=color.blue, text_color=color.white)
    table.cell(dashboard, 1, 0, "Value", bgcolor=color.blue, text_color=color.white)

// RSI
table.cell(dashboard, 0, 1, "Kailash", text_color=color.white)
table.cell(dashboard, 1, 1, str.tostring(rsi15, "#.##"),
     bgcolor = rsi15 >= 50 ? color.green : color.red,
     text_color = color.white)

// Current Close
table.cell(dashboard, 0, 2, "Current Close")
table.cell(dashboard, 1, 2, str.tostring(close, "#.##"),
     bgcolor = color.blue,
     text_color = color.white)

// Previous Close
table.cell(dashboard, 0, 3, "1 Day Ago Close")
table.cell(dashboard, 1, 3, str.tostring(close1, "#.##"),
     bgcolor = currentVs1,
     text_color = color.white)

// 2 Days Ago Close
table.cell(dashboard, 0, 4, "2 Days Ago Close")
table.cell(dashboard, 1, 4, str.tostring(close2, "#.##"),
     bgcolor = currentVs2,
     text_color = color.white)

// Stochastic %K
table.cell(dashboard, 0, 5, "SHIV")
table.cell(dashboard, 1, 5, str.tostring(k, "#.##"),
     bgcolor = k >= d ? color.green : color.red,
     text_color = color.white)

// Stochastic %D
table.cell(dashboard, 0, 6, "PARVATI")
table.cell(dashboard, 1, 6, str.tostring(d, "#.##"),
     bgcolor = d >= 50 ? color.green : color.red,
     text_color = color.white)

// EMA 10
table.cell(dashboard, 0, 7, "DRV")
table.cell(dashboard, 1, 7, str.tostring(ema10, "#.##"),
     bgcolor = close > ema10 ? color.green : color.red,
     text_color = color.white) 


