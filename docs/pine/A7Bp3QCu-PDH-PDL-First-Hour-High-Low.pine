//@version=6
indicator(title = 'PDH/PDL + First Hour High/Low', overlay = true, explicit_plot_zorder = true)

// === PDH/PDL Logic ===
showPDLevels = input.bool(true, 'Show PDH/PDL')
prevHigh = request.security(syminfo.tickerid, 'D', high[1], lookahead = barmerge.lookahead_on)
prevLow = request.security(syminfo.tickerid, 'D', low[1], lookahead = barmerge.lookahead_on)
newSession = ta.change(time('D'))

var line lineHigh = na
var line lineLow = na
var label labelHigh = na
var label labelLow = na

if bool(newSession) and showPDLevels
    line.delete(lineHigh)
    line.delete(lineLow)
    label.delete(labelHigh)
    label.delete(labelLow)

    lineHigh := line.new(x1 = bar_index, y1 = prevHigh, x2 = bar_index, y2 = prevHigh, width = 2, color = color.orange, extend = extend.right)
    lineLow := line.new(x1 = bar_index, y1 = prevLow, x2 = bar_index, y2 = prevLow, width = 2, color = color.orange, extend = extend.right)

    midX = bar_index + 30
    labelHigh := label.new(x = midX, y = prevHigh, text = 'PDH', textcolor = color.rgb(235, 94, 13), style = label.style_label_right, size = size.normal, color = color.white)
    labelLow := label.new(x = midX, y = prevLow, text = 'PDL', textcolor = color.rgb(232, 110, 16), style = label.style_label_right, size = size.normal, color = color.white)
    labelLow

if not barstate.islast
    line.set_x2(lineHigh, bar_index)
    line.set_x2(lineLow, bar_index)

// === First Hour High/Low Logic ===
showFirstHour = input.bool(true, 'Show First Hour High/Low')
showVerticalLine = input.bool(true, 'Show Vertical Line')

sessionTime = time('1440', session.regular)
hourHigh = request.security(syminfo.tickerid, '60', high)
hourLow = request.security(syminfo.tickerid, '60', low)

var line fhHLine = na
var line fhLLine = na
var line vLine = na
var line secLineLow = na
var line secLineHigh = na
var label upperLabel = na

if time - sessionTime == 3600000 and showFirstHour
    line.delete(fhHLine)
    line.delete(fhLLine)
    line.delete(secLineLow)
    line.delete(secLineHigh)
    label.delete(upperLabel)

    fhHLine := line.new(bar_index[1], hourHigh[1], bar_index, hourHigh[1], style = line.style_solid, color = #ce9700, width = 1, extend = extend.right)
    fhLLine := line.new(bar_index[1], hourLow[1], bar_index, hourLow[1], style = line.style_solid, color = #ce9700, width = 1, extend = extend.right)

    if showVerticalLine
        vLine := line.new(bar_index[1], hourHigh[1], bar_index[1], hourLow[1], color = color.rgb(252, 235, 0), width = 1)
        vLine

    perCh = (hourHigh[1] - hourLow[1]) / hourHigh[1] * 100
    if perCh > 1.5
        secLineLow := line.new(bar_index[1], hourLow[1] + 2, bar_index, hourLow[1] + 2, style = line.style_solid, color = color.new(color.red, 50), width = 1, extend = extend.right)
        secLineHigh := line.new(bar_index[1], hourHigh[1] - 2, bar_index, hourHigh[1] - 2, style = line.style_solid, color = color.new(color.green, 50), width = 1, extend = extend.right)
        secLineHigh

    labelCol = perCh > 1.5 ? color.rgb(241, 212, 169) : color.rgb(241, 212, 169)
    labelTextCol = color.rgb(220, 19, 19)
    upperLabel := label.new(x = bar_index[1], y = hourHigh[1] + 0.5, color = labelCol, textcolor = labelTextCol, text = str.format('{0,number,#.#} %', perCh))
    upperLabel
