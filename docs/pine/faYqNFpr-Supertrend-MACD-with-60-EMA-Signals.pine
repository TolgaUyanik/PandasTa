//@version=5
indicator("Supertrend & MACD with 60 EMA Signals", overlay=true)

// Input parameters for Supertrend
atrLength = input(10, title="ATR Length")
atrMultiplier = input(3.0, title="ATR Multiplier")

// Calculate Supertrend
[supertrend, direction] = ta.supertrend(atrMultiplier, atrLength)

// Calculate MACD
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
macdAboveZero = macdLine > 0
macdBelowZero = macdLine < 0

// Calculate 60 EMA
ema60 = ta.ema(close, 60)
ema60Rising = ta.change(ema60) > 0
ema60Falling = ta.change(ema60) < 0

// Buy and Sell Conditions in unison
buyCondition = (direction == -1) and macdAboveZero and ema60Rising
sellCondition = (direction == 1) and macdBelowZero and ema60Falling

// Plot Buy and Sell Signals
plotshape(buyCondition, style=shape.labelup, location=location.belowbar, color=color.green, size=size.small, text="Buy")
plotshape(sellCondition, style=shape.labeldown, location=location.abovebar, color=color.red, size=size.small, text="Sell")




