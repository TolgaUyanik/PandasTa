//@version=6

//        _____
// ______/_____======================>
// |___ BK AK-.50 CAL Ki11a ___|
//        /_/


// Attribution:
// This script includes original BK development and also incorporates / adapts
// selected dynamic support-resistance and trendline concepts inspired by work
// from TradingView author ata_sabanci.
//
// Full respect and credit to ata_sabanci for the original inspiration / source
// contribution. This publication is not intended to claim ownership over his
// work, but to show how it was expanded into a larger BK pattern-detection and
// execution framework.
//
// Educational tool only. No financial advice.
// ════════════════════════════════════════════════════════════════════════════


indicator("BK AK-.50 CAL Ki11a", "==[.50]=>", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200, max_polylines_count=100, calc_bars_count=5000, max_bars_back=1000)

// ════════════════════════════════════════════════════════════════════════════
// SOURCE
// ════════════════════════════════════════════════════════════════════════════
grpSrc  = "Source"
highSrc = input.source(high, "High Source", group=grpSrc, tooltip="Series for upper boundary regression and pivot highs.")
lowSrc  = input.source(low,  "Low Source",  group=grpSrc, tooltip="Series for lower boundary regression and pivot lows.")
// Segments-mode regression reads these up to (Lookback − 1) bars back (Lookback ceiling = 500),
// so guarantee a buffer that covers the full range — otherwise a high Lookback overflows Pine's
// auto-sized buffer at runtime ("historical offset beyond buffer's limit").
max_bars_back(highSrc, 510)
max_bars_back(lowSrc, 510)

// ════════════════════════════════════════════════════════════════════════════
// PIVOT DETECTION
// ════════════════════════════════════════════════════════════════════════════
grpPiv          = "Pivot Detection"
enablePivots    = input.bool(true, "Enable Pivot Detection", group=grpPiv)
pivotLeft       = input.int(5, "Left",  minval=1, maxval=100, group=grpPiv, inline="pv", tooltip="Bars to the LEFT required to confirm a pivot.")
pivotRight      = input.int(5, "Right", minval=1, maxval=100, group=grpPiv, inline="pv", tooltip="Bars to the RIGHT required to confirm a pivot (confirmation lag).")
maxPivots       = input.int(20, "Max Pivots Stored", minval=2, maxval=500, group=grpPiv, tooltip="Recent pivots of EACH type kept in memory (foundation for reversal matching).")
showPivots      = input.bool(true, "Show Pivot Markers (HH/LH/HL/LL)", group=grpPiv, inline="pm")
pivotHighColor  = input.color(color.rgb(255, 82, 82), "H", group=grpPiv, inline="pm")
pivotLowColor   = input.color(color.rgb(0, 230, 118), "L", group=grpPiv, inline="pm")
pivotMarkerSize = input.string(size.tiny, "Marker Size", [size.tiny, size.small, size.normal], group=grpPiv, inline="ps")
pivotMarkerTransp = input.int(0, "Transp", minval=0, maxval=100, group=grpPiv, inline="ps", tooltip="Transparency of the HH/LH/HL/LL letters. Letters only — no background.")

// ════════════════════════════════════════════════════════════════════════════
// OLS REGRESSION CHANNEL
// ════════════════════════════════════════════════════════════════════════════
grpCh         = "OLS Regression Channel"
enableChannel = input.bool(true, "Enable Channel", group=grpCh)
chAnchorMode  = input.string("Pivots", "Anchor Mode", ["Pivots", "Segments"], group=grpCh, tooltip="PIVOTS = fit the rails through the recent swing pivots (channel wraps the live structure — use this for pattern recognition). SEGMENTS = rolling regression over a fixed bar window (linear-regression-channel style).")
chPivotsUse   = input.int(4, "Pivots to Fit", minval=2, maxval=10, group=grpCh, tooltip="PIVOTS mode: number of recent pivot highs / lows the regression is fit through. The channel spans from the earliest of these to the current bar.")
chRideExtremes= input.bool(true, "Rails Ride Extremes", group=grpCh, tooltip="ON = keep the regression SLOPE but shift each rail to sit ON the extreme swing (upper rides the highs as resistance, lower rides the lows as support) — a true tradeable trendline. OFF = pure least-squares line floating through the middle of the pivots.")
chLookback    = input.int(100, "Lookback (bars)", minval=10, maxval=500, group=grpCh, tooltip="SEGMENTS mode only: fixed fit window.")
chSegments    = input.int(5, "Anchor Segments", minval=2, maxval=20, group=grpCh, tooltip="SEGMENTS mode only: window split into N equal segments; each segment's extreme becomes a regression anchor.")
chShowUpper   = input.bool(true, "Up",  group=grpCh, inline="cl")
chShowLower   = input.bool(true, "Low", group=grpCh, inline="cl")
chShowMid     = input.bool(true, "Mid", group=grpCh, inline="cl")
chUpperColor  = input.color(color.rgb(255, 123, 0),   "", group=grpCh, inline="cl")
chLowerColor  = input.color(color.rgb(255, 123, 0),   "", group=grpCh, inline="cl")
chMidColor    = input.color(color.rgb(130, 130, 150), "", group=grpCh, inline="cl")
chWidth       = input.int(2, "Width", minval=1, maxval=5, group=grpCh, inline="cs")
chStyle       = input.string("Dashed", "Style", ["Solid", "Dashed", "Dotted"], group=grpCh, inline="cs")
chExtend      = input.bool(false, "Extend →", group=grpCh, inline="cs")
chShowFill    = input.bool(true, "Channel Fill", group=grpCh, inline="cf")
chFillColor   = input.color(color.rgb(255, 123, 0), "", group=grpCh, inline="cf")
chFillTransp  = input.int(99, "Transp", minval=50, maxval=99, step=1, group=grpCh, inline="cf")
midExtendBars = input.int(21, "Extend Midline (bars)", minval=0, maxval=100, group=grpCh, tooltip="Project the dotted midline this many bars past the current bar.")
midExtendLabel= input.bool(true, "Extend Pattern Label with Midline", group=grpCh, tooltip="ON = the pattern label rides the extended midline end (current bar + N). OFF = label stays at the current bar.")

// ════════════════════════════════════════════════════════════════════════════
// PATTERN CLASSIFICATION
// ════════════════════════════════════════════════════════════════════════════
grpCls         = "Pattern Classification"
enableClassify = input.bool(true, "Enable Classification", group=grpCls)
allowChannels  = input.bool(true, "Channels",  group=grpCls, inline="fam")
allowWedges    = input.bool(true, "Wedges",    group=grpCls, inline="fam")
allowTriangles = input.bool(true, "Triangles", group=grpCls, inline="fam")
allowRising    = input.bool(true, "Bullish", group=grpCls, inline="bia")
allowFalling   = input.bool(true, "Bearish", group=grpCls, inline="bia")
allowNeutral   = input.bool(true, "Neutral", group=grpCls, inline="bia")
flatThreshold  = input.float(0.05, "Flat Threshold (ATR/bar)", minval=0.0, maxval=1.0, step=0.01, group=grpCls, tooltip="A boundary slope below this (normalized by ATR) is treated as FLAT — drives ascending/descending triangle detection.")
convThreshold  = input.float(0.20, "Convergence Threshold", minval=0.0, maxval=1.0, step=0.05, group=grpCls, tooltip="Fractional change in channel width across the window to count as converging (wedge/triangle) or diverging (expanding).")
minWidthATR    = input.float(0.5, "Min Width (×ATR)", minval=0.0, maxval=20.0, step=0.1, group=grpCls, tooltip="Minimum channel width (in ATR) for a pattern to register — filters noise.")
minR2          = input.float(0.0, "Min Fit R²", minval=0.0, maxval=1.0, step=0.05, group=grpCls, tooltip="Minimum regression fit quality (0–1) to display a pattern. Raise to show only clean structures.")

// ════════════════════════════════════════════════════════════════════════════
// PATTERN LABEL
// ════════════════════════════════════════════════════════════════════════════
grpLbl              = "Pattern Label"
showPatternLabel    = input.bool(true, "Show Pattern Label", group=grpLbl)
patLabelSize        = input.string(size.small, "Size", [size.tiny, size.small, size.normal, size.large], group=grpLbl)
patLabelBg          = input.color(color.black, "BG", group=grpLbl, inline="lb")
patLabelBgTransp    = input.int(65, "Transp", minval=0, maxval=100, step=5, group=grpLbl, inline="lb")
biasBullColor       = input.color(color.rgb(0, 230, 118), "Bull", group=grpLbl, inline="bc")
biasBearColor       = input.color(color.rgb(255, 82, 82), "Bear", group=grpLbl, inline="bc")
biasNeutralColor    = input.color(color.rgb(200, 200, 210), "Neut", group=grpLbl, inline="bc")
enablePatternTooltip= input.bool(true, "Institutional Tooltip", group=grpLbl)

// ════════════════════════════════════════════════════════════════════════════
// STRENGTH SCORE  (R²-driven)
// ════════════════════════════════════════════════════════════════════════════
grpStr          = "Strength Score"
enableStrength  = input.bool(true, "Enable Strength Score", group=grpStr)
showScoreBadge  = input.bool(true, "Show Badge on Label", group=grpStr)
minScoreDisplay = input.float(1.0, "Min Score to Display", minval=1.0, maxval=10.0, step=0.5, group=grpStr, tooltip="Hide patterns scoring below this (1–10).")
mtfBonus        = input.float(1.2, "MTF Aligned Bonus", minval=1.0, maxval=2.0, step=0.1, group=grpStr, tooltip="Multiply score when HTF trend aligns with pattern bias.")

// ════════════════════════════════════════════════════════════════════════════
// MEASURED MOVE PROJECTIONS
// ════════════════════════════════════════════════════════════════════════════
grpMM       = "Measured Move Projections"
enableMM    = input.bool(true, "Enable Measured Moves", group=grpMM)
mmFib1      = input.float(0.618, "L1", minval=0.1, maxval=5.0, step=0.1, group=grpMM, inline="mf")
mmFib2      = input.float(1.0,   "L2", minval=0.1, maxval=5.0, step=0.1, group=grpMM, inline="mf")
mmFib3      = input.float(1.618, "L3", minval=0.1, maxval=5.0, step=0.1, group=grpMM, inline="mf")
mmShowT1    = input.bool(true, "T1", group=grpMM, inline="mt")
mmShowT2    = input.bool(false, "T2", group=grpMM, inline="mt")
mmShowT3    = input.bool(false, "T3", group=grpMM, inline="mt")
mmShowLabels= input.bool(true, "Labels", group=grpMM, inline="mt")
mmStyle     = input.string("Dashed", "Style", ["Solid", "Dashed", "Dotted"], group=grpMM, inline="ms")
mmWidth     = input.int(1, "Width", minval=1, maxval=4, group=grpMM, inline="ms")
mmTransp    = input.int(47, "Transp", minval=0, maxval=95, step=5, group=grpMM, inline="ms")
mmExtendBars= input.int(29, "Extend Bars", minval=5, maxval=200, group=grpMM, inline="me")
mmBullColor = input.color(color.rgb(0, 230, 118), "Bull", group=grpMM, inline="me")
mmBearColor = input.color(color.rgb(255, 82, 82), "Bear", group=grpMM, inline="me")
mmPrefix    = input.string("W", "Label Prefix", group=grpMM, tooltip="Prefix for target labels (e.g. W → W:T1).")

// ════════════════════════════════════════════════════════════════════════════
// BREAKOUT DECISION ZONE  (converging patterns only)
// ════════════════════════════════════════════════════════════════════════════
grpZone        = "Breakout Decision Zone"
enableZone     = input.bool(true, "Enable Decision Zone", group=grpZone, tooltip="Shade the apex region of converging patterns where resolution is forced.")
zonePct        = input.float(15.0, "Zone Width (%)", minval=5.0, maxval=50.0, step=5.0, group=grpZone, inline="zw")
zoneTransp     = input.int(97, "Transp", minval=50, maxval=98, step=1, group=grpZone, inline="zw")
zoneExtend     = input.int(2, "Extend (bars)", minval=0, maxval=100, group=grpZone, tooltip="Extend the decision-zone box this many bars to the right of the current bar.")
zoneBullColor  = input.color(color.rgb(0, 230, 118),  "Bull", group=grpZone, inline="zc")
zoneBearColor  = input.color(color.rgb(255, 82, 82),  "Bear", group=grpZone, inline="zc")
zoneNeutralColor = input.color(color.rgb(255, 235, 59), "Neut", group=grpZone, inline="zc")

// ════════════════════════════════════════════════════════════════════════════
// MTF CONFLUENCE
// ════════════════════════════════════════════════════════════════════════════
grpMtf      = "MTF Confluence"
enableMTF   = input.bool(true, "Enable MTF Confluence", group=grpMtf)
mtfTimeframe= input.timeframe("", "Higher Timeframe", group=grpMtf, inline="m1", tooltip="Blank = auto (≈3× current). Or set manually.")
mtfShowBadge= input.bool(true, "Badge", group=grpMtf, inline="m1")
mtfEmaFast  = input.int(21, "Fast EMA", minval=5, maxval=100, group=grpMtf, inline="m2")
mtfEmaSlow  = input.int(50, "Slow EMA", minval=20, maxval=400, group=grpMtf, inline="m2")
mtfTf2      = input.timeframe("240", "Confluence TF 2", group=grpMtf, inline="m3", tooltip="Two additional higher timeframes scored for confluence. Confluence = how many of the 3 HTFs agree with the setup direction.")
mtfTf3      = input.timeframe("D",   "Confluence TF 3", group=grpMtf, inline="m3")

// ════════════════════════════════════════════════════════════════════════════
// ADAPTIVE LEARNING  (per-timeframe outcome tracking + MTF-confluence split)
// ════════════════════════════════════════════════════════════════════════════
grpLearn      = "Adaptive Learning"
enableLearn   = input.bool(false, "Track Outcomes (learn)", group=grpLearn, tooltip="Log every channel break, flag break, and reversal as a setup, resolve it against an ATR-normalized target/stop, and accumulate per-pattern win rate and average duration on THIS timeframe. Each setup is tagged with MTF confluence at entry, so the panel reveals whether multi-timeframe alignment improves outcomes.")
learnTargetR  = input.float(2.0, "Target (ATR)", minval=0.5, maxval=20.0, step=0.5, group=grpLearn, inline="lr", tooltip="Outcome target distance from entry in ATR — volatility-normalized so win rates are comparable across timeframes.")
learnStopR    = input.float(1.0, "Stop (ATR)", minval=0.25, maxval=20.0, step=0.25, group=grpLearn, inline="lr")
learnMaxBars  = input.int(60, "Max Resolve (bars)", minval=5, maxval=500, group=grpLearn, tooltip="If neither target nor stop is hit within this many bars, the setup is recorded as a timeout.")
learnConfHi   = input.int(2, "High-Confluence ≥", minval=1, maxval=3, group=grpLearn, tooltip="A setup is high-confluence when at least this many of the 3 HTFs agree with its direction. Stats split hi vs lo to show whether MTF alignment helps.")
learnShowTbl  = input.bool(true, "Show Stats Panel", group=grpLearn, inline="lt")
learnTblPos   = input.string("Bottom Right", "Pos", ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=grpLearn, inline="lt")
enableRanker  = input.bool(true, "Adaptive Ranker (feed edge into score)", group=grpLearn, tooltip="Feed the learned per-pattern, per-confluence win rates back into the live Strength score. Patterns that are winning on THIS timeframe get weighted up; patterns that are failing get weighted down — in real time. Until enough setups have resolved, the multiplier stays at ~1.0 (no distortion).")
rankSens      = input.float(0.6, "Edge Sensitivity", minval=0.0, maxval=2.0, step=0.1, group=grpLearn, inline="rk", tooltip="How hard the learned win rate moves the score. 0 = ignore (×1.0 always). 0.6 = a shrunk 75% win rate gives ≈×1.3.")
rankConfSens  = input.float(0.5, "Conf Weight", minval=0.0, maxval=2.0, step=0.1, group=grpLearn, inline="rk", tooltip="How much current MTF confluence shifts the multiplier — scaled by whether high-confluence has HISTORICALLY helped this pattern. If confluence never helped, this does nothing even at high settings.")
rankPrior     = input.int(8, "Prior (shrinkage)", minval=1, maxval=100, group=grpLearn, inline="rk2", tooltip="Bayesian shrinkage strength. Win rates are pulled toward 50% until this many samples accumulate, so a 2-trade fluke can't swing the score. Higher = more conservative.")
rankMultMin   = input.float(0.5, "Min ×", minval=0.1, maxval=1.0, step=0.05, group=grpLearn, inline="rk3")
rankMultMax   = input.float(1.6, "Max ×", minval=1.0, maxval=3.0, step=0.1, group=grpLearn, inline="rk3")

// ════════════════════════════════════════════════════════════════════════════
// REGIME GATING  (trend vs range → weight the pattern family that fits)
// ════════════════════════════════════════════════════════════════════════════
grpRegime    = "Regime Gating"
enableRegime = input.bool(true, "Regime Gating", group=grpRegime, tooltip="Classify the market as TREND or RANGE from ADX, then weight conviction by fit: continuation patterns (channels, flags) up in trend, reversals up in range — and the reverse penalized. Suppresses the family most likely to fail in the current regime before it scores.")
adxLen       = input.int(14, "ADX / DI Length", minval=2, maxval=100, group=grpRegime, inline="rg")
adxThresh    = input.float(25.0, "Trend ≥ ADX", minval=10.0, maxval=60.0, step=1.0, group=grpRegime, inline="rg")
regimeStr    = input.float(0.25, "Gating Strength", minval=0.0, maxval=1.0, step=0.05, group=grpRegime, tooltip="How hard regime fit moves conviction. 0.25 = +25% to the aligned family, −12.5% to the misaligned one.")

// ════════════════════════════════════════════════════════════════════════════
// BREAKOUT & DIRECTION  (channel-level)
// ════════════════════════════════════════════════════════════════════════════
grpBrk         = "Breakout & Direction"
enableBreakout = input.bool(true, "Breakout Markers + Alerts", group=grpBrk, tooltip="Gates on-chart breakout triangles and alerts only. The dashboard Breakout read is ALWAYS live when rails exist.")
brkUseClose    = input.bool(true, "Use Close (vs Wick)", group=grpBrk, tooltip="ON = close beyond boundary. OFF = high/low wick beyond boundary.")
dirThreshold   = input.float(0.5, "Direction Threshold (%)", minval=0.0, maxval=10.0, step=0.1, group=grpBrk, tooltip="Midline % slope across the window: >+thr Bullish, <−thr Bearish, else Range.")
showBrkMarkers = input.bool(true, "Show Breakout Symbols", group=grpBrk, tooltip = "Optional visual-only breakout glyphs. OFF by default to keep the chart clean. Logic, dashboard, alerts, and learning are unaffected.")
brkUpColor     = input.color(color.rgb(0, 230, 118), "Up",   group=grpBrk, inline="bk")
brkDnColor     = input.color(color.rgb(255, 82, 82), "Down", group=grpBrk, inline="bk")
lockStructure  = input.bool(true, "Lock Structure for Breaks", group=grpBrk, tooltip="ON = the channel forms (rails refit live), then LOCKS once the pattern is confirmed. The break is then measured against the LOCKED rails, so exactly ONE marker fires at the decisive break of the structure you see — no false arrows during formation. OFF = legacy live read, which retests a refitting channel every bar and marks many transient crossings.")
lockConfirmBars= input.int(3, "Bars to Confirm Lock", minval=1, maxval=50, group=grpBrk, tooltip="Consecutive bars the pattern must stay valid before the structure locks.")
brkBufferATR   = input.float(0.25, "Break Buffer (ATR)", minval=0.0, maxval=3.0, step=0.05, group=grpBrk, tooltip="Price must close beyond the locked rail by this many ATR to confirm a break — filters marginal pokes that aren't real structure breaks.")
showNBreaks    = input.int(0, "Show Last N Break Symbols", minval=0, maxval=20, group=grpBrk, tooltip="How many of the most recent breakout glyphs to keep on the chart. 0 = none. This does not affect dashboard, alerts, or learning.")
brkMarkSize    = input.string(size.tiny, "Break Marker Size", [size.tiny, size.small, size.normal, size.large], group=grpBrk)
brkMarkUp      = input.string("▲", "Up Mark", group=grpBrk, inline="bmk", tooltip="Glyph drawn at an upside break. Any text/emoji.")
brkMarkDn      = input.string("▼", "Down Mark", group=grpBrk, inline="bmk", tooltip="Glyph drawn at a downside break.")
enableLifecycle= input.bool(true, "Retest / Confirm / Trap", group=grpBrk, tooltip="After a locked break, grade what price does next against the BROKEN rail: retest (price returns to the rail), confirm (price extends in the break direction), or trap (price closes back through the rail — a failed break).")
retestATR      = input.float(0.5, "Retest Proximity (ATR)", minval=0.05, maxval=5.0, step=0.05, group=grpBrk, tooltip="Price coming back within this many ATR of the broken rail counts as a retest.")
confirmATR     = input.float(1.0, "Confirm Travel (ATR)", minval=0.1, maxval=10.0, step=0.1, group=grpBrk, tooltip="Price extending this many ATR beyond the break level (in the break direction) confirms the break.")
trapATR        = input.float(0.25, "Trap Re-entry (ATR)", minval=0.0, maxval=5.0, step=0.05, group=grpBrk, tooltip="Price closing back through the broken rail by this many ATR (into the old structure) flags a trap / failed break.")
showLifeMarks  = input.bool(false, "Show Lifecycle Symbols", group=grpBrk, tooltip = "Optional visual-only retest/confirm/trap glyphs. OFF by default; these were the small diamonds / X marks. Logic, dashboard, alerts, and learning are unaffected.")

// ════════════════════════════════════════════════════════════════════════════
// FORWARD PROJECTION  (forecast the structure forward — rails, apex, target)
// ════════════════════════════════════════════════════════════════════════════
grpFwd        = "Forward Projection"
enableFwd     = input.bool(true, "Project Structure Forward", group=grpFwd, tooltip="Extends the rails past the current bar as a dotted forecast, marks the APEX where converging rails meet (the breakout deadline), and drops a target endpoint on the projected path — so the engine shows trajectory and destination, not just where the structure was.")
fwdBars       = input.int(38, "Projection Horizon (bars)", minval=5, maxval=300, group=grpFwd, tooltip="How many bars forward to extend the dotted rail forecast.")
fwdShowApex   = input.bool(false, "Mark Apex (converging)", group=grpFwd, tooltip="For wedges/triangles, projects to the convergence point and labels bars-to-apex. Most converging patterns resolve at 60–75% of the way to the apex.")
fwdShowTgt    = input.bool(false, "Project Target Endpoint", group=grpFwd, tooltip="Drops a labelled endpoint on the projected midline at the horizon — the forecast price/path destination.")
fwdColor      = input.color(color.new(color.orange, 25), "Forecast", group=grpFwd, inline="fw")
fwdApexColor  = input.color(color.new(color.yellow, 0), "Apex", group=grpFwd, inline="fw")

// ════════════════════════════════════════════════════════════════════════════
// REVERSAL PATTERNS  (pivot-geometry: Double Top/Bottom, Head & Shoulders)
// ════════════════════════════════════════════════════════════════════════════
grpRev        = "Reversal Patterns"
enableRev     = input.bool(true, "Detect Reversals", group=grpRev, tooltip="Scans the stored pivot sequence for Double Top / Double Bottom and Head & Shoulders / Inverse H&S. Independent of the channel engine — these are pivot-geometry reversals, not regression rails.")
revTolEq      = input.float(0.6, "Peak Equality Tol (ATR)", minval=0.05, maxval=3.0, step=0.05, group=grpRev, tooltip="How close two tops (or two bottoms, or the two shoulders) must sit in price to count as 'equal', in ATR units. Larger = looser matching.")
revBufATR     = input.float(0.20, "Neckline Break Buffer (ATR)", minval=0.0, maxval=3.0, step=0.05, group=grpRev, tooltip="Price must close beyond the neckline by this many ATR to confirm the reversal.")
revNeedBreak  = input.bool(false, "Require Neckline Break", group=grpRev, tooltip="ON = flag only once price closes through the neckline (confirmed ✓). OFF = flag the forming shape before the break (tentative ?).")
revShowNeck    = input.bool(true, "Show Neckline", group=grpRev)
revShowMarks   = input.bool(false, "Show Reversal Pivot Dots", group=grpRev, tooltip="Optional red/green circles on the shoulders/head or double-top/double-bottom pivots. OFF by default; renamed so old saved ON states do not force dots back onto the chart.")
revTopColor    = input.color(color.rgb(255, 82, 82), "Bearish", group=grpRev, inline="rv")
revBotColor    = input.color(color.rgb(0, 230, 118), "Bullish", group=grpRev, inline="rv")
revLblSize     = input.string(size.tiny, "Label Size", [size.tiny, size.small, size.normal], group=grpRev)
revExtendBars  = input.int(5, "Extend Neckline / Label (bars)", minval=0, maxval=300, group=grpRev)

// ════════════════════════════════════════════════════════════════════════════
// AUTO-ANCHORED VWAP  (standard 3-band, anchored to OLS rail start or breakout swing)
// ════════════════════════════════════════════════════════════════════════════
grpVwap       = "Auto-Anchored VWAP"
enableVwap    = input.bool(true, "Auto-Anchored VWAP", group=grpVwap, tooltip="Standard 3-band anchored VWAP. OLS Rail Start anchors from the beginning of the active OLS rail: bearish/down structure uses the upper rail start, bullish/up structure uses the lower rail start. Breakout Swing anchors from the newest pivot/swing. It persists until VWAP reclaim/breakdown or until a newer/better pivot anchor takes over. Optional age removal is controlled separately below.")
vwapSrc       = input.source(hlc3, "Source", group=grpVwap)
vwapRemoveAfterN = input.bool(false, "Remove After N Bars", group=grpVwap, inline="vage", tooltip="OFF = AVWAP only removes on VWAP reclaim/breakdown or when a newer/better pivot anchor takes over. ON = also removes the active AVWAP after Max Age bars from the break.")
vwapMaxBars      = input.int(120, "Max Age", minval=10, maxval=2000, group=grpVwap, inline="vage", tooltip="Used only when Remove After N Bars is ON. Age is counted from the break bar, not from a deep structural anchor.")
// ── Forward projection of the VWAP + all bands ──────────────────────────────
// Extend N Bars is DRAWING ONLY. Projected bars NEVER enter the cumulative
// volume/price accumulation — the VWAP and σ values at the last real bar are final.
// Sloped Extension projects the mid and σ forward along their own recent slopes,
// then rebuilds the bands from the projected values, so a widening band keeps
// widening. OFF = flat carry-forward of the last real mid and σ.
vwapExtendBars = input.int(3, "Extend N Bars", minval=0, maxval=100, group=grpVwap, inline="vext", tooltip="Forward projection of the VWAP and all bands, in bars. Drawing/projection ONLY — projected bars are never included in the cumulative VWAP calculation. 0 = no forward extension.")
vwapExtendSlope = input.bool(true, "Sloped", group=grpVwap, inline="vext", tooltip="ON = project the VWAP mid and the σ envelope forward along their own recent slopes, so the extension continues the current trajectory and the bands keep fanning. OFF = flat carry-forward of the last real values.\n\nNOTE: a sloped extension is an EXTRAPOLATION, not an anchored-VWAP value. Only the next bar's volume defines the true forward VWAP. Treat the projected segment as trajectory guidance, not as a computed level.")
vwapSlopeLen   = input.int(5, "Extension Slope Lookback (bars)", minval=2, maxval=50, group=grpVwap, tooltip="How many real bars back the extension slope is measured over, for both the mid and the σ envelope. Shorter = more reactive and noisier; longer = smoother and slower to turn. Automatically clamped to the available anchored history.")
vwapShowB1    = input.bool(true, "Band 1", group=grpVwap, inline="vb1")
vwapMult1     = input.float(1.0, "×σ", minval=0.1, maxval=10.0, step=0.1, group=grpVwap, inline="vb1")
vwapShowB2    = input.bool(true, "Band 2", group=grpVwap, inline="vb2")
vwapMult2     = input.float(2.0, "×σ", minval=0.1, maxval=10.0, step=0.1, group=grpVwap, inline="vb2")
vwapShowB3    = input.bool(true, "Band 3", group=grpVwap, inline="vb3")
vwapMult3     = input.float(3.0, "×σ", minval=0.1, maxval=10.0, step=0.1, group=grpVwap, inline="vb3")
vwapColor     = input.color(color.rgb(144, 191, 249), "VWAP",   group=grpVwap, inline="vc1")
vwapBand1Col  = input.color(color.rgb(165, 214, 167), "Band 1", group=grpVwap, inline="vc1")
vwapBand2Col  = input.color(color.rgb(255, 241, 118), "Band 2", group=grpVwap, inline="vc2")
vwapBand3Col  = input.color(color.rgb(144, 191, 249), "Band 3", group=grpVwap, inline="vc2")
vwapTransp    = input.int(29, "Line Transp", minval=0, maxval=100, step=1, group=grpVwap, tooltip="Transparency applied to the VWAP mid line and all bands.")
vwapWidth     = input.int(2, "Width", minval=1, maxval=4, group=grpVwap)
vwapLabel     = input.bool(false, "Tag VWAP", group=grpVwap)
vwapTrapMarks = input.bool(false, "Show VWAP Trap Diamonds", group=grpVwap, tooltip = "Optional visual-only diamonds when price reclaims/breaks the active AVWAP. OFF by default. Does not affect AVWAP removal, re-arm, dashboard, alerts, or learning.")
vwapAnchorMode= input.string("Both — nearest wins", "Anchor", options=["OLS rail start", "Breakout swing", "Both — nearest wins"], group=grpVwap, tooltip="Where the anchored VWAP starts when a structure breaks.\n• OLS rail start — bearish/down structures anchor from the beginning of the active upper OLS rail; bullish/up structures anchor from the beginning of the active lower OLS rail. This replaces the old Pattern Extreme behavior.\n• Breakout swing — the newest swing/pivot of the active side, with raw-price fallback so the pivotRight blind-window wick is caught.\n• Both — newest/better anchor wins first; nearest VWAP only decides when anchors are comparable.")

// ════════════════════════════════════════════════════════════════════════════
// FLAGS & PENNANTS  (continuation: impulse pole + tight consolidation, break in pole direction)
// ════════════════════════════════════════════════════════════════════════════
grpFlag        = "Flags & Pennants"
enableFlags    = input.bool(true, "Detect Flags / Pennants", group=grpFlag, tooltip="Detect a strong impulse (the POLE) followed by a tight consolidation (the flag/pennant), then a continuation break in the pole's direction. Independent of the channel pattern engine.")
poleLen        = input.int(6, "Pole Length (bars)", minval=2, maxval=50, group=grpFlag, tooltip="Lookback over which the impulse move is measured.")
poleMinATR     = input.float(3.0, "Pole Min Size (ATR)", minval=0.5, maxval=30.0, step=0.5, group=grpFlag, tooltip="The pole must move at least this many ATR over its length to qualify as an impulse.")
flagMaxBars    = input.int(18, "Flag Max Bars", minval=2, maxval=100, group=grpFlag, tooltip="Consolidation must resolve (break) within this many bars or it is abandoned.")
flagMaxRetr    = input.float(0.5, "Flag Max Retrace", minval=0.1, maxval=0.95, step=0.05, group=grpFlag, tooltip="Consolidation depth as a fraction of the pole. Beyond this the structure is too deep to be a flag and is discarded.")
flagNeedBreak  = input.bool(true, "Require Break", group=grpFlag, tooltip="ON = only flag once price breaks the consolidation in the pole direction (confirmed). OFF = also show the forming consolidation (tentative).")
flagShowTgt    = input.bool(true, "Show Measured-Move Target", group=grpFlag, tooltip="Project the pole height from the breakout for a continuation target.")
flagShowLabel  = input.bool(true, "Show Flag Label", group=grpFlag, tooltip="Show the flag/pennant icon at the structure. Hover the icon for full detail (type, bias, state, pole size, target).")
flagLblSize    = input.string(size.small, "Label Size", [size.tiny, size.small, size.normal, size.large], group=grpFlag)
flagBoxTransp  = input.int(92, "Box Transp", minval=0, maxval=100, step=1, group=grpFlag, inline="fbx", tooltip="Background transparency of the flag/pennant body box.")
flagBoxExtend  = input.int(2, "Box Extend (bars)", minval=0, maxval=100, group=grpFlag, inline="fbx", tooltip="Extend the box this many bars to the right of its natural edge.")
flagBullCol    = input.color(color.rgb(0, 230, 118), "Bull", group=grpFlag, inline="fc")
flagBearCol    = input.color(color.rgb(255, 82, 82), "Bear", group=grpFlag, inline="fc")

// ════════════════════════════════════════════════════════════════════════════
// CONTEXT
// ════════════════════════════════════════════════════════════════════════════
grpCtx    = "Context"
atrLength = input.int(14, "ATR Length", minval=1, maxval=200, group=grpCtx)
volLen    = input.int(20, "Volume Avg Length", minval=2, maxval=200, group=grpCtx, tooltip="Lookback for the volume baseline. Volume thrust = current volume ÷ this average; it strengthens flag and reversal conviction when a break arrives on expanding volume.")

// ════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ════════════════════════════════════════════════════════════════════════════
grpDash      = "Dashboard"
showDash     = input.bool(true, "Enable Dashboard", group=grpDash)
dashPosition = input.string("Top Right", "Position", ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=grpDash)
dashSize     = input.string(size.small, "Size", [size.tiny, size.small, size.normal], group=grpDash)

// ════════════════════════════════════════════════════════════════════════════
// ALERTS
// ════════════════════════════════════════════════════════════════════════════
grpAlrt      = "Alerts"
enableAlerts = input.bool(true, "Enable Alerts", group=grpAlrt)
alertPattern = input.bool(true, "New Pattern", group=grpAlrt, inline="al1")
alertBrkUp   = input.bool(true, "Breakout Up",   group=grpAlrt, inline="al2")
alertBrkDn   = input.bool(true, "Breakout Down", group=grpAlrt, inline="al2")
alertReversal= input.bool(true, "Reversal Confirmed", group=grpAlrt)
alertVwapReclaim = input.bool(true, "VWAP Reclaim (trap)", group=grpAlrt)
alertRetest  = input.bool(true, "Break Retest",    group=grpAlrt, inline="al3")
alertConfirm = input.bool(true, "Break Confirmed",  group=grpAlrt, inline="al3")
alertTrap    = input.bool(true, "Break Trap (failed)", group=grpAlrt)
alertFlag    = input.bool(true, "Flag / Pennant Break", group=grpAlrt)

// ════════════════════════════════════════════════════════════════════════════
// RESOLVERS
// ════════════════════════════════════════════════════════════════════════════
f_lineStyle(string s) =>
    s == "Solid" ? line.style_solid : s == "Dotted" ? line.style_dotted : line.style_dashed

f_dashPos(string p) =>
    switch p
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        "Middle Right" => position.middle_right
        => position.top_right

chStyleResolved = f_lineStyle(chStyle)
mmStyleResolved = f_lineStyle(mmStyle)

// ════════════════════════════════════════════════════════════════════════════
// CONTEXT + MTF DATA
// ════════════════════════════════════════════════════════════════════════════
atrVal = ta.atr(atrLength)
float volSma    = ta.sma(volume, volLen)
float volThrust = na(volSma) or volSma == 0 ? 1.0 : volume / volSma
[diPlusR, diMinusR, adxVal] = ta.dmi(adxLen, adxLen)
bool   regimeTrend = not na(adxVal) and adxVal >= adxThresh
string regimeTxt   = na(adxVal) ? "—" : (regimeTrend ? "TREND " : "RANGE ") + str.tostring(math.round(adxVal))
// Regime fit multiplier: continuation kinds (1 channel, 2 flag) favored in trend; reversal (3) in range
f_regimeMult(int kind) =>
    float m = 1.0
    if enableRegime and not na(adxVal)
        bool  cont = kind == 1 or kind == 2
        float up   = 1.0 + regimeStr
        float dn   = 1.0 - regimeStr * 0.5
        m := cont ? (regimeTrend ? up : dn) : (regimeTrend ? dn : up)
    m

autoMTF   = timeframe.multiplier <= 5 ? "15" : timeframe.multiplier <= 15 ? "60" : timeframe.multiplier <= 60 ? "240" : "D"
actualMTF = mtfTimeframe == "" ? autoMTF : mtfTimeframe

// One security call per HTF (packed) instead of two — large CPU saving vs separate fast/slow pulls.
f_htfState() =>
    float f = ta.ema(close, mtfEmaFast)
    float s = ta.ema(close, mtfEmaSlow)
    int tc = close > f and f > s ? 1 : close < f and f < s ? -1 : 0
    int d  = f > s ? 1 : f < s ? -1 : 0
    [tc, d]
f_htfSign() =>
    float f = ta.ema(close, mtfEmaFast)
    float s = ta.ema(close, mtfEmaSlow)
    f > s ? 1 : f < s ? -1 : 0

[htfTrendCode, htfDir1] = request.security(syminfo.tickerid, actualMTF, f_htfState(), lookahead=barmerge.lookahead_off)
int htfDir2 = request.security(syminfo.tickerid, mtfTf2, f_htfSign(), lookahead=barmerge.lookahead_off)
int htfDir3 = request.security(syminfo.tickerid, mtfTf3, f_htfSign(), lookahead=barmerge.lookahead_off)
string htfTrend = htfTrendCode == 1 ? "BULLISH" : htfTrendCode == -1 ? "BEARISH" : "MIXED"
f_confAgree(int dir) => dir == 0 ? 0 : (htfDir1 == dir ? 1 : 0) + (htfDir2 == dir ? 1 : 0) + (htfDir3 == dir ? 1 : 0)

// ── Learning state (declared early so the ranker can read the prior-bar book before
//    the Strength score is built; registration & resolution happen later in the bar) ──
type Setup
    int   bar0
    int   kind      // 1 channel · 2 flag · 3 reversal
    int   dir
    float target
    float invalid
    int   conf

var array<Setup> openSetups = array.new<Setup>()
var array<int> sWin   = array.new<int>(4, 0)   // indexed by kind 1..3 (slot 0 unused)
var array<int> sLoss  = array.new<int>(4, 0)
var array<int> sTo    = array.new<int>(4, 0)
var array<int> sDur   = array.new<int>(4, 0)   // Σ winning durations (bars)
var array<int> sHiTot = array.new<int>(4, 0)   // resolved while high-confluence
var array<int> sHiWin = array.new<int>(4, 0)   // wins among high-confluence

// Shrunk win rate: pulls observed rate toward 0.5 until rankPrior samples accumulate
f_shrunkWR(int w, int l) => (w + rankPrior * 0.5) / (w + l + rankPrior)
// Learned edge multiplier for a pattern kind, modulated by current confluence and
// by whether high-confluence has historically helped THAT kind. Neutral (×1.0) with no data.
f_rankMult(int kind, int curConf) =>
    float wr   = f_shrunkWR(array.get(sWin, kind), array.get(sLoss, kind))
    float m    = 1.0 + rankSens * (wr - 0.5) * 2.0
    float hiWR = f_shrunkWR(array.get(sHiWin, kind), array.get(sHiTot, kind) - array.get(sHiWin, kind))
    float edge = hiWR - wr
    float cB   = 1.0 + rankConfSens * (curConf / 3.0) * edge * 2.0
    math.max(rankMultMin, math.min(rankMultMax, m * cB))

// ── Conviction models (numeric 1..10) so the ranker can weight flags & reversals,
//    not just channels. Volume thrust strengthens a setup that breaks on expanding volume. ──
f_clamp01(float x) => math.max(0.0, math.min(1.0, x))
f_flagConv(float poleMag, float depth, float brkDist, float vthrust) =>
    float a    = nz(atrVal, 1.0)
    float poleS  = f_clamp01(poleMag / a / 6.0)                       // pole up to ~6 ATR = full
    float tightS = f_clamp01(1.0 - depth / math.max(poleMag, a))      // tighter body vs pole = better
    float brkS   = f_clamp01(brkDist / a)                            // decisive break (ATR beyond box)
    float volS   = f_clamp01((vthrust - 1.0))                        // 2× avg volume = full
    math.round(math.min(math.max((0.35 * poleS + 0.25 * tightS + 0.20 * brkS + 0.20 * volS) * 10.0, 1.0), 10.0), 1)
f_revConv(float sym, float brkDist, float vthrust, bool confirmed) =>
    float a    = nz(atrVal, 1.0)
    float symS = f_clamp01(sym)                                      // shoulder/peak symmetry
    float brkS = confirmed ? f_clamp01(brkDist / a) : 0.0           // neckline break decisiveness
    float volS = f_clamp01((vthrust - 1.0))
    math.round(math.min(math.max((0.45 * symS + 0.35 * brkS + 0.20 * volS) * 10.0, 1.0), 10.0), 1)

// ════════════════════════════════════════════════════════════════════════════
// PIVOT COLLECTION
// ════════════════════════════════════════════════════════════════════════════
var array<int>   pivHighIdx = array.new<int>()
var array<float> pivHighVal = array.new<float>()
var array<int>   pivLowIdx  = array.new<int>()
var array<float> pivLowVal  = array.new<float>()

float ph = enablePivots ? ta.pivothigh(highSrc, pivotLeft, pivotRight) : na
float pl = enablePivots ? ta.pivotlow(lowSrc, pivotLeft, pivotRight)  : na

if not na(ph)
    array.push(pivHighIdx, bar_index - pivotRight)
    array.push(pivHighVal, ph)
    while array.size(pivHighIdx) > maxPivots
        array.shift(pivHighIdx)
        array.shift(pivHighVal)

if not na(pl)
    array.push(pivLowIdx, bar_index - pivotRight)
    array.push(pivLowVal, pl)
    while array.size(pivLowIdx) > maxPivots
        array.shift(pivLowIdx)
        array.shift(pivLowVal)

// ════════════════════════════════════════════════════════════════════════════
// OLS REGRESSION ENGINE  (returns slope, intercept, R² per boundary)
// slope     = (n·Σxy − Σx·Σy) / (n·Σx² − (Σx)²)
// intercept = (Σy − slope·Σx) / n
// R²        = 1 − SS_res/SS_tot,  SS_res = Σy² − a·Σy − b·Σxy,  SS_tot = Σy² − (Σy)²/n
// ════════════════════════════════════════════════════════════════════════════
f_olsChannel(string mode, int lookback, int segments, int nPiv, bool rideExtremes) =>
    float slopeHi = na
    float interHi = na
    float r2Hi    = na
    float slopeLo = na
    float interLo = na
    float r2Lo    = na
    int   startBar = na
    int   startHi  = na   // upper-rail origin bar (earliest high pivot fit) — feeds OLS-rail-start AVWAP on down-breaks
    int   startLo  = na   // lower-rail origin bar (earliest low pivot fit)  — feeds OLS-rail-start AVWAP on up-breaks

    if mode == "Pivots"
        // ── Fit each rail through the last nPiv confirmed pivots ──
        int totH = array.size(pivHighIdx)
        int totL = array.size(pivLowIdx)
        int useH = math.min(nPiv, totH)
        int useL = math.min(nPiv, totL)
        int earliestH = na
        int earliestL = na
        if useH >= 2
            float sx = 0.0, sy = 0.0, sxy = 0.0, sx2 = 0.0, sy2 = 0.0
            int   n = 0
            for i = totH - useH to totH - 1
                float x = array.get(pivHighIdx, i)
                float y = array.get(pivHighVal, i)
                sx  += x
                sy  += y
                sxy += x * y
                sx2 += x * x
                sy2 += y * y
                n   += 1
                if na(earliestH) or x < earliestH
                    earliestH := int(x)
            float nf  = n
            float den = nf * sx2 - sx * sx
            slopeHi := den != 0.0 ? (nf * sxy - sx * sy) / den : 0.0
            interHi := (sy - slopeHi * sx) / nf
            float ssTot = sy2 - sy * sy / nf
            float ssRes = sy2 - interHi * sy - slopeHi * sxy
            r2Hi := ssTot > 0.0 ? math.max(0.0, math.min(1.0, 1.0 - ssRes / ssTot)) : 0.0
            // Shift the rail UP to ride the most extreme high (true resistance)
            if rideExtremes
                float maxRes = na
                for i = totH - useH to totH - 1
                    float x = array.get(pivHighIdx, i)
                    float y = array.get(pivHighVal, i)
                    float resid = y - (slopeHi * x + interHi)
                    if na(maxRes) or resid > maxRes
                        maxRes := resid
                interHi := interHi + nz(maxRes, 0.0)
        if useL >= 2
            float sx = 0.0, sy = 0.0, sxy = 0.0, sx2 = 0.0, sy2 = 0.0
            int   n = 0
            for i = totL - useL to totL - 1
                float x = array.get(pivLowIdx, i)
                float y = array.get(pivLowVal, i)
                sx  += x
                sy  += y
                sxy += x * y
                sx2 += x * x
                sy2 += y * y
                n   += 1
                if na(earliestL) or x < earliestL
                    earliestL := int(x)
            float nf  = n
            float den = nf * sx2 - sx * sx
            slopeLo := den != 0.0 ? (nf * sxy - sx * sy) / den : 0.0
            interLo := (sy - slopeLo * sx) / nf
            float ssTot = sy2 - sy * sy / nf
            float ssRes = sy2 - interLo * sy - slopeLo * sxy
            r2Lo := ssTot > 0.0 ? math.max(0.0, math.min(1.0, 1.0 - ssRes / ssTot)) : 0.0
            // Shift the rail DOWN to ride the most extreme low (true support)
            if rideExtremes
                float minRes = na
                for i = totL - useL to totL - 1
                    float x = array.get(pivLowIdx, i)
                    float y = array.get(pivLowVal, i)
                    float resid = y - (slopeLo * x + interLo)
                    if na(minRes) or resid < minRes
                        minRes := resid
                interLo := interLo + nz(minRes, 0.0)
        // structure start = earliest pivot actually used (shared window start)
        if not na(earliestH) and not na(earliestL)
            startBar := math.min(earliestH, earliestL)
        else if not na(earliestH)
            startBar := earliestH
        else if not na(earliestL)
            startBar := earliestL
        // per-rail origins: the upper rail begins at its earliest HIGH pivot, the lower at its
        // earliest LOW pivot. These differ, and are what "OLS rail start" anchors the side-correct
        // VWAP to (upper origin on a down-break, lower origin on an up-break).
        startHi := earliestH
        startLo := earliestL
    else
        // ── Segment mode: rolling regression over a fixed bar window ──
        if bar_index >= lookback
            float sxH = 0.0, syH = 0.0, sxyH = 0.0, sx2H = 0.0, sy2H = 0.0
            int   nH = 0
            float sxL = 0.0, syL = 0.0, sxyL = 0.0, sx2L = 0.0, sy2L = 0.0
            int   nL = 0
            int segBase = math.max(1, int(math.floor(lookback / segments)))
            for k = 0 to segments - 1
                int segStart  = k * segBase
                int remaining = lookback - segStart
                if remaining <= 0
                    break
                int segLen = k < segments - 1 ? math.min(segBase, remaining) : remaining
                float maxH = na
                int   agoH = na
                for i = 0 to segLen - 1
                    int sh = segStart + i
                    float v = highSrc[sh]
                    if not na(v) and (na(maxH) or v > maxH)
                        maxH := v
                        agoH := sh
                if not na(agoH)
                    float xH = bar_index - agoH
                    sxH  += xH
                    syH  += maxH
                    sxyH += xH * maxH
                    sx2H += xH * xH
                    sy2H += maxH * maxH
                    nH   += 1
                float minL = na
                int   agoL = na
                for i = 0 to segLen - 1
                    int sl = segStart + i
                    float v2 = lowSrc[sl]
                    if not na(v2) and (na(minL) or v2 < minL)
                        minL := v2
                        agoL := sl
                if not na(agoL)
                    float xL = bar_index - agoL
                    sxL  += xL
                    syL  += minL
                    sxyL += xL * minL
                    sx2L += xL * xL
                    sy2L += minL * minL
                    nL   += 1
            if nH >= 2
                float nf  = nH
                float den = nf * sx2H - sxH * sxH
                slopeHi := den != 0.0 ? (nf * sxyH - sxH * syH) / den : 0.0
                interHi := (syH - slopeHi * sxH) / nf
                float ssTot = sy2H - syH * syH / nf
                float ssRes = sy2H - interHi * syH - slopeHi * sxyH
                r2Hi := ssTot > 0.0 ? math.max(0.0, math.min(1.0, 1.0 - ssRes / ssTot)) : 0.0
            if nL >= 2
                float nf  = nL
                float den = nf * sx2L - sxL * sxL
                slopeLo := den != 0.0 ? (nf * sxyL - sxL * syL) / den : 0.0
                interLo := (syL - slopeLo * sxL) / nf
                float ssTot = sy2L - syL * syL / nf
                float ssRes = sy2L - interLo * syL - slopeLo * sxyL
                r2Lo := ssTot > 0.0 ? math.max(0.0, math.min(1.0, 1.0 - ssRes / ssTot)) : 0.0
            startBar := bar_index - lookback + 1
            // Segments mode has no per-rail pivot origin — both rails share the fixed window start.
            startHi  := startBar
            startLo  := startBar
    [slopeHi, interHi, r2Hi, slopeLo, interLo, r2Lo, startBar, startHi, startLo]

// f_olsChannel must be called on EVERY bar (consistency) — call unconditionally,
// then gate only the RESULT.
[sH, iH, rH, sL, iL, rL, sBar, sBarHi, sBarLo] = f_olsChannel(chAnchorMode, chLookback, chSegments, chPivotsUse, chRideExtremes)

float slopeHi = na
float interHi = na
float r2Hi    = na
float slopeLo = na
float interLo = na
float r2Lo    = na
int   chStart   = na
int   chStartHi = na   // upper-rail origin bar (feeds OLS-rail-start AVWAP on down-breaks)
int   chStartLo = na   // lower-rail origin bar (feeds OLS-rail-start AVWAP on up-breaks)
if enableChannel
    slopeHi := sH
    interHi := iH
    r2Hi    := rH
    slopeLo := sL
    interLo := iL
    r2Lo    := rL
    chStart   := sBar
    chStartHi := sBarHi
    chStartLo := sBarLo

int chX1 = not na(chStart) ? chStart : bar_index
int chX2 = bar_index

float upY1 = not na(slopeHi) ? slopeHi * chX1 + interHi : na
float upY2 = not na(slopeHi) ? slopeHi * chX2 + interHi : na
float loY1 = not na(slopeLo) ? slopeLo * chX1 + interLo : na
float loY2 = not na(slopeLo) ? slopeLo * chX2 + interLo : na
float widthStart = (not na(upY1) and not na(loY1)) ? upY1 - loY1 : na
float widthEnd   = (not na(upY2) and not na(loY2)) ? upY2 - loY2 : na
float fitR2      = (not na(r2Hi) and not na(r2Lo)) ? (r2Hi + r2Lo) / 2.0 : na

// ════════════════════════════════════════════════════════════════════════════
// CHANNEL DRAWING
// ════════════════════════════════════════════════════════════════════════════
var line     lnUpper = na
var line     lnLower = na
var line     lnMid   = na
var linefill chFill  = na

bool haveUpper = enableChannel and chShowUpper and not na(upY2)
if haveUpper
    if na(lnUpper)
        lnUpper := line.new(chX1, upY1, chX2, upY2, xloc=xloc.bar_index)
    line.set_xy1(lnUpper, chX1, upY1)
    line.set_xy2(lnUpper, chX2, upY2)
    line.set_color(lnUpper, chUpperColor)
    line.set_width(lnUpper, chWidth)
    line.set_style(lnUpper, chStyleResolved)
    line.set_extend(lnUpper, chExtend ? extend.right : extend.none)
else
    if not na(lnUpper)
        line.delete(lnUpper)
        lnUpper := na

bool haveLower = enableChannel and chShowLower and not na(loY2)
if haveLower
    if na(lnLower)
        lnLower := line.new(chX1, loY1, chX2, loY2, xloc=xloc.bar_index)
    line.set_xy1(lnLower, chX1, loY1)
    line.set_xy2(lnLower, chX2, loY2)
    line.set_color(lnLower, chLowerColor)
    line.set_width(lnLower, chWidth)
    line.set_style(lnLower, chStyleResolved)
    line.set_extend(lnLower, chExtend ? extend.right : extend.none)
else
    if not na(lnLower)
        line.delete(lnLower)
        lnLower := na

bool haveMid = enableChannel and chShowMid and not na(upY2) and not na(loY2)
if haveMid
    float my1 = (upY1 + loY1) / 2.0
    float my2 = (upY2 + loY2) / 2.0
    float mslope = (my2 - my1) / math.max(chX2 - chX1, 1)
    int   midX2e = chX2 + midExtendBars
    float midY2e = my2 + mslope * midExtendBars
    if na(lnMid)
        lnMid := line.new(chX1, my1, midX2e, midY2e, xloc=xloc.bar_index)
    line.set_xy1(lnMid, chX1, my1)
    line.set_xy2(lnMid, midX2e, midY2e)
    line.set_color(lnMid, chMidColor)
    line.set_width(lnMid, 1)
    line.set_style(lnMid, line.style_dotted)
    line.set_extend(lnMid, chExtend ? extend.right : extend.none)
else
    if not na(lnMid)
        line.delete(lnMid)
        lnMid := na

bool haveFill = enableChannel and chShowFill and not na(lnUpper) and not na(lnLower)
if haveFill
    if na(chFill)
        chFill := linefill.new(lnUpper, lnLower, color.new(chFillColor, chFillTransp))
    else
        linefill.set_color(chFill, color.new(chFillColor, chFillTransp))
else
    if not na(chFill)
        linefill.delete(chFill)
        chFill := na

// ════════════════════════════════════════════════════════════════════════════
// FORWARD PROJECTION  (extend rails forward, mark apex, project target endpoint)
// ════════════════════════════════════════════════════════════════════════════
var line  lnFwdUp = na
var line  lnFwdLo = na
var line  lnApex  = na
var label lbApex  = na
var label lbTgt   = na

bool fwdOK = enableFwd and enableChannel and not na(slopeHi) and not na(slopeLo) and not na(upY2) and not na(loY2)
if fwdOK
    int   xF   = math.min(bar_index + fwdBars, bar_index + 490)
    float upYF = slopeHi * xF + interHi
    float loYF = slopeLo * xF + interLo

    // ── Dotted forecast extension of each rail ──
    if na(lnFwdUp)
        lnFwdUp := line.new(chX2, upY2, xF, upYF, xloc=xloc.bar_index, style=line.style_dotted, color=fwdColor, width=chWidth)
        lnFwdLo := line.new(chX2, loY2, xF, loYF, xloc=xloc.bar_index, style=line.style_dotted, color=fwdColor, width=chWidth)
    line.set_xy1(lnFwdUp, chX2, upY2)
    line.set_xy2(lnFwdUp, xF, upYF)
    line.set_xy1(lnFwdLo, chX2, loY2)
    line.set_xy2(lnFwdLo, xF, loYF)
    line.set_color(lnFwdUp, fwdColor)
    line.set_color(lnFwdLo, fwdColor)

    // ── Apex: where converging rails meet (the breakout deadline) ──
    float denom = slopeHi - slopeLo
    float xApexF = denom != 0.0 ? (interLo - interHi) / denom : na
    bool  apexAhead = not na(xApexF) and xApexF > bar_index + 1 and xApexF < bar_index + 490
    if fwdShowApex and apexAhead
        int   xApex = int(xApexF)
        float yApex = slopeHi * xApex + interHi
        if na(lnApex)
            lnApex := line.new(chX2, (upY2 + loY2) / 2.0, xApex, yApex, xloc=xloc.bar_index, style=line.style_dotted, color=fwdApexColor, width=1)
            lbApex := label.new(xApex, yApex, "", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(fwdApexColor, 82), textcolor=fwdApexColor, size=size.small)
        line.set_xy1(lnApex, chX2, (upY2 + loY2) / 2.0)
        line.set_xy2(lnApex, xApex, yApex)
        label.set_xy(lbApex, xApex, yApex)
        label.set_text(lbApex, "APEX " + str.tostring(xApex - bar_index) + "b")
    else
        if not na(lnApex)
            line.delete(lnApex)
            lnApex := na
        if not na(lbApex)
            label.delete(lbApex)
            lbApex := na

    // ── Target endpoint on the projected midline at the horizon ──
    if fwdShowTgt
        float midF = (upYF + loYF) / 2.0
        if na(lbTgt)
            lbTgt := label.new(xF, midF, "", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(fwdColor, 70), textcolor=color.new(color.white, 0), size=size.small)
        label.set_xy(lbTgt, xF, midF)
        label.set_text(lbTgt, "⊕ " + str.tostring(midF, format.mintick))
    else
        if not na(lbTgt)
            label.delete(lbTgt)
            lbTgt := na
else
    if not na(lnFwdUp)
        line.delete(lnFwdUp)
        lnFwdUp := na
    if not na(lnFwdLo)
        line.delete(lnFwdLo)
        lnFwdLo := na
    if not na(lnApex)
        line.delete(lnApex)
        lnApex := na
    if not na(lbApex)
        label.delete(lbApex)
        lbApex := na
    if not na(lbTgt)
        label.delete(lbTgt)
        lbTgt := na

// ════════════════════════════════════════════════════════════════════════════
// CLASSIFICATION ENGINE  (pure geometry on the two regression slopes)
// ════════════════════════════════════════════════════════════════════════════
f_classify(float sHi, float sLo, float wStart, float wEnd, float atrv, float flatTh, float convTh) =>
    string nm = ""
    string sc = ""
    string bias = "Neutral"
    bool isConv = false
    if not na(sHi) and not na(sLo) and not na(wStart) and not na(wEnd) and atrv > 0.0
        float sHiN = sHi / atrv
        float sLoN = sLo / atrv
        bool upFlat = math.abs(sHiN) < flatTh
        bool loFlat = math.abs(sLoN) < flatTh
        float convRatio = wStart != 0.0 ? wEnd / wStart : 1.0
        bool converging = convRatio < (1.0 - convTh)
        bool diverging  = convRatio > (1.0 + convTh)
        bool parallel   = not converging and not diverging
        isConv := converging
        bool upUp = sHi > 0.0 and not upFlat
        bool upDn = sHi < 0.0 and not upFlat
        bool loUp = sLo > 0.0 and not loFlat
        bool loDn = sLo < 0.0 and not loFlat
        if parallel
            if upFlat and loFlat
                nm := "Ranging Channel", sc := "RC", bias := "Neutral"
            else if sHi > 0.0 and sLo > 0.0
                nm := "Ascending Channel", sc := "AC", bias := "Bullish"
            else if sHi < 0.0 and sLo < 0.0
                nm := "Descending Channel", sc := "DC", bias := "Bearish"
            else
                nm := "Ranging Channel", sc := "RC", bias := "Neutral"
        else if converging
            if upFlat and loUp
                nm := "Ascending Triangle", sc := "AT", bias := "Bullish"
            else if loFlat and upDn
                nm := "Descending Triangle", sc := "DT", bias := "Bearish"
            else if upDn and loUp
                nm := "Symmetrical Triangle", sc := "ST", bias := "Neutral"
            else if upUp and loUp
                nm := "Rising Wedge", sc := "RW", bias := "Bearish"
            else if upDn and loDn
                nm := "Falling Wedge", sc := "FW", bias := "Bullish"
            else
                nm := "Converging Triangle", sc := "CT", bias := "Neutral"
        else
            if upUp and loDn
                nm := "Expanding Triangle", sc := "ET", bias := "Neutral"
            else if upUp and loUp
                nm := "Rising Wedge (Exp)", sc := "RWE", bias := "Bearish"
            else if upDn and loDn
                nm := "Falling Wedge (Exp)", sc := "FWE", bias := "Bullish"
            else
                nm := "Expanding", sc := "EX", bias := "Neutral"
    [nm, sc, bias, isConv]

string patName  = ""
string patShort = ""
string patBias  = "Neutral"
bool   patConv  = false
if enableClassify
    [pn, psc, pb, pc] = f_classify(slopeHi, slopeLo, widthStart, widthEnd, atrVal, flatThreshold, convThreshold)
    patName  := pn
    patShort := psc
    patBias  := pb
    patConv  := pc

// MTF alignment + live confluence (count of HTFs agreeing with the pattern bias)
bool mtfAligned = enableMTF and ((patBias == "Bullish" and htfTrend == "BULLISH") or (patBias == "Bearish" and htfTrend == "BEARISH"))
int  confNow    = f_confAgree(patBias == "Bullish" ? 1 : patBias == "Bearish" ? -1 : 0)

// Strength score (R²-driven, MTF bonus) — adaptive ranker folds learned channel edge in
float strength    = na
float rankMultCh  = enableRanker ? f_rankMult(1, confNow) : 1.0
if enableStrength and not na(fitR2)
    float base = fitR2 * 10.0
    if mtfAligned
        base *= mtfBonus
    base *= rankMultCh
    base *= f_regimeMult(1)
    strength := math.round(math.min(math.max(base, 1.0), 10.0), 1)

// Display gates
string famPat = str.contains(patName, "Channel") ? "Channel" : str.contains(patName, "Wedge") ? "Wedge" : patName != "" ? "Triangle" : ""
bool famOK   = (famPat == "Channel" and allowChannels) or (famPat == "Wedge" and allowWedges) or (famPat == "Triangle" and allowTriangles)
bool biasOK  = (patBias == "Bullish" and allowRising) or (patBias == "Bearish" and allowFalling) or (patBias == "Neutral" and allowNeutral)
bool widthOK = not na(widthEnd) and math.abs(widthEnd) > minWidthATR * atrVal
bool fitOK   = na(fitR2) ? false : fitR2 >= minR2
bool scoreOK = true
if enableStrength and not na(strength)
    scoreOK := strength >= minScoreDisplay
bool showPattern = enableClassify and patName != "" and famOK and biasOK and widthOK and fitOK and scoreOK

// ════════════════════════════════════════════════════════════════════════════
// INSTITUTIONAL TOOLTIP
// ════════════════════════════════════════════════════════════════════════════
f_tooltip(string nm, string bias, bool conv, float r2, float scoreVal, bool mtf) =>
    string e = bias == "Bullish" ? "🟢" : bias == "Bearish" ? "🔴" : "⚪"
    string t = "═ BK READ ═\n" + e + " " + nm + " — " + bias
    if not na(scoreVal)
        t += "  ⚡" + str.tostring(scoreVal, "#.#")
    t += "\nFit R²: " + (na(r2) ? "—" : str.tostring(math.round(r2 * 100, 0)) + "%")
    if enableMTF
        t += "\nHTF (" + actualMTF + "): " + htfTrend + (mtf ? " ✓ aligned" : " ✗ divergent")
    if enableRanker
        t += "\nEdge: ×" + str.tostring(math.round(rankMultCh * 100) / 100) + " (learned, this TF)"
    if str.contains(nm, "Ascending Channel")
        t += "\n\nBULLISH continuation. Buy dips to lower rail; breakdown = distribution done."
    else if str.contains(nm, "Descending Channel")
        t += "\n\nBEARISH continuation. Sell rips to upper rail; breakout up = accumulation done."
    else if str.contains(nm, "Ranging Channel")
        t += "\n\nBalance. Fade extremes with tight stops, or trade the break."
    else if str.contains(nm, "Rising Wedge")
        t += "\n\nBEARISH. Momentum narrowing into highs = distribution. Short the lower-rail break."
    else if str.contains(nm, "Falling Wedge")
        t += "\n\nBULLISH. Selling exhausting into compression. Buy the upper-rail break + volume."
    else if str.contains(nm, "Ascending Triangle")
        t += "\n\nBULLISH. Demand absorbing flat supply. Buy break of the flat top + volume surge."
    else if str.contains(nm, "Descending Triangle")
        t += "\n\nBEARISH. Supply pressing flat support. Short the breakdown + volume."
    else if str.contains(nm, "Symmetrical") or str.contains(nm, "Converging")
        t += "\n\nCompression before expansion. First break often false — trade the retest."
    else if str.contains(nm, "Expanding")
        t += "\n\nVolatility expanding, no winner. Both sides trapped — wait for contraction."
    t

// ════════════════════════════════════════════════════════════════════════════
// PATTERN LABEL
// ════════════════════════════════════════════════════════════════════════════
var label patLbl = na
if showPattern and showPatternLabel
    float midNow  = (upY2 + loY2) / 2.0
    float midPrev = (upY1 + loY1) / 2.0
    float lblSlope = (midNow - midPrev) / math.max(chX2 - chX1, 1)
    int   lblX = midExtendLabel ? chX2 + midExtendBars : chX2
    float ly   = midExtendLabel ? midNow + lblSlope * midExtendBars : midNow
    string txt = patShort
    if enableStrength and showScoreBadge and not na(strength)
        txt += " ⚡" + str.tostring(strength, "#.#")
    if enableMTF and mtfShowBadge and mtfAligned
        txt += " 🔗"
    color bc = patBias == "Bullish" ? biasBullColor : patBias == "Bearish" ? biasBearColor : biasNeutralColor
    if na(patLbl)
        patLbl := label.new(lblX, ly, txt, xloc=xloc.bar_index, style=label.style_label_left)
    label.set_xy(patLbl, lblX, ly)
    label.set_text(patLbl, txt)
    label.set_textcolor(patLbl, bc)
    label.set_color(patLbl, color.new(patLabelBg, patLabelBgTransp))
    label.set_size(patLbl, patLabelSize)
    label.set_tooltip(patLbl, enablePatternTooltip ? f_tooltip(patName, patBias, patConv, fitR2, strength, mtfAligned) : "")
else
    if not na(patLbl)
        label.delete(patLbl)
        patLbl := na

// ════════════════════════════════════════════════════════════════════════════
// MEASURED MOVE PROJECTIONS
// ════════════════════════════════════════════════════════════════════════════
f_updTarget(line ln, bool show, int x1, int x2, float lvl, color col, int w, string styl, int transp) =>
    line out = ln
    if show and not na(lvl)
        if na(out)
            out := line.new(x1, lvl, x2, lvl, xloc=xloc.bar_index)
        line.set_xy1(out, x1, lvl)
        line.set_xy2(out, x2, lvl)
        line.set_color(out, color.new(col, transp))
        line.set_width(out, w)
        line.set_style(out, styl)
    else
        if not na(out)
            line.delete(out)
            out := na
    out

f_updTargetLbl(label lb, bool show, int x, float lvl, string txt, color col) =>
    label out = lb
    if show and not na(lvl)
        if na(out)
            out := label.new(x, lvl, txt, xloc=xloc.bar_index, style=label.style_none, size=size.tiny)
        label.set_xy(out, x, lvl)
        label.set_text(out, txt)
        label.set_textcolor(out, col)
    else
        if not na(out)
            label.delete(out)
            out := na
    out

var line  t1L = na
var line  t2L = na
var line  t3L = na
var label t1Lbl = na
var label t2Lbl = na
var label t3Lbl = na

bool  mmActive = showPattern and enableMM and patBias != "Neutral" and not na(widthEnd)
bool  mmBull   = patBias == "Bullish"
float mmHeight = math.abs(nz(widthEnd))
float mmBreak  = mmBull ? upY2 : loY2
color mmCol    = mmBull ? mmBullColor : mmBearColor
int   mmX1     = chX2
int   mmX2     = math.min(chX2 + mmExtendBars, bar_index + 490)
float lvl1 = mmBull ? mmBreak + mmHeight * mmFib1 : mmBreak - mmHeight * mmFib1
float lvl2 = mmBull ? mmBreak + mmHeight * mmFib2 : mmBreak - mmHeight * mmFib2
float lvl3 = mmBull ? mmBreak + mmHeight * mmFib3 : mmBreak - mmHeight * mmFib3
string pfx = mmPrefix != "" ? mmPrefix + ":" : ""

t1L := f_updTarget(t1L, mmActive and mmShowT1, mmX1, mmX2, mmActive ? lvl1 : na, mmCol, mmWidth, mmStyleResolved, mmTransp)
t2L := f_updTarget(t2L, mmActive and mmShowT2, mmX1, mmX2, mmActive ? lvl2 : na, mmCol, mmWidth, mmStyleResolved, mmTransp)
t3L := f_updTarget(t3L, mmActive and mmShowT3, mmX1, mmX2, mmActive ? lvl3 : na, mmCol, mmWidth, mmStyleResolved, mmTransp)
t1Lbl := f_updTargetLbl(t1Lbl, mmActive and mmShowT1 and mmShowLabels, mmX2, mmActive ? lvl1 : na, pfx + "T1 " + str.tostring(lvl1, format.mintick), mmCol)
t2Lbl := f_updTargetLbl(t2Lbl, mmActive and mmShowT2 and mmShowLabels, mmX2, mmActive ? lvl2 : na, pfx + "T2 " + str.tostring(lvl2, format.mintick), mmCol)
t3Lbl := f_updTargetLbl(t3Lbl, mmActive and mmShowT3 and mmShowLabels, mmX2, mmActive ? lvl3 : na, pfx + "T3 " + str.tostring(lvl3, format.mintick), mmCol)

// ════════════════════════════════════════════════════════════════════════════
// BREAKOUT DECISION ZONE
// ════════════════════════════════════════════════════════════════════════════
var box zoneBox = na
bool zoneActive = enableZone and showPattern and patConv and not na(slopeHi) and not na(slopeLo)
if zoneActive
    int   structSpan = math.max(1, chX2 - chX1)
    int   zb  = math.max(1, int(structSpan * zonePct / 100.0))
    int   zx1 = chX2 - zb
    float upZ = slopeHi * zx1 + interHi
    float loZ = slopeLo * zx1 + interLo
    float top = math.max(upY2, upZ)
    float bot = math.min(loY2, loZ)
    color zc  = patBias == "Bullish" ? zoneBullColor : patBias == "Bearish" ? zoneBearColor : zoneNeutralColor
    if na(zoneBox)
        zoneBox := box.new(zx1, top, chX2, bot, xloc=xloc.bar_index)
    box.set_left(zoneBox, zx1)
    box.set_right(zoneBox, chX2 + zoneExtend)
    box.set_top(zoneBox, top)
    box.set_bottom(zoneBox, bot)
    box.set_bgcolor(zoneBox, color.new(zc, zoneTransp))
    box.set_border_color(zoneBox, color.new(zc, math.max(zoneTransp - 15, 0)))
    box.set_border_width(zoneBox, 1)
else
    if not na(zoneBox)
        box.delete(zoneBox)
        zoneBox := na

// ════════════════════════════════════════════════════════════════════════════
// CHANNEL DIRECTION + BREAKOUT READ
// ════════════════════════════════════════════════════════════════════════════
string dirTxt = "—"
color  dirCol = color.gray
float  midPct = na
if not na(upY1) and not na(loY1) and not na(upY2) and not na(loY2)
    float midStart = (upY1 + loY1) / 2.0
    float midEnd   = (upY2 + loY2) / 2.0
    midPct := midStart != 0.0 ? (midEnd - midStart) / math.abs(midStart) * 100.0 : 0.0
    if midPct > dirThreshold
        dirTxt := "Bullish ▲"
        dirCol := color.rgb(0, 230, 118)
    else if midPct < -dirThreshold
        dirTxt := "Bearish ▼"
        dirCol := color.rgb(255, 82, 82)
    else
        dirTxt := "Range ↔"
        dirCol := color.gray

// ════════════════════════════════════════════════════════════════════════════
// STRUCTURE LIFECYCLE + BREAKOUT  (form → lock → break: ONE clean marker)
// A continuously-refitting channel has no stable reference, so testing every bar
// against its own transient rail fires false breaks all through formation. Instead:
// the structure forms (rails refit live), LOCKS once confirmed, and the break is
// measured against the locked rails — so the marker lands at the real break.
// ════════════════════════════════════════════════════════════════════════════
var int   lkState   = 0     // 0 forming · 1 locked · 2 broken
var float lkSlopeHi = na
var float lkInterHi = na
var float lkSlopeLo = na
var float lkInterLo = na
var int   lkValid   = 0
var int   lkBreakBar = na
var float lkBreakPx  = na
var int   lkBreakDir = 0
var int   lkX1       = na   // structure window start captured at lock/sync — the window the BREAK belongs to (feeds the breakout-swing scan)
var int   lkX1Hi     = na   // upper-rail ORIGIN captured at lock/sync — OLS-rail-start anchor on a DOWN-break
var int   lkX1Lo     = na   // lower-rail ORIGIN captured at lock/sync — OLS-rail-start anchor on an UP-break

string brkTxt  = "—"
color  brkCol  = color.gray
bool   freshUp = false
bool   freshDn = false

bool  patValid = showPattern and not na(slopeHi) and not na(slopeLo)
float brkBuf   = (not na(atrVal) ? atrVal : 0.0) * brkBufferATR

// Legacy live-read series (only armed when lock is disabled) — top-level so [1] works
bool legUp = (not lockStructure) and not na(upY2) and (brkUseClose ? close : high) > upY2
bool legDn = (not lockStructure) and not na(loY2) and (brkUseClose ? close : low)  < loY2

if lockStructure
    if lkState == 0
        // FORMING — count sustained validity, then lock to the current fit
        lkValid := patValid ? lkValid + 1 : 0
        if lkValid >= lockConfirmBars
            lkState   := 1
            lkSlopeHi := slopeHi
            lkInterHi := interHi
            lkSlopeLo := slopeLo
            lkInterLo := interLo
            lkX1      := chX1
            lkX1Hi    := chStartHi
            lkX1Lo    := chStartLo
        brkTxt := patValid ? "Forming ◷" : "—"
        brkCol := color.gray
    else if lkState == 1
        // LOCKED — test the break against the stable locked rails
        float lUp   = lkSlopeHi * bar_index + lkInterHi
        float lLo   = lkSlopeLo * bar_index + lkInterLo
        float upRef = brkUseClose ? close : high
        float dnRef = brkUseClose ? close : low
        if upRef > lUp + brkBuf
            brkTxt  := "Broke ⬆"
            brkCol  := brkUpColor
            freshUp := true
            lkState := 2
            lkBreakBar := bar_index
            lkBreakPx  := high
            lkBreakDir := 1
        else if dnRef < lLo - brkBuf
            brkTxt  := "Broke ⬇"
            brkCol  := brkDnColor
            freshDn := true
            lkState := 2
            lkBreakBar := bar_index
            lkBreakPx  := low
            lkBreakDir := -1
        else
            // still contained — keep the lock synced to the latest mature fit
            if patValid
                lkSlopeHi := slopeHi
                lkInterHi := interHi
                lkSlopeLo := slopeLo
                lkInterLo := interLo
                lkX1      := chX1
                lkX1Hi    := chStartHi
                lkX1Lo    := chStartLo
            brkTxt := "Locked ◈"
            brkCol := color.new(color.aqua, 0)
    else
        // BROKEN — hold the read; re-arm when the pattern dissolves and a new one forms
        bool brokeUpHold = close > (lkSlopeHi * bar_index + lkInterHi)
        brkTxt := brokeUpHold ? "Broke ⬆" : "Broke ⬇"
        brkCol := brokeUpHold ? brkUpColor : brkDnColor
        if not patValid
            lkState := 0
            lkValid := 0
else
    // Legacy live read — always shows true state vs current rail; marks raw crossings
    brkTxt  := legUp ? "Above ⬆" : legDn ? "Below ⬇" : (not na(upY2) and not na(loY2)) ? "Inside ◈" : "—"
    brkCol  := legUp ? brkUpColor : legDn ? brkDnColor : color.gray
    freshUp := legUp and not legUp[1]
    freshDn := legDn and not legDn[1]

// ── POST-BREAK LIFECYCLE: retest / confirm / trap, graded against the BROKEN rail ──
// pbState: 0 inactive · 1 broken-awaiting · 2 retested · 3 confirmed · 4 trapped (failed break)
var int   pbState    = 0
var int   pbDir      = 0        // +1 broke up · −1 broke down
var float pbBreakLvl = na       // broken-rail value at the break bar
bool  pbRetestEvt  = false
bool  pbConfirmEvt = false
bool  pbTrapEvt    = false
float pbRetAtr = nz(atrVal, 0.0) * retestATR
float pbCnfAtr = nz(atrVal, 0.0) * confirmATR
float pbTrpAtr = nz(atrVal, 0.0) * trapATR
if enableLifecycle
    if freshUp or freshDn
        pbState    := 1
        pbDir      := freshUp ? 1 : -1
        pbBreakLvl := freshUp ? (lkSlopeHi * bar_index + lkInterHi) : (lkSlopeLo * bar_index + lkInterLo)
    else if pbState != 0 and pbState != 4 and pbDir != 0
        float railNow   = pbDir > 0 ? (lkSlopeHi * bar_index + lkInterHi) : (lkSlopeLo * bar_index + lkInterLo)
        bool  trapped   = pbDir > 0 ? close < railNow - pbTrpAtr   : close > railNow + pbTrpAtr
        bool  confirmed = pbDir > 0 ? close > pbBreakLvl + pbCnfAtr : close < pbBreakLvl - pbCnfAtr
        bool  retest    = pbDir > 0 ? low <= railNow + pbRetAtr     : high >= railNow - pbRetAtr
        if trapped
            pbTrapEvt := true
            pbState   := 4
        else if pbState < 3 and confirmed
            pbConfirmEvt := true
            pbState      := 3
        else if pbState == 1 and retest
            pbRetestEvt := true
            pbState     := 2
    if lkState == 0
        pbState := 0
        pbDir   := 0

string pbTxt = pbState == 1 ? "Broke · awaiting" : pbState == 2 ? "Retested ◷" : pbState == 3 ? "Confirmed ✓" : pbState == 4 ? "Trap ✗" : "—"
color  pbCol = pbState == 3 ? (pbDir > 0 ? brkUpColor : brkDnColor) : pbState == 4 ? color.rgb(255, 170, 0) : pbState == 2 ? color.new(color.aqua, 0) : color.gray

plotshape(enableLifecycle and showLifeMarks and pbRetestEvt  ? close : na, "Break Retest",    shape.circle,  location.absolute, color.new(color.aqua, 0),     size=size.tiny)
plotshape(enableLifecycle and showLifeMarks and pbConfirmEvt ? close : na, "Break Confirmed",  shape.diamond, location.absolute, color.rgb(0, 230, 118),       size=size.tiny)
plotshape(enableLifecycle and showLifeMarks and pbTrapEvt    ? close : na, "Break Trap",       shape.xcross,  location.absolute, color.rgb(255, 170, 0),       size=size.small)

// ── Break event history (for last-N markers) ──
var array<int>   brkBars = array.new<int>()
var array<float> brkPxs  = array.new<float>()
var array<int>   brkDirs = array.new<int>()
if lockStructure and (freshUp or freshDn)
    array.push(brkBars, bar_index)
    array.push(brkPxs, freshDn ? low : high)
    array.push(brkDirs, freshDn ? -1 : 1)
    while array.size(brkBars) > 50
        array.shift(brkBars)
        array.shift(brkPxs)
        array.shift(brkDirs)

// Legacy raw-crossing triangles (only meaningful when lock is OFF)
plotshape(not lockStructure and enableBreakout and showBrkMarkers and showNBreaks > 0 and freshUp ? low  : na, "Breakout Up (legacy)",   shape.triangleup,   location.belowbar, brkUpColor, size=size.tiny)
plotshape(not lockStructure and enableBreakout and showBrkMarkers and showNBreaks > 0 and freshDn ? high : na, "Breakout Down (legacy)", shape.triangledown, location.abovebar, brkDnColor, size=size.tiny)

// ── Lock-mode last-N break markers (glyph only, no background) ──
var array<label> brkLabels = array.new<label>()
var line lkBreakLn = na
if barstate.islast
    for lb in brkLabels
        label.delete(lb)
    brkLabels.clear()
    line.delete(lkBreakLn)
    lkBreakLn := na
    int nb = array.size(brkBars)
    if lockStructure and enableBreakout and showBrkMarkers and showNBreaks > 0 and nb > 0
        int startI = math.max(0, nb - showNBreaks)
        for i = startI to nb - 1
            int   bb = array.get(brkBars, i)
            float bp = array.get(brkPxs, i)
            int   bd = array.get(brkDirs, i)
            color bcol = bd > 0 ? brkUpColor : brkDnColor
            float byp = bd > 0 ? bp - nz(atrVal, 0.0) * 0.4 : bp + nz(atrVal, 0.0) * 0.4
            array.push(brkLabels, label.new(bb, byp, bd > 0 ? brkMarkUp : brkMarkDn,
                 xloc=xloc.bar_index, style=label.style_none, textcolor=bcol, size=brkMarkSize,
                 tooltip=(bd > 0 ? "Break ▲ " : "Break ▼ ") + str.tostring(bp, format.mintick)))
        // dotted guide at the most recent break level
        float lastPx  = array.get(brkPxs, nb - 1)
        int   lastBar = array.get(brkBars, nb - 1)
        color lastCol = array.get(brkDirs, nb - 1) > 0 ? brkUpColor : brkDnColor
        lkBreakLn := line.new(lastBar, lastPx, bar_index, lastPx, xloc=xloc.bar_index, color=color.new(lastCol, 55), width=1, style=line.style_dotted)

// ── Pivot structure letters (HH / LH / HL / LL · H = highest high, L = lowest low) ──
var array<label> pivLabels = array.new<label>()
if barstate.islast
    for lb in pivLabels
        label.delete(lb)
    pivLabels.clear()
    if showPivots and enablePivots
        float pvOff = nz(atrVal, 0.0) * 0.35
        int nH = array.size(pivHighIdx)
        int nL = array.size(pivLowIdx)
        int   gHi = na
        float gHiV = na
        if nH > 0
            for i = 0 to nH - 1
                float v = array.get(pivHighVal, i)
                if na(gHiV) or v > gHiV
                    gHiV := v
                    gHi  := i
        int   gLo = na
        float gLoV = na
        if nL > 0
            for i = 0 to nL - 1
                float v = array.get(pivLowVal, i)
                if na(gLoV) or v < gLoV
                    gLoV := v
                    gLo  := i
        color hcol = color.new(pivotHighColor, pivotMarkerTransp)
        color lcol = color.new(pivotLowColor, pivotMarkerTransp)
        if nH > 0
            for i = 0 to nH - 1
                string t = i == gHi ? "H" : (i > 0 and array.get(pivHighVal, i) > array.get(pivHighVal, i - 1)) ? "HH" : "LH"
                array.push(pivLabels, label.new(array.get(pivHighIdx, i), array.get(pivHighVal, i) + pvOff, t,
                     xloc=xloc.bar_index, style=label.style_none, textcolor=hcol, size=pivotMarkerSize))
        if nL > 0
            for i = 0 to nL - 1
                string t = i == gLo ? "L" : (i > 0 and array.get(pivLowVal, i) > array.get(pivLowVal, i - 1)) ? "HL" : "LL"
                array.push(pivLabels, label.new(array.get(pivLowIdx, i), array.get(pivLowVal, i) - pvOff, t,
                     xloc=xloc.bar_index, style=label.style_none, textcolor=lcol, size=pivotMarkerSize))

// ════════════════════════════════════════════════════════════════════════════
// AUTO-ANCHORED VWAP  (standard 3-band; dual-anchor, most-relevant winner shows)
// ════════════════════════════════════════════════════════════════════════════
// A true anchored VWAP accumulates from ONE fixed bar. ta.vwap(<pivot cond>) re-anchors at every
// pivot (a sawtooth) and can't represent a single anchor, so we accumulate the volume-weighted
// mean and volume-weighted σ manually from the chosen bar. TWO anchor candidates can run at once:
//   A = OLS rail start — beginning bar of the active OLS upper/lower rail
//   B = Breakout swing — newest swing before/after the break (raw-price scan; catches swings still
//       inside the pivotRight confirmation blind window)
// In "Both" mode both accumulate every bar, but only the MOST RELEVANT (newest/better anchor, then
// VWAP mid nearest current price) is drawn; the inferior one is deleted. Kills/traps are gated to
// the DISPLAYED winner so the invisible loser can never clear or flip the line you are watching.
float vSrc = nz(vwapSrc, close)
float vVol = nz(volume, 0.0)
// Unconditional rolling raw buffers. The break-time backfill and anchor scans read from THESE
// (array access) instead of series history `vSrc[off]` inside a conditional function — series-
// history reads in a conditional scope are inconsistent (CW10003). Updated every bar, capped
// just past 500. rawHi/rawLo are the SOURCE OF TRUTH for anchor placement: true wicks, not
// pivot-confirmed derivatives.
var array<float> rawSrc = array.new<float>()
var array<float> rawVol = array.new<float>()
var array<float> rawHi  = array.new<float>()
var array<float> rawLo  = array.new<float>()
array.push(rawSrc, vSrc)
array.push(rawVol, vVol)
array.push(rawHi, high)
array.push(rawLo, low)
if array.size(rawSrc) > 520
    array.shift(rawSrc)
    array.shift(rawVol)
    array.shift(rawHi)
    array.shift(rawLo)

// TRUE extreme bar from RAW price — catches what the pivot arrays structurally
// cannot see: wicks inside the pivotRight confirmation blind window, and extremes
// that never met the left/right pivot definition. Ties → earliest bar.
f_rawExtremeBarRange(bool down, int fromBar, int toBar) =>
    int   sz     = array.size(rawHi)
    int   startB = math.max(nz(fromBar, bar_index), bar_index - sz + 1)
    int   endB   = math.min(nz(toBar, bar_index), bar_index)
    int   bx     = na
    float bv     = na
    if endB >= startB and sz > 0
        for b = startB to endB
            int idx = sz - 1 - (bar_index - b)
            if idx >= 0 and idx < sz
                float v = down ? array.get(rawHi, idx) : array.get(rawLo, idx)
                if na(bv) or (down ? v > bv : v < bv)
                    bv := v
                    bx := b
    bx

f_rawExtremeBar(bool down, int fromBar) =>
    f_rawExtremeBarRange(down, fromBar, bar_index)

// PATCH P1 — raw price at a specific bar from the wick buffers (na if outside the 520-bar buffer).
// Used to PRICE-QUALIFY a raw swing before it is allowed to beat/replace a killed anchor, so a
// vacuous non-empty range can no longer neutralize the kill guard every bar.
f_rawPxAt(bool down, int b) =>
    int sz  = array.size(rawHi)
    int idx = sz - 1 - (bar_index - b)
    idx >= 0 and idx < sz ? (down ? array.get(rawHi, idx) : array.get(rawLo, idx)) : na

// Confirmed rail/pivot anchor helpers for AVWAP.
// OLS Rail Start means the rail-start bar (window start), NOT a highest/lowest wick scan of the
// whole old pattern window. Breakout Swing means the newest active pivot/swing, with a raw-price
// fallback so the pivotRight blind-window low/high can take over immediately.
f_pivotAnchor(bool down, int fromBar, int toBar, bool latest) =>
    int out = na
    int n   = down ? array.size(pivHighIdx) : array.size(pivLowIdx)
    if n > 0
        for i = 0 to n - 1
            int bx = down ? array.get(pivHighIdx, i) : array.get(pivLowIdx, i)
            bool ok = not na(bx) and not na(fromBar) and bx >= fromBar and (na(toBar) or bx <= toBar)
            if ok
                if na(out)
                    out := bx
                else if latest and bx > out
                    out := bx
    out

f_pivotAnchorClosest(bool down, int refBar, int fromBar, int toBar) =>
    int out      = na
    int bestDist = na
    int n        = down ? array.size(pivHighIdx) : array.size(pivLowIdx)
    if n > 0 and not na(refBar)
        for i = 0 to n - 1
            int bx = down ? array.get(pivHighIdx, i) : array.get(pivLowIdx, i)
            bool ok = not na(bx) and not na(fromBar) and bx >= fromBar and (na(toBar) or bx <= toBar)
            if ok
                int d = math.abs(bx - refBar)
                if na(bestDist) or d < bestDist or (d == bestDist and bx < out)
                    bestDist := d
                    out      := bx
    out

f_olsRailStartAnchor(bool down, int railHiOrigin, int railLoOrigin, int fallback, int toBar) =>
    // OLS rail-start anchor — the SIDE-CORRECT rail origin bar:
    //   down = true  (bearish / down-break) → UPPER rail origin (earliest high pivot fit)
    //   down = false (bullish / up-break)   → LOWER rail origin (earliest low pivot fit)
    // The OLS engine fits each rail through its own set of pivots, so the two rails begin at
    // DIFFERENT bars. Anchoring the VWAP at the upper origin on a down-break seeds accumulation
    // from the structure's high side — visibly distinct from the breakout-swing anchor instead of
    // collapsing onto it. Clamped to the raw buffer; falls back to the shared window start / break.
    int origin    = down ? railHiOrigin : railLoOrigin
    int ref       = not na(origin) ? origin : nz(fallback, bar_index)
    int oldestRaw = bar_index - array.size(rawSrc) + 1
    int endB      = nz(toBar, bar_index)
    int a         = math.max(oldestRaw, math.min(ref, endB))
    a

f_latestSwingAnchor(bool down, int fromBar, int toBar) =>
    int a   = f_pivotAnchor(down, fromBar, toBar, true)
    int raw = f_rawExtremeBarRange(down, fromBar, toBar)
    if not na(raw) and (na(a) or raw > a)
        a := raw
    a

type Avwap
    int          side
    int          anchor
    int          brkBar
    float        cumPV
    float        cumV
    float        cumP2V
    array<int>   bars
    array<float> mids
    array<float> sigs

f_avNew() =>
    Avwap.new(0, na, na, na, na, na, array.new<int>(), array.new<float>(), array.new<float>())

f_avClear(Avwap a) =>
    a.side   := 0
    a.anchor := na
    a.brkBar := na
    a.cumPV  := na
    a.cumV   := na
    a.cumP2V := na
    array.clear(a.bars)
    array.clear(a.mids)
    array.clear(a.sigs)

f_avReset(Avwap a, int side, int anchor, int brkB) =>
    a.side   := side
    a.anchor := anchor
    a.brkBar := brkB
    a.cumPV  := 0.0
    a.cumV   := 0.0
    a.cumP2V := 0.0
    array.clear(a.bars)
    array.clear(a.mids)
    array.clear(a.sigs)
    int span0 = math.min(bar_index - anchor, 500)
    int sz    = array.size(rawSrc)
    for k = 0 to span0
        int off = span0 - k
        int idx = sz - 1 - off
        if idx >= 0
            float p = array.get(rawSrc, idx)
            float v = array.get(rawVol, idx)
            a.cumPV  += p * v
            a.cumV   += v
            a.cumP2V += p * p * v
            float m  = a.cumV > 0 ? a.cumPV / a.cumV : na
            float vr = a.cumV > 0 ? math.max(a.cumP2V / a.cumV - m * m, 0.0) : na
            array.push(a.bars, bar_index - off)
            array.push(a.mids, m)
            array.push(a.sigs, na(vr) ? na : math.sqrt(vr))

f_avStep(Avwap a) =>
    if a.side != 0 and not na(a.anchor)
        a.cumPV  += vSrc * vVol
        a.cumV   += vVol
        a.cumP2V += vSrc * vSrc * vVol
        float m  = a.cumV > 0 ? a.cumPV / a.cumV : na
        float vr = a.cumV > 0 ? math.max(a.cumP2V / a.cumV - m * m, 0.0) : na
        array.push(a.bars, bar_index)
        array.push(a.mids, m)
        array.push(a.sigs, na(vr) ? na : math.sqrt(vr))

f_avMid(Avwap a) =>
    (a.side != 0 and not na(a.cumV) and a.cumV > 0) ? a.cumPV / a.cumV : na

f_avAge(Avwap a) =>
    na(a.brkBar) ? na : bar_index - a.brkBar

f_avReclaimed(Avwap a) =>
    float m = f_avMid(a)
    a.side == 1 ? (not na(m) and close > m) : a.side == -1 ? (not na(m) and close < m) : false

f_avReclaimCross(Avwap a) =>
    float m = f_avMid(a)
    a.side == 1 ? (not na(m) and close > m and close[1] <= m[1]) : a.side == -1 ? (not na(m) and close < m and close[1] >= m[1]) : false

// True anchor = the actual swing wick bar (pivot confirms pivotRight bars later → subtract it).
var int lastHighAnchor = na
var int lastLowAnchor  = na
if not na(ph)
    lastHighAnchor := bar_index - pivotRight
if not na(pl)
    lastLowAnchor  := bar_index - pivotRight

bool useExt   = vwapAnchorMode == "OLS rail start" or vwapAnchorMode == "Both — nearest wins"
bool useSwing = vwapAnchorMode == "Breakout swing"  or vwapAnchorMode == "Both — nearest wins"

var Avwap avA = f_avNew()   // OLS rail start
var Avwap avB = f_avNew()   // Breakout swing
// PATCH P4 — which candidate was DISPLAYED last bar: 1 = avA · 2 = avB · 0 = none.
// Kills and trap events are gated to the displayed winner so the hidden loser can never clear
// or flip the visible AVWAP, nor fire a trap diamond/alert off a line that isn't on the chart.
var int vwLastWin = 0

// AVWAP CONTROL PATH
// Persistent doctrine:
//   • Fresh break OR already-active broken structure can arm AVWAP.
//   • Existing AVWAP clears on VWAP reclaim/breakdown (only the DISPLAYED candidate can trigger it).
//   • Optional Remove After N Bars can also clear it by age.
//   • A newer/better pivot anchor can replace the old anchor — but only when it structurally
//     EXCEEDS the killed anchor's price (P1), so the kill guard is never vacuously neutralized.
//   • OLS-rail-start and breakout-swing candidates still run independently.
bool activeDnBreak = freshDn or (lockStructure and lkState == 2 and lkBreakDir == -1) or ((not lockStructure) and legDn)
bool activeUpBreak = freshUp or (lockStructure and lkState == 2 and lkBreakDir == 1)  or ((not lockStructure) and legUp)
bool activeFresh   = freshDn or freshUp
int  rawActiveSide = activeDnBreak ? 1 : activeUpBreak ? -1 : 0
var int avForcedSide = 0
int  activeSide    = activeFresh ? rawActiveSide : (avForcedSide != 0 ? avForcedSide : rawActiveSide)
int  activeBrkBar  = activeFresh ? bar_index : (lockStructure and lkState == 2 ? lkBreakBar : bar_index)
int  activeWinX1   = not na(lkX1) ? lkX1 : chX1
// Side-correct rail origins for the OLS-rail-start anchor: prefer the LOCKED origin (the window the
// break belongs to), fall back to the live fit if the lock never captured one.
int  activeRailHi  = not na(lkX1Hi) ? lkX1Hi : chStartHi
int  activeRailLo  = not na(lkX1Lo) ? lkX1Lo : chStartLo

var int avKilledBrkBar = na
var int avKilledSide   = 0
var int avKilledPivot  = na

// AVWAP state helpers must be evaluated once on every bar.
// This avoids Pine consistency warnings from calling f_avReclaimed(), f_avReclaimCross(),
// or f_avAge() only inside short-circuited conditional branches.
bool  avAReclaimedNow    = f_avReclaimed(avA)
bool  avBReclaimedNow    = f_avReclaimed(avB)
bool  avAReclaimCrossNow = f_avReclaimCross(avA)
bool  avBReclaimCrossNow = f_avReclaimCross(avB)
float avAAgeNow          = f_avAge(avA)
float avBAgeNow          = f_avAge(avB)

// PATCH P4 — reclaim/trap booleans gated to the DISPLAYED winner (vwLastWin), computed BEFORE
// candidate clearing so the marker/alert survives the same-bar removal.
bool reclaimA = enableVwap and useExt   and avAReclaimedNow and vwLastWin != 2
bool reclaimB = enableVwap and useSwing and avBReclaimedNow and vwLastWin != 1
bool vwapTrapBear = (vwLastWin != 2 and useExt and avA.side == 1 and avAReclaimCrossNow) or (vwLastWin != 1 and useSwing and avB.side == 1 and avBReclaimCrossNow)
bool vwapTrapBull = (vwLastWin != 2 and useExt and avA.side == -1 and avAReclaimCrossNow) or (vwLastWin != 1 and useSwing and avB.side == -1 and avBReclaimCrossNow)

// Optional legacy age removal. OFF by default. When ON, it behaves like a controlled kill
// for this break and will not immediately re-arm until a fresh break or a newer pivot beats it.
bool ageKillA = enableVwap and vwapRemoveAfterN and useExt   and avA.side != 0 and not na(avAAgeNow) and avAAgeNow > vwapMaxBars
bool ageKillB = enableVwap and vwapRemoveAfterN and useSwing and avB.side != 0 and not na(avBAgeNow) and avBAgeNow > vwapMaxBars

bool didResetA = false
bool didResetB = false

bool killA = reclaimA or ageKillA
bool killB = (not killA) and (reclaimB or ageKillB)
if killA or killB
    int  killSide        = killA ? avA.side : avB.side
    int  killBrkBar      = killA ? avA.brkBar : avB.brkBar
    bool killedByReclaim = killA ? reclaimA : reclaimB

    avKilledBrkBar := nz(killBrkBar, activeBrkBar)
    avKilledSide   := killSide
    avKilledPivot  := killSide == 1 ? lastHighAnchor : killSide == -1 ? lastLowAnchor : na
    avForcedSide   := killedByReclaim and killSide != 0 ? -killSide : 0

    f_avClear(avA)
    f_avClear(avB)

    // Reclaim flip:
    // If a bearish AVWAP is reclaimed, immediately flip to the newest structural LOW.
    // If a bullish AVWAP breaks down, immediately flip to the newest structural HIGH.
    // Age kills do NOT flip; they only clear by time.
    if killedByReclaim and killSide != 0
        int  flipSide     = -killSide
        bool flipDownMode = flipSide == 1

        // Reclaim handoff must flip to the newest structural pivot/swing of the opposite side.
        // This prevents BOTH mode from falling back to an old false pattern extreme.
        int flipScanBase = not na(avKilledPivot) ? math.max(nz(activeWinX1, bar_index), avKilledPivot + 1) : nz(activeWinX1, bar_index)
        int flipSwingBar = f_latestSwingAnchor(flipDownMode, flipScanBase, bar_index)
        if na(flipSwingBar)
            flipSwingBar := bar_index

        // In the immediate reclaim-flip state, the structural OLS-start candidate becomes the
        // same new-side pivot/swing. After a fresh locked break, OLS Rail Start uses the
        // OLS rail beginning again.
        int flipExtBar = flipSwingBar

        if useExt and not na(flipExtBar)
            f_avReset(avA, flipSide, flipExtBar, bar_index)
            didResetA := true
        if useSwing and not na(flipSwingBar)
            f_avReset(avB, flipSide, flipSwingBar, bar_index)
            didResetB := true

if activeFresh
    avKilledBrkBar := na
    avKilledSide   := 0
    avKilledPivot  := na
    avForcedSide   := 0

int  pivotRef        = activeSide == 1 ? lastHighAnchor : activeSide == -1 ? lastLowAnchor : na
// PATCH P2 — the guard's job is "don't blind-re-arm the regime we just killed"; side identity
// IS the regime, so the brkBar-equality clause is dropped (it made the guard trivially false on
// takeover/age re-arms and let the kill be re-armed the same bar).
bool killedThisBreak = enableVwap and activeSide != 0 and avKilledSide == activeSide

// PATCH P1 — a raw swing only BEATS the killed anchor if it structurally EXCEEDS it in PRICE:
// a higher high (side 1) / lower low (side -1) than the killed pivot itself. Without the price
// test the range is non-empty by construction, so the beat fired every bar and neutralized the
// kill (breaking both the reclaim flip and Remove-After-N).
int rawBeatPivot = na
if killedThisBreak and not na(avKilledPivot)
    int rb = f_rawExtremeBar(activeSide == 1, avKilledPivot + 1)
    if not na(rb)
        float rbPx     = f_rawPxAt(activeSide == 1, rb)
        float killedPx = f_rawPxAt(activeSide == 1, avKilledPivot)
        if not na(rbPx) and not na(killedPx) and (activeSide == 1 ? rbPx > killedPx : rbPx < killedPx)
            rawBeatPivot := rb

bool confirmedPivotBeat = killedThisBreak and not na(pivotRef)     and (na(avKilledPivot) or pivotRef > avKilledPivot)
bool rawPivotBeat       = killedThisBreak and not na(rawBeatPivot) and (na(avKilledPivot) or rawBeatPivot > avKilledPivot)
bool newPivotBeat       = confirmedPivotBeat or rawPivotBeat

if newPivotBeat
    avKilledBrkBar := na
    avKilledSide   := 0
    avKilledPivot  := na
    killedThisBreak := false

bool canArmVwap = enableVwap and activeSide != 0 and not killedThisBreak

if canArmVwap
    bool downMode = activeSide == 1
    int  side     = activeSide

    // OLS Rail Start: beginning of active OLS upper/lower rail, not a pivot/high-low scan.
    int extBar = f_olsRailStartAnchor(downMode, activeRailHi, activeRailLo, nz(activeWinX1, bar_index), activeBrkBar)
    if na(extBar)
        extBar := bar_index

    // Breakout swing:
    // On a fresh break, scan raw price from the last confirmed pivot forward to catch
    // the pivotRight blind-window wick. Afterward, a newer confirmed pivot or
    // post-reclaim raw swing can take over the anchor.
    int confPiv = downMode ? lastHighAnchor : lastLowAnchor
    int swingBar = na
    if activeFresh
        int scanFrom = na(confPiv) ? math.max(nz(activeWinX1, bar_index), bar_index - (pivotLeft + pivotRight + 1)) : confPiv
        swingBar := f_rawExtremeBar(downMode, scanFrom)
        if na(swingBar)
            swingBar := na(confPiv) ? bar_index : confPiv
    else
        // After a VWAP reclaim/age kill, use the latest confirmed/raw swing of the active side
        // after the killed anchor. This lets the newest pivot low/high take over immediately.
        int postKillFrom  = not na(avKilledPivot) ? avKilledPivot + 1 : nz(activeWinX1, bar_index)
        int postKillSwing = f_latestSwingAnchor(downMode, postKillFrom, bar_index)
        swingBar := not na(postKillSwing) ? postKillSwing : confPiv

    bool resetA = useExt and not na(extBar) and (activeFresh or avA.side == 0 or avA.side != side or na(avA.anchor))
    bool resetB = useSwing and not na(swingBar) and (activeFresh or avB.side == 0 or avB.side != side or na(avB.anchor) or (not na(avB.anchor) and swingBar > avB.anchor))

    // PATCH P3 — every arm/takeover/re-arm restarts the age clock from THIS bar (bar_index),
    // not the original break bar. A takeover is a new anchoring event and must get a fresh age
    // budget; without this, P1+P2 would let an age-killed AVWAP flicker back for one bar on each
    // new extreme swing. (Fresh breaks are unaffected: activeBrkBar already equals bar_index.)
    if resetA
        f_avReset(avA, side, extBar, bar_index)
        didResetA := true
    if resetB
        f_avReset(avB, side, swingBar, bar_index)
        didResetB := true

if useExt and not didResetA
    f_avStep(avA)
if useSwing and not didResetB
    f_avStep(avB)

// WINNER = newest/better anchor first, then VWAP mid nearest current price (ties → OLS rail start).
// PATCH P4 — record which candidate is displayed this bar into vwLastWin (no UDT == in Pine).
float midA = f_avMid(avA)
float midB = f_avMid(avB)
bool  okA  = avA.side != 0 and not na(midA) and array.size(avA.bars) >= 2
bool  okB  = avB.side != 0 and not na(midB) and array.size(avB.bars) >= 2
Avwap win = na
if okA and okB
    if avA.anchor != avB.anchor
        bool bNewer = avB.anchor > avA.anchor
        win       := bNewer ? avB : avA
        vwLastWin := bNewer ? 2 : 1
    else
        bool aWins = math.abs(close - midA) <= math.abs(close - midB)
        win       := aWins ? avA : avB
        vwLastWin := aWins ? 1 : 2
else if okA
    win       := avA
    vwLastWin := 1
else if okB
    win       := avB
    vwLastWin := 2
else
    vwLastWin := 0

bool  vwOn     = enableVwap and not na(win)
int   vwapSide = na(win) ? 0 : win.side
float vwMid    = na(win) ? na : f_avMid(win)
float vwSig    = (not na(win) and array.size(win.sigs) > 0) ? array.get(win.sigs, array.size(win.sigs) - 1) : na

// ── DELETABLE rendering ───────────────────────────────────────────────────────
// plot() paints the ENTIRE series history — every past anchor is frozen on the chart
// permanently and can never be removed. Instead we redraw the live VWAP as polylines on
// the last bar, built only from the active window (anchor → now). Old objects are deleted
// first, so a newer break or an age beyond Max genuinely clears the prior VWAP.
//
// FORWARD PROJECTION (Extend N Bars) is appended to the SAME polylines after the last real
// point. It is drawing only — the projected bars never touch cumPV / cumV / cumP2V, so the
// VWAP value at the last real bar is final and unaffected. Sloped mode advances the mid and
// the σ envelope along their own recent slopes and rebuilds the bands from those projected
// values, so a fanning band structure keeps fanning; flat mode carries both forward unchanged.
var array<polyline> vwPolys = array.new<polyline>()
var label           vwLbl   = na
if barstate.islast
    if array.size(vwPolys) > 0
        for p in vwPolys
            polyline.delete(p)
        vwPolys.clear()
    label.delete(vwLbl)
    vwLbl := na
    if vwOn
        int n = array.size(win.bars)
        array<chart.point> pMid = array.new<chart.point>()
        array<chart.point> p1u  = array.new<chart.point>()
        array<chart.point> p1l  = array.new<chart.point>()
        array<chart.point> p2u  = array.new<chart.point>()
        array<chart.point> p2l  = array.new<chart.point>()
        array<chart.point> p3u  = array.new<chart.point>()
        array<chart.point> p3l  = array.new<chart.point>()
        for i = 0 to n - 1
            int   bx = array.get(win.bars, i)
            float m  = array.get(win.mids, i)
            float s  = array.get(win.sigs, i)
            if not na(m)
                array.push(pMid, chart.point.from_index(bx, m))
                if not na(s)
                    if vwapShowB1
                        array.push(p1u, chart.point.from_index(bx, m + vwapMult1 * s))
                        array.push(p1l, chart.point.from_index(bx, m - vwapMult1 * s))
                    if vwapShowB2
                        array.push(p2u, chart.point.from_index(bx, m + vwapMult2 * s))
                        array.push(p2l, chart.point.from_index(bx, m - vwapMult2 * s))
                    if vwapShowB3
                        array.push(p3u, chart.point.from_index(bx, m + vwapMult3 * s))
                        array.push(p3l, chart.point.from_index(bx, m - vwapMult3 * s))

        // ── Forward projection: append projected points to the same polylines ──
        if vwapExtendBars > 0 and n >= 2
            int   lastBx = array.get(win.bars, n - 1)
            float lastM  = array.get(win.mids, n - 1)
            float lastS  = array.get(win.sigs, n - 1)
            // Slope reference bar, clamped to available anchored history.
            int   back   = math.max(1, math.min(vwapSlopeLen, n - 1))
            float refM   = array.get(win.mids, n - 1 - back)
            float refS   = array.get(win.sigs, n - 1 - back)
            // Slopes are per-bar. Flat mode (or missing reference) → 0.0, which makes the
            // projection an exact carry-forward of the last real value.
            float mSlope = (vwapExtendSlope and not na(lastM) and not na(refM)) ? (lastM - refM) / back : 0.0
            float sSlope = (vwapExtendSlope and not na(lastS) and not na(refS)) ? (lastS - refS) / back : 0.0
            if not na(lastM)
                for e = 1 to vwapExtendBars
                    int bxE = lastBx + e
                    if bxE <= bar_index + 490
                        float mE = lastM + mSlope * e
                        // σ can never go negative — a steep negative σ slope clamps at zero
                        // (bands collapse onto the mid) instead of inverting the envelope.
                        float sE = na(lastS) ? na : math.max(lastS + sSlope * e, 0.0)
                        array.push(pMid, chart.point.from_index(bxE, mE))
                        if not na(sE)
                            if vwapShowB1
                                array.push(p1u, chart.point.from_index(bxE, mE + vwapMult1 * sE))
                                array.push(p1l, chart.point.from_index(bxE, mE - vwapMult1 * sE))
                            if vwapShowB2
                                array.push(p2u, chart.point.from_index(bxE, mE + vwapMult2 * sE))
                                array.push(p2l, chart.point.from_index(bxE, mE - vwapMult2 * sE))
                            if vwapShowB3
                                array.push(p3u, chart.point.from_index(bxE, mE + vwapMult3 * sE))
                                array.push(p3l, chart.point.from_index(bxE, mE - vwapMult3 * sE))

        if array.size(pMid) >= 2
            array.push(vwPolys, polyline.new(pMid, curved=false, line_color=color.new(vwapColor, vwapTransp),     line_width=vwapWidth))
        if vwapShowB1 and array.size(p1u) >= 2
            array.push(vwPolys, polyline.new(p1u, curved=false, line_color=color.new(vwapBand1Col, vwapTransp), line_width=1))
            array.push(vwPolys, polyline.new(p1l, curved=false, line_color=color.new(vwapBand1Col, vwapTransp), line_width=1))
        if vwapShowB2 and array.size(p2u) >= 2
            array.push(vwPolys, polyline.new(p2u, curved=false, line_color=color.new(vwapBand2Col, vwapTransp), line_width=1))
            array.push(vwPolys, polyline.new(p2l, curved=false, line_color=color.new(vwapBand2Col, vwapTransp), line_width=1))
        if vwapShowB3 and array.size(p3u) >= 2
            array.push(vwPolys, polyline.new(p3u, curved=false, line_color=color.new(vwapBand3Col, vwapTransp), line_width=1))
            array.push(vwPolys, polyline.new(p3l, curved=false, line_color=color.new(vwapBand3Col, vwapTransp), line_width=1))
        if vwapLabel
            vwLbl := label.new(array.get(win.bars, n - 1), array.get(win.mids, n - 1), "AVWAP", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(vwapColor, 35), textcolor=color.white, size=size.tiny)

// Trap signal: price reclaiming the VWAP after a break (bear trap after a down-break, bull trap
// after an up-break). The booleans are computed BEFORE candidate clearing and gated to the
// DISPLAYED winner (P4), so the reclaim alert/marker survives the same-bar removal and never
// fires off an invisible candidate.
plotshape(vwapTrapMarks and vwapTrapBear ? low  : na, "Bear Trap (failed break)", shape.diamond, location.belowbar, vwapColor, size=size.tiny)
plotshape(vwapTrapMarks and vwapTrapBull ? high : na, "Bull Trap (failed break)", shape.diamond, location.abovebar, vwapColor, size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
// FLAGS & PENNANTS  (impulse pole + tight consolidation → continuation break)
// ════════════════════════════════════════════════════════════════════════════
// Self-contained continuation detector, independent of the channel pattern engine:
//   POLE  — a ≥ poleMinATR move over poleLen bars
//   BODY  — a tight consolidation (≤ flagMaxRetr of the pole) within flagMaxBars
//   BREAK — close beyond the body in the pole's direction → continuation; target = pole height
float poleRet = close - close[poleLen]
float poleMag = math.abs(poleRet)
bool  poleSig = enableFlags and not na(atrVal) and poleMag >= poleMinATR * atrVal
bool  poleUp  = poleSig and poleRet > 0
bool  poleDn  = poleSig and poleRet < 0

var int   flState    = 0      // 0 none · 1 building body · 2 broken
var int   flDir      = 0
var int   flPoleX1   = na
var float flPoleY1   = na
var float flPoleMag  = na
var float flPoleTip  = na
var int   flStartBar = na
var float flHi       = na
var float flLo       = na
var int   flBreakBar = na
var float flTarget   = na
var bool  flPennant  = false
bool flBreakEvt = false

if enableFlags
    if flState == 0
        if poleUp or poleDn
            flState    := 1
            flDir      := poleUp ? 1 : -1
            flPoleX1   := bar_index - poleLen
            flPoleY1   := close[poleLen]
            flPoleMag  := poleMag
            flPoleTip  := close
            flStartBar := bar_index
            flHi       := high
            flLo       := low
    else if flState == 1
        // Test the break against the body AS IT STOOD BEFORE this bar — only fold this
        // bar into flHi/flLo if it did NOT break. (Absorbing first makes close>flHi /
        // close<flLo mathematically impossible, which silently kills every flag break.)
        int   age     = bar_index - flStartBar
        bool  brokeUp = flDir > 0 and close > flHi
        bool  brokeDn = flDir < 0 and close < flLo
        bool  broke   = brokeUp or brokeDn
        if not broke
            flHi := math.max(flHi, high)
            flLo := math.min(flLo, low)
        float depth   = flHi - flLo
        bool  tooDeep = depth > flagMaxRetr * flPoleMag
        bool  expired = age > flagMaxBars
        if expired or tooDeep
            flState := 0
        else if broke
            flState    := 2
            flBreakBar := bar_index
            flBreakEvt := true
            flTarget   := flDir > 0 ? flPoleTip + flPoleMag : flPoleTip - flPoleMag
            flPennant  := depth < flPoleMag * 0.35
    else if flState == 2
        if poleUp or poleDn
            flState    := 1
            flDir      := poleUp ? 1 : -1
            flPoleX1   := bar_index - poleLen
            flPoleY1   := close[poleLen]
            flPoleMag  := poleMag
            flPoleTip  := close
            flStartBar := bar_index
            flHi       := high
            flLo       := low
        else if bar_index - flBreakBar > flagMaxBars
            flState := 0

float flConv  = (enableFlags and flState >= 1 and not na(flPoleMag)) ? f_flagConv(flPoleMag, flHi - flLo, flState == 2 ? math.abs(close - (flDir > 0 ? flHi : flLo)) : 0.0, volThrust) : na
float flBase  = na(flConv) ? na : flConv * (enableRanker ? f_rankMult(2, f_confAgree(flDir)) : 1.0) * f_regimeMult(2)
float flConvR = na(flBase) ? na : math.round(math.min(flBase, 10.0), 1)
string flTxt    = flState == 2 ? ((flPennant ? "Pennant " : "Flag ") + (flDir > 0 ? "▲ Bull" : "▼ Bear") + (not na(flConvR) ? " ⚡" + str.tostring(flConvR, "#.#") : "")) : flState == 1 ? "Forming…" : "—"
color  flTxtCol = flState == 2 ? (flDir > 0 ? flagBullCol : flagBearCol) : color.gray

var box   flBox  = na
var line  flPole = na
var line  flTgt  = na
var label flLbl  = na
if barstate.islast
    box.delete(flBox)
    line.delete(flPole)
    line.delete(flTgt)
    label.delete(flLbl)
    flBox  := na
    flPole := na
    flTgt  := na
    flLbl  := na
    bool drawFlag = enableFlags and (flState == 2 or (flState == 1 and not flagNeedBreak))
    if drawFlag and not na(flStartBar)
        color fcol = flDir > 0 ? flagBullCol : flagBearCol
        int   bx2  = flState == 2 and not na(flBreakBar) ? flBreakBar : bar_index
        flBox  := box.new(flStartBar, flHi, bx2 + flagBoxExtend, flLo, border_color=fcol, bgcolor=color.new(fcol, flagBoxTransp), border_width=1)
        flPole := line.new(flPoleX1, flPoleY1, flStartBar, flPoleTip, color=fcol, width=2)
        if flagShowTgt and flState == 2 and not na(flTarget)
            flTgt := line.new(flBreakBar, flPoleTip, bar_index + 5, flTarget, color=fcol, width=1, style=line.style_dotted)
        if flagShowLabel
            string flIcon = (flDir > 0 ? "⚑▲" : "⚑▼") + (flState == 1 ? " ?" : "")
            string flTip  = (flPennant ? "Pennant" : "Flag") + " · " + (flDir > 0 ? "Bull (continuation ↑)" : "Bear (continuation ↓)") + "\n" + (flState == 2 ? "Confirmed — broke the body in the pole direction ✓" : "Forming — pole set, awaiting body break ?") + "\nPole size: " + str.tostring(flPoleMag, format.mintick) + (flState == 2 and not na(flTarget) ? "\nMeasured-move target: " + str.tostring(flTarget, format.mintick) : "") + (not na(flConv) ? "\n⚡ Conviction: " + str.tostring(flConv, "#.#") + (enableRanker ? " → ranked " + str.tostring(flConvR, "#.#") + " (learned edge)" : "") : "")
            flLbl := label.new(bx2, flLo - nz(atrVal, 0.0) * 0.6, flIcon, xloc=xloc.bar_index, style=label.style_none, textcolor=fcol, size=flagLblSize, tooltip=flTip)

// ════════════════════════════════════════════════════════════════════════════
// REVERSAL PATTERN ENGINE  (Phase 3 — pivot-geometry, channel-independent)
// Double Top/Bottom and Head & Shoulders / Inverse H&S detected directly off
// the stored pivot sequence. Neckline = trough(s) between the tops; confirmation
// = decisive close through the neckline (same break-buffer discipline as the
// channel lifecycle).
// ════════════════════════════════════════════════════════════════════════════

// Lowest pivot low strictly between two bar indices (neckline for tops)
f_lowBetween(int xa, int xb) =>
    int   bx = na
    float bv = na
    int   n  = array.size(pivLowIdx)
    if n > 0
        for i = 0 to n - 1
            int x = array.get(pivLowIdx, i)
            if x > xa and x < xb
                float v = array.get(pivLowVal, i)
                if na(bv) or v < bv
                    bv := v
                    bx := x
    [bx, bv]

// Highest pivot high strictly between two bar indices (neckline for bottoms)
f_highBetween(int xa, int xb) =>
    int   bx = na
    float bv = na
    int   n  = array.size(pivHighIdx)
    if n > 0
        for i = 0 to n - 1
            int x = array.get(pivHighIdx, i)
            if x > xa and x < xb
                float v = array.get(pivHighVal, i)
                if na(bv) or v > bv
                    bv := v
                    bx := x
    [bx, bv]

string revName     = ""
string revBias     = "Neutral"
color  revCol      = color.gray
int    revNX1      = na
float  revNV1      = na
int    revNX2      = na
float  revNV2      = na
float  revNeckNow  = na
bool   revConfirmed = false
float  revSym       = na
int    revSig       = na      // stable per-instance signature = the pattern's defining pivot bar
array<int>   revMX = array.new<int>()
array<float> revMY = array.new<float>()

float revTol = nz(atrVal, 0.0) * revTolEq
float revBuf = nz(atrVal, 0.0) * revBufATR

if enableRev and not na(atrVal) and atrVal > 0.0
    int nH = array.size(pivHighIdx)
    int nL = array.size(pivLowIdx)

    // ── BEARISH TOPS ──────────────────────────────────────────────────
    // Head & Shoulders (3 highs: LS · Head · RS, head highest, shoulders ≈ equal)
    if revName == "" and nH >= 3
        int   xLS = array.get(pivHighIdx, nH - 3)
        float vLS = array.get(pivHighVal, nH - 3)
        int   xHd = array.get(pivHighIdx, nH - 2)
        float vHd = array.get(pivHighVal, nH - 2)
        int   xRS = array.get(pivHighIdx, nH - 1)
        float vRS = array.get(pivHighVal, nH - 1)
        if vHd > vLS and vHd > vRS and math.abs(vLS - vRS) <= revTol * 1.5
            [xt1, vt1] = f_lowBetween(xLS, xHd)
            [xt2, vt2] = f_lowBetween(xHd, xRS)
            if not na(vt1) and not na(vt2)
                float slp  = xt2 != xt1 ? (vt2 - vt1) / (xt2 - xt1) : 0.0
                float neck = vt1 + slp * (bar_index - xt1)
                revName      := "Head & Shoulders"
                revBias      := "Bearish"
                revCol       := revTopColor
                revNX1       := xt1
                revNV1       := vt1
                revNX2       := bar_index
                revNV2       := neck
                revNeckNow   := neck
                revConfirmed := close < neck - revBuf
                revSym       := f_clamp01(1.0 - math.abs(vLS - vRS) / nz(atrVal, 1.0))
                revSig       := xRS
                array.push(revMX, xLS)
                array.push(revMY, vLS)
                array.push(revMX, xHd)
                array.push(revMY, vHd)
                array.push(revMX, xRS)
                array.push(revMY, vRS)

    // Double Top (2 highs ≈ equal, trough between = neckline)
    if revName == "" and nH >= 2
        int   xa = array.get(pivHighIdx, nH - 2)
        float va = array.get(pivHighVal, nH - 2)
        int   xb = array.get(pivHighIdx, nH - 1)
        float vb = array.get(pivHighVal, nH - 1)
        if math.abs(va - vb) <= revTol
            [xt, vt] = f_lowBetween(xa, xb)
            if not na(vt)
                revName      := "Double Top"
                revBias      := "Bearish"
                revCol       := revTopColor
                revNX1       := xt
                revNV1       := vt
                revNX2       := bar_index
                revNV2       := vt
                revNeckNow   := vt
                revConfirmed := close < vt - revBuf
                revSym       := f_clamp01(1.0 - math.abs(va - vb) / nz(atrVal, 1.0))
                revSig       := xb
                array.push(revMX, xa)
                array.push(revMY, va)
                array.push(revMX, xb)
                array.push(revMY, vb)

    // ── BULLISH BOTTOMS (only if no top matched) ──────────────────────
    // Inverse Head & Shoulders (3 lows: LS · Head · RS, head lowest)
    if revName == "" and nL >= 3
        int   xLSb = array.get(pivLowIdx, nL - 3)
        float vLSb = array.get(pivLowVal, nL - 3)
        int   xHdb = array.get(pivLowIdx, nL - 2)
        float vHdb = array.get(pivLowVal, nL - 2)
        int   xRSb = array.get(pivLowIdx, nL - 1)
        float vRSb = array.get(pivLowVal, nL - 1)
        if vHdb < vLSb and vHdb < vRSb and math.abs(vLSb - vRSb) <= revTol * 1.5
            [xp1, vp1] = f_highBetween(xLSb, xHdb)
            [xp2, vp2] = f_highBetween(xHdb, xRSb)
            if not na(vp1) and not na(vp2)
                float slpb  = xp2 != xp1 ? (vp2 - vp1) / (xp2 - xp1) : 0.0
                float neckb = vp1 + slpb * (bar_index - xp1)
                revName      := "Inverse H&S"
                revBias      := "Bullish"
                revCol       := revBotColor
                revNX1       := xp1
                revNV1       := vp1
                revNX2       := bar_index
                revNV2       := neckb
                revNeckNow   := neckb
                revConfirmed := close > neckb + revBuf
                revSym       := f_clamp01(1.0 - math.abs(vLSb - vRSb) / nz(atrVal, 1.0))
                revSig       := xRSb
                array.push(revMX, xLSb)
                array.push(revMY, vLSb)
                array.push(revMX, xHdb)
                array.push(revMY, vHdb)
                array.push(revMX, xRSb)
                array.push(revMY, vRSb)

    // Double Bottom (2 lows ≈ equal, peak between = neckline)
    if revName == "" and nL >= 2
        int   xc = array.get(pivLowIdx, nL - 2)
        float vc = array.get(pivLowVal, nL - 2)
        int   xd = array.get(pivLowIdx, nL - 1)
        float vd = array.get(pivLowVal, nL - 1)
        if math.abs(vc - vd) <= revTol
            [xp, vp] = f_highBetween(xc, xd)
            if not na(vp)
                revName      := "Double Bottom"
                revBias      := "Bullish"
                revCol       := revBotColor
                revNX1       := xp
                revNV1       := vp
                revNX2       := bar_index
                revNV2       := vp
                revNeckNow   := vp
                revConfirmed := close > vp + revBuf
                revSym       := f_clamp01(1.0 - math.abs(vc - vd) / nz(atrVal, 1.0))
                revSig       := xd
                array.push(revMX, xc)
                array.push(revMY, vc)
                array.push(revMX, xd)
                array.push(revMY, vd)

// Fresh-confirmation event (deduped per pattern instance via the defining pivot bar — NOT the
// neckline price, which drifts every bar on a sloped H&S/iH&S and would re-fire continuously).
var int    lastRevSig  = na
var string lastRevName = ""
bool revGo    = revName != "" and (revNeedBreak ? revConfirmed : true)
bool revFresh = revGo and (na(lastRevSig) or revSig != lastRevSig or revName != lastRevName)
if revFresh
    lastRevSig  := revSig
    lastRevName := revName

// Reversal conviction (symmetry · neckline-break decisiveness · volume thrust), ranker-weighted
int   revDirN  = revBias == "Bearish" ? -1 : revBias == "Bullish" ? 1 : 0
float revConv  = (enableRev and revName != "") ? f_revConv(nz(revSym, 0.5), math.abs(close - nz(revNeckNow, close)), volThrust, revConfirmed) : na
float revBase  = na(revConv) ? na : revConv * (enableRanker ? f_rankMult(3, f_confAgree(revDirN)) : 1.0) * f_regimeMult(3)
float revConvR = na(revBase) ? na : math.round(math.min(revBase, 10.0), 1)

// ── Drawing (last bar only) ──
var line          revNeckLn = na
var label         revLbl    = na
var array<label>  revMarks  = array.new<label>()

if barstate.islast
    line.delete(revNeckLn)
    revNeckLn := na
    label.delete(revLbl)
    revLbl := na
    for lb in revMarks
        label.delete(lb)
    revMarks.clear()

    if enableRev and revName != "" and (not revNeedBreak or revConfirmed)
        int   revX2e   = math.min(bar_index + revExtendBars, bar_index + 490)
        float revSlope = not na(revNX1) and not na(revNX2) and not na(revNV1) and not na(revNV2) and revNX2 != revNX1 ? (revNV2 - revNV1) / (revNX2 - revNX1) : 0.0
        float revY2e   = not na(revNV2) ? revNV2 + revSlope * (revX2e - revNX2) : na

        if revShowNeck and not na(revNV1) and not na(revNV2)
            revNeckLn := line.new(
                 revNX1, revNV1,
                 revX2e, revY2e,
                 xloc  = xloc.bar_index,
                 color = revCol,
                 width = 1,
                 style = line.style_dashed)

        string ricon  = revName == "Double Top" ? "DT" : revName == "Double Bottom" ? "DB" : revName == "Head & Shoulders" ? "H&S" : "iH&S"
        string rarrow = revBias == "Bearish" ? "▼" : "▲"
        float  ry     = revBias == "Bearish" ? high + nz(atrVal, 0.0) * 0.45 : low - nz(atrVal, 0.0) * 0.45

        revLbl := label.new(
             revX2e, ry,
             rarrow + ricon + (not na(revConvR) ? " ⚡" + str.tostring(revConvR, "#.#") : ""),
             xloc      = xloc.bar_index,
             style     = label.style_none,
             textcolor = revCol,
             size      = revLblSize,
             tooltip   = revName + " · " + revBias + (revConfirmed ? " · confirmed ✓" : " · forming ?") + " · neckline " + str.tostring(revNeckNow, format.mintick) + (not na(revConv) ? "\n⚡ Conviction: " + str.tostring(revConv, "#.#") + (enableRanker ? " → ranked " + str.tostring(revConvR, "#.#") + " (learned edge)" : "") : ""))

        if revShowMarks
            int mN = array.size(revMX)
            if mN > 0
                for i = 0 to mN - 1
                    array.push(revMarks, label.new(array.get(revMX, i), array.get(revMY, i), "",
                         style = label.style_circle, color = revCol, size = size.tiny))

// ════════════════════════════════════════════════════════════════════════════
// ADAPTIVE LEARNING ENGINE  (per-timeframe outcome tracking + MTF-confluence split)
// ════════════════════════════════════════════════════════════════════════════
// Every setup (channel break / flag break / reversal) is registered with an ATR-normalized
// target & stop and tagged with MTF confluence at entry. Each bar, open setups resolve
// (target = win, stop = loss, else timeout) and fold into per-pattern stats for THIS timeframe.
// Duration is logged in bars and shown as time; wins are split by confluence so the panel
// reveals whether multi-timeframe alignment actually improves outcomes — the seed of the ranker.
// (State arrays + ranker functions are declared earlier so the ranker can feed the Strength score.)

f_registerSetup(int kind, int dir) =>
    if enableLearn and dir != 0 and not na(atrVal) and atrVal > 0.0
        float tgt = close + dir * learnTargetR * atrVal
        float inv = close - dir * learnStopR  * atrVal
        array.push(openSetups, Setup.new(bar_index, kind, dir, tgt, inv, f_confAgree(dir)))

if enableLearn
    if freshUp
        f_registerSetup(1, 1)
    if freshDn
        f_registerSetup(1, -1)
    if flBreakEvt
        f_registerSetup(2, flDir)
    if revFresh
        f_registerSetup(3, revBias == "Bearish" ? -1 : 1)

if enableLearn and array.size(openSetups) > 0
    for idx = array.size(openSetups) - 1 to 0
        Setup s = array.get(openSetups, idx)
        int  age    = bar_index - s.bar0
        bool hitTgt = s.dir > 0 ? high >= s.target  : low  <= s.target
        bool hitInv = s.dir > 0 ? low  <= s.invalid : high >= s.invalid
        int  res    = hitInv ? 2 : hitTgt ? 1 : age >= learnMaxBars ? 3 : 0
        if res != 0
            int k = s.kind
            if res == 1
                array.set(sWin, k, array.get(sWin, k) + 1)
                array.set(sDur, k, array.get(sDur, k) + age)
            else if res == 2
                array.set(sLoss, k, array.get(sLoss, k) + 1)
            else
                array.set(sTo, k, array.get(sTo, k) + 1)
            if s.conf >= learnConfHi
                array.set(sHiTot, k, array.get(sHiTot, k) + 1)
                if res == 1
                    array.set(sHiWin, k, array.get(sHiWin, k) + 1)
            array.remove(openSetups, idx)

f_winPct(int w, int l) => (w + l) > 0 ? str.tostring(math.round(w * 100.0 / (w + l))) + "%" : "—"
f_lenTxt(int durSum, int wins) =>
    string out = "—"
    if wins > 0
        float ab   = durSum / wins
        float secs = ab * timeframe.in_seconds(timeframe.period)
        string tt  = secs >= 86400 ? str.tostring(math.round(secs / 8640.0) / 10.0) + "d" : secs >= 3600 ? str.tostring(math.round(secs / 360.0) / 10.0) + "h" : str.tostring(math.round(secs / 60.0)) + "m"
        out := str.tostring(math.round(ab * 10.0) / 10.0) + "b·" + tt
    out

var table lrn = na
if barstate.islast and enableLearn and learnShowTbl
    if not na(lrn)
        table.delete(lrn)
    lrn := table.new(f_dashPos(learnTblPos), 6, 5, bgcolor=color.rgb(15, 15, 22, 5), border_color=color.rgb(60, 60, 80), border_width=1, frame_color=color.rgb(80, 80, 110), frame_width=1)
    color hb = color.rgb(25, 25, 38)
    color tc = color.rgb(180, 180, 200)
    table.cell(lrn, 0, 0, "LEARN " + timeframe.period, text_color=color.white, text_size=size.tiny, bgcolor=hb, text_halign=text.align_left)
    table.cell(lrn, 1, 0, "Win",    text_color=tc, text_size=size.tiny, bgcolor=hb)
    table.cell(lrn, 2, 0, "W-L-T",  text_color=tc, text_size=size.tiny, bgcolor=hb)
    table.cell(lrn, 3, 0, "AvgLen", text_color=tc, text_size=size.tiny, bgcolor=hb)
    table.cell(lrn, 4, 0, "Conf" + str.tostring(confNow) + "/3", text_color=confNow >= learnConfHi ? color.rgb(0, 230, 118) : tc, text_size=size.tiny, bgcolor=hb)
    table.cell(lrn, 5, 0, enableRanker ? "Edge×" : "Edge", text_color=enableRanker ? color.white : color.gray, text_size=size.tiny, bgcolor=hb)
    for k = 1 to 3
        string nm = k == 1 ? "Channel" : k == 2 ? "Flag" : "Reversal"
        int w = array.get(sWin, k)
        int l = array.get(sLoss, k)
        int t = array.get(sTo, k)
        color cellBg = color.rgb(20, 20, 30, 10)
        table.cell(lrn, 0, k, nm, text_color=tc, text_size=size.tiny, bgcolor=cellBg, text_halign=text.align_left)
        table.cell(lrn, 1, k, f_winPct(w, l), text_color=(w + l) > 0 and w * 100.0 / (w + l) >= 50 ? color.rgb(0, 230, 118) : color.rgb(255, 120, 120), text_size=size.tiny, bgcolor=cellBg)
        table.cell(lrn, 2, k, str.tostring(w) + "-" + str.tostring(l) + "-" + str.tostring(t), text_color=tc, text_size=size.tiny, bgcolor=cellBg)
        table.cell(lrn, 3, k, f_lenTxt(array.get(sDur, k), w), text_color=tc, text_size=size.tiny, bgcolor=cellBg)
        table.cell(lrn, 4, k, f_winPct(array.get(sHiWin, k), array.get(sHiTot, k) - array.get(sHiWin, k)), text_color=color.rgb(144, 191, 249), text_size=size.tiny, bgcolor=cellBg)
        float mv = f_rankMult(k, confNow)
        table.cell(lrn, 5, k, enableRanker ? "×" + str.tostring(math.round(mv * 100) / 100) : "—", text_color=not enableRanker ? color.gray : mv >= 1.05 ? color.rgb(0, 230, 118) : mv <= 0.95 ? color.rgb(255, 120, 120) : tc, text_size=size.tiny, bgcolor=cellBg)
    int owW = array.get(sWin, 1) + array.get(sWin, 2) + array.get(sWin, 3)
    int owL = array.get(sLoss, 1) + array.get(sLoss, 2) + array.get(sLoss, 3)
    int owT = array.get(sTo, 1) + array.get(sTo, 2) + array.get(sTo, 3)
    int owD = array.get(sDur, 1) + array.get(sDur, 2) + array.get(sDur, 3)
    int ohW = array.get(sHiWin, 1) + array.get(sHiWin, 2) + array.get(sHiWin, 3)
    int ohT = array.get(sHiTot, 1) + array.get(sHiTot, 2) + array.get(sHiTot, 3)
    color obg = color.rgb(30, 30, 45)
    table.cell(lrn, 0, 4, "ALL", text_color=color.white, text_size=size.tiny, bgcolor=obg, text_halign=text.align_left)
    table.cell(lrn, 1, 4, f_winPct(owW, owL), text_color=color.white, text_size=size.tiny, bgcolor=obg)
    table.cell(lrn, 2, 4, str.tostring(owW) + "-" + str.tostring(owL) + "-" + str.tostring(owT), text_color=tc, text_size=size.tiny, bgcolor=obg)
    table.cell(lrn, 3, 4, f_lenTxt(owD, owW), text_color=tc, text_size=size.tiny, bgcolor=obg)
    table.cell(lrn, 4, 4, f_winPct(ohW, ohT - ohW), text_color=color.rgb(144, 191, 249), text_size=size.tiny, bgcolor=obg)
    table.cell(lrn, 5, 4, "—", text_color=tc, text_size=size.tiny, bgcolor=obg)

// ════════════════════════════════════════════════════════════════════════════
// ALERTS
// ════════════════════════════════════════════════════════════════════════════
bool newPat = showPattern and (not showPattern[1] or patShort != patShort[1])
if enableAlerts and alertPattern and newPat
    alert("BK Pattern: " + patName + " [" + patBias + "] | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if enableAlerts and freshUp and alertBrkUp
    alert("BK Core — Channel Breakout UP | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if enableAlerts and freshDn and alertBrkDn
    alert("BK Core — Channel Breakout DOWN | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if enableAlerts and alertReversal and revFresh
    alert("BK Reversal: " + revName + " [" + revBias + "] | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if enableAlerts and alertVwapReclaim and (vwapTrapBear or vwapTrapBull)
    alert("BK VWAP Trap (failed break) | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if enableAlerts and enableLifecycle and alertRetest and pbRetestEvt
    alert("BK Break Retest " + (pbDir > 0 ? "↑" : "↓") + " | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if enableAlerts and enableLifecycle and alertConfirm and pbConfirmEvt
    alert("BK Break Confirmed " + (pbDir > 0 ? "↑" : "↓") + " | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if enableAlerts and enableLifecycle and alertTrap and pbTrapEvt
    alert("BK Break TRAP (failed) " + (pbDir > 0 ? "↑→fail" : "↓→fail") + " | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if enableAlerts and enableFlags and alertFlag and flBreakEvt
    alert("BK " + (flPennant ? "Pennant " : "Flag ") + (flDir > 0 ? "Break ▲" : "Break ▼") + " | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ════════════════════════════════════════════════════════════════════════════
// VOLUME FOOTPRINT  (native request.footprint — real per-bar order flow)
// ════════════════════════════════════════════════════════════════════════════
// True intrabar order flow via Pine v6's native request.footprint(): real Point of
// Control and volume delta per bar — no lower-timeframe approximation. Self-contained
// and na-safe: requires a Premium/Ultimate plan AND a volume-bearing symbol with tick
// data (NOT an INDEX). On any instrument without real volume the request returns na and
// this module simply shows nothing — it never affects the rest of the engine.
grpFoot      = "Volume Footprint"
enableFoot   = input.bool(true, "Volume Footprint (POC + Delta)", group=grpFoot, tooltip="Native request.footprint() order flow: per-bar Point of Control, volume delta, and a POC-migration read. OFF by default because the intrabar data pull is CPU-heavy — enable it deliberately. Premium/Ultimate plan and a tick-volume symbol required (NOT an INDEX); otherwise it shows n/a.")
footTicks    = input.int(9, "Ticks per Row", minval=1, maxval=10000, group=grpFoot, inline="ft", tooltip="Price height of each footprint row, in instrument ticks. Smaller = finer POC resolution.")
footVA       = input.int(70, "Value Area %", minval=30, maxval=95, group=grpFoot, inline="ft")
footShowPOC  = input.bool(false, "Plot Per-Bar POC Dots", group=grpFoot, inline="fp1", tooltip="The raw per-bar Point of Control as scattered dots. Off by default — the structure POC line below is usually the cleaner read.")
footPocColor = input.color(color.rgb(255, 200, 80), "", group=grpFoot, inline="fp1")
footShowSlope = input.bool(true, "POC Line Along Structure", group=grpFoot, inline="fps", tooltip="Aggregates footprint volume across the active POC Last N Bars window, finds the single most-traded price lane, and draws it as a line parallel to the structure's slope — where volume control sits INSIDE the active auction. Built only from bars that have footprint data.")
footSlopeColor = input.color(color.rgb(255, 170, 40), "", group=grpFoot, inline="fps")
footSlopeTransp = input.int(0, "Tr", minval=0, maxval=100, group=grpFoot, inline="fps")
footSlopeWidth = input.int(2, "W", minval=1, maxval=8, group=grpFoot, inline="fps2", tooltip="Line width (px) of the structure POC line.")
footSlopeStyle = input.string("Solid", "Style", ["Solid", "Dashed", "Dotted"], group=grpFoot, inline="fps2")
footShowHoriz = input.bool(true, "Horizontal Current POC", group=grpFoot, inline="fph", tooltip="ON = draw a horizontal current structure POC. Independent from Sloped POC.")
footHorizColor = input.color(color.rgb(255, 170, 40), "", group=grpFoot, inline="fph")
footHorizTransp = input.int(0, "Tr", minval=0, maxval=100, group=grpFoot, inline="fph")
footHorizWidth = input.int(2, "W", minval=1, maxval=8, group=grpFoot, inline="fph2")
footHorizStyle = input.string("Dotted", "Style", ["Solid", "Dashed", "Dotted"], group=grpFoot, inline="fph2")
footHorizLastN = input.int(11, "Horizontal Last N Bars", minval=0, maxval=200, group=grpFoot, inline="fph3", tooltip="Active auction window for Horizontal POC. Also controls historical render length. Set 0 to draw only from current bar.")
footHorizExtend = input.int(7, "Extend N Bars", minval=0, maxval=100, group=grpFoot, inline="fph3", tooltip="Forward extension for the Horizontal POC. Drawing/projection only.")

footShowOpp = input.bool(true, "Opposite-Slope POC", group=grpFoot, inline="fpo", tooltip="ON = draw a counter-slope POC line through the current structure POC. It mirrors the active structure slope in the opposite direction. Independent from Sloped POC.")
footOppColor = input.color(color.rgb(41, 98, 255), "", group=grpFoot, inline="fpo")
footOppTransp = input.int(0, "Tr", minval=0, maxval=100, group=grpFoot, inline="fpo")
footOppWidth = input.int(2, "W", minval=1, maxval=8, group=grpFoot, inline="fpo2")
footOppStyle = input.string("Solid", "Style", ["Solid", "Dashed", "Dotted"], group=grpFoot, inline="fpo2")
footOppLastN = input.int(11, "Opposite Last N Bars", minval=0, maxval=200, group=grpFoot, inline="fpo3", tooltip="Active auction window for Opposite-Slope POC. Also controls historical render length. Set 0 to draw only from current bar.")
footOppExtend = input.int(7, "Extend N Bars", minval=0, maxval=100, group=grpFoot, inline="fpo3", tooltip="Forward extension for the Opposite-Slope POC. Drawing/projection only.")

footPocBins  = input.int(21, "Structure POC Bins", minval=10, maxval=200, group=grpFoot, tooltip="Resolution of the volume profile used to locate the structure POC lane. Higher = finer price resolution.")
footStructVA = input.bool(true, "VA Band Along Structure (sloped)", group=grpFoot, inline="fsv", tooltip="Value-area band tied to the SLOPING structure POC: VAH/VAL drawn as two lines parallel to the structure-POC lane with a shaded band between, expanded outward from the modal volume lane to the Value Area %. The structural read — same treatment as the structure POC. The per-bar VA below is the raw per-bar envelope.")
footVaColor  = input.color(color.rgb(150, 120, 230), "", group=grpFoot, inline="fsv")
footVaLineT  = input.int(25, "Line Transp", minval=0, maxval=100, group=grpFoot, inline="fsv2", tooltip="Transparency of the VAH / VAL rails (structure band and per-bar VA). 0 = opaque, 100 = invisible.")
footVaFillT  = input.int(92, "Fill Transp", minval=0, maxval=100, group=grpFoot, inline="fsv2", tooltip="Transparency of the shaded value-area fill between VAH and VAL (structure band and per-bar VA). 0 = opaque, 100 = invisible.")
footLastN    = input.int(11, "POC Last N Bars", minval=3, maxval=200, group=grpFoot, tooltip="Active auction window for the sloped structure POC + VA band. This controls BOTH the real POC/VA calculation window and the historical render length, so the POC stays tied to current action instead of the entire older channel.")
footExtend   = input.int(5, "POC Extend N Bars", minval=0, maxval=100, group=grpFoot, tooltip="Forward extension for the sloped structure POC + VA band only. Drawing/projection only; these bars are NOT included in the POC calculation.")
footShowVA   = input.bool(false, "Per-Bar VA (raw)", group=grpFoot, inline="fp2", tooltip="Raw per-bar Value Area High/Low as stepped segments with a shaded envelope. OFF by default — the sloped structure band above is the cleaner structural read; enable this only for the literal per-bar VA.")
footMigLen   = input.int(10, "POC Migration Lookback", minval=2, maxval=100, group=grpFoot, tooltip="Bars over which a rising / falling POC staircase (trend confirmation) is measured.")

footprint fpRaw = na
if enableFoot
    fpRaw := request.footprint(footTicks, footVA)
bool  fpOK    = enableFoot and not na(fpRaw)
float fpDelta = na
float fpDpct  = na
float fpPoc   = na
float fpVah   = na
float fpVal   = na
float fpVol   = na
if fpOK
    fpDelta := fpRaw.delta()
    float tv = fpRaw.total_volume()
    fpVol   := tv
    fpDpct  := not na(tv) and tv > 0.0 ? fpDelta / tv * 100.0 : na
    volume_row pr = fpRaw.poc()
    if not na(pr)
        fpPoc := (pr.up_price() + pr.down_price()) / 2.0
    volume_row vh = fpRaw.vah()              // Value Area High row → read its upper boundary
    if not na(vh)
        fpVah := vh.up_price()
    volume_row vl = fpRaw.val()              // Value Area Low row → read its lower boundary
    if not na(vl)
        fpVal := vl.down_price()

// Rolling per-bar footprint store — feeds the structure-POC aggregation on the last bar.
int fpMaxStore = 600
var array<int>   fpBarArr = array.new<int>()
var array<float> fpPocArr = array.new<float>()
var array<float> fpVolArr = array.new<float>()
if fpOK and not na(fpPoc) and not na(fpVol) and fpVol > 0.0
    array.push(fpBarArr, bar_index)
    array.push(fpPocArr, fpPoc)
    array.push(fpVolArr, fpVol)
    if array.size(fpBarArr) > fpMaxStore
        array.shift(fpBarArr)
        array.shift(fpPocArr)
        array.shift(fpVolArr)

bool   fpPocRising  = not na(fpPoc) and not na(fpPoc[footMigLen]) and fpPoc > fpPoc[footMigLen]
bool   fpPocFalling = not na(fpPoc) and not na(fpPoc[footMigLen]) and fpPoc < fpPoc[footMigLen]
string fpPocTxt     = fpPocRising ? "POC↑" : fpPocFalling ? "POC↓" : "POC→"

plot(footShowPOC and fpOK ? fpPoc : na, "Bar POC", color=footPocColor, style=plot.style_circles, linewidth=1)
pVah = plot(footShowVA and fpOK ? fpVah : na, "Value Area High", color=color.new(footVaColor, footVaLineT), style=plot.style_linebr, linewidth=1)
pVal = plot(footShowVA and fpOK ? fpVal : na, "Value Area Low",  color=color.new(footVaColor, footVaLineT), style=plot.style_linebr, linewidth=1)
fill(pVah, pVal, color=color.new(footVaColor, footVaFillT), title="Value Area")

f_modalPocPrice(array<int> _bars, array<float> _pocs, array<float> _vols, int _calcStart, int _calcEnd, int _binCount) =>
    float _out = na
    int   _n   = array.size(_bars)
    float _pMin = na
    float _pMax = na
    int   _inWin = 0
    for _i = 0 to _n - 1
        int _b = array.get(_bars, _i)
        if _b >= _calcStart and _b <= _calcEnd
            float _p = array.get(_pocs, _i)
            if not na(_p)
                _pMin := na(_pMin) ? _p : math.min(_pMin, _p)
                _pMax := na(_pMax) ? _p : math.max(_pMax, _p)
                _inWin += 1
    if _inWin > 0 and not na(_pMin)
        if na(_pMax) or _pMax <= _pMin
            _out := _pMin
        else
            int   _BINS = math.max(1, _binCount)
            float _span = _pMax - _pMin
            array<float> _bins = array.new<float>(_BINS, 0.0)
            for _i = 0 to _n - 1
                int _b = array.get(_bars, _i)
                if _b >= _calcStart and _b <= _calcEnd
                    float _p = array.get(_pocs, _i)
                    if not na(_p)
                        int _bi = math.min(_BINS - 1, math.max(0, int((_p - _pMin) / _span * (_BINS - 1))))
                        array.set(_bins, _bi, array.get(_bins, _bi) + array.get(_vols, _i))
            int   _maxBi = 0
            float _maxV  = 0.0
            for _bi = 0 to _BINS - 1
                float _v = array.get(_bins, _bi)
                if _v > _maxV
                    _maxV  := _v
                    _maxBi := _bi
            _out := _pMin + (_maxBi + 0.5) / _BINS * _span
    _out

// ── Structure POC: the dominant-volume price lane drawn along the channel/wedge slope ──
// On the last bar, aggregate only the recent active-auction window controlled by POC Last N Bars,
// measured as an offset from the channel midline and weighted by real footprint volume.
// This keeps the POC attached to current action instead of letting an old channel-wide auction
// drag the modal lane far away from the live battlefield.
var line     lnSlopePoc  = na
var line     lnHorizPoc  = na
var line     lnOppPoc    = na
var line     lnStructVaH = na
var line     lnStructVaL = na
var linefill llStructVa  = na
if barstate.islast
    // VA band rails are delete+recreate each last bar (a linefill can't be re-pointed).
    line.delete(lnStructVaH)
    line.delete(lnStructVaL)
    linefill.delete(llStructVa)
    lnStructVaH := na
    lnStructVaL := na
    llStructVa  := na
    bool slopeOK = footShowSlope and enableFoot and enableChannel and not na(upY1) and not na(upY2) and not na(loY1) and not na(loY2) and array.size(fpBarArr) > 3
    if slopeOK
        float my1    = (upY1 + loY1) / 2.0
        float my2    = (upY2 + loY2) / 2.0
        float mslope = (my2 - my1) / math.max(chX2 - chX1, 1)
        int   nStore = array.size(fpBarArr)
        int   calcStart = math.max(chX1, chX2 - footLastN + 1)
        int   calcEnd   = chX2
        // Pass 1 — residual range of ACTIVE-WINDOW POCs vs the midline.
        float rMin = na
        float rMax = na
        int   inWin = 0
        for i = 0 to nStore - 1
            int b = array.get(fpBarArr, i)
            if b >= calcStart and b <= calcEnd
                float mid = my1 + mslope * (b - chX1)
                float res = array.get(fpPocArr, i) - mid
                rMin := na(rMin) ? res : math.min(rMin, res)
                rMax := na(rMax) ? res : math.max(rMax, res)
                inWin += 1
        if inWin > 3 and not na(rMin) and rMax > rMin
            int   BINS = footPocBins
            float span = rMax - rMin
            array<float> bins = array.new<float>(BINS, 0.0)
            float totV = 0.0
            // Pass 2 — bin ACTIVE-WINDOW POC offsets weighted by volume.
            for i = 0 to nStore - 1
                int b = array.get(fpBarArr, i)
                if b >= calcStart and b <= calcEnd
                    float mid = my1 + mslope * (b - chX1)
                    float res = array.get(fpPocArr, i) - mid
                    int   bi  = math.min(BINS - 1, math.max(0, int((res - rMin) / span * (BINS - 1))))
                    array.set(bins, bi, array.get(bins, bi) + array.get(fpVolArr, i))
                    totV += array.get(fpVolArr, i)
            // Modal (max-volume) bin → POC lane offset.
            int   maxBi = 0
            float maxV  = 0.0
            for bi = 0 to BINS - 1
                float v = array.get(bins, bi)
                if v > maxV
                    maxV  := v
                    maxBi := bi
            float pocOff = rMin + (maxBi + 0.5) / BINS * span
            // Value-area expansion: grow outward from the modal bin until footVA% of volume is enclosed.
            float vaTarget = totV * footVA / 100.0
            float acc      = array.get(bins, maxBi)
            int   loBi     = maxBi
            int   hiBi     = maxBi
            for step = 0 to BINS
                if acc >= vaTarget
                    break
                float belowV = loBi > 0 ? array.get(bins, loBi - 1) : -1.0
                float aboveV = hiBi < BINS - 1 ? array.get(bins, hiBi + 1) : -1.0
                if belowV < 0.0 and aboveV < 0.0
                    break
                if aboveV >= belowV
                    hiBi += 1
                    acc  += aboveV
                else
                    loBi -= 1
                    acc  += belowV
            float vaHiOff = rMin + (hiBi + 1.0) / BINS * span
            float vaLoOff = rMin + (loBi + 0.0) / BINS * span
            int   x2e       = chX2 + footExtend
            int   drawStart = calcStart
            float midD      = my1 + mslope * (drawStart - chX1)  // midline price at the active-window left edge
            // Structure POC line (persist + re-point).
            float y1  = midD + pocOff
            float y2  = (my1 + mslope * (x2e - chX1)) + pocOff
            if na(lnSlopePoc)
                lnSlopePoc := line.new(drawStart, y1, x2e, y2, xloc=xloc.bar_index, color=color.new(footSlopeColor, footSlopeTransp), width=footSlopeWidth, style=f_lineStyle(footSlopeStyle))
            else
                line.set_xy1(lnSlopePoc, drawStart, y1)
                line.set_xy2(lnSlopePoc, x2e, y2)
            line.set_color(lnSlopePoc, color.new(footSlopeColor, footSlopeTransp))
            line.set_width(lnSlopePoc, footSlopeWidth)
            line.set_style(lnSlopePoc, f_lineStyle(footSlopeStyle))
            // VA band tied to the sloping POC — two parallel rails + shaded fill.
            if footStructVA
                float yH1 = midD + vaHiOff
                float yH2 = (my1 + mslope * (x2e - chX1)) + vaHiOff
                float yL1 = midD + vaLoOff
                float yL2 = (my1 + mslope * (x2e - chX1)) + vaLoOff
                lnStructVaH := line.new(drawStart, yH1, x2e, yH2, xloc=xloc.bar_index, color=color.new(footVaColor, footVaLineT), width=1, style=line.style_dashed)
                lnStructVaL := line.new(drawStart, yL1, x2e, yL2, xloc=xloc.bar_index, color=color.new(footVaColor, footVaLineT), width=1, style=line.style_dashed)
                llStructVa  := linefill.new(lnStructVaH, lnStructVaL, color.new(footVaColor, footVaFillT))
    else if not na(lnSlopePoc)
        line.delete(lnSlopePoc)
        lnSlopePoc := na

    // Horizontal Current POC — independent toggle, own window/style/extension.
    bool horizOK = footShowHoriz and enableFoot and array.size(fpBarArr) > 0
    if horizOK
        int   hCalcEnd   = chX2
        int   hCalcStart = footHorizLastN <= 0 ? hCalcEnd : math.max(chX1, hCalcEnd - footHorizLastN + 1)
        int   hDrawStart = footHorizLastN <= 0 ? hCalcEnd : hCalcStart
        int   hX2e       = hCalcEnd + footHorizExtend
        float hPoc       = f_modalPocPrice(fpBarArr, fpPocArr, fpVolArr, hCalcStart, hCalcEnd, footPocBins)
        if not na(hPoc)
            if na(lnHorizPoc)
                lnHorizPoc := line.new(hDrawStart, hPoc, hX2e, hPoc, xloc=xloc.bar_index, color=color.new(footHorizColor, footHorizTransp), width=footHorizWidth, style=f_lineStyle(footHorizStyle))
            else
                line.set_xy1(lnHorizPoc, hDrawStart, hPoc)
                line.set_xy2(lnHorizPoc, hX2e, hPoc)
            line.set_color(lnHorizPoc, color.new(footHorizColor, footHorizTransp))
            line.set_width(lnHorizPoc, footHorizWidth)
            line.set_style(lnHorizPoc, f_lineStyle(footHorizStyle))
        else if not na(lnHorizPoc)
            line.delete(lnHorizPoc)
            lnHorizPoc := na
    else if not na(lnHorizPoc)
        line.delete(lnHorizPoc)
        lnHorizPoc := na

    // Opposite-Slope POC — independent toggle, own window/style/extension.
    bool oppOK = footShowOpp and enableFoot and enableChannel and not na(upY1) and not na(upY2) and not na(loY1) and not na(loY2) and array.size(fpBarArr) > 0
    if oppOK
        float oMy1       = (upY1 + loY1) / 2.0
        float oMy2       = (upY2 + loY2) / 2.0
        float oMidSlope  = (oMy2 - oMy1) / math.max(chX2 - chX1, 1)
        float oOppSlope  = -oMidSlope
        int   oCalcEnd   = chX2
        int   oCalcStart = footOppLastN <= 0 ? oCalcEnd : math.max(chX1, oCalcEnd - footOppLastN + 1)
        int   oDrawStart = footOppLastN <= 0 ? oCalcEnd : oCalcStart
        int   oX2e       = oCalcEnd + footOppExtend
        float oPoc       = f_modalPocPrice(fpBarArr, fpPocArr, fpVolArr, oCalcStart, oCalcEnd, footPocBins)
        if not na(oPoc)
            float oY1 = oPoc + oOppSlope * (oDrawStart - chX2)
            float oY2 = oPoc + oOppSlope * (oX2e - chX2)
            if na(lnOppPoc)
                lnOppPoc := line.new(oDrawStart, oY1, oX2e, oY2, xloc=xloc.bar_index, color=color.new(footOppColor, footOppTransp), width=footOppWidth, style=f_lineStyle(footOppStyle))
            else
                line.set_xy1(lnOppPoc, oDrawStart, oY1)
                line.set_xy2(lnOppPoc, oX2e, oY2)
            line.set_color(lnOppPoc, color.new(footOppColor, footOppTransp))
            line.set_width(lnOppPoc, footOppWidth)
            line.set_style(lnOppPoc, f_lineStyle(footOppStyle))
        else if not na(lnOppPoc)
            line.delete(lnOppPoc)
            lnOppPoc := na
    else if not na(lnOppPoc)
        line.delete(lnOppPoc)
        lnOppPoc := na

// ════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ════════════════════════════════════════════════════════════════════════════
var table dash = na
if barstate.islast and showDash
    if not na(dash)
        table.delete(dash)
    dash := table.new(f_dashPos(dashPosition), 2, 17, bgcolor=color.rgb(15, 15, 22, 5), border_color=color.rgb(60, 60, 80), border_width=1, frame_color=color.rgb(80, 80, 110), frame_width=1)
    color hdrBg  = color.rgb(30, 30, 45)
    color cellBg = color.rgb(18, 18, 26)
    color txtC   = color.rgb(200, 200, 215)
    color pBiasCol = patBias == "Bullish" ? biasBullColor : patBias == "Bearish" ? biasBearColor : biasNeutralColor

    table.cell(dash, 0, 0, "⚙️ BK ENGINE", text_color=color.white, text_size=dashSize, bgcolor=hdrBg, text_halign=text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color=color.white, text_size=dashSize, bgcolor=hdrBg, text_halign=text.align_right)

    table.cell(dash, 0, 1, " Pattern", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 1, showPattern ? patName : "—", text_color=showPattern ? pBiasCol : color.gray, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 2, " Bias", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 2, showPattern ? patBias : "—", text_color=showPattern ? pBiasCol : color.gray, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 3, " Strength", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 3, (enableStrength and not na(strength)) ? str.tostring(strength, "#.#") + " / 10" : "—", text_color=color.rgb(255, 235, 59), text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 4, " Fit R²", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 4, not na(fitR2) ? str.tostring(math.round(fitR2 * 100, 0)) + "%" : "—", text_color=color.rgb(140, 200, 255), text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 5, " MTF (" + actualMTF + ")", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 5, enableMTF ? (htfTrend + (mtfAligned ? " ✓" : "")) : "off", text_color=mtfAligned ? color.rgb(0, 230, 118) : color.gray, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 6, " Direction", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 6, dirTxt, text_color=dirCol, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 7, " Breakout", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 7, brkTxt, text_color=brkCol, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 8, " Upper / Lower", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 8, (not na(upY2) and not na(loY2)) ? str.tostring(upY2, format.mintick) + " / " + str.tostring(loY2, format.mintick) : "—", text_color=chUpperColor, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 9, " Pivots H/L", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 9, str.tostring(array.size(pivHighIdx)) + " / " + str.tostring(array.size(pivLowIdx)), text_color=color.rgb(140, 180, 255), text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 10, " Lifecycle", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 10, enableLifecycle ? pbTxt : "off", text_color=pbCol, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 11, " Flag / Pennant", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 11, enableFlags ? flTxt : "off", text_color=flTxtCol, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 12, " Regime", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 12, enableRegime ? regimeTxt : "off", text_color=regimeTrend ? color.rgb(0, 230, 118) : color.rgb(255, 200, 80), text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 13, " Footprint Δ", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 13, fpOK and not na(fpDpct) ? str.tostring(math.round(fpDpct)) + "% · " + fpPocTxt : "n/a", text_color=not fpOK ? color.gray : fpDelta > 0 ? color.rgb(0, 230, 118) : fpDelta < 0 ? color.rgb(255, 82, 82) : txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    table.cell(dash, 0, 14, " Value Area H/L", text_color=txtC, text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 14, fpOK and not na(fpVah) and not na(fpVal) ? str.tostring(fpVah, format.mintick) + " / " + str.tostring(fpVal, format.mintick) : "n/a", text_color=not fpOK ? color.gray : color.rgb(150, 120, 230), text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

    // ── TEMP AVWAP DIAGNOSTIC (remove after fix) ──
    // Row 15: the rail-origin chain as bar offsets from current bar (so smaller number = more recent).
    //   sideNow · loOrigin(offset) · hiOrigin(offset) · anchorUsed(offset)
    string dbgSide = activeSide == 1 ? "DN(1)" : activeSide == -1 ? "UP(-1)" : "0"
    string dbgLo   = na(chStartLo) ? "loRAW=na" : "loRAW=" + str.tostring(bar_index - chStartLo)
    string dbgLoLk = na(lkX1Lo)   ? "loLK=na"  : "loLK="  + str.tostring(bar_index - lkX1Lo)
    string dbgAnc  = na(win) ? "anc=na" : "anc=" + str.tostring(bar_index - win.anchor)
    table.cell(dash, 0, 15, " AVWAP dbg1", text_color=color.rgb(255,170,40), text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 15, dbgSide + " " + dbgLo + " " + dbgLoLk + " " + dbgAnc, text_color=color.rgb(255,170,40), text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)
    // Row 16: which candidate is on screen + its side, and the hi-origin chain.
    string dbgWin  = vwLastWin == 1 ? "WIN=A(rail)" : vwLastWin == 2 ? "WIN=B(swing)" : "WIN=none"
    string dbgHi   = na(chStartHi) ? "hiRAW=na" : "hiRAW=" + str.tostring(bar_index - chStartHi)
    string dbgHiLk = na(lkX1Hi)   ? "hiLK=na"  : "hiLK="  + str.tostring(bar_index - lkX1Hi)
    table.cell(dash, 0, 16, " AVWAP dbg2", text_color=color.rgb(255,170,40), text_size=dashSize, bgcolor=cellBg, text_halign=text.align_left)
    table.cell(dash, 1, 16, dbgWin + " " + dbgHi + " " + dbgHiLk, text_color=color.rgb(255,170,40), text_size=dashSize, bgcolor=cellBg, text_halign=text.align_right)

