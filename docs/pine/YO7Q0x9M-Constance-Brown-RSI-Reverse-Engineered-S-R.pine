//@version=6
indicator("Constance Brown - RSI Reverse Engineered S/R", overlay=true, max_labels_count=500)

// =====================================================================
// Constance Brown's method (Technical Analysis for Trading Professionals)
// -----------------------------------------------------------------------
// Reverse-engineers Wilder's RSI: instead of RSI = f(price), we solve
// price = f^-1(RSI) for a target RSI level (e.g. 70 = resistance,
// 30 = support). Brown did this in Excel with Goal Seek; since RSI is
// a strictly monotonic function of the hypothetical closing price
// (given fixed prior AvgGain/AvgLoss), a binary search converges to it
// in a handful of iterations - no Goal Seek needed.
// =====================================================================

// === Inputs ===
grpCalc     = "RSI Reverse-Engineering"
rsiLen      = input.int(14, "RSI Length", minval=2, group=grpCalc)
iterations  = input.int(60, "Binary Search Iterations", minval=20, maxval=100, group=grpCalc,
             tooltip="Each iteration halves the search interval. 60 is far more than needed for tick-level precision; lower to speed up.")
rangeMult   = input.float(3.0, "Search Half-Range (x ATR14)", minval=0.5, group=grpCalc,
             tooltip="Binary search bracket = prevClose \u00B1 (rangeMult x 3 x ATR14). Must be wide enough to contain the true root - widen if table shows an implausible flat value pinned near the edge of the range.")

grpLevels   = "RSI Levels"
showRSI90   = input.bool(false, "Show RSI 90", group=grpLevels)
showRSI80   = input.bool(false, "Show RSI 80", group=grpLevels)
showRSI70   = input.bool(true,  "Show RSI 70", group=grpLevels)
showRSI60   = input.bool(false, "Show RSI 60", group=grpLevels)
showRSI50   = input.bool(true,  "Show RSI 50 (Midline)", group=grpLevels)
showRSI40   = input.bool(false, "Show RSI 40", group=grpLevels)
showRSI30   = input.bool(true,  "Show RSI 30", group=grpLevels)
showRSI20   = input.bool(false, "Show RSI 20", group=grpLevels)
showRSI10   = input.bool(false, "Show RSI 10", group=grpLevels)

grpDisp     = "Display"
optimizeDark = input.bool(true, "Optimise for dark background", group=grpDisp,
             tooltip="Leave checked for dark chart backgrounds. Uncheck for a light background - table and label text switches to navy blue for readability. Line and fill colors are unaffected either way.")
showTable   = input.bool(true, "Show Table", group=grpDisp)
tablePosStr = input.string("Bottom Left", "Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=grpDisp)
tblLayout   = input.string("Vertical", "Table Layout", options=["Vertical", "Horizontal"], group=grpDisp,
             tooltip="Vertical: RSI levels stacked in 2 columns (label + price).\nHorizontal: one column per enabled RSI level, label row on top and price row below.")
blankTopRows = input.int(0, "Blank Spacer Rows (top)", minval=0, maxval=8, group=grpDisp,
             tooltip="Adds empty rows above the table header. Useful for Top Left/Center/Right positions, where TradingView's symbol name and OHLC legend can overlap the first 2-3 rows. Try 3 as a starting point.")
blankBottomRows = input.int(0, "Blank Spacer Rows (bottom)", minval=0, maxval=8, group=grpDisp,
             tooltip="Adds empty rows below the table content. Useful for Bottom Left/Center/Right positions, or when stacking multiple table-based indicators in the same corner and you want breathing room between them.")
showLines   = input.bool(true, "Plot Price Lines on Chart", group=grpDisp)
lineExt     = input.int(20, "Line Extend (bars right)", minval=0, group=grpDisp)

// === Wilder RSI components ===
chg  = ta.change(close)
gain = math.max(chg, 0)
loss = math.max(-chg, 0)

avgGain = ta.rma(gain, rsiLen)
avgLoss = ta.rma(loss, rsiLen)

// Seed = prior bar's smoothed averages (fixed while current bar is forming)
prevAvgGain = avgGain[1]
prevAvgLoss = avgLoss[1]
prevClose   = close[1]

// === Hypothetical RSI if current bar closes at price P ===
f_rsiForPrice(P, prevG, prevL, prevC, len) =>
    g = math.max(P - prevC, 0)
    l = math.max(prevC - P, 0)
    newAvgGain = (prevG * (len - 1) + g) / len
    newAvgLoss = (prevL * (len - 1) + l) / len
    float rsiVal = na
    if newAvgGain == 0 and newAvgLoss == 0
        rsiVal := 50.0
    else if newAvgLoss == 0
        rsiVal := 100.0
    else
        rs = newAvgGain / newAvgLoss
        rsiVal := 100.0 - 100.0 / (1.0 + rs)
    rsiVal

// === Binary search: invert RSI -> Price ===
// RSI(P) is monotonically non-decreasing in P, so a simple bisection
// on [lo, hi] converges as long as f(lo) <= target <= f(hi).
f_priceForRSI(target, prevG, prevL, prevC, len, lo0, hi0, iter) =>
    float lo = lo0
    float hi = hi0
    float mid = (lo + hi) / 2
    for i = 1 to iter
        mid := (lo + hi) / 2
        rVal = f_rsiForPrice(mid, prevG, prevL, prevC, len)
        if rVal < target
            lo := mid
        else
            hi := mid
    mid

// === R/S/M prefix for a given RSI level, e.g. 70 -> "R2", 30 -> "S2", 50 -> "M" ===
f_prefix(lvl) =>
    string s = na
    if lvl == 50
        s := "M"
    else if lvl > 50
        s := "R" + str.tostring(int((lvl - 50) / 10))
    else
        s := "S" + str.tostring(int((50 - lvl) / 10))
    s

// === Search bracket, scaled to recent volatility ===
atrVal    = ta.atr(14)
lowBound  = prevClose - rangeMult * atrVal * 3
highBound = prevClose + rangeMult * atrVal * 3

// === Level ladder: 10 through 90 ===
var levelVals   = array.from(10.0, 20.0, 30.0, 40.0, 50.0, 60.0, 70.0, 80.0, 90.0)
var enabledVals = array.from(showRSI10, showRSI20, showRSI30, showRSI40, showRSI50, showRSI60, showRSI70, showRSI80, showRSI90)

// Gradient from cool (10, bottom) to hot (90, top) so the ladder reads at a glance
var colorVals = array.from(
     color.new(#00838F, 0),   // 10
     color.new(#26A69A, 0),   // 20
     color.new(#4CD964, 0),   // 30
     color.new(#4DD0E1, 0),   // 40
     color.new(#B0BEC5, 0),   // 50
     color.new(#FFE066, 0),   // 60
     color.new(#FFA94D, 0),   // 70
     color.new(#FF4D4D, 0),   // 80
     color.new(#E53935, 0))   // 90

// Text color: white on dark backgrounds, navy blue when optimised for a light background
textColor = optimizeDark ? color.white : color.new(#000080, 0)

// === Compute the reverse-engineered price for every enabled level, every bar ===
priceVals = array.new<float>(9, na)
for i = 0 to 8
    if array.get(enabledVals, i)
        lvl = array.get(levelVals, i)
        p = f_priceForRSI(lvl, prevAvgGain, prevAvgLoss, prevClose, rsiLen, lowBound, highBound, iterations)
        array.set(priceVals, i, p)

// === Plot lines + labels on the price pane ===
var line[]  lns  = array.new<line>()
var label[] lbls = array.new<label>()

if showLines and barstate.islast
    for ln in lns
        line.delete(ln)
    array.clear(lns)
    for lb in lbls
        label.delete(lb)
    array.clear(lbls)

    for i = 8 to 0
        if array.get(enabledVals, i)
            lvl = array.get(levelVals, i)
            p   = array.get(priceVals, i)
            if not na(p)
                col   = array.get(colorVals, i)
                lstyle = lvl == 50 ? line.style_dotted : line.style_dashed
                newLine = line.new(bar_index, p, bar_index + lineExt, p, color=col, width=1, style=lstyle)
                array.push(lns, newLine)
                prefix = f_prefix(lvl)
                txt = prefix + "(" + str.tostring(lvl, "#") + ")  " + str.tostring(p, format.mintick)
                newLbl = label.new(bar_index + lineExt, p, txt,
                         style=label.style_label_left, color=color.new(col, 80), textcolor=textColor, size=size.small)
                array.push(lbls, newLbl)

// === Summary table ===
f_getPosition(p) =>
    switch p
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right" => position.bottom_right
        => position.bottom_left

tPos = f_getPosition(tablePosStr)

rowCount = (showRSI10 ? 1 : 0) + (showRSI20 ? 1 : 0) + (showRSI30 ? 1 : 0) + (showRSI40 ? 1 : 0) +
     (showRSI50 ? 1 : 0) + (showRSI60 ? 1 : 0) + (showRSI70 ? 1 : 0) + (showRSI80 ? 1 : 0) + (showRSI90 ? 1 : 0)

// Table dimensions depend on chosen layout:
//   Vertical:   2 columns x (header row + one row per enabled level + spacer rows)
//   Horizontal: one column per enabled level x (label row + price row + spacer rows)
tblCols = tblLayout == "Vertical" ? 2 : math.max(rowCount, 1)
tblRows = tblLayout == "Vertical" ? (rowCount + 1 + blankTopRows + blankBottomRows) : (2 + blankTopRows + blankBottomRows)

var table t = showTable ? table.new(tPos, tblCols, tblRows, border_width=1) : na

if showTable and barstate.islast
    if tblLayout == "Vertical"
        if blankTopRows > 0
            for r = 0 to blankTopRows - 1
                table.cell(t, 0, r, "", bgcolor=color.new(color.black, 100))
                table.cell(t, 1, r, "", bgcolor=color.new(color.black, 100))

        headerRow = blankTopRows
        table.cell(t, 0, headerRow, "Pivots (RSI)", text_color=textColor, bgcolor=color.new(#1B2838, 0), text_size=size.small)
        table.cell(t, 1, headerRow, "Price", text_color=textColor, bgcolor=color.new(#1B2838, 0), text_size=size.small)

        row = headerRow + 1
        for i = 8 to 0
            if array.get(enabledVals, i)
                lvl = array.get(levelVals, i)
                p   = array.get(priceVals, i)
                col = array.get(colorVals, i)
                prefix = f_prefix(lvl)
                table.cell(t, 0, row, prefix + "(" + str.tostring(lvl, "#") + "):", text_color=textColor, bgcolor=color.new(col, 65), text_size=size.small)
                table.cell(t, 1, row, na(p) ? "n/a" : str.tostring(p, format.mintick), text_color=textColor, bgcolor=color.new(col, 65), text_size=size.small)
                row := row + 1

        if blankBottomRows > 0
            for r = row to row + blankBottomRows - 1
                table.cell(t, 0, r, "", bgcolor=color.new(color.black, 100))
                table.cell(t, 1, r, "", bgcolor=color.new(color.black, 100))

    else // Horizontal
        if blankTopRows > 0
            for r = 0 to blankTopRows - 1
                for c = 0 to tblCols - 1
                    table.cell(t, c, r, "", bgcolor=color.new(color.black, 100))

        labelRow = blankTopRows
        valueRow = blankTopRows + 1
        col = 0
        for i = 8 to 0
            if array.get(enabledVals, i)
                lvl = array.get(levelVals, i)
                p   = array.get(priceVals, i)
                lvlColor = array.get(colorVals, i)
                prefix = f_prefix(lvl)
                table.cell(t, col, labelRow, prefix + "(" + str.tostring(lvl, "#") + ")", text_color=textColor, bgcolor=color.new(#1B2838, 0), text_size=size.small)
                table.cell(t, col, valueRow, na(p) ? "n/a" : str.tostring(p, format.mintick), text_color=textColor, bgcolor=color.new(lvlColor, 65), text_size=size.small)
                col += 1

        if blankBottomRows > 0
            for r = valueRow + 1 to valueRow + blankBottomRows
                for c = 0 to tblCols - 1
                    table.cell(t, c, r, "", bgcolor=color.new(color.black, 100))
