//@version=6
indicator("Barky's EMA Clouds", 
     shorttitle   = "Barky's EMA Clouds", 
     overlay      = true,
     behind_chart = true)

// ════════════════════════════════════════════════════════════
// SECTION 1 — EMA CLOUDS
// ════════════════════════════════════════════════════════════

matype  = "EMA"//input.string(title='MA Type', defval='EMA', options=['EMA','SMA'], group = "EMA Clouds")

ma_len1 = 5//input.int(title='Short EMA1 Length', defval=8, group = "EMA Clouds")
ma_len2 = 9//input.int(title='Long EMA1 Length',  defval=9, group = "EMA Clouds")
ma_len3 = 8//input.int(title='Short EMA2 Length', defval=8, group = "EMA Clouds")
ma_len4 = 14//input.int(title='Long EMA2 Length',  defval=14, group = "EMA Clouds")
ma_len5 = 8//input.int(title='Short EMA3 Length', defval=14, group = "EMA Clouds")
ma_len6 = 21//input.int(title='Long EMA3 Length',  defval=21, group = "EMA Clouds")
ma_len7 = 34//input.int(title='Short EMA4 Length', defval=34, group = "EMA Clouds")
ma_len8 = 50//input.int(title='Long EMA4 Length',  defval=50, group = "EMA Clouds")

src = close//input(title='Source', defval=close)

f_ma(malen) =>
    float result = 0
    if matype == 'EMA'
        result := ta.ema(src, malen)
    else
        result := ta.sma(src, malen)
    result

htf_ma1 = f_ma(ma_len1)
htf_ma2 = f_ma(ma_len2)
htf_ma3 = f_ma(ma_len3)
htf_ma4 = f_ma(ma_len4)
htf_ma5 = f_ma(ma_len5)
htf_ma6 = f_ma(ma_len6)
htf_ma7 = f_ma(ma_len7)
htf_ma8 = f_ma(ma_len8)

ema1 = input.bool(false, title='Show Cloud Edge')
ema2 = input.bool(true,  title='Show 9/14 Cloud')
ema3 = input.bool(true,  title='Show 9/21 Cloud')
ema4 = input.bool(true,  title='Show 34/50 Cloud')

emacloudleading = 0

mashort1 = htf_ma1
malong1  = htf_ma2
mashort2 = htf_ma3
malong2  = htf_ma4
mashort3 = htf_ma5
malong3  = htf_ma6
mashort4 = htf_ma7
malong4  = htf_ma8

_colBull = input.color(#5b9cf6, title="Bull / Bear",         inline="cc1", group="Cloud Colors")
_colBear = input.color(#5b9cf6, title="",                    inline="cc1", group="Cloud Colors")
_cloudTr = input.int(92, title="Cloud Transparency", minval=0, maxval=100, inline="cc2", group="Cloud Colors")

// Fixed relative opacity offsets per layer (negative = more opaque)
_rel1 = 0
_rel2 = -10
_rel3 = 0
_rel4 = 0

f_cloudCol(bool _up, int _rel) =>
    color.new(_up ? _colBull : _colBear, math.max(0, math.min(100, _cloudTr + _rel)))

cloudcolour1 = f_cloudCol(mashort1 >= malong1, _rel1)
cloudcolour2 = f_cloudCol(mashort2 >= malong2, _rel2)
cloudcolour3 = f_cloudCol(mashort3 >= malong3, _rel3)
cloudcolour4 = f_cloudCol(mashort4 >= malong4, _rel4)

fill(
     plot(ema1 ? mashort1 : na, offset=emacloudleading, display=display.none, editable=false),
     plot(ema1 ? malong1  : na, offset=emacloudleading, display=display.none, editable=false),
     color=cloudcolour1, title='MA Cloud 1')
fill(
     plot(ema2 ? mashort2 : na, offset=emacloudleading, display=display.none, editable=false),
     plot(ema2 ? malong2  : na, offset=emacloudleading, display=display.none, editable=false),
     color=cloudcolour2, title='MA Cloud 2')
fill(
     plot(ema3 ? mashort3 : na, offset=emacloudleading, display=display.none, editable=false),
     plot(ema3 ? malong3  : na, offset=emacloudleading, display=display.none, editable=false),
     color=cloudcolour3, title='MA Cloud 3')
fill(
     plot(ema4 ? mashort4 : na, offset=emacloudleading, display=display.none, editable=false),
     plot(ema4 ? malong4  : na, offset=emacloudleading, display=display.none, editable=false),
     color=cloudcolour4, title='MA Cloud 4')

// ════════════════════════════════════════════════════════════
// SECTION 2 — WATERMARK
// ════════════════════════════════════════════════════════════

boxLoc(_loc) =>
    loc = switch _loc
        "Top-Left"      => position.top_left
        "Top-Center"    => position.top_center
        "Top-Right"     => position.top_right
        "Middle-Left"   => position.middle_left
        "Middle-Center" => position.middle_center
        "Middle-Right"  => position.middle_right
        "Bottom-Left"   => position.bottom_left
        "Bottom-Center" => position.bottom_center
        "Bottom-Right"  => position.bottom_right
    loc

_size(string _sz, bool _l=false) =>
    size = switch _sz
        "Tiny"   => not(_l) ? size.tiny   : size.small
        "Small"  => not(_l) ? size.small  : size.normal
        "Normal" => not(_l) ? size.normal : size.large
        "Large"  => not(_l) ? size.large  : size.huge
        "Huge"   => not(_l) ? size.huge   : size.huge
    size

_color2    = input.color(#bbd9fb,   title='',             inline='s2.1', group="Symbol Info")
_bgcolor2  = input.color(#072734,   title='',             inline='s2.1', group="Symbol Info")
_showBrdr2 = input.bool(true,       title="Hide Border?", inline='s2.1', group="Symbol Info")
_y2        = input.string("Top",    title="",             inline='s2.2', group="Symbol Info", options=["Top","Middle","Bottom"])
_x2        = input.string("Right",  title="",             inline='s2.2', group="Symbol Info", options=["Left","Center","Right"])
_size2     = input.string("Normal", title="",             inline='s2.2', group="Symbol Info", options=["Tiny","Small","Normal","Large","Huge"])
_showIsym  = input.bool(true,       title="Symbol?",      inline='s2.3', group="Symbol Info")
_showItf   = input.bool(true,       title="Timeframe?",   inline='s2.3', group="Symbol Info")
_showIdate = input.bool(true,       title="Date?",        inline='s2.3', group="Symbol Info")

infoLOC = boxLoc(_y2 + "-" + _x2)

num_tf = if timeframe.isminutes
    if str.tonumber(timeframe.period) % 60 == 0
        str.tostring(str.tonumber(timeframe.period) / 60)
    else
        timeframe.period
else
    timeframe.period

text_tf = if timeframe.isminutes
    if str.tonumber(timeframe.period) % 60 == 0
        "H"
    else
        "M"
else
    na

tf = text_tf + num_tf

_info = table.new(infoLOC, 1, 4, frame_color=_color2, frame_width=_showBrdr2 ? 0 : 1)

table.cell(_info, 0, 0, "www.BarkworthyNotes.com",
     text_color  = _color2,
     text_halign = text.align_center,
     text_size   = size.normal,
     bgcolor     = _bgcolor2)

if _showIsym
    table.cell(_info, 0, 1, syminfo.ticker,
         text_color  = _color2,
         text_halign = text.align_center,
         text_size   = _size(_size2, true),
         bgcolor     = _bgcolor2)

if _showItf or _showIdate
    table.cell(_info, 0, 3,
         (_showItf ? tf[1] : "") +
         (_showItf and _showIdate ? "  |  " : "") +
         (_showIdate ? str.format("{0,date,yyyy-MM-dd}", time) : ""),
         text_color  = _color2,
         text_halign = text.align_center,
         text_size   = _size(_size2),
         bgcolor     = _bgcolor2)