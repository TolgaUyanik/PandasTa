//// --- 1. TTM Squeeze Logic ---
length = input.int(20, "Squeeze Length")
multK = input.float(2.0, "Keltner Multiplier")
multB = input.float(1.5, "Bollinger Multiplier")

basis = ta.sma(close, length)
dev = multB * ta.stdev(close, length)
upperBB = basis + dev
lowerBB = basis - dev

ma = ta.sma(close, length)
range_ = ta.tr
range_ema = ta.ema(range_, length)
upperKC = ma + range_ema * multK
lowerKC = ma - range_ema * multK

// Determine Squeeze (Red dots on original TTM)
sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)

// Momentum Histogram (Linear Regression)
highestH = ta.highest(high, length)
lowestL = ta.lowest(low, length)
avg = math.avg(math.avg(highestH, lowestL), ta.sma(close, length))
mom = ta.linreg(close - avg, length, 0)

// Histogram Colors (Full Blue = Rising Above 0, Full Red = Falling Below 0)
isFullBlue = mom > 0 and mom > nz(mom[1])
isFullRed  = mom < 0 and mom < nz(mom[1])

// --- 2. EMA Cross Logic ---
ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
emaCross = ta.crossover(ema9, ema21) or (ema9 >= ema21)

// --- 3. Signal Conditions ---
// Condition: Squeeze was ON (red) and now we have 2 bars of Squeeze OFF (green)
sqzRelease = sqzOn[2] and sqzOff[1] and sqzOff

// Combined Signal
longSignal = sqzRelease and emaCross and isFullBlue

// --- Plotting ---
plot(ema9, color=color.blue, title="EMA 9")
plot(ema21, color=color.red, title="EMA 21")

plotshape(longSignal, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Long Signal")

// Background highlight for Squeeze state
bgcolor(sqzOn ? color.new(color.red, 90) : na) 

//@version=6
strategy("My strategy", overlay=true, fill_orders_on_standard_ohlc = true)

longCondition = ta.crossover(ta.sma(close, 14), ta.sma(close, 28))
if (longCondition)
    strategy.entry("My Long Entry Id", strategy.long)

shortCondition = ta.crossunder(ta.sma(close, 14), ta.sma(close, 28))
if (shortCondition)
    strategy.entry("My Short Entry Id", strategy.short)
