// @description Direction calculation algorithms for body, bar, and breakout directions by AlKaIsMe
library("DirectionCalculations")

// @function Calculate body direction based on open vs close
// @returns Body direction: 1 (bullish), -1 (bearish), 0 (doji)
export get_body_direction() =>
    if close > open
        1
    else if open > close
        -1
    else
        0

// @function Calculate bar direction based on close position relative to hl2
// @returns Bar direction: 1 (upper half), -1 (lower half), 0 (middle)
export get_bar_direction() =>
    if close > hl2
        1
    else if close < hl2
        -1
    else
        0

// @function Calculate breakout direction with outside/inside bar logic
// @returns [breakout_direction, is_outside_bar, is_inside_bar, outside_dir, inside_dir]
export get_breakout_direction() =>
    bool HH = high > high[1]
    bool HL = low > low[1] 
    bool LL = low < low[1]
    bool LH = high < high[1]
    
    float HtoH_dist = math.abs(high - high[1])
    float LtoL_dist = math.abs(low - low[1])
    
    var int brO_diR = 0
    var bool OB = false
    var bool IB = false
    var int brO_OB_diR = 0
    var int brO_IB_diR = 0
    
    brO_diR := if HH and HL
        1
    else if LL and LH
        -1
    else if not LH and not HL  // Outside Bars
        OB := true
        if HtoH_dist > LtoL_dist
            brO_OB_diR := 1
            1
        else if HtoH_dist < LtoL_dist
            brO_OB_diR := -1
            -1
        else
            brO_OB_diR := 0
            0
    else if not HH and not LL  // Inside Bars
        IB := true
        if HtoH_dist > LtoL_dist
            brO_IB_diR := -1
            -1
        else if HtoH_dist < LtoL_dist
            brO_IB_diR := 1
            1
        else
            brO_IB_diR := 0
            0
    else
        0
    
    [brO_diR, OB, IB, brO_OB_diR, brO_IB_diR]

// @function Calculate combined direction from body and bar directions
// @param bod_dir Body direction
// @param bar_dir Bar direction  
// @param bro_dir Breakout direction
// @param bro_ob_dir Outside bar direction
// @returns Combined direction
export get_combined_direction(int bod_dir, int bar_dir, int bro_dir, int bro_ob_dir) =>
    var int diR = 0
    
    bool CH = close > high[1]
    bool CL = close < low[1]
    bool HcC = close > close[1]
    bool LcC = close < close[1]
    
    if bod_dir > 0 and bar_dir > 0
        diR := 1
    else if bod_dir < 0 and bar_dir < 0
        diR := -1
    else if bar_dir == 0 and bod_dir > 0
        diR := 1
    else if bar_dir == 0 and bod_dir < 0
        diR := -1
    else if bar_dir < 0 and bod_dir >= 0 and CH
        diR := 1
    else if bar_dir > 0 and bod_dir <= 0 and CL
        diR := -1
    else if bar_dir < 0 and bod_dir >= 0 and HcC and (bro_dir > 0 or bro_ob_dir > 0)
        diR := 1
    else if bar_dir > 0 and bod_dir <= 0 and LcC and (bro_dir < 0 or bro_ob_dir < 0)
        diR := -1
    else if bar_dir < 0 and bod_dir >= 0
        diR := -1
    else if bar_dir > 0 and bod_dir <= 0
        diR := 1
    else if bar_dir == 0 and bod_dir == 0
        diR := diR[1]
    
    if diR == 0 and (bro_dir > 0 or bro_ob_dir > 0)
        diR := 1
    else if diR == 0 and (bro_dir < 0 or bro_ob_dir < 0)
        diR := -1
    
    diR

// @function Check if directions are consecutive (no reversal)
// @param current_dir Current direction
// @param previous_dir Previous direction
// @returns True if consecutive (no reversal from +1 to -1 or -1 to +1)
export is_consecutive_direction(int current_dir, int previous_dir) =>
    not ((current_dir == 1 and previous_dir == -1) or (current_dir == -1 and previous_dir == 1))

// @function Get all direction calculations at once
// @returns [body_dir, bar_dir, breakout_dir, is_outside_bar, is_inside_bar, outside_dir, inside_dir, combined_dir]
export get_all_directions() =>
    body_dir = get_body_direction()
    bar_dir = get_bar_direction()
    [breakout_dir, is_outside_bar, is_inside_bar, outside_dir, inside_dir] = get_breakout_direction()
    combined_dir = get_combined_direction(body_dir, bar_dir, breakout_dir, outside_dir)
    [body_dir, bar_dir, breakout_dir, is_outside_bar, is_inside_bar, outside_dir, inside_dir, combined_dir]

// @function Get distance calculations for breakout analysis
// @returns [HtoH_dist, LtoL_dist] High-to-high and low-to-low distances
export get_breakout_distances() =>
    float HtoH_dist = math.abs(high - high[1])
    float LtoL_dist = math.abs(low - low[1])
    [HtoH_dist, LtoL_dist]

// @function Check for specific bar patterns
// @returns [is_higher_high, is_higher_low, is_lower_low, is_lower_high]
export get_bar_patterns() =>
    bool HH = high > high[1]
    bool HL = low > low[1] 
    bool LL = low < low[1]
    bool LH = high < high[1]
    [HH, HL, LL, LH]