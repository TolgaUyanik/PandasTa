//@version=6
indicator('TREV Candles - Range-Based Trend Reversal', shorttitle = 'TREV', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// =========================================================================================================
//                                           TREV CANDLES 
//          Range-Based Trend Reversal Candles - True TREV Chart Implementation
//
// TREV candles form based on price movement thresholds (not time):
// • Trend candles: Continue current direction when trend threshold is hit
// • Reversal candles: Change direction when reversal threshold is hit  
// • Direction changes ONLY through reversal candles (enforced TREV rules)
// • Wicks only appear on open side of candle (no impossible wicks)
// • Multiple candles can form per bar when price moves significantly
// =========================================================================================================

// ========================================
// INPUTS
// ========================================

// Allowed pairs input
allowed_pairs = input.text_area('MES,MNQ,M2K,MYM,ES,NQ,RTY,YM,MGC,GC,MES1!,MNQ1!,M2K1!,MYM1!,ES1!,NQ1!,RTY1!,YM1!,MGC1!,GC1!', 'Allowed Trading Pairs', tooltip = 'Enter trading pairs separated by commas. Leave empty to allow all pairs. Includes rolling 1! versions.')

// Manual size settings (used when Calculation Mode is set to Manual ATR)
manual_trend_ticks = input.int(840, 'Manual Trend Size (ticks)', minval = 1, tooltip = 'Used when Calculation Mode is set to Manual ATR')
manual_reversal_ticks = input.int(500, 'Manual Reversal Size (ticks)', minval = 1, tooltip = 'Used when Calculation Mode is set to Manual ATR')

tick_size_mode = input.string('auto', 'Tick Size Mode', options = ['auto', 'manual', 'appropriate'])
manual_tick_size = input.float(0.25, 'Manual Tick Size', minval = 0.01)
run_only_on_confirmed_bars = input.bool(true, 'Run Only on Confirmed Bars', tooltip = 'Run TREV logic only on confirmed bars. This is useful for backtesting.')



// Auto size calculation settings
use_range_chart = input.bool(false, 'Use Range Chart', tooltip = 'When enabled, uses range chart mode instead of directional movement')
use_locked_values = input.bool(true, 'Use Locked Renko-Style Values', tooltip = 'When enabled, uses locked values from previous candle completion (Renko-style). When disabled, uses current calculated values to replicate standalone range chart behavior.')
auto_size_divisor = input.float(3.0, 'ATR Divisor for Auto Size', minval = 0.1, maxval = 10.0)
reversal_mode = input.string('Fibonacci Division', 'Reversal Calculation Mode', options = ['Fibonacci Division', 'Equal to Trend', 'Multiple of Trend'], tooltip = 'How to calculate reversal size: Fibonacci Division (trend ÷ 1.68), Equal to Trend (same as trend), or Multiple of Trend (trend × multiplier)')
reversal_multiple = input.float(2.0, 'Reversal Multiple', minval = 1.0, maxval = 10.0, tooltip = 'Multiplier for reversal size when Multiple of Trend mode is selected (e.g., 2.0 = double the trend size)')
enableAutoDivisorAdjustment = input.bool(false, 'Auto Adjust Divisor', tooltip = 'When enabled, automatically adjusts divisor to ensure reversal is at least 2x the chart ATR')

// HTF Reset Settings
string GRP_HTF_RESET = 'HTF Reset Settings'
enableHTFReset = input.bool(false, 'Reset on HTF Candle Open', group = GRP_HTF_RESET, tooltip = 'Reset TREV candles when higher timeframe candle opens')
htfTimeframe = input.string('auto', 'HTF Timeframe', options = ['auto', '5', '15', '30', '60', '240', '1D', '1W'], group = GRP_HTF_RESET, tooltip = 'Higher timeframe to reset on. "Auto" uses the same logic as auto size mode.')

// HTF Line Settings (independent of reset)
string GRP_HTF_LINE = 'HTF Open Line'
showHTFOpenLine = input.bool(false, 'Show HTF Open Line', group = GRP_HTF_LINE, tooltip = 'Draw line at HTF candle open price (independent of reset functionality)')
htfLineExtendMode = input.string('To Current', 'HTF Line Extension', options = ['To Current', 'Right'], group = GRP_HTF_LINE, tooltip = 'How to extend the HTF open line')
htfLineColor = input.color(color.yellow, 'HTF Line Color', group = GRP_HTF_LINE)
htfLineStyle = input.string('solid', 'HTF Line Style', options = ['solid', 'dashed', 'dotted'], group = GRP_HTF_LINE)
htfLineWidth = input.int(2, 'HTF Line Width', minval = 1, maxval = 5, group = GRP_HTF_LINE)

// Calculation Mode Settings
calculation_mode = input.string('Auto ATR', 'Calculation Mode', options=['Auto ATR', 'ASPR (Traditional)', 'Quant Mode (Historical)', 'Appropriate HTF ATR', 'Chart ATR'], tooltip='Auto ATR: Uses 30min ATR with auto periods. ASPR: Previous session ASPR for traditional markets. Quant Mode: Historical same-day/time analysis. Appropriate HTF: Higher timeframe ATR based on chart timeframe. Chart ATR: Uses current chart ATR directly.')
chart_atr_periods = input.int(200, 'Chart ATR Periods', minval=1, maxval=10000, tooltip='Periods for Chart ATR calculation and Chart ATR display')
quant_lookback_weeks = 3  // Fixed to 3 weeks

// Calculation Info Table Settings
string GRP_AUTO_TABLE = 'Calculation Info Table'
show_auto_info = input.bool(true, 'Show Calculation Info', group = GRP_AUTO_TABLE, tooltip = 'Display table with calculated values and settings')
auto_table_position = input.string('Top Right', 'Table Position', options = ['Top Left', 'Top Center', 'Top Right', 'Middle Left', 'Middle Center', 'Middle Right', 'Bottom Left', 'Bottom Center', 'Bottom Right'], group = GRP_AUTO_TABLE)
auto_table_text_size = input.string('tiny', 'Table Text Size', options = ['tiny', 'small', 'normal', 'large', 'huge'], group = GRP_AUTO_TABLE)

// Table Content Settings
string GRP_AUTO_TABLE_CONTENT = 'Table Content'
show_market_type = input.bool(false, 'Show Market Type', group = GRP_AUTO_TABLE_CONTENT)
show_atr_30min = input.bool(false, 'Show ATR (30min)', group = GRP_AUTO_TABLE_CONTENT)
show_locked_atr = input.bool(true, 'Show Locked ATR (Renko-style)', group = GRP_AUTO_TABLE_CONTENT, tooltip = 'Shows the Fibonacci-rounded ATR in ticks locked from the last completed candle. This is the ATR value used for calculating the current forming candle.')
show_atr_ticks = input.bool(false, 'Show ATR (ticks)', group = GRP_AUTO_TABLE_CONTENT)
show_atr_divisor = input.bool(false, 'Show ATR ÷ Divisor', group = GRP_AUTO_TABLE_CONTENT)
show_trend_size = input.bool(true, 'Show Trend Size', group = GRP_AUTO_TABLE_CONTENT)
show_reversal_calc = input.bool(false, 'Show Reversal Calculation', group = GRP_AUTO_TABLE_CONTENT)
show_reversal_size = input.bool(false, 'Show Reversal Size', group = GRP_AUTO_TABLE_CONTENT)
show_tick_size = input.bool(false, 'Show Tick Size', group = GRP_AUTO_TABLE_CONTENT)
show_chart_atr_ticks = input.bool(false, 'Show Chart ATR (ticks)', group = GRP_AUTO_TABLE_CONTENT)

// Table Styling
string GRP_AUTO_TABLE_STYLE = 'Table Styling'
auto_table_bg_color = input.color(color.new(color.white, 80), 'Table Background', group = GRP_AUTO_TABLE_STYLE)
auto_table_text_color = input.color(color.black, 'Table Text Color', group = GRP_AUTO_TABLE_STYLE)
auto_table_header_bg_color = input.color(color.new(color.blue, 70), 'Header Background', group = GRP_AUTO_TABLE_STYLE)
auto_table_header_text_color = input.color(color.black, 'Header Text Color', group = GRP_AUTO_TABLE_STYLE)
auto_table_border_width = input.int(1, 'Border Width', minval = 0, maxval = 3, group = GRP_AUTO_TABLE_STYLE)
auto_table_border_color = input.color(color.gray, 'Border Color', group = GRP_AUTO_TABLE_STYLE)
