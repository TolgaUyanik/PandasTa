isInRange(ratio, min, max) =>
    ratio >= min and ratio <= max

getadj(p1, p2, adj, logScale, precision) =>
    math.max(0, fibs.retracement(p1, p2, adj, logScale, precision))

//@function evaluates harmonic ratio range
//@param patternsMap parameter containing valid pattern names
//@param pattern Pattern type to be evaluated
//@param ratioRange ratio range to be checked
//@param properties Scan Properties
//@param ratio to be checked against range
//@returns void
export method evaluate(map<string, bool> patternsMap, string pattern, Range ratioRange, ScanProperties properties, float ratioValue) =>
    min = ratioRange.values.min()
    max = ratioRange.values.max()
    minRange = min == max or not properties.strictMode ? properties.errorMin * min : min
    maxRange = min == max or not properties.strictMode ? properties.errorMax * max : max
    patternsMap.put(pattern, isInRange(ratioValue, minRange, maxRange))

//@function Scan for particular named ratio of harmonic pattern to filter valid patterns
//@param currentPatterns Current valid patterns map
//@param rules map<string, RatioMap> Harmonic ratio rules
//@param properties ScanProperties object
//@param ratioName Specific ratio name 
//@param ratioValue ratio value to be checked
//@returns updated currentPatterns object
export method scanRatio(map<string, bool> currentPatterns, map<string, RatioMap> rules, ScanProperties properties, string ratioName, float ratioValue) =>
    if currentPatterns.values().includes(true)
        for pattern in currentPatterns.keys()
            if currentPatterns.get(pattern) and rules.contains(pattern)
                rule = rules.get(pattern)
                if rule.ratioMap.contains(ratioName)
                    currentPatterns.evaluate(pattern, rule.ratioMap.get(ratioName), properties, ratioValue)
    currentPatterns

//@function Scan for patterns based on X, A, B, C, D values
//@param patterns List of allowed patterns
//@param x X coordinate
//@param a A coordinate
//@param b B coordinate
//@param c C coordinate
//@param d D coordinate
//@param properties ScanProperties object. If na, default values are initialised
//@returns updated valid patterns map
export method scanPatterns(map<string, bool> patterns, float x, float a, float b, float c, float d, ScanProperties properties = na) =>
    var rules = getHarmonicMap()
    numberOfPatterns = rules.size()

    var scanProperties = na(properties) ? ScanProperties.new() : properties

    xabRatio = fibs.retracementRatio(x, a, b, scanProperties.logScale)
    abcRatio = fibs.retracementRatio(a, b, c, scanProperties.logScale)
    axcRatio = fibs.retracementRatio(a, x, c, scanProperties.logScale)
    bcdRatio = fibs.retracementRatio(b, c, d, scanProperties.logScale)
    xadRatio = fibs.retracementRatio(x, a, d, scanProperties.logScale)
    xcdRatio = fibs.retracementRatio(x, c, d, scanProperties.logScale)

    patterns.scanRatio(rules, scanProperties, 'xabRatio', xabRatio).
				 scanRatio(rules, scanProperties, 'abcRatio', abcRatio).
				 scanRatio(rules, scanProperties, 'axcRatio', axcRatio).
				 scanRatio(rules, scanProperties, 'bcdRatio', bcdRatio).
				 scanRatio(rules, scanProperties, 'xadRatio', xadRatio).
				 scanRatio(rules, scanProperties, 'xcdRatio', xcdRatio)
    patterns

//@function Scan for projections based on X, A, B, C values
//@param patterns List of allowed patterns
//@param x X coordinate
//@param a A coordinate
//@param b B coordinate
//@param c C coordinate
//@param properties ScanProperties object. If na, default values are initialised
//@returns updated valid projections map
export method scanProjections(map<string, bool> patterns, float x, float a, float b, float c, ScanProperties properties = na) =>
    var rules = getHarmonicMap()
    numberOfPatterns = rules.size()

    var scanProperties = na(properties) ? ScanProperties.new() : properties

    xabRatio = fibs.retracementRatio(x, a, b, scanProperties.logScale)
    abcRatio = fibs.retracementRatio(a, b, c, scanProperties.logScale)
    axcRatio = fibs.retracementRatio(a, x, c, scanProperties.logScale)

    patterns.scanRatio(rules, scanProperties, 'xabRatio', xabRatio).scanRatio(rules, scanProperties, 'abcRatio', abcRatio).scanRatio(rules, scanProperties, 'axcRatio', axcRatio)
    patterns

//@function merge two ranges into one
//@param this first range
//@param other second range
//@returns combined range
export method merge(Range this, Range other) =>
    direction = this.values.first() > this.values.last() ? 1 : this.values.first() < this.values.last() ? -1 : other.values.first() >= other.values.last() ? 1 : -1
    this.values.set(0, direction == 1 ? math.min(this.values.first(), other.values.first()) : math.max(this.values.first(), other.values.first()))
    this.values.set(1, direction == 1 ? math.max(this.values.last(), other.values.last()) : math.min(this.values.last(), other.values.last()))
    this

//@function union of two ranges into one
//@param this first range
//@param other second range
//@returns union range
export method union(Range this, Range other) =>
    direction = this.values.first() > this.values.last() ? 1 : this.values.first() < this.values.last() ? -1 : other.values.first() >= other.values.last() ? 1 : -1
    this.values.set(0, direction == 1 ? math.max(this.values.first(), other.values.first()) : math.min(this.values.first(), other.values.first()))
    this.values.set(1, direction == 1 ? math.min(this.values.last(), other.values.last()) : math.max(this.values.last(), other.values.last()))
    this

//@function checks if two ranges intersect
//@param this first range
//@param other second range
//@returns true if intersects, false otherwise
export method overlaps(Range this, Range other) =>
    other.values.min() >= this.values.min() and other.values.min() <= this.values.max() or
		 other.values.max() >= this.values.min() and other.values.max() <= this.values.max() or 
		 this.values.min() >= other.values.min() and this.values.min() <= other.values.max() or 
		 this.values.max() >= other.values.min() and this.values.max() <= other.values.max()

//@function Consolidate ranges into PRZ
//@param this map of Ranges
//@returns consolidated PRZ
export method consolidate(map<string, Range> this) =>
    PrzRange prz = PrzRange.new()
    if this.size() > 0
        first = this.values().first()
        direction = first.values.first() > first.values.last() ? 1 : -1
        values = array.new<float>()
        for key in this.keys()
            values.concat(this.get(key).values)
        prz.prz := Range.new(array.from(direction == 1 ? values.max() : values.min(), direction == 1 ? values.min() : values.max()))
        prz.patterns := this.keys()
        prz.patterns
    prz

//@function Consolidate ranges into multiple PRZ ranges
//@param this map of Ranges
//@returns consolidated array of PRZ ranges
export method consolidateMany(map<string, Range> this) =>
    array<PrzRange> przRanges = array.new<PrzRange>()
    array<PrzRange> resultRanges = array.new<PrzRange>()
    array<float> startValues = array.new<float>()

    for key in this.keys()
        PrzRange przRange = PrzRange.new(array.from(key), this.get(key))
        przRanges.push(przRange)

    merged = true
    counter = 1
    while merged
        counter := counter + 1
        merged := false

        while przRanges.size() > 0
            first = przRanges.shift()
            added = false
            for resultRange in resultRanges
                if resultRange.prz.overlaps(first.prz)
                    added := true
                    merged := true
                    resultRange.prz.union(first.prz)
                    resultRange.patterns.concat(first.patterns)
                    break
            if not added
                resultRanges.push(first)
        temp = przRanges
        przRanges := resultRanges
        resultRanges := temp
        resultRanges

    przRanges

//@function Evaluate PRZ ranges
//@param this map of Ranges
//@param pattern Pattern name
//@param ratioRange Range of ratio for the pattern
//@param priceRange Price range based on ratio
//@param properties ScanProperties object
//@returns void
export method evaluate(map<string, Range> przRange, string pattern, Range ratioRange, Range priceRange, ScanProperties properties) =>
    min = ratioRange.values.min()
    max = ratioRange.values.max()
    minRange = min == max or not properties.strictMode ? properties.errorMin * min : min
    maxRange = min == max or not properties.strictMode ? properties.errorMax * max : max

    precision = -int(math.log10(na(properties.mintick) ? syminfo.mintick : properties.mintick))

    start = getadj(priceRange.values.first(), priceRange.values.last(), minRange, properties.logScale, precision)
    end = getadj(priceRange.values.first(), priceRange.values.last(), maxRange, properties.logScale, precision)

    if start > 0 and end > 0
        newRange = Range.new(array.from(start, end))
        if not przRange.contains(pattern)
            przRange.put(pattern, newRange)
            newRange
        else
            if przRange.get(pattern).overlaps(newRange)
                przRange.get(pattern).merge(newRange)
            else
                przRange.remove(pattern)

//@function Get D range based on X, A, B, C coordinates for the current patterns
//@param currentPatterns List of valid patterns
//@param x X coordinate
//@param a A coordinate
//@param b B coordinate
//@param c C coordinate
//@param properties ScanProperties object. If na, default values are initialised
//@returns map of D ranges
export method getRange(map<string, bool> currentPatterns, float x, float a, float b, float c, ScanProperties properties = na) =>
    var rules = getHarmonicMap()
    numberOfPatterns = rules.size()

    var scanProperties = na(properties) ? ScanProperties.new() : properties
    map<string, Range> przRange = map.new<string, Range>()

    ratioBase = map.new<string, Range>()
    ratioBase.put('xadRatio', Range.new(array.from(x, a)))
    ratioBase.put('bcdRatio', Range.new(array.from(b, c)))
    ratioBase.put('xcdRatio', Range.new(array.from(x, c)))

    if currentPatterns.values().includes(true)
        for pattern in currentPatterns.keys()
            if currentPatterns.get(pattern) and rules.contains(pattern)
                rule = rules.get(pattern)
                for ratioName in ratioBase.keys()
                    if rule.ratioMap.contains(ratioName)
                        przRange.evaluate(pattern, rule.ratioMap.get(ratioName), ratioBase.get(ratioName), properties)
    przRange

//@function Get PRZ range based on X, A, B, C coordinates for the current patterns
//@param currentPatterns List of valid patterns
//@param x X coordinate
//@param a A coordinate
//@param b B coordinate
//@param c C coordinate
//@param properties ScanProperties object. If na, default values are initialised
//@returns PRZRange for the pattern
export method getPrzRange(map<string, bool> currentPatterns, float x, float a, float b, float c, ScanProperties properties = na) =>
    currentPatterns.getRange(x, a, b, c, properties).consolidate()

//@function Get projection range based on X, A, B, C coordinates for the current patterns
//@param currentPatterns List of valid patterns
//@param x X coordinate
//@param a A coordinate
//@param b B coordinate
//@param c C coordinate
//@param properties ScanProperties object. If na, default values are initialised
//@returns array of projection ranges
export method getProjectionRanges(map<string, bool> currentPatterns, float x, float a, float b, float c, ScanProperties properties = na) =>
    currentPatterns.getRange(x, a, b, c, properties).consolidateMany()

