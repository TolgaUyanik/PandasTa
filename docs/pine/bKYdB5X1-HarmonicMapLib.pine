//@version=6
// @description Harmonic Pattern Library implementation utilising maps
library('HarmonicMapLib', overlay = true)
import Trendoscope/FibRatios/1 as fibs

//@type Collection of range values
//@field values array of float values
export type Range
	array<float> values

//@type ratio map for pattern
//@field ratioMap map of string to Range (array of float)
export type RatioMap
	map<string, Range> ratioMap

//@type Pattern Scanning properties
//@field strictMode strict scanning mode will check for overflows
//@field logScale scan ratios in log scale
//@field errorMin min error threshold
//@field errorMas max error threshold
//@field mintick minimum tick value of price
export type ScanProperties
	bool strictMode = true
	bool logScale = false
	float errorMin = 0.92
	float errorMax = 1.08
	float mintick = syminfo.mintick

//@type Potential reversal zone range
//@field patterns array of pattern names for the given XABCD combination
//@field prz PRZ range
export type PrzRange
	array<string> patterns
	Range prz

// @function convert Range value to string
// @param this Range value
// @returns converted string representation
export method tostring(Range this) =>
    str.tostring(this.values)

// @function convert array of Range value to string
// @param this array<Range> object
// @returns converted string representation
export method tostring(array<Range> this) =>
    rangeStringValues = array.new<string>()
    for range in this
        rangeStringValues.push(range.tostring())
    rangeStringValues.join(',')

// @function convert map of string to Range value to string
// @param this map<string,Range> object
// @returns converted string representation
export method tostring(map<string, Range> this) =>
    mapStringValues = array.new<string>()
    for [key, value] in this
        mapStringValues.push(key + ' : ' + value.tostring())
    mapStringValues.join('\n')

// @function convert RatioMap to string
// @param this RatioMap object
// @returns converted string representation
export method tostring(RatioMap this) =>
    this.ratioMap.tostring()

// @function convert array of RatioMap to string
// @param this array<RatioMap> object
// @returns converted string representation
export method tostring(array<RatioMap> this) =>
    mapStringValues = array.new<string>()
    for ratioMap in this
        mapStringValues.push(ratioMap.tostring())
    mapStringValues.join(',')

// @function convert map of string to RatioMap to string
// @param this map<string, RatioMap> object
// @returns converted string representation
export method tostring(map<string, RatioMap> this) =>
    mapStringValues = array.new<string>()
    for key in this.keys()
        mapStringValues.push('' + key + ' : ' + this.get(key).tostring())
    mapStringValues.join('\n')

// @function convert map of string to bool to string
// @param this map<string, bool> object
// @returns converted string representation
export method tostring(map<string, bool> this) =>
    mapStringValues = array.new<string>()
    for key in this.keys()
        mapStringValues.push('' + key + ' : ' + str.tostring(this.get(key)))
    '\n' + mapStringValues.join('\n')

// @function convert PrzRange to string
// @param this PrzRange object
// @returns converted string representation
export method tostring(PrzRange this) =>
    str.tostring(this.patterns) + ' : ' + this.prz.tostring()

// @function convert array of PrzRange to string
// @param this array<PrzRange> object
// @returns converted string representation
export method tostring(array<PrzRange> this) =>
    stringValues = array.new<string>()
    for prz in this
        stringValues.push(prz.tostring())
    '\n' + stringValues.join('\n')

// @function Creates the RatioMap for harmonic patterns
