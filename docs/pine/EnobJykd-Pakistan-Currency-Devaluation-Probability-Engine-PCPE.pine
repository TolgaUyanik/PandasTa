//@version=6
indicator("Pakistan Currency Devaluation Probability Engine", shorttitle="Devaluation Prob Engine", overlay=false)

// ==============================================================================
// 1. INPUTS & CONFIGURATION (Hidden internal benchmark parameters)
// ==============================================================================
usdpkr_ticker   = input.symbol("FX_IDC:USDPKR", "USDPKR Spot Ticker", group="Data Feeds")
anchor_2006_val = input.float(60.0, "Base Rate Baseline", group="Macro Benchmark Settings")
base_cagr       = input.float(0.08, "Compounding Rate Factor", group="Macro Benchmark Settings")

// ==============================================================================
// 2. HELPER FUNCTIONS
// ==============================================================================
f_clamp(float val, float min_v, float max_v) =>
    math.min(math.max(val, min_v), max_v)

// ==============================================================================
// 3. DAILY ACCRUAL & PROBABILITY CALCULATIONS
// ==============================================================================
float usdpkr_safe = nz(request.security(usdpkr_ticker, "1D", close, barmerge.gaps_off, barmerge.lookahead_on), close)

var int anchor_time = timestamp(2006, 1, 1, 0, 0)
float days_elapsed  = math.max((time - anchor_time) / (86400 * 1000), 0.0)
float implied_value = anchor_2006_val * math.pow(1.0 + base_cagr, days_elapsed / 365.25)

float divergence_pct = ((usdpkr_safe - implied_value) / implied_value) * 100.0

string market_status = divergence_pct > 5.0 ? "STABILIZATION" : "DEVALUATION PENDING"
float raw_prob       = f_clamp((5.0 - divergence_pct) * 3.0, 0.0, 100.0)
float deval_prob     = raw_prob < 5.0 ? 0.0 : raw_prob

// Multi-tier color grading
color line_color = deval_prob > 70.0 ? color.black               : // Black above 70
                   deval_prob > 30.0 ? color.rgb(150, 0, 0)      : // Dark red above 30
                   deval_prob > 20.0 ? color.rgb(231, 76, 60)    : // Light red above 20
                   deval_prob > 10.0 ? color.rgb(241, 196, 15)   : // Yellow transition
                   deval_prob >= 5.0 ? color.purple              : // Purple between 5 and 10
                   color.rgb(46, 204, 113)                         // Green flat at 0 below 5

// ==============================================================================
// 4. PLOTS, BACKGROUND ZONES & DASHBOARD
// ==============================================================================
plot(deval_prob, "Probability of Devaluation (%)", color=line_color, linewidth=3, style=plot.style_line)

h_0   = hline(0.0, "0%", color=color.new(color.green, 30))
h_5   = hline(5.0, "5%", color=color.new(color.purple, 40), linestyle=hline.style_dotted)
h_10  = hline(10.0, "10%", color=color.new(color.yellow, 40), linestyle=hline.style_dotted)
h_20  = hline(20.0, "20%", color=color.new(color.rgb(231, 76, 60), 40), linestyle=hline.style_dotted)
h_30  = hline(30.0, "30%", color=color.new(color.rgb(150, 0, 0), 40), linestyle=hline.style_dotted)
h_50  = hline(50.0, "50%", color=color.new(color.red, 30), linestyle=hline.style_dashed)
h_70  = hline(70.0, "70%", color=color.new(color.black, 20), linestyle=hline.style_dashed)
h_100 = hline(100.0, "100%", color=color.new(color.white, 100))

// Background fills for risk zones
fill(h_0, h_20,   color=color.new(color.green, 95),  title="Stability Zone Background Fill")
fill(h_20, h_50,  color=color.new(color.orange, 92), title="Danger Zone Background Fill")
fill(h_50, h_100, color=color.new(color.red, 92),    title="Imminent Zone Background Fill")

// Background Text Labels
var label lbl_stability = na
var label lbl_danger = na
var label lbl_imminent = na
if barstate.islast
    label.delete(lbl_stability)
    label.delete(lbl_danger)
    label.delete(lbl_imminent)
    lbl_stability := label.new(bar_index - 20, 10.0, "STABILITY ZONE", color=color.new(color.green, 100), textcolor=color.new(color.green, 45), style=label.style_none, size=size.small)
    lbl_danger    := label.new(bar_index - 20, 35.0, "DEVALUATION DANGER ZONE", color=color.new(color.orange, 100), textcolor=color.new(color.orange, 45), style=label.style_none, size=size.small)
    lbl_imminent  := label.new(bar_index - 20, 75.0, "DEVALUATION IMMINENT", color=color.new(color.red, 100), textcolor=color.new(color.red, 45), style=label.style_none, size=size.small)

var table tbl = table.new(position=position.top_right, columns=2, rows=6, bgcolor=color.new(color.black, 15), border_color=color.gray, border_width=1)

if barstate.islast
    table.cell(tbl, 0, 0, "DEVALUATION PROB. ENGINE", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, "DAILY AUDIT SUMMARY", bgcolor=color.navy, text_color=color.white, text_size=size.small)

    table.cell(tbl, 0, 1, "USDPKR SPOT PRICE", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(usdpkr_safe, "#.##") + " PKR", text_color=color.white, text_size=size.small)

    table.cell(tbl, 0, 2, "IMPLIED REAL VALUE", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(implied_value, "#.#") + " PKR", text_color=color.fuchsia, text_size=size.small)

    table.cell(tbl, 0, 3, "DIVERGENCE SPREAD", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(divergence_pct, "+#.#;-#.#") + "%", text_color=divergence_pct >= 5.0 ? color.green : color.red, text_size=size.small)

    table.cell(tbl, 0, 4, "MARKET STATUS", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4, market_status, bgcolor=market_status == "STABILIZATION" ? color.new(color.green, 20) : color.new(color.red, 20), text_color=color.white, text_size=size.small)

    table.cell(tbl, 0, 5, "DEVALUATION PROB.", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 5, str.tostring(deval_prob, "#.#") + "%", text_color=line_color, text_size=size.small)