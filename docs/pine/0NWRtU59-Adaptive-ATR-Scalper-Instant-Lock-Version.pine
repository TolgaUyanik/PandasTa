//@version=6
strategy(title = 'Adaptive ATR Scalper - Instant & Lock Version', initial_capital = 100000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, pyramiding = 0, currency = 'USD', overlay = true)

// --- 1. INPUTS ---
atrLen = input.int(13, 'ATR Period')
adxLen = input.int(24, 'ADX Period')
adxThresh = input.int(43, 'ADX Threshold')

m1_heavy = input.float(4.4, 'Main Multiplier (ADX Rising)', step = 0.1, group = 'Main Trend')
m2_heavy = input.float(9.2, 'Main Multiplier (ADX Falling)', step = 0.1, group = 'Main Trend')

m1_fast = input.float(1.5, 'Fast Multiplier (ADX Rising)', step = 0.1, group = 'Fast Trigger')
m2_fast = input.float(3.0, 'Fast Multiplier (ADX Falling)', step = 0.1, group = 'Fast Trigger')

long_sl_perc = input.float(0.5, 'Long SL %', step = 0.1)
long_tp_perc = input.float(1.2, 'Long TP %', step = 0.1)
short_sl_perc = input.float(0.5, 'Short SL %', step = 0.1)
short_tp_perc = input.float(1.2, 'Short TP %', step = 0.1)

// --- 2. ADAPTIVE TREND FUNCTION ---
get_adaptive_trend(aLen, mult1, mult2) =>
    hR = ta.change(high)
    lR = -ta.change(low)
    dmPos = hR > lR ? math.max(hR, 0) : 0
    dmNeg = lR > hR ? math.max(lR, 0) : 0
    sTR = 0.0
    sTR := nz(sTR[1]) - nz(sTR[1]) / adxLen + ta.tr
    sDMPos = 0.0
    sDMPos := nz(sDMPos[1]) - nz(sDMPos[1]) / adxLen + dmPos
    sDMNeg = 0.0
    sDMNeg := nz(sDMNeg[1]) - nz(sDMNeg[1]) / adxLen + dmNeg
    DIP = sDMPos / sTR * 100
    DIN = sDMNeg / sTR * 100
    DX = math.abs(DIP - DIN) / (DIP + DIN) * 100
    adxValue = ta.sma(DX, adxLen)
    atr_v = ta.atr(aLen)
    m = ta.rising(adxValue, 1) and adxValue < adxThresh ? mult1 : mult2
    mUp = DIP >= DIN ? m : mult2
    mDn = DIN >= DIP ? m : mult2
    t = hl2
    up = t - mUp * atr_v
    dn = t + mDn * atr_v
    TUp = 0.0
    TUp := close[1] > TUp[1] ? math.max(up, TUp[1]) : up
    TDown = 0.0
    TDown := close[1] < TDown[1] ? math.min(dn, TDown[1]) : dn
    trend_dir = 0.0
    trend_dir := close > TDown[1] ? 1 : close < TUp[1] ? -1 : nz(trend_dir[1], 1)
    [trend_dir, trend_dir == 1 ? TUp : TDown]

// --- 3. CALCULATIONS ---
[mainDir, mainStop] = get_adaptive_trend(atrLen, m1_heavy, m2_heavy)
[fastDir, fastStop] = get_adaptive_trend(atrLen, m1_fast, m2_fast)

// --- 4. SMART LOCK MECHANISM ---
var bool waitingForReset = false

// When a position is closed for any reason, enter "waiting" mode
if strategy.position_size[1] != 0 and strategy.position_size == 0
    waitingForReset := true
    waitingForReset

// If main trend reverses OR fast trigger reverses, reset the lock
// This allows the strategy to catch new trends instantly
if ta.change(mainDir) != 0 or ta.change(fastDir) != 0
    waitingForReset := false
    waitingForReset

// --- 5. ENTRY CONDITIONS ---
// 1. Are Main and Fast trends aligned?
// 2. Are we out of the market?
// 3. Are we not in "waiting" mode after a TP/SL exit?
longCondition = mainDir == 1 and fastDir == 1 and strategy.position_size == 0 and not waitingForReset
shortCondition = mainDir == -1 and fastDir == -1 and strategy.position_size == 0 and not waitingForReset

if longCondition
    strategy.entry('Long', strategy.long, comment = 'Scalp L')

if shortCondition
    strategy.entry('Short', strategy.short, comment = 'Scalp S')

// --- 6. EXITS ---
// If the fast trend reverses, exit (In-trend scalp exit)
if strategy.position_size > 0 and fastDir == -1
    strategy.close('Long', comment = 'Exit L (Trend)')

if strategy.position_size < 0 and fastDir == 1
    strategy.close('Short', comment = 'Exit S (Trend)')

// Fixed TP/SL Exits
long_sl_price = strategy.position_avg_price * (1 - long_sl_perc / 100)
long_tp_price = strategy.position_avg_price * (1 + long_tp_perc / 100)
short_sl_price = strategy.position_avg_price * (1 + short_sl_perc / 100)
short_tp_price = strategy.position_avg_price * (1 - short_tp_perc / 100)

if strategy.position_size > 0
    strategy.exit('Exit L', 'Long', stop = long_sl_price, limit = long_tp_price, comment_loss = 'SL', comment_profit = 'TP')

if strategy.position_size < 0
    strategy.exit('Exit S', 'Short', stop = short_sl_price, limit = short_tp_price, comment_loss = 'SL', comment_profit = 'TP')

// --- 7. PLOTTING ---
plot(mainStop, color = mainDir == 1 ? color.new(color.green, 20) : color.new(color.red, 20), linewidth = 4, title = 'Main Trend')
plot(fastStop, color = fastDir == 1 ? color.new(color.lime, 40) : color.new(color.orange, 40), linewidth = 2, title = 'Fast Trigger')
bgcolor(waitingForReset ? color.new(color.gray, 92) : na, title = 'Waiting for Reset')