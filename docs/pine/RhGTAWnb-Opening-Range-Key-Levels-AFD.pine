var string orl_txt  = f_customTxt("ORL")

// ──────────────────────── SECTION 3: TYPES & METHODS ────────────────────────
type OpeningRange
    int    dur_sec
    float  or_high
    float  or_low
    float  or_mid
    int    start_bar
    bool   locked
    bool   width_ok      // Whether the range passes the width filter.
    bool   broke_up
    bool   broke_dn
    string last_break    // "NONE" | "UP" | "DN".
    int    breakout_bar
    string retest_state  // "NONE" | "TESTING" | "HELD" | "FAILED".
    bool   ext_hit_100
    // Killzone latches record directions that cross during the window so they
    // cannot be processed after it closes. They reset with the session's ranges.
    bool   kz_block_up = false
    bool   kz_block_dn = false
    bool   is_carrier    // Whether this range carries extension lines.
    bool   has_box
    color  col
    line   hi_line
    line   lo_line
    line   mid_line
    box    range_box
    label  tag_label
    label  tag_label_lo
    array<line>  ext_lines
    array<label> ext_labels
    array<label> ev_labels

// All drawings associated with a range are deleted together.
method deleteDrawings(OpeningRange this) =>
    if not na(this.hi_line)
        line.delete(this.hi_line)
    if not na(this.lo_line)
        line.delete(this.lo_line)
    if not na(this.mid_line)
        line.delete(this.mid_line)
    if not na(this.range_box)
        box.delete(this.range_box)
    if not na(this.tag_label)
        label.delete(this.tag_label)
    if not na(this.tag_label_lo)
        label.delete(this.tag_label_lo)
    if array.size(this.ext_lines) > 0
        for ln in this.ext_lines
            line.delete(ln)
        array.clear(this.ext_lines)
    if array.size(this.ext_labels) > 0
        for lb in this.ext_labels
            label.delete(lb)
        array.clear(this.ext_labels)
    if array.size(this.ev_labels) > 0
        for lb in this.ev_labels
            label.delete(lb)
        array.clear(this.ev_labels)

method width(OpeningRange this) =>
    this.or_high - this.or_low

// Key-level break/retest tracking for static snapshots. Live extremes are
// excluded because their prices move with the current period; GAP is excluded
// because its fill engine owns the state.
type KeyLevel
    string name
    float  price
    color  col
    int    side          // 1 = close above, -1 = below, 0 = unset.
    bool   broke_up
    bool   broke_dn
    string last_break    // "NONE" | "UP" | "DN".
    int    breakout_bar
    string retest_state  // "NONE" | "TESTING" | "HELD" | "FAILED".

// ──────────────────────────── SECTION 4: HELPERS ────────────────────────────
f_clampX(int x) =>
    math.max(x, bar_index - MAX_DRAW_LOOKBACK)

// Shared right-rail anchors. Labels use three columns to reduce overlap: OR
// tags closest to price, key levels next, and gap labels furthest right.
// The 499-bar maximum stays inside Pine's 500-bar future-coordinate limit.
f_railX0() =>
    bar_index + 1 + kl_lbl_off

f_railX1() =>
    bar_index + 1 + kl_lbl_off + 3

f_railX2() =>
    bar_index + 1 + kl_lbl_off + 6

f_lineX2() =>
    kl_line_to_lbl ? bar_index + 1 + kl_lbl_off : bar_index + 1

f_styleOf(string s) =>
    s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

// OR chart-label visibility reflects the label-mode override.
f_orLblOn(bool toggle) =>
    or_label_mode == "All on" or (or_label_mode == "Per toggle" and toggle)

// Whole-minute durations use "15m"; sub-minute durations use "30s".
f_durTag(int sec) =>
    sec % 60 == 0 ? str.tostring(sec / 60) + "m" : str.tostring(sec) + "s"

// Theory callouts are assigned by exact duration, not by range slot. Other
// durations receive no theory tag.
f_theoryName(int sec) =>
    sec == 900 ? "Toby" : sec == 3600 ? "AMT IB" : ""

// Explicit bullet lines keep chart and dashboard hover text readable.
f_theoryRules(int sec) =>
    string toby = "TOBY 15-MIN OPENING RANGE\n• Purpose: Marks the high and low of the first 15 minutes after the open.\n• BREAK: A confirmed close beyond the range establishes direction.\n• RETEST: A pullback to the broken level that holds is described as confirmation.\n• EXTENSION: The 1.0× range projection.\n• FAILED: A close back inside the range."
    string amt = "AMT INITIAL BALANCE (60 MIN)\n• Purpose: The first hour sets the IB, the session's first area of accepted value.\n• Inside IB: Balance/rotation, with the IB extremes as rotation boundaries.\n• One-side extension: Imbalance; possible Trend Day.\n• Both-side extension: Neutral Day.\n• No extension: Normal Day.\n• IB high/low: Support and resistance."
    sec == 900 ? toby : sec == 3600 ? amt : ""

// Enabled-duration bookkeeping, in seconds.
int shortestDur = 100000
int longestDur  = 0
if r1_eff
    shortestDur := math.min(shortestDur, r1_sec)
    longestDur  := math.max(longestDur, r1_sec)
if r2_eff
    shortestDur := math.min(shortestDur, r2_sec)
    longestDur  := math.max(longestDur, r2_sec)
if r3_eff
    shortestDur := math.min(shortestDur, r3_sec)
    longestDur  := math.max(longestDur, r3_sec)
if r4_eff
    shortestDur := math.min(shortestDur, r4_sec)
    longestDur  := math.max(longestDur, r4_sec)
if r5_eff
    shortestDur := math.min(shortestDur, r5_sec)
    longestDur  := math.max(longestDur, r5_sec)
bool anyRangeEnabled = longestDur > 0

// Timeframe checks show a notice while keeping the indicator usable.
int  chartSec   = timeframe.in_seconds(timeframe.period)
bool tfTooBig   = anyRangeEnabled and chartSec > shortestDur
bool tfUneven   = anyRangeEnabled and not tfTooBig and shortestDur % chartSec != 0

float atrVal = ta.atr(atr_len)
float volAvg = ta.sma(volume, 20)   // Baseline for volume confirmation.

// ───────────────── SECTION 5: SESSION DETECTION (every bar) ─────────────────
// Exchange session state provides stable session boundaries.
bool   inSession = session.ismarket
bool   inKillzone = kz_en and not na(time(timeframe.period, kz_sess, syminfo.timezone))
// The first bar is guarded with bar_index because Pine v6 booleans are never na.
bool   prevInSession = bar_index == 0 ? false : inSession[1]
// newSession is limited to one event per trading day. On extended-hours charts,
// the session edge and timeframe.change("D") can occur on the same calendar day;
// the day-change path is reserved for markets with no off-session bars.
var bool everOffSession = false
if not inSession
    everOffSession := true
int     dayKey      = dayofmonth(time, syminfo.timezone)
var int lastFireKey = na
bool    newDay      = ta.change(dayKey) != 0
bool fireRaw    = inSession and (not prevInSession or (newDay and not everOffSession))
bool newSession = fireRaw and (na(lastFireKey) or dayKey != lastFireKey)

var int sessOpenTime = na
var int sessOpenBar  = na
if newSession
    lastFireKey  := dayKey
    sessOpenTime := time
    sessOpenBar  := bar_index

// The overnight anchor precedes the current session. The left-extension setting
// uses this anchor and falls back to the open on 24/7 charts.
var int onStartBar = na
if not inSession and prevInSession
    onStartBar := bar_index

// ────────── SECTION 6: KEY LEVEL TRACKERS & SNAPSHOTS (every bar) ───────────
// The developing session and overnight window are tracked here.
var float dOpen = na
var int dOpenBar = na
var float dHigh = na
var int dHighBar = na
var float dLow = na
var int dLowBar = na
var float dClose = na
var int dCloseBar = na
var float onHiTrk = na
var int onHiTrkBar = na
var float onLoTrk = na
var int onLoTrkBar = na
var float pmHiTrk = na   // Pre-market high: midnight to session open.
var int pmHiTrkBar = na
var float pmLoTrk = na
var int pmLoTrkBar = na
// Snapshotted key levels. Values remain fixed after capture.
var float kl_pd_open = na
var int kl_pd_open_bar = na
var float kl_pd_high = na
var int kl_pd_high_bar = na
var float kl_pd_low = na
var int kl_pd_low_bar = na
var float kl_pd_close = na
var int kl_pd_close_bar = na
var float kl_on_high = na
var int kl_on_high_bar = na
var float kl_on_low = na
var int kl_on_low_bar = na
var float kl_cd_open = na
var int kl_cd_open_bar = na
var float kl_pm_high = na
var int kl_pm_high_bar = na
var float kl_pm_low = na
var int kl_pm_low_bar = na

// Prior-week high/low from a manual tracker; no request.security() lookahead.
var float wHiTrk = na
var int wHiTrkBar = na
var float wLoTrk = na
var int wLoTrkBar = na
var float kl_pw_high = na
var int kl_pw_high_bar = na
var float kl_pw_low = na
var int kl_pw_low_bar = na
if timeframe.change("W")
    kl_pw_high := wHiTrk
    kl_pw_high_bar := wHiTrkBar
    kl_pw_low  := wLoTrk
    kl_pw_low_bar := wLoTrkBar
    wHiTrk := na
    wHiTrkBar := na
    wLoTrk := na
    wLoTrkBar := na
if na(wHiTrk) or high > wHiTrk
    wHiTrk := high
    wHiTrkBar := bar_index
if na(wLoTrk) or low < wLoTrk
    wLoTrk := low
    wLoTrkBar := bar_index

// Prior/current month high/low from a manual tracker, mirroring the weekly one.
var float mHiTrk = na
var int mHiTrkBar = na
var float mLoTrk = na
var int mLoTrkBar = na
var float kl_pmo_high = na
var int kl_pmo_high_bar = na
var float kl_pmo_low = na
var int kl_pmo_low_bar = na
if timeframe.change("M")
    kl_pmo_high := mHiTrk
    kl_pmo_high_bar := mHiTrkBar
    kl_pmo_low  := mLoTrk
    kl_pmo_low_bar := mLoTrkBar
    mHiTrk := na
    mHiTrkBar := na
    mLoTrk := na
    mLoTrkBar := na
if na(mHiTrk) or high > mHiTrk
    mHiTrk := high
    mHiTrkBar := bar_index
if na(mLoTrk) or low < mLoTrk
    mLoTrk := low
    mLoTrkBar := bar_index

// Daily ATR: a manual 14-session RMA of true range used by the OR width filter.
var float dAtr = na
if newSession
    // The just-completed session is measured before the prior-day snapshot is
    // replaced below.
    float dTR = na(dHigh) or na(dLow) ? na : na(kl_pd_close) ? dHigh - dLow : math.max(dHigh - dLow, math.max(math.abs(dHigh - kl_pd_close), math.abs(dLow - kl_pd_close)))
    if not na(dTR)
        dAtr := na(dAtr) ? dTR : (dAtr * 13 + dTR) / 14
    // Completed prior-day and overnight trackers are captured here.
    kl_pd_open  := dOpen
    kl_pd_open_bar := dOpenBar
    kl_pd_high  := dHigh
    kl_pd_high_bar := dHighBar
    kl_pd_low   := dLow
    kl_pd_low_bar := dLowBar
    kl_pd_close := dClose
    kl_pd_close_bar := dCloseBar
    kl_on_high  := onHiTrk
    kl_on_high_bar := onHiTrkBar
    kl_on_low   := onLoTrk
    kl_on_low_bar := onLoTrkBar
    kl_cd_open  := open
    kl_cd_open_bar := bar_index
    kl_pm_high  := pmHiTrk
    kl_pm_high_bar := pmHiTrkBar
    kl_pm_low   := pmLoTrk
    kl_pm_low_bar := pmLoTrkBar
    // Trackers are reset for the new session and next overnight window.
    dOpen  := open
    dOpenBar := bar_index
    dHigh  := high
    dHighBar := bar_index
    dLow   := low
    dLowBar := bar_index
    dClose := close
    dCloseBar := bar_index
    onHiTrk := na
    onHiTrkBar := na
    onLoTrk := na
    onLoTrkBar := na
    pmHiTrk := na
    pmHiTrkBar := na
    pmLoTrk := na
    pmLoTrkBar := na
else if inSession
    if na(dHigh) or high > dHigh
        dHigh := high
        dHighBar := bar_index
    if na(dLow) or low < dLow
        dLow := low
        dLowBar := bar_index
    dClose := close
    dCloseBar := bar_index
if not inSession
    if timeframe.change("D")
        // The pre-market tracker starts at midnight; overnight tracking continues
        // from the prior session close.
        pmHiTrk := na
        pmHiTrkBar := na
        pmLoTrk := na
        pmLoTrkBar := na
    if na(onHiTrk) or high > onHiTrk
        onHiTrk := high
        onHiTrkBar := bar_index
    if na(onLoTrk) or low < onLoTrk
        onLoTrk := low
        onLoTrkBar := bar_index
    if na(pmHiTrk) or high > pmHiTrk
        pmHiTrk := high
        pmHiTrkBar := bar_index
    if na(pmLoTrk) or low < pmLoTrk
        pmLoTrk := low
        pmLoTrkBar := bar_index

// ─────── SECTION 7: RANGE REGISTRATION (session boundary) ───────────────────
var array<OpeningRange> active_ranges = array.new<OpeningRange>()

f_hasDur(int d) =>
    bool found = false
    if array.size(active_ranges) > 0
        for r in active_ranges
            if r.dur_sec == d
                found := true
    found

f_register(bool en, int dur, color c, string sty, int lw) =>
    if en and anyRangeEnabled and not f_hasDur(dur)
        bool carrier = dur == longestDur
        bool wantBox = show_range_box
        OpeningRange r = OpeningRange.new(dur_sec = dur, or_high = high, or_low = low, or_mid = hl2, start_bar = bar_index, locked = false, width_ok = true, broke_up = false, broke_dn = false, last_break = "NONE", breakout_bar = na, retest_state = "NONE", ext_hit_100 = false, is_carrier = carrier, has_box = wantBox, col = c, ext_lines = array.new<line>(), ext_labels = array.new<label>(), ev_labels = array.new<label>())
        r.hi_line := line.new(f_clampX(bar_index), high, bar_index + 1, high, color = c, style = f_styleOf(sty), width = lw)
        r.lo_line := line.new(f_clampX(bar_index), low, bar_index + 1, low, color = c, style = f_styleOf(sty), width = lw)
        if show_mid
            r.mid_line := line.new(f_clampX(bar_index), hl2, bar_index + 1, hl2, color = color.new(c, 40), style = line.style_dotted, width = 1)
        if wantBox
            r.range_box := box.new(f_clampX(bar_index), high, bar_index + 1, low, bgcolor = color.new(c, 88), border_color = na)
        array.push(active_ranges, r)

if newSession
    // Prior-session range drawings are removed so each session starts fresh.
    while array.size(active_ranges) > 0
        OpeningRange r = array.shift(active_ranges)
        r.deleteDrawings()
    // Enabled slots are registered here; duplicate durations share one range.
    f_register(r1_eff, r1_sec, r1_col, r1_sty, r1_w)
    f_register(r2_eff, r2_sec, r2_col, r2_sty, r2_w)
    f_register(r3_eff, r3_sec, r3_col, r3_sty, r3_w)
    f_register(r4_eff, r4_sec, r4_col, r4_sty, r4_w)
    f_register(r5_eff, r5_sec, r5_col, r5_sty, r5_w)

// ───── SECTION 8: FORMING / LOCK / BREAK / RETEST / EXT (every bar) ─────────
// Per-bar event flags are consumed by alert conditions.
bool evBreakUp = false
bool evBreakDn = false
bool evRetestHeld = false
bool evRetestFailed = false
bool evExtHit = false
// Volume status for this bar; used by break labels and the volume alert.
bool   volOK  = not na(volAvg) and volume > vol_conf_mult * volAvg
// The volume tag has its own toggle; vol_conf_en only controls the alert.
string volTag = show_vol_tag ? (volOK ? " · vol ✓" : " · vol ✗") : ""

// Event labels are anchored at the referenced OR level rather than the bar
// extreme, so a wide bar does not place the label far from the level.
f_evLabel(OpeningRange r, string txt, bool aboveBar, float y, string tip) =>
    if f_orLblOn(show_ev_labels)
        color bg = ev_match_or ? r.col : ev_bg_col
        label l = label.new(bar_index, y, txt, style = aboveBar ? label.style_label_down : label.style_label_up, color = color.new(bg, 20), textcolor = ev_txt_col, tooltip = tip)
        array.push(r.ev_labels, l)
        if array.size(r.ev_labels) > MAX_EV_LABELS
            label old = array.shift(r.ev_labels)
            label.delete(old)

f_extLine(OpeningRange r, float y, string tag, color c, string sty, int lw, bool pxEn) =>
    line ln = line.new(f_clampX(bar_index), y, f_lineX2(), y, color = c, style = f_styleOf(sty), width = lw)
    array.push(r.ext_lines, ln)
    if f_orLblOn(show_or_tags)
        label lb = label.new(f_railX0(), y, tag + (pxEn ? " " + str.tostring(y, format.mintick) : ""), style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)
        array.push(r.ext_labels, lb)

if array.size(active_ranges) > 0 and not na(sessOpenTime)
    for r in active_ranges
        int winEnd = sessOpenTime + r.dur_sec *1000
        // FORMING: the developing range updates until its window closes.
        if not r.locked
            if time < winEnd
                r.or_high := math.max(r.or_high, high)
                r.or_low  := math.min(r.or_low, low)
                r.or_mid  := (r.or_high + r.or_low) / 2
                line.set_y1(r.hi_line, r.or_high)
                line.set_y2(r.hi_line, r.or_high)
                line.set_y1(r.lo_line, r.or_low)
                line.set_y2(r.lo_line, r.or_low)
                if not na(r.mid_line)
                    line.set_y1(r.mid_line, r.or_mid)
                    line.set_y2(r.mid_line, r.or_mid)
                if not na(r.range_box)
                    box.set_top(r.range_box, r.or_high)
                    box.set_bottom(r.range_box, r.or_low)
            // LOCK: the range freezes on a confirmed bar once its window closes.
            if barstate.isconfirmed and time_close >= winEnd
                r.locked := true
                float wLock = r.width()
                // Out-of-range levels remain visible, while range event
                // processing is suppressed when the width filter rejects them.
                r.width_ok := not width_filt_en or na(dAtr) or (wLock >= width_min_atr* dAtr and wLock <= width_max_atr *dAtr)
                if f_orLblOn(show_or_tags)
                    string thName   = f_theoryName(r.dur_sec)
                    string thRules  = f_theoryRules(r.dur_sec)
                    // ORH and ORL renames replace only the side's OR prefix.
                    string tagSfx   = " " + f_durTag(r.dur_sec) + (thName == "" ? "" : " [" + thName + "]")
                    string hiTagTxt = (orh_txt == "" ? "OR" : orh_txt) + tagSfx
                    string loTagTxt = (orl_txt == "" ? "OR" : orl_txt) + tagSfx
                    r.tag_label    := label.new(f_railX0(), r.or_high, hiTagTxt + (f_orLblOn(or_tag_price) ? " " + str.tostring(r.or_high, format.mintick) : ""), style = label.style_label_left, color = color.new(color.black, 100), textcolor = r.col, tooltip = thRules)
                    r.tag_label_lo := label.new(f_railX0(), r.or_low, loTagTxt + (f_orLblOn(or_tag_price) ? " " + str.tostring(r.or_low, format.mintick) : ""), style = label.style_label_left, color = color.new(color.black, 100), textcolor = r.col, tooltip = thRules)
                if r.is_carrier
                    float w = r.width()
                    if ext_050_en
                        f_extLine(r, r.or_high + 0.5* w, "0.5×", ext_050_col, ext_050_sty, ext_050_w, ext_050_px)
                        f_extLine(r, r.or_low - 0.5 *w, "0.5×", ext_050_col, ext_050_sty, ext_050_w, ext_050_px)
                    if ext_100_en
                        f_extLine(r, r.or_high + 1.0* w, "1.0×", ext_100_col, ext_100_sty, ext_100_w, ext_100_px)
                        f_extLine(r, r.or_low - 1.0 *w, "1.0×", ext_100_col, ext_100_sty, ext_100_w, ext_100_px)
                    if ext_150_en
                        f_extLine(r, r.or_high + 1.5* w, "1.5×", ext_150_col, ext_150_sty, ext_150_w, ext_150_px)
                        f_extLine(r, r.or_low - 1.5 *w, "1.5×", ext_150_col, ext_150_sty, ext_150_w, ext_150_px)
                    if ext_200_en
                        f_extLine(r, r.or_high + 2.0* w, "2.0×", ext_200_col, ext_200_sty, ext_200_w, ext_200_px)
                        f_extLine(r, r.or_low - 2.0 *w, "2.0×", ext_200_col, ext_200_sty, ext_200_w, ext_200_px)
        // BREAK / RETEST / EXTENSION: confirmed session events during exchange
        // hours; extended-hours bars do not create range events.
        if barstate.isconfirmed and r.locked and inSession and r.width_ok
            float activeTol = retest_tol_type == "Daily ATR" ? retest_tol_val* dAtr : retest_tol_type == "Intraday ATR" ? retest_tol_val *atrVal : retest_tol_val* syminfo.mintick
            float tol = activeTol
            float w   = r.width()
            string durTag = f_durTag(r.dur_sec)
            // Killzone crossings are ignored for the rest of the session. A
            // retest already in progress returns to NONE and can re-arm later.
            if inKillzone
                if not r.broke_up and close > r.or_high
                    r.kz_block_up := true
                if not r.broke_dn and close < r.or_low
                    r.kz_block_dn := true
                if r.retest_state == "TESTING"
                    r.retest_state := "NONE"
            // The first confirmed close beyond each level is recorded once per side.
            if not r.broke_up and not r.kz_block_up and close > r.or_high and not inKillzone
                r.broke_up     := true
                r.last_break   := "UP"
                r.breakout_bar := bar_index
                r.retest_state := "NONE"
                f_evLabel(r, "OR BREAK ↑ " + durTag + volTag, false, r.or_high, "OR BREAK ↑\n• BREAK: Confirmed close above the OR high.\n• Close: " + str.tostring(close, format.mintick) + ".\n• OR high: " + str.tostring(r.or_high, format.mintick) + ".")
                evBreakUp := true
                if dyn_alerts
                    alert("OR+KL " + syminfo.ticker + ": " + durTag + " OR break ↑ @ " + str.tostring(close, format.mintick) + volTag, alert.freq_once_per_bar)
            else if not r.broke_dn and not r.kz_block_dn and close < r.or_low and not inKillzone
                r.broke_dn     := true
                r.last_break   := "DN"
                r.breakout_bar := bar_index
                r.retest_state := "NONE"
                f_evLabel(r, "OR BREAK ↓ " + durTag + volTag, true, r.or_low, "OR BREAK ↓\n• BREAK: Confirmed close below the OR low.\n• Close: " + str.tostring(close, format.mintick) + ".\n• OR low: " + str.tostring(r.or_low, format.mintick) + ".")
                evBreakDn := true
                if dyn_alerts
                    alert("OR+KL " + syminfo.ticker + ": " + durTag + " OR break ↓ @ " + str.tostring(close, format.mintick) + volTag, alert.freq_once_per_bar)
            // Retest state machine: one resolution per recorded break.
            if r.last_break == "UP" and bar_index > r.breakout_bar and not inKillzone
                if r.retest_state == "NONE" and low <= r.or_high + tol
                    r.retest_state := "TESTING"
                if r.retest_state == "TESTING"
                    if close > r.or_high
                        r.retest_state := "HELD"
                        f_evLabel(r, "RETEST — HELD " + durTag, false, r.or_high, "RETEST — HELD\n• Direction: Break up.\n• Level: OR high " + str.tostring(r.or_high, format.mintick) + ".\n• Tolerance: ±" + str.tostring(tol, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + " back above the level.\n• Interpretation: The level acted as support.")
                        evRetestHeld := true
                        if dyn_alerts
                            alert("OR+KL " + syminfo.ticker + ": " + durTag + " OR retest HELD @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
                    else if close < r.or_high
                        r.retest_state := "FAILED"
                        f_evLabel(r, "RETEST — FAILED " + durTag, true, r.or_high, "RETEST — FAILED\n• Direction: Break up.\n• Level: OR high " + str.tostring(r.or_high, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + " back below the level.\n• Interpretation: The level did not hold as support; price is back inside the range.")
                        evRetestFailed := true
                        if dyn_alerts
                            alert("OR+KL " + syminfo.ticker + ": " + durTag + " OR retest FAILED @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
            if r.last_break == "DN" and bar_index > r.breakout_bar and not inKillzone
                if r.retest_state == "NONE" and high >= r.or_low - tol
                    r.retest_state := "TESTING"
                if r.retest_state == "TESTING"
                    if close < r.or_low
                        r.retest_state := "HELD"
                        f_evLabel(r, "RETEST — HELD " + durTag, true, r.or_low, "RETEST — HELD\n• Direction: Break down.\n• Level: OR low " + str.tostring(r.or_low, format.mintick) + ".\n• Tolerance: ±" + str.tostring(tol, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + " back below the level.\n• Interpretation: The level acted as resistance.")
                        evRetestHeld := true
                        if dyn_alerts
                            alert("OR+KL " + syminfo.ticker + ": " + durTag + " OR retest HELD @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
                    else if close > r.or_low
                        r.retest_state := "FAILED"
                        f_evLabel(r, "RETEST — FAILED " + durTag, false, r.or_low, "RETEST — FAILED\n• Direction: Break down.\n• Level: OR low " + str.tostring(r.or_low, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + " back above the level.\n• Interpretation: The level did not hold as resistance; price is back inside the range.")
                        evRetestFailed := true
                        if dyn_alerts
                            alert("OR+KL " + syminfo.ticker + ": " + durTag + " OR retest FAILED @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
            // The 1.0× extension is marked when price touches it; a close is not required.
            if r.is_carrier and ext_100_en and not r.ext_hit_100
                if r.last_break == "UP" and high >= r.or_high + w
                    r.ext_hit_100 := true
                    evExtHit := true
                if r.last_break == "DN" and low <= r.or_low - w
                    r.ext_hit_100 := true
                    evExtHit := true
                if r.ext_hit_100 and dyn_alerts
                    alert("OR+KL " + syminfo.ticker + ": " + durTag + " OR 1.0× extension reached @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
        // Current-session drawings extend during the session and freeze at the
        // close; "OR window end" also freezes each range at its lock.
        if inSession
            if or_extend == "Session end" or not r.locked
                line.set_x2(r.hi_line, f_lineX2())
                line.set_x2(r.lo_line, f_lineX2())
                if not na(r.mid_line)
                    line.set_x2(r.mid_line, f_lineX2())
                if not na(r.range_box)
                    box.set_right(r.range_box, bar_index + 1)
                if not na(r.tag_label)
                    label.set_x(r.tag_label, f_railX0())
                if not na(r.tag_label_lo)
                    label.set_x(r.tag_label_lo, f_railX0())
        // Extension drawings track the live bar during the session.
        if inSession
            if array.size(r.ext_lines) > 0
                for ln in r.ext_lines
                    line.set_x2(ln, f_lineX2())
            if array.size(r.ext_labels) > 0
                for lb in r.ext_labels
                    label.set_x(lb, f_railX0())

// Volume-confirmed event flag: an OR crossed this bar above the volume threshold.
bool evBreakVol = vol_conf_en and (evBreakUp or evBreakDn) and volOK

// ──── SECTION 9: KEY LEVEL RENDERING (draw per session, update per bar) ─────
// Key-level label visibility reflects the label mode and each row's Lbl setting.
f_klLblOn(bool lblEn) =>
    kl_lbl_mode == "All on" or (kl_lbl_mode == "Per level" and lblEn)


f_drawKL(line ln, label lb, float price, int triggerBar, bool en, color c, string sty, int w, string nm, bool lblEn, string customTxt, bool pxEn) =>
    if not na(ln)
        line.delete(ln)
    if not na(lb)
        label.delete(lb)
    line newLn = na
    label newLb = na
    if en and not na(price)
        newLn := line.new(f_clampX(kl_left_en and not na(triggerBar) ? triggerBar : sessOpenBar), price, f_lineX2(), price, color = c, style = f_styleOf(sty), width = w, extend = klLineExtend)
        if f_klLblOn(lblEn)
            string nmTxt = customTxt == "" ? nm : customTxt
            newLb := label.new(f_railX1(), price, nmTxt + (pxEn ? " " + str.tostring(price, format.mintick) : ""), style = label.style_label_left, color = color.new(color.black, 100), textcolor = c)
    [newLn, newLb]

f_klTick(line ln, label lb) =>
    // During the session, lines track the live bar and freeze at the close.
    if inSession
        if not na(ln) and kl_extend == "Session"
            line.set_x2(ln, f_lineX2())
        if not na(lb)
            label.set_x(lb, f_railX1())

// Current-week/month levels develop intraday. Each line and label follows the
// current tracker value as it changes.
f_klMove(line ln, label lb, float price, string nm, string customTxt, bool pxEn) =>
    if not na(price)
        if not na(ln)
            line.set_y1(ln, price)
            line.set_y2(ln, price)
        if not na(lb)
            label.set_y(lb, price)
            label.set_text(lb, (customTxt == "" ? nm : customTxt) + (pxEn ? " " + str.tostring(price, format.mintick) : ""))

var line onh_ln = na
var label onh_lb = na
var line onl_ln = na
var label onl_lb = na
var line pdo_ln = na
var label pdo_lb = na
var line pdh_ln = na
var label pdh_lb = na
var line pdl_ln = na
var label pdl_lb = na
var line pdc_ln = na
var label pdc_lb = na
var line cdo_ln = na
var label cdo_lb = na
var line pmh_ln = na
var label pmh_lb = na
var line pml_ln = na
var label pml_lb = na
var line pwh_ln = na
var label pwh_lb = na
var line pwl_ln = na
var label pwl_lb = na
var line cwh_ln = na
var label cwh_lb = na
var line cwl_ln = na
var label cwl_lb = na
var line pmoh_ln = na
var label pmoh_lb = na
var line pmol_ln = na
var label pmol_lb = na
var line cmoh_ln = na
var label cmoh_lb = na
var line cmol_ln = na
var label cmol_lb = na
var line gap_ln = na
var label gap_lb = na
var box   gap_box   = na
var line  gap_hi_ln = na
var label gap_hi_lb = na
var line  gap_lo_ln = na
var label gap_lo_lb = na
var line  gap_mid_ln = na
var label gap_mid_lb = na
var bool gapUp = false
var bool gapFilled = true
var bool  gapToday   = false
var float gapFillPct = na

if newSession
    [a1, a2] = f_drawKL(onh_ln, onh_lb, kl_on_high, kl_on_high_bar, onh_eff, onh_col, onh_sty, onh_w, "ONH", onh_lbl, onh_txt, onh_px)
    onh_ln := a1
    onh_lb := a2
    [b1, b2] = f_drawKL(onl_ln, onl_lb, kl_on_low, kl_on_low_bar, onl_eff, onl_col, onl_sty, onl_w, "ONL", onl_lbl, onl_txt, onl_px)
    onl_ln := b1
    onl_lb := b2
    [c1, c2] = f_drawKL(pdo_ln, pdo_lb, kl_pd_open, kl_pd_open_bar, pdo_eff, pdo_col, pdo_sty, pdo_w, "PDO", pdo_lbl, pdo_txt, pdo_px)
    pdo_ln := c1
    pdo_lb := c2
    [d1, d2] = f_drawKL(pdh_ln, pdh_lb, kl_pd_high, kl_pd_high_bar, pdh_eff, pdh_col, pdh_sty, pdh_w, "PDH", pdh_lbl, pdh_txt, pdh_px)
    pdh_ln := d1
    pdh_lb := d2
    [e1, e2] = f_drawKL(pdl_ln, pdl_lb, kl_pd_low, kl_pd_low_bar, pdl_eff, pdl_col, pdl_sty, pdl_w, "PDL", pdl_lbl, pdl_txt, pdl_px)
    pdl_ln := e1
    pdl_lb := e2
    [g1, g2] = f_drawKL(pdc_ln, pdc_lb, kl_pd_close, kl_pd_close_bar, pdc_eff, pdc_col, pdc_sty, pdc_w, "PDC", pdc_lbl, pdc_txt, pdc_px)
    pdc_ln := g1
    pdc_lb := g2
    [h1, h2] = f_drawKL(cdo_ln, cdo_lb, kl_cd_open, kl_cd_open_bar, cdo_eff, cdo_col, cdo_sty, cdo_w, "OPEN", cdo_lbl, cdo_txt, cdo_px)
    cdo_ln := h1
    cdo_lb := h2
    [i1, i2] = f_drawKL(pmh_ln, pmh_lb, kl_pm_high, kl_pm_high_bar, pmh_eff, pmh_col, pmh_sty, pmh_w, "PMH", pmh_lbl, pmh_txt, pmh_px)
    pmh_ln := i1
    pmh_lb := i2
    [j1, j2] = f_drawKL(pml_ln, pml_lb, kl_pm_low, kl_pm_low_bar, pml_eff, pml_col, pml_sty, pml_w, "PML", pml_lbl, pml_txt, pml_px)
    pml_ln := j1
    pml_lb := j2
    [k1, k2] = f_drawKL(pwh_ln, pwh_lb, kl_pw_high, kl_pw_high_bar, pwh_eff, pwh_col, pwh_sty, pwh_w, "PWH", pwh_lbl, pwh_txt, pwh_px)
    pwh_ln := k1
    pwh_lb := k2
    [m1, m2] = f_drawKL(pwl_ln, pwl_lb, kl_pw_low, kl_pw_low_bar, pwl_eff, pwl_col, pwl_sty, pwl_w, "PWL", pwl_lbl, pwl_txt, pwl_px)
    pwl_ln := m1
    pwl_lb := m2
    // Current-week/month levels are seeded from live trackers; f_klMove updates
    // them on later bars.
    [o1, o2] = f_drawKL(cwh_ln, cwh_lb, wHiTrk, wHiTrkBar, cwh_eff, cwh_col, cwh_sty, cwh_w, "CWH", cwh_lbl, cwh_txt, cwh_px)
    cwh_ln := o1
    cwh_lb := o2
    [p1, p2] = f_drawKL(cwl_ln, cwl_lb, wLoTrk, wLoTrkBar, cwl_eff, cwl_col, cwl_sty, cwl_w, "CWL", cwl_lbl, cwl_txt, cwl_px)
    cwl_ln := p1
    cwl_lb := p2
    [q1, q2] = f_drawKL(pmoh_ln, pmoh_lb, kl_pmo_high, kl_pmo_high_bar, pmoh_eff, pmoh_col, pmoh_sty, pmoh_w, "PMoH", pmoh_lbl, pmoh_txt, pmoh_px)
    pmoh_ln := q1
    pmoh_lb := q2
    [s1, s2] = f_drawKL(pmol_ln, pmol_lb, kl_pmo_low, kl_pmo_low_bar, pmol_eff, pmol_col, pmol_sty, pmol_w, "PMoL", pmol_lbl, pmol_txt, pmol_px)
    pmol_ln := s1
    pmol_lb := s2
    [t1, t2] = f_drawKL(cmoh_ln, cmoh_lb, mHiTrk, mHiTrkBar, cmoh_eff, cmoh_col, cmoh_sty, cmoh_w, "CMoH", cmoh_lbl, cmoh_txt, cmoh_px)
    cmoh_ln := t1
    cmoh_lb := t2
    [u1, u2] = f_drawKL(cmol_ln, cmol_lb, mLoTrk, mLoTrkBar, cmol_eff, cmol_col, cmol_sty, cmol_w, "CMoL", cmol_lbl, cmol_txt, cmol_px)
    cmol_ln := u1
    cmol_lb := u2
    // A gap is drawn only when today's open exceeds the minimum gap percentage.
    bool gapExists = not na(kl_cd_open) and not na(kl_pd_close) and kl_pd_close != 0 and math.abs(kl_cd_open - kl_pd_close) / kl_pd_close * 100 >= gap_min_pct
    gapUp      := gapExists and kl_cd_open > kl_pd_close
    gapFilled  := not gapExists
    gapToday   := gapExists
    gapFillPct := na
    // Zone drawings are rebuilt at each new session.
    if not na(gap_box)
        box.delete(gap_box)
        gap_box := na
    if not na(gap_hi_ln)
        line.delete(gap_hi_ln)
        gap_hi_ln := na
    if not na(gap_hi_lb)
        label.delete(gap_hi_lb)
        gap_hi_lb := na
    if not na(gap_lo_ln)
        line.delete(gap_lo_ln)
        gap_lo_ln := na
    if not na(gap_lo_lb)
        label.delete(gap_lo_lb)
        gap_lo_lb := na
    // The midpoint is cleared with the other gap drawings so it cannot carry
    // into the new session and continue tracking.
    if not na(gap_mid_ln)
        line.delete(gap_mid_ln)
        gap_mid_ln := na
    if not na(gap_mid_lb)
        label.delete(gap_mid_lb)
        gap_mid_lb := na
    bool gapZone = gap_mode == "Zone"
    [n1, n2] = f_drawKL(gap_ln, gap_lb, kl_pd_close, kl_pd_close_bar, gap_en and gapExists and not gapZone, gap_col, gap_sty, gap_w, "GAP FILL", gap_lbl, gap_txt, gap_px)
    gap_ln := n1
    gap_lb := n2
    // Zone mode shades the gap and draws its high/low boundaries.
    if gap_en and gapExists and gapZone
        float gHi = math.max(kl_cd_open, kl_pd_close)
        float gLo = math.min(kl_cd_open, kl_pd_close)
        gap_box   := box.new(f_clampX(sessOpenBar), gHi, bar_index + 1, gLo, bgcolor = color.new(gap_box_col, 85), border_color = na)
        int gapX1 = f_clampX(kl_left_en and not na(kl_pd_close_bar) ? kl_pd_close_bar : sessOpenBar)
        gap_hi_ln := line.new(gapX1, gHi, f_lineX2(), gHi, color = gap_col, style = f_styleOf(gap_sty), width = gap_w, extend = klLineExtend)
        gap_lo_ln := line.new(gapX1, gLo, f_lineX2(), gLo, color = gap_col, style = f_styleOf(gap_sty), width = gap_w, extend = klLineExtend)
        if gap_mid_en
            float gMid = (gHi + gLo) / 2
            gap_mid_ln := line.new(gapX1, gMid, f_lineX2(), gMid, color = gap_col, style = f_styleOf(gap_sty), width = gap_w, extend = klLineExtend)
        if f_klLblOn(gap_lbl)
            gap_hi_lb := label.new(f_railX2(), gHi, (gap_txt == "" ? "GAP" : gap_txt) + " High" + (gap_px ? " " + str.tostring(gHi, format.mintick) : ""), style = label.style_label_left, color = color.new(color.black, 100), textcolor = gap_col)
            gap_lo_lb := label.new(f_railX2(), gLo, (gap_txt == "" ? "GAP" : gap_txt) + " Low" + (gap_px ? " " + str.tostring(gLo, format.mintick) : ""), style = label.style_label_left, color = color.new(color.black, 100), textcolor = gap_col)
            if gap_mid_en
                float gMid = (gHi + gLo) / 2
                gap_mid_lb := label.new(f_railX2(), gMid, (gap_txt == "" ? "GAP" : gap_txt) + " Mid" + (gap_px ? " " + str.tostring(gMid, format.mintick) : ""), style = label.style_label_left, color = color.new(color.black, 100), textcolor = gap_col)

f_klTick(onh_ln, onh_lb)
f_klTick(onl_ln, onl_lb)
f_klTick(pdo_ln, pdo_lb)
f_klTick(pdh_ln, pdh_lb)
f_klTick(pdl_ln, pdl_lb)
f_klTick(pdc_ln, pdc_lb)
f_klTick(cdo_ln, cdo_lb)
f_klTick(pmh_ln, pmh_lb)
f_klTick(pml_ln, pml_lb)
f_klTick(pwh_ln, pwh_lb)
f_klTick(pwl_ln, pwl_lb)
f_klTick(cwh_ln, cwh_lb)
f_klTick(cwl_ln, cwl_lb)
f_klTick(pmoh_ln, pmoh_lb)
f_klTick(pmol_ln, pmol_lb)
f_klTick(cmoh_ln, cmoh_lb)
f_klTick(cmol_ln, cmol_lb)

// Current-week/month levels follow the developing period extremes.
if inSession
    f_klMove(cwh_ln, cwh_lb, wHiTrk, "CWH", cwh_txt, cwh_px)
    f_klMove(cwl_ln, cwl_lb, wLoTrk, "CWL", cwl_txt, cwl_px)
    f_klMove(cmoh_ln, cmoh_lb, mHiTrk, "CMoH", cmoh_txt, cmoh_px)
    f_klMove(cmol_ln, cmol_lb, mLoTrk, "CMoL", cmol_txt, cmol_px)

// Gap retracement percentage drives the label suffix and dashboard. The fill
// level is the prior-session close.
if gapToday and not gapFilled and inSession
    float gSize = math.abs(kl_cd_open - kl_pd_close)
    if gSize > 0
        float gRetr = gapUp ? kl_cd_open - dLow : dHigh - kl_cd_open
        gapFillPct := math.min(100, math.max(0, gRetr / gSize * 100))
    if gap_fill_dyn and not na(gapFillPct)
        string pctSfx = " · " + str.tostring(gapFillPct, "#") + "% filled"
        if not na(gap_lb)
            label.set_text(gap_lb, (gap_txt == "" ? "GAP FILL" : gap_txt) + (gap_px ? " " + str.tostring(kl_pd_close, format.mintick) : "") + pctSfx)
        label gapTgt = gapUp ? gap_lo_lb : gap_hi_lb
        if not na(gapTgt)
            label.set_text(gapTgt, (gapUp ? (gap_txt == "" ? "GAP" : gap_txt) + " Low" : (gap_txt == "" ? "GAP" : gap_txt) + " High") + (gap_px ? " " + str.tostring(kl_pd_close, format.mintick) : "") + pctSfx)

// When price returns to the prior close, drawings are deleted or relabeled as
// filled according to the selected setting.
if gap_en and not gapFilled and inSession and barstate.isconfirmed
    if (gapUp and low <= kl_pd_close) or (not gapUp and high >= kl_pd_close)
        gapFilled := true
        gapFillPct := 100
        if gap_keep
            // Stop at fill pins the drawings at the fill bar; Extend right keeps
            // them on the label rail.
            string filledTxt = (gap_txt == "" ? "GAP FILLED ✓" : gap_txt + " ✓") + (gap_px ? " " + str.tostring(kl_pd_close, format.mintick) : "")
            if not na(gap_lb)
                label.set_text(gap_lb, filledTxt)
            label gapTgt2 = gapUp ? gap_lo_lb : gap_hi_lb
            if not na(gapTgt2)
                label.set_text(gapTgt2, filledTxt)
            if gapStopAtFill
                if not na(gap_lb)
                    label.set_x(gap_lb, bar_index)
                if not na(gapTgt2)
                    label.set_x(gapTgt2, bar_index)
                label gapOther = gapUp ? gap_hi_lb : gap_lo_lb
                if not na(gapOther)
                    label.set_x(gapOther, bar_index)
                if not na(gap_mid_lb)
                    label.set_x(gap_mid_lb, bar_index)
                if not na(gap_box)
                    box.set_right(gap_box, bar_index + 1)
        else
            if not na(gap_ln)
                line.delete(gap_ln)
                gap_ln := na
            if not na(gap_lb)
                label.delete(gap_lb)
                gap_lb := na
            if not na(gap_box)
                box.delete(gap_box)
                gap_box := na
            if not na(gap_hi_ln)
                line.delete(gap_hi_ln)
                gap_hi_ln := na
            if not na(gap_hi_lb)
                label.delete(gap_hi_lb)
                gap_hi_lb := na
            if not na(gap_lo_ln)
                line.delete(gap_lo_ln)
                gap_lo_ln := na
            if not na(gap_lo_lb)
                label.delete(gap_lo_lb)
                gap_lo_lb := na
            if not na(gap_mid_ln)
                line.delete(gap_mid_ln)
                gap_mid_ln := na
            if not na(gap_mid_lb)
                label.delete(gap_mid_lb)
                gap_mid_lb := na
// For a kept, filled gap, Stop at fill freezes all drawings; Extend right keeps
// them tracking the label rail.
if not (gapFilled and gap_keep and gapStopAtFill)
    f_klTick(gap_ln, gap_lb)
    f_klTick(gap_hi_ln, gap_hi_lb)
    f_klTick(gap_lo_ln, gap_lo_lb)
    f_klTick(gap_mid_ln, gap_mid_lb)
if inSession and not na(gap_box) and not (gapFilled and gap_keep and gapStopAtFill)
    box.set_right(gap_box, bar_index + 1)

// ───────── SECTION 10: KEY LEVEL BREAK / RETEST ENGINE (every bar) ──────────
// The OR state machine is applied to static key levels. A break requires a
// confirmed close crossing the level; a level already cleared at the open stays
// silent until price crosses it again.
var array<KeyLevel> kl_levels    = array.new<KeyLevel>()
var array<label>    kl_ev_labels = array.new<label>()

// Key-level event flags consumed by alert conditions.
bool evKLBreakUp = false
bool evKLBreakDn = false
bool evKLRetestHeld = false
bool evKLRetestFailed = false

f_klEvLabel(KeyLevel kl, string txt, bool aboveBar, string tip) =>
    if kl_ev_en
        label l = label.new(bar_index, kl.price, txt, style = aboveBar ? label.style_label_down : label.style_label_up, color = color.new(kl.col, 20), textcolor = ev_txt_col, tooltip = tip)
        array.push(kl_ev_labels, l)
        if array.size(kl_ev_labels) > MAX_KL_EV_LABELS
            label.delete(array.shift(kl_ev_labels))

f_klRegister(bool en, float price, string nm, string customTxt, color c) =>
    if en and not na(price)
        array.push(kl_levels, KeyLevel.new(name = customTxt == "" ? nm : customTxt, price = price, col = c, side = close > price ? 1 : close < price ? -1 : 0, broke_up = false, broke_dn = false, last_break = "NONE", breakout_bar = na, retest_state = "NONE"))

if newSession
    array.clear(kl_levels)
    while array.size(kl_ev_labels) > 0
        label.delete(array.pop(kl_ev_labels))
    f_klRegister(onh_eff, kl_on_high, "ONH", onh_txt, onh_col)
    f_klRegister(onl_eff, kl_on_low, "ONL", onl_txt, onl_col)
    f_klRegister(pdo_eff, kl_pd_open, "PDO", pdo_txt, pdo_col)
    f_klRegister(pdh_eff, kl_pd_high, "PDH", pdh_txt, pdh_col)
    f_klRegister(pdl_eff, kl_pd_low, "PDL", pdl_txt, pdl_col)
    f_klRegister(pdc_eff, kl_pd_close, "PDC", pdc_txt, pdc_col)
    f_klRegister(cdo_eff, kl_cd_open, "OPEN", cdo_txt, cdo_col)
    f_klRegister(pmh_eff, kl_pm_high, "PMH", pmh_txt, pmh_col)
    f_klRegister(pml_eff, kl_pm_low, "PML", pml_txt, pml_col)
    f_klRegister(pwh_eff, kl_pw_high, "PWH", pwh_txt, pwh_col)
    f_klRegister(pwl_eff, kl_pw_low, "PWL", pwl_txt, pwl_col)
    f_klRegister(pmoh_eff, kl_pmo_high, "PMoH", pmoh_txt, pmoh_col)
    f_klRegister(pmol_eff, kl_pmo_low, "PMoL", pmol_txt, pmol_col)

if barstate.isconfirmed and inSession and array.size(kl_levels) > 0
    float activeTol = retest_tol_type == "Daily ATR" ? retest_tol_val *dAtr : retest_tol_type == "Intraday ATR" ? retest_tol_val* atrVal : retest_tol_val * syminfo.mintick
    float klTol = activeTol
    for kl in kl_levels
        // Retest resolution precedes new-cross detection. A failed retest is
        // itself the opposite crossing, so this order prevents duplicate tags.
        bool resolvedNow = false
        // Key-level crossings use an edge state rather than a latch. A crossing
        // inside the killzone is consumed; only an in-progress retest is reset
        // so it can re-arm after the window closes.
        if inKillzone and kl.retest_state == "TESTING"
            kl.retest_state := "NONE"
        if kl.last_break == "UP" and bar_index > kl.breakout_bar and not inKillzone
            if kl.retest_state == "NONE" and low <= kl.price + klTol
                kl.retest_state := "TESTING"
            if kl.retest_state == "TESTING"
                if close > kl.price
                    kl.retest_state := "HELD"
                    resolvedNow := true
                    f_klEvLabel(kl, kl.name + " RETEST HELD", false, "RETEST — HELD\n• Direction: Break up.\n• Level: " + kl.name + " " + str.tostring(kl.price, format.mintick) + ".\n• Tolerance: ±" + str.tostring(klTol, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + " back above the level.\n• Interpretation: The level acted as support.")
                    evKLRetestHeld := true
                    if dyn_alerts
                        alert("OR+KL " + syminfo.ticker + ": " + kl.name + " retest HELD @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
                else if close < kl.price
                    kl.retest_state := "FAILED"
                    resolvedNow := true
                    f_klEvLabel(kl, kl.name + " RETEST FAILED", true, "RETEST — FAILED\n• Direction: Break up.\n• Level: " + kl.name + " " + str.tostring(kl.price, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + " back below the level.\n• Interpretation: The level did not hold as support.")
                    evKLRetestFailed := true
                    if dyn_alerts
                        alert("OR+KL " + syminfo.ticker + ": " + kl.name + " retest FAILED @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
        if kl.last_break == "DN" and bar_index > kl.breakout_bar and not inKillzone
            if kl.retest_state == "NONE" and high >= kl.price - klTol
                kl.retest_state := "TESTING"
            if kl.retest_state == "TESTING"
                if close < kl.price
                    kl.retest_state := "HELD"
                    resolvedNow := true
                    f_klEvLabel(kl, kl.name + " RETEST HELD", true, "RETEST — HELD\n• Direction: Break down.\n• Level: " + kl.name + " " + str.tostring(kl.price, format.mintick) + ".\n• Tolerance: ±" + str.tostring(klTol, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + " back below the level.\n• Interpretation: The level acted as resistance.")
                    evKLRetestHeld := true
                    if dyn_alerts
                        alert("OR+KL " + syminfo.ticker + ": " + kl.name + " retest HELD @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
                else if close > kl.price
                    kl.retest_state := "FAILED"
                    resolvedNow := true
                    f_klEvLabel(kl, kl.name + " RETEST FAILED", false, "RETEST — FAILED\n• Direction: Break down.\n• Level: " + kl.name + " " + str.tostring(kl.price, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + " back above the level.\n• Interpretation: The level did not hold as resistance.")
                    evKLRetestFailed := true
                    if dyn_alerts
                        alert("OR+KL " + syminfo.ticker + ": " + kl.name + " retest FAILED @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
        // Each crossing is detected once per direction per session.
        int newSide = close > kl.price ? 1 : close < kl.price ? -1 : kl.side
        if not resolvedNow and not inKillzone
            if kl.side == -1 and newSide == 1 and not kl.broke_up
                kl.broke_up     := true
                kl.last_break   := "UP"
                kl.breakout_bar := bar_index
                kl.retest_state := "NONE"
                f_klEvLabel(kl, kl.name + " BREAK ↑", false, kl.name + " BREAK ↑\n• BREAK: Confirmed close crossed above the level.\n• Level: " + str.tostring(kl.price, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + ".")
                evKLBreakUp := true
                if dyn_alerts
                    alert("OR+KL " + syminfo.ticker + ": " + kl.name + " break ↑ @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
            else if kl.side == 1 and newSide == -1 and not kl.broke_dn
                kl.broke_dn     := true
                kl.last_break   := "DN"
                kl.breakout_bar := bar_index
                kl.retest_state := "NONE"
                f_klEvLabel(kl, kl.name + " BREAK ↓", true, kl.name + " BREAK ↓\n• BREAK: Confirmed close crossed below the level.\n• Level: " + str.tostring(kl.price, format.mintick) + ".\n• Close: " + str.tostring(close, format.mintick) + ".")
                evKLBreakDn := true
                if dyn_alerts
                    alert("OR+KL " + syminfo.ticker + ": " + kl.name + " break ↓ @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
        kl.side := newSide

// ────────────────── SECTION 10B: VWAP CALCULATION (before dashboard) ─────────
var float vw1_sumSrcVol = 0.0
var float vw1_sumVol = 0.0
var float vw2_sumSrcVol = 0.0
var float vw2_sumVol = 0.0

if newSession
    vw1_sumSrcVol := 0.0
    vw1_sumVol := 0.0

if not inSession and prevInSession
    vw2_sumSrcVol := 0.0
    vw2_sumVol := 0.0

if vw1_en
    vw1_sumSrcVol += hlc3 * volume
    vw1_sumVol += volume

if vw2_en
    vw2_sumSrcVol += hlc3 * volume
    vw2_sumVol += volume

float vw1_val = vw1_sumVol > 0 ? vw1_sumSrcVol / vw1_sumVol : na
float vw2_val = vw2_sumVol > 0 ? vw2_sumSrcVol / vw2_sumVol : na
float vw3_raw = ta.vwma(close, vw3_len)
float vw3_val = vw3_en ? vw3_raw : na

// ────────────────── SECTION 11: DASHBOARD (last bar only) ───────────────────
f_posOf(string s) =>
    switch s
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

f_sizeOf(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

f_status(OpeningRange r) =>
    string s = "FORMING"
    if not r.locked and not na(sessOpenTime)
        // The countdown uses seconds for sub-minute ranges and during the final
        // two minutes.
        int secsLeft = math.max(0, math.ceil((sessOpenTime + r.dur_sec * 1000 - time) / 1000.0))
        s += " · " + (r.dur_sec % 60 != 0 or secsLeft < 120 ? str.tostring(secsLeft) + "s left" : str.tostring(math.ceil(secsLeft / 60.0)) + "m left")
    if r.locked
        if not r.width_ok
            s := "LOCKED · WIDTH FILTERED"
        else
            s := "LOCKED · INSIDE"
            if r.last_break == "UP"
                s := "BROKE ↑"
            if r.last_break == "DN"
                s := "BROKE ↓"
            if r.retest_state == "TESTING"
                s += " · RETEST"
            if r.retest_state == "HELD"
                s += " · RETEST HELD"
            if r.retest_state == "FAILED"
                s += " · RETEST FAILED"
            if r.ext_hit_100
                s += " · EXT 1.0×"
    // The price range is appended when enabled.
    if dash_prices and r.locked
        s += " (" + str.tostring(r.or_low, format.mintick) + " – " + str.tostring(r.or_high, format.mintick) + ")"
    s

// AMT day type applies only to a locked, width-valid 60-minute IB. Both sides
// extended = Neutral; one side = Trend; neither side = Normal.
f_dayType(OpeningRange r) =>
    not r.locked or not r.width_ok or r.dur_sec != 3600 ? "" : r.broke_up and r.broke_dn ? "NEUTRAL DAY" : r.broke_up ? "TREND ↑" : r.broke_dn ? "TREND ↓" : "NORMAL DAY"

// Break direction, retest state, and day type use separate table cells so each
// component can have its own text and color.
f_orBreakText(OpeningRange r) =>
    string s = "FORMING"
    if not r.locked and not na(sessOpenTime)
        int secsLeft = math.max(0, math.ceil((sessOpenTime + r.dur_sec * 1000 - time) / 1000.0))
        s += " · " + (r.dur_sec % 60 != 0 or secsLeft < 120 ? str.tostring(secsLeft) + "s left" : str.tostring(math.ceil(secsLeft / 60.0)) + "m left")
    if r.locked
        if not r.width_ok
            s := "LOCKED · WIDTH FILTERED"
        else
            s := r.last_break == "UP" ? "BROKE ↑" : r.last_break == "DN" ? "BROKE ↓" : "LOCKED · INSIDE"
    s

f_retestText(string retestState) =>
    retestState == "TESTING" ? "· RETEST" : retestState == "HELD" ? "· RETEST HELD" : retestState == "FAILED" ? "· RETEST FAILED" : ""

f_trendText(string dayT) =>
    dayT == "" ? "· N/A" : "· " + dayT

f_orDetails(OpeningRange r) =>
    string s = r.ext_hit_100 ? "EXT 1.0×" : ""
    if dash_prices and r.locked
        s += (s == "" ? "" : " · ") + "(" + str.tostring(r.or_low, format.mintick) + " – " + str.tostring(r.or_high, format.mintick) + ")"
    s

f_klDetails(KeyLevel kl) =>
    dash_prices ? "(" + str.tostring(kl.price, format.mintick) + ")" : ""

f_directionColor(string direction) =>
    dash_color_mode == "Neutral" ? color.white : direction == "UP" ? color.green : direction == "DN" ? color.red : color.white

f_retestColor(string retestState) =>
    dash_color_mode == "Neutral" ? color.white : retestState == "TESTING" ? color.yellow : retestState == "HELD" ? color.green : retestState == "FAILED" ? color.red : color.white

f_trendColor(string dayT) =>
    dash_color_mode == "Neutral" ? color.white : dayT == "" ? color.gray : dayT == "TREND ↑" ? color.green : dayT == "TREND ↓" ? color.red : color.white

f_orBreakColor(OpeningRange r) =>
    color c = r.locked and not r.width_ok ? color.gray : f_directionColor(r.last_break)
    dash_color_mode == "Neutral" ? color.white : c

f_klStatus(KeyLevel kl) =>
    string s = kl.last_break == "UP" ? "BROKE ↑" : "BROKE ↓"
    if kl.retest_state == "TESTING"
        s += " · RETEST"
    if kl.retest_state == "HELD"
        s += " · RETEST HELD"
    if kl.retest_state == "FAILED"
        s += " · RETEST FAILED"
    // The price is appended when enabled.
    if dash_prices
        s += " (" + str.tostring(kl.price, format.mintick) + ")"
    s

f_klTooltip(KeyLevel kl) =>
    kl.name + " " + str.tostring(kl.price, format.mintick) + "\n• BREAK: Confirmed close crossing the level.\n• RETEST: Uses the same tolerance as the OR engine.\n• COLOR: Break up is green; break down is red; RETEST HELD is green; RETEST FAILED is red.\n• TREND: Not applicable to individual key levels; the dashboard shows N/A.\n• STATUS: " + f_klStatus(kl)

f_biasTooltip(string biasText) =>
    "BIAS\n• OR position: Compares the current close with the longest enabled OR.\n• Above OR: Bullish imbalance.\n• Inside OR: Balance/Rotation.\n• Below OR: Bearish imbalance.\n• Color: Matches the longest OR's post-retest directional bias in Directional mode; Neutral mode uses white.\n• Gap: Compares today's open with the prior day close; fill status is shown when available.\n• VWAP: Adds the intraday VWAP when enabled and available.\n• Current Read: " + biasText

// BIAS color reflects the current post-retest direction. Upward context is
// green, downward context is red, and an unresolved retest is yellow.
f_biasColor(string lastBreak, string retestState) =>
    bool up = lastBreak == "UP"
    retestState == "TESTING" ? color.yellow : retestState == "FAILED" ? (up ? color.red : color.green) : up ? color.green : color.red

f_statusColor(OpeningRange r) =>
    color c = color.white
    if r.locked and not r.width_ok
        c := color.gray
    else if r.locked and r.last_break != "NONE"
        c := f_biasColor(r.last_break, r.retest_state)
    // Neutral mode overrides directional coloring here.
    if dash_color_mode == "Neutral"
        c := color.white
    c

var table dash = na
if show_dash and barstate.islast
    string tsz = f_sizeOf(dash_size)
    // Unavailable inputs are reported without stopping the dashboard.
    string notice1 = tfTooBig ? "Chart TF too large for " + f_durTag(shortestDur) + " OR — range approximated" : tfUneven ? "Chart TF does not divide " + f_durTag(shortestDur) + " OR window evenly" : ""
    string notice2 = (onh_eff or onl_eff) and na(kl_on_high) and not na(kl_pd_close) ? "ONH/ONL: no overnight data on this chart" : ""
    int nRanges = array.size(active_ranges)
    // Bias row: position versus the longest OR, opening gap, and VWAP price.
    string biasTxt = ""
    string biasState = ""
    if dash_bias
        if nRanges > 0
            for r in active_ranges
                if r.dur_sec == longestDur
                    biasState := not r.locked ? "OR Forming" : close > r.or_high ? "Above OR" : close < r.or_low ? "Below OR" : "Inside OR"
                    biasTxt := biasState == "Inside OR" ? "Inside OR · Balance/Rotation" : biasState
        if not na(kl_cd_open) and not na(kl_pd_close) and kl_pd_close != 0
            float gapPct = (kl_cd_open - kl_pd_close) / kl_pd_close * 100
            string gapFillTxt = not gapToday ? "" : gapFilled ? " · Filled ✓" : na(gapFillPct) ? "" : " · " + str.tostring(gapFillPct, "#") + "% Filled"
            biasTxt += (biasTxt == "" ? "" : " · ") + "Gap " + (gapPct >= 0 ? "+" : "") + str.tostring(gapPct, "#.##") + "%" + gapFillTxt
        // The VWAP price is added to the bias row when available.
        if vw1_en and not na(vw1_val) and inSession
            biasTxt += " · VWAP " + str.tostring(vw1_val, format.mintick)
        // BIAS text remains consistent in the dashboard.
        biasTxt := str.upper(biasTxt)
    color biasTextCol = color.white
    if dash_bias and nRanges > 0
        for r in active_ranges
            if r.dur_sec == longestDur
                biasTextCol := f_statusColor(r)
    // Dynamic rows are added only for key levels that price has crossed.
    int nBrokenKL = 0
    if dash_kl and array.size(kl_levels) > 0
        for kl in kl_levels
            if kl.last_break != "NONE"
                nBrokenKL += 1
    int nRows   = 1 + math.max(nRanges, 1) + nBrokenKL + (biasTxt == "" ? 0 : 1) + (notice1 == "" ? 0 : 1) + (notice2 == "" ? 0 : 1)
    // The table is rebuilt at the exact size after the prior table is deleted.
    if not na(dash)
        table.delete(dash)
    // Five columns allow independent colors for BREAK, RETEST, TREND, and
    // details; Pine cannot color separate substrings within one cell.
    dash := table.new(f_posOf(dash_pos), 5, nRows, bgcolor = color.new(color.black, 30), border_color = color.gray, border_width = 1)
    table.cell(dash, 0, 0, "LEVEL", text_color = color.white, text_size = tsz, bgcolor = color.new(color.black, 10))
    table.merge_cells(dash, 1, 0, 4, 0)
    table.cell(dash, 1, 0, "STATUS", text_color = color.white, text_size = tsz, bgcolor = color.new(color.black, 10))
    int row = 1
    if nRanges > 0
        for r in active_ranges
            string thN  = f_theoryName(r.dur_sec)
            string dayT = f_dayType(r)
            table.cell(dash, 0, row, str.upper(f_durTag(r.dur_sec)) + (thN == "" ? "" : " · " + str.upper(thN)), text_color = r.col, text_size = tsz, tooltip = f_theoryRules(r.dur_sec))
            table.cell(dash, 1, row, f_orBreakText(r), text_color = f_orBreakColor(r), text_size = tsz)
            table.cell(dash, 2, row, f_retestText(r.retest_state), text_color = f_retestColor(r.retest_state), text_size = tsz)
            table.cell(dash, 3, row, f_trendText(dayT), text_color = f_trendColor(dayT), text_size = tsz)
            table.cell(dash, 4, row, f_orDetails(r), text_color = color.white, text_size = tsz)
            row += 1
    else
        table.cell(dash, 0, row, "", text_size = tsz)
        table.merge_cells(dash, 1, row, 4, row)
        table.cell(dash, 1, row, "No ranges enabled", text_color = color.gray, text_size = tsz)
        row += 1
    // Dashboard order is OR rows, BIAS, then broken key levels.
    if biasTxt != ""
        table.cell(dash, 0, row, "BIAS", text_color = biasTextCol, text_size = tsz, tooltip = f_biasTooltip(biasTxt))
        table.merge_cells(dash, 1, row, 4, row)
        table.cell(dash, 1, row, biasTxt, text_color = biasTextCol, text_size = tsz, tooltip = f_biasTooltip(biasTxt))
        row += 1
    if nBrokenKL > 0
        for kl in kl_levels
            if kl.last_break != "NONE"
                table.cell(dash, 0, row, kl.name, text_color = kl.col, text_size = tsz, tooltip = f_klTooltip(kl))
                table.cell(dash, 1, row, kl.last_break == "UP" ? "BROKE ↑" : "BROKE ↓", text_color = f_directionColor(kl.last_break), text_size = tsz, tooltip = f_klTooltip(kl))
                table.cell(dash, 2, row, f_retestText(kl.retest_state), text_color = f_retestColor(kl.retest_state), text_size = tsz, tooltip = f_klTooltip(kl))
                table.cell(dash, 3, row, f_trendText(""), text_color = f_trendColor(""), text_size = tsz)
                table.cell(dash, 4, row, f_klDetails(kl), text_color = color.white, text_size = tsz)
                row += 1
    if notice1 != ""
        table.cell(dash, 0, row, "⚠", text_color = color.yellow, text_size = tsz)
        table.merge_cells(dash, 1, row, 4, row)
        table.cell(dash, 1, row, notice1, text_color = color.yellow, text_size = tsz)
        row += 1
    if notice2 != ""
        table.cell(dash, 0, row, "⚠", text_color = color.yellow, text_size = tsz)
        table.merge_cells(dash, 1, row, 4, row)
        table.cell(dash, 1, row, notice2, text_color = color.yellow, text_size = tsz)
        row += 1

// ──────────── SECTION 12: RIGHT-EDGE STATUS TAGS (last bar only) ────────────
// One live badge is shown per range beside the last bar. Forming ranges also
// receive a badge so the setting remains useful when a range cannot lock.
var array<label> status_tags = array.new<label>()
if barstate.islast
    while array.size(status_tags) > 0
        label.delete(array.pop(status_tags))
    if f_orLblOn(show_status_tag) and array.size(active_ranges) > 0
        for r in active_ranges
            string thName = f_theoryName(r.dur_sec)
            string txt = f_durTag(r.dur_sec) + (thName == "" ? "" : " [" + thName + "]") + " · " + f_status(r)
            color  bg  = r.retest_state == "TESTING" ? color.yellow : r.retest_state == "HELD" ? color.green : r.retest_state == "FAILED" ? color.red : r.col
            color  tc  = r.retest_state == "TESTING" ? color.black : color.white
            label  lb  = label.new(f_railX0(), r.or_mid, txt, style = label.style_label_left, color = color.new(bg, 20), textcolor = tc, tooltip = f_theoryRules(r.dur_sec))
            array.push(status_tags, lb)

// ────────────────────── SECTION 13: ALERTS (every bar) ──────────────────────
// All conditions are gated by confirmed-bar logic upstream.
alertcondition(evBreakUp, "OR Break Up", "OR+KL: confirmed close above an opening range high")
alertcondition(evBreakDn, "OR Break Down", "OR+KL: confirmed close below an opening range low")
alertcondition(evRetestHeld, "OR Retest Held", "OR+KL: opening range retest resolved HELD")
alertcondition(evRetestFailed, "OR Retest Failed", "OR+KL: opening range retest resolved FAILED")
alertcondition(evExtHit, "OR Extension 1.0x Reached", "OR+KL: price reached the 1.0x opening range extension (touch-based, not close-based)")
alertcondition(evBreakVol, "OR Break Volume-Confirmed", "OR+KL: OR breakout with volume above the confirmation threshold")

// Key-level alert conditions.
alertcondition(evKLBreakUp, "KL Break Up", "OR+KL: confirmed close crossed above a key level")
alertcondition(evKLBreakDn, "KL Break Down", "OR+KL: confirmed close crossed below a key level")
alertcondition(evKLRetestHeld, "KL Retest Held", "OR+KL: key level retest resolved HELD")
alertcondition(evKLRetestFailed, "KL Retest Failed", "OR+KL: key level retest resolved FAILED")

// ─────────────── SECTION 13B: KILLZONE HIGHLIGHT (every bar) ────────────────
// bgcolor covers the pane without a drawing object, so the band remains stable
// across zoom and scale changes.
bgcolor(kz_show and inKillzone ? kz_col : na, title = "Killzone")

// The label is anchored to the window high because Pine does not expose the
// visible price range. It is drawn when the window closes, after its high is known.
var int   kz_start_bar = na
var float kz_run_hi    = na
var array<label> kz_labels = array.new<label>()

if barstate.isconfirmed and kz_show and kz_lbl_en
    if inKillzone and not inKillzone[1]
        kz_start_bar := bar_index
        kz_run_hi    := high
    else if inKillzone
        kz_run_hi := math.max(kz_run_hi, high)
    if not inKillzone and inKillzone[1] and not na(kz_start_bar)
        // Pruning precedes insertion so the label budget remains bounded.
        if array.size(kz_labels) >= MAX_KZ_LABELS
            label.delete(array.shift(kz_labels))
        int kzMid = f_clampX(math.round((kz_start_bar + bar_index - 1) / 2))
        // The label is offset by half an ATR. The minimum-tick fallback covers
        // bars before ATR has warmed up.
        float kzPad = nz(atrVal, syminfo.mintick * 10) * 0.5
        array.push(kz_labels, label.new(kzMid, kz_run_hi + kzPad, "KILL ZONE", style = label.style_none, textcolor = color.new(kz_col, 0), yloc = yloc.price, textalign = text.align_center, tooltip = "KILL ZONE\n• Breakouts and retests are suppressed inside this window.\n• The label is anchored above the window's highest traded price."))
        kz_start_bar := na
        kz_run_hi    := na

// ──────────────────────────── SECTION 14: VWAP PLOTS ─────────────────────────
// Session VWAP display is limited to recent days. The time-based cutoff can
// shift on reload; this changes visibility only, not the calculated values.
bool showVwaps = time > (timenow - (vw_days * 86400000))

// Each VWAP is blanked on its reset bar so plot.style_linebr breaks cleanly. On
// an RTH-only chart there may be no bar between sessions; otherwise the reset
// can render as a vertical jump.
plot(showVwaps and vw1_en and inSession and not newSession ? vw1_val : na, "Intraday VWAP", color=vw1_col, style=vw1_sty == "Solid" ? plot.style_linebr : vw1_sty == "Dashed" ? plot.style_circles : plot.style_cross, linewidth=vw1_w)
plot(showVwaps and vw2_en and not inSession and not prevInSession ? vw2_val : na, "Overnight VWAP", color=vw2_col, style=vw2_sty == "Solid" ? plot.style_linebr : vw2_sty == "Dashed" ? plot.style_circles : plot.style_cross, linewidth=vw2_w)
plot(vw3_en ? vw3_val : na, "Continuous VWMA", color=vw3_col, style=vw3_sty == "Solid" ? plot.style_line : vw3_sty == "Dashed" ? plot.style_circles : plot.style_cross, linewidth=vw3_w)