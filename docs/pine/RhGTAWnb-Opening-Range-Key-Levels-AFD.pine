// Custom label text is parsed once because input values are constant.
f_customTxt(string acr) =>
    string out = ""
    if kl_rename_eff != ""
        // Semicolons and commas are treated as equivalent separators.
        array<string> pairs = str.split(str.replace_all(kl_rename_eff, ";", ","), ",")
        for p in pairs
            array<string> kv = str.split(p, "=")
            if array.size(kv) == 2 and str.trim(array.get(kv, 0)) == acr
                out := str.trim(array.get(kv, 1))
    out

var string onh_txt  = f_customTxt("ONH")
var string onl_txt  = f_customTxt("ONL")
var string pdo_txt  = f_customTxt("PDO")
var string pdh_txt  = f_customTxt("PDH")
var string pdl_txt  = f_customTxt("PDL")
var string pdc_txt  = f_customTxt("PDC")
var string cdo_txt  = f_customTxt("OPEN")
var string pmh_txt  = f_customTxt("PMH")
var string pml_txt  = f_customTxt("PML")
var string pwh_txt  = f_customTxt("PWH")
var string pwl_txt  = f_customTxt("PWL")
var string cwh_txt  = f_customTxt("CWH")
var string cwl_txt  = f_customTxt("CWL")
var string pmoh_txt = f_customTxt("PMoH")
var string pmol_txt = f_customTxt("PMoL")
var string cmoh_txt = f_customTxt("CMoH")
var string cmol_txt = f_customTxt("CMoL")
var string gap_txt  = f_customTxt("GAP")
