int    vw3_w   = input.int(1, "", minval = 1, maxval = 4, group = G8, inline = "vw3", tooltip = "CONTINUOUS VWMA\n• Does not reset.\n• Length sets the SMA length applied to Volume.\n• The enable checkbox controls whether it is plotted.", display = display.none)
int    vw_days = input.int(3, "Show VWAPs for last N days", minval = 1, maxval = 30, group = G8, tooltip = "VWAP DISPLAY WINDOW\n• Hides the session VWAP plots on bars older than this many calendar days.\n• Weekends count, so 3 covers a weekend.\n• Display trim only — the VWAP values themselves are unaffected.\n• The cutoff is measured from the current clock, so the visible window shifts slightly on reload.", display = display.none)

