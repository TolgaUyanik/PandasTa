//@version=6
indicator("Opening Range & Key Levels [AFD]", shorttitle="OR & KL [AFD]", overlay=true, behind_chart=false, max_lines_count=200, max_labels_count=100, max_boxes_count=50)

// ─────────────────────────── SECTION 1: CONSTANTS ───────────────────────────
int MAX_DRAW_LOOKBACK = 4000   // Maximum lookback used for drawing anchors.
int MAX_EV_LABELS     = 8      // Maximum event labels retained per range.
int MAX_KL_EV_LABELS  = 12     // Maximum key-level event labels retained.
int MAX_KZ_LABELS     = 6      // Maximum killzone labels retained, oldest first.

// ──────────────────────────── SECTION 2: INPUTS ─────────────────────────────
// Input groups render in declaration order. G-numbers are stable internal IDs;
// groups with the same header are merged into one settings-panel section.

// ── Quick Start preset ──
string G0 = "⚡ Quick Start"
string preset = input.string("Default", "Preset", options = ["Default", "Minimal", "Full", "Custom"], group = G0, tooltip = "QUICK START PRESET\n• Default = 60m OR + PDH/PDL/PDC key levels — the most common intraday setup.\n• Minimal = 60m OR only, no key levels — clean chart, just the opening range.\n• Full = all 5 OR slots + all 17 key levels + VWAPs — everything on.\n• Custom = use the individual toggles below to build your own setup.\n\n• Default and Minimal use the individual OR toggles, with OR #4 (60m) enabled by default.\n• Full forces all five OR slots on; choose Custom to control every slot.", display = display.none)
bool isCustom = preset == "Custom"

// ── Opening-range slots ──
string G1 = "⏱ Opening Ranges (up to 5 slots)"
bool  r1_en  = input.bool(false, "OR #1:", group = G1, inline = "r1", display = display.none)
int   r1_dur = input.int(5,   "", minval = 1, maxval = 240, group = G1, inline = "r1", display = display.none)
color r1_col = input.color(color.aqua, "", group = G1, inline = "r1", display = display.none)
string r1_sty = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = G1, inline = "r1", display = display.none)
int    r1_w   = input.int(2, "", minval = 1, maxval = 4, group = G1, inline = "r1", tooltip = "OPENING RANGE 1\n• Tracks the high and low of the first N minutes after the session open.\n• Controls: Checkbox = enable; number = window length in minutes; then line color, style, and width.", display = display.none)
bool  r2_en  = input.bool(false, "OR #2:", group = G1, inline = "r2", display = display.none)
int   r2_dur = input.int(15,  "", minval = 1, maxval = 240, group = G1, inline = "r2", display = display.none)
color r2_col = input.color(color.orange, "", group = G1, inline = "r2", display = display.none)
string r2_sty = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = G1, inline = "r2", display = display.none)
int    r2_w   = input.int(2, "", minval = 1, maxval = 4, group = G1, inline = "r2", tooltip = "OPENING RANGE 2\n• A second, independent OR window.\n• Window length defaults to 15 minutes — the Toby opening range.\n• Any range set to exactly 15 minutes is tagged [Toby]; the tag follows the duration, not this slot.\n• Hover the dashboard row or chart label for the full method.\n• Duplicate durations collapse into one range.", display = display.none)
bool  r3_en  = input.bool(false, "OR #3:", group = G1, inline = "r3", display = display.none)
int   r3_dur = input.int(30,  "", minval = 1, maxval = 240, group = G1, inline = "r3", display = display.none)
color r3_col = input.color(color.green, "", group = G1, inline = "r3", display = display.none)
string r3_sty = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = G1, inline = "r3", display = display.none)
int    r3_w   = input.int(2, "", minval = 1, maxval = 4, group = G1, inline = "r3", tooltip = "OPENING RANGE 3\n• A third, independent OR window.\n• Example: Set the window length to 30 minutes.", display = display.none)
bool  r4_en  = input.bool(true, "OR #4:", group = G1, inline = "r4", display = display.none)
int   r4_dur = input.int(60,  "", minval = 1, maxval = 240, group = G1, inline = "r4", display = display.none)
color r4_col = input.color(color.fuchsia, "", group = G1, inline = "r4", display = display.none)
string r4_sty = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = G1, inline = "r4", display = display.none)
int    r4_w   = input.int(2, "", minval = 1, maxval = 4, group = G1, inline = "r4", tooltip = "OPENING RANGE 4\n• Enabled by default with a 60-minute window.\n• The first hour is the Auction Market Theory (AMT) Initial Balance.\n• Any range set to exactly 60 minutes is tagged [AMT IB]; the tag follows the duration, not this slot.\n• At 60 minutes the dashboard also classifies the session's day type from IB extension.\n• Hover the dashboard row or chart label for the full method.", display = display.none)
bool  r5_en  = input.bool(false, "OR sec:", group = G1, inline = "r5", display = display.none)
int   r5_dur = input.int(30,  "", minval = 1, maxval = 3600, group = G1, inline = "r5", display = display.none)
color r5_col = input.color(color.white, "", group = G1, inline = "r5", display = display.none)
string r5_sty = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = G1, inline = "r5", display = display.none)
int    r5_w   = input.int(2, "", minval = 1, maxval = 4, group = G1, inline = "r5", tooltip = "SECONDS OR — window length typed in seconds rather than minutes.\n• Defaults to the first 30 seconds after the open.\n• Needs a seconds chart — e.g. 30S or lower for a 30 second window.\n• On larger timeframes the dashboard shows a warning instead.", display = display.none)

// ── Preset-aware range enables ──
// Default and Minimal retain the 60-minute slot by default. Full enables every
// slot; Custom uses each slot's individual checkbox.
bool r1_eff = preset == "Full" ? true : r1_en
bool r2_eff = preset == "Full" ? true : r2_en
bool r3_eff = preset == "Full" ? true : r3_en
bool r4_eff = preset == "Full" ? true : r4_en
bool r5_eff = preset == "Full" ? true : r5_en

// Durations are stored in seconds so range and timeframe checks use one unit.
int r1_sec = r1_dur *60
int r2_sec = r2_dur* 60
int r3_sec = r3_dur *60
int r4_sec = r4_dur* 60
int r5_sec = r5_dur

// Opening-range extensions; declared after the range inputs for panel order.
string G4 = "📐 Opening Range Extensions"
bool   ext_050_en  = input.bool(false, "Show 0.5×", group = G4, inline = "e05", display = display.none)
color  ext_050_col = input.color(color.gray, "", group = G4, inline = "e05", display = display.none)
string ext_050_sty = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = G4, inline = "e05", display = display.none)
int    ext_050_w   = input.int(1, "", minval = 1, maxval = 4, group = G4, inline = "e05", display = display.none)
bool   ext_050_px  = input.bool(true, "$", group = G4, inline = "e05", tooltip = "EXTENSION 0.5× — measured-move projection lines.\n• Drawn 0.5× the opening range width above the OR high and below the OR low.\n• Controls, left to right: Enable / color / line style / line width / price on-off in the tag.", display = display.none)
bool   ext_100_en  = input.bool(false, "Show 1.0×", group = G4, inline = "e10", display = display.none)
color  ext_100_col = input.color(color.gray, "", group = G4, inline = "e10", display = display.none)
string ext_100_sty = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = G4, inline = "e10", display = display.none)
int    ext_100_w   = input.int(1, "", minval = 1, maxval = 4, group = G4, inline = "e10", display = display.none)
bool   ext_100_px  = input.bool(true, "$", group = G4, inline = "e10", tooltip = "EXTENSION 1.0× — measured-move projection lines drawn one full opening range width beyond the OR.\n• Also drives the 'Extension 1.0× Reached' alert.", display = display.none)
bool   ext_150_en  = input.bool(false, "Show 1.5×", group = G4, inline = "e15", display = display.none)
color  ext_150_col = input.color(color.gray, "", group = G4, inline = "e15", display = display.none)
string ext_150_sty = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = G4, inline = "e15", display = display.none)
int    ext_150_w   = input.int(1, "", minval = 1, maxval = 4, group = G4, inline = "e15", display = display.none)
bool   ext_150_px  = input.bool(true, "$", group = G4, inline = "e15", tooltip = "EXTENSION 1.5×\n• Draws measured-move projection lines 1.5× the opening range width beyond the OR.\n• The enable checkbox controls whether the lines are drawn.", display = display.none)
bool   ext_200_en  = input.bool(false, "Show 2.0×", group = G4, inline = "e20", display = display.none)
color  ext_200_col = input.color(color.gray, "", group = G4, inline = "e20", display = display.none)
string ext_200_sty = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = G4, inline = "e20", display = display.none)
int    ext_200_w   = input.int(1, "", minval = 1, maxval = 4, group = G4, inline = "e20", display = display.none)
bool   ext_200_px  = input.bool(true, "$", group = G4, inline = "e20", tooltip = "EXTENSION 2.0×\n• Draws measured-move projection lines 2.0× the opening range width beyond the OR.\n• The enable checkbox controls whether the lines are drawn.", display = display.none)

// Opening-range display settings.
string G5 = "🎨 Opening Range Visuals"
string or_label_mode = input.string("Per toggle", "OR label mode", options = ["Per toggle", "All on", "All off"], group = G5, tooltip = "OR LABEL MODE — master override for all OR chart labels.\n• Per toggle = each checkbox below decides.\n• All on = show every label type, ignoring the individual toggles.\n• All off = hide every label type.\n• Controls: Event labels, OR/extension tags, price in OR tags, and the right-edge status badge.", display = display.none)
bool show_mid       = input.bool(false, "Show mid line", group = G5, tooltip = "MID LINE\n• Draws a dotted line halfway between each OR high and low.\n• Off by default to keep the chart focused on the range boundaries.", display = display.none)
bool show_range_box = input.bool(true, "Show range boxes", group = G5, tooltip = "RANGE BOXES\n• Shades the area from each opening range's high to its low.\n• One box per enabled OR duration.\n• Shorter windows nest inside longer ones, so overlaps appear darker.", display = display.none)
bool show_ev_labels = input.bool(false, "Show event labels (break/retest)", group = G5, tooltip = "EVENT LABELS\n• Marks confirmed breakout and retest events, such as 'OR BREAK ↑ 5m' or 'RETEST — HELD 15m'.\n• Hover a label for the close price and OR level that decided the event.\n• Off by default to keep the chart clean.", display = display.none)
color ev_txt_col    = input.color(color.black, "Label text", group = G5, inline = "lc", display = display.none)
color ev_bg_col     = input.color(color.gray, "Background", group = G5, inline = "lc", display = display.none)
bool  ev_match_or   = input.bool(true, "Match OR color", group = G5, inline = "lc", tooltip = "EVENT LABEL COLORS\n• Match OR color = each label's background uses its opening range's color, and the Background swatch is ignored.\n• Un-check to use the fixed Background color instead.\n• Label text always uses the Label text color.", display = display.none)
bool show_or_tags   = input.bool(true, "Show OR / extension tags", group = G5, tooltip = "OR AND EXTENSION TAGS\n• Names each OR line, such as 'OR 5m'.\n• Adds labels for enabled extension levels and their prices.\n• Turn off to keep chart labels to a minimum.", display = display.none)
bool or_tag_price   = input.bool(true, "Show price in OR tags", group = G5, tooltip = "PRICE IN OR TAGS\n• Appends the line price to each OR tag, such as 'OR 5m 748.50'.\n• Turn off to show the name only.", display = display.none)
bool show_status_tag = input.bool(false, "Show right-edge status tag", group = G5, tooltip = "RIGHT-EDGE STATUS TAG\n• Shows a live badge at the last bar for each active range.\n• Includes duration, theory tag, and state: Forming / inside / broke / retest.\n• Example: '15m [Toby] · BROKE ↑ · RETEST'.\n• Color: Yellow while testing, green when held, red when failed.\n• One badge per range, anchored at its OR midpoint.\n• Off by default to keep the right edge clear.", display = display.none)
string or_extend    = input.string("Session end", "OR lines stop at", options = ["Session end", "OR window end"], group = G5, tooltip = "WHERE OR LINES STOP\n• Session end = high/low/mid lines and the range box extend across the session and freeze at the close.\n• OR window end = each range's lines and box stop at the end of its own window — e.g. the 5m OR stops 5 minutes after the open.\n• Extension lines always run to the session end regardless of this setting.", display = display.none)

// Key-level settings. Pine cannot nest input groups, so related sections use
// separate group declarations.
string G7 = "🔑 Key Levels"

// ── Key-level presets ──
string kl_preset = input.string("Default acronyms", "Key Level Presets", options = ["Default acronyms", "Full words", "Custom"], group = G7, tooltip = "KEY LEVEL PRESETS — auto-fills the 'Rename levels' field below.\n• Default acronyms = standard short labels (ONH, PDH, PDL, etc.).\n• Full words = descriptive labels (Overnight High, Prior Day High, etc.).\n• Custom = use the 'Rename levels' field to set your own labels.\n\nSwitching presets overrides the Rename levels field; switch to Custom to edit it manually.", display = display.none)

string kl_lbl_mode = input.string("Per level", "Key level labels", options = ["Per level", "All on", "All off"], group = G7, tooltip = "KEY LEVEL LABELS — master override for the name + price tag at the right end of each line.\n• Per level = each row's 'Lbl' checkbox decides.\n• All on = label every enabled level, ignoring the 'Lbl' checkboxes.\n• All off = hide every label.\n• Applies to every key level group below, including the Price GAP lines.", display = display.none)
string kl_extend   = input.string("Session", "Key level extend", options = ["Session", "Right edge"], group = G7, tooltip = "KEY LEVEL EXTEND\n• Session = lines stop at the current bar.\n• Right edge = lines extend across to the chart's right edge.", display = display.none)
bool   kl_left_en  = input.bool(true, "Extend lines left", group = G7, tooltip = "EXTEND LINES LEFT\n• Starts every key level line, including GAP lines, at the beginning of the overnight session before today's open rather than at the open itself.\n• Removes the short line stubs visible right after the open, without running lines across the whole chart.", display = display.none)
int    kl_lbl_off  = input.int(25, "Label offset (bars)", minval = 0, maxval = 499, group = G7, tooltip = "LABEL OFFSET\n• Pushes key level labels, OR/extension tags, and the right-edge status badge this many bars right of the last bar, clearing them off the price action.\n• 0 = labels sit at the right end of their lines.", display = display.none)
bool   kl_line_to_lbl = input.bool(true, "Extend lines to label", group = G7, tooltip = "EXTEND LINES TO LABEL\n• Stretches each line's right end out to its offset label so line and text stay connected.\n• Applies to key levels, GAP lines, OR lines, and extension lines.\n• Off = lines stop at the last bar and only the text moves.", display = display.none)
bool   kl_ev_en    = input.bool(false, "Show key level break labels", group = G7, tooltip = "KEY LEVEL BREAK LABELS — on-chart tags when price crosses a level, e.g. 'PDH BREAK ↑', 'ONH RETEST HELD'.\n• Break = a confirmed close CROSSING the level, not sitting beyond it. A level price already cleared at the open fires nothing until it is re-crossed.\n• Retest uses the same ATR tolerance as the OR engine.\n• Off by default to keep the chart clean — the dashboard's 'Show broken key levels' rows carry the same status.\n• Capped at the 12 most recent labels.", display = display.none)

// ── Key-level preset rename text ──
string kl_preset_rename = kl_preset == "Full words" ? "ONH=Overnight High; ONL=Overnight Low; PDO=Prior Day Open; PDH=Prior Day High; PDL=Prior Day Low; PDC=Prior Day Close; OPEN=Today Open; PMH=Pre-Mkt High; PML=Pre-Mkt Low; PWH=Prior Wk High; PWL=Prior Wk Low; CWH=Cur Wk High; CWL=Cur Wk Low; PMoH=Prior Mo High; PMoL=Prior Mo Low; CMoH=Cur Mo High; CMoL=Cur Mo Low; GAP=Gap Fill" : ""

string kl_rename   = input.string("", "Rename levels", group = G7, tooltip = "RENAME LEVELS — optional custom label text.\n• Format: ACRONYM=New text pairs separated by commas or semicolons.\n• Example: 'PDH=Yesterday High; ORH=Opening Range High; ORL=Opening Range Low'.\n• Valid acronyms: ONH ONL PDO PDH PDL PDC OPEN PMH PML PWH PWL CWH CWL PMoH PMoL CMoH CMoL GAP.\n• Also ORH / ORL for the opening range high/low tags — this replaces their 'OR' prefix only; the duration, theory, and price parts stay.\n• Levels not listed keep their default text.\n• Use the 'Key Level Presets' dropdown above to auto-fill this field.", display = display.none)

// A preset supplies the rename text unless Custom is selected.
string kl_rename_eff = kl_preset == "Custom" ? kl_rename : kl_preset_rename

// Resolved extension style for key-level lines.
string klLineExtend = kl_extend == "Right edge" ? extend.right : extend.none

// Key levels: overnight and current-day references.
string G7D = "🌙 Overnight & Current Day Levels"
bool   onh_en  = input.bool(true, "ONH", group = G7D, inline = "onh", display = display.none)
color  onh_col = input.color(color.purple, "", group = G7D, inline = "onh", display = display.none)
string onh_sty = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], group = G7D, inline = "onh", display = display.none)
int    onh_w   = input.int(1, "", minval = 1, maxval = 4, group = G7D, inline = "onh", display = display.none)
bool   onh_lbl = input.bool(true, "Lbl", group = G7D, inline = "onh", display = display.none)
bool   onh_px  = input.bool(true, "$", group = G7D, inline = "onh", tooltip = "ONH = Overnight High\n• Source: Highest price between the prior exchange session close and today's session open — a literal overnight window, not N trading hours.\n• Requires extended-hours (ETH) data on the chart.\n• Row controls (left to right): Enable · color · line style · line width · label on/off · price on/off.\n• These six controls repeat on every key level row below.", display = display.none)
bool   onl_en  = input.bool(true, "ONL", group = G7D, inline = "onl", display = display.none)
color  onl_col = input.color(color.purple, "", group = G7D, inline = "onl", display = display.none)
string onl_sty = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], group = G7D, inline = "onl", display = display.none)
int    onl_w   = input.int(1, "", minval = 1, maxval = 4, group = G7D, inline = "onl", display = display.none)
bool   onl_lbl = input.bool(true, "Lbl", group = G7D, inline = "onl", display = display.none)
bool   onl_px  = input.bool(true, "$", group = G7D, inline = "onl", tooltip = "ONL = Overnight Low\n• Source: Lowest price between the prior exchange session close and today's session open — a literal overnight window, not N trading hours.\n• Requires extended-hours (ETH) data on the chart.", display = display.none)
bool   pdo_en  = input.bool(true, "PDO", group = G7D, inline = "pdo", display = display.none)
color  pdo_col = input.color(color.gray, "", group = G7D, inline = "pdo", display = display.none)
string pdo_sty = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = G7D, inline = "pdo", display = display.none)
int    pdo_w   = input.int(1, "", minval = 1, maxval = 4, group = G7D, inline = "pdo", display = display.none)
bool   pdo_lbl = input.bool(true, "Lbl", group = G7D, inline = "pdo", display = display.none)
bool   pdo_px  = input.bool(true, "$", group = G7D, inline = "pdo", tooltip = "PDO = Prior Day Open\n• Source: The opening price of the previous exchange session (not 24h, not N trading hours).\n• Snapshot taken at today's session open.", display = display.none)
bool   pdh_en  = input.bool(true, "PDH", group = G7D, inline = "pdh", display = display.none)
color  pdh_col = input.color(color.red, "", group = G7D, inline = "pdh", display = display.none)
string pdh_sty = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = G7D, inline = "pdh", display = display.none)
int    pdh_w   = input.int(2, "", minval = 1, maxval = 4, group = G7D, inline = "pdh", display = display.none)
bool   pdh_lbl = input.bool(true, "Lbl", group = G7D, inline = "pdh", display = display.none)
bool   pdh_px  = input.bool(true, "$", group = G7D, inline = "pdh", tooltip = "PDH = Prior Day High\n• Source: The highest price of the previous exchange session (not 24h, not N trading hours).\n• Snapshot taken at today's session open.", display = display.none)
bool   pdl_en  = input.bool(true, "PDL", group = G7D, inline = "pdl", display = display.none)
color  pdl_col = input.color(color.lime, "", group = G7D, inline = "pdl", display = display.none)
string pdl_sty = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = G7D, inline = "pdl", display = display.none)
int    pdl_w   = input.int(2, "", minval = 1, maxval = 4, group = G7D, inline = "pdl", display = display.none)
bool   pdl_lbl = input.bool(true, "Lbl", group = G7D, inline = "pdl", display = display.none)
bool   pdl_px  = input.bool(true, "$", group = G7D, inline = "pdl", tooltip = "PDL = Prior Day Low\n• Source: The lowest price of the previous exchange session (not 24h, not N trading hours).\n• Snapshot taken at today's session open.", display = display.none)
bool   pdc_en  = input.bool(true, "PDC", group = G7D, inline = "pdc", display = display.none)
color  pdc_col = input.color(color.gray, "", group = G7D, inline = "pdc", display = display.none)
string pdc_sty = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = G7D, inline = "pdc", display = display.none)
int    pdc_w   = input.int(1, "", minval = 1, maxval = 4, group = G7D, inline = "pdc", display = display.none)
bool   pdc_lbl = input.bool(true, "Lbl", group = G7D, inline = "pdc", display = display.none)
bool   pdc_px  = input.bool(true, "$", group = G7D, inline = "pdc", tooltip = "PDC = Prior Day Close\n• Source: The closing price of the previous exchange session (not 24h, not N trading hours).\n• Snapshot taken at today's session open.", display = display.none)
bool   cdo_en  = input.bool(false, "OPEN", group = G7D, inline = "cdo", display = display.none)
color  cdo_col = input.color(color.yellow, "", group = G7D, inline = "cdo", display = display.none)
string cdo_sty = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = G7D, inline = "cdo", display = display.none)
int    cdo_w   = input.int(1, "", minval = 1, maxval = 4, group = G7D, inline = "cdo", display = display.none)
bool   cdo_lbl = input.bool(true, "Lbl", group = G7D, inline = "cdo", display = display.none)
bool   cdo_px  = input.bool(true, "$", group = G7D, inline = "cdo", tooltip = "OPEN = Today's Open\n• Source: The opening price of the current exchange session.\n• Snapshot taken at today's session open; does not update intraday.", display = display.none)
bool   pmh_en  = input.bool(false, "PMH", group = G7D, inline = "pmh", display = display.none)
color  pmh_col = input.color(color.teal, "", group = G7D, inline = "pmh", display = display.none)
string pmh_sty = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], group = G7D, inline = "pmh", display = display.none)
int    pmh_w   = input.int(1, "", minval = 1, maxval = 4, group = G7D, inline = "pmh", display = display.none)
bool   pmh_lbl = input.bool(true, "Lbl", group = G7D, inline = "pmh", display = display.none)
bool   pmh_px  = input.bool(true, "$", group = G7D, inline = "pmh", tooltip = "PMH = Pre-Market High\n• Source: Highest price between midnight and today's session open — a literal calendar window, not N trading hours.\n• Narrower than ONH (ONH starts at the prior session close; PMH starts at midnight).\n• Requires extended-hours (ETH) data on the chart.", display = display.none)
bool   pml_en  = input.bool(false, "PML", group = G7D, inline = "pml", display = display.none)
color  pml_col = input.color(color.teal, "", group = G7D, inline = "pml", display = display.none)
string pml_sty = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], group = G7D, inline = "pml", display = display.none)
int    pml_w   = input.int(1, "", minval = 1, maxval = 4, group = G7D, inline = "pml", display = display.none)
