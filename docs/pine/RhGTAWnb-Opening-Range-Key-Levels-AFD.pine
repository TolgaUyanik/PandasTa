// Key level: opening gap.
string G7G = "⇅ Price GAP"
bool   gap_en  = input.bool(false, "GAP", group = G7G, inline = "gap", display = display.none)
color  gap_col = input.color(color.silver, "", group = G7G, inline = "gap", display = display.none)
string gap_sty = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], group = G7G, inline = "gap", display = display.none)
int    gap_w   = input.int(1, "", minval = 1, maxval = 4, group = G7G, inline = "gap", display = display.none)
bool   gap_lbl = input.bool(true, "Lbl", group = G7G, inline = "gap", display = display.none)
bool   gap_px  = input.bool(true, "$", group = G7G, inline = "gap", tooltip = "GAP FILL\n• Draws the level at the prior day close only when today's open meets the 'Min gap %' threshold.\n• Resolves automatically when price trades back to the prior close.\n• The $ toggle adds the price to the GAP label.", display = display.none)
float  gap_min_pct = input.float(0.1, "Min gap %", minval = 0.0, step = 0.05, group = G7G, inline = "gp2", display = display.none)
bool   gap_keep    = input.bool(false, "Keep after fill", group = G7G, inline = "gp2", tooltip = "GAP DETECTION\n• Min gap % = the smallest open-vs-prior-close distance, as a percentage of the prior close, that counts as a gap.\n• Filters out 1-tick noise gaps that fill within the first bar.\n• Keep after fill = leave the line on the chart relabeled 'GAP FILLED ✓' instead of deleting it.", display = display.none)
string gap_mode     = input.string("Line only", "Display", options = ["Line only", "Zone"], group = G7G, inline = "gp3", display = display.none)
color  gap_box_col  = input.color(color.silver, "", group = G7G, inline = "gp3", tooltip = "GAP DISPLAY MODE\n• Line only = a single line at the prior day close, the level the gap fills back to.\n• Zone = a shaded box across the whole gap, prior day close to today's open, with GAP High / GAP Low boundary lines, like an opening range box.\n• Swatch = zone color.", display = display.none)
bool   gap_mid_en   = input.bool(false, "Show Midpoint", group = G7G, inline = "gp4", tooltip = "GAP MIDPOINT\n• Draws a line at the 50% midpoint of the gap zone.\n• Applies only when Display is set to Zone.", display = display.none)
bool   gap_fill_dyn = input.bool(true, "Show fill %", group = G7G, tooltip = "GAP FILL PERCENTAGE\n• Appends the live percentage to the GAP label.\n• 100% means the gap is filled.\n• Also appears in the dashboard bias row when the dashboard is enabled.", display = display.none)
string gap_after    = input.string("Stop at fill", "After fill", options = ["Stop at fill", "Extend right"], group = G7G, tooltip = "AFTER FILL — only used with 'Keep after fill'.\n• Stop at fill = the kept GAP lines, zone box, and labels freeze at the bar that filled the gap, leaving a historical marker.\n• Extend right = they keep tracking the right edge and label rail for the rest of the session, like every other key level.", display = display.none)
bool   gapStopAtFill = gap_after == "Stop at fill"

// Dashboard settings.
string G6 = "📊 Dashboard"
bool   show_dash = input.bool(false, "Show dashboard", group = G6, tooltip = "DASHBOARD\n• Shows an on-chart status table for each range.\n• Includes forming / locked / broke / retest state and data warnings.\n• Off by default to keep the chart unobstructed.", display = display.none)
string dash_pos  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = G6, tooltip = "DASHBOARD POSITION\n• Selects the chart corner where the dashboard is anchored.\n• Applies when Show dashboard is enabled.", display = display.none)
string dash_size = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G6, tooltip = "DASHBOARD TEXT SIZE\n• Tiny = most compact.\n• Small = default balance.\n• Normal = largest text.", display = display.none)
bool   dash_bias = input.bool(true, "Show bias row", group = G6, tooltip = "BIAS ROW — an extra dashboard row reading price against the longest OR's range.\n• Above OR = bullish imbalance. Inside OR = balance. Below OR = bearish imbalance.\n• Color: Matches the longest OR's post-retest directional bias in Directional mode; Neutral mode uses white.\n• Also shows today's opening gap versus the prior day close.\n• When the GAP level is on, adds its live fill status: % filled, then FILLED ✓.\n• When VWAP is enabled, adds the intraday VWAP price.", display = display.none)
bool   dash_kl   = input.bool(true, "Show broken key levels", group = G6, tooltip = "BROKEN KEY LEVELS — dynamic dashboard rows for levels price has crossed this session.\n• One row per broken level, with its break direction and retest status, e.g. 'PDH — BROKE ↑ · RETEST HELD'.\n• Levels price has not crossed get no row, keeping the table small.\n• Break = a confirmed close crossing the level.\n• Retest uses the same tolerance as the OR engine.", display = display.none)
bool   dash_prices = input.bool(true, "Show prices in dashboard", group = G6, tooltip = "PRICES IN DASHBOARD — appends each range's high/low prices to the details column, e.g. 'BROKE ↑ · RETEST HELD · (512.30 – 508.75)'.\n• Makes the dashboard a self-contained reference without needing to read chart labels.", display = display.none)
string dash_color_mode = input.string("Directional", "Status color mode", options = ["Directional", "Neutral"], group = G6, tooltip = "STATUS COLOR MODE\n• Directional: Broke up / trend up / retest held = green; broke down / trend down / retest failed = red.\n• Retest testing = yellow.\n• Neutral: All status text is white/gray — no directional coloring.\n\nTradingView house rules: This indicator describes what price has done; it does not generate signals or recommendations.", display = display.none)

// Break and retest settings.
string G3 = "⚡ Breakout & Retest"
bool   kz_en       = input.bool(false, "Killzone filter", group = G3, inline = "kz", display = display.none)
string kz_sess     = input.session("1200-1330", "", group = G3, inline = "kz", tooltip = "KILLZONE FILTER — suppresses breakouts and retests during a time window, e.g. the NY lunch lull.\n• Format HHMM-HHMM, read in the symbol's exchange timezone.\n• A break that first occurs inside the window is discarded for the rest of the session, NOT deferred to the window's close. That direction stays unbroken and the range reads LOCKED · INSIDE.\n• A retest in progress is dropped and must re-arm after the window.\n• Needs an intraday chart. On daily or higher timeframes no bar falls inside an intraday window, so the filter does nothing.", display = display.none)
bool   kz_show     = input.bool(false, "Highlight killzone", group = G3, inline = "kzv", display = display.none)
color  kz_col      = input.color(color.new(color.red, 88), "", group = G3, inline = "kzv", display = display.none)
bool   kz_lbl_en   = input.bool(true, "Label", group = G3, inline = "kzv", tooltip = "KILLZONE HIGHLIGHT — shades the chart background across the killzone window.\n• Needs the Killzone filter above to be enabled; this only draws what that filter is already suppressing.\n• Swatch sets the shading color. Use a high transparency (80-95) so candles stay readable.\n• Label adds a 'KILL ZONE' tag centered over each completed window, sitting just above the highest price traded inside it.\n• The label anchors to price, not to the top of the screen — Pine cannot read the visible price range, so a tag pinned to the viewport top is not possible. It stays with the window's own high as you zoom.\n• The label is drawn when the window closes, so the current window gets its tag at the end of the window.", display = display.none)
string retest_tol_type = input.string("Daily ATR", "Retest tolerance", options = ["Daily ATR", "Intraday ATR", "Fixed Ticks"], group = G3, inline = "rt", display = display.none)
float  retest_tol_val  = input.float(0.1, "", minval = 0.0, step = 0.05, group = G3, inline = "rt", tooltip = "HOW BREAKOUT & RETEST WORKS\n• 1) BREAK — a bar CLOSES beyond the OR high (break up) or OR low (break down). Wicks alone never trigger it. The broken level is then watched to see whether it flips roles: Old ceiling to floor, old floor to ceiling.\n• 2) RETEST TOLERANCE — Daily ATR (e.g. 0.1x), Intraday ATR (14-period, e.g. 0.5x), or Fixed Ticks (e.g. 10).\n• 3) VERDICT — The first close while testing decides it.\n• HELD = A close back beyond the level; the level was defended.\n• FAILED = A close back inside the range; price re-entered the range.", display = display.none)
int   atr_len             = input.int(14, "ATR length", minval = 1, group = G3, tooltip = "ATR LENGTH\n• Sets the number of bars used to calculate Average True Range.\n• ATR scales the retest tolerance when Daily ATR or Intraday ATR is selected.", display = display.none)
bool  width_filt_en = input.bool(false, "OR width filter", group = G3, inline = "wf", display = display.none)
float width_min_atr = input.float(0.1, "min ×daily ATR", minval = 0.0, step = 0.05, group = G3, inline = "wf", display = display.none)
float width_max_atr = input.float(1.0, "max ×daily ATR", minval = 0.05, step = 0.1, group = G3, inline = "wf", tooltip = "OR WIDTH FILTER — skips breakout and retest events when the locked OR width falls outside these bounds.\n• Width is measured as a fraction of the 14-day daily ATR, so it is independent of the chart timeframe.\n• Below the minimum the range is narrow relative to recent daily movement; above the maximum it is wide relative to it.\n• Filtered ranges stay on the chart as levels but fire no events, and read 'WIDTH FILTERED' in the dashboard.\n• Needs roughly 2 sessions of chart data to activate.", display = display.none)
bool  vol_conf_en   = input.bool(false, "Volume confirmation", group = G3, inline = "vc", display = display.none)
float vol_conf_mult = input.float(1.5, "× 20-bar avg", minval = 0.5, step = 0.25, group = G3, inline = "vc", tooltip = "VOLUME CONFIRMATION\n• Checks each breakout bar's volume against this multiple of its 20-bar average.\n• Enables the 'OR Break Volume-Confirmed' alert.\n• The on-label 'vol ✓/✗' tag is controlled separately below.", display = display.none)
bool  show_vol_tag  = input.bool(false, "Show volume tag on breakout labels", group = G3, tooltip = "VOLUME TAG\n• Appends 'vol ✓' or 'vol ✗' to OR break labels.\n• Uses the Volume confirmation threshold above.\n• Adds no extra markers.\n• Symbols without volume data always show ✗.", display = display.none)

