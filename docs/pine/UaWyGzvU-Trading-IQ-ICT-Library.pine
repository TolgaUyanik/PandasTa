// @field sessionLow  = low    low of session  // use math.min(silverBullet.sessionLow, low)                    
// @field sessionFVG           if applicable, the FVG created during the session          
// @field sessionFVGdraw       if applicable, draw the FVG created during the session     
// @field bool    traded      = false  whether the current session has been traded                                                  
// @field tp                   tp of trade entered at the session FVG                       
// @field sl                   sl of trade entered at the session FVG          
// @field sessionDraw          optional draw session with box          
// @field sessionDrawLabel     optional label session with label              

export type silverBullet 


    bool    session 
    string  sessionStr
    string  sessionBias
    float   sessionHigh = high
    float   sessionLow  = low 
    float   sessionFVG
    box     sessionFVGdraw
    bool    traded      = false 
    float   tp 
    float   sl
    box     sessionDraw
    label   sessionDrawLabel

