// @type UDT for FVG calcualtions
// @field H high price of user-selected timeframe 
// @field L low price of user-selected timeframe 
// @field direction  FVG direction => "Up" or "Down"
// @field T => time of bar on user-selected timeframe where FVG was created
// @field fvgLabel optional label for FVG
// @field fvgLineTop optional line for top of FVG
// @field fvgLineBot optional line for bottom of FVG
// @field fvgBox     optional box for FVG

export type FVG 

    float  H 
    float  L 
    string direction 
    int    T
    label  fvgLabel
    line   fvgLineTop 
    line   fvgLineBot
    box    fvgBox 
    
// @type quickly pair a line and label together as UDT
// @field lin Line you wish to pair with label
// @field lab Label you wish to pair with line

export type labelLine 

    line  lin 
    label lab 

// @type UDT for order block calculations
// @field orderBlockData array containing order block x and y points   
// @field orderBlockBox   optional order block box
// @field vioCount = 0    violation count of the order block. 0 = Order Block, 1 = Breaker Block
// @field bool        traded = false  False = OB hasn't been traded. True = OB has been traded. This is to limit the number of trades at the order block.
// @field status = "OB"   status == "OB" => Level is order block. status == "BB" => Level is breaker block.
// @field orderBlockLab   options label for the order block / breaker block.

export type orderBlock

    array<float> orderBlockData
    box    orderBlockBox
    int    vioCount = 0
    bool   traded = false
    string status = "OB"
    label  orderBlockLab

