// @type UDT for data storage and drawings associated with the Model 2022 Strategy
// @field mTime               time of the FVG where entry limit order is placed        
// @field mIndex              array index of FVG where entry limit order is placed. This requires an array of FVG data, which is defined above.             
// @field mEntryDistance    the distance of the FVG to the 50% range. M2022 looks for the fvg closest to 50% mark of range.                              
// @field mEntry            the entry price for the most eligible fvg            
// @field fvgHigh           the high point of the eligible fvg              
// @field fvgLow            the low point of the eligible fvg     
// @field longFVGentryBox     long FVG box, used to draw the eligible FVG                           
// @field shortFVGentryBox    short FVG box, used to draw the eligible FVG                    
// @field line50P            line used to mark 50% of the range       
// @field line100P           line used to mark 100% (top) of the range                                
// @field line0P             line used to mark 0% (bottom) of the range        
// @field label50P          label used to mark 50% of the range                                
// @field label100P         label used to mark 100% (top) of the range                                           
// @field label0P           label used to mark 0% (bottom) of the range                       
// @field array <float> sweepData an array containing price points of the liquidity sweep that sets up the model 2022 entry                           

export type m2022 

    int           mTime 
    int           mIndex
    float         mEntryDistance
    float         mEntry
    float         fvgHigh 
    float         fvgLow
    box           longFVGentryBox 
    box           shortFVGentryBox 
    line          line50P
    line          line100P 
    line          line0P
    label         label50P
    label         label100P 
    label         label0P
    array <float> sweepData

// @type UDT for data storage and drawings associated with the Silver Bullet Strategy
