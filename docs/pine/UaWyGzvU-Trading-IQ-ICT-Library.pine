// @type UDT for data storage of historical price points. 
// @field highArr        array containing historical high points        
// @field lowArr         array containing historical low points         
// @field timeArr        array containing historical time points       
// @field logArr         array containing historical log returns      
// @field signArr        array containing historical price directions             
// @field closeArr       array containing historical close points         
// @field binaryTimeArr  array containing historical time points, uses "push" instead of "unshift" to allow for binary search            
// @field binaryCloseArr array containing historical close points, uses "push" instead of "unshift" to allow the correct
// 										  index to be accessed when "binaryTimeArr" is binary searched
// @field binaryOpenArr  array containing historical optn points, uses "push" instead of "unshift" to allow the correct
// 										  index to be accessed when "binaryTimeArr" is binary searched  
// @field atrTFarr       array containing historical user-selected TF atr points                  
// @field openArr        array containing historical open points          

export type necessaryData

    array<float> highArr
    array<float> lowArr
    array<int>   timeArr
    array<float> logArr 
    array<float> signArr 
    array<float> closeArr 
    array<int>   binaryTimeArr 
    array<float> binaryCloseArr 
    array<float> binaryOpenArr
    array<float> atrTFarr 
    array<float> openArr

// @enum enum for user selection of Unicorn Model Trade Exits
// @field sL    swing low exit, whether for profit (short) or loss (long)         	
// @field sH    swing high exit, whether for profit (long) or loss (short)                   
// @field bFVG  long entry stop loss of math.min(FVGbottom/BBbottom)                     
// @field tFVG  short entry stop loss of math.max(FVGtop/BBtop)                       
// @field zero5 fib TP of -0.5            
// @field one5  fib TP of -1                
// @field two5  fib TP of -2          

export enum unicornExits 


    sL    = "Swing Low"
    sH    = "Swing High"
    bFVG  = "FVG/BB Bottom"
    tFVG  = "FVG/BB Top"
    zero5 = "Fib -0.5"
    one5  = "Fib -1"
    two5  = "Fib -2"

