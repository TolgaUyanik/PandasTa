// @type UDT for data storage and drawings associated with the Unicorn Model Strategy
// @field chart.point hPoint  the most recent chart point of the Unicorn Model setup, this is used to draw a polyline showing the setup
// @field chart.point hPoint2 the second most recent chart point of the Unicorn Model setup, this is used to draw a polyline showing the setup          
// @field chart.point hPoint3 the third most recent chart point of the Unicorn Model setup, this is used to draw a polyline showing the setup              
// @field breakerBlock used to draw the breaker block required for the Unicorn Model        
// @field FVG          used to draw the FVG required for the Unicorn model          
// @field topBlock   price of top of breaker block, can be used to detail trade entry          
// @field botBlock   price of bottom of breaker block, can be used to detail trade entry  
// @field startBlock start time of the breaker block, used to set the "left = " param for the box 
// @field includes  used to store the time of the breaker block, or FVG, or the chart point sequence that setup the Unicorn Model.
									// you can reference the data in this array with the ".includes()" function to ensure trades are not entered 
									// more than 1 time at each Unicorn setup                   
// @field entry            // eligible entry price, for longs"math.max(topBlock, FVG.get_top())", 
// 															 for shorts"math.min(botBlock, FVG.get_bottm())"   
// @field tpLine  optional line to mark PT   
// @field tpLabel optional label to mark PT             
// @field slLine  optional line to mark SL          
// @field slLabel optional label to mark SL   

export type unicornModel 

    chart.point hPoint 
    chart.point hPoint2 
    chart.point hPoint3
    box breakerBlock 
    box FVG 
    float topBlock 
    float botBlock 
    int   startBlock 
    array<int> includes
    float entry 
    line tpLine 
    label tpLabel 
    line slLine 
    label slLabel

