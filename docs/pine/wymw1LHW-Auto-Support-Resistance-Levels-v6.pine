//@version=6
indicator("Auto Support & Resistance Levels v6", overlay = true, max_lines_count = 500)

// --- Inputs ---
int leftBars   = input.int(15, title = "Left Lookback Bars", minval = 1, tooltip = "Bars to the left of the pivot")
int rightBars  = input.int(15, title = "Right Lookback Bars", minval = 1, tooltip = "Bars to the right of the pivot")
int maxLevels  = input.int(6,  title = "Max Levels Each", minval = 1, maxval = 20)
int lineWidth  = input.int(2,  title = "Line Width", minval = 1, maxval = 5)

// --- Color Settings ---
color resColor = input.color(color.red, title = "Resistance Line Color")
color supColor = input.color(color.green, title = "Support Line Color")

// --- Pivot Calculation ---
float pHi = ta.pivothigh(high, leftBars, rightBars)
float pLo = ta.pivotlow(low, leftBars, rightBars)

// --- Collections to Track Active Lines ---
var array<line> resLines = array.new<line>()
var array<line> supLines = array.new<line>()

// --- Resistance Logic ---
if not na(pHi)
    // Draw a line starting from the pivot high extending to the right
    line newLine = line.new(
         x1 = bar_index - rightBars, 
         y1 = pHi, 
         x2 = bar_index, 
         y2 = pHi, 
         color = resColor, 
         width = lineWidth, 
         style = line.style_dashed,
         extend = extend.right
     )
    resLines.push(newLine)
    
    // Maintain maximum allowed active lines
    if resLines.size() > maxLevels
        line oldLine = resLines.shift()
        oldLine.delete()

// --- Support Logic ---
if not na(pLo)
    // Draw a line starting from the pivot low extending to the right
    line newLine = line.new(
         x1 = bar_index - rightBars, 
         y1 = pLo, 
         x2 = bar_index, 
         y2 = pLo, 
         color = supColor, 
         width = lineWidth, 
         style = line.style_dashed,
         extend = extend.right
     )
    supLines.push(newLine)
    
    // Maintain maximum allowed active lines
    if supLines.size() > maxLevels
        line oldLine = supLines.shift()
        oldLine.delete()