//@version=6
// ============================================================================
// Fair Value Gaps  ·  v1.0
// ----------------------------------------------------------------------------
// WHAT IT DOES : Detects three-candle fair value gaps (FVG) - a bullish gap
//                when a candle's low sits above the high from two candles
//                back, bearish when its high sits below the low from two
//                candles back - draws each gap as a box that extends right
//                until price returns to it, and handles the fill by your
//                chosen rule (touch, midpoint, or complete fill).
// HOW TO USE   : Any symbol, any timeframe. Raise the ATR height filter to
//                hide insignificant gaps on noisy charts. The optional
//                midpoint line marks 50% of each gap.
// ALERTS       : "Bullish FVG" / "Bearish FVG" on new gaps, and optionally
//                a fill alert when price returns into a gap. All evaluated
//                on bar close. Create the alert with condition "Any alert()
//                function call" and "Once Per Bar Close".
//
// This is a charting tool. It does not predict markets and nothing here is
// financial advice. Test it on your own charts before relying on it.
// ============================================================================
indicator("Fair Value Gaps", overlay=true,
     max_boxes_count=500, max_lines_count=500)

// ---- Inputs: Display -------------------------------------------------------
grpDisp = "Display"
colBull = input.color(color.new(color.teal, 82),   "Bullish gap colour", group=grpDisp)
colBear = input.color(color.new(color.orange, 82), "Bearish gap colour", group=grpDisp)
colDone = input.color(color.new(color.gray, 88),   "Filled gap colour",  group=grpDisp,
     tooltip="Used when 'When filled' is set to Recolour.")
showMid = input.bool(true, "Show midpoint line", group=grpDisp,
     tooltip="Dashed line at 50% of each gap.")

// ---- Inputs: Detection -----------------------------------------------------
grpDet     = "Detection"
minAtrMult = input.float(0.0, "Min gap height (ATR multiple)", minval=0.0, maxval=5.0, step=0.1, group=grpDet,
     tooltip="0 keeps every gap. Raise it to hide small gaps: a gap must be at least this many ATRs tall to be drawn.")
atrLen     = input.int(14, "ATR length (for the height filter)", minval=5, maxval=50, group=grpDet)
maxGaps    = input.int(20, "Max open gaps kept per side", minval=1, maxval=100, group=grpDet,
     tooltip="Only this many unfilled gaps are tracked per side; the oldest are dropped first.")

// ---- Inputs: Fill handling ---------------------------------------------------
grpFill    = "Fill handling"
fillRule   = input.string("Touch", "A gap counts as filled when price ...", group=grpFill,
     options=["Touch", "Reaches midpoint", "Fills completely"],
     tooltip="Touch: any trade back into the gap. Reaches midpoint: price crosses 50% of the gap. Fills completely: price trades through the far edge.")
fillAction = input.string("Recolour", "When filled", group=grpFill, options=["Recolour", "Remove"],
     tooltip="Recolour keeps the gap on the chart in the filled colour, frozen at the fill bar. Remove deletes it.")

// ---- Inputs: Alerts ----------------------------------------------------------
grpAl       = "Alerts"
alertOnNew  = input.bool(true, "Alert on new gaps", group=grpAl,
     tooltip="Fires on the bar close that completes the three-candle pattern.")
alertOnFill = input.bool(false, "Alert when a gap fills", group=grpAl,
     tooltip="Fires on the bar close where price satisfied the fill rule.")

// ---- State -------------------------------------------------------------------
// Active (unfilled) gaps only. Boxes and midlines are parallel arrays kept in
// lockstep: every push/remove touches both (midlines only when enabled).
var box[]  bullBoxes = array.new_box()
var line[] bullMids  = array.new_line()
var box[]  bearBoxes = array.new_box()
var line[] bearMids  = array.new_line()

atr = ta.atr(atrLen)

// ---- Maintain active gaps: extend, detect fills ------------------------------
// Backward while-loop so removal during iteration is safe.
int bi = array.size(bullBoxes) - 1
while bi >= 0
    b    = array.get(bullBoxes, bi)
    gTop = box.get_top(b)
    gBot = box.get_bottom(b)
    gThr = fillRule == "Touch" ? gTop : fillRule == "Reaches midpoint" ? (gTop + gBot) / 2 : gBot
    if low <= gThr
        if fillAction == "Remove"
            box.delete(b)
        else
            box.set_right(b, bar_index)
            box.set_bgcolor(b, colDone)
            box.set_border_color(b, color.new(colDone, 60))
        array.remove(bullBoxes, bi)
        if showMid
            m = array.get(bullMids, bi)
            if fillAction == "Remove"
                line.delete(m)
            else
                line.set_x2(m, bar_index)
                line.set_color(m, color.new(colDone, 40))
            array.remove(bullMids, bi)
        if alertOnFill
            alert("Bullish FVG filled - " + syminfo.ticker + " returned to " + str.tostring(gThr, format.mintick), alert.freq_once_per_bar_close)
    else
        box.set_right(b, bar_index)
        if showMid
            line.set_x2(array.get(bullMids, bi), bar_index)
    bi -= 1

int si = array.size(bearBoxes) - 1
while si >= 0
    b    = array.get(bearBoxes, si)
    gTop = box.get_top(b)
    gBot = box.get_bottom(b)
    gThr = fillRule == "Touch" ? gBot : fillRule == "Reaches midpoint" ? (gTop + gBot) / 2 : gTop
    if high >= gThr
        if fillAction == "Remove"
            box.delete(b)
        else
            box.set_right(b, bar_index)
            box.set_bgcolor(b, colDone)
            box.set_border_color(b, color.new(colDone, 60))
        array.remove(bearBoxes, si)
        if showMid
            m = array.get(bearMids, si)
            if fillAction == "Remove"
                line.delete(m)
            else
                line.set_x2(m, bar_index)
                line.set_color(m, color.new(colDone, 40))
            array.remove(bearMids, si)
        if alertOnFill
            alert("Bearish FVG filled - " + syminfo.ticker + " returned to " + str.tostring(gThr, format.mintick), alert.freq_once_per_bar_close)
    else
        box.set_right(b, bar_index)
        if showMid
            line.set_x2(array.get(bearMids, si), bar_index)
    si -= 1

// ---- Detect new gaps (current bar completes the three-candle pattern) --------
bullHeight   = low - high[2]
bearHeight   = low[2] - high
heightOkBull = minAtrMult == 0.0 ? true : not na(atr) and bullHeight >= atr * minAtrMult
heightOkBear = minAtrMult == 0.0 ? true : not na(atr) and bearHeight >= atr * minAtrMult
newBull      = low > high[2] and heightOkBull
newBear      = high < low[2] and heightOkBear

if newBull
    gTop = low
    gBot = high[2]
    array.push(bullBoxes, box.new(bar_index - 1, gTop, bar_index, gBot, border_color=color.new(colBull, 60), bgcolor=colBull))
    if showMid
        array.push(bullMids, line.new(bar_index - 1, (gTop + gBot) / 2, bar_index, (gTop + gBot) / 2, color=color.new(colBull, 40), style=line.style_dashed))
    if array.size(bullBoxes) > maxGaps
        box.delete(array.shift(bullBoxes))
        if showMid
            line.delete(array.shift(bullMids))
    if alertOnNew
        alert("Bullish FVG - " + syminfo.ticker + "  " + str.tostring(gBot, format.mintick) + " to " + str.tostring(gTop, format.mintick), alert.freq_once_per_bar_close)

if newBear
    gTop = low[2]
    gBot = high
    array.push(bearBoxes, box.new(bar_index - 1, gTop, bar_index, gBot, border_color=color.new(colBear, 60), bgcolor=colBear))
    if showMid
        array.push(bearMids, line.new(bar_index - 1, (gTop + gBot) / 2, bar_index, (gTop + gBot) / 2, color=color.new(colBear, 40), style=line.style_dashed))
    if array.size(bearBoxes) > maxGaps
        box.delete(array.shift(bearBoxes))
        if showMid
            line.delete(array.shift(bearMids))
    if alertOnNew
        alert("Bearish FVG - " + syminfo.ticker + "  " + str.tostring(gBot, format.mintick) + " to " + str.tostring(gTop, format.mintick), alert.freq_once_per_bar_close)
