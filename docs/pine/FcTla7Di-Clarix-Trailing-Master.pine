//@version=6
indicator("Clarix Trailing Master", overlay=true)

// === Inputs ===
entry_price = input.float(3333, "Entry Price")
is_long = input.bool(true, "Trade Type (Checked = Long, Unchecked = Short)")

// ATR Settings
atr_len = input.int(14, "ATR Period")
atr_mult = input.float(2.0, "ATR Multiplier")
use_dynamic_trail = input.bool(true, "Use Dynamic Trailing Stop (ATR based)")
static_trail_distance = input.float(15.0, "Static Trailing Distance (price units)")

// Delay before starting trailing
trail_delay_bars = input.int(2, "Delay (bars) Before Trailing Starts")

// Higher timeframe for ATR
atr_tf = input.timeframe("15", "ATR Timeframe")

// Profit required before activating trailing
profit_to_start_trail = input.float(20.0, "Profit Before Trailing Starts")

// Entry time
entry_year = input.int(2025, "Entry Year")
entry_month = input.int(7, "Entry Month")
entry_day = input.int(25, "Entry Day")
entry_hour = input.int(14, "Entry Hour (24h format)")
entry_minute = input.int(30, "Entry Minute")
entry_time = timestamp(entry_year, entry_month, entry_day, entry_hour, entry_minute)
entry_bar = ta.valuewhen(time == entry_time, bar_index, 0)

// === ATR Calculation ===
atr_raw = ta.atr(atr_len)
atr = request.security(syminfo.tickerid, atr_tf, atr_raw)
trail_distance = use_dynamic_trail ? atr * atr_mult : static_trail_distance

// === Variables ===
var float trail_stop = na
var float highest_price = na
var float lowest_price = na
var bool trail_active = false
var bool trail_stopped = false
var string trail_status_str = "Not Started"

// === Trail activation logic with delay ===
can_start_trailing = (not trail_stopped) and (bar_index >= entry_bar + trail_delay_bars)

if time >= entry_time and can_start_trailing
    if is_long
        highest_price := na(highest_price) ? close : math.max(highest_price, high)
        if close >= entry_price + profit_to_start_trail
            trail_active := true
            trail_status_str := "Active"
            trail_stop := highest_price - trail_distance
    else
        lowest_price := na(lowest_price) ? close : math.min(lowest_price, low)
        if close <= entry_price - profit_to_start_trail
            trail_active := true
            trail_status_str := "Active"
            trail_stop := lowest_price + trail_distance

// === Trail broken logic ===
trail_broken = trail_active and ((is_long and low < trail_stop) or (not is_long and high > trail_stop))

if trail_broken
    trail_active := false
    trail_stop := na
    highest_price := na
    lowest_price := na
    trail_stopped := true
    trail_status_str := "STOP HIT"

// === Alerts ===
alertcondition(trail_broken, title="Trailing Stop Hit", message="Trailing Stop was hit!")

// === Plots ===
plot(trail_active ? trail_stop : na, title="Trailing Stop", color=color.red, linewidth=2)
plotshape(time == entry_time, location=is_long ? location.belowbar : location.abovebar, color=color.yellow, style=shape.labelup, text="ENTRY")
plotshape(trail_broken, location=is_long ? location.abovebar : location.belowbar, color=color.red, style=shape.labeldown, text="STOP HIT")

// === Table ===
var table dashboard = table.new(position.top_right, 2, 7, border_width=1, frame_color=color.gray, frame_width=1)

if bar_index % 1 == 0
    table.cell(dashboard, 0, 0, "Entry Time", text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 1, 0, str.format("{0,date,yyyy-MM-dd HH:mm}", entry_time), text_color=color.yellow, bgcolor=color.black)

    table.cell(dashboard, 0, 1, "Entry Price", text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 1, 1, str.tostring(entry_price), text_color=color.green, bgcolor=color.black)

    table.cell(dashboard, 0, 2, "Trade Type", text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 1, 2, is_long ? "Long" : "Short", text_color=color.blue, bgcolor=color.black)

    table.cell(dashboard, 0, 3, "Trailing Mode", text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 1, 3, use_dynamic_trail ? "Dynamic (ATR)" : "Static", text_color=color.purple, bgcolor=color.black)

    table.cell(dashboard, 0, 4, "Trailing Distance", text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 1, 4, trail_active ? str.tostring(trail_distance, format.mintick) : "Not Active", text_color=color.orange, bgcolor=color.black)

    table.cell(dashboard, 0, 5, "Current Trail Stop", text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 1, 5, trail_active ? str.tostring(trail_stop, format.price) : "N/A", text_color=color.red, bgcolor=color.black)

    table.cell(dashboard, 0, 6, "Trail Status", text_color=color.white, bgcolor=color.gray)
    table.cell(dashboard, 1, 6, trail_status_str, text_color=(trail_status_str == "STOP HIT" ? color.red : color.green), bgcolor=color.black)
