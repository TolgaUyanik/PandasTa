//@version=6

//@description libTF: Find higher/lower TF automatically
// This library to find higher/lower TF from current timeframe(timeframe.period) for Pine Script version6(or higher).
//
//[b]Basic Algorithm[/b]
// Using a timeframe scale Array and timeframe.in_seconds() function to find higher/lower timeframe.
//Return value is na if could not find TF in the timeframe scale.
//The timeframe scale could be changed by the parameter 'scale'(CSV).
//
//[b]How to use[/b]
//1. Set higher/lower TF
// higher()/lower() function returns higher/lower TF.
//Default timeframe scale is "1, 5, 15, 60, 240, 1D, 1M, 3M, 12M". 
// example:
//[pine]
//htf1 = higher()
//htf2 = higher(htf1)
//ltf1 = lower()
//ltf2 = lower(ltf1)
//[/pine]
//
//2. Set higher/lower TF using your timeframe scale
// The timeframe scale could be changed by the parameter.
//example:
//[pine]
//myscale="1,60,1D,1M,12M"
//htf1 = higher(timeframe.period,myscale)
//htf2 = higher(htf1,myscale)
//ltf1 = lower(timeframe.period,myscale)
//ltf2 = lower(ltf1,myscale)
//[/pine]
//
//3. How to use with request.*() function
//na value is set if no higher/lower TF in timeframe scale.
//It returns current timeframe's value, when na value as timeframe parameter in request.*().
//As bellow, if it should be na when timeframe is na.
//example:
//[pine]
//return_value_request_htf1 = na(htf1)?na:request.security(syminfo.tickerid,htf1,timeframe.period)
//return_value_request_ltf1 = na(ltf1)?na:request.security(syminfo.tickerid,ltf1,timeframe.period)
//[/pine]
//
library("libTF")

// @function higher: find higher TF from TF string.
// @param tf default value is timeframe.period.
// @param scale TF scale in CSV. default is "1,5,15,60,240,1D,1W,1M,3M,12M".
// @returns higher TF string.
export higher(string tf=timeframe.period,string scale="1,5,15,60,240,1D,1W,1M,3M,12M")=>
    var tfList=str.split(scale,',')
    var _s=timeframe.in_seconds(tf)
    var string _htf=na
    if not na(tf)
        for _tf in tfList
            if _s<timeframe.in_seconds(_tf)
                _htf:=_tf
                break
    _htf

// @function lower: find lower TF from TF string.
// @param tf default value is timeframe.period.
// @param scale TF scale in CSV. defalut is "1,5,15,60,240,1D,1W,1M,3M,12M".
// @returns lower TF string.
export lower(string tf=timeframe.period,string scale="1,5,15,60,240,1D,1W,1M,3M,12M")=>
    var tfList=str.split(scale,',')
    var _s=timeframe.in_seconds(tf)
    var string _ltf=na
    if not na(tf)
		tfList.reverse()
        for _tf in tfList
            if _s>timeframe.in_seconds(_tf)
                _ltf:=_tf
                break
    _ltf

//
//example:
//

var htf1=higher()
var htf2=higher(htf1)
var htf3=higher(htf2)
var htf4=higher(htf3)
var ltf1=lower()
var ltf2=lower(ltf1)
var ltf3=lower(ltf2)
var ltf4=lower(ltf3)

var t = table.new(position.bottom_center, 100, 100,color.new(color.blue,70),color.new(color.green,20),2,color.new(color.yellow,40),2)
t.cell(4,0,text_color=color.orange)
t.cell_set_text(4,0,'ltf1')
t.cell(3,0,text_color=color.orange)
t.cell_set_text(3,0,'ltf2')
t.cell(2,0,text_color=color.orange)
t.cell_set_text(2,0,'ltf3')
t.cell(1,0,text_color=color.orange)
t.cell_set_text(1,0,'ltf4')

t.cell(9,0,text_color=color.orange)
t.cell_set_text(9,0,'timeframe.period='+str.tostring(timeframe.period))
t.merge_cells(9,0,10,0)

t.cell(11,0,text_color=color.orange)
t.cell_set_text(11,0,'htf1')
t.cell(12,0,text_color=color.orange)
t.cell_set_text(12,0,'htf2')
t.cell(13,0,text_color=color.orange)
t.cell_set_text(13,0,'htf3')
t.cell(14,0,text_color=color.orange)
t.cell_set_text(14,0,'htf4')

t.cell(9,10,text_color=color.orange,bgcolor=color.new(color.white,80))
t.cell_set_text(9,10,'TF scale is default(1,5,15,60,240,1D,1W,1M,3M,12M)')
t.merge_cells(9,10,10,10)

t.cell(9,11,text_color=color.orange)
t.cell_set_text(9,11,'lower()')
t.cell(4,11,text_color=color.orange)
t.cell_set_text(4,11,str.tostring(ltf1))
t.cell(3,11,text_color=color.orange)
t.cell_set_text(3,11,str.tostring(ltf2))
t.cell(2,11,text_color=color.orange)
t.cell_set_text(2,11,str.tostring(ltf3))
t.cell(1,11,text_color=color.orange)
t.cell_set_text(1,11,str.tostring(ltf4))

t.cell(10,11,text_color=color.orange)
t.cell_set_text(10,11,'higher()')
t.cell(11,11,text_color=color.orange)
t.cell_set_text(11,11,str.tostring(htf1))
t.cell(12,11,text_color=color.orange)
t.cell_set_text(12,11,str.tostring(htf2))
t.cell(13,11,text_color=color.orange)
t.cell_set_text(13,11,str.tostring(htf3))
t.cell(14,11,text_color=color.orange)
t.cell_set_text(14,11,str.tostring(htf4))


t.cell(9,12,text_color=color.orange)
t.cell_set_text(9,12,'na(ltf)?na:request.security(syminfo.tickerid,ltf,timeframe.period)')
t.cell(4,12,text_color=color.orange)
t.cell_set_text(4,12,na(ltf1)?na:request.security(syminfo.tickerid,ltf1,timeframe.period))
t.cell(3,12,text_color=color.orange)
t.cell_set_text(3,12,na(ltf2)?na:request.security(syminfo.tickerid,ltf2,timeframe.period))
t.cell(2,12,text_color=color.orange)
t.cell_set_text(2,12,na(ltf3)?na:request.security(syminfo.tickerid,ltf3,timeframe.period))
t.cell(1,12,text_color=color.orange)
t.cell_set_text(1,12,na(ltf4)?na:request.security(syminfo.tickerid,ltf4,timeframe.period))

t.cell(10,12,text_color=color.orange)
t.cell_set_text(10,12,'na(htf)?na:request.security(syminfo.tickerid,htf,timeframe.period)')
t.cell(11,12,text_color=color.orange)
t.cell_set_text(11,12,na(htf1)?na:request.security(syminfo.tickerid,htf1,timeframe.period))
t.cell(12,12,text_color=color.orange)
t.cell_set_text(12,12,na(htf2)?na:request.security(syminfo.tickerid,htf2,timeframe.period))
t.cell(13,12,text_color=color.orange)
t.cell_set_text(13,12,na(htf3)?na:request.security(syminfo.tickerid,htf3,timeframe.period))
t.cell(14,12,text_color=color.orange)
t.cell_set_text(14,12,na(htf4)?na:request.security(syminfo.tickerid,htf4,timeframe.period))

var myscale="1,60,1D,1M,12M"
var myhtf1=higher(timeframe.period,myscale)
var myhtf2=higher(myhtf1,myscale)
var myhtf3=higher(myhtf2,myscale)
var myhtf4=higher(myhtf3,myscale)
var myltf1=lower(timeframe.period,myscale)
var myltf2=lower(myltf1,myscale)
var myltf3=lower(myltf2,myscale)
var myltf4=lower(myltf3,myscale)

t.cell(9,20,text_color=color.orange,bgcolor=color.new(color.white,80))
t.cell_set_text(9,20,'TF scale is changed to myscale('+myscale+')')
t.merge_cells(9,20,10,20)

t.cell(9,21,text_color=color.orange)
t.cell_set_text(9,21,'lower(myscale)')
t.cell(4,21,text_color=color.orange)
t.cell_set_text(4,21,str.tostring(myltf1))
t.cell(3,21,text_color=color.orange)
t.cell_set_text(3,21,str.tostring(myltf2))
t.cell(2,21,text_color=color.orange)
t.cell_set_text(2,21,str.tostring(myltf3))
t.cell(1,21,text_color=color.orange)
t.cell_set_text(1,21,str.tostring(myltf4))

t.cell(10,21,text_color=color.orange)
t.cell_set_text(10,21,'higher(myscale)')
t.cell(11,21,text_color=color.orange)
t.cell_set_text(11,21,str.tostring(myhtf1))
t.cell(12,21,text_color=color.orange)
t.cell_set_text(12,21,str.tostring(myhtf2))
t.cell(13,21,text_color=color.orange)
t.cell_set_text(13,21,str.tostring(myhtf3))
t.cell(14,21,text_color=color.orange)
t.cell_set_text(14,21,str.tostring(myhtf4))

t.cell(9,22,text_color=color.orange)
t.cell_set_text(9,22,'na(ltf)?na:request.security(syminfo.tickerid,ltf,timeframe.period)')
t.cell(4,22,text_color=color.orange)
t.cell_set_text(4,22,na(myltf1)?na:request.security(syminfo.tickerid,myltf1,timeframe.period))
t.cell(3,22,text_color=color.orange)
t.cell_set_text(3,22,na(myltf2)?na:request.security(syminfo.tickerid,myltf2,timeframe.period))
t.cell(2,22,text_color=color.orange)
t.cell_set_text(2,22,na(myltf3)?na:request.security(syminfo.tickerid,myltf3,timeframe.period))
t.cell(1,22,text_color=color.orange)
t.cell_set_text(1,22,na(myltf4)?na:request.security(syminfo.tickerid,myltf4,timeframe.period))

t.cell(10,22,text_color=color.orange)
t.cell_set_text(10,22,'na(htf)?na:request.security(syminfo.tickerid,htf,timeframe.period)')
t.cell(11,22,text_color=color.orange)
t.cell_set_text(11,22,na(myhtf1)?na:request.security(syminfo.tickerid,myhtf1,timeframe.period))
t.cell(12,22,text_color=color.orange)
t.cell_set_text(12,22,na(myhtf2)?na:request.security(syminfo.tickerid,myhtf2,timeframe.period))
t.cell(13,22,text_color=color.orange)
t.cell_set_text(13,22,na(myhtf3)?na:request.security(syminfo.tickerid,myhtf3,timeframe.period))
t.cell(14,22,text_color=color.orange)
t.cell_set_text(14,22,na(myhtf4)?na:request.security(syminfo.tickerid,myhtf4,timeframe.period))
