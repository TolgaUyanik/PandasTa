//@version=6
indicator('Multi-Symbol High Vol + Liquidity + Catalyst Scanner', overlay = false, max_labels_count = 500)

// === User Inputs ===
symbolsList = input.string('AAPL,MSFT,TSLA,NVDA,AMZN,META,GOOG,AMD,BA,DIS', 'Symbols (comma-separated)')
minAvgVol = input.int(1000000, 'Min Avg Volume (30d)')
minATRperc = input.float(2.0, 'Min ATR % of Price')
minDailyChg = input.float(3.0, 'Min Daily % Change')
earningsNear = input.bool(false, 'Earnings Within Window? (Manual Toggle)')

// === Helper Function ===
checkSymbol(sym) =>
    c = request.security(sym, timeframe.period, close)
    cPrev = request.security(sym, timeframe.period, close[1])
    v = request.security(sym, timeframe.period, volume)
    avgVol = ta.sma(v, 30)
    atrPerc = ta.atr(14) / c * 100
    dailyChange = (c - cPrev) / cPrev * 100
    condLiquidity = avgVol > minAvgVol
    condVolatility = atrPerc > minATRperc
    condPriceMove = dailyChange > minDailyChg
    condCatalyst = earningsNear or dailyChange > 5
    condLiquidity and condVolatility and condPriceMove and condCatalyst

// === Main Logic ===
syms = str.split(symbolsList, ',')
qualifying = ''
for i = 0 to array.size(syms) - 1 by 1
    sym = str.trim(array.get(syms, i))
    if checkSymbol(sym)
        qualifying := qualifying + sym + ' '
        qualifying

// === Output ===
plot(na) // no chart plot
var label scanLabel = na
if barstate.islast
    label.delete(scanLabel)
    scanLabel := label.new(bar_index, high, qualifying == '' ? 'No matches' : 'Matches: ' + qualifying, style = label.style_label_down, color = color.green, textcolor = color.white, size = size.large)
    scanLabel

// === Alerts ===
alertcondition(barstate.islast and qualifying != '', title = 'Multi-Symbol High Vol + Liquidity + Catalyst', message = 'Matches: {{qualifying}}')
