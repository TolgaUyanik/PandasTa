//@version=5
indicator("Kassa 30 (dezente Linien mit weiter links gesetzten Labels)", "Kassa 30", true, max_lines_count=50)

// INPUTS
i_time              = input.session     ('0900-0901:1234567', "Kassa", tooltip="Different exchanges will have different time zones so change accordingly.")
i_tz                = input             ("GMT+2", "Timezone")
i_linethick         = input.int         (1, "Thick", 1, 4)

// Farben für dezente Hintergrund-Linien
col_open = color.new(#BBBBBB, 20)
col_30   = color.new(#CCCCCC, 25)
col_70   = color.new(#AAAAAA, 35)
col_90   = color.new(#E0E0E0, 45)

// Abstand für Labels (Millisekunden)
label_offset = 20 * 100000    // 15 Minuten links vom Startpunkt (weiter weg als vorher)

// MISC
kassa               = time              (timeframe.period, i_time, i_tz)
hourtime            = 3 * 60 * 60 * 1000   // Linien auf 3 Stunden begrenzen

// CALC
var float openprice = 0.0
_open = request.security(syminfo.tickerid, timeframe.period, open)
if kassa
    if not kassa[1]
        openprice := _open
    else
        openprice := math.max(_open, openprice)

// OBJECTS
if openprice != openprice[1]
    var line lne = na
    var line lineabove30 = na
    var line linebelow30 = na
    var line lineabove70 = na
    var line linebelow70 = na
    var line lineabove90 = na
    var line linebelow90 = na

    var label label30a = na
    var label label30b = na
    var label label70a = na
    var label label70b = na
    var label label90a = na
    var label label90b = na

    // Open (dezente Linie)
    lne := line.new(kassa, openprice, kassa + hourtime, openprice, xloc.bar_time, extend.none, col_open, line.style_solid, i_linethick)

    // ±30 (gestrichelt, hellgrau)
    lineabove30 := line.new(kassa, openprice+30, kassa + hourtime, openprice+30, xloc.bar_time, extend.none, col_30, line.style_dashed, 1)
    linebelow30 := line.new(kassa, openprice-30, kassa + hourtime, openprice-30, xloc.bar_time, extend.none, col_30, line.style_dashed, 1)

    // ±70 (gepunktet, etwas dunkleres Grau)
    lineabove70 := line.new(kassa, openprice+70, kassa + hourtime, openprice+70, xloc.bar_time, extend.none, col_70, line.style_dotted, 1)
    linebelow70 := line.new(kassa, openprice-70, kassa + hourtime, openprice-70, xloc.bar_time, extend.none, col_70, line.style_dotted, 1)

    // ±90 (gestrichelt, sehr dezent)
    lineabove90 := line.new(kassa, openprice+90, kassa + hourtime, openprice+90, xloc.bar_time, extend.none, col_90, line.style_dashed, 1)
    linebelow90 := line.new(kassa, openprice-90, kassa + hourtime, openprice-90, xloc.bar_time, extend.none, col_90, line.style_dashed, 1)

    // Labels klein, deutlich weiter nach links versetzt
    label30a := label.new(kassa - label_offset, openprice+30, "+30", xloc.bar_time, yloc.price, color=color.new(color.white, 100), textcolor=col_30, style=label.style_label_left, size=size.tiny)
    label30b := label.new(kassa - label_offset, openprice-30, "-30", xloc.bar_time, yloc.price, color=color.new(color.white, 100), textcolor=col_30, style=label.style_label_left, size=size.tiny)
    label70a := label.new(kassa - label_offset, openprice+70, "+70", xloc.bar_time, yloc.price, color=color.new(color.white, 100), textcolor=col_70, style=label.style_label_left, size=size.tiny)
    label70b := label.new(kassa - label_offset, openprice-70, "-70", xloc.bar_time, yloc.price, color=color.new(color.white, 100), textcolor=col_70, style=label.style_label_left, size=size.tiny)
    label90a := label.new(kassa - label_offset, openprice+90, "+90", xloc.bar_time, yloc.price, color=color.new(color.white, 100), textcolor=col_90, style=label.style_label_left, size=size.tiny)
    label90b := label.new(kassa - label_offset, openprice-90, "-90", xloc.bar_time, yloc.price, color=color.new(color.white, 100), textcolor=col_90, style=label.style_label_left, size=size.tiny)
