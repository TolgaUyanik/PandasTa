//@version=6
indicator('MAEM - Volume Suite', overlay = true, max_boxes_count = 100, max_lines_count = 10, max_labels_count = 10)

// ============================================================
// MÓDULO 1: VWAP Anclado (automático)
// ============================================================
anchorType = input.string('Sesión', 'Anclar en', options = ['Sesión', 'Semana', 'Mes', 'Fecha fija'], group = 'MAEM · VWAP Anclado')
fixedDate = input.time(timestamp('2026-01-01 00:00'), 'Fecha fija (si se eligió \'Fecha fija\')', group = 'MAEM · VWAP Anclado')
showBands = input.bool(true, 'Mostrar bandas de desviación estándar', group = 'MAEM · VWAP Anclado')
mult1 = input.float(1.0, 'Multiplicador banda 1', minval = 0.1, step = 0.1, group = 'MAEM · VWAP Anclado')
mult2 = input.float(2.0, 'Multiplicador banda 2', minval = 0.1, step = 0.1, group = 'MAEM · VWAP Anclado')
vwapColor = input.color(#2f5273, 'Color VWAP', group = 'MAEM · VWAP Anclado')

isNewAnchor() =>
    switch anchorType
        'Sesión' => ta.change(time('D')) != 0
        'Semana' => ta.change(time('W')) != 0
        'Mes' => ta.change(time('M')) != 0
        'Fecha fija' => time >= fixedDate and time[1] < fixedDate
        => false

anchor = isNewAnchor()

var float cumPV = 0.0
var float cumV = 0.0
var float cumPV2 = 0.0

src = hlc3

if anchor
    cumPV := 0.0
    cumV := 0.0
    cumPV2 := 0.0
    cumPV2

cumPV := cumPV + src * volume
cumV := cumV + volume
cumPV2 := cumPV2 + volume * math.pow(src, 2)

vwapVal = cumV > 0 ? cumPV / cumV : na
variance = cumV > 0 ? math.max(cumPV2 / cumV - math.pow(vwapVal, 2), 0) : na
stdev = math.sqrt(variance)

plot(vwapVal, 'AVWAP', color = vwapColor, linewidth = 2)
upper1 = showBands ? vwapVal + mult1 * stdev : na
lower1 = showBands ? vwapVal - mult1 * stdev : na
upper2 = showBands ? vwapVal + mult2 * stdev : na
lower2 = showBands ? vwapVal - mult2 * stdev : na
plot(upper1, 'Banda +1', color = color.new(vwapColor, 60))
plot(lower1, 'Banda -1', color = color.new(vwapColor, 60))
plot(upper2, 'Banda +2', color = color.new(vwapColor, 75))
plot(lower2, 'Banda -2', color = color.new(vwapColor, 75))

// ============================================================
// MÓDULO 2: Perfil de Volumen (aproximado) — POC / VAH / VAL
// ============================================================
// Aproximación: distribuye el volumen de cada vela uniformemente entre su
// high/low, no es un perfil real intra-vela. TradingView trae Volume Profile
// nativo (herramienta de dibujo) con POC/VAH/VAL exactos — úsalo como
// referencia principal. Este módulo sirve para tener el nivel como dato
// programable (ej. alertas sobre el POC).
enableVolProfile = input.bool(true, 'Activar Perfil de Volumen', group = 'MAEM · Perfil de Volumen')
vpLookback = input.int(300, 'Barras hacia atrás (ajusta según tu TF ≈ 1 sesión)', minval = 10, maxval = 2000, group = 'MAEM · Perfil de Volumen')
vpNumBins = input.int(24, 'Niveles de precio', minval = 10, maxval = 60, group = 'MAEM · Perfil de Volumen')
vpVAPct = input.float(70, 'Value Area %', minval = 50, maxval = 95, group = 'MAEM · Perfil de Volumen')
vpMaxBarW = input.int(30, 'Ancho máx. del histograma (barras)', minval = 5, maxval = 100, group = 'MAEM · Perfil de Volumen')
vpBullCol = input.color(color.new(color.teal, 55), 'Color compra', group = 'MAEM · Perfil de Volumen')
vpBearCol = input.color(color.new(color.red, 55), 'Color venta', group = 'MAEM · Perfil de Volumen')
vpPocColor = input.color(#f2c744, 'Color POC', group = 'MAEM · Perfil de Volumen')
vpVAColor = input.color(color.new(color.gray, 30), 'Color VAH/VAL', group = 'MAEM · Perfil de Volumen')

var array<box> vpBoxes = array.new_box()
var line vpPocLine = na
var line vpVahLine = na
var line vpValLine = na
var label vpPocLabel = na

if enableVolProfile and barstate.islast
    if array.size(vpBoxes) > 0
        for i = array.size(vpBoxes) - 1 to 0 by 1
            box.delete(array.get(vpBoxes, i))
    array.clear(vpBoxes)
    line.delete(vpPocLine)
    line.delete(vpVahLine)
    line.delete(vpValLine)
    label.delete(vpPocLabel)

    vpHi = ta.highest(high, vpLookback)
    vpLo = ta.lowest(low, vpLookback)
    vpStep = (vpHi - vpLo) / vpNumBins

    if vpStep > 0
        binBuy = array.new_float(vpNumBins, 0.0)
        binSell = array.new_float(vpNumBins, 0.0)

        for i = 0 to vpLookback - 1 by 1
            barLow = low[i]
            barHigh = high[i]
            barVol = volume[i]
            bull = close[i] >= open[i]
            b0 = math.max(0, math.min(vpNumBins - 1, int((barLow - vpLo) / vpStep)))
            b1 = math.max(0, math.min(vpNumBins - 1, int((barHigh - vpLo) / vpStep)))
            span = math.max(1, b1 - b0 + 1)
            vPer = barVol / span
            for b = b0 to b1 by 1
                if bull
                    array.set(binBuy, b, array.get(binBuy, b) + vPer)
                else
                    array.set(binSell, b, array.get(binSell, b) + vPer)

        maxVol = 0.0
        totalVol = 0.0
        pocIdx = 0
        for b = 0 to vpNumBins - 1 by 1
            v = array.get(binBuy, b) + array.get(binSell, b)
            totalVol := totalVol + v
            if v > maxVol
                maxVol := v
                pocIdx := b
                pocIdx
        pocPrice = vpLo + (pocIdx + 0.5) * vpStep

        sortedVol = array.new_float(vpNumBins, 0.0)
        for b = 0 to vpNumBins - 1 by 1
            array.set(sortedVol, b, array.get(binBuy, b) + array.get(binSell, b))
        array.sort(sortedVol, order.descending)

        target = totalVol * vpVAPct / 100
        acc = 0.0
        cutoff = 0.0
        for b = 0 to vpNumBins - 1 by 1
            acc := acc + array.get(sortedVol, b)
            cutoff := array.get(sortedVol, b)
            if acc >= target
                break

        vah = pocPrice
        val = pocPrice
        for b = 0 to vpNumBins - 1 by 1
            v = array.get(binBuy, b) + array.get(binSell, b)
            if v >= cutoff and v > 0
                px = vpLo + (b + 0.5) * vpStep
                vah := math.max(vah, px)
                val := math.min(val, px)
                val

        for b = 0 to vpNumBins - 1 by 1
            v = array.get(binBuy, b) + array.get(binSell, b)
            if v > 0
                w = math.max(1, int(v / maxVol * vpMaxBarW))
                px = vpLo + (b + 0.5) * vpStep
                buyV = array.get(binBuy, b)
                col = buyV >= v - buyV ? vpBullCol : vpBearCol
                array.push(vpBoxes, box.new(bar_index - w, px + vpStep / 2, bar_index, px - vpStep / 2, border_color = na, bgcolor = col))

        vpPocLine := line.new(bar_index - vpMaxBarW - 2, pocPrice, bar_index, pocPrice, color = vpPocColor, width = 2)
        vpPocLabel := label.new(bar_index, pocPrice, 'POC ' + str.tostring(pocPrice, format.mintick), style = label.style_label_left, color = color.new(vpPocColor, 0), textcolor = color.black, size = size.tiny)
        vpVahLine := line.new(bar_index - vpMaxBarW - 2, vah, bar_index, vah, color = vpVAColor, style = line.style_dotted)
        vpValLine := line.new(bar_index - vpMaxBarW - 2, val, bar_index, val, color = vpVAColor, style = line.style_dotted)
        vpValLine
