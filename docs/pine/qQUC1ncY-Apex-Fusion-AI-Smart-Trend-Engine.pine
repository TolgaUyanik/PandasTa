//@version=6
strategy("Tomukas A+ SuperTrend EMA MACD Fib Strategy", overlay=true, pyramiding=0, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// INPUTS
emaLen      = input.int(200, "EMA Trend Length")
stAtrLen    = input.int(10, "SuperTrend ATR Length")
stFactor    = input.float(3.0, "SuperTrend Factor")
macdFast    = input.int(12, "MACD Fast")
macdSlow    = input.int(26, "MACD Slow")
macdSignal  = input.int(9, "MACD Signal")
momLen      = input.int(10, "Momentum Length")
volLen      = input.int(20, "Volume MA Length")
pivotLen    = input.int(3, "Fractal Pivot Length")
fibLookback = input.int(80, "Fib Swing Lookback")
atrLen      = input.int(14, "ATR Length")
rr          = input.float(2.0, "Risk Reward")
scoreNeed   = input.int(80, "Minimum Score")

// CORE
ema200 = ta.ema(close, emaLen)
[supertrend, stDir] = ta.supertrend(stFactor, stAtrLen)
[macdLine, signalLine, hist] = ta.macd(close, macdFast, macdSlow, macdSignal)
momentum = close - close[momLen]
volMA = ta.sma(volume, volLen)
atr = ta.atr(atrLen)

// FRACTALS / BOS
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float lastLow = na

if not na(ph)
    lastHigh := ph

if not na(pl)
    lastLow := pl

bullBos = not na(lastHigh) and close > lastHigh
bearBos = not na(lastLow) and close < lastLow

// FIB RANGE
swingHigh = ta.highest(high, fibLookback)
swingLow  = ta.lowest(low, fibLookback)
fibRange = swingHigh - swingLow

longFib618 = swingHigh - fibRange * 0.618
longFib705 = swingHigh - fibRange * 0.705

shortFib618 = swingLow + fibRange * 0.618
shortFib705 = swingLow + fibRange * 0.705

longFibZone = close <= longFib618 and close >= longFib705
shortFibZone = close >= shortFib618 and close <= shortFib705

// VOLUME PROFILE APPROXIMATION
// Real fixed-range volume profile is limited in Pine.
// This uses highest-volume candle price as simple POC proxy.
pocPrice = close[ta.highestbars(volume, fibLookback) * -1]
nearPOC = math.abs(close - pocPrice) <= atr

// CONDITIONS
emaBull = close > ema200
emaBear = close < ema200

stBull = stDir < 0
stBear = stDir > 0

macdBull = macdLine > signalLine and hist > hist[1]
macdBear = macdLine < signalLine and hist < hist[1]

momBull = momentum > 0
momBear = momentum < 0

volSpike = volume > volMA * 1.2

// SCORE SYSTEM
longScore = 0
longScore += emaBull ? 20 : 0
longScore += stBull ? 15 : 0
longScore += volSpike ? 15 : 0
longScore += macdBull ? 10 : 0
longScore += momBull ? 10 : 0
longScore += bullBos ? 15 : 0
longScore += longFibZone ? 10 : 0
longScore += nearPOC ? 5 : 0

shortScore = 0
shortScore += emaBear ? 20 : 0
shortScore += stBear ? 15 : 0
shortScore += volSpike ? 15 : 0
shortScore += macdBear ? 10 : 0
shortScore += momBear ? 10 : 0
shortScore += bearBos ? 15 : 0
shortScore += shortFibZone ? 10 : 0
shortScore += nearPOC ? 5 : 0

// ENTRIES
longEntry = longScore >= scoreNeed
shortEntry = shortScore >= scoreNeed

longSL = close - atr * 1.5
longTP = close + (close - longSL) * rr

shortSL = close + atr * 1.5
shortTP = close - (shortSL - close) * rr

if longEntry
    strategy.entry("A+ Long", strategy.long)
    strategy.exit("Long TP/SL", "A+ Long", stop=longSL, limit=longTP)

if shortEntry
    strategy.entry("A+ Short", strategy.short)
    strategy.exit("Short TP/SL", "A+ Short", stop=shortSL, limit=shortTP)

// PLOTS
plot(ema200, "EMA 200", color=color.orange)
plot(supertrend, "SuperTrend", color=stBull ? color.green : color.red)
plot(pocPrice, "POC Proxy", color=color.purple)

plot(longFib618, "Long Fib 0.618", color=color.new(color.green, 70))
plot(longFib705, "Long Fib 0.705", color=color.new(color.green, 70))
plot(shortFib618, "Short Fib 0.618", color=color.new(color.red, 70))
plot(shortFib705, "Short Fib 0.705", color=color.new(color.red, 70))

plotshape(longEntry, title="A+ Long", style=shape.labelup, text="A+ LONG", location=location.belowbar, color=color.green, textcolor=color.white)
plotshape(shortEntry, title="A+ Short", style=shape.labeldown, text="A+ SHORT", location=location.abovebar, color=color.red, textcolor=color.white)

// DASHBOARD
var table dash = table.new(position.top_right, 2, 3)

if barstate.islast
    table.cell(dash, 0, 0, "Long Score")
    table.cell(dash, 1, 0, str.tostring(longScore))
    table.cell(dash, 0, 1, "Short Score")
    table.cell(dash, 1, 1, str.tostring(shortScore))
    table.cell(dash, 0, 2, "A+ Needed")
    table.cell(dash, 1, 2, str.tostring(scoreNeed))