//@version=5
// @description A library of various color palettes for data visualization
library("ColorPalettes")

//----------------------------------------------------------------------------------------------------------------------
// Sequential

// @function A function to generate the sequential `Reds` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `Reds` palette.
export Reds(int n = 9) =>
	var const color[] Reds3 = array.from(#fee0d2, #fc9272, #de2d26)
	var const color[] Reds4 = array.from(#fee5d9, #fcae91, #fb6a4a, #cb181d)
	var const color[] Reds5 = array.from(#fee5d9, #fcae91, #fb6a4a, #de2d26, #a50f15)
	var const color[] Reds6 = array.from(#fee5d9, #fcbba1, #fc9272, #fb6a4a, #de2d26, #a50f15)
	var const color[] Reds7 = array.from(#fee5d9, #fcbba1, #fc9272, #fb6a4a, #ef3b2c, #cb181d, #99000d)
	var const color[] Reds8 = array.from(#fff5f0, #fee0d2, #fcbba1, #fc9272, #fb6a4a, #ef3b2c, #cb181d, #99000d)
	var const color[] Reds9 = array.from(#fff5f0, #fee0d2, #fcbba1, #fc9272, #fb6a4a, #ef3b2c, #cb181d, #a50f15, #67000d)

	out = switch n
		3 => Reds3
		4 => Reds4
		5 => Reds5
		6 => Reds6
		7 => Reds7
		8 => Reds8
		9 => Reds9
		=> Reds9
	out


// @function A function to generate the sequential `Blues` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `Blues` palette.
export Blues(int n = 9) =>
	var const color[] Blues3 = array.from(#deebf7, #9ecae1, #3182bd)
	var const color[] Blues4 = array.from(#eff3ff, #bdd7e7, #6baed6, #2171b5)
	var const color[] Blues5 = array.from(#eff3ff, #bdd7e7, #6baed6, #3182bd, #08519c)
	var const color[] Blues6 = array.from(#eff3ff, #c6dbef, #9ecae1, #6baed6, #3182bd, #08519c)
	var const color[] Blues7 = array.from(#eff3ff, #c6dbef, #9ecae1, #6baed6, #4292c6, #2171b5, #084594)
	var const color[] Blues8 = array.from(#f7fbff, #deebf7, #c6dbef, #9ecae1, #6baed6, #4292c6, #2171b5, #084594)
	var const color[] Blues9 = array.from(#f7fbff, #deebf7, #c6dbef, #9ecae1, #6baed6, #4292c6, #2171b5, #08519c, #08306b)

	out = switch n
		3 => Blues3
		4 => Blues4
		5 => Blues5
		6 => Blues6
		7 => Blues7
		8 => Blues8
		9 => Blues9
		=> Blues9
	out


// @function A function to generate the sequential `Greens` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `Greens` palette.
export Greens(int n = 9) =>
	var const color[] Greens3 = array.from(#e5f5e0, #a1d99b, #31a354)
	var const color[] Greens4 = array.from(#edf8e9, #bae4b3, #74c476, #238b45)
	var const color[] Greens6 = array.from(#edf8e9, #c7e9c0, #a1d99b, #74c476, #31a354, #006d2c)
	var const color[] Greens5 = array.from(#edf8e9, #bae4b3, #74c476, #31a354, #006d2c)
	var const color[] Greens7 = array.from(#edf8e9, #c7e9c0, #a1d99b, #74c476, #41ab5d, #238b45, #005a32)
	var const color[] Greens8 = array.from(#f7fcf5, #e5f5e0, #c7e9c0, #a1d99b, #74c476, #41ab5d, #238b45, #005a32)
	var const color[] Greens9 = array.from(#f7fcf5, #e5f5e0, #c7e9c0, #a1d99b, #74c476, #41ab5d, #238b45, #006d2c, #00441b)

	out = switch n
		3 => Greens3
		4 => Greens4
		5 => Greens5
		6 => Greens6
		7 => Greens7
		8 => Greens8
		9 => Greens9
		=> Greens9
	out


// @function A function to generate the sequential `Purples` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `Purples` palette.
export Purples(int n = 9) =>
	var const color[] Purples3 = array.from(#efedf5, #bcbddc, #756bb1)
	var const color[] Purples4 = array.from(#f2f0f7, #cbc9e2, #9e9ac8, #6a51a3)
	var const color[] Purples5 = array.from(#f2f0f7, #cbc9e2, #9e9ac8, #756bb1, #54278f)
	var const color[] Purples6 = array.from(#f2f0f7, #dadaeb, #bcbddc, #9e9ac8, #756bb1, #54278f)
	var const color[] Purples7 = array.from(#f2f0f7, #dadaeb, #bcbddc, #9e9ac8, #807dba, #6a51a3, #4a1486)
	var const color[] Purples8 = array.from(#fcfbfd, #efedf5, #dadaeb, #bcbddc, #9e9ac8, #807dba, #6a51a3, #4a1486)
	var const color[] Purples9 = array.from(#fcfbfd, #efedf5, #dadaeb, #bcbddc, #9e9ac8, #807dba, #6a51a3, #54278f, #3f007d)

	out = switch n
		3 => Purples3
		4 => Purples4
		5 => Purples5
		6 => Purples6
		7 => Purples7
		8 => Purples8
		9 => Purples9
		=> Purples9
	out


// @function A function to generate the sequential `Oranges` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
