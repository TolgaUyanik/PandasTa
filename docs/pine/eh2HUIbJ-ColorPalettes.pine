	var const color[] RdBu9 = array.from(#2166ac, #4393c3, #92c5de, #d1e5f0, #f7f7f7, #fddbc7, #f4a582, #d6604d, #b2182b)
	var const color[] RdBu10 = array.from(#053061, #2166ac, #4393c3, #92c5de, #d1e5f0, #fddbc7, #f4a582, #d6604d, #b2182b, #67001f)
