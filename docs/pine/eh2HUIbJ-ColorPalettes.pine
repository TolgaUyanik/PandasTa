	var const color[] RdPu7 = array.from(#7a0177, #ae017e, #dd3497, #f768a1, #fa9fb5, #fcc5c0, #feebe2)
	var const color[] RdPu8 = array.from(#7a0177, #ae017e, #dd3497, #f768a1, #fa9fb5, #fcc5c0, #fde0dd, #fff7f3)
	var const color[] RdPu9 = array.from(#49006a, #7a0177, #ae017e, #dd3497, #f768a1, #fa9fb5, #fcc5c0, #fde0dd, #fff7f3)

	out = switch n
