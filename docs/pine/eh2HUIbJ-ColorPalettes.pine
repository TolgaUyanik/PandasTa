export PRGn(int n = 9) =>
	var const color[] PRGn3 = array.from(#7fbf7b, #f7f7f7, #af8dc3)
	var const color[] PRGn4 = array.from(#008837, #a6dba0, #c2a5cf, #7b3294)
	var const color[] PRGn5 = array.from(#008837, #a6dba0, #f7f7f7, #c2a5cf, #7b3294)
	var const color[] PRGn6 = array.from(#1b7837, #7fbf7b, #d9f0d3, #e7d4e8, #af8dc3, #762a83)
	var const color[] PRGn7 = array.from(#1b7837, #7fbf7b, #d9f0d3, #f7f7f7, #e7d4e8, #af8dc3, #762a83)
	var const color[] PRGn8 = array.from(#1b7837, #5aae61, #a6dba0, #d9f0d3, #e7d4e8, #c2a5cf, #9970ab, #762a83)
	var const color[] PRGn9 = array.from(#1b7837, #5aae61, #a6dba0, #d9f0d3, #f7f7f7, #e7d4e8, #c2a5cf, #9970ab, #762a83)
	var const color[] PRGn10 = array.from(#00441b, #1b7837, #5aae61, #a6dba0, #d9f0d3, #e7d4e8, #c2a5cf, #9970ab, #762a83, #40004b)
	var const color[] PRGn11 = array.from(#00441b, #1b7837, #5aae61, #a6dba0, #d9f0d3, #f7f7f7, #e7d4e8, #c2a5cf, #9970ab, #762a83, #40004b)

	out = switch n
		3 => PRGn3
		4 => PRGn4
		5 => PRGn5
		6 => PRGn6
		7 => PRGn7
		8 => PRGn8
		9 => PRGn9
		10 => PRGn10
		11 => PRGn11
		=> PRGn9
	out


// @function A function to generate the diverging `PuOr` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `PuOr` palette.
export PuOr(int n = 9) =>
	var const color[] PuOr3 = array.from(#998ec3, #f7f7f7, #f1a340)
	var const color[] PuOr4 = array.from(#5e3c99, #b2abd2, #fdb863, #e66101)
	var const color[] PuOr5 = array.from(#5e3c99, #b2abd2, #f7f7f7, #fdb863, #e66101)
	var const color[] PuOr6 = array.from(#542788, #998ec3, #d8daeb, #fee0b6, #f1a340, #b35806)
	var const color[] PuOr7 = array.from(#542788, #998ec3, #d8daeb, #f7f7f7, #fee0b6, #f1a340, #b35806)
	var const color[] PuOr8 = array.from(#542788, #8073ac, #b2abd2, #d8daeb, #fee0b6, #fdb863, #e08214, #b35806)
	var const color[] PuOr9 = array.from(#542788, #8073ac, #b2abd2, #d8daeb, #f7f7f7, #fee0b6, #fdb863, #e08214, #b35806)
	var const color[] PuOr10 = array.from(#2d004b, #542788, #8073ac, #b2abd2, #d8daeb, #fee0b6, #fdb863, #e08214, #b35806, #7f3b08)
	var const color[] PuOr11 = array.from(#2d004b, #542788, #8073ac, #b2abd2, #d8daeb, #f7f7f7, #fee0b6, #fdb863, #e08214, #b35806, #7f3b08)

	out = switch n
