	var const color[] BuPu5 = array.from(#810f7c, #8856a7, #8c96c6, #b3cde3, #edf8fb)
	var const color[] BuPu6 = array.from(#810f7c, #8856a7, #8c96c6, #9ebcda, #bfd3e6, #edf8fb)
	var const color[] BuPu7 = array.from(#6e016b, #88419d, #8c6bb1, #8c96c6, #9ebcda, #bfd3e6, #edf8fb)
	var const color[] BuPu8 = array.from(#6e016b, #88419d, #8c6bb1, #8c96c6, #9ebcda, #bfd3e6, #e0ecf4, #f7fcfd)
	var const color[] BuPu9 = array.from(#4d004b, #810f7c, #88419d, #8c6bb1, #8c96c6, #9ebcda, #bfd3e6, #e0ecf4, #f7fcfd)

	out = switch n
		3 => BuPu3
		4 => BuPu4
		5 => BuPu5
		6 => BuPu6
		7 => BuPu7
		8 => BuPu8
		9 => BuPu9
		=> BuPu9
	out


