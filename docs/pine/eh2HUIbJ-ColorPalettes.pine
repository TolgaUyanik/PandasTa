// @function A function to generate the sequential `PuRd` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `PuRd` palette.
export PuRd(int n = 9) =>
	var const color[] PuRd3 = array.from(#dd1c77, #c994c7, #e7e1ef)
	var const color[] PuRd4 = array.from(#ce1256, #df65b0, #d7b5d8, #f1eef6)
	var const color[] PuRd5 = array.from(#980043, #dd1c77, #df65b0, #d7b5d8, #f1eef6)
	var const color[] PuRd6 = array.from(#980043, #dd1c77, #df65b0, #c994c7, #d4b9da, #f1eef6)
	var const color[] PuRd7 = array.from(#91003f, #ce1256, #e7298a, #df65b0, #c994c7, #d4b9da, #f1eef6)
	var const color[] PuRd8 = array.from(#91003f, #ce1256, #e7298a, #df65b0, #c994c7, #d4b9da, #e7e1ef, #f7f4f9)
	var const color[] PuRd9 = array.from(#67001f, #980043, #ce1256, #e7298a, #df65b0, #c994c7, #d4b9da, #e7e1ef, #f7f4f9)

	out = switch n
		3 => PuRd3
		4 => PuRd4
		5 => PuRd5
		6 => PuRd6
		7 => PuRd7
		8 => PuRd8
		9 => PuRd9
		=> PuRd9
	out


