export Oranges(int n = 9) =>
	var const color[] Oranges3 = array.from(#fee6ce, #fdae6b, #e6550d)
	var const color[] Oranges4 = array.from(#feedde, #fdbe85, #fd8d3c, #d94701)
	var const color[] Oranges5 = array.from(#feedde, #fdbe85, #fd8d3c, #e6550d, #a63603)
	var const color[] Oranges6 = array.from(#feedde, #fdd0a2, #fdae6b, #fd8d3c, #e6550d, #a63603)
	var const color[] Oranges7 = array.from(#feedde, #fdd0a2, #fdae6b, #fd8d3c, #f16913, #d94801, #8c2d04)
	var const color[] Oranges8 = array.from(#fff5eb, #fee6ce, #fdd0a2, #fdae6b, #fd8d3c, #f16913, #d94801, #8c2d04)
	var const color[] Oranges9 = array.from(#fff5eb, #fee6ce, #fdd0a2, #fdae6b, #fd8d3c, #f16913, #d94801, #a63603, #7f2704)

	out = switch n
		3 => Oranges3
		4 => Oranges4
		5 => Oranges5
		6 => Oranges6
		7 => Oranges7
		8 => Oranges8
		9 => Oranges9
		=> Oranges9
	out


// @function A function to generate the sequential `Greys` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `Greys` palette.
export Greys(int n = 9) =>
	var const color[] Greys3 = array.from(#f0f0f0, #bdbdbd, #636363)
	var const color[] Greys4 = array.from(#f7f7f7, #cccccc, #969696, #525252)
	var const color[] Greys5 = array.from(#f7f7f7, #cccccc, #969696, #636363, #252525)
	var const color[] Greys6 = array.from(#f7f7f7, #d9d9d9, #bdbdbd, #969696, #636363, #252525)
	var const color[] Greys7 = array.from(#f7f7f7, #d9d9d9, #bdbdbd, #969696, #737373, #525252, #252525)
	var const color[] Greys8 = array.from(#ffffff, #f0f0f0, #d9d9d9, #bdbdbd, #969696, #737373, #525252, #252525)
	var const color[] Greys9 = array.from(#ffffff, #f0f0f0, #d9d9d9, #bdbdbd, #969696, #737373, #525252, #252525, #000000)

	out = switch n
		3 => Greys3
		4 => Greys4
		5 => Greys5
		6 => Greys6
		7 => Greys7
		8 => Greys8
		9 => Greys9
		=> Greys9
	out


// @function A function to generate the sequential `YlGn` (Yellow/Green) palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `YlGn` palette.
export YlGn(int n = 9) =>
	var const color[] YlGn3 = array.from(#31a354, #addd8e, #f7fcb9)
	var const color[] YlGn4 = array.from(#238443, #78c679, #c2e699, #ffffcc)
	var const color[] YlGn5 = array.from(#006837, #31a354, #78c679, #c2e699, #ffffcc)
	var const color[] YlGn6 = array.from(#006837, #31a354, #78c679, #addd8e, #d9f0a3, #ffffcc)
	var const color[] YlGn7 = array.from(#005a32, #238443, #41ab5d, #78c679, #addd8e, #d9f0a3, #ffffcc)
	var const color[] YlGn8 = array.from(#005a32, #238443, #41ab5d, #78c679, #addd8e, #d9f0a3, #f7fcb9, #ffffe5)
	var const color[] YlGn9 = array.from(#004529, #006837, #238443, #41ab5d, #78c679, #addd8e, #d9f0a3, #f7fcb9, #ffffe5)

	out = switch n
		3 => YlGn3
		4 => YlGn4
		5 => YlGn5
		6 => YlGn6
		7 => YlGn7
		8 => YlGn8
		9 => YlGn9
		=> YlGn9
	out


// @function A function to generate the sequential `YlGnBu` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `YlGnBu` palette.
export YlGnBu(int n = 9) =>
	var const color[] YlGnBu3 = array.from(#2c7fb8, #7fcdbb, #edf8b1)
	var const color[] YlGnBu4 = array.from(#225ea8, #41b6c4, #a1dab4, #ffffcc)
	var const color[] YlGnBu5 = array.from(#253494, #2c7fb8, #41b6c4, #a1dab4, #ffffcc)
	var const color[] YlGnBu6 = array.from(#253494, #2c7fb8, #41b6c4, #7fcdbb, #c7e9b4, #ffffcc)
	var const color[] YlGnBu7 = array.from(#0c2c84, #225ea8, #1d91c0, #41b6c4, #7fcdbb, #c7e9b4, #ffffcc)
	var const color[] YlGnBu8 = array.from(#0c2c84, #225ea8, #1d91c0, #41b6c4, #7fcdbb, #c7e9b4, #edf8b1, #ffffd9)
	var const color[] YlGnBu9 = array.from(#081d58, #253494, #225ea8, #1d91c0, #41b6c4, #7fcdbb, #c7e9b4, #edf8b1, #ffffd9)

	out = switch n
		3 => YlGnBu3
		4 => YlGnBu4
		5 => YlGnBu5
		6 => YlGnBu6
		7 => YlGnBu7
		8 => YlGnBu8
		9 => YlGnBu9
		=> YlGnBu9
	out


// @function A function to generate the sequential `GnBu` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `GnBu` palette.
export GnBu(int n = 9) =>
	var const color[] GnBu3 = array.from(#43a2ca, #a8ddb5, #e0f3db)
	var const color[] GnBu4 = array.from(#2b8cbe, #7bccc4, #bae4bc, #f0f9e8)
	var const color[] GnBu5 = array.from(#0868ac, #43a2ca, #7bccc4, #bae4bc, #f0f9e8)
	var const color[] GnBu6 = array.from(#0868ac, #43a2ca, #7bccc4, #a8ddb5, #ccebc5, #f0f9e8)
	var const color[] GnBu7 = array.from(#08589e, #2b8cbe, #4eb3d3, #7bccc4, #a8ddb5, #ccebc5, #f0f9e8)
	var const color[] GnBu8 = array.from(#08589e, #2b8cbe, #4eb3d3, #7bccc4, #a8ddb5, #ccebc5, #e0f3db, #f7fcf0)
	var const color[] GnBu9 = array.from(#084081, #0868ac, #2b8cbe, #4eb3d3, #7bccc4, #a8ddb5, #ccebc5, #e0f3db, #f7fcf0)

	out = switch n
		3 => GnBu3
		4 => GnBu4
		5 => GnBu5
		6 => GnBu6
		7 => GnBu7
		8 => GnBu8
		9 => GnBu9
		=> GnBu9
	out


// @function A function to generate the sequential `BuGn` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `BuGn` palette.
export BuGn(int n = 9) =>
	var const color[] BuGn3 = array.from(#2ca25f, #99d8c9, #e5f5f9)
	var const color[] BuGn4 = array.from(#238b45, #66c2a4, #b2e2e2, #edf8fb)
	var const color[] BuGn5 = array.from(#006d2c, #2ca25f, #66c2a4, #b2e2e2, #edf8fb)
	var const color[] BuGn6 = array.from(#006d2c, #2ca25f, #66c2a4, #99d8c9, #ccece6, #edf8fb)
	var const color[] BuGn7 = array.from(#005824, #238b45, #41ae76, #66c2a4, #99d8c9, #ccece6, #edf8fb)
	var const color[] BuGn8 = array.from(#005824, #238b45, #41ae76, #66c2a4, #99d8c9, #ccece6, #e5f5f9, #f7fcfd)
	var const color[] BuGn9 = array.from(#00441b, #006d2c, #238b45, #41ae76, #66c2a4, #99d8c9, #ccece6, #e5f5f9, #f7fcfd)

	out = switch n
		3 => BuGn3
		4 => BuGn4
		5 => BuGn5
		6 => BuGn6
		7 => BuGn7
		8 => BuGn8
		9 => BuGn9
		=> BuGn9
	out


// @function A function to generate the sequential `PuBuGn` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `PuBuGn` palette.
export PuBuGn(int n = 9) =>
	var const color[] PuBuGn3 = array.from(#1c9099, #a6bddb, #ece2f0)
	var const color[] PuBuGn4 = array.from(#02818a, #67a9cf, #bdc9e1, #f6eff7)
	var const color[] PuBuGn5 = array.from(#016c59, #1c9099, #67a9cf, #bdc9e1, #f6eff7)
	var const color[] PuBuGn6 = array.from(#016c59, #1c9099, #67a9cf, #a6bddb, #d0d1e6, #f6eff7)
	var const color[] PuBuGn7 = array.from(#016450, #02818a, #3690c0, #67a9cf, #a6bddb, #d0d1e6, #f6eff7)
	var const color[] PuBuGn8 = array.from(#016450, #02818a, #3690c0, #67a9cf, #a6bddb, #d0d1e6, #ece2f0, #fff7fb)
	var const color[] PuBuGn9 = array.from(#014636, #016c59, #02818a, #3690c0, #67a9cf, #a6bddb, #d0d1e6, #ece2f0, #fff7fb)

	out = switch n
		3 => PuBuGn3
		4 => PuBuGn4
		5 => PuBuGn5
		6 => PuBuGn6
		7 => PuBuGn7
		8 => PuBuGn8
		9 => PuBuGn9
		=> PuBuGn9
	out


// @function A function to generate the sequential `PuBu` palette of the specified size.
// @param n (int) The size of the output palette to generate. Default is 9.
// @returns An array of colors from the `PuBu` palette.
export PuBu(int n = 9) =>
	var const color[] PuBu3 = array.from(#2b8cbe, #a6bddb, #ece7f2)
	var const color[] PuBu4 = array.from(#0570b0, #74a9cf, #bdc9e1, #f1eef6)
	var const color[] PuBu5 = array.from(#045a8d, #2b8cbe, #74a9cf, #bdc9e1, #f1eef6)
	var const color[] PuBu6 = array.from(#045a8d, #2b8cbe, #74a9cf, #a6bddb, #d0d1e6, #f1eef6)
	var const color[] PuBu7 = array.from(#034e7b, #0570b0, #3690c0, #74a9cf, #a6bddb, #d0d1e6, #f1eef6)
	var const color[] PuBu8 = array.from(#034e7b, #0570b0, #3690c0, #74a9cf, #a6bddb, #d0d1e6, #ece7f2, #fff7fb)
	var const color[] PuBu9 = array.from(#023858, #045a8d, #0570b0, #3690c0, #74a9cf, #a6bddb, #d0d1e6, #ece7f2, #fff7fb)

	out = switch n
		3 => PuBu3
		4 => PuBu4
		5 => PuBu5
		6 => PuBu6
		7 => PuBu7
		8 => PuBu8
		9 => PuBu9
		=> PuBu9
	out


// @function A function to generate the sequential `BuPu` palette of the specified size.
