		4 => PuOr4
		5 => PuOr5
		6 => PuOr6
		7 => PuOr7
		8 => PuOr8
		9 => PuOr9
		10 => PuOr10
		11 => PuOr11
		=> PuOr9
	out


// @function A function to generate the diverging `RdBu` palette of the specified size.
