//@version=6
library("QuantifyPS")

// ----------------------------------------------------------------------------
// General Description:
// ----------------------------------------------------------------------------
// 1. This script implements advanced mathematical and statistical functions 
//    commonly used in quantitative financial analysis.
// 2. It provides tools for statistical testing, regression analysis, and 
//    probability distribution calculations, tailored for traders and analysts.
// 3. Key functions include methods for computing the normal distribution (CDF), 
//    Gamma function, normality tests (Jarque-Bera), skewness, kurtosis, and 
//    Ordinary Least Squares (OLS) regression.
//
// ----------------------------------------------------------------------------
// Primary Use Cases:
// ----------------------------------------------------------------------------
// - **Distribution Analysis**: Estimate probabilities from normal and Student's 
//   t-distributions.
// - **Normality Testing**: Verify the normality of datasets using the 
//   Jarque-Bera test.
// - **Statistical Modeling**: Fit linear regressions and analyze residuals 
//   (skewness, kurtosis).
// - **Data Diagnostics**: Assess the goodness of fit and identify anomalies in 
//   time series data.
//
// ----------------------------------------------------------------------------
// Function to compute the cumulative normal distribution (CDF) for a standard normal variable.
// This function provides an approximation of the probability that a standard normal variable (z-score) 
// is less than or equal to a given value `z`.
//
// @param z (float): The z-score for which the CDF is to be calculated.
// @returns (float): The cumulative probability corresponding to the input z-score.
//
// Notes:
// - Uses an approximation method for the normal distribution CDF, which is computationally efficient.
// - The result is accurate for most practical purposes but may have minor deviations for extreme values of `z`.
//
// Formula:
// - Based on the approximation formula:
//   `Φ(z) ≈ 1 - f(z) * P(t)` if `z > 0`, otherwise `Φ(z) ≈ f(z) * P(t)`,
//   where:
//     `f(z) = 0.3989423 * exp(-z^2 / 2)` (PDF of standard normal distribution)
//     `P(t) = Σ [c[i] * t^i]` with constants `c` and `t = 1 / (1 + 0.2316419 * |z|)`.
//
// Implementation details:
// - The approximation uses five coefficients for the polynomial part of the CDF.
// - Handles both positive and negative values of `z` symmetrically.
//
// Constants:
// - The coefficients and scaling factors are chosen to minimize approximation errors.
//
export normdist(float z) =>
    // Constants for the approximation
    t = 1 / (1 + 0.2316419 * math.abs(z))  // Scaling factor for the polynomial
    d = 0.3989423 * math.exp(-z * z / 2)  // Standard normal PDF value
    
    // Polynomial approximation
    p = d * (0.3193815 * t 
             - 0.3565638 * math.pow(t, 2) 
             + 1.781478 * math.pow(t, 3) 
             - 1.821256 * math.pow(t, 4) 
             + 1.330274 * math.pow(t, 5))
    
    // Return CDF value based on the sign of z
    z > 0 ? 1 - p : p

// Function to compute the Gamma function based on the Lanczos approximation.
// The Gamma function generalizes the factorial function to real and complex numbers.
//
// @param x (float): The input value for which the Gamma function is to be calculated.
//                   Must be greater than 0. For x <= 0, the function returns `na` as it is undefined.
// @returns (float): Approximation of the Gamma function for the input `x`.
//
// Notes:
// - The Lanczos approximation provides a numerically stable and efficient method to compute the Gamma function.
// - The function is not defined for `x <= 0` and will return `na` in such cases.
// - Uses precomputed Lanczos coefficients for accuracy.
// - Includes handling for small numerical inaccuracies.
//
// Formula:
// - The Gamma function is approximated as:
//   `Γ(x) ≈ sqrt(2π) * t^(x + 0.5) * e^(-t) * Σ(p[k] / (x + k))`
//   where `t = x + g + 0.5` and `p` is the array of Lanczos coefficients.
//
// Implementation details:
// - Lanczos coefficients (`p`) are precomputed and stored in an array.
// - The summation iterates over these coefficients to compute the final result.
// - The constant `g` controls the precision of the approximation (commonly `g = 7`).
//
export gamma(float x) =>
    if x <= 0
        na  // Gamma function is undefined for x <= 0
    else
        g = 7  // Lanczos parameter

// Define Lanczos coefficients as an array
        p = array.new_float(9, 0.0)
        array.set(p, 0, 0.99999999999980993)
        array.set(p, 1, 676.5203681218851)
        array.set(p, 2, -1259.1392167224028)
        array.set(p, 3, 771.32342877765313)
        array.set(p, 4, -176.61502916214059)
        array.set(p, 5, 12.507343278686905)
        array.set(p, 6, -0.13857109526572012)
        array.set(p, 7, 9.9843695780195716e-6)
        array.set(p, 8, 1.5056327351493116e-7)

        t = x + g + 0.5  // Shifted value for approximation
        sqrt2Pi = 2.5066282746310002  // Constant √(2π)
        sum = array.get(p, 0)  

// Compute summation with Lanczos coefficients
        for i = 1 to array.size(p) - 1
            sum := sum + array.get(p, i) / (x + i)

// Return final Gamma function approximation
        sqrt2Pi * math.pow(t, x + 0.5) * math.exp(-t) * sum



// Function to approximate the cumulative distribution function (CDF) 
// for Student's t-distribution.
// The CDF gives the probability that a t-statistic is less than or equal to a given value.
//
// @param t (float): The t-statistic for which the CDF value is to be calculated.
// @param df (int): Degrees of freedom of the t-distribution.
// @returns (float): Approximate CDF value for the given t-statistic.
//
// Notes:
// - This function computes a one-tailed p-value.
// - Relies on an approximation formula using gamma functions and standard t-distribution properties.
// - May not be as accurate as specialized statistical libraries for extreme values or very high degrees of freedom.
//
// Formula:
// - Let `x = df / (t^2 + df)`.
// - The approximation formula is derived using:
//   `CDF(t, df) ≈ 1 - [sqrt(df * π) * Γ(df / 2) / Γ((df + 1) / 2)] * x^((df + 1) / 2) / 2`,
//   where Γ represents the gamma function.
//
// Implementation details:
// - Computes the gamma ratio for normalization.
// - Applies the t-distribution formula for one-tailed probabilities.
//
export t_cdf(float t, int df) =>
    // Compute `x` based on degrees of freedom and t-statistic
    x = df / (t * t + df)
    
    // Compute the normalization factor using the gamma function
    a = math.sqrt(df * math.pi) * gamma(df / 2) / gamma((df + 1) / 2)
    
    // Compute the approximate CDF value
    p = a * math.pow(x, (df + 1) / 2)
    
    // Return one-tailed p-value
    1 - p / 2


// Function to compute the t-statistic corresponding to a given p-value for a Student's t-distribution.
// This is done using a binary search method for efficiency.
//
// @param p (float): P-value for which the t-statistic needs to be calculated. 
//                   Must be in the interval (0, 1).
// @param df (int): Degrees of freedom of the t-distribution.
// @returns (float): The t-statistic corresponding to the given p-value.
//
// Notes:
// - If `p` is outside the interval (0, 1), the function returns `na` as an error.
// - The function uses binary search with a fixed number of iterations and a defined tolerance.
// - The result is accurate to within the specified tolerance (default: 0.0001).
// - Relies on the cumulative density function (CDF) `t_cdf` for the t-distribution.
//
// Formula:
// - Uses the cumulative density function (CDF) of the t-distribution to iteratively find the t-statistic.
//
// Implementation details:
// - `low` and `high` define the search interval for the t-statistic.
// - The midpoint (`mid`) is iteratively refined until the difference between the cumulative probability 
//   and the target p-value is smaller than the tolerance.
//
export tStatForPValue(float p, int df) =>
    if p <= 0 or p >= 1
        na 
    else
        var float low = -100.0  
        var float high = 100.0  
        var float mid = na      
        var float cumulativeP = na  
        var int maxIterations = 50  
        var float tolerance = 0.0001  
        
        // Binary search loop
        for i = 0 to maxIterations - 1
            mid := (low + high) / 2.0  
            cumulativeP := t_cdf(mid, df)  
            
            // Check if the result is within the desired tolerance
            if math.abs(cumulativeP - p) < tolerance
                break  
            else if cumulativeP < p
                low := mid  
            else
                high := mid  
        
        mid 


// Function to compute the Jarque-Bera (JB) test statistic.
// The Jarque-Bera test is a statistical test used to check whether a given dataset follows a normal distribution.
// It evaluates the skewness and kurtosis of the dataset and compares them to those of a normal distribution.
//
// @param n (series float): Number of observations in the dataset.
// @param s (series float): Skewness of the dataset.
// @param k (series float): Kurtosis of the dataset.
// @returns (float): The Jarque-Bera test statistic.
//
// Formula:
// JB = n * [(S^2 / 6) + ((K - 3)^2 / 24)]
//
// Notes:
// - A higher JB value suggests that the data deviates more from a normal distribution.
// - The test is asymptotically distributed as a chi-squared distribution with 2 degrees of freedom.
// - Use this value to calculate a p-value to determine the significance of the result.
//
export jarqueBera(series float n, series float s, series float k) =>
    jb = n * ((math.pow(s, 2) / 6) + (math.pow((k - 3), 2) / 24))
    jb


// Function to compute the skewness of a given data series.
// Skewness measures the asymmetry of the data distribution around its mean.
// A positive skew indicates a distribution with a longer tail on the right, while a negative skew indicates a longer tail on the left.
//
// @param data (series float): Input data series.
// @returns (float): The skewness value.
//
// Notes:
// - Handles missing values (`na`) by ignoring invalid points.
// - Includes error handling for zero variance to avoid division-by-zero scenarios.
// - Skewness is calculated as the normalized third central moment of the data.
//
export skewness(series float data) =>
// Filter valid data points
    is_valid = not na(data)
    
// Cumulative statistics for calculations
    n = ta.cum(is_valid ? 1 : 0)  
    mean_data = ta.cum(is_valid ? data : 0) / n  
    
// Compute deviations from the mean
    diff = is_valid ? (data - mean_data) : 0  
    diff_squared = diff * diff  
    diff_cubed = diff_squared * diff  
    
// Cumulative sums for moments
    sum_diff_squared = ta.cum(diff_squared)  
    sum_diff_cubed = ta.cum(diff_cubed)  
    
// Variance and third central moment
    variance = sum_diff_squared / n  
    variance := variance != 0 ? variance : 0.000001  
    third_moment = sum_diff_cubed / n  
    
// Compute skewness
    skewness = third_moment / math.pow(variance, 1.5)  // Normalized skewness
    skewness


// Function to compute the kurtosis of a given data series.
// Kurtosis measures the "tailedness" of the data distribution.
// A higher kurtosis indicates heavier tails, while a lower kurtosis indicates lighter tails.
//
// @param data (series float): Input data series.
// @returns (float): The kurtosis value.
//
// Notes:
// - Handles missing values (`na`) by ignoring invalid points.
// - Includes error handling for zero variance to avoid division-by-zero scenarios.
// - Kurtosis is calculated as the normalized fourth central moment of the data.
//
export kurtosis(series float data) =>
// Validate data points
    is_valid = not na(data)

 // Cumulative statistics for calculations
    n = ta.cum(is_valid ? 1 : 0)
    mean_data = ta.cum(is_valid ? data : 0) / n
    diff = is_valid ? (data - mean_data) : 0

// Second and fourth moments
    diff_squared = diff * diff
    diff_quartic = diff_squared * diff_squared
    sum_diff_squared = ta.cum(diff_squared)
    sum_diff_quartic = ta.cum(diff_quartic)

// Variance and fourth central moment
    variance = sum_diff_squared / n
    variance := variance != 0 ? variance : 0.000001 
    fourth_moment = sum_diff_quartic / n

// Compute kurtosis
    kurtosis = fourth_moment / math.pow(variance, 2)
    kurtosis

// Function to compute Ordinary Least Squares (OLS) linear regression with lag using the full history of data.
// This function calculates the regression coefficients (alpha and beta), statistical metrics (t-stat, p-value), and goodness-of-fit (R-squared).
//
// @param y (series float): Dependent series (observed values).
// @param x (series float): Independent series (explanatory variable).
// @param lag (int): Number of lags applied to the independent series (x).
// @returns (tuple): Returns a tuple containing the following values:
//   - n: Number of valid observations.
//   - alpha: Intercept of the regression line.
//   - beta: Slope of the regression line.
//   - t_stat: T-statistic for the beta coefficient.
//   - p_value: Two-tailed p-value for the beta coefficient.
//   - r_squared: Coefficient of determination (R²) indicating goodness of fit.
//   - skew: Skewness of the residuals.
//   - kurt: Kurtosis of the residuals.
//
// Notes:
// - Handles missing data (`na`) by ignoring invalid points.
// - Includes basic error handling for zero variance and division-by-zero scenarios.
// - Computes residual-based statistics (skewness and kurtosis) for model diagnostics.
//
export regression(series float y, series float x, int lag) =>
// Apply lag to the independent series
    x_lagged = x[lag]

// Determine valid data points
    is_valid = not na(x_lagged) and not na(y)

// Cumulative statistics for regression calculations
    n = ta.cum(is_valid ? 1 : 0)
    sum_x = ta.cum(is_valid ? x_lagged : 0)
    sum_y = ta.cum(is_valid ? y : 0)
    sum_xy = ta.cum(is_valid ? x_lagged * y : 0)
    sum_xx = ta.cum(is_valid ? x_lagged * x_lagged : 0)
    sum_yy = ta.cum(is_valid ? y * y : 0)

// Means
    mean_x = sum_x / n
    mean_y = sum_y / n

// Covariance and variance
    cov_xy = (sum_xy - sum_x * mean_y) / n
    var_x = (sum_xx - sum_x * mean_x) / n
    var_x := var_x != 0 ? var_x : 0.000001

// Regression coefficients
    beta = cov_xy / var_x
    alpha = mean_y - beta * mean_x

// Residuals and residual variance
    residuals = y - (alpha + beta * x_lagged)
    residuals_squared = is_valid ? residuals * residuals : 0
    sum_residuals_squared = ta.cum(residuals_squared)
    degrees_of_freedom = n - 2
    residual_var = sum_residuals_squared / degrees_of_freedom

// Standard error and t-statistic for beta
    standard_error_beta = math.sqrt(residual_var / (n * var_x))
    standard_error_beta := standard_error_beta != 0 ? standard_error_beta : 0.000001
    t_stat = beta / standard_error_beta

// P-value calculation using normal distribution
    p_value = 2 * (1 - normdist(math.abs(t_stat)))

// Total sum of squares (SST) and R-squared
    ss_total = (sum_yy - sum_y * mean_y) // SST
    ss_total := ss_total != 0 ? ss_total : 0.000001 
    r_squared = 1 - (sum_residuals_squared / ss_total)

// Residual diagnostics: skewness and kurtosis
    skew = skewness(residuals)
    kurt = kurtosis(residuals)

    [n, alpha, beta, t_stat, p_value, r_squared, skew, kurt]