// ============================================================================
//  QuantLine · Geometric Conflict Lite  (PUBLIC / EDUCATIONAL VERSION)
// ----------------------------------------------------------------------------
//  Asks: where is BTC inside its own range vs where the typical alt sits inside
//  its own? Gap in percentage points = breadth "conflict". Uses a small public
//  basket of major crypto pairs (editable). No proprietary pipeline. Thresholds
//  ±30 are user defaults — a hypothesis, not calibrated signals. Context only.
//  Open-source. Not financial advice.
//
//  House Rules: English UI. Publish with a CLEAN chart (this script only).
// ============================================================================
//@version=6
indicator("QuantLine Geometric Conflict Lite", shorttitle="QLS Geo-Conflict", overlay=false)

rangeTF   = input.timeframe("240", "Range timeframe (default 4H)", tooltip="Timeframe used to measure position inside each asset's range.")
lookback  = input.int(60, "Range lookback (bars)", minval=10, tooltip="How many rangeTF bars for high/low of the range.")
minRngPct = input.float(0.5, "Min range width, % of price", minval=0.0, step=0.1, tooltip="If range is narrower, asset is excluded (noise, not a range).")
posFloor  = input.float(0.33, "'At floor' zone (pos ≤)", minval=0.0, maxval=1.0, step=0.01)
thr       = input.float(30.0, "Verdict threshold, pp", minval=1.0, step=1.0, tooltip="≥ +thr = CONFLICT, ≤ -thr = INVERSE, between = AGREEMENT.")

btcSym = input.symbol("BINANCE:BTCUSDT", "BTC (benchmark)", group="Assets")

a1 = input.symbol("BINANCE:ETHUSDT",  "Alt 1", group="Alt basket")
a2 = input.symbol("BINANCE:BNBUSDT",  "Alt 2", group="Alt basket")
a3 = input.symbol("BINANCE:SOLUSDT",  "Alt 3", group="Alt basket")
a4 = input.symbol("BINANCE:XRPUSDT",  "Alt 4", group="Alt basket")
a5 = input.symbol("BINANCE:ADAUSDT",  "Alt 5", group="Alt basket")
a6 = input.symbol("BINANCE:DOGEUSDT", "Alt 6", group="Alt basket")
a7 = input.symbol("BINANCE:AVAXUSDT", "Alt 7", group="Alt basket")
a8 = input.symbol("BINANCE:LINKUSDT", "Alt 8", group="Alt basket")

showBG = input.bool(true, "Background tint by verdict", group="Display")
tblPos = input.string("top_right", "Table position", options=["top_right","top_left","bottom_right","bottom_left"], group="Display")

f_pos(simple string sym) =>
    c  = request.security(sym, rangeTF, close)
    hh = request.security(sym, rangeTF, ta.highest(high, lookback))
    ll = request.security(sym, rangeTF, ta.lowest(low,  lookback))
    rng   = hh - ll
    valid = not na(c) and rng > 0 and (rng / math.max(c, 1e-9) * 100.0) >= minRngPct
    valid ? math.max(0.0, math.min(1.0, (c - ll) / rng)) : na

btcPos = f_pos(btcSym)

posArr = array.new_float()
addPos(float p) =>
    if not na(p)
        array.push(posArr, p)
addPos(f_pos(a1))
addPos(f_pos(a2))
addPos(f_pos(a3))
addPos(f_pos(a4))
addPos(f_pos(a5))
addPos(f_pos(a6))
addPos(f_pos(a7))
addPos(f_pos(a8))

nAlts   = array.size(posArr)
medAlt  = nAlts > 0 ? array.median(posArr) : na

floorCnt = 0
if nAlts > 0
    for i = 0 to nAlts - 1
        if array.get(posArr, i) <= posFloor
            floorCnt += 1

conflict_pp = (na(btcPos) or na(medAlt)) ? na : (btcPos - medAlt) * 100.0

isConflict = not na(conflict_pp) and conflict_pp >=  thr
isInverse  = not na(conflict_pp) and conflict_pp <= -thr
verdict = isConflict ? "CONFLICT" : isInverse ? "INVERSE" : "AGREEMENT"
vCol    = isConflict ? color.new(color.red, 0) : isInverse ? color.new(color.lime, 0) : color.new(color.gray, 0)

plot(conflict_pp, "Gap (pp)", color=vCol, linewidth=2)
h0  = hline(0,    "0",  color=color.new(color.gray, 50), linestyle=hline.style_dotted)
hUp = hline(thr,  "+threshold", color=color.new(color.red, 60),  linestyle=hline.style_dashed)
hDn = hline(-thr, "-threshold", color=color.new(color.lime, 60), linestyle=hline.style_dashed)
fill(hUp, h0, color=color.new(color.red,  92), title="conflict zone")
fill(h0, hDn, color=color.new(color.lime, 92), title="inverse zone")

bgcolor(showBG and isConflict ? color.new(color.red, 90) : showBG and isInverse ? color.new(color.green, 90) : na)

f_tp(p) => p=="top_left" ? position.top_left : p=="bottom_right" ? position.bottom_right : p=="bottom_left" ? position.bottom_left : position.top_right

var table tbl = table.new(f_tp(tblPos), 2, 6, bgcolor=color.new(color.black, 10), frame_color=color.new(color.gray, 40), frame_width=2, border_color=color.new(color.gray, 70), border_width=1)
if barstate.islast
    blk = color.new(color.black, 10)
    table.cell(tbl, 0, 0, "⟂ QLS Geo-Conflict · Lite", text_color=color.white, bgcolor=blk, text_size=size.small)
    table.cell(tbl, 1, 0, verdict, text_color=vCol, bgcolor=blk, text_size=size.normal)

    table.cell(tbl, 0, 1, "Gap (BTC − median alts)", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 1, (na(conflict_pp) ? "—" : str.tostring(conflict_pp, "0.0") + " pp"), text_color=color.white, text_size=size.small)

    table.cell(tbl, 0, 2, "BTC inside its range", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 2, (na(btcPos) ? "—" : str.tostring(btcPos * 100.0, "#") + "%"), text_color=color.white, text_size=size.tiny)

    table.cell(tbl, 0, 3, "Median alt in range", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 3, (na(medAlt) ? "—" : str.tostring(medAlt * 100.0, "#") + "%"), text_color=color.white, text_size=size.tiny)

    table.cell(tbl, 0, 4, "Alts at floor", text_color=color.silver, text_size=size.tiny)
    table.cell(tbl, 1, 4, str.tostring(floorCnt) + "/" + str.tostring(nAlts), text_color=color.white, text_size=size.tiny)

    explain = isConflict ? "BTC near ceiling, alts near floor — alt support longs often borrowed" : isInverse ? "Mirror: BTC low, alts high — less downside pressure on alt longs" : "BTC and alts in similar parts of their ranges — no conflict"
    table.cell(tbl, 0, 5, explain, text_color=vCol, text_size=size.tiny)
    table.cell(tbl, 1, 5, "not financial advice", text_color=color.gray, text_size=size.tiny)

alertcondition(ta.crossover(conflict_pp, thr),  "Geo: CONFLICT",  "QLS Geo-Conflict Lite: gap crossed +threshold — context only, not a signal")
alertcondition(ta.crossunder(conflict_pp, -thr), "Geo: INVERSE", "QLS Geo-Conflict Lite: gap crossed -threshold — context only, not a signal")