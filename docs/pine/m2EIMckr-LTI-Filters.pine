// @description Linear Time-Invariant (LTI) filters are fundamental tools in signal processing that operate with 
// consistent behavior over time and linearly respond to input signals. They are crucial for analyzing and manipulating 
// signals in various applications, ensuring the output signal's integrity is maintained regardless of when an input is 
// applied or its magnitude. The Windowed Sinc filter is a specific type of LTI filter designed for digital signal 
// processing. It employs a Sinc function, ideal for low-pass filtering, truncated and shaped within a finite window to 
// make it practically implementable. This process involves multiplying the Sinc function by a window function, which 
// tapers off towards the ends, making the filter finite and suitable for digital applications. Windowed Sinc filters 
// are particularly effective for tasks like data smoothing and removing unwanted frequency components, balancing 
// between sharp cutoff characteristics and minimal distortion. The efficiency of Windowed Sinc filters in digital 
// signal processing lies in their adept use of linear algebra, particularly in the convolution process, which combines 
// input data with filter coefficients to produce the desired output. This mathematical foundation allows for precise 
// control over the filtering process, optimizing the balance between filtering performance and computational efficiency. 
// By leveraging linear algebra techniques such as matrix multiplication and Toeplitz matrices, these filters can 
// efficiently handle large datasets and complex filtering tasks, making them invaluable in applications requiring high 
// precision and speed, such as audio processing, financial signal analysis, and image restoration.

//@version=5
library("LTI_Filters", overlay = true)
method is_even(simple int n)=> n % 2 == 0
sinc(float x)=> x == 0 ? 1 : math.sin(math.pi * x) / (math.pi * x)
mid_point(int x)=> (x - 1) / 2
hann(float n, int length)=> (1 - math.cos((2 * math.pi * n) / (length - 1)))
hamming(float n, int length)=> 0.54 - 0.46 * math.cos((2 * math.pi * n) / (length - 1))
blackman(float n, int length)=> 0.42 - 0.5 * math.cos((2 * math.pi * n) / (length - 1)) + 0.08 * math.cos((4 * math.pi * n) / (length - 1))
triangular(float n, int length)=> 1 - math.abs((n - (length - 1) / 2) / (length / 2))
lanczos(float n, int length)=> sinc((2 * n / (length - 1)) - 1)

get_data(float source, simple int length, simple bool prefilter)=>
    float sma2 = prefilter ? nz(ta.sma(source, 2), source) : source
    var float[] data = array.new<float>()
    if bar_index < length 
        data.unshift(sma2)
        data

    else
        data.unshift(sma2)
        data.pop()
        data

window(float n, int length, simple string style)=>
    switch style
        "Hann" => hann(n, length)
        "Hamming" => hamming(n, length)
        "Blackman" => blackman(n, length)
        "Triangular" => triangular(n, length)
        "Lanczos" => lanczos(n, length)
        => 1.0

sinc_coefficients(simple int length, float fc, simple string window = "Hann", simple bool centered = true)=>
    float[] coefficients = array.new<float>()
    int mid = mid_point(length)
    float cutoff = 1 / fc
    for i = 0 to length - 1
        int n = centered ? i - mid : i
        int k = centered ? i : i + mid 
        int M = centered ? length : length * 2
        if length.is_even()
            float coefficient = sinc(2 * cutoff * n) * window(k + 0.5, M, window)
            coefficients.push(coefficient)
        else
            float coefficient = sinc(2 * cutoff * n) * window(k, M, window)
            coefficients.push(coefficient)
    coefficients

wma_coefficients(simple int length, simple bool centered)=>
    float[] coefficients = array.new<float>()
    int mid = mid_point(length)
    for i = 0 to length - 1
        int coefficient = centered ? length - math.abs(i - mid) : length - i
        coefficients.push(coefficient)
    coefficients

sma_coefficients(simple int length)=>
    float[] coefficients = array.new<float>(length, 1)
    coefficients

filter_type(simple int length, simple float fc, simple bool centered, simple string window, simple string style)=>
    switch style
        "Sinc" => sinc_coefficients(length, fc, window, centered)
        "SMA" => sma_coefficients(length)
        "WMA" => wma_coefficients(length, centered)

toeplitz_matrix_valid(float[] coefficients, int M)=>
    int N = coefficients.size()
    int rows = M - N + 1
    matrix<float> toeplitz = matrix.new<float>(rows, M, 0)
    
    for r = 0 to rows - 1
        for c = 0 to N - 1
            if (c + r) < M
                toeplitz.set(r, c + r, coefficients.get(c))
            else
                break

    toeplitz

convolution(float[] data, float[] coefficients)=>
    var float normalize = coefficients.sum()
    var matrix<float> toeplitz_matrix = toeplitz_matrix_valid(coefficients, data.size())
    float convolved = matrix.mult(toeplitz_matrix, data).first()
    convolved / normalize

// @function Calculates the time offset required for aligning the output of a filter with its input, based on the filter's length. This is useful for centered filters where the output is naturally shifted due to the filter's operation.
// @param length The length of the filter. 
// @param enable A boolean flag to enable or dissable the offset calculation. 
// @returns The calculated offset if enabled; otherwise, returns 0.
export offset(simple int length, simple bool enable = true)=> -(enable ? (length - 1) / 2 : 0)


// @function General-purpose Linear Time-Invariant (LTI) filter function that can apply various filter types to a data series. Can be used to apply a variety of LTI filters with different characteristics to financial data series or other time series data.
// @param filter_type Specifies the type of filter. ("Sinc", "SMA", "WMA")
// @param source The input data series to filter.
// @param length The length of the filter.
// @param prefilter Boolean indicating whether to prefilter the input data.
// @param centered Determines whether the filter coefficients are centered.
// @param fc Filter cutoff. Expressed like a length.
// @param window_type Type of window function to apply. ("Hann", "Hamming", "Blackman", "Triangular", "Lanczos", "None")
// @returns The filtered data series.
export lti_filter(simple string filter_type, float source, simple int length, simple bool prefilter = true, simple bool centered = true, simple float fc = 100, simple string window_type = "Lanczos")=>
    float[] data = get_data(source, length, prefilter)
    var float[] coefficients = filter_type(length, fc, centered, window_type, filter_type)

    if bar_index > length
        convolved = convolution(data, coefficients)
    else
        float(na)

// @function Applies a Simple Moving Average (SMA) filter to the data series. Useful for smoothing data series to identify trends or for use as a component in more complex indicators.
// @param source The input data series to filter.
// @param length The length of the SMA filter.
// @param prefilter Boolean indicating whether to prefilter the input data.
// @returns The SMA-filtered data series.
export lti_sma(series float source, simple int length, simple bool prefilter)=>
    float[] data = get_data(source, length, prefilter)
    var float[] coefficients = sma_coefficients(length)

    if bar_index > length
        convolved = convolution(data, coefficients)
    else
        float(na)

// @function Applies a Weighted Moving Average (WMA) filter to a data series. Ideal for smoothing data with emphasis on more recent values, allowing for dynamic adjustments to the weighting scheme.
// @param source The input data series to filter.
// @param length The length of the WMA filter.
// @param prefilter Boolean indicating whether to prefilter the input data.
// @param centered Determines whether the filter coefficients are centered.
// @returns The WMA-filtered data series.
export lti_wma(series float source, simple int length, simple bool prefilter, simple bool centered)=>
    float[] data = get_data(source, length, prefilter)
    var float[] coefficients = wma_coefficients(length, centered)

    if bar_index > length
        convolved = convolution(data, coefficients)
    else
        float(na)

// @function Applies a Sinc filter to a data series, optionally using a window function. Particularly useful for signal processing tasks within financial analysis, such as smoothing or trend identification, with the ability to fine-tune filter characteristics.
// @param source The input data series to filter.
// @param length The length of the Sinc filter.
// @param prefilter Boolean indicating whether to prefilter the input data.
// @param centered Determines whether the filter coefficients are centered.
// @param fc Filter cutoff. Expressed like a length.
// @param window_type Type of window function to apply. ("Hann", "Hamming", "Blackman", "Triangular", "Lanczos", "None")
// @returns The Sinc-filtered data series.
export lti_sinc(series float source, simple int length, simple bool prefilter = true, simple bool centered = true, simple float fc = 100, simple string window_type = "Lanczos")=>
    float[] data = get_data(source, length, prefilter)
    var float[] coefficients = sinc_coefficients(length, fc, window_type, centered)

    if bar_index > length
        convolved = convolution(data, coefficients)
    else
        float(na)

// EXAMPLE USAGE
float source = input.source(close, "Source")
string filter_type = input.string("Sinc", "Filter Type", ["Sinc", "SMA", "WMA"])
bool prefilter = input.bool(false, "Pre Filter")
int length = input.int(11, "Source Length", minval = 3)
float fc = input.float(100, "Filter Cutoff", minval = 2)
string window_type = input.string("Lanczos", "Window Style", ["Hann", "Hamming", "Blackman", "Triangular", "Lanczos", "None"])
bool centered = input.bool(true, "Centered")
bool time_offset = input.bool(true, "Offset")

float convolved = lti_filter(filter_type, source, length, prefilter, centered, fc, window_type)

plot(convolved, "Windowed Sinc Low Pass Filter", color.blue, 3, offset = offset(length, time_offset))