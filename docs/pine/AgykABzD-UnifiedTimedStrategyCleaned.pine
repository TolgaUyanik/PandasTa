//@version=6
strategy("UnifiedTimedStrategyCleaned - Manual Time Version", overlay=true, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=2, pyramiding=0, commission_type=strategy.commission.cash_per_contract, commission_value=2.18, slippage=3, process_orders_on_close=false, calc_on_order_fills=true, margin_long=0, margin_short=0)

// =========================
// General
// =========================
tz = input.string("Asia/Jerusalem", "Timezone")

positionSize = input.int(2, "PositionSize", minval=1, maxval=20)

useDailyLossLimitModuleA = input.bool(true, "UseDailyLossLimit_ModuleA")
dailyLossLimitModuleA = input.float(1000, "DailyLossLimit_ModuleA", minval=1)

limitToOneTradeAfterLosingDay = input.bool(true, "LimitToOneTradeAfterLosingDay")

// =========================
// Manual Signal Time
// This is the candle that the strategy checks.
// Entry happens on next bar open.
// Example: 16:40 on 5m chart -> entry around 16:45
// =========================
signalHour = input.int(16, "SignalHour", minval=0, maxval=23)
signalMinute = input.int(40, "SignalMinute", minval=0, maxval=59)

// =========================
// Module A
// =========================
use1645 = input.bool(true, "UseManualTimeModule")
direction1645 = input.string("Both", "Direction", options=["Both", "LongOnly", "ShortOnly"])

moduleAStopLossTicks = input.int(120, "ModuleA_StopLossTicks", minval=1)
moduleATakeProfitTicks = input.int(60, "ModuleA_TakeProfitTicks", minval=1)

tradeLongOnFriday1645 = input.bool(true, "TradeLongOnFriday")
tradeShortOnFriday1645 = input.bool(false, "TradeShortOnFriday")

// =========================
// Day Filters Long
// =========================
tradeLong1645Monday = input.bool(true, "TradeLongMonday")
tradeLong1645Tuesday = input.bool(true, "TradeLongTuesday")
tradeLong1645Wednesday = input.bool(true, "TradeLongWednesday")
tradeLong1645Thursday = input.bool(false, "TradeLongThursday")
tradeLong1645Friday = input.bool(true, "TradeLongFriday")

// =========================
// Day Filters Short
// =========================
tradeShort1645Monday = input.bool(false, "TradeShortMonday")
tradeShort1645Tuesday = input.bool(true, "TradeShortTuesday")
tradeShort1645Wednesday = input.bool(true, "TradeShortWednesday")
tradeShort1645Thursday = input.bool(true, "TradeShortThursday")
tradeShort1645Friday = input.bool(false, "TradeShortFriday")

// =========================
// Internal state
// =========================
var int entryBarIndex = na
var string activeSignal = ""
var bool exitOnNextBarClose = false

var float dayStartNetProfit = na
var float moduleADayStartNetProfit = na

var bool previousTradingDayWasLosingDay = false
var int todayEntryCount = 0
var bool moduleADailyStopHit = false

// =========================
// Time
// =========================
h = hour(time, tz)
m = minute(time, tz)
dow = dayofweek(time, tz)

// Manual signal candle
isSignalBar = h == signalHour and m == signalMinute

// =========================
// Daily reset
// =========================
currentDay = dayofmonth(time, tz)
newDay = ta.change(currentDay) != 0

if na(dayStartNetProfit)
    dayStartNetProfit := strategy.netprofit
    moduleADayStartNetProfit := strategy.netprofit

if newDay
    dayPnL = strategy.netprofit - dayStartNetProfit
    previousTradingDayWasLosingDay := dayPnL < 0

    dayStartNetProfit := strategy.netprofit
    moduleADayStartNetProfit := strategy.netprofit

    todayEntryCount := 0
    moduleADailyStopHit := false
    entryBarIndex := na
    activeSignal := ""
    exitOnNextBarClose := false

// =========================
// Helpers
// =========================
tick = syminfo.mintick
flat = strategy.position_size == 0

moduleADailyPnL = strategy.netprofit - moduleADayStartNetProfit

if useDailyLossLimitModuleA and moduleADailyPnL <= -dailyLossLimitModuleA
    moduleADailyStopHit := true

canTakeNewTradeToday = true

if limitToOneTradeAfterLosingDay and previousTradingDayWasLosingDay and todayEntryCount >= 1
    canTakeNewTradeToday := false

isBullish = close > open
isBearish = close < open
isDoji = close == open

// =========================
// Day filters - Long
// =========================
passesLongDay = true

if dow == dayofweek.monday
    passesLongDay := tradeLong1645Monday
else if dow == dayofweek.tuesday
    passesLongDay := tradeLong1645Tuesday
else if dow == dayofweek.wednesday
    passesLongDay := tradeLong1645Wednesday
else if dow == dayofweek.thursday
    passesLongDay := tradeLong1645Thursday
else if dow == dayofweek.friday
    passesLongDay := tradeLong1645Friday

// =========================
// Day filters - Short
// =========================
passesShortDay = true

if dow == dayofweek.monday
    passesShortDay := tradeShort1645Monday
else if dow == dayofweek.tuesday
    passesShortDay := tradeShort1645Tuesday
else if dow == dayofweek.wednesday
    passesShortDay := tradeShort1645Wednesday
else if dow == dayofweek.thursday
    passesShortDay := tradeShort1645Thursday
else if dow == dayofweek.friday
    passesShortDay := tradeShort1645Friday

passesLongFriday = true
passesShortFriday = true

if dow == dayofweek.friday
    passesLongFriday := tradeLongOnFriday1645
    passesShortFriday := tradeShortOnFriday1645

// =========================
// Reset state after position closed
// =========================
if flat and strategy.position_size[1] != 0
    entryBarIndex := na
    activeSignal := ""
    exitOnNextBarClose := false

// =========================
// Entry
// Signal bar: manual hour/minute
// Entry: next bar open
// =========================
if use1645 and isSignalBar and flat and not isDoji and not moduleADailyStopHit and canTakeNewTradeToday
    if isBullish
        canLong = direction1645 == "Both" or direction1645 == "LongOnly"
        if canLong and passesLongFriday and passesLongDay
            strategy.entry("LongManualTime", strategy.long, qty=positionSize)
            todayEntryCount += 1
            entryBarIndex := bar_index + 1
            activeSignal := "LongManualTime"
            exitOnNextBarClose := true

    if isBearish
        canShort = direction1645 == "Both" or direction1645 == "ShortOnly"
        if canShort and passesShortFriday and passesShortDay
            strategy.entry("ShortManualTime", strategy.short, qty=positionSize)
            todayEntryCount += 1
            entryBarIndex := bar_index + 1
            activeSignal := "ShortManualTime"
            exitOnNextBarClose := true

// =========================
// Exits - Long
// =========================
if strategy.position_size > 0 and activeSignal == "LongManualTime"
    longStop = strategy.position_avg_price - moduleAStopLossTicks * tick
    longLimit = strategy.position_avg_price + moduleATakeProfitTicks * tick
    strategy.exit("Long TP/SL", from_entry="LongManualTime", stop=longStop, limit=longLimit)

// =========================
// Exits - Short
// =========================
if strategy.position_size < 0 and activeSignal == "ShortManualTime"
    shortStop = strategy.position_avg_price + moduleAStopLossTicks * tick
    shortLimit = strategy.position_avg_price - moduleATakeProfitTicks * tick
    strategy.exit("Short TP/SL", from_entry="ShortManualTime", stop=shortStop, limit=shortLimit)

// =========================
// Daily Loss Exit
// =========================
if moduleADailyStopHit and not flat
    if activeSignal == "LongManualTime"
        strategy.close("LongManualTime", comment="ModuleADailyLossExit")
    if activeSignal == "ShortManualTime"
        strategy.close("ShortManualTime", comment="ModuleADailyLossExit")

// =========================
// Exit on next bar close
// =========================
if exitOnNextBarClose and not flat and not na(entryBarIndex) and bar_index >= entryBarIndex + 1
    if activeSignal == "LongManualTime"
        strategy.close("LongManualTime", comment="ExitNextBarClose")
    if activeSignal == "ShortManualTime"
        strategy.close("ShortManualTime", comment="ExitNextBarClose")

// =========================
// Visual marks
// =========================
plotshape(
     use1645 and isSignalBar,
     title="Manual Signal Bar",
     style=shape.circle,
     size=size.tiny,
     location=location.abovebar,
     text="SIG")