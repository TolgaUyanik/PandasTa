//@version=6
// @description Advanced Multi-Level AI Evaluation Engine for Mahjong State Simulation
library("MahjongAIEngine")

// @function Evaluates the hand and returns the optimal discard index based on AI difficulty level.
// @param hand Array of current string tiles.
// @param level AI difficulty level ("Auto: Beginner", "Auto: Normal", "Auto: Pro").
// @param seed Deterministic seed for PRNG.
// @param turn Current turn count for PRNG shifting.
// @returns The index (int) of the optimal tile to discard.
export get_ai_discard(string[] hand, string level, int seed, int turn) =>
    // Pine Script v6 Library Pure-Function compliance (Removed 'var' to prevent state retention)
    string[] ALL_TILES = array.from("🀇","🀈","🀉","🀊","🀋","🀌","🀍","🀎","🀏","🀙","🀚","🀛","🀜","🀝","🀞","🀟","🀠","🀡","🀐","🀑","🀒","🀓","🀔","🀕","🀖","🀗","🀘","🀀","🀁","🀂","🀃","🀄","🀅","🀆")
    string[] TERMINALS = array.from("🀇","🀏","🀙","🀡","🀐","🀘")
    string[] JIHAI_LIST = array.from("🀀","🀁","🀂","🀃","🀄","🀅","🀆")

    int best_idx = 0
    if level == "Auto: Beginner"
        best_idx := (seed + turn * 13) % array.size(hand)
    else
        float max_score = -999.0
        
        for idx = 0 to array.size(hand) - 1
            string t = array.get(hand, idx)
            float score = 0.0
            
            // 1. Base Scoring
            if array.includes(JIHAI_LIST, t)
                score += 50.0
            else if array.includes(TERMINALS, t)
                score += 30.0
            else
                score += 10.0
                
            // 2. Pair/Triplet Protection
            int same_count = 0
            for j = 0 to array.size(hand) - 1
                if array.get(hand, j) == t
                    same_count += 1
            if same_count >= 2
                score -= 100.0
                
            // 3. Pro Logic: Shape Protection (Adjacent Tiles)
            if level == "Auto: Pro" and not array.includes(JIHAI_LIST, t)
                for j = 0 to array.size(hand) - 1
                    if j != idx
                        string other_t = array.get(hand, j)
                        if not array.includes(JIHAI_LIST, other_t)
                            int t_val = array.indexof(ALL_TILES, t)
                            int o_val = array.indexof(ALL_TILES, other_t)
                            if t_val >= 0 and o_val >= 0 and math.abs(t_val - o_val) <= 2
                                score -= 40.0
                                
            if score > max_score
                max_score := score
                best_idx := idx
                
    best_idx
    