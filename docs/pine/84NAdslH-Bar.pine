//@version=6

// @description A comprehensive library for creating and managing custom multi-timeframe (MTF) candlestick bars without using request.security calls, providing enhanced visualization and analytical capabilities with improved performance
library("Bar", overlay = true)

// @type Custom candlestick data structure that stores OHLCV data with visual rendering components
// @field start Opening timestamp of the candle period
// @field end Closing timestamp of the candle period  
// @field o Opening price of the candle
// @field h Highest price reached during the candle period
// @field l Lowest price reached during the candle period
// @field c Closing price of the candle
// @field v Volume traded during the candle period
export type _Candle
    int 	start
    int 	end
    float 	o
    float 	h
    float 	l
    float 	c
    float 	v
	box 	bodyBox 	= na
	line	wickLine 	= na

// @function Creates a new candle object initialized with current bar's OHLC data
// @returns A new _Candle instance with current market data
export Candle() =>
    _Candle.new(time, time, open, high, low, close, 0)

// @function Calculates the absolute size of the candle body (distance between open and close)
// @returns The absolute difference between closing and opening prices
export method body(_Candle this) =>
    math.abs(this.c - this.o)

// @function Calculates the length of the upper wick (shadow above the candle body)
// @returns The distance from the higher of open/close to the high price
export method topWick(_Candle this) =>
    this.h - math.max(this.c, this.o)

// @function Calculates the length of the lower wick (shadow below the candle body)
// @returns The distance from the low price to the lower of open/close
export method bottomWick(_Candle this) =>
    math.min(this.c, this.o) - this.l

// @function Updates candle data with current bar information, extending the time period and adjusting OHLCV values
method update(_Candle this) =>
    this.h := math.max(high, this.h)
    this.l := math.min(low, this.l)
    this.c := close
    this.end := time
    this.v += volume

// @function Renders the candle visually on the chart with customizable colors and styling options
// @param bullishColor Color used for bullish (green) candles when close > open
// @param bearishColor Color used for bearish (red) candles when close < open
// @param transp Transparency level for the candle body (0-100)
// @param borderWidth Width of the border around the candle body
// @param lineWidth Width of the wick lines extending from the body
export method display(_Candle this, color bullishColor = color.green, color bearishColor = color.red, int transp = 70, int borderWidth = 0, int lineWidth = 2) =>
	c = color.new(this.c > this.o ? bullishColor : bearishColor, transp)
	midTime = int(math.avg(this.start, this.end))
	if na(this.bodyBox)
		this.bodyBox := box.new(this.start, this.c, this.end, this.o, xloc = xloc.bar_time, bgcolor = c, border_color = c, border_width = borderWidth)
	else
		this.bodyBox.set_bgcolor(c)
		this.bodyBox.set_right(this.end)
		this.bodyBox.set_top(this.c)

	if na(this.wickLine)
		this.wickLine := line.new(midTime, this.h, midTime, this.l, xloc = xloc.bar_time, color = c, width = lineWidth)
	else
		this.wickLine.set_xy1(midTime, this.h)
		this.wickLine.set_xy2(midTime, this.l)
		this.wickLine.set_color(c)

	this.bodyBox

// @function Creates and manages an array of custom timeframe candles with optional automatic display
// @param tf Target timeframe string (e.g., "60", "240", "D") for candle aggregation
// @param autoDisplay Draws candles automatically
// @param sizeLimit Remove first candle from array if the array size higher than limit for memory save
// @returns Array containing all completed candles for the specified timeframe
export candles(string tf, bool autoDisplay = false, int sizeLimit = na) =>
    var candles = array.new<_Candle>(10)
    var candle = Candle()

    candle.update()

    tf_in_seconds = timeframe.in_seconds(tf)
    new_candle = int(time / 1000) % tf_in_seconds == 0

	if autoDisplay
		candle.display()

    if new_candle
        candles.push(candle)
        candle := Candle()

    if not na(sizeLimit)
        if candles.size() > sizeLimit
            candles.shift()

    candles
