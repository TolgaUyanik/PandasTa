//@version=6
indicator("Anchored Trend Follower", overlay=true, max_lines_count=500)

// ================= INPUTS =================
anchorTimeInput  = input.time(timestamp("2024-01-01 00:00"), "Anchor Point - drag to a low (uptrend) or high (downtrend)", confirm=true)
direction       = input.string("Uptrend", "Direction", options=["Uptrend", "Downtrend"])
leftBars        = input.int(8, "Pivot Left Bars", minval=1, tooltip="Bars needed on each side for a swing point to confirm. Lower = more reactive, higher = ignores more noise.")
rightBars       = input.int(8, "Pivot Right Bars", minval=1, tooltip="Pivot confirms this many bars after it forms - unavoidable lag.")
lineColor       = input.color(color.new(color.lime, 0), "Line Color")
stopOnBreak     = input.bool(false, "Stop following once the trend breaks", tooltip="If off (default), the line just keeps waiting for the next higher low even through minor pullbacks. If on, it freezes permanently the first time a low fails to hold.")

bool isUp = direction == "Uptrend"

// ================= PIVOT DETECTION =================
ph    = ta.pivothigh(high, leftBars, rightBars)
pl    = ta.pivotlow(low, leftBars, rightBars)
phBar = bar_index - rightBars
plBar = bar_index - rightBars

// ================= ANCHOR (set once, from the dragged point) =================
var int   anchorBar   = na
var float anchorPrice = na
var int   snapBar     = na   // current end of the line - the last accepted higher-low / lower-high
var float snapPrice   = na
var bool  broken       = false

if na(anchorBar) and time >= anchorTimeInput
    anchorBar   := bar_index
    anchorPrice := isUp ? low : high
    snapBar     := bar_index
    snapPrice   := anchorPrice

// ================= BOOKKEEPING: most recent pivot of each type =================
var int   curPHBar  = na
var float curPHVal  = na
var int   curPLBar  = na
var float curPLVal  = na
var int   prevPHBar = na   // pivot high immediately before the current one (for the melt-up gap check)
var int   prevPLBar = na   // pivot low immediately before the current one

// ================= FOLLOW THE TREND (only after the anchor is placed) =================
if not na(anchorBar) and not broken

    if isUp
        // -- normal case: a genuine higher low forms -> snap the line to it
        if not na(pl) and plBar > anchorBar
            if pl > snapPrice
                snapBar   := plBar
                snapPrice := pl
            else if stopOnBreak
                // a low broke back through the last higher low -> trend structure failed
                broken := true

        // -- melt-up case: price breaks the previous high with no clear pullback low in between.
        //    Only applies once the trend has genuinely started (at least one higher low already
        //    confirmed) - otherwise the very first pivot high after anchoring would wrongly trigger this.
        if not na(ph) and phBar > anchorBar and snapBar != anchorBar
            int refBar = na(prevPHBar) ? anchorBar : prevPHBar
            bool hadClearLow = not na(curPLBar) and curPLBar > refBar and curPLBar < phBar
            if not hadClearLow
                int gap = phBar - refBar
                if snapBar != anchorBar
                    float slope = (snapPrice - anchorPrice) / (snapBar - anchorBar)
                    anchorBar   := anchorBar + gap
                    anchorPrice := anchorPrice + slope * gap
                else
                    anchorBar := anchorBar + gap
                    snapBar   := snapBar + gap
            prevPHBar := phBar

    else
        // downtrend mirror: normal case is a genuine lower high
        if not na(ph) and phBar > anchorBar
            if ph < snapPrice
                snapBar   := phBar
                snapPrice := ph
            else if stopOnBreak
                broken := true

        // melt-down case: price breaks the previous low with no clear pullback high in between.
        // Same guard - only once the trend has already confirmed at least one real lower high.
        if not na(pl) and plBar > anchorBar and snapBar != anchorBar
            int refBar = na(prevPLBar) ? anchorBar : prevPLBar
            bool hadClearHigh = not na(curPHBar) and curPHBar > refBar and curPHBar < plBar
            if not hadClearHigh
                int gap = plBar - refBar
                if snapBar != anchorBar
                    float slope = (snapPrice - anchorPrice) / (snapBar - anchorBar)
                    anchorBar   := anchorBar + gap
                    anchorPrice := anchorPrice + slope * gap
                else
                    anchorBar := anchorBar + gap
                    snapBar   := snapBar + gap
            prevPLBar := plBar

// keep the pivot bookkeeping updated every bar regardless of anchor state
if not na(pl)
    curPLVal := pl
    curPLBar := plBar
if not na(ph)
    curPHVal := ph
    curPHBar := phBar

// ================= DRAWING =================
var line trendLine = na
if not na(anchorBar) and snapBar != anchorBar
    lineExtend = broken ? extend.none : extend.right
    if na(trendLine)
        trendLine := line.new(anchorBar, anchorPrice, snapBar, snapPrice, xloc=xloc.bar_index,
             color=lineColor, width=2, extend=lineExtend)
    else
        line.set_xy1(trendLine, anchorBar, anchorPrice)
        line.set_xy2(trendLine, snapBar, snapPrice)
        line.set_extend(trendLine, lineExtend)
