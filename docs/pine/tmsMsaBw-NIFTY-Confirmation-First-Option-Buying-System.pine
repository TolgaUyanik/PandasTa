//@version=6
strategy(
     "NIFTY Confirmation-First Option Buying System",
     overlay = true,
     pyramiding = 0,
     initial_capital = 500000,
     process_orders_on_close = true
)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
emaLength     = input.int(20, "EMA Length", minval = 1)
lookback      = input.int(10, "Breakout Lookback", minval = 2)
rrRatio       = input.float(2.0, "Risk : Reward", minval = 1.0, step = 0.25)
maxTradesDay  = input.int(2, "Maximum Trades Per Day", minval = 1)
tradeSession  = input.session("0925-1345", "Entry Session")

// Stop-loss structure
swingLength   = input.int(5, "Stop-Loss Swing Lookback", minval = 1)

// Optional candle extension filter
maxCandleATR  = input.float(1.5, "Maximum Breakout Candle Size (ATR)", step = 0.1)

// ─────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────
ema20 = ta.ema(close, emaLength)
vwap  = ta.vwap(hlc3)
atr   = ta.atr(14)

// Recent breakout levels — previous candles only
recentHigh = ta.highest(high[1], lookback)
recentLow  = ta.lowest(low[1], lookback)

// ─────────────────────────────────────────────
// SESSION & DAILY TRADE COUNTER
// ─────────────────────────────────────────────
inSession = not na(time(timeframe.period, tradeSession))

newDay = ta.change(time("D")) != 0

var int tradesToday = 0

if newDay
    tradesToday := 0

canTrade = inSession and tradesToday < maxTradesDay and strategy.position_size == 0

// ─────────────────────────────────────────────
// CANDLE FILTER
// Avoid abnormally large breakout candles
// ─────────────────────────────────────────────
candleRange = high - low
normalCandle = candleRange <= atr * maxCandleATR

// ─────────────────────────────────────────────
// CE / LONG SIGNAL
// ─────────────────────────────────────────────
bullTrend =
     close > vwap and
     close > ema20

bullBreakout =
     close > recentHigh and
     close > open

ceSignal =
     canTrade and
     bullTrend and
     bullBreakout and
     normalCandle

// ─────────────────────────────────────────────
// PE / SHORT-DIRECTION SIGNAL
// On the underlying chart, a short signal means BUY PE
// ─────────────────────────────────────────────
bearTrend =
     close < vwap and
     close < ema20

bearBreakout =
     close < recentLow and
     close < open

peSignal =
     canTrade and
     bearTrend and
     bearBreakout and
     normalCandle

// ─────────────────────────────────────────────
// STOPS AND TARGETS
// ─────────────────────────────────────────────
longStop  = ta.lowest(low, swingLength)
shortStop = ta.highest(high, swingLength)

longRisk  = close - longStop
shortRisk = shortStop - close

validLongRisk  = longRisk > syminfo.mintick
validShortRisk = shortRisk > syminfo.mintick

var float activeStop   = na
var float activeTarget = na

// ─────────────────────────────────────────────
// CE ENTRY
// ─────────────────────────────────────────────
if ceSignal and validLongRisk
    activeStop   := longStop
    activeTarget := close + (longRisk * rrRatio)

    strategy.entry("BUY CE", strategy.long)
    strategy.exit(
         "CE EXIT",
         from_entry = "BUY CE",
         stop = activeStop,
         limit = activeTarget
    )

    tradesToday += 1

// ─────────────────────────────────────────────
// PE ENTRY
// ─────────────────────────────────────────────
if peSignal and validShortRisk
    activeStop   := shortStop
    activeTarget := close - (shortRisk * rrRatio)

    strategy.entry("BUY PE", strategy.short)
    strategy.exit(
         "PE EXIT",
         from_entry = "BUY PE",
         stop = activeStop,
         limit = activeTarget
    )

    tradesToday += 1

// Keep exits active
if strategy.position_size > 0
    strategy.exit(
         "CE EXIT",
         from_entry = "BUY CE",
         stop = activeStop,
         limit = activeTarget
    )

if strategy.position_size < 0
    strategy.exit(
         "PE EXIT",
         from_entry = "BUY PE",
         stop = activeStop,
         limit = activeTarget
    )

// ─────────────────────────────────────────────
// VISUALS
// ─────────────────────────────────────────────
plot(ema20, "EMA 20", linewidth = 2)
plot(vwap, "VWAP", linewidth = 2)

plot(recentHigh, "Breakout High", style = plot.style_stepline)
plot(recentLow, "Breakout Low", style = plot.style_stepline)

plotshape(
     ceSignal,
     title = "BUY CE Signal",
     text = "BUY CE",
     style = shape.labelup,
     location = location.belowbar,
     size = size.small
)

plotshape(
     peSignal,
     title = "BUY PE Signal",
     text = "BUY PE",
     style = shape.labeldown,
     location = location.abovebar,
     size = size.small
)

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────
alertcondition(
     ceSignal,
     title = "BUY CE Alert",
     message = "BUY CE setup confirmed"
)

alertcondition(
     peSignal,
     title = "BUY PE Alert",
     message = "BUY PE setup confirmed"
)