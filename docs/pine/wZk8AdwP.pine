//@version=6
strategy('10 in 1 MAs + Dashboard + Buy/Sell v6', overlay = true, max_bars_back = 5000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 2)

max_bars_back(close, 5000)
max_bars_back(volume, 5000)

// ============================================================
// === INPUTS (ปรับได้ใน Settings)
// ============================================================
sl_atr_mult = input.float(2.5, 'Stop Loss ATR Multiplier', minval = 1.0, maxval = 5.0, step = 0.5)
tp_atr_mult = input.float(4.0, 'Take Profit ATR Multiplier', minval = 1.0, maxval = 10.0, step = 0.5)
atr_len = input.int(14, 'ATR Length')

// ============================================================
// === MA CALCULATION
// ============================================================
f_ma(src, len, mtype) =>
    if mtype == 'EMA'
        ta.ema(src, len)
    else if mtype == 'RMA'
        ta.rma(src, len)
    else if mtype == 'SMA'
        ta.sma(src, len)
    else if mtype == 'WMA'
        ta.wma(src, len)
    else
        ta.ema(src, len)

ma1 = f_ma(close, 200, 'EMA')
ma2 = f_ma(close, 200, 'RMA')
ma3 = f_ma(close, 50, 'EMA')
ma4 = f_ma(close, 1500, 'EMA')
ma5 = f_ma(close, 250, 'EMA')
ma6 = f_ma(close, 21, 'EMA')
ma7 = f_ma(close, 42, 'EMA')
ma8 = f_ma(close, 100, 'EMA')

plot(ma1, title = 'EMA 200', color = color.white, linewidth = 2)
plot(ma2, title = 'RMA 200', color = color.rgb(255, 105, 180), linewidth = 2)
plot(ma3, title = 'EMA 50', color = color.lime, linewidth = 2)
plot(ma4, title = 'EMA 1500', color = color.blue, linewidth = 2)
plot(ma5, title = 'EMA 250', color = color.orange, linewidth = 2)
plot(ma6, title = 'EMA 21', color = color.yellow, linewidth = 2)
plot(ma7, title = 'EMA 42', color = color.white, linewidth = 1)
plot(ma8, title = 'EMA 100', color = color.aqua, linewidth = 2)

// ============================================================
// === INDICATORS
// ============================================================
atr = ta.atr(atr_len)
rsiVal = ta.rsi(close, 14)
[macdLine, sigLine, macdHist] = ta.macd(close, 12, 26, 9)
volAvg21 = ta.sma(volume, 21)
volAvg63 = ta.sma(volume, 63)
volAvg126 = ta.sma(volume, 126)

// ============================================================
// === MEGA TREND GATE
// ============================================================
megaTrendUp = close > ma4 and close > ma5
longTrendUp = close > ma1 and ma1 > ma1[5]
midTrendUp = close > ma3 and ma3 > ma3[3]
bearLock = not megaTrendUp

// ============================================================
// === BUY CONDITIONS
// ============================================================
trendScore = (megaTrendUp ? 2 : 0) + (longTrendUp ? 1 : 0) + (midTrendUp ? 1 : 0)
emaCross = ta.crossover(ma6, ma7)
macdBull = macdLine > sigLine and macdHist > macdHist[1]
rsiBull = rsiVal > 50 and rsiVal < 72
volSurge = volume > volAvg21 * 1.3
strongCandle = close > open and close - open > atr * 0.4
confirmBull = close > close[1] and close[1] > close[2]

buyScore = trendScore + (emaCross ? 1 : 0) + (macdBull ? 1 : 0) + (rsiBull ? 1 : 0) + (volSurge ? 1 : 0) + (strongCandle ? 1 : 0) + (confirmBull ? 1 : 0)
buySignal = not bearLock and megaTrendUp and longTrendUp and buyScore >= 5

// ============================================================
// === ATR-BASED SL / TP (แก้ไขหลัก)
// ============================================================
var float entryPrice = na
var float stopLoss = na
var float takeProfit = na

// คำนวณ SL/TP ตอน BUY
if buySignal and strategy.position_size == 0
    entryPrice := close
    stopLoss := close - atr * sl_atr_mult // SL = Entry - (ATR x 2.5)
    takeProfit := close + atr * tp_atr_mult // TP = Entry + (ATR x 4.0)
    strategy.entry('BUY', strategy.long)
    strategy.exit('EXIT', 'BUY', stop = stopLoss, limit = takeProfit, comment_loss = 'SL Hit', comment_profit = 'TP Hit')

// Reset เมื่อปิด Position
if strategy.position_size == 0
    entryPrice := na
    stopLoss := na
    takeProfit := na
    takeProfit

// ============================================================
// === SELL CONDITIONS เพิ่มเติม (Trend Break)
// ============================================================
megaBreak = close < ma5
trendBreakDn = close < ma1 or close < ma3 and ma3 < ma3[3]
emaDeadCross = ta.crossunder(ma6, ma7)
macdBear = macdLine < sigLine and macdHist < macdHist[1]
rsiOB = rsiVal > 78
volDist = volume > volAvg21 * 1.5 and close < open and close < close[1]

sellScore = (trendBreakDn ? 2 : 0) + (megaBreak ? 2 : 0) + (emaDeadCross ? 1 : 0) + (macdBear ? 1 : 0) + (rsiOB ? 1 : 0) + (volDist ? 1 : 0)
sellSignal = strategy.position_size > 0 and (sellScore >= 3 or rsiOB or megaBreak)

if sellSignal
    strategy.close('BUY', comment = megaBreak ? 'Mega Break' : rsiOB ? 'RSI OB' : 'Sell Signal')
    entryPrice := na
    stopLoss := na
    takeProfit := na
    takeProfit

// ============================================================
// === PLOT BUY / SELL LABELS
// ============================================================
plotshape(buySignal and strategy.position_size[1] == 0, title = 'BUY', style = shape.labelup, location = location.belowbar, color = color.lime, textcolor = color.black, text = 'BUY', size = size.normal)

plotshape(sellSignal, title = 'SELL', style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, text = 'SELL', size = size.normal)

// === SL Line (แดง) ===
plot(strategy.position_size > 0 and not na(stopLoss) ? stopLoss : na, title = 'Stop Loss', color = color.red, linewidth = 2, style = plot.style_linebr)

// === TP Line (เขียว) ===
plot(strategy.position_size > 0 and not na(takeProfit) ? takeProfit : na, title = 'Take Profit', color = color.lime, linewidth = 2, style = plot.style_linebr)

// === Entry Line (เหลือง) ===
plot(strategy.position_size > 0 and not na(entryPrice) ? entryPrice : na, title = 'Entry Price', color = color.yellow, linewidth = 1, style = plot.style_linebr)

// Bear Zone background
bgcolor(bearLock ? color.new(color.red, 92) : na, title = 'Bear Zone')

// ============================================================
// === DASHBOARD CALCULATIONS
// ============================================================
aboveMA200 = close > ma1
aboveMA50 = close > ma3
aboveMA21 = close > ma6
bullScore2 = (aboveMA200 ? 1 : 0) + (aboveMA50 ? 1 : 0) + (aboveMA21 ? 1 : 0)
signalLabel = bullScore2 >= 2 ? '3. Bull' : bullScore2 == 1 ? '2. Neutral' : '1. Bear'
signalCol = bullScore2 >= 2 ? color.lime : bullScore2 == 1 ? color.yellow : color.red

var int barsInSignal = 0
isBull2 = bullScore2 >= 2
barsInSignal := isBull2 == isBull2[1] ? barsInSignal + 1 : 1

var int bullBarsCount = 0
bullBarsCount := close > open ? bullBarsCount + 1 : 0
bullBarLabel = str.tostring(bullBarsCount) + ' Bars' + (bullScore2 >= 2 ? ' (Current)' : '')

var int underCount = 0
underCount := close < ma1 ? underCount + 1 : 0
underLabel = close < ma1 ? str.tostring(underCount) : 'N/A'

rsiStr = str.tostring(math.round(rsiVal, 2))
rsiCol = rsiVal >= 70 ? color.red : rsiVal <= 30 ? color.aqua : color.white

macdAbove = macdLine > sigLine
macdStr = macdAbove ? 'Above 0' : 'Below 0'
macdCol = macdAbove ? color.lime : color.red

ret30 = bar_index >= 30 ? (close / close[30] - 1) * 100 : na
ret30Str = not na(ret30) ? str.tostring(math.round(ret30, 2)) + '%' : 'N/A'
ret30Col = not na(ret30) ? ret30 >= 0 ? color.lime : color.red : color.gray

ret60 = bar_index >= 60 ? (close / close[60] - 1) * 100 : na
ret60Str = not na(ret60) ? str.tostring(math.round(ret60, 2)) + '%' : 'N/A'
ret60Col = not na(ret60) ? ret60 >= 0 ? color.lime : color.red : color.gray

var float ath = close
ath := math.max(ath, high)
drawdown = (close - ath) / ath * 100
drawdownStr = str.tostring(math.round(drawdown, 2)) + '%'
drawdownCol = drawdown >= -5 ? color.lime : drawdown >= -15 ? color.yellow : color.red

currentYear = year(time)
var float ytdOpen = na
if bar_index == 0 or year(time[1]) < currentYear
    ytdOpen := open
    ytdOpen
ytdRet = not na(ytdOpen) ? (close / ytdOpen - 1) * 100 : na
ytdStr = not na(ytdRet) ? str.tostring(math.round(ytdRet, 2)) + '%' : 'N/A'
ytdCol = not na(ytdRet) ? ytdRet >= 0 ? color.lime : color.red : color.gray

volAvgStr = volume > 1000000 ? str.tostring(math.round(volAvg21 / 1000000, 2)) + 'M' : str.tostring(math.round(volAvg21 / 1000, 1)) + 'K'
volVs3mo = (volume / volAvg63 - 1) * 100
volVs3moStr = str.tostring(math.round(volVs3mo, 2)) + '%'
volVs3moCol = volVs3mo >= 0 ? color.lime : color.red
volVs6mo = (volume / volAvg126 - 1) * 100
volVs6moStr = str.tostring(math.round(volVs6mo, 2)) + '%'
volVs6moCol = volVs6mo >= 0 ? color.lime : color.red

strongBull = not na(ret30) and ret30 > 15 and rsiVal > 60 and macdAbove and close > ma3 and megaTrendUp
accumul = not na(ret30) and ret30 >= 0 and ret30 <= 15 and rsiVal >= 40 and rsiVal <= 60
distrib = not na(ret30) and ret30 < 0 and rsiVal < 50 and volume > volAvg21 * 1.2
clearBear = bearLock and not macdAbove and not na(ret30) and ret30 < -10
behaviorStr = strongBull ? 'เทรนด์ขาขึ้นแรง' : accumul ? 'เทรนด์สะสมราคา' : distrib ? 'รายใหญ่ทยอยขาย' : clearBear ? 'ตลาดเข้าสู่ขาลง' : 'Sideways'
behaviorCol = strongBull ? color.lime : accumul ? color.yellow : distrib ? color.orange : clearBear ? color.red : color.gray

strategyStr = strongBull ? 'ถือ/เพิ่มพอร์ต (Follow Trend)' : accumul ? 'Hold & Monitor' : distrib ? 'Takeprofit / Stop Loss' : clearBear ? 'ห้ามซื้อ / ขายทิ้ง' : 'รอสัญญาณ'
strategyCol = strongBull ? color.lime : accumul ? color.yellow : distrib ? color.orange : clearBear ? color.red : color.gray

buyScoreStr = str.tostring(buyScore) + '/8'
buyScoreCol = buyScore >= 5 ? color.lime : buyScore >= 3 ? color.yellow : color.red
megaGateStr = megaTrendUp ? 'Passed' : 'Bear Lock'
megaGateCol = megaTrendUp ? color.lime : color.red

// SL/TP สำหรับ Dashboard
slStr = strategy.position_size > 0 and not na(stopLoss) ? str.tostring(math.round(stopLoss, 2)) : 'N/A'
tpStr = strategy.position_size > 0 and not na(takeProfit) ? str.tostring(math.round(takeProfit, 2)) : 'N/A'
atrStr = str.tostring(math.round(atr, 2))
riskStr = strategy.position_size > 0 and not na(stopLoss) ? str.tostring(math.round(atr * sl_atr_mult, 2)) + ' (' + str.tostring(sl_atr_mult) + 'x ATR)' : 'N/A'
rewStr = strategy.position_size > 0 and not na(takeProfit) ? str.tostring(math.round(atr * tp_atr_mult, 2)) + ' (' + str.tostring(tp_atr_mult) + 'x ATR)' : 'N/A'

// ============================================================
// === DASHBOARD TABLE
// ============================================================
var table dash = table.new(position.top_right, 2, 24, bgcolor = color.rgb(15, 15, 25, 10), border_color = color.rgb(60, 60, 80), border_width = 1, frame_color = color.rgb(80, 80, 120), frame_width = 2)

if barstate.islast
    table.cell(dash, 0, 0, '  Indicator', text_color = color.white, text_size = size.small, bgcolor = color.rgb(30, 30, 60))
    table.cell(dash, 1, 0, 'Value  ', text_color = color.white, text_size = size.small, bgcolor = color.rgb(30, 30, 60))

    table.cell(dash, 0, 1, 'Signal', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 1, signalLabel, text_color = signalCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 2, 'Bars in Signal', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 2, str.tostring(barsInSignal) + ' Bars', text_color = color.white, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 3, 'Bull Bars', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 3, bullBarLabel, text_color = color.lime, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 4, 'Bars < EMA200', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 4, underLabel, text_color = underCount > 0 ? color.red : color.gray, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 5, 'RSI (14)', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 5, rsiStr, text_color = rsiCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 6, 'MACD (12,26,9)', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 6, macdStr, text_color = macdCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 7, '30D Ret %', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 7, ret30Str, text_color = ret30Col, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 8, '60D Ret %', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 8, ret60Str, text_color = ret60Col, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 9, 'Drawdown (ATH)', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 9, drawdownStr, text_color = drawdownCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 10, 'YTD Return', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 10, ytdStr, text_color = ytdCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 11, 'Vol Avg (21)', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 11, volAvgStr, text_color = color.white, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 12, 'Vol vs 3mo', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 12, volVs3moStr, text_color = volVs3moCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 13, 'Vol vs 6mo', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 13, volVs6moStr, text_color = volVs6moCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 14, 'Behavior', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 14, behaviorStr, text_color = behaviorCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 15, 'Strategy', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 15, strategyStr, text_color = strategyCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)

    table.cell(dash, 0, 16, '── Buy/Sell Signal ──', text_color = color.rgb(120, 120, 160), text_size = size.tiny, bgcolor = color.rgb(15, 15, 30), text_halign = text.align_left)
    table.cell(dash, 1, 16, '', text_color = color.gray, text_size = size.tiny, bgcolor = color.rgb(15, 15, 30))

    table.cell(dash, 0, 17, 'Mega Trend Gate', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 17, megaGateStr, text_color = megaGateCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 18, 'Bear Lock', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 18, bearLock ? 'Active' : 'Off', text_color = bearLock ? color.red : color.lime, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
    table.cell(dash, 0, 19, 'Buy Score', text_color = color.rgb(180, 180, 200), text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_left)
    table.cell(dash, 1, 19, buyScoreStr, text_color = buyScoreCol, text_size = size.small, bgcolor = color.rgb(20, 20, 35), text_halign = text.align_center)
