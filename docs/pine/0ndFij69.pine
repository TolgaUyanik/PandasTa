//@version=6
strategy(
     "SR CHART PATTERN SCALPER V1 - NO REPAINT + METRICS",
     overlay=true,
     initial_capital=10000,
     pyramiding=0,
     commission_type=strategy.commission.percent,
     commission_value=0.0,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_labels_count=500,
     max_lines_count=500
)

//====================================================================
// 1. CONSTANTES
//====================================================================
DIR_NONE = 0
DIR_BUY  = 1
DIR_SELL = -1

//====================================================================
// 2. INPUTS - MODE
//====================================================================
gMode = "═════ 1. MODE ═════"

useSessionFilter = input.bool(
     false,
     "Filtre session",
     group=gMode
)

tz = input.string(
     "America/New_York",
     "Fuseau horaire",
     group=gMode
)

tradeSession = input.session(
     "0300-1130",
     "Session trading NY",
     group=gMode
)

maxTradesPerDay = input.int(
     5,
     "Trades max par jour",
     minval=1,
     maxval=50,
     group=gMode
)

cooldownBars = input.int(
     8,
     "Cooldown en bougies",
     minval=0,
     maxval=100,
     group=gMode
)

maxBarsInTrade = input.int(
     30,
     "Sortie temps max en bougies",
     minval=5,
     maxval=300,
     group=gMode
)

//====================================================================
// 3. INPUTS - SUPPORT / RÉSISTANCE
//====================================================================
gSR = "═════ 2. SUPPORT / RÉSISTANCE ═════"

swingLen = input.int(
     5,
     "Swing length confirmé",
     minval=2,
     maxval=30,
     group=gSR,
     tooltip="Plus la valeur est grande, plus les supports/résistances sont importants mais plus le signal arrive tard."
)

zoneATR = input.float(
     0.40,
     "Tolérance zone S/R en ATR",
     minval=0.05,
     maxval=3.0,
     step=0.05,
     group=gSR
)

maxRetestBars = input.int(
     20,
     "Max bougies pour retest après breakout",
     minval=3,
     maxval=100,
     group=gSR
)

//====================================================================
// 4. INPUTS - FIGURES CHARTISTES
//====================================================================
gPatterns = "═════ 3. FIGURES CHARTISTES ═════"

useDoubleTopBottom = input.bool(
     true,
     "Activer Double Top / Double Bottom",
     group=gPatterns
)

useBreakoutRetest = input.bool(
     true,
     "Activer Breakout + Retest S/R",
     group=gPatterns
)

useRectangleBreakout = input.bool(
     true,
     "Activer Rectangle Breakout",
     group=gPatterns
)

useTriangleBreakout = input.bool(
     true,
     "Activer Triangle Breakout",
     group=gPatterns
)

//====================================================================
// 5. INPUTS - FILTRES
//====================================================================
gFilter = "═════ 4. FILTRES QUALITÉ ═════"

useEMA200Filter = input.bool(
     false,
     "Filtre EMA 200",
     group=gFilter
)

emaTrendLen = input.int(
     200,
     "EMA tendance",
     minval=50,
     maxval=400,
     group=gFilter
)

useADXFilter = input.bool(
     false,
     "Filtre ADX",
     group=gFilter
)

adxLen = input.int(
     14,
     "ADX Length",
     minval=5,
     maxval=50,
     group=gFilter
)

adxSmooth = input.int(
     14,
     "ADX Smoothing",
     minval=5,
     maxval=50,
     group=gFilter
)

minADX = input.float(
     14.0,
     "ADX minimum",
     minval=5,
     maxval=50,
     step=0.5,
     group=gFilter
)

//====================================================================
// 6. INPUTS - MONEY MANAGEMENT
//====================================================================
gRisk = "═════ 5. MONEY MANAGEMENT ═════"

capital = input.float(
     10000.0,
     "Capital référence ($)",
     minval=1,
     group=gRisk
)

riskPercent = input.float(
     0.5,
     "Risque par trade (%)",
     minval=0.05,
     maxval=10,
     step=0.05,
     group=gRisk
)

pipSize = input.float(
     0.1,
     "Taille d'un pip XAUUSD",
     minval=0.00001,
     group=gRisk
)

pointSize = input.float(
     0.01,
     "Taille d'un point",
     minval=0.00001,
     group=gRisk
)

pointValue1Lot = input.float(
     1.0,
     "Valeur $ / point / 1 lot",
     minval=0.00001,
     group=gRisk
)

minLot = input.float(
     0.01,
     "Lot minimum",
     minval=0.00001,
     group=gRisk
)

maxLot = input.float(
     100.0,
     "Lot maximum",
     minval=0.00001,
     group=gRisk
)

lotStep = input.float(
     0.01,
     "Pas de lot",
     minval=0.00001,
     group=gRisk
)

atrLen = input.int(
     14,
     "ATR Length",
     minval=5,
     maxval=100,
     group=gRisk
)

slBufferATR = input.float(
     0.35,
     "Buffer SL au-delà S/R en ATR",
     minval=0.05,
     maxval=3.0,
     step=0.05,
     group=gRisk
)

tpRR = input.float(
     2.0,
     "TP R:R",
     minval=0.5,
     maxval=10,
     step=0.25,
     group=gRisk
)

maxSLPips = input.float(
     250.0,
     "SL max en pips",
     minval=1,
     maxval=1000,
     step=1,
     group=gRisk
)

//====================================================================
// 7. INPUTS - AFFICHAGE
//====================================================================
gView = "═════ 6. AFFICHAGE ═════"

showSR = input.bool(true, "Afficher support / résistance", group=gView)
showEMA = input.bool(true, "Afficher EMA 200", group=gView)
showTradeLines = input.bool(true, "Afficher Entry / SL / TP", group=gView)
showLabels = input.bool(true, "Afficher labels BUY/SELL", group=gView)
showDashboard = input.bool(true, "Afficher dashboard métriques", group=gView)
showSessionBg = input.bool(true, "Colorer session", group=gView)

extendBars = input.int(
     80,
     "Extension lignes",
     minval=20,
     maxval=300,
     group=gView
)

//====================================================================
// 8. COULEURS
//====================================================================
colBuy     = color.rgb(0, 220, 120)
colSell    = color.rgb(255, 70, 90)
colWait    = color.rgb(255, 180, 0)
colText    = color.white
colDark    = color.new(color.black, 0)
colPanel   = color.new(color.gray, 82)
colSupport = color.rgb(0, 220, 120)
colResist  = color.rgb(255, 70, 90)
colEMA200  = color.white
colSL      = color.red
colTP      = color.lime
colMuted   = color.rgb(160, 160, 160)

//====================================================================
// 9. SESSION
//====================================================================
inRawSession = not na(time(timeframe.period, tradeSession, tz))
inSession = not useSessionFilter or inRawSession

bgcolor(showSessionBg and inRawSession ? color.new(color.blue, 93) : na)

sessionDay = dayofmonth(time, tz)
newDay = ta.change(sessionDay) != 0

//====================================================================
// 10. INDICATEURS
//====================================================================
atr = ta.atr(atrLen)
tolerance = atr * zoneATR

emaTrend = ta.ema(close, emaTrendLen)

[plusDI, minusDI, adxValue] = ta.dmi(adxLen, adxSmooth)

adxOk = not useADXFilter or adxValue >= minADX

emaBuyOk = not useEMA200Filter or close > emaTrend
emaSellOk = not useEMA200Filter or close < emaTrend

//====================================================================
// 11. PIVOTS CONFIRMÉS NO-REPAINT
//====================================================================
pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow  = ta.pivotlow(low, swingLen, swingLen)

resistance = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)
prevResistance = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)
thirdResistance = ta.valuewhen(not na(pivotHigh), pivotHigh, 2)

support = ta.valuewhen(not na(pivotLow), pivotLow, 0)
prevSupport = ta.valuewhen(not na(pivotLow), pivotLow, 1)
thirdSupport = ta.valuewhen(not na(pivotLow), pivotLow, 2)

//====================================================================
// 12. SUPPORT / RÉSISTANCE VISUEL
//====================================================================
plot(showSR ? resistance : na, "Résistance confirmée", color=colResist, linewidth=2, style=plot.style_linebr)
plot(showSR ? support : na, "Support confirmé", color=colSupport, linewidth=2, style=plot.style_linebr)

plot(showEMA ? emaTrend : na, "EMA 200", color=colEMA200, linewidth=2)

//====================================================================
// 13. MONEY MANAGEMENT
//====================================================================
f_round_lot(float lot) =>
    float stepped = math.floor(lot / lotStep) * lotStep
    math.max(minLot, math.min(maxLot, stepped))

f_calc_mm(float entry, float sl) =>
    float riskCash  = capital * riskPercent / 100.0
    float riskPrice = math.abs(entry - sl)
    float slPoints  = riskPrice / pointSize

    float rawLot = slPoints > 0 ? riskCash / (slPoints * pointValue1Lot) : na
    float lot    = not na(rawLot) ? f_round_lot(rawLot) : na

    float realRisk = not na(lot) ? slPoints * pointValue1Lot * lot : na
    float qty      = riskPrice > 0 ? riskCash / riskPrice : na

    [lot, realRisk, slPoints, qty]

//====================================================================
// 14. VARIABLES
//====================================================================
var int tradesToday = 0
var int lastTradeBar = na
var int activeEntryBar = na

var bool buyBreakActive = false
var bool sellBreakActive = false

var float buyBreakLevel = na
var float sellBreakLevel = na

var int buyBreakBar = na
var int sellBreakBar = na

var int countDoubleBottom = 0
var int countDoubleTop = 0
var int countBreakoutRetestBuy = 0
var int countBreakoutRetestSell = 0
var int countRectangleBuy = 0
var int countRectangleSell = 0
var int countTriangleBuy = 0
var int countTriangleSell = 0

var int countBuySignals = 0
var int countSellSignals = 0
var int countRejectedSession = 0
var int countRejectedEMA200 = 0
var int countRejectedADX = 0
var int countRejectedRisk = 0
var int countTimeExit = 0

var float lastEntry = na
var float lastSL = na
var float lastTP = na
var float lastLot = na
var float lastRiskDollar = na
var float lastSLPips = na
var float lastRR = na
var int lastDir = DIR_NONE
var string lastPattern = "N/A"

var line entryLine = na
var line slLine = na
var line tpLine = na
var label tradeLabel = na

if newDay
    tradesToday := 0

//====================================================================
// 15. BREAKOUT STATE S/R
//====================================================================
breakAboveResistance =
     barstate.isconfirmed and
     not na(resistance) and
     close > resistance + tolerance and
     close[1] <= resistance + tolerance

breakBelowSupport =
     barstate.isconfirmed and
     not na(support) and
     close < support - tolerance and
     close[1] >= support - tolerance

if breakAboveResistance
    buyBreakActive := true
    buyBreakLevel := resistance
    buyBreakBar := bar_index

if breakBelowSupport
    sellBreakActive := true
    sellBreakLevel := support
    sellBreakBar := bar_index

if buyBreakActive and bar_index - buyBreakBar > maxRetestBars
    buyBreakActive := false
    buyBreakLevel := na
    buyBreakBar := na

if sellBreakActive and bar_index - sellBreakBar > maxRetestBars
    sellBreakActive := false
    sellBreakLevel := na
    sellBreakBar := na

//====================================================================
// 16. FIGURES CHARTISTES NO-REPAINT
//====================================================================

//------------------------------
// Double Bottom
//------------------------------
doubleBottomBuy =
     useDoubleTopBottom and
     barstate.isconfirmed and
     not na(support) and
     not na(prevSupport) and
     not na(resistance) and
     math.abs(support - prevSupport) <= tolerance and
     close > resistance and
     close[1] <= resistance and
     close > open

//------------------------------
// Double Top
//------------------------------
doubleTopSell =
     useDoubleTopBottom and
     barstate.isconfirmed and
     not na(resistance) and
     not na(prevResistance) and
     not na(support) and
     math.abs(resistance - prevResistance) <= tolerance and
     close < support and
     close[1] >= support and
     close < open

//------------------------------
// Breakout + Retest résistance
//------------------------------
breakoutRetestBuy =
     useBreakoutRetest and
     buyBreakActive and
     barstate.isconfirmed and
     bar_index > buyBreakBar and
     bar_index - buyBreakBar <= maxRetestBars and
     low <= buyBreakLevel + tolerance and
     close > buyBreakLevel and
     close > open

//------------------------------
// Breakout + Retest support
//------------------------------
breakoutRetestSell =
     useBreakoutRetest and
     sellBreakActive and
     barstate.isconfirmed and
     bar_index > sellBreakBar and
     bar_index - sellBreakBar <= maxRetestBars and
     high >= sellBreakLevel - tolerance and
     close < sellBreakLevel and
     close < open

//------------------------------
// Rectangle Breakout
//------------------------------
rangeReady =
     not na(resistance) and
     not na(prevResistance) and
     not na(support) and
     not na(prevSupport) and
     math.abs(resistance - prevResistance) <= tolerance and
     math.abs(support - prevSupport) <= tolerance

rangeHigh = math.max(resistance, prevResistance)
rangeLow = math.min(support, prevSupport)

rectangleBuy =
     useRectangleBreakout and
     rangeReady and
     barstate.isconfirmed and
     close > rangeHigh and
     close[1] <= rangeHigh and
     close > open

rectangleSell =
     useRectangleBreakout and
     rangeReady and
     barstate.isconfirmed and
     close < rangeLow and
     close[1] >= rangeLow and
     close < open

//------------------------------
// Triangle Breakout
//------------------------------
triangleReady =
     not na(resistance) and
     not na(prevResistance) and
     not na(thirdResistance) and
     not na(support) and
     not na(prevSupport) and
     not na(thirdSupport) and
     resistance < prevResistance and
     prevResistance < thirdResistance and
     support > prevSupport and
     prevSupport > thirdSupport

triangleBuy =
     useTriangleBreakout and
     triangleReady and
     barstate.isconfirmed and
     close > resistance and
     close[1] <= resistance and
     close > open

triangleSell =
     useTriangleBreakout and
     triangleReady and
     barstate.isconfirmed and
     close < support and
     close[1] >= support and
     close < open

//====================================================================
// 17. SIGNALS BRUTS
//====================================================================
rawBuy =
     doubleBottomBuy or
     breakoutRetestBuy or
     rectangleBuy or
     triangleBuy

rawSell =
     doubleTopSell or
     breakoutRetestSell or
     rectangleSell or
     triangleSell

string buyPatternName =
     doubleBottomBuy ? "DOUBLE BOTTOM" :
     breakoutRetestBuy ? "BREAKOUT RETEST" :
     rectangleBuy ? "RECTANGLE BREAKOUT" :
     triangleBuy ? "TRIANGLE BREAKOUT" :
     "N/A"

string sellPatternName =
     doubleTopSell ? "DOUBLE TOP" :
     breakoutRetestSell ? "BREAKOUT RETEST" :
     rectangleSell ? "RECTANGLE BREAKOUT" :
     triangleSell ? "TRIANGLE BREAKOUT" :
     "N/A"

if doubleBottomBuy
    countDoubleBottom += 1

if doubleTopSell
    countDoubleTop += 1

if breakoutRetestBuy
    countBreakoutRetestBuy += 1

if breakoutRetestSell
    countBreakoutRetestSell += 1

if rectangleBuy
    countRectangleBuy += 1

if rectangleSell
    countRectangleSell += 1

if triangleBuy
    countTriangleBuy += 1

if triangleSell
    countTriangleSell += 1

//====================================================================
// 18. FILTRES D'EXÉCUTION
//====================================================================
noPosition = strategy.position_size == 0
cooldownOk = na(lastTradeBar) or bar_index - lastTradeBar >= cooldownBars
dayLimitOk = tradesToday < maxTradesPerDay

commonOk =
     inSession and
     noPosition and
     cooldownOk and
     dayLimitOk and
     adxOk

buyCandidate =
     rawBuy and
     commonOk and
     emaBuyOk

sellCandidate =
     rawSell and
     commonOk and
     emaSellOk

if barstate.isconfirmed and (rawBuy or rawSell)
    if not inSession
        countRejectedSession += 1
    else if rawBuy and not emaBuyOk or rawSell and not emaSellOk
        countRejectedEMA200 += 1
    else if not adxOk
        countRejectedADX += 1

//====================================================================
// 19. SL / TP PAR SUPPORT RÉSISTANCE
//====================================================================
float buyBase = support
if breakoutRetestBuy
    buyBase := buyBreakLevel
if (rectangleBuy or triangleBuy) and not na(rangeLow)
    buyBase := rangeLow

float sellBase = resistance
if breakoutRetestSell
    sellBase := sellBreakLevel
if (rectangleSell or triangleSell) and not na(rangeHigh)
    sellBase := rangeHigh

entryBuy = close
slBuy = not na(buyBase) ? buyBase - atr * slBufferATR : na
riskBuy = not na(slBuy) ? entryBuy - slBuy : na
tpBuy = not na(riskBuy) ? entryBuy + riskBuy * tpRR : na
slPipsBuy = not na(riskBuy) ? riskBuy / pipSize : na
rrBuy = not na(riskBuy) and riskBuy > 0 ? math.abs(tpBuy - entryBuy) / riskBuy : na

entrySell = close
slSell = not na(sellBase) ? sellBase + atr * slBufferATR : na
riskSell = not na(slSell) ? slSell - entrySell : na
tpSell = not na(riskSell) ? entrySell - riskSell * tpRR : na
slPipsSell = not na(riskSell) ? riskSell / pipSize : na
rrSell = not na(riskSell) and riskSell > 0 ? math.abs(entrySell - tpSell) / riskSell : na

[lotBuy, riskDollarBuy, slPointsBuy, qtyBuy] = f_calc_mm(entryBuy, slBuy)
[lotSell, riskDollarSell, slPointsSell, qtySell] = f_calc_mm(entrySell, slSell)

buyRiskOk =
     buyCandidate and
     not na(riskBuy) and
     riskBuy > 0 and
     slPipsBuy <= maxSLPips and
     not na(qtyBuy) and
     qtyBuy > 0 and
     not na(lotBuy) and
     lotBuy >= minLot

sellRiskOk =
     sellCandidate and
     not na(riskSell) and
     riskSell > 0 and
     slPipsSell <= maxSLPips and
     not na(qtySell) and
     qtySell > 0 and
     not na(lotSell) and
     lotSell >= minLot

if barstate.isconfirmed and buyCandidate and not buyRiskOk
    countRejectedRisk += 1

if barstate.isconfirmed and sellCandidate and not sellRiskOk
    countRejectedRisk += 1

//====================================================================
// 20. EXÉCUTION BUY
//====================================================================
if buyRiskOk
    strategy.entry("BUY", strategy.long, qty=qtyBuy)
    strategy.exit("BUY_EXIT", from_entry="BUY", stop=slBuy, limit=tpBuy)

    tradesToday += 1
    countBuySignals += 1
    lastTradeBar := bar_index
    activeEntryBar := bar_index

    lastEntry := entryBuy
    lastSL := slBuy
    lastTP := tpBuy
    lastLot := lotBuy
    lastRiskDollar := riskDollarBuy
    lastSLPips := slPipsBuy
    lastRR := rrBuy
    lastDir := DIR_BUY
    lastPattern := buyPatternName

    buyBreakActive := false

    if showTradeLines
        if not na(entryLine)
            line.delete(entryLine)
        if not na(slLine)
            line.delete(slLine)
        if not na(tpLine)
            line.delete(tpLine)

        entryLine := line.new(bar_index, lastEntry, bar_index + extendBars, lastEntry, color=colText, width=2, extend=extend.right)
        slLine := line.new(bar_index, lastSL, bar_index + extendBars, lastSL, color=colSL, width=2, extend=extend.right)
        tpLine := line.new(bar_index, lastTP, bar_index + extendBars, lastTP, color=colTP, width=2, extend=extend.right)

    if showLabels
        if not na(tradeLabel)
            label.delete(tradeLabel)

        tradeLabel := label.new(
             bar_index,
             low,
             "BUY VALIDÉ" +
             "\nPattern: " + lastPattern +
             "\nEntry: " + str.tostring(lastEntry, format.mintick) +
             "\nSL: " + str.tostring(lastSL, format.mintick) +
             "\nTP: " + str.tostring(lastTP, format.mintick) +
             "\nRR: " + str.tostring(lastRR, "#.##") +
             "\nLot: " + str.tostring(lastLot, "#.##") +
             "\nRisk: " + str.tostring(lastRiskDollar, "#.##") + " $",
             style=label.style_label_up,
             color=colBuy,
             textcolor=color.black,
             size=size.normal
        )

//====================================================================
// 21. EXÉCUTION SELL
//====================================================================
if sellRiskOk
    strategy.entry("SELL", strategy.short, qty=qtySell)
    strategy.exit("SELL_EXIT", from_entry="SELL", stop=slSell, limit=tpSell)

    tradesToday += 1
    countSellSignals += 1
    lastTradeBar := bar_index
    activeEntryBar := bar_index

    lastEntry := entrySell
    lastSL := slSell
    lastTP := tpSell
    lastLot := lotSell
    lastRiskDollar := riskDollarSell
    lastSLPips := slPipsSell
    lastRR := rrSell
    lastDir := DIR_SELL
    lastPattern := sellPatternName

    sellBreakActive := false

    if showTradeLines
        if not na(entryLine)
            line.delete(entryLine)
        if not na(slLine)
            line.delete(slLine)
        if not na(tpLine)
            line.delete(tpLine)

        entryLine := line.new(bar_index, lastEntry, bar_index + extendBars, lastEntry, color=colText, width=2, extend=extend.right)
        slLine := line.new(bar_index, lastSL, bar_index + extendBars, lastSL, color=colSL, width=2, extend=extend.right)
        tpLine := line.new(bar_index, lastTP, bar_index + extendBars, lastTP, color=colTP, width=2, extend=extend.right)

    if showLabels
        if not na(tradeLabel)
            label.delete(tradeLabel)

        tradeLabel := label.new(
             bar_index,
             high,
             "SELL VALIDÉ" +
             "\nPattern: " + lastPattern +
             "\nEntry: " + str.tostring(lastEntry, format.mintick) +
             "\nSL: " + str.tostring(lastSL, format.mintick) +
             "\nTP: " + str.tostring(lastTP, format.mintick) +
             "\nRR: " + str.tostring(lastRR, "#.##") +
             "\nLot: " + str.tostring(lastLot, "#.##") +
             "\nRisk: " + str.tostring(lastRiskDollar, "#.##") + " $",
             style=label.style_label_down,
             color=colSell,
             textcolor=color.white,
             size=size.normal
        )

//====================================================================
// 22. SORTIE TEMPS POUR MÉTRIQUES
//====================================================================
if strategy.position_size != 0 and not na(activeEntryBar)
    if bar_index - activeEntryBar >= maxBarsInTrade
        strategy.close_all(comment="TIME EXIT")
        countTimeExit += 1

if strategy.position_size == 0 and strategy.position_size[1] != 0
    activeEntryBar := na

//====================================================================
// 23. ALERTES
//====================================================================
alertcondition(buyRiskOk, title="BUY SR CHART PATTERN", message="SR Chart Pattern Scalper: BUY validé.")
alertcondition(sellRiskOk, title="SELL SR CHART PATTERN", message="SR Chart Pattern Scalper: SELL validé.")

//====================================================================
// 24. MÉTRIQUES
//====================================================================
closedTrades = strategy.closedtrades
winTrades = strategy.wintrades
lossTrades = strategy.losstrades

winRate = closedTrades > 0 ? winTrades / closedTrades * 100.0 : na
profitFactor = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
avgTrade = closedTrades > 0 ? strategy.netprofit / closedTrades : na
maxDDPct = capital > 0 ? strategy.max_drawdown / capital * 100.0 : na

stateText =
     strategy.position_size > 0 ? "BUY ACTIF" :
     strategy.position_size < 0 ? "SELL ACTIF" :
     inSession ? "ATTENTE FIGURE" :
     "HORS SESSION"

stateColor =
     strategy.position_size > 0 ? colBuy :
     strategy.position_size < 0 ? colSell :
     inSession ? colWait :
     colMuted

lastDirText =
     lastDir == DIR_BUY ? "BUY" :
     lastDir == DIR_SELL ? "SELL" :
     "N/A"

var table dash = table.new(position.top_right, 2, 38, border_width=1)

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "SR CHART PATTERN", bgcolor=colDark, text_color=colText)
    table.cell(dash, 1, 0, "NO-REPAINT METRICS", bgcolor=colDark, text_color=colText)

    table.cell(dash, 0, 1, "État", bgcolor=colPanel, text_color=colText)
    table.cell(dash, 1, 1, stateText, bgcolor=stateColor, text_color=color.black)

    table.cell(dash, 0, 2, "No repaint", text_color=colText)
    table.cell(dash, 1, 2, "✅ Pivots confirmés + close", text_color=colBuy)

    table.cell(dash, 0, 3, "Support", text_color=colText)
    table.cell(dash, 1, 3, not na(support) ? str.tostring(support, format.mintick) : "N/A", text_color=colSupport)

    table.cell(dash, 0, 4, "Résistance", text_color=colText)
    table.cell(dash, 1, 4, not na(resistance) ? str.tostring(resistance, format.mintick) : "N/A", text_color=colResist)

    table.cell(dash, 0, 5, "Tolérance S/R", text_color=colText)
    table.cell(dash, 1, 5, str.tostring(tolerance, format.mintick), text_color=colWait)

    table.cell(dash, 0, 6, "ADX", text_color=colText)
    table.cell(dash, 1, 6, str.tostring(adxValue, "#.##"), text_color=adxOk ? colBuy : colSell)

    table.cell(dash, 0, 7, "EMA200 filter", text_color=colText)
    table.cell(dash, 1, 7, useEMA200Filter ? "ON" : "OFF", text_color=useEMA200Filter ? colWait : colBuy)

    table.cell(dash, 0, 8, "FIGURES DÉTECTÉES", bgcolor=colPanel, text_color=colText)
    table.cell(dash, 1, 8, "COMPTEURS", bgcolor=colPanel, text_color=colText)

    table.cell(dash, 0, 9, "Double Bottom", text_color=colText)
    table.cell(dash, 1, 9, str.tostring(countDoubleBottom), text_color=countDoubleBottom > 0 ? colBuy : colMuted)

    table.cell(dash, 0, 10, "Double Top", text_color=colText)
    table.cell(dash, 1, 10, str.tostring(countDoubleTop), text_color=countDoubleTop > 0 ? colSell : colMuted)

    table.cell(dash, 0, 11, "Breakout Retest BUY", text_color=colText)
    table.cell(dash, 1, 11, str.tostring(countBreakoutRetestBuy), text_color=countBreakoutRetestBuy > 0 ? colBuy : colMuted)

    table.cell(dash, 0, 12, "Breakout Retest SELL", text_color=colText)
    table.cell(dash, 1, 12, str.tostring(countBreakoutRetestSell), text_color=countBreakoutRetestSell > 0 ? colSell : colMuted)

    table.cell(dash, 0, 13, "Rectangle BUY", text_color=colText)
    table.cell(dash, 1, 13, str.tostring(countRectangleBuy), text_color=countRectangleBuy > 0 ? colBuy : colMuted)

    table.cell(dash, 0, 14, "Rectangle SELL", text_color=colText)
    table.cell(dash, 1, 14, str.tostring(countRectangleSell), text_color=countRectangleSell > 0 ? colSell : colMuted)

    table.cell(dash, 0, 15, "Triangle BUY", text_color=colText)
    table.cell(dash, 1, 15, str.tostring(countTriangleBuy), text_color=countTriangleBuy > 0 ? colBuy : colMuted)

    table.cell(dash, 0, 16, "Triangle SELL", text_color=colText)
    table.cell(dash, 1, 16, str.tostring(countTriangleSell), text_color=countTriangleSell > 0 ? colSell : colMuted)

    table.cell(dash, 0, 17, "SIGNAUX VALIDÉS", bgcolor=colPanel, text_color=colText)
    table.cell(dash, 1, 17, "BUY / SELL", bgcolor=colPanel, text_color=colText)

    table.cell(dash, 0, 18, "BUY / SELL", text_color=colText)
    table.cell(dash, 1, 18, str.tostring(countBuySignals) + " / " + str.tostring(countSellSignals), text_color=colText)

    table.cell(dash, 0, 19, "Trades aujourd'hui", text_color=colText)
    table.cell(dash, 1, 19, str.tostring(tradesToday) + " / " + str.tostring(maxTradesPerDay), text_color=tradesToday < maxTradesPerDay ? colBuy : colSell)

    table.cell(dash, 0, 20, "Sorties temps", text_color=colText)
    table.cell(dash, 1, 20, str.tostring(countTimeExit), text_color=countTimeExit > 0 ? colWait : colMuted)

    table.cell(dash, 0, 21, "DERNIER SIGNAL", bgcolor=colPanel, text_color=colText)
    table.cell(dash, 1, 21, "NIVEAUX", bgcolor=colPanel, text_color=colText)

    table.cell(dash, 0, 22, "Direction", text_color=colText)
    table.cell(dash, 1, 22, lastDirText, text_color=lastDir == DIR_BUY ? colBuy : lastDir == DIR_SELL ? colSell : colWait)

    table.cell(dash, 0, 23, "Pattern", text_color=colText)
    table.cell(dash, 1, 23, lastPattern, text_color=colWait)

    table.cell(dash, 0, 24, "Entry", text_color=colText)
    table.cell(dash, 1, 24, not na(lastEntry) ? str.tostring(lastEntry, format.mintick) : "N/A", text_color=colText)

    table.cell(dash, 0, 25, "SL", text_color=colText)
    table.cell(dash, 1, 25, not na(lastSL) ? str.tostring(lastSL, format.mintick) : "N/A", text_color=colSL)

    table.cell(dash, 0, 26, "TP", text_color=colText)
    table.cell(dash, 1, 26, not na(lastTP) ? str.tostring(lastTP, format.mintick) : "N/A", text_color=colTP)

    table.cell(dash, 0, 27, "R:R", text_color=colText)
    table.cell(dash, 1, 27, not na(lastRR) ? str.tostring(lastRR, "#.##") : "N/A", text_color=colText)

    table.cell(dash, 0, 28, "SL pips", text_color=colText)
    table.cell(dash, 1, 28, not na(lastSLPips) ? str.tostring(lastSLPips, "#.##") : "N/A", text_color=not na(lastSLPips) and lastSLPips <= maxSLPips ? colBuy : colSell)

    table.cell(dash, 0, 29, "Lot / Risque", text_color=colText)
    table.cell(dash, 1, 29, not na(lastLot) ? str.tostring(lastLot, "#.##") + " / " + str.tostring(lastRiskDollar, "#.##") + " $" : "N/A", text_color=colText)

    table.cell(dash, 0, 30, "REJETS", bgcolor=colPanel, text_color=colText)
    table.cell(dash, 1, 30, "VALEURS", bgcolor=colPanel, text_color=colText)

    table.cell(dash, 0, 31, "Rejet session", text_color=colText)
    table.cell(dash, 1, 31, str.tostring(countRejectedSession), text_color=countRejectedSession > 0 ? colSell : colMuted)

    table.cell(dash, 0, 32, "Rejet EMA200", text_color=colText)
    table.cell(dash, 1, 32, str.tostring(countRejectedEMA200), text_color=countRejectedEMA200 > 0 ? colSell : colMuted)

    table.cell(dash, 0, 33, "Rejet ADX", text_color=colText)
    table.cell(dash, 1, 33, str.tostring(countRejectedADX), text_color=countRejectedADX > 0 ? colSell : colMuted)

    table.cell(dash, 0, 34, "Rejet risque", text_color=colText)
    table.cell(dash, 1, 34, str.tostring(countRejectedRisk), text_color=countRejectedRisk > 0 ? colSell : colMuted)

    table.cell(dash, 0, 35, "BACKTEST", bgcolor=colPanel, text_color=colText)
    table.cell(dash, 1, 35, "RÉSULTATS", bgcolor=colPanel, text_color=colText)

    table.cell(dash, 0, 36, "Trades / Winrate / PF", text_color=colText)
    table.cell(dash, 1, 36, str.tostring(closedTrades) + " / " + (not na(winRate) ? str.tostring(winRate, "#.##") + "%" : "N/A") + " / " + (not na(profitFactor) ? str.tostring(profitFactor, "#.##") : "N/A"), text_color=closedTrades > 0 ? colBuy : colWait)

    table.cell(dash, 0, 37, "Net / DD", text_color=colText)
    table.cell(dash, 1, 37, str.tostring(strategy.netprofit, "#.##") + " $ / " + str.tostring(maxDDPct, "#.##") + "%", text_color=strategy.netprofit >= 0 ? colBuy : colSell)