library("MahjongLowYaku", overlay=false)

// ==========================================
// 断么九（タンヤオ）判定
// ==========================================
export is_tanyao(int[] counts) =>
    bool valid = true
    for i = 0 to 33
        if counts.get(i) > 0
            if i >= 27 or (i < 27 and (i % 9 == 0 or i % 9 == 8))
                valid := false
                break
    valid

// ==========================================
// 役牌判定
// ==========================================
export count_yakuhai(int[] counts) =>
    int yakuhai_han = 0
    for i = 27 to 33
        if counts.get(i) >= 3
            yakuhai_han += 1
    yakuhai_han

// ==========================================
// チャンタ（混全帯ヤオ九）/ 純チャン 判定
// ==========================================
export check_chanta_junchan(int[] counts) =>
    bool has_jihai = false
    bool has_19 = false
    bool is_valid = true
    
    // 孤立した中張牌(2~8)だけで構成されたブロックが存在しないかを検証
    // ※完全な判定には面子分解が必要ですが、軽量版として「手牌の構成要素」でフィルタリングします
    for i = 0 to 33
        int c = counts.get(i)
        if c > 0
            if i >= 27
                has_jihai := true
            else
                int mod = i % 9
                if mod == 0 or mod == 8
                    has_19 := true

    // タンヤオ牌（2〜8）のみで構成されている場合はチャンタ系を否定
    if not has_19 and not has_jihai
        is_valid := false
        
    // 役判定（副露を考慮しない門前での簡易判定）
    bool is_chanta = (is_valid and has_19 and has_jihai)
    bool is_junchan = (is_valid and has_19 and not has_jihai)
    
    [is_chanta, is_junchan]