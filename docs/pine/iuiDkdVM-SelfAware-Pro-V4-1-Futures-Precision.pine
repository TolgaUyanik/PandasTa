//@version=6
indicator("SelfAware Pro V4.1 [Futures Precision]", overlay=true, max_labels_count=500)

// ======================================================
// ⚙️ SYSTEM SETTINGS
// ======================================================
swingLength = input.int(20, "Swing Lookback", group="Logic")
emaLength   = input.int(50, "Environment EMA", group="Logic")
tqiWindow   = input.int(20, "Trend Quality Window", group="Logic")

// 🎨 Pro Palette
c_bull   = #00E676, c_bear   = #FF5252, c_blue   = #2962FF
c_orange = #FF9800, c_purple = #9C27B0, c_dark   = #131722
c_white  = #FFFFFF, c_neut   = #808080

// ======================================================
// 🧠 ADAPTIVE ENGINE & SWING DATA
// ======================================================
float change = math.abs(close - close[tqiWindow])
float vol    = math.sum(math.abs(close - close[1]), tqiWindow)
float er     = vol != 0 ? change / vol : 0
float tqi    = math.min(100, er * 100)

// Environment Awareness
ema1h = request.security(syminfo.tickerid, "60", ta.ema(close, emaLength))
isBull = close > ema1h
isBear = close < ema1h

// Swing Data
sHigh  = ta.highest(high, swingLength)
sLow   = ta.lowest(low, swingLength)
sRange = sHigh - sLow
fib50  = sHigh - (sRange * 0.5)

// ======================================================
// ⏳ FUTURES HOLD ENGINE
// ======================================================
atr = ta.atr(14)
fRatio = sRange / atr
string holdTime = fRatio < 1.2 ? "5m-15m" : fRatio < 2.5 ? "30m-45m" : fRatio < 5.0 ? "1h-2h" : fRatio < 10.0 ? "4h-6h" : "EndOfSession"
string tradeType = fRatio < 1.2 ? "MICRO SCALP" : fRatio < 2.5 ? "SCALP" : fRatio < 5.0 ? "INTRADAY" : fRatio < 10.0 ? "SWING" : "DAY TRADE"

// ======================================================
// 🧠 ASSET-SPECIFIC INTELLIGENCE
// ======================================================
string marketChar = "Standard"
float sense      = 25.0 

if syminfo.ticker == "HG" or syminfo.ticker == "MHG" // Copper
    marketChar := "TRENDING", sense := 20.0 
else if syminfo.ticker == "GC" or syminfo.ticker == "MGC" // Gold
    marketChar := "VOLATILE", sense := 30.0 
else if syminfo.currency == "USD" // EURUSD
    marketChar := "STABLE",   sense := 15.0 
else if syminfo.ticker == "RTY" or syminfo.ticker == "M2K" // Russell
    marketChar := "AGGRESSIVE", sense := 35.0 

// ======================================================
// 🎯 PRECISION ENTRIES (Closing Confirmation)
// ======================================================
// Instead of crossover(close), we wait for a green candle CLOSING above fib50 in a Bull regime
longSignal  = isBull and close > fib50 and close[1] <= fib50 and close > open and tqi > sense
shortSignal = isBear and close < fib50 and close[1] >= fib50 and close < open and tqi > sense

// ======================================================
// 📈 WIN-RATE CALCULATION
// ======================================================
var int totalSignals = 0
var int wins = 0
var int lastDir = 0 

if longSignal
    totalSignals += 1
    lastDir := 1
if shortSignal
    totalSignals += 1
    lastDir := -1

if lastDir == 1 and high >= sHigh
    wins += 1
    lastDir := 0
if lastDir == -1 and low <= sLow
    wins += 1
    lastDir := 0

float winRate = totalSignals > 0 ? (wins / float(totalSignals)) * 100 : 0

// ======================================================
// 📊 THE PRO HUD (Sidebar)
// ======================================================
var table hud = table.new(position.top_right, 2, 16, border_width=1, border_color=color.new(c_white, 80))

if barstate.islast
    table.cell(hud, 0, 0, "SelfAware AI",  bgcolor=c_blue,   text_color=c_white)
    table.cell(hud, 1, 0, "V4.1 PRECISION", bgcolor=c_blue,   text_color=c_white)
    table.cell(hud, 0, 1, "Hold Mode",     bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 1, tradeType,        bgcolor=c_purple, text_color=c_white)
    table.cell(hud, 0, 2, "Target Time",   bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 2, holdTime,         bgcolor=c_dark,   text_color=c_white)
    table.cell(hud, 0, 3, "Trend Regime",  bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 3, isBull ? "BULLISH" : "BEARISH", bgcolor=isBull ? c_bull : c_bear, text_color=color.black)
    table.cell(hud, 0, 4, "Win Rate",      bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 4, str.tostring(winRate, "#.0") + "%", bgcolor=winRate > 50 ? c_bull : c_orange, text_color=color.black)
    table.cell(hud, 0, 5, "Candle Power",  bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 5, volume > ta.sma(volume, 20) ? "STRONG" : "WEAK", bgcolor=volume > ta.sma(volume, 20) ? c_bull : c_neut, text_color=color.black)
    table.cell(hud, 0, 6, "Market Type",   bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 6, marketChar,       bgcolor=c_blue,   text_color=c_white)
    table.cell(hud, 0, 7, "TQI Score",     bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 7, str.tostring(tqi, "#.0") + "%", bgcolor=tqi > sense ? c_bull : c_orange, text_color=color.black)
    table.cell(hud, 0, 8, "Status",        bgcolor=c_dark,   text_color=color.gray)
    table.cell(hud, 1, 8, "SCANNING",      bgcolor=c_orange, text_color=c_dark)

// ======================================================
// 🔔 VISUALS
// ======================================================
plot(fib50, "Decision Level", color=color.new(c_white, 40), linewidth=1, style=plot.style_stepline)
bgcolor(isBull ? color.new(c_bull, 94) : color.new(c_bear, 94))

if longSignal
    label.new(bar_index, low, "BUY\nHold: " + holdTime, color=c_bull, textcolor=color.black, style=label.style_label_up, size=size.small)

if shortSignal
    label.new(bar_index, high, "SELL\nHold: " + holdTime, color=c_bear, textcolor=color.white, style=label.style_label_down, size=size.small)