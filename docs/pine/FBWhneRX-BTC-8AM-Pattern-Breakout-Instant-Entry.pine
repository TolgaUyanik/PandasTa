//@version=6
strategy('BTC 8AM Pattern Breakout Instant Entry', overlay = true, pyramiding = 0, process_orders_on_close = false)

// Inputs
tz = input.string('Asia/Kolkata', 'Timezone')
slPts = input.float(100, 'Stop Loss (Points)', minval = 1)
tpPts = input.float(100, 'Take Profit (Points)', minval = 1)
maxTrades = input.int(3, 'Max Trades Per Day', minval = 1)
showEightAMLine = input.bool(true, 'Show 8 AM Line')
showPatternLevels = input.bool(true, 'Show Pattern High/Low')

// Daily reset
newDay = ta.change(dayofmonth(time, tz)) != 0

var int tradesToday = 0
var bool locked = false
var float markHigh = na
var float markLow = na
var line eightLine = na
var label patternLabel = na

if newDay
    tradesToday := 0
    locked := false
    markHigh := na
    markLow := na
    eightLine := na
    patternLabel := na
    patternLabel

// 8 AM marker
is8AM = hour(time, tz) == 8 and minute(time, tz) == 0

if is8AM and showEightAMLine
    eightLine := line.new(bar_index, low, bar_index, high, extend = extend.both, color = color.yellow, width = 1)
    eightLine

bgcolor(is8AM ? color.new(color.blue, 85) : na)

// Start searching for setup after 8:05 AM
after805 = hour(time, tz) > 8 or hour(time, tz) == 8 and minute(time, tz) >= 5

// Pattern conditions
bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEng = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
inside = high < high[1] and low > low[1]
bullMB = inside and close > open
bearMB = inside and close < open

foundPattern = bullEng or bearEng or bullMB or bearMB

// Lock first valid setup candle
if after805 and not locked and foundPattern
    locked := true
    markHigh := high
    markLow := low
    patternLabel := label.new(bar_index, high, 'Setup', style = label.style_label_down, color = color.orange, textcolor = color.black)
    patternLabel

// Instant breakout entry logic
buyBreak = locked and not na(markHigh) and high >= markHigh and high[1] < markHigh
sellBreak = locked and not na(markLow) and low <= markLow and low[1] > markLow

canTrade = tradesToday < maxTrades and strategy.position_size == 0

if buyBreak and canTrade
    strategy.entry('Buy', strategy.long)
    tradesToday := tradesToday + 1
    tradesToday

if sellBreak and canTrade
    strategy.entry('Sell', strategy.short)
    tradesToday := tradesToday + 1
    tradesToday

// Strict fixed SL/TP from actual entry price
if strategy.position_size > 0
    strategy.exit('Buy Exit', 'Buy', stop = strategy.position_avg_price - slPts, limit = strategy.position_avg_price + tpPts)

if strategy.position_size < 0
    strategy.exit('Sell Exit', 'Sell', stop = strategy.position_avg_price + slPts, limit = strategy.position_avg_price - tpPts)

// Visual levels
plot(showPatternLevels and locked ? markHigh : na, 'Pattern High', color = color.green, linewidth = 2, style = plot.style_linebr)
plot(showPatternLevels and locked ? markLow : na, 'Pattern Low', color = color.red, linewidth = 2, style = plot.style_linebr)

// Alerts
alertcondition(foundPattern, 'Pattern Found', 'Setup pattern detected')
alertcondition(buyBreak, 'Buy Breakout', 'Price crossed above setup high')
alertcondition(sellBreak, 'Sell Breakout', 'Price crossed below setup low')
