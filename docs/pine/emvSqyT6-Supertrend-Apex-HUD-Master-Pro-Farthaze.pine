//@version=6
indicator("Supertrend + Apex HUD Master Pro", overlay = true, format = format.price, precision = 2)

// ============================================================================
// SUPERTREND INPUTS
// ============================================================================
grp_st          = "Supertrend Settings"
Periods         = input.int(10, title = "ATR Period", group = grp_st)
Multiplier      = input.float(3.0, title = "ATR Multiplier", step = 0.1, group = grp_st)
showsignals     = input.bool(true, title = "Show Buy/Sell Signals?", group = grp_st)
highlighting    = input.bool(true, title = "Highlighter On/Off?", group = grp_st)
fillColorUp     = input.color(color.green, title = "Highlighter Up Color", group = grp_st)
fillColorDown   = input.color(color.red, title = "Highlighter Down Color", group = grp_st)
fillTransp     = input.int(90, title = "Highlighter Transparency (0-100)", minval = 0, maxval = 100, group = grp_st)

// ============================================================================
// APEX HUD INPUTS
// ============================================================================
grp_hud         = "Apex HUD Table"
showHud         = input.bool(true, title = "Show Apex HUD Table", group = grp_hud)
hudPos          = input.string("Top Right", title = "HUD Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grp_hud)
t_size          = input.string(size.small, title = "HUD Text Size", options = [size.tiny, size.small, size.normal, size.large], group = grp_hud)
rsiLen          = input.int(14, title = "RSI Length (Momentum)", group = grp_hud)
volLen          = input.int(20, title = "Volume MA Length (RVOL)", group = grp_hud)
sessionFilter   = input.string("All Sessions", title = "Shares Traded Session Filter", options = ["All Sessions", "Regular Hours Only", "Premarket Only", "Postmarket Only"], group = grp_hud)

// ============================================================================
// TECHNICAL INDICATOR INPUTS
// ============================================================================
grp_tech        = "Technical & Target Levels"
emaFastLen      = input.int(9, title = "Fast EMA Length", group = grp_tech)
emaSlowLen      = input.int(20, title = "Slow EMA Length", group = grp_tech)
tp1Mult         = input.float(1.0, title = "TP1 ATR Multiplier", step = 0.5, group = grp_tech)
tp2Mult         = input.float(2.0, title = "TP2 ATR Multiplier", step = 0.5, group = grp_tech)
tp3Mult         = input.float(3.0, title = "TP3 ATR Multiplier", step = 0.5, group = grp_tech)

// ============================================================================
// VOLATILITY SPIKE INPUTS
// ============================================================================
grp_spk         = "Volatility Spike Table"
showSpikeTable  = input.bool(true, title = "Show Volatility Spike Table", group = grp_spk)
spikePos        = input.string("Bottom Right", title = "Spike Table Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grp_spk)
spikeMultiplier = input.float(2.0, title = "Spike ATR Multiplier", group = grp_spk)
bullColorInput  = input.color(color.lime, title = "Bullish Spike Color", group = grp_spk)
bearColorInput  = input.color(color.red, title = "Bearish Spike Color", group = grp_spk)

// ============================================================================
// NATIVE SUPERTREND ENGINE
// ============================================================================
[stVal, stDir] = ta.supertrend(Multiplier, Periods)

bool isBull = stDir < 0
bool isBear = stDir > 0

buySignal  = isBull and isBear[1]
sellSignal = isBear and isBull[1]

// Supertrend Line Plotting
stPlot = plot(stVal, title = "Supertrend Line", color = isBull ? color.green : color.red, linewidth = 2)

// Buy / Sell Labels
plotshape(buySignal and showsignals, title = "Buy Label", text = "BUY", location = location.belowbar, style = shape.labelup, size = size.tiny, color = color.green, textcolor = color.white)
plotshape(sellSignal and showsignals, title = "Sell Label", text = "SELL", location = location.abovebar, style = shape.labeldown, size = size.tiny, color = color.red, textcolor = color.white)

// Price Midpoint Anchor for Highlighting
bodyMiddle = plot((open + close) / 2, title = "Mid Anchor", display = display.none)

longFillColor  = highlighting and isBull ? color.new(fillColorUp, fillTransp) : color.new(color.white, 100)
shortFillColor = highlighting and isBear ? color.new(fillColorDown, fillTransp) : color.new(color.white, 100)

fill(bodyMiddle, stPlot, title = "UpTrend Highlighter", color = longFillColor)
fill(bodyMiddle, stPlot, title = "DownTrend Highlighter", color = shortFillColor)

// ============================================================================
// TECHNICAL DATA CALCULATIONS
// ============================================================================
atr = ta.atr(Periods)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaCrossUp   = ta.crossover(emaFast, emaSlow)
emaCrossDown = ta.crossunder(emaFast, emaSlow)
emaBullish   = emaFast > emaSlow

// Previous Day & Today High/Low Levels
pdh = request.security(syminfo.tickerid, "D", high[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

tdh = request.security(syminfo.tickerid, "D", high, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
tdl = request.security(syminfo.tickerid, "D", low, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

prevDayClose = request.security(syminfo.tickerid, "D", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
dayOpen      = request.security(syminfo.tickerid, "D", open, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
gapPercent   = not na(prevDayClose) and prevDayClose != 0 ? ((dayOpen - prevDayClose) / prevDayClose) * 100 : 0.0

volMA   = ta.sma(volume, volLen)
rvolVal = volMA > 0 ? (volume / volMA) * 100 : 100.0

f_formatVol(val) =>
    if val >= 1000000000
        str.tostring(val / 1000000000, "#.##") + "B"
    else if val >= 1000000
        str.tostring(val / 1000000, "#.##") + "M"
    else if val >= 1000
        str.tostring(val / 1000, "#.#") + "K"
    else
        str.tostring(val, "#")

isRegular    = session.ismarket
isPremarket  = session.ispremarket
isPostmarket = session.ispostmarket

var float sessionVolume  = 0.0
var float sessionBuyVol  = 0.0
var float sessionSellVol = 0.0

if not na(ta.change(time("D"))) and ta.change(time("D")) != 0
    sessionVolume  := 0.0
    sessionBuyVol  := 0.0
    sessionSellVol := 0.0

bool countVolume = switch sessionFilter
    "Regular Hours Only" => isRegular
    "Premarket Only"     => isPremarket
    "Postmarket Only"    => isPostmarket
    => true

// Buyer & Seller Volume Intra-bar Estimation
float barRangeVal = high - low
float buyRatio    = barRangeVal > 0 ? (close - low) / barRangeVal : 0.5
float sellRatio   = 1.0 - buyRatio

float currentBuyVol  = nz(volume) * buyRatio
float currentSellVol = nz(volume) * sellRatio

if countVolume == true
    sessionVolume  += nz(volume)
    sessionBuyVol  += currentBuyVol
    sessionSellVol += currentSellVol

// ============================================================================
// HUD SUPPORTING CALCS
// ============================================================================
rsi_val   = ta.rsi(close, rsiLen)
c_text    = color.white
c_bull    = color.green
c_bear    = color.red
c_neu     = color.gray
col_fill  = isBull ? c_bull : c_bear

stopLevel  = stVal
entryPrice = close
tp1 = isBull ? entryPrice + (atr * tp1Mult) : entryPrice - (atr * tp1Mult)
tp2 = isBull ? entryPrice + (atr * tp2Mult) : entryPrice - (atr * tp2Mult)
tp3 = isBull ? entryPrice + (atr * tp3Mult) : entryPrice - (atr * tp3Mult)

riskDist   = math.abs(close - stopLevel)
rewardDist = atr * tp2Mult
rr_ratio   = riskDist != 0 ? rewardDist / riskDist : na

// ============================================================================
// VOLATILITY SPIKE SUPPORTING CALCS
// ============================================================================
barRange  = high - low
isSpike   = barRange > (atr * spikeMultiplier)
spikeSize = open != 0 ? ((close - open) / open) * 100 : na

isBullSpike = isSpike and close > open
isBearSpike = isSpike and close < open

var float lastBullSize  = na
var float lastBullPrice = na
var float lastBearSize  = na
var float lastBearPrice = na

if isBullSpike
    lastBullSize  := spikeSize
    lastBullPrice := close

if isBearSpike
    lastBearSize  := spikeSize
    lastBearPrice := close

getPosition(posString) =>
    switch posString
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

// ============================================================================
// APEX HUD TABLE (Compact 4-Column Layout with Merged Cells)
// ============================================================================
var table hud = table.new(getPosition(hudPos), 4, 12)

if showHud and barstate.islast
    // Header Row Merging
    table.merge_cells(hud, 0, 0, 1, 0)
    table.merge_cells(hud, 2, 0, 3, 0)
    table.cell(hud, 0, 0, "APEX MASTER", text_color = c_text, bgcolor = color.new(col_fill, 20), text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 2, 0, "LIVE", text_color = c_text, bgcolor = color.new(col_fill, 20), text_size = t_size, text_halign = text.align_right)

    // Standard Rows Merged Across Columns 1..3 to Keep Text Tight
    table.merge_cells(hud, 1, 1, 3, 1)
    t_txt = isBull ? "BULLISH" : "BEARISH"
    table.cell(hud, 0, 1, "Trend Bias", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 1, t_txt, text_color = col_fill, text_size = t_size, text_halign = text.align_right)

    table.merge_cells(hud, 1, 2, 3, 2)
    mom_txt = rsi_val > 60 ? "STRONG (" + str.tostring(rsi_val, "#") + ")" : rsi_val < 40 ? "WEAK (" + str.tostring(rsi_val, "#") + ")" : "NEUTRAL (" + str.tostring(rsi_val, "#") + ")"
    mom_col = rsi_val > 60 ? c_bull : rsi_val < 40 ? c_bear : c_neu
    table.cell(hud, 0, 2, "Momentum", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 2, mom_txt, text_color = mom_col, text_size = t_size, text_halign = text.align_right)

    table.merge_cells(hud, 1, 3, 3, 3)
    volCombinedStr = f_formatVol(volume) + " (" + str.tostring(rvolVal, "#") + "% RVOL)"
    vol_col = rvolVal >= 150 ? c_bull : rvolVal <= 75 ? c_bear : c_neu
    table.cell(hud, 0, 3, "Volume (RVOL)", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 3, volCombinedStr, text_color = vol_col, text_size = t_size, text_halign = text.align_right)

    table.merge_cells(hud, 1, 4, 3, 4)
    table.cell(hud, 0, 4, "Shares Traded", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 4, f_formatVol(sessionVolume), text_color = c_text, text_size = t_size, text_halign = text.align_right)

    // Tightly Spaced Buy / Sell Volume Row
    table.cell(hud, 0, 5, "Buy / Sell Vol", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 5, "B: " + f_formatVol(sessionBuyVol), text_color = c_bull, text_size = t_size, text_halign = text.align_right)
    table.cell(hud, 2, 5, "/", text_color = c_text, text_size = t_size, text_halign = text.align_center)
    table.cell(hud, 3, 5, "S: " + f_formatVol(sessionSellVol), text_color = c_bear, text_size = t_size, text_halign = text.align_left)

    table.merge_cells(hud, 1, 6, 3, 6)
    gapStr = (gapPercent >= 0 ? "+" : "") + str.tostring(gapPercent, "#.##") + "%"
    gapCol = gapPercent > 0 ? c_bull : gapPercent < 0 ? c_bear : c_neu
    table.cell(hud, 0, 6, "Gap %", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 6, gapStr, text_color = gapCol, text_size = t_size, text_halign = text.align_right)

    table.merge_cells(hud, 1, 7, 3, 7)
    emaStatusStr = emaBullish ? "EMA9 > EMA20 ✓" : "EMA9 < EMA20 ✗"
    emaStatusCol = emaBullish ? c_bull : c_bear
    table.cell(hud, 0, 7, "EMA Cross", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 7, emaStatusStr, text_color = emaStatusCol, text_size = t_size, text_halign = text.align_right)

    table.merge_cells(hud, 1, 8, 3, 8)
    pdhPdlStr = "PDH: " + str.tostring(pdh, "#.##") + " / PDL: " + str.tostring(pdl, "#.##")
    table.cell(hud, 0, 8, "Prev Day Range", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 8, pdhPdlStr, text_color = c_text, text_size = t_size, text_halign = text.align_right)

    table.merge_cells(hud, 1, 9, 3, 9)
    tdhTdlStr = "TDH: " + str.tostring(tdh, "#.##") + " / TDL: " + str.tostring(tdl, "#.##")
    table.cell(hud, 0, 9, "Today's Range", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 9, tdhTdlStr, text_color = c_text, text_size = t_size, text_halign = text.align_right)

    table.merge_cells(hud, 1, 10, 3, 10)
    tpCombinedStr = "TP1: " + str.tostring(tp1, "#.##") + " | TP2: " + str.tostring(tp2, "#.##") + " | TP3: " + str.tostring(tp3, "#.##")
    table.cell(hud, 0, 10, "Take Profit Targets", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 10, tpCombinedStr, text_color = c_bull, text_size = t_size, text_halign = text.align_right)

    table.merge_cells(hud, 1, 11, 3, 11)
    rr_display = na(rr_ratio) ? "-" : str.tostring(rr_ratio, "#.#") + ":1"
    table.cell(hud, 0, 11, "Risk:Reward", text_color = c_text, text_size = t_size, text_halign = text.align_left)
    table.cell(hud, 1, 11, rr_display, text_color = c_bull, text_size = t_size, text_halign = text.align_right)

// ============================================================================
// VOLATILITY SPIKE TABLE
// ============================================================================
var table debugTable = table.new(getPosition(spikePos), 4, 3)

if showSpikeTable and barstate.islast
    table.cell(debugTable, 0, 0, "Spike Type", text_color = color.white, text_size = size.normal, bgcolor = color.new(color.gray, 50))
    table.cell(debugTable, 2, 0, "Size (%)", text_color = color.white, text_size = size.normal, bgcolor = color.new(color.gray, 50))
    table.cell(debugTable, 3, 0, "Price", text_color = color.white, text_size = size.normal, bgcolor = color.new(color.gray, 50))

    table.cell(debugTable, 0, 1, "Last Bullish", text_color = bullColorInput, text_size = size.normal, text_font_family = font.family_monospace)
    table.cell(debugTable, 2, 1, na(lastBullSize) ? "-" : str.tostring(lastBullSize, "+#.##") + "%", text_color = bullColorInput, text_size = size.normal)
    table.cell(debugTable, 3, 1, na(lastBullPrice) ? "-" : str.tostring(lastBullPrice, "#.##"), text_color = color.white, text_size = size.normal)

    table.cell(debugTable, 0, 2, "Last Bearish", text_color = bearColorInput, text_size = size.normal, text_font_family = font.family_monospace)
    table.cell(debugTable, 2, 2, na(lastBearSize) ? "-" : str.tostring(lastBearSize, "#.##") + "%", text_color = bearColorInput, text_size = size.normal)
    table.cell(debugTable, 3, 2, na(lastBearPrice) ? "-" : str.tostring(lastBearPrice, "#.##"), text_color = color.white, text_size = size.normal)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(buySignal, title = "SuperTrend Buy", message = "SuperTrend Buy Signal!")
alertcondition(sellSignal, title = "SuperTrend Sell", message = "SuperTrend Sell Signal!")
alertcondition(emaCrossUp, title = "EMA Fast Cross Above Slow", message = "EMA 9 crossed above EMA 20!")
alertcondition(emaCrossDown, title = "EMA Fast Cross Below Slow", message = "EMA 9 crossed below EMA 20!")