//@version=6
//@description Monitors script execution time against TradingView plan timeout limits. Displays a visual debug table showing runtime metrics, percentage of limit used, and color-coded status warnings. Helps Pine Script developers optimize indicators for different subscription tiers (Basic: 20s, Essential/Plus/Premium: 40s, Ultimate: 100s).
library("PlanLimitTimer", overlay = true)

// ============================================================================
// CONSTANTS - TradingView Plan Timeout Limits (in seconds)
// ============================================================================

//@variable Timeout limit for Basic plan accounts (20 seconds)
export const int LIMIT_BASIC = 20

//@variable Timeout limit for Essential plan accounts (40 seconds)
export const int LIMIT_ESSENTIAL = 40

//@variable Timeout limit for Plus plan accounts (40 seconds)
export const int LIMIT_PLUS = 40

//@variable Timeout limit for Premium plan accounts (40 seconds)
export const int LIMIT_PREMIUM = 40

//@variable Timeout limit for Ultimate plan accounts (100 seconds)
export const int LIMIT_ULTIMATE = 100

// ============================================================================
// TYPES
// ============================================================================

//@type Contains timing statistics and plan limit information for script performance analysis
//@field totalTimeMs Total measured execution time in milliseconds
//@field timePerBarMs Average execution time per bar in milliseconds
//@field barsTimed Number of historical bars that were included in timing measurement
//@field barsSkipped Number of bars excluded from timing (typically realtime bars)
//@field planLimitMs The selected plan's timeout limit converted to milliseconds
//@field percentUsed Percentage of plan limit consumed (0 to 100+, can exceed 100 if over limit)
//@field status Status indicator string with values OK, WARNING, DANGER, or EXCEEDED
export type TimingStats
    float  totalTimeMs
    float  timePerBarMs
    int    barsTimed
    int    barsSkipped
    int    planLimitMs
    float  percentUsed
    string status

// ============================================================================
// INTERNAL HELPER FUNCTIONS
// ============================================================================

// Converts plan name string to timeout limit in milliseconds
getPlanLimitMs(string plan) =>
    switch str.lower(plan)
        "basic"     => LIMIT_BASIC * 1000
        "essential" => LIMIT_ESSENTIAL * 1000
        "plus"      => LIMIT_PLUS * 1000
        "premium"   => LIMIT_PREMIUM * 1000
        "ultimate"  => LIMIT_ULTIMATE * 1000
        => LIMIT_BASIC * 1000

// Determines status string based on percentage of limit used
getStatus(float pctUsed) =>
    if pctUsed >= 100
        "EXCEEDED"
    else if pctUsed >= 80
        "DANGER"
    else if pctUsed >= 50
        "WARNING"
    else
        "OK"

// Returns appropriate color for status indicator
getStatusColor(string status) =>
    switch status
        "OK"       => color.green
        "WARNING"  => color.yellow
        "DANGER"   => color.orange
        "EXCEEDED" => color.red
        => color.gray

// ============================================================================
// EXPORTED FUNCTIONS
// ============================================================================

//@function Captures the starting timestamp for timing measurement. Must be called at the very beginning of your script, before any calculations.
//@returns (int) Unix timestamp in milliseconds to be passed to getStats() or debugTiming()
export startTimer() =>
    timenow

//@function Calculates comprehensive timing statistics by comparing start time to current time and evaluating against plan limits.
//@param startTime (int) The timestamp value returned by startTimer()
//@param plan (string) TradingView subscription tier: "basic", "essential", "plus", "premium", or "ultimate"
//@returns (TimingStats) Object containing totalTimeMs, timePerBarMs, barsTimed, barsSkipped, planLimitMs, percentUsed, and status
export getStats(int startTime, string plan) =>
    int endTime = timenow
    int elapsed = endTime - startTime
    int totalBars = bar_index + 1
    bool isRealtime = barstate.isrealtime or barstate.islastconfirmedhistory

    float totalMs = float(elapsed)
    float perBarMs = totalBars > 0 ? totalMs / totalBars : 0.0
    int limitMs = getPlanLimitMs(plan)
    float pctUsed = limitMs > 0 ? (totalMs / limitMs) * 100 : 0.0

    TimingStats stats = TimingStats.new()
    stats.totalTimeMs  := totalMs
    stats.timePerBarMs := perBarMs
    stats.barsTimed    := isRealtime ? totalBars - 1 : totalBars
    stats.barsSkipped  := isRealtime ? 1 : 0
    stats.planLimitMs  := limitMs
    stats.percentUsed  := pctUsed
    stats.status       := getStatus(pctUsed)
    stats

//@function Renders a debug table on the chart displaying all timing statistics with color-coded status indicators.
//@param stats (TimingStats) Statistics object obtained from getStats()
//@param plan (string) Plan name to display in the table header
//@param tablePosition (string) Chart position for table placement using position.* constants (default: position.top_right)
//@param showOnlyOnLast (bool) When true, table renders only on the last bar for better performance (default: true)
export showTimingTable(TimingStats stats, string plan, string tablePosition = position.top_right, bool showOnlyOnLast = true) =>
    if (not showOnlyOnLast) or barstate.islast
        var table debugTable = table.new(tablePosition, 2, 8, bgcolor = color.new(color.black, 80), border_width = 1)

        table.cell(debugTable, 0, 0, "TIMING DEBUG", text_color = color.white, text_size = size.normal, bgcolor = color.new(color.blue, 60), text_halign = text.align_center)
        table.merge_cells(debugTable, 0, 0, 1, 0)

        string planDisplay = str.upper(plan) + " Plan"
        table.cell(debugTable, 0, 1, "Plan", text_color = color.gray, text_size = size.small)
        table.cell(debugTable, 1, 1, planDisplay, text_color = color.white, text_size = size.small)

        string limitDisplay = str.tostring(stats.planLimitMs / 1000) + "s"
        table.cell(debugTable, 0, 2, "Limit", text_color = color.gray, text_size = size.small)
        table.cell(debugTable, 1, 2, limitDisplay, text_color = color.white, text_size = size.small)

        string timeDisplay = stats.totalTimeMs >= 1000 ? str.tostring(stats.totalTimeMs / 1000, "#.##") + " s" : str.tostring(stats.totalTimeMs, "#.##") + " ms"
        table.cell(debugTable, 0, 3, "Runtime", text_color = color.gray, text_size = size.small)
        table.cell(debugTable, 1, 3, timeDisplay, text_color = color.white, text_size = size.small)

        string perBarDisplay = str.tostring(stats.timePerBarMs, "#.####") + " ms/bar"
        table.cell(debugTable, 0, 4, "Per Bar", text_color = color.gray, text_size = size.small)
        table.cell(debugTable, 1, 4, perBarDisplay, text_color = color.white, text_size = size.small)

        string barsDisplay = str.tostring(stats.barsTimed) + (stats.barsSkipped > 0 ? " (" + str.tostring(stats.barsSkipped) + " skipped)" : "")
        table.cell(debugTable, 0, 5, "Bars", text_color = color.gray, text_size = size.small)
        table.cell(debugTable, 1, 5, barsDisplay, text_color = color.white, text_size = size.small)

        string pctDisplay = str.tostring(stats.percentUsed, "#.#") + "%"
        color pctColor = getStatusColor(stats.status)
        table.cell(debugTable, 0, 6, "% Used", text_color = color.gray, text_size = size.small)
        table.cell(debugTable, 1, 6, pctDisplay, text_color = pctColor, text_size = size.small, bgcolor = color.new(pctColor, 85))

        table.cell(debugTable, 0, 7, "Status", text_color = color.gray, text_size = size.small)
        table.cell(debugTable, 1, 7, stats.status, text_color = getStatusColor(stats.status), text_size = size.small, bgcolor = color.new(getStatusColor(stats.status), 85))

//@function Convenience function that combines getStats() and showTimingTable() into a single call. Place at the end of your script.
//@param startTime (int) The timestamp value returned by startTimer()
//@param plan (string) TradingView subscription tier name (default: "basic")
//@param tablePosition (string) Chart position for the debug table (default: position.top_right)
//@returns (TimingStats) The calculated statistics object for additional programmatic use
export debugTiming(int startTime, string plan = "basic", string tablePosition = position.top_right) =>
    TimingStats stats = getStats(startTime, plan)
    showTimingTable(stats, plan, tablePosition)
    stats

//@function Checks whether script execution time is approaching or has exceeded the plan timeout threshold.
//@param stats (TimingStats) Statistics object obtained from getStats()
//@param threshold (float) Percentage threshold that triggers a true return value (default: 80.0)
//@returns (bool) True if percentUsed is greater than or equal to the threshold
export isApproachingLimit(TimingStats stats, float threshold = 80.0) =>
    stats.percentUsed >= threshold

//@function Calculates the remaining time available before reaching the plan timeout limit.
//@param stats (TimingStats) Statistics object obtained from getStats()
//@returns (float) Milliseconds remaining until limit is reached (negative value indicates limit exceeded)
export getRemainingMs(TimingStats stats) =>
    float(stats.planLimitMs) - stats.totalTimeMs

//@function Creates a compact single-line summary string suitable for labels, tooltips, or log output.
//@param stats (TimingStats) Statistics object obtained from getStats()
//@returns (string) Formatted string in the pattern "Xms / Ys (Z%) - STATUS"
export formatSummary(TimingStats stats) =>
    str.tostring(stats.totalTimeMs, "#") + "ms / " + str.tostring(stats.planLimitMs / 1000) + "s (" + str.tostring(stats.percentUsed, "#.#") + "%) - " + stats.status

//@function Creates a chart label displaying timing statistics with color-coded status. Useful for visual debugging without the full table.
//@param stats (TimingStats) Statistics object obtained from getStats()
//@param barIdx (int) Bar index where the label should be placed (typically bar_index)
//@param price (float) Price level where the label should be placed (typically high or low)
//@param labelStyle (string) Label style using label.style_* constants (default: label.style_label_down)
//@param textSize (string) Text size using size.* constants (default: size.small)
//@returns (label) The created label object for further customization if needed
export addTimingLabel(TimingStats stats, int barIdx, float price, string labelStyle = label.style_label_down, string textSize = size.small) =>
    color labelColor = switch stats.status
        "OK"       => color.green
        "WARNING"  => color.yellow
        "DANGER"   => color.orange
        "EXCEEDED" => color.red
        => color.gray

    string labelText = "Runtime: " + str.tostring(stats.totalTimeMs, "#.##") + "ms\n" +
                       "Limit: " + str.tostring(stats.planLimitMs / 1000) + "s\n" +
                       "Used: " + str.tostring(stats.percentUsed, "#.#") + "%\n" +
                       "Status: " + stats.status

    label.new(barIdx, price, labelText,
              color = labelColor,
              textcolor = color.white,
              style = labelStyle,
              size = textSize)

// ============================================================================
// EXAMPLE USAGE - Demonstrates library functions with sample indicator code
// ============================================================================

//@variable Enable demo visualization (set to true to see example output)
bool DEMO_ENABLED = false

// Sample indicator floats
float smaFast = na
float smaSlow = na
float rsiValue = na
float atrValue = na

if DEMO_ENABLED
    // Capture start time immediately
    int startTime = startTimer()

    // Sample indicator calculations to demonstrate timing
    smaFast   := ta.sma(close, 10)
    smaSlow   := ta.sma(close, 50)
    rsiValue  := ta.rsi(close, 14)
    atrValue  := ta.atr(14)
    [macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

    // Get timing statistics
    TimingStats stats = getStats(startTime, "basic")

    // Display timing debug table
    showTimingTable(stats, "basic", position.top_right)

    // Demonstrate addTimingLabel - creates a label on the last bar
    if barstate.islast
        addTimingLabel(stats, bar_index, high)

// DEMO Plot sample indicators
plot(smaFast, "SMA Fast", color.blue)
plot(smaSlow, "SMA Slow", color.orange)