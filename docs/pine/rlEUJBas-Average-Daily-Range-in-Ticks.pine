//@version=5
indicator("Average Daily Range in Ticks", shorttitle="ADR Ticks", overlay=true)

// Input for the number of days to average
length = input.int(14, title="Average Days", minval=1)

// Fetch daily high and low
daily_high = request.security(syminfo.tickerid, "D", high)
daily_low = request.security(syminfo.tickerid, "D", low)

// Calculate daily range in price
daily_range = daily_high - daily_low

// Calculate average daily range
adr = ta.sma(daily_range, length)

// Convert to ticks using the symbol's minimum tick size
tick_size = syminfo.mintick
adr_ticks = adr / tick_size

// Plot the average in ticks (kept for reference in a pane)
plot(adr_ticks, title="ADR in Ticks", color=color.blue, linewidth=2)

// Display the ADR in ticks in a table on the main chart canvas
var table adrTable = table.new(position = position.top_right, columns = 1, rows = 1, bgcolor = color.new(color.blue, 0), frame_color = color.blue, frame_width = 1)

if barstate.islast
    table.cell(adrTable, column = 0, row = 0, text = "ADR Ticks: " + str.tostring(math.round(adr_ticks)), text_color = color.white, bgcolor = color.new(color.blue, 90))