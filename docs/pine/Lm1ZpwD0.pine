// ------------------------------------------------------------------------------------------------------------------------------------------------------ //
// Description:                                                                                                                                           //
// This script calculates MVRV in both "Normal" and "Z-Score" variants. It is designed to display multiple assets simultaneously, with a modular display, //
// optional percentage scaling, and an optimized structure for easy adaptation.                                                                           //
// ------------------------------------------------------------------------------------------------------------------------------------------------------ //

//@version=6
indicator('MVRV Altcoins', 'MVRV', false)

// Main settings for the MVRV Altcoins indicator: select the calculation type, visualizations, and thresholds.
// These allow you to customize the visual and technical analysis to suit your preferences.
version                = input.string('Normal', 'Version', options = ['Normal', 'Z-Score'], inline = 'mvrv1', group = 'MVRV Z SCORE Altcoins')
view_percentage_scale  = input.bool(true, 'View in Percentage Scale',                       inline = 'mvrv1', group = 'MVRV Z SCORE Altcoins')
oversold_normal        = input.float(1,   'Oversold (Normal)',    step = 0.01,              inline = 'mvrv2', group = 'MVRV Z SCORE Altcoins')
overbought_normal      = input.float(3.5, 'Overbought (Normal)',  step = 0.01,              inline = 'mvrv2', group = 'MVRV Z SCORE Altcoins')
oversold_z_score       = input.float(0,   'Oversold (Z-Score)',   step = 0.01,              inline = 'mvrv3', group = 'MVRV Z SCORE Altcoins')
overbought_z_score     = input.float(6,   'Overbought (Z-Score)', step = 0.01,              inline = 'mvrv3', group = 'MVRV Z SCORE Altcoins')

// Percentage scale factor depending on the selected version.
percentage_scale = if view_percentage_scale
    if version == 'Normal'
        100 / 3.5
    else
        100 / 6
else
    1

// Main function to calculate the MVRV of the given asset: Obtains the active market cap by combining Free Float and Active Supply, along with the realized market cap.
// Calculates the MVRV in "Normal" or "Z-Score" mode depending on the selected version, applying percentage scaling if active.
give_me_mvrv(crypto) =>
    active_capitalization   = request.security('COINMETRICS:' + crypto + '_MARKETCAPFF', 'D', close) + request.security('COINMETRICS:' + crypto + '_MARKETCAPACTSPLY', 'D', close)
    capitalization_realized = request.security('COINMETRICS:' + crypto + '_MARKETCAPREAL', 'D', close)
    var capitalization = array.new<float>()
    array.push(capitalization, active_capitalization)
    standard_deviation = array.stdev(capitalization)
    mvrv = if version == 'Normal'
        active_capitalization / capitalization_realized * percentage_scale
    else
        (active_capitalization - capitalization_realized) / standard_deviation * percentage_scale
    [mvrv]

// Checks if the current ticker matches the selected asset. Checks if the symbol contains the crypto name plus "USD" to trigger specific conditions.
is_crypto(crypto) =>
    crypto_active = str.contains(syminfo.tickerid, crypto + 'USD')
    [crypto_active]

// Function calls
[btc_MVRV]   = give_me_mvrv('BTC')
[ada_MVRV]   = give_me_mvrv('ADA')
[bch_MVRV]   = give_me_mvrv('BCH')
[crv_MVRV]   = give_me_mvrv('CRV')
[doge_MVRV]  = give_me_mvrv('DOGE')
[dot_MVRV]   = give_me_mvrv('DOT')
[eth_MVRV]   = give_me_mvrv('ETH')
[link_MVRV]  = give_me_mvrv('LINK')
[ltc_MVRV]   = give_me_mvrv('LTC')
[neo_MVRV]   = give_me_mvrv('NEO')
[uni_MVRV]   = give_me_mvrv('UNI')
[xlm_MVRV]   = give_me_mvrv('XLM')
[xrp_MVRV]   = give_me_mvrv('XRP')

[btc_active]   = is_crypto('BTC')
[ada_active]   = is_crypto('ADA')
[bch_active]   = is_crypto('BCH')
[crv_active]   = is_crypto('CRV')
[doge_active]  = is_crypto('DOGE')
[dot_active]   = is_crypto('DOT')
[eth_active]   = is_crypto('ETH')
[link_active]  = is_crypto('LINK')
[ltc_active]   = is_crypto('LTC')
[neo_active]   = is_crypto('NEO')
[uni_active]   = is_crypto('UNI')
[xlm_active]   = is_crypto('XLM')
[xrp_active]   = is_crypto('XRP')

// Assigns the value to MVRV for printing.
MVRV = if btc_active
    btc_MVRV
else if ada_active
    ada_MVRV
else if bch_active
    bch_MVRV
else if crv_active
    crv_MVRV
else if doge_active
    doge_MVRV
else if dot_active
    dot_MVRV
else if eth_active
    eth_MVRV
else if link_active
    link_MVRV
else if ltc_active
    ltc_MVRV
else if neo_active
    neo_MVRV
else if uni_active
    uni_MVRV
else if xlm_active
    xlm_MVRV
else if xrp_active
    xrp_MVRV
else
    btc_MVRV

// Defines the threshold levels for overbought and undervalued values based on the active mode, applying percentage scaling if enabled.
bottom_line = version == 'Normal' ? oversold_normal * percentage_scale   : oversold_z_score * percentage_scale
top_line    = version == 'Normal' ? overbought_normal * percentage_scale : overbought_z_score * percentage_scale

// A conditional color is assigned to the MVRV based on its position relative to these thresholds, and guide lines are drawn.
color_mvrv = MVRV < bottom_line ? color.green : MVRV > top_line ? color.red : color.yellow
plot(MVRV, 'MVRV', color_mvrv, 2, plot.style_line)
plot(bottom_line, 'Bottom Line', color.green, 1, plot.style_stepline)
plot(top_line,    'Top Line',    color.red,   1, plot.style_stepline)


// ------------------------------------------------------------------------------------------------------------ Multicrypto Table
// Visual and structural configuration of the multi-asset table:
// Allows you to activate the display, define its position on the screen, adjust the text size,
// customize the header and body colors, and apply a decorative color as a center separator.
// The table has been designed to display multiple assets simultaneously in a modular style.
view_table       = input.bool(true, 'View Table', inline = 'table1', group = 'Multicrypto Table')
position_table_1 = input.string('bottom-left', 'Posición', options = ['bottom-middle', 'bottom-left', 'bottom-right', 'middle-middle', 'middle-left', 'middle-right', 'top-middle', 'top-left', 'top-right'], inline = 'table2', group = 'Multicrypto Table')
position_table   = switch position_table_1
    'bottom-middle' => position.bottom_center
    'bottom-left'   => position.bottom_left
    'bottom-right'  => position.bottom_right
    'middle-middle' => position.middle_center
    'middle-left'   => position.middle_left
    'middle-right'  => position.middle_right
    'top-middle'    => position.top_center
    'top-left'      => position.top_left
    'top-right'     => position.top_right
font_size_1 = input.string('small', 'Size', options = ['tiny', 'small', 'normal', 'big'], inline = 'table2', group = 'Multicrypto Table')
font_size   = switch font_size_1
    'tiny'   => size.tiny
    'small'  => size.small
    'normal' => size.normal
    'large'  => size.large

var multicrypto_table = table.new(position_table, 19, 7, border_width = 1, frame_color = color.gray, border_color = color.gray)

header_color_background = input.color(#6cb9f8, 'Header Color (background)',      inline = 'table3', group = 'Multicrypto Table')
header_color_text       = input.color(#000000, '...(text)',                      inline = 'table3', group = 'Multicrypto Table')
body_color_background   = input.color(#f8ea6a, 'Body Color (background)',        inline = 'table4', group = 'Multicrypto Table')
body_color_text         = input.color(#000000, '...(text)',                      inline = 'table4', group = 'Multicrypto Table')
color_between_tables    = input.color(#7e3901, 'Color Separator between Tables', inline = 'table5', group = 'Multicrypto Table')

multicrypto_table.cell(0, 0, "BTC",                                     height = 8, bgcolor = header_color_background, text_color = header_color_text, text_size = font_size)
multicrypto_table.cell(1, 0,  str.tostring(math.round(btc_MVRV[7], 1)), height = 8, bgcolor = body_color_background,   text_color = body_color_text,   text_size = font_size)
multicrypto_table.cell(2, 0,  str.tostring(math.round(btc_MVRV[6], 1)), height = 8, bgcolor = body_color_background,   text_color = body_color_text,   text_size = font_size)
multicrypto_table.cell(3, 0,  str.tostring(math.round(btc_MVRV[5], 1)), height = 8, bgcolor = body_color_background,   text_color = body_color_text,   text_size = font_size)
multicrypto_table.cell(4, 0,  str.tostring(math.round(btc_MVRV[4], 1)), height = 8, bgcolor = body_color_background,   text_color = body_color_text,   text_size = font_size)
multicrypto_table.cell(5, 0,  str.tostring(math.round(btc_MVRV[3], 1)), height = 8, bgcolor = body_color_background,   text_color = body_color_text,   text_size = font_size)
multicrypto_table.cell(6, 0,  str.tostring(math.round(btc_MVRV[2], 1)), height = 8, bgcolor = body_color_background,   text_color = body_color_text,   text_size = font_size)
multicrypto_table.cell(7, 0,  str.tostring(math.round(btc_MVRV[1], 1)), height = 8, bgcolor = body_color_background,   text_color = body_color_text,   text_size = font_size)
multicrypto_table.cell(8, 0,  str.tostring(math.round(btc_MVRV,    1)), height = 8, bgcolor = body_color_background,   text_color = body_color_text,   text_size = font_size)

multicrypto_table.cell(0, 1, "ADA",                                     height = 8, bgcolor = header_color_background, text_color = header_color_text, text_size = font_size)
multicrypto_table.cell(1, 1,  str.tostring(math.round(ada_MVRV[7], 1)), height = 8, bgcolor = body_color_background,   text_color = body_color_text,   text_size = font_size)
