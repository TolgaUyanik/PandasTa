//@version=6
strategy("XAUUSD Şok Söndürücü Stratejisi (Gerçek Broker Simülasyonu)", overlay=true, initial_capital=1000, default_qty_type=strategy.fixed, margin_long=0.2, margin_short=0.2, commission_type=strategy.commission.cash_per_order, commission_value=0)

// --- 1. KASA VE RİSK YÖNETİMİ ---
lotMiktari = input.float(0.10, title="Lot Miktarı", step=0.01, group="1. Kasa ve Risk Yönetimi", tooltip="Açılacak lot büyüklüğü. (Örn: 0.10 Lot = 10 Ons)")

// Scalping hedefleri (TAMAMEN USD BAZLI)
microTarget = input.float(0.5, title="Mikro Hedef (USD)", step=0.1, group="1. Kasa ve Risk Yönetimi")
microStopLoss = input.float(1.5, title="Mikro Zarar (USD)", step=0.1, group="1. Kasa ve Risk Yönetimi")

// --- 2. İNDİKATÖR AYARLARI ---
lookback = input.int(1000, title="Referans Veri Seti (Mum Sayısı)", group="2. İndikatör Ayarları")
shockMultiplier = input.float(3.0, title="Fiyat Şok Çarpanı (Standart Sapma)", group="2. İndikatör Ayarları")
volumeMultiplier = input.float(1.5, title="Hacim Patlaması Çarpanı", group="2. İndikatör Ayarları")
cooldownBars = input.int(1, title="Sinyal Bekleme Süresi (Mum)", minval=1, group="2. İndikatör Ayarları")

// --- 3. SAAT FİLTRESİ ---
restrictedSession1 = input.session("1500-1600", title="1. İşlem YASAKLI Saatler (TRT)", group="3. Saat Filtresi")
restrictedSession2 = input.session("0100-0200", title="2. İşlem YASAKLI Saatler (TRT)", group="3. Saat Filtresi")
timeZone = input.string("Europe/Istanbul", title="Saat Dilimi", group="3. Saat Filtresi")

// --- HESAPLAMALAR ---
// Lot miktarını ons'a çeviriyoruz (1 Lot = 100 Ons XAUUSD)
onsMiktari = lotMiktari * 100

// Fiyat Volatilite Hesaplamaları
candleSpread = high - low
avgSpread = ta.sma(candleSpread, lookback)
devSpread = ta.stdev(candleSpread, lookback)

// Hacim Hesaplamaları
avgVolume = ta.sma(volume, lookback)

// Şok, Yön ve Hacim Tespiti
isPriceShock = candleSpread > (nz(avgSpread) + (nz(devSpread) * shockMultiplier))
isVolumeShock = volume > (nz(avgVolume) * volumeMultiplier) 

isShock = isPriceShock and isVolumeShock
isGreen = close > open
isRed   = close < open

// Saat Kontrolü
inRestrictedZone1 = time(timeframe.period, restrictedSession1, timeZone)
inRestrictedZone2 = time(timeframe.period, restrictedSession2, timeZone)
canTrade = na(inRestrictedZone1) and na(inRestrictedZone2)

// Peş Peşe Sinyal Engelleyici
var int lastSignalBar = -1000 
isAllowed = isShock and canTrade and (bar_index - lastSignalBar > cooldownBars)

// --- STRATEJİ YÖNETİMİ ---
if isAllowed and strategy.position_size == 0
    if isRed
        strategy.entry("Şok_Long", strategy.long, qty=onsMiktari)
        tp_price = close + microTarget
        sl_price = close - microStopLoss 
        strategy.exit("Çıkış_Long", "Şok_Long", limit=tp_price, stop=sl_price)
        lastSignalBar := bar_index
        
    else if isGreen
        strategy.entry("Şok_Short", strategy.short, qty=onsMiktari)
        tp_price = close - microTarget
        sl_price = close + microStopLoss 
        strategy.exit("Çıkış_Short", "Şok_Short", limit=tp_price, stop=sl_price)
        lastSignalBar := bar_index

// --- GÖRSEL ---
bgcolor(isAllowed ? color.new(color.blue, 90) : na, title="Şok Vurgusu")

// --- GÜNCEL KASA VE WINRATE TABLOSU (SAĞ ALT PANEL) ---
var table mainTable = table.new(position.bottom_right, 2, 5, border_width = 1, border_color=color.new(color.gray, 50), frame_color=color.new(color.gray, 50), frame_width=1)

if barstate.islast
    int totalTrades = strategy.closedtrades
    int winTrades = 0
    
    if totalTrades > 0
        for i = 0 to totalTrades - 1
            if strategy.closedtrades.profit(i) > 0
                winTrades += 1
                
    float winRate = totalTrades > 0 ? (winTrades / totalTrades) * 100 : 0.0
    
    // Parasal İstatistikler (Gerçek Bakiye)
    float gercekBaslangic = strategy.initial_capital
    float netKazanilan = strategy.netprofit
    float guncelKasa = gercekBaslangic + netKazanilan
    
    table.cell(mainTable, 0, 0, "Başlangıç Bakiyesi", text_color=color.white, bgcolor=color.new(color.black, 20), text_halign=text.align_left)
    table.cell(mainTable, 1, 0, str.tostring(gercekBaslangic, "#.##") + " $", text_color=color.yellow, bgcolor=color.new(color.black, 20), text_halign=text.align_right)

    table.cell(mainTable, 0, 1, "Güncel Kasa", text_color=color.white, bgcolor=color.new(color.black, 20), text_halign=text.align_left)
    table.cell(mainTable, 1, 1, str.tostring(guncelKasa, "#.##") + " $", text_color=guncelKasa >= gercekBaslangic ? color.green : color.red, bgcolor=color.new(color.black, 20), text_halign=text.align_right)

    table.cell(mainTable, 0, 2, "Net Kâr / Zarar", text_color=color.white, bgcolor=color.new(color.black, 20), text_halign=text.align_left)
    table.cell(mainTable, 1, 2, (netKazanilan > 0 ? "+" : "") + str.tostring(netKazanilan, "#.##") + " $", text_color=netKazanilan >= 0 ? color.green : color.red, bgcolor=color.new(color.black, 20), text_halign=text.align_right)

    table.cell(mainTable, 0, 3, "WinRate (Başarı)", text_color=color.white, bgcolor=color.new(color.blue, 20), text_halign=text.align_left)
    table.cell(mainTable, 1, 3, "%" + str.tostring(winRate, "#.##"), text_color=winRate >= 50 ? color.green : color.red, bgcolor=color.new(color.blue, 20), text_halign=text.align_right)
    
    table.cell(mainTable, 0, 4, "Başarılı / Toplam", text_color=color.white, bgcolor=color.new(color.black, 20), text_halign=text.align_left)
    table.cell(mainTable, 1, 4, str.tostring(winTrades) + " / " + str.tostring(totalTrades), text_color=color.yellow, bgcolor=color.new(color.black, 20), text_halign=text.align_right)
