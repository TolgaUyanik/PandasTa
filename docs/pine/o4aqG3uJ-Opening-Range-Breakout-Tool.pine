//@version=6
// ============================================================================
// Opening Range Breakout Tool  ·  v1.0
// ----------------------------------------------------------------------------
// WHAT IT DOES : Builds the opening range (high, low and midpoint) from the
//                first N minutes of a trading session you define, draws it on
//                the chart with an optional shaded box, and marks the first
//                bar that closes (or wicks) beyond either side of the range.
//                One signal per side per session.
// HOW TO USE   : Intraday charts only, with the chart timeframe at or below
//                the range duration (e.g. a 1-15 minute chart for a 15-minute
//                range). Defaults to the US equity cash session, 09:30 New
//                York time; the session and timezone are fully configurable,
//                and because the session is anchored to a named timezone the
//                range stays correct across daylight-saving changes.
// ALERTS       : "Opening range set" (optional), "OR high broken", "OR low
//                broken" - all evaluated on bar close, once per session per
//                side. Create the alert with condition "Any alert() function
//                call" and "Once Per Bar Close".
//
// This is a charting tool. It does not predict markets and nothing here is
// financial advice. Test it on your own charts before relying on it.
// ============================================================================
indicator("Opening Range Breakout Tool", overlay=true,
     max_boxes_count=100, max_lines_count=300, max_labels_count=100)

// ---- Inputs: Display -------------------------------------------------------
grpDisp    = "Display"
colUp      = input.color(color.new(color.teal, 0),   "Breakout up colour",   group=grpDisp)
colDn      = input.color(color.new(color.orange, 0), "Breakout down colour", group=grpDisp)
colRange   = input.color(color.new(color.gray, 0),   "Range line colour",    group=grpDisp)
colBoxBg   = input.color(color.new(color.gray, 88),  "Range box fill",       group=grpDisp)
lineWidth  = input.int(1, "Line width", minval=1, maxval=4, group=grpDisp)
showBox    = input.bool(true, "Show opening-range box", group=grpDisp,
     tooltip="Shades the bars that formed the range.")
showMid    = input.bool(true, "Show midpoint line", group=grpDisp,
     tooltip="Dashed line halfway between the range high and low.")
showLabels = input.bool(true, "Show price labels", group=grpDisp,
     tooltip="Prints the range high/low prices at the right edge of the chart.")

// ---- Inputs: Opening Range -------------------------------------------------
grpOr        = "Opening Range"
sessInp      = input.session("0930-1600", "Trading session", group=grpOr,
     tooltip="Session hours in the timezone below, HHMM-HHMM. The range is built from the session OPEN; the end time is where the levels stop extending.")
tzInp        = input.string("America/New_York", "Session timezone", group=grpOr,
     options=["America/New_York", "America/Chicago", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "Asia/Hong_Kong", "Australia/Sydney", "UTC"],
     tooltip="Session times are read in this timezone, so the range stays correct year-round across daylight-saving changes.")
orMinutes    = input.int(15, "Opening range duration (minutes)", minval=1, maxval=240, group=grpOr,
     tooltip="How many minutes after the session open the range is built from. Keep the chart timeframe at or below this value.")
confirmClose = input.bool(true, "Require CLOSE beyond the range", group=grpOr,
     tooltip="On: a breakout needs a bar close beyond the level. Off: any wick beyond the level counts (still evaluated at bar close).")

// ---- Inputs: Alerts --------------------------------------------------------
grpAl        = "Alerts"
alertOnSet   = input.bool(false, "Alert when the range is set", group=grpAl,
     tooltip="Fires once per session, on the first bar after the range window completes.")
alertOnBreak = input.bool(true, "Alert on breakouts", group=grpAl,
     tooltip="Fires once per session per side, on the bar that first breaks the range.")

// ---- Core logic: session + range state --------------------------------------
sessTime   = time(timeframe.period, sessInp, tzInp)
inSession  = not na(sessTime)
newSession = inSession and na(sessTime[1])

var int   sessStartTime = na
var int   orStartBar    = na
var float orHigh        = na
var float orLow         = na
var bool  orLocked      = false
var bool  upDone        = false
var bool  dnDone        = false

if newSession
    sessStartTime := time
    orStartBar    := bar_index
    orHigh        := high
    orLow         := low
    orLocked      := false
    upDone        := false
    dnDone        := false

inOrWindow = inSession and not na(sessStartTime) and time < sessStartTime + orMinutes * 60000

if inOrWindow
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)

orMid = (orHigh + orLow) / 2

// The first in-session bar after the window completes locks the range.
// Latch immediately so a breakout can fire on the lock bar itself.
orJustSet = inSession and not orLocked and not inOrWindow and not na(orHigh)
if orJustSet
    orLocked := true

// ---- Core logic: breakouts (one per side per session) -----------------------
srcUp   = confirmClose ? close : high
srcDn   = confirmClose ? close : low
brokeUp = orLocked and inSession and not upDone and srcUp > orHigh
brokeDn = orLocked and inSession and not dnDone and srcDn < orLow
if brokeUp
    upDone := true
if brokeDn
    dnDone := true

// ---- Drawing -----------------------------------------------------------------
// One set of handles per session; prior sessions' objects stay on the chart
// (history) and age out via the declared object budgets.
var box  orBox = na
var line lnHi  = na
var line lnLo  = na
var line lnMid = na

if orJustSet
    rangeEndBar = math.max(orStartBar, bar_index - 1)
    if showBox
        orBox := box.new(orStartBar, orHigh, rangeEndBar, orLow, border_color=color.new(colRange, 60), bgcolor=colBoxBg)
    lnHi := line.new(rangeEndBar, orHigh, bar_index, orHigh, color=colRange, width=lineWidth)
    lnLo := line.new(rangeEndBar, orLow, bar_index, orLow, color=colRange, width=lineWidth)
    if showMid
        lnMid := line.new(rangeEndBar, orMid, bar_index, orMid, color=color.new(colRange, 40), width=lineWidth, style=line.style_dashed)

if orLocked and inSession and not na(lnHi)
    line.set_x2(lnHi, bar_index)
    line.set_x2(lnLo, bar_index)
    if showMid and not na(lnMid)
        line.set_x2(lnMid, bar_index)

var label lbHi = na
var label lbLo = na
if showLabels and barstate.islast and orLocked
    label.delete(lbHi)
    label.delete(lbLo)
    lbHi := label.new(bar_index, orHigh, "OR H  " + str.tostring(orHigh, format.mintick),
         style=label.style_label_left, color=color.new(colRange, 80), textcolor=colRange, size=size.small)
    lbLo := label.new(bar_index, orLow, "OR L  " + str.tostring(orLow, format.mintick),
         style=label.style_label_left, color=color.new(colRange, 80), textcolor=colRange, size=size.small)

// Structural markers use plotshape (no object budget, correct anchoring).
plotshape(brokeUp, "OR breakout up",   shape.triangleup,   location.belowbar, colUp, size=size.small)
plotshape(brokeDn, "OR breakout down", shape.triangledown, location.abovebar, colDn, size=size.small)

// Configuration warnings instead of a hard runtime error.
var table warnTbl = table.new(position.top_right, 1, 1)
if barstate.islast
    if not timeframe.isintraday
        table.cell(warnTbl, 0, 0, "Opening Range Tool: use an intraday chart", text_color=color.orange, bgcolor=color.new(color.black, 20))
    else if timeframe.in_seconds() > orMinutes * 60
        table.cell(warnTbl, 0, 0, "Chart timeframe is larger than the range duration - lower the timeframe", text_color=color.orange, bgcolor=color.new(color.black, 20))

// ---- Alerts ------------------------------------------------------------------
if alertOnSet and orJustSet
    alert("Opening range set - " + syminfo.ticker + "  H " + str.tostring(orHigh, format.mintick) + "  L " + str.tostring(orLow, format.mintick), alert.freq_once_per_bar_close)
if alertOnBreak and brokeUp
    alert("OR high broken - " + syminfo.ticker + " " + (confirmClose ? "closed" : "traded") + " above " + str.tostring(orHigh, format.mintick), alert.freq_once_per_bar_close)
if alertOnBreak and brokeDn
    alert("OR low broken - " + syminfo.ticker + " " + (confirmClose ? "closed" : "traded") + " below " + str.tostring(orLow, format.mintick), alert.freq_once_per_bar_close)
