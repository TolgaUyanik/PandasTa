//@version=6
indicator(
     title="Cyberpunk MA Spectrum",
     shorttitle="Cyberpunk MA Spectrum",
     overlay=true
)

// ─────────────────────────────────────────────
// Settings / 基本設定
// ─────────────────────────────────────────────
groupGeneral = "General Settings / 基本設定"
groupLengths = "MA Lengths / 移動平均期間"
groupDisplay = "Display Settings / 表示設定"

maType = input.string(
     defval="EMA",
     title="MA Type / 移動平均の種類",
     options=["EMA", "SMA"],
     group=groupGeneral
)

source = input.source(
     defval=close,
     title="Source / 計算対象",
     group=groupGeneral
)

slopeLookback = input.int(
     defval=1,
     title="Slope Lookback Bars / 傾きの比較本数",
     minval=1,
     maxval=50,
     tooltip="Compares the current MA with the MA value this many bars ago.\n現在の移動平均線と、指定本数前の値を比較して色を決定します。",
     group=groupGeneral
)

// ─────────────────────────────────────────────
// MA lengths / 移動平均期間
// ─────────────────────────────────────────────
length01 = input.int(5,   "MA 01 Length / 期間", minval=1, group=groupLengths)
length02 = input.int(10,  "MA 02 Length / 期間", minval=1, group=groupLengths)
length03 = input.int(20,  "MA 03 Length / 期間", minval=1, group=groupLengths)
length04 = input.int(30,  "MA 04 Length / 期間", minval=1, group=groupLengths)
length05 = input.int(40,  "MA 05 Length / 期間", minval=1, group=groupLengths)
length06 = input.int(50,  "MA 06 Length / 期間", minval=1, group=groupLengths)
length07 = input.int(75,  "MA 07 Length / 期間", minval=1, group=groupLengths)
length08 = input.int(100, "MA 08 Length / 期間", minval=1, group=groupLengths)
length09 = input.int(125, "MA 09 Length / 期間", minval=1, group=groupLengths)
length10 = input.int(150, "MA 10 Length / 期間", minval=1, group=groupLengths)
length11 = input.int(175, "MA 11 Length / 期間", minval=1, group=groupLengths)
length12 = input.int(200, "MA 12 Length / 期間", minval=1, group=groupLengths)

// ─────────────────────────────────────────────
// Display settings / 表示設定
// ─────────────────────────────────────────────
lineWidth = input.int(
     defval=2,
     title="Line Width / 線の太さ",
     minval=1,
     maxval=5,
     group=groupDisplay
)

showFlatGray = input.bool(
     defval=true,
     title="Show Flat MA in Gray / 横ばいをグレーで表示",
     tooltip="When disabled, unchanged MA values are treated as rising.\n無効の場合、変化のない移動平均線は上昇として表示します。",
     group=groupDisplay
)

// ─────────────────────────────────────────────
// Functions / 関数
// ─────────────────────────────────────────────
f_ma(float src, int length) =>
    maType == "EMA" ? ta.ema(src, length) : ta.sma(src, length)

f_slopeColor(float maValue, int transparency) =>
    bool rising = maValue > maValue[slopeLookback]
    bool falling = maValue < maValue[slopeLookback]

    rising
         ? color.new(color.aqua, transparency)
         : falling
             ? color.new(color.fuchsia, transparency)
             : showFlatGray
                 ? color.new(color.gray, transparency)
                 : color.new(color.aqua, transparency)

// ─────────────────────────────────────────────
// MA calculations / 移動平均の計算
// ─────────────────────────────────────────────
ma01 = f_ma(source, length01)
ma02 = f_ma(source, length02)
ma03 = f_ma(source, length03)
ma04 = f_ma(source, length04)
ma05 = f_ma(source, length05)
ma06 = f_ma(source, length06)
ma07 = f_ma(source, length07)
ma08 = f_ma(source, length08)
ma09 = f_ma(source, length09)
ma10 = f_ma(source, length10)
ma11 = f_ma(source, length11)
ma12 = f_ma(source, length12)

// ─────────────────────────────────────────────
// Plots / 描画
//
// Short-term MAs are more transparent.
// Long-term MAs are darker and more visible.
//
// 短期線ほど薄く、長期線ほど濃く表示します。
// ─────────────────────────────────────────────
plot(ma01, title="MA 01", color=f_slopeColor(ma01, 84), linewidth=lineWidth)
plot(ma02, title="MA 02", color=f_slopeColor(ma02, 78), linewidth=lineWidth)
plot(ma03, title="MA 03", color=f_slopeColor(ma03, 72), linewidth=lineWidth)
plot(ma04, title="MA 04", color=f_slopeColor(ma04, 66), linewidth=lineWidth)
plot(ma05, title="MA 05", color=f_slopeColor(ma05, 60), linewidth=lineWidth)
plot(ma06, title="MA 06", color=f_slopeColor(ma06, 54), linewidth=lineWidth)
plot(ma07, title="MA 07", color=f_slopeColor(ma07, 47), linewidth=lineWidth)
plot(ma08, title="MA 08", color=f_slopeColor(ma08, 40), linewidth=lineWidth)
plot(ma09, title="MA 09", color=f_slopeColor(ma09, 32), linewidth=lineWidth)
plot(ma10, title="MA 10", color=f_slopeColor(ma10, 24), linewidth=lineWidth)
plot(ma11, title="MA 11", color=f_slopeColor(ma11, 15), linewidth=lineWidth)
plot(ma12, title="MA 12", color=f_slopeColor(ma12, 5),  linewidth=lineWidth)