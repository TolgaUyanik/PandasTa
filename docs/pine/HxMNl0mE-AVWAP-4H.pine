//@version=6
indicator("AVWAP 4H", overlay = true)

// === AVWAP ===//
float source = ohlc4
int offset = 0

vwap_01 = input.bool(true, "ETH Open", inline = '01')
vwap_01_Color = input.color(color.rgb(102, 143, 255, 27),'', inline = '01')
vwap_01_width = input.int(1, "", inline = '01')

vwap_05 = input.bool(true, "10pm", inline = '05')
vwap_05_Color = input.color(color.rgb(102, 143, 255, 27),'', inline = '05')
vwap_05_width = input.int(1, "", inline = '05')

vwap_02 = input.bool(true, "2am", inline = '02')
vwap_02_Color = input.color(color.rgb(102, 143, 255, 27),'', inline = '02')
vwap_02_width = input.int(1, "", inline = '02')

vwap_03 = input.bool(true, "6am", inline = '03')
vwap_03_Color = input.color(color.rgb(102, 143, 255, 27),'', inline = '03')
vwap_03_width = input.int(1, "", inline = '03')

vwap_04 = input.bool(true, "10am", inline = '04')
vwap_04_Color = input.color(color.rgb(102, 143, 255, 27),'', inline = '04')
vwap_04_width = input.int(1, "", inline = '04')

utcTime = hour(time(timeframe.period, '0000-2400', 'UTC'), 'UTC')

session_01_start = 22
session_01_end = 20
session_01_active = (session_01_start < session_01_end ? (utcTime >= session_01_start and utcTime < session_01_end) : (utcTime >= session_01_start or utcTime < session_01_end))

session_05_start = 2
session_05_end = 6
session_05_active = (utcTime > session_05_start or utcTime == session_05_start and minute(time, 'UTC') >= 0) and utcTime < session_05_end

session_02_start = 6
session_02_end = 10
session_02_active = (utcTime > session_02_start or utcTime == session_02_start and minute(time, 'UTC') >= 0) and utcTime < session_02_end

session_03_start = 10
session_03_end = 14
session_03_active = (utcTime > session_03_start or utcTime == session_03_start and minute(time, 'UTC') >= 0) and utcTime < session_03_end

session_04_start = 14
session_04_end = 20
session_04_active = (utcTime > session_04_start or utcTime == session_04_start and minute(time, 'UTC') >= 0) and utcTime < session_04_end

[vwap_01_A, upper_01_A, lower_01_A] = ta.vwap(source, session_01_active and not session_01_active[1], 1)
[vwap_05_A, upper_05_A, lower_05_A] = ta.vwap(source, session_05_active and not session_05_active[1], 1)
[vwap_02_A, upper_02_A, lower_02_A] = ta.vwap(source, session_02_active and not session_02_active[1], 1)
[vwap_03_A, upper_03_A, lower_03_A] = ta.vwap(source, session_03_active and not session_03_active[1], 1)
[vwap_04_A, upper_04_A, lower_04_A] = ta.vwap(source, session_04_active and not session_04_active[1], 1)

plot(vwap_01 and session_01_active ? vwap_01_A : na, '', vwap_01_Color, vwap_01_width, plot.style_linebr, bool(offset))
plot(vwap_05 and session_05_active ? vwap_05_A : na, '', vwap_05_Color, vwap_05_width, plot.style_linebr, bool(offset))
plot(vwap_02 and session_02_active ? vwap_02_A : na, '', vwap_02_Color, vwap_02_width, plot.style_linebr, bool(offset))
plot(vwap_03 and session_03_active ? vwap_03_A : na, '', vwap_03_Color, vwap_03_width, plot.style_linebr, bool(offset))
plot(vwap_04 and session_04_active ? vwap_04_A : na, '', vwap_04_Color, vwap_04_width, plot.style_linebr, bool(offset))





