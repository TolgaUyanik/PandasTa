//@version=6
strategy(title = '9/21 EMA | EOD Exit 3:15 IST', shorttitle = '9/21 EMA v5', overlay = true, initial_capital = 100000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.03)

// ══════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════
fastLen = input.int(9, title = 'Fast EMA length', minval = 1)
slowLen = input.int(21, title = 'Slow EMA length', minval = 1)

startDate = input.time(timestamp('2026-01-01 00:00 +0530'), title = 'Backtest start')
endDate = input.time(timestamp('2026-12-31 23:59 +0530'), title = 'Backtest end')
inRange = time >= startDate and time <= endDate

// ══════════════════════════════════════════════════════════════════
// TIME WINDOWS  (IST — NSE exchange timezone)
// ══════════════════════════════════════════════════════════════════
// Signal window  : 9:30 AM – 3:00 PM  (crossover entries)
isSignalWindow = (hour > 9 or hour == 9 and minute >= 30) and hour < 15

// EOD exit       : first bar at or after 3:15 PM
isEODBar = hour == 15 and minute >= 15 or hour > 15
eodExit = isEODBar and not isEODBar[1] and strategy.position_size != 0 and inRange

// ══════════════════════════════════════════════════════════════════
// EMA CALCULATIONS
// ══════════════════════════════════════════════════════════════════
ema9 = ta.ema(close, fastLen)
ema21 = ta.ema(close, slowLen)

// EMA alignment
bullAlign = ema9 > ema21 // 9 EMA above 21 EMA  → bullish structure
bearAlign = ema9 < ema21 // 9 EMA below 21 EMA  → bearish structure

// ══════════════════════════════════════════════════════════════════
// CROSSOVER SIGNALS  (signal window only)
// ══════════════════════════════════════════════════════════════════
bullCross = ta.crossover(ema9, ema21)
bearCross = ta.crossunder(ema9, ema21)

// ══════════════════════════════════════════════════════════════════
// CANDLE CONFIRMATION FILTER (reduces false crossover signals)
// ══════════════════════════════════════════════════════════════════
isGreenCandle = close > open
isRedCandle = close < open

crossBullSignal = bullCross and isGreenCandle and isSignalWindow and inRange
crossBearSignal = bearCross and isRedCandle and isSignalWindow and inRange

// ══════════════════════════════════════════════════════════════════
// COMBINED ENTRY SIGNALS
// Re-entry allowed on every crossover — supports multiple buy/sell
// signals per session. A new entry on the opposite side automatically
// reverses (closes) the existing position via strategy.entry().
// ══════════════════════════════════════════════════════════════════
bullEntry = crossBullSignal and strategy.position_size <= 0
bearEntry = crossBearSignal and strategy.position_size >= 0

// ══════════════════════════════════════════════════════════════════
// TRADE EXECUTION
// EOD close at 3:15 PM; mid-day reversals on opposite EMA crossover
// ══════════════════════════════════════════════════════════════════
if bullEntry and not isEODBar
    strategy.entry('Long', strategy.long, comment = 'BUY')

if bearEntry and not isEODBar
    strategy.entry('Short', strategy.short, comment = 'SHORT')

if eodExit
    strategy.close_all(comment = 'EOD EXIT 3:15')

// ══════════════════════════════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════════════════════════════
p9 = plot(ema9, title = '9 EMA', color = color.new(color.blue, 0), linewidth = 2)
p21 = plot(ema21, title = '21 EMA', color = color.new(color.orange, 0), linewidth = 2)

// EMA band fill
fill(p9, p21, color = bullAlign ? color.new(color.green, 88) : color.new(color.red, 88), title = 'EMA band')

// EOD exit marker
plotshape(eodExit, title = 'EOD exit 3:15', style = shape.labeldown, location = location.abovebar, color = color.new(color.purple, 0), size = size.small, text = '3:15 EXIT')

// Crossover BUY / SHORT — every signal, including reversals
plotshape(crossBullSignal, title = 'Cross BUY', style = shape.triangleup, location = location.belowbar, color = color.new(color.green, 0), size = size.normal, text = 'BUY')

plotshape(crossBearSignal, title = 'Cross SHORT', style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.normal, text = 'SHORT')

// Background
bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : na, title = 'Long bg')
bgcolor(strategy.position_size < 0 ? color.new(color.red, 92) : na, title = 'Short bg')
bgcolor(eodExit ? color.new(color.purple, 80) : na, title = 'EOD bg')

// ══════════════════════════════════════════════════════════════════
// INFO TABLE
// ══════════════════════════════════════════════════════════════════
var table tbl = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast
    table.cell(tbl, 0, 0, 'Strategy', text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(tbl, 1, 0, '9/21 EMA v5', text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(tbl, 0, 1, 'Signal window', text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(tbl, 1, 1, '9:30 – 3:00 PM', text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(tbl, 0, 2, 'EMA alignment', text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(tbl, 1, 2, bullAlign ? 'BULL (9>21)' : 'BEAR (21>9)', text_color = color.white, bgcolor = bullAlign ? color.new(color.green, 30) : color.new(color.red, 30), text_size = size.small)
    table.cell(tbl, 0, 3, 'In window', text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(tbl, 1, 3, isSignalWindow ? 'SIGNAL' : 'CLOSED', text_color = color.white, bgcolor = isSignalWindow ? color.new(color.blue, 30) : color.new(color.gray, 50), text_size = size.small)
    table.cell(tbl, 0, 4, 'Position', text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
    table.cell(tbl, 1, 4, strategy.position_size > 0 ? 'LONG' : strategy.position_size < 0 ? 'SHORT' : 'FLAT', text_color = color.white, bgcolor = strategy.position_size > 0 ? color.new(color.green, 20) : strategy.position_size < 0 ? color.new(color.red, 20) : color.new(color.gray, 40), text_size = size.small)

// ══════════════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════════════
alertcondition(crossBullSignal, title = 'EMA Cross BUY', message = 'NIFTY — BUY. 9 EMA crossed above 21 EMA.')
alertcondition(crossBearSignal, title = 'EMA Cross SHORT', message = 'NIFTY — SHORT. 9 EMA crossed below 21 EMA.')
alertcondition(eodExit, title = 'EOD Exit 3:15', message = 'NIFTY — EOD exit at 3:15 PM IST.')
