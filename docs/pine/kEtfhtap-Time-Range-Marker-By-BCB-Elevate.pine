//@version=5
indicator("Time Range Marker By BCB Elevate", overlay=true)

// === Inputs ===
startHour   = input.int(9, minval=0, maxval=23, title="Start Hour (24h format)")
startMinute = input.int(0, minval=0, maxval=59, title="Start Minute")
endHour     = input.int(10, minval=0, maxval=23, title="End Hour (24h format)")
endMinute   = input.int(0, minval=0, maxval=59, title="End Minute")
highlightColor = input.color(color.new(color.orange, 85), title="Highlight Color")

// === Timeframe info ===
sessStart = timestamp("Etc/UTC", year, month, dayofmonth, startHour, startMinute)
sessEnd   = timestamp("Etc/UTC", year, month, dayofmonth, endHour, endMinute)

// === Plot background ===
inTimeRange = (time >= sessStart and time <= sessEnd)
bgcolor(inTimeRange ? highlightColor : na)
