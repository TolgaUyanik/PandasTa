//@version=6

// @description Alert payload string builders for GB-RMBP+ strategy.
// N8N JSON entries/exits, Autoview key=value strings, PineConnector CSV.
library("GB_JSON_Lib", overlay = true)


// @function Build the N8N entry-side JSON payload, byte-identical to v1.0.77 output.
// @param act           "buy" or "sell"
// @param mode_lower    Execution mode in lowercase (stealth/hybrid/visible)
// @param ticker        syminfo.ticker
// @param tf            timeframe.period
// @param price_now     close
// @param lev           Final effective leverage used for the order
// @param sug_lev       Suggested leverage from risk-loss calculation
// @param sl_price      Stop-loss price (or 0 if none)
// @param liq_price     Calculated liquidation price
// @param order_pct     Order size as % of equity
// @param tp1..tp6      TP prices (use 0 when inactive — function checks tpN_active to gate inclusion)
// @param tp1p..tp6p    TP exit %s
// @param tp1a..tp6a    TP-active flags (true if that TP should be included)
// @returns JSON string
export n8n_entry_json(string act, string mode_lower, string ticker, string tf, float price_now, float lev, float sug_lev, float sl_price, float liq_price, float order_pct, float tp1, float tp1p, bool tp1a, float tp2, float tp2p, bool tp2a, float tp3, float tp3p, bool tp3a, float tp4, float tp4p, bool tp4a, float tp5, float tp5p, bool tp5a, float tp6, float tp6p, bool tp6a) =>
    base = '{"action":"' + act + '","mode":"' + mode_lower + '","symbol":"' + ticker + '","price":' + str.tostring(price_now) + ',"timeframe":"' + tf + '","leverage":' + str.tostring(lev) + ',"suggestedLev":' + str.tostring(sug_lev) + ',"sl":' + str.tostring(sl_price) + ',"liqPrice":' + str.tostring(liq_price) + ',"orderSize":' + str.tostring(order_pct) + ',"orderType":"% of Capital","script":"GB-RMBP+"'
    int tpCount = (tp1a ? 1 : 0) + (tp2a ? 1 : 0) + (tp3a ? 1 : 0) + (tp4a ? 1 : 0) + (tp5a ? 1 : 0) + (tp6a ? 1 : 0)
    tps = ',"tpCount":' + str.tostring(tpCount)
    tp1str = tp1a ? ',"tp1":' + str.tostring(tp1) + ',"tp1Pct":' + str.tostring(tp1p) : ''
    tp2str = tp2a ? ',"tp2":' + str.tostring(tp2) + ',"tp2Pct":' + str.tostring(tp2p) : ''
    tp3str = tp3a ? ',"tp3":' + str.tostring(tp3) + ',"tp3Pct":' + str.tostring(tp3p) : ''
    tp4str = tp4a ? ',"tp4":' + str.tostring(tp4) + ',"tp4Pct":' + str.tostring(tp4p) : ''
    tp5str = tp5a ? ',"tp5":' + str.tostring(tp5) + ',"tp5Pct":' + str.tostring(tp5p) : ''
    tp6str = tp6a ? ',"tp6":' + str.tostring(tp6) + ',"tp6Pct":' + str.tostring(tp6p) : ''
    base + tps + tp1str + tp2str + tp3str + tp4str + tp5str + tp6str + '}'


// @function Build per-TP exit JSON payload.
// @param act       "closelong" or "closeshort"
// @param ticker    syminfo.ticker
// @param tp_idx    TP number 1..6
// @param tp_pct    Exit % for this TP
// @param pos_size  math.abs(strategy.position_size)
// @returns JSON string
export n8n_tp_exit_json(string act, string ticker, int tp_idx, float tp_pct, float pos_size) =>
    '{"action":"' + act + '","symbol":"' + ticker + '","tp":' + str.tostring(tp_idx) + ',"tpPercent":' + str.tostring(tp_pct) + ',"positionSize":' + str.tostring(pos_size) + '}'


// @function Build a full-position close JSON payload.
// @param act     "closelong" or "closeshort"
// @param ticker  syminfo.ticker
// @returns JSON string
export n8n_close_json(string act, string ticker) =>
    '{"action":"' + act + '","symbol":"' + ticker + '"}'


// @function Compute order size as percentage of equity.
// @param qty       Final order quantity
// @param price     Current close
// @param lev       Effective leverage
// @param equity    strategy.equity
// @returns Rounded percentage to 4 decimals
export n8n_order_pct(float qty, float price, float lev, float equity) =>
    math.round((qty * price / lev) / equity * 100, 4)


// @function Build Autoview entry command string.
// Uses Pine placeholder '{{strategy.order.contracts}}' for the quantity.
// @param user      Acct identifier
// @param side      "long" or "short"
// @param exchange  Exchange name
// @param lev       Leverage value
// @param symbol    Symbol string
// @param ccy       "currency" or "contracts"
// @param testing   "" or " d=1"
// @returns Autoview-formatted command string
export av_entry_str(string user, string side, string exchange, float lev, string symbol, string ccy, string testing) =>
    " a=" + user + " b=" + side + " delay=1" + " e=" + exchange + " l=" + str.tostring(lev) + " lt=isolated" + " q=" + '{{strategy.order.contracts}}' + " s=" + symbol + " t=market" + " u=" + ccy + testing


// @function Build Autoview exit command string. Short exits append "%" to qty per v1.0.77.
// @param user      Acct identifier
// @param side      "long" or "short"
// @param exchange  Exchange name
// @param symbol    Symbol string
// @param ccy       "currency" or "contracts"
// @param testing   "" or " d=1"
// @param is_short  True if this is a short exit (appends "%")
// @returns Autoview-formatted command string
export av_exit_str(string user, string side, string exchange, string symbol, string ccy, string testing, bool is_short) =>
    " a=" + user + " b=" + side + " c=position" + " delay=1" + " q=" + '{{strategy.order.contracts}}' + (is_short ? "%" : "") + " e=" + exchange + " s=" + symbol + " t=market" + " u=" + ccy + testing


// @function Build PineConnector CSV alert payload.
// Uses Pine placeholders for action and contracts.
// @param licence_id  Numeric license ID
// @param symbol      Symbol with optional suffix (e.g. "EURUSD.a")
// @returns CSV-formatted command string
export pc_alert_str(int licence_id, string symbol) =>
    str.tostring(licence_id) + ',' + '{{strategy.order.action}}' + ',' + symbol + ',risk=' + '{{strategy.order.contracts}}'


plot(na, title = "anchor", display = display.none)
