//@version=5
indicator("Crypto ETH-Adjusted 60D Return Index", overlay=false)

// === Symbols ===
btc = request.security("BINANCE:BTCUSDT", "D", close)
eth = request.security("BINANCE:ETHUSDT", "D", close)
sol = request.security("BINANCE:SOLUSDT", "D", close)
aave = request.security("BINANCE:AAVEUSDT", "D", close)
xrp = request.security("BINANCE:XRPUSDT", "D", close)

// === 60-Day Returns ===
btc_ret = (btc - btc[60]) / btc[60]
eth_ret_raw = (eth - eth[60]) / eth[60]
sol_ret = (sol - sol[60]) / sol[60]
aave_ret = (aave - aave[60]) / aave[60]
xrp_ret = (xrp - xrp[60]) / xrp[60]

// === Adjusted Returns ===
eth_adj = eth_ret_raw * 0.85
sol_adj = sol_ret * 0.425
aave_adj = aave_ret * 0.52
xrp_adj = xrp_ret * 0.79

// === Final Composite Index ===
// You can use equal weighting or assign weights here if needed
index = btc_ret + eth_adj + sol_adj + aave_adj + xrp_adj

plot(index, title="60D ETH-Adjusted Crypto Return Index", color=color.teal, linewidth=2)
hline(0, "Zero", color=color.gray)

