//@version=6

// @description Helped methods for Manipulation Leg Scanner
library("ManipulationLegHelperLibrary", overlay = true)

import outofoptions/OutofOptionsHelperLibrary/17 as H

export type leg
    int time
    float low
    float high
    bool edge
    float edge_price
    float outer_edge
    int sweeps
    int barC
    int validated = 0
    box bx = na
    bool flatEdge = false
    float edgeOpen
    line[] ln = na
    label[] lb = na
    bool processed = false
    float lastDev
    float minus1
    float minus2
    float minus25
    int minus1State = 0
    int minus2State = 0
    int minus25State = 0

// @returns float[]
export devToArray(string dev) =>
    float[] out = array.new<float>()
    for e in str.split(dev, ",")
        float d = str.tonumber(e)
        if not na(d)
            out.push(d)
    out

// @returns float
export getDev(float d, bool bull, float h, float l) =>
    float dev = math.round_to_mintick(d * (h - l))
    bull ? h - dev : l + dev

// @returns [int, int]
export getInternalLeg(int start, bool bull, float skipS = 1) =>
    int b = start
    int e = b

    if (bull ? H.isDown(start) : H.isUp(start)) or (open[start] == close[start])
        if bull
            while H.isDown(b + 1) or ((H.isUp(b + 1) == false or math.abs(open[b + 1] - close[b + 1]) < skipS) and H.isDown(b + 2))
                b += 1
                e := open[b] > open[e] ? b : e
        else
            while H.isUp(b + 1) or ((H.isDown(b + 1) == false or (math.abs(open[b + 1] - close[b + 1]) < skipS)) and H.isUp(b + 2))
                b += 1
                e := open[b] < open[e] ? b : e

    [b, e]

// @returns leg
export getBearLeg(int sweeps, float minLegSize, bool drawLegBox, color boxColor, float skipS = 1) =>
    int start = H.isUp(1) ? 1 : (H.isUp(2) ? 2 : -1)
    if open[1] == close[1]
        start := 1
    if (H.isUp(0) or (open[0] == close[0])) and start == 1 and close[0] >= close[1]
        start := 0

    leg x = na

    if start > -1
        [b, e] = getInternalLeg(start, false, skipS)
        if (b - start) >= 1 and (close[start] - open[e]) >= minLegSize
            x := leg.new(time[start], open[e], close[start], start == 1, high[1], math.min(low[e], low[b]), sweeps, b - (start - 1), flatEdge = close[start] == high[start], edgeOpen = start == 1 ? 0 : open[1])
            if drawLegBox
                x.bx := box.new(time[e], x.high, x.time, x.low, xloc = xloc.bar_time, border_width = 0, bgcolor = boxColor)
    x

// @returns leg
export getBullLeg(int sweeps, float minSize, bool drawBox, color boxColor, float skipS = 1) =>
    int start = H.isDown(1) ? 1 : (H.isDown(2) ? 2 : -1)
    if open[1] == close[1]
        start := 1
    if (H.isDown(0) or (open[0] == close[0])) and start == 1 and close[0] <= close[1]
        start := 0

    leg x = na

    if start > -1
        [b, e] = getInternalLeg(start, true, skipS)
        if (b - start) >= 1 and (open[e] - close[start]) >= minSize
            x := leg.new(time[start], close[start], open[e], start == 1, low[1], math.max(high[e], high[b]), sweeps, b - (start - 1), flatEdge = close[start] == low[start], edgeOpen = start == 1 ? 0 : open[1])
            if drawBox
                x.bx := box.new(time[e], x.high, x.time, x.low, xloc = xloc.bar_time, border_width = 0, bgcolor = boxColor)
    x