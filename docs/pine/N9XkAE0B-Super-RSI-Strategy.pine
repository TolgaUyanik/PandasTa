//@version=5
strategy("Super RSI Strategy", overlay=true, initial_capital=100000)

// ===== INPUTS =====
atrPeriod = input.int(10, title="ATR Period")
factor = input.float(3.0, title="Supertrend Factor")

rsiLength = input.int(14, title="RSI Length")
rsiOverbought = input.int(70, title="RSI Overbought")
rsiOversold = input.int(30, title="RSI Oversold")

// ===== SUPER TREND =====
[supertrend, direction] = ta.supertrend(factor, atrPeriod)

// ===== RSI =====
rsi = ta.rsi(close, rsiLength)

// ===== BUY & SELL CONDITIONS =====
// Buy when Supertrend turns bullish and RSI above 50
buyCondition = direction < 0 and rsi > 50

// Sell when Supertrend turns bearish and RSI below 50
sellCondition = direction > 0 and rsi < 50

// ===== STRATEGY EXECUTION =====
if (buyCondition)
    strategy.entry("Buy", strategy.long)

if (sellCondition)
    strategy.entry("Sell", strategy.short)

// ===== EXIT CONDITIONS =====
if (rsi > rsiOverbought)
    strategy.close("Buy")

if (rsi < rsiOversold)
    strategy.close("Sell")

// ===== PLOTS =====
plot(supertrend, color = direction < 0 ? color.green : color.red, linewidth=2, title="Supertrend")

// Buy/Sell Signals
plotshape(buyCondition, title="BUY", location=location.belowbar,
     color=color.green, style=shape.labelup, text="BUY")

plotshape(sellCondition, title="SELL", location=location.abovebar,
     color=color.red, style=shape.labeldown, text="SELL")

// ===== ALERTS =====
alertcondition(buyCondition, title="Buy Alert", message="Supertrend + RSI BUY Signal")
alertcondition(sellCondition, title="Sell Alert", message="Supertrend + RSI SELL Signal")