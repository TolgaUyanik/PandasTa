//@version=6

// @description 简易追踪止损； 未充分测试，欢迎提交issue
library("TrailingStopLoss")

// @function drawdown_percent: 回撤百分比
// @param entry_bar_index: 开仓位置
// @param direction_long: 多空方向
// @returns percentage: 回撤百分比 > 0
export drawdown_percent(int entry_bar_index, bool direction_long) =>
	o = open[bar_index - entry_bar_index + 1]
	h = ta.highest(high, bar_index - entry_bar_index +1)
	l = ta.lowest(low, bar_index - entry_bar_index +1)
	c = close
	dh = math.abs( (h-c) / (h-o) )
	dl = math.abs( (c-l) / (o-l) )
	direction_long ? dh : dl

// @function closure_needed: 是否满足平仓条件
// @param entry_bar_index: 开仓位置
// @param initial_sl_price: 初始止损价
// @param percentage_ts: 回撤百分比（0~1）
// @param num_bars_tolerance: 开仓后等待K线数
// @param extra_drawdown_distance: 额外止损幅度，例如 5 * ta.atr(14)，防止持仓时间过长
// @returns do_closure: bool 是否平仓
export closure_needed(int entry_bar_index, float initial_sl_price, float percentage_ts, int num_bars_tolerance, float extra_drawdown_distance) =>
	num_bars = bar_index - entry_bar_index
	o = open[num_bars + 1]
	h = ta.highest(high, num_bars +1)
	l = ta.lowest(low, num_bars +1)
	c = close
	dh = math.abs( (h-c) / (h-o) )
	dl = math.abs( (c-l) / (o-l) )
	condition_close_0_long = l < initial_sl_price
	condition_close_0_short = h > initial_sl_price
	condition_close_1_base = num_bars > num_bars_tolerance
	condition_close_1_long = condition_close_1_base and dh > percentage_ts
	condition_close_1_short = condition_close_1_base and dl > percentage_ts
	condition_close_2_long = (h-c) > extra_drawdown_distance
	condition_close_2_short = (c-l) > extra_drawdown_distance
	direction_long = initial_sl_price < o
	condition_close_long = condition_close_0_long or condition_close_1_long or condition_close_2_long
	condition_close_short = condition_close_0_short or condition_close_1_short or condition_close_2_short
	(direction_long and condition_close_long) or (not direction_long and condition_close_short)
	