import PineCoders/Time/5 as PCtime



//#region ———————————————————— Library functions 


// @function            Filters the seconds in a small timeframe based on its value.         
// @param tfInSeconds   (simple int) The seconds count to filter. 
// @returns             (int) The `tfInSeconds` value if it represents at least five seconds, 1 otherwise. 
filterSmallTfs(simple int tfInSeconds) =>
    int result = tfInSeconds < 5 ? 1 : tfInSeconds


// @function            Selects a LTF from the chart's TF, depending on the `userSelection` input string.
// @param userSelection (series string) User-selected input string which must be one of the `choicex` arguments.
// @param choice1       (simple string) Input selection corresponding to "Covering most chart bars (least precise)".
// @param choice2       (simple string) Input selection corresponding to "Covering some chart bars (less precise)".
// @param choice3       (simple string) Input selection corresponding to "Covering less chart bars (more precise)".
// @param choice4       (simple string) Input selection corresponding to "Covering few chart bars (very precise)".
// @param choice5       (simple string) Input selection corresponding to "Covering the least chart bars (most precise)".
// @param choice6       (simple string) Input selection corresponding to "~12 intrabars per chart bar".
// @param choice7       (simple string) Input selection corresponding to "~24 intrabars per chart bar".
// @param choice8       (simple string) Input selection corresponding to "~50 intrabars per chart bar".
// @param choice9       (simple string) Input selection corresponding to "~100 intrabars per chart bar".
// @param choice10      (simple string) Input selection corresponding to "~250 intrabars per chart bar".
// @param choice11      (simple string) Input selection corresponding to "~500 intrabars per chart bar".
// @param choice12      (simple string) Input selection corresponding to "~1000 intrabars per chart bar".
// @returns             (string) A timeframe string usable as the `timeframe` argument in `request.security_lower_tf()`.
export ltf(
     series string userSelection,
     simple string choice1, 
     simple string choice2, 
     simple string choice3, 
     simple string choice4, 
     simple string choice5, 
     simple string choice6,
     simple string choice7,
     simple string choice8,
     simple string choice9,
     simple string choice10,
     simple string choice11,
     simple string choice12
 ) =>

    // Determine user selection.
    bool leastPrecise = false
    bool lessPrecise  = false
    bool morePrecise  = false
    bool veryPrecise  = false
    bool mostPrecise  = false
    bool intrabars12  = false
    bool intrabars24  = false
    bool intrabars50  = false
    bool intrabars100 = false
    bool intrabars250 = false
	bool intrabars500 = false
	bool intrabars1000 = false
	
    switch userSelection
        choice1  => leastPrecise := true
        choice2  => lessPrecise  := true
        choice3  => morePrecise  := true
        choice4  => veryPrecise  := true
        choice5  => mostPrecise  := true
        choice6  => intrabars12  := true
        choice7  => intrabars24  := true
        choice8  => intrabars50  := true
        choice9  => intrabars100 := true
        choice10 => intrabars250 := true
        choice11 => intrabars500 := true
        choice12 => intrabars1000 := true

	// log.info("isseconds: {0}", timeframe.isseconds)
	// log.info("isminutes: {0}", timeframe.isminutes)
	// log.info("isdaily: {0}", timeframe.isdaily)
	// log.info("isweekly: {0}", timeframe.isweekly)
	// log.info("ismonthly: {0}", timeframe.ismonthly)
	// log.info("* Multiplier: {0}", timeframe.multiplier)

    // Find the LTF corresponding to user's selection.
    // Progressive precision: least -> less -> more -> very -> most
    string result =
      switch
        leastPrecise =>
            if timeframe.isseconds
                switch
                    timeframe.multiplier <= 5   => "1S"
                    timeframe.multiplier <= 10  => "5S"
                    timeframe.multiplier <= 15  => "5S"
                    timeframe.multiplier <= 30  => "15S"
                    timeframe.multiplier <= 45  => "15S"
                    => "30S"
            else if timeframe.isminutes
                switch
                    timeframe.multiplier <= 1   => "30S"
                    timeframe.multiplier <= 2   => "1"
                    timeframe.multiplier <= 3   => "1"
                    timeframe.multiplier <= 4   => "2"
                    timeframe.multiplier <= 5   => "2"
                    timeframe.multiplier <= 6   => "3"
                    timeframe.multiplier <= 8   => "4"
                    timeframe.multiplier <= 10  => "5"
                    timeframe.multiplier <= 12  => "6"
                    timeframe.multiplier <= 15  => "6"
                    timeframe.multiplier <= 18  => "9"
                    timeframe.multiplier <= 24  => "12"
                    timeframe.multiplier <= 30  => "15"
                    timeframe.multiplier <= 45  => "15"
                    timeframe.multiplier <= 60  => "30"     // 1 hour
                    timeframe.multiplier <= 120 => "60"     // 2 hour
                    timeframe.multiplier <= 180 => "120"    // 3 hour
                    timeframe.multiplier <= 240 => "180"    // 4 hour
                    timeframe.multiplier <= 360 => "240"    // 6 hour
                    timeframe.multiplier <= 480 => "360"    // 8 hour
                    timeframe.multiplier <= 720 => "480"    // 12 hour
                    => "480"
            else if timeframe.isdaily
                switch
                    timeframe.multiplier == 1  => "240"    	// 1 day
                    timeframe.multiplier == 2  => "480"    	// 2 day
                    timeframe.multiplier == 3  => "720"    	// 3 day
                    timeframe.multiplier == 4  => "1D"     	// 4 day
                    timeframe.multiplier == 5  => "1D"     	// 5 day
                    timeframe.multiplier == 6  => "1D"     	// 6 day
                    => "2D"
            else if timeframe.isweekly
                switch
                    timeframe.multiplier == 1  => "2D"     	// 1 week
                    timeframe.multiplier == 2  => "3D"     	// 2 week
                    timeframe.multiplier == 3  => "1W"     	// 3 week
                    timeframe.multiplier == 4  => "1W"     	// 4 week
                    => "2W"                                	// 5+ week
            else if timeframe.ismonthly
                switch
                    timeframe.multiplier == 1  => "1W"     	// 1 month
                    timeframe.multiplier == 2  => "2W"     	// 2 month
                    timeframe.multiplier == 3  => "2W"     	// 3 month
                    timeframe.multiplier == 4  => "1M"     	// 4 month
                    timeframe.multiplier <= 6  => "1M"     	// 6 month
                    timeframe.multiplier <= 12 => "2M"     	// 12 month
                    => "3M"                                	// 12+ month

        lessPrecise =>
            if timeframe.isseconds
                switch
                    timeframe.multiplier <= 5   => "1S"
                    timeframe.multiplier <= 10  => "5S"
                    timeframe.multiplier <= 15  => "5S"
                    timeframe.multiplier <= 30  => "10S"
                    timeframe.multiplier <= 45  => "10S"
                    => "15S"
            else if timeframe.isminutes
                switch
                    timeframe.multiplier <= 1   => "15S"
                    timeframe.multiplier <= 2   => "30S"
                    timeframe.multiplier <= 3   => "45S"
                    timeframe.multiplier <= 4   => "1"
                    timeframe.multiplier <= 5   => "1"
                    timeframe.multiplier <= 6   => "2"
                    timeframe.multiplier <= 8   => "2"
                    timeframe.multiplier <= 10  => "3"
                    timeframe.multiplier <= 12  => "4"
                    timeframe.multiplier <= 15  => "5"
                    timeframe.multiplier <= 18  => "6"
                    timeframe.multiplier <= 24  => "8"
                    timeframe.multiplier <= 30  => "10"
                    timeframe.multiplier <= 45  => "15"
                    timeframe.multiplier <= 60  => "20"     // 1 hour
                    timeframe.multiplier <= 120 => "30"     // 2 hour
                    timeframe.multiplier <= 180 => "60"     // 3 hour
                    timeframe.multiplier <= 240 => "120"    // 4 hour
                    timeframe.multiplier <= 360 => "180"    // 6 hour
                    timeframe.multiplier <= 480 => "240"    // 8 hour
                    timeframe.multiplier <= 720 => "360"    // 12 hour
                    => "360"
            else if timeframe.isdaily
                switch
                    timeframe.multiplier == 1  => "120"    	// 1 day
                    timeframe.multiplier == 2  => "240"    	// 2 day
                    timeframe.multiplier == 3  => "360"    	// 3 day
                    timeframe.multiplier == 4  => "480"    	// 4 day
                    timeframe.multiplier == 5  => "720"    	// 5 day
                    timeframe.multiplier == 6  => "1D"     	// 6 day
                    => "1D"
            else if timeframe.isweekly
                switch
                    timeframe.multiplier == 1  => "1D"     	// 1 week
                    timeframe.multiplier == 2  => "2D"     	// 2 week
                    timeframe.multiplier == 3  => "3D"     	// 3 week
                    timeframe.multiplier == 4  => "1W"     	// 4 week
                    => "1W"                                 // 5+ week
            else if timeframe.ismonthly
                switch
                    timeframe.multiplier == 1  => "1W"     	// 1 month
                    timeframe.multiplier == 2  => "1W"     	// 2 month
                    timeframe.multiplier == 3  => "2W"     	// 3 month
                    timeframe.multiplier == 4  => "2W"     	// 4 month
                    timeframe.multiplier <= 6  => "1M"     	// 6 month
                    timeframe.multiplier <= 12 => "1M"     	// 12 month
                    => "2M"                                	// 12+ month

        morePrecise =>
            if timeframe.isseconds
                switch
                    timeframe.multiplier <= 5   => "1S"
                    timeframe.multiplier <= 10  => "1S"
                    timeframe.multiplier <= 15  => "1S"
                    timeframe.multiplier <= 30  => "5S"
                    timeframe.multiplier <= 45  => "5S"
                    => "10S"
            else if timeframe.isminutes
                switch
                    timeframe.multiplier <= 1   => "10S"
                    timeframe.multiplier <= 2   => "15S"
                    timeframe.multiplier <= 3   => "30S"
                    timeframe.multiplier <= 4   => "30S"
                    timeframe.multiplier <= 5   => "45S"
                    timeframe.multiplier <= 6   => "1"
                    timeframe.multiplier <= 8   => "1"
                    timeframe.multiplier <= 10  => "2"
                    timeframe.multiplier <= 12  => "3"
                    timeframe.multiplier <= 15  => "3"
                    timeframe.multiplier <= 18  => "3"
                    timeframe.multiplier <= 24  => "6"
                    timeframe.multiplier <= 30  => "5"
                    timeframe.multiplier <= 45  => "10"
                    timeframe.multiplier <= 60  => "15"     // 1 hour
                    timeframe.multiplier <= 120 => "20"     // 2 hour
                    timeframe.multiplier <= 180 => "30"     // 3 hour
                    timeframe.multiplier <= 240 => "60"     // 4 hour
                    timeframe.multiplier <= 360 => "120"    // 6 hour
                    timeframe.multiplier <= 480 => "180"    // 8 hour
                    timeframe.multiplier <= 720 => "240"    // 12 hour
                    => "240"
            else if timeframe.isdaily
                switch
                    timeframe.multiplier == 1  => "60"     	// 1 day
                    timeframe.multiplier == 2  => "120"    	// 2 day
                    timeframe.multiplier == 3  => "180"    	// 3 day
                    timeframe.multiplier == 4  => "240"    	// 4 day
                    timeframe.multiplier == 5  => "360"    	// 5 day
                    timeframe.multiplier == 6  => "480"    	// 6 day
                    => "720"
            else if timeframe.isweekly
                switch
                    timeframe.multiplier == 1  => "480"    	// 1 week
                    timeframe.multiplier == 2  => "1D"     	// 2 week
                    timeframe.multiplier == 3  => "2D"     	// 3 week
                    timeframe.multiplier == 4  => "3D"     	// 4 week
                    => "1W"                                 // 5+ week
            else if timeframe.ismonthly
                switch
                    timeframe.multiplier == 1  => "1W"     	// 1 month
                    timeframe.multiplier == 2  => "1W"     	// 2 month
                    timeframe.multiplier == 3  => "1W"     	// 3 month
                    timeframe.multiplier == 4  => "2W"     	// 4 month
                    timeframe.multiplier <= 6  => "2W"     	// 6 month
                    timeframe.multiplier <= 12 => "1M"     	// 12 month
                    => "1M"                                 // 12+ month

        veryPrecise =>
            if timeframe.isseconds
                switch
                    timeframe.multiplier <= 5   => "1S"
                    timeframe.multiplier <= 10  => "1S"
                    timeframe.multiplier <= 15  => "1S"
                    timeframe.multiplier <= 30  => "5S"
                    timeframe.multiplier <= 45  => "5S"
                    => "5S"
            else if timeframe.isminutes
                switch
                    timeframe.multiplier <= 1   => "5S"
                    timeframe.multiplier <= 2   => "10S"
                    timeframe.multiplier <= 3   => "15S"
                    timeframe.multiplier <= 4   => "15S"
                    timeframe.multiplier <= 5   => "30S"
                    timeframe.multiplier <= 6   => "30S"
                    timeframe.multiplier <= 8   => "30S"
                    timeframe.multiplier <= 10  => "45S"
                    timeframe.multiplier <= 12  => "1"
                    timeframe.multiplier <= 15  => "2"
                    timeframe.multiplier <= 18  => "2"
                    timeframe.multiplier <= 24  => "3"
                    timeframe.multiplier <= 30  => "4"
                    timeframe.multiplier <= 45  => "5"
                    timeframe.multiplier <= 60  => "5" 	    // 1 hour
                    timeframe.multiplier <= 120 => "15"     // 2 hour
                    timeframe.multiplier <= 180 => "20"     // 3 hour
                    timeframe.multiplier <= 240 => "30"     // 4 hour
                    timeframe.multiplier <= 360 => "60"     // 6 hour
                    timeframe.multiplier <= 480 => "120"    // 8 hour
                    timeframe.multiplier <= 720 => "180"    // 12 hour
                    => "180"
            else if timeframe.isdaily
                switch
                    timeframe.multiplier == 1  => "30"     	// 1 day
                    timeframe.multiplier == 2  => "60"     	// 2 day
                    timeframe.multiplier == 3  => "120"    	// 3 day
                    timeframe.multiplier == 4  => "180"    	// 4 day
                    timeframe.multiplier == 5  => "240"    	// 5 day
                    timeframe.multiplier == 6  => "360"    	// 6 day
                    => "480"
            else if timeframe.isweekly
                switch
                    timeframe.multiplier == 1  => "240"    	// 1 week
                    timeframe.multiplier == 2  => "480"    	// 2 week
                    timeframe.multiplier == 3  => "1D"     	// 3 week
                    timeframe.multiplier == 4  => "1D"     	// 4 week
                    => "2D"                                 // 5+ week
            else if timeframe.ismonthly
                switch
                    timeframe.multiplier == 1  => "3D"     	// 1 month
                    timeframe.multiplier == 2  => "1W"     	// 2 month
                    timeframe.multiplier == 3  => "1W"     	// 3 month
                    timeframe.multiplier == 4  => "1W"     	// 4 month
                    timeframe.multiplier <= 6  => "2W"     	// 6 month
                    timeframe.multiplier <= 12 => "2W"     	// 12 month
                    => "1M"                                 // 12+ month

        mostPrecise =>
            if timeframe.isseconds
                switch
                    timeframe.multiplier <= 5   => "1S"
                    timeframe.multiplier <= 10  => "1S"
                    timeframe.multiplier <= 15  => "1S"
                    timeframe.multiplier <= 30  => "1S"
                    timeframe.multiplier <= 45  => "5S"    
                    => "5S"                                
            else if timeframe.isminutes
                switch
                    timeframe.multiplier <= 1   => "1S"
                    timeframe.multiplier <= 2   => "5S"
                    timeframe.multiplier <= 3   => "10S"
                    timeframe.multiplier <= 4   => "15S"
                    timeframe.multiplier <= 5   => "15S"
                    timeframe.multiplier <= 6   => "15S"
                    timeframe.multiplier <= 8   => "30S"
                    timeframe.multiplier <= 10  => "30S"
                    timeframe.multiplier <= 12  => "30S"
                    timeframe.multiplier <= 15  => "1"
                    timeframe.multiplier <= 18  => "1"
                    timeframe.multiplier <= 24  => "2"     
                    timeframe.multiplier <= 30  => "3"     
                    timeframe.multiplier <= 45  => "4"     
                    timeframe.multiplier <= 60  => "5"     // 1 hour
                    timeframe.multiplier <= 120 => "10"    // 2 hour
                    timeframe.multiplier <= 180 => "15"    // 3 hour
                    timeframe.multiplier <= 240 => "20"    // 4 hour
                    timeframe.multiplier <= 360 => "30"    // 6 hour
                    timeframe.multiplier <= 480 => "60"    // 8 hour
                    timeframe.multiplier <= 720 => "120"   // 12 hour
                    => "120"                                
            else if timeframe.isdaily
                switch
                    timeframe.multiplier == 1  => "15"     
                    timeframe.multiplier == 2  => "30"     
                    timeframe.multiplier == 3  => "60"     
                    timeframe.multiplier == 4  => "120"    
                    timeframe.multiplier == 5  => "180"    
                    timeframe.multiplier == 6  => "240"    
                    => "360"
            else if timeframe.isweekly
                switch
                    timeframe.multiplier == 1  => "120"    
                    timeframe.multiplier == 2  => "240"    
                    timeframe.multiplier == 3  => "480"    
                    timeframe.multiplier == 4  => "720"    
                    => "1D"                                
            else if timeframe.ismonthly
                switch
                    timeframe.multiplier == 1  => "1D"     
                    timeframe.multiplier == 2  => "3D"     
                    timeframe.multiplier == 3  => "3D"     
                    timeframe.multiplier == 4  => "1W"     
                    timeframe.multiplier <= 6  => "1W"     
                    timeframe.multiplier <= 12 => "2W"     
                    => "2W"           

        intrabars12  => timeframe.from_seconds(filterSmallTfs(timeframe.in_seconds() / 48))
        intrabars24  => timeframe.from_seconds(filterSmallTfs(timeframe.in_seconds() / 96))
        intrabars50  => timeframe.from_seconds(filterSmallTfs(timeframe.in_seconds() / 200))
        intrabars100 => timeframe.from_seconds(filterSmallTfs(timeframe.in_seconds() / 400))
        intrabars250 => timeframe.from_seconds(filterSmallTfs(timeframe.in_seconds() / 1000))
		intrabars500 => timeframe.from_seconds(filterSmallTfs(timeframe.in_seconds() / 2000))
		intrabars1000 => timeframe.from_seconds(filterSmallTfs(timeframe.in_seconds() / 4000))
        => "1S"


// @function                Returns statistics about analyzed intrabars and chart bars covered by calls to
//                          `request.security_lower_tf()`.
//                          This function should execute once per bar for consistent calculations. 
// @param intrabarValues    (array<float>) An array containing values fetched from lower timeframes by a call to
//                          `request.security_lower_tf()`. The function analyzes the array to calculate intrabar
//                          statistics based on the chart's timeframe.
// @returns                 ([int, int, float]) A three-element tuple containing the following data:
//                           - The number of intrabars in the current chart bar ("int").
//                           - The number of chart bars with available intrabar information ("int").
//                           - The average number of intrabars per chart bar ("float").
export ltfStats(array<float> intrabarValues) =>
    // Qty of intrabars in the current chart bar.
    int intrabarsInChartBar = array.size(intrabarValues)
    // Chart bars where intrabar information is available.
    int chartBarsCovered = int(ta.cum(math.sign(intrabarsInChartBar)))
    // Avg qty of intrabars per chart bar.
    float avgIntrabars = nz(ta.cum(intrabarsInChartBar) / chartBarsCovered)
    [intrabarsInChartBar, chartBarsCovered, avgIntrabars]
//#endregion



