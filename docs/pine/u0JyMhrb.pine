//@version=6
indicator("TDP 2 + SMA + Madrid BB + Table", overlay=true)

// ==========================================
// TDP 2 Logic
// ==========================================
bodyRatio(candleOpen, candleClose, candleHigh, candleLow) =>
    math.abs(candleOpen - candleClose) / (candleHigh - candleLow)

currentBodyRatio = bodyRatio(open, close, high, low)
minBodyRatio = 0.55

isBullishCandle = close > open and currentBodyRatio >= minBodyRatio
isBearishCandle = open > close and currentBodyRatio >= minBodyRatio

var float lastBullishCandleLow = na
if isBullishCandle
    lastBullishCandleLow := low

bearishCandleUnderLow = isBearishCandle and close < lastBullishCandleLow
bearishCandleNotUnderLow = isBearishCandle and close >= lastBullishCandleLow

// --- New Logic: Track last two bullish signals ---
var float bullSignal1_high = na
var float bullSignal1_low = na
var float bullSignal2_high = na
var float bullSignal2_low = na

if isBullishCandle
    bullSignal2_high := bullSignal1_high
    bullSignal2_low := bullSignal1_low
    bullSignal1_high := high
    bullSignal1_low := low


// ==========================================
// Simple Moving Average Logic
// ==========================================
GRP_SMA = "Simple Moving Average"
len = input.int(9, minval=1, title="Length", group = GRP_SMA)
src = input.source(close, title="Source", group = GRP_SMA)
offset = input.int(title="Offset", defval=0, minval=-500, maxval=500, display = display.none, group = GRP_SMA)
out = ta.sma(src, len)

GRP_SMOOTH = "SMA Smoothing"
maTypeInput = input.string("None", "Type", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = GRP_SMOOTH, display = display.none)
var isBB = maTypeInput == "SMA + Bollinger Bands"
maLengthInput = input.int(14, "Length", group = GRP_SMOOTH, display = display.none, active = maTypeInput != "None")
bbMultInput = input.float(2.0, "BB StdDev", minval = 0.001, maxval = 50, step = 0.5, group = GRP_SMOOTH, display = display.none, active = isBB)
var enableMA = maTypeInput != "None"

ma(source, length, MAtype) =>
	switch MAtype
		"SMA"                   => ta.sma(source, length)
		"SMA + Bollinger Bands" => ta.sma(source, length)
		"EMA"                   => ta.ema(source, length)
		"SMMA (RMA)"            => ta.rma(source, length)
		"WMA"                   => ta.wma(source, length)
		"VWMA"                  => ta.vwma(source, length)

smoothingMA = enableMA ? ma(out, maLengthInput, maTypeInput) : na
smoothingStDev = isBB ? ta.stdev(out, maLengthInput) * bbMultInput : na


// ==========================================
// Madrid Bollinger Bands Logic
// ==========================================
GRP_MBB = "Madrid Bollinger Bands"
mbb_src = input.source(close, title="Source", group=GRP_MBB)
mbb_length = input.int(34, minval=1, title="Length", group=GRP_MBB)
mbb_mult = input.float(2.0, minval=0.001, maxval=50, title="Multiplier", group=GRP_MBB)

mbb_basis = ta.sma(mbb_src, mbb_length)
mbb_dev = ta.stdev(mbb_src, mbb_length)
mbb_dev2 = mbb_mult * mbb_dev

mbb_upper1 = mbb_basis + mbb_dev
mbb_lower1 = mbb_basis - mbb_dev
mbb_upper2 = mbb_basis + mbb_dev2
mbb_lower2 = mbb_basis - mbb_dev2
mbb_colorBasis = mbb_src >= mbb_basis ? color.blue : color.orange


// ==========================================
// Multi-Timeframe SMA, BB & MACD Logic for Table
// ==========================================
// SMA
smaWeekly = request.security(syminfo.tickerid, "W", ta.sma(close, 20))
smaMonthly = request.security(syminfo.tickerid, "M", ta.sma(close, 10))
smaDaily = request.security(syminfo.tickerid, "D", ta.sma(close, 50))

weeklySmaStatus = close > smaWeekly ? "POSITIVE" : "NEGATIVE"
monthlySmaStatus = close > smaMonthly ? "POSITIVE" : "NEGATIVE"
dailySmaStatus = close > smaDaily ? "POSITIVE" : "NEGATIVE"

// Bollinger Bands (Length 20)
bbThreshold = input.float(5.0, title="BB Status Threshold (%)", group="Table Settings")

[bbBasisW, bbUpperW, bbLowerW] = request.security(syminfo.tickerid, "W", ta.bb(close, 20, 2.0))
[bbBasisM, bbUpperM, bbLowerM] = request.security(syminfo.tickerid, "M", ta.bb(close, 20, 2.0))
[bbBasisD, bbUpperD, bbLowerD] = request.security(syminfo.tickerid, "D", ta.bb(close, 20, 2.0))

getBbStatus(c, basis, upper, lower) =>
    bandWidth = upper - lower
    percent = bandWidth == 0 ? 50 : ((c - lower) / bandWidth) * 100
    
    status = "None"
    if percent >= 45 and percent <= 55
        status := "mid edge"
    else if percent > 55 and percent <= 105
        status := "hi"
    else if percent >= -5 and percent < 45
        status := "in low"
    status

bbStatusW = getBbStatus(close, bbBasisW, bbUpperW, bbLowerW)
bbStatusM = getBbStatus(close, bbBasisM, bbUpperM, bbLowerM)
bbStatusD = getBbStatus(close, bbBasisD, bbUpperD, bbLowerD)

// ==========================================
// Table Creation
// ==========================================
var table dataTable = table.new(position.top_right, 3, 4, border_width = 1)
if barstate.islast
    // Headers
    table.cell(dataTable, 0, 0, "Timeframe", text_color=color.white, bgcolor=color.gray)
    table.cell(dataTable, 1, 0, "SMA Status", text_color=color.white, bgcolor=color.gray)
    table.cell(dataTable, 2, 0, "BB Status", text_color=color.white, bgcolor=color.gray)

    // Daily
    table.cell(dataTable, 0, 1, "Daily", bgcolor=color.gray, text_color=color.white)
    table.cell(dataTable, 1, 1, dailySmaStatus, bgcolor = dailySmaStatus == "POSITIVE" ? color.green : color.red, text_color=color.white)
    table.cell(dataTable, 2, 1, bbStatusD, bgcolor = color.blue, text_color=color.white)

    // Weekly
    table.cell(dataTable, 0, 2, "Weekly", bgcolor=color.gray, text_color=color.white)
    table.cell(dataTable, 1, 2, weeklySmaStatus, bgcolor = weeklySmaStatus == "POSITIVE" ? color.green : color.red, text_color=color.white)
    table.cell(dataTable, 2, 2, bbStatusW, bgcolor = color.blue, text_color=color.white)

    // Monthly
    table.cell(dataTable, 0, 3, "Monthly", bgcolor=color.gray, text_color=color.white)
    table.cell(dataTable, 1, 3, monthlySmaStatus, bgcolor = monthlySmaStatus == "POSITIVE" ? color.green : color.red, text_color=color.white)
    table.cell(dataTable, 2, 3, bbStatusM, bgcolor = color.blue, text_color=color.white)


// ==========================================
// Plotting
// ==========================================
plotshape(series=isBullishCandle, title="Bullish Candle", location=location.abovebar, color=color.green, style=shape.triangleup, size = size.auto)
plotshape(series=bearishCandleUnderLow, title="Bearish Candle Under Low", location=location.belowbar, color=color.red, style=shape.triangledown, size = size.auto)
plotshape(series=bearishCandleNotUnderLow and not na(lastBullishCandleLow), title="Bearish Candle Not Under Low", location=location.belowbar, color=color.orange, style=shape.xcross, size = size.auto)

plot(out, color=color.blue, title="MA", offset=offset)
plot(smoothingMA, "SMA-based MA", color=color.yellow, display = enableMA ? display.all : display.none, editable = enableMA)
bbUpperBand = plot(smoothingMA + smoothingStDev, title = "Upper Bollinger Band", color=color.green, display = isBB ? display.all : display.none, editable = isBB)
bbLowerBand = plot(smoothingMA - smoothingStDev, title = "Lower Bollinger Band", color=color.green, display = isBB ? display.all : display.none, editable = isBB)
fill(bbUpperBand, bbLowerBand, color= isBB ? color.new(color.green, 90) : na, title="Bollinger Bands Background Fill", display = isBB ? display.all : display.none, editable = isBB)

mbb_pBasis = plot(mbb_basis, linewidth=2, color=mbb_colorBasis, title="MBB Basis")
mbb_pUpper1 = plot(mbb_upper1, color=color.blue, style=plot.style_circles, title="MBB Upper 1")
mbb_pUpper2 = plot(mbb_upper2, color=color.blue, title="MBB Upper 2")
mbb_pLower1 = plot(mbb_lower1, color=color.orange, style=plot.style_circles, title="MBB Lower 1")
mbb_pLower2 = plot(mbb_lower2, color=color.orange, title="MBB Lower 2")

fill(mbb_pBasis, mbb_pUpper2, color=color.new(color.blue, 80), title="MBB Basis-Upper2")
fill(mbb_pUpper1, mbb_pUpper2, color=color.new(color.blue, 80), title="MBB Upper1-Upper2")
fill(mbb_pBasis, mbb_pLower2, color=color.new(color.orange, 80), title="MBB Basis-Lower2")
fill(mbb_pLower1, mbb_pLower2, color=color.new(color.orange, 80), title="MBB Lower1-Lower2")