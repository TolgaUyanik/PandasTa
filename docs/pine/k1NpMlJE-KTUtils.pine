//@version=6
//@description Utility functions for technical analysis indicators, trend detection, and volatility confirmation.
library('KTUtils', overlay = true)

// @function MGz
// @description Moving average smoother used for signal processing
// @param close float Price input (typically close)
// @param length int Length of smoothing period
// @returns float Smoothed value
export MGz(float close, int length) =>
    MGz = 0.0
    MGz := (close + nz(MGz[1] * (length - 1))) / length
    MGz

// @function atrConf
// @description Calculates Average True Range (ATR) for volatility confirmation
// @param length int Length for ATR calculation
// @returns float ATR value
export atrConf(int length) =>
    trueRange = na(high[1]) ? high - low : math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
    ta.rma(trueRange, length)

// @function f
// @description Simple Moving Average with fixed length
// @param input float Input value
// @returns float Smoothed average
export f(float input) =>
    ta.sma(input, 10)

// @function bcwSMA
// @description Custom smoothing function with weight multiplier
// @param s float Signal value
// @param l int Length of smoothing
// @param m int Weighting multiplier
// @returns float Smoothed output
export bcwSMA(float s, int l, int m) =>
    _bcwSMA = float(na)
    _bcwSMA := (m * s + (l - m) * nz(_bcwSMA[1])) / l
    _bcwSMA

// @function MGxx
// @description Custom Weighted Moving Average (WMA) variant
// @param close float Price input
// @param length int Period length
// @returns float MGxx smoothed output
export MGxx(float close, int length) =>
    ta.wma(2 * ta.wma(close, int(int(length / 2))) - ta.wma(close, length), math.round(math.sqrt(length)))

// @function _PerChange
// @description Measures percentage price change over a period and range deviation
// @param lengthTime int Period for change measurement
// @returns tuple<float,float,float> Measured change, high deviation, low deviation
export _PerChange(int lengthTime) =>
    float measuredChange = (close[0] - open[lengthTime]) / open[lengthTime] * 100
    float rangeHigh = na
    float rangeLow = na
    for i = lengthTime to 0 by 1
        rangeHigh := i == lengthTime ? high : high[i] > high[i + 1] ? high[i] : rangeHigh[1]
        rangeLow := i == lengthTime ? low : low[i] < low[i + 1] ? low[i] : rangeLow[1]
        rangeLow
    float start_to_high = (rangeHigh - open[lengthTime]) / open[lengthTime] * 100
    float start_to_low = (rangeLow - open[lengthTime]) / open[lengthTime] * 100
    [measuredChange, start_to_high, start_to_low]

// @function dirmov
// @description Calculates directional movement components
// @param len int Lookback period
// @returns tuple<float,float> Plus and Minus DI values
export dirmov(int len) =>
    float up = ta.change(high)
    float down = -ta.change(low)
    float plusDM = na(up) ? na : up > down and up > 0 ? up : 0
    float minusDM = na(down) ? na : down > up and down > 0 ? down : 0
    float truerange = ta.rma(ta.tr, len)
    float plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    float minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]

// @function adx
// @description Calculates Average Directional Index (ADX)
// @param dilen int Length for DI calculation
// @param adxlen int Length for ADX smoothing
// @returns float ADX value
export adx(int dilen, simple int adxlen) =>
    simple int _adxlen = adxlen
    [plus, minus] = dirmov(dilen)
    float sum = plus + minus
    float adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), _adxlen)
    adx

// @function trChopAnalysis
// @description Identifies chop and trend phases based on True Range Bollinger Bands
// @returns tuple<float,bool,bool> TR SMA, chop state, trending state
export trChopAnalysis() =>
    trSMA = ta.sma(ta.tr(false), 20)
    [midRange, highRange, lowRange] = ta.bb(trSMA, 20, 2)
    bool chop = trSMA < lowRange
    bool trending = not chop
    [trSMA, chop, trending]

// @function wtiAnalysis
// @description Wave Trend Indicator (WTI) with signal crossover logic
// @param haclose float Heikin-Ashi close
// @param close float Standard close
// @param filterValue int Smoothing length
// @returns tuple<float,float,bool,bool> WTI lines and direction states
export wtiAnalysis(float haclose, float close, int filterValue) =>
    EMA5 = ta.ema(haclose, 5)
    EMA10 = ta.ema(haclose, 10)
    EMAwti = ta.ema(haclose, filterValue)
    d = ta.ema(math.abs(close - EMAwti), 10)
    ci = (close - EMAwti) / (0.015 * d)
    tci = ta.ema(ci, 5)
    wt1 = tci
    wt2 = ta.sma(wt1, 4)
    bool wtiUp = wt2 - wt1 < 0
    bool wtiDwn = wt2 - wt1 > 0
    [wt1, wt2, wtiUp, wtiDwn]

// @function basicTrend
// @description Determines trend direction based on HA high/low and close
// @param hahigh float Heikin-Ashi high
// @param halow float Heikin-Ashi low
// @param close float Standard close
// @param open float Standard open
// @param filterValue int Smoothing period
// @returns tuple<bool,bool> Uptrend, downtrend flags
export basicTrend(float hahigh, float halow, float close, float open, int filterValue) =>
    avghigh = ta.ema(hahigh, filterValue)
    avglow = ta.ema(halow, filterValue)
    bool UP = open < close and close > avghigh
    bool DWN = open > close and close < avglow
    [UP, DWN]

// @function metrics
// @description Common market metrics
// @param close float Price input
// @param filterValue int RSI smoothing length
// @returns tuple<float,float,float,float> VWMA, SMA10, RSI, smoothed RSI
export metrics(float close, int filterValue) =>
    VWMA = ta.vwma(close, 10)
    SMA10 = ta.sma(close, 10)
    RSI = ta.rsi(close, 8)
    rsiSMA = ta.sma(RSI, filterValue)
    [VWMA, SMA10, RSI, rsiSMA]

// @function piff
// @description Price-Informed Forward Forecasting (PIFF) model for trend strength
// @param close float Price input
// @param trend_change float Change in trend
// @returns tuple<float,float,bool,bool,bool,bool> Percent change, flags for trend direction
export piff(float close, float trend_change) =>
    Pos = 1.0
    Neg = -1.0
    percent = ta.change(close[100])
    diff = close / close[100] * 100
    percentchange = diff - 100
    bool perUp = percent >= Pos
    bool perDwn = percent <= Neg
    bool piffUp = trend_change > Pos
    bool piffDwn = trend_change < Neg
    [percent, percentchange, perUp, perDwn, piffUp, piffDwn]

// @function getMACD
// @description Returns MACD, signal line, and histogram
// @returns tuple<float,float,float> MACD line, Signal line, Histogram
export getMACD() =>
    [macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
    [macdLine, signalLine, histLine]

// @function getStoch
// @description Returns K and D lines of Stochastic Oscillator
// @returns tuple<float,float> K and D lines
export getStoch() =>
    K = ta.sma(ta.stoch(close, high, low, 14), 3)
    D = ta.sma(K, 7)
    [K, D]

// @function getKDJ
// @description KDJ momentum oscillator
// @returns tuple<float,float,float,float> K, D, J, Average
export getKDJ() =>
    float high14 = ta.highest(high, 14)
    float low14 = ta.lowest(low, 14)
    RSV = 100 * ((close - low14) / (high14 - low14))
    pK = bcwSMA(RSV, 3, 1)
    pD = bcwSMA(pK, 3, 1)
    pJ = 3 * pK - 2 * pD
    KDJ = math.avg(pD, pJ, pK)
    [pK, pD, pJ, KDJ]

// @function getBBRatio
// @description Bollinger Band Ratio (BBR) and signal flags
// @returns tuple<float,float,float,float,bool,bool> Basis, Upper, Lower, BBR, BBR Up, BBR Down
export getBBRatio() =>
    [basis, upper, lower] = ta.bb(close, 20, 2)
    bbr = (close - lower) / (upper - lower)
    bool bbrUp = bbr > 0
    bool bbrDwn = bbr < 0
    [basis, upper, lower, bbr, bbrUp, bbrDwn]

// @function getSupertrend
// @description Supertrend values and direction flags
// @returns tuple<float,int,bool,bool> Supertrend, Direction, Up, Down
export getSupertrend() =>
    [supertrend, direction] = ta.supertrend(3, 10)
    bool sUp = direction < 0
    bool sDwn = direction > 0
    [supertrend, direction, sUp, sDwn]

// @function getPivots
// @description Calculates pivot highs and lows for swing detection
// @param filterValue int Lookback/lookahead length for pivot detection
// @returns tuple<float,float> Pivot high, Pivot low (na when no pivot detected)
export getPivots(int filterValue) =>
    float ph = ta.pivothigh(filterValue, filterValue)
    float pl = ta.pivotlow(filterValue, filterValue)
    [ph, pl]

// @function emaEma
// @description Double EMA smoothing (EMA of EMA)
// @param source float Input source
// @param length int EMA length
// @returns float Double-smoothed EMA value
export emaEma(float source, int length) =>
    ta.ema(ta.ema(source, length), length)

// @function getSMI
// @description Stochastic Momentum Index with signal line
// @param lengthK int %K length for highest/lowest calculation
// @param lengthD int %D length for EMA smoothing
// @param lengthEMA int Signal line EMA length
// @returns tuple<float,float,bool,bool> SMI value, SMI signal line, bullish flag, bearish flag
export getSMI(int lengthK, int lengthD, int lengthEMA) =>
    float highestHigh = ta.highest(high, lengthK)
    float lowestLow = ta.lowest(low, lengthK)
    float highestLowestRange = highestHigh - lowestLow
    float relativeRange = close - (highestHigh + lowestLow) / 2
    float smi = 200 * (emaEma(relativeRange, lengthD) / emaEma(highestLowestRange, lengthD))
    float smiMA = ta.ema(smi, lengthEMA)
    bool smiUp = smi > smiMA
    bool smiDwn = smi < smiMA
    [smi, smiMA, smiUp, smiDwn]

// @type Point data structure for chart coordinates
// @field index The bar index (x coordinate) where the point is located
// @field price The price level (y coordinate) where the point is located
export type Point
    int index
    float price

// @function getHighLowPoints
// @description Detects highest high and lowest low points over a specified lookback period
// @param pointLength int Lookback period for high/low detection
// @returns tuple<Point,Point> Lowest point, Highest point (may be na if not detected on current bar)
export getHighLowPoints(int pointLength) =>
    Point lowest = na
    Point highest = na
    
    if ta.lowestbars(low, pointLength) == 0
        lowest := Point.new(bar_index, low)
    
    if ta.highestbars(high, pointLength) == 0
        highest := Point.new(bar_index, high)
    
    [lowest, highest]

// @function drawHighLowPoints
// @description Draws labels and lines for highest high and lowest low points with automatic cleanup
// @param pointLength int Lookback period for high/low detection
// @param showLabels bool Display price labels on points
// @param showLines bool Display horizontal lines extending from points
// @param lowColor color Color for low point markers (default: green)
// @param highColor color Color for high point markers (default: maroon)
// @param transparency int Transparency level 0-100 (default: 50)
// @returns tuple<label,line,label,line> Low label, Low line, High label, High line
export drawHighLowPoints(int pointLength, bool showLabels = true, bool showLines = true, 
                         color lowColor = color.green, color highColor = color.maroon, 
                         int transparency = 50) =>
    var label lowest_label = na
    var line lowest_line = na
    var label highest_label = na
    var line highest_line = na
    
    Point lowest = na
    Point highest = na
    
    // Detect and draw low points
    if ta.lowestbars(low, pointLength) == 0
        lowest := Point.new(bar_index, low)
        
        if showLabels
            if not na(lowest_label)
                label.delete(lowest_label)
            lowest_label := label.new(lowest.index, lowest.price, 
                 syminfo.currency + " " + str.tostring(lowest.price, "#,###.##"), 
                 style=label.style_label_up, 
                 color=color.new(lowColor, transparency))
        
        if showLines
            if not na(lowest_line)
                line.delete(lowest_line)
            lowest_line := line.new(lowest.index, lowest.price, lowest.index + 1, lowest.price, 
                 extend=extend.right,
                 color=color.new(lowColor, transparency))
    
    // Detect and draw high points
    if ta.highestbars(high, pointLength) == 0
        highest := Point.new(bar_index, high)
        
        if showLabels
            if not na(highest_label)
                label.delete(highest_label)
            highest_label := label.new(highest.index, highest.price, 
                 syminfo.currency + " " + str.tostring(highest.price, "#,###.##"), 
                 style=label.style_label_down, 
                 color=color.new(highColor, transparency))
        
        if showLines
            if not na(highest_line)
                line.delete(highest_line)
            highest_line := line.new(highest.index, highest.price, highest.index + 1, highest.price, 
                 extend=extend.right,
                 color=color.new(highColor, transparency))
    
    [lowest_label, lowest_line, highest_label, highest_line]
