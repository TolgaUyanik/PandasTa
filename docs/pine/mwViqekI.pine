//@version=6
library("MaidongAlertLibrary", overlay = true)

formatTimeframe(string tf) =>
    string tfText = ""
    if str.contains(tf, "S")
        tfText := tf == "S" ? " 1 Second" : str.substring(tf, 0, str.length(tf) - 1) + " Seconds"
    else if str.contains(tf, "D")
        tfText := tf == "D" ? " Daily" : str.substring(tf, 0, str.length(tf) - 1) + " Days"
    else if str.contains(tf, "W")
        tfText := tf == "W" ? " Weekly" : str.substring(tf, 0, str.length(tf) - 1) + " Weeks"
    else if str.contains(tf, "M")
        tfText := tf == "M" ? " Monthly" : str.substring(tf, 0, str.length(tf) - 1) + " Months"
    else
        float tfNumber = nz(str.tonumber(tf), 0)
        if tfNumber < 60
            tfText := tf == "1" ? "1 Minute" : tf + " Minutes"
        else
            tfText := tf == "60" ? " 1 Hour" : str.tostring(tfNumber / 60) + " Hours"
    tfText

export AlertSender(bool condition, string alertSetting, string alertName, string alertType, string detectionType, string setupData, string frequency, string utcZone, string moreInfo, string message,
     float o, float h, float l, float c, float entry, float tp, float sl, float distal, float proximal) =>
    string timeText = str.format_time(time, "    yy-MM-dd \n    HH:mm:ss", utcZone)
    string typeText = ""
    if detectionType == "Signal" or detectionType == "Order Block Signal" or detectionType == "Setup"
        typeText := alertType == "Bullish" ? "Long " + detectionType : "Short " + detectionType
    else
        typeText := alertType + " " + detectionType

    string timeframeText = formatTimeframe(timeframe.period)
    string alertText = ""
    if moreInfo == "Off"
        alertText := "Alert Name: " + alertName + "\nAlert Type: " + typeText + "\nSymbol: " + syminfo.ticker + "\nTime Frame: " + timeframeText + "\nMessage: " + message
    else if detectionType == "Order Block Signal"
        alertText := "Alert Name: " + alertName + "\nAlert Type: " + typeText + "\nSymbol: " + syminfo.ticker + "\nTime Frame: " + timeframeText + "\nTime:\n" + timeText +
         "\nZone Price =>\n     Distal:" + str.tostring(distal) + "\n     Proximal:" + str.tostring(proximal) + "\nMessage: " + message
    else if detectionType == "Signal"
        alertText := "Alert Name: " + alertName + "\nAlert Type: " + typeText + "\nSymbol: " + syminfo.ticker + "\nTime Frame: " + timeframeText + "\nTime:\n" + timeText +
         "\nMarket Price =>\n     Open:" + str.tostring(o) + "\n     High:" + str.tostring(h) + "\n     Low:" + str.tostring(l) + "\n     Close:" + str.tostring(c) + "\nMessage: " + message
    else if detectionType == "Setup"
        if setupData == "Full"
            alertText := "Alert Name: " + alertName + "\nAlert Type: " + typeText + "\nSymbol: " + syminfo.ticker + "\nTime Frame: " + timeframeText + "\nTime:\n" + timeText +
             "\nSetup Price Data =>\n     Entry:" + str.tostring(entry) + "\n     Stop Loss:" + str.tostring(sl) + "\n     Take Profit:" + str.tostring(tp) + "\nMessage: " + message
        else
            alertText := "Alert Name: " + alertName + "\nAlert Type: " + typeText + "\nSymbol: " + syminfo.ticker + "\nTime Frame: " + timeframeText + "\nTime:\n" + timeText +
             "\nSetup Price Data =>\n     Entry:" + str.tostring(o) + "\nMessage: " + message
    else if detectionType == "Analysis"
        alertText := "Alert Name: " + alertName + "\nAlert Type: " + typeText + "\nSymbol: " + syminfo.ticker + "\nTime Frame: " + timeframeText + "\nMessage: " + message
    else
        alertText := "Alert Name: " + alertName + "\nAlert Type: " + typeText + "\nSymbol: " + syminfo.ticker + "\nTime Frame: " + timeframeText + "\nTime:\n" + timeText + "\nMessage: " + message

    if alertSetting == "On" and condition
        if frequency == "All"
            alert(alertText, alert.freq_all)
        else if frequency == "Once Per Bar"
            alert(alertText, alert.freq_once_per_bar)
        else if frequency == "Once Per Bar Close"
            alert(alertText, alert.freq_once_per_bar_close)
