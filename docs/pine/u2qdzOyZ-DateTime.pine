        CustomDateFormat.FORMAT_29 => "yyyy-dd-MM"
        CustomDateFormat.FORMAT_30 => "yyyy.dd.MM"
        => "yyyy-MM-dd"


// @function      Converts a `DatePrefix` enum value to a format string.
// @param prefix  (series DatePrefix) A date prefix format.
// @returns       A format string specifying a day of week representation to be used as a prefix in a date string.
method tostring(DatePrefix prefix) =>
    switch prefix
        DatePrefix.NONE                     => na
        DatePrefix.DAY_OF_WEEK_ABBREVIATION => "E "
        DatePrefix.DAY_OF_WEEK_FULL_NAME    => "EEEE "
        => na


// @function         Converts a `TimeSeparator` enum value to its string representation.
// @param separator  (series TimeSeparator) A time separator format.
// @returns          A character to be used as a separator for the hours/minutes of a time string.
method tostring(TimeSeparator separator) =>
    switch separator
        TimeSeparator.NONE   => na
        TimeSeparator.COLON  => ":"
        TimeSeparator.DOT    => "."
        TimeSeparator.LETTER => "'h'"    // using escape character since the letter 'h' in this scenario should not act as a formatting token
        => na

//#endregion



//#region ------------------------------ Date Formatting ------------------------------

// @function         Common function for converting a timestamp into a formatted date string.
// @param timestamp  (series int) The UNIX timestamp.
// @param format     (series string) The date format string.
// @param timezone   (series string) The timezone used to represent the timestamp.
// @param trim       (series bool) True if leading zeroes should be removed from the numeric month & day of month.
// @returns          A formatted date string.
date(int timestamp, string format, string timezone, bool trim) =>
    string dateFormat = format

    if trim
        dateFormat := str.replace(dateFormat, "dd", "d")

        if not str.contains(dateFormat, "MMM")    // avoid modifying formats that use the three-letter abbreviation of month (MMM) or the full month name (MMMM)
            dateFormat := str.replace(dateFormat, "MM", "M")

    if str.contains(dateFormat, "Q")            // manual conversion since 'Q' is not an actual formatting token
        int quarter = math.ceil(month(timestamp, timezone) / 3)
        dateFormat := str.replace(dateFormat, "Q", "'Q'" + str.tostring(quarter))

    str.format_time(timestamp, dateFormat, timezone)


// @function  Converts a UNIX timestamp into a date string formatted according to the selected `format`.
// ___
// **Parameters**
// ```
// • series int timestamp
// • series DateFormat format
// • series string timezone
// • series DatePrefix prefix
// • series bool trim
// ```
// `timestamp` - The UNIX timestamp (in milliseconds) to get the calendar date from. \
// `format` - The user-selected date format.  A value of [na](https://www.tradingview.com/pine-script-reference/v6/#var_na) will result in a default 𝚢𝚢𝚢𝚢-𝙼𝙼-𝚍𝚍 format. \
// `timezone` - A timezone specified in either UTC/GMT notation or as an IANA time zone database name.  The default is [syminfo.timezone](https://www.tradingview.com/pine-script-reference/v6/#var_syminfo.timezone). \
// `prefix` - The day of week prefix to add at the beginning of the resulting string.  The default is no prefix. \
// `trim` - Whether to remove leading zeroes from the 2-digit month and 2-digit day of month.  The default is [false](https://www.tradingview.com/pine-script-reference/v6/#const_false).
// ___
// **Usage**
// > ```
// > int timestamp = timenow
// > format = input.enum(DateFormat.FORMAT_3)
// > string formattedDate = formatDate(timestamp, format, syminfo.timezone, prefix = DatePrefix.NONE, trim = true)
// > ```
// >
// ___
// @param timestamp  (series int) A UNIX time.
// @param format     (series DateFormat) A date format.
// @param timezone   (series string) A UTC/GMT offset or IANA time zone identifier.
// @param prefix     (series DatePrefix) Optional day of week prefix.
// @param trim       (series bool) Optional truncation of numeric month / day.
// @returns          Calendar date string using the selected format.
export formatDate(int timestamp, DateFormat format, string timezone = syminfo.timezone, DatePrefix prefix = DatePrefix.NONE, bool trim = false) =>
    date(timestamp, prefix.tostring() + format.tostring(), timezone, trim)


// @function  Converts a UNIX timestamp into a date string formatted according to the selected `format`.
// ___
// **Parameters**
// ```
// • series int timestamp
// • series DateFormatDayOfWeekAbbr format
// • series string timezone
// • series DatePrefix prefix
// • series bool trim
// ```
// `timestamp` - The UNIX timestamp (in milliseconds) to get the calendar date from. \
// `format` - The user-selected date format.  A value of [na](https://www.tradingview.com/pine-script-reference/v6/#var_na) will result in a default 𝚢𝚢𝚢𝚢-𝙼𝙼-𝚍𝚍 format. \
// `timezone` - A timezone specified in either UTC/GMT notation or as an IANA time zone database name.  The default is [syminfo.timezone](https://www.tradingview.com/pine-script-reference/v6/#var_syminfo.timezone). \
// `prefix` - The day of week prefix to add at the beginning of the resulting string.  The default is the abbreviation of the day of week. \
// `trim` - Whether to remove leading zeroes from the 2-digit month and 2-digit day of month.  The default is [false](https://www.tradingview.com/pine-script-reference/v6/#const_false).
// ___
// **Usage**
// > ```
// > int timestamp = timenow
// > format = input.enum(DateFormatDayOfWeekAbbr.FORMAT_3)
// > string formattedDate = formatDate(timestamp, format, syminfo.timezone, prefix = DatePrefix.DAY_OF_WEEK_ABBREVIATION, trim = true)
// > ```
// >
// ___
// @param timestamp  (series int) A UNIX time.
// @param format     (series DateFormatDayOfWeekAbbr) A date format.
// @param timezone   (series string) A UTC/GMT offset or IANA time zone identifier.
// @param prefix     (series DatePrefix) Optional day of week prefix.
// @param trim       (series bool) Optional truncation of numeric month / day.
// @returns          Calendar date string using the selected format.
export formatDate(int timestamp, DateFormatDayOfWeekAbbr format, string timezone = syminfo.timezone, DatePrefix prefix = DatePrefix.DAY_OF_WEEK_ABBREVIATION, bool trim = false) =>
    date(timestamp, prefix.tostring() + format.tostring(), timezone, trim)


// @function  Converts a UNIX timestamp into a date string formatted according to the selected `format`.
// ___
// **Parameters**
// ```
// • series int timestamp
// • series DateFormatDayOfWeekFull format
// • series string timezone
// • series DatePrefix prefix
// • series bool trim
// ```
// `timestamp` - The UNIX timestamp (in milliseconds) to get the calendar date from. \
// `format` - The user-selected date format.  A value of [na](https://www.tradingview.com/pine-script-reference/v6/#var_na) will result in a default 𝚢𝚢𝚢𝚢-𝙼𝙼-𝚍𝚍 format. \
// `timezone` - A timezone specified in either UTC/GMT notation or as an IANA time zone database name.  The default is [syminfo.timezone](https://www.tradingview.com/pine-script-reference/v6/#var_syminfo.timezone). \
// `prefix` - The day of week prefix to add at the beginning of the resulting string.  The default is the full name of the day of week. \
// `trim` - Whether to remove leading zeroes from the 2-digit month and 2-digit day of month.  The default is [false](https://www.tradingview.com/pine-script-reference/v6/#const_false).
// ___
// **Usage**
// > ```
// > int timestamp = timenow
// > format = input.enum(DateFormatDayOfWeekFull.FORMAT_3)
// > string formattedDate = formatDate(timestamp, format, syminfo.timezone, prefix = DatePrefix.DAY_OF_WEEK_FULL_NAME, trim = true)
// > ```
// >
// ___
// @param timestamp  (series int) A UNIX time.
// @param format     (series DateFormatDayOfWeekFull) A date format.
// @param timezone   (series string) A UTC/GMT offset or IANA time zone identifier.
// @param prefix     (series DatePrefix) Optional day of week prefix.
// @param trim       (series bool) Optional truncation of numeric month / day.
// @returns          Calendar date string using the selected format.
export formatDate(int timestamp, DateFormatDayOfWeekFull format, string timezone = syminfo.timezone, DatePrefix prefix = DatePrefix.DAY_OF_WEEK_FULL_NAME, bool trim = false) =>
    date(timestamp, prefix.tostring() + format.tostring(), timezone, trim)


// @function  Converts a UNIX timestamp into a date string formatted according to the selected `format`.
// ___
// **Parameters**
// ```
// • series int timestamp
// • series CustomDateFormat format
// • series string timezone
// • series DatePrefix prefix
// • series bool trim
// ```
// `timestamp` - The UNIX timestamp (in milliseconds) to get the calendar date from. \
// `format` - The user-selected date format.  A value of [na](https://www.tradingview.com/pine-script-reference/v6/#var_na) will result in a default 𝚢𝚢𝚢𝚢-𝙼𝙼-𝚍𝚍 format. \
// `timezone` - A timezone specified in either UTC/GMT notation or as an IANA time zone database name.  The default is [syminfo.timezone](https://www.tradingview.com/pine-script-reference/v6/#var_syminfo.timezone). \
// `prefix` - The day of week prefix to add at the beginning of the resulting string.  The default is no prefix. \
// `trim` - Whether to remove leading zeroes from the 2-digit month and 2-digit day of month.  The default is [false](https://www.tradingview.com/pine-script-reference/v6/#const_false).
// ___
// **Usage**
// > ```
// > int timestamp = timenow
// > format = input.enum(CustomDateFormat.FORMAT_6)
// > string formattedDate = formatDate(timestamp, format, syminfo.timezone, prefix = DatePrefix.NONE, trim = true)
// > ```
// >
// ___
// @param timestamp  (series int) A UNIX time.
// @param format     (series CustomDateFormat) A date format.
// @param timezone   (series string) A UTC/GMT offset or IANA time zone identifier.
// @param prefix     (series DatePrefix) Optional day of week prefix.
// @param trim       (series bool) Optional truncation of numeric month / day.
// @returns          Calendar date string using the selected format.
export formatDate(int timestamp, CustomDateFormat format, string timezone = syminfo.timezone, DatePrefix prefix = DatePrefix.NONE, bool trim = false) =>
    date(timestamp, prefix.tostring() + format.tostring(), timezone, trim)

//#endregion



//#region ------------------------------ Time Formatting ------------------------------

// @function         Converts a timestamp into a formatted time string using the 12-hour clock.
// @param timestamp  (series int) The UNIX timestamp.
// @param timezone   (series string) The timezone used to represent the timestamp.
// @param trim       (series TimeAbbreviation) The format to use for removing leading zeroes from the hour and/or minute.
// @param separator  (series string) The time separator.
// @param postfix    (series TimePostfix) The format to use for the time postfix.
// @param space      (series bool) True if a space should be added between the time and the postfix.
// @param offset     (series bool) True if the time zone offset should be included.
// @returns          A formatted 12-hour time string.
format12HourTime(int timestamp, string timezone, TimeAbbreviation trim, string separator, TimePostfix postfix, bool space, bool offset) =>
    bool trimHours = trim == TimeAbbreviation.TRIM_HOURS or trim == TimeAbbreviation.TRIM_HOURS_AND_MINUTES
    bool trimMinutes = trim == TimeAbbreviation.TRIM_MINUTES or trim == TimeAbbreviation.TRIM_HOURS_AND_MINUTES

    string timeFormat = (trimHours ? "h" : "hh") + separator + "mm" + (space ? " " : na) + "a"

    string result = str.format_time(timestamp, timeFormat, timezone)

    if trimMinutes
        result := str.replace(result, str.replace_all(separator, "'", na) + "00", na)

    result := switch postfix
        TimePostfix.CAPITALS            => result
        TimePostfix.SMALL_CAPS          => str.replace(str.replace(result, "AM", "ꭺꮇ"), "PM", "ꮲꮇ")
        TimePostfix.LOWERCASE           => str.lower(result)
        TimePostfix.LOWERCASE_WITH_DOTS => str.lower(str.replace(result, "M", ".M."))
        => result

    if offset
        result += " " + tz.offset(timestamp, tz.OffsetFormat.MINIMAL, timezone, prefix = "UTC", colon = true)

    result


// @function         Converts a timestamp into a formatted time string using the 24-hour clock. \
//                   If the requested format is a military time format (i.e., there is no `separator` character), \
//                   then using `offset` = true will add a military time zone letter at the end of the result. \
//                   Reference: https://en.wikipedia.org/wiki/24-hour_clock#Military_time
// @param timestamp  (series int) The UNIX timestamp.
// @param timezone   (series string) The timezone used to represent the timestamp.
// @param separator  (series string) The time separator.
// @param offset     (series bool) True if the time zone offset should be included.
// @returns          A formatted 24-hour time string.
format24HourTime(int timestamp, string timezone, string separator, bool offset) =>
    string timeFormat = "HH" + separator + "mm"

    string result = str.format_time(timestamp, timeFormat, timezone)

    if offset
        bool militaryTime = na(separator)
        if not militaryTime
            result += " "
        result += tz.offset(timestamp, militaryTime ? tz.OffsetFormat.NAUTICAL : tz.OffsetFormat.MINIMAL, timezone, prefix = "UTC", colon = true)

    result


// @function  Converts a UNIX timestamp into a formatted time of day string using the 24-hour clock or 12-hour clock. \
//            \
//            The `trim`, `postfix`, and `space` parameters are unused for the 24-hour time format. \
//            \
//            Note: if using `offset` = 𝚝𝚛𝚞𝚎 to include the time zone offset, it will be formatted as a UTC offset in most cases. \
//            The UTC offset will use the same format that TradingView uses to display UTC offset values on its chart UI. \
//            The only exception is for a military time format (`format` = 𝚃𝚒𝚖𝚎𝙵𝚘𝚛𝚖𝚊𝚝.𝚃𝚆𝙴𝙽𝚃𝚈_𝙵𝙾𝚄𝚁_𝙷𝙾𝚄𝚁𝚂 and `separator` = 𝚃𝚒𝚖𝚎𝚂𝚎𝚙𝚊𝚛𝚊𝚝𝚘𝚛.𝙽𝙾𝙽𝙴) \
//            in which case a military time zone letter will be used instead of a UTC offset string.
// ___
// **Parameters**
// ```
// • series int timestamp
// • series TimeFormat format
// • series string timezone
// • series TimeAbbreviation trim
// • series TimeSeparator separator
// • series TimePostfix postfix
// • series bool space
// • series bool offset
// ```
// `timestamp` - The UNIX timestamp (in milliseconds) to get the time of day from. \
// `format` - The user-selected time format.  A value of [na](https://www.tradingview.com/pine-script-reference/v6/#var_na) will result in a default 24-hour time format. \
// `timezone` - A timezone specified in either UTC/GMT notation or as an IANA time zone database name.  The default is [syminfo.timezone](https://www.tradingview.com/pine-script-reference/v6/#var_syminfo.timezone). \
// `trim` - The abbreviation to use for the time string.  The default is no abbreviation (2-digit hour and 2-digit minute with leading zeroes). \
// `separator` - The character to insert between the hour and minute portion of the time.  The default is a colon (':'). \
// `postfix` - The style of the AM/PM postfix.  The default is capital letters ('AM' if the time of day is before noon, 'PM' otherwise). \
// `space` - Whether to include a space separator between the time and the postfix.  The default is [true](https://www.tradingview.com/pine-script-reference/v6/#const_true). \
// `offset` - Whether to include a formatted UTC offset at the end of the resulting string.  The default is [false](https://www.tradingview.com/pine-script-reference/v6/#const_false).
// ___
// **Usage**
// > ```
// > int timestamp = timenow
// > format = input.enum(TimeFormat.TWENTY_FOUR_HOURS)
// > string formattedTime = formatTime(timestamp, format, syminfo.timezone,
// >                                   trim = TimeAbbreviation.TRIM_HOURS_AND_MINUTES,
// >                                   separator = TimeSeparator.COLON,
// >                                   postfix = TimePostfix.LOWERCASE,
// >                                   space = false,
// >                                   offset = true)
// > ```
// >
// ___
// **Examples** \
// The table below shows example outputs using the 12-hour time format and some combinations of optional parameters.
// ```
// 
// `trim`                                  │ `separator`          │ `postfix`                       │ `space` │ `offset` │ Result
// ────────────────────────────────────────┼──────────────────────┼─────────────────────────────────┼─────────┼──────────┼───────────────────
// TimeAbbreviation.DEFAULT                │ TimeSeparator.NONE   │ TimePostfix.CAPITALS            │ false   │ false    │ '0300AM'
// TimeAbbreviation.DEFAULT                │ TimeSeparator.NONE   │ TimePostfix.SMALL_CAPS          │ true    | false    | '0300 ꭺꮇ'
// TimeAbbreviation.DEFAULT                │ TimeSeparator.COLON  │ TimePostfix.LOWERCASE           │ false   | true     | '03:00am UTC-5'
// TimeAbbreviation.DEFAULT                │ TimeSeparator.COLON  │ TimePostfix.LOWERCASE_WITH_DOTS │ true    | true     | '03:00 a.m. UTC-5'
// TimeAbbreviation.TRIM_HOURS             │ TimeSeparator.DOT    │ TimePostfix.CAPITALS            │ false   │ false    │ '3.00AM'
// TimeAbbreviation.TRIM_HOURS             │ TimeSeparator.DOT    │ TimePostfix.SMALL_CAPS          │ true    | false    | '3.00 ꭺꮇ'
// TimeAbbreviation.TRIM_HOURS             │ TimeSeparator.LETTER │ TimePostfix.LOWERCASE           │ false   | true     | '3h00am UTC-5'
// TimeAbbreviation.TRIM_HOURS             │ TimeSeparator.LETTER │ TimePostfix.LOWERCASE_WITH_DOTS │ true    | true     | '3h00 a.m. UTC-5'
// TimeAbbreviation.TRIM_MINUTES           │ TimeSeparator.NONE   │ TimePostfix.CAPITALS            │ false   │ false    │ '03AM'
// TimeAbbreviation.TRIM_MINUTES           │ TimeSeparator.NONE   │ TimePostfix.SMALL_CAPS          │ true    | false    | '03 ꭺꮇ'
// TimeAbbreviation.TRIM_MINUTES           │ TimeSeparator.COLON  │ TimePostfix.LOWERCASE           │ false   | true     | '03am UTC-5'
// TimeAbbreviation.TRIM_MINUTES           │ TimeSeparator.COLON  │ TimePostfix.LOWERCASE_WITH_DOTS │ true    | true     | '03 a.m. UTC-5'
// TimeAbbreviation.TRIM_HOURS_AND_MINUTES │ TimeSeparator.DOT    │ TimePostfix.CAPITALS            │ false   │ false    │ '3AM'
// TimeAbbreviation.TRIM_HOURS_AND_MINUTES │ TimeSeparator.DOT    │ TimePostfix.SMALL_CAPS          │ true    | false    | '3 ꭺꮇ'
// TimeAbbreviation.TRIM_HOURS_AND_MINUTES │ TimeSeparator.LETTER │ TimePostfix.LOWERCASE           │ false   | true     | '3am UTC-5'
// TimeAbbreviation.TRIM_HOURS_AND_MINUTES │ TimeSeparator.LETTER │ TimePostfix.LOWERCASE_WITH_DOTS │ true    | true     | '3 a.m. UTC-5'
// 
// 
// ```
// The table below shows example outputs using the 24-hour time format and some combinations of optional parameters.
// ```
// 
// `trim` │ `separator`          │ `postfix` │ `space` │ `offset` │ Result
// ───────┼──────────────────────┼───────────┼─────────┼──────────┼──────────────
// N/A    │ TimeSeparator.NONE   │ N/A       │ N/A     │ false    │ '0300'
// N/A    │ TimeSeparator.NONE   │ N/A       │ N/A     │ true     │ '0300R'
// N/A    │ TimeSeparator.COLON  │ N/A       │ N/A     │ false    │ '03:00'
// N/A    │ TimeSeparator.COLON  │ N/A       │ N/A     │ true     │ '03:00 UTC-5'
// N/A    │ TimeSeparator.DOT    │ N/A       │ N/A     │ false    │ '03.00'
// N/A    │ TimeSeparator.DOT    │ N/A       │ N/A     │ true     │ '03.00 UTC-5'
// N/A    │ TimeSeparator.LETTER │ N/A       │ N/A     │ false    │ '03h00'
// N/A    │ TimeSeparator.LETTER │ N/A       │ N/A     │ true     │ '03h00 UTC-5'
// 
// 
// ```
// ___
// @param timestamp  (series int) A UNIX time.
// @param format     (series TimeFormat) A time format.
// @param timezone   (series string) A UTC/GMT offset or IANA time zone identifier.
// @param trim       (series TimeAbbreviation) Optional truncation of the hour and minute portion of the time string.
// @param separator  (series TimeSeparator) Optional time separator.
// @param postfix    (series TimePostfix) Optional format for the AM/PM postfix.
// @param space      (series bool) Optional space between the time and the postfix.
// @param offset     (series bool) Optional UTC offset as a suffix.
// @returns          Time of day string using the selected format.
export formatTime(int timestamp, TimeFormat format, string timezone = syminfo.timezone, TimeAbbreviation trim = TimeAbbreviation.DEFAULT, TimeSeparator separator = TimeSeparator.COLON, TimePostfix postfix = TimePostfix.CAPITALS, bool space = true, bool offset = false) =>
    format == TimeFormat.TWELVE_HOURS ? format12HourTime(timestamp, timezone, trim, separator.tostring(), postfix, space, offset) : format24HourTime(timestamp, timezone, separator.tostring(), offset)

//#endregion



//#region ------------------------------ Script Code ------------------------------

datePrefixInput = input.enum(DatePrefix.DAY_OF_WEEK_ABBREVIATION, "Date format  ", group = "Date & Time Formatting", inline = "1")
dateFormatInput = input.enum(DateFormat.FORMAT_3,                 " ",             group = "Date & Time Formatting", inline = "1")
timeFormatInput = input.enum(TimeFormat.TWENTY_FOUR_HOURS,        "Time format",   group = "Date & Time Formatting", inline = "2")


int currentTime = timenow
string formattedDate = formatDate(currentTime, dateFormatInput, prefix = datePrefixInput)
string formattedTime = formatTime(currentTime, timeFormatInput, postfix = TimePostfix.SMALL_CAPS, offset = true)


var table table = table.new(position.top_right, 2, 3, chart.fg_color)

if barstate.islast
    table.cell(table, 0, 0, text_color = chart.bg_color, text_halign = text.align_left, text = "Default date/time format:    ")
    table.cell(table, 1, 0, text_color = chart.bg_color, text_halign = text.align_left, text = str.format_time(currentTime))
    table.cell(table, 0, 1, text_color = chart.bg_color, text_halign = text.align_left, text = "User-selected date/time format:    ")
    table.cell(table, 1, 1, text_color = chart.bg_color, text_halign = text.align_left, text = formattedDate + "   " + formattedTime)

//#endregion
