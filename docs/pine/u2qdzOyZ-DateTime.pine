//@version=6

// @description Library with exported enums that can be used to request user inputs for date and/or time formats.
// The library provides exported functions to get formatted dates and times from a UNIX timestamp.
library("DateTime")

import n00btraders/Timezone/1 as tz



//#region ------------------------------ Date Format Enums ------------------------------

// @enum  Date formats (without day of week) that match the "Date format" options available in TradingView chart settings.
//        The date formats are displayed as if the "Day of week on labels" option in TradingView settings was toggled OFF.
//        Note: this enum omits the day of week prefix since the titles for enum fields must be constant ("const string"),
//        whereas TradingView settings can dynamically show the day of week depending on whether the "Day of week on labels" option is used.
export enum DateFormat
    FORMAT_1  = "Q3 '97"
    FORMAT_2  = "Q3 1997"
    FORMAT_3  = "29 Sep '97"
    FORMAT_4  = "Sep '97"
    FORMAT_5  = "Sep 29, 1997"
    FORMAT_6  = "Sep 1997"
    FORMAT_7  = "Sep 29"
    FORMAT_8  = "29 Sep"
    FORMAT_9  = "1997-09-29"
    FORMAT_10 = "97-09-29"
    FORMAT_11 = "97/09/29"
    FORMAT_12 = "1997/09/29"
    FORMAT_13 = "29-09-1997"
    FORMAT_14 = "29-09-97"
    FORMAT_15 = "29/09/97"
    FORMAT_16 = "29/09/1997"
    FORMAT_17 = "09/29/97"
    FORMAT_18 = "09/29/1997"


// @enum  Date formats (with abbreviated day of week) that match the "Date format" options available in TradingView chart settings.
//        The date formats are displayed as if the "Day of week on labels" option in TradingView settings was toggled ON.
//        Note: this enum always shows the day of week prefix since the titles for enum fields must be constant ("const string"),
//        whereas TradingView settings can dynamically hide the day of week depending on whether the "Day of week on labels" option is used.
//
//        If using this enum as an input, it is recommended (but not required) to call `formatDate()` with `prefix` = DatePrefix.DAY_OF_WEEK_ABBREVIATION.
export enum DateFormatDayOfWeekAbbr
    FORMAT_1  = "Mon Q3 '97"
    FORMAT_2  = "Mon Q3 1997"
    FORMAT_3  = "Mon 29 Sep '97"
    FORMAT_4  = "Mon Sep '97"
    FORMAT_5  = "Mon Sep 29, 1997"
    FORMAT_6  = "Mon Sep 1997"
    FORMAT_7  = "Mon Sep 29"
    FORMAT_8  = "Mon 29 Sep"
    FORMAT_9  = "Mon 1997-09-29"
    FORMAT_10 = "Mon 97-09-29"
    FORMAT_11 = "Mon 97/09/29"
    FORMAT_12 = "Mon 1997/09/29"
    FORMAT_13 = "Mon 29-09-1997"
    FORMAT_14 = "Mon 29-09-97"
    FORMAT_15 = "Mon 29/09/97"
    FORMAT_16 = "Mon 29/09/1997"
    FORMAT_17 = "Mon 09/29/97"
    FORMAT_18 = "Mon 09/29/1997"


// @enum  Date formats (with full day of week) that match the "Date format" options available in TradingView chart settings.
//        Note: the "Date format" options in TradingView chart settings do not display the full name for the day of week,
//        but this enum is included for completeness’ sake to provide a larger variety of choices.
//
//        If using this enum as an input, it is recommended (but not required) to call `formatDate()` with `prefix` = DatePrefix.DAY_OF_WEEK_FULL_NAME.
export enum DateFormatDayOfWeekFull
    FORMAT_1  = "Monday Q3 '97"
    FORMAT_2  = "Monday Q3 1997"
    FORMAT_3  = "Monday 29 Sep '97"
    FORMAT_4  = "Monday Sep '97"
    FORMAT_5  = "Monday Sep 29, 1997"
    FORMAT_6  = "Monday Sep 1997"
    FORMAT_7  = "Monday Sep 29"
    FORMAT_8  = "Monday 29 Sep"
    FORMAT_9  = "Monday 1997-09-29"
    FORMAT_10 = "Monday 97-09-29"
    FORMAT_11 = "Monday 97/09/29"
    FORMAT_12 = "Monday 1997/09/29"
    FORMAT_13 = "Monday 29-09-1997"
    FORMAT_14 = "Monday 29-09-97"
    FORMAT_15 = "Monday 29/09/97"
    FORMAT_16 = "Monday 29/09/1997"
    FORMAT_17 = "Monday 09/29/97"
    FORMAT_18 = "Monday 09/29/1997"


// @enum  Date formats using some (but not all) of the options from the `DateFormat` enum, plus additional date formats used around the world.
//        The options in this enum will always show both the Month and the Day of Month from the calendar date.
//        Reference: https://en.wikipedia.org/wiki/List_of_date_formats_by_country
export enum CustomDateFormat
    FORMAT_1  = "Sep 29"
    FORMAT_2  = "Sep 29 '97"
    FORMAT_3  = "Sep 29, 1997"
    FORMAT_4  = "September 29"
    FORMAT_5  = "29 Sep"
    FORMAT_6  = "29 Sep '97"
    FORMAT_7  = "29 Sep 1997"
    FORMAT_8  = "29 September"
    FORMAT_9  = "1997 Sep 29"
    FORMAT_10 = "09/29"
    FORMAT_11 = "09/29/97"
    FORMAT_12 = "09/29/1997"
    FORMAT_13 = "09/29 '97"
    FORMAT_14 = "09/29 1997"
    FORMAT_15 = "29/09"
    FORMAT_16 = "29/09/97"
    FORMAT_17 = "29/09/1997"
    FORMAT_18 = "29/09 '97"
    FORMAT_19 = "29/09 1997"
    FORMAT_20 = "29-09-97"
    FORMAT_21 = "29-09-1997"
    FORMAT_22 = "29.09.97"
    FORMAT_23 = "29.09.1997"
    FORMAT_24 = "97/09/29"
    FORMAT_25 = "97-09-29"
    FORMAT_26 = "1997/09/29"
    FORMAT_27 = "1997-09-29"
    FORMAT_28 = "1997.09.29"
    FORMAT_29 = "1997-29-09"
    FORMAT_30 = "1997.29.09"


// @enum                            Formatting options for the day of week that can be added in front of a date string.
// @field NONE                      No prefix.
// @field DAY_OF_WEEK_ABBREVIATION  Abbreviation of the day of week.
// @field DAY_OF_WEEK_FULL_NAME     The day of week's full name.
export enum DatePrefix
    NONE                     = ""
    DAY_OF_WEEK_ABBREVIATION = "Mon"
    DAY_OF_WEEK_FULL_NAME    = "Monday"

//#endregion



//#region ------------------------------ Time Format Enums ------------------------------

// @enum  Time formats that match the "Time format" options available in TradingView chart settings.
export enum TimeFormat
    TWENTY_FOUR_HOURS = "24-hours"
    TWELVE_HOURS      = "12-hours"


// @enum                          Formatting options for various ways a 12-hour time could be truncated.
// @field DEFAULT                 No truncation.
// @field TRIM_HOURS              Removes leading zeroes from the hours portion of the time.
// @field TRIM_MINUTES            Removes the minutes portion of the time if it's 00.
// @field TRIM_HOURS_AND_MINUTES  Removes leading zeroes from the hours portion and also removes the minutes portion if it's 00.
export enum TimeAbbreviation
    DEFAULT                = "03:00 AM"
    TRIM_HOURS             = "3:00 AM"
    TRIM_MINUTES           = "03 AM"
    TRIM_HOURS_AND_MINUTES = "3 AM"


// @enum          Formatting options for possible separators between the hours and minutes portion of a time.
// @field NONE    No separator.
// @field COLON   A ':' separator.
// @field DOT     A '.' separator.
// @field LETTER  A letter 'h' separator.
export enum TimeSeparator
    NONE   = "0300"
    COLON  = "03:00"
    DOT    = "03.00"
    LETTER = "03h00"


// @enum                       Formatting options for the AM/PM postfix of a 12-hour time.
// @field CAPITALS             'AM' or 'PM' (default)
// @field SMALL_CAPS           'ꭺꮇ' or 'ꮲꮇ' (small capital letters)
// @field LOWERCASE            'am' or 'pm'
// @field LOWERCASE_WITH_DOTS  'a.m.' or 'p.m.'
export enum TimePostfix
    CAPITALS            = "AM"
    SMALL_CAPS          = "ꭺꮇ"
    LOWERCASE           = "am"
    LOWERCASE_WITH_DOTS = "a.m."

//#endregion



//#region ------------------------------ Non-Exported tostring() Functions ------------------------------

// @function      Converts a `DateFormat` enum value to a format string.
// @param format  (series DateFormat) The user-selected date format.
// @returns       A format string specifying a date representation.
method tostring(DateFormat format) =>
    switch format
        DateFormat.FORMAT_1  => "Q ''yy"
        DateFormat.FORMAT_2  => "Q yyyy"
        DateFormat.FORMAT_3  => "dd MMM ''yy"
        DateFormat.FORMAT_4  => "MMM ''yy"
        DateFormat.FORMAT_5  => "MMM dd, yyyy"
        DateFormat.FORMAT_6  => "MMM yyyy"
        DateFormat.FORMAT_7  => "MMM dd"
        DateFormat.FORMAT_8  => "dd MMM"
        DateFormat.FORMAT_9  => "yyyy-MM-dd"
        DateFormat.FORMAT_10 => "yy-MM-dd"
        DateFormat.FORMAT_11 => "yy/MM/dd"
        DateFormat.FORMAT_12 => "yyyy/MM/dd"
        DateFormat.FORMAT_13 => "dd-MM-yyyy"
        DateFormat.FORMAT_14 => "dd-MM-yy"
        DateFormat.FORMAT_15 => "dd/MM/yy"
        DateFormat.FORMAT_16 => "dd/MM/yyyy"
        DateFormat.FORMAT_17 => "MM/dd/yy"
        DateFormat.FORMAT_18 => "MM/dd/yyyy"
        => "yyyy-MM-dd"


// @function      Converts a `DateFormatDayOfWeekAbbr` enum value to a format string.
// @param format  (series DateFormatDayOfWeekAbbr) The user-selected date format.
// @returns       A format string specifying a date representation.
