        DateFormatDayOfWeekAbbr.FORMAT_7  => "MMM dd"
        DateFormatDayOfWeekAbbr.FORMAT_8  => "dd MMM"
        DateFormatDayOfWeekAbbr.FORMAT_9  => "yyyy-MM-dd"
        DateFormatDayOfWeekAbbr.FORMAT_10 => "yy-MM-dd"
        DateFormatDayOfWeekAbbr.FORMAT_11 => "yy/MM/dd"
        DateFormatDayOfWeekAbbr.FORMAT_12 => "yyyy/MM/dd"
        DateFormatDayOfWeekAbbr.FORMAT_13 => "dd-MM-yyyy"
        DateFormatDayOfWeekAbbr.FORMAT_14 => "dd-MM-yy"
        DateFormatDayOfWeekAbbr.FORMAT_15 => "dd/MM/yy"
        DateFormatDayOfWeekAbbr.FORMAT_16 => "dd/MM/yyyy"
        DateFormatDayOfWeekAbbr.FORMAT_17 => "MM/dd/yy"
        DateFormatDayOfWeekAbbr.FORMAT_18 => "MM/dd/yyyy"
        => "yyyy-MM-dd"


