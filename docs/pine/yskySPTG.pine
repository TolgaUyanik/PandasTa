// ═══════════════════════════════════════════════════════════════
// 📦 Lib_Visual - Visual Drawing Library
// Pine Script v6 Library
// ═══════════════════════════════════════════════════════════════
// This library includes:
//   • Label creation helpers (entry/exit/TP/SL/SR)
//   • Line management (TP lines, SL lines, Entry lines)
//   • Table (panel) cell formatting
//   • Color helpers
//
// ⚠️ v6 LIMITATIONS:
//   • plot()/plotshape()/plotchar() CANNOT BE USED → Main script
//   • label.new()/line.new()/table.*() ARE USABLE ✓
//   • var table → Created in main scripts, cell filling in library
//
// 📌 USAGE:
//   import YourTradingViewName/Trading_UI_Components/1 as vis
//   vis.drawEntryLabel(true, bar_index, low, 1, close, 100.0, 10)
// ═══════════════════════════════════════════════════════════════

//@version=6
library('Trading_UI_Components', overlay = true)

// ═══════════════════════════════════════════════════════════════
// 📐 USER-DEFINED TYPES
// ═══════════════════════════════════════════════════════════════

// ── Visual Marker Info ──
export type VisualMarker
    string txt            // Label text
    color  bgColor        // Background color
    color  txtColor       // Text color
    string sz             // Size ('tiny', 'small', 'normal')

// ── Line Group (all lines for one position) ──
export type LineGroup
    line entryLine        // Entry price line
    line avgLine          // Average price line
    line tp1Line          // TP1 line
    line tp2Line          // TP2 line
    line tp3Line          // TP3 line
    line slLine           // SL line
    line liqLine          // Liquidation line
    line tsLine           // Trailing Stop line

// ── Panel Color Theme ──
export type PanelTheme
    color bgColor         // Panel background
    color borderColor     // Border color
    color textPrimary     // Main text color
    color textGreen       // Positive / Active
    color textRed         // Negative / Danger
    color textYellow      // Warning
    color textBlue        // Info
    color textOrange      // Secondary warning
    color textCyan        // Emphasis

// ═══════════════════════════════════════════════════════════════
// 🏷️ LABEL CREATION FUNCTIONS
// ═══════════════════════════════════════════════════════════════

// Create Entry Label (Long: below bar, Short: above bar)
// @param isLong Is Long
// @param barIdx Bar index
// @param priceY Y axis price
// @param txt Label text
// @param bgCol Background color
// @param txtCol Text color
// @param sz Size string ('tiny', 'small', 'normal')
// @returns Created label
export drawEntryLabel(bool isLong, int barIdx, float priceY, string txt, color bgCol, color txtCol, string sz) =>
    string szVal = sz == 'small' ? size.small : sz == 'normal' ? size.normal : size.tiny
    if isLong
        label.new(barIdx, priceY, txt, style = label.style_label_up, color = bgCol, textcolor = txtCol, size = szVal, yloc = yloc.belowbar)
    else
        label.new(barIdx, priceY, txt, style = label.style_label_down, color = bgCol, textcolor = txtCol, size = szVal, yloc = yloc.abovebar)

// Create TP Exit Label
// @param isLong Is Long
// @param barIdx Bar index
// @param price TP price
// @param tpNum TP number (1, 2, 3)
// @param pnlStr PnL formatted string
// @param isDCA Is DCA TP
// @param col TP color
// @returns Created label
export drawTPLabel(bool isLong, int barIdx, float price, int tpNum, string pnlStr, bool isDCA, color col) =>
    string prefix = isDCA ? 'DCA-' : ''
    string txt = prefix + 'TP' + str.tostring(tpNum) + '\n' + pnlStr
    if isLong
        label.new(barIdx, price, txt, style = label.style_label_down, color = col, textcolor = color.white, size = size.tiny, yloc = yloc.abovebar)
    else
        label.new(barIdx, price, txt, style = label.style_label_up, color = col, textcolor = color.white, size = size.tiny, yloc = yloc.belowbar)

// Create SL Exit Label
// @returns Created label
export drawSLLabel(bool isLong, int barIdx, float price, string pnlStr, bool isTrailing, color col) =>
    string slType = isTrailing ? 'TS' : 'SL'
    string txt = slType + '\n' + pnlStr
    label.new(barIdx, price, txt, style = isLong ? label.style_label_down : label.style_label_up, color = col, textcolor = color.white, size = size.tiny, yloc = isLong ? yloc.belowbar : yloc.abovebar)

// Create Force Exit Label
// @returns Created label
export drawForceExitLabel(bool isLong, int barIdx, float price, string pnlStr, color col) =>
    string txt = 'FE\n' + pnlStr
    label.new(barIdx, price, txt, style = isLong ? label.style_label_down : label.style_label_up, color = col, textcolor = color.white, size = size.tiny, yloc = isLong ? yloc.belowbar : yloc.abovebar)

// Create Swing Reversal Label
// @returns Created label
export drawSwingLabel(bool fromLong, int barIdx, float price, string pnlStr, color col) =>
    string dir = fromLong ? 'L→S' : 'S→L'
    string txt = '🔄' + dir + '\n' + pnlStr
    label.new(barIdx, price, txt, style = label.style_diamond, color = col, textcolor = color.white, size = size.tiny)

// Create Liquidation Label
export drawLiqLabel(bool isLong, int barIdx, float liqPrice, color col) =>
    string dir = isLong ? 'L-LIQ' : 'S-LIQ'
    label.new(barIdx, liqPrice, '💀' + dir, style = label.style_label_center, color = col, textcolor = color.white, size = size.small)
// Create MP (Min Position) Full-Close Label — purple
// @param isLong Direction
// @param barIdx Bar index for label
// @param priceY Y-axis price (high for Long, low for Short)
// @param totalProfit Accumulated trade PnL
// @returns Created label
export drawMPLabel(bool isLong, int barIdx, float priceY, float totalProfit) =>
    string mpSign = totalProfit >= 0 ? '+$' : '-$'
    string txt = 'MP\n' + mpSign + str.tostring(math.abs(totalProfit), '#.##')
    if isLong
        label.new(barIdx, priceY, txt, style = label.style_label_down, color = #9400D3, textcolor = color.white, size = size.small, yloc = yloc.price)
    else
        label.new(barIdx, priceY, txt, style = label.style_label_up, color = #9400D3, textcolor = color.white, size = size.small, yloc = yloc.price)
// ═══════════════════════════════════════════════════════════════
// � LABEL PERSISTENCE HELPER (Latch-based create/delete)
// ═══════════════════════════════════════════════════════════════

// Persist or clean up a label based on a latch flag.
// When latch is ON: deletes any same-bar duplicate, then creates a new label.
// When latch is OFF and cleanup=true: deletes same-bar label and returns na.
// When latch is OFF and cleanup=false: returns existing label unchanged.
// @param lbl Current label reference (var label)
// @param latch Is the trigger active
// @param cleanup Delete label when latch goes off (Webhook=true, swpspace=false)
// @param barIdx Bar index
// @param price Y axis price
// @param txt Label text
// @param isUp Label style up (true) or down (false)
// @param col Background color
// @param txtCol Text color
// @param sz Size string ('small', 'normal', 'tiny')
// @param yloc_mode Yloc mode: 'price', 'abovebar', 'belowbar', 'default'
// @returns Updated label reference
export persistLabel(label lbl, bool latch, bool cleanup, int barIdx, float price, string txt, bool isUp, color col, color txtCol, string sz, string yloc_mode) =>
    string szVal = sz == 'normal' ? size.normal : sz == 'tiny' ? size.tiny : size.small
    string styleVal = isUp ? label.style_label_up : label.style_label_down
    string ylocVal = yloc_mode == 'belowbar' ? yloc.belowbar : yloc_mode == 'abovebar' ? yloc.abovebar : yloc_mode == 'price' ? yloc.price : yloc.price
    if latch
        if not na(lbl) and label.get_x(lbl) == barIdx
            // Same bar: UPDATE in place instead of delete+recreate (prevents flickering)
            label.set_text(lbl, txt)
            label.set_color(lbl, col)
            label.set_textcolor(lbl, txtCol)
            label.set_size(lbl, szVal)
            label.set_style(lbl, styleVal)
            label.set_yloc(lbl, ylocVal)
            label.set_y(lbl, price)
            lbl
        else
            // Different bar or no label: delete old if exists, create new
            if not na(lbl)
                label.delete(lbl)
            label.new(barIdx, price, txt, style = styleVal, color = col, textcolor = txtCol, size = szVal, yloc = ylocVal)
    else
        if cleanup
            if not na(lbl) and label.get_x(lbl) == barIdx
                label.delete(lbl)
            na
        else
            lbl

// Persist label with blocked/normal variant (for Force Exit labels)
// @param lbl Current label reference
// @param latch Is trigger active
// @param cleanup Delete on latch off
// @param blocked Is the exit blocked
// @param showBlockedLbl Show full label when blocked
// @param blockedSz Size for blocked dot ('small' or 'tiny')
// @param barIdx Bar index
// @param price Y price
// @param txt Label text
// @param isUp true=style_label_up, false=style_label_down
// @param col Background color
// @returns Updated label reference
export persistFELabel(label lbl, bool latch, bool cleanup, bool blocked, bool showBlockedLbl, int barIdx, float price, string txt, bool isUp, color col) =>
    string normalStyle = isUp ? label.style_label_up : label.style_label_down
    if latch
        if not na(lbl) and label.get_x(lbl) == barIdx
            // Same bar: UPDATE in place instead of delete+recreate (prevents flickering)
            if blocked
                string bStyle = showBlockedLbl ? normalStyle : label.style_circle
                string bSz = showBlockedLbl ? size.small : size.tiny
                label.set_text(lbl, txt)
                label.set_color(lbl, col)
                label.set_textcolor(lbl, color.white)
                label.set_size(lbl, bSz)
                label.set_style(lbl, bStyle)
                label.set_yloc(lbl, yloc.price)
                label.set_y(lbl, price)
            else
                label.set_text(lbl, txt)
                label.set_color(lbl, col)
                label.set_textcolor(lbl, color.white)
                label.set_size(lbl, size.small)
                label.set_style(lbl, normalStyle)
                label.set_y(lbl, price)
            lbl
        else
            // Different bar or no label: delete old if exists, create new
            if not na(lbl)
                label.delete(lbl)
            if blocked
                string bStyle = showBlockedLbl ? normalStyle : label.style_circle
                string bSz = showBlockedLbl ? size.small : size.tiny
                label.new(barIdx, price, txt, style = bStyle, color = col, textcolor = color.white, size = bSz, yloc = yloc.price)
            else
                label.new(barIdx, price, txt, style = normalStyle, color = col, textcolor = color.white, size = size.small)
    else
        if cleanup
            if not na(lbl) and label.get_x(lbl) == barIdx
                label.delete(lbl)
            na
        else
            lbl

// ═══════════════════════════════════════════════════════════════
// �📏 LINE MANAGEMENT FUNCTIONS
// ═══════════════════════════════════════════════════════════════

// Update or create Horizontal Line (for TP/SL/Entry lines)
// @param ln Current line (if na, creates new)
// @param barIdx Start bar index
// @param price Price level
// @param col Line color
// @param style Line style
// @param width Line width
// @returns Updated/Created line
export updateHLine(line ln, int barIdx, float price, color col, string style, int width) =>
    string lineStyle = style == 'dashed' ? line.style_dashed : style == 'dotted' ? line.style_dotted : line.style_solid
    if not na(ln)
        line.set_x1(ln, barIdx)
        line.set_x2(ln, bar_index + 20)
        line.set_y1(ln, price)
        line.set_y2(ln, price)
        line.set_color(ln, col)
        ln
    else
        line.new(barIdx, price, bar_index + 20, price, color = col, style = lineStyle, width = width, extend = extend.right)

// Draw a horizontal line (delete-then-create pattern, bar_index-20 to bar_index+10)
// @param ln Current line reference (will be deleted if not na)
// @param price Price level
// @param col Line color
// @param w Line width (default 1)
// @param sty Style string: 'solid', 'dashed', 'dotted'
// @returns New line
export drawHLine(line ln, float price, color col, int w, string sty) =>
    if not na(ln)
        line.delete(ln)
    string lineStyle = sty == 'dashed' ? line.style_dashed : sty == 'dotted' ? line.style_dotted : line.style_solid
    line.new(bar_index - 20, price, bar_index + 10, price, color = col, style = lineStyle, width = w)

// Delete multiple lines at once (up to 9)
// @param l1 Line 1 to delete
// @param l2 Line 2 to delete
// @param l3 Line 3 to delete
// @param l4 Line 4 to delete
// @param l5 Line 5 to delete
// @param l6 Line 6 to delete
// @param l7 Line 7 to delete
// @param l8 Line 8 to delete
// @param l9 Line 9 to delete
export deleteLines9(line l1, line l2, line l3, line l4, line l5, line l6, line l7, line l8, line l9) =>
    if not na(l1)
        line.delete(l1)
    if not na(l2)
        line.delete(l2)
    if not na(l3)
        line.delete(l3)
    if not na(l4)
        line.delete(l4)
    if not na(l5)
        line.delete(l5)
    if not na(l6)
        line.delete(l6)
    if not na(l7)
        line.delete(l7)
    if not na(l8)
        line.delete(l8)
    if not na(l9)
        line.delete(l9)

// Clear (delete) line
// @param ln Line to delete
export deleteLine(line ln) =>
    if not na(ln)
        line.delete(ln)

// Clear all position lines
// @param grp Line group
export deleteAllLines(LineGroup grp) =>
    deleteLine(grp.entryLine)
    deleteLine(grp.avgLine)
    deleteLine(grp.tp1Line)
    deleteLine(grp.tp2Line)
    deleteLine(grp.tp3Line)
    deleteLine(grp.slLine)
    deleteLine(grp.liqLine)
    deleteLine(grp.tsLine)

// Update TP lines
// @param grp Current line group
// @param barIdx Start bar index
// @param tp1 TP1 price
// @param tp2 TP2 price (na if not drawn)
// @param tp3 TP3 price (na if not drawn)
// @param colTP TP color
// @returns Updated line group
export updateTPLines(LineGroup grp, int barIdx, float tp1, float tp2, float tp3, color colTP) =>
    grp.tp1Line := updateHLine(grp.tp1Line, barIdx, tp1, colTP, 'dashed', 1)
    if not na(tp2)
        grp.tp2Line := updateHLine(grp.tp2Line, barIdx, tp2, colTP, 'dashed', 1)
    if not na(tp3)
        grp.tp3Line := updateHLine(grp.tp3Line, barIdx, tp3, colTP, 'dashed', 1)
    grp

// Update SL line
// @returns Updated line group
export updateSLLine(LineGroup grp, int barIdx, float slPrice, color colSL) =>
    grp.slLine := updateHLine(grp.slLine, barIdx, slPrice, colSL, 'solid', 2)
    grp

// Update Average Price line
// @returns Updated line group
export updateAvgLine(LineGroup grp, int barIdx, float avgPrice, color colAvg) =>
    grp.avgLine := updateHLine(grp.avgLine, barIdx, avgPrice, colAvg, 'solid', 1)
    grp

// ═══════════════════════════════════════════════════════════════
// 📊 PANEL (TABLE) HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════

// Panel cell creation wrapper
// @param tbl Table reference
// @param row Row number
// @param txt Content
// @param txtCol Text color
// @param bgCol Background color (optional)
// @param tipTxt Tooltip (optional)
export panelCell(table tbl, int row, string txt, color txtCol, color bgCol, string tipTxt) =>
    table.cell(tbl, 0, row, txt, text_color = txtCol, bgcolor = bgCol, tooltip = tipTxt, text_size = size.small)

// Panel cell (simple - no tooltip)
export panelCellSimple(table tbl, int row, string txt, color txtCol, color bgCol) =>
    table.cell(tbl, 0, row, txt, text_color = txtCol, bgcolor = bgCol, text_size = size.small)

// Determine PnL color
// @param pnl PnL value
// @param posColor Positive color
// @param negColor Negative color
// @returns Appropriate color
export pnlColor(float pnl, color posColor, color negColor) =>
    pnl >= 0 ? posColor : negColor

// Create Status String
// @param dateError Is there a date error
// @param activeSession Is session active
// @param sessionStarted Has session started
// @returns [statusText, statusColor]
export sessionStatus(bool dateError, bool activeSession, bool sessionStarted) =>
    if dateError
        ['DATE ERROR!', color.red]
    else if activeSession
        ['ACTIVE', #00ff00]
    else if sessionStarted
        ['STOPPED', color.orange]
    else
        ['NOT STARTED', color.gray]

// ═══════════════════════════════════════════════════════════════
// 🖌️ PIVOT LINE VISUALIZATION
// ═══════════════════════════════════════════════════════════════

// Update Pivot Lines
// @param pp Pivot Point
// @param r1 Resistance 1
// @param r2 Resistance 2
// @param r3 Resistance 3
// @param s1 Support 1
// @param s2 Support 2
// @param s3 Support 3
// @param showPivots Show/Hide
// @param colPP Pivot color
// @param colR Resistance color
// @param colS Support color
// @returns void (lines updated)
export drawPivotLines(float pp, float r1, float r2, float r3, float s1, float s2, float s3, bool showPivots, color colPP, color colR, color colS) =>
    if showPivots and not na(pp)
        line.new(bar_index - 1, pp, bar_index + 5, pp, color = colPP, style = line.style_dotted, width = 1)
        if not na(r1)
            line.new(bar_index - 1, r1, bar_index + 5, r1, color = colR, style = line.style_dotted, width = 1)
        if not na(r2)
            line.new(bar_index - 1, r2, bar_index + 5, r2, color = colR, style = line.style_dotted, width = 1)
        if not na(r3)
            line.new(bar_index - 1, r3, bar_index + 5, r3, color = colR, style = line.style_dotted, width = 1)
        if not na(s1)
            line.new(bar_index - 1, s1, bar_index + 5, s1, color = colS, style = line.style_dotted, width = 1)
        if not na(s2)
            line.new(bar_index - 1, s2, bar_index + 5, s2, color = colS, style = line.style_dotted, width = 1)
        if not na(s3)
            line.new(bar_index - 1, s3, bar_index + 5, s3, color = colS, style = line.style_dotted, width = 1)

// ═══════════════════════════════════════════════════════════════
// 🎨 COLOR HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════

// Select color based on TP number
// @param tpNum TP number (1, 2, 3)
// @param col1 TP1 color
// @param col2 TP2 color
// @param col3 TP3 color
// @returns Selected color
export tpColor(int tpNum, color col1, color col2, color col3) =>
    tpNum == 1 ? col1 : tpNum == 2 ? col2 : col3

// Set transparency
// @param col Color
// @param transp Transparency (0-100)
// @returns Faded color
export fade(color col, int transp) =>
    color.new(col, transp)

// ═══════════════════════════════════════════════════════════════
// 🔄 LABEL PERSISTENCE HELPER
// ═══════════════════════════════════════════════════════════════

// Calculate offset to prevent label stacking on the same bar
// @param stackCount Current stack count
// @param baseOffset Base offset value (h-l or mintick*50)
// @returns Y axis offset
export stackY(int stackCount, float baseOffset) =>
    baseOffset * stackCount * 0.3

// Min tick based safe offset
// @returns Minimum safe offset value
export safeOffset() =>
    syminfo.mintick * 50
