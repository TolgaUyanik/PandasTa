//@version=5
// @description This library calculates a Dynamic Relative Strength Index (RSI) that adjusts its sensitivity based on market volatility.
library("DynamicRSI", overlay=false)

// @function drsi
// @description Calculates a Dynamic RSI by weighting short-term and long-term RSI values based on market volatility.
// @param src (float) The source data to calculate the RSI (e.g., close price).
// @param minLength (simple int) The period for the short-term RSI, which makes the RSI more reactive to price changes.
// @param maxLength (simple int) The period for the long-term RSI, providing a smoother RSI less sensitive to short-term fluctuations.
// @param volatilityPeriod (simple int) The period for calculating the Average True Range (ATR) to measure market volatility, used to adjust the weighting between short and long RSI.
// @returns (float) Returns the Dynamic RSI value.
export drsi(float src, int minLength, int maxLength, int volatilityPeriod) =>
    // 변동성 계산 (ATR 사용)
    atr = ta.atr(volatilityPeriod)

    // 변동성에 따른 가중치 계산
    normalizedAtr = (atr - ta.lowest(atr, volatilityPeriod)) / (ta.highest(atr, volatilityPeriod) - ta.lowest(atr, volatilityPeriod))
    weight = normalizedAtr

    // 두 개의 RSI 계산 (짧은 기간과 긴 기간)
    shortRsi = ta.rsi(src, minLength)
    longRsi = ta.rsi(src, maxLength)

    // 가중치를 사용한 Dynamic RSI 계산
    dynamicRsi = shortRsi * weight + longRsi * (1 - weight)
    dynamicRsi

// 사용자 입력
minLength = input.int(7, title="Short RSI", minval=1, tooltip="높은 감도를 위한 Short RSI의 길이")
maxLength = input.int(21, title="Long RSI", minval=1, tooltip="낮은 감도를 위한 Long RSI의 길이")
volatilityPeriod = input.int(14, title="Volatility", minval=1, tooltip="ATR 계산을 위한 길이로, 단기 RSI와 장기 RSI 사이의 가중치를 조정하는 데 사용됩니다.")

// dRSI 계산 및 출력
dynamicRsi = drsi(close, minLength, maxLength, volatilityPeriod)
plot(dynamicRsi, title="Dynamic RSI", color=color.blue)

// 과매수 및 과매도 라인 출력
hline(70, "Overbought", color=color.new(color.gray, 30))
hline(30, "Oversold", color=color.new(color.gray, 30))
