//@version=6

indicator("Big Trade % Heatmap", overlay=true)

// === Inputs ===
xCandles = input.int(20, title="Lookback Window (X Candles)", minval=1)
interval = input.int(5, title="Refresh Interval (Every X Candles)", minval=1)
thresholdUSD = input.float(10000, title="Big Trade Threshold ($)", step=100)

// === Calculation: Trade Size Per Candle ===
tradeUSD = volume * close
isBigTrade = tradeUSD > thresholdUSD ? 1 : 0

// === Sum Big Trades Over Last X Candles ===
bigTradeCount = 0.0
for i = 0 to xCandles - 1
    bigTradeCount := bigTradeCount + (tradeUSD[i] > thresholdUSD ? 1 : 0)

percentBig = (bigTradeCount / xCandles) * 100

// === Display Every X Candles Only ===
plotNow = (bar_index % interval == 0)

// === Plot Shape Above Candle with label as separate text ===
plotshape(plotNow, location=location.abovebar, style=shape.triangledown, size=size.small, color=color.new(color.blue, 0))

// Show label text separately
var label lbl = na
if plotNow
    lbl := label.new(bar_index, high, str.tostring(percentBig, "#.##") + "% > $" + str.tostring(thresholdUSD),style=label.style_label_down, textcolor=color.white, size=size.normal, color=color.new(color.blue, 0))
    label.delete(lbl[1])

// === Heatmap Background Optional ===
bgcolor(percentBig > 50 ? color.new(color.green, 85) :
       percentBig > 20 ? color.new(color.orange, 85) : na, title="Heatmap Background")

// === Alert Conditions ===
alertcondition(percentBig > 50, title="High Big Trade %", message=">50% of last X candles were big trades.")
