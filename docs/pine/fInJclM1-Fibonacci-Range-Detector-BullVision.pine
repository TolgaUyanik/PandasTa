//@@@@@@@@@@@@@@@@@@@@@@@@@@@%+=======%@@@@@@@@@@@@+@@@@@@@@@@@%@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@%+=====*@@@@@@@%@@@%+==#@@@@@@#%@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@+====#@@@@@@@=@@@%+==#@@@@@===#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#===#@@@@@%*=*%@%+==#@@@@@==*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@%*=#@@@@@#+==%@%+==#@@@@+=#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@%@@@@@@#+==%@%+==#@@@+=%@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#+==%@@@=@@@@**@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#+==%@@@#@@@#%@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@%=%@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@+@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
//@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

//@version=5

//  ╔═══════════════════════════════════════════════════════════════════════════════╗
//  ║        ▌ Fibonacci Range Mapper                                               ║
//  ║                                                                               ║
//  ║This indicator dynamically maps Fibonacci levels between a swing low and a     ║
//  ║newly confirmed highest high. Once a range is detected, it plots key levels    ║
//  ║(0%, 25%, 50%, 75%, 100%) and optional extensions (127.2%, 161.8%).            ║
//  ║                                                                               ║
//  ║In Auto mode, it uses a ZigZag-based logic (ATR or % reversal) to confirm      ║
//  ║major swing points and builds a range after confirmation delay.                ║
//  ║                                                                               ║
//  ║In Manual mode, users define their own low/high levels to generate ranges.     ║
//  ║                                                                               ║
//  ║Ranges are classified into zones:                                              ║ 
//  ║- 0–25%: Discount (accumulation area)                                          ║
//  ║- 75–100%: Premium (distribution area)                                         ║
//  ║                                                                               ║
//  ║A floating info table provides live data: range size, zone, position,          ║
//  ║distances to extremes, and range status (Pending or Confirmed).                ║
//  ║                                                                               ║
//  ║Historical ranges are saved and plotted, providing visual memory of key        ║
//  ║market structures.                                                             ║ 
//  ║                                                                               ║
//  ╚═══════════════════════════════════════════════════════════════════════════════╝

indicator("Fibonacci Range Detector ║ BullVision", overlay=true, max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// Mode Selection
mode = input.string("Auto", "📊 Selection Mode", options=["Auto", "Manual"], group="━━━━━ MODE SELECTION ━━━━━")

// Manual Mode Inputs
manual_high_price = mode == "Manual" ? input.price(0, "📍 High Level", confirm=true, group="━━━━━ MANUAL INPUTS ━━━━━") : 0
manual_low_price = mode == "Manual" ? input.price(0, "📍 Low Level", confirm=true, group="━━━━━ MANUAL INPUTS ━━━━━") : 0

// Auto Mode Settings
auto_method = mode == "Auto" ? input.string("ATR ZigZag", "🎯 Detection Method", options=["ATR ZigZag", "% ZigZag"], group="━━━━━ AUTO SETTINGS ━━━━━") : "ATR ZigZag"
atr_length = mode == "Auto" ? input.int(30, "📏 ATR Length", minval=1, maxval=100, group="━━━━━ AUTO SETTINGS ━━━━━") : 14
atr_multiplier = mode == "Auto" ? input.float(4, "✖️ ATR Multiplier", minval=0.5, maxval=10, step=0.1, group="━━━━━ AUTO SETTINGS ━━━━━") : 2.5
percent_reversal = mode == "Auto" ? input.float(3.0, "📈 Reversal %", minval=0.5, maxval=10, step=0.1, group="━━━━━ AUTO SETTINGS ━━━━━") : 3.0
confirmation_bars = mode == "Auto" ? input.int(90, "⏳ Confirmation Bars", minval=0, maxval=200, group="━━━━━ AUTO SETTINGS ━━━━━") : 10

// Visual Settings
show_labels = input.bool(false, "🏷️ Show Price Labels", group="━━━━━ VISUAL SETTINGS ━━━━━")
show_extensions = input.bool(true, "📐 Show Extensions", group="━━━━━ VISUAL SETTINGS ━━━━━")
show_table = input.bool(true, "📋 Show Info Table", group="━━━━━ VISUAL SETTINGS ━━━━━")
max_historical_ranges = input.int(5, "📚 Historical Ranges", minval=0, maxval=20, group="━━━━━ VISUAL SETTINGS ━━━━━")

// Colors
color_0_25 = input.color(color.new(#006400, 70), "🟢 Discount Zone (0-25%)", group="━━━━━ COLOR SCHEME ━━━━━")
color_75_100 = input.color(color.new(#8B0000, 70), "🔴 Premium Zone (75-100%)", group="━━━━━ COLOR SCHEME ━━━━━")

// Table Settings
table_position = input.string("Top Right", "📍 Table Position", 
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], 
     group="━━━━━ TABLE SETTINGS ━━━━━")
table_text_color = input.color(color.white, "✏️ Text Color", group="━━━━━ TABLE SETTINGS ━━━━━")
table_bg_color = input.color(color.new(color.black, 30), "🎨 Background Color", group="━━━━━ TABLE SETTINGS ━━━━━")

// ═══════════════════════════════════════════════════════════════════════════════
// VARIABLES
// ═══════════════════════════════════════════════════════════════════════════════

// Current range variables
var float highest_high = na
var int hh_bar_index = na
var float swing_low = na
var int sl_bar_index = na
var bool range_active = false
var bool range_confirmed = false
var bool labels_drawn = false

// Fixed values for the active range (captured at detection time)
var float active_range_high = na
var float active_range_low = na

// ZigZag variables for Auto mode
var int zigzag_direction = 0    // 1 = up leg, -1 = down leg
var float current_high = na
var float current_low = na
var int current_high_bar = na
var int current_low_bar = na
var float confirmed_high = na
var float confirmed_low = na
var int confirmed_high_bar = na
var int confirmed_low_bar = na

// Historical ranges storage
var array<float> hist_highs = array.new<float>()
var array<int> hist_high_bars = array.new<int>()
var array<float> hist_lows = array.new<float>()
var array<int> hist_low_bars = array.new<int>()
var array<int> hist_end_bars = array.new<int>()

// Line variables for current range
var line line_0 = na
var line line_25 = na
var line line_50 = na
var line line_75 = na
var line line_100 = na
var line line_1272 = na
var line line_1618 = na

// Linefill variables for current range
var linefill curr_fill_0_25 = na
var linefill curr_fill_75_100 = na

// Arrays to store historical range lines and fills
var array<line> hist_lines = array.new<line>()
var array<linefill> hist_fills = array.new<linefill>()

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

if mode == "Manual"
    // ───────────────────────────────────────────────────────────────────────────
    // MANUAL MODE
    // ───────────────────────────────────────────────────────────────────────────
    if manual_high_price > 0 and manual_low_price > 0 and manual_high_price > manual_low_price
        highest_high := manual_high_price
        swing_low := manual_low_price
        
        // Capture values for manual mode
        active_range_high := manual_high_price
        active_range_low := manual_low_price
        
        // Set safe bar indices
        if na(hh_bar_index) or na(sl_bar_index)
            hh_bar_index := bar_index - 10
            sl_bar_index := bar_index - 20
            
        range_active := true
        range_confirmed := true  // Manual ranges are always confirmed

else
    // ───────────────────────────────────────────────────────────────────────────
    // AUTO MODE - ZigZag Detection
    // ───────────────────────────────────────────────────────────────────────────
    
    // Calculate reversal threshold
    float reversal_threshold = auto_method == "ATR ZigZag" ? 
                              ta.atr(atr_length) * atr_multiplier : 
                              close * percent_reversal * 0.01
    reversal_threshold := math.max(reversal_threshold, syminfo.mintick * 5)
    
    // Initialize on first bar
    if barstate.isfirst
        zigzag_direction := 0
        current_high := high
        current_low := low
        current_high_bar := bar_index
        current_low_bar := bar_index
    
    // Update extremes and confirm swings
    if zigzag_direction >= 0
        // Up leg: extend current high
        if na(current_high) or high > current_high
            current_high := high
            current_high_bar := bar_index
        
        // Check for reversal down
        if not na(current_high) and current_high - low >= reversal_threshold
            confirmed_high := current_high
            confirmed_high_bar := current_high_bar
            zigzag_direction := -1
            current_low := low
            current_low_bar := bar_index
    else
        // Down leg: extend current low
        if na(current_low) or low < current_low
            current_low := low
            current_low_bar := bar_index
        
        // Check for reversal up
        if not na(current_low) and high - current_low >= reversal_threshold
            confirmed_low := current_low
            confirmed_low_bar := current_low_bar
            zigzag_direction := 1
            current_high := high
            current_high_bar := bar_index
    
    // Build range when new HH is confirmed
    if not na(confirmed_high) and (na(highest_high) or confirmed_high > highest_high)
        // Save previous range if it was active
        if range_active and range_confirmed and max_historical_ranges > 0
            array.push(hist_highs, active_range_high)
            array.push(hist_high_bars, hh_bar_index)
            array.push(hist_lows, active_range_low)
            array.push(hist_low_bars, sl_bar_index)
            array.push(hist_end_bars, bar_index)
            
            // Limit historical ranges
            while array.size(hist_highs) > max_historical_ranges
                array.shift(hist_highs)
                array.shift(hist_high_bars)
                array.shift(hist_lows)
                array.shift(hist_low_bars)
                array.shift(hist_end_bars)
        
        highest_high := confirmed_high
        hh_bar_index := confirmed_high_bar
        
        if not na(confirmed_low) and confirmed_low_bar < hh_bar_index
            swing_low := confirmed_low
            sl_bar_index := confirmed_low_bar
            
            // Capture the values at detection time
            active_range_high := confirmed_high
            active_range_low := confirmed_low
            
            range_active := true
            range_confirmed := false  // Wait for confirmation
            labels_drawn := false
            // Delete current lines and fills
            line.delete(line_0)
            line.delete(line_25)
            line.delete(line_50)
            line.delete(line_75)
            line.delete(line_100)
            line.delete(line_1272)
            line.delete(line_1618)
            linefill.delete(curr_fill_0_25)
            linefill.delete(curr_fill_75_100)
            line_0 := na
            line_25 := na
            line_50 := na
            line_75 := na
            line_100 := na
            line_1272 := na
            line_1618 := na
            curr_fill_0_25 := na
            curr_fill_75_100 := na
    
    // Confirm range after X bars
    if range_active and not range_confirmed and not na(highest_high)
        bars_since_high = bar_index - hh_bar_index
        if bars_since_high >= confirmation_bars
            range_confirmed := true
    
    // Check for range breaks (only for confirmed ranges)
    if range_active and range_confirmed and not na(highest_high) and not na(swing_low)
        break_tolerance = reversal_threshold * 0.2
        
        // Break above high
        if high > highest_high + break_tolerance
            // Save to history
            if max_historical_ranges > 0
                array.push(hist_highs, active_range_high)
                array.push(hist_high_bars, hh_bar_index)
                array.push(hist_lows, active_range_low)
                array.push(hist_low_bars, sl_bar_index)
                array.push(hist_end_bars, bar_index)
                
                // Limit historical ranges
                while array.size(hist_highs) > max_historical_ranges
                    array.shift(hist_highs)
                    array.shift(hist_high_bars)
                    array.shift(hist_lows)
                    array.shift(hist_low_bars)
                    array.shift(hist_end_bars)
            
            // Reset current range
            range_active := false
            range_confirmed := false
            highest_high := na
            swing_low := na
            active_range_high := na
            active_range_low := na
            hh_bar_index := na
            sl_bar_index := na
            labels_drawn := false
            // Delete current lines and fills
            line.delete(line_0)
            line.delete(line_25)
            line.delete(line_50)
            line.delete(line_75)
            line.delete(line_100)
            line.delete(line_1272)
            line.delete(line_1618)
            linefill.delete(curr_fill_0_25)
            linefill.delete(curr_fill_75_100)
            line_0 := na
            line_25 := na
            line_50 := na
            line_75 := na
            line_100 := na
            line_1272 := na
            line_1618 := na
            curr_fill_0_25 := na
            curr_fill_75_100 := na
            active_range_high := na      // <— AJOUT
            active_range_low  := na      // <— AJOUT
        
        // Break below low
        else if low < swing_low - break_tolerance
            // Save to history
            if max_historical_ranges > 0
                array.push(hist_highs, highest_high)
                array.push(hist_high_bars, hh_bar_index)
                array.push(hist_lows, swing_low)
                array.push(hist_low_bars, sl_bar_index)
                array.push(hist_end_bars, bar_index)
                
                // Limit historical ranges
                while array.size(hist_highs) > max_historical_ranges
                    array.shift(hist_highs)
                    array.shift(hist_high_bars)
                    array.shift(hist_lows)
                    array.shift(hist_low_bars)
                    array.shift(hist_end_bars)
            
            // Reset current range
            range_active := false
            range_confirmed := false
            highest_high := na
            swing_low := na
            hh_bar_index := na
            sl_bar_index := na
            labels_drawn := false
            // Delete current lines and fills
            line.delete(line_0)
            line.delete(line_25)
            line.delete(line_50)
            line.delete(line_75)
            line.delete(line_100)
            line.delete(line_1272)
            line.delete(line_1618)
            linefill.delete(curr_fill_0_25)
            linefill.delete(curr_fill_75_100)
            line_0 := na
            line_25 := na
            line_50 := na
            line_75 := na
            line_100 := na
            line_1272 := na
            line_1618 := na
            curr_fill_0_25 := na
            curr_fill_75_100 := na

// ═══════════════════════════════════════════════════════════════════════════════
// DRAW HISTORICAL RANGES - Only on the last bar to avoid duplicates
// ═══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // Delete all previous historical lines and fills before redrawing
    if array.size(hist_lines) > 0
        for i = 0 to array.size(hist_lines) - 1
            line.delete(array.get(hist_lines, i))
        array.clear(hist_lines)
    
    if array.size(hist_fills) > 0
        for i = 0 to array.size(hist_fills) - 1
            linefill.delete(array.get(hist_fills, i))
        array.clear(hist_fills)

    // Draw historical ranges
    if max_historical_ranges > 0 and array.size(hist_highs) > 0
        for i = 0 to array.size(hist_highs) - 1
            h_high = array.get(hist_highs, i)
            h_high_bar = array.get(hist_high_bars, i)
            h_low = array.get(hist_lows, i)
            h_low_bar = array.get(hist_low_bars, i)
            h_end_bar = array.get(hist_end_bars, i)
            
            // Avoid overlap with current range
            draw_end = range_active ? math.min(h_end_bar, sl_bar_index - 1) : h_end_bar
            
            // Check bar distance limit
            if (bar_index - h_low_bar) < 5000 and h_low_bar < draw_end
                // Calculate historical Fibonacci levels
                h_fib_0 = h_low
                h_fib_25 = h_low + (h_high - h_low) * 0.25
                h_fib_50 = h_low + (h_high - h_low) * 0.50
                h_fib_75 = h_low + (h_high - h_low) * 0.75
                h_fib_100 = h_high
                
                // Historical range colors (slightly transparent)
                h_color_0 = color.new(#00ff00, 70)
                h_color_25 = color.new(color.gray, 80)
                h_color_50 = color.new(color.white, 80)
                h_color_75 = color.new(color.gray, 80)
                h_color_100 = color.new(#ff0000, 70)
                
                // Draw historical lines and store them
                array.push(hist_lines, line.new(h_low_bar, h_fib_0, draw_end, h_fib_0, color=h_color_0, style=line.style_dotted, width=1))
                array.push(hist_lines, line.new(h_low_bar, h_fib_25, draw_end, h_fib_25, color=h_color_25, style=line.style_dotted, width=1))
                array.push(hist_lines, line.new(h_low_bar, h_fib_50, draw_end, h_fib_50, color=h_color_50, style=line.style_dotted, width=1))
                array.push(hist_lines, line.new(h_low_bar, h_fib_75, draw_end, h_fib_75, color=h_color_75, style=line.style_dotted, width=1))
                array.push(hist_lines, line.new(h_low_bar, h_fib_100, draw_end, h_fib_100, color=h_color_100, style=line.style_dotted, width=1))
                
                // Create fills and store them
                h_line_0_fill = line.new(h_low_bar, h_fib_0, draw_end, h_fib_0, color=color.new(color.white, 100))
                h_line_25_fill = line.new(h_low_bar, h_fib_25, draw_end, h_fib_25, color=color.new(color.white, 100))
                h_line_75_fill = line.new(h_low_bar, h_fib_75, draw_end, h_fib_75, color=color.new(color.white, 100))
                h_line_100_fill = line.new(h_low_bar, h_fib_100, draw_end, h_fib_100, color=color.new(color.white, 100))
                
                array.push(hist_lines, h_line_0_fill)
                array.push(hist_lines, h_line_25_fill)
                array.push(hist_lines, h_line_75_fill)
                array.push(hist_lines, h_line_100_fill)
                
                // Create and store fills
                f1 = linefill.new(h_line_0_fill, h_line_25_fill, color_0_25)
                f2 = linefill.new(h_line_75_fill, h_line_100_fill, color_75_100)
                array.push(hist_fills, f1)
                array.push(hist_fills, f2)

// ═══════════════════════════════════════════════════════════════════════════════
// DRAW CURRENT RANGE
// ═══════════════════════════════════════════════════════════════════════════════

if range_active and not na(active_range_high) and not na(active_range_low)
    // Calculate Fibonacci levels using the fixed values
    fib_0 = active_range_low
    fib_25 = active_range_low + (active_range_high - active_range_low) * 0.25
    fib_50 = active_range_low + (active_range_high - active_range_low) * 0.5
    fib_75 = active_range_low + (active_range_high - active_range_low) * 0.75
    fib_100 = active_range_high
    
    // Extensions
    fib_1272 = active_range_low + (active_range_high - active_range_low) * 1.272
    fib_1618 = active_range_low + (active_range_high - active_range_low) * 1.618
    
    // Ensure start index is safe
    start_index = mode == "Manual" ? math.max(sl_bar_index, bar_index - 490) : sl_bar_index
    
    if na(line_0)
        // Create lines ONCE
        line_0 := line.new(start_index, fib_0, bar_index, fib_0, color=#00ff00, style=line.style_solid, width=1)
        line_25 := line.new(start_index, fib_25, bar_index, fib_25, color=color.gray, style=line.style_dotted, width=1)
        line_50 := line.new(start_index, fib_50, bar_index, fib_50, color=color.white, style=line.style_solid, width=2)
        line_75 := line.new(start_index, fib_75, bar_index, fib_75, color=color.gray, style=line.style_dotted, width=1)
        line_100 := line.new(start_index, fib_100, bar_index, fib_100, color=#ff0000, style=line.style_solid, width=1)
        
        if show_extensions
            line_1272 := line.new(start_index, fib_1272, bar_index, fib_1272, color=color.gray, style=line.style_dashed, width=1)
            line_1618 := line.new(start_index, fib_1618, bar_index, fib_1618, color=color.gray, style=line.style_dashed, width=1)
        
        // Create fills ONCE
        curr_fill_0_25 := linefill.new(line_0, line_25, color_0_25)
        curr_fill_75_100 := linefill.new(line_75, line_100, color_75_100)
    else
        // Update line coordinates every bar
        line.set_xy1(line_0, start_index, fib_0)
        line.set_xy2(line_0, bar_index, fib_0)
        line.set_xy1(line_25, start_index, fib_25)
        line.set_xy2(line_25, bar_index, fib_25)
        line.set_xy1(line_50, start_index, fib_50)
        line.set_xy2(line_50, bar_index, fib_50)
        line.set_xy1(line_75, start_index, fib_75)
        line.set_xy2(line_75, bar_index, fib_75)
        line.set_xy1(line_100, start_index, fib_100)
        line.set_xy2(line_100, bar_index, fib_100)
        
        // Handle extensions
        if show_extensions
            if na(line_1272)
                line_1272 := line.new(start_index, fib_1272, bar_index, fib_1272, color=color.gray, style=line.style_dashed, width=1)
                line_1618 := line.new(start_index, fib_1618, bar_index, fib_1618, color=color.gray, style=line.style_dashed, width=1)
            else
                line.set_xy1(line_1272, start_index, fib_1272)
                line.set_xy2(line_1272, bar_index, fib_1272)
                line.set_xy1(line_1618, start_index, fib_1618)
                line.set_xy2(line_1618, bar_index, fib_1618)
        else
            line.delete(line_1272)
            line_1272 := na
            line.delete(line_1618)
            line_1618 := na
        
        // Update fill colors in case input changed
        linefill.set_color(curr_fill_0_25, color_0_25)
        linefill.set_color(curr_fill_75_100, color_75_100)
    
    // Labels
    if show_labels and not labels_drawn and range_confirmed
        labels_drawn := true
        label.new(start_index + 5, fib_0, "0%", style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.white, size=size.small)
        label.new(start_index + 5, fib_25, "25%", style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.white, size=size.small)
        label.new(start_index + 5, fib_50, "50%", style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.white, size=size.small)
        label.new(start_index + 5, fib_75, "75%", style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.white, size=size.small)
        label.new(start_index + 5, fib_100, "100%", style=label.style_label_left, color=color.new(color.white, 100), textcolor=color.white, size=size.small)

// Alerts
alertcondition(range_active and not range_active[1], "New Fibonacci Range", "A new Fibonacci range has been detected")
alertcondition(not range_active and range_active[1], "Range Break", "Fibonacci range has been broken")

// ═══════════════════════════════════════════════════════════════════════════════
// INFO TABLE — toujours liée au range actif (valeurs figées à la détection)
// ═══════════════════════════════════════════════════════════════════════════════

// Créer/supprimer la table proprement et gérer le changement de position
var table info_table = na
var string _last_table_pos = ""

pos = switch table_position
    "Top Right" => position.top_right
    "Top Left" => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left" => position.bottom_left
    "Middle Right" => position.middle_right
    "Middle Left" => position.middle_left
    => position.top_right

if show_table
    if na(info_table) or table_position != _last_table_pos
        if not na(info_table)
            table.delete(info_table)
        info_table := table.new(pos, 2, 9, bgcolor=table_bg_color, frame_color=color.gray, frame_width=1, border_width=1)
        _last_table_pos := table_position

    // Afficher les valeurs du range actif (confirmé ou non)
    if range_active and not na(active_range_high) and not na(active_range_low)
        // Niveaux pour la zone
        calc_fib_25 = active_range_low + (active_range_high - active_range_low) * 0.25
        calc_fib_75 = active_range_low + (active_range_high - active_range_low) * 0.75

        // Zone courante
        current_zone = ""
        zone_color = color.gray
        if close <= calc_fib_25
            current_zone := "DISCOUNT"
            zone_color := color.new(#006400, 0)
        else if close >= calc_fib_75
            current_zone := "PREMIUM"
            zone_color := color.new(#8B0000, 0)
        else
            current_zone := "MID RANGE"
            zone_color := color.new(color.gray, 0)

        // Données de range (figées à la détection via active_range_*)
        range_size       = active_range_high - active_range_low
        range_percent    = ((close - active_range_low) / range_size) * 100
        // Éviter les % négatifs quand on est au‑dessus/au‑dessous
        distance_to_high = math.max(0, (active_range_high - close) / close * 100)
        distance_to_low  = math.max(0, (close - active_range_low) / close * 100)
        status           = range_confirmed ? "CONFIRMED" : "PENDING"

        // Remplir la table
        table.cell(info_table, 0, 0, "📊 🇫​​🇮​​🇧​​🇴​​🇳​​🇦​​🇨​​🇨​​🇮​ ​🇷​​🇦​​🇳​​🇬​​🇪​ ", text_color=table_text_color, text_halign=text.align_center, bgcolor=color.new(color.blue, 80), text_size=size.normal)
        table.merge_cells(info_table, 0, 0, 1, 0)

        table.cell(info_table, 0, 1, "🔻 ​🇸​​🇼​​🇮​​🇳​​🇬​ ​🇱​​🇴​​🇼​ ", text_color=table_text_color, text_halign=text.align_left)
        table.cell(info_table, 1, 1, str.tostring(active_range_low,  format.mintick), text_color=color.new(#00ff00, 0), text_halign=text.align_right)

        table.cell(info_table, 0, 2, "🔺​🇭​​🇮​​🇬​​🇭​  ", text_color=table_text_color, text_halign=text.align_left)
        table.cell(info_table, 1, 2, str.tostring(active_range_high, format.mintick), text_color=color.new(#ff0000, 0), text_halign=text.align_right)

        table.cell(info_table, 0, 3, "📏 🇷​​🇦​​🇳​​🇬​​🇪​ ​🇸​​🇮​​🇿​​🇪", text_color=table_text_color, text_halign=text.align_left)
        table.cell(info_table, 1, 3, str.tostring(range_size, format.mintick), text_color=table_text_color, text_halign=text.align_right)

        table.cell(info_table, 0, 4, "🎯 🇨​​🇺​​🇷​​🇷​​🇪​​🇳​​🇹​ ​🇿​​🇴​​🇳​​🇪​", text_color=table_text_color, text_halign=text.align_left)
        table.cell(info_table, 1, 4, current_zone, text_color=zone_color, text_halign=text.align_right, text_size=size.normal)

        table.cell(info_table, 0, 5, "📍 🇵​​🇴​​🇸​​🇮​​🇹​​🇮​​🇴​​🇳", text_color=table_text_color, text_halign=text.align_left)
        table.cell(info_table, 1, 5, str.tostring(range_percent, "##.#") + "%", text_color=table_text_color, text_halign=text.align_right)

        table.cell(info_table, 0, 6, "⬆️ 🇹​​🇴​ ​🇭​​🇮​​🇬​​🇭​", text_color=table_text_color, text_halign=text.align_left)
        table.cell(info_table, 1, 6, str.tostring(distance_to_high, "##.#") + "%", text_color=color.new(#ff0000, 0), text_halign=text.align_right)

        table.cell(info_table, 0, 7, "⬇️ ​🇹​​🇴​ ​🇱​​🇴​​🇼​ ", text_color=table_text_color, text_halign=text.align_left)
        table.cell(info_table, 1, 7, str.tostring(distance_to_low, "##.#") + "%", text_color=color.new(#00ff00, 0), text_halign=text.align_right)

    else

        if not na(info_table)
            table.clear(info_table, 0, 0, 1, 8) 
else

    if not na(info_table)
        table.delete(info_table)
        info_table := na