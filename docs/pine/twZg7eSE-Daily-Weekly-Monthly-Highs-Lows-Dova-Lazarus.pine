// @version=6
indicator("Daily Weekly Monthly Highs & Lows [Dova Lazarus]", "D|W|M ", true, max_lines_count=500)

//--------------------------------------------------------------------
//                               Inputs
//--------------------------------------------------------------------

// Input group names for organization
timeframes_group_name = "Timeframes"
line_settings_group_name = "Line Settings"
display_options_group_name = "Display Options"

// Tooltip descriptions
projections_tooltip = "Extends previous highs and lows in the future."

// Timeframe enable/disable settings
var is_daily_enabled = input(true, "Show Daily Levels", group=timeframes_group_name)
var daily_lookback_periods = input.int(2, "Daily Lookback Periods", minval=1, group=timeframes_group_name)

var is_weekly_enabled = input(true, "Show Weekly Levels", group=timeframes_group_name)
var weekly_lookback_periods = input.int(1, "Weekly Lookback Periods", minval=1, group=timeframes_group_name)

var is_monthly_enabled = input(true, "Show Monthly Levels", group=timeframes_group_name)
var monthly_lookback_periods = input.int(1, "Monthly Lookback Periods", minval=1, group=timeframes_group_name)

// Line appearance settings for Daily timeframe
var daily_color = input(color.green, "Daily Color", inline="DailyLine", group=line_settings_group_name)
var daily_line_style = input.string(line.style_dashed, "Style", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="DailyLine", group=line_settings_group_name)
var daily_line_width = input.int(1, "Width", minval=1, maxval=4, inline="DailyLine", group=line_settings_group_name)

// Line appearance settings for Weekly timeframe  
var weekly_color = input(color.orange, "Weekly Color", inline="WeeklyLine", group=line_settings_group_name)
var weekly_line_style = input.string(line.style_dashed, "Style", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="WeeklyLine", group=line_settings_group_name)
var weekly_line_width = input.int(1, "Width", minval=1, maxval=4, inline="WeeklyLine", group=line_settings_group_name)

// Line appearance settings for Monthly timeframe
var monthly_color = input(color.red, "Monthly Color", inline="MonthlyLine", group=line_settings_group_name)
var monthly_line_style = input.string(line.style_dashed, "Style", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="MonthlyLine", group=line_settings_group_name)  
var monthly_line_width = input.int(1, "Width", minval=1, maxval=4, inline="MonthlyLine", group=line_settings_group_name)

// Display options
var are_projections_enabled = input(false, "Extend Lines Forward", projections_tooltip, group=display_options_group_name)

//--------------------------------------------------------------------
//                        Variables declarations
//--------------------------------------------------------------------

// Array to store the last highs and lows for each timeframe (Daily, Weekly, Monthly)
var array_last_highs = array.new_float(3)
var array_last_lows = array.new_float(3)

// Conditions to determine which timeframes can be shown based on current chart timeframe
var can_show_daily_levels = is_daily_enabled and timeframe.isintraday
var can_show_weekly_levels = is_weekly_enabled and (timeframe.isintraday or timeframe.isdaily)
var can_show_monthly_levels = is_monthly_enabled and not timeframe.ismonthly

// Request security data for daily timeframe
[daily_time_value, daily_high_value, daily_low_value, is_last_daily_bar] = request.security(syminfo.tickerid, 'D', [time, high, low, barstate.islast], lookahead=barmerge.lookahead_on)

// Request security data for weekly timeframe
[weekly_time_value, weekly_high_value, weekly_low_value, is_last_weekly_bar] = request.security(syminfo.tickerid, 'W', [time, high, low, barstate.islast], lookahead=barmerge.lookahead_on)

// Request security data for monthly timeframe
[monthly_time_value, monthly_high_value, monthly_low_value, is_last_monthly_bar] = request.security(syminfo.tickerid, 'M', [time, high, low, barstate.islast], lookahead=barmerge.lookahead_on)

// Check if timeframes have changed (new period started)
has_daily_time_changed = daily_time_value != daily_time_value[1]
has_weekly_time_changed = weekly_time_value != weekly_time_value[1]
has_monthly_time_changed = monthly_time_value != monthly_time_value[1]

//--------------------------------------------------------------------
//                              Functions 
//--------------------------------------------------------------------

// Function to draw high and low lines for each timeframe
draw_high_low_lines(bool is_new_period, float high_value, float low_value, int lookback_count, color line_color, string line_style, int line_width) =>
    // Variables to store current high and low lines
    var line current_high_line = na
    var line current_low_line = na
    
    // Arrays to store historical high and low lines
    var array_high_lines = array.new_line()
    var array_low_lines = array.new_line()
    
    // Determine the end point for lines (with or without projection)
    line_end_point = are_projections_enabled ? bar_index + 20 : bar_index
    
    // When a new period starts
    if is_new_period
        // Extend previous lines to the end point
        line.set_x2(current_high_line, line_end_point)
        line.set_x2(current_low_line, line_end_point)

        // Create new high and low lines for the current period
        current_high_line := line.new(bar_index, high_value, bar_index, high_value, color=line_color, style=line_style, width=line_width)
        current_low_line := line.new(bar_index, low_value, bar_index, low_value, color=line_color, style=line_style, width=line_width)
        
        // Add new lines to arrays
        array.push(array_high_lines, current_high_line)
        array.push(array_low_lines, current_low_line)

        // Remove oldest lines if we exceed the lookback limit
        if array.size(array_high_lines) > lookback_count + 1
            line.delete(array.shift(array_high_lines))
            line.delete(array.shift(array_low_lines))

    // Update line extensions on the last bar if projections are enabled
    if are_projections_enabled and barstate.islast and array.size(array_high_lines) > 1
        // Avoid updating the last/current high and low lines
        for line_index = 0 to array.size(array_high_lines) - 2
            line.set_x2(array.get(array_high_lines, line_index), bar_index + 20)
            line.set_x2(array.get(array_low_lines, line_index), bar_index + 20)

//--------------------------------------------------------------------
//                                Logic
//--------------------------------------------------------------------

// Update daily high and low values when a new daily period starts
if can_show_daily_levels and has_daily_time_changed and not is_last_daily_bar
    array.set(array_last_highs, 0, daily_high_value)
    array.set(array_last_lows, 0, daily_low_value)

// Update weekly high and low values when a new weekly period starts
if can_show_weekly_levels and has_weekly_time_changed and not is_last_weekly_bar
    array.set(array_last_highs, 1, weekly_high_value)
    array.set(array_last_lows, 1, weekly_low_value)

// Update monthly high and low values when a new monthly period starts
if can_show_monthly_levels and has_monthly_time_changed and not is_last_monthly_bar
    array.set(array_last_highs, 2, monthly_high_value)
    array.set(array_last_lows, 2, monthly_low_value)

//--------------------------------------------------------------------
//                          Plotting & styling
//--------------------------------------------------------------------

// Draw monthly high and low lines
if can_show_monthly_levels
    draw_high_low_lines(has_monthly_time_changed, monthly_high_value, monthly_low_value, monthly_lookback_periods, monthly_color, monthly_line_style, monthly_line_width)

// Draw weekly high and low lines
if can_show_weekly_levels
    draw_high_low_lines(has_weekly_time_changed, weekly_high_value, weekly_low_value, weekly_lookback_periods, weekly_color, weekly_line_style, weekly_line_width)

// Draw daily high and low lines
if can_show_daily_levels
    draw_high_low_lines(has_daily_time_changed, daily_high_value, daily_low_value, daily_lookback_periods, daily_color, daily_line_style, daily_line_width)

// Plot invisible highs and lows for displaying their last values in status line, scale, data window and for providing default alert conditions

// Daily high and low plots (invisible)
plot(array.get(array_last_highs, 0), "Daily High", color.new(daily_color, 100), editable=false)
plot(array.get(array_last_lows, 0), "Daily Low", color.new(daily_color, 100), editable=false)

// Weekly high and low plots (invisible)
plot(array.get(array_last_highs, 1), "Weekly High", color.new(weekly_color, 100), editable=false)
plot(array.get(array_last_lows, 1), "Weekly Low", color.new(weekly_color, 100), editable=false)

// Monthly high and low plots (invisible)
plot(array.get(array_last_highs, 2), "Monthly High", color.new(monthly_color, 100), editable=false)
plot(array.get(array_last_lows, 2), "Monthly Low", color.new(monthly_color, 100), editable=false)