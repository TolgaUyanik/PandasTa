//@version=5
library("BOT_1_0_LIB_TEXT", overlay = false)

// BOT 1.0 - LIB_TEXT
// FIX107_TEXT_REFACTOR
// Missão: centralizar composição textual, detalhes de painéis,
// badges e helpers de apresentação textual, sem cálculo operacional.

export txtStatus(int st) =>
    st == 0 ? "OFF" : st == 1 ? "SIM" : "NAO"

export stateTxt(int st) =>
    st == 0 ? "IDLE" : st == 1 ? "ARMADO" : st == 2 ? "ATIVO" : "COOLDOWN"

export sideTxt(int sd) =>
    sd == 1 ? "LONG" : sd == -1 ? "SHORT" : "NONE"

export pbStateTxt(int st) =>
    st == 0 ? "IDLE" : st == 1 ? "WAIT_RETEST" : st == 2 ? "WAIT_CONFIRM" : "READY"

export m07CycleTxt(int st) =>
    st == 0 ? "IDLE" : st == 1 ? "ARMED" : st == 2 ? "ACTIVE" : "EXIT"

export panel_m03_detail(string stateTxt, string sideTxt, string regraAtiva, int reqAntesArm) =>
    "st=" + stateTxt + " | side=" + sideTxt + " | regra=" + regraAtiva + " | req=" + str.tostring(reqAntesArm)

export panel_perf_detail(float perfCumR, float perfAvgR, float perfAvgWin, float perfAvgLoss, float perfPayoff, float perfExpectancyPanel, float perfBestTradeR, float perfWorstTradeR, int perfWinStreak, int perfBestWinStreak, int perfLossStreak, int perfBestLossStreak) =>
    "cum=" + str.tostring(perfCumR, "#.##") +
     " | avg=" + str.tostring(perfAvgR, "#.##") +
     " | win=" + str.tostring(perfAvgWin, "#.##") +
     " | loss=" + str.tostring(perfAvgLoss, "#.##") +
     " | pf=" + str.tostring(perfPayoff, "#.##") +
     " | exp=" + str.tostring(perfExpectancyPanel, "#.##") +
     " | best=" + str.tostring(perfBestTradeR, "#.##") +
     " | worst=" + str.tostring(perfWorstTradeR, "#.##") +
     " | ws=" + str.tostring(perfWinStreak) + "/" + str.tostring(perfBestWinStreak) +
     " | ls=" + str.tostring(perfLossStreak) + "/" + str.tostring(perfBestLossStreak)

export panel_perf_last_detail(float perfLastTradeR, string perfLastTradeReason, int perfActiveTradeId, float perfCycleCumR) =>
    "R=" + str.tostring(perfLastTradeR, "#.##") +
     " | rsn=" + perfLastTradeReason +
     " | active=" + (perfActiveTradeId > 0 ? ("T" + str.tostring(perfActiveTradeId)) : "na") +
     " | cyc=" + str.tostring(perfCycleCumR, "#.##")

export panel_flow_state_detail(int flowDiag_win, int flowDiag_followBars, int flowDiag_hostileX) =>
    "win=" + str.tostring(flowDiag_win) + " | follow=" + str.tostring(flowDiag_followBars) + " | hostile=" + str.tostring(flowDiag_hostileX)

export panel_flow_cnt_long(int flowDiag_cCount, int flowDiag_gCount) =>
    "C=" + str.tostring(flowDiag_cCount) + " | G=" + str.tostring(flowDiag_gCount)

export panel_flow_cnt_short(int flowDiag_pCount, int flowDiag_xCount) =>
    "P=" + str.tostring(flowDiag_pCount) + " | X=" + str.tostring(flowDiag_xCount)

export panel_flow_cnt_detail(float flowDiag_friction, int flowDiag_gFailedCount) =>
    "fric=" + str.tostring(flowDiag_friction, "#.##") + " | gFail=" + str.tostring(flowDiag_gFailedCount)

export panel_flow_cont_detail(float m07_cfSlopeNow, float ac_widthPct) =>
    "slope=" + str.tostring(m07_cfSlopeNow, "#.##") + " | width=" + str.tostring(ac_widthPct, "#.##") + "%"

export panel_edge_sig_detail(string edgeGlobalClass, float edgeFollowRate, int edgeTotal) =>
    "class=" + edgeGlobalClass + " | rate=" + str.tostring(edgeFollowRate, "#.##") + "% | n=" + str.tostring(edgeTotal)

export panel_edge_cnt_long(int edgeFollowCount, int edgeNeutralCount, int edgeFailCount) =>
    "F/N/X=" + str.tostring(edgeFollowCount) + "/" + str.tostring(edgeNeutralCount) + "/" + str.tostring(edgeFailCount)

export panel_edge_cnt_short(int traceEdgeMinSamples, float traceEdgeGoodRate) =>
    "min=" + str.tostring(traceEdgeMinSamples) + " | good=" + str.tostring(traceEdgeGoodRate, "#.##") + "%"

export panel_edge_cnt_detail(int traceEdgeWindowBars, float traceEdgeStrongR, float traceEdgeFailR) =>
    "win=" + str.tostring(traceEdgeWindowBars) + " | strong=" + str.tostring(traceEdgeStrongR, "#.##") + "R | fail=" + str.tostring(traceEdgeFailR, "#.##") + "R"

export panel_edge_reg_short(int followCnt, int neutralCnt, int failCnt) =>
    str.tostring(followCnt) + "/" + str.tostring(neutralCnt) + "/" + str.tostring(failCnt)

export panel_edge_rate_detail(float edgeRate) =>
    "rate=" + str.tostring(edgeRate, "#.##") + "%"

export panel_edge_acc_detail(string traceEdgeAccelMode, float edgeAccelRate) =>
    traceEdgeAccelMode + " | rate=" + str.tostring(edgeAccelRate, "#.##") + "%"
