// ┃                          USER DEFINED TYPES                                  ┃ {
 
// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓  enum types for INPUT ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

// --- enum BandTypes --- {
// @enum Enumerator of types of bands (Bolinger, Parabolic SAR, Supertrend etc.)
export enum BandTypes 
    BB                = "Bollinger Bands"
    SAR               = "Parabolic SAR"
    ST                = "Supertrend" 
    VWAP              = "VWAP" 
    none              = "None"
//}

// --- enum VwapAnchors --- {
// @enum Enumerator of VWAP anchors 
export enum VwapAnchors
    S       = "Session"
    SR      = "Session (regular hours)"
    H       = "Hourly"
    D       = "Daily (UTC)"
    W       = "Weekly (Mon-Sun)"
    M       = "Monthly"
    Y       = "Yearly"
//}


// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF INPUT enum types  ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ }


// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓  getDefaulBandQN functions ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {
// --- getDefaulBandQ1( bandType ) ---{
// @function For a given BandType returns its default Q1
export method getDefaultBandQ1(BandTypes bandType) =>
    switch bandType 
        BandTypes.BB      => 20
        BandTypes.SAR     => 0.02
        BandTypes.ST      => 10
        BandTypes.VWAP    => 1
        BandTypes.none    => 0
//}

// --- getDefaulBandQ2( bandType ) ---{
// @function For a given BandType returns its default Q2
export method getDefaultBandQ2(BandTypes bandType) =>
    switch bandType 
        BandTypes.BB      => 2
        BandTypes.SAR     => 0.02
        BandTypes.ST      => 3
        BandTypes.VWAP    => 0
        BandTypes.none    => 0
//}


// --- getDefaulBandQ3( bandType ) ---{
// @function For a given BandType returns its default Q3
export method getDefaultBandQ3(BandTypes bandType) =>
    switch bandType 
        BandTypes.BB      => 0
        BandTypes.SAR     => 0.2
        BandTypes.ST      => 0
        BandTypes.VWAP    => 0
        BandTypes.none    => 0
//}

// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF getDefaulBandQN functions  ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ }


// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ BANDS TYPE GROUP ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {
// Used to collect BANDS data from HTF

// ♦♦♦♦♦♦ RsParamsBands TYPE ♦♦♦♦♦♦ {

// +++ RsParamsBands type +++ {
// @type  Used to pass bands' params to req.sec()  
// @field bandsType  (enum BandTypes) Type of the band (BB, SAR etc.)
// @field q1 (float) Depending on type: BB - length, SAR - AF start, ST - ATR's prd
// @field q2 (float) Depending on type: BB - StdDev mult, SAR - AF step, ST - mult
// @field q3 (float) Depending on type: BB - not used, SAR - AF max, ST - not used
export type RsParamsBands
    BandTypes          bandsType 
    float           q1
    float             q2
    float             q3
    VwapAnchors   vwapAnchor
// END OF RsParamsBands type}

// --- init(RsParamsBands) --- {
// @function Initiates RsParamsBands for each band (used in htfUpdate() withi req.sec())
// @param bandType (BandTypes) Band type
// @param q1 (float) Depending on type: BB - length, SAR - AF start, ST - ATR's prd
// @param q2 (float) Depending on type: BB - StdDev mult, SAR - AF step, ST - mult
// @param q3 (float) Depending on type: BB - not used, SAR - AF max, ST - not used
// @param vwapAnchor (VwapAnchors) VWAP ahcnor
export method init   (   RsParamsBands this
                 , BandTypes          bandsType 
                   , float             q1  
                   , float             q2  
                   , float             q3  
                 , VwapAnchors  vwapAnchor
                 ) =>    

    this.bandsType    := bandsType 
    this.q1          := q1
    this.q2          := q2
    this.q3          := q3    
    this.vwapAnchor  := vwapAnchor
    this


// END OF init()}

// ▲▲▲ END OF RsParamsBands type  ▲▲▲ }  

// ♦♦♦♦♦♦ RsReturnBands TYPE ♦♦♦♦♦♦ {
// @type  Used to return bands' data from req.sec(). Params of the bands are in RsParamsBands
// @field htfBi    (float)   Higher timeframe's bar index (Default = na)
// @field upBand   (float)   Value of upper band (Default = na)
// @field loBand   (float)   Value of lower band (Default = na)
// @field midBand  (float)   Value of middle band (Default = na)
// @field dir      (float)   Direction (for bands like Parabolic SAR) (Default = na)
export type RsReturnBands
    float htfBi = na
    float upBand = na
    float loBand = na
    float midBand = na
    int dir = na
// ▲▲▲ END OF RsReturnBands type  ▲▲▲ }  


// ---- isVwapAnchor() ---{
// @function Checks for VWAP anchor time
isVwapAnchor(VwapAnchors a) => 
    switch a
        VwapAnchors.S => session.isfirstbar
        VwapAnchors.SR => session.isfirstbar_regular
        VwapAnchors.H => ta.change(time("60"))  > 0
        VwapAnchors.D => ta.change(time("D"))   > 0
        VwapAnchors.W => ta.change(time("W"))   > 0
        VwapAnchors.M => ta.change(time("M"))   > 0
        VwapAnchors.Y => ta.change(time("12M")) > 0
//}

// ━━━━━━ htfUpdateTuple(bool repaint) ━━━━━━ {
// @function (HTF) Calculates Bands within request.security(). Returns tuple [middleBand, upperBand, lowerBand]. If any or all of the bands are not available returns na as their value.
// @param rsPrms (RsParamsBands) Parameters of the band.
// @param repaint (bool) If true does not update on realtime bars.
// @returns A tuple [HTF bar_index, middle, upper, lower, direction] (corresponds to fields in RsReturnBands)
export method htfUpdateTuple(RsParamsBands rsPrms, bool repaint) => 
    simple float fNa = na
    htfBi = bar_index   
    [mid, up, lo, dir] = if rsPrms.bandsType != BandTypes.none
        if na(rsPrms.bandsType)  
            runtime.error(str.format("RsReturnBands.htfUpdate(): na(rsPrms.bandsType)  =  {0}", na(rsPrms.bandsType) ))
        if na(rsPrms.q1)  
            runtime.error(str.format("RsReturnBands.htfUpdate(): na(rsPrms.q1)  =  {0}", na(rsPrms.q1) ))
        if na(rsPrms.q2)  
            runtime.error(str.format("RsReturnBands.htfUpdate(): na(rsPrms.q2)  =  {0}", na(rsPrms.q2) ))
        if na(rsPrms.q3)  
            runtime.error(str.format("RsReturnBands.htfUpdate(): na(rsPrms.q3)  =  {0}", na(rsPrms.q3) ))

        [m, u, l, d] = switch rsPrms.bandsType
            BandTypes.BB => 
                [_m, _u, _l] = pine_bb(close, int(rsPrms.q1), rsPrms.q2) 
                [_m , _u, _l, int(na)]
            BandTypes.SAR => 
                _sar = pine_sar(rsPrms.q1, rsPrms.q2, rsPrms.q3)
                if _sar >= close 
                    [fNa, _sar, fNa, 1]
                else
                    [fNa, fNa, _sar, -1]

            BandTypes.ST => 
                [_st, _dir] = pine_supertrend2(rsPrms.q2, int(rsPrms.q1))
                _m = (open + close) /2
                if _dir > 0 
                    [_m, _st, fNa, _dir]
                else
                    [_m, fNa, _st, _dir]
            BandTypes.VWAP => 
                [_m, _u, _l] = ta.vwap(hlc3, isVwapAnchor(rsPrms.vwapAnchor), rsPrms.q1)
                [_m, _u, _l, int(na)]
            =>
                [fNa, fNa, fNa, int(na)]
    else
        [fNa, fNa, fNa, int(na)]
   
    [ htfBi [ barstate.isrealtime and not(repaint) ? 1 : 0 ]
     , mid  [ barstate.isrealtime and not(repaint) ? 1 : 0 ]
     , up   [ barstate.isrealtime and not(repaint) ? 1 : 0 ]
     , lo   [ barstate.isrealtime and not(repaint) ? 1 : 0 ]
     , dir  [ barstate.isrealtime and not(repaint) ? 1 : 0 ]
     ]    
// END OF htfUpdateTuple()  }


// ♦♦♦♦♦♦ BandsDrawing TYPE ♦♦♦♦♦♦ {
//♦                              
// not encapsulated, HtfBands inits and manages BandsDrawing

// +++ BandsDrawing type +++{
// @type  Contains plot visualization parameters and stores and keeps track of lines, labels and other visual objects (not plots)
// @field lnMidClr       (color)    Middle band color                            
// @field lnLoClr        (color)    Lower band color                                                    
// @field lnUpClr        (color)    Upper band color                                                    
// @field fillClr        (color)    Fill color                                                    
// @field lnWidth        (int)      Line width                        
// @field lnSmoothen     (bool)     Smoothen the bands                            
// @field showHistory    (bool)     If true show bands lines, otherwise only current level                            
// @field showRecentBars (int)      Only show over this number of recent bars                                 
// @field arLbl          (label     Labels                         
// @field lblsMaxLabels  (int)      Max labels to show                                
// @field lblsShow       (bool)     Show labels                                
// @field lblSize        (string)   Size of the labels                        
export type BandsDrawing
    // bool        enabled
    // --- plot params --- // plots can as well use input params since they are not in library but in the script
    color       lnMidClr
    color       lnLoClr
    color       lnUpClr
    color       fillUpClr
    color       fillLoClr
    int         lnWidth
    bool        lnSmoothen
    bool        showHistory = true
    int         showRecentBars = 100000
    // --- line & label --- 

    // labels queue
    label[]     arLbl
    int         lblsMaxLabels

    // line        ln
    // label       lbl
    // int         lblsOffset
    bool        lblsShow
    // int         lnOffset
    string      lblSize

// END OF BandsDrawing type}


// --- shiftr(arLbl)  --- {
method shiftr(label[] this) => this.shift().delete() 
// --- END of shiftr()    ---}

// --- pushr( ) --- {
// @function pushes new item to array while shifting objects if over maxItems
method pushr(label[]   this , label obj, int maxItems = 100000) =>
    this.push(obj)
    while (this.size() > maxItems)
        this.shiftr() 
    this
// END OF  push() }

// ▲▲▲  END OF BandsDrawing TYPE ^▲▲▲^^ }

// ♦♦♦♦♦♦ HtfBands TYPE ♦♦♦♦♦♦ {

  // +++ HtfBands type +++  {
// @type Calcs and draws HTF bands
// @field rsRet (RsReturnBands)   Bands' values 
// @field rsRetNaObj (RsReturnBands)   Dummy na obj for returning from request.security() 
// @field rsPrms (RsParamsBands)  Band parameters (for htfUpdate() called in req.sec() )
// @field drw (BandsDrawing) Contains plot visualization parameters and stores and keeps track of lines, labels and other visual objects (not plots)
// @field enabled (bool) Toggles bands on/off
// @field tf  (string) Timeframe
export type HtfBands
    RsReturnBands            rsRet
    RsReturnBands            rsRetNaObj
    RsParamsBands           rsPrms

    // --- draw params ---
    BandsDrawing            drw

    // --- general draw params --- 
    bool                    enabled
    string                  tf


// END OF HtfBands type }

// ━━━━━ BASIC METHODS ━━━━━ {

// --- init(HtfBands) --- {
// @function Initialises object with params (incl. input). Creates arrays if any. 
// @param bandsType      (BandTypes) Just used to enable/disable - if BandTypes.none then disable ) 
// @param tf  (string) Timeframe
// @param showRecentBars (int)      Only show over this number of recent bars                                 
// @param lblsShow       (bool)     Show labels                                
// @param lblsMaxLabels  (int)      Max labels to show                                
// @param lblSize        (string)   Size of the labels     
// @param lnMidClr       (color)    Middle band color                            
// @param lnLoClr        (color)    Lower band color                                                    
// @param lnUpClr        (color)    Upper band color                                                    
// @param fillClr        (color)    Fill color                                                    
// @param lnWidth        (int)      Line width                        
// @param lnSmoothen     (bool)     Smoothen the bands                            
export method init(HtfBands this
                  , BandTypes           bandsType      
                  , string              tf               
                  , int                 showRecentBars  = 100000     
                  , bool                lblsShow        = true 
                  , int                 lblsMaxLabels   = 100000 
                  , string              lblSize         = size.normal
                  , color               lnMidClr        = na
                  , color               lnUpClr         = na
                  , color               lnLoClr         = na
                  , bool                fill            = false
                  , color               fillClr         = na
                  , int                 lnWidth         = 1
                  , bool                lnSmoothen      = false
                  ) =>    

    
    // --- create and init objects --- 
    this.rsRetNaObj     := RsReturnBands.new()

    // --- init BandsDrawing --- 
    _fillUpClr = not(fill) ? #FFFFFF00 : 
                      bandsType  == BandTypes.BB ? fillClr : 
                          bandsType  == BandTypes.ST ? lnUpClr.fade(90) : #FFFFFF00 

    _fillLoClr = not(fill) ? #FFFFFF00 : 
                      bandsType  == BandTypes.BB ? fillClr : 
                          bandsType  == BandTypes.ST ? lnLoClr.fade(90) : #FFFFFF00 


    this.drw  := BandsDrawing.new(
                                //  ln = line.new(x1 = na, y1 = na, x2 = na, y2=na)
                                //  , lbl = label.new(x = na, y = na)
                                 arLbl = array.new<label>()
                                 , fillUpClr = _fillUpClr
                                 , fillLoClr = _fillLoClr
                                 )
    
    // --- input params --- 
    this.enabled                     := bandsType != BandTypes.none 
    this.tf                          := tf
    this.drw.showHistory             := true
    this.drw.showRecentBars          := showRecentBars
    // this.drw.lblsOffset              := lblsOffset
    this.drw.lblsShow                := lblsShow
    this.drw.lblsMaxLabels           := lblsMaxLabels
    // this.drw.lnOffset                := lnOffset
    this.drw.lblSize                 := lblSize
    // this.drw.lblStyle                := lblStyle
    this.drw.lnUpClr                 := lnUpClr
    this.drw.lnLoClr                 := lnLoClr
    this.drw.lnMidClr                := lnMidClr
    this.drw.fillUpClr               := _fillUpClr
    this.drw.fillLoClr               := _fillLoClr
    this.drw.lnWidth                 := lnWidth
    this.drw.lnSmoothen              := lnSmoothen


    this


// END OF init() }

// --- importRsRetTuple() --- {
// @function Imports a tuple  returned from req.sec()  into an  HtfBands object 
// @param this (HtfBands) Object to import to 
// @param htfBi    (float)   Higher timeframe's bar index (Default = na)
// @param up   (float)   Value of upper band (Default = na)
// @param lo   (float)   Value of lower band (Default = na)
// @param mi  (float)   Value of middle band (Default = na)
// @param dir      (int)   Direction (for bands like Parabolic SAR) (Default = na)
export method importRsRetTuple(HtfBands  this, int htfBi, float mid, float up, float lo, int dir) =>
    this.rsRet := if na(htfBi) or not this.enabled 
        this.rsRetNaObj 
    else
        RsReturnBands.new(htfBi, up, lo, mid, dir)
    this
// END OF importRsRetTuple() }



// END OF  BASIC METHODS }

// ━━━━━ DRAWING METHODS ━━━━━ {

// --- addLbl() --- {
// @function Add labels to HtfBand (object keeps queue of labels and removes older over this.drw.lblsMaxLabels) 
method addLbl(HtfBands  this, label lbl) => this.drw.arLbl.pushr(lbl, this.drw.lblsMaxLabels)
// END OF addLbl() }


// --- addUpdDrawings() --- {
// @function Draws band's labels 
export method addUpdDrawings(HtfBands this, RsParamsBands rsPrms) =>
    // --- draw ST labels --- 
    if rsPrms.bandsType == BandTypes.ST and  ta.change(this.rsRet.dir) != 0 and this.drw.lblsShow
        [_sar, _clr, _style] = if na(this.rsRet.loBand)
            [this.rsRet.upBand,  this.drw.lnUpClr, label.style_label_down]
        else
            [this.rsRet.loBand, this.drw.lnLoClr, label.style_label_up]

        _lbl = label.new( bar_index
                   , _sar
                   , text = str.tostring(math.round_to_mintick(_sar))
                   , color = _clr
                   , style = _style
                   , size = this.drw.lblSize
                   )
        this.addLbl(_lbl)

//END OF  addUpdDrawings}



// ^^^ END OF DRAWING METHODS ^^^ }

// ━━━━━ update ()  ━━━━━ { 
// @function Sets band's values to na on intrabars if `smoothen` is set.
export method update(HtfBands this) => 
    // --- smoothen bands if required --- 
    // log.info("Smoothen = {0}\n ta.change(this.rsRet.htfBi) = {1}\n this.rsRet.htfBi = {2}",this.drw.lnSmoothen.toS(), ta.change(this.rsRet.htfBi), this.rsRet.htfBi )
    if this.drw.lnSmoothen and ta.change(this.rsRet.htfBi) == 0
        this.rsRet.upBand := na
        this.rsRet.loBand := na
        this.rsRet.midBand := na
        this.rsRet.dir := na


// ^^^ END OF update() ^^^ }

// ▲▲▲ END OF HtfBands type ▲▲▲ }  
//----------------------------------------------

// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF BANDS TYPE GROUP  ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ }

// ┃                 END OF USER DEFINED TYPES                                    ┃ }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          THE LIBRARY OBJECT                                  ┃ {
// Using this object allows to avoid using other library types, so copy-pasting
// INIT sections from library to script becomes easier. 

// using same LO type for both RsParamsBands.new() and HtfBands.new() leads to an error 
// "Error at 179:1 built-in 'label.new' cannot be used with any parameter of the `security()` function."
// (misleadingly pointing to a line with `export enum BandTypes`)

// @type LO Library object, whose only purpose is to serve as a shorthand for library name in script code. 
// Used in INIT section where object of library types are created. Instead of writing "LIBRARY_ALIAS.function()"
// you can write "LO.function_wrapper()" where `function_wrapper() => LIBRARY_ALIAS.function()`
export type LO_A
    string dummy                      = "HTFMAs"

// @type LO Library object, whose only purpose is to serve as a shorthand for library name in script code. 
// Used in INIT section where object of library types are created. Instead of writing "LIBRARY_ALIAS.function()"
// you can write "LO.function_wrapper()" where `function_wrapper() => LIBRARY_ALIAS.function()`
export type LO_B
    string dummy                      = "HTFMAs"
    
// @function A wraper for RsParamsBands.new()
export method newRsParamsBands    (LO_A this) => na(this) ? RsParamsBands.new() : RsParamsBands.new()  // `this` must be used.....
// @function A wraper for HtfBands.new()
export method newHtfBands         (LO_B this) => na(this) ? HtfBands.new() : HtfBands.new()

var LO_A loHtfBandsA = LO_A.new()
var LO_B loHtfBandsB = LO_B.new() 

// ┃                 END OF THE LIBRARY OBJECT                                    ┃ }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          TYPE SHORTHANDS FOR BANDS INPUT                     ┃ {
// Minor amendment to this section (adding library alias before the types ) allows
// to copy paste code sections below to user's script without modifications.
var BandTypes_BB                    = BandTypes.BB    
var BandTypes_SAR                   = BandTypes.SAR   
var BandTypes_ST                    = BandTypes.ST    
var BandTypes_VWAP                  = BandTypes.VWAP  
var BandTypes_none                  = BandTypes.none  
var VwapAnchors_S                   = VwapAnchors.S     
var VwapAnchors_SR                  = VwapAnchors.SR    
var VwapAnchors_H                   = VwapAnchors.H     
var VwapAnchors_D                   = VwapAnchors.D     
var VwapAnchors_W                   = VwapAnchors.W     
var VwapAnchors_M                   = VwapAnchors.M     

// ┃                 END OF TYPE SHORTHANDS FOR BANDS INPUT                       ┃ }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          INPUTS AND INIT - BANDS                             ┃ {


// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓       BANDS INPUT GENERAL       ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

// --- input text constants ---
// --- CONSTANT COLORS --- {
const color CLR_TRANSP                       = color.rgb(255, 255, 255, 100) 
const color CLR_BANDS_MID                    = color.rgb(244, 243, 243)
const color CLR_BANDS_UP                     = #f7b6b2
const color CLR_BANDS_LO                     = #77f68ad2
//}

// --- CONSTANT STRINGS --- {
const string IG_SYM1_BANDS_ALL    = "▓▓▓▓▓▓▓▓▓▓▓   Ｂ Ａ Ｎ Ｄ Ｓ   ▓▓▓▓▓▓▓▓▓▓▓"
const string IG_SYM1_BANDS1       = "▓▓▓▓▓▓▓▓▓▓▓   Ｂ Ａ Ｎ Ｄ Ｓ - 1   ▓▓▓▓▓▓▓▓▓▓▓"
const string IG_SYM1_BANDS2       = "▓▓▓▓▓▓▓▓▓▓▓   Ｂ Ａ Ｎ Ｄ Ｓ - 2   ▓▓▓▓▓▓▓▓▓▓▓"

const string TT_BANDS_Q = "Bands' parameters. If 0 uses defaults. 
                         For Bollinger Bands: Q1 - length (default = 20), Q2 - standard deviation mult. (default = 2), Q3 - not used. 
                         For Parabolic Sar: Q1 - Acceleration Factor's ('AF') start value (default = 0.02), Q2 - AF's step. (default = 0.02), Q3 - AF's max (default = 0.2). 
                         For Supertrend: Q1 - ATR's period (default = 10), Q2 - ATR's multiplier (default = 3), Q3 - not used. 
                         For VWAP: Q1 - standad deviation multiplier for the bands. (use 0 to hide the bands and show just VWAP). Default is 1.  Q2 and Q3 are not used.
                         "

const string TT_BANDS_VWAP_ANCHOR = "VWAP will reset at the beginning of each period."
const string TT_BANDS_SOURCE = "Defaults are: BB - close, SAR - "
const string TT_BANDS_OFFSET = "Positive values mote to the right."

const string TT_BANDS_LINE_STYLE = "For some bands this setting is overridden (e.g. Supertrend or SAR are always with breaks.)"

const string TT_BANDS_MAX_LABELS                 = "Maximum this number of labels will be displayed fr this band. The older ones will be deleted"

const string TT_BANDS_SMOOTHEN    = "If smoothen is NOT selected then latest HTF value will be plotted as a horizontal line 
                              until a new HTF value comes (line will look like steps). If smoothen is selected then once 
                              a new HTF value comes it will be connected with the previous with a straight and normally 
                              oblique line (across the intrabars within the HTF bar)."



const string TT_BANDS_REPAINT_AND_LOOKAHEAD = "Repaint: (only applies to the realtime bars) If set will update as new 
                              realtime data comes, if false will wait until realtime bar closes. 
                              Lookahead: (only applies to the historical bars) If true the script will learn how the 
                              HTF bar closed already on the first chart tf's bar. If false - only on the last chart 
                              tf's bar within the HTF bar."  




//}

i_bands_enableAll                       = input.bool    (group = IG_SYM1_BANDS_ALL, inline= "0", defval = true, title = "All bands on/off", tooltip = "General switch for all the bands")                    
i_bands_repaint                         = input.bool    (group = IG_SYM1_BANDS_ALL, inline= "0", defval = false, title = "Repaint bands", tooltip = TT_BANDS_REPAINT_AND_LOOKAHEAD)                    
i_bands_lookahead                       = input.bool    (group = IG_SYM1_BANDS_ALL, inline= "0", defval = false, title = "Lookahead", tooltip = TT_BANDS_REPAINT_AND_LOOKAHEAD) 



// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF BANDS INPUT GENERAL ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ //}

// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓       BANDS1 INPUT AND INIT        ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

// ━━━━━━━━━━━━━━━━━━━━━━━━━ BANDS1 - INPUT ━━━━━━━━━━━━━━━━━━━━━━━━━ //{

// --- CONSTANT COLORS --- {
const color CLR_MID_BANDS1                     = color.rgb(244, 243, 243)
const color CLR_UP_BANDS1                     = #f7b6b2
const color CLR_LO_BANDS1                     = #77f68ad2
const color CLR_BB_FILL                     = #6263624d
//}

// --- band's calc params ---{
i_sym1Bands1_type     = input.enum        (display = display.none, group=IG_SYM1_BANDS1,   inline="1", defval = BandTypes_BB,  title="Type")
i_sym1Bands1_tf       = input.timeframe   (display = display.none, group=IG_SYM1_BANDS1,   inline="1", defval = "60",   title='Timeframe')
i_sym1Bands1_showSmallerTFs     = input.bool    (group = IG_SYM1_BANDS1, inline= "1", defval = true, title = "Plot smaller TF's", tooltip = "If checked all bands of smaller timeframes will be shown on higher timeframes (e.g. 1H EMA on a daily chart)")                    
isym1Bands1_type      = i_bands_enableAll and (i_sym1Bands1_type != BandTypes_none)  and ( (timeframe.in_seconds(i_sym1Bands1_tf) >= timeframe.in_seconds(timeframe.period)) or i_sym1Bands1_showSmallerTFs ) ? i_sym1Bands1_type : BandTypes_none
// for req.sec(): added 1D-->D and 1W --> W conversion (i_tf1 --> var itf1) (strange that input.timeframe returns "1D" and "1W")
simple string isym1Bands1_tf = i_sym1Bands1_tf == "1D" ? "D" : (i_sym1Bands1_tf == "1W" ? "W" : (i_sym1Bands1_tf == "1M" ? "M" : i_sym1Bands1_tf))


i_sym1Bands1_q1       = input.float       (display = display.none, group=IG_SYM1_BANDS1,   inline="2", defval = 0,   title='Q1')
i_sym1Bands1_q2       = input.float       (display = display.none, group=IG_SYM1_BANDS1,   inline="2", defval = 0,   title='Q2')
i_sym1Bands1_q3       = input.float       (display = display.none, group=IG_SYM1_BANDS1,   inline="2", defval = 0,   title='Q3', tooltip = TT_BANDS_Q)

// i_sym1Bands1_vwapSrc        = input.source      (display = display.none, group=IG_SYM1_BANDS1,   inline="VWAP", defval = Source.def,   title='Source', tooltip = TT_BANDS_SOURCE)
i_sym1Bands1_vwapAnchor = input.enum        (display = display.none, group=IG_SYM1_BANDS1,   inline="VWAP", defval = VwapAnchors_S,   title='VWAP anchor', tooltip = TT_BANDS_VWAP_ANCHOR)

var float isym1Bands1_q1 = if i_sym1Bands1_q1 != 0 
    i_sym1Bands1_q1  
else 
    switch i_sym1Bands1_type 
        BandTypes_BB      => 20
        BandTypes_SAR     => 0.02
        BandTypes_ST      => 10
        BandTypes_VWAP    => 1
        BandTypes_none    => 0

var float isym1Bands1_q2 = if i_sym1Bands1_q2 != 0 
    i_sym1Bands1_q2  
else 
    switch i_sym1Bands1_type 
        BandTypes_BB      => 2
        BandTypes_SAR     => 0.02
        BandTypes_ST      => 3
        BandTypes_VWAP    => 0
        BandTypes_none    => 0

var float isym1Bands1_q3 = if i_sym1Bands1_q3 != 0 
    i_sym1Bands1_q3  
else 
    switch i_sym1Bands1_type 
        BandTypes_BB      => 0
        BandTypes_SAR     => 0.2
        BandTypes_ST      => 0
        BandTypes_VWAP    => 0
        BandTypes_none    => 0
//}

// --- bands' visualisation params ---{

i_sym1Bands1_showRecentBars     = input.int    (group = IG_SYM1_BANDS1, inline= "1", defval = 100000, title = "Back to, bars", tooltip = "Only plot on recent bars.")                    


// --- LABELS --- {
i_sym1Bands1_lblsShow           = input.bool    (group = IG_SYM1_BANDS1, inline = "lbls1", defval = true, title = "Show labels", tooltip = "")                    
i_sym1Bands1_lblsMaxLabels      = input.int    (group = IG_SYM1_BANDS1, inline = "lbls1", defval = 500, title = "Max lbls", tooltip = TT_BANDS_MAX_LABELS)                    

// --- input lblSize --- {
i_sym1Bands1_lblSize         = input.string  (group = IG_SYM1_BANDS1, inline = "lbls1", defval = "Normal", title="Size", options= ["Auto", "Tiny", "Small", "Normal", "Large", "Huge"])

//Turn the input into a proper label size value
simple string isym1Bands1_lblSize =        (i_sym1Bands1_lblSize == "Auto")    ? size.auto  :
                              (i_sym1Bands1_lblSize == "Tiny")    ? size.tiny  :
                              (i_sym1Bands1_lblSize == "Small")   ? size.small :
                              (i_sym1Bands1_lblSize == "Normal")  ? size.normal:
                              (i_sym1Bands1_lblSize == "Large")   ? size.large :
                              (i_sym1Bands1_lblSize == "Huge")    ? size.huge  :
                              size.normal

// END OF lblSize input }

//}



// --- LINES ---  {
i_sym1Bands1_lnWidth        = input.int     (group = IG_SYM1_BANDS1, inline = "lnWS", defval = 1, title = "Line width", tooltip = "")                                                    
i_sym1Bands1_offset         = input.int     (group = IG_SYM1_BANDS1, inline = "lnWS", defval = 0, title = "Offset", tooltip = TT_BANDS_OFFSET)                                                    
i_sym1Bands1_lnSmoothen     = input.bool    (group = IG_SYM1_BANDS1, inline = "lnWS", defval = false, title = "Smoothen", tooltip = TT_BANDS_SMOOTHEN)                                                    
i_sym1Bands1_lnMidClr       = input.color   (group = IG_SYM1_BANDS1, inline = "clrs", defval = CLR_MID_BANDS1, title = "Midle", tooltip = "")                                                    
i_sym1Bands1_lnUpClr        = input.color   (group = IG_SYM1_BANDS1, inline = "clrs", defval = CLR_UP_BANDS1, title = "Upper", tooltip = "")                                                    
i_sym1Bands1_lnLoClr        = input.color   (group = IG_SYM1_BANDS1, inline = "clrs", defval = CLR_LO_BANDS1, title = "Lower", tooltip = "")                                                    
i_sym1Bands1_fill           = input.bool    (group = IG_SYM1_BANDS1, inline = "clrs1", defval = true, title = "Fill", tooltip = "Fill color is only for Bollinger Bands" )                                                    
i_sym1Bands1_fillClr        = input.color   (group = IG_SYM1_BANDS1, inline = "clrs1", defval = CLR_BB_FILL, title = "BB Fill")                                                    
//}


// --- input lblStyle --- {
// //Create the input with pull-down menu
// simple string isym1Bands1_lblStyle = label.style_label_left  
//}

//}

// ▲▲▲ END OF INPUTS BANDS1 ▲▲▲ //}

// ━━━━━━━━━━━━━━━━━━━━━━━━━ BANDS1 - INIT  ━━━━━━━━━━━━━━━━━━━━━━━━━ //{


var sym1Bands1_rsPrms         = loHtfBandsA.newRsParamsBands().init(
// var sym1Bands1_rsPrms         = RsParamsBands.new().init(
                                  bandsType    = isym1Bands1_type
                                  , q1           = isym1Bands1_q1  
                                  , q2           = isym1Bands1_q2  
                                  , q3           = isym1Bands1_q3                        
                                  , vwapAnchor   = i_sym1Bands1_vwapAnchor                        
                                  )



var sym1Bands1 = loHtfBandsB.newHtfBands().init(
// var sym1Bands1 = HtfBands.new().init(
                  bandsType            = isym1Bands1_type      
                  , tf                 = isym1Bands1_tf               
                  , showRecentBars     = i_sym1Bands1_showRecentBars  
                  // , lblsOffset         = i_sym1Bands1_lblsOffset      
                //   , lblsShow           = i_sym1Bands1_lblsShow        
                  , lblsMaxLabels      = i_sym1Bands1_lblsMaxLabels        
                  // , lnOffset        = i_sym1Bands1_lnOffset        
                //   , lblSize            = isym1Bands1_lblSize         
                //   , lblStyle           = isym1Bands1_lblStyle        
                  , lnMidClr           = i_sym1Bands1_lnMidClr         
                  , lnUpClr            = i_sym1Bands1_lnUpClr         
                  , lnLoClr            = i_sym1Bands1_lnLoClr         
                  , fillClr            = i_sym1Bands1_fillClr         
                  , fill               = i_sym1Bands1_fill         
                  , lnWidth            = i_sym1Bands1_lnWidth         
                  , lnSmoothen         = i_sym1Bands1_lnSmoothen         
                  )



// ▲▲▲ END OF INIT - BANDS1 ▲▲▲ //}

// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF BANDS1 INPUT AND INIT   ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ }

// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓       BANDS2 INPUT AND INIT        ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

// ━━━━━━━━━━━━━━━━━━━━━━━━━ BANDS2 - INPUT ━━━━━━━━━━━━━━━━━━━━━━━━━ //{

// --- CONSTANT COLORS --- {
const color CLR_MID_BANDS2                     = color.rgb(244, 243, 243)
const color CLR_UP_BANDS2                     = color.rgb(246, 63, 54)
const color CLR_LO_BANDS2                     = color.rgb(49, 161, 66, 18)
//}


// --- band's calc params ---{
i_sym1Bands2_type     = input.enum        (display = display.none, group=IG_SYM1_BANDS2,   inline="1", defval = BandTypes_none,  title="Type")
i_sym1Bands2_tf       = input.timeframe   (display = display.none, group=IG_SYM1_BANDS2,   inline="1", defval = "60",   title='Timeframe')
i_sym1Bands2_showSmallerTFs     = input.bool    (group = IG_SYM1_BANDS2, inline= "1", defval = true, title = "Plot smaller TF's", tooltip = "If checked all bands of smaller timeframes will be shown on higher timeframes (e.g. 1H EMA on a daily chart)")                    
isym1Bands2_type      = i_bands_enableAll and (i_sym1Bands2_type != BandTypes_none)  and ( (timeframe.in_seconds(i_sym1Bands2_tf) >= timeframe.in_seconds(timeframe.period)) or i_sym1Bands2_showSmallerTFs ) ? i_sym1Bands2_type : BandTypes_none
// for req.sec(): added 1D-->D and 1W --> W conversion (i_tf1 --> var itf1) (strange that input.timeframe returns "1D" and "1W")
simple string isym1Bands2_tf = i_sym1Bands2_tf == "1D" ? "D" : (i_sym1Bands2_tf == "1W" ? "W" : (i_sym1Bands2_tf == "1M" ? "M" : i_sym1Bands2_tf))


i_sym1Bands2_q1       = input.float       (display = display.none, group=IG_SYM1_BANDS2,   inline="2", defval = 0,   title='Q1')
i_sym1Bands2_q2       = input.float       (display = display.none, group=IG_SYM1_BANDS2,   inline="2", defval = 0,   title='Q2')
i_sym1Bands2_q3       = input.float       (display = display.none, group=IG_SYM1_BANDS2,   inline="2", defval = 0,   title='Q3', tooltip = TT_BANDS_Q)

// i_sym1Bands2_vwapSrc        = input.source      (display = display.none, group=IG_SYM1_BANDS2,   inline="VWAP", defval = Source.def,   title='Source', tooltip = TT_BANDS_SOURCE)
i_sym1Bands2_vwapAnchor = input.enum        (display = display.none, group=IG_SYM1_BANDS2,   inline="VWAP", defval = VwapAnchors_S,   title='VWAP anchor', tooltip = TT_BANDS_VWAP_ANCHOR)

var float isym1Bands2_q1 = if i_sym1Bands2_q1 != 0 
    i_sym1Bands2_q1  
else 
    switch i_sym1Bands2_type 
        BandTypes_BB      => 20
        BandTypes_SAR     => 0.02
        BandTypes_ST      => 10
        BandTypes_VWAP    => 1
        BandTypes_none    => 0

var float isym1Bands2_q2 = if i_sym1Bands2_q2 != 0 
    i_sym1Bands2_q2  
else 
    switch i_sym1Bands2_type 
        BandTypes_BB      => 2
        BandTypes_SAR     => 0.02
        BandTypes_ST      => 3
        BandTypes_VWAP    => 0
        BandTypes_none    => 0

var float isym1Bands2_q3 = if i_sym1Bands2_q3 != 0 
    i_sym1Bands2_q3  
else 
    switch i_sym1Bands2_type 
        BandTypes_BB      => 0
        BandTypes_SAR     => 0.2
        BandTypes_ST      => 0
        BandTypes_VWAP    => 0
        BandTypes_none    => 0
//}

// --- bands' visualisation params ---{

i_sym1Bands2_showRecentBars     = input.int    (group = IG_SYM1_BANDS1, inline= "1", defval = 100000, title = "Back to, bars", tooltip = "Only plot on recent bars.")                    

// --- LABELS --- {
// i_sym1Bands2_lblsShow           = input.bool    (group = IG_SYM1_BANDS2, inline = "lbls1", defval = true, title = "Show labels", tooltip = "")                    
i_sym1Bands2_lblsMaxLabels      = input.int    (group = IG_SYM1_BANDS2, inline = "lbls1", defval = 100, title = "Max lbls", tooltip = TT_BANDS_MAX_LABELS)                    

// --- input lblSize --- {
i_sym1Bands2_lblSize         = input.string  (group = IG_SYM1_BANDS2, inline = "lbls1", defval = "Normal", title="Size", options= ["Auto", "Tiny", "Small", "Normal", "Large", "Huge"])

//Turn the input into a proper label size value
simple string isym1Bands2_lblSize =        (i_sym1Bands2_lblSize == "Auto")    ? size.auto  :
                              (i_sym1Bands2_lblSize == "Tiny")    ? size.tiny  :
                              (i_sym1Bands2_lblSize == "Small")   ? size.small :
                              (i_sym1Bands2_lblSize == "Normal")  ? size.normal:
                              (i_sym1Bands2_lblSize == "Large")   ? size.large :
                              (i_sym1Bands2_lblSize == "Huge")    ? size.huge  :
                              size.normal

// END OF lblSize input }

//}



// --- LINES ---  {
i_sym1Bands2_lnWidth        = input.int     (group = IG_SYM1_BANDS2, inline = "lnWS", defval = 1, title = "Line width", tooltip = "")                                                    
i_sym1Bands2_offset         = input.int     (group = IG_SYM1_BANDS2, inline = "lnWS", defval = 0, title = "Offset", tooltip = TT_BANDS_OFFSET)                                                    
i_sym1Bands2_lnSmoothen     = input.bool    (group = IG_SYM1_BANDS2, inline = "lnWS", defval = false, title = "Smoothen", tooltip = TT_BANDS_SMOOTHEN)                                                    
i_sym1Bands2_lnMidClr       = input.color   (group = IG_SYM1_BANDS2, inline = "clrs", defval = CLR_MID_BANDS2, title = "Midle", tooltip = "")                                                    
i_sym1Bands2_lnUpClr        = input.color   (group = IG_SYM1_BANDS2, inline = "clrs", defval = CLR_UP_BANDS2, title = "Upper", tooltip = "")                                                    
i_sym1Bands2_lnLoClr        = input.color   (group = IG_SYM1_BANDS2, inline = "clrs", defval = CLR_LO_BANDS2, title = "Lower", tooltip = "")                                                    
i_sym1Bands2_fillClr        = input.color   (group = IG_SYM1_BANDS2, inline = "clrs", defval = CLR_BB_FILL, title = "BB Fill")                                                    
i_sym1Bands2_fill           = input.bool    (group = IG_SYM1_BANDS2, inline = "clrs", defval = true, title = "Fill", tooltip = "Fill color is only for Bollinger Bands" )                                                    
//}


// --- input lblStyle --- {
// //Create the input with pull-down menu
simple string isym1Bands2_lblStyle = label.style_label_left  
//}

//}

// ▲▲▲ END OF INPUTS BANDS2 ▲▲▲ //}

// ━━━━━━━━━━━━━━━━━━━━━━━━━ BANDS2 - INIT  ━━━━━━━━━━━━━━━━━━━━━━━━━ //{


var sym1Bands2_rsPrms         = loHtfBandsA.newRsParamsBands().init(
                                  bandsType    = isym1Bands2_type
                                  , q1           = isym1Bands2_q1  
                                  , q2           = isym1Bands2_q2  
                                  , q3           = isym1Bands2_q3                        
                                  , vwapAnchor           = i_sym1Bands2_vwapAnchor                        
                                  )



var sym1Bands2 = loHtfBandsB.newHtfBands().init(
                  bandsType            = isym1Bands2_type      
                  , tf                 = isym1Bands2_tf               
                  , showRecentBars     = i_sym1Bands2_showRecentBars  
                  // , lblsOffset         = i_sym1Bands2_lblsOffset      
                //   , lblsShow           = i_sym1Bands2_lblsShow        
                  , lblsMaxLabels      = i_sym1Bands2_lblsMaxLabels        
                  // , lnOffset        = i_sym1Bands2_lnOffset        
                  , lblSize            = isym1Bands2_lblSize         
                //   , lblStyle           = isym1Bands2_lblStyle        
                  , lnMidClr           = i_sym1Bands2_lnMidClr         
                  , lnUpClr            = i_sym1Bands2_lnUpClr         
                  , lnLoClr            = i_sym1Bands2_lnLoClr         
                  , lnWidth            = i_sym1Bands2_lnWidth   
                  , lnSmoothen         = i_sym1Bands1_lnSmoothen         
                  )



// ▲▲▲ END OF INIT - BANDS2 ▲▲▲ //}

// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF BANDS2 INPUT AND INIT   ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ }

// ┃                 END OF USER INPUT AND INIT                                    ┃ }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                                MAIN                                          ║ {


// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ BANDS1 ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

// ━━━━━━ REQUEST.SECURITY() ━━━━━━ {
[bands1bi, bands1m, bands1u, bands1l, bands1d] = request.security(syminfo.tickerid, isym1Bands1_tf, sym1Bands1_rsPrms.htfUpdateTuple(i_bands_repaint), lookahead = i_bands_lookahead ? barmerge.lookahead_on : barmerge.lookahead_off )
// smoothen (used to be in a function, but functions eat memory, had to move here)
if i_sym1Bands1_lnSmoothen and ta.change(bands1bi) == 0 
    bands1m := na, bands1u := na, bands1l := na, bands1d := na
sym1Bands1.importRsRetTuple(bands1bi, bands1m, bands1u, bands1l, bands1d)
// ▲▲▲ END OF REQ.SEC() ▲▲▲}

// ━━━━━━ PLOT Bands ━━━━━━ {
pBands1_upBand = plot(sym1Bands1.drw.showHistory 
      ? sym1Bands1.rsRet.upBand : na
          , title           =  "Bands1_upper"
          // , color           =  CLR_BANDS_UP // i_sym1Bands1_lnUpClr
          , color           =   i_sym1Bands1_lnUpClr
          , linewidth       =  i_sym1Bands1_lnWidth 
          , style           = plot.style_steplinebr  // isym1Bands1_lnStyle
          , show_last       = i_sym1Bands1_showRecentBars
          , display         = display.data_window  + display.pane
          , offset          = i_sym1Bands1_offset
          )

pBands1_loBand = plot(sym1Bands1.drw.showHistory 
      ? sym1Bands1.rsRet.loBand : na
          , title           =  "Bands1_lower"
          , color           = i_sym1Bands1_lnLoClr
          , linewidth       = i_sym1Bands1_lnWidth 
          , style           = plot.style_steplinebr  // isym1Bands1_lnStyle
          , show_last       = i_sym1Bands1_showRecentBars
          , display         = display.data_window + display.pane
          , offset          = i_sym1Bands1_offset
          )

pBands1_midBand = plot(sym1Bands1.drw.showHistory  
      ? sym1Bands1.rsRet.midBand : na
          , title           =  "Bands1_middle"
          , color           = (sym1Bands1_rsPrms.bandsType  == BandTypes_BB or sym1Bands1_rsPrms.bandsType  == BandTypes_VWAP) ? i_sym1Bands1_lnMidClr : CLR_TRANSP
          , linewidth       = i_sym1Bands1_lnWidth 
          , style           = plot.style_steplinebr  // isym1Bands1_lnStyle
          , show_last       = i_sym1Bands1_showRecentBars
          , display         = display.data_window + display.pane
          , offset          = i_sym1Bands1_offset
          )




fill(pBands1_midBand, pBands1_upBand, sym1Bands1.drw.fillUpClr, fillgaps = false, show_last = i_sym1Bands1_showRecentBars)
fill(pBands1_midBand, pBands1_loBand, sym1Bands1.drw.fillLoClr, fillgaps = false, show_last = i_sym1Bands1_showRecentBars)

//  ▲▲▲ END OF PLOT Bands ▲▲▲ } 

// ━━━━━━ DRAW LINES & LABELS ━━━━━━ {
sym1Bands1.addUpdDrawings(sym1Bands1_rsPrms)
// ▲▲▲ END OF DRAW LABELS ▲▲▲}


// END OF BANDS1 } 


// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ BANDS2 ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

// ━━━━━━ REQUEST.SECURITY() ━━━━━━ {
[bands2bi, bands2m, bands2u, bands2l, bands2d] = request.security(syminfo.tickerid, isym1Bands2_tf, sym1Bands2_rsPrms.htfUpdateTuple(i_bands_repaint), lookahead = i_bands_lookahead ? barmerge.lookahead_on : barmerge.lookahead_off )
// smoothen (used to be in a function, but functions eat memory, had to move here)
if i_sym1Bands2_lnSmoothen and ta.change(bands2bi) == 0 
    bands2m := na, bands2u := na, bands2l := na, bands2d := na
sym1Bands2.importRsRetTuple(bands2bi, bands2m, bands2u, bands2l, bands2d)
// ▲▲▲ END OF REQ.SEC() ▲▲▲}

// ━━━━━━ PLOT Bands ━━━━━━ {
pBands2_upBand = plot(sym1Bands2.drw.showHistory 
      ? sym1Bands2.rsRet.upBand : na
          , title           =  "Bands2_upper"
          // , color           =  CLR_BANDS_UP // i_sym1Bands2_lnUpClr
          , color           =   i_sym1Bands2_lnUpClr
          , linewidth       =  i_sym1Bands2_lnWidth 
          , style           = plot.style_steplinebr  // isym1Bands2_lnStyle
          , show_last       = i_sym1Bands2_showRecentBars
          , display         = display.data_window  + display.pane
          , offset          = i_sym1Bands2_offset
          )

pBands2_loBand = plot(sym1Bands2.drw.showHistory 
      ? sym1Bands2.rsRet.loBand : na
          , title           =  "Bands2_lower"
          , color           = i_sym1Bands2_lnLoClr
          , linewidth       = i_sym1Bands2_lnWidth 
          , style           = plot.style_steplinebr  // isym1Bands2_lnStyle
          , show_last       = i_sym1Bands2_showRecentBars
          , display         = display.data_window + display.pane
          , offset          = i_sym1Bands2_offset
          )

pBands2_midBand = plot(sym1Bands2.drw.showHistory  
      ? sym1Bands2.rsRet.midBand : na
          , title           =  "Bands2_middle"
          , color           = (sym1Bands2_rsPrms.bandsType  == BandTypes_BB or sym1Bands2_rsPrms.bandsType  == BandTypes_VWAP) ? i_sym1Bands2_lnMidClr : CLR_TRANSP
          , linewidth       = i_sym1Bands2_lnWidth 
          , style           = plot.style_steplinebr  // isym1Bands2_lnStyle
          , show_last       = i_sym1Bands2_showRecentBars
          , display         = display.data_window + display.pane
          , offset          = i_sym1Bands2_offset
          )




fill(pBands1_midBand, pBands1_upBand, sym1Bands2.drw.fillUpClr, fillgaps = false, show_last = i_sym1Bands1_showRecentBars)
fill(pBands1_midBand, pBands1_loBand, sym1Bands2.drw.fillLoClr, fillgaps = false, show_last = i_sym1Bands1_showRecentBars)

// fill(pBands2_midBand, pBands2_upBand, not(i_sym1Bands2_fill) ? CLR_TRANSP : sym1Bands2_rsPrms.bandsType  == BandTypes_BB ? CLR_BB_FILL : sym1Bands2_rsPrms.bandsType  == BandTypes_ST ? i_sym1Bands2_lnUpClr.fade(90) : CLR_TRANSP, fillgaps = false, show_last = i_sym1Bands2_showRecentBars)
// fill(pBands2_midBand, pBands2_loBand, not(i_sym1Bands2_fill) ? CLR_TRANSP : sym1Bands2_rsPrms.bandsType  == BandTypes_BB ? CLR_BB_FILL : sym1Bands2_rsPrms.bandsType  == BandTypes_ST ? i_sym1Bands2_lnLoClr.fade(90) : CLR_TRANSP, fillgaps = false, show_last = i_sym1Bands2_showRecentBars)

//  ▲▲▲ END OF PLOT Bands ▲▲▲ } 

// ━━━━━━ DRAW LINES & LABELS ━━━━━━ {
sym1Bands2.addUpdDrawings(sym1Bands2_rsPrms)
// ▲▲▲ END OF DRAW LABELS ▲▲▲}


// END OF BANDS2 } 


// ║                 END OF MAIN                                                  ║ }
