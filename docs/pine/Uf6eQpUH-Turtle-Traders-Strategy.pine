//@version=6
strategy("Turtle Traders Strategy", overlay=true, initial_capital=100000, pyramiding=0, default_qty_type=strategy.fixed)

// === Inputs ===
entryLen = input.int(20, "Entry breakout length", options=[20, 55])
exitLen  = input.int(10, "Exit breakout length", options=[10, 20])

atrLen   = input.int(20, "ATR length")
riskPct  = input.float(2.0, "Risk per trade (%)", step=0.1)
stopATR  = input.float(2.0, "Stop loss ATR multiple", step=0.1)

useDaily = input.bool(true, "Use daily breakout levels")

// === Donchian Breakout Levels ===
entryHigh = useDaily ? request.security(syminfo.tickerid, "D", ta.highest(high, entryLen)[1]) : ta.highest(high, entryLen)[1]
entryLow  = useDaily ? request.security(syminfo.tickerid, "D", ta.lowest(low, entryLen)[1]) : ta.lowest(low, entryLen)[1]

exitHigh = useDaily ? request.security(syminfo.tickerid, "D", ta.highest(high, exitLen)[1]) : ta.highest(high, exitLen)[1]
exitLow  = useDaily ? request.security(syminfo.tickerid, "D", ta.lowest(low, exitLen)[1]) : ta.lowest(low, exitLen)[1]

// === ATR Volatility ===
atr = useDaily ? request.security(syminfo.tickerid, "D", ta.atr(atrLen)) : ta.atr(atrLen)

// === Risk-Based Position Sizing ===
capital  = strategy.equity
riskCash = capital * riskPct / 100

riskPerUnit = atr * stopATR * syminfo.pointvalue
qty = riskPerUnit > 0 ? riskCash / riskPerUnit : na

// === Entry Conditions ===
longEntry  = high > entryHigh
shortEntry = low < entryLow

// === Exit Conditions ===
longExit  = low < exitLow
shortExit = high > exitHigh

// === Stop-Loss Levels ===
longStop  = strategy.position_avg_price - atr * stopATR
shortStop = strategy.position_avg_price + atr * stopATR

// === Orders ===
if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, qty=qty)

if shortEntry and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, qty=qty)

if strategy.position_size > 0
    strategy.exit("Long Stop", from_entry="Long", stop=longStop)

if strategy.position_size < 0
    strategy.exit("Short Stop", from_entry="Short", stop=shortStop)

if longExit and strategy.position_size > 0
    strategy.close("Long", comment="Long Exit Breakout")

if shortExit and strategy.position_size < 0
    strategy.close("Short", comment="Short Exit Breakout")

// === Plots ===
plot(entryHigh, "Entry High", color=color.green)
plot(entryLow, "Entry Low", color=color.red)

plot(exitHigh, "Exit High", color=color.new(color.green, 60))
plot(exitLow, "Exit Low", color=color.new(color.red, 60))

plot(strategy.position_size > 0 ? longStop : na, "Long Stop", color=color.orange, style=plot.style_linebr)
plot(strategy.position_size < 0 ? shortStop : na, "Short Stop", color=color.orange, style=plot.style_linebr)