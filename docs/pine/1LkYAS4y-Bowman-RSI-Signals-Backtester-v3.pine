//@version=6
strategy("Bowman RSI Signals Backtester v3", overlay=true, initial_capital=25000, default_qty_type=strategy.percent_of_equity, default_qty_value=25)

//#region Inputs
rsiLength = input.int(7, "RSI Length", minval=1)
divLookback = input.int(2, "Div Lookback", minval=1)
htfTf = input.timeframe("1D", "HTF TF")
htfRsiLength = input.int(5, "HTF RSI Length", minval=1)
htfRsiCutoff = input.int(40, "HTF RSI Cutoff", minval=1, maxval=100)
useEmaFilter = input.bool(true, "EMA Filter")
emaTf = input.timeframe("240", "EMA TF")
emaLength = input.int(200, "EMA Length", minval=1)
exit_mode = input.string("ATR Trailing Stop", "Exit Strategy", options=["ATR Trailing Stop", "Bear Div & Pivot High", "Pivot High Only", "Fixed Percentages"])
atrLength = input.int(14, "ATR Length", minval=1)
atrMult = input.float(3.0, "ATR Mult", minval=0.1, step=0.1)
//#endregion

//#region Core
rsi = ta.rsi(close, rsiLength)
htfRsi = request.security(syminfo.tickerid, htfTf, ta.rsi(close, htfRsiLength))
ema = request.security(syminfo.tickerid, emaTf, ta.ema(close, emaLength))
atr = ta.atr(atrLength)

// Wire divLookback into pivot detection (was hardcoded 2)
pivotL = divLookback
pivotR = divLookback
pivoth = not na(ta.pivothigh(high, pivotL, pivotR))

// Bearish divergence: price higher high with RSI lower high (overbought)
bearDiv = close > close[divLookback] and rsi < rsi[divLookback] and rsi > 70

longCondition = ta.crossover(rsi, 30) and htfRsi < htfRsiCutoff and (not useEmaFilter or close > ema)
if longCondition
    strategy.entry("Long Bottom", strategy.long)
//#endregion

//#region Exits
if exit_mode == "ATR Trailing Stop"
    strategy.exit("ATR Exit", "Long Bottom", trail_points=atr * atrMult / syminfo.mintick, trail_offset=atr * atrMult / syminfo.mintick)
else if exit_mode == "Bear Div & Pivot High"
    if bearDiv and pivoth
        strategy.close("Long Bottom", comment="Bear Div Pivot Exit")
else if exit_mode == "Pivot High Only"
    if pivoth
        strategy.close("Long Bottom", comment="Pivot High Exit")
else if exit_mode == "Fixed Percentages"
    strategy.exit("Fixed Exit", "Long Bottom", profit=2, loss=1)
//#endregion