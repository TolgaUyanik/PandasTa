//@version=5
indicator("MJBFX-Strategy (Futures Optimized)", overlay=true, max_bars_back=500)

// =====================
// Brand Colours
// =====================
colOrange = color.rgb(255,128,0)   // MJB-FX Orange
colGrey   = color.rgb(200,200,200) // Light Grey
colGreen  = color.rgb(0,180,0)
colRed    = color.rgb(200,0,0)

// =====================
// Session Times (Auto, UK Time GMT+1)
// =====================
var int asianStartHour = 23
var int asianStartMin = 0
var int asianEndHour = 6
var int asianEndMin = 59
var int londonOpenHour = 8
var int londonOpenMin = 0
var int londonKillStartHour = 7
var int londonKillEndHour = 10
var int nyKillStartHour = 13
var int nyKillEndHour = 16

sessYear = year
sessMonth = month
sessDay = dayofmonth

var int asianStartTS = na
var int asianEndTS = na
var int londonOpenTS = na
var int londonKillStartTS = na
var int londonKillEndTS = na
var int nyKillStartTS = na
var int nyKillEndTS = na

if (hour < 7)
    asianStartTS := timestamp("GMT+1", year, month, dayofmonth - 1, asianStartHour, asianStartMin)
    asianEndTS := timestamp("GMT+1", year, month, dayofmonth, asianEndHour, asianEndMin)
    londonOpenTS := timestamp("GMT+1", year, month, dayofmonth, londonOpenHour, londonOpenMin)
    londonKillStartTS := timestamp("GMT+1", year, month, dayofmonth, londonKillStartHour, 0)
    londonKillEndTS := timestamp("GMT+1", year, month, dayofmonth, londonKillEndHour, 0)
    nyKillStartTS := timestamp("GMT+1", year, month, dayofmonth, nyKillStartHour, 0)
    nyKillEndTS := timestamp("GMT+1", year, month, dayofmonth, nyKillEndHour, 0)
else
    asianStartTS := timestamp("GMT+1", year, month, dayofmonth, asianStartHour, asianStartMin)
    asianEndTS := timestamp("GMT+1", year, month, dayofmonth + 1, asianEndHour, asianEndMin)
    londonOpenTS := timestamp("GMT+1", year, month, dayofmonth + 1, londonOpenHour, londonOpenMin)
    londonKillStartTS := timestamp("GMT+1", year, month, dayofmonth + 1, londonKillStartHour, 0)
    londonKillEndTS := timestamp("GMT+1", year, month, dayofmonth + 1, londonKillEndHour, 0)
    nyKillStartTS := timestamp("GMT+1", year, month, dayofmonth + 1, nyKillStartHour, 0)
    nyKillEndTS := timestamp("GMT+1", year, month, dayofmonth + 1, nyKillEndHour, 0)

// =====================
// Previous Asian Session High/Low + VWAP Calculation
// =====================
var float asianHigh = na
var float asianLow = na
var float asianOpen = na
var float asianClose = na

var float tpv = 0.0
var float vol = 0.0

inAsian = (time >= asianStartTS) and (time <= asianEndTS)

if barstate.isnew
    if time == asianStartTS
        asianHigh := high
        asianLow := low
        asianOpen := open
        asianClose := na
        tpv := 0
        vol := 0
    if inAsian
        asianHigh := math.max(na(asianHigh) ? high : asianHigh, high)
        asianLow := math.min(na(asianLow) ? low : asianLow, low)
        asianClose := close
        tpv += (high + low + close) / 3 * volume
        vol += volume

asianVWAP = vol > 0 ? tpv / vol : na

// =====================
// Asian Session Range Box (fixed until London open)
// =====================
var box asianBox = na
if barstate.isnew
    if time == asianEndTS
        asianBox := box.new(left=bar_index, top=asianHigh, bottom=asianLow, right=bar_index, bgcolor=color.new(colGrey, 60), border_color=color.new(colGrey, 0))

if not na(asianBox)
    if time <= londonOpenTS
        box.set_right(asianBox, bar_index)
        box.set_top(asianBox, asianHigh)
        box.set_bottom(asianBox, asianLow)
    else
        box.delete(asianBox)
        asianBox := na

// =====================
// Plot Asian VWAP Line
// =====================
plot(asianVWAP, title="Asian VWAP", color=colOrange, linewidth=2)

// =====================
// Sweep Optimization - only show on 30m, 1h, 4h
// =====================
sweepTF = (timeframe.period == "30" or timeframe.period == "60" or timeframe.period == "240")

sweepThresholdTicks = 5
sweepThreshold = sweepThresholdTicks * syminfo.mintick

sweepHigh = sweepTF and not na(asianHigh) and (high - asianHigh) > sweepThreshold and close < asianHigh
sweepLow = sweepTF and not na(asianLow) and (asianLow - low) > sweepThreshold and close > asianLow

plotshape(sweepHigh, title="Sweep High", style=shape.labeldown, location=location.abovebar, 
          color=colOrange, text="Sweep", textcolor=color.white, size=size.tiny)
plotshape(sweepLow, title="Sweep Low", style=shape.labelup, location=location.belowbar, 
          color=colGrey, text="Sweep", textcolor=color.black, size=size.tiny)

// =====================
// Confirmation Highlight
// =====================
confirmHigh = sweepHigh and close < asianHigh
confirmLow = sweepLow and close > asianLow
barcolor(confirmHigh ? colRed : confirmLow ? colGreen : na)

// =====================
// Futures/FX Adaptive Stop & Target (Auto Risk Box)
// =====================
ticksSL = 10  // 10 ticks stop loss
slSize = ticksSL * syminfo.mintick

var line slLine = na
var line tpLine = na
var box tradeBox = na
if not na(slLine)
    line.delete(slLine)
if not na(tpLine)
    line.delete(tpLine)
if not na(tradeBox)
    box.delete(tradeBox)

if confirmHigh
    slPrice = high + slSize
    tpPrice = close - (slSize * 2) // 2R target
    slLine := line.new(bar_index, slPrice, bar_index + 20, slPrice, color=colRed, extend=extend.right)
    tpLine := line.new(bar_index, tpPrice, bar_index + 20, tpPrice, color=colGreen, extend=extend.right)
    tradeBox := box.new(bar_index, slPrice, bar_index + 20, tpPrice, bgcolor=color.new(colRed, 60))

if confirmLow
    slPrice = low - slSize
    tpPrice = close + (slSize * 2) // 2R target
    slLine := line.new(bar_index, slPrice, bar_index + 20, slPrice, color=colRed, extend=extend.right)
    tpLine := line.new(bar_index, tpPrice, bar_index + 20, tpPrice, color=colGreen, extend=extend.right)
    tradeBox := box.new(bar_index, slPrice, bar_index + 20, tpPrice, bgcolor=color.new(colGreen, 60))

// =====================
// Fibonacci Retracement Zone (38.2% - 61.8%) of Asian Range
// =====================
fibRange = asianHigh - asianLow
bullish = asianClose > asianOpen

fibTop = bullish ? asianLow + fibRange * 0.618 : asianHigh - fibRange * 0.382
fibBot = bullish ? asianLow + fibRange * 0.382 : asianHigh - fibRange * 0.618

var line fibTopLine = na
var line fibBotLine = na
var box fibFillBox = na

if barstate.isnew
    if not na(fibTopLine)
        line.delete(fibTopLine)
    if not na(fibBotLine)
        line.delete(fibBotLine)
    if not na(fibFillBox)
        box.delete(fibFillBox)
    fibTopLine := line.new(bar_index, fibTop, bar_index + 20, fibTop, extend=extend.right, color=color.new(colOrange, 0), style=line.style_dashed)
    fibBotLine := line.new(bar_index, fibBot, bar_index + 20, fibBot, extend=extend.right, color=color.new(colOrange, 0), style=line.style_dashed)
    fibFillBox := box.new(bar_index, fibTop, bar_index + 20, fibBot, bgcolor=color.new(colOrange, 60))

// =====================
// Killzones Background (London & NY)
// =====================
bgcolor(time >= londonKillStartTS and time <= londonKillEndTS ? color.new(colOrange, 85) : na)
bgcolor(time >= nyKillStartTS and time <= nyKillEndTS ? color.new(colGrey, 85) : na)
