//@version=6
indicator("9/21 EMA + 50 SMA + MACD (Source: 9 EMA) + Bull/Bear Candles", overlay=false)

// -----------------------------------------------------------------------------
// SECTION 1: TREND INDICATORS (MAIN CHART)
// -----------------------------------------------------------------------------
ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
sma50 = ta.sma(close, 50)

plot(ema9,  title="9 EMA",  color=color.blue,   linewidth=2, force_overlay=true)
plot(ema21, title="21 EMA", color=color.red,    linewidth=2, force_overlay=true)
plot(sma50, title="50 SMA", color=color.orange, linewidth=2, force_overlay=true)

// -----------------------------------------------------------------------------
// SECTION 1B: BULL/BEAR LOGIC + CANDLE COLOURS
// -----------------------------------------------------------------------------
isBull    = (ema9 > ema21) and (close > sma50)
isBear    = (ema9 < ema21) and (close < sma50)
isNeutral = not isBull and not isBear

candleCol = isBull ? color.lime : isBear ? color.red : color.blue

plotcandle(open, high, low, close,
     title="Trend Candles",
     color=candleCol,
     wickcolor=candleCol,
     bordercolor=candleCol,
     force_overlay=true)

// Mark regime flips
bullFlip = isBull and not isBull[1]
bearFlip = isBear and not isBear[1]

if bullFlip
    label.new(bar_index, high, "Bull", style=label.style_label_up,
      textcolor=color.white, color=color.new(color.lime, 0), force_overlay=true)

if bearFlip
    label.new(bar_index, low, "Bear", style=label.style_label_down,
      textcolor=color.white, color=color.new(color.red, 0), force_overlay=true)

// -----------------------------------------------------------------------------
// SECTION 2: MACD (SEPARATE PANE)
// -----------------------------------------------------------------------------
macdSource = ema9

fastLength   = 12
slowLength   = 26
signalLength = 9

fastMA = ta.ema(macdSource, fastLength)
slowMA = ta.ema(macdSource, slowLength)

macdLine   = fastMA - slowMA
signalLine = ta.ema(macdLine, signalLength)
hist       = macdLine - signalLine

plot(macdLine,   title="MACD Line (12)",   color=color.blue, linewidth=1)
plot(signalLine, title="Signal Line (26)", color=color.red,  linewidth=1)
plot(hist,
     title="Histogram",
     style=plot.style_histogram,
     linewidth=6,
     color = hist >= 0 ? color.new(color.green, 40) : color.new(color.red, 40))