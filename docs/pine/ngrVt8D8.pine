//@version=6
strategy("Stratégie Bougies Englobantes - Multi-Filtres", overlay=true, margin_long=100, margin_short=100, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ========== PARAMÈTRES PRINCIPAUX ==========
riskRewardRatio = input.float(2.0, title="Ratio Risque/Récompense (RR)", minval=0.5, maxval=10.0, step=0.5, tooltip="Exemple: 2 = RR 1:2")
useFixedSL = input.bool(false, title="Utiliser un SL fixe (points/pips)")
fixedSLPoints = input.int(50, title="SL fixe en points", minval=10, step=10)

// ========== FILTRE DE TENDANCE ==========
useTrendFilter = input.bool(true, title="🔵 Activer filtre de tendance")
trendLength = input.int(20, title="   Période EMA", minval=10, maxval=200, step=5)
trendType = input.string("EMA", title="   Type de tendance", options=["EMA", "SMA", "HMA"])
trendStrength = input.bool(false, title="   Exiger tendance forte (prix > EMA * 1.01)")

// Calcul de la tendance
var float trendLine = na
if trendType == "EMA"
    trendLine := ta.ema(close, trendLength)
else if trendType == "SMA"
    trendLine := ta.sma(close, trendLength)
else if trendType == "HMA"
    trendLine := ta.hma(close, trendLength)

// Déclaration des variables de tendance
bool uptrend = false
bool downtrend = false

if trendStrength
    uptrend := close > trendLine * 1.01
    downtrend := close < trendLine * 0.99
else
    uptrend := close > trendLine
    downtrend := close < trendLine

// ========== FILTRE DE MOMENTUM ==========
useMomentumFilter = input.bool(true, title="🟠 Activer filtre de momentum")
momentumType = input.string("RSI", title="   Type de momentum", options=["RSI", "MACD", "Stochastique", "CCI"])
// Paramètres RSI
rsiLength = input.int(14, title="   RSI - Période", minval=7, maxval=50, step=1)
rsiOversold = input.int(30, title="   RSI - Seuil survente (<)", minval=20, maxval=80, step=5)
rsiOverbought = input.int(70, title="   RSI - Seuil surachat (>", minval=20, maxval=80, step=5)
// Paramètres MACD
macdFast = input.int(12, title="   MACD - Fast", minval=5, maxval=20)
macdSlow = input.int(26, title="   MACD - Slow", minval=15, maxval=40)
macdSignal = input.int(9, title="   MACD - Signal", minval=5, maxval=15)
// Paramètres Stochastique
stochK = input.int(14, title="   Stoch - %K", minval=7, maxval=21)
stochD = input.int(3, title="   Stoch - %D", minval=2, maxval=7)
stochOversold = input.int(20, title="   Stoch - Seuil survente (<)", minval=10, maxval=40)
stochOverbought = input.int(80, title="   Stoch - Seuil surachat (>", minval=60, maxval=90)
// Paramètres CCI
cciLength = input.int(20, title="   CCI - Période", minval=10, maxval=50)
cciOverbought = input.int(100, title="   CCI - Seuil surachat (>", minval=50, maxval=200)
cciOversold = input.int(-100, title="   CCI - Seuil survente (<", minval=-200, maxval=-50)

// Calcul des indicateurs de momentum
// RSI
rsiValue = ta.rsi(close, rsiLength)
bullishRSI = rsiValue < rsiOversold
bearishRSI = rsiValue > rsiOverbought

// MACD
[macdLine, signalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
bullishMACD = macdLine > signalLine and macdHist > 0
bearishMACD = macdLine < signalLine and macdHist < 0

// Stochastique
stochKValue = ta.stoch(close, high, low, stochK)
stochDValue = ta.sma(stochKValue, stochD)
bullishStoch = stochKValue < stochOversold and stochDValue < stochOversold
bearishStoch = stochKValue > stochOverbought and stochDValue > stochOverbought

// CCI
cciValue = ta.cci(close, cciLength)
bullishCCI = cciValue < cciOversold
bearishCCI = cciValue > cciOverbought

// Sélection du filtre de momentum actif
bullishMomentum = momentumType == "RSI" ? bullishRSI :
                  momentumType == "MACD" ? bullishMACD :
                  momentumType == "Stochastique" ? bullishStoch :
                  bullishCCI

bearishMomentum = momentumType == "RSI" ? bearishRSI :
                  momentumType == "MACD" ? bearishMACD :
                  momentumType == "Stochastique" ? bearishStoch :
                  bearishCCI

// ========== FILTRE DE VOLUME ==========
useVolumeFilter = input.bool(true, title="🟢 Activer filtre de volume")
volumeType = input.string("Supérieur moyenne", title="   Type de volume", options=["Supérieur moyenne", "Breakout", "Supérieur précédent"])
volumeMultiplier = input.float(1.5, title="   Multiplicateur volume", minval=1.0, maxval=3.0, step=0.1)
avgVolumeLength = input.int(20, title="   Période moyenne volume", minval=10, maxval=50)

avgVolume = ta.sma(volume, avgVolumeLength)

bool highVolume = false
if volumeType == "Supérieur moyenne"
    highVolume := volume > avgVolume * volumeMultiplier
else if volumeType == "Breakout"
    highVolume := volume > avgVolume * volumeMultiplier and volume > volume[1] * 1.2
else // Supérieur précédent
    highVolume := volume > volume[1] * volumeMultiplier

// ========== FILTRES ADDITIONNELS ==========
useATRFilter = input.bool(false, title="🟣 Activer filtre ATR (volatilité)")
atrLength = input.int(14, title="   Période ATR", minval=7, maxval=50)
minATR = input.float(0.5, title="   ATR minimum (%)", minval=0.1, maxval=2.0, step=0.1) / 100
atrValue = ta.atr(atrLength)
sufficientVolatility = atrValue / close > minATR

useTimeFilter = input.bool(false, title="⏰ Activer filtre horaire")
sessionStart = input.int(9, title="   Début session (heure)", minval=0, maxval=23)
sessionEnd = input.int(17, title="   Fin session (heure)", minval=0, maxval=23)
inSession = hour(time) >= sessionStart and hour(time) <= sessionEnd

useConfirmation = input.bool(false, title="📊 Attendre confirmation (1 bougie)")
confirmBullish = useConfirmation ? close[1] > high[2] : true
confirmBearish = useConfirmation ? close[1] < low[2] : true

// ========== CONDITIONS DES BOUGIES ENGLobantes ==========
bearishEngulfing = close < open and high > high[1] and close < low[1]
bullishEngulfing = close > open and low < low[1] and close > high[1]

// ========== APPLICATION DE TOUS LES FILTRES ==========
// Filtre Long (achat)
filterLong = (not useTrendFilter or uptrend) and
             (not useMomentumFilter or bullishMomentum) and
             (not useVolumeFilter or highVolume) and
             (not useATRFilter or sufficientVolatility) and
             (not useTimeFilter or inSession) and
             confirmBullish

// Filtre Short (vente)
filterShort = (not useTrendFilter or downtrend) and
              (not useMomentumFilter or bearishMomentum) and
              (not useVolumeFilter or highVolume) and
              (not useATRFilter or sufficientVolatility) and
              (not useTimeFilter or inSession) and
              confirmBearish

// Signaux finaux
signalBullish = bullishEngulfing and strategy.position_size == 0 and filterLong
signalBearish = bearishEngulfing and strategy.position_size == 0 and filterShort

// ========== GESTION DES POSITIONS LONGUES ==========
var float longSL = na
var float longTP = na

if signalBullish
    if useFixedSL
        longSL := close - (fixedSLPoints * syminfo.mintick)
    else
        longSL := low
    
    longTP := close + (close - longSL) * riskRewardRatio
    
    strategy.entry("Long", strategy.long)
    strategy.exit("Long TP/SL", "Long", stop=longSL, limit=longTP)
    
    label.new(bar_index, low, text="BUY\nSL: " + str.tostring(longSL, "#.##") + "\nTP: " + str.tostring(longTP, "#.##") + "\nRR: 1:" + str.tostring(riskRewardRatio), 
              color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up)

// ========== GESTION DES POSITIONS COURTES ==========
var float shortSL = na
var float shortTP = na

if signalBearish
    if useFixedSL
        shortSL := close + (fixedSLPoints * syminfo.mintick)
    else
        shortSL := high
    
    shortTP := close - (shortSL - close) * riskRewardRatio
    
    strategy.entry("Short", strategy.short)
    strategy.exit("Short TP/SL", "Short", stop=shortSL, limit=shortTP)
    
    label.new(bar_index, high, text="SELL\nSL: " + str.tostring(shortSL, "#.##") + "\nTP: " + str.tostring(shortTP, "#.##") + "\nRR: 1:" + str.tostring(riskRewardRatio), 
              color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_down)

// ========== AFFICHAGE DES SIGNAUX ==========
plotshape(signalBullish, title="Signal Achat", style=shape.triangleup, location=location.belowbar, 
          color=color.new(color.green, 0), size=size.small)
plotshape(signalBearish, title="Signal Vente", style=shape.triangledown, location=location.abovebar, 
          color=color.new(color.red, 0), size=size.small)

// Ligne de tendance
plot(useTrendFilter ? trendLine : na, title="Tendance", color=color.new(color.blue, 0), linewidth=2)

// Indicateur de zone
bgcolor(strategy.position_size > 0 ? color.new(color.green, 95) : strategy.position_size < 0 ? color.new(color.red, 95) : na)

// ========== TABLEAU DES STATISTIQUES ET FILTRES ==========
var table statsTable = table.new(position.top_right, 3, 13, bgcolor=color.new(color.gray, 85), border_color=color.white, border_width=1)

if barstate.islast
    // Stats trades
    totalTrades = strategy.closedtrades
    winningTrades = 0
    for i = 0 to totalTrades - 1
        if strategy.closedtrades.profit(i) > 0
            winningTrades := winningTrades + 1
    winRate = totalTrades > 0 ? (winningTrades / totalTrades) * 100 : 0
    grossProfit = strategy.grossprofit
    grossLoss = strategy.grossloss  // Pas besoin de abs(), c'est déjà une valeur positive
    profitFactor = grossLoss > 0 ? grossProfit / grossLoss : 0
    
    // En-tête
    table.cell(statsTable, 0, 0, "📊 STATISTIQUES", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 0))
    table.cell(statsTable, 0, 1, "Trades", text_color=color.white)
    table.cell(statsTable, 1, 1, str.tostring(totalTrades), text_color=color.white)
    table.cell(statsTable, 0, 2, "Win Rate", text_color=color.white)
    table.cell(statsTable, 1, 2, str.tostring(winRate, "#.##") + "%", text_color=winRate > 50 ? color.green : color.red)
    table.cell(statsTable, 0, 3, "Profit Factor", text_color=color.white)
    table.cell(statsTable, 1, 3, str.tostring(profitFactor, "#.##"), text_color=profitFactor > 1.5 ? color.green : color.red)
    table.cell(statsTable, 0, 4, "Gross Profit", text_color=color.white)
    table.cell(statsTable, 1, 4, str.tostring(grossProfit, "#.##"), text_color=color.green)
    table.cell(statsTable, 0, 5, "Gross Loss", text_color=color.white)
    table.cell(statsTable, 1, 5, str.tostring(grossLoss, "#.##"), text_color=color.red)
    
    // Paramètres actifs
    table.cell(statsTable, 0, 7, "⚙️ PARAMÈTRES", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 0))
    table.cell(statsTable, 0, 8, "RR", text_color=color.white)
    table.cell(statsTable, 1, 8, "1:" + str.tostring(riskRewardRatio), text_color=color.yellow)
    table.cell(statsTable, 0, 9, "SL Type", text_color=color.white)
    table.cell(statsTable, 1, 9, useFixedSL ? "Fixe" : "Bougie", text_color=color.blue)
    
    // Filtres actifs
    table.cell(statsTable, 0, 11, "🔍 FILTRES", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 0))
    table.cell(statsTable, 0, 12, "Tendance", text_color=color.white)
    table.cell(statsTable, 1, 12, useTrendFilter ? "ON" : "OFF", text_color=useTrendFilter ? color.green : color.red)
    table.cell(statsTable, 2, 12, trendType, text_color=color.orange)
    
    table.cell(statsTable, 0, 13, "Momentum", text_color=color.white)
    table.cell(statsTable, 1, 13, useMomentumFilter ? "ON" : "OFF", text_color=useMomentumFilter ? color.green : color.red)
    table.cell(statsTable, 2, 13, momentumType, text_color=color.orange)
    
    table.cell(statsTable, 0, 14, "Volume", text_color=color.white)
    table.cell(statsTable, 1, 14, useVolumeFilter ? "ON" : "OFF", text_color=useVolumeFilter ? color.green : color.red)
    table.cell(statsTable, 2, 14, volumeType, text_color=color.orange)

// ========== ALERTES ==========
alertcondition(signalBullish, title="🔵 Signal Achat", message="Signal bougie englobante haussiere - Achat")
alertcondition(signalBearish, title="🔴 Signal Vente", message="Signal bougie englobante baissiere - Vente")