//@version=5
library("BestTimeFrameFinder")

//─────────────────────────────────────────────────────────────
// ‑-- internal helper: hand-rolled ADX (identical to ta.adx) ---
//─────────────────────────────────────────────────────────────
adxCore(int _len) =>
    tr      = ta.tr(true)
    upMove  = high - high[1]
    dnMove  = low[1] - low
    plusDM  = (upMove > 0 and upMove > dnMove) ? upMove : 0.0
    minusDM = (dnMove > 0 and dnMove > upMove) ? dnMove : 0.0
    atrSm   = ta.rma(tr, _len)
    plusDI  = 100 * ta.rma(plusDM , _len) / atrSm
    minusDI = 100 * ta.rma(minusDM, _len) / atrSm
    dx      = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    ta.rma(dx, _len)

//─────────────────────────────────────────────────────────────
// ‑-- EXPORTS ---
//─────────────────────────────────────────────────────────────

// ADX on the CURRENT timeframe (no security() inside → export-safe)
export adx(int len) =>
    adxCore(len)

// ATR expressed in % of price on CURRENT timeframe
export atrPercent(int len) =>
    ta.atr(len) / close * 100

// √-time scaling factor for a given timeframe string.
// Keeps the ATR-weight logic outside any security() call.
export scaleFromTf(string tf, float atrWeight) =>
    atrWeight / math.sqrt(timeframe.in_seconds(tf) / 60.0)

// Composite score for the CURRENT timeframe.
// Call this from within your own request.security().
export scoreLocal(int adxLen,
                  int atrLen,
                  float scale) =>
    adxCore(adxLen) + scale * (ta.atr(atrLen) / close * 100)

// Utility: find the maximum element in an array of floats.
// Returns [bestIdx, bestValue]
export maxInArray(float[] arr) =>
    int   bestIdx = -1
    float bestVal = na
    for i = 0 to array.size(arr) - 1
        float v = array.get(arr, i)
        if not na(v) and (na(bestVal) or v > bestVal)
            bestVal := v
            bestIdx := i
    [bestIdx, bestVal]
