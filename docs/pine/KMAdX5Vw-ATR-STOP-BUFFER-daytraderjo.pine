//@version=6
indicator("JW FSH ATR STOP BUFFER", overlay=true)

// Inputs
showTable = input.bool(true, title="Show ATR Table", group="Display Options")
table_position = input.string("top_center", "Table Position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], group="Display Options")

topSpacerRows = input.int(3, "Spacer Rows", minval=0, maxval=10, group="Display Options", tooltip="Adds invisible blank rows before the ATR table. Use 0 to remove spacer rows.")

bg_color = input.color(color.gray, "Background Color", group="Display Options")
text_color = input.color(color.white, "Text Color", group="Display Options")
header_bg_color = input.color(color.black, "Header Background Color", group="Display Options")
font_size = input.string("small", "Font Size", options=["tiny", "small", "normal", "large", "huge"], group="Display Options")

borderWidth = input.int(0, "Border Width", minval=0, maxval=5, group="Display Options", tooltip="Use 0 for no visible spacer-row borders. Use 1 if you want table borders.")

showPercent1 = input.bool(true, title="Show Percentage 1 Row", group="Display Options")
percent1 = input.float(2.0, title="Percentage 1 (%)", minval=0.1, maxval=100.0, step=0.1, group="Display Options")

showPercent2 = input.bool(true, title="Show Percentage 2 Row", group="Display Options")
percent2 = input.float(10.0, title="Percentage 2 (%)", minval=0.1, maxval=100.0, step=0.1, group="Display Options")

// Daily ATR
atr_period = 14
daily_atr = request.security(syminfo.tickerid, "D", ta.atr(atr_period))

tick_size = syminfo.mintick
atr_ticks = daily_atr / tick_size
atr_points = daily_atr

percent1_value = atr_ticks * (percent1 / 100)
percent2_value = atr_ticks * (percent2 / 100)
percent1_points = atr_points * (percent1 / 100)
percent2_points = atr_points * (percent2 / 100)

atr_ticks_rounded = math.ceil(atr_ticks)
percent1_rounded = math.ceil(percent1_value)
percent2_rounded = math.ceil(percent2_value)

atr_points_rounded = math.ceil(atr_points / tick_size) * tick_size
percent1_points_rounded = math.ceil(percent1_points / tick_size) * tick_size
percent2_points_rounded = math.ceil(percent2_points / tick_size) * tick_size

usd_per_tick = syminfo.pointvalue != 0 ? (syminfo.pointvalue / (1 / tick_size)) : (close * tick_size)

usd_atr = atr_ticks_rounded * usd_per_tick
usd_percent1 = percent1_rounded * usd_per_tick
usd_percent2 = percent2_rounded * usd_per_tick

usd_atr_rounded = math.round(usd_atr, 2)
usd_percent1_rounded = math.round(usd_percent1, 2)
usd_percent2_rounded = math.round(usd_percent2, 2)

// Table position
pos = position.top_center
switch table_position
    "top_left" => pos := position.top_left
    "top_center" => pos := position.top_center
    "top_right" => pos := position.top_right
    "middle_left" => pos := position.middle_left
    "middle_center" => pos := position.middle_center
    "middle_right" => pos := position.middle_right
    "bottom_left" => pos := position.bottom_left
    "bottom_center" => pos := position.bottom_center
    "bottom_right" => pos := position.bottom_right

// Font size
fs = size.small
switch font_size
    "tiny" => fs := size.tiny
    "small" => fs := size.small
    "normal" => fs := size.normal
    "large" => fs := size.large
    "huge" => fs := size.huge

// Fixed max rows: 10 spacer rows + 4 data rows
var tbl = table.new(pos, 4, 14, bgcolor=color.new(color.white, 100), frame_width=0, border_width=borderWidth, border_color=color.white)

// Draw table
if barstate.islast
    table.clear(tbl, 0, 0, 3, 13)

    if showTable
        // Invisible spacer rows
        for r = 0 to topSpacerRows - 1
            table.cell(tbl, 0, r, "", bgcolor=color.new(color.white, 100), text_color=color.new(color.white, 100), text_size=fs)
            table.cell(tbl, 1, r, "", bgcolor=color.new(color.white, 100), text_color=color.new(color.white, 100), text_size=fs)
            table.cell(tbl, 2, r, "", bgcolor=color.new(color.white, 100), text_color=color.new(color.white, 100), text_size=fs)
            table.cell(tbl, 3, r, "", bgcolor=color.new(color.white, 100), text_color=color.new(color.white, 100), text_size=fs)

        baseRow = topSpacerRows

        // Headers
        table.cell(tbl, 0, baseRow, "Metric", text_color=text_color, bgcolor=header_bg_color, text_size=fs)
        table.cell(tbl, 1, baseRow, "Ticks", text_color=text_color, bgcolor=header_bg_color, text_size=fs)
        table.cell(tbl, 2, baseRow, "Points", text_color=text_color, bgcolor=header_bg_color, text_size=fs)
        table.cell(tbl, 3, baseRow, "USD Value", text_color=text_color, bgcolor=header_bg_color, text_size=fs)

        // Daily ATR row
        table.cell(tbl, 0, baseRow + 1, "Daily ATR", text_color=text_color, bgcolor=bg_color, text_size=fs)
        table.cell(tbl, 1, baseRow + 1, str.tostring(atr_ticks_rounded), text_color=text_color, bgcolor=bg_color, text_size=fs)
        table.cell(tbl, 2, baseRow + 1, str.tostring(atr_points_rounded), text_color=text_color, bgcolor=bg_color, text_size=fs)
        table.cell(tbl, 3, baseRow + 1, "$" + str.tostring(usd_atr_rounded), text_color=text_color, bgcolor=bg_color, text_size=fs)

        if showPercent1
            table.cell(tbl, 0, baseRow + 2, str.tostring(percent1) + "% ATR", text_color=text_color, bgcolor=bg_color, text_size=fs)
            table.cell(tbl, 1, baseRow + 2, str.tostring(percent1_rounded), text_color=text_color, bgcolor=bg_color, text_size=fs)
            table.cell(tbl, 2, baseRow + 2, str.tostring(percent1_points_rounded), text_color=text_color, bgcolor=bg_color, text_size=fs)
            table.cell(tbl, 3, baseRow + 2, "$" + str.tostring(usd_percent1_rounded), text_color=text_color, bgcolor=bg_color, text_size=fs)

        if showPercent2
            table.cell(tbl, 0, baseRow + 3, str.tostring(percent2) + "% ATR", text_color=text_color, bgcolor=bg_color, text_size=fs)
            table.cell(tbl, 1, baseRow + 3, str.tostring(percent2_rounded), text_color=text_color, bgcolor=bg_color, text_size=fs)
            table.cell(tbl, 2, baseRow + 3, str.tostring(percent2_points_rounded), text_color=text_color, bgcolor=bg_color, text_size=fs)
            table.cell(tbl, 3, baseRow + 3, "$" + str.tostring(usd_percent2_rounded), text_color=text_color, bgcolor=bg_color, text_size=fs)