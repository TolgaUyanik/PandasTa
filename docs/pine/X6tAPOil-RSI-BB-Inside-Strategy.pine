//@version=6
strategy("RSI + BB Inside Strategy v6 (Alerts)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// 1. Parametry wejściowe
int rsiLength   = input.int(14, title="RSI Length")
int bbLength    = input.int(20, title="BB Length")
float bbMult    = input.float(2.0, title="BB StdDev")

// 2. Obliczenia RSI i Wstęg Bollingera
float rsiVal = ta.rsi(close, rsiLength)
[bbBasis, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)

// 3. Rysowanie Wstęg Bollingera i kolorowanie kanałów
pBasis = plot(bbBasis, title="BB Średnia (Basis)", color=color.gray, linewidth=1)
pUpper = plot(bbUpper, title="BB Górna Wstęga", color=color.red, linewidth=1)
pLower = plot(bbLower, title="BB Dolna Wstęga", color=color.green, linewidth=1)
fill(pBasis, pUpper, color=color.new(color.red, 95), title="Górny Kanał (Niedźwiedzi)")
fill(pBasis, pLower, color=color.new(color.green, 95), title="Dolny Kanał (Byczy)")

// 4. Warunki wejścia (Long / Short)
bool buyCondition  = rsiVal < 30 and close > bbLower and close < bbUpper
bool sellCondition = rsiVal > 70 and close < bbUpper and close > bbLower

// 5. Warunki wyjścia
bool exitLongCondition  = ta.cross(close, bbBasis)
bool exitShortCondition = ta.cross(close, bbBasis)

// 6. Logika Egzekucji Strategii + Alerty
// Wejście w pozycję Long
if (buyCondition)
    strategy.entry("Long", strategy.long, alert_message="Kupno (Long): RSI poniżej 30, cena wewnątrz BB.")

// Wyjście z pozycji Long
if (strategy.position_size > 0 and exitLongCondition)
    strategy.close("Long", comment="Exit Long (Basis)", alert_message="Zamknięcie Long: Cena przecięła średnią BB.")

// Wejście w pozycję Short
if (sellCondition)
    strategy.entry("Short", strategy.short, alert_message="Sprzedaż (Short): RSI powyżej 70, cena wewnątrz BB.")

// Wyjście z pozycji Short
if (strategy.position_size < 0 and exitShortCondition)
    strategy.close("Short", comment="Exit Short (Basis)", alert_message="Zamknięcie Short: Cena przecięła średnią BB.")

// 7. Wizualne podświetlenie tła dla sygnałów
bgcolor(buyCondition ? color.new(color.green, 85) : na, title="Tło: Sygnał Kupna")
bgcolor(sellCondition ? color.new(color.red, 85) : na, title="Tło: Sygnał Sprzedaży")