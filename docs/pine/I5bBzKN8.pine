//@version=5
indicator("Multi Rate of Change (ROC) - 3 Lines", overlay=false, shorttitle="ROC3")

// ROC 기간 입력
roc_length1 = input.int(7, minval=1, title="ROC1 기간 (일)")
roc_length2 = input.int(30, minval=1, title="ROC2 기간 (일)")
roc_length3 = input.int(100, minval=1, title="ROC3 기간 (일)")

// 각 ROC 선의 입력(색상, 굵기, 스타일)
roc1_color = input.color(color.red, title="ROC1 색상")
roc1_width = input.int(2, minval=1, maxval=5, title="ROC1 굵기")
roc1_style = input.string("solid", options=["solid", "dotted", "dashed"], title="ROC1 선스타일")

roc2_color = input.color(color.blue, title="ROC2 색상")
roc2_width = input.int(2, minval=1, maxval=5, title="ROC2 굵기")
roc2_style = input.string("dashed", options=["solid", "dotted", "dashed"], title="ROC2 선스타일")

roc3_color = input.color(color.green, title="ROC3 색상")
roc3_width = input.int(2, minval=1, maxval=5, title="ROC3 굵기")
roc3_style = input.string("dotted", options=["solid", "dotted", "dashed"], title="ROC3 선스타일")

zero_line_color = input.color(color.gray, title="기준선(0) 색상")
zero_line_width = input.int(1, minval=1, maxval=5, title="기준선(0) 굵기")
zero_line_style = input.string("solid", options=["solid", "dotted", "dashed"], title="기준선(0) 선스타일")

// ROC 계산 함수
roc(src, length) =>
    length > 0 ? 100 * (src - src[length]) / src[length] : na

roc1 = roc(close, roc_length1)
roc2 = roc(close, roc_length2)
roc3 = roc(close, roc_length3)

// 각 선에 맞는 style값 고정 (Pine Script 제약상 plot.style_xxx 상수로만 사용)
roc1_plot_style = roc1_style == "solid" ? plot.style_line : roc1_style == "dotted" ? plot.style_circles : plot.style_stepline
roc2_plot_style = roc2_style == "solid" ? plot.style_line : roc2_style == "dotted" ? plot.style_circles : plot.style_stepline
roc3_plot_style = roc3_style == "solid" ? plot.style_line : roc3_style == "dotted" ? plot.style_circles : plot.style_stepline
zero_plot_style = zero_line_style == "solid" ? plot.style_line : zero_line_style == "dotted" ? plot.style_circles : plot.style_stepline

// ROC plot (title을 고정 문자열로만)
plot(roc1, title="ROC1", color=roc1_color, linewidth=roc1_width, style=roc1_plot_style)
plot(roc2, title="ROC2", color=roc2_color, linewidth=roc2_width, style=roc2_plot_style)
plot(roc3, title="ROC3", color=roc3_color, linewidth=roc3_width, style=roc3_plot_style)

// 기준선(0)
plot(0, title="기준선(0)", color=zero_line_color, linewidth=zero_line_width, style=zero_plot_style)
