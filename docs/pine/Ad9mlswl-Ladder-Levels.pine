//@version=6
indicator("100s & 20pt Grid - 1000 Range", overlay=true, max_lines_count=500)

//====================================================
// INPUTS
//====================================================
grp_style = "Grid Styling"
col100 = input.color(color.red, "100s Line Color", group=grp_style)
col20 = input.color(color.new(color.gray, 50), "20pt Line Color", group=grp_style)

lineW100 = input.int(1, "100s Line Thickness", minval=1, maxval=4, group=grp_style)
lineW20 = input.int(1, "20pt Line Thickness", minval=1, maxval=4, group=grp_style)

levelsOut = input.int(10, "100s to draw (Above/Below)", tooltip="10 means it draws 1000 points up and 1000 down.", group=grp_style)

//====================================================
// LINE ARRAY SETUP
//====================================================
var line[] gridLines = array.new<line>()

//====================================================
// RENDERING (MANAGED ON LAST BAR)
//====================================================
if barstate.islast
    // 1. Delete all old lines to prevent history clutter
    if array.size(gridLines) > 0
        for i = 0 to array.size(gridLines) - 1
            line.delete(array.get(gridLines, i))
        array.clear(gridLines)
        
    // 2. Find the nearest 100-level to the current price
    base100 = math.round(close / 100.0) * 100.0
    
    // 3. Loop through and draw the 100s AND the 20s
    for i = -levelsOut to levelsOut
        // Calculate the main 100-point level
        levelPrice = base100 + (i * 100.0)
        
        // Draw the solid red 100s line
        l_100 = line.new(bar_index - 50, levelPrice, bar_index + 10, levelPrice, 
                     xloc=xloc.bar_index, 
                     extend=extend.both, 
                     color=col100, 
                     style=line.style_solid, 
                     width=lineW100)
        array.push(gridLines, l_100)
        
        // Draw the 20-point increments inside this 100-point block
        // (We skip drawing increments above the very top level so it doesn't overshoot)
        if i < levelsOut
            for j = 1 to 4
                incPrice = levelPrice + (j * 20.0)
                l_20 = line.new(bar_index - 50, incPrice, bar_index + 10, incPrice, 
                             xloc=xloc.bar_index, 
                             extend=extend.both, 
                             color=col20, 
                             style=line.style_dotted, 
                             width=lineW20)
                array.push(gridLines, l_20)