//@version=5
indicator("Reversal Signal avec TICK + RSI", overlay=true)

// === INPUTS ===
tick_symbol = input.symbol("TICK", "Symbole TICK")
tick_threshold_high = input.int(651, "TICK > seuil haut")
tick_threshold_low = input.int(-651, "TICK < seuil bas")
rsi_length = input.int(5, "RSI Période")
rsi_overbought = input.int(80, "RSI > surachat")
rsi_oversold = input.int(20, "RSI < survente")

// === TICK DATA ===
tick_data = request.security(tick_symbol, timeframe.period, close)

// === RSI (5) sur 5 minutes ===
rsi_5 = ta.rsi(close, rsi_length)

// === CONDITIONS ===
condition_long = (tick_data < tick_threshold_low) and (rsi_5 < rsi_oversold)
condition_short = (tick_data > tick_threshold_high) and (rsi_5 > rsi_overbought)

// === PLOT DES CERCLES ===
plotshape(condition_long, title="Signal Long", location=location.belowbar, color=color.lime, style=shape.circle, size=size.normal)
plotshape(condition_short, title="Signal Short", location=location.abovebar, color=color.red, style=shape.circle, size=size.normal)

// === ALERT CONDITIONS ===
alertcondition(condition_long, title="Long Signal Alert", message="Reversal Long Signal!")
alertcondition(condition_short, title="Short Signal Alert", message="Reversal Short Signal!")