// Code from Naked Candlestick Trading Method
// Pinbar Definition: A candlestick where the dominant shadow exceeds 2/3 of the entire candle length

//@version=6
indicator("Pinbar Detector", overlay=true)

// Calculate candle components
candleRange = high - low  // Total candle length
bodySize = math.abs(close - open)  // Body size
upperShadow = high - math.max(open, close)  // Upper shadow length
lowerShadow = math.min(open, close) - low  // Lower shadow length

// Pinbar condition: dominant shadow length exceeds 2/3 of total candle length
pinbarThreshold = candleRange * 2/3

// Identify bullish pinbar (lower shadow is dominant)
bullishPinbar = lowerShadow > pinbarThreshold and lowerShadow > upperShadow

// Identify bearish pinbar (upper shadow is dominant)
bearishPinbar = upperShadow > pinbarThreshold and upperShadow > lowerShadow

// Mark pinbars on chart
plotshape(bearishPinbar, style=shape.triangledown, location=location.abovebar, 
         color=color.red, size=size.small, title="Bearish Pinbar")
         
plotshape(bullishPinbar, style=shape.triangleup, location=location.belowbar, 
         color=color.lime, size=size.small, title="Bullish Pinbar")

// Optional: Highlight pinbar background
bgcolor(bearishPinbar ? color.new(color.red, 90) : na, title="Bearish Pinbar BG")
bgcolor(bullishPinbar ? color.new(color.lime, 90) : na, title="Bullish Pinbar BG")

// Display original candlesticks
plotcandle(open, high, low, close, title="Candlesticks", color=(close >= open ? color.green : color.red))

// Add alert conditions
alertcondition(bullishPinbar, title="Bullish Pinbar Alert", message="Bullish Pinbar detected!")
alertcondition(bearishPinbar, title="Bearish Pinbar Alert", message="Bearish Pinbar detected!")