//@version=6
strategy("BPS v17 - Strong Trend Filter", shorttitle="BPS v17 Trend", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=6, commission_type=strategy.commission.percent, commission_value=0.1)

// Core BPS
rsi = ta.rsi(close, 14)
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
ma50 = ta.sma(close, 50)
ma200 = ta.sma(close, 200)
volSMA = ta.sma(volume, 20)
strongVol = volume > volSMA * 1.5

bullDiv = rsi < ta.lowest(rsi, 10) and close > ta.lowest(close, 10)

roc = ta.roc(close, 10)

trendBull = close > ma200 and close > ma50
trendBear = close < ma200 and close < ma50

momentumScore = (rsi > 53 and macdLine > signalLine and roc > 0) ? 1.3 : -1
breadthScore = trendBull ? 1.3 : -1
valScoreNorm = (close / ma200 - 1) < -0.04 ? 1 : -1
volScore = strongVol ? 1.5 : 0

totalScoreRaw = (momentumScore * 0.35) + (breadthScore * 0.3) + (valScoreNorm * 0.2) + volScore
totalScoreSmoothed = ta.ema(totalScoreRaw, 3)

// Trend-Filtered Signals
longSignal = ta.crossover(totalScoreSmoothed, 0.4) and strongVol and trendBull
shortSignal = ta.crossunder(totalScoreSmoothed, -0.4) and strongVol and trendBear

// Entries
if (longSignal)
    strategy.entry("BPS Long", strategy.long)

if (shortSignal)
    strategy.entry("BPS Short", strategy.short)

// Risk Management
strategy.exit("Exit Long", "BPS Long", stop=close * 0.975, limit=close * 1.05)
strategy.exit("Exit Short", "BPS Short", stop=close * 1.025, limit=close * 0.95)

// Visuals
plot(ma200, "200 SMA", color=color.green)
plot(ma50, "50 SMA", color=color.blue)

plotshape(longSignal, title="Long", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(shortSignal, title="Short", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")
