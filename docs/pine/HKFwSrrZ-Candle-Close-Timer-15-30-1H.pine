//@version=6
indicator("Candle Close Timer", overlay = true)

// ── Inputs ─────────────────────────────────────────────────────────────
tblPosInput = input.string("Top Right", "Placement", options = ["Top Right", "Top Center", "Top Left", "Middle Right", "Middle Left", "Bottom Right", "Bottom Center", "Bottom Left"])
sizeInput = input.string("Medium", "Table size", options = ["Small", "Medium", "Large"])
warnMins = input.int(5, "Warning threshold (minutes)", minval = 1, maxval = 30)
normalCol = input.color(color.white, "Normal text color")
warnCol = input.color(color.red, "Warning text color")
bgOpacity = input.int(85, "Background transparency", minval = 0, maxval = 100)

// ── Countdown math ─────────────────────────────────────────────────────
nowSecs = math.floor(timenow / 1000.0)

rem15 = 900 - nowSecs % 900
rem30 = 1800 - nowSecs % 1800
rem60 = 3600 - nowSecs % 3600

warnSecs = warnMins * 60

f_format(int secs) =>
    m = math.floor(secs / 60.0)
    s = secs - m * 60
    (m < 10 ? "0" : "") + str.tostring(m) + ":" + (s < 10 ? "0" : "") + str.tostring(s)

// ── Sizing ─────────────────────────────────────────────────────────────
labelSize = sizeInput == "Small" ? size.tiny : sizeInput == "Large" ? size.normal : size.small
timerSize = sizeInput == "Small" ? size.small : sizeInput == "Large" ? size.large : size.normal

// ── Placement ──────────────────────────────────────────────────────────
tblPos = tblPosInput == "Top Right" ? position.top_right : tblPosInput == "Top Center" ? position.top_center : tblPosInput == "Top Left" ? position.top_left : tblPosInput == "Middle Right" ? position.middle_right : tblPosInput == "Middle Left" ? position.middle_left : tblPosInput == "Bottom Right" ? position.bottom_right : tblPosInput == "Bottom Center" ? position.bottom_center : position.bottom_left

var table tbl = table.new(tblPos, 2, 3, border_width = 1)

bgCol = color.new(color.black, bgOpacity)

col15 = rem15 <= warnSecs ? warnCol : normalCol
col30 = rem30 <= warnSecs ? warnCol : normalCol
col60 = rem60 <= warnSecs ? warnCol : normalCol

if barstate.islast
    table.cell(tbl, 0, 0, "15m", text_color = normalCol, text_size = labelSize, bgcolor = bgCol)
    table.cell(tbl, 1, 0, f_format(rem15), text_color = col15, text_size = timerSize, bgcolor = bgCol)
    table.cell(tbl, 0, 1, "30m", text_color = normalCol, text_size = labelSize, bgcolor = bgCol)
    table.cell(tbl, 1, 1, f_format(rem30), text_color = col30, text_size = timerSize, bgcolor = bgCol)
    table.cell(tbl, 0, 2, "1H", text_color = normalCol, text_size = labelSize, bgcolor = bgCol)
    table.cell(tbl, 1, 2, f_format(rem60), text_color = col60, text_size = timerSize, bgcolor = bgCol)