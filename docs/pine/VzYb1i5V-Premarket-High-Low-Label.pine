//@version=5
indicator("Premarket High/Low Label", overlay=true, max_labels_count=1)

myTZ = "America/New_York"
inPremkt = not na(time(timeframe.period, "0400-0930:1234567", myTZ))
var float preHigh = na
var float preLow  = na
if inPremkt
    preHigh := na(preHigh) ? high : math.max(preHigh, high)
    preLow  := na(preLow) ? low  : math.min(preLow, low)
else
    preHigh := na
    preLow := na

fmt(x) => na(x) ? "n/a" : str.tostring(x, format.mintick)

var label premktLabel = na
if barstate.islast
    if not na(premktLabel)
        label.delete(premktLabel)
    premktLabel := label.new(bar_index + 5, high + (syminfo.mintick * 70), "Premkt High: " + fmt(preHigh) + " | Premkt Low: " + fmt(preLow), xloc.bar_index, yloc.price, color=color.red, textcolor=color.white, size=size.small, style=label.style_label_left)