//@version=6
indicator(title="GCM Fibonacci Engine for Elliott Waves", shorttitle="GCM FEEW", overlay=true)
// ==========================================
// 1. INPUTS
// ==========================================
grp_ew        = "Elliott Wave Configuration"
show_ew       = input.bool(true, title="Show Live Elliott Wave", group=grp_ew)
ew_style      = input.string("Custom", title="Trading Style (Wave Degree)", options=["Scalping (3)", "Intraday (7)", "Swing (14)", "Custom"], group=grp_ew)
custom_ew_len = input.int(21, title="Custom Degree Length", minval=1, group=grp_ew) 
ew_len        = ew_style == "Scalping (3)" ? 3 : ew_style == "Intraday (7)" ? 7 : ew_style == "Swing (14)" ? 14 : custom_ew_len

// New EW Customization Inputs
ew_color      = input.color(color.orange, title="Wave Color", group=grp_ew)
ew_width      = input.int(2, title="Wave Line Thickness", minval=1, maxval=5, group=grp_ew)
ew_line_style = input.string("Solid", title="Wave Line Style", options=["Solid", "Dashed", "Dotted"], group=grp_ew)

grp_fib       = "Fibonacci Engine Settings"
show_fib      = input.bool(true, title="Enable Auto Fib", group=grp_fib)
fib_type      = input.string("Auto Detect", title="Fib Tool Type", options=["Auto Detect", "Retracement", "Trend-Based Extension"], group=grp_fib)

show_f0       = input.bool(true, title="Show 0.000", group=grp_fib)
show_f236     = input.bool(false, title="Show 0.236", group=grp_fib)
show_f382     = input.bool(true, title="Show 0.382", group=grp_fib)
show_f500     = input.bool(true, title="Show 0.500", group=grp_fib)
show_f618     = input.bool(true, title="Show 0.618 (Golden Ratio)", group=grp_fib)
show_f786     = input.bool(true, title="Show 0.786", group=grp_fib)
show_f886     = input.bool(false, title="Show 0.886", group=grp_fib)
show_f1       = input.bool(true, title="Show 1.000", group=grp_fib)
show_f1618    = input.bool(true, title="Show 1.618 (Extension Target)", group=grp_fib)
show_f2618    = input.bool(true, title="Show 2.618 (Extension Target)", group=grp_fib)
show_f3618    = input.bool(false, title="Show 3.618 (Extension Target)", group=grp_fib) 
show_f4236    = input.bool(false, title="Show 4.236 (Extension Target)", group=grp_fib) 

grp_radar     = "Smart Radar Settings"
show_radar    = input.bool(true, title="Enable Touch-Only Radar", group=grp_radar)
buffer_val    = input.float(0.05, title="Price Zone Buffer (%)", minval=0.001, step=0.01, group=grp_radar)

grp_fib_set   = "Fibonacci Tool Styling & Display"
extend_left   = input.bool(false, title="Extend Left", inline="Ext", group=grp_fib_set)
extend_right  = input.bool(false, title="Extend Right", inline="Ext", group=grp_fib_set)
show_bg       = input.bool(true, title="Background Fill", inline="BG", group=grp_fib_set)
bg_transp     = input.int(85, title="Transparency", minval=0, maxval=100, inline="BG", group=grp_fib_set)
fib_line_width= input.int(1, title="Line Width", minval=1, maxval=4, inline="Style", group=grp_fib_set)
fib_line_style= input.string("Solid", title="Line Style", options=["Solid", "Dashed", "Dotted"], inline="Style", group=grp_fib_set)

grp_fib_lbl   = "Fibonacci Labels & Text Formatting"
labels_pos    = input.string("Right", title="Labels Position", options=["Left", "Right"], group=grp_fib_lbl)
show_levels   = input.bool(true, title="Show Level Value", inline="LblOpt", group=grp_fib_lbl)
show_prices   = input.bool(true, title="Show Price", inline="LblOpt", group=grp_fib_lbl)
font_size_str = input.string("Normal", title="Font Size", options=["Tiny", "Small", "Normal", "Large"], group=grp_fib_lbl)

// ==========================================
// GLOBAL FUNCTIONS & DRAWING HELPER
// ==========================================
get_lbl_text(string lvl_name, float price_val, string extra_note) =>
    string res = ""
    if show_levels and show_prices
        res := lvl_name + " (" + str.tostring(price_val, format.mintick) + ")"
    else if show_levels
        res := lvl_name
    else if show_prices
        res := str.tostring(price_val, format.mintick)
    else
        res := ""
    if extra_note != ""
        res += extra_note
    res

// EW Rule Validator (Checks if 5 points form a valid motive wave)
is_valid_motive(float p0, float p1, float p2, float p3, float p4, float p5, int dir) =>
    bool valid = false
    if dir == 1 // Bullish 5-Wave
        float w1 = p1 - p0, float w2 = p1 - p2, float w3 = p3 - p2, float w4 = p3 - p4, float w5 = p5 - p4
        bool rule1 = p2 > p0 // W2 doesn't retrace 100% of W1
        bool rule2 = (w3 > w1) or (w3 > w5) // W3 is not the shortest
        bool rule3 = p4 > p1 // W4 does not overlap W1 territory
        bool progress = p3 > p1 and p5 > p3 // W3 and W5 must make new highs
        valid := rule1 and rule2 and rule3 and progress
    else if dir == -1 // Bearish 5-Wave
        float w1 = p0 - p1, float w2 = p2 - p1, float w3 = p2 - p3, float w4 = p4 - p3, float w5 = p4 - p5
        bool rule1 = p2 < p0
        bool rule2 = (w3 > w1) or (w3 > w5)
        bool rule3 = p4 < p1
        bool progress = p3 < p1 and p5 < p3
        valid := rule1 and rule2 and rule3 and progress
    valid

draw_fib_level(float f_val, string lvl_name, color orig_col, int idx_start, int idx_end, string status, line prev_line, array<line> l_arr, array<label> lbl_arr, array<linefill> fill_arr) =>
    line l_id = na
    if not na(f_val)
        float buffer    = math.abs(f_val) * (buffer_val / 100.0)
        bool is_touched = show_radar and (high >= f_val - buffer) and (low <= f_val + buffer)

        color coreCol   = is_touched ? color.new(orig_col, 0) : color.new(orig_col, 0)
        color glowCol   = color.new(orig_col, 80)
        int cur_width   = is_touched ? 3 : fib_line_width

        string l_style_val_str = fib_line_style == "Solid" ? line.style_solid : fib_line_style == "Dashed" ? line.style_dashed : line.style_dotted
        string f_size_val      = font_size_str == "Tiny" ? size.tiny : font_size_str == "Small" ? size.small : font_size_str == "Normal" ? size.normal : size.large
        string ext_mode_val    = (extend_left and extend_right) ? extend.both : extend_left ? extend.left : extend_right ? extend.right : extend.none

        l_id := line.new(idx_start, f_val, idx_end, f_val, color=coreCol, style=l_style_val_str, width=cur_width, extend=ext_mode_val)
        array.push(l_arr, l_id)

        if is_touched
            gl_id = line.new(idx_start, f_val, idx_end, f_val, color=glowCol, style=line.style_solid, width=12, extend=ext_mode_val)
            array.push(l_arr, gl_id)

        string txt    = ""
        color lbl_bg  = color.new(color.black, 100)
        color lbl_txt = orig_col

        if is_touched
            txt     := lvl_name + " | " + str.tostring(f_val, format.mintick) + " ⚡" + status
            lbl_bg  := color.new(#1e222d, 0)
            lbl_txt := coreCol
        else
            txt := get_lbl_text(lvl_name, f_val, status)

        if txt != ""
            // Dynamic Label Positioning Logic
            string actual_pos = labels_pos
            if extend_right and not extend_left
                actual_pos := "Right"
            else if extend_left and not extend_right
                actual_pos := "Left"
                
            int lbl_x        = actual_pos == "Left" ? idx_start : idx_end
            string lbl_style = actual_pos == "Left" ? label.style_label_right : label.style_label_left
            array.push(lbl_arr, label.new(lbl_x, f_val, text=txt, color=lbl_bg, textcolor=lbl_txt, style=lbl_style, size=f_size_val))

        if show_bg and not na(prev_line)
            color fill_col = is_touched ? color.new(orig_col, math.min(bg_transp, 75)) : color.new(orig_col, bg_transp)
            array.push(fill_arr, linefill.new(prev_line, l_id, color=fill_col))
            
    l_id

// ==========================================
// 2. ELLIOTT WAVE CALCULATION
// ==========================================
var int[] zz_time = array.new_int(0)
var int[] zz_index = array.new_int(0) 
var float[] zz_price = array.new_float(0)
var int[] zz_dir = array.new_int(0)
var int last_pivot_dir = 0

ph_ew = ta.pivothigh(high, ew_len, ew_len)
pl_ew = ta.pivotlow(low, ew_len, ew_len)

if show_ew or show_fib
    if not na(ph_ew)
        if last_pivot_dir <= 0
            array.push(zz_time, time[ew_len]), array.push(zz_index, bar_index[ew_len]), array.push(zz_price, ph_ew), array.push(zz_dir, 1)
            last_pivot_dir := 1
        else if ph_ew > array.last(zz_price)
            array.set(zz_time, array.size(zz_time)-1, time[ew_len]), array.set(zz_index, array.size(zz_index)-1, bar_index[ew_len]), array.set(zz_price, array.size(zz_price)-1, ph_ew)

    if not na(pl_ew)
        if last_pivot_dir >= 0
            array.push(zz_time, time[ew_len]), array.push(zz_index, bar_index[ew_len]), array.push(zz_price, pl_ew), array.push(zz_dir, -1)
            last_pivot_dir := -1
        else if pl_ew < array.last(zz_price)
            array.set(zz_time, array.size(zz_time)-1, time[ew_len]), array.set(zz_index, array.size(zz_index)-1, bar_index[ew_len]), array.set(zz_price, array.size(zz_price)-1, pl_ew)
    
    if array.size(zz_time) > 9
        array.shift(zz_time), array.shift(zz_index), array.shift(zz_price), array.shift(zz_dir)

// ==========================================
// 3. DRAWING ENGINE
// ==========================================
var line[] ew_lines = array.new_line()
var label[] ew_labels = array.new_label()
var line[] fib_lines = array.new_line()
var label[] fib_labels = array.new_label()
var linefill[] fib_linefills = array.new_linefill()

if barstate.islast
    for ln in ew_lines
        line.delete(ln)
    array.clear(ew_lines)
    
    for lb in ew_labels
        label.delete(lb)
    array.clear(ew_labels)

    for ln in fib_lines
        line.delete(ln)
    array.clear(fib_lines)

    for lb in fib_labels
        label.delete(lb)
    array.clear(fib_labels)

    for lf in fib_linefills
        linefill.delete(lf)
    array.clear(fib_linefills)
    
    // Draw EW
    if show_ew and array.size(zz_time) > 1
        for i = 1 to array.size(zz_time) - 1
            t1 = array.get(zz_time, i-1), p1 = array.get(zz_price, i-1)
            t2 = array.get(zz_time, i),   p2 = array.get(zz_price, i)
            
            // Check if this is the live, unconfirmed leg
            bool is_live_leg = (i == array.size(zz_time) - 1)
            
            // Live leg is always dotted, historical uses user setting
            string ew_style_val = is_live_leg ? line.style_dotted : (ew_line_style == "Solid" ? line.style_solid : ew_line_style == "Dashed" ? line.style_dashed : line.style_dotted)
            
            // NEW: Unconfirmed wave line set to Gray, otherwise user color
            color final_line_col = is_live_leg ? color.new(color.gray, 0) : color.new(ew_color, 40)
            
            array.push(ew_lines, line.new(t1, p1, t2, p2, xloc=xloc.bar_time, color=final_line_col, width=ew_width, style=ew_style_val))
            
            // Determine Label Text (Static display to ensure they never hide)
            string lbl_text = i == 1 ? "1" : i == 2 ? "2" : i == 3 ? "3" : i == 4 ? "4" : i == 5 ? "5" : i == 6 ? "a" : i == 7 ? "b" : i == 8 ? "c" : ""
            
            color final_lbl_col = ew_color
            
            // Validate the first 5 waves to apply smart color coding
            if array.size(zz_price) >= 6 and i <= 5
                float p0 = array.get(zz_price, 0)
                float pA = array.get(zz_price, 1)
                float pB = array.get(zz_price, 2)
                float pC = array.get(zz_price, 3)
                float pD = array.get(zz_price, 4)
                float pE = array.get(zz_price, 5)
                
                int wave_dir = pA > p0 ? 1 : -1
                bool is_motive = is_valid_motive(p0, pA, pB, pC, pD, pE, wave_dir)
                
                if is_motive
                    final_lbl_col := wave_dir == 1 ? color.green : color.red
                else
                    final_lbl_col := color.orange
            
            // NEW: Unconfirmed label set to Gray
            if is_live_leg
                final_lbl_col := color.gray
                
            // Draw the Label
            if lbl_text != ""
                string style_mode = array.get(zz_dir, i) == 1 ? label.style_label_down : label.style_label_up
                string final_text = lbl_text + (is_live_leg ? "?" : "")
                array.push(ew_labels, label.new(t2, p2, text=final_text, xloc=xloc.bar_time, yloc=yloc.price, color=color.new(final_lbl_col, 85), textcolor=final_lbl_col, style=style_mode, size=size.small))

    // Draw Fibonacci
    if show_fib and array.size(zz_price) >= 2
        int last_i = array.size(zz_price) - 1
        float p2 = array.get(zz_price, last_i)
        float p1 = array.get(zz_price, last_i - 1)
        int idx2 = array.get(zz_index, last_i)
        
        bool is_ext = false
        
        if fib_type == "Auto Detect"
            if array.size(zz_price) >= 3
                float p0 = array.get(zz_price, last_i - 2)
                float swing1_len = math.abs(p1 - p0)
                float swing2_len = math.abs(p2 - p1)
                is_ext := swing2_len <= swing1_len
        else if fib_type == "Trend-Based Extension"
            if array.size(zz_price) >= 3
                is_ext := true
            
        float diff = is_ext ? (p1 - array.get(zz_price, last_i - 2)) : (p2 - p1)
        int ext_idx = bar_index + 10
        string engine_status = is_ext ? " (Trend Based Fib Extension active)" : " (Fib Retracement active)"
        
        color c_gray = color.new(color.gray, 0)
        color c236   = color.new(#f44336, 0), color c382  = color.new(#4caf50, 0), color c500  = color.new(#2962ff, 0)
        color c618   = color.new(#ffb300, 0), color c786  = color.new(#00bcd4, 0), color c886  = color.new(#9c27b0, 0)
        color c1618  = color.new(#e91e63, 0), color c2618 = color.new(#ff5252, 0), color c3618 = color.new(#e040fb, 0), color c4236 = color.new(#7c4dff, 0)

        line prev_line = na
        float f_val = na

        if show_f0
            prev_line := draw_fib_level(p2, "0.000", c_gray, idx2, ext_idx, engine_status, prev_line, fib_lines, fib_labels, fib_linefills)

        if show_f236
            f_val := is_ext ? p2 + (diff * 0.236) : p2 - (diff * 0.236)
            prev_line := draw_fib_level(f_val, "0.236", c236, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

        if show_f382
            f_val := is_ext ? p2 + (diff * 0.382) : p2 - (diff * 0.382)
            prev_line := draw_fib_level(f_val, "0.382", c382, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

        if show_f500
            f_val := is_ext ? p2 + (diff * 0.500) : p2 - (diff * 0.500)
            prev_line := draw_fib_level(f_val, "0.500", c500, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

        if show_f618
            f_val := is_ext ? p2 + (diff * 0.618) : p2 - (diff * 0.618)
            prev_line := draw_fib_level(f_val, "0.618", c618, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

        if show_f786
            f_val := is_ext ? p2 + (diff * 0.786) : p2 - (diff * 0.786)
            prev_line := draw_fib_level(f_val, "0.786", c786, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

        if show_f886
            f_val := is_ext ? p2 + (diff * 0.886) : p2 - (diff * 0.886)
            prev_line := draw_fib_level(f_val, "0.886", c886, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

        if show_f1
            f_val := is_ext ? p2 + (diff * 1.000) : p1
            prev_line := draw_fib_level(f_val, "1.000", c_gray, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

        if is_ext
            if show_f1618
                f_val := p2 + (diff * 1.618)
                prev_line := draw_fib_level(f_val, "1.618", c1618, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

            if show_f2618
                f_val := p2 + (diff * 2.618)
                prev_line := draw_fib_level(f_val, "2.618", c2618, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

            if show_f3618
                f_val := p2 + (diff * 3.618)
                prev_line := draw_fib_level(f_val, "3.618", c3618, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)

            if show_f4236
                f_val := p2 + (diff * 4.236)
                prev_line := draw_fib_level(f_val, "4.236", c4236, idx2, ext_idx, "", prev_line, fib_lines, fib_labels, fib_linefills)