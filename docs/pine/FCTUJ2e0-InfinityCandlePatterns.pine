//@version=5
library("InfinityCandlePatterns")

// =====================================================
// Ported from: infinity_candlestick_pattern.mqh (24 patterns)
// Note:
// - MQL5: close[index+N] (past)  -> Pine: close[N]
// - patternATR[index] -> atr (series, current bar)
// - Library strictness: no unused arguments -> minimal signatures per function
// - For easy use: export bullAny()/bearAny()/neutralAny() with unified signature
// =====================================================

// -----------------------------------------------------
// Multi-candle patterns
// -----------------------------------------------------

export isMorningStar(series float o, series float c, series float atr) =>
    bar_index >= 2 and (c[2] < o[2]) and (math.abs(c[1] - o[1]) < 0.3 * atr) and (c > o) and (c > (o[2] + c[2]) / 2.0)

export isEveningStar(series float o, series float c, series float atr) =>
    bar_index >= 2 and (c[2] > o[2]) and (math.abs(c[1] - o[1]) < 0.3 * atr) and (c < o) and (c < (o[2] + c[2]) / 2.0)

export isThreeWhiteSoldiers(series float o, series float h, series float c, series float atr) =>
    bar_index >= 2 and (c[2] > o[2]) and ((c[2] - o[2]) > atr) and ((h[2] - c[2]) < 0.3 * atr) and (c[1] > o[1]) and ((c[1] - o[1]) > atr) and ((h[1] - c[1]) < 0.3 * atr) and (c > o) and ((c - o) > atr) and ((h - c) < 0.3 * atr) and (o[1] > o[2]) and (o[1] < c[2]) and (c[1] > c[2]) and (o > o[1]) and (o < c[1]) and (c > c[1])

export isThreeBlackCrows(series float o, series float l, series float c, series float atr) =>
    bar_index >= 2 and (c[2] < o[2]) and ((o[2] - c[2]) > atr) and ((o[2] - l[2]) < 0.3 * atr) and (c[1] < o[1]) and ((o[1] - c[1]) > atr) and ((o[1] - l[1]) < 0.3 * atr) and (c < o) and ((o - c) > atr) and ((o - l) < 0.3 * atr) and (o[1] < o[2]) and (o[1] > c[2]) and (c[1] < c[2]) and (o < o[1]) and (o > c[1]) and (c < c[1])

export isBullishHarami(series float o, series float c, series float atr) =>
    bar_index >= 1 and (c[1] < o[1]) and ((o[1] - c[1]) > atr) and (c > o) and (o > c[1]) and (c < o[1])

export isBearishHarami(series float o, series float c, series float atr) =>
    bar_index >= 1 and (c[1] > o[1]) and ((c[1] - o[1]) > atr) and (c < o) and (o < c[1]) and (c > o[1])

export isBullishEngulfing(series float o, series float c) =>
    bar_index >= 1 and (c[1] < o[1]) and (c > o) and (o < c[1]) and (c > o[1])

export isBearishEngulfing(series float o, series float c) =>
    bar_index >= 1 and (c[1] > o[1]) and (c < o) and (o > c[1]) and (c < o[1])

export isThreeInsideUp(series float o, series float h, series float c, series float atr) =>
    bar_index >= 2 and (c[2] < o[2]) and ((o[2] - c[2]) > atr) and (c[1] > o[1]) and (o[1] > c[2]) and (c[1] < o[2]) and (c > o) and (c > h[1])

export isThreeInsideDown(series float o, series float l, series float c, series float atr) =>
    bar_index >= 2 and (c[2] > o[2]) and ((c[2] - o[2]) > atr) and (c[1] < o[1]) and (o[1] < c[2]) and (c[1] > o[2]) and (c < o) and (c < l[1])

export isTweezerBottom(series float o, series float l, series float c, series float atr) =>
    bar_index >= 1 and (c[1] < o[1]) and (c > o) and (math.abs(l[1] - l) < 0.1 * atr)

export isTweezerTop(series float o, series float h, series float c, series float atr) =>
    bar_index >= 1 and (c[1] > o[1]) and (c < o) and (math.abs(h[1] - h) < 0.1 * atr)

export isBullishKicker(series float o, series float c) =>
    bar_index >= 1 and (c[1] < o[1]) and (c > o) and (o > o[1])

export isBearishKicker(series float o, series float c) =>
    bar_index >= 1 and (c[1] > o[1]) and (c < o) and (o < o[1])

export isBullishBreakaway(series float o, series float c, series float atr) =>
    bar_index >= 4 and (c[4] < o[4]) and ((o[4] - c[4]) > atr) and (c > o) and ((c - o) > atr) and (c > o[4])

export isBearishBreakaway(series float o, series float c, series float atr) =>
    bar_index >= 4 and (c[4] > o[4]) and ((c[4] - o[4]) > atr) and (c < o) and ((o - c) > atr) and (c < o[4])

// -----------------------------------------------------
// Single-candle patterns
// -----------------------------------------------------

export isHammer(series float o, series float h, series float l, series float c, series float atr) =>
    bar_index >= 0 and (math.abs(c - o) < 0.3 * atr) and ((math.min(o, c) - l) >= 2.0 * math.abs(c - o)) and ((h - math.max(o, c)) <= 0.5 * math.abs(c - o))

export isShootingStar(series float o, series float h, series float l, series float c, series float atr) =>
    bar_index >= 0 and (math.abs(c - o) < 0.3 * atr) and ((h - math.max(o, c)) >= 2.0 * math.abs(c - o)) and ((math.min(o, c) - l) <= 0.5 * math.abs(c - o))

export isStandardDoji(series float o, series float c, series float atr) =>
    bar_index >= 0 and (math.abs(c - o) < 0.1 * atr)

export isDragonflyDoji(series float o, series float h, series float l, series float c, series float atr) =>
    bar_index >= 0 and (math.abs(c - o) < 0.1 * atr) and ((math.min(o, c) - l) > 0.5 * atr) and ((h - math.max(o, c)) < 0.1 * atr)

export isGravestoneDoji(series float o, series float h, series float l, series float c, series float atr) =>
    bar_index >= 0 and (math.abs(c - o) < 0.1 * atr) and ((h - math.max(o, c)) > 0.5 * atr) and ((math.min(o, c) - l) < 0.1 * atr)

export isBullishMarubozu(series float o, series float h, series float l, series float c, series float atr) =>
    bar_index >= 0 and (c > o) and ((h - c) < 0.1 * atr) and ((o - l) < 0.1 * atr)

export isBearishMarubozu(series float o, series float h, series float l, series float c, series float atr) =>
    bar_index >= 0 and (c < o) and ((h - o) < 0.1 * atr) and ((c - l) < 0.1 * atr)

export isSpinningTop(series float o, series float h, series float l, series float c, series float atr) =>
    bar_index >= 0 and (math.abs(c - o) < 0.3 * atr) and ((h - math.max(o, c)) > 0.5 * atr) and ((math.min(o, c) - l) > 0.5 * atr)

// -----------------------------------------------------
// Aggregators (unified signature for easy use)
// -----------------------------------------------------

// Bullish set (as “rising patterns”)
export bullAny(series float o, series float h, series float l, series float c, series float atr) =>
    isMorningStar(o, c, atr) or isThreeWhiteSoldiers(o, h, c, atr) or isBullishHarami(o, c, atr) or isBullishEngulfing(o, c) or isThreeInsideUp(o, h, c, atr) or isTweezerBottom(o, l, c, atr) or isBullishKicker(o, c) or isBullishBreakaway(o, c, atr) or isHammer(o, h, l, c, atr) or isDragonflyDoji(o, h, l, c, atr) or isBullishMarubozu(o, h, l, c, atr)

// Bearish set (as “falling patterns”)
export bearAny(series float o, series float h, series float l, series float c, series float atr) =>
    isEveningStar(o, c, atr) or isThreeBlackCrows(o, l, c, atr) or isBearishHarami(o, c, atr) or isBearishEngulfing(o, c) or isThreeInsideDown(o, l, c, atr) or isTweezerTop(o, h, c, atr) or isBearishKicker(o, c) or isBearishBreakaway(o, c, atr) or isShootingStar(o, h, l, c, atr) or isGravestoneDoji(o, h, l, c, atr) or isBearishMarubozu(o, h, l, c, atr)

// Neutral set (optional)
export neutralAny(series float o, series float h, series float l, series float c, series float atr) =>
    isStandardDoji(o, c, atr) or isSpinningTop(o, h, l, c, atr)



// strong body helper (그대로)
strongBody(series float o, series float c, series float atr) => math.abs(c - o) > atr * 0.5

// Strong Bullish (o,h,c,atr)
export bullStrong(series float o, series float h, series float c, series float atr) => strongBody(o, c, atr) and (isMorningStar(o, c, atr) or isBullishEngulfing(o, c) or isThreeWhiteSoldiers(o, h, c, atr) or isThreeInsideUp(o, h, c, atr) or isBullishHarami(o, c, atr))

// Strong Bearish (o,l,c,atr)  ✅ high 제거
export bearStrong(series float o, series float l, series float c, series float atr) => strongBody(o, c, atr) and (isEveningStar(o, c, atr) or isBearishEngulfing(o, c) or isThreeBlackCrows(o, l, c, atr) or isThreeInsideDown(o, l, c, atr) or isBearishHarami(o, c, atr))
