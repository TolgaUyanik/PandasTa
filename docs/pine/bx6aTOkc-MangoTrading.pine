//@version=6

// @description TODO: add library description here
library("MangoTrading", overlay=false)

// 메시지 생성 함수
get_mango_json(position, action) =>
    (
        "{" +
        "\"exchange\": \"" + syminfo.prefix + "\"," +
        "\"ticker\": \"" + syminfo.ticker + "\"," +
        "\"price\": \"" + str.tostring(close) + "\"," +
        "\"position\": \"" + str.tostring(position) + "\"," +
        "\"action\": \"" + str.tostring(action) + "\"," +
        "\"timenow\": \"" + str.tostring(timenow) + "\"" +
        "}"
    )


// 자동 감지 + 알림 발송 (export로 공개)
export mango_auto_alert() =>
    prev_size = nz(strategy.position_size[1])
    curr_size = strategy.position_size
    
    if curr_size > prev_size and curr_size > 0 and prev_size >= 0
        get_mango_json("long", "open")
    else if curr_size < prev_size and curr_size < 0 and prev_size <= 0
        get_mango_json("short", "open")
    else if prev_size > 0 and curr_size <= 0
        get_mango_json("long", "close")
    else if prev_size < 0 and curr_size >= 0
        get_mango_json("short", "close")
    else
        na