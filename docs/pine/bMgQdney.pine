//@version=5
indicator("MACD H4 on M15 Chart)", overlay=false)

// Parâmetros do MACD
fastLen   = input.int(12, minval=1, title="MACD Rápido")
slowLen   = input.int(26, minval=1, title="MACD Lento")
signalLen = input.int(9, minval=1, title="MACD Sinal")

// Timeframe do MACD
tf = "240"  // H4

// Obter o MACD do H4
[m_line, s_line, h_line] = request.security(syminfo.tickerid, tf, ta.macd(close, fastLen, slowLen, signalLen))

// Cor do histograma
histColor = h_line >= 0 ?
     (h_line > h_line[1] ? color.lime : color.green) :
     (h_line < h_line[1] ? color.red : color.maroon)

// Plots principais
pMacd   = plot(m_line, title="MACD H4", color=color.aqua, linewidth=2)
pSignal = plot(s_line, title="Sinal H4", color=color.orange, linewidth=2)

// Preenchimento entre MACD e Sinal
fill(pMacd, pSignal, color=color.new(color.gray, 85))

// Plot do histograma
plot(h_line, title="Histograma H4", style=plot.style_columns, color=histColor)
