//@version=6
indicator("Prop Firm Consistency Tracker [XWiseTrade]", shorttitle = "Consistency Tracker", overlay = true)

// ============================== INPUTS ==============================
grpA = "Account State"
priorProfit   = input.float(2000.0, "Total profit BEFORE today ($)", minval = 0, group = grpA, tooltip = "Accumulated profit on this account before today's session. Update once per day.")
realizedToday = input.float(0.0, "Realized P&L today ($)", group = grpA, tooltip = "Sum of your CLOSED trades today. Update after each close.")

grpR = "Consistency Rule"
capPctIn  = input.float(40.0, "Consistency cap (%)", minval = 1, maxval = 99, group = grpR, tooltip = "Max share of total profit a single day may contribute. Common: FundedNext Rapid 40%, Apex 30%, FundingPips 40%. Check YOUR firm's exact rule.")
warnPctIn = input.float(80.0, "Warn at (% of cap used)", minval = 10, maxval = 100, group = grpR)

grpP = "Live Position (optional - this is what makes it real-time)"
hasPos     = input.bool(false, "Track an open position", group = grpP)
posSide    = input.string("Long", "Side", options = ["Long", "Short"], group = grpP)
entryPrice = input.float(0.0, "Entry price", minval = 0, group = grpP)
qty        = input.float(1.0, "Contracts / lots", minval = 0, group = grpP)
pointValue = input.float(2.0, "$ per 1.0 price move (per contract)", minval = 0, group = grpP, tooltip = "MNQ = $2, NQ = $20, MES = $5, ES = $50, GC = $100, MGC = $10. For FX use pip value x pips per 1.0.")

capPct  = capPctIn / 100.0
warnPct = warnPctIn / 100.0

// ============================== LIVE P&L ==============================
float unreal = 0.0
if hasPos and entryPrice > 0
    unreal := (posSide == "Long" ? close - entryPrice : entryPrice - close) * qty * pointValue

todayPnl   = realizedToday + unreal
totalAfter = priorProfit + todayPnl

// ============================== CONSISTENCY MATH ==============================
todayShare = totalAfter > 0 ? math.max(todayPnl, 0.0) / totalAfter : 0.0

float roomLeft = na
if capPct < 1.0
    roomLeft := (capPct * totalAfter - math.max(todayPnl, 0.0)) / (1.0 - capPct)
    roomLeft := math.max(roomLeft, 0.0)

violated = todayPnl > 0 and todayShare > capPct
warned   = not violated and todayPnl > 0 and todayShare > capPct * warnPct

// ============================== VISUAL ALERT ==============================
shareColor = violated ? color.red : warned ? color.orange : color.new(#26a69a, 0)
bgcolor(violated ? color.new(color.red, 85) : warned ? color.new(color.orange, 90) : na)

// ============================== DASHBOARD ==============================
var table t = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.new(color.gray, 60))
if barstate.islast
    statusTxt = violated ? "VIOLATED" : warned ? "WARNING" : "SAFE"
    statusCol = violated ? color.red : warned ? color.orange : color.new(#26a69a, 0)
    table.cell(t, 0, 0, "Consistency Tracker", text_color = color.white, bgcolor = color.new(color.blue, 40))
    table.cell(t, 1, 0, statusTxt, text_color = color.white, bgcolor = statusCol)
    table.cell(t, 0, 1, "Total profit (incl. today)", text_color = color.white)
    table.cell(t, 1, 1, "$" + str.tostring(totalAfter, "#,###.##"), text_color = color.white)
    table.cell(t, 0, 2, "Today P&L (real + open)", text_color = color.white)
    table.cell(t, 1, 2, "$" + str.tostring(todayPnl, "#,###.##"), text_color = todayPnl >= 0 ? color.new(#26a69a, 0) : color.red)
    table.cell(t, 0, 3, "Today's share", text_color = color.white)
    table.cell(t, 1, 3, str.tostring(todayShare * 100, "#.##") + "%", text_color = shareColor)
    table.cell(t, 0, 4, "Cap", text_color = color.white)
    table.cell(t, 1, 4, str.tostring(capPctIn, "#.#") + "%", text_color = color.red)
    table.cell(t, 0, 5, "Room left today", text_color = color.white)
    table.cell(t, 1, 5, na(roomLeft) ? "n/a" : "$" + str.tostring(roomLeft, "#,###.##"), text_color = color.white)
    table.cell(t, 0, 6, "Open P&L (live)", text_color = color.white)
    table.cell(t, 1, 6, "$" + str.tostring(unreal, "#,###.##"), text_color = unreal >= 0 ? color.new(#26a69a, 0) : color.red)

// ============================== ALERTS ==============================
alertcondition(warned,   "Consistency warning",  "Today's profit share crossed the warning level - consider slowing down.")
alertcondition(violated, "Consistency VIOLATED", "Today's profit share exceeds your consistency cap.")