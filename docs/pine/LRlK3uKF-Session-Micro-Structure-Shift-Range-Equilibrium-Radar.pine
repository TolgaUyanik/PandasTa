//@version=6
indicator("Session Micro-Structure Shift & Range Equilibrium Radar [SMC / ICT]", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ==========================================
// INPUTS & USER CONFIGURATION
// ==========================================
GRP_SESS = "Session Configurations (UTC-4 / New York Time)"
asiaSessInput   = input.session("2000-0000", "Asian Session", group = GRP_SESS)
londonSessInput = input.session("0200-0600", "London Session", group = GRP_SESS)
nySessInput     = input.session("0800-1200", "New York Session", group = GRP_SESS)
tzInput         = input.string("America/New_York", "Timezone", group = GRP_SESS)

GRP_LABEL = "Session Text Settings"
asiaText    = input.string("ASIA", "Asia Session Label", group = GRP_LABEL)
londonText  = input.string("LONDON", "London Session Label", group = GRP_LABEL)
nyText      = input.string("NY", "NY Session Label", group = GRP_LABEL)
lblSizeInput = input.string("small", "Label Size", options = ["tiny", "small", "normal", "large"], group = GRP_LABEL)

GRP_VIS = "Visual Customizations"
asiaColor    = input.color(color.new(color.blue, 90), "Asia Range Color", group = GRP_VIS)
londonColor  = input.color(color.new(color.purple, 90), "London Range Color", group = GRP_VIS)
nyColor      = input.color(color.new(color.orange, 90), "NY Range Color", group = GRP_VIS)
eqLineColor  = input.color(color.gray, "Equilibrium Line Color", group = GRP_VIS)
mssBullColor = input.color(color.green, "Bullish MSS Color", group = GRP_VIS)
mssBearColor = input.color(color.red, "Bearish MSS Color", group = GRP_VIS)

GRP_ALT = "Alert Settings"
enableAlerts = input.bool(true, "Enable MSS + FVG Tap Alerts", group = GRP_ALT)

// ==========================================
// SESSION CALCULATION
// ==========================================
inAsia   = not na(time(timeframe.period, asiaSessInput, tzInput))
inLondon = not na(time(timeframe.period, londonSessInput, tzInput))
inNy     = not na(time(timeframe.period, nySessInput, tzInput))

// Asia Session
var box asiaBox = na
var line asiaEqLine = na
var float asiaHigh = na
var float asiaLow = na
var float asiaEq = na
var bool asiaActive = false

asiaStart = inAsia and not asiaActive
asiaActive := inAsia

asiaHigh := asiaStart ? high : inAsia ? math.max(asiaHigh, high) : asiaHigh
asiaLow := asiaStart ? low : inAsia ? math.min(asiaLow, low) : asiaLow
asiaEq := (asiaHigh + asiaLow) / 2.0

if asiaStart
    asiaBox := box.new(left = bar_index, top = high, right = bar_index, bottom = low, bgcolor = asiaColor, border_style = line.style_dashed, border_color = color.new(asiaColor, 50), text = asiaText, text_color = color.white, text_size = lblSizeInput, text_halign = text.align_right, text_valign = text.align_top)
    asiaEqLine := line.new(x1 = bar_index, y1 = asiaEq, x2 = bar_index, y2 = asiaEq, color = eqLineColor, style = line.style_dotted, width = 2)

if inAsia and not asiaStart
    box.set_top(asiaBox, asiaHigh)
    box.set_bottom(asiaBox, asiaLow)
    box.set_right(asiaBox, bar_index)
    line.set_y1(asiaEqLine, asiaEq)
    line.set_y2(asiaEqLine, asiaEq)
    line.set_x2(asiaEqLine, bar_index)

// London Session
var box londonBox = na
var line londonEqLine = na
var float londonHigh = na
var float londonLow = na
var float londonEq = na
var bool londonActive = false

londonStart = inLondon and not londonActive
londonActive := inLondon

londonHigh := londonStart ? high : inLondon ? math.max(londonHigh, high) : londonHigh
londonLow := londonStart ? low : inLondon ? math.min(londonLow, low) : londonLow
londonEq := (londonHigh + londonLow) / 2.0

if londonStart
    londonBox := box.new(left = bar_index, top = high, right = bar_index, bottom = low, bgcolor = londonColor, border_style = line.style_dashed, border_color = color.new(londonColor, 50), text = londonText, text_color = color.white, text_size = lblSizeInput, text_halign = text.align_right, text_valign = text.align_top)
    londonEqLine := line.new(x1 = bar_index, y1 = londonEq, x2 = bar_index, y2 = londonEq, color = eqLineColor, style = line.style_dotted, width = 2)

if inLondon and not londonStart
    box.set_top(londonBox, londonHigh)
    box.set_bottom(londonBox, londonLow)
    box.set_right(londonBox, bar_index)
    line.set_y1(londonEqLine, londonEq)
    line.set_y2(londonEqLine, londonEq)
    line.set_x2(londonEqLine, bar_index)

// NY Session
var box nyBox = na
var line nyEqLine = na
var float nyHigh = na
var float nyLow = na
var float nyEq = na
var bool nyActive = false

nyStart = inNy and not nyActive
nyActive := inNy

nyHigh := nyStart ? high : inNy ? math.max(nyHigh, high) : nyHigh
nyLow := nyStart ? low : inNy ? math.min(nyLow, low) : nyLow
nyEq := (nyHigh + nyLow) / 2.0

if nyStart
    nyBox := box.new(left = bar_index, top = high, right = bar_index, bottom = low, bgcolor = nyColor, border_style = line.style_dashed, border_color = color.new(nyColor, 50), text = nyText, text_color = color.white, text_size = lblSizeInput, text_halign = text.align_right, text_valign = text.align_top)
    nyEqLine := line.new(x1 = bar_index, y1 = nyEq, x2 = bar_index, y2 = nyEq, color = eqLineColor, style = line.style_dotted, width = 2)

if inNy and not nyStart
    box.set_top(nyBox, nyHigh)
    box.set_bottom(nyBox, nyLow)
    box.set_right(nyBox, bar_index)
    line.set_y1(nyEqLine, nyEq)
    line.set_y2(nyEqLine, nyEq)
    line.set_x2(nyEqLine, bar_index)

// ==========================================
// LIQUIDITY & EQUILIBRIUM
// ==========================================
var float globalPrevHigh = na
var float globalPrevLow = na

if not asiaActive and asiaActive[1]
    globalPrevHigh := asiaHigh
    globalPrevLow := asiaLow

if not londonActive and londonActive[1]
    globalPrevHigh := math.max(nz(globalPrevHigh, londonHigh), londonHigh)
    globalPrevLow := math.min(nz(globalPrevLow, londonLow), londonLow)

currentActiveEq = asiaActive ? asiaEq : londonActive ? londonEq : nyActive ? nyEq : na

// ==========================================
// MSS + FVG LOGIC & SINGLE ALERT PER SESSION
// ==========================================
isConfirmed = barstate.isconfirmed

var bool sessionAlertFired = false
var bool sweptLow = false
var bool sweptHigh = false

sessionReset = (asiaActive and not asiaActive[1]) or (londonActive and not londonActive[1]) or (nyActive and not nyActive[1])
if sessionReset
    sessionAlertFired := false
    sweptLow := false
    sweptHigh := false

if isConfirmed and not na(globalPrevLow) and low < globalPrevLow
    sweptLow := true

if isConfirmed and not na(globalPrevHigh) and high > globalPrevHigh
    sweptHigh := true

bullDisplacement = close > open and (close - open) > (ta.atr(14) * 0.8)
bearDisplacement = open > close and (open - close) > (ta.atr(14) * 0.8)

bullMSS = isConfirmed and sweptLow and bullDisplacement and not na(currentActiveEq) and close > currentActiveEq
bearMSS = isConfirmed and sweptHigh and bearDisplacement and not na(currentActiveEq) and close < currentActiveEq

bullFVG = low > high[2]
bearFVG = high < low[2]

var box activeFvgBox = na
var float fvgTop = na
var float fvgBottom = na
var bool awaitingFvgTap = false
var string fvgType = ""

if bullMSS and bullFVG and not sessionAlertFired
    fvgTop := low
    fvgBottom := high[2]
    awaitingFvgTap := true
    fvgType := "BULLISH"
    sweptLow := false
    line.new(x1 = bar_index[2], y1 = currentActiveEq, x2 = bar_index, y2 = currentActiveEq, color = mssBullColor, style = line.style_dashed, width = 2)
    label.new(x = bar_index, y = currentActiveEq, text = "Bullish MSS", color = color.new(mssBullColor, 100), textcolor = mssBullColor, style = label.style_label_left, size = size.small)
    activeFvgBox := box.new(left = bar_index - 2, top = fvgTop, right = bar_index + 5, bottom = fvgBottom, bgcolor = color.new(color.green, 85), border_color = color.green)

if bearMSS and bearFVG and not sessionAlertFired
    fvgTop := low[2]
    fvgBottom := high
    awaitingFvgTap := true
    fvgType := "BEARISH"
    sweptHigh := false
    line.new(x1 = bar_index[2], y1 = currentActiveEq, x2 = bar_index, y2 = currentActiveEq, color = mssBearColor, style = line.style_dashed, width = 2)
    label.new(x = bar_index, y = currentActiveEq, text = "Bearish MSS", color = color.new(mssBearColor, 100), textcolor = mssBearColor, style = label.style_label_left, size = size.small)
    activeFvgBox := box.new(left = bar_index - 2, top = fvgTop, right = bar_index + 5, bottom = fvgBottom, bgcolor = color.new(color.red, 85), border_color = color.red)

if awaitingFvgTap and not sessionAlertFired and fvgType == "BULLISH" and low <= fvgTop and high >= fvgBottom
    sessionAlertFired := true
    awaitingFvgTap := false
    box.set_bgcolor(activeFvgBox, color.new(color.gray, 90))
    if enableAlerts
        alert("Bullish MSS + FVG Tap Alert Triggered!", alert.freq_once_per_bar_close)

if awaitingFvgTap and not sessionAlertFired and fvgType == "BEARISH" and high >= fvgBottom and low <= fvgTop
    sessionAlertFired := true
    awaitingFvgTap := false
    box.set_bgcolor(activeFvgBox, color.new(color.gray, 90))
    if enableAlerts
        alert("Bearish MSS + FVG Tap Alert Triggered!", alert.freq_once_per_bar_close)
