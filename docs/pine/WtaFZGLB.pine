array.set(ticker_sh2s, 10, sh2_11)
array.set(ticker_sh2s, 11, sh2_12)

array.set(ticker_e3_ons, 0, e3_on1)
array.set(ticker_e3_ons, 1, e3_on2)
array.set(ticker_e3_ons, 2, e3_on3)
array.set(ticker_e3_ons, 3, e3_on4)
array.set(ticker_e3_ons, 4, e3_on5)
array.set(ticker_e3_ons, 5, e3_on6)
array.set(ticker_e3_ons, 6, e3_on7)
array.set(ticker_e3_ons, 7, e3_on8)
array.set(ticker_e3_ons, 8, e3_on9)
array.set(ticker_e3_ons, 9, e3_on10)
array.set(ticker_e3_ons, 10, e3_on11)
array.set(ticker_e3_ons, 11, e3_on12)

array.set(ticker_e3_offs, 0, e3_off1)
array.set(ticker_e3_offs, 1, e3_off2)
array.set(ticker_e3_offs, 2, e3_off3)
array.set(ticker_e3_offs, 3, e3_off4)
array.set(ticker_e3_offs, 4, e3_off5)
array.set(ticker_e3_offs, 5, e3_off6)
array.set(ticker_e3_offs, 6, e3_off7)
array.set(ticker_e3_offs, 7, e3_off8)
array.set(ticker_e3_offs, 8, e3_off9)
array.set(ticker_e3_offs, 9, e3_off10)
array.set(ticker_e3_offs, 10, e3_off11)
array.set(ticker_e3_offs, 11, e3_off12)

array.set(ticker_e3_inps, 0, e3_inp1)
array.set(ticker_e3_inps, 1, e3_inp2)
array.set(ticker_e3_inps, 2, e3_inp3)
array.set(ticker_e3_inps, 3, e3_inp4)
array.set(ticker_e3_inps, 4, e3_inp5)
array.set(ticker_e3_inps, 5, e3_inp6)
array.set(ticker_e3_inps, 6, e3_inp7)
array.set(ticker_e3_inps, 7, e3_inp8)
array.set(ticker_e3_inps, 8, e3_inp9)
array.set(ticker_e3_inps, 9, e3_inp10)
array.set(ticker_e3_inps, 10, e3_inp11)
array.set(ticker_e3_inps, 11, e3_inp12)

array.set(ticker_sh3s, 0, sh3_1)
array.set(ticker_sh3s, 1, sh3_2)
array.set(ticker_sh3s, 2, sh3_3)
array.set(ticker_sh3s, 3, sh3_4)
array.set(ticker_sh3s, 4, sh3_5)
array.set(ticker_sh3s, 5, sh3_6)
array.set(ticker_sh3s, 6, sh3_7)
array.set(ticker_sh3s, 7, sh3_8)
array.set(ticker_sh3s, 8, sh3_9)
array.set(ticker_sh3s, 9, sh3_10)
array.set(ticker_sh3s, 10, sh3_11)
array.set(ticker_sh3s, 11, sh3_12)

// === Portfolio-Summen Variablen (werden bei jedem Bar neu berechnet) ===
float total_pnl_sum = 0.0
float total_risk_sum = 0.0
float total_portfolio_value = 0.0
int position_count = 0

// === HAUPTLOGIK: Berechnung, Linien, Labels, Tabelle für 12 Ticker ===
for i = 0 to 11
    _sym = array.get(ticker_syms, i)
    _sh1 = array.get(ticker_sh1s, i)
    _pr1 = array.get(ticker_pr1s, i)
    _stop_fixed = array.get(ticker_stops, i)
    _stop_ema10_off = array.get(ticker_stop_ema10_offs, i)
    _stop_ema21_off = array.get(ticker_stop_ema21_offs, i)
    _e2_on = array.get(ticker_e2_ons, i)
    _e2_off = array.get(ticker_e2_offs, i)
    _e2_inp = array.get(ticker_e2_inps, i)
    _sh2 = array.get(ticker_sh2s, i)
    _e3_on = array.get(ticker_e3_ons, i)
    _e3_off = array.get(ticker_e3_offs, i)
    _e3_inp = array.get(ticker_e3_inps, i)
    _sh3 = array.get(ticker_sh3s, i)

    // Berechnung für alle aktiven Positionen (für Portfolio-Summen)
    // Pine v6: Dynamic Requests erlauben request.security() im Loop!
    // 12 Ticker × 3 Requests = 36 Requests (unter dem 40er Limit)
    if _sym != "" and _sh1 > 0 and _pr1 > 0
        pr2_ = _e2_inp > 0 ? _e2_inp : _pr1 * (1 + _e2_off / 100)
        pr3_ = _e3_inp > 0 ? _e3_inp : _pr1 * (1 + _e3_off / 100)
        total_shares = _sh1 + (_e2_on and _sh2 > 0 and pr2_ > 0 ? _sh2 : 0) + (_e3_on and _sh3 > 0 and pr3_ > 0 ? _sh3 : 0)
        avg_cost = total_shares > 0 ? ((_sh1 * _pr1) + (_e2_on and _sh2 > 0 and pr2_ > 0 ? _sh2 * pr2_ : 0) + (_e3_on and _sh3 > 0 and pr3_ > 0 ? _sh3 * pr3_ : 0)) / total_shares : na

        // Position zählen
        position_count += 1

        // Portfolio-Wert für diese Position (Einstandswert)
        position_value = avg_cost * total_shares
        total_portfolio_value += position_value

        // Echten Kurs und EMAs für JEDEN Ticker via request.security() holen
        // EMA vom letzten abgeschlossenen Tag (close[1]) für stabile Stop-Berechnung
        [ticker_close, ticker_ema10, ticker_ema21] = request.security(_sym, "D", [close, ta.ema(close[1], 10), ta.ema(close[1], 21)], lookahead=barmerge.lookahead_on)

        if not na(ticker_close)
            // PnL für diesen Ticker
            ticker_pnl = (ticker_close - avg_cost) * total_shares
            total_pnl_sum += ticker_pnl

            // Effektiven Stop berechnen (EMA10-Offset > EMA21-Offset > Fixed)
            ticker_stop_ema10 = _stop_ema10_off != 0 and not na(ticker_ema10) ? ticker_ema10 * (1 + _stop_ema10_off / 100) : na
            ticker_stop_ema21 = _stop_ema21_off != 0 and not na(ticker_ema21) ? ticker_ema21 * (1 + _stop_ema21_off / 100) : na
            ticker_effective_stop = not na(ticker_stop_ema10) ? ticker_stop_ema10 : (not na(ticker_stop_ema21) ? ticker_stop_ema21 : _stop_fixed)

            // Risiko (Stop→Entry) für diesen Ticker
            if ticker_effective_stop > 0
                ticker_risk = (ticker_effective_stop - avg_cost) * total_shares
                total_risk_sum += ticker_risk

    // Anzeige nur für aktuellen Chart-Ticker
    if (_sym == syminfo.ticker and _sh1 > 0 and _pr1 > 0)
        pr2_ = _e2_inp > 0 ? _e2_inp : _pr1 * (1 + _e2_off / 100)
        pr3_ = _e3_inp > 0 ? _e3_inp : _pr1 * (1 + _e3_off / 100)
        total_shares = _sh1 + (_e2_on and _sh2 > 0 and pr2_ > 0 ? _sh2 : 0) + (_e3_on and _sh3 > 0 and pr3_ > 0 ? _sh3 : 0)
        avg_cost = total_shares > 0 ? ((_sh1 * _pr1) + (_e2_on and _sh2 > 0 and pr2_ > 0 ? _sh2 * pr2_ : 0) + (_e3_on and _sh3 > 0 and pr3_ > 0 ? _sh3 * pr3_ : 0)) / total_shares : na
        pnl_dollar = (close - avg_cost) * total_shares
        pnl_pct = (close / avg_cost - 1) * 100

        // Effektiver Stop für Chart-Ticker berechnen
        // Priorität: EMA10-Offset > EMA21-Offset > Fester Stop
        // Offset negativ = Stop unter EMA (z.B. -2% = EMA * 0.98)
        // Offset positiv = Stop über EMA (z.B. +2% = EMA * 1.02)
        _stop_from_ema10 = _stop_ema10_off != 0 ? ema10 * (1 + _stop_ema10_off / 100) : na
        _stop_from_ema21 = _stop_ema21_off != 0 ? ema21 * (1 + _stop_ema21_off / 100) : na
        effective_stop = not na(_stop_from_ema10) ? _stop_from_ema10 : (not na(_stop_from_ema21) ? _stop_from_ema21 : _stop_fixed)

        // EMA/SMA Abstände für Tabelle (OHNE Offset - reine EMA/SMA Werte)
        dist_ema10 = (ema10 / avg_cost - 1) * 100
        dist_ema21 = (ema21 / avg_cost - 1) * 100
        dist_sma200 = (sma200_15m / avg_cost - 1) * 100
        dollar_ema10 = (ema10 - avg_cost) * total_shares
        dollar_ema21 = (ema21 - avg_cost) * total_shares
        dollar_sma200 = (sma200_15m - avg_cost) * total_shares

        // Stop-Berechnung: Stop→Entry (Abstand vom Stop zum Einstiegskurs)
        // Negativ wenn Stop < Entry, Positiv wenn Stop > Entry (Trailing)
        stop_to_entry_pct = effective_stop > 0 ? ((effective_stop / avg_cost) - 1) * 100 : na
        stop_to_entry_dollar = effective_stop > 0 ? (effective_stop - avg_cost) * total_shares : na

        // Stop-Warnung: Abstand Kurs zu Stop in %
        // Warnung wenn Kurs weniger als stopWarnPct % über Stop liegt
        stop_distance_pct = effective_stop > 0 ? ((close / effective_stop) - 1) * 100 : na
        stop_warning = effective_stop > 0 and not na(stop_distance_pct) and stop_distance_pct < stopWarnPct and stop_distance_pct > 0

        // Linien und Labels avg_cost zeichnen / aktualisieren
        if na(array.get(avg_lines, i))
            array.set(avg_lines, i, line.new(bar_index, avg_cost, bar_index + 1, avg_cost, color=color.yellow, width=2, extend=extend.right, style=line.style_dashed))
            array.set(avg_labels, i, label.new(bar_index + x_offset, avg_cost, fmt2(avg_cost), style=label_style(label_pos_str), color=color.yellow, textcolor=color.black, size=f_label_size(label_size_str)))
        else
            line.set_xy1(array.get(avg_lines, i), bar_index, avg_cost)
            line.set_xy2(array.get(avg_lines, i), bar_index + 1, avg_cost)
            label.set_xy(array.get(avg_labels, i), bar_index + x_offset, avg_cost)
            label.set_text(array.get(avg_labels, i), fmt2(avg_cost))

        // Linien und Labels E2
        if _e2_on
            if na(array.get(e2_lines, i))
                array.set(e2_lines, i, line.new(bar_index, pr2_, bar_index + 1, pr2_, color=color.blue, width=2, extend=extend.right))
                array.set(e2_labels, i, label.new(bar_index + x_offset, pr2_, fmt2(pr2_), style=label_style(label_pos_str), color=color.blue, textcolor=color.white, size=f_label_size(label_size_str)))
            else
                line.set_xy1(array.get(e2_lines, i), bar_index, pr2_)
                line.set_xy2(array.get(e2_lines, i), bar_index + 1, pr2_)
                label.set_xy(array.get(e2_labels, i), bar_index + x_offset, pr2_)
                label.set_text(array.get(e2_labels, i), fmt2(pr2_))

        // Linien und Labels E3
        if _e3_on
            if na(array.get(e3_lines, i))
                array.set(e3_lines, i, line.new(bar_index, pr3_, bar_index + 1, pr3_, color=color.purple, width=2, extend=extend.right))
                array.set(e3_labels, i, label.new(bar_index + x_offset, pr3_, fmt2(pr3_), style=label_style(label_pos_str), color=color.purple, textcolor=color.white, size=f_label_size(label_size_str)))
            else
                line.set_xy1(array.get(e3_lines, i), bar_index, pr3_)
                line.set_xy2(array.get(e3_lines, i), bar_index + 1, pr3_)
                label.set_xy(array.get(e3_labels, i), bar_index + x_offset, pr3_)
                label.set_text(array.get(e3_labels, i), fmt2(pr3_))

        // Linien und Labels Stop (Magenta, gestrichelt)
        // Verwendet effective_stop (EMA-basiert oder fester Stop)
        // IMMER alte Linie löschen und neue zeichnen (nicht nur auf islast)
        // Alte Linie/Label löschen falls vorhanden
        old_stop_line = array.get(stop_lines, i)
        old_stop_label = array.get(stop_labels, i)
        if not na(old_stop_line)
            line.delete(old_stop_line)
        if not na(old_stop_label)
            label.delete(old_stop_label)

        // Neue Linie/Label nur wenn effective_stop > 0
        if effective_stop > 0
            array.set(stop_lines, i, line.new(bar_index, effective_stop, bar_index + 1, effective_stop, color=colorStop, width=2, extend=extend.right, style=line.style_dashed))
            array.set(stop_labels, i, label.new(bar_index + x_offset, effective_stop, "SL: " + fmt2(effective_stop), style=label_style(label_pos_str), color=colorStop, textcolor=color.white, size=f_label_size(label_size_str)))
        else
            array.set(stop_lines, i, na)
            array.set(stop_labels, i, na)

        // Tabelle nur für aktuellen aktiven Ticker anzeigen
        if barstate.islast
            // Zeile 0: Symbol (Überschrift mit Hintergrund)
            // Bei Stop-Warnung: Roter Hintergrund als visuelle Warnung
            sym_bgcolor = stop_warning ? color.new(colorRed, 50) : color.new(color.gray, 70)
            table.cell(t, 0, 0, "Symbol", text_color=color.white, text_size=f_label_size(text_size_opt), bgcolor=sym_bgcolor)
            table.cell(t, 1, 0, stop_warning ? _sym + " ⚠" : _sym, text_color=stop_warning ? color.white : colorGreen, text_size=f_label_size(text_size_opt), bgcolor=sym_bgcolor)

            // Zeile 1: PnL (Format angepasst)
            table.cell(t, 0, 1, "PnL", text_color=color.white, text_size=f_label_size(text_size_opt))
            table.cell(t, 1, 1, fmtDollar(pnl_dollar) + " / " + fmtPct(pnl_pct), text_color=f_color(pnl_dollar), text_size=f_label_size(text_size_opt))

            // Zeile 2: Δ SMA200/15
            table.cell(t, 0, 2, "Δ SMA200/15", text_color=color.white, text_size=f_label_size(text_size_opt))
            table.cell(t, 1, 2, fmtDollar(dollar_sma200) + " / " + fmtPct(dist_sma200), text_color=f_color(dollar_sma200), text_size=f_label_size(text_size_opt))

            // Zeile 3: Δ DEMA10
            table.cell(t, 0, 3, "Δ DEMA10", text_color=color.white, text_size=f_label_size(text_size_opt))
            table.cell(t, 1, 3, fmtDollar(dollar_ema10) + " / " + fmtPct(dist_ema10), text_color=f_color(dollar_ema10), text_size=f_label_size(text_size_opt))

            // Zeile 4: Δ DEMA21
            table.cell(t, 0, 4, "Δ DEMA21", text_color=color.white, text_size=f_label_size(text_size_opt))
            table.cell(t, 1, 4, fmtDollar(dollar_ema21) + " / " + fmtPct(dist_ema21), text_color=f_color(dollar_ema21), text_size=f_label_size(text_size_opt))

            // Zeile 5: Stop→Entry (Abstand Stop zu Einstiegskurs)
            // Verwendet effective_stop (kann EMA-basiert oder fester Stop sein)
            table.cell(t, 0, 5, "Stop→Entry", text_color=color.white, text_size=f_label_size(text_size_opt))
            if effective_stop > 0
                table.cell(t, 1, 5, fmtDollar(stop_to_entry_dollar) + " / " + fmtPct(stop_to_entry_pct), text_color=f_color(stop_to_entry_dollar), text_size=f_label_size(text_size_opt))
            else
                table.cell(t, 1, 5, "–", text_color=color.gray, text_size=f_label_size(text_size_opt))

            // Zeile 6: Absoluter Stop-Preis (EMA mit Offset oder fester Stop)
            table.cell(t, 0, 6, "", text_color=color.white, text_size=f_label_size(text_size_opt))
            if effective_stop > 0
                table.cell(t, 1, 6, "@ " + fmt2(effective_stop), text_color=colorStop, text_size=f_label_size(text_size_opt))
            else
                table.cell(t, 1, 6, "–", text_color=color.gray, text_size=f_label_size(text_size_opt))

            // Trennlinie (dünne Linie mit Unicode-Zeichen)
            table.cell(t, 0, 7, "───────", text_color=color.gray, text_size=size.tiny)
            table.cell(t, 1, 7, "───────────────", text_color=color.gray, text_size=size.tiny)

// === PORTFOLIO-SUMMEN IMMER ANZEIGEN (außerhalb des Ticker-Loops) ===
if barstate.islast
    // Zeile 8: Positionen (X/12)
    table.cell(t, 0, 8, "Positionen", text_color=color.white, text_size=f_label_size(text_size_opt))
    table.cell(t, 1, 8, str.tostring(position_count) + "/12", text_color=color.aqua, text_size=f_label_size(text_size_opt))

    // Zeile 9: Σ PnL (Portfolio-Summe)
    table.cell(t, 0, 9, "Σ PnL", text_color=color.white, text_size=f_label_size(text_size_opt))
    table.cell(t, 1, 9, fmtDollar(total_pnl_sum), text_color=f_color(total_pnl_sum), text_size=f_label_size(text_size_opt))

    // Zeile 10: Σ Risiko (Portfolio-Risiko: Stop→Entry) mit %-Anteil
    risk_pct_of_portfolio = total_portfolio_value > 0 ? (total_risk_sum / total_portfolio_value) * 100 : 0
    table.cell(t, 0, 10, "Σ Risiko", text_color=color.white, text_size=f_label_size(text_size_opt))
    table.cell(t, 1, 10, fmtDollar(total_risk_sum) + " / " + fmtPct(risk_pct_of_portfolio), text_color=f_color(total_risk_sum), text_size=f_label_size(text_size_opt))
