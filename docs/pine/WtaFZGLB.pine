// === Arrays zum Speichern der Inputs (OHNE var - bei jedem Bar neu erstellt) ===
// WICHTIG: Kein "var" verwenden! Sonst werden alte Werte über Bars hinweg behalten
// und Input-Änderungen werden nicht sofort übernommen.
string[] ticker_syms = array.new_string(12, "")
float[] ticker_sh1s = array.new_float(12, 0.0)
float[] ticker_pr1s = array.new_float(12, 0.0)
float[] ticker_stops = array.new_float(12, 0.0)
float[] ticker_stop_ema10_offs = array.new_float(12, 0.0)
float[] ticker_stop_ema21_offs = array.new_float(12, 0.0)
bool[] ticker_e2_ons = array.new_bool(12, false)
float[] ticker_e2_offs = array.new_float(12, 0.0)
float[] ticker_e2_inps = array.new_float(12, 0.0)
float[] ticker_sh2s = array.new_float(12, 0.0)
bool[] ticker_e3_ons = array.new_bool(12, false)
float[] ticker_e3_offs = array.new_float(12, 0.0)
float[] ticker_e3_inps = array.new_float(12, 0.0)
float[] ticker_sh3s = array.new_float(12, 0.0)

// === Arrays mit Input-Werten befüllen ===
array.set(ticker_syms, 0, sym1)
