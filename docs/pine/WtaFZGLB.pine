//@version=6
indicator("PnL_EMA_TRACK12_PRO_3.7", overlay=true)

// === SETTINGS ===
table_pos_str = input.string("top_right", title="Table Position", options=["top_right","top_left","bottom_right","bottom_left","middle_right","middle_left","middle_center"], group="Display")
text_size_opt = input.string("normal", title="Text Size", options=["tiny","small","normal","large","huge"], group="Display")
label_size_str = input.string("normal", title="Label Size", options=["tiny","small","normal","large","huge"], group="Display")
label_pos_str = input.string("left", title="Label Position", options=["left","right"], group="Display")
label_x_offset = input.int(1, title="Label X Offset if left", group="Display")

// === Farb-Einstellungen ===
colorGreen = input.color(color.lime, "Positive Color (Green)", group="Farben")
colorRed = input.color(color.red, "Negative Color (Red)", group="Farben")
colorStop = input.color(color.fuchsia, "Stop Color (Magenta)", group="Farben")
stopWarnPct = input.float(3.0, "Stop Warnung unter %", step=0.5, group="Farben")

// === Hilfsfunktionen ===
f_table_pos(pos) => pos=="top_right"?position.top_right:pos=="top_left"?position.top_left:pos=="bottom_right"?position.bottom_right:pos=="bottom_left"?position.bottom_left:pos=="middle_right"?position.middle_right:pos=="middle_left"?position.middle_left:pos=="middle_center"?position.middle_center:position.top_right
f_label_size(s) => s=="tiny"?size.tiny:s=="small"?size.small:s=="normal"?size.normal:s=="large"?size.large:s=="huge"?size.huge:size.normal
f_color(val) => val >= 0 ? colorGreen : colorRed
fmt2(v) => str.tostring(v, format.mintick)
fmtPct(v) => str.tostring(v, "#.##") + "%"
fmtDollar(v) => "$" + fmt2(v)
label_style(label_pos) => label_pos=="right"?label.style_label_right:label.style_label_left

// === Tagesdaten & EMAs ===
// Wir holen den EMA vom LETZTEN ABGESCHLOSSENEN Daily Bar (close[1])
// Das verhindert Repaint während des Tages und gibt stabile Werte
// barmerge.lookahead_on mit [1] = Wert vom vorherigen abgeschlossenen Bar
[ema10, ema21] = request.security(syminfo.tickerid, "D", [ta.ema(close[1], 10), ta.ema(close[1], 21)], lookahead=barmerge.lookahead_on)
sma200_15m = request.security(syminfo.tickerid, "15", ta.sma(close, 200))

// === Tabelle initialisieren (11 Zeilen für erweiterte Anzeige) ===
var table t = na
if barstate.isfirst
    t := table.new(f_table_pos(table_pos_str), 3, 11, border_width=1)
if barstate.islast
    table.clear(t, 0, 0, 2, 10)

// === Linien & Labels Arrays für 12 Ticker ===
var line[] avg_lines = array.new_line(12, na)
var line[] e2_lines = array.new_line(12, na)
var line[] e3_lines = array.new_line(12, na)
var line[] stop_lines = array.new_line(12, na)
var label[] avg_labels = array.new_label(12, na)
var label[] e2_labels = array.new_label(12, na)
var label[] e3_labels = array.new_label(12, na)
var label[] stop_labels = array.new_label(12, na)

x_offset = label_pos_str == "left" ? -label_x_offset : label_x_offset

// === INPUTS: 12 Ticker mit Gruppierung ===
// Ticker 1: LUNR
sym1 = input.string("LUNR", title="Symbol", group="═══ Ticker 1 ═══")
sh1 = input.float(181.0, title="Shares E1", step=0.0001, group="═══ Ticker 1 ═══")
pr1 = input.float(17.98, title="Price E1", step=0.01, group="═══ Ticker 1 ═══")
stop1 = input.float(17.08, title="Stop Kurs", step=0.01, group="═══ Ticker 1 ═══")
stop_ema10_off1 = input.float(-2.0, title="Stop EMA10 Offset %", step=0.1, group="═══ Ticker 1 ═══", tooltip="-2% = Stop 2% unter EMA10")
stop_ema21_off1 = input.float(0.0, title="Stop EMA21 Offset %", step=0.1, group="═══ Ticker 1 ═══", tooltip="-2% = Stop 2% unter EMA21")
e2_on1 = input.bool(false, title="E2 aktiv", group="═══ Ticker 1 ═══")
e2_off1 = input.float(1.0, title="E2 Offset %", step=0.01, group="═══ Ticker 1 ═══")
e2_inp1 = input.float(0.0, title="E2 Preis (opt)", step=0.01, group="═══ Ticker 1 ═══")
sh2_1 = input.float(0.0, title="E2 Shares", step=0.0001, group="═══ Ticker 1 ═══")
e3_on1 = input.bool(false, title="E3 aktiv", group="═══ Ticker 1 ═══")
e3_off1 = input.float(2.0, title="E3 Offset %", step=0.01, group="═══ Ticker 1 ═══")
e3_inp1 = input.float(0.0, title="E3 Preis (opt)", step=0.01, group="═══ Ticker 1 ═══")
