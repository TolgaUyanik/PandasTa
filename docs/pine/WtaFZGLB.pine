array.set(ticker_e2_inps, 2, e2_inp3)
array.set(ticker_e2_inps, 3, e2_inp4)
array.set(ticker_e2_inps, 4, e2_inp5)
array.set(ticker_e2_inps, 5, e2_inp6)
array.set(ticker_e2_inps, 6, e2_inp7)
array.set(ticker_e2_inps, 7, e2_inp8)
array.set(ticker_e2_inps, 8, e2_inp9)
array.set(ticker_e2_inps, 9, e2_inp10)
array.set(ticker_e2_inps, 10, e2_inp11)
array.set(ticker_e2_inps, 11, e2_inp12)

array.set(ticker_sh2s, 0, sh2_1)
array.set(ticker_sh2s, 1, sh2_2)
