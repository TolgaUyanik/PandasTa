//@version=5

// @description WeightedSumIndex: Helper class to build indices. 
// Index value is a normalized weighted sum of all its input signals.
// The value is from 0 to 100
library("WeightedSumIndex", false)

// @type 			Parameters of input signal
// @field on 		Switch the signal on/off
// @field weight	Weight of the signal: how much it affects the index
// @field value 	Value of the signal: should be between min and max
// @field min		Lower bound of the signal's value
// @field max		Upper bound of the signal's value
export type Signal
    bool on = true
    float weight = 1
    float value = na
    float min = 0
    float max = 100

// @type			The Index type with its properties and stored values
// @field value 	Value of the index, must be calculated using calc() method
export type Index
	array<Signal> signals
	float value = na

// @function		Initialize an Index
// @returns 		A new instance of Index object with no signals
export init() =>
	Index.new(array.new<Signal>())

// @function 		Adds the specified signal to the index
// @param idx		The Index object
// @param signal	Signal object
export method add(Index idx, Signal signal) =>
	idx.signals.push(signal)

// @function		Caclulates the Index value
// @param idx		The Index object
// @returns 		Normalized weighted sum of all signals with on=true
export method calc(Index idx) =>
	wsum = .0
	wmax = .0
	for i = 0 to idx.signals.size() - 1
		s = idx.signals.get(i)
		if s.on
			wmax += s.weight
			wsum += s.weight * (s.value - s.min) / (s.max - s.min)

	wsum / wmax * 100

// @function		Calculates the Index value by calling idx.calc() and stores its value in the Index object.
// @param idx		The Index object
export method update(Index idx) =>
	idx.value := idx.calc()

// EXAMPLE USAGE
pastn(series float src, int n) =>
    arr = array.new<float>()
    for i=0 to n-1
        arr.push(src[i])
    arr

movement_confidence(float src, int p) =>
    rise_or_fall = src > src[1] ? 1 : src[1] > src ? -1 : 0
    pastn(rise_or_fall, p).sum()

idx = init()

rsi1_on      = input.bool    ( true, "",         group="RSI1", inline="RSI1")
rsi1_weight  = input.float   (   10, "W",        group="RSI1", inline="RSI1")
rsi1_period  = input.int     (   14, "Period",   group="RSI1")
rsi1 = Signal.new(rsi1_on, rsi1_weight)
rsi1.value := ta.rsi(close, rsi1_period)
idx.add(rsi1)

rsi2_on      = input.bool    ( true, "",         group="RSI2", inline="RSI2")
rsi2_weight  = input.float   (   20, "W",        group="RSI2", inline="RSI2")
rsi2_period  = input.int     (   26, "Period",   group="RSI2")
rsi2 = Signal.new(rsi2_on, rsi2_weight)
rsi2.value := ta.rsi(close, rsi2_period)
idx.add(rsi2)

ema1_on     = input.bool     ( true, "",         group="EMA 1", inline="EMA 1")
ema1_weight = input.float    (   10, "W",        group="EMA 1", inline="EMA 1")
ema1_period = input.int      (   14, "Period",   group="EMA 1", inline="EMA 1a")
ema1_lookbk = input.int      (    7, "Lookback", group="EMA 1", inline="EMA 1a")
ema1_source = input.source   (close, "Source",   group="EMA 1", inline="EMA 1a")
ema1 = Signal.new(ema1_on, ema1_weight)
idx.add(ema1)

if ema1_on
    ma = ta.ema(ema1_source, ema1_period), p = ema1_lookbk
    ema1.value := movement_confidence(ma, p), ema1.min := -p, ema1.max := +p

ema2_on     = input.bool     ( true, "",         group="EMA 2", inline="EMA 2")
ema2_weight = input.float    (   50, "W",        group="EMA 2", inline="EMA 2")
ema2_period = input.int      (  140, "Period",   group="EMA 2", inline="EMA 2a")
ema2_lookbk = input.int      (   70, "Lookback", group="EMA 2", inline="EMA 2a")
ema2_source = input.source   (close, "Source",   group="EMA 2", inline="EMA 2a")
ema2 = Signal.new(ema2_on, ema2_weight)
idx.add(ema2)

if ema2_on
    ma = ta.ema(ema2_source, ema2_period), p = ema2_lookbk
    ema2.value := movement_confidence(ma, p), ema2.min := -p, ema2.max := +p

i = idx.calc()
c = i > i[1] ? color.rgb(76, 175, 79, 65) : i[1] > i ? color.rgb(255, 82, 82, 65) : color.rgb(33, 149, 243, 65)
plot(i, "IDX", c, 1, plot.style_columns)