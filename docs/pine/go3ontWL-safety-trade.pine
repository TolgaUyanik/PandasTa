//@version=5
indicator("Safety Trade", overlay=true)

// Настройка параметров
length = input.int(73, title="Длина SMA (Дневная)")

// Получение дневных данных для предыдущего дня
previousDailyClose = request.security(syminfo.tickerid, "D", close[1])

// Вычисление дневной SMA на основе данных предыдущего дня
basis = ta.sma(previousDailyClose, length)

// Вычисление уровней
upperRed = basis * (1 + 27.5 / 100)
upperOrange = basis * (1 + 13.0 / 100)
lowerYellow = basis * (1 - 9.0 / 100)
lowerGreen = basis * (1 - 19.2 / 100)

// Отображение линий с добавлением смещения по оси X
plot(upperRed, color=color.red, title="Upper Red", linewidth=2, offset=-16)
plot(upperOrange, color=color.orange, title="Upper Orange", linewidth=2, offset=-16)
plot(basis, color=color.gray, title="Daily SMA Basis", linewidth=2, offset=-16)
plot(lowerYellow, color=color.yellow, title="Lower Yellow", linewidth=2, offset=-16)
plot(lowerGreen, color=color.green, title="Lower Green", linewidth=2, offset=-16)
