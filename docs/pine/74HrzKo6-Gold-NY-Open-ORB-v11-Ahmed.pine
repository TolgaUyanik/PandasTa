//@version=5
strategy("Gold NY Open ORB v11 — LIVE [Ahmed]",
     overlay=true, initial_capital=10000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.02,
     slippage=2, calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════════════
// GOLD NY OPEN ORB v11 — LIVE / PAPER TRADING VERSION
//
// Training:   Jan 2024 → Jun 2025 | 41 trades | WR 73.17% | PF 2.641 ✅
// Validation: Jul 2025 → May 2026 | 43 trades | WR 60.47% | PF 1.499 ✅
//
// POSITION SIZING (risk % per trade):
//   1.0% → ~+14.5% over 18 months | max DD ~2.5%
//   1.5% → ~+22.5% over 18 months | max DD ~3.9%   ← recommended for 20% target
//   2.0% → ~+30%   over 18 months | max DD ~5%
//
// R:R = 1:1 (optimal — 1.5:1 and 3:1 both worse due to session-end cuts)
// Long only (shorts tested — drag PF from 2.64 to 1.47)
// ══════════════════════════════════════════════════════════════════════

riskPct = input.float(1.5, "Risk per trade (%)", minval=0.1, maxval=5.0, step=0.1,
     group="Position Sizing",
     tooltip="% of account risked per trade.\n1.5% → ~22% annual return at historical WR.\nIncrease only after consistent paper trading results.")

isWkd = dayofweek != dayofweek.saturday and dayofweek != dayofweek.sunday
bHour = hour(time, "UTC")
bMin  = minute(time, "UTC")

isORPeriod   = isWkd and bHour == 13
isEntryWin   = isWkd and bHour >= 14 and (bHour < 16 or (bHour == 16 and bMin <= 30))
isSessionEnd = isWkd and bHour == 16 and bMin == 30

atr      = ta.atr(14)
volAvg   = ta.sma(volume, 20)
atrAvg20 = ta.sma(atr, 20)
regimeOK = atr <= atrAvg20 * 2.0

var float orHigh    = na
var float orLow     = na
var bool  orReady   = false
var bool  longFired = false

isNewDay = ta.change(time("D")) != 0
if isNewDay
    orHigh    := na
    orLow     := na
    orReady   := false
    longFired := false

if isORPeriod
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow,  low)

if not isORPeriod and not na(orHigh) and not orReady and bHour >= 14
    orReady := true

orRange = na(orHigh) or na(orLow) ? na : orHigh - orLow
orOK    = orReady and not na(orRange) and orRange <= atr * 2.5

longBreak = isEntryWin and orOK and regimeOK and not longFired
          and close > orHigh
          and close[1] <= orHigh
          and close > open
          and volume > volAvg * 1.5

if longBreak
    riskAmt  = strategy.equity * riskPct / 100
    tradeQty = math.max(riskAmt / math.max(orRange, 0.01), 0.001)
    strategy.entry("Long", strategy.long, qty=tradeQty)
    strategy.exit("LongX", "Long",
         stop  = close - orRange,
         limit = close + orRange)
    longFired := true

if isSessionEnd and strategy.position_size > 0
    strategy.close_all("Session End")

plot(orReady ? orHigh : na, "OR High", color=color.new(color.green, 20), linewidth=1, style=plot.style_linebr)
plot(orReady ? orLow  : na, "OR Low",  color=color.new(color.red,   20), linewidth=1, style=plot.style_linebr)
bgcolor(isORPeriod ? color.new(color.yellow, 90) : na, title="OR Building (13:00–14:00 UTC)")
bgcolor(isEntryWin and not isORPeriod and orOK and not longFired ? color.new(color.blue, 96) : na, title="Watching for Entry")
plotshape(longBreak, "Long Entry", shape.triangleup, location.belowbar, color.lime, size=size.small, text="ORB")

if longBreak
    label.new(bar_index, low - atr * 0.5,
         text      = "🟢  BUY NOW — GO LONG\n" +
                     "Entry : " + str.tostring(math.round(close,           1)) + "\n" +
                     "SL    : " + str.tostring(math.round(close - orRange, 1)) + "\n" +
                     "TP    : " + str.tostring(math.round(close + orRange, 1)) + "\n" +
                     "OR ±  : " + str.tostring(math.round(orRange,         1)),
         style     = label.style_label_up,
         color     = color.new(color.lime, 5),
         textcolor = color.black,
         size      = size.normal)