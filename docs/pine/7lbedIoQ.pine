library("SMC_KNN", overlay=false)

// @function 2つの特徴量ベクトル間のユークリッド距離を計算
// @param f1 特徴量配列 1
// @param f2 特徴量配列 2
// @returns float 距離 (Distance)
export euclidean_distance(array<float> f1, array<float> f2) =>
    float sum_sq = 0.0
    int sz = array.size(f1)
    if sz > 0 and sz == array.size(f2)
        for i = 0 to sz - 1
            float diff = array.get(f1, i) - array.get(f2, i)
            sum_sq += math.pow(diff, 2)
    math.sqrt(sum_sq)

// @function K個の直近傍（Nearest Neighbors）のインデックスを取得
// @param distances 現在のイベントと過去の全イベントとの距離配列
// @param k 取得する近傍の数 (K)
// @returns array<int> 最も距離が近い過去イベントのインデックス配列
export get_k_nearest(array<float> distances, int k) =>
    array<int> nearest_indices = array.new<int>()
    array<float> dist_copy = array.copy(distances)
    
    int loop_count = math.min(k, array.size(dist_copy))
    
    for i = 0 to loop_count - 1
        float min_dist = 9999999.9
        int min_idx = -1
        
        for j = 0 to array.size(dist_copy) - 1
            float d = array.get(dist_copy, j)
            if not na(d) and d < min_dist
                min_dist := d
                min_idx := j
                
        if min_idx >= 0
            array.push(nearest_indices, min_idx)
            // 選択済みの要素は最大値にして次回の検索から除外
            array.set(dist_copy, min_idx, 9999999.9)
            
    nearest_indices