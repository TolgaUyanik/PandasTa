//@version=5
// @description Library for calculating the number of bars in the last X trading days
library("MyLibrary001")

// @function BarsInLastXDays
// @description Calculates the number of bars in the last X trading days
// @param numTradingDays int Number of trading days to consider
// @returns tuple(float, float) A tuple with the number of bars and the bar duration

export BarsInLastXDays(int numTradingDays) =>
    // Initialize bar duration with a large number to ensure it gets updated
    var float barDuration = 1000000000000.0

    // Calculate the time difference between the current bar and the previous bar in minutes
    timediff = (time - time[1]) / 1000.0 / 60.0

    // Get the bar duration in minutes
    if not na(time[1]) and (timediff != 0)
        barDuration := math.min(timediff, barDuration)

    // Determine trading day duration in minutes
    float tradingDay = barDuration >= 24 * 60 ? 24 * 60 : 6.5 * 60

    // Calculate the total duration of X trading days in minutes
    float totalDuration = numTradingDays * tradingDay

    // Calculate the number of bars in the last X trading days
    float numBars = totalDuration / barDuration

    // Return the number of bars and bar duration as a tuple
    [numBars, barDuration]


export InTimeRange(int my_start, int my_finish, int my_time) =>
    ret = my_time >= my_start and my_time <= my_finish ? true : false
    ret

// Función para verificar si la barra actual está dentro del rango basado en el intervalo
export isWithinLastInterval(int my_time, int my_time1) =>
    intervalMinutes = (my_time - my_time1) / 60000
    nyHour = hour(my_time, "America/New_York")
    nyMinute = minute(my_time, "America/New_York")
    closeHour = 16
    closeMinute = 0
    startMinute = closeMinute - intervalMinutes
    startHour = closeHour
    if startMinute < 0
        startHour := startHour - 1
        startMinute := 60 + startMinute
    (nyHour == startHour and nyMinute >= startMinute) or (nyHour == closeHour and nyMinute < 1)

// funcion para verificar si estamos cerca del dia de earnings
export CloseToEarnings(int max_days) =>
    earningsTime = earnings.future_time
    timediff = (earningsTime - time) / (24 * 60 * 60 * 1000)
    ret = (timediff < max_days)
    ret


// Función para convertir una cadena de fecha y hora en un timestamp    // funcion interna
f_str_to_time(string signal) =>
    y = str.tonumber(str.substring(signal, 0, 4))
    m = str.tonumber(str.substring(signal, 5, 7))
    d = str.tonumber(str.substring(signal, 8, 10))
    h = str.tonumber(str.substring(signal, 11, 13))
    min = str.tonumber(str.substring(signal, 14, 16))
    timestamp("America/New_York",int(y), int(m), int(d), int(h), int(min),0)

// Función para verificar y disparar señales
export CheckAndTriggerManualSignals(int open_time, int close_time, array<string> signals) =>

    for i = 0 to array.size(signals) - 1
        signal = array.get(signals, i)
        signal_time = f_str_to_time(signal)
        signal_parts = str.split(signal, ",")
        signal_type = array.get(signal_parts, 1)

        if (signal_time >= open_time and signal_time < close_time)
            if ((str.contains(str.lower(signal_type), str.lower("buy"))) and (strategy.position_size <= 0))
                if (strategy.position_size == 0)
                    strategy.entry("ManualBuy", strategy.long)
                    //alert("ManualBuy", alert.freq_once_per_bar_close)
                if (strategy.position_size < 0)
                    strategy.close_all("ManualClose")
                    //alert("ManualClose", alert.freq_once_per_bar_close)
            
                //label.new(x=bar_index, y=high, text="Buy", color=color.green, style=label.style_label_down)
            if ((str.contains(str.lower(signal_type), str.lower("sell")))  and (strategy.position_size >= 0))
                if (strategy.position_size == 0)
                    strategy.entry("ManualSell", strategy.short)
                if (strategy.position_size > 0)
                    strategy.close_all("ManualClose")
                
                //label.new(x=bar_index, y=low, text="Sell", color=color.red, style=label.style_label_up)
                //alert("Señal sell disparada", alert.freq_once_per_bar_close)

export TestAlertAndStrat(string jsonLONG, string jsonSHORT, bool long) =>
    if (long)
        strategy.entry("LongEntry", strategy.long, comment = "ManualLongEntry")
        alert(message = jsonLONG, freq = alert.freq_once_per_bar_close)
    else
        strategy.entry('ShortEntry', strategy.short)
        alert(message = jsonSHORT, freq = alert.freq_once_per_bar_close)


export ServerAlert(string symbol, string strategy_name, string action, float price) =>
    netprofit = strategy.netprofit_percent
    numtrades = strategy.closedtrades

    perc_profitable = 0.0
    if (strategy.closedtrades > 0)
        perc_profitable := (strategy.wintrades / strategy.closedtrades) * 100

    profit_factor = 0.0
    if (strategy.grossloss > 0)
        profit_factor := strategy.grossprofit/strategy.grossloss

    perc_drawdown = strategy.max_drawdown_percent

    avg_trade = strategy.avg_trade_percent

    profit = strategy.openprofit
    bar_lenght = timeframe.period

    alertMessage ="{" + str.format(' "symbol": "{0}", "strategy": "{1}", "action": "{2}", "close": "{3,number,0.00}" , "netprofit": "{4,number,0.00}" , "numtrades": "{5,number,0.00}" , "perc_profitable": "{6,number,0.00}" , "profit_factor": "{7,number,0.00}" , "perc_drawdown": "{8,number,0.00}" , "avg_trade": "{9,number,0.00}" , "trade_profit": "{10,number,0.00}" , "bar_lenght": "{11}"', 
      symbol, strategy_name, action, price, netprofit, numtrades, perc_profitable, profit_factor, perc_drawdown, avg_trade, profit, bar_lenght) + " }"

    alert(alertMessage, alert.freq_once_per_bar_close)
