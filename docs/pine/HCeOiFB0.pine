//@version=6
indicator('Pivot and Wick Boxes with Break Signals', overlay = true)

// Input parameters
showHighPivotBoxes = input.bool(true, title = 'Show High Pivot Boxes', group = 'Pivot Settings')
showLowPivotBoxes = input.bool(true, title = 'Show Low Pivot Boxes', group = 'Pivot Settings')
showLabels = input.bool(true, title = 'Show Pivot Labels', group = 'Label Settings')
length = input.int(5, minval = 1, title = 'Pivot Length', group = 'Pivot Settings')
maxHighLines = input.int(15, minval = 1, title = 'Max High Pivot Boxes', group = 'Pivot Settings')
maxLowLines = input.int(15, minval = 1, title = 'Max Low Pivot Boxes', group = 'Pivot Settings')
useVolumeFilter = input.bool(false, title = 'Use Volume Filter for Signals', group = 'Signal Settings')
volumeFilter = input.float(1.0, minval = 0, title = 'Average Volume Multiplier', step = 0.1, group = 'Signal Settings')
volumePeriod = input.int(20, minval = 1, title = 'Average Volume Period (days)', group = 'Signal Settings')
volumeSmaPeriod = input.int(20, minval = 1, title = 'Volume SMA Period for Delta', group = 'Label Settings')

// Box color, style, and gradient inputs
highBoxBorderColor = input.color(color.rgb(241, 13, 13), title = 'High Box Border Color', group = 'High Box Style')
highBoxBgColor = input.color(color.new(color.rgb(241, 13, 13), 70), title = 'High Box Gradient Color', group = 'High Box Style')
highBoxBorderWidth = input.int(1, minval = 1, maxval = 5, title = 'High Box Border Width', group = 'High Box Style')
highBoxBorderStyle = input.string('Solid', title = 'High Box Border Style', options = ['Solid', 'Dashed', 'Dotted'], group = 'High Box Style')
lowBoxBorderColor = input.color(color.green, title = 'Low Box Border Color', group = 'Low Box Style')
lowBoxBgColor = input.color(color.new(color.green, 70), title = 'Low Box Gradient Color', group = 'Low Box Style')
lowBoxBorderWidth = input.int(1, minval = 1, maxval = 5, title = 'Low Box Border Width', group = 'Low Box Style')
lowBoxBorderStyle = input.string('Solid', title = 'Low Box Border Style', options = ['Solid', 'Dashed', 'Dotted'], group = 'Low Box Style')

// Label color inputs
labelColorHigh = input.color(color.red, title = 'Bearish Pivot Label Color (High)', group = 'Label Settings')
labelColorLow = input.color(color.green, title = 'Bullish Pivot Label Color (Low)', group = 'Label Settings')

// Map string styles to Pine Script line styles
getLineStyle(style) =>
    style == 'Solid' ? line.style_solid : style == 'Dashed' ? line.style_dashed : line.style_dotted

// Arrays to store pivot and box data
var array<float> pivotLevels = array.new_float(0)
var array<float> wickLevels = array.new_float(0)
var array<int> pivotTimes = array.new_int(0)
var array<int> pivotBarIndices = array.new_int(0)
var array<bool> isHigh = array.new_bool(0)
var array<bool> activePivots = array.new_bool(0)
var array<box> boxes = array.new_box(0)
var array<label> labels = array.new_label(0)

// Calculate average volume
avgVolume = ta.sma(volume, volumePeriod)

// Calculate volume delta using user-defined SMA period
pivotVolIndex = length
pivotVol = volume[pivotVolIndex]
volSmaShifted = ta.sma(volume, volumeSmaPeriod)[pivotVolIndex]
volPerc = volSmaShifted != 0 ? ((pivotVol - volSmaShifted) / volSmaShifted) * 100 : 0
volPercText = volPerc >= 0 ? "+" + str.tostring(volPerc, format.percent) : str.tostring(volPerc, format.percent)

// Initialize with historical pivots, limited to 500 bars back
var bool initialized = false
if not initialized
    highPivotsFound = 0
    for i = length to 500 by 1
        if highPivotsFound < maxHighLines
            ph = ta.pivothigh(high, length, length)
            if not na(ph[i])
                broken = false
                for j = i - length to 0 by 1
                    if close[j] > ph[i]
                        broken := true
                        break
                if not broken
                    wickPrice = math.max(open[i + length], close[i + length])
                    array.push(pivotLevels, ph[i])
                    array.push(wickLevels, wickPrice)
                    array.push(pivotTimes, time[i + length])
                    array.push(pivotBarIndices, bar_index[i + length])
                    array.push(isHigh, true)
                    array.push(activePivots, true)
                    array.push(boxes, na)
                    array.push(labels, na)
                    highPivotsFound := highPivotsFound + 1
    lowPivotsFound = 0
    for i = length to 500 by 1
        if lowPivotsFound < maxLowLines
            pl = ta.pivotlow(low, length, length)
            if not na(pl[i])
                broken = false
                for j = i - length to 0 by 1
                    if close[j] < pl[i]
                        broken := true
                        break
                if not broken
                    wickPrice = math.min(open[i + length], close[i + length])
                    array.push(pivotLevels, pl[i])
                    array.push(wickLevels, wickPrice)
                    array.push(pivotTimes, time[i + length])
                    array.push(pivotBarIndices, bar_index[i + length])
                    array.push(isHigh, false)
                    array.push(activePivots, true)
                    array.push(boxes, na)
                    array.push(labels, na)
                    lowPivotsFound := lowPivotsFound + 1
    initialized := true

// Detect new pivots
pivotHigh = ta.pivothigh(high, length, length)
pivotLow = ta.pivotlow(low, length, length)

// Count active high and low pivots
countHighBoxes() =>
    count = 0
    if array.size(pivotLevels) > 0
        for i = 0 to array.size(pivotLevels) - 1 by 1
            if array.get(activePivots, i) and array.get(isHigh, i)
                count := count + 1
    count

countLowBoxes() =>
    count = 0
    if array.size(pivotLevels) > 0
        for i = 0 to array.size(pivotLevels) - 1 by 1
            if array.get(activePivots, i) and not array.get(isHigh, i)
                count := count + 1
    count

// Clean up inactive pivots or pivots older than 500 bars
if array.size(pivotLevels) > 0
    for i = array.size(pivotLevels) - 1 to 0 by 1
        if not array.get(activePivots, i) or bar_index - array.get(pivotBarIndices, i) > 500
            if not na(array.get(boxes, i))
                box.delete(array.get(boxes, i))
            if not na(array.get(labels, i))
                label.delete(array.get(labels, i))
            array.remove(pivotLevels, i)
            array.remove(wickLevels, i)
            array.remove(pivotTimes, i)
            array.remove(pivotBarIndices, i)
            array.remove(isHigh, i)
            array.remove(activePivots, i)
            array.remove(boxes, i)
            array.remove(labels, i)

// When a new pivot high is detected
if not na(pivotHigh)
    while countHighBoxes() >= maxHighLines
        for i = 0 to array.size(pivotLevels) - 1 by 1
            if array.get(activePivots, i) and array.get(isHigh, i)
                array.set(activePivots, i, false)
                if not na(array.get(boxes, i))
                    box.delete(array.get(boxes, i))
                if not na(array.get(labels, i))
                    label.delete(array.get(labels, i))
                break
    wickPrice = math.max(open[length], close[length])
    array.push(pivotLevels, pivotHigh)
    array.push(wickLevels, wickPrice)
    array.push(pivotTimes, time[length])
    array.push(pivotBarIndices, bar_index[length])
    array.push(isHigh, true)
    array.push(activePivots, true)
    array.push(boxes, na)
    array.push(labels, na)
    if showLabels
        labelText = "Price: " + str.tostring(pivotHigh, format.mintick) + "\nVol: " + str.tostring(pivotVol, format.volume) + "\nΔ: " + volPercText + "\nSMA: " + str.tostring(volumeSmaPeriod)
        newLabel = label.new(bar_index[length], pivotHigh, labelText, style=label.style_label_down, color=labelColorHigh, textcolor=color.white, size=size.small)
        array.set(labels, array.size(labels) - 1, newLabel)

// When a new pivot low is detected
if not na(pivotLow)
    while countLowBoxes() >= maxLowLines
        for i = 0 to array.size(pivotLevels) - 1 by 1
            if array.get(activePivots, i) and not array.get(isHigh, i)
                array.set(activePivots, i, false)
                if not na(array.get(boxes, i))
                    box.delete(array.get(boxes, i))
                if not na(array.get(labels, i))
                    label.delete(array.get(labels, i))
                break
    wickPrice = math.min(open[length], close[length])
    array.push(pivotLevels, pivotLow)
    array.push(wickLevels, wickPrice)
    array.push(pivotTimes, time[length])
    array.push(pivotBarIndices, bar_index[length])
    array.push(isHigh, false)
    array.push(activePivots, true)
    array.push(boxes, na)
    array.push(labels, na)
    if showLabels
        labelText = "Price: " + str.tostring(pivotLow, format.mintick) + "\nVol: " + str.tostring(pivotVol, format.volume) + "\nΔ: " + volPercText + "\nSMA: " + str.tostring(volumeSmaPeriod)
        newLabel = label.new(bar_index[length], pivotLow, labelText, style=label.style_label_up, color=labelColorLow, textcolor=color.white, size=size.small)
        array.set(labels, array.size(labels) - 1, newLabel)

// Update all active pivot boxes
if array.size(pivotLevels) > 0
    for i = 0 to array.size(pivotLevels) - 1 by 1
        if array.get(activePivots, i) and bar_index - array.get(pivotBarIndices, i) <= 500
            if not na(array.get(boxes, i))
                box.delete(array.get(boxes, i))
            if (array.get(isHigh, i) and showHighPivotBoxes) or (not array.get(isHigh, i) and showLowPivotBoxes)
                borderColor = array.get(isHigh, i) ? highBoxBorderColor : lowBoxBorderColor
                bgColor = array.get(isHigh, i) ? highBoxBgColor : lowBoxBgColor
                borderWidth = array.get(isHigh, i) ? highBoxBorderWidth : lowBoxBorderWidth
                borderStyle = array.get(isHigh, i) ? getLineStyle(highBoxBorderStyle) : getLineStyle(lowBoxBorderStyle)
                topPrice = array.get(isHigh, i) ? array.get(pivotLevels, i) : array.get(wickLevels, i)
                bottomPrice = array.get(isHigh, i) ? array.get(wickLevels, i) : array.get(pivotLevels, i)
                rightBar = math.min(bar_index, array.get(pivotBarIndices, i) + 500)
                newBox = box.new(left = array.get(pivotBarIndices, i), top = topPrice, right = rightBar, bottom = bottomPrice, border_color = borderColor, border_width = borderWidth, border_style = borderStyle, bgcolor = bgColor, xloc = xloc.bar_index, extend = extend.none)
                array.set(boxes, i, newBox)

// Check for breakouts in active pivot boxes and set signals
var bool buySignal = false
var bool sellSignal = false
buySignal := false
sellSignal := false
if array.size(pivotLevels) > 0
    for i = 0 to array.size(pivotLevels) - 1 by 1
        if array.get(activePivots, i)
            topPrice = array.get(isHigh, i) ? array.get(pivotLevels, i) : array.get(wickLevels, i)
            bottomPrice = array.get(isHigh, i) ? array.get(wickLevels, i) : array.get(pivotLevels, i)
            if array.get(isHigh, i) and close > topPrice
                array.set(activePivots, i, false)
                if not na(array.get(boxes, i))
                    box.delete(array.get(boxes, i))
                if not na(array.get(labels, i))
                    label.delete(array.get(labels, i))
                buySignal := useVolumeFilter ? volume >= avgVolume * volumeFilter : true
            else if not array.get(isHigh, i) and close < bottomPrice
                array.set(activePivots, i, false)
                if not na(array.get(boxes, i))
                    box.delete(array.get(boxes, i))
                if not na(array.get(labels, i))
                    label.delete(array.get(labels, i))
                sellSignal := useVolumeFilter ? volume >= avgVolume * volumeFilter : true

// Plot signals
plotshape(buySignal, title = 'Break Up Signal', location = location.belowbar, style = shape.triangleup, color = color.lime, size = size.tiny)
plotshape(sellSignal, title = 'Break Down Signal', location = location.abovebar, style = shape.triangledown, color = color.red, size = size.tiny)