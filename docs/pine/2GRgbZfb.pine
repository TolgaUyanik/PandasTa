//@version=6

// ===================================================================
// Pine Script Library: Core Utilities
// ===================================================================
// @description Core utility functions for Pine Script strategies
// Provides safe mathematical operations, array management, and basic helpers
// Version: 1.0.0
// Author: NQ Hybrid Strategy Team
// Last Updated: 2025-06-18
// ===================================================================

library("lib_core_utils", overlay=true)

// ===================================================================
// CONSTANTS AND CONFIGURATION
// ===================================================================

// Maximum array sizes to prevent memory issues
export const int MAX_ARRAY_SIZE = 200
export const int DEFAULT_ARRAY_SIZE = 50
export const int SMALL_ARRAY_SIZE = 20

// Default values for calculations
export const float DEFAULT_ATR_BUFFER_MULT = 0.3
export const float MIN_DIVISION_THRESHOLD = 0.0000001
export const float MAX_SAFE_VALUE = 1000000000.0

// ===================================================================
// TYPE DEFINITIONS
// ===================================================================

// @type SafeCalculationResult
// @description Result wrapper for safe calculations
// @field value (float) The calculated value
// @field is_valid (bool) Whether the calculation was successful
// @field error_message (string) Error description if calculation failed
export type SafeCalculationResult
    float value
    bool is_valid
    string error_message

// @type ArrayStats
// @description Basic statistics for array operations
// @field size (int) Current array size
// @field max_size (int) Maximum allowed size
// @field is_full (bool) Whether array has reached max capacity
export type ArrayStats
    int size
    int max_size
    bool is_full

// ===================================================================
// SAFE MATHEMATICAL OPERATIONS
// ===================================================================

// @function safe_division
// @description Performs division with safety checks for zero denominators and invalid values
// @param numerator (float) The numerator value
// @param denominator (float) The denominator value
// @returns (float) Result of division, or 0.0 if invalid
export safe_division(float numerator, float denominator) =>
    if na(numerator) or na(denominator)
        0.0
    else if math.abs(denominator) < MIN_DIVISION_THRESHOLD
        0.0
    else if math.abs(numerator) > MAX_SAFE_VALUE or math.abs(denominator) > MAX_SAFE_VALUE
        0.0
    else
        numerator / denominator

// @function safe_division_detailed
// @description Enhanced division with detailed result information
// @param numerator (float) The numerator value
// @param denominator (float) The denominator value
// @returns (SafeCalculationResult) Detailed calculation result
export safe_division_detailed(float numerator, float denominator) =>
    result = SafeCalculationResult.new()
    
    if na(numerator) or na(denominator)
        result.value := 0.0
        result.is_valid := false
        result.error_message := "Input values are NA"
    else if math.abs(denominator) < MIN_DIVISION_THRESHOLD
        result.value := 0.0
        result.is_valid := false
        result.error_message := "Denominator too close to zero"
    else if math.abs(numerator) > MAX_SAFE_VALUE or math.abs(denominator) > MAX_SAFE_VALUE
        result.value := 0.0
        result.is_valid := false
        result.error_message := "Values exceed safe calculation limits"
    else
        result.value := numerator / denominator
        result.is_valid := true
        result.error_message := ""
    
    result

// @function safe_multiply
// @description Performs multiplication with safety checks for overflow and invalid values
// @param a (float) First multiplier
// @param b (float) Second multiplier
// @returns (float) Result of multiplication, or 0.0 if invalid
export safe_multiply(float a, float b) =>
    if na(a) or na(b)
        0.0
    else if math.abs(a) > MAX_SAFE_VALUE or math.abs(b) > MAX_SAFE_VALUE
        0.0
    else if math.abs(a) * math.abs(b) > MAX_SAFE_VALUE
        0.0
    else
        a * b

// @function safe_add
// @description Performs addition with safety checks
// @param a (float) First addend
// @param b (float) Second addend
// @returns (float) Result of addition, or 0.0 if invalid
export safe_add(float a, float b) =>
    if na(a) and na(b)
        0.0
    else if na(a)
        b
    else if na(b)
        a
    else
        a + b

// @function safe_subtract
// @description Performs subtraction with safety checks
// @param a (float) Minuend
// @param b (float) Subtrahend
// @returns (float) Result of subtraction, or 0.0 if invalid
export safe_subtract(float a, float b) =>
    if na(a) and na(b)
        0.0
    else if na(a)
        -b
    else if na(b)
        a
    else
        a - b

// @function safe_abs
// @description Safe absolute value calculation
// @param value (float) Input value
// @returns (float) Absolute value, or 0.0 if invalid
export safe_abs(float value) =>
    if na(value)
        0.0
    else
        math.abs(value)

// @function safe_max
// @description Safe maximum value calculation
// @param a (float) First value
// @param b (float) Second value
// @returns (float) Maximum value, handling NA cases
export safe_max(float a, float b) =>
    if na(a) and na(b)
        0.0
    else if na(a)
        b
    else if na(b)
        a
    else
        math.max(a, b)

// @function safe_min
// @description Safe minimum value calculation
// @param a (float) First value
// @param b (float) Second value
// @returns (float) Minimum value, handling NA cases
export safe_min(float a, float b) =>
    if na(a) and na(b)
        0.0
    else if na(a)
        b
    else if na(b)
        a
    else
        math.min(a, b)

// ===================================================================
// ARRAY MANAGEMENT UTILITIES
// ===================================================================

// @function safe_array_get
// @description Safely retrieves value from array with bounds checking
// @param arr (array<float>) The array to access
// @param index (int) Index to retrieve
// @returns (float) Value at index, or na if invalid
export safe_array_get(array<float> arr, int index) =>
    if na(arr) or array.size(arr) == 0
        na
    else if index < 0 or index >= array.size(arr)
        na
    else
        array.get(arr, index)

// @function safe_array_push
// @description Safely pushes value to array with size management
// @param arr (array<float>) The array to modify
// @param value (float) Value to push
// @param max_size (int) Maximum array size
// @returns (bool) True if push was successful
export safe_array_push(array<float> arr, float value, int max_size = 50) =>
    if na(arr) or na(value)
        false
    else
        // Remove oldest elements if array would exceed max size
        while array.size(arr) >= max_size
            array.shift(arr)
        
        array.push(arr, value)
        true

// @function safe_array_unshift
// @description Safely adds value to beginning of array with size management
// @param arr (array<float>) The array to modify
// @param value (float) Value to add at beginning
// @param max_size (int) Maximum array size
// @returns (bool) True if unshift was successful
export safe_array_unshift(array<float> arr, float value, int max_size = 50) =>
    if na(arr) or na(value)
        false
    else
        // Remove newest elements from end if array would exceed max size
        while array.size(arr) >= max_size
            array.pop(arr)
        
        array.unshift(arr, value)
        true

// @function get_array_stats
// @description Gets statistics about an array
// @param arr (array<float>) The array to analyze
// @param max_size (int) The maximum allowed size
// @returns (ArrayStats) Statistics about the array
export get_array_stats(array<float> arr, int max_size = 50) =>
    stats = ArrayStats.new()
    
    if na(arr)
        stats.size := 0
        stats.max_size := max_size
        stats.is_full := false
    else
        stats.size := array.size(arr)
        stats.max_size := max_size
        stats.is_full := stats.size >= max_size
    
    stats

// @function cleanup_array
// @description Cleans up array by removing old elements if it's too large
// @param arr (array<float>) The array to cleanup
// @param target_size (int) Target size after cleanup
// @returns (int) Number of elements removed
export cleanup_array(array<float> arr, int target_size = 50) =>
    if na(arr)
        0
    else
        removed_count = 0
        while array.size(arr) > target_size
            array.shift(arr)
            removed_count += 1
        removed_count

// ===================================================================
// VALUE VALIDATION AND SANITIZATION
// ===================================================================

// @function is_valid_price
// @description Checks if a price value is valid for trading calculations
// @param price (float) Price to validate
// @returns (bool) True if price is valid
export is_valid_price(float price) =>
    not na(price) and price > 0.0 and price < MAX_SAFE_VALUE

// @function is_valid_volume
// @description Checks if a volume value is valid
// @param vol (float) Volume to validate
// @returns (bool) True if volume is valid
export is_valid_volume(float vol) =>
    not na(vol) and vol >= 0.0 and vol < MAX_SAFE_VALUE

// @function sanitize_price
// @description Sanitizes price value to ensure it's within valid range
// @param price (float) Price to sanitize
// @param default_value (float) Default value if price is invalid
// @returns (float) Sanitized price value
export sanitize_price(float price, float default_value = 0.0) =>
    if is_valid_price(price)
        price
    else
        default_value

// @function sanitize_percentage
// @description Sanitizes percentage value to 0-100 range
// @param pct (float) Percentage to sanitize
// @returns (float) Sanitized percentage (0-100)
export sanitize_percentage(float pct) =>
    if na(pct)
        0.0
    else
        math.max(0.0, math.min(100.0, pct))

// ===================================================================
// TIME AND SESSION UTILITIES
// ===================================================================

// @function is_session_active
// @description Checks if current time is within specified session
// @param session_string (string) Session time string (e.g., "0930-1600")
// @param timezone (string) Timezone for session
// @returns (bool) True if session is active
export is_session_active(string session_string, string timezone = "America/New_York") =>
    if session_string == ""
        true
    else
        not na(time(timeframe.period, session_string, timezone))

// @function get_session_progress
// @description Gets progress through trading session as percentage
// @param session_string (string) Session time string
// @param timezone (string) Timezone for session
// @returns (float) Session progress (0-100)
export get_session_progress(string session_string, string timezone = "America/New_York") =>
    if session_string == "" or not is_session_active(session_string, timezone)
        0.0
    else
        // This is a simplified calculation - in real implementation you'd parse session times
        current_hour = hour(time, timezone)
        current_minute = minute(time, timezone)
        current_time_minutes = current_hour * 60 + current_minute
        
        // Assuming 9:30 AM - 4:00 PM session (570 to 960 minutes)
        session_start = 570  // 9:30 AM
        session_end = 960    // 4:00 PM
        session_length = session_end - session_start
        
        if current_time_minutes < session_start or current_time_minutes > session_end
            0.0
        else
            progress = (current_time_minutes - session_start) / session_length * 100
            math.max(0.0, math.min(100.0, progress))

// ===================================================================
// STRING AND FORMATTING UTILITIES
// ===================================================================

// @function format_price
// @description Formats price with appropriate decimal places
// @param price (float) Price to format
// @param decimals (int) Number of decimal places
// @returns (string) Formatted price string
export format_price(float price, int decimals = 2) =>
    if na(price)
        "N/A"
    else
        str.tostring(price, "#." + str.repeat("#", decimals))

// @function format_percentage
// @description Formats percentage with % symbol
// @param pct (float) Percentage to format
// @param decimals (int) Number of decimal places
// @returns (string) Formatted percentage string
export format_percentage(float pct, int decimals = 1) =>
    if na(pct)
        "N/A%"
    else
        str.tostring(pct, "#." + str.repeat("#", decimals)) + "%"

// @function bool_to_emoji
// @description Converts boolean to emoji representation
// @param condition (bool) Boolean value to convert
// @param true_emoji (string) Emoji for true value
// @param false_emoji (string) Emoji for false value
// @returns (string) Emoji representation
export bool_to_emoji(bool condition, string true_emoji = "✅", string false_emoji = "❌") =>
    condition ? true_emoji : false_emoji

// ===================================================================
// PERFORMANCE AND DEBUGGING UTILITIES
// ===================================================================

// @function log_debug
// @description Creates debug log entry (placeholder for future logging system)
// @param message (string) Debug message
// @param level (string) Log level
// @returns (string) Formatted log entry
export log_debug(string message, string level = "INFO") =>
    "[" + level + "] " + message

// @function benchmark_start
// @description Placeholder for performance benchmarking start
// @returns (int) Current bar index as timestamp
export benchmark_start() =>
    bar_index

// @function benchmark_end
// @description Placeholder for performance benchmarking end
// @param start_time (int) Start timestamp from benchmark_start
// @returns (int) Elapsed bars
export benchmark_end(int start_time) =>
    bar_index - start_time

