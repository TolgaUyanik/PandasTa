//@version=6
indicator("ATR Trailing Stop with ATR Targets [v6]", overlay=true)

// === USER INPUTS ===
atrLength    = input.int(14, "ATR Period")
atrMult      = input.float(2.0, "ATR Multiplier")
initialTrend = input.string("Bullish", "Starting Trend", options=["Bullish", "Bearish"])

// === ATR Calculation ===
atr = ta.atr(atrLength)

// === STATE VARIABLES ===
var float trailStop = na
var float highestHi = na
var float lowestLo  = na
var int   trend     = initialTrend == "Bullish" ? 1 : -1  // 1 = up, -1 = down
var float flipPrice = na
var int   flipBar   = na

// === INITIALIZATION ON FIRST BAR ===
if bar_index == 0
    highestHi := high
    lowestLo  := low

// === MAIN LOGIC ===
if trend == 1
    highestHi := na(highestHi) ? high : math.max(highestHi, high)
    trailStop := highestHi - atr * atrMult
    if close < trailStop
        trend     := -1
        highestHi := na
        lowestLo  := low
        trailStop := close + atr * atrMult
        flipPrice := close
        flipBar   := bar_index
else
    lowestLo := na(lowestLo) ? low : math.min(lowestLo, low)
    trailStop := lowestLo + atr * atrMult
    if close > trailStop
        trend     := 1
        lowestLo  := na
        highestHi := high
        trailStop := close - atr * atrMult
        flipPrice := close
        flipBar   := bar_index

// === PLOTTING ATR TRAILING STOP ===
trailColor = trend == 1 ? color.green : color.red
plot(trailStop, title="ATR Trailing Stop", color=trailColor, linewidth=2)

// === ATR TARGETS AFTER FLIP ===
showTargets = not na(flipBar) and bar_index >= flipBar

float target1 = na
float target2 = na
float target3 = na

if showTargets
    if trend == 1
        target1 := flipPrice + atr * 1
        target2 := flipPrice + atr * 2
        target3 := flipPrice + atr * 3
    else
        target1 := flipPrice - atr * 1
        target2 := flipPrice - atr * 2
        target3 := flipPrice - atr * 3

plot(showTargets ? target1 : na, title="Target 1 ATR", color=color.orange, style=plot.style_circles, linewidth=1)
plot(showTargets ? target2 : na, title="Target 2 ATR", color=color.yellow, style=plot.style_circles, linewidth=1)
plot(showTargets ? target3 : na, title="Target 3 ATR", color=color.purple, style=plot.style_circles, linewidth=2)

// === LABEL FLIP POINT ===
var label lastFlipLabel = na
if not na(lastFlipLabel)
    label.delete(lastFlipLabel)
if showTargets and not na(flipPrice)
    labelText = trend == 1 ? "Long Flip" : "Short Flip"
    lastFlipLabel := label.new(bar_index, flipPrice, labelText, color=trailColor, style=label.style_label_down, yloc=yloc.price)

// === SAFETY PLOT TO ENSURE INDICATOR OUTPUT EVERY BAR ===
bgcolor(color.new(color.gray, 95))
