//@version=5
indicator("2% Averaging Buy-Sell Strategy", overlay=true)

// === INPUTS ===
startLot = input.int(1, "Initial Lot Size")
addLot = input.int(2, "Additional Lot per Dip/Jump")
percentMove = input.float(2.0, "Percentage Move", step=0.1)

// === VARIABLES ===
var float basePrice = na
var int position = 0  // total lots
var label baseLabel = na

// Initialize basePrice on first bar
if (na(basePrice))
    basePrice := close
    baseLabel := label.new(x=bar_index, y=close, text="Start", style=label.style_label_up, color=color.green)

// Price change in %
priceChangePercent = (close - basePrice) / basePrice * 100

// Buy condition: price drops 2% from last buy
buyCondition = priceChangePercent <= -percentMove

// Sell condition: price goes 2% above basePrice
sellCondition = priceChangePercent >= percentMove

// Logic for buying more
if (buyCondition)
    position += addLot
    basePrice := close
    label.new(x=bar_index, y=close, text="BUY\nLots: " + str.tostring(position), style=label.style_label_down, color=color.blue)

// Logic for selling
if (sellCondition and position >= addLot)
    position -= addLot
    basePrice := close
    label.new(x=bar_index, y=close, text="SELL\nLots: " + str.tostring(position), style=label.style_label_up, color=color.red)

// Plotting basePrice line
plot(basePrice, title="Base Price", color=color.orange, linewidth=2)
