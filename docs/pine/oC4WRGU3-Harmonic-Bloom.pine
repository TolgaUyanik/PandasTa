//@version=5
indicator("Harmonic Bloom", overlay=true, max_lines_count=100, max_labels_count=500)

// === PIVOT POINTS ===
value_1 = input.time(timestamp("2025-07-30 00:00"), "Pivot Point 1 (Start)", group="Pivot Points")
value_2 = input.time(timestamp("2025-07-31 00:00"), "Pivot Point 2 (End)", group="Pivot Points")

// === ECHO SYSTEM ===
enable_echo = input.bool(false, "Enable Echo Mode", group="Echo System")
echo_multiplier = input.float(1.0, "Echo Multiplier", step=0.1, minval=0.1, maxval=10.0, group="Echo System")
show_echo_labels = input.string("Dots", "Show Echo Display", options=["Dots", "Labels", "None"], group="Echo System")
echo_bar_color = input.bool(false, "Echo Bar Color", group="Echo System")
echo_color = input.color(color.yellow, "Echo Levels Color", group="Echo System")
echo_bar_custom_color = input.color(color.orange, "Echo Bar Custom Color", group="Echo System")
mirror_inflections_to_echo = input.bool(false, "Mirror Inflections to Echo System", group="Echo System")
extend_echo_inflection_trends = input.string("None", "Extend Echo Inflection Trends", options=["None", "Left", "Right", "Both"], group="Echo System")

// === GANN MIRROR PROJECTION ===
show_gann_mirror = input.bool(true, "Show Gann Mirror Projection", group="Gann Mirror")
gann_mirror_color = input.color(color.purple, "Mirror Angle Color", group="Gann Mirror")
gann_mirror_width = input.int(2, "Mirror Angle Width", minval=1, maxval=5, group="Gann Mirror")
gann_mirror_style = input.string("Solid", "Mirror Angle Style", options=["Solid", "Dashed", "Dotted"], group="Gann Mirror")

// === TRENDLINES ===
show_fib_trendlines = input.bool(true, "Show Fib Trendlines", group="Trendlines")
show_trend_border = input.bool(false, "Show Trend Border Box", group="Trendlines")
trend_border_color = input.color(color.white, "Trend Border Color", group="Trendlines")
trend_border_width = input.int(1, "Trend Border Width", minval=1, maxval=5, group="Trendlines")
show_45_degree_lines = input.bool(false, "Show 50% Projection Angle", group="Trendlines")
extend_45_degree_pivot2 = input.bool(false, "Extend 50% Projection Angle Beyond Box", group="Trendlines")
show_25_percent_line = input.bool(false, "Show 25% Projection Angle", group="Trendlines")
extend_25_percent_line = input.bool(false, "Extend 25% Projection Angle Beyond Box", group="Trendlines")
extend_angles_beyond_box = input.bool(false, "Extend Mirror Line", group="Trendlines")
angle_45_color = input.color(color.yellow, "Projection Angle Line Color", group="Trendlines")
angle_45_width = input.int(2, "Projection Angle Line Width", minval=1, maxval=5, group="Trendlines")
angle_45_style = input.string("Solid", "Projection Angle Line Style", options=["Solid", "Dashed", "Dotted"], group="Trendlines")
fib_line_width = input.int(1, "Trendline Width", minval=1, maxval=5, group="Trendlines")
fib_main_style = input.string("Solid", "Main Trendline Style", options=["Solid", "Dashed", "Dotted"], group="Trendlines")
fib_50_style = input.string("Solid", "50% Trendline Style", options=["Solid", "Dashed", "Dotted"], group="Trendlines")
fib_25_style = input.string("Solid", "25% Trendline Style", options=["Solid", "Dashed", "Dotted"], group="Trendlines")

// === EXTRA ANGLES ===
show_center_to_corner = input.bool(false, "Show Box Center to Right Corner (Pivot 1 Level)", group="Extra Angles")
show_25_mirror_intersection = input.bool(false, "Show Box Center to 25% Fib/Mirror Intersection", group="Extra Angles")
show_25_projection_intersection = input.bool(false, "Show Box Center to 25% Fib/Projection Intersection", group="Extra Angles")
show_center_to_25_projection_point = input.bool(false, "Show Box Center to 25% Projection Point", group="Extra Angles")
show_inflection_lines = input.bool(false, "Show Inflection Lines (Fib/50% to 25% Trendline)", group="Extra Angles")
show_inflection_trends = input.bool(false, "Inflection Trends (Fib Start to 25% Trendline)", group="Extra Angles")
show_original_inflection_trends = input.bool(true, "Show Original Trend Inflections", group="Extra Angles")
extend_inflection_trends = input.string("None", "Extend Inflection Trends", options=["None", "Left", "Right", "Both"], group="Extra Angles")
new_angle_color = input.color(color.orange, "Extra Angles Color", group="Extra Angles")
new_angle_width = input.int(2, "Extra Angles Width", minval=1, maxval=5, group="Extra Angles")
new_angle_style = input.string("Solid", "Extra Angles Style", options=["Solid", "Dashed", "Dotted"], group="Extra Angles")

// === BOX STATISTICS ===
box_stats_size = input.string("Tiny", "Box Stats Size", options=["Tiny", "Small", "Normal"], group="Box Statistics")
box_stats_color = input.color(color.white, "Box Stats Text Color", group="Box Statistics")

// === PIVOT 1 PROJECTION ===
show_pivot1_projection = input.bool(true, "Show Pivot 1 Projection", group="Pivot 1 Projection")
projection_bg_color = input.color(color.blue, "Projection Background Color", group="Pivot 1 Projection")
projection_transparency = input.int(80, "Projection Transparency", minval=0, maxval=100, group="Pivot 1 Projection")
show_projection_sum = input.bool(true, "Show Projection Sum Label", group="Pivot 1 Projection")

// === COLORS (CONSOLIDATED) ===
bullish_color = input.color(color.lime, "Bullish Color", group="Colors")
bearish_color = input.color(color.red, "Bearish Color", group="Colors")
neutral_color = input.color(color.white, "Neutral Color", group="Colors")
fibonacci_bg_color = input.color(color.black, "Fibonacci Number Background", group="Colors")
fibonacci_text_color = input.color(color.white, "Fibonacci Number Text", group="Colors")
special_sum_bg_color = input.color(color.orange, "Special Sum Background (sum=9)", group="Colors")
special_sum_text_color = input.color(color.black, "Special Sum Text (sum=9)", group="Colors")

// === FIBONACCI RETRACEMENTS ===
show_fib_retracement = input.bool(true, "Show Fib Retracement", group="Fibonacci Levels")
extend_to_25_percent = input.bool(false, "Extend Fib Lines to 25% Trendline (instead of 50%)", group="Fibonacci Levels")
show_level_5_extended = input.bool(false, "Show Level 5 Extended Right", group="Fibonacci Levels")
fib_retr_width = input.int(1, "Fib Retracement Width", minval=1, maxval=5, group="Fibonacci Levels")

// === CONFIGURABLE LEVELS ===
show_level_1 = input.bool(true, "Show Level 1", group="Retracement Levels")
level_1_value = input.float(0.0, "Level 1 Value", step=0.001, group="Retracement Levels")
level_1_style = input.string("Solid", "Level 1 Style", options=["Solid", "Dashed", "Dotted"], group="Retracement Levels")

show_level_2 = input.bool(true, "Show Level 2", group="Retracement Levels")
level_2_value = input.float(0.125, "Level 2 Value", step=0.001, group="Retracement Levels")
level_2_style = input.string("Dashed", "Level 2 Style", options=["Solid", "Dashed", "Dotted"], group="Retracement Levels")

show_level_3 = input.bool(true, "Show Level 3", group="Retracement Levels")
level_3_value = input.float(0.25, "Level 3 Value", step=0.001, group="Retracement Levels")
level_3_style = input.string("Dashed", "Level 3 Style", options=["Solid", "Dashed", "Dotted"], group="Retracement Levels")

show_level_4 = input.bool(true, "Show Level 4", group="Retracement Levels")
level_4_value = input.float(0.375, "Level 4 Value", step=0.001, group="Retracement Levels")
level_4_style = input.string("Dashed", "Level 4 Style", options=["Solid", "Dashed", "Dotted"], group="Retracement Levels")

show_level_5 = input.bool(true, "Show Level 5", group="Retracement Levels")
level_5_value = input.float(0.5, "Level 5 Value", step=0.001, group="Retracement Levels")
level_5_style = input.string("Solid", "Level 5 Style", options=["Solid", "Dashed", "Dotted"], group="Retracement Levels")

show_level_6 = input.bool(true, "Show Level 6", group="Retracement Levels")
level_6_value = input.float(0.625, "Level 6 Value", step=0.001, group="Retracement Levels")
level_6_style = input.string("Dashed", "Level 6 Style", options=["Solid", "Dashed", "Dotted"], group="Retracement Levels")

show_level_7 = input.bool(true, "Show Level 7", group="Retracement Levels")
level_7_value = input.float(0.75, "Level 7 Value", step=0.001, group="Retracement Levels")
level_7_style = input.string("Dashed", "Level 7 Style", options=["Solid", "Dashed", "Dotted"], group="Retracement Levels")

show_level_8 = input.bool(true, "Show Level 8", group="Retracement Levels")
level_8_value = input.float(0.875, "Level 8 Value", step=0.001, group="Retracement Levels")
level_8_style = input.string("Dashed", "Level 8 Style", options=["Solid", "Dashed", "Dotted"], group="Retracement Levels")

show_level_9 = input.bool(true, "Show Level 9", group="Retracement Levels")
level_9_value = input.float(1.0, "Level 9 Value", step=0.001, group="Retracement Levels")
level_9_style = input.string("Solid", "Level 9 Style", options=["Solid", "Dashed", "Dotted"], group="Retracement Levels")

// === LABELS ===
fib_label_bg_color = input.color(color.new(color.blue, 80), "Fib Label Background", group="Labels")
fib_label_text_color = input.color(color.white, "Fib Label Text", group="Labels")
fib_label_offset = input.int(0, "Fib Label Offset (bars)", minval=0, maxval=50, group="Labels", tooltip="Moves left-aligned labels further left and right-aligned labels further right")
show_fib_level_labels = input.bool(true, "Show Fib Level Labels", group="Labels")
show_bar_count_labels = input.bool(false, "Show Bar Count Labels on Chart", group="Labels")
show_sum_labels = input.bool(false, "Show Sum Labels on Chart", group="Labels")
chart_label_size = input.string("Small", "Chart Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group="Labels")

// === HELPER FUNCTIONS ===
get_line_style(style_str) => style_str == "Dashed" ? line.style_dashed : style_str == "Dotted" ? line.style_dotted : line.style_solid

get_label_size(size_str) => size_str == "Tiny" ? size.tiny : size_str == "Small" ? size.small : size_str == "Normal" ? size.normal : size_str == "Large" ? size.large : size.huge

get_extend_type(extend_str) => extend_str == "Left" ? extend.left : extend_str == "Right" ? extend.right : extend_str == "Both" ? extend.both : extend.none

get_contrast_text_color(bg_color) => 
    bg_color == color.white or bg_color == neutral_color or bg_color == bullish_color ? color.black : color.white

// === INTERSECTION CALCULATION FUNCTIONS ===
// Function to calculate intersection of two lines using bar indices
line_intersection(x1, y1, x2, y2, x3, y3, x4, y4) =>
    denom = (x1-x2)*(y3-y4) - (y1-y2)*(x3-x4)
    if math.abs(denom) < 0.0001  // Lines are parallel
        [na, na]
    else
        t = ((x1-x3)*(y3-y4) - (y1-y3)*(x3-x4)) / denom
        intersection_x = x1 + t*(x2-x1)
        intersection_y = y1 + t*(y2-y1)
        [intersection_x, intersection_y]

// === LEVEL ARRAYS ===
level_shows = array.from(show_level_1, show_level_2, show_level_3, show_level_4, show_level_5, show_level_6, show_level_7, show_level_8, show_level_9)
level_values = array.from(level_1_value, level_2_value, level_3_value, level_4_value, level_5_value, level_6_value, level_7_value, level_8_value, level_9_value)
level_styles = array.from(level_1_style, level_2_style, level_3_style, level_4_style, level_5_style, level_6_style, level_7_style, level_8_style, level_9_style)

numerology_sum_price(price) =>
    price_str = str.replace(str.tostring(price), ".", "")
    digit_sum = 0
    i = 0
    while i < str.length(price_str)
        char = str.substring(price_str, i, i + 1)
        if char != "." and char != "-"
            digit_sum := digit_sum + (char == "0" ? 0 : char == "1" ? 1 : char == "2" ? 2 : char == "3" ? 3 : char == "4" ? 4 : char == "5" ? 5 : char == "6" ? 6 : char == "7" ? 7 : char == "8" ? 8 : 9)
        i := i + 1
    while digit_sum > 9
        tens = math.floor(digit_sum / 10)
        ones = digit_sum % 10
        digit_sum := tens + ones
    digit_sum

is_fibonacci(num) => num == 1 or num == 2 or num == 3 or num == 5 or num == 8 or num == 13 or num == 21 or num == 34 or num == 55 or num == 89 or num == 144 or num == 233 or num == 377 or num == 610 or num == 987 or num == 1597 or num == 2584 or num == 4181 or num == 6765

get_trend_color(is_bearish) => is_bearish ? bearish_color : bullish_color

draw_fib_trendlines_from_points(start_bar, start_price, end_bar, end_price, is_bearish, line_width, main_style, style_50, style_25) =>
    is_uptrend = start_bar < end_bar and start_price < end_price
    price_range = math.abs(end_price - start_price)
    fib_50_price = is_uptrend ? start_price + (price_range * 0.5) : start_price - (price_range * 0.5)
    fib_25_price = is_uptrend ? start_price + (price_range * 0.25) : start_price - (price_range * 0.25)
    trend_color = get_trend_color(is_bearish)
    line.new(xloc = xloc.bar_index, x1 = start_bar, y1 = start_price, x2 = end_bar, y2 = end_price, color=trend_color, width=line_width, style=get_line_style(main_style), extend=extend.right)
    line.new(xloc = xloc.bar_index, x1 = start_bar, y1 = start_price, x2 = end_bar, y2 = fib_50_price, color=trend_color, width=line_width, style=get_line_style(style_50), extend=extend.right)
    line.new(xloc = xloc.bar_index, x1 = start_bar, y1 = start_price, x2 = end_bar, y2 = fib_25_price, color=trend_color, width=line_width, style=get_line_style(style_25), extend=extend.right)

// === PIVOT TRACKING ===
var float pivot_1_high = na
var float pivot_1_low = na
var float pivot_1_close = na
var int pivot_1_bar = na
var float pivot_2_high = na
var float pivot_2_low = na
var float pivot_2_close = na
var int pivot_2_bar = na

if time >= value_1 and na(pivot_1_bar)
    pivot_1_high := high
    pivot_1_low := low
    pivot_1_close := close
    pivot_1_bar := bar_index

if time >= value_2 and na(pivot_2_bar)
    pivot_2_high := high
    pivot_2_low := low
    pivot_2_close := close
    pivot_2_bar := bar_index

// === TREND CALCULATION ===
var int start_bar = na
var int end_bar = na
var float start_high = na
var float start_low = na
var float end_high = na
var float end_low = na
var bool is_bearish_trend = na
var float start_price = na
var float end_price = na

if not na(pivot_1_high) and not na(pivot_2_high) and na(start_bar)
    chronological_order = pivot_1_bar < pivot_2_bar
    start_bar := chronological_order ? pivot_1_bar : pivot_2_bar
    end_bar := chronological_order ? pivot_2_bar : pivot_1_bar
    start_high := chronological_order ? pivot_1_high : pivot_2_high
    start_low := chronological_order ? pivot_1_low : pivot_2_low
    end_high := chronological_order ? pivot_2_high : pivot_1_high
    end_low := chronological_order ? pivot_2_low : pivot_1_low
    is_bearish_trend := start_high > end_low
    start_price := is_bearish_trend ? start_high : start_low
    end_price := is_bearish_trend ? end_low : end_high

// === DRAW TRENDLINES ===
var bool trend_drawn = false
if show_fib_trendlines and not na(start_bar) and barstate.islast and not trend_drawn
    draw_fib_trendlines_from_points(start_bar, start_price, end_bar, end_price, is_bearish_trend, fib_line_width, fib_main_style, fib_50_style, fib_25_style)
    trend_drawn := true

// === DRAW TREND BORDER BOX ===
var bool trend_border_drawn = false
var int box_left_bar = na
var int box_right_bar = na
var float box_top_price = na
var float box_bottom_price = na

if show_trend_border and not na(pivot_1_bar) and not na(pivot_2_bar) and barstate.islast and not trend_border_drawn
    box_left_bar := pivot_1_bar
    pivot_distance = pivot_2_bar - pivot_1_bar
    box_right_bar := pivot_2_bar + pivot_distance
    box_top_price := math.max(pivot_1_high, pivot_2_high)
    box_bottom_price := math.min(pivot_1_low, pivot_2_low)
    
    box.new(xloc=xloc.bar_index, left=box_left_bar, top=box_top_price, right=box_right_bar, bottom=box_bottom_price, 
             border_color=trend_border_color, border_width=trend_border_width, border_style=line.style_solid, 
             bgcolor=color.new(color.white, 100))
    
    trend_border_drawn := true

// === BOX STATISTICS ===
var label lbl_box_stats = na
var label lbl_echo_info = na

if show_trend_border and not na(box_left_bar) and not na(box_right_bar) and barstate.islast
    bar_range = box_right_bar - box_left_bar
    price_range = box_top_price - box_bottom_price
    diff_from_box_right = bar_index - box_right_bar
    
    stats_text = "Bars: " + str.tostring(bar_range) + " | Range: " + str.tostring(price_range, "#.##") + " | Diff: " + (diff_from_box_right >= 0 ? "+" : "") + str.tostring(diff_from_box_right)
    
    label_y = is_bearish_trend ? box_top_price : box_bottom_price
    label_style = is_bearish_trend ? label.style_label_lower_right : label.style_label_upper_right
    
    if na(lbl_box_stats)
        lbl_box_stats := label.new(xloc=xloc.bar_index, x=box_right_bar, y=label_y, 
                                   text=stats_text, style=label_style, 
                                   textcolor=box_stats_color, color=color.new(color.white, 100), 
                                   size=get_label_size(box_stats_size))
    else
        label.set_text(lbl_box_stats, stats_text)
        label.set_y(lbl_box_stats, label_y)
        label.set_style(lbl_box_stats, label_style)
    
    if enable_echo
        echo_text = "Echo Fib: " + str.tostring(echo_multiplier, "#.###")
        echo_label_y = is_bearish_trend ? box_bottom_price : box_top_price
        echo_label_style = is_bearish_trend ? label.style_label_upper_left : label.style_label_lower_left
        
        if na(lbl_echo_info)
            lbl_echo_info := label.new(xloc=xloc.bar_index, x=box_left_bar, y=echo_label_y, 
                                       text=echo_text, style=echo_label_style, 
                                       textcolor=box_stats_color, color=color.new(color.white, 100), 
                                       size=get_label_size(box_stats_size))
        else
            label.set_text(lbl_echo_info, echo_text)
            label.set_y(lbl_echo_info, echo_label_y)
            label.set_style(lbl_echo_info, echo_label_style)
    else
        if not na(lbl_echo_info)
            label.delete(lbl_echo_info)
            lbl_echo_info := na

// === GANN MIRROR ANGLE CALCULATION ===
var bool gann_mirror_drawn = false

if show_gann_mirror and not na(start_bar) and not na(end_bar) and not na(pivot_2_bar) and barstate.islast and not gann_mirror_drawn
    bar_distance = end_bar - start_bar
    price_distance = end_price - start_price
    original_slope = bar_distance != 0 ? price_distance / bar_distance : 0
    
    mirror_slope = -original_slope
    
    pivot_distance = pivot_2_bar - pivot_1_bar
    extension_bars = extend_angles_beyond_box ? pivot_distance * 3 : pivot_distance
    mirror_end_bar = pivot_2_bar + math.round(extension_bars)
    
    pivot_2_start_price = is_bearish_trend ? pivot_2_low : pivot_2_high
    mirror_bar_diff = mirror_end_bar - pivot_2_bar
    mirror_end_price = pivot_2_start_price + (mirror_slope * mirror_bar_diff)
    
    mirror_extend = extend_angles_beyond_box ? extend.right : extend.none
    line.new(xloc=xloc.bar_index, x1=pivot_2_bar, y1=pivot_2_start_price, x2=mirror_end_bar, y2=mirror_end_price, 
             color=gann_mirror_color, width=gann_mirror_width, style=get_line_style(gann_mirror_style), extend=mirror_extend)
    
    gann_mirror_drawn := true

// === NEW ANGLES CALCULATION ===
var bool new_angles_drawn = false

if ((show_25_projection_intersection or show_25_mirror_intersection or show_center_to_corner or show_center_to_25_projection_point) and not na(start_bar) and not na(end_bar) and not na(pivot_2_bar) and barstate.islast and not new_angles_drawn)
    
    is_uptrend = start_bar < end_bar and start_price < end_price
    price_range = math.abs(end_price - start_price)
    fib_25_price = is_uptrend ? start_price + (price_range * 0.25) : start_price - (price_range * 0.25)
    
    fib_line_x1 = start_bar
    fib_line_y1 = start_price
    fib_line_x2 = end_bar
    fib_line_y2 = fib_25_price
    
    pivot_distance = pivot_2_bar - pivot_1_bar
    box_center_bar = pivot_1_bar + pivot_distance
    box_top_price = math.max(pivot_1_high, pivot_2_high)
    box_bottom_price = math.min(pivot_1_low, pivot_2_low)
    box_center_price = (box_top_price + box_bottom_price) / 2
    
    if show_25_projection_intersection and show_fib_trendlines and show_gann_mirror
        box_right_bar = pivot_2_bar + pivot_distance
        box_price_range = box_top_price - box_bottom_price
        box_25_percent_price = is_bearish_trend ? box_bottom_price + (box_price_range * 0.25) : box_bottom_price + (box_price_range * 0.75)
        
        proj_line_x1 = pivot_2_bar
        proj_line_y1 = end_price
        proj_line_x2 = box_right_bar
        proj_line_y2 = box_25_percent_price
        
        [intersection_proj_x, intersection_proj_y] = line_intersection(fib_line_x1, fib_line_y1, fib_line_x2, fib_line_y2, proj_line_x1, proj_line_y1, proj_line_x2, proj_line_y2)
        
        if not na(intersection_proj_x) and not na(intersection_proj_y)            
            line.new(xloc=xloc.bar_index, x1=box_center_bar, y1=box_center_price, 
                     x2=math.round(intersection_proj_x), y2=intersection_proj_y,
                     color=new_angle_color, width=new_angle_width, style=get_line_style(new_angle_style), extend=extend.right)
    
    if show_25_mirror_intersection and show_fib_trendlines and show_gann_mirror
        bar_distance = end_bar - start_bar
        price_distance = end_price - start_price
        original_slope = bar_distance != 0 ? price_distance / bar_distance : 0
        mirror_slope = -original_slope
        
        pivot_2_start_price = is_bearish_trend ? pivot_2_low : pivot_2_high
        
        mirror_25_bar = pivot_2_bar + math.round(pivot_distance * 0.25)
        mirror_25_price = pivot_2_start_price + (mirror_slope * (pivot_distance * 0.25))
        
        [intersection_mirror_x, intersection_mirror_y] = line_intersection(fib_line_x1, fib_line_y1, fib_line_x2, fib_line_y2, pivot_2_bar, pivot_2_start_price, mirror_25_bar, mirror_25_price)
        
        if not na(intersection_mirror_x) and not na(intersection_mirror_y)            
            line.new(xloc=xloc.bar_index, x1=box_center_bar, y1=box_center_price, 
                     x2=math.round(intersection_mirror_x), y2=intersection_mirror_y,
                     color=new_angle_color, width=new_angle_width, style=get_line_style(new_angle_style), extend=extend.right)
    
    if show_center_to_corner
        box_right_bar = pivot_2_bar + pivot_distance
        corner_price = start_price
        
        line.new(xloc=xloc.bar_index, x1=box_center_bar, y1=box_center_price, 
                 x2=box_right_bar, y2=corner_price,
                 color=new_angle_color, width=new_angle_width, style=get_line_style(new_angle_style), extend=extend.right)
    
    if show_center_to_25_projection_point
        box_right_bar = pivot_2_bar + pivot_distance
        box_price_range = box_top_price - box_bottom_price
        projection_25_price = is_bearish_trend ? box_bottom_price + (box_price_range * 0.25) : box_bottom_price + (box_price_range * 0.75)
        
        line.new(xloc=xloc.bar_index, x1=box_center_bar, y1=box_center_price, 
                 x2=box_right_bar, y2=projection_25_price,
                 color=new_angle_color, width=new_angle_width, style=get_line_style(new_angle_style), extend=extend.right)
    
    new_angles_drawn := true

// === DRAW ECHO FIB DOTS ALONG MIRROR LINE ===
var bool echo_dots_drawn = false

if enable_echo and show_gann_mirror and not na(start_bar) and not na(end_bar) and not na(pivot_2_bar) and barstate.islast and not echo_dots_drawn
    
    bar_distance = pivot_2_bar - pivot_1_bar
    
    price_distance = end_price - start_price
    original_slope = (end_bar - start_bar) != 0 ? price_distance / (end_bar - start_bar) : 0
    mirror_slope = -original_slope
    
    pivot_distance = pivot_2_bar - pivot_1_bar
    base_mirror_end_bar = pivot_2_bar + pivot_distance
    base_mirror_bar_diff = base_mirror_end_bar - pivot_2_bar
    
    mirror_start_price = is_bearish_trend ? pivot_2_low : pivot_2_high
    base_mirror_end_price = mirror_start_price + (mirror_slope * base_mirror_bar_diff)
    
    for i = 0 to 8
        if array.get(level_shows, i)
            base_level_value = array.get(level_values, i)
            level_value = base_level_value * echo_multiplier
            
            if level_value != 0.0
                if level_value > 1.0 and not extend_angles_beyond_box
                    continue
                    
                dot_bar = 0
                dot_price = 0.0
                
                if level_value <= 1.0
                    // Use math.round for consistent rounding
                    dot_bar := pivot_2_bar + math.round(level_value * bar_distance)
                    dot_price := mirror_start_price + level_value * (base_mirror_end_price - mirror_start_price)
                else
                    extension_factor = level_value - 1.0
                    extended_bar = pivot_2_bar + bar_distance + math.round(extension_factor * bar_distance)
                    extended_price_diff = (base_mirror_end_price - mirror_start_price) * extension_factor
                    
                    dot_bar := extended_bar
                    dot_price := base_mirror_end_price + extended_price_diff
                
                dot_text = str.tostring(level_value, "#.###")
                
                if show_echo_labels == "Labels"
                    label.new(xloc=xloc.bar_index, x=dot_bar, y=dot_price, 
                             text=dot_text, style=label.style_label_left, 
                             textcolor=color.black, color=echo_color, 
                             size=size.small)
                else if show_echo_labels == "Dots"
                    label.new(xloc=xloc.bar_index, x=dot_bar, y=dot_price, 
                             text="●", style=label.style_none, 
                             textcolor=echo_color, color=color.new(echo_color, 100), 
                             size=size.tiny, tooltip=dot_text)
    
    echo_dots_drawn := true

// === MIRROR INFLECTIONS TO ECHO SYSTEM ===
var bool mirror_inflections_drawn = false

if mirror_inflections_to_echo and enable_echo and show_gann_mirror and not na(start_bar) and not na(end_bar) and not na(pivot_2_bar) and barstate.islast and not mirror_inflections_drawn
    
    bar_distance = pivot_2_bar - pivot_1_bar
    
    price_distance = end_price - start_price
    original_slope = (end_bar - start_bar) != 0 ? price_distance / (end_bar - start_bar) : 0
    mirror_slope = -original_slope
    
    pivot_distance = pivot_2_bar - pivot_1_bar
    mirror_start_price = is_bearish_trend ? pivot_2_low : pivot_2_high
    
    // Use precise float calculations and round only at the end
    echo_main_end_bar_float = pivot_2_bar + (pivot_distance * echo_multiplier)
    echo_main_end_bar = math.round(echo_main_end_bar_float)
    echo_main_bar_diff = echo_main_end_bar - pivot_2_bar
    echo_main_end_price = mirror_start_price + (mirror_slope * echo_main_bar_diff)
    
    echo_50_price_range = echo_main_end_price - mirror_start_price
    echo_50_end_price = mirror_start_price + (echo_50_price_range * 0.5)
    echo_25_end_price = mirror_start_price + (echo_50_price_range * 0.25)
    
    echo_bar_distance_float = bar_distance * echo_multiplier
    echo_bar_distance = math.round(echo_bar_distance_float)
    echo_main_slope = echo_bar_distance != 0 ? (echo_main_end_price - mirror_start_price) / echo_bar_distance : 0
    echo_50_slope = echo_bar_distance != 0 ? (echo_50_end_price - mirror_start_price) / echo_bar_distance : 0
    echo_25_slope = echo_bar_distance != 0 ? (echo_25_end_price - mirror_start_price) / echo_bar_distance : 0
    
    for i = 0 to 8
        if array.get(level_shows, i)
            base_level_value = array.get(level_values, i)
            level_value = base_level_value * echo_multiplier
            
            if level_value != 0.0
                if level_value > echo_multiplier and not extend_angles_beyond_box
                    continue
                
                level_factor = level_value / echo_multiplier
                echo_level_price = mirror_start_price + (echo_main_end_price - mirror_start_price) * level_factor
                
                // Use consistent rounding
                echo_level_bar = pivot_2_bar + math.round(level_value * bar_distance)
                
                if echo_50_slope != 0 and echo_main_slope != 0
                    // Keep as float for calculation, round only when drawing
                    intersection_bar_50_echo_float = pivot_2_bar + (echo_level_price - mirror_start_price) / echo_50_slope
                    intersection_bar_50_echo = math.round(intersection_bar_50_echo_float)
                    bar_offset_from_pivot2 = intersection_bar_50_echo - pivot_2_bar
                    intersection_price_25_echo = mirror_start_price + echo_25_slope * bar_offset_from_pivot2
                    
                    if show_inflection_lines
                        line.new(xloc = xloc.bar_index, x1 = intersection_bar_50_echo, y1 = echo_level_price, x2 = intersection_bar_50_echo, y2 = intersection_price_25_echo, color = new_angle_color, width = new_angle_width, style = get_line_style(new_angle_style))
                    
                    if show_inflection_trends
                        trend_extend = get_extend_type(extend_echo_inflection_trends)
                        line.new(xloc = xloc.bar_index, x1 = echo_level_bar, y1 = echo_level_price, x2 = intersection_bar_50_echo, y2 = intersection_price_25_echo, color = new_angle_color, width = new_angle_width, style = get_line_style(new_angle_style), extend = trend_extend)
    
    mirror_inflections_drawn := true

// === DRAW PIVOT 1 VERTICAL BAR ===
var bool pivot1_bar_drawn = false
var label lbl_projection_sum = na

if show_pivot1_projection and not na(pivot_1_bar) and not na(pivot_2_bar) and not na(is_bearish_trend) and barstate.islast and not pivot1_bar_drawn
    bar_width = pivot_2_bar - pivot_1_bar
    
    bar_left = pivot_1_bar - bar_width
    bar_right = pivot_1_bar
    
    projection_start_bar = pivot_1_bar - bar_width
    projection_end_bar = pivot_1_bar
    
    range_high = pivot_1_high
    range_low = pivot_1_low
    
    for i = math.max(0, projection_start_bar) to projection_end_bar
        if i >= 0 and i <= bar_index
            bar_high = high[bar_index - i]
            bar_low = low[bar_index - i]
            if not na(bar_high)
                range_high := math.max(range_high, bar_high)
            if not na(bar_low)
                range_low := math.min(range_low, bar_low)
    
    vertical_bar_top = range_high
    vertical_bar_bottom = range_low
    
    box.new(xloc=xloc.bar_index, left=bar_left, top=vertical_bar_top, right=bar_right, bottom=vertical_bar_bottom, 
             border_color=color.new(projection_bg_color, 100), border_width=0, 
             bgcolor=color.new(projection_bg_color, projection_transparency))
    
    left_edge_bar_index = projection_start_bar
    left_edge_close = left_edge_bar_index >= 0 and left_edge_bar_index <= bar_index ? close[bar_index - left_edge_bar_index] : start_price
    
    if show_projection_sum
        projection_sum = numerology_sum_price(left_edge_close)
        projection_sum_color = is_fibonacci(projection_sum) ? bullish_color : neutral_color
        projection_sum_is_nine = projection_sum == 9
        
        sum_bg_color = is_fibonacci(projection_sum) ? fibonacci_bg_color : (projection_sum_is_nine ? special_sum_bg_color : projection_sum_color)
        sum_text_color = is_fibonacci(projection_sum) ? fibonacci_text_color : (projection_sum_is_nine ? special_sum_text_color : get_contrast_text_color(sum_bg_color))
        
        if na(lbl_projection_sum)
            lbl_projection_sum := label.new(xloc=xloc.bar_index, x=bar_left, y=vertical_bar_bottom, 
                                           text=str.tostring(projection_sum), style=label.style_label_up, 
                                           textcolor=sum_text_color, color=sum_bg_color, 
                                           size=size.small)
        else
            label.set_text(lbl_projection_sum, str.tostring(projection_sum))
            label.set_color(lbl_projection_sum, sum_bg_color)
            label.set_textcolor(lbl_projection_sum, sum_text_color)
            label.set_x(lbl_projection_sum, bar_left)
            label.set_y(lbl_projection_sum, vertical_bar_bottom)
    else
        if not na(lbl_projection_sum)
            label.delete(lbl_projection_sum)
            lbl_projection_sum := na
    
    pivot1_bar_drawn := true

// === DRAW 50% PROJECTION ANGLE FROM PIVOT 2 ===
var bool angle_45_drawn = false
if show_45_degree_lines and not na(start_bar) and not na(pivot_1_bar) and barstate.islast and not angle_45_drawn
    pivot_distance = pivot_2_bar - pivot_1_bar
    box_right_bar = pivot_2_bar + pivot_distance
    
    box_top_price := math.max(pivot_1_high, pivot_2_high)
    box_bottom_price := math.min(pivot_1_low, pivot_2_low)
    price_range = box_top_price - box_bottom_price
    box_50_percent_price = box_bottom_price + (price_range * 0.5)
    
    line_extend = extend_45_degree_pivot2 ? extend.right : extend.none
    line.new(xloc=xloc.bar_index, x1=pivot_2_bar, y1=end_price, x2=box_right_bar, y2=box_50_percent_price, 
             color=angle_45_color, width=angle_45_width, style=get_line_style(angle_45_style), extend=line_extend)
    
    angle_45_drawn := true

// === DRAW 25% PROJECTION ANGLE FROM PIVOT 2 ===
var bool angle_25_drawn = false
if show_25_percent_line and not na(start_bar) and not na(pivot_1_bar) and barstate.islast and not angle_25_drawn
    pivot_distance = pivot_2_bar - pivot_1_bar
    box_right_bar = pivot_2_bar + pivot_distance
    
    box_top_price := math.max(pivot_1_high, pivot_2_high)
    box_bottom_price := math.min(pivot_1_low, pivot_2_low)
    price_range = box_top_price - box_bottom_price
    
    box_25_percent_price = is_bearish_trend ? box_bottom_price + (price_range * 0.25) : box_bottom_price + (price_range * 0.75)
    
    line_extend = extend_25_percent_line ? extend.right : extend.none
    line.new(xloc=xloc.bar_index, x1=pivot_2_bar, y1=end_price, x2=box_right_bar, y2=box_25_percent_price, 
             color=angle_45_color, width=angle_45_width, style=get_line_style(angle_45_style), extend=line_extend)
    
    angle_25_drawn := true

// === FIBONACCI RETRACEMENT ===
var bool fib_retr_drawn = false
var bool fib_labels_drawn = false

var float calculated_price_range = na
var bool calculated_is_uptrend = na
var float calculated_high_price = na
var float calculated_low_price = na
var float calculated_alignment_end_price = na
var float calculated_main_trendline_slope = na
var float calculated_trendline_slope = na
var float calculated_slope_50 = na
var float calculated_slope_25 = na
var color calculated_fib_color = na

if (show_fib_retracement or show_fib_level_labels or ((show_inflection_lines or show_inflection_trends) and show_original_inflection_trends)) and not na(start_bar) and barstate.islast and na(calculated_price_range)
    calculated_price_range := math.abs(end_price - start_price)
    calculated_is_uptrend := start_price < end_price
    calculated_high_price := calculated_is_uptrend ? end_price : start_price
    calculated_low_price := calculated_is_uptrend ? start_price : end_price
    
    alignment_percentage = extend_to_25_percent ? 0.25 : 0.5
    calculated_alignment_end_price := calculated_is_uptrend ? start_price + (calculated_price_range * alignment_percentage) : start_price - (calculated_price_range * alignment_percentage)
    
    bar_range = end_bar - start_bar
    calculated_trendline_slope := bar_range != 0 ? (calculated_alignment_end_price - start_price) / bar_range : 0
    calculated_main_trendline_slope := bar_range != 0 ? (end_price - start_price) / bar_range : 0
    calculated_fib_color := get_trend_color(is_bearish_trend)
    
    fib_50_price = calculated_is_uptrend ? start_price + (calculated_price_range * 0.5) : start_price - (calculated_price_range * 0.5)
    fib_25_price = calculated_is_uptrend ? start_price + (calculated_price_range * 0.25) : start_price - (calculated_price_range * 0.25)
    calculated_slope_50 := bar_range != 0 ? (fib_50_price - start_price) / bar_range : 0
    calculated_slope_25 := bar_range != 0 ? (fib_25_price - start_price) / bar_range : 0

if show_fib_retracement and not na(calculated_price_range) and barstate.islast and not fib_retr_drawn
    for i = 0 to 8
        if array.get(level_shows, i)
            level_value = array.get(level_values, i)
            level_style = array.get(level_styles, i)
            
            level = calculated_is_uptrend ? calculated_low_price + (calculated_high_price - calculated_low_price) * level_value : calculated_high_price - (calculated_high_price - calculated_low_price) * level_value
            x_left_float = calculated_main_trendline_slope != 0 ? start_bar + (level - start_price) / calculated_main_trendline_slope : start_bar
            x_right_float = calculated_trendline_slope != 0 ? start_bar + (level - start_price) / calculated_trendline_slope : end_bar
            x_left = math.round(x_left_float)
            x_right = math.round(x_right_float)
            
            line_extend = (i == 4 and show_level_5_extended) ? extend.right : extend.none
            
            line.new(xloc = xloc.bar_index, x1 = x_left, y1 = level, x2 = x_right, y2 = level, color = calculated_fib_color, width = fib_retr_width, style = get_line_style(level_style), extend = line_extend)
    
    fib_retr_drawn := true

if (show_inflection_lines or show_inflection_trends) and show_original_inflection_trends and not na(calculated_price_range) and barstate.islast
    for i = 0 to 8
        if array.get(level_shows, i)
            level_value = array.get(level_values, i)
            
            should_skip_level_1 = (level_value == 1.0 and show_trend_border and show_inflection_lines)
            
            if level_value != 0.0 and not should_skip_level_1
                level = calculated_is_uptrend ? calculated_low_price + (calculated_high_price - calculated_low_price) * level_value : calculated_high_price - (calculated_high_price - calculated_low_price) * level_value
                x_left_float = calculated_main_trendline_slope != 0 ? start_bar + (level - start_price) / calculated_main_trendline_slope : start_bar
                x_left = math.round(x_left_float)
                
                if calculated_slope_50 != 0
                    intersection_bar_50_float = start_bar + (level - start_price) / calculated_slope_50
                    intersection_bar_50 = math.round(intersection_bar_50_float)
                    bar_offset = intersection_bar_50 - start_bar
                    intersection_price_25 = start_price + calculated_slope_25 * bar_offset
                    
                    if show_inflection_lines
                        line.new(xloc = xloc.bar_index, x1 = intersection_bar_50, y1 = level, x2 = intersection_bar_50, y2 = intersection_price_25, color = new_angle_color, width = new_angle_width, style = get_line_style(new_angle_style))
                    
                    if show_inflection_trends
                        trend_extend = get_extend_type(extend_inflection_trends)
                        line.new(xloc = xloc.bar_index, x1 = x_left, y1 = level, x2 = intersection_bar_50, y2 = intersection_price_25, color = new_angle_color, width = new_angle_width, style = get_line_style(new_angle_style), extend = trend_extend)

if show_fib_level_labels and not na(calculated_price_range) and barstate.islast and not fib_labels_drawn
    for i = 0 to 8
        if array.get(level_shows, i)
            level_value = array.get(level_values, i)
            
            level = calculated_is_uptrend ? calculated_low_price + (calculated_high_price - calculated_low_price) * level_value : calculated_high_price - (calculated_high_price - calculated_low_price) * level_value
            x_left_float = calculated_main_trendline_slope != 0 ? start_bar + (level - start_price) / calculated_main_trendline_slope : start_bar
            x_left = math.round(x_left_float)
            
            if (level_value != 0.0 and level_value != 1.0) or level_value == 1.0
                label_text = level_value >= 1.0 ? str.tostring(level_value, "#.###") : str.tostring(level_value, "#.###")
                label.new(xloc = xloc.bar_index, x = x_left - fib_label_offset, y = level, text = label_text, style = label.style_label_right, textcolor = fib_label_text_color, color = fib_label_bg_color, size = size.small)
    
    fib_labels_drawn := true

// === CHART LABELS ===
var label lbl_trend_count = na
var label lbl_trend_sum = na
var label lbl_pivot2_count = na
var label lbl_pivot2_sum = na

if not na(pivot_1_bar) and not na(pivot_2_bar)
    trend_count = pivot_2_bar - pivot_1_bar + 1
    trend_color = is_fibonacci(trend_count) ? bullish_color : neutral_color
    trend_sum = numerology_sum_price(pivot_1_close)
    trend_sum_color = is_fibonacci(trend_sum) ? bullish_color : neutral_color
    trend_sum_is_nine = trend_sum == 9
    
    pivot2_to_current_count = bar_index - pivot_2_bar + 1
    pivot2_count_color = is_fibonacci(pivot2_to_current_count) ? bullish_color : neutral_color
    pivot2_sum = numerology_sum_price(pivot_2_close)
    pivot2_sum_color = is_fibonacci(pivot2_sum) ? bullish_color : neutral_color
    pivot2_sum_is_nine = pivot2_sum == 9
    
    if (show_bar_count_labels or show_sum_labels) and barstate.islast
        trend_label_y = start_high
        trend_sum_label_y = start_low
        pivot2_label_y = end_high
        pivot2_sum_label_y = end_low
        
        if show_bar_count_labels
            if na(lbl_trend_count)
                count_bg_color = is_fibonacci(trend_count) ? fibonacci_bg_color : trend_color
                count_text_color = is_fibonacci(trend_count) ? fibonacci_text_color : get_contrast_text_color(trend_color)
                lbl_trend_count := label.new(x = pivot_1_bar, xloc = xloc.bar_index, y = trend_label_y, style=label.style_label_down, textcolor=count_text_color, color=count_bg_color, size=size.small, text = str.tostring(trend_count))
            
            if na(lbl_pivot2_count)
                count_bg_color = is_fibonacci(pivot2_to_current_count) ? fibonacci_bg_color : pivot2_count_color
                count_text_color = is_fibonacci(pivot2_to_current_count) ? fibonacci_text_color : get_contrast_text_color(pivot2_count_color)
                lbl_pivot2_count := label.new(x = pivot_2_bar, xloc = xloc.bar_index, y = pivot2_label_y, style=label.style_label_down, textcolor=count_text_color, color=count_bg_color, size=size.small, text = str.tostring(pivot2_to_current_count))
            else
                count_bg_color = is_fibonacci(pivot2_to_current_count) ? fibonacci_bg_color : pivot2_count_color
                count_text_color = is_fibonacci(pivot2_to_current_count) ? fibonacci_text_color : get_contrast_text_color(pivot2_count_color)
                label.set_text(lbl_pivot2_count, str.tostring(pivot2_to_current_count))
                label.set_color(lbl_pivot2_count, count_bg_color)
                label.set_textcolor(lbl_pivot2_count, count_text_color)
        
        if show_sum_labels
            if na(lbl_trend_sum)
                sum_bg_color = is_fibonacci(trend_sum) ? fibonacci_bg_color : (trend_sum_is_nine ? special_sum_bg_color : trend_sum_color)
                sum_text_color = is_fibonacci(trend_sum) ? fibonacci_text_color : (trend_sum_is_nine ? special_sum_text_color : get_contrast_text_color(sum_bg_color))
                lbl_trend_sum := label.new(x = pivot_1_bar, xloc = xloc.bar_index, y = trend_sum_label_y, style=label.style_label_up, textcolor=sum_text_color, color=sum_bg_color, size=size.small, text = str.tostring(trend_sum))
            
            if na(lbl_pivot2_sum)
                sum_bg_color = is_fibonacci(pivot2_sum) ? fibonacci_bg_color : (pivot2_sum_is_nine ? special_sum_bg_color : pivot2_sum_color)
                sum_text_color = is_fibonacci(pivot2_sum) ? fibonacci_text_color : (pivot2_sum_is_nine ? special_sum_text_color : get_contrast_text_color(sum_bg_color))
                lbl_pivot2_sum := label.new(x = pivot_2_bar, xloc = xloc.bar_index, y = pivot2_sum_label_y, style=label.style_label_up, textcolor=sum_text_color, color=sum_bg_color, size=size.small, text = str.tostring(pivot2_sum))

// === ECHO BAR COLORING ===
should_color_bar = false
if echo_bar_color and enable_echo and show_gann_mirror and not na(pivot_2_bar)
    bar_distance = pivot_2_bar - pivot_1_bar
    current_bar = bar_index
    
    for i = 0 to 8
        if array.get(level_shows, i) and not should_color_bar
            base_level_value = array.get(level_values, i)
            echo_level_value = base_level_value * echo_multiplier
            
            if echo_level_value != 0.0
                if echo_level_value > 1.0 and not extend_angles_beyond_box
                    continue
                
                echo_dot_bar = 0
                
                if echo_level_value <= 1.0
                    echo_dot_bar := pivot_2_bar + math.round(echo_level_value * bar_distance)
                else
                    extension_factor = echo_level_value - 1.0
                    echo_dot_bar := pivot_2_bar + bar_distance + math.round(extension_factor * bar_distance)
                
                if current_bar == echo_dot_bar
                    should_color_bar := true

barcolor(should_color_bar ? echo_bar_custom_color : na)