//@version=6
indicator(
     "GBPJPY – Dynamische Preiszonen",
     overlay = true,
     max_boxes_count = 10
)

// ─────────────────────────────────────────────────────────────
// Einstellungen
// ─────────────────────────────────────────────────────────────

zoneSpacing = input.float(
     0.500,
     "Abstand zwischen den Zonen",
     minval = 0.001,
     step = 0.001
)

halfThickness = input.float(
     0.025,
     "Halbe Zonendicke",
     minval = 0.001,
     step = 0.001,
     tooltip = "0,025 erzeugt z. B. bei 201,000 eine Zone von 200,975 bis 201,025."
)

barsBack = input.int(
     150,
     "Rechteck-Breite nach links",
     minval = 1,
     maxval = 10000
)

borderWidth = input.int(
     1,
     "Randstärke",
     minval = 0,
     maxval = 5
)

upperFill   = input.color(color.new(color.red, 82), "Obere Zonen")
upperBorder = input.color(color.new(color.red, 15), "Rand obere Zonen")

lowerFill   = input.color(color.new(color.lime, 84), "Untere Zonen")
lowerBorder = input.color(color.new(color.green, 10), "Rand untere Zonen")

// ─────────────────────────────────────────────────────────────
// Nächste Zonen berechnen
// ─────────────────────────────────────────────────────────────

// Verhindert, dass eine Zone auf dem aktuellen Preis liegt,
// wenn dieser genau auf einer 0,500er-Marke steht.
epsilon = syminfo.mintick / 2.0

upperLevel1 = math.ceil((close + epsilon) / zoneSpacing) * zoneSpacing
upperLevel2 = upperLevel1 + zoneSpacing

lowerLevel1 = math.floor((close - epsilon) / zoneSpacing) * zoneSpacing
lowerLevel2 = lowerLevel1 - zoneSpacing

// ─────────────────────────────────────────────────────────────
// Rechtecke erstellen
// ─────────────────────────────────────────────────────────────

var box upperBox1 = box.new(
     left = bar_index,
     top = close,
     right = bar_index + 1,
     bottom = close,
     xloc = xloc.bar_index,
     extend = extend.right,
     border_color = upperBorder,
     bgcolor = upperFill
)

var box upperBox2 = box.new(
     left = bar_index,
     top = close,
     right = bar_index + 1,
     bottom = close,
     xloc = xloc.bar_index,
     extend = extend.right,
     border_color = upperBorder,
     bgcolor = upperFill
)

var box lowerBox1 = box.new(
     left = bar_index,
     top = close,
     right = bar_index + 1,
     bottom = close,
     xloc = xloc.bar_index,
     extend = extend.right,
     border_color = lowerBorder,
     bgcolor = lowerFill
)

var box lowerBox2 = box.new(
     left = bar_index,
     top = close,
     right = bar_index + 1,
     bottom = close,
     xloc = xloc.bar_index,
     extend = extend.right,
     border_color = lowerBorder,
     bgcolor = lowerFill
)

// ─────────────────────────────────────────────────────────────
// Rechteck aktualisieren
// ─────────────────────────────────────────────────────────────

updateZone(box zoneBox, float level, color fillColor, color edgeColor) =>
    box.set_left(zoneBox, math.max(0, bar_index - barsBack))
    box.set_right(zoneBox, bar_index + 1)
    box.set_top(zoneBox, level + halfThickness)
    box.set_bottom(zoneBox, level - halfThickness)
    box.set_bgcolor(zoneBox, fillColor)
    box.set_border_color(zoneBox, edgeColor)
    box.set_border_width(zoneBox, borderWidth)
    box.set_text(zoneBox, str.tostring(level, format.mintick))
    box.set_text_color(zoneBox, edgeColor)
    box.set_text_size(zoneBox, size.small)
    box.set_text_halign(zoneBox, text.align_right)

// Nur auf der aktuellen Kerze aktualisieren
if barstate.islast
    updateZone(upperBox1, upperLevel1, upperFill, upperBorder)
    updateZone(upperBox2, upperLevel2, upperFill, upperBorder)
    updateZone(lowerBox1, lowerLevel1, lowerFill, lowerBorder)
    updateZone(lowerBox2, lowerLevel2, lowerFill, lowerBorder)