// SECTION 1: BRAND COLORS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Returns the brand bullish color (Teal #26A69A)
export color_bull() =>
    #26A69A

//@function Returns the brand bearish color (Magenta #EF5350)
export color_bear() =>
    #EF5350

//@function Returns the brand neutral color (Amber #FFB300)
export color_neut() =>
    #FFB300

//@function Returns bullish color with specified transparency
//@param transparency Transparency level 0-100 (0=opaque, 100=invisible)
export color_bull_t(int transparency) =>
    color.new(#26A69A, transparency + 0)

//@function Returns bearish color with specified transparency
//@param transparency Transparency level 0-100
export color_bear_t(int transparency) =>
    color.new(#EF5350, transparency + 0)

//@function Returns neutral color with specified transparency
//@param transparency Transparency level 0-100
export color_neut_t(int transparency) =>
    color.new(#FFB300, transparency + 0)

//@function Returns dashboard background color
export color_bg() =>
    color.new(#000000, 85)

//@function Returns primary text color (white)
export color_text() =>
    #FFFFFF

//@function Returns dimmed/secondary text color (gray)
export color_dim() =>
    #888888

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 2: MATH UTILITIES
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Clamps a value between minimum and maximum bounds
//@param val Value to clamp
//@param min_val Minimum bound
//@param max_val Maximum bound
export clamp(float val, float min_val, float max_val) =>
    math.max(min_val, math.min(max_val, val)) + 0.0

//@function Normalizes a value to 0-100 scale
//@param val Value to normalize
//@param min_val Minimum of the input range
//@param max_val Maximum of the input range
export normalize(float val, float min_val, float max_val) =>
    float range_v = max_val - min_val
    float result = range_v != 0 ? (val - min_val) / range_v * 100 : 50.0
    math.max(0.0, math.min(100.0, result)) + 0.0

//@function Linear interpolation between two values
//@param start_val Starting value
//@param end_val Ending value
//@param t Interpolation factor 0-1
export lerp(float start_val, float end_val, float t) =>
    float t_clamped = math.max(0.0, math.min(1.0, t))
    (start_val + (end_val - start_val) * t_clamped) + 0.0

//@function Maps a value from one range to another
//@param val Value to map
//@param in_min Input range minimum
//@param in_max Input range maximum
//@param out_min Output range minimum
//@param out_max Output range maximum
export map_range(float val, float in_min, float in_max, float out_min, float out_max) =>
    float in_range = in_max - in_min
    float t = in_range != 0 ? (val - in_min) / in_range : 0.5
    float t_clamped = math.max(0.0, math.min(1.0, t))
    (out_min + (out_max - out_min) * t_clamped) + 0.0

//@function Calculates percentage change between two values
//@param old_val Original value
//@param new_val New value
export pct_change(float old_val, float new_val) =>
    float result = old_val != 0 ? ((new_val - old_val) / math.abs(old_val)) * 100 : 0.0
    result + 0.0

//@function Calculates absolute percentage difference between two values
//@param val1 First value
//@param val2 Second value
export pct_diff(float val1, float val2) =>
    float avg = (val1 + val2) / 2
    float result = avg != 0 ? math.abs(val1 - val2) / avg * 100 : 0.0
    result + 0.0

//@function Returns ATR value with safety fallback
//@param atr_val ATR value (may be na)
//@param fallback Fallback value if ATR is na or zero
export atr_safe(float atr_val, float fallback) =>
    float result = na(atr_val) or atr_val == 0 ? fallback : atr_val
    result + 0.0

//@function Calculates ATR as percentage of price
//@param atr_val ATR value
//@param price_val Price value
export atr_percent(float atr_val, float price_val) =>
    float result = price_val > 0 ? (atr_val / price_val) * 100 : 0.0
    result + 0.0

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 3: CANDLE ANALYSIS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Checks if candle is bullish (close > open)
//@param o Open price
//@param c Close price
export is_bullish(float o, float c) =>
    c > o ? true : false

//@function Checks if candle is bearish (close < open)
//@param o Open price
//@param c Close price
export is_bearish(float o, float c) =>
    c < o ? true : false

//@function Returns the body high (higher of open/close)
//@param o Open price
//@param c Close price
export body_high(float o, float c) =>
    math.max(o, c) + 0.0

//@function Returns the body low (lower of open/close)
//@param o Open price
//@param c Close price
export body_low(float o, float c) =>
    math.min(o, c) + 0.0

//@function Calculates candle body size (absolute)
//@param o Open price
//@param c Close price
export body_size(float o, float c) =>
    math.abs(c - o) + 0.0

//@function Calculates full candle range (high to low)
//@param h High price
//@param l Low price
export candle_range(float h, float l) =>
    (h - l) + 0.0

//@function Calculates upper wick size
//@param o Open price
//@param h High price
//@param c Close price
export upper_wick(float o, float h, float c) =>
    (h - math.max(o, c)) + 0.0

//@function Calculates lower wick size
//@param o Open price
//@param l Low price
//@param c Close price
export lower_wick(float o, float l, float c) =>
    (math.min(o, c) - l) + 0.0

//@function Checks if candle is a doji (small body relative to range)
//@param o Open price
//@param h High price
//@param l Low price
//@param c Close price
//@param threshold Body/range ratio threshold (default 0.1 = 10%)
export is_doji(float o, float h, float l, float c, float threshold) =>
    float body = math.abs(c - o)
    float range_v = h - l
    bool result = range_v > 0 ? (body / range_v) < threshold : false
    result

//@function Checks if candle has significant upper wick
//@param o Open price
//@param h High price
//@param c Close price
//@param min_ratio Minimum wick/body ratio
export has_upper_wick(float o, float h, float c, float min_ratio) =>
    float wick = h - math.max(o, c)
    float body = math.abs(c - o)
    bool result = body > 0 ? (wick / body) >= min_ratio : wick > 0
    result

//@function Checks if candle has significant lower wick
//@param o Open price
//@param l Low price
//@param c Close price
//@param min_ratio Minimum wick/body ratio
export has_lower_wick(float o, float l, float c, float min_ratio) =>
    float wick = math.min(o, c) - l
    float body = math.abs(c - o)
    bool result = body > 0 ? (wick / body) >= min_ratio : wick > 0
    result

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 4: GRADING SYSTEM
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Converts a 0-100 score to letter grade (13-tier: A+ to F)
//@param score Numeric score 0-100
export score_to_grade(int score) =>
    string g = "F"
    if score >= 90
        g := "A+"
    else if score >= 85
        g := "A"
    else if score >= 80
        g := "A-"
    else if score >= 75
        g := "B+"
    else if score >= 70
        g := "B"
    else if score >= 65
        g := "B-"
    else if score >= 60
        g := "C+"
    else if score >= 55
        g := "C"
    else if score >= 50
        g := "C-"
    else if score >= 45
        g := "D+"
    else if score >= 40
        g := "D"
    g

//@function Converts a 0-100 score to simplified letter grade (9-tier: A+ to D)
//@param score Numeric score 0-100
export score_to_grade_simple(float score) =>
    string g = "D"
    if score >= 90
        g := "A+"
    else if score >= 80
        g := "A"
    else if score >= 70
        g := "A-"
    else if score >= 60
        g := "B+"
    else if score >= 50
        g := "B"
    else if score >= 40
        g := "B-"
    else if score >= 30
        g := "C+"
    else if score >= 20
        g := "C"
    g

//@function Returns color for a letter grade
//@param grade Letter grade string
export grade_to_color(string grade) =>
    color result = #EF5350
    if grade == "A+" or grade == "A" or grade == "A-" or grade == "B+"
        result := #26A69A
    else if grade == "B" or grade == "B-" or grade == "C+" or grade == "C"
        result := #FFB300
    result

//@function Returns color for a numeric score
//@param score Numeric score 0-100
export score_to_color(float score) =>
    color result = #EF5350
    if score >= 80
        result := #26A69A
    else if score >= 60
        result := #66BB6A
    else if score >= 40
        result := #FFB300
    else if score >= 20
        result := #FF7043
    result

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 5: VISUAL HELPERS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Converts text size string to size constant code
//@param size_str Size string ("Tiny", "Small", "Normal", "Large")
//@returns Integer code: 0=tiny, 1=small, 2=normal, 3=large
export text_size_code(string size_str) =>
    int result = 1
    if size_str == "Tiny"
        result := 0
    else if size_str == "Normal"
        result := 2
    else if size_str == "Large"
        result := 3
    result

//@function Converts table position string to position code
//@param pos_str Position string ("Top Right", "Top Left", etc.)
//@returns Integer code: 0-8
export table_position_code(string pos_str) =>
    int result = 0
    if pos_str == "Top Left"
        result := 1
    else if pos_str == "Bottom Right"
        result := 2
    else if pos_str == "Bottom Left"
        result := 3
    else if pos_str == "Top Center"
        result := 4
    else if pos_str == "Bottom Center"
        result := 5
    else if pos_str == "Middle Right"
        result := 6
    else if pos_str == "Middle Left"
        result := 7
    else if pos_str == "Middle Center"
        result := 8
    result

//@function Converts line style string to style code
//@param style_str Style string ("Solid", "Dashed", "Dotted")
//@returns Integer code: 0=solid, 1=dashed, 2=dotted
export line_style_code(string style_str) =>
    int result = 0
    if style_str == "Dashed"
        result := 1
    else if style_str == "Dotted"
        result := 2
    result

//@function Calculates opacity based on strength (stronger = more visible = lower opacity)
//@param strength Strength value 0-100
export opacity_for_strength(float strength) =>
    int result = math.round(85 - (strength * 0.7))
    result + 0

//@function Calculates opacity based on age (older = more faded)
//@param age_bars Age in bars
//@param max_age Maximum age for scaling
export opacity_for_age(int age_bars, int max_age) =>
    float age_pct = max_age > 0 ? math.min(1.0, float(age_bars) / float(max_age)) : 0.0
    int result = math.round(20 + (age_pct * 65))
    result + 0

//@function Builds a progress bar string from percentage (loop-based, any width up to 20)
//@param pct Percentage 0-100
//@param total_chars Total characters in bar (1-20)
export make_progress_bar(float pct, int total_chars) =>
    int tc = math.max(1, math.min(total_chars, 20))
    int filled = math.round(pct / 100 * tc)
    int f = math.max(0, math.min(tc, filled))
    string bar = ""
    for i = 0 to tc - 1
        bar := bar + (i < f ? "█" : "░")
    bar

//@function Formats volume with K/M suffix
//@param vol Volume value
export format_volume(float vol) =>
    string result = ""
    if vol >= 1000000
        result := str.tostring(math.round(vol / 1000000, 2)) + "M"
    else if vol >= 1000
        result := str.tostring(math.round(vol / 1000, 2)) + "K"
    else
        result := str.tostring(math.round(vol, 1))
    result

//@function Formats percentage value
//@param val Value to format
export format_pct(float val) =>
    str.tostring(math.round(val)) + "%"

//@function Formats price with specified decimal precision
//@param price_val Price value
//@param decimals Number of decimal places
export format_price(float price_val, int decimals) =>
    str.tostring(math.round(price_val, decimals) + 0.0)

//@function Formats timeframe string for display
//@param tf Timeframe string
export format_tf(string tf) =>
    string result = tf == "1" ? "1m" : tf == "3" ? "3m" : tf == "5" ? "5m" : tf == "10" ? "10m" : tf == "15" ? "15m" : tf == "30" ? "30m" : tf == "45" ? "45m" : tf == "60" ? "1H" : tf == "120" ? "2H" : tf == "180" ? "3H" : tf == "240" ? "4H" : tf == "360" ? "6H" : tf == "480" ? "8H" : tf == "720" ? "12H" : tf == "D" ? "1D" : tf == "W" ? "1W" : tf == "M" ? "1M" : tf
    result

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 6: DIRECTION & TREND HELPERS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Returns color for direction
//@param direction Direction value (1=bull, -1=bear, 0=neutral)
export direction_color(int direction) =>
    color result = #FFB300
    if direction > 0
        result := #26A69A
    else if direction < 0
        result := #EF5350
    result

//@function Returns arrow string for direction
//@param direction Direction value (1=bull, -1=bear, 0=neutral)
export direction_arrow(int direction) =>
    string result = "►"
    if direction > 0
        result := "▲"
    else if direction < 0
        result := "▼"
    result

//@function Determines trend direction from two MAs
//@param fast_ma Fast moving average value
//@param slow_ma Slow moving average value
export trend_direction(float fast_ma, float slow_ma) =>
    int dir = fast_ma > slow_ma ? 1 : fast_ma < slow_ma ? -1 : 0
    dir + 0

//@function Calculates trend strength based on MA distance
//@param price Current price
//@param ma Moving average value
//@param atr ATR value for normalization
export trend_strength(float price, float ma, float atr) =>
    float atr_safe_val = atr > 0 ? atr : price * 0.01
    float distance = math.abs(price - ma)
    float strength = math.min(100.0, (distance / atr_safe_val) * 25)
    strength + 0.0

//@function Checks MA alignment (stacked EMAs)
//@param ma1 Fastest MA
//@param ma2 Middle MA
//@param ma3 Slowest MA
//@returns [is_aligned (1/0), direction (1/-1/0)]
export ma_alignment(float ma1, float ma2, float ma3) =>
    bool bullish = ma1 > ma2 and ma2 > ma3 ? true : false
    bool bearish = ma1 < ma2 and ma2 < ma3 ? true : false
    int aligned = bullish or bearish ? 1 : 0
    int dir = bullish ? 1 : bearish ? -1 : 0
    [aligned, dir]

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 7: SESSION INTELLIGENCE
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Determines current trading session from UTC hour
//@param hour_utc Current hour in UTC
export session_name(int hour_utc) =>
    string session = "ASIAN"
    if hour_utc >= 7 and hour_utc < 8
        session := "LONDON_OPEN"
    else if hour_utc >= 8 and hour_utc < 12
        session := "LONDON"
    else if hour_utc >= 12 and hour_utc < 13
        session := "OVERLAP"
    else if hour_utc >= 13 and hour_utc < 15
        session := "NY_OPEN"
    else if hour_utc >= 15 and hour_utc < 21
        session := "NEW_YORK"
    session

//@function Returns session quality bonus points
//@param hour_utc Current hour in UTC
//@returns Bonus points 0-10
export session_bonus(int hour_utc) =>
    float bonus = 0.0
    if hour_utc >= 7 and hour_utc < 9
        bonus := 10.0
    else if hour_utc >= 13 and hour_utc < 15
        bonus := 8.0
    else if hour_utc >= 9 and hour_utc < 12
        bonus := 5.0
    else if hour_utc >= 15 and hour_utc < 17
        bonus := 4.0
    else if hour_utc >= 12 and hour_utc < 13
        bonus := 7.0
    bonus + 0.0

//@function Returns session weight multiplier for institutional bias
//@param hour_utc Current hour in UTC
export session_weight(int hour_utc) =>
    float weight = 1.0
    if hour_utc >= 7 and hour_utc < 17
        weight := 1.2
    else if hour_utc >= 0 and hour_utc < 7
        weight := 0.8
    weight + 0.0

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 8: ZONE & LEVEL HELPERS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Checks if price is within a zone
//@param price Current price
//@param zone_top Zone upper boundary
//@param zone_bottom Zone lower boundary
export is_in_zone(float price, float zone_top, float zone_bottom) =>
    bool result = price <= zone_top and price >= zone_bottom ? true : false
    result

//@function Calculates position within a zone as percentage
//@param price Current price
//@param zone_top Zone upper boundary
//@param zone_bottom Zone lower boundary
export zone_position(float price, float zone_top, float zone_bottom) =>
    float range_v = zone_top - zone_bottom
    float pct = range_v > 0 ? ((price - zone_bottom) / range_v) * 100 : 50.0
    math.max(0.0, math.min(100.0, pct)) + 0.0

//@function Calculates distance to a price level
//@param price Current price
//@param level Target level
export distance_to_level(float price, float level) =>
    (level - price) + 0.0

//@function Calculates distance to level as percentage of price
//@param price Current price
//@param level Target level
export distance_to_level_pct(float price, float level) =>
    float pct = price > 0 ? ((level - price) / price) * 100 : 0.0
    pct + 0.0

//@function Calculates distance in ATR multiples
//@param price Current price
//@param level Target level
//@param atr ATR value
export distance_in_atr(float price, float level, float atr) =>
    float dist = math.abs(level - price)
    float result = atr > 0 ? dist / atr : 0.0
    result + 0.0

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 9: DIVERGENCE DETECTION HELPERS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Checks for regular bullish divergence (price LL, osc HL)
//@param price_low1 Earlier price low
//@param price_low2 Later price low
//@param osc_low1 Earlier oscillator low
//@param osc_low2 Later oscillator low
export is_reg_bull_div(float price_low1, float price_low2, float osc_low1, float osc_low2) =>
    bool result = price_low2 < price_low1 and osc_low2 > osc_low1 ? true : false
    result

//@function Checks for regular bearish divergence (price HH, osc LH)
//@param price_high1 Earlier price high
//@param price_high2 Later price high
//@param osc_high1 Earlier oscillator high
//@param osc_high2 Later oscillator high
export is_reg_bear_div(float price_high1, float price_high2, float osc_high1, float osc_high2) =>
    bool result = price_high2 > price_high1 and osc_high2 < osc_high1 ? true : false
    result

//@function Checks for hidden bullish divergence (price HL, osc LL)
//@param price_low1 Earlier price low
//@param price_low2 Later price low
//@param osc_low1 Earlier oscillator low
//@param osc_low2 Later oscillator low
export is_hid_bull_div(float price_low1, float price_low2, float osc_low1, float osc_low2) =>
    bool result = price_low2 > price_low1 and osc_low2 < osc_low1 ? true : false
    result

//@function Checks for hidden bearish divergence (price LH, osc HH)
//@param price_high1 Earlier price high
//@param price_high2 Later price high
//@param osc_high1 Earlier oscillator high
//@param osc_high2 Later oscillator high
export is_hid_bear_div(float price_high1, float price_high2, float osc_high1, float osc_high2) =>
    bool result = price_high2 < price_high1 and osc_high2 > osc_high1 ? true : false
    result

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 10: VOLATILITY & REGIME HELPERS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Determines volatility state from ATR ratio
//@param atr_fast Fast ATR
//@param atr_slow Slow ATR
//@param expand_threshold Threshold for expanded (default 1.5)
//@param compress_threshold Threshold for compressed (default 0.7)
//@returns State code: 0=compressed, 1=normal, 2=expanded
export volatility_state(float atr_fast, float atr_slow, float expand_threshold, float compress_threshold) =>
    float ratio = atr_slow > 0 ? atr_fast / atr_slow : 1.0
    int state = ratio > expand_threshold ? 2 : ratio < compress_threshold ? 0 : 1
    state + 0

//@function Determines volatility state as string
//@param atr_fast Fast ATR
//@param atr_slow Slow ATR
export volatility_state_str(float atr_fast, float atr_slow) =>
    float ratio = atr_slow > 0 ? atr_fast / atr_slow : 1.0
    string state = ratio > 1.5 ? "EXPANDED" : ratio < 0.7 ? "COMPRESSED" : "NORMAL"
    state

//@function Simple regime detection from ADX and ATR ratio
//@param adx_val ADX value
//@param atr_ratio ATR fast/slow ratio
export simple_regime(float adx_val, float atr_ratio) =>
    string regime = "RANGING"
    if adx_val > 30
        regime := "TREND_STRONG"
    else if adx_val > 20
        regime := "TREND_WEAK"
    else if atr_ratio > 1.5
        regime := "VOLATILE"
    else if atr_ratio < 0.7
        regime := "QUIET"
    regime

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 11: QUALITY & CONFIDENCE HELPERS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Calculates weighted average quality score from 4 components
//@param score1 First component score
//@param weight1 First component weight
//@param score2 Second component score
//@param weight2 Second component weight
//@param score3 Third component score
//@param weight3 Third component weight
//@param score4 Fourth component score
//@param weight4 Fourth component weight
export weighted_quality(float score1, float weight1, float score2, float weight2, float score3, float weight3, float score4, float weight4) =>
    float total_weight = weight1 + weight2 + weight3 + weight4
    float weighted_sum = (score1 * weight1) + (score2 * weight2) + (score3 * weight3) + (score4 * weight4)
    float result = total_weight > 0 ? weighted_sum / total_weight : 0.0
    math.max(0.0, math.min(100.0, result)) + 0.0

//@function Calculates confluence score from 5 boolean factors
//@param factor1 First factor (1=true, 0=false)
//@param factor2 Second factor
//@param factor3 Third factor
//@param factor4 Fourth factor
//@param factor5 Fifth factor
export confluence_score(int factor1, int factor2, int factor3, int factor4, int factor5) =>
    int count = (factor1 > 0 ? 1 : 0) + (factor2 > 0 ? 1 : 0) + (factor3 > 0 ? 1 : 0) + (factor4 > 0 ? 1 : 0) + (factor5 > 0 ? 1 : 0)
    float result = float(count) / 5.0 * 100
    result + 0.0

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 12: STRUCTURE DETECTION HELPERS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Classifies swing type based on comparison with previous swing
//@param current_val Current swing value
//@param prev_val Previous swing value
//@param is_high 1 if this is a high swing, 0 for low
//@returns Swing type code: 1=HH, 2=LH, 3=HL, 4=LL
export classify_swing(float current_val, float prev_val, int is_high) =>
    int result = 0
    if is_high > 0
        result := current_val > prev_val ? 1 : 2
    else
        result := current_val > prev_val ? 3 : 4
    result + 0

//@function Checks for Break of Structure (BOS)
//@param current_price Current price
//@param swing_level Swing level to break
//@param is_bullish_break 1 if checking for bullish break
export is_bos(float current_price, float swing_level, int is_bullish_break) =>
    bool result = is_bullish_break > 0 ? current_price > swing_level : current_price < swing_level
    result

//@function Checks for Change of Character (CHoCH)
//@param current_price Current price
//@param swing_level Swing level to break
//@param current_trend Current trend direction (1=bull, -1=bear)
export is_choch(float current_price, float swing_level, int current_trend) =>
    bool bull_choch = current_trend < 0 and current_price > swing_level ? true : false
    bool bear_choch = current_trend > 0 and current_price < swing_level ? true : false
    bool result = bull_choch or bear_choch ? true : false
    result

// ══════════════════════════════════════════════════════════════════════════════════════════════
// ██████████████████████████████████████████████████████████████████████████████████████████████
// PHANTOM PRO SCORING INTELLIGENCE — Extracted for compiled size reduction
// ██████████████████████████████████████████████████████████████████████████████████████████████
// ══════════════════════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 13: BREAK STRENGTH SCORING
// ══════════════════════════════════════════════════════════════════════════════════════════════
// 4-factor system: Volume (0-30) + Momentum (0-30) + Wick (0-20) + Displacement (0-20) = 0-100

//@function Break strength: Volume factor (0-30). Higher volume = stronger break.
//@param vol Break candle volume
//@param avg_vol Average volume baseline
export brk_vol(float vol, float avg_vol) =>
    float ratio = avg_vol > 0 ? vol / avg_vol : 1.0
    int result = math.round(math.max(0.0, math.min(30.0, ratio / 2.5 * 30.0)))
    result + 0

//@function Break strength: Momentum / body size factor (0-30). Larger body = stronger break.
//@param body Break candle body size
//@param atr ATR value for normalization
export brk_mom(float body, float atr) =>
    float ratio = atr > 0 ? body / atr : 0.5
    int result = math.round(math.max(0.0, math.min(30.0, ratio / 1.5 * 30.0)))
    result + 0

//@function Break strength: Wick rejection factor (0-20). Less rejection wick = cleaner break.
//@param is_bull True if bullish break
//@param upper_w Upper wick size
//@param lower_w Lower wick size
//@param body Body size
export brk_wick(bool is_bull, float upper_w, float lower_w, float body) =>
    float rej = is_bull ? upper_w : lower_w
    float ratio = body > 0 ? rej / body : 1.0
    int result = math.round(math.max(0.0, math.min(20.0, (1.0 - math.max(0.0, math.min(2.0, ratio)) / 2.0) * 20.0)))
    result + 0

//@function Break strength: Displacement beyond level (0-20). Further past level = stronger.
//@param close_price Closing price of break candle
//@param level Broken structure level
//@param is_bull True if bullish break
//@param atr ATR value for normalization
export brk_disp(float close_price, float level, bool is_bull, float atr) =>
    float dist = is_bull ? close_price - level : level - close_price
    float ratio = atr > 0 ? math.max(dist, 0.0) / atr : 0.0
    int result = math.round(math.max(0.0, math.min(20.0, ratio * 20.0)))
    result + 0

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 14: ZONE INTELLIGENCE (OB Grading, Lifecycle, Priority)
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function OB grade letter from PHANTOM 5-tier thresholds (90/75/60/40)
//@param score Display grade 0-100
export ob_grade_letter(int score) =>
    string result = score >= 90 ? "A+" : score >= 75 ? "A" : score >= 60 ? "B" : score >= 40 ? "C" : "D"
    result

//@function OB grade to fill transparency (tight range: 60-72, all clearly visible)
//@param score Display grade 0-100
export ob_grade_transp(int score) =>
    int result = score >= 90 ? 60 : score >= 75 ? 63 : score >= 60 ? 66 : score >= 40 ? 69 : 72
    result + 0

//@function OB grade word for tooltip display
//@param score Display grade 0-100
export ob_grade_word(int score) =>
    string result = score >= 90 ? "Excellent" : score >= 75 ? "Strong" : score >= 60 ? "Good" : score >= 40 ? "Moderate" : "Weak"
    result

//@function Calculates base OB grade at creation (0-100)
//@param eye_count Number of confirmed eyes (1-3)
//@param impulse_atr Impulse candle body / ATR ratio
//@param is_choch True if post-CHoCH break
//@param is_choch_plus True if post-CHoCH+ break
//@param session_pts Session context points (0-15)
export ob_grade_base(int eye_count, float impulse_atr, bool is_choch, bool is_choch_plus, float session_pts) =>
    float f1 = eye_count >= 3 ? 30.0 : eye_count == 2 ? 22.0 : 15.0
    float f2 = math.max(5.0, math.min(25.0, impulse_atr / 2.0 * 25.0))
    float f3 = session_pts + 0.0
    float f4 = 15.0
    float f5 = is_choch_plus ? 15.0 : is_choch ? 12.0 : 6.0
    int result = math.round(math.max(0.0, math.min(100.0, f1 + f2 + f3 + f4 + f5)))
    result + 0

//@function Calculates age decay penalty (returns negative value to subtract from grade)
//@param bars_alive Bars since OB creation
//@param halflife Half-life in bars (freshness decays by 50% per halflife)
export ob_age_decay(int bars_alive, int halflife) =>
    float decay_factor = math.pow(0.5, bars_alive * 1.0 / math.max(halflife, 1))
    float freshness_loss = 15.0 * (1.0 - decay_factor)
    float result = -freshness_loss
    result + 0.0

//@function Calculates deterministic priority score for zone ranking
//@param d_grade Display grade 0-100
//@param dist_atr Distance from price in ATR multiples
//@param fresh_pct Freshness percentage 0-100
//@param in_ckz True if zone is in CKZ
//@param reacting True if zone is currently reacting
export ob_priority(float d_grade, float dist_atr, float fresh_pct, bool in_ckz, bool reacting) =>
    float prox = math.max(0.0, math.min(100.0, 100.0 - dist_atr * 10.0))
    float conf_bonus = (in_ckz ? 10.0 : 0.0) + (reacting ? 5.0 : 0.0)
    float result = d_grade * 0.35 + prox * 0.30 + fresh_pct * 0.20 + conf_bonus
    result + 0.0

//@function Calculates trap boost value (5-15) for zones that trapped price
//@param eye_n Number of eyes on original OB
//@param vr_now Current volume ratio (volume / avg_volume)
//@param sess_pts Session points at trap time
//@param orig_grade Original grade before trap
export ob_trap_boost(int eye_n, float vr_now, float sess_pts, float orig_grade) =>
    float eye_f = eye_n >= 3 ? 15.0 : eye_n == 2 ? 12.0 : 8.0
    float vol_f = vr_now > 2.0 ? 15.0 : vr_now > 1.5 ? 10.0 : vr_now > 1.0 ? 5.0 : 0.0
    float brk_f = orig_grade < 50 ? 10.0 : orig_grade < 70 ? 5.0 : 0.0
    float sess_f = sess_pts > 12.0 ? 10.0 : sess_pts > 8.0 ? 5.0 : 0.0
    float raw = (eye_f + vol_f + brk_f + sess_f) / 50.0 * 15.0
    int result = math.round(math.max(5.0, math.min(15.0, raw)))
    result + 0

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 15: FVG INTELLIGENCE
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function FVG grade letter from 8-tier score mapping
//@param score FVG DNA score 0-100
export fvg_grade(float score) =>
    string result = score >= 90 ? "A+" : score >= 80 ? "A" : score >= 70 ? "B+" : score >= 60 ? "B" : score >= 50 ? "C+" : score >= 40 ? "C" : score >= 30 ? "D+" : "D"
    result

//@function 5-Factor FVG Fill Probability Model (returns 10-95)
//@param fvg_top FVG upper boundary
//@param fvg_bottom FVG lower boundary
//@param fvg_size FVG gap size (top - bottom)
//@param fill_pct Current fill percentage 0-100
//@param atr ATR value
//@param is_bullish True if bullish FVG
//@param price Current close price
//@param trend_dir Primary trend direction (1=bull, -1=bear)
//@param age Bars since FVG creation
export fvg_fill_prob(float fvg_top, float fvg_bottom, float fvg_size, float fill_pct, float atr, bool is_bullish, float price, int trend_dir, int age) =>
    float size_ratio = atr > 0 ? fvg_size / atr : 1.0
    float size_score = size_ratio < 0.4 ? 90.0 : size_ratio < 0.7 ? 80.0 : size_ratio < 1.0 ? 70.0 : size_ratio < 1.5 ? 55.0 : size_ratio < 2.5 ? 40.0 : 25.0
    float age_score = age < 3 ? 60.0 : age < 20 ? 80.0 : age < 50 ? 70.0 : age < 150 ? 50.0 : math.max(10.0, 30.0 - age * 0.05)
    float remaining_edge = is_bullish ? fvg_top - (fvg_size * fill_pct / 100) : fvg_bottom + (fvg_size * fill_pct / 100)
    float distance = is_bullish ? price - remaining_edge : remaining_edge - price
    float dist_atr = atr > 0 ? distance / atr : 0.0
    float dist_score = dist_atr < 0 ? 90.0 : dist_atr < 0.5 ? 85.0 : dist_atr < 1.0 ? 75.0 : dist_atr < 2.0 ? 60.0 : dist_atr < 4.0 ? 40.0 : 20.0
    bool trend_bull = trend_dir > 0 ? true : false
    float trend_score = (is_bullish and not trend_bull) or (not is_bullish and trend_bull) ? 75.0 : 45.0
    float momentum_score = fill_pct > 0 ? math.min(90.0, 50.0 + fill_pct * 0.4) : 50.0
    float composite = size_score * 0.30 + age_score * 0.20 + dist_score * 0.25 + trend_score * 0.15 + momentum_score * 0.10
    float result = math.max(10.0, math.min(95.0, composite))
    result + 0.0

//@function Dynamic ETA: Estimated bars until FVG fill
//@param remaining_distance Price distance to remaining unfilled portion
//@param atr ATR value
//@param trend_dir Primary trend direction (1=bull, -1=bear)
//@param is_bullish True if bullish FVG
//@param fill_pct Current fill percentage
export fvg_eta(float remaining_distance, float atr, int trend_dir, bool is_bullish, float fill_pct) =>
    float base_bars = atr > 0 ? remaining_distance / atr : 10.0
    bool trend_bull = trend_dir > 0 ? true : false
    float trend_mult = (is_bullish and not trend_bull) or (not is_bullish and trend_bull) ? 0.7 : 1.5
    float fill_mult = fill_pct > 50 ? 0.8 : fill_pct > 25 ? 0.9 : 1.0
    int result = math.max(1, math.min(math.round(base_bars * trend_mult * fill_mult), 999))
    result + 0

//@function FVG DNA Score combining size, freshness, probability, and status (0-100)
//@param fvg_size FVG gap size
//@param atr ATR value
//@param fill_prob Fill probability (10-95)
//@param age Bars since creation
//@param status Status string ("Open", "Partial", etc.)
export fvg_dna(float fvg_size, float atr, float fill_prob, int age, string status) =>
    float size_ratio = atr > 0 ? fvg_size / atr : 1.0
    float size_q = size_ratio < 0.5 ? 30.0 : size_ratio < 1.0 ? 25.0 : size_ratio < 2.0 ? 15.0 : 5.0
    float fresh_q = age < 10 ? 20.0 : age < 50 ? 15.0 : age < 150 ? 8.0 : 3.0
    float prob_q = fill_prob * 0.35
    float status_q = status == "Open" ? 10.0 : status == "Partial" ? 5.0 : 0.0
    float result = math.min(100.0, size_q + fresh_q + prob_q + status_q)
    result + 0.0

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 16: LIQUIDITY INTELLIGENCE
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Liquidity grade letter from 8-tier score mapping
//@param score Liquidity DNA score 0-100
export liq_grade(float score) =>
    string result = score >= 90 ? "A+" : score >= 80 ? "A" : score >= 70 ? "B+" : score >= 60 ? "B" : score >= 50 ? "C+" : score >= 40 ? "C" : score >= 30 ? "D+" : "D"
    result

//@function 4-Factor Liquidity Sweep Probability Model (10-95)
//@param dist_from_price Absolute distance from current price to level
//@param atr ATR value
//@param is_buyside True if buyside liquidity (above price)
//@param touches Number of times level has been touched
//@param trend_dir Primary trend direction (1=bull, -1=bear)
//@param age Bars since level formation
export liq_sweep_prob(float dist_from_price, float atr, bool is_buyside, int touches, int trend_dir, int age) =>
    float touch_score = touches >= 4 ? 90.0 : touches == 3 ? 80.0 : touches == 2 ? 65.0 : 45.0
    float dist_atr = atr > 0 ? dist_from_price / atr : 5.0
    float dist_score = dist_atr < 0.5 ? 85.0 : dist_atr < 1.0 ? 75.0 : dist_atr < 2.0 ? 60.0 : dist_atr < 4.0 ? 40.0 : 20.0
    float age_score = age < 10 ? 50.0 : age < 50 ? 80.0 : age < 150 ? 70.0 : age < 300 ? 50.0 : 30.0
    bool trend_bull = trend_dir > 0 ? true : false
    float trend_score = (is_buyside and trend_bull) or (not is_buyside and not trend_bull) ? 75.0 : 35.0
    float prob = touch_score * 0.30 + dist_score * 0.30 + age_score * 0.20 + trend_score * 0.20
    float result = math.max(10.0, math.min(95.0, prob))
    result + 0.0

//@function Magnet Strength: How powerfully a liquidity level attracts price (10-95)
//@param touches Number of times level has been touched
//@param sweep_prob Sweep probability from liq_sweep_prob
export liq_magnet(int touches, float sweep_prob) =>
    float base = touches >= 4 ? 85.0 : touches == 3 ? 70.0 : touches == 2 ? 55.0 : 35.0
    float magnet = base * 0.6 + sweep_prob * 0.4
    float result = math.max(10.0, math.min(95.0, magnet))
    result + 0.0

//@function Liquidity DNA Score combining probability, touch count, and equal H/L bonus (0-100)
//@param sweep_prob Sweep probability
//@param touches Touch count
//@param is_equal True if equal highs/lows level
export liq_dna(float sweep_prob, int touches, bool is_equal) =>
    float prob_q = sweep_prob * 0.35
    float touch_q = math.min(touches / 5.0, 1.0) * 25.0
    float eq_bonus = is_equal ? 12.0 : 0.0
    float result = math.min(100.0, prob_q + touch_q + eq_bonus + 10.0)
    result + 0.0

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 17: HL STRENGTH SCORING (Strong/Weak Swing Classification)
// ══════════════════════════════════════════════════════════════════════════════════════════════
// 4 factors: Volume (0-30) + Momentum (0-30) + Structure (0-20) + Follow-through (0-20)

//@function Composite HL strength score for swing classification
//@param piv_price Pivot price
//@param is_high True if swing high, false if swing low
//@param v0 Volume at swing bar
//@param v1 Volume at swing bar + 1
//@param v2 Volume at swing bar + 2
//@param b0 Body size at swing bar
//@param b1 Body size at swing bar + 1
//@param b2 Body size at swing bar + 2
//@param avg_vol Average volume baseline
//@param atr ATR value
//@param is_aligned True if swing is trend-aligned
//@param bars_since_bos Bars since last BOS
//@param bars_since_choch Bars since last CHoCH
//@param threshold Score threshold for Strong classification
//@param ft_h Follow-through high (ta.highest over lookback)
//@param ft_l Follow-through low (ta.lowest over lookback)
//@returns [composite, vol_score, mom_score, struct_score, follow_score, grade_string]
export hl_strength(float piv_price, bool is_high, float v0, float v1, float v2, float b0, float b1, float b2, float avg_vol, float atr, bool is_aligned, int bars_since_bos, int bars_since_choch, int threshold, float ft_h, float ft_l) =>
    float vavg = (v0 + v1 + v2) / 3.0
    float avg_v = avg_vol > 0 ? avg_vol : 1.0
    float vol_r = avg_v > 0 ? vavg / avg_v : 1.0
    int v = vavg < 1.0 ? 15 : vol_r >= 2.0 ? 30 : vol_r >= 1.5 ? 25 : vol_r >= 1.0 ? 18 : vol_r >= 0.7 ? 10 : 3
    float bsum = b0 + b1 + b2
    float dr = atr > 0 ? bsum / (3.0 * atr) : 0.5
    int m = dr >= 1.5 ? 30 : dr >= 1.0 ? 23 : dr >= 0.6 ? 15 : dr >= 0.3 ? 8 : 2
    int s = is_aligned ? (bars_since_bos <= 10 ? 20 : 14) : (bars_since_choch <= 10 ? 15 : 5)
    float fd = is_high ? piv_price - ft_l : ft_h - piv_price
    float fr = atr > 0 ? fd / atr : 0.5
    int f = fr >= 1.5 ? 20 : fr >= 1.0 ? 15 : fr >= 0.5 ? 8 : 2
    int c = v + m + s + f
    string g = c >= threshold ? "Strong" : "Weak"
    [c, v, m, s, f, g]

//@function Builds swing label text with optional HL strength suffix
//@param swing_type Swing type string ("HH", "HL", "LH", "LL")
//@param grade Grade string ("Strong" or "Weak")
//@param show True to append strength suffix
export hl_label(string swing_type, string grade, bool show) =>
    string result = show ? swing_type + "·" + str.substring(grade, 0, 1) : swing_type
    result

//@function Builds swing tooltip with HL strength breakdown
//@param swing_type Swing type string
//@param grade Grade string
//@param comp Composite score
//@param vs Volume score
//@param ms Momentum score
//@param ss Structure score
//@param fs Follow-through score
//@param show True to show tooltip
export hl_tooltip(string swing_type, string grade, int comp, int vs, int ms, int ss, int fs, bool show) =>
    string result = show ? swing_type + " (" + grade + " " + str.tostring(comp) + "/100)\nVol: " + str.tostring(vs) + " | Mom: " + str.tostring(ms) + " | Struct: " + str.tostring(ss) + " | Follow: " + str.tostring(fs) : ""
    result

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 18: BIAS ENGINE
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Calculates institutional bias score with session-weighted components (-100 to +100)
//@param struct_sc Structure score (-100 to +100)
//@param ob_bal OB balance score (-100 to +100)
//@param fvg_imb FVG imbalance score (-100 to +100)
//@param liq_mag Liquidity magnet score (-100 to +100)
//@param val_sc Value position score (-100 to +100)
//@param sw_mom Swing momentum score (-100 to +100)
//@param session_hour Current UTC hour (0-23) for session weighting
export calc_bias(float struct_sc, float ob_bal, float fvg_imb, float liq_mag, float val_sc, float sw_mom, int session_hour) =>
    float ws = 0.25
    float wo = 0.25
    float wf = 0.15
    float wl = 0.15
    float wv = 0.10
    float ww = 0.10
    float sm = session_hour >= 7 and session_hour < 16 ? 1.2 : 0.8
    wo := wo * sm
    wf := wf * sm
    float wt = ws + wo + wf + wl + wv + ww
    ws := ws / wt
    wo := wo / wt
    wf := wf / wt
    wl := wl / wt
    wv := wv / wt
    ww := ww / wt
    float ib = struct_sc * ws + ob_bal * wo + fvg_imb * wf + liq_mag * wl + val_sc * wv + sw_mom * ww
    int result = math.round(math.max(-100.0, math.min(100.0, ib)))
    result + 0

// ══════════════════════════════════════════════════════════════════════════════════════════════
// SECTION 19: SMC FORMATTING HELPERS
// ══════════════════════════════════════════════════════════════════════════════════════════════

//@function Smart price formatting (auto-detects precision from magnitude)
//@param price Price value
export fmt_price_smart(float price) =>
    string result = ""
    if price >= 10000
        result := str.tostring(math.round(price))
    else if price >= 100
        result := str.tostring(math.round(price * 10) / 10)
    else
        result := str.tostring(math.round(price * 100) / 100)
    result

//@function Formats score as "X/100" string
//@param score Score value 0-100
export fmt_score(int score) =>
    str.tostring(score) + "/100"

//@function Builds a simple bar label from score and direction
//@param score Score value 0-100
//@param is_bull True for bullish context
export fmt_bias_label(int score, bool is_bull) =>
    string dir = is_bull ? "▲ BULL" : score == 0 ? "► NEUTRAL" : "▼ BEAR"
    string result = dir + " " + str.tostring(math.abs(score))
    result

