//@version=6
strategy("Beginner Trend & Risk Model (EMA + RSI)", 
     overlay = true, 
     initial_capital = 10000, 
     pyramiding = 0, 
     commission_type = strategy.commission.percent, 
     commission_value = 0.05,
     calc_on_every_tick = true)

// ───────── Inputs ─────────
fastLen   = input.int(9,  "Fast EMA", minval = 1)
slowLen   = input.int(21, "Slow EMA", minval = 1)
rsiLen    = input.int(14, "RSI Length", minval = 2)
rsiOB     = input.int(70, "RSI Overbought", minval = 50, maxval = 100)
rsiOS     = input.int(30, "RSI Oversold",  minval = 0,  maxval = 50)
atrLen    = input.int(14, "ATR Length", minval = 1)
riskRR    = input.float(2.0, "Risk/Reward (TP = RR x SL)", minval = 0.5, step = 0.5)
riskPct   = input.float(1.0, "Risk % per Trade", minval = 0.1, maxval = 5, step = 0.1)

// ───────── Core calcs ─────────
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)

// Trend filter
bullTrend = fastEMA > slowEMA

// Entry / exit conditions
longEntryCond  = ta.crossover(fastEMA, slowEMA) and bullTrend and rsi > rsiOS and rsi < rsiOB
longExitCond   = ta.crossunder(fastEMA, slowEMA) or rsi > rsiOB

// ───────── Position sizing (shares) ─────────
capital    = strategy.equity
riskAmount = capital * (riskPct / 100.0)

slDistance = atr
rawQty     = slDistance > 0 ? riskAmount / slDistance : 0.0
qty        = rawQty > 0 ? math.floor(rawQty) : 0

longSL = close - atr
longTP = close + atr * riskRR

// ───────── Strategy logic ─────────
if (longEntryCond and strategy.position_size <= 0 and qty > 0)
    strategy.entry("LONG", strategy.long, qty)
    strategy.exit("LONG EXIT", "LONG", stop = longSL, limit = longTP)

if (longExitCond and strategy.position_size > 0)
    strategy.close("LONG")

// ───────── Visuals ─────────
plot(fastEMA, color = color.new(color.green, 0), linewidth = 2, title = "Fast EMA")
plot(slowEMA, color = color.new(color.red,   0), linewidth = 2, title = "Slow EMA")

bgcolor(bullTrend ? color.new(color.green, 92) : color.new(color.red, 92))

plotshape(longEntryCond, 
     title = "BUY", 
     style = shape.labelup, 
     color = color.new(color.lime, 0), 
     text = "BUY", 
     location = location.belowbar, 
     size = size.small)

plotshape(longExitCond, 
     title = "SELL", 
     style = shape.labeldown, 
     color = color.new(color.red, 0), 
     text = "SELL", 
     location = location.abovebar, 
     size = size.small)

// ───────── Position size label (safe wording) ─────────
var label qtyLabel = na

if (longEntryCond and qty > 0)
    label.delete(qtyLabel)
    qtyText  = "Position size estimate: " + str.tostring(qty)
    qtyLabel := label.new(bar_index, low, qtyText,
        style = label.style_label_up,
        color = color.new(color.blue, 0),
        textcolor = color.white,
        size = size.small)

// ───────── Alerts ─────────
alertcondition(longEntryCond,  title = "BUY Signal",  message = "Possible BUY setup")
alertcondition(longExitCond,   title = "SELL Signal", message = "Possible SELL setup")
