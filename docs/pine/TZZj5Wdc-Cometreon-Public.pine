library("Cometreon_Public", true)

// ═════════════1═════════════   FUNCTION {
hma(source, lenght) => ta.wma(2 * ta.wma(source, lenght / 2) -ta.wma(source, lenght), math.round(math.sqrt(lenght)))
jma(phase, lenght, power, source) =>
    phaseRatio      =   phase < -100 ? 0.5 : phase > 100 ? 2.5 : phase / 100 + 1.5
    beta            =   0.45 * (lenght - 1) / (0.45 * (lenght - 1) + 2)
    alpha           =   math.pow(beta, power)
    jma             =   0.0
    e0              =   0.0
    e0              :=  (1 - alpha) * source + alpha * nz(e0[1])
    e1              =   0.0
    e1              :=  (source - e0) * (1 - beta) + beta * nz(e1[1])
    e2              =   0.0
    e2              :=  (e0 + phaseRatio * e1 - nz(jma[1])) * math.pow(1 - alpha, 2) + math.pow(alpha, 2) * nz(e2[1])
    jma             :=  e2 + nz(jma[1])
dema(source, lenght) => 2 * (ta.ema(source, lenght)) - (ta.ema(ta.ema(source, lenght), lenght))
tema(source, lenght) => 3 * ((ta.ema(source, lenght)) - (ta.ema(ta.ema(source, lenght), lenght))) + (ta.ema(ta.ema(ta.ema(source, lenght), lenght), lenght))
smma(source, lenght) =>
    smma1           =   0.0000
    smma11          =   ta.sma(source, lenght)
    smma1           :=  na(smma1[1]) ? smma11 : ((smma1[1] * (lenght - 1) + source) / lenght)
kama(source, lenght) =>
    xvnoise         =   math.abs(source - source[1])
    nAMA            =   0.0
    nfastend        =   0.666
    nslowend        =   0.0645
    nsignal         =   math.abs(source - source[lenght])
    nnoise          =   math.sum(xvnoise, lenght)
    nefratio        =   nnoise != 0? nsignal / nnoise: 0
    nsmooth         =   math.pow(nefratio * (nfastend - nslowend) + nslowend, 2) 
    nAMA            :=  nz(nAMA[1]) + nsmooth * (source - nz(nAMA[1]))
frama(source, length, FC, SC) =>
    HL              =   (ta.highest(high, length) - ta.lowest(low, length)) / length
    HL1             =   (ta.highest(high, length/2) - ta.lowest(low, length/2)) / (length/2)
    HL2             =   (ta.highest(high, length/2)[length/2] - ta.lowest(low, length/2)[length/2]) / (length/2)
    D               =   (math.log(HL1+HL2) - math.log(HL)) / math.log(2)
    dim             =   HL1>0 and HL2>0 and HL>0? D: nz(D[1])
    w               =   math.log(2/(SC+1))
    alpha           =   math.exp(w*(dim-1))
    alpha1          =   alpha>1 ? 1 : (alpha<0.01 ? 0.01 : alpha)
    oldN            =   (2-alpha1) / alpha1
    newN            =   (((SC-FC) * (oldN-1)) / (SC-1)) + FC
    newalpha        =   2/(newN+1)
    newalpha1       =   newalpha<2/(SC+1) ? 2/(SC+1) : (newalpha>1 ? 1 : newalpha)
    frama           =   0.0
    frama           :=  (1-newalpha1) * nz(frama[1]) + newalpha1*source
vidya(source, lenght, bool1, bool2) =>
    alpha           =   2/(lenght+1)
    momm            =   ta.change(source)
    m1              =   momm >= 0.0 ? momm : 0.0
    m2              =   momm >= 0.0 ? 0.0 : -momm
	sum1F			=	math.sum(m1, 9)
	sum1L			=	math.sum(m1, lenght)
	sum2F			=	math.sum(m1, 9)
	sum2L			=	math.sum(m1, lenght)
    sm1             =   bool1 ? sum1F : sum1L
    sm2             =   bool1 ? sum2F : sum2L
    chandeMO        =   nz(100 * (sm1 - sm2) / (sm1 + sm2))
	stdev			=	ta.stdev(source,lenght)
    k               =   bool2 ? math.abs(chandeMO)/100 : stdev
    VIDYA           =   0.0
    VIDYA           :=  nz(alpha*k*source)+(1-alpha*k)*nz(VIDYA[1])
//}

// ═════════════2═════════════   EXPORT {
// ══════════════════════════   Moving Average {
export multiMa(string typeMa, int lenght, float source, int phase, int power, float sigma, float offset, int fc, int sc, bool fixed, bool cmo) =>
	sma = ta.sma(source, lenght), ema = ta.ema(source, lenght), wma = ta.wma(source, lenght), rma = ta.rma(source, lenght), hma = hma(source, lenght), jma = jma(phase, lenght, power, source)
	dema = dema(source, lenght), tema = tema(source, lenght), lsma = ta.linreg(source, lenght, 0), vwma = ta.vwma(source, lenght), smma = smma(source, lenght), kama = kama(source, lenght)
	vidya = vidya(source, lenght, fixed, cmo), frama = frama(source, lenght, fc, sc), alma = ta.alma(source, lenght, offset, sigma)

	typeMa=="RMA"? rma: typeMa=="SMA"? sma: typeMa=="EMA"? ema: typeMa=="WMA"? wma: typeMa=="HMA"? hma: typeMa=="JMA"? jma: typeMa=="DEMA"? dema: typeMa=="TEMA"? tema: typeMa=="LSMA"? lsma: 
	   typeMa=="VWMA"? vwma: typeMa=="SMMA"? smma: typeMa=="KAMA"? kama: typeMa=="ALMA"? alma: typeMa=="FRAMA"? frama: vidya

//}
// ══════════════════════════   Rsi {
export rsi_Special(int lenght, int lenghtMa, float source, string typeRsi, string typeMa, bool super, bool dynamicRsi, int legnthDyn, int phase, int power, float sigma, float offset, int fcs, int scs, bool fixed, bool select) =>
	change = ta.change(source)
	up = multiMa(typeRsi, lenght, math.max(change, 0), phase, power, sigma, offset, fcs, scs, fixed, select)
	down = multiMa(typeRsi, lenght, -math.min(change, 0), phase, power, sigma, offset, fcs, scs, fixed, select)

	rsiNormal = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))
	rsiDefault = ta.rsi(source, lenght)
	rsiInput = super? rsiNormal: rsiDefault

	rsi = dynamicRsi? ((4 * rsiInput + 3 * rsiInput[1] + 2 * rsiInput[2] + rsiInput[3] ) / 10): rsiInput
    rsiMa = multiMa(typeMa, lenghtMa, rsi, phase, power, sigma, offset, fcs, scs, fixed, select)
	dUpper = ta.highest(rsiInput, legnthDyn)
	dLower = ta.lowest(rsiInput, legnthDyn)

	[rsi, rsiMa, dUpper, dLower]
//}
// ══════════════════════════   Macd {
export macd_Special(int fastLen, int slowLen, int signalLen, float source, string typeMacd, string typeSignal, bool dynamicMacd, int phase, int power, float sigma, float offset, int fcs, int scs, bool fixed, bool select) =>
    fastMacd            =   multiMa(typeMacd, fastLen, source, phase, power, sigma, offset, fcs, scs, fixed, select)
    slowMacd            =   multiMa(typeMacd, slowLen, source, phase, power, sigma, offset, fcs, scs, fixed, select)
    macdInput           =   fastMacd - slowMacd
    signalInput         =   multiMa(typeSignal, signalLen, macdInput, phase, power, sigma, offset, fcs, scs, fixed, select)

    macd                =   dynamicMacd? ((4 * macdInput + 3 * macdInput[1] + 2 * macdInput[2] + macdInput[3] ) / 10): macdInput
    signal              =   dynamicMacd? ((4 * signalInput + 3 * signalInput[1] + 2 * signalInput[2] + signalInput[3] ) / 10): signalInput
    hist                =   macd - signal

	[macd, signal, hist]
//}
// ══════════════════════════   Alligator {
export alligator_Special(int jawLength, int teethLength, int lipsLength, float source, string typeAllig, int phase, int power, float sigma, float offset, int fcs, int scs, bool fixed, bool select) =>
	jaw                 =   multiMa(typeAllig, jawLength, source, phase, power, sigma, offset, fcs, scs, fixed, select)
	teeth               =   multiMa(typeAllig, teethLength, source, phase, power, sigma, offset, fcs, scs, fixed, select)
	lips                =   multiMa(typeAllig, lipsLength, source, phase, power, sigma, offset, fcs, scs, fixed, select)
	
	[jaw, teeth, lips]
//}
//}