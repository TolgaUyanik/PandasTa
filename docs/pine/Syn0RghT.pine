//@version=5
library("DoppelLib", dynamic_requests=true)

// getDailyClose()
//
// @function Returns the daily close for a specific offset.
// For each offset value (from 1 to 21), the function uses a static request.security() call
// to retrieve the daily close from the previous day at the specified offset.
// @param offset (int) The offset value (from 1 to 21) representing the desired close value.
// @returns (float) The daily close for the specified offset or na if offset is out of range.
export getDailyClose(int offset) =>
    offset == 1  ? request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on) :
     offset == 2  ? request.security(syminfo.tickerid, "D", close[2], lookahead=barmerge.lookahead_on) :
     offset == 3  ? request.security(syminfo.tickerid, "D", close[3], lookahead=barmerge.lookahead_on) :
     offset == 4  ? request.security(syminfo.tickerid, "D", close[4], lookahead=barmerge.lookahead_on) :
     offset == 5  ? request.security(syminfo.tickerid, "D", close[5], lookahead=barmerge.lookahead_on) :
     offset == 6  ? request.security(syminfo.tickerid, "D", close[6], lookahead=barmerge.lookahead_on) :
     offset == 7  ? request.security(syminfo.tickerid, "D", close[7], lookahead=barmerge.lookahead_on) :
     offset == 8  ? request.security(syminfo.tickerid, "D", close[8], lookahead=barmerge.lookahead_on) :
     offset == 9  ? request.security(syminfo.tickerid, "D", close[9], lookahead=barmerge.lookahead_on) :
     offset == 10 ? request.security(syminfo.tickerid, "D", close[10], lookahead=barmerge.lookahead_on) :
     offset == 11 ? request.security(syminfo.tickerid, "D", close[11], lookahead=barmerge.lookahead_on) :
     offset == 12 ? request.security(syminfo.tickerid, "D", close[12], lookahead=barmerge.lookahead_on) :
     offset == 13 ? request.security(syminfo.tickerid, "D", close[13], lookahead=barmerge.lookahead_on) :
     offset == 14 ? request.security(syminfo.tickerid, "D", close[14], lookahead=barmerge.lookahead_on) :
     offset == 15 ? request.security(syminfo.tickerid, "D", close[15], lookahead=barmerge.lookahead_on) :
     offset == 16 ? request.security(syminfo.tickerid, "D", close[16], lookahead=barmerge.lookahead_on) :
     offset == 17 ? request.security(syminfo.tickerid, "D", close[17], lookahead=barmerge.lookahead_on) :
     offset == 18 ? request.security(syminfo.tickerid, "D", close[18], lookahead=barmerge.lookahead_on) :
     offset == 19 ? request.security(syminfo.tickerid, "D", close[19], lookahead=barmerge.lookahead_on) :
     offset == 20 ? request.security(syminfo.tickerid, "D", close[20], lookahead=barmerge.lookahead_on) :
     offset == 21 ? request.security(syminfo.tickerid, "D", close[21], lookahead=barmerge.lookahead_on) :
     na

// isVolumeAboveThreshold()
//
// @function Checks if the current volume is above the threshold based on its moving average.
// The threshold is calculated as the average volume plus a percentage increment.
// @param vol (series float) The volume series (e.g. the chart volume).
// @param mediaPeriod (int) The period for calculating the moving average.
// @param thresholdPercent (float) The percentage to add to the average for the threshold.
// @returns (bool) True if the volume exceeds the threshold, false otherwise.
export isVolumeAboveThreshold(
     series float vol,
     int mediaPeriod,
     float thresholdPercent
     ) =>
    float avgVol = ta.sma(vol, mediaPeriod)
    float threshold = avgVol * (1 + thresholdPercent / 100)
    vol > threshold

// calcPvsra()
//
// @function Calculates the PVSRA candle color, determines if a vector candle has appeared,
// and returns additional support parameters (average volume, volume spread, highest volume spread).
//  - "High" (Climax): volume >= 200% of the average OR (volume * candle spread) >= highest spread over the previous 10 bars.
//      -> Bull candle: green; Bear candle: red.
//  - "Medium": volume >= 150% of the average.
//      -> Bull candle: blue; Bear candle: violet.
//  - Otherwise, default (non-vector) candle colors are used.
// @param pvsraVolume (series float) Volume series.
// @param pvsraHigh (series float) High price series.
// @param pvsraLow (series float) Low price series.
// @param pvsraClose (series float) Close price series.
// @param pvsraOpen (series float) Open price series.
// @param redVectorColor (simple color) Color for bearish candle in high scenario.
// @param greenVectorColor (simple color) Color for bullish candle in high scenario.
// @param violetVectorColor (simple color) Color for bearish candle in medium scenario.
// @param blueVectorColor (simple color) Color for bullish candle in medium scenario.
// @param darkGreyCandleColor (simple color) Color for bearish candle in non-vector situation.
// @param lightGrayCandleColor (simple color) Color for bullish candle in non-vector situation.
// @returns (tuple) A tuple containing: [pvsraColor (color), alertFlag (bool), averageVolume (float),
//          volumeSpread (float), highestVolumeSpread (float)].
export calcPvsra(
     series float pvsraVolume, 
     series float pvsraHigh, 
     series float pvsraLow, 
     series float pvsraClose, 
     series float pvsraOpen, 
     simple color redVectorColor, 
     simple color greenVectorColor, 
     simple color violetVectorColor, 
     simple color blueVectorColor, 
     simple color darkGreyCandleColor, 
     simple color lightGrayCandleColor
     ) =>
    float averageVolume = math.sum(pvsraVolume[1], 10) / 10.0
    float volumeSpread = pvsraVolume * (pvsraHigh - pvsraLow)
    float highestVolumeSpread = ta.highest(volumeSpread[1], 10)
    color pvsraColor = na
    bool alertFlag = false

    if pvsraVolume >= 2 * averageVolume or volumeSpread >= highestVolumeSpread
        pvsraColor := pvsraClose > pvsraOpen ? greenVectorColor : redVectorColor
        alertFlag := true
    else if pvsraVolume >= 1.5 * averageVolume
        pvsraColor := pvsraClose > pvsraOpen ? blueVectorColor : violetVectorColor
        alertFlag := true
    else
        pvsraColor := pvsraClose > pvsraOpen ? lightGrayCandleColor : darkGreyCandleColor
        alertFlag := false

    [pvsraColor, alertFlag, averageVolume, volumeSpread, highestVolumeSpread]

// directionalVolume()
//
// Lógica do "Volume Direcional Estilizado" convertida para função.
// NÃO usa input/plot/label/log. Só calcula e devolve os valores.
// 
// @param vol        Série de volume (ex: volume).
// @param h,l,o,c    Séries de preço high/low/open/close.
// @param inSession  true se a barra está dentro da sessão desejada.
// @param len        Período da média da amplitude (mesmo "len" do script original).
// @param thr_pct    Percentual acima da média para considerar "amplitude grande".
// @returns [vol_total, cor_barra, ampl, ma_session, ampl_threshold]
export directionalVolume(
     series float vol,
     series float h,
     series float l,
     series float o,
     series float c,
     bool         inSession,
     int          len,
     float        thr_pct
     ) =>
    // posição do fechamento dentro da barra
    float posicao        = (c - l) / (h - l + 1e-10)
    float volume_compra  = vol * posicao
    float volume_venda   = -(vol * (1 - posicao))
    float vol_total      = volume_compra + volume_venda

    color cor_compra = color.new(color.green, 0)
    color cor_venda  = color.new(color.red,   0)
    color cor_barra  = vol_total >= 0 ? cor_compra : cor_venda

    // amplitude e média da amplitude só dentro da sessão
    float ampl         = h - l
    float ampl_session = inSession ? ampl : na
    float ma_session   = ta.sma(ampl_session, len)

    float ampl_threshold = na(ma_session) ? na : ma_session * (1 + thr_pct / 100.0)
    if not na(ampl_threshold) and ampl > ampl_threshold
        cor_barra := color.new(color.blue, 0)

    // divergência entre corpo do candle e direção do volume direcional
    if (c > o and cor_barra == cor_venda) or (c < o and cor_barra == cor_compra)
        cor_barra := color.fuchsia

    [vol_total, cor_barra, ampl, ma_session, ampl_threshold]