//@version=5
library("FairValueLib")

// Exported function with typified argument
export f_getFairValue(string _ticker) =>
    switch _ticker
        "AAPL" => 180.0
        "MSFT" => 320.0
        "PYPL" => 100.0
        "BABA" => 140.0
        "TMDX" => 140.0
        "BTC" => 1000000
        "KWEB" => 45
        "TSM" => 225
        "ASML" => 700
        "NVDA" => 180
        "ALAB" => 160
        "ANET" => 100
        "PANW" => 135
        "CCJ" => 60
        "LEU" => 0
        "NBIS" => 80
        "GOOG" => 190
        "META" => 600
        "ADBE" => 480
        "UBER" => 80
        "GRAB" => 3.6
        "ONON" => 50
        "BABA" => 140
        "NFLX" => 95.9
        "MELI" => 2430
        "TMDX" => 140
        "NVO" => 90
        "PYPL" => 95

        
        => na
