//////
//@version=6
// =============================================================================
//  TL HEATMAP 3D PRO  ·  trader.lifestyle
//  ATAS-style liquidity heatmap with 3D relief shading.
//  Engine: volume accumulates per price zone and decays over time ->
//  persistent horizontal liquidity walls (band look), persistent object pools
//  (zero flicker), intensity-scaled alpha (soft cloud), subtle circle bubbles.
// =============================================================================
indicator("TL Heatmap 3D Pro", "TL HEATMAP 3D", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500,
     max_polylines_count = 100, max_bars_back = 1000)

// ------------------------------------------------------------- COLORS (TL) --
color C_NAVY    = color.rgb(6, 17, 30)
color C_PANEL   = color.rgb(10, 29, 46)
color C_SECT    = color.rgb(15, 44, 66)
color C_MINT    = color.rgb(126, 224, 208)
color C_RED     = color.rgb(244, 44, 58)
color C_CYAN    = color.rgb(53, 200, 255)
color C_GOLD    = color.rgb(255, 215, 40)
color C_GOLD2   = color.rgb(255, 236, 130)
color C_GOLD3   = color.rgb(238, 190, 30)
color C_GOLD4   = color.rgb(210, 160, 20)
color C_GOLD5   = color.rgb(170, 125, 12)
color C_GLINT   = color.rgb(255, 252, 214)
color C_TEXT    = color.rgb(235, 235, 235)
color C_GRAY    = color.rgb(176, 182, 192)
color C_YT      = color.rgb(150, 26, 34)
color C_WA      = color.rgb(28, 138, 66)
color C_BUYBUB  = color.rgb(0, 216, 106)
color C_SELLBUB = color.rgb(255, 45, 130)
color C_HIDE    = color.new(color.black, 100)

// ----------------------------------------------------------------- INPUTS --
grpH = "░ Heatmap Engine"
inCols   = input.int(16,  "Columns (time)",        minval = 8,  maxval = 22, group = grpH, tooltip = "Number of time columns in the heatmap grid. Each column merges several chart bars (see Bars per column).")
inRows   = input.int(24,  "Rows (price)",          minval = 10, maxval = 28, group = grpH, tooltip = "Number of price zones (rows). More rows = finer vertical resolution.")
inBpc    = input.int(10,  "Bars per column",       minval = 1,  maxval = 30, group = grpH, tooltip = "How many chart bars are merged into one heatmap column. Higher = wider history window.")
inPal    = input.string("GOLD 3D", "Palette", options = ["GOLD 3D", "TWILIGHT", "FIRE & ICE", "OCEAN", "INFERNO", "EMERALD", "MONO"], group = grpH, tooltip = "Color theme of the heatmap. GOLD 3D = TL signature look. FIRE & ICE colors cells by buy/sell dominance (blue = buyers, red = sellers).")
inCut    = input.float(0.08, "Cutoff (hide weak cells)", minval = 0.0, maxval = 0.5, step = 0.01, group = grpH, tooltip = "Cells weaker than this fraction of the frame maximum are hidden completely. Raise to declutter.")
inGamma  = input.float(0.70, "Gamma",              minval = 0.3, maxval = 2.5, step = 0.05, group = grpH, tooltip = "Contrast curve. Below 1 boosts weak zones, above 1 shows only the strongest.")
inTransp = input.int(6,   "Wall transparency",     minval = 0,  maxval = 90, group = grpH, tooltip = "Base transparency of the strongest cells. Weak cells automatically fade out more (soft cloud look).")
inDecay  = input.float(0.95, "Wall memory (decay per column)", minval = 0.80, maxval = 0.995, step = 0.005, group = grpH, tooltip = "Liquidity accumulates per price zone and fades over time — this makes walls persist as horizontal bands like on ATAS/Bookmap. Higher = walls stay visible longer.")

grp3 = "░ 3D Relief Shader"
inShade  = input.float(1.00, "Relief strength (emboss light)", minval = 0.0, maxval = 2.0, step = 0.05, group = grp3, tooltip = "Strength of the virtual light from the top-left. Wall tops get lit, undersides get shadow — this creates the 3D depth. 0 = flat heatmap.")
in3D     = input.bool(true,  "3D wall extrusion blocks", group = grp3, tooltip = "Extrude the strongest liquidity walls as 3D blocks with dark side faces and a lit top cap (ATAS GOLD-3D style).")
inWallTh = input.float(0.78, "Wall threshold", minval = 0.50, maxval = 0.95, step = 0.01, group = grp3, tooltip = "Minimum intensity (vs frame max) for a cell to count as a liquidity wall and get the 3D treatment.")

grpF = "░ Features"
inProfile = input.bool(true,  "Volume profile (right)", group = grpF, tooltip = "Volume-by-price bars on the right edge. The gold bar marks the POC row.")
inPoc     = input.bool(true,  "POC line", group = grpF, tooltip = "Gold line at the Point of Control — the price with the highest traded volume in the visible window.")
inWallLbl = input.bool(true,  "Wall labels", group = grpF, tooltip = "Dashed gold lines + WALL % labels on the two strongest walls that are still active in the recent columns.")
inBubbles = input.bool(true,  "Trade bubbles (subtle circles)", group = grpF, tooltip = "Small circle markers on bars with outsized volume (blue = buy pressure, magenta = sell pressure).")
inBubTh   = input.float(2.0,  "Bubble threshold (x avg vol)", minval = 1.2, maxval = 8.0, step = 0.1, group = grpF, tooltip = "A bar needs at least this multiple of the 50-bar average volume to get a bubble.")
inCvd     = input.bool(true,  "CVD strip (bottom)", group = grpF, tooltip = "Cumulative Volume Delta in a slim strip below the heatmap: rising = buyers dominate, falling = sellers dominate.")
inTheme   = input.bool(true,  "TL chart theme (navy bg + bar colors)", group = grpF, tooltip = "Navy background + mint/red candles. Disable to keep your own chart colors.")

grpP = "░ Cockpit Panel"
inPanel  = input.bool(true, "Show cockpit panel", group = grpP, tooltip = "The TL cockpit with engine checklist, POC, CVD and flow signal. Hover its rows for explanations.")
inPanPos = input.string("Middle Left", "Panel position", options = ["Middle Left", "Top Left", "Top Right", "Middle Right", "Bottom Left", "Bottom Right"], group = grpP, tooltip = "Where the cockpit panel is anchored on the chart.")
inUrlYt  = input.string("https://www.youtube.com/@TraderLifestyle", "YouTube URL (tooltip)", group = grpP, tooltip = "Shown as tooltip on the red YouTube button (TradingView tables cannot open links directly).")
inUrlRf  = input.string("https://my.roboforex.com", "RoboForex URL (tooltip)", group = grpP, tooltip = "Shown as tooltip on the gold RF button.")
inUrlWa  = input.string("https://trader.lifestyle", "WhatsApp/Site URL (tooltip)", group = grpP, tooltip = "Shown as tooltip on the green WhatsApp button.")

// ------------------------------------------------------------------ THEME --
bgcolor(inTheme ? C_NAVY : na)
barcolor(inTheme ? (close >= open ? C_MINT : C_RED) : na)

var box marginBox = na
if inTheme and barstate.isfirst
    marginBox := box.new(bar_index + 1, high * 1000, bar_index + 500, -high * 1000, border_color = na, bgcolor = C_NAVY)
if inTheme and barstate.islast and not na(marginBox)
    box.set_lefttop(marginBox, bar_index + 1, high * 1000)
    box.set_rightbottom(marginBox, bar_index + 500, -high * 1000)

// ----------------------------------------------------------------- HELPERS --
f_fmt(float x) =>
    ax = math.abs(x)
    ax >= 1e6 ? str.tostring(x / 1e6, "#.##") + "M" : ax >= 1e3 ? str.tostring(x / 1e3, "#.##") + "k" : ax >= 10 ? str.tostring(x, "#.#") : str.tostring(x, "#.##")

f_mix(color a, color b, float t) =>
    color.rgb(color.r(a) + (color.r(b) - color.r(a)) * t,
              color.g(a) + (color.g(b) - color.g(a)) * t,
              color.b(a) + (color.b(b) - color.b(a)) * t, color.t(a))

f_scale(color c, float f) =>
    color.rgb(math.min(255, math.max(0, color.r(c) * f)),
              math.min(255, math.max(0, color.g(c) * f)),
              math.min(255, math.max(0, color.b(c) * f)), color.t(c))

f_grad(float v, array<float> ps, array<color> cs) =>
    int n = array.size(ps)
    color res = array.get(cs, 0)
    if v >= array.get(ps, n - 1)
        res := array.get(cs, n - 1)
    else if v > array.get(ps, 0)
        for k = 0 to n - 2
            if v >= array.get(ps, k) and v < array.get(ps, k + 1)
                res := color.from_gradient(v, array.get(ps, k), array.get(ps, k + 1), array.get(cs, k), array.get(cs, k + 1))
                break
    res

var array<float> P_GOLD_S = array.from(0.0, 0.18, 0.34, 0.52, 0.70, 0.86, 1.0)
var array<color> P_GOLD_C = array.from(C_NAVY, color.rgb(52, 74, 102), C_GOLD5, C_GOLD4, C_GOLD3, C_GOLD, C_GOLD2)
var array<float> P_TWI_S  = array.from(0.0, 0.30, 0.58, 0.85, 1.0)
var array<color> P_TWI_C  = array.from(C_NAVY, color.rgb(52, 5, 149), color.rgb(74, 6, 158), color.rgb(245, 225, 36), color.rgb(255, 255, 255))
var array<float> P_OCE_S  = array.from(0.0, 0.35, 0.70, 1.0)
var array<color> P_OCE_C  = array.from(C_NAVY, color.rgb(0, 90, 140), C_CYAN, color.rgb(235, 250, 255))
var array<float> P_INF_S  = array.from(0.0, 0.30, 0.55, 0.78, 1.0)
var array<color> P_INF_C  = array.from(C_NAVY, color.rgb(87, 16, 110), color.rgb(188, 55, 84), color.rgb(249, 142, 9), color.rgb(252, 255, 164))
var array<float> P_EME_S  = array.from(0.0, 0.40, 0.75, 1.0)
var array<color> P_EME_C  = array.from(C_NAVY, color.rgb(10, 90, 60), C_MINT, color.rgb(240, 255, 250))
var array<float> P_MON_S  = array.from(0.0, 0.55, 1.0)
var array<color> P_MON_C  = array.from(C_NAVY, color.rgb(120, 126, 134), color.rgb(250, 250, 250))
var array<float> P_ICE_S  = array.from(0.0, 0.45, 0.80, 1.0)
var array<color> P_ICE_C  = array.from(C_NAVY, color.rgb(30, 80, 200), color.rgb(80, 170, 255), color.rgb(220, 245, 255))
var array<float> P_FIR_S  = array.from(0.0, 0.45, 0.80, 1.0)
var array<color> P_FIR_C  = array.from(C_NAVY, color.rgb(170, 30, 40), C_RED, color.rgb(255, 200, 120))

f_pal(float v, float buyFrac) =>
    switch inPal
        "GOLD 3D"    => f_grad(v, P_GOLD_S, P_GOLD_C)
        "TWILIGHT"   => f_grad(v, P_TWI_S, P_TWI_C)
        "FIRE & ICE" => buyFrac >= 0.5 ? f_grad(v, P_ICE_S, P_ICE_C) : f_grad(v, P_FIR_S, P_FIR_C)
        "OCEAN"      => f_grad(v, P_OCE_S, P_OCE_C)
        "INFERNO"    => f_grad(v, P_INF_S, P_INF_C)
        "EMERALD"    => f_grad(v, P_EME_S, P_EME_C)
        => f_grad(v, P_MON_S, P_MON_C)

// -------------------------------------------- PERSISTENT OBJECT POOLS -------
int effRows = math.min(inRows, math.floor(392 / inCols))
int lookback = inCols * inBpc

var array<box>   tilePool = array.new<box>()
var array<box>   extPool  = array.new<box>()
var array<box>   capPool  = array.new<box>()
var box          stripBox = na
var array<line>  profPool = array.new<line>()
var line         pocLine  = na
var line         wall1Ln  = na
var line         wall2Ln  = na
var line         cvdZero  = na
var label        pocLbl   = na
var label        wall1Lbl = na
var label        wall2Lbl = na
var label        cvdLbl   = na
var label        infoLbl  = na
var array<label> bubPool  = array.new<label>()
var polyline     cvdPoly  = na

f_hideBox(box b) =>
    box.set_bgcolor(b, C_HIDE)

f_hideLine(line l) =>
    line.set_color(l, C_HIDE)

f_hideLbl(label lb) =>
    label.set_color(lb, C_HIDE)
    label.set_textcolor(lb, C_HIDE)
    label.set_text(lb, "")

// ---------------------------------------------- PANEL STATE -----------------
var float g_poc      = na
var float g_pocVol   = 0.0
var int   g_wallCnt  = 0
var float g_wallPx   = na
var float g_wallPct  = 0.0
var int   g_bubCnt   = 0
var float g_cvdLast  = 0.0
var float g_totVol   = 0.0
var bool  g_hasVol   = true

// ---------------------------------------------------- BUILD (throttled) -----
varip int lastBuildMs = 0
bool needBuild = barstate.islast and (timenow - lastBuildMs > 4000 or barstate.isconfirmed)

if needBuild
    lastBuildMs := timenow

    // 0) lazy pool creation (once)
    if array.size(tilePool) == 0
        for k = 1 to effRows * inCols
            array.push(tilePool, box.new(bar_index, close, bar_index, close, border_color = na, bgcolor = C_HIDE))
        for k = 1 to 56
            array.push(extPool, box.new(bar_index, close, bar_index, close, border_color = na, bgcolor = C_HIDE))
        for k = 1 to 28
            array.push(capPool, box.new(bar_index, close, bar_index, close, border_color = na, bgcolor = C_HIDE))
        stripBox := box.new(bar_index, close, bar_index, close, border_color = na, bgcolor = C_HIDE)
        for k = 1 to effRows
            array.push(profPool, line.new(bar_index, close, bar_index, close, color = C_HIDE, width = 3))
        pocLine := line.new(bar_index, close, bar_index, close, color = C_HIDE, width = 2)
        wall1Ln := line.new(bar_index, close, bar_index, close, color = C_HIDE, width = 1, style = line.style_dashed)
        wall2Ln := line.new(bar_index, close, bar_index, close, color = C_HIDE, width = 1, style = line.style_dashed)
        cvdZero := line.new(bar_index, close, bar_index, close, color = C_HIDE, width = 1, style = line.style_dotted)
        pocLbl   := label.new(bar_index, close, "", style = label.style_label_left, color = C_HIDE, textcolor = C_HIDE, size = size.small)
        wall1Lbl := label.new(bar_index, close, "", style = label.style_label_left, color = C_HIDE, textcolor = C_HIDE, size = size.small)
        wall2Lbl := label.new(bar_index, close, "", style = label.style_label_left, color = C_HIDE, textcolor = C_HIDE, size = size.small)
        cvdLbl   := label.new(bar_index, close, "", style = label.style_label_left, color = C_HIDE, textcolor = C_HIDE, size = size.small)
        infoLbl  := label.new(bar_index, close, "ⓘ", style = label.style_label_left, color = C_PANEL, textcolor = C_CYAN, size = size.small,
             tooltip = "HOW TO READ THE HEATMAP\n\n■ Tiles = traded volume per price zone. Bright gold = heavy liquidity, dark = quiet.\n■ 3D blocks = the strongest liquidity walls — price often reacts at these levels.\n■ Gold solid line = POC (most traded price of the window).\n■ Dashed gold lines = active walls with their strength %.\n■ Right side = volume profile (gold bar = POC row).\n■ Bottom strip = CVD: rising mint = buyers dominate, falling red = sellers dominate.\n\nHover any label or panel row for details. Settings: hover each input for its explanation.")
        for k = 1 to 80
            array.push(bubPool, label.new(bar_index, close, "", style = label.style_circle, color = C_HIDE, size = size.tiny))

    // 1) price window
    float pHi = high
    float pLo = low
    int maxI = math.min(lookback - 1, bar_index)
    for i = 0 to maxI
        pHi := math.max(pHi, high[i])
        pLo := math.min(pLo, low[i])
    float rng = math.max(pHi - pLo, syminfo.mintick * 10)
    pHi += rng * 0.02
    pLo -= rng * 0.02
    rng := pHi - pLo
    float rowH = rng / effRows

    // 2) distribute volume into the grid (buy / sell separated)
    matrix<float> mB = matrix.new<float>(effRows, inCols, 0.0)
    matrix<float> mS = matrix.new<float>(effRows, inCols, 0.0)
    g_totVol := 0.0
    g_hasVol := false
    for i = 0 to maxI
        int c = inCols - 1 - math.floor(i / inBpc)
        if c >= 0
            float vol = nz(volume[i], 0.0)
            if vol > 0
                g_hasVol := true
            float w = vol > 0 ? vol : 1.0
            g_totVol += w
            float bHi = high[i]
            float bLo = low[i]
            float span = math.max(bHi - bLo, syminfo.mintick)
            float bf = math.max(0.0, math.min(1.0, (close[i] - bLo) / span))
            int r0 = math.max(0, math.floor((bLo - pLo) / rowH))
            int r1 = math.min(effRows - 1, math.floor((bHi - pLo) / rowH))
            for r = r0 to r1
                float zLo = pLo + r * rowH
                float ov = math.max(0.0, math.min(bHi, zLo + rowH) - math.max(bLo, zLo)) / span
                if ov > 0
                    matrix.set(mB, r, c, matrix.get(mB, r, c) + w * ov * bf)
                    matrix.set(mS, r, c, matrix.get(mS, r, c) + w * ov * (1.0 - bf))

    // 3) cumulative liquidity bands (ATAS wall look): volume builds per price
    //    zone over time and slowly decays -> persistent horizontal walls
    matrix<float> mC = matrix.new<float>(effRows, inCols, 0.0)
    for r = 0 to effRows - 1
        float run = 0.0
        for c = 0 to inCols - 1
            run := run * inDecay + matrix.get(mB, r, c) + matrix.get(mS, r, c)
            matrix.set(mC, r, c, run)
    array<float> colMax = array.new<float>()
    for c = 0 to inCols - 1
        float cm = 0.0
        for r = 0 to effRows - 1
            cm := math.max(cm, matrix.get(mC, r, c))
        if cm > 0
            array.push(colMax, cm)
    float frameMax = array.size(colMax) > 0 ? array.percentile_nearest_rank(colMax, 85) : 1.0
    frameMax := math.max(frameMax, 1e-10)

    matrix<float> mV = matrix.new<float>(effRows, inCols, 0.0)
    for r = 0 to effRows - 1
        for c = 0 to inCols - 1
            float raw = matrix.get(mC, r, c)
            float lin = math.min(1.0, raw / frameMax)
            float v = lin <= inCut ? 0.0 : (lin - inCut) / (1.0 - inCut)
            matrix.set(mV, r, c, math.pow(v, inGamma))

    int lastBar = bar_index
    int firstBar = lastBar - inCols * inBpc + 1
    int dxExt = math.max(1, math.round(inBpc * 0.35))
    float dyExt = rowH * 0.45

    // legend info label, top right of the window
    label.set_xy(infoLbl, lastBar + 3, pHi)

    // 4) wall selection for extrusion budget
    array<float> wallVs = array.new<float>()
    for r = 0 to effRows - 1
        for c = 0 to inCols - 1
            if matrix.get(mV, r, c) >= inWallTh
                array.push(wallVs, matrix.get(mV, r, c))
    float extTh = inWallTh
    if array.size(wallVs) > 56
        array.sort(wallVs, order.descending)
        extTh := math.max(inWallTh, array.get(wallVs, 55))

    // 5) UPDATE extrusion pools in place
    int extIdx = 0
    int capIdx = 0
    if in3D
        for r = 0 to effRows - 1
            for c = 0 to inCols - 1
                float v = matrix.get(mV, r, c)
                if v >= extTh and extIdx < 56
                    int bL = lastBar - (inCols - c) * inBpc + 1
                    int bR = lastBar - (inCols - c - 1) * inBpc
                    float yB = pLo + r * rowH
                    float yT = yB + rowH
                    float bfr = matrix.get(mB, r, c) / math.max(matrix.get(mB, r, c) + matrix.get(mS, r, c), 1e-10)
                    color base = f_pal(v, bfr)
                    box eb = array.get(extPool, extIdx)
                    box.set_lefttop(eb, bL + dxExt, yT + dyExt)
                    box.set_rightbottom(eb, bR + dxExt, yB + dyExt)
                    box.set_bgcolor(eb, color.new(f_scale(base, 0.50), 16))
                    extIdx += 1
                    bool topOfWall = r == effRows - 1 or matrix.get(mV, math.min(r + 1, effRows - 1), c) < extTh
                    if topOfWall and capIdx < 28
                        box cb = array.get(capPool, capIdx)
                        box.set_lefttop(cb, bL + dxExt, yT + dyExt)
                        box.set_rightbottom(cb, bR + dxExt, yT + dyExt * 0.35)
                        box.set_bgcolor(cb, color.new(f_mix(base, C_GLINT, 0.55), 8))
                        capIdx += 1
    if extIdx < 56
        for k = extIdx to 55
            f_hideBox(array.get(extPool, k))
    if capIdx < 28
        for k = capIdx to 27
            f_hideBox(array.get(capPool, k))

    // 6) UPDATE tiles in place — intensity-scaled alpha = soft cloud
    for r = 0 to effRows - 1
        for c = 0 to inCols - 1
            box tb = array.get(tilePool, r * inCols + c)
            float v = matrix.get(mV, r, c)
            if v > 0
                float vUp = r < effRows - 1 ? matrix.get(mV, r + 1, c) : 0.0
                float vDn = r > 0 ? matrix.get(mV, r - 1, c) : 0.0
                float vLt = c > 0 ? matrix.get(mV, r, c - 1) : 0.0
                float vRt = c < inCols - 1 ? matrix.get(mV, r, c + 1) : 0.0
                float relief = 0.90 * (v - vUp) - 0.55 * (v - vDn) + 0.45 * (v - vLt) - 0.30 * (v - vRt)
                float f = math.max(0.55, math.min(1.45, 1.0 + relief * inShade))
                float bfr = matrix.get(mB, r, c) / math.max(matrix.get(mB, r, c) + matrix.get(mS, r, c), 1e-10)
                color cc = f_scale(f_pal(v, bfr), f)
                if v > 0.82 and (v - vUp) > 0.30
                    cc := f_mix(cc, C_GLINT, 0.45)
                int bL = lastBar - (inCols - c) * inBpc + 1
                int bR = lastBar - (inCols - c - 1) * inBpc
                float yB = pLo + r * rowH
                int tp = math.min(95, inTransp + math.round((1.0 - v) * 72))
                box.set_lefttop(tb, bL, yB + rowH)
                box.set_rightbottom(tb, bR, yB)
                box.set_bgcolor(tb, color.new(cc, tp))
            else
                f_hideBox(tb)

    // 7) POC + walls
    int pocR = 0
    float pocT = -1.0
    array<float> rowRecent = array.new<float>(effRows, 0.0)
    array<float> rowTotals = array.new<float>(effRows, 0.0)
    int cRecent = math.max(0, inCols - math.ceil(inCols * 0.4))
    for r = 0 to effRows - 1
        float tot = 0.0
        float rmax = 0.0
        for c = 0 to inCols - 1
            tot += matrix.get(mB, r, c) + matrix.get(mS, r, c)
            if c >= cRecent
                rmax := math.max(rmax, matrix.get(mV, r, c))
        array.set(rowRecent, r, rmax)
        array.set(rowTotals, r, tot)
        if tot > pocT
            pocT := tot
            pocR := r
    g_poc := pLo + (pocR + 0.5) * rowH
    g_pocVol := pocT

    if inPoc
        line.set_xy1(pocLine, firstBar, g_poc)
        line.set_xy2(pocLine, lastBar + 2, g_poc)
        line.set_color(pocLine, color.new(C_GOLD, 15))
        label.set_xy(pocLbl, lastBar + 3, g_poc)
        label.set_text(pocLbl, "POC " + str.tostring(g_poc, format.mintick))
        label.set_color(pocLbl, C_PANEL)
        label.set_textcolor(pocLbl, C_GOLD)
        label.set_tooltip(pocLbl, "Point of Control — price with the highest traded volume in the window (" + f_fmt(pocT) + ")")
    else
        f_hideLine(pocLine)
        f_hideLbl(pocLbl)

    g_wallCnt := 0
    g_wallPx := na
    g_wallPct := 0.0
    if inWallLbl
        for k = 0 to 1
            int bestR = -1
            float bestV = inWallTh
            for r = 0 to effRows - 1
                if array.get(rowRecent, r) > bestV and math.abs(r - pocR) > 1
                    bestV := array.get(rowRecent, r)
                    bestR := r
            line wl = k == 0 ? wall1Ln : wall2Ln
            label wlb = k == 0 ? wall1Lbl : wall2Lbl
            if bestR >= 0
                float wy = pLo + (bestR + 0.5) * rowH
                line.set_xy1(wl, firstBar, wy)
                line.set_xy2(wl, lastBar + 2, wy)
                line.set_color(wl, color.new(C_GOLD, 55))
                label.set_xy(wlb, lastBar + 3, wy)
                label.set_text(wlb, "WALL " + str.tostring(bestV * 100, "#") + "%")
                label.set_color(wlb, C_PANEL)
                label.set_textcolor(wlb, C_GOLD2)
                label.set_tooltip(wlb, "Liquidity wall — dense volume band active in the recent columns.")
                array.set(rowRecent, bestR, 0.0)
                g_wallCnt += 1
                if na(g_wallPx)
                    g_wallPx := wy
                    g_wallPct := bestV * 100
            else
                f_hideLine(wl)
                f_hideLbl(wlb)
        for r = 0 to effRows - 1
            if array.get(rowRecent, r) >= inWallTh
                g_wallCnt += 1
    else
        f_hideLine(wall1Ln)
        f_hideLine(wall2Ln)
        f_hideLbl(wall1Lbl)
        f_hideLbl(wall2Lbl)

    // 8) volume profile (right)
    for r = 0 to effRows - 1
        line pl = array.get(profPool, r)
        float tot = array.get(rowTotals, r)
        int len = inProfile ? math.round(16 * tot / math.max(pocT, 1e-10)) : 0
        if len > 0
            float y = pLo + (r + 0.5) * rowH
            line.set_xy1(pl, lastBar + 6, y)
            line.set_xy2(pl, lastBar + 6 + len, y)
            line.set_color(pl, r == pocR ? color.new(C_GOLD, 10) : color.new(color.rgb(240, 240, 240), 50))
        else
            f_hideLine(pl)

    // 9) 3D glossy trade bubbles — glow ring + body + specular glint,
    //    computed on CLOSED bars only -> rock stable, no per-tick flicker
    g_bubCnt := 0
    if inBubbles
        float avgV = 0.0
        int nAvg = math.min(50, maxI)
        for i = 1 to nAvg
            avgV += nz(volume[i], 0.0)
        avgV := math.max(avgV / math.max(nAvg, 1), 1e-10)
        for i = 1 to maxI
            float vol = nz(volume[i], 0.0)
            float ratio = vol / avgV
            if ratio >= inBubTh and g_bubCnt < 20
                float span = math.max(high[i] - low[i], syminfo.mintick)
                float bfr = math.max(0.0, math.min(1.0, (close[i] - low[i]) / span))
                bool isBuy = bfr >= 0.5
                color hue = isBuy ? C_BUYBUB : C_SELLBUB
                float delta = vol * (2.0 * bfr - 1.0)
                string tip = (isBuy ? "⬤ BUY VOLUME BUBBLE" : "⬤ SELL VOLUME BUBBLE") + "\nTIME   " + str.format_time(time[i], "dd.MM HH:mm", syminfo.timezone) + "\nVOL    " + f_fmt(vol) + "  (" + str.tostring(ratio, "#.#") + "x avg)" + "\nBUY " + str.tostring(bfr * 100, "#") + "%  ·  SELL " + str.tostring((1 - bfr) * 100, "#") + "%" + "\nDELTA  " + (delta >= 0 ? "+" : "-") + f_fmt(math.abs(delta)) + "\nPRICE  " + str.tostring(hl2[i], format.mintick) + "\n\nBig players were active on this bar — expect reactions when price retests this level."
                int tier = ratio >= 6 ? 3 : ratio >= 4 ? 2 : ratio >= 2.8 ? 1 : 0
                label glow = array.get(bubPool, g_bubCnt * 4)
                label body = array.get(bubPool, g_bubCnt * 4 + 1)
                label core = array.get(bubPool, g_bubCnt * 4 + 2)
                label glnt = array.get(bubPool, g_bubCnt * 4 + 3)
                label.set_xy(glow, lastBar - i, hl2[i])
                label.set_color(glow, color.new(hue, 75))
                label.set_size(glow, tier == 3 ? size.huge : tier == 2 ? size.large : tier == 1 ? size.normal : size.small)
                label.set_tooltip(glow, tip)
                label.set_xy(body, lastBar - i, hl2[i])
                label.set_color(body, color.new(hue, 0))
                label.set_size(body, tier == 3 ? size.large : tier == 2 ? size.normal : tier == 1 ? size.small : size.tiny)
                label.set_tooltip(body, tip)
                if tier >= 1
                    label.set_xy(core, lastBar - i, hl2[i] + rowH * 0.06)
                    label.set_color(core, color.new(f_mix(hue, color.rgb(255, 255, 255), 0.45), 0))
                    label.set_size(core, tier == 3 ? size.normal : tier == 2 ? size.small : size.tiny)
                    label.set_tooltip(core, tip)
                else
                    f_hideLbl(core)
                if tier >= 2
                    label.set_xy(glnt, lastBar - i, hl2[i] + rowH * 0.20)
                    label.set_color(glnt, color.new(color.rgb(255, 255, 255), 12))
                    label.set_size(glnt, tier == 3 ? size.small : size.tiny)
                    label.set_tooltip(glnt, tip)
                else
                    f_hideLbl(glnt)
                g_bubCnt += 1
    if g_bubCnt * 4 < 80
        for k = g_bubCnt * 4 to 79
            f_hideLbl(array.get(bubPool, k))

    // 10) CVD strip
    if inCvd
        float stripT = pLo - rng * 0.012
        float stripB = pLo - rng * 0.075
        box.set_lefttop(stripBox, firstBar, stripT)
        box.set_rightbottom(stripBox, lastBar + 2, stripB)
        box.set_bgcolor(stripBox, color.new(C_PANEL, 30))
        array<float> cvd = array.new<float>()
        float acc = 0.0
        for k = 0 to maxI
            int i = maxI - k
            float span = math.max(high[i] - low[i], syminfo.mintick)
            acc += nz(volume[i], 0.0) * (((close[i] - low[i]) - (high[i] - close[i])) / span)
            array.push(cvd, acc)
        g_cvdLast := acc
        float cMin = math.min(0.0, array.min(cvd))
        float cMax = math.max(0.0, array.max(cvd))
        float cRng = math.max(cMax - cMin, 1e-10)
        float y0 = stripB + (0.0 - cMin) / cRng * (stripT - stripB)
        line.set_xy1(cvdZero, firstBar, y0)
        line.set_xy2(cvdZero, lastBar + 2, y0)
        line.set_color(cvdZero, color.new(C_GRAY, 70))
        array<chart.point> pts = array.new<chart.point>()
        int step = math.max(1, math.floor((maxI + 1) / 120))
        for k = 0 to array.size(cvd) - 1
            if k % step == 0 or k == array.size(cvd) - 1
                float yy = stripB + (array.get(cvd, k) - cMin) / cRng * (stripT - stripB)
                array.push(pts, chart.point.from_index(lastBar - maxI + k, yy))
        if not na(cvdPoly)
            polyline.delete(cvdPoly)
        cvdPoly := polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_index, line_color = color.new(acc >= 0 ? C_MINT : C_RED, 0), line_width = 1)
        label.set_xy(cvdLbl, lastBar + 3, (stripT + stripB) / 2)
        label.set_text(cvdLbl, "CVD " + (acc >= 0 ? "▲ " : "▼ ") + f_fmt(math.abs(acc)))
        label.set_color(cvdLbl, C_PANEL)
        label.set_textcolor(cvdLbl, acc >= 0 ? C_MINT : C_RED)
        label.set_tooltip(cvdLbl, "Cumulative Volume Delta (bar proxy) across the visible window.")
    else
        f_hideBox(stripBox)
        f_hideLine(cvdZero)
        f_hideLbl(cvdLbl)
        if not na(cvdPoly)
            polyline.delete(cvdPoly)
            cvdPoly := na

// ======================================================= COCKPIT PANEL ======
varip int  glintCol = 0
varip int  bullPos  = 0
varip bool blinkOn  = true
if barstate.islast
    glintCol := (glintCol + 1) % 8
    bullPos  := (bullPos + 1) % 8
    blinkOn  := not blinkOn

var array<string> LOGO = array.from("XXXX.X..", ".XX..X..", ".XX..X..", ".XX..X..", ".XX..XXX")
var array<color> LOGO_GOLD = array.from(color.rgb(255, 236, 130), color.rgb(255, 215, 40), color.rgb(238, 190, 30), color.rgb(210, 160, 20), color.rgb(170, 125, 12))

f_panPos() =>
    switch inPanPos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Middle Right" => position.middle_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        => position.middle_left

f_chk(table t, int row, string badge, string txt, string status, color sc, string tip) =>
    table.cell(t, 0, row, badge, bgcolor = C_PANEL, text_color = C_GOLD, text_size = size.tiny, tooltip = tip)
    table.cell(t, 1, row, txt, bgcolor = C_PANEL, text_color = C_GRAY, text_size = size.tiny, text_halign = text.align_left, tooltip = tip)
    table.cell(t, 6, row, status, bgcolor = C_PANEL, text_color = sc, text_size = size.tiny, text_halign = text.align_right, tooltip = tip)

var table pan = na
if inPanel and barstate.islast
    if na(pan)
        pan := table.new(f_panPos(), 8, 30, bgcolor = C_PANEL, frame_color = C_SECT, frame_width = 1, border_width = 0)
        for rr = 0 to 29
            for cc = 0 to 7
                table.cell(pan, cc, rr, " ", bgcolor = C_PANEL, text_color = C_TEXT, text_size = size.tiny)
        for rr in array.from(5, 8, 10, 12, 15, 22, 24, 27)
            for cc = 0 to 7
                table.cell(pan, cc, rr, " ", bgcolor = C_NAVY, text_size = size.tiny)
        table.merge_cells(pan, 0, 6, 6, 6)
        table.merge_cells(pan, 0, 7, 7, 7)
        table.merge_cells(pan, 0, 11, 7, 11)
        table.merge_cells(pan, 0, 13, 3, 13)
        table.merge_cells(pan, 4, 13, 7, 13)
        table.merge_cells(pan, 0, 14, 3, 14)
        table.merge_cells(pan, 4, 14, 7, 14)
        for rr = 16 to 21
            table.merge_cells(pan, 1, rr, 5, rr)
            table.merge_cells(pan, 6, rr, 7, rr)
        table.merge_cells(pan, 0, 23, 7, 23)
        table.merge_cells(pan, 0, 25, 7, 25)
        table.merge_cells(pan, 0, 26, 7, 26)
        table.merge_cells(pan, 0, 28, 2, 28)
        table.merge_cells(pan, 3, 28, 4, 28)
        table.merge_cells(pan, 5, 28, 7, 28)
        table.merge_cells(pan, 0, 29, 7, 29)

    for rr = 0 to 4
        string row = array.get(LOGO, rr)
        for cc = 0 to 7
            bool on = str.substring(row, cc, cc + 1) == "X"
            color tc = on ? (cc == glintCol ? C_GLINT : array.get(LOGO_GOLD, rr)) : color.new(C_PANEL, 100)
            table.cell(pan, cc, rr, "█", bgcolor = C_PANEL, text_color = tc, text_size = size.small, text_font_family = font.family_monospace)

    table.cell(pan, 0, 6, "TL HEATMAP 3D PRO", bgcolor = C_PANEL, text_color = C_GOLD, text_size = size.normal, text_font_family = font.family_monospace, text_halign = text.align_left, tooltip = "ATAS-style liquidity heatmap with 3D relief shading — by trader.lifestyle. Hover any row for explanations.")
    table.cell(pan, 7, 6, blinkOn ? "●" : "○", bgcolor = C_PANEL, text_color = C_CYAN, text_size = size.small, tooltip = "Engine heartbeat — blinks while the heatmap is live-updating.")
    table.cell(pan, 0, 7, syminfo.ticker + " · trader.lifestyle", bgcolor = C_PANEL, text_color = C_CYAN, text_size = size.tiny, text_halign = text.align_left, tooltip = "Active symbol · brand site")

    for cc = 0 to 7
        table.cell(pan, cc, 9, "▲", bgcolor = C_PANEL, text_color = cc == bullPos ? C_GOLD : C_MINT, text_size = size.tiny)

    table.cell(pan, 0, 11, "◆ " + inPal + " · RELIEF " + (inShade > 0 ? "ON" : "OFF") + " · " + (in3D ? "3D WALLS" : "FLAT"), bgcolor = C_SECT, text_color = C_GOLD2, text_size = size.tiny, text_halign = text.align_center, tooltip = "Active palette · relief shader state · wall rendering mode. Change all of it in the settings — hover each input there for explanations.")

    table.cell(pan, 0, 13, "TF  " + timeframe.period, bgcolor = C_PANEL, text_color = C_TEXT, text_size = size.tiny, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "Chart timeframe the heatmap is built on.")
    table.cell(pan, 4, 13, "SYM " + syminfo.ticker, bgcolor = C_PANEL, text_color = C_TEXT, text_size = size.tiny, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "Symbol the heatmap is built on.")
    table.cell(pan, 0, 14, "GRID " + str.tostring(inCols) + "x" + str.tostring(effRows), bgcolor = C_PANEL, text_color = C_GRAY, text_size = size.tiny, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "Heatmap resolution: time columns x price rows. Adjustable in settings.")
    table.cell(pan, 4, 14, g_hasVol ? "SRC VOLUME" : "SRC TIME@PRICE", bgcolor = C_PANEL, text_color = C_GRAY, text_size = size.tiny, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "Data source: real bar volume. If the symbol has no volume, falls back to time-at-price density.")

    f_chk(pan, 16, "❶", "DATA ENGINE", g_totVol > 0 ? "OK" : "..", g_totVol > 0 ? C_MINT : C_GRAY, "Volume distribution engine. OK = bar volume is being distributed across " + str.tostring(inCols) + "x" + str.tostring(effRows) + " price zones.")
    f_chk(pan, 17, "❷", "RELIEF SHADER", inShade > 0 ? "ON" : "OFF", inShade > 0 ? C_MINT : C_GRAY, "Emboss lighting: a virtual light from the top-left lights wall tops and shadows undersides — that is what makes the heatmap look 3D.")
    f_chk(pan, 18, "❸", "WALLS", str.tostring(g_wallCnt), g_wallCnt > 0 ? C_GOLD : C_GRAY, "Number of liquidity walls detected right now (dense volume bands above the wall threshold). Price often reacts at walls.")
    f_chk(pan, 19, "❹", "POC", na(g_poc) ? ".." : str.tostring(g_poc, format.mintick), C_CYAN, "Point of Control: the price with the highest traded volume in the visible window — the market's fair price magnet.")
    f_chk(pan, 20, "❺", "CVD", (g_cvdLast >= 0 ? "▲ " : "▼ ") + f_fmt(math.abs(g_cvdLast)), g_cvdLast >= 0 ? C_MINT : C_RED, "Cumulative Volume Delta: buy pressure minus sell pressure. ▲ mint = buyers dominate, ▼ red = sellers dominate.")
    f_chk(pan, 21, "❻", "BUBBLES", inBubbles ? str.tostring(g_bubCnt) : "OFF", g_bubCnt > 0 ? C_MINT : C_GRAY, "Volume-spike markers: bars with several times the average volume. Enable in settings (Trade bubbles).")

    table.cell(pan, 0, 23, na(g_poc) ? "— COLLECTING —" : "POC " + str.tostring(g_poc, format.mintick) + " · VOL " + f_fmt(g_pocVol), bgcolor = C_SECT, text_color = C_TEXT, text_size = size.small, text_font_family = font.family_monospace, text_halign = text.align_center, tooltip = "Point of Control price and the volume traded there — the strongest magnet level of the window.")

    bool wallNear = not na(g_wallPx) and math.abs(g_wallPx - close) / close < 0.004
    string sig = wallNear ? "WALL " + str.tostring(g_wallPx, format.mintick) + " · " + str.tostring(g_wallPct, "#") + "%" : g_cvdLast >= 0 ? "▲ BUY FLOW" : "▼ SELL FLOW"
    color sigC = wallNear ? C_GOLD : g_cvdLast >= 0 ? C_MINT : C_RED
    table.cell(pan, 0, 25, sig, bgcolor = C_PANEL, text_color = sigC, text_size = size.large, text_font_family = font.family_monospace, text_halign = text.align_center, tooltip = "Live read: when price is near a liquidity wall it shows the wall price and strength — expect a reaction there. Otherwise it shows which side dominates the volume flow (CVD).")

    table.cell(pan, 0, 26, "WALLS " + str.tostring(g_wallCnt) + " · BUB " + (inBubbles ? str.tostring(g_bubCnt) : "OFF") + " · VOL " + f_fmt(g_totVol), bgcolor = C_PANEL, text_color = C_GRAY, text_size = size.tiny, text_halign = text.align_center, tooltip = "Walls detected · volume-spike bubbles shown · total volume inside the heatmap window.")

    table.cell(pan, 0, 28, "▶ YOUTUBE", bgcolor = C_YT, text_color = color.white, text_size = size.tiny, tooltip = "TL YouTube channel: " + inUrlYt)
    table.cell(pan, 3, 28, "RF", bgcolor = C_GOLD, text_color = C_NAVY, text_size = size.tiny, tooltip = "RoboForex: " + inUrlRf)
    table.cell(pan, 5, 28, "✆ WHATSAPP", bgcolor = C_WA, text_color = color.white, text_size = size.tiny, tooltip = "Contact / site: " + inUrlWa)

    table.cell(pan, 0, 29, "● LIVE · trader.lifestyle", bgcolor = C_PANEL, text_color = C_GRAY, text_size = size.tiny, text_halign = text.align_center, tooltip = "Persistent live engine — objects update in place every few seconds, no flicker.")
