//@version=6
indicator("ATR Label", overlay=true)

// Inputs
atrLength = input.int(14, title="ATR Length")
atrSmoothing = input.string("RMA", title="Smoothing", options=["RMA", "SMA", "EMA", "WMA"])

// ATR calculation — always daily
atrValue = switch atrSmoothing
    "RMA" => request.security(syminfo.tickerid, "D", ta.atr(atrLength))
    "SMA" => request.security(syminfo.tickerid, "D", ta.sma(ta.tr(true), atrLength))
    "EMA" => request.security(syminfo.tickerid, "D", ta.ema(ta.tr(true), atrLength))
    "WMA" => request.security(syminfo.tickerid, "D", ta.wma(ta.tr(true), atrLength))

// Daily range consumption
dailyHigh = request.security(syminfo.tickerid, "D", high)
dailyLow  = request.security(syminfo.tickerid, "D", low)
dailyRange = dailyHigh - dailyLow
consumed = (dailyRange / atrValue) * 100

// Color shifts as ATR gets consumed
consumedColor = consumed < 50 ? color.new(color.green, 20) : consumed < 80 ? color.new(color.orange, 20) : color.new(color.red, 20)

// Table
var table atrTable = table.new(position.top_right, 1, 1, border_width=1)

if barstate.islast
    table.cell(
         atrTable, 0, 0,
         text="ATR(" + str.tostring(atrLength) + ") D  " + str.tostring(atrValue, "#.00") + "  |  " + str.tostring(consumed, "#.0") + "% used",
         text_color=color.white,
         text_size=size.normal,
         bgcolor=consumedColor
         )