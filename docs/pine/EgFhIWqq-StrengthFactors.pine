// @description Strength factor calculations for various market analysis metrics by AlKaIsMe
library("StrengthFactors")

// @function Calculate threshold based on options
// @param opt Threshold option ("Disabled", "User Input Threshold", "Average as Threshold")
// @param input_val User input threshold value
// @param avg_val Average value for threshold
// @param lineancy Lineancy adjustment percentage
// @returns Calculated threshold
export get_threshold(string opt, float input_val, float avg_val, float lineancy) =>
    if opt == "Disabled"
        na
    else if opt == "User Input Threshold"
        input_val - lineancy
    else if opt == "Average as Threshold"
        avg_val - lineancy
    else
        0.0

// @function Calculate percentage of threshold
// @param value Current value
// @param threshold Threshold value
// @returns Percentage of threshold
export get_percentage_of_threshold(float value, float threshold) =>
    threshold != 0 ? (value / threshold) * 100 : 0

// @function Calculate Distance Strength Factor
// @param lookback Lookback period for average
// @param thr_opt Threshold option
// @param thr_inp User threshold input (as multiplier of average)
// @param lineancy Lineancy adjustment
// @returns [distance_sf, distance_avg, distance_threshold, distance_prc_of_thr]
export get_distance_sf(int lookback, string thr_opt, float thr_inp, float lineancy) =>
    float bar_dist = high - low
    float bar_dist_avg = ta.sma(bar_dist, lookback)
    float dsT_SF_thr = 
         thr_opt == "Average as Threshold" ? bar_dist_avg * ((100-lineancy)/100) : 
         thr_opt == "User Input Threshold" ? thr_inp * (bar_dist_avg * ((100-lineancy)/100)) : 0.0
    float dsT_SF_as_prc_of_thr = get_percentage_of_threshold(bar_dist, dsT_SF_thr)
    [bar_dist, bar_dist_avg, dsT_SF_thr, dsT_SF_as_prc_of_thr]

// @function Calculate Uniformity Strength Factor
// @param lookback Lookback period for average
// @param thr_opt Threshold option
// @param thr_inp User threshold input
// @param stddev_mult Standard deviation multiplier
// @param lineancy Lineancy adjustment
// @returns [uniformity_sf, uniformity_avg, uniformity_threshold, uniformity_prc_of_thr]
export get_uniformity_sf(int lookback, string thr_opt, float thr_inp, float stddev_mult, float lineancy) =>
    float bar_dist = high - low
    float unI_SF = (bar_dist / bar_dist[1]) * 100
    
    // Filtered series for values above and below 100
    float unI_SF_above100 = unI_SF >= 100 ? unI_SF : na
    float unI_SF_below100 = unI_SF < 100 ? unI_SF : na
    
    // Calculate averages of each filtered series
    float avg_above100 = ta.sma(unI_SF_above100, lookback)
    float avg_below100 = ta.sma(unI_SF_below100, lookback)
    
    // Calculate overall average for return value
    float unI_SF_avg = ta.sma(unI_SF, lookback)
    
    // Standard deviations
    float stdDev_above100 = ta.stdev(unI_SF_above100, lookback, true)
    float stdDev_below100 = ta.stdev(unI_SF_below100, lookback, true)
    
    float unI_SF_thr = 
         thr_opt == "Disabled" ? 0 :
         thr_opt == "User Input Threshold" ?
          unI_SF >= 100 ? 100 + thr_inp + lineancy :
          unI_SF < 100 ? 100 - thr_inp - lineancy : 0 :
        // Average as Threshold option
         unI_SF >= 100 ? avg_above100 + (stdDev_above100 * stddev_mult) + lineancy :
         unI_SF < 100 ? avg_below100 - (stdDev_below100 * stddev_mult) - lineancy : 0
    
    float unI_SF_as_prc_of_thr = get_percentage_of_threshold(unI_SF, unI_SF_thr)
    [unI_SF, unI_SF_avg, unI_SF_thr, unI_SF_as_prc_of_thr]

// @function Calculate Overlap Strength Factor
// @param lookback Lookback period for average
// @param thr_opt Threshold option
// @param thr_inp User threshold input
// @param lineancy Lineancy adjustment
// @returns [overlap_sf, overlap_avg, overlap_threshold, overlap_prc_of_thr]
export get_overlap_sf(int lookback, string thr_opt, float thr_inp, float lineancy) =>
    float bar_dist = high - low
    float ovL_dist = math.max(0, (ta.lowest(high,2) - ta.highest(low,2)))
    float ovL_SF = (ovL_dist / bar_dist) * 100
    float ovL_SF_avg = ta.sma(ovL_SF, lookback)
    float ovL_SF_thr = get_threshold(thr_opt, thr_inp, ovL_SF_avg, lineancy)
    float ovL_SF_as_prc_of_thr = get_percentage_of_threshold(ovL_SF, ovL_SF_thr)
    [ovL_SF, ovL_SF_avg, ovL_SF_thr, ovL_SF_as_prc_of_thr]

// @function Calculate Body Strength Factor
// @param lookback Lookback period for average
// @param thr_opt Threshold option
// @param thr_inp User threshold input
// @param lineancy Lineancy adjustment
// @returns [body_sf, body_avg, body_threshold, body_prc_of_thr]
export get_body_sf(int lookback, string thr_opt, float thr_inp, float lineancy) =>
    float bar_dist = high - low
    float body_dist = math.abs(close - open)
    float boD_SF = (body_dist / bar_dist) * 100
    float boD_SF_avg = ta.sma(boD_SF, lookback)
    float boD_SF_thr = get_threshold(thr_opt, thr_inp, boD_SF_avg, lineancy)
    float boD_SF_as_prc_of_thr = get_percentage_of_threshold(boD_SF, boD_SF_thr)
    [boD_SF, boD_SF_avg, boD_SF_thr, boD_SF_as_prc_of_thr]

// @function Calculate Close Strength Factor
// @param lookback Lookback period for average
// @param thr_opt Threshold option
// @param thr_inp User threshold input
// @param lineancy Lineancy adjustment
// @returns [close_sf, close_avg, close_threshold, close_prc_of_thr]
export get_close_sf(int lookback, string thr_opt, float thr_inp, float lineancy) =>
    float bar_dist = high - low
    float bar_dir_dist = math.abs(close - hl2)
    float baR_SF = (bar_dir_dist / (bar_dist/2)) * 100
    float baR_SF_avg = ta.sma(baR_SF, lookback)
    float baR_SF_thr = get_threshold(thr_opt, thr_inp, baR_SF_avg, lineancy)
    float baR_SF_as_prc_of_thr = get_percentage_of_threshold(baR_SF, baR_SF_thr)
    [baR_SF, baR_SF_avg, baR_SF_thr, baR_SF_as_prc_of_thr]

// @function Calculate Breakout Strength Factor
// @param lookback Lookback period for average
// @param thr_opt Threshold option
// @param thr_inp User threshold input
// @param lineancy Lineancy adjustment
// @param bro_dir Breakout direction
// @param is_inside_bar Is inside bar flag
// @returns [breakout_sf, breakout_avg, breakout_threshold, breakout_prc_of_thr]
export get_breakout_sf(int lookback, string thr_opt, float thr_inp, float lineancy, int bro_dir, bool is_inside_bar) =>
    float bar_dist = high - low
    float HtoH_dist = math.abs(high - high[1])
    float LtoL_dist = math.abs(low - low[1])
    
    float brO_diR_dist = not is_inside_bar ? bro_dir > 0 ? HtoH_dist : bro_dir < 0 ? LtoL_dist : 0 : 0
    
    float brO_SF = timeframe.isintraday and session.isfirstbar_regular ? 0 : (brO_diR_dist / bar_dist) * 100
    float brO_SF_avg = ta.sma(brO_SF, lookback)
    float brO_SF_thr = get_threshold(thr_opt, thr_inp, brO_SF_avg, lineancy)
    float brO_SF_as_prc_of_thr = get_percentage_of_threshold(brO_SF, brO_SF_thr)
    [brO_SF, brO_SF_avg, brO_SF_thr, brO_SF_as_prc_of_thr]

// Helper function to calculate EMA and angle for Always-In SF
// @param src Source data
// @param periods EMA periods
// @param atr_val ATR value for normalization
// @returns [ema, angle] EMA value and angle in degrees
f_get_ema_angle(float src, int periods, float atr_val) =>
    float ema = ta.ema(src, periods)
    float angle = 180.0 * math.atan((ema - ema[1]) / atr_val)
    [ema, angle]

// Helper function to get direction from angle value
// @param value Angle value
// @param t1 First threshold
// @param t2 Second threshold  
// @param t3 Third threshold
// @returns Direction level (-3 to +3)
f_get_direction(float value, float t1, float t2, float t3) =>
    if value > t1
        3
    else if value > t2
        2
    else if value > t3
        1
    else if value >= -t3
        0
    else if value >= -t2
        -1
    else if value >= -t1
        -2
    else
        -3

// @function Calculate Always-In Strength Factor
// @param thr_opt Threshold option
// @param thr_inp User threshold input
// @param lineancy Lineancy adjustment
// @returns [always_in_sf, always_in_avg, always_in_threshold, always_in_prc_of_thr]
export get_always_in_sf(string thr_opt, float thr_inp, float lineancy) =>
    // Constants
    int ATR_PERIOD = 1
    array<float> INTRADAY_WEIGHTS = array.from(50.0, 30.0, 20.0)
    
    // Calculate OHLCC5 and EMAs with angles
    float ohlcc5 = math.avg(high, open, low, close, close)
    float curr_atr = ta.atr(ATR_PERIOD)
    
    [trend, Ao_trend] = f_get_ema_angle(ohlcc5, 1, curr_atr)
    [mean, Ao_mean] = f_get_ema_angle(close, 20, curr_atr)
    [regime, Ao_regime] = f_get_ema_angle(close, 200, curr_atr)
    
    // Calculate directional strengths
    int trend_diR = f_get_direction(Ao_trend, 50, 25, 13)
    int mean_diR = f_get_direction(Ao_mean, 25, 15, 5)
    int regime_diR = f_get_direction(Ao_regime, 15, 10, 5)
    
    // Calculate strength
    float alI_SF = math.avg(
     trend_diR * INTRADAY_WEIGHTS.get(0), 
     mean_diR[1] * INTRADAY_WEIGHTS.get(1), 
     regime_diR[1] * INTRADAY_WEIGHTS.get(2))
    
    float alI_SF_avg = ta.sma(alI_SF, 3)
    float alI_SF_thr = thr_opt == "Disabled" ? 0 : 
     thr_opt == "User Input Threshold" ? 
      alI_SF < 0 ? (thr_inp * -1) + lineancy : thr_inp - lineancy : 
     thr_opt == "Average as Threshold" ? 
      alI_SF_avg < 0 ? alI_SF_avg + lineancy : alI_SF_avg - lineancy : 0
    
    float alI_SF_as_prc_of_thr = math.min(999, get_percentage_of_threshold(alI_SF, alI_SF_thr))
    alI_SF_as_prc_of_thr := 
     alI_SF_as_prc_of_thr < -999 ? -999 :
     alI_SF_as_prc_of_thr > 999 ? 999 : alI_SF_as_prc_of_thr
    
    [alI_SF, alI_SF_avg, alI_SF_thr, alI_SF_as_prc_of_thr]

// @function Calculate Directional Strength Factor (composite)
// @param overlap_prc Overlap SF as percentage of threshold
// @param distance_prc Distance SF as percentage of threshold
// @param body_prc Body SF as percentage of threshold
// @param close_prc Close SF as percentage of threshold  
// @param breakout_prc Breakout SF as percentage of threshold
// @param lookback Lookback period for average
// @param thr_opt Threshold option
// @param thr_inp User threshold input
// @param lineancy Lineancy adjustment
// @returns [directional_sf, directional_avg, directional_threshold, directional_prc_of_thr]
export get_directional_sf(float overlap_prc, float distance_prc, float body_prc, float close_prc, float breakout_prc, 
                         int lookback, string thr_opt, float thr_inp, float lineancy) =>
    float diR_SF = math.avg(
     nz(overlap_prc) < 100 ? nz(overlap_prc) : 0,
     nz(distance_prc) > 100 ? nz(distance_prc) : 0,
     nz(body_prc) > 100 ? nz(body_prc) : 0,
     nz(close_prc) > 100 ? nz(close_prc) : 0,
     nz(breakout_prc) > 100 ? nz(breakout_prc) : 0)
    float diR_SF_avg = ta.sma(diR_SF, lookback)
    float diR_SF_thr = get_threshold(thr_opt, thr_inp, diR_SF_avg, lineancy)
    float diR_SF_as_prc_of_thr = get_percentage_of_threshold(diR_SF, diR_SF_thr)
    [diR_SF, diR_SF_avg, diR_SF_thr, diR_SF_as_prc_of_thr]

// @function Calculate Combined Direction Strength Factor
// @param body_prc Body SF as percentage of threshold
// @param close_prc Close SF as percentage of threshold  
// @param breakout_prc Breakout SF as percentage of threshold
// @param lookback Lookback period for average
// @param thr_opt Threshold option
// @param thr_inp User threshold input
// @param lineancy Lineancy adjustment
// @returns [combined_sf, combined_avg, combined_threshold, combined_prc_of_thr]
export get_combined_direction_sf(float body_prc, float close_prc, float breakout_prc, int lookback, string thr_opt, float thr_inp, float lineancy) =>
    float cmB_diR_SF = math.avg(nz(body_prc), nz(close_prc), nz(breakout_prc))
    float cmB_diR_SF_avg = ta.sma(cmB_diR_SF, lookback)
    float cmB_diR_SF_thr = get_threshold(thr_opt, thr_inp, cmB_diR_SF_avg, lineancy)
    float cmB_diR_SF_as_prc_of_thr = get_percentage_of_threshold(cmB_diR_SF, cmB_diR_SF_thr)
    [cmB_diR_SF, cmB_diR_SF_avg, cmB_diR_SF_thr, cmB_diR_SF_as_prc_of_thr]

// @function Calculate breakout direction based on price action
// @param higH Current high
// @param loW Current low
// @param high_prev Previous high
// @param low_prev Previous low
// @returns [bro_dir, is_outside_bar, is_inside_bar] Breakout direction and bar type flags
export get_breakout_direction(float higH, float loW, float high_prev, float low_prev) =>
    bool HH = higH > high_prev
    bool LH = higH < high_prev
    bool HL = loW > low_prev
    bool LL = loW < low_prev
    
    float HtoH_dist = math.abs(higH - high_prev)
    float LtoL_dist = math.abs(loW - low_prev)
    
    bool outside_bar = false
    bool inside_bar = false
    int bro_dir = 0
    
    if HH and HL
        bro_dir := 1
    else if LL and LH
        bro_dir := -1
    else if not LH and not HL  // Outside Bars
        outside_bar := true
        if HtoH_dist > LtoL_dist
            bro_dir := 1
        else if HtoH_dist < LtoL_dist
            bro_dir := -1
        else
            bro_dir := 0
    else if not HH and not LL  // Inside Bars
        inside_bar := true
        if HtoH_dist > LtoL_dist
            bro_dir := -1
        else if HtoH_dist < LtoL_dist
            bro_dir := 1
        else
            bro_dir := 0
    
    [bro_dir, outside_bar, inside_bar]

// @function Get all strength factors at once (convenience function)
// @param lookback Lookback period for averages
// @param lineancy Lineancy adjustment percentage
// @param dist_thr_opt Distance threshold option
// @param dist_thr_inp Distance threshold input
// @param uni_thr_opt Uniformity threshold option
// @param uni_thr_inp Uniformity threshold input
// @param uni_stddev_mult Uniformity standard deviation multiplier
// @param ovl_thr_opt Overlap threshold option
// @param ovl_thr_inp Overlap threshold input
// @param body_thr_opt Body threshold option
// @param body_thr_inp Body threshold input
// @param close_thr_opt Close threshold option
// @param close_thr_inp Close threshold input
// @param breakout_thr_opt Breakout threshold option
// @param breakout_thr_inp Breakout threshold input
// @param bro_dir Breakout direction
// @param is_inside_bar Is inside bar flag
// @returns Map containing all strength factor results
export get_all_strength_factors(int lookback, float lineancy, 
                               string dist_thr_opt, float dist_thr_inp,
                               string uni_thr_opt, float uni_thr_inp, float uni_stddev_mult,
                               string ovl_thr_opt, float ovl_thr_inp,
                               string body_thr_opt, float body_thr_inp, 
                               string close_thr_opt, float close_thr_inp,
                               string breakout_thr_opt, float breakout_thr_inp,
                               int bro_dir, bool is_inside_bar) =>
    
    // Calculate all strength factors
    [dist_sf, dist_avg, dist_thr, dist_prc] = get_distance_sf(lookback, dist_thr_opt, dist_thr_inp, lineancy)
    [uni_sf, uni_avg, uni_thr, uni_prc] = get_uniformity_sf(lookback, uni_thr_opt, uni_thr_inp, uni_stddev_mult, lineancy)
    [ovl_sf, ovl_avg, ovl_thr, ovl_prc] = get_overlap_sf(lookback, ovl_thr_opt, ovl_thr_inp, lineancy)
    [body_sf, body_avg, body_thr, body_prc] = get_body_sf(lookback, body_thr_opt, body_thr_inp, lineancy)
    [close_sf, close_avg, close_thr, close_prc] = get_close_sf(lookback, close_thr_opt, close_thr_inp, lineancy)
    [breakout_sf, breakout_avg, breakout_thr, breakout_prc] = get_breakout_sf(lookback, breakout_thr_opt, breakout_thr_inp, lineancy, bro_dir, is_inside_bar)
    
    // Create results map
    map<string, float> results = map.new<string, float>()
    
    // Store percentage results (most commonly used)
    map.put(results, "distance_prc", dist_prc)
    map.put(results, "uniformity_prc", uni_prc)
    map.put(results, "overlap_prc", ovl_prc)
    map.put(results, "body_prc", body_prc)
    map.put(results, "close_prc", close_prc)
    map.put(results, "breakout_prc", breakout_prc)
    
    // Store raw values
    map.put(results, "distance_sf", dist_sf)
    map.put(results, "uniformity_sf", uni_sf)
    map.put(results, "overlap_sf", ovl_sf)
    map.put(results, "body_sf", body_sf)
    map.put(results, "close_sf", close_sf)
    map.put(results, "breakout_sf", breakout_sf)
    
    // Store averages
    map.put(results, "distance_avg", dist_avg)
    map.put(results, "uniformity_avg", uni_avg)
    map.put(results, "overlap_avg", ovl_avg)
    map.put(results, "body_avg", body_avg)
    map.put(results, "close_avg", close_avg)
    map.put(results, "breakout_avg", breakout_avg)
    
    // Store thresholds
    map.put(results, "distance_thr", dist_thr)
    map.put(results, "uniformity_thr", uni_thr)
    map.put(results, "overlap_thr", ovl_thr)
    map.put(results, "body_thr", body_thr)
    map.put(results, "close_thr", close_thr)
    map.put(results, "breakout_thr", breakout_thr)
    
    results