//@version=6

// @description: Various utilities for the construction of tables and dashbaords
library('dataTableUtilities', overlay = true)
import AlgoTrader_Pro/formattingUtilities/12 as fu

// CONSTANTS 
//--------------------

// Colors 
color COLOR_TRANSP = color.new(color.gray, 100) // Transparent

// Trend
color COLOR_BEARGR = color.rgb(133, 17, 17) // Bearish Growing
color COLOR_BULLGR = color.green // Bullish Growing
color COLOR_BEARSH = color.red // Bearish Shrinking
color COLOR_BULLSH = color.rgb(27, 96, 29) // Bullish Shrinking
color COLOR_UPTREND = color.new(color.green, 50)
color COLOR_DNTREND = color.new(color.red, 50)

// Trade 
color COLOR_UP = color.green // Color for upward movement
color COLOR_DOWN = color.red // Color for downward movement
color COLOR_NEUTRAL = color.gray // Neutral color
color ENTRY_PRICE_COLOR = color.new(color.orange, 0)
color LIQUIDATION_COLOR = color.new(color.purple, 0)
color TRAILING_STOPLOSS_COLOR = color.new(color.fuchsia, 0)
color PROFIT_COLOR = color.new(color.green, 85)
color LOSS_COLOR = color.new(color.red, 85)
color STOPLOSS_COLOR = color.new(color.red, 0)
color LONG_TRADE_COLOR = color.new(color.green, 0)
color SHORT_TRADE_COLOR = color.new(color.red, 0)

// Table Color 
color HEADER_COLOR = color.black
color HEADER_TEXTCOLOR = color.white
color TITLE_COLOR = color.black // #E05600 //#69952F // AlgoTrader_Pro 
color TITLE_TEXTCOLOR = color.white
color SUBTITLE_COLOR = #515559 // AlgoTrader_Pro
color SUBTITLE_TEXTCOLOR = color.white
color ITEM_COLOR = #76797B // AlgoTrader_Pro
color ITEM_TEXTCOLOR = color.white
color DATA_COLOR = color.white
color DATA_TEXTCOLOR = color.black
color TOTAL_COLOR = #E0DD00 // AlgoTrader_Pro
color TOTAL_TEXTCOLOR = color.black
color COMMENT_COLOR = color.white
color COMMENT_TEXTCOLOR = color.black

string HEADER_TEXTSIZE = size.normal
string HEADER_TEXTALIGN = text.align_center
string TITLE_TEXTSIZE = size.normal
string TITLE_TEXTALIGN = text.align_center
string SUBTITLE_TEXTSIZE = size.auto
string SUBTITLE_TEXTALIGN = text.align_right
string ITEM_TEXTSIZE = size.auto
string ITEM_TEXTALIGN = text.align_right
string DATA_TEXTSIZE = size.auto
string DATA_TEXTALIGN = text.align_center
string COMMENT_TEXTSIZE = size.auto
string COMMENT_TEXTALIGN = text.align_left
string FOOTER_TEXT_HALIGN = text.align_center
string FOOTER_TEXT_SIZE = size.normal

// INPUTS 
//--------------------
var string tableYposInput = input.string('Top', 'Position', inline = 'p', options = ['Top', 'Middle', 'Bottom'])
var string tableXposInput = input.string('Right', '', inline = 'p', options = ['Left', 'Center', 'Right'])
var string table_textSize_input = input.string('Tiny', 'Text Size', options = ['Auto', 'Tiny', 'Small', 'Normal'])

// FUNCTIONS 
//--------------------
get_keyText(key) =>

    keyText_array = str.split(key, '_')
    keyText_array.get(0)

get_dataTable_rows(dataTable_map, title_rows) =>

    keys = map.keys(dataTable_map)
    rows = title_rows

    for key in keys

        keyText = get_keyText(key)

        if keyText == 'item' or keyText == 'footer'
            rows := rows + 1
            rows

    rows

get_colors_by_text(color_in_text) =>

    dataColor = switch color_in_text
        'red' => color.red
        'green' => color.green
        'yellow' => color.yellow
        'orange' => color.orange
        'lime' => color.lime
        'white' => color.white

    textColor = switch dataColor
        color.red => color.white
        color.green => color.white
        color.yellow => color.black
        color.orange => color.black
        color.lime => color.black
        color.white => color.black

    [dataColor, textColor]

get_subtitle_from_key(key) =>

    string subtitle = na
    strings_array = str.split(key, '_')
    if strings_array.size() == 3
        subtitle := strings_array.get(2)
        subtitle

    subtitle

get_new_key_from_key_with_subtitle(key) =>
    strings_array = str.split(key, '_')
    new_key = strings_array.get(0) + '_' + strings_array.get(1)
    new_key

get_dataTable_subtitles(dataTable) =>

    subTitles_array = array.new_string(na)

    for key in dataTable.keys()

        // Get the subtitle 
        subTitle = get_subtitle_from_key(key)

        // Add subtitle to array only if its not duplicated
        subTitle_exists = subTitles_array.includes(subTitle)

        if not subTitle_exists and not na(subTitle)
            subTitles_array.push(subTitle)

    subTitles_array

extract_dataTable_map(dataTable_map, subTitle_to_match) =>

    // Create new map
    dtMap = map.new<string, string>()

    // Loop through all keys 
    for key in dataTable_map.keys()

        // Get subtitle
        subTitle = get_subtitle_from_key(key)

        if not na(subTitle)

            // If the key has the correct subtitle 
            if subTitle_to_match == subTitle

                // Get new key and value
                new_key = get_new_key_from_key_with_subtitle(key)
                value = dataTable_map.get(key)

                // Add contents to map
                if not na(new_key)
                    dtMap.put(new_key, value)

    dtMap

get_footer_color(footer) =>
    footer_color = str.contains(footer, 'LONG') ? COLOR_UP : str.contains(footer, 'SHORT') ? COLOR_DOWN : str.contains(footer, 'NEUTRAL') ? COLOR_NEUTRAL : COLOR_TRANSP

    footer_textColor = color.white

    [footer_color, footer_textColor]

plot_dataTable(dataTable_map, table_title, tableYpos, tableXpos, textSize, includes_multiple_maps, include_comments) =>

    // Only draw the table if its the last bar 
    if barstate.islast

        // Variables 
        var TOTAL_COLUMNS = include_comments ? 3 : 2
        var TITLE_ROWS = 1 // Title + Headers
        var text_size = str.lower(textSize)
        color data_color = DATA_COLOR
        color text_color = DATA_TEXTCOLOR
        color comment_color = COMMENT_COLOR
        color comment_textColor = COMMENT_TEXTCOLOR
        string comment_txt = ''
        
        subTitles_array = array.new_string(na)

        dtMap = map.new<string, string>()


        // Get subtitles
        if dataTable_map.size() > 0

            if includes_multiple_maps
                subTitles_array := get_dataTable_subtitles(dataTable_map)
                subTitles_array
            else
                subTitles_array.push(dataTable_map.get('sub_title'))

        // Get the total rows needed 
        total_rows = get_dataTable_rows(dataTable_map, TITLE_ROWS + subTitles_array.size())

        // If more rows exist 
        if total_rows > 0

            // Generate the table 
            table dataTable = table.new(str.lower(tableYpos) + '_' + str.lower(tableXpos), columns = TOTAL_COLUMNS, rows = total_rows + 3)

            // Title
            //----------
            row = 0
            dataTable.cell(0, row, table_title, bgcolor = TITLE_COLOR, text_color = TITLE_TEXTCOLOR, text_halign = TITLE_TEXTALIGN, text_size = text_size)
            dataTable.merge_cells(0, row, TOTAL_COLUMNS - 1, row)

            // Loop through Sub Titles 
            //--------------------------------------------------
            for subTitle in subTitles_array


                // Sub Title 
                //-----------
                row := row + 1
                subtitle_txt = subTitle
                dataTable.cell(0, row, subtitle_txt, bgcolor = SUBTITLE_COLOR, text_color = SUBTITLE_TEXTCOLOR, text_halign = SUBTITLE_TEXTALIGN, text_size = text_size)
                dataTable.cell(1, row, 'Data', bgcolor = ITEM_COLOR, text_color = ITEM_TEXTCOLOR, text_halign = DATA_TEXTALIGN, text_size = text_size)
                if include_comments
                    dataTable.cell(2, row, 'Comment', bgcolor = ITEM_COLOR, text_color = ITEM_TEXTCOLOR, text_halign = DATA_TEXTALIGN, text_size = text_size)

                // If multiple maps, extract the correct map, otherwise use the available one
                if includes_multiple_maps and not na(dataTable_map)

                    dtMap := extract_dataTable_map(dataTable_map, subTitle)
                    dtMap

                else
                    dtMap := dataTable_map
                    dtMap

                // Get number of rows
                map_total_rows = get_dataTable_rows(dtMap, TITLE_ROWS)
                items = map_total_rows - TITLE_ROWS

                // Plot Items
                for i = 0 to items - 1 by 1

                    row := row + 1

                    if row < total_rows

                        // Item
                        //-----------

                        row_num_txt = str.tostring(i + 1, '#')

                        item_keyName = 'item_' + row_num_txt
                        data_keyName = 'data_' + row_num_txt
                        total_keyName = 'total_' + row_num_txt
                        comment_keyname = 'comment_' + row_num_txt
                        color_keyname = 'color_' + row_num_txt
                        colorComment_keyname = 'colorComment_' + row_num_txt

                        item_txt = dtMap.get(item_keyName)
                        data_txt = dtMap.get(data_keyName)
                        total_txt = dtMap.get(total_keyName)
                        if include_comments
                            comment_txt := dtMap.get(comment_keyname)
                        color_txt = dtMap.get(color_keyname)
                        if include_comments
                            colorComment_txt = dtMap.get(colorComment_keyname)

                        // Get background color if selected
                        if color_txt != '' and data_txt != ''

                            [dc, tc] = get_colors_by_text(color_txt)
                            data_color := dc
                            text_color := tc
                            text_color

                        else
                            data_color := DATA_COLOR
                            text_color := DATA_TEXTCOLOR
                            text_color

                        // Draw table
                        dataTable.cell(0, row, item_txt, bgcolor = ITEM_COLOR, text_color = ITEM_TEXTCOLOR, text_halign = ITEM_TEXTALIGN, text_size = text_size)
                        if not na(data_txt)
                            dataTable.cell(1, row, data_txt, bgcolor = data_color, text_color = text_color, text_halign = DATA_TEXTALIGN, text_size = text_size)
                        if not na(total_txt)
                            dataTable.cell(1, row, total_txt, bgcolor = TOTAL_COLOR, text_color = TOTAL_TEXTCOLOR, text_halign = DATA_TEXTALIGN, text_size = text_size)
                        if include_comments
                            dataTable.cell(2, row, comment_txt, bgcolor = comment_color, text_color = comment_textColor, text_halign = COMMENT_TEXTALIGN, text_size = text_size)

            // Plot Footer
            footer_txt = dataTable_map.get('footer')
            if not na(footer_txt)
                [footer_color, footer_textColor] = get_footer_color(footer_txt)
                dataTable.cell(0, row + 1, footer_txt, bgcolor = footer_color, text_color = footer_textColor, text_halign = FOOTER_TEXT_HALIGN, text_size = text_size)
                dataTable.merge_cells(0, row + 1, TOTAL_COLUMNS - 1, row + 1)

plot_dataTable_without_barstateislast(dataTable_map, table_title, tableYpos, tableXpos, textSize, includes_multiple_maps, include_comments) =>

    // Variables 
    var TOTAL_COLUMNS = include_comments ? 3 : 2
    var TITLE_ROWS = 1 // Title + Headers
    var text_size = str.lower(textSize)
    color data_color = DATA_COLOR
    color text_color = DATA_TEXTCOLOR
    color comment_color = COMMENT_COLOR
    color comment_textColor = COMMENT_TEXTCOLOR
    string comment_txt = ''
    
    subTitles_array = array.new_string(na)

    dtMap = map.new<string, string>()


    // Get subtitles
    if dataTable_map.size() > 0

        if includes_multiple_maps
            subTitles_array := get_dataTable_subtitles(dataTable_map)
            subTitles_array
        else
            subTitles_array.push(dataTable_map.get('sub_title'))

    // Get the total rows needed 
    total_rows = get_dataTable_rows(dataTable_map, TITLE_ROWS + subTitles_array.size())

    // If more rows exist 
    if total_rows > 0

        // Generate the table 
        table dataTable = table.new(str.lower(tableYpos) + '_' + str.lower(tableXpos), columns = TOTAL_COLUMNS, rows = total_rows + 3)

        // Title
        //----------
        row = 0
        dataTable.cell(0, row, table_title, bgcolor = TITLE_COLOR, text_color = TITLE_TEXTCOLOR, text_halign = TITLE_TEXTALIGN, text_size = text_size)
        dataTable.merge_cells(0, row, TOTAL_COLUMNS - 1, row)

        // Loop through Sub Titles 
        //--------------------------------------------------
        for subTitle in subTitles_array


            // Sub Title 
            //-----------
            row := row + 1
            subtitle_txt = subTitle
            dataTable.cell(0, row, subtitle_txt, bgcolor = SUBTITLE_COLOR, text_color = SUBTITLE_TEXTCOLOR, text_halign = SUBTITLE_TEXTALIGN, text_size = text_size)
            dataTable.cell(1, row, 'Data', bgcolor = ITEM_COLOR, text_color = ITEM_TEXTCOLOR, text_halign = DATA_TEXTALIGN, text_size = text_size)
            if include_comments
                dataTable.cell(2, row, 'Comment', bgcolor = ITEM_COLOR, text_color = ITEM_TEXTCOLOR, text_halign = DATA_TEXTALIGN, text_size = text_size)

            // If multiple maps, extract the correct map, otherwise use the available one
            if includes_multiple_maps and not na(dataTable_map)

                dtMap := extract_dataTable_map(dataTable_map, subTitle)
                dtMap

            else
                dtMap := dataTable_map
                dtMap

            // Get number of rows
            map_total_rows = get_dataTable_rows(dtMap, TITLE_ROWS)
            items = map_total_rows - TITLE_ROWS

            // Plot Items
            for i = 0 to items - 1 by 1

                row := row + 1

                if row < total_rows

                    // Item
                    //-----------

                    row_num_txt = str.tostring(i + 1, '#')

                    item_keyName = 'item_' + row_num_txt
                    data_keyName = 'data_' + row_num_txt
                    total_keyName = 'total_' + row_num_txt
                    comment_keyname = 'comment_' + row_num_txt
                    color_keyname = 'color_' + row_num_txt
                    colorComment_keyname = 'colorComment_' + row_num_txt

                    item_txt = dtMap.get(item_keyName)
                    data_txt = dtMap.get(data_keyName)
                    total_txt = dtMap.get(total_keyName)
                    if include_comments
                        comment_txt := dtMap.get(comment_keyname)
                    color_txt = dtMap.get(color_keyname)
                    if include_comments
                        colorComment_txt = dtMap.get(colorComment_keyname)

                    // Get background color if selected
                    if color_txt != '' and data_txt != ''

                        [dc, tc] = get_colors_by_text(color_txt)
                        data_color := dc
                        text_color := tc
                        text_color

                    else
                        data_color := DATA_COLOR
                        text_color := DATA_TEXTCOLOR
                        text_color

                    // Draw table
                    dataTable.cell(0, row, item_txt, bgcolor = ITEM_COLOR, text_color = ITEM_TEXTCOLOR, text_halign = ITEM_TEXTALIGN, text_size = text_size)
                    if not na(data_txt)
                        dataTable.cell(1, row, data_txt, bgcolor = data_color, text_color = text_color, text_halign = DATA_TEXTALIGN, text_size = text_size)
                    if not na(total_txt)
                        dataTable.cell(1, row, total_txt, bgcolor = TOTAL_COLOR, text_color = TOTAL_TEXTCOLOR, text_halign = DATA_TEXTALIGN, text_size = text_size)
                    if include_comments
                        dataTable.cell(2, row, comment_txt, bgcolor = comment_color, text_color = comment_textColor, text_halign = COMMENT_TEXTALIGN, text_size = text_size)

        // Plot Footer
        footer_txt = dataTable_map.get('footer')
        if not na(footer_txt)
            [footer_color, footer_textColor] = get_footer_color(footer_txt)
            dataTable.cell(0, row + 1, footer_txt, bgcolor = footer_color, text_color = footer_textColor, text_halign = FOOTER_TEXT_HALIGN, text_size = text_size)
            dataTable.merge_cells(0, row + 1, TOTAL_COLUMNS - 1, row + 1)


plot_dataTable_multiple_columns(dataTable_map, table_title, tableYpos, tableXpos, textSize, includes_multiple_maps, total_columns) =>

    // Only draw the table if its the last bar 
    if barstate.islast

        // Variables 
        var TITLE_ROWS = 1 // Title + Headers
        var text_size = str.lower(textSize)
        color comment_color = COMMENT_COLOR
        color comment_textColor = COMMENT_TEXTCOLOR

        subTitles_array = array.new_string(na)
        dtMap = map.new<string, string>()


        // Get subtitles
        if dataTable_map.size() > 0

            if includes_multiple_maps
                subTitles_array := get_dataTable_subtitles(dataTable_map)
                subTitles_array
            else
                subTitles_array.push(dataTable_map.get('sub_title'))

        // Get the total rows needed 
        total_rows = get_dataTable_rows(dataTable_map, TITLE_ROWS + subTitles_array.size())

        // If more rows exist 
        if total_rows > 0

            // Generate the table 
            table dataTable = table.new(str.lower(tableYpos) + '_' + str.lower(tableXpos), columns = total_columns, rows = total_rows + 3)

            // Title
            //----------
            row = 0
            dataTable.cell(0, row, table_title, bgcolor = TITLE_COLOR, text_color = TITLE_TEXTCOLOR, text_halign = TITLE_TEXTALIGN, text_size = text_size)
            dataTable.merge_cells(0, row, total_columns - 1, row)

            // Loop through Sub Titles 
            if subTitles_array.size() > 0

                for subTitle in subTitles_array


                    // Sub Title 
                    //-----------
                    row := row + 1
                    subtitle_txt = str.upper(subTitle)
                    dataTable.cell(0, row, subtitle_txt, bgcolor = SUBTITLE_COLOR, text_color = SUBTITLE_TEXTCOLOR, text_halign = SUBTITLE_TEXTALIGN, text_size = text_size)

                    // Headers: Create columns with headers
                    //---------------------------------------
                    for i = 1 to total_columns - 1 by 1
                        header_txt = dataTable_map.get('header' + fu.toNumberString(i, 0))
                        dataTable.cell(i, row, header_txt, bgcolor = ITEM_COLOR, text_color = ITEM_TEXTCOLOR, text_halign = DATA_TEXTALIGN, text_size = text_size)

                    // If multiple maps, extract the correct map, otherwise use the available one
                    if includes_multiple_maps and not na(dataTable_map)

                        dtMap := extract_dataTable_map(dataTable_map, subTitle)
                        dtMap

                    else
                        dtMap := dataTable_map
                        dtMap

                    // Rows: Loop through all rows, creating the rows
                    //--------------------------------------------------

                    map_total_rows = get_dataTable_rows(dtMap, TITLE_ROWS)
                    items = map_total_rows - TITLE_ROWS

                    for r = 0 to items - 1 by 1

                        row := row + 1

                        if row < total_rows

                            row_num_txt = str.tostring(r + 1, '#')

                            // Item
                            //-----------
                            item_keyName = 'item_' + row_num_txt
                            item_txt = dtMap.get(item_keyName)
                            dataTable.cell(0, row, item_txt, bgcolor = ITEM_COLOR, text_color = ITEM_TEXTCOLOR, text_halign = ITEM_TEXTALIGN, text_size = text_size)

                            // Data 
                            //------------
                            for c = 1 to total_columns - 2 by 1

                                // Ger values from keys 
                                data_txt = dtMap.get('data' + fu.toNumberString(c, 0) + '_' + row_num_txt)
                                color_txt = dtMap.get('color' + fu.toNumberString(c, 0) + '_' + row_num_txt)

                                // Get colors from text 
                                [data_color, text_color] = get_colors_by_text(color_txt)

                                // Add column cell
                                dataTable.cell(c, row, data_txt, bgcolor = data_color, text_color = text_color, text_halign = DATA_TEXTALIGN, text_size = text_size)

                            // Comment 
                            //------------
                            comment_keyname = 'comment_' + row_num_txt
                            comment_txt = dtMap.get(comment_keyname)
                            dataTable.cell(total_columns - 1, row, comment_txt, bgcolor = comment_color, text_color = comment_textColor, text_halign = COMMENT_TEXTALIGN, text_size = text_size)

            // Plot Footer
            footer_txt = dataTable_map.get('footer')
            if not na(footer_txt)
                [footer_color, footer_textColor] = get_footer_color(footer_txt)
                dataTable.cell(0, row + 1, footer_txt, bgcolor = footer_color, text_color = footer_textColor, text_halign = FOOTER_TEXT_HALIGN, text_size = text_size)
                dataTable.merge_cells(0, row + 1, total_columns - 1, row + 1)



// EXPORTS 
//--------------------

// @function: 										Generates and shows a data table.
// @param tableMaps_array (map<string, string>): 	Map that contains the table information
// @param title (string): 							Title of the table
// @param tableYpos (string): 						Vertical position of the table
// @param tableXpos (string): 						Horizontal position of the table
// @param textSize (string): 						Text size
// @returns: 										None
export generate_dataTable(map<string, string> dataTable_map, string title, string tableYpos, string tableXpos, string textSize, bool includes_multiple_maps, bool include_comments) =>

    plot_dataTable(dataTable_map, title, tableYpos, tableXpos, textSize, includes_multiple_maps, include_comments)

export generate_dataTable_without_barstateislast(map<string, string> dataTable_map, string title, string tableYpos, string tableXpos, string textSize, bool includes_multiple_maps, bool include_comments) =>

    plot_dataTable_without_barstateislast(dataTable_map, title, tableYpos, tableXpos, textSize, includes_multiple_maps, include_comments)

// @function: 										Generates and shows a data table.
// @param tableMaps_array (map<string, string>): 	Map that contains the table information
// @param title (string): 							Title of the table
// @param tableYpos (string): 						Vertical position of the table
// @param tableXpos (string): 						Horizontal position of the table
// @param textSize (string): 						Text size
// @returns: 										None
export generate_dataTable_multiple_columns(map<string, string> dataTable_map, string title, string tableYpos, string tableXpos, string textSize, bool includes_multiple_maps, int total_columns) =>

    plot_dataTable_multiple_columns(dataTable_map, title, tableYpos, tableXpos, textSize, includes_multiple_maps, total_columns)
