//@version=5
indicator("TF Alignment - Multi TF EMA/MACD/RSI", overlay=true)

// === INPUTS ===
ema1Len = input.int(9, title="EMA Fast")
ema2Len = input.int(21, title="EMA Slow")
rsiLen  = input.int(14, title="RSI Period")

useEMA  = input.bool(true, title="Use EMA")
useRSI  = input.bool(true, title="Use RSI")
useMACD = input.bool(true, title="Use MACD")

showLabels = input.bool(true, title="Show Table Labels")

// === TIMEFRAMES ===
tf1 = input.timeframe("1", title="Timeframe 1")
tf2 = input.timeframe("5", title="Timeframe 2")
tf3 = input.timeframe("15", title="Timeframe 3")
tf4 = input.timeframe("60", title="Timeframe 4")
tf5 = input.timeframe("240", title="Timeframe 5")
tf6 = input.timeframe("D", title="Timeframe 6")

// === FUNCTION TO CHECK ALIGNMENT ON A TIMEFRAME ===
getAlignment(tf) =>
    close_   = request.security(syminfo.tickerid, tf, close)
    emaFast = request.security(syminfo.tickerid, tf, ta.ema(close, ema1Len))
    emaSlow = request.security(syminfo.tickerid, tf, ta.ema(close, ema2Len))
    rsiVal  = request.security(syminfo.tickerid, tf, ta.rsi(close, rsiLen))
    [macdLine, signalLine, _] = request.security(syminfo.tickerid, tf, ta.macd(close, 12, 26, 9))

    emaBull  = close_ > emaFast and emaFast > emaSlow
    rsiBull  = rsiVal > 50
    macdBull = macdLine > signalLine and (macdLine - signalLine) > 0

    total = 0
    bull  = 0
    bear  = 0
    mix   = ""

    if useEMA
        total := total + 1
        bull := bull + (emaBull ? 1 : 0)
        bear := bear + (emaBull ? 0 : 1)
        mix := mix + "EMA: " + (emaBull ? "BUY" : "SELL") + "  "

    if useRSI
        total := total + 1
        bull := bull + (rsiBull ? 1 : 0)
        bear := bear + (rsiBull ? 0 : 1)
        mix := mix + "RSI: " + (rsiBull ? "BUY" : "SELL") + "  "

    if useMACD
        total := total + 1
        bull := bull + (macdBull ? 1 : 0)
        bear := bear + (macdBull ? 0 : 1)
        mix := mix + "MACD: " + (macdBull ? "BUY" : "SELL")

    bull == total ? "BULLISH" :     bear == total ? "BEARISH" :    "MIXED (" + mix + ")"

// === EVALUATE ALIGNMENTS ===
a1 = getAlignment(tf1)
a2 = getAlignment(tf2)
a3 = getAlignment(tf3)
a4 = getAlignment(tf4)
a5 = getAlignment(tf5)
a6 = getAlignment(tf6)

// === MAJORITY SIGNAL FOR FIRST 3 TFs ===
majSignal = a1 == "BULLISH" and a2 == "BULLISH" and a3 == "BULLISH" ? "BULLISH" :            a1 == "BEARISH" and a2 == "BEARISH" and a3 == "BEARISH" ? "BEARISH" : "MIXED"

// === FUNCTION TO ASSIGN COLOR ===
getColor(signal) =>
    signal == "BULLISH" ? color.green :    signal == "BEARISH" ? color.red :    color.rgb(61, 56, 8)

// === DISPLAY TABLE ===
if showLabels
    var table tfTable = table.new(position.top_right, 2, 7, frame_color=color.gray, border_width=1)
    if bar_index % 5 == 0
        // Header
        table.cell(tfTable, 0, 0, "TF", text_color=color.white, bgcolor=color.rgb(103, 28, 201), text_halign=text.align_center)
        table.cell(tfTable, 1, 0, "Signal", text_color=color.white, bgcolor=color.rgb(103, 28, 201), text_halign=text.align_center)
        // Rows
        table.cell(tfTable, 0, 1, tf1, text_color=color.white)
        table.cell(tfTable, 1, 1, a1, bgcolor=getColor(a1), text_color=color.white)
        
        table.cell(tfTable, 0, 2, tf2, text_color=color.white)
        table.cell(tfTable, 1, 2, a2, bgcolor=getColor(a2), text_color=color.white)
        
        table.cell(tfTable, 0, 3, tf3, text_color=color.white)
        table.cell(tfTable, 1, 3, a3, bgcolor=getColor(a3), text_color=color.white)
        
        table.cell(tfTable, 0, 4, tf4, text_color=color.white)
        table.cell(tfTable, 1, 4, a4, bgcolor=getColor(a4), text_color=color.white)
        
        table.cell(tfTable, 0, 5, tf5, text_color=color.white)
        table.cell(tfTable, 1, 5, a5, bgcolor=getColor(a5), text_color=color.white)
        
        table.cell(tfTable, 0, 6, tf6, text_color=color.white)
        table.cell(tfTable, 1, 6, a6, bgcolor=getColor(a6), text_color=color.white)

// === OPTIONAL BACKGROUND COLOR FOR MAJORITY SIGNAL ===
bgcolor(majSignal == "BULLISH" ? color.new(color.red, 85) :        majSignal == "BEARISH" ? color.new(color.green, 85) :        color.new(color.yellow, 85))
