//@version=6
strategy("Universelle Long-Strategie mit Makro-Exit und Flush-Schutz (DE)",
     overlay=true,
     initial_capital=10000,
     commission_type=strategy.commission.percent,
     commission_value=0.10,
     slippage=2,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 01. GRUNDEINSTELLUNGEN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
coreGroup = "01. Grundeinstellungen"
startDatum     = input.time(timestamp("2021-01-01 00:00 +0000"), "Startdatum", group=coreGroup)
startFilter    = input.bool(true, "Startdatum verwenden", group=coreGroup)
voreinstellung = input.string("Custom", "Markt-Voreinstellung", options=["Custom", "Silber", "Gold", "SPX", "BTC"], group=coreGroup)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 02. TRENDMODUL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
trendGroup = "02. Trendmodul"
trendSlowLenInput      = input.int(150, "Langsame EMA", minval=1, group=trendGroup)
recoveryLenInput       = input.int(75, "Recovery EMA", minval=1, group=trendGroup)
trendExitAktiv         = input.bool(true, "Trend-Exit aktiv", group=trendGroup)
trendPufferPct         = input.float(0.0, "Trend-Exit Puffer %", minval=0.0, step=0.1, group=trendGroup)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 03. MAKRO-STRESSMODUL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
macroGroup = "03. Makro-Stressmodul"
macroExitAktiv         = input.bool(true, "Makro-Exit aktiv", group=macroGroup)
stressSymbol1          = input.symbol("TVC:DXY", "Stresssymbol 1", group=macroGroup)
stressLen1             = input.int(50, "EMA-Länge Stresssymbol 1", minval=1, group=macroGroup)
stressLookback1        = input.int(20, "Breakout Lookback 1", minval=2, group=macroGroup)
stressMaxAbove1        = input.float(1.0, "% über EMA für Stress 1", minval=0.0, step=0.1, group=macroGroup)
stressSymbol2          = input.symbol("TVC:US10Y", "Stresssymbol 2", group=macroGroup)
stressLen2             = input.int(50, "EMA-Länge Stresssymbol 2", minval=1, group=macroGroup)
stressLookback2        = input.int(20, "Breakout Lookback 2", minval=2, group=macroGroup)
stressMaxAbove2        = input.float(1.35, "% über EMA für Stress 2", minval=0.0, step=0.05, group=macroGroup)
macroExitBars          = input.int(3, "Stress-Bars bis Exit", minval=1, group=macroGroup)
reEntryBars            = input.int(1, "Ruhige Bars bis Wiedereinstieg", minval=1, group=macroGroup)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 04. FLUSH-SCHUTZ
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
flushGroup = "04. Flush-Schutz"
flushExitAktiv         = input.bool(true, "Flush-Exit aktiv", group=flushGroup)
oneDayFlushPctInput    = input.float(4.5, "1-Tages-Flush %", minval=0.1, step=0.1, group=flushGroup)
twoDayFlushPctInput    = input.float(8.0, "2-Tages-Flush %", minval=0.1, step=0.1, group=flushGroup)
atrLen                 = input.int(14, "ATR-Länge", minval=1, group=flushGroup)
atrShockMultInput      = input.float(1.8, "ATR-Schock Multiplikator", minval=0.1, step=0.1, group=flushGroup)
flushCooldownBars      = input.int(3, "Cooldown-Bars nach Flush", minval=1, group=flushGroup)
volCalmBars            = input.int(2, "Ruhige Volatilitäts-Bars", minval=1, group=flushGroup)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 05. ANZEIGE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
visualGroup = "05. Anzeige"
zeigeTabelle         = input.bool(true, "Status-Tabelle anzeigen", group=visualGroup)
zeigeBenchmark       = input.bool(true, "Eigenes Buy & Hold anzeigen", group=visualGroup)
zeigeBenchmarkPlot   = input.bool(false, "Benchmark im Datenfenster anzeigen", group=visualGroup)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 06. VOREINSTELLUNGEN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
trendSlowLen =
     voreinstellung == "Silber" ? 150 :
     voreinstellung == "Gold"   ? 120 :
     voreinstellung == "SPX"    ? 200 :
     voreinstellung == "BTC"    ? 100 : trendSlowLenInput

recoveryLen =
     voreinstellung == "Silber" ? 75 :
     voreinstellung == "Gold"   ? 55 :
     voreinstellung == "SPX"    ? 100 :
     voreinstellung == "BTC"    ? 50 : recoveryLenInput

oneDayFlushPct =
     voreinstellung == "Silber" ? 4.5 :
     voreinstellung == "Gold"   ? 3.0 :
     voreinstellung == "SPX"    ? 2.5 :
     voreinstellung == "BTC"    ? 7.0 : oneDayFlushPctInput

twoDayFlushPct =
     voreinstellung == "Silber" ? 8.0 :
     voreinstellung == "Gold"   ? 5.0 :
     voreinstellung == "SPX"    ? 4.0 :
     voreinstellung == "BTC"    ? 12.0 : twoDayFlushPctInput

atrShockMult =
     voreinstellung == "Silber" ? 1.8 :
     voreinstellung == "Gold"   ? 1.6 :
     voreinstellung == "SPX"    ? 1.5 :
     voreinstellung == "BTC"    ? 2.2 : atrShockMultInput

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 07. HILFSFUNKTIONEN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_persist(cond, bars) =>
    ok = true
    for i = 0 to bars - 1
        ok := ok and cond[i] == true
    ok

f_ampel_text(wert, gruen, gelb, invertiert) =>
    invertiert ? (wert <= gruen ? "GRÜN" : wert <= gelb ? "GELB" : "ROT") : (wert >= gruen ? "GRÜN" : wert >= gelb ? "GELB" : "ROT")

f_ampel_farbe(wert, gruen, gelb, invertiert) =>
    invertiert ? (wert <= gruen ? color.green : wert <= gelb ? color.orange : color.red) : (wert >= gruen ? color.green : wert >= gelb ? color.orange : color.red)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 08. HANDELSFENSTER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
imHandelsfenster = not startFilter or time >= startDatum

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 09. TRENDSTRUKTUR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
slowEma     = ta.ema(close, trendSlowLen)
recoveryEma = ta.ema(close, recoveryLen)
unterSlow   = close < slowEma * (1.0 - trendPufferPct / 100.0)
trendExit   = trendExitAktiv and unterSlow

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 10. EXTERNE STRESS-SERIEN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
stressClose1    = request.security(stressSymbol1, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
stressEma1      = request.security(stressSymbol1, timeframe.period, ta.ema(close, stressLen1), barmerge.gaps_off, barmerge.lookahead_off)
stressHighPrev1 = request.security(stressSymbol1, timeframe.period, ta.highest(high[1], stressLookback1), barmerge.gaps_off, barmerge.lookahead_off)

stressClose2    = request.security(stressSymbol2, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
stressEma2      = request.security(stressSymbol2, timeframe.period, ta.ema(close, stressLen2), barmerge.gaps_off, barmerge.lookahead_off)
stressHighPrev2 = request.security(stressSymbol2, timeframe.period, ta.highest(high[1], stressLookback2), barmerge.gaps_off, barmerge.lookahead_off)

stressAbovePct1 = stressEma1 != 0 ? (stressClose1 - stressEma1) / stressEma1 * 100.0 : 0.0
stressAbovePct2 = stressEma2 != 0 ? (stressClose2 - stressEma2) / stressEma2 * 100.0 : 0.0

stress1 = macroExitAktiv and stressClose1 > stressEma1 and stressAbovePct1 > stressMaxAbove1 and stressClose1 > stressHighPrev1
stress2 = macroExitAktiv and stressClose2 > stressEma2 and stressAbovePct2 > stressMaxAbove2 and stressClose2 > stressHighPrev2

makroStressJetzt       = stress1 or stress2
makroStressBestaetigt  = f_persist(makroStressJetzt, macroExitBars)

stressRuhig1           = not macroExitAktiv or stressClose1 <= stressEma1 or stressAbovePct1 <= stressMaxAbove1
stressRuhig2           = not macroExitAktiv or stressClose2 <= stressEma2 or stressAbovePct2 <= stressMaxAbove2
makroRuhigJetzt        = stressRuhig1 and stressRuhig2
makroRuhigBestaetigt   = f_persist(makroRuhigJetzt, reEntryBars)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 11. FLUSH-LOGIK
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
oneDayMovePct = close[1] != 0 ? (close / close[1] - 1.0) * 100.0 : 0.0
twoDayMovePct = close[2] != 0 ? (close / close[2] - 1.0) * 100.0 : 0.0

assetAtr      = ta.atr(atrLen)
assetAtrPct   = close != 0 ? assetAtr / close * 100.0 : 0.0
rangePct      = close != 0 ? (high - low) / close * 100.0 : 0.0

oneDayFlush   = oneDayMovePct <= -oneDayFlushPct
twoDayFlush   = twoDayMovePct <= -twoDayFlushPct
atrShock      = rangePct > assetAtrPct * atrShockMult and close < open

flushSchockJetzt = flushExitAktiv and (oneDayFlush or twoDayFlush or atrShock)

barsSeitFlush    = ta.barssince(flushSchockJetzt)
flushZuletzt     = flushExitAktiv and not na(barsSeitFlush) and barsSeitFlush <= flushCooldownBars

volRuhigJetzt    = not flushExitAktiv or rangePct <= assetAtrPct * atrShockMult
volRuhigBestaetigt = f_persist(volRuhigJetzt, volCalmBars)

flushRecoveryBereit = not flushExitAktiv or not flushZuletzt or (close > recoveryEma and volRuhigBestaetigt)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 12. EINSTIEG / AUSSTIEG
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
exitBedingung  = imHandelsfenster and (trendExit or makroStressBestaetigt or flushSchockJetzt)
eintritt       = imHandelsfenster and strategy.position_size == 0 and not trendExit and makroRuhigBestaetigt and flushRecoveryBereit

if strategy.position_size > 0 and exitBedingung
    strategy.close("Long")

if eintritt
    strategy.entry("Long", strategy.long)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 13. EIGENER BUY & HOLD VERGLEICH
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float bhStartPreis = na
var int   bhStartZeit  = na

if imHandelsfenster and na(bhStartPreis)
    bhStartPreis := close
    bhStartZeit  := time

buyHoldReturnPct  = not na(bhStartPreis) ? (close / bhStartPreis - 1.0) * 100.0 : na
strategieReturnPct = (strategy.equity / strategy.initial_capital - 1.0) * 100.0
strategieVsHoldPct = not na(buyHoldReturnPct) ? strategieReturnPct - buyHoldReturnPct : na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 14. PERFORMANCE-METRIKEN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float peakEquity = strategy.initial_capital
var float maxDrawdownPct = 0.0
peakEquity := math.max(peakEquity, strategy.equity)
aktuellerDrawdownPct = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100.0 : 0.0
maxDrawdownPct := math.max(maxDrawdownPct, aktuellerDrawdownPct)

geschlosseneTrades = strategy.closedtrades
gewonneneTrades    = strategy.wintrades
verlustTrades      = strategy.losstrades
trefferquote       = geschlosseneTrades > 0 ? (gewonneneTrades / geschlosseneTrades) * 100.0 : 0.0

gesamtAmpelScore =
     (strategieReturnPct >= 15 ? 2 : strategieReturnPct >= 0 ? 1 : 0) +
     (trefferquote >= 55 ? 2 : trefferquote >= 45 ? 1 : 0) +
     (maxDrawdownPct <= 15 ? 2 : maxDrawdownPct <= 25 ? 1 : 0)

gesamtAmpelText = gesamtAmpelScore >= 5 ? "GRÜN" : gesamtAmpelScore >= 3 ? "GELB" : "ROT"
gesamtAmpelFarbe = gesamtAmpelScore >= 5 ? color.green : gesamtAmpelScore >= 3 ? color.orange : color.red

ampelRenditeText   = f_ampel_text(strategieReturnPct, 15.0, 0.0, false)
ampelRenditeFarbe  = f_ampel_farbe(strategieReturnPct, 15.0, 0.0, false)
ampelTrefferText   = f_ampel_text(trefferquote, 55.0, 45.0, false)
ampelTrefferFarbe  = f_ampel_farbe(trefferquote, 55.0, 45.0, false)
ampelDrawdownText  = f_ampel_text(maxDrawdownPct, 15.0, 25.0, true)
ampelDrawdownFarbe = f_ampel_farbe(maxDrawdownPct, 15.0, 25.0, true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 15. PLOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plot(slowEma, "Langsame EMA", color=color.blue, linewidth=2)
plot(recoveryEma, "Recovery EMA", color=color.orange, linewidth=1)

plotshape(eintritt, title="Long Einstieg", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="Long")
plotshape(exitBedingung and strategy.position_size > 0, title="Exit", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="Exit")
plotshape(flushSchockJetzt, title="Flush Schock", style=shape.diamond, location=location.abovebar, color=color.yellow, size=size.small, text="Flush")

bgcolor(makroStressJetzt ? color.new(color.red, 88) : na, title="Makro Stress Hintergrund")
bgcolor(flushZuletzt ? color.new(color.orange, 88) : na, title="Flush Cooldown Hintergrund")

plot(zeigeBenchmarkPlot ? buyHoldReturnPct : na, "Eigenes Buy & Hold %", color=color.gray, display=display.data_window)
plot(zeigeBenchmarkPlot ? strategieReturnPct : na, "Strategie Rendite %", color=color.green, display=display.data_window)
plot(zeigeBenchmarkPlot ? strategieVsHoldPct : na, "Strategie minus Buy & Hold %", color=color.orange, display=display.data_window)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 16. STATUS-TABELLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var table statusTabelle = table.new(position.top_right, 2, 20, border_width=1)

if zeigeTabelle and barstate.islast
    table.cell(statusTabelle, 0, 0, "Gesamt-Ampel", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 0, gesamtAmpelText, text_color=color.white, bgcolor=gesamtAmpelFarbe)

    table.cell(statusTabelle, 0, 1, "Status", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 1, strategy.position_size > 0 ? "Long" : "Flat", text_color=color.white, bgcolor=strategy.position_size > 0 ? color.green : color.red)

    table.cell(statusTabelle, 0, 2, "Strategie Rendite", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 2, str.tostring(strategieReturnPct, "#.##") + "%", text_color=color.white, bgcolor=color.black)

    table.cell(statusTabelle, 0, 3, "Eigenes Buy & Hold", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 3, zeigeBenchmark and not na(buyHoldReturnPct) ? str.tostring(buyHoldReturnPct, "#.##") + "%" : "na", text_color=color.white, bgcolor=color.black)

    table.cell(statusTabelle, 0, 4, "Strategie vs Halten", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 4, zeigeBenchmark and not na(strategieVsHoldPct) ? str.tostring(strategieVsHoldPct, "#.##") + "%" : "na", text_color=color.white, bgcolor=not na(strategieVsHoldPct) and strategieVsHoldPct >= 0 ? color.green : color.red)

    table.cell(statusTabelle, 0, 5, "BH Start", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 5, not na(bhStartZeit) ? str.format("{0,date,yyyy-MM-dd}", bhStartZeit) : "na", text_color=color.white, bgcolor=color.black)

    table.cell(statusTabelle, 0, 6, "Trend", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 6, trendExit ? "Schwach" : "OK", text_color=color.white, bgcolor=trendExit ? color.red : color.green)

    table.cell(statusTabelle, 0, 7, "Makro Stress", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 7, makroStressJetzt ? "Ja" : "Nein", text_color=color.white, bgcolor=makroStressJetzt ? color.red : color.green)

    table.cell(statusTabelle, 0, 8, "Stress 1", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 8, stress1 ? "Ja" : "Nein", text_color=color.white, bgcolor=stress1 ? color.red : color.green)

    table.cell(statusTabelle, 0, 9, "Stress 2", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 9, stress2 ? "Ja" : "Nein", text_color=color.white, bgcolor=stress2 ? color.red : color.green)

    table.cell(statusTabelle, 0, 10, "Flush Schock", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 10, flushSchockJetzt ? "Ja" : "Nein", text_color=color.white, bgcolor=flushSchockJetzt ? color.orange : color.green)

    table.cell(statusTabelle, 0, 11, "Flush Cooldown", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 11, flushZuletzt ? "Aktiv" : "Nein", text_color=color.white, bgcolor=flushZuletzt ? color.orange : color.green)

    table.cell(statusTabelle, 0, 12, "Wiedereinstieg bereit", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 12, flushRecoveryBereit and makroRuhigBestaetigt ? "Ja" : "Nein", text_color=color.white, bgcolor=flushRecoveryBereit and makroRuhigBestaetigt ? color.green : color.red)

    table.cell(statusTabelle, 0, 13, "Voreinstellung", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 13, voreinstellung, text_color=color.white, bgcolor=color.black)

    table.cell(statusTabelle, 0, 14, "Nettogewinn", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 14, str.tostring(strategy.netprofit, "#.##"), text_color=color.white, bgcolor=color.black)

    table.cell(statusTabelle, 0, 15, "Geschlossene Trades", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 15, str.tostring(geschlosseneTrades), text_color=color.white, bgcolor=color.black)

    table.cell(statusTabelle, 0, 16, "Trefferquote", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 16, str.tostring(trefferquote, "#.##") + "%", text_color=color.white, bgcolor=ampelTrefferFarbe)

    table.cell(statusTabelle, 0, 17, "Max Drawdown", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 17, str.tostring(maxDrawdownPct, "#.##") + "%", text_color=color.white, bgcolor=ampelDrawdownFarbe)

    table.cell(statusTabelle, 0, 18, "Ampel Rendite", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 18, ampelRenditeText, text_color=color.white, bgcolor=ampelRenditeFarbe)

    table.cell(statusTabelle, 0, 19, "Ampel Drawdown", text_color=color.white, bgcolor=color.black)
    table.cell(statusTabelle, 1, 19, ampelDrawdownText, text_color=color.white, bgcolor=ampelDrawdownFarbe)