//@version=6
library("BOS_External_Swings_Lib")

export bosCalc(int minBarsInSwing, int minBOSCount) =>
    var int candleDir = 1
    candleDir := close > open ? 1 : close < open ? -1 : nz(candleDir[1], 1)

    var int consecutiveBars = 1
    if candleDir == candleDir[1]
        consecutiveBars += 1
    else
        consecutiveBars := 1

    bool bullishSwingCandidate = candleDir[1] == 1 and candleDir == -1 and consecutiveBars[1] >= minBarsInSwing
    bool bearishSwingCandidate = candleDir[1] == -1 and candleDir == 1 and consecutiveBars[1] >= minBarsInSwing

    float bullishSwingValueCandidate = math.max(close[1], open)
    float bearishSwingValueCandidate = math.min(close[1], open)

    var bullSwingVals = array.new_float()
    var bullSwingIdxs = array.new_int()
    var bearSwingVals = array.new_float()
    var bearSwingIdxs = array.new_int()

    var float activeBullishSwing = na
    var int   activeBullishBar   = na
    var float activeBearishSwing = na
    var int   activeBearishBar   = na

    var bool bullBOS = false
    var bool bearBOS = false
    var int bullBOSCount = 0
    var int bearBOSCount = 0
    var int lastBOSDirection = 0

    bool debugBullSwing = false
    bool debugBearSwing = false
    float debugBullValue = na
    float debugBearValue = na
    int debugBullBars = na
    int debugBearBars = na

    bool emitBrokenBullLine = false
    bool emitBrokenBearLine = false
    float brokenBullLinePrice = na
    float brokenBearLinePrice = na
    int brokenBullLineBar = na
    int brokenBearLineBar = na

    bullBOS := false
    bearBOS := false

    bool isLocked = not na(activeBullishSwing) and not na(activeBearishSwing)

    if barstate.isconfirmed
        bool hasCandidate = bullishSwingCandidate or bearishSwingCandidate

        if hasCandidate
            if bullishSwingCandidate
                array.push(bullSwingVals, bullishSwingValueCandidate)
                array.push(bullSwingIdxs, bar_index)

                debugBullSwing := true
                debugBullValue := bullishSwingValueCandidate
                debugBullBars := consecutiveBars[1]

                if not isLocked and array.size(bearSwingVals) > 0
                    int lastBearPos = array.size(bearSwingVals) - 1
                    float priorBearVal = array.get(bearSwingVals, lastBearPos)
                    int priorBearBar = array.get(bearSwingIdxs, lastBearPos)

                    if priorBearBar < bar_index
                        activeBullishSwing := bullishSwingValueCandidate
                        activeBullishBar := bar_index
                        activeBearishSwing := priorBearVal
                        activeBearishBar := priorBearBar

            if bearishSwingCandidate
                array.push(bearSwingVals, bearishSwingValueCandidate)
                array.push(bearSwingIdxs, bar_index)

                debugBearSwing := true
                debugBearValue := bearishSwingValueCandidate
                debugBearBars := consecutiveBars[1]

                if not isLocked and array.size(bullSwingVals) > 0
                    int lastBullPos = array.size(bullSwingVals) - 1
                    float priorBullVal = array.get(bullSwingVals, lastBullPos)
                    int priorBullBar = array.get(bullSwingIdxs, lastBullPos)

                    if priorBullBar < bar_index
                        activeBearishSwing := bearishSwingValueCandidate
                        activeBearishBar := bar_index
                        activeBullishSwing := priorBullVal
                        activeBullishBar := priorBullBar

        isLocked := not na(activeBullishSwing) and not na(activeBearishSwing)

        if isLocked
            if close > activeBullishSwing
                emitBrokenBullLine := true
                brokenBullLinePrice := activeBullishSwing
                brokenBullLineBar := activeBullishBar

                emitBrokenBearLine := true
                brokenBearLinePrice := activeBearishSwing
                brokenBearLineBar := activeBearishBar

                if lastBOSDirection == 1
                    bullBOSCount += 1
                else
                    bullBOSCount := 1
                    bearBOSCount := 0

                lastBOSDirection := 1

                if bullBOSCount >= minBOSCount
                    bullBOS := true

                activeBullishSwing := na
                activeBullishBar := na
                activeBearishSwing := na
                activeBearishBar := na

            else if close < activeBearishSwing
                emitBrokenBullLine := true
                brokenBullLinePrice := activeBullishSwing
                brokenBullLineBar := activeBullishBar

                emitBrokenBearLine := true
                brokenBearLinePrice := activeBearishSwing
                brokenBearLineBar := activeBearishBar

                if lastBOSDirection == -1
                    bearBOSCount += 1
                else
                    bearBOSCount := 1
                    bullBOSCount := 0

                lastBOSDirection := -1

                if bearBOSCount >= minBOSCount
                    bearBOS := true

                activeBullishSwing := na
                activeBullishBar := na
                activeBearishSwing := na
                activeBearishBar := na

    [activeBullishSwing, activeBearishSwing, activeBullishBar, activeBearishBar, bullBOS, bearBOS, bullBOSCount, bearBOSCount, bullishSwingCandidate, bearishSwingCandidate, bullishSwingValueCandidate, bearishSwingValueCandidate, debugBullSwing, debugBearSwing, debugBullValue, debugBearValue, debugBullBars, debugBearBars, emitBrokenBullLine, brokenBullLinePrice, brokenBullLineBar, emitBrokenBearLine, brokenBearLinePrice, brokenBearLineBar]