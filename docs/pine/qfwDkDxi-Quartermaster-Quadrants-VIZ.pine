//@version=6
indicator("Quartermaster Quadrants [VIZ]", shorttitle="Quartermaster [VIZ]", overlay=true, max_labels_count=50, max_lines_count=200, max_boxes_count=50)

// ─────────────────────────────────────────────
//                 CORE INPUTS
// ─────────────────────────────────────────────
sessionTF  = input.timeframe("D", "Session Timeframe", group="Core")
showMidExt = input.bool(false, "Show Mid Extensions", group="Core")

// ─────────────────────────────────────────────
//                 EXTENSIONS
// ─────────────────────────────────────────────
showExtensions  = input.bool(false, "Show Session Extensions", group="Extensions")
extPercentInput = input.float(25, "Extension % Beyond High / Low", step=0.1, group="Extensions")

// ─────────────────────────────────────────────
//                   LABELS
// ─────────────────────────────────────────────
showLabels  = input.bool(true, "Show Level Labels", group="Labels")
labelOffset = input.int(3, "Label Offset (bars right)", minval=0, maxval=20, group="Labels")
showLabelPx = input.bool(true, "Include Price in Labels", group="Labels")

// ─────────────────────────────────────────────
//            RAY LEVELS (12.5 / 87.5)
// ─────────────────────────────────────────────
showRays    = input.bool(true, "Show Ray Levels (12.5% / 87.5%)", group="Ray Levels")
raysToTrack = input.int(50, "Sessions to Track", minval=1, maxval=100, group="Ray Levels")

// ─────────────────────────────────────────────
//                BAR COLOURING
// ─────────────────────────────────────────────
biasMode      = input.string("Range (fade extremes)", "Bias Mode", options=["Range (fade extremes)", "Trend (follow extremes)"], group="Bar Colouring")
neutralMids   = input.bool(false, "Neutral Mid Zones (Trend mode)", group="Bar Colouring")
colorAbove75  = input.bool(true, "Color Bars Above 75%", group="Bar Colouring")
colorBelow25  = input.bool(true, "Color Bars Below 25%", group="Bar Colouring")
colorUpperMid = input.bool(true, "Color Bars 50–75%", group="Bar Colouring")
colorLowerMid = input.bool(true, "Color Bars 25–50%", group="Bar Colouring")
colBull       = input.color(#26a69a, "Bullish / Opportunity", group="Bar Colouring")
colBear       = input.color(#ef5350, "Bearish / Caution",     group="Bar Colouring")
colMid        = input.color(#b0bec5, "Mid / Neutral",         group="Bar Colouring")

// ─────────────────────────────────────────────
//            MARKERS & CONFIRMATION
// ─────────────────────────────────────────────
showCrossSmall = input.bool(true, "Show 12.5% / 87.5% Markers", group="Markers")
showCrossMid   = input.bool(true, "Show 37.5% / 62.5% Markers", group="Markers")
crossUseWick   = input.string("Wick & Close (recommended)", "Cross Type", options=["Wick & Close (recommended)", "Close Only"], group="Markers")
showTrendFlips = input.bool(true, "Show Trend Flip Markers (Trend mode)", group="Markers")

// ─────────────────────────────────────────────
//                   ALERTS
// ─────────────────────────────────────────────
enableAlerts = input.bool(false, "Enable Alerts", group="Alerts")

// ─────────────────────────────────────────────
//            LIVE SESSION HIGH / LOW
// ─────────────────────────────────────────────
newSession = ta.change(time(sessionTF)) != 0
var float liveHigh = na
var float liveLow  = na

if newSession
    liveHigh := high
    liveLow  := low
else
    liveHigh := math.max(liveHigh, high)
    liveLow  := math.min(liveLow, low)

// ─────────────────────────────────────────────
//                QUARTILE CALC
// ─────────────────────────────────────────────
calc(_hi, _lo) =>
    r = _hi - _lo
    [_lo + r*0.125, _lo + r*0.25, _lo + r*0.375, _lo + r*0.50, _lo + r*0.625, _lo + r*0.75, _lo + r*0.875]

[m12, s25, m37, s50, m62, s75, m87] = calc(liveHigh, liveLow)

// ─────────────────────────────────────────────
//              SESSION EXTENSIONS
// ─────────────────────────────────────────────
sessRange = liveHigh - liveLow
extFactor = extPercentInput / 100.0
extAbove  = showExtensions and not na(sessRange) and not na(liveHigh) ? liveHigh + sessRange * extFactor : na
extBelow  = showExtensions and not na(sessRange) and not na(liveLow)  ? liveLow  - sessRange * extFactor : na

// ─────────────────────────────────────────────
//    PLOTS (colours fixed → editable in STYLE)
// ─────────────────────────────────────────────
plot(s25, "Session 25%", color=#78909c, linewidth=1)
plot(s50, "Session 50%", color=#cfd8dc, linewidth=2)
plot(s75, "Session 75%", color=#78909c, linewidth=1)

plot(showMidExt ? m12 : na, "12.5%", color=color.new(#78909c, 70))
plot(showMidExt ? m37 : na, "37.5%", color=color.new(#78909c, 70))
plot(showMidExt ? m62 : na, "62.5%", color=color.new(#78909c, 70))
plot(showMidExt ? m87 : na, "87.5%", color=color.new(#78909c, 70))

plot(extAbove, "Session +Ext", color=color.new(#546e7a, 55), linewidth=1)
plot(extBelow, "Session -Ext", color=color.new(#546e7a, 55), linewidth=1)

plot(liveHigh, "Session High", color=#546e7a, linewidth=1)
plot(liveLow,  "Session Low",  color=#546e7a, linewidth=1)

// ─────────────────────────────────────────────
//         DYNAMIC SESSION NAME (labels)
// ─────────────────────────────────────────────
sessName() =>
    tf = sessionTF
    out = tf == "D"  ? "Day" :
          tf == "W"  ? "Week" :
          tf == "M"  ? "Month" :
          tf == "1D" ? "Day" :
          tf == "1W" ? "Week" :
          tf == "1M" ? "Month" :
          str.contains(tf, "D") ? str.replace_all(tf, "D", "") + "D" :
          str.contains(tf, "W") ? str.replace_all(tf, "W", "") + "W" :
          na
    if na(out)
        mins = str.tonumber(tf)
        if not na(mins)
            out := mins >= 60 and mins % 60 == 0 ? str.tostring(mins / 60) + "H" : str.tostring(mins) + "m"
        else
            out := tf
    out

label_txt(_name, _px) =>
    showLabelPx ? _name + "  " + str.tostring(_px, format.mintick) : _name

// ─────────────────────────────────────────────
//      LEVEL LABELS (drawn once, last bar)
// ─────────────────────────────────────────────
var label lblHigh = na
var label lblLow  = na
var label lbl75   = na
var label lbl50   = na
var label lbl25   = na
var label lblExtU = na
var label lblExtD = na

if barstate.islast
    label.delete(lblHigh)
    label.delete(lblLow)
    label.delete(lbl75)
    label.delete(lbl50)
    label.delete(lbl25)
    label.delete(lblExtU)
    label.delete(lblExtD)

    if showLabels and not na(liveHigh)
        nm  = sessName()
        x   = bar_index + labelOffset
        sty = label.style_label_left
        txtCol = color.white

        lblHigh := label.new(x, liveHigh, label_txt(nm + " High", liveHigh), style=sty, color=color.new(#546e7a, 20), textcolor=txtCol, size=size.small)
        lbl75   := label.new(x, s75,      label_txt("75%", s75),            style=sty, color=color.new(#78909c, 20), textcolor=txtCol, size=size.small)
        lbl50   := label.new(x, s50,      label_txt("50%", s50),            style=sty, color=color.new(#607d8b, 10), textcolor=txtCol, size=size.small)
        lbl25   := label.new(x, s25,      label_txt("25%", s25),            style=sty, color=color.new(#78909c, 20), textcolor=txtCol, size=size.small)
        lblLow  := label.new(x, liveLow,  label_txt(nm + " Low", liveLow),  style=sty, color=color.new(#546e7a, 20), textcolor=txtCol, size=size.small)

        if showExtensions and not na(extAbove)
            lblExtU := label.new(x, extAbove, label_txt(nm + " +Ext", extAbove), style=sty, color=color.new(#546e7a, 30), textcolor=txtCol, size=size.small)
        if showExtensions and not na(extBelow)
            lblExtD := label.new(x, extBelow, label_txt(nm + " -Ext", extBelow), style=sty, color=color.new(#546e7a, 30), textcolor=txtCol, size=size.small)

// ─────────────────────────────────────────────
//   RAY LEVELS (12.5% / 87.5% of closed session)
//   Captured at each session boundary from the
//   just-completed session. Each ray extends right
//   until price WICKS its level, then freezes
//   (visual record). Origin marked with a plotshape
//   circle (offset -1 bar to sit on the ray start).
// ─────────────────────────────────────────────
var line[]  rayLines  = array.new_line()
var float[] rayPrices = array.new_float()
var bool[]  rayMitig  = array.new_bool()   // true once wicked (frozen)

// Values used by the origin plotshape (drawn at top level below).
var float originUp = na
var float originDn = na
originUp := na
originDn := na

// On a confirmed new session, the PREVIOUS session's levels are final → make rays.
if showRays and newSession and not na(m12[1]) and not na(m87[1]) and barstate.isconfirmed
    x0 = bar_index[1]
    up = m87[1]
    dn = m12[1]

    lnUp = line.new(x0, up, bar_index, up, xloc=xloc.bar_index, extend=extend.right, color=#ef5350, width=1, style=line.style_solid)
    array.push(rayLines, lnUp)
    array.push(rayPrices, up)
    array.push(rayMitig, false)

    lnDn = line.new(x0, dn, bar_index, dn, xloc=xloc.bar_index, extend=extend.right, color=#26a69a, width=1, style=line.style_solid)
    array.push(rayLines, lnDn)
    array.push(rayPrices, dn)
    array.push(rayMitig, false)

    // Expose origin prices for the plotshape circles this bar.
    originUp := up
    originDn := dn

    // Trim oldest rays beyond the cap (2 rays per session).
    maxRays = raysToTrack * 2
    while array.size(rayLines) > maxRays
        oldLn = array.shift(rayLines)
        line.delete(oldLn)
        array.shift(rayPrices)
        array.shift(rayMitig)

// Each bar: freeze any un-mitigated ray whose level was WICKED.
if showRays and array.size(rayLines) > 0
    for i = 0 to array.size(rayLines) - 1
        if not array.get(rayMitig, i)
            lvl = array.get(rayPrices, i)
            if high >= lvl and low <= lvl
                ln = array.get(rayLines, i)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, bar_index)
                array.set(rayMitig, i, true)

// Origin circles (plotshape → off the label budget).
// offset=-1 shifts each circle one bar left to sit on the ray's true start (bar_index[1]).
plotshape(showRays and not na(originUp) ? originUp : na, title="Ray Origin 87.5%", style=shape.circle, location=location.absolute, size=size.tiny, color=#ffb74d, offset=-1)
plotshape(showRays and not na(originDn) ? originDn : na, title="Ray Origin 12.5%", style=shape.circle, location=location.absolute, size=size.tiny, color=#ffb74d, offset=-1)

// ─────────────────────────────────────────────
//    BAR COLORING (bias-aware gradient)
// ─────────────────────────────────────────────
grad(_v, _l, _h, _minT, _maxT) =>
    span = _h - _l
    n = span == 0 ? 0.0 : (_v - _l) / span
    n2 = math.max(0.0, math.min(1.0, n))
    int(_maxT - n2 * (_maxT - _minT))

isTrend = biasMode == "Trend (follow extremes)"
topCol  = isTrend ? colBull : colBear
botCol  = isTrend ? colBear : colBull

upperMidCol = isTrend ? (neutralMids ? colMid : colBull) : colMid
lowerMidCol = isTrend ? (neutralMids ? colMid : colBear) : colBull

color gradBarCol = na
if close > s75 and colorAbove75
    gradBarCol := color.new(topCol, grad(close, s75, liveHigh, 20, 90))
else if close < s25 and colorBelow25
    gradBarCol := color.new(botCol, grad(close, liveLow, s25, 20, 90))
else if close >= s50 and close <= s75 and colorUpperMid
    gradBarCol := color.new(upperMidCol, grad(close, s50, s75, 60, 90))
else if close >= s25 and close < s50 and colorLowerMid
    gradBarCol := color.new(lowerMidCol, grad(close, s25, s50, 60, 90))

// ─────────────────────────────────────────────
//         UNCONDITIONAL CROSS CALCS
// ─────────────────────────────────────────────
xoverHigh12   = ta.crossover(high, m12)
xunderLow87   = ta.crossunder(low, m87)
xoverClose12  = ta.crossover(close, m12)
xunderClose87 = ta.crossunder(close, m87)
xunderLow37   = ta.crossunder(low, m37)
xoverHigh62   = ta.crossover(high, m62)
xoverClose62  = ta.crossover(close, m62)   // trend-flip up (commit to upper half)
xunderClose37 = ta.crossunder(close, m37)  // trend-flip down (commit to lower half)

useClose = crossUseWick == "Close Only"

// ─────────────────────────────────────────────
//   RANGE MODE MARKERS (mean-reversion)
//   primary → triangles (12.5/87.5 acceptance)
//   secondary → green/red diamonds (37.5/62.5
//   = fade reached the other side / take-profit)
// ─────────────────────────────────────────────
var bool wickAbove12 = false
var bool wickBelow87 = false

if newSession
    wickAbove12 := false
    wickBelow87 := false

eventAbove12 = showCrossSmall and (useClose ? xoverClose12  : xoverHigh12)
eventBelow87 = showCrossSmall and (useClose ? xunderClose87 : xunderLow87)

if eventAbove12
    wickAbove12 := true
if eventBelow87
    wickBelow87 := true

buyConfirmRaw  = wickAbove12 and xoverClose12
sellConfirmRaw = wickBelow87 and xunderClose87

if buyConfirmRaw
    wickAbove12 := false
if sellConfirmRaw
    wickBelow87 := false

rangeBuy  = not isTrend and buyConfirmRaw
rangeSell = not isTrend and sellConfirmRaw

plotshape(rangeBuy,  title="Range Buy (Acceptance > 12.5%)",  style=shape.triangleup,   location=location.belowbar, size=size.small, color=#26a69a)
plotshape(rangeSell, title="Range Sell (Acceptance < 87.5%)", style=shape.triangledown, location=location.abovebar, size=size.small, color=#ef5350)

// Fade-reached-target diamonds:
//  cross DOWN through 37.5% = a short has reached the other side → GREEN (below bar)
//  cross UP   through 62.5% = a long  has reached the other side → RED   (above bar)
crossBelow37 = not isTrend and showCrossMid and xunderLow37
crossAbove62 = not isTrend and showCrossMid and xoverHigh62
plotshape(crossBelow37, title="Range Short Target (< 37.5%)", style=shape.diamond, location=location.belowbar, size=size.tiny, color=#26a69a)
plotshape(crossAbove62, title="Range Long Target (> 62.5%)",  style=shape.diamond, location=location.abovebar, size=size.tiny, color=#ef5350)

// ─────────────────────────────────────────────
//   TREND MODE MARKERS (62.5% / 37.5% flip)
//   primary → diamonds (green/red)
//   secondary (12.5/87.5) → small green/red diamonds
//   one flip per direction (whipsaw control)
// ─────────────────────────────────────────────
var int trendState = 0
if newSession
    trendState := 0

flipUp   = false
flipDown = false

if xoverClose62 and trendState != 1
    trendState := 1
    flipUp := true
if xunderClose37 and trendState != -1
    trendState := -1
    flipDown := true

trendFlipUp   = isTrend and showTrendFlips and flipUp
trendFlipDown = isTrend and showTrendFlips and flipDown

// Primary trend signal → colored DIAMONDS
plotshape(trendFlipUp,   title="Trend Flip Up (Close > 62.5%)",   style=shape.diamond, location=location.belowbar, size=size.small, color=#26a69a)
plotshape(trendFlipDown, title="Trend Flip Down (Close < 37.5%)", style=shape.diamond, location=location.abovebar, size=size.small, color=#ef5350)

// Secondary context (12.5% / 87.5%) → small green/red DIAMONDS, respect Cross Type toggle
trendDiaUp   = isTrend and showCrossSmall and (useClose ? xoverClose12  : xoverHigh12)
trendDiaDown = isTrend and showCrossSmall and (useClose ? xunderClose87 : xunderLow87)
plotshape(trendDiaUp,   title="Trend Context 12.5%", style=shape.diamond, location=location.belowbar, size=size.tiny, color=#26a69a)
plotshape(trendDiaDown, title="Trend Context 87.5%", style=shape.diamond, location=location.abovebar, size=size.tiny, color=#ef5350)

// ─────────────────────────────────────────────
//               FINAL BAR COLOR
// ─────────────────────────────────────────────
barcolor(gradBarCol)

// ─────────────────────────────────────────────
//                   ALERTS
//   All alerts fire on CONFIRMED bar close only.
// ─────────────────────────────────────────────
bullSignal = barstate.isconfirmed and (rangeBuy or trendFlipUp)
bearSignal = barstate.isconfirmed and (rangeSell or trendFlipDown)

if enableAlerts and bullSignal
    msg = isTrend ? "TREND FLIP UP — close committed above 62.5%" : "RANGE BUY — acceptance above 12.5%"
    alert(msg + " | " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if enableAlerts and bearSignal
    msg = isTrend ? "TREND FLIP DOWN — close committed below 37.5%" : "RANGE SELL — acceptance below 87.5%"
    alert(msg + " | " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

alertcondition(bullSignal, "Bullish Signal", "Session Quartiles bullish signal (confirmed close)")
alertcondition(bearSignal, "Bearish Signal", "Session Quartiles bearish signal (confirmed close)")
