// CREDIT
// The order block detection and the retest condition used as the trigger of this
// study are adapted from "Power Order Blocks [ChartPrime]" by ChartPrime,
// published open source under the Mozilla Public License 2.0:
// https://www.tradingview.com/script/qN6ElREt-Power-Order-Blocks-ChartPrime/
// Full credit to ChartPrime for that detection method. Everything else, the
// survival study, the random baseline, the break-even reference and the table,
// is original work.
//
// WHAT THIS ADDS TO THE ORIGINAL
// The original draws order blocks and marks retests. It never answers the only
// question that decides whether you can trade them: when price taps an order
// block, does a stop of a given size survive long enough for the trade to work,
// and does that beat entering at a random moment on the same chart?

//@version=6
indicator("Order Block Stop Survival Study", shorttitle="OB Stop Survival", overlay=true, max_boxes_count=500, max_bars_back=2000)

// ============================== Study ========================================
grpStudy   = "Study"
maxFwd     = input.int(100, "Max bars to resolve", group=grpStudy, minval=5, maxval=500, tooltip="A setup that reaches neither the stop nor the target within this many bars is counted as unresolved.")
targetR    = input.float(1.0, "Target (R multiple of stop)", group=grpStudy, minval=0.1, step=0.1, tooltip="1R means price must travel the stop distance in your favour before the stop is hit. Break-even for 1R is 50 percent, for 2R it is 33.3, for 3R it is 25.")
stepBars   = input.int(15, "Random baseline: sample every N bars", group=grpStudy, minval=1, maxval=500, tooltip="The comparison column. Lower is more samples but heavier. Raise it if the script times out.")
minSetups  = input.int(30, "Minimum setups before showing results", group=grpStudy, minval=1, tooltip="Below this, the table warns instead of showing percentages built on too little data.")

// ========================= Order blocks (ChartPrime) =========================
grpOB      = "Order blocks"
dispThresh = input.float(0.5, "Displacement multiplier", group=grpOB, step=0.1, minval=0.0, tooltip="From the original script: how much larger the displacement candle must be to validate an order block.")
maxBlocks  = input.int(10, "Active blocks kept per side", group=grpOB, minval=1, maxval=50)
minGap     = input.int(10, "Minimum bars between two retests", group=grpOB, minval=1, tooltip="From the original script: prevents one long stay inside a zone from being counted as many separate setups.")
firstTouchOnly = input.bool(true, "First touch of a block only", group=grpOB, tooltip="The tradeable setup is the first time price comes back to a fresh block. Turn this off to also count later touches of an already used zone, which is a useful comparison in itself.")
showBlocks = input.bool(true, "Draw the order blocks", group=grpOB)

// ========================== Stop distances ===================================
grpStop    = "Stop distances"
distMode   = input.string("ATR multiples", "Distance mode", group=grpStop, options=["ATR multiples", "Absolute price"])
atrLen     = input.int(14, "ATR length", group=grpStop, minval=1)
d1         = input.float(0.5, "Distance 1", group=grpStop, minval=0.0001, step=0.1)
d2         = input.float(1.0, "Distance 2", group=grpStop, minval=0.0001, step=0.1)
d3         = input.float(1.5, "Distance 3", group=grpStop, minval=0.0001, step=0.1)
d4         = input.float(2.0, "Distance 4", group=grpStop, minval=0.0001, step=0.1)
d5         = input.float(3.0, "Distance 5", group=grpStop, minval=0.0001, step=0.1)
dMine      = input.float(0.8, "Your own stop", group=grpStop, minval=0.0001, step=0.1, tooltip="The distance you actually use. Shown as a highlighted row so you can place yourself among the others.")

// ============================ Instrument =====================================
grpInst    = "Instrument"
pipSize    = input.float(0.1, "Pip size", group=grpInst, minval=0.0, tooltip="Gold = 0.1, forex majors = 0.0001, JPY pairs = 0.01. Set 0 to hide pips (crypto).")

// ============================= Display =======================================
grpUI      = "Display"
tblPos     = input.string("Top right", "Table position", group=grpUI, options=["Top right", "Top left", "Middle right", "Middle left", "Bottom right", "Bottom left"])

// ============================== Style ========================================
grpStyle   = "Style"
colAccent  = input.color(#26d0a8, "Header",            group=grpStyle)
colMine    = input.color(#00d1ff, "Your own stop row", group=grpStyle)
colGood    = input.color(#26a69a, "Edge in favour",    group=grpStyle)
colBad     = input.color(#ef5350, "Edge against",      group=grpStyle)
colBg      = input.color(#0d1117, "Table background",  group=grpStyle)
colTxt     = input.color(#e6edf3, "Text",              group=grpStyle)
bullCol    = input.color(#1bd37a, "Bullish block",     group=grpStyle)
bearCol    = input.color(#bc14e6, "Bearish block",     group=grpStyle)
txtSizeIn  = input.string("Small", "Text size", group=grpStyle, options=["Tiny", "Small", "Normal", "Large"])
borderW    = input.int(1, "Border width", group=grpStyle, minval=0, maxval=4)

tSize = txtSizeIn == "Tiny" ? size.tiny : txtSizeIn == "Small" ? size.small : txtSizeIn == "Normal" ? size.normal : size.large

// ================= Detection des order blocks, d'apres ChartPrime ============
// Un order block haussier : une bougie baissiere suivie d'une bougie de
// deplacement haussiere qui cloture au-dessus du plus haut precedent, avec un
// corps plus grand que dispThresh fois l'amplitude precedente. Miroir en baissier.
type OB
    float top
    float btm
    int   left
    int   touches
    box   bx

var OB[] bullBlocks = array.new<OB>()
var OB[] bearBlocks = array.new<OB>()
var int  lastBullRetest = na
var int  lastBearRetest = na

bool isBearishCandle = close[1] < open[1]
bool isBullishDisp   = close > open and close > high[1] and (close - open) > (high[1] - low[1]) * dispThresh
bool bullOB          = isBearishCandle and isBullishDisp

bool isBullishCandle = close[1] > open[1]
bool isBearishDisp   = close < open and close < low[1] and (open - close) > (high[1] - low[1]) * dispThresh
bool bearOB          = isBullishCandle and isBearishDisp

bool bullRetestRaw = false
bool bearRetestRaw = false

// Mise a jour des blocs haussiers : invalidation puis detection du retest
int nBull = array.size(bullBlocks)
if nBull > 0
    for i = nBull - 1 to 0
        OB ob = array.get(bullBlocks, i)
        if close < ob.btm
            if not na(ob.bx)
                box.delete(ob.bx)
            array.remove(bullBlocks, i)
        else
            if not na(ob.bx)
                box.set_right(ob.bx, bar_index + 10)
            if low[1] <= ob.top and low >= ob.top and bar_index > ob.left
                ob.touches += 1
                // Seule la PREMIERE touche est un setup : c'est celle que le
                // trader prend. Les suivantes portent sur une zone deja usee.
                if ob.touches == 1 or not firstTouchOnly
                    bullRetestRaw := true

int nBear = array.size(bearBlocks)
if nBear > 0
    for i = nBear - 1 to 0
        OB ob = array.get(bearBlocks, i)
        if close > ob.top
            if not na(ob.bx)
                box.delete(ob.bx)
            array.remove(bearBlocks, i)
        else
            if not na(ob.bx)
                box.set_right(ob.bx, bar_index + 10)
            if high[1] >= ob.btm and high <= ob.btm and bar_index > ob.left
                ob.touches += 1
                if ob.touches == 1 or not firstTouchOnly
                    bearRetestRaw := true

// Filtre d'espacement, repris de l'original : une longue stagnation dans la zone
// ne doit pas compter comme une serie de setups distincts.
bool bullRetest = bullRetestRaw and (na(lastBullRetest) or bar_index - lastBullRetest >= minGap)
bool bearRetest = bearRetestRaw and (na(lastBearRetest) or bar_index - lastBearRetest >= minGap)
if bullRetest
    lastBullRetest := bar_index
if bearRetest
    lastBearRetest := bar_index

// Creation des nouveaux blocs
if bullOB
    bx = showBlocks ? box.new(bar_index[1], high[1], bar_index + 10, low[1], border_color=color.new(bullCol, 60), border_style=line.style_dashed, bgcolor=color.new(bullCol, 88)) : na
    array.push(bullBlocks, OB.new(high[1], low[1], bar_index, 0, bx))
    if array.size(bullBlocks) > maxBlocks
        OB old = array.shift(bullBlocks)
        if not na(old.bx)
            box.delete(old.bx)

if bearOB
    bx = showBlocks ? box.new(bar_index[1], high[1], bar_index + 10, low[1], border_color=color.new(bearCol, 60), border_style=line.style_dashed, bgcolor=color.new(bearCol, 88)) : na
    array.push(bearBlocks, OB.new(high[1], low[1], bar_index, 0, bx))
    if array.size(bearBlocks) > maxBlocks
        OB old = array.shift(bearBlocks)
        if not na(old.bx)
            box.delete(old.bx)

// ============================== Etude ========================================
atrSeries = ta.atr(atrLen)

var float[] mult = array.from(d1, d2, d3, d4, d5, dMine)

// Deux echantillons : sur retest d'order block, et au hasard pour comparaison
var int[] tSurv  = array.new_int(6, 0)
var int[] tStop  = array.new_int(6, 0)
var int[] tUnres = array.new_int(6, 0)
var int[] bSurv  = array.new_int(6, 0)
var int[] bStop  = array.new_int(6, 0)
var int[] bUnres = array.new_int(6, 0)
var int   nTrig  = 0
var int   nBase  = 0
// Repartition du declencheur : si un sens domine largement dans un marche qui
// tend, une partie de l'ecart mesure la tendance et non l'order block. On
// affiche le detail pour que le lecteur puisse en juger lui-meme.
var int   nTrigL = 0
var int   nTrigS = 0

// Convention volontairement CONSERVATRICE : si une meme bougie touche le stop et
// l'objectif, on compte le stop. On ne peut pas savoir lequel est venu en premier
// a l'interieur d'une bougie, et surestimer la survie serait malhonnete.
resolve(float entry, float dist, bool isLong, int fwd) =>
    stopLvl = isLong ? entry - dist : entry + dist
    tgtLvl  = isLong ? entry + targetR * dist : entry - targetR * dist
    int outcome = 0
    for i = fwd - 1 to 0
        hitStop = isLong ? low[i] <= stopLvl : high[i] >= stopLvl
        hitTgt  = isLong ? high[i] >= tgtLvl : low[i] <= tgtLvl
        if hitStop
            outcome := -1
            break
        if hitTgt
            outcome := 1
            break
    outcome

// On ne juge que des setups dont l'issue est entierement dans le passe : on
// regarde ce qui s'est passe il y a maxFwd bougies. Aucun repaint possible.
enoughHist = bar_index > maxFwd + atrLen + 5
baseD      = distMode == "ATR multiples" ? nz(atrSeries[maxFwd], atrSeries) : 1.0
entryPast  = close[maxFwd]

// Pine interdit a une fonction de modifier une variable globale : les compteurs
// nTrig et nBase sont donc incrementes par l'appelant, pas ici. Les tableaux,
// eux, sont des objets : array.set les modifie sans reaffecter la variable.
record(bool isTrig, bool isLong) =>
    for k = 0 to 5
        dist = array.get(mult, k) * baseD
        if dist > 0
            r = resolve(entryPast, dist, isLong, maxFwd)
            if isTrig
                if r == 1
                    array.set(tSurv, k, array.get(tSurv, k) + 1)
                else if r == -1
                    array.set(tStop, k, array.get(tStop, k) + 1)
                else
                    array.set(tUnres, k, array.get(tUnres, k) + 1)
            else
                if r == 1
                    array.set(bSurv, k, array.get(bSurv, k) + 1)
                else if r == -1
                    array.set(bStop, k, array.get(bStop, k) + 1)
                else
                    array.set(bUnres, k, array.get(bUnres, k) + 1)

if enoughHist and baseD > 0
    // Declencheur : un retest d'order block, long sur bloc haussier, short sur baissier
    if bullRetest[maxFwd]
        nTrig  += 1
        nTrigL += 1
        record(true, true)
    if bearRetest[maxFwd]
        nTrig  += 1
        nTrigS += 1
        record(true, false)
    // Comparaison : un moment quelconque, les deux sens
    if bar_index % stepBars == 0
        nBase += 2
        record(false, true)
        record(false, false)

// ============================== Tableau ======================================
tblPosition = tblPos == "Top right" ? position.top_right : tblPos == "Top left" ? position.top_left : tblPos == "Middle right" ? position.middle_right : tblPos == "Middle left" ? position.middle_left : tblPos == "Bottom right" ? position.bottom_right : position.bottom_left

var table t = table.new(tblPosition, 4, 11, border_width=borderW)

rate(int part, int total) =>
    total <= 0 ? float(na) : 100.0 * part / total

fmt(float v) =>
    na(v) ? "-" : str.tostring(v, "#.#") + " %"

label_dist(float m, float base) =>
    unit = distMode == "ATR multiples" ? str.tostring(m, "#.##") + " ATR" : str.tostring(m, format.mintick)
    pips = pipSize > 0 ? "  (" + str.tostring(m * base / pipSize, "#") + " pips)" : ""
    unit + pips

if barstate.islast
    baseNow  = distMode == "ATR multiples" ? nz(atrSeries, 0.0) : 1.0
    breakEven = 100.0 / (1.0 + targetR)
    enough   = nTrig >= minSetups and nBase >= minSetups

    table.cell(t, 0, 0, "OB STOP SURVIVAL", bgcolor=colAccent, text_color=color.white, text_size=tSize)
    table.cell(t, 1, 0, "On OB retest",     bgcolor=colAccent, text_color=color.white, text_size=tSize)
    table.cell(t, 2, 0, "Random entry",     bgcolor=colAccent, text_color=color.white, text_size=tSize)
    table.cell(t, 3, 0, "Edge",             bgcolor=colAccent, text_color=color.white, text_size=tSize)

    for k = 0 to 5
        row    = k + 1
        isMine = k == 5
        totT   = array.get(tSurv, k) + array.get(tStop, k) + array.get(tUnres, k)
        totB   = array.get(bSurv, k) + array.get(bStop, k) + array.get(bUnres, k)
        rT     = rate(array.get(tSurv, k), totT)
        rB     = rate(array.get(bSurv, k), totB)
        edge   = (na(rT) or na(rB)) ? float(na) : rT - rB
        bg     = isMine ? color.new(colMine, 78) : colBg
        txtC   = isMine ? colMine : colTxt
        edgeC  = na(edge) ? txtC : edge >= 0 ? colGood : colBad
        lbl    = (isMine ? "Your stop  " : "") + label_dist(array.get(mult, k), baseNow)
        edgeS  = (not enough or na(edge)) ? "-" : (edge >= 0 ? "+" : "") + str.tostring(edge, "#.#")
        table.cell(t, 0, row, lbl, bgcolor=bg, text_color=txtC, text_size=tSize)
        table.cell(t, 1, row, enough ? fmt(rT) : "-", bgcolor=bg, text_color=txtC, text_size=tSize)
        table.cell(t, 2, row, enough ? fmt(rB) : "-", bgcolor=bg, text_color=txtC, text_size=tSize)
        table.cell(t, 3, row, edgeS, bgcolor=bg, text_color=edgeC, text_size=tSize)

    // Reference : le taux de reussite qui met simplement a l'equilibre
    beTxt = "Break-even at " + str.tostring(targetR, "#.##") + "R = " + str.tostring(breakEven, "#.#") + " %"
    table.cell(t, 0, 7, beTxt, bgcolor=colBg, text_color=colTxt, text_size=tSize)
    table.cell(t, 1, 7, "", bgcolor=colBg, text_size=tSize)
    table.cell(t, 2, 7, "", bgcolor=colBg, text_size=tSize)
    table.cell(t, 3, 7, "", bgcolor=colBg, text_size=tSize)

    foot = enough ? str.tostring(nTrig) + " retests (" + str.tostring(nTrigL) + " long / " + str.tostring(nTrigS) + " short) vs " + str.tostring(nBase) + " random entries" : "Not enough history yet: " + str.tostring(nTrig) + " retests and " + str.tostring(nBase) + " random, " + str.tostring(minSetups) + " of each needed"
    table.cell(t, 0, 8, foot, bgcolor=colBg, text_color=color.new(colTxt, enough ? 45 : 0), text_size=tSize)
    table.cell(t, 1, 8, "", bgcolor=colBg, text_size=tSize)
    table.cell(t, 2, 8, "", bgcolor=colBg, text_size=tSize)
    table.cell(t, 3, 8, "", bgcolor=colBg, text_size=tSize)

    table.cell(t, 0, 9, "Order block detection adapted from Power Order Blocks by ChartPrime", bgcolor=colBg, text_color=color.new(colTxt, 60), text_size=size.tiny)
    table.cell(t, 1, 9, "", bgcolor=colBg, text_size=size.tiny)
    table.cell(t, 2, 9, "", bgcolor=colBg, text_size=size.tiny)
    table.cell(t, 3, 9, "", bgcolor=colBg, text_size=size.tiny)

    table.cell(t, 0, 10, "Spread, slippage and commissions are ignored", bgcolor=colBg, text_color=color.new(colTxt, 60), text_size=size.tiny)
    table.cell(t, 1, 10, "", bgcolor=colBg, text_size=size.tiny)
    table.cell(t, 2, 10, "", bgcolor=colBg, text_size=size.tiny)
    table.cell(t, 3, 10, "", bgcolor=colBg, text_size=size.tiny)
