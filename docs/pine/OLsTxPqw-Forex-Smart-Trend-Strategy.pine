//@version=6
strategy("Forex Smart Trend Strategy", overlay=true, initial_capital=10000, pyramiding=0)

// ===== INPUTS =====
fastEMA = input.int(50, "Fast EMA")
slowEMA = input.int(200, "Slow EMA")
stATR = input.int(10, "Supertrend ATR")
stFactor = input.float(3.0, "Supertrend Factor")
adxLen = input.int(14, "ADX Length")
atrLen = input.int(14, "ATR Length")
rr = input.float(2.0, "Risk Reward Ratio")

// ===== INDICATORS =====
ema50 = ta.ema(close, fastEMA)
ema200 = ta.ema(close, slowEMA)

[st, dir] = ta.supertrend(stFactor, stATR)

plusDM = math.max(high - high[1], 0)
minusDM = math.max(low[1] - low, 0)

plusDM := plusDM > minusDM ? plusDM : 0
minusDM := minusDM > plusDM ? minusDM : 0

tr = ta.rma(ta.tr(true), adxLen)
plusDI = 100 * ta.rma(plusDM, adxLen) / tr
minusDI = 100 * ta.rma(minusDM, adxLen) / tr
dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLen)

atr = ta.atr(atrLen)

// ===== CONDITIONS =====
longTrend = ema50 > ema200
shortTrend = ema50 < ema200

buySignal =
     barstate.isconfirmed and
     longTrend and
     dir < 0 and
     adx > 25

sellSignal =
     barstate.isconfirmed and
     shortTrend and
     dir > 0 and
     adx > 25

// ===== ENTRIES =====
if buySignal and strategy.position_size <= 0
    strategy.entry("BUY", strategy.long)

if sellSignal and strategy.position_size >= 0
    strategy.entry("SELL", strategy.short)

// ===== EXITS =====
longSL = strategy.position_avg_price - atr * 1.5
longTP = strategy.position_avg_price + atr * rr * 1.5

shortSL = strategy.position_avg_price + atr * 1.5
shortTP = strategy.position_avg_price - atr * rr * 1.5

strategy.exit("BUY EXIT", from_entry="BUY", stop=longSL, limit=longTP)
strategy.exit("SELL EXIT", from_entry="SELL", stop=shortSL, limit=shortTP)

// ===== PLOTS =====
plot(ema50, color=color.orange, linewidth=2, title="EMA 50")
plot(ema200, color=color.blue, linewidth=2, title="EMA 200")
plot(st, color=dir < 0 ? color.lime : color.red, linewidth=2, title="Supertrend")

plotshape(buySignal,
     style=shape.triangleup,
     location=location.belowbar,
     color=color.green,
     size=size.small,
     title="BUY")

plotshape(sellSignal,
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     size=size.small,
     title="SELL")

// ===== ALERTS =====
alertcondition(buySignal, title="BUY", message="Forex BUY Signal")
alertcondition(sellSignal, title="SELL", message="Forex SELL Signal")