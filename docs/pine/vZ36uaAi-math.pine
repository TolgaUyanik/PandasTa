export vzo_wma(series float src, int len) => 
	dvol = math.sign(src - src[2]) * volume //chicken dinner
	dvma = ta.wma(dvol, len) //ema
	vma = ta.sma(volume, len)
	VZO_1 = vma != 0 ? 100 * dvma / vma : 0



// @function alma2: Arnaud Legoux Moving Average 2 accepts sigma as series float
// @param series Input series
// @param windowsize Size of the moving average window
// @param offset Offset parameter
// @param sigma Sigma parameter
// @returns ALMA value
export alma2(series float series,int  windowsize, float offset, series float sigma) =>
    m = offset * (windowsize - 1)
    //m = math.floor(offset * (windowsize - 1)) // Used as m when math.floor=true
    s = windowsize / sigma
    norm = 0.0
    sum = 0.0
    for i = 0 to windowsize - 1
        weight = math.exp(-1 * math.pow(i - m, 2) / (2 * math.pow(s, 2)))
        norm := norm + weight
        sum := sum + series[windowsize - i - 1] * weight
    sum / norm
//Wavelet


// @function Wavelet Wavelet Transform: aproxiates srt using Discrete wavelet transform.
// @param len Length parameter for ALMA
// @param src Source series
// @returns Wavelet-transformed series
export Wavelet(series float src = close, int len = 16 , float  offset = 0.77 , float sigma = 6)=>
 	r = src * (1 + ta.alma(ta.change(src)/ src, len, offset, sigma))
	

// @function Wavelet_std: aproxiates srt using Discrete wavelet transform with standard deviation as a magnitude.
// @param len Length parameter for ALMA
// @param offset Offset parameter for ALMA
// @param mag Magnitude parameter for standard deviation
// @param src Source series
// @returns Wavelet-transformed series
export Wavelet_std(series float src = close  , int len = 20, float offset = 0.5, int mag = 2)=>
	std_dev = ta.stdev(src, len ,true)
	sigma_for_alma = std_dev * float(mag)
	alm = alma2(ta.change(src)/ src, len, offset, sigma_for_alma)
	src * (alm + 1)





// @function LFT: Discrete Laplace transform over Nx set of close prices
// @param x close price
// @param y 0 
// @param Nx number of close prices in calculations
// @param _dir Degree rotation on 2d chart
// @param a laplace coeficient
LFT(x, y, Nx, _dir, a) =>  
    float _arg = 0.0
    float _cos = 0.0
    float _sin = 0.0
    float xArr_i = 0.0
    float yArr_i = 0.0
    xArr = array.new_float(array.size(x))
    yArr = array.new_float(array.size(y))

    for i = 0 to Nx - 1 by 1
        xArr_i := 0.0
        yArr_i := 0.0
        kx = float(i) / float(Nx)
        _arg := -_dir * 2 * math.pi * kx
        for k = 0 to Nx - 1 by 1
            _cos := math.cos(k * _arg) * math.exp(k*a)
            _sin := math.sin(k * _arg) * math.exp(k*a)
            xArr_i += array.get(x, k) * _cos - array.get(y, k) * _sin
            yArr_i += array.get(x, k) * _sin + array.get(y, k) * _cos
            yArr_i
        array.set(xArr, i, xArr_i)
        array.set(yArr, i, yArr_i)

    if _dir == 1
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i) / float(Nx))
            array.set(y, i, array.get(yArr, i) / float(Nx))
    else
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i)/ float(_dir))
            array.set(y, i, array.get(yArr, i)/ float(_dir))


// @function LFTSUM: Discrete Laplace transform over Nx set of close prices sum of 2 Laplace exponent components
// @param x close price
// @param y 0 
// @param Nx number of close prices in calculations
// @param _dir Degree rotation on 2d chart
// @param a laplace coeficient
// @param b second laplace coeficient
LFTSUM(x, y, Nx, _dir, a, b) =>  
    float _arg = 0.0
    float _cos = 0.0
    float _sin = 0.0
    float xArr_i = 0.0
    float yArr_i = 0.0
    xArr = array.new_float(array.size(x))
    yArr = array.new_float(array.size(y))

    for i = 0 to Nx - 1 by 1
        xArr_i := 0.0
        yArr_i := 0.0
        kx = float(i) / float(Nx)
        _arg := -_dir * 2 * math.pi * kx
        for k = 0 to Nx - 1 by 1
            _cos := (math.cos(k * _arg) * math.exp(k*a) + math.cos(k * _arg) * math.exp(k*b) )/2
            _sin := (math.sin(k * _arg) * math.exp(k*a) + math.sin(k * _arg) * math.exp(k*b))/2
            xArr_i += array.get(x, k) * _cos - array.get(y, k) * _sin
            yArr_i += array.get(x, k) * _sin + array.get(y, k) * _cos
            yArr_i
        array.set(xArr, i, xArr_i)
        array.set(yArr, i, yArr_i)

    if _dir == 1
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i) / float(Nx))
            array.set(y, i, array.get(yArr, i) / float(Nx))
    else
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i)/ float(_dir))
            array.set(y, i, array.get(yArr, i)/ float(_dir))


