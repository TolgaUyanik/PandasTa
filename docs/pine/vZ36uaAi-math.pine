        _arg := -_dir * 2 * math.pi * kx
        for k = 0 to Nx - 1 by 1
            _cos := (math.cos(k * _arg) * math.exp(k*a) - math.cos(k * _arg) * math.exp(k*b) )/2
            _sin := (math.sin(k * _arg) * math.exp(k*a) - math.sin(k * _arg) * math.exp(k*b))/2
            xArr_i += array.get(x, k) * _cos - array.get(y, k) * _sin
            yArr_i += array.get(x, k) * _sin + array.get(y, k) * _cos
            yArr_i
        array.set(xArr, i, xArr_i)
        array.set(yArr, i, yArr_i)

    if _dir == 1
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i) / float(Nx))
            array.set(y, i, array.get(yArr, i) / float(Nx))
    else
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i)/ float(_dir))
            array.set(y, i, array.get(yArr, i)/ float(_dir))


// @function LFTdiff: Discrete Laplace transform over Nx set of close prices defference of 2 Laplace exponent components, second component exponent higher for 1
// @param x close price
// @param y 0 
// @param Nx number of close prices in calculations
// @param _dir Degree rotation on 2d chart
// @param a laplace coeficient
// @param b second laplace coeficient
LFTdiffFrom2(x, y, Nx, _dir, a, b) =>  
    float _arg = 0.0
    float _cos = 0.0
    float _sin = 0.0
    float xArr_i = 0.0
    float yArr_i = 0.0
    xArr = array.new_float(array.size(x))
    yArr = array.new_float(array.size(y))

    for i = 0 to Nx - 1 by 1
        xArr_i := 0.0
        yArr_i := 0.0
        kx = float(i) / float(Nx)
        _arg := -_dir * 2 * math.pi * kx
        for k = 0 to Nx - 1 by 1
            _cos := (math.cos(k * _arg) * math.exp(k*a) - math.cos(k * _arg) * math.exp(k*b + b) )/2
            _sin := (math.sin(k * _arg) * math.exp(k*a) - math.sin(k * _arg) * math.exp(k*b + b))/2
            xArr_i += array.get(x, k) * _cos - array.get(y, k) * _sin
            yArr_i += array.get(x, k) * _sin + array.get(y, k) * _cos
            yArr_i
        array.set(xArr, i, xArr_i)
        array.set(yArr, i, yArr_i)

    if _dir == 1
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i) / float(Nx))
            array.set(y, i, array.get(yArr, i) / float(Nx))
    else
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i)/ float(_dir))
            array.set(y, i, array.get(yArr, i)/ float(_dir))


// @function LaplaceTransform: Original Laplace Transform over N set of close prices
// @param xval series to aproximate
// @param N number of close prices in calculations
// @param a laplace coeficient
export LaplaceTransform(series float xval = close , int N = 3, float a = 0) => 

	x = array.new_float(N, 0.0)
	y = array.new_float(N, 0.0)
	for i = 0 to N - 1
		array.set(x, i, xval[i])
		array.set(y, i, 0.0)

	LFT(x, y,N, 1,a=a)


	dft1 = math.sqrt(math.pow(array.get(x, 0), 2) + math.pow(array.get(y, 0), 2))

	dft1

// @function LaplaceTransform: Y repetirions on Original Laplace Transform over N set of close prices, each time N-k set of close prices
// @param xval series to aproximate
// @param N number of close prices in calculations
// @param a laplace coeficient
// @param repeat number of repetitions
export NLaplaceTransform(series float xval = close , int N = 3, float a = 0, int repeat = 1) => 

	

	x = array.new_float(N, 0.0)
	y = array.new_float(N, 0.0)
	for i = 0 to N - 1
		array.set(x, i, xval[i])
		array.set(y, i, 0.0)

	for i = 1 to repeat
		LFT(x, y,N-i+1, 1,a=a)


	dft1 = math.sqrt(math.pow(array.get(x, 0), 2) + math.pow(array.get(y, 0), 2))

	dft1

// @function LaplaceTransform: Sum of 2 exponent coeficient of Laplace Transform over N set of close prices
// @param xval series to aproximate
// @param N number of close prices in calculations
// @param a laplace coeficient
// @param b second laplace coeficient
export LaplaceTransformsum(series float xval = close , int N = 3, float a = 0,float b = 0) => 

	

	x = array.new_float(N, 0.0)
	y = array.new_float(N, 0.0)
	for i = 0 to N - 1
		array.set(x, i, xval[i])
		array.set(y, i, 0.0)

	
	LFTSUM(x, y,N, 1,a=a,b=b)


	dft1 = math.sqrt(math.pow(array.get(x, 0), 2) + math.pow(array.get(y, 0), 2))

	dft1

