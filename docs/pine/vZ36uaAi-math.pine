        for k = 0 to Nx - 1 by 1
            _cos := (math.cos(k * _arg) * (math.exp((f+k)*a/2) - math.exp((g+k)*b/2  )/((b-a)))) 
            _sin := (math.sin(k * _arg) * (math.exp((f+k)*a/2) - math.exp((g+k)*b/2  )/((b-a))))
            xArr_i += array.get(x, k) * _cos - array.get(y, k) * _sin
