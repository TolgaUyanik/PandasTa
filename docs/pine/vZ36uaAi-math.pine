// @param x close price
// @param y 0 
// @param Nx number of close prices in calculations
// @param _dir Degree rotation on 2d chart
// @param a laplace coeficient
// @param b second laplace coeficient
LFTdiff(x, y, Nx, _dir, a, b) =>  
    float _arg = 0.0
