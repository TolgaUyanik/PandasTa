    float _arg = 0.0
    float _cos = 0.0
    float _sin = 0.0
    float xArr_i = 0.0
    float yArr_i = 0.0
    xArr = array.new_float(array.size(x))
    yArr = array.new_float(array.size(y))

    for i = 0 to Nx - 1 by 1
        xArr_i := 0.0
        yArr_i := 0.0
        kx = float(i) / float(Nx)
        _arg := -_dir * 2 * math.pi * kx
        for k = 0 to Nx - 1 by 1
            _cos := (math.cos(k * _arg) * (math.exp((f+k)*a/2) + math.exp((g+k)*b/2  ))) 
            _sin := (math.sin(k * _arg) * (math.exp((f+k)*a/2) + math.exp((g+k)*b/2  )))
            xArr_i += array.get(x, k) * _cos - array.get(y, k) * _sin
            yArr_i += array.get(x, k) * _sin + array.get(y, k) * _cos
            yArr_i
        array.set(xArr, i, xArr_i)
        array.set(yArr, i, yArr_i)

    if _dir == 1
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i) / float(Nx))
            array.set(y, i, array.get(yArr, i) / float(Nx))
    else
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i)/ float(_dir))
            array.set(y, i, array.get(yArr, i)/ float(_dir))


// @function calculateParameter: aproximates parrameters for a * e^k + b * e^k
// @param src series price Source 
// @param xval n
export calculateParameters(series float src = close,int n) =>
    sum_x = 0.0
    sum_y = 0.0
    sum_xy = 0.0
    sum_x2 = 0.0

    for i = 0 to n - 1
        x = i
        y = src[i]
        sum_x := sum_x + x
        sum_y := sum_y + math.log(y)
        sum_xy := sum_xy + x * math.log(y)
        sum_x2 := sum_x2 + x * x

    
    delta = n * sum_x2 - sum_x * sum_x
    a = (n * sum_xy - sum_x * sum_y) / delta
    b = (sum_y * sum_x2 - sum_x * sum_xy) / delta
    k = a
    l = b

    [a, k, b, l]


// @function LaplaceTransformv1: My version 1 of laplace transform with 4 parrameters
// @param xval series to aproximate
// @param N number of close prices in calculations
// @param a laplace coeficient
// @param b second laplace coeficient
// @param c laplace multyply
// @param d second laplace multiply
// @param repeat number of repetitions
// @returns  Aproxiated source value
export LaplaceTransformv1(series float xval = close , int N = 3, float a = 0,float b = 0,float c = 0,float d = 0, int repeat = 1) => 

	

	x = array.new_float(N, 0.0)
	y = array.new_float(N, 0.0)
	for i = 0 to N - 1
		array.set(x, i, xval[i])
		array.set(y, i, 0.0)

	
	for i = 1 to repeat
		LFTv1(x, y,N-i+1, repeat-i+1,a=a,b=b,f=c,g=d )



	dft1 = math.sqrt(math.pow(array.get(x, 0), 2) + math.pow(array.get(y, 0), 2))

	dft1



LFTv4(x, y, Nx, _dir,a, b,f,g) =>  
    float _arg = 0.0
    float _cos = 0.0
    float _sin = 0.0
    float xArr_i = 0.0
    float yArr_i = 0.0
    xArr = array.new_float(array.size(x))
    yArr = array.new_float(array.size(y))

    for i = 0 to Nx - 1 by 1
        xArr_i := 0.0
        yArr_i := 0.0
        kx = float(i) / float(Nx)
        _arg := -_dir * 2 * math.pi * kx
        for k = 0 to Nx - 1 by 1
            _cos := (math.cos(k * _arg) * (math.exp((f+a)*k/2) - math.exp((g+b)*k/2  )/((b-a)))) 
            _sin := (math.sin(k * _arg) * (math.exp((f+a)*k/2) - math.exp((g+b)*k/2  )/((b-a))))
            xArr_i += array.get(x, k) * _cos - array.get(y, k) * _sin
            yArr_i += array.get(x, k) * _sin + array.get(y, k) * _cos
            yArr_i
        array.set(xArr, i, xArr_i)
        array.set(yArr, i, yArr_i)

    if _dir == 1
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i) / float(Nx))
            array.set(y, i, array.get(yArr, i) / float(Nx))
    else
        for i = 0 to Nx - 1 by 1
            array.set(x, i, array.get(xArr, i)/ float(_dir))
            array.set(y, i, array.get(yArr, i)/ float(_dir))


