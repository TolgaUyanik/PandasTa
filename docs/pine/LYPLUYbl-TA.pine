//@version=6

// @description Technical analysis library that provides convenience functions and overrides for tradingview's own ta.* functions in order to work around various limitations.
library("TA", overlay=true)

// @function Override for ta.sma that allows you to provide series values
// @param src The source values to process
// @param length The length of the source to evaluate for the moving average
// @returns float The moving average
export sma(float src, int length) =>
    sum = 0.0
    for i = 0 to length - 1
        sum := sum + src[i] / length
    sum

// @function Override for ta.ema that allows you to provide series values
// @param src The source values to process
// @param length The length of the source to evaluate for the moving average
// @returns float The moving average
export ema(float src, int length) =>
    alpha = 2 / (length + 1)
    sum = 0.0
    sum := na(sum[1]) ? src : alpha * src + (1 - alpha) * nz(sum[1])

// @function Override for ta.rma that allows you to provide series values
// @param src The source values to process
// @param length The length of the source to evaluate for the moving average
// @returns float The moving average
export rma(float src, int length) =>
    alpha = 1/length
    sum = 0.0
    sum := na(sum[1]) ? sma(src, length) : alpha * src + (1 - alpha) * nz(sum[1])

// @function Override for ta.wma that allows you to provide series values
// @param src The source values to process
// @param length The length of the source to evaluate for the moving average
// @returns float The moving average
export wma(float src, int length) =>
    norm = 0.0
    sum = 0.0
    for i = 0 to length - 1
        weight = (length - i) * length
        norm := norm + weight
        sum := sum + src[i] * weight
    sum / norm

// @function Override for ta.vwma that allows you to provide series values
// @param src The source values to process
// @param length The length of the source to evaluate for the moving average
// @returns float The moving average
export vwma(float src, int length) =>
    sma(src * volume, length) / sma(volume, length)

// @function Provide the requested moving average
// @param src The source values to process
// @param length The length of the source to evaluate for the moving average
// @param maType The type of moving average to return: SMA (default), EMA, SMMA (RMA), WMA, VWMA
// @returns float The moving average
export ma(float src, int length, string maType = '') =>
    switch maType
        "EMA" => ema(src, length)
        "SMMA (RMA)" => rma(src, length)
        "WMA" => wma(src, length)
        "VWMA" => vwma(src, length)
        => sma(src, length)


// Example

plot(ma(close, 12, 'EMA'))