//@version=6
strategy("Surgical Sweep - Original Restored", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, max_lines_count=50)

// --- Original Inputs ---
lookback = input.int(5, "Pivot Sensitivity")
vol_mult = input.float(1.2, "Volume Spike Filter")
line_len = input.int(15, "Line Length")

// --- Calculations ---
avg_vol = ta.sma(volume, 20)
is_high_vol = volume > (avg_vol * vol_mult)

// --- Weekend Filter ---
is_weekday = dayofweek != dayofweek.saturday and dayofweek != dayofweek.sunday

// Detect Highs and Lows
hi = ta.pivothigh(high, lookback, lookback)
lo = ta.pivotlow(low, lookback, lookback)

var float res_level = na
var float sup_level = na

// --- Drawing the Original Lines with Deletion Logic ---
var line last_res_line = na
var line last_sup_line = na

if not na(hi)
    res_level := hi
    // Delete the previous line to prevent public library rejection due to clutter
    line.delete(last_res_line)
    last_res_line := line.new(bar_index[lookback], res_level, bar_index + line_len, res_level, color=color.new(#ff5252, 0), width=2)

if not na(lo)
    sup_level := lo
    // Delete the previous line to prevent public library rejection due to clutter
    line.delete(last_sup_line)
    last_sup_line := line.new(bar_index[lookback], sup_level, bar_index + line_len, sup_level, color=color.new(#2195f3, 0), width=2)

// --- Original Signal Logic ---
sell_signal = high[1] > res_level and close[1] > res_level and close < res_level and is_high_vol
buy_signal  = low[1] < sup_level and close[1] < sup_level and close > sup_level and is_high_vol

// --- Purple Step Logic ---
var int blue_count = 0
var float last_blue_price = na
var int red_count = 0
var float last_red_price = na

if buy_signal
    blue_count := (na(last_blue_price) or sup_level < last_blue_price) ? blue_count + 1 : 1
    last_blue_price := sup_level
    red_count := 0 
else if sell_signal
    blue_count := 0 

if sell_signal
    red_count := (na(last_red_price) or res_level > last_red_price) ? red_count + 1 : 1
    last_red_price := res_level
    blue_count := 0 
else if buy_signal
    red_count := 0 

purple_trigger = (blue_count == 2 and buy_signal) or (red_count == 2 and sell_signal)

// --- Strategy Execution ---
if buy_signal and is_weekday
    strategy.entry("Long", strategy.long)

if sell_signal and is_weekday
    strategy.entry("Short", strategy.short)

// --- Original Visuals ---
plotshape(sell_signal, "SELL", shape.labeldown, location.abovebar, color.red, size=size.small, text="SELL", textcolor=color.white)
plotshape(buy_signal, "BUY", shape.labelup, location.belowbar, color.blue, size=size.small, text="BUY", textcolor=color.white)

// FIXED: Changed from location.absolute to location.abovebar so the diamond actually shows on the candles
plotshape(purple_trigger, "PURPLE SIGNAL", shape.diamond, location.abovebar, color.purple, size=size.large, text="PURPLE\nSWEEP", textcolor=color.white)

// --- Custom Entry/Exit Visual Markers ---
entered_long  = ta.change(strategy.position_size) > 0 and strategy.position_size[1] <= 0
entered_short = ta.change(strategy.position_size) < 0 and strategy.position_size[1] >= 0
exited_trade  = ta.change(strategy.position_size) != 0 and strategy.position_size == 0

plotshape(entered_long, "Execution Entry Long", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(entered_short, "Execution Entry Short", shape.triangledown, location.abovebar, color.red, size=size.small)

// FIXED: Changed from location.absolute to location.abovebar to prevent flatline visual scaling issues
plotshape(exited_trade, "Execution Exit", shape.xcross, location.abovebar, color.gray, size=size.small)
