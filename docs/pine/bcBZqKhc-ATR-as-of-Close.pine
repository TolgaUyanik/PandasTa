//@version=6
indicator("ATR as % of Close", overlay=false)

// === Input ===
length = input.int(14, title="ATR Period")
src = input.source(close, title="Source")

// === Calculation ===
atr = ta.atr(length)
atr_pct = (atr / src) * 100

// === Plot ===
plot(atr_pct, title="ATR %", color=color.orange, linewidth=2)
hline(0, "Zero", color=color.gray)
