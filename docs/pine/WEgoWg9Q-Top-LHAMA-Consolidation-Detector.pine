//@version=6
indicator("[Top] LHAMA Consolidation Detector", shorttitle="[Top] 🦙 Detector", overlay=true, max_lines_count=18)

//────────────────────  helpers  ────────────────────
blendColors(colA,colB,w)=>r=int(math.round(color.r(colA)*(1-w)+color.r(colB)*w)),g=int(math.round(color.g(colA)*(1-w)+color.g(colB)*w)),b=int(math.round(color.b(colA)*(1-w)+color.b(colB)*w)),t=int(math.round(color.t(colA)*(1-w)+color.t(colB)*w)),color.rgb(r,g,b,t)
gradientColor(val, bullCol, bearCol, flatCol, sensitivity) =>
    slope = nz(val - val[1], 0) * sensitivity
    angle = math.atan(slope) * 180 / math.pi
    weight = math.min(math.abs(angle) / 45.0, 1.0)
    angle >= 0 ? blendColors(flatCol, bullCol, weight) : blendColors(flatCol, bearCol, weight)
calculate_lhama(len,useVol)=>ama=0.0,hh=math.max(math.sign(ta.change(ta.highest(len))),0),ll=math.max(math.sign(ta.change(ta.lowest(len))*-1),0),tCoef=math.pow(ta.sma((hh>0 or ll>0)?1:0,len),2),vF=math.min(volume/ta.sma(volume,len),3),wt=useVol?vF:1,ama:=nz(ama[1]+tCoef*wt*(close-ama[1]),close)
offsetCalc(isATR,len,mult)=>isATR?mult*ta.atr(len):mult*ta.stdev(close,len)

//──────────────  Tooltip Constants  ──────────────
string TT_LEN = "Calculation Length"
string TT_WIDTH = "Line Width"
string TT_VOL = "Add volume weighting to the LHAMA line to make it more responsive at the expense of smoothing."
string TT_BULL = "The line (and optional cloud) will appear this color when the slope is bullish. If you only want to see the line/cloud when the slope is flat, set this and the bearish color to 100% transparency."
string TT_BEAR = "The line (and optional cloud) will appear this color when the slope is bearish. If you only want to see the line/cloud when the slope is flat, set this and the bullish color to 100% transparency."
string TT_FLAT = "The line (and optional cloud) will appear this color when the slope is flat. If you only want to see the line/cloud when the slope is NOT flat, set this to 100% transparency."
string TT_SEN = "Symbols vary greatly by tick size. This setting allows you to adjust the sensitivty of the slope coloring to account for this variance.\n\nRecommended Settings by Tick Size:\n$5 Tick : 0.25 Sensitivity\n$1 Tick : 0.75 Sensitivity\n$0.25 Tick : 3.0 Sensitivity\n$0.10 Tick : 5 Sensitivity\n$0.01 Tick : 50 Sensitivity\n$0.005 Tick : 100 Sensitivity"
string TT_CLOUD_ON = "Display a cloud around the LHAMA line for additional visual clarity of trend conditions."
string TT_CLOUD_BASIS = "You can choose whether you want the cloud's width to be based on the recent ATR, or a standard deviation."
string TT_CLOUD_LEN = "ATR or StdDev calculation length."
string TT_CLOUD_MULT = "A multiplier of ATR/StdDev that determines the width of the cloud."

//──────────────  LHAMA 1 Inputs  ──────────────
enable1=input.bool(true,"Enable 🦙 Line 1",group="LHAMA 1")
len1=input.int(14,"Length",1,group="LHAMA 1", tooltip = TT_LEN)
w1=input.int(2,"Width",1,4,group="LHAMA 1", tooltip = TT_WIDTH)
tf1=input.timeframe("","Timeframe",group="LHAMA 1")
vol1=input.bool(false,"Volume Weight",group="LHAMA 1", tooltip = TT_VOL)
bull1=input.color(color.blue,"Bullish Color",group="LHAMA 1", tooltip = TT_BULL)
bear1=input.color(color.orange,"Bearish Color",group="LHAMA 1", tooltip = TT_BEAR)
flat1=input.color(color.white,"Flat Color",group="LHAMA 1", tooltip = TT_FLAT)
sen1 = input.float(1.0, "Color Sensitivity", minval=0.1, step=1.0, group="LHAMA 1", tooltip = TT_SEN)
cl1_on=input.bool(false,"Show Cloud",group="LHAMA 1", tooltip = TT_CLOUD_ON)
cl1_basis=input.string("ATR","Width Based On",options=["ATR","StdDev"],group="LHAMA 1", tooltip = TT_CLOUD_BASIS)
cl1_len=input.int(14,"Cloud Length",1,group="LHAMA 1", tooltip = TT_CLOUD_LEN)
cl1_mult=input.float(1.0,"Cloud Width",0.1,step=0.1,group="LHAMA 1", tooltip = TT_CLOUD_MULT)

//──────────────  LHAMA 2 Inputs  ──────────────
