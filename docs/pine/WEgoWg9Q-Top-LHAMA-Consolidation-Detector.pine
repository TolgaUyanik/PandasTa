len6=input.int(144,"Length",1,group="LHAMA 6", tooltip = TT_LEN)
w6=input.int(2,"Width",1,4,group="LHAMA 6", tooltip = TT_WIDTH)
tf6=input.timeframe("","Timeframe",group="LHAMA 6")
vol6=input.bool(false,"Volume Weight",group="LHAMA 6", tooltip = TT_VOL)
bull6=input.color(color.navy,"Bullish Color",group="LHAMA 6", tooltip = TT_BULL)
bear6=input.color(color.fuchsia,"Bearish Color",group="LHAMA 6", tooltip = TT_BEAR)
flat6=input.color(color.gray,"Flat Color",group="LHAMA 6", tooltip = TT_FLAT)
sen6 = input.float(100.0, "Color Sensitivity", minval=0.1, step=1.0, group="LHAMA 6", tooltip = TT_SEN)
cl6_on=input.bool(false,"Show Cloud",group="LHAMA 6", tooltip = TT_CLOUD_ON)
cl6_basis=input.string("ATR","Width Based On",options=["ATR","StdDev"],group="LHAMA 6", tooltip = TT_CLOUD_BASIS)
cl6_len=input.int(14,"Cloud Length",1,group="LHAMA 6", tooltip = TT_CLOUD_LEN)
cl6_mult=input.float(1.0,"Cloud Width",0.1,step=0.1,group="LHAMA 6", tooltip = TT_CLOUD_MULT)

//──────────────  LHAMA 1  ──────────────
lhama1=enable1?request.security(syminfo.tickerid,tf1,calculate_lhama(len1,vol1)):na
col1=enable1?gradientColor(lhama1,bull1,bear1,flat1, sen1):na
plot(lhama1,"LHAMA 1",col1,linewidth=w1)
off1=enable1 and cl1_on?request.security(syminfo.tickerid,tf1,offsetCalc(cl1_basis=="ATR",cl1_len,cl1_mult)):na
u1 = plot(not na(off1) ? lhama1 + off1 : na, "LHAMA 1 Cloud U", color=color.new(col1, 100), linewidth = 1, display = display.none)
l1 = plot(not na(off1) ? lhama1 - off1 : na, "LHAMA 1 Cloud L", color=color.new(col1, 100), linewidth = 1, display = display.none)
fill(u1,l1,color=enable1 and cl1_on?color.new(col1,80):na)

