bull2=input.color(color.green,"Bullish Color",group="LHAMA 2", tooltip = TT_BULL)
bear2=input.color(color.red,"Bearish Color",group="LHAMA 2", tooltip = TT_BEAR)
flat2=input.color(color.black,"Flat Color",group="LHAMA 2", tooltip = TT_FLAT)
sen2 = input.float(100.0, "Color Sensitivity", minval=0.1, step=1.0, group="LHAMA 2", tooltip = TT_SEN)
cl2_on=input.bool(false,"Show Cloud",group="LHAMA 2", tooltip = TT_CLOUD_ON)
cl2_basis=input.string("ATR","Width Based On",options=["ATR","StdDev"],group="LHAMA 2", tooltip = TT_CLOUD_BASIS)
cl2_len=input.int(14,"Cloud Length",1,group="LHAMA 2", tooltip = TT_CLOUD_LEN)
cl2_mult=input.float(1.0,"Cloud Width",0.1,step=0.1,group="LHAMA 2", tooltip = TT_CLOUD_MULT)

