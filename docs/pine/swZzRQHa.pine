        "GALA-USDT-SWAP" => true
        "GAS-USDT-SWAP" => true
        "GFT-USDT-SWAP" => true
        "ICP-USDT-SWAP" => true
        "JUP-USDT-SWAP" => true
        "LRC-USDT-SWAP" => true
        "LUNA-USDT-SWAP" => true
        "NOT-USDT-SWAP" => true
        "OMG-USDT-SWAP" => true
        "ONT-USDT-SWAP" => true
        "OP-USDT-SWAP" => true
        "ORDI-USDT-SWAP" => true
        "PEOPLE-USDT-SWAP" => true
        "SNX-USDT-SWAP" => true
        "SPELL-USDT-SWAP" => true
        "STARL-USDT-SWAP" => true
        "STX-USDT-SWAP" => true
        "SUSHI-USDT-SWAP" => true
        "TRB-USDT-SWAP" => true
        "USTC-USDT-SWAP" => true
        "W-USDT-SWAP" => true
        "WAVES-USDT-SWAP" => true
        "ZEN-USDT-SWAP" => true
        "ZIL-USDT-SWAP" => true
        => false

