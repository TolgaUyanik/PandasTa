//@version=6
indicator(
     "Institution Levels Gath",
     shorttitle="InstitutionLevelsGath",
     overlay=true,
     max_lines_count=500,
     max_labels_count=300
)

//==============================================================
// 1. PSYCHOLOGICAL LEVEL SETTINGS
//==============================================================

majorInterval = input.float(
     0.01000,
     "Major interval",
     minval=0.00001,
     step=0.00001,
     group="1. Psychological Levels",
     tooltip="For GBPUSD, 0.01000 generates levels such as 1.33000, 1.34000 and 1.35000."
)

levelsAboveBelow = input.int(
     10,
     "Blocks above and below price",
     minval=2,
     maxval=25,
     group="1. Psychological Levels"
)

show000Levels = input.bool(
     true,
     "Show 000 levels",
     group="1. Psychological Levels"
)

show500Levels = input.bool(
     true,
     "Show 500 levels",
     group="1. Psychological Levels"
)

show200800Levels = input.bool(
     true,
     "Show 200 and 800 levels",
     group="1. Psychological Levels"
)

showPsychologicalLabels = input.bool(
     false,
     "Show level labels",
     group="1. Psychological Levels"
)

level000Color = input.color(
     color.rgb(35, 105, 220),
     "000 colour",
     group="1. Psychological Levels"
)

level500Color = input.color(
     color.rgb(0, 188, 212),
     "500 colour",
     group="1. Psychological Levels"
)

level200800Color = input.color(
     color.rgb(130, 180, 190),
     "200/800 colour",
     group="1. Psychological Levels"
)

level000Width = input.int(
     2,
     "000 width",
     minval=1,
     maxval=5,
     group="1. Psychological Levels"
)

level500Width = input.int(
     1,
     "500 width",
     minval=1,
     maxval=4,
     group="1. Psychological Levels"
)

level500Transparency = input.int(
     25,
     "500 transparency",
     minval=0,
     maxval=100,
     group="1. Psychological Levels"
)

level200800Transparency = input.int(
     78,
     "200/800 transparency",
     minval=0,
     maxval=100,
     group="1. Psychological Levels"
)

//==============================================================
// 2. TIMEFRAME CONTROLS
//==============================================================

psychologicalMaximumTF = input.timeframe(
     "240",
     "Maximum TF for 000/500 levels",
     group="2. Timeframe Controls"
)

fineLevelsMaximumTF = input.timeframe(
     "60",
     "Maximum TF for 200/800 levels",
     group="2. Timeframe Controls"
)

monthlySegmentsMaximumTF = input.timeframe(
     "1D",
     "Maximum TF for monthly segments",
     group="2. Timeframe Controls"
)

monthlySeparatorsMaximumTF = input.timeframe(
     "1D",
     "Maximum TF for monthly separators",
     group="2. Timeframe Controls"
)

monthlyLabelsMaximumTF = input.timeframe(
     "240",
     "Maximum TF for monthly labels",
     group="2. Timeframe Controls"
)

monthlyShadingMaximumTF = input.timeframe(
     "1D",
     "Maximum TF for monthly shading",
     group="2. Timeframe Controls"
)

//==============================================================
// 3. MONTHLY HISTORY
//==============================================================

monthlyHistoryMode = input.string(
     "Last 12 visible months",
     "Monthly history",
     options=[
         "Current month only",
         "Last 3 visible months",
         "Last 6 visible months",
         "Last 12 visible months",
         "Last 24 visible months"
     ],
     group="3. Monthly History"
)

maximumStoredMonths = input.int(
     60,
     "Maximum months stored",
     minval=12,
     maxval=120,
     group="3. Monthly History"
)

//==============================================================
// 4. MONTHLY SEPARATORS
//==============================================================

showMonthlySeparators = input.bool(
     true,
     "Show month-start vertical lines",
     group="4. Monthly Separators"
)

showSeparatorLabels = input.bool(
     false,
     "Show month names at separators",
     group="4. Monthly Separators"
)

separatorColor = input.color(
     color.rgb(115, 150, 195),
     "Separator colour",
     group="4. Monthly Separators"
)

separatorTransparency = input.int(
     65,
     "Separator transparency",
     minval=0,
     maxval=100,
     group="4. Monthly Separators"
)

separatorWidth = input.int(
     1,
     "Separator width",
     minval=1,
     maxval=4,
     group="4. Monthly Separators"
)

separatorStyleInput = input.string(
     "Dashed",
     "Separator style",
     options=["Solid", "Dashed", "Dotted"],
     group="4. Monthly Separators"
)

//==============================================================
// 5. MONTHLY OPEN, HIGH AND LOW
//==============================================================

showMonthlyOpen = input.bool(
     true,
     "Show monthly opening segments",
     group="5. Monthly Open, High and Low"
)

showMonthlyHigh = input.bool(
     true,
     "Show monthly high segments",
     group="5. Monthly Open, High and Low"
)

showMonthlyLow = input.bool(
     true,
     "Show monthly low segments",
     group="5. Monthly Open, High and Low"
)

showMonthlyOHLabels = input.bool(
     false,
     "Show monthly O/H/L labels",
     group="5. Monthly Open, High and Low"
)

monthlyOpenWidth = input.int(
     2,
     "Monthly open width",
     minval=1,
     maxval=5,
     group="5. Monthly Open, High and Low"
)

monthlyHighLowWidth = input.int(
     1,
     "Monthly high/low width",
     minval=1,
     maxval=4,
     group="5. Monthly Open, High and Low"
)

monthlyOpenTransparency = input.int(
     5,
     "Monthly open transparency",
     minval=0,
     maxval=100,
     group="5. Monthly Open, High and Low"
)

monthlyHighColor = input.color(
     color.rgb(65, 190, 110),
     "Monthly high colour",
     group="5. Monthly Open, High and Low"
)

monthlyLowColor = input.color(
     color.rgb(220, 75, 75),
     "Monthly low colour",
     group="5. Monthly Open, High and Low"
)

monthlyHighLowTransparency = input.int(
     25,
     "Monthly high/low transparency",
     minval=0,
     maxval=100,
     group="5. Monthly Open, High and Low"
)

//==============================================================
// 6. CURRENT MONTH
//==============================================================

showCurrentMonthDistance = input.bool(
     true,
     "Show current price distance from monthly open",
     group="6. Current Month"
)

showNearestMonthlyLevel = input.bool(
     true,
     "Highlight nearest 000/200/500/800 level",
     group="6. Current Month"
)

showNearestMonthlyLabel = input.bool(
     true,
     "Show nearest-level pip label",
     group="6. Current Month"
)

nearestMonthlyColor = input.color(
     color.rgb(255, 170, 0),
     "Nearest-level colour",
     group="6. Current Month"
)

nearestMonthlyWidth = input.int(
     3,
     "Nearest-level width",
     minval=1,
     maxval=5,
     group="6. Current Month"
)

manualPipSize = input.float(
     0.0,
     "Manual pip size",
     minval=0.0,
     step=0.00001,
     group="6. Current Month",
     tooltip="Leave at 0 for automatic forex pip-size detection."
)

//==============================================================
// 7. PREVIOUS-MONTH CONTEXT
//==============================================================

showContextTable = input.bool(
     true,
     "Show monthly context table",
     group="7. Previous-Month Context"
)

relationshipBasis = input.string(
     "Current price",
     "Relationship based on",
     options=["Current price", "Current month open"],
     group="7. Previous-Month Context"
)

//==============================================================
// 8. MONTHLY SHADING
//==============================================================

showMonthlyShading = input.bool(
     true,
     "Show alternating monthly shading",
     group="8. Monthly Shading"
)

shadingColorA = input.color(
     color.rgb(55, 90, 150),
     "Shade A",
     group="8. Monthly Shading"
)

shadingColorB = input.color(
     color.rgb(110, 65, 135),
     "Shade B",
     group="8. Monthly Shading"
)

shadingTransparency = input.int(
     96,
     "Shading transparency",
     minval=85,
     maxval=100,
     group="8. Monthly Shading"
)

//==============================================================
// 9. ALERTS
//==============================================================

enableMonthlyOpenAlert = input.bool(
     true,
     "Monthly open crossed",
     group="9. Alerts"
)

enableNearestLevelAlert = input.bool(
     true,
     "Nearest monthly interval touched",
     group="9. Alerts"
)

enable000Alert = input.bool(
     false,
     "000 level crossed",
     group="9. Alerts"
)

enable500Alert = input.bool(
     false,
     "500 level crossed",
     group="9. Alerts"
)

enable200800Alert = input.bool(
     false,
     "200/800 level touched",
     group="9. Alerts"
)

enablePreviousHighLowAlert = input.bool(
     true,
     "Previous-month high/low crossed",
     group="9. Alerts"
)

//==============================================================
// 10. ARRAYS AND OBJECT STORAGE
//==============================================================

var int[] monthStartTimes = array.new_int()
var float[] monthOpenPrices = array.new_float()
var float[] monthHighPrices = array.new_float()
var float[] monthLowPrices = array.new_float()

var line[] generatedLines = array.new_line()
var label[] generatedLabels = array.new_label()

var color[] monthlyColors = array.from(
     color.rgb(255, 152, 0),
     color.rgb(156, 39, 176),
     color.rgb(0, 188, 212),
     color.rgb(76, 175, 80),
     color.rgb(244, 67, 54),
     color.rgb(63, 81, 181),
     color.rgb(255, 193, 7),
     color.rgb(0, 150, 136),
     color.rgb(233, 30, 99),
     color.rgb(121, 85, 72),
     color.rgb(3, 169, 244),
     color.rgb(139, 195, 74)
)

var table contextTable = table.new(
     position.top_right,
     2,
     8,
     border_width=1
)

//==============================================================
// 11. HELPER FUNCTIONS
//==============================================================

f_style(string styleName) =>
    styleName == "Dotted" ? line.style_dotted :
     styleName == "Dashed" ? line.style_dashed :
     line.style_solid

f_timeframeAllowed(string maximumTimeframe) =>
    timeframe.in_seconds() <= timeframe.in_seconds(maximumTimeframe)

f_monthColor(int monthIndex) =>
    colorIndex = monthIndex % array.size(monthlyColors)
    array.get(monthlyColors, colorIndex)

f_pipSize() =>
    detectedPipSize =
         syminfo.type == "forex" and syminfo.mintick < 0.01 ?
         syminfo.mintick * 10.0 :
         syminfo.mintick

    manualPipSize > 0.0 ? manualPipSize : detectedPipSize

f_historyLimit() =>
    monthlyHistoryMode == "Current month only" ? 1 :
     monthlyHistoryMode == "Last 3 visible months" ? 3 :
     monthlyHistoryMode == "Last 6 visible months" ? 6 :
     monthlyHistoryMode == "Last 12 visible months" ? 12 :
     24

f_addTimeLine(
     int startTime,
     float startPrice,
     int endTime,
     float endPrice,
     color selectedColor,
     int selectedWidth,
     string selectedStyle,
     string selectedExtend
 ) =>
    createdLine = line.new(
         x1=startTime,
         y1=startPrice,
         x2=endTime,
         y2=endPrice,
         xloc=xloc.bar_time,
         extend=selectedExtend,
         color=selectedColor,
         width=selectedWidth,
         style=selectedStyle
    )

    array.push(generatedLines, createdLine)

f_addBarLine(
     int startBar,
     float startPrice,
     int endBar,
     float endPrice,
     color selectedColor,
     int selectedWidth,
     string selectedStyle,
     string selectedExtend
 ) =>
    createdLine = line.new(
         x1=startBar,
         y1=startPrice,
         x2=endBar,
         y2=endPrice,
         xloc=xloc.bar_index,
         extend=selectedExtend,
         color=selectedColor,
         width=selectedWidth,
         style=selectedStyle
    )

    array.push(generatedLines, createdLine)

f_addTimeLabel(
     int labelTime,
     float labelPrice,
     string labelText,
     color labelColor,
     string labelStyle,
     string labelSize
 ) =>
    createdLabel = label.new(
         x=labelTime,
         y=labelPrice,
         text=labelText,
         xloc=xloc.bar_time,
         style=labelStyle,
         color=labelColor,
         textcolor=color.white,
         size=labelSize
    )

    array.push(generatedLabels, createdLabel)

f_addBarLabel(
     int labelBar,
     float labelPrice,
     string labelText,
     color labelColor,
     string labelStyle,
     string labelSize
 ) =>
    createdLabel = label.new(
         x=labelBar,
         y=labelPrice,
         text=labelText,
         xloc=xloc.bar_index,
         style=labelStyle,
         color=labelColor,
         textcolor=color.white,
         size=labelSize
    )

    array.push(generatedLabels, createdLabel)

//==============================================================
// 12. COLLECT MONTHLY DATA
//==============================================================

currentMonthStartTime = time("1M")
newMonthStarted = ta.change(currentMonthStartTime) != 0

if array.size(monthStartTimes) == 0
    array.push(monthStartTimes, currentMonthStartTime)
    array.push(monthOpenPrices, open)
    array.push(monthHighPrices, high)
    array.push(monthLowPrices, low)

else if newMonthStarted
    array.push(monthStartTimes, currentMonthStartTime)
    array.push(monthOpenPrices, open)
    array.push(monthHighPrices, high)
    array.push(monthLowPrices, low)

    if array.size(monthStartTimes) > maximumStoredMonths
        array.shift(monthStartTimes)
        array.shift(monthOpenPrices)
        array.shift(monthHighPrices)
        array.shift(monthLowPrices)

else
    activeMonthIndex = array.size(monthStartTimes) - 1

    updatedMonthHigh = math.max(
         array.get(monthHighPrices, activeMonthIndex),
         high
    )

    updatedMonthLow = math.min(
         array.get(monthLowPrices, activeMonthIndex),
         low
    )

    array.set(
         monthHighPrices,
         activeMonthIndex,
         updatedMonthHigh
    )

    array.set(
         monthLowPrices,
         activeMonthIndex,
         updatedMonthLow
    )

//==============================================================
// 13. CURRENT AND PREVIOUS MONTH VALUES
//==============================================================

storedMonthCount = array.size(monthStartTimes)
currentMonthIndex = storedMonthCount - 1

currentMonthOpen =
     storedMonthCount > 0 ?
     array.get(monthOpenPrices, currentMonthIndex) :
     open

currentMonthHigh =
     storedMonthCount > 0 ?
     array.get(monthHighPrices, currentMonthIndex) :
     high

currentMonthLow =
     storedMonthCount > 0 ?
     array.get(monthLowPrices, currentMonthIndex) :
     low

previousMonthOpen =
     storedMonthCount > 1 ?
     array.get(monthOpenPrices, currentMonthIndex - 1) :
     na

previousMonthHigh =
     storedMonthCount > 1 ?
     array.get(monthHighPrices, currentMonthIndex - 1) :
     na

previousMonthLow =
     storedMonthCount > 1 ?
     array.get(monthLowPrices, currentMonthIndex - 1) :
     na

previousMonthMidpoint =
     storedMonthCount > 1 ?
     (previousMonthHigh + previousMonthLow) / 2.0 :
     na

pipSize = f_pipSize()

currentPriceDistancePips =
     (close - currentMonthOpen) / pipSize

//==============================================================
// 14. NEAREST MONTHLY PSYCHOLOGICAL LEVEL
//==============================================================

monthlyBaseLevel =
     math.floor(currentMonthOpen / majorInterval) *
     majorInterval

candidate000 = monthlyBaseLevel
candidate200 = monthlyBaseLevel + majorInterval * 0.20
candidate500 = monthlyBaseLevel + majorInterval * 0.50
candidate800 = monthlyBaseLevel + majorInterval * 0.80
candidateNext000 = monthlyBaseLevel + majorInterval

nearestMonthlyLevel = candidate000
nearestMonthlyLevelName = "000"
smallestMonthlyDistance = math.abs(currentMonthOpen - candidate000)

distanceTo200 = math.abs(currentMonthOpen - candidate200)
distanceTo500 = math.abs(currentMonthOpen - candidate500)
distanceTo800 = math.abs(currentMonthOpen - candidate800)
distanceToNext000 = math.abs(currentMonthOpen - candidateNext000)

if distanceTo200 < smallestMonthlyDistance
    nearestMonthlyLevel := candidate200
    nearestMonthlyLevelName := "200"
    smallestMonthlyDistance := distanceTo200

if distanceTo500 < smallestMonthlyDistance
    nearestMonthlyLevel := candidate500
    nearestMonthlyLevelName := "500"
    smallestMonthlyDistance := distanceTo500

if distanceTo800 < smallestMonthlyDistance
    nearestMonthlyLevel := candidate800
    nearestMonthlyLevelName := "800"
    smallestMonthlyDistance := distanceTo800

if distanceToNext000 < smallestMonthlyDistance
    nearestMonthlyLevel := candidateNext000
    nearestMonthlyLevelName := "000"
    smallestMonthlyDistance := distanceToNext000

nearestMonthlyDistancePips =
     (nearestMonthlyLevel - currentMonthOpen) / pipSize

//==============================================================
// 15. TIMEFRAME PERMISSIONS
//==============================================================

psychologicalTimeframeAllowed =
     f_timeframeAllowed(psychologicalMaximumTF)

fineTimeframeAllowed =
     f_timeframeAllowed(fineLevelsMaximumTF)

monthlySegmentsTimeframeAllowed =
     f_timeframeAllowed(monthlySegmentsMaximumTF)

monthlySeparatorsTimeframeAllowed =
     f_timeframeAllowed(monthlySeparatorsMaximumTF)

monthlyLabelsTimeframeAllowed =
     f_timeframeAllowed(monthlyLabelsMaximumTF)

monthlyShadingTimeframeAllowed =
     f_timeframeAllowed(monthlyShadingMaximumTF)

//==============================================================
// 16. ALTERNATING MONTHLY BACKGROUND SHADING
//==============================================================

monthSequenceNumber = year * 12 + month

selectedBackgroundShade =
     monthSequenceNumber % 2 == 0 ?
     color.new(shadingColorA, shadingTransparency) :
     color.new(shadingColorB, shadingTransparency)

bgcolor(
     showMonthlyShading and monthlyShadingTimeframeAllowed ?
     selectedBackgroundShade :
     na,
     title="Alternating monthly shading"
)

//==============================================================
// 17. DELETE AND REDRAW OBJECTS
//==============================================================

if barstate.islast

    if array.size(generatedLines) > 0
        for oldLine in generatedLines
            line.delete(oldLine)

    array.clear(generatedLines)

    if array.size(generatedLabels) > 0
        for oldLabel in generatedLabels
            label.delete(oldLabel)

    array.clear(generatedLabels)

    //==========================================================
    // PSYCHOLOGICAL LEVELS
    //==========================================================

    if psychologicalTimeframeAllowed

        currentPsychologicalBase =
             math.floor(close / majorInterval) *
             majorInterval

        for levelIndex = -levelsAboveBelow to levelsAboveBelow

            level000 =
                 currentPsychologicalBase +
                 levelIndex * majorInterval

            level200 =
                 level000 +
                 majorInterval * 0.20

            level500 =
                 level000 +
                 majorInterval * 0.50

            level800 =
                 level000 +
                 majorInterval * 0.80

            if show000Levels
                f_addBarLine(
                     bar_index - 1,
                     level000,
                     bar_index,
                     level000,
                     level000Color,
                     level000Width,
                     line.style_solid,
                     extend.both
                )

                if showPsychologicalLabels
                    f_addBarLabel(
                         bar_index + 2,
                         level000,
                         str.tostring(level000, format.mintick) +
                         " · 000",
                         level000Color,
                         label.style_label_left,
                         size.tiny
                    )

            if show500Levels
                f_addBarLine(
                     bar_index - 1,
                     level500,
                     bar_index,
                     level500,
                     color.new(
                         level500Color,
                         level500Transparency
                     ),
                     level500Width,
                     line.style_solid,
                     extend.both
                )

                if showPsychologicalLabels
                    f_addBarLabel(
                         bar_index + 2,
                         level500,
                         str.tostring(level500, format.mintick) +
                         " · 500",
                         color.new(
                             level500Color,
                             level500Transparency
                         ),
                         label.style_label_left,
                         size.tiny
                    )

            if show200800Levels and fineTimeframeAllowed
                f_addBarLine(
                     bar_index - 1,
                     level200,
                     bar_index,
                     level200,
                     color.new(
                         level200800Color,
                         level200800Transparency
                     ),
                     1,
                     line.style_dotted,
                     extend.both
                )

                f_addBarLine(
                     bar_index - 1,
                     level800,
                     bar_index,
                     level800,
                     color.new(
                         level200800Color,
                         level200800Transparency
                     ),
                     1,
                     line.style_dotted,
                     extend.both
                )

    //==========================================================
    // HISTORICAL MONTHLY OBJECTS
    //==========================================================

    visibleLeftTime = chart.left_visible_bar_time
    visibleRightTime = chart.right_visible_bar_time

    requestedMonthLimit = f_historyLimit()
    firstHistoryIndex = math.max(
         0,
         storedMonthCount - requestedMonthLimit
    )

    separatorStyle = f_style(separatorStyleInput)

    if storedMonthCount > 0

        for selectedMonthIndex = 0 to storedMonthCount - 1

            selectedMonthStart =
                 array.get(
                     monthStartTimes,
                     selectedMonthIndex
                 )

            selectedMonthOpen =
                 array.get(
                     monthOpenPrices,
                     selectedMonthIndex
                 )

            selectedMonthHigh =
                 array.get(
                     monthHighPrices,
                     selectedMonthIndex
                 )

            selectedMonthLow =
                 array.get(
                     monthLowPrices,
                     selectedMonthIndex
                 )

            selectedMonthEnd =
                 selectedMonthIndex < storedMonthCount - 1 ?
                 array.get(
                     monthStartTimes,
                     selectedMonthIndex + 1
                 ) :
                 time_close("1M")

            monthOverlapsVisibleChart =
                 selectedMonthEnd >= visibleLeftTime and
                 selectedMonthStart <= visibleRightTime

            monthInsideHistoryLimit =
                 selectedMonthIndex >= firstHistoryIndex

            displaySelectedMonth =
                 monthOverlapsVisibleChart and
                 monthInsideHistoryLimit

            selectedMonthlyColor =
                 f_monthColor(selectedMonthIndex)

            if displaySelectedMonth

                //----------------------------------------------
                // Repeating month-start vertical separator
                //----------------------------------------------

                if showMonthlySeparators and
                     monthlySeparatorsTimeframeAllowed

                    f_addTimeLine(
                         selectedMonthStart,
                         selectedMonthOpen,
                         selectedMonthStart,
                         selectedMonthOpen,
                         color.new(
                             separatorColor,
                             separatorTransparency
                         ),
                         separatorWidth,
                         separatorStyle,
                         extend.both
                    )

                    if showSeparatorLabels and
                         monthlyLabelsTimeframeAllowed

                        f_addTimeLabel(
                             selectedMonthStart,
                             selectedMonthHigh,
                             str.format_time(
                                 selectedMonthStart,
                                 "MMM yyyy"
                             ),
                             color.new(separatorColor, 20),
                             label.style_label_down,
                             size.tiny
                        )

                //----------------------------------------------
                // Monthly opening-price segment
                //----------------------------------------------

                if showMonthlyOpen and
                     monthlySegmentsTimeframeAllowed

                    f_addTimeLine(
                         selectedMonthStart,
                         selectedMonthOpen,
                         selectedMonthEnd,
                         selectedMonthOpen,
                         color.new(
                             selectedMonthlyColor,
                             monthlyOpenTransparency
                         ),
                         monthlyOpenWidth,
                         line.style_solid,
                         extend.none
                    )

                //----------------------------------------------
                // Monthly high segment
                //----------------------------------------------

                if showMonthlyHigh and
                     monthlySegmentsTimeframeAllowed

                    f_addTimeLine(
                         selectedMonthStart,
                         selectedMonthHigh,
                         selectedMonthEnd,
                         selectedMonthHigh,
                         color.new(
                             monthlyHighColor,
                             monthlyHighLowTransparency
                         ),
                         monthlyHighLowWidth,
                         line.style_dashed,
                         extend.none
                    )

                //----------------------------------------------
                // Monthly low segment
                //----------------------------------------------

                if showMonthlyLow and
                     monthlySegmentsTimeframeAllowed

                    f_addTimeLine(
                         selectedMonthStart,
                         selectedMonthLow,
                         selectedMonthEnd,
                         selectedMonthLow,
                         color.new(
                             monthlyLowColor,
                             monthlyHighLowTransparency
                         ),
                         monthlyHighLowWidth,
                         line.style_dashed,
                         extend.none
                    )

                //----------------------------------------------
                // Monthly O/H/L label
                //----------------------------------------------

                if showMonthlyOHLabels and
                     monthlyLabelsTimeframeAllowed

                    monthlyOHLabelText =
                         str.format_time(
                             selectedMonthStart,
                             "MMM yyyy"
                         ) +
                         "\nO: " +
                         str.tostring(
                             selectedMonthOpen,
                             format.mintick
                         ) +
                         "\nH: " +
                         str.tostring(
                             selectedMonthHigh,
                             format.mintick
                         ) +
                         "\nL: " +
                         str.tostring(
                             selectedMonthLow,
                             format.mintick
                         )

                    f_addTimeLabel(
                         selectedMonthStart,
                         selectedMonthOpen,
                         monthlyOHLabelText,
                         color.new(selectedMonthlyColor, 20),
                         label.style_label_up,
                         size.tiny
                    )

    //==========================================================
    // CURRENT MONTH NEAREST LEVEL
    //==========================================================

    if showNearestMonthlyLevel and
         monthlySegmentsTimeframeAllowed

        f_addTimeLine(
             currentMonthStartTime,
             nearestMonthlyLevel,
             time_close("1M"),
             nearestMonthlyLevel,
             nearestMonthlyColor,
             nearestMonthlyWidth,
             line.style_solid,
             extend.none
        )

        if showNearestMonthlyLabel and
             monthlyLabelsTimeframeAllowed

            nearestLevelDirection =
                 nearestMonthlyDistancePips > 0 ?
                 "above monthly open" :
                 nearestMonthlyDistancePips < 0 ?
                 "below monthly open" :
                 "at monthly open"

            nearestLevelLabelText =
                 "Nearest " +
                 nearestMonthlyLevelName +
                 "\n" +
                 str.tostring(
                     nearestMonthlyLevel,
                     format.mintick
                 ) +
                 "\n" +
                 str.tostring(
                     math.abs(nearestMonthlyDistancePips),
                     "#.0"
                 ) +
                 " pips " +
                 nearestLevelDirection

            f_addBarLabel(
                 bar_index + 3,
                 nearestMonthlyLevel,
                 nearestLevelLabelText,
                 nearestMonthlyColor,
                 label.style_label_left,
                 size.small
            )

    //==========================================================
    // CURRENT PRICE DISTANCE FROM MONTHLY OPEN
    //==========================================================

    if showCurrentMonthDistance and
         monthlyLabelsTimeframeAllowed

        distancePrefix =
             currentPriceDistancePips > 0 ?
             "+" :
             ""

        currentDistanceLabelText =
             "Monthly Open: " +
             str.tostring(
                 currentMonthOpen,
                 format.mintick
             ) +
             "\nCurrent: " +
             str.tostring(
                 close,
                 format.mintick
             ) +
             "\nDistance: " +
             distancePrefix +
             str.tostring(
                 currentPriceDistancePips,
                 "#.0"
             ) +
             " pips"

        currentDistanceColor =
             currentPriceDistancePips > 0 ?
             color.rgb(45, 155, 90) :
             currentPriceDistancePips < 0 ?
             color.rgb(195, 65, 65) :
             color.rgb(120, 120, 120)

        f_addBarLabel(
             bar_index + 3,
             close,
             currentDistanceLabelText,
             currentDistanceColor,
             label.style_label_left,
             size.small
        )

//==============================================================
// 18. PREVIOUS-MONTH RELATIONSHIP
//==============================================================

relationshipPrice =
     relationshipBasis == "Current price" ?
     close :
     currentMonthOpen

relationshipText =
     storedMonthCount < 2 ?
     "Unavailable" :
     relationshipPrice > previousMonthHigh ?
     "Above previous high" :
     relationshipPrice < previousMonthLow ?
     "Below previous low" :
     relationshipPrice > previousMonthMidpoint ?
     "Inside upper half" :
     relationshipPrice < previousMonthMidpoint ?
     "Inside lower half" :
     "At previous midpoint"

relationshipBackground =
     relationshipText == "Above previous high" ?
     color.rgb(35, 145, 80) :
     relationshipText == "Below previous low" ?
     color.rgb(185, 55, 55) :
     color.rgb(100, 105, 115)

if barstate.islast

    table.clear(
         contextTable,
         0,
         0,
         1,
         7
    )

    if showContextTable

        table.cell(
             contextTable,
             0,
             0,
             "Monthly Context",
             text_color=color.white,
             bgcolor=color.rgb(40, 45, 55)
        )

        table.cell(
             contextTable,
             1,
             0,
             relationshipBasis,
             text_color=color.white,
             bgcolor=color.rgb(40, 45, 55)
        )

        table.cell(contextTable, 0, 1, "Current open")

        table.cell(
             contextTable,
             1,
             1,
             str.tostring(
                 currentMonthOpen,
                 format.mintick
             )
        )

        table.cell(contextTable, 0, 2, "Current high")

        table.cell(
             contextTable,
             1,
             2,
             str.tostring(
                 currentMonthHigh,
                 format.mintick
             )
        )

        table.cell(contextTable, 0, 3, "Current low")

        table.cell(
             contextTable,
             1,
             3,
             str.tostring(
                 currentMonthLow,
                 format.mintick
             )
        )

        table.cell(contextTable, 0, 4, "From open")

        table.cell(
             contextTable,
             1,
             4,
             str.tostring(
                 currentPriceDistancePips,
                 "+#.0;-#.0;0.0"
             ) +
             " pips"
        )

        table.cell(contextTable, 0, 5, "Previous high")

        table.cell(
             contextTable,
             1,
             5,
             storedMonthCount > 1 ?
             str.tostring(
                 previousMonthHigh,
                 format.mintick
             ) :
             "N/A"
        )

        table.cell(contextTable, 0, 6, "Previous low")

        table.cell(
             contextTable,
             1,
             6,
             storedMonthCount > 1 ?
             str.tostring(
                 previousMonthLow,
                 format.mintick
             ) :
             "N/A"
        )

        table.cell(contextTable, 0, 7, "Relationship")

        table.cell(
             contextTable,
             1,
             7,
             relationshipText,
             text_color=color.white,
             bgcolor=relationshipBackground
        )

//==============================================================
// 19. ALERT CONDITIONS
//==============================================================

// Monthly open crossing
monthlyOpenCrossed =
     enableMonthlyOpenAlert and
     ta.cross(close, currentMonthOpen)

// Nearest current-month interval touched by candle
nearestMonthlyLevelTouched =
     enableNearestLevelAlert and
     high >= nearestMonthlyLevel and
     low <= nearestMonthlyLevel

newNearestMonthlyTouch =
     nearestMonthlyLevelTouched and
     not nearestMonthlyLevelTouched[1]

// Major 000 crossing
previous000Bucket =
     math.floor(close[1] / majorInterval)

current000Bucket =
     math.floor(close / majorInterval)

level000Crossed =
     enable000Alert and
     current000Bucket != previous000Bucket

// 500 crossing
previous500Bucket =
     math.floor(
         (close[1] - majorInterval * 0.50) /
         majorInterval
     )

current500Bucket =
     math.floor(
         (close - majorInterval * 0.50) /
         majorInterval
     )

level500Crossed =
     enable500Alert and
     previous500Bucket != current500Bucket

// Determine 200 and 800 candidates around the current candle.
alertBaseFromLow =
     math.floor(low / majorInterval) *
     majorInterval

alertBaseFromHigh =
     math.floor(high / majorInterval) *
     majorInterval

alert200FromLow =
     alertBaseFromLow +
     majorInterval * 0.20

alert800FromLow =
     alertBaseFromLow +
     majorInterval * 0.80

alert200FromHigh =
     alertBaseFromHigh +
     majorInterval * 0.20

alert800FromHigh =
     alertBaseFromHigh +
     majorInterval * 0.80

fineLevelTouched =
     enable200800Alert and
     (
         (high >= alert200FromLow and low <= alert200FromLow) or
         (high >= alert800FromLow and low <= alert800FromLow) or
         (high >= alert200FromHigh and low <= alert200FromHigh) or
         (high >= alert800FromHigh and low <= alert800FromHigh)
     )

newFineLevelTouch =
     fineLevelTouched and
     not fineLevelTouched[1]

// Previous-month levels
previousMonthHighCrossed =
     enablePreviousHighLowAlert and
     storedMonthCount > 1 and
     ta.cross(close, previousMonthHigh)

previousMonthLowCrossed =
     enablePreviousHighLowAlert and
     storedMonthCount > 1 and
     ta.cross(close, previousMonthLow)

alertcondition(
     monthlyOpenCrossed,
     "Monthly open crossed",
     "Price crossed the current monthly opening price."
)

alertcondition(
     newNearestMonthlyTouch,
     "Nearest monthly interval touched",
     "Price touched the psychological interval nearest to the current monthly open."
)

alertcondition(
     level000Crossed,
     "000 level crossed",
     "Price crossed a major 000 psychological level."
)

alertcondition(
     level500Crossed,
     "500 level crossed",
     "Price crossed a 500 psychological level."
)

alertcondition(
     newFineLevelTouch,
     "200 or 800 level touched",
     "Price touched a 200 or 800 psychological level."
)

alertcondition(
     previousMonthHighCrossed,
     "Previous-month high crossed",
     "Price crossed the previous month's high."
)

alertcondition(
     previousMonthLowCrossed,
     "Previous-month low crossed",
     "Price crossed the previous month's low."
)