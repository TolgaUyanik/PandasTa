//@version=6
indicator("Swap Viewer - Visualizzatore Swap", overlay = true)

// ============================================================================
// INPUT — DATI SWAP (inserisci qui i valori forniti dal tuo broker)
// Una riga per ogni strumento, formato: SIMBOLO;SwapLong;SwapShort
// I valori vanno inseriti come costo in VALUTA DEL CONTO per 1.0 lotto/giorno
// I decimali puoi scriverli con il punto (-6.50) o con la virgola (-6,50)
// ============================================================================
swapDataInput = input.text_area(
     defval = "EURUSD;-6.50;1.20\nGBPUSD;-4.30;-0.80\nUSDJPY;3.10;-8.40\nUSDCHF;2.00;-5.50\nAUDUSD;-1.80;-0.90\nUSDCAD;-2.50;0.30\nNZDUSD;-2.10;-1.00\nXAUUSD;-8.00;2.50",
     title   = "Elenco Swap: Simbolo;SwapLong;SwapShort",
     tooltip = "Una riga per ogni strumento, formato:\nSIMBOLO;SwapLong;SwapShort\n\nEsempio:\nEURUSD;-6.50;1.20\n\nI valori vanno inseriti come costo in valuta del conto per 1.0 lotto (lotto standard) al giorno: da qui vengono ricavate le colonne 0.1 e 1 lotto.\nI decimali possono usare il punto o la virgola (es. -6.50 oppure -6,50). Il separatore tra i 3 campi deve restare il punto e virgola (;).",
     group   = "Dati Swap")

showDebug = input.bool(false, "Mostra riga diagnostica (righe lette/valide)", group = "Dati Swap", tooltip = "Utile se un valore non compare come previsto: mostra quante righe della lista sono state lette correttamente.")

tripleSwapEnabled = input.bool(true, "Applica Swap Triplo (Rollover)", group = "Swap Triplo", tooltip = "La maggior parte dei broker applica lo swap triplo un giorno alla settimana per compensare la chiusura del weekend. Verifica il giorno esatto con il tuo broker.")
tripleSwapDay     = input.string("Mercoledì", "Giorno dello Swap Triplo", options = ["Domenica", "Lunedì", "Martedì", "Mercoledì", "Giovedì", "Venerdì", "Sabato"], group = "Swap Triplo")

tablePos = input.string("Alto Destra", "Posizione Tabella", options = ["Alto Destra", "Alto Sinistra", "Basso Destra", "Basso Sinistra", "Centro Destra"], group = "Aspetto")
textSize = input.string("Normale", "Dimensione Testo", options = ["Minuscolo", "Piccolo", "Normale", "Grande"], group = "Aspetto")
bgColor       = input.color(color.new(color.black, 10), "Colore Sfondo", group = "Aspetto")
positiveColor = input.color(color.new(color.lime, 0), "Colore Swap Positivo", group = "Aspetto")
negativeColor = input.color(color.new(color.red, 0), "Colore Swap Negativo", group = "Aspetto")

// ============================================================================
// FUNZIONI DI SUPPORTO
// ============================================================================
f_tablePosition(p) =>
    switch p
        "Alto Destra"    => position.top_right
        "Alto Sinistra"  => position.top_left
        "Basso Destra"   => position.bottom_right
        "Basso Sinistra" => position.bottom_left
        "Centro Destra"  => position.middle_right
        => position.top_right

f_textSize(s) =>
    switch s
        "Minuscolo" => size.tiny
        "Piccolo"   => size.small
        "Normale"   => size.normal
        "Grande"    => size.large
        => size.normal

f_dayNum(d) =>
    switch d
        "Domenica"  => dayofweek.sunday
        "Lunedì"    => dayofweek.monday
        "Martedì"   => dayofweek.tuesday
        "Mercoledì" => dayofweek.wednesday
        "Giovedì"   => dayofweek.thursday
        "Venerdì"   => dayofweek.friday
        "Sabato"    => dayofweek.saturday
        => dayofweek.wednesday

f_toNumber(s) =>
    // Normalizza la virgola decimale in punto prima della conversione
    str.tonumber(str.replace_all(str.trim(s), ",", "."))

// ============================================================================
// TABELLA (creata una sola volta) — 3 colonne x 6 righe
// ============================================================================
var table swapTable = table.new(f_tablePosition(tablePos), 3, 6,
     bgcolor = bgColor, border_width = 1, border_color = color.new(color.gray, 50),
     frame_width = 1, frame_color = color.new(color.gray, 50))

// ============================================================================
// LOGICA PRINCIPALE — eseguita solo sull'ultima barra (aggiornamento live)
// ============================================================================
if barstate.islast
    curForexCode = str.upper(syminfo.basecurrency + syminfo.currency)
    curTicker    = str.upper(syminfo.ticker)

    float longSwap  = na
    float shortSwap = na
    bool  found     = false
    string foundSym = ""
    int   totalRows = 0
    int   validRows = 0

    lines = str.split(swapDataInput, "\n")
    for rowStr in lines
        cleanLine = str.trim(rowStr)
        if str.length(cleanLine) > 0
            totalRows += 1
            fields = str.split(cleanLine, ";")
            if array.size(fields) >= 3
                sym = str.upper(str.trim(array.get(fields, 0)))
                lv  = f_toNumber(array.get(fields, 1))
                sv  = f_toNumber(array.get(fields, 2))
                if not na(lv) and not na(sv)
                    validRows += 1
                    if not found and (sym == curForexCode or sym == curTicker)
                        longSwap  := lv
                        shortSwap := sv
                        found     := true
                        foundSym  := sym

    ts = f_textSize(textSize)
    isTripleToday = tripleSwapEnabled and dayofweek == f_dayNum(tripleSwapDay)
    headerBg = color.new(color.gray, 20)

    table.clear(swapTable, 0, 0, 2, 5)

    // Riga 0 — intestazione con simbolo
    table.cell(swapTable, 0, 0, "SWAP", text_color = color.white, bgcolor = headerBg, text_size = ts)
    table.cell(swapTable, 1, 0, found ? foundSym : syminfo.ticker, text_color = color.white, bgcolor = headerBg, text_size = ts)
    table.cell(swapTable, 2, 0, "", bgcolor = headerBg, text_size = ts)

    if found
        // Valore giornaliero per 1.0 lotto (con swap triplo già applicato se attivo oggi)
        longPerLot  = isTripleToday ? longSwap * 3 : longSwap
        shortPerLot = isTripleToday ? shortSwap * 3 : shortSwap

        cost01Long  = longPerLot * 0.1
        cost1Long   = longPerLot * 1.0
        cost01Short = shortPerLot * 0.1
        cost1Short  = shortPerLot * 1.0

        // Riga 1 — intestazioni colonne
        table.cell(swapTable, 0, 1, "", bgcolor = bgColor, text_size = ts)
        table.cell(swapTable, 1, 1, "0.1 Lot", text_color = color.white, text_size = ts, bgcolor = bgColor)
        table.cell(swapTable, 2, 1, "1 Lot", text_color = color.white, text_size = ts, bgcolor = bgColor)

        // Riga 2 — Long
        table.cell(swapTable, 0, 2, "Long", text_color = color.white, text_size = ts, bgcolor = bgColor)
        table.cell(swapTable, 1, 2, str.tostring(cost01Long, "#.##"), text_color = cost01Long >= 0 ? positiveColor : negativeColor, text_size = ts, bgcolor = bgColor)
        table.cell(swapTable, 2, 2, str.tostring(cost1Long, "#.##"), text_color = cost1Long >= 0 ? positiveColor : negativeColor, text_size = ts, bgcolor = bgColor)

        // Riga 3 — Short
        table.cell(swapTable, 0, 3, "Short", text_color = color.white, text_size = ts, bgcolor = bgColor)
        table.cell(swapTable, 1, 3, str.tostring(cost01Short, "#.##"), text_color = cost01Short >= 0 ? positiveColor : negativeColor, text_size = ts, bgcolor = bgColor)
        table.cell(swapTable, 2, 3, str.tostring(cost1Short, "#.##"), text_color = cost1Short >= 0 ? positiveColor : negativeColor, text_size = ts, bgcolor = bgColor)

        // Riga 4 — info swap triplo
        if tripleSwapEnabled
            table.cell(swapTable, 0, 4, "Triplo", text_color = color.gray, text_size = size.tiny, bgcolor = bgColor)
            table.cell(swapTable, 1, 4, tripleSwapDay, text_color = isTripleToday ? color.yellow : color.gray, text_size = size.tiny, bgcolor = bgColor)
            table.cell(swapTable, 2, 4, "", bgcolor = bgColor)
    else
        table.cell(swapTable, 0, 1, "Non trovato", text_color = color.orange, text_size = ts, bgcolor = bgColor)
        table.cell(swapTable, 1, 1, "Aggiungi dati ↑", text_color = color.orange, text_size = ts, bgcolor = bgColor)
        table.cell(swapTable, 2, 1, "", bgcolor = bgColor)

    if showDebug
        table.cell(swapTable, 0, 5, "Righe", text_color = color.gray, text_size = size.tiny, bgcolor = bgColor)
        table.cell(swapTable, 1, 5, str.tostring(validRows) + "/" + str.tostring(totalRows) + " valide", text_color = color.gray, text_size = size.tiny, bgcolor = bgColor)
        table.cell(swapTable, 2, 5, "", bgcolor = bgColor)
