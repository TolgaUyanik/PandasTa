//@version=6
strategy("RONBO Wickless 15m Ultimate Pro", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=50)

// --- Inputs ---
int emaLength = input.int(200, title="Trend EMA Lengte")
float rrRatio = input.float(1.8, title="Risk to Reward Ratio (TP)", step=0.1)
int maxBars = 9 
bool filterVolume = input.bool(true, title="Filter op Hoog Volume")
int volLength = input.int(14, title="Volume Gemiddelde Lengte")
float equityPercent = input.float(50.0, title="Inzet per trade (% van kapitaal)", minval=1.0, maxval=100.0)

// Volatiliteit / XRP Filter
bool useAtrFilter = input.bool(true, title="Filter kleine kaarsen (ATR)")
int atrLength = input.int(14, title="ATR Lengte")
float atrMultiplier = input.float(0.8, title="Minimale Kaarsgrootte (x ATR)", step=0.1)

// Sessie Opties
bool useSessionFilter = input.bool(false, title="Handelen binnen specifieke sessie")
string tradeSession = input.string("0700-2000:1234567", title="Handelsuren (UTC)")

// Break-even Opties
bool useBreakEven = input.bool(true, title="Activeer Break-even Filter")
float beTriggerRatio = input.float(0.9, title="Break-even Trigger (R:R)", step=0.1)

// --- Berekeningen ---
bool inSession = not useSessionFilter or not na(time(timeframe.period, tradeSession, "UTC"))
float emaValue = ta.ema(close, emaLength)
float avgVolume = ta.sma(volume, volLength)
float currentAtr = ta.atr(atrLength)

bool flatBottom = (low == open) or (low == close)
bool flatTop = (high == open) or (high == close)

float candleSize = high - low
bool validAtr = not useAtrFilter or (candleSize > (currentAtr * atrMultiplier))
bool strongVolume = not filterVolume or (volume > avgVolume)
bool strongBody = candleSize > 0 and (math.abs(close - open) / candleSize > 0.4)

// --- Strategie Variabelen ---
var float longLevel = na
var float shortLevel = na
var float longSL = na
var float shortSL = na
var int longTimer = 0
var int shortTimer = 0

var float activeEntry = na
var float activeSL = na
var float activeTP = na
var bool breakEvenTriggered = false

bool bullishTrend = close > emaValue
bool bearishTrend = close < emaValue

// --- Signalen Vastzetten ---
if flatBottom and bullishTrend and strongVolume and strongBody and validAtr and inSession
    longLevel := high
    longSL := low[1] 
    longTimer := 0

if flatTop and bearishTrend and strongVolume and strongBody and validAtr and inSession
    shortLevel := low
    shortSL := high[1] 
    shortTimer := 0

if not na(longLevel)
    longTimer += 1
if not na(shortLevel)
    shortTimer += 1

if longTimer > maxBars
    longLevel := na
if shortTimer > maxBars
    shortLevel := na

// --- Entry & Exit Logica + Alert Berichten ---
if strategy.position_size == 0 and not na(longLevel) and bullishTrend and longTimer <= maxBars
    if low <= longLevel and close > longSL
        float riskPerShare = longLevel - longSL
        if riskPerShare > 0
            float tpTarget = longLevel + (riskPerShare * rrRatio)
            activeEntry := longLevel
            activeSL := longSL
            activeTP := tpTarget
            breakEvenTriggered := false
            
            strategy.entry("RONBO Buy", strategy.long, qty=strategy.equity * (equityPercent / 100) / close, alert_message="Open Long op " + str.tostring(longLevel) + " | SL: " + str.tostring(longSL) + " | TP: " + str.tostring(tpTarget))
            strategy.exit("Exit RONBO Long", "RONBO Buy", stop=longSL, limit=tpTarget, alert_message="Sluit Long (TP of SL geraakt)")
            longLevel := na

if strategy.position_size == 0 and not na(shortLevel) and bearishTrend and shortTimer <= maxBars
    if high >= shortLevel and close < shortSL
        float riskPerShare = shortSL - shortLevel
        if riskPerShare > 0
            float tpTarget = shortLevel - (riskPerShare * rrRatio)
            activeEntry := shortLevel
            activeSL := shortSL
            activeTP := tpTarget
            breakEvenTriggered := false
            
            strategy.entry("RONBO Sell", strategy.short, qty=strategy.equity * (equityPercent / 100) / close, alert_message="Open Short op " + str.tostring(shortLevel) + " | SL: " + str.tostring(activeSL) + " | TP: " + str.tostring(tpTarget))
            strategy.exit("Exit RONBO Short", "RONBO Sell", stop=shortSL, limit=tpTarget, alert_message="Sluit Short (TP of SL geraakt)")
            shortLevel := na

// --- Break-even Manager ---
if strategy.position_size != 0 and useBreakEven and not breakEvenTriggered
    if strategy.position_size > 0 
        float triggerPrice = activeEntry + ((activeEntry - activeSL) * beTriggerRatio)
        if high >= triggerPrice
            strategy.exit("Exit RONBO Long", "RONBO Buy", stop=activeEntry, limit=activeTP, alert_message="Stop Loss verplaatst naar Break-even (Entry)")
            breakEvenTriggered := true
            
    if strategy.position_size < 0 
        float triggerPrice = activeEntry - ((activeSL - activeEntry) * beTriggerRatio)
        if low <= triggerPrice
            strategy.exit("Exit RONBO Short", "RONBO Sell", stop=activeEntry, limit=activeTP, alert_message="Stop Loss verplaatst naar Break-even (Entry)")
            breakEvenTriggered := true

if strategy.position_size == 0
    activeEntry := na
    activeSL := na
    activeTP := na
    breakEvenTriggered := false

if not bullishTrend
    longLevel := na
if not bearishTrend
    shortLevel := na

// --- Visualisatie ---
plot(emaValue, color=color.blue, title="RONBO Trend EMA")
plot(longLevel, title="RONBO Long Level", color=color.green, style=plot.style_linebr, linewidth=2)
plot(shortLevel, title="RONBO Short Level", color=color.red, style=plot.style_linebr, linewidth=2)
bgcolor(useSessionFilter and inSession ? color.new(color.green, 96) : na, title="Handelsuren Achtergrond")