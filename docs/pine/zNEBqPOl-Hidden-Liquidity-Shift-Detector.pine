//@version=5
indicator("Hidden Liquidity Shift Detector", overlay=true, max_bars_back=500)

// === Inputs ===
volumeLookback = input.int(20, "Volume Average Lookback", minval=1)
bodyRatioThreshold = input.float(0.3, "Small Candle Body Threshold (as % of range)", minval=0.05, maxval=1.0)
volMultiplier = input.float(1.5, "Volume Spike Multiplier", minval=1.0)
minWickRatio = input.float(0.4, "Minimum Wick to Body Ratio", minval=0.1)

// === Calculations ===
bodySize = math.abs(close - open)
candleRange = high - low
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bodyRatio = bodySize / candleRange
upperWickRatio = upperWick / bodySize
lowerWickRatio = lowerWick / bodySize

// Volume filter
avgVolume = ta.sma(volume, volumeLookback)
volumeSpike = volume > avgVolume * volMultiplier

// Hidden Absorption Logic
isSmallBody = bodyRatio < bodyRatioThreshold
hasLongUpperWick = upperWickRatio > minWickRatio
hasLongLowerWick = lowerWickRatio > minWickRatio

hiddenSelling = close < open and isSmallBody and hasLongUpperWick and volumeSpike
hiddenBuying  = close > open and isSmallBody and hasLongLowerWick and volumeSpike

// === Plotting ===
plotshape(hiddenBuying, location=location.belowbar, style=shape.circle, color=color.green, size=size.tiny, title="Hidden Buying")
plotshape(hiddenSelling, location=location.abovebar, style=shape.circle, color=color.red, size=size.tiny, title="Hidden Selling")

// === Alerts ===
alertcondition(hiddenBuying, title="Hidden Buying Detected", message="Hidden Buying (Accumulation) Detected on {{ticker}}")
alertcondition(hiddenSelling, title="Hidden Selling Detected", message="Hidden Selling (Distribution) Detected on {{ticker}}")
