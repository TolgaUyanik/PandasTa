//@version=5
library('Complex', true)

//@type Complex number expressed in polar or cartesian coordinates.
//@field R Real part or radius of the complex number.
//@field J Imaginary part or angle (phase) of the complex number.
//@field iP This field is employed to keep track of the coordinates of the number. Note that the functions do not verify this field for the purpose of efficiency.
export type complex
    float   R   // real part or radius
    float   J   // imag part or angle
    bool    iP  // Is polar
    
//@function Calculates the real part of a complex number based on its polar coordinates.
export real(float radius, float angle) =>
    float           out     = radius * math.cos(angle)
    out
    
//@function Calculates the imaginary part of a complex number based on its polar coordinates.
export imag(float radius, float angle) =>
    float           out     = radius * math.sin(angle)
    out
    
//@function Calculates the radius of a complex number based on its cartesian coordinates.
export rds(float real, float imag) =>
    float           out     = math.pow(real * real + imag * imag, 0.5)
    out
    
//@function Calculates the angle of a complex number based on its cartesian coordinates.
export ang(float real, float imag) =>
    float           out     = na
    
    if      real > 0
        out     := math.atan(imag / real)
    else if real < 0
        if      imag > 0
            out := math.atan(imag / real) + math.pi
        else if imag < 0
            out := math.atan(imag / real) - math.pi
        else
            out := math.pi
            
    else
        if      imag > 0
            out := math.pi / 2.0
        else if imag < 0
            out := -math.pi / 2.0
        else
            out := 0.0
            
    out
    
//@function Calculates the real part of a complex number represented in polar coordinates.
//@param c A complex number expressed in polar coordinates.
export method realP(complex c) =>
    float           out     = c.R * math.cos(c.J)
    out
    
//@function Calculates the imaginary part of a complex number represented in polar coordinates.
//@param c A complex number expressed in polar coordinates.
export method imagP(complex c) =>
    float           out     = c.R * math.sin(c.J)
    out
    
//@function Calculates the radius of a complex number represented in cartesian coordinates.
//@param c A complex number expressed in cartesian coordinates.
export method rdsC(complex c) =>
    float           out     = math.pow(c.R * c.R + c.J * c.J, 0.5)
    out
    
//@function Calculates the angle of a complex number represented in cartesian coordinates.
//@param c A complex number expressed in cartesian coordinates.
export method angC(complex c) =>
    float           out     = na
    
    if      c.R > 0
        out     := math.atan(c.J / c.R)
    else if c.R < 0
        if      c.J > 0
            out := math.atan(c.J / c.R) + math.pi
        else if c.J < 0
            out := math.atan(c.J / c.R) - math.pi
        else
            out := math.pi
            
    else
        if      c.J > 0
            out := math.pi / 2.0
        else if c.J < 0
            out := -math.pi / 2.0
        else
            out := 0.0
            
    out
    
//@function Converts a complex number from its polar representation to cartesian.
//@param c A complex number expressed in polar coordinates.
export method toCart(complex c) =>
    complex         out     = complex.new(c.realP(), c.imagP(), false)
    out
    
//@function Converts a complex number from its cartesian representation to polar.
//@param c A complex number expressed in cartesian coordinates.
export method toPolar(complex c) =>
    complex         out     = complex.new(c.rdsC(), c.angC(), true)
    out
    
//@function Calculates the addition of two complex numbers represented in cartesian coordinates.
//@param c First complex number expressed in cartesian coordinates.
//@param z Second complex number expressed in cartesian coordinates.
export method addC(complex c, complex z) =>
    complex         out     = complex.new(c.R + z.R, c.J + z.J, false)
    out
    
//@function Calculates the addition of two complex numbers represented in polar coordinates. Performing addition and subtraction operations in cartesian form of complex numbers is more efficient.
//@param c First complex number expressed in polar coordinates.
//@param z Second complex number expressed in polar coordinates.
export method addP(complex c, complex z) =>
    float           real    = c.realP() + z.realP()
    float           imag    = c.imagP() + z.imagP()
    complex         out     = complex.new(rds(real, imag), ang(real, imag), true)
    out
    
//@function Calculates the subtraction of two complex numbers represented in cartesian coordinates.
//@param c First complex number expressed in cartesian coordinates.
//@param z Second complex number expressed in cartesian coordinates.
export method subC(complex c, complex z) =>
    complex         out     = complex.new(c.R - z.R, c.J - z.J, false)
    out
    
//@function Calculates the subtraction of two complex numbers represented in polar coordinates. 
//@param c First complex number expressed in polar coordinates.
//@param z Second complex number expressed in polar coordinates.
export method subP(complex c, complex z) =>
    float           real    = c.realP() - z.realP()
    float           imag    = c.imagP() - z.imagP()
    complex         out     = complex.new(rds(real, imag), ang(real, imag), true)
    out
    
//@function Calculates the multiplication of two complex numbers represented in cartesian coordinates. Performing multiplication in polar form of complex numbers is more efficient.
//@param c First complex number expressed in cartesian coordinates.
//@param z Second complex number expressed in cartesian coordinates.
export method multC(complex c, complex z) =>
    complex         out     = complex.new(c.R * z.R - c.J * z.J, c.R * z.J + c.J * z.R, false)
    out
    
//@function Calculates the multiplication of two complex numbers represented in polar coordinates.
//@param c First complex number expressed in polar coordinates.
//@param z Second complex number expressed in polar coordinates.
export method multP(complex c, complex z) =>
    complex         out     = complex.new(c.R * z.R, c.J + z.J, true)
    out
    
//@function Exponentiates a complex number represented in cartesian coordinates.
//@param c A complex number expressed in cartesian coordinates.
//@param exp The exponent.
//@param shift The phase shift of the operation. The shift is equal to 2kπ, where k is an integer number from zero to the denominator of the exponent (exclusive). Calculation of the shift value is not included in the function since it isn't always needed and for the purpose of efficiency. Use a for loop to obtain all possible results.
export method powC(complex c, float exp, float shift = 0) =>
    float           rds     = math.pow(c.rdsC(), exp)
    float           ang     = (c.angC() + shift) * exp
    complex         out     = complex.new(real(rds, ang), imag(rds, ang), false)
    out
    
//@function Exponentiates a complex number represented in polar coordinates.
//@param c A complex number expressed in polar coordinates.
//@param exp The exponent.
//@param shift The phase shift of the operation. The shift is equal to 2kπ, where k is an integer number from zero to the denominator of the exponent (exclusive). Calculation of the shift value is not included in the function since it isn't always needed and for the purpose of efficiency. Use a for loop to obtain all possible results.
export method powP(complex c, float exp, float shift = 0) =>
    complex         out     = complex.new(math.pow(c.R, exp), (c.J + shift) * exp, true)
    out
    
//@function Calculates the multiplicative inverse of a complex number represented in cartesian coordinates.
export method invC(complex c) =>
    float           dnm     = c.R * c.R + c.J * c.J
    complex         out     = complex.new(c.R / dnm, -c.J / dnm, false)
    out
    
//@function Calculates the multiplicative inverse of a complex number represented in polar coordinates.
export method invP(complex c) =>
    complex         out     = complex.new(1 / c.R, -c.J, true)
    out
    
//@function Negates a complex number represented in cartesian coordinates.
export method negC(complex c) =>
    complex         out     = complex.new(-c.R, -c.J, false)
    out
    
//@function Negates a complex number represented in polar coordinates.
export method negP(complex c) =>
    complex         out     = complex.new(c.R, c.J - math.pi, true)
    out
    
//@function Calculates the conjugate of a complex number in either forms.
export method con(complex c) =>
    complex         out     = complex.new(c.R, -c.J, c.iP)
    out
    
//@function Calculates the addition of a complex number represented in cartesian coordinates and a real number.
//@param c A complex number expressed in cartesian coordinates.
//@param z A real number.
//@returns The complex number resulted by the addition in cartesian form.
export method fAddC(complex c, float d) =>
    complex         out     = complex.new(c.R + d, c.J, false)
    out
    
//@function Calculates the addition of a complex number represented in polar coordinates and a real number.
//@param c A complex number expressed in polar coordinates.
//@param z A real number.
//@returns The complex number resulted by the addition in polar form.
export method fAddP(complex c, float d) =>
    float           real    = c.realP() + d
    float           imag    = c.imagP()
    complex         out     = complex.new(rds(real, imag), ang(real, imag), true)
    out
    
//@function Calculates the multiplication of a complex number represented in cartesian coordinates and a real number.
//@param c A complex number expressed in cartesian coordinates.
//@param z A real number.
//@returns The complex number resulted by the multiplication in cartesian form.
export method fMultC(complex c, float d) =>
    complex         out     = complex.new(c.R * d, c.J * d, false)
    out
    
//@function Calculates the multiplication of a complex number represented in polar coordinates and a real number.
//@param c A complex number expressed in polar coordinates.
//@param z A real number.
//@returns The complex number resulted by the multiplication in polar form.
export method fMultP(complex c, float d) =>
    complex         out     = complex.new(c.R * math.abs(d), c.J, true)
    
    if math.sign(d) == -1
        out.J -= math.pi
        
    out
    
    