//@version=6
// @description Timeframe utilities library
library("TimeframeUtilsCustom")

// @function Converts timeframe string to minutes
// @param tf String representation of timeframe
// @returns Number of minutes in the given timeframe
export f_timeframe_to_minutes(string tf) =>
    int minutes = 0
    if tf == "1"
        minutes := 1
    else if tf == "2"
        minutes := 2
    else if tf == "3"
        minutes := 3
    else if tf == "5"
        minutes := 5
    else if tf == "10"
        minutes := 10
    else if tf == "15"
        minutes := 15
    else if tf == "20"
        minutes := 20
    else if tf == "30"
        minutes := 30
    else if tf == "45"
        minutes := 45
    else if tf == "60" or tf == "1h" or tf == "1H"
        minutes := 60
    else if tf == "120" or tf == "2h" or tf == "2H"
        minutes := 120
    else if tf == "180" or tf == "3h" or tf == "3H"
        minutes := 180
    else if tf == "240" or tf == "4h" or tf == "4H"
        minutes := 240
    else if tf == "360" or tf == "6h" or tf == "6H"
        minutes := 360
    else if tf == "480" or tf == "8h" or tf == "8H"
        minutes := 480
    else if tf == "720" or tf == "12h" or tf == "12H"
        minutes := 720
    else if tf == "D" or tf == "1D" or tf == "1d"
        minutes := 1440
    else if tf == "W" or tf == "1W" or tf == "1w"
        minutes := 10080
    else if tf == "M" or tf == "1M" or tf == "1m"
        minutes := 43200
    minutes

// @function Calculate number of bars for a specified time period
// @param timeframe_minutes Current timeframe in minutes
// @param hours Number of hours to calculate bars for
// @returns Number of bars representing the specified hours
export f_bars_for_hours(int timeframe_minutes, int hours) =>
    int bars_per_hour = timeframe_minutes > 0 ? math.round(60 / timeframe_minutes) : 60
    int bars_needed = math.round(bars_per_hour * hours)
    bars_needed

// @function Calculate number of bars for a specified number of days
// @param timeframe_minutes Current timeframe in minutes
// @param days Number of days to calculate bars for
// @returns Number of bars representing the specified days
export f_bars_for_days(int timeframe_minutes, int days) =>
    int minutes_per_day = 1440  // 24 hours * 60 minutes
    int total_minutes = math.round(days * minutes_per_day)
    int bars_needed = timeframe_minutes > 0 ? math.round(total_minutes / timeframe_minutes) : total_minutes
    bars_needed