//@version=6
indicator("Justin Dots", overlay=true, max_lines_count=500)

// ─── Inputs ─────────────────────────────────────────────────────────────────
highColor = input.color(color.green, "High Dot Color")
lowColor  = input.color(color.red,   "Low Dot Color")
showHighs = input.bool(true, "Show High Dots")
showLows  = input.bool(true, "Show Low Dots")

// ─── State ──────────────────────────────────────────────────────────────────
var line  highLine    = na
var line  lowLine     = na
var float currentHigh = na
var float currentLow  = na

// ─── Reset at 9:30 market open ───────────────────────────────────────────────
isOpen = hour == 9 and minute == 30

if isOpen
    currentHigh := high
    currentLow  := low
    if showHighs
        highLine := line.new(bar_index, high, bar_index, high,
             color=highColor, style=line.style_dotted, width=2)
    if showLows
        lowLine := line.new(bar_index, low, bar_index, low,
             color=lowColor, style=line.style_dotted, width=2)

// ─── High and low checked independently (not else if) ────────────────────────
if not isOpen and not na(currentHigh)
    if high > currentHigh
        currentHigh := high
        if showHighs
            highLine := line.new(bar_index, high, bar_index, high,
                 color=highColor, style=line.style_dotted, width=2)

    if low < currentLow
        currentLow := low
        if showLows
            lowLine := line.new(bar_index, low, bar_index, low,
                 color=lowColor, style=line.style_dotted, width=2)

// ─── Extend active lines to current bar ──────────────────────────────────────
if showHighs and not na(highLine)
    line.set_x2(highLine, bar_index)
if showLows and not na(lowLine)
    line.set_x2(lowLine, bar_index)