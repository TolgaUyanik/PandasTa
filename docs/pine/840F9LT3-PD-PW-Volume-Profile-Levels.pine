//@version=6
indicator("Session & Weekly Volume Profile Levels (NY 5pm-5pm)", overlay=true, max_lines_count=500, max_labels_count=500)

// --- Shared Settings ---
rows = input.int(100, "Profile Resolution (internal bins)", minval=10, maxval=500, tooltip="Higher = more accurate POC/Value Area. Bars are NOT displayed, this only affects calculation precision.")
vaPercent = input.float(70, "Value Area %", minval=50, maxval=95, step=1)
lineWidth = input.int(2, "Line Width", minval=1, maxval=5)
showLabels = input.bool(true, "Show Text Labels")
labelSize = input.string("normal", "Label Font Size", options=["tiny", "small", "normal", "large", "huge"])

// --- Daily Colors ---
pocColor = input.color(color.yellow, "Daily POC Color", group="Daily")
vahColor = input.color(color.red, "Daily VAH Color", group="Daily")
valColor = input.color(color.new(color.green, 0), "Daily VAL Color", group="Daily")

// --- Weekly Settings ---
weeklyEnabled = input.bool(true, "Show Weekly Levels", group="Weekly")
weeklyPocColor = input.color(color.orange, "Weekly POC Color", group="Weekly")
weeklyVahColor = input.color(color.purple, "Weekly VAH Color", group="Weekly")
weeklyValColor = input.color(color.blue, "Weekly VAL Color", group="Weekly")

// --- Session: 5pm - 5pm New York time, every day ---
sessionString = "1700-1700:1234567"
sessionStart = time("D", sessionString, "America/New_York")
newSession = ta.change(sessionStart) != 0

// --- Weekly session begins whenever the daily rollover happens to land on Sunday (first session back after the weekend close) ---
newWeek = newSession and (dayofweek(sessionStart, "America/New_York") == dayofweek.sunday)

// --- Persistent storage: daily samples ---
var array<float> priceSamples = array.new<float>()
var array<float> volSamples = array.new<float>()

// --- Persistent storage: weekly samples ---
var array<float> weekPriceSamples = array.new<float>()
var array<float> weekVolSamples = array.new<float>()

// --- Persistent line/label refs: daily ---
var line pocLine = na
var line vahLine = na
var line valLine = na
var label pocLbl = na
var label vahLbl = na
var label valLbl = na

// --- Persistent line/label refs: weekly ---
var line wPocLine = na
var line wVahLine = na
var line wValLine = na
var label wPocLbl = na
var label wVahLbl = na
var label wValLbl = na

// --- Pull 1-minute price/volume data for accurate intrasession distribution ---
[lowPrices, lowVolumes] = request.security_lower_tf(syminfo.tickerid, "1", [close, volume])

// --- Helper to map string size input to a label size constant ---
f_size(s) =>
    s == "tiny" ? size.tiny :
     s == "small" ? size.small :
     s == "large" ? size.large :
     s == "huge" ? size.huge : size.normal

lblSize = f_size(labelSize)

// --- On a new DAILY session, finalize the JUST-COMPLETED day's profile ---
if newSession and array.size(priceSamples) > 0
    sessHigh = array.max(priceSamples)
    sessLow = array.min(priceSamples)
    rowHeight = (sessHigh - sessLow) / rows

    if rowHeight > 0
        binVol = array.new_float(rows, 0.0)
        for i = 0 to array.size(priceSamples) - 1
            p = array.get(priceSamples, i)
            v = array.get(volSamples, i)
            idx = int(math.min(math.max(math.floor((p - sessLow) / rowHeight), 0), rows - 1))
            array.set(binVol, idx, array.get(binVol, idx) + v)

        pocIdx = array.indexof(binVol, array.max(binVol))
        totalVol = array.sum(binVol)
        targetVol = totalVol * vaPercent / 100
        cumVol = array.get(binVol, pocIdx)
        upperIdx = pocIdx
        lowerIdx = pocIdx

        while cumVol < targetVol and (upperIdx < rows - 1 or lowerIdx > 0)
            upVol = upperIdx < rows - 1 ? array.get(binVol, upperIdx + 1) : -1.0
            downVol = lowerIdx > 0 ? array.get(binVol, lowerIdx - 1) : -1.0
            if upVol >= downVol
                upperIdx += 1
                cumVol += upVol
            else
                lowerIdx -= 1
                cumVol += downVol

        tick = syminfo.mintick
        pocPrice = math.round((sessLow + (pocIdx + 0.5) * rowHeight) / tick) * tick
        vahPrice = math.round((sessLow + (upperIdx + 1) * rowHeight) / tick) * tick
        valPrice = math.round((sessLow + lowerIdx * rowHeight) / tick) * tick

        if not na(pocLine)
            line.delete(pocLine)
        if not na(vahLine)
            line.delete(vahLine)
        if not na(valLine)
            line.delete(valLine)
        if not na(pocLbl)
            label.delete(pocLbl)
        if not na(vahLbl)
            label.delete(vahLbl)
        if not na(valLbl)
            label.delete(valLbl)

        startTime = time
        endTime = sessionStart + 24 * 60 * 60 * 1000

        pocLine := line.new(startTime, pocPrice, endTime, pocPrice, xloc=xloc.bar_time, color=pocColor, width=lineWidth)
        vahLine := line.new(startTime, vahPrice, endTime, vahPrice, xloc=xloc.bar_time, color=vahColor, width=lineWidth)
        valLine := line.new(startTime, valPrice, endTime, valPrice, xloc=xloc.bar_time, color=valColor, width=lineWidth)

        if showLabels
            pocLbl := label.new(endTime, pocPrice, "POC " + str.tostring(pocPrice), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=pocColor, size=lblSize)
            vahLbl := label.new(endTime, vahPrice, "VAH " + str.tostring(vahPrice), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=vahColor, size=lblSize)
            valLbl := label.new(endTime, valPrice, "VAL " + str.tostring(valPrice), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=valColor, size=lblSize)

// --- On a new WEEKLY session (Sunday 5pm EST), finalize the JUST-COMPLETED week's profile ---
if weeklyEnabled and newWeek and array.size(weekPriceSamples) > 0
    wSessHigh = array.max(weekPriceSamples)
    wSessLow = array.min(weekPriceSamples)
    wRowHeight = (wSessHigh - wSessLow) / rows

    if wRowHeight > 0
        wBinVol = array.new_float(rows, 0.0)
        for i = 0 to array.size(weekPriceSamples) - 1
            p = array.get(weekPriceSamples, i)
            v = array.get(weekVolSamples, i)
            idx = int(math.min(math.max(math.floor((p - wSessLow) / wRowHeight), 0), rows - 1))
            array.set(wBinVol, idx, array.get(wBinVol, idx) + v)

        wPocIdx = array.indexof(wBinVol, array.max(wBinVol))
        wTotalVol = array.sum(wBinVol)
        wTargetVol = wTotalVol * vaPercent / 100
        wCumVol = array.get(wBinVol, wPocIdx)
        wUpperIdx = wPocIdx
        wLowerIdx = wPocIdx

        while wCumVol < wTargetVol and (wUpperIdx < rows - 1 or wLowerIdx > 0)
            wUpVol = wUpperIdx < rows - 1 ? array.get(wBinVol, wUpperIdx + 1) : -1.0
            wDownVol = wLowerIdx > 0 ? array.get(wBinVol, wLowerIdx - 1) : -1.0
            if wUpVol >= wDownVol
                wUpperIdx += 1
                wCumVol += wUpVol
            else
                wLowerIdx -= 1
                wCumVol += wDownVol

        tick2 = syminfo.mintick
        wPocPrice = math.round((wSessLow + (wPocIdx + 0.5) * wRowHeight) / tick2) * tick2
        wVahPrice = math.round((wSessLow + (wUpperIdx + 1) * wRowHeight) / tick2) * tick2
        wValPrice = math.round((wSessLow + wLowerIdx * wRowHeight) / tick2) * tick2

        if not na(wPocLine)
            line.delete(wPocLine)
        if not na(wVahLine)
            line.delete(wVahLine)
        if not na(wValLine)
            line.delete(wValLine)
        if not na(wPocLbl)
            label.delete(wPocLbl)
        if not na(wVahLbl)
            label.delete(wVahLbl)
        if not na(wValLbl)
            label.delete(wValLbl)

        wStartTime = time
        wEndTime = sessionStart + 5 * 24 * 60 * 60 * 1000  // This week's Friday 5pm EST, 5 days after Sunday 5pm open

        wPocLine := line.new(wStartTime, wPocPrice, wEndTime, wPocPrice, xloc=xloc.bar_time, color=weeklyPocColor, width=lineWidth)
        wVahLine := line.new(wStartTime, wVahPrice, wEndTime, wVahPrice, xloc=xloc.bar_time, color=weeklyVahColor, width=lineWidth)
        wValLine := line.new(wStartTime, wValPrice, wEndTime, wValPrice, xloc=xloc.bar_time, color=weeklyValColor, width=lineWidth)

        if showLabels
            wPocLbl := label.new(wEndTime, wPocPrice, "W-POC " + str.tostring(wPocPrice), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=weeklyPocColor, size=lblSize)
            wVahLbl := label.new(wEndTime, wVahPrice, "W-VAH " + str.tostring(wVahPrice), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=weeklyVahColor, size=lblSize)
            wValLbl := label.new(wEndTime, wValPrice, "W-VAL " + str.tostring(wValPrice), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=weeklyValColor, size=lblSize)

// --- Reset daily sample storage for the new (now current, still forming) session ---
if newSession
    array.clear(priceSamples)
    array.clear(volSamples)

// --- Reset weekly sample storage for the new (now current, still forming) week ---
if newWeek
    array.clear(weekPriceSamples)
    array.clear(weekVolSamples)

// --- Accumulate this bar's intrabar samples into both the current day AND current week ---
if not na(lowPrices) and array.size(lowPrices) > 0
    for i = 0 to array.size(lowPrices) - 1
        p = array.get(lowPrices, i)
        v = array.get(lowVolumes, i)
        array.push(priceSamples, p)
        array.push(volSamples, v)
        array.push(weekPriceSamples, p)
        array.push(weekVolSamples, v)