//@version=6
// Prior Day RTH OHLC + Current Session Open
// Plots the most recent completed regular-session Open, High, Low, and Close.
// Adds a user-defined Current Session Open, defaulted to 4:00 a.m. New York time for U.S. equities.
// Designed for intraday charts with extended-hours data enabled.
// This is a reference-level tool, not a trading signal.

indicator(
     title="Prior Day RTH OHLC + Current Session Open",
     shorttitle="PD OHLC + CSO",
     overlay=true,
     max_labels_count=50,
     max_lines_count=25
)

// ===== Inputs =====
showLines  = input.bool(true, title="Show Solid Lines")
showLabels = input.bool(true, title="Show Right Labels")

showPDH = input.bool(true, title="Show PDH")
showPDL = input.bool(true, title="Show PDL")
showPDC = input.bool(true, title="Show PDC")
showPDO = input.bool(true, title="Show PDO")
showCSO = input.bool(true, title="Show CSO / Current Session Open")

rthSession  = input.session("0930-1600", title="Regular Session")
postSession = input.session("1600-2000", title="Post-Market Session")

// Default is U.S. equity premarket + regular + post-market window.
// CSO is captured from the first available bar inside this session.
csoSession = input.session("0400-2000", title="Current Session")
csoTimeZone = input.string("America/New_York", title="Current Session Time Zone")

rightOffset = input.int(8, title="Right Label Offset", minval=1, maxval=50)
lineWidth   = input.int(2, title="Line Width", minval=1, maxval=5)

labelSizeInput = input.string(
     "small",
     title="Label Size",
     options=["auto", "tiny", "small", "normal", "large", "huge"]
)

lSize = labelSizeInput == "auto" ? size.auto :
     labelSizeInput == "tiny" ? size.tiny :
     labelSizeInput == "small" ? size.small :
     labelSizeInput == "normal" ? size.normal :
     labelSizeInput == "large" ? size.large :
     size.huge

// ===== Colors =====
highColor  = input.color(color.red, title="PDH Color")
lowColor   = input.color(color.lime, title="PDL Color")
closeColor = input.color(color.yellow, title="PDC Color")
openColor  = input.color(color.orange, title="PDO Color")
csoColor   = input.color(color.aqua, title="CSO Color")
labelBg    = input.color(color.black, title="Label Background")

// ===== Round to minimum tick =====
nround(x) =>
    math.round(x / syminfo.mintick) * syminfo.mintick

// ===== Session detection =====
// RTH and post-market use the symbol exchange timezone.
inRTH  = not na(time(timeframe.period, rthSession))
inPost = not na(time(timeframe.period, postSession))

rthStart = inRTH and not inRTH[1]
postMarketStart = inPost and not inPost[1]

// CSO uses the selected timezone, defaulting to New York time.
inCSOSession = not na(time(timeframe.period, csoSession, csoTimeZone))

// New calendar day based on the selected CSO timezone.
newDay = ta.change(time("D", "0000-2359", csoTimeZone)) != 0

// ===== Track current regular-session OHLC =====
var float curOpen  = na
var float curHigh  = na
var float curLow   = na
var float curClose = na

if rthStart
    curOpen  := open
    curHigh  := high
    curLow   := low
    curClose := close

if inRTH and not rthStart
    curHigh  := math.max(curHigh, high)
    curLow   := math.min(curLow, low)
    curClose := close

// ===== Most recent completed regular-session OHLC =====
var float pdOpen  = na
var float pdHigh  = na
var float pdLow   = na
var float pdClose = na

// ===== Current Session Open =====
var float cso = na
var bool csoCapturedToday = false

// ===== Solid line objects =====
var line highLine  = na
var line lowLine   = na
var line closeLine = na
var line openLine  = na
var line csoLine   = na

// ===== Right-side labels =====
var label highLabel  = na
var label lowLabel   = na
var label closeLabel = na
var label openLabel  = na
var label csoLabel   = na

// ===== Reset CSO at the start of a new calendar day =====
if newDay
    cso := na
    csoCapturedToday := false

    if not na(csoLine)
        line.delete(csoLine)
        csoLine := na

// ===== Capture CSO from the first available bar inside the CSO session =====
if inCSOSession and not csoCapturedToday
    cso := open
    csoCapturedToday := true

// ===== Lock prior RTH values when post-market starts =====
if postMarketStart
    pdOpen  := curOpen
    pdHigh  := curHigh
    pdLow   := curLow
    pdClose := curClose

    // Delete old prior-day OHLC lines
    if not na(highLine)
        line.delete(highLine)
    if not na(lowLine)
        line.delete(lowLine)
    if not na(closeLine)
        line.delete(closeLine)
    if not na(openLine)
        line.delete(openLine)

    // Create new solid horizontal prior-day OHLC lines.
    // No extend.right, so the lines stop before the labels.
    if showLines
        if showPDH
            highLine := line.new(
                 x1=bar_index,
                 y1=pdHigh,
                 x2=bar_index + rightOffset - 1,
                 y2=pdHigh,
                 extend=extend.none,
                 color=highColor,
                 width=lineWidth
             )

        if showPDL
            lowLine := line.new(
                 x1=bar_index,
                 y1=pdLow,
                 x2=bar_index + rightOffset - 1,
                 y2=pdLow,
                 extend=extend.none,
                 color=lowColor,
                 width=lineWidth
             )

        if showPDC
            closeLine := line.new(
                 x1=bar_index,
                 y1=pdClose,
                 x2=bar_index + rightOffset - 1,
                 y2=pdClose,
                 extend=extend.none,
                 color=closeColor,
                 width=lineWidth
             )

        if showPDO
            openLine := line.new(
                 x1=bar_index,
                 y1=pdOpen,
                 x2=bar_index + rightOffset - 1,
                 y2=pdOpen,
                 extend=extend.none,
                 color=openColor,
                 width=lineWidth
             )

// ===== Create CSO line after CSO is captured =====
if showLines and showCSO and csoCapturedToday and not na(cso) and na(csoLine)
    csoLine := line.new(
         x1=bar_index,
         y1=cso,
         x2=bar_index + rightOffset - 1,
         y2=cso,
         extend=extend.none,
         color=csoColor,
         width=lineWidth
     )

// ===== Keep line endpoints just before the right-side labels =====
if showLines
    if showPDH and not na(pdHigh) and not na(highLine)
        line.set_x2(highLine, bar_index + rightOffset - 1)
        line.set_y1(highLine, pdHigh)
        line.set_y2(highLine, pdHigh)

    if showPDL and not na(pdLow) and not na(lowLine)
        line.set_x2(lowLine, bar_index + rightOffset - 1)
        line.set_y1(lowLine, pdLow)
        line.set_y2(lowLine, pdLow)

    if showPDC and not na(pdClose) and not na(closeLine)
        line.set_x2(closeLine, bar_index + rightOffset - 1)
        line.set_y1(closeLine, pdClose)
        line.set_y2(closeLine, pdClose)

    if showPDO and not na(pdOpen) and not na(openLine)
        line.set_x2(openLine, bar_index + rightOffset - 1)
        line.set_y1(openLine, pdOpen)
        line.set_y2(openLine, pdOpen)

    if showCSO and not na(cso) and not na(csoLine)
        line.set_x2(csoLine, bar_index + rightOffset - 1)
        line.set_y1(csoLine, cso)
        line.set_y2(csoLine, cso)

// ===== If lines are turned off, delete them =====
if not showLines
    if not na(highLine)
        line.delete(highLine)
        highLine := na
    if not na(lowLine)
        line.delete(lowLine)
        lowLine := na
    if not na(closeLine)
        line.delete(closeLine)
        closeLine := na
    if not na(openLine)
        line.delete(openLine)
        openLine := na
    if not na(csoLine)
        line.delete(csoLine)
        csoLine := na

// ===== If individual levels are turned off, delete their lines =====
if not showPDH and not na(highLine)
    line.delete(highLine)
    highLine := na

if not showPDL and not na(lowLine)
    line.delete(lowLine)
    lowLine := na

if not showPDC and not na(closeLine)
    line.delete(closeLine)
    closeLine := na

if not showPDO and not na(openLine)
    line.delete(openLine)
    openLine := na

if not showCSO and not na(csoLine)
    line.delete(csoLine)
    csoLine := na

// ===== Delete and redraw right-side labels each bar =====
if not na(highLabel)
    label.delete(highLabel)
if not na(lowLabel)
    label.delete(lowLabel)
if not na(closeLabel)
    label.delete(closeLabel)
if not na(openLabel)
    label.delete(openLabel)
if not na(csoLabel)
    label.delete(csoLabel)

if showLabels and showPDH and not na(pdHigh)
    highLabel := label.new(
         x=bar_index + rightOffset,
         y=pdHigh,
         text="PDH " + str.tostring(nround(pdHigh), "#.00"),
         style=label.style_label_left,
         textcolor=highColor,
         color=labelBg,
         size=lSize
     )

if showLabels and showPDL and not na(pdLow)
    lowLabel := label.new(
         x=bar_index + rightOffset,
         y=pdLow,
         text="PDL " + str.tostring(nround(pdLow), "#.00"),
         style=label.style_label_left,
         textcolor=lowColor,
         color=labelBg,
         size=lSize
     )

if showLabels and showPDC and not na(pdClose)
    closeLabel := label.new(
         x=bar_index + rightOffset,
         y=pdClose,
         text="PDC " + str.tostring(nround(pdClose), "#.00"),
         style=label.style_label_left,
         textcolor=closeColor,
         color=labelBg,
         size=lSize
     )

if showLabels and showPDO and not na(pdOpen)
    openLabel := label.new(
         x=bar_index + rightOffset,
         y=pdOpen,
         text="PDO " + str.tostring(nround(pdOpen), "#.00"),
         style=label.style_label_left,
         textcolor=openColor,
         color=labelBg,
         size=lSize
     )

if showLabels and showCSO and not na(cso)
    csoLabel := label.new(
         x=bar_index + rightOffset,
         y=cso,
         text="CSO " + str.tostring(nround(cso), "#.00"),
         style=label.style_label_left,
         textcolor=csoColor,
         color=labelBg,
         size=lSize
     )