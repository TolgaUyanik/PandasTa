//@version=6
library("demark_ui")

export f_dashUpdate6x2(
	table dash,
	string c00,
	string c10,
	string c01,
	string c11,
	string c02,
	string c12,
	color c12TextColor,
	string c03,
	string c13,
	string c04,
	string c14,
	string c05,
	string c15,
	color bg,
	color tc,
	string ts
) =>
	// COMPACT_6x2 (single supported dashboard layout)
	table.cell(dash, 0, 0, c00, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 0, c10, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 1, c01, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 1, c11, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 2, c02, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 2, c12, text_color=c12TextColor, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 3, c03, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 3, c13, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 4, c04, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 4, c14, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 5, c05, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 5, c15, text_color=tc, bgcolor=bg, text_size=ts)

export f_dashUpdate7x2(
	table dash,
	string c00,
	string c10,
	string c01,
	string c11,
	string c02,
	string c12,
	color c12TextColor,
	string c03,
	string c13,
	string c04,
	string c14,
	string c05,
	string c15,
	string c06,
	string c16,
	color c16TextColor,
	color bg,
	color tc,
	string ts
) =>
	// COMPACT_7x2 (add one extensible ALERT row)
	table.cell(dash, 0, 0, c00, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 0, c10, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 1, c01, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 1, c11, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 2, c02, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 2, c12, text_color=c12TextColor, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 3, c03, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 3, c13, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 4, c04, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 4, c14, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 5, c05, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 5, c15, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 0, 6, c06, text_color=tc, bgcolor=bg, text_size=ts)
	table.cell(dash, 1, 6, c16, text_color=c16TextColor, bgcolor=bg, text_size=ts)


f_dbgTxtInt(x) => na(x) ? "-" : str.tostring(x)
f_dbgTxtFloat(x) => na(x) ? "-" : str.tostring(x, "#.##")
f_dbgPosFromOpt(string posOpt) =>
	if posOpt == "TOP_LEFT"
		position.top_left
	else if posOpt == "BOTTOM_RIGHT"
		position.bottom_right
	else if posOpt == "BOTTOM_LEFT"
		position.bottom_left
	else
		position.top_right
f_dbgEvTxt(bool supQ, bool supDQ, bool demQ, bool demDQ, bool holdL, bool holdS) =>
	string s = (supQ ? "SupQ " : "") + (supDQ ? "SupDQ " : "") + (demQ ? "DemQ " : "") + (demDQ ? "DemDQ " : "") + (holdL ? "HoldL " : "") + (holdS ? "HoldS " : "")
	s := s == "" ? "-" : s
	s

// TD Lines Truth debug table (display-only). Caller should gate by last-bar for performance.
export f_tdTruthDbgUpdate(
	table tdTruthDbg,
	bool enabled,
	string posOpt,
	string ts,
	color bg,
	color tc,
	int supMain,
	float supMainSc,
	int supSec,
	float supSecSc,
	int supLockRem,
	string supMeta,
	string supStats,
	int demMain,
	float demMainSc,
	int demSec,
	float demSecSc,
	int demLockRem,
	string demMeta,
	string demStats,
	int barIdx,
	bool supQ,
	bool supDQ,
	bool demQ,
	bool demDQ,
	bool holdL,
	bool holdS,
	int supPtsN,
	int demPtsN,
	int supCandN,
	int demCandN,
	int verSup,
	int verDem,
	int minSpanBars,
	int maxAgeBars,
	int supDrawIdx,
	int demDrawIdx,
	bool doCalc,
	bool doUpdate
) =>
	if not enabled
		// Clear cells to effectively hide when debug is OFF.
		color _clrBg = color.new(color.black, 100)
		for r = 0 to 4
			for c = 0 to 6
				table.cell(tdTruthDbg, c, r, "", bgcolor=_clrBg, text_color=_clrBg, text_size=ts)
	else
		table.set_position(tdTruthDbg, f_dbgPosFromOpt(posOpt))
		color _hdrBg = color.new(bg, 0)
		color _hdrTc = tc
		// Header
		table.cell(tdTruthDbg, 0, 0, "TD Lines Truth", text_color=_hdrTc, bgcolor=_hdrBg, text_size=ts)
		table.cell(tdTruthDbg, 1, 0, "idx", text_color=_hdrTc, bgcolor=_hdrBg, text_size=ts)
		table.cell(tdTruthDbg, 2, 0, "score", text_color=_hdrTc, bgcolor=_hdrBg, text_size=ts)
		table.cell(tdTruthDbg, 3, 0, "sec idx", text_color=_hdrTc, bgcolor=_hdrBg, text_size=ts)
		table.cell(tdTruthDbg, 4, 0, "sec sc", text_color=_hdrTc, bgcolor=_hdrBg, text_size=ts)
		table.cell(tdTruthDbg, 5, 0, "lock", text_color=_hdrTc, bgcolor=_hdrBg, text_size=ts)
		table.cell(tdTruthDbg, 6, 0, "meta | stats", text_color=_hdrTc, bgcolor=_hdrBg, text_size=ts)

		// Supply row
		table.cell(tdTruthDbg, 0, 1, "SUP", text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 1, 1, f_dbgTxtInt(supMain), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 2, 1, f_dbgTxtFloat(supMainSc), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 3, 1, f_dbgTxtInt(supSec), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 4, 1, f_dbgTxtFloat(supSecSc), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 5, 1, f_dbgTxtInt(supLockRem), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 6, 1, supMeta + " | " + supStats, text_color=tc, bgcolor=bg, text_size=ts)

		// Demand row
		table.cell(tdTruthDbg, 0, 2, "DEM", text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 1, 2, f_dbgTxtInt(demMain), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 2, 2, f_dbgTxtFloat(demMainSc), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 3, 2, f_dbgTxtInt(demSec), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 4, 2, f_dbgTxtFloat(demSecSc), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 5, 2, f_dbgTxtInt(demLockRem), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 6, 2, demMeta + " | " + demStats, text_color=tc, bgcolor=bg, text_size=ts)

		// Events row (current bar)
		string _evTxt = f_dbgEvTxt(supQ, supDQ, demQ, demDQ, holdL, holdS)
		table.cell(tdTruthDbg, 0, 3, "EV", text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 1, 3, str.tostring(barIdx), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 2, 3, _evTxt, text_color=tc, bgcolor=bg, text_size=ts)
		for c = 3 to 6
			table.cell(tdTruthDbg, c, 3, "", text_color=tc, bgcolor=bg, text_size=ts)

		// Counts/status row
		string _verTxt = str.tostring(verSup) + "/" + str.tostring(verDem)
		string _drawTxt = f_dbgTxtInt(supDrawIdx) + "/" + f_dbgTxtInt(demDrawIdx)
		string _doTxt = (doCalc ? "1" : "0") + " upd " + (doUpdate ? "1" : "0")
		table.cell(tdTruthDbg, 0, 4, "CNT", text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 1, 4, "p " + str.tostring(supPtsN) + "/" + str.tostring(demPtsN), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 2, 4, "c " + str.tostring(supCandN) + "/" + str.tostring(demCandN), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 3, 4, "v " + _verTxt, text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 4, 4, "span≥" + str.tostring(minSpanBars), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 5, 4, "age≤" + str.tostring(maxAgeBars), text_color=tc, bgcolor=bg, text_size=ts)
		table.cell(tdTruthDbg, 6, 4, "draw " + _drawTxt + " | doCalc " + _doTxt, text_color=tc, bgcolor=bg, text_size=ts)
