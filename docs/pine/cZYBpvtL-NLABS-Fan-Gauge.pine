//@version=6
// ============================================================================
// NLABS - Fan Gauge — press / neutral / stand-aside, in one glance
// The oscillator nobody has: measures whether price is FANNING away from a
// rising session VWAP (participation-weighted trend getting stronger) or
// collapsing back into it. Three states, three colors, zero interpretation.
//   PRESS (green)  : above VWAP · gap widening · VWAP rising
//   NEUTRAL (gray) : mixed
//   STAND (red)    : below VWAP · gap widening down · VWAP falling
// Born in the NAUT LABS gauntlet: on 16 years of NQ, long-bounce trades taken
// in the PRESS state carried ~2x the book's average edge, and the STAND state
// carried ~zero (placebo-controlled, subset p<=0.03). It is a CONTEXT DIAL —
// when to lean in, when to sit — not an entry signal.
// DISCLAIMER (NLABS LAW 24): Educational tool. Not financial advice. Measured
// history never guarantees future results. NLABS publishes tools, not promises.
// ============================================================================
indicator("NLABS - Fan Gauge", overlay=false, format=format.price, precision=2)

atr_len   = input.int(14, "ATR Length", minval=2)
widen_len = input.int(3,  "Widening Lookback (bars)", minval=1)
widen_th  = input.float(0.05, "Widening Threshold (ATR units)", step=0.01)
show_bg   = input.bool(true, "Color Background by State")

// session VWAP (resets each new session day)
var float cum_pv = na
var float cum_v  = na
new_day = ta.change(time("D")) != 0
if new_day
    cum_pv := 0.0
    cum_v  := 0.0
tp = (high + low + close) / 3
cum_pv := nz(cum_pv) + tp * volume
cum_v  := nz(cum_v) + volume
float svwap = cum_v > 0 ? cum_pv / cum_v : close

a = ta.atr(atr_len)
float dist  = a > 0 ? (close - svwap) / a : 0.0
float widen = dist - dist[widen_len]
float vslp  = svwap - svwap[widen_len]

bool press = dist > 0 and widen >  widen_th and vslp > 0
bool stand = dist < 0 and widen < -widen_th and vslp < 0
string state = press ? "PRESS" : stand ? "STAND ASIDE" : "NEUTRAL"

col_press = #00d9a5
col_stand = #ff0055
col_neut  = color.new(color.gray, 30)
col_now   = press ? col_press : stand ? col_stand : col_neut

plot(dist, "VWAP Distance (ATR units)", color=col_now, linewidth=2)
hline(0,  "Zero",  color=color.new(color.white, 70))
hline(2,  "+2 ATR", color=color.new(color.gray, 80), linestyle=hline.style_dotted)
hline(-2, "-2 ATR", color=color.new(color.gray, 80), linestyle=hline.style_dotted)
bgcolor(show_bg ? (press ? color.new(col_press, 88) : stand ? color.new(col_stand, 88) : na) : na)

var table T = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(T, 0, 0, state, text_color=color.white, text_size=size.small,
         bgcolor=press ? color.new(col_press, 20) : stand ? color.new(col_stand, 20) : color.new(color.gray, 20))

alertcondition(press and not press[1], "Fan Gauge: PRESS begins", "NLABS Fan Gauge: PRESS state on {{ticker}} {{interval}}")
alertcondition(stand and not stand[1], "Fan Gauge: STAND ASIDE begins", "NLABS Fan Gauge: STAND state on {{ticker}} {{interval}}")
alertcondition((not press and press[1]) or (not stand and stand[1]), "Fan Gauge: back to NEUTRAL", "NLABS Fan Gauge: NEUTRAL on {{ticker}} {{interval}}")