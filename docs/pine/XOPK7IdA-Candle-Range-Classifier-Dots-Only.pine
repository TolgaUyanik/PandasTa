//@version=6
indicator("Candle Range Classifier Dots Only", overlay=true)

// Inputs
lookback = input.int(20, "Lookback Period for Avg Range", minval=1)
wideMult = input.float(1.5, "Wide Range Threshold (x Avg)")
narrowMult = input.float(0.5, "Narrow Range Threshold (x Avg)")
showLabels = input.bool(true, "Show Range Labels")

// Calculate range and average range
candleRange = high - low
avgRange = ta.sma(candleRange, lookback)

// Classify candle range
isWide = candleRange > (avgRange * wideMult)
isNarrow = candleRange < (avgRange * narrowMult)

// Plot dots for wide and narrow ranges only
plotshape(isWide, title="Wide Range Dot", location=location.abovebar, color=color.red, style=shape.circle, size=size.tiny)
plotshape(isNarrow, title="Narrow Range Dot", location=location.belowbar, color=color.blue, style=shape.circle, size=size.tiny)

// Declare a mutable label variable with explicit type annotation
var label lastLabel = na

// Show labels only for wide and narrow ranges
if showLabels and (isWide or isNarrow)
    if not na(lastLabel)
        label.delete(lastLabel)
    lastLabel := label.new(bar_index, high, text=str.tostring(candleRange, format.mintick), style=label.style_label_down, color=isWide ? color.red : color.blue, textcolor=color.white, size=size.tiny)

// Plot candle range and average range
plot(candleRange, "Candle Range", color=color.orange)
plot(avgRange, "Avg Range", color=color.yellow, linewidth=2)

