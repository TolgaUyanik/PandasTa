//@version=6
strategy('manoj betrayed me', overlay = true, pyramiding = 0, process_orders_on_close = true)

// Inputs
len = input.int(20, 'SMMA Length', minval = 1)
targetMult = input.float(2.0, 'Target Multiplier', minval = 0.1)
tradeSession = input.session('0915-1530', 'Trading Session')

// Session filter
inSession = not na(time(timeframe.period, tradeSession))

// Detect session close using exchange timezone
barCloseHour = hour(time_close, syminfo.timezone)
barCloseMinute = minute(time_close, syminfo.timezone)

isSessionCloseBar = inSession and (barCloseHour > 15 or barCloseHour == 15 and barCloseMinute >= 30)

canTrade = inSession and not isSessionCloseBar

// SMMA
smmaHigh = ta.rma(high, len)
smmaLow = ta.rma(low, len)

// Plot SMMA bands
plot(smmaHigh, 'SMMA20 High', color = color.green, linewidth = 2)
plot(smmaLow, 'SMMA20 Low', color = color.red, linewidth = 2)

// Step 1: Signal candle
buySignal = canTrade and close > smmaHigh
sellSignal = canTrade and close < smmaLow

// Step 2: Confirmation candle
buyConfirm = canTrade and buySignal[1] and close > smmaHigh and low > smmaHigh

sellConfirm = canTrade and sellSignal[1] and close < smmaLow and high < smmaLow

// Track pending orders
var int pendingDir = 0
var int pendingBar = na

// Force close all trades at session close
if isSessionCloseBar
    strategy.cancel('Buy')
    strategy.cancel('Sell')
    strategy.close_all(comment = 'Session Close')

    pendingDir := 0
    pendingBar := na
    pendingBar

// Cancel pending order if outside session
if not inSession
    strategy.cancel('Buy')
    strategy.cancel('Sell')

    pendingDir := 0
    pendingBar := na
    pendingBar

// Cancel pending entry if the next candle does not trigger
if pendingDir != 0 and bar_index == pendingBar + 1 and strategy.position_size == 0
    strategy.cancel(pendingDir == 1 ? 'Buy' : 'Sell')

    pendingDir := 0
    pendingBar := na
    pendingBar

if strategy.position_size != 0
    pendingDir := 0
    pendingBar := na
    pendingBar

// Buy trade: entry only above confirmation candle high
if buyConfirm and strategy.position_size == 0
    confirmationHigh = high
    confirmationSize = high - low

    buyEntry = confirmationHigh
    buyStop = smmaLow[1]
    buyTarget = confirmationHigh + targetMult * confirmationSize

    strategy.cancel('Sell')
    strategy.entry('Buy', strategy.long, stop = buyEntry)
    strategy.exit('Buy Exit', 'Buy', stop = buyStop, limit = buyTarget)

    pendingDir := 1
    pendingBar := bar_index
    pendingBar

// Sell trade: entry only below confirmation candle low
if sellConfirm and strategy.position_size == 0
    confirmationLow = low
    confirmationSize = high - low

    sellEntry = confirmationLow
    sellStop = smmaHigh[1]
    sellTarget = confirmationLow - targetMult * confirmationSize

    strategy.cancel('Buy')
    strategy.entry('Sell', strategy.short, stop = sellEntry)
    strategy.exit('Sell Exit', 'Sell', stop = sellStop, limit = sellTarget)

    pendingDir := -1
    pendingBar := bar_index
    pendingBar

// Visual markers
plotshape(buySignal, title = 'Buy Signal', style = shape.circle, location = location.belowbar, color = color.new(color.green, 60), size = size.tiny)
plotshape(sellSignal, title = 'Sell Signal', style = shape.circle, location = location.abovebar, color = color.new(color.red, 60), size = size.tiny)

plotshape(buyConfirm, title = 'Buy Confirmation', style = shape.triangleup, location = location.belowbar, color = color.green, size = size.small)
plotshape(sellConfirm, title = 'Sell Confirmation', style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small)
