//@version=6
// =============================================================================
// Multi Key Levels — original implementation
// Plots HTF OHL levels, session levels, volume-profile POC/VA, day-of-week
// levels, and a midnight-ET open. Includes a merge routine that redraws on
// every bar so merged levels never disappear when a new candle opens.
// =============================================================================
indicator("Multi Key Levels", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ------------------------------------------------------------------ INPUTS ---
grpMain = "Controls"
showHTF   = input.bool(true,  "HTF Levels",       group = grpMain, inline = "r1")
showSess  = input.bool(true,  "Session Levels",   group = grpMain, inline = "r1")
showVP    = input.bool(false, "POC/VA Levels",    group = grpMain, inline = "r2")
showDOW   = input.bool(false, "Day Levels",       group = grpMain, inline = "r2")
showMidO  = input.bool(true,  "Midnight ET Open", group = grpMain, inline = "r3")

// ---- HTF group -------------------------------------------------------------
grpHTF = "HTF Levels"
dCol = input.color(color.new(#2962ff, 0), "Daily",   group = grpHTF, inline = "d")
dO   = input.bool(true, "O", group = grpHTF, inline = "d")
dH   = input.bool(true, "H", group = grpHTF, inline = "d")
dL   = input.bool(true, "L", group = grpHTF, inline = "d")
dM   = input.bool(true, "Mid", group = grpHTF, inline = "d")

wCol = input.color(color.new(#26a69a, 0), "Weekly",  group = grpHTF, inline = "w")
wO   = input.bool(true, "O", group = grpHTF, inline = "w")
wH   = input.bool(true, "H", group = grpHTF, inline = "w")
wL   = input.bool(true, "L", group = grpHTF, inline = "w")
wM   = input.bool(true, "Mid", group = grpHTF, inline = "w")

mCol = input.color(color.new(#ff9800, 0), "Monthly", group = grpHTF, inline = "m")
mO   = input.bool(true, "O", group = grpHTF, inline = "m")
mH   = input.bool(true, "H", group = grpHTF, inline = "m")
mL   = input.bool(true, "L", group = grpHTF, inline = "m")
mM   = input.bool(true, "Mid", group = grpHTF, inline = "m")

usePrev = input.bool(true, "Include previous period levels too", group = grpHTF)

// ---- Session group ---------------------------------------------------------
grpSess = "Session Levels"
s1Col = input.color(color.new(#f06292, 0), "Session 1", group = grpSess, inline = "s1")
s1Def = input.session("0930-1030", "", group = grpSess, inline = "s1")
s1O = input.bool(true, "O", group = grpSess, inline = "s1")
s1H = input.bool(true, "H", group = grpSess, inline = "s1")
s1L = input.bool(true, "L", group = grpSess, inline = "s1")
s1tz = input.string("America/New_York", "S1 timezone", group = grpSess)

s2Col = input.color(color.new(#ba68c8, 0), "Session 2", group = grpSess, inline = "s2")
s2Def = input.session("0300-0400", "", group = grpSess, inline = "s2")
s2O = input.bool(false, "O", group = grpSess, inline = "s2")
s2H = input.bool(true,  "H", group = grpSess, inline = "s2")
s2L = input.bool(true,  "L", group = grpSess, inline = "s2")
s2tz = input.string("Europe/London", "S2 timezone", group = grpSess)

// ---- Midnight open ---------------------------------------------------------
grpMid = "Midnight ET Open"
midCol = input.color(color.new(#7e57c2, 0), "Midnight open color", group = grpMid)
midTz  = "America/New_York"

// ---- Day-of-week group -----------------------------------------------------
grpDOW = "Day of Week Levels"
useMon = input.bool(true,  "Monday",    group = grpDOW, inline = "mo")
monC   = input.color(color.new(#81c784, 0), "", group = grpDOW, inline = "mo")
useTue = input.bool(true,  "Tuesday",   group = grpDOW, inline = "tu")
tueC   = input.color(color.new(#ef9a9a, 0), "", group = grpDOW, inline = "tu")
useWed = input.bool(false, "Wednesday", group = grpDOW, inline = "we")
wedC   = input.color(color.new(#b39ddb, 0), "", group = grpDOW, inline = "we")
dowUseH = input.bool(true, "Show day High/Low", group = grpDOW)

// ---- Volume profile group --------------------------------------------------
grpVP = "Volume Profile Levels"
vpTf   = input.timeframe("D", "VP resolution", group = grpVP)
vpRows = input.int(50, "Rows", minval = 10, maxval = 200, group = grpVP)
vpVA   = input.float(70, "Value Area %", minval = 30, maxval = 95, group = grpVP)
vpPocC = input.color(color.new(#ce93d8, 0), "POC", group = grpVP, inline = "vp")
vpVaC  = input.color(color.new(#ce93d8, 60), "VA", group = grpVP, inline = "vp")
vpShowVA = input.bool(true, "Show VA edges", group = grpVP)

// ---- Appearance ------------------------------------------------------------
grpApp = "Appearance"
showTitle = input.bool(true,  "Title",      group = grpApp, inline = "ap")
showPrice = input.bool(false, "Price",      group = grpApp, inline = "ap")
showDist  = input.bool(false, "% Distance", group = grpApp, inline = "ap")
lvlStyleS = input.string("Solid", "Level Style", options = ["Solid", "Dashed", "Dotted"], group = grpApp)
lvlWidth  = input.int(1, "Level Width", minval = 1, maxval = 5, group = grpApp)
offRight  = input.int(20, "Offset Right (bars)", minval = 0, group = grpApp)
offLeft   = input.int(0,  "Offset Left (bars)",  minval = 0, group = grpApp)
labelSize = input.string("Normal", "Label Size", options = ["Tiny","Small","Normal","Large"], group = grpApp)

mergeOn   = input.bool(true, "Merge Levels", group = grpApp)
mergePct  = input.float(0.05, "Merge overlap %", minval = 0, maxval = 5, step = 0.01, group = grpApp)
traceOrig = input.bool(false, "Trace to origin candle", group = grpApp, tooltip = "Start each level's line at the bar it originated from instead of a fixed left anchor.")

// ----------------------------------------------------------------- HELPERS ---
lineStyleOf(s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

sizeOf(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal

f_style = lineStyleOf(lvlStyleS)
f_size  = sizeOf(labelSize)

var array<float>  prices = array.new<float>()
var array<string> names  = array.new<string>()
var array<color>  cols   = array.new<color>()
var array<int>    origins = array.new<int>()

addLevel(_p, _n, _c, _origin) =>
    if not na(_p)
        array.push(prices, _p)
        array.push(names, _n)
        array.push(cols, _c)
        array.push(origins, na(_origin) ? bar_index : _origin)

// ------------------------------------------------------- HTF DATA (request) ---
[dOpen, dHigh, dLow, dPrevClose] = request.security(syminfo.tickerid, "D", [open, high, low, close[1]], lookahead = barmerge.lookahead_on)
[wOpen, wHigh, wLow] = request.security(syminfo.tickerid, "W", [open, high, low], lookahead = barmerge.lookahead_on)
[moOpen, moHigh, moLow] = request.security(syminfo.tickerid, "M", [open, high, low], lookahead = barmerge.lookahead_on)

[dpO, dpH, dpL] = request.security(syminfo.tickerid, "D", [open[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
[wpO, wpH, wpL] = request.security(syminfo.tickerid, "W", [open[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
[mpO, mpH, mpL] = request.security(syminfo.tickerid, "M", [open[1], high[1], low[1]], lookahead = barmerge.lookahead_on)

// Period-start bars: record the bar_index at the open of each HTF period so
// levels can trace back to where the period began.
var int dStartB = na
var int wStartB = na
var int mStartB = na
if ta.change(time("D")) != 0
    dStartB := bar_index
if ta.change(time("W")) != 0
    wStartB := bar_index
if ta.change(time("M")) != 0
    mStartB := bar_index

// ---------------------------------------------------------- SESSION TRACKING ---
inSess(sess, tz) => not na(time(timeframe.period, sess, tz))

var float s1o = na
var float s1h = na
var float s1l = na
var int s1ob = na
var int s1hb = na
var int s1lb = na
newS1 = inSess(s1Def, s1tz) and not inSess(s1Def, s1tz)[1]
if newS1
    s1o := open
    s1h := high
    s1l := low
    s1ob := bar_index
    s1hb := bar_index
    s1lb := bar_index
else if inSess(s1Def, s1tz)
    if high > nz(s1h, high)
        s1h := high
        s1hb := bar_index
    if low < nz(s1l, low)
        s1l := low
        s1lb := bar_index

var float s2o = na
var float s2h = na
var float s2l = na
var int s2ob = na
var int s2hb = na
var int s2lb = na
newS2 = inSess(s2Def, s2tz) and not inSess(s2Def, s2tz)[1]
if newS2
    s2o := open
    s2h := high
    s2l := low
    s2ob := bar_index
    s2hb := bar_index
    s2lb := bar_index
else if inSess(s2Def, s2tz)
    if high > nz(s2h, high)
        s2h := high
        s2hb := bar_index
    if low < nz(s2l, low)
        s2l := low
        s2lb := bar_index

// ------------------------------------------------------- MIDNIGHT ET OPEN ---
etNewDay = ta.change(dayofmonth(time, midTz)) != 0
var float midOpen = na
var int midOpenB = na
if etNewDay
    midOpen := open
    midOpenB := bar_index

// ---------------------------------------------------------- DAY OF WEEK ---
var float dowO = na
var float dowH = na
var float dowL = na
var int   dowDay = na
var int   dowHb = na
var int   dowLb = na
newDay = ta.change(dayofmonth) != 0
if newDay
    dowO := open
    dowH := high
    dowL := low
    dowDay := dayofweek
    dowHb := bar_index
    dowLb := bar_index
else
    if high > nz(dowH, high)
        dowH := high
        dowHb := bar_index
    if low < nz(dowL, low)
        dowL := low
        dowLb := bar_index

dowColorFor(d) =>
    d == dayofweek.monday and useMon ? monC : d == dayofweek.tuesday and useTue ? tueC : d == dayofweek.wednesday and useWed ? wedC : na

// -------------------------------------------------------- VOLUME PROFILE ---
vpHi = request.security(syminfo.tickerid, vpTf, high, lookahead = barmerge.lookahead_on)
vpLo = request.security(syminfo.tickerid, vpTf, low,  lookahead = barmerge.lookahead_on)

var float vpPoc = na
var float vpVaH = na
var float vpVaL = na
var int   vpStartB = na
var array<float> vol = array.new_float(vpRows, 0.0)
var float pHi = na
var float pLo = na
if barstate.isfirst or na(pHi)
    pHi := vpHi
    pLo := vpLo
    vpStartB := bar_index
vpChange = ta.change(time(vpTf)) != 0
if vpChange
    for i = 0 to vpRows - 1
        array.set(vol, i, 0.0)
    pHi := vpHi
    pLo := vpLo
    vpStartB := bar_index
if not na(pHi) and pHi > pLo
    rng = pHi - pLo
    step = rng / vpRows
    if step > 0
        lo_i = math.max(0, math.floor((low  - pLo) / step))
        hi_i = math.min(vpRows - 1, math.floor((high - pLo) / step))
        if hi_i >= lo_i
            per = volume / (hi_i - lo_i + 1)
            for i = lo_i to hi_i
                array.set(vol, i, array.get(vol, i) + per)
        maxv = 0.0
        maxi = 0
        for i = 0 to vpRows - 1
            if array.get(vol, i) > maxv
                maxv := array.get(vol, i)
                maxi := i
        vpPoc := pLo + (maxi + 0.5) * step
        total = array.sum(vol)
        target = total * vpVA / 100.0
        acc = array.get(vol, maxi)
        lo_e = maxi
        hi_e = maxi
        while acc < target and (lo_e > 0 or hi_e < vpRows - 1)
            below = lo_e > 0 ? array.get(vol, lo_e - 1) : -1.0
            above = hi_e < vpRows - 1 ? array.get(vol, hi_e + 1) : -1.0
            if above >= below
                hi_e += 1
                acc += math.max(above, 0)
            else
                lo_e -= 1
                acc += math.max(below, 0)
        vpVaL := pLo + lo_e * step
        vpVaH := pLo + (hi_e + 1) * step

// =========================================================== COLLECT LEVELS ===
if barstate.islast
    array.clear(prices)
    array.clear(names)
    array.clear(cols)
    array.clear(origins)

    if showHTF
        if dO
            addLevel(dOpen, "dO", dCol, dStartB)
        if dH
            addLevel(dHigh, "dH", dCol, dStartB)
        if dL
            addLevel(dLow, "dL", dCol, dStartB)
        if dM
            addLevel((dHigh + dLow) / 2, "dEQ", dCol, dStartB)
        if usePrev
            addLevel(dpH, "pdH", dCol, dStartB)
            addLevel(dpL, "pdL", dCol, dStartB)
        if wO
            addLevel(wOpen, "wO", wCol, wStartB)
        if wH
            addLevel(wHigh, "wH", wCol, wStartB)
        if wL
            addLevel(wLow, "wL", wCol, wStartB)
        if wM
            addLevel((wHigh + wLow) / 2, "wEQ", wCol, wStartB)
        if usePrev
            addLevel(wpH, "pwH", wCol, wStartB)
            addLevel(wpL, "pwL", wCol, wStartB)
        if mO
            addLevel(moOpen, "mO", mCol, mStartB)
        if mH
            addLevel(moHigh, "mH", mCol, mStartB)
        if mL
            addLevel(moLow, "mL", mCol, mStartB)
        if mM
            addLevel((moHigh + moLow) / 2, "mEQ", mCol, mStartB)

    if showSess
        if s1O
            addLevel(s1o, "s1O", s1Col, s1ob)
        if s1H
            addLevel(s1h, "s1H", s1Col, s1hb)
        if s1L
            addLevel(s1l, "s1L", s1Col, s1lb)
        if s2H
            addLevel(s2h, "s2H", s2Col, s2hb)
        if s2L
            addLevel(s2l, "s2L", s2Col, s2lb)

    if showMidO
        addLevel(midOpen, "MDNT", midCol, midOpenB)

    if showDOW and dowUseH
        c = dowColorFor(dowDay)
        if not na(c)
            addLevel(dowH, "dayH", c, dowHb)
            addLevel(dowL, "dayL", c, dowLb)

    if showVP
        addLevel(vpPoc, "POC", vpPocC, vpStartB)
        if vpShowVA
            addLevel(vpVaH, "VAH", vpVaC, vpStartB)
            addLevel(vpVaL, "VAL", vpVaC, vpStartB)

// ================================================================ MERGE ===
f_merge(array<float> _p, array<string> _n, array<color> _c, array<int> _o) =>
    n = array.size(_p)
    outP = array.new<float>()
    outN = array.new<string>()
    outC = array.new<color>()
    outO = array.new<int>()
    used = array.new<bool>(n, false)
    if n > 0
        for i = 0 to n - 1
            if not array.get(used, i)
                basP = array.get(_p, i)
                basN = array.get(_n, i)
                basC = array.get(_c, i)
                basO = array.get(_o, i)
                cnt = 1
                sumP = basP
                if i < n - 1
                    for j = i + 1 to n - 1
                        if not array.get(used, j)
                            pj = array.get(_p, j)
                            dist = math.abs(pj - basP) / basP * 100.0
                            if dist <= mergePct
                                array.set(used, j, true)
                                basN := basN + " / " + array.get(_n, j)
                                sumP := sumP + pj
                                cnt += 1
                                oj = array.get(_o, j)
                                if not na(oj) and (na(basO) or oj < basO)
                                    basO := oj
                array.push(outP, sumP / cnt)
                array.push(outN, basN)
                array.push(outC, basC)
                array.push(outO, basO)
    [outP, outN, outC, outO]

// ================================================================ DRAW ===
var array<line>  drawnLines  = array.new<line>()
var array<label> drawnLabels = array.new<label>()

f_clearDrawings() =>
    for ln in drawnLines
        line.delete(ln)
    for lb in drawnLabels
        label.delete(lb)
    array.clear(drawnLines)
    array.clear(drawnLabels)

labelText(_n, _p) =>
    t = ""
    if showTitle
        t := _n
    if showPrice
        t := t + (t == "" ? "" : " ") + str.tostring(_p, format.mintick)
    if showDist
        d = (close - _p) / _p * 100.0
        t := t + (t == "" ? "" : " ") + "(" + str.tostring(d, "#.##") + "%)"
    t

if barstate.islast
    f_clearDrawings()
    array<float>  fp = na
    array<string> fn = na
    array<color>  fc = na
    array<int>    fo = na
    if mergeOn
        [mp, mn, mc, mo] = f_merge(prices, names, cols, origins)
        fp := mp
        fn := mn
        fc := mc
        fo := mo
    else
        fp := prices
        fn := names
        fc := cols
        fo := origins
    xDefault = bar_index - offLeft
    xR = bar_index + offRight
    if array.size(fp) > 0
        for i = 0 to array.size(fp) - 1
            p = array.get(fp, i)
            if not na(p)
                ob = array.get(fo, i)
                xL = traceOrig and not na(ob) ? ob : xDefault
                ln = line.new(xL, p, xR, p, xloc = xloc.bar_index, color = array.get(fc, i), style = f_style, width = lvlWidth)
                array.push(drawnLines, ln)
                lb = label.new(xR, p, labelText(array.get(fn, i), p), xloc = xloc.bar_index, style = label.style_label_left, textcolor = array.get(fc, i), color = color.new(color.black, 100), size = f_size)
                array.push(drawnLabels, lb)
