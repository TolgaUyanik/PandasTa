//@version=6
indicator("15-Min Opening Range Projections", shorttitle="15M OR Projections", overlay=true, max_lines_count=500, max_labels_count=500)

// =========================================================================
// INPUTS
// =========================================================================
showHistorical = input.bool(true, title="Show Historical Daily Levels")

// =========================================================================
// CORE VARIABLES
// =========================================================================
var float h15 = na
var float l15 = na
var float range15 = na
var float upperProj = na
var float lowerProj = na

var int barCount = 0

// Line and Label Trackers
var line lineH15 = na
var line lineL15 = na
var line lineUp  = na
var line lineDn  = na

var label lblH15 = na
var label lblL15 = na
var label lblUp  = na
var label lblDn  = na

// =========================================================================
// LOGIC & CALCULATIONS
// =========================================================================
// Detect new trading day using modern timeframe.change
isNewDay = timeframe.change("D")

// Reset counters and values on the first bar of the day
if isNewDay
    barCount := 1
    h15 := high
    l15 := low
else
    barCount += 1

// Update High/Low dynamically for the first 3 bars
if barCount <= 3
    h15 := math.max(h15, high)
    l15 := math.min(l15, low)

// On the 3rd bar (15 minutes in), calculate projections and plot
if barCount == 3
    range15   := h15 - l15
    upperProj := h15 + range15
    lowerProj := l15 - range15

    // Clean up the previous day's lines/labels if historical view is disabled
    if not showHistorical
        line.delete(lineH15)
        line.delete(lineL15)
        line.delete(lineUp)
        line.delete(lineDn)
        label.delete(lblH15)
        label.delete(lblL15)
        label.delete(lblUp)
        label.delete(lblDn)

    // Generate new lines anchored to the start of the day
    lineH15 := line.new(bar_index - 2, h15, bar_index, h15, color=color.green, width=2)
    lineL15 := line.new(bar_index - 2, l15, bar_index, l15, color=color.red, width=2)
    lineUp  := line.new(bar_index - 2, upperProj, bar_index, upperProj, color=color.purple, width=2, style=line.style_dashed)
    lineDn  := line.new(bar_index - 2, lowerProj, bar_index, lowerProj, color=color.purple, width=2, style=line.style_dashed)

    // Generate new transparent-background labels
    lblH15 := label.new(bar_index, h15, "🟢 5M 3-Candle High: " + str.tostring(h15, format.mintick), color=color.new(color.black, 100), textcolor=color.green, style=label.style_label_left, size=size.normal)
    lblL15 := label.new(bar_index, l15, "🔴 5M 3-Candle Low: " + str.tostring(l15, format.mintick), color=color.new(color.black, 100), textcolor=color.red, style=label.style_label_left, size=size.normal)
    lblUp  := label.new(bar_index, upperProj, "🟣 Upper Proj (+Range): " + str.tostring(upperProj, format.mintick), color=color.new(color.black, 100), textcolor=color.purple, style=label.style_label_left, size=size.normal)
    lblDn  := label.new(bar_index, lowerProj, "🟣 Lower Proj (-Range): " + str.tostring(lowerProj, format.mintick), color=color.new(color.black, 100), textcolor=color.purple, style=label.style_label_left, size=size.normal)

// =========================================================================
// DYNAMIC EXTENSION
// =========================================================================
// Continuously extend lines and push labels to the right edge during the day
if barCount >= 3
    line.set_x2(lineH15, bar_index)
    line.set_x2(lineL15, bar_index)
    line.set_x2(lineUp, bar_index)
    line.set_x2(lineDn, bar_index)

    // Offset by +1 bar to give the labels a "floating" effect off the candles
    label.set_x(lblH15, bar_index + 1)
    label.set_x(lblL15, bar_index + 1)
    label.set_x(lblUp, bar_index + 1)
    label.set_x(lblDn, bar_index + 1)