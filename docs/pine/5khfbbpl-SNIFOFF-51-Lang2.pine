// 4. f_trMom — Efficiency momentum labels (4 states)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates efficiency momentum labels.
// @param en The English momentum label.
// @param lang The dashboard language.
// @returns The translated momentum label.
export f_trMom(string en, string lang) =>
    if lang == "हिन्दी"
        switch en
            "Accelerating" => "तेज़ हो रहा"
            "Sharpening"   => "तीक्ष्ण हो रहा"
            "Steady"       => "स्थिर"
            "Fading"       => "कमज़ोर हो रहा"
            => en
    else if lang == "日本語"
        switch en
            "Accelerating" => "加速中"
            "Sharpening"   => "先鋭化"
            "Steady"       => "安定"
            "Fading"       => "減衰中"
            => en
    else if lang == "简体中文"
        switch en
            "Accelerating" => "加速中"
            "Sharpening"   => "趋强中"
            "Steady"       => "稳定"
            "Fading"       => "衰减中"
            => en
    else
        en

