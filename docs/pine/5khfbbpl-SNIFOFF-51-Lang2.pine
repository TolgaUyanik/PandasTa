// ══════════════════════════════════════════════════════════════════════════════════
// SNIFOFF_51_Lang2 — Multilingual dictionary (Group 2) for Smart Trader, SNIF-OFF 5.1
// Distribution: Public open-source (required for public invite-only indicator)
// Languages: English, हिन्दी, 日本語, 简体中文
// Architecture: Identical signatures to SNIFOFF_51_Lang (Library 1).
//   The indicator routes calls to Lang or Lang2 based on the selected language.
// Extensibility: To add a new language, append an else-if branch to each function.
// ══════════════════════════════════════════════════════════════════════════════════

//@version=6

// @description Multilingual translation layer (Group 2) for Smart Trader, SNIF-OFF 5.1, Trade Finder.
//   Provides 21 exported functions with identical signatures to SNIFOFF_51_Lang.
//   Covers: 10 label functions, 3 narrative engines, 6 tooltip functions,
//   1 trend description, and 1 inline label function.
library("SNIFOFF_51_Lang2", overlay = false)

// ══════════════════════════════════════════════════════════════════════════════════
// 1. f_trSig — Trend Engine signal labels (11 states)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates trend engine signal labels.
// @param en The English signal label.
// @param lang The dashboard language selected by the user.
// @returns The translated signal label string.
export f_trSig(string en, string lang) =>
    if lang == "हिन्दी"
        switch en
            "⚡ Bullish Reversal Confirmed ▲" => "⚡ तेज़ी पलटाव पुष्ट ▲"
            "⚡ Bearish Reversal Confirmed ▼" => "⚡ मंदी पलटाव पुष्ट ▼"
            "▲ Bullish Reversal Forming"      => "▲ तेज़ी पलटाव बन रहा है"
            "▼ Bearish Reversal Forming"      => "▼ मंदी पलटाव बन रहा है"
            "▲▲ Strong Uptrend"               => "▲▲ मज़बूत तेज़ी ट्रेंड"
            "▼▼ Strong Downtrend"             => "▼▼ मज़बूत मंदी ट्रेंड"
            "▲ Hidden Bullish Bias"           => "▲ छिपा तेज़ी रुझान"
            "▼ Hidden Bearish Bias"           => "▼ छिपा मंदी रुझान"
            "▲ Uptrend Active"                => "▲ तेज़ी ट्रेंड सक्रिय"
            "▼ Downtrend Active"              => "▼ मंदी ट्रेंड सक्रिय"
            "◆ No Clear Trend"                => "◆ कोई स्पष्ट ट्रेंड नहीं"
            => en
    else if lang == "日本語"
        switch en
            "⚡ Bullish Reversal Confirmed ▲" => "⚡ 強気反転確認 ▲"
            "⚡ Bearish Reversal Confirmed ▼" => "⚡ 弱気反転確認 ▼"
            "▲ Bullish Reversal Forming"      => "▲ 強気反転形成中"
            "▼ Bearish Reversal Forming"      => "▼ 弱気反転形成中"
            "▲▲ Strong Uptrend"               => "▲▲ 強い上昇トレンド"
            "▼▼ Strong Downtrend"             => "▼▼ 強い下降トレンド"
            "▲ Hidden Bullish Bias"           => "▲ 隠れた強気バイアス"
            "▼ Hidden Bearish Bias"           => "▼ 隠れた弱気バイアス"
            "▲ Uptrend Active"                => "▲ 上昇トレンド継続"
            "▼ Downtrend Active"              => "▼ 下降トレンド継続"
            "◆ No Clear Trend"                => "◆ トレンドなし"
            => en
    else if lang == "简体中文"
        switch en
            "⚡ Bullish Reversal Confirmed ▲" => "⚡ 看涨反转确认 ▲"
            "⚡ Bearish Reversal Confirmed ▼" => "⚡ 看跌反转确认 ▼"
            "▲ Bullish Reversal Forming"      => "▲ 看涨反转形成中"
            "▼ Bearish Reversal Forming"      => "▼ 看跌反转形成中"
            "▲▲ Strong Uptrend"               => "▲▲ 强势上升趋势"
            "▼▼ Strong Downtrend"             => "▼▼ 强势下降趋势"
            "▲ Hidden Bullish Bias"           => "▲ 隐性看涨倾向"
            "▼ Hidden Bearish Bias"           => "▼ 隐性看跌倾向"
            "▲ Uptrend Active"                => "▲ 上升趋势活跃"
            "▼ Downtrend Active"              => "▼ 下降趋势活跃"
            "◆ No Clear Trend"                => "◆ 无明确趋势"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 2. f_trConv — Conviction level labels (3 states)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates conviction level labels.
// @param en The English conviction label (HIGH, MODERATE, LOW).
// @param lang The dashboard language.
// @returns The translated conviction label.
export f_trConv(string en, string lang) =>
    if lang == "हिन्दी"
        switch en
            "HIGH"     => "उच्च"
            "MODERATE" => "मध्यम"
            "LOW"      => "निम्न"
            => en
    else if lang == "日本語"
        switch en
            "HIGH"     => "高"
            "MODERATE" => "中"
            "LOW"      => "低"
            => en
    else if lang == "简体中文"
        switch en
            "HIGH"     => "高"
            "MODERATE" => "中"
            "LOW"      => "低"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 3. f_trCoup — Efficiency coupling labels (19 states)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates efficiency coupling labels.
// @param en The English coupling label.
// @param lang The dashboard language.
// @returns The translated coupling label.
export f_trCoup(string en, string lang) =>
    if lang == "हिन्दी"
        switch en
            "⚡ BULL SURGE"          => "⚡ तेज़ी लहर"
            "⚡ BEAR SURGE"          => "⚡ मंदी लहर"
            "BULL CONFIRMED"         => "तेज़ी पुष्ट"
            "BEAR CONFIRMED"         => "मंदी पुष्ट"
            "Bull Active"            => "तेज़ी सक्रिय"
            "Bear Active"            => "मंदी सक्रिय"
            "Bull Stalling"          => "तेज़ी रुकी"
            "Bear Stalling"          => "मंदी रुकी"
            "⚠ STRONG BEAR COUNTER" => "⚠ तीव्र मंदी प्रतिरोध"
            "⚠ STRONG BULL COUNTER" => "⚠ तीव्र तेज़ी प्रतिरोध"
            "Bear Pressure"          => "मंदी दबाव"
            "Bull Pressure"          => "तेज़ी दबाव"
            "Mild Resistance"        => "हल्का प्रतिरोध"
            "Mild Support"           => "हल्का समर्थन"
            "Noise"                  => "शोर"
            "Extreme Move"           => "चरम चाल"
            "Strong Move"            => "मज़बूत चाल"
            "Normal"                 => "सामान्य"
            "Indecisive"             => "अनिर्णीत"
            => en
    else if lang == "日本語"
        switch en
            "⚡ BULL SURGE"          => "⚡ 強気急騰"
            "⚡ BEAR SURGE"          => "⚡ 弱気急落"
            "BULL CONFIRMED"         => "強気確認"
            "BEAR CONFIRMED"         => "弱気確認"
            "Bull Active"            => "強気継続"
            "Bear Active"            => "弱気継続"
            "Bull Stalling"          => "強気停滞"
            "Bear Stalling"          => "弱気停滞"
            "⚠ STRONG BEAR COUNTER" => "⚠ 強い弱気反発"
            "⚠ STRONG BULL COUNTER" => "⚠ 強い強気反発"
            "Bear Pressure"          => "弱気圧力"
            "Bull Pressure"          => "強気圧力"
            "Mild Resistance"        => "軽い抵抗"
            "Mild Support"           => "軽い支持"
            "Noise"                  => "ノイズ"
            "Extreme Move"           => "極端な動き"
            "Strong Move"            => "強い動き"
            "Normal"                 => "通常"
            "Indecisive"             => "方向感なし"
            => en
    else if lang == "简体中文"
        switch en
            "⚡ BULL SURGE"          => "⚡ 多头爆发"
            "⚡ BEAR SURGE"          => "⚡ 空头爆发"
            "BULL CONFIRMED"         => "多头确认"
            "BEAR CONFIRMED"         => "空头确认"
            "Bull Active"            => "多头活跃"
            "Bear Active"            => "空头活跃"
            "Bull Stalling"          => "多头停滞"
            "Bear Stalling"          => "空头停滞"
            "⚠ STRONG BEAR COUNTER" => "⚠ 强力空头反击"
            "⚠ STRONG BULL COUNTER" => "⚠ 强力多头反击"
            "Bear Pressure"          => "空头压力"
            "Bull Pressure"          => "多头压力"
            "Mild Resistance"        => "轻微阻力"
            "Mild Support"           => "轻微支撑"
            "Noise"                  => "噪音"
            "Extreme Move"           => "极端波动"
            "Strong Move"            => "强势波动"
            "Normal"                 => "正常"
            "Indecisive"             => "方向不明"
            => en
    else
        en

