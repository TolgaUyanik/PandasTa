// ══════════════════════════════════════════════════════════════════════════════════
// 6. f_trVolZone — Volume zone display string builder
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the directional arrow + intensity label for the volume zone cell.
// @param zone The volume zone classification.
// @param delta The delta direction integer.
// @param lang The dashboard language.
// @returns The composed volume zone display string.
export f_trVolZone(string zone, int delta, string lang) =>
    string _arrow = delta > 0 ? "▲ " : delta < 0 ? "▼ " : "◆ "
    string _label = ""
    if lang == "हिन्दी"
        _label := zone == "extreme" ? "विस्फोटक वॉल्यूम" : zone == "strong" ? "उच्च वॉल्यूम" : zone == "normal" ? "सामान्य वॉल्यूम" : "बहुत कम वॉल्यूम"
    else if lang == "日本語"
        _label := zone == "extreme" ? "爆発的出来高" : zone == "strong" ? "高出来高" : zone == "normal" ? "通常出来高" : "極めて低い出来高"
    else if lang == "简体中文"
        _label := zone == "extreme" ? "爆发性成交量" : zone == "strong" ? "高成交量" : zone == "normal" ? "适中成交量" : "极低成交量"
    else
        _label := zone == "extreme" ? "Explosive Volume" : zone == "strong" ? "Elevated Volume" : zone == "normal" ? "Moderate Volume" : "Very Low Volume"
    _arrow + _label

// ══════════════════════════════════════════════════════════════════════════════════
// 7. f_trPocCons — POC consensus display string builder
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the volume center agreement label.
// @param count The number of agreeing scales (1-6).
// @param lang The dashboard language.
// @returns The composed POC consensus display string.
export f_trPocCons(int count, string lang) =>
    if lang == "हिन्दी"
        count >= 3 ? str.tostring(count) + " / 6 स्केल सहमत" : count == 2 ? "2 / 6 स्केल सहमत" : "स्केल असहमत"
    else if lang == "日本語"
        count >= 3 ? str.tostring(count) + " / 6 スケール一致" : count == 2 ? "2 / 6 スケール一致" : "スケール不一致"
    else if lang == "简体中文"
        count >= 3 ? str.tostring(count) + " / 6 尺度一致" : count == 2 ? "2 / 6 尺度一致" : "尺度分歧"
    else
        count >= 3 ? str.tostring(count) + " of 6 Scales Agree" : count == 2 ? "2 of 6 Scales Agree" : "Scales Disagree"

// ══════════════════════════════════════════════════════════════════════════════════
// 8. f_trTitle — Dashboard section title translator (3 titles)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates dashboard module header titles.
// @param en The English section title.
// @param lang The dashboard language.
// @returns The translated section title.
export f_trTitle(string en, string lang) =>
    if lang == "हिन्दी"
        switch en
            "TREND ENGINE  ·  Multi-Scale Direction" => "ट्रेंड इंजन  ·  बहु-स्केल दिशा"
            "EFFICIENCY  ·  Move Quality"             => "दक्षता  ·  चाल गुणवत्ता"
            "VOLUME INSIGHT  ·  Market Pressure"      => "वॉल्यूम अंतर्दृष्टि  ·  बाज़ार दबाव"
            => en
    else if lang == "日本語"
        switch en
            "TREND ENGINE  ·  Multi-Scale Direction" => "トレンドエンジン  ·  マルチスケール方向"
            "EFFICIENCY  ·  Move Quality"             => "効率性  ·  動きの質"
            "VOLUME INSIGHT  ·  Market Pressure"      => "出来高分析  ·  市場圧力"
            => en
    else if lang == "简体中文"
        switch en
            "TREND ENGINE  ·  Multi-Scale Direction" => "趋势引擎  ·  多尺度方向"
            "EFFICIENCY  ·  Move Quality"             => "效率  ·  波动质量"
            "VOLUME INSIGHT  ·  Market Pressure"      => "成交量分析  ·  市场压力"
            => en
    else
        en

