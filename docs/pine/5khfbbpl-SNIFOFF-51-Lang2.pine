export f_trBadge(string en, string lang) =>
    if lang == "हिन्दी"
        switch en
            "● ACTIVE" => "● सक्रिय"
            "○ LOCKED" => "○ लॉक"
            "● LIVE"   => "● लाइव"
            "○ HIST"   => "○ इतिहास"
            => en
    else if lang == "日本語"
        switch en
            "● ACTIVE" => "● 稼働中"
            "○ LOCKED" => "○ ロック"
            "● LIVE"   => "● ライブ"
            "○ HIST"   => "○ 履歴"
            => en
    else if lang == "简体中文"
        switch en
            "● ACTIVE" => "● 活跃"
            "○ LOCKED" => "○ 锁定"
            "● LIVE"   => "● 实时"
            "○ HIST"   => "○ 历史"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 10. f_trVolLabel — Volume data row labels (7 labels)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Translates volume data row cell labels.
// @param en The English label.
// @param lang The dashboard language.
// @returns The translated data row label.
export f_trVolLabel(string en, string lang) =>
    if lang == "हिन्दी"
        switch en
            "Total"   => "कुल"
            "Buy"     => "खरीद"
            "Sell"    => "बिक्री"
            "Group"   => "समूह"
            "Maximum" => "अधिकतम"
            "Minimum" => "न्यूनतम"
            "Control" => "नियंत्रण"
            => en
    else if lang == "日本語"
        switch en
            "Total"   => "合計"
            "Buy"     => "買い"
            "Sell"    => "売り"
            "Group"   => "グループ"
            "Maximum" => "最大"
            "Minimum" => "最小"
            "Control" => "支配"
            => en
    else if lang == "简体中文"
        switch en
            "Total"   => "总量"
            "Buy"     => "买入"
            "Sell"    => "卖出"
            "Group"   => "分组"
            "Maximum" => "最大"
            "Minimum" => "最小"
            "Control" => "主导"
            => en
    else
        en

// ══════════════════════════════════════════════════════════════════════════════════
// 11. f_trendNarrative — Trend situation narrative (3-part)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds a human-readable trend situation summary.
// @param cas Cascade active flag.
// @param casDir Cascade direction.
// @param div Divergence active flag.
// @param smD Micro direction.
// @param algn Alignment score (-6 to +6).
// @param mBias Macro bias active flag.
// @param mBiasDir Macro bias direction.
// @param conv Conviction label string.
// @param lang The dashboard language.
// @returns A 3-line narrative string.
export f_trendNarrative(bool cas, int casDir, bool div, int smD, int algn, bool mBias, int mBiasDir, string conv, string lang) =>
    bool _hi = lang == "हिन्दी"
    bool _ja = lang == "日本語"
    bool _zh = lang == "简体中文"
    string _p1 = ""
    if cas
        _p1 := casDir > 0 ? (_hi ? "तेज़ी पलटाव पुष्ट।" : _ja ? "強気反転確認。" : _zh ? "看涨反转确认。" : "Bullish reversal confirmed.") : (_hi ? "मंदी पलटाव पुष्ट।" : _ja ? "弱気反転確認。" : _zh ? "看跌反转确认。" : "Bearish reversal confirmed.")
    else if div
        _p1 := smD > 0 ? (_hi ? "तेज़ी पलटाव बन रहा है।" : _ja ? "強気反転形成中。" : _zh ? "看涨反转形成中。" : "Bullish reversal forming.") : (_hi ? "मंदी पलटाव बन रहा है।" : _ja ? "弱気反転形成中。" : _zh ? "看跌反转形成中。" : "Bearish reversal forming.")
    else if algn >= 5
        _p1 := _hi ? "मज़बूत तेज़ी ट्रेंड स्थापित।" : _ja ? "強い上昇トレンド確立。" : _zh ? "强势上升趋势确立。" : "Strong uptrend established."
    else if algn <= -5
        _p1 := _hi ? "मज़बूत मंदी ट्रेंड स्थापित।" : _ja ? "強い下降トレンド確立。" : _zh ? "强势下降趋势确立。" : "Strong downtrend established."
    else if mBias
        _p1 := mBiasDir > 0 ? (_hi ? "छिपा तेज़ी रुझान पाया गया।" : _ja ? "隠れた強気バイアス検出。" : _zh ? "检测到隐性看涨倾向。" : "Hidden bullish bias detected.") : (_hi ? "छिपा मंदी रुझान पाया गया।" : _ja ? "隠れた弱気バイアス検出。" : _zh ? "检测到隐性看跌倾向。" : "Hidden bearish bias detected.")
    else if algn >= 3
        _p1 := _hi ? "तेज़ी ट्रेंड सक्रिय।" : _ja ? "上昇トレンド継続中。" : _zh ? "上升趋势活跃。" : "Uptrend active."
    else if algn <= -3
        _p1 := _hi ? "मंदी ट्रेंड सक्रिय।" : _ja ? "下降トレンド継続中。" : _zh ? "下降趋势活跃。" : "Downtrend active."
    else
        _p1 := _hi ? "कोई स्पष्ट ट्रेंड नहीं।" : _ja ? "明確なトレンドなし。" : _zh ? "无明确趋势。" : "No clear trend."
    string _p2 = ""
    if cas
        _p2 := casDir > 0 ? (_hi ? "छोटी और मध्यम अवधि ऊपर मुड़ी जबकि व्यापक संरचना अभी भी मंदी में है।" : _ja ? "短期・中期が上向きに転じたが、大局はまだ弱気構造。" : _zh ? "短期和中期已转为上涨，但大格局仍为空头结构。" : "Short and mid-term have turned up while the broader structure is still bearish.") : (_hi ? "छोटी और मध्यम अवधि नीचे मुड़ी जबकि व्यापक संरचना अभी भी तेज़ी में है。" : _ja ? "短期・中期が下向きに転じたが、大局はまだ強気構造。" : _zh ? "短期和中期已转为下跌，但大格局仍为多头结构。" : "Short and mid-term have turned down while the broader structure is still bullish.")
    else if div
        _p2 := smD > 0 ? (_hi ? "छोटी अवधि ऊपर मुड़ी लेकिन व्यापक ट्रेंड ने अभी अनुसरण नहीं किया।" : _ja ? "短期が上向きに転じたが、大局はまだ追随していない。" : _zh ? "短期已转为上涨，但大趋势尚未跟随。" : "Short-term has turned up but the broader trend hasn't followed yet.") : (_hi ? "छोटी अवधि नीचे मुड़ी लेकिन व्यापक ट्रेंड ने अभी अनुसरण नहीं किया。" : _ja ? "短期が下向きに転じたが、大局はまだ追随していない。" : _zh ? "短期已转为下跌，但大趋势尚未跟随。" : "Short-term has turned down but the broader trend hasn't followed yet.")
    else if algn >= 5 or algn <= -5
        _p2 := _hi ? "सभी समय सीमाओं में लगभग पूर्ण सहमति — बहुत स्पष्ट दिशात्मक आम सहमति।" : _ja ? "全時間軸でほぼ完全な合意 — 非常に明確な方向性。" : _zh ? "所有时间周期几乎完全一致 — 方向共识非常明确。" : "Near-total agreement across all time horizons — very clear directional consensus."
    else if mBias
        _p2 := mBiasDir > 0 ? (_hi ? "अल्पकालिक शोर अंतर्निहित तेज़ी दिशा को छिपा रहा है।" : _ja ? "短期ノイズが根底の強気方向を隠している。" : _zh ? "短期噪音掩盖了底层的看涨方向。" : "Short-term noise is masking the underlying bullish direction.") : (_hi ? "अल्पकालिक उछालें अंतर्निहित मंदी दिशा को छिपा रही हैं।" : _ja ? "短期の反発が根底の弱気方向を隠している。" : _zh ? "短期反弹掩盖了底层的看跌方向。" : "Short-term bounces are masking the underlying bearish direction.")
    else if algn >= 3 or algn <= -3
        _p2 := _hi ? "अधिकांश समय सीमाएँ दिशा पर सहमत हैं।" : _ja ? "大半の時間軸が方向に合意している。" : _zh ? "大多数时间周期在方向上达成一致。" : "Majority of time horizons agree on the direction."
    else
        _p2 := _hi ? "बाज़ार बिना किसी प्रमुख दिशा के बग़ली चल रहा है।" : _ja ? "市場は明確な方向なく横ばい推移中。" : _zh ? "市场横盘整理，无主导方向。" : "The market is moving sideways without a dominant direction."
    string _p3 = ""
    if cas or div
        _p3 := conv == "HIGH" ? (_hi ? "इसके पीछे की चालें शक्तिशाली हैं — गंभीरता से लें।" : _ja ? "背後の動きは強力 — 真剣に受け止めよ。" : _zh ? "背后的波动强劲有力 — 需认真对待。" : "The moves behind this are powerful — take it seriously.") : conv == "MODERATE" ? (_hi ? "सामान्य ताकत से विकसित हो रहा — निकट से देखें।" : _ja ? "通常の強さで進行中 — 注視を続けよ。" : _zh ? "以正常力度发展中 — 密切关注。" : "Developing with normal strength — watch closely.") : (_hi ? "संकेत मौजूद लेकिन चालें कमज़ोर — पुष्टि की प्रतीक्षा करें।" : _ja ? "シグナルはあるが動きは弱い — 確認を待て。" : _zh ? "信号已出现但波动较弱 — 等待确认。" : "The signal is present but the moves are weak — wait for confirmation.")
    else if mBias
        _p3 := conv == "HIGH" ? (_hi ? "अंतर्निहित चालें मज़बूत — रुझान जल्द सतह पर आ सकता है।" : _ja ? "根底の動きは強い — バイアスが間もなく表面化する可能性。" : _zh ? "底层波动强劲 — 倾向可能即将显现。" : "The underlying moves are strong — the bias may surface soon.") : conv == "MODERATE" ? (_hi ? "सामान्य ताकत — रुझान वास्तविक लेकिन तत्काल नहीं।" : _ja ? "通常の強さ — バイアスは実在するが緊急ではない。" : _zh ? "正常力度 — 倾向真实但不紧迫。" : "Normal strength — the bias is real but not urgent.") : (_hi ? "चालें शांत — धैर्य आवश्यक।" : _ja ? "動きは静か — 忍耐が必要。" : _zh ? "波动平静 — 需要耐心。" : "The moves are quiet — patience needed.")
    else if algn >= 3 or algn <= -3
        _p3 := conv == "HIGH" ? (_hi ? "चालें शक्तिशाली और निर्णायक — उच्च विश्वास।" : _ja ? "動きは力強く決定的 — 高い確信度。" : _zh ? "波动强劲且果断 — 高确信度。" : "Moves are powerful and decisive — high confidence.") : conv == "MODERATE" ? (_hi ? "सामान्य गति — स्वस्थ लेकिन असाधारण नहीं।" : _ja ? "通常の勢い — 健全だが例外的ではない。" : _zh ? "正常动量 — 健康但不突出。" : "Normal momentum — healthy but not exceptional.") : (_hi ? "दिशा है लेकिन गति पतली — अधिक जोखिम न लें।" : _ja ? "方向はあるが勢いは薄い — 過度なリスクは禁物。" : _zh ? "方向存在但动量不足 — 不宜过度投入。" : "Direction is there but momentum is thin — don't overcommit.")
    else
        _p3 := conv == "HIGH" ? (_hi ? "चालें ताकत पकड़ रही हैं — ब्रेकआउट निकट हो सकता है।" : _ja ? "動きが強さを増している — ブレイクアウトが近い可能性。" : _zh ? "波动正在增强 — 突破可能临近。" : "Moves are gaining strength — a breakout may be near.") : conv == "MODERATE" ? (_hi ? "अस्थिर स्थितियाँ जारी रहने की उम्मीद।" : _ja ? "不安定な状況が続く見通し。" : _zh ? "预计震荡行情将持续。" : "Expect continued choppy conditions.") : (_hi ? "कमज़ोर, दिशाहीन बाज़ार — स्पष्टता के लिए प्रतीक्षा करना सबसे अच्छा।" : _ja ? "弱く方向感のない相場 — 明確になるまで待つのが最善。" : _zh ? "弱势、无方向的市场 — 最好等待明朗化。" : "Weak, directionless market — best to wait for clarity.")
    _p1 + "\n" + _p2 + "\n" + _p3

// ══════════════════════════════════════════════════════════════════════════════════
// 12. f_effNarrative — Efficiency situation narrative (2-part)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds a human-readable efficiency situation summary.
// @param rz Rank zone string.
// @param al Aligned flag.
// @param op Opposed flag.
// @param td Trend direction.
// @param mom Momentum label string.
// @param lang The dashboard language.
// @returns A 2-line narrative string.
export f_effNarrative(string rz, bool al, bool op, int td, string mom, string lang) =>
    bool _hi = lang == "हिन्दी"
    bool _ja = lang == "日本語"
    bool _zh = lang == "简体中文"
    string _sit = ""
    if al
        if rz == "extreme"
            _sit := td > 0 ? (_hi ? "तेज़ी ट्रेंड को आगे बढ़ाती विस्फोटक चाल।" : _ja ? "上昇トレンドを推進する爆発的な動き。" : _zh ? "爆发性波动推动上升趋势前进。" : "Explosive move driving the uptrend forward.") : (_hi ? "मंदी ट्रेंड को आगे बढ़ाती विस्फोटक चाल।" : _ja ? "下降トレンドを推進する爆発的な動き。" : _zh ? "爆发性波动推动下降趋势前进。" : "Explosive move driving the downtrend forward.")
        else if rz == "strong"
            _sit := td > 0 ? (_hi ? "तेज़ी ट्रेंड का समर्थन करती मज़बूत चाल।" : _ja ? "上昇トレンドを支える強い動き。" : _zh ? "强势波动支撑上升趋势。" : "Strong move supporting the uptrend.") : (_hi ? "मंदी ट्रेंड का समर्थन करती मज़बूत चाल।" : _ja ? "下降トレンドを支える強い動き。" : _zh ? "强势波动支撑下降趋势。" : "Strong move supporting the downtrend.")
        else if rz == "normal"
            _sit := td > 0 ? (_hi ? "तेज़ी दिशा में सामान्य चाल।" : _ja ? "上昇方向への通常の動き。" : _zh ? "上升趋势方向的正常波动。" : "Normal move in uptrend direction.") : (_hi ? "मंदी दिशा में सामान्य चाल।" : _ja ? "下降方向への通常の動き。" : _zh ? "下降趋势方向的正常波动。" : "Normal move in downtrend direction.")
        else
            _sit := td > 0 ? (_hi ? "तेज़ी ट्रेंड बमुश्किल आगे बढ़ रहा है।" : _ja ? "上昇トレンドがかろうじて前進。" : _zh ? "上升趋势勉强前进。" : "The uptrend is barely making headway.") : (_hi ? "मंदी ट्रेंड बमुश्किल आगे बढ़ रहा है।" : _ja ? "下降トレンドがかろうじて前進。" : _zh ? "下降趋势勉强前进。" : "The downtrend is barely making headway.")
    else if op
        if rz == "extreme"
            _sit := td > 0 ? (_hi ? "तेज़ी ट्रेंड को खतरा पहुँचाती चरम प्रतिकूल चाल।" : _ja ? "上昇トレンドを脅かす極端な逆行。" : _zh ? "极端反向波动威胁上升趋势。" : "Extreme counter-move threatening the uptrend.") : (_hi ? "मंदी ट्रेंड को खतरा पहुँचाती चरम प्रतिकूल चाल।" : _ja ? "下降トレンドを脅かす極端な逆行。" : _zh ? "极端反向波动威胁下降趋势。" : "Extreme counter-move threatening the downtrend.")
        else if rz == "strong"
            _sit := td > 0 ? (_hi ? "तेज़ी ट्रेंड के विरुद्ध महत्वपूर्ण दबाव।" : _ja ? "上昇トレンドに対する大きな圧力。" : _zh ? "对上升趋势的重大压力。" : "Significant push against the uptrend.") : (_hi ? "मंदी ट्रेंड के विरुद्ध महत्वपूर्ण दबाव।" : _ja ? "下降トレンドに対する大きな圧力。" : _zh ? "对下降趋势的重大压力。" : "Significant push against the downtrend.")
        else if rz == "normal"
            _sit := td > 0 ? (_hi ? "तेज़ी ट्रेंड में मामूली पुलबैक।" : _ja ? "上昇トレンド内の軽い押し目。" : _zh ? "上升趋势中的小幅回调。" : "Minor pullback within the uptrend.") : (_hi ? "मंदी ट्रेंड में हल्की उछाल।" : _ja ? "下降トレンド内の軽い反発。" : _zh ? "下降趋势中的轻微反弹。" : "Light bounce within the downtrend.")
        else
            _sit := _hi ? "ट्रेंड के विरुद्ध नगण्य चाल — शोर।" : _ja ? "トレンドに対する無視できる動き — ノイズ。" : _zh ? "对趋势的微不足道波动 — 噪音。" : "Negligible move against the trend — noise."
    else
        if rz == "extreme"
            _sit := _hi ? "ट्रेंडहीन बाज़ार में विस्फोटक चाल।" : _ja ? "トレンドなし市場での爆発的な動き。" : _zh ? "无趋势市场中的爆发性波动。" : "Explosive move in a trendless market."
        else if rz == "strong"
            _sit := _hi ? "स्थापित ट्रेंड के बिना मज़बूत चाल।" : _ja ? "確立されたトレンドなしの強い動き。" : _zh ? "无确立趋势的强势波动。" : "Strong move without an established trend."
        else if rz == "normal"
            _sit := _hi ? "कोई स्पष्ट ट्रेंड नहीं, सामान्य गतिविधि।" : _ja ? "トレンドなし、通常の活動。" : _zh ? "无明确趋势，正常活动。" : "Ordinary activity with no clear trend."
        else
            _sit := _hi ? "सपाट, दिशाहीन बाज़ार।" : _ja ? "平坦で方向感のない相場。" : _zh ? "平坦、无方向的市场。" : "Flat, directionless market."
    string _trj = ""
    if al
        _trj := mom == "Accelerating" ? (_hi ? "गुणवत्ता तेज़ी से बढ़ रही — मज़बूत जारी रहने की उम्मीद।" : _ja ? "品質が急上昇 — 強い継続が予想される。" : _zh ? "质量急剧提升 — 预期强势延续。" : "Quality surging — strong continuation expected.") : mom == "Sharpening" ? (_hi ? "गुणवत्ता में सुधार — स्वस्थ ट्रेंड व्यवहार।" : _ja ? "品質が改善中 — 健全なトレンド挙動。" : _zh ? "质量改善中 — 健康的趋势行为。" : "Quality improving — healthy trend behavior.") : mom == "Steady" ? (_hi ? "गुणवत्ता स्थिर — तनाव के कोई संकेत नहीं。" : _ja ? "品質は安定 — ストレスの兆候なし。" : _zh ? "质量稳定 — 无压力迹象。" : "Quality is stable — no signs of stress.") : (_hi ? "गुणवत्ता गिर रही — थकान के संकेतों पर ध्यान दें。" : _ja ? "品質が低下中 — 消耗の兆候に注意。" : _zh ? "质量下降中 — 注意衰竭信号。" : "Quality declining — watch for exhaustion.")
    else if op
        if rz == "weak"
            _trj := ""
        else
            _trj := mom == "Accelerating" ? (_hi ? "गुणवत्ता तेज़ी से बढ़ रही — ट्रेंड पर दबाव बढ़ रहा है。" : _ja ? "品質が急上昇 — トレンドへの圧力が増大中。" : _zh ? "质量快速提升 — 趋势压力正在增加。" : "Quality rising fast — pressure on the trend is building.") : mom == "Sharpening" ? (_hi ? "गुणवत्ता धीरे-धीरे बढ़ रही — ट्रेंड को ध्यान से देखें。" : _ja ? "品質が徐々に改善 — トレンドを注視せよ。" : _zh ? "质量逐步改善 — 密切关注趋势。" : "Quality gradually improving — watch the trend carefully.") : mom == "Steady" ? (_hi ? "संभवतः सामान्य सुधार, पलटाव नहीं。" : _ja ? "おそらく通常の調整、反転ではない。" : _zh ? "可能是正常回调，非反转。" : "Likely a normal correction, not a reversal.") : (_hi ? "गुणवत्ता गिर रही — ट्रेंड को इसे अवशोषित करना चाहिए。" : _ja ? "品質が低下中 — トレンドがこれを吸収するはず。" : _zh ? "质量下降中 — 趋势应能吸收此波动。" : "Quality fading — the trend should absorb this.")
    else
        _trj := mom == "Accelerating" ? (_hi ? "गुणवत्ता तेज़ी से बढ़ रही — नया ट्रेंड बन सकता है。" : _ja ? "品質が急上昇 — 新トレンド形成の可能性。" : _zh ? "质量急剧提升 — 新趋势可能正在形成。" : "Quality surging — a new trend may be forming.") : mom == "Sharpening" ? (_hi ? "गुणवत्ता धीरे-धीरे बढ़ रही — ब्रेकआउट पर नज़र रखें。" : _ja ? "品質が徐々に改善 — ブレイクアウトに注目。" : _zh ? "质量缓慢改善 — 关注突破。" : "Quality slowly improving — watch for a breakout.") : mom == "Steady" ? (_hi ? "गति में कोई बदलाव नहीं — उत्प्रेरक की प्रतीक्षा।" : _ja ? "勢いに変化なし — きっかけ待ち。" : _zh ? "动量无变化 — 等待催化剂。" : "No momentum shift — waiting for a catalyst.") : (_hi ? "गुणवत्ता गिर रही — अस्थिर कारोबार की उम्मीद।" : _ja ? "品質が低下中 — 不安定な展開が続く見通し。" : _zh ? "质量下降中 — 预计震荡行情持续。" : "Quality declining — expect continued choppy action.")
    _sit + "\n" + _trj

// ══════════════════════════════════════════════════════════════════════════════════
// 13. f_volNarrative — Volume situation narrative (3-part + live alert)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds a human-readable 3-line volume situation summary.
// @param sid Scenario ID (S1–S16).
// @param td Trend direction.
// @param pocCon Volume center consensus count.
// @param pocMidPrice Consensus center price.
// @param conv Conviction label.
// @param mom Efficiency momentum label.
// @param liveAlert Explosive bar volume spike flag.
// @param lang The dashboard language.
// @returns A multi-line narrative string.
export f_volNarrative(string sid, int td, int pocCon, float pocMidPrice, string conv, string mom, bool liveAlert, string lang) =>
    bool _hi = lang == "हिन्दी"
    bool _ja = lang == "日本語"
    bool _zh = lang == "简体中文"
    string _poc = str.tostring(pocMidPrice, format.mintick)
    string _pocN = str.tostring(pocCon)
    string _p1 = switch sid
        "S1"  => td > 0 ? (_hi ? "असाधारण खरीद दबाव तेज़ी ट्रेंड की पूर्ण पुष्टि करता है।" : _ja ? "異常な買い圧力が上昇トレンドを完全に確認。" : _zh ? "异常买入压力完全确认上升趋势。" : "Exceptional buying pressure fully confirms the uptrend.") : (_hi ? "असाधारण बिक्री दबाव मंदी ट्रेंड की पूर्ण पुष्टि करता है।" : _ja ? "異常な売り圧力が下降トレンドを完全に確認。" : _zh ? "异常卖出压力完全确认下降趋势。" : "Exceptional selling pressure fully confirms the downtrend.")
        "S2"  => td > 0 ? (_hi ? "ठोस खरीद वॉल्यूम तेज़ी ट्रेंड का समर्थन करता है।" : _ja ? "堅実な買い出来高が上昇トレンドを支持。" : _zh ? "坚实的买入量支撑上升趋势。" : "Solid buying volume supports the uptrend.") : (_hi ? "ठोस बिक्री वॉल्यूम मंदी ट्रेंड का समर्थन करता है।" : _ja ? "堅実な売り出来高が下降トレンドを支持。" : _zh ? "坚实的卖出量支撑下降趋势。" : "Solid selling volume supports the downtrend.")
        "S3"  => td > 0 ? (_hi ? "खरीद तेज़ी ट्रेंड का समर्थन करती है लेकिन वॉल्यूम उल्लेखनीय नहीं।" : _ja ? "買いが上昇トレンドを支持するが出来高は目立たない。" : _zh ? "买入有利于上升趋势但成交量不突出。" : "Buying favors the uptrend but volume is unremarkable.") : (_hi ? "बिक्री मंदी ट्रेंड का समर्थन करती है लेकिन वॉल्यूम उल्लेखनीय नहीं।" : _ja ? "売りが下降トレンドを支持するが出来高は目立たない。" : _zh ? "卖出有利于下降趋势但成交量不突出。" : "Selling favors the downtrend but volume is unremarkable.")
        "S4"  => td > 0 ? (_hi ? "चरम बिक्री दबाव तेज़ी ट्रेंड के विरुद्ध धकेल रहा है।" : _ja ? "極端な売り圧力が上昇トレンドに逆行。" : _zh ? "极端卖出压力正在对抗上升趋势。" : "Extreme selling pressure is pushing against the uptrend.") : (_hi ? "चरम खरीद दबाव मंदी ट्रेंड के विरुद्ध धकेल रहा है।" : _ja ? "極端な買い圧力が下降トレンドに逆行。" : _zh ? "极端买入压力正在对抗下降趋势。" : "Extreme buying pressure is pushing against the downtrend.")
        "S5"  => td > 0 ? (_hi ? "तेज़ी ट्रेंड के विरुद्ध महत्वपूर्ण बिक्री जमा हो रही है।" : _ja ? "上昇トレンドに対し大きな売りが蓄積中。" : _zh ? "显著卖出正在积聚对抗上升趋势。" : "Significant selling is building against the uptrend.") : (_hi ? "मंदी ट्रेंड के विरुद्ध महत्वपूर्ण खरीद जमा हो रही है।" : _ja ? "下降トレンドに対し大きな買いが蓄積中。" : _zh ? "显著买入正在积聚对抗下降趋势。" : "Significant buying is building against the downtrend.")
        "S6"  => td > 0 ? (_hi ? "तेज़ी ट्रेंड के विरुद्ध मामूली बिक्री — संभवतः शोर।" : _ja ? "上昇トレンドに対する軽微な売り — おそらくノイズ。" : _zh ? "对上升趋势的轻微卖出 — 可能是噪音。" : "Minor selling against the uptrend — likely noise.") : (_hi ? "मंदी ट्रेंड के विरुद्ध मामूली खरीद — संभवतः शोर।" : _ja ? "下降トレンドに対する軽微な買い — おそらくノイズ。" : _zh ? "对下降趋势的轻微买入 — 可能是噪音。" : "Minor buying against the downtrend — likely noise.")
        "S7"  => _hi ? "स्पष्ट ट्रेंड के बिना चरम एकतरफ़ा वॉल्यूम — ब्रेकआउट उम्मीदवार।" : _ja ? "明確なトレンドなしに極端な一方的出来高 — ブレイクアウト候補。" : _zh ? "无明确趋势下的极端单边成交量 — 突破候选。" : "Extreme one-sided volume without a clear trend — breakout candidate."
        "S8"  => _hi ? "वॉल्यूम न्यूनतम और संतुलित — किसी भी पक्ष से कोई सार्थक दबाव नहीं।" : _ja ? "出来高は最小限で均衡 — どちらからも有意な圧力なし。" : _zh ? "成交量最小且均衡 — 任何一方均无有意义的压力。" : "Volume is minimal and balanced — no meaningful pressure from either side."
        "S9"  => _hi ? "कीमत " + _poc + " पर मज़बूत बहु-स्केल वॉल्यूम केंद्र से दूर हो गई।" : _ja ? "価格が" + _poc + "の強力な多スケール出来高中心から離れた。" : _zh ? "价格已远离" + _poc + "处的强多尺度成交量中心。" : "Price has moved away from a strong multi-scale volume center at " + _poc + "."
        "S10" => _hi ? "निचले स्तरों पर भारी खरीद पाई गई — माँग आपूर्ति को अवशोषित कर रही है।" : _ja ? "安値付近で大量の買いを検出 — 需要が供給を吸収中。" : _zh ? "在低位附近检测到大量买入 — 需求正在吸收供给。" : "Heavy buying detected near the lows — demand is absorbing supply."
        "S11" => _hi ? "ऊपरी स्तरों पर भारी बिक्री पाई गई — आपूर्ति माँग को दबा रही है।" : _ja ? "高値付近で大量の売りを検出 — 供給が需要を圧倒中。" : _zh ? "在高位附近检测到大量卖出 — 供给正在压倒需求。" : "Heavy selling detected near the highs — supply is overwhelming demand."
        "S12" => _hi ? "निचले स्तरों पर चरम वॉल्यूम से घबराहट बिक्री — संभावित समर्पण।" : _ja ? "安値付近で極端な出来高のパニック売り — 投げ売りの可能性。" : _zh ? "在低位以极端成交量恐慌抛售 — 可能是投降。" : "Panic selling at extreme volume near the lows — possible capitulation."
        "S13" => _hi ? "ऊपरी स्तरों पर चरम वॉल्यूम से थकान खरीद — संभावित शिखर।" : _ja ? "高値付近で極端な出来高の疲弊買い — 天井の可能性。" : _zh ? "在高位以极端成交量衰竭买入 — 可能是顶部。" : "Exhaustion buying at extreme volume near the highs — possible blow-off top."
        "S14" => td > 0 ? (_hi ? "तेज़ी ट्रेंड जारी है लेकिन वॉल्यूम भागीदारी घट रही है।" : _ja ? "上昇トレンドは続くが出来高参加が減少中。" : _zh ? "上升趋势延续但成交量参与度下降。" : "The uptrend continues but volume participation is declining.") : (_hi ? "मंदी ट्रेंड जारी है लेकिन वॉल्यूम भागीदारी घट रही है।" : _ja ? "下降トレンドは続くが出来高参加が減少中。" : _zh ? "下降趋势延续但成交量参与度下降。" : "The downtrend continues but volume participation is declining.")
        "S15" => _hi ? "निचले स्तरों पर न्यूनतम ध्यान से शांत खरीद — संभावित संचय।" : _ja ? "安値付近で目立たない静かな買い — 買い集めの可能性。" : _zh ? "在低位以最少关注度静默买入 — 可能是吸筹。" : "Quiet buying near the lows with minimal attention — possible accumulation."
        "S16" => _hi ? "ऊपरी स्तरों पर न्यूनतम ध्यान से शांत बिक्री — संभावित वितरण।" : _ja ? "高値付近で目立たない静かな売り — 売り抜けの可能性。" : _zh ? "在高位以最少关注度静默卖出 — 可能是派发。" : "Quiet selling near the highs with minimal attention — possible distribution."
        => _hi ? "वॉल्यूम स्थितियाँ उल्लेखनीय नहीं।" : _ja ? "出来高状況は特筆すべきものなし。" : _zh ? "成交量状况不突出。" : "Volume conditions are unremarkable."
    string _p2 = switch sid
        "S1"  => _hi ? "वॉल्यूम हाल के इतिहास की शीर्ष श्रेणी में है और पूर्णतः ट्रेंड के साथ बह रहा है।" : _ja ? "出来高は直近歴史のトップクラスに位置し、完全にトレンドに沿って流れている。" : _zh ? "成交量位于近期历史顶级水平，完全顺应趋势流动。" : "Volume ranks in the top tier of recent history and flows entirely with the trend."
        "S2"  => _hi ? "वॉल्यूम औसत से ऊपर है और स्वस्थ दिशात्मक प्रवाह में — तनाव के कोई संकेत नहीं।" : _ja ? "出来高は平均以上で健全な方向性フロー — ストレスの兆候なし。" : _zh ? "成交量高于均值，方向性流动健康 — 无压力迹象。" : "Volume is above average with healthy directional flow — no signs of stress."
        "S3"  => _hi ? "दिशा सही है लेकिन इसके पीछे का वॉल्यूम विश्वास जगाने के लिए पर्याप्त नहीं।" : _ja ? "方向は正しいが背後の出来高は信頼を与えるに不十分。" : _zh ? "方向正确但背后的成交量不足以给人信心。" : "Direction is correct but volume behind it is not strong enough to inspire confidence."
        "S4"  => _hi ? "ट्रेंड के विरुद्ध वॉल्यूम चरम स्तर पर पहुँच गया — यह सामान्य शोर नहीं है।" : _ja ? "トレンドに逆行する出来高が極端なレベルに達した — これは通常のノイズではない。" : _zh ? "对抗趋势的成交量已达极端水平 — 这不是正常噪音。" : "Volume against the trend has reached extreme levels — this is not normal noise."
        "S5"  => _hi ? "विरोधी पक्ष औसत से अधिक वॉल्यूम प्रतिबद्धता के साथ मज़बूत हो रहा है।" : _ja ? "反対側が平均以上の出来高コミットメントで勢力を増している。" : _zh ? "对立方正以高于均值的成交量投入增强力量。" : "The opposing side is gaining strength with above-average volume commitment."
        "S6"  => _hi ? "इस प्रतिकूल चाल के पीछे वॉल्यूम कमज़ोर है — ट्रेंड आसानी से अवशोषित कर लेगा।" : _ja ? "この逆行の背後の出来高は弱い — トレンドは容易に吸収するはず。" : _zh ? "反向波动背后的成交量较弱 — 趋势应能轻松吸收。" : "The volume behind this counter-move is weak — the trend should absorb it easily."
        "S7"  => _hi ? "एक पक्ष अनुसरण करने के लिए स्थापित ट्रेंड के बिना चरम वॉल्यूम प्रतिबद्ध कर रहा है।" : _ja ? "一方の側が確立されたトレンドなしに極端な出来高を投入している。" : _zh ? "一方在没有确立趋势的情况下投入极端成交量。" : "One side is committing extreme volume without an established trend to follow."
        "S8"  => _hi ? "न खरीदार न बिक्रेता प्रतिबद्ध हैं — बाज़ार प्रतीक्षा मोड में है।" : _ja ? "買い手も売り手もコミットしていない — 市場は様子見モード。" : _zh ? "买卖双方均未投入 — 市场处于观望模式。" : "Neither buyers nor sellers are committing — the market is in wait-and-see mode."
        "S9"  => _hi ? "6 स्केल में से " + _pocN + " का वॉल्यूम केंद्र " + _poc + " के पास है — यह स्तर चुम्बक का काम करता है।" : _ja ? "6スケール中" + _pocN + "の出来高中心が" + _poc + "付近 — この水準がマグネットとして機能。" : _zh ? "6个尺度中有" + _pocN + "个的成交量中心在" + _poc + "附近 — 该水平作为磁吸点。" : _pocN + " of 6 grouping scales have their volume center near " + _poc + " — this level acts as a magnet."
        "S10" => _hi ? "सबसे भारी खरीद रेंज के निचले हिस्से में केंद्रित है — खरीदार इस तल की रक्षा कर रहे हैं।" : _ja ? "最も重い買いがレンジ下部に集中 — 買い手がこの底を防衛中。" : _zh ? "最重的买入集中在区间底部 — 买方正在守护这一底部。" : "The heaviest buying is concentrated near the bottom of the range — buyers are defending this floor."
        "S11" => _hi ? "सबसे भारी बिक्री रेंज के ऊपरी हिस्से में केंद्रित है — बिक्रेता इस छत को सीमित कर रहे हैं।" : _ja ? "最も重い売りがレンジ上部に集中 — 売り手がこの天井を制限中。" : _zh ? "最重的卖出集中在区间顶部 — 卖方正在封顶。" : "The heaviest selling is concentrated near the top of the range — sellers are capping this ceiling."
        "S12" => _hi ? "अधिकतम बिक्री वॉल्यूम चरम तीव्रता से निचले स्तरों पर टकरा रहा — अक्सर अंतिम फ्लश का संकेत।" : _ja ? "最大売り出来高が極端な強度で安値を直撃 — しばしば最終フラッシュの印。" : _zh ? "最大卖出量以极端强度冲击低位 — 这通常标志着最终清洗。" : "Maximum selling volume is hitting the lows with extreme intensity — this often marks the final flush."
        "S13" => _hi ? "अधिकतम खरीद वॉल्यूम चरम तीव्रता से ऊपरी स्तरों पर टकरा रहा — अक्सर अंतिम धक्के का संकेत。" : _ja ? "最大買い出来高が極端な強度で高値を直撃 — しばしば最終プッシュの印。" : _zh ? "最大买入量以极端强度冲击高位 — 这通常标志着最后推力。" : "Maximum buying volume is hitting the highs with extreme intensity — this often marks the final push."
        "S14" => _hi ? "ट्रेंड संरचना बरकरार है लेकिन कम प्रतिभागी चला रहे हैं — आधार कमज़ोर हो रहा।" : _ja ? "トレンド構造は維持されているが推進する参加者が減少 — 基盤が弱体化。" : _zh ? "趋势结构完整但推动的参与者减少 — 基础正在减弱。" : "The trend structure is intact but fewer participants are driving it — the foundation is weakening."
        "S15" => _hi ? "बहु-स्केल निचले स्तरों पर छोटी लेकिन लगातार खरीद शांत स्थिति-निर्माण का संकेत。" : _ja ? "多スケールの安値付近で小さいが継続的な買い — 静かなポジション構築の示唆。" : _zh ? "在多尺度低位附近持续小量买入暗示静默建仓。" : "Small but persistent buying near multi-scale lows suggests quiet positioning."
        "S16" => _hi ? "बहु-स्केल ऊपरी स्तरों पर छोटी लेकिन लगातार बिक्री शांत निकासी का संकेत。" : _ja ? "多スケールの高値付近で小さいが継続的な売り — 静かな手仕舞いの示唆。" : _zh ? "在多尺度高位附近持续小量卖出暗示静默减仓。" : "Small but persistent selling near multi-scale highs suggests quiet unwinding."
        => _hi ? "कोई विशिष्ट वॉल्यूम पैटर्न नहीं पाया गया।" : _ja ? "特徴的な出来高パターンは検出されず。" : _zh ? "未检测到特征性成交量模式。" : "No distinctive volume pattern detected."
    string _p3 = switch sid
        "S1"  => conv == "HIGH" ? (_hi ? "मज़बूत जारी रहने की उम्मीद — वॉल्यूम, ट्रेंड और गति पूर्ण संरेखित।" : _ja ? "強い継続が予想される — 出来高、トレンド、勢いが完全に一致。" : _zh ? "预期强势延续 — 成交量、趋势和动量完全一致。" : "Strong continuation expected — volume, trend, and momentum are fully aligned.") : (_hi ? "जारी रहने की संभावना लेकिन किसी भी वॉल्यूम पलटाव पर ध्यान दें।" : _ja ? "継続の可能性が高いが出来高反転には警戒。" : _zh ? "延续可能性大但警惕成交量反转。" : "Continuation likely but watch for any volume reversal as a warning.")
        "S2"  => _hi ? "ट्रेंड जारी रहने के लिए स्वस्थ स्थितियाँ — कोई तत्काल चिंता नहीं।" : _ja ? "トレンド継続に健全な環境 — 当面の懸念なし。" : _zh ? "趋势延续的健康条件 — 无即时担忧。" : "Healthy conditions for trend continuation — no immediate concerns."
        "S3"  => _hi ? "ताज़ा वॉल्यूम के बिना ट्रेंड रुक सकता है — जोड़ने से पहले मज़बूत प्रतिबद्धता की प्रतीक्षा करें।" : _ja ? "新たな出来高なしではトレンドが停滞する可能性 — 強いコミットメントを待て。" : _zh ? "没有新成交量趋势可能停滞 — 等待更强投入再加仓。" : "The trend may stall without fresh volume — wait for stronger commitment before adding."
        "S4"  => conv == "HIGH" ? (_hi ? "ट्रेंड गंभीर खतरे में — एक्सपोज़र कम करने पर विचार करें।" : _ja ? "トレンドが深刻な脅威下 — エクスポージャー削減を検討。" : _zh ? "趋势面临严重威胁 — 考虑减少敞口。" : "The trend is under serious threat — consider reducing exposure.") : (_hi ? "महत्वपूर्ण दबाव — स्टॉप कसें और निकट से निगरानी करें।" : _ja ? "大きな圧力 — ストップを引き締め注視を強化。" : _zh ? "重大压力 — 收紧止损并密切监控。" : "Significant pressure — tighten stops and monitor closely.")
        "S5"  => _hi ? "वर्तमान ट्रेंड पर बढ़ता जोखिम — नई एंट्री में सतर्क रहें।" : _ja ? "現在のトレンドへのリスク増大 — 新規エントリーに慎重であれ。" : _zh ? "当前趋势的风险增加 — 新入场需谨慎。" : "Growing risk to the current trend — be cautious with new entries."
        "S6"  => _hi ? "सामान्य बाज़ार साँस — ट्रेंड बिना किसी समस्या के जारी रहना चाहिए।" : _ja ? "通常の市場の呼吸 — トレンドは問題なく再開するはず。" : _zh ? "正常的市场呼吸 — 趋势应能无碍恢复。" : "Normal market breathing — the trend should resume without issue."
        "S7"  => _hi ? "दिशात्मक ब्रेकआउट पर नज़र रखें — जब ट्रेंड पुष्ट होगा, चाल शक्तिशाली हो सकती है।" : _ja ? "方向性ブレイクアウトに注目 — トレンド確認時、動きは力強い可能性。" : _zh ? "关注方向性突破 — 趋势确认时波动可能很强。" : "Watch for a directional breakout — when the trend confirms, the move could be powerful."
        "S8"  => _hi ? "अभी कोई लाभ नहीं — वॉल्यूम लौटने तक धैर्य सबसे अच्छी रणनीति।" : _ja ? "現時点で優位性なし — 出来高が戻るまで忍耐が最善の戦略。" : _zh ? "目前无优势 — 耐心等待成交量回归是最佳策略。" : "No edge exists right now — patience is the best strategy until volume returns."
        "S9"  => _hi ? "ताज़ा वॉल्यूम आगे न धकेले तो\nकीमत " + _poc + " की ओर आकर्षित होने की उम्मीद।" : _ja ? "新たな出来高がさらに押し進めない限り\n価格は" + _poc + "に引き寄せられる見通し。" : _zh ? "除非新成交量继续推动，\n预计价格将向" + _poc + "靠拢。" : "Expect price to gravitate toward " + _poc + "\nunless fresh volume pushes further."
        "S10" => _hi ? "इस समर्थन के पीछे वास्तविक वॉल्यूम है — यहाँ से उछालें उच्च विश्वास रखती हैं।" : _ja ? "この支持の背後に実際の出来高あり — ここからの反発は高い確信度。" : _zh ? "该支撑背后有真实成交量 — 从此处反弹具有更高确信度。" : "This support has real volume behind it — bounces from here carry higher conviction."
        "S11" => _hi ? "इस प्रतिरोध के पीछे वास्तविक वॉल्यूम है — यहाँ से अस्वीकृतियाँ उच्च विश्वास रखती हैं।" : _ja ? "この抵抗の背後に実際の出来高あり — ここからの拒否は高い確信度。" : _zh ? "该阻力背后有真实成交量 — 从此处拒绝具有更高确信度。" : "This resistance has real volume behind it — rejections from here carry higher conviction."
        "S12" => _hi ? "चरम घबराहट बिक्री अक्सर पलटाव से पहले आती है — लेकिन पहले ट्रेंड पुष्टि की प्रतीक्षा करें।" : _ja ? "極端なパニック売りはしばしば反転に先行 — ただしトレンド確認を待て。" : _zh ? "极端恐慌抛售通常先于反转 — 但先等待趋势确认。" : "Extreme panic selling often precedes a reversal — but wait for trend confirmation first."
        "S13" => _hi ? "चरम उत्साही खरीद अक्सर पुलबैक से पहले आती है — मुनाफ़ा लेने पर विचार करें।" : _ja ? "極端な熱狂的買いはしばしば押し目に先行 — 利益確定を検討。" : _zh ? "极端热情买入通常先于回调 — 考虑获利了结。" : "Extreme euphoric buying often precedes a pullback — consider taking profits."
        "S14" => mom == "Fading" ? (_hi ? "वॉल्यूम और चाल गुणवत्ता दोनों बिगड़ रहे — ट्रेंड ताकत खो रहा।" : _ja ? "出来高と動きの質の両方が悪化中 — トレンドが勢いを失っている。" : _zh ? "成交量和波动质量都在恶化 — 趋势正在失去动力。" : "Volume and move quality are both deteriorating — the trend is losing steam.") : (_hi ? "वॉल्यूम पतला हो रहा — किसी भी दिशा में त्वरण पर ध्यान दें।" : _ja ? "出来高が薄化中 — どちらかの方向への加速に注意。" : _zh ? "成交量正在减薄 — 关注任何方向的加速。" : "Volume is thinning — watch for acceleration in either direction.")
        "S15" => _hi ? "यदि यह संचय वास्तविक है, तो ट्रेंड बदलाव विकसित हो सकता है — बढ़ते वॉल्यूम पर नज़र रखें।" : _ja ? "この買い集めが本物なら、トレンド転換が進行する可能性 — 出来高増加に注目。" : _zh ? "如果这次吸筹是真实的，趋势转变可能正在发展 — 关注成交量增加。" : "If this accumulation is real, a trend shift may develop — watch for rising volume."
        "S16" => _hi ? "यदि यह वितरण वास्तविक है, तो ट्रेंड बदलाव विकसित हो सकता है — बढ़ते वॉल्यूम पर नज़र रखें।" : _ja ? "この売り抜けが本物なら、トレンド転換が進行する可能性 — 出来高増加に注目。" : _zh ? "如果这次派发是真实的，趋势转变可能正在发展 — 关注成交量增加。" : "If this distribution is real, a trend shift may develop — watch for rising volume."
        => _hi ? "वॉल्यूम व्यवहार में बदलावों पर निगरानी रखें।" : _ja ? "出来高動向の変化を監視せよ。" : _zh ? "监控成交量行为的变化。" : "Monitor for changes in volume behavior."
    string _live = liveAlert ? (_hi ? "🔴 लाइव अलर्ट: वर्तमान कैंडल पर विस्फोटक वॉल्यूम स्पाइक पाया गया।\n" : _ja ? "🔴 ライブアラート: 現在のキャンドルで爆発的出来高スパイク検出。\n" : _zh ? "🔴 实时警报: 当前K线检测到爆发性成交量飙升。\n" : "🔴 LIVE ALERT: Explosive volume spike detected on the current candle.\n") : ""
    str.replace_all(_live + _p1 + "\n" + _p2 + "\n" + _p3, " — ", "\n— ")

// ══════════════════════════════════════════════════════════════════════════════════
// 14. f_trTipDash — Dashboard tooltips: mobile (12) + desktop header (6)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for dashboard-level cells.
// @param key Tooltip key identifier.
// @param lang The dashboard language.
// @returns The translated tooltip string.
export f_trTipDash(string key, string lang) =>
    if lang == "हिन्दी"
        switch key
            "mob_hdr"   => "स्मार्ट ट्रेडर — कॉम्पैक्ट मोबाइल पैनल। सभी मॉड्यूल से सबसे महत्वपूर्ण डेटा एक नज़र में दिखाता है।"
            "mob_live"  => "लाइव स्थिति। भरा बिंदु (●) = रियलटाइम कैंडल। खाली बिंदु (○) = ऐतिहासिक डेटा।"
            "mob_tick"  => "सक्रिय इंस्ट्रूमेंट टिकर सिम्बल।"
            "mob_price" => "इंस्ट्रूमेंट की स्थानीय मुद्रा में नवीनतम मूल्य।"
            "mob_align" => "ट्रेंड संरेखण स्कोर। +6 = सभी समय सीमाओं में पूर्ण तेज़ी सहमति। −6 = पूर्ण मंदी। 0 के पास = कोई स्पष्ट दिशा नहीं।"
            "mob_sig"   => "वर्तमान ट्रेंड रीडिंग। पलटाव पुष्ट = बड़ा पलटाव। पलटाव बन रहा = प्रारंभिक संकेत। मज़बूत तेज़ी/मंदी = बहुत स्पष्ट दिशा। छिपा रुझान = शोर के पीछे संरचनात्मक झुकाव। सक्रिय = ट्रेंड मौजूद। कोई स्पष्ट ट्रेंड नहीं = बग़ली।"
            "mob_conv"  => "ट्रेंड के पीछे की चालें कितनी शक्तिशाली हैं। उच्च = मज़बूत, निर्णायक गति। मध्यम = सामान्य ताकत। निम्न = दिशा है लेकिन चालें कमज़ोर।"
            "mob_coup"  => "इस कैंडल की चाल गुणवत्ता का ट्रेंड से संबंध। लहर = ट्रेंड के साथ असाधारण चाल। पुष्ट = ठोस संरेखण। सक्रिय = सामान्य। रुकी = कमज़ोर। दबाव/प्रतिरोध = ट्रेंड के विरुद्ध चाल।"
            "mob_eta"   => "चाल गुणवत्ता प्रतिशत। तीर दिशा दिखाता है: ▲ = तेज़ी कैंडल, ▼ = मंदी कैंडल। उच्च मान = स्वच्छ, अधिक निर्णायक चाल।"
            "mob_mom"   => "चाल गुणवत्ता ट्रेंड। तेज़ हो रहा = गुणवत्ता उछाल। तीक्ष्ण हो रहा = क्रमिक सुधार। स्थिर = बदलाव नहीं। कमज़ोर हो रहा = गिरावट — संभावित थकान।"
            "mob_vscn"  => "वर्तमान वॉल्यूम दबाव परिदृश्य। पूर्ण पुष्टि = वॉल्यूम ट्रेंड का पूर्ण समर्थन। प्रतिरोध = वॉल्यूम ट्रेंड के विरुद्ध। ब्रेकआउट उम्मीदवार = चरम एकतरफ़ा वॉल्यूम। निष्क्रिय बाज़ार = कोई सार्थक गतिविधि नहीं। वॉल्यूम विचलन = ट्रेंड जारी लेकिन वॉल्यूम घट रहा।"
            "mob_vzone" => "वॉल्यूम तीव्रता और प्रमुख पक्ष। ▲ = खरीदार आगे, ▼ = बिक्रेता आगे, ◆ = संतुलित। विस्फोटक = शीर्ष 5%। उच्च = शीर्ष 25%। सामान्य = औसत। निम्न = तल 25%।"
            "hdr"       => "इंडिकेटर पहचान। यह पैनल शून्य रीपेंट के साथ केवल लाइव गणनाएँ दिखाता है — मान केवल रियलटाइम कैंडल पर अपडेट होते हैं।"
            "live"      => "लाइव स्थिति। भरा बिंदु (●) = रियलटाइम कैंडल सक्रिय प्रसंस्करण। खाली बिंदु (○) = ऐतिहासिक डेटा, मान स्थिर।"
            "tick"      => "सक्रिय इंस्ट्रूमेंट। $ उपसर्ग आपके चार्ट पर सक्रिय टिकर दर्शाता है।"
            "price"     => "बाज़ार की स्थानीय मुद्रा में नवीनतम मूल्य। किसी भी सिम्बल, एक्सचेंज, या एसेट क्लास के लिए स्वचालित रूप से अनुकूलित।"
            "xcoord"    => "X-कोऑर्डिनेट — बाज़ार ने कितनी चाल का अवसर दिया इसे मापता है। उच्च मान समय के साथ अधिक अस्थिरता संचय का अर्थ। वर्तमान चाल चक्र की परिपक्वता आकलन के लिए उपयोग करें।"
            "ycoord"    => "Y-कोऑर्डिनेट — शुरुआत से शुद्ध मूल्य चाल। धनात्मक = मूल्य ऊपर, ऋणात्मक = नीचे। बाज़ार ने अपनी अस्थिरता को दिशात्मक प्रगति में कितने प्रभावी ढंग से बदला इसके मूल्यांकन के लिए Y की X से तुलना करें।"
            => ""
    else if lang == "日本語"
        switch key
            "mob_hdr"   => "スマートトレーダー — コンパクトモバイルパネル。全モジュールから最も重要なデータを一目で表示。"
            "mob_live"  => "ライブ状態。塗りつぶし点（●）= リアルタイムキャンドル。白抜き点（○）= 履歴データ。"
            "mob_tick"  => "アクティブな銘柄ティッカーシンボル。"
            "mob_price" => "銘柄のネイティブ通貨での最新価格。"
            "mob_align" => "トレンド整合スコア。+6 = 全時間軸で完全強気合意。−6 = 完全弱気。0付近 = 明確な方向なし。"
            "mob_sig"   => "現在のトレンドリーディング。反転確認 = 大きな反転。反転形成中 = 初期兆候。強い上昇/下降 = 非常に明確。隠れたバイアス = ノイズの裏の構造的傾き。継続 = トレンド存在。トレンドなし = 横ばい。"
            "mob_conv"  => "トレンドの背後の動きの力強さ。高 = 強く決定的。中 = 通常。低 = 方向はあるが動きは弱い。"
            "mob_coup"  => "このキャンドルの動きの質とトレンドの関係。サージ = 例外的順行。確認 = 堅実な整合。継続 = 通常。停滞 = 弱い。圧力/反発 = トレンド逆行。"
            "mob_eta"   => "動きの質パーセンテージ。矢印は方向: ▲ = 強気、▼ = 弱気。高い値 = クリーンで決定的な動き。"
            "mob_mom"   => "動きの質トレンド。加速中 = 品質急上昇。先鋭化 = 段階的改善。安定 = 変化なし。減衰中 = 悪化 — 消耗の可能性。"
            "mob_vscn"  => "現在の出来高圧力シナリオ。完全確認 = 出来高がトレンドを完全支持。反発 = 逆行。ブレイクアウト候補 = 極端な一方的出来高。閑散相場 = 活動なし。出来高乖離 = トレンド続くが出来高減少。"
            "mob_vzone" => "出来高強度と主導側。▲ = 買い手、▼ = 売り手、◆ = 均衡。爆発的 = 上位5%。高 = 上位25%。通常 = 平均。低 = 下位25%。"
            "hdr"       => "インジケーター識別。このパネルはゼロリペイントのライブ計算のみ表示 — 値はリアルタイムキャンドルでのみ更新。"
            "live"      => "ライブ状態。塗りつぶし点（●）= リアルタイム処理中。白抜き点（○）= 履歴データ、値は固定。"
            "tick"      => "現在の銘柄。$接頭辞はチャート上のアクティブティッカーを示す。"
            "price"     => "市場のネイティブ通貨での最新価格。あらゆるシンボル、取引所、資産クラスに自動適応。"
            "xcoord"    => "X座標 — 市場がどれだけの動きの機会を持ったかを測定。高い値は時間経過に伴うボラティリティ蓄積を意味。現在の動きサイクルの成熟度評価に使用。"
            "ycoord"    => "Y座標 — 開始からの純価格移動。正 = 上昇、負 = 下降。YをXと比較し市場がボラティリティを方向性進捗にどれだけ効果的に変換したかを評価。"
            => ""
    else if lang == "简体中文"
        switch key
            "mob_hdr"   => "智能交易者 — 紧凑型移动面板。一目了然显示所有模块中最重要的数据。"
            "mob_live"  => "实时状态。实心点（●）= 实时K线。空心点（○）= 历史数据。"
            "mob_tick"  => "活跃的交易品种代码。"
            "mob_price" => "该品种原始货币的最新价格。"
            "mob_align" => "趋势一致性评分。+6 = 所有时间周期完全看涨共识。−6 = 完全看跌。接近0 = 无明确方向。"
            "mob_sig"   => "当前趋势判读。反转确认 = 重大反转。反转形成中 = 初期迹象。强势上升/下降 = 非常明确。隐性倾向 = 噪音背后的结构性偏向。活跃 = 趋势存在。无明确趋势 = 横盘。"
            "mob_conv"  => "趋势背后波动的力量。高 = 强劲、果断的动量。中 = 正常力度。低 = 方向存在但波动较弱。"
            "mob_coup"  => "此K线的波动质量与趋势的关系。爆发 = 顺趋势的异常波动。确认 = 坚实一致。活跃 = 正常。停滞 = 较弱。压力/反击 = 逆趋势波动。"
            "mob_eta"   => "波动质量百分比。箭头显示方向：▲ = 看涨K线，▼ = 看跌K线。较高值 = 更干净、更果断的波动。"
            "mob_mom"   => "波动质量趋势。加速中 = 质量飙升。趋强中 = 逐步改善。稳定 = 无变化。衰减中 = 恶化 — 可能衰竭。"
            "mob_vscn"  => "当前成交量压力场景。完全确认 = 成交量完全支持趋势。反击 = 成交量对抗趋势。突破候选 = 极端单边成交量。死寂市场 = 无有意义活动。量价背离 = 趋势延续但成交量下降。"
            "mob_vzone" => "成交量强度和主导方。▲ = 买方领先，▼ = 卖方领先，◆ = 均衡。爆发性 = 前5%。高 = 前25%。适中 = 平均。低 = 后25%。"
            "hdr"       => "指标标识。此面板显示零重绘的纯实时计算 — 值仅在实时K线上更新。"
            "live"      => "实时状态。实心点（●）= 正在处理当前实时K线。空心点（○）= 查看历史数据，值已冻结。"
            "tick"      => "当前品种。$前缀表示图表上的活跃代码。"
            "price"     => "市场原始货币的最新价格。自动适应任何品种、交易所或资产类别。"
            "xcoord"    => "X坐标 — 衡量市场有多少波动机会。较高值意味着随时间积累了更多波动率。用此评估当前波动周期的成熟度。"
            "ycoord"    => "Y坐标 — 自起始以来的净价格移动。正值 = 上涨，负值 = 下跌。将Y与X比较以评估市场将波动率转化为方向性进展的效率。"
            => ""
    else
        switch key
            "mob_hdr"   => "Smart Trader — compact mobile dashboard. Shows the most actionable data from all modules in one glance."
            "mob_live"  => "Live status. Filled dot (●) = realtime candle. Empty dot (○) = historical data."
            "mob_tick"  => "Active instrument ticker symbol."
            "mob_price" => "Latest price in the instrument's native currency."
            "mob_align" => "Trend alignment score. +6 = full bullish consensus across all time horizons. −6 = full bearish. Near 0 = no clear direction."
            "mob_sig"   => "Current trend reading. Reversal Confirmed = major reversal. Reversal Forming = early signs. Strong Up/Downtrend = very clear direction. Hidden Bias = structural tilt masked by noise. Active = trend present. No Clear Trend = sideways."
            "mob_conv"  => "How powerful the moves behind the trend are. HIGH = strong, decisive momentum. MODERATE = normal strength. LOW = direction exists but moves are weak."
            "mob_coup"  => "How this candle's move quality relates to the current trend. SURGE = exceptional with-trend move. CONFIRMED = solid alignment. Active = normal. Stalling = weak. Pressure/Counter = move opposing the trend."
            "mob_eta"   => "Move quality percentage. Arrow shows direction: ▲ = bullish bar, ▼ = bearish bar. Higher values = cleaner, more decisive move."
            "mob_mom"   => "Move quality trend. Accelerating = surging quality. Sharpening = gradually improving. Steady = stable. Fading = deteriorating — possible exhaustion."
            "mob_vscn"  => "Current volume pressure scenario. Full Confirmation = volume fully supports trend. Counter = volume fights trend. Breakout Candidate = extreme one-sided volume. Dead Market = no meaningful activity. Volume Divergence = trend continues but volume declining."
            "mob_vzone" => "Volume intensity and dominant side. ▲ = buyers lead, ▼ = sellers lead, ◆ = balanced. Explosive = top 5%. Elevated = top 25%. Moderate = average. Low = bottom 25%."
            "hdr"       => "Indicator identity. This panel shows live-only calculations with zero repaint — values update exclusively on the realtime candle."
            "live"      => "Live status. Filled dot (●) = actively processing the current realtime candle. Empty dot (○) = viewing historical data where values are frozen."
            "tick"      => "Current instrument. The $ prefix denotes the active ticker on your chart."
            "price"     => "Latest price in the native currency of the market. Automatically adapts to any symbol, exchange, or asset class."
            "xcoord"    => "X-Coordinate — measures how much movement opportunity the market has had. Higher values mean more volatility has accumulated over time. Use this to assess how mature the current move cycle is."
            "ycoord"    => "Y-Coordinate — the net price movement since the start. Positive = price moved up, negative = down. Compare Y against X to evaluate how effectively the market converted its volatility into directional progress."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 15. f_trTipTrend — Trend Engine tooltips (6 keys)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Trend Engine cells.
// @param key Tooltip key identifier.
// @param lang The dashboard language.
// @returns The translated tooltip string.
export f_trTipTrend(string key, string lang) =>
    if lang == "हिन्दी"
        switch key
            "tr_title"    => "ट्रेंड दिशा मॉड्यूल। दिखाता है कि बाज़ार तेज़ी में है, मंदी में, या बग़ली, और यह रीडिंग कितनी विश्वसनीय है। कोई भी ट्रेड लेने से पहले इसे अपनी पहली जाँच के रूप में उपयोग करें।"
            "tr_badge"    => "मॉड्यूल स्थिति। ट्रेंड दिशा विश्लेषण हर कैंडल पर रियलटाइम चल रहा है।"
            "tr_sig"      => "वर्तमान ट्रेंड रीडिंग। मज़बूत तेज़ी/मंदी = बहुत स्पष्ट ट्रेंड। तेज़ी/मंदी सक्रिय = ट्रेंड मौजूद। पलटाव पुष्ट = बड़ा ट्रेंड पलटाव बन रहा — ध्यान दें। पलटाव बन रहा = संभावित पलटाव के प्रारंभिक संकेत। छिपा रुझान = अल्पकालिक शोर के बावजूद बड़ी तस्वीर ट्रेंड में। कोई स्पष्ट ट्रेंड नहीं = बाज़ार में अभी कोई दिशा नहीं।"
            "tr_align"    => "ट्रेंड के पीछे कितनी सहमति है। +6 = अधिकतम तेज़ी सहमति। −6 = अधिकतम मंदी सहमति। 0 के पास = मिश्रित — बाज़ार में कोई स्पष्ट दिशा नहीं।"
            "tr_conv_sfx" => "। दिखाता है कि ट्रेंड के पीछे की चालें कितनी शक्तिशाली हैं। उच्च = मज़बूत, निर्णायक गति। मध्यम = सामान्य ताकत। निम्न = दिशा है लेकिन चालें कमज़ोर — सतर्क रहें।"
            "tr_narr"     => "वर्तमान ट्रेंड स्थिति का सरल भाषा में सारांश। बाज़ार की दिशा और रीडिंग की विश्वसनीयता को एक पठनीय वाक्य में बताता है।"
            => ""
    else if lang == "日本語"
        switch key
            "tr_title"    => "トレンド方向モジュール。市場が上昇・下降・横ばいのいずれかを示し、そのリーディングの信頼度を表示。トレード前の最初のチェックとして使用。"
            "tr_badge"    => "モジュール状態。トレンド方向分析がリアルタイムで毎キャンドル実行中。"
            "tr_sig"      => "現在のトレンドリーディング。強い上昇/下降トレンド = 非常に明確。上昇/下降継続 = トレンド存在。反転確認 = 大きな反転形成中 — 注目。反転形成中 = 初期兆候。隠れたバイアス = 短期ノイズの裏に大局トレンド。トレンドなし = 方向性なし。"
            "tr_align"    => "トレンドの背後の合意度。+6 = 最大強気合意。−6 = 最大弱気合意。0付近 = 混在 — 明確な方向なし。"
            "tr_conv_sfx" => "。トレンドの背後の動きの力強さ。高 = 強く決定的。中 = 通常。低 = 方向はあるが動きは弱い — 慎重に。"
            "tr_narr"     => "現在のトレンド状況の平易な要約。市場の方向性とリーディングの信頼度を一文で説明。"
            => ""
    else if lang == "简体中文"
        switch key
            "tr_title"    => "趋势方向模块。显示市场是上涨、下跌还是横盘，以及该判读的可信度。在进行任何交易前将此作为首要检查。"
            "tr_badge"    => "模块状态。趋势方向分析在每根K线上实时运行。"
            "tr_sig"      => "当前趋势判读。强势上升/下降趋势 = 非常明确。上升/下降趋势活跃 = 趋势存在。反转确认 = 重大反转正在形成 — 密切关注。反转形成中 = 初期迹象。隐性倾向 = 尽管短期噪音，大局仍在趋势中。无明确趋势 = 当前无方向。"
            "tr_align"    => "趋势背后有多少共识。+6 = 最大看涨共识。−6 = 最大看跌共识。接近0 = 混合 — 市场无明确方向。"
            "tr_conv_sfx" => "。显示趋势背后的波动有多强劲。高 = 强劲、果断的动量。中 = 正常力度。低 = 方向存在但波动较弱 — 需谨慎。"
            "tr_narr"     => "当前趋势状况的通俗语言摘要。用一句可读的话描述市场方向和判读的可信度。"
            => ""
    else
        switch key
            "tr_title"    => "Trend direction module. Shows whether the market is trending up, down, or sideways, and how confident that reading is. Use this as your first check before taking any trade."
            "tr_badge"    => "Module status. Trend direction analysis is running on every candle in real time."
            "tr_sig"      => "The current trend reading. Strong Uptrend/Downtrend = very clear trend. Uptrend/Downtrend Active = trend present. Reversal Confirmed = a major trend reversal is forming — pay close attention. Reversal Forming = early signs of a possible reversal. Hidden Bias = the bigger picture is trending despite short-term noise. No Clear Trend = market has no direction right now."
            "tr_align"    => "How much agreement there is behind the trend. +6 = maximum bullish agreement. −6 = maximum bearish agreement. Near 0 = mixed — the market has no clear direction."
            "tr_conv_sfx" => ". Shows how powerful the moves behind the trend are. HIGH = strong, decisive momentum. MODERATE = normal strength. LOW = the direction is there but the moves are weak — be cautious."
            "tr_narr"     => "Plain-language summary of the current trend situation. Describes the market direction and how confident the reading is in one readable sentence."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 16. f_trTipEff — Efficiency module tooltips (6 keys)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Efficiency module cells.
// @param key Tooltip key identifier.
// @param lang The dashboard language.
// @returns The translated tooltip string.
export f_trTipEff(string key, string lang) =>
    if lang == "हिन्दी"
        switch key
            "eff_title" => "चाल गुणवत्ता मॉड्यूल। दिखाता है कि हर कैंडल की ऊर्जा कितनी स्पष्ट दिशात्मक चाल में बदली। मूल्यांकन के लिए उपयोग करें कि प्राइस एक्शन स्वच्छ और निर्णायक है या शोरभरा और अनिर्णीत।"
            "eff_badge" => "मॉड्यूल स्थिति। चाल गुणवत्ता विश्लेषण हर कैंडल पर रियलटाइम चल रहा है।"
            "eff_coup"  => "इस कैंडल की चाल गुणवत्ता का वर्तमान ट्रेंड से संबंध। तेज़ी/मंदी लहर = ट्रेंड के साथ असाधारण मज़बूत चाल। पुष्ट = ठोस संरेखण। सक्रिय = सामान्य समर्थन। रुकी = दिशा सही लेकिन कमज़ोर। मंदी/तेज़ी दबाव = ट्रेंड के विरुद्ध मज़बूत चाल — सतर्क रहें। तीव्र प्रतिरोध = चरम विरोधी चाल। हल्का प्रतिरोध/समर्थन = मध्यम प्रतिकूल चाल। शोर = कमज़ोर विरोधी चाल, अनदेखा करें।"
            "eff_pct"   => "चाल गुणवत्ता प्रतिशत। तीर दिशा दिखाता है: ▲ = तेज़ी, ▼ = मंदी। उच्च मान स्वच्छ, अधिक निर्णायक चाल। निम्न मान अस्थिर, अनिर्णीत एक्शन। सिस्टम इसे हाल के इतिहास से स्वचालित तुलना कर बाईं सेल में स्थिति निर्धारित करता है।"
            "eff_mom"   => "दिखाता है कि बाज़ार चाल गुणवत्ता सुधर रही है या बिगड़ रही। तेज़ हो रहा = चालें बहुत स्वच्छ — संभावित ट्रेंड ब्रेकआउट। तीक्ष्ण हो रहा = गुणवत्ता में क्रमिक सुधार। स्थिर = कोई महत्वपूर्ण बदलाव नहीं। कमज़ोर हो रहा = चालें अधिक अव्यवस्थित — ट्रेंड थक सकता है।"
            "eff_narr"  => "वर्तमान चाल गुणवत्ता स्थिति का सरल भाषा में सारांश। दिशात्मक संदर्भ, दक्षता स्तर, और गुणवत्ता ट्रेंड को एक पठनीय विवरण में जोड़ता है।"
            => ""
    else if lang == "日本語"
        switch key
            "eff_title" => "動きの質モジュール。各キャンドルのエネルギーがどれだけ方向性ある動きに変換されたかを表示。プライスアクションがクリーンか乱雑かの評価に使用。"
            "eff_badge" => "モジュール状態。動きの質分析がリアルタイムで毎キャンドル実行中。"
            "eff_coup"  => "このキャンドルの動きの質とトレンドの関係。サージ = トレンドに沿った例外的動き。確認 = 堅実な整合。継続 = 通常。停滞 = 方向は正しいが弱い。圧力/反発 = トレンドに逆行する強い動き — 注意。ノイズ = 弱い逆行、無視可能。"
            "eff_pct"   => "動きの質パーセンテージ。矢印は方向: ▲ = 強気、▼ = 弱気。高い値 = クリーンで決定的。低い値 = 不安定で優柔不断。システムが直近履歴と自動比較し左セルのステータスを決定。"
            "eff_mom"   => "動きの質が改善か悪化か。加速中 = はるかにクリーン — ブレイクアウトの可能性。先鋭化 = 段階的改善。安定 = 変化なし。減衰中 = より乱雑に — 消耗の可能性。"
            "eff_narr"  => "現在の動きの質状況の平易な要約。方向性、効率レベル、品質トレンドを一つの説明にまとめたもの。"
            => ""
    else if lang == "简体中文"
        switch key
            "eff_title" => "波动质量模块。显示每根K线的能量有多少转化为明确的方向性波动。用此评估价格行为是干净果断还是杂乱犹豫。"
            "eff_badge" => "模块状态。波动质量分析在每根K线上实时运行。"
            "eff_coup"  => "此K线的波动质量与当前趋势的关系。多头/空头爆发 = 顺趋势的异常强劲波动。确认 = 坚实一致。活跃 = 正常支撑。停滞 = 方向正确但较弱。空头/多头压力 = 逆趋势的强劲波动 — 需谨慎。强力反击 = 极端反向波动。轻微阻力/支撑 = 中等反向波动。噪音 = 弱反向波动，可忽略。"
            "eff_pct"   => "波动质量百分比。箭头显示方向：▲ = 看涨，▼ = 看跌。较高值 = 更干净、更果断。较低值 = 震荡犹豫。系统自动与近期历史比较确定左侧单元格的状态。"
            "eff_mom"   => "显示波动质量是在改善还是恶化。加速中 = 波动更干净 — 可能的趋势突破。趋强中 = 质量逐步改善。稳定 = 无显著变化。衰减中 = 波动更杂乱 — 趋势可能正在衰竭。"
            "eff_narr"  => "当前波动质量状况的通俗语言摘要。将方向性背景、效率水平和质量趋势合并为一个可读的描述。"
            => ""
    else
        switch key
            "eff_title" => "Move quality module. Shows how much of each candle's energy was converted into a clear directional move. Use this to assess whether price action is clean and decisive or noisy and indecisive."
            "eff_badge" => "Module status. Move quality analysis is running on every candle in real time."
            "eff_coup"  => "Shows how this candle's move quality relates to the current trend. BULL/BEAR SURGE = exceptionally strong move with the trend. CONFIRMED = solid alignment. Active = normal support. Stalling = direction ok but weak. Bear/Bull Pressure = strong move against the trend — be cautious. STRONG COUNTER = extreme opposing move. Mild Resistance/Support = moderate counter-move. Noise = weak opposing move, ignore."
            "eff_pct"   => "Move quality percentage. Arrow shows direction: ▲ = bullish, ▼ = bearish. Higher values mean a cleaner, more decisive move. Lower values mean choppy, indecisive action. The system automatically compares this against recent history to determine the status shown in the cell to the left."
            "eff_mom"   => "Shows whether market move quality is improving or deteriorating. Accelerating = moves are getting much cleaner — possible trend breakout. Sharpening = gradual improvement in quality. Steady = no significant change. Fading = moves are getting messier — trend may be exhausting."
            "eff_narr"  => "Plain-language summary of the current move quality situation. Combines the directional context, efficiency level, and quality trend into one readable description."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 17. f_trTipVol — Volume decomposition tooltips (11 keys)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Volume decomposition cells.
// @param key Tooltip key identifier.
// @param lang The dashboard language.
// @returns The translated tooltip string.
export f_trTipVol(string key, string lang) =>
    if lang == "हिन्दी"
        switch key
            "vol_title_geo"   => "वॉल्यूम विश्लेषण मॉड्यूल। कैंडल की आकृति का उपयोग करके दिखाता है कि वर्तमान कैंडल का वॉल्यूम खरीद और बिक्री दबाव में कैसे बँटता है।"
            "vol_title_intra" => "सटीक खरीद/बिक्री वर्गीकरण के लिए निचले टाइमफ्रेम डेटा का उपयोग करता वॉल्यूम विश्लेषण। Essential प्लान या उच्चतर आवश्यक। वैध बार सटीक इंट्राबार डेटा वाली बार दिखाता है।"
            "vol_badge"       => "मॉड्यूल स्थिति। वॉल्यूम वर्गीकरण हर कैंडल पर रियलटाइम चल रहा है।"
            "vol_badge_lock"  => "इस विधि के लिए Essential प्लान या उच्चतर आवश्यक। Geometry पर स्विच करें या अपना प्लान अपग्रेड करें।"
            "vol_lock_tip"    => "इंट्राबार वॉल्यूम के लिए निचले टाइमफ्रेम डेटा तक पहुँच आवश्यक जो Essential प्लान और उच्चतर पर उपलब्ध। आप सेटिंग्स में Geometry विधि पर स्विच कर सकते हैं — सभी प्लान पर काम करती है।"
            "vol_tf_a"        => "चयनित इंट्राबार टाइमफ्रेम ("
            "vol_tf_b"        => ") चार्ट टाइमफ्रेम से कम नहीं है। कम टाइमफ्रेम चुनें या उच्चतर चार्ट टाइमफ्रेम पर जाएँ। Geometry विधि स्वचालित उपयोग में है।"
            "vol_total"       => "किसी भी विश्लेषण से पहले वर्तमान कैंडल का कुल वॉल्यूम। कैंडल्स में तुलना कर वॉल्यूम स्पाइक या सूखापन पहचानें जो आगामी चालों का संकेत दे सकते हैं।"
            "vol_buy"         => "वर्तमान कैंडल पर अनुमानित खरीद दबाव। बिक्री की तुलना में अधिक मान सुझाता है कि माँग आपूर्ति को अवशोषित कर रही। पुलबैक में खरीद प्रभुत्व पर ध्यान दें — अक्सर संचय का संकेत।"
            "vol_sell"        => "वर्तमान कैंडल पर अनुमानित बिक्री दबाव। खरीद की तुलना में अधिक मान सुझाता है कि आपूर्ति माँग को दबा रही। रैलियों में बिक्री प्रभुत्व पर ध्यान दें — अक्सर वितरण का संकेत।"
            "vol_delta"       => "शुद्ध वॉल्यूम संतुलन। धनात्मक = खरीदार प्रमुख, ऋणात्मक = बिक्रेता प्रमुख। वर्तमान दिशा की पुष्टि या प्रश्न के लिए ट्रेंड सिग्नल के साथ उपयोग करें।"
            => ""
    else if lang == "日本語"
        switch key
            "vol_title_geo"   => "出来高分析モジュール。キャンドルの形状を使用して現在のキャンドルの出来高が買い・売り圧力にどう分かれるかを表示。"
            "vol_title_intra" => "下位タイムフレームデータを使用した正確な買い/売り分類の出来高分析。Essentialプラン以上が必要。有効バーは正確なインラバーデータを持つバー数を表示。"
            "vol_badge"       => "モジュール状態。出来高分類がリアルタイムで毎キャンドル実行中。"
            "vol_badge_lock"  => "この手法にはEssentialプラン以上が必要。Geometryに切り替えるかプランをアップグレードしてください。"
            "vol_lock_tip"    => "インラバー出来高にはEssentialプラン以上で利用可能な下位タイムフレームデータへのアクセスが必要。設定でGeometry手法に切り替え可能 — 全プランで動作。"
            "vol_tf_a"        => "選択されたインラバータイムフレーム（"
            "vol_tf_b"        => "）はチャートタイムフレームより低くありません。より低いタイムフレームを選択するか高いチャートTFに切り替えてください。Geometry手法が自動使用中。"
            "vol_total"       => "分析前の現在のキャンドルの総出来高。キャンドル間で比較し今後の動きを示唆する出来高スパイクや枯渇を特定。"
            "vol_buy"         => "現在のキャンドルの推定買い圧力。売りより高い値は需要が供給を吸収中を示唆。プルバック中の買い優勢に注目 — しばしば買い集めのサイン。"
            "vol_sell"        => "現在のキャンドルの推定売り圧力。買いより高い値は供給が需要を圧倒中を示唆。ラリー中の売り優勢に注目 — しばしば売り抜けのサイン。"
            "vol_delta"       => "純出来高バランス。正 = 買い手優勢、負 = 売り手優勢。現在の方向の確認や疑問のためにトレンドシグナルと併用。"
            => ""
    else if lang == "简体中文"
        switch key
            "vol_title_geo"   => "成交量分析模块。使用K线形状显示当前K线的成交量如何在买入和卖出压力之间分配。"
            "vol_title_intra" => "使用低时间框架数据进行精确买/卖分类的成交量分析。需要Essential计划或更高。有效柱数显示有多少柱具有准确的柱内数据。"
            "vol_badge"       => "模块状态。成交量分类在每根K线上实时运行。"
            "vol_badge_lock"  => "此方法需要Essential计划或更高。切换到Geometry或升级您的计划。"
            "vol_lock_tip"    => "柱内成交量需要访问低时间框架数据，该数据在Essential计划及以上可用。您可以在设置中切换到Geometry方法 — 适用于所有计划。"
            "vol_tf_a"        => "选定的柱内时间框架（"
            "vol_tf_b"        => "）不低于图表时间框架。选择更低的时间框架或切换到更高的图表时间框架。Geometry方法正在自动使用。"
            "vol_total"       => "分析前当前K线的总成交量。跨K线比较以发现可能预示即将波动的成交量飙升或枯竭。"
            "vol_buy"         => "当前K线的估计买入压力。相对于卖出较高的值表明需求正在吸收供给。关注回调中的买入主导 — 通常是吸筹信号。"
            "vol_sell"        => "当前K线的估计卖出压力。相对于买入较高的值表明供给正在压倒需求。关注反弹中的卖出主导 — 通常是派发信号。"
            "vol_delta"       => "净成交量平衡。正值 = 买方主导，负值 = 卖方主导。与趋势信号配合使用以确认或质疑当前方向。"
            => ""
    else
        switch key
            "vol_title_geo"   => "Volume decomposition module. Shows how the current candle's volume splits between buying and selling pressure using the candle's shape."
            "vol_title_intra" => "Volume decomposition using lower-timeframe data for precise buy/sell classification. Requires Essential plan or higher. Valid bars shows how many bars have accurate intrabar data."
            "vol_badge"       => "Module status. Volume classification is running on every candle in real time."
            "vol_badge_lock"  => "This method requires Essential plan or higher. Switch to Geometry or upgrade your plan."
            "vol_lock_tip"    => "Intrabar volume requires access to lower-timeframe data which is available on Essential plan and above. You can switch to Geometry method in the settings — it works on all plans."
            "vol_tf_a"        => "The selected intrabar timeframe ("
            "vol_tf_b"        => ") is not lower than the chart timeframe. Choose a lower timeframe or switch to a higher chart timeframe. Geometry method is being used automatically."
            "vol_total"       => "Total volume on the current candle before any decomposition. Compare across candles to spot volume spikes or dry-ups that may signal upcoming moves."
            "vol_buy"         => "Estimated buying pressure on the current candle. Higher values relative to Sell suggest demand is absorbing supply. Watch for Buy dominance during pullbacks — it often signals accumulation."
            "vol_sell"        => "Estimated selling pressure on the current candle. Higher values relative to Buy suggest supply is overwhelming demand. Watch for Sell dominance during rallies — it often signals distribution."
            "vol_delta"       => "Net volume balance. Positive = buyers dominate, negative = sellers dominate. Use this alongside the trend signal to confirm or question the current direction."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 18. f_trTipFp — Footprint tooltips (15 keys)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Volume Footprint cells.
// @param key Tooltip key identifier.
// @param gs Group size string. Pass "" for static keys.
// @param lang The dashboard language.
// @returns The translated tooltip string.
export f_trTipFp(string key, string gs, string lang) =>
    if lang == "हिन्दी"
        switch key
            "fp_title_geo"   => "वॉल्यूम फुटप्रिंट मॉड्यूल। दिखाता है कि हर ग्रुपिंग अवधि में सबसे भारी खरीद और बिक्री कहाँ हुई, और सबसे अधिक कुल वॉल्यूम वाले मूल्य स्तर की पहचान करता है। कैंडल आकृति का उपयोग कर वॉल्यूम वितरण का अनुमान लगाता है।"
            "fp_title_intra" => "वास्तविक खरीद/बिक्री वॉल्यूम गणना के लिए इंट्राबार डेटा उपयोग करता वॉल्यूम फुटप्रिंट। हर ग्रुपिंग अवधि में हर मूल्य स्तर पर सटीक खरीद-बिक्री वॉल्यूम दिखाता है। Essential या उच्चतर प्लान आवश्यक।"
            "fp_badge"       => "मॉड्यूल स्थिति। वॉल्यूम फुटप्रिंट विश्लेषण हर ग्रुपिंग स्केल पर रियलटाइम चल रहा है।"
            "fp_badge_lock"  => "इंट्राबार फुटप्रिंट के लिए Essential या उच्चतर TradingView प्लान आवश्यक। सेटिंग्स में Geometry पर स्विच करें — सभी प्लान पर काम करती है।"
            "fp_lock_tip"    => "इंट्राबार फुटप्रिंट निचले टाइमफ्रेम डेटा से वास्तविक खरीद/बिक्री वॉल्यूम गणना करता है — Essential या उच्चतर TradingView प्लान आवश्यक। सेटिंग्स में फुटप्रिंट विधि Geometry पर बदल सकते हैं — सभी प्लान पर काम करती है और अनुमानित वॉल्यूम वितरण देती है।"
            "fp_col_group"   => "कैंडल ग्रुपिंग स्केल। हर समूह इतनी हाल की बंद कैंडल्स को शामिल करता है।"
            "fp_col_max"     => "इस ग्रुपिंग अवधि में सबसे अधिक अनुमानित खरीद-बिक्री वॉल्यूम वाला मूल्य स्तर।"
            "fp_col_min"     => "इस ग्रुपिंग अवधि में सबसे कम अनुमानित खरीद-बिक्री वॉल्यूम वाला मूल्य स्तर।"
            "fp_col_ctrl"    => "इस ग्रुपिंग अवधि में सबसे अधिक कुल वॉल्यूम वाला मूल्य स्तर। यह सबसे अधिक कारोबार किया गया मूल्य है — एक प्रमुख समर्थन या प्रतिरोध संदर्भ।"
            "fp_group"       => "ग्रुपिंग स्केल: " + gs + " बंद कैंडल। बड़े समूह अधिक संरचनात्मक वॉल्यूम पैटर्न पकड़ते हैं।"
            "fp_max_buy"     => gs + " कैंडल समूह में सबसे भारी खरीद दबाव वाला मूल्य स्तर। किसी मूल्य स्तर पर उच्च मान मज़बूत माँग अवशोषण दर्शाते हैं।"
            "fp_min_buy"     => gs + " कैंडल समूह में सबसे कम खरीद गतिविधि वाला मूल्य स्तर। किसी स्तर पर कम खरीद कमज़ोर माँग दर्शाती है — कीमत यहाँ टिक नहीं सकती।"
            "fp_poc"         => gs + " कैंडल समूह में सबसे अधिक कुल कारोबार वॉल्यूम वाला मूल्य स्तर। चुम्बक का काम करता है — कीमत इस स्तर पर लौटती है। जब कई समूह सहमत हों तो संकेत बहुत मज़बूत।"
            "fp_max_sell"    => gs + " कैंडल समूह में सबसे भारी बिक्री दबाव वाला मूल्य स्तर। किसी मूल्य स्तर पर उच्च मान मज़बूत आपूर्ति वितरण दर्शाते हैं।"
            "fp_min_sell"    => gs + " कैंडल समूह में सबसे कम बिक्री गतिविधि वाला मूल्य स्तर। किसी स्तर पर कम बिक्री कमज़ोर आपूर्ति दर्शाती है — कीमत आसानी से टूट सकती है।"
            => ""
    else if lang == "日本語"
        switch key
            "fp_title_geo"   => "出来高フットプリントモジュール。各グルーピング期間内で最も重い買い・売りの発生場所と最も総出来高の多い価格水準を表示。キャンドル形状から出来高分布を推定。"
            "fp_title_intra" => "インラバーデータによる実際の買い/売り出来高計算の出来高フットプリント。各グルーピング期間の全価格水準で正確な買い・売り出来高を表示。Essentialプラン以上が必要。"
            "fp_badge"       => "モジュール状態。出来高フットプリント分析が全グルーピングスケールでリアルタイム実行中。"
            "fp_badge_lock"  => "インラバーフットプリントにはEssential以上のTradingViewプランが必要。設定でGeometryに切り替え — 全プランで動作。"
            "fp_lock_tip"    => "インラバーフットプリントは下位TFデータから実際の買い/売り出来高を計算 — Essential以上が必要。設定でGeometryに変更可能 — 全プランで動作し推定出来高分布を提供。"
            "fp_col_group"   => "キャンドルグルーピングスケール。各グループはこの数の直近確定キャンドルを含む。"
            "fp_col_max"     => "このグルーピング期間内で最も高い推定買い・売り出来高の価格水準。"
            "fp_col_min"     => "このグルーピング期間内で最も低い推定買い・売り出来高の価格水準。"
            "fp_col_ctrl"    => "このグルーピング期間内で最も高い総出来高の価格水準。最も取引された価格 — 重要な支持・抵抗の参照。"
            "fp_group"       => "グルーピングスケール: " + gs + "本の確定キャンドル。大きなグループほど構造的な出来高パターンを捕捉。"
            "fp_max_buy"     => gs + "本キャンドルグループ内で最も重い買い圧力の価格水準。高い値は強い需要吸収を示す。"
            "fp_min_buy"     => gs + "本キャンドルグループ内で最も少ない買い活動の価格水準。低い買いは弱い需要を示唆 — 価格が維持されない可能性。"
            "fp_poc"         => gs + "本キャンドルグループ内で最も多い総取引出来高の価格水準。マグネットとして機能 — 価格はこの水準に回帰する傾向。複数グループが合意すると非常に強いシグナル。"
            "fp_max_sell"    => gs + "本キャンドルグループ内で最も重い売り圧力の価格水準。高い値は強い供給分配を示す。"
            "fp_min_sell"    => gs + "本キャンドルグループ内で最も少ない売り活動の価格水準。低い売りは弱い供給を示唆 — 価格が容易に突破する可能性。"
            => ""
    else if lang == "简体中文"
        switch key
            "fp_title_geo"   => "成交量足迹模块。显示每个分组期间内最重的买入和卖出发生在哪里，并识别总成交量最大的价格水平。使用K线形状估计成交量在价格水平间的分布。"
            "fp_title_intra" => "使用柱内数据计算实际买/卖成交量的成交量足迹。显示每个分组期间内每个价格水平的精确买卖成交量。需要Essential计划或更高。"
            "fp_badge"       => "模块状态。成交量足迹分析在每个分组尺度上实时运行。"
            "fp_badge_lock"  => "柱内足迹需要Essential或更高的TradingView计划。在设置中切换到Geometry — 适用于所有计划。"
            "fp_lock_tip"    => "柱内足迹使用低时间框架数据计算实际买/卖成交量 — 需要Essential或更高的TradingView计划。您可以在设置中将足迹方法更改为Geometry — 适用于所有计划并提供估计的成交量分布。"
            "fp_col_group"   => "K线分组尺度。每个组涵盖这么多最近确认的K线。"
            "fp_col_max"     => "此分组期间内估计买卖成交量最高的价格水平。"
            "fp_col_min"     => "此分组期间内估计买卖成交量最低的价格水平。"
            "fp_col_ctrl"    => "此分组期间内总成交量最高的价格水平。这是交易最多的价格 — 关键的支撑或阻力参考。"
            "fp_group"       => "分组尺度：" + gs + "根确认K线。更大的组捕捉更多结构性成交量模式。"
            "fp_max_buy"     => gs + "根K线组内买入压力最重的价格水平。某价格水平的高值表明强劲的需求吸收。"
            "fp_min_buy"     => gs + "根K线组内买入活动最少的价格水平。某水平的低买入暗示弱需求 — 价格可能无法维持。"
            "fp_poc"         => gs + "根K线组内总交易成交量最高的价格水平。作为磁吸点 — 价格倾向于回到这个水平。当多个组在同一水平达成一致时，信号非常强。"
            "fp_max_sell"    => gs + "根K线组内卖出压力最重的价格水平。某价格水平的高值表明强劲的供给派发。"
            "fp_min_sell"    => gs + "根K线组内卖出活动最少的价格水平。某水平的低卖出暗示弱供给 — 价格可能轻松突破。"
            => ""
    else
        switch key
            "fp_title_geo"   => "Volume footprint module. Shows where the heaviest buying and selling occurred within each grouping period, and identifies the price level with the most total volume. Uses the candle shape to estimate how volume distributes across price levels."
            "fp_title_intra" => "Volume footprint using intrabar data to calculate real buy/sell volume. Shows exact buy and sell volume at every price level within each grouping period. Requires Essential plan or higher."
            "fp_badge"       => "Module status. Volume footprint analysis is running on every grouping scale in real time."
            "fp_badge_lock"  => "Intrabar footprint requires Essential or higher TradingView plan. Switch to Geometry in the settings — it works on all plans."
            "fp_lock_tip"    => "Intrabar footprint uses lower-timeframe data to calculate real buy/sell volume — requires Essential or higher TradingView plan. You can switch the Footprint Method to Geometry in the settings — it works on all plans and provides estimated volume distribution."
            "fp_col_group"   => "The candle grouping scale. Each group covers this many recently closed candles."
            "fp_col_max"     => "The price level where the highest estimated buying and selling volume occurred within this group period."
            "fp_col_min"     => "The price level where the lowest estimated buying and selling volume occurred within this group period."
            "fp_col_ctrl"    => "The price level with the highest total volume within this group period. This is the most traded price — a key support or resistance reference."
            "fp_group"       => "Grouping scale: " + gs + " closed candles. Larger groups capture more structural volume patterns."
            "fp_max_buy"     => "The price level where the heaviest buying pressure occurred in the " + gs + "-candle group. High values at a price level indicate strong demand absorption."
            "fp_min_buy"     => "The price level with the least buying activity in the " + gs + "-candle group. Low buying at a level suggests weak demand — price may not hold here."
            "fp_poc"         => "The price level with the highest total traded volume in the " + gs + "-candle group. Acts as a magnet — price tends to revisit this level. When multiple groups agree on the same level, the signal is very strong."
            "fp_max_sell"    => "The price level where the heaviest selling pressure occurred in the " + gs + "-candle group. High values at a price level indicate strong supply distribution."
            "fp_min_sell"    => "The price level with the least selling activity in the " + gs + "-candle group. Low selling at a level suggests weak supply — price may break through easily."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 19. f_trTipVi — Volume Insight tooltips (6 keys)
// ══════════════════════════════════════════════════════════════════════════════════

// @function Returns translated tooltip text for Volume Insight cells.
// @param key Tooltip key identifier.
// @param lang The dashboard language.
// @returns The translated tooltip string.
export f_trTipVi(string key, string lang) =>
    if lang == "हिन्दी"
        switch key
            "vi_title"    => "वॉल्यूम दबाव विश्लेषण। खरीद/बिक्री संतुलन, वॉल्यूम तीव्रता, और सभी ग्रुपिंग स्केल पर संरचनात्मक वॉल्यूम वितरण को जोड़कर मूल्यांकन करता है कि कौन नियंत्रण में है और आगे क्या उम्मीद करें।"
            "vi_badge"    => "मॉड्यूल स्थिति। वॉल्यूम दबाव विश्लेषण हर कैंडल पर रियलटाइम चल रहा है।"
            "vi_scenario" => "वर्तमान वॉल्यूम परिदृश्य। अभी पहचाना गया प्रमुख वॉल्यूम पैटर्न दिखाता है। पूर्ण पुष्टि = वॉल्यूम ट्रेंड का पूर्ण समर्थन। प्रतिरोध = वॉल्यूम ट्रेंड के विरुद्ध। समर्पण = निचले स्तरों पर घबराहट बिक्री। थकान = ऊपरी स्तरों पर उत्साही खरीद। उचित मूल्य चुम्बक = कई ग्रुपिंग स्केल एक ही वॉल्यूम केंद्र पर सहमत। अवशोषण = खरीदार समर्थन की रक्षा कर रहे। वितरण = बिक्रेता प्रतिरोध सीमित कर रहे।"
            "vi_zone"     => "वॉल्यूम तीव्रता और दिशा। तीर प्रमुख पक्ष दिखाता है: ▲ = खरीदार, ▼ = बिक्रेता, ◆ = संतुलित। विस्फोटक = इतिहास का शीर्ष 5%। उच्च = शीर्ष 25%। सामान्य = औसत। बहुत कम = तल 25%।"
            "vi_poc"      => "दिखाता है कि कितने ग्रुपिंग स्केल का वॉल्यूम केंद्र एक ही मूल्य स्तर के पास है। 4 या अधिक = बहुत मज़बूत सहमति। 2 = आंशिक सहमति। स्केल असहमत = बिखरा हुआ।"
            "vi_narr"     => "वर्तमान वॉल्यूम स्थिति का सरल भाषा में सारांश। वॉल्यूम क्या कर रहा है, संरचनात्मक रूप से यह क्यों मायने रखता है, और आगे क्या उम्मीद करें — सब एक पठनीय विवरण में।"
            => ""
    else if lang == "日本語"
        switch key
            "vi_title"    => "出来高圧力分析。買い/売りバランス、出来高強度、構造的分布を統合し、誰が主導権を握り次に何が起きるかを評価。"
            "vi_badge"    => "モジュール状態。出来高圧力分析がリアルタイムで毎キャンドル実行中。"
            "vi_scenario" => "現在の出来高シナリオ。完全確認 = 出来高がトレンドを完全支持。反発 = 出来高がトレンドに逆行。投げ売り = 安値でパニック売り。疲弊 = 高値で熱狂的買い。適正価格マグネット = 複数スケールが同一出来高中心に合意。吸収 = 買い手が支持を防衛。分配 = 売り手が抵抗を制限。"
            "vi_zone"     => "出来高強度と方向。矢印は主導側: ▲ = 買い手、▼ = 売り手、◆ = 均衡。爆発的 = 上位5%。高 = 上位25%。通常 = 平均。極低 = 下位25%。"
            "vi_poc"      => "何スケールの出来高中心が同一価格付近に集中しているか。4以上 = 非常に強い合意。2 = 部分的合意。不一致 = 分散。"
            "vi_narr"     => "現在の出来高状況の平易な要約。出来高の動き、構造的意味、次の展望を一つの説明にまとめたもの。"
            => ""
    else if lang == "简体中文"
        switch key
            "vi_title"    => "成交量压力分析。综合买卖平衡、成交量强度和所有分组尺度的结构性分布，评估谁在掌控以及接下来会发生什么。"
            "vi_badge"    => "模块状态。成交量压力分析在每根K线上实时运行。"
            "vi_scenario" => "当前成交量场景。完全确认 = 成交量完全支持趋势。反击 = 成交量对抗趋势。恐慌抛售 = 低位恐慌卖出。买入衰竭 = 高位狂热买入。公允价值磁吸 = 多个尺度在同一成交量中心达成一致。需求吸收 = 买方守护支撑。供给派发 = 卖方封顶阻力。"
            "vi_zone"     => "成交量强度和方向。箭头显示主导方：▲ = 买方，▼ = 卖方，◆ = 均衡。爆发性 = 历史前5%。高 = 前25%。适中 = 平均。极低 = 后25%。"
            "vi_poc"      => "显示有多少分组尺度的成交量中心接近同一价格水平。4或更多 = 非常强的共识。2 = 部分共识。尺度分歧 = 分散。"
            "vi_narr"     => "当前成交量状况的通俗语言摘要。描述成交量在做什么、为什么在结构上重要、以及接下来预期什么 — 全部在一个可读的描述中。"
            => ""
    else
        switch key
            "vi_title"    => "Volume pressure analysis. Combines buying/selling balance, volume intensity, and structural volume distribution across all grouping scales to assess who is in control and what to expect next."
            "vi_badge"    => "Module status. Volume pressure analysis is running on every candle in real time."
            "vi_scenario" => "The current volume scenario. Shows the dominant volume pattern detected right now. Full Confirmation = volume fully supports the trend. Counter = volume fights the trend. Capitulation = panic selling at lows. Exhaustion = euphoric buying at highs. Fair Value Magnet = multiple grouping scales agree on the same volume center. Absorption = buyers defending support. Distribution = sellers capping resistance."
            "vi_zone"     => "Volume intensity and direction. Arrow shows dominant side: ▲ = buyers, ▼ = sellers, ◆ = balanced. Explosive = top 5% of history. Elevated = top 25%. Moderate = average. Very Low = bottom 25%."
            "vi_poc"      => "Shows how many grouping scales have their volume center near the same price level. 4 or higher = very strong agreement. 2 = partial agreement. Scales Disagree = scattered."
            "vi_narr"     => "Plain-language summary of the current volume situation. Describes what volume is doing, why it matters structurally, and what to expect next — all in one readable description."
            => ""

// ══════════════════════════════════════════════════════════════════════════════════
// 20. f_trTrendDesc — Trend state description + conviction suffix
// ══════════════════════════════════════════════════════════════════════════════════

// @function Builds the trend state description with conviction suffix for the tooltip.
// @param cas Cascade active flag.
// @param casDir Cascade direction.
// @param div Divergence active flag.
// @param smD Micro direction.
// @param algn Alignment score (-6 to +6).
// @param mBias Macro bias active flag.
// @param mBiasDir Macro bias direction.
// @param lang The dashboard language.
// @returns Complete tooltip string.
export f_trTrendDesc(bool cas, int casDir, bool div, int smD, int algn, bool mBias, int mBiasDir, string lang) =>
    bool _hi = lang == "हिन्दी"
    bool _ja = lang == "日本語"
    bool _zh = lang == "简体中文"
    string _d = ""
    if cas
        _d := casDir > 0 ? (_hi ? "कई परतों में तेज़ी पलटाव पुष्ट" : _ja ? "複数レイヤーにわたる強気反転確認" : _zh ? "多层确认看涨反转" : "Bullish reversal confirmed across multiple layers") : (_hi ? "कई परतों में मंदी पलटाव पुष्ट" : _ja ? "複数レイヤーにわたる弱気反転確認" : _zh ? "多层确认看跌反转" : "Bearish reversal confirmed across multiple layers")
    else if div
        _d := smD > 0 ? (_hi ? "छोटी अवधि तेज़ी की ओर मुड़ रही, लंबी अवधि अभी मंदी में" : _ja ? "短期が強気に転換中、長期はまだ弱気" : _zh ? "短期转为看涨，长期仍看跌" : "Short-term turning bullish, long-term still bearish") : (_hi ? "छोटी अवधि मंदी की ओर मुड़ रही, लंबी अवधि अभी तेज़ी में" : _ja ? "短期が弱気に転換中、長期はまだ強気" : _zh ? "短期转为看跌，长期仍看涨" : "Short-term turning bearish, long-term still bullish")
    else if mBias
        _d := mBiasDir > 0 ? (_hi ? "अल्पकालिक शोर के पीछे अंतर्निहित तेज़ी रुझान" : _ja ? "短期ノイズの裏に根底の強気バイアス" : _zh ? "短期噪音背后的底层看涨倾向" : "Underlying bullish bias behind short-term noise") : (_hi ? "अल्पकालिक उछालों के पीछे अंतर्निहित मंदी रुझान" : _ja ? "短期反発の裏に根底の弱気バイアス" : _zh ? "短期反弹背后的底层看跌倾向" : "Underlying bearish bias behind short-term bounces")
    else if algn == 6
        _d := _hi ? "सभी समय सीमाएँ तेज़ी में" : _ja ? "全時間軸が強気" : _zh ? "所有时间周期看涨" : "All time horizons bullish"
    else if algn == -6
        _d := _hi ? "सभी समय सीमाएँ मंदी में" : _ja ? "全時間軸が弱気" : _zh ? "所有时间周期看跌" : "All time horizons bearish"
    else if algn == 5
        _d := _hi ? "लगभग सभी समय सीमाएँ तेज़ी में" : _ja ? "ほぼ全時間軸が強気" : _zh ? "几乎所有时间周期看涨" : "Nearly all time horizons bullish"
    else if algn == -5
        _d := _hi ? "लगभग सभी समय सीमाएँ मंदी में" : _ja ? "ほぼ全時間軸が弱気" : _zh ? "几乎所有时间周期看跌" : "Nearly all time horizons bearish"
    else if algn >= 3
        _d := _hi ? "अधिकांश समय सीमाएँ तेज़ी में" : _ja ? "大半の時間軸が強気" : _zh ? "大多数时间周期看涨" : "Majority of time horizons bullish"
    else if algn <= -3
        _d := _hi ? "अधिकांश समय सीमाएँ मंदी में" : _ja ? "大半の時間軸が弱気" : _zh ? "大多数时间周期看跌" : "Majority of time horizons bearish"
    else
        _d := _hi ? "कोई स्पष्ट दिशा नहीं" : _ja ? "明確な方向なし" : _zh ? "无明确方向" : "No clear direction"
    string _sfx = _hi ? "। दिखाता है कि ट्रेंड के पीछे की चालें कितनी शक्तिशाली हैं। उच्च = मज़बूत, निर्णायक गति। मध्यम = सामान्य ताकत। निम्न = दिशा है लेकिन चालें कमज़ोर — सतर्क रहें।" : _ja ? "。トレンドの背後の動きの力強さを表示。高 = 強く決定的な勢い。中 = 通常の強さ。低 = 方向はあるが動きは弱い — 慎重に。" : _zh ? "。显示趋势背后的波动有多强劲。高 = 强劲、果断的动量。中 = 正常力度。低 = 方向存在但波动较弱 — 需谨慎。" : ". Shows how powerful the moves behind the trend are. HIGH = strong, decisive momentum. MODERATE = normal strength. LOW = the direction is there but the moves are weak — be cautious."
    _d + _sfx

