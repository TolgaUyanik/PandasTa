// @version=6
library("DivergenceDetector")

// =========================================================================
// 既存機能：ダイバージェンス検出・RCI計算
// =========================================================================

// @function 価格のピボットハイを基準に、ベアリッシュ・ダイバージェンスを検出します。
export f_detect_divergence_high(series float price, series float osc, int pivotLeft, int pivotRight) =>
    var float lastPriceHigh    = na
    var float lastOscHigh      = na
    var int   lastPriceHighBar = na
    int   divType      = 0
    int   currentBar   = na
    float currentPrice = na
    int   prevBar      = na
    float prevPrice    = na

    float priceHigh = ta.pivothigh(price, pivotLeft, pivotRight)
    if not na(priceHigh)
        currentBar   := bar_index - pivotRight
        currentPrice := priceHigh
        float currOsc = osc[pivotRight]
        if not na(lastPriceHigh)
            if currentPrice > lastPriceHigh and currOsc < lastOscHigh
                divType   := 3
                prevBar   := lastPriceHighBar
                prevPrice := lastPriceHigh
            else if currentPrice < lastPriceHigh and currOsc > lastOscHigh
                divType   := 4
                prevBar   := lastPriceHighBar
                prevPrice := lastPriceHigh
        lastPriceHigh    := currentPrice
        lastOscHigh      := currOsc
        lastPriceHighBar := currentBar

    [divType, currentBar, currentPrice, prevBar, prevPrice]

// @function 価格のピボットローを基準に、ブル・ダイバージェンスを検出します。
export f_detect_divergence_low(series float price, series float osc, int pivotLeft, int pivotRight) =>
    var float lastPriceLow    = na
    var float lastOscLow      = na
    var int   lastPriceLowBar = na
    int   divType      = 0
    int   currentBar   = na
    float currentPrice = na
    int   prevBar      = na
    float prevPrice    = na

    float priceLow = ta.pivotlow(price, pivotLeft, pivotRight)
    if not na(priceLow)
        currentBar   := bar_index - pivotRight
        currentPrice := priceLow
        float currOsc = osc[pivotRight]
        if not na(lastPriceLow)
            if currentPrice < lastPriceLow and currOsc > lastOscLow
                divType   := 1
                prevBar   := lastPriceLowBar
                prevPrice := lastPriceLow
            else if currentPrice > lastPriceLow and currOsc < lastOscLow
                divType   := 2
                prevBar   := lastPriceLowBar
                prevPrice := lastPriceLow
        lastPriceLow    := currentPrice
        lastOscLow      := currOsc
        lastPriceLowBar := currentBar

    [divType, currentBar, currentPrice, prevBar, prevPrice]

// @function ソースと期間を指定してRCI（順位相関指数）を計算します。
// @param src 計算対象のソースシリーズ（close, high, hl2など）。
// @param length 計算期間（バー数）。
// @returns 計算されたRCIの値。期間が0以下の場合はnaを返します。
export f_rci(series float src, int length) =>
    float rci = na
    if length > 0
        float sum_d = 0.0
        for i = 0 to length - 1
            float price_rank = 1.0
            for j = 0 to length - 1
                if src[j] > src[i]
                    price_rank += 1.0
                else if src[j] == src[i] and i != j
                    price_rank += 0.5
            float date_rank = i + 1.0
            float d = price_rank - date_rank
            sum_d += math.pow(d, 2)
        rci := (1.0 - (6.0 * sum_d) / (length * (math.pow(length, 2) - 1.0))) * 100.0
    rci


// =========================================================================
// 新規追加：共通ヘルパー関数群 (Multi Indicators, QQE, MACD, RCI等用)
// =========================================================================

// @function 移動平均線（MA）を指定された種類で計算します。
// @param source 計算対象のソース
// @param length 計算期間
// @param maType MAの種類 ('SMA', 'EMA', 'SMMA (RMA)', 'WMA', 'VWMA')
// @returns 計算された移動平均値
export f_ma(series float source, int length, simple string maType) =>
    switch maType
        'SMA' => ta.sma(source, length)
        'EMA' => ta.ema(source, length)
        'SMMA (RMA)' => ta.rma(source, length)
        'WMA' => ta.wma(source, length)
        'VWMA' => ta.vwma(source, length)

// @function Polyline（連続線）の座標追加、古い履歴の削除、再描画を一括で行います。
// @param pts 座標を格納するchart.point配列
// @param val 追加するY座標（価格・オシレーター値など）
// @param p_ref 削除対象となる直前のpolylineオブジェクト
// @param col 線の色
// @param w 線の太さ
// @param sty 線のスタイル
// @param max_drawings 配列に保持する最大ポイント数
// @returns 新しく描画されたpolylineオブジェクト
export f_draw_poly(chart.point[] pts, float val, polyline p_ref, color col, int w, string sty, int max_drawings) =>
    if not na(val)
        array.push(pts, chart.point.from_index(bar_index, val))
        if array.size(pts) > max_drawings
            array.shift(pts)
    
    polyline.delete(p_ref)
    polyline p_new = na
    if array.size(pts) > 1
        p_new := polyline.new(pts, line_color=col, line_width=w, line_style=sty)
    p_new

// @function X座標を基準に、指定期間より古いラベル(Label)を一斉削除します。
// @param lbl_arr 管理しているlabel配列
// @param max_drawings 保持する過去の期間（足数）
export f_clean_labels(label[] lbl_arr, int max_drawings) =>
    while array.size(lbl_arr) > 0 and label.get_x(array.get(lbl_arr, 0)) < bar_index - max_drawings
        label.delete(array.shift(lbl_arr))

// @function X座標（終了点）を基準に、指定期間より古いライン(Line)を一斉削除します。
// @param line_arr 管理しているline配列
// @param max_drawings 保持する過去の期間（足数）
export f_clean_lines(line[] line_arr, int max_drawings) =>
    while array.size(line_arr) > 0 and line.get_x2(array.get(line_arr, 0)) < bar_index - max_drawings
        line.delete(array.shift(line_arr))

// @function X座標（左端）を基準に、指定期間より古いボックス(Box)を一斉削除します。
// @param box_arr 管理しているbox配列
// @param max_drawings 保持する過去の期間（足数）
export f_clean_boxes(box[] box_arr, int max_drawings) =>
    while array.size(box_arr) > 0 and box.get_left(array.get(box_arr, 0)) < bar_index - max_drawings
        box.delete(array.shift(box_arr))