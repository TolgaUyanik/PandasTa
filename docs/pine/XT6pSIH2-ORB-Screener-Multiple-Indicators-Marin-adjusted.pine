// 1. Define swap helper OUTSIDE the loop
swap(arr, a, b) =>
    tmp = array.get(arr, a)
    array.set(arr, a, array.get(arr, b))
    array.set(arr, b, tmp)



position = (y_coordinate == "Top" ? (x_coordinate == "Left" ? position.top_left : x_coordinate == "Center" ? position.top_center : position.top_right) : y_coordinate == "Middle" ? (x_coordinate == "Left" ? position.middle_left : x_coordinate == "Center" ? position.middle_center : position.middle_right) : y_coordinate == "Bottom" ? (x_coordinate == "Left" ? position.bottom_left : x_coordinate == "Center" ? position.bottom_center : position.bottom_right) : position.top_right)

var tbl = table.new(position, 11, 42, frame_color=#151715, frame_width=1, border_width=2, border_color=color.new(color.white, 100))
if barstate.islast
    table.cell(tbl, 0, 0, 'Symbol',  text_halign = text.align_center, bgcolor = #295b79, text_color = color.white, text_size = size)
    table.cell(tbl, 1, 0, 'LTP',     text_halign = text.align_center, bgcolor = #295b79, text_color = color.white, text_size = size)
    table.cell(tbl, 2, 0, 'Low',  text_halign = text.align_center, bgcolor = #295b79, text_color = color.white, text_size = size)    
    table.cell(tbl, 3, 0, 'High',     text_halign = text.align_center, bgcolor = #295b79, text_color = color.white, text_size = size)    
    table.cell(tbl, 4, 0, 'Status',     text_halign = text.align_center, bgcolor = #295b79, text_color = color.white, text_size = size)
    table.cell(tbl, 5, 0, 'RSI',     text_halign = text.align_center, bgcolor = #295b79, text_color = color.white, text_size = size)
    table.cell(tbl, 6, 0, 'VWAP', text_halign=text.align_center, bgcolor=#295b79, text_color=color.white, text_size=size)
    table.cell(tbl, 7, 0, 'Vol Surge', text_halign = text.align_center, bgcolor = #295b79, text_color  = color.white, text_size = size)
    table.cell(tbl, 8, 0, 'ADX OK', text_halign=text.align_center, bgcolor=#295b79, text_color=color.white, text_size=size)
    table.cell(tbl, 9, 0, 'MACD', text_halign=text.align_center, bgcolor=#295b79, text_color=color.white, text_size=size)
    table.cell(tbl, 10, 0, 'Score (Signal)', text_halign = text.align_center, bgcolor = #295b79, text_color = color.white, text_size = size)

    for i = 0 to 39
        if array.get(u_arr, i) and array.get(sym_arr, i) != ""
            table.cell(tbl, 0, i + 1, array.get(sym_arr, i), text_halign = text.align_center, bgcolor = #295b79, text_color = color.white, text_size = size)
            table.cell(tbl, 1, i + 1, str.tostring(array.get(close_arr, i), "#.###"), text_halign = text.align_center, bgcolor = color.gray, text_color = color.white, text_size = size)
            table.cell(tbl, 2, i + 1, str.tostring(array.get(high_arr, i), "#.###"), text_halign = text.align_center, bgcolor = array.get(bg1_arr, i), text_color = color.white, text_size = size)
            table.cell(tbl, 3, i + 1, str.tostring(array.get(low_arr, i), "#.###"), text_halign = text.align_center, bgcolor = array.get(bg2_arr, i), text_color = color.white, text_size = size)
            table.cell(tbl, 4, i + 1, array.get(status_arr, i), text_halign = text.align_center, bgcolor = array.get(status_arr, i) == "Abv High" ? color.green : array.get(status_arr, i) == "Blw Low" ? color.red : color.gray, text_color = color.white, text_size = size)
            table.cell(tbl, 5, i + 1, str.tostring(array.get(rsi_arr, i), "#.###"), text_halign = text.align_center, bgcolor = color.gray, text_color = color.white, text_size = size)
            bg_vwap = array.get(close_arr, i) > array.get(vwap_arr, i) ? color.green : color.red
            table.cell(tbl, 6, i + 1, str.tostring(array.get(vwap_arr, i), "#.###"), text_halign = text.align_center, bgcolor = bg_vwap, text_color  = color.white, text_size = size)
            // ─── NEW MACD CELL (index 7) ─────────────────────────
            macd_val   = array.get(macd_hist_arr, i)
            macd_bg    = macd_val > 0 ? color.new(color.green,0): macd_val < 0 ? color.new(color.red,0): color.gray
            table.cell(tbl, 9, i + 1, str.tostring(macd_val, "#.###"),
           text_halign=text.align_center, bgcolor=macd_bg,
           text_color=color.white, text_size=size)
            is_vol = array.get(v_ok_arr, i) 
            bg_vol = is_vol ? color.green : color.red
            table.cell(tbl, 7, i + 1, is_vol ? 'YES' : 'NO', text_halign = text.align_center, bgcolor = bg_vol, text_color  = color.white,text_size = size)
            adx_flag = array.get(adx_ok_arr, i)
            bg_adx   = adx_flag ? color.green : color.red
            table.cell(tbl, 8, i+1, adx_flag ? 'YES' : 'NO', text_halign = text.align_center, bgcolor = bg_adx, text_color = color.white, text_size = size)
            score_val  = array.get(score_arr, i)
            status_val = array.get(status_arr, i)
            signal_lbl = score_val >= 75 and status_val == "Abv High" ? "Buy" :
                         score_val >= 75 and status_val == "Blw Low"  ? "Sell" : ""
            display    = signal_lbl != "" ? str.tostring(score_val) + " (" + signal_lbl + ")" : str.tostring(score_val)

            bg_score   = score_val >= 75 ? color.green :
                         score_val >= 50 ? color.orange : color.red
            table.cell(tbl, 10, i + 1, display, text_halign = text.align_center, bgcolor = bg_score, text_color = color.white, text_size = size)




