//@version=6
library("hudDisplay_v1", overlay=false)
//import Solvere/hudDisplay_v1/4
// Modified 250723_0900

// === Position Resolution ===
export f_getPosition(string loc) =>
    if loc == "Top Left"
        position.top_left
    else if loc == "Top Center"
        position.top_center
    else if loc == "Top Right"
        position.top_right
    else if loc == "Middle Left"
        position.middle_left
    else if loc == "Middle Center"
        position.middle_center
    else if loc == "Middle Right"
        position.middle_right
    else if loc == "Bottom Left"
        position.bottom_left
    else if loc == "Bottom Center"
        position.bottom_center
    else
        position.bottom_right

// === Table Dimension Resolver ===
// Adds padding rows/columns according to HUD size multiplier
export f_getTableSize(string layout, int itemCount, string hudSize) =>
    // Define padding multiplier per HUD size
    float padMult = hudSize == "XS" ? 1.0 :hudSize == "Small" ? 1.2 :hudSize == "Normal" ? 1.5 :hudSize == "Large" ? 1.8 :2.0 // XL or fallback

    // Calculate padded size
    int paddedCount = math.max(1, math.round(itemCount * padMult))

    layout == "Vertical" ? array.from(1, paddedCount) : array.from(paddedCount, 1)

// === Cell Position Resolver ===
export f_getCellPosition(string layout, int index) =>
    layout == "Vertical" ? array.from(0, index) : array.from(index, 0)

// === Helper function mapping string to size constant ===
f_mapTextSize(sz) =>
    if sz == "tiny"
        size.tiny
    else if sz == "small"
        size.small
    else if sz == "normal"
        size.normal
    else if sz == "large"
        size.large
    else
        size.huge  // fallback for "normal" or others

// === HUD Table Drawer with Size Support ===
export f_drawHUD(bool show, string loc, string layout, string[] content, color textColor, color bgColor, string textSize) =>
    ts = f_mapTextSize(textSize)  // map string input to size int

    var table hud = na
    if na(hud)
        size = f_getTableSize(layout, array.size(content), textSize)
        cols = array.get(size, 0)
        rows = array.get(size, 1)
        hud := table.new(f_getPosition(loc), cols, rows, border_width=1, frame_color=color.new(color.gray, 85))

    if show and array.size(content) > 0
        for i = 0 to array.size(content) - 1
            cell = f_getCellPosition(layout, i)
            col = array.get(cell, 0)
            row = array.get(cell, 1)
            table.cell(hud, col, row, array.get(content, i), text_color=textColor, bgcolor=bgColor, text_size=ts)
    else
        table.clear(hud, 0, 0)
