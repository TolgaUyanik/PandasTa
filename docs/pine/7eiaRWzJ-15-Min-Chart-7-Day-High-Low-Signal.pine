//@version=5
indicator("15-Min Chart, 7-Day High-Low Signal", overlay=true)

// === INPUTS ===
dropThreshold = 5.0     // Buy threshold (% below high)
riseThreshold = 5.0     // Sell threshold (% above low)
lookbackBars = 182      // ~7 trading days × 26 bars/day (for 15-min chart)

// === ROLLING EXTREMES (EXCLUDING CURRENT BAR)
highestHigh = ta.highest(high[1], lookbackBars)
lowestLow   = ta.lowest(low[1], lookbackBars)

// === PERCENTAGE DIFFERENCE
percentDropFromHigh = ((low - highestHigh) / highestHigh) * 100
percentRiseFromLow  = ((high - lowestLow) / lowestLow) * 100

// === ONE SIGNAL PER LOOKBACK WINDOW
var int lastBuyIndex = na
var int lastSellIndex = na

buySignal  = percentDropFromHigh <= -dropThreshold and (na(lastBuyIndex) or (bar_index - lastBuyIndex >= lookbackBars))
sellSignal = percentRiseFromLow  >=  riseThreshold and (na(lastSellIndex) or (bar_index - lastSellIndex >= lookbackBars))

if buySignal
    lastBuyIndex := bar_index
if sellSignal
    lastSellIndex := bar_index

// === PLOT ON CHART
plotshape(buySignal, style=shape.labelup, location=location.belowbar, color=color.green, text="Buy", size=size.small)
plotshape(sellSignal, style=shape.labeldown, location=location.abovebar, color=color.red, text="Sell", size=size.small)

// === ALERTS
alertcondition(buySignal, title="Buy Alert", message="{{ticker}}: Low ≥ {{dropThreshold}}% below 7-day high.")
alertcondition(sellSignal, title="Sell Alert", message="{{ticker}}: High ≥ {{riseThreshold}}% above 7-day low.")
