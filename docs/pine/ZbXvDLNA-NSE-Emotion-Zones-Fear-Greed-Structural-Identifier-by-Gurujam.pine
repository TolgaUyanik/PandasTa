//@version=6
indicator("NSE Emotion Zones: Fear & Greed Structural Identifier", overlay=true, max_labels_count=500)

// =========================================================================
// 1. CUSTOMIZABLE INPUTS
// =========================================================================
grp_vol   = "Volume & Liquidity Settings (NSE Adaptive)"
volLength = input.int(20, "Volume Moving Average Length", group=grp_vol, tooltip="Adjust for NSE stock liquidity")
volMult   = input.float(1.5, "Volume Climax Multiplier", step=0.1, group=grp_vol)

grp_wicks = "Candlestick Emotion Settings"
wickRatio = input.float(2.0, "Wick to Body Ratio (for Reversals)", step=0.5, group=grp_wicks)
dojiSize  = input.float(0.05, "Doji Max Body Size (%)", step=0.01, group=grp_wicks)

// =========================================================================
// 2. VOLUME SPREAD ANALYSIS (EFFORT VS RESULT)
// =========================================================================
// Calculate baseline volume to adapt to specific Nairobi Stock Exchange equities
avgVol = ta.sma(volume, volLength)
isHighVolume = volume > (avgVol * volMult)

// =========================================================================
// 3. CANDLESTICK ANATOMY DEFINITIONS
// =========================================================================
bodySize = math.abs(close - open)
candleRange = high - low
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

// Fear/Capitulation Signatures (Accumulation Phase / Spring)
isHammer = (lowerWick >= (bodySize * wickRatio)) and (upperWick <= bodySize) and (candleRange > 0)
isBullEngulfing = (close > open) and (open <= close[1]) and (close >= open[1]) and (close[1] < open[1])

// Greed/Euphoria Signatures (Distribution Phase / Upthrust)
isShootingStar = (upperWick >= (bodySize * wickRatio)) and (lowerWick <= bodySize) and (candleRange > 0)
isBearEngulfing = (close < open) and (open >= close[1]) and (close <= open[1]) and (close[1] > open[1])

// Indecision / Transition 
isDoji = bodySize <= (candleRange * dojiSize)

// =========================================================================
// 4. EMOTION LOGIC & WYCKOFF ALIGNMENT
// =========================================================================
// Fear (Capitulation/Spring): Extreme downward exhaustion met with high volume buying
fearSignal = isHighVolume and (isHammer or isBullEngulfing)

// Greed (Euphoria/UTAD): Extreme upward momentum met with high volume selling
greedSignal = isHighVolume and (isShootingStar or isBearEngulfing)

// Trend Continuation (Flags)
bullishContinuation = close > ta.sma(close, 50) and isHighVolume and (close > open) and not greedSignal
bearishContinuation = close < ta.sma(close, 50) and isHighVolume and (close < open) and not fearSignal

// =========================================================================
// 5. VISUALIZATIONS (BALLOONS AND FLAGS)
// =========================================================================
// Plotting Fear (Reversals) using balloon-style labels
plotshape(fearSignal, title="Fear / Capitulation", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 20), text="FEAR\n(Spring)", textcolor=color.white, size=size.small)

// Plotting Greed (Reversals) using balloon-style labels
plotshape(greedSignal, title="Greed / Euphoria", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 20), text="GREED\n(UTAD)", textcolor=color.white, size=size.small)

// Plotting Continuations using flags
plotshape(bullishContinuation and isDoji[1], title="Bullish Continuation Flag", style=shape.flag, location=location.belowbar, color=color.new(color.teal, 0), size=size.tiny)
plotshape(bearishContinuation and isDoji[1], title="Bearish Continuation Flag", style=shape.flag, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)