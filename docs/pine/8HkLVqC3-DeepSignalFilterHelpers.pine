//@version=5

library("DeepSignalFilterHelpers")

// =================
// ==== Filters ====
// =================

// ==================================
// ======== Scalping Filters ========
// ==================================


export filter_price_action(simple int lookback=5, float minDistance=na, bool useFilter) =>
    localHigh = ta.highest(high, lookback)
    localLow = ta.lowest(low, lookback)
    avgDistance = ta.sma(math.abs(localHigh - localLow) / localLow * 100, lookback)
    threshold = na(minDistance) ? avgDistance : minDistance
    useFilter ? (close < localHigh and (close - localLow) / localLow * 100 > threshold) : true


export filter_momentum(simple int lookback=3, float momentumThreshold=na, bool useFilter) =>
    momentum = math.abs(high[lookback] - close) / high[lookback] * 100
    avgMomentum = ta.sma(momentum, lookback)
    threshold = na(momentumThreshold) ? avgMomentum : momentumThreshold
    useFilter ? momentum > threshold : true


export filter_candle_structure(simple float bodyThreshold=na, simple int lookback=5, bool useFilter) =>
    prevBody = math.abs(close[1] - open[1]) / (high[1] - low[1]) * 100
    avgBody = ta.sma(prevBody, lookback)
    threshold = na(bodyThreshold) ? avgBody : bodyThreshold
    useFilter ? (close[1] < open[1] and prevBody > threshold) : true


// ========================
// ==== VOLUME FILTERS ====
// ========================

export filter_intraday_intensity(bool useIiiFilter) =>
    iii = ((close - low) - (high - close)) / (high - low + 0.000001) * volume
    iiiCumulative = ta.cum(iii)
    iiiMA = ta.sma(iiiCumulative, 14)
    useIiiFilter ? iiiCumulative > iiiMA : true



export filter_vwma(series float src=close, int length=20, bool useVwmaFilter) =>
    vwma = ta.vwma(src, length)
    useVwmaFilter ? src > vwma : true



export filter_nvi(bool useNviFilter) =>
    nvi = 0.0
    nvi := nz(nvi[1]) + (volume < nz(volume[1]) ? ((close - nz(close[1])) / nz(close[1])) * nz(nvi[1]) : 0)
    nviMA = ta.sma(nvi, 100) 
    useNviFilter ? nvi > nviMA : true


export filter_emv(int length=14, float emvThreshold=0.0, bool useEmvFilter=true, bool useMovingAvg=false) =>
    distanceMoved = (high + low) / 2 - (high[1] + low[1]) / 2
    boxRatio = volume / 1000000 / (high - low + 0.000001) 
    emv = distanceMoved / boxRatio
    emvSMA = ta.sma(emv, length)
    emvThresholdSMA = ta.sma(emvSMA, length)
    useEmvFilter ? (useMovingAvg ? emvSMA > emvThresholdSMA : emvSMA > emvThreshold) : true



export filter_adi(int length=14, float threshold=0.0, bool useAdiFilter=true, bool useMovingAvg=false) =>
    adi = ta.cum(((close - low) - (high - close)) / (high - low + 0.000001) * volume)
    adiMA = ta.sma(adi, length)
    useAdiFilter ? (useMovingAvg ? adi > adiMA : adi > threshold) : true


export filter_mfi(int length=14, float mfiThreshold=50.0, bool useMfiFilter=true, bool useMovingAvg=false) =>
    typicalPrice = (high + low + close) / 3
    moneyFlow = typicalPrice * volume
    positiveFlow = math.sum(ta.change(typicalPrice) > 0 ? moneyFlow : 0, length)
    negativeFlow = math.sum(ta.change(typicalPrice) < 0 ? moneyFlow : 0, length)
    mfi = 100 - (100 / (1 + positiveFlow / negativeFlow))
    mfiMA = ta.sma(mfi, length)
    useMfiFilter ? (useMovingAvg ? mfi > mfiMA : mfi > mfiThreshold) : true


export detect_obv_states(float obvThresholdStrong=na, float obvThresholdModerate=na, int lookbackPeriod=14, string obvMode="Weak") =>
   
    obv = ta.cum(volume * (close > close[1] ? 1 : close < close[1] ? -1 : 0))

   
    avgObv = ta.sma(obv, lookbackPeriod)

   
    obvChangeSum = obv - obv[lookbackPeriod]

   
    thresholdStrong = na(obvThresholdStrong) ? avgObv * 1.5 : obvThresholdStrong
    thresholdModerate = na(obvThresholdModerate) ? avgObv * 1.2 : obvThresholdModerate
    thresholdWeak = avgObv 

   
    strongUp = obvChangeSum > thresholdStrong
    moderateUp = obvChangeSum > thresholdModerate and obvChangeSum <= thresholdStrong
    weakUp = obvChangeSum > 0 and obvChangeSum <= thresholdModerate
    strongDown = obvChangeSum < -thresholdStrong
    moderateDown = obvChangeSum < -thresholdModerate and obvChangeSum >= -thresholdStrong
    weakDown = obvChangeSum < 0 and obvChangeSum >= -thresholdModerate

   
    priceHigh = ta.highest(close, lookbackPeriod)
    priceLow = ta.lowest(close, lookbackPeriod)
    obvHigh = ta.highest(obv, lookbackPeriod)
    obvLow = ta.lowest(obv, lookbackPeriod)

    posDivergence = close < priceLow and obv > obvLow
    negDivergence = close > priceHigh and obv < obvHigh

   
    bbUpper = ta.sma(close, lookbackPeriod) + 2 * ta.stdev(close, lookbackPeriod)
    bbLower = ta.sma(close, lookbackPeriod) - 2 * ta.stdev(close, lookbackPeriod)
    bbWidth = (bbUpper - bbLower) / ta.sma(close, lookbackPeriod)
    isConsolidating = bbWidth < 0.05 and math.abs(obvChangeSum) < thresholdWeak

   
    var string state = ""
    state := obvMode == "Strong" and strongUp ? "Strong Up" : 
             obvMode == "Strong" and strongDown ? "Strong Down" : 
             obvMode == "Moderate" and (strongUp or moderateUp) ? (strongUp ? "Strong Up" : "Moderate Up") :
             obvMode == "Moderate" and (strongDown or moderateDown) ? (strongDown ? "Strong Down" : "Moderate Down") :
             obvMode == "Weak" and (strongUp or moderateUp or weakUp) ? (strongUp ? "Strong Up" : moderateUp ? "Moderate Up" : "Weak Up") :
             obvMode == "Weak" and (strongDown or moderateDown or weakDown) ? (strongDown ? "Strong Down" : moderateDown ? "Moderate Down" : "Weak Down") :
             posDivergence ? "Positive Divergence" : 
             negDivergence ? "Negative Divergence" : 
             isConsolidating ? "Consolidation" : "Unknown"

    state


export filter_obv(series float src=close, int length=14, string obvMode="Moderate", float threshold=na, bool useObvFilter=true, bool useMovingAvg=false) =>
   
    obvState = detect_obv_states(obvThresholdStrong=threshold, obvThresholdModerate=threshold * 0.8, lookbackPeriod=length, obvMode=obvMode)

   
    obv = ta.cum(ta.change(src) > 0 ? volume : ta.change(src) < 0 ? -volume : 0)
    obvMA = ta.sma(obv, length)

   
    isValidSignal = obvMode == "Strong" ? (obvState == "Strong Up" or obvState == "Strong Down") : obvMode == "Moderate" ? (obvState == "Strong Up" or obvState == "Moderate Up" or obvState == "Strong Down" or obvState == "Moderate Down") : obvMode == "Weak" ? (obvState == "Strong Up" or obvState == "Moderate Up" or obvState == "Weak Up" or obvState == "Strong Down" or obvState == "Moderate Down" or obvState == "Weak Down") : true

   
    useObvFilter ? (useMovingAvg ? obv > obvMA and isValidSignal : isValidSignal) : true



export filter_cmf(int length=20, float cmfThreshold=0.0, bool useCmfFilter=true, bool useMovingAvg=false) =>
    mfv = ((close - low) - (high - close)) / (high - low + 0.000001) * volume
    cmf = ta.sma(mfv, length) / ta.sma(volume, length)
    cmfMA = ta.sma(cmf, length)
    useCmfFilter ? (useMovingAvg ? cmf > cmfMA : cmf > cmfThreshold) : true



export filter_vwap(bool useVwapFilter) =>
    vwap = ta.vwap(close)
    useVwapFilter ? close > vwap : true


export filter_pvt(int length=14, float pvtThreshold=0.0, bool usePvtFilter=true, bool useMovingAvg=false) =>
    pvt = ta.cum(volume * (close - nz(close[1])) / nz(close[1]))
    pvtMA = ta.sma(pvt, length)
    usePvtFilter ? (useMovingAvg ? pvt > pvtMA : pvt > pvtThreshold) : true



export filter_vo(int shortLength=5, int longLength=14, float voThreshold=0.0, bool useVoFilter=true, bool useMovingAvg=false) =>
    shortMA = ta.sma(volume, shortLength)
    longMA = ta.sma(volume, longLength)
    vo = 100 * (shortMA - longMA) / longMA
    voMA = ta.sma(vo, longLength)
    useVoFilter ? (useMovingAvg ? vo > voMA : vo > voThreshold) : true



export filter_cho(int shortLength=3, int longLength=10, float choThreshold=0.0, bool useChoFilter=true, bool useMovingAvg=false) =>
    adi = ta.cum(((close - low) - (high - close)) / (high - low + 0.000001) * volume)
    shortMA = ta.ema(adi, shortLength)
    longMA = ta.ema(adi, longLength)
    cho = shortMA - longMA
    choMA = ta.ema(cho, longLength)
    useChoFilter ? (useMovingAvg ? cho > choMA : cho > choThreshold) : true



export filter_fi(int length=13, float fiThreshold=0.0, bool useFiFilter=true, bool useMovingAvg=false) =>
    fi = ta.ema(ta.change(close) * volume, length)
    fiMA = ta.ema(fi, length)
    useFiFilter ? (useMovingAvg ? fi > fiMA : fi > fiThreshold) : true

// ============================
// ==== VOLATILITY FILTERS ====
// ============================



export filter_garman_klass_volatility(int length=7, bool useGkFilter=true) =>
    logHighLow = math.log(high / low)
    logCloseOpen = math.log(close / open)
    sigmaSquared = 0.5 * logHighLow * logHighLow - (2 * math.log(2) - 1) * logCloseOpen * logCloseOpen
    gkVolatility = math.sqrt(ta.sma(sigmaSquared, length))
    avgGkVolatility = ta.sma(gkVolatility, length)
    useGkFilter ? gkVolatility > avgGkVolatility : true


export filter_frama(series float src=close, int length=10, bool useFramaFilter=true) =>
    halfLength = math.floor(length / 2)
    n1 = (ta.highest(high, halfLength) - ta.lowest(low, halfLength)) / halfLength
    n2 = (ta.highest(high[halfLength], halfLength) - ta.lowest(low[halfLength], halfLength)) / halfLength
    n3 = (ta.highest(high, length) - ta.lowest(low, length)) / length
    dimension = (math.log(n1 + n2) - math.log(n3)) / math.log(2)
    alpha = math.exp(-4.6 * (dimension - 1))
    frama = 0.0
    frama := alpha * src + (1 - alpha) * nz(frama[1])
    useFramaFilter ? src > frama : true


export filter_bollinger_bands(series float src=close, int length=14, float stdDev=2.0, bool useBollingerFilter=true) =>
    basis = ta.sma(src, length)
    dev = stdDev * ta.stdev(src, length)
    upper = basis + dev
    lower = basis - dev
    bandWidth = (upper - lower) / basis * 100
    avgBandWidth = ta.sma(bandWidth, length)
    useBollingerFilter ? bandWidth > avgBandWidth : true


export filter_keltner_channel(series float src=close, int length=14, float atrMult=1.5, bool useKeltnerFilter=true) =>
    ema = ta.ema(src, length)
    atr = ta.atr(length)
    upper = ema + atrMult * atr
    lower = ema - atrMult * atr
    channelWidth = (upper - lower) / ema * 100
    avgChannelWidth = ta.sma(channelWidth, length)
    useKeltnerFilter ? channelWidth > avgChannelWidth : true



export regime_filter(series float src=ohlc4, float threshold, bool useRegimeFilter) =>
    value1 = 0.0
    value2 = 0.0
    klmf = 0.0
    value1 := 0.2 * (src - src[1]) + 0.8 * nz(value1[1])
    value2 := 0.1 * (high - low) + 0.8 * nz(value2[1])
    omega = math.abs(value1 / value2)
    alpha = (-math.pow(omega, 2) + math.sqrt(math.pow(omega, 4) + 16 * math.pow(omega, 2))) / 8 
    klmf := alpha * src + (1 - alpha) * nz(klmf[1])
    absCurveSlope = math.abs(klmf - klmf[1])
    exponentialAverageAbsCurveSlope = 1.0 * ta.ema(absCurveSlope, 200)
    normalized_slope_decline = (absCurveSlope - exponentialAverageAbsCurveSlope) / exponentialAverageAbsCurveSlope
    useRegimeFilter ? normalized_slope_decline >= threshold : true



export regime_filter_v2(series float src=ohlc4, float threshold=0.0, int emaLength=50, bool useRegimeFilter=true) =>
    var float value1 = na
    var float value2 = na
    var float klmf = na
    value1 := 0.2 * (src - src[1]) + 0.8 * nz(value1)
    value2 := 0.1 * (high - low) + 0.8 * nz(value2)
    omega = math.abs(value1 / value2)
    alpha = (-math.pow(omega, 2) + math.sqrt(math.pow(omega, 4) + 16 * math.pow(omega, 2))) / 8
    klmf := alpha * src + (1 - alpha) * nz(klmf)
    absCurveSlope = math.abs(klmf - nz(klmf[1]))
    exponentialAverageAbsCurveSlope = ta.ema(absCurveSlope, emaLength)
    normalized_slope_decline = (absCurveSlope - exponentialAverageAbsCurveSlope) / exponentialAverageAbsCurveSlope
    useRegimeFilter ? normalized_slope_decline >= threshold : true


export filter_adx(series float src=close, int length=7, int adxThreshold=20, bool useAdxFilter=true) =>
    tr = math.max(math.max(high - low, math.abs(high - nz(src[1]))), math.abs(low - nz(src[1])))
    directionalMovementPlus = high - nz(high[1]) > nz(low[1]) - low ? math.max(high - nz(high[1]), 0) : 0
    negMovement = nz(low[1]) - low > high - nz(high[1]) ? math.max(nz(low[1]) - low, 0) : 0
    trSmooth = 0.0
    trSmooth := nz(trSmooth[1]) - nz(trSmooth[1]) / length + tr
    smoothDirectionalMovementPlus = 0.0
    smoothDirectionalMovementPlus := nz(smoothDirectionalMovementPlus[1]) - nz(smoothDirectionalMovementPlus[1]) / length + directionalMovementPlus
    smoothnegMovement = 0.0
    smoothnegMovement := nz(smoothnegMovement[1]) - nz(smoothnegMovement[1]) / length + negMovement
    diPositive = smoothDirectionalMovementPlus / trSmooth * 100
    diNegative = smoothnegMovement / trSmooth * 100
    dx = math.abs(diPositive - diNegative) / (diPositive + diNegative) * 100
    adx = ta.rma(dx, length)
    useAdxFilter ? adx > adxThreshold : true


export filter_volatility(simple int minLength=1, simple int maxLength=7, bool useVolatilityFilter=true) =>
    recentAtr = ta.atr(minLength)
    historicalAtr = ta.atr(maxLength)
    useVolatilityFilter ? recentAtr > historicalAtr : true


export filter_ulcer(series float src=close, int length=7, float ulcerThreshold=na, bool useUlcerFilter=true) =>
    maxClose = ta.highest(src, length)
    percentDrawdown = (src - maxClose) / maxClose * 100
    ulcerIndex = math.sqrt(ta.sma(math.pow(percentDrawdown, 2), length))
    avgUlcerIndex = ta.sma(ulcerIndex, length)
    threshold = na(ulcerThreshold) ? avgUlcerIndex : ulcerThreshold
    useUlcerFilter ? ulcerIndex < threshold : true


export filter_stddev(series float src=close, int length=7, float stdDevThreshold=na, bool useStdDevFilter=true) =>
    stdDev = ta.stdev(src, length)
    avgStdDev = ta.sma(stdDev, length)
    threshold = na(stdDevThreshold) ? avgStdDev : stdDevThreshold
    useStdDevFilter ? stdDev < threshold : true


export filter_macdv(series float src=close, simple int shortLength=6, simple int longLength=13, simple int signalSmoothing=5, float macdVThreshold=na, bool useMacdVFilter=true) =>
    [macdLine, signalLine, _] = ta.macd(src, shortLength, longLength, signalSmoothing)
    macdV = macdLine - signalLine
    avgMacdV = ta.sma(macdV, longLength)
    threshold = na(macdVThreshold) ? avgMacdV : macdVThreshold
    useMacdVFilter ? math.abs(macdV) < threshold : true


export filter_atr(simple int length=7, float atrThreshold=na, bool useAtrFilter=true) =>
    atr = ta.atr(length)
    avgAtr = ta.sma(atr, length)
    threshold = na(atrThreshold) ? avgAtr : atrThreshold
    useAtrFilter ? atr < threshold : true


export filter_candle_body_and_atr(simple int length=7, float bodyThreshold=1.5, float atrThreshold=na, bool useFilter=true) =>
    atr = ta.atr(length)
    avgAtr = ta.sma(atr, length)
    thresholdAtr = na(atrThreshold) ? avgAtr : atrThreshold
    candleBody = math.abs(close - open)
    bodyStrength = candleBody / atr
    validBody = bodyStrength < bodyThreshold
    validAtr = atr < thresholdAtr
    useFilter ? (validBody and validAtr) : true


export filter_atrp(simple int length=7, float atrpThreshold=na, bool useAtrpFilter=true) =>
    atr = ta.atr(length)
    atrp = (atr / close) * 100
    avgAtrp = ta.sma(atrp, length)
    threshold = na(atrpThreshold) ? avgAtrp : atrpThreshold
    useAtrpFilter ? atrp < threshold : true


// ==========================
// ==== MOMENTUM FILTERS ====
// ==========================

export filter_jma(series float src=close, int length=5, float phase=0.0, bool useJmaFilter=true) =>
    e0 = src
    e1 = ta.ema(e0, length)
    e2 = ta.ema(e1, length)
    e3 = ta.ema(e2, length)
    e4 = ta.ema(e3, length)
    e5 = ta.ema(e4, length)
    slope = (e5 - e4) * phase
    jma = e5 + slope
    useJmaFilter ? src > jma : true


export filter_cidi(series float src=close, int rsiLength=7, int shortMaLength=3, int longMaLength=7, bool useCidiFilter=true) =>
    rsiValue = ta.rsi(src, rsiLength)
    shortMa = ta.sma(rsiValue, shortMaLength)
    longMa = ta.sma(rsiValue, longMaLength)
    cidi = shortMa + longMa
    cidiMa = ta.sma(cidi, longMaLength)
    useCidiFilter ? cidi > cidiMa : true


export filter_rsi(series float src=close, int length=7, float rsiThreshold=50, bool useRsiFilter=true) =>
    rsi = ta.rsi(src, length)
    useRsiFilter ? rsi > rsiThreshold : true


export filter_ichimoku_oscillator(int length=9, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    conversionLine = (ta.highest(high, length) + ta.lowest(low, length)) / 2
    baseLine = (ta.highest(high, length * 2) + ta.lowest(low, length * 2)) / 2
    ichimokuOscillator = conversionLine - baseLine
    avgIchimokuOscillator = ta.sma(ichimokuOscillator, length)
    _threshold := na(threshold) ? avgIchimokuOscillator : threshold
    useFilter ? ichimokuOscillator > _threshold : true


export filter_cmb_composite_index(series float src=close, int shortLength=3, int longLength=7, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    shortCMB = ta.ema(src, shortLength)
    longCMB = ta.ema(src, longLength)
    cmbCompositeIndex = shortCMB - longCMB
    avgCMBCompositeIndex = ta.sma(cmbCompositeIndex, longLength)
    _threshold := na(threshold) ? avgCMBCompositeIndex : threshold
    useFilter ? cmbCompositeIndex > _threshold : true


export filter_connors_rsi(series float src=close, int rsiLength=3, int rocLength=2, int streakLength=20, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    rsi = ta.rsi(src, rsiLength)
    roc = ta.roc(src, rocLength)
    streak = ta.rsi(roc, streakLength)
    connorsRsi = (rsi + roc + streak) / 3
    avgConnorsRsi = ta.sma(connorsRsi, rsiLength)
    _threshold := na(threshold) ? avgConnorsRsi : threshold
    useFilter ? connorsRsi > _threshold : true


export filter_coppock_curve(series float src=close, int roc1Length=5, int roc2Length=7, int wmaLength=5, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    roc1 = ta.roc(src, roc1Length)
    roc2 = ta.roc(src, roc2Length)
    coppockCurve = ta.wma(roc1 + roc2, wmaLength)
    avgCoppockCurve = ta.sma(coppockCurve, wmaLength)
    _threshold := na(threshold) ? avgCoppockCurve : threshold
    useFilter ? coppockCurve > _threshold : true


export filter_pmo(series float src=close, int pmoLength=20, int smoothingLength=10, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    pmo = ta.ema(ta.roc(src, 1), pmoLength)
    pmoSignal = ta.ema(pmo, smoothingLength)
    pmoOscillator = pmo - pmoSignal
    avgPMOOscillator = ta.sma(pmoOscillator, pmoLength)
    _threshold := na(threshold) ? avgPMOOscillator : threshold
    useFilter ? pmoOscillator > _threshold : true


export filter_macd(series float src=close, int shortLength=6, int longLength=13, int signalSmoothing=5, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    [macdLine, signalLine, _] = ta.macd(src, shortLength, longLength, signalSmoothing)
    macd = macdLine - signalLine
    avgMACD = ta.sma(macd, shortLength)
    _threshold := na(threshold) ? avgMACD : threshold
    useFilter ? macd > _threshold : true


export filter_macd_histogram(series float src=close, simple int shortLength=6, simple int longLength=13, simple int signalSmoothing=5, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    [macdLine, signalLine, histogram] = ta.macd(src, shortLength, longLength, signalSmoothing)
    avgMACDHistogram = ta.sma(histogram, shortLength)
    _threshold := na(threshold) ? avgMACDHistogram : threshold
    useFilter ? histogram > _threshold : true


export filter_kst(series float src=close, int r1=5, int r2=7, int r3=10, int r4=15, int sm1=3, int sm2=3, int sm3=3, int sm4=5, int signalLength=5, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    roc1 = ta.roc(src, r1)
    roc2 = ta.roc(src, r2)
    roc3 = ta.roc(src, r3)
    roc4 = ta.roc(src, r4)
    kst = ta.sma(roc1, sm1) + 2 * ta.sma(roc2, sm2) + 3 * ta.sma(roc3, sm3) + 4 * ta.sma(roc4, sm4)
    kstSignal = ta.sma(kst, signalLength)
    kstOscillator = kst - kstSignal
    avgKstOscillator = ta.sma(kstOscillator, signalLength)
    _threshold := na(threshold) ? avgKstOscillator : threshold
    useFilter ? kstOscillator > _threshold : true


export filter_special_k(series float src=close, int r1=5, int r2=7, int r3=10, int r4=15, int sm1=3, int sm2=3, int sm3=3, int sm4=5, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    roc1 = ta.roc(src, r1)
    roc2 = ta.roc(src, r2)
    roc3 = ta.roc(src, r3)
    roc4 = ta.roc(src, r4)
    specialK = ta.sma(roc1, sm1) + 2 * ta.sma(roc2, sm2) + 3 * ta.sma(roc3, sm3) + 4 * ta.sma(roc4, sm4)
    avgSpecialK = ta.sma(specialK, sm1)
    _threshold := na(threshold) ? avgSpecialK : threshold
    useFilter ? specialK > _threshold : true


export filter_roc_momentum(series float src=close, int rocLength=5, int momentumLength=5, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    roc = ta.roc(src, rocLength)
    momentum = ta.mom(src, momentumLength)
    rocMomentum = roc + momentum
    avgROCMomentum = ta.sma(rocMomentum, rocLength)
    _threshold := na(threshold) ? avgROCMomentum : threshold
    useFilter ? rocMomentum > _threshold : true


export filter_rrg_relative_strength(series float src=close, int length=7, float threshold=na, bool useFilter=true) =>
    var float _threshold = na
    relativeStrength = ta.roc(src, length)
    avgRelativeStrength = ta.sma(relativeStrength, length)
    _threshold := na(threshold) ? avgRelativeStrength : threshold
    useFilter ? relativeStrength > _threshold : true

// ==========================
// == COMBINATION FILTERS ===
// ==========================


export filter_alligator(series float src=close, int jawLength=13, int teethLength=8, int lipsLength=5, int jawOffset=8, int teethOffset=5, int lipsOffset=3, bool useFilter=true) =>
    jaw = ta.sma(src, jawLength)[jawOffset]
    teeth = ta.sma(src, teethLength)[teethOffset]
    lips = ta.sma(src, lipsLength)[lipsOffset]
    trendUp = lips > teeth and teeth > jaw
    trendDown = lips < teeth and teeth < jaw
    useFilter ? (trendUp or trendDown) : true



export filter_wyckoff(series float src=close, int length=20, int volumeLength=20, bool useFilter=true) =>
    accumulation = ta.lowest(low, length) == low and volume < ta.sma(volume, volumeLength)
    markup = src > ta.highest(src[1], length) and volume > ta.sma(volume, volumeLength)
    distribution = ta.highest(high, length) == high and volume > ta.sma(volume, volumeLength)
    markdown = src < ta.lowest(src[1], length) and volume > ta.sma(volume, volumeLength)
    useFilter ? (accumulation or markup or distribution or markdown) : true

// ==========================
// ==== RANGE FILTERS =======

// ==========================
export filter_squeeze_momentum(int bbLength=14, float bbStdDev=2.0, int kcLength=14, float kcMult=1.5, bool useFilter=true) =>
    
    bbMid = ta.sma(close, bbLength)
    bbUpper = bbMid + bbStdDev * ta.stdev(close, bbLength)
    bbLower = bbMid - bbStdDev * ta.stdev(close, bbLength)
    
    ema = ta.ema(close, kcLength)
    atr = ta.atr(kcLength)
    kcUpper = ema + kcMult * atr
    kcLower = ema - kcMult * atr
    
    squeezeOn = bbLower > kcLower and bbUpper < kcUpper
    squeezeOff = bbLower < kcLower or bbUpper > kcUpper
    
    momentum = ta.mom(close, 12)
    
    useFilter ? not squeezeOn : true  


export filter_atr_compression(int length=7, float atrThreshold=na, bool useFilter=true) =>
    atr = ta.atr(length)
    avgAtr = ta.sma(atr, length)
    threshold = na(atrThreshold) ? avgAtr * 0.5 : atrThreshold
    useFilter ? atr > threshold : true


export filter_low_volume(int length=14, bool useFilter=true) =>
    avgVolume = ta.sma(volume, length)
    useFilter ? volume > avgVolume : true


export filter_nvi_accumulation(bool useFilter=true) =>
    nvi = ta.cum(volume < volume[1] ? ((close - close[1]) / close[1]) * 100 : 0)
    nviMA = ta.ema(nvi, 100)
    useFilter ? nvi > nviMA : true


export filter_ma_slope(series float src=close, int length=20, float slopeThreshold=0.005, bool useFilter=true) =>
    ma = ta.sma(src, length)
    slope = (ma - ma[1]) / ma[1]
    useFilter ? math.abs(slope) > slopeThreshold : true


export filter_adx_low(int len=7, int lensig=5, int adxThreshold=15, bool useFilter=true) =>
    [diplus, diminus, adx] = ta.dmi(len, lensig)
    useFilter ? adx > adxThreshold : true


export filter_choppiness_index(int length=14, float chopThreshold=50.0, bool useFilter=true) =>
    atrSum = math.sum(ta.tr(true), length)
    maxHigh = ta.highest(high, length)
    minLow = ta.lowest(low, length)
    chop = 100 * math.log10(atrSum / (maxHigh - minLow)) / math.log10(length)
    useFilter ? chop < chopThreshold : true


export filter_range_detection(int length=14, bool useFilter=true) =>
    highestHigh = ta.highest(high, length)
    lowestLow = ta.lowest(low, length)
    _range = highestHigh - lowestLow
    pricePosition = (close - lowestLow) / _range
    useFilter ? (pricePosition < 0.8 and pricePosition > 0.2) : true
