library("zuperview")


// ============================================================================
// TYPE DEFINITIONS
// ============================================================================
// Description:
//   This group contains custom data types (structs) used to organize and store data
//   in a structured way. These types act as templates for objects manipulated by
//   the library's functions.
// Purpose:
//   - Provide a consistent structure for complex data (e.g., candles, points).
//   - Enable functions to work with bundled data instead of individual variables.
// Usage:
//   - Used as parameters or return types in helper and exported functions.
//   - Instantiated using the '.new()' method within the library or calling scripts.
// Notes:
//   - Fields are immutable in structure but mutable in value after instantiation.
//   - Types do not include methods; logic is handled by separate functions.
export type SwingPoint
    int Key
    bool IsTop
    float Price
    int BarStart
    int BarEnd
    int TimeStart
    int TimeEnd
    int Sign
    label Label


type ValueData
    float MinValue = -1
    float MaxValue = -1


// ============================================================================
// ADVANCED LOGIC FUNCTIONS
// ============================================================================
// Description:
//   This group contains functions designed to perform advanced logical
//   computations and data processing within the script. These functions help
//   encapsulate complex logic, making the main script cleaner and more readable.
// Purpose:
//   - Provide reusable logic operations for decision-making and signal processing.
//   - Reduce redundancy by centralizing commonly used calculations.
//   - Improve script maintainability by isolating logic from visualization.
// Usage:
//   - Called within main indicator or strategy scripts to process market data.
//   - Used to evaluate conditions, filter signals, or transform data dynamically.
// Notes:
//   - Functions are stateless; they rely on input arguments without modifying global state.
//   - Designed for efficiency, minimizing unnecessary calculations to improve performance.
//   - Some functions may return `na` when input conditions are not met.
z_array_swing_constaint_key(array<SwingPoint> arraySwings, int key) =>
    bool rs = false
    if ((not na(arraySwings)))
        int index = array.size(arraySwings) - 1
        if (index >= 0)
            lastItem = array.get(arraySwings, index)
            if (lastItem.Key == key)
                rs := true
    rs


// ============================================================================
// HELPER FUNCTIONS
// ============================================================================
// Description:
//   This group contains internal utility functions that support exported functions.
//   These functions are not directly accessible outside the library and are designed
//   to handle common, reusable tasks such as calculations, validations, or data
//   transformations.
// Purpose:
//   - Reduce code duplication in exported functions.
//   - Encapsulate low-level logic for better readability and maintainability.
// Usage:
//   - Called internally by exported functions within this library.
//   - Not exported, so they remain private to this library's scope.
// Notes:
//   - These functions assume valid input data from calling exported functions.
//   - They do not interact with chart elements (e.g., drawing objects) directly.
z_sma(seriesInput, period) =>
    var float rs = 0.0
    if (bar_index == 0)
        rs := seriesInput
    else
        float last = rs[1] * math.min(bar_index, period)


        if (bar_index >= period)
            rs := (last + seriesInput[0] - seriesInput[period]) / math.min(bar_index, period)
        else
            rs := (last + seriesInput[0]) / (math.min(bar_index, period) + 1)


z_smoothATRSeries(seriesInput, seriesOutput, period) =>
    if (bar_index == 0)
        seriesInput
    else
        float factor = (bar_index < period - 1 ? (bar_index + 1) / float(period) : math.max(1, float(period) / 10))
        float coefficient = 1.0 / (factor * float(period))


        (1 - coefficient) * seriesOutput + coefficient * seriesInput


z_sum(src, period) =>
    var sum = 0.0
    if (bar_index < period)
        sum := sum + src
    else
        sum := (sum - src[period]  + src)
    sum


z_max(src, period) =>
    var float runningMax = 0
    var float lastMax = 0
    var float runningBar = 0
    var float lastBar = 0
    var float thisBar = 0
    var float result = 0


    if (bar_index == 0)
        runningMax  := src
        lastMax     := src
        runningBar  := 0
        lastBar     := 0
        thisBar     := 0
        result  := src
    else
        if (bar_index - runningBar >= period or bar_index < thisBar)
            runningMax := -1e38
            for i = 1 to math.min(bar_index, period - 1)
                if (src[i] >= runningMax)
                    runningMax := src[i]
                    runningBar := bar_index - i


        if (thisBar != bar_index)
            lastMax := runningMax
            lastBar := runningBar
            thisBar := bar_index


        if (src[0] >= lastMax)
            runningMax := src[0]
            runningBar := bar_index
        else
            runningMax := lastMax
            runningBar := lastBar
        result := runningMax


z_min(src, period) =>
    var float runningMin = 0
    var float lastMin = 0
    var float runningBar = 0
    var float lastBar = 0
    var float thisBar = 0
    var float result = 0


    if (bar_index == 0)
        runningMin  := src
        lastMin     := src
        runningBar  := 0
        lastBar     := 0
        thisBar     := 0
        result  := src
    else
        if (((bar_index - runningBar) >= period) or (bar_index < thisBar))
            runningMin := 1e38
            for i = 1 to math.min(bar_index, period - 1)
                if (src[i] <= runningMin)
                    runningMin := src[i]
                    runningBar := bar_index - i


        if (thisBar != bar_index)
            lastMin := runningMin
            lastBar := runningBar
            thisBar := bar_index


        if (src <= lastMin)
            runningMin := src[0]
            runningBar := bar_index
        else
            runningMin := lastMin
            runningBar := lastBar
        result := runningMin


z_add(ValueData valueData, float price) =>
    if (price > 0)
        if ((valueData.MinValue < 0) or (valueData.MaxValue < 0))
            valueData.MinValue := price
            valueData.MaxValue := price
        else
            valueData.MinValue := math.min(valueData.MinValue, price)
            valueData.MaxValue := math.max(valueData.MaxValue, price)


z_get_high_low(isCheckingTop, barIndex) =>
    int index = bar_index - barIndex  


    isCheckingTop ? high[index] : low[index]


z_find_swing_point_1(isCheckingTop, neighborhood) =>
    if (bar_index >= (2 * neighborhood))
        bool isFinding = true


        SwingPoint swingPoint = na


        int swingBarStart = bar_index - neighborhood
        int swingBarEnd = bar_index - neighborhood
        int sign = isCheckingTop ? 1 : -1


        swingPrice = z_get_high_low(isCheckingTop, swingBarEnd)


        for barIndex = (bar_index - 2 * neighborhood) to bar_index
            if (barIndex == swingBarEnd)
                continue


            float seriesPrice = z_get_high_low(isCheckingTop, barIndex)
            int result = (seriesPrice == swingPrice) ? 0 : ((seriesPrice > swingPrice) ? 1 : -1)


            if (sign * result >= 0)
                isFinding := false
                break


        if (isFinding)
            SwingPoint.new(0, isCheckingTop, swingPrice, swingBarStart - 3, swingBarStart, time[bar_index - swingBarStart], time[bar_index - swingBarStart], sign)


z_find_swing_point_2(isCheckingTop, neighborhood) =>
    if (bar_index >= (3 * neighborhood))
        bool isFinding = true
        int swingBarEnd = bar_index - neighborhood
        int swingBarStart = swingBarEnd - neighborhood
        int sign = isCheckingTop ? 1 : -1
        int count = 1


        float swingPrice = z_get_high_low(isCheckingTop, swingBarEnd)


        for barIndex = swingBarStart to (swingBarEnd - 1) // count equal price bar
            float seriesPrice = z_get_high_low(isCheckingTop, barIndex)
            if (seriesPrice != swingPrice)
                break


            count := count + 1


        if (count < 2)
            isFinding := false


        if (isFinding)
            // confirm that are top or bottom
            swingBarStart := (swingBarEnd - count + 1)


            for barIndex = (swingBarStart - neighborhood) to bar_index
                if ((barIndex >= swingBarStart) and (barIndex <= swingBarEnd))
                    continue


                float seriesPrice = z_get_high_low(isCheckingTop, barIndex)
                int result = (seriesPrice == swingPrice) ? 0 : ((seriesPrice > swingPrice) ? 1 : -1)


                if ((sign * result) >= 0)
                    isFinding := false
                    break


        if (isFinding)
            SwingPoint.new(0, isCheckingTop, swingPrice, swingBarStart, swingBarEnd, time[bar_index - swingBarStart], time[bar_index - swingBarEnd], sign)


z_find_swing_point_3(isCheckingTop, neighborhood) =>
    if (bar_index >= 3 * neighborhood)
        ValueData listConsider = ValueData.new(-1, -1)
        ValueData listNeighborhoodLeft = ValueData.new(-1, -1)
        ValueData listNeighborhoodRight = ValueData.new(-1, -1)


        bool isFinding = true
        int swingBarEnd = bar_index - neighborhood
        int swingBarStart = swingBarEnd - neighborhood
        int sign = isCheckingTop ? 1 : -1
        int count = 1


        float swingPrice = z_get_high_low(isCheckingTop, swingBarEnd)
        int savedBarIndex = 0


        for barIndex = (swingBarEnd - 1) to swingBarStart
            float seriesPrice = z_get_high_low(isCheckingTop, barIndex)
            int result = (seriesPrice == swingPrice) ? 0 : ((seriesPrice > swingPrice) ? 1 : -1)


            if (sign * result > 0)
                isFinding := false
                break


            if (result == 0)
                savedBarIndex := barIndex
                count := count + 1


        if (count < 2)
            isFinding := false
       
        if (isFinding)
            swingBarStart := savedBarIndex


            for barIndex = (swingBarStart - neighborhood) to bar_index
                float seriesPrice = z_get_high_low(isCheckingTop, barIndex)


                if ((barIndex >= swingBarStart) and (barIndex <= swingBarEnd))
                    z_add(listConsider, seriesPrice)
                    continue
               
                int result = (seriesPrice == swingPrice) ? 0 : ((seriesPrice > swingPrice) ? 1 : -1)
                if (sign * result >= 0)
                    isFinding := false
                    break


                if (barIndex < swingBarStart)
                    z_add(listNeighborhoodLeft, seriesPrice)
                else
                    z_add(listNeighborhoodRight, seriesPrice)


            if (listConsider.MaxValue == listConsider.MinValue)
                isFinding := false
           
            if (isFinding)
                float extremeNeighborhood = isCheckingTop ? math.max(listNeighborhoodLeft.MinValue, listNeighborhoodRight.MinValue) : math.min(listNeighborhoodLeft.MaxValue, listNeighborhoodRight.MaxValue)
                float extremeConsider = isCheckingTop ? listConsider.MinValue : listConsider.MaxValue


                int comparison = (extremeConsider == extremeNeighborhood) ? 0 : (extremeConsider > extremeNeighborhood ? 1 : -1)


                if (sign * comparison <= 0)
                    isFinding := false
       
        if (isFinding)
            SwingPoint.new(0, isCheckingTop, swingPrice, swingBarStart, swingBarEnd, time[bar_index - swingBarStart], time[bar_index - swingBarEnd], sign)


z_find_swing_point_raw(isCheckingTop, neighborhood) =>
    bool isFinding = true
    SwingPoint swingPoint = z_find_swing_point_1(isCheckingTop, neighborhood)


    if (not na(swingPoint))
        isFinding := false
   
    if (isFinding)
        swingPoint := z_find_swing_point_2(isCheckingTop, neighborhood)
        if (not na(swingPoint))
            isFinding := false


        if (isFinding)
            swingPoint := z_find_swing_point_3(isCheckingTop, neighborhood)


    swingPoint


z_add_label_for_swing_point(SwingPoint swingPoint) =>
    color = swingPoint.IsTop ? color.new(color.purple, 50): color.new(color.blue, 50)
    stringPoint = swingPoint.IsTop ? "🔴" : "🔵"
    float priceY = swingPoint.IsTop ? high[bar_index - swingPoint.BarEnd] : low[bar_index - swingPoint.BarEnd] - 6
    swingLabel = label.new(x = swingPoint.BarEnd, y = priceY, text = stringPoint, color = color.new(color.purple, 100), textcolor = color, size = size.small)
    swingPoint.Label := swingLabel


z_find_swing_point(isCheckingTop, swingArray, neighborhood) =>
    int key = (bar_index - neighborhood)
    SwingPoint swingPoint = z_find_swing_point_raw(isCheckingTop, neighborhood)
    if (not na(swingPoint))
        z_add_label_for_swing_point(swingPoint)


        if (not z_array_swing_constaint_key(swingArray, key))
            array.push(swingArray, swingPoint)
    else
        if ((z_array_swing_constaint_key(swingArray, key)) and (array.size(swingArray) > 0))
            array.pop(swingArray)
    swingPoint


z_update_candidate_swing_point(arraySwings, swingPoint) =>
    if (array.size(arraySwings) > 0)
        bool isTop = swingPoint.IsTop
        lastSwingPoint = array.pop(arraySwings)
        label.delete(lastSwingPoint.Label)
        array.push(arraySwings, swingPoint)


// ============================================================================
// EXPORTED FUNCTIONS
// ============================================================================
// Description:
//   This group contains functions that are exposed for external use by indicators,
//   strategies, or other libraries. These functions serve as the public interface
//   of the library, providing high-level utilities for chart analysis and visualization.
// Purpose:
//   - Offer reusable tools for common tasks like trend detection, shape creation,
//     or data manipulation.
//   - Leverage internal helper functions and types to deliver complex functionality
//     in a simple, user-friendly way.
// Usage:
//   - Import this library into your script using: import "ninZa"
//   - Call these functions directly, e.g., ChartUtils.detectTrend() or
//     ChartUtils.createCircle(bar_index, close).
// Notes:
//   - These functions return values (e.g., bool, float, polyline) that can be used
//     for further processing or visualization in the calling script.
//   - They do not draw objects directly (e.g., no plotshape or box.new); drawing
//     must be handled in the calling indicator/strategy.
//   - Ensure input parameters are valid (not 'na') to avoid unexpected results.


// @function ComputeMAValue
// @description Computes the moving average (MA) value based on the specified MA type.
// @param maType (string) The type of moving average: "EMA", "SMA", "RMA", "WMA", "HMA", "VWMA", "LinReg".
// @param series (float) The input price series (typically close).
// @param period (int) The number of periods used for MA calculation.
// @returns (float) The computed MA value or `na` if maType is invalid.
export ComputeMAValue(string maType, float series, int period) =>
    emaValue = ta.ema(series, period)
    smaValue = ta.sma(series, period)
    rmaValue = ta.rma(series, period)
    wmaValue = ta.wma(series, period)
    hmaValue = ta.hma(series, period)
    vwmaValue = ta.vwma(series, period)
    linregValue = ta.linreg(series, period, 1)


    switch maType
        "EMA"    => emaValue
        "SMA"    => smaValue
        "RMA"    => rmaValue
        "WMA"    => wmaValue
        "HMA"    => hmaValue
        "VWMA"   => vwmaValue
        "LinReg" => linregValue
        => na // Returns `na` instead of throwing an error to prevent script interruption.


// @function ComputeATRValue
// @description Computes the moving average (ATR) value based on the specified ATR type.
// @param period (int) The number of periods used for MA calculation.
// @returns (float) The computed ATR value or `na` if maType is  invalid.
export ComputeATRValue(int period) =>
    float hiloATR = na
    float smoothedATRLayer2 = na
    barRange = high - low
   
    if (bar_index == 0)
        hiloATR := barRange
    else
        hiloATR := ((math.min(bar_index + 1, period) - 1) * hiloATR[1] + barRange) / math.min(bar_index + 1, period)
    smoothedATRLayer1 = z_sma(hiloATR, period)
    smoothedATRLayer2 := z_smoothATRSeries(smoothedATRLayer1, smoothedATRLayer2[1], period)


export Max(float src, int period) =>
    float max = z_max(src, period)


export Min(float src, int period) =>
    float min = z_min(src, period)


// @function ComputeRSIValue
// @description Computes the moving average (RSI) value based on the specified RSI type.
// @param src (series) Input series (series float), which can be close (`close`), open (`open`), high (`high`), low (`low`), or any other price-based series.
// @param period (int) The number of periods used for MA calculation.
// @returns (float) The computed RSI value or `na` if maType is  invalid.
export ComputeRSIValue(float src, int period, int smooth) =>
    var constant1 = 2.0 / (1 + smooth)
    var constant2 = (1 - (2.0 / (1 + smooth)))
    var constant3 = (period - 1)
   
    var float down = na
    var float up = na
    var float RSI = na
    var float Avg = na
    var float avgUp = na
    var float avgDown = na
    var float smaDown = na
    var float smaUp = na


    smaDown := ta.sma(down, period - 1)
    smaUp := ta.sma(up, period - 1)


    if (bar_index == 0)
        down := 0
        up := 0
        RSI := 50
        Avg := 50
    else  
        down := math.max(src[1] - src[0], 0)
        up := math.max(src[0] - src[1], 0)
   
        if ((bar_index + 1) < period)
            RSI := 50
            Avg := 50
        else
            if ((bar_index + 1) == period)
                avgDown := smaDown
                avgUp := smaUp
            else
                avgDown := (avgDown[1] * constant3 + down[0]) / period
                avgUp := (avgUp[1] * constant3 + up[0]) / period


                avgDown0 = avgDown[0]
                value0 = (avgDown0 == 0) ? 100 : (100 - 100 / (1 + avgUp[0] / avgDown0))
                RSI := value0
                Avg := constant1 * value0 + constant2 * Avg[1]
    [RSI, Avg]


// @function ComputeSMMAValue
// @description Computes the moving average (SMMA) value based on the specified SMMA type.
// @param src (series) Input series (series float), which can be close (`close`), open (`open`), high (`high`), low (`low`), or any other price-based series.
// @param period (int) The number of periods used for MA calculation.
// @returns (float) The computed SMMA value or `na` if maType is  invalid.
export ComputeSMMAValue(float src, int period) =>
    var float smma1 = 0
    var float sum1 = 0
    var float prevsum1 = 0
    var float prevsmma1 = 0
    var float result = na


    if (bar_index <= period)
        sum1 := z_sum(src, period)
        smma1 := sum1 / period
        result := src
    else if (bar_index > period)
        if (barstate.isnew)
            prevsum1 := sum1
            prevsmma1 := smma1
        result := (prevsum1 - prevsmma1 + src) / period
        sum1 := prevsum1 - prevsmma1 + src
        smma1 := (sum1 - prevsmma1 + src) / period
    result


// @function ComputeStochasticValue
// @description Computes the moving average (SMMA) value based on the specified SMMA type.
// @param src (series) Input series (series float), which can be close (`close`), open (`open`), high (`high`), low (`low`), or any other price-based series.
// @param periodD (int) The number of periods used for MA calculation.
// @param periodK (int) The number of periods used for MA calculation.
// @param smoothingMethod (string) The type of moving average: "EMA", "SMA", "RMA", "WMA", "HMA", "VWMA", "LinReg".
// @param smoothingPeriod (int) The number of periods used for MA calculation.
// @returns (float) The computed Stochastic(K, D) value or `na` if maType is  invalid.
export ComputeStochasticValue(float src, int periodD, int periodK, string smoothingMethod, int smoothingPeriod) =>
    float lowestLow = z_min(low, periodK)
    float highestHigh = z_max(high, periodK)
    float denominator = highestHigh - lowestLow
    var float rawPercentK = na


    if (denominator == 0)
        rawPercentK := (bar_index == 0) ? 50 : rawPercentK[1]
    else
        rawPercentK := 100 * ((src[0] - lowestLow) / denominator)


    K = ComputeMAValue(smoothingMethod, rawPercentK, smoothingPeriod)
    D = ComputeMAValue(smoothingMethod, K, periodD)
    [K, D]


// @function Find Swings By Neighborhood
// @description Computes the moving average (SMMA) value based on the specified SMMA type.
// @param arraySwingTop (array<SwingPoint>): An array to store detected swing highs.
// @param arraySwingBottom (array<SwingPoint>): An array to store detected swing lows.
// @param neighborhood (int): The number of bars to consider when identifying a swing point.
// @returns none
export FindSwingsByNeighborhood(array<SwingPoint> arraySwingTop, array<SwingPoint> arraySwingBottom, int neighborhood) =>
    SwingPoint result = na
    result := z_find_swing_point(true, arraySwingTop, neighborhood)
    result := z_find_swing_point(false, arraySwingBottom, neighborhood)


    result


// @function Find Swings By Offset
// @description Identifies swing points based on a minimum swing length criteria.
// @param arraySwingTop (array<SwingPoint>): An array to store detected swing highs.
// @param arraySwingBottom (array<SwingPoint>): An array to store detected swing lows.
// @param minSwingLength (float): The minimum price movement required to qualify as a swing point.
// @returns none
export FindSwingsByOffset(array<SwingPoint> arraySwingTop, array<SwingPoint> arraySwingBottom, float minSwingLength) =>
    SwingPoint swingPoint = na
    var int searchingFor = 0 // 0 = find very first candidate, -1 = find bottom, 1 = find top
    var float candidateTopPrice = 0
    var float candidateBottomPrice = 0
    var int candidateTopBar = 0
    var int candidateBottomBar = 0
    var float firstSwingThresholdBottom = 0
    var float firstSwingThresholdTop = 0
    var float swingThreshold = 0
    int key = bar_index
   
    if (bar_index == 0)
        candidateBottomPrice := low
        candidateTopPrice := high
        candidateBottomBar := 0
        candidateTopBar := 0


        firstSwingThresholdBottom := candidateTopPrice - minSwingLength
        firstSwingThresholdTop := candidateBottomPrice + minSwingLength
    else
        if (searchingFor == 0)
            if (high > candidateTopPrice)
                candidateTopPrice := high
                candidateTopBar := bar_index


                firstSwingThresholdBottom := math.max(firstSwingThresholdBottom, candidateTopPrice - minSwingLength)


                if (candidateTopPrice >= firstSwingThresholdTop)
                    SwingPoint tempSwingPoint = SwingPoint.new(key, true, high, 0, bar_index)
                    z_add_label_for_swing_point(tempSwingPoint)


                    if (not z_array_swing_constaint_key(arraySwingTop, key))
                        array.push(arraySwingTop, tempSwingPoint)


                    searchingFor := 1
                    swingThreshold := candidateTopPrice - minSwingLength
            else if (low < candidateBottomPrice)
                candidateBottomPrice := low
                candidateBottomBar := bar_index


                firstSwingThresholdTop := math.min(firstSwingThresholdTop, candidateBottomPrice + minSwingLength)


                if (candidateBottomPrice <= firstSwingThresholdBottom)
                    SwingPoint tempSwingPoint = SwingPoint.new(key, false, low, 0, bar_index)
                    z_add_label_for_swing_point(tempSwingPoint)


                    if (not z_array_swing_constaint_key(arraySwingBottom, key))
                        array.push(arraySwingBottom, tempSwingPoint)
                   
                    searchingFor := -1
                    swingThreshold := candidateBottomPrice + minSwingLength
        else if (searchingFor > 0)
            bool isNewHigh = false
           
            if (high > candidateTopPrice)
                isNewHigh := true


                candidateTopPrice := high
                candidateTopBar := bar_index


                // update NEW top swing point to top swings dictionary
                SwingPoint tempSwingPoint = SwingPoint.new(key, true, high, 0, bar_index)
                z_add_label_for_swing_point(tempSwingPoint)


                z_update_candidate_swing_point(arraySwingTop, tempSwingPoint)


                swingThreshold := math.max(swingThreshold, candidateTopPrice - minSwingLength)
           
            if (not isNewHigh)
                if ((low <= swingThreshold) and (bar_index > candidateTopBar))
                    candidateBottomPrice := low
                    candidateBottomBar := bar_index


                    swingPoint := SwingPoint.new(key, false, low, 0, bar_index)
                    z_add_label_for_swing_point(swingPoint)


                    if (not z_array_swing_constaint_key(arraySwingBottom, key))
                        array.push(arraySwingBottom, swingPoint)


                    searchingFor := -1


                    countSwingTop = array.size(arraySwingTop)
                    if (countSwingTop > 0)
                        lastSwingTop = array.get(arraySwingTop, countSwingTop - 1)
                        swingThreshold := math.min(candidateBottomPrice + minSwingLength, lastSwingTop.Price)
        else // => searchingFor < 0
            bool isNewLow = false


            if (low < candidateBottomPrice)
                isNewLow := true


                candidateBottomPrice := low
                candidateBottomBar := bar_index


                SwingPoint tempSwingPoint = SwingPoint.new(key, false, low, 0, bar_index)
                z_add_label_for_swing_point(tempSwingPoint)


                z_update_candidate_swing_point(arraySwingBottom, tempSwingPoint)  


                swingThreshold := math.min(swingThreshold, candidateBottomPrice + minSwingLength)


            if (not isNewLow)
                if ((high >= swingThreshold) and (bar_index > candidateBottomBar))


                    candidateTopPrice := high
                    candidateTopBar := bar_index


                    swingPoint := SwingPoint.new(key, true, high, 0, bar_index)
                    z_add_label_for_swing_point(swingPoint)
                   
                    if (not z_array_swing_constaint_key(arraySwingTop, key))
                        array.push(arraySwingTop, swingPoint)
                   
                    searchingFor := 1


                    countSwingsBottom = array.size(arraySwingBottom)
                    if (countSwingsBottom > 0)
                        lastSwingPointBottom = array.get(arraySwingBottom, countSwingsBottom - 1)
                        swingThreshold := math.max(candidateTopPrice - minSwingLength, lastSwingPointBottom.Price)
    swingPoint
