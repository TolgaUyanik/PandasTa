//@version=5
library('Binary', true)

//@function Converts the provided boolean value into binary integers (0 or 1).
//@param value The boolean value to be converted.
//@returns The converted value in binary integers.
export method toBin(bool value) =>
    int             out     = switch value
        true                => 1
        false               => 0
        
    out
    
//@function Converts a decimal number into its binary representation.
//@param value The decimal number to be converted.
//@param iBits The number of binary digits allocated for the integer part.
//@param fBits The number of binary digits allocated for the fractional part.
//@returns An array containing the binary digits for the integer part at the rightmost positions and the digits for the fractional part at the leftmost positions. The array indexes correspond to the bit positions.
export method dec2bin(float value, int iBits, int fBits) =>
    out                     = array.new <int> ()
    float           tmp     = value
    int             prc     = na
    
    for i = -(iBits - 1) to fBits
        prc := math.floor(tmp * math.pow(2, i))
        
        if prc > 1
            runtime.error('Low Bit Width!')  // Specified iBits is not enough to cover the integer part.
            
        out.unshift(prc)
        tmp -= prc * math.pow(2, -i)
        
    out
    
//@function Converts a binary number into its decimal representation.
//@param value The binary number to be converted.
//@param iBits The number of binary digits allocated for the integer part.
//@param fBits The number of binary digits allocated for the fractional part.
//@returns The converted value in decimal format.
export method bin2dec(array <int> value, int iBits, int fBits) =>
    float           out     = 0
    int             n       = 0
    
    for i = -fBits to (iBits - 1)
        out += value.get(n) * math.pow(2, i)
        n   += 1
        
    out
    
//@function Bitwise logical AND of two binary numbers. The result of ANDing two binary digits is 1 only if both digits are 1, otherwise, 0.
//@param a First binary number.
//@param b Second binary number.
//@returns An array containing the logical AND of the inputs.
export method lgcAnd(array <int> a, array <int> b) =>
    out                     = array.new <int> ()
    
    for i = 0 to a.size() - 1
        out.push(toBin(a.get(i) and b.get(i)))
        
    out
    
//@function Bitwise logical OR of two binary numbers. The result of ORing two binary digits is 0 only if both digits are 0, otherwise, 1.
//@param a First binary number.
//@param b Second binary number.
//@returns An array containing the logical OR of the inputs.
export method lgcOr(array <int> a, array <int> b) =>
    out                     = array.new <int> ()
    
    for i = 0 to a.size() - 1
        out.push(toBin(a.get(i) or b.get(i)))
        
    out
    
//@function Bitwise logical XOR of two binary numbers. The result of XORing two binary digits is 1 only if ONE of the digits is 1, otherwise, 0.
//@param a First binary number.
//@param b Second binary number.
//@returns An array containing the logical XOR of the inputs.
export method lgcXor(array <int> a, array <int> b) =>
    out                     = array.new <int> ()
    
    for i = 0 to a.size() - 1
        out.push(toBin((a.get(i) and not(b.get(i))) or (not(a.get(i)) and b.get(i))))
        
    out
    
//@function Bitwise logical NAND of two binary numbers. The result of NANDing two binary digits is 0 only if both digits are 1, otherwise, 1.
//@param a First binary number.
//@param b Second binary number.
//@returns An array containing the logical NAND of the inputs.
export method lgcNand(array <int> a, array <int> b) =>
    out                     = array.new <int> ()
    
    for i = 0 to a.size() - 1
        out.push(toBin(not(a.get(i) and b.get(i))))
        
    out
    
//@function Bitwise logical NOR of two binary numbers. The result of NORing two binary digits is 1 only if both digits are 0, otherwise, 0.
//@param a First binary number.
//@param b Second binary number.
//@returns An array containing the logical NOR of the inputs.
export method lgcNor(array <int> a, array <int> b) =>
    out                     = array.new <int> ()
    
    for i = 0 to a.size() - 1
        out.push(toBin(not(a.get(i) or b.get(i))))
        
    out
    
//@function Bitwise logical NOT of a binary number. The result of NOTing a binary digit is 0 if the digit is 1, or vice versa.
//@param a A binary number.
//@returns An array containing the logical NOT of the input.
export method lgcNot(array <int> a) =>
    out                     = array.new <int> ()
    
    for i = 0 to a.size() - 1
        out.push(toBin(not a.get(i)))
        
    out
    
//@function 2's complement of a binary number. The 2's complement of a binary number N with n digits is defined as 2^(n) - N.
//@param a A binary number.
//@returns An array containing the 2's complement of the input.
export method lgc2sC(array <int> a) =>
    out                     = array.new <int> ()
    bool            invert  = false
    
    for i = 0 to a.size() - 1
        if invert
            out.push(toBin(not a.get(i)))
        else
            out.push(a.get(i))
            
        if a.get(i) == 1
            invert := true
            
    out
    
//@function Shifts a binary number in the specified direction by one position.
//@param a A binary number.
//@param direction The direction of the shift operation.
//@param newBit The bit to be inserted into the unoccupied slot.
//@returns A tuple of the shifted binary number and the serial output of the shift operation.
export method shift(array <int> value, int direction, int newBit) =>  // Direction:1 = Shift Right
    out                     = array.new <int> ()
    out                     := value.copy()
    int             serial  = na
    
    if bool(direction)
        serial := out.shift()
        out.push(newBit)
    else
        serial := out.pop()
        out.unshift(newBit)
        
    [out, serial]
    
//@function Shifts a binary number in the specified direction by multiple positions.
//@param a A binary number.
//@param direction The direction of the shift operation.
//@param newBit The bits to be inserted into the unoccupied slots.
//@returns A tuple of the shifted binary number and the serial output of the shift operation.
export method multiShift(array <int> value, int direction, array <int> newBits) =>  // Direction:1 = Shift Right
    out                     = array.new <int> ()
    serial                  = array.new <int> ()
    out                     := value.copy()
    int             count   = newBits.size()
    
    if bool(direction)
        for i = 0 to count - 1
            serial.push(out.shift())
            out.push(newBits.get(i))
            
    else
        for i = count - 1 to 0
            serial.unshift(out.pop())
            out.unshift(newBits.get(i))
            
    [out, serial]
    
//@function Circularly shifts a binary number in the specified direction by multiple positions. Each ejected bit is inserted from the opposite side.
//@param a A binary number.
//@param direction The direction of the shift operation.
//@param count The number of positions to be shifted by.
//@returns The shifted binary number.
export method crclrShift(array <int> value, int direction, int count = 1) =>  // Direction:1 = Shift Right
    out                     = array.new <int> ()
    out                     := value.copy()
    
    if bool(direction)
        for i = 1 to count
            out.push(out.shift())
            
    else
        for i = 1 to count
            out.unshift(out.pop())
            
    out
    
//@function Performs arithmetic shift on a binary number in the specified direction by multiple positions. Every new bit is 0 if the shift is leftward, otherwise, it equals the sign bit.
//@param a A binary number.
//@param direction The direction of the shift operation.
//@param count The number of positions to be shifted by.
//@returns The shifted binary number.
export method arithmeticShift(array <int> value, int direction, int count = 1) =>  // Direction:1 = Shift Right
    out                     = array.new <int> ()
    serial                  = array.new <int> ()
    out                     := value.copy()
    int             sign    = out.pop()
    
    if bool(direction)
        for i = 1 to count
            serial.push(out.shift())
            out.push(sign)
            
    else
        for i = 1 to count
            serial.unshift(out.pop())
            out.unshift(0)
            
    out.push(sign)
    
    [out, serial]
    
//@function Performs arithmetic addition on two binary numbers.
//@param a First binary number.
//@param b Second binary number.
//@param carry The input carry of the operation.
//@returns The result of the arithmetic addition of the inputs.
export method add(array <int> a, array <int> b, int carry = 0) =>
    out                     = array.new <int> ()
    int             s       = na
    int             c       = carry
    
    for i = 0 to a.size() - 1
        s := a.get(i) + b.get(i) + c
        
        if      s == 0
            out.push(0)
            s := 0
            c := 0
        else if s == 1
            out.push(1)
            s := 0
            c := 0
        else if s == 2
            out.push(0)
            s := 0
            c := 1
        else if s == 3
            out.push(1)
            s := 0
            c := 1
        else
            runtime.error('Inputs must be binary numbers!')
            
    [out, c]
    
//@function Performs arithmetic subtraction on two binary numbers.
//@param a First binary number.
//@param b Second binary number. The number to be subtracted.
//@param carry The input carry of the operation.
//@returns The result of the arithmetic subtraction of the input b from the input a.
export method sub(array <int> a, array <int> b, int carry = 0) =>
    out                     = array.new <int> ()
    int             s       = na
    int             c       = carry
    
    for i = 0 to a.size() - 1
        s := a.get(i) - b.get(i) - c
        
        if      s == 1
            out.push(1)
            s := 0
            c := 0
        else if s == 0
            out.push(0)
            s := 0
            c := 0
        else if s == -1
            out.push(1)
            s := 0
            c := 1
        else if s == -2
            out.push(0)
            s := 0
            c := 1
        else
            runtime.error('Inputs must be binary numbers!')
            
    [out, c]
    
    