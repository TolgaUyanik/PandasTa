//@version=5
indicator("Smart Volatility Squeeze + Trend Filter", overlay=true)

// === INPUTS ===
// Bollinger Bands
bbLength = input.int(20, "BB Length")
bbStdDev = input.float(2.0, "BB StdDev")

// Keltner Channel
kcLength = input.int(20, "KC EMA Length")
kcMult = input.float(1.5, "KC ATR Multiplier")

// Trend Filter
useFilter = input.bool(true, "Use Trend Filter")
trendLen = input.int(50, "Trend EMA Length")

// === BOLLINGER BANDS ===
basis = ta.sma(close, bbLength)
dev = bbStdDev * ta.stdev(close, bbLength)
bbUpper = basis + dev
bbLower = basis - dev

// === KELTNER CHANNEL ===
emaKC = ta.ema(close, kcLength)
atrKC = kcMult * ta.atr(kcLength)
kcUpper = emaKC + atrKC
kcLower = emaKC - atrKC

// === SQUEEZE CONDITION ===
squeezeOn = bbUpper < kcUpper and bbLower > kcLower

// === BREAKOUT ===
breakoutUp = ta.crossover(close, bbUpper)
breakoutDown = ta.crossunder(close, bbLower)

// === TREND FILTER ===
trendUp = close > ta.ema(close, trendLen)
trendDown = close < ta.ema(close, trendLen)

// === FINAL SIGNAL ===
longSignal = breakoutUp and (not useFilter or trendUp)
shortSignal = breakoutDown and (not useFilter or trendDown)

// === PLOTS ===
// BB
plot(bbUpper, color=color.blue, title="BB Upper")
plot(bbLower, color=color.blue, title="BB Lower")
plot(basis, color=color.blue, title="BB Basis")

// KC
plot(kcUpper, color=color.orange, title="KC Upper")
plot(kcLower, color=color.orange, title="KC Lower")
plot(emaKC, color=color.orange, title="KC EMA")

// Squeeze marker
plotshape(squeezeOn, style=shape.circle, location=location.bottom, color=color.green, size=size.tiny, title="Squeeze On")

// Breakout signals
plotshape(longSignal, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Long Signal")
plotshape(shortSignal, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Signal")

// Alerts
alertcondition(longSignal, title="Long Breakout", message="Price broke out UP from squeeze with trend confirmation")
alertcondition(shortSignal, title="Short Breakout", message="Price broke out DOWN from squeeze with trend confirmation")

// === BACKGROUND COLOR WITH DURATION GRADIENT ===
var int squeezeBars = 0
squeezeBars := squeezeOn ? squeezeBars + 1 : 0
transparency = math.max(0, 80 - squeezeBars * 2)
bgcolor(squeezeOn ? color.new(#f5d142, transparency) : na)
