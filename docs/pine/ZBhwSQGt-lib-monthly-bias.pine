//@version=6
// @description Monthly Open bias calculations: distance from MO, mean reversion window detection
library("lib_monthly_bias", overlay=true)

// Monthly open value - call via: request.security(sym, "M", mb.monthly_open_val())
export monthly_open_val() =>
    open

// Percentage distance from monthly open
export pct_from_mo(float price, float mo) =>
    mo > 0 ? ((price - mo) / mo) * 100.0 : 0.0

// Is price above monthly open
export is_above_mo(float price, float mo) =>
    price > mo

// Is in mean reversion window (late month + extended from MO)
// dom: day of month, pct_from: % distance from MO, threshold: min % extension (e.g. 1.5)
export is_mr_window(int dom, float pct_from, float threshold) =>
    dom >= 15 and math.abs(pct_from) > threshold
