//@version=6
library("FvgPanel", true)

// FvgPanel Library
// v1.0, 2025.05.30

// This code's style is based on the recommendations from the Pine Script User Manual's Style guide:
//    https://www.tradingview.com/pine-script-docs/writing/style-guide/



//#region ———————————————————— Types


// @type                                      Represents the data structure for populating the FVG information panel.
//                                            It holds the nearest FVG mitigation levels and their attributes for each timeframe.
// @field nearestBullMitLvl    (float)        The price level of the nearest bullish FVG's mitigation point (bottom for bull) on the LTF. (Can be series)
// @field isNearestBullLV      (simple bool)  True if the nearest bullish FVG on the LTF is a Large Volume FVG.
// @field ltfBullBgColor       (simple color) Background color for the LTF bullish FVG cell in the panel.
// @field ltfBullTextColor     (simple color) Text color for the LTF bullish FVG cell in the panel.
// @field nearestBearMitLvl    (float)        The price level of the nearest bearish FVG's mitigation point (top for bear) on the LTF. (Can be series)
// @field isNearestBearLV      (simple bool)  True if the nearest bearish FVG on the LTF is a Large Volume FVG.
// @field ltfBearBgColor       (simple color) Background color for the LTF bearish FVG cell in the panel.
// @field ltfBearTextColor     (simple color) Text color for the LTF bearish FVG cell in the panel.
// @field nearestMtfBullMitLvl (float)        The price level of the nearest bullish FVG's mitigation point on the MTF. (Can be series)
// @field isNearestMtfBullLV   (simple bool)  True if the nearest bullish FVG on the MTF is a Large Volume FVG.
// @field mtfBullBgColor       (simple color) Background color for the MTF bullish FVG cell.
// @field mtfBullTextColor     (simple color) Text color for the MTF bullish FVG cell.
// @field nearestMtfBearMitLvl (float)        The price level of the nearest bearish FVG's mitigation point on the MTF. (Can be series)
// @field isNearestMtfBearLV   (simple bool)  True if the nearest bearish FVG on the MTF is a Large Volume FVG.
// @field mtfBearBgColor       (simple color) Background color for the MTF bearish FVG cell.
// @field mtfBearTextColor     (simple color) Text color for the MTF bearish FVG cell.
// @field nearestHtfBullMitLvl (float)        The price level of the nearest bullish FVG's mitigation point on the HTF. (Can be series)
// @field isNearestHtfBullLV   (simple bool)  True if the nearest bullish FVG on the HTF is a Large Volume FVG.
// @field htfBullBgColor       (simple color) Background color for the HTF bullish FVG cell.
// @field htfBullTextColor     (simple color) Text color for the HTF bullish FVG cell.
// @field nearestHtfBearMitLvl (float)        The price level of the nearest bearish FVG's mitigation point on the HTF. (Can be series)
// @field isNearestHtfBearLV   (simple bool)  True if the nearest bearish FVG on the HTF is a Large Volume FVG.
// @field htfBearBgColor       (simple color) Background color for the HTF bearish FVG cell.
// @field htfBearTextColor     (simple color) Text color for the HTF bearish FVG cell.
export type panelData
    float nearestBullMitLvl    = na
    bool  isNearestBullLV      = false
    color ltfBullBgColor       = na
    color ltfBullTextColor     = na
    float nearestBearMitLvl    = na
    bool  isNearestBearLV      = false
    color ltfBearBgColor       = na
    color ltfBearTextColor     = na
    float nearestMtfBullMitLvl = na
    bool  isNearestMtfBullLV   = false
    color mtfBullBgColor       = na
    color mtfBullTextColor     = na
    float nearestMtfBearMitLvl = na
    bool  isNearestMtfBearLV   = false
    color mtfBearBgColor       = na
    color mtfBearTextColor     = na
    float nearestHtfBullMitLvl = na
    bool  isNearestHtfBullLV   = false
    color htfBullBgColor       = na
    color htfBullTextColor     = na
    float nearestHtfBearMitLvl = na
    bool  isNearestHtfBearLV   = false
    color htfBearBgColor       = na
    color htfBearTextColor     = na
//#endregion



//#region ———————————————————— Functions


// @function                      Formats a price value to a string based on the symbol's minimum tick size.
//                                Internal helper function.
// @param   price (series float)  The price value to format. Can be 'series' as it comes from FVG levels.
// @returns       (simple string) The formatted price string.
formatPrice(series float price) => 
    str.tostring(price, format.mintick)


// @function                              Creates and initializes the FVG information panel (table).
//                                        Sets up the header rows and timeframe labels.
// @param position        (simple string) The position of the panel on the chart (e.g., `position.top_right`).
//                                        Uses `position.*` constants.
// @param borderColor     (simple color)  The color of the panel's border.
// @param borderWidth     (simple int)    The width of the panel's border.
// @param headerBgColor   (simple color)  The background color for the header cells.
// @param headerTextColor (simple color)  The text color for the header cells.
// @param headerTextSize  (simple string) The text size for the header cells (e.g., `size.small`).
//                                        Uses `size.*` constants.
// @returns               (table)         The newly created table object representing the panel.
export createPanel(simple string position, simple color borderColor, simple int borderWidth, simple color headerBgColor, simple color headerTextColor, simple string headerTextSize) =>
    table panelTable = table.new(position, 3, 4, border_width = borderWidth, border_color = borderColor)
    // Header Row 1: Column Titles
    table.cell(panelTable, 0, 0, "TF",       text_color = headerTextColor, bgcolor = headerBgColor, text_size = headerTextSize, text_halign = text.align_center)
    table.cell(panelTable, 1, 0, "Bull FVG", text_color = headerTextColor, bgcolor = headerBgColor, text_size = headerTextSize, text_halign = text.align_center)
    table.cell(panelTable, 2, 0, "Bear FVG", text_color = headerTextColor, bgcolor = headerBgColor, text_size = headerTextSize, text_halign = text.align_center)

    // Header Row 2: Timeframe Labels (Row Titles)
    table.cell(panelTable, 0, 1, "Current",  text_color = headerTextColor, bgcolor = headerBgColor, text_size = headerTextSize, text_halign = text.align_left) // LTF
    table.cell(panelTable, 0, 2, "MTF",      text_color = headerTextColor, bgcolor = headerBgColor, text_size = headerTextSize, text_halign = text.align_left)
    table.cell(panelTable, 0, 3, "HTF",      text_color = headerTextColor, bgcolor = headerBgColor, text_size = headerTextSize, text_halign = text.align_left)
    panelTable


// @function                               Updates the content of the FVG information panel with the latest FVG data.
// @param panelTable       (table)         The table object representing the panel to be updated.
// @param data             (panelData)     An object containing the FVG data to display. (UDT, no simple/series qualifier)
// @param lvIcon           (simple string) The icon (e.g., emoji) to display next to Large Volume FVGs.
// @param defaultTextColor (simple color)  The default text color for FVG levels if not highlighted.
// @param naCellColor      (simple color)  The background color for cells where no FVG data is available ("---").
// @param textSize         (simple string) The text size for the FVG level data (e.g., `size.small`).
// @returns_void
export updatePanel(table panelTable, panelData data, simple string lvIcon, simple color defaultTextColor, simple color naCellColor, simple string textSize) =>
    // Format LTF FVG levels
    string bullMitTextLtf      = na(data.nearestBullMitLvl)     ? "---" : formatPrice(data.nearestBullMitLvl)
    string bearMitTextLtf      = na(data.nearestBearMitLvl)     ? "---" : formatPrice(data.nearestBearMitLvl)
    // Format MTF FVG levels
    string bullMitTextMtf      = na(data.nearestMtfBullMitLvl)  ? "---" : formatPrice(data.nearestMtfBullMitLvl)
    string bearMitTextMtf      = na(data.nearestMtfBearMitLvl)  ? "---" : formatPrice(data.nearestMtfBearMitLvl)
    // Format HTF FVG levels
    string bullMitTextHtf      = na(data.nearestHtfBullMitLvl)  ? "---" : formatPrice(data.nearestHtfBullMitLvl)
    string bearMitTextHtf      = na(data.nearestHtfBearMitLvl)  ? "---" : formatPrice(data.nearestHtfBearMitLvl)

    // Determine background colors, defaulting to naCellColor if specific color is not provided
    color ltfBullBgEffective   = na(data.ltfBullBgColor)        ? naCellColor : data.ltfBullBgColor
    color ltfBearBgEffective   = na(data.ltfBearBgColor)        ? naCellColor : data.ltfBearBgColor
    color mtfBullBgEffective   = na(data.mtfBullBgColor)        ? naCellColor : data.mtfBullBgColor
    color mtfBearBgEffective   = na(data.mtfBearBgColor)        ? naCellColor : data.mtfBearBgColor
    color htfBullBgEffective   = na(data.htfBullBgColor)        ? naCellColor : data.htfBullBgColor
    color htfBearBgEffective   = na(data.htfBearBgColor)        ? naCellColor : data.htfBearBgColor

    // Determine text colors, defaulting to defaultTextColor if specific color is not provided
    color ltfBullTextEffective = na(data.ltfBullTextColor)      ? defaultTextColor : data.ltfBullTextColor
    color ltfBearTextEffective = na(data.ltfBearTextColor)      ? defaultTextColor : data.ltfBearTextColor
    color mtfBullTextEffective = na(data.mtfBullTextColor)      ? defaultTextColor : data.mtfBullTextColor
    color mtfBearTextEffective = na(data.mtfBearTextColor)      ? defaultTextColor : data.mtfBearTextColor
    color htfBullTextEffective = na(data.htfBullTextColor)      ? defaultTextColor : data.htfBullTextColor
    color htfBearTextEffective = na(data.htfBearTextColor)      ? defaultTextColor : data.htfBearTextColor

    // Prepend LV icon if applicable
    if data.isNearestBullLV and not na(data.nearestBullMitLvl)
        bullMitTextLtf := lvIcon + " " + bullMitTextLtf
    if data.isNearestBearLV and not na(data.nearestBearMitLvl)
        bearMitTextLtf := lvIcon + " " + bearMitTextLtf
    if data.isNearestMtfBullLV and not na(data.nearestMtfBullMitLvl)
        bullMitTextMtf := lvIcon + " " + bullMitTextMtf
    if data.isNearestMtfBearLV and not na(data.nearestMtfBearMitLvl)
        bearMitTextMtf := lvIcon + " " + bearMitTextMtf
    if data.isNearestHtfBullLV and not na(data.nearestHtfBullMitLvl)
        bullMitTextHtf := lvIcon + " " + bullMitTextHtf
    if data.isNearestHtfBearLV and not na(data.nearestHtfBearMitLvl)
        bearMitTextHtf := lvIcon + " " + bearMitTextHtf

    // Update LTF cells (Row 1 for data)
    table.cell(panelTable, 1, 1, bullMitTextLtf, text_color = ltfBullTextEffective, bgcolor = ltfBullBgEffective, text_size = textSize, text_halign = text.align_right)
    table.cell(panelTable, 2, 1, bearMitTextLtf, text_color = ltfBearTextEffective, bgcolor = ltfBearBgEffective, text_size = textSize, text_halign = text.align_right)

    // Update MTF cells (Row 2 for data)
    table.cell(panelTable, 1, 2, bullMitTextMtf, text_color = mtfBullTextEffective, bgcolor = mtfBullBgEffective, text_size = textSize, text_halign = text.align_right)
    table.cell(panelTable, 2, 2, bearMitTextMtf, text_color = mtfBearTextEffective, bgcolor = mtfBearBgEffective, text_size = textSize, text_halign = text.align_right)

    // Update HTF cells (Row 3 for data)
    table.cell(panelTable, 1, 3, bullMitTextHtf, text_color = htfBullTextEffective, bgcolor = htfBullBgEffective, text_size = textSize, text_halign = text.align_right)
    table.cell(panelTable, 2, 3, bearMitTextHtf, text_color = htfBearTextEffective, bgcolor = htfBearBgEffective, text_size = textSize, text_halign = text.align_right)
//#endregion
