//@version=6
indicator("Above / Below Markers", overlay=true)

// Пример условий
aboveCondition = close > open
belowCondition = close < open

plotshape(aboveCondition,title="Marker Above",style=shape.triangledown,location=location.abovebar,color=color.red,size=size.small)

plotshape(belowCondition,title="Marker Below",style=shape.triangledown,location=location.belowbar,color=color.green,size=size.small)