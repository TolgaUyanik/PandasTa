// ============================================================================
//  凱因斯順勢策略 — 多週期順勢版（重建 / Reconstructed v2 校準版）
// ----------------------------------------------------------------------------
//  ⚠️ 原始「凱因斯指標策略回測（多週期順勢版）」原始碼為加密保護，無法取得。
//  本腳本依「參數標題 + 實際進出場行為 + 原指標數值擬合」重建，可自由編輯。
//
//  【震盪值校準】原版「凱因斯群眾心理變化」抓 400 根實測擬合：
//    凱因斯值 ≈ 1.12 × EMA5( (close−SMA240)/SMA240 ×100 ) − 0.48
//    形狀相關 r≈0.97、零軸(紅綠)符號一致率 97.5%。
//
//  與「停損停利版」差異：大週期濾網改【日線(1D)】、無內建停損停利、
//  出場僅靠反向訊號平倉。其餘訊號核心相同。
// ============================================================================
//@version=6
strategy("凱因斯順勢策略 — 多週期版(重建)", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=1000000, pyramiding=0,
     calc_on_order_fills=false, process_orders_on_close=true,
     commission_type=strategy.commission.cash_per_contract, commission_value=120)

// ─── 訊號參數 ───
emaLen    = input.int(20,  "EMA 長度",        group="訊號")
smaMidLen = input.int(60,  "短期 SMA 長度",    group="訊號")
smaLngLen = input.int(240, "長期 SMA 長度",    group="訊號")
hmaLen    = input.int(217, "HMA 長度",         group="訊號")
src       = input.source(close, "來源價格",     group="訊號")
longThr   = input.float(0, "多單觸發門檻",      group="訊號")

// ─── 大週期濾網（多週期版 → 預設日線）───
useHTF    = input.bool(true,  "啟用大週期順勢濾網", group="濾網")
htfRes    = input.timeframe("1D", "大週期濾網時框",  group="濾網")

// ─── Webhook 自動下單 ───
useWebhook     = input.bool(false, "啟用 Webhook 訊息（接你的下單系統）", group="Webhook")
webhook_secret = input.string("tv_mxf_abc123xyz", "Webhook Secret", group="Webhook")
msg_buy        = '{"secret":"' + webhook_secret + '","action":"BUY","quantity":1}'
msg_sell       = '{"secret":"' + webhook_secret + '","action":"SELL","quantity":1}'
msg_exit_long  = '{"secret":"' + webhook_secret + '","action":"EXIT_LONG","quantity":1}'
msg_exit_short = '{"secret":"' + webhook_secret + '","action":"EXIT_SHORT","quantity":1}'

// ─── 凱因斯群眾心理變化（校準版震盪值）───
emaV    = ta.ema(src, emaLen)
smaMid  = ta.sma(src, smaMidLen)
smaLng  = ta.sma(src, smaLngLen)
devPct  = (src - smaLng) / smaLng * 100
keynes  = 1.12 * ta.ema(devPct, 5) - 0.48
// 註：本策略 overlay 在價格圖上，凱因斯震盪值僅顯示於「數據視窗」避免擠壓價格軸；
//     想看紅綠柱狀圖，請保留原版「凱因斯指標」在副圖即可。
plot(keynes, "凱因斯群眾心理變化", color = keynes >= 0 ? color.red : color.green, display=display.data_window)

// ─── 方向確認 + 大週期(日線)順勢濾網 ───
hma      = ta.hma(src, hmaLen)
hmaUp    = hma > hma[1]
htfClose = request.security(syminfo.tickerid, htfRes, close, lookahead=barmerge.lookahead_off)
htfSma   = request.security(syminfo.tickerid, htfRes, ta.sma(close, smaMidLen), lookahead=barmerge.lookahead_off)
htfUp    = not useHTF or htfClose > htfSma

// ─── 進場 / 出場（反向訊號平倉，無 SL/TP）───
longSignal = ta.crossover(keynes, longThr) and hmaUp and htfUp
exitSignal = ta.crossunder(keynes, longThr)

if longSignal
    strategy.entry("買", strategy.long, alert_message = useWebhook ? msg_buy : "凱因斯多單進場")

if strategy.position_size > 0 and exitSignal
    strategy.close("買", comment="多單平倉", alert_message = useWebhook ? msg_exit_long : "凱因斯多單平倉")

// ─── 視覺輔助 ───
plot(emaV,   "EMA",  color=color.new(color.orange, 0))
plot(smaMid, "SMA中", color=color.new(color.blue, 40))
plot(smaLng, "SMA長", color=color.new(color.gray, 20))

// ============================================================================
//  📌 Webhook 設定步驟：
//   1. 把上方「啟用 Webhook 訊息」打開，並改 JSON 成你下單系統的格式
//   2. 圖表右上「警報(Alert)」→ 條件選本策略 → 觸發「訂單成交時」
//   3. 訊息框填入：{{strategy.order.alert_message}}
//   4. 通知分頁勾「Webhook URL」並貼上你的接收網址 → 建立
// ============================================================================
