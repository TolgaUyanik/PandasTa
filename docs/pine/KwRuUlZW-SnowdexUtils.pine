//@version=6

// @description the various function that often use when create a strategy trading.
library("SnowdexUtils", overlay = true)

// @function Backtesting within a specific window based on deployment and testing dates.
// @param train_start_date the start date for training the strategy.
// @param train_end_date the end date for training the strategy.
// @param test_date if true, backtests within the period from `train_end_date` to the current time.
// @param deploy_date if true, the strategy backtests up to the current time.
// @returns given time falls within the specified window for backtesting.
export f_backtesting_date(int train_start_date, int train_end_date, bool test_date, bool deploy_date) => 
    if (deploy_date)
        time < timenow
    else if (not test_date)
        time >= train_start_date and time <= train_end_date  // create date function "within window of time"
    else
        time >= train_end_date and time <= timenow

// @function Initializes a moving average based on the specified type.
// @param ma_type the type of moving average (e.g., "RMA", "EMA", "SMA", "WMA").
// @param source the input series for the moving average calculation.
// @param length the length of the moving average window.
// @returns the calculated moving average value.
export f_init_ma(simple string ma_type, series float source, simple int length) => 
    switch ma_type
        "RMA" => ta.rma(source = source, length = length)
        "EMA" => ta.ema(source = source, length = length)
        "SMA" => ta.sma(source = source, length = length)
        "WMA" => ta.wma(source = source, length = length)
        =>
            runtime.error("No matching `ma type` found.")
            float(na)

// @function Calculates the target profit based on entry price, risk-reward ratio, and stop loss. The formula is `tp = entry price + (rr * (entry price - stop loss))`.
// @param side the trading side (true for long, false for short).
// @param entry_price the entry price of the position.
// @param rr the risk-reward ratio.
// @param sl_open_position the stop loss price for the open position.
// @returns the calculated target profit value.
export f_init_tp(bool side, float entry_price, float rr, float sl_open_position) => 
    if (side)
        tp_value = entry_price + (rr * (entry_price - sl_open_position))

// @function Rounds up a number to a specified number of decimals.
// @param the number to be rounded.
// @param the number of decimal places to round to.
// @returns The rounded-up number.
export f_round_up(float number, int decimals) =>
    factor = math.pow(10, decimals)
    math.ceil(number * factor) / factor

// @function Calculates the pip size for the current instrument.
// @returns Pip size adjusted for Forex instruments or 1 for others.
export f_get_pip_size() =>
    syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)

// @function Maps a string to a table position constant.
// @param value String representing the desired position (e.g., "Top Right").
// @returns The corresponding position constant or `na` for invalid values.
export f_table_get_position(string value) =>
    switch value
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Middle Right" => position.middle_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        => na  // Handle unexpected values.
