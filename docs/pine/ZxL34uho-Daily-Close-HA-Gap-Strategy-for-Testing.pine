//@version=6
strategy("Daily Close-HA Gap Strategy for Testing", overlay=true, pyramiding=0, process_orders_on_close=true, max_labels_count=500)

//----------------------------------
// Standard daily values
//----------------------------------
daily_normal_close = request.security(syminfo.tickerid, "D", close)
daily_ha_close     = request.security(ticker.heikinashi(syminfo.tickerid), "D", close)
gap                = daily_normal_close - daily_ha_close

//----------------------------------
// % only for display
//----------------------------------
spotPrice = close
gapPct    = spotPrice != 0 ? (gap / spotPrice) * 100 : na

pctText = str.tostring(gapPct, "#.##") + "%"
absText = str.tostring(gap, format.mintick)
fullText = pctText + "\n" + absText

//----------------------------------
// Only use the confirmed 3:30 PM close bar
//----------------------------------
is330 = hour(time_close) == 15 and minute(time_close) == 30 and barstate.isconfirmed

//----------------------------------
// Final signal from ONE source only
//----------------------------------
finalValue = is330 ? gap : na

buySignal  = is330 and finalValue > 20
sellSignal = is330 and finalValue < -20
noTrade    = is330 and finalValue >= -20 and finalValue <= 20

//----------------------------------
// Plot debug markers
//----------------------------------
plot(gap, title="Gap Value", color=color.blue)
hline(20, "Buy Level", color=color.green)
hline(-20, "Sell Level", color=color.red)

plotshape(buySignal,  title="Buy Signal",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.tiny)
plotshape(sellSignal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.tiny)

//----------------------------------
// Trade execution: exactly same logic as displayed value
//----------------------------------
var int entryYear  = na
var int entryMonth = na
var int entryDay   = na

if buySignal and strategy.position_size <= 0
    strategy.close("Sell")
    strategy.entry("Buy", strategy.long)
    entryYear  := year(time)
    entryMonth := month(time)
    entryDay   := dayofmonth(time)

if sellSignal and strategy.position_size >= 0
    strategy.close("Buy")
    strategy.entry("Sell", strategy.short)
    entryYear  := year(time)
    entryMonth := month(time)
    entryDay   := dayofmonth(time)

//----------------------------------
// Exit next day at 12:00 PM
//----------------------------------
isNextDay = strategy.position_size != 0 and (
     year(time) > entryYear or
     (year(time) == entryYear and month(time) > entryMonth) or
     (year(time) == entryYear and month(time) == entryMonth and dayofmonth(time) > entryDay)
)

isExitTime = hour(time_close) == 12 and minute(time_close) == 0

if isNextDay and isExitTime
    strategy.close("Buy")
    strategy.close("Sell")

//----------------------------------
// Show label only on 3:30 bar
//----------------------------------
if is330 and not na(gap)
    label.new(
         x = time,
         y = low,
         text = fullText,
         xloc = xloc.bar_time,
         yloc = yloc.belowbar,
         style = label.style_none,
         textcolor = color.blue,
         size = size.tiny,
         textalign = text.align_center,
         text_formatting = text.format_bold,
         force_overlay = true)

if array.size(label.all) > 500
    label.delete(array.get(label.all, 0))