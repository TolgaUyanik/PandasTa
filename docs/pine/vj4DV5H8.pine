//@version=5
library("DrawIndicatorOnTheChart", overlay = true)

// finds relational location of any indicator value in the indicator window
export getIndiLevel(float indi, float indimax, float indimin, float top, float bottom)=>
    float relationalpos = bottom + (top - bottom) * ((indi  - indimin) / (indimax - indimin))

// Find the lowest timeframe
export findLowestTimeframe(int[] timeframes) =>
    var int lowestTimeframe = na
    for timeframe in timeframes
        if not na(timeframe) and (na(lowestTimeframe) or timeframe < lowestTimeframe)
            lowestTimeframe := timeframe
    lowestTimeframe

// Find the index of the indicator with the lowest timeframe
export findLabelIndex(int[] timeframes, int lowestTimeframe) =>
    var int labelIndex = -1
    for i = 0 to array.size(timeframes) - 1
        if array.get(timeframes, i) == lowestTimeframe
            labelIndex := i
            break
    labelIndex

export drawMultipleIndicators(bool enabled, string title, int windowNumber, float[] indicatorValues, int[] timeframes, color[] indicatorColors, int period, float indimax_, float indimin_, float [] levels, int precision, int xlocation, int lnwidth) =>
    if enabled and barstate.islast
        // 1. Calculate indicator max/min
        float ind_h_ = na
        float ind_l_ = na
        for i = 0 to array.size(indicatorValues) - 1
            indicatorValue = array.get(indicatorValues, i)
            for x = 0 to period - 1
                if na(ind_h_) or indicatorValue[x] > ind_h_
                    ind_h_ := indicatorValue[x]
                if na(ind_l_) or indicatorValue[x] < ind_l_
                    ind_l_ := indicatorValue[x]

        // 2. Determine indimax and indimin
        float indimax = not na(indimax_) ? indimax_ : ind_h_ + (ind_h_ - ind_l_) * 0.20 // 여백 증가
        float indimin = not na(indimin_) ? indimin_ : ind_l_ - (ind_h_ - ind_l_) * 0.20 // 여백 증가

        // 3. Calculate top and bottom (using a fixed range based on indimax and indimin)
        indicator_range = (indimax - indimin)

        // 캔버스를 차트 하단에 고정
        bottom_chart = ta.lowest(low, 500) // 최근 500개 캔들의 최저가
        top = bottom_chart + indicator_range * 1.2 // 캔버스 높이를 적절히 조정
        bottom = bottom_chart

        // 4. Adjust window position based on windowNumber (optional)
        windowOffset = (windowNumber - 1) * 0.2 // Example offset
        top := top + windowOffset
        bottom := bottom + windowOffset

        // Draw indicator window
        var line border_line_top = na
        line.delete(border_line_top)
        border_line_top := line.new(x1=bar_index - period - xlocation, y1=top, x2=bar_index + 1 - xlocation, y2=top, color=color.gray, width=4, style=line.style_solid)
        border_line_top

        var line border_line_bottom = na
        line.delete(border_line_bottom)
        border_line_bottom := line.new(x1=bar_index - period - xlocation, y1=bottom, x2=bar_index + 1 - xlocation, y2=bottom, color=color.gray, width=4, style=line.style_solid)
        border_line_bottom

        // Draw horizontal levels
        var indi_lines = array.new_line(0) // keeps all lines including horizontal lines

        // 이전 수준선 삭제
        for i = 0 to array.size(indi_lines) - 1
            line.delete(array.get(indi_lines, i))
        array.clear(indi_lines)

        var indinamelabels = array.new_label(0)

        for x = 0 to (not na(array.get(levels, 0)) ? array.size(levels) - 1 : na)
            hline = line.new( x1 = bar_index - xlocation, y1 = getIndiLevel(array.get(levels, x), indimax, indimin, top, bottom),
                                             x2 = bar_index - period - xlocation, y2 = getIndiLevel(array.get(levels, x), indimax, indimin, top, bottom), 
                                             style = line.style_dashed)
            array.push(indi_lines, hline)

            array.push(indinamelabels, label.new(x = bar_index - xlocation - period + 5, y = getIndiLevel(array.get(levels, x), indimax, indimin, top, bottom), 
                                   text = str.tostring( array.get(levels, x)), 
                                   textcolor = color.blue,
                                   style = label.style_none))

        // Draw indicators
        numIndicators = array.size(indicatorValues)
        for i = 0 to numIndicators - 1
            indicatorValue = array.get(indicatorValues, i)
            indicatorColor = array.get(indicatorColors, i)

            for x = 0 to period - 1
                // Calculate Y coordinate using getIndiLevel()
                y1 = getIndiLevel(indicatorValue[x], indimax, indimin, top, bottom)
                y2 = getIndiLevel(indicatorValue[x + 1], indimax, indimin, top, bottom)

                // Draw indicator line
                array.push(indi_lines, line.new( x1 = bar_index - x - xlocation, y1 = y1,
                                             x2 = bar_index - x - 1 - xlocation, y2 = y2, 
                                             color = indicatorColor,
                                             width = lnwidth))

        var int lowestTimeframe = findLowestTimeframe(timeframes)
        var int labelIndex = findLabelIndex(timeframes, lowestTimeframe)

        // Add label for the indicator with the lowest timeframe
        if labelIndex != -1
            indicatorValue = array.get(indicatorValues, labelIndex)
            var string timeframeString = str.tostring(timeframes[labelIndex]) // Convert back to string for label
            
            // Get the color of the indicator for the label
            var color labelColor = color.blue // Default color
            if labelIndex < array.size(indicatorColors)
                labelColor := array.get(indicatorColors, labelIndex)
            
            indicatorName = title + " SMI (" + timeframeString + ")"

            y_offset = (top - bottom) * 0.1
            array.push(indinamelabels, label.new(x = bar_index - 15 - xlocation, y = top + y_offset, 
                                       text = indicatorName + " " + str.tostring(math.round(indicatorValue[0], precision)), 
                                       textcolor = labelColor,
                                       style = label.style_none))