//{
// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ INPUT ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

i_dbgN = input.int(1, "dbgN", inline = "")

i_clr = input.color(color.red, "Sample color", inline = "")
i_cell1W = input.int(80, "Width: cell 1", inline = "0")
i_cell2W = input.int(20, "cell 2", inline = "0")

i_From = input.int(0, "From", inline = "1")
i_To = input.int(1000, "To", inline = "1")
i_WrapTo = input.int(80, "Wrap to", inline = "1")
i_WrapPrefix=			input.string("", "Wrap: prefix"		, inline = "wrap")
i_WrapPostfix=			input.string("", "postfix"			, inline = "wrap")
i_MaxL = input.int(1000, "MaxLength", inline = "2")
i_Trunc = input.string("Left", "Truncate", options=["Left", "Right"], inline = "2")
ishowIDs = input.bool(false, "ShowIDs", tooltip = "Only has effect if iformatMap is empty")
iseparator=input.string(",", "Separator")
i_NaS=input.string("--", "NA placeholder", tooltip = "Text which is shown instead of na values.")
iformatMap=input.string("{0}: <{1}, {2}>", "Format string (maps)", tooltip = "args: id, key, val")

iFormatMap = iformatMap == "" ? string(na) : iformatMap

// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF INPUT  ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ }


// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ DEMO MAIN ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {


if bar_index == last_bar_index - 1
	// ---  test values --- {
	b = true 	// bool
	i = 1 		// int
	f = 1. 		// float
	s = "aaa"	// string
	lnB = line.new(bar_index - 3, low[3], bar_index, low, color = color.yellow)
	lnT = line.new(time[6], low[6], time[3], low[3], color = color.rgb(255, 148, 134), xloc = xloc.bar_time)
	lblB = label.new(bar_index,high, "test", color = color.yellow)
	lblT = label.new(time[6],high[6], "test", color = color.yellow, xloc = xloc.bar_time)
	bxB =  box.new(bar_index - 3, low[3], bar_index,low, text = "box", bgcolor = color.rgb(170, 237, 246, 57))
	bxT =  box.new(time[6], low[6], time[3], low[3], text = "box", bgcolor = color.rgb(243, 213, 169, 59), xloc = xloc.bar_time)


	arB = array.from(true,false)
	arI = array.from(10,20)
	arF = array.from(30,40.)
	arS = array.from("AAA","BBB")
	arC = array.from(color.red, #00bcd4)
	arLn = array.from(lnB,lnT)
	arLbl = array.from(lblB,lblT)
	arBx = array.from(bxB,bxT)
	arT = array.from(time,time[1])

		// --- float matrix --- 
	mxF = matrix.new<float>()
	mxF.add_row(0, arI)
	mxF.add_row(0, arF)
	mxF.add_row(0, array.from(float(na), -3.14))
	
	// --- color matrix --- 
	mxC = matrix.new<color>()
	mxC.add_row(0, arC)
	mxC.add_row(0, arC)
	//}

	// --- box matrix --- 
	mxBx = matrix.new<box>()
	mxBx.add_row(0, arBx)
	mxBx.add_row(0, arBx)
	//}

	txt = ""


 	// ━━━━━ test matrix.toStringMx() ━━━━━ {
	txt += "\n -------------- matrix.toStringMx () ------------------- \n"
	
	txt += "\n" + "matrix<int>	toStringMx():\n" + str.tostring(mxF.toStringMx(nz = "--"))

	txt += "\n --------------------------------- "
	txt += "\n" + "matrix<color>	toStringMx(HEX):\n" + str.tostring(mxC.toStringMx(format = "HEX"))
	
	txt += "\n --------------------------------- "
	txt += "\n" + "matrix<box>	toStringMx().toS():\n" + mxBx.toStringMx().toS()

	txt += "\n --------------------------------- "
	//}
	
	// ━━━━━ test matrix.toS() ━━━━━ {
	//}



	// --- draw table --- {
	// TEST ALL 
	t = table.new(position.bottom_center, 2, 1, bgcolor = color.rgb(245, 243, 149), border_color = color.black, border_width = 1, frame_color = color.black, frame_width = 1)
	table.cell(t,0,0, text_halign = text.align_left,width = i_cell1W, height = 100 , text_font_family = font.family_monospace)
	table.cell(t,1,0, text_halign = text.align_left,width = i_cell2W, height = 100 , text_font_family = font.family_monospace)

	table.cell_set_text(t, 0, 0, txt)
	// table.cell_set_text(t, 0, 0, txt)
	table.cell_set_text_size(t, 0, 0, size.tiny)

	table.cell_set_text(t, 1, 0, "")
	table.cell_set_text_size(t, 1, 0, size.tiny)

