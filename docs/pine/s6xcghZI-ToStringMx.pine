//@version=5

// @description Contains methods for conversion of matrices to string. 
// Supports matrices of int/float/bool/string/line/label/box/color types. 
// - toStringMx(matrix) - converts matrix to a string matrix by applying toS to each of its elements
// - toS(matrix) - converts the matrix to a string matrix (using toStringMx()) and outputs as string using str.tostring(matrix)
library("ToStringMx", overlay = false)
import moebius1977/ToS/1

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                          toStringMx()  FUNCTIONS                             ┃ {

// ━━━━━━ _toStringMatrix(<this, index_from, index_to, separator, format, _truncate) ━━━━━━ {
//{
//{
// @function Returns a string matrix made of original matrix items converted to string with toS().
// @param format (string) Like in str.format() with some shorthand options:
// ```
// --- number ---
// - "" 						 => "{0}"
// - "number"                    => "{0}"
// - "0"                         => "{0, number, 0       }"
// - "0.0"                       => "{0, number, 0.0      }"
// - "0.00"                      => "{0, number, 0.00     }"
// - "0.000"                     => "{0, number, 0.000    }"
// - "0.0000"                    => "{0, number, 0.0000   }"
// - "0.00000"                   => "{0, number, 0.00000  }"
// - "0.000000"                  => "{0, number, 0.000000 }"
// - "0.0000000"                 => "{0, number, 0.0000000}"
// --- date ---           	                       
// - "date"                      => "{0, date, dd.MM.YY}"
// - "date : time"               => "{0, date, dd.MM.YY} : {0, time, HH.mm.ss}"
// - "dd.MM"                     => "{0, date, dd:MM}"
// - "dd"                        => "{0, date, dd}"
// - "... <date> ... " in any place is substituted with "{0, date, dd.MM.YY}" 
// --- time ---           	                       
// - "time"                      => "{0, time, HH:mm:ss}"
// - "HH:mm"                     => "{0, time, HH:mm}"
// - "mm:ss"                     => "{0, time, mm:ss}"
// - "date time"                 => "{0, date, dd.MM.YY\} {0, time, HH.mm.ss}"
// - "date, time"                => "{0, date, dd.MM.YY\}, {0, time, HH.mm.ss}"
// - "date,time"                 => "{0, date, dd.MM.YY\},{0, time, HH.mm.ss}"
// - "date\ntime"                => "{0, date, dd.MM.YY\}\n{0, time, HH.mm.ss}"
// - "... <time> ... " in any place is substituted with "{0, time, HH.mm.ss}" 
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
_toStringMx(mx, string format = "", string nz = na) =>
    if na(mx)
        runtime.error("toStringMx: matrix is na")
    rs = mx.rows()
    cs = mx.columns()
	mxS = matrix.new<string>(rs, cs ,na)
    if rs > 0     
        while rs > 0  
            rs-=1 
            cs1 = cs
            while cs1 >0 
                cs1-=1    
                mxS.set( rs, cs1, ToS.toS(mx.get(rs, cs1), format, nz)    )
	mxS
// END OF _toStringMx() }

// ━━━━━━ toStringMx(matrix<bool> , format, nz) ━━━━━━ {
// @function Returns a string matrix made of original matrix items converted to string with toS().
// @param format (string) Like in str.format() 
// @param nz (string) If val is na and nz is not na the value of nz param is returned instead.
export method toStringMx(matrix<bool>     mx, string format = "", string nz = na) => _toStringMx(mx, format, nz)
//}

// ━━━━━━ toStringMx(matrix<int> , format, nz) ━━━━━━ {
//{
