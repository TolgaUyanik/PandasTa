//@version=6
indicator("HOLY UT BOT ", overlay=true, max_lines_count=50, max_labels_count=50)

// === UT Bot Settings ===
keyValue = input.float(2.0, "UT Bot Key Value")
atrPeriod = input.int(10, "UT Bot ATR Period")

// === TP / SL Settings ===
slMult = input.float(2.0, "SL ATR Multiplier")
tp1RR = input.float(1.0, "TP1")
tp2RR = input.float(2.0, "TP2")
tp3RR = input.float(3.0, "TP3")

// === EMA200 Filter ===
useEMA = input.bool(true, "Use EMA200 Filter")
emaLen = input.int(200, "EMA Length")

// === MACD Filter ===
useMACD = input.bool(true, "Use MACD Filter")
macdFast = input.int(12, "MACD Fast")
macdSlow = input.int(26, "MACD Slow")
macdSignalLen = input.int(9, "MACD Signal")

ema200 = ta.ema(close, emaLen)
plot(ema200, title="EMA200", color=color.orange, linewidth=2)

emaLongOk = not useEMA or close > ema200
emaShortOk = not useEMA or close < ema200

[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignalLen)
macdLongOk = not useMACD or macdLine > signalLine
macdShortOk = not useMACD or macdLine < signalLine

xATR = ta.atr(atrPeriod)
nLoss = keyValue * xATR

var float xATRTrailingStop = na
prevStop = nz(xATRTrailingStop[1], close)

if close > prevStop and close[1] > prevStop
    xATRTrailingStop := math.max(prevStop, close - nLoss)
else if close < prevStop and close[1] < prevStop
    xATRTrailingStop := math.min(prevStop, close + nLoss)
else if close > prevStop
    xATRTrailingStop := close - nLoss
else
    xATRTrailingStop := close + nLoss

utBuy = ta.crossover(close, xATRTrailingStop)
utSell = ta.crossunder(close, xATRTrailingStop)

longSignal = utBuy and emaLongOk and macdLongOk
shortSignal = utSell and emaShortOk and macdShortOk

var float alertEntry = na
var float alertTP1 = na
var float alertTP2 = na
var float alertTP3 = na
var float alertSL = na

var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na

var label entryLabel = na
var label slLabel = na
var label tp1Label = na
var label tp2Label = na
var label tp3Label = na

if longSignal or shortSignal
    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    label.delete(entryLabel)
    label.delete(slLabel)
    label.delete(tp1Label)
    label.delete(tp2Label)
    label.delete(tp3Label)

if longSignal
    alertEntry := close
    alertSL := alertEntry - xATR * slMult
    risk = alertEntry - alertSL
    alertTP1 := alertEntry + risk * tp1RR
    alertTP2 := alertEntry + risk * tp2RR
    alertTP3 := alertEntry + risk * tp3RR

    entryLine := line.new(bar_index, alertEntry, bar_index + 30, alertEntry, color=color.white, width=2)
    slLine := line.new(bar_index, alertSL, bar_index + 30, alertSL, color=color.red, width=2)
    tp1Line := line.new(bar_index, alertTP1, bar_index + 30, alertTP1, color=color.green, width=2)
    tp2Line := line.new(bar_index, alertTP2, bar_index + 30, alertTP2, color=color.green, width=2)
    tp3Line := line.new(bar_index, alertTP3, bar_index + 30, alertTP3, color=color.green, width=2)

    entryLabel := label.new(bar_index + 30, alertEntry, "LONG\n" + str.tostring(alertEntry, format.mintick), style=label.style_label_left, color=color.white, textcolor=color.black)
    slLabel := label.new(bar_index + 30, alertSL, "SL\n" + str.tostring(alertSL, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white)
    tp1Label := label.new(bar_index + 30, alertTP1, "TP1\n" + str.tostring(alertTP1, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)
    tp2Label := label.new(bar_index + 30, alertTP2, "TP2\n" + str.tostring(alertTP2, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)
    tp3Label := label.new(bar_index + 30, alertTP3, "TP3\n" + str.tostring(alertTP3, format.mintick), style=label.style_label_left, color=color.green, textcolor=color.white)

if shortSignal
    alertEntry := close
    alertSL := alertEntry + xATR * slMult
    risk = alertSL - alertEntry
    alertTP1 := alertEntry - risk * tp1RR
    alertTP2 := alertEntry - risk * tp2RR
    alertTP3 := alertEntry - risk * tp3RR

    entryLine := line.new(bar_index, alertEntry, bar_index + 30, alertEntry, color=color.white, width=2)
    slLine := line.new(bar_index, alertSL, bar_index + 30, alertSL, color=color.red, width=2)
    tp1Line := line.new(bar_index, alertTP1, bar_index + 30, alertTP1, color=color.red, width=2)
    tp2Line := line.new(bar_index, alertTP2, bar_index + 30, alertTP2, color=color.red, width=2)
    tp3Line := line.new(bar_index, alertTP3, bar_index + 30, alertTP3, color=color.red, width=2)

    entryLabel := label.new(bar_index + 30, alertEntry, "SHORT\n" + str.tostring(alertEntry, format.mintick), style=label.style_label_left, color=color.white, textcolor=color.black)
    slLabel := label.new(bar_index + 30, alertSL, "SL\n" + str.tostring(alertSL, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white)
    tp1Label := label.new(bar_index + 30, alertTP1, "TP1\n" + str.tostring(alertTP1, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white)
    tp2Label := label.new(bar_index + 30, alertTP2, "TP2\n" + str.tostring(alertTP2, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white)
    tp3Label := label.new(bar_index + 30, alertTP3, "TP3\n" + str.tostring(alertTP3, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white)

plotshape(longSignal, title="BUY", text="BUY", style=shape.labelup, location=location.belowbar, color=color.rgb(26, 174, 233, 47), textcolor=color.white, size=size.tiny)
plotshape(shortSignal, title="SELL", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.rgb(235, 38, 146, 36), textcolor=color.white, size=size.tiny)

plot(alertEntry, title="ENTRY", display=display.none)
plot(alertTP1, title="TP1", display=display.none)
plot(alertTP2, title="TP2", display=display.none)
plot(alertTP3, title="TP3", display=display.none)
plot(alertSL, title="SL", display=display.none)

alertcondition(longSignal, title="UT BOT LONG", message="UT BOT LONG")
alertcondition(shortSignal, title="UT BOT SHORT", message="UT BOT SHORT")
