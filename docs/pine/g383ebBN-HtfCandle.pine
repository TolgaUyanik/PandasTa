//@version=6
library("HtfCandle")

// ╔════════════════════════════════════════════╗
// ║              TYPES & STATE                 ║
// ╚════════════════════════════════════════════╝

export type HtfCandle
    int bar_index
    int time
    float open
    float high
    float low
    float close
    bool isNew
    int highTime
    int lowTime
    float bodyHigh
    float bodyLow

export type HtfOpts
    string timeframe
    int numCandles

export type HtfState
    HtfCandle candle
    HtfCandle candle1
    int numCandles

    int currentTime
    int currentBarIndex
    float currentOpen

    float currentHigh
    float currentLow
    float currentBodyHigh
    float currentBodyLow

    int currentHighTime
    int currentLowTime

    array<float> highHistory
    array<float> lowHistory
    array<float> bodyHighHistory
    array<float> bodyLowHistory

// ╔════════════════════════════════════════════╗
// ║                 INIT STATE                 ║
// ╚════════════════════════════════════════════╝

export initCandle() =>

    candle = HtfCandle.new()
    candle.bar_index := na
    candle.time := na
    candle.open := na
    candle.high := na
    candle.low := na
    candle.close := na
    candle.isNew := false
    candle.highTime := na
    candle.lowTime := na
    candle.bodyHigh := na
    candle.bodyLow := na
    candle

export initOpts(string timeframe, int numCandles = 50) =>

    opts = HtfOpts.new()
    opts.timeframe := timeframe
    opts.numCandles := numCandles
    opts

export initState(HtfOpts opts) =>

    state = HtfState.new()
    state.candle := initCandle()
    state.candle1 := initCandle()
    state.numCandles := opts.numCandles

    state.currentTime := na
    state.currentBarIndex := 0
    state.currentOpen := na

    state.currentHigh := na
    state.currentLow := na
    state.currentBodyHigh := na
    state.currentBodyLow := na

    state.currentHighTime := na
    state.currentLowTime := na

    state.highHistory := array.new<float>(opts.numCandles, na)
    state.lowHistory := array.new<float>(opts.numCandles, na)
    state.bodyHighHistory := array.new<float>(opts.numCandles, na)
    state.bodyLowHistory := array.new<float>(opts.numCandles, na)

    state

// ╔════════════════════════════════════════════╗
// ║               UPDATE METHODS               ║
// ╚════════════════════════════════════════════╝

method _seedCurrent(HtfState state, float candleHigh, float candleLow, int candleTime, float candleBodyHigh, float candleBodyLow) =>

    state.currentHigh := candleHigh
    state.currentLow := candleLow
    state.currentHighTime := candleTime
    state.currentLowTime := candleTime
    state.currentBodyHigh := candleBodyHigh
    state.currentBodyLow := candleBodyLow

method _updateCurrent(HtfState state, float candleHigh, float candleLow, int candleTime, float candleBodyHigh, float candleBodyLow) =>

    if candleHigh > state.currentHigh
        state.currentHigh := candleHigh
        state.currentHighTime := candleTime

    if candleLow < state.currentLow
        state.currentLow := candleLow
        state.currentLowTime := candleTime

    if candleBodyHigh > state.currentBodyHigh
        state.currentBodyHigh := candleBodyHigh

    if candleBodyLow < state.currentBodyLow
        state.currentBodyLow := candleBodyLow

method _seedOrUpdateCurrent(HtfState state, float candleHigh, float candleLow, int candleTime, float candleBodyHigh, float candleBodyLow) =>

    if na(state.currentHigh)
        state._seedCurrent(candleHigh, candleLow, candleTime, candleBodyHigh, candleBodyLow)
    else
        state._updateCurrent(candleHigh, candleLow, candleTime, candleBodyHigh, candleBodyLow)

// Updates HTF bucket extremes from LTF bars.
// Uses strict > and < so first occurrence time is preserved for equal highs/lows.
// Use state.candle.isNew to detect when a new HTF candle starts forming.
export method update(HtfState state, HtfOpts opts) =>

    string tfResolved = opts.timeframe
    bool newResolvedTfBar = ta.change(time(tfResolved)) != 0

    candleHigh = high[1]
    candleLow = low[1]
    candleTime = time[1]
    candleOpen = open[1]
    candleClose = close[1]
    candleBodyHigh = math.max(candleOpen, candleClose)
    candleBodyLow = math.min(candleOpen, candleClose)

    state._seedOrUpdateCurrent(candleHigh, candleLow, candleTime, candleBodyHigh, candleBodyLow)
    state.candle.isNew := newResolvedTfBar

    if newResolvedTfBar

        // Save current candle to candle1
        state.candle1.isNew := false
        state.candle1.time := state.candle.time
        state.candle1.open := state.candle.open
        state.candle1.high := state.candle.high
        state.candle1.low := state.candle.low
        state.candle1.close := state.candle.close
        state.candle1.bar_index := state.candle.bar_index
        state.candle1.highTime := state.candle.highTime
        state.candle1.lowTime := state.candle.lowTime
        state.candle1.bodyHigh := state.candle.bodyHigh
        state.candle1.bodyLow := state.candle.bodyLow

        // Finalize current bucket into candle
        state.candle.isNew := true
        state.candle.time := state.currentTime
        state.candle.open := state.currentOpen
        state.candle.high := state.currentHigh
        state.candle.low := state.currentLow
        state.candle.close := candleClose
        state.candle.bar_index := state.currentBarIndex
        state.candle.highTime := state.currentHighTime
        state.candle.lowTime := state.currentLowTime
        state.candle.bodyHigh := math.max(state.currentOpen, candleClose)
        state.candle.bodyLow := math.min(state.currentOpen, candleClose)

        // Store in history arrays
        array.push(state.highHistory, state.candle.high)
        array.shift(state.highHistory)
        array.push(state.lowHistory, state.candle.low)
        array.shift(state.lowHistory)
        array.push(state.bodyHighHistory, state.candle.bodyHigh)
        array.shift(state.bodyHighHistory)
        array.push(state.bodyLowHistory, state.candle.bodyLow)
        array.shift(state.bodyLowHistory)

        // Reset current bucket; next bar will seed from [1]
        state.currentHigh := na
        state.currentLow := na
        state.currentHighTime := na
        state.currentLowTime := na
        state.currentBodyHigh := na
        state.currentBodyLow := na

        state.currentTime := time
        state.currentOpen := open
        state.currentBarIndex := state.currentBarIndex + 1

// ╔════════════════════════════════════════════╗
// ║           CALCULATION METHODS              ║
// ╚════════════════════════════════════════════╝

// Calculate highest value from history for last numCandles bars
// Returns na if insufficient data
export method highest(HtfState state) =>

    int n = state.numCandles
    if n <= 0 or array.size(state.highHistory) < n
        na
    else
        float maxVal = na
        for i = 1 to n
            val = array.get(state.highHistory, -i)
            if not na(val)
                maxVal := na(maxVal) ? val : math.max(maxVal, val)
        maxVal

// Calculate lowest value from history for last numCandles bars
// Returns na if insufficient data
export method lowest(HtfState state) =>

    int n = state.numCandles
    if n <= 0 or array.size(state.lowHistory) < n
        na
    else
        float minVal = na
        for i = 1 to n
            val = array.get(state.lowHistory, -i)
            if not na(val)
                minVal := na(minVal) ? val : math.min(minVal, val)
        minVal

// Calculate highest body high from history for last numCandles bars
// Returns na if insufficient data
export method bodyHighest(HtfState state) =>

    int n = state.numCandles
    if n <= 0 or array.size(state.bodyHighHistory) < n
        na
    else
        float maxVal = na
        for i = 1 to n
            val = array.get(state.bodyHighHistory, -i)
            if not na(val)
                maxVal := na(maxVal) ? val : math.max(maxVal, val)
        maxVal

// Calculate lowest body low from history for last numCandles bars
// Returns na if insufficient data
export method bodyLowest(HtfState state) =>

    int n = state.numCandles
    if n <= 0 or array.size(state.bodyLowHistory) < n
        na
    else
        float minVal = na
        for i = 1 to n
            val = array.get(state.bodyLowHistory, -i)
            if not na(val)
                minVal := na(minVal) ? val : math.min(minVal, val)
        minVal
