////# Function Definitions 
////////////////////////////////////////////////////////////////////{
//@function                 Returns the one-bar change percentage of the source.
// This function calculates the percentage change of a given source value compared to its previous value.
changePercent(float source) => 100.0 * (source - source[1]) / source[1]


// This function calculates the Kelly Ratio, which is a formula used to determine the optimal size of a series of bets.
// @param returns        An array of floats representing the returns from bets.
// @returns              The calculated Kelly Ratio, which indicates the optimal bet size based on winning and losing probabilities.
export calculateKellyRatio(float[] returns) =>
    float winCount = 0.0
    float lossCount = 0.0
    float totalWinReturn = 0.0
    float totalLossReturn = 0.0
    int n = array.size(returns)
    for i = 0 to n - 1
        float ret = array.get(returns, i)
        if ret > 0
            winCount += 1
            totalWinReturn += ret
        else if ret < 0
            lossCount += 1
            totalLossReturn += math.abs(ret)
    float winProb = (winCount + lossCount) > 0 ? winCount / (winCount + lossCount) : 0.0
    float lossProb = 1 - winProb
    float avgWinReturn = winCount > 0 ? totalWinReturn / winCount : 0.0
    float avgLossReturn = lossCount > 0 ? totalLossReturn / lossCount : 0.0
    float kellyRatio = 0.0
    if avgLossReturn != 0 and avgWinReturn != 0
        float odds = avgWinReturn / avgLossReturn
        if odds != 0
            kellyRatio := winProb - (lossProb / odds)
    kellyRatio

// This function calculates the adjusted Kelly Fraction based on Kelly Ratio, risk tolerance, and Fed stance.
// @param kellyRatio     The calculated Kelly Ratio.
// @param riskTolerance   A float representing the risk tolerance level.
// @param fedStance      A string indicating the Federal Reserve's stance ("dovish", "hawkish", or neutral).
// @returns              The adjusted Kelly Fraction, constrained within the bounds of [-1, 1].
export calculateAdjustedKellyFraction(float kellyRatio, float riskTolerance, string fedStance) =>
    // Adjust Kelly Fraction based on risk tolerance
    float adjustedKellyFraction = kellyRatio * riskTolerance
    // Adjust based on Fed stance
    float kellyAdjustment = fedStance == "dovish" ? 0.1 : fedStance == "hawkish" ? -0.1 : 0.0
    adjustedKellyFraction := adjustedKellyFraction + kellyAdjustment
    // Ensure Kelly fraction is within bounds [-1, 1]
    adjustedKellyFraction := math.max(math.min(adjustedKellyFraction, 1), -1)
    adjustedKellyFraction

// This function sums the elements of a float array.
// @param arr   An array of floats to be summed.
// @returns     The total sum of the array elements.
sumArray(float[] arr) =>
    float total = 0.0
    for i = 0 to array.size(arr) - 1
        total += array.get(arr, i)
    total

// This function calculates the standard deviation of an array of returns.
// Standard deviation measures the amount of variation or dispersion of a set of values.
// @param returns        An array of floats representing the returns.
// @returns              The standard deviation of the returns, or 0 if insufficient data.
export calculateStdDev(float[] returns) =>
    int count = array.size(returns)
    if count > 1
        float avg = sumArray(returns) / count
        float sumSqDiffs = 0.0
        for i = 0 to count - 1
            float val = array.get(returns, i)
            float diff = val - avg
            sumSqDiffs += diff * diff
        float variance = sumSqDiffs / (count - 1)
        math.sqrt(variance)
    else
        0.0


// This function calculates the maximum drawdown from an array of returns.
// Maximum drawdown is the largest drop from a peak to a trough in the value of an investment.
// @param returns        An array of floats representing the returns.
// @returns              The maximum drawdown as a percentage.
export calculateMaxDrawdown(float[] returns) =>
    float peak = 1.0  // Start with initial equity of 1.0 (or 100%)
    float maxDD = 0.0
    float cumulativeReturn = 1.0
    for i = 0 to array.size(returns) - 1
        cumulativeReturn := cumulativeReturn * (1 + array.get(returns, i) / 100)  // Convert percent to decimal
        if cumulativeReturn > peak
            peak := cumulativeReturn  // Update peak if current value exceeds it
        float drawdown = (peak - cumulativeReturn) / peak  // Calculate drawdown
        if drawdown > maxDD
            maxDD := drawdown  // Update maximum drawdown if current drawdown is greater
    maxDD * 100  // Return as percentage

// This function calculates the Expected Value (EV) of a bet based on average win return, win probability, and average loss return.
// Expected Value is a measure of the average outcome of a bet if it were repeated many times.
// @param avgWinReturn   The average return from winning bets.
// @param winProb        The probability of winning a bet.
// @param avgLossReturn  The average return from losing bets.
// @returns              The calculated Expected Value of the bet.
export calculateEV(float avgWinReturn, float winProb, float avgLossReturn) =>
    (winProb * avgWinReturn) + ((1 - winProb) * (-avgLossReturn))  // Calculate EV

// This function calculates the Tail Ratio, which is a measure of the risk of extreme losses in a distribution of returns.
// It sorts the returns and finds the 95th and 5th percentiles, returning the ratio of the 95th percentile to the absolute value of the 5th percentile.
// @param returns        An array of floats representing the returns.
// @returns              The Tail Ratio, or na if the 5th percentile is zero to avoid division by zero.
export calculateTailRatio(float[] returns) =>
    array.sort(returns)  // Sort the returns array
    int n = array.size(returns)
    float tail95 = array.get(returns, int(n * 0.95) - 1)  // 95th percentile
    float tail5 = array.get(returns, int(n * 0.05))  // 5th percentile
    tail5 != 0 ? tail95 / math.abs(tail5) : na  // Avoid division by zero

// This function calculates the Sharpe Ratio, which is a measure of risk-adjusted return.
// It compares the average return of an investment to its standard deviation, adjusted for a risk-free rate.
// @param avgReturn      The average return of the investment.
// @param riskFreeRate   The risk-free rate of return.
// @param stdDev         The standard deviation of the investment's returns.
// @returns              The calculated Sharpe Ratio, or na if standard deviation is zero.
export calculateSharpeRatio(float avgReturn, float riskFreeRate, float stdDev) =>
    stdDev != 0 ? (avgReturn - riskFreeRate) / stdDev : na  // Calculate Sharpe Ratio

// This function calculates the Downside Deviation, which measures the risk of negative returns.
// It computes the average return and then calculates the standard deviation of returns that fall below this average.
// @param returns        An array of floats representing the returns.
// @returns              The standard deviation of the downside returns, or 0 if no downside returns exist.
export calculateDownsideDeviation(float[] returns) =>
    float downsideSum = 0.0
    int downsideCount = 0
    float avgReturn = sumArray(returns) / array.size(returns)  // Calculate average return
    for i = 0 to array.size(returns) - 1
        if array.get(returns, i) < avgReturn  // Check if return is below average
            downsideSum += math.pow(avgReturn - array.get(returns, i), 2)  // Sum squared deviations
            downsideCount += 1  // Count number of downside returns
    downsideCount > 0 ? math.sqrt(downsideSum / downsideCount) : 0.0  // Return standard deviation of downside returns

// This function calculates the Sortino Ratio, which is a variation of the Sharpe Ratio that only considers downside risk.
// It compares the average return to the downside deviation.
// @param avgReturn          The average return of the investment.
// @param downsideDeviation   The standard deviation of the downside returns.
// @returns                  The calculated Sortino Ratio, or na if downside deviation is zero.
export calculateSortinoRatio(float avgReturn, float downsideDeviation) =>
    downsideDeviation != 0 ? avgReturn / downsideDeviation : na  // Calculate Sortino Ratio

// This function calculates the Value at Risk (VaR), which estimates the potential loss in value of an asset over a defined period for a given confidence interval.
// It sorts the returns and finds the return at the specified confidence level.
// @param returns          An array of floats representing the returns.
// @param confidenceLevel  A float representing the confidence level (e.g., 0.95 for 95% confidence).
// @returns                The Value at Risk at the specified confidence level.
export calculateVaR(float[] returns, float confidenceLevel) =>
    array.sort(returns)  // Sort the returns
    int index = int(array.size(returns) * (1 - confidenceLevel))  // Calculate index for VaR
    array.get(returns, index)  // Return the VaR value

// This function calculates the Conditional Value at Risk (CVaR), which provides the expected loss given that a loss is beyond the VaR threshold.
// It averages the returns that are less than or equal to the VaR value.
// @param returns        An array of floats representing the returns.
// @param varValue       The Value at Risk threshold.
// @returns              The average Conditional Value at Risk, or na if no returns are below the threshold.
export calculateCVaR(float[] returns, float varValue) =>
    float cvarSum = 0.0
    int count = 0
    for i = 0 to array.size(returns) - 1
        if array.get(returns, i) <= varValue  // Check if return is less than or equal to VaR
            cvarSum += array.get(returns, i)  // Sum the returns
            count += 1  // Count the number of returns
    count > 0 ? cvarSum / count : na  // Return average CVaR or na if no returns

// This function calculates the expected price range based on Expected Value (EV) and standard deviation.
// @param currentPrice     The current price of the asset.
// @param ev               The expected value (in percentage terms).
// @param stdDev           The standard deviation (in percentage terms).
// @param confidenceLevel  The confidence level for the price range (e.g., 1.96 for 95% confidence).
// @returns               A tuple containing the minimum and maximum expected prices.
export calculateExpectedPriceRange(float currentPrice, float ev, float stdDev, float confidenceLevel) =>
    float expectedPriceChange = currentPrice * (1 + ev / 100)  // Convert EV to decimal
    float minPrice = expectedPriceChange - (confidenceLevel * stdDev / 100 * currentPrice)
    float maxPrice = expectedPriceChange + (confidenceLevel * stdDev / 100 * currentPrice)
    [minPrice, maxPrice]


// This function calculates the rolling standard deviation of returns over a specified window.
// @param returns   An array of floats representing the returns.
// @param window    An integer representing the rolling window size.
// @returns        An array of floats representing the rolling standard deviation of returns.
export calculateRollingStdDev(float[] returns, int window) =>
    float[] rollingStdDev = array.new_float(0)
    for i = 0 to array.size(returns) - 1
        if i >= window - 1
            float sum = 0.0
            for j = 0 to window - 1
                sum += array.get(returns, i - j)
            float mean = sum / window
            float varianceSum = 0.0
            for j = 0 to window - 1
                varianceSum += math.pow(array.get(returns, i - j) - mean, 2)
            array.push(rollingStdDev, math.sqrt(varianceSum / window))
        else
            array.push(rollingStdDev, na)
    rollingStdDev

// This function calculates the rolling variance of returns over a specified window.
// @param returns   An array of floats representing the returns.
// @param window    An integer representing the rolling window size.
// @returns        An array of floats representing the rolling variance of returns.
export calculateRollingVariance(float[] returns, int window) =>
    float[] rollingVariance = array.new_float(0)
    for i = 0 to array.size(returns) - 1
        if i >= window - 1
            float sum = 0.0
            for j = 0 to window - 1
                sum += array.get(returns, i - j)
            float mean = sum / window
            float varianceSum = 0.0
            for j = 0 to window - 1
                varianceSum += math.pow(array.get(returns, i - j) - mean, 2)
            array.push(rollingVariance, varianceSum / window)
        else
            array.push(rollingVariance, na)
    rollingVariance

// This function calculates the rolling mean of returns over a specified window.
// @param returns   An array of floats representing the returns.
// @param window    An integer representing the rolling window size.
// @returns        An array of floats representing the rolling mean of returns.
export calculateRollingMean(float[] returns, int window) =>
    float[] rollingMean = array.new_float(0)
    for i = 0 to array.size(returns) - 1
        if i >= window - 1
            float sum = 0.0
            for j = 0 to window - 1
                sum += array.get(returns, i - j)
            array.push(rollingMean, sum / window)
        else
            array.push(rollingMean, na)
    rollingMean

// This function calculates the rolling coefficient of variation of returns over a specified window.
// @param returns   An array of floats representing the returns.
// @param window    An integer representing the rolling window size.
// @returns        An array of floats representing the rolling coefficient of variation of returns.
export calculateRollingCoefficientOfVariation(float[] returns, int window) =>
    float[] rollingCV = array.new_float(0)
    for i = 0 to array.size(returns) - 1
        if i >= window - 1
            float stdDev = array.get(calculateRollingStdDev(returns, window), i)
            float mean = array.get(calculateRollingMean(returns, window), i)
            array.push(rollingCV, mean != 0 ? stdDev / mean : na)
        else
            array.push(rollingCV, na)
    rollingCV



// This function calculates the rolling sum of percent returns over a specified window.
// @param returns   An array of floats representing the returns.
// @param window    An integer representing the rolling window size.
// @returns        An array of floats representing the rolling sum of percent returns.
export calculateRollingSumOfPercentReturns(float[] returns, int window) =>
    float[] rollingSum = array.new_float(0)
    for i = 0 to array.size(returns) - 1
        if i >= window - 1
            float sum = 0.0
            for j = 0 to window - 1
                sum += array.get(returns, i - j)
            array.push(rollingSum, sum)
        else
            array.push(rollingSum, na)
    rollingSum

// This function calculates the rolling cumulative product (compounded returns) over a specified window.
// @param returns   An array of floats representing the returns.
// @param window    An integer representing the rolling window size.
// @returns        An array of floats representing the rolling cumulative product of returns.
export calculateRollingCumulativeProduct(float[] returns, int window) =>
    float[] rollingCumulativeProduct = array.new_float(0)
    for i = 0 to array.size(returns) - 1
        if i >= window - 1
            float product = 1.0
            for j = 0 to window - 1
                product *= (1 + array.get(returns, i - j))
            array.push(rollingCumulativeProduct, product - 1) // Subtract 1 to get the growth
        else
            array.push(rollingCumulativeProduct, na)
    rollingCumulativeProduct

// This function calculates the rolling correlation between price and volume percent changes over a specified window.
// @param priceReturns   An array of floats representing the price returns.
// @param volumeReturns  An array of floats representing the volume returns.
// @param window         An integer representing the rolling window size.
// @returns             An array of floats representing the rolling correlation.
export calculateRollingCorrelation(float[] priceReturns, float[] volumeReturns, int window) =>
    float[] rollingCorrelation = array.new_float(0)
    for i = 0 to array.size(priceReturns) - 1
        if i >= window - 1
            float priceSum = 0.0
            float volumeSum = 0.0
            float priceMean = 0.0
            float volumeMean = 0.0
            for j = 0 to window - 1
                priceSum += array.get(priceReturns, i - j)
                volumeSum += array.get(volumeReturns, i - j)
            priceMean := priceSum / window
            volumeMean := volumeSum / window
            
            float covariance = 0.0
            float priceVariance = 0.0
            float volumeVariance = 0.0
            
            for j = 0 to window - 1
                covariance += (array.get(priceReturns, i - j) - priceMean) * (array.get(volumeReturns, i - j) - volumeMean)
                priceVariance += math.pow(array.get(priceReturns, i - j) - priceMean, 2)
                volumeVariance += math.pow(array.get(volumeReturns, i - j) - volumeMean, 2)
                
            correlation = priceVariance != 0 and volumeVariance != 0 ? covariance / math.sqrt(priceVariance * volumeVariance) : na
            array.push(rollingCorrelation, correlation)
        else
            array.push(rollingCorrelation, na)
    rollingCorrelation

// This function calculates the rolling percentile of returns over a specified window.
// @param returns   An array of floats representing the returns.
// @param window    An integer representing the rolling window size.
// @param percentile An integer representing the desired percentile (0-100).
// @returns        An array of floats representing the rolling percentile of returns.
export calculateRollingPercentile(float[] returns, int window, int percentile) =>
    float[] rollingPercentile = array.new_float(0)
    for i = 0 to array.size(returns) - 1
        if i >= window - 1
            float[] windowReturns = array.new_float(0)
            for j = 0 to window - 1
                array.push(windowReturns, array.get(returns, i - j))
            array.sort(windowReturns)
            int index = int(array.size(windowReturns) * (percentile / 100.0))
            array.push(rollingPercentile, array.get(windowReturns, math.min(index, array.size(windowReturns) - 1)))
        else
            array.push(rollingPercentile, na)
    rollingPercentile

// This function calculates the rolling max/min percent returns over a specified window.
// @param returns   An array of floats representing the returns.
// @param window    An integer representing the rolling window size.
// @returns        A tuple containing two arrays: rolling max and rolling min percent returns.
export calculateRollingMaxMinPercentReturns(float[] returns, int window) =>
    float[] rollingMax = array.new_float(0)
    float[] rollingMin = array.new_float(0)
    for i = 0 to array.size(returns) - 1
        if i >= window - 1
            float maxReturn = array.get(returns, i - window + 1)
            float minReturn = array.get(returns, i - window + 1)
            for j = 0 to window - 1
                maxReturn := math.max(maxReturn, array.get(returns, i - j))
                minReturn := math.min(minReturn, array.get(returns, i - j))
            array.push(rollingMax, maxReturn)
            array.push(rollingMin, minReturn)
        else
            array.push(rollingMax, na)
            array.push(rollingMin, na)
    [rollingMax, rollingMin]

// This function calculates the rolling price-to-volume ratio (PVR) over a specified window.
// @param price   An array of floats representing the price data.
// @param volData  An array of floats representing the volume data.
// @param window  An integer representing the rolling window size.
// @returns      An array of floats representing the rolling price-to-volume ratio.
export calculateRollingPriceToVolumeRatio(float[] price, float[] volData, int window) =>
    float[] rollingPVR = array.new_float(0)
    for i = 0 to array.size(price) - 1
        if i >= window - 1
            float sumPrice = 0.0
            float sumVolume = 0.0
            for j = 0 to window - 1
                sumPrice += array.get(price, i - j)
                sumVolume += array.get(volData, i - j)
            array.push(rollingPVR, sumVolume != 0 ? sumPrice / sumVolume : na)
        else
            array.push(rollingPVR, na)
    rollingPVR

    // This function determines the market regime based on price changes.
// @param priceChanges   An array of floats representing the price changes.
// @returns             A string indicating the market regime ("Bull", "Bear", or "Neutral").
export determineMarketRegime(float[] priceChanges) =>
	regime = "Neutral"
	float threshold = 0.02 // 2% change
	if array.size(priceChanges) > 0
		float lastChange = array.get(priceChanges, array.size(priceChanges) - 1)
		if lastChange > threshold
			regime := "Bull"
		else if lastChange < -threshold
			regime := "Bear"
        regime

    // This function calculates the volatility regime based on standard deviation.
// @param price   An array of floats representing the price data.
// @param window  An integer representing the rolling window size.
// @returns      An array of floats representing the calculated volatility.
export determineVolatilityRegime(float[] price, int window) =>
	float[] volatility = array.new_float(0)
	for i = 0 to array.size(price) - 1
		if i >= window - 1
			float sum = 0.0
			for j = 0 to window - 1
				sum += array.get(price, i - j)
			float mean = sum / window
			float sumSqDiff = 0.0
			for j = 0 to window - 1
				sumSqDiff += math.pow(array.get(price, i - j) - mean, 2)
			float stdDev = math.sqrt(sumSqDiff / window)
			array.push(volatility, stdDev)
		else
			array.push(volatility, na)
	volatility

    // This function classifies the volatility regime.
// @param volatility   An array of floats representing the calculated volatility.
// @returns           A string indicating the volatility regime ("Low" or "High").
export classifyVolatilityRegime(float[] volatility) =>
	string volatilityRegime = "Low"
	if array.size(volatility) > 0
		float lastVolatility = array.get(volatility, array.size(volatility) - 1)
		if lastVolatility > 1.0 // Example threshold for high volatility
			volatilityRegime := "High"
	volatilityRegime


//@function                 Returns the percentage of positive non-na values in this array.
// This method calculates the percentage of positive values in the provided array, ignoring NA values.
export method percentPositive(array<float> thisArray) =>
    int nonNA = 0
    int pos   = 0
    for item in thisArray
        if not na(item)
            nonNA += 1
            if item >= 0
                pos += 1
    float result = nonNA > 0 ? 100.0 * pos / nonNA : na
    result





////////////////////////////////////////////////////////////////////
// Candle Utilities
////////////////////////////////////////////////////////////////////{
// @returns a series of floats, representing the difference between the high and low
export _candleRange() => high - low

// @param barsback An integer representing how far back you want to get a range
export _PreviousCandleRange(int barsback) => high[barsback] - low[barsback]

// @returns true if close < open
export redCandle() => close < open
// @returns true if close > open
export greenCandle() => close > open
// @returns true if open < close
export _WhiteBody() => open < close
// @returns true if open > close
export _BlackBody() => open > close

// @returns a series of floats representing the high - open
export HighOpenDiff() => high - open
// @returns a series of floats representing the open - low
export OpenLowDiff() => open - low

// @returns a series of bools, after checking if close was greater or equal to previous open
export _isCloseAbovePreviousOpen(int length) => close >= open[length]
// @returns a series of bools.
export _isCloseBelowPrevious() => close <= close[1]
// @returns a series of bools, after checking if close was greater or equal to previous open
export _isOpenGreaterThanPrevious() => open >= close[1]
// @returns a series of bools, after checking if open was less than or equal to previous close.
export _isOpenLessThanPrevious() => open <= close[1] // previous _WhiteBody?

export BodyHigh() => math.max(close, open)

export BodyLow() => math.min(close, open)

// @returns a series of floats, each of which are the difference between the top and bottom per candle.
export _candleBody() => BodyHigh() - BodyLow()

// @function _BodyAvg function. 
// @param length Required (recommended is 6). 
export _BodyAvg(int length) => ta.ema(_candleBody(), length)

// @returns a series of bools, after checking if the candle body was less than body average.
// @param length Length of the slow EMA
export _SmallBody(int length) => _candleBody() < _BodyAvg(length)

// @returns a series of bools, after checking if the candle body was greater than body average.
export _LongBody(int length) => _candleBody() > _BodyAvg(length)


////////////////////////////////////////////////////////////////////
////# Wick Utilities
////////////////////////////////////////////////////////////////////{
// This Indicator measures the wick parts of candles and sum it up. 
// Wick part of candle is a sign of strength that's why it measures the 60 bars of candles wick. then sum it up and converted it in percentage. 
// The output is indicated in the last 10 candles. that's how simple this indicator is but very useful to analyze the strength of every candles.
// The upper numbers is the bear power.
// The lower numbers is the bull power.

// @function bearWick() function. 
// @returns a SERIES of FLOATS, checks if it's a blackBody(open > close), if it is, than check the difference between the high and open, else checks the difference between high and close.
export bearWick()   => high - (_BlackBody() ? open : close)

// @returns a SERIES of FLOATS, checks if it's a whiteBody(open < close), if it is, than check the difference of OPEN & LOW (open - close), else checks the difference of OPEN & low (open - low).
export bullWick()   => (_WhiteBody() ? open : close) - low

// @returns a SERIES of FLOATS, checks if the candle is green, than check the difference of CLOSE & OPEN (close - open), else checks the difference of OPEN & CLOSE (open - close).
export barlength()  => greenCandle() ? close - open : open - close

export sumbarlength()    => math.sum(barlength(), 60)
export sumbull()         => math.sum(bearWick(), 60) / sumbarlength() * 100
export sumbear()         => math.sum(bullWick(), 60) / sumbarlength() * 100

////# Constants for volume fight

export bull_vol() => _WhiteBody() ? volume : volume * (HighOpenDiff() ) / ( _candleRange() )  
export bear_vol() => _BlackBody() ? volume : volume * (OpenLowDiff()  ) / ( _candleRange() )

// @returns simple int, which is dynamically smoothed based on the timeframe. On higher TF such as the hourly or daily we only look 11 bars back, on smaller tf, we use 50 bars.
export volumeFightMA() => timeframe.isdaily ? 11 : 50

// Smoothing to reduce false signals and highlight the flat zone. 
export volumeFightDelta() => 15

// Global variables to store calculated values for consistency
var float bullVolumeAvg = na
var float bearVolumeAvg = na
var float flatFilterBull = na
var float flatFilterBear = na

// @returns a series of floats, based off volume-weighted moving averages (vwma) with bull_vol() as a source and volumeFightMA() as the length
export weightedAVG_BullVolume() => ta.vwma(bull_vol() , volumeFightMA() )

// @returns a series of floats, based off volume-weighted moving averages (vwma) with bear_vol() as a source and volumeFightMA() as the length
export weightedAVG_BearVolume() => ta.vwma(bear_vol() , volumeFightMA() )

// @returns a series of floats to normalize and smooth the values
export VolumeFightDiff()        => ta.sma(weightedAVG_BullVolume() / volume - 1 - (weightedAVG_BearVolume() / volume - 1), volumeFightMA() )  

// @returns a series of floats to determine average value for calculation flat-filter
export VolumeFightFlatFilter()   => math.abs(weightedAVG_BullVolume() + weightedAVG_BearVolume() ) / 2 

////# User Defined Fight Strategy
// @function avg_bull_vol(int) function. 
export avg_bull_vol(int userMA)   => ta.vwma(bull_vol(), userMA)  //determine vwma

// @function avg_bear_vol(int) function. 
export avg_bear_vol(int userMA)   => ta.vwma(bear_vol(), userMA)

// @function diff_vol(int) function. 
export diff_vol(int userMA)       => ta.sma(avg_bull_vol(userMA) / volume - 1 - (avg_bear_vol(userMA) / volume - 1), userMA)  //normalize and smooth the values

// @function vol_flat(int) function. 
export vol_flat(int userMA)       => math.abs(avg_bull_vol(userMA) + avg_bear_vol(userMA) ) / 2  //determine average value for calculation flat-filter

// Update global variables for consistency
bullVolumeAvg := avg_bull_vol(11)
bearVolumeAvg := avg_bear_vol(11)
flatFilterBull := vol_flat(11)
flatFilterBear := vol_flat(11)

////////////////////////////////////////////////////////////////////
// Patterns Utilities
////////////////////////////////////////////////////////////////////{

var float lowestLow = ta.lowest(low, 10)  // Store the lowest low in a global variable

//@returns a series of bool, if there is a EngulfingBullish
export _isEngulfingBullish() => (open[1]-close[1])>0 and (close-open)>0 and high>high[1] and low<low[1] and (close-open)>(open[1]-close[1]) and (close-open)>(high-close) and (close-open)>(open-low)
//@returns a series of bool, if there is a EngulfingBearish
export _isEngulfingBearish() => (close[1]-open[1])>0 and (open-close)>0 and high>high[1] and low<low[1] and (open-close)>(close[1]-open[1]) and (open-close)>(high-open) and (open-close)>(close-low)
//@returns a series of bool, if there is a dojiup
export dojiup()              => (open-close)>0 ? (high-open)>(open-close) and (close-low)>(open-close) and (close-low)>(high-open) and (open-close)<((high-open)/8) : (open-low)>(close-open) and (high-close)>(close-open) and (open-low)>(high-close) and (close-open)<((high-close)/8)
//@returns a series of bool, if there is a dojidown
export dojidown()            => (open-close)>0 ? (high-open)>(open-close) and (close-low)>(open-close) and (high-open)>(close-low) and (open-close)<((close-low)/8) : (open-low)>(close-open) and (high-close)>(close-open) and (high-close)>(open-low) and (close-open)<((high-close)/8)
//@returns a series of bool, if there is a EveningStar
export EveningStar()         => (close[2] > open[2] and math.min(open[1], close[1]) > close[2] and open < math.min(open[1], close[1]) and close < open )
//@returns a series of bool, if there is a MorningStar
export MorningStar()         => (close[2] < open[2] and math.max(open[1], close[1]) < close[2] and open > math.max(open[1], close[1]) and close > open )
//@returns a series of bool, if there is a ShootingStar
export ShootingStar()        => (open[1] < close[1] and open > close[1] and high - math.max(open, close) >= math.abs(open - close) * 3 and math.min(close, open) - low <= math.abs(open - close))
//@returns a series of bool, if there is a hammer
export Hammer()              => (((high - low)>3*(open -close)) and  ((close - low)/(.001 + high - low) > 0.6) and ((open - low)/(.001 + high - low) > 0.6))
//@returns a series of bool, if there is a InvertedHammer
export InvertedHammer()      => (( (high - low)>3*(open -close) ) and  ((high - close)/(.001 + high - low) > 0.6) and ((high - open)/(.001 + high - low) > 0.6))
//@returns a series of bool, if there is a BearishHarami
export BearishHarami()       => (close[1] > open[1] and open > close and open <= close[1] and open[1] <= close and open - close < close[1] - open[1] )
//@returns a series of bool, if there is a BullishHarami
export BullishHarami()       => (open[1] > close[1] and close > open and close <= open[1] and close[1] <= open and close - open < open[1] - close[1] )
//@returns a series of bool, if there is a BullishBelt
export BullishBelt()         => (low == open and  open < lowestLow and open < close and close > ((high[1] - low[1]) / 2) + low[1])
//@returns a series of bool, if there is a BullishKicker
export BullishKicker()       => (open[1]>close[1] and open>=open[1] and close>open)
//@returns a series of bool, if there is a BearishKicker
export BearishKicker()       => (open[1]<close[1] and open<=open[1] and close<=open)
//@returns a series of bool, if there is a HangingMan
export HangingMan()          => (((high-low>4*(open-close))and((close-low)/(.001+high-low)>=0.75)and((open-low)/(.001+high-low)>=0.75)) and high[1] < open and high[2] < open)
//@returns a series of bool, if there is a DarkCloudCover
export DarkCloudCover()      => ((close[1]>open[1])and(((close[1]+open[1])/2)>close)and(open>close)and(open>close[1])and(close>open[1])and((open-close)/(.001+(high-low))>0.6))



// This has no relavance to this script, for some idoitic reason trading requires something render when publishing a library...
plot(close)