//@version=6
//@description AmendLogic CSS — Brand + Semantic Color Library
library("AmendLogic_CSS", overlay=true)

// @function Returns a color from the AmendLogic palette.
// @param color_id The ID of the color (e.g. "blue", "red", "tp1", "colorVar").
// @param t Transparency of the color (0–100). Default is 0.
// @returns The corresponding color including transparency.
export getColor(string color_id, int t = 0) =>
    bool isDark = color.r(chart.bg_color) < 80 and color.g(chart.bg_color) < 80 and color.b(chart.bg_color) < 80
    switch color_id
        // Brand
        "blue"      => color.new(#0161EF, t)
        "cyan"      => color.new(#00D4FF, t)
        "purple"    => color.new(#6D28D9, t)
        "gray"      => color.new(#F0F4FF, t)
        "black"     => color.new(#030620, t)
        // Semantisch
        "green"     => color.new(#00926A, t)
        "red"       => color.new(#D92B45, t)
        "yellow"    => color.new(#B87800, t)
        // Take-Profit
        "tp1"       => color.new(#00926A, t)
        "tp2"       => color.new(#008060, t)
        "tp3"       => color.new(#0D7A5A, t)
        "tp4"       => color.new(#2E7A65, t)
        "tp5"       => color.new(#4A7A6E, t)
        // Adaptiv
        "colorVar"  => isDark ? color.new(#F0F4FF, t) : color.new(#030620, t)
        => na