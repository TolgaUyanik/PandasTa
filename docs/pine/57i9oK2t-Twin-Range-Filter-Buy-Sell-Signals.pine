//@version=6
indicator(title="1H 20EMA", overlay=true)

// Inputs
src = close
len = 20

// Calculate EMA
out = ta.ema(src, len)

// Request 1H EMA regardless of current chart timeframe
out1 = request.security(syminfo.tickerid, "60", out)

// Plot
plot(out1, title="1H 20 EMA", color=color.orange, linewidth=2)

