// @returns bool True when swing low detected
export isSwingLow() =>
    _isSwingLow()

// @function Re-export: Detects swing high
// @returns bool True when swing high detected
export isSwingHigh() =>
    _isSwingHigh()

// @function Re-export: Gets swing high price at index
// @param idx Index (0 = most recent)
// @returns float Swing high price
export swingHighPrice(int idx = 0) =>
    _getSwingHighPrice(idx)

// @function Re-export: Gets swing low price at index
// @param idx Index (0 = most recent)
// @returns float Swing low price
export swingLowPrice(int idx = 0) =>
    _getSwingLowPrice(idx)

// @function Re-export: Gets swing high bar index
// @param idx Index (0 = most recent)
// @returns int Bar index of swing high
export swingHighBarIndex(int idx = 0) =>
    _getSwingHighBarIndex(idx)

