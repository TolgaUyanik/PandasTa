//==============================================================================
// SECTION 9: CUP AND HANDLE (Complex Pattern)
//==============================================================================

// @function Detects Cup and Handle pattern formation
// Uses price acceleration and depth analysis
// @param smoothLen Smoothing length for price (default 10)
// @param minDepthAtr Minimum cup depth as ATR multiple (default 1.0)
// @param maxDepthAtr Maximum cup depth as ATR multiple (default 5.0)
// @returns bool True when potential cup bottom detected
// EDGE CASES: Added depth filter, ATR validation
export cupBottom(int smoothLen = 10, float minDepthAtr = 1.0, float maxDepthAtr = 5.0) =>
    float smaPrice = ta.sma(close, smoothLen)
    float priceAccel = smaPrice - smaPrice[1]
    float atrVal = ta.atr(14)
    
    // Acceleration turning from negative to positive (bottom of cup)
    bool accelerationTurn = priceAccel[2] < 0 and priceAccel[1] < 0 and priceAccel > 0
    
    // Check cup depth (distance from recent high to current low)
    float recentHigh = ta.highest(high, smoothLen * 3)
    float cupDepth = recentHigh - low
    
    // Depth must be meaningful but not extreme
    bool validDepth = not na(atrVal) and atrVal > 0 ? 
                      cupDepth >= atrVal * minDepthAtr and cupDepth <= atrVal * maxDepthAtr :
                      cupDepth > 0
    
    accelerationTurn and validDepth

// @function Detects potential handle formation after cup
// @param lookback Bars to look back for cup (default 30)
// @param maxHandleRetraceRatio Maximum handle retracement of cup depth (default 0.5)
// @returns bool True when handle pattern detected
export cupHandle(int lookback = 30, float maxHandleRetraceRatio = 0.5) =>
    // Find the cup high (resistance level)
    float cupHigh = ta.highest(high, lookback)
    float cupLow = ta.lowest(low, lookback)
    float cupDepth = cupHigh - cupLow
    
    // Handle: price pulls back from cup high but not too deep
    bool nearCupHigh = high >= cupHigh * 0.95  // Within 5% of cup high recently
    bool handlePullback = close < cupHigh and close > cupHigh - (cupDepth * maxHandleRetraceRatio)
    
    // Price should be rising (end of handle)
    bool risingPrice = close > close[1] and close[1] > close[2]
    
    nearCupHigh[3] and handlePullback and risingPrice

//==============================================================================
// SECTION 10: PATTERN SUMMARY FUNCTIONS
//==============================================================================

// @function Returns count of bullish patterns detected
// @returns int Number of bullish patterns currently active
export bullishPatternCount() =>
    int count = 0
    if bullishEngulfing()
        count += 1
    if hammer()
        count += 1
    if morningStar()
        count += 1
    if gapUp()
        count += 1
    if doubleBottom()
        count += 1
    if tripleBottom()
        count += 1
    if bullHeadShoulders()
        count += 1
    if ascendingTriangle()
        count += 1
    count

// @function Returns count of bearish patterns detected
// @returns int Number of bearish patterns currently active
export bearishPatternCount() =>
    int count = 0
    if bearishEngulfing()
        count += 1
    if shootingStar()
        count += 1
    if eveningStar()
        count += 1
    if gapDown()
        count += 1
    if doubleTop()
        count += 1
    if tripleTop()
        count += 1
    if bearHeadShoulders()
        count += 1
    if descendingTriangle()
        count += 1
    count

// @function Returns string description of detected patterns
// @returns string Comma-separated list of detected patterns
export detectedPatterns() =>
    string result = ""
    
    // Bullish patterns
    if bullishEngulfing()
        result := result + "Bullish Engulfing, "
    if hammer()
        result := result + "Hammer, "
    if invertedHammer()
        result := result + "Inverted Hammer, "
    if morningStar()
        result := result + "Morning Star, "
    if gapUp()
        result := result + "Gap Up (" + gapType() + "), "
    if doubleBottom()
        result := result + "Double Bottom, "
    if tripleBottom()
        result := result + "Triple Bottom, "
    if bullHeadShoulders()
        result := result + "Inv Head & Shoulders, "
    if ascendingTriangle()
        result := result + "Ascending Triangle, "
    
    // Bearish patterns
    if bearishEngulfing()
        result := result + "Bearish Engulfing, "
    if shootingStar()
        result := result + "Shooting Star, "
    if hangingMan()
        result := result + "Hanging Man, "
    if eveningStar()
        result := result + "Evening Star, "
    if gapDown()
        result := result + "Gap Down (" + gapType() + "), "
    if doubleTop()
        result := result + "Double Top, "
    if tripleTop()
        result := result + "Triple Top, "
    if bearHeadShoulders()
        result := result + "Head & Shoulders, "
    if descendingTriangle()
        result := result + "Descending Triangle, "
    
    // Neutral patterns
    if doji()
        result := result + "Doji, "
    if symmetricalTriangle()
        result := result + "Symmetrical Triangle, "
    
    // Remove trailing comma and space
    if str.length(result) > 2
        result := str.substring(result, 0, str.length(result) - 2)
    else
        result := "None"
    
    result
