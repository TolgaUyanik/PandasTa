// @description RSM Pattern Library - All chart patterns from PATTERNS.md
// Implements: Candlestick patterns, Support/Resistance, Gaps, Triangles, Volume Divergence, and more
// ALL PATTERNS ARE OWN IMPLEMENTATION - No external dependencies
//
// EDGE CASES HANDLED:
// - Zero/tiny candle bodies
// - Missing volume data
// - Low bar count scenarios
// - Integer division issues
// - Price normalization for different instruments
library("RSMPatternLib", overlay=true)

//==============================================================================
// OWN SWING DETECTION - Replaces external library
// OPTIMIZED: Single-pass detection for multiple swings
//==============================================================================

// Swing detection parameters
int SWING_LOOKBACK = 5  // Bars to look left/right for pivot detection
int MAX_SWINGS = 10     // Maximum swings to track

// Maximum safe offset for historical lookback - Pine Script has variable buffer limits
int MAX_SAFE_OFFSET = 30

// Pre-compute pivot values ONCE per bar (optimization)
// Pine Script calls ta.pivothigh/ta.pivotlow with same params = same result cached internally
float _cachedPivotHigh = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)
float _cachedPivotLow = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)

// Detect swing high (pivot high) - uses cached value
_isSwingHigh() =>
    not na(_cachedPivotHigh)

// Detect swing low (pivot low) - uses cached value
_isSwingLow() =>
    not na(_cachedPivotLow)

// OPTIMIZED: Get ALL 3 swing highs (price + bar index) in a SINGLE pass
// Returns: [price0, bar0, price1, bar1, price2, bar2]
_getAllSwingHighs() =>
    float p0 = na, float p1 = na, float p2 = na
    int b0 = na, int b1 = na, int b2 = na
    // Early bar guard: need at least 2*SWING_LOOKBACK+1 bars for pivots to work
    int minBars = SWING_LOOKBACK * 2 + 1
    if bar_index >= minBars
        int found = 0
        int maxOffset = math.min(MAX_SAFE_OFFSET, bar_index - minBars)
        for offset = 0 to maxOffset
            if found >= 3
                break
            float ph = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)[offset]
            if not na(ph)
                if found == 0
                    p0 := ph
                    b0 := bar_index - offset - SWING_LOOKBACK
                else if found == 1
                    p1 := ph
                    b1 := bar_index - offset - SWING_LOOKBACK
                else if found == 2
                    p2 := ph
                    b2 := bar_index - offset - SWING_LOOKBACK
                found += 1
    [p0, b0, p1, b1, p2, b2]

// OPTIMIZED: Get ALL 3 swing lows (price + bar index) in a SINGLE pass
// Returns: [price0, bar0, price1, bar1, price2, bar2]
_getAllSwingLows() =>
    float p0 = na, float p1 = na, float p2 = na
    int b0 = na, int b1 = na, int b2 = na
    // Early bar guard: need at least 2*SWING_LOOKBACK+1 bars for pivots to work
    int minBars = SWING_LOOKBACK * 2 + 1
    if bar_index >= minBars
        int found = 0
        int maxOffset = math.min(MAX_SAFE_OFFSET, bar_index - minBars)
        for offset = 0 to maxOffset
            if found >= 3
                break
            float pl = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)[offset]
            if not na(pl)
                if found == 0
                    p0 := pl
                    b0 := bar_index - offset - SWING_LOOKBACK
                else if found == 1
                    p1 := pl
                    b1 := bar_index - offset - SWING_LOOKBACK
                else if found == 2
                    p2 := pl
                    b2 := bar_index - offset - SWING_LOOKBACK
                found += 1
    [p0, b0, p1, b1, p2, b2]

// Legacy single-value functions (for backward compatibility)
// These now use early-exit optimization with early bar guards
_getSwingHighPrice(int idx) =>
    float result = na
    int minBars = SWING_LOOKBACK * 2 + 1
    if bar_index >= minBars
        int found = 0
        int maxOffset = math.min(MAX_SAFE_OFFSET, bar_index - minBars)
        for offset = 0 to maxOffset
            if not na(result)
                break
            float ph = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)[offset]
            if not na(ph)
                if found == idx
                    result := ph
                found += 1
    result

_getSwingLowPrice(int idx) =>
    float result = na
    int minBars = SWING_LOOKBACK * 2 + 1
    if bar_index >= minBars
        int found = 0
        int maxOffset = math.min(MAX_SAFE_OFFSET, bar_index - minBars)
        for offset = 0 to maxOffset
            if not na(result)
                break
            float pl = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)[offset]
            if not na(pl)
                if found == idx
                    result := pl
                found += 1
    result

_getSwingHighBarIndex(int idx) =>
    int result = na
    int minBars = SWING_LOOKBACK * 2 + 1
    if bar_index >= minBars
        int found = 0
        int maxOffset = math.min(MAX_SAFE_OFFSET, bar_index - minBars)
        for offset = 0 to maxOffset
            if not na(result)
                break
            float ph = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)[offset]
            if not na(ph)
                if found == idx
                    result := bar_index - offset - SWING_LOOKBACK
                found += 1
    result

_getSwingLowBarIndex(int idx) =>
    int result = na
    int minBars = SWING_LOOKBACK * 2 + 1
    if bar_index >= minBars
        int found = 0
        int maxOffset = math.min(MAX_SAFE_OFFSET, bar_index - minBars)
        for offset = 0 to maxOffset
            if not na(result)
                break
            float pl = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)[offset]
            if not na(pl)
                if found == idx
                    result := bar_index - offset - SWING_LOOKBACK
                found += 1
    result

//==============================================================================
// SECTION 1: CANDLESTICK PATTERNS (Easy - Priority 1-4)
//==============================================================================

// @function Detects Bullish Engulfing pattern
// @param minBodyRatio Minimum body size as ratio of total range (default 0.3)
// @param minPrevBodyRatio Minimum previous candle body ratio to filter dojis (default 0.1)
// @returns bool True when bullish engulfing detected
// EDGE CASES: Handles doji previous candle, zero range, tiny bodies
export bullishEngulfing(float minBodyRatio = 0.3, float minPrevBodyRatio = 0.1) =>
    float body = math.abs(close - open)
    float prevBody = math.abs(close[1] - open[1])
    float bodyHigh = math.max(close, open)
    float bodyLow = math.min(close, open)
    float prevBodyHigh = math.max(close[1], open[1])
    float prevBodyLow = math.min(close[1], open[1])
    float totalRange = high - low
    float prevTotalRange = high[1] - low[1]
    
    bool isGreen = close > open
    bool prevIsRed = close[1] < open[1]
    bool engulfs = bodyLow <= prevBodyLow and bodyHigh >= prevBodyHigh
    
    // Current candle must have meaningful body
    bool hasBody = totalRange > 0 ? body / totalRange >= minBodyRatio : false
    
    // Previous candle must have meaningful body (filter out dojis being "engulfed")
    bool prevHasBody = prevTotalRange > 0 ? prevBody / prevTotalRange >= minPrevBodyRatio : false
    
    isGreen and prevIsRed and engulfs and hasBody and prevHasBody

// @function Detects Bearish Engulfing pattern
// @param minBodyRatio Minimum body size as ratio of total range (default 0.3)
// @param minPrevBodyRatio Minimum previous candle body ratio to filter dojis (default 0.1)
// @returns bool True when bearish engulfing detected
// EDGE CASES: Handles doji previous candle, zero range, tiny bodies
export bearishEngulfing(float minBodyRatio = 0.3, float minPrevBodyRatio = 0.1) =>
    float body = math.abs(close - open)
    float prevBody = math.abs(close[1] - open[1])
    float bodyHigh = math.max(close, open)
    float bodyLow = math.min(close, open)
    float prevBodyHigh = math.max(close[1], open[1])
    float prevBodyLow = math.min(close[1], open[1])
    float totalRange = high - low
    float prevTotalRange = high[1] - low[1]
    
    bool isRed = close < open
    bool prevIsGreen = close[1] > open[1]
    bool engulfs = bodyLow <= prevBodyLow and bodyHigh >= prevBodyHigh
    
    bool hasBody = totalRange > 0 ? body / totalRange >= minBodyRatio : false
    bool prevHasBody = prevTotalRange > 0 ? prevBody / prevTotalRange >= minPrevBodyRatio : false
    
    isRed and prevIsGreen and engulfs and hasBody and prevHasBody

// @function Detects Doji candle (indecision)
// @param maxBodyRatio Maximum body size as ratio of total range (default 0.1)
// @param minRangeAtr Minimum range as multiple of ATR to filter flat candles (default 0.3)
// @returns bool True when doji detected
// EDGE CASES: Filters out no-movement bars, handles zero range
export doji(float maxBodyRatio = 0.1, float minRangeAtr = 0.3) =>
    float body = math.abs(close - open)
    float totalRange = high - low
    float atrVal = ta.atr(14)
    float wickRatio = totalRange > 0 ? body / totalRange : 1.0  // Default to 1.0 (not a doji) if no range
    
    // Must have some movement (not a flat bar) and small body relative to range
    bool hasMovement = not na(atrVal) ? totalRange >= atrVal * minRangeAtr : totalRange > 0
    
    wickRatio < maxBodyRatio and hasMovement

// @function Detects Shooting Star (bearish reversal)
// @param wickMultiplier Upper wick must be at least this times the body (default 2.0)
// @param maxLowerWickRatio Lower wick max as ratio of body (default 0.5)
// @param minBodyAtrRatio Minimum body size as ratio of ATR (default 0.1)
// @returns bool True when shooting star detected
// EDGE CASES: Handles zero body (uses range-based check), tiny bodies
export shootingStar(float wickMultiplier = 2.0, float maxLowerWickRatio = 0.5, float minBodyAtrRatio = 0.1) =>
    float body = math.abs(close - open)
    float upperWick = high - math.max(close, open)
    float lowerWick = math.min(close, open) - low
    float totalRange = high - low
    float atrVal = ta.atr(14)
    
    // For tiny/zero body candles, use total range as reference instead
    float referenceSize = body > 0 ? body : totalRange * 0.1
    
    // Body must be meaningful relative to ATR
    bool hasMinBody = not na(atrVal) and atrVal > 0 ? body >= atrVal * minBodyAtrRatio : body > 0
    
    // If body is very small, require upper wick to be significant portion of total range
    bool longUpperWick = body > 0 ? 
                         upperWick >= body * wickMultiplier : 
                         totalRange > 0 and upperWick >= totalRange * 0.6
    
    bool smallLowerWick = body > 0 ? 
                          lowerWick <= body * maxLowerWickRatio : 
                          lowerWick <= totalRange * 0.2
    
    longUpperWick and smallLowerWick and (hasMinBody or totalRange > 0)

// @function Detects Hammer (bullish reversal)
// @param wickMultiplier Lower wick must be at least this times the body (default 2.0)
// @param maxUpperWickRatio Upper wick max as ratio of body (default 0.5)
// @param minBodyAtrRatio Minimum body size as ratio of ATR (default 0.1)
// @returns bool True when hammer detected
// EDGE CASES: Handles zero body (uses range-based check), tiny bodies
export hammer(float wickMultiplier = 2.0, float maxUpperWickRatio = 0.5, float minBodyAtrRatio = 0.1) =>
    float body = math.abs(close - open)
    float upperWick = high - math.max(close, open)
    float lowerWick = math.min(close, open) - low
    float totalRange = high - low
    float atrVal = ta.atr(14)
    
    bool hasMinBody = not na(atrVal) and atrVal > 0 ? body >= atrVal * minBodyAtrRatio : body > 0
    
    bool longLowerWick = body > 0 ? 
                         lowerWick >= body * wickMultiplier : 
                         totalRange > 0 and lowerWick >= totalRange * 0.6
    
    bool smallUpperWick = body > 0 ? 
                          upperWick <= body * maxUpperWickRatio : 
                          upperWick <= totalRange * 0.2
    
    longLowerWick and smallUpperWick and (hasMinBody or totalRange > 0)

// @function Detects Inverted Hammer (bullish reversal after downtrend)
// @param wickMultiplier Upper wick must be at least this times the body (default 2.0)
// @param maxLowerWickRatio Lower wick max as ratio of body (default 0.5)
// @returns bool True when inverted hammer detected
// EDGE CASES: Same as shootingStar but requires bullish close
export invertedHammer(float wickMultiplier = 2.0, float maxLowerWickRatio = 0.5) =>
    float body = math.abs(close - open)
    float upperWick = high - math.max(close, open)
    float lowerWick = math.min(close, open) - low
    float totalRange = high - low
    
    bool hasMinBody = body > 0 or totalRange > 0
    
    bool longUpperWick = body > 0 ? 
                         upperWick >= body * wickMultiplier : 
                         totalRange > 0 and upperWick >= totalRange * 0.6
    
    bool smallLowerWick = body > 0 ? 
                          lowerWick <= body * maxLowerWickRatio : 
                          lowerWick <= totalRange * 0.2
    
    bool isBullish = close >= open
    
    longUpperWick and smallLowerWick and hasMinBody and isBullish

// @function Detects Hanging Man (bearish reversal after uptrend)
// @param wickMultiplier Lower wick must be at least this times the body (default 2.0)
// @param maxUpperWickRatio Upper wick max as ratio of body (default 0.5)
// @returns bool True when hanging man detected
// NOTE: Identical to hammer - context (uptrend) determines meaning
export hangingMan(float wickMultiplier = 2.0, float maxUpperWickRatio = 0.5) =>
    hammer(wickMultiplier, maxUpperWickRatio)

// @function Detects Morning Star (3-candle bullish reversal)
// @param requireGap Whether to require gap between candles (default false for crypto/forex)
// @param minAvgBars Minimum bars for average body calculation (default 14)
// @returns bool True when morning star pattern detected
// EDGE CASES: Gap is optional, handles low bar count, uses shifted average
export morningStar(bool requireGap = false, int minAvgBars = 14) =>
    // Use average body from BEFORE the pattern to avoid skewing
    float avgBody = bar_index >= minAvgBars ? ta.sma(math.abs(close - open), minAvgBars)[3] : math.abs(close - open)
    
    // Day 1: Large red candle
    float body1 = math.abs(close[2] - open[2])
    bool isRed1 = close[2] < open[2]
    bool largeBody1 = avgBody > 0 ? body1 > avgBody : body1 > 0
    
    // Day 2: Small body (star)
    float body2 = math.abs(close[1] - open[1])
    bool smallBody2 = avgBody > 0 ? body2 < avgBody * 0.5 : body2 < body1 * 0.3
    
    // Gap is optional (many markets don't gap)
    bool gapsDown = math.max(close[1], open[1]) < math.min(close[2], open[2])
    bool gapCheck = requireGap ? gapsDown : true
    
    // Day 3: Large green candle that closes above midpoint of Day 1
    float body3 = math.abs(close - open)
    bool isGreen3 = close > open
    bool largeBody3 = avgBody > 0 ? body3 > avgBody : body3 > body2 * 2
    float midpoint1 = (open[2] + close[2]) / 2
    bool closesAboveMid = close > midpoint1
    
    isRed1 and largeBody1 and smallBody2 and gapCheck and isGreen3 and largeBody3 and closesAboveMid

// @function Detects Evening Star (3-candle bearish reversal)
// @param requireGap Whether to require gap between candles (default false for crypto/forex)
// @param minAvgBars Minimum bars for average body calculation (default 14)
// @returns bool True when evening star pattern detected
// EDGE CASES: Gap is optional, handles low bar count
export eveningStar(bool requireGap = false, int minAvgBars = 14) =>
    float avgBody = bar_index >= minAvgBars ? ta.sma(math.abs(close - open), minAvgBars)[3] : math.abs(close - open)
    
    float body1 = math.abs(close[2] - open[2])
    bool isGreen1 = close[2] > open[2]
    bool largeBody1 = avgBody > 0 ? body1 > avgBody : body1 > 0
    
    float body2 = math.abs(close[1] - open[1])
    bool smallBody2 = avgBody > 0 ? body2 < avgBody * 0.5 : body2 < body1 * 0.3
    
    bool gapsUp = math.min(close[1], open[1]) > math.max(close[2], open[2])
    bool gapCheck = requireGap ? gapsUp : true
    
    float body3 = math.abs(close - open)
    bool isRed3 = close < open
    bool largeBody3 = avgBody > 0 ? body3 > avgBody : body3 > body2 * 2
    float midpoint1 = (open[2] + close[2]) / 2
    bool closesBelowMid = close < midpoint1
    
    isGreen1 and largeBody1 and smallBody2 and gapCheck and isRed3 and largeBody3 and closesBelowMid

//==============================================================================
// SECTION 2: GAP PATTERNS
//==============================================================================

// @function Detects Gap Up
// @returns bool True when current bar opens above previous bar's high
export gapUp() =>
    open > high[1]

// @function Detects Gap Down
// @returns bool True when current bar opens below previous bar's low
export gapDown() =>
    open < low[1]

// @function Returns gap size in price
// @returns float Gap size (positive for gap up, negative for gap down, 0 for no gap)
export gapSize() =>
    if open > high[1]
        open - high[1]
    else if open < low[1]
        open - low[1]
    else
        0.0

// @function Returns gap size as percentage
// @returns float Gap size as percentage of previous close
export gapPercent() =>
    float gs = gapSize()
    close[1] != 0 ? gs / close[1] * 100 : 0.0

// @function Classifies gap type based on volume
// @param volAvgLen Length for volume average (default 20)
// @param breakawayMinPct Minimum gap % for breakaway (default 1.0)
// @param highVolMult Volume multiplier for high volume (default 1.5)
// @returns string Gap type: "Breakaway", "Common", "Continuation", or "None"
// EDGE CASES: Handles missing volume data, low bar count
export gapType(int volAvgLen = 20, float breakawayMinPct = 1.0, float highVolMult = 1.5) =>
    float gapPct = math.abs(gapPercent())
    bool hasGap = gapUp() or gapDown()
    
    // Handle missing volume data
    bool hasVolume = not na(volume) and volume > 0
    float avgVol = hasVolume and bar_index >= volAvgLen ? ta.sma(volume, volAvgLen) : na
    
    if not hasGap
        "None"
    else if na(avgVol)
        // No volume data - classify by gap size only
        gapPct >= breakawayMinPct ? "Breakaway" : "Common"
    else
        bool highVol = volume > avgVol * highVolMult
        bool lowVol = volume < avgVol
        
        if gapPct >= breakawayMinPct and highVol
            "Breakaway"
        else if gapPct < 0.5 and lowVol
            "Common"
        else
            "Continuation"

//==============================================================================
// SECTION 3: HIGHER HIGHS / LOWER LOWS (Trend Structure)
// NOTE: These functions detect patterns on the CURRENT bar only
// They do NOT maintain state between calls (Pine library limitation)
//==============================================================================

// @function Detects swing high using pivot
// @param leftBars Bars to left for pivot (default 5)
// @param rightBars Bars to right for pivot (default 5)
// @returns float Swing high price or na
export swingHigh(int leftBars = 5, int rightBars = 5) =>
    ta.pivothigh(high, leftBars, rightBars)

// @function Detects swing low using pivot
// @param leftBars Bars to left for pivot (default 5)
// @param rightBars Bars to right for pivot (default 5)
// @returns float Swing low price or na
export swingLow(int leftBars = 5, int rightBars = 5) =>
    ta.pivotlow(low, leftBars, rightBars)

// @function Checks if current swing high is higher than previous swing high
// OPTIMIZED: Uses cached pivot and early exit
// @param leftBars Bars to left for pivot (default 5)
// @param rightBars Bars to right for pivot (default 5)
// @param lookback How many bars back to search for previous pivot (default 50)
// @returns bool True when higher high pattern detected
export higherHigh(int leftBars = 5, int rightBars = 5, int lookback = 50) =>
    // Use cached pivot if using default params
    float currentPivot = leftBars == 5 and rightBars == 5 ? _cachedPivotHigh : ta.pivothigh(high, leftBars, rightBars)
    
    if na(currentPivot)
        false
    else
        float prevPivot = na
        int maxSearch = math.min(lookback, bar_index)
        for i = 1 to maxSearch
            if not na(prevPivot)  // Early exit
                break
            float ph = ta.pivothigh(high, leftBars, rightBars)[i]
            if not na(ph)
                prevPivot := ph
        not na(prevPivot) and currentPivot > prevPivot

// @function Checks if current swing low is higher than previous swing low
// OPTIMIZED: Uses cached pivot and early exit
// @param leftBars Bars to left for pivot (default 5)
// @param rightBars Bars to right for pivot (default 5)
// @param lookback How many bars back to search for previous pivot (default 50)
// @returns bool True when higher low pattern detected
export higherLow(int leftBars = 5, int rightBars = 5, int lookback = 50) =>
    float currentPivot = leftBars == 5 and rightBars == 5 ? _cachedPivotLow : ta.pivotlow(low, leftBars, rightBars)
    
    if na(currentPivot)
        false
    else
        float prevPivot = na
        int maxSearch = math.min(lookback, bar_index)
        for i = 1 to maxSearch
            if not na(prevPivot)
                break
            float pl = ta.pivotlow(low, leftBars, rightBars)[i]
            if not na(pl)
                prevPivot := pl
        not na(prevPivot) and currentPivot > prevPivot

// @function Checks if current swing high is lower than previous swing high
// OPTIMIZED: Uses cached pivot and early exit
// @param leftBars Bars to left for pivot (default 5)
// @param rightBars Bars to right for pivot (default 5)
// @param lookback How many bars back to search for previous pivot (default 50)
// @returns bool True when lower high pattern detected
export lowerHigh(int leftBars = 5, int rightBars = 5, int lookback = 50) =>
    float currentPivot = leftBars == 5 and rightBars == 5 ? _cachedPivotHigh : ta.pivothigh(high, leftBars, rightBars)
    
    if na(currentPivot)
        false
    else
        float prevPivot = na
        int maxSearch = math.min(lookback, bar_index)
        for i = 1 to maxSearch
            if not na(prevPivot)
                break
            float ph = ta.pivothigh(high, leftBars, rightBars)[i]
            if not na(ph)
                prevPivot := ph
        not na(prevPivot) and currentPivot < prevPivot

// @function Checks if current swing low is lower than previous swing low
// OPTIMIZED: Uses cached pivot and early exit
// @param leftBars Bars to left for pivot (default 5)
// @param rightBars Bars to right for pivot (default 5)
// @param lookback How many bars back to search for previous pivot (default 50)
// @returns bool True when lower low pattern detected
export lowerLow(int leftBars = 5, int rightBars = 5, int lookback = 50) =>
    float currentPivot = leftBars == 5 and rightBars == 5 ? _cachedPivotLow : ta.pivotlow(low, leftBars, rightBars)
    
    if na(currentPivot)
        false
    else
        float prevPivot = na
        int maxSearch = math.min(lookback, bar_index)
        for i = 1 to maxSearch
            if not na(prevPivot)
                break
            float pl = ta.pivotlow(low, leftBars, rightBars)[i]
            if not na(pl)
                prevPivot := pl
        not na(prevPivot) and currentPivot < prevPivot

// @function Detects Bullish Trend (HH + HL within lookback)
// @param leftBars Bars to left for pivot (default 5)
// @param rightBars Bars to right for pivot (default 5)
// @param lookback Lookback period (default 50)
// @returns bool True when making higher highs AND higher lows
export bullishTrend(int leftBars = 5, int rightBars = 5, int lookback = 50) =>
    higherHigh(leftBars, rightBars, lookback) and higherLow(leftBars, rightBars, lookback)

// @function Detects Bearish Trend (LH + LL within lookback)
// @param leftBars Bars to left for pivot (default 5)
// @param rightBars Bars to right for pivot (default 5)
// @param lookback Lookback period (default 50)
// @returns bool True when making lower highs AND lower lows
export bearishTrend(int leftBars = 5, int rightBars = 5, int lookback = 50) =>
    lowerHigh(leftBars, rightBars, lookback) and lowerLow(leftBars, rightBars, lookback)

//==============================================================================
// SECTION 4: SUPPORT & RESISTANCE
//==============================================================================

// @function Finds nearest resistance level above current price
// OPTIMIZED: Scans from current bar outward, finds nearest first
// @param lookback Number of bars to look back (default 50)
// @param leftBars Pivot left bars (default 5)
// @param rightBars Pivot right bars (default 5)
// @returns float Nearest resistance level or na
export nearestResistance(int lookback = 50, int leftBars = 5, int rightBars = 5) =>
    float nearest = na
    int maxLookback = math.min(lookback, bar_index)
    
    // Scan from recent to old - first valid pivot above close is often the nearest
    // but we need to find THE nearest (lowest value above close)
    for i = 0 to maxLookback
        float ph = ta.pivothigh(high, leftBars, rightBars)[i]
        if not na(ph) and ph > close
            if na(nearest) or ph < nearest
                nearest := ph
    nearest

// @function Finds nearest support level below current price
// OPTIMIZED: Similar approach to resistance
// @param lookback Number of bars to look back (default 50)
// @param leftBars Pivot left bars (default 5)
// @param rightBars Pivot right bars (default 5)
// @returns float Nearest support level or na
export nearestSupport(int lookback = 50, int leftBars = 5, int rightBars = 5) =>
    float nearest = na
    int maxLookback = math.min(lookback, bar_index)
    
    for i = 0 to maxLookback
        float pl = ta.pivotlow(low, leftBars, rightBars)[i]
        if not na(pl) and pl < close
            if na(nearest) or pl > nearest
                nearest := pl
    nearest

// @function Detects resistance breakout
// OPTIMIZED: Scans for nearest resistance relative to previous close
// @param lookback Number of bars to look back (default 50)
// @param leftBars Pivot left bars (default 5)
// @param rightBars Pivot right bars (default 5)
// @returns bool True when price breaks above resistance
export resistanceBreakout(int lookback = 50, int leftBars = 5, int rightBars = 5) =>
    float prevNear = na
    int maxLookback = math.min(lookback, bar_index - 1)
    
    for i = 1 to maxLookback + 1
        float ph = ta.pivothigh(high, leftBars, rightBars)[i]
        if not na(ph) and ph > close[1]
            if na(prevNear) or ph < prevNear
                prevNear := ph
    not na(prevNear) and close > prevNear and close[1] <= prevNear

// @function Detects support breakdown
// OPTIMIZED: Similar approach
// @param lookback Number of bars to look back (default 50)
// @param leftBars Pivot left bars (default 5)
// @param rightBars Pivot right bars (default 5)
// @returns bool True when price breaks below support
export supportBreakdown(int lookback = 50, int leftBars = 5, int rightBars = 5) =>
    float prevNear = na
    int maxLookback = math.min(lookback, bar_index - 1)
    
    for i = 1 to maxLookback + 1
        float pl = ta.pivotlow(low, leftBars, rightBars)[i]
        if not na(pl) and pl < close[1]
            if na(prevNear) or pl > prevNear
                prevNear := pl
    not na(prevNear) and close < prevNear and close[1] >= prevNear

//==============================================================================
// SECTION 5: VOLUME DIVERGENCE
//==============================================================================

// @function Detects Bullish Volume Divergence (price makes lower low, volume decreases)
// OPTIMIZED: Uses cached pivot and early exit
// @param leftBars Pivot left bars (default 5)
// @param rightBars Pivot right bars (default 5)
// @param lookback Bars to search for previous pivot (default 50)
// @returns bool True when bullish volume divergence detected
export bullishVolumeDivergence(int leftBars = 5, int rightBars = 5, int lookback = 50) =>
    float currentPivot = leftBars == 5 and rightBars == 5 ? _cachedPivotLow : ta.pivotlow(low, leftBars, rightBars)
    
    if na(currentPivot) or na(volume)
        false
    else
        float currentVol = volume[rightBars]
        float prevPivot = na
        float prevVol = na
        int maxSearch = math.min(lookback, bar_index)
        for i = 1 to maxSearch
            if not na(prevPivot)  // Early exit
                break
            float pl = ta.pivotlow(low, leftBars, rightBars)[i]
            if not na(pl)
                prevPivot := pl
                prevVol := volume[rightBars + i]
        not na(prevPivot) and not na(prevVol) and currentPivot < prevPivot and currentVol < prevVol

// @function Detects Bearish Volume Divergence (price makes higher high, volume decreases)
// OPTIMIZED: Uses cached pivot and early exit
// @param leftBars Pivot left bars (default 5)
// @param rightBars Pivot right bars (default 5)
// @param lookback Bars to search for previous pivot (default 50)
// @returns bool True when bearish volume divergence detected
export bearishVolumeDivergence(int leftBars = 5, int rightBars = 5, int lookback = 50) =>
    float currentPivot = leftBars == 5 and rightBars == 5 ? _cachedPivotHigh : ta.pivothigh(high, leftBars, rightBars)
    
    if na(currentPivot) or na(volume)
        false
    else
        float currentVol = volume[rightBars]
        float prevPivot = na
        float prevVol = na
        int maxSearch = math.min(lookback, bar_index)
        for i = 1 to maxSearch
            if not na(prevPivot)  // Early exit
                break
            float ph = ta.pivothigh(high, leftBars, rightBars)[i]
            if not na(ph)
                prevPivot := ph
                prevVol := volume[rightBars + i]
        not na(prevPivot) and not na(prevVol) and currentPivot > prevPivot and currentVol < prevVol

//==============================================================================
// SECTION 6: TRIANGLE PATTERNS
//==============================================================================

// @function Detects if price is in a contracting range (triangle formation)
// @param lookback Bars to analyze (default 20)
// @returns bool True when range is contracting
// EDGE CASES: Uses safe integer division, checks minimum lookback
export rangeContracting(int lookback = 20) =>
    // Ensure minimum lookback
    int safeLookback = math.max(lookback, 12)
    int offset1 = math.round(safeLookback * 0.25)
    int offset2 = math.round(safeLookback * 0.5)
    
    float range1 = ta.highest(high, safeLookback) - ta.lowest(low, safeLookback)
    float range2 = ta.highest(high, safeLookback)[offset1] - ta.lowest(low, safeLookback)[offset1]
    float range3 = ta.highest(high, safeLookback)[offset2] - ta.lowest(low, safeLookback)[offset2]
    
    // All ranges must be positive and contracting
    range1 > 0 and range2 > 0 and range3 > 0 and range1 < range2 and range2 < range3

// @function Detects Ascending Triangle (flat top, rising bottom)
// @param lookback Bars to analyze (default 20)
// @param flatTolerance Max normalized slope for "flat" line (default 0.002)
// @returns bool True when ascending triangle detected
// EDGE CASES: Safe division, normalized slope, minimum lookback
export ascendingTriangle(int lookback = 20, float flatTolerance = 0.002) =>
    bool contracting = rangeContracting(lookback)
    
    int safeLookback = math.max(lookback, 12)
    int halfLookback = math.round(safeLookback / 2.0)
    halfLookback := math.max(halfLookback, 3)  // Minimum 3 bars
    
    // Calculate slopes using safe offsets
    float recentHighest = ta.highest(high, halfLookback)
    float olderHighest = ta.highest(high, halfLookback)[halfLookback]
    float recentLowest = ta.lowest(low, halfLookback)
    float olderLowest = ta.lowest(low, halfLookback)[halfLookback]
    
    float highSlope = (recentHighest - olderHighest) / halfLookback
    float lowSlope = (recentLowest - olderLowest) / halfLookback
    
    // Normalize slope by average price
    float avgPrice = ta.sma(close, safeLookback)
    float normHighSlope = avgPrice > 0 ? highSlope / avgPrice : 0
    float normLowSlope = avgPrice > 0 ? lowSlope / avgPrice : 0
    
    // Ascending: flat top (small slope) and rising bottom (positive slope)
    contracting and math.abs(normHighSlope) < flatTolerance and normLowSlope > flatTolerance / 2

// @function Detects Descending Triangle (falling top, flat bottom)
// @param lookback Bars to analyze (default 20)
// @param flatTolerance Max normalized slope for "flat" line (default 0.002)
// @returns bool True when descending triangle detected
export descendingTriangle(int lookback = 20, float flatTolerance = 0.002) =>
    bool contracting = rangeContracting(lookback)
    
    int safeLookback = math.max(lookback, 12)
    int halfLookback = math.max(math.round(safeLookback / 2.0), 3)
    
    float recentHighest = ta.highest(high, halfLookback)
    float olderHighest = ta.highest(high, halfLookback)[halfLookback]
    float recentLowest = ta.lowest(low, halfLookback)
    float olderLowest = ta.lowest(low, halfLookback)[halfLookback]
    
    float highSlope = (recentHighest - olderHighest) / halfLookback
    float lowSlope = (recentLowest - olderLowest) / halfLookback
    
    float avgPrice = ta.sma(close, safeLookback)
    float normHighSlope = avgPrice > 0 ? highSlope / avgPrice : 0
    float normLowSlope = avgPrice > 0 ? lowSlope / avgPrice : 0
    
    // Descending: falling top (negative slope) and flat bottom (small slope)
    contracting and normHighSlope < -flatTolerance / 2 and math.abs(normLowSlope) < flatTolerance

// @function Detects Symmetrical Triangle (converging trend lines)
// @param lookback Bars to analyze (default 20)
// @param minSlope Minimum normalized slope magnitude (default 0.0005)
// @returns bool True when symmetrical triangle detected
export symmetricalTriangle(int lookback = 20, float minSlope = 0.0005) =>
    bool contracting = rangeContracting(lookback)
    
    int safeLookback = math.max(lookback, 12)
    int halfLookback = math.max(math.round(safeLookback / 2.0), 3)
    
    float recentHighest = ta.highest(high, halfLookback)
    float olderHighest = ta.highest(high, halfLookback)[halfLookback]
    float recentLowest = ta.lowest(low, halfLookback)
    float olderLowest = ta.lowest(low, halfLookback)[halfLookback]
    
    float highSlope = (recentHighest - olderHighest) / halfLookback
    float lowSlope = (recentLowest - olderLowest) / halfLookback
    
    float avgPrice = ta.sma(close, safeLookback)
    float normHighSlope = avgPrice > 0 ? highSlope / avgPrice : 0
    float normLowSlope = avgPrice > 0 ? lowSlope / avgPrice : 0
    
    // Symmetrical: highs falling (negative), lows rising (positive), both significant
    contracting and normHighSlope < -minSlope and normLowSlope > minSlope

//==============================================================================
// SECTION 7: RE-EXPORTS FROM EXTERNAL LIBRARIES (theEccentricTrader)
// These patterns are already implemented in PubLibPattern
//==============================================================================

// @function Detects Double Bottom (W pattern) - OWN IMPLEMENTATION
// Two swing lows at similar price levels with a swing high between them
// OPTIMIZED: Uses single-pass swing detection
// @param tolerance Max price difference between lows as % (default 3)
// @param minSpanBars Minimum bars between the two lows (default 5)
// @param lookback Max bars to search for pattern (default 100)
// @returns bool True when double bottom detected
export doubleBottom(float tolerance = 3.0, int minSpanBars = 5, int lookback = 100) =>
    // OPTIMIZED: Get all swing lows in ONE pass (instead of 4 separate calls)
    [sl0, sl0_bar, sl1, sl1_bar, _sl2, _sl2_bar] = _getAllSwingLows()
    [sh0, sh0_bar, _sh1, _sh1_bar, _sh2, _sh2_bar] = _getAllSwingHighs()
    
    // All must exist
    bool allExist = not na(sl0) and not na(sl1) and not na(sh0)
    bool withinLookback = allExist ? (bar_index - sl1_bar) <= lookback : false
    
    if not allExist or not withinLookback
        false
    else
        // Two lows must be at similar price (within tolerance %)
        float priceDiff = sl1 > 0 ? math.abs(sl0 - sl1) / sl1 * 100 : 100
        bool similarLows = priceDiff <= tolerance
        
        // Must have minimum span between lows
        int spanBars = sl0_bar - sl1_bar
        bool hasMinSpan = spanBars >= minSpanBars
        
        // Swing high must be between the two lows (timing)
        bool highBetweenLows = sh0_bar > sl1_bar and sh0_bar < sl0_bar
        
        // Swing high must be significantly above the lows (at least 1%)
        float avgLow = (sl0 + sl1) / 2
        float peakHeight = avgLow > 0 ? ((sh0 - avgLow) / avgLow) * 100 : 0
        bool significantPeak = peakHeight >= 1.0
        
        similarLows and hasMinSpan and highBetweenLows and significantPeak

// @function Detects Double Top (M pattern) - OWN IMPLEMENTATION
// Two swing highs at similar price levels with a swing low between them
// OPTIMIZED: Uses single-pass swing detection
// @param tolerance Max price difference between highs as % (default 3)
// @param minSpanBars Minimum bars between the two highs (default 5)
// @param lookback Max bars to search for pattern (default 100)
// @returns bool True when double top detected
export doubleTop(float tolerance = 3.0, int minSpanBars = 5, int lookback = 100) =>
    // OPTIMIZED: Get all swings in ONE pass (instead of 4 separate calls)
    [sh0, sh0_bar, sh1, sh1_bar, _sh2, _sh2_bar] = _getAllSwingHighs()
    [sl0, sl0_bar, _sl1, _sl1_bar, _sl2, _sl2_bar] = _getAllSwingLows()
    
    // All must exist
    bool allExist = not na(sh0) and not na(sh1) and not na(sl0)
    bool withinLookback = allExist ? (bar_index - sh1_bar) <= lookback : false
    
    if not allExist or not withinLookback
        false
    else
        // Two highs must be at similar price (within tolerance %)
        float priceDiff = sh1 > 0 ? math.abs(sh0 - sh1) / sh1 * 100 : 100
        bool similarHighs = priceDiff <= tolerance
        
        // Must have minimum span between highs
        int spanBars = sh0_bar - sh1_bar
        bool hasMinSpan = spanBars >= minSpanBars
        
        // Swing low must be between the two highs (timing)
        bool lowBetweenHighs = sl0_bar > sh1_bar and sl0_bar < sh0_bar
        
        // Swing low must be significantly below the highs (at least 1%)
        float avgHigh = (sh0 + sh1) / 2
        float troughDepth = avgHigh > 0 ? ((avgHigh - sl0) / avgHigh) * 100 : 0
        bool significantTrough = troughDepth >= 1.0
        
        similarHighs and hasMinSpan and lowBetweenHighs and significantTrough

// @function Detects Triple Bottom - OWN IMPLEMENTATION
// Three swing lows at similar price levels
// OPTIMIZED: Uses single-pass swing detection
// @param tolerance Max price difference between lows as % (default 3)
// @param minSpanBars Minimum total bars for pattern (default 10)
// @param lookback Max bars to search for pattern (default 150)
// @returns bool True when triple bottom detected
export tripleBottom(float tolerance = 3.0, int minSpanBars = 10, int lookback = 150) =>
    // OPTIMIZED: Get all swings in ONE pass (instead of 8 separate calls)
    [sl0, sl0_bar, sl1, sl1_bar, sl2, sl2_bar] = _getAllSwingLows()
    [sh0, _sh0_bar, sh1, _sh1_bar, _sh2, _sh2_bar] = _getAllSwingHighs()
    
    // All must exist
    bool allExist = not na(sl0) and not na(sl1) and not na(sl2)
    bool withinLookback = allExist ? (bar_index - sl2_bar) <= lookback : false
    
    if not allExist or not withinLookback
        false
    else
        // All three lows must be at similar price (within tolerance %)
        float avgLow = (sl0 + sl1 + sl2) / 3
        float diff0 = avgLow > 0 ? math.abs(sl0 - avgLow) / avgLow * 100 : 100
        float diff1 = avgLow > 0 ? math.abs(sl1 - avgLow) / avgLow * 100 : 100
        float diff2 = avgLow > 0 ? math.abs(sl2 - avgLow) / avgLow * 100 : 100
        bool similarLows = diff0 <= tolerance and diff1 <= tolerance and diff2 <= tolerance
        
        // Must have minimum total span
        int totalSpan = sl0_bar - sl2_bar
        bool hasMinSpan = totalSpan >= minSpanBars
        
        // Proper sequence
        bool properSequence = sl2_bar < sl1_bar and sl1_bar < sl0_bar
        
        // At least one peak must be between lows
        bool hasPeaks = not na(sh0) and not na(sh1)
        
        similarLows and hasMinSpan and properSequence and hasPeaks

// @function Detects Triple Top - OWN IMPLEMENTATION
// Three swing highs at similar price levels
// OPTIMIZED: Uses single-pass swing detection
// @param tolerance Max price difference between highs as % (default 3)
// @param minSpanBars Minimum total bars for pattern (default 10)
// @param lookback Max bars to search for pattern (default 150)
// @returns bool True when triple top detected
export tripleTop(float tolerance = 3.0, int minSpanBars = 10, int lookback = 150) =>
    // OPTIMIZED: Get all swings in ONE pass (instead of 8 separate calls)
    [sh0, sh0_bar, sh1, sh1_bar, sh2, sh2_bar] = _getAllSwingHighs()
    [sl0, _sl0_bar, sl1, _sl1_bar, _sl2, _sl2_bar] = _getAllSwingLows()
    
    // All must exist
    bool allExist = not na(sh0) and not na(sh1) and not na(sh2)
    bool withinLookback = allExist ? (bar_index - sh2_bar) <= lookback : false
    
    if not allExist or not withinLookback
        false
    else
        // All three highs must be at similar price (within tolerance %)
        float avgHigh = (sh0 + sh1 + sh2) / 3
        float diff0 = avgHigh > 0 ? math.abs(sh0 - avgHigh) / avgHigh * 100 : 100
        float diff1 = avgHigh > 0 ? math.abs(sh1 - avgHigh) / avgHigh * 100 : 100
        float diff2 = avgHigh > 0 ? math.abs(sh2 - avgHigh) / avgHigh * 100 : 100
        bool similarHighs = diff0 <= tolerance and diff1 <= tolerance and diff2 <= tolerance
        
        // Must have minimum total span
        int totalSpan = sh0_bar - sh2_bar
        bool hasMinSpan = totalSpan >= minSpanBars
        
        // Proper sequence
        bool properSequence = sh2_bar < sh1_bar and sh1_bar < sh0_bar
        
        // At least one trough must be between highs
        bool hasTroughs = not na(sl0) and not na(sl1)
        
        similarHighs and hasMinSpan and properSequence and hasTroughs

// @function Detects Bearish Head and Shoulders (OWN IMPLEMENTATION)
// Head is higher than both shoulders, shoulders roughly equal, with valid neckline
// STRICT VERSION - requires proper structure, neckline, and minimum span
// OPTIMIZED: Uses single-pass swing detection
// @returns bool True when bearish H&S detected
export bearHeadShoulders() =>
    // OPTIMIZED: Get all swings in ONE pass (instead of 10 separate calls)
    [sh0, sh0_bar, sh1, sh1_bar, sh2, sh2_bar] = _getAllSwingHighs()
    [sl0, sl0_bar, sl1, sl1_bar, _sl2, _sl2_bar] = _getAllSwingLows()
    
    // All must exist
    bool allExist = not na(sh0) and not na(sh1) and not na(sh2) and not na(sl0) and not na(sl1)
    
    // Pattern must span at least 15 bars (not too compressed)
    int patternSpan = allExist ? sh0_bar - sh2_bar : 0
    bool hasMinSpan = patternSpan >= 15
    
    // Not too old (within 120 bars)
    bool withinLookback = allExist ? (bar_index - sh2_bar) <= 120 : false
    
    if not allExist or not hasMinSpan or not withinLookback
        false
    else
        // === STRICT STRUCTURE CHECKS ===
        
        // 1. Head must be CLEARLY higher than both shoulders (at least 3%)
        float avgShoulder = (sh0 + sh2) / 2
        float headExcess = avgShoulder > 0 ? ((sh1 - avgShoulder) / avgShoulder) * 100 : 0
        bool headHighEnough = sh1 > sh0 and sh1 > sh2 and headExcess >= 3.0
        
        // 2. Shoulders must be at similar level (within 5%)
        float shoulderDiff = sh2 > 0 ? math.abs(sh0 - sh2) / sh2 * 100 : 100
        bool shouldersEqual = shoulderDiff <= 5.0
        
        // 3. Proper timing sequence (Left Shoulder -> Head -> Right Shoulder)
        bool properHighSequence = sh2_bar < sh1_bar and sh1_bar < sh0_bar
        
        // 4. Neckline lows must be BETWEEN the respective highs
        bool neckline1Valid = sl1_bar > sh2_bar and sl1_bar < sh1_bar  // Between left shoulder and head
        bool neckline2Valid = sl0_bar > sh1_bar and sl0_bar < sh0_bar  // Between head and right shoulder
        bool necklineTimingValid = neckline1Valid and neckline2Valid
        
        // 5. Neckline lows should be below the shoulders (proves the peaks are significant)
        bool necklineBelowShoulders = sl0 < sh0 and sl0 < sh2 and sl1 < sh0 and sl1 < sh2
        
        // 6. Neckline should be roughly level (within 3%)
        float necklineDiff = sl1 > 0 ? math.abs(sl0 - sl1) / sl1 * 100 : 100
        bool necklineLevel = necklineDiff <= 3.0
        
        // 7. Right shoulder should be forming recently (within last 5 bars of pattern completion)
        bool recentCompletion = (bar_index - sh0_bar) <= 5
        
        // ALL conditions must be true
        headHighEnough and shouldersEqual and properHighSequence and necklineTimingValid and necklineBelowShoulders and necklineLevel and recentCompletion

// @function Detects Bullish (Inverse) Head and Shoulders (OWN IMPLEMENTATION)
// Head is lower than both shoulders, shoulders roughly equal, with valid neckline
// STRICT VERSION - requires proper structure, neckline, and minimum span
// OPTIMIZED: Uses single-pass swing detection
// @returns bool True when bullish H&S detected
export bullHeadShoulders() =>
    // OPTIMIZED: Get all swings in ONE pass (instead of 10 separate calls)
    [sl0, sl0_bar, sl1, sl1_bar, sl2, sl2_bar] = _getAllSwingLows()
    [sh0, sh0_bar, sh1, sh1_bar, _sh2, _sh2_bar] = _getAllSwingHighs()
    
    // All must exist
    bool allExist = not na(sl0) and not na(sl1) and not na(sl2) and not na(sh0) and not na(sh1)
    
    // Pattern must span at least 15 bars (not too compressed)
    int patternSpan = allExist ? sl0_bar - sl2_bar : 0
    bool hasMinSpan = patternSpan >= 15
    
    // Not too old (within 120 bars)
    bool withinLookback = allExist ? (bar_index - sl2_bar) <= 120 : false
    
    if not allExist or not hasMinSpan or not withinLookback
        false
    else
        // === STRICT STRUCTURE CHECKS ===
        
        // 1. Head must be CLEARLY lower than both shoulders (at least 3%)
        float avgShoulder = (sl0 + sl2) / 2
        float headExcess = avgShoulder > 0 ? ((avgShoulder - sl1) / avgShoulder) * 100 : 0
        bool headLowEnough = sl1 < sl0 and sl1 < sl2 and headExcess >= 3.0
        
        // 2. Shoulders must be at similar level (within 5%)
        float shoulderDiff = sl2 > 0 ? math.abs(sl0 - sl2) / sl2 * 100 : 100
        bool shouldersEqual = shoulderDiff <= 5.0
        
        // 3. Proper timing sequence (Left Shoulder -> Head -> Right Shoulder)
        bool properLowSequence = sl2_bar < sl1_bar and sl1_bar < sl0_bar
        
        // 4. Neckline highs must be BETWEEN the respective lows
        bool neckline1Valid = sh1_bar > sl2_bar and sh1_bar < sl1_bar  // Between left shoulder and head
        bool neckline2Valid = sh0_bar > sl1_bar and sh0_bar < sl0_bar  // Between head and right shoulder
        bool necklineTimingValid = neckline1Valid and neckline2Valid
        
        // 5. Neckline highs should be above the shoulders (proves the valleys are significant)
        bool necklineAboveShoulders = sh0 > sl0 and sh0 > sl2 and sh1 > sl0 and sh1 > sl2
        
        // 6. Neckline should be roughly level (within 3%)
        float necklineDiff = sh1 > 0 ? math.abs(sh0 - sh1) / sh1 * 100 : 100
        bool necklineLevel = necklineDiff <= 3.0
        
        // 7. Right shoulder should be forming recently (within last 5 bars of pattern completion)
        bool recentCompletion = (bar_index - sl0_bar) <= 5
        
        // ALL conditions must be true
        headLowEnough and shouldersEqual and properLowSequence and necklineTimingValid and necklineAboveShoulders and necklineLevel and recentCompletion

// @function Detects Bearish Ascending Head and Shoulders (variant)
// @returns bool True when pattern detected
export bearAscHeadShoulders() =>
    // Use main H&S detection - ascending variant not separately implemented
    bearHeadShoulders()

// @function Detects Bullish Ascending Head and Shoulders (variant)
// @returns bool True when pattern detected
export bullAscHeadShoulders() =>
    // Use main inverse H&S detection - ascending variant not separately implemented
    bullHeadShoulders()

// @function Detects Bearish Descending Head and Shoulders (variant)
// @returns bool True when pattern detected
export bearDescHeadShoulders() =>
    // Use main H&S detection - descending variant not separately implemented
    bearHeadShoulders()

// @function Detects Bullish Descending Head and Shoulders (variant)
// @returns bool True when pattern detected
export bullDescHeadShoulders() =>
    // Use main inverse H&S detection - descending variant not separately implemented
    bullHeadShoulders()

