//@version=6
// @description Libreria personale, per sorgenti estese (Close, Open, High, Low, Median, Typical, Weighted, Average, Average Median Body, Trend Biased, Trend Biased Extreme, Volume Body, Momentum Biased, Volatility Adjusted, Body Dominance, Shadow Biased, Gap Aware, Rejection Biased, Range Position, Adaptive Trend, Pressure Balanced, Impulse Wave)
library("mysourcetypes", overlay = true)

// ════════════════════════════ FUNZIONI HELPER ORIGINALI ════════════════════════════

_trendreg(float o, float h, float l, float c) =>
    compute = 0.
    if (c > o)
        compute := ((h + c)/2.0)
    else  
        compute := ((l + c)/2.0)
    compute

_trendext(float o, float h, float l, float c) =>
    compute = 0.
    if (c > o) 
        compute := h
    else if (c < o) 
        compute := l
    else 
        compute := c
    compute

// ════════════════════════════ NUOVE FUNZIONI HELPER ════════════════════════════

// Helper per calcolare il body della candela
_bodymid(float o, float c) => 
    (o + c) / 2.0

_bodysize(float o, float c) => 
    math.abs(c - o)

_rangesize(float h, float l) => 
    h - l

// Helper per direzione momentum
_momentum(float o, float c, float prevC) =>
    bodyStrength = c - o
    momentumStrength = c - prevC
    (bodyStrength + momentumStrength) / 2.0

// Helper per ombre
_uppershadow(float o, float h, float c) => 
    h - math.max(o, c)

_lowershadow(float o, float l, float c) => 
    math.min(o, c) - l

// ════════════════════════════ FUNZIONI EXPORT ORIGINALI ════════════════════════════

// @function Regular Close
// @returns Close price
export rclose() => 
    close

// @function Regular Open
// @returns Open price
export ropen() => 
    open

// @function Regular High
// @returns High price
export rhigh() => 
    high

// @function Regular Low
// @returns Low price
export rlow() => 
    low

// @function Regular Median (HL2)
// @returns (High + Low) / 2
export rmedian() => 
    hl2

// @function Regular Typical (HLC3)
// @returns (High + Low + Close) / 3
export rtypical() => 
    hlc3

// @function Regular Weighted (HLCC4)
// @returns (High + Low + Close + Close) / 4
export rweighted() => 
    hlcc4

// @function Regular Average (OHLC4)
// @returns (Open + High + Low + Close) / 4
export raverage() => 
    ohlc4

// @function Average Median Body
// @returns (Open + Close) / 2
export ravemedbody() => 
    (open + close)/2

// @function Trend Biased Regular
// @returns Trend-weighted price
export rtrendb() => 
    _trendreg(open, high, low, close)

// @function Trend Biased Extreme
// @returns Extreme trend-weighted price
export rtrendbext() => 
    _trendext(open, high, low, close)

// ════════════════════════════ NUOVE FUNZIONI EXPORT ════════════════════════════

// @function Volume Weighted Body
// @returns Body midpoint weighted by volume intensity
export rvolbody() =>
    volRatio = volume / math.avg(volume, volume[1], volume[2])
    volRatio > 1.2 ? close : (open + close) / 2.0

// @function Momentum Biased
// @returns Price biased towards momentum direction
export rmomentum() =>
    bodyMom = close - open
    priceMom = close - close[1]
    totalMom = bodyMom + priceMom
    if totalMom > 0
        (high + close) / 2.0  // Momentum rialzista
    else if totalMom < 0
        (low + close) / 2.0   // Momentum ribassista
    else
        close

// @function Volatility Adjusted
// @returns Price adjusted by candle's volatility
export rvolatility() =>
    candleRange = high - low
    avgRange = ta.sma(high - low, 14)
    isHighVol = candleRange > avgRange * 1.5
    isHighVol ? (high + low + close) / 3.0 : close

// @function Body Dominance
// @returns Emphasizes body over wicks
export rbodydominance() =>
    bodySize = math.abs(close - open)
    totalRange = high - low
    bodyRatio = totalRange > 0 ? bodySize / totalRange : 0.5
    bodyRatio > 0.6 ? close : (open + high + low + close) / 4.0

// @function Shadow Biased
// @returns Price biased by shadow length
export rshadowbias() =>
    upperShadow = high - math.max(open, close)
    lowerShadow = math.min(open, close) - low
    if upperShadow > lowerShadow * 1.5
        (high + close + close) / 3.0  // Upper shadow dominante
    else if lowerShadow > upperShadow * 1.5
        (low + close + close) / 3.0   // Lower shadow dominante
    else
        close

// @function Gap Aware
// @returns Considers gap between candles
export rgapaware() =>
    prevClose = close[1]
    hasGapUp = open > prevClose
    hasGapDown = open < prevClose
    if hasGapUp
        (open + high + close) / 3.0  // Favorisce il gap up
    else if hasGapDown
        (open + low + close) / 3.0   // Favorisce il gap down
    else
        (open + close) / 2.0

// @function Rejection Biased
// @returns Emphasizes price rejection levels
export rrejection() =>
    bullishRejection = (close > open) and ((low - open) > (close - open))
    bearishRejection = (close < open) and ((high - open) > (open - close))
    if bullishRejection
        (low + close) / 2.0  // Rejection dal basso
    else if bearishRejection
        (high + close) / 2.0  // Rejection dall'alto
    else
        close

// @function Range Position
// @returns Where close sits within the candle range (0-100%)
export rrangeposition() =>
    candleRange = high - low
    closePosition = candleRange > 0 ? (close - low) / candleRange : 0.5
    // Se chiude in alto del range, usa close, altrimenti body mid
    closePosition > 0.7 ? close : closePosition < 0.3 ? (open + close) / 2.0 : hlc3

// @function Adaptive Trend
// @returns Adapts based on recent trend strength
export radaptivetrend() =>
    shortTrend = ta.ema(close, 8)
    medTrend = ta.ema(close, 21)
    isStrongUptrend = close > shortTrend and shortTrend > medTrend
    isStrongDowntrend = close < shortTrend and shortTrend < medTrend
    if isStrongUptrend
        (high + close + close) / 3.0  // Aggressivo al rialzo
    else if isStrongDowntrend
        (low + close + close) / 3.0   // Aggressivo al ribasso
    else
        hlc3  // Neutrale

// @function Pressure Balanced
// @returns Balances buying/selling pressure within candle
export rpressure() =>
    bodyMid = (open + close) / 2.0
    wickMid = (high + low) / 2.0
    // Media pesata: 60% body, 40% wicks
    (bodyMid * 0.6) + (wickMid * 0.4)

// @function Impulse Wave
// @returns Detects impulsive moves vs corrections
export rimpulse() =>
    priceChange = close - open
    volumeRatio = volume / math.avg(volume, volume[1], volume[2], volume[3])
    isImpulse = math.abs(priceChange) > ta.atr(14) * 0.5 and volumeRatio > 1.3
    if isImpulse
        close  // Usa close su impulsi forti
    else
        (high + low + close + close) / 4.0  // Smoother su correzioni
		//Versione pubblica