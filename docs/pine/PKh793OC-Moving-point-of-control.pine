//@version=5

library("moving_poc")

from = input(close, "Source")
nbBarsToLookback = input.int(10, 'Number of bars to calculate PoC moving average (lookback length)', group = "Point of control")
pocLookbackPrecision = input.timeframe("60", "Lower timeframe", group = "Point of control")
pocMovingAverageLength = input.int(30, "Moving average length", group = "Point of control")
percentGapAbove = input.float(0.1, "Percent gap above", group = "Alerts")
percentGapBelow = input.float(0.1, "Percent gap below", group = "Alerts")

ltfVolume = request.security_lower_tf(syminfo.tickerid, pocLookbackPrecision, volume)
ltfPrice = request.security_lower_tf(syminfo.tickerid, pocLookbackPrecision, from)

var averagePriceByVolumeHistory = array.new<float>()

//@function Volume point of control (PoC) extracted from lower time frame data and previous time period
//@param averagePriceByVolumeHistory An array of float to record previous PoC average
//@param  ltfVolumeSerie Source of volume for the lower timeframe (ltf)
//@param ltfPriceSerie Source of price for the lower timeframe
//@param nbBarsToLookback A number of bars determining the lookback period of this PoC
//@returns Serie of PoC
export method getMovingPoc(
   array<float> averagePriceByVolumeHistory,
   array<float> ltfVolumeSerie,
   array<float> ltfPriceSerie,
   int nbBarsToLookback) =>

	movingPoc = close
	ltfMaxVolume = array.max(ltfVolumeSerie)

	if bar_index-nbBarsToLookback <= 0 or array.indexof(ltfVolumeSerie, ltfMaxVolume) == -1

		averagePriceByVolumeHistory.push(0.0)
		movingPoc := 0

	else

		ltfPocPrice = ltfPriceSerie.get(array.indexof(ltfVolumeSerie, ltfMaxVolume))
		averagePriceByVolumeHistory.push(ltfPocPrice)

		priceByVolumeLookbackSlice = array.slice(averagePriceByVolumeHistory, bar_index-nbBarsToLookback, bar_index)
		movingPoc := close / close * array.avg(priceByVolumeLookbackSlice)

plotLine = averagePriceByVolumeHistory.getMovingPoc(ltfVolume, ltfPrice, nbBarsToLookback)

var bool pocAbovsma = false
var bool priceAbovePoc = false

bool priceTrendPivotUp = false
bool maTrendPivotUp = false
bool priceTrendPivotDown = false
bool maTrendPivotDown = false

if not priceAbovePoc and open > plotLine and close > plotLine
	log.info('Price up')
	priceAbovePoc := true
	priceTrendPivotUp := true
if priceAbovePoc and open < plotLine and close < plotLine
	log.info('Price down')
	priceAbovePoc := false
	priceTrendPivotDown := true

if not pocAbovsma and plotLine > ta.sma(plotLine, pocMovingAverageLength)
	pocAbovsma := true
	maTrendPivotUp := true
if pocAbovsma and plotLine <= ta.sma(plotLine, pocMovingAverageLength)
	pocAbovsma := false
	maTrendPivotDown := true

plotshape(priceTrendPivotUp, "Price upward pivot", location = location.bottom, style = shape.flag, text = "Price up", color = color.green, textcolor = color.white, size = size.normal)
plotshape(priceTrendPivotDown, "Price downward pivot", location = location.top, style = shape.flag, text = "Price down", color = color.red, textcolor = color.white, size = size.normal)

uptrendColor = color.rgb(243, 150, 11, 14)
downtrendColor = color.rgb(59, 115, 189)
plotLineColor = pocAbovsma ? uptrendColor : downtrendColor

plot(plotLine, linewidth = 2, color = plotLineColor)
plot(ta.sma(plotLine, pocMovingAverageLength))
