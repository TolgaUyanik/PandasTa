//@version=6

//@version=5
indicator("RSI with 2-Pole Filter", overlay=false)

// --- RSI Setup ---
rsiLength = input.int(14, title="RSI Length")
rsiSource = input.source(close, title="RSI Source")
rsi = ta.rsi(rsiSource, rsiLength)
plot(rsi, title="Raw RSI", color=color.gray)

// --- 2-Pole Filter Coefficients ---
// These are example values. Adjust for responsiveness/smoothing.
b0 = 0.2
b1 = 0.1
b2 = 0.05
a1 = -0.3
a2 = 0.1

// --- Filter State Memory ---
var float x_1 = na
var float x_2 = na
var float y_1 = na
var float y_2 = na

// Initialize memory
x_1 := na(x_1) ? rsi : x_1
x_2 := na(x_2) ? rsi : x_2
y_1 := na(y_1) ? rsi : y_1
y_2 := na(y_2) ? rsi : y_2

// --- Apply 2-Pole Filter ---
y = b0 * rsi + b1 * x_1 + b2 * x_2 - a1 * y_1 - a2 * y_2

// Update memory (recursive simulation)
x_2 := x_1
x_1 := rsi
y_2 := y_1
y_1 := y

plot(y, title="Filtered RSI (2-Pole)", color=color.orange, linewidth=2)

// Optional thresholds
hline(70, "Overbought", color=color.red)
hline(30, "Oversold", color=color.green)
plot(close)