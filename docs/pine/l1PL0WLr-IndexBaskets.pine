//@version=6
// @description Centralized Top 10 Ticker Baskets (Updated Mid-2026 Data)
// @author codename_trading
library("IndexBaskets")

// Define the structure for the baskets
export type Basket
    string[] tickers
    float[]  weights

// Exported function to fetch the requested basket data
export getBasket(string name) =>
    string[] t = array.new_string(0)
    float[]  w = array.new_float(0)
    
    switch name
        // ==========================================
        // BROAD MARKET INDICES
        // ==========================================
        "SPY" => 
            t := array.from("NVDA", "AAPL", "MSFT", "AMZN", "GOOGL", "AVGO", "GOOG", "META", "TSLA", "BRK.B")
            w := array.from(7.66, 7.64, 4.56, 3.76, 3.15, 2.72, 2.64, 2.31, 1.65, 1.44)
        "QQQ" => 
            t := array.from("NVDA", "AAPL", "MSFT", "AMZN", "MU", "AMD", "TSLA", "GOOGL", "META", "GOOG")
