//@version=6
indicator(
     title = "The Black Anchor v1.0",
     shorttitle = "The Black Anchor",
     overlay = true,
     max_lines_count = 150,
     max_labels_count = 100
)

//======================================================================
// THE BLACK ANCHOR v1.0
//
// Unified H1 structure, ADR context and trade calculator.
//
// Stop rule:
// - BUY  -> H1 Reference Low
// - SELL -> H1 Reference High
//
// Intended chart:
// - Standard 1-hour XAUUSD candlestick chart
//======================================================================

//======================================================================
// 1. INPUT GROUPS
//======================================================================

groupStructure = "1. H1 Structure"
groupAdr       = "2. ADR and Execution Zone"
groupTrade     = "3. Trade Calculator"
groupRules     = "4. Trading Rules"
groupDisplay   = "5. Display"
groupColours   = "6. Colours"

//======================================================================
// 2. H1 STRUCTURE INPUTS
//======================================================================

displayMode = input.string(
     "Minimal",
     "Structure Display Mode",
     options = ["Minimal", "Research", "Debug"],
     group = groupStructure
)

showCurrentLevels = input.bool(
     true,
     "Show H1 Reference Levels",
     group = groupStructure
)

lineStartChoice = input.string(
     "From level origin",
     "Reference Line Start",
     options = ["From level origin", "From last update"],
     group = groupStructure
)

showStructureBackground = input.bool(
     false,
     "Colour Background by Structure",
     group = groupStructure
)

// Structure display flags.
bool isMinimal = displayMode == "Minimal"
bool isResearch = displayMode == "Research"
bool isDebug = displayMode == "Debug"
bool showBreakMarkers = isResearch or isDebug
bool showDebugLevels = isDebug
bool showDetailedText = isDebug

//======================================================================
// 3. ADR INPUTS
//======================================================================

adrLength = input.int(
     20,
     "ADR Length",
     minval = 2,
     group = groupAdr,
     tooltip = "Average high-to-low range of completed broker daily candles."
)

executionZoneMin = input.float(
     40.0,
     "Execution Zone Minimum (%)",
     minval = 0.0,
     maxval = 200.0,
     step = 1.0,
     group = groupAdr
)

executionZoneMax = input.float(
     80.0,
     "Execution Zone Maximum (%)",
     minval = 0.0,
     maxval = 200.0,
     step = 1.0,
     group = groupAdr
)

//======================================================================
// 4. TRADE CALCULATOR INPUTS
//======================================================================

tradeDirection = input.string(
     "BUY",
     "Direction",
     options = ["BUY", "SELL"],
     group = groupTrade
)

entryMethod = input.string(
     "Current Price",
     "Entry Method",
     options = ["Current Price", "Manual Entry"],
     group = groupTrade
)

manualEntryPrice = input.float(
     0.0,
     "Manual Entry Price",
     minval = 0.0,
     step = 0.001,
     group = groupTrade
)

accountSize = input.float(
     100000.0,
     "Account Size",
     minval = 1.0,
     step = 1000.0,
     group = groupTrade
)

riskPreset = input.string(
     "0.50%",
     "Risk Preset",
     options = ["0.25%", "0.50%", "1.00%", "Custom"],
     group = groupTrade
)

customRiskPercent = input.float(
     0.50,
     "Custom Risk (%)",
     minval = 0.01,
     maxval = 100.0,
     step = 0.05,
     group = groupTrade
)

rewardMultiple = input.float(
     3.0,
     "Reward Multiple",
     minval = 0.1,
     step = 0.1,
     group = groupTrade
)

contractSize = input.float(
     100.0,
     "XAUUSD Contract Size",
     minval = 0.01,
     step = 1.0,
     group = groupTrade,
     tooltip = "Commonly 100 ounces per 1.00 lot. Confirm your broker specification."
)

lotStep = input.float(
     0.01,
     "Lot Step",
     minval = 0.001,
     step = 0.001,
     group = groupTrade
)

weeklyTradeNumber = input.int(
     1,
     "Current Trade Number This Week",
     minval = 1,
     maxval = 99,
     group = groupTrade
)

//======================================================================
// 5. TRADING RULE INPUTS
//======================================================================

researchTimezone = input.string(
     "Asia/Singapore",
     "Trading Time Zone",
     group = groupRules
)

tradingStartHour = input.int(
     8,
     "Trading Window Start Hour",
     minval = 0,
     maxval = 23,
     group = groupRules
)

tradingEndHour = input.int(
     23,
     "Trading Window End Hour",
     minval = 1,
     maxval = 24,
     group = groupRules,
     tooltip = "End hour is exclusive. 23 means entries are valid from 08:00 to 22:59."
)

//======================================================================
// 6. DISPLAY INPUTS
//======================================================================

showDashboard = input.bool(true, "Show Dashboard", group = groupDisplay)
showAdrProjectionLines = input.bool(true, "Show ADR Projection Lines", group = groupDisplay)
showTradeLines = input.bool(true, "Show Entry, Stop and Target Lines", group = groupDisplay)

dashboardPositionInput = input.string(
     "Bottom Right",
     "Dashboard Position",
     options = [
          "Top Left", "Top Center", "Top Right",
          "Middle Left", "Middle Center", "Middle Right",
          "Bottom Left", "Bottom Center", "Bottom Right"
     ],
     group = groupDisplay
)

//======================================================================
// 7. COLOURS
//======================================================================

bullColour = input.color(color.rgb(20, 145, 85), "Bullish / Buy", group = groupColours)
bearColour = input.color(color.rgb(220, 45, 65), "Bearish / Sell", group = groupColours)
neutralColour = input.color(color.rgb(110, 115, 125), "Neutral", group = groupColours)
recoveryColour = input.color(color.rgb(235, 145, 25), "Interrupted / Recovery", group = groupColours)

colorGreen  = bullColour
colorRed    = bearColour
colorOrange = recoveryColour
colorBlue   = color.rgb(55, 115, 215)
colorGray   = neutralColour
colorPanel  = color.new(color.black, 12)
colorHeader = color.new(color.rgb(25, 30, 40), 0)

//======================================================================
// 8. TIMEFRAME AND DASHBOARD POSITION
//======================================================================

bool isH1Chart = timeframe.isminutes and timeframe.multiplier == 60

if barstate.isfirst and not isH1Chart
    runtime.error("The Black Anchor must be used on a standard 1-hour chart.")

dashboardPosition = switch dashboardPositionInput
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Top Right"     => position.top_right
    "Middle Left"   => position.middle_left
    "Middle Center" => position.middle_center
    "Middle Right"  => position.middle_right
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    => position.bottom_right

//======================================================================
// 9. H1 STRUCTURE ENGINE
//======================================================================

// PERSISTENT ENGINE VARIABLES
//---------------------------------------------------------------------

var float referenceHigh = na
var float referenceLow = na

// Unconfirmed extrema formed after the previous valid break.
var float trackedHigh = na
var float trackedLow = na
var int trackedHighBar = na
var int trackedLowBar = na

// 1 bullish, 0 neutral, -1 bearish.
var int direction = 0

var bool inRecovery = false
var int recoveryCount = 0
var int recoveryDirection = 0

// Origin bars of the current confirmed levels.
var int referenceHighOriginBar = na
var int referenceLowOriginBar = na

// Bar where each reference was most recently updated.
var int referenceHighUpdateBar = na
var int referenceLowUpdateBar = na

// Current line objects only.
var line referenceHighLine = na
var line referenceLowLine = na
var line trackedHighLine = na
var line trackedLowLine = na


//---------------------------------------------------------------------
// EVENT FLAGS
//---------------------------------------------------------------------

bool weeklyResetEvent = false
bool interruptionEvent = false
bool bullishBreakEvent = false
bool bearishBreakEvent = false
bool bullishConfirmedEvent = false
bool bearishConfirmedEvent = false
bool recoveryFirstBreakEvent = false
bool recoveryDirectionChangedEvent = false


//---------------------------------------------------------------------
// WEEKLY INITIALISATION
//---------------------------------------------------------------------

bool newTradingWeek = timeframe.change("1W")

if newTradingWeek or na(referenceHigh) or na(referenceLow)
    referenceHigh := high
    referenceLow := low

    trackedHigh := na
    trackedLow := na
    trackedHighBar := na
    trackedLowBar := na

    direction := 0

    inRecovery := false
    recoveryCount := 0
    recoveryDirection := 0

    referenceHighOriginBar := bar_index
    referenceLowOriginBar := bar_index
    referenceHighUpdateBar := bar_index
    referenceLowUpdateBar := bar_index

    weeklyResetEvent := true

else
    bool takesBothSides =
         high > referenceHigh and
         low < referenceLow

    //-----------------------------------------------------------------
    // STRUCTURE INTERRUPTION
    //-----------------------------------------------------------------

    if takesBothSides
        referenceHigh := high
        referenceLow := low

        referenceHighOriginBar := bar_index
        referenceLowOriginBar := bar_index
        referenceHighUpdateBar := bar_index
        referenceLowUpdateBar := bar_index

        trackedHigh := na
        trackedLow := na
        trackedHighBar := na
        trackedLowBar := na

        direction := 0

        inRecovery := true
        recoveryCount := 0
        recoveryDirection := 0

        interruptionEvent := true

    else
        bool bullishBodyBreak = close > referenceHigh
        bool bearishBodyBreak = close < referenceLow

        //-----------------------------------------------------------------
        // RECOVERY MODE
        //-----------------------------------------------------------------

        if inRecovery
            if bullishBodyBreak
                bullishBreakEvent := true

                float nextConfirmedLow =
                     not na(trackedLow) ? trackedLow : referenceLow

                int nextConfirmedLowBar =
                     not na(trackedLowBar) ? trackedLowBar : referenceLowOriginBar

                referenceLow := nextConfirmedLow
                referenceLowOriginBar := nextConfirmedLowBar
                referenceLowUpdateBar := bar_index

                referenceHigh := high
                referenceHighOriginBar := bar_index
                referenceHighUpdateBar := bar_index

                trackedHigh := na
                trackedLow := na
                trackedHighBar := na
                trackedLowBar := na

                if recoveryCount == 0
                    recoveryDirection := 1
                    recoveryCount := 1
                    recoveryFirstBreakEvent := true

                else if recoveryDirection == 1
                    recoveryCount += 1

                    if recoveryCount >= 2
                        direction := 1
                        inRecovery := false
                        recoveryCount := 0
                        recoveryDirection := 0
                        bullishConfirmedEvent := true

                else
                    recoveryDirection := 1
                    recoveryCount := 1
                    recoveryDirectionChangedEvent := true

            else if bearishBodyBreak
                bearishBreakEvent := true

                float nextConfirmedHigh =
                     not na(trackedHigh) ? trackedHigh : referenceHigh

                int nextConfirmedHighBar =
                     not na(trackedHighBar) ? trackedHighBar : referenceHighOriginBar

                referenceHigh := nextConfirmedHigh
                referenceHighOriginBar := nextConfirmedHighBar
                referenceHighUpdateBar := bar_index

                referenceLow := low
                referenceLowOriginBar := bar_index
                referenceLowUpdateBar := bar_index

                trackedHigh := na
                trackedLow := na
                trackedHighBar := na
                trackedLowBar := na

                if recoveryCount == 0
                    recoveryDirection := -1
                    recoveryCount := 1
                    recoveryFirstBreakEvent := true

                else if recoveryDirection == -1
                    recoveryCount += 1

                    if recoveryCount >= 2
                        direction := -1
                        inRecovery := false
                        recoveryCount := 0
                        recoveryDirection := 0
                        bearishConfirmedEvent := true

                else
                    recoveryDirection := -1
                    recoveryCount := 1
                    recoveryDirectionChangedEvent := true

            else
                if na(trackedHigh) or high > trackedHigh
                    trackedHigh := high
                    trackedHighBar := bar_index

                if na(trackedLow) or low < trackedLow
                    trackedLow := low
                    trackedLowBar := bar_index

        //-----------------------------------------------------------------
        // NORMAL MODE
        //-----------------------------------------------------------------

        else
            if bullishBodyBreak
                bullishBreakEvent := true

                int previousDirection = direction
                direction := 1

                float nextConfirmedLow =
                     not na(trackedLow) ? trackedLow : referenceLow

                int nextConfirmedLowBar =
                     not na(trackedLowBar) ? trackedLowBar : referenceLowOriginBar

                referenceLow := nextConfirmedLow
                referenceLowOriginBar := nextConfirmedLowBar
                referenceLowUpdateBar := bar_index

                referenceHigh := high
                referenceHighOriginBar := bar_index
                referenceHighUpdateBar := bar_index

                if previousDirection != 1
                    bullishConfirmedEvent := true

                trackedHigh := na
                trackedLow := na
                trackedHighBar := na
                trackedLowBar := na

            else if bearishBodyBreak
                bearishBreakEvent := true

                int previousDirection = direction
                direction := -1

                float nextConfirmedHigh =
                     not na(trackedHigh) ? trackedHigh : referenceHigh

                int nextConfirmedHighBar =
                     not na(trackedHighBar) ? trackedHighBar : referenceHighOriginBar

                referenceHigh := nextConfirmedHigh
                referenceHighOriginBar := nextConfirmedHighBar
                referenceHighUpdateBar := bar_index

                referenceLow := low
                referenceLowOriginBar := bar_index
                referenceLowUpdateBar := bar_index

                if previousDirection != -1
                    bearishConfirmedEvent := true

                trackedHigh := na
                trackedLow := na
                trackedHighBar := na
                trackedLowBar := na

            else
                if na(trackedHigh) or high > trackedHigh
                    trackedHigh := high
                    trackedHighBar := bar_index

                if na(trackedLow) or low < trackedLow
                    trackedLow := low
                    trackedLowBar := bar_index


//---------------------------------------------------------------------
// STATE TEXT
//---------------------------------------------------------------------

string directionText =
     direction == 1 ?
     "BULLISH" :
     direction == -1 ?
     "BEARISH" :
     "NEUTRAL"

string dashboardState =
     inRecovery and recoveryCount == 0 ?
     "INTERRUPTED" :
     inRecovery and recoveryCount == 1 and recoveryDirection == 1 ?
     "RECOVERY 1/2 UP" :
     inRecovery and recoveryCount == 1 and recoveryDirection == -1 ?
     "RECOVERY 1/2 DOWN" :
     directionText

color activeColour =
     inRecovery ?
     recoveryColour :
     direction == 1 ?
     bullColour :
     direction == -1 ?
     bearColour :
     neutralColour


//---------------------------------------------------------------------
// CLEAN EVENT MARKERS
//---------------------------------------------------------------------

// Minimal mode: symbols only.
plotshape(
     isMinimal and bullishConfirmedEvent,
     title = "Bullish Confirmed",
     style = shape.triangleup,
     location = location.belowbar,
     color = bullColour,
     size = size.normal,
     display = display.pane
)

plotshape(
     isMinimal and bearishConfirmedEvent,
     title = "Bearish Confirmed",
     style = shape.triangledown,
     location = location.abovebar,
     color = bearColour,
     size = size.normal,
     display = display.pane
)

plotshape(
     isMinimal and interruptionEvent,
     title = "Structure Interrupted",
     style = shape.diamond,
     location = location.abovebar,
     color = recoveryColour,
     size = size.small,
     display = display.pane
)

// Research and Debug: fixed labels.
plotshape(
     not isMinimal and bullishConfirmedEvent,
     title = "Bullish Confirmed Label",
     style = shape.labelup,
     location = location.belowbar,
     color = bullColour,
     text = "BULL",
     textcolor = color.white,
     size = size.tiny,
     display = display.pane
)

plotshape(
     not isMinimal and bearishConfirmedEvent,
     title = "Bearish Confirmed Label",
     style = shape.labeldown,
     location = location.abovebar,
     color = bearColour,
     text = "BEAR",
     textcolor = color.white,
     size = size.tiny,
     display = display.pane
)

plotshape(
     not isMinimal and interruptionEvent,
     title = "Interrupted Marker",
     style = shape.diamond,
     location = location.abovebar,
     color = recoveryColour,
     size = size.small,
     display = display.pane
)

// Body-break markers only in Research or Debug.
plotshape(
     showBreakMarkers and bullishBreakEvent and not bullishConfirmedEvent,
     title = "Bullish Body Break",
     style = shape.circle,
     location = location.belowbar,
     color = bullColour,
     size = size.tiny,
     display = display.pane
)

plotshape(
     showBreakMarkers and bearishBreakEvent and not bearishConfirmedEvent,
     title = "Bearish Body Break",
     style = shape.circle,
     location = location.abovebar,
     color = bearColour,
     size = size.tiny,
     display = display.pane
)

plotshape(
     isResearch and weeklyResetEvent,
     title = "Weekly Reset",
     style = shape.square,
     location = location.top,
     color = neutralColour,
     size = size.tiny,
     display = display.pane
)


//---------------------------------------------------------------------
// DEBUG LABELS
//---------------------------------------------------------------------

if showDetailedText and interruptionEvent
    label.new(
         bar_index,
         high,
         "INTERRUPTED\nRecovery 0/2",
         style = label.style_label_down,
         color = recoveryColour,
         textcolor = color.white,
         size = size.tiny
    )

if showDetailedText and recoveryFirstBreakEvent
    label.new(
         bar_index,
         recoveryDirection == 1 ? low : high,
         recoveryDirection == 1 ?
         "Recovery 1/2\nBullish" :
         "Recovery 1/2\nBearish",
         style = recoveryDirection == 1 ?
         label.style_label_up :
         label.style_label_down,
         color = recoveryColour,
         textcolor = color.white,
         size = size.tiny
    )

if showDetailedText and recoveryDirectionChangedEvent
    label.new(
         bar_index,
         recoveryDirection == 1 ? low : high,
         "Recovery reset\n1/2",
         style = recoveryDirection == 1 ?
         label.style_label_up :
         label.style_label_down,
         color = recoveryColour,
         textcolor = color.white,
         size = size.tiny
    )


//---------------------------------------------------------------------

//======================================================================
// 10. ADR CALCULATION
//======================================================================

adr = request.security(
     symbol = syminfo.tickerid,
     timeframe = "D",
     expression = ta.sma(high - low, adrLength)[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

newBrokerDay = ta.change(time("D")) != 0

var float todayHigh = na
var float todayLow = na

if barstate.isfirst or newBrokerDay
    todayHigh := high
    todayLow := low
else
    todayHigh := math.max(nz(todayHigh, high), high)
    todayLow := math.min(nz(todayLow, low), low)

todayRange = todayHigh - todayLow

adrUsed = not na(adr) and adr > 0.0 ? todayRange / adr * 100.0 : na
remainingAdr = not na(adr) ? math.max(adr - todayRange, 0.0) : na
projectedAdrHigh = not na(adr) ? todayLow + adr : na
projectedAdrLow = not na(adr) ? todayHigh - adr : na

executionZoneActive =
     not na(adrUsed) and
     adrUsed >= executionZoneMin and
     adrUsed <= executionZoneMax

//======================================================================
// 11. DAY AND TRADING WINDOW
//======================================================================

sgtDay = dayofweek(time, researchTimezone)
sgtHour = hour(time, researchTimezone)
sgtMinute = minute(time, researchTimezone)

sgtDayName = switch sgtDay
    dayofweek.monday    => "Monday"
    dayofweek.tuesday   => "Tuesday"
    dayofweek.wednesday => "Wednesday"
    dayofweek.thursday  => "Thursday"
    dayofweek.friday    => "Friday"
    dayofweek.saturday  => "Saturday"
    dayofweek.sunday    => "Sunday"
    => "Unknown"

activeTradingDay =
     sgtDay == dayofweek.tuesday or
     sgtDay == dayofweek.wednesday or
     sgtDay == dayofweek.thursday

observationDay =
     sgtDay == dayofweek.monday or
     sgtDay == dayofweek.friday

weekend =
     sgtDay == dayofweek.saturday or
     sgtDay == dayofweek.sunday

currentMinutes = sgtHour * 60 + sgtMinute
startMinutes = tradingStartHour * 60
endMinutes = tradingEndHour * 60

validTradingTime = currentMinutes >= startMinutes and currentMinutes < endMinutes

string tradingDayStatus =
     activeTradingDay ? "ACTIVE" :
     observationDay ? "OBSERVE" :
     "CLOSED"

string tradingTimeStatus = validTradingTime ? "VALID TRADING TIME" : "REST PERIOD"
string sgtTimeText = str.format_time(time, "HH:mm", researchTimezone) + " SGT"

allExecutionConditions = activeTradingDay and validTradingTime and executionZoneActive

//======================================================================
// 12. TRADE CALCULATOR
//======================================================================

isBuy = tradeDirection == "BUY"
entryPrice = entryMethod == "Current Price" ? close : manualEntryPrice
validEntry = entryMethod == "Current Price" or manualEntryPrice > 0.0

// Direct internal connection to the H1 Structure Engine.
stopPrice = isBuy ? referenceLow : referenceHigh

structureValid =
     not na(referenceHigh) and
     not na(referenceLow) and
     referenceHigh > referenceLow

validStop =
     structureValid and
     validEntry and
     stopPrice > 0.0 and
     (isBuy ? stopPrice < entryPrice : stopPrice > entryPrice)

stopDistance = validStop ? math.abs(entryPrice - stopPrice) : na

riskPercent = switch riskPreset
    "0.25%" => 0.25
    "0.50%" => 0.50
    "1.00%" => 1.00
    => customRiskPercent

riskAmount = accountSize * riskPercent / 100.0

rawLotSize =
     validStop and stopDistance > 0.0 and contractSize > 0.0
     ? riskAmount / (stopDistance * contractSize)
     : na

lotSize =
     not na(rawLotSize) and lotStep > 0.0
     ? math.floor(rawLotSize / lotStep) * lotStep
     : na

targetPrice =
     validStop
     ? isBuy
          ? entryPrice + stopDistance * rewardMultiple
          : entryPrice - stopDistance * rewardMultiple
     : na

tradeInputsValid = validEntry and validStop and not na(lotSize) and lotSize > 0.0

//======================================================================
// 13. STATUS COLOURS
//======================================================================

executionColor = executionZoneActive ? colorGreen : colorRed
tradingDayColor = activeTradingDay ? colorGreen : observationDay ? colorOrange : colorRed
tradingTimeColor = validTradingTime ? colorGreen : colorGray
directionColor = isBuy ? colorGreen : colorRed

//======================================================================
// 14. H1 REFERENCE LINES
//======================================================================

int highLineStart =
     lineStartChoice == "From level origin" ?
     referenceHighOriginBar :
     referenceHighUpdateBar

int lowLineStart =
     lineStartChoice == "From level origin" ?
     referenceLowOriginBar :
     referenceLowUpdateBar

if barstate.islast
    if not na(referenceHighLine)
        line.delete(referenceHighLine)
        referenceHighLine := na

    if not na(referenceLowLine)
        line.delete(referenceLowLine)
        referenceLowLine := na

    if not na(trackedHighLine)
        line.delete(trackedHighLine)
        trackedHighLine := na

    if not na(trackedLowLine)
        line.delete(trackedLowLine)
        trackedLowLine := na

    if showCurrentLevels and not na(referenceHigh)
        referenceHighLine := line.new(
             x1 = highLineStart,
             y1 = referenceHigh,
             x2 = bar_index + 1,
             y2 = referenceHigh,
             xloc = xloc.bar_index,
             extend = extend.right,
             color = bullColour,
             style = line.style_solid,
             width = 2
        )

    if showCurrentLevels and not na(referenceLow)
        referenceLowLine := line.new(
             x1 = lowLineStart,
             y1 = referenceLow,
             x2 = bar_index + 1,
             y2 = referenceLow,
             xloc = xloc.bar_index,
             extend = extend.right,
             color = bearColour,
             style = line.style_solid,
             width = 2
        )

    if showDebugLevels and not na(trackedHigh)
        trackedHighLine := line.new(
             x1 = trackedHighBar,
             y1 = trackedHigh,
             x2 = bar_index + 1,
             y2 = trackedHigh,
             xloc = xloc.bar_index,
             extend = extend.right,
             color = color.new(bearColour, 65),
             style = line.style_dotted,
             width = 1
        )

    if showDebugLevels and not na(trackedLow)
        trackedLowLine := line.new(
             x1 = trackedLowBar,
             y1 = trackedLow,
             x2 = bar_index + 1,
             y2 = trackedLow,
             xloc = xloc.bar_index,
             extend = extend.right,
             color = color.new(bullColour, 65),
             style = line.style_dotted,
             width = 1
        )

//======================================================================
// 15. OPTIONAL BACKGROUND
//======================================================================

color structureBackground =
     inRecovery ?
     color.new(recoveryColour, 91) :
     direction == 1 ?
     color.new(bullColour, 94) :
     direction == -1 ?
     color.new(bearColour, 94) :
     color.new(neutralColour, 96)

bgcolor(showStructureBackground ? structureBackground : na)

//======================================================================
// 16. ADR PROJECTION LINES
//======================================================================

var line adrHighLine = na
var line adrLowLine = na

if newBrokerDay
    if not na(adrHighLine)
        line.delete(adrHighLine)
    if not na(adrLowLine)
        line.delete(adrLowLine)
    adrHighLine := na
    adrLowLine := na

if showAdrProjectionLines and not na(projectedAdrHigh)
    if na(adrHighLine)
        adrHighLine := line.new(
             bar_index, projectedAdrHigh, bar_index + 1, projectedAdrHigh,
             extend = extend.right,
             color = executionColor,
             style = line.style_dashed,
             width = 1
        )
    else
        line.set_xy1(adrHighLine, bar_index, projectedAdrHigh)
        line.set_xy2(adrHighLine, bar_index + 1, projectedAdrHigh)
        line.set_color(adrHighLine, executionColor)

if showAdrProjectionLines and not na(projectedAdrLow)
    if na(adrLowLine)
        adrLowLine := line.new(
             bar_index, projectedAdrLow, bar_index + 1, projectedAdrLow,
             extend = extend.right,
             color = executionColor,
             style = line.style_dashed,
             width = 1
        )
    else
        line.set_xy1(adrLowLine, bar_index, projectedAdrLow)
        line.set_xy2(adrLowLine, bar_index + 1, projectedAdrLow)
        line.set_color(adrLowLine, executionColor)

if not showAdrProjectionLines
    if not na(adrHighLine)
        line.delete(adrHighLine)
        adrHighLine := na
    if not na(adrLowLine)
        line.delete(adrLowLine)
        adrLowLine := na

//======================================================================
// 17. ENTRY, STOP AND TARGET LINES
//======================================================================

var line entryLine = na
var line stopLine = na
var line targetLine = na

if barstate.islast
    if not na(entryLine)
        line.delete(entryLine)
    if not na(stopLine)
        line.delete(stopLine)
    if not na(targetLine)
        line.delete(targetLine)

    entryLine := na
    stopLine := na
    targetLine := na

    if showTradeLines and tradeInputsValid
        entryLine := line.new(
             bar_index, entryPrice, bar_index + 1, entryPrice,
             extend = extend.right,
             color = colorBlue,
             style = line.style_solid,
             width = 1
        )

        stopLine := line.new(
             bar_index, stopPrice, bar_index + 1, stopPrice,
             extend = extend.right,
             color = colorRed,
             style = line.style_solid,
             width = 1
        )

        targetLine := line.new(
             bar_index, targetPrice, bar_index + 1, targetPrice,
             extend = extend.right,
             color = colorGreen,
             style = line.style_dotted,
             width = 2
        )

//======================================================================
// 18. FORMATTING
//======================================================================

f_price(float value) =>
    na(value) ? "N/A" : str.tostring(value, format.mintick)

f_percent(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.0") + "%"

f_lot(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.00")

f_money(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#,###")

//======================================================================
// 19. UNIFIED DASHBOARD
//======================================================================

var table dashboard = table.new(
     dashboardPosition,
     2,
     19,
     bgcolor = colorPanel,
     frame_color = color.new(color.white, 72),
     frame_width = 1,
     border_color = color.new(color.white, 86),
     border_width = 1
)

if barstate.islast
    table.set_position(dashboard, dashboardPosition)

    if showDashboard
        normalBg = colorPanel
        sectionBg = color.new(color.rgb(45, 50, 60), 0)

        table.cell(dashboard, 0, 0, "THE BLACK ANCHOR", text_color = color.white, bgcolor = colorHeader, text_size = size.small)
        table.cell(dashboard, 1, 0, sgtDayName + "  " + sgtTimeText, text_color = color.white, bgcolor = colorHeader, text_size = size.small)

        table.cell(dashboard, 0, 1, "TRADING", text_color = color.white, bgcolor = sectionBg)
        table.cell(dashboard, 1, 1, "", text_color = color.white, bgcolor = sectionBg)

        table.cell(dashboard, 0, 2, "Trading Day", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 2, tradingDayStatus, text_color = tradingDayColor, bgcolor = normalBg)

        table.cell(dashboard, 0, 3, "Trading Window", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 3, tradingTimeStatus, text_color = tradingTimeColor, bgcolor = normalBg)

        table.cell(dashboard, 0, 4, "MARKET", text_color = color.white, bgcolor = sectionBg)
        table.cell(dashboard, 1, 4, "ADR (" + str.tostring(adrLength) + ")", text_color = color.white, bgcolor = sectionBg)

        table.cell(dashboard, 0, 5, "ADR", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 5, f_price(adr), text_color = color.white, bgcolor = normalBg)

        table.cell(dashboard, 0, 6, "ADR Used", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 6, f_percent(adrUsed), text_color = executionColor, bgcolor = normalBg)

        table.cell(dashboard, 0, 7, "Remaining ADR", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 7, na(remainingAdr) ? "N/A" : str.tostring(remainingAdr, "#.0"), text_color = color.white, bgcolor = normalBg)

        table.cell(dashboard, 0, 8, "Execution Zone", text_color = color.white, bgcolor = color.new(executionColor, 65))
        table.cell(dashboard, 1, 8, executionZoneActive ? "ACTIVE  40-80%" : "OUTSIDE  40-80%", text_color = color.white, bgcolor = color.new(executionColor, 65))

        table.cell(dashboard, 0, 9, "STRUCTURE", text_color = color.white, bgcolor = sectionBg)
        table.cell(dashboard, 1, 9, "", text_color = color.white, bgcolor = sectionBg)

        string highText = f_price(referenceHigh) + (not isBuy ? "  STOP" : "")
        string lowText = f_price(referenceLow) + (isBuy ? "  STOP" : "")

        table.cell(dashboard, 0, 10, "Reference High", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 10, highText, text_color = bullColour, bgcolor = normalBg)

        table.cell(dashboard, 0, 11, "Reference Low", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 11, lowText, text_color = bearColour, bgcolor = normalBg)

        table.cell(dashboard, 0, 12, "TRADE", text_color = color.white, bgcolor = sectionBg)
        table.cell(dashboard, 1, 12, "Trade #" + str.tostring(weeklyTradeNumber), text_color = color.white, bgcolor = sectionBg)

        table.cell(dashboard, 0, 13, "Direction", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 13, tradeDirection, text_color = directionColor, bgcolor = normalBg)

        table.cell(dashboard, 0, 14, "Entry", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 14, f_price(validEntry ? entryPrice : na), text_color = color.white, bgcolor = normalBg)

        table.cell(dashboard, 0, 15, "Stop (H1 Auto)", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 15, f_price(validStop ? stopPrice : na), text_color = colorRed, bgcolor = normalBg)

        table.cell(dashboard, 0, 16, "Account / Risk", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 16, f_money(accountSize) + " / " + str.tostring(riskPercent, "#.00") + "%", text_color = color.white, bgcolor = normalBg)

        table.cell(dashboard, 0, 17, "Lot Size", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 17, f_lot(lotSize), text_color = colorGreen, bgcolor = normalBg)

        table.cell(dashboard, 0, 18, str.tostring(rewardMultiple, "#.0") + "R Target", text_color = color.white, bgcolor = normalBg)
        table.cell(dashboard, 1, 18, f_price(targetPrice), text_color = colorGreen, bgcolor = normalBg)

    else
        table.clear(dashboard, 0, 0, 1, 18)

//======================================================================
// 20. HIDDEN OUTPUTS
//======================================================================

int engineStateCode = inRecovery ? 2 : direction == 0 ? 0 : 1

plot(direction, "DATA: Direction Code", display = display.none)
plot(engineStateCode, "DATA: Engine State Code", display = display.none)
plot(referenceHigh, "DATA: Reference High", display = display.none)
plot(referenceLow, "DATA: Reference Low", display = display.none)
plot(adr, "DATA: ADR", display = display.none)
plot(adrUsed, "DATA: ADR Used %", display = display.none)
plot(remainingAdr, "DATA: Remaining ADR", display = display.none)
plot(executionZoneActive ? 1 : 0, "DATA: Execution Zone Active", display = display.none)
plot(activeTradingDay ? 1 : 0, "DATA: Active Trading Day", display = display.none)
plot(validTradingTime ? 1 : 0, "DATA: Valid Trading Time", display = display.none)
plot(entryPrice, "DATA: Entry Price", display = display.none)
plot(stopPrice, "DATA: Auto Stop", display = display.none)
plot(lotSize, "DATA: Lot Size", display = display.none)
plot(targetPrice, "DATA: R Target", display = display.none)

//======================================================================
// 21. ALERTS
//======================================================================

alertcondition(bullishConfirmedEvent, "H1 Bullish Structure Confirmed", "The Black Anchor: H1 bullish structure confirmed.")
alertcondition(bearishConfirmedEvent, "H1 Bearish Structure Confirmed", "The Black Anchor: H1 bearish structure confirmed.")
alertcondition(interruptionEvent, "H1 Structure Interrupted", "The Black Anchor: H1 structure interrupted.")
alertcondition(executionZoneActive and not executionZoneActive[1], "Execution Zone Entered", "The Black Anchor: ADR entered the execution zone.")
alertcondition(allExecutionConditions and not allExecutionConditions[1], "Execution Conditions Ready", "The Black Anchor: trading day, time and ADR zone are aligned.")
