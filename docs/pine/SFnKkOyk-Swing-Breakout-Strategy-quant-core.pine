//@version=6
strategy("Swing Breakout Strategy (quant-core)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, pyramiding=0)

// ── Inputs (mirror the validated quant-core config) ──────────────────────────
breakoutLen = input.int(50,   "Breakout lookback (N-day high)", minval=5)
volMult     = input.float(1.5, "Volume x 50d avg",              minval=0.5, step=0.1)
maFast      = input.int(50,   "Fast MA",                        minval=2)
maSlow      = input.int(200,  "Slow MA",                        minval=5)
atrLen      = input.int(14,   "ATR length",                     minval=2)
trailMult   = input.float(4.0, "ATR trailing multiple",         minval=0.5, step=0.5)
watchPct    = input.float(3.0, "Developing: % below breakout",  minval=0.5, step=0.5)

// ── Backward-looking indicators ──────────────────────────────────────────────
smaF      = ta.sma(close, maFast)
smaS      = ta.sma(close, maSlow)
atrv      = ta.atr(atrLen)
volAvg    = ta.sma(volume, 50)
priorHigh = ta.highest(close, breakoutLen)[1]
warm      = not na(smaS) and not na(volAvg) and not na(priorHigh)

// ── Filter + trigger (identical logic to the engine) ─────────────────────────
uptrend    = close > smaF and close > smaS and smaF > smaS
breakout   = close > priorHigh and volume >= volMult * volAvg
goLong     = warm and uptrend and breakout
developing = warm and uptrend and not breakout and close < priorHigh and (priorHigh / close - 1.0) <= watchPct / 100.0

// ── Entry (market order fills next bar open = our backtest model) + live alert
if goLong and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    alert("Breakout TRIGGER - entry next open", alert.freq_once_per_bar_close)
if developing
    alert("Approaching breakout level", alert.freq_once_per_bar_close)

// ── ATR trailing exit: stop = (peak since entry) - trailMult*ATR, ratchets up
var float peak  = na
var float trail = na
if strategy.position_size > 0
    peak  := na(peak)  ? high : math.max(peak, high)
    cand   = peak - trailMult * atrv
    trail := na(trail) ? cand : math.max(trail, cand)
    strategy.exit("Trail", from_entry="Long", stop=trail)
else
    peak  := na
    trail := na

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(smaF, "50 MA", color=color.new(color.orange, 0))
plot(smaS, "200 MA", color=color.new(color.blue, 0))
plot(strategy.position_size > 0 ? trail : na, "Trail stop", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

plotshape(goLong and strategy.position_size == 0, title="Breakout entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="BUY")
plotshape(developing, title="Developing", style=shape.circle, location=location.belowbar, color=color.new(color.yellow, 0), size=size.tiny)
bgcolor(uptrend ? color.new(color.green, 92) : na, title="Uptrend regime")