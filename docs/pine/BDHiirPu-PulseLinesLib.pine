//@version=5
//@description  PulseLines morphic-level calculator (support & resistance)
//@author       brian8u7op
//@version      1.3.1
library("PulseLinesLib", false)

// getLevels(
//    lookback         — number of candles to scan (e.g. 100)
//    wickRatioThresh  — min wick/body ratio to count as “wick-heavy” (0–1, e.g. 0.5)
//    flatCandles      — cluster count required to confirm a level (e.g. 3)
//    tolerancePips    — pips tolerance around price for clustering (e.g. 1.5)
//    atrMult          — ATR multiplier to add extra tolerance (e.g. 0.15)
// ) → float[] [resistance, pivot, support]
export getLevels(int lookback, float wickRatioThresh, int flatCandles, float tolerancePips, float atrMult) =>
    // pip sizing and combined tolerance
    float pipSize     = syminfo.mintick
    float tolPrice    = tolerancePips * pipSize
    float atrConfirm  = ta.atr(10) * atrMult
    float totalTol    = tolPrice + atrConfirm

    // cluster counters & extremes
    var int   highClusters = 0
    var int   lowClusters  = 0
    float     maxWickHigh  = na
    float     minWickLow   = na

    // scan backwards for wick-heavy extremes
    for i = 0 to lookback - 1
        float hi    = high[i]
        float lo    = low[i]
        float op    = open[i]
        float cl    = close[i]
        float rng   = hi - lo
        if rng > 0
            float topWickPct = (hi - math.max(op, cl)) / rng
            float botWickPct = (math.min(op, cl) - lo) / rng

            // resistance cluster
            if topWickPct >= wickRatioThresh and math.abs(hi - cl) <= totalTol
                highClusters += 1
                maxWickHigh := na(maxWickHigh) ? hi : math.max(maxWickHigh, hi)

            // support cluster
            if botWickPct >= wickRatioThresh and math.abs(lo - cl) <= totalTol
                lowClusters += 1
                minWickLow  := na(minWickLow)  ? lo : math.min(minWickLow, lo)

    // enforce cluster threshold
    if highClusters < flatCandles
        maxWickHigh := na
    if lowClusters < flatCandles
        minWickLow  := na

    // fallback to simple extremes if no valid clusters
    maxWickHigh := nz(maxWickHigh, ta.highest(high, lookback))
    minWickLow  := nz(minWickLow,  ta.lowest(low, lookback))

    // pivot/mid-level
    float midLevel = (maxWickHigh + minWickLow) / 2

    // return [resistance, pivot, support]
    array.from(maxWickHigh, midLevel, minWickLow)