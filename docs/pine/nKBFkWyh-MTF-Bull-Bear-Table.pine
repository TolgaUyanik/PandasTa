//@version=6
indicator("MTF Bull/Bear Table", overlay = true)

// ─── Settings ─────────────────────────────────────────────────────────────
// NOTE: request.security limit is 40 (non-Pro) / 64 (Pro) unique calls.
// Number of calls = number of symbols x 5 timeframes. So: max ~8 symbols
// (non-Pro), ~12 symbols (Pro). Add/remove entries in the list below to
// match your plan.
//
// All tickers below point to the Hyperliquid perpetual market
// (exchange prefix "HYPERLIQUID", quoted in USDC, ".P" = perpetual —
// confirmed format, e.g. "HYPERLIQUID:HYPEUSDC.P").

symbolsInput = input.text_area(
     "HYPERLIQUID:BTCUSDC.P,HYPERLIQUID:ETHUSDC.P,HYPERLIQUID:SOLUSDC.P,HYPERLIQUID:LINKUSDC.P,HYPERLIQUID:SUIUSDC.P,HYPERLIQUID:HYPEUSDC.P,HYPERLIQUID:NEARUSDC.P,HYPERLIQUID:FARTCOINUSDC.P",
     "Symbols (comma-separated, with exchange prefix)")

showPrice   = input.bool(true, "Show price columns")
tablePos    = input.string("top_right", "Table position",
     options = ["top_left", "top_right", "bottom_left", "bottom_right"])
maFastLen   = input.int(20,  "Fast MA (bars)", minval = 1)
maSlowLen   = input.int(200, "Slow MA (bars)", minval = 1)

// ─── Colors (matches spec.png) ────────────────────────────────────────────
colBull   = color.new(#2ecc71, 15)
colBear   = color.new(#e05c4b, 15)
colNeut   = color.new(#2b2b2e, 0)
colHeadBg = color.new(#0d0d10, 0)
colHeadTx = color.new(#ffa726, 0)
colTickTx = color.new(#e8e8e8, 0)
colUpTx   = color.new(#4caf50, 0)
colDownTx = color.new(#e05c4b, 0)

// ─── Symbol and timeframe lists ──────────────────────────────────────────
symbols = str.split(symbolsInput, ",")
n       = array.size(symbols)

var string[] tfCodes  = array.from("5", "15", "60", "240", "1D")
var string[] tfLabels = array.from("5M", "15M", "1H", "4H", "D")
tfCount = array.size(tfCodes)

pos = tablePos == "top_left" ? position.top_left :
      tablePos == "top_right" ? position.top_right :
      tablePos == "bottom_left" ? position.bottom_left : position.bottom_right

// Extra price columns when showPrice: TICKER, PRICE, 24H%, 1H%, 4H% = 5 cols
colCount = tfCount + (showPrice ? 5 : 1)
var table t = table.new(pos, colCount, n + 1,
     border_width = 1, border_color = color.new(color.gray, 60),
     frame_color = color.new(color.gray, 60), frame_width = 1)

f_status(px, maFast, maSlow) =>
    bull = px > maFast and px > maSlow
    bear = px < maFast and px < maSlow
    bull ? "BULL" : bear ? "BEAR" : "NEUT"

f_bgColor(status) =>
    status == "BULL" ? colBull : status == "BEAR" ? colBear : colNeut

f_formatPrice(px) =>
    px >= 100 ? str.tostring(px, "#.##") : px >= 1 ? str.tostring(px, "#.####") : str.tostring(px, "#.########")

f_chgText(chg) =>
    na(chg) ? "—" : str.tostring(chg, "#.##") + "%"

f_chgColor(chg) =>
    na(chg) ? colTickTx : (chg >= 0 ? colUpTx : colDownTx)

// ─── Build the table (last bar only) ─────────────────────────────────────
if barstate.islast
    // Header
    table.cell(t, 0, 0, "TICKER", text_color = colHeadTx, bgcolor = colHeadBg)
    col0 = 1
    if showPrice
        table.cell(t, 1, 0, "PRICE", text_color = colHeadTx, bgcolor = colHeadBg)
        table.cell(t, 2, 0, "24H%",  text_color = colHeadTx, bgcolor = colHeadBg)
        table.cell(t, 3, 0, "4H%",   text_color = colHeadTx, bgcolor = colHeadBg)
        table.cell(t, 4, 0, "1H%",   text_color = colHeadTx, bgcolor = colHeadBg)
        
        col0 := 5
    for j = 0 to tfCount - 1
        table.cell(t, col0 + j, 0, array.get(tfLabels, j), text_color = colHeadTx, bgcolor = colHeadBg)

    // Rows
    for i = 0 to n - 1
        sym = array.get(symbols, i)
        tickerShown = str.contains(sym, ":") ? array.get(str.split(sym, ":"), 1) : sym
        table.cell(t, 0, i + 1, tickerShown, text_color = colTickTx, bgcolor = colHeadBg)

        float rowPrice = na
        float rowChg24 = na
        float rowChg1h = na
        float rowChg4h = na

        for j = 0 to tfCount - 1
            tf = array.get(tfCodes, j)
            // % change (close vs close[1]) is bundled into the SAME call
            // already made for this symbol/timeframe — adds zero extra requests.
            [px, maFast, maSlow, chgPct] = request.security(
                 sym, tf, [close, ta.sma(close, maFastLen), ta.sma(close, maSlowLen),
                 (close - close[1]) / close[1] * 100],
                 ignore_invalid_symbol = true)
            status = f_status(px, maFast, maSlow)
            table.cell(t, col0 + j, i + 1, na(px) ? "N/A" : status,
                 text_color = color.white, bgcolor = na(px) ? colNeut : f_bgColor(status))
            if tf == "1D"
                rowPrice := px
                rowChg24 := chgPct
            if tf == "60"
                rowChg1h := chgPct
            if tf == "240"
                rowChg4h := chgPct

        if showPrice
            table.cell(t, 1, i + 1, na(rowPrice) ? "—" : f_formatPrice(rowPrice),
                 text_color = colTickTx, bgcolor = colHeadBg)
            table.cell(t, 2, i + 1, f_chgText(rowChg24), text_color = f_chgColor(rowChg24), bgcolor = colHeadBg)
            table.cell(t, 3, i + 1, f_chgText(rowChg1h), text_color = f_chgColor(rowChg1h), bgcolor = colHeadBg)
            table.cell(t, 4, i + 1, f_chgText(rowChg4h), text_color = f_chgColor(rowChg4h), bgcolor = colHeadBg)
