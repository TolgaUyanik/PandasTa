// © richardgong1988 — ① Pinbar detector.
// Long wick ≥ longFrac of range (mandatory); short wick ≤ shortFrac (strict mode).

//@version=6
library("HanJinPinbar", overlay = true)
import richardgong1988/HanJinSigParser/1 as P

// Returns "BUY" (bull pinbar), "SELL" (bear pinbar), or na.
export side(simple float longFrac = 0.667, simple float shortFrac = 0.2, simple bool strict = true) =>
    [up, lo] = P.wickFracs()
    bull = not na(lo) and lo >= longFrac and (not strict or up <= shortFrac)
    bear = not na(up) and up >= longFrac and (not strict or lo <= shortFrac)
    bull ? "BUY" : bear ? "SELL" : na
