//@version=6
indicator("Log Return Distribution", overlay=true)
N = input.int(252, "Lookback Length", minval=10)
numBins = input.int(49, "Bin Count", minval=2, maxval=49)
maxLineLen = input.int(60, title="Max Line Length", minval=5, maxval=200)

logRet = math.log(close/close[1])

var line[] lineArr = array.new_line()

arr = array.new_float(1, logRet)
if not na(arr[1])
    arr := array.copy(arr[1])
    arr.push(logRet)
    if arr.size() > N
        arr.shift()

if barstate.islast and arr.size() == N
    
    for l in lineArr
        l.delete()
    lineArr.clear()

    float minRet = arr.min()
    float maxRet = arr.max()
    float maxAbsRet = math.max(math.abs(minRet), math.abs(maxRet))

    float histMin = -maxAbsRet
    float totalRange = 2 * maxAbsRet
    float binWidth = totalRange > 0 ? totalRange / numBins : 0.0000000001

    bins = array.new_int(numBins, 0)
    for r in arr
        int binIndex = math.floor((r-histMin) / binWidth)
        binIndex := math.min(binIndex, numBins - 1)

        bins.set(binIndex, bins.get(binIndex)+1)
    
    int maxCount = bins.max()

    if maxCount > 0
        int zeroBinIndex = -1
        if binWidth > 0
            zeroBinIndex := math.floor(-histMin/binWidth)
        
        for i = 0 to numBins - 1
            int count = bins.get(i)
            float binCenterReturn = histMin + (i + 0.5) * binWidth
            float priceLevel = open * math.exp(binCenterReturn)
            int lineLength = math.ceil((float(count) / float(maxCount)) * maxLineLen)
            color lineColor = i == zeroBinIndex ? color.orange : color.white
            
            line newLine = line.new(bar_index+1, priceLevel, bar_index+1+lineLength, priceLevel, color=lineColor, width=2)
            lineArr.push(newLine)





