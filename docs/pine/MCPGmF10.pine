//@version=6
library(title = 'smaemarvwapClaire', overlay = true)


export repeat_character(int count) => array.join(array.new<string>(count,'p'), "")
// 计算单根K线的宽度（毫秒）
export f_1_k_line_width() => timeframe.in_seconds()*1000

// 判断p1 p2 是否在label_merge_range 百分比区间内
export is_price_in_merge_range(float p1,float  p2,float label_merge_range) => math.abs((p2 - p1) / p1 * 100) < label_merge_range

// VWAP快照结构体 - 存储VWAP及其通道数据
export type vwap_snapshot
    int   t
    float vwap
    float upper1
    float lower1
    float upper2
    float lower2
    float upper3
    float lower3

// VWAP关键级别绘图设置结构体 - 控制VWAP显示参数
export type VWAP_key_levels_draw_settings
    bool    enable                                 // vwap控制
    int     index                                  // 新增：存储在同周期中的索引
    string  anchor                                 // 新增：存储周期标识符
    string  session
    color   vwap_col
    color   bands_col
    color   bg_color
    color   text_color
    bool    val
    bool    poc
    bool    vah
    bool    enable2x
    bool    enable3x
    bool    o_control = false
    bool    h_control = false
    bool    l_control = false
    bool    c_control = false
    bool    extend_control = false
    bool    only_show_the_lastone_control = false
    bool    bg_control = false
    color   line_col_labeltext_col

// K线数据结构体 - 存储单根K线的完整数据
export type bardata                // --- bardata 结构体 ---
    float     o
    float     h
    float     l
    float     c
    float     v
    int       start_time
    int       end_time

// 移动平均设置结构体 - 控制各类移动平均线的参数
export type ma_setting             // sma ma ema rvwap
    bool        day_control     // 数据选取D级别还是当前图表周期的控制
    int 	    kline_numbers
	color 	    ma_color
    color 	    ema_color
    color 	    rvwap_color
    bool 	    ma_control
	bool 	    ema_control
	bool 	    rvwap_control
    string      session


ma_group = 'SMA + EMA + RVWAP'
var ma_settings_1 = ma_setting.new(day_control=input.bool(true,title='D?',inline='1',group=ma_group) ,kline_numbers=input.int(30,title='', inline='1',group=ma_group,options=[7,14,21,30,60,90,100,180,200,365,730,1000,1095,1460,1825,3650]), ma_color=input.color(color.rgb(238, 223, 123),title='',inline='1',group=ma_group),ema_color=input.color(color.rgb(238, 223, 123),title='',inline='1',group=ma_group),rvwap_color=input.color(color.rgb(238, 223, 123),title='',inline='1',group=ma_group),ma_control=input.bool(false,title='M',inline='1',group=ma_group),ema_control=input.bool(false,title='E',inline='1',group=ma_group),rvwap_control=input.bool(true,title='Rvwap',inline='1',group=ma_group))
var ma_settings_2 = ma_setting.new(day_control=input.bool(true,title='D?',inline='2',group=ma_group) ,kline_numbers=input.int(90,title='', inline='2',group=ma_group,options=[7,14,21,30,60,90,100,180,200,365,730,1000,1095,1460,1825,3650]), ma_color=input.color(#bbd4bcfb,title='',inline='2',group=ma_group),ema_color=input.color(#bbd4bcfb,title='',inline='2',group=ma_group),rvwap_color=input.color(#bbd4bcfb,title='',inline='2',group=ma_group),ma_control=input.bool(false,title='M',inline='2',group=ma_group),ema_control=input.bool(false,title='E',inline='2',group=ma_group),rvwap_control=input.bool(true,title='Rvwap',inline='2',group=ma_group))
var ma_settings_3 = ma_setting.new(day_control=input.bool(true,title='D?',inline='3',group=ma_group) ,kline_numbers=input.int(365,title='', inline='3',group=ma_group,options=[7,14,21,30,60,90,100,180,200,365,730,1000,1095,1460,1825,3650]),ma_color=input.color(#add556,title='',inline='3',group=ma_group),ema_color=input.color(#d1dfb2,title='',inline='3',group=ma_group),rvwap_color=input.color(#d1dfb2,title='',inline='3',group=ma_group),ma_control=input.bool(false,title='M',inline='3',group=ma_group),ema_control=input.bool(false,title='E',inline='3',group=ma_group),rvwap_control=input.bool(true,title='Rvwap',inline='3',group=ma_group))


export get_pre_label_string(VWAP_key_levels_draw_settings  kc,int t,bool  is_every)=>
    daily_pre = array.from('Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat')
    string pre_label = ''
    if is_every==false
        pre_label := repeat_character(kc.index) + kc.anchor
    if kc.anchor == 'D' and kc.session == "Weekend"
        pre_label := "Weekend"
    if kc.anchor == 'D' and kc.session == "Week"
        pre_label := "Week"
    if is_every==true and kc.anchor == 'D' and kc.session != "Week" and kc.session != "Weekend"
        pre_label := array.get(daily_pre,dayofweek(t)-1)
    if is_every== true and kc.anchor == 'W'
        pre_label := str.tostring(weekofyear(t,'UTC+0')) +'-'+kc.anchor
    if is_every== true and kc.anchor == 'M'
        pre_label := str.tostring(month(t,'UTC+0')) +'-'+kc.anchor
    if is_every== true and kc.anchor == 'Q'
        pre_label :=  str.tostring(math.floor((month(t,'UTC+0') + 2) / 3)) +'-'+kc.anchor
    if is_every== true and (kc.anchor == 'Y' or kc.anchor == '2Y' or kc.anchor == '3Y' or kc.anchor == '4Y' or kc.anchor == '5Y' or kc.anchor == '10Y')
        pre_label := str.tostring(year(t,'UTC+0')) +'-'+kc.anchor
    if kc.anchor == 'INTRADAY'
        pre_label := kc.session
    pre_label



// ---------------------------------------------------------------------------------
// * 检测新周期开始函数
// * @param str - 周期字符串 (D, W, M, Q, Y, 6M, 2Y, 3Y, 5Y, 10Y)
// * @return [是否新周期开始, 周期毫秒数]
// ---------------------------------------------------------------------------------
export f_is_new_period_from_str(string str) =>
    switch str
        'D'    =>  [timeframe.change('D'),  86400000      ]
        'W'    =>  [timeframe.change('W'),  604800000     ]
        '2W'   =>  [timeframe.change('2W'), 1209600000    ]
        'M'    =>  [timeframe.change('M'),  2678400000    ]
        'Q'    =>  [timeframe.change('3M') , 7776000000   ]
        'Y'    =>  [timeframe.change('12M'), 31536000000  ]
        '6M'   =>  [timeframe.change('6M') , 15724800000  ]    // 六个月变化
        '2Y'   =>  [(year(time,'UTC+0') % 2 != 0 and year(time+ timeframe.in_seconds() * 1000,'UTC+0') % 2 == 0),  63072000000]
        '3Y'   =>  [(year(time,'UTC+0') % 3 != 0 and year(time+ timeframe.in_seconds() * 1000,'UTC+0') % 3 == 0),  94608000000]
        '4Y'   =>  [(year(time,'UTC+0') % 4 != 0 and year(time + timeframe.in_seconds() * 1000,'UTC+0') % 4 == 0),  126230400000] // 四年变化
        '5Y'   =>  [ (year(time,'UTC+0') % 5 != 0 and year(time+ timeframe.in_seconds() * 1000,'UTC+0') % 5 == 0), 157680000000 ]
        '10Y'  =>  [(year(time,'UTC+0') % 10 != 0 and year(time+ timeframe.in_seconds() * 1000,'UTC+0') % 10 == 0) ,315360000000]

///**
// * 计算指定时间窗口内的源数据总和（滑动窗口累加）
// * @param source 数据源（如价格、成交量等）
// * @param days 时间窗口天数
// * @param ma_set 移动平均设置对象
// * @return float 指定时间窗口内的数据总和
// */
export total_for_time_when(series float source, int days ,ma_setting ma_set) =>
    var array<float> sources   = array.new<float>(0)
    var array<int>   times     = array.new<int>(0)
    var float        result    = 0.0
    float ms = ma_set.day_control == true ? 86400000 * days: f_1_k_line_width() * days
    if not na(source)
        sources.push(source)
        times.push(time)
        result += source
        while sources.size() > 1 and time - times.first() >= ms
            result -= sources.shift()
            times.shift()
    sources.size() < 1 ? na : result

///**
// * 计算SMA、EMA和滚动VWAP指标值
// * @param src 数据源（价格序列）
// * @param length 计算周期长度
// * @param ma_settings 移动平均设置对象
// * @return array 包含[SMA值, EMA值, 滚动VWAP值]的数组
// */
export f_calculate_sma_ema_rolling_vwap(series float src,int length,ma_setting ma_settings )=> [ta.sma(source = src,length = length),ta.ema(source = src,length = length), total_for_time_when(hlc3*volume, length,ma_set=ma_settings) /total_for_time_when(volume, length , ma_set=ma_settings )]

///**
// * 计算SMA、EMA和滚动VWAP指标值
// * @param ma_settings 移动平均设置对象
// * @return array 包含[SMA, EMA, 滚动VWAP]的数组
// */
export f_calculate_sma_ema_rvwap(ma_setting  ma_settings )=>
    src = (ma_settings.day_control == false) and  timeframe.isintraday ? request.security(symbol=syminfo.tickerid, timeframe='', expression=close, gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true ) : request.security(symbol=syminfo.tickerid, timeframe='D', expression=close, gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true )
    //src = ma_settings.day_control == true ?request.security(symbol=syminfo.tickerid, timeframe='D', expression=close, gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true ): request.security(symbol=syminfo.tickerid, timeframe='', expression=close, gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true )
    if  na(src) and barstate.islast
        src := close
    switch ma_settings.kline_numbers
        7    => f_calculate_sma_ema_rolling_vwap(src, 7, ma_settings )
        14   => f_calculate_sma_ema_rolling_vwap(src, 14, ma_settings )
        21   => f_calculate_sma_ema_rolling_vwap(src, 21, ma_settings )
        30   => f_calculate_sma_ema_rolling_vwap(src, 30, ma_settings )
        60   => f_calculate_sma_ema_rolling_vwap(src, 60, ma_settings )
        90   => f_calculate_sma_ema_rolling_vwap(src, 90, ma_settings )
        100  => f_calculate_sma_ema_rolling_vwap(src, 100, ma_settings )
        180  => f_calculate_sma_ema_rolling_vwap(src, 180, ma_settings )
        200  => f_calculate_sma_ema_rolling_vwap(src, 200, ma_settings )
        365  => f_calculate_sma_ema_rolling_vwap(src, 365, ma_settings )
        730  => f_calculate_sma_ema_rolling_vwap(src, 730, ma_settings )
        1000 => f_calculate_sma_ema_rolling_vwap(src, 1000, ma_settings )
        1095 => f_calculate_sma_ema_rolling_vwap(src, 1095, ma_settings )
        1460 => f_calculate_sma_ema_rolling_vwap(src, 1460, ma_settings )
        1825 => f_calculate_sma_ema_rolling_vwap(src, 1825, ma_settings )
        3650 => f_calculate_sma_ema_rolling_vwap(src, 3650, ma_settings )

//*
//* 生成移动平均线的显示标签
//* @param ma_settings 移动平均设置对象
//* @param sma 简单移动平均值
//* @param ema 指数移动平均值
//* @param rolling_vwap 滚动VWAP值
//* @return array 包含[MA标签, EMA标签, RVWAP标签]的数组
//*/
export f_get_ma_pre_label(ma_setting ma_settings, series float sma, series float ema, float rolling_vwap) => [str.tostring(ma_settings.kline_numbers)+(ma_settings.day_control? '-D-':'-')+'MA: '+ str.tostring(sma,format.mintick), str.tostring(ma_settings.kline_numbers)+(ma_settings.day_control? '-D-':'-')+'EMA: ' + str.tostring(ema, format.mintick), str.tostring(ma_settings.kline_numbers)+(ma_settings.day_control? '-D-':'-')+'RVWAP: ' + str.tostring(rolling_vwap,format.mintick)]


//* 计算移动平均指标
//* @param ma_settings MA设置对象
//* @returns [sma, ema, rvwap] 根据控制开关返回对应指标
export f_smart_ma_calculation(ma_setting ma_settings2) =>
    any_enabled = ma_settings2.ma_control != false or ma_settings2.ema_control != false or ma_settings2.rvwap_control != false
    if any_enabled
        [sma, ema, rolling_vwap]  = f_calculate_sma_ema_rvwap(ma_settings2)
        [ma_label, ema_label, rvwap_label] = f_get_ma_pre_label(ma_settings2, sma, ema, rolling_vwap)
        [sma, ema, rolling_vwap, ma_label, ema_label, rvwap_label]
    else
        [na, na, na, na, na, na]


export f_calculate_endpoint(int start_time ,VWAP_key_levels_draw_settings kc,bool is_every,int endp,bool extend1= false,bool extend2= false, int line_label_extend_length) =>
    time_diff = timenow - start_time
    var int endpoint_time = na

    if kc.anchor == 'D'// 日级别的特殊处理
        if is_every == false
            endpoint_time := int(timenow + line_label_extend_length * f_1_k_line_width())  // is_every=false时，视为only_show_the_lastone_control=true
        else
            if kc.only_show_the_lastone_control// is_every=true时
                if time_diff < 604800000            // 一周的毫秒数// 只画一周内的数据
                    endpoint_time := int(timenow + line_label_extend_length * f_1_k_line_width())
                else
                    endpoint_time := na  // 不画这条线
            else if kc.extend_control
                endpoint_time := int(start_time + 604800000)// extend_control开启，延伸到下一个同周期开始
            else if  kc.session== "Weekend"
                endpoint_time := start_time + 86400000*2
            else if  kc.session== "Week"
                endpoint_time := start_time + 86400000*5
            else
                endpoint_time := int(start_time + 86400000 )

    else if (kc.anchor == 'W' or kc.anchor == 'M' or kc.anchor == 'Q' or kc.anchor == 'Y' or kc.anchor == '2Y' or kc.anchor == '3Y' or kc.anchor == '4Y' or kc.anchor == '5Y' or kc.anchor == '10Y') and is_every == false// 周/月/季/年级别
        endpoint_time := int(timenow + line_label_extend_length * f_1_k_line_width())
    else if (kc.anchor == 'W' or kc.anchor == 'M' or kc.anchor == 'Q' or kc.anchor == 'Y' or kc.anchor == '2Y' or kc.anchor == '3Y' or kc.anchor == '4Y' or kc.anchor == '5Y' or kc.anchor == '10Y') and is_every == true
        [_,ms] = f_is_new_period_from_str(kc.anchor)
        endpoint_time := int(start_time + ms * (extend1 ? 2 : 1) * (extend2 ? 3 : 1))
        endpoint_time := (endpoint_time > int(timenow + line_label_extend_length * f_1_k_line_width())) ? int(timenow + line_label_extend_length * f_1_k_line_width()) :  endpoint_time
    else if kc.anchor ==  'INTRADAY'
        if kc.extend_control == false
            endpoint_time := endp
        if kc.extend_control == true
            endpoint_time := start_time +  86400000
        if kc.only_show_the_lastone_control ==true and time_diff > 86400000
            endpoint_time := na  // 不画这条线
        if kc.only_show_the_lastone_control ==true and time_diff < 86400000
            endpoint_time := int(timenow + line_label_extend_length * f_1_k_line_width())
    else
        endpoint_time := int(timenow + line_label_extend_length * f_1_k_line_width())
    endpoint_time


export type merge_label_template
    chart.point left_point
    chart.point right_point
    string  label_text
    float   p                   // 具体的价格数据
    color   label_color
    bool    merge_init_false    // 是否聚合 初始为没有


// ============================================================================
// 函数：单条线段和标签绘制工厂函数
// ============================================================================
// @function 根据两个点创建线段和/或标签，并将其添加到对应的数组中
// @param left_point 左侧起点坐标
// @param right_point 右侧终点坐标
// @param line_col 线段颜色
// @param line_width 线段宽度
// @param lines_style_select 线段样式（实线、虚线等）
// @param labeltext_col 标签文字颜色
// @param label_text_size 标签文字大小
// @param label_array 存储标签对象的数组
// @param line_array 存储线段对象的数组
// @param label_col 标签背景颜色（默认：半透明色）
// @param label_text 标签文字内容（默认：空字符串）
// @param l1 是否创建线段（默认：false）
// @param label1 是否创建标签（默认：false）
// @returns void
export f_single_line_label_fatory(chart.point left_point,chart.point right_point,color line_col,int line_width,string lines_style_select,color labeltext_col,string label_text_size,array<label> label_array,array<line> line_array,color label_col= #c5ace800,string label_text='',bool l1=false,bool label1=false)=>
    label label_s = na
    line  line_s  = na
    if l1
        line_s := line.new(left_point,right_point,xloc=xloc.bar_time, color=line_col ,width= line_width, style=lines_style_select )
        array.push(line_array  , line_s )
    if label1
        label_s := label.new(right_point,text= label_text, xloc=xloc.bar_time,size=label_text_size, textcolor=labeltext_col, color=label_col,style=label.style_label_left )
        array.push(label_array , label_s)
    [line_s ,label_s]


export f_line_and_label_merge_func(int t,float data,string l_text,VWAP_key_levels_draw_settings kc,bool is_every,int endp,map<float, merge_label_template> merge_str_map,array<label> label_array,array<line> line_array ,bool extend1,bool extend2 ,int line_label_extend_length,bool label_merge_control,int line_width,string lines_style_select,string label_text_size )=>
    endpoint_time = f_calculate_endpoint(t, kc, is_every, endp, extend1, extend2, line_label_extend_length)
    //log.error('标签文本  ==  '+ str.tostring(l_text ))
    if not na(endpoint_time)                                        // 如果endpoint_time为na，说明不应该画这条线（被only_show_the_lastone_control过滤）
        end_point = chart.point.from_time(endpoint_time, data)
        switch label_merge_control
            true =>
                map.put(merge_str_map, data, merge_label_template.new(chart.point.from_time(t,data), end_point, l_text, data,  kc.line_col_labeltext_col, false))
                f_single_line_label_fatory(left_point=chart.point.from_time(t, data),right_point=end_point,line_col=kc.line_col_labeltext_col,line_width=line_width,lines_style_select=lines_style_select, labeltext_col=kc.line_col_labeltext_col,label_text_size=label_text_size,label_array=label_array ,line_array=line_array,label_text=l_text, l1=true, label1=false)
            false =>
                f_single_line_label_fatory(left_point=chart.point.from_time(t, data),right_point=end_point,line_col=kc.line_col_labeltext_col,line_width=line_width,lines_style_select=lines_style_select, labeltext_col=kc.line_col_labeltext_col,label_text_size=label_text_size,label_array=label_array ,line_array=line_array,label_text=l_text, l1=true, label1=true)


export plot_ohlc(VWAP_key_levels_draw_settings kc,bardata ohlc_data,bool extend1,bool extend2,map<float, merge_label_template> merge_str_map,array<label> label_array,array<line> line_array ,bool is_every=false,int line_label_extend_length,bool label_merge_control,int line_width,string lines_style_select,string label_text_size)=>
    pre_label = get_pre_label_string(kc,t=ohlc_data.start_time, is_every=is_every )
    if kc.o_control
        f_line_and_label_merge_func(t=int(ohlc_data.start_time),data=ohlc_data.o,l_text=pre_label+' - '+'O' +' : '+str.tostring(ohlc_data.o,format.mintick),kc=kc, is_every=is_every, endp=kc.anchor=='INTRADAY'?ohlc_data.end_time: ohlc_data.start_time, merge_str_map=merge_str_map,label_array= label_array,line_array=line_array ,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.h_control
        f_line_and_label_merge_func(t=int(ohlc_data.start_time),data=ohlc_data.h,l_text=pre_label+' - '+'H' +' : '+str.tostring( ohlc_data.h, format.mintick),kc=kc,is_every=is_every, endp= kc.anchor=='INTRADAY'?ohlc_data.end_time: ohlc_data.start_time,  merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.l_control
        f_line_and_label_merge_func(t=int(ohlc_data.start_time),data=ohlc_data.l,l_text=pre_label+' - '+'L' +' : '+str.tostring( ohlc_data.l, format.mintick),kc=kc,is_every=is_every, endp= kc.anchor=='INTRADAY'?ohlc_data.end_time: ohlc_data.start_time,  merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.c_control
        f_line_and_label_merge_func(t=int(ohlc_data.start_time),data=ohlc_data.c,l_text=pre_label+' - '+'C' +' : '+str.tostring( ohlc_data.c, format.mintick),kc=kc,is_every=is_every, endp= kc.anchor=='INTRADAY'?ohlc_data.end_time: ohlc_data.start_time,  merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    false


export plot_vwap_keylevels(VWAP_key_levels_draw_settings kc,vwap_snapshot vwap_data,bool extend1,bool extend2,map<float, merge_label_template> merge_str_map,array<label> label_array,array<line> line_array ,bool is_every=false,int line_label_extend_length,bool label_merge_control,int line_width,string lines_style_select,string label_text_size)=>
    pre_label = get_pre_label_string(kc, t=vwap_data.t, is_every=is_every)
    // -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    if kc.val  and is_every==false
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.lower1, l_text=pre_label + ' - '+'val' +' : '+str.tostring(vwap_data.lower1, format.mintick), kc=kc, is_every=false,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.poc and is_every==false
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.vwap, l_text=pre_label  +' - '+ 'poc' +' : '+str.tostring(vwap_data.vwap, format.mintick), kc=kc, is_every=false ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.vah and is_every == false
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.upper1,l_text=pre_label + ' - '+'vah' +' : '+str.tostring(vwap_data.upper1, format.mintick), kc=kc, is_every=false ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.enable2x and is_every==false
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.upper2,l_text=pre_label + ' - '+'va2h' +' : '+str.tostring(vwap_data.upper2, format.mintick),kc= kc, is_every=false ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.lower2,l_text=pre_label + ' - '+ 'va2l' +' : '+str.tostring(vwap_data.lower2, format.mintick),kc= kc, is_every=false ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.enable3x  and is_every==false
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.upper3,l_text=pre_label + ' - '+'va3h' +' : '+str.tostring(vwap_data.upper3, format.mintick), kc= kc, is_every=false ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.lower3,l_text=pre_label +  ' - '+'va3l' +' : '+str.tostring(vwap_data.lower3, format.mintick), kc=kc, is_every=false ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    // -----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    if kc.val and is_every==true
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.lower1,l_text=pre_label +' - '+ 'val'+' : '+str.tostring(vwap_data.lower1, format.mintick), kc=kc, is_every=true ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.poc and is_every==true
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.vwap,l_text=pre_label  + ' - '+'poc'+' : '+str.tostring(vwap_data.vwap, format.mintick), kc=kc, is_every=true ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.vah and is_every==true
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.upper1,l_text=pre_label + ' - '+'vah'+' : '+str.tostring(vwap_data.upper1, format.mintick), kc=kc,is_every=true ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.enable2x and is_every==true
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.upper2,l_text=pre_label + ' - '+'va2h'+' : '+str.tostring(vwap_data.upper2, format.mintick),  kc=kc, is_every=true ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.lower2,l_text=pre_label + ' - '+'va2l'+' : '+str.tostring(vwap_data.lower2, format.mintick), kc=kc, is_every=true ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
    if kc.enable3x and is_every==true
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.upper3,l_text=pre_label + ' - '+'va3h'+' : '+str.tostring(vwap_data.upper3, format.mintick),  kc=kc, is_every=true ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )
        f_line_and_label_merge_func(t=vwap_data.t, data=vwap_data.lower3,l_text=pre_label + ' - '+'va3l'+' : '+str.tostring(vwap_data.lower3, format.mintick),  kc=kc, is_every=true ,endp=0,merge_str_map=merge_str_map,label_array=label_array,line_array=line_array,extend1=extend1, extend2=extend2, line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width=line_width,lines_style_select=lines_style_select,label_text_size=label_text_size )


export plot_vwap_bardata(VWAP_key_levels_draw_settings kc,bardata ohlc_data ,vwap_snapshot vwap_data,bool extend1,bool extend2,map<float, merge_label_template> merge_str_map,array<label> label_array,array<line> line_array ,bool is_every,int line_label_extend_length,bool label_merge_control,int line_width,string lines_style_select,string label_text_size)=>
    plot_vwap_keylevels(kc=kc, vwap_data=vwap_data, extend1=extend1, extend2=extend2,merge_str_map= merge_str_map,label_array=label_array,line_array=line_array,is_every=is_every,line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width= line_width,lines_style_select=lines_style_select,label_text_size=label_text_size)
    plot_ohlc(kc=kc, ohlc_data=ohlc_data ,extend1=extend1, extend2=extend2,merge_str_map= merge_str_map,label_array=label_array,line_array=line_array,is_every=is_every,line_label_extend_length=line_label_extend_length,label_merge_control=label_merge_control,line_width= line_width,lines_style_select=lines_style_select,label_text_size=label_text_size)




export f_start_end_total_min(string session)=>
    current_total_min = hour(time, 'UTC') * 60 + minute(time, 'UTC')
    start_total_min =  str.tonumber(str.substring(array.first(str.split(session,'-')), 0, 2)) * 60 + str.tonumber(str.substring(array.first(str.split(session,'-')), 2, 4))
    end_total_min =  str.tonumber(str.substring(array.last(str.split(session,'-')), 0, 2)) * 60 + str.tonumber(str.substring(array.last(str.split(session,'-')), 2, 4))
    [current_total_min,start_total_min,end_total_min, (current_total_min >= start_total_min  and current_total_min < end_total_min)]


export type anchor_snapshots                               // --- 每个周期的快照容器 ---
    array<vwap_snapshot>    vwap_current            // 当前 VWAP 快照数组
    array<vwap_snapshot>    vwap_historical         // 历史 VWAP 快照数组
    array<bardata>          bardata_current         // 当前 bardata 快照数组
    array<bardata>          bardata_historical      // 历史 bardata 快照数组
    //array<tpo_snapshot>              array_tpo_snapshot      // 当前 tpo_snapshot 快照数组
    //array<tpo_brick>                 array_brick             // 历史，每个周期不断存储的砖块数组

export type data_manager                                                   // 通用管理器
    map<string, anchor_snapshots>               snapshots_map      // 周期快照
    map<string, VWAP_key_levels_draw_settings>  draw_settings_map  // 周期控件


export f_get_vwap_array(string anchor1,data_manager data_manager,bool is_historical=false) =>    // 获取 vwap 快照数组
    period_snap = map.get(data_manager.snapshots_map, anchor1)
    if not na(period_snap)
        is_historical ? period_snap.vwap_historical : period_snap.vwap_current

// 获取 bardata 快照数组
export f_get_bardata_array(string anchorh,data_manager data_manager,bool is_historical=false) =>
    period_snap = map.get(data_manager.snapshots_map, anchorh)
    if not na(period_snap)
        is_historical ? period_snap.bardata_historical : period_snap.bardata_current









