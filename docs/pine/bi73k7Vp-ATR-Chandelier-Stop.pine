//@version=6
indicator(
     title="Trade Control ATR Chandelier Stop",
     shorttitle="TC ATR",
     overlay=true
)

//────────────────────────────────────────────────────────────────────
// Core settings
//────────────────────────────────────────────────────────────────────

atrLength = input.int(
     14,
     minval=1,
     title="ATR Period",
     tooltip="Number of chart bars used to calculate Average True Range. The recommended daily default is 14.",
     group="Core Settings"
)

lookback = input.int(
     22,
     minval=1,
     title="Chandelier Lookback",
     tooltip="Number of chart bars used to find the highest high for the long stop and the lowest low for the short stop. The recommended daily default is 22.",
     group="Core Settings"
)

multiplierMode = input.string(
     "Auto by ATR%",
     title="Multiplier Mode",
     options=[
          "Standard",
          "Auto by ATR%",
          "Beta Based",
          "Manual"
     ],
     tooltip="Standard uses one fixed multiplier. Auto by ATR% selects a tier using the symbol's recent volatility. Beta Based selects a tier using rolling beta versus the benchmark. Manual uses the custom multiplier entered below.",
     group="Core Settings"
)

isAtrMode =
     multiplierMode == "Auto by ATR%"

isBetaMode =
     multiplierMode == "Beta Based"

isManualMode =
     multiplierMode == "Manual"

usesAutomaticTiers =
     isAtrMode or isBetaMode

defaultMultiplier = input.float(
     3.0,
     minval=0.5,
     maxval=10.0,
     step=0.1,
     title="Standard and Fallback Multiplier",
     tooltip="Used in Standard mode. It is also used as the fallback whenever an automatic mode cannot produce a valid multiplier.",
     group="Core Settings"
)

manualMultiplier = input.float(
     3.0,
     minval=0.5,
     maxval=10.0,
     step=0.1,
     title="Manual Multiplier",
     tooltip="Used only when Multiplier Mode is set to Manual.",
     group="Core Settings",
     active=isManualMode
)

//────────────────────────────────────────────────────────────────────
// Multiplier tiers
//────────────────────────────────────────────────────────────────────

tierMultiplier1 = input.float(
     2.5,
     minval=0.5,
     maxval=10.0,
     step=0.1,
     title="Tier 1 Multiplier",
     tooltip="Used for the lowest ATR% or beta range.",
     group="Multiplier Tiers",
     active=usesAutomaticTiers
)

tierMultiplier2 = input.float(
     3.0,
     minval=0.5,
     maxval=10.0,
     step=0.1,
     title="Tier 2 Multiplier",
     tooltip="Used after ATR% or beta reaches the Tier 2 threshold but remains below the Tier 3 threshold.",
     group="Multiplier Tiers",
     active=usesAutomaticTiers
)

tierMultiplier3 = input.float(
     3.5,
     minval=0.5,
     maxval=10.0,
     step=0.1,
     title="Tier 3 Multiplier",
     tooltip="Used after ATR% or beta reaches the Tier 3 threshold but remains below the Tier 4 threshold.",
     group="Multiplier Tiers",
     active=usesAutomaticTiers
)

tierMultiplier4 = input.float(
     4.0,
     minval=0.5,
     maxval=10.0,
     step=0.1,
     title="Tier 4 Multiplier",
     tooltip="Used for the highest ATR% or beta range.",
     group="Multiplier Tiers",
     active=usesAutomaticTiers
)

//────────────────────────────────────────────────────────────────────
// Auto by ATR% settings
//────────────────────────────────────────────────────────────────────

atrPctLowInput = input.float(
     2.0,
     minval=0.1,
     step=0.1,
     title="Tier 2 Starts at ATR%",
     tooltip="Enter 2 for 2%. Values below this threshold use Tier 1. Values at or above it use at least Tier 2.",
     group="Auto by ATR%",
     active=isAtrMode
)

atrPctMediumInput = input.float(
     4.0,
     minval=0.1,
     step=0.1,
     title="Tier 3 Starts at ATR%",
     tooltip="Enter 4 for 4%. Values at or above this threshold use at least Tier 3.",
     group="Auto by ATR%",
     active=isAtrMode
)

atrPctHighInput = input.float(
     6.0,
     minval=0.1,
     step=0.1,
     title="Tier 4 Starts at ATR%",
     tooltip="Enter 6 for 6%. Values at or above this threshold use Tier 4.",
     group="Auto by ATR%",
     active=isAtrMode
)

//────────────────────────────────────────────────────────────────────
// Beta Based settings
//────────────────────────────────────────────────────────────────────

benchmarkSymbol = input.symbol(
     "AMEX:SPY",
     title="Beta Benchmark",
     tooltip="Benchmark used to calculate rolling beta. SPY is the default benchmark for US stocks.",
     group="Beta Based",
     active=isBetaMode
)

betaLength = input.int(
     252,
     minval=20,
     maxval=2000,
     title="Beta Lookback in Trading Days",
     tooltip="Number of confirmed daily return samples used to calculate beta. A setting of 252 approximates one trading year. The fallback multiplier is used until enough samples are available.",
     group="Beta Based",
     active=isBetaMode
)

useAbsoluteBeta = input.bool(
     true,
     title="Use Absolute Beta",
     tooltip="When enabled, a negative beta is classified by its absolute size. For example, negative 1.8 is treated the same as positive 1.8.",
     group="Beta Based",
     active=isBetaMode
)

betaLowInput = input.float(
     1.0,
     minval=0.0,
     step=0.1,
     title="Tier 2 Starts at Beta",
     tooltip="Beta values below this threshold use Tier 1. Values at or above it use at least Tier 2.",
     group="Beta Based",
     active=isBetaMode
)

betaMediumInput = input.float(
     1.5,
     minval=0.0,
     step=0.1,
     title="Tier 3 Starts at Beta",
     tooltip="Beta values at or above this threshold use at least Tier 3.",
     group="Beta Based",
     active=isBetaMode
)

betaHighInput = input.float(
     2.0,
     minval=0.0,
     step=0.1,
     title="Tier 4 Starts at Beta",
     tooltip="Beta values at or above this threshold use Tier 4.",
     group="Beta Based",
     active=isBetaMode
)

//────────────────────────────────────────────────────────────────────
// Display settings
//────────────────────────────────────────────────────────────────────

showShortStop = input.bool(
     false,
     title="Show Short Stop",
     tooltip="Displays the bearish trailing stop above price after the trend turns bearish. Turning this off hides only the short line. The calculation and long exit alert remain active.",
     group="Display"
)

//────────────────────────────────────────────────────────────────────
// Diagnostics
//────────────────────────────────────────────────────────────────────

showDiagnostics = input.bool(
     false,
     title="Show Diagnostics Table",
     tooltip="Displays the current multiplier mode, active multiplier, ATR%, calculated beta, beta sample count, and beta status. This does not change any calculations.",
     group="Diagnostics"
)

//────────────────────────────────────────────────────────────────────
// Alert settings
//────────────────────────────────────────────────────────────────────

restrictAlertToDaily = input.bool(
     true,
     title="Daily Close Alerts Only",
     tooltip="When enabled, the exit condition triggers only on confirmed daily bars. Recommended alert setup: 1D interval and Once per bar close.",
     group="Alerts"
)

//────────────────────────────────────────────────────────────────────
// Sanitize thresholds
//────────────────────────────────────────────────────────────────────

atrPctLow =
     atrPctLowInput

atrPctMedium =
     math.max(
          atrPctMediumInput,
          atrPctLow
     )

atrPctHigh =
     math.max(
          atrPctHighInput,
          atrPctMedium
     )

betaLow =
     betaLowInput

betaMedium =
     math.max(
          betaMediumInput,
          betaLow
     )

betaHigh =
     math.max(
          betaHighInput,
          betaMedium
     )

//────────────────────────────────────────────────────────────────────
// ATR calculations
//────────────────────────────────────────────────────────────────────

atr =
     ta.atr(atrLength)

atrPercent =
     close != 0
     ? atr / close * 100
     : na

atrPercentMultiplier =
     na(atrPercent)             ? defaultMultiplier :
     atrPercent >= atrPctHigh   ? tierMultiplier4 :
     atrPercent >= atrPctMedium ? tierMultiplier3 :
     atrPercent >= atrPctLow    ? tierMultiplier2 :
     tierMultiplier1

//────────────────────────────────────────────────────────────────────
// Rolling daily beta calculation
//
// Beta mode is supported on intraday and daily charts. Weekly and
// monthly charts use the standard and fallback multiplier.
//────────────────────────────────────────────────────────────────────

betaTimeframeSupported =
     timeframe.isintraday or
     timeframe.isdaily

stockClose1 = request.security(
     syminfo.tickerid,
     "D",
     close[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

stockClose2 = request.security(
     syminfo.tickerid,
     "D",
     close[2],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

benchmarkClose1 = request.security(
     benchmarkSymbol,
     "D",
     close[1],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

benchmarkClose2 = request.security(
     benchmarkSymbol,
     "D",
     close[2],
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
)

stockDailyReturn =
     not na(stockClose1) and
     not na(stockClose2) and
     stockClose2 != 0
     ? math.log(stockClose1 / stockClose2)
     : na

benchmarkDailyReturn =
     not na(benchmarkClose1) and
     not na(benchmarkClose2) and
     benchmarkClose2 != 0
     ? math.log(benchmarkClose1 / benchmarkClose2)
     : na

var array<float> stockReturns =
     array.new_float(0)

var array<float> benchmarkReturns =
     array.new_float(0)

newDailySample =
     betaTimeframeSupported and
     barstate.isconfirmed and
     timeframe.change("D") and
     not na(stockDailyReturn) and
     not na(benchmarkDailyReturn)

if newDailySample
    array.push(
         stockReturns,
         stockDailyReturn
    )

    array.push(
         benchmarkReturns,
         benchmarkDailyReturn
    )

    if array.size(stockReturns) > betaLength
        array.shift(stockReturns)
        array.shift(benchmarkReturns)

enoughBetaSamples =
     array.size(stockReturns) >= betaLength and
     array.size(benchmarkReturns) >= betaLength

benchmarkVariance =
     enoughBetaSamples
     ? array.variance(benchmarkReturns)
     : na

calculatedBeta =
     betaTimeframeSupported and
     enoughBetaSamples and
     not na(benchmarkVariance) and
     benchmarkVariance != 0
     ? array.covariance(
          stockReturns,
          benchmarkReturns
       ) / benchmarkVariance
     : na

betaForTiers =
     na(calculatedBeta)
     ? na
     : useAbsoluteBeta
       ? math.abs(calculatedBeta)
       : calculatedBeta

betaMultiplier =
     na(betaForTiers)           ? defaultMultiplier :
     betaForTiers >= betaHigh   ? tierMultiplier4 :
     betaForTiers >= betaMedium ? tierMultiplier3 :
     betaForTiers >= betaLow    ? tierMultiplier2 :
     tierMultiplier1

//────────────────────────────────────────────────────────────────────
// Select active multiplier
//────────────────────────────────────────────────────────────────────

activeMultiplier =
     multiplierMode == "Auto by ATR%" ? atrPercentMultiplier :
     multiplierMode == "Beta Based"   ? betaMultiplier :
     multiplierMode == "Manual"       ? manualMultiplier :
     defaultMultiplier

//────────────────────────────────────────────────────────────────────
// Chandelier stop calculations
//────────────────────────────────────────────────────────────────────

longStopRaw =
     ta.highest(
          high,
          lookback
     ) -
     atr * activeMultiplier

shortStopRaw =
     ta.lowest(
          low,
          lookback
     ) +
     atr * activeMultiplier

var float longStop =
     na

var float shortStop =
     na

longStop :=
     na(longStop[1])
     ? longStopRaw
     : close[1] > longStop[1]
       ? math.max(
            longStopRaw,
            longStop[1]
         )
       : longStopRaw

shortStop :=
     na(shortStop[1])
     ? shortStopRaw
     : close[1] < shortStop[1]
       ? math.min(
            shortStopRaw,
            shortStop[1]
         )
       : shortStopRaw

//────────────────────────────────────────────────────────────────────
// Trend state
//────────────────────────────────────────────────────────────────────

var int trend =
     1

previousTrend =
     nz(
          trend[1],
          1
     )

previousLongStop =
     nz(
          longStop[1],
          longStop
     )

previousShortStop =
     nz(
          shortStop[1],
          shortStop
     )

trend :=
     previousTrend == -1 and close > previousShortStop ? 1 :
     previousTrend == 1 and close < previousLongStop   ? -1 :
     previousTrend

//────────────────────────────────────────────────────────────────────
// Separate long and short plots
//────────────────────────────────────────────────────────────────────

longStopDisplay =
     trend == 1
     ? longStop
     : na

shortStopDisplay =
     trend == -1 and showShortStop
     ? shortStop
     : na

plot(
     longStopDisplay,
     title="Long Stop",
     color=color.rgb(0, 150, 80),
     linewidth=2,
     style=plot.style_linebr,
     editable=true
)

plot(
     shortStopDisplay,
     title="Short Stop",
     color=color.rgb(220, 60, 60),
     linewidth=2,
     style=plot.style_linebr,
     editable=true
)

//────────────────────────────────────────────────────────────────────
// Optional diagnostics table
//────────────────────────────────────────────────────────────────────

betaStatusText =
     not betaTimeframeSupported ? "Fallback on this timeframe" :
     not enoughBetaSamples      ? "Collecting samples" :
     na(calculatedBeta)         ? "Unavailable" :
     "Ready"

atrPercentText =
     na(atrPercent)
     ? "N/A"
     : str.tostring(
          atrPercent,
          "#.##"
       ) + "%"

betaText =
     na(calculatedBeta)
     ? "N/A"
     : str.tostring(
          calculatedBeta,
          "#.###"
       )

betaSamplesText =
     str.tostring(
          array.size(stockReturns)
     ) +
     " / " +
     str.tostring(betaLength)

var table diagnosticsTable = table.new(
     position.top_right,
     2,
     6,
     border_width=1
)

diagnosticsBackground =
     color.new(
          color.black,
          15
     )

diagnosticsLabelBackground =
     color.new(
          color.gray,
          65
     )

if barstate.islast
    if showDiagnostics
        table.cell(
             diagnosticsTable,
             0,
             0,
             "Mode",
             text_color=color.white,
             bgcolor=diagnosticsLabelBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             1,
             0,
             multiplierMode,
             text_color=color.white,
             bgcolor=diagnosticsBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             0,
             1,
             "Active multiplier",
             text_color=color.white,
             bgcolor=diagnosticsLabelBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             1,
             1,
             str.tostring(
                  activeMultiplier,
                  "#.0"
             ),
             text_color=color.white,
             bgcolor=diagnosticsBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             0,
             2,
             "ATR percentage",
             text_color=color.white,
             bgcolor=diagnosticsLabelBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             1,
             2,
             atrPercentText,
             text_color=color.white,
             bgcolor=diagnosticsBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             0,
             3,
             "Calculated beta",
             text_color=color.white,
             bgcolor=diagnosticsLabelBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             1,
             3,
             betaText,
             text_color=color.white,
             bgcolor=diagnosticsBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             0,
             4,
             "Beta samples",
             text_color=color.white,
             bgcolor=diagnosticsLabelBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             1,
             4,
             betaSamplesText,
             text_color=color.white,
             bgcolor=diagnosticsBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             0,
             5,
             "Beta status",
             text_color=color.white,
             bgcolor=diagnosticsLabelBackground,
             text_size=size.small
        )

        table.cell(
             diagnosticsTable,
             1,
             5,
             betaStatusText,
             text_color=color.white,
             bgcolor=diagnosticsBackground,
             text_size=size.small
        )
    else
        table.clear(
             diagnosticsTable,
             0,
             0,
             1,
             5
        )

//────────────────────────────────────────────────────────────────────
// Exit alert
//────────────────────────────────────────────────────────────────────

timeframeQualifies =
     not restrictAlertToDaily or
     timeframe.isdaily

stopExitSignal =
     barstate.isconfirmed and
     timeframeQualifies and
     trend == -1 and
     previousTrend == 1

alertcondition(
     stopExitSignal,
     title="Close Below ATR Stop",
     message="{{ticker}} closed below the Trade Control ATR Chandelier Stop. Close: {{close}}"
)