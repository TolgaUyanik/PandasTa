//@version=6
strategy("CRT H3 Zonas Vela 0 + CHoCH", overlay=true, pyramiding=0, process_orders_on_close=true)

// === CONFIGURACIÓN ===
swingLen  = input.int(3, "Fuerza del Swing / CHoCH", minval=1)
rr        = input.float(1.0, "Risk Reward", step=0.1)
contratos = input.float(1, "Contratos", step=1)
mostrarZonas = input.bool(true, "Mostrar Zonas H3 Vela 0")

// === RESET DIARIO NEW YORK ===
nuevoDiaNY = ta.change(time("D", "0000-2359", "America/New_York")) != 0

var bool entradaHoy = false

if nuevoDiaNY
    entradaHoy := false

// === DETECTAR VELAS H3 DESDE CUALQUIER TEMPORALIDAD ===
nuevaH3 = ta.change(time("180")) != 0

var float h3High0 = na
var float h3Low0  = na
var float h3High1 = na
var float h3Low1  = na
var box zonaH3 = na

if na(h3High0)
    h3High0 := high
    h3Low0 := low
    if mostrarZonas
        zonaH3 := box.new(left=bar_index, right=bar_index, top=h3High0, bottom=h3Low0, bgcolor=color.new(color.blue, 88), border_color=color.new(color.blue, 40))

if nuevaH3
    h3High1 := h3High0
    h3Low1  := h3Low0

    h3High0 := high
    h3Low0  := low

    if mostrarZonas
        zonaH3 := box.new(left=bar_index, right=bar_index, top=h3High0, bottom=h3Low0, bgcolor=color.new(color.blue, 88), border_color=color.new(color.blue, 40))
else
    h3High0 := math.max(h3High0, high)
    h3Low0  := math.min(h3Low0, low)

if mostrarZonas and not na(zonaH3)
    box.set_right(zonaH3, bar_index)
    box.set_top(zonaH3, h3High0)
    box.set_bottom(zonaH3, h3Low0)

// === TOMA DE LIQUIDEZ H3 ===
tomaHighH3 = not na(h3High1) and h3High0 > h3High1
tomaLowH3  = not na(h3Low1) and h3Low0 < h3Low1

// === ESTADOS ===
var bool buscarVenta = false
var bool buscarCompra = false

if nuevaH3
    buscarVenta := false
    buscarCompra := false

if not entradaHoy and tomaHighH3
    buscarVenta := true
    buscarCompra := false

if not entradaHoy and tomaLowH3
    buscarCompra := true
    buscarVenta := false

// === CHoCH EN TEMPORALIDAD ACTUAL ===
swingHigh = ta.pivothigh(high, swingLen, swingLen)
swingLow  = ta.pivotlow(low, swingLen, swingLen)

ultimoSwingHigh = ta.valuewhen(not na(swingHigh), swingHigh, 0)
ultimoSwingLow  = ta.valuewhen(not na(swingLow), swingLow, 0)

chochAlcista = not na(ultimoSwingHigh) and close > ultimoSwingHigh and close[1] <= ultimoSwingHigh
chochBajista = not na(ultimoSwingLow) and close < ultimoSwingLow and close[1] >= ultimoSwingLow

// === ENTRADAS ===
compra = not entradaHoy and buscarCompra and chochAlcista and strategy.position_size == 0
venta  = not entradaHoy and buscarVenta and chochBajista and strategy.position_size == 0

// === STOPS EN HIGH / LOW DE H3 VELA 0 ===
stopCompra = h3Low0
riesgoCompra = close - stopCompra
tpCompra = close + riesgoCompra * rr

stopVenta = h3High0
riesgoVenta = stopVenta - close
tpVenta = close - riesgoVenta * rr

if compra and riesgoCompra > 0
    strategy.entry("BUY CRT", strategy.long, qty=contratos)
    strategy.exit("TP/SL BUY", "BUY CRT", stop=stopCompra, limit=tpCompra)
    buscarCompra := false
    entradaHoy := true

if venta and riesgoVenta > 0
    strategy.entry("SELL CRT", strategy.short, qty=contratos)
    strategy.exit("TP/SL SELL", "SELL CRT", stop=stopVenta, limit=tpVenta)
    buscarVenta := false
    entradaHoy := true

// === DIBUJOS ===
plot(h3High0, title="Máximo H3 vela 0", color=color.new(color.red, 20), linewidth=2)
plot(h3Low0, title="Mínimo H3 vela 0", color=color.new(color.green, 20), linewidth=2)

plot(h3High1, title="Máximo H3 vela 1", color=color.new(color.red, 75), linewidth=1)
plot(h3Low1, title="Mínimo H3 vela 1", color=color.new(color.green, 75), linewidth=1)

plot(stopCompra, title="Stop Compra Low H3 Vela 0", color=color.green, linewidth=2)
plot(stopVenta, title="Stop Venta High H3 Vela 0", color=color.red, linewidth=2)

plotshape(tomaHighH3, title="Toma High H3", text="Toma\nHigh H3", style=shape.labeldown, color=color.red, textcolor=color.white, location=location.abovebar)

plotshape(tomaLowH3, title="Toma Low H3", text="Toma\nLow H3", style=shape.labelup, color=color.green, textcolor=color.white, location=location.belowbar)

plotshape(compra, title="Compra CRT", text="BUY\nCRT", style=shape.labelup, color=color.green, textcolor=color.white, location=location.belowbar)

plotshape(venta, title="Venta CRT", text="SELL\nCRT", style=shape.labeldown, color=color.red, textcolor=color.white, location=location.abovebar)