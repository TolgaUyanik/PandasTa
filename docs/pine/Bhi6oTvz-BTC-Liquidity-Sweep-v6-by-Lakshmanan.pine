//@version=6
indicator("BTC Liquidity Sweep v6", overlay=true)

//=========================
// Inputs
//=========================
lookback = input.int(10, title="Swing Length", minval=2)
volLen   = input.int(20, title="Volume Average")
rsiLen   = input.int(14, title="RSI Length")

//=========================
// Indicators
//=========================
avgVol = ta.sma(volume, volLen)
rsi    = ta.rsi(close, rsiLen)

//=========================
// Previous Swing Levels
//=========================
prevHigh = ta.highest(high, lookback)[1]
prevLow  = ta.lowest(low, lookback)[1]

//=========================
// Liquidity Sweeps
//=========================
bullSweep = low < prevLow and close > prevLow
bearSweep = high > prevHigh and close < prevHigh

//=========================
// Volume Confirmation
//=========================
highVol = volume > avgVol * 1.5

//=========================
// Trading Signals
//=========================
buySignal  = bullSweep and highVol and rsi > 50
sellSignal = bearSweep and highVol and rsi < 50

//=========================
// Prevent Repeated Signals
//=========================
var bool inTrade = false

buy  = buySignal and not inTrade
sell = sellSignal and inTrade

if buy
    inTrade := true

if sell
    inTrade := false

//=========================
// Plot Swing Levels
//=========================
plot(prevHigh, title="Previous High", color=color.red, linewidth=1)
plot(prevLow, title="Previous Low", color=color.green, linewidth=1)

//=========================
// BUY / SELL Labels
//=========================
plotshape(
     buy,
     title="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.lime,
     text="BUY",
     textcolor=color.black,
     size=size.small)

plotshape(
     sell,
     title="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.small)

//=========================
// Alerts
//=========================
alertcondition(buy, title="BUY Alert", message="BTC BUY Signal")
alertcondition(sell, title="SELL Alert", message="BTC SELL Signal")