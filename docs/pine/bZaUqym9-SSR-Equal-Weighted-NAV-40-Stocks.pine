//@version=6
indicator(title="SSR Equal-Weighted NAV (40 Stocks)", shorttitle="EW-NAV", overlay=false)

// ═════════════════════════════════════════════
// METHODOLOGY
// Daily-rebalanced equal-weighted index.
// Each bar, every valid constituent gets weight 1/n.
// NAV is CHAINED:  NAV_t = NAV_(t-1) x (1 + avg bar return)
// where the average covers only stocks that have a price
// on BOTH the previous and current bar.
//
// A newly listed stock therefore contributes nothing on its
// entry bar and begins contributing its return from the next
// bar onward — no step-gap in the NAV when the basket grows.
//
// NOTE: this is NOT a buy-and-hold basket. Weights reset to
// 1/n every bar. A stock that triples does not end up carrying
// 3x the weight. This is what "equal-weighted" conventionally
// means and what NSE/BSE equal-weight indices approximate.
// ═════════════════════════════════════════════

// ─────────────────────────────────────────────
// LABEL / DISPLAY SETTINGS
// ─────────────────────────────────────────────
nav_label  = input.string("India Solar Basket", "NAV Label",  group="Display", tooltip="Custom name shown on the latest bar label")
show_label = input.bool(true,                   "Show Label", group="Display")
label_size = input.string("normal",             "Label Size", group="Display", options=["tiny","small","normal","large","huge"])

show_returns_table = input.bool(true, "Show Returns Table", group="Display")
table_position_in  = input.string("Top Right", "Returns Table Position", group="Display", options=["Top Right","Top Left","Bottom Right","Bottom Left"])

show_perf_table    = input.bool(true, "Show Stock vs NAV Table", group="Display")
perf_table_pos_in  = input.string("Bottom Right", "Stock Table Position", group="Display", options=["Top Right","Top Left","Bottom Right","Bottom Left"])

// ─────────────────────────────────────────────
// NAV BASE — start date
// ─────────────────────────────────────────────
startDate = input.time(timestamp("01 Jan 2024 00:00 +0530"), "Calculate NAV From", group="NAV Base", tooltip="NAV starts at 100 on the first bar on/after this date that has at least one valid constituent. Stocks listing later join without gapping the NAV.")

// ─────────────────────────────────────────────
// ACTIVE STOCK COUNT — the key control
// ─────────────────────────────────────────────
active = input.int(9, "Number of Active Stocks", minval=1, maxval=40, group="Basket", tooltip="Only slots 1 through this number are included in the NAV. Set this first, then fill in your tickers.")

// ─────────────────────────────────────────────
// STOCK INPUTS (40 slots)
// ─────────────────────────────────────────────
sym01 = input.symbol("NSE:WAAREEENER", "Stock 01", group="Basket")
sym02 = input.symbol("NSE:PREMIERENE", "Stock 02", group="Basket")
sym03 = input.symbol("NSE:INA",        "Stock 03", group="Basket")
sym04 = input.symbol("NSE:WEBELSOLAR", "Stock 04", group="Basket")
sym05 = input.symbol("NSE:ALPEXSOLAR", "Stock 05", group="Basket")
sym06 = input.symbol("NSE:SWELECTES",  "Stock 06", group="Basket")
sym07 = input.symbol("NSE:APS",        "Stock 07", group="Basket")
sym08 = input.symbol("NSE:SOLEX",      "Stock 08", group="Basket")
sym09 = input.symbol("BSE:531260",     "Stock 09", group="Basket")
sym10 = input.symbol("NSE:NIFTY",      "Stock 10", group="Basket")
sym11 = input.symbol("NSE:NIFTY",      "Stock 11", group="Basket")
sym12 = input.symbol("NSE:NIFTY",      "Stock 12", group="Basket")
sym13 = input.symbol("NSE:NIFTY",      "Stock 13", group="Basket")
sym14 = input.symbol("NSE:NIFTY",      "Stock 14", group="Basket")
sym15 = input.symbol("NSE:NIFTY",      "Stock 15", group="Basket")
sym16 = input.symbol("NSE:NIFTY",      "Stock 16", group="Basket")
sym17 = input.symbol("NSE:NIFTY",      "Stock 17", group="Basket")
sym18 = input.symbol("NSE:NIFTY",      "Stock 18", group="Basket")
sym19 = input.symbol("NSE:NIFTY",      "Stock 19", group="Basket")
sym20 = input.symbol("NSE:NIFTY",      "Stock 20", group="Basket")
sym21 = input.symbol("NSE:NIFTY",      "Stock 21", group="Basket")
sym22 = input.symbol("NSE:NIFTY",      "Stock 22", group="Basket")
sym23 = input.symbol("NSE:NIFTY",      "Stock 23", group="Basket")
sym24 = input.symbol("NSE:NIFTY",      "Stock 24", group="Basket")
sym25 = input.symbol("NSE:NIFTY",      "Stock 25", group="Basket")
sym26 = input.symbol("NSE:NIFTY",      "Stock 26", group="Basket")
sym27 = input.symbol("NSE:NIFTY",      "Stock 27", group="Basket")
sym28 = input.symbol("NSE:NIFTY",      "Stock 28", group="Basket")
sym29 = input.symbol("NSE:NIFTY",      "Stock 29", group="Basket")
sym30 = input.symbol("NSE:NIFTY",      "Stock 30", group="Basket")
sym31 = input.symbol("NSE:NIFTY",      "Stock 31", group="Basket")
sym32 = input.symbol("NSE:NIFTY",      "Stock 32", group="Basket")
sym33 = input.symbol("NSE:NIFTY",      "Stock 33", group="Basket")
sym34 = input.symbol("NSE:NIFTY",      "Stock 34", group="Basket")
sym35 = input.symbol("NSE:NIFTY",      "Stock 35", group="Basket")
sym36 = input.symbol("NSE:NIFTY",      "Stock 36", group="Basket")
sym37 = input.symbol("NSE:NIFTY",      "Stock 37", group="Basket")
sym38 = input.symbol("NSE:NIFTY",      "Stock 38", group="Basket")
sym39 = input.symbol("NSE:NIFTY",      "Stock 39", group="Basket")
sym40 = input.symbol("NSE:NIFTY",      "Stock 40", group="Basket")

// ─────────────────────────────────────────────
// EMA INPUTS
// ─────────────────────────────────────────────
ema1_len  = input.int(20,  "EMA 1 Length", minval=1, group="EMAs")
ema2_len  = input.int(50,  "EMA 2 Length", minval=1, group="EMAs")
ema3_len  = input.int(200, "EMA 3 Length", minval=1, group="EMAs")
show_ema1 = input.bool(true, "Show EMA 1", group="EMAs")
show_ema2 = input.bool(true, "Show EMA 2", group="EMAs")
show_ema3 = input.bool(true, "Show EMA 3", group="EMAs")

// ─────────────────────────────────────────────
// FETCH PRICES — gated by active count
// Slots beyond `active` are never requested
// ─────────────────────────────────────────────
p01 = active >= 1  ? request.security(sym01, timeframe.period, close, ignore_invalid_symbol=true) : na
p02 = active >= 2  ? request.security(sym02, timeframe.period, close, ignore_invalid_symbol=true) : na
p03 = active >= 3  ? request.security(sym03, timeframe.period, close, ignore_invalid_symbol=true) : na
p04 = active >= 4  ? request.security(sym04, timeframe.period, close, ignore_invalid_symbol=true) : na
p05 = active >= 5  ? request.security(sym05, timeframe.period, close, ignore_invalid_symbol=true) : na
p06 = active >= 6  ? request.security(sym06, timeframe.period, close, ignore_invalid_symbol=true) : na
p07 = active >= 7  ? request.security(sym07, timeframe.period, close, ignore_invalid_symbol=true) : na
p08 = active >= 8  ? request.security(sym08, timeframe.period, close, ignore_invalid_symbol=true) : na
p09 = active >= 9  ? request.security(sym09, timeframe.period, close, ignore_invalid_symbol=true) : na
p10 = active >= 10 ? request.security(sym10, timeframe.period, close, ignore_invalid_symbol=true) : na
p11 = active >= 11 ? request.security(sym11, timeframe.period, close, ignore_invalid_symbol=true) : na
p12 = active >= 12 ? request.security(sym12, timeframe.period, close, ignore_invalid_symbol=true) : na
p13 = active >= 13 ? request.security(sym13, timeframe.period, close, ignore_invalid_symbol=true) : na
p14 = active >= 14 ? request.security(sym14, timeframe.period, close, ignore_invalid_symbol=true) : na
p15 = active >= 15 ? request.security(sym15, timeframe.period, close, ignore_invalid_symbol=true) : na
p16 = active >= 16 ? request.security(sym16, timeframe.period, close, ignore_invalid_symbol=true) : na
p17 = active >= 17 ? request.security(sym17, timeframe.period, close, ignore_invalid_symbol=true) : na
p18 = active >= 18 ? request.security(sym18, timeframe.period, close, ignore_invalid_symbol=true) : na
p19 = active >= 19 ? request.security(sym19, timeframe.period, close, ignore_invalid_symbol=true) : na
p20 = active >= 20 ? request.security(sym20, timeframe.period, close, ignore_invalid_symbol=true) : na
p21 = active >= 21 ? request.security(sym21, timeframe.period, close, ignore_invalid_symbol=true) : na
p22 = active >= 22 ? request.security(sym22, timeframe.period, close, ignore_invalid_symbol=true) : na
p23 = active >= 23 ? request.security(sym23, timeframe.period, close, ignore_invalid_symbol=true) : na
p24 = active >= 24 ? request.security(sym24, timeframe.period, close, ignore_invalid_symbol=true) : na
p25 = active >= 25 ? request.security(sym25, timeframe.period, close, ignore_invalid_symbol=true) : na
p26 = active >= 26 ? request.security(sym26, timeframe.period, close, ignore_invalid_symbol=true) : na
p27 = active >= 27 ? request.security(sym27, timeframe.period, close, ignore_invalid_symbol=true) : na
p28 = active >= 28 ? request.security(sym28, timeframe.period, close, ignore_invalid_symbol=true) : na
p29 = active >= 29 ? request.security(sym29, timeframe.period, close, ignore_invalid_symbol=true) : na
p30 = active >= 30 ? request.security(sym30, timeframe.period, close, ignore_invalid_symbol=true) : na
p31 = active >= 31 ? request.security(sym31, timeframe.period, close, ignore_invalid_symbol=true) : na
p32 = active >= 32 ? request.security(sym32, timeframe.period, close, ignore_invalid_symbol=true) : na
p33 = active >= 33 ? request.security(sym33, timeframe.period, close, ignore_invalid_symbol=true) : na
p34 = active >= 34 ? request.security(sym34, timeframe.period, close, ignore_invalid_symbol=true) : na
p35 = active >= 35 ? request.security(sym35, timeframe.period, close, ignore_invalid_symbol=true) : na
p36 = active >= 36 ? request.security(sym36, timeframe.period, close, ignore_invalid_symbol=true) : na
p37 = active >= 37 ? request.security(sym37, timeframe.period, close, ignore_invalid_symbol=true) : na
p38 = active >= 38 ? request.security(sym38, timeframe.period, close, ignore_invalid_symbol=true) : na
p39 = active >= 39 ? request.security(sym39, timeframe.period, close, ignore_invalid_symbol=true) : na
p40 = active >= 40 ? request.security(sym40, timeframe.period, close, ignore_invalid_symbol=true) : na

// ─────────────────────────────────────────────
// SYMBOL / PRICE ARRAYS (current and previous bar)
// ─────────────────────────────────────────────
symArr = array.from(sym01, sym02, sym03, sym04, sym05, sym06, sym07, sym08, sym09, sym10, sym11, sym12, sym13, sym14, sym15, sym16, sym17, sym18, sym19, sym20, sym21, sym22, sym23, sym24, sym25, sym26, sym27, sym28, sym29, sym30, sym31, sym32, sym33, sym34, sym35, sym36, sym37, sym38, sym39, sym40)

priceArr = array.from(p01, p02, p03, p04, p05, p06, p07, p08, p09, p10, p11, p12, p13, p14, p15, p16, p17, p18, p19, p20, p21, p22, p23, p24, p25, p26, p27, p28, p29, p30, p31, p32, p33, p34, p35, p36, p37, p38, p39, p40)

prevArr = array.from(p01[1], p02[1], p03[1], p04[1], p05[1], p06[1], p07[1], p08[1], p09[1], p10[1], p11[1], p12[1], p13[1], p14[1], p15[1], p16[1], p17[1], p18[1], p19[1], p20[1], p21[1], p22[1], p23[1], p24[1], p25[1], p26[1], p27[1], p28[1], p29[1], p30[1], p31[1], p32[1], p33[1], p34[1], p35[1], p36[1], p37[1], p38[1], p39[1], p40[1])

// ─────────────────────────────────────────────
// AVERAGE BAR RETURN ACROSS VALID CONSTITUENTS
// A stock counts only if it has a price on BOTH
// the previous and current bar. New listings are
// silently skipped on their entry bar.
// ─────────────────────────────────────────────
float retSum   = 0.0
int   retCnt   = 0
int   validCnt = 0

for i = 0 to active - 1
    cur = array.get(priceArr, i)
    prv = array.get(prevArr,  i)
    if not na(cur)
        validCnt += 1
    if not na(cur) and not na(prv) and prv != 0
        retSum += cur / prv - 1.0
        retCnt += 1

avgRet = retCnt > 0 ? retSum / retCnt : na

// ─────────────────────────────────────────────
// CHAINED NAV — starts at 100, compounds forward
// ─────────────────────────────────────────────
var float nav = na

if time >= startDate
    if na(nav)
        if validCnt > 0
            nav := 100.0
    else if not na(avgRet)
        nav := nav * (1.0 + avgRet)

// ─────────────────────────────────────────────
// EMAs
// ─────────────────────────────────────────────
ema1 = ta.ema(nav, ema1_len)
ema2 = ta.ema(nav, ema2_len)
ema3 = ta.ema(nav, ema3_len)

// ─────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────
plot(nav,                   title="NAV",   color=color.new(color.white,  0), linewidth=2)
plot(show_ema1 ? ema1 : na, title="EMA 1", color=color.new(color.yellow, 0), linewidth=1)
plot(show_ema2 ? ema2 : na, title="EMA 2", color=color.new(color.orange, 0), linewidth=1)
plot(show_ema3 ? ema3 : na, title="EMA 3", color=color.new(color.red,    0), linewidth=2)
hline(100, "Base (100)", color=color.new(color.gray, 50), linestyle=hline.style_dashed)

_lsize = switch label_size
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    "huge"   => size.huge
    => size.normal

// ─────────────────────────────────────────────
// NAV LABEL — last bar only
// ─────────────────────────────────────────────
var label navLbl = na
if barstate.islast and show_label and not na(nav)
    label.delete(navLbl)
    navLbl := label.new(x = bar_index, y = nav, text = nav_label + "\n" + str.tostring(math.round(nav, 2)) + "  (" + str.tostring(validCnt) + " stocks)", color = color.new(color.teal, 20), textcolor = color.white, style = label.style_label_left, size = _lsize)

// ─────────────────────────────────────────────
// RETURNS TABLE — 1D / 1W / 1M / 3M / 6M / 1Y / 3Y / 5Y
// ─────────────────────────────────────────────
var array<int>   navTimes  = array.new<int>()
var array<float> navValues = array.new<float>()

if barstate.isconfirmed and not na(nav)
    array.push(navTimes, time)
    array.push(navValues, nav)

f_navAtOrBefore(array<int> arrT, array<float> arrV, int targetTime) =>
    n = array.size(arrT)
    float result = na
    if n > 0 and array.get(arrT, 0) <= targetTime
        int lo = 0
        int hi = n - 1
        while lo < hi
            mid = int(math.ceil((lo + hi) / 2.0))
            if array.get(arrT, mid) <= targetTime
                lo := mid
            else
                hi := mid - 1
        result := array.get(arrV, lo)
    result

f_fillRow(table tbl, int row, string lbl, int days, float curNav, array<int> arrT, array<float> arrV, string txtSize) =>
    msPerDay = 86400000
    pastNav  = f_navAtOrBefore(arrT, arrV, time - days * msPerDay)
    chg      = (na(curNav) or na(pastNav) or pastNav == 0) ? float(na) : (curNav - pastNav) / pastNav * 100
    txt      = na(chg) ? "N/A" : str.tostring(chg, "#.##") + "%"
    col      = na(chg) ? color.gray : (chg >= 0 ? color.lime : color.red)
    table.cell(tbl, 0, row, lbl, text_color=color.white, text_size=txtSize)
    table.cell(tbl, 1, row, txt, text_color=col,         text_size=txtSize)

tablePos = switch table_position_in
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.top_right

var table retTable = na

if barstate.islast
    if show_returns_table
        if na(retTable)
            retTable := table.new(tablePos, 2, 9, border_width=1, bgcolor=color.new(color.black, 80), border_color=color.gray)
        table.cell(retTable, 0, 0, "Period", text_color=color.white, text_size=_lsize, bgcolor=color.new(color.blue, 70))
        table.cell(retTable, 1, 0, "Return", text_color=color.white, text_size=_lsize, bgcolor=color.new(color.blue, 70))
        f_fillRow(retTable, 1, "1 Day",   1,    nav, navTimes, navValues, _lsize)
        f_fillRow(retTable, 2, "1 Week",  7,    nav, navTimes, navValues, _lsize)
        f_fillRow(retTable, 3, "1 Month", 30,   nav, navTimes, navValues, _lsize)
        f_fillRow(retTable, 4, "3 Month", 91,   nav, navTimes, navValues, _lsize)
        f_fillRow(retTable, 5, "6 Month", 182,  nav, navTimes, navValues, _lsize)
        f_fillRow(retTable, 6, "1 Year",  365,  nav, navTimes, navValues, _lsize)
        f_fillRow(retTable, 7, "3 Year",  1095, nav, navTimes, navValues, _lsize)
        f_fillRow(retTable, 8, "5 Year",  1825, nav, navTimes, navValues, _lsize)
    else if not na(retTable)
        table.delete(retTable)
        retTable := na

// ─────────────────────────────────────────────
// STOCK vs NAV PERFORMANCE TABLE
// Each stock's return is measured from its own first
// valid bar on/after startDate. For a stock that listed
// late, that is a SHORTER window than the NAV covers —
// the "vs NAV" number is then not a like-for-like
// comparison. The Since column flags when this applies.
// ─────────────────────────────────────────────
var array<float> stockBasePrice = array.new<float>(40, na)
var array<int>   stockBaseTime  = array.new<int>(40, na)

for i = 0 to 39
    px = array.get(priceArr, i)
    if not na(px) and na(array.get(stockBasePrice, i)) and time >= startDate
        array.set(stockBasePrice, i, px)
        array.set(stockBaseTime,  i, time)

// first bar the NAV itself started on
var int navStartTime = na
if not na(nav) and na(navStartTime)
    navStartTime := time

f_tickerOnly(string fullSym) =>
    parts = str.split(fullSym, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : fullSym

tablePosPerf = switch perf_table_pos_in
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    => position.bottom_right

var table perfTable = na

if barstate.islast
    if show_perf_table
        navRoc = na(nav) ? float(na) : nav - 100

        var array<float> rocSortArr = array.new<float>(0)
        array.clear(rocSortArr)
        for i = 0 to active - 1
            basePx = array.get(stockBasePrice, i)
            curPx  = array.get(priceArr, i)
            roc    = (na(basePx) or na(curPx) or basePx == 0) ? float(na) : (curPx - basePx) / basePx * 100
            array.push(rocSortArr, na(roc) ? -1e9 : roc)

        sortedIdx = array.sort_indices(rocSortArr, order.descending)

        if na(perfTable)
            perfTable := table.new(tablePosPerf, 4, 42, border_width=1, bgcolor=color.new(color.black, 80), border_color=color.gray)

        table.cell(perfTable, 0, 0, "Stock",  text_color=color.white, text_size=_lsize, bgcolor=color.new(color.blue, 70))
        table.cell(perfTable, 1, 0, "Return", text_color=color.white, text_size=_lsize, bgcolor=color.new(color.blue, 70))
        table.cell(perfTable, 2, 0, "vs NAV", text_color=color.white, text_size=_lsize, bgcolor=color.new(color.blue, 70))
        table.cell(perfTable, 3, 0, "Since",  text_color=color.white, text_size=_lsize, bgcolor=color.new(color.blue, 70))

        navTxt      = na(navRoc)       ? "N/A" : str.tostring(navRoc, "#.##") + "%"
        navSinceTxt = na(navStartTime) ? "N/A" : str.format_time(navStartTime, "MMM ''yy", syminfo.timezone)
        table.cell(perfTable, 0, 1, "NAV (Baseline)", text_color=color.white, text_size=_lsize, bgcolor=color.new(color.teal, 60))
        table.cell(perfTable, 1, 1, navTxt,           text_color=color.white, text_size=_lsize, bgcolor=color.new(color.teal, 60))
        table.cell(perfTable, 2, 1, "—",              text_color=color.white, text_size=_lsize, bgcolor=color.new(color.teal, 60))
        table.cell(perfTable, 3, 1, navSinceTxt,      text_color=color.white, text_size=_lsize, bgcolor=color.new(color.teal, 60))

        for r = 0 to active - 1
            idx    = array.get(sortedIdx, r)
            basePx = array.get(stockBasePrice, idx)
            baseT  = array.get(stockBaseTime,  idx)
            curPx  = array.get(priceArr, idx)
            roc    = (na(basePx) or na(curPx) or basePx == 0) ? float(na) : (curPx - basePx) / basePx * 100
            vsNav  = (na(roc) or na(navRoc)) ? float(na) : roc - navRoc

            // flag stocks whose window is shorter than the NAV's
            lateJoin = not na(baseT) and not na(navStartTime) and baseT > navStartTime

            name    = f_tickerOnly(array.get(symArr, idx))
            rocTxt  = na(roc)   ? "N/A" : str.tostring(roc, "#.##") + "%"
            vsTxt   = na(vsNav) ? "N/A" : str.tostring(vsNav, "#.##") + "%" + (lateJoin ? "*" : "")
            vsCol   = na(vsNav) ? color.gray : (lateJoin ? color.gray : (vsNav >= 0 ? color.lime : color.red))
            sinceTx = na(baseT) ? "N/A" : str.format_time(baseT, "MMM ''yy", syminfo.timezone)

            table.cell(perfTable, 0, r + 2, name,    text_color=color.white, text_size=_lsize)
            table.cell(perfTable, 1, r + 2, rocTxt,  text_color=color.white, text_size=_lsize)
            table.cell(perfTable, 2, r + 2, vsTxt,   text_color=vsCol,       text_size=_lsize)
            table.cell(perfTable, 3, r + 2, sinceTx, text_color=lateJoin ? color.orange : color.silver, text_size=_lsize)
    else if not na(perfTable)
        table.delete(perfTable)
        perfTable := na