//@version=6
library("OHLCVData")

// Define a custom type to hold OHLCV data, time, and bar index.
export type OHLCV
    float open
    float high
    float low
    float close
    float volume
    int time
    int bar_index  // Added bar_index field here

// Define a wrapper type to include the OHLCV data and context information.
export type TimeframeData
    OHLCV ohlcv
    bool isAdjustedToChartTF
    bool isTargetBarClosed

// Function to fetch OHLCV data for the current chart bar, aligned from a specified timeframe and symbol.
// Returns a TimeframeData object containing the OHLCV data for the current bar and context information.
export getTimeframeData(string timeframe, string symbol="") =>
    string sym = symbol == "" ? syminfo.tickerid : symbol
    bool chartTFIsHigher = timeframe.in_seconds(timeframe.period) > timeframe.in_seconds(timeframe)

    if bar_index == 0
        OHLCV currentOHLCV = OHLCV.new(na, na, na, na, na, na, na)
        TimeframeData.new(currentOHLCV, chartTFIsHigher, false)
    else
        [o, h, l, c, v, t] = request.security(sym, timeframe, [open, high, low, close, volume, time], lookahead=barmerge.lookahead_off)
        series bool isTargetBarClosed = not na(t) and ta.change(t) != 0
        OHLCV currentOHLCV = OHLCV.new(o, h, l, c, v, t, bar_index)
        TimeframeData.new(currentOHLCV, chartTFIsHigher, isTargetBarClosed)

// Functions to return chart OHLCV as OHLCV object
export getCurrentChartOHLCV() =>
    OHLCV.new(open, high, low, close, volume, time, bar_index)

export getPreviousChartOHLCV(int offset = 1) =>
    OHLCV.new(open[offset], high[offset], low[offset], close[offset], volume[offset], time[offset], bar_index - offset)

// --- Utility functions for single OHLCV bars ---
export getRangePercent(OHLCV ohlcv) =>
    ohlcv.low != 0 ? 100 * (ohlcv.high - ohlcv.low) / ohlcv.low : na

export getBodySize(OHLCV ohlcv) =>
    math.abs(ohlcv.close - ohlcv.open)

export getUpperWick(OHLCV ohlcv) =>
    ohlcv.high - math.max(ohlcv.open, ohlcv.close)

export getLowerWick(OHLCV ohlcv) =>
    math.min(ohlcv.open, ohlcv.close) - ohlcv.low

export isBullish(OHLCV ohlcv) =>
    ohlcv.close > ohlcv.open

export isBearish(OHLCV ohlcv) =>
    ohlcv.close < ohlcv.open

export isValidTimeframeData(TimeframeData tf) =>
    not na(tf.ohlcv.time) and not na(tf.ohlcv.close)

// Optional: manual HTF aggregation from lower timeframe
export manualHTFAggregate(int barsBack) =>
    float o = open[barsBack - 1]
    float h = ta.highest(high, barsBack)
    float l = ta.lowest(low, barsBack)
    float c = close
    float v = math.sum(volume, barsBack)
    int   t = time
    int   i = bar_index
    OHLCV.new(o, h, l, c, v, t, i)

// === New Array Helpers & Aggregates ===

// Return the first timestamp from an array of OHLCV
export getFirstTimestamp(OHLCV[] src) =>
    array.size(src) > 0 ? array.get(src, 0).time : na

// Return the last timestamp from an array of OHLCV
export getLastTimestamp(OHLCV[] src) =>
    array.size(src) > 0 ? array.get(src, array.size(src) - 1).time : na

// Slice an array of OHLCV between start and end indices (inclusive)
export slice(OHLCV[] src, int start, int end) =>
    OHLCV[] result = array.new<OHLCV>()
    for i = start to end by 1
        if i >= 0 and i < array.size(src)
            array.push(result, array.get(src, i))
    result

// Aggregate: maximum high in an array of OHLCV
export getHigh(OHLCV[] src) =>
    var float maxHigh = na
    for i = 0 to array.size(src) - 1
        float h = array.get(src, i).high
        maxHigh := na(maxHigh) ? h : math.max(maxHigh, h)
    maxHigh

// Aggregate: minimum low in an array of OHLCV
export getLow(OHLCV[] src) =>
    var float minLow = na
    for i = 0 to array.size(src) - 1
        float l = array.get(src, i).low
        minLow := na(minLow) ? l : math.min(minLow, l)
    minLow

// Aggregate: sum of volumes in an array of OHLCV
export getVolume(OHLCV[] src) =>
    float totalVol = 0.0
    for i = 0 to array.size(src) - 1
        totalVol += array.get(src, i).volume
    totalVol
