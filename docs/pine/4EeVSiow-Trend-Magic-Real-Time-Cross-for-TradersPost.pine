//@version=5
indicator("Trend Magic Real-Time Cross for TradersPost", overlay=true)

// === INPUTS ===
temaLen = input.int(20, "TEMA Length")
atrLen  = input.int(5, "ATR Length")

// === TEMA Calculation ===
ema1 = ta.ema(close, temaLen)
ema2 = ta.ema(ema1, temaLen)
ema3 = ta.ema(ema2, temaLen)
tema = 3 * (ema1 - ema2) + ema3

// === ATR ===
atr = ta.atr(atrLen)

// === KIVANC-STYLE TREND MAGIC ===
var float trendMagic = na
trendMagic := na(trendMagic[1]) ? tema - atr : trendMagic[1] == tema - atr and close < trendMagic[1] ? tema + atr : trendMagic[1] == tema + atr and close > trendMagic[1] ? tema - atr : trendMagic[1]

plot(trendMagic, title="Trend Magic", color=color.orange, linewidth=2)

// === REALTIME CROSS DETECTION ===
crossUp = close > trendMagic and close[1] <= trendMagic[1] 
crossDown = close < trendMagic and close[1] >= trendMagic[1]

buySignal = crossUp
sellSignal = crossDown

// === PLOT ===
plotshape(buySignal, title="Buy", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small) 
plotshape(sellSignal, title="Sell", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// === ALERT TO TRADERSPOST ===
alertcondition(buySignal, title="Buy Alert", message='{"action": "buy", "strategy": "trendmagic", "symbol": "{{ticker}}", "price": "{{close}}", "time": "{{time}}"}') 
alertcondition(sellSignal, title="Sell Alert", message='{"action": "sell", "strategy": "trendmagic", "symbol": "{{ticker}}", "price": "{{close}}", "time": "{{time}}"}')
