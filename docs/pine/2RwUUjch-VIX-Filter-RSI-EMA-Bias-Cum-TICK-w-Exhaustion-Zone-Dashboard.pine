//@version=5
indicator("VIX Filter/RSI/EMA Bias/Cum TICK w/ Exhaustion Zone 2", overlay=true)

// Dashboard Settings
_ = input.string("", title="⚠️ NOTE: Chart TF must be ≤ indicator timeframes (RSI, EMA, TICK, VIX)", tooltip=" ⚠️ For accurate readings, your chart timeframe should be equal to or lower than any timeframe selected for the indicators (e.g. RSI, EMA, TICK, VIX).")
pos = input.string("Bottom Right", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], title="Dashboard Position")
dashTransparency = input.int(0, title="Dashboard Transparency (%)", minval=0, maxval=100)

// === INPUTS === //
vixSource = input.symbol("CBOE:VXN", title="VIX Symbol")
vixTF = input.timeframe("1", title="VIX Timeframe")  // user-defined

// VIX Range Inputs
weakRange     = input.string("0-14.99", title="Low Volatility Range (Min-Max)")
normalRange   = input.string("15-22", title="Normal Volatility Range (Min-Max)")
volatileRange = input.string("22.01-28", title="Elevated Volatility Range (Min-Max)")
dangerMin     = input.float(28.01, title="Extreme Volatility (Min)")

// === RSI Settings ===
rsiSymbol = input.symbol("", title="RSI Symbol (Leave Blank For Current Symbol)")
useRSISymbol = rsiSymbol != ""
symbolForRSI = useRSISymbol ? rsiSymbol : syminfo.ticker
rsiTF = input.timeframe("3", title="RSI Timeframe")
rsiLen = input.int(14, minval=1, title="RSI Length")
rsiOB = input.int(70, minval=50, maxval=100, title="RSI Overbought Level")
rsiOS = input.int(30, minval=0, maxval=50, title="RSI Oversold Level")

// EMA Settings
emaSymbol = input.symbol("", title="EMA Bias Symbol (Leave Blank For Current Symbol)")
useEMASymbol = emaSymbol != ""  // true if user set a custom symbol
symbolForEMA = useEMASymbol ? emaSymbol : syminfo.ticker  // simple name for label
emaTF = input.timeframe("3", title="EMA Bias Timeframe")
fastLen = input.int(9, minval=1, title="Fast EMA Length")
slowLen = input.int(21, minval=1, title="Slow EMA Length")


// === VIX FETCH === //
vix = request.security(vixSource, vixTF, close, lookahead=barmerge.lookahead_on)

// === PARSE FUNCTION === //
getMin(r) =>
    parts = str.split(r, "-")
    val = array.get(parts, 0)
    str.tonumber(val)

getMax(r) =>
    parts = str.split(r, "-")
    array.size(parts) > 1 ? str.tonumber(array.get(parts, 1)) : na

// === PARSE RANGES === //
weakMin = getMin(weakRange)
weakMax = getMax(weakRange)

normalMin = getMin(normalRange)
normalMax = getMax(normalRange)

volatileMin = getMin(volatileRange)
volatileMax = getMax(volatileRange)

// === VIX STATUS LOGIC === //
vixStatus = ""
vixIcon = ""
vixColor = color.white

if vix >= weakMin and vix <= weakMax
    vixStatus := "Weak Market"
    vixIcon := "➖"
    vixColor := color.gray
else if vix >= normalMin and vix <= normalMax
    vixStatus := "Normal Market"
    vixIcon := "✅"
    vixColor := color.green
else if vix >= volatileMin and vix <= volatileMax
    vixStatus := "Volatile Market"
    vixIcon := "⚠️"
    vixColor := color.orange
else if vix >= dangerMin
    vixStatus := "DANGER"
    vixIcon := "☠️"
    vixColor := color.red

// === EMA BIAS === //
symbolToUse = emaSymbol != "" ? emaSymbol : syminfo.tickerid
fastEMA = request.security(useEMASymbol ? emaSymbol : syminfo.tickerid, emaTF, ta.ema(close, fastLen))
slowEMA = request.security(useEMASymbol ? emaSymbol : syminfo.tickerid, emaTF, ta.ema(close, slowLen))

emaTrend = fastEMA > slowEMA ? "Bullish" : "Bearish"
emaIcon = fastEMA > slowEMA ? "🢁" : "🢃"
emaColor = fastEMA > slowEMA ? color.green : color.red
emaLabel = "EMA (" + emaTF + ")" + (useEMASymbol ? " [" + symbolForEMA + "]" : "") + ": " + emaTrend + " " + emaIcon

// === CUMULATIVE TICK SIGNAL === //
tickSymbol = input.symbol("TICK", title="TICK Symbol")
tickTF = input.timeframe("3", title="TICK Timeframe")
thresholdTrend = input.int(500, title="Strong Trend Threshold (+/-)")
flatZone = input.int(200, title="Flat Zone Range (+/-)")
exhaustionHigh = input.int(600, title="Bullish Exhaustion Threshold (+)")
exhaustionLow  = input.int(-600, title="Bearish Exhaustion Threshold (-)")
slopeBarsBack = input.int(5, title="Tick Lookback Period (Bars)")

// TICK cumulative function at native resolution
f_cumTick() =>
    var float cum = 0.0
    isNewDay = ta.change(time("D"))
    val = close
    cum := isNewDay ? 0 : na(val) ? cum : cum + val
    cum

// Request TICK and cumulative from native timeframe
tick = request.security(tickSymbol, tickTF, close, lookahead=barmerge.lookahead_on)
tickCum = request.security(tickSymbol, tickTF, f_cumTick(), lookahead=barmerge.lookahead_on)

// Signal logic
isStrongBull = tickCum > thresholdTrend and tickCum > tickCum[slopeBarsBack] and tick > 0
isWeakBull = tickCum > 0 and tickCum <= thresholdTrend and tickCum > tickCum[slopeBarsBack] and tick > 0
isStrongBear = tickCum < -thresholdTrend and tickCum < tickCum[slopeBarsBack] and tick < 0
isWeakBear = tickCum < 0 and tickCum >= -thresholdTrend and tickCum < tickCum[slopeBarsBack] and tick < 0
isChop = math.abs(tickCum) < flatZone and math.abs(tickCum - tickCum[slopeBarsBack]) < 100
isExhaustionBull = tick >= exhaustionHigh
isExhaustionBear = tick <= exhaustionLow

// Main TICK signal
tickMainSignal = ""
tickMainColor = color.white

if isStrongBull
    tickMainSignal := "Strong Bullish Pressure ⚡"
    tickMainColor := color.lime
else if isWeakBull
    tickMainSignal := "Mild Bullish Pressure 🟢"
    tickMainColor := color.green
else if isStrongBear
    tickMainSignal := "Strong Bearish Pressure ⚡"
    tickMainColor := color.red
else if isWeakBear
    tickMainSignal := "Mild Bearish Pressure 🔴"
    tickMainColor := color.maroon
else if isChop
    tickMainSignal := "Choppy / No Edge ⚠️"
    tickMainColor := color.orange
else
    tickMainSignal := "Neutral 🟡"
    tickMainColor := color.gray

tickMainSignal := "TICK (" + tickTF + "): " + tickMainSignal

// Exhaustion Signal (separate cell)
tickExhaustionSignal = ""
tickExhaustionColor = color.new(color.black, 100)  // transparent by default

if isExhaustionBull
    tickExhaustionSignal := "⚠️ Bull Exhaustion Zone"
    tickExhaustionColor := color.orange
else if isExhaustionBear
    tickExhaustionSignal := "⚠️ Bear Exhaustion Zone"
    tickExhaustionColor := color.orange

// RSI Calculation
rsiValue = request.security(useRSISymbol ? rsiSymbol : syminfo.tickerid, rsiTF, ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_on)

// RSI color logic
rsiColor = color.gray  // default neutral color
if rsiValue >= rsiOB
    rsiColor := color.orange
else if rsiValue <= rsiOS
    rsiColor := color.orange

rsiIcon = (rsiValue >= rsiOB or rsiValue <= rsiOS) ? " ⚠️" : ""
rsiLabel = "RSI (" + rsiTF + ")" + (useRSISymbol ? " [" + symbolForRSI + "]" : "") + ": " + str.tostring(rsiValue, "#.0") + rsiIcon

// === DASHBOARD === //
var table dash = table.new(pos == "Top Left" ? position.top_left :pos == "Top Right" ? position.top_right :pos == "Bottom Left" ? position.bottom_left : position.bottom_right, 1, 6, border_width=1)

// 🔁 Refresh dashboard on every bar
table.cell(dash, 0, 0, "VIX: " + str.tostring(vix, "#.00"), text_color=color.white, bgcolor=color.new(color.black, dashTransparency))
table.cell(dash, 0, 1, vixStatus + " " + vixIcon, text_color=color.white, bgcolor=color.new(vixColor, dashTransparency))
table.cell(dash, 0, 2, rsiLabel, text_color=color.white, bgcolor=color.new(rsiColor, dashTransparency))
table.cell(dash, 0, 3, emaLabel, text_color=color.white, bgcolor=color.new(emaColor, dashTransparency))
table.cell(dash, 0, 4, tickMainSignal, text_color=color.white, bgcolor=color.new(tickMainColor, dashTransparency))
table.cell(dash, 0, 5, tickExhaustionSignal, text_color=color.white, bgcolor=(tickExhaustionSignal == "") ? color.new(color.black, 100) : color.new(tickExhaustionColor, dashTransparency))

