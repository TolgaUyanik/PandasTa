//@version=6
// @description: library used in multiple indicators created by traderrick86
library("Library", overlay=false)


// SIMPLE BAR CALCULATIONS

// @function upBar
// @returns Boolean: true if the current bar is up.
export upBar() =>
    close > open

// Global variable for upBar
bool upBar = upBar()

// @function downBar
// @returns Boolean: true if the current bar is down.
export downBar() =>
    close < open

// Global variable for downBar
bool downBar = downBar()

// @function neutralBar
// @returns Boolean: true if the current bar is down.
export neutralBar() =>
    close == open

// Global variable for neutralBar
bool neutralBar = neutralBar()

// @function lowestOfOpenClose
// @returns float: the lower value between the bar's open and close prices.
export lowestOfOpenClose() =>
    math.min(open, close)

// Global variable for lowestOfOpenClose
float lowestOfOpenClose = lowestOfOpenClose()

// @function highestOfOpenClose
// @returns float: the higher value between the bar's open and close prices.
export highestOfOpenClose() =>
    math.max(open, close)

// Global variable for highestOfOpenClose
float highestOfOpenClose = highestOfOpenClose()

// @function barRange
// @returns float: the range of the bar calculated as the difference between high and low.
export barRange() =>
	high - low

// Global variable for barRange
float barRange = barRange()

// @function upperTailRange
// @returns float: The upper tail range of the current bar.
// Calculates the upper tail as follows:
// • For bullish bars (upBar): high - close
// • For bearish bars (downBar): high - open
// • For neutral bars (doji): high - close
export upperTailRange() =>
    upBar ? (high - close) : downBar ? (high - open) : neutralBar ? (high - close) : na

// Global variable for upperTailRange
float upperTailRange = upperTailRange()

// @function lowerTailRange
// @returns float: The lower tail range of the current bar.
// Calculates the lower tail as follows:
// • For bullish bars (upBar): open - low
// • For bearish bars (downBar): close - low
// • For neutral bars (doji): close - low
export lowerTailRange() =>
    upBar ? (open - low) : downBar ? (close - low) : neutralBar ? (close - low) : na

// Global variable for lowerTailRange
float lowerTailRange = lowerTailRange()

// @function totalTailRange
// @returns float: The total tail range of the current bar, computed as the sum of the upper and lower tail ranges.
export totalTailRange() =>
    upperTailRange + lowerTailRange

// Global variable for totalTailRange
float totalTailRange = totalTailRange()

// @function bodyRange
// @returns float: The body range of the current bar, computed as the total bar range minus the total tail range.
export bodyRange() =>
    barRange - totalTailRange

// Global variable for bodyRange
float bodyRange = bodyRange()

// @function upperTailPercent
// @returns float: The upper tail percentage relative to the global barRange.
export upperTailPercent() =>
    (upperTailRange / barRange) * 100

// @function lowerTailPercent
// @returns float: The lower tail percentage relative to the global barRange.
export lowerTailPercent() =>
    (lowerTailRange / barRange) * 100

// @function totalTailPercent
// @returns float: The total tail percentage relative to the global barRange.
export totalTailPercent() =>
    (totalTailRange / barRange) * 100

// @function bodyPercent
// @returns float: The body percentage relative to the global barRange.
export bodyPercent() =>
    (bodyRange() / barRange) * 100


// HELPER FUNCTIONS

// @function validateCondition
// @description: Compares a value against a threshold using the provided operator (case-insensitive).
// @param value float: The value to compare.
// @param operator string: The comparison operator ("<", "<=", ">", ">=", "==").
// @param threshold float: The threshold to compare against.
// @returns bool: Returns true if the condition holds; otherwise, false.
export validateCondition(float value, string operator, float threshold) =>
    string operatorLower = str.lower(operator)
    if operatorLower == ">"
        value > threshold
    else if operatorLower == ">="
        value >= threshold
    else if operatorLower == "<"
        value < threshold
    else if operatorLower == "<="
        value <= threshold
    else if operatorLower == "=="
        value == threshold
    else
        false


// FUNCTIONS WITH PARAMS
// These functions can use globally available variables and helper functions defined earlier.

// @function movingAverage: Computes a moving average for the provided source series using either SMA or EMA,
//                          and optionally applies an additional smoothing step. When smooth is set to 0, no extra
//                          smoothing is applied.
// @param src series float: The source series (e.g., close).
// @param length int: The number of bars to use for the initial moving average calculation.
// @param smooth int: The smoothing factor (set to 0 to disable smoothing).
// @param maType string: The type of moving average to compute ("sma" or "ema").
// @returns series float: The final computed moving average, optionally smoothed.
export movingAverage(float src, int length, int smooth, string maType) =>
    // Compute both SMA and EMA for the source series.
    float sma = ta.sma(src, length)
    float ema = ta.ema(src, length)
    
    // Determine the base moving average according to the specified type.
    float baseMa = na
    if maType == "sma"
        baseMa := sma
    else if maType == "ema"
        baseMa := ema
    else
        baseMa := na

    // Apply an additional smoothing step if requested.
    // When smooth is 0, use 1 as the period so that ta.sma(baseMa, 1) returns baseMa unchanged.
    float smoothedValue = ta.sma(baseMa, smooth > 0 ? smooth : 1)
    
    // Select the final moving average value: use the smoothed value if smoothing is enabled; otherwise, use baseMa.
    float finalMa = baseMa
    if smooth > 0
        finalMa := smoothedValue
    finalMa

// @function validateMeasure
// @param measure float: The measure to validate (e.g., barRange or bodyRange).
// @param avgValue float: The average value used in the threshold calculation.
// @param factor float: The multiplier applied to avgValue to compute the threshold.
// @param operator string: The comparison operator ("<", "<=", ">", ">=") for the check.
// @returns bool: Returns true if measure satisfies the condition (measure [operator] (avgValue * factor)); otherwise, false.
export validateMeasure(float measure, float avgValue, float factor, string operator) =>
    float threshold = avgValue * factor
    validateCondition(measure, operator, threshold)

// @function rangeBetweenBarAndSource: Computes the difference between the bar's price extremes and a given reference level.
//                                     If the bar's low is above the source, it returns the difference (low - source).
//                                     If the bar's high is below the source, it returns the difference (source - high).
//                                     Otherwise, if the source lies within the bar, it returns 0.
// @param source float: The reference level (e.g., a moving average) against which the bar's position is evaluated.
// @returns float: The difference between the bar's extreme and the source when the bar is completely on one side of the source; otherwise, 0.
export rangeBetweenBarAndSource(float source) =>
    low > source ? low - source : high < source ? source - high : 0

// @function percentRangeOnSideOfSource: Calculates the percentage difference between the bar's extreme (the high for "above" or the low for "below")
// and a specified reference level, normalized to the bar's overall range. Returns na if the condition is not met.
// @param side string: Specifies which extreme to compare—use "above" to compare the bar's high to the reference, or "below" to compare the bar's low to the reference (case insensitive).
// @param source float: The reference level (e.g., a moving average) against which the bar's extreme is compared.
// @returns float: The percentage difference between the chosen bar extreme and the reference, expressed as a percentage of the bar's range; returns na if the condition is not satisfied.
export percentRangeOnSideOfSource(string side, float source) =>
    // Convert the input side to lowercase for case-insensitive comparison.
    string sideLower = str.lower(side)
    
    // Calculate the percentage difference based on the specified side.
    float percent = na
    if sideLower == "above"
        percent := high > source ? ((high - source) / barRange) * 100 : na
    else if sideLower == "below"
        percent := low < source ? ((source - low) / barRange) * 100 : na
    else
        percent := na
    percent

// @function percentBodyOnSideOfSource: Calculates the percentage difference between the relevant boundary of the bar's body
// and a specified reference level, normalized to the bar's body range. For "above", it compares the upper boundary of the body
// (highestOfOpenClose) to the reference; for "below", it compares the lower boundary of the body (lowestOfOpenClose) to the reference.
// Returns na if the condition is not met.
// @param side string: Specifies which boundary of the body to compare—use "above" to compare the upper boundary to the reference,
//                     or "below" to compare the lower boundary to the reference (case insensitive).
// @param source float: The reference level (e.g., a moving average) against which the body's boundary is compared.
// @returns float: The percentage difference between the chosen body boundary and the reference, expressed as a percentage of the bar's body range; returns na if the condition is not satisfied.
export percentBodyOnSideOfSource(string side, float source) =>
    // Convert the input side to lowercase for case-insensitive comparison.
    string sideLower = str.lower(side)
    
    // Calculate the percentage difference based on the specified side.
    float percent = na
    if sideLower == "above"
        percent := highestOfOpenClose > source ? ((highestOfOpenClose - source) / bodyRange) * 100 : na
    else if sideLower == "below"
        percent := lowestOfOpenClose < source ? ((source - lowestOfOpenClose) / bodyRange) * 100 : na
    else
        percent := na
    percent
