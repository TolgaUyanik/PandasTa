//@version=5
indicator("Smart Trap Candle Detector [Pro]", overlay=true, max_bars_back=100)

// === Inputs ===
lookback     = input.int(10, "Swing Lookback Period", minval=2)
confirmTrap  = input.bool(true, "Require Confirmation Candle")
showLabels   = input.bool(true, "Show Trap Labels")
enableAlerts = input.bool(true, "Enable Trap Alerts")

// === Utility Functions ===
getSwingHigh(period) =>
    ta.highest(high, period) == high[period / 2]

getSwingLow(period) =>
    ta.lowest(low, period) == low[period / 2]

getLastSwingHigh(period) =>
    ta.valuewhen(getSwingHigh(period), high, 0)

getLastSwingLow(period) =>
    ta.valuewhen(getSwingLow(period), low, 0)

// === Trap Candle Logic ===
swingHigh = getLastSwingHigh(lookback)
swingLow  = getLastSwingLow(lookback)

// Bearish Trap: Breaks above high, closes below
bearTrap = high > swingHigh and close < swingHigh
// Bullish Trap: Breaks below low, closes above
bullTrap = low < swingLow and close > swingLow

// Confirmation Logic
confirmBear = confirmTrap ? close[1] < open[1] : true
confirmBull = confirmTrap ? close[1] > open[1] : true

finalBearTrap = bearTrap and confirmBear
finalBullTrap = bullTrap and confirmBull

// === Plotting ===
plotshape(finalBearTrap, title="Bearish Trap", location=location.abovebar, style=shape.labeldown,
     color=color.red, size=size.small, text="Trap", textcolor=color.white)

plotshape(finalBullTrap, title="Bullish Trap", location=location.belowbar, style=shape.labelup,
     color=color.green, size=size.small, text="Trap", textcolor=color.white)

if showLabels
    if finalBearTrap
        label.new(bar_index, high, "Bear Trap", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
    if finalBullTrap
        label.new(bar_index, low, "Bull Trap", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)

// === Alerts ===
alertcondition(finalBearTrap, title="Bearish Trap Detected", message="Bearish Trap on {{ticker}}")
alertcondition(finalBullTrap, title="Bullish Trap Detected", message="Bullish Trap on {{ticker}}")
