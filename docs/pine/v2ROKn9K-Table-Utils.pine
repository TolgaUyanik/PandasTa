dash_position = input.string("Middle Right", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=G_DASH, tooltip="Selects the anchor position of the dashboard on your screen.")
dash_size = input.string("Normal", "Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=G_DASH, tooltip="Adjusts the overall scale of the text and cells within the dashboard.")
force_overlay = input.bool(false, "Force Overlay Mode", group=G_DASH, tooltip="If enabled, forces the table to render on top of the price bars.")




if show_dashboard
    var table my_dash = table.new(get_position(dash_position), 2, 2, bgcolor=color.new(color.black, 50), border_width=1)
    
    if barstate.islast
        table.cell(my_dash, 0, 0, "Status", text_color=color.white, text_size=get_size(dash_size))
        table.cell(my_dash, 1, 0, "Active", text_color=color.green, text_size=get_size(dash_size))