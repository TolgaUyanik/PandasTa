//@version=6
// @description Enhanced Table Utilities for Professional Dashboards
// @version 2.0
// @HORAZIO
library("Table_Utils", overlay=true)

//═══════════════════════════════════════════════════════════════════════════
// 🎯 POSITION MANAGEMENT
//═══════════════════════════════════════════════════════════════════════════

// @function Convert string to position constant
// @param posStr User-selected position string
// @returns Pine Script position constant
export get_position(string posStr) =>
    switch posStr
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

//═══════════════════════════════════════════════════════════════════════════
// 📏 SIZE MANAGEMENT
//═══════════════════════════════════════════════════════════════════════════

// @function Convert string to size constant
// @param sizeStr User-selected size string
// @returns Pine Script size constant
export get_size(string sizeStr) =>
    switch sizeStr
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.normal

//═══════════════════════════════════════════════════════════════════════════
// 🎨 COLOR SCHEMES (PREDEFINED PALETTES)
//═══════════════════════════════════════════════════════════════════════════

// @function Get color from predefined palette
// @param scheme Palette name: "Cyberpunk", "Professional", "Pastel", "Dark"
// @param colorType Color role: "bull", "bear", "neutral", "bg", "border"
// @returns Color value
export get_theme_color(string scheme, string colorType) =>
    color result = na
    
    if scheme == "Cyberpunk"
        result := switch colorType
            "bull"    => #00ff7f
            "bear"    => #ff1493
            "neutral" => #8a2be2
            "bg"      => #14141e
            "border"  => #00ffff
            => color.gray
    
    else if scheme == "Professional"
        result := switch colorType
            "bull"    => #00e676
            "bear"    => #ff5252
            "neutral" => #9e9e9e
            "bg"      => #1e1e28
            "border"  => #646478
            => color.gray
    
    else if scheme == "Pastel"
        result := switch colorType
            "bull"    => #90ee90
            "bear"    => #ffb6c1
            "neutral" => #bb85bb
            "bg"      => #f5f5f5
            "border"  => #a9a9a9
            => color.gray
    
    else if scheme == "Dark"
        result := switch colorType
            "bull"    => #00c853
            "bear"    => #c80032
            "neutral" => #787878
            "bg"      => #0a0a0f
            "border"  => #32323c
            => color.gray
    
    result

//═══════════════════════════════════════════════════════════════════════════
// 🏗️ TABLE CREATION HELPERS
//═══════════════════════════════════════════════════════════════════════════

// @function Create standard dashboard table with preset styling
// @param posStr Position string
// @param cols Number of columns
// @param rows Number of rows
// @param scheme Color scheme name
// @returns Configured table object
export create_dashboard(string posStr, int cols, int rows, string scheme) =>
    table tbl = table.new(
        position=get_position(posStr),
        columns=cols,
        rows=rows,
        border_width=2,
        border_color=get_theme_color(scheme, "border"),
        frame_color=get_theme_color(scheme, "bg"),
        frame_width=2
    )
    tbl
export create_dashboard_FO(string posStr, int cols, int rows, string scheme) =>
    table tbl = table.new(
        position=get_position(posStr),
        columns=cols,
        rows=rows,
        border_width=2,
        border_color=get_theme_color(scheme, "border"),
        frame_color=get_theme_color(scheme, "bg"),
        frame_width=2,
        force_overlay = true
    )
    tbl

//═══════════════════════════════════════════════════════════════════════════
// 📝 CELL STYLING HELPERS
//═══════════════════════════════════════════════════════════════════════════

// @function Add header cell with preset styling
// @param tbl Table object
// @param col Column index
// @param row Row index
// @param text Cell text
// @param scheme Color scheme
export add_header_cell(table tbl, int col, int row, string text_, string scheme) =>
    table.cell(
        table_id=tbl,
        column=col,
        row=row,
        text=text_,
        text_color=color.white,
        bgcolor=get_theme_color(scheme, "border"),
        text_size=size.normal
    )
    true

// @function Add data cell with conditional coloring
// @param tbl Table object
// @param col Column index
// @param row Row index
// @param text Cell text
// @param value Numeric value for color coding
// @param scheme Color scheme
export add_data_cell(table tbl, int col, int row, string text_, float value, string scheme) =>
    color cellColor = value > 0 ? 
                      get_theme_color(scheme, "bull") : 
                      value < 0 ? 
                      get_theme_color(scheme, "bear") : 
                      get_theme_color(scheme, "neutral")
    
    table.cell(
        table_id=tbl,
        column=col,
        row=row,
        text=text_,
        text_color=cellColor,
        bgcolor=get_theme_color(scheme, "bg"),
        text_size=size.small
    )
    true

//═══════════════════════════════════════════════════════════════════════════
// 🔢 NUMBER FORMATTING
//═══════════════════════════════════════════════════════════════════════════

// @function Format number with appropriate suffix (K, M, B)
// @param value Number to format
// @param decimals Number of decimal places
// @returns Formatted string
export format_number(float value, int decimals) =>
    string result = ""
    
    if math.abs(value) >= 1e9
        result := str.tostring(value / 1e9, "#." + str.repeat("#", decimals)) + "B"
    else if math.abs(value) >= 1e6
        result := str.tostring(value / 1e6, "#." + str.repeat("#", decimals)) + "M"
    else if math.abs(value) >= 1e3
        result := str.tostring(value / 1e3, "#." + str.repeat("#", decimals)) + "K"
    else
        result := str.tostring(value, "#." + str.repeat("#", decimals))
    
    result

// @function Format percentage with sign
// @param value Percentage value (as decimal, e.g., 0.05 = 5%)
// @returns Formatted string with % symbol
export format_percentage(float value) =>
    string sign = value > 0 ? "+" : ""
    sign + str.tostring(value * 100, "#.##") + "%"

// =============================================================================
// INPUTS & CONFIGURATION
// =============================================================================

