//@version=6
strategy("EXPMA三线回踩｜多1绿多2蓝多3紫", overlay=true, default_qty_type=strategy.cash, default_qty_value=100000, commission_type=strategy.commission.percent, commission_value=0.13, precision=2)

//===== 参数 =====
len10 = 10
len20 = 20
vol_ma_len = 20
min_vol_mult = input.float(1.0, title="成交量下限倍数(改1.0更容易出信号)")
max_vol_mult = input.float(3.5, title="成交量上限倍数")
min_ma_bias = input.float(0.0, title="EXPMA乖离下限%")
max_ma_bias = input.float(2.5, title="EXPMA乖离上限%")
max_upper_shadow = input.float(0.8, title="上影/收盘价上限%")

//止损
stop_loss_p1 = input.float(3.5, title="多1固定止损%")
stop_loss_p2 = input.float(3.0, title="多2固定止损%")
stop_loss_p3 = input.float(2.2, title="多3固定止损%")

//止盈
tp1_p1 = input.float(7.0, title="多1一档止盈%")
tp2_p1 = input.float(13.0, title="多1二档止盈%")
tp1_p2 = input.float(6.0, title="多2一档止盈%")
tp2_p2 = input.float(11.0, title="多2二档止盈%")
tp1_p3 = input.float(5.0, title="多3一档止盈%")
tp2_p3 = input.float(9.0, title="多3二档止盈%")

//指标
expma10 = ta.ema(close, len10)
expma20 = ta.ema(close, len20)
vol_ma = ta.sma(volume, vol_ma_len)

ma_bias = (expma10 - expma20) / expma20 * 100
upper_shadow_pct = (high - close) / close * 100
day_gain = ta.change(close) / close[1] * 100

//条件
cond_vol = volume >= vol_ma * min_vol_mult and volume <= vol_ma * max_vol_mult
cond_bias = ma_bias >= min_ma_bias and ma_bias <= max_ma_bias
cond_shadow = upper_shadow_pct < max_upper_shadow
cond_up = day_gain > 0
cond_trend = expma10 > expma20

//三类信号
sig1 = cond_trend and open>expma10 and low<=expma20 and close>expma10 and cond_up and cond_bias and cond_shadow and cond_vol
sig2 = cond_trend and open>expma20 and open<expma10 and low<=expma20 and close>expma10 and cond_up and cond_bias and cond_shadow and cond_vol
sig3 = cond_trend and open>expma10 and low<=expma10 and close>expma10 and cond_up and cond_bias and cond_shadow and cond_vol

//绘制箭头（K线下立刻出现标记）
plotshape(sig1, title="多1", location=location.belowbar, color=color.green, style=shape.labelup, text="多1", textcolor=color.white, size=size.small)
plotshape(sig2, title="多2", location=location.belowbar, color=color.blue, style=shape.labelup, text="多2", textcolor=color.white, size=size.small)
plotshape(sig3, title="多3", location=location.belowbar, color=color.purple, style=shape.labelup, text="多3", textcolor=color.white, size=size.small)

//均线
plot(expma10, color=color.orange, title="EXPMA10", linewidth=2)
plot(expma20, color=color.teal, title="EXPMA20", linewidth=2)

//交易变量 V6 var保持写法兼容
var float entry_price = na
var int pos_type = 0 //1多1 2多2 3多3
var int hold_days = 0

//开仓：信号次日开盘买入（TV规则）
if sig1[1] and pos_type==0
    strategy.entry("Long", strategy.long)
    entry_price := open
    pos_type := 1
    hold_days := 0
if sig2[1] and pos_type==0
    strategy.entry("Long", strategy.long)
    entry_price := open
    pos_type := 2
    hold_days := 0
if sig3[1] and pos_type==0
    strategy.entry("Long", strategy.long)
    entry_price := open
    pos_type := 3
    hold_days := 0

//持仓计数
if strategy.position_size>0
    hold_days +=1

//动态止损价 switch V6原生支持
stop_price = switch pos_type
    1 => entry_price*(1-stop_loss_p1/100)
    2 => entry_price*(1-stop_loss_p2/100)
    3 => entry_price*(1-stop_loss_p3/100)

//盈利上移止损
if strategy.position_size>0 and close/entry_price>=1.05
    stop_price := math.max(stop_price, entry_price)
if strategy.position_size>0 and close/entry_price>=1.10
    stop_price := math.max(stop_price, entry_price + (close-entry_price)/2)

//止损&时间止损
exit_stop = close <= stop_price or close <= expma20
time_exit = hold_days>=3 and ta.highest(high,3)/entry_price <1.05

//分批止盈
if pos_type==1 and strategy.position_size>0
    pos_amt = strategy.position_size
    if close/entry_price >= 1+tp1_p1/100
        strategy.close("Long", qty=pos_amt*0.4, comment="多1一档止盈")
    if close/entry_price >=1+tp2_p1/100
        strategy.close("Long", comment="多1二档全平")

if pos_type==2 and strategy.position_size>0
    pos_amt = strategy.position_size
    if close/entry_price >=1+tp1_p2/100
        strategy.close("Long", qty=pos_amt*0.5, comment="多2一档止盈")
    if close/entry_price >=1+tp2_p2/100
        strategy.close("Long", comment="多2二档全平")

if pos_type==3 and strategy.position_size>0
    pos_amt = strategy.position_size
    if close/entry_price >=1+tp1_p3/100
        strategy.close("Long", qty=pos_amt*0.5, comment="多3一档止盈")
    if close/entry_price >=1+tp2_p3/100
        strategy.close("Long", comment="多3二档全平")

//止损离场
if strategy.position_size>0 and (exit_stop or time_exit)
    strategy.close("Long", comment="止损/时间离场")

//空仓重置
if strategy.position_size==0
    entry_price:=na
    pos_type:=0
    hold_days:=0