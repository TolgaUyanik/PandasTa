import robbatt/lib_no_delay/18 as ND

//@version=6
//@description This library calculates the momentum, derived from a sample range of prior candles. Depending on set MomentumType it either deduces the momentum from the price, volume, or a product of both. If price/product are selected, you can choose from SampleType if only candle body, full range from high to low or a combination of both (body counts full, wicks half for each direction) should be used. Optional: You can choose to normalize the results, dividing each value by its average (normalization_ma_length, normalization_ma). This will allow comparison between different instruments. For the normalization Moving Average you can choose any currently supported in my lib_no_delay.
library("lib_momentum", dynamic_requests = true)

export enum MomentumType
    Price
    Volume
    Product
    
export enum SampleType
    Body        // counts abs(close - open)
    Range       // counts high - low
    Body_Range  // counts abs(close - open) + each wick once per direction
    
//@description returns the current momentum [total, up, down] derived from the set sample length and types
//@param momentum_type select one of MomentumType.[Price, Volume, Product] to sample the price, volume or a product of both
//@param sample_type select one of SampleType.[Body, Range, Body_Range] to sample the body, total range from high to low or a combination of both (body count full, wicks half for each direction)
//@param sample_length how many candles should be sampled (including the current)
//@param normalization_ma_length if you want to normalize results (momentum / momentum average) this sets the period for the average. (default = 0 => no normalization)
//@param normalization_ma is the type of moving average to normalize / compare with
//@returns returns the current momentum [total, up, down] where the total line is not just (up - down) but also sampled over the sample_length and can therefore be used as trend indicator. If up/down fail to reach total's level it's a sign of decreasing momentum, if up/down exceed total the trend it's a sign of increasing momentum.
export get_momentum(MomentumType momentum_type, SampleType sample_type, simple int sample_length = 3, simple int normalization_ma_length = 0, simple ND.MovingAverage normalization_ma = ND.MovingAverage.SMA) =>
    float momentum_total = 0.
    float momentum_up = 0.
    float momentum_dn = 0.

    top = math.max(open, close)
    btm = math.min(open, close)
    mode = math.sign(close - open)
    body = math.abs(close - open)
    full = high - low
    wicks = full - body

    float price_up = switch sample_type
        SampleType.Body => mode == 1 ? body : 0
        SampleType.Range => mode == 1 ? full : 0
        SampleType.Body_Range => mode == 1 ? full : wicks
        
    float price_dn = switch sample_type
        SampleType.Body => mode == -1 ? body : 0
        SampleType.Range => mode == -1 ? full : 0
        SampleType.Body_Range => mode == -1 ? full : wicks

    float volume_up  = switch sample_type
        SampleType.Body => mode == 1 ? volume : 0
        SampleType.Range => mode == 1 ? volume : 0
        SampleType.Body_Range => mode == 1 ? (body + wicks/2)/full * volume : (wicks/2)/full * volume
        //  mode ==  1 ? volume : 0        
        
    float volume_dn  = switch sample_type
        SampleType.Body => mode == -1 ? volume : 0
        SampleType.Range => mode == -1 ? volume : 0
        SampleType.Body_Range => mode == -1 ? (body + wicks/2)/full * volume : (wicks/2)/full * volume
    // float volume_dn  = mode == -1 ? volume : 0
        
    float product_up = price_up * volume_up
    float product_dn = price_dn * volume_dn

    if normalization_ma_length > 1
        if momentum_type == MomentumType.Price
            price_up  := price_up  / ND.get_ma(normalization_ma, price_up , normalization_ma_length)
            price_dn  := price_dn  / ND.get_ma(normalization_ma, price_dn , normalization_ma_length)
        if momentum_type == MomentumType.Volume
            volume_up := volume_up / ND.get_ma(normalization_ma, volume_up, normalization_ma_length)
            volume_dn := volume_dn / ND.get_ma(normalization_ma, volume_dn, normalization_ma_length)
        if momentum_type == MomentumType.Product
            product_up := product_up / ND.get_ma(normalization_ma, product_up, normalization_ma_length)
            product_dn := product_dn / ND.get_ma(normalization_ma, product_dn, normalization_ma_length)
        

    if not barstate.isfirst

        int samples = math.min(bar_index, sample_length)
        int samples_up = 0
        int samples_dn = 0

        for int i = 0 to samples-1

            momentum_up += switch momentum_type
                MomentumType.Price => price_up[i]
                MomentumType.Volume => volume_up[i]
                MomentumType.Product => product_up[i]

            momentum_dn += switch momentum_type
                MomentumType.Price => price_dn[i]
                MomentumType.Volume => volume_dn[i]
                MomentumType.Product => product_dn[i]

            momentum_total += momentum_up - momentum_dn

        if normalization_ma_length > 1
            sup = samples_up > 0 ? samples_up : 1
            sdn = samples_dn > 0 ? samples_dn : 1
            momentum_up := momentum_up / sup
            momentum_dn := momentum_dn / sdn
            momentum_total := momentum_total / (sup + sdn)
        
    [momentum_total, momentum_up, -momentum_dn]


var momentum_type                       = input.enum(MomentumType.Product, 'Type')
var sample_type                         = input.enum(SampleType.Body, 'Sample')
var sample_length                       = input.int(3, 'sample length')
var normalize                           = input.bool(true, 'normalize', inline = 'normal')
var ND.MovingAverage normalize_ma_type  = input.enum(ND.MovingAverage.EMA, 'MA for comparison', inline = 'normal')
var normalize_ma_length                 = input.int(50, '', inline = 'normal')

[momentum_total, momentum_up, momentum_dn] = get_momentum(momentum_type, sample_type, sample_length, normalize ? normalize_ma_length : 0, normalize_ma_type)

plot(0,'0', color.gray, display = display.pane)

var show_htf = input.bool(false, 'HTF', inline = 'htf')
var display_htf = show_htf ? display.all : display.none
var htf = input.timeframe('1D', '', inline = 'htf')

var float htf_momentum_total = na
var float htf_momentum_up = na
var float htf_momentum_dn = na

if show_htf
    [_htf_momentum_total, _htf_momentum_up, _htf_momentum_dn] = request.security(syminfo.tickerid, htf, [momentum_total, momentum_up, momentum_dn], barmerge.gaps_on)
    if not na(_htf_momentum_total)
        htf_momentum_total := _htf_momentum_total
        htf_momentum_up := _htf_momentum_up
        htf_momentum_dn := _htf_momentum_dn

bool htf_bullish = htf_momentum_up < htf_momentum_total
bool htf_bearish = htf_momentum_dn > htf_momentum_total
p_htf_momentum_total = plot(htf_momentum_total , 'htf momentum total' , color.new(color.gray, 70)  , style = plot.style_stepline, display = display_htf)
p_htf_momentum_up    = plot(htf_momentum_up    , 'htf momentum up'    , color.new(color.green, 70) , style = plot.style_stepline, display = display_htf)
p_htf_momentum_dn    = plot(htf_momentum_dn    , 'htf momentum dn'    , color.new(color.red, 70)   , style = plot.style_stepline, display = display_htf)
fill(p_htf_momentum_total, p_htf_momentum_up, htf_bullish ? color.new(color.green, 70) : na, display = display_htf)
fill(p_htf_momentum_total, p_htf_momentum_dn, htf_bearish ? color.new(color.red, 70) : na, display = display_htf)

var line line_continuation_htf_momentum_total= line.new(chart.point.now(na), chart.point.now(na), color = color.new(color.gray, 70), extend = extend.right, style = line.style_dashed) 
var line line_continuation_htf_momentum_up   = line.new(chart.point.now(na), chart.point.now(na), color = color.new(color.green, 70), extend = extend.right, style = line.style_dashed)
var line line_continuation_htf_momentum_dn   = line.new(chart.point.now(na), chart.point.now(na), color = color.new(color.red, 70), extend = extend.right, style = line.style_dashed)

if not na(htf_momentum_total) and show_htf
    line_continuation_htf_momentum_total.set_xy1(bar_index, htf_momentum_total) 
    line_continuation_htf_momentum_up.set_xy1(bar_index, htf_momentum_up) 
    line_continuation_htf_momentum_dn.set_xy1(bar_index, htf_momentum_dn) 
    line_continuation_htf_momentum_total.set_xy2(bar_index + 1, htf_momentum_total) 
    line_continuation_htf_momentum_up.set_xy2(bar_index + 1, htf_momentum_up) 
    line_continuation_htf_momentum_dn.set_xy2(bar_index + 1, htf_momentum_dn) 

plot(momentum_total , 'momentum total' , color.gray)
plot(momentum_up    , 'momentum up'    , color.green)
plot(momentum_dn    , 'momentum dn'    , color.red)

plot(ND.get_ma(ND.MovingAverage.HMA, momentum_total, 100) , 'momentum total HMA30' , color.new(color.gray, 80))
plot(ND.get_ma(ND.MovingAverage.HMA, momentum_up, 100)    , 'momentum up HMA30'    , color.new(color.green, 80))
plot(ND.get_ma(ND.MovingAverage.HMA, momentum_dn, 100)    , 'momentum dn HMA30'    , color.new(color.red, 80))


int   atr_th_len  = input.int  (50, 'ATR Threshold len', inline = 'atr')
float atr_th_mult = input.float(2 , 'x'                , inline = 'atr')
float atr_th = ta.atr(atr_th_len) * atr_th_mult
plot(atr_th, 'atr threshold', color = color.gray)
plot(-atr_th, 'atr threshold', color = color.gray)

float momentum_up_delta = ta.change(momentum_up)
float momentum_dn_delta = ta.change(momentum_dn)

int delta_len = input.int(3, 'Momentum Delta Average Length')
float momentum_up_delta_avg = ND.wma(momentum_up_delta, delta_len)
float momentum_dn_delta_avg = ND.wma(momentum_dn_delta, delta_len)

plot(momentum_up_delta_avg, 'momentum_up_delta_avg', color = #74e007)
plot(momentum_dn_delta_avg, 'momentum_dn_delta_avg', color = #ff9913)

int change_len = input.int(3, 'Momentum change length')
float momentum_up_change = ta.change(momentum_up)
float momentum_dn_change = ta.change(momentum_dn)
plotshape(ta.wma(momentum_up_change, change_len) > atr_th, 'momentum_change_up', shape.circle, location.top, color.green)
plotshape(ta.wma(momentum_dn_change, change_len) < - atr_th, 'momentum_change_dn', shape.circle, location.bottom, color.red)
plotshape(ta.wma(momentum_up_change, change_len) < - atr_th, 'momentum_change_up', shape.circle, location.top, color.gray)
plotshape(ta.wma(momentum_dn_change, change_len) > atr_th, 'momentum_change_dn', shape.circle, location.bottom, color.gray)

