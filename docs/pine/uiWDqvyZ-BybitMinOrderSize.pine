// @function Retrieves the required quantity precision (decimal places) for a given Bybit symbol.
// @param symbol <string> The symbol used to determine its minimum order size (default: syminfo.ticker).
// @returns <int> The number of decimal places derived from the symbol’s minimum order size.
export getPrecisionForTicker(string symbol = syminfo.ticker) =>
    minOrder = getMinOrderSize(symbol)
    precisionFromMinOrder(minOrder)

// @function Rounds a quantity down to the nearest valid minimum order size for a given symbol.
// @param qty <float> The quantity to be rounded down.
// @param symbol <string> The symbol used to determine its minimum order size (default: syminfo.ticker).
// @param minOrderSize <float> Optional user-provided minimum order size. If na, will lookup from getMinOrderSize().
// @returns <float> The quantity rounded down to the nearest allowed minimum order size.
export floorQty(float qty, string symbol = syminfo.ticker, float minOrderSize = na) =>
	float minOrder = na(minOrderSize) ? getMinOrderSize(symbol) : minOrderSize
	if na(minOrder)
		qty  // return unchanged
	else
		math.floor(qty / minOrder) * minOrder

// @function Rounds a quantity to the valid precision for the specified symbol.
// @param qty <float> The quantity to be rounded.
// @param symbol <string> The symbol used to determine its quantity precision (default: syminfo.ticker).
// @param precision <int> Optional user-provided precision. If na, will lookup from getPrecisionForTicker().
// @returns <float> The quantity rounded to the symbol’s required precision.
export roundQty(float qty, string symbol = syminfo.ticker, int precision = na) =>
    int prec = na(precision) ? getPrecisionForTicker(symbol) : precision
    math.round(qty, prec)