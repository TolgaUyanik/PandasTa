//@version=6
indicator("Vaibhav WORLD Dashboard PRO", shorttitle="WORLD PRO", overlay=true)

//══════════════════════════════════════
// SETTINGS
//══════════════════════════════════════

groupDash = "Dashboard"

dashPos = input.string(
     "Top Right",
     "Position",
     options = ["Top Left","Top Right","Bottom Left","Bottom Right"],
     group = groupDash)

txtSizeInput = input.string(
     "Small",
     "Text Size",
     options = ["Tiny","Small","Normal","Large"],
     group = groupDash)

//══════════════════════════════════════
// SYMBOLS
//══════════════════════════════════════

groupSym = "Symbols"

symDJI   = input.symbol("TVC:DJI", "Dow Jones", group = groupSym)
symSPX   = input.symbol("SPCFD:SPX", "S&P 500", group = groupSym)
symNDX   = input.symbol("NASDAQ:NDX", "Nasdaq 100", group = groupSym)
symRUT   = input.symbol("TVC:RUT", "Russell 2000", group = groupSym)
symVIX = input.symbol("TVC:VIX", "CBOE VIX", group=groupSym)
symBRENT = input.symbol("TVC:UKOIL", "Brent Crude", group = groupSym)
symMCX   = input.symbol("MCX:MCXCRUDEX", "MCX Crude", group = groupSym)

//══════════════════════════════════════
// TEXT SIZE
//══════════════════════════════════════

txtSize =
     txtSizeInput == "Tiny" ? size.tiny :
     txtSizeInput == "Normal" ? size.normal :
     txtSizeInput == "Large" ? size.large :
     size.small

//══════════════════════════════════════
// TABLE POSITION
//══════════════════════════════════════

tablePos =
     dashPos == "Top Left" ? position.top_left :
     dashPos == "Bottom Left" ? position.bottom_left :
     dashPos == "Bottom Right" ? position.bottom_right :
     position.top_right

//══════════════════════════════════════
// TABLE
//══════════════════════════════════════

var table dash = table.new(
     tablePos,
     4,
     9,
     bgcolor = color.rgb(12,12,18),
     frame_color = color.rgb(70,70,70),
     border_color = color.rgb(45,45,45))

//══════════════════════════════════════
// HELPER FUNCTIONS
//══════════════════════════════════════

fPrice(sym)=>
    request.security(sym,timeframe.period,close)

fPrev(sym)=>
    request.security(sym,timeframe.period,close[1])

fChange(sym)=>
    c = fPrice(sym)
    p = fPrev(sym)
    p != 0 ? ((c-p)/p)*100 : na

fPoints(sym)=>
    fPrice(sym)-fPrev(sym)

fColor(v)=>
    na(v) ? color.gray : v >= 0 ? color.lime : color.red
//══════════════════════════════════════
// LIVE DATA
//══════════════════════════════════════

djiPrice = fPrice(symDJI)
djiChg   = fChange(symDJI)
djiPts   = fPoints(symDJI)

spxPrice = fPrice(symSPX)
spxChg   = fChange(symSPX)
spxPts   = fPoints(symSPX)

ndxPrice = fPrice(symNDX)
ndxChg   = fChange(symNDX)
ndxPts   = fPoints(symNDX)

rutPrice = fPrice(symRUT)
rutChg   = fChange(symRUT)
rutPts   = fPoints(symRUT)

vixPrice = fPrice(symVIX)
vixChg   = fChange(symVIX)
vixPts   = fPoints(symVIX)

brentPrice = fPrice(symBRENT)
brentChg   = fChange(symBRENT)
brentPts   = fPoints(symBRENT)

mcxPrice = fPrice(symMCX)
mcxChg   = fChange(symMCX)
mcxPts   = fPoints(symMCX)

//══════════════════════════════════════
// DRAW ROW FUNCTION
//══════════════════════════════════════

fRow(_row, _name, _price, _chg, _pts)=>

    table.cell(
         dash, 0, _row,
         _name,
         text_color=color.white,
         text_size=txtSize)

    table.cell(
         dash, 1, _row,
         str.tostring(_price, format.mintick),
         text_color=color.white,
         text_size=txtSize)

    table.cell(
         dash, 2, _row,
         str.tostring(_chg, "#.##") + "%",
         text_color=fColor(_chg),
         text_size=txtSize)

    ptsText = (_pts >= 0 ? "+" : "") + str.tostring(_pts, format.mintick)

    table.cell(
         dash, 3, _row,
         ptsText,
         text_color=fColor(_chg),
         text_size=txtSize)

//══════════════════════════════════════
// HEADER
//══════════════════════════════════════

if barstate.islast

    table.cell(dash,0,0,"WORLD", text_color=color.yellow, text_size=txtSize)
    table.cell(dash,1,0,"PRICE", text_color=color.white, text_size=txtSize)
    table.cell(dash,2,0,"%", text_color=color.white, text_size=txtSize)
    table.cell(dash,3,0,"POINTS", text_color=color.white, text_size=txtSize)

//══════════════════════════════════════
// DRAW DASHBOARD
//══════════════════════════════════════

if barstate.islast

    fRow(1,"DOW",djiPrice,djiChg,djiPts)
    fRow(2,"S&P500",spxPrice,spxChg,spxPts)
    fRow(3,"NASDAQ",ndxPrice,ndxChg,ndxPts)
    fRow(4,"RUSSELL",rutPrice,rutChg,rutPts)
    fRow(5,"VIX",vixPrice,vixChg,vixPts)
    fRow(6,"BRENT",brentPrice,brentChg,brentPts)
    fRow(7,"MCX",mcxPrice,mcxChg,mcxPts)
    //══════════════════════════════════════
// PART-3 : PREMIUM UI
//══════════════════════════════════════

headerBg = color.rgb(18,30,60)
panelBg  = color.rgb(10,10,15)

if barstate.islast

    // Header Background
    for c = 0 to 3
        table.cell_set_bgcolor(dash, c, 0, headerBg)

    // Data Background
    for r = 1 to 7
        for c = 0 to 3
            table.cell_set_bgcolor(dash, c, r, panelBg)

    // Header Text Color
    for c = 0 to 3
        table.cell_set_text_color(dash, c, 0, color.white)

    table.cell_set_text_color(dash, 0, 0, color.yellow)


//══════════════════════════════════════
// FOOTER
//══════════════════════════════════════

if barstate.islast

    table.cell(
         dash,0,8,
         "VAIBHAV",
         text_color=color.yellow,
         bgcolor=headerBg,
         text_size=txtSize)

    table.cell(
         dash,1,8,
         "WORLD",
         text_color=color.white,
         bgcolor=headerBg,
         text_size=txtSize)

    table.cell(
         dash,2,8,
         "LIVE",
         text_color=color.lime,
         bgcolor=headerBg,
         text_size=txtSize)

    table.cell(
         dash,3,8,
         "PRO",
         text_color=color.aqua,
         bgcolor=headerBg,
         text_size=txtSize)
         //══════════════════════════════════════
// PART-4 : WORLD MARKET STATUS
//══════════════════════════════════════

// World Strength Score
bullScore = 0
bullScore += djiChg > 0 ? 1 : 0
bullScore += spxChg > 0 ? 1 : 0
bullScore += ndxChg > 0 ? 1 : 0
bullScore += rutChg > 0 ? 1 : 0
bullScore += vixChg < 0 ? 1 : 0
bullScore += brentChg > 0 ? 1 : 0
bullScore += mcxChg > 0 ? 1 : 0

// Market Status
statusText =
     bullScore >= 5 ? "BULLISH" :
     bullScore >= 3 ? "NEUTRAL" :
     "BEARISH"

statusColor =
     bullScore >= 5 ? color.lime :
     bullScore >= 3 ? color.orange :
     color.red

//══════════════════════════════════════
// UPDATE FOOTER
//══════════════════════════════════════

if barstate.islast

    table.cell(
         dash,
         2,
         8,
         statusText,
         text_color=statusColor,
         bgcolor=headerBg,
         text_size=txtSize)

//══════════════════════════════════════
// TOP STATUS BAR
//══════════════════════════════════════

         //══════════════════════════════════════
// PART-5 : PREMIUM FINISH
//══════════════════════════════════════

// Header & Footer Background
if barstate.islast

    // Header
    for c = 0 to 3
        table.cell_set_bgcolor(dash, c, 0, color.rgb(15,25,55))

    // Footer
    for c = 0 to 3
        table.cell_set_bgcolor(dash, c, 8, color.rgb(15,25,55))

    // Altislast$0label.newernate Row Colors
    for r = 1 to 7

        bg = r % 2 == 0 ? color.rgb(16,16,24) : color.rgb(11,11,18)

        for c = 0 to 3
            table.cell_set_bgcolor(dash, c, r, bg)

    // Highlight % Column
    table.cell_set_bgcolor(dash, 2, 1, color.new(fColor(djiChg),85))
    table.cell_set_bgcolor(dash, 2, 2, color.new(fColor(spxChg),85))
    table.cell_set_bgcolor(dash, 2, 3, color.new(fColor(ndxChg),85))
    table.cell_set_bgcolor(dash, 2, 4, color.new(fColor(rutChg),85))
    table.cell_set_bgcolor(dash, 2, 5, color.new(fColor(vixChg),85))
    table.cell_set_bgcolor(dash, 2, 6, color.new(fColor(brentChg),85))
    table.cell_set_bgcolor(dash, 2, 7, color.new(fColor(mcxChg),85))
    //══════════════════════════════════════
//══════════════════════════════════════
// FINAL FOOTER
//══════════════════════════════════════

currentTime = str.format("{0,time,HH:mm}", time)

marketOpen = not na(time(timeframe.period, "0930-1600"))

if barstate.islast

    // TIME
    table.cell(
         dash, 0, 8,
         currentTime,
         text_color=color.yellow,
         bgcolor=headerBg,
         text_size=txtSize)

    // STATUS
    table.cell(
         dash, 1, 8,
         statusText,
         text_color=statusColor,
         bgcolor=headerBg,
         text_size=txtSize)

    // LIVE / CLOSED
    table.cell(
         dash, 2, 8,
         marketOpen ? "LIVE" : "CLOSED",
         text_color=marketOpen ? color.lime : color.red,
         bgcolor=headerBg,
         text_size=txtSize)

    // PRO
    table.cell(
         dash, 3, 8,
         "PRO",
         text_color=color.aqua,
         bgcolor=headerBg,
         text_size=txtSize)