//@version=6
indicator("TY's MA disparity for mean reversion strategy", shorttitle="TY MA Disparity", overlay=false)

// ── Inputs ──────────────────────────────────────────────
maTypeInput   = input.string("SMA", "MA Type", options=["SMA", "EMA"], group="Moving Average Settings")
maLengthInput = input.int(200, "MA Length", minval=1, group="Moving Average Settings")

showSquared   = input.bool(false, "Show Squared Disparity", group="Display Options")
keepSign      = input.bool(true, "Preserve Sign on Squared Value (Up/Down)", group="Display Options")

upperBand = input.float(10, "Upper Limit (%)", group="Limit Settings")
lowerBand = input.float(-10, "Lower Limit (%)", group="Limit Settings")

// ── Calculations ──────────────────────────────────────────
ma = maTypeInput == "SMA" ? ta.sma(close, maLengthInput) : ta.ema(close, maLengthInput)

// Disparity between close and MA (%)
disparity = (close - ma) / ma * 100

// Squared disparity (optional): if keepSign=true, preserves direction (up/down)
disparitySq = keepSign ? math.sign(disparity) * math.pow(disparity, 2) : math.pow(disparity, 2)

// ── Plots (line chart) ─────────────────────────────────────
disparityColor = disparity >= 0 ? color.new(color.red, 0) : color.new(color.blue, 0)

disparityPlot = plot(disparity, title="Disparity (%)", color=disparityColor, linewidth=2, style=plot.style_line)
plot(showSquared ? disparitySq : na, title="Squared Disparity", color=color.new(color.orange, 0), linewidth=2, style=plot.style_line)

centerPlot = plot(0, title="Center Line", color=color.new(color.gray, 40), linewidth=1, style=plot.style_line)
upperPlot  = plot(upperBand, title="Upper Limit", color=color.new(color.red, 30), linewidth=1, style=plot.style_line)
lowerPlot  = plot(lowerBand, title="Lower Limit", color=color.new(color.blue, 30), linewidth=1, style=plot.style_line)

// ── Shade zones beyond limits ──────────────────────────────
fill(disparityPlot, upperPlot, color = disparity > upperBand ? color.new(color.red, 70) : na, title="Above Upper Limit")
fill(disparityPlot, lowerPlot, color = disparity < lowerBand ? color.new(color.blue, 70) : na, title="Below Lower Limit")