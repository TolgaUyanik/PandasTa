export const string BOSS_THEME_NAME   = "Signature Cyan–Violet"
export const string BOSS_AUTHOR       = "TheStopLossBoss"
// NOTE: input options must be static in indicators; keep a CSV here for docs.
export const string BOSS_MA_LIST_CSV  = "SMA,EMA,WMA,HMA,LSMA,SMMA,WWMA,DEMA,TEMA,T3,ALMA,KAMA,VWMA,VWEMA,FRAMA,Laguerre,McGinley,McNicholl,Leader"