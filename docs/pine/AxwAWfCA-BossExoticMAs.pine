// 📖 Description
// A high-performance Pine v6 library that bundles:
// 1) Boss signature visual system (Cyan → Violet gradient)
// 2) Classic + exotic moving averages (DEMA, TEMA, T3, FRAMA, Laguerre, McGinley, Non-Lag, Butterworth, Super Smoother, etc.)
// 3) Adaptive/dynamic variants (AMA, KAMA, FRAMA, McNicholl, Leader EMA)
// 4) DSP-style filters (Ehlers high-pass/super-smoother, decycler)
// Influences / thanks: andre_007, hapharmonic, John Ehlers, loxx, blackquant.
//──────────────────────────────────────


//@version=6
library("BossExoticMAs")

//──────────────────────────────────────────────────────────────────────────────
// 🧩 Utilities
//──────────────────────────────────────────────────────────────────────────────

export nzf(float x, float y) => na(x) ? y : x
export clamp(float x, float lo, float hi) => x < lo ? lo : x > hi ? hi : x
export normalize01(float x, float lo, float hi) =>
    lo == hi ? 0.5 : clamp((x - lo) / (hi - lo), 0.0, 1.0)
export slope(float src) => src - nzf(src[1], src)
export slopeTicks(float src) => (src - nzf(src[1], src)) / syminfo.mintick

//──────────────────────────────────────────────────────────────────────────────
// 🎨 Boss Gradient Engine (Signature Cyan → Violet Fade)
//──────────────────────────────────────────────────────────────────────────────

var color BOSS_BULL = #21F9FF  // electric cyan
var color BOSS_BEAR = #5900FF  // royal violet

export bossGradient(bool isBull, int layerIndex, int totalLayers) =>
    li        = math.max(layerIndex, 0)
    tl        = math.max(totalLayers, 1)
    alphaStep = 80.0 / tl
    alpha     = 10.0 + li * alphaStep
    baseColor = isBull ? BOSS_BULL : BOSS_BEAR
    color.new(baseColor, 100 - alpha)

//──────────────────────────────────────────────────────────────────────────────
// ⚙️ Core Moving Averages
//──────────────────────────────────────────────────────────────────────────────

export sma(float src, int length) => ta.sma(src, math.max(length, 1))
export ema(float src, int length) => ta.ema(src, math.max(length, 1))
export wma(float src, int length) => ta.wma(src, math.max(length, 1))
export hma(float src, int length) => ta.hma(src, math.max(length, 1))
export lsma(float src, int length) => ta.linreg(src, math.max(length, 1), 0)
export smma(float src, int length) => ta.rma(src, math.max(length, 1))
export wwma(float src, int length) => ta.rma(src, math.max(length, 1))

// Double Exponential
export dema(float src, int length) =>
    l  = math.max(length, 1)
    e1 = ta.ema(src, l)
    e2 = ta.ema(e1, l)
    2.0 * e1 - e2

// Triple Exponential
export tema(float src, int length) =>
    l  = math.max(length, 1)
    e1 = ta.ema(src, l)
    e2 = ta.ema(e1, l)
    e3 = ta.ema(e2, l)
    3.0 * e1 - 3.0 * e2 + e3

// Tillson T3
export t3(float src, int length, float factor) =>
    l  = math.max(length, 1)
    a  = clamp(factor, 0.0, 1.0)
    e1 = ta.ema(src, l)
    e2 = ta.ema(e1, l)
    e3 = ta.ema(e2, l)
    e4 = ta.ema(e3, l)
    e5 = ta.ema(e4, l)
    e6 = ta.ema(e5, l)
    // CHANGED: use the canonical coefficients order
    c1 = -a * a * a
    c2 = 3 * a * a + 3 * a * a * a
    c3 = -6 * a * a - 3 * a - 3 * a * a * a
    c4 = 1 + 3 * a + 3 * a * a + a * a * a
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

// ALMA
export alma(float src, int length, float offset, float sigma) =>
    l = math.max(length, 1)
    m = offset * (l - 1)
    s = l / sigma
    norm = 0.0
    sum  = 0.0
    for i = 0 to l - 1
        w = math.exp(-((i - m) * (i - m)) / (2 * s * s))
        norm += w
        sum  += src[i] * w
    sum / norm

// KAMA (manual volatility to avoid ta.sum)
export kama(float src, int length, float fastEnd, float slowEnd) =>
    l = math.max(length, 1)
    fast = 2.0 / (math.max(fastEnd, 1.0) + 1.0)
    slow = 2.0 / (math.max(slowEnd, 1.0) + 1.0)
    momentum = math.abs(src - nzf(src[l], src))
    // CHANGED: manual volatility loop (replaces ta.sum of absolute changes)
    volatility = 0.0
    for i = 0 to l - 1
        prev = nzf(src[i + 1], src[i])
        volatility += math.abs(src[i] - prev)
    er = volatility != 0 ? momentum / volatility : 0.0
    sc = math.pow(er * (fast - slow) + slow, 2.0)
    var float out = na
    base = nzf(out[1], src)
    out := base + sc * (src - base)
    out

export vwma(float src, int length) => ta.vwma(src, math.max(length, 1))
export vwema(float src, int length) =>
    l = math.max(length, 1)
    p = ta.ema(volume * src, l)
    v = ta.ema(volume, l)
    p / math.max(v, 1.0)

// AMA (range-adaptive)
export ama(float src, int length, int fastLength, int slowLength) =>
    flout = 2.0 / (math.max(fastLength, 1) + 1)
    slout = 2.0 / (math.max(slowLength, 1) + 1)
    hh = ta.highest(high, length + 1)
    ll = ta.lowest(low,  length + 1)
    mltp = hh - ll != 0 ? math.abs(2.0 * src - ll - hh) / (hh - ll) : 0.0
    ssc = mltp * (flout - slout) + slout
    var float out = na
    prev = nzf(out[1], src)
    out := prev + math.pow(ssc, 2.0) * (src - prev)
    out

// Laguerre filter (4-stage)
export laguerre(float src, float alpha) =>
    var float L0 = na
    var float L1 = na
    var float L2 = na
    var float L3 = na
    L0 := alpha * src + (1.0 - alpha) * nzf(L0[1], src)
    L1 := -(1.0 - alpha) * L0 + nzf(L0[1], L0) + (1.0 - alpha) * nzf(L1[1], L0)
    L2 := -(1.0 - alpha) * L1 + nzf(L1[1], L1) + (1.0 - alpha) * nzf(L2[1], L1)
    L3 := -(1.0 - alpha) * L2 + nzf(L2[1], L2) + (1.0 - alpha) * nzf(L3[1], L2)
    (L0 + 2.0 * L1 + 2.0 * L2 + L3) / 6.0

// McGinley
export mcginley(float src, int length) =>
    var float mg = na
    mg := na(mg[1]) ? src : mg[1] + (src - mg[1]) / (length * math.pow(src / mg[1], 4.0))
    mg

// McNicholl
export mcNicholl(float src, int length) =>
    alpha = 2.0 / (math.max(length, 1) + 1.0)
    ema1  = ta.ema(src, length)
    ema2  = ta.ema(ema1, length)
    ((2.0 - alpha) * ema1 - ema2) / (1.0 - alpha)

// Leader EMA
export leader(float src, int length) =>
    alpha = 2.0 / (math.max(length, 1) + 1.0)
    var float ldr  = na
    var float ldr2 = na
    ldr  := nzf(ldr[1], src) + alpha * (src - nzf(ldr[1], src))
    ldr2 := nzf(ldr2[1], 0.0) + alpha * (src - ldr - nzf(ldr2[1], 0.0))
    ldr + ldr2

// FRAMA (with FC/SC shaping)
export frama(float src, int length, int FC = 2, int SC = 30) =>
    l    = math.max(length, 2)
    half = math.max(int(math.round(l / 2.0)), 1)
    hh1 = ta.highest(high, l)
    ll1 = ta.lowest(low,  l)
    hh2 = ta.highest(high, half)
    ll2 = ta.lowest(low,  half)
    n1 = (hh1 - ll1) / l
    n2 = (hh2 - ll2) / half
    n3 = bar_index > half ? (ta.highest(high[half], half) - ta.lowest(low[half], half)) / half : n2
    n  = (n1 + n2) > 0 ? math.log(n1 + n2) / math.log(2.0) : 0.0
    d  = math.log(math.sqrt(l)) / math.log(2.0)
    dimen = 1.0 + (n > 0 and d > 0 ? n / d : 1.0)
    alpha = math.exp(-4.6 * (dimen - 1.0))
    alphaAdj = clamp(alpha * (FC / SC), 0.01, 1.0)
    var float out = na
    out := na(out[1]) ? src : out[1] + alphaAdj * (src - out[1])
    out

//──────────────────────────────────────────────────────────────────────────────
// 🔉 Filters (One-Euro + Ehlers 2-pole HP/SS)
//──────────────────────────────────────────────────────────────────────────────

_oneEuro_te(float cutoff) => 1.0 / (2.0 * math.pi * math.max(cutoff, 0.001))
_oneEuro_alpha(float te, float rate) => 1.0 / (1.0 + te / math.max(rate, 0.001))

export oneEuroFilter(float src, float minCutoff, float beta, float dCutoff) =>
    var float xf    = na
    var float dxf   = na
    var int   first = 0
    var float rate  = 1.0
    if barstate.isfirst
        xf    := src
        dxf   := 0.0
        first := 1
    else if first == 1
        rate  := 1000.0 / (time - time[1])
        first := 2
    else
        rate  := 1000.0 / (time - time[1])
    te    = _oneEuro_te(minCutoff)
    alpha = _oneEuro_alpha(te, rate)
    float dx = src - nzf(xf[1], src)
    dxf := alpha * dx + (1.0 - alpha) * nzf(dxf[1], dx)
    te2    = _oneEuro_te(dCutoff)
    alpha2 = _oneEuro_alpha(te2, rate)
    xf := alpha2 * src + (1.0 - alpha2) * nzf(xf[1], src) + beta * dxf
    xf

export ehlersSuperSmoother(float src, int length) =>
    l  = math.max(length, 1)
    a1 = math.exp(-1.414 * math.pi / l)
    b1 = 2.0 * a1 * math.cos(1.414 * math.pi / l)
    c2 = b1
    c3 = -a1 * a1
    c1 = 1.0 - c2 - c3
    var float filt = na
    filt := na(filt[1]) ? src : c1 * (src + nzf(src[1], src)) / 2.0 + c2 * nzf(filt[1], src) + c3 * nzf(filt[2], src)
    filt

export ehlersHighPass(float src, int length) =>
    l = math.max(length, 1)
    alpha1 = (math.cos(0.707 * 2.0 * math.pi / l) + math.sin(0.707 * 2.0 * math.pi / l) - 1.0) / math.cos(0.707 * 2.0 * math.pi / l)
    var float hp = na
    hp := na(hp[1]) ? 0.0 :
         math.pow(1.0 - alpha1 / 2.0, 2.0) * (src - 2.0 * nzf(src[1], src) + nzf(src[2], src))
         + 2.0 * (1.0 - alpha1) * nzf(hp[1], 0.0) - math.pow(1.0 - alpha1, 2.0) * nzf(hp[2], 0.0)
    hp

//──────────────────────────────────────────────────────────────────────────────
// 📊 Multi-MA helpers
//──────────────────────────────────────────────────────────────────────────────

export maSelect(float src, int length, string kind, float opt1 = 0.7, float opt2 = 6.0) =>
    // NOTE: options are handled in the indicator; this selector maps names to functions.
    result = switch kind
        "SMA"        => sma(src, length)
        "EMA"        => ema(src, length)
        "WMA"        => wma(src, length)
        "HMA"        => hma(src, length)
        "LSMA"       => lsma(src, length)
        "SMMA"       => smma(src, length)
        "WWMA"       => wwma(src, length)
        "DEMA"       => dema(src, length)
        "TEMA"       => tema(src, length)
        "T3"         => t3(src, length, opt1)
        "ALMA"       => alma(src, length, 0.85, opt2)   // opt2 used as sigma
        "KAMA"       => kama(src, length, 2.0, 30.0)
        "VWMA"       => vwma(src, length)
        "VWEMA"      => vwema(src, length)
        "FRAMA"      => frama(src, length)
        "Laguerre"   => laguerre(src, opt1)            // opt1 used as alpha
        "McGinley"   => mcginley(src, length)
        "McNicholl"  => mcNicholl(src, length)
        "Leader"     => leader(src, length)
        => ema(src, length)
    result

//──────────────────────────────────────────────────────────────────────────────
// 🎯 Trend & Momentum
//──────────────────────────────────────────────────────────────────────────────

export bossTrend(float ma1, float ma2, float ma3) =>
    upTrend = ma1 > ma2 and ma2 > ma3
    dnTrend = ma1 < ma2 and ma2 < ma3
    [upTrend, dnTrend]

export momentumScore(float src, int lookback) =>
    l   = math.max(lookback, 1)
    ref = nzf(src[l], src)
    mom = (src / ref - 1.0) * 100.0
    clamp(mom, -100.0, 100.0)

