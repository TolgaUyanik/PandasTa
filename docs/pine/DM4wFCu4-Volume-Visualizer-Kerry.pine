//@version=5
indicator("Volume Visualizer", overlay=false)

// --- INPUTS ---
// Use the same settings as the main script for consistency
volume_ma_length = input.int(30, title="Volume MA Length", minval=1)
volume_multiplier = input.float(0.5, title="Volume Multiplier", minval=0.1)

// --- CALCULATIONS ---
avg_volume = ta.sma(volume, volume_ma_length)
is_significant_volume = volume < avg_volume * volume_multiplier

// --- VISUALIZE VOLUME ---
volume_color = is_significant_volume ? color.new(#FFD700, 40) : color.new(color.gray, 60)
plot(volume, "Volume", color=volume_color, style=plot.style_columns)
plot(avg_volume, "Average Volume", color=color.new(color.orange, 0), linewidth=2)