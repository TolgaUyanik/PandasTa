//@version=6
indicator("Futures Trade Entry Indicator (MTF)", overlay=true, max_boxes_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUT SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════

// Display Controls
show_supply_zones = input.bool(true, "Show Supply Zones", group="Display Controls")
show_demand_zones = input.bool(true, "Show Demand Zones", group="Display Controls")
show_fvgs = input.bool(true, "Show Fair Value Gaps", group="Display Controls")
show_labels = input.bool(true, "Show Entry/Confirmation/Exit Labels", group="Display Controls")
show_probability = input.bool(true, "Show Probability Labels", group="Display Controls")

// Zone Settings
zone_lookback = input.int(20, "Zone Detection Lookback", minval=5, maxval=50, group="Zone Settings")
zone_strength = input.int(3, "Minimum Zone Touches", minval=1, maxval=10, group="Zone Settings")
zone_expire_hours = input.int(24, "Zone Expiry (Hours)", minval=1, maxval=168, group="Zone Settings")

// Alert Settings
enable_alerts = input.bool(true, "Enable Alerts", group="Alert Settings")

// Colors
supply_color = input.color(color.new(color.red, 80), "Supply Zone Color", group="Colors")
demand_color = input.color(color.new(color.green, 80), "Demand Zone Color", group="Colors")
fvg_bull_color = input.color(color.new(color.blue, 80), "Bullish FVG Color", group="Colors")
fvg_bear_color = input.color(color.new(color.orange, 80), "Bearish FVG Color", group="Colors")

// ═══════════════════════════════════════════════════════════════════════════════
// MULTI-TIMEFRAME DATA
// ═══════════════════════════════════════════════════════════════════════════════

// Get 1H data for zone detection
h1_high = request.security(syminfo.tickerid, "60", high, lookahead=barmerge.lookahead_off)
h1_low = request.security(syminfo.tickerid, "60", low, lookahead=barmerge.lookahead_off)
h1_close = request.security(syminfo.tickerid, "60", close, lookahead=barmerge.lookahead_off)
h1_open = request.security(syminfo.tickerid, "60", open, lookahead=barmerge.lookahead_off)
h1_volume = request.security(syminfo.tickerid, "60", volume, lookahead=barmerge.lookahead_off)

// Current timeframe (should be 15m for active trading)
current_high = high
current_low = low
current_close = close
current_open = open

// ═══════════════════════════════════════════════════════════════════════════════
// ZONE DETECTION FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Function to detect supply zones (resistance levels)
detect_supply_zone() =>
    var float supply_top = na
    var float supply_bottom = na
    var int supply_time = na
    var int supply_touches = 0
    
    // Look for pivot highs
    pivot_high = ta.pivothigh(h1_high, zone_lookback, zone_lookback)
    
    if not na(pivot_high)
        supply_top := pivot_high + (pivot_high * 0.001) // Small buffer
        supply_bottom := pivot_high - (pivot_high * 0.002)
        supply_time := time[zone_lookback]
        supply_touches := 1
    
    // Count touches
    if not na(supply_top) and not na(supply_bottom)
        if h1_high >= supply_bottom and h1_high <= supply_top
            supply_touches += 1
    
    [supply_top, supply_bottom, supply_time, supply_touches]

// Function to detect demand zones (support levels)
detect_demand_zone() =>
    var float demand_top = na
    var float demand_bottom = na
    var int demand_time = na
    var int demand_touches = 0
    
    // Look for pivot lows
    pivot_low = ta.pivotlow(h1_low, zone_lookback, zone_lookback)
    
    if not na(pivot_low)
        demand_bottom := pivot_low - (pivot_low * 0.001) // Small buffer
        demand_top := pivot_low + (pivot_low * 0.002)
        demand_time := time[zone_lookback]
        demand_touches := 1
    
    // Count touches
    if not na(demand_top) and not na(demand_bottom)
        if h1_low >= demand_bottom and h1_low <= demand_top
            demand_touches += 1
    
    [demand_top, demand_bottom, demand_time, demand_touches]

// Function to detect Fair Value Gaps
detect_fvg() =>
    var float fvg_top = na
    var float fvg_bottom = na
    var bool is_bullish_fvg = false
    var int fvg_time = na
    
    // Bullish FVG: Gap between high[2] and low[0]
    bullish_fvg = h1_low > h1_high[2]
    
    // Bearish FVG: Gap between low[2] and high[0]  
    bearish_fvg = h1_high < h1_low[2]
    
    if bullish_fvg
        fvg_bottom := h1_high[2]
        fvg_top := h1_low
        is_bullish_fvg := true
        fvg_time := time
    else if bearish_fvg
        fvg_top := h1_low[2]
        fvg_bottom := h1_high
        is_bullish_fvg := false
        fvg_time := time
    
    [fvg_top, fvg_bottom, is_bullish_fvg, fvg_time]

// ═══════════════════════════════════════════════════════════════════════════════
// MARKET STRUCTURE & PATTERNS
// ═══════════════════════════════════════════════════════════════════════════════

// Function to detect engulfing patterns
detect_engulfing() =>
    bullish_engulfing = current_close > current_open and current_close[1] < current_open[1] and 
                       current_open < current_close[1] and current_close > current_open[1]
    
    bearish_engulfing = current_close < current_open and current_close[1] > current_open[1] and 
                       current_open > current_close[1] and current_close < current_open[1]
    
    [bullish_engulfing, bearish_engulfing]

// Function to detect market structure shift
detect_structure_shift() =>
    // Get recent swing highs and lows
    swing_high = ta.pivothigh(current_high, 5, 5)
    swing_low = ta.pivotlow(current_low, 5, 5)
    
    var float last_swing_high = na
    var float last_swing_low = na
    
    if not na(swing_high)
        last_swing_high := swing_high
    if not na(swing_low)
        last_swing_low := swing_low
    
    // Detect shifts
    bullish_shift = not na(last_swing_low) and current_low > last_swing_low and 
                   current_high > nz(last_swing_high, 0)
    
    bearish_shift = not na(last_swing_high) and current_high < last_swing_high and 
                   current_low < nz(last_swing_low, 999999)
    
    [bullish_shift, bearish_shift]

// ═══════════════════════════════════════════════════════════════════════════════
// PROBABILITY CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

calculate_probability(zone_age, touches, distance_ratio) =>
    age_score = zone_age < 12 ? 40 : zone_age < 24 ? 25 : 10  // Recency (out of 40)
    touch_score = math.min(touches * 10, 30)  // Strength (out of 30)
    distance_score = distance_ratio > 3 ? 30 : distance_ratio > 1.5 ? 20 : 10  // Risk/Reward (out of 30)
    
    total_score = age_score + touch_score + distance_score
    
    prob_level = total_score >= 70 ? "High" : total_score >= 40 ? "Medium" : "Low"
    prob_color = total_score >= 70 ? color.green : total_score >= 40 ? color.yellow : color.red
    
    [prob_level, prob_color]

// ═══════════════════════════════════════════════════════════════════════════════
// MAIN LOGIC EXECUTION
// ═══════════════════════════════════════════════════════════════════════════════

// Get zone data
[supply_top, supply_bottom, supply_time, supply_touches] = detect_supply_zone()
[demand_top, demand_bottom, demand_time, demand_touches] = detect_demand_zone()
[fvg_top, fvg_bottom, is_bullish_fvg, fvg_time] = detect_fvg()

// Get pattern data
[bullish_engulfing, bearish_engulfing] = detect_engulfing()
[bullish_shift, bearish_shift] = detect_structure_shift()

// Check for entries
in_supply_zone = not na(supply_top) and current_high >= supply_bottom and current_high <= supply_top
in_demand_zone = not na(demand_top) and current_low >= demand_bottom and current_low <= demand_top
in_bullish_fvg = not na(fvg_top) and is_bullish_fvg and current_low <= fvg_top and current_high >= fvg_bottom
in_bearish_fvg = not na(fvg_top) and not is_bullish_fvg and current_high >= fvg_bottom and current_low <= fvg_top

// Entry conditions
long_entry = (in_demand_zone or in_bullish_fvg) and bullish_engulfing and bullish_shift
short_entry = (in_supply_zone or in_bearish_fvg) and bearish_engulfing and bearish_shift

// Calculate probabilities
string long_prob_level = na
color long_prob_color = na
string short_prob_level = na
color short_prob_color = na

if long_entry
    zone_age_hours = (time - nz(demand_time, fvg_time)) / (1000 * 60 * 60)
    touches = in_demand_zone ? demand_touches : 1
    tp_distance = nz(supply_top, current_high * 1.02) - current_close
    sl_distance = current_close - nz(demand_bottom, current_low * 0.98)
    distance_ratio = tp_distance / sl_distance
    [long_prob_level, long_prob_color] = calculate_probability(zone_age_hours, touches, distance_ratio)

if short_entry
    zone_age_hours = (time - nz(supply_time, fvg_time)) / (1000 * 60 * 60)
    touches = in_supply_zone ? supply_touches : 1
    tp_distance = current_close - nz(demand_bottom, current_low * 0.98)
    sl_distance = nz(supply_top, current_high * 1.02) - current_close
    distance_ratio = tp_distance / sl_distance
    [short_prob_level, short_prob_color] = calculate_probability(zone_age_hours, touches, distance_ratio)

// ═══════════════════════════════════════════════════════════════════════════════
// PLOTTING
// ═══════════════════════════════════════════════════════════════════════════════

// Plot zones as boxes
var box supply_box = na
var box demand_box = na
var box fvg_box = na

// Supply zones
if show_supply_zones and not na(supply_top) and not na(supply_bottom) and supply_touches >= zone_strength
    if not na(supply_box)
        box.delete(supply_box)
    expire_time = supply_time + (zone_expire_hours * 60 * 60 * 1000)
    if time <= expire_time
        supply_box := box.new(bar_index - zone_lookback, supply_bottom, bar_index + 20, supply_top, 
                             border_color=color.red, bgcolor=supply_color, 
                             text="Supply Zone", text_color=color.white)

// Demand zones  
if show_demand_zones and not na(demand_top) and not na(demand_bottom) and demand_touches >= zone_strength
    if not na(demand_box)
        box.delete(demand_box)
    expire_time = demand_time + (zone_expire_hours * 60 * 60 * 1000)
    if time <= expire_time
        demand_box := box.new(bar_index - zone_lookback, demand_bottom, bar_index + 20, demand_top, 
                             border_color=color.green, bgcolor=demand_color, 
                             text="Demand Zone", text_color=color.white)

// FVG boxes
if show_fvgs and not na(fvg_top) and not na(fvg_bottom)
    if not na(fvg_box)
        box.delete(fvg_box)
    expire_time = fvg_time + (zone_expire_hours * 60 * 60 * 1000)
    if time <= expire_time
        fvg_color = is_bullish_fvg ? fvg_bull_color : fvg_bear_color
        fvg_border = is_bullish_fvg ? color.blue : color.orange
        fvg_text = is_bullish_fvg ? "Bullish FVG" : "Bearish FVG"
        fvg_box := box.new(bar_index - 2, fvg_bottom, bar_index + 10, fvg_top, 
                          border_color=fvg_border, bgcolor=fvg_color, 
                          text=fvg_text, text_color=color.white)

// Plot entry/exit labels
if show_labels
    if long_entry
        label.new(bar_index, low, "🟩 LONG", style=label.style_label_up, 
                 color=color.green, textcolor=color.white, size=size.normal)
    
    if short_entry
        label.new(bar_index, high, "🟥 SHORT", style=label.style_label_down, 
                 color=color.red, textcolor=color.white, size=size.normal)

// Plot probability labels
if show_probability
    if long_entry and not na(long_prob_level)
        label.new(bar_index, low - (high - low) * 0.1, long_prob_level, 
                 style=label.style_label_up, color=long_prob_color, 
                 textcolor=color.white, size=size.small)
    
    if short_entry and not na(short_prob_level)
        label.new(bar_index, high + (high - low) * 0.1, short_prob_level, 
                 style=label.style_label_down, color=short_prob_color, 
                 textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

if enable_alerts
    if long_entry
        alert("🟢 LONG Entry Signal - " + syminfo.ticker + " | Probability: " + str.tostring(long_prob_level), alert.freq_once_per_bar)
    
    if short_entry
        alert("🔴 SHORT Entry Signal - " + syminfo.ticker + " | Probability: " + str.tostring(short_prob_level), alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════════════════════════
// BACKGROUND HIGHLIGHTING (Optional)
// ═══════════════════════════════════════════════════════════════════════════════

// Highlight bars with entry signals
bgcolor(long_entry ? color.new(color.green, 95) : short_entry ? color.new(color.red, 95) : na, title="Entry Signal Background")

// Plot confirmation signals
plotshape(bullish_engulfing and bullish_shift, style=shape.triangleup, location=location.belowbar, 
          color=color.blue, size=size.small, title="Bullish Confirmation")
plotshape(bearish_engulfing and bearish_shift, style=shape.triangledown, location=location.abovebar, 
          color=color.purple, size=size.small, title="Bearish Confirmation")