// ── HEADER ───────────────────────────────────────────────────────────────────
// @version=6
//
// @description   This library provides a unified interface for calculating a
//                wide variety of moving averages. It is designed to simplify
//                indicator development by consolidating numerous MA calculations
//                into a single function and integrating the weighting
//                capabilities from the `LibWght` library.
//
//                Key Features:
//
//                1.  **All-in-One MA Function:** The core of the library is the
//                    `ma()` function. Users can select the desired calculation
//                    method via the `MAType` enum, which helps create
//                    cleaner and more maintainable code compared to using
//                    many different `ta.*` or custom functions.
//
//                2.  **Comprehensive Selection of MA Types:** It provides a
//                    selection of 12 different moving averages, covering
//                    common Pine Script built-ins and their weighted counterparts:
//                    - **Standard MAs:** SMA, EMA, WMA, RMA (Wilder's), HMA (Hull), and
//                      LSMA (Least Squares / Linear Regression).
//                    - **Weighted MAs:** Weight-enhanced versions of the above
//                      (WSMA, WEMA, WWMA, WRMA, WHMA, WLSMA).
//
//                3.  **Integrated Weighting:** The library provides weighted versions
//                    for each of its standard MA types (e.g., `wsma` alongside `sma`).
//                    By acting as a dispatcher, the `ma()` function allows these
//                    weighted calculations to be called using the optional
//                    `weight` parameter, which are then processed by the `LibWght`
//                    library.
//
//                4.  **Safety & Robustness:** The library automatically validates
//                    input parameters. Specifically, the look-back `length` is
//                    internally clamped to a minimum of 1. This prevents runtime
//                    errors if a dynamic length calculation accidentally results
//                    in 0 or negative values.
//
//                ---
//
//                **DISCLAIMER**
//
//                This library is provided "AS IS" and for informational and
//                educational purposes only. It does not constitute financial,
//                investment, or trading advice.
//
//                The author assumes no liability for any errors, inaccuracies,
//                or omissions in the code. Using this library to build
//                trading indicators or strategies is entirely at your own risk.
//
//                As a developer using this library, you are solely responsible
//                for the rigorous testing, validation, and performance of any
//                scripts you create based on these functions. The author shall
//                not be held liable for any financial losses incurred directly
//                or indirectly from the use of this library or any scripts
//                derived from it.
library(
  title   = "LibMvAv")

// ── LOG ──────────────────────────────────────────────────────────────────────
// 2026-01-25 0.2.0
// (Mod) Safety: Added input validation for the `length` parameter.
// (Mod) Update of the `LibWght` library
//
// 2025-11-01 0.1.0
// (New) Initial release of library

// ── CONTROL ──────────────────────────────────────────────────────────────────
const string NAME    = "LibMvAv"
const string VERSION = "0.2.0"
const string STATUS  = "rel"        // "rel", "dev", "dep"

if barstate.isfirst
    switch STATUS
        "rel" => log.info("Library '" + NAME + " " + VERSION + "' released")
        "dev" => log.warning("Library '" + NAME + " " + VERSION + "' in development")
        "dep" => log.error("Library '" + NAME + " " + VERSION + "' deprecated!")
        => runtime.error("Undefined status of library " + NAME + " " + VERSION)

// ── IMPORTS ──────────────────────────────────────────────────────────────────
import AustrianTradingMachine/LibWght/2 as LibWght

// ── ENUM ─────────────────────────────────────────────────────────────────────
// @enum  MAType Moving-average type selector
// @field sma    Simple Moving Average
// @field ema    Exponential Moving Average
// @field wma    Weighted Moving Average
// @field rma    Rolling Moving Average
// @field hma    Hull Moving Average
// @field lsma   Least Square Moving Average
// @field wsma   Weighted Simple Moving Average
// @field wema   Weighted Exponential Moving Average
// @field wwma   Weighted Weighted Moving Average
// @field wrma   Weighted Rolling Moving Average
// @field whma   Weighted Hull Moving Average
// @field wlsma  Weighted Least Square Moving Average
export enum MAType
    sma   = "Simple Moving Average"
    ema   = "Exponential Moving Average"
    wma   = "Weighted Moving Average"
    rma   = "Rolling Moving Average"
    hma   = "Hull Moving Average"
    lsma  = "Least Square Moving Average"
    wsma  = "Weighted Simple Moving Average"
    wema  = "Weighted Exponential Moving Average"
    wwma  = "Weighted Weighted Moving Average"
    wrma  = "Weighted Rolling Moving Average"
    whma  = "Weighted Hull Moving Average"
    wlsma = "Weighted Least Square Moving Average"

// ── PUBLIC ───────────────────────────────────────────────────────────────────
// @function Returns the requested moving average.
// @param    maType    simple MAType Desired type (see enum above).
// @param    source    series float  Data series to smooth.
// @param    length    simple int    Look-back / period length. Automatically clamped to min. 1.
// @param    weight    series float  Weight series (default = na). Only used for weighted types.
// @returns            series float  Moving-average value.
export ma(
  simple MAType maType,
  series float source,
  simple int length,
  series float weight = na
  ) =>
    simple int len = math.max(1, length)

    switch maType
        MAType.sma   => ta.sma(source, len)
        MAType.ema   => ta.ema(source, len)
        MAType.wma   => ta.wma(source, len)
        MAType.rma   => ta.rma(source, len)
        MAType.hma   => ta.hma(source, len)
        MAType.lsma  => ta.linreg(source, len, 0)
        MAType.wsma  => LibWght.wSma(source, weight, len)
        MAType.wema  => LibWght.wEma(source, weight, len)
        MAType.wwma  => LibWght.wWma(source, weight, len)
        MAType.wrma  => LibWght.wRma(source, weight, len)
        MAType.whma  => LibWght.wHma(source, weight, len)
        MAType.wlsma => LibWght.wLSma(source, weight, len)
        => runtime.error("MAType type not found"), na