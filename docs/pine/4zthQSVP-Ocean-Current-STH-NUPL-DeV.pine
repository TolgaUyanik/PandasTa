// 
//@version=6

// ------------------- ©DeVrizii -------------------

indicator("Ocean Current / STH-NUPL | [DeV]", precision=2)

int lookbackPeriod       = input.int(150, "Realized Value Lookback Length", minval=1, group="STH-NUPL Settings")
int smoothingPeriod      = input.int(5, "Smoothing Period", minval=1, group="STH-NUPL Settings")
int maLength             = input.int(90, "MA Lookback Length", group="Moving Average Settings")
string maType            = input.string("EMA", title="MA Type", options=["SMA", "EMA", "HMA", "WMA", "RMA", "VWMA"], group="Moving Average Settings")
bool showMA              = input.bool(true, "Show Moving Average?", group="Display Settings")
bool showBackground      = input.bool(true, "Show Background Color?", group="Display Settings")
int bgTransparency       = input.int(90, "Background Transparency", minval=0, maxval=100, group="Display Settings")
bool showZeroCross       = input.bool(true, "Show SMA-150 (Price) Cross Markers?", group="Cross Signals")
bool showMACross         = input.bool(true, "Show MA Cross Markers?", group="Cross Signals")

calculateMA(float source, int period, string maType) =>
    float result = switch maType
        "SMA"    => ta.sma(source, period)
        "EMA"    => ta.ema(source, period)
        "HMA"    => ta.hma(source, period)
        "WMA"    => ta.wma(source, period)
        "RMA"    => ta.rma(source, period)
        "VWMA"   => ta.vwma(source, period)
    result

float marketValue    = close
float realizedValue  = ta.sma(close, lookbackPeriod)
float unrealizedPL   = marketValue - realizedValue
float rawSthNupl     = unrealizedPL / marketValue
float sthNupl        = ta.ema(rawSthNupl, smoothingPeriod)
float maNupl         = calculateMA(sthNupl, maLength, maType)

color colorBullish     = #aaa11a
color colorBearish     = #991717
color colorNupl        = color.gray
color colorMA          = maNupl > maNupl[2] ? color.new(colorBullish, 40) : color.new(colorBearish, 40)
color colorMidline     = sthNupl > 0 ? colorBullish : colorBearish
color colorBackground  = color.gray

// Soft, uniform grey background so the indicator doesn't fight the chart for attention
bgcolor(showBackground ? color.new(colorBackground, bgTransparency) : na)

plot(sthNupl, color=colorNupl, title="STH-NUPL", linewidth=1)
plot(maNupl, color=colorMA, title="STH-NUPL MA", display=showMA ? display.all : display.none, linewidth=1)
plot(0, color=colorMidline, title="Midline", linewidth=1)
plot(sthNupl, title="STH-NUPL Trend", style=plot.style_linebr, linewidth=3, color=sthNupl > 0 ? colorBullish : colorBearish)

// ------------------- Cross Signals -------------------

// "Zero line" cross = price (close) crossing the SMA-150 realized value line,
// which is exactly the moment unrealizedPL flips sign (i.e. rawSthNupl crosses 0)
bool zeroCrossUp   = ta.crossover(marketValue, realizedValue)
bool zeroCrossDown = ta.crossunder(marketValue, realizedValue)
bool maCrossUp     = ta.crossover(sthNupl, maNupl)
bool maCrossDown   = ta.crossunder(sthNupl, maNupl)

// force_overlay places these markers on the main price chart (with the candles)
// even though the STH-NUPL line itself stays in its own pane
plotshape(showZeroCross and zeroCrossUp, title="SMA-150 Cross Up", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.tiny, force_overlay=true)
plotshape(showZeroCross and zeroCrossDown, title="SMA-150 Cross Down", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, force_overlay=true)

plotshape(showMACross and maCrossUp, title="MA Cross Up", style=shape.circle, location=location.belowbar, color=color.green, size=size.tiny, force_overlay=true)
plotshape(showMACross and maCrossDown, title="MA Cross Down", style=shape.xcross, location=location.abovebar, color=color.red, size=size.tiny, force_overlay=true)

// ------------------- Fortitudine Vincimus -------------------