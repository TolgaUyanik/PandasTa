//@version=5
indicator("Momentum Candle Projection", overlay=true)

// === Settings
lookback = input.int(5, minval=2, title="Vector Lookback (bars)")
projection_length = input.float(5.0, title="Projection Length Multiplier")

// === Custom atan2 for Pine
atan2_pine(y, x) =>
    x > 0 ? math.atan(y / x) :    x < 0 and y >= 0 ? math.atan(y / x) + math.pi :    x < 0 and y < 0 ? math.atan(y / x) - math.pi :    x == 0 and y > 0 ? math.pi / 2 :    x == 0 and y < 0 ? -math.pi / 2 :    0

// === Calculate cumulative vector from price changes
real = 0.0
imag = 0.0
for i = 1 to lookback
    dx = i
    dy = close - close[i]
    angle = atan2_pine(dy, dx)
    mag = math.sqrt(dy*dy + dx*dx)
    real += mag * math.cos(angle)
    imag += mag * math.sin(angle)

avg_real = real / lookback
avg_imag = imag / lookback

// === Projected Price
projected_price = close + (avg_imag * projection_length)

// === Synthetic Candle #1: From current close to projected price
proj_open  = close
proj_close = ta.sma(projected_price, 5)
proj_high  = math.max(proj_open, proj_close)
proj_low   = math.min(proj_open, proj_close)

// === Synthetic Candle #2: Mimic real price (future placeholder, optional)
future_open  = ta.sma(projected_price, 5)
future_close = close
future_high  = math.max(future_open, future_close)
future_low   = math.min(future_open, future_close)

// === Plot projection candle one bar ahead
plotcandle(proj_open, proj_high, proj_low, proj_close, title="Projection Candle", color=(proj_close > proj_open ? color.lime : color.red))

// === Plot real follow-up candle two bars ahead (simulated)
plotcandle(future_open, future_high, future_low, future_close, title="Future Price Candle", color=(future_open > open ? color.orange : color.maroon))
