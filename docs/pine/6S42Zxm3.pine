//@version=5
library("M20M60_win10_lib", overlay=false)

// 自動生成: 元ファイル m20m60_win10_filters_cluster1_5.pine からロジック部のみを抽出
// indicator()/input()/plot() などのデバッグ・表示用コードは含めていません。

export f_m20m60_win10_features(series float srcOpen, series float srcHigh, series float srcLow, series float srcClose, series float bandCenter, series float bandWidth) =>
    float fullRange = 0.0
    float bodySum   = 0.0
    float upperSum  = 0.0
    float lowerSum  = 0.0
    float inBandCnt = 0.0
    float maxAbove  = 0.0
    for i = 0 to 9
        float hi = srcHigh[i]
        float lo = srcLow[i]
        float op = srcOpen[i]
        float cl = srcClose[i]
        float r  = hi - lo
        fullRange += r
        float body = math.abs(cl - op)
        float upW  = cl >= op ? hi - cl : hi - op
        float loW  = cl >= op ? op - lo : cl - lo
        bodySum  += body
        upperSum += upW
        lowerSum += loW
        float bc  = bandCenter[i]
        float bw  = bandWidth[i]
        float top = bc + bw * 0.5
        float bot = bc - bw * 0.5
        bool inside = lo >= bot and hi <= top
        inBandCnt += inside ? 1.0 : 0.0
        maxAbove := math.max(maxAbove, hi - top)
    float rangeMean = fullRange / 10.0
    float bodyMean  = bodySum   / 10.0
    float insideRatio = inBandCnt / 10.0
    float bandCenterNow = bandCenter[0]
    float cMean = 0.0
    for i = 0 to 9
        cMean += srcClose[i]
    cMean /= 10.0
    float cBandDiff = cMean - bandCenterNow
    [bodyMean, rangeMean, cBandDiff, insideRatio, maxAbove]


export f_m20m60_win10_is_cluster5(float bodyMean, float rangeMean, float cBandDiff, float insideRatio, float maxAbove) =>
    bool condBody  = bodyMean  >= 12.084405
    bool condRange = rangeMean >= 21.016358
    bool condCBand = cBandDiff >= 53.999454
    bool condInside = insideRatio <= 0.114531
    bool condOver  = maxAbove  >= 70.748580
    condBody and condRange and condCBand and condInside and condOver


export f_m20m60_win10_is_cluster1(float bodyMean, float rangeMean, float cBandDiff, float insideRatio, float maxAbove) =>
    bool condBody  = bodyMean  >= 5.816060 and bodyMean  < 12.084405
    bool condRange = rangeMean >= 11.687373 and rangeMean < 21.016358
    bool condCBand = cBandDiff >= 21.952990 and cBandDiff < 53.999454
    bool condInside = insideRatio >= 0.114531 and insideRatio <= 0.149664
    bool condOver  = maxAbove  >= 17.621215 and maxAbove  < 70.748580
    condBody and condRange and condCBand and condInside and condOver

