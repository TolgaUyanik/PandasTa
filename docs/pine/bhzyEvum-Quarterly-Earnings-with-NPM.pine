//@version=5
indicator('Quarterly Earnings with NPM', overlay=true)

// ================= Table and UI Inputs =================
string GRP1 = "════════ Modes ═════════"
toggleDarkColors = input(title="Dark Mode", defval=false, group = GRP1)
toggleMiniMode = input(title="Mini Mode", defval=false, group = GRP1)
datasize = input.int(4, 'Long Mode ?', minval = 4, inline='line 3', group=GRP1) +5

string GRP2 = "════════ Table Options ═════════"
string tablesize = input.string("small",  "Size",      inline = "21", group = GRP2, options = ["tiny", "small", "normal", "large", "huge", "auto"])
string tableposY = input.string("bottom", "↕",         inline = "21", group = GRP2, options = ["top", "middle", "bottom"])
string tableposX = input.string("right",   "↔",         inline = "21", group = GRP2, options = ["left", "center", "right"])

string GRP3 = "════════ Inputs ═════════"
per = input.string('FQ', 'Period', options=['FQ', 'FY'], inline='line 3', group=GRP3)
topleft = input.string('FF','Top-left cell displays', group = GRP3, options = ['FF', 'Mcap'])

// ================= Theme Colors =================
FrameCol = toggleDarkColors ? color.new(#999999, 50) : color.rgb(241, 241, 241)
BorderCol = FrameCol
TextColor = toggleDarkColors ? color.white : color.black
BGColor = toggleDarkColors ? color.new(color.white, 100): color.new(color.black, 100)
HeadColor = BGColor
BodyColor = BGColor
UpColor = toggleDarkColors ? color.lime : color.rgb(31, 12, 239)
DownColor = toggleDarkColors ? color.red : color.rgb(213, 27, 182)
UnchangedColor = toggleDarkColors ? color.yellow : color.orange

// ================= Financial IDs =================
financial01 = 'EPS'
financial02 = 'Sales'
financial03 = 'Net Profit Margin' // 🆕 Added label

financial01id = 'EARNINGS_PER_SHARE_DILUTED'
financial02id = 'TOTAL_REVENUE'
financial03id = 'NET_INCOME' // 🆕 Added Net Income ID

// ================= Financial Data Fetching =================
getFinFQ(_id, _per) => 
    _f = request.financial(syminfo.tickerid, _id, _per, barmerge.gaps_on, ignore_invalid_symbol = true)
    if _id == financial02id 
        _f := math.round(_f / 10.0, 2)
    _f

f_array(arrayId, val) =>
    array.unshift(arrayId, val)
    array.pop(arrayId)

get_finx(finID) =>
    switch finID
        'Sales' => financial02id
        'EPS' => financial01id
        'Net Profit Margin' => financial03id

// ================= Raw Financials =================
rev = request.financial(syminfo.tickerid, financial02id, per, barmerge.gaps_on, ignore_invalid_symbol=true)
epsData = getFinFQ(financial01id, per)
salesData = getFinFQ(financial02id, per)
netIncomeData = getFinFQ(financial03id, per) // 🆕 Net Income

// ================= Arrays =================
var date = array.new_int(datasize)
var arrayEPS = array.new_float(datasize)
var arraySales = array.new_float(datasize)
var arrayNPM = array.new_float(datasize) // 🆕 NPM array

// ================= Computations =================
if rev
    f_array(date, time)
    f_array(arrayEPS, epsData)
    f_array(arraySales, salesData)
    npm = (salesData != 0) ? (netIncomeData / salesData) * 100 : na // 🆕 Compute NPM
    f_array(arrayNPM, npm)

// ================= Helper Functions =================
ft(_table, _column, _row, _value) => 
    table.cell(_table, _column, _row, _value, bgcolor = HeadColor, text_color = TextColor, text_size = tablesize)

ftdate(_table, _column, _row, _value) =>
    _val = str.contains(_value, "70") ? "" : _value
    table.cell(_table, _column, _row, _val, bgcolor = BodyColor, text_color = TextColor, text_size = tablesize, text_halign = text.align_left)

fcell(finID, _table, _column, _row, _value, _i) =>
    divider = finID == 'EPS' ? 1 : finID == 'Sales' ? 1000000 : 1
    suffix = finID == 'EPS' ? '' : finID == 'Sales' ? ' M' : '%'
    strFormat = finID == 'EPS' ? '#.#' : finID == 'Sales' ? '#,###.#' : '#.#'
    val = array.get(_value, _i) / divider
    table.cell(_table, _column, _row, na(val) ? "" : str.tostring(val, strFormat) + suffix, text_color = TextColor, text_size = tablesize)

fyoy(_table, _column, _row, _value, _i, _cmpr) =>
    val1 = array.get(_value, _i)
    val2 = array.get(_value, _i + _cmpr)
    val1 := val1 == 0 ? 1 : val1
    val2 := math.round(val2, 1) == 0 ? 0.1 : val2
    dif = ((val1 - val2) / math.abs(val2)) * 100
    sym = na(dif) ? "●" : toggleMiniMode ? "●" : (dif > 0 ? '+' : '') + str.tostring(math.round(dif)) + '%'
    color = na(dif) ? FrameCol : dif > 0 ? UpColor : dif < 0 ? DownColor : UnchangedColor
    table.cell(_table, _column, _row, sym, text_color = color, text_halign = text.align_right, text_size = tablesize)

// ================= Market Cap / FF =================
free_float = nz(request.financial(syminfo.tickerid, 'FLOAT_SHARES_OUTSTANDING', 'FY'))
ff = na(ta.vwap) ? free_float / 10000000 : free_float * ta.vwap / 10000000
validated_ff = na(ff) or ff == 0 ? '' : str.tostring(math.round(ff)) + ' Cr'

outstanding = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ")
mc = outstanding * close / 10000000
validated_mc = na(mc) or mc == 0 ? '' : str.tostring(math.round(mc)) + ' Cr'

// ================= Table Construction =================
var table t = table.new(tableposY + "_" + tableposX, columns = 9, rows = datasize, bgcolor = BGColor, frame_color=FrameCol, frame_width=1, border_color=BorderCol, border_width=1)

if barstate.islast and not toggleMiniMode
    ft(t, 0, 0, topleft == 'FF' ? validated_ff : validated_mc)
    ft(t, 1, 0, "EPS")
    ft(t, 2, 0, per == 'FY' ? 'YoY' : '%Chg')
    ft(t, 3, 0, "Sales")
    ft(t, 4, 0, per == 'FY' ? 'YoY' : '%Chg')
    ft(t, 5, 0, "NPM") // 🆕 Net Profit Margin
    ft(t, 6, 0, per == 'FY' ? 'YoY' : '%Chg')

if barstate.islast
    for i = 0 to datasize - 5
        ftdate(t, 0, i + 1, str.format('{0, date, MMM-yy}', array.get(date, i)))

        if not toggleMiniMode
            fcell('EPS', t, 1, i + 1, arrayEPS, i)
            fyoy(t, 2, i + 1, arrayEPS, i, per == 'FY' ? 1 : 4)
            fcell('Sales', t, 3, i + 1, arraySales, i)
            fyoy(t, 4, i + 1, arraySales, i, per == 'FY' ? 1 : 4)
            fcell('Net Profit Margin', t, 5, i + 1, arrayNPM, i)
            fyoy(t, 6, i + 1, arrayNPM, i, per == 'FY' ? 1 : 4)

        else
            fyoy(t, 2, i + 1, arrayEPS, i, per == 'FY' ? 1 : 4)
            fyoy(t, 4, i + 1, arraySales, i, per == 'FY' ? 1 : 4)
            fyoy(t, 6, i + 1, arrayNPM, i, per == 'FY' ? 1 : 4)
