//@version=6
indicator("Beta calculator", overlay=false)
sym = input(defval = "VTI"), length = input.int(100, minval=1)
benchmark = request.security(sym, "D", math.log(close))
asset = math.log(close)
asset_return = asset - asset[1]
benchmark_return = benchmark - benchmark[1]
beta = ta.correlation(asset_return, benchmark_return, length)
plot(beta, title="Beta vs VTI", color=color.rgb(33, 149, 243, 60), style = plot.style_area)
