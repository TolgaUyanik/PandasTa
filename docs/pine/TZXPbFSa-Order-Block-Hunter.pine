//@version=6
// ════════════════════════════════════════════════════════════════════
//  ORDER BLOCK HUNTER 2.0 — validated 2026-07-22, FVG version (replaces near-high)
//  Weekly-only. Matches us_wyckoff_scan.py's Order Block detection exactly.
//
//  DEFINITION: the last down-close week, followed by a week whose range is
//  more than 1.5x that down week's range AND closes above the down week's
//  high, CONFIRMED the following week by BOTH: (a) price higher than the
//  breakout week's close, AND (b) that week's low stays above the down
//  week's high -- a true, unfilled Fair Value Gap (real displacement, not
//  just a big range). NO proximity-to-high requirement.
//
//  HISTORY: the original 67.4%/+18.2% number measured forward return from
//  the DOWN week's close, not the breakout week's close -- a look-ahead
//  bug. Honest entry-at-breakout-close baseline was only ~55% win / +7%
//  mean. A near-high + confirmation version reached 64.4% but required
//  entering close to all-time highs, which many traders find uncomfortable
//  (chasing, no overhead resistance). This FVG-based version instead
//  requires genuine structural displacement -- reaches 63.9% win per-
//  ticker-weighted holdout (n=1284, 392 tickers, tested on essentially the
//  full US common-stock universe) with NO distance-from-high requirement
//  at all. This is a TWO-STAGE signal: raw detection fires, confirmed and
//  shown only the following week if both conditions above hold.
//
//  Intentionally a SEPARATE, simpler indicator from Wyckoff Accumulation
//  Hunter -- different logic, different validated basis.
// ════════════════════════════════════════════════════════════════════
indicator("Order Block Hunter", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

isWeekly = timeframe.isweekly

// ───────────── INPUTS ─────────────
minRangeMultiple = input.float(1.5, "Min breakout range vs down-week range", minval = 1.0, step = 0.1,
     tooltip = "The breakout week's range must be at least this many times the prior down week's range. 1.5 is the validated threshold.")
minDollarVol     = input.float(5.0, "GATE: min avg $ vol (M/wk)", minval = 0, step = 1,
     tooltip = "Liquidity floor, same convention as the Wyckoff scanner.")
showExitLadder   = input.bool(true, "Show validated reference targets (median/mean @ 52w)")
showEMAs         = input.bool(true, "Show 21/55 week EMA lines")
cooldownBars     = input.int(4, "Signal cooldown (weeks)", minval = 0,
     tooltip = "Minimum weeks between repeated alerts on the same ticker.")
showHistory      = input.bool(false, "Show historical signals (not just most recent)",
     tooltip = "OFF (default): only the most recent signal is shown, old ones disappear when a new one fires. ON: all past signals stay on the chart.")

// Tested 5 EMA periods (10/20/30/50/100w) against Order Block's win rate --
// NONE showed a meaningful split (all within 0.9-2.2 points, essentially
// noise). These are shown for basic visual trend context only, not because
// they predict anything.
emaFast = ta.ema(close, 21)
emaSlow = ta.ema(close, 55)
plot(showEMAs ? emaFast : na, "21w EMA", color = color.new(color.red, 55), linewidth = 1)
plot(showEMAs ? emaSlow : na, "55w EMA", color = #722F37, linewidth = 1)

// ───────────── CORE DETECTION (matches Python exactly) ─────────────
prevDown   = close[1] < open[1]
prevRange  = high[1] - low[1]
lastRange  = high - low
breakout   = prevDown and prevRange > 0 and lastRange > minRangeMultiple * prevRange and close > high[1]

dollarVolM = close * volume / 5.0 / 1e6
avgDolVolM = ta.sma(dollarVolM, 12)
liquidityOK = avgDolVolM >= minDollarVol

var int lastSigBar = -9999
cooldownOK = bar_index - lastSigBar >= cooldownBars
orderBlockRaw = isWeekly and breakout and liquidityOK and barstate.isconfirmed and cooldownOK
if orderBlockRaw
    lastSigBar := bar_index

// ── TWO-STAGE CONFIRMATION ──────────────────────────────────────────────
// Raw detection parks the signal; only confirmed (and shown) the FOLLOWING
// week if price closes higher than the breakout week's close.
var bool  pendingOB = false
var float pendingPrice = na
var float pendingZoneLow = na
var float pendingZoneHigh = na
var int   pendingBar = na

orderBlock = false
float confirmedZoneLow = na
float confirmedZoneHigh = na
int confirmedBar = na

if pendingOB and barstate.isconfirmed
    if close > pendingPrice
        // sanity check: reject if the zone level is wildly divergent from
        // current price (more than 10x or less than 0.1x) -- almost
        // certainly a data glitch (seen on some crypto feeds with erratic
        // historical bars), not a genuine signal.
        zoneReasonable = pendingZoneLow > close * 0.1 and pendingZoneLow < close * 10
        // true FVG: this confirmation week's low must stay ABOVE the down
        // week's high (pendingZoneHigh) -- the gap stays unfilled, real
        // displacement, not just a big range. This replaces the near-high
        // filter entirely.
        trueFVG = low > pendingZoneHigh
        if zoneReasonable and trueFVG
            orderBlock := true
            confirmedZoneLow := pendingZoneLow
            confirmedZoneHigh := pendingZoneHigh
            confirmedBar := pendingBar
    pendingOB := false

if orderBlockRaw
    pendingOB := true
    pendingPrice := close
    pendingZoneLow := low[1]
    pendingZoneHigh := high[1]
    pendingBar := bar_index

// context, informational only (validated: works in BOTH, doesn't gate)

// ───────────── DISPLAY: entry marker, zone, invalidation, targets ─────────────
// All drawn at the moment each signal fires (not retroactively on the last
// bar only) so the showHistory toggle can work: when OFF, the previous set
// of drawings is deleted before the new one is created (only the most
// recent signal ever visible). When ON, nothing is deleted -- every past
// signal's drawings stay on the chart permanently.
var label liveArrow = na
var box   zoneBox = na
var line  invalLine = na
var label invalLabel = na
var line  medianLine = na
var line  meanLine = na
var label medianLabel = na
var label meanLabel = na

// Tested 2026-07-22: a 0% buffer (exactly at zone low) stopped out 63.3% of
// eventual WINNING trades prematurely -- far too tight, catching ordinary
// wicks/liquidity grabs. 15% below cuts that false-stop rate to 12.0% (20%
// gets to 7.3%, but with diminishing returns past 15%). 15% chosen as the
// best balance.
invalBufferPct = input.float(15.0, "Invalidation buffer below zone low (%)", minval = 0, maxval = 30, step = 1,
     tooltip = "Tested: 0%=63.3% false-stop rate on winners, 10%=20.2%, 15%=12.0%, 20%=7.3%. 15% is the tested sweet spot.")

if orderBlock and not na(confirmedZoneLow) and not na(confirmedZoneHigh) and not na(confirmedBar)
    if not showHistory
        label.delete(liveArrow)
        box.delete(zoneBox)
        line.delete(invalLine)
        label.delete(invalLabel)
        line.delete(medianLine)
        line.delete(meanLine)
        label.delete(medianLabel)
        label.delete(meanLabel)

    entryRange = high - low
    yPos = low - entryRange * 0.15

    // arrow marks the ACTUAL entry point -- the confirmation week (this bar),
    // since that's when you'd genuinely know to act on it
    liveArrow := label.new(bar_index, yPos, "▲",
         style = label.style_label_up, yloc = yloc.price,
         color = color.new(#D4AF37, 100), textcolor = color.new(#D4AF37, 0), size = size.normal)

    // zone box marks where the ORIGINAL pattern occurred (one week earlier)
    zoneBox := box.new(confirmedBar - 1, confirmedZoneHigh, confirmedBar + 5, confirmedZoneLow,
         border_color = color.new(color.red, 55), border_width = 1,
         bgcolor = color.new(color.white, 90))

    invalLvl = confirmedZoneLow * (1 - invalBufferPct / 100)
    invalLine  := line.new(confirmedBar - 1, invalLvl, bar_index + 20, invalLvl,
         color = #722F37, width = 2, style = line.style_solid)
    invalLabel := label.new(bar_index + 20, invalLvl, "invalidation (-" + str.tostring(invalBufferPct, "#") + "%)",
         style = label.style_label_left, color = color.new(color.black, 100),
         textcolor = #722F37, size = size.small)

    // ── reference target levels (52w hold, tested 2026-07-22) ──────────────
    // Tested 5 exit strategies against full weekly price paths on all 9243
    // Order Block signals: a pure 52-week hold beat scaling out at +12% on
    // captured return (mean +29.8% vs +13.1% holdout), even though win% is a
    // bit lower (67.5% vs 77.0%) -- the old +12% target was cutting real
    // winners short. Targets computed from the ACTUAL entry price (this
    // confirmation week's close), not the original breakout week's.
    if showExitLadder
        medianTgt = close * 1.185
        meanTgt   = close * 1.298
        medianLine  := line.new(bar_index, medianTgt, bar_index + 52, medianTgt, color = color.new(color.red, 55), width = 1, style = line.style_dotted)
        meanLine    := line.new(bar_index, meanTgt, bar_index + 52, meanTgt, color = color.new(color.red, 55), width = 2, style = line.style_dashed)
        medianLabel := label.new(bar_index + 52, medianTgt, "target 1",
             style = label.style_label_left, color = color.new(color.black, 100),
             textcolor = color.new(color.red, 40), size = size.small)
        meanLabel   := label.new(bar_index + 52, meanTgt, "target 2",
             style = label.style_label_left, color = color.new(color.black, 100),
             textcolor = color.new(color.red, 0), size = size.small)

// ── keep everything extended to the current bar as time passes ─────────────
// Without this, all the drawn objects would stay fixed at their original
// (short) length from the signal bar, appearing to "fall behind" the
// current price as more bars form -- this is what fixes that.
if barstate.isconfirmed
    if not na(zoneBox)
        box.set_right(zoneBox, bar_index + 5)
    if not na(invalLine)
        line.set_x2(invalLine, bar_index + 20)
        label.set_x(invalLabel, bar_index + 20)
    if showExitLadder and not na(medianLine)
        line.set_x2(medianLine, bar_index + 52)
        line.set_x2(meanLine, bar_index + 52)
        label.set_x(medianLabel, bar_index + 52)
        label.set_x(meanLabel, bar_index + 52)


// ───────────── ALERTS ─────────────
alertcondition(orderBlock, "Order Block Hunter — ENTRY",
     "Order Block on {{ticker}} | {{close}} — validated 63.9% win holdout (per-ticker), FVG + confirmed.")