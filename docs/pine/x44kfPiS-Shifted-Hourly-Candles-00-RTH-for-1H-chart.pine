//@version=6
indicator("Shifted Hourly Candles :00 (RTH, for 1H chart)", overlay = true)

upCol     = input.color(#00ff06, "Up body",   inline = "c1")
dnCol     = input.color(#ff0000, "Down body", inline = "c1")
wickCol   = input.color(#ffffff, "Wicks",     inline = "c2")
borderCol = input.color(#000000, "Border",    inline = "c2")
ltf       = input.timeframe("5", "Intrabar timeframe", options = ["1", "5", "15"])

// Pull the lower-timeframe bars hidden inside each chart bar
[aT, aO, aH, aL, aC] = request.security_lower_tf(syminfo.tickerid, ltf, [time, open, high, low, close])

// Running bucket state (persists across chart bars, since a clock-hour
// candle spans parts of two 1H chart bars)
var float bO = na
var float bH = na
var float bL = na
var float prevC = na

// The candle that completes during THIS chart bar (if any)
float co = na
float ch = na
float cl = na
float cc = na

n = array.size(aT)
if n > 0
    for i = 0 to n - 1
        t = array.get(aT, i)
        // A new bucket starts at each top of the clock hour, or at the 09:30 open
        newBucket = minute(t) == 0 or (i == 0 and session.isfirstbar_regular)
        if newBucket and not na(bO)
            co := bO
            ch := bH
            cl := bL
            cc := prevC
            bO := na
        if na(bO)
            bO := array.get(aO, i)
            bH := array.get(aH, i)
            bL := array.get(aL, i)
        else
            bH := math.max(bH, array.get(aH, i))
            bL := math.min(bL, array.get(aL, i))
        prevC := array.get(aC, i)
    // The last bucket of the day has no following top-of-hour bar, close it at session end
    if session.islastbar_regular and not na(bO)
        co := bO
        ch := bH
        cl := bL
        cc := prevC
        bO := na

// Show the completed candle; on the live bar, show the forming bucket instead
bool done = not na(co)
bool live = barstate.islast and not na(bO)
float po = done ? co : live ? bO : na
float ph = done ? ch : live ? bH : na
float pl = done ? cl : live ? bL : na
float pc = done ? cc : live ? prevC : na

plotcandle(po, ph, pl, pc, "Shifted hourly",
     color = pc >= po ? upCol : dnCol,
     wickcolor = wickCol,
     bordercolor = borderCol)