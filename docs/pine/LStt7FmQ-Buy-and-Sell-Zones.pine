//@version=6
indicator(
     "Buy and Sell Zones",
     shorttitle = "Zones",
     overlay = true,
     max_boxes_count = 500
)

//=====================================================================
// INPUT GROUPS
//=====================================================================

const string GROUP_PUSH         = "1. Push Detection"
const string GROUP_ORIGIN       = "2. Zone Candle"
const string GROUP_SIZE         = "3. Zone Size"
const string GROUP_CONFIRMATION = "4. Retest and Validation"
const string GROUP_INVALIDATION = "5. Invalidation"
const string GROUP_DISPLAY      = "6. Display"

//=====================================================================
// PUSH DETECTION
//=====================================================================

int atrLength = input.int(
     14,
     "ATR Length",
     minval = 1,
     group = GROUP_PUSH
)

int breakoutLookback = input.int(
     5,
     "Breakout Lookback",
     minval = 1,
     tooltip = "The push must break the previous structure from this number of candles.",
     group = GROUP_PUSH
)

int pushWindow = input.int(
     5,
     "Push Measurement Window",
     minval = 1,
     group = GROUP_PUSH
)

float minimumPushATR = input.float(
     1.0,
     "Minimum Push Size in ATR",
     minval = 0.1,
     step = 0.1,
     group = GROUP_PUSH
)

//=====================================================================
// ZONE CANDLE SETTINGS
//=====================================================================

int maximumPushCandles = input.int(
     5,
     "Maximum Push Candles to Search",
     minval = 1,
     maxval = 20,
     group = GROUP_ORIGIN
)

string buyCandleSelection = input.string(
     "Automatic",
     "Buy Zone Candle",
     options = [
         "Automatic",
         "Red Candle Before Push",
         "First Green Push Candle"
     ],
     tooltip = "Automatic uses the red candle before the bullish push. If unavailable, it uses the first green push candle.",
     group = GROUP_ORIGIN
)

int sellMergeMaxBars = input.int(
     20,
     "Sell Zone Merge Distance",
     minval = 1,
     maxval = 200,
     tooltip = "Overlapping potential sell zones merge only when their green origin candles are within this many bars.",
     group = GROUP_ORIGIN
)

int maximumZonesPerSide = input.int(
     100,
     "Maximum Zones Per Side",
     minval = 1,
     maxval = 250,
     tooltip = "TradingView supports a maximum of 500 boxes for this indicator.",
     group = GROUP_ORIGIN
)

//=====================================================================
// ZONE SIZE
//=====================================================================

float minimumZonePips = input.float(
     40.0,
     "Minimum Zone Candle Size in Pips",
     minval = 1.0,
     step = 1.0,
     tooltip = "The selected candle must be at least this many pips from high to low. Smaller candles are ignored.",
     group = GROUP_SIZE
)

string pipCalculation = input.string(
     "Automatic",
     "Pip Size Calculation",
     options = [
         "Automatic",
         "Broker Tick Size",
         "Custom"
     ],
     group = GROUP_SIZE
)

float customPipSize = input.float(
     0.01,
     "Custom Pip Size",
     minval = 0.00000001,
     step = 0.00001,
     tooltip = "XAUUSD commonly uses 0.01. EURUSD commonly uses 0.0001.",
     group = GROUP_SIZE
)

//=====================================================================
// RETEST AND VALIDATION
//=====================================================================

float departureATR = input.float(
     0.10,
     "Minimum Departure in ATR",
     minval = 0.0,
     step = 0.05,
     tooltip = "Price must move away from the zone by this distance before returning.",
     group = GROUP_CONFIRMATION
)

int minimumRetestDelay = input.int(
     1,
     "Minimum Candles Before Retest",
     minval = 1,
     group = GROUP_CONFIRMATION
)

float reactionATR = input.float(
     0.10,
     "Validation Reaction Size in ATR",
     minval = 0.0,
     step = 0.05,
     group = GROUP_CONFIRMATION
)

int reactionTimeLimit = input.int(
     3,
     "Reaction Time Limit",
     minval = 1,
     maxval = 20,
     tooltip = "Maximum candles allowed between touching a zone and validating it.",
     group = GROUP_CONFIRMATION
)

//=====================================================================
// INVALIDATION
//=====================================================================

string invalidationMethod = input.string(
     "Candle Close Outside Zone",
     "Invalidation Method",
     options = [
         "Candle Close Outside Zone",
         "Wick Outside Zone"
     ],
     group = GROUP_INVALIDATION
)

bool deleteInvalidZones = input.bool(
     false,
     "Delete Invalidated Zones",
     tooltip = "When disabled, invalidated zones remain as transparent grey boxes.",
     group = GROUP_INVALIDATION
)

//=====================================================================
// DISPLAY DISTANCE
//=====================================================================

string zoneDistanceSetting = input.string(
     "500",
     "Zone Display Distance",
     options = [
         "100",
         "300",
         "500",
         "700",
         "1000",
         "Unlimited"
     ],
     group = GROUP_DISPLAY
)

bool unlimitedZoneDistance =
     zoneDistanceSetting == "Unlimited"

int zoneDisplayBars = 500

if zoneDistanceSetting == "100"
    zoneDisplayBars := 100
else if zoneDistanceSetting == "300"
    zoneDisplayBars := 300
else if zoneDistanceSetting == "500"
    zoneDisplayBars := 500
else if zoneDistanceSetting == "700"
    zoneDisplayBars := 700
else if zoneDistanceSetting == "1000"
    zoneDisplayBars := 1000
else
    zoneDisplayBars := 0

bool showPotentialZones = input.bool(
     true,
     "Show Potential Zones",
     group = GROUP_DISPLAY
)

bool showZoneLabels = input.bool(
     true,
     "Show Zone Labels",
     group = GROUP_DISPLAY
)

bool showValidationMarkers = input.bool(
     true,
     "Show Validation Markers",
     group = GROUP_DISPLAY
)

//=====================================================================
// BUY COLORS
//=====================================================================

color buyPotentialFill = input.color(
     color.new(color.green, 85),
     "Potential Buy Fill",
     group = GROUP_DISPLAY
)

color buyPotentialBorder = input.color(
     color.new(color.green, 25),
     "Potential Buy Border",
     group = GROUP_DISPLAY
)

color buyValidatedFill = input.color(
     color.new(color.blue, 85),
     "Validated Buy Fill",
     group = GROUP_DISPLAY
)

color buyValidatedBorder = input.color(
     color.new(color.blue, 25),
     "Validated Buy Border",
     group = GROUP_DISPLAY
)

//=====================================================================
// SELL COLORS
//=====================================================================

color sellPotentialFill = input.color(
     color.new(color.white, 88),
     "Potential Sell Fill",
     group = GROUP_DISPLAY
)

color sellPotentialBorder = input.color(
     color.new(color.white, 25),
     "Potential Sell Border",
     group = GROUP_DISPLAY
)

color sellValidatedFill = input.color(
     color.new(color.red, 85),
     "Validated Sell Fill",
     group = GROUP_DISPLAY
)

color sellValidatedBorder = input.color(
     color.new(color.red, 25),
     "Validated Sell Border",
     group = GROUP_DISPLAY
)

//=====================================================================
// INVALIDATED COLORS
//=====================================================================

color invalidFill = input.color(
     color.new(color.gray, 88),
     "Invalidated Zone Fill",
     group = GROUP_DISPLAY
)

color invalidBorder = input.color(
     color.new(color.gray, 40),
     "Invalidated Zone Border",
     group = GROUP_DISPLAY
)

//=====================================================================
// PIP AND PUSH CALCULATIONS
//=====================================================================

float automaticPipSize =
     syminfo.type == "forex" ?
     (syminfo.mintick >= 0.01 ?
         syminfo.mintick :
         syminfo.mintick * 10.0) :
     syminfo.mintick

float pipSize = automaticPipSize

if pipCalculation == "Broker Tick Size"
    pipSize := syminfo.mintick
else if pipCalculation == "Custom"
    pipSize := customPipSize

float minimumZoneHeight =
     minimumZonePips * pipSize

float atrValue =
     ta.atr(atrLength)

float previousStructureHigh =
     ta.highest(high[1], breakoutLookback)

float previousStructureLow =
     ta.lowest(low[1], breakoutLookback)

float recentPushLow =
     ta.lowest(low, pushWindow)

float recentPushHigh =
     ta.highest(high, pushWindow)

bool bullishCandle =
     close > open

bool bearishCandle =
     close < open

bool bullishBreakout =
     close > previousStructureHigh

bool bearishBreakout =
     close < previousStructureLow

bool sufficientBullishPush =
     close - recentPushLow >=
     atrValue * minimumPushATR

bool sufficientBearishPush =
     recentPushHigh - close >=
     atrValue * minimumPushATR

bool enoughHistory =
     bar_index >
     math.max(
         breakoutLookback + 1,
         maximumPushCandles + 2
     )

bool bullishPushDetected =
     barstate.isconfirmed and
     enoughHistory and
     bullishCandle and
     bullishBreakout and
     sufficientBullishPush

bool bearishPushDetected =
     barstate.isconfirmed and
     enoughHistory and
     bearishCandle and
     bearishBreakout and
     sufficientBearishPush

//=====================================================================
// BUY ZONE ARRAYS
//=====================================================================

var array<box> buyBoxes =
     array.new<box>()

var array<float> buyTops =
     array.new<float>()

var array<float> buyBottoms =
     array.new<float>()

var array<int> buyOriginBars =
     array.new<int>()

var array<int> buyCreationBars =
     array.new<int>()

var array<bool> buyDeparted =
     array.new<bool>()

var array<bool> buyTouched =
     array.new<bool>()

var array<int> buyTouchBars =
     array.new<int>()

var array<bool> buyValidated =
     array.new<bool>()

var array<bool> buyInvalidated =
     array.new<bool>()

//=====================================================================
// SELL ZONE ARRAYS
//=====================================================================

var array<box> sellBoxes =
     array.new<box>()

var array<float> sellTops =
     array.new<float>()

var array<float> sellBottoms =
     array.new<float>()

var array<int> sellOriginBars =
     array.new<int>()

var array<int> sellCreationBars =
     array.new<int>()

var array<bool> sellDeparted =
     array.new<bool>()

var array<bool> sellTouched =
     array.new<bool>()

var array<int> sellTouchBars =
     array.new<int>()

var array<bool> sellValidated =
     array.new<bool>()

var array<bool> sellInvalidated =
     array.new<bool>()

var int lastBuyOriginBar = na
var int lastSellOriginBar = na

var bool canCreateBuyZone = true
var bool canCreateSellZone = true

//=====================================================================
// EVENTS
//=====================================================================

bool newPotentialBuyZone = false
bool newValidatedBuyZone = false
bool newInvalidatedBuyZone = false

bool newPotentialSellZone = false
bool newValidatedSellZone = false
bool newInvalidatedSellZone = false

//=====================================================================
// BUY REMOVAL FUNCTIONS
//=====================================================================

f_removeOldestBuyZone() =>
    if array.size(buyBoxes) > 0
        box oldestBox =
             array.shift(buyBoxes)

        box.delete(oldestBox)

        array.shift(buyTops)
        array.shift(buyBottoms)
        array.shift(buyOriginBars)
        array.shift(buyCreationBars)
        array.shift(buyDeparted)
        array.shift(buyTouched)
        array.shift(buyTouchBars)
        array.shift(buyValidated)
        array.shift(buyInvalidated)

    0

f_removeBuyZoneAt(int index, bool deleteObject) =>
    box selectedBox =
         array.get(buyBoxes, index)

    if deleteObject
        box.delete(selectedBox)

    array.remove(buyBoxes, index)
    array.remove(buyTops, index)
    array.remove(buyBottoms, index)
    array.remove(buyOriginBars, index)
    array.remove(buyCreationBars, index)
    array.remove(buyDeparted, index)
    array.remove(buyTouched, index)
    array.remove(buyTouchBars, index)
    array.remove(buyValidated, index)
    array.remove(buyInvalidated, index)

    0

//=====================================================================
// SELL REMOVAL FUNCTIONS
//=====================================================================

f_removeOldestSellZone() =>
    if array.size(sellBoxes) > 0
        box oldestBox =
             array.shift(sellBoxes)

        box.delete(oldestBox)

        array.shift(sellTops)
        array.shift(sellBottoms)
        array.shift(sellOriginBars)
        array.shift(sellCreationBars)
        array.shift(sellDeparted)
        array.shift(sellTouched)
        array.shift(sellTouchBars)
        array.shift(sellValidated)
        array.shift(sellInvalidated)

    0

f_removeSellZoneAt(int index, bool deleteObject) =>
    box selectedBox =
         array.get(sellBoxes, index)

    if deleteObject
        box.delete(selectedBox)

    array.remove(sellBoxes, index)
    array.remove(sellTops, index)
    array.remove(sellBottoms, index)
    array.remove(sellOriginBars, index)
    array.remove(sellCreationBars, index)
    array.remove(sellDeparted, index)
    array.remove(sellTouched, index)
    array.remove(sellTouchBars, index)
    array.remove(sellValidated, index)
    array.remove(sellInvalidated, index)

    0

//=====================================================================
// RESET RULES
//=====================================================================

// A red candle permits a later buy zone.
if barstate.isconfirmed and bearishCandle
    canCreateBuyZone := true

// A green candle permits a later sell zone.
if barstate.isconfirmed and bullishCandle
    canCreateSellZone := true

//=====================================================================
// CREATE BUY ZONE
//=====================================================================

if bullishPushDetected and canCreateBuyZone

    int firstGreenOffset = 0

    for searchOffset = 0 to maximumPushCandles - 1
        if close[searchOffset] > open[searchOffset]
            firstGreenOffset := searchOffset
        else
            break

    int candleBeforePushOffset =
         firstGreenOffset + 1

    bool redCandleAvailable =
         not na(close[candleBeforePushOffset]) and
         close[candleBeforePushOffset] <
         open[candleBeforePushOffset]

    int zoneOffset =
         firstGreenOffset

    if buyCandleSelection == "Automatic"
        zoneOffset :=
             redCandleAvailable ?
             candleBeforePushOffset :
             firstGreenOffset

    else if buyCandleSelection == "Red Candle Before Push"
        zoneOffset :=
             redCandleAvailable ?
             candleBeforePushOffset :
             firstGreenOffset

    else
        zoneOffset :=
             firstGreenOffset

    int originBar =
         bar_index - zoneOffset

    float zoneTop =
         high[zoneOffset]

    float zoneBottom =
         low[zoneOffset]

    float zoneHeight =
         zoneTop - zoneBottom

    float zonePips =
         pipSize > 0 ?
         zoneHeight / pipSize :
         0.0

    bool validBuyZone =
         pipSize > 0 and
         zoneTop > zoneBottom and
         zoneHeight >= minimumZoneHeight

    bool newBuyOrigin =
         na(lastBuyOriginBar) or
         originBar != lastBuyOriginBar

    if validBuyZone and newBuyOrigin

        if array.size(buyBoxes) >= maximumZonesPerSide
            f_removeOldestBuyZone()

        color initialFill =
             showPotentialZones ?
             buyPotentialFill :
             color.new(buyPotentialFill, 100)

        color initialBorder =
             showPotentialZones ?
             buyPotentialBorder :
             color.new(buyPotentialBorder, 100)

        string initialText =
             showPotentialZones and showZoneLabels ?
             "Potential Buy Zone\n" +
             str.tostring(zonePips, "#.0") +
             " pips" :
             ""

        box newBuyBox = box.new(
             left = originBar,
             top = zoneTop,
             right = bar_index,
             bottom = zoneBottom,
             xloc = xloc.bar_index,
             extend = extend.right,
             border_color = initialBorder,
             border_width = 1,
             border_style = line.style_dashed,
             bgcolor = initialFill,
             text = initialText,
             text_color = initialBorder,
             text_size = size.tiny,
             text_halign = text.align_left,
             text_valign = text.align_center
        )

        array.push(buyBoxes, newBuyBox)
        array.push(buyTops, zoneTop)
        array.push(buyBottoms, zoneBottom)
        array.push(buyOriginBars, originBar)
        array.push(buyCreationBars, bar_index)
        array.push(buyDeparted, false)
        array.push(buyTouched, false)
        array.push(buyTouchBars, int(na))
        array.push(buyValidated, false)
        array.push(buyInvalidated, false)

        lastBuyOriginBar := originBar
        canCreateBuyZone := false
        newPotentialBuyZone := true

//=====================================================================
// CREATE SELL ZONE
//=====================================================================

if bearishPushDetected and canCreateSellZone

    // Find the beginning of the uninterrupted bearish push.
    int firstRedOffset = 0

    for searchOffset = 0 to maximumPushCandles - 1
        if close[searchOffset] < open[searchOffset]
            firstRedOffset := searchOffset
        else
            break

    // Sell zones must use the green candle immediately before the push.
    int greenOriginOffset =
         firstRedOffset + 1

    bool greenOriginAvailable =
         not na(close[greenOriginOffset]) and
         close[greenOriginOffset] >
         open[greenOriginOffset]

    if greenOriginAvailable

        int originBar =
             bar_index - greenOriginOffset

        float zoneTop =
             high[greenOriginOffset]

        float zoneBottom =
             low[greenOriginOffset]

        float zoneHeight =
             zoneTop - zoneBottom

        bool validSellZone =
             pipSize > 0 and
             zoneTop > zoneBottom and
             zoneHeight >= minimumZoneHeight

        bool newSellOrigin =
             na(lastSellOriginBar) or
             originBar != lastSellOriginBar

        if validSellZone and newSellOrigin

            float mergedTop =
                 zoneTop

            float mergedBottom =
                 zoneBottom

            int mergedOriginBar =
                 originBar

            // Merge all nearby overlapping potential sell zones.
            bool continueMerging = true

            while continueMerging

                continueMerging := false

                int mergeIndex =
                     array.size(sellBoxes) - 1

                while mergeIndex >= 0

                    bool existingValidated =
                         array.get(
                             sellValidated,
                             mergeIndex
                         )

                    bool existingInvalidated =
                         array.get(
                             sellInvalidated,
                             mergeIndex
                         )

                    bool existingPotential =
                         not existingValidated and
                         not existingInvalidated

                    float existingTop =
                         array.get(
                             sellTops,
                             mergeIndex
                         )

                    float existingBottom =
                         array.get(
                             sellBottoms,
                             mergeIndex
                         )

                    int existingOriginBar =
                         array.get(
                             sellOriginBars,
                             mergeIndex
                         )

                    bool zonesOverlap =
                         mergedBottom <= existingTop and
                         mergedTop >= existingBottom

                    bool originsAreClose =
                         math.abs(
                             originBar -
                             existingOriginBar
                         ) <= sellMergeMaxBars

                    if existingPotential and
                       zonesOverlap and
                       originsAreClose

                        mergedTop :=
                             math.max(
                                 mergedTop,
                                 existingTop
                             )

                        mergedBottom :=
                             math.min(
                                 mergedBottom,
                                 existingBottom
                             )

                        mergedOriginBar :=
                             math.min(
                                 mergedOriginBar,
                                 existingOriginBar
                             )

                        f_removeSellZoneAt(
                             mergeIndex,
                             true
                        )

                        continueMerging := true

                    mergeIndex := mergeIndex - 1

            float mergedHeight =
                 mergedTop - mergedBottom

            float mergedPips =
                 pipSize > 0 ?
                 mergedHeight / pipSize :
                 0.0

            if array.size(sellBoxes) >= maximumZonesPerSide
                f_removeOldestSellZone()

            color initialFill =
                 showPotentialZones ?
                 sellPotentialFill :
                 color.new(
                     sellPotentialFill,
                     100
                 )

            color initialBorder =
                 showPotentialZones ?
                 sellPotentialBorder :
                 color.new(
                     sellPotentialBorder,
                     100
                 )

            string initialText =
                 showPotentialZones and
                 showZoneLabels ?
                 "Potential Sell Zone\n" +
                 str.tostring(
                     mergedPips,
                     "#.0"
                 ) +
                 " pips" :
                 ""

            box newSellBox = box.new(
                 left = mergedOriginBar,
                 top = mergedTop,
                 right = bar_index,
                 bottom = mergedBottom,
                 xloc = xloc.bar_index,
                 extend = extend.right,
                 border_color = initialBorder,
                 border_width = 1,
                 border_style = line.style_dashed,
                 bgcolor = initialFill,
                 text = initialText,
                 text_color = initialBorder,
                 text_size = size.tiny,
                 text_halign = text.align_left,
                 text_valign = text.align_center
            )

            array.push(
                 sellBoxes,
                 newSellBox
            )

            array.push(
                 sellTops,
                 mergedTop
            )

            array.push(
                 sellBottoms,
                 mergedBottom
            )

            array.push(
                 sellOriginBars,
                 mergedOriginBar
            )

            array.push(
                 sellCreationBars,
                 bar_index
            )

            array.push(
                 sellDeparted,
                 false
            )

            array.push(
                 sellTouched,
                 false
            )

            array.push(
                 sellTouchBars,
                 int(na)
            )

            array.push(
                 sellValidated,
                 false
            )

            array.push(
                 sellInvalidated,
                 false
            )

            lastSellOriginBar := originBar
            canCreateSellZone := false
            newPotentialSellZone := true

//=====================================================================
// MANAGE BUY ZONES
//=====================================================================

int buyIndex =
     array.size(buyBoxes) - 1

while buyIndex >= 0

    box currentBox =
         array.get(buyBoxes, buyIndex)

    float currentTop =
         array.get(buyTops, buyIndex)

    float currentBottom =
         array.get(buyBottoms, buyIndex)

    int originBar =
         array.get(buyOriginBars, buyIndex)

    int creationBar =
         array.get(buyCreationBars, buyIndex)

    bool hasDeparted =
         array.get(buyDeparted, buyIndex)

    bool hasTouched =
         array.get(buyTouched, buyIndex)

    int touchBar =
         array.get(buyTouchBars, buyIndex)

    bool isValidated =
         array.get(buyValidated, buyIndex)

    bool isInvalidated =
         array.get(buyInvalidated, buyIndex)

    bool zoneTooOld =
         not unlimitedZoneDistance and
         bar_index - originBar >
         zoneDisplayBars

    if zoneTooOld

        f_removeBuyZoneAt(
             buyIndex,
             true
        )

    else if not isInvalidated

        bool departureDetected =
             close >=
             currentTop +
             atrValue * departureATR

        if not hasDeparted and departureDetected
            hasDeparted := true

            array.set(
                 buyDeparted,
                 buyIndex,
                 true
            )

        bool invalidatedByClose =
             close < currentBottom

        bool invalidatedByWick =
             low < currentBottom

        bool zoneIsInvalid =
             invalidationMethod ==
             "Candle Close Outside Zone" ?
             invalidatedByClose :
             invalidatedByWick

        if zoneIsInvalid

            newInvalidatedBuyZone := true

            if deleteInvalidZones

                f_removeBuyZoneAt(
                     buyIndex,
                     true
                )

            else

                array.set(
                     buyInvalidated,
                     buyIndex,
                     true
                )

                box.set_extend(
                     currentBox,
                     extend.none
                )

                box.set_right(
                     currentBox,
                     bar_index
                )

                box.set_bgcolor(
                     currentBox,
                     invalidFill
                )

                box.set_border_color(
                     currentBox,
                     invalidBorder
                )

                box.set_border_style(
                     currentBox,
                     line.style_dotted
                )

                box.set_border_width(
                     currentBox,
                     1
                )

                box.set_text(
                     currentBox,
                     showZoneLabels ?
                     "Invalidated Buy Zone" :
                     ""
                )

                box.set_text_color(
                     currentBox,
                     invalidBorder
                )

        else

            bool retestAllowed =
                 hasDeparted and
                 not isValidated and
                 bar_index >=
                 creationBar +
                 minimumRetestDelay

            bool touchesZone =
                 low <= currentTop and
                 high >= currentBottom

            if retestAllowed and
               touchesZone and
               not hasTouched

                hasTouched := true
                touchBar := bar_index

                array.set(
                     buyTouched,
                     buyIndex,
                     true
                )

                array.set(
                     buyTouchBars,
                     buyIndex,
                     bar_index
                )

            bool reactionStillValid =
                 hasTouched and
                 not na(touchBar) and
                 bar_index - touchBar <=
                 reactionTimeLimit

            bool bullishReaction =
                 bullishCandle and
                 close >=
                 currentTop +
                 atrValue * reactionATR

            if not isValidated and
               reactionStillValid and
               bullishReaction

                array.set(
                     buyValidated,
                     buyIndex,
                     true
                )

                newValidatedBuyZone := true

                box.set_bgcolor(
                     currentBox,
                     buyValidatedFill
                )

                box.set_border_color(
                     currentBox,
                     buyValidatedBorder
                )

                box.set_border_style(
                     currentBox,
                     line.style_solid
                )

                box.set_border_width(
                     currentBox,
                     2
                )

                box.set_text(
                     currentBox,
                     showZoneLabels ?
                     "Validated Buy Zone" :
                     ""
                )

                box.set_text_color(
                     currentBox,
                     buyValidatedBorder
                )

            if hasTouched and
               not isValidated and
               not na(touchBar)

                if bar_index - touchBar >
                   reactionTimeLimit

                    array.set(
                         buyTouched,
                         buyIndex,
                         false
                    )

                    array.set(
                         buyTouchBars,
                         buyIndex,
                         int(na)
                    )

    buyIndex := buyIndex - 1

//=====================================================================
// MANAGE SELL ZONES
//=====================================================================

int sellIndex =
     array.size(sellBoxes) - 1

while sellIndex >= 0

    box currentBox =
         array.get(sellBoxes, sellIndex)

    float currentTop =
         array.get(sellTops, sellIndex)

    float currentBottom =
         array.get(sellBottoms, sellIndex)

    int originBar =
         array.get(sellOriginBars, sellIndex)

    int creationBar =
         array.get(sellCreationBars, sellIndex)

    bool hasDeparted =
         array.get(sellDeparted, sellIndex)

    bool hasTouched =
         array.get(sellTouched, sellIndex)

    int touchBar =
         array.get(sellTouchBars, sellIndex)

    bool isValidated =
         array.get(sellValidated, sellIndex)

    bool isInvalidated =
         array.get(sellInvalidated, sellIndex)

    bool zoneTooOld =
         not unlimitedZoneDistance and
         bar_index - originBar >
         zoneDisplayBars

    if zoneTooOld

        f_removeSellZoneAt(
             sellIndex,
             true
        )

    else if not isInvalidated

        bool departureDetected =
             close <=
             currentBottom -
             atrValue * departureATR

        if not hasDeparted and departureDetected

            hasDeparted := true

            array.set(
                 sellDeparted,
                 sellIndex,
                 true
            )

        bool invalidatedByClose =
             close > currentTop

        bool invalidatedByWick =
             high > currentTop

        bool zoneIsInvalid =
             invalidationMethod ==
             "Candle Close Outside Zone" ?
             invalidatedByClose :
             invalidatedByWick

        if zoneIsInvalid

            newInvalidatedSellZone := true

            if deleteInvalidZones

                f_removeSellZoneAt(
                     sellIndex,
                     true
                )

            else

                array.set(
                     sellInvalidated,
                     sellIndex,
                     true
                )

                box.set_extend(
                     currentBox,
                     extend.none
                )

                box.set_right(
                     currentBox,
                     bar_index
                )

                box.set_bgcolor(
                     currentBox,
                     invalidFill
                )

                box.set_border_color(
                     currentBox,
                     invalidBorder
                )

                box.set_border_style(
                     currentBox,
                     line.style_dotted
                )

                box.set_border_width(
                     currentBox,
                     1
                )

                box.set_text(
                     currentBox,
                     showZoneLabels ?
                     "Invalidated Sell Zone" :
                     ""
                )

                box.set_text_color(
                     currentBox,
                     invalidBorder
                )

        else

            bool retestAllowed =
                 hasDeparted and
                 not isValidated and
                 bar_index >=
                 creationBar +
                 minimumRetestDelay

            bool touchesZone =
                 high >= currentBottom and
                 low <= currentTop

            if retestAllowed and
               touchesZone and
               not hasTouched

                hasTouched := true
                touchBar := bar_index

                array.set(
                     sellTouched,
                     sellIndex,
                     true
                )

                array.set(
                     sellTouchBars,
                     sellIndex,
                     bar_index
                )

            bool reactionStillValid =
                 hasTouched and
                 not na(touchBar) and
                 bar_index - touchBar <=
                 reactionTimeLimit

            bool bearishReaction =
                 bearishCandle and
                 close <=
                 currentBottom -
                 atrValue * reactionATR

            if not isValidated and
               reactionStillValid and
               bearishReaction

                array.set(
                     sellValidated,
                     sellIndex,
                     true
                )

                newValidatedSellZone := true

                box.set_bgcolor(
                     currentBox,
                     sellValidatedFill
                )

                box.set_border_color(
                     currentBox,
                     sellValidatedBorder
                )

                box.set_border_style(
                     currentBox,
                     line.style_solid
                )

                box.set_border_width(
                     currentBox,
                     2
                )

                box.set_text(
                     currentBox,
                     showZoneLabels ?
                     "Validated Sell Zone" :
                     ""
                )

                box.set_text_color(
                     currentBox,
                     sellValidatedBorder
                )

            if hasTouched and
               not isValidated and
               not na(touchBar)

                if bar_index - touchBar >
                   reactionTimeLimit

                    array.set(
                         sellTouched,
                         sellIndex,
                         false
                    )

                    array.set(
                         sellTouchBars,
                         sellIndex,
                         int(na)
                    )

    sellIndex := sellIndex - 1

//=====================================================================
// VALIDATION MARKERS
//=====================================================================

plotshape(
     showValidationMarkers and newValidatedBuyZone,
     title = "Validated Buy Zone",
     style = shape.triangleup,
     location = location.belowbar,
     color = buyValidatedBorder,
     size = size.tiny,
     text = "BZ",
     textcolor = buyValidatedBorder
)

plotshape(
     showValidationMarkers and newValidatedSellZone,
     title = "Validated Sell Zone",
     style = shape.triangledown,
     location = location.abovebar,
     color = sellValidatedBorder,
     size = size.tiny,
     text = "SZ",
     textcolor = sellValidatedBorder
)

//=====================================================================
// ALERTS
//=====================================================================

alertcondition(
     newPotentialBuyZone,
     title = "Potential Buy Zone",
     message = "A potential buy zone was created on {{ticker}} {{interval}}."
)

alertcondition(
     newValidatedBuyZone,
     title = "Validated Buy Zone",
     message = "A buy zone was validated on {{ticker}} {{interval}}."
)

alertcondition(
     newInvalidatedBuyZone,
     title = "Invalidated Buy Zone",
     message = "A buy zone was invalidated on {{ticker}} {{interval}}."
)

alertcondition(
     newPotentialSellZone,
     title = "Potential Sell Zone",
     message = "A potential sell zone was created from a green candle on {{ticker}} {{interval}}."
)

alertcondition(
     newValidatedSellZone,
     title = "Validated Sell Zone",
     message = "A sell zone was validated on {{ticker}} {{interval}}."
)

alertcondition(
     newInvalidatedSellZone,
     title = "Invalidated Sell Zone",
     message = "A sell zone was invalidated on {{ticker}} {{interval}}."
)