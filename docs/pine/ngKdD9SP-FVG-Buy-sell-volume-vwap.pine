//@version=6
strategy("My strategy", overlay=true, fill_orders_on_standard_ohlc = true)

longCondition = ta.crossover(ta.sma(close, 14), ta.sma(close, 28))
if (longCondition)
    strategy.entry("My Long Entry Id", strategy.long)

shortCondition = ta.crossunder(ta.sma(close, 14), ta.sma(close, 28))
if (shortCondition)
    strategy.entry("My Short Entry Id", strategy.short)

//@version=5

// --- INPUTS ---
// Trend & Value
emaLength = input.int(200, title="EMA Length", group="Trend/Value")
// MACD
fastLength = input.int(12, title="MACD Fast Length", group="MACD")
slowLength = input.int(26, title="MACD Slow Length", group="MACD")
signalLength = input.int(9, title="MACD Signal Length", group="MACD")
// RSI
rsiLength = input.int(14, title="RSI Length", group="RSI")
// Volume
volMaLength = input.int(20, title="Volume MA Length", group="Volume")
// Risk Management
rrRatio = input.float(2.0, title="Risk-to-Reward Ratio (for TP)", group="Risk Management")
slTicks = input.int(20, title="Stop Loss Buffer (Ticks/Pips)", group="Risk Management")

// --- INDICATOR LOGIC ---
// 1. Trend (EMA & VWAP)
ema200 = ta.ema(close, emaLength)
vwapVal = ta.vwap(close)

plot(ema200, color=color.blue, title="200 EMA", linewidth=2)
plot(vwapVal, color=color.orange, title="VWAP", linewidth=1)

// 2. MACD
[macdLine, signalLine, histLine] = ta.macd(close, fastLength, slowLength, signalLength)
macdBullishCross = ta.crossover(macdLine, signalLine)
macdBearishCross = ta.crossunder(macdLine, signalLine)

// 3. RSI & Divergence Proxy
rsiVal = ta.rsi(close, rsiLength)
// Simple check for oversold/overbought momentum shifts acting as divergence proxies
rsiBullishShift = rsiVal > ta.valuewhen(macdBullishCross, rsiVal, 1) and close < ta.valuewhen(macdBullishCross, close, 1)
rsiBearishShift = rsiVal < ta.valuewhen(macdBearishCross, rsiVal, 1) and close > ta.valuewhen(macdBearishCross, close, 1)

// 4. Volume Confirmation
volMa = ta.sma(volume, volMaLength)
highVolume = volume > volMa

// 5. Order Block Proxy (High Volume Engulfing Reversals)
bullishOB = (close > open) and (close[1] < open[1]) and (close > open[1]) and highVolume
bearishOB = (close < open) and (close[1] > open[1]) and (close < open[1]) and highVolume

// Visual markers for Order Blocks
plotshape(bullishOB, title="Bullish OB Proxy", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(bearishOB, title="Bearish OB Proxy", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// --- STRATEGY CONDITIONS ---
// Bullish Context: Price above 200 EMA and Daily VWAP
bullishContext = (close > ema200) and (close > vwapVal)
// Bearish Context: Price below 200 EMA and Daily VWAP
bearishContext = (close < ema200) and (close < vwapVal)
// Trade Entries

// --- EXECUTION & RISK MANAGEMENT ---
// Persistent variables to track Stop Loss and Take Profit levels
var float longSL = na
var float longTP = na
var float shortSL = na
var float shortTP = na

if (longCondition and strategy.position_size == 0)
    // SL is set just below the low of the Order Block candle minus the buffer
    longSL := low - (slTicks * syminfo.mintick)
    float risk = close - longSL
    longTP := close + (risk * rrRatio)
    
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=longSL, limit=longTP)

if (shortCondition and strategy.position_size == 0)
    // SL is set just above the high of the Order Block candle plus the buffer
    shortSL := high + (slTicks * syminfo.mintick)
    float risk = shortSL - close
    shortTP := close - (risk * rrRatio)
    
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=shortSL, limit=shortTP)

// Plot SL/TP levels dynamically while in a trade
plot(strategy.position_size > 0 ? longSL : na, color=color.red, style=plot.style_linebr, title="Long SL")
plot(strategy.position_size > 0 ? longTP : na, color=color.green, style=plot.style_linebr, title="Long TP")
plot(strategy.position_size < 0 ? shortSL : na, color=color.red, style=plot.style_linebr, title="Short SL")
plot(strategy.position_size < 0 ? shortTP : na, color=color.green, style=plot.style_linebr, title="Short TP")

