//@version=6
// @description Market modules library. Session module + separated VWAP module.
library("MarketReaction", overlay = true)


//──────────────────────────────────────────────────────────────────────────────
// TYPES
//──────────────────────────────────────────────────────────────────────────────

//@type Session result.
//@field high Session high.
//@field low Session low.
//@field mid Session middle.
//@field inSession True when current bar is inside the session.
//@field firstBar True on first session bar.
export type SessionResult
    float high
    float low
    float mid
    bool inSession
    bool firstBar


//@type VWAP result.
//@field vwap Session VWAP.
//@field upper1 VWAP upper deviation 1.
//@field lower1 VWAP lower deviation 1.
//@field upper2 VWAP upper deviation 2.
//@field lower2 VWAP lower deviation 2.
//@field upper3 VWAP upper deviation 3.
//@field lower3 VWAP lower deviation 3.
//@field inSession True when current bar is inside the session.
//@field firstBar True on first session bar.
export type VWAPResult
    float vwap
    float upper1
    float lower1
    float upper2
    float lower2
    float upper3
    float lower3
    bool inSession
    bool firstBar


//──────────────────────────────────────────────────────────────────────────────
// SESSION MODULE
//──────────────────────────────────────────────────────────────────────────────

//@function Draws session high/low/middle, label, and background.
//@param session Session time string.
//@param timeZone Session timezone.
//@param sessionText Session label text.
//@param sessionColor Session color.
//@param sessionDuration Session duration in milliseconds.
//@param showSession Show this session.
//@param showLabels Show session label.
//@param showLines Show high/low lines.
//@param showMiddleLine Show middle line.
//@param showBg Show background fill.
//@param bgTransp Background transparency.
//@returns SessionResult.
export sessionModule(
     string session,
     simple string timeZone,
     simple string sessionText,
     color sessionColor,
     int sessionDuration,
     bool showSession,
     bool showLabels,
     bool showLines,
     bool showMiddleLine,
     bool showBg,
     int bgTransp) =>

    bool inSession = not na(time(timeframe.period, session + ":23456", timeZone))
    bool firstBar  = inSession and not inSession[1]

    var float sessionHigh = na
    var float sessionLow  = na

    var line highLine = na
    var line lowLine  = na
    var line midLine  = na

    var label sessLabel = na
    var linefill sessFill = na

    if inSession
        if firstBar
            sessionHigh := high
            sessionLow  := low

            float sessionMid = sessionLow + ((sessionHigh - sessionLow) / 2.0)

            if showSession and showLabels
                sessLabel := label.new(
                     bar_index,
                     sessionHigh,
                     text = sessionText,
                     textcolor = sessionColor,
                     style = label.style_none,
                     size = size.small)

            if showSession
                highLine := line.new(
                     time,
                     sessionHigh,
                     time + sessionDuration,
                     sessionHigh,
                     xloc = xloc.bar_time,
                     extend = extend.none,
                     color = showLines ? color.new(sessionColor, 0) : color.new(sessionColor, 100),
                     style = line.style_dashed)

                lowLine := line.new(
                     time,
                     sessionLow,
                     time + sessionDuration,
                     sessionLow,
                     xloc = xloc.bar_time,
                     extend = extend.none,
                     color = showLines ? color.new(sessionColor, 0) : color.new(sessionColor, 100),
                     style = line.style_dashed)

                midLine := line.new(
                     time,
                     sessionMid,
                     time + sessionDuration,
                     sessionMid,
                     xloc = xloc.bar_time,
                     extend = extend.none,
                     color = showLines and showMiddleLine ? color.new(sessionColor, 0) : color.new(sessionColor, 100),
                     style = line.style_dashed)

                if showBg
                    sessFill := linefill.new(highLine, lowLine, color.new(sessionColor, bgTransp))

        if high > sessionHigh
            sessionHigh := high

            if not na(highLine)
                line.set_y1(highLine, sessionHigh)
                line.set_y2(highLine, sessionHigh)

        if low < sessionLow
            sessionLow := low

            if not na(lowLine)
                line.set_y1(lowLine, sessionLow)
                line.set_y2(lowLine, sessionLow)

        float sessionMidNow = sessionLow + ((sessionHigh - sessionLow) / 2.0)

        if not na(midLine)
            line.set_y1(midLine, sessionMidNow)
            line.set_y2(midLine, sessionMidNow)

        if showSession and showLabels and not na(sessLabel)
            label.set_xy(sessLabel, bar_index + 1, sessionHigh)

        if not na(sessFill)
            linefill.set_color(sessFill, showSession and showBg ? color.new(sessionColor, bgTransp) : color.new(sessionColor, 100))

    float sessionMiddle = sessionLow + ((sessionHigh - sessionLow) / 2.0)

    SessionResult.new(sessionHigh, sessionLow, sessionMiddle, inSession, firstBar)


//──────────────────────────────────────────────────────────────────────────────
// SESSION VWAP MODULE
//──────────────────────────────────────────────────────────────────────────────

//@function Calculates session VWAP with 3 upper/lower deviation bands.
//@param session Session time string.
//@param timeZone Session timezone.
//@param dev1 Deviation multiplier 1.
//@param dev2 Deviation multiplier 2.
//@param dev3 Deviation multiplier 3.
//@returns VWAPResult.
export sessionVwapModule(
     string session,
     simple string timeZone,
     simple float dev1,
     simple float dev2,
     simple float dev3) =>

    bool inSession = not na(time(timeframe.period, session + ":23456", timeZone))
    bool firstBar  = inSession and not inSession[1]

    [vwapValue, upper1, lower1] = ta.vwap(hlc3, firstBar, dev1)
    [_, upper2, lower2]         = ta.vwap(hlc3, firstBar, dev2)
    [_, upper3, lower3]         = ta.vwap(hlc3, firstBar, dev3)

    VWAPResult.new(
         vwapValue,
         upper1,
         lower1,
         upper2,
         lower2,
         upper3,
         lower3,
         inSession,
         firstBar)