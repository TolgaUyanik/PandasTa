//@version=5

// @description Provides some activation functions useful in time series classification.
// ___
// 
// reference: 
// https://github.com/PYFTS/pyFTS/blob/master/pyFTS/common/Activations.py
library("TimeSeriesClassificationActivationFunctions")

// @function Activate values by a normalized scale.
// @param	dist	Source distribution map.
// @param	weights	Weights distribution map.
// @returns Normalized distribution map.
export method scale (map<int, float> dist, map<int, float> weights) =>
	float _norm = dist.values().sum()
	map<int, float> _nmap = map.new<int, float>()
	for _k in dist.keys()
		_nmap.put(_k, dist.get(_k) * weights.get(_k) / _norm)
	_nmap

// @function Activate values with a softmax algorithm.
// @param	dist	Source distribution map.
// @param	weights	Weights distribution map.
// @returns Normalized distribution map.
export method softmax (map<int, float> dist, map<int, float> weights) =>
	float _norm = 0.0
	for _k in dist.keys()
		_norm += math.exp(dist.get(_k))
	map<int, float> _nmap = map.new<int, float>()
	for _k in dist.keys()
		_nmap.put(_k, math.exp(dist.get(_k) * weights.get(_k) / _norm))
	_nmap

// @function Activate values with a argmax algorithm.
// @param	dist	Source distribution map.
// @param	weights	Weights distribution map.
// @returns first key of argmax value of the transformed distribution.
export method argmax (map<int, float> dist, map<int, float> weights) =>
	map<int, float> _nmap = map.new<int, float>()
	for _k in dist.keys()
		_nmap.put(_k, dist.get(_k) * weights.get(_k))
	float _mx = _nmap.values().max()
	int _rk = na
	for _k in _nmap.keys()
		if _k == _mx
			_rk := _k
			break
	_rk


