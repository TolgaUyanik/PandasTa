//@version=5
indicator("Nifty Buy/Sell Signals with RSI & Fisher", overlay=true)

// === Input Parameters ===
rsiLength = input.int(14, title="RSI Length")
fisherLength = input.int(14, title="Fisher Transform Length")
rsiOverbought = input.int(60, title="RSI Overbought")
rsiOversold = input.int(40, title="RSI Oversold")

// === RSI Calculation ===
rsi = ta.rsi(close, rsiLength)
rsiMa = ta.sma(rsi, 5)

// === Fisher Transform Calculation ===
x = 0.33 * 2 * ((close - ta.lowest(close, fisherLength)) / (ta.highest(close, fisherLength) - ta.lowest(close, fisherLength)) - 0.5)
fisher = 0.5 * math.log((1 + x) / (1 - x))
fisherSmooth = ta.ema(fisher, 3)

// === Buy and Sell Conditions ===
buy = ta.crossover(fisher, fisherSmooth) and ta.crossover(rsi, rsiOversold)
sell = ta.crossunder(fisher, fisherSmooth) and ta.crossunder(rsi, rsiOverbought)

// === Plot Buy/Sell Signals ===
plotshape(buy, title="Buy Signal", location=location.belowbar, color=color.green, style=shape.labelup, text="Buy")
plotshape(sell, title="Sell Signal", location=location.abovebar, color=color.red, style=shape.labeldown, text="Sell")

// === Plot Fisher & RSI for reference ===
plot(rsi, title="RSI", color=color.purple, linewidth=1, display=display.none)
hline(rsiOverbought, "RSI OB", color=color.gray, linestyle=hline.style_dashed)
hline(rsiOversold, "RSI OS", color=color.gray, linestyle=hline.style_dashed)
