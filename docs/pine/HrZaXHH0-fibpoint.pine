//@version=6

// @description A library for generating Fibonacci retracement levels on a chart, including customizable lines, labels, and filled areas between levels. It provides functionality to plot Fibonacci levels based on given price points and bar indices, with options for custom levels and colors.
library("fibpoint", overlay = true)

// @type A custom type representing a Fibonacci level with its associated line and label.
// @field line The line object drawn for the Fibonacci level.
// @field label The label object displaying the Fibonacci level value.
export type fibItem
    line line
    label label


// @function Calculates Fibonacci retracement levels between two price points and draws corresponding lines and labels on the chart.
// @param startPoint The starting price point for the Fibonacci retracement.
// @param endPoint The ending price point for the Fibonacci retracement.
// @param startIdx The bar index where the Fibonacci retracement starts.
// @param endIdx The bar index where the Fibonacci retracement ends.
// @param fibLevels An optional array of custom Fibonacci levels (default is [0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, 1.618]).
// @param fibColors An optional array of colors for each Fibonacci level (default is a predefined color array).
// @param tsp The transparency level for the fill between Fibonacci levels (default is 90).
// @returns A tuple containing an array of fibItem objects (each with a line and label) and an array of linefill objects for the filled areas between levels.
export getFib(float startPoint, float endPoint, int startIdx, int endIdx, float[] fibLevels = na, color[] fibColors = na, int tsp=90) =>
    direction = startPoint > endPoint ? "up" : "down"
    float sp = direction == "up" ? math.min(startPoint, endPoint) : math.max(startPoint, endPoint)
    float ep = direction == "up" ? math.max(startPoint, endPoint) : math.min(startPoint, endPoint)
    
    fibItems = array.new<fibItem>(0)
    fibLv = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, 1.618)
    fibClr = array.from(
     color.new(color.red, 0), 
     color.new(color.orange, 0),
     color.new(color.yellow, 0),
     color.new(color.green, 0),
     color.new(color.blue, 0),
     color.new(color.purple, 0),
     color.new(color.gray, 0),
     color.new(color.navy, 0))
    if not na(fibLevels)
        fibLv := fibLevels
    if not na(fibColors)
        fibClr := fibColors
    for i = 0 to fibLv.size() - 1
        level = fibLv.get(i)
        fibPrice = sp + (ep - sp) * level
        colorLine = fibClr.get(i)

        LINE = line.new(startIdx, fibPrice, endIdx, fibPrice,
                     color=colorLine, width=1, style=line.style_solid )

        LABEL = label.new(endIdx, fibPrice, 
         text = str.tostring(level), 
         style = label.style_label_left,
         textcolor = #000000, 
         color=colorLine, 
         size = size.small)
        fibItems.push(fibItem.new(LINE, LABEL)) 

    allFills = array.new<linefill>(0)
    for i = 0 to fibItems.size() - 2
        l1 = fibItems.get(i).line
        l2 = fibItems.get(i + 1).line
        fillColor = fibClr.get(i)
        allFills.push(linefill.new(l1, l2, color = color.new(fillColor, tsp)))
    
    [fibItems, allFills]

[High, Low] =  request.security("", "D", [high, low])

if session.isfirstbar
    [fib, fills] = getFib(Low, High, bar_index, bar_index+10)
