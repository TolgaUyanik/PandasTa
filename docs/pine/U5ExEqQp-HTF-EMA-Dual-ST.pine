//@version=6
//@version=6
// HTF EMA Regime + Dual Supertrend (10/3 SL, 10/2 Entry) — INDICATOR
// HTF EMA = regime bias. 10/2 = entry only. 10/3 = exit only.
// Entry 1: 10/2 flips green while above EMA
// Entry 2: 10/2 already green + price crosses above EMA
// Exit: 10/3 touched or candle close below 10/3
indicator("HTF EMA + Dual ST", overlay=true)

// ===========================================================================================================
// INPUTS
// ===========================================================================================================
string htfDisplay = input.string("1H", "HTF Timeframe", options=["1H", "4H", "D"])
string htfInput   = switch htfDisplay
    "1H" => "60"
    "4H" => "240"
    "D"  => "D"
    => "60"
int    htfEmaLen  = input.int(200, "HTF EMA Length", minval=1)
string exitMethod = input.string("Touch", "Exit Method", options=["Touch", "Close"], group="Exit")

int    st2Atr     = input.int(10, "ST Entry ATR", group="Supertrend Entry", minval=1)
float  st2Factor  = input.float(2.0, "ST Entry Factor", group="Supertrend Entry", step=0.1, minval=0.1)
int    st3Atr     = input.int(10, "ST Exit ATR", group="Supertrend Exit", minval=1)
float  st3Factor  = input.float(3.0, "ST Exit Factor", group="Supertrend Exit", step=0.1, minval=0.1)

// ===========================================================================================================
// HTF EMA — Regime
// ===========================================================================================================
float htfEma = request.security(syminfo.tickerid, htfInput, ta.ema(close, htfEmaLen))
bool regimeBull = close > htfEma
bool regimeBear = close < htfEma
bool crossedAboveEma = ta.crossover(close, htfEma)
bool crossedBelowEma = ta.crossunder(close, htfEma)

// ===========================================================================================================
// DUAL SUPERTREND
// ===========================================================================================================
// 10/3 — Exit only (wider, flips later)
[st3Val, st3Dir] = ta.supertrend(st3Factor, st3Atr)
bool st3Bull = st3Dir == -1
bool st3Bear = st3Dir == 1

// 10/2 — Entry only (tighter, flips first)
[st2Val, st2Dir] = ta.supertrend(st2Factor, st2Atr)
bool st2Bull = st2Dir == -1
bool st2Bear = st2Dir == 1

bool st2FlippedBull = ta.change(st2Dir) < 0
bool st2FlippedBear = ta.change(st2Dir) > 0

bool st3FlippedBull = ta.change(st3Dir) < 0
bool st3FlippedBear = ta.change(st3Dir) > 0

// ===========================================================================================================
// ENTRIES
// ===========================================================================================================
// Entry 1: 10/2 flips green while above EMA
bool buyFlip  = regimeBull and st2FlippedBull
bool sellFlip = regimeBear and st2FlippedBear

// Entry 2: 10/2 already green + price crosses above EMA (catches early trends)
bool buyCross  = st2Bull and crossedAboveEma
bool sellCross = st2Bear and crossedBelowEma

bool buySignal  = buyFlip or buyCross
bool sellSignal = sellFlip or sellCross

// ===========================================================================================================
// EXITS — 10/3 touched/closed below OR 10/3 flips bearish
// ===========================================================================================================
bool st3HitLong  = exitMethod == "Touch" ? (st3Bull and low <= st3Val)  : (st3Bull and ta.crossunder(close, st3Val))
bool st3HitShort = exitMethod == "Touch" ? (st3Bear and high >= st3Val) : (st3Bear and ta.crossover(close, st3Val))

bool exitLongSignal  = regimeBull and (st3HitLong or st3FlippedBear)
bool exitShortSignal = regimeBear and (st3HitShort or st3FlippedBull)

// ===========================================================================================================
// VISUALS
// ===========================================================================================================
// HTF EMA
plot(htfEma, "HTF EMA", color=color.new(#e040fb, 0), linewidth=2, style=plot.style_linebr)

// 10/3 — Exit line (wider, dashed)
color st3Color = st3Bull ? color.new(#00e676, 60) : color.new(#ff1744, 60)
plot(st3Val, "ST 10/3 (Exit)", color=st3Color, linewidth=2, style=plot.style_linebr)

// 10/2 — Entry line (tighter, solid)
color st2Color = st2Bull ? color.new(#00e676, 0) : color.new(#ff1744, 0)
plot(st2Val, "ST 10/2 (Entry)", color=st2Color, linewidth=1)

// Regime background
bgcolor(regimeBull ? color.new(#00e676, 95) : color.new(#ff1744, 95), title="HTF Regime")

// Entry markers
plotshape(buySignal,  "BUY",  shape.triangleup,   location.belowbar, color=color.green, size=size.small, text="BUY",  textcolor=color.green)
plotshape(sellSignal, "SELL", shape.triangledown, location.abovebar, color=color.red,   size=size.small, text="SELL", textcolor=color.red)

// Exit markers
plotshape(exitLongSignal,  "EXIT LONG",  shape.xcross, location.abovebar, color=color.red,   size=size.tiny, text="EXIT", textcolor=color.red)
plotshape(exitShortSignal, "EXIT SHORT", shape.xcross, location.belowbar, color=color.green, size=size.tiny, text="EXIT", textcolor=color.green)

// ===========================================================================================================
// ALERTS
// ===========================================================================================================
alertcondition(buySignal,  title="BUY Signal",  message="BUY {{ticker}} @ {{close}} — HTF EMA + Dual ST")
alertcondition(sellSignal, title="SELL Signal", message="SELL {{ticker}} @ {{close}} — HTF EMA + Dual ST")
alertcondition(exitLongSignal,  title="EXIT LONG",  message="EXIT LONG {{ticker}} @ {{close}}")
alertcondition(exitShortSignal, title="EXIT SHORT", message="EXIT SHORT {{ticker}} @ {{close}}")