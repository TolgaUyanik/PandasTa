var int lastIndex = na
if barstate.isfirst
    int totalDates = array.size(nfpDates)
    lastIndex := -1
    for i = 0 to totalDates - 1 by 1
        if array.get(nfpDates, i) <= timenow
            lastIndex := i
            lastIndex

var float plotHigh = na
var float plotLow = na
var inNfpDay = false
var int lastDt = na

for j = 0 to nfpCount - 1 by 1
    idx = lastIndex - j
    if idx < 0
        break
    dt = array.get(nfpDates, idx)

    day = dt - (8 * 60 + 30) * 60 * 1000
    dayFuture = day + 24 * 60 * 60 * 1000 
    if bar_index > 1 and time > day and time < dayFuture
        log.info('plotHigh={0}, plotLow={1}', plotHigh, plotLow)
        if not inNfpDay
            plotHigh := high
            plotLow := low
            lastDt := dt

        inNfpDay := true
        plotHigh := high > plotHigh ? high : plotHigh
        plotLow := low < plotLow ? low : plotLow

    else
        if inNfpDay and lastDt == dt
            col = color.from_gradient(j, 0, nfpCount - 1, bottomColor, topColor)
            line.new(x1 = lastDt, y1 = plotHigh, x2 = last_bar_time , y2 = plotHigh, xloc = xloc.bar_time, extend = extend.right, color = col, width = 1)
            label.new(x = last_bar_time, y = plotHigh, xloc = xloc.bar_time, text = str.format('{0} NFP High {1}', str.format_time(lastDt, 'MMM yy'), plotHigh), style = label.style_label_left, color = color.rgb(0, 0, 0, 55), textcolor = col)
            line.new(x1 = lastDt, y1 = plotLow, x2 = last_bar_time, y2 = plotLow, xloc = xloc.bar_time, extend = extend.right, color = col, width = 1)
            label.new(x = last_bar_time, y = plotLow, xloc = xloc.bar_time, text = str.format('{0} NFP Low {1}', str.format_time(lastDt, 'MMM yy'), plotLow), style = label.style_label_left, color = color.rgb(0, 0, 0, 55), textcolor = col)
        if lastDt == dt
            lastDt := na
            inNfpDay := false 
