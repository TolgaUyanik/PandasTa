//@version=6
indicator('NFP Ranges', overlay = true)

// User Inputs
nfpCount = input.int(title = 'NFP Dates to Plot', defval = 3, minval = 2)
bottomColor = input.color(title = 'Gradient Start Color', defval = color.rgb(216, 191, 216,44))
topColor = input.color(title = 'Gradient End Color', defval = color.rgb(125, 0, 130, 44))

