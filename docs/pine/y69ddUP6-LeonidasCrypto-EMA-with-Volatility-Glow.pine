//@version=5
indicator(title="EMA with Volatility Glow", shorttitle="EMA-VG", overlay=true, timeframe="", timeframe_gaps=true)

// EMA Parameters
len = input.int(55, minval=1, title="Primary EMA Length")
len2 = input.int(100, minval=1, title="Secondary EMA Length")
src = input(close, title="Source")
offset = input.int(title="Offset", defval=0, minval=-500, maxval=500, display = display.data_window)
showSecondaryEMA = input.bool(true, title="Show Secondary EMA", group="Secondary EMA")
showSecondaryGlow = input.bool(true, title="Show Secondary Glow", group="Secondary EMA")
showTrendFill = input.bool(true, title="Show Trend Fill Between EMAs", group="Trend Fill")
trendFillTransparency = input.int(90, minval=80, maxval=98, title="Trend Fill Transparency", group="Trend Fill")

// Volatility Parameters
int volLength = input.int(20, minval=1, title="Volatility SMA Length", group="Volatility")
int rsiLength = input.int(14, title="RSI Length", group="Volatility")
float stdDevMultiplier = input.float(2.0, minval=0.001, maxval=50, title="StdDev Multiplier", group="Volatility")
int wmaLength = input.int(10, title="WMA Length", group="Volatility")
int longRoCLength = input.int(14, title="Long RoC Length", group="Volatility")
int shortRoCLength = input.int(11, title="Short RoC Length", group="Volatility")

// Glow Effect Parameters
int glowIntensity = input.int(5, minval=1, maxval=10, title="Glow Intensity", group="Glow Effect")
bool showGlow = input.bool(true, title="Show Glow Effect", group="Glow Effect")
bool showGradientFill = input.bool(true, title="Show Multi-Layer Gradient Fill", group="Glow Effect")
int fillTransparency = input.int(80, minval=50, maxval=95, title="Fill Transparency", group="Glow Effect")
float bandMultiplier = input.float(1.5, minval=0.5, maxval=3.0, title="Gradient Band Width", group="Glow Effect")

// Punk Color Palette
color neonCyan = color.rgb(0, 255, 255)      // Super low volatility
color electricBlue = color.rgb(0, 150, 255)  // Low volatility
color hotPink = color.rgb(255, 20, 147)      // Medium volatility
color neonPink = color.rgb(255, 0, 255)      // High volatility
color intensePink = color.rgb(255, 0, 100)   // Extreme volatility (changed from acid green)

// Secondary EMA Colors
color glowWhite = color.rgb(255, 255, 255)   // Main secondary EMA
color softWhite = color.rgb(200, 200, 200)   // Softer glow variation

// Trend Fill Colors (Punk Style)
color bullishTrend = color.rgb(0, 255, 150)  // Neon green for uptrend
color bearishTrend = color.rgb(255, 0, 0)    // Pure red for downtrend (more visible)

// Calculate EMAs
out = ta.ema(src, len)
out2 = ta.ema(src, len2)

// Noise filter for gradient bands (adapted from ChartPrime method)
noise_filter(src, length) =>
    alpha = 2 / (length + 1)
    nf_1 = 0.0
    nf_2 = 0.0
    nf_3 = 0.0
    nf_1 := (alpha * src) + ((1 - alpha) * nz(nf_1[1]))
    nf_2 := (alpha * nf_1) + ((1 - alpha) * nz(nf_2[1]))
    nf_3 := (alpha * nf_2) + ((1 - alpha) * nz(nf_3[1]))
    nf_3

// Calculate gradient bands around EMA
atr_val = noise_filter(ta.atr(14), len) * bandMultiplier

// Multiple gradient layers (like ChartPrime style)
upper3 = out + atr_val * 0.618 * 2.5
upper2 = out + atr_val * 0.382 * 2.0
upper1 = out + atr_val * 0.236 * 1.5
lower1 = out - atr_val * 0.236 * 1.5
lower2 = out - atr_val * 0.382 * 2.0
lower3 = out - atr_val * 0.618 * 2.5

// Volatility Calculation (BB Volatility Curve)
sma = ta.sma(close, volLength)
stdDev = stdDevMultiplier * ta.stdev(close, volLength)
upperBand = sma + stdDev
lowerBand = sma - stdDev
bbWidth = (upperBand - lowerBand) / sma

// RSI of BB Width
rsiBBW = ta.rsi(bbWidth, rsiLength)

// Rate of Change and WMA
rocSum = ta.roc(rsiBBW, longRoCLength) + ta.roc(rsiBBW, shortRoCLength)
wmaCurve = ta.wma(rocSum, wmaLength)

// Normalize volatility curve for color mapping
volMax = ta.highest(wmaCurve, 100)
volMin = ta.lowest(wmaCurve, 100)
normalizedVol = (wmaCurve - volMin) / (volMax - volMin)

// Dynamic Color Based on Volatility (Punk Style)
getVolatilityColor(vol) =>
    vol <= 0.2 ? neonCyan : vol <= 0.4 ? electricBlue : vol <= 0.6 ? hotPink : vol <= 0.8 ? neonPink : intensePink

mainColor = getVolatilityColor(normalizedVol)

// Create gradient color from volatility curve (ChartPrime style)
// Use the original wmaCurve calculation but map it to punk colors
gradientColor = color.from_gradient(wmaCurve, ta.lowest(wmaCurve, 100), ta.highest(wmaCurve, 100), neonCyan, intensePink)
trendColor = color.new(gradientColor, fillTransparency)

// Plot main EMA
emaPlot = plot(out, title="Primary EMA", color=mainColor, linewidth=3, offset=offset)

// Plot secondary EMA (always plot for fill to work)
secondaryEmaPlot = plot(showSecondaryEMA ? out2 : out, title="Secondary EMA", color=showSecondaryEMA ? glowWhite : color.new(color.white, 100), linewidth=showSecondaryEMA ? 2 : 0, offset=offset)

// Trend Fill Between EMAs (must be after both plots)
isBullish = out > out2
emaTrendColor = isBullish ? bullishTrend : bearishTrend
trendFillColor = showTrendFill and showSecondaryEMA ? color.new(emaTrendColor, trendFillTransparency) : na
fill(emaPlot, secondaryEmaPlot, color=trendFillColor, title="Trend Fill")

// Hidden plots for gradient bands
up3 = plot(showGradientFill ? upper3 : na, display = display.none)
up2 = plot(showGradientFill ? upper2 : na, display = display.none)
up1 = plot(showGradientFill ? upper1 : na, display = display.none)
lw1 = plot(showGradientFill ? lower1 : na, display = display.none)
lw2 = plot(showGradientFill ? lower2 : na, display = display.none)
lw3 = plot(showGradientFill ? lower3 : na, display = display.none)

// Multi-layer gradient fills (ChartPrime style with punk colors)
fill(up3, lw3, showGradientFill ? trendColor : na, title="Gradient Layer 3")
fill(up2, lw2, showGradientFill ? trendColor : na, title="Gradient Layer 2") 
fill(up1, lw1, showGradientFill ? trendColor : na, title="Gradient Layer 1")

// Glow Effect - Multiple offset plots with transparency
glowColor1 = showGlow ? color.new(mainColor, 92) : na
glowColor2 = showGlow ? color.new(mainColor, 94) : na
glowColor3 = showGlow ? color.new(mainColor, 96) : na
glowColor4 = showGlow ? color.new(mainColor, 97) : na
glowColor5 = showGlow ? color.new(mainColor, 98) : na

plot(showGlow and glowIntensity >= 1 ? out : na, title="Glow 1", color=glowColor1, linewidth=4, offset=offset)
plot(showGlow and glowIntensity >= 2 ? out : na, title="Glow 2", color=glowColor2, linewidth=5, offset=offset)
plot(showGlow and glowIntensity >= 3 ? out : na, title="Glow 3", color=glowColor3, linewidth=6, offset=offset)
plot(showGlow and glowIntensity >= 4 ? out : na, title="Glow 4", color=glowColor4, linewidth=7, offset=offset)
plot(showGlow and glowIntensity >= 5 ? out : na, title="Glow 5", color=glowColor5, linewidth=8, offset=offset)

// Smoothing MA Section (keeping original functionality)
GRP = "Smoothing"
TT_BB = "Only applies when 'SMA + Bollinger Bands' is selected. Determines the distance between the SMA and the bands."
maTypeInput = input.string("None", "Type", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = GRP, display = display.data_window)
maLengthInput = input.int(14, "Length", group = GRP, display = display.data_window)
bbMultInput = input.float(2.0, "BB StdDev", minval = 0.001, maxval = 50, step = 0.5, tooltip = TT_BB, group = GRP, display = display.data_window)

var enableMA = maTypeInput != "None"
var isBB = maTypeInput == "SMA + Bollinger Bands"

// Smoothing MA Calculation
getSmoothingMA(source, length, MAtype) => 
    MAtype == "SMA" ? ta.sma(source, length) : MAtype == "SMA + Bollinger Bands" ? ta.sma(source, length) : MAtype == "EMA" ? ta.ema(source, length) : MAtype == "SMMA (RMA)" ? ta.rma(source, length) : MAtype == "WMA" ? ta.wma(source, length) : MAtype == "VWMA" ? ta.vwma(source, length) : na

// Smoothing MA plots
smoothingMA = enableMA ? getSmoothingMA(out, maLengthInput, maTypeInput) : na
smoothingStDev = isBB ? ta.stdev(out, maLengthInput) * bbMultInput : na

// Apply volatility color to smoothing MA as well
plot(smoothingMA, "Primary EMA-based MA", color=color.new(mainColor, 50), display = enableMA ? display.all : display.none)

bbUpperBand = plot(smoothingMA + smoothingStDev, title = "Upper Bollinger Band", color=color.new(mainColor, 60), display = isBB ? display.all : display.none)
bbLowerBand = plot(smoothingMA - smoothingStDev, title = "Lower Bollinger Band", color=color.new(mainColor, 60), display = isBB ? display.all : display.none)
fill(bbUpperBand, bbLowerBand, color= isBB ? color.new(mainColor, 90) : na, title="Bollinger Bands Background Fill", display = isBB ? display.all : display.none)