//@version=6
indicator("Multi-Method Moving Average v6.0", overlay=true)

// User inputs for moving average periods
period9 = input(9, title="MA1 Period")
period26 = input(26, title="MA2 Period")
period52 = input(52, title="MA3 Period")
period100 = input(100, title="MA4 Period")
period200 = input(200, title="MA5 Period")
period500 = input(500, title="MA6 Period")

// Input to select moving average type
maType = input.string("SMA", title="Select MA Type", options=["SMA", "EMA", "WMA"])

// Input to select price source
priceSource = input.string("Close", title="Select Price Source", options=["Open", "Close", "High", "Low", "(Open + Close) / 2"])

// Function to calculate moving average based on selected type
ma(source, length) =>
    if maType == "SMA"
        ta.sma(source, length)
    else if maType == "EMA"
        ta.ema(source, length)
    else if maType == "WMA"
        ta.wma(source, length)
    else
        na

// Determine price source based on user selection
var float selectedPrice = na
if priceSource == "Open"
    selectedPrice := open
else if priceSource == "Close"
    selectedPrice := close
else if priceSource == "High"
    selectedPrice := high
else if priceSource == "Low"
    selectedPrice := low
else if priceSource == "(Open + Close) / 2"
    selectedPrice := (open + close) / 2

// Calculate moving averages
sma9 = ma(selectedPrice, period9)
sma26 = ma(selectedPrice, period26)
sma52 = ma(selectedPrice, period52)
sma100 = ma(selectedPrice, period100)
sma200 = ma(selectedPrice, period200)
sma500 = ma(selectedPrice, period500)

// Determine color based on crossover
colorSMA9 = close > sma9 ? color.green : color.red
colorSMA26 = close > sma26 ? color.green : color.red
colorSMA52 = close > sma52 ? color.green : color.red
colorSMA100 = close > sma100 ? color.green : color.red
colorSMA200 = close > sma200 ? color.green : color.red
colorSMA500 = close > sma500 ? color.green : color.red

// Plot moving averages with new naming
plot(sma9, title='MA1', color=colorSMA9, linewidth=2)
plot(sma26, title='MA2', color=colorSMA26, linewidth=2)
plot(sma52, title='MA3', color=colorSMA52, linewidth=4)
plot(sma100, title='MA4', color=colorSMA100, linewidth=6)
plot(sma200, title='MA5', color=colorSMA200, linewidth=10)
plot(sma500, title='MA6', color=colorSMA500, linewidth=14)
