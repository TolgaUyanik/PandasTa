//@version=6
// @description Methods for elliot wave detection
library('Waves', overlay = true)
import Trendoscope/Drawing/2 as dr
import Trendoscope/Zigzag/10 as zg
import Trendoscope/FibRatios/1 as fibs
import Trendoscope/utils/1 as ut

//@enum Contains Different Wave Types
//@field ImpulseWave Represents Impulse Wave Type
//@field ContractingDiagonal Represents Contracting Diagonal Wave Type
//@field ExpandingDiagonal Represents Expanding Diagonal Wave Type
export enum WaveType
	ImpulseWave
	ContractingDiagonal
	ExpandingDiagonal

// @type SubwavePivots represents the sub pivots of the main wave
// @field waveType Type of the Wave
// @field indices Bar index values of sub waves
// @field subPivots sub pivot objects of the wave
export type SubwavePivots
	WaveType waveType
	array<int> indices
	array<zg.Pivot> subPivots

// @type Subwave represents the drawing of sub waves
// @field waves array of sub wave lines
// @field points Array of subwave pivot labels
// @field subwavePivots array of subwave pivots being drawn
export type Subwave
	array<dr.Line> waves
	array<dr.Label> points
	SubwavePivots subwavePivots

// @type Wave object type
// @field pivot starting point of the wave
// @field wave Line representing the wave
// @field waveLabel label containing wave details
// @field subWaves array of sub waves
export type Wave
	zg.Pivot pivot
	dr.Line wave
	dr.Label waveLabel
	array<Subwave> subWaves

// @function deletes the subwave drawing
// @param this Subwave object to be deleted
// @returns deleted subwave object
export method delete(Subwave this) =>
    for wave in this.waves
        wave.delete()
    for point in this.points
        point.delete()
    this

// @function deletes the wave drawing and the corresponding subwaves
// @param this Wave object to be deleted
// @returns deleted wave object
export method delete(Wave this) =>
    this.wave.delete()
    this.waveLabel.delete()
    if not na(this.subWaves)
        for subWave in this.subWaves
            subWave.delete()
    this

// @function Converts subwave information into string
// @param this Subwave object
// @returns string representation of the subwave object
method tostring(Subwave subwave) =>
    subPivotArray = array.new<float>()
    for index in subwave.subwavePivots.indices
        subPivotArray.push(subwave.subwavePivots.subPivots.get(index).point.price)
    str.tostring(subwave.subwavePivots.waveType) + ':' + str.tostring(subPivotArray)


// @function Create wave object
// @param pivot pivot object where the wave needs to be created
// @param lineColor color of the wave to be drawn
// @param waves array of existing waves
// @param limit max number of waves to be shown in the chart
// @returns wave object created
export method createWave(zg.Pivot pivot, color lineColor, array<Wave> waves, int limit = 10) =>
    Wave wave = na
    dr.Line ln = pivot.point.createLine(pivot.micropivots.last().point, dr.LineProperties.new(color = lineColor))
    dr.LabelProperties lblProps = dr.LabelProperties.new(color = lineColor, textcolor = chart.bg_color, size = size.normal, style = math.sign(pivot.dir) > 0 ? label.style_label_lower_left : label.style_label_upper_left)
    dr.Label lbl = pivot.point.createLabel('Motive Wave', properties = lblProps)

    for [index, existingWave] in waves
        if ln.end.index == existingWave.wave.end.index
            waves.remove(index).delete()
            break
    wave := Wave.new(pivot, ln, lbl, array.new<Subwave>())
    waves.unshift(wave)
    if waves.size() > limit
        waves.pop()
    wave

// @function Create sub waves for the wave
// @param subwavePivots array of sub wave pivots
// @returns wave object created
export method createSubWaves(Wave wave, array<SubwavePivots> subwavePivots) =>
    lineColor = wave.wave.properties.color
    for subwaves in subwavePivots
        subWaveObjects = Subwave.new(array.new<dr.Line>(), array.new<dr.Label>(), subwaves)

        for i = 0 to subwaves.indices.size() - 2 by 1
            subwaveIndex = subwaves.indices.get(i)
            subwaveIndexNext = subwaves.indices.get(i + 1)
            dr.LineProperties properties = dr.LineProperties.new(style = line.style_dotted, color = lineColor)
            subWaveObjects.waves.push(wave.pivot.micropivots.get(subwaveIndex).point.createLine(wave.pivot.micropivots.get(subwaveIndexNext).point, properties))
            dr.LabelProperties lblProperties = dr.LabelProperties.new(style = label.style_text_outline, textcolor = color.black, color = lineColor, size = size.large)
            subWaveObjects.points.push(wave.pivot.micropivots.get(subwaveIndexNext).point.createLabel(lblText = str.tostring(i + 1), properties = lblProperties))
        wave.subWaves.push(subWaveObjects)
    wave

// @function Draw subwave
// @param subwsubWave Subwave object to be drawn
// @returns subwsubWave object
export method draw(Subwave subWave) =>
    for ln in subWave.waves
        ln.draw()
    for pt in subWave.points
        pt.draw()
    subWave

// @function Draw Wave
// @param wave Wave object to be drawn
// @param limitSubwaves limit the number of subwave combinations within the wave
// @returns wave object
export method draw(Wave wave, bool limitSubwaves = true) =>
    waveLabelsArray = array.new<string>()
    waveHeadersArray = array.new<string>()
    for [index, subwave] in wave.subWaves
        if not limitSubwaves or index == wave.subWaves.size() - 1
            subwave.draw()
            waveLabelsArray.push(subwave.tostring())
            headerstring = str.tostring(subwave.subwavePivots.waveType)
            if not waveHeadersArray.includes(headerstring)
                waveHeadersArray.push(headerstring)
    wave.wave.draw()
    wave.waveLabel.lblText := waveHeadersArray.join('\n')
    wave.waveLabel.tooltip := waveLabelsArray.join('\n\n')
    wave.waveLabel.draw()

// @function based on the price array, check if there is motive wave and identify the type
// @param prices float array of prices
// @returns WaveType representing the identified wave type. na otherwise
export method checkMotiveWave(array<float> prices) =>
    p0Price = prices.get(0)
    p1Price = prices.get(1)
    p2Price = prices.get(2)
    p3Price = prices.get(3)
    p4Price = prices.get(4)
    p5Price = prices.get(5)

    w1 = p1Price - p0Price
    w2 = p2Price - p1Price
    w3 = p3Price - p2Price
    w4 = p4Price - p3Price
    w5 = p5Price - p4Price

    w1Length = math.abs(w1)
    w2Length = math.abs(w2)
    w3Length = math.abs(w3)
    w4Length = math.abs(w4)
    w5Length = math.abs(w5)

    w2Ratio = fibs.retracementRatio(p0Price, p1Price, p2Price)
    w3Ratio = fibs.retracementRatio(p1Price, p2Price, p3Price)
    w4Ratio = fibs.retracementRatio(p2Price, p3Price, p4Price)
    w5Ratio = fibs.retracementRatio(p3Price, p4Price, p5Price)

    w3isNotShortest = w3Length > w1Length or w3Length > w5Length

    mRatio = fibs.retracementRatio(p0Price, p3Price, p4Price)
    w2DoesNotRetraceBeyondW1 = w2Ratio < 1
    w3MovesBeyondW1 = w3Ratio > 1
    motiveRatiosIntact = w2DoesNotRetraceBeyondW1 and w3MovesBeyondW1 and w4Ratio < 1 and w5Ratio > 0.9 and mRatio < 1
    isMotiveWave = w3isNotShortest and motiveRatiosIntact

    direction = math.sign(p5Price - p0Price)
    w4NotBeyondEndofW1 = direction * p1Price < direction * p4Price
    numberofExtendedWaves = (1 / w2Ratio > 2 ? 1 : 0) + (w3Ratio > 2 ? 1 : 0) + (w5Ratio > 2 ? 1 : 0)
    notAllExtended = numberofExtendedWaves < 3
    isImpulse = w4NotBeyondEndofW1 and isMotiveWave and notAllExtended

    wave4NotBeyondWave3 = w4Ratio < 1
    wave1OverlapsWave4 = direction * p1Price > direction * p4Price
    isExpandingWaves = w1Length < w2Length and w2Length < w3Length and w3Length < w4Length and w4Length < w5Length
    isContractingWaves = w1Length > w2Length and w2Length > w3Length and w3Length > w4Length and w4Length > w5Length

    isExpandingOrContracting = isExpandingWaves or isContractingWaves
    isExpandingDiagonal = isMotiveWave and wave1OverlapsWave4 and isExpandingWaves and wave4NotBeyondWave3
    isContractingDiagonal = isMotiveWave and wave1OverlapsWave4 and isContractingWaves and wave4NotBeyondWave3

    isImpulse ? WaveType.ImpulseWave : isContractingDiagonal ? WaveType.ContractingDiagonal : isExpandingDiagonal ? WaveType.ExpandingDiagonal : na

// @function Scan for motive wave
// @param pivot Zigzag pivot that will be checked for motive wave
// @param lastPivot previous Zigzag pivot
// @param existingWaves array of existing waves
// @param allowedTypes allowed Wave types to filter them
// @returns array of subwave pivots
export method scanMotiveWave(zg.Pivot pivot, zg.Pivot lastPivot, array<Wave> existingWaves, array<WaveType> allowedTypes = na) =>
    array<SubwavePivots> subwavePivots = array.new<SubwavePivots>()
    existingPattern = false
    for existingWave in existingWaves
        if existingWave.pivot.point.index == pivot.point.index
            existingPattern := true
            break

    if not existingPattern
        if pivot.dir % 2 == 0 and not na(pivot.micropivots) and not na(lastPivot.micropivots) and pivot.micropivots.size() >= 5
            // lastPivotRef = lastPivot.micropivots.get(1).point.price
            prices = pivot.micropivots.getPrices()
            bars = pivot.micropivots.getBars()
            direction = int(math.sign(pivot.dir))
            trendSeries = ut.get_trend_series(prices, prices.size(), direction, direction)
            pullbackSeries = ut.get_trend_series(prices, prices.size(), -direction, direction)
            p0 = pullbackSeries.first()
            for p1Index = 0 to trendSeries.size() >= 2 ? trendSeries.size() - 2 : na by 1
                p1 = trendSeries.get(p1Index)
                if p0 > p1 // and pivot.micropivots.get(p1).point.price*direction > lastPivotRef*direction
                    for p2Index = 1 to pullbackSeries.size() >= 3 ? pullbackSeries.size() - 2 : na by 1
                        p2 = pullbackSeries.get(p2Index)
                        if p1 > p2
                            for p3Index = p1Index + 1 to trendSeries.size() - 1 by 1
                                p3 = trendSeries.get(p3Index)
                                if p2 > p3
                                    for p4Index = p2Index + 1 to pullbackSeries.size() - 1 by 1
                                        p4 = pullbackSeries.get(p4Index)
                                        p5 = 0
                                        if p3 > p4 and p4 > p5
                                            p0Price = prices.get(p0)
                                            p1Price = prices.get(p1)
                                            p2Price = prices.get(p2)
                                            p3Price = prices.get(p3)
                                            p4Price = prices.get(p4)
                                            p5Price = prices.get(p5)

                                            w1Sub = prices.slice(p1, p0 + 1)
                                            w2Sub = prices.slice(p2, p1 + 1)
                                            w3Sub = prices.slice(p3, p2 + 1)
                                            w4Sub = prices.slice(p4, p3 + 1)
                                            w5Sub = prices.slice(p5, p4 + 1)

                                            if w1Sub.max() == math.max(p0Price, p1Price) and w1Sub.min() == math.min(p0Price, p1Price) and w2Sub.max() == math.max(p1Price, p2Price) and w2Sub.min() == math.min(p1Price, p2Price) and w3Sub.max() == math.max(p2Price, p3Price) and w3Sub.min() == math.min(p2Price, p3Price) and w4Sub.max() == math.max(p3Price, p4Price) and w4Sub.min() == math.min(p3Price, p4Price) and w5Sub.max() == math.max(p4Price, p5Price) and w5Sub.min() == math.min(p4Price, p5Price)
                                                waveType = array.from(p0Price, p1Price, p2Price, p3Price, p4Price, p5Price).checkMotiveWave()

                                                if na(allowedTypes) or allowedTypes.includes(waveType)
                                                    impulseIndices = SubwavePivots.new(waveType, array.from(p0, p1, p2, p3, p4, p5), pivot.micropivots)
                                                    subwavePivots.push(impulseIndices)
    subwavePivots
