//@version=6
library("CommonUtils", true)

// CommonUtils Library
// v2, 2025.06.12

// This code's style is based on the recommendations from the Pine Script User Manual's Style guide:
//    https://www.tradingview.com/pine-script-docs/writing/style-guide/



//#region ———————————————————— Functions


// @function                          Maps a user-provided line style string to its corresponding Pine Script™ line style constant.
// @param styleString (simple string) The input string representing the desired line style (e.g., "Solid", "Dashed", "Dotted" - typically from constants like LS1, LS2, LS3).
// @returns           (simple string) The Pine Script™ constant for the line style (e.g., line.style_solid). Defaults to line.style_solid if no match.
export mapLineStyle(simple string styleString) =>
    switch styleString
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid


// @function                             Maps a user-provided table position string to its corresponding Pine Script™ position constant.
// @param positionString (simple string) The input string representing the desired table position (e.g., "Top Right", "Top Center" - typically from constants like PP1, PP2).
// @returns              (simple string) The Pine Script™ constant for the table position (e.g., position.top_right). Defaults to position.top_right if no match.
export mapTablePosition(simple string positionString) =>
    switch positionString
        "Top Center"    => position.top_center
        "Top Left"      => position.top_left
        "Middle Right"  => position.middle_right
        "Middle Center" => position.middle_center
        "Middle Left"   => position.middle_left
        "Bottom Right"  => position.bottom_right
        "Bottom Center" => position.bottom_center
        "Bottom Left"   => position.bottom_left
        => position.top_right


// @function                         Maps a user-provided text size string to its corresponding Pine Script™ size constant.
// @param sizeString (simple string) The input string representing the desired text size (e.g., "Tiny", "Small" - typically from constants like PTS1, PTS2).
// @returns          (simple string) The Pine Script™ constant for the text size (e.g., size.tiny). Defaults to size.small if no match.
export mapTextSize(simple string sizeString) =>
    switch sizeString
        "Tiny"   => size.tiny
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.small


// @function                             Formats a raw timeframe string into a more display-friendly string, with options for long or short formats.
// @param tfRaw          (simple string) The raw timeframe string from user input or `timeframe.period` (e.g., "1", "60", "D", "W").
// @param useShortFormat (simple bool)   If true, returns a compact format (e.g., "1D", "4H", "60"). If false, returns a more descriptive format (e.g., "Daily", "4 Hour", "60min").
// @param customSuffix   (simple string) An optional suffix to append to the formatted timeframe string (e.g., " FVG", " Period"). Defaults to an empty string.
// @returns              (simple string) The formatted timeframe string with the custom suffix appended.
export formatTimeframe(simple string tfRaw, simple bool useShortFormat, simple string customSuffix = "") =>
    string result = ""
    float tfMinutes = str.tonumber(tfRaw)

    if not na(tfMinutes) 
        if useShortFormat
            if tfMinutes % (60 * 24) == 0
                result := str.tostring(int(tfMinutes / (60 * 24))) + "D"
            else if tfMinutes % 60 == 0
                result := str.tostring(int(tfMinutes / 60)) + "H"
            else
                result := str.tostring(int(tfMinutes))
        else 
            if tfMinutes % 60 == 0
                int hours = int(tfMinutes / 60)
                if hours % 24 == 0
                    int days = hours / 24
                    result := days == 1 ? "Daily" : str.tostring(days) + " Day" + (days > 1 ? "s" : "")
                else
                    result := str.tostring(hours) + " Hour" + (hours > 1 ? "s" : "")
            else
                result := str.tostring(int(tfMinutes)) + "min"
    else 
        string numPart = ""
        for i = 0 to str.length(tfRaw) - 1
            char = str.substring(tfRaw, i, i + 1)
            if na(str.tonumber(char))
                break
            numPart += char
        
        string multPart = str.replace(tfRaw, numPart, "")
        int num = na(str.tonumber(numPart)) ? 1 : int(str.tonumber(numPart))

        if useShortFormat
            result := (numPart == "" ? "1" : numPart) + multPart
        else 
            switch multPart
                "D" => result := num == 1 ? "Daily"   : str.tostring(num) + " Day"   + (num > 1 ? "s" : "")
                "W" => result := num == 1 ? "Weekly"  : str.tostring(num) + " Week"  + (num > 1 ? "s" : "")
                "M" => result := num == 1 ? "Monthly" : str.tostring(num) + " Month" + (num > 1 ? "s" : "")
                => result := tfRaw 
    
    result + customSuffix

//#endregion
