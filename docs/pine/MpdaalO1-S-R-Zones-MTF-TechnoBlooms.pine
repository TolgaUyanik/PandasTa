//@version=6
indicator("S&R Zones MTF (TechnoBlooms)", overlay=true, max_lines_count=500, max_boxes_count=500)

// === TIMEFRAME INPUT ===
tf1 = input.timeframe("1", "Higher Timeframe")
tf2 = input.timeframe("2", "Higher Timeframe")
tf3 = input.timeframe("5", "Higher Timeframe")
tf4 = input.timeframe("15", "Higher Timeframe")
// === INPUTS ===
length = input.int(20, "Lookback Length for High/Low", minval=1)
useAutoHeight = input.bool(true, "Use Auto Box Height")
fixedHeight = input.float(2.0, "Fixed Box Height", step=0.1)
resColor = input.color(color.new(#fa0580, 85), "Resistance Box Color")
supColor = input.color(color.new(#03d1f5, 85), "Support Box Color")

// === Function to format TF
formatTF(tf) =>
    tfInt = str.tonumber(tf)
    tfInt >= 60 ? str.tostring(tfInt / 60, "#") + " H" : str.tostring(tfInt) + " M"

// === Variables to store latest levels ===
var float resLevelTF1 = na
var float supLevelTF1 = na
var float resLevelTF2 = na
var float supLevelTF2 = na
var float resLevelTF3 = na
var float supLevelTF3 = na
var float resLevelTF4 = na
var float supLevelTF4 = na

// === BOX AND LABEL STORAGE ===
var box resBoxTF1 = na
var box supBoxTF1 = na
var label resLabelTF1 = na
var label supLabelTF1 = na
var box resBoxTF2 = na
var box supBoxTF2 = na
var label resLabelTF2 = na
var label supLabelTF2 = na
var box resBoxTF3 = na
var box supBoxTF3 = na
var label resLabelTF3 = na
var label supLabelTF3 = na
var box resBoxTF4 = na
var box supBoxTF4 = na
var label resLabelTF4 = na
var label supLabelTF4 = na

// === TF1 DATA ===
hhTF1 = request.security(syminfo.tickerid, tf1, ta.highest(high, length), lookahead=barmerge.lookahead_on)
llTF1 = request.security(syminfo.tickerid, tf1, ta.lowest(low, length), lookahead=barmerge.lookahead_on)
heightTF1 = useAutoHeight ? request.security(syminfo.tickerid, tf1, ta.sma(high - low, length), lookahead=barmerge.lookahead_on) : fixedHeight
isNewHighTF1 = high == hhTF1
isNewLowTF1 = low == llTF1

// === TF2 DATA ===
hhTF2 = request.security(syminfo.tickerid, tf2, ta.highest(high, length), lookahead=barmerge.lookahead_on)
llTF2 = request.security(syminfo.tickerid, tf2, ta.lowest(low, length), lookahead=barmerge.lookahead_on)
heightTF2 = useAutoHeight ? request.security(syminfo.tickerid, tf2, ta.sma(high - low, length), lookahead=barmerge.lookahead_on) : fixedHeight
isNewHighTF2 = high == hhTF2
isNewLowTF2 = low == llTF2

// === TF3 DATA ===
hhTF3 = request.security(syminfo.tickerid, tf3, ta.highest(high, length), lookahead=barmerge.lookahead_on)
llTF3 = request.security(syminfo.tickerid, tf3, ta.lowest(low, length), lookahead=barmerge.lookahead_on)
heightTF3 = useAutoHeight ? request.security(syminfo.tickerid, tf3, ta.sma(high - low, length), lookahead=barmerge.lookahead_on) : fixedHeight
isNewHighTF3 = high == hhTF3
isNewLowTF3 = low == llTF3

// === TF4 DATA ===
hhTF4 = request.security(syminfo.tickerid, tf4, ta.highest(high, length), lookahead=barmerge.lookahead_on)
llTF4 = request.security(syminfo.tickerid, tf4, ta.lowest(low, length), lookahead=barmerge.lookahead_on)
heightTF4 = useAutoHeight ? request.security(syminfo.tickerid, tf4, ta.sma(high - low, length), lookahead=barmerge.lookahead_on) : fixedHeight
isNewHighTF4 = high == hhTF4
isNewLowTF4 = low == llTF4

// === UPDATE LEVELS AND BOXES ===
if isNewHighTF1
    resLevelTF1 := hhTF1
    if not na(resBoxTF1)
        box.delete(resBoxTF1)
    resBoxTF1 := box.new(
         left=bar_index,
         right=bar_index+250,
         top=hhTF1,
         bottom=hhTF1 - heightTF1,
         bgcolor=resColor,
         border_width=0,
         xloc=xloc.bar_index)

if isNewLowTF1
    supLevelTF1 := llTF1
    if not na(supBoxTF1)
        box.delete(supBoxTF1)
    supBoxTF1 := box.new(
         left=bar_index,
         right=bar_index+250,
         top=llTF1 + heightTF1,
         bottom=llTF1,
         bgcolor=supColor,
         border_width=0,
         xloc=xloc.bar_index)

if isNewHighTF2
    resLevelTF2 := hhTF2
    if not na(resBoxTF2)
        box.delete(resBoxTF2)
    resBoxTF2 := box.new(
         left=bar_index,
         right=bar_index+250,
         top=hhTF2,
         bottom=hhTF2 - heightTF2,
         bgcolor=resColor,
         border_width=0,
         xloc=xloc.bar_index)

if isNewLowTF2
    supLevelTF2 := llTF2
    if not na(supBoxTF2)
        box.delete(supBoxTF2)
    supBoxTF2 := box.new(
         left=bar_index,
         right=bar_index+250,
         top=llTF2 + heightTF2,
         bottom=llTF2,
         bgcolor=supColor,
         border_width=0,
         xloc=xloc.bar_index)

if isNewHighTF3
    resLevelTF3 := hhTF3
    if not na(resBoxTF3)
        box.delete(resBoxTF3)
    resBoxTF3 := box.new(
         left=bar_index,
         right=bar_index+250,
         top=hhTF3,
         bottom=hhTF3 - heightTF3,
         bgcolor=resColor,
         border_width=0,
         xloc=xloc.bar_index)

if isNewLowTF3
    supLevelTF3 := llTF3
    if not na(supBoxTF3)
        box.delete(supBoxTF3)
    supBoxTF3 := box.new(
         left=bar_index,
         right=bar_index+250,
         top=llTF3 + heightTF3,
         bottom=llTF3,
         bgcolor=supColor,
         border_width=0,
         xloc=xloc.bar_index)

if isNewHighTF4
    resLevelTF4 := hhTF4
    if not na(resBoxTF4)
        box.delete(resBoxTF4)
    resBoxTF4 := box.new(
         left=bar_index,
         right=bar_index+250,
         top=hhTF4,
         bottom=hhTF4 - heightTF4,
         bgcolor=resColor,
         border_width=0,
         xloc=xloc.bar_index)

if isNewLowTF4
    supLevelTF4 := llTF4
    if not na(supBoxTF4)
        box.delete(supBoxTF4)
    supBoxTF4 := box.new(
         left=bar_index,
         right=bar_index+250,
         top=llTF4 + heightTF4,
         bottom=llTF4,
         bgcolor=supColor,
         border_width=0,
         xloc=xloc.bar_index)

// === UPDATE LABELS ON EVERY BAR ===
if not na(resLevelTF1)
    if not na(resLabelTF1)
        label.delete(resLabelTF1)
    resLabelTF1 := label.new(
         x=bar_index + 30,
         y=resLevelTF1 - heightTF1/2,
         text=formatTF(tf1) + "(R)",
         style=label.style_none,
         textcolor=color.rgb(109, 106, 106),
         size=size.small,
         color=color.new(color.white, 100),
         xloc=xloc.bar_index)

if not na(supLevelTF1)
    if not na(supLabelTF1)
        label.delete(supLabelTF1)
    supLabelTF1 := label.new(
         x=bar_index + 30,
         y=supLevelTF1 + heightTF1/2,
         text=formatTF(tf1) + "(S)",
         style=label.style_none,
         textcolor=color.rgb(30, 243, 179),
         size=size.small,
         color=color.new(color.white, 100),
         xloc=xloc.bar_index)

if not na(resLevelTF2)
    if not na(resLabelTF2)
        label.delete(resLabelTF2)
    resLabelTF2 := label.new(
         x=bar_index + 30,
         y=resLevelTF2 - heightTF2/2,
         text=formatTF(tf2) + "(R)",
         style=label.style_none,
         textcolor=color.rgb(236, 240, 15),
         size=size.small,
         color=color.new(color.white, 100),
         xloc=xloc.bar_index)

if not na(supLevelTF2)
    if not na(supLabelTF2)
        label.delete(supLabelTF2)
    supLabelTF2 := label.new(
         x=bar_index + 30,
         y=supLevelTF2 + heightTF2/2,
         text=formatTF(tf2) + "(S)",
         style=label.style_none,
         textcolor=color.rgb(24, 243, 133),
         size=size.small,
         color=color.new(color.white, 100),
         xloc=xloc.bar_index)

if not na(resLevelTF3)
    if not na(resLabelTF3)
        label.delete(resLabelTF3)
    resLabelTF3 := label.new(
         x=bar_index + 30,
         y=resLevelTF3 - heightTF3/2,
         text=formatTF(tf3) + "(R)",
         style=label.style_none,
         textcolor=color.rgb(18, 116, 243),
         size=size.small,
         color=color.new(color.white, 100),
         xloc=xloc.bar_index)

if not na(supLevelTF3)
    if not na(supLabelTF3)
        label.delete(supLabelTF3)
    supLabelTF3 := label.new(
         x=bar_index + 30,
         y=supLevelTF3 + heightTF3/2,
         text=formatTF(tf3) + "(S)",
         style=label.style_none,
         textcolor=color.rgb(238, 27, 185),
         size=size.small,
         color=color.new(color.white, 100),
         xloc=xloc.bar_index)

if not na(resLevelTF4)
    if not na(resLabelTF4)
        label.delete(resLabelTF4)
    resLabelTF4 := label.new(
         x=bar_index + 30,
         y=resLevelTF4 - heightTF4/2,
         text=formatTF(tf4) + "(R)",
         style=label.style_none,
         textcolor=color.rgb(25, 248, 4),
         size=size.small,
         color=color.new(color.white, 100),
         xloc=xloc.bar_index)

if not na(supLevelTF4)
    if not na(supLabelTF4)
        label.delete(supLabelTF4)
    supLabelTF4 := label.new(
         x=bar_index + 30,
         y=supLevelTF4 + heightTF4/2,
         text=formatTF(tf4) + "(S)",
         style=label.style_none,
         textcolor=color.rgb(243, 149, 8),
         size=size.small,
         color=color.new(color.white, 100),
         xloc=xloc.bar_index)