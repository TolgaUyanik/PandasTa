    symbols.put('HE:market', rth)
    symbols.put('HE:overnight', eth)
    symbols

// @function Returns a session string representing the session hours (and days) for the requested symbol (or the chart's symbol if the symbol value is not provided). If the session string is not found in the collection, it will return a blank string.
// @param session A string representing the session hour being requested. One of: market (regular trading hours), overnight (extended/electronic trading hours), postmarket (after-hours), premarket
// @param symbol The symbol to check. Optional. Defaults to chart symbol. 
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
export getSessionString(string session = 'market', string symbol = '', map<string, string> sessionMap = na) =>
    // Define defaults in case they were not provided
    _symbol = symbol == '' ? syminfo.root : symbol
    _sessionMap = na(sessionMap) ? getSessionMap() : sessionMap
    _sessionMap.get(_symbol + ':' + session)

// @function Returns true if the current symbol is currently in the session parameters defined by sessionString.
// @param session A string representing the session hour being requested. One of: market (regular trading hours), overnight (extended/electronic trading hours), postmarket (after-hours), premarket
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @param barsBack Private. Only used by futures to check islastbar. Optional. The default is 0.
export inSession(string session = 'market', map<string, string> sessionMap = na, int barsBack = 0) =>
    // Default to the TradingView method if hours are not found in the map for the requested symbol
    sessionString = getSessionString(session, '', sessionMap)
    if na(sessionString)
        switch session
            'overnight' => session.ispremarket or session.ispostmarket
            'postmarket' => session.ispostmarket
            'premarket' => session.ispremarket
            => session.ismarket // Default to market (rth) hours
    else
        // If time() returns na, then we are not in the session, true otherwise
        na(time(timeframe.period, sessionString, barsBack)) ? false : true

// Overrides for TradingView's built-in methods

// @function Returns true if the current bar is a part of the regular trading hours (i.e. market hours), false otherwise. Works for futures (TradingView's methods do not).
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @returns bool
export ismarket(map<string, string> sessionMap = na) => 
    inSession('market', sessionMap)

// @function Returns true if the current bar is the first bar of the day's session, false otherwise. If extended session information is used, only returns true on the first bar of the pre-market bars. Works for futures (TradingView's methods do not).
// @returns bool
export isfirstbar() =>
    session.isfirstbar

// @function Returns true if the current bar is the last bar of the day's session, false otherwise. If extended session information is used, only returns true on the last bar of the post-market bars. Works for futures (TradingView's methods do not).
// @returns bool
export islastbar() =>
    session.islastbar

// @function Returns true if the current bar is a part of the pre-market, false otherwise. On non-intraday charts always returns false. Works for futures (TradingView's methods do not).
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @returns bool
export ispremarket(map<string, string> sessionMap = na) => 
    inSession('premarket', sessionMap)

// @function Returns true if the current bar is a part of the post-market, false otherwise. On non-intraday charts always returns false. Works for futures (TradingView's methods do not).
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @returns bool
export ispostmarket(map<string, string> sessionMap = na) => 
    inSession('postmarket', sessionMap)

// @function Returns true on the first regular session bar of the day, false otherwise. The result is the same whether extended session information is used or not. Works for futures (TradingView's methods do not).
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @returns bool
export isfirstbar_regular(map<string, string> sessionMap = na) =>
    sessionString = getSessionString('market', '', sessionMap)
    // Default to the TradingView method if hours are not found in the map for the requested symbol
    if na(sessionString)
        session.isfirstbar_regular
    else
        // If time() returns na, then we are not in the session, true otherwise
        currentBarInSession = na(time(timeframe.period, sessionString)) ? false : true
        lastBarInSession = na(time(timeframe.period, sessionString, 1)) ? false : true
        currentBarInSession and not lastBarInSession

// @function Returns true on the last regular session bar of the day, false otherwise. The result is the same whether extended session information is used or not. Works for futures (TradingView's methods do not).
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @returns bool
export islastbar_regular(map<string, string> sessionMap = na) =>
    sessionString = getSessionString('market', '', sessionMap)
    // Default to the TradingView method if hours are not found in the map for the requested symbol
    if na(sessionString)
        session.islastbar_regular
    else
        // If time() returns na, then we are not in the session, true otherwise
        currentBarInSession = na(time(timeframe.period, sessionString)) ? false : true
        nextBarInSession = na(time(timeframe.period, sessionString, -1)) ? false : true
        currentBarInSession and not nextBarInSession

// Custom conveience methods

// @function Returns true if the current bar is a part of the pre-market or post-market, false otherwise. On non-intraday charts always returns false.
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @returns bool
export isovernight(map<string, string> sessionMap = na) =>
    inSession('overnight', sessionMap)

// @function Returns a tuple containing the high and low print during the specified session.
// @param session The session for which to get the high & low prints. Defaults to market.
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @returns A tuple containing [high, low]
export getSessionHighAndLow(string session = 'market', map<string, string> sessionMap = na) =>
    var float h = 0.
    var float l = 10e10
    var reset = true
    if inSession(session, sessionMap)
        if reset
            h := high
            l := low
            reset := false
        else
            h := math.max(h, high) 
            l := math.min(l, low)
    else
        reset := true
    [h, l]

// @function Convenience function to return the session high. Necessary if you want to call this function from within a request.security expression where you can't return a tuple. 
// @param session The session for which to get the high & low prints. Defaults to market.
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @returns The high of the session
export getSessionHigh(string session = 'market', map<string, string> sessionMap = na) =>
    [h, l] = getSessionHighAndLow(session, sessionMap)
    h

// @function Convenience function to return the session low. Necessary if you want to call this function from within a request.security expression where you can't return a tuple. 
// @param session The session for which to get the high & low prints. Defaults to market.
// @param sessionMap The map of futures session hours. Optional. Uses default if not provided. 
// @returns The low of the session
export getSessionLow(string session = 'market', map<string, string> sessionMap = na) =>
    [h, l] = getSessionHighAndLow(session, sessionMap)
    l

// Code to illustrate how the library works...

// Example code to show the session information functioning properly
addRow(data, heading, value) =>
    matrix.add_row(data, matrix.rows(data), array.from(Table.Cell.new(heading), Table.Cell.new(value ? 'Yes' : 'No', value ? color.green : color.blue)))

data = matrix.new<Table.Cell>()
isPremarket = ispremarket()
isMarket = ismarket()
isPostmarket = ispostmarket()
isOvernight = isovernight()
isFirstBar = isfirstbar()
isLastBar = islastbar()
isFirstBarRegular = isfirstbar_regular()
isLastBarRegular = islastbar_regular()
[onh, onl] = getSessionHighAndLow('overnight')
addRow(data, 'ispremarket', isPremarket)
addRow(data, 'ismarket', isMarket)
addRow(data, 'ispostmarket', isPostmarket)
addRow(data, 'isovernight', isOvernight)
addRow(data, 'isfirstbar', isFirstBar)
addRow(data, 'islastbar', isLastBar)
addRow(data, 'isfirstbar_regular', isFirstBarRegular)
addRow(data, 'islastbar_regular', isLastBarRegular)
matrix.add_row(data, matrix.rows(data), array.from(Table.Cell.new('Overnight High'), Table.Cell.new(str.tostring(onh, format.mintick))))
matrix.add_row(data, matrix.rows(data), array.from(Table.Cell.new('Overnight Low'), Table.Cell.new(str.tostring(onl, format.mintick))))
Table.fromMatrix(data, position.bottom_right)
