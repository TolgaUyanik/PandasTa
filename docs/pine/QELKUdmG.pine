//@version=5
indicator("焱鑫趋势追踪v2", overlay=true)

// === 均线 ===
ema5 = ta.ema(close, 5)
ema21 = ta.ema(close, 21)
ema55 = ta.ema(close, 55)

// === 多头 / 空头排列判断 ===
isBull = ema5 > ema21 and ema21 > ema55
isBear = ema5 < ema21 and ema21 < ema55

// === 最近高低点 ===
lookback = input.int(20, "高低点回看区间")
recentHigh = ta.highest(high, lookback)
recentLow = ta.lowest(low, lookback)

// === 回踩/反弹到EMA55判断 ===
touchRange = input.float(0.003, "触及EMA55范围（百分比）")  // 默认0.3%
isCloseToEMA55 = math.abs(close - ema55) / ema55 < touchRange
inLongPullback = isBull and isCloseToEMA55 and barstate.isconfirmed
inShortRebound = isBear and isCloseToEMA55 and barstate.isconfirmed

// === 收盘突破判断 ===
longBreakout = isBull and close > recentHigh[1] and barstate.isconfirmed
shortBreakdown = isBear and close < recentLow[1] and barstate.isconfirmed

// === 状态变量，避免重复提示 ===
var bool longFired = false
var bool shortFired = false

// === 触发信号条件 ===
longEntry = (longBreakout or inLongPullback) and not longFired
shortEntry = (shortBreakdown or inShortRebound) and not shortFired

// === 状态更新 ===
if longEntry
    longFired := true
    shortFired := false
if shortEntry
    shortFired := true
    longFired := false

// === 趋势失效时重置状态 ===
if not isBull
    longFired := false
if not isBear
    shortFired := false

// === 均线绘制 ===
plot(ema5, title="EMA 5", color=color.blue)
plot(ema21, title="EMA 21", color=color.orange)
plot(ema55, title="EMA 55", color=color.teal)

// === 图标提示 ===
plotshape(longEntry, location=location.belowbar, style=shape.labelup, color=color.green, text="做多", textcolor=color.white)
plotshape(shortEntry, location=location.abovebar, style=shape.labeldown, color=color.red, text="做空", textcolor=color.white)

// === 图中额外提示（仅提示，不触发交易）===
plotshape(inLongPullback and not longEntry, location=location.belowbar, style=shape.triangleup, color=color.lime, size=size.tiny, text="回踩")
plotshape(inShortRebound and not shortEntry, location=location.abovebar, style=shape.triangledown, color=color.maroon, size=size.tiny, text="反弹")

// === 警报 ===
alertcondition(longEntry, title="焱鑫做多信号", message="焱鑫趋势追踪：多头排列并突破高点或回踩EMA55，做多信号确认")
alertcondition(shortEntry, title="焱鑫做空信号", message="焱鑫趋势追踪：空头排列并跌破低点或反弹至EMA55，做空信号确认")
alertcondition(inLongPullback and not longEntry, title="焱鑫回踩提示", message="焱鑫趋势追踪：价格回踩至EMA55，多头排列中")
alertcondition(inShortRebound and not shortEntry, title="焱鑫反弹提示", message="焱鑫趋势追踪：价格反弹至EMA55，空头排列中")

