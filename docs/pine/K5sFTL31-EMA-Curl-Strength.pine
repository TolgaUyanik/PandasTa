//@version=6
indicator("EMA Curl Strength+", overlay=false)

emaLen = input.int(48, "EMA Length") 
smoothLen = input.int(5, "Smoothing Length") 
signalLen = input.int(3, "Signal Smoothing Length") 
signal2Len = input.int(2, "Signal Line 2 Smoothing Length") 
zLookback = input.int(300, "Z-Score Lookback") 
histMult = input.float(1.0, "Histogram Multiplier") 
histSmoothLen = input.int(3, "Histogram Smoothing") 
histSigLen = input.int(5, "Histogram Signal Smoothing") 
gradientOpacity = input.int(85, "Gradient Opacity", minval=0, maxval=100)

thresh1 = input.float(0.25, "Mild Threshold (Z)") 
thresh2 = input.float(1.0, "Moderate Threshold (Z)") 
thresh3 = input.float(2.0, "Strong Threshold (Z)")

mildUpColor = input.color(color.fuchsia, "Z Curl Mild Up Color") 
moderateUpColor = input.color(color.lime, "Z Curl Moderate Up Color") 
strongUpColor = input.color(color.green, "Z Curl Strong Up Color") 
mildDnColor = input.color(color.navy, "Z Curl Mild Down Color") 
moderateDnColor = input.color(color.orange, "Z Curl Moderate Down Color") 
strongDnColor = input.color(color.red, "Z Curl Strong Down Color") 
neutralColor = input.color(color.gray, "Z Curl Neutral Color") 

threshMildUpColor = input.color(color.green, "Threshold Mild Up Color")
threshModUpColor  = input.color(color.lime, "Threshold Moderate Up Color")
threshStrUpColor  = input.color(color.teal, "Threshold Strong Up Color")
threshMildDnColor = input.color(color.red, "Threshold Mild Down Color")
threshModDnColor  = input.color(color.orange, "Threshold Moderate Down Color")
threshStrDnColor  = input.color(color.maroon, "Threshold Strong Down Color")

signalColor = input.color(color.gray, "Signal Line Color") 
signal2Color = input.color(color.orange, "Signal Line 2 Color") 
histUpColor = input.color(color.gray, "Histogram > Signal Color") 
histDnColor = input.color(color.gray, "Histogram < Signal Color")

highlightUpColor = input.color(color.new(color.green, 85), "Z Curl > 2 Background")
highlightDnColor = input.color(color.new(color.red, 85), "Z Curl < -2 Background")

showZeroLine = input.bool(true, "Show Zero Line") 
showMildUpLine = input.bool(true, "Show Mild Up") 
showModerateUp = input.bool(false, "Show Moderate Up") 
showStrongUp = input.bool(false, "Show Strong Up") 
showMildDownLine = input.bool(true, "Show Mild Down") 
showModerateDown = input.bool(false, "Show Moderate Down") 
showStrongDown = input.bool(false, "Show Strong Down")

enableShapeCross = input.bool(true, "Enable Signal Crossover Shapes") 
shapeSourceA = input.string("Signal 1", "Cross Source A", options=["Z Curl Line", "Signal 1", "Signal 2", "0 Line"]) 
shapeSourceB = input.string("Signal 2", "Cross Source B", options=["Z Curl Line", "Signal 1", "Signal 2", "0 Line"]) 
shapeColorUp = input.color(color.green, "Shape Cross Up Color") 
shapeColorDn = input.color(color.red, "Shape Cross Down Color")

ema = ta.ema(close, emaLen) 
slope = (ema - ema[1]) / ema * 100 
mean = ta.sma(slope, zLookback) 
stdev = ta.stdev(slope, zLookback) 
z = (slope - mean) / stdev 
smoothed = ta.ema(z, smoothLen) 
signal = ta.ema(smoothed, signalLen) 
signal2 = ta.ema(signal, signal2Len)

rawHist = (smoothed - signal) * histMult 
hist = ta.ema(rawHist, histSmoothLen) 
histSignal = ta.ema(hist, histSigLen) 
histColor = hist > histSignal ? histUpColor : histDnColor

getColor(val) =>
    val > thresh3  ? strongUpColor : val > thresh2  ? moderateUpColor : val > thresh1  ? mildUpColor : val < -thresh3 ? strongDnColor : val < -thresh2 ? moderateDnColor : val < -thresh1 ? mildDnColor : val > 0        ? color.new(mildUpColor, 60) : val < 0        ? color.new(mildDnColor, 60) : neutralColor
colorLine = getColor(smoothed)

getSource(src) => src == "Z Curl Line" ? smoothed : src == "Signal 1" ? signal : src == "Signal 2" ? signal2 : 0
srcA = getSource(shapeSourceA) 
srcB = getSource(shapeSourceB) 
shapeUp = enableShapeCross and ta.crossover(srcA, srcB) 
shapeDn = enableShapeCross and ta.crossunder(srcA, srcB)

plot(hist, "Histogram", color=histColor, style=plot.style_columns, linewidth=2)
plot(histSignal, "Histogram Signal", color=histColor, linewidth=1)
p = plot(smoothed, "Z Curl Line", color=colorLine, linewidth=2)
s = plot(signal, "Signal 1", color=signalColor, linewidth=1)
plot(signal2, "Signal 2", color=signal2Color, linewidth=1)

plotshape(shapeUp ? signal : na, title="Cross Up Circle", location=location.absolute, style=shape.circle, color=shapeColorUp, size=size.tiny)
plotshape(shapeDn ? signal : na, title="Cross Down Circle", location=location.absolute, style=shape.circle, color=shapeColorDn, size=size.tiny)

plot(showZeroLine ? 0 : na, "Zero", color=color.gray, style=plot.style_linebr)
plot(showMildUpLine     ? thresh1  : na, "Mild Up",     color=threshMildUpColor)
plot(showModerateUp     ? thresh2  : na, "Moderate Up", color=threshModUpColor)
plot(showStrongUp       ? thresh3  : na, "Strong Up",   color=threshStrUpColor, linewidth=2)
plot(showMildDownLine   ? -thresh1 : na, "Mild Down",   color=threshMildDnColor)
plot(showModerateDown   ? -thresh2 : na, "Moderate Down", color=threshModDnColor)
plot(showStrongDown     ? -thresh3 : na, "Strong Down", color=threshStrDnColor, linewidth=2)

fill(p, s, color=color.new(colorLine, gradientOpacity), title="Gradient Fill")

bgcolor(smoothed > 2 ? highlightUpColor : na)
bgcolor(smoothed < -2 ? highlightDnColor : na)