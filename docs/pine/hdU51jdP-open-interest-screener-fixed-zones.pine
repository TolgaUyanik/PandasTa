//@version=5
indicator("Open Interest Screener (Fixed Zones)", overlay = true)

length = input.int(15, title = "Bars to look back")
thresholdPercent = input.float(1.0, title = "OI % Change Threshold")
zoneWidth = input.int(1, title = "Zone Width")

bitmex = input.bool(true, "BitMEX USD.P_OI")
bitmex2 = input.bool(true, "BitMEX USDT.P_OI")
kraken = input.bool(true, "Kraken USD.P_OI")

base = syminfo.basecurrency == "BTC" ? "XBT" : str.tostring(syminfo.basecurrency)

oi_bitmex = request.security("BITMEX:" + base + "USD.P_OI", timeframe.period, close, ignore_invalid_symbol = true)
oi_bitmex2 = request.security("BITMEX:" + base + "USDT.P_OI", timeframe.period, close, ignore_invalid_symbol = true)
oi_kraken = request.security("KRAKEN:" + syminfo.basecurrency + "USD.P_OI", timeframe.period, close, ignore_invalid_symbol = true)

oi = (bitmex ? nz(oi_bitmex, 0) : 0) + (bitmex2 ? nz(oi_bitmex2, 0) : 0) + (kraken ? nz(oi_kraken, 0) : 0)

oiChange = ((oi - oi[length]) / oi[length]) * 100
isSpikeUp = oiChange > thresholdPercent
isSpikeDown = oiChange < -thresholdPercent

var int lastUpBar = na
var int lastDownBar = na
zoneSpacing = length

if isSpikeUp and (na(lastUpBar) or bar_index - lastUpBar >= zoneSpacing)
    box.new(left = bar_index, right = int(bar_index + zoneWidth), top = high + (high * 0.05), bottom = low - (low * 0.05), bgcolor = color.new(color.green, 85), border_width = 0)
    lastUpBar := bar_index

if isSpikeDown and (na(lastDownBar) or bar_index - lastDownBar >= zoneSpacing)
    box.new(left = bar_index, right = int(bar_index + zoneWidth), top = high + (high * 0.05), bottom = low - (low * 0.05), bgcolor = color.new(color.red, 85), border_width = 0)
    lastDownBar := bar_index
