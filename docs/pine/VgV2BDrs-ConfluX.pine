//@version=6
indicator('Confluence Compass — NW Envelope + MFI', shorttitle = 'Confluence Compass', overlay = true, max_labels_count = 500)

// =============================================================================
// INPUTS
// =============================================================================
grpNW = '◆ Nadaraya-Watson Envelope'
nwSrc = input.source(close, 'Source', group = grpNW)
nwLookback = input.int(200, 'Lookback (bars)', minval = 20, maxval = 500, group = grpNW, tooltip = 'Higher = smoother, slower. Lower = more responsive.')
nwH = input.float(8.0, 'Bandwidth (h)', minval = 1.0, step = 0.5, group = grpNW, tooltip = 'Kernel bandwidth. Higher = smoother.')
nwR = input.float(8.0, 'Weighting (r)', minval = 0.5, step = 0.5, group = grpNW, tooltip = 'Relative weighting factor. Higher = tighter fit.')
nwAtrLen = input.int(14, 'ATR length for bands', group = grpNW)
nwMult = input.float(2.0, 'Band ATR multiplier', minval = 0.5, step = 0.1, group = grpNW)
showNW = input.bool(true, 'Show envelope', group = grpNW)
showFill = input.bool(true, 'Fill envelope', group = grpNW)

grpMFI = '◆ Money Flow Index'
mfiLen = input.int(14, 'MFI length', group = grpMFI)
mfiOb = input.int(80, 'MFI overbought', group = grpMFI)
mfiOs = input.int(20, 'MFI oversold', group = grpMFI)
mfiRising = input.int(3, '\'Rising\' streak (bars)', minval = 1, group = grpMFI)

grpDiv = '◆ MFI Divergence'
useDiv = input.bool(true, 'Detect regular divergence', group = grpDiv)
divLbL = input.int(5, 'Pivot lookback L', group = grpDiv)
divLbR = input.int(3, 'Pivot lookback R', group = grpDiv)
divRange = input.int(60, 'Max bars between pivots', group = grpDiv)

grpVol = '◆ Volume Analysis'
volLen = input.int(20, 'Volume SMA length', group = grpVol)
volSpike = input.float(1.5, 'Volume spike multiplier', step = 0.1, group = grpVol, tooltip = 'Bar volume must exceed avg × this to count as a spike')

grpConf = '◆ Confluence Scoring'
proxPct = input.float(0.5, 'Band proximity threshold', step = 0.1, group = grpConf, tooltip = 'How close price must be to NW band to count (× ATR from band)')
scoreMin = input.int(3, 'Min score for normal signal', minval = 2, maxval = 5, group = grpConf)
scoreStrong = input.int(4, 'Min score for STRONG signal', minval = 3, maxval = 5, group = grpConf)
showScore = input.bool(true, 'Show score number next to marker', group = grpConf)

grpVis = '◆ Visuals'
showTbl = input.bool(true, 'Show info table', group = grpVis)
showMark = input.bool(true, 'Show confluence markers', group = grpVis)
showVolSpike = input.bool(false, 'Show volume spike markers', group = grpVis)
tblPos = input.string('bottom_right', 'Table position', options = ['top_left', 'top_right', 'bottom_left', 'bottom_right'], group = grpVis)

// =============================================================================
// NADARAYA-WATSON KERNEL REGRESSION (non-repainting, rational quadratic)
// =============================================================================
f_kernel(src, h, r, lookback) =>
    num = 0.0
    den = 0.0
    for i = 0 to lookback by 1
        w = math.pow(1.0 + math.pow(i, 2) / (math.pow(h, 2) * 2.0 * r), -r)
        num := num + src[i] * w
        den := den + w
        den
    den != 0 ? num / den : src

nwMid = f_kernel(nwSrc, nwH, nwR, nwLookback)
atrVal = ta.atr(nwAtrLen)
nwUpper = nwMid + atrVal * nwMult
nwLower = nwMid - atrVal * nwMult
nwSlope = nwMid - nwMid[1]
nwUp = nwSlope > 0

// =============================================================================
// MONEY FLOW INDEX
// =============================================================================
mfi = ta.mfi(hlc3, mfiLen)

var int mfiUpStreak = 0
var int mfiDnStreak = 0
mfiUpStreak := mfi > mfi[1] ? mfiUpStreak + 1 : 0
mfiDnStreak := mfi < mfi[1] ? mfiDnStreak + 1 : 0
mfiRisingConfirmed = mfiUpStreak >= mfiRising
mfiFallingConfirmed = mfiDnStreak >= mfiRising

mfiInOs = mfi <= mfiOs
mfiInOb = mfi >= mfiOb
mfiTurningUp = mfi < 40 and mfiRisingConfirmed
mfiTurningDown = mfi > 60 and mfiFallingConfirmed

// =============================================================================
// MFI DIVERGENCE
// =============================================================================
plH = ta.pivothigh(mfi, divLbL, divLbR)
plL = ta.pivotlow(mfi, divLbL, divLbR)

var float lastPHval = na
var int lastPHbar = na
var float lastPHpx = na
var float lastPLval = na
var int lastPLbar = na
var float lastPLpx = na

bearDiv = false
bullDiv = false

if not na(plH)
    curPx = high[divLbR]
    if not na(lastPHval) and bar_index - lastPHbar <= divRange
        if plH < lastPHval and curPx > lastPHpx
            bearDiv := true
            bearDiv
    lastPHval := plH
    lastPHbar := bar_index - divLbR
    lastPHpx := curPx
    lastPHpx

if not na(plL)
    curPx = low[divLbR]
    if not na(lastPLval) and bar_index - lastPLbar <= divRange
        if plL > lastPLval and curPx < lastPLpx
            bullDiv := true
            bullDiv
    lastPLval := plL
    lastPLbar := bar_index - divLbR
    lastPLpx := curPx
    lastPLpx

// =============================================================================
// VOLUME ANALYSIS
// =============================================================================
volSma = ta.sma(volume, volLen)
volSurge = volume > volSma * volSpike

// =============================================================================
// CANDLE PATTERNS
// =============================================================================
bodySize = math.abs(close - open)
rangeSize = high - low
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

hammer = rangeSize > 0 and lowerWick / rangeSize > 0.5 and bodySize / rangeSize < 0.35 and close > open
shootStar = rangeSize > 0 and upperWick / rangeSize > 0.5 and bodySize / rangeSize < 0.35 and close < open

bullRev = bullEngulf or hammer
bearRev = bearEngulf or shootStar

// =============================================================================
// PROXIMITY TO BANDS
// =============================================================================
proxDist = atrVal * proxPct
nearLower = low <= nwLower + proxDist
nearUpper = high >= nwUpper - proxDist

// =============================================================================
// CONFLUENCE SCORING (0-5)
// =============================================================================
longScore = (nearLower ? 1 : 0) + (mfiInOs or mfiTurningUp ? 1 : 0) + (bullDiv ? 1 : 0) + (volSurge ? 1 : 0) + (bullRev ? 1 : 0)
shortScore = (nearUpper ? 1 : 0) + (mfiInOb or mfiTurningDown ? 1 : 0) + (bearDiv ? 1 : 0) + (volSurge ? 1 : 0) + (bearRev ? 1 : 0)

confBuy = longScore >= scoreMin and longScore < scoreStrong
confStrongBuy = longScore >= scoreStrong
confSell = shortScore >= scoreMin and shortScore < scoreStrong
confStrongSell = shortScore >= scoreStrong

var int lastBuyBar = -100
var int lastSellBar = -100
buySignal = (confBuy or confStrongBuy) and bar_index - lastBuyBar >= 3
sellSignal = (confSell or confStrongSell) and bar_index - lastSellBar >= 3
if buySignal
    lastBuyBar := bar_index
    lastBuyBar
if sellSignal
    lastSellBar := bar_index
    lastSellBar

showStrongBuy = confStrongBuy and lastBuyBar == bar_index
showStrongSell = confStrongSell and lastSellBar == bar_index

// =============================================================================
// PLOTS — ENVELOPE
// =============================================================================
midCol = nwUp ? color.new(color.aqua, 0) : color.new(color.orange, 0)
p_mid = plot(showNW ? nwMid : na, 'NW Mid', color = midCol, linewidth = 2)
p_up = plot(showNW ? nwUpper : na, 'NW Upper', color = color.new(color.red, 50), linewidth = 1)
p_lo = plot(showNW ? nwLower : na, 'NW Lower', color = color.new(color.green, 50), linewidth = 1)

fill(p_up, p_mid, color = showFill ? color.new(color.red, 92) : na, title = 'Upper Fill')
fill(p_mid, p_lo, color = showFill ? color.new(color.green, 92) : na, title = 'Lower Fill')

// =============================================================================
// PLOTS — SIGNALS (fixed text for plotshape; dynamic score via label.new)
// =============================================================================
plotshape(showMark and buySignal and not showStrongBuy, title = 'Confluence BUY', location = location.belowbar, style = shape.triangleup, size = size.small, color = color.new(color.green, 0), text = 'BUY', textcolor = color.white)
plotshape(showMark and showStrongBuy, title = 'STRONG BUY', location = location.belowbar, style = shape.labelup, size = size.normal, color = color.new(color.lime, 0), text = '★ BUY', textcolor = color.black)
plotshape(showMark and sellSignal and not showStrongSell, title = 'Confluence SELL', location = location.abovebar, style = shape.triangledown, size = size.small, color = color.new(color.red, 0), text = 'SELL', textcolor = color.white)
plotshape(showMark and showStrongSell, title = 'STRONG SELL', location = location.abovebar, style = shape.labeldown, size = size.normal, color = color.new(color.fuchsia, 0), text = '★ SELL', textcolor = color.white)

// Score labels (dynamic text via label.new — safe with series strings)
if showMark and showScore and buySignal
    label.new(bar_index, low, str.tostring(longScore) + '/5', yloc = yloc.belowbar, color = color.new(color.green, 60), textcolor = color.white, style = label.style_none, size = size.tiny)
if showMark and showScore and sellSignal
    label.new(bar_index, high, str.tostring(shortScore) + '/5', yloc = yloc.abovebar, color = color.new(color.red, 60), textcolor = color.white, style = label.style_none, size = size.tiny)

// Volume spikes (optional)
plotshape(showVolSpike and volSurge, title = 'Volume Spike', location = location.belowbar, style = shape.circle, size = size.tiny, color = color.new(color.yellow, 30))

// Divergence labels
if useDiv and bullDiv
    label.new(bar_index - divLbR, low[divLbR], 'Bull Div', yloc = yloc.belowbar, color = color.new(color.green, 20), textcolor = color.white, style = label.style_label_up, size = size.small)
if useDiv and bearDiv
    label.new(bar_index - divLbR, high[divLbR], 'Bear Div', yloc = yloc.abovebar, color = color.new(color.red, 20), textcolor = color.white, style = label.style_label_down, size = size.small)

// =============================================================================
// INFO TABLE
// =============================================================================
var table t = table.new(tblPos == 'top_left' ? position.top_left : tblPos == 'top_right' ? position.top_right : tblPos == 'bottom_left' ? position.bottom_left : position.bottom_right, 2, 7, border_width = 1)

if showTbl and barstate.islast
    nwLoc = close > nwUpper ? 'Above Upper' : close < nwLower ? 'Below Lower' : close > nwMid ? 'Upper half' : 'Lower half'
    nwCol = close > nwUpper ? color.new(color.red, 20) : close < nwLower ? color.new(color.green, 20) : color.new(color.gray, 40)
    mfiTxt = mfiInOb ? 'OB ' + str.tostring(mfi, '#.#') : mfiInOs ? 'OS ' + str.tostring(mfi, '#.#') : str.tostring(mfi, '#.#')
    mfiCol = mfiInOb ? color.new(color.red, 20) : mfiInOs ? color.new(color.green, 20) : color.new(color.gray, 40)
    volCol = volSurge ? color.new(color.yellow, 0) : color.new(color.gray, 40)
    longCol = longScore >= scoreStrong ? color.new(color.lime, 0) : longScore >= scoreMin ? color.new(color.green, 20) : color.new(color.gray, 60)
    shortCol = shortScore >= scoreStrong ? color.new(color.fuchsia, 0) : shortScore >= scoreMin ? color.new(color.red, 20) : color.new(color.gray, 60)

    table.cell(t, 0, 0, 'Confluence Compass', bgcolor = color.new(color.black, 20), text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, nwUp ? 'NW ↑' : 'NW ↓', bgcolor = nwUp ? color.new(color.aqua, 30) : color.new(color.orange, 30), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 1, 'Location', text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, nwLoc, bgcolor = nwCol, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, 'MFI', text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, mfiTxt, bgcolor = mfiCol, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 3, 'Volume', text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, volSurge ? 'SPIKE' : 'normal', bgcolor = volCol, text_color = volSurge ? color.black : color.white, text_size = size.small)
    table.cell(t, 0, 4, 'Long score', text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, str.tostring(longScore) + ' / 5', bgcolor = longCol, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 5, 'Short score', text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 5, str.tostring(shortScore) + ' / 5', bgcolor = shortCol, text_color = color.white, text_size = size.small)
    table.cell(t, 0, 6, 'Bias', text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 6, longScore > shortScore ? 'LONG' : shortScore > longScore ? 'SHORT' : 'neutral', text_color = color.white, text_size = size.small)

// =============================================================================
// ALERTS
// =============================================================================
alertcondition(confStrongBuy, '★ STRONG BUY (Confluence)', 'Confluence Compass: STRONG BUY on {{ticker}} {{interval}}')
alertcondition(confStrongSell, '★ STRONG SELL (Confluence)', 'Confluence Compass: STRONG SELL on {{ticker}} {{interval}}')
alertcondition(confBuy, 'Confluence BUY', 'Confluence Compass: BUY on {{ticker}} {{interval}}')
alertcondition(confSell, 'Confluence SELL', 'Confluence Compass: SELL on {{ticker}} {{interval}}')
alertcondition(bullDiv, 'MFI Bullish Divergence', 'MFI bullish divergence on {{ticker}} {{interval}}')
alertcondition(bearDiv, 'MFI Bearish Divergence', 'MFI bearish divergence on {{ticker}} {{interval}}')
alertcondition(volSurge, 'Volume Spike', 'Volume spike on {{ticker}} {{interval}}')
alertcondition(nearLower and mfiInOs, 'NW Lower Band + MFI Oversold', 'Price at NW lower band with MFI oversold on {{ticker}} {{interval}}')
alertcondition(nearUpper and mfiInOb, 'NW Upper Band + MFI Overbought', 'Price at NW upper band with MFI overbought on {{ticker}} {{interval}}')
