//@version=6
// @description Current news calendar data library for Pine Script strategies (2025–2026).
// Exports a single function that returns five parallel arrays of news event data:
// dates, times (milliseconds from midnight), type IDs, exception severity overrides,
// and exception delay minutes. Designed as a data-only dependency — import alongside
// Vantage_NewsTypes to resolve type IDs to event names and default severities.
library("Vantage_News", overlay=false)
import Vantage-Stack/Vantage_News_Types/1 as nt

// ─────────────────────────────────────────────────────────────────────────
// USAGE — returns five parallel arrays of news rows. Indices correspond
// across arrays: for row i, dates[i], timesMs[i], typeIds[i], excSevs[i],
// and excDelayMins[i] describe one event.
// ─────────────────────────────────────────────────────────────────────────
//
//   import Vantage-Stack/Vantage_News/<version> as packed
//   import Vantage-Stack/Vantage_News_Types/1   as nt
//
//   [dates, timesMs, typeIds, excSevs, excDelayMins] = packed.LoadNewsRows()
//
//   // Default severity for a type ID comes from Vantage_News_Types:
//   array<int> sevByType = nt.LoadTypeSevByTypeId()
//   int effectiveSev = excSevs[0] > 0 ? excSevs[0] : array.get(sevByType, typeIds[0])
//
// ─────────────────────────────────────────────────────────────────────────

// Current news data library: 2025 + 2026.
// Data stored as parallel array.from() literals (dates, timesMS, typeIds).
// Times are pre-computed milliseconds. No runtime string parsing.
// Type IDs reference Vantage_NewsTypes constants.
//
// Returns 5 parallel arrays: [dates, timesMS, typeIds, excSevs, excDelayMins]
// No exception overrides for 2025+ data (excSev=0, excDelay=0 for all rows).
//
// 2023+2024 data lives in Vantage_News_Historical — imported separately by LO1_Utils.
//
// ── EXCLUDE LIST (automation: do not re-add these events) ──
// EXCLUDE: 2026-02-20,945,11 — TYPE_President_Trump_Speaks — occurred during active session
// EXCLUDE: 2026-03-05,1600,75 — TYPE_FOMC_Member_Goolsbee_Speaks — after market hours, no session impact
// EXCLUDE: 2026-03-09,1430,123 — TYPE_President_Trump_Speaks_After_Hours — after market hours, no session impact
// EXCLUDE: 2026-03-11,1325,123 — TYPE_President_Trump_Speaks_After_Hours — after market hours, no session impact

// ── 2025+2026 Data (chunks 0-9) ──
