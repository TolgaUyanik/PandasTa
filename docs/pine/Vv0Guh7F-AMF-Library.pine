//@version=6

// @description Adaptive Momentum Flow (AMF) Library - A comprehensive momentum oscillator that adapts to market volatility
// @author B3AR_Trades

library('AMF_Library', overlay=false)

// ===========================================================================================================
// Exported Types
// ===========================================================================================================

// @type AMF calculation results
// @field main_oscillator The main AMF oscillator value (-100 to 100)
// @field signal_line The signal line for crossover signals
// @field dema_fast Fast adaptive DEMA value
// @field dema_medium Medium adaptive DEMA value  
// @field dema_slow Slow adaptive DEMA value
// @field volume_analysis Volume-based buying/selling pressure (-100 to 100)
// @field adaptive_lookback Current adaptive lookback length
// @field volatility_ratio Current volatility ratio vs average
export type AMFResult
    float main_oscillator
    float signal_line
    float dema_fast
    float dema_medium
    float dema_slow
    float volume_analysis
    int adaptive_lookback
    float volatility_ratio

// ===========================================================================================================
// Core Moving Average Functions
// ===========================================================================================================

// @function Custom EMA calculation that accepts a series length
// @param source (float) Source data for calculation
// @param length (float) EMA length (can be series)
// @returns (float) EMA value
export f_ema(float source, float length) =>
    float alpha = 2.0 / (length + 1)
    var float ema_val = na 
    if not na(source) and length > 0
        ema_val := alpha * source + (1 - alpha) * nz(ema_val[1])
    ema_val

// @function Custom DEMA calculation that accepts a series length
// @param source (float) Source data for calculation
// @param length (float) DEMA length (can be series)
// @returns (float) DEMA value
export f_dema(float source, float length) =>
    float ema1 = f_ema(source, length)
    float ema2 = f_ema(ema1, length)
    float dema_val = 2 * ema1 - ema2
    dema_val

// @function Custom sum function for rolling sum calculation
// @param source (float) Source data for summation
// @param length (int) Number of periods to sum
// @returns (float) Sum value
export f_sum(float source, int length) =>
    float sum_val = 0.0
    for i = 0 to length - 1
        sum_val += nz(source[i], 0)
    sum_val

// @function Get various moving average types for fixed lengths
// @param data (float) Source data
// @param length (int) MA length
// @param ma_type (string) MA type: "SMA", "EMA", "WMA", "DEMA"
// @returns (float) Moving average value
export get_average(float data, int length, string ma_type) =>
    float value = na 
    if length > 0 
        value := switch ma_type
            "SMA" => ta.sma(data, length) 
            "EMA" => ta.ema(data, length) 
            "WMA" => ta.wma(data, length) 
            "DEMA" => 2 * ta.ema(data, length) - ta.ema(ta.ema(data, length), length) 
            => ta.wma(data, length)
    value

// ===========================================================================================================
// Adaptive Volatility Functions
// ===========================================================================================================

// @function Calculate adaptive lookback length based on volatility
// @param base_length (int) Base lookback length
// @param min_lookback (int) Minimum allowed lookback
// @param max_lookback (int) Maximum allowed lookback
// @param volatility_sensitivity (float) Sensitivity to volatility changes
// @returns (int) Adaptive lookback length
export calculate_adaptive_lookback(int base_length, int min_lookback, int max_lookback, float volatility_sensitivity) =>
    float current_atr = ta.atr(14)
    float avg_atr = ta.sma(current_atr, 50)
    
    float volatility_ratio = 1.0
    if avg_atr > 0
        volatility_ratio := current_atr / avg_atr
    
    float raw_adaptive_lookback = float(base_length) / math.pow(volatility_ratio, volatility_sensitivity)
    int adaptive_lookback = int(math.max(min_lookback, math.min(max_lookback, raw_adaptive_lookback)))
    
    if adaptive_lookback < 1
        adaptive_lookback := 1
    
    adaptive_lookback

// @function Get current volatility ratio
// @returns (float) Current volatility ratio vs 50-period average
export get_volatility_ratio() =>
    float current_atr = ta.atr(14)
    float avg_atr = ta.sma(current_atr, 50)
    float volatility_ratio = avg_atr > 0 ? current_atr / avg_atr : 1.0
    volatility_ratio

// ===========================================================================================================
// Volume Analysis Functions
// ===========================================================================================================

// @function Calculate volume-based buying/selling pressure
// @param vzo_length (int) Lookback length for volume analysis
// @param smooth_length (int) Smoothing length
// @param smooth_type (string) Smoothing MA type
// @returns (float) Volume analysis value (-100 to 100)
export calculate_volume_analysis(int vzo_length, int smooth_length, string smooth_type) =>
    float pv = 0.0
    if close > close[1]
        pv := volume
    else if close < close[1]
        pv := -volume
    
    float vzo_sum = f_sum(pv, vzo_length)
    float vol_sum = f_sum(volume, vzo_length)
    
    float vzo_value = 0.0
    if vol_sum != 0
        vzo_value := 100 * (vzo_sum / vol_sum)
    
    float smoothed_vzo = get_average(vzo_value, smooth_length, smooth_type)
    smoothed_vzo

// ===========================================================================================================
// Main AMF Calculation Function
// ===========================================================================================================

// @function Calculate complete AMF oscillator
// @param base_length (int) Base lookback length
// @param smooth_length (int) Final smoothing length
// @param smooth_type (string) Final smoothing MA type
// @param signal_length (int) Signal line length
// @param signal_type (string) Signal line MA type
// @param min_lookback (int) Minimum adaptive lookback
// @param max_lookback (int) Maximum adaptive lookback
// @param volatility_sensitivity (float) Volatility adaptation sensitivity
// @param medium_multiplier (float) Medium DEMA length multiplier
// @param slow_multiplier (float) Slow DEMA length multiplier
// @param vzo_length (int) Volume analysis lookback
// @param vzo_smooth_length (int) Volume analysis smoothing
// @param vzo_smooth_type (string) Volume analysis smoothing type
// @param price_vs_fast_weight (float) Weight for price vs fast DEMA
// @param fast_vs_medium_weight (float) Weight for fast vs medium DEMA  
// @param medium_vs_slow_weight (float) Weight for medium vs slow DEMA
// @param vzo_weight (float) Weight for volume analysis component
// @returns (AMFResult) Complete AMF calculation results
export calculate_amf(int base_length, int smooth_length, string smooth_type, int signal_length, string signal_type, int min_lookback, int max_lookback, float volatility_sensitivity, float medium_multiplier, float slow_multiplier, int vzo_length, int vzo_smooth_length, string vzo_smooth_type, float price_vs_fast_weight, float fast_vs_medium_weight, float medium_vs_slow_weight, float vzo_weight) =>
    
    // Calculate adaptive lookback
    int adaptive_lookback = calculate_adaptive_lookback(base_length, min_lookback, max_lookback, volatility_sensitivity)
    float volatility_ratio = get_volatility_ratio()
    
    // Calculate DEMA lengths
    int dema_fast_len = adaptive_lookback
    int dema_medium_len = int(math.max(1, adaptive_lookback * medium_multiplier))
    int dema_slow_len = int(math.max(1, adaptive_lookback * slow_multiplier))
    
    // Calculate DEMA values
    float dema_fast = f_dema(close, dema_fast_len)
    float dema_medium = f_dema(close, dema_medium_len)
    float dema_slow = f_dema(close, dema_slow_len)
    
    // Calculate volume analysis
    float volume_analysis = calculate_volume_analysis(vzo_length, vzo_smooth_length, vzo_smooth_type)
    
    // Calculate oscillator score
    float oscillator_score = 0.0
    
    // DEMA alignment scoring
    if close > dema_fast
        oscillator_score += price_vs_fast_weight
    else if close < dema_fast
        oscillator_score -= price_vs_fast_weight
    
    if dema_fast > dema_medium
        oscillator_score += fast_vs_medium_weight
    else if dema_fast < dema_medium
        oscillator_score -= fast_vs_medium_weight
    
    if dema_medium > dema_slow
        oscillator_score += medium_vs_slow_weight
    else if dema_medium < dema_slow
        oscillator_score -= medium_vs_slow_weight
    
    // Add volume component
    oscillator_score += (volume_analysis / 100) * vzo_weight
    
    // Normalize to -100 to 100 range
    float max_possible_score = price_vs_fast_weight + fast_vs_medium_weight + medium_vs_slow_weight + vzo_weight
    float normalized_score = max_possible_score != 0.0 ? (oscillator_score / max_possible_score) * 100.0 : 0.0
    
    // Smooth final oscillator
    float main_oscillator = get_average(normalized_score, smooth_length, smooth_type)
    
    // Calculate signal line
    float signal_line = get_average(main_oscillator, signal_length, signal_type)
    
    // Return result
    AMFResult.new(main_oscillator, signal_line, dema_fast, dema_medium, dema_slow, 
                  volume_analysis, adaptive_lookback, volatility_ratio)

// ===========================================================================================================
// Convenience Functions
// ===========================================================================================================

// @function Calculate AMF with default parameters
// @returns (AMFResult) AMF result with standard settings
export calculate_amf_default() =>
    calculate_amf(14, 10, "EMA", 8, "WMA", 5, 50, 3.0, 1.5, 2.5, 22, 3, "SMA", 30.0, 30.0, 40.0, 50.0)

// @function Get just the main AMF oscillator value with default parameters
// @returns (float) Main AMF oscillator value
export amf_oscillator() =>
    AMFResult result = calculate_amf_default()
    result.main_oscillator

// @function Get just the AMF signal line with default parameters  
// @returns (float) AMF signal line value
export amf_signal() =>
    AMFResult result = calculate_amf_default()
    result.signal_line

// @function Check if AMF is in overbought condition
// @param overbought_level (float) Overbought threshold (default 70)
// @returns (bool) True if overbought
export is_overbought(float overbought_level) =>
    AMFResult result = calculate_amf_default()
    result.main_oscillator >= overbought_level

// @function Check if AMF is in oversold condition  
// @param oversold_level (float) Oversold threshold (default -70)
// @returns (bool) True if oversold
export is_oversold(float oversold_level) =>
    AMFResult result = calculate_amf_default()
    result.main_oscillator <= oversold_level

// @function Detect bullish crossover (main line crosses above signal)
// @returns (bool) True on bullish crossover
export bullish_crossover() =>
    AMFResult result = calculate_amf_default()
    AMFResult prev_result = calculate_amf_default()[1]
    ta.crossover(result.main_oscillator, result.signal_line)

// @function Detect bearish crossover (main line crosses below signal)  
// @returns (bool) True on bearish crossover
export bearish_crossover() =>
    AMFResult result = calculate_amf_default()
    AMFResult prev_result = calculate_amf_default()[1]
    ta.crossunder(result.main_oscillator, result.signal_line)