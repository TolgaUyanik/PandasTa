//@version=6
indicator("Weekly Range Projections", shorttitle="WRP", overlay=true, max_bars_back=500, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

if not(timeframe.in_seconds(timeframe.period) == timeframe.in_seconds("5") or timeframe.in_seconds(timeframe.period) == timeframe.in_seconds("15"))
    runtime.error("Go to the 5 Minute or 15 Minute Chart!")

//#region[GLOBAL]
tooUtils_lineStyle(string _style) =>
    style = switch _style
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        "Solid"  => line.style_solid
    style

noColor = color.new(color.white,100)
//#endregion

//#region[USER INPUT]
// Day Selection
selectedDay = input.string("Friday", title="Day of Week", options=["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], group="Range Settings")

// Time Settings
startHour = input.int(19, title="Start Hour (24h)", minval=0, maxval=23, group="Range Settings", inline="start")
startMin = input.int(0, title="Start Minute", minval=0, maxval=59, group="Range Settings", inline="start")
endHour = input.int(23, title="End Hour (24h)", minval=0, maxval=23, group="Range Settings", inline="end")
endMin = input.int(59, title="End Minute", minval=0, maxval=59, group="Range Settings", inline="end")

// Toggle for Body and Wick
showBody = input.bool(true, title="Show Body Range", group="Range Type")
showWick = input.bool(true, title="Show Wick Range", group="Range Type")

// Number of deviations
numDeviations = input.int(3, title="Number of Deviations", minval=1, maxval=9, group="Deviations")

// Historical Sessions
showLast = input.int(0, title="Historical Sessions", minval=0, maxval=20, group="Display")

// Body Range Styling
arBodyBoxColor  = input.color(color.new(#000000, 80), title="Box", group="Body Range Style", inline='B')
arBodyLineColor = input.color(#000000, title="Line", group="Body Range Style", inline='B')
arBodyLineStyle = tooUtils_lineStyle(input.string("Dotted", title="", group="Body Range Style", inline='B', options=["Dotted", "Dashed", "Solid"]))
arBodyLineWidth = input.int(1, title="", group="Body Range Style", inline='B', minval=1)

// Wick Range Styling
arWickBoxColor  = input.color(color.new(#388e3c, 80), title="Box", group="Wick Range Style", inline='W')
arWickLineColor = input.color(#388e3c, title="Line", group="Wick Range Style", inline='W')
arWickLineStyle = tooUtils_lineStyle(input.string("Dotted", title="", group="Wick Range Style", inline='W', options=["Dotted", "Dashed", "Solid"]))
arWickLineWidth = input.int(1, title="", group="Wick Range Style", inline='W', minval=1)

// Alerts
arBodyAlert = input.bool(false, title="", group="Alerts", inline='b')
arBodyAlertLine = input.string("3B", title="+/- Stdev", group="Alerts", inline='b', options=["1B", "2B", "3B", "4B", "5B", "6B", "7B", "8B", "9B"])

arWickAlert = input.bool(false, title="", group="Alerts", inline='w')
arWickAlertLine = input.string("3W", title="+/- Stdev", group="Alerts", inline='w', options=["1W", "2W", "3W", "4W", "5W", "6W", "7W", "8W", "9W"])
//#endregion

//#region[DECLARATIONS & FUNCTION]
var asian_range = array.new_box()
var asian_stdev = array.new_line()
var asian_label = array.new_label()

var int ar_start = na
var float ar_bodyHigh = na
var float ar_wickHigh = na
var int ar_end = na
var float ar_bodyLow = na
var float ar_wickLow = na

var alert_BodyUp = false
var float alert_level_BodyUp = na
var alert_BodyDw = false
var float alert_level_BodyDw = na
var alert_WickUp = false
var float alert_level_WickUp = na
var alert_WickDw = false
var float alert_level_WickDw = na

// Convert day string to day of week number
getDayOfWeek(string day) =>
    switch day
        "Monday" => 2
        "Tuesday" => 3
        "Wednesday" => 4
        "Thursday" => 5
        "Friday" => 6
        => 1

tooUtils_alertLine(string ID, string TYPE, float PRICE=na) =>
    if na(PRICE)
        if ID+TYPE == arBodyAlertLine
            ar_start+(7*86400000)
        else if ID+TYPE == arWickAlertLine
            ar_start+(7*86400000)
        else
            ar_end
    else
        if ID+TYPE == arBodyAlertLine
            PRICE
        else if ID+TYPE == arWickAlertLine
            PRICE
        else
            na
//#endregion

//#region[LOGIC]
// Create time string for the selected day and time range
timeString = str.format("{0:04d}-{1:02d}{2:02d}:{3}", startHour, startMin, endHour, endMin)

// Check if current bar is within the selected day and time range
targetDay = getDayOfWeek(selectedDay)
isTargetDay = dayofweek == targetDay
range_time = isTargetDay and session.ismarket and 
             (hour * 60 + minute >= startHour * 60 + startMin) and 
             (hour * 60 + minute <= endHour * 60 + endMin)

if range_time
    if not(range_time[1])
        ar_start := time
        ar_bodyHigh := math.max(open, close)
        ar_bodyLow := math.min(open, close)
        ar_wickHigh := high
        ar_wickLow := low

    ar_bodyHigh := math.max(math.max(open, close), ar_bodyHigh)
    ar_bodyLow := math.min(math.min(open, close), ar_bodyLow)
    ar_wickHigh := math.max(high, ar_wickHigh)
    ar_wickLow := math.min(low, ar_wickLow)
//#endregion

//#region[PLOT]
else 
    if range_time[1]
        alert_BodyUp := true
        alert_BodyDw := true
        alert_WickUp := true
        alert_WickDw := true

        ar_end := time
        body_Range = ar_bodyHigh - ar_bodyLow
        wick_Range = ar_wickHigh - ar_wickLow

        if showBody
            asian_range.unshift(box.new(ar_start, ar_bodyHigh, ar_end, ar_bodyLow, noColor, 0, xloc=xloc.bar_time, bgcolor=arBodyBoxColor))
        
        if showWick
            asian_range.unshift(box.new(ar_start, ar_wickHigh, ar_end, ar_wickLow, noColor, 0, xloc=xloc.bar_time, bgcolor=arWickBoxColor))

        for i = 1 to numDeviations by 1
            stdev_bodyUp = ar_bodyHigh + (i * body_Range)
            stdev_bodyDw = ar_bodyLow - (i * body_Range)
            stdev_wickUp = ar_wickHigh + (i * wick_Range)
            stdev_wickDw = ar_wickLow - (i * wick_Range)

            level_BodyUp = tooUtils_alertLine(str.tostring(i), "B", stdev_bodyUp)
            level_BodyDw = tooUtils_alertLine(str.tostring(i), "B", stdev_bodyDw)
            level_WickUp = tooUtils_alertLine(str.tostring(i), "W", stdev_wickUp)
            level_WickDw = tooUtils_alertLine(str.tostring(i), "W", stdev_wickDw)

            alert_level_BodyUp := na(level_BodyUp) ? alert_level_BodyUp : level_BodyUp
            alert_level_BodyDw := na(level_BodyDw) ? alert_level_BodyDw : level_BodyDw
            alert_level_WickUp := na(level_WickUp) ? alert_level_WickUp : level_WickUp
            alert_level_WickDw := na(level_WickDw) ? alert_level_WickDw : level_WickDw

            if showBody
                asian_stdev.unshift(line.new(ar_start, stdev_bodyUp, int(tooUtils_alertLine(str.tostring(i), "B")), stdev_bodyUp, color=arBodyLineColor, style=arBodyLineStyle, width=arBodyLineWidth, xloc=xloc.bar_time))
                asian_stdev.unshift(line.new(ar_start, stdev_bodyDw, int(tooUtils_alertLine(str.tostring(i), "B")), stdev_bodyDw, color=arBodyLineColor, style=arBodyLineStyle, width=arBodyLineWidth, xloc=xloc.bar_time))
                asian_label.unshift(label.new(ar_start, stdev_bodyUp, "+" + str.tostring(i) + "B", color=noColor, style=label.style_label_right, textcolor=arBodyLineColor, size=size.small, text_font_family=font.family_monospace, xloc=xloc.bar_time, tooltip=str.tostring(stdev_bodyUp)))
                asian_label.unshift(label.new(ar_start, stdev_bodyDw, "-" + str.tostring(i) + "B", color=noColor, style=label.style_label_right, textcolor=arBodyLineColor, size=size.small, text_font_family=font.family_monospace, xloc=xloc.bar_time, tooltip=str.tostring(stdev_bodyDw)))

            if showWick
                asian_stdev.unshift(line.new(ar_start, stdev_wickUp, int(tooUtils_alertLine(str.tostring(i), "W")), stdev_wickUp, color=arWickLineColor, style=arWickLineStyle, width=arWickLineWidth, xloc=xloc.bar_time))
                asian_stdev.unshift(line.new(ar_start, stdev_wickDw, int(tooUtils_alertLine(str.tostring(i), "W")), stdev_wickDw, color=arWickLineColor, style=arWickLineStyle, width=arWickLineWidth, xloc=xloc.bar_time))
                asian_label.unshift(label.new(ar_start, stdev_wickUp, "+" + str.tostring(i) + "W", color=noColor, style=label.style_label_right, textcolor=arWickLineColor, size=size.small, text_font_family=font.family_monospace, xloc=xloc.bar_time, tooltip=str.tostring(stdev_wickUp)))
                asian_label.unshift(label.new(ar_start, stdev_wickDw, "-" + str.tostring(i) + "W", color=noColor, style=label.style_label_right, textcolor=arWickLineColor, size=size.small, text_font_family=font.family_monospace, xloc=xloc.bar_time, tooltip=str.tostring(stdev_wickDw)))

        // Clean up old drawings
        maxBoxes = (showBody and showWick) ? (showLast + 1) * 2 : showLast + 1
        if asian_range.size() > maxBoxes
            boxesToDelete = asian_range.size() - maxBoxes
            for i = 1 to boxesToDelete by 1
                box.delete(asian_range.pop())
            
            // Calculate lines and labels to delete
            linesPerSession = 0
            if showBody
                linesPerSession += numDeviations * 2
            if showWick
                linesPerSession += numDeviations * 2
            
            linesToDelete = boxesToDelete * linesPerSession / ((showBody and showWick) ? 2 : 1)
            for i = 1 to linesToDelete by 1
                line.delete(asian_stdev.pop())
                label.delete(asian_label.pop())
//#endregion

//#region[ALERTS]
if arBodyAlert and showBody
    if high > alert_level_BodyUp and alert_BodyUp
        alert_BodyUp := false
        alert(ticker.standard(syminfo.ticker) + " Crossing " + selectedDay + "'s Range +" + arBodyAlertLine + " Standard Deviation @ " + str.tostring(alert_level_BodyUp), alert.freq_once_per_bar)
    if low < alert_level_BodyDw and alert_BodyDw
        alert_BodyDw := false
        alert(ticker.standard(syminfo.ticker) + " Crossing " + selectedDay + "'s Range -" + arBodyAlertLine + " Standard Deviation @ " + str.tostring(alert_level_BodyDw), alert.freq_once_per_bar)

if arWickAlert and showWick
    if high > alert_level_WickUp and alert_WickUp
        alert_WickUp := false
        alert(ticker.standard(syminfo.ticker) + " Crossing " + selectedDay + "'s Range +" + arWickAlertLine + " Standard Deviation @ " + str.tostring(alert_level_WickUp), alert.freq_once_per_bar)
    if low < alert_level_WickDw and alert_WickDw
        alert_WickDw := false
        alert(ticker.standard(syminfo.ticker) + " Crossing " + selectedDay + "'s Range -" + arWickAlertLine + " Standard Deviation @ " + str.tostring(alert_level_WickDw), alert.freq_once_per_bar)
//#endregion