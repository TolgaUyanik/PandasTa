// pop_for {

// @function Removes and deletes excess elements from the end of an array of labels using the pop method
// @param min_size The minimum size of the array
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the popping process
// @returns void
export method pop_for(label[] self, int min_size = 0, int max_size = 0, bool trigger = true)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")
	if min_size < 0
		runtime.error("min_size must be equal to or greater than 0.")

	if self.ready(max_size) and nz(trigger, false)
		while self.ready(min_size)
			self.pop().delete()

// @function Removes and deletes excess elements from the end of an array of lines using the pop method
// @param min_size The minimum size of the array
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the popping process
// @returns void
export method pop_for(line[] self, int min_size = 0, int max_size = 0, bool trigger = true)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")
