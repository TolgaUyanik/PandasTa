// dump {

// @function Removes and deletes excess elements from an array of labels
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the dumping process
// @returns void
export method dump(label[] self, int max_size = 0, bool trigger = true)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size) and nz(trigger, false)
        for i = self.length() to 0
            self.remove(i).delete()

// @function Removes and deletes excess elements from an array of lines
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the dumping process
// @returns void
export method dump(line[] self, int max_size = 0, bool trigger = true)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size) and nz(trigger, false)
        for i = self.length() to 0
            self.remove(i).delete()

// @function Removes and deletes excess elements from an array of polylines
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the dumping process
// @returns void
export method dump(polyline[] self, int max_size = 0, bool trigger = true)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size) and nz(trigger, false)
        for i = self.length() to 0
            self.remove(i).delete()

// @function Removes and deletes excess elements from an array of boxes
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the dumping process
// @returns void
export method dump(box[] self, int max_size = 0, bool trigger = true)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size) and nz(trigger, false)
        for i = self.length() to 0
            self.remove(i).delete()

// @function Removes and deletes excess elements from an array of linefills
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the dumping process
// @param remove_line A condition to remove the associated lines when dumping linefills
// @returns void
export method dump(linefill[] self, int max_size = 0, bool trigger = true, bool remove_line = false)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size) and nz(trigger, false)
        for i = self.length() to 0
			if remove_line
				self.get(i).get_line1().delete()
				self.get(i).get_line2().delete()
				
            self.remove(i).delete()

// @function Removes and deletes excess elements from an array of chart points
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the dumping process
// @returns void
export method dump(chart.point[] self, int max_size = 0, bool trigger = true)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size) and nz(trigger, false)
        for i = self.length() to 0
            self.remove(i)

