// trim {

// @function Removes excess elements and trims an array of labels
// @param min_size The minimum size of the array
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the trimming process
// @returns void
export method trim(label[] self, int min_size = 0, int max_size = 0, bool trigger = true)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")
	if min_size < 0
		runtime.error("min_size must be equal to or greater than 0.")

    if self.ready(math.max(max_size, min_size)) and nz(trigger, false)
        for i = self.length() to math.min(min_size, self.length())
            self.remove(i).delete()

// @function Removes excess elements and trims an array of lines
// @param min_size The minimum size of the array
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the trimming process
// @returns void
export method trim(line[] self, int min_size = 0, int max_size = 0, bool trigger = true)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")
	if min_size < 0
		runtime.error("min_size must be equal to or greater than 0.")

    if self.ready(math.max(max_size, min_size)) and nz(trigger, false)
        for i = self.length() to math.min(min_size, self.length())
            self.remove(i).delete()

