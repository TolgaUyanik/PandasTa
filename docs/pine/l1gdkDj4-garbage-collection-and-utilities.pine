//@version=5

// @description Provides garbage collection utilities for managing and trimming various types of arrays, and utilities to check if an array is of a specific size. Included types are: labels, lines, polylines, boxes, linefills, chart points, floats, integers, booleans, and strings.
library("garbage_collection_and_utilities")

// length {

// @function Returns the length of an array of labels, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(label[] self)=> 
	self.size() - 1

// @function Returns the length of an array of lines, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(line[] self)=> 
	self.size() - 1

// @function Returns the length of an array of polylines, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(polyline[] self)=> 
	self.size() - 1

// @function Returns the length of an array of boxes, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(box[] self)=> 
	self.size() - 1

// @function Returns the length of an array of linefills, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(linefill[] self)=> 
	self.size() - 1

// @function Returns the length of an array of chart points, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(chart.point[] self)=> 
	self.size() - 1

// @function Returns the length of an array of floats, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(float[] self)=> 
	self.size() - 1

// @function Returns the length of an array of integers, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(int[] self)=> 
	self.size() - 1

// @function Returns the length of an array of booleans, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(bool[] self)=> 
	self.size() - 1

// @function Returns the length of an array of strings, adjusted for zero-based indexing
// @returns The length of the array, or -1 if the array is empty
export method length(string[] self)=> 
	self.size() - 1

// }

// ready {

// @function Checks if an array of labels is larger than a specified size
// @param size The minimum size of the array
// @returns A boolean indicating whether the array is ready
export method ready(label[] self, int size = 0)=> 
	if size < 0
		runtime.error("size must be equal to or greater than 0.")

	self.size() > size

// @function Checks if an array of lines is larger than a specified size
// @param size The minimum size of the array
// @returns A boolean indicating whether the array is ready
export method ready(line[] self, int size = 0)=> 
	if size < 0
		runtime.error("size must be equal to or greater than 0.")

	self.size() > size

