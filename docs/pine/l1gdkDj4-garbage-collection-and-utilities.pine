// @function Removes excess elements from the start of an array of linefills using the shift method
// @param min_size The minimum size of the array
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the shifting process
// @param remove_line A condition to remove the associated lines when shifting linefills
// @returns void
export shift_linefill_for(int min_size = 0, int max_size = 0, bool trigger = true, bool remove_line = false)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")
	if min_size < 0
		runtime.error("min_size must be equal to or greater than 0.")

	if linefill.all.ready(max_size) and nz(trigger, false)
		while linefill.all.ready(min_size)
			if remove_line
				linefill.all.first().get_line1().delete()
				linefill.all.first().get_line2().delete()

    		linefill.all.shift().delete()

// @function Removes excess elements from the start of all drawing objects using the shift method
// @param min_size The minimum size of the array
// @param max_size The maximum size of the array
// @param trigger A condition to trigger the shifting process
// @returns void
export shift_all_drawings_for(int min_size = 0, int max_size = 0, bool trigger = true, bool remove_line = false)=>
	shift_label_for(max_size, min_size, trigger)
	shift_linefill_for(max_size, min_size, trigger, remove_line)
	shift_line_for(max_size, min_size, trigger)
	shift_polyline_for(max_size, min_size, trigger)
	shift_box_for(max_size, min_size, trigger)

