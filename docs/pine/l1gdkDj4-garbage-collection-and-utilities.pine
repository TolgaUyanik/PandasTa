// pop_at {

// @function Removes and deletes the last element from an array of labels if the array is larger than a specified size
// @param max_size The maximum size of the array
// @returns void
export method pop_at(label[] self, int max_size)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size)
        self.pop().delete()

// @function Removes and deletes the last element from an array of lines if the array is larger than a specified size
// @param max_size The maximum size of the array
// @returns void
export method pop_at(line[] self, int max_size)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size)
        self.pop().delete()

// @function Removes and deletes the last element from an array of polylines if the array is larger than a specified size
// @param max_size The maximum size of the array
// @returns void
export method pop_at(polyline[] self, int max_size)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size)
        self.pop().delete()

// @function Removes and deletes the last element from an array of boxes if the array is larger than a specified size
// @param max_size The maximum size of the array
// @returns void
export method pop_at(box[] self, int max_size)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size)
        self.pop().delete()

// @function Removes and deletes the last element from an array of linefills if the array is larger than a specified size
// @param max_size The maximum size of the array
// @param remove_line A condition to remove the associated lines when popping linefills
// @returns void
export method pop_at(linefill[] self, int max_size, bool remove_line = false)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size)
		if remove_line
			self.last().get_line1().delete()
			self.last().get_line2().delete()

        self.pop().delete()

// @function Removes the last element from an array of chart points if the array is larger than a specified size
// @param max_size The maximum size of the array
// @returns void
export method pop_at(chart.point[] self, int max_size)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size)
        self.pop()

// @function Removes the last element from an array of floats if the array is larger than a specified size
// @param max_size The maximum size of the array
// @returns void
export method pop_at(float[] self, int max_size)=>
	if max_size < 0
		runtime.error("max_size must be equal to or greater than 0.")

    if self.ready(max_size)
        self.pop()

// @function Removes the last element from an array of integers if the array is larger than a specified size
// @param max_size The maximum size of the array
// @returns void
export method pop_at(int[] self, int max_size)=>
	if max_size < 0
