//@version=5

// @description : this is my personal library that is being used in different indicators and strategies
library("AminioLibrary", overlay = true)

export type hTrend
    float halfTrend
    int trend
    float atrHigh
    float atrLow
    float arrowUp
    float arrowDown

// @function This fuction returns a moving average value based on the type
// @param source Is the time series source to calculate average from
// @param len The length of the moving average, this should be integer
// @param maType The type of moving average, acceptable types are : SMA, HMA, EMA, RMA, WMA, VWMA
// @returns value of moving average
export calculateMA(series float source, simple int len, string maType) =>
    value = ta.sma(source, len)
    switch maType
        "SMA" => value := ta.sma(source, len)
        "HMA" => value := ta.hma(source, len)
        "EMA" => value := ta.ema(source, len)
        "RMA" => value := ta.rma(source, len)
        "WMA" => value := ta.wma(source, len)
        "VWMA" => value := ta.vwma(source, len)
    value

// @function This fuction returns atr value for a given source
// @param source Is the time series source to calculate atr from
// @param len The length of the atr, this should be integer
// @returns value of atr from source
export atr(series float source, simple int len) =>
    highestHigh = ta.highest(source, len)
    lowestLow = ta.lowest(source, len)
    trueRange = na(highestHigh[1]) ? highestHigh - lowestLow : math.max(highestHigh - lowestLow, math.abs(highestHigh - source[1]), math.abs(lowestLow - source[1]))
    ta.rma(trueRange, len)

// @function This fuction returns value of super trend indicator and the trend direction as a tupple
// @param source Is the time series source to calculate super trend from
// @param factor The multiplication factor for upper and lower band calcualtion, this can be a float
// @param len The length of the super trend, this should be integer
// @returns value of atr from source
export superTrend(series float source, simple float factor, simple int len) =>
    priceSource = source
    atr = atr(source, len)
    upperBand = priceSource + factor * atr
    lowerBand = priceSource - factor * atr
    prevLowerBand = nz(lowerBand[1])
    prevUpperBand = nz(upperBand[1])
    lowerBand := lowerBand > prevLowerBand or source[1] < prevLowerBand ? lowerBand : prevLowerBand
    upperBand := upperBand < prevUpperBand or source[1] > prevUpperBand ? upperBand : prevUpperBand
    int trendDirection = na
    float supperTrendValue = na
    prevSuperTrend = supperTrendValue[1]
    if (na(atr[1]))
        trendDirection := 1
    else if (prevSuperTrend == prevUpperBand)
        trendDirection := source > upperBand ? -1 : 1
    else
        trendDirection := source < lowerBand ? 1 : -1
    supperTrendValue := trendDirection == -1 ? lowerBand : upperBand
    [supperTrendValue, trendDirection]

// @function This fuction returns a hTrend type carrying different values for half trend indicator
// @param am This is the amplitude used for calcucating the half trend, use integers
// @param chdev This is the Channel Deviation value used for calculating upper and lower atr channel boundaries, you can use floats
// @returns hTrend data type
export halfTrend(int am, float chdev) =>
	var int trend = 0
    var int nextTend = 0
    var float up = 0.0
    var float down = 0.0
    var float maxLowPrice = nz(low[1], low)
    var float minHighPrice = nz(high[1], high)

    float atrHigh = 0.0
    float atrLow = 0.0
    float arrowUp = na
    float arrowDown = na

    atr = ta.atr(100) / 2
    dev = chdev * atr

    highPrice = high[math.abs(ta.highestbars(am))]
    lowPrice = low[math.abs(ta.lowestbars(am))]
    highma = ta.sma(high, am)
    lowma = ta.sma(low, am)

    if nextTend == 1
        maxLowPrice := math.max(lowPrice, maxLowPrice)

        if highma < maxLowPrice and close < nz(low[1], low)
            trend := 1
            nextTend := 0
            minHighPrice := highPrice
    else
        minHighPrice := math.min(highPrice, minHighPrice)

        if lowma > minHighPrice and close > nz(high[1], high)
            trend := 0
            nextTend := 1
            maxLowPrice := lowPrice

    if trend == 0
        if not na(trend[1]) and trend[1] != 0
            up := na(down[1]) ? down : down[1]
            arrowUp := up - atr
        else
            up := na(up[1]) ? maxLowPrice : math.max(maxLowPrice, up[1])

        atrHigh := up + dev
        atrLow := up - dev
    else
        if not na(trend[1]) and trend[1] != 1
            down := na(up[1]) ? up : up[1]
            arrowDown := down + atr
        else
            down := na(down[1]) ? minHighPrice : math.min(minHighPrice, down[1])

        atrHigh := down + dev
        atrLow := down - dev

    ht = trend == 0 ? up : down
    hTrend.new(ht, trend, atrHigh, atrLow, arrowUp, arrowDown)