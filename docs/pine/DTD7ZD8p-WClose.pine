//@version=6
library("WClose")

// Exported function: collect Wednesday closes (daily only)
export wednesdayCloses() =>
    var float[] arr = array.new_float()
    if timeframe.period == "1D" and dayofweek == dayofweek.wednesday
        array.push(arr, close)
    arr

// Internal helper: sort array ascending
sortArray(float[] _arr) =>
    array.sort(_arr, order.ascending)

// Internal helper: find index of closest value
findClosestIndex(float[] _arr, float refClose) =>
    var float minDiff = 1e10
    var int closestIdx = na
    for i = 0 to array.size(_arr) - 1
        val = array.get(_arr, i)
        diff = math.abs(val - refClose)
        if diff < minDiff
            minDiff := diff
            closestIdx := i
    closestIdx

// Exported function: get nearest 10 values (5 below, 5 above)
export nearest10(float[] _arr, float refClose) =>
    sortArray(_arr)
    idx = findClosestIndex(_arr, refClose)
    var float[] result = array.new_float()
    for i = math.max(0, idx - 5) to math.min(array.size(_arr) - 1, idx + 5)
        array.push(result, array.get(_arr, i))
    result