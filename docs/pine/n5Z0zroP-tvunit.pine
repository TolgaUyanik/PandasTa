//@version=6
// Library version: 1

// @description A simple yet powerful unit test framework for TradingView.
// This framework is designed to be easy to use and integrate with your existing scripts.
// It consists of two main parts:
// [list=1]
// [*] [b]TestSession[/b]: Manages the overall testing process and provides reports.

//   [list]
//   [*] testSession.report(): Generates a text report that can be displayed in Pine log.
//   [*] testSession.reportGui(): Generates a graphical report for superchart.
//   [/list]

// [*] [b]TestSuite[/b]: Groups related tests together.
//   [list]
//   [*] testSuite.assert(): A method to define an individual test.
//   [*] testSuite.assertWindow(): a method to define an individual over a range of bars.
//   [/list]
// [/list]
//
// For real world examples see:
// [list]
// [*] The Unit Tests section at the bottom of this file. We unit tested our unit test framework!
// [*] The Colors.UTests [Kabua] indicator, which contains over 12 suites and 100 tests.
// [*] The Utils.UTests [Kabua] indicator, which contains over 15 suites and 200 tests.
// [*] And other [Kabua] unit test indicators
// [/list]
library("tvunit")

//#region ----- Unit test Types -----------------------------------------------
//

export type TestResult
    string description
    bool   passed
    int    bar

export type TestSuite
    bool isEnabled
    string name
    string description
    TestResult[] tests

export type TestSession
    TestSuite[] suites

//#endregion


//#region ----- TestSuite Methods ---------------------------------------------
//

// @function                            Adds a test result to the test suite.
// @param this                          The (TestSuite) instance.
// @param description                   A description of the test.
// @param passed                        Whether the test passed or result.
// @param bar                           The bar index at which the test was run.
// @returns                             Whether the assertion passed or result.
export method assert(TestSuite this, string description, bool passed, int bar = bar_index) =>
    this.isEnabled := true
    this.tests.push(TestResult.new(description, passed, bar))
    passed


// @function                            Adds a test result to the test suite.
// @param this                          The (TestSuite) instance.
// @param runTests                      Whether to run the tests.
// @param description                   A description of the test.
// @param bars                          The number of bars to test.
// @param passed                        A series of boolean values indicating whether each bar passed.
// @param stopOnFirstFailure            Whether to stop on the first test failure.
// @returns                             Whether the assertion ran or not
export method assertWindow(TestSuite this, bool runTests, string description, int bars, series bool passed, bool stopOnFirstFailure = false) =>
    if runTests
        maxN = math.min(bars, bar_index + 1) - 1
        d = description + "[0.." + str.tostring(maxN) + "] "
        good = true
        failedItems = ""
        for i = 0 to maxN
            if not passed[i]
                good := false
                if failedItems == ""
                    failedItems := str.tostring(i)
                else
                    failedItems := failedItems + ", " + str.tostring(i)
            if not good and stopOnFirstFailure
                break

        if not good
            failedItems := " => [" + failedItems + "]"

        this.assert(d + failedItems, good, bar_index)
    runTests


// @function                            Returns the total number of tests in the test suite.
// @param this                          The (TestSuite) instance.
// @returns                             The total number of tests.
export method totalTests(TestSuite this) =>
    if this.isEnabled
        this.tests.size()
    else
        0


// @function                            Returns the total number of passed tests in the test suite.
// @param this                          The (TestSuite) instance.
// @returns                             The total number of passed tests.
export method passedTests(TestSuite this) =>
    int count = 0
    if this.isEnabled
        for test in this.tests
            if test.passed
                count := count + 1
    count


// @function                            Returns the total number of result tests in the test suite.
// @param this                          The (TestSuite) instance.
// @returns                             The total number of result tests.
export method failedTests(TestSuite this) =>
    int count = 0
    if this.isEnabled
        for test in this.tests
            if not test.passed
                count := count + 1
    count

//#endregion

//#region ----- TestSession Methods -------------------------------------------
//

// @function                            Creates a new test session instance.
// @returns                             A new (TestSession) instance.
export newTestSession() =>
    TestSession.new(array.new<TestSuite>())


// @function                            Creates a new test suite instance.
// @param this                          The (TestSession) instance.
// @param name                          The name of the test suite.
// @param description                   (optional) A description of the test suite.
// @returns                             A new (TestSuite) instance.
export method addNewTestSuite(TestSession this, string name, string description = na) =>
    instance = TestSuite.new(false, name, description, array.new<TestResult>())
    this.suites.push(instance)
    instance


// @function                            Creates a new test suite instance.
// @param this                          The (TestSession) instance.
// @param suite                         The (TestSuite) instance to add.
// @returns                             The (TestSession) instance.
export method add(TestSession this, TestSuite suite) =>
    this.suites.push(suite)
    this


// @function                            Returns the total number of sessions in the test session.
// @param this                          The (TestSession) instance.
// @returns                             The total number of sessions.
export method totalSuites(TestSession this) =>
    int count = 0
    for suite in this.suites
        if not suite.isEnabled
            continue
        count += 1
    count


// @function                            Returns the total number of tests in the test suite.
// @param this                          The (TestSuite) instance.
// @returns                             The total number of tests.
export method totalTests(TestSession this) =>
    int count = 0
    for suite in this.suites
        count := count + suite.totalTests()
    count


// @function                            Returns the total number of passed tests in the test suite.
// @param this                          The (TestSuite) instance.
// @returns                             The total number of passed tests.
export method passedTests(TestSession this) =>
    int count = 0
    for suite in this.suites
        count := count + suite.passedTests()
    count


// @function                            Returns the total number of result tests in the test suite.
// @param this                          The (TestSuite) instance.
// @returns                             The total number of result tests.
export method failedTests(TestSession this) =>
    int count = 0
    for suite in this.suites
        count := count + suite.failedTests()
    count

//#endregion

//#region ----- TestSession Reporting ------------------------------------------
//

// @function                            Generates a report of the test session summary that is suitable for logging.
// @param this                          The (TestSession) instance.
// @param show                          Optional: Whether to show the report or not. default: true
// @param showOnlyFailedTest            Optional: Whether to show only result tests or not. default: false
// @returns                             A formatted string report of the test suite summary.
export method report(TestSession this, bool show = true, bool showOnlyFailedTest = false) =>
    if barstate.islast and show
        strReport = "Test Session: " + "\n"
        strReport += "Total suites: " + str.format("{0,number,integer}", this.totalSuites()) + "\n"
        strReport += "Total Tests: " + str.format("{0,number,integer}", this.totalTests()) + "\n"
        strReport += "Passed Tests: " + str.format("{0,number,integer}", this.passedTests()) + "\n"
        strReport += "Failed Tests: " + str.format("{0,number,integer}", this.failedTests()) + "\n"
        strReport += "###################################\n"

        for suite in this.suites
            if not suite.isEnabled or (showOnlyFailedTest and suite.failedTests() == 0)
                continue

            strReport += "===================================\n"
            strReport += "Test Suite: " + suite.name + "\n"
            if suite.description != ""
                strReport += "Description: " + suite.description + "\n"
            strReport += "Total Tests: " + str.format("{0,number,integer}", suite.totalTests()) + "\n"
            strReport += "Passed Tests: " + str.format("{0,number,integer}", suite.passedTests()) + "\n"
            strReport += "Failed Tests: " + str.format("{0,number,integer}", suite.failedTests()) + "\n"
            strReport += "-----------------------------------\n"

            for test in suite.tests
                if showOnlyFailedTest and test.passed
                    continue

                if str.length(strReport) > 40500
                    strReport += "...Report too long, truncated...\n"
                    break

                strReport += "[" + str.tostring(test.bar) + "] " + test.description + (test.passed ? " - PASSED" : " - FAILED") + "\n"
        strReport
    else
        "Not showned"


// @function                            Generates a report of the test suite summary for the GUI.
// @param this                          The (TestSession) instance.
// @param show                          Optional: Whether to show the report or not. default: true
// @param pages                         Optional: The number of pages to show (columns). default: 4
// @param pageSize                      Optional: The number of results to show per page (rows), excluding the header. default: 5
export method reportGui(TestSession this, bool show = true, int pages = 4, int pageSize = 5) =>
    if show
        var summary = table.new(position.top_right, 4, 2, border_width=1)
        
        summary.clear(0, 0)
        summary.cell(0, 0, "Suite(s)", text_color=color.black, bgcolor=color.silver)
        summary.cell(1, 0, "Tests",    text_color=color.black, bgcolor=color.silver)
        summary.cell(2, 0, "Passed",   text_color=color.white, bgcolor=color.new(#006c00, 0))
        summary.cell(3, 0, "Failed",   text_color=color.white, bgcolor=color.new(#c40101, 0))
        summary.cell(0, 1, str.format("{0,number,integer}", this.totalSuites()), bgcolor=color.new(color.silver, 10))
        summary.cell(1, 1, str.format("{0,number,integer}", this.totalTests()),  bgcolor=color.new(color.silver, 10))
        summary.cell(2, 1, str.format("{0,number,integer}", this.passedTests()), text_color=color.white, bgcolor=color.new(color.green,  10))
        summary.cell(3, 1, str.format("{0,number,integer}", this.failedTests()), text_color=color.white, bgcolor=color.new(color.red,    10))

        if this.failedTests() > 0
            // Calculate total table capacity
            totalCapacity = pages * pageSize
            actualFailures = this.failedTests()
            
            // Count suites that have failures (each will need a header row)
            suitesWithFailures = 0
            for suite in this.suites
                if suite.isEnabled and suite.failedTests() > 0
                    suitesWithFailures += 1
            
            // Calculate space available for failed tests after accounting for suite headers
            spaceForFailedTests = math.max(0, totalCapacity - suitesWithFailures)
            failedTestsToShow = math.min(spaceForFailedTests, actualFailures)
            
            // Total items = failed tests + suite headers (will never exceed totalCapacity)
            totalItemsToShow = failedTestsToShow + suitesWithFailures
            
            // Calculate table layout: fill pageSize rows per column, then move to next column  
            columns = math.min(pages, math.max(1, math.ceil(totalItemsToShow / pageSize)))
            rows = pageSize + 1  // +1 for header row
            
            var failedTests = table.new(position.bottom_right, columns, rows, border_width=1)
            
            // Add header to each column
            for col = 0 to columns - 1
                failedTests.cell(col, 0, "Failures ([bar] description):", text_color=color.white, bgcolor=color.new(#c40101, 0))
            
            // Track current position in table
            currentCol = 0
            currentRow = 1
            failedTestsPlaced = 0  // Only count failed tests, not suite headers
            
            for suite in this.suites
                if not suite.isEnabled or suite.failedTests() == 0
                    continue

                // Always add suite header (doesn't count against pageSize limit)
                failedTests.cell(currentCol, currentRow, "Suite: " + suite.name, text_halign = text.align_left, text_color=color.white, bgcolor=color.rgb( 30, 144, 255))
                currentRow += 1
                
                // Move to next column if current column is full
                if currentRow >= rows
                    currentCol += 1
                    currentRow := 1

                for test in suite.tests
                    if not test.passed and failedTestsPlaced < failedTestsToShow
                        failedTests.cell(currentCol, currentRow, "[" + str.tostring(test.bar) + "] " + test.description, text_halign = text.align_left, text_color=color.white, bgcolor=color.new(color.red, 10))
                        currentRow += 1
                        failedTestsPlaced += 1
                        
                        // Move to next column if current column is full
                        if currentRow >= rows
                            currentCol += 1
                            currentRow := 1
    this

//#endregion

//#region ----- Utility Functions ---------------------------------------------
//

// @function                            Checks if two floating-point numbers are approximately equal within a specified tolerance.
// @param a                             The first floating-point number.
// @param b                             The second floating-point number.
// @param tolerance                     The tolerance within which the two numbers are considered equal. Default is 1e-6.
// @returns                             True if the numbers are approximately equal, false otherwise. If both are na, returns true.
export approxEqual(float a, float b, float tolerance = 1e-6) =>
    (na(a) and na(b)) or (not na(a) and not na(b) and math.abs(a - b) <= tolerance)

//#endregion

//#region ----- Unit Tests ----------------------------------------------------
//

runAllTests = input.bool(true,  "Run all tests", group="Suites")
testSma = input.bool(false,  "Run sma tests", group="Suites", active=not runAllTests)
testSignum = input.bool(false,  "Run signum tests", group="Suites", active=not runAllTests)

onlyOnLastBar = input.bool(true,  "Run only on last bar", group="Options")
stopOnFirstFailure = input.bool(false,  "Stop on first failure", group="Options")
showOnlyFailedTest = input.bool(false, "Show only failed tests", group="Options")

testSma := (testSma or runAllTests) and (onlyOnLastBar ? barstate.islast : true)
testSignum := (testSignum or runAllTests) and (onlyOnLastBar ? barstate.islast : true)


// Simple rolling-sum SMA to compare with ta.sma
mySma(series float src, int len) =>
    var float sum = na
    sum := na(sum[1]) ? src : sum[1] + src - nz(src[len])
    sum / len

signum(float x) =>
    x > 0 ? 1.0 : x < 0 ? -1.0 : 0.0

t = mySma(close, 14) == ta.sma(close, 14)

// Create multple different test results depending on various states. 
// If showOnlyFailedTest is true and onlyOnLastBar is false create two failures @ 7 and 5 
//
mySmaResult = showOnlyFailedTest and not onlyOnLastBar ? t : (bar_index == last_bar_index - 7 or bar_index == last_bar_index - 5) ? false :  t

// To fix the broken Sma tests uncomment this line.
//
// TestSma := TestSma and bar_index > 25


// Must setup the Test Session and all Test Suites ahead of time.
//
var testSession = newTestSession()
var smatests = testSession.addNewTestSuite("SMA Tests")
var signumTests = testSession.addNewTestSuite("Signum Tests")

// AssertWindows must be called on each bar
smatests.assertWindow(testSma, "mySma(close, 14)", 14, mySmaResult, stopOnFirstFailure)

if testSma
    smatests.assert("approxEqual(1, 1 + 1e-7)", approxEqual(1, 1 + 1e-7))
    smatests.assert("mySma(close, 14) == ta.sma(close, 14)", mySmaResult)

if testSignum
    signumTests.assert("signum(1)", signum(1) == 1)
    signumTests.assert("signum(-1)", signum(-1) == -1)
    signumTests.assert("signum(0)", signum(0) == 0)

if barstate.islast
    report = testSession.report(true, showOnlyFailedTest)
    log.info(report)
    testSession.reportGui(true, 4, 5)

//#endregion
