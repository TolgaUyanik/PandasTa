//@version=6
// @description Objective Market Structure Framework (OMSF): 
// @description 1. Automated Setup Classification: Assigns trades to objective market regimes, eliminating subjective "trend hunting."
// @description 2. Optimized MTF Visualization: Maps HTF structures to LTF charts using VisualStructureTools for a clutter-free workspace.
// @description 3. Developer-Centric: Enables Pine Script® coders to build and debug complex environments with high-performance, time-based structural data.
// @link https://www.tradingview.com/script/RYljd98y/
library("PriceActionStructure", overlay = true)

//@function The core analytical engine of the OMSF. Processes price action into 19 distinct structural variables.

// @param momentum_filter Enables/disables filtering of compressedion zones based on candle body size.
// @param mom_tresh Minimum candle body size relative to ATR to pass the momentum filter (e.g., 1.0).
// @param tf_close Source price for structure breaks (typically 'close').
// @param period The lookback period for ATR (used for volatility-relative swing sizing).
// @param expans_tresh Multiplier for identifying expansibution/breakout zones (e.g., 1.2 for 20% beyond range).
// @param comp_tresh Multiplier for identifying low-volatility compressedion zones (e.g., 1.5).
// @param hrg_tresh Multiplier for identifying high-volatility expansion/huge range zones (e.g., 4.0).

///@returns A tuple/structure containing: 
// - High-probability Support/Resistance levels with precise swing timestamps for MTF-safe rendering.
// - Market Phase classification (Expansion vs. Correction).
// - Structural state filters (e.g., Compression and Huge Range detection).

// @field omsf_strHigh Filtered structure high based on momentum and volatility.
// @field omsf_strHigh_time Time of the filtered structure high.
// @field omsf_strLow Filtered structure low based on momentum and volatility.
// @field omsf_strLow_time Time of the filtered structure low.
// @field peakHigh The highest price point of the current swing.
// @field peakLow The lowest price point of the current swing.
// @field upMove True if the current price movement is trending upwards.
// @field downMove True if the current price movement is trending downwards.
// @field omsfHigh The absolute (unfiltered) structural high.
// @field omsfHigh_time Time of the omsfHigh.
// @field omsfLow The absolute (unfiltered) structural low.
// @field omsfLow_time Time of the omsfLow.
// @field compressed True if the market is in a low-volatility compressedion phase.
// @field standardRange True if the market is in a normal volatility range.
// @field extended True if an expansion creates a "Huge Range".
// @field expansLong True if a bullish expansion is active.
// @field expansShort True if a bearish exppansion is active.
// @field longCorr True if a bullish correction is occurring.
// @field shortCorr True if a bearish correction is occurring.

export get_omsf_structure(bool momentum_filter, float mom_tresh, float tf_close, int period, float expans_tresh, float comp_tresh, float hrg_tresh) => 
    var float peakHigh = na, var float peakLow = na
    var float omsfHigh = na, var float omsfLow = na
    var bool upMove = false, var bool downMove = false
    var int peakHigh_time = na, var int peakLow_time = na
    var int omsfLow_time = na, var int omsfHigh_time = na
    var bool expansLong = false, var bool expansShort = false, var bool longCorr = false, var bool shortCorr = false
    var float omsf_strHigh = na, var float omsf_strLow = na, var int omsf_strHigh_time = na, var int omsf_strLow_time = na
    var float swingSize = na, bool compressed = false, bool standardRange = false, bool extended = false

    hh = tf_close > high[1], ll = tf_close < low[1]                                         
    if bar_index == 0 // --- protects for Runtime Error
        peakHigh := high, peakLow := low
    switch 
        bar_index == 1 and hh => upMove := true, peakHigh := high
        bar_index == 1 and ll => downMove := true, peakLow := low

        
    // --- Guard Clause: prevents "Error on bar 0"
    atr = ta.atr(period)
    bool is_ready = bar_index > period and not na(atr)
    //--------------------------------------------------------
    // if not enough History, returns stable initial values
    if not is_ready
        [high, time, low, time, high, low, false, false, high, time, low, time, false, false, false, false, false, false, false]


    else // --- when historical data is available
        //----------------------------------------------------------------------------------------------------------------//
        LongCandle = open < close, ShortCandle = open > close
        switch  
            LongCandle and hh and downMove => // if price direction change                    
                omsfLow := peakLow, omsfLow_time := peakLow_time
                peakHigh := high, peakHigh_time := time           
            ShortCandle and ll and upMove =>                         
                omsfHigh := peakHigh, omsfHigh_time := peakHigh_time
                peakLow := low, peakLow_time := time
        switch 
            LongCandle and hh => upMove := true, downMove := false  
            ShortCandle and ll => downMove := true, upMove := false
        switch 
            hh and high > peakHigh => peakHigh := high, peakHigh_time := time
            ll and low < peakLow => peakLow := low, peakLow_time := time
        
        //--------------------expansion & correction-----------------------------------------------------------//
        swingSize := omsfHigh - omsfLow
        switch 
            swingSize <= comp_tresh * atr => compressed := true
            swingSize > comp_tresh * atr and swingSize <= hrg_tresh * atr => standardRange := true
            swingSize > hrg_tresh * atr => extended := true
        
        //------------------------MomentumFilter for compressed Zones---------------------------------------------------//
        has_momentum = math.abs(close - open) >= atr * mom_tresh 
        not_filtered = not momentum_filter or not compressed or (compressed and has_momentum)

        switch 
            tf_close > omsfLow + expans_tresh * swingSize and not_filtered => expansLong := true, shortCorr := false, longCorr := false
            tf_close < omsfHigh - expans_tresh * swingSize and not_filtered => expansShort := true, shortCorr := false, longCorr := false
        switch 
            downMove and upMove[1] and expansLong[1] => expansLong := false, longCorr := true    
            downMove[1] and upMove and expansShort[1] => expansShort := false, shortCorr := true   
        //----------------------------------------------Structure Momentum Validation-----------------------------------------------------------------------//
        if not_filtered
            omsf_strHigh := omsfHigh, omsf_strHigh_time := omsfHigh_time, omsf_strLow := omsfLow, omsf_strLow_time := omsfLow_time

    [omsf_strHigh, omsf_strHigh_time, omsf_strLow, omsf_strLow_time, peakHigh, peakLow, upMove, downMove, omsfHigh, omsfHigh_time, omsfLow, omsfLow_time, 
         compressed, standardRange, extended, expansLong, expansShort, longCorr, shortCorr] 


//@function Calculates a structural Moving Average and dynamic bands based on the OMSF framework.
//@param period The lookback period for the smoothing (SMA).
//@param omsfHigh The current OMSF High level (e.g., from get_structure).
//@param omsfLow The current OMSF Low level (e.g., from get_structure).
//@returns A tuple [ma, upper, lower]:
// - ma: The central structural baseline (midpoint of the framework).
// - upper: The smoothed resistance boundary based on structural highs.
// - lower: The smoothed support boundary based on structural lows.

export ma(int period, float omsfHigh, float omsfLow) =>
    omsf_hl2 = (omsfHigh - omsfLow) / 2
    
    float ma = ta.sma(omsfHigh - omsf_hl2, period)
    float upper = ta.sma(omsfHigh, period)
    float lower = ta.sma(omsfLow, period)
    
    [ma, upper, lower]


// --- Educational Example & Verification ---
// This section demonstrates how to use the framework. 
// Recommendation: Compare these structural bands with a standard EMA or Bollinger Bands 
// using the same period to visualize the difference between price-based and structure-based logic.

bool  showExample = input.bool(true, "Show OMSF Example Plots?", group="Example")
int   period      = input.int(50, "Example Period", group="Example")

// Fetching the 19 variables - Extracting index 8 (High) and 10 (Low)
[_, _, _, _, _, _, _, _, omsfHigh, _, omsfLow, _, _, _, _, _, _, _, _] = get_omsf_structure(false, na, close, period, na, na, na)

// Calculate the structural Moving Average & Bands
[maVal, upper, lower] = ma(period, omsfHigh, omsfLow)

// Visualization (Only active if showExample is true)
plot(showExample ? upper : na, color=color.new(color.aqua, 20), linewidth=3, title="Upper OMSF Band")
plot(showExample ? lower : na, color=color.new(color.aqua, 20), linewidth=3, title="Lower OMSF Band")
plot(showExample ? maVal : na, color=color.new(color.blue, 50), linewidth=2, title="OMSF Structural MA")


//...
