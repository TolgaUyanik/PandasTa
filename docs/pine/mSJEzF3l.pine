// @version=5
// @description Calculates the 20-day SMA BIAS% as (Close - SMA20) / SMA20 * 100

indicator("20-Day SMA BIAS%", overlay=false)

// Calculate 20-day Simple Moving Average
sma20 = ta.sma(close, 20)

// Calculate BIAS%
bias = (close - sma20) / sma20 * 100

// Plot BIAS%
plot(bias, title="BIAS%", color=color.blue, linewidth=2)

// Add zero line for reference
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dashed)

// Plot background color based on BIAS% positive or negative
bgcolor(bias > 0 ? color.new(color.green, 90) : color.new(color.red, 90))

// Add labels for overbought/oversold thresholds (customizable)
overbought = 10
oversold = -10
plotshape(bias > overbought, style=shape.labeldown, location=location.top, color=color.red, text="Overbought", textcolor=color.white)
plotshape(bias < oversold, style=shape.labelup, location=location.bottom, color=color.green, text="Oversold", textcolor=color.white)
