//@version=5

// @description TODO: add library description here
library("LIB_SDz_Auc")
//-----------------------------
//library("PivotSDzLib", overlay = true)

//====================================================================
//  TYPE: PivotState – chứa toàn bộ trạng thái Fractal & Supply/Demand
//====================================================================
type PivotState
    float   lastPrice = na
    int     lastBar = na
    bool    isHigh = na
    line    lastLine = na
    float   currentHighPrice = na
    int     currentHighBar = na
    float   currentLowPrice = na
    int     currentLowBar = na
    bool    isCrossed = na
    line    msLine = na

    box     SupplyZone = na  // Đỏ - Kháng cự
    int     Supply_isCrossed = na  
    int     Supply_isConfirm = na  
    box     DemandZone = na  // Xanh - Hỗ trợ
    int     Demand_isCrossed = na  
    int     Demand_isConfirm = na  


//====================================================================
//  HÀM HỖ TRỢ
//====================================================================

//=== ALERT MESSAGE ===
Process_Alert(buyCond, sellCond, message = "Alert") =>
    message_Buy  = "📢 " + syminfo.ticker + " - M" + str.tostring(timeframe.period) + " : BUY SIGNAL " + message
    message_Sell = "📢 " + syminfo.ticker + " - M" + str.tostring(timeframe.period) + " : SELL SIGNAL " + message
    if buyCond
        alert("{\"content\": \"" + message_Buy + "\"}", alert.freq_once_per_bar_close)
    if sellCond
        alert("{\"content\": \"" + message_Sell + "\"}", alert.freq_once_per_bar_close)


//=== HÀM CHUYỂN STYLE LINE ===
export getLineStyle(string style) =>
    switch style
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid


//=== HÀM TÌM HIGH/LOW GẦN NHẤT ===
getHighLowAndIndex(length) =>
    var float highestHigh = na
    var int highestIndex = na
    var float lowestLow = na
    var int lowestIndex = na

    highestHigh := high
    highestIndex := bar_index
    lowestLow := low
    lowestIndex := bar_index
    
    for i = 1 to length
        if high[i] > highestHigh
            highestHigh := high[i]
            highestIndex := bar_index - i
        if low[i] < lowestLow
            lowestLow := low[i]
            lowestIndex := bar_index - i

    [highestHigh, highestIndex, lowestLow, lowestIndex]


//====================================================================
//  METHOD: Cập nhật, xử lý Pivot và Zone
//====================================================================

//=== Cập nhật state ===
method updateState(PivotState state, float price, int bar, bool high) =>
    state.lastPrice := price
    state.lastBar := bar
    state.isHigh := high


//=== Xử lý Pivot High ===
method processHighPivot(PivotState state, float price, int bar, string line_style) =>
    if state.isHigh
        if price > state.lastPrice
            if not na(state.lastLine)
                line.set_xy2(state.lastLine, x = bar, y = price)
            state.updateState(price, bar, true)
    else
        if not na(state.lastPrice)
            state.lastLine := line.new(x1 = state.lastBar, y1 = state.lastPrice,x2 = bar, y2 = price,color = color.rgb(8, 201, 127),style = getLineStyle(line_style),width = 1)
        state.updateState(price, bar, true)

    state.currentHighPrice := price
    state.currentHighBar := bar
    state.isCrossed := false


//=== Xử lý Pivot Low ===
method processLowPivot(PivotState state, float price, int bar, string line_style) =>
    if not state.isHigh
        if price < state.lastPrice
            if not na(state.lastLine)
                line.set_xy2(state.lastLine, x = bar, y = price)
            state.updateState(price, bar, false)
    else
        if not na(state.lastPrice)
            state.lastLine := line.new(x1 = state.lastBar, y1 = state.lastPrice,x2 = bar, y2 = price,color = #c94508,style = getLineStyle(line_style),width = 1)
        state.updateState(price, bar, false)

    state.currentLowPrice := price
    state.currentLowBar := bar
    state.isCrossed := false


//=== Xử lý vùng Supply/Demand ===
method Process_SDZone(PivotState state, bool Resize, color breakUp, color breakDown, string line_style) =>
    // Cross zone
    if not na(state.SupplyZone) and (high > box.get_bottom(state.SupplyZone) and high < box.get_top(state.SupplyZone)) and state.Supply_isCrossed != 2
        if Resize
            box.set_bottom(state.SupplyZone, high)
        box.set_right(state.SupplyZone, bar_index)
        box.set_bgcolor(state.SupplyZone, color.new(color.orange, 75))
        state.Supply_isCrossed := bar_index

    if not na(state.DemandZone) and (low < box.get_top(state.DemandZone) and low > box.get_bottom(state.DemandZone)) and state.Demand_isCrossed != 2
        if Resize    
            box.set_top(state.DemandZone, low)
        box.set_right(state.DemandZone, bar_index)
        box.set_bgcolor(state.DemandZone, color.new(color.blue, 75))
        state.Demand_isCrossed := bar_index

    // Fakeout
    if not na(state.SupplyZone) and (high > box.get_top(state.SupplyZone) and close < box.get_top(state.SupplyZone)) and state.Supply_isCrossed != 2
        box.set_right(state.SupplyZone, bar_index)
        box.set_bgcolor(state.SupplyZone, color.new(color.orange, 30))
        state.Supply_isCrossed := bar_index

    if not na(state.DemandZone) and (low < box.get_bottom(state.DemandZone) and close > box.get_bottom(state.DemandZone)) and state.Demand_isCrossed != 2
        box.set_right(state.DemandZone, bar_index)
        box.set_bgcolor(state.DemandZone, color.new(color.blue, 30))
        state.Demand_isCrossed := bar_index

    // Breakout
    if not na(state.SupplyZone) and close > box.get_top(state.SupplyZone) and state.Supply_isCrossed != 2
        line.new(box.get_left(state.SupplyZone), box.get_top(state.SupplyZone), bar_index, box.get_top(state.SupplyZone), color = color.green, width = 2)
        box.delete(state.SupplyZone)
        state.Supply_isCrossed := 2

    if not na(state.DemandZone) and close < box.get_bottom(state.DemandZone) and state.Demand_isCrossed != 2
        line.new(box.get_left(state.DemandZone), box.get_bottom(state.DemandZone), bar_index, box.get_bottom(state.DemandZone), color = color.red, width = 2)
        box.delete(state.DemandZone)
        state.Demand_isCrossed := 2

    // Detect new Zone
    if close > state.currentHighPrice and low < state.currentHighPrice and not state.isCrossed
        state.isCrossed := true
        state.msLine := line.new(state.currentHighBar, state.currentHighPrice, bar_index, state.currentHighPrice, color = breakUp, style = getLineStyle(line_style), width = 1)
        state.DemandZone := box.new(left = line.get_x2(state.lastLine), top = state.currentHighPrice, right = bar_index, bottom = line.get_y2(state.lastLine),bgcolor = color.new(color.green, 70), border_color = color.new(color.green, 70))
        state.Demand_isCrossed := 0

    if close < state.currentLowPrice and high > state.currentLowPrice and not state.isCrossed
        state.isCrossed := true
        state.msLine := line.new(state.currentLowBar, state.currentLowPrice, bar_index, state.currentLowPrice, color = breakDown, style = getLineStyle(line_style), width = 1)
        state.SupplyZone := box.new(left = line.get_x2(state.lastLine), top = line.get_y2(state.lastLine), right = bar_index, bottom = state.currentLowPrice, bgcolor = color.new(color.orange, 70), border_color = color.new(color.orange, 70))
        state.Supply_isCrossed := 0

    // Update realtime
    if not na(state.DemandZone) and state.Demand_isCrossed != 2
        box.set_right(state.DemandZone, bar_index + 2)
    if not na(state.SupplyZone) and state.Supply_isCrossed != 2
        box.set_right(state.SupplyZone, bar_index + 2)


//=== Hàm tổng xử lý fractal ===
method processFractals(PivotState state, bool show, bool Resize, string line_style, string line_style_break) =>
    var string prevState = na
    var int prevBarIndex = na
    bull = close > high[1] and prevState != "bull"
    bear = close < low[1]  and prevState != "bear"

    if bear and show
        prevState := "bear"
        prevBarIndex := bar_index 
        [highestHigh, highestIndex, lowestLow, lowestIndex] = getHighLowAndIndex(3)
        state.processHighPivot(highestHigh, highestIndex, line_style)

    if bull and show
        prevState := "bull"
        prevBarIndex := bar_index 
        [highestHigh, highestIndex, lowestLow, lowestIndex] = getHighLowAndIndex(3)
        state.processLowPivot(lowestLow, lowestIndex, line_style)

    state.Process_SDZone(Resize, color.green, color.red, line_style_break)
    [state, bull, bear]

