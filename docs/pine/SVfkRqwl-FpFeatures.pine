//@version=6
library("FpFeatures")

// ---------- Types ----------

export type FeatureSet
    int   buyStackCount
    int   sellStackCount
    float maxPosRowDelta
    float maxNegRowDelta
    bool  topTailUnfinished
    bool  bottomTailUnfinished
    float pocMid
    float pocShift
    float vaWidthPct
    float deltaEfficiency
    bool  acceptanceAboveVAH
    bool  acceptanceBelowVAL

// ---------- Internal helpers ----------

longestBuyStack(array<volume_row> rows) =>
    int longest = 0
    int curr = 0
    for row in rows
        if row.has_buy_imbalance()
            curr += 1
            longest := math.max(longest, curr)
        else
            curr := 0
    longest

longestSellStack(array<volume_row> rows) =>
    int longest = 0
    int curr = 0
    for row in rows
        if row.has_sell_imbalance()
            curr += 1
            longest := math.max(longest, curr)
        else
            curr := 0
    longest

scanRowDeltas(array<volume_row> rows) =>
    float maxPos = 0.0
    float maxNeg = 0.0
    for row in rows
        float d = row.delta()
        maxPos := math.max(maxPos, d)
        maxNeg := math.min(maxNeg, d)
    [maxPos, maxNeg]

tailIsUnfinished(volume_row row, float minSideVol) =>
    row.buy_volume() >= minSideVol and row.sell_volume() >= minSideVol

acceptanceAbove(float close_, float high_, float low_, float vahUpper, float frac) =>
    float rng = math.max(high_ - low_, syminfo.mintick)
    close_ > vahUpper and (high_ - vahUpper) / rng >= frac

acceptanceBelow(float close_, float high_, float low_, float valLower, float frac) =>
    float rng = math.max(high_ - low_, syminfo.mintick)
    close_ < valLower and (valLower - low_) / rng >= frac

// ---------- Exported point functions ----------

export buyStackCount(array<volume_row> rows) =>
    longestBuyStack(rows)

export sellStackCount(array<volume_row> rows) =>
    longestSellStack(rows)

export maxRowDeltas(array<volume_row> rows) =>
    scanRowDeltas(rows)

export pocMid(footprint fp) =>
    volume_row poc = fp.poc()
    (poc.up_price() + poc.down_price()) * 0.5

export pocShift(footprint fp, float prevPocMid) =>
    float curr = pocMid(fp)
    na(prevPocMid) ? na : curr - prevPocMid

export vaWidthPct(footprint fp, float close_) =>
    volume_row vah = fp.vah()
    volume_row val = fp.val()
    close_ == 0.0 ? na : (vah.up_price() - val.down_price()) / close_

export deltaEfficiency(footprint fp) =>
    float total = fp.total_volume()
    total <= 0.0 ? 0.0 : math.abs(fp.delta()) / total

export topTailUnfinished(footprint fp, float minSideVol) =>
    array<volume_row> rows = fp.rows()
    int n = array.size(rows)
    n == 0 ? false : tailIsUnfinished(array.get(rows, n - 1), minSideVol)

export bottomTailUnfinished(footprint fp, float minSideVol) =>
    array<volume_row> rows = fp.rows()
    int n = array.size(rows)
    n == 0 ? false : tailIsUnfinished(array.get(rows, 0), minSideVol)

export acceptanceAboveVAH(footprint fp, float close_, float high_, float low_, float frac) =>
    volume_row vah = fp.vah()
    acceptanceAbove(close_, high_, low_, vah.up_price(), frac)

export acceptanceBelowVAL(footprint fp, float close_, float high_, float low_, float frac) =>
    volume_row val = fp.val()
    acceptanceBelow(close_, high_, low_, val.down_price(), frac)

// ---------- Main bundle ----------

export compute(
    footprint fp,
    float close_,
    float high_,
    float low_,
    float prevPocMid,
    float minTailSideVol,
    float acceptanceFrac
) =>
    array<volume_row> rows = fp.rows()

    int buyStacks = longestBuyStack(rows)
    int sellStacks = longestSellStack(rows)
    
    // Removed 'float' from inside brackets to fix syntax error
    [maxPos, maxNeg] = scanRowDeltas(rows)

    volume_row poc = fp.poc()
    volume_row vah = fp.vah()
    volume_row val = fp.val()

    float currPocMid = (poc.up_price() + poc.down_price()) * 0.5
    float currPocShift = na(prevPocMid) ? na : currPocMid - prevPocMid
    float currVaWidthPct = close_ == 0.0 ? na : (vah.up_price() - val.down_price()) / close_
    float total = fp.total_volume()
    float currDeltaEfficiency = total <= 0.0 ? 0.0 : math.abs(fp.delta()) / total

    int n = array.size(rows)
    bool topUF = n == 0 ? false : tailIsUnfinished(array.get(rows, n - 1), minTailSideVol)
    bool botUF = n == 0 ? false : tailIsUnfinished(array.get(rows, 0), minTailSideVol)

    bool accAbove = acceptanceAbove(close_, high_, low_, vah.up_price(), acceptanceFrac)
    bool accBelow = acceptanceBelow(close_, high_, low_, val.down_price(), acceptanceFrac)

    FeatureSet.new(
         buyStacks,
         sellStacks,
         maxPos,
         maxNeg,
         topUF,
         botUF,
         currPocMid,
         currPocShift,
         currVaWidthPct,
         currDeltaEfficiency,
         accAbove,
         accBelow
     )