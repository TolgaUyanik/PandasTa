//@version=6
indicator("Institutional Breakouts Channel", "IBC", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ============================================================================
// 01 | INPUTS
// ============================================================================
gCH   = "① Institutional Channel"
gRNG  = "② Compression / Range Engine"
gBO   = "③ Breakout Engine"
gSIG  = "④ Signals & Exits"
gLIQ  = "⑤ Liquidity & Structure"
gHTF  = "⑥ Higher Timeframe"
gDSH  = "⑦ Dashboard"
gSTY  = "⑧ Style & Colors"

// --- Channel ---------------------------------------------------------------
showChannel = input.bool(true,  "Show Institutional Channel",           group = gCH)
chanLen     = input.int(34,     "Channel Length",        minval = 5,    group = gCH)
atrLen      = input.int(14,     "ATR Length",            minval = 2,    group = gCH)
atrMult     = input.float(2.0,  "ATR Multiplier",        minval = 0.2, step = 0.1, group = gCH)
emaLen      = input.int(50,     "EMA Length",            minval = 2,    group = gCH)
momLen      = input.int(14,     "Momentum Length",       minval = 2,    group = gCH)
adaptOn     = input.bool(true,  "Adaptive Smoothing (Efficiency Ratio)", group = gCH)

// --- Range / Compression ---------------------------------------------------
showRanges  = input.bool(true,  "Show Compression Boxes",               group = gRNG)
rangeLen    = input.int(20,     "Range Detection Length", minval = 5,   group = gRNG)
compSens    = input.float(1.6,  "Compression Sensitivity (× ATR)", minval = 0.3, step = 0.1, group = gRNG)
minRngBars  = input.int(8,      "Min Range Bars",         minval = 2,   group = gRNG)
maxRngBars  = input.int(300,    "Max Range Bars",         minval = 20,  group = gRNG)
edgePct     = input.float(15.0, "Edge Zone Size (%)",     minval = 2, maxval = 45, step = 1, group = gRNG)
maxRanges   = input.int(40,     "Max Stored Ranges",      minval = 5, maxval = 120, group = gRNG)

// --- Breakout --------------------------------------------------------------
boSens      = input.float(0.10, "Breakout Buffer (× ATR)", minval = 0.0, step = 0.05, group = gBO)
minScore    = input.int(55,     "Min Breakout Quality Score", minval = 0, maxval = 100, group = gBO)
retestBars  = input.int(30,     "Retest Window (bars)",   minval = 3,   group = gBO)
retestDist  = input.float(0.50, "Retest Distance (× ATR)", minval = 0.05, step = 0.05, group = gBO)
falseBars   = input.int(10,     "False Breakout Window (bars)", minval = 2, group = gBO)
zoneExtend  = input.int(25,     "Breakout Zone Extension (bars)", minval = 0, group = gBO)

// --- Signals ---------------------------------------------------------------
showSignals = input.bool(true,  "Show Buy / Sell Signals",              group = gSIG)
requireRT   = input.bool(false, "Require Retest Before Signal",         group = gSIG)
showExits   = input.bool(true,  "Show Exit Signals",                    group = gSIG)
showBOLbl   = input.bool(true,  "Show Breakout / Retest Labels",        group = gSIG)
waitClose   = input.bool(true,  "Confirm On Bar Close (No Repaint)",    group = gSIG)
sigSizeIn   = input.string("Small", "Signal Size", options = ["Tiny", "Small", "Normal", "Large"], group = gSIG)

// --- Liquidity / Structure -------------------------------------------------
showLiq     = input.bool(true,  "Show Liquidity Sweeps",                group = gLIQ)
showSR      = input.bool(true,  "Show Adaptive Support / Resistance",   group = gLIQ)
swingLen    = input.int(10,     "Swing Length",           minval = 2,   group = gLIQ)
eqTol       = input.float(0.15, "Equal High/Low Tolerance (× ATR)", minval = 0.01, step = 0.01, group = gLIQ)

// --- HTF -------------------------------------------------------------------
useHTF      = input.bool(true,  "Use Higher Timeframe Confirmation",    group = gHTF)
htfTF       = input.timeframe("240", "Higher Timeframe",                group = gHTF)
htfClosed   = input.bool(true,  "Use Closed HTF Bars Only",             group = gHTF)

// --- Dashboard -------------------------------------------------------------
showDash    = input.bool(true,  "Show Dashboard",                       group = gDSH)
dashPosIn   = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = gDSH)
dashSizeIn  = input.string("Small", "Font Size", options = ["Tiny", "Small", "Normal"], group = gDSH)

// --- Style -----------------------------------------------------------------
bullCol     = input.color(#089981, "Bullish Color",                     group = gSTY)
bearCol     = input.color(#f23645, "Bearish Color",                     group = gSTY)
neutCol     = input.color(#787b86, "Neutral Color",                     group = gSTY)
zoneTransp  = input.int(72,     "Zone Opacity (transparency)", minval = 0, maxval = 95, group = gSTY)
boxTransp   = input.int(90,     "Range Box Transparency",  minval = 0, maxval = 98, group = gSTY)
lineW       = input.int(2,      "Channel Line Width",      minval = 1, maxval = 4, group = gSTY)

szTiny   = sigSizeIn == "Tiny"
szSmall  = sigSizeIn == "Small"
szNormal = sigSizeIn == "Normal"
szLarge  = sigSizeIn == "Large"
dashSize = dashSizeIn == "Tiny" ? size.tiny : dashSizeIn == "Small" ? size.small : size.normal
dashPos  = dashPosIn == "Top Right" ? position.top_right : dashPosIn == "Top Left" ? position.top_left : dashPosIn == "Bottom Right" ? position.bottom_right : dashPosIn == "Bottom Left" ? position.bottom_left : position.middle_right

// ============================================================================
// 02 | HELPER FUNCTIONS
// ============================================================================
f_norm(float x, float lo, float hi) =>
    hi == lo ? 50.0 : math.max(0.0, math.min(100.0, (x - lo) / (hi - lo) * 100.0))

f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

f_pruneBox(array<box> a, int maxN) =>
    while array.size(a) > maxN
        box.delete(array.shift(a))

f_pruneLine(array<line> a, int maxN) =>
    while array.size(a) > maxN
        line.delete(array.shift(a))

f_pruneLabel(array<label> a, int maxN) =>
    while array.size(a) > maxN
        label.delete(array.shift(a))

var array<box>   boxStore = array.new<box>()
var array<line>  lineStore = array.new<line>()
var array<label> lblStore = array.new<label>()

// ============================================================================
// 03 | CORE CALCULATIONS  (volatility, adaptive baseline, channel)
// ============================================================================
atrv  = ta.atr(atrLen)
atrv  := na(atrv) or atrv <= 0 ? syminfo.mintick * 10 : atrv

emaF  = ta.ema(close, emaLen)
emaS  = ta.ema(close, emaLen * 2)

// Price efficiency (net move / total path) -> adaptive smoothing constant
netMove = math.abs(close - close[chanLen])
pathLen = math.sum(math.abs(close - close[1]), chanLen)
effRat  = pathLen > 0 ? netMove / pathLen : 0.0

fastSC = 2.0 / (2.0 + 1.0)
slowSC = 2.0 / (30.0 + 1.0)
smConst = adaptOn ? math.pow(effRat * (fastSC - slowSC) + slowSC, 2) : 2.0 / (chanLen + 1.0)

var float base = na
base := na(base[1]) ? close : base[1] + smConst * (close - base[1])

// Volatility regime -> channel breathes with the market
volNow  = ta.stdev(close, chanLen)
volAvg  = ta.sma(volNow, chanLen * 3)
volRat  = f_clamp(nz(volNow / volAvg, 1.0), 0.5, 2.2)
chWidth = atrv * atrMult * volRat

chMid = base
chUp  = chMid + chWidth
chDn  = chMid - chWidth

chExpanding  = chWidth > chWidth[3]
chCompress   = chWidth < chWidth[3]

// ============================================================================
// 04 | TREND ENGINE
// ============================================================================
sl1 = (base - base[5]) / atrv
mom = (close - close[momLen]) / atrv
[diP, diM, adxV] = ta.dmi(14, 14)
posInCh = f_clamp((close - chDn) / math.max(chUp - chDn, syminfo.mintick), 0.0, 1.0)

t1 = close > base ? 1.0 : -1.0
t2 = emaF > emaS ? 1.0 : -1.0
t3 = f_clamp(sl1 * 2.0, -1.0, 1.0)
t4 = f_clamp(mom / 2.0, -1.0, 1.0)
t5 = (diP > diM ? 1.0 : -1.0) * math.min(1.0, nz(adxV, 0) / 40.0)
t6 = (posInCh - 0.5) * 2.0

trendScore = t1 * 15 + t2 * 15 + t3 * 20 + t4 * 20 + t5 * 15 + t6 * 15   // -100 .. +100

trendTxt = trendScore >= 55 ? "STRONG BULLISH" : trendScore >= 18 ? "BULLISH" : trendScore <= -55 ? "STRONG BEARISH" : trendScore <= -18 ? "BEARISH" : "NEUTRAL"
trendCol = trendScore >= 18 ? bullCol : trendScore <= -18 ? bearCol : neutCol
isBull   = trendScore >= 18
isBear   = trendScore <= -18

// ============================================================================
// 05 | MOMENTUM ENGINE
// ============================================================================
rsiV   = ta.rsi(close, momLen)
momAbs = math.abs(mom) + math.abs(rsiV - 50) / 25.0
momTxt = momAbs >= 3.0 ? "EXTREME" : momAbs >= 1.9 ? "STRONG" : momAbs >= 0.9 ? "MODERATE" : "WEAK"
momCol = mom > 0 ? bullCol : mom < 0 ? bearCol : neutCol
momPct = f_clamp(momAbs / 4.0 * 100.0, 0.0, 100.0)

// ============================================================================
// 06 | STRUCTURE, ADAPTIVE S/R AND LIQUIDITY
// ============================================================================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

var float sHigh1 = na
var float sHigh2 = na
var float sLow1  = na
var float sLow2  = na

if not na(ph)
    sHigh2 := sHigh1
    sHigh1 := ph
if not na(pl)
    sLow2 := sLow1
    sLow1 := pl

structBull = not na(sHigh1) and not na(sHigh2) and not na(sLow1) and not na(sLow2) and sHigh1 > sHigh2 and sLow1 > sLow2
structBear = not na(sHigh1) and not na(sHigh2) and not na(sLow1) and not na(sLow2) and sHigh1 < sHigh2 and sLow1 < sLow2
structTxt  = structBull ? "HH / HL" : structBear ? "LH / LL" : "MIXED"

resLvl = na(sHigh1) ? na : sHigh1
supLvl = na(sLow1)  ? na : sLow1

eqHigh = not na(sHigh1) and not na(sHigh2) and math.abs(sHigh1 - sHigh2) <= atrv * eqTol
eqLow  = not na(sLow1)  and not na(sLow2)  and math.abs(sLow1  - sLow2)  <= atrv * eqTol

sweepHigh = not na(sHigh1) and high > sHigh1 and close < sHigh1 and close < open
sweepLow  = not na(sLow1)  and low  < sLow1  and close > sLow1  and close > open

// ============================================================================
// 07 | HIGHER TIMEFRAME CONFIRMATION
// ============================================================================
htfEmaSrc = ta.ema(close, emaLen)
htfMomSrc = close - close[momLen]
[hEma, hClose, hMom] = request.security(syminfo.tickerid, htfTF, [htfEmaSrc, close, htfMomSrc], lookahead = barmerge.lookahead_off)

hEmaU   = htfClosed ? hEma[1]   : hEma
hCloseU = htfClosed ? hClose[1] : hClose
hMomU   = htfClosed ? hMom[1]   : hMom

htfBull = not na(hEmaU) and hCloseU > hEmaU and nz(hMomU) > 0
htfBear = not na(hEmaU) and hCloseU < hEmaU and nz(hMomU) < 0
htfTxt  = not useHTF ? "OFF" : htfBull ? "BULLISH" : htfBear ? "BEARISH" : "NEUTRAL"
htfCol  = not useHTF ? neutCol : htfBull ? bullCol : htfBear ? bearCol : neutCol

// ============================================================================
// 08 | COMPRESSION / RANGE ENGINE  (institutional accumulation boxes)
// ============================================================================
hh    = ta.highest(high, rangeLen)
ll    = ta.lowest(low,  rangeLen)
rngW  = hh - ll
compressed = rngW <= atrv * compSens

var bool  inRange = false
var float rTop    = na
var float rBot    = na
var int   rLeft   = 0
var box   bxMain  = na
var box   bxUp    = na
var box   bxDn    = na
var line  lnMid   = na
var int   rEnd    = 0

bool  bullBreak = false
bool  bearBreak = false
float brkLevel  = na
int   rngDur    = 0

confirmed = not waitClose or barstate.isconfirmed

if not inRange
    if compressed and bar_index > rangeLen + 5 and (bar_index - rEnd) > math.round(rangeLen / 2) and hh > ll
        inRange := true
        rTop    := hh
        rBot    := ll
        rLeft   := bar_index - rangeLen + 1
        if showRanges
            edge  = math.max((rTop - rBot) * (edgePct / 100.0), syminfo.mintick)
            bxMain := box.new(rLeft, rTop, bar_index, rBot, border_color = color.new(neutCol, 55), border_width = 1, bgcolor = color.new(neutCol, boxTransp))
            bxUp   := box.new(rLeft, rTop, bar_index, rTop - edge, border_color = color.new(bearCol, 75), border_width = 1, bgcolor = color.new(bearCol, zoneTransp))
            bxDn   := box.new(rLeft, rBot + edge, bar_index, rBot, border_color = color.new(bullCol, 75), border_width = 1, bgcolor = color.new(bullCol, zoneTransp))
            lnMid  := line.new(rLeft, math.avg(rTop, rBot), bar_index, math.avg(rTop, rBot), color = color.new(bearCol, 35), style = line.style_dashed, width = 1)
            array.push(boxStore, bxMain)
            array.push(boxStore, bxUp)
            array.push(boxStore, bxDn)
            array.push(lineStore, lnMid)
            f_pruneBox(boxStore, maxRanges * 3)
            f_pruneLine(lineStore, maxRanges)
else
    if showRanges and not na(bxMain)
        box.set_right(bxMain, bar_index)
        box.set_right(bxUp,   bar_index)
        box.set_right(bxDn,   bar_index)
        line.set_x2(lnMid, bar_index)
    rngDur := bar_index - rLeft
    buf = atrv * boSens
    if close > rTop + buf
        inRange   := false
        rEnd      := bar_index
        bullBreak := rngDur >= minRngBars
        brkLevel  := rTop
        if showRanges and not na(bxUp)
            box.set_right(bxUp, bar_index + zoneExtend)
    else if close < rBot - buf
        inRange   := false
        rEnd      := bar_index
        bearBreak := rngDur >= minRngBars
        brkLevel  := rBot
        if showRanges and not na(bxDn)
            box.set_right(bxDn, bar_index + zoneExtend)
    else if rngDur > maxRngBars
        inRange := false
        rEnd    := bar_index

// Breakout pressure (0-100): builds while price coils, releases on expansion
bwATR     = rngW / atrv
basePress = 100.0 * f_clamp(1.0 - bwATR / (compSens * 2.5), 0.0, 1.0)
durBonus  = inRange ? math.min(20.0, (bar_index - rLeft) * 0.6) : 0.0
pressure  = f_clamp(basePress + durBonus, 0.0, 100.0)

pressPrev = nz(pressure[1], 50.0)

// ============================================================================
// 09 | BREAKOUT QUALITY SCORE (0 - 100)
// ============================================================================
cumVol   = ta.cum(nz(volume))
hasVol   = not na(volume) and cumVol > 0
volAvg20 = ta.sma(nz(volume), 20)
volRatio = hasVol and volAvg20 > 0 ? volume / volAvg20 : na

atrExp   = atrv / math.max(ta.sma(atrv, 50), syminfo.mintick)
candRng  = (high - low) / atrv
bodyRat  = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0.0
speed    = math.abs(close - close[3]) / atrv
distUp   = (close - chUp) / atrv
distDn   = (chDn - close) / atrv

f_score(bool up) =>
    s1  = f_norm(up ? trendScore : -trendScore, -20, 90)                 // trend strength
    s2  = f_norm(atrExp, 0.8, 1.8)                                       // ATR expansion
    s3  = f_norm(up ? mom : -mom, 0.0, 2.5)                              // momentum
    s4  = f_norm(candRng, 0.5, 2.2)                                      // breakout candle size
    s5  = f_norm(bodyRat, 0.3, 0.85)                                     // conviction of the candle
    s6  = na(volRatio) ? 50.0 : f_norm(volRatio, 0.7, 2.2)               // volume (neutral when absent)
    s7  = f_norm(speed, 0.5, 3.0)                                        // breakout speed
    s8  = f_norm(up ? distUp : distDn, -0.6, 1.2)                        // distance from channel
    s9  = (up ? (emaF > emaS) : (emaF < emaS)) ? 100.0 : 25.0            // EMA agreement
    s10 = (up ? structBull : structBear) ? 100.0 : (structBull or structBear) ? 20.0 : 55.0
    s11 = not useHTF ? 55.0 : (up ? htfBull : htfBear) ? 100.0 : (up ? htfBear : htfBull) ? 10.0 : 50.0
    s12 = f_norm(pressPrev, 25, 95)                                    // stored compression energy
    (s1 * 14 + s2 * 9 + s3 * 12 + s4 * 8 + s5 * 7 + s6 * 6 + s7 * 8 + s8 * 7 + s9 * 8 + s10 * 8 + s11 * 8 + s12 * 5) / 100.0

bullScore = f_score(true)
bearScore = f_score(false)

// ============================================================================
// 10 | BREAKOUT STATE : classification, retest, false breakout
// ============================================================================
var int   boBar   = na
var int   boDir   = 0
var float boLvl   = na
var float boScore = na
var bool  boRetest = false
var bool  boFalse  = false
var string boState = "—"

bool retestNow = false
bool falseNow  = false

if (bullBreak or bearBreak) and confirmed
    boBar    := bar_index
    boDir    := bullBreak ? 1 : -1
    boLvl    := brkLevel
    boScore  := bullBreak ? bullScore : bearScore
    boRetest := false
    boFalse  := false
    boState  := boScore >= 80 ? "EXPLOSIVE" : boScore >= minScore ? "STRONG" : boScore >= 40 ? "WEAK" : "LOW QUALITY"

barsSinceBO = na(boBar) ? na : bar_index - boBar

if not na(boBar) and boDir != 0 and not boFalse
    if barsSinceBO > 0 and barsSinceBO <= falseBars
        if boDir == 1 and close < boLvl - atrv * boSens
            boFalse := true
            falseNow := true
            boState := "FALSE BREAKOUT"
        if boDir == -1 and close > boLvl + atrv * boSens
            boFalse := true
            falseNow := true
            boState := "FALSE BREAKOUT"
    if not boFalse and not boRetest and barsSinceBO > 0 and barsSinceBO <= retestBars
        if boDir == 1 and low <= boLvl + atrv * retestDist and close > boLvl and close > open
            boRetest := true
            retestNow := true
        if boDir == -1 and high >= boLvl - atrv * retestDist and close < boLvl and close < open
            boRetest := true
            retestNow := true

contBull = boDir == 1 and not boFalse and barsSinceBO > 0 and barsSinceBO <= retestBars and close > boLvl + atrv * 1.5 and close > close[1]
contBear = boDir == -1 and not boFalse and barsSinceBO > 0 and barsSinceBO <= retestBars and close < boLvl - atrv * 1.5 and close < close[1]

// ============================================================================
// 11 | SIGNAL LOGIC (Buy / Sell / Exit)
// ============================================================================
resFar = na(resLvl) or resLvl <= close or (resLvl - close) > atrv * 0.8
supFar = na(supLvl) or supLvl >= close or (close - supLvl) > atrv * 0.8

htfOkBull = not useHTF or not htfBear
htfOkBear = not useHTF or not htfBull

buyReady  = trendScore > 10 and mom > 0 and chExpanding and resFar and htfOkBull
sellReady = trendScore < -10 and mom < 0 and chExpanding and supFar and htfOkBear

buySignal  = showSignals and confirmed and (requireRT ? (retestNow and boDir == 1 and nz(boScore) >= minScore) : (bullBreak and bullScore >= minScore)) and buyReady and not boFalse
sellSignal = showSignals and confirmed and (requireRT ? (retestNow and boDir == -1 and nz(boScore) >= minScore) : (bearBreak and bearScore >= minScore)) and sellReady and not boFalse

var int posState = 0
var string lastSigTxt = "—"

crossDnBase = ta.crossunder(close, base)
crossUpBase = ta.crossover(close, base)

exitLong  = posState ==  1 and confirmed and (crossDnBase or trendScore < -10 or bearBreak or (chCompress and mom < 0))
exitShort = posState == -1 and confirmed and (crossUpBase or trendScore >  10 or bullBreak or (chCompress and mom > 0))

if buySignal
    posState := 1
    lastSigTxt := "BUY @ " + str.tostring(close, format.mintick)
else if sellSignal
    posState := -1
    lastSigTxt := "SELL @ " + str.tostring(close, format.mintick)
else if exitLong or exitShort
    posState := 0

// ============================================================================
// 12 | PLOTS : channel
// ============================================================================
envCol = isBull ? bullCol : isBear ? bearCol : neutCol

pU = plot(showChannel ? chUp  : na, "Institutional Resistance", color = color.new(envCol, 15), linewidth = lineW)
pM = plot(showChannel ? chMid : na, "Institutional Equilibrium", color = color.new(envCol, 45), linewidth = 1, style = plot.style_line)
pD = plot(showChannel ? chDn  : na, "Institutional Support",    color = color.new(envCol, 15), linewidth = lineW)
fill(pU, pD, color = color.new(envCol, 92), title = "Channel Fill")

plot(showSR and not na(resLvl) ? resLvl : na, "Adaptive Resistance", color = color.new(bearCol, 45), style = plot.style_circles, linewidth = 1)
plot(showSR and not na(supLvl) ? supLvl : na, "Adaptive Support",    color = color.new(bullCol, 45), style = plot.style_circles, linewidth = 1)

// ============================================================================
// 13 | PLOTS : signals & labels
// ============================================================================
plotshape(buySignal and szTiny,   "Buy Signal (Tiny)",   shape.triangleup, location.belowbar, color.new(bullCol, 0), size = size.tiny)
plotshape(buySignal and szSmall,  "Buy Signal (Small)",  shape.triangleup, location.belowbar, color.new(bullCol, 0), size = size.small)
plotshape(buySignal and szNormal, "Buy Signal (Normal)", shape.triangleup, location.belowbar, color.new(bullCol, 0), size = size.normal)
plotshape(buySignal and szLarge,  "Buy Signal (Large)",  shape.triangleup, location.belowbar, color.new(bullCol, 0), size = size.large)

plotshape(sellSignal and szTiny,   "Sell Signal (Tiny)",   shape.triangledown, location.abovebar, color.new(bearCol, 0), size = size.tiny)
plotshape(sellSignal and szSmall,  "Sell Signal (Small)",  shape.triangledown, location.abovebar, color.new(bearCol, 0), size = size.small)
plotshape(sellSignal and szNormal, "Sell Signal (Normal)", shape.triangledown, location.abovebar, color.new(bearCol, 0), size = size.normal)
plotshape(sellSignal and szLarge,  "Sell Signal (Large)",  shape.triangledown, location.abovebar, color.new(bearCol, 0), size = size.large)

plotshape(showExits and exitLong,  "Exit Long",  shape.xcross, location.abovebar, color.new(bearCol, 25), size = size.tiny, text = "Exit L", textcolor = color.new(bearCol, 0))
plotshape(showExits and exitShort, "Exit Short", shape.xcross, location.belowbar, color.new(bullCol, 25), size = size.tiny, text = "Exit S", textcolor = color.new(bullCol, 0))

plotshape(showLiq and sweepHigh, "Sell-Side Sweep", shape.diamond, location.abovebar, color.new(bearCol, 45), size = size.tiny)
plotshape(showLiq and sweepLow,  "Buy-Side Sweep",  shape.diamond, location.belowbar, color.new(bullCol, 45), size = size.tiny)

f_tag(string txt, bool up, color c) =>
    lb = label.new(bar_index, up ? high : low, txt, style = up ? label.style_label_down : label.style_label_up, color = color.new(c, 12), textcolor = color.white, size = size.tiny)
    array.push(lblStore, lb)
    f_pruneLabel(lblStore, 120)

if showBOLbl and confirmed
    if bullBreak
        f_tag("BREAKOUT  " + str.tostring(math.round(bullScore)) + "/100" + (hasVol ? "  ·  Vol " + str.tostring(math.round(nz(volRatio, 0) * 100)) + "%" : ""), true, bullCol)
    if bearBreak
        f_tag("BREAKDOWN  " + str.tostring(math.round(bearScore)) + "/100" + (hasVol ? "  ·  Vol " + str.tostring(math.round(nz(volRatio, 0) * 100)) + "%" : ""), false, bearCol)
    if retestNow
        f_tag("Retest Confirmed", boDir == -1, boDir == 1 ? bullCol : bearCol)
    if falseNow
        f_tag("False Breakout", boDir == 1, color.new(#ff9800, 0))

// ============================================================================
// 14 | DASHBOARD
// ============================================================================
f_bar(float v) =>
    filled = math.round(f_clamp(v, 0, 100) / 10)
    out = ""
    for i = 1 to 10
        out := out + (i <= filled ? "█" : "░")
    out

instBias   = trendScore * 0.5 + (posInCh - 0.5) * 60 + (useHTF ? (htfBull ? 15 : htfBear ? -15 : 0) : 0)
biasTxt    = instBias >= 30 ? "ACCUMULATION" : instBias <= -30 ? "DISTRIBUTION" : "BALANCED"
biasCol    = instBias >= 30 ? bullCol : instBias <= -30 ? bearCol : neutCol
chStatus   = inRange ? "COMPRESSED" : chExpanding ? "EXPANDING" : "CONTRACTING"
overall    = f_clamp((math.abs(trendScore) * 0.35 + momPct * 0.25 + nz(boScore, 50) * 0.20 + pressure * 0.20), 0, 100)
riskATR    = atrv * 1.5

var table dash = table.new(dashPos, 2, 19, border_width = 1, border_color = color.new(neutCol, 70), frame_width = 1, frame_color = color.new(neutCol, 60))

f_row(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = color.new(neutCol, 10), text_size = dashSize, text_halign = text.align_left,  bgcolor = color.new(#131722, 25))
    table.cell(dash, 1, r, v, text_color = c,                      text_size = dashSize, text_halign = text.align_right, bgcolor = color.new(#131722, 25))

if showDash and barstate.islast
    table.cell(dash, 0, 0, "INSTITUTIONAL BREAKOUTS CHANNEL", text_color = color.white, text_size = dashSize, bgcolor = color.new(envCol, 35))
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.white, text_size = dashSize, bgcolor = color.new(envCol, 35))
    f_row(1,  "Institutional Bias", biasTxt, biasCol)
    f_row(2,  "Trend",              trendTxt, trendCol)
    f_row(3,  "Trend Strength",     f_bar(math.abs(trendScore)) + " " + str.tostring(math.round(math.abs(trendScore))), trendCol)
    f_row(4,  "Momentum",           momTxt + " (" + (mom > 0 ? "+" : "") + str.tostring(mom, "#.##") + ")", momCol)
    f_row(5,  "Breakout Score",     na(boScore) ? "—" : f_bar(boScore) + " " + str.tostring(math.round(boScore)), na(boScore) ? neutCol : boScore >= minScore ? bullCol : neutCol)
    f_row(6,  "Breakout State",     boState, boState == "FALSE BREAKOUT" ? color.new(#ff9800, 0) : boDir == 1 ? bullCol : boDir == -1 ? bearCol : neutCol)
    f_row(7,  "Breakout Pressure",  f_bar(pressure) + " " + str.tostring(math.round(pressure)), pressure >= 70 ? color.new(#ff9800, 0) : neutCol)
    f_row(8,  "Channel Status",     chStatus, inRange ? neutCol : chExpanding ? envCol : neutCol)
    f_row(9,  "Volatility (ATR)",   str.tostring(atrv, format.mintick) + "  ·  " + str.tostring(math.round(atrExp * 100)) + "%", neutCol)
    f_row(10, "Market Structure",   structTxt, structBull ? bullCol : structBear ? bearCol : neutCol)
    f_row(11, "Resistance",         na(resLvl) ? "—" : str.tostring(resLvl, format.mintick), bearCol)
    f_row(12, "Support",            na(supLvl) ? "—" : str.tostring(supLvl, format.mintick), bullCol)
    f_row(13, "Higher TF (" + htfTF + ")", htfTxt, htfCol)
    f_row(14, "Last Signal",        lastSigTxt, posState == 1 ? bullCol : posState == -1 ? bearCol : neutCol)
    f_row(15, "Last Retest",        na(boBar) ? "—" : (boRetest ? "Confirmed (" + str.tostring(barsSinceBO) + " bars ago)" : "Pending"), boRetest ? bullCol : neutCol)
    f_row(16, "Risk (1.5×ATR)",     str.tostring(riskATR, format.mintick), neutCol)
    f_row(17, "Liquidity",          eqHigh ? "Equal Highs Above" : eqLow ? "Equal Lows Below" : sweepHigh ? "SSL Swept" : sweepLow ? "BSL Swept" : "Clean", eqHigh ? bearCol : eqLow ? bullCol : neutCol)
    f_row(18, "OVERALL SCORE",      f_bar(overall) + " " + str.tostring(math.round(overall)) + "/100", overall >= 65 ? envCol : neutCol)

// ============================================================================
// 15 | ALERTS
// ============================================================================
alertcondition(bullBreak,                       "Bullish Breakout",   "IBC: Bullish institutional breakout on {{ticker}} {{interval}}")
alertcondition(bearBreak,                       "Bearish Breakout",   "IBC: Bearish institutional breakdown on {{ticker}} {{interval}}")
alertcondition(falseNow,                        "False Breakout",     "IBC: False breakout detected on {{ticker}} {{interval}}")
alertcondition(retestNow,                       "Retest Confirmed",   "IBC: Breakout retest confirmed on {{ticker}} {{interval}}")
alertcondition(buySignal,                       "Buy Signal",         "IBC: BUY signal on {{ticker}} {{interval}} @ {{close}}")
alertcondition(sellSignal,                      "Sell Signal",        "IBC: SELL signal on {{ticker}} {{interval}} @ {{close}}")
alertcondition(exitLong,                        "Exit Buy",           "IBC: Exit Long on {{ticker}} {{interval}}")
alertcondition(exitShort,                       "Exit Sell",          "IBC: Exit Short on {{ticker}} {{interval}}")
alertcondition(ta.change(math.sign(trendScore)) != 0, "Trend Change",  "IBC: Trend direction changed on {{ticker}} {{interval}}")
alertcondition(momAbs >= 1.9 and momAbs[1] < 1.9,     "Strong Momentum", "IBC: Strong momentum on {{ticker}} {{interval}}")
alertcondition(momAbs < 0.9 and momAbs[1] >= 0.9,     "Weak Momentum",   "IBC: Momentum fading on {{ticker}} {{interval}}")
alertcondition(chExpanding and not chExpanding[1],    "Channel Expansion",  "IBC: Channel expanding on {{ticker}} {{interval}}")
alertcondition(inRange and not inRange[1],            "Channel Compression","IBC: Compression / accumulation detected on {{ticker}} {{interval}}")
alertcondition(contBull or contBear,                  "Continuation",       "IBC: Continuation breakout on {{ticker}} {{interval}}")
alertcondition(sweepHigh or sweepLow,                 "Liquidity Sweep",    "IBC: Liquidity sweep on {{ticker}} {{interval}}")