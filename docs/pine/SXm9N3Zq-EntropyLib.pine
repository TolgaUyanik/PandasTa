//@version=6
library("EntropyLib", overlay=false)

// EntropyLib v1 — Entropy calculation functions for Pine Script
// Extracted from REOS v5.7.0 (Mahalanobis edition)
// Functions: f_clamp, f_binary_entropy, f_ternary_entropy
// Author: cybermediaboy
// Version: 1

//==============================================================================
// PART B: f_clamp
//==============================================================================

// @function Clamp value to range [lo, hi]
// @param x Value to clamp
// @param lo Lower bound
// @param hi Upper bound
// @returns Clamped value
export f_clamp(float x, float lo, float hi) => math.max(lo, math.min(hi, x))

//==============================================================================
// PART C: f_binary_entropy
//==============================================================================

// @function Calculate Shannon binary entropy from a series
// @param x Input series (up/down states)
// @param length Lookback period for entropy calculation
// @returns Binary entropy value [0.0, 1.0] where 0=deterministic, 1=maximum uncertainty
export f_binary_entropy(series float x, simple int length) =>
    float upRate = ta.sma(x > 0 ? 1.0 : 0.0, length)
    float p = math.max(1e-6, math.min(1.0 - 1e-6, upRate))
    float h = -(p * math.log(p) + (1.0 - p) * math.log(1.0 - p)) / math.log(2.0)
    f_clamp(h, 0.0, 1.0)

//==============================================================================
// PART D: f_ternary_entropy
//==============================================================================

// @function Calculate ternary entropy (up/down/flat states)
// @param x Input series
// @param length Lookback period for entropy calculation
// @param flatPct Percentile threshold for flat zone (e.g., 55.0 means middle 55% is "flat")
// @returns Ternary entropy value [0.0, 1.0]
export f_ternary_entropy(series float x, simple int length, simple float flatPct) =>
    float absx = math.abs(x)
    float flatThr = ta.percentile_nearest_rank(absx, length, flatPct)
    float up = x > flatThr ? 1.0 : 0.0
    float dn = x < -flatThr ? 1.0 : 0.0
    float fl = absx <= flatThr ? 1.0 : 0.0
    float pu = math.max(1e-6, ta.sma(up, length))
    float pd = math.max(1e-6, ta.sma(dn, length))
    float pf = math.max(1e-6, ta.sma(fl, length))
    float z = pu + pd + pf
    pu := pu / z
    pd := pd / z
    pf := pf / z
    float h = -(pu * math.log(pu) + pd * math.log(pd) + pf * math.log(pf)) / math.log(3.0)
    f_clamp(h, 0.0, 1.0)

