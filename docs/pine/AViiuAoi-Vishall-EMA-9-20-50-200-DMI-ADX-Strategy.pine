//@version=6
strategy("Vishall EMA 9/20/50/200 DMI/ADX Strategy", overlay=true, pyramiding=0, initial_capital=100000)

//────────────────────────────────────────────
// Visibility settings
//────────────────────────────────────────────
showEMA9      = input.bool(true,  "Show EMA 9")
showEMA20     = input.bool(true,  "Show EMA 20")
showEMA50     = input.bool(true,  "Show EMA 50")
showEMA200    = input.bool(true,  "Show EMA 200")
showSignals   = input.bool(false, "Show Buy/Exit Signals")
showBG        = input.bool(false, "Show Background Color")
enableTrades  = input.bool(true,  "Trade On Chart")

//────────────────────────────────────────────
// Inputs
//────────────────────────────────────────────
ema9Len       = input.int(9,   "EMA 9", minval=1)
ema20Len      = input.int(20,  "EMA 20", minval=1)
ema50Len      = input.int(50,  "EMA 50", minval=1)
ema200Len     = input.int(200, "EMA 200", minval=1)

rocLen        = input.int(5, "Force Length", minval=1)
minSlope      = input.float(0.05, "Min EMA20 Slope", step=0.01)

diLen         = input.int(14, "DI Length", minval=1)
adxSmooth     = input.int(14, "ADX Smoothing", minval=1)
adxMin        = input.float(20, "Min ADX", step=0.5)

//────────────────────────────────────────────
// EMA calculations
//────────────────────────────────────────────
ema9   = ta.ema(close, ema9Len)
ema20  = ta.ema(close, ema20Len)
ema50  = ta.ema(close, ema50Len)
ema200 = ta.ema(close, ema200Len)

//────────────────────────────────────────────
// Plot EMA lines
//────────────────────────────────────────────
plot(showEMA9   ? ema9   : na, "EMA 9",   color=color.yellow, linewidth=2)
plot(showEMA20  ? ema20  : na, "EMA 20",  color=color.orange, linewidth=2)
plot(showEMA50  ? ema50  : na, "EMA 50",  color=color.blue, linewidth=2)
plot(showEMA200 ? ema200 : na, "EMA 200", color=color.purple, linewidth=2)

//────────────────────────────────────────────
// Force, acceleration, slope
//────────────────────────────────────────────
force = ta.roc(close, rocLen)
accel = force - force[1]
slope = ema20 - ema20[1]

//────────────────────────────────────────────
// DMI / ADX
//────────────────────────────────────────────
[diplus, diminus, adx] = ta.dmi(diLen, adxSmooth)

//────────────────────────────────────────────
// Trend filters
//────────────────────────────────────────────
trendBull   = close > ema9 and ema9 > ema20 and ema20 > ema50 and ema50 > ema200
trendStrong = adx > adxMin and diplus > diminus

slopeUp     = slope > minSlope and slope[1] > 0
forceUp     = force > 0
accelUp     = accel > 0

//────────────────────────────────────────────
// Entry / Exit conditions
//────────────────────────────────────────────
longCondition = trendBull and trendStrong and slopeUp and forceUp and accelUp and strategy.position_size == 0
exitCondition = strategy.position_size > 0 and (close < ema9 or ema9 < ema20 or diplus < diminus or adx < adxMin or force < 0)

//────────────────────────────────────────────
// Orders
//────────────────────────────────────────────
if enableTrades and longCondition
    strategy.entry("Long", strategy.long, comment=" ")

if enableTrades and exitCondition
    strategy.close("Long", comment=" ")

//────────────────────────────────────────────
// Optional arrows
//────────────────────────────────────────────
plotshape(showSignals and longCondition, title="BUY",  text="BUY",  style=shape.arrowup,   location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(showSignals and exitCondition, title="EXIT", text="EXIT", style=shape.arrowdown, location=location.abovebar, color=color.red,   textcolor=color.white, size=size.small)

//────────────────────────────────────────────
// Optional background
//────────────────────────────────────────────
bgcolor(showBG ? (trendBull and trendStrong ? color.new(color.green, 90) : color.new(color.red, 93)) : na)