//@version=5

// @description TODO: add library description here
library("LinTrendLib")

// @function Given Bullish / Bearish / side-way market jugement
// @param twz: Trend Window Size
// @param ema_length: Length of EMA 
// @param cross_ratio: number of price bars crosses ema / trend widow size  >= cross_ratio will be considered as side-way market
// @param multiplier: above_ema bar ratio >= multiplier * below_ema will be considered as bullish market
// @returns 1 --> bullish trend, -1 --> bearish trend, 0 --> sideway market
export ema_trend(int twz, int ema_length, float cross_ratio, float multiplier) =>
	// Using one ema with price-bar's relative position as a classifier
	trend_window = twz
	ema = ta.ema(close, ema_length)

	cross_ema = high[1] >= ema[1] and low[1] <= ema[1] ? 1: 0
	above_ema = low[1] > ema[1] ? 1: 0
	below_ema = high[1] < ema[1] ? 1: 0

	float n_bar_cross = math.sum(cross_ema, trend_window)
	float n_above = math.sum(above_ema, trend_window)
	float n_below = math.sum(below_ema, trend_window)

	bar_above_ratio = n_above / trend_window
	bar_below_ratio = n_below / trend_window 
	bar_across_ratio = n_bar_cross / trend_window

	int direction = 1
	if bar_across_ratio >= cross_ratio
		direction := 0
	else if (bar_below_ratio > multiplier * bar_above_ratio)
		direction := -1
	
	direction
