//@version=5
library("hinton_map", overlay=false, dynamic_requests=true)

import kaigouthro/hsvColor/16 as color
import kaigouthro/display_value/1 as dv
import kaigouthro/font/5
import kaigouthro/calc/8

// --- User-defined types ---

// @type HintonUnit - Data for a Hinton unit
// @field fillValue    (float)           Value to determine the fill color hue
// @field borderValue  (float)           Value to determine the border color hue and width
// @field innerValue   (float)           Value to determine the inner box color hue
// @field boxText      (dv.DisplayValue) Text to display in the inner box
// @field tooltipText  (dv.DisplayValue) Tooltip text for the inner box
export type HintonUnit
    float           fillValue   = na
    float           borderValue = na
    float           innerValue  = na
    dv.DisplayValue boxText     = na
    dv.DisplayValue tooltipText = na

// @type HintonData - Structure to store Hinton map data
// @field unitMatrix  (matrix<HintonUnit>) Matrix of Hinton units
// @field lineMatrix   (matrix<line>)      Matrix of lines
// @field labelMatrix  (matrix<label>)     Matrix of labels
// @field boxMatrix    (matrix<box>)       Matrix of boxes
// @field fillMatrix   (matrix<linefill>)   Matrix of line fills
export type HintonData
    matrix<HintonUnit> unitMatrix
    matrix<line>       lineMatrix
    matrix<label>      labelMatrix
    matrix<box>        boxMatrix
    matrix<linefill>   fillMatrix


// --- Functions ---

// @function createHintonUnit - Creates a Hinton unit
// @param fillValue    (float)           Value to determine the fill color hue
// @param borderValue  (float)           Value to determine the border color hue and width
// @param innerValue   (float)           Value to determine the inner box color hue
// @param boxText      (dv.DisplayValue) Text to display in the inner box
// @param tooltipText  (dv.DisplayValue) Tooltip text for the inner box
// @returns            (HintonUnit)      The created Hinton unit
export createHintonUnit(float fillValue = 0.0, float borderValue = 0.0, float innerValue = 0.0, dv.DisplayValue boxText = na, dv.DisplayValue tooltipText = na) =>
    HintonUnit.new(fillValue, borderValue, innerValue, boxText, tooltipText)

// @function initHintonData - Initializes Hinton map data structure
// @param rows        (int) Number of rows
// @param columns     (int) Number of columns
// @returns            (HintonData) Initialized HintonData structure
export initHintonData(int rows, int columns) =>
    HintonData.new(
         matrix.new<HintonUnit>(rows, columns, na),
         matrix.new<line>      (2 + 2 * rows, columns, na),
         matrix.new<label>     (rows, columns, na),
         matrix.new<box>       (rows, columns, na),
         matrix.new<linefill>  (rows, columns, na))


// Function to draw a single Hinton unit
drawHintonUnit(HintonData hintonData, int i, int j, int rows, int cols, int unitSize, int borderWidth, float plusHue, float minusHue) =>
    HintonUnit unit = hintonData.unitMatrix.get(i, j)

    // Calculate box coordinates
    int boxTop  = (rows - i) * unitSize * 2
    int boxLeft = j * unitSize * 2

    // Calculate hues based on sign
    float fillHue   = 30 * unit.fillValue    + plusHue
    float borderHue = 30 * unit.borderValue  + minusHue
    float innerHue  = 30 * unit.innerValue   + plusHue

    // Outer box (using lines and linefill)
    int x1 = bar_index - unitSize * cols + boxLeft
    int y1 = boxTop
    int x2 = bar_index - unitSize * cols + boxLeft + unitSize * 2
    int y2 = boxTop - unitSize * 2


    // Get or create lines
    line topLine = hintonData.lineMatrix.get(i * 2, j)
    if na(topLine)
        topLine := line.new(x1, y1, x2, y1, color=na, width=1)
        hintonData.lineMatrix.set(i * 2, j, topLine)
    else
        line.set_xy1(topLine, x1, y1)
        line.set_xy2(topLine, x2, y1)

    line bottomLine = hintonData.lineMatrix.get((i + 1) * 2, j)
    if na(bottomLine)
        bottomLine := line.new(x1, y2, x2, y2, color=na, width=1)
        hintonData.lineMatrix.set((i + 1) * 2, j, bottomLine)
    else
        line.set_xy1(bottomLine, x1, y2)
        line.set_xy2(bottomLine, x2, y2)


    linefill fillitem = hintonData.fillMatrix.get(i,j)
    lfcolor = color.hsv(fillHue, 1, 1, 0.3)
    if not na(fillitem)
        fillitem.set_color(lfcolor)
    else
        hintonData.fillMatrix.set(i,j,linefill.new(topLine, bottomLine, color=lfcolor))

    // Inner box
    int innerWidthAdjusted  = math.round((math.abs(unit.innerValue) * math.min(1,unitSize / borderWidth))  * unitSize)
    int borderWidthAdjusted = math.min(int(unitSize/math.phi), math.round((math.abs(unit.borderValue) *  math.min(1,unitSize / borderWidth))  * borderWidth))


    box currbox = hintonData.boxMatrix.get(i, j)
    if not na(currbox)
        box.delete(currbox)
    hintonData.boxMatrix.set(i, j, box.new(
          chart.point.from_index(
              bar_index - unitSize * cols + boxLeft + unitSize - innerWidthAdjusted,
              boxTop - unitSize + innerWidthAdjusted - 1
              ),
          chart.point.from_index(
              bar_index - unitSize * cols + boxLeft + unitSize + innerWidthAdjusted,
              boxTop - unitSize - innerWidthAdjusted + 1
              ),
          bgcolor      = color.hsv(innerHue  ,1 , 0.3 , 0.3),
          border_color = color.hsv(borderHue ,1 , 0.3 , 0.3),
          text_color   = color.hsv(fillHue   ,1 , 1   , 1  ),
          border_width = math.round(borderWidthAdjusted),
          text         = font.uni(dv.to_string(unit.boxText), 15),
          text_size    = size.small
      ))


    label labelitem = hintonData.labelMatrix.get(i, j)
    if not na(labelitem)
        label.delete(labelitem)
    // Inner box text
    hintonData.labelMatrix.set(i, j, label.new(
          chart.point.from_index(bar_index - unitSize * cols + boxLeft + unitSize, boxTop - unitSize),
          text      = " \n ",
          textcolor = na,
          tooltip   = dv.to_string(unit.tooltipText),
          color     = color.hsv(borderHue, 1, 1, 0.05),
          style     = label.style_label_center,
          size      = size.huge
      ))

// @function drawHintonMap - Draws a Hinton map
// @param hintonData   (HintonData)    Hinton map data
// @param unitSize     (int)           Size of each unit in bars
// @param borderWidth  (int)           Base width of the inner box border
// @param plusHue      (float)         Hue value for positive values (0-360)
// @param minusHue     (float)         Hue value for negative values (0-360)
export method drawHintonMap(HintonData hintonData, int unitSize = 10, int borderWidth = 5, float plusHue = 180, float minusHue = -30) =>
    // Draw all Hinton units
    if barstate.islast
        for i = 0 to hintonData.unitMatrix.rows() - 1
            for j = 0 to hintonData.unitMatrix.columns() - 1
                drawHintonUnit(hintonData, i, j, hintonData.unitMatrix.rows(), hintonData.unitMatrix.columns(), unitSize, borderWidth, plusHue, minusHue)




