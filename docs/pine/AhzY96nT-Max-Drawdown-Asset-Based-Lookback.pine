//@version=6
indicator("Max Drawdown (Asset-Based Lookback)", overlay=false)

// === Dropdown Input for Asset Category ===
assetType = input.string("Majors", options=["Majors", "Alts", "Memecoins"])

// === Set Lookback Based on Category ===
lookback = switch assetType
    "Majors" => 365
    "Alts" => 180
    "Memecoins" => 90
    => 180  // fallback

// === Peak and Drawdown Calculation ===
peak = ta.highest(high, lookback)
dd = (peak - close) / peak * 100
max_dd = ta.highest(dd, lookback)

// === Plotting ===
plot(dd, title="Current Drawdown %", color=color.red)
plot(max_dd, title="Max Drawdown in Period", color=color.orange, style=plot.style_linebr)

// === Optional: On-Chart Label Showing Info ===
var label info = label.new(x=bar_index, y=na, style=label.style_label_left, textcolor=color.white, color=color.gray)
label.set_xy(info, bar_index, high)
label.set_text(info, "Asset Type: " + assetType + "\nLookback: " + str.tostring(lookback) + " bars")
