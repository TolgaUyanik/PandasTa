//@version=6
indicator("Volume Peak Line", overlay=false)

// User Inputs
length        = input.int(5, "Lookback Volume Candles", minval=1)
showVol       = input.bool(false, "Show Volume Bars")
buyColor      = input.color(color.green, "Buying Volume Color")
sellColor     = input.color(color.red, "Selling Volume Color")
lineColor     = input.color(color.blue, "Line Color")
lineStyleOpt  = input.string("solid", "Line Style", options=["solid","dashed","dotted"])
lineWidth     = input.int(1, "Line Width", minval=1)
enableAlert   = input.bool(true, "Enable Rising Volume Alert")

// Map selected option to Pine Script line style constant (single-line nested ternary)
lineStyle = lineStyleOpt == "solid" ? line.style_solid : lineStyleOpt == "dashed" ? line.style_dashed : lineStyleOpt == "dotted" ? line.style_dotted : line.style_dotted

// Persistent variables
var line currentLine = na
var float threshold   = na

// On each confirmed bar, compute threshold and redraw line
if barstate.isconfirmed
    threshold := ta.highest(volume[1], length)
    if not na(currentLine)
        line.delete(currentLine)
    // Draw line extended across visible chart (single-line)
    currentLine := line.new(bar_index - length, threshold, bar_index - 1, threshold, xloc.bar_index, extend.both, lineColor, lineStyle, lineWidth)

// Prepare up/down volume series
upVol   = close >= open ? volume : 0
downVol = close <  open ? volume : 0

// Plot volume if enabled
plot(showVol ? upVol   : na, style=plot.style_columns, title="Buying Volume",  color=buyColor)
plot(showVol ? downVol : na, style=plot.style_columns, title="Selling Volume", color=sellColor)

// Alert condition when volume rises above threshold
alertcondition(enableAlert and volume > threshold, title="Rising Volume Alert", message="Volume crossed above threshold")


