//@version=5
indicator("15Min Volume x3 Spike", overlay=true)

// בודק שהגרף הוא 15 דקות
is15min = timeframe.period == "15"

// מחשב ממוצע של 10 נרות אחרונים
len = 10
avgVol = ta.sma(volume, len)
cond = is15min and volume >= avgVol * 3

// סימון רק בגרף 15 דקות כשהווליום גדול או שווה פי 3 מהממוצע
barcolor(cond ? color.orange : na)
plotshape(cond, location=location.belowbar, color=color.red, style=shape.labelup, text="Vol x3")
alertcondition(cond, title="Volume x3 Spike (15min)", message="נר עם ווליום פי 3 או יותר מהממוצע בגרף 15 דקות")
