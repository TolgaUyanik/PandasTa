//@version=6
library('Trend', true)

// /**
//  * Calculates the slope of a series using linear regression and determines the trend direction (up, down, or flat)
//  * based on an adaptive threshold derived from the series' standard deviation.
//  *
//  * @param source The data series to analyze (e.g., close, hl2).
//  * @param length The lookback period for calculating the slope and standard deviation.
//  * @param thresholdMultiplier A multiplier for the standard deviation to determine the flatness threshold. Default is 0.1.
//  * @returns 1 for an upward trend, -1 for a downward trend, 0 for a flat trend.
//  */
export calculateSlopeTrend(series float source, int length, float thresholdMultiplier = 0.1) =>
    // Calculate the slope using linear regression.
    // linreg returns the value of the linear regression line at the current bar.
    // The slope is the difference between the current value and the previous value of the linreg line.
    float linRegValue = ta.linreg(source, length, 0)
    float slope = linRegValue - linRegValue[1]

    // Calculate the standard deviation of the source series over the lookback period.
    float stdDev = ta.stdev(source, length)

    // Determine the adaptive threshold.
    float threshold = stdDev * thresholdMultiplier

    // Determine the trend direction.
    int trendDirection = 0
    if slope > threshold
        trendDirection := 1 // Trend is up
        trendDirection
    else if slope < -threshold
        trendDirection := -1 // Trend is down
        trendDirection
        // else trendDirection remains 0 (Flat)

    trendDirection
