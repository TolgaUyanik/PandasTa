     "Level 2 line thickness",
     minval = 1,
     maxval = 5
)

int levelThreeWidth = input.int(
     1,
     "Level 3 line thickness",
     minval = 1,
     maxval = 5
)

int levelFourWidth = input.int(
     1,
     "Level 4 line thickness",
     minval = 1,
     maxval = 5
)

//======================================================================
// MIDNIGHT OPEN
//======================================================================

bool showMidnightOpen = input.bool(
     true,
     "Show Midnight Open"
)

bool showMidnightLabel = input.bool(
     true,
     "Show Midnight Open label"
)

color midnightColor = input.color(
     color.rgb(0, 185, 220),
     "Midnight Open color"
)

int midnightLineWidth = input.int(
     2,
     "Midnight Open width",
     minval = 1,
     maxval = 4
)

int midnightLinesToKeep = input.int(
     7,
     "Historical Midnight Open lines",
     minval = 1,
     maxval = 30
)

//======================================================================
// CONSTANTS
//======================================================================

const int MINUTE_MS = 60 * 1000
const int MAX_DEPTH = 4
const int TRACKED_LEVELS = 5

const float FIRST_SPLIT_RATIO = 0.40
const float SECOND_SPLIT_RATIO = 0.60

//======================================================================
// BOX STATE
//======================================================================

var array<box> activeBoxes =
     array.new_box(TRACKED_LEVELS, na)

var array<int> activeStarts =
     array.new_int(TRACKED_LEVELS, na)

var array<int> activeEnds =
     array.new_int(TRACKED_LEVELS, na)

var array<float> activeHighs =
     array.new_float(TRACKED_LEVELS, na)

var array<float> activeLows =
     array.new_float(TRACKED_LEVELS, na)

var array<box> allBoxes =
     array.new_box()

//======================================================================
// GUIDE STORAGE
//======================================================================

var array<line> guideLines =
     array.new_line()

var array<label> guideLabels =
     array.new_label()

//======================================================================
// MIDNIGHT STATE
//======================================================================

var array<int> activeMidnightTimes =
     array.new_int(1, na)

var array<line> activeMidnightLines =
     array.new_line(1, na)

var array<label> activeMidnightLabels =
     array.new_label(1, na)

var array<line> historicalMidnightLines =
     array.new_line()

//======================================================================
// STYLE HELPERS
//======================================================================

f_phaseColor(int phase) =>
    color result = firstPhaseColor

    if phase == 2
        result := middlePhaseColor
    else if phase == 3
        result := finalPhaseColor

    result

f_styleFromInput(string styleInput) =>
    string result = line.style_solid

    if styleInput == "Dashed"
        result := line.style_dashed
    else if styleInput == "Dotted"
        result := line.style_dotted

    result

f_borderStyle() =>
    f_styleFromInput(borderStyleInput)

f_boxFillTransparency(
     int depth,
     bool isParent
) =>
    int result = isParent
         ? parentFillTransparency
         : mainFillTransparency +
           (depth - 1) *
           transparencyPerDepth

    math.min(result, 100)

f_boxBorderTransparency(
     int depth,
     bool isParent
) =>
    int result = isParent
         ? 45
         : mainBorderTransparency +
           (depth - 1) *
           borderTransparencyPerDepth

    math.min(result, 100)

f_boxBorderWidth(
     int depth,
     bool isParent
) =>
    int result = parentBorderWidth

    if not isParent
        result := depth == 1
             ? primaryBorderWidth
             : nestedBorderWidth

    result

f_showBoxDepth(int depth) =>
    bool result = false

    if depth == 1
        result := showDepth1Boxes
    else if depth == 2
        result := showDepth2Boxes
    else if depth == 3
        result := showDepth3Boxes
    else if depth == 4
        result := showDepth4Boxes

    result

f_guideColor(int depth) =>
    color result = levelOneColor

    if depth == 2
        result := levelTwoColor
    else if depth == 3
        result := levelThreeColor
    else if depth >= 4
        result := levelFourColor

    result

f_showGuideDepth(int depth) =>
    bool result = false

    if depth == 1
        result := showGuideLevel1
    else if depth == 2
        result := showGuideLevel2
    else if depth == 3
        result := showGuideLevel3
    else if depth >= 4
        result := showGuideLevel4

    result

f_guideStyle(int depth) =>
    string selectedInput = levelOneStyleInput

    if depth == 2
        selectedInput := levelTwoStyleInput
    else if depth == 3
        selectedInput := levelThreeStyleInput
    else if depth >= 4
        selectedInput := levelFourStyleInput

    f_styleFromInput(selectedInput)

f_guideWidth(int depth) =>
    int result = levelOneWidth

    if depth == 2
        result := levelTwoWidth
    else if depth == 3
        result := levelThreeWidth
    else if depth >= 4
        result := levelFourWidth

    result

f_dayNumber(string dayName) =>
    int result = dayofweek.sunday

    if dayName == "Monday"
        result := dayofweek.monday
    else if dayName == "Tuesday"
        result := dayofweek.tuesday
    else if dayName == "Wednesday"
        result := dayofweek.wednesday
    else if dayName == "Thursday"
        result := dayofweek.thursday
    else if dayName == "Friday"
        result := dayofweek.friday
    else if dayName == "Saturday"
        result := dayofweek.saturday

    result

//======================================================================
// OBJECT CLEANUP
//======================================================================

f_trimBoxes() =>
    while array.size(allBoxes) > maximumHistoricalBoxes
        box oldestBox = array.shift(allBoxes)
        box.delete(oldestBox)

f_clearGuides() =>
    while array.size(guideLines) > 0
        line.delete(array.pop(guideLines))

    while array.size(guideLabels) > 0
        label.delete(array.pop(guideLabels))

f_trimMidnightLines() =>
    while array.size(historicalMidnightLines) > midnightLinesToKeep
        line oldestLine =
             array.shift(historicalMidnightLines)

        line.delete(oldestLine)

//======================================================================
// PARENT CYCLE CALCULATIONS
//======================================================================

f_dailyCycleStart(int referenceTime) =>
    int refYear =
         year(referenceTime, timezoneInput)

    int refMonth =
         month(referenceTime, timezoneInput)

    int refDay =
         dayofmonth(referenceTime, timezoneInput)

    int candidate = timestamp(
         timezoneInput,
         refYear,
         refMonth,
         refDay,
         dailyStartHour,
         dailyStartMinute
    )

    if referenceTime < candidate
        candidate := timestamp(
             timezoneInput,
             refYear,
             refMonth,
             refDay - 1,
             dailyStartHour,
             dailyStartMinute
        )

    candidate

f_dailyCycleEnd(int cycleStart) =>
    int cycleYear =
         year(cycleStart, timezoneInput)

    int cycleMonth =
         month(cycleStart, timezoneInput)

    int cycleDay =
         dayofmonth(cycleStart, timezoneInput)

    int startMinutes =
         dailyStartHour * 60 +
         dailyStartMinute

    int endMinutes =
         dailyEndHour * 60 +
         dailyEndMinute

    int endDayOffset =
         endMinutes <= startMinutes
         ? 1
         : 0

    timestamp(
         timezoneInput,
         cycleYear,
         cycleMonth,
         cycleDay + endDayOffset,
         dailyEndHour,
         dailyEndMinute
    )

f_weeklyCycleStart(int referenceTime) =>
    int startDayNumber =
         f_dayNumber(weeklyStartDayInput)

    int referenceDayNumber =
         dayofweek(referenceTime, timezoneInput)

    int daysBack =
         (
              referenceDayNumber -
              startDayNumber +
              7
         ) % 7

    int refYear =
         year(referenceTime, timezoneInput)

    int refMonth =
         month(referenceTime, timezoneInput)

    int refDay =
         dayofmonth(referenceTime, timezoneInput)

    int candidate = timestamp(
         timezoneInput,
         refYear,
         refMonth,
         refDay - daysBack,
         weeklyStartHour,
         weeklyStartMinute
    )

    if referenceTime < candidate
        candidate := timestamp(
             timezoneInput,
             year(candidate, timezoneInput),
             month(candidate, timezoneInput),
             dayofmonth(candidate, timezoneInput) - 7,
             weeklyStartHour,
             weeklyStartMinute
        )

    candidate

f_weeklyCycleEnd(int cycleStart) =>
    int startDayNumber =
         dayofweek(cycleStart, timezoneInput)

    int endDayNumber =
         f_dayNumber(weeklyEndDayInput)

    int daysForward =
         (
              endDayNumber -
              startDayNumber +
              7
         ) % 7

    int candidate = timestamp(
         timezoneInput,
         year(cycleStart, timezoneInput),
         month(cycleStart, timezoneInput),
         dayofmonth(cycleStart, timezoneInput) +
         daysForward,
         weeklyEndHour,
         weeklyEndMinute
    )

    if candidate <= cycleStart
        candidate := timestamp(
             timezoneInput,
             year(cycleStart, timezoneInput),
             month(cycleStart, timezoneInput),
             dayofmonth(cycleStart, timezoneInput) +
             daysForward +
             7,
             weeklyEndHour,
             weeklyEndMinute
        )

    candidate

f_monthlyCycleStart(int referenceTime) =>
    int refYear =
         year(referenceTime, timezoneInput)

    int refMonth =
         month(referenceTime, timezoneInput)

    int candidate = timestamp(
         timezoneInput,
         refYear,
         refMonth,
         monthlyStartDay,
         monthlyStartHour,
         monthlyStartMinute
    )

    if referenceTime < candidate
        int previousYear =
             refMonth == 1
             ? refYear - 1
             : refYear

        int previousMonth =
             refMonth == 1
             ? 12
             : refMonth - 1

        candidate := timestamp(
             timezoneInput,
             previousYear,
             previousMonth,
             monthlyStartDay,
             monthlyStartHour,
             monthlyStartMinute
        )

    candidate

f_monthlyCycleEnd(int cycleStart) =>
    int startYear =
         year(cycleStart, timezoneInput)

    int startMonth =
         month(cycleStart, timezoneInput)

    int nextYear =
         startMonth == 12
         ? startYear + 1
         : startYear

    int nextMonth =
         startMonth == 12
         ? 1
         : startMonth + 1

    timestamp(
         timezoneInput,
         nextYear,
         nextMonth,
         monthlyStartDay,
         monthlyStartHour,
         monthlyStartMinute
    )

f_repeatingMinutes() =>
    int result = 60

    if cycleMode == "4 Hour"
        result := 240
    else if cycleMode == "1 Hour"
        result := 60
    else if cycleMode == "15 Minute"
        result := 15
    else if cycleMode == "Custom Minutes"
        result := customCycleMinutes

    result

f_repeatingCycleStart(
     int referenceTime,
     int cycleLengthMs
) =>
    int refYear =
         year(referenceTime, timezoneInput)

    int refMonth =
         month(referenceTime, timezoneInput)

    int refDay =
         dayofmonth(referenceTime, timezoneInput)

    int anchor = timestamp(
         timezoneInput,
         refYear,
         refMonth,
         refDay,
         blockAnchorHour,
         blockAnchorMinute
    )

    if referenceTime < anchor
        anchor := timestamp(
             timezoneInput,
             refYear,
             refMonth,
             refDay - 1,
             blockAnchorHour,
             blockAnchorMinute
        )

    int elapsed =
         referenceTime -
         anchor

    int cycleNumber = int(
         math.floor(
              float(elapsed) /
              float(cycleLengthMs)
         )
    )

    anchor +
     cycleNumber *
     cycleLengthMs

f_parentCycle(
     int referenceTime,
     int repeatingLengthMs
) =>
    int parentStart = na
    int parentEnd = na

    if cycleMode == "Daily Session"
        parentStart :=
             f_dailyCycleStart(referenceTime)

        parentEnd :=
             f_dailyCycleEnd(parentStart)

    else if cycleMode == "Weekly"
        parentStart :=
             f_weeklyCycleStart(referenceTime)

        parentEnd :=
             f_weeklyCycleEnd(parentStart)

    else if cycleMode == "Monthly"
        parentStart :=
             f_monthlyCycleStart(referenceTime)

        parentEnd :=
             f_monthlyCycleEnd(parentStart)

    else
        parentStart :=
             f_repeatingCycleStart(
                  referenceTime,
                  repeatingLengthMs
             )

        parentEnd :=
             parentStart +
             repeatingLengthMs

    [parentStart, parentEnd]

f_cycleStartByOffset(
     int latestStart,
     int cycleOffset,
     int repeatingLengthMs
) =>
    int result = na

    if cycleMode == "Daily Session"
        result := timestamp(
             timezoneInput,
             year(latestStart, timezoneInput),
             month(latestStart, timezoneInput),
             dayofmonth(latestStart, timezoneInput) -
             cycleOffset,
             dailyStartHour,
             dailyStartMinute
        )

    else if cycleMode == "Weekly"
        result := timestamp(
             timezoneInput,
             year(latestStart, timezoneInput),
             month(latestStart, timezoneInput),
             dayofmonth(latestStart, timezoneInput) -
             cycleOffset *
             7,
             weeklyStartHour,
             weeklyStartMinute
        )

    else if cycleMode == "Monthly"
        int latestYear =
             year(latestStart, timezoneInput)

        int latestMonth =
             month(latestStart, timezoneInput)

        int serialMonth =
             latestYear *
             12 +
             latestMonth -
             1 -
             cycleOffset

        int shiftedYear = int(
             math.floor(
                  float(serialMonth) /
                  12.0
             )
        )

        int shiftedMonth =
             serialMonth -
             shiftedYear *
             12 +
             1

        result := timestamp(
             timezoneInput,
             shiftedYear,
             shiftedMonth,
             monthlyStartDay,
             monthlyStartHour,
             monthlyStartMinute
        )

    else
        result :=
             latestStart -
             cycleOffset *
             repeatingLengthMs

    result

f_cycleEndFromStart(
     int cycleStart,
     int repeatingLengthMs
) =>
    int result = na

    if cycleMode == "Daily Session"
        result :=
             f_dailyCycleEnd(cycleStart)

    else if cycleMode == "Weekly"
        result :=
             f_weeklyCycleEnd(cycleStart)

    else if cycleMode == "Monthly"
        result :=
             f_monthlyCycleEnd(cycleStart)

    else
        result :=
             cycleStart +
             repeatingLengthMs

    result

//======================================================================
// ACTIVE STATE MANAGEMENT
//======================================================================

f_clearState(int stateIndex) =>
    box storedBox =
         array.get(activeBoxes, stateIndex)

    int storedEnd =
         array.get(activeEnds, stateIndex)

    if not na(storedBox) and
         not na(storedEnd)

        box.set_right(
             storedBox,
             storedEnd
        )

    array.set(
         activeBoxes,
         stateIndex,
         na
    )

    array.set(
         activeStarts,
         stateIndex,
         na
    )

    array.set(
         activeEnds,
         stateIndex,
         na
    )

    array.set(
         activeHighs,
         stateIndex,
         na
    )

    array.set(
         activeLows,
         stateIndex,
         na
    )

f_clearAllStates() =>
    for stateIndex =
         0 to TRACKED_LEVELS - 1

        f_clearState(stateIndex)

//======================================================================
// CREATE OR UPDATE ONE RANGE BOX
//======================================================================

f_updateBox(
     int stateIndex,
     int cycleStart,
     int cycleEnd,
     int phase,
     int sampleCloseTime,
     float sampleHigh,
     float sampleLow,
     bool isParent
) =>
    box storedBox =
         array.get(activeBoxes, stateIndex)

    int storedStart =
         array.get(activeStarts, stateIndex)

    int storedEnd =
         array.get(activeEnds, stateIndex)

    float storedHigh =
         array.get(activeHighs, stateIndex)

    float storedLow =
         array.get(activeLows, stateIndex)

    bool newCycle =
         na(storedBox) or
         na(storedStart) or
         storedStart != cycleStart or
         storedEnd != cycleEnd

    int currentRight =
         growActiveBoxWithPrice
         ? math.min(
              sampleCloseTime,
              cycleEnd
         )
         : cycleEnd

    if newCycle
        if not na(storedBox) and
             not na(storedEnd)

            box.set_right(
                 storedBox,
                 storedEnd
            )

        color baseColor =
             isParent
             ? parentBoxColor
             : f_phaseColor(phase)

        int depth =
             isParent
             ? 1
             : stateIndex

        box newBox = box.new(
             left = cycleStart,
             top = sampleHigh,
             right = currentRight,
             bottom = sampleLow,
             xloc = xloc.bar_time,
             border_color = color.new(
                  baseColor,
                  f_boxBorderTransparency(
                       depth,
                       isParent
                  )
             ),
             border_width = f_boxBorderWidth(
                  depth,
                  isParent
             ),
             border_style = isParent
                  ? line.style_dotted
                  : f_borderStyle(),
             bgcolor = color.new(
                  baseColor,
                  f_boxFillTransparency(
                       depth,
                       isParent
                  )
             ),
             force_overlay = true
        )

        array.set(
             activeBoxes,
             stateIndex,
             newBox
        )

        array.set(
             activeStarts,
             stateIndex,
             cycleStart
        )

        array.set(
             activeEnds,
             stateIndex,
             cycleEnd
        )

        array.set(
             activeHighs,
             stateIndex,
             sampleHigh
        )

        array.set(
             activeLows,
             stateIndex,
             sampleLow
        )

        array.push(
             allBoxes,
             newBox
        )

        f_trimBoxes()

    else
        float updatedHigh =
             math.max(
                  storedHigh,
                  sampleHigh
             )

        float updatedLow =
             math.min(
                  storedLow,
                  sampleLow
             )

        array.set(
             activeHighs,
             stateIndex,
             updatedHigh
        )

        array.set(
             activeLows,
             stateIndex,
             updatedLow
        )

        box.set_left(
             storedBox,
             cycleStart
        )

        box.set_right(
             storedBox,
             currentRight
        )

        box.set_top(
             storedBox,
             updatedHigh
        )

        box.set_bottom(
             storedBox,
             updatedLow
        )

//======================================================================
// PROCESS ONE PRICE SAMPLE
//======================================================================

f_processCycleSample(
     int sampleTime,
     int sampleCloseTime,
     float sampleHigh,
     float sampleLow,
     int repeatingLengthMs
) =>
    [parentStart, parentEnd] =
         f_parentCycle(
              sampleTime,
              repeatingLengthMs
         )

    bool sampleInsideParent =
         sampleTime < parentEnd and
         sampleCloseTime > parentStart

    if showRangeBoxes and
         sampleInsideParent

        if showParentBox
            f_updateBox(
                 0,
                 parentStart,
                 parentEnd,
                 0,
                 sampleCloseTime,
                 sampleHigh,
                 sampleLow,
                 true
            )

        else
            f_clearState(0)

        int workingStart =
             parentStart

        int workingEnd =
             parentEnd

        for depth = 1 to nestedBoxDepth
            int duration =
                 workingEnd -
                 workingStart

            int firstSplit =
                 workingStart +
                 int(
                      math.round(
                           float(duration) *
                           FIRST_SPLIT_RATIO
                      )
                 )

            int secondSplit =
                 workingStart +
                 int(
                      math.round(
                           float(duration) *
                           SECOND_SPLIT_RATIO
                      )
                 )

            int childStart =
                 workingStart

            int childEnd =
                 firstSplit

            int phase = 1

            if sampleTime >= firstSplit and
                 sampleTime < secondSplit

                childStart :=
                     firstSplit

                childEnd :=
                     secondSplit

                phase := 2

            else if sampleTime >= secondSplit
                childStart :=
                     secondSplit

                childEnd :=
                     workingEnd

                phase := 3

            if f_showBoxDepth(depth)
                f_updateBox(
                     depth,
                     childStart,
                     childEnd,
                     phase,
                     sampleCloseTime,
                     sampleHigh,
                     sampleLow,
                     false
                )

            else
                f_clearState(depth)

            workingStart :=
                 childStart

            workingEnd :=
                 childEnd

        if nestedBoxDepth < MAX_DEPTH
            for unusedDepth =
                 nestedBoxDepth + 1 to MAX_DEPTH

                f_clearState(unusedDepth)

    else
        f_clearAllStates()

//======================================================================
// MIDNIGHT OPEN PROCESSING
//======================================================================

f_processMidnight(
     int sampleTime,
     int sampleCloseTime,
     float sampleOpen
) =>
    bool isMidnight =
         hour(sampleTime, timezoneInput) == 0 and
         minute(sampleTime, timezoneInput) == 0

    int trackedTime =
         array.get(activeMidnightTimes, 0)

    line trackedLine =
         array.get(activeMidnightLines, 0)

    label trackedLabel =
         array.get(activeMidnightLabels, 0)

    if showMidnightOpen
        bool newMidnight =
             isMidnight and
             (
                  na(trackedTime) or
                  sampleTime != trackedTime
             )

        if newMidnight
            if not na(trackedLine)
                line.set_x2(
                     trackedLine,
                     sampleTime
                )

            if not na(trackedLabel)
                label.delete(trackedLabel)

            line newLine = line.new(
                 x1 = sampleTime,
                 y1 = sampleOpen,
                 x2 = sampleCloseTime,
                 y2 = sampleOpen,
                 xloc = xloc.bar_time,
                 extend = extend.none,
                 color = midnightColor,
                 style = line.style_dotted,
                 width = midnightLineWidth,
                 force_overlay = true
            )

            array.set(
                 activeMidnightTimes,
                 0,
                 sampleTime
            )

            array.set(
                 activeMidnightLines,
                 0,
                 newLine
            )

            array.push(
                 historicalMidnightLines,
                 newLine
            )

            if showMidnightLabel
                label newLabel = label.new(
                     x = sampleCloseTime,
                     y = sampleOpen,
                     text = "Midnight Open  " +
                          str.tostring(
                               sampleOpen,
                               format.mintick
                          ),
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_left,
                     color = color.new(
                          midnightColor,
                          82
                     ),
                     textcolor = midnightColor,
                     size = size.small,
                     force_overlay = true
                )

                array.set(
                     activeMidnightLabels,
                     0,
                     newLabel
                )

            f_trimMidnightLines()

        else if not na(trackedLine)
            line.set_x2(
                 trackedLine,
                 sampleCloseTime
            )

            if showMidnightLabel and
                 not na(trackedLabel)

                label.set_x(
                     trackedLabel,
                     sampleCloseTime
                )

//======================================================================
// INTRABAR PRICE DATA
//======================================================================

string sourceTicker =
     syminfo.tickerid

array<int> lowerTimes =
     request.security_lower_tf(
          sourceTicker,
          "1",
          time,
          ignore_invalid_timeframe = true
     )

array<int> lowerCloseTimes =
     request.security_lower_tf(
          sourceTicker,
          "1",
          time_close,
          ignore_invalid_timeframe = true
     )

array<float> lowerOpens =
     request.security_lower_tf(
          sourceTicker,
          "1",
          open,
          ignore_invalid_timeframe = true
     )

array<float> lowerHighs =
     request.security_lower_tf(
          sourceTicker,
          "1",
          high,
          ignore_invalid_timeframe = true
     )

array<float> lowerLows =
     request.security_lower_tf(
          sourceTicker,
          "1",
          low,
          ignore_invalid_timeframe = true
     )

int lowerCount =
     array.size(lowerTimes)

if array.size(lowerCloseTimes) < lowerCount
    lowerCount :=
         array.size(lowerCloseTimes)

if array.size(lowerOpens) < lowerCount
    lowerCount :=
         array.size(lowerOpens)

if array.size(lowerHighs) < lowerCount
    lowerCount :=
         array.size(lowerHighs)

if array.size(lowerLows) < lowerCount
    lowerCount :=
         array.size(lowerLows)

var int lastProcessedSampleTime = na

int repeatingLengthMs =
     f_repeatingMinutes() *
     MINUTE_MS

if lowerCount > 0
    for sampleIndex =
         0 to lowerCount - 1

        int sampleTime =
             array.get(
                  lowerTimes,
                  sampleIndex
             )

        int sampleCloseTime =
             array.get(
                  lowerCloseTimes,
                  sampleIndex
             )

        float sampleOpen =
             array.get(
                  lowerOpens,
                  sampleIndex
             )

        float sampleHigh =
             array.get(
                  lowerHighs,
                  sampleIndex
             )

        float sampleLow =
             array.get(
                  lowerLows,
                  sampleIndex
             )

        bool processSample =
             na(lastProcessedSampleTime) or
             sampleTime >=
             lastProcessedSampleTime

        if processSample
            f_processCycleSample(
                 sampleTime,
                 sampleCloseTime,
                 sampleHigh,
                 sampleLow,
                 repeatingLengthMs
            )

            f_processMidnight(
                 sampleTime,
                 sampleCloseTime,
                 sampleOpen
            )

            if na(lastProcessedSampleTime) or
                 sampleTime >
                 lastProcessedSampleTime

                lastProcessedSampleTime :=
                     sampleTime

else
    bool processChartSample =
         na(lastProcessedSampleTime) or
         time >= lastProcessedSampleTime

    if processChartSample
        f_processCycleSample(
             time,
             time_close,
             high,
             low,
             repeatingLengthMs
        )

        f_processMidnight(
             time,
             time_close,
             open
        )

        if na(lastProcessedSampleTime) or
             time >
             lastProcessedSampleTime

            lastProcessedSampleTime :=
                 time

//======================================================================
// TIMING GUIDE HELPERS
//======================================================================

f_addGuideLine(
     int guideTime,
     int depth
) =>
    if f_showGuideDepth(depth)
        line newLine = line.new(
             x1 = guideTime,
             y1 = low,
             x2 = guideTime,
             y2 = high,
             xloc = xloc.bar_time,
             extend = extend.both,
             color = f_guideColor(depth),
             style = f_guideStyle(depth),
             width = f_guideWidth(depth),
             force_overlay = true
        )

        array.push(
             guideLines,
             newLine
        )

f_addGuideLabel(
     int labelTime,
     float labelPrice,
     string textValue
) =>
    label newLabel = label.new(
         x = labelTime,
         y = labelPrice,
         text = textValue,
         xloc = xloc.bar_time,
         yloc = yloc.price,
         style = label.style_none,
         textcolor = levelOneColor,
         size = size.small,
         force_overlay = true
    )

    array.push(
         guideLabels,
         newLabel
    )

//======================================================================
// DRAW ONE COMPLETE GUIDE TREE
//======================================================================

f_drawGuideTree(
     int cycleStart,
     int cycleEnd,
     int depthLimit,
     bool drawLabels,
     float labelPrice
) =>
    array<int> currentStarts =
         array.new_int()

    array<int> currentEnds =
         array.new_int()

    array.push(
         currentStarts,
         cycleStart
    )

    array.push(
         currentEnds,
         cycleEnd
    )

    f_addGuideLine(
         cycleStart,
         1
    )

    f_addGuideLine(
         cycleEnd,
         1
    )

    for depth = 1 to depthLimit
        array<int> nextStarts =
             array.new_int()

        array<int> nextEnds =
             array.new_int()

        int segmentCount =
             array.size(currentStarts)

        if segmentCount > 0
            for segmentIndex =
                 0 to segmentCount - 1

                int segmentStart =
                     array.get(
                          currentStarts,
                          segmentIndex
                     )

                int segmentEnd =
                     array.get(
                          currentEnds,
                          segmentIndex
                     )

                int segmentDuration =
                     segmentEnd -
                     segmentStart

                int firstSplit =
                     segmentStart +
                     int(
                          math.round(
                               float(segmentDuration) *
                               FIRST_SPLIT_RATIO
                          )
                     )

                int secondSplit =
                     segmentStart +
                     int(
                          math.round(
                               float(segmentDuration) *
                               SECOND_SPLIT_RATIO
                          )
                     )

                f_addGuideLine(
                     firstSplit,
                     depth
                )

                f_addGuideLine(
                     secondSplit,
                     depth
                )

                if depth == 1 and
                     drawLabels

                    int firstMid =
                         segmentStart +
                         int(
                              math.round(
                                   float(
                                        firstSplit -
                                        segmentStart
                                   ) * 0.5
                              )
                         )

                    int middleMid =
                         firstSplit +
                         int(
                              math.round(
                                   float(
                                        secondSplit -
                                        firstSplit
                                   ) * 0.5
                              )
                         )

                    int finalMid =
                         secondSplit +
                         int(
                              math.round(
                                   float(
                                        segmentEnd -
                                        secondSplit
                                   ) * 0.5
                              )
                         )

                    f_addGuideLabel(
                         firstMid,
                         labelPrice,
                         "2"
                    )

                    f_addGuideLabel(
                         middleMid,
                         labelPrice,
                         "1"
                    )

                    f_addGuideLabel(
                         finalMid,
                         labelPrice,
                         "2"
                    )

                array.push(
                     nextStarts,
                     segmentStart
                )

                array.push(
                     nextEnds,
                     firstSplit
                )

                array.push(
                     nextStarts,
                     firstSplit
                )

                array.push(
                     nextEnds,
                     secondSplit
                )

                array.push(
                     nextStarts,
                     secondSplit
                )

                array.push(
                     nextEnds,
                     segmentEnd
                )

        currentStarts :=
             nextStarts

        currentEnds :=
             nextEnds

//======================================================================
// DRAW CURRENT AND PREVIOUS GUIDE CYCLES
//======================================================================

if barstate.islast
    f_clearGuides()

    if showTimingGuides
        int referenceTime =
             barstate.isrealtime
             ? timenow
             : time_close

        [latestGuideStart, latestGuideEnd] =
             f_parentCycle(
                  referenceTime,
                  repeatingLengthMs
             )

        float labelPrice =
             ta.highest(high, 300) +
             ta.atr(14) *
             0.65

        for cycleOffset =
             0 to guideCyclesToShow - 1

            int guideStart =
                 f_cycleStartByOffset(
                      latestGuideStart,
                      cycleOffset,
                      repeatingLengthMs
                 )

            int guideEnd =
                 f_cycleEndFromStart(
                      guideStart,
                      repeatingLengthMs
                 )

            f_drawGuideTree(
                 guideStart,
                 guideEnd,
                 timingGuideDepth,
                 showMainPhaseLabels and
                 cycleOffset == 0,
                 labelPrice
            )