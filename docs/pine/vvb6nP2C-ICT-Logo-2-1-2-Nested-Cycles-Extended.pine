//@version=6
indicator("ICT Logo 2-1-2 Nested Cycles - Extended Controls", overlay = true, scale = scale.none, behind_chart = true, max_lines_count = 500, max_labels_count = 100, max_boxes_count = 500)

//======================================================================
// TIME SETTINGS
//======================================================================

string timezoneInput = input.string("America/New_York", "Time zone")

string cycleMode = input.string(
     "Daily Session",
     "Parent cycle",
     options = ["Daily Session", "Weekly", "Monthly", "4 Hour", "1 Hour", "15 Minute", "Custom Minutes"]
)

int dailyStartHour = input.int(0, "Daily start hour", minval = 0, maxval = 23)
int dailyStartMinute = input.int(0, "Daily start minute", minval = 0, maxval = 59)
int dailyEndHour = input.int(16, "Daily end hour", minval = 0, maxval = 23)
int dailyEndMinute = input.int(15, "Daily end minute", minval = 0, maxval = 59)

string weeklyStartDayInput = input.string(
     "Sunday",
     "Weekly start day",
     options = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
)

int weeklyStartHour = input.int(18, "Weekly start hour", minval = 0, maxval = 23)
int weeklyStartMinute = input.int(0, "Weekly start minute", minval = 0, maxval = 59)

string weeklyEndDayInput = input.string(
     "Friday",
     "Weekly end day",
     options = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
)

int weeklyEndHour = input.int(16, "Weekly end hour", minval = 0, maxval = 23)
int weeklyEndMinute = input.int(15, "Weekly end minute", minval = 0, maxval = 59)

int monthlyStartDay = input.int(
     1,
     "Monthly anchor day",
     minval = 1,
     maxval = 28
)

int monthlyStartHour = input.int(
     0,
     "Monthly anchor hour",
     minval = 0,
     maxval = 23
)

int monthlyStartMinute = input.int(
     0,
     "Monthly anchor minute",
     minval = 0,
     maxval = 59
)

int blockAnchorHour = input.int(
     0,
     "Repeating-cycle anchor hour",
     minval = 0,
     maxval = 23
)

int blockAnchorMinute = input.int(
     0,
     "Repeating-cycle anchor minute",
     minval = 0,
     maxval = 59
)

int customCycleMinutes = input.int(
     90,
     "Custom cycle length in minutes",
     minval = 3,
     maxval = 10080
)

//======================================================================
// FRACTAL SETTINGS
//======================================================================

int nestedBoxDepth = input.int(
     2,
     "Maximum nested range-box depth",
     minval = 1,
     maxval = 4
)

int timingGuideDepth = input.int(
     3,
     "Maximum timing-line depth",
     minval = 1,
     maxval = 4
)

int guideCyclesToShow = input.int(
     2,
     "Parent guide cycles to show",
     minval = 1,
     maxval = 5
)

int maximumHistoricalBoxes = input.int(
     450,
     "Maximum historical boxes",
     minval = 50,
     maxval = 480
)

//======================================================================
// BOX VISIBILITY
//======================================================================

bool showRangeBoxes = input.bool(
     true,
     "Show range boxes"
)

bool showParentBox = input.bool(
     true,
     "Show parent-cycle box"
)

bool showDepth1Boxes = input.bool(
     true,
     "Show level 1 boxes"
)

bool showDepth2Boxes = input.bool(
     true,
     "Show level 2 boxes"
)

bool showDepth3Boxes = input.bool(
     true,
     "Show level 3 boxes"
)

bool showDepth4Boxes = input.bool(
     true,
     "Show level 4 boxes"
)

bool growActiveBoxWithPrice = input.bool(
     true,
     "Grow active boxes with candles"
)

//======================================================================
// BOX COLORS
//======================================================================

color firstPhaseColor = input.color(
     color.rgb(70, 120, 255),
     "First 2-phase color"
)

color middlePhaseColor = input.color(
     color.rgb(225, 80, 110),
     "Middle 1-phase color"
)

color finalPhaseColor = input.color(
     color.rgb(55, 175, 115),
     "Final 2-phase color"
)

color parentBoxColor = input.color(
     color.rgb(130, 130, 130),
     "Parent-cycle box color"
)

//======================================================================
// BOX APPEARANCE
//======================================================================

int parentBorderWidth = input.int(
     2,
     "Parent border width",
     minval = 1,
     maxval = 5
)

int primaryBorderWidth = input.int(
     2,
     "Level 1 border width",
     minval = 1,
     maxval = 5
)

int nestedBorderWidth = input.int(
     1,
     "Nested border width",
     minval = 1,
     maxval = 4
)

int parentFillTransparency = input.int(
     98,
     "Parent fill transparency",
     minval = 0,
     maxval = 100
)

int mainFillTransparency = input.int(
     90,
     "Level 1 fill transparency",
     minval = 0,
     maxval = 100
)

int transparencyPerDepth = input.int(
     3,
     "Extra fill transparency per depth",
     minval = 0,
     maxval = 10
)

int mainBorderTransparency = input.int(
     10,
     "Level 1 border transparency",
     minval = 0,
     maxval = 100
)

int borderTransparencyPerDepth = input.int(
     7,
     "Extra border transparency per depth",
     minval = 0,
     maxval = 20
)

string borderStyleInput = input.string(
     "Dotted",
     "Box border style",
     options = ["Solid", "Dashed", "Dotted"]
)

