     "Dashed",
     "Level 2 line type",
     options = ["Solid", "Dashed", "Dotted"]
)

string levelThreeStyleInput = input.string(
     "Dotted",
     "Level 3 line type",
     options = ["Solid", "Dashed", "Dotted"]
)

string levelFourStyleInput = input.string(
     "Dotted",
     "Level 4 line type",
     options = ["Solid", "Dashed", "Dotted"]
)

int levelOneWidth = input.int(
     2,
     "Level 1 line thickness",
     minval = 1,
     maxval = 5
)

int levelTwoWidth = input.int(
