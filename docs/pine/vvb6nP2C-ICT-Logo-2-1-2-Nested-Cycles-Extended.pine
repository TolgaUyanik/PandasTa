     true,
     "Show level 2 vertical lines"
)

bool showGuideLevel3 = input.bool(
     true,
     "Show level 3 vertical lines"
)

bool showGuideLevel4 = input.bool(
     true,
     "Show level 4 vertical lines"
)

bool showMainPhaseLabels = input.bool(
     false,
     "Show main 2-1-2 labels"
)

//======================================================================
// TIMING GUIDE COLORS
//======================================================================

color levelOneColor = input.color(
     color.rgb(20, 130, 255),
     "Level 1 guide color"
)

color levelTwoColor = input.color(
     color.rgb(170, 65, 210),
     "Level 2 guide color"
)

color levelThreeColor = input.color(
     color.rgb(255, 155, 30),
     "Level 3 guide color"
)

color levelFourColor = input.color(
     color.rgb(130, 130, 130),
     "Level 4 guide color"
)

