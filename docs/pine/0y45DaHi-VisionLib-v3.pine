//@version=6
library("VisionLib_v3")

// =============================================================================
// TYPE DEFINITIONS
// =============================================================================

export type Preset
    string preset_name
    color bull_body
    color bear_body
    color bull_border
    color bear_border
    color bull_wick
    color bear_wick
    int fill_transparency
    int border_transparency
    string font_family

// =============================================================================
// COLOR PRESETS (as functions - custom types cannot be exported as const)
// =============================================================================

export PRESET_DARK_THEME() =>
    Preset.new(
        preset_name = "Dark Theme",
        bull_body = color.new(#ffffff, 10),
        bear_body = color.new(#b8b8b8, 10),
        bull_border = color.new(#666666, 10),
        bear_border = color.new(#666666, 10),
        bull_wick = color.new(#666666, 10),
        bear_wick = color.new(#666666, 10),
        fill_transparency = 85,
        border_transparency = 90,
        font_family = font.family_default
    )

export PRESET_LIGHT_THEME() =>
    Preset.new(
        preset_name = "Light Theme",
        bull_body = color.new(#000000, 5),
        bear_body = color.new(#333333, 5),
        bull_border = color.new(#333333, 0),
        bear_border = color.new(#333333, 0),
        bull_wick = color.new(#333333, 0),
        bear_wick = color.new(#333333, 0),
        fill_transparency = 90,
        border_transparency = 85,
        font_family = font.family_default
    )

export PRESET_PRO_TRADING() =>
    Preset.new(
        preset_name = "Pro Trading",
        bull_body = color.new(#00ff88, 50),
        bear_body = color.new(#ff4444, 50),
        bull_border = color.new(#00ff88, 0),
        bear_border = color.new(#ff4444, 0),
        bull_wick = color.new(#00ff88, 20),
        bear_wick = color.new(#ff4444, 20),
        fill_transparency = 85,
        border_transparency = 80,
        font_family = font.family_monospace
    )

export PRESET_MINIMAL() =>
    Preset.new(
        preset_name = "Minimal",
        bull_body = color.new(#4a4a4a, 80),
        bear_body = color.new(#4a4a4a, 80),
        bull_border = color.new(#4a4a4a, 40),
        bear_border = color.new(#4a4a4a, 40),
        bull_wick = color.new(#4a4a4a, 50),
        bear_wick = color.new(#4a4a4a, 50),
        fill_transparency = 92,
        border_transparency = 95,
        font_family = font.family_default
    )

export PRESET_NIGHT_MODE() =>
    Preset.new(
        preset_name = "Night Mode",
        bull_body = color.new(#64ffda, 60),
        bear_body = color.new(#ff6b6b, 60),
        bull_border = color.new(#64ffda, 0),
        bear_border = color.new(#ff6b6b, 0),
        bull_wick = color.new(#64ffda, 30),
        bear_wick = color.new(#ff6b6b, 30),
        fill_transparency = 80,
        border_transparency = 75,
        font_family = font.family_monospace
    )

// Get preset by name
export preset(string presetName) =>
    switch presetName
        "Dark Theme" => PRESET_DARK_THEME()
        "Light Theme" => PRESET_LIGHT_THEME()
        "Pro Trading" => PRESET_PRO_TRADING()
        "Minimal" => PRESET_MINIMAL()
        "Night Mode" => PRESET_NIGHT_MODE()
        => PRESET_DARK_THEME()

// =============================================================================
// CONSTANTS (only primitives can be exported as const)
// =============================================================================

export const string DEFAULT_TIMEZONE = "America/New_York"