//@version=6
indicator("Qossai Stock Info", overlay=true)

// User Inputs
atr_period = input.int(14, title="ATR Length", minval=1)
showEarningsInfo = input.bool(true, "Show Earnings Days Remaining") // Input to toggle earnings display

// Calculate ATR and ATR %
atr = ta.atr(atr_period)
atr_percentage = (atr / close) * 100

// Market Cap Calculation
// Function to round and format large numbers for Market Cap display
rounder(float this) =>
    if na(this)
        "N/A"
    else if this >= 1000000000000 // Trillions
        str.tostring(math.round(math.abs(this / 1000000000000), 2))
    else if this >= 1000000000 // Billions
        str.tostring(math.round(math.abs(this / 1000000000), 2))
    else if this >= 1000000 // Millions
        str.tostring(math.round(math.abs(this / 1000000), 2))
    else
        str.tostring(math.round(math.abs(this), 2)) // Less than a million, display as is

// Get shares outstanding and calculate market cap
float tso = syminfo.shares_outstanding_total
float marketcap = tso * close
string marCapSuffix = marketcap >= 1000000000000 ? 'T' : marketcap >= 1000000000 ? 'B' : 'M'
string formattedMarketCap = rounder(marketcap) + marCapSuffix

// Earnings calculation
string earningsDaysRemainingStr = ""
if showEarningsInfo // Only calculate if the earnings info is enabled
    // Cast earnings.future_time to int as required by year(), month(), dayofmonth()
    int earningsTimeInt = int(earnings.future_time) 

    if not na(earningsTimeInt) // Check if an earnings date is available
        // Get today's date in UTC (normalized to midnight)
        todayUTC = timestamp(year(timenow), month(timenow), dayofmonth(timenow), 0, 0)
        // Get earnings date in UTC (normalized to midnight)
        earningsUTC = timestamp(year(earningsTimeInt), month(earningsTimeInt), dayofmonth(earningsTimeInt), 0, 0)

        // Compute the remaining days
        float timediff_ms = earningsUTC - todayUTC
        float timediff_days = timediff_ms / 86400000

        // Round to nearest full day and ensure it's not negative
        int daysRemaining = int(math.round(timediff_days))
        daysRemaining := math.max(daysRemaining, 0) // Ensure days remaining is not negative

        earningsDaysRemainingStr := str.tostring(daysRemaining) + " days remaining"

// Positioning for the table (bottom right)
// Increased rows to 5 to allow for an empty row at the bottom for spacing
var table displayTable = table.new(position.bottom_right, 1, 5, bgcolor=color.black, border_width=1)

// Update Table on the last historical bar or the current real-time bar
if barstate.islast
    int rowIndex = 0 // Initialize row index for dynamic cell placement

    // Row 0: Ticker
    table.cell(displayTable, 0, rowIndex, syminfo.ticker, text_color=color.white, text_size=size.large, text_halign=text.align_left)
    rowIndex := rowIndex + 1 // Move to the next row

    // Row 1: Market Cap
    table.cell(displayTable, 0, rowIndex, "Market Cap: " + formattedMarketCap, text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    rowIndex := rowIndex + 1 // Move to the next row

    // Row 2: ATR
    table.cell(displayTable, 0, rowIndex, "ATR(" + str.tostring(atr_period) + "): " + str.tostring(atr_percentage, "#.##") + "%", text_color=color.yellow, text_size=size.normal, text_halign=text.align_left)
    rowIndex := rowIndex + 1 // Move to the next row

    // Row 3: Earnings Info (conditional display)
    if showEarningsInfo and earningsDaysRemainingStr != ""
        table.cell(displayTable, 0, rowIndex, "Earnings: " + earningsDaysRemainingStr, text_color=color.rgb(150, 200, 255), text_size=size.normal, text_halign=text.align_left)
        rowIndex := rowIndex + 1 // Move to the next row (for the empty cell)
    
    // Row X: Empty cell to push content up
    // This cell will occupy the last row, creating a visual offset from the bottom edge.
    table.cell(displayTable, 0, rowIndex, "", text_color=color.new(color.white, 100), text_size=size.tiny)