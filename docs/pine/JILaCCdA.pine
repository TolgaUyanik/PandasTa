//@version=6
// Risk Guard - Position Size & Risk Ceiling
// Sizes your position from the risk you accept, and flags visually when the
// planned risk goes above the ceiling you set for yourself.
indicator("Risk Guard - Position Size & Risk Ceiling", shorttitle="Risk Guard", overlay=true)

grpAcc = "Account"
capital     = input.float(10000.0, "Account size",     group=grpAcc, minval=0.0, step=100)
ccy         = input.string("USD",  "Account currency", group=grpAcc)

grpRisk = "Risk"
riskPct     = input.float(1.0, "Risk for THIS trade (%)", group=grpRisk, minval=0.0, step=0.1, tooltip="The risk you take on this specific trade. It can change from one trade to the next.")
maxRiskPct  = input.float(2.0, "Your risk ceiling (%)",   group=grpRisk, minval=0.0, step=0.1, tooltip="Your personal limit. If this trade goes above it, the table switches to the alert colour.")

grpTrade = "Trade"
// Pas de confirm=true : l'indicateur s'ajoute instantanement et affiche des
// valeurs de demonstration (repli ATR). L'utilisateur saisit ensuite son trade.
entryIn     = input.price(0.0, "Entry", group=grpTrade)
stopIn      = input.price(0.0, "Stop",  group=grpTrade)
target      = input.price(0.0, "Target (optional)", group=grpTrade)
atrLen      = input.int(14, "ATR length for the fallback stop", group=grpTrade, minval=1, tooltip="Only used when Entry or Stop is left empty, so the table is never blank.")

grpInst = "Instrument"
mode        = input.string("Lots (gold, forex, CFD)", "Sizing mode", group=grpInst, options=["Lots (gold, forex, CFD)", "Units (crypto, spot)"])
contractSz  = input.float(100.0, "Contract size (1 lot)", group=grpInst, minval=0.0001, tooltip="XAUUSD standard = 100 oz per lot. Forex standard = 100000. Used in Lots mode.")
pipSize     = input.float(0.1, "Pip size", group=grpInst, minval=0.0, tooltip="Gold = 0.1, forex majors = 0.0001, JPY pairs = 0.01. Set 0 to hide pips (crypto).")

grpUI = "Display"
tblPos      = input.string("Top right", "Table position", group=grpUI, options=["Top right", "Top left", "Middle right", "Middle left", "Bottom right", "Bottom left"])
showLines   = input.bool(true, "Draw entry / stop / target lines", group=grpUI)

// ---- Style entierement personnalisable ----
grpStyle    = "Style"
colAccent   = input.color(#26d0a8, "Header, within limit",   group=grpStyle)
colAlert    = input.color(#ef5350, "Header, ceiling passed", group=grpStyle)
colBg       = input.color(#0d1117, "Table background",       group=grpStyle)
colTxt      = input.color(#e6edf3, "Text",                   group=grpStyle)
colValue    = input.color(#00d1ff, "Position size value",    group=grpStyle)
txtSizeIn   = input.string("Small", "Text size", group=grpStyle, options=["Tiny", "Small", "Normal", "Large"])
borderW     = input.int(1, "Border width", group=grpStyle, minval=0, maxval=4)
colEntry    = input.color(color.gray, "Entry line",  group=grpStyle)
colStop     = input.color(color.red,  "Stop line",   group=grpStyle)
colTarget   = input.color(color.teal, "Target line", group=grpStyle)

tSize = txtSizeIn == "Tiny" ? size.tiny : txtSizeIn == "Small" ? size.small : txtSizeIn == "Normal" ? size.normal : size.large

atrVal   = ta.atr(atrLen)
usingDef = entryIn <= 0 or stopIn <= 0
entry    = entryIn > 0 ? entryIn : close
stop     = stopIn  > 0 ? stopIn  : close - atrVal

isLots     = mode == "Lots (gold, forex, CFD)"
stopDist   = math.abs(entry - stop)
valid      = entry > 0 and stop > 0 and stopDist > 0
riskAmount = capital * riskPct / 100.0
units      = valid ? riskAmount / stopDist : 0.0
lots       = units / contractSz
isLong     = entry > stop
rr         = (valid and target > 0) ? math.abs(target - entry) / stopDist : na
targetGain = (valid and target > 0) ? rr * riskAmount : na
breach     = riskPct > maxRiskPct

stopPips = pipSize > 0 ? stopDist / pipSize : na
distTxt  = not valid ? "-" : na(stopPips) ? str.tostring(stopDist, format.mintick) : str.tostring(stopDist, format.mintick) + "  (" + str.tostring(stopPips, "#.#") + " pips)"

// Expression unique : en Pine, "x = na" est type flottant, on ne peut pas y
// reaffecter une chaine ensuite (erreur de compilation).
sizeTxt = not valid ? "-" : isLots ? str.tostring(lots, "#.####") + " lot  (" + str.tostring(units, "#.##") + " units)" : str.tostring(units, "#.####") + " units  (" + str.tostring(lots, "#.####") + " lot)"

var line lnEntry  = na
var line lnStop   = na
var line lnTarget = na

if showLines and barstate.islast and valid
    line.delete(lnEntry)
    line.delete(lnStop)
    line.delete(lnTarget)
    lnEntry := line.new(bar_index - 50, entry, bar_index + 10, entry, color=colEntry, width=1)
    lnStop  := line.new(bar_index - 50, stop, bar_index + 10, stop, color=colStop, width=1, style=line.style_dashed)
    if target > 0
        lnTarget := line.new(bar_index - 50, target, bar_index + 10, target, color=colTarget, width=1, style=line.style_dashed)

tblPosition = tblPos == "Top right" ? position.top_right : tblPos == "Top left" ? position.top_left : tblPos == "Middle right" ? position.middle_right : tblPos == "Middle left" ? position.middle_left : tblPos == "Bottom right" ? position.bottom_right : position.bottom_left

var table t = table.new(tblPosition, 2, 9, border_width=borderW)

if barstate.islast
    bg     = colBg
    txt    = colTxt
    accent = breach ? colAlert : colAccent
    riskBg = breach ? color.new(colAlert, 60) : bg

    table.cell(t, 0, 0, "RISK GUARD", bgcolor=accent, text_color=color.white, text_size=tSize)
    table.cell(t, 1, 0, isLong ? "LONG" : "SHORT", bgcolor=accent, text_color=color.white, text_size=tSize)

    table.cell(t, 0, 1, "Account", bgcolor=bg, text_color=txt, text_size=tSize)
    table.cell(t, 1, 1, str.tostring(capital, "#.##") + " " + ccy, bgcolor=bg, text_color=txt, text_size=tSize)

    table.cell(t, 0, 2, "Trade risk", bgcolor=riskBg, text_color=txt, text_size=tSize)
    table.cell(t, 1, 2, str.tostring(riskPct, "#.##") + " %  (ceiling " + str.tostring(maxRiskPct, "#.##") + " %)", bgcolor=riskBg, text_color=breach ? color.white : txt, text_size=tSize)

    table.cell(t, 0, 3, "Amount at risk", bgcolor=bg, text_color=txt, text_size=tSize)
    table.cell(t, 1, 3, str.tostring(riskAmount, "#.##") + " " + ccy, bgcolor=bg, text_color=txt, text_size=tSize)

    table.cell(t, 0, 4, "Stop distance", bgcolor=bg, text_color=txt, text_size=tSize)
    table.cell(t, 1, 4, distTxt, bgcolor=bg, text_color=txt, text_size=tSize)

    table.cell(t, 0, 5, "Position size", bgcolor=bg, text_color=txt, text_size=tSize)
    table.cell(t, 1, 5, sizeTxt, bgcolor=bg, text_color=colValue, text_size=tSize)

    table.cell(t, 0, 6, "R:R", bgcolor=bg, text_color=txt, text_size=tSize)
    table.cell(t, 1, 6, na(rr) ? "set a target" : str.tostring(rr, "#.##") + " R", bgcolor=bg, text_color=txt, text_size=tSize)

    table.cell(t, 0, 7, "Gain at target", bgcolor=bg, text_color=txt, text_size=tSize)
    table.cell(t, 1, 7, na(targetGain) ? "-" : str.tostring(targetGain, "#.##") + " " + ccy, bgcolor=bg, text_color=txt, text_size=tSize)

    warn = breach ? "Above your risk ceiling" : usingDef ? "Demo values, set your entry and stop" : "Within your limit"
    table.cell(t, 0, 8, warn, bgcolor=breach ? color.new(colAlert, 40) : bg, text_color=breach ? color.white : color.new(colTxt, 45), text_size=tSize)
    table.cell(t, 1, 8, "", bgcolor=breach ? color.new(colAlert, 40) : bg, text_size=tSize)
