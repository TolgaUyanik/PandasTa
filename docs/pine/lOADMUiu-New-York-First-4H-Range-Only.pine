//@version=6
indicator(
     title = "New York First 4H Range Only",
     shorttitle = "NY First 4H Range",
     overlay = true)

// Time zone required by the video
string TZ = "America/New_York"

// Display settings
color highColor = input.color(color.red, "Range High color")
color lowColor = input.color(color.lime, "Range Low color")
color fillColor = input.color(color.new(color.aqua, 90), "Range fill color")
int lineWidth = input.int(2, "Line width", minval = 1, maxval = 5)
bool showFill = input.bool(true, "Fill the range")

// Current New York date and hour
int nyHour = hour(time, TZ)

int nyDayKey =
     year(time, TZ) * 10000 +
     month(time, TZ) * 100 +
     dayofmonth(time, TZ)

// Detect the beginning of a new New York day
bool newNyDay =
     na(nyDayKey[1]) or
     nyDayKey != nyDayKey[1]

// First four hours: 00:00 until 04:00 New York
bool rangeBuilding =
     nyHour >= 0 and
     nyHour < 4

bool rangeFinished = nyHour >= 4

// Daily range values
var float first4HHigh = na
var float first4HLow = na
var bool rangeLocked = false

// Reset at the beginning of each New York day
if newNyDay
    first4HHigh := na
    first4HLow := na
    rangeLocked := false

// Calculate High and Low during 00:00–04:00
if rangeBuilding
    first4HHigh :=
         na(first4HHigh) ?
         high :
         math.max(first4HHigh, high)

    first4HLow :=
         na(first4HLow) ?
         low :
         math.min(first4HLow, low)

// Lock the range only after the complete four hours have closed
if rangeFinished and
     not rangeLocked and
     not na(first4HHigh) and
     not na(first4HLow)

    rangeLocked := true

// Do not show an unfinished range
float visibleHigh =
     rangeLocked ?
     first4HHigh :
     na

float visibleLow =
     rangeLocked ?
     first4HLow :
     na

// High line
highPlot = plot(
     visibleHigh,
     title = "First 4H High",
     color = highColor,
     linewidth = lineWidth,
     style = plot.style_linebr)

// Low line
lowPlot = plot(
     visibleLow,
     title = "First 4H Low",
     color = lowColor,
     linewidth = lineWidth,
     style = plot.style_linebr)

// Optional shaded area between High and Low
fill(
     highPlot,
     lowPlot,
     color = showFill ? fillColor : na,
     title = "First 4H Range")