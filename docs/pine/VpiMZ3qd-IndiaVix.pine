//@version=6
library("IndiaVix")

export getPrevDayClose(simple string _symbol = syminfo.tickerid, simple string _tf = "1D") => 
    request.security(_symbol, _tf, close[1], barmerge.gaps_off, barmerge.lookahead_on)

export getSentientValues(bool _enable, series float _vix, series float _indexInput = na, simple string _symbol = syminfo.tickerid, simple float _sigma =0.5, simple int _tredingDays=246) =>
    float index = na
    float sigmaVal = na
    float hr = na
    float lr = na
    float hr1 = na
    float lr1 = na
    if _enable and not na(_vix)
        index := not na(_indexInput) ? _indexInput :  getPrevDayClose(_symbol)
        sigmaVal := index * (_vix / 100 / math.pow(_tredingDays, _sigma))
        hr  := index + sigmaVal
        lr  := index - sigmaVal
        hr1 := hr + sigmaVal
        lr1 := lr - sigmaVal
    [index, hr, lr, hr1, lr1]

export getVix(simple string _tf = "15") =>
    [vx, pvx] = request.security("NSE:INDIAVIX", _tf, [close, close[1]], lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)

export type Vix
    float now        // current close
    float prev       // previous  close
    float eod        // prev day VIX close (15min)

export method chgVsPrev(Vix this) =>
    na(this.prev) ? na : this.now - this.prev

export method chgVsPDC(Vix this) =>
    na(this.eod) ? na : this.now - this.eod

export method dailyMovePts(Vix this, series float _c = close) =>
    na(this.now) or na(_c) ? na : this.now / 16.0 * _c / 100.0

export method isRising(Vix this) =>
    not na(this.eod) and this.now > this.eod

export method regime(Vix this) =>
    v = this.now
    na(v)  ? "—"  : v > 30   ? "🚨 EXTREME" : v > 25   ? "🔴 HIGH"    : v > 20   ? "🟠 ELEVATED": v > 15   ? "🟡 NORMAL"  : v > 12   ? "🟢 LOW"     : "⚪ VERY LOW"
