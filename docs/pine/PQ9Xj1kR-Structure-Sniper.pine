//@version=6
//@version=6
indicator("Structure Sniper — SMC + Confluence Engine", "Sniper", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═════════════════ Inputs ═════════════════
grpS = "Market Structure"
swingLen = input.int(8, "Swing Pivot Length", minval = 2, group = grpS)
showBOS = input.bool(true, "Show BOS / CHoCH", group = grpS)

grpOB = "Order Blocks"
showOB = input.bool(true, "Show Order Blocks", group = grpOB)
obLookback = input.int(15, "OB Search Lookback", minval = 3, maxval = 50, group = grpOB)
maxZones = input.int(6, "Max Zones Kept (per type)", minval = 2, maxval = 15, group = grpOB)

grpF = "Fair Value Gaps"
showFVG = input.bool(true, "Show FVGs", group = grpF)
fvgAtrMin = input.float(0.15, "Min Gap Size (ATR mult)", step = 0.05, group = grpF)

grpC = "Confluence Engine"
scoreMin = input.int(5, "Signal Threshold (max 7)", minval = 3, maxval = 7, group = grpC)
coolBars = input.int(10, "Cooldown Bars Between Signals", minval = 1, group = grpC)
showTable = input.bool(true, "Show Confluence Dashboard", group = grpC)

grpM = "Momentum (SMI Pro X logic)"
smiLen = input.int(10, "SMI Length", group = grpM)
smiSmooth = input.int(3, "SMI Smoothing", group = grpM)
mfiLen = input.int(14, "MFI Length", group = grpM)
sqzLen = input.int(20, "Squeeze Length", group = grpM)

grpE = "Envelope (Confluence Compass logic)"
envLen = input.int(50, "Envelope Window", minval = 10, maxval = 100, group = grpE)
envH = input.float(8.0, "Gaussian Bandwidth", step = 0.5, group = grpE)
envMult = input.float(3.0, "Envelope Width (MAE mult)", step = 0.25, group = grpE)
showEnv = input.bool(true, "Show Envelope Bands", group = grpE)

colBull = color.new(#26a69a, 0)
colBear = color.new(#ef5350, 0)
colBullF = color.new(#26a69a, 82)
colBearF = color.new(#ef5350, 82)
colFVGb = color.new(#2962ff, 85)
colFVGs = color.new(#ff6d00, 85)

atr = ta.atr(14)

// ═════════════════ Momentum stack ═════════════════
hh = ta.highest(high, smiLen)
ll = ta.lowest(low, smiLen)
smiD = ta.ema(ta.ema(close - 0.5 * (hh + ll), smiSmooth), smiSmooth)
smiR = ta.ema(ta.ema(hh - ll, smiSmooth), smiSmooth)
smi = smiR != 0 ? 200 * smiD / smiR : 0.0
smiSig = ta.ema(smi, smiSmooth)

mfi = ta.mfi(hlc3, mfiLen)

bbDev = 2.0 * ta.stdev(close, sqzLen)
kcDev = 1.5 * ta.sma(ta.tr(true), sqzLen)
sqzOn = bbDev < kcDev
sqzFire = not sqzOn and sqzOn[1]

// ═════════════════ Gaussian envelope (non-repainting) ═════════════════
gaussMA(src, len, h) =>
    num = 0.0
    den = 0.0
    for i = 0 to len - 1
        w = math.exp(-(i * i) / (2.0 * h * h))
        num += nz(src[i], src) * w
        den += w
    num / den

gma = gaussMA(close, envLen, envH)
mae = ta.sma(math.abs(close - gma), envLen) * envMult
upEnv = gma + mae
loEnv = gma - mae
plot(showEnv ? upEnv : na, "Upper Envelope", color.new(#ef5350, 55))
plot(showEnv ? loEnv : na, "Lower Envelope", color.new(#26a69a, 55))

// ═════════════════ Market structure ═════════════════
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastPH = na
var int lastPHBar = na
var bool phUsed = true
var float lastPL = na
var int lastPLBar = na
var bool plUsed = true
var int trendDir = 0

if not na(ph)
    lastPH := ph
    lastPHBar := bar_index - swingLen
    phUsed := false
if not na(pl)
    lastPL := pl
    lastPLBar := bar_index - swingLen
    plUsed := false

var bullOBs = array.new<box>()
var bearOBs = array.new<box>()
var bullFVGs = array.new<box>()
var bearFVGs = array.new<box>()

findOB(bool bull) =>
    int foundIdx = na
    for i = 1 to obLookback
        if bull ? close[i] < open[i] : close[i] > open[i]
            foundIdx := i
            break
    foundIdx

bullBreak = not phUsed and not na(lastPH) and close > lastPH and barstate.isconfirmed
bearBreak = not plUsed and not na(lastPL) and close < lastPL and barstate.isconfirmed

if bullBreak
    phUsed := true
    txt = trendDir == -1 ? "CHoCH" : "BOS"
    trendDir := 1
    if showBOS
        line.new(lastPHBar, lastPH, bar_index, lastPH, color = colBull, style = line.style_dashed)
        label.new(math.round(math.avg(lastPHBar, bar_index)), lastPH, txt, style = label.style_label_down, color = color.new(#26a69a, 20), textcolor = color.white, size = size.tiny)
    if showOB
        idx = findOB(true)
        if not na(idx)
            b = box.new(bar_index - idx, high[idx], bar_index, low[idx], border_color = colBull, bgcolor = colBullF)
            array.push(bullOBs, b)
            if array.size(bullOBs) > maxZones
                box.delete(array.shift(bullOBs))

if bearBreak
    plUsed := true
    txt = trendDir == 1 ? "CHoCH" : "BOS"
    trendDir := -1
    if showBOS
        line.new(lastPLBar, lastPL, bar_index, lastPL, color = colBear, style = line.style_dashed)
        label.new(math.round(math.avg(lastPLBar, bar_index)), lastPL, txt, style = label.style_label_up, color = color.new(#ef5350, 20), textcolor = color.white, size = size.tiny)
    if showOB
        idx = findOB(false)
        if not na(idx)
            b = box.new(bar_index - idx, high[idx], bar_index, low[idx], border_color = colBear, bgcolor = colBearF)
            array.push(bearOBs, b)
            if array.size(bearOBs) > maxZones
                box.delete(array.shift(bearOBs))

// ═════════════════ Fair value gaps ═════════════════
bullGap = low > high[2] and (low - high[2]) >= fvgAtrMin * atr
bearGap = high < low[2] and (low[2] - high) >= fvgAtrMin * atr

if showFVG and bullGap and barstate.isconfirmed
    b = box.new(bar_index - 2, low, bar_index, high[2], border_color = color.new(#2962ff, 60), bgcolor = colFVGb)
    array.push(bullFVGs, b)
    if array.size(bullFVGs) > maxZones
        box.delete(array.shift(bullFVGs))

if showFVG and bearGap and barstate.isconfirmed
    b = box.new(bar_index - 2, low[2], bar_index, high, border_color = color.new(#ff6d00, 60), bgcolor = colFVGs)
    array.push(bearFVGs, b)
    if array.size(bearFVGs) > maxZones
        box.delete(array.shift(bearFVGs))

// ═════════════════ Zone maintenance + touch detection ═════════════════
manage(array<box> zones, bool bull) =>
    touched = false
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            b = array.get(zones, i)
            box.set_right(b, bar_index)
            bot = box.get_bottom(b)
            top = box.get_top(b)
            if low <= top and high >= bot
                touched := true
            if bull ? close < bot : close > top
                box.delete(b)
                array.remove(zones, i)
    touched

inBullOB = manage(bullOBs, true)
inBearOB = manage(bearOBs, false)
inBullFVG = manage(bullFVGs, true)
inBearFVG = manage(bearFVGs, false)
bullZone = inBullOB or inBullFVG
bearZone = inBearOB or inBearFVG

// ═════════════════ Confluence scoring (max 7) ═════════════════
bullScore = (trendDir == 1 ? 2 : 0) + (bullZone ? 2 : 0) + (smi > smiSig ? 1 : 0) + (mfi < 40 ? 1 : 0) + (sqzFire or low < loEnv ? 1 : 0)
bearScore = (trendDir == -1 ? 2 : 0) + (bearZone ? 2 : 0) + (smi < smiSig ? 1 : 0) + (mfi > 60 ? 1 : 0) + (sqzFire or high > upEnv ? 1 : 0)

var int lastSig = -9999
buySig = bullScore >= scoreMin and bar_index - lastSig > coolBars and barstate.isconfirmed
sellSig = bearScore >= scoreMin and bar_index - lastSig > coolBars and barstate.isconfirmed and not buySig

if buySig
    lastSig := bar_index
    label.new(bar_index, low - atr, "▲ SNIPE " + str.tostring(bullScore) + "/7", style = label.style_label_up, color = colBull, textcolor = color.white, size = size.small)
if sellSig
    lastSig := bar_index
    label.new(bar_index, high + atr, "▼ SNIPE " + str.tostring(bearScore) + "/7", style = label.style_label_down, color = colBear, textcolor = color.white, size = size.small)

alertcondition(buySig, "Structure Sniper LONG", "Structure Sniper: LONG confluence fired")
alertcondition(sellSig, "Structure Sniper SHORT", "Structure Sniper: SHORT confluence fired")

// ═════════════════ Dashboard ═════════════════
var table t = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 25), border_width = 1, border_color = color.new(color.gray, 60))
if showTable and barstate.islast
    hdrC = color.new(color.black, 0)
    okC = color.new(#26a69a, 0)
    noC = color.new(color.gray, 0)
    table.cell(t, 0, 0, "STRUCTURE SNIPER", text_color = color.white, text_size = size.small, bgcolor = hdrC)
    table.cell(t, 1, 0, syminfo.ticker, text_color = color.silver, text_size = size.tiny, bgcolor = hdrC)
    table.cell(t, 0, 1, "Trend", text_color = color.silver, text_size = size.tiny)
    table.cell(t, 1, 1, trendDir == 1 ? "BULL" : trendDir == -1 ? "BEAR" : "—", text_color = trendDir == 1 ? okC : trendDir == -1 ? colBear : noC, text_size = size.tiny)
    table.cell(t, 0, 2, "In Zone (OB/FVG)", text_color = color.silver, text_size = size.tiny)
    table.cell(t, 1, 2, bullZone ? "BULL" : bearZone ? "BEAR" : "—", text_color = bullZone ? okC : bearZone ? colBear : noC, text_size = size.tiny)
    table.cell(t, 0, 3, "SMI", text_color = color.silver, text_size = size.tiny)
    table.cell(t, 1, 3, str.tostring(smi, "#.#") + (smi > smiSig ? " ▲" : " ▼"), text_color = smi > smiSig ? okC : colBear, text_size = size.tiny)
    table.cell(t, 0, 4, "MFI", text_color = color.silver, text_size = size.tiny)
    table.cell(t, 1, 4, str.tostring(mfi, "#.#"), text_color = mfi < 40 ? okC : mfi > 60 ? colBear : noC, text_size = size.tiny)
    table.cell(t, 0, 5, "Squeeze", text_color = color.silver, text_size = size.tiny)
    table.cell(t, 1, 5, sqzOn ? "ON" : sqzFire ? "FIRED" : "off", text_color = sqzOn ? color.orange : sqzFire ? okC : noC, text_size = size.tiny)
    table.cell(t, 0, 6, "Long score", text_color = color.silver, text_size = size.tiny)
    table.cell(t, 1, 6, str.tostring(bullScore) + " / 7", text_color = bullScore >= scoreMin ? okC : noC, text_size = size.tiny)
    table.cell(t, 0, 7, "Short score", text_color = color.silver, text_size = size.tiny)
    table.cell(t, 1, 7, str.tostring(bearScore) + " / 7", text_color = bearScore >= scoreMin ? colBear : noC, text_size = size.tiny)
