//@version=6

// ─────────────────────────────────────────────────────────────────
//  BBMG_ETH — research dataset library (ETHUSDT, multi-timeframe)
// ─────────────────────────────────────────────────────────────────
//  Purpose. This library is part of an ongoing RESEARCH project on
//  Bollinger Band behaviour. It publishes descriptive statistics
//  computed offline from historical market data. It contains numeric
//  tables only: no signals, no alerts, no recommendations, and no
//  forward-looking claims. Past statistics do not guarantee future
//  results. Nothing in this library is financial advice.
//
//  Usage. Every table takes a timeframe argument using TradingView's
//  timeframe.period notation ("30S" = 30 seconds, "5" = 5 minutes).
//  Unsupported timeframes return an EMPTY matrix (zero rows), so
//  consumers should check matrix.rows() before use. The list of
//  covered timeframes is available from supported_tfs(). Additional
//  timeframes are appended in future versions without changing any
//  function signature.
//
//  Version 3. Adds the lower-band mirror (tbl_engagement_lo,
//  tbl_age3_lo) and a calibrated thresholds table (tbl_rules).
//  All previous tables are unchanged.
//
//  Dataset provenance, per covered timeframe.
//    [30S] ETHUSDT (Binance), 30-second bars — paired exports of one
//          window starting 2026-07-05 03:00 (UTC+3):
//          upper-band tables : export to 2026-07-19 23:17 · 42,750
//          bars · 3,133 swings (1,555 upward)
//          lower-band tables : export to 2026-07-20 00:04 · 42,844
//          bars · 1,582 downward swings
//          Swing detection: adaptive ZigZag, amplitude unit equal to
//          sigma * sqrt(23), measured in natural-log price space
//          Conventions: "birth" values at a swing's first bar;
//          "age 3" values at its fourth bar of life, for swings that
//          lived at least 3 bars.

// @description Research dataset: descriptive Bollinger Band statistics for ETHUSDT across timeframes. Numeric tables only; no signals or advice.
library("BBMG_ETH")

// ─── private per-timeframe builders ───

f_meta_30s() =>
    array.from(42750.0, 3133.0, 1555.0)

f_eng_30s() =>
    matrix<float> m = matrix.new<float>(0, 7)
    matrix.add_row(m, 0, array.from(1.0, 605.0, 38.9, 1.41, 1.0, 18.2,  6.0))
    matrix.add_row(m, 1, array.from(2.0, 163.0, 10.5, 1.75, 2.0, 36.2, 11.0))
    matrix.add_row(m, 2, array.from(3.0, 615.0, 39.5, 2.25, 3.0, 62.8, 14.0))
    matrix.add_row(m, 3, array.from(4.0, 172.0, 11.1, 2.85, 4.0, 84.3, 17.0))
    m

f_tempo_30s() =>
    matrix<float> m = matrix.new<float>(0, 4)
    matrix.add_row(m, 0, array.from(1.0,  1.0, 0.194, 0.444))
    matrix.add_row(m, 1, array.from(2.0,  2.0, 0.147, 0.295))
    matrix.add_row(m, 2, array.from(3.0,  3.0, 0.130, 0.243))
    matrix.add_row(m, 3, array.from(4.0,  4.0, 0.121, 0.186))
    matrix.add_row(m, 4, array.from(5.0, 10.0, 0.125, 0.171))
    m

f_birth_30s() =>
    matrix<float> m = matrix.new<float>(0, 13)
    matrix.add_row(m, 0, array.from(1.0,  2.0,  1.0, 35.97, 15.79, 64.65, 2.11, 1.06, 4.80, 0.343, 0.069, 0.847, 855.0))
    matrix.add_row(m, 1, array.from(3.0,  4.0,  1.0, 41.65, 18.11, 68.15, 2.00, 0.97, 4.63, 0.350, 0.065, 0.804, 594.0))
    matrix.add_row(m, 2, array.from(5.0, 10.0,  1.0, 53.43, 22.88, 74.90, 2.69, 1.32, 9.78, 0.227, 0.049, 0.666, 106.0))
    matrix.add_row(m, 3, array.from(1.0,  2.0, -1.0, 11.81,  2.04, 31.21, 2.10, 1.10, 4.88, 0.652, 0.078, 0.945, 895.0))
    matrix.add_row(m, 4, array.from(3.0,  4.0, -1.0, 11.64,  2.49, 27.56, 1.98, 1.01, 4.28, 0.570, 0.082, 0.926, 581.0))
    matrix.add_row(m, 5, array.from(5.0, 10.0, -1.0,  5.16, -0.69, 16.62, 2.87, 1.56, 8.06, 0.685, 0.304, 0.957, 102.0))
    m

f_age3_30s() =>
    matrix<float> m = matrix.new<float>(0, 14)
    matrix.add_row(m, 0, array.from(1.0, 34.94, 17.79, 63.81, 1.17, 0.80, 1.97, 0.659, 0.522, 0.769,  8.5, 5.0, 12.7, 515.0))
    matrix.add_row(m, 1, array.from(2.0, 23.58, 12.75, 45.49, 1.15, 0.68, 1.90, 0.590, 0.488, 0.691,  7.6, 4.5, 11.9, 146.0))
    matrix.add_row(m, 2, array.from(3.0, 25.04,  9.86, 45.81, 1.18, 0.77, 1.93, 0.654, 0.529, 0.766,  9.0, 5.5, 14.2, 540.0))
    matrix.add_row(m, 3, array.from(4.0, 10.25,  1.16, 34.96, 1.45, 0.82, 3.08, 0.721, 0.599, 0.866, 12.2, 6.1, 18.6, 165.0))
    m

f_eng_lo_30s() =>
    matrix<float> m = matrix.new<float>(0, 7)
    matrix.add_row(m, 0, array.from(1.0, 685.0, 43.3, 1.43, 2.0, 17.8,  7.0))
    matrix.add_row(m, 1, array.from(2.0, 155.0,  9.8, 1.82, 2.0, 41.3, 11.0))
    matrix.add_row(m, 2, array.from(3.0, 574.0, 36.3, 2.25, 3.0, 62.0, 14.0))
    matrix.add_row(m, 3, array.from(4.0, 168.0, 10.6, 2.81, 3.0, 84.5, 19.0))
    m

f_age3_lo_30s() =>
    matrix<float> m = matrix.new<float>(0, 14)
    matrix.add_row(m, 0, array.from(1.0, 39.11, 19.26, 65.22, 1.26, 0.87, 1.98, 0.358, 0.226, 0.478,  9.1, 5.3, 14.0, 583.0))
    matrix.add_row(m, 1, array.from(2.0, 30.59, 11.49, 55.88, 1.22, 0.67, 1.79, 0.357, 0.232, 0.465,  9.6, 6.1, 15.7, 141.0))
    matrix.add_row(m, 2, array.from(3.0, 20.53,  7.09, 43.14, 1.28, 0.82, 1.99, 0.347, 0.233, 0.463,  9.9, 6.5, 14.4, 500.0))
    matrix.add_row(m, 3, array.from(4.0, 13.04,  0.81, 36.76, 1.87, 1.00, 4.20, 0.302, 0.169, 0.432, 13.4, 8.2, 21.0, 158.0))
    m

f_rules_30s() =>
    matrix<float> m = matrix.new<float>(0, 5)
    matrix.add_row(m, 0, array.from(1.0,  1.0,  5.0, 0.0, 0.0))
    matrix.add_row(m, 1, array.from(2.0,  1.0, 10.0, 1.4, 0.6))
    matrix.add_row(m, 2, array.from(3.0, -1.0,  5.0, 0.0, 0.0))
    matrix.add_row(m, 3, array.from(4.0, -1.0, 10.0, 1.4, 0.4))
    matrix.add_row(m, 4, array.from(5.0,  1.0,  3.0, 0.0, 0.0))
    matrix.add_row(m, 5, array.from(6.0,  1.0, 12.0, 0.0, 0.0))
    matrix.add_row(m, 6, array.from(7.0, -1.0,  3.0, 0.0, 0.0))
    m

// ─── public exports ───

// @function Timeframes covered by this version, in timeframe.period notation.
// @returns array<string>
export supported_tfs() =>
    array.from("30S")

// @function Dataset metadata for a timeframe.
// @param tf Timeframe in timeframe.period notation.
// @returns array<float> [bars, totalSwings, upSwings]; empty if uncovered.
export meta(string tf) =>
    switch tf
        "30S" => f_meta_30s()
        => array.new<float>(0)

// Engagement census: how upward swings relate to the upper band.
// One row per engagement class, ordered by increasing strength.
//   c0 classId   1 = never reached the band
//                2 = high touched, close never crossed
//                3 = close crossed, fewer than 3 consecutive closes above
//                4 = 3 or more consecutive closes above (band walk)
//   c1 count · c2 sharePct · c3 medianAmpSigma · c4 medianGrade
//   c5 gradeGE3SharePct · c6 medianDurationBars
// @function Upward-swing vs upper-band engagement census.
// @param tf Timeframe in timeframe.period notation.
// @returns matrix<float> 4 rows x 7 columns; empty if uncovered.
export tbl_engagement(string tf) =>
    switch tf
        "30S" => f_eng_30s()
        => matrix.new<float>(0, 7)

// Lower-band mirror of tbl_engagement, for downward swings.
//   c0 classId   1 = never reached the band
//                2 = low touched, close never crossed
//                3 = close crossed, fewer than 3 consecutive closes below
//                4 = 3 or more consecutive closes below (band walk)
//   remaining columns identical in meaning to tbl_engagement.
// @function Downward-swing vs lower-band engagement census.
// @param tf Timeframe in timeframe.period notation.
// @returns matrix<float> 4 rows x 7 columns; empty if uncovered.
export tbl_engagement_lo(string tf) =>
    switch tf
        "30S" => f_eng_lo_30s()
        => matrix.new<float>(0, 7)

// Tempo thresholds: terciles of swing intensity (amplitude / duration,
// sigma units per bar) inside each amplitude grade. Descriptive
// statistics of this dataset.
//   c0 gradeLo · c1 gradeHi · c2 slowThreshold · c3 fastThreshold
// @function Per-grade tempo tercile thresholds.
// @param tf Timeframe in timeframe.period notation.
// @returns matrix<float> 5 rows x 4 columns; empty if uncovered.
export tbl_tempo_thr(string tf) =>
    switch tf
        "30S" => f_tempo_30s()
        => matrix.new<float>(0, 4)

// Swing-birth statistics per amplitude family and direction.
// Three measurement axes, each as median / 25th / 75th percentile:
// upper-band angular distance (degrees), normalized volume, buy fraction.
// Row order is part of the table contract: rows 0-2 upward swings
// (families 1-2, 3-4, 5+), rows 3-5 downward swings (same families).
//   c0 gradeLo · c1 gradeHi · c2 dir (+1 up, -1 down)
//   c3 duMed  · c4 duP25  · c5 duP75
//   c6 nvMed  · c7 nvP25  · c8 nvP75
//   c9 bfMed  · c10 bfP25 · c11 bfP75
//   c12 sampleCount
// @function Swing-birth statistics table.
// @param tf Timeframe in timeframe.period notation.
// @returns matrix<float> 6 rows x 13 columns; empty if uncovered.
export tbl_birth(string tf) =>
    switch tf
        "30S" => f_birth_30s()
        => matrix.new<float>(0, 13)

// Age-3 statistics of upward swings, grouped by the upper-band
// engagement class the swing eventually realised (same classIds as
// tbl_engagement). Values measured at swing age 3, for swings that
// lived at least 3 bars. Four measurement axes, each as
// median / 25th / 75th percentile: upper-band angular distance
// (degrees), normalized volume (median of first 4 bars), buy fraction
// (median of first 4 bars), and log-price climb from the swing's first
// bar low to the age-3 high, in basis points.
//   c0 classId
//   c1 duMed   · c2 duP25   · c3 duP75
//   c4 nvMed   · c5 nvP25   · c6 nvP75
//   c7 bfMed   · c8 bfP25   · c9 bfP75
//   c10 climbMed · c11 climbP25 · c12 climbP75
//   c13 sampleCount
// @function Upward-swing age-3 statistics table.
// @param tf Timeframe in timeframe.period notation.
// @returns matrix<float> 4 rows x 14 columns; empty if uncovered.
export tbl_age3(string tf) =>
    switch tf
        "30S" => f_age3_30s()
        => matrix.new<float>(0, 14)

// Lower-band mirror of tbl_age3, for downward swings vs the lower band.
// Axes: lower-band angular distance at age 3 (degrees), normalized
// volume and buy fraction (medians of first 4 bars), and log-price fall
// from the swing's first bar high to the age-3 low, in basis points.
// Column layout identical to tbl_age3.
// @function Downward-swing age-3 statistics table.
// @param tf Timeframe in timeframe.period notation.
// @returns matrix<float> 4 rows x 14 columns; empty if uncovered.
export tbl_age3_lo(string tf) =>
    switch tf
        "30S" => f_age3_lo_30s()
        => matrix.new<float>(0, 14)

// Calibrated screening thresholds derived from the same offline studies.
// One row per rule; unused parameters are 0. Consumers decide how to
// interpret and combine these values.
//   c0 ruleId :
//     1 upper age-3 proximity, tight        (angDist <= p1)
//     2 upper age-3 combo   (angDist <= p1, normVol >= p2, buyFrac >= p3)
//     3 lower age-3 proximity, tight        (angDist <= p1)
//     4 lower age-3 combo   (angDist <= p1, normVol >= p2, buyFrac <= p3)
//     5 upper first-cross swing age, fresh  (age <= p1)
//     6 upper first-cross swing age, late   (age >= p1)
//     7 lower first-cross swing age, fresh  (age <= p1)
//   c1 side (+1 upper band / -1 lower band) · c2 p1 · c3 p2 · c4 p3
// @function Calibrated screening thresholds table.
// @param tf Timeframe in timeframe.period notation.
// @returns matrix<float> 7 rows x 5 columns; empty if uncovered.
export tbl_rules(string tf) =>
    switch tf
        "30S" => f_rules_30s()
        => matrix.new<float>(0, 5)