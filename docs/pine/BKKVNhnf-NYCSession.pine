//@version=6
// @description Library for New York trading session time functions
// @author abneralvarado
// @version 1.0

library("NYCSession")

// Constants for default session times
int NY_SESSION_DEFAULT_START = 0930  // 9:30 AM ET
int NY_SESSION_DEFAULT_END = 1600    // 4:00 PM ET

// @function Determines if the current bar is within New York trading session
// @param sessionStart Starting time of NY session in 24hr format (HHMM) like 0930 for 9:30 AM ET
// @param sessionEnd Ending time of NY session in 24hr format (HHMM) like 1600 for 4:00 PM ET
// @returns True if current bar is within the NY session time, false otherwise
export isInNYSession(simple int sessionStart = 0930, simple int sessionEnd = 1600) =>
    // Get current time in New York timezone
    t = time
    
    // Extract hour and minute from timestamp
    h = hour(t, "America/New_York")
    m = minute(t, "America/New_York")
    
    // Convert current time to HHMM format for easy comparison
    currentTime = h * 100 + m
    
    // Check if we're within the session timeframe
    isInSession = currentTime >= sessionStart and currentTime < sessionEnd
    isInSession

// @function Gets the start time of NY session for a given bar
// @param lookback Bar index to check (0 is current bar)
// @param sessionStart Starting time of NY session in 24hr format (HHMM)
// @returns Unix timestamp for the start of NY session on the given bar's date
export getNYSessionStartTime(simple int lookback = 0, simple int sessionStart = 0930) =>
    t = time[lookback]
    
    // Extract date components in New York timezone
    y = year(t, "America/New_York")
    m = month(t, "America/New_York")
    d = dayofmonth(t, "America/New_York")
    
    // Get hours and minutes from session start time
    sessionStartHour = math.floor(sessionStart / 100)
    sessionStartMinute = sessionStart % 100
    
    // Create timestamp for session start (timezone parameter not supported)
    sessionStartTimestamp = timestamp(y, m, d, sessionStartHour, sessionStartMinute)
    sessionStartTimestamp

// @function Gets the end time of NY session for a given bar
// @param lookback Bar index to check (0 is current bar)
// @param sessionEnd Ending time of NY session in 24hr format (HHMM)
// @returns Unix timestamp for the end of NY session on the given bar's date
export getNYSessionEndTime(simple int lookback = 0, simple int sessionEnd = 1600) =>
    t = time[lookback]
    
    // Extract date components in New York timezone
    y = year(t, "America/New_York")
    m = month(t, "America/New_York")
    d = dayofmonth(t, "America/New_York")
    
    // Get hours and minutes from session end time
    sessionEndHour = math.floor(sessionEnd / 100)
    sessionEndMinute = sessionEnd % 100
    
    // Create timestamp for session end (timezone parameter not supported)
    sessionEndTimestamp = timestamp(y, m, d, sessionEndHour, sessionEndMinute)
    sessionEndTimestamp

// @function Checks if current bar opens the NY session
// @param sessionStart Starting time of NY session in 24hr format (HHMM)
// @returns True if current bar marks the session opening, false otherwise
export isNYSessionOpen(simple int sessionStart = 0930) =>
    t = time
    tPrev = time[1]
    
    // Extract hour and minute in New York timezone
    h = hour(t, "America/New_York")
    m = minute(t, "America/New_York")
    hPrev = hour(tPrev, "America/New_York")
    mPrev = minute(tPrev, "America/New_York")
    
    // Convert to HHMM format
    currentTime = h * 100 + m
    prevTime = hPrev * 100 + mPrev
    
    // Check if we've just crossed the session start time
    isSessionOpen = currentTime >= sessionStart and prevTime < sessionStart
    isSessionOpen

// @function Checks if current bar closes the NY session
// @param sessionEnd Ending time of NY session in 24hr format (HHMM)
// @returns True if current bar marks the session closing, false otherwise
export isNYSessionClose(simple int sessionEnd = 1600) =>
    t = time
    tPrev = time[1]
    
    // Extract hour and minute in New York timezone
    h = hour(t, "America/New_York")
    m = minute(t, "America/New_York")
    hPrev = hour(tPrev, "America/New_York")
    mPrev = minute(tPrev, "America/New_York")
    
    // Convert to HHMM format
    currentTime = h * 100 + m
    prevTime = hPrev * 100 + mPrev
    
    // Check if we've just crossed the session end time
    isSessionClose = currentTime >= sessionEnd and prevTime < sessionEnd
    isSessionClose

// @function Gets session background color with transparency
// @param sessionStart Starting time of NY session in 24hr format (HHMM)
// @param sessionEnd Ending time of NY session in 24hr format (HHMM)
// @param bgColor Background color for session highlighting
// @returns Color value for background or na if not in session
export getSessionBackgroundColor(simple int sessionStart = 0930, 
                          simple int sessionEnd = 1600,
                          color bgColor = #0000FF50) =>
    isSession = isInNYSession(sessionStart, sessionEnd)
    isSession ? bgColor : na