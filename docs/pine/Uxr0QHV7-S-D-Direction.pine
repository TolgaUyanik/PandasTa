//@version=5
indicator("S&D Direction", overlay=true, dynamic_requests=true)

// Inputs
TF1 = input.timeframe("", title="Timeframe 1")
TF2 = input.timeframe("", title="Timeframe 2")
TF3 = input.timeframe("", title="Timeframe 3")
TF4 = input.timeframe("", title="Timeframe 4")
TF5 = input.timeframe("", title="Timeframe 5")

formatTF(tf) =>
    out = tf
    out := str.replace(out, "720", "12H")
    out := str.replace(out, "600", "10H")
    out := str.replace(out, "480", "8H")
    out := str.replace(out, "360", "6H")
    out := str.replace(out, "300", "5H")
    out := str.replace(out, "240", "4H")
    out := str.replace(out, "180", "3H")
    out := str.replace(out, "120", "2H")
    out := str.replace(out, "60",  "1H")
    out + " Direction"

// --- FIX: считаем только на подтверждённых барах HTF/LTF
getDirection(tf) =>
    int direction = 0  // FIX: без var, чтобы не залипало между вызовами
    // Берём ЗАКРЫТИЕ предыдущего бара и хай/лоу бара до него (т.е. сравнение close[1] vs high/low[2])
    c = request.security(syminfo.tickerid, tf, close[1],  barmerge.gaps_off, barmerge.lookahead_off)
    h = request.security(syminfo.tickerid, tf, high[2],   barmerge.gaps_off, barmerge.lookahead_off)
    l = request.security(syminfo.tickerid, tf, low[2],    barmerge.gaps_off, barmerge.lookahead_off)

    // Ищем ближайшую (за последние 50) ситуацию закрытия вне диапазона предыдущего бара
    for i = 0 to 49
        if not na(c[i]) and not na(h[i]) and c[i] > h[i]
            direction := 1
            break
        if not na(c[i]) and not na(l[i]) and c[i] < l[i]
            direction := -1
            break
    direction

// Directions
dir_TF1 = TF1 != "" ? getDirection(TF1) : na
dir_TF2 = TF2 != "" ? getDirection(TF2) : na
dir_TF3 = TF3 != "" ? getDirection(TF3) : na
dir_TF4 = TF4 != "" ? getDirection(TF4) : na
dir_TF5 = TF5 != "" ? getDirection(TF5) : na

// Colors
var color longColor   = color.rgb(76, 175, 79)
var color shortColor  = color.rgb(244, 67, 54)
var color neutralText = color.new(color.white, 40)

// Helper for color by dir
col(dir) =>
    dir == 1 ? longColor : dir == -1 ? shortColor : neutralText

// Table
var table directionTable = table.new(position.top_right, 2, 5, bgcolor=#00000000, border_width=0)

// Fill
if TF1 != ""
    table.cell(directionTable, 0, 0, formatTF(TF1), text_color=col(dir_TF1), text_size=size.normal)
if TF2 != ""
    table.cell(directionTable, 0, 1, formatTF(TF2), text_color=col(dir_TF2), text_size=size.normal)
if TF3 != ""
    table.cell(directionTable, 0, 2, formatTF(TF3), text_color=col(dir_TF3), text_size=size.normal)
if TF4 != ""
    table.cell(directionTable, 0, 3, formatTF(TF4), text_color=col(dir_TF4), text_size=size.normal)
if TF5 != ""
    table.cell(directionTable, 0, 4, formatTF(TF5), text_color=col(dir_TF5), text_size=size.normal)
