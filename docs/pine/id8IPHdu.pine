// ══════════════════════════════════════════════════════════════════════════════
//  🎯  LÓGICA DE REBOTE (ANTI-STACKING) — compartida por todos los niveles
//
//  CANDADOS (todos deben cumplirse para comprar):
//   1. Trigger: el fondo del ciclo tocó el precio del nivel pendiente.
//   2. Separación: el fondo está al menos min_gap_pct% DEBAJO del último fill.
//      → garantiza distancia mínima real entre compras consecutivas.
//   3. Fondo confirmado: pasaron confirm_bars velas SIN nuevo mínimo.
//      → la vela que hizo el fondo no puede dispararse a sí misma.
//   4. Rebote: el close recuperó rebound_pct% desde el fondo.
//   5. Vela verde (opcional) + zona lateral (filtro original).
// ══════════════════════════════════════════════════════════════════════════════

// Tracking del mínimo del ciclo y de las velas transcurridas sin nuevo mínimo
if strategy.position_size > 0
    made_new_low = na(cycle_low) or low < cycle_low
    cycle_low := na(cycle_low) ? low : math.min(cycle_low, low)
    bars_since_low := made_new_low ? 0 : bars_since_low + 1

// Trigger del nivel DCA actualmente pendiente
cur_trigger = not na(ep1) and level >= 1 and level <= max_levels ? ep1 * (1.0 - get_drop(level) / 100.0) : na

// CANDADO 1: el fondo tocó el trigger del nivel
trigger_ok = not na(cycle_low) and not na(cur_trigger) and cycle_low <= cur_trigger

// CANDADO 2: separación mínima — el fondo perforó el último fill por min_gap_pct%
gap_ok = na(last_fill) or (not na(cycle_low) and cycle_low <= last_fill * (1.0 - min_gap_pct / 100.0))

if strategy.position_size > 0 and use_rebound and not dca_armed and trigger_ok and gap_ok
    dca_armed := true

// CANDADO 3: el fondo no es de esta vela (pasaron N velas sin nuevo mínimo)
hold_ok = bars_since_low >= confirm_bars

// CANDADO 4: el precio rebota desde el fondo del ciclo
rebound_ok   = not na(cycle_low) and close >= cycle_low * (1.0 + rebound_pct / 100.0)

// CANDADO 5: vela verde (opcional)
green_ok     = not require_green or close > open

rebound_fire = dca_armed and hold_ok and rebound_ok and green_ok

// Capturar el nivel antes de las entradas para detectar fills de esta barra
level_before = level

// 🔒 CANDADO ANTI-CASCADA (clave): solo UNA compra puede ejecutarse por vela.
// Sin esto, los 50 bloques if se encadenan en la misma barra (level 1→2→3…→50)
// y todas las flechas quedan apiladas en un único punto.
bought_this_bar = false

// ══════════════════════════════════════════════════════════════════════════════
//  🟢  ENTRADAS
//  Con rebote ON, la condición de precio (close <= tN) se reemplaza por
//  rebound_fire (armado + rebote confirmado). El filtro lateral se mantiene.
// ══════════════════════════════════════════════════════════════════════════════

// ── ENTRADA INICIAL (clásica: caída desde swing high + zona lateral) ─────────
ini_cond = level == 0
         and not na(swing_high)
         and close <= swing_high * (1.0 - drop_init / 100.0)  // Caída desde swing high
         and is_lateral                                         // En zona consolidación
         and close > 0                                          // Protección precio inválido
         and not bought_this_bar

if ini_cond
    strategy.entry("Entry", strategy.long, qty=usd(0)/close, comment="🟢 Entry")
    bought_this_bar := true
    level     := 1
    ep1       := close
    total_inv := usd(0)
    last_fill := close
    cycle_low := na
    dca_armed := false
    bars_since_low := 0
    await_reentry := false        // ← entrada clásica consume el flag de re-entrada

// ── RE-ENTRADA POR TENDENCIA (UNA sola vez tras vender) ───────────────────────
// Segunda puerta de entrada: se arma al vender (await_reentry) y dispara cuando
// la tendencia es claramente alcista. Entra como nivel 0 normal.
tr_cond = use_trend_reentry and level == 0  and await_reentry    and trend_bullish  and close > 0  and not bought_this_bar

if tr_cond
    strategy.entry("Entry", strategy.long, qty=usd(0)/close, comment="🚀 Re-Entry")
    bought_this_bar := true
    level     := 1
    ep1       := close
    total_inv := usd(0)
    last_fill := close
    cycle_low := na
    dca_armed := false
    bars_since_low := 0
    await_reentry := false        // ← una sola re-entrada por venta

// ── DCA 1 ─────────────────────────────────────────────────────────────────
if level == 1 and max_levels >= 1 and not na(t1) and (use_rebound ? rebound_fire : close <= t1) and is_lateral and not bought_this_bar
    strategy.entry("DCA-1", strategy.long, qty=usd(1)/close, comment="DCA-1")
    bought_this_bar := true
    level     := 2
    total_inv += usd(1)

// ── DCA 2 ─────────────────────────────────────────────────────────────────
if level == 2 and max_levels >= 2 and not na(t2) and (use_rebound ? rebound_fire : close <= t2) and is_lateral and not bought_this_bar
