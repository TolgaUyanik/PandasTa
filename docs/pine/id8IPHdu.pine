    total_inv += usd(36)

// ── DCA 37 ─────────────────────────────────────────────────────────────────
if level == 37 and max_levels >= 37 and not na(t37) and (use_rebound ? rebound_fire : close <= t37) and is_lateral and not bought_this_bar
    strategy.entry("DCA-37", strategy.long, qty=usd(37)/close, comment="DCA-37")
    bought_this_bar := true
    level     := 38
    total_inv += usd(37)

// ── DCA 38 ─────────────────────────────────────────────────────────────────
if level == 38 and max_levels >= 38 and not na(t38) and (use_rebound ? rebound_fire : close <= t38) and is_lateral and not bought_this_bar
    strategy.entry("DCA-38", strategy.long, qty=usd(38)/close, comment="DCA-38")
    bought_this_bar := true
    level     := 39
    total_inv += usd(38)

// ── DCA 39 ─────────────────────────────────────────────────────────────────
if level == 39 and max_levels >= 39 and not na(t39) and (use_rebound ? rebound_fire : close <= t39) and is_lateral and not bought_this_bar
    strategy.entry("DCA-39", strategy.long, qty=usd(39)/close, comment="DCA-39")
    bought_this_bar := true
    level     := 40
    total_inv += usd(39)

// ── DCA 40 ─────────────────────────────────────────────────────────────────
if level == 40 and max_levels >= 40 and not na(t40) and (use_rebound ? rebound_fire : close <= t40) and is_lateral and not bought_this_bar
    strategy.entry("DCA-40", strategy.long, qty=usd(40)/close, comment="DCA-40")
    bought_this_bar := true
    level     := 41
    total_inv += usd(40)

// ── DCA 41 ─────────────────────────────────────────────────────────────────
if level == 41 and max_levels >= 41 and not na(t41) and (use_rebound ? rebound_fire : close <= t41) and is_lateral and not bought_this_bar
    strategy.entry("DCA-41", strategy.long, qty=usd(41)/close, comment="DCA-41")
    bought_this_bar := true
    level     := 42
    total_inv += usd(41)

// ── DCA 42 ─────────────────────────────────────────────────────────────────
if level == 42 and max_levels >= 42 and not na(t42) and (use_rebound ? rebound_fire : close <= t42) and is_lateral and not bought_this_bar
    strategy.entry("DCA-42", strategy.long, qty=usd(42)/close, comment="DCA-42")
    bought_this_bar := true
    level     := 43
    total_inv += usd(42)

// ── DCA 43 ─────────────────────────────────────────────────────────────────
if level == 43 and max_levels >= 43 and not na(t43) and (use_rebound ? rebound_fire : close <= t43) and is_lateral and not bought_this_bar
    strategy.entry("DCA-43", strategy.long, qty=usd(43)/close, comment="DCA-43")
    bought_this_bar := true
    level     := 44
    total_inv += usd(43)

// ── DCA 44 ─────────────────────────────────────────────────────────────────
if level == 44 and max_levels >= 44 and not na(t44) and (use_rebound ? rebound_fire : close <= t44) and is_lateral and not bought_this_bar
    strategy.entry("DCA-44", strategy.long, qty=usd(44)/close, comment="DCA-44")
    bought_this_bar := true
    level     := 45
    total_inv += usd(44)

// ── DCA 45 ─────────────────────────────────────────────────────────────────
if level == 45 and max_levels >= 45 and not na(t45) and (use_rebound ? rebound_fire : close <= t45) and is_lateral and not bought_this_bar
    strategy.entry("DCA-45", strategy.long, qty=usd(45)/close, comment="DCA-45")
    bought_this_bar := true
    level     := 46
    total_inv += usd(45)

// ── DCA 46 ─────────────────────────────────────────────────────────────────
if level == 46 and max_levels >= 46 and not na(t46) and (use_rebound ? rebound_fire : close <= t46) and is_lateral and not bought_this_bar
    strategy.entry("DCA-46", strategy.long, qty=usd(46)/close, comment="DCA-46")
    bought_this_bar := true
    level     := 47
    total_inv += usd(46)

// ── DCA 47 ─────────────────────────────────────────────────────────────────
if level == 47 and max_levels >= 47 and not na(t47) and (use_rebound ? rebound_fire : close <= t47) and is_lateral and not bought_this_bar
    strategy.entry("DCA-47", strategy.long, qty=usd(47)/close, comment="DCA-47")
    bought_this_bar := true
    level     := 48
    total_inv += usd(47)

// ── DCA 48 ─────────────────────────────────────────────────────────────────
if level == 48 and max_levels >= 48 and not na(t48) and (use_rebound ? rebound_fire : close <= t48) and is_lateral and not bought_this_bar
    strategy.entry("DCA-48", strategy.long, qty=usd(48)/close, comment="DCA-48")
    bought_this_bar := true
    level     := 49
    total_inv += usd(48)

// ── DCA 49 ─────────────────────────────────────────────────────────────────
if level == 49 and max_levels >= 49 and not na(t49) and (use_rebound ? rebound_fire : close <= t49) and is_lateral and not bought_this_bar
    strategy.entry("DCA-49", strategy.long, qty=usd(49)/close, comment="DCA-49")
    bought_this_bar := true
    level     := 50
    total_inv += usd(49)

// ── DCA 50 ─────────────────────────────────────────────────────────────────
if level == 50 and max_levels >= 50 and not na(t50) and (use_rebound ? rebound_fire : close <= t50) and is_lateral and not bought_this_bar
    strategy.entry("DCA-50", strategy.long, qty=usd(50)/close, comment="DCA-50")
    bought_this_bar := true
    level     := 51
    total_inv += usd(50)

// ── Post-fill: si un DCA se ejecutó en esta barra, resetear el ciclo de rebote ──
// (hace falta un NUEVO fondo para armar el próximo nivel)
if level > level_before and level_before >= 1
    last_fill := close
    dca_armed := false
    cycle_low := na
    bars_since_low := 0

// ══════════════════════════════════════════════════════════════════════════════
//  🏁  SALIDA NORMAL (VWM + Supertrend) + ⚖️ MODO RESCATE BREAKEVEN
// ══════════════════════════════════════════════════════════════════════════════

avg_cost  = strategy.position_avg_price
in_profit = strategy.position_size > 0
          and close > avg_cost * (1.0 + min_profit / 100.0)

exit_signal = in_profit and (impulse_dead or (use_st_exit and st_bear_flip))

// ── MODO RESCATE: breakeven tras acumulación profunda de DCAs ────────────────
// P&L USD abierto = strategy.openprofit (lo mismo que muestra el dashboard)
filled_dcas = level > 0 ? level - 1 : 0
rescue_mode = strategy.position_size > 0 and filled_dcas >= rescue_levels

// Armar el breakeven cuando la posición rescatada supera una pequeña ganancia
if rescue_mode and close >= avg_cost * (1.0 + be_arm_pct / 100.0)
    be_armed := true

// Disparo: el P&L USD abierto vuelve a 0 → cerrar todo, no volver al rojo
be_exit = strategy.position_size > 0 and be_armed and strategy.openprofit <= 0.0

if exit_signal
    strategy.close_all(comment="🏁 Exit")
else if be_exit
    strategy.close_all(comment="⚖️ BE Exit")

// ══════════════════════════════════════════════════════════════════════════════
//  🎨  VISUALIZACIÓN EN EL GRÁFICO
// ══════════════════════════════════════════════════════════════════════════════

// ── Paleta de colores para los niveles DCA ───────────────────────────────────
c(n) => n == 1 ? color.new(color.orange,  30) :  n == 2 ? color.new(color.red,     30) :  n == 3 ? color.new(color.purple,  30) :   n == 4 ? color.new(color.maroon,  30) :   n == 5 ? color.new(color.fuchsia, 30) :  n == 6 ? color.new(color.teal,    30) :   n == 7 ? color.new(color.olive,   30) :  n == 8 ? color.new(color.navy,    30) :           color.new(color.silver,  30)
plot(level >= 1 and max_levels >= 1 and not na(t1) ? t1 : na, "DCA-1", color=c(1), style=plot.style_linebr, linewidth=1)
plot(level >= 2 and max_levels >= 2 and not na(t2) ? t2 : na, "DCA-2", color=c(2), style=plot.style_linebr, linewidth=1)
plot(level >= 3 and max_levels >= 3 and not na(t3) ? t3 : na, "DCA-3", color=c(3), style=plot.style_linebr, linewidth=1)
plot(level >= 4 and max_levels >= 4 and not na(t4) ? t4 : na, "DCA-4", color=c(4), style=plot.style_linebr, linewidth=1)
plot(level >= 5 and max_levels >= 5 and not na(t5) ? t5 : na, "DCA-5", color=c(5), style=plot.style_linebr, linewidth=1)
plot(level >= 6 and max_levels >= 6 and not na(t6) ? t6 : na, "DCA-6", color=c(6), style=plot.style_linebr, linewidth=1)
plot(level >= 7 and max_levels >= 7 and not na(t7) ? t7 : na, "DCA-7", color=c(7), style=plot.style_linebr, linewidth=1)
plot(level >= 8 and max_levels >= 8 and not na(t8) ? t8 : na, "DCA-8", color=c(8), style=plot.style_linebr, linewidth=1)
plot(level >= 9 and max_levels >= 9 and not na(t9) ? t9 : na, "DCA-9", color=c(9), style=plot.style_linebr, linewidth=1)
plot(level >= 10 and max_levels >= 10 and not na(t10) ? t10 : na, "DCA-10", color=c(10), style=plot.style_linebr, linewidth=1)
plot(level >= 11 and max_levels >= 11 and not na(t11) ? t11 : na, "DCA-11", color=c(11), style=plot.style_linebr, linewidth=1)
plot(level >= 12 and max_levels >= 12 and not na(t12) ? t12 : na, "DCA-12", color=c(12), style=plot.style_linebr, linewidth=1)
plot(level >= 13 and max_levels >= 13 and not na(t13) ? t13 : na, "DCA-13", color=c(13), style=plot.style_linebr, linewidth=1)
plot(level >= 14 and max_levels >= 14 and not na(t14) ? t14 : na, "DCA-14", color=c(14), style=plot.style_linebr, linewidth=1)
plot(level >= 15 and max_levels >= 15 and not na(t15) ? t15 : na, "DCA-15", color=c(15), style=plot.style_linebr, linewidth=1)
plot(level >= 16 and max_levels >= 16 and not na(t16) ? t16 : na, "DCA-16", color=c(16), style=plot.style_linebr, linewidth=1)
plot(level >= 17 and max_levels >= 17 and not na(t17) ? t17 : na, "DCA-17", color=c(17), style=plot.style_linebr, linewidth=1)
plot(level >= 18 and max_levels >= 18 and not na(t18) ? t18 : na, "DCA-18", color=c(18), style=plot.style_linebr, linewidth=1)
plot(level >= 19 and max_levels >= 19 and not na(t19) ? t19 : na, "DCA-19", color=c(19), style=plot.style_linebr, linewidth=1)
plot(level >= 20 and max_levels >= 20 and not na(t20) ? t20 : na, "DCA-20", color=c(20), style=plot.style_linebr, linewidth=1)
plot(level >= 21 and max_levels >= 21 and not na(t21) ? t21 : na, "DCA-21", color=c(21), style=plot.style_linebr, linewidth=1)
plot(level >= 22 and max_levels >= 22 and not na(t22) ? t22 : na, "DCA-22", color=c(22), style=plot.style_linebr, linewidth=1)
plot(level >= 23 and max_levels >= 23 and not na(t23) ? t23 : na, "DCA-23", color=c(23), style=plot.style_linebr, linewidth=1)
plot(level >= 24 and max_levels >= 24 and not na(t24) ? t24 : na, "DCA-24", color=c(24), style=plot.style_linebr, linewidth=1)
plot(level >= 25 and max_levels >= 25 and not na(t25) ? t25 : na, "DCA-25", color=c(25), style=plot.style_linebr, linewidth=1)
plot(level >= 26 and max_levels >= 26 and not na(t26) ? t26 : na, "DCA-26", color=c(26), style=plot.style_linebr, linewidth=1)
plot(level >= 27 and max_levels >= 27 and not na(t27) ? t27 : na, "DCA-27", color=c(27), style=plot.style_linebr, linewidth=1)
plot(level >= 28 and max_levels >= 28 and not na(t28) ? t28 : na, "DCA-28", color=c(28), style=plot.style_linebr, linewidth=1)
plot(level >= 29 and max_levels >= 29 and not na(t29) ? t29 : na, "DCA-29", color=c(29), style=plot.style_linebr, linewidth=1)
plot(level >= 30 and max_levels >= 30 and not na(t30) ? t30 : na, "DCA-30", color=c(30), style=plot.style_linebr, linewidth=1)
plot(level >= 31 and max_levels >= 31 and not na(t31) ? t31 : na, "DCA-31", color=c(31), style=plot.style_linebr, linewidth=1)
plot(level >= 32 and max_levels >= 32 and not na(t32) ? t32 : na, "DCA-32", color=c(32), style=plot.style_linebr, linewidth=1)
plot(level >= 33 and max_levels >= 33 and not na(t33) ? t33 : na, "DCA-33", color=c(33), style=plot.style_linebr, linewidth=1)
plot(level >= 34 and max_levels >= 34 and not na(t34) ? t34 : na, "DCA-34", color=c(34), style=plot.style_linebr, linewidth=1)
plot(level >= 35 and max_levels >= 35 and not na(t35) ? t35 : na, "DCA-35", color=c(35), style=plot.style_linebr, linewidth=1)
plot(level >= 36 and max_levels >= 36 and not na(t36) ? t36 : na, "DCA-36", color=c(36), style=plot.style_linebr, linewidth=1)
plot(level >= 37 and max_levels >= 37 and not na(t37) ? t37 : na, "DCA-37", color=c(37), style=plot.style_linebr, linewidth=1)
plot(level >= 38 and max_levels >= 38 and not na(t38) ? t38 : na, "DCA-38", color=c(38), style=plot.style_linebr, linewidth=1)
plot(level >= 39 and max_levels >= 39 and not na(t39) ? t39 : na, "DCA-39", color=c(39), style=plot.style_linebr, linewidth=1)
plot(level >= 40 and max_levels >= 40 and not na(t40) ? t40 : na, "DCA-40", color=c(40), style=plot.style_linebr, linewidth=1)
plot(level >= 41 and max_levels >= 41 and not na(t41) ? t41 : na, "DCA-41", color=c(41), style=plot.style_linebr, linewidth=1)
plot(level >= 42 and max_levels >= 42 and not na(t42) ? t42 : na, "DCA-42", color=c(42), style=plot.style_linebr, linewidth=1)
plot(level >= 43 and max_levels >= 43 and not na(t43) ? t43 : na, "DCA-43", color=c(43), style=plot.style_linebr, linewidth=1)
plot(level >= 44 and max_levels >= 44 and not na(t44) ? t44 : na, "DCA-44", color=c(44), style=plot.style_linebr, linewidth=1)
plot(level >= 45 and max_levels >= 45 and not na(t45) ? t45 : na, "DCA-45", color=c(45), style=plot.style_linebr, linewidth=1)
plot(level >= 46 and max_levels >= 46 and not na(t46) ? t46 : na, "DCA-46", color=c(46), style=plot.style_linebr, linewidth=1)
plot(level >= 47 and max_levels >= 47 and not na(t47) ? t47 : na, "DCA-47", color=c(47), style=plot.style_linebr, linewidth=1)
plot(level >= 48 and max_levels >= 48 and not na(t48) ? t48 : na, "DCA-48", color=c(48), style=plot.style_linebr, linewidth=1)
plot(level >= 49 and max_levels >= 49 and not na(t49) ? t49 : na, "DCA-49", color=c(49), style=plot.style_linebr, linewidth=1)
plot(level >= 50 and max_levels >= 50 and not na(t50) ? t50 : na, "DCA-50", color=c(50), style=plot.style_linebr, linewidth=1)

// ── Línea de costo promedio (amarilla) ───────────────────────────────────────
plot(strategy.position_size > 0 ? avg_cost : na,
     "Avg Cost", color=color.yellow, style=plot.style_linebr, linewidth=2)

// ── Fondo teal en zonas laterales / naranja en modo rescate ──────────────────
bgcolor(is_lateral ? color.new(color.teal, 90) : na, title="Lateral Zone BG")
bgcolor(rescue_mode ? color.new(color.orange, 90) : na, title="Rescue Mode BG")

// ── Flechas de entrada y salida ──────────────────────────────────────────────
plotshape(ini_cond,    title="▲ Entry", location=location.belowbar,
          style=shape.triangleup,   color=color.lime, size=size.normal)
plotshape(tr_cond,     title="🚀 Trend Re-Entry", location=location.belowbar,
          style=shape.triangleup,   color=color.aqua, size=size.small)
plotshape(exit_signal, title="▼ Exit",  location=location.abovebar,
          style=shape.triangledown, color=color.red,  size=size.normal)
plotshape(be_exit and not exit_signal, title="⚖ BE Exit", location=location.abovebar,
          style=shape.xcross, color=color.orange, size=size.normal)

// ══════════════════════════════════════════════════════════════════════════════
//  📊  DASHBOARD — TABLERO DE CONTROL COMPLETO (con sección Rescate/Rebote)
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islastconfirmedhistory or barstate.isrealtime
    var table dash = table.new(position.top_right, 4, 17, bgcolor=#0d1117, border_width=1, border_color=#30363d)

    pos = strategy.position_size
    avg = strategy.position_avg_price

    open_pnl_pct = pos > 0 ? (close / avg - 1.0) * 100.0 : 0.0
    open_pnl_usd = strategy.openprofit
    closed_pnl   = strategy.netprofit
    total_pnl    = closed_pnl + open_pnl_usd

    open_col  = open_pnl_pct >= 0.0 ? color.new(#00e676, 0) : color.new(#ff1744, 0)
    total_col = total_pnl    >= 0.0 ? color.new(#00e676, 0) : color.new(#ff1744, 0)
    st_bull   = st_dir < 0

    // ── ROW 0: ENCABEZADO ─────────────────────────────────────────────────────
    table.cell(dash, 0, 0, "  CASCADE DCA 🌊",
               text_color=color.white, text_size=size.normal,
               bgcolor=#1565c0, text_halign=text.align_left)
    table.cell(dash, 1, 0, "", bgcolor=#1565c0)
    table.cell(dash, 2, 0, "", bgcolor=#1565c0)
    table.cell(dash, 3, 0, pos > 0 ? "● ACTIVA" : "○ EN ESPERA",
               text_color=pos > 0 ? color.new(#00e676, 0) : color.new(#90a4ae, 0),
               text_size=size.small, bgcolor=#1565c0)

    // ── ROW 1: SEP POSICIÓN ───────────────────────────────────────────────────
    table.cell(dash, 0, 1, "◈ POSICIÓN",
               text_color=color.new(#80cbc4, 0), text_size=size.small,
               bgcolor=#0a1628, text_halign=text.align_left)
    table.cell(dash, 1, 1, "", bgcolor=#0a1628)
    table.cell(dash, 2, 1, "", bgcolor=#0a1628)
    table.cell(dash, 3, 1, "", bgcolor=#0a1628)

    // ── ROW 2: NIVEL / INVERTIDO ──────────────────────────────────────────────
    table.cell(dash, 0, 2, "⚡ Nivel DCA",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2,
               level == 0 ? "—" : str.tostring(level - 1) + " / " + str.tostring(max_levels),
               text_color=color.new(#e0e0e0, 0), text_size=size.normal)
    table.cell(dash, 2, 2, "💵 Invertido",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 3, 2,
               pos > 0 ? "$ " + str.tostring(math.round(total_inv, 2)) : "—",
               text_color=color.new(#80deea, 0), text_size=size.normal)

    // ── ROW 3: AVG COST / P&L % (abierto) ────────────────────────────────────
    table.cell(dash, 0, 3, "📍 Avg Cost",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3,
               pos > 0 ? str.tostring(math.round(avg, 6)) : "—",
               text_color=color.new(#ffeb3b, 0), text_size=size.normal)
    table.cell(dash, 2, 3, "📈 P&L % abierto",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 3, 3,
               pos > 0 ? str.tostring(math.round(open_pnl_pct, 2)) + " %" : "—",
               text_color=open_col, text_size=size.normal)

    // ── ROW 4: ENTRY / P&L USD (abierto) ─────────────────────────────────────
    table.cell(dash, 0, 4, "🎯 Entry price",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4,
               not na(ep1) ? str.tostring(math.round(ep1, 6)) : "—",
               text_color=color.new(#ce93d8, 0), text_size=size.normal)
    table.cell(dash, 2, 4, "💰 P&L USD abierto",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 3, 4,
               pos > 0 ? "$ " + str.tostring(math.round(open_pnl_usd, 4)) : "—",
               text_color=open_col, text_size=size.normal)

    // ── ROW 5: PNL CERRADO + TOTAL (= backtest) ───────────────────────────────
    table.cell(dash, 0, 5, "✔ PnL cerrado",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5,
               "$ " + str.tostring(math.round(closed_pnl, 2)),
               text_color=closed_pnl >= 0 ? color.new(#69f0ae, 0) : color.new(#ff5252, 0),
               text_size=size.normal)
    table.cell(dash, 2, 5, "🏆 PnL TOTAL",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 3, 5,
               "$ " + str.tostring(math.round(total_pnl, 2)),
               text_color=total_col, text_size=size.normal)

    // ── ROW 6: SEP SEÑALES ────────────────────────────────────────────────────
    table.cell(dash, 0, 6, "◈ SEÑALES",
               text_color=color.new(#80cbc4, 0), text_size=size.small,
               bgcolor=#0a1628, text_halign=text.align_left)
    table.cell(dash, 1, 6, "", bgcolor=#0a1628)
    table.cell(dash, 2, 6, "", bgcolor=#0a1628)
    table.cell(dash, 3, 6, "", bgcolor=#0a1628)

    // ── ROW 7: VWM / IMPULSO ──────────────────────────────────────────────────
    table.cell(dash, 0, 7, "〰 VWM Score",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 7, str.tostring(math.round(vwm, 3)),
               text_color=vwm > 0 ? color.new(#00e676, 0) : color.new(#ff5252, 0), text_size=size.normal)
    table.cell(dash, 2, 7, "💨 Impulso",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 3, 7,
               impulse_dead ? "AGOTADO 🔴" : "ACTIVO  ⚡",
               text_color=impulse_dead ? color.new(#ff5252, 0) : color.new(#69f0ae, 0), text_size=size.small)

    // ── ROW 8: LATERAL / SUPERTREND ───────────────────────────────────────────
    table.cell(dash, 0, 8, "📐 Lateral",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 8,
               is_lateral ? "SÍ  ✅" : "NO  ❌",
               text_color=is_lateral ? color.new(#00e5ff, 0) : color.new(#ffa726, 0), text_size=size.small)
    table.cell(dash, 2, 8, "🔰 Supertrend",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 3, 8,
               st_bull ? "ALCISTA 🟢" : "BAJISTA 🔴",
               text_color=st_bull ? color.new(#69f0ae, 0) : color.new(#ff5252, 0), text_size=size.small)

    // ── ROW 9: BBW / ADX ──────────────────────────────────────────────────────
    table.cell(dash, 0, 9, "📊 BBW",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 9,
               str.tostring(math.round(bbw, 2)) + "% " + (bbw < bbw_max ? "✅" : "❌"),
               text_color=bbw < bbw_max ? color.new(#00e5ff, 0) : color.new(#78909c, 0), text_size=size.small)
    table.cell(dash, 2, 9, "📊 ADX",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 3, 9,
               str.tostring(math.round(adx_val, 1)) + " " + (adx_val < adx_max ? "✅" : "❌"),
               text_color=adx_val < adx_max ? color.new(#00e5ff, 0) : color.new(#78909c, 0), text_size=size.small)

    // ── ROW 10: MODO RESCATE / BREAKEVEN ──────────────────────────────────────
    table.cell(dash, 0, 10, "⚖️ Modo Rescate",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 10,
               rescue_mode ? "ACTIVO ⚠️" : "—",
               text_color=rescue_mode ? color.new(#ffa726, 0) : color.new(#e0e0e0, 0), text_size=size.small)
    table.cell(dash, 2, 10, "🛡️ Breakeven",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 3, 10,
               be_armed ? "ARMADO 🛡️" : "—",
               text_color=be_armed ? color.new(#00e5ff, 0) : color.new(#e0e0e0, 0), text_size=size.small)

    // ── ROW 11: ESTADO REBOTE DCA / RE-ENTRADA TENDENCIA ──────────────────────
    table.cell(dash, 0, 11, "🎯 DCA Rebote",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 11,
               not use_rebound ? "OFF" : dca_armed ? "ESPERA REBOTE ⏳" : "VIGILANDO 👁",
               text_color=dca_armed ? color.new(#ffeb3b, 0) : color.new(#e0e0e0, 0), text_size=size.small)
    table.cell(dash, 2, 11, "🚀 Re-Entrada",
               text_color=color.new(#b0bec5, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 3, 11,
               not use_trend_reentry ? "OFF" : await_reentry ? (trend_bullish ? "LISTA 🚀" : "ESPERA TENDENCIA ⏳") : "—",
               text_color=await_reentry ? (trend_bullish ? color.new(#00e5ff, 0) : color.new(#ffeb3b, 0)) : color.new(#e0e0e0, 0),
               text_size=size.small)

    // ── ROW 11.5 (usa ROW 11 espacio extra para fondo ciclo) — se omite, ver abajo
    // (Mantenemos la estructura de 17 filas; el fondo de ciclo se muestra implícito)

    // ── ROW 12: SEP NIVELES DCA ───────────────────────────────────────────────
    table.cell(dash, 0, 12, "◈ CICLO DCA",
               text_color=color.new(#80cbc4, 0), text_size=size.small,
               bgcolor=#0a1628, text_halign=text.align_left)
    table.cell(dash, 1, 12, "", bgcolor=#0a1628)
    table.cell(dash, 2, 12, "", bgcolor=#0a1628)
    table.cell(dash, 3, 12,
               not na(cycle_low) ? "fondo " + str.tostring(math.round(cycle_low, 6)) + " (" + str.tostring(bars_since_low) + "v)" : "",
               text_color=color.new(#80deea, 0), text_size=size.small, bgcolor=#0a1628)

    // ── ROW 13: HEADERS TABLA ─────────────────────────────────────────────────
    table.cell(dash, 0, 13, "  #",      text_color=color.new(#90a4ae, 0), text_size=size.small)
    table.cell(dash, 1, 13, "Drop %",   text_color=color.new(#90a4ae, 0), text_size=size.small)
    table.cell(dash, 2, 13, "Trigger",  text_color=color.new(#90a4ae, 0), text_size=size.small)
    table.cell(dash, 3, 13, "USD (cap)",text_color=color.new(#90a4ae, 0), text_size=size.small)

    // ── ROWS 14-16: VENTANA MÓVIL — ANTERIOR / CORRIENDO / PRÓXIMO ────────────
    // "Corriendo" = el DCA que la estrategia está esperando ahora mismo (= level).
    // La ventana se desplaza sola a medida que se van llenando niveles.
    // Antes de abrir posición (level 0) se previsualizan DCA-1/2/3.
    cur_lvl = level == 0 ? 1 : level

    for slot = 0 to 2
        row      = 14 + slot
        i        = cur_lvl - 1 + slot          // slot 0=anterior, 1=actual, 2=próximo
        is_valid = i >= 1 and i <= max_levels   // dentro del rango real de niveles

        is_run    = slot == 1                   // fila central = corriendo
        is_prev   = slot == 0                   // fila superior = anterior
        is_filled = pos > 0 and i <= level - 1  // ya comprado en esta operación

        d          = is_valid ? get_drop(i) : 0.0
        usd_i      = is_valid ? usd(i) : 0.0
        trig_price = not na(ep1) and is_valid ? ep1 * (1.0 - d / 100.0) : 0.0

        // Etiqueta de rol a la derecha del nombre del nivel
        role_txt = is_prev ? "  ◂ Anterior" : is_run ? "  ◂ CORRIENDO" : "  ◂ Próximo"

        // Ícono de estado del nivel
        status_icon = is_filled ? "✓ " : is_run ? "► " : "  "

        row_label = is_valid ? status_icon + "DCA-" + str.tostring(i) + role_txt : "  —"

        // Color: la fila que corre se resalta en amarillo; lo llenado en verde;
        // el próximo en gris claro; el anterior tenue.
        label_col = not is_valid ? color.new(#455a64, 0) : is_run       ? color.new(#ffeb3b, 0) :  is_filled    ? color.new(#69f0ae, 0) :    is_prev      ? color.new(#90a4ae, 0) : color.new(#e0e0e0, 0)

        // Fondo sutil para destacar la fila que está corriendo
        row_bg = is_run ? #1f2a1f : #0d1117

        table.cell(dash, 0, row, row_label,
                   text_color=label_col, text_size=size.small, text_halign=text.align_left, bgcolor=row_bg)
        table.cell(dash, 1, row,
                   is_valid ? str.tostring(math.round(d, 1)) + "%" : "—",
                   text_color=is_valid ? (is_run ? color.new(#ffeb3b, 0) : color.new(#ef9a9a, 0)) : color.new(#455a64, 0),
                   text_size=size.small, bgcolor=row_bg)
        table.cell(dash, 2, row,
                   is_valid and not na(ep1) ? str.tostring(math.round(trig_price, 6)) : "—",
                   text_color=is_valid ? (is_run ? color.new(#fff9c4, 0) : color.new(#fff9c4, 30)) : color.new(#455a64, 0),
                   text_size=size.small, bgcolor=row_bg)
        table.cell(dash, 3, row,
                   is_valid ? "$ " + str.tostring(math.round(usd_i, 1)) : "—",
                   text_color=is_valid ? color.new(#80deea, 0) : color.new(#455a64, 0),
                   text_size=size.small, bgcolor=row_bg)
