//@version=6
// Vertical Time Marker Configurable (VTMC)
// Created by @ILUVIT
// Date: July 28, 2025
indicator("Vertical Time Marker Configurable", shorttitle="VTMC", overlay=true)

// Input settings
time_input = input.time(timestamp("2023-01-01 08:30-0600"), title="Time (Central)", tooltip="Select the time for the daily line")
line_color = input.color(color.white, title="Line Color")
line_width = input.int(1, title="Line Width", minval=1, maxval=10)
line_style_options = input.string("Dashed", title="Line Style", options=["Solid", "Dashed", "Dotted"])
line_opacity = input.float(100, title="Line Opacity (%)", minval=0, maxval=100, step=5)

// Text settings with 12pt default and ATR positioning
show_text = input.bool(true, title="Show Text")
text_options = input.string("New York Open", title="Text Label", options=["New York Open", "New York Close", "London Open", "London Close", "Asia Open", "Asia Close", "Custom"])
custom_text = input.string("Custom Label", title="Custom Text", tooltip="Enter your custom label text")
text_size = input.int(12, title="Text Size", minval=8, maxval=20)
text_color = input.color(color.white, title="Text Color")
text_opacity = input.float(100, title="Text Opacity (%)", minval=0, maxval=100, step=5)

// Text box/marker settings
show_text_box = input.bool(false, title="Show Text Box Background")
text_bg_color = input.color(color.blue, title="Text Background Color")
text_bg_opacity = input.float(80, title="Text Background Opacity (%)", minval=0, maxval=100, step=5)
text_border_color = input.color(color.white, title="Text Border Color")
text_border_opacity = input.float(100, title="Text Border Opacity (%)", minval=0, maxval=100, step=5)
text_box_style = input.string("Label Down", title="Text Box Style", options=["Label Down", "Label Up", "Label Left", "Label Right", "Label Center", "Circle", "Square"])

// ATR positioning for event markers (away from price action)
text_position_choice = input.string("Above", title="Text Position", options=["Above", "Below"])
text_atr_distance = input.float(3.0, title="Distance from Price (ATR)", minval=1.0, maxval=10.0)

// Convert line style string to Pine Script line style
get_line_style() =>
    switch line_style_options
        "Solid" => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_dashed

// Convert text size to Pine Script text size
get_text_size() =>
    switch
        text_size <= 10 => size.small
        text_size <= 14 => size.normal
        => size.large

// Convert text box style to Pine Script label style
get_text_box_style() =>
    switch text_box_style
        "Label Down" => label.style_label_down
        "Label Up" => label.style_label_up
        "Label Left" => label.style_label_left
        "Label Right" => label.style_label_right
        "Label Center" => label.style_label_center
        "Circle" => label.style_circle
        "Square" => label.style_square
        => label.style_label_down

// Apply opacity to colors
line_color_with_opacity = color.new(line_color, 100 - line_opacity)
text_color_with_opacity = color.new(text_color, 100 - text_opacity)
text_bg_color_with_opacity = color.new(text_bg_color, 100 - text_bg_opacity)
text_border_color_with_opacity = color.new(text_border_color, 100 - text_border_opacity)

// Get the target time in the current day
target_time = timestamp(year, month, dayofmonth, 
              hour(time_input), minute(time_input), second(time_input))

// Check if current bar time matches target time (within the same minute)
is_target_time = hour(time) == hour(time_input) and minute(time) == minute(time_input)

// Variable to store lines
var line[] daily_lines = array.new<line>()

// Draw line when target time is reached
if is_target_time
    // Create new vertical line spanning full chart height
    new_line = line.new(
         x1=bar_index, 
         y1=low - (high - low) * 0.1,  // Start below visible area
         x2=bar_index, 
         y2=high + (high - low) * 0.1,  // End above visible area  
         color=line_color_with_opacity,
         width=line_width,
         style=get_line_style(),
         extend=extend.both
     )
    
    // Add line to array
    array.push(daily_lines, new_line)
    
    // Create text label if enabled with ATR positioning
    if show_text
        // Use custom text if selected, otherwise use preset option
        label_text = (text_options == "Custom") ? custom_text : text_options
        
        // ATR-based positioning to keep text away from price action
        current_atr = ta.atr(14)
        base_price = (text_position_choice == "Above") ? high : low
        multiplier = (text_position_choice == "Above") ? 1 : -1
        text_position = base_price + (current_atr * text_atr_distance * multiplier)
        
        label.new(
             x=bar_index,
             y=text_position,
             text=label_text,
             color=show_text_box ? text_bg_color_with_opacity : color.new(color.white, 100), // Use configured background or transparent
             textcolor=text_color_with_opacity,
             size=get_text_size(),
             style=show_text_box ? get_text_box_style() : label.style_none,
             tooltip="Event: " + label_text
         )

// Plot a small marker at the target time for reference
plotchar(is_target_time, title="Time Marker", char="•", location=location.belowbar, 
         color=line_color_with_opacity, size=size.tiny)