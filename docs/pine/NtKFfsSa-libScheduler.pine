//@version=6
library('libScheduler')

/////////////////////////////////////////////////////////////
// TIMEFRAME ENUM AND UTILITY FUNCTIONS
/////////////////////////////////////////////////////////////

//@enum An enumeration of timeframes
export enum Timeframes
    C = "Chart"
    S5 = "5 Seconds"
    S10 = "10 Seconds"
    S15 = "15 Seconds"
    S30 = "30 Seconds"
    M1 = "1 Minute"
    M3 = "3 Minutes"
    M5 = "5 Minutes"
    M10 = "10 Minutes"
    M15 = "15 Minutes"
    M30 = "30 Minutes"
    H1 = "1 Hour"
    H2 = "2 Hours"
    H4 = "4 Hours"
    D1 = "1 Day"
    W1 = "1 Week"
    MO1 = "1 Month"
    MO3 = "3 Months"
    Y = "Year"
    NA = "-"

// @function getTimeframeAbbrev
// @description Returns the abbreviated string representation of a given timeframe.
// @param tf: Timeframes - The timeframe to convert to an abbreviated string.
// @returns string - The abbreviated string representation of the timeframe.
export getTimeframeAbbrev(Timeframes tf) =>
    switch tf
        Timeframes.NA => timeframe.period
        Timeframes.C => timeframe.period
        Timeframes.S5 => "5S"
        Timeframes.S10 => "10S"
        Timeframes.S15 => "15S"
        Timeframes.S30 => "30S"
        Timeframes.M1 => "1"
        Timeframes.M3 => "3"
        Timeframes.M5 => "5"
        Timeframes.M10 => "10"
        Timeframes.M15 => "15"
        Timeframes.M30 => "30"
        Timeframes.H1 => "60"
        Timeframes.H2 => "120"
        Timeframes.H4 => "240"
        Timeframes.D1 => "D"
        Timeframes.W1 => "W"
        Timeframes.MO1 => "1M"
        Timeframes.MO3 => "3M"
        Timeframes.Y => "12M"
        =>
            runtime.error("Unknown timeframe enum value")
            timeframe.period

// @function getTimeframeMS
// @description Returns the millisecond representation of a given time frame.
// @param tf: Timeframes - The time frame to convert to milliseconds.
// @returns int - The millisecond representation of the time frame.
export getTimeframeMS(Timeframes tf) =>
    switch tf
        Timeframes.S5 => 5000
        Timeframes.S10 => 10000
        Timeframes.S15 => 15000
        Timeframes.S30 => 30000
        Timeframes.M1 => 60000
        Timeframes.M3 => 180000
        Timeframes.M5 => 300000
        Timeframes.M10 => 600000
        Timeframes.M15 => 900000
        Timeframes.M30 => 1800000
        Timeframes.H1 => 3600000
        Timeframes.H2 => 7200000
        Timeframes.H4 => 14400000
        Timeframes.D1 => 86400000
        Timeframes.W1 => 604800000
        =>
            timeframe.in_seconds(timeframe.period) * 1000

// @function getTimeframeFromMS
// @description Converts a given interval in milliseconds to the corresponding Pine Script timeframe.
// @param interval_ms: int - The interval in milliseconds to convert.
// @returns Timeframes - The corresponding Pine Script timeframe for the given interval.
export getTimeframeFromMS(int interval_ms) =>
    switch interval_ms
        5000 => Timeframes.S5
        10000 => Timeframes.S10
        15000 => Timeframes.S15
        30000 => Timeframes.S30
        60000 => Timeframes.M1
        180000 => Timeframes.M3
        300000 => Timeframes.M5
        600000 => Timeframes.M10
        900000 => Timeframes.M15
        1800000 => Timeframes.M30
        3600000 => Timeframes.H1
        7200000 => Timeframes.H2
        14400000 => Timeframes.H4
        86400000 => Timeframes.D1
        604800000 => Timeframes.W1
        =>
            Timeframes.NA

// @function getTimeframeFromMultiplier
// @description Returns the closest timeframe to a given multiple of the input time frame.
// @param tf: Timeframes - The input time frame to determine the anchor for.
// @param multiple: The multiple of the given timeframe to seek
// @returns Timeframes - The closest Timeframes enum to getTimeframeMS(tf) * target
export getTimeframeFromMultiplier(Timeframes tf, float multiple) =>
    int target = int(math.round(getTimeframeMS(tf) * multiple, 0))
    foundTF = getTimeframeFromMS(target)

    if foundTF == Timeframes.NA
        a = array.from(5000, 10000, 15000, 30000, 60000, 180000, 300000, 600000, 900000, 1800000, 3600000, 7200000, 14400000, 86400000, 604800000)
        idx = math.min(array.binary_search_leftmost(a, target), 16)
        foundTF := getTimeframeFromMS(array.get(a, idx))
        array.clear(a)
    foundTF

// @function getTimeframe
// @description Returns the corresponding Pine Script timeframe constant for a given period string.
// @param _period: string - The period string to convert to a timeframe constant.
// @returns Timeframes - The corresponding Pine Script timeframe constant.
export getTimeframe(string _period = timeframe.period) =>
    switch _period
        // Seconds timeframes
        "5S" => Timeframes.S5
        "10S" => Timeframes.S10
        "15S" => Timeframes.S15
        "30S" => Timeframes.S30

        // Minutes timeframes
        "1M" => Timeframes.M1
        "3M" => Timeframes.M3
        "5M" => Timeframes.M5
        "10M" => Timeframes.M10
        "15M" => Timeframes.M15
        "30M" => Timeframes.M30

        // Hours timeframes
        "1H" => Timeframes.H1
        "2H" => Timeframes.H2
        "4H" => Timeframes.H4

        // Daily timeframes
        "1D" => Timeframes.D1

        // Weekly timeframes
        "1W" => Timeframes.W1

        // Monthly timeframes
        "M1" => Timeframes.MO1
        "M3" => Timeframes.MO3
        "Y" => Timeframes.Y

        // Default case
        => Timeframes.NA

// @function getChartTimeframe
// @description Returns the corresponding Pine Script timeframe constant for a chart period string.
// @param _period: string - The period string to convert to a timeframe constant.
// @returns Timeframes - The corresponding Pine Script timeframe constant.
export getChartTimeframe() =>
    period = timeframe.period
    switch period
        // Seconds
        "5S" => Timeframes.S5
        "10S" => Timeframes.S10
        "15S" => Timeframes.S15
        "30S" => Timeframes.S30
        // Minutes (Pine's native format)
        "1" => Timeframes.M1
        "3" => Timeframes.M3
        "5" => Timeframes.M5
        "10" => Timeframes.M10
        "15" => Timeframes.M15
        "30" => Timeframes.M30
        // Hours (Pine's native format)
        "60" => Timeframes.H1
        "120" => Timeframes.H2
        "240" => Timeframes.H4
        // Days/Weeks/Months
        "D" => Timeframes.D1
        "W" => Timeframes.W1
        "1W" => Timeframes.W1
        "M" => Timeframes.MO1
        "1M" => Timeframes.MO1
        "3M" => Timeframes.MO3
        "12M" => Timeframes.Y
        => Timeframes.NA  // Safe default

// @function getBarsInTimeframes
// @description Calculates the number of lower timeframe bars that fit into a higher timeframe bar.
// @param lowerTf: Timeframes - The lower timeframe to compare against.
// @param higherTf: Timeframes - The higher timeframe to compare against.
// @returns int - The number of lower timeframe bars that fit into a higher timeframe bar.
export getBarsInTimeframes(Timeframes lowerTf, Timeframes higherTf) =>
    int lowerSeconds = getTimeframeMS(lowerTf)
    int higherSeconds = getTimeframeMS(higherTf)

    // The conditional logic is now handled by a ternary operator in a single line.
    // This allows the entire expression to be resolved at compile time.
    int retval = 1
    retval := not na(higherSeconds) and not na(lowerSeconds) and lowerSeconds < higherSeconds ? int(higherSeconds / lowerSeconds) : 1
    retval

// @function isChartTimeframe
// @description Determines if the current chart timeframe matches the specified target timeframe.
// @param target_tf: Timeframes - The target timeframe to compare against the current chart's timeframe.
// @returns bool - True if the current chart's timeframe matches the target timeframe, false otherwise.
export isChartTimeframe(Timeframes target_tf) =>
    target_tf == getTimeframe(timeframe.period)

/////////////////////////////////////////////////////////////
// SCHEDULER - Lightweight throttling mechanism
/////////////////////////////////////////////////////////////

// @type Scheduler - Ultra-simple scheduler for interval-based execution throttling
// Uses actual time intervals, not bar counting, for precise timing
export type Scheduler
    map<int, int> next_update = na  // interval_ms -> next_update_time
    int earliest_due = na           // Cached earliest due time for O(1) quick exits

// @function init
// @description Initializes a Scheduler object with empty maps and null earliest due time.
// @param this: Scheduler - The Scheduler instance to initialize
// @returns Scheduler - The initialized Scheduler object with empty internal state
export method init(Scheduler this) =>
    this.next_update := map.new<int, int>()
    this.earliest_due := na
    this

// @function register
// @description Registers a timeframe with the scheduler and schedules its next update.
// @param this: Scheduler - The scheduler instance to register the timeframe with
// @param tf: Timeframes - The timeframe to register
// @returns Scheduler - The updated scheduler instance
export method register(Scheduler this, Timeframes tf) =>
    int interval_ms = getTimeframeMS(tf)

    if not na(interval_ms) and not map.contains(this.next_update, interval_ms)
        // Schedule first execution one interval from current time
        int next_time = time + interval_ms
        map.put(this.next_update, interval_ms, next_time)

        // Update earliest_due if this is sooner
        if na(this.earliest_due) or next_time < this.earliest_due
            this.earliest_due := next_time

    this

// @function updateEarliestDue
// @description Updates the earliest due time by iterating through all intervals.
// @param this: Scheduler - The scheduler object containing next_update map and earliest_due field
// @returns Scheduler - The updated scheduler object with earliest_due field modified
export method updateEarliestDue(Scheduler this) =>
    this.earliest_due := na

    // Iterate through all intervals to find the earliest due time
    if map.size(this.next_update) > 0
        array<int> keys = map.keys(this.next_update)
        int size = array.size(keys)

        for i = 0 to math.min(size - 1, 19) // Limit iterations to 20 for safety
            int interval_ms = array.get(keys, i)
            int next_time = map.get(this.next_update, interval_ms)

            if not na(next_time) and (na(this.earliest_due) or next_time < this.earliest_due)
                this.earliest_due := next_time

    this

// @function every
// @description Checks if a scheduler should execute for a given timeframe.
// @param this: Scheduler - The scheduler instance to check
// @param tf: Timeframes - The timeframe to evaluate
// @returns bool - True if the scheduler should execute for the specified timeframe, false otherwise
export method every(Scheduler this, Timeframes tf) =>
    int target_ms = getTimeframeMS(tf)
    bool is_due = false

    if not na(target_ms)
        // Auto-register timeframe on first call
        if not map.contains(this.next_update, target_ms)
            this.register(tf)

        // Check if scheduler specific timeframe is due
        int next_time = map.get(this.next_update, target_ms)
        is_due := not na(next_time) and time >= next_time

        // If due, reschedule from the PREVIOUS scheduled time
        if is_due
            // If severely overdue, catch up by scheduling from current time
            // Otherwise, schedule from previous time to maintain precision
            int next_execution = na
            if time - next_time > target_ms * 3
                // More than 3 intervals overdue - reset to current time
                next_execution := time + target_ms
            else
                // Normal case - schedule from previous scheduled time
                next_execution := next_time + target_ms

            map.put(this.next_update, target_ms, next_execution)

            // Update scheduler's earliest_due
            this.updateEarliestDue()

    is_due
