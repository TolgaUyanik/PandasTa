//@version=6
strategy("Volume Spike + Breakout Trend Score Pro + KNN MTF v2 Clean Labels MTF Fix", overlay=true, max_labels_count=300, pyramiding=0, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

//------------------------------------------------------
// Inputs
//------------------------------------------------------
groupGeneral = "General"
modeInput = input.string("Continuation", "Signal Mode", options=["Continuation", "Reversal", "Hybrid"], group=groupGeneral)
showSignals = input.bool(true, "Show Major BUY/SELL Labels", group=groupGeneral)
showConfirmMarkers = input.bool(true, "Show Small Confirmation Markers", group=groupGeneral)
showBarColors = input.bool(true, "Color Bars", group=groupGeneral)
showEMA = input.bool(true, "Show Fast EMA", group=groupGeneral)
emaLen = input.int(21, "Fast EMA Length", minval=1, group=groupGeneral)
showSlowEMA = input.bool(true, "Show Slow EMA", group=groupGeneral)
slowEmaLen = input.int(50, "Slow EMA Length", minval=1, group=groupGeneral)
showVWAP = input.bool(true, "Show Session VWAP", group=groupGeneral)
showBB = input.bool(false, "Show Bollinger Bands", group=groupGeneral)
showScoreLabel = input.bool(true, "Show Last-Bar Score Label", group=groupGeneral)
showTrendTable = input.bool(true, "Show Trend Table", group=groupGeneral)
showConfidenceBand = input.bool(false, "Show KNN Confidence Band", group=groupGeneral)
tablePosInput = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=groupGeneral)

// Volume
groupVolume = "Volume"
volLen = input.int(20, "Volume SMA Length", minval=1, group=groupVolume)
volSpikeMult = input.float(1.5, "Volume Spike Multiplier", minval=1.0, step=0.1, group=groupVolume)
volExtremeMult = input.float(2.5, "Extreme Volume Multiplier", minval=1.0, step=0.1, group=groupVolume)

// Breakout
groupBreakout = "Breakouts"
lookbackHighLow = input.int(20, "Breakout Lookback", minval=2, group=groupBreakout)
confirmClose = input.bool(true, "Use Close Confirmation", group=groupBreakout)

// Bollinger
groupBB = "Bollinger Bands"
bbLen = input.int(20, "BB Length", minval=1, group=groupBB)
bbMult = input.float(2.0, "BB StdDev", minval=0.1, step=0.1, group=groupBB)

// Momentum
groupMomentum = "Momentum"
rsiLen = input.int(14, "RSI Length", minval=1, group=groupMomentum)
rsiBullLevel = input.int(55, "RSI Bull Threshold", minval=1, maxval=100, group=groupMomentum)
rsiBearLevel = input.int(45, "RSI Bear Threshold", minval=1, maxval=100, group=groupMomentum)
macdFast = input.int(12, "MACD Fast", minval=1, group=groupMomentum)
macdSlow = input.int(26, "MACD Slow", minval=1, group=groupMomentum)
macdSignalLen = input.int(9, "MACD Signal", minval=1, group=groupMomentum)

// Trend filters
groupTrend = "Trend Filters"
useVWAP = input.bool(true, "Use Session VWAP Filter", group=groupTrend)
useHTFTrend = input.bool(true, "Use Higher Timeframe EMA", group=groupTrend)
htfTf = input.timeframe("15", "Higher Timeframe", group=groupTrend)
htfEmaLen = input.int(50, "HTF EMA Length", minval=1, group=groupTrend)
useADX = input.bool(true, "Use ADX Filter", group=groupTrend)
adxLen = input.int(14, "ADX Length", minval=1, group=groupTrend)
adxMin = input.float(18.0, "Minimum ADX", minval=1.0, step=0.5, group=groupTrend)

// KNN
groupKNN = "KNN"
useKNN = input.bool(true, "Use KNN Filter", group=groupKNN)
knnLookback = input.int(80, "KNN Lookback", minval=20, maxval=300, group=groupKNN)
knnNeighbors = input.int(7, "KNN Neighbors", minval=1, maxval=7, group=groupKNN)
knnForwardBars = input.int(3, "KNN Forward Bars", minval=1, maxval=10, group=groupKNN)
knnMinConfidence = input.float(0.57, "Min KNN Confidence", minval=0.0, maxval=1.0, step=0.01, group=groupKNN)

// WaveTrend / Flow
groupWT = "WaveTrend + Flow"
useWTFilter = input.bool(true, "Use WT Filter", group=groupWT)
wtChannelLen = input.int(9, "WT Channel Length", minval=1, group=groupWT)
wtAverageLen = input.int(12, "WT Average Length", minval=1, group=groupWT)
wtMALen = input.int(3, "WT Signal Length", minval=1, group=groupWT)
wtObLevel = input.int(53, "WT Overbought", group=groupWT)
wtOsLevel = input.int(-53, "WT Oversold", group=groupWT)
wtDeepOsLevel = input.int(-75, "WT Deep Oversold", group=groupWT)
useFlowFilter = input.bool(true, "Use Money Flow Filter", group=groupWT)
flowLen = input.int(60, "Money Flow Length", minval=1, group=groupWT)
flowMultiplier = input.float(150.0, "Money Flow Multiplier", minval=1, step=1, group=groupWT)
useWTDivergence = input.bool(true, "Use WT Divergence", group=groupWT)
wtDivOBLevel = input.int(45, "WT Bear Div Min", group=groupWT)
wtDivOSLevel = input.int(-65, "WT Bull Div Min", group=groupWT)

// Score
groupScore = "Score"
scoreBullColor = input.color(color.new(color.green, 0), "Bull Score Color", group=groupScore)
scoreBearColor = input.color(color.new(color.red, 0), "Bear Score Color", group=groupScore)
strongBullThreshold = input.float(8.0, "Strong Bull Threshold", step=0.5, group=groupScore)
strongBearThreshold = input.float(-8.0, "Strong Bear Threshold", step=0.5, group=groupScore)
biasBullThreshold = input.float(3.0, "Bull Bias Threshold", step=0.5, group=groupScore)
biasBearThreshold = input.float(-3.0, "Bear Bias Threshold", step=0.5, group=groupScore)

// Weights
groupWeights = "Weighted Scores"
wTrend = input.float(1.0, "Weight Trend EMA", minval=0, step=0.25, group=groupWeights)
wVWAP = input.float(1.0, "Weight VWAP", minval=0, step=0.25, group=groupWeights)
wHTF = input.float(1.0, "Weight HTF", minval=0, step=0.25, group=groupWeights)
wRSI = input.float(1.0, "Weight RSI", minval=0, step=0.25, group=groupWeights)
wMACD = input.float(1.0, "Weight MACD", minval=0, step=0.25, group=groupWeights)
wADX = input.float(1.0, "Weight ADX/DI", minval=0, step=0.25, group=groupWeights)
wVolSpike = input.float(1.0, "Weight Volume Spike", minval=0, step=0.25, group=groupWeights)
wVolExtreme = input.float(1.0, "Weight Extreme Volume", minval=0, step=0.25, group=groupWeights)
wBreakout = input.float(2.0, "Weight Breakout", minval=0, step=0.25, group=groupWeights)
wBB = input.float(1.5, "Weight BB Breakout", minval=0, step=0.25, group=groupWeights)
wKNN = input.float(1.0, "Weight KNN", minval=0, step=0.25, group=groupWeights)
wWT = input.float(1.0, "Weight WT Direction", minval=0, step=0.25, group=groupWeights)
wWTMomentum = input.float(1.0, "Weight WT Momentum", minval=0, step=0.25, group=groupWeights)
wFlow = input.float(1.0, "Weight Money Flow", minval=0, step=0.25, group=groupWeights)
wWTSignal = input.float(1.5, "Weight WT Signal", minval=0, step=0.25, group=groupWeights)
wWTDiv = input.float(1.0, "Weight WT Divergence", minval=0, step=0.25, group=groupWeights)
wWTGold = input.float(1.0, "Weight WT Gold Buy", minval=0, step=0.25, group=groupWeights)

// Strategy
groupStrategy = "Backtest Strategy"
enableStrategy = input.bool(true, "Enable Strategy Orders", group=groupStrategy)
longsEnabled = input.bool(true, "Enable Longs", group=groupStrategy)
shortsEnabled = input.bool(true, "Enable Shorts", group=groupStrategy)
exitMode = input.string("ATR Bracket", "Exit Mode", options=["ATR Bracket", "Score Flip", "Hybrid"], group=groupStrategy)
atrLen = input.int(14, "ATR Length", minval=1, group=groupStrategy)
stopATR = input.float(1.5, "Stop ATR Multiplier", minval=0.1, step=0.1, group=groupStrategy)
targetATR = input.float(2.5, "Target ATR Multiplier", minval=0.1, step=0.1, group=groupStrategy)
trailATR = input.float(1.0, "Trail ATR Multiplier", minval=0.1, step=0.1, group=groupStrategy)
useTrailing = input.bool(false, "Use Trailing Stop", group=groupStrategy)

//------------------------------------------------------
// Helpers
//------------------------------------------------------
f_pos(pos) =>
    switch pos
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right

f_bg(state) =>
    state == "BULL" ? color.new(color.green, 0) : state == "BEAR" ? color.new(color.red, 0) : color.new(color.gray, 20)

f_top_fractal(src) => src[4] < src[2] and src[3] < src[2] and src[2] > src[1] and src[2] > src[0]
f_bot_fractal(src) => src[4] > src[2] and src[3] > src[2] and src[2] < src[1] and src[2] < src[0]
f_fractalize(src) => f_top_fractal(src) ? 1 : f_bot_fractal(src) ? -1 : 0

f_findDivs(src, topLimit, botLimit, useLimits) =>
    fractalTop = f_fractalize(src) > 0 and (useLimits ? src[2] >= topLimit : true) ? src[2] : na
    fractalBot = f_fractalize(src) < 0 and (useLimits ? src[2] <= botLimit : true) ? src[2] : na
    highPrev = ta.valuewhen(not na(fractalTop), src[2], 1)
    highPrice = ta.valuewhen(not na(fractalTop), high[2], 1)
    lowPrev = ta.valuewhen(not na(fractalBot), src[2], 1)
    lowPrice = ta.valuewhen(not na(fractalBot), low[2], 1)
    bearSignal = not na(fractalTop) and high[2] > highPrice and src[2] < highPrev
    bullSignal = not na(fractalBot) and low[2] < lowPrice and src[2] > lowPrev
    [fractalTop, fractalBot, lowPrev, bearSignal, bullSignal]

f_wavetrend(src, chlen, avg, malen) =>
    esa = ta.ema(src, chlen)
    de = ta.ema(math.abs(src - esa), chlen)
    ci = de != 0 ? (src - esa) / (0.015 * de) : 0.0
    wt1 = ta.ema(ci, avg)
    wt2 = ta.sma(wt1, malen)
    wtVwapOsc = wt1 - wt2
    wtOversold = wt2 <= wtOsLevel
    wtOverbought = wt2 >= wtObLevel
    wtCrossUp = ta.crossover(wt1, wt2)
    wtCrossDown = ta.crossunder(wt1, wt2)
    [wt1, wt2, wtVwapOsc, wtOversold, wtOverbought, wtCrossUp, wtCrossDown]

f_money_flow(_period, _multiplier) =>
    barRange = high - low
    rawFlow = barRange != 0 ? ((close - open) / barRange) * _multiplier : 0.0
    ta.sma(rawFlow, _period)

f_knn_predict(_rsi, _emaSpreadPct, _macdHistPct, _vwapDistPct, _lookback, _k, _fwd) =>
    float vote = 0.0
    float best1 = 1000000.0
    float best2 = 1000000.0
    float best3 = 1000000.0
    float best4 = 1000000.0
    float best5 = 1000000.0
    float best6 = 1000000.0
    float best7 = 1000000.0
    float lbl1 = 0.0
    float lbl2 = 0.0
    float lbl3 = 0.0
    float lbl4 = 0.0
    float lbl5 = 0.0
    float lbl6 = 0.0
    float lbl7 = 0.0
    maxBars = math.min(_lookback, bar_index - _fwd - 5)
    if maxBars > 10
        for i = 5 to maxBars
            dist = math.abs(_rsi - _rsi[i]) * 0.35 + math.abs(_emaSpreadPct - _emaSpreadPct[i]) * 1.20 + math.abs(_macdHistPct - _macdHistPct[i]) * 2.00 + math.abs(_vwapDistPct - _vwapDistPct[i]) * 1.50
            futureRetPct = close[i] != 0 ? ((close[i - _fwd] - close[i]) / close[i]) * 100.0 : 0.0
            lbl = futureRetPct > 0.35 ? 1.0 : futureRetPct < -0.35 ? -1.0 : 0.0
            if dist < best1
                best7 := best6, lbl7 := lbl6
                best6 := best5, lbl6 := lbl5
                best5 := best4, lbl5 := lbl4
                best4 := best3, lbl4 := lbl3
                best3 := best2, lbl3 := lbl2
                best2 := best1, lbl2 := lbl1
                best1 := dist, lbl1 := lbl
            else if dist < best2
                best7 := best6, lbl7 := lbl6
                best6 := best5, lbl6 := lbl5
                best5 := best4, lbl5 := lbl4
                best4 := best3, lbl4 := lbl3
                best3 := best2, lbl3 := lbl2
                best2 := dist, lbl2 := lbl
            else if dist < best3
                best7 := best6, lbl7 := lbl6
                best6 := best5, lbl6 := lbl5
                best5 := best4, lbl5 := lbl4
                best4 := best3, lbl4 := lbl3
                best3 := dist, lbl3 := lbl
            else if dist < best4
                best7 := best6, lbl7 := lbl6
                best6 := best5, lbl6 := lbl5
                best5 := best4, lbl5 := lbl4
                best4 := dist, lbl4 := lbl
            else if dist < best5
                best7 := best6, lbl7 := lbl6
                best6 := best5, lbl6 := lbl5
                best5 := dist, lbl5 := lbl
            else if dist < best6
                best7 := best6, lbl7 := lbl6
                best6 := dist, lbl6 := lbl
            else if dist < best7
                best7 := dist, lbl7 := lbl
        vote := (_k >= 1 ? lbl1 : 0) + (_k >= 2 ? lbl2 : 0) + (_k >= 3 ? lbl3 : 0) + (_k >= 4 ? lbl4 : 0) + (_k >= 5 ? lbl5 : 0) + (_k >= 6 ? lbl6 : 0) + (_k >= 7 ? lbl7 : 0)
    vote

f_tf_model_state(tf) =>
    tfClose = request.security(syminfo.tickerid, tf, close)
    tfEmaFast = request.security(syminfo.tickerid, tf, ta.ema(close, emaLen))
    tfEmaSlow = request.security(syminfo.tickerid, tf, ta.ema(close, slowEmaLen))
    tfRsi = request.security(syminfo.tickerid, tf, ta.rsi(close, rsiLen))
    tfVwap = request.security(syminfo.tickerid, tf, ta.vwap(hlc3))
    tfTrend = tfClose > tfEmaFast and tfEmaFast > tfEmaSlow and tfRsi > 50 and tfClose > tfVwap ? "BULL" : tfClose < tfEmaFast and tfEmaFast < tfEmaSlow and tfRsi < 50 and tfClose < tfVwap ? "BEAR" : "NEUTRAL"

    tfWt1 = request.security(syminfo.tickerid, tf,
         ta.ema(
             (hlc3 - ta.ema(hlc3, wtChannelLen)) /
             (0.015 * ta.ema(math.abs(hlc3 - ta.ema(hlc3, wtChannelLen)), wtChannelLen)),
             wtAverageLen))
    tfWt2 = request.security(syminfo.tickerid, tf,
         ta.sma(
             ta.ema(
                 (hlc3 - ta.ema(hlc3, wtChannelLen)) /
                 (0.015 * ta.ema(math.abs(hlc3 - ta.ema(hlc3, wtChannelLen)), wtChannelLen)),
                 wtAverageLen),
             wtMALen))
    tfWtState = tfWt1 > tfWt2 ? "BULL" : tfWt1 < tfWt2 ? "BEAR" : "NEUTRAL"
    [tfTrend, tfWtState]

//------------------------------------------------------
// Core calculations
//------------------------------------------------------
emaFast = ta.ema(close, emaLen)
emaSlow = ta.ema(close, slowEmaLen)
plot(showEMA ? emaFast : na, "Fast EMA", color=color.yellow, linewidth=2)
plot(showSlowEMA ? emaSlow : na, "Slow EMA", color=color.orange, linewidth=2)

vwapValue = ta.vwap(hlc3)
plot(showVWAP ? vwapValue : na, "Session VWAP", color=color.aqua, linewidth=2)

volSma = ta.sma(volume, volLen)
volRatio = volSma > 0 ? volume / volSma : 0.0
volSpike = volume > volSma * volSpikeMult
volSpikeExtreme = volume > volSma * volExtremeMult

highestPrev = ta.highest(high[1], lookbackHighLow)
lowestPrev = ta.lowest(low[1], lookbackHighLow)
breakoutUpRaw = confirmClose ? close > highestPrev : high > highestPrev
breakoutDownRaw = confirmClose ? close < lowestPrev : low < lowestPrev

bbBasis = ta.sma(close, bbLen)
bbDev = ta.stdev(close, bbLen) * bbMult
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
plot(showBB ? bbBasis : na, "BB Basis", color=color.new(color.blue, 20))
plot(showBB ? bbUpper : na, "BB Upper", color=color.new(color.lime, 0))
plot(showBB ? bbLower : na, "BB Lower", color=color.new(color.red, 0))
bbBreakoutUp = close > bbUpper
bbBreakoutDown = close < bbLower

rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignalLen)
rsiBull = rsi > rsiBullLevel
rsiBear = rsi < rsiBearLevel
macdBull = macdLine > macdSignal and macdHist > 0
macdBear = macdLine < macdSignal and macdHist < 0

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLen)
plus = 100 * ta.rma(plusDM, adxLen) / trur
minus = 100 * ta.rma(minusDM, adxLen) / trur
dx = 100 * math.abs(plus - minus) / math.max(plus + minus, 1)
adx = ta.rma(dx, adxLen)
adxTrend = adx > adxMin
diBull = plus > minus
diBear = minus > plus

htfClose = request.security(syminfo.tickerid, htfTf, close)
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen))
htfBull = htfClose > htfEma
htfBear = htfClose < htfEma

emaSpreadPct = emaSlow != 0 ? ((emaFast - emaSlow) / emaSlow) * 100.0 : 0.0
macdHistPct = close != 0 ? (macdHist / close) * 100.0 : 0.0
vwapDistPct = vwapValue != 0 ? ((close - vwapValue) / vwapValue) * 100.0 : 0.0

knnVote = useKNN ? f_knn_predict(rsi, emaSpreadPct, macdHistPct, vwapDistPct, knnLookback, knnNeighbors, knnForwardBars) : 0.0
knnBull = knnVote > 0
knnBear = knnVote < 0
knnState = knnBull ? "BULL" : knnBear ? "BEAR" : "NEUTRAL"
knnConfidence = knnNeighbors > 0 ? math.abs(knnVote) / knnNeighbors : 0.0
knnHighConfBull = knnBull and knnConfidence >= knnMinConfidence
knnHighConfBear = knnBear and knnConfidence >= knnMinConfidence

[wt1, wt2, wtVwapOsc, wtOversold, wtOverbought, wtCrossUp, wtCrossDown] = f_wavetrend(hlc3, wtChannelLen, wtAverageLen, wtMALen)
flowValue = f_money_flow(flowLen, flowMultiplier)
flowBull = flowValue > 0
flowBear = flowValue < 0
wtBull = wt1 > wt2
wtBear = wt1 < wt2
wtMomBull = wt1 > wt2 and wt2 > 0
wtMomBear = wt1 < wt2 and wt2 < 0
wtBuySignal = wtCrossUp and wtOversold
wtSellSignal = wtCrossDown and wtOverbought
[wtFractalTop, wtFractalBot, wtLowPrev, wtBearDiv, wtBullDiv] = f_findDivs(wt2, wtDivOBLevel, wtDivOSLevel, true)
lastRsi = ta.valuewhen(not na(wtFractalBot), rsi[2], 1)
wtGoldBuy = useWTDivergence and wtBullDiv and wtLowPrev <= wtDeepOsLevel and wt2 > wtDeepOsLevel and lastRsi < 30

trendBull = close > emaFast and emaFast > emaSlow
trendBear = close < emaFast and emaFast < emaSlow
vwapBull = close > vwapValue
vwapBear = close < vwapValue

wtBullGate = not useWTFilter or wtBull
wtBearGate = not useWTFilter or wtBear
flowBullGate = not useFlowFilter or flowBull
flowBearGate = not useFlowFilter or flowBear
knnBullGate = not useKNN or knnHighConfBull
knnBearGate = not useKNN or knnHighConfBear

passBullFilter = trendBull and (not useVWAP or vwapBull) and (not useHTFTrend or htfBull) and (not useADX or (adxTrend and diBull)) and wtBullGate and flowBullGate and knnBullGate
passBearFilter = trendBear and (not useVWAP or vwapBear) and (not useHTFTrend or htfBear) and (not useADX or (adxTrend and diBear)) and wtBearGate and flowBearGate and knnBearGate

breakoutUp = breakoutUpRaw and passBullFilter
breakoutDown = breakoutDownRaw and passBearFilter

//------------------------------------------------------
// Weighted score engine
//------------------------------------------------------
float bullScore = 0.0
float bearScore = 0.0
bullScore += trendBull ? wTrend : 0
bullScore += vwapBull ? wVWAP : 0
bullScore += htfBull ? wHTF : 0
bullScore += rsiBull ? wRSI : 0
bullScore += macdBull ? wMACD : 0
bullScore += adxTrend and diBull ? wADX : 0
bullScore += volSpike ? wVolSpike : 0
bullScore += volSpikeExtreme ? wVolExtreme : 0
bullScore += breakoutUp ? wBreakout : 0
bullScore += bbBreakoutUp ? wBB : 0
bullScore += knnHighConfBull ? wKNN : 0
bullScore += wtBull ? wWT : 0
bullScore += wtMomBull ? wWTMomentum : 0
bullScore += flowBull ? wFlow : 0
bullScore += wtBuySignal ? wWTSignal : 0
bullScore += useWTDivergence and wtBullDiv ? wWTDiv : 0
bullScore += wtGoldBuy ? wWTGold : 0

bearScore += trendBear ? wTrend : 0
bearScore += vwapBear ? wVWAP : 0
bearScore += htfBear ? wHTF : 0
bearScore += rsiBear ? wRSI : 0
bearScore += macdBear ? wMACD : 0
bearScore += adxTrend and diBear ? wADX : 0
bearScore += volSpike ? wVolSpike : 0
bearScore += volSpikeExtreme ? wVolExtreme : 0
bearScore += breakoutDown ? wBreakout : 0
bearScore += bbBreakoutDown ? wBB : 0
bearScore += knnHighConfBear ? wKNN : 0
bearScore += wtBear ? wWT : 0
bearScore += wtMomBear ? wWTMomentum : 0
bearScore += flowBear ? wFlow : 0
bearScore += wtSellSignal ? wWTSignal : 0
bearScore += useWTDivergence and wtBearDiv ? wWTDiv : 0

netScore = bullScore - bearScore
trendStrength = netScore >= strongBullThreshold ? "STRONG BULL" : netScore >= biasBullThreshold ? "BULL BIAS" : netScore <= strongBearThreshold ? "STRONG BEAR" : netScore <= biasBearThreshold ? "BEAR BIAS" : "NEUTRAL"

//------------------------------------------------------
// Mode logic
//------------------------------------------------------
contLong = breakoutUp and knnHighConfBull and bullScore > bearScore and netScore >= biasBullThreshold
contShort = breakoutDown and knnHighConfBear and bearScore > bullScore and netScore <= biasBearThreshold
revLong = (wtGoldBuy or wtBullDiv or wtBuySignal) and flowBull and (close > emaFast or close > vwapValue) and netScore > 0
revShort = (wtBearDiv or wtSellSignal) and flowBear and (close < emaFast or close < vwapValue) and netScore < 0
longSignal = modeInput == "Continuation" ? contLong : modeInput == "Reversal" ? revLong : (contLong or revLong)
shortSignal = modeInput == "Continuation" ? contShort : modeInput == "Reversal" ? revShort : (contShort or revShort)

//------------------------------------------------------
// One-shot event logic
//------------------------------------------------------
newVolSpike = volSpike and not volSpike[1]
newVolExtreme = volSpikeExtreme and not volSpikeExtreme[1]
newBreakoutUp = breakoutUp and not breakoutUp[1]
newBreakoutDown = breakoutDown and not breakoutDown[1]
newBBUp = bbBreakoutUp and not bbBreakoutUp[1]
newBBDown = bbBreakoutDown and not bbBreakoutDown[1]
newWtBuy = wtBuySignal and not wtBuySignal[1]
newWtSell = wtSellSignal and not wtSellSignal[1]
newWtGold = wtGoldBuy and not wtGoldBuy[1]
newBullDiv = wtBullDiv and not wtBullDiv[1]
newBearDiv = wtBearDiv and not wtBearDiv[1]
newLongSignal = longSignal and not longSignal[1]
newShortSignal = shortSignal and not shortSignal[1]

//------------------------------------------------------
// Confidence band
//------------------------------------------------------
confBullBand = 50 + knnConfidence * 50
confBearBand = 50 - knnConfidence * 50
pBullConf = plot(showConfidenceBand ? confBullBand : na, "KNN Bull Confidence", color=color.new(color.green, 0), display=display.none)
pBearConf = plot(showConfidenceBand ? confBearBand : na, "KNN Bear Confidence", color=color.new(color.red, 0), display=display.none)
fill(pBullConf, pBearConf, color=showConfidenceBand ? (knnBull ? color.new(color.green, 86) : knnBear ? color.new(color.red, 86) : color.new(color.gray, 90)) : na)

//------------------------------------------------------
// Markers and labels
//------------------------------------------------------
atr = ta.atr(atrLen)

plotshape(showConfirmMarkers and newVolSpike, title="VS", style=shape.circle, location=location.belowbar, color=color.orange,text="VS", size=size.tiny)
plotshape(showConfirmMarkers and newVolExtreme, title="EV", style=shape.circle, location=location.belowbar, color=color.red,text="EV", size=size.tiny)
plotshape(showConfirmMarkers and newBreakoutUp, title="BO+", style=shape.triangleup, location=location.belowbar, color=color.green,text="BO+", size=size.tiny)
plotshape(showConfirmMarkers and newBreakoutDown, title="BO-", style=shape.triangledown, location=location.abovebar, color=color.red,text="BO-", size=size.tiny)
plotshape(showConfirmMarkers and newBBUp, title="BB+", style=shape.triangleup, location=location.belowbar, color=color.lime,text="BB+", size=size.tiny)
plotshape(showConfirmMarkers and newBBDown, title="BB-", style=shape.triangledown, location=location.abovebar, color=color.maroon,text="BB-", size=size.tiny)
plotshape(showConfirmMarkers and newWtBuy, title="WT+", style=shape.circle, location=location.belowbar, color=color.teal,text="WT+", size=size.tiny)
plotshape(showConfirmMarkers and newWtSell, title="WT-", style=shape.circle, location=location.abovebar, color=color.purple,text="WT-", size=size.tiny)
plotshape(showConfirmMarkers and newBullDiv, title="Div+", style=shape.diamond, location=location.belowbar, color=color.new(color.green, 0),text="DIV+", size=size.tiny)
plotshape(showConfirmMarkers and newBearDiv, title="Div-", style=shape.diamond, location=location.abovebar, color=color.new(color.red, 0), text="DIV-",size=size.tiny)
plotshape(showConfirmMarkers and newWtGold, title="Gold", style=shape.square, location=location.belowbar, color=color.orange, text="Gold", size=size.tiny)

if showSignals and newLongSignal
    label.new(bar_index, low - atr * 0.20, "BUY", yloc=yloc.price, style=label.style_label_up, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)
if showSignals and newShortSignal
    label.new(bar_index, high + atr * 0.20, "SELL", yloc=yloc.price, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)

//------------------------------------------------------
// Bar colors
//------------------------------------------------------
barCol = netScore >= strongBullThreshold - 2 ? color.new(color.green, 0) : netScore <= strongBearThreshold + 2 ? color.new(color.red, 0) : netScore > 0 ? color.new(color.lime, 40) : netScore < 0 ? color.new(color.orange, 40) : na
barcolor(showBarColors ? barCol : na)

//------------------------------------------------------
// Last-bar score label
//------------------------------------------------------
var label scoreLbl = na
if showScoreLabel and barstate.islast
    if not na(scoreLbl)
        label.delete(scoreLbl)
    vwapState = vwapBull ? "Above" : "Below"
    htfState = htfBull ? "Bull" : htfBear ? "Bear" : "Flat"
    wtState = wtBull ? "Bull" : wtBear ? "Bear" : "Flat"
    flowState = flowBull ? "+" : flowBear ? "-" : "0"
    txt = "Mode: " + modeInput +
          "\nTrend: " + trendStrength +
          "\nNet: " + str.tostring(netScore, "#.00") +
          "\nBull: " + str.tostring(bullScore, "#.00") +
          "\nBear: " + str.tostring(bearScore, "#.00") +
          "\nKNN: " + knnState + " (" + str.tostring(knnConfidence * 100, "#.0") + "%)" +
          "\nWT: " + wtState +
          "\nFlow: " + flowState +
          "\nVWAP: " + vwapState +
          "\nHTF: " + htfState +
          "\nRSI: " + str.tostring(rsi, "#.0") +
          "\nMACD Hist: " + str.tostring(macdHist, "#.000") +
          "\nADX: " + str.tostring(adx, "#.0") +
          "\nVol x: " + str.tostring(volRatio, "#.##")
    lblColor = netScore >= 0 ? scoreBullColor : scoreBearColor
    scoreLbl := label.new(bar_index, high + atr * 0.55, txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=lblColor, textcolor=color.white, size=size.small)

//------------------------------------------------------
// Trend table with distinct MTF values
//------------------------------------------------------
var table trendTbl = table.new(f_pos(tablePosInput), 5, 4, border_width=1)
[tf5Trend, tf5Wt] = f_tf_model_state("5")
[tf10Trend, tf10Wt] = f_tf_model_state("10")
[tf15Trend, tf15Wt] = f_tf_model_state("15")
knnConfTxt = str.tostring(knnConfidence * 100, "#.0") + "%"
model5 = tf5Trend == tf5Wt ? "Align" : "Mixed"
model10 = tf10Trend == tf10Wt ? "Align" : "Mixed"
model15 = tf15Trend == tf15Wt ? "Align" : "Mixed"

if barstate.islast
    if showTrendTable
        table.clear(trendTbl, 0, 0, 4, 3)
        table.cell(trendTbl, 0, 0, "TF", text_color=color.white, bgcolor=color.black)
        table.cell(trendTbl, 1, 0, "Trend", text_color=color.white, bgcolor=color.black)
        table.cell(trendTbl, 2, 0, "Model", text_color=color.white, bgcolor=color.black)
        table.cell(trendTbl, 3, 0, "WT", text_color=color.white, bgcolor=color.black)
        table.cell(trendTbl, 4, 0, "Conf", text_color=color.white, bgcolor=color.black)

        table.cell(trendTbl, 0, 1, "5m", text_color=color.white, bgcolor=color.new(color.silver, 70))
        table.cell(trendTbl, 1, 1, tf5Trend, text_color=color.white, bgcolor=f_bg(tf5Trend))
        table.cell(trendTbl, 2, 1, model5, text_color=color.white, bgcolor=model5 == "Align" ? color.new(color.green, 60) : color.new(color.orange, 40))
        table.cell(trendTbl, 3, 1, tf5Wt, text_color=color.white, bgcolor=f_bg(tf5Wt))
        table.cell(trendTbl, 4, 1, knnConfTxt, text_color=color.white, bgcolor=knnConfidence >= knnMinConfidence ? color.new(color.green, 60) : color.new(color.orange, 50))

        table.cell(trendTbl, 0, 2, "10m", text_color=color.white, bgcolor=color.new(color.silver, 70))
        table.cell(trendTbl, 1, 2, tf10Trend, text_color=color.white, bgcolor=f_bg(tf10Trend))
        table.cell(trendTbl, 2, 2, model10, text_color=color.white, bgcolor=model10 == "Align" ? color.new(color.green, 60) : color.new(color.orange, 40))
        table.cell(trendTbl, 3, 2, tf10Wt, text_color=color.white, bgcolor=f_bg(tf10Wt))
        table.cell(trendTbl, 4, 2, knnConfTxt, text_color=color.white, bgcolor=knnConfidence >= knnMinConfidence ? color.new(color.green, 60) : color.new(color.orange, 50))

        table.cell(trendTbl, 0, 3, "15m", text_color=color.white, bgcolor=color.new(color.silver, 70))
        table.cell(trendTbl, 1, 3, tf15Trend, text_color=color.white, bgcolor=f_bg(tf15Trend))
        table.cell(trendTbl, 2, 3, model15, text_color=color.white, bgcolor=model15 == "Align" ? color.new(color.green, 60) : color.new(color.orange, 40))
        table.cell(trendTbl, 3, 3, tf15Wt, text_color=color.white, bgcolor=f_bg(tf15Wt))
        table.cell(trendTbl, 4, 3, knnConfTxt, text_color=color.white, bgcolor=knnConfidence >= knnMinConfidence ? color.new(color.green, 60) : color.new(color.orange, 50))
    else
        table.clear(trendTbl, 0, 0, 4, 3)

//------------------------------------------------------
// Strategy orders
//------------------------------------------------------
if enableStrategy and longsEnabled and newLongSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
if enableStrategy and shortsEnabled and newShortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)

longStop = strategy.position_avg_price - atr * stopATR
longTarget = strategy.position_avg_price + atr * targetATR
shortStop = strategy.position_avg_price + atr * stopATR
shortTarget = strategy.position_avg_price - atr * targetATR
trailTicks = math.max(1, math.round((atr * trailATR) / syminfo.mintick))

if enableStrategy and strategy.position_size > 0 and (exitMode == "ATR Bracket" or exitMode == "Hybrid")
    if useTrailing
        strategy.exit("Long Exit", "Long", stop=longStop, limit=longTarget, trail_offset=trailTicks)
    else
        strategy.exit("Long Exit", "Long", stop=longStop, limit=longTarget)

if enableStrategy and strategy.position_size < 0 and (exitMode == "ATR Bracket" or exitMode == "Hybrid")
    if useTrailing
        strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortTarget, trail_offset=trailTicks)
    else
        strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortTarget)

scoreFlipLongExit = strategy.position_size > 0 and (netScore <= 0 or newShortSignal)
scoreFlipShortExit = strategy.position_size < 0 and (netScore >= 0 or newLongSignal)

if enableStrategy and (exitMode == "Score Flip" or exitMode == "Hybrid")
    if scoreFlipLongExit
        strategy.close("Long")
    if scoreFlipShortExit
        strategy.close("Short")

//------------------------------------------------------
// Alerts
//------------------------------------------------------
alertcondition(newLongSignal, "BUY Signal", "Clean label BUY signal")
alertcondition(newShortSignal, "SELL Signal", "Clean label SELL signal")
alertcondition(contLong and not contLong[1], "Continuation BUY", "Continuation buy setup")
alertcondition(contShort and not contShort[1], "Continuation SELL", "Continuation sell setup")
alertcondition(revLong and not revLong[1], "Reversal BUY", "Reversal buy setup")
alertcondition(revShort and not revShort[1], "Reversal SELL", "Reversal sell setup")
alertcondition(knnHighConfBull and not knnHighConfBull[1], "KNN Bull", "High-confidence KNN bull")
alertcondition(knnHighConfBear and not knnHighConfBear[1], "KNN Bear", "High-confidence KNN bear")
