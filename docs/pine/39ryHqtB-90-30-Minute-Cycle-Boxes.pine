//@version=6
indicator("90/30 Minute Cycle Boxes", overlay=true)

// === INPUTS ===
cycleLengthMinutes = 90
subCycles = 3

// === TIME CALCULATIONS ===
cycleLengthMs = cycleLengthMinutes * 60 * 1000
subCycleLengthMs = cycleLengthMs / subCycles

var float cycleHigh = na
var float cycleLow = na
var int cycleStart = na
var color boxColor = color.new(color.blue, 85)
var color subBoxColor = color.new(color.green, 90)

// Check for new cycle start
isNewCycle = na(cycleStart) or (time - cycleStart >= cycleLengthMs)
if isNewCycle
    cycleStart := time - (time % cycleLengthMs)
    cycleHigh := high
    cycleLow := low
else
    cycleHigh := math.max(cycleHigh, high)
    cycleLow := math.min(cycleLow, low)

// === DRAW MAIN CYCLE BOX ===
var box mainBox = na
if isNewCycle
    mainBox := box.new(cycleStart, cycleHigh, cycleStart + cycleLengthMs, cycleLow, border_color=color.blue, bgcolor=boxColor)
else
    box.set_right(mainBox, time)
    box.set_top(mainBox, cycleHigh)
    box.set_bottom(mainBox, cycleLow)

// === DRAW SUB-CYCLE BOXES ===
for i = 0 to subCycles - 1
    subStart = cycleStart + i * subCycleLengthMs
    subEnd = subStart + subCycleLengthMs
    isInSubCycle = (time >= subStart and time < subEnd)

    var float subHigh = na
    var float subLow = na
    if isInSubCycle
        subHigh := na(subHigh) ? high : math.max(subHigh, high)
        subLow := na(subLow) ? low : math.min(subLow, low)
        var box subBox = na
        subBox := box.new(subStart, subHigh, subEnd, subLow, border_color=color.green, bgcolor=subBoxColor)

