//@version=6
strategy(
     "NAS100 / SP500 - Turtle Soup NY V4 FIXED",
     overlay = true,
     pyramiding = 0,
     initial_capital = 10000
)

//====================================================
//==================== INPUTS ========================
//====================================================

// HORARIO RANGO
rangeSession = input.session(
     "0600-0859",
     "Rango NY",
     group = "Horario"
)

// HORARIO OPERATIVA
startHour = input.int(
     9,
     "Hora inicio",
     minval = 0,
     maxval = 23,
     group = "Horario"
)

startMinute = input.int(
     30,
     "Minuto inicio",
     minval = 0,
     maxval = 59,
     group = "Horario"
)

endHour = input.int(
     12,
     "Hora fin",
     minval = 0,
     maxval = 23,
     group = "Horario"
)

endMinute = input.int(
     0,
     "Minuto fin",
     minval = 0,
     maxval = 59,
     group = "Horario"
)

// GESTIÓN
slBuffer = input.float(
     2.0,
     "SL Buffer",
     step = 0.25,
     group = "Gestión"
)

minimumRR = input.float(
     1.0,
     "RR mínimo",
     step = 0.1,
     group = "Gestión"
)

// VISUAL
showBox = input.bool(
     true,
     "Mostrar caja",
     group = "Visual"
)

showLabels = input.bool(
     true,
     "Mostrar etiquetas",
     group = "Visual"
)

//====================================================
//==================== HORARIO =======================
//====================================================

nyHour = hour(time, "America/New_York")
nyMinute = minute(time, "America/New_York")

afterStart = (
     nyHour > startHour or
     (nyHour == startHour and nyMinute >= startMinute)
)

beforeEnd = (
     nyHour < endHour or
     (nyHour == endHour and nyMinute <= endMinute)
)

allowedTrading = afterStart and beforeEnd

//====================================================
//==================== RESET =========================
//====================================================

newDay = dayofmonth(time, "America/New_York") != dayofmonth(time[1], "America/New_York")

var bool tradeTaken = false

if newDay
    tradeTaken := false

//====================================================
//==================== RANGO =========================
//====================================================

inRange = not na(
     time(
          timeframe.period,
          rangeSession,
          "America/New_York"
     )
)

var float rangeHigh = na
var float rangeLow = na

var bool rangeReady = false

newRange = inRange and not inRange[1]
endRange = not inRange and inRange[1]

// RESET
if newDay
    rangeHigh := na
    rangeLow := na
    rangeReady := false

// INICIO
if newRange
    rangeHigh := high
    rangeLow := low

// CONSTRUCCIÓN
if inRange
    rangeHigh := math.max(rangeHigh, high)
    rangeLow := math.min(rangeLow, low)

// FINAL
if endRange
    rangeReady := true

//====================================================
//==================== VISUALES ======================
//====================================================

var box rangeBox = na

if showBox

    if newRange

        rangeBox := box.new(
             left = bar_index,
             right = bar_index,
             top = high,
             bottom = low,
             bgcolor = color.new(color.purple, 88),
             border_color = color.new(color.gray, 50)
        )

    if inRange and not na(rangeBox)

        box.set_top(rangeBox, rangeHigh)
        box.set_bottom(rangeBox, rangeLow)
        box.set_right(rangeBox, bar_index)

// HIGH
plot(
     rangeReady ? rangeHigh : na,
     color = color.red,
     linewidth = 3,
     title = "HIGH RANGO"
)

// LOW
plot(
     rangeReady ? rangeLow : na,
     color = color.aqua,
     linewidth = 3,
     title = "LOW RANGO"
)

//====================================================
//==================== TURTLE SOUP ===================
//====================================================

// BARRIDA LOW
sweepLow = (
     low < rangeLow
)

// BARRIDA HIGH
sweepHigh = (
     high > rangeHigh
)

//====================================================
//==================== RECHAZO =======================
//====================================================

// RECHAZO ALCISTA
bullishRejection = (
     close > open and
     close > ((high + low) / 2)
)

// RECHAZO BAJISTA
bearishRejection = (
     close < open and
     close < ((high + low) / 2)
)

//====================================================
//==================== VARIABLES =====================
//====================================================

var bool longSetup = false
var bool shortSetup = false

var float longManipulationLow = na
var float shortManipulationHigh = na

//====================================================
//==================== DETECCIÓN =====================
//====================================================

// LONG
if rangeReady and allowedTrading and not tradeTaken

    if sweepLow

        longSetup := true
        shortSetup := false

        longManipulationLow := low

// SHORT
if rangeReady and allowedTrading and not tradeTaken

    if sweepHigh

        shortSetup := true
        longSetup := false

        shortManipulationHigh := high

//====================================================
//==================== LONG ==========================
//====================================================

bool longSignal = false

float longSL = na
float longTP = na
float longEntry = na

if longSetup and bullishRejection

    tempSL = longManipulationLow - slBuffer
    tempEntry = close
    tempTP = rangeHigh

    risk = tempEntry - tempSL
    reward = tempTP - tempEntry

    rr = reward / risk

    // RR MÍNIMO
    if rr >= minimumRR

        longSignal := true

        longSL := tempSL
        longEntry := tempEntry
        longTP := tempTP

//====================================================
//==================== SHORT =========================
//====================================================

bool shortSignal = false

float shortSL = na
float shortTP = na
float shortEntry = na

if shortSetup and bearishRejection

    tempSL = shortManipulationHigh + slBuffer
    tempEntry = close
    tempTP = rangeLow

    risk = tempSL - tempEntry
    reward = tempEntry - tempTP

    rr = reward / risk

    // RR MÍNIMO
    if rr >= minimumRR

        shortSignal := true

        shortSL := tempSL
        shortEntry := tempEntry
        shortTP := tempTP

//====================================================
//==================== ENTRADAS ======================
//====================================================

// LONG
if longSignal and strategy.position_size == 0 and not tradeTaken

    strategy.entry(
         "LONG",
         strategy.long
    )

    strategy.exit(
         "LONG EXIT",
         from_entry = "LONG",
         stop = longSL,
         limit = longTP
    )

    tradeTaken := true

    longSetup := false

    // ENTRY
    line.new(
         bar_index,
         longEntry,
         bar_index + 20,
         longEntry,
         color = color.yellow,
         width = 2
    )

    // SL
    line.new(
         bar_index,
         longSL,
         bar_index + 20,
         longSL,
         color = color.red,
         width = 2
    )

    // TP
    line.new(
         bar_index,
         longTP,
         bar_index + 20,
         longTP,
         color = color.aqua,
         width = 2
    )

    if showLabels

        label.new(
             bar_index,
             low,
             "LONG",
             style = label.style_label_up,
             color = color.lime,
             textcolor = color.black
        )

// SHORT
if shortSignal and strategy.position_size == 0 and not tradeTaken

    strategy.entry(
         "SHORT",
         strategy.short
    )

    strategy.exit(
         "SHORT EXIT",
         from_entry = "SHORT",
         stop = shortSL,
         limit = shortTP
    )

    tradeTaken := true

    shortSetup := false

    // ENTRY
    line.new(
         bar_index,
         shortEntry,
         bar_index + 20,
         shortEntry,
         color = color.yellow,
         width = 2
    )

    // SL
    line.new(
         bar_index,
         shortSL,
         bar_index + 20,
         shortSL,
         color = color.red,
         width = 2
    )

    // TP
    line.new(
         bar_index,
         shortTP,
         bar_index + 20,
         shortTP,
         color = color.aqua,
         width = 2
    )

    if showLabels

        label.new(
             bar_index,
             high,
             "SHORT",
             style = label.style_label_down,
             color = color.red,
             textcolor = color.white
        )

//====================================================
//==================== ALERTAS =======================
//====================================================

alertcondition(
     longSignal,
     title = "LONG",
     message = "LONG NAS100/SP500"
)

alertcondition(
     shortSignal,
     title = "SHORT",
     message = "SHORT NAS100/SP500"
)