//@version=6
// @description Timeframe Utilities Library – Provides functions to convert timeframe resolutions to minutes and generate human‐readable timeframe text.
library("TimeframeUtils")

//@function resInMinutes
//@returns float - The current chart's resolution in minutes.
resInMinutes() =>
    _resInMinutes = timeframe.multiplier *
         (timeframe.isseconds  ? 1. / 60 :        // Convert seconds to minutes
         timeframe.isminutes  ? 1. :             // Already in minutes
         timeframe.isdaily    ? 60. * 24 :         // Daily: 24 hours * 60 minutes
         timeframe.isweekly   ? 60. * 24 * 7 :     // Weekly: 7 days * 24 * 60 minutes
         timeframe.ismonthly  ? 60. * 24 * 30.4375 :// Monthly: average month length in days
         na)
    _resInMinutes

// @function tfResInMinutes
// @param simple string _res - The resolution string to be converted (e.g., "15", "D", etc.).
// @returns float - The specified timeframe's resolution in minutes.
export tfResInMinutes(string _res) =>
    request.security(syminfo.tickerid, _res, resInMinutes())

//@function tfType
//@param simple string _res - The resolution string (e.g., "15", "D", etc.).
//@returns string - The type of the timeframe, one of "Intraday", "Daily", "Weekly", or "Monthly".
tfType(string _res) =>
    [isIntraday, isDaily, isWeekly, isMonthly] = request.security(syminfo.tickerid, _res, 
         [timeframe.isintraday, timeframe.isdaily, timeframe.isweekly, timeframe.ismonthly])
    isIntraday ? "Intraday" : isDaily ? "Daily" : isWeekly ? "Weekly" : isMonthly ? "Monthly" : "Error"

//@function getTimeFrameText
//@param simple string _tf - The timeframe string input.
//@returns string - A human-readable representation of the specified timeframe.
export getTimeFrameText(string _tf) =>
    series string tfStr = str.tostring(_tf)
    typeText = tfType(_tf)
    if tfStr == ""  // When the input timeframe is empty, use the chart's timeframe
        tfStr := na(timeframe.multiplier / 60) ? timeframe.period :
             timeframe.multiplier < 60 ? timeframe.period + " min" : str.tostring(timeframe.multiplier / 60) + " hour"
    else if typeText == "Intraday"
        tfStr := na(str.tonumber(_tf) / 60) ? str.tostring(_tf) :
             str.tonumber(_tf) < 60 ? str.tostring(_tf) + " min" : str.tostring(str.tonumber(_tf) / 60) + " hour"
    else
        tfStr := str.tostring(_tf)
    tfStr
