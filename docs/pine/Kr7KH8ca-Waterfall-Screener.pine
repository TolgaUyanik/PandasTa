// @version=5
// --- CORRECTED SCREENER-FRIENDLY VERSION ---
// This version removes request.security() to be compatible with the screener.
indicator("Waterfall Screener", shorttitle="WVS", overlay=false)

// Part 1: User Inputs (No timeframe input needed)
mciLength = input.int(14, "MCI Lookback", group="Core Calculation")
mciMaLength = input.int(20, "MCI MA Length", group="Core Calculation")
atrLength = input.int(20, "ATR Period for Bands", group="Core Calculation")
atrMultiplier = input.float(2.0, "ATR Multiplier", group="Core Calculation")
pivotLookbackLeft = input.int(25, "Pivot Lookback Left", group="Core Calculation")
pivotLookbackRight = input.int(2, "Pivot Lookback Right", group="Core Calculation")

// Part 2: Core Calculation (Runs directly on the chart's data)
priceChange = (close - close[mciLength]) / close[mciLength] * 100
volSum = ta.sma(volume, mciLength) * mciLength
mci = math.abs(priceChange) > 0 ? volSum / math.abs(priceChange) : 0
mciSma = ta.sma(mci, mciMaLength)
upperBand = mciSma + (ta.rma(math.abs(mci - mci[1]), atrLength) * atrMultiplier)

// Divergence Logic
var float last_mciPH_val = na, var float last_priceAtMciPH = na
bool bearishDivergence = false
mciPivotHigh = ta.pivothigh(mci, pivotLookbackLeft, pivotLookbackRight)
if not na(mciPivotHigh)
    priceAtMciPH = high[pivotLookbackRight]
    if not na(last_mciPH_val) and priceAtMciPH > last_priceAtMciPH and mciPivotHigh < last_mciPH_val
        bearishDivergence := true
    last_mciPH_val := mciPivotHigh
    last_priceAtMciPH := priceAtMciPH

// Setup Condition
bool bearishSetup = bearishDivergence and mci > upperBand

// --- Part 3: Screener Output ---
// Output a 1 only on the very first bar of a new setup.
screenerSignal = bearishSetup and not bearishSetup[1] ? 1 : 0

// Plot the numerical signal. This is what the screener will "see".
plot(screenerSignal, "Setup Signal")