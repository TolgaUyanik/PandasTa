//@version=6
indicator("Equal High / Low Alerts", shorttitle="EQH/EQL", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================================
// GENERAL SETTINGS
// ==========================================================
general_group = "General Settings"

equal_tolerance_ticks = input.int(1, "Equal-Level Tolerance (Ticks)", minval=0, group=general_group, tooltip="0 requires exact equality. A value of 1 allows a difference of one minimum tick.")
max_active_levels = input.int(300, "Maximum Active Levels", minval=10, maxval=500, group=general_group)
max_pivot_lines = input.int(100, "Maximum Pivot Lines", minval=1, maxval=250, group=general_group)
max_signal_labels = input.int(250, "Maximum Signal Labels", minval=10, maxval=500, group=general_group)

// ==========================================================
// CHART TIMEFRAME FILTER
// ==========================================================
chart_tf_group = "Chart Timeframe Filter"

use_chart_tf_filter = input.bool(false, "Enable Chart Timeframe Filter", group=chart_tf_group)

allowed_chart_timeframe = input.timeframe(
     "",
     "Allowed Chart Timeframe",
     group=chart_tf_group,
     tooltip="Leave blank to allow every chart timeframe. For example, select 5 to show signals only on a 5-minute chart."
)

// ==========================================================
// SIGNAL TIME FILTER
// ==========================================================
time_group = "Signal Time Filter"

use_time_filter = input.bool(false, "Enable Time Filter", group=time_group)

signal_session = input.session(
     "0930-1600",
     "Signal Time Window",
     group=time_group,
     tooltip="Signals and alerts can appear only during this time window when the filter is enabled."
)

signal_timezone = input.string(
     "America/New_York",
     "Time Zone",
     options=["America/New_York", "America/Chicago", "America/Los_Angeles", "Etc/UTC"],
     group=time_group
)

// ==========================================================
// SIGNAL APPEARANCE
// ==========================================================
appearance_group = "Signal Appearance"

show_signals = input.bool(true, "Show Signals", group=appearance_group)

signal_shape_input = input.string(
     "Label",
     "Signal Shape",
     options=["Label", "Triangle", "Arrow", "Diamond", "Circle", "Square"],
     group=appearance_group
)

signal_size_input = input.string(
     "Small",
     "Signal Size",
     options=["Tiny", "Small", "Normal", "Large"],
     group=appearance_group
)

candle_equal_high_text = input.string("EQH", "Candle Equal High Text", group=appearance_group)
candle_equal_low_text = input.string("EQL", "Candle Equal Low Text", group=appearance_group)
pivot_equal_high_text = input.string("P EQH", "Pivot Equal High Text", group=appearance_group)
pivot_equal_low_text = input.string("P EQL", "Pivot Equal Low Text", group=appearance_group)

// ==========================================================
// CANDLE EQUAL HIGHS / LOWS
// ==========================================================
candle_group = "Candle Equal Highs / Lows"

enable_candle_equal_highs = input.bool(true, "Detect Candle Equal Highs", group=candle_group, inline="ceh")
candle_equal_high_color = input.color(color.red, "", group=candle_group, inline="ceh")

enable_candle_equal_lows = input.bool(true, "Detect Candle Equal Lows", group=candle_group, inline="cel")
candle_equal_low_color = input.color(color.lime, "", group=candle_group, inline="cel")

max_nonpivot_bars_between = input.int(
     10,
     "Maximum Candles Between Non-Pivot Matches",
     minval=0,
     maxval=500,
     group=candle_group,
     tooltip="0 means equal highs/lows must be on consecutive candles. A value of 10 allows up to 10 candles between the two matching candles."
)

// ==========================================================
// PIVOT EQUAL HIGHS / LOWS
// ==========================================================
pivot_group = "Pivot Equal Highs / Lows"

enable_pivot_equal_highs = input.bool(true, "Detect Pivot Equal Highs", group=pivot_group, inline="peh")
pivot_equal_high_color = input.color(color.orange, "", group=pivot_group, inline="peh")

enable_pivot_equal_lows = input.bool(true, "Detect Pivot Equal Lows", group=pivot_group, inline="pel")
pivot_equal_low_color = input.color(color.aqua, "", group=pivot_group, inline="pel")

pivot_length = input.int(5, "Pivot Length", minval=1, maxval=50, group=pivot_group, tooltip="A pivot is confirmed this many bars after the actual swing point.")
show_pivot_lines = input.bool(true, "Show Pivot Connection Lines", group=pivot_group)

pivot_line_style_input = input.string(
     "Dashed",
     "Pivot Line Style",
     options=["Solid", "Dashed", "Dotted"],
     group=pivot_group
)

// ==========================================================
// RUNTIME ALERT SETTINGS
// ==========================================================
alert_group = "Runtime Alert Settings"

use_runtime_alerts = input.bool(
     false,
     "Use Runtime alert()",
     group=alert_group,
     tooltip="Enable this only if you create a TradingView alert using 'Any alert() function call'."
)

alert_on_close = input.bool(true, "Alert Once Per Bar Close", group=alert_group)

// ==========================================================
// HELPERS
// ==========================================================
tolerance = syminfo.mintick * equal_tolerance_ticks

in_signal_window = not na(time(timeframe.period, signal_session, signal_timezone))
time_allowed = not use_time_filter or in_signal_window

chart_timeframe_allowed = not use_chart_tf_filter or allowed_chart_timeframe == "" or timeframe.period == allowed_chart_timeframe

signal_allowed = time_allowed and chart_timeframe_allowed

f_equal(value_1, value_2) =>
    math.abs(value_1 - value_2) <= tolerance

f_line_style(style_name) =>
    style_name == "Solid" ? line.style_solid :
     style_name == "Dotted" ? line.style_dotted :
     line.style_dashed

f_label_style(is_high) =>
    signal_shape_input == "Triangle" ? (is_high ? label.style_triangledown : label.style_triangleup) :
     signal_shape_input == "Arrow" ? (is_high ? label.style_arrowdown : label.style_arrowup) :
     signal_shape_input == "Diamond" ? label.style_diamond :
     signal_shape_input == "Circle" ? label.style_circle :
     signal_shape_input == "Square" ? label.style_square :
     (is_high ? label.style_label_down : label.style_label_up)

f_label_size() =>
    signal_size_input == "Tiny" ? size.tiny :
     signal_size_input == "Normal" ? size.normal :
     signal_size_input == "Large" ? size.large :
     size.small

f_remove_surpassed_highs(price_array, bar_array) =>
    int i = array.size(price_array) - 1

    while i >= 0
        candidate_price = array.get(price_array, i)

        if high > candidate_price + tolerance
            array.remove(price_array, i)
            array.remove(bar_array, i)

        i := i - 1

f_remove_surpassed_lows(price_array, bar_array) =>
    int i = array.size(price_array) - 1

    while i >= 0
        candidate_price = array.get(price_array, i)

        if low < candidate_price - tolerance
            array.remove(price_array, i)
            array.remove(bar_array, i)

        i := i - 1

f_find_equal_candle_level(price_array, bar_array, target_price) =>
    int matching_index = na
    int i = array.size(price_array) - 1

    while i >= 0
        candidate_price = array.get(price_array, i)
        candidate_bar = array.get(bar_array, i)

        candles_between = bar_index - candidate_bar - 1
        within_maximum_distance = candles_between <= max_nonpivot_bars_between

        if within_maximum_distance and f_equal(candidate_price, target_price)
            matching_index := i
            break

        i := i - 1

    matching_index

f_find_equal_pivot_level(price_array, target_price) =>
    int matching_index = na
    int i = array.size(price_array) - 1

    while i >= 0
        candidate_price = array.get(price_array, i)

        if f_equal(candidate_price, target_price)
            matching_index := i
            break

        i := i - 1

    matching_index

f_add_active_level(price_array, bar_array, price, level_bar) =>
    array.push(price_array, price)
    array.push(bar_array, level_bar)

    if array.size(price_array) > max_active_levels
        array.shift(price_array)
        array.shift(bar_array)

f_add_signal_label(label_array, new_label) =>
    array.push(label_array, new_label)

    if array.size(label_array) > max_signal_labels
        old_label = array.shift(label_array)
        label.delete(old_label)

f_add_pivot_line(line_array, new_line) =>
    array.push(line_array, new_line)

    if array.size(line_array) > max_pivot_lines
        old_line = array.shift(line_array)
        line.delete(old_line)

// ==========================================================
// CANDLE EQUAL HIGHS / LOWS
// ==========================================================
var active_candle_high_prices = array.new_float()
var active_candle_high_bars = array.new_int()

var active_candle_low_prices = array.new_float()
var active_candle_low_bars = array.new_int()

f_remove_surpassed_highs(active_candle_high_prices, active_candle_high_bars)
f_remove_surpassed_lows(active_candle_low_prices, active_candle_low_bars)

matching_candle_high_index = f_find_equal_candle_level(active_candle_high_prices, active_candle_high_bars, high)
matching_candle_low_index = f_find_equal_candle_level(active_candle_low_prices, active_candle_low_bars, low)

raw_candle_equal_high = not na(matching_candle_high_index)
raw_candle_equal_low = not na(matching_candle_low_index)

f_add_active_level(active_candle_high_prices, active_candle_high_bars, high, bar_index)
f_add_active_level(active_candle_low_prices, active_candle_low_bars, low, bar_index)

candle_equal_high = signal_allowed and enable_candle_equal_highs and raw_candle_equal_high
candle_equal_low = signal_allowed and enable_candle_equal_lows and raw_candle_equal_low

// ==========================================================
// PIVOT EQUAL HIGHS / LOWS
// ==========================================================
pivot_high = ta.pivothigh(high, pivot_length, pivot_length)
pivot_low = ta.pivotlow(low, pivot_length, pivot_length)

var active_pivot_high_prices = array.new_float()
var active_pivot_high_bars = array.new_int()

var active_pivot_low_prices = array.new_float()
var active_pivot_low_bars = array.new_int()

bool raw_pivot_equal_high = false
bool raw_pivot_equal_low = false

int matching_pivot_high_bar = na
int matching_pivot_low_bar = na

float matching_pivot_high_price = na
float matching_pivot_low_price = na

f_remove_surpassed_highs(active_pivot_high_prices, active_pivot_high_bars)
f_remove_surpassed_lows(active_pivot_low_prices, active_pivot_low_bars)

if not na(pivot_high)
    matching_pivot_high_index = f_find_equal_pivot_level(active_pivot_high_prices, pivot_high)
    raw_pivot_equal_high := not na(matching_pivot_high_index)

    if raw_pivot_equal_high
        matching_pivot_high_price := array.get(active_pivot_high_prices, matching_pivot_high_index)
        matching_pivot_high_bar := array.get(active_pivot_high_bars, matching_pivot_high_index)

    f_add_active_level(active_pivot_high_prices, active_pivot_high_bars, pivot_high, bar_index[pivot_length])

if not na(pivot_low)
    matching_pivot_low_index = f_find_equal_pivot_level(active_pivot_low_prices, pivot_low)
    raw_pivot_equal_low := not na(matching_pivot_low_index)

    if raw_pivot_equal_low
        matching_pivot_low_price := array.get(active_pivot_low_prices, matching_pivot_low_index)
        matching_pivot_low_bar := array.get(active_pivot_low_bars, matching_pivot_low_index)

    f_add_active_level(active_pivot_low_prices, active_pivot_low_bars, pivot_low, bar_index[pivot_length])

pivot_equal_high = signal_allowed and enable_pivot_equal_highs and raw_pivot_equal_high
pivot_equal_low = signal_allowed and enable_pivot_equal_lows and raw_pivot_equal_low

// ==========================================================
// DRAW SIGNALS
// ==========================================================
var signal_labels = array.new_label()
var pivot_high_lines = array.new_line()
var pivot_low_lines = array.new_line()

if show_signals and candle_equal_high
    f_add_signal_label(
         signal_labels,
         label.new(
             bar_index,
             high,
             candle_equal_high_text,
             style=f_label_style(true),
             color=candle_equal_high_color,
             textcolor=color.white,
             size=f_label_size()
         )
    )

if show_signals and candle_equal_low
    f_add_signal_label(
         signal_labels,
         label.new(
             bar_index,
             low,
             candle_equal_low_text,
             style=f_label_style(false),
             color=candle_equal_low_color,
             textcolor=color.white,
             size=f_label_size()
         )
    )

if show_signals and pivot_equal_high
    pivot_bar = bar_index[pivot_length]

    f_add_signal_label(
         signal_labels,
         label.new(
             pivot_bar,
             pivot_high,
             pivot_equal_high_text,
             style=f_label_style(true),
             color=pivot_equal_high_color,
             textcolor=color.white,
             size=f_label_size()
         )
    )

    if show_pivot_lines
        f_add_pivot_line(
             pivot_high_lines,
             line.new(
                 matching_pivot_high_bar,
                 matching_pivot_high_price,
                 pivot_bar,
                 pivot_high,
                 color=pivot_equal_high_color,
                 style=f_line_style(pivot_line_style_input),
                 width=2
             )
        )

if show_signals and pivot_equal_low
    pivot_bar = bar_index[pivot_length]

    f_add_signal_label(
         signal_labels,
         label.new(
             pivot_bar,
             pivot_low,
             pivot_equal_low_text,
             style=f_label_style(false),
             color=pivot_equal_low_color,
             textcolor=color.white,
             size=f_label_size()
         )
    )

    if show_pivot_lines
        f_add_pivot_line(
             pivot_low_lines,
             line.new(
                 matching_pivot_low_bar,
                 matching_pivot_low_price,
                 pivot_bar,
                 pivot_low,
                 color=pivot_equal_low_color,
                 style=f_line_style(pivot_line_style_input),
                 width=2
             )
        )

// ==========================================================
// ALERT CONDITIONS
// ==========================================================
any_equal_high = candle_equal_high or pivot_equal_high
any_equal_low = candle_equal_low or pivot_equal_low
any_equal_level = any_equal_high or any_equal_low

alertcondition(candle_equal_high, title="Candle Equal High", message="A valid candle equal high was detected on {{ticker}}.")
alertcondition(candle_equal_low, title="Candle Equal Low", message="A valid candle equal low was detected on {{ticker}}.")
alertcondition(pivot_equal_high, title="Pivot Equal High", message="A valid unswept pivot equal high was detected on {{ticker}}.")
alertcondition(pivot_equal_low, title="Pivot Equal Low", message="A valid unswept pivot equal low was detected on {{ticker}}.")
alertcondition(any_equal_high, title="Any Equal High", message="An equal high was detected on {{ticker}}.")
alertcondition(any_equal_low, title="Any Equal Low", message="An equal low was detected on {{ticker}}.")
alertcondition(any_equal_level, title="Any Equal High or Low", message="An equal high or equal low was detected on {{ticker}}.")

// ==========================================================
// OPTIONAL RUNTIME ALERTS
// ==========================================================
runtime_alert_frequency = alert_on_close ? alert.freq_once_per_bar_close : alert.freq_once_per_bar

if use_runtime_alerts and candle_equal_high
    alert("Candle equal high on " + syminfo.ticker + " | Chart TF: " + timeframe.period, runtime_alert_frequency)

if use_runtime_alerts and candle_equal_low
    alert("Candle equal low on " + syminfo.ticker + " | Chart TF: " + timeframe.period, runtime_alert_frequency)

if use_runtime_alerts and pivot_equal_high
    alert("Pivot equal high on " + syminfo.ticker + " | Chart TF: " + timeframe.period, runtime_alert_frequency)

if use_runtime_alerts and pivot_equal_low
    alert("Pivot equal low on " + syminfo.ticker + " | Chart TF: " + timeframe.period, runtime_alert_frequency)