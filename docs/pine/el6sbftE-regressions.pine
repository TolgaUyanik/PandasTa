//@version=5

// @description This library computes least square regression models for polynomials of any form for a given data set of x and y values.
library("regressions", overlay = true)


// —————————— Library Types {

export type regression
    float[] coeffs = na
    float[] degrees = na
	string  type_linear = "linear_regression"
	string  type_quadratic = "quadratic_regression"
	string  type_cubic = "cubic_regression"
	string  type_custom = "custom"
	float _squared_error
	float[] X = na

// }

// —————————— Library functions {
// @function 		Takes a list of X and y values and the degrees of the polynomial and returns a least square regression for the given polynomial on the dataset.
// @param X 		(float[])    X inputs for regression fit.
// @param y 		(float[]) 	 y outputs for regression fit.
// @param reg_type  (string)	 The type of regression. If passing value for degrees use reg.type_custom
// @param degrees 	(int[])      The degrees of the polynomial which will be fit to the data. ex: passing array.from(0, 3) would be a polynomial of form c1x^0 + c2x^3 where c2 and c1 will be coefficients of the best fitting polynomial.
// @returns			(regression) returns a regression with the best fitting coefficients for the selecected polynomial
export fit(float[] X, float[] y, string reg_type = "linear_regression", float[] degrees = na) =>
	regression reg = regression.new()
	reg.degrees := switch reg_type
		reg.type_linear =>  array.from(0., 1)
		reg.type_quadratic  => array.from(0., 1, 2)
		reg.type_cubic => array.from(0., 1, 2, 3)
		reg.type_custom => degrees
		=>
			runtime.error("reg_type no found")
			na
	// least square 
    A = matrix.new<float>(array.size(X), 0, 1)
    for i = 0 to reg.degrees.size()-1
        degree_coeficient_i = array.new_float(array.size(X))
        for j = 0 to X.size()-1
            degree_coeficient_i.set(j, math.pow(X.get(j), reg.degrees.get(i)))
        A.add_col(i, degree_coeficient_i)
    b_ = y
    At = A.transpose()
    At_A = matrix.mult(At, A)
    At_b_ = matrix.mult(At, b_) 
	x_ = matrix.mult(At_A.inv(), At_b_) // x*
    reg.coeffs := x_
	reg.X := X
	proj_b_ = matrix.mult(A, x_)
	abs = 0.
	// squared error
	for i = 0 to x_.size()-1 
		abs += math.pow(proj_b_.get(i) - b_.get(i), 2) // projection of b onto im(A) minus b gives residual
	abs := math.sqrt(abs) // finish abs of vectors
	reg._squared_error := math.pow(abs, 2) // squared error
	reg

// @function		Regress one x input.
// @param reg		(regression) The fitted regression which the y_pred will be calulated with. 
// @param x		    (float)      The input value cooresponding to the y_pred. 
// @returns			(float)		 The best fit y value for the given x input and regression.
export regress(regression reg, float x) =>
    float y = 0
    for i = 0 to array.size(reg.coeffs)-1
        y := y + reg.coeffs.get(i) * math.pow(x, reg.degrees.get(i))
    y

// @function		Predict a new set of X values with a fitted regression. -1 is one bar ahead of the realtime
// @param reg		(regression) 		The fitted regression which the y_pred will be calulated with. 
// @param x		    (float[])      		The input X values wich the regression will predict y values for.
// @returns			(float[])		 	The best fit y values for the given x input and regression.
export predict(regression reg, float[] X) =>
    float[] y_preds = array.new<float>()
    for i = 0 to array.size(X)-1
        y_preds.push(regress(reg, X.get(i)))
    y_preds

// @function			Takes a regression object and creates chart points which can be used for plotting visuals like lines and labels.	
// @param reg			(regression)    Regression which has been fitted to a data set.
// @param x				(float[])		x values which coorispond to passed y values
// @param y				(float[])		y values which coorispond to passed x values
// @param left_index	(int)      		The offset of the bar farthest to the realtime bar should be larger than left_index value.
// @param right_index	(int)      		The offset of the bar closest to the realtime bar should be less than right_index value.
// @param left_to_right	(bool)  		 Default true plots line with origin to the left
// @returns				(chart.point[])	 Returns an array of chart points			
export generate_points(regression reg = na, float[] x = na, float[] y= na, int left_index = na, int right_index = na,  bool absolute = false, bool left_to_right = true) =>
    points = array.new<chart.point>()
	if not na(reg) and na(left_index) 
		for i = 0 to reg.X.size()-1
        	y_i = regress(reg, reg.X.get(i))
			x_r = left_to_right ? reg.X.size() - (int(reg.X.get(i)) + 1) : int(reg.X.get(i))
			x_i = absolute ? int(reg.X.get(i)) : time(timeframe.period, x_r)
        	points.push(chart.point.from_time(x_i, y_i))
	else if not na(reg)	
		for i = left_index to right_index
			y_i = regress(reg, i)
			x_i = absolute ? int(i) : time(timeframe.period, int(i))
			points.push(chart.point.from_time(int(x_i), y_i))
	else 
		for i = 0 to x.size()-1
			x_i = absolute ? x.get(i) : time(timeframe.period, int(x.get(i)))
			points.push(chart.point.from_time(int(x_i), y.get(i)))
    points

// @function			Simple plotting function for regression	for more custom plotting use generate_points() to create points then create your own plotting function.
// @param reg			(regression) 	Regression which has been fitted to a data set.
// @param x				(float[])		x values which coorispond to passed y values
// @param y				(float[])		y values which coorispond to passed x values
// @param left_index	(int)      		The offset of the bar farthest to the realtime bar should be larger than left_index value.
// @param right_index	(int)      		The offset of the bar closest to the realtime bar should be less than right_index value.
// @param curved		(bool)  		If the polyline is curved or not.
// @param left_to_right	(bool)  		Default true plots line with origin to the left
// @param is_closed		(bool)  		If true the polyline will be closed.
// @param line_color	(color) 		The color of the line.
// @param line_width	(int) 			The width of the line.
// @returns				(polyline)      The polyline for the regression.
export plot_reg(regression reg = na, float[] x = na, float[] y= na, int left_index = na, int right_index = na, bool absolute = false, bool left_to_right = true,  bool curved = true, bool is_closed = false, string line_style=line.style_solid, color line_color = color.white, int line_width = 2) =>
	polyline reg_line = na
	if not na(reg) or not (na(x) or na(y))
		points = generate_points(reg=reg, x = x, y = y, left_index=left_index, right_index=right_index, absolute=absolute, left_to_right = left_to_right)

		reg_line := polyline.new(points, curved, is_closed, xloc.bar_time, line_color,  line_style = line_style, line_width = line_width)
	reg_line

// @function			Ploting function for linear regression more effecient than the plot_reg function
// @param reg			(regression) 	Linear Regression which has been fitted to a data set.
// @param line_color	(color) 		The color of the line.
// @param line_width	(int) 			The width of the line.
// @returns				(polyline)      The polyline for the regression.
export plot_linear_reg(regression reg = na,  string line_style=line.style_solid, color line_color = color.white, int line_width = 2, bool left_to_right = true) =>
	line reg_line = na
	if not na(reg) 
		if reg.coeffs.size() > 2
			runtime.error("plot_linear_reg only accepts linear regressions.")
		m = reg.coeffs.get(1)
    	b = reg.coeffs.get(0)
		leftX = left_to_right ? int(reg.X.last()) : int(reg.X.first())
		rightX = left_to_right ? int(reg.X.first()) : int(reg.X.last())
		leftPoint = chart.point.from_time( time(timeframe.period, leftX), regress(reg, reg.X.first()))
		rightPoint = chart.point.from_time( time(timeframe.period, rightX), regress(reg, reg.X.last()) )
		reg_line := line.new(leftPoint, rightPoint, color= line_color, xloc = xloc.bar_time, style = line_style, width =  line_width)
	reg_line

// Utility Functions

// @function			Convert a series to a list. Creates a list of all the cooresponding source values 
//						from left_index to right_index. This should be called at the highest scope for consistency.
// @param src			(float[]) 	The source the list will be comprised of.
// @param left_index	(float[])   The left most bar (farthest back historical bar) which the cooresponding source value will be taken for.
// @param right_index	(float[])   The right most bar closest to the realtime bar which the cooresponding source value will be taken for.
// @returns				(float[])  	An array of size left_index-right_index
export series_to_list(series float src, int left_index, int right_index) =>
    list = array.new<float>()
    for i = left_index to right_index
        list.push(src[i])
    list

// @function			Creates an from the start value to the stop value. 
// @param start			(float[]) 	The true y values. 
// @param stop		    (float[])   The predicted y values.
// @param step		    (int)   	Positive integer. The spacing between the values. ex: start=1, stop=6, step=2: [1, 3, 5]
// @returns				(float[])  	An array of size stop-start
export range_list(int start, int stop, int step = 1) => 
    list = array.new<float>()
    for i = 0 to stop - start
		if i % step == 0
			list.push(start+i)
    list

// }

//———————————————————— Example Code {
// Here we train our regression from the 200th bar to the 20th bar.
// Then we use that regression to predict the price movement from 20th bar to 50 bars in the future.

const string tt1 = ("Custom polynomial which will be fitted to the pivots. Ex: input of 0, 1, 3 will be a polynomial of" +
					 " form cx^0 + bx^1 + ax^3  , Ex 2: input of 0, 3, 5 will be a polynomial of form cx^0 + bx^3 + ax^5 " +
					 ". Where a, b and c are the calculated best fitted coefficients.")

poly_reg = input.string("Custom Polynomial", "Regression Type", 
 options = ["Linear Regression", "Quadratic Regression","Cubic Regression", "Custom Polynomial"])
custom_poly = input.string("0, 1, 3", "Custom Polynomial", tooltip = tt1)


reg = regression.new()

string_to_int_arr(string str, string sep = ",") =>
	strs = str.split(str, sep)
	numbers = array.new<int>()
    for i=0 to strs.size()-1
        numbers.push(int(str.tonumber(str.trim(strs.get(i)))))
	numbers

string reg_type = switch poly_reg
    "Linear Regression" => reg.type_linear
    "Quadratic Regression" => reg.type_quadratic
    "Cubic Regression" => reg.type_cubic
    "Custom Polynomial" => 
        reg.degrees := string_to_int_arr(custom_poly)
        reg.type_custom


// Train 
left_index =  200  
right_index = 20

X_train = range_list(left_index, right_index) // create an array of x values from 100-200
y_train = series_to_list(hl2, left_index, right_index) // create a cooresponding array of hl2 values from bars 200-100
fitted_custom_poly_reg = fit(X_train, y_train, reg_type, reg.degrees) // fit the chosen regression to those x and y values
fitted_linear_reg = fit(X_train, y_train, reg.type_linear)

// Predict
predict_from = 20
predict_to = -50

X = range_list(predict_from, predict_to) // create an array of x values from 0-100
y_pred = predict(fitted_custom_poly_reg, X) // predict the hl2 using the fitted regression
y_true = series_to_list(hl2, predict_from, predict_to) // create an array of the true hl2 values to use later to measure the predictors performance
if barstate.islastconfirmedhistory
	fitted_custom_regression = plot_reg(reg = fitted_custom_poly_reg, line_color = color.white, line_width=3, left_to_right = false) // we set left_to_right as false here because the training data uses bar_index offsets (200-20) rather than a typical accending list
	fitted_linear_regression = plot_reg(reg = fitted_linear_reg, left_index=left_index, right_index = predict_to,  line_color = color.purple) // we don't need to set left_to_right
    prediction_regression = plot_reg(x = X, y = y_pred, line_color = color.blue) // plot prediction data 

	// plot the fitted regression error and the mean squared error
	metrics = table.new(position.top_right, 2, 2, frame_color = color.white)
	metrics.cell(0, 0, "Linear Regression Error", text_color = color.purple)
	metrics.cell(0, 1, str.tostring(fitted_linear_reg._squared_error, "#.##"), text_color = color.white)
	metrics.cell(1, 0, "Custom Polynomial Error", text_color = color.white)
	metrics.cell(1, 1, str.tostring(fitted_custom_poly_reg._squared_error, "#.##"), text_color = color.white)
// }


