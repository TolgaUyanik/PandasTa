//@version=6
indicator("Equal Highs & Equal Lows", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================= INPUTS =============================
grp1 = "Pivot Detection"
leftBars  = input.int(5, "Left Bars", minval=1, group=grp1)
rightBars = input.int(5, "Right Bars", minval=1, group=grp1)

grp2 = "Equality Tolerance"
tolMode    = input.string("ATR", "Tolerance Mode", options=["ATR", "Percent", "Ticks"], group=grp2)
tolAtrLen  = input.int(14, "ATR Length (ATR mode)", group=grp2)
tolAtrMult = input.float(0.10, "ATR Multiplier (ATR mode)", minval=0.01, step=0.01, group=grp2)
tolPercent = input.float(0.05, "Percent Tolerance % (Percent mode)", minval=0.001, step=0.01, group=grp2)
tolTicks   = input.int(5, "Tick Tolerance (Ticks mode)", minval=1, group=grp2)

grp3 = "Levels"
lookbackPivots = input.int(15, "Max Prior Pivots to Compare Against", minval=2, maxval=50, group=grp3)
extendLines    = input.string("Right", "Extend Lines", options=["None", "Right", "Both"], group=grp3)
removeOnBreak  = input.bool(true, "Delete Level Once Price Closes Through It", group=grp3)
showLabels     = input.bool(true, "Show EQH / EQL Labels", group=grp3)

grp4 = "Style"
eqhColor      = input.color(color.new(color.red, 0), "Equal Highs Color", group=grp4)
eqlColor      = input.color(color.new(color.lime, 0), "Equal Lows Color", group=grp4)
lineWidth     = input.int(1, "Line Width", minval=1, maxval=4, group=grp4)
lineStyleIn   = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group=grp4)

lineStyle   = lineStyleIn == "Solid" ? line.style_solid : lineStyleIn == "Dashed" ? line.style_dashed : line.style_dotted
extendStyle = extendLines == "None" ? extend.none : extendLines == "Right" ? extend.right : extend.both

// ============================= TOLERANCE =============================
atrVal    = ta.atr(tolAtrLen)
tolerance = tolMode == "ATR" ? atrVal * tolAtrMult : tolMode == "Percent" ? close * tolPercent / 100 : tolTicks * syminfo.mintick

// ============================= PIVOTS =============================
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

// ============================= STORAGE =============================
var array<float> phPrices = array.new_float()
var array<int>   phBars   = array.new_int()
var array<float> plPrices = array.new_float()
var array<int>   plBars   = array.new_int()

var array<line>  eqhLines  = array.new_line()
var array<label> eqhLabels = array.new_label()
var array<float> eqhLevel  = array.new_float()

var array<line>  eqlLines  = array.new_line()
var array<label> eqlLabels = array.new_label()
var array<float> eqlLevel  = array.new_float()

trimArray(arrF, arrI, maxLen) =>
    while array.size(arrF) > maxLen
        array.shift(arrF)
        array.shift(arrI)

// ============================= NEW PIVOT HIGH =============================
if not na(ph)
    pBarIdx = bar_index - rightBars
    pPrice  = ph
    if array.size(phPrices) > 0
        for i = array.size(phPrices) - 1 to 0
            refPrice = array.get(phPrices, i)
            refBar   = array.get(phBars, i)
            if math.abs(pPrice - refPrice) <= tolerance
                lvl = math.max(pPrice, refPrice)
                ln  = line.new(x1=refBar, y1=lvl, x2=pBarIdx, y2=lvl, xloc=xloc.bar_index, extend=extendStyle, color=eqhColor, style=lineStyle, width=lineWidth)
                array.push(eqhLines, ln)
                array.push(eqhLevel, lvl)
                if showLabels
                    lbl = label.new(x=pBarIdx, y=lvl, text="EQH", xloc=xloc.bar_index, yloc=yloc.price, color=color(na), style=label.style_label_down, textcolor=eqhColor, size=size.small)
                    array.push(eqhLabels, lbl)
                break
    array.push(phPrices, pPrice)
    array.push(phBars, pBarIdx)
    trimArray(phPrices, phBars, lookbackPivots)

// ============================= NEW PIVOT LOW =============================
if not na(pl)
    pBarIdxL = bar_index - rightBars
    pPriceL  = pl
    if array.size(plPrices) > 0
        for i = array.size(plPrices) - 1 to 0
            refPriceL = array.get(plPrices, i)
            refBarL   = array.get(plBars, i)
            if math.abs(pPriceL - refPriceL) <= tolerance
                lvlL = math.min(pPriceL, refPriceL)
                lnL  = line.new(x1=refBarL, y1=lvlL, x2=pBarIdxL, y2=lvlL, xloc=xloc.bar_index, extend=extendStyle, color=eqlColor, style=lineStyle, width=lineWidth)
                array.push(eqlLines, lnL)
                array.push(eqlLevel, lvlL)
                if showLabels
                    lblL = label.new(x=pBarIdxL, y=lvlL, text="EQL", xloc=xloc.bar_index, yloc=yloc.price, color=color(na), style=label.style_label_up, textcolor=eqlColor, size=size.small)
                    array.push(eqlLabels, lblL)
                break
    array.push(plPrices, pPriceL)
    array.push(plBars, pBarIdxL)
    trimArray(plPrices, plBars, lookbackPivots)

// ============================= REMOVE BROKEN LEVELS =============================
if removeOnBreak
    if array.size(eqhLines) > 0
        for i = array.size(eqhLines) - 1 to 0
            lvl = array.get(eqhLevel, i)
            if close > lvl
                line.delete(array.get(eqhLines, i))
                array.remove(eqhLines, i)
                array.remove(eqhLevel, i)
                if showLabels and array.size(eqhLabels) > i
                    label.delete(array.get(eqhLabels, i))
                    array.remove(eqhLabels, i)
    if array.size(eqlLines) > 0
        for i = array.size(eqlLines) - 1 to 0
            lvlL = array.get(eqlLevel, i)
            if close < lvlL
                line.delete(array.get(eqlLines, i))
                array.remove(eqlLines, i)
                array.remove(eqlLevel, i)
                if showLabels and array.size(eqlLabels) > i
                    label.delete(array.get(eqlLabels, i))
                    array.remove(eqlLabels, i)

// ============================= ALERTS =============================
alertcondition(array.size(eqhLines) > array.size(eqhLines)[1], title="New Equal High", message="New Equal High level formed")
alertcondition(array.size(eqlLines) > array.size(eqlLines)[1], title="New Equal Low", message="New Equal Low level formed")