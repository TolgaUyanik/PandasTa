//@version=6
library("SITFX_FuturesSpec_v17", overlay=false)
// ==============================================================================
// SITFX_FuturesSpec_v17  ·  © 2025 Solvere Trading Solutions, LLC
// Futures contract specs (tick/point/margins) + region sessions + helper getters
// All logic uses if/else (no multiline ternaries) to avoid continuation errors.
// ==============================================================================

// ──────────────────────────────────────────────────────────────────────────────
// Type & constructor
// ─────────────────────────────────────────────────────────────────────────────-
export type FuturesSpec
    string symbol
    string name
    string exchange
    string contractSize
    string months
    float  tickSize
    float  tickValue
    float  pointValue
    float  dayMargin
    float  overnightMargin

export new(string s, string n, string e, string c, string m, float ts, float tv, float pv, float dm, float om) =>
    FuturesSpec.new(s, n, e, c, m, ts, tv, pv, dm, om)

// ──────────────────────────────────────────────────────────────────────────────
// Contract specs lookup
// Example usage: spec = fs.get(syminfo.root)
// ─────────────────────────────────────────────────────────────────────────────-
export get(string symbol) =>
    // Equity Index Micros
    if      symbol=="MES"
        new("MES","Micro E-mini S&P 500","CME","$5 x Index","HMUZ",0.25,1.25,5,84,1674)
    else if symbol=="MNQ"
        new("MNQ","Micro E-mini NASDAQ 100","CME","$2 x Index","HMUZ",0.25,0.50,2,127,2543)
    else if symbol=="MYM"
        new("MYM","Micro E-mini Dow 30","CBOT","$0.5 x Index","HMUZ",1.0,0.50,0.5,75,1174)
    else if symbol=="M2K"
        new("M2K","Micro E-mini Russell 2000","CME","$5 x Index","HMUZ",0.1,0.50,5,75,886)

    // Equity Index Minis
    else if symbol=="ES"
        new("ES","E-mini S&P 500","CME","$50 x Index","HMUZ",0.25,12.50,50,837,16741)
    else if symbol=="NQ"
        new("NQ","E-mini Nasdaq 100","CME","$20 x Index","HMUZ",0.25,5,20,1272,25436)
    else if symbol=="YM"
        new("YM","E-mini Dow 30","CBOT","$5 x Index","HMUZ",1.0,5,5,750,11738)
    else if symbol=="RTY"
        new("RTY","E-mini Russell 2000","CME","$50 x Index","HMUZ",0.1,5,50,750,8854)
    else if symbol=="EMD"
        new("EMD","E-mini MidCap 400","CME","$100 x Index","HMUZ",0.1,10,100,20730,20730)

    // Volatility & Eurex
    else if symbol=="VX"
        new("VX","Volatility Index","CFE","$1000 x Index","ALL",0.05,50,1000,7249,7249)
    else if symbol=="FDXM"
        new("FDXM","Mini-DAX","Eurex","€5 x Index","HMUZ",1,5,5,1550,6199)

    // FX & Cryptos
    else if symbol=="MBT"
        new("MBT","Micro Bitcoin","CME",".10 Bitcoin","ALL",5,0.50,0.10,2574,2574)
    else if symbol=="DX"
        new("DX","Dollar Index","ICE","1000 x Index","HMUZ",0.005,5,1000,1857,1857)
    else if symbol=="DA6"
        new("DA6","Australian Dollar","CME","100,000","HMUZ",0.01,10,1000,1485,1485)
    else if symbol=="BP6"
        new("BP6","British Pound","CME","62,500","HMUZ",0.01,6.25,625,962,1925)
    else if symbol=="CA6"
        new("CA6","Canadian Dollar","CME","100,000","HMUZ",0.01,10,1000,1100,1100)
    else if symbol=="EU6"
        new("EU6","EuroFX","CME","125,000","HMUZ",0.01,12.5,1250,1265,2530)
    else if symbol=="SF6"
        new("SF6","Swiss Franc","CME","125,000","HMUZ",0.01,12.5,1250,4070,4070)
    else if symbol=="JY6"
        new("JY6","Japanese Yen","CME","12,500,000","HMUZ",0.005,6.25,1250,1595,3190)
    else if symbol=="M6E"
        new("M6E","E-Micro EuroFX","CME","12,500","HMUZ",0.01,1.25,125,253,253)

    // Rates & Bonds
    else if symbol=="SR1"
        new("SR1","One-Month SOFR","CME","$4167 x Index","ALL",0.0025,10.4175,4167,468,468)
    else if symbol=="USA"
        new("USA","30 Year Bond","CBOT","$100,000","HMUZ",0.03125,31.25,1000,2035,4070)
    else if symbol=="TYA"
        new("TYA","10 Year T-Note","CBOT","$100,000","HMUZ",0.015625,15.625,1000,1031,2062)
    else if symbol=="FVA"
        new("FVA","5 Year T-Note","CBOT","$100,000","HMUZ",0.015625,15.625,1000,688,1375)
    else if symbol=="TUA"
        new("TUA","2 Year T-Note","CBOT","$200,000","HMUZ",0.0078125,15.625,2000,660,1320)
    else if symbol=="ZQE"
        new("ZQE","30 Day Fed Funds","CBOT","$5,000,000","ALL",0.0025,10.4175,4167,220,220)

    // Metals & Energies
    else if symbol=="SIE"
        new("SIE","Silver","COMEX","5000 oz","HKNUZ",0.005,25,50,12650,12650)
    else if symbol=="MQI"
        new("MQI","E-mini Silver","COMEX","2500 oz","HKNUZ",0.0125,31.25,25,6325,6325)
    else if symbol=="GCE"
        new("GCE","Gold","COMEX","100 oz","GJMQVZ",0.1,10,100,6325,12650)
    else if symbol=="MQO"
        new("MQO","E-mini Gold","COMEX","50 oz","GJMQVZ",0.1,3.32,33.2,6325,6325)
    else if symbol=="CPE"
        new("CPE","Copper","COMEX","2500 lbs","ALL",0.0005,12.5,250,6600,6600)
    else if symbol=="PLE"
        new("PLE","Platinum","NYMEX","50 oz","FJNVZ",0.1,5,50,3030,6060)
    else if symbol=="CLE"
        new("CLE","Crude Oil","NYMEX","1000 Barrels","ALL",0.01,10,1000,3206,6412)
    else if symbol=="NGE"
        new("NGE","Natural Gas","NYMEX","10,000 MBtu","ALL",0.001,10,100,3839,3839)
    else if symbol=="HOE"
        new("HOE","Heating Oil","NYMEX","42,000 Gals","ALL",0.0001,4.2,420,7953,7953)
    else if symbol=="NQM"
        new("NQM","E-mini Crude Oil","NYMEX","500 Barrels","ALL",0.025,12.5,500,1609,3218)
    else if symbol=="RBE"
        new("RBE","RBOB Gasoline","NYMEX","42,000 Gals","ALL",0.0001,4.2,420,7084,7084)

    // Default Fallback
    else
        na

// ──────────────────────────────────────────────────────────────────────────────
// Helper getters (avoid unpacking the record in calling scripts)
// ─────────────────────────────────────────────────────────────────────────────-
export tickSize(string symbol) => get(symbol).tickSize
export tickValue(string symbol) => get(symbol).tickValue
export pointValue(string symbol) => get(symbol).pointValue
export dayMargin(string symbol) => get(symbol).dayMargin
export overnightMargin(string symbol) => get(symbol).overnightMargin
export months(string symbol) => get(symbol).months
export exchange(string symbol) => get(symbol).exchange
export contractSize(string symbol) => get(symbol).contractSize
export name(string symbol) => get(symbol).name

// ──────────────────────────────────────────────────────────────────────────────
// Session helpers (alias normalization + per-region RTH + optional Globex)
// All functions use if/else only.
// Example:
// useGlobex = input.bool(false, "Use Globex Session")
// sessUS   = fs.session("US", syminfo.root, useGlobex)
// inUS     = time(timeframe.period, sessUS) != 0
// ─────────────────────────────────────────────────────────────────────────────-
normalize_root(string r) =>
    if r=="GC"
        "GCE"
    else if r=="SI"
        "SIE"
    else if r=="PL"
        "PLE"
    else if r=="HG"
        "CPE"
    else if r=="CL"
        "CLE"
    else if r=="NG"
        "NGE"
    else if r=="HO"
        "HOE"
    else if r=="RB"
        "RBE"
    else
        r

_sessUS(string r) =>
    if r=="ES" or r=="MES" or r=="NQ" or r=="MNQ" or r=="YM" or r=="MYM" or r=="RTY" or r=="M2K" or r=="EMD"
        "0930-1600"
    else if r=="VX"
        "0930-1615"
    else if r=="GCE" or r=="SIE" or r=="PLE" or r=="MQI" or r=="MQO" or r=="CPE" or r=="HG"
        "0830-1330"
    else if r=="CLE" or r=="NGE" or r=="HOE" or r=="RBE" or r=="NQM"
        "0900-1430"
    else if r=="USA" or r=="TYA" or r=="FVA" or r=="TUA" or r=="ZQE" or r=="SR1"
        "0820-1700"
    else if r=="DX"
        "0800-1700"
    else if r=="ZC" or r=="ZW" or r=="ZS" or r=="ZM" or r=="ZL" or r=="ZO" or r=="ZR" or r=="XC" or r=="XW" or r=="XK"
        "0930-1420"
    else if r=="FDAX" or r=="FDXM" or r=="FESX"
        "0300-1130"
    else if r=="CC" or r=="CT" or r=="KC" or r=="SB" or r=="OJ"
        "0900-1330"
    else if r=="BTC" or r=="MBT" or r=="ETH"
        "1800-1700"
    else
        "0930-1600"

_sessEU(string r) =>
    if r=="ES" or r=="MES" or r=="NQ" or r=="MNQ" or r=="YM" or r=="MYM" or r=="RTY" or r=="M2K" or r=="EMD"
        "0200-1000"
    else if r=="VX"
        "0200-1000"
    else if r=="GCE" or r=="SIE" or r=="PLE" or r=="MQI" or r=="MQO" or r=="CPE" or r=="HG"
        "0200-0700"
    else if r=="CLE" or r=="NGE" or r=="HOE" or r=="RBE" or r=="NQM"
        "0200-0830"
    else if r=="USA" or r=="TYA" or r=="FVA" or r=="TUA" or r=="ZQE" or r=="SR1"
        "0200-1000"
    else if r=="DX"
        "0200-1000"
    else if r=="ZC" or r=="ZW" or r=="ZS" or r=="ZM" or r=="ZL" or r=="ZO" or r=="ZR" or r=="XC" or r=="XW" or r=="XK"
        "0200-0800"
    else if r=="FDAX" or r=="FDXM" or r=="FESX"
        "0200-1030"
    else if r=="CC" or r=="CT" or r=="KC" or r=="SB" or r=="OJ"
        "0300-0800"
    else if r=="BTC" or r=="MBT" or r=="ETH"
        "0000-0700"
    else
        "0200-1000"

_sessAS(string r) =>
    if r=="ES" or r=="MES" or r=="NQ" or r=="MNQ" or r=="YM" or r=="MYM" or r=="RTY" or r=="M2K" or r=="EMD"
        "1900-0300"
    else if r=="VX"
        "1900-0300"
    else if r=="GCE" or r=="SIE" or r=="PLE" or r=="MQI" or r=="MQO" or r=="CPE" or r=="HG"
        "1800-2300"
    else if r=="CLE" or r=="NGE" or r=="HOE" or r=="RBE" or r=="NQM"
        "1800-2230"
    else if r=="USA" or r=="TYA" or r=="FVA" or r=="TUA" or r=="ZQE" or r=="SR1"
        "1800-0100"
    else if r=="DX"
        "1900-0300"
    else if r=="ZC" or r=="ZW" or r=="ZS" or r=="ZM" or r=="ZL" or r=="ZO" or r=="ZR" or r=="XC" or r=="XW" or r=="XK"
        "1900-0100"
    else if r=="FDAX" or r=="FDXM" or r=="FESX"
        "1800-2300"
    else if r=="CC" or r=="CT" or r=="KC" or r=="SB" or r=="OJ"
        "1900-2300"
    else if r=="BTC" or r=="MBT" or r=="ETH"
        "1800-1700"
    else
        "1900-0300"

_isGlobexable(string r) =>
    if r=="GCE" or r=="SIE" or r=="PLE" or r=="CPE" or r=="CLE" or r=="NGE" or r=="HOE" or r=="RBE"
        true
    else if r=="DX" or r=="EU6" or r=="BP6" or r=="DA6" or r=="CA6" or r=="SF6" or r=="JY6" or r=="M6E"
        true
    else if r=="BTC" or r=="MBT" or r=="ETH"
        true
    else
        false

export session(string region, string symbol, bool useGlobex) =>
    string r = normalize_root(symbol)
    if useGlobex and _isGlobexable(r)
        "1800-1700"
    else if region=="US"
        _sessUS(r)
    else if region=="EU"
        _sessEU(r)
    else
        _sessAS(r)