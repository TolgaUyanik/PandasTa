//@version=6
indicator("Clarix Smart Flip", overlay=true)

flipBuffer = input.float(0.001, title="Flip Break Percentage", minval=0.0001, step=0.0001)

prevOpen  = request.security(syminfo.tickerid, "D", open[1])
prevClose = request.security(syminfo.tickerid, "D", close[1])
prevBull  = prevClose > prevOpen
prevBear  = prevClose < prevOpen

todayOpen = request.security(syminfo.tickerid, "D", open)

firstHourClose = request.security(syminfo.tickerid, "120", close[0], lookahead=barmerge.lookahead_on)

firstHourEnded = ta.change(time("D")) == 0 and time >= (timestamp(year, month, dayofmonth, 1, 0))

firstHourBull = firstHourClose > todayOpen
firstHourBear = firstHourClose < todayOpen

sellFlip = prevBull and firstHourBull and close < todayOpen * (1 - flipBuffer)
buyFlip  = prevBear and firstHourBear and close > todayOpen * (1 + flipBuffer)

plot(todayOpen, title="Daily Open", color=color.gray, linewidth=1)

plotshape(sellFlip, title="Sell Flip", location=location.abovebar, color=color.red, style=shape.arrowdown, size=size.small)
plotshape(buyFlip, title="Buy Flip", location=location.belowbar, color=color.green, style=shape.arrowup, size=size.small)

alertcondition(sellFlip, title="🔴 Sell Flip Alert", message="🔴 Smart Daily Flip: Price flipped below today's open after bullish yesterday and strong first hour.")
alertcondition(buyFlip, title="🟢 Buy Flip Alert", message="🟢 Smart Daily Flip: Price flipped above today's open after bearish yesterday and weak first hour.")
