//@version=6

// @description A collection of essential trading utilities and mathematical functions used for technical analysis,
// including DEMA, Fisher Transform, directional movement, and ADX calculations.
library("TraderMath", overlay = false)


// @function                Calculates the value of the Double Exponential Moving Average (DEMA). 
// @param source            (series int/float) Series of values to process.
// @param length            (simple int) Length for the smoothing parameter calculation.
// @returns                 (float) The double exponentially weighted moving average of the `source`.
export dema(series float source, simple int length) =>
    float ema1   = ta.ema(source,  length)
    float ema2   = ta.ema(ema1, length)
    float result = 2 * ema1 - ema2

// @function                Constrains a value to the range [-0.999, 0.999].
// @param val               (float) Value to constrain.
// @returns                 (float) Value limited to the range [-0.999, 0.999].
export roundVal(float val) =>
    val > 0.99 ? 0.999 : val < -0.99 ? -0.999 : val

// @function                Computes the Fisher Transform oscillator, enhancing turning point sensitivity.
// @param length            (int) Lookback length used to normalize price within the high-low range.
// @returns                 (float) Fisher Transform value.
export fisherTransform(int length = 7) =>
    var float value = na
    var float fish = na
    highest = ta.highest(hl2, length)
    lowest = ta.lowest(hl2, length)
    normalized = (hl2 - lowest) / (highest - lowest) - 0.5
    value := roundVal(0.66 * normalized) + 0.67 * nz(value[1])
    fish := 0.5 * math.log((1 + value) / (1 - value)) + 0.5 * nz(fish[1])
    fish

// @function                Calculates the Plus and Minus Directional Movement components (DI+ and DI−).
// @param len               (int) Lookback length for directional movement.
// @returns                 (float[2]) Array containing [plusDI, minusDI].
export dirmov(int len) =>
	up = ta.change(high)
	down = -ta.change(low)
	plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
	minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
	truerange = ta.rma(ta.tr, len)
	plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
	minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
	[plus, minus]

// @function                Computes the Average Directional Index (ADX) based on DI+ and DI−.
// @param dilen             (int) Lookback length for directional movement calculation.
// @param adxlen            (int) Smoothing length for ADX computation.
// @returns                 (float) Average Directional Index value (0–100).
export adx(int dilen = 14, simple int adxlen = 14) =>
	[plus, minus] = dirmov(dilen)
	sum = plus + minus
	adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)


// @function                Detects liquidity sweeps and Market Structure Shifts (MSS).
// @param length            (int) Lookback window used to determine prior swing extremes.
//                          The function compares current highs/lows to the highest/lowest
//                          values within this lookback (excluding the current bar) to identify
//                          liquidity grabs.
// @returns                 (bool mssUp, bool mssDown)
//                          mssUp   → True when a downside liquidity sweep occurs and price
//                                     closes higher than the previous bar, indicating potential
//                                     bullish structure shift.
//                          mssDown → True when an upside liquidity sweep occurs and price
//                                     closes lower than the previous bar, indicating potential
//                                     bearish structure shift.
export getLiquiditySignals(int length = 20) =>
    // Liquidity grabs (sweeps)
    bool sweepHigh = high > ta.highest(high[1], length) and close < high
    bool sweepLow  = low < ta.lowest(low[1], length) and close > low

    // MSS (market structure shift)
    bool mssUp   = sweepLow  and close > close[1]
    bool mssDown = sweepHigh and close < close[1]

    [mssUp, mssDown]

// @function                Removes unnecessary whitespace from a JSON string to produce a compact,
//                          single-line payload suitable for webhook transmission.
// @param json              (string) Raw JSON text, potentially containing spaces, indentation,
//                          and newline characters.
// @returns                 (string) Minified JSON string with all spaces and line breaks removed.
export minifyJson(string json) =>
    str.replace_all(str.replace_all(json, " ", ""), "\n", "")