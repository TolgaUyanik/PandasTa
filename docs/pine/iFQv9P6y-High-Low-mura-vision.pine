//@version=6
indicator("High/Low mura vision", overlay=true)

// === Inputs ===
chk_yh  = input.bool(true,  "Show Yesterday's High")
chk_yl  = input.bool(true,  "Show Yesterday's Low")
chk_lwh = input.bool(true,  "Show Last Week's High")
chk_lwl = input.bool(true,  "Show Last Week's Low")
chk_lmh = input.bool(true,  "Show Last Month's High")
chk_lml = input.bool(true,  "Show Last Month's Low")

highLineColor    = input.color(#f23645, "High Line Color")
highLineStyleOpt = input.string("Solid",  "High Line Style", options=["Solid","Dotted","Dashed"])
lowLineColor     = input.color(#278783, "Low Line Color")
lowLineStyleOpt  = input.string("Solid",  "Low Line Style",  options=["Solid","Dotted","Dashed"])

show_lbl        = input.bool(true,  "Show Labels?")
lbl_sz_opt      = input.string("Normal", "Label Size", options=["Small","Normal","Large"])
lbl_size        = lbl_sz_opt == "Small" ? size.small : lbl_sz_opt == "Large" ? size.large : size.normal
lbl_text_color  = input.color(color.white, "Label Text Color")
lbl_bg_color    = input.color(color.new(color.black, 0), "Label Background Color")

show_value_in_label = input.bool(true,  "Show Value Inside Label")
append_currency     = input.bool(false, "Append Currency Code (e.g., USD)")

getStyle(opt) =>
    opt == "Dotted" ? line.style_dotted : opt == "Dashed" ? line.style_dashed :
                      line.style_solid

highLineStyle = getStyle(highLineStyleOpt)
lowLineStyle  = getStyle(lowLineStyleOpt)

// === Previous High/Low ===
tkr = syminfo.tickerid
yH  = request.security(tkr, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
yL  = request.security(tkr, "D", low [1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
wH  = request.security(tkr, "W", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
wL  = request.security(tkr, "W", low [1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
mH  = request.security(tkr, "M", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
mL  = request.security(tkr, "M", low [1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// === Bar counters ===
var int dayBars       = 0
var int prevDayBars   = 0
var int weekBars      = 0
var int prevWeekBars  = 0
var int monthBars     = 0
var int prevMonthBars = 0

dayBars   := time("D")  != time("D")[1]  ? 1 : dayBars + 1
weekBars  := weekofyear != weekofyear[1] ? 1 : weekBars + 1
monthBars := month      != month[1]      ? 1 : monthBars + 1

// === Lines & labels storage (typed per variable) ===
var line yhLine = na
var line ylLine = na
var line whLine = na
var line wlLine = na
var line mhLine = na
var line mlLine = na

var label yhLbl = na
var label ylLbl = na
var label whLbl = na
var label wlLbl = na
var label mhLbl = na
var label mlLbl = na

// helper: bubble text
makeText(tag, val) =>
    show_value_in_label
     ? tag + "\n" + str.tostring(val, format.mintick) + (append_currency ? " " + syminfo.currency : "")
     : tag

// === 1) Yesterday ===
if time("D") != time("D")[1]
    prevDayBars := dayBars[1]
    if not na(yhLine)
        line.delete(yhLine)
        label.delete(yhLbl)
    if not na(ylLine)
        line.delete(ylLine)
        label.delete(ylLbl)
    e = bar_index - 1
    s = e - prevDayBars + 1

    if chk_yh
        yhLine := line.new(s, yH, e, yH, extend=extend.none, color=highLineColor, style=highLineStyle, width=2)
        if show_lbl
            yhLbl := label.new(s, yH, makeText("Y High", yH), xloc=xloc.bar_index, yloc=yloc.price,
                               style=label.style_label_down, textcolor=lbl_text_color, color=lbl_bg_color,
                               size=lbl_size, textalign=text.align_center)
    if chk_yl
        ylLine := line.new(s, yL, e, yL, extend=extend.none, color=lowLineColor, style=lowLineStyle, width=2)
        if show_lbl
            ylLbl := label.new(s, yL, makeText("Y Low", yL), xloc=xloc.bar_index, yloc=yloc.price,
                               style=label.style_label_up, textcolor=lbl_text_color, color=lbl_bg_color,
                               size=lbl_size, textalign=text.align_center)

// === 2) Last Week ===
if weekofyear != weekofyear[1]
    prevWeekBars := weekBars[1]
    if not na(whLine)
        line.delete(whLine)
        label.delete(whLbl)
    if not na(wlLine)
        line.delete(wlLine)
        label.delete(wlLbl)
    e = bar_index - 1
    s = e - prevWeekBars + 1

    if chk_lwh
        whLine := line.new(s, wH, e, wH, extend=extend.none, color=highLineColor, style=highLineStyle, width=2)
        if show_lbl
            whLbl := label.new(s, wH, makeText("W High", wH), xloc=xloc.bar_index, yloc=yloc.price,
                               style=label.style_label_down, textcolor=lbl_text_color, color=lbl_bg_color,
                               size=lbl_size, textalign=text.align_center)
    if chk_lwl
        wlLine := line.new(s, wL, e, wL, extend=extend.none, color=lowLineColor, style=lowLineStyle, width=2)
        if show_lbl
            wlLbl := label.new(s, wL, makeText("W Low", wL), xloc=xloc.bar_index, yloc=yloc.price,
                               style=label.style_label_up, textcolor=lbl_text_color, color=lbl_bg_color,
                               size=lbl_size, textalign=text.align_center)

// === 3) Last Month ===
if month != month[1]
    prevMonthBars := monthBars[1]
    if not na(mhLine)
        line.delete(mhLine)
        label.delete(mhLbl)
    if not na(mlLine)
        line.delete(mlLine)
        label.delete(mlLbl)
    e = bar_index - 1
    s = e - prevMonthBars + 1

    if chk_lmh
        mhLine := line.new(s, mH, e, mH, extend=extend.none, color=highLineColor, style=highLineStyle, width=2)
        if show_lbl
            mhLbl := label.new(s, mH, makeText("M High", mH), xloc=xloc.bar_index, yloc=yloc.price,
                               style=label.style_label_down, textcolor=lbl_text_color, color=lbl_bg_color,
                               size=lbl_size, textalign=text.align_center)
    if chk_lml
        mlLine := line.new(s, mL, e, mL, extend=extend.none, color=lowLineColor, style=lowLineStyle, width=2)
        if show_lbl
            mlLbl := label.new(s, mL, makeText("M Low", mL), xloc=xloc.bar_index, yloc=yloc.price,
                               style=label.style_label_up, textcolor=lbl_text_color, color=lbl_bg_color,
                               size=lbl_size, textalign=text.align_center)
