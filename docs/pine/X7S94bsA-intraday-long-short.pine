//@version=6
strategy(
     title = "Intraday Long Short ",
     overlay = true,
     initial_capital = 10000,
     currency = currency.RUB,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     pyramiding = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 1,
     backtest_fill_limits_assumption = 0,
     slippage = 2,
     margin_long = 0,
     margin_short = 0,
     calc_on_order_fills = false,
     calc_on_every_tick = false,
     process_orders_on_close = false,
     use_bar_magnifier = false
)

bool enableLong = input.bool(
     defval = true,
     title = "Включить лонг",
     group = "Лонг"
)

float longSize = input.float(
     defval = 1.0,
     title = "Размер позиции лонг",
     minval = 0.001,
     step = 1.0,
     group = "Лонг"
)

int longEntryHour = input.int(
     defval = 9,
     title = "Час открытия",
     minval = 0,
     maxval = 23,
     inline = "long_entry",
     group = "Лонг"
)

int longEntryMinute = input.int(
     defval = 0,
     title = "Минута",
     minval = 0,
     maxval = 59,
     inline = "long_entry",
     group = "Лонг"
)

int longExitHour = input.int(
     defval = 12,
     title = "Час закрытия",
     minval = 0,
     maxval = 23,
     inline = "long_exit",
     group = "Лонг"
)

int longExitMinute = input.int(
     defval = 0,
     title = "Минута",
     minval = 0,
     maxval = 59,
     inline = "long_exit",
     group = "Лонг"
)

bool enableShort = input.bool(
     defval = true,
     title = "Включить шорт",
     group = "Шорт"
)

float shortSize = input.float(
     defval = 1.0,
     title = "Размер позиции шорт",
     minval = 0.001,
     step = 1.0,
     group = "Шорт"
)

int shortEntryHour = input.int(
     defval = 13,
     title = "Час открытия",
     minval = 0,
     maxval = 23,
     inline = "short_entry",
     group = "Шорт"
)

int shortEntryMinute = input.int(
     defval = 0,
     title = "Минута",
     minval = 0,
     maxval = 59,
     inline = "short_entry",
     group = "Шорт"
)

int shortExitHour = input.int(
     defval = 16,
     title = "Час закрытия",
     minval = 0,
     maxval = 23,
     inline = "short_exit",
     group = "Шорт"
)

int shortExitMinute = input.int(
     defval = 0,
     title = "Минута",
     minval = 0,
     maxval = 59,
     inline = "short_exit",
     group = "Шорт"
)

if not timeframe.isintraday
    runtime.error("Стратегия предназначена для внутридневного графика.")

int longEntryValue = longEntryHour * 60 + longEntryMinute
int longExitValue = longExitHour * 60 + longExitMinute
int shortEntryValue = shortEntryHour * 60 + shortEntryMinute
int shortExitValue = shortExitHour * 60 + shortExitMinute

if longExitValue <= longEntryValue
    runtime.error("Закрытие лонга должно быть позже его открытия.")

if shortExitValue <= shortEntryValue
    runtime.error("Закрытие шорта должно быть позже его открытия.")

// Время открытия следующего доступного бара графика.
// Это работает и при разрыве между торговыми сессиями.
int nextBarOpenTime = time("", bars_back = -1)

nextBarIs(int targetHour, int targetMinute) =>
    not na(nextBarOpenTime) and
     hour(nextBarOpenTime) == targetHour and
     minute(nextBarOpenTime) == targetMinute

bool longEntrySignal = nextBarIs(
     longEntryHour,
     longEntryMinute
)

bool longExitSignal = nextBarIs(
     longExitHour,
     longExitMinute
)

bool shortEntrySignal = nextBarIs(
     shortEntryHour,
     shortEntryMinute
)

bool shortExitSignal = nextBarIs(
     shortExitHour,
     shortExitMinute
)

bool longEntryAllowed = enableLong and longEntrySignal
bool shortEntryAllowed = enableShort and shortEntrySignal

// Входы имеют приоритет над обычными закрытиями.
// strategy.entry автоматически выполняет переворот:
// закрывает противоположную позицию и открывает новую.

// Если оба входа случайно заданы на одно время,
// приоритет имеет шорт.
if shortEntryAllowed
    strategy.entry(
         id = "Short",
         direction = strategy.short,
         qty = shortSize,
         comment = "Открытие шорта"
    )
else if longEntryAllowed
    strategy.entry(
         id = "Long",
         direction = strategy.long,
         qty = longSize,
         comment = "Открытие лонга"
    )

// Обычное закрытие не отправляется,
// если на этом же открытии начинается противоположная позиция.
if longExitSignal and not shortEntryAllowed and strategy.position_size > 0
    strategy.close(
         id = "Long",
         comment = "Закрытие лонга"
    )

if shortExitSignal and not longEntryAllowed and strategy.position_size < 0
    strategy.close(
         id = "Short",
         comment = "Закрытие шорта"
    )
