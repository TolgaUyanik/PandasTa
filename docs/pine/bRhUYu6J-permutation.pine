//@version=6
//@description This library provides functions for generating permutations of user input arrays containing either strings or floats. It uses an iterative, stack-based approach to handle potentially large sets and avoid recursion depth limits. The library supports limiting the number of duplicate elements allowed in each permutation. Results are stored in a custom `Data` or `DataFloat` type that uses maps to segment large permutation sets into manageable chunks, addressing Pine Script's array size limitations.
library("permutation")

// @type PermutationState
// @description Represents the state of a permutation being generated.
// @field data      (array<string>) The current permutation being built.
// @field index     (int)           The current index being considered in the set.
// @field depth     (int)           The current depth of the permutation (number of elements).
// @field counts    (map<string, int>) Map to track the count of each element in the current permutation (for duplicates).
export type PermutationState
    array<string> data
    int           index
    int           depth
    map<string, int> counts

// @type PermutationStateFloat
// @description Represents the state of a permutation being generated (float version).
// @field data      (array<float>) The current permutation being built.
// @field index     (int)          The current index being considered in the set.
// @field depth     (int)          The current depth of the permutation (number of elements).
// @field counts    (map<float, int>) Map to track the count of each element in the current permutation (for duplicates).
export type PermutationStateFloat
    array<float>     data
    int              index
    int              depth
    map<float, int>  counts

// @type Data
// @description Represents a segment of the generated permutations (string version).
// @field data     (array<string>) Array to indicate which segments are present.
// @field segments (map<int, Data>) Map to store permutation segments. Each segment contains a subset of the generated permutations.
export type Data
    array<string>  data
    map<int, Data> segments

// @type DataFloat
// @description Represents a segment of the generated permutations (float version).
// @field data     (array<float>) Array to indicate which segments are present.
// @field segments (map<int, DataFloat>) Map to store permutation segments. Each segment contains a subset of the generated permutations.
export type DataFloat
    array<float>   data
    map<int, DataFloat> segments

// @function _generatePermutationsIterative 
// > **Internal function to generate permutations of a given size from a set of strings using an iterative stack-based approach.**
// @param set              (array<string>) The set of strings to generate permutations from.
// @param size             (int)           The size of the permutations to generate.
// @param maxDuplicates    (int)           The maximum number of times an element can be repeated in a permutation.
// @returns                (Data)          A `Data` object containing the generated permutations, segmented into manageable chunks.
_generatePermutationsIterative(array<string> set, int size, int maxDuplicates) =>
    Data                  output = Data.new(array.new<string>(), map.new<int, Data>())
    map<int, Data>        result = map.new<int, Data>()
    array<PermutationState> stack  = array.new<PermutationState>()
    int                   count  = 0

    // Initialize the stack with the initial state.
    stack.push(PermutationState.new(array.new<string>(), 0, 0, map.new<string, int>()))

    while array.size(stack) > 0
        // Check if the maximum number of permutations per segment is reached.
        if count > 9999
            output.data.push(str.tostring(output.data.size()))
            output.segments.put(output.data.size(), Data.new(array.new<string>(), result.copy()))
            result := map.new<int, Data>()
            count := 0

        // Get the current state from the top of the stack.
        PermutationState currentState = stack.pop()

        if currentState.depth == size
            // Permutation of the desired size is complete.
            result.put(count, Data.new(array.copy(currentState.data), map.new<int, Data>()))
            count += 1
        else
            // Iterate through the set starting from the current index.
            for i = currentState.index to array.size(set) - 1
                string currentStr = set.get(i)
                int    strCount   = currentState.counts.get(currentStr)

                // Check for duplicates.
                if (na(strCount) ? 0 : strCount) < maxDuplicates
                    // Create a new state with the string added.
                    array<string>    newData  = array.copy(currentState.data)
                    map<string, int> newCounts = currentState.counts.copy()

                    newData.push(currentStr)
                    newCounts.put(currentStr, (na(strCount) ? 0 : strCount) + 1)

                    // Push the new state onto the stack for the next iteration.
                    stack.push(PermutationState.new(newData, 0, currentState.depth + 1, newCounts))

    // Add any remaining permutations to the output.
    if result.size() > 0
        output.data.push(str.tostring(output.data.size()))
        output.segments.put(output.data.size(), Data.new(array.new<string>(), result.copy()))

    output

// @function _generatePermutationsIterativeFloat 
// > **Internal function to generate permutations of a given size from a set of floats using an iterative stack-based approach.**
// @param set              (array<float>) The set of floats to generate permutations from.
// @param size             (int)          The size of the permutations to generate.
// @param maxDuplicates    (int)          The maximum number of times an element can be repeated in a permutation.
// @returns                (DataFloat)    A `DataFloat` object containing the generated permutations, segmented into manageable chunks.
_generatePermutationsIterativeFloat(array<float> set, int size, int maxDuplicates) =>
    DataFloat                  output = DataFloat.new(array.new<float>(), map.new<int, DataFloat>())
    map<int, DataFloat>        result = map.new<int, DataFloat>()
    array<PermutationStateFloat> stack  = array.new<PermutationStateFloat>()
    int                        count  = 0

    // Initialize the stack with the initial state.
    stack.push(PermutationStateFloat.new(array.new<float>(), 0, 0, map.new<float, int>()))

    while array.size(stack) > 0
        // Check if the maximum number of permutations per segment is reached. Arrays have a 10,000 limit.
        if count > 9999
            output.data.push(output.data.size())
            output.segments.put(output.data.size(), DataFloat.new(array.new<float>(), result.copy()))
            result := map.new<int, DataFloat>()
            count := 0

        // Get the current state from the top of the stack.
        PermutationStateFloat currentState = stack.pop()

        if currentState.depth == size
            // Permutation of the desired size is complete.
            result.put(count, DataFloat.new(array.copy(currentState.data), map.new<int, DataFloat>()))
            count += 1
        else
            // Iterate through the set starting from the current index.
            for i = currentState.index to array.size(set) - 1
                float  currentNum = set.get(i)
                int    numCount   = currentState.counts.get(currentNum)

                // Check for duplicates.
                if nz(numCount, 0) < maxDuplicates
                    // Create a new state with the float added.
                    array<float>     newData  = currentState.data.copy()
                    map<float, int> newCounts = currentState.counts.copy()

                    newData.push(currentNum)
                    newCounts.put(currentNum, (na(numCount) ? 0 : numCount) + 1)

                    // Push the new state onto the stack for the next iteration.
                    stack.push(PermutationStateFloat.new(newData, 0, currentState.depth + 1, newCounts))

    // Add any remaining permutations to the output.
    if result.size() > 0
        output.data.push(output.data.size())
        output.segments.put(output.data.size(), DataFloat.new(array.new<float>(), result.copy()))

    output

// @function
// > **Generates permutations of a given size from a set of strings or floats.**
// @param set           (array<string> or array<float>) The set of strings or floats to generate permutations from.
// @param size          (int)           The size of the permutations to generate.
// @param maxDuplicates (int)           The maximum number of times an element can be repeated in a permutation.
// @returns             (Data or DataFloat) A `Data` object for strings or a `DataFloat` object for floats, containing the generated permutations.
//
//```
//
//  stringPermutations = generatePermutations(array.from("a", "b", "c"), 2, 1)
//  floatPermutations  = generatePermutations(array.from(1.0, 2.0, 3.0), 2, 1)
//
//```
export generatePermutations(array<string> set, int size, int maxDuplicates = 1) =>
    _generatePermutationsIterative(set, size, maxDuplicates)
export generatePermutations(array<float> set, int size, int maxDuplicates = 1) =>
    _generatePermutationsIterativeFloat(set, size, maxDuplicates)
