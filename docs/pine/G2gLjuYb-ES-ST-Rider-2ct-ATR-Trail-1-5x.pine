//@version=6
strategy("ES ST Rider 2ct ATR-Trail 1.5x", overlay=true,
     initial_capital=1000000,
     default_qty_type=strategy.fixed,
     default_qty_value=2,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=1.20,
     slippage=1,
     calc_on_every_tick=false)

in_entry = not na(time(timeframe.period, "0930-1430", "America/New_York"))
in_eod   = not na(time(timeframe.period, "1530-1600", "America/New_York"))

var float day_equity = na
var int   day_trades = 0
new_day = ta.change(time("D")) != 0
if new_day or na(day_equity)
    day_equity := strategy.equity
    day_trades := 0

daily_pnl = strategy.equity - day_equity
day_stop  = daily_pnl <= -700.0

[st_val, st_dir] = ta.supertrend(2, 7)
st_bull = st_dir < 0
st_bear = st_dir > 0
flip_long  = st_bull and not st_bull[1]
flip_short = st_bear and not st_bear[1]

h1_ema = request.security(syminfo.tickerid, "60", ta.ema(close, 20), lookahead=barmerge.lookahead_off)
htf_up = close > h1_ema
htf_dn = close < h1_ema

[di_p, di_m, adx] = ta.dmi(14, 14)
has_dir_long  = adx > 15 and di_p > di_m and st_bull
has_dir_short = adx > 15 and di_m > di_p and st_bear

atr14     = ta.atr(14)
hard_stop = 10.0
flat      = strategy.position_size == 0

can_enter = in_entry and flat and not day_stop and day_trades < 5

if can_enter and flip_long and htf_up and has_dir_long
    day_trades += 1
    strategy.entry("L", strategy.long)
    strategy.exit("L-exit", "L",
         stop         = close - hard_stop,
         trail_price  = close + hard_stop,
         trail_offset = atr14 * 1.5)

if can_enter and flip_short and htf_dn and has_dir_short
    day_trades += 1
    strategy.entry("S", strategy.short)
    strategy.exit("S-exit", "S",
         stop         = close + hard_stop,
         trail_price  = close - hard_stop,
         trail_offset = atr14 * 1.5)

if (in_eod or day_stop) and strategy.position_size != 0
    strategy.close_all(comment="EOD")