// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// BTC Trend-Momentum Strategy
// Aufbau: EMA200 (Trendfilter) + Chaikin Money Flow (Volumen) + Stochastic RSI (Oszillator/Trigger)
// + optionaler ATR-Volatilitätsfilter. Kein Stop-Loss/Take-Profit - Positionen werden
// ausschließlich durch das jeweilige Gegensignal geschlossen.
//@version=6
strategy("BTC Trend-Momentum Strategy v6", overlay = false,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     pyramiding = 0, initial_capital = 1000,
     commission_type = strategy.commission.percent, commission_value = 0.075,
     slippage = 0, margin_long = 0, margin_short = 0)

// ============================================================================
// BTC-ONLY GUARD
// ============================================================================
is_btc = str.contains(str.upper(syminfo.basecurrency), "BTC") or str.contains(str.upper(syminfo.ticker), "BTC")
if not is_btc and barstate.islast
    label.new(bar_index, 50, "⚠ Diese Strategie ist nur für BTC kalibriert", color = color.orange, style = label.style_label_down, textcolor = color.white)

// ============================================================================
// INPUTS
// ============================================================================
start_period = input.time(timestamp("01-01-2018"), "Start Date")

// --- Trendfilter ---
grp_trend  = "Trendfilter (EMA)"
emaLength  = input.int(200, "EMA Länge", group = grp_trend)

// --- Volumen: Chaikin Money Flow ---
grp_cmf     = "Volumen (CMF)"
cmfLength   = input.int(20, "CMF Länge", group = grp_cmf)
cmfThresh   = input.float(0.0, "CMF Schwelle (Long > x / Short < -x)", step = 0.01, group = grp_cmf)

// --- Oszillator: Stochastic RSI ---
grp_srsi     = "Oszillator (Stochastic RSI)"
rsiLength    = input.int(14, "RSI Länge", group = grp_srsi)
stochLength  = input.int(14, "Stochastic Länge", group = grp_srsi)
smoothK      = input.int(3, "%K Glättung", group = grp_srsi)
smoothD      = input.int(3, "%D Glättung", group = grp_srsi)
oversoldLvl  = input.int(20, "Oversold Level", group = grp_srsi)
overboughtLvl = input.int(80, "Overbought Level", group = grp_srsi)

// --- Volatilitätsfilter (optional) ---
grp_vol       = "Volatilitätsfilter (optional)"
useVolFilter  = input.bool(true, "Nur bei erhöhter Volatilität handeln", group = grp_vol)
atrLen        = input.int(14, "ATR Länge", group = grp_vol)
volFilterLen  = input.int(20, "ATR-Vergleichs-MA Länge", group = grp_vol)

// ============================================================================
// TRENDFILTER
// ============================================================================
emaTrend  = ta.ema(close, emaLength)
trend_up   = close > emaTrend
trend_down = close < emaTrend

// ============================================================================
// CHAIKIN MONEY FLOW (manuell, da nicht als ta.* eingebaut)
// ============================================================================
mfm = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) : 0.0
mfv = mfm * volume
cmf = math.sum(mfv, cmfLength) / math.sum(volume, cmfLength)

cmf_bull = cmf > cmfThresh
cmf_bear = cmf < -cmfThresh

// ============================================================================
// STOCHASTIC RSI
// ============================================================================
rsiVal = ta.rsi(close, rsiLength)
stoch  = ta.stoch(rsiVal, rsiVal, rsiVal, stochLength)
kLine  = ta.sma(stoch, smoothK)
dLine  = ta.sma(kLine, smoothD)

// Trigger: %K kreuzt von unten über Oversold-Level (Long) bzw. von oben unter Overbought-Level (Short)
stoch_long_trigger  = ta.crossover(kLine, oversoldLvl)
stoch_short_trigger = ta.crossunder(kLine, overboughtLvl)

// ============================================================================
// VOLATILITÄTSFILTER
// ============================================================================
atrVal = ta.atr(atrLen)
atrMA  = ta.sma(atrVal, volFilterLen)
vol_ok = not useVolFilter or atrVal > atrMA

// ============================================================================
// ENTRY LOGIC
// ============================================================================
long_cond  =  cmf_bull and stoch_long_trigger  and vol_ok and time > start_period and trend_up
short_cond =  cmf_bear and stoch_short_trigger and vol_ok and time > start_period 

if long_cond
    strategy.entry("Long", strategy.long)
if short_cond
    strategy.entry("Short", strategy.short)

// ============================================================================
// KEIN STOP-LOSS / TAKE-PROFIT
// ============================================================================
// Bewusst kein strategy.exit() - eine offene Position wird ausschließlich
// durch das jeweilige Gegensignal beendet (Long schließt Short und
// umgekehrt automatisch via strategy.entry-Reversal, da pyramiding = 0).
// Genau wie im ursprünglichen Script.

// ============================================================================
// PLOTS
// ============================================================================
bgcolor(trend_up ? color.new(color.green, 92) : trend_down ? color.new(color.red, 92) : na, title = "Trendrichtung")

plot(cmf, title = "Chaikin Money Flow", color = color.new(color.blue, 0), linewidth = 2)
hline(0, "CMF Zero", color = color.gray)
hline(cmfThresh, "CMF Long-Schwelle", color = color.green, linestyle = hline.style_dotted)
hline(-cmfThresh, "CMF Short-Schwelle", color = color.red, linestyle = hline.style_dotted)

plot(kLine, title = "Stoch RSI %K", color = color.orange, linewidth = 2)
plot(dLine, title = "Stoch RSI %D", color = color.fuchsia, linewidth = 1)
hline(oversoldLvl, "Oversold", color = color.new(color.green, 50))
hline(overboughtLvl, "Overbought", color = color.new(color.red, 50))

plotchar(long_cond, title = "Long Signal", char = "▲", location = location.bottom, color = color.green, size = size.small)
plotchar(short_cond, title = "Short Signal", char = "▼", location = location.top, color = color.red, size = size.small)
