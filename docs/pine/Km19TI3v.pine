//@version=6
indicator(title="Advanced Correlation Monitor", shorttitle="ACM", overlay=true)

// === CONFIGURABLE INPUTS ===
// Correlation periods
long_period = input.int(title="Long Period (bars)", defval=90, minval=30, maxval=500)
short_period = input.int(title="Short Period (bars)", defval=6, minval=2, maxval=50)
correlation_threshold = input.float(title="Correlation Threshold (%)", defval=80.0, minval=50.0, maxval=99.0)

// Pairs configuration
group_pairs = "=== PAIRS CONFIGURATION ==="
pair1_symbol1 = input.symbol(title="Pair 1 - Symbol 1", defval="FX_IDC:GBPUSD", group=group_pairs)
pair1_symbol2 = input.symbol(title="Pair 1 - Symbol 2", defval="TVC:DXY", group=group_pairs)

pair2_symbol1 = input.symbol(title="Pair 2 - Symbol 1", defval="FX_IDC:EURUSD", group=group_pairs)
pair2_symbol2 = input.symbol(title="Pair 2 - Symbol 2", defval="FX_IDC:GBPUSD", group=group_pairs)

pair3_symbol1 = input.symbol(title="Pair 3 - Symbol 1", defval="FX_IDC:EURUSD", group=group_pairs)
pair3_symbol2 = input.symbol(title="Pair 3 - Symbol 2", defval="TVC:DXY", group=group_pairs)

pair4_symbol1 = input.symbol(title="Pair 4 - Symbol 1", defval="FX_IDC:USDCHF", group=group_pairs)
pair4_symbol2 = input.symbol(title="Pair 4 - Symbol 2", defval="TVC:DXY", group=group_pairs)

pair5_symbol1 = input.symbol(title="Pair 5 - Symbol 1", defval="FX_IDC:GBPUSD", group=group_pairs)
pair5_symbol2 = input.symbol(title="Pair 5 - Symbol 2", defval="FX_IDC:USDCHF", group=group_pairs)

pair6_symbol1 = input.symbol(title="Pair 6 - Symbol 1", defval="FX_IDC:EURUSD", group=group_pairs)
pair6_symbol2 = input.symbol(title="Pair 6 - Symbol 2", defval="FX_IDC:USDCHF", group=group_pairs)

pair7_symbol1 = input.symbol(title="Pair 7 - Symbol 1", defval="FX_IDC:EURUSD", group=group_pairs)
pair7_symbol2 = input.symbol(title="Pair 7 - Symbol 2", defval="FX_IDC:EURCAD", group=group_pairs)

pair8_symbol1 = input.symbol(title="Pair 8 - Symbol 1", defval="AMEX:SPY", group=group_pairs)
pair8_symbol2 = input.symbol(title="Pair 8 - Symbol 2", defval="SP:SPX", group=group_pairs)

pair9_symbol1 = input.symbol(title="Pair 9 - Symbol 1", defval="XETR:DAX", group=group_pairs)
pair9_symbol2 = input.symbol(title="Pair 9 - Symbol 2", defval="SP:SPX", group=group_pairs)

pair10_symbol1 = input.symbol(title="Pair 10 - Symbol 1", defval="XETR:DAX", group=group_pairs)
pair10_symbol2 = input.symbol(title="Pair 10 - Symbol 2", defval="NASDAQ:IXIC", group=group_pairs)

pair11_symbol1 = input.symbol(title="Pair 11 - Symbol 1", defval="NASDAQ:TSLA", group=group_pairs)
pair11_symbol2 = input.symbol(title="Pair 11 - Symbol 2", defval="NASDAQ:NVDA", group=group_pairs)

pair12_symbol1 = input.symbol(title="Pair 12 - Symbol 1", defval="NASDAQ:MSFT", group=group_pairs)
pair12_symbol2 = input.symbol(title="Pair 12 - Symbol 2", defval="NASDAQ:NVDA", group=group_pairs)

pair13_symbol1 = input.symbol(title="Pair 13 - Symbol 1", defval="NASDAQ:AAPL", group=group_pairs)
pair13_symbol2 = input.symbol(title="Pair 13 - Symbol 2", defval="NASDAQ:NVDA", group=group_pairs)

// Table configuration
group_table = "=== TABLE CONFIGURATION ==="
table_position = input.string(title="Table Position", defval="top_right", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], group=group_table)
table_size = input.string(title="Table Size", defval="normal", options=["tiny", "small", "normal", "large"], group=group_table)

// === AUXILIARY FUNCTIONS ===
// Function to get symbol data
get_symbol_data(symbol_id) =>
    request.security(symbol=symbol_id, timeframe=timeframe.period, expression=close, lookahead=barmerge.lookahead_off)

// Function to calculate correlation between two series
calculate_correlation(series1, series2, length) =>
    ta.correlation(source1=series1, source2=series2, length=length)

// Function to get short symbol name
get_short_name(symbol_full) =>
    parts = str.split(string=symbol_full, separator=":")
    array.size(id=parts) > 1 ? array.get(id=parts, index=1) : symbol_full

// === DATA RETRIEVAL ===
// Get data from all symbols
data1_s1 = get_symbol_data(pair1_symbol1)
data1_s2 = get_symbol_data(pair1_symbol2)
data2_s1 = get_symbol_data(pair2_symbol1)
data2_s2 = get_symbol_data(pair2_symbol2)
data3_s1 = get_symbol_data(pair3_symbol1)
data3_s2 = get_symbol_data(pair3_symbol2)
data4_s1 = get_symbol_data(pair4_symbol1)
data4_s2 = get_symbol_data(pair4_symbol2)
data5_s1 = get_symbol_data(pair5_symbol1)
data5_s2 = get_symbol_data(pair5_symbol2)
data6_s1 = get_symbol_data(pair6_symbol1)
data6_s2 = get_symbol_data(pair6_symbol2)
data7_s1 = get_symbol_data(pair7_symbol1)
data7_s2 = get_symbol_data(pair7_symbol2)
data8_s1 = get_symbol_data(pair8_symbol1)
data8_s2 = get_symbol_data(pair8_symbol2)
data9_s1 = get_symbol_data(pair9_symbol1)
data9_s2 = get_symbol_data(pair9_symbol2)
data10_s1 = get_symbol_data(pair10_symbol1)
data10_s2 = get_symbol_data(pair10_symbol2)
data11_s1 = get_symbol_data(pair11_symbol1)
data11_s2 = get_symbol_data(pair11_symbol2)
data12_s1 = get_symbol_data(pair12_symbol1)
data12_s2 = get_symbol_data(pair12_symbol2)
data13_s1 = get_symbol_data(pair13_symbol1)
data13_s2 = get_symbol_data(pair13_symbol2)

// === CORRELATION CALCULATIONS ===
// Long-term correlations
corr_long_1 = calculate_correlation(data1_s1, data1_s2, long_period)
corr_long_2 = calculate_correlation(data2_s1, data2_s2, long_period)
corr_long_3 = calculate_correlation(data3_s1, data3_s2, long_period)
corr_long_4 = calculate_correlation(data4_s1, data4_s2, long_period)
corr_long_5 = calculate_correlation(data5_s1, data5_s2, long_period)
corr_long_6 = calculate_correlation(data6_s1, data6_s2, long_period)
corr_long_7 = calculate_correlation(data7_s1, data7_s2, long_period)
corr_long_8 = calculate_correlation(data8_s1, data8_s2, long_period)
corr_long_9 = calculate_correlation(data9_s1, data9_s2, long_period)
corr_long_10 = calculate_correlation(data10_s1, data10_s2, long_period)
corr_long_11 = calculate_correlation(data11_s1, data11_s2, long_period)
corr_long_12 = calculate_correlation(data12_s1, data12_s2, long_period)
corr_long_13 = calculate_correlation(data13_s1, data13_s2, long_period)

// Short-term correlations
corr_short_1 = calculate_correlation(data1_s1, data1_s2, short_period)
corr_short_2 = calculate_correlation(data2_s1, data2_s2, short_period)
corr_short_3 = calculate_correlation(data3_s1, data3_s2, short_period)
corr_short_4 = calculate_correlation(data4_s1, data4_s2, short_period)
corr_short_5 = calculate_correlation(data5_s1, data5_s2, short_period)
corr_short_6 = calculate_correlation(data6_s1, data6_s2, short_period)
corr_short_7 = calculate_correlation(data7_s1, data7_s2, short_period)
corr_short_8 = calculate_correlation(data8_s1, data8_s2, short_period)
corr_short_9 = calculate_correlation(data9_s1, data9_s2, short_period)
corr_short_10 = calculate_correlation(data10_s1, data10_s2, short_period)
corr_short_11 = calculate_correlation(data11_s1, data11_s2, short_period)
corr_short_12 = calculate_correlation(data12_s1, data12_s2, short_period)
corr_short_13 = calculate_correlation(data13_s1, data13_s2, short_period)

// === ALERT LOGIC ===
threshold_decimal = correlation_threshold / 100

// Function to determine status and generate alerts
check_correlation_break(pair_name, corr_long, corr_short) =>
    is_highly_correlated = math.abs(corr_long) >= threshold_decimal
    is_correlation_broken = is_highly_correlated and math.abs(corr_short) < threshold_decimal
    status = is_correlation_broken ? "🔴 BROKEN" : is_highly_correlated ? "🟢 OK" : "⚫ NORMAL"
    [status, is_correlation_broken]

// Check correlation states
[status1, break1] = check_correlation_break(get_short_name(pair1_symbol1) + " vs " + get_short_name(pair1_symbol2), corr_long_1, corr_short_1)
[status2, break2] = check_correlation_break(get_short_name(pair2_symbol1) + " vs " + get_short_name(pair2_symbol2), corr_long_2, corr_short_2)
[status3, break3] = check_correlation_break(get_short_name(pair3_symbol1) + " vs " + get_short_name(pair3_symbol2), corr_long_3, corr_short_3)
[status4, break4] = check_correlation_break(get_short_name(pair4_symbol1) + " vs " + get_short_name(pair4_symbol2), corr_long_4, corr_short_4)
[status5, break5] = check_correlation_break(get_short_name(pair5_symbol1) + " vs " + get_short_name(pair5_symbol2), corr_long_5, corr_short_5)
[status6, break6] = check_correlation_break(get_short_name(pair6_symbol1) + " vs " + get_short_name(pair6_symbol2), corr_long_6, corr_short_6)
[status7, break7] = check_correlation_break(get_short_name(pair7_symbol1) + " vs " + get_short_name(pair7_symbol2), corr_long_7, corr_short_7)
[status8, break8] = check_correlation_break(get_short_name(pair8_symbol1) + " vs " + get_short_name(pair8_symbol2), corr_long_8, corr_short_8)
[status9, break9] = check_correlation_break(get_short_name(pair9_symbol1) + " vs " + get_short_name(pair9_symbol2), corr_long_9, corr_short_9)
[status10, break10] = check_correlation_break(get_short_name(pair10_symbol1) + " vs " + get_short_name(pair10_symbol2), corr_long_10, corr_short_10)
[status11, break11] = check_correlation_break(get_short_name(pair11_symbol1) + " vs " + get_short_name(pair11_symbol2), corr_long_11, corr_short_11)
[status12, break12] = check_correlation_break(get_short_name(pair12_symbol1) + " vs " + get_short_name(pair12_symbol2), corr_long_12, corr_short_12)
[status13, break13] = check_correlation_break(get_short_name(pair13_symbol1) + " vs " + get_short_name(pair13_symbol2), corr_long_13, corr_short_13)

// Generate alert if any break occurs
any_break = break1 or break2 or break3 or break4 or break5 or break6 or break7 or break8 or break9 or break10 or break11 or break12 or break13
broken_pairs = (break1 ? get_short_name(pair1_symbol1) + " vs " + get_short_name(pair1_symbol2) + " " : "") + (break2 ? get_short_name(pair2_symbol1) + " vs " + get_short_name(pair2_symbol2) + " " : "") + (break3 ? get_short_name(pair3_symbol1) + " vs " + get_short_name(pair3_symbol2) + " " : "") + (break4 ? get_short_name(pair4_symbol1) + " vs " + get_short_name(pair4_symbol2) + " " : "") + (break5 ? get_short_name(pair5_symbol1) + " vs " + get_short_name(pair5_symbol2) + " " : "") + (break6 ? get_short_name(pair6_symbol1) + " vs " + get_short_name(pair6_symbol2) + " " : "") + (break7 ? get_short_name(pair7_symbol1) + " vs " + get_short_name(pair7_symbol2) + " " : "") + (break8 ? get_short_name(pair8_symbol1) + " vs " + get_short_name(pair8_symbol2) + " " : "") + (break9 ? get_short_name(pair9_symbol1) + " vs " + get_short_name(pair9_symbol2) + " " : "") + (break10 ? get_short_name(pair10_symbol1) + " vs " + get_short_name(pair10_symbol2) + " " : "") + (break11 ? get_short_name(pair11_symbol1) + " vs " + get_short_name(pair11_symbol2) + " " : "") + (break12 ? get_short_name(pair12_symbol1) + " vs " + get_short_name(pair12_symbol2) + " " : "") + (break13 ? get_short_name(pair13_symbol1) + " vs " + get_short_name(pair13_symbol2) + " " : "")

if any_break
    alert(message="🚨 CORRELATION BROKEN: " + broken_pairs, freq=alert.freq_once_per_bar)

// === TABLE CREATION ===
var table correlation_table = table.new(position=table_position == "top_left" ? position.top_left : table_position == "top_center" ? position.top_center : table_position == "top_right" ? position.top_right : table_position == "middle_left" ? position.middle_left : table_position == "middle_center" ? position.middle_center : table_position == "middle_right" ? position.middle_right : table_position == "bottom_left" ? position.bottom_left : table_position == "bottom_center" ? position.bottom_center : position.bottom_right, columns=6, rows=14, bgcolor=color.white, border_width=1, frame_color=color.black, frame_width=2)

if barstate.islast
    // Headers
    table.cell(table_id=correlation_table, column=0, row=0, text="PAIR", bgcolor=color.blue, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=1, row=0, text="LONG CORR", bgcolor=color.blue, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=2, row=0, text="SHORT CORR", bgcolor=color.blue, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=3, row=0, text="DIFFERENCE", bgcolor=color.blue, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=4, row=0, text="STATUS", bgcolor=color.blue, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=5, row=0, text="THRESHOLD", bgcolor=color.blue, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    
    // Pair 1 Data
    table.cell(table_id=correlation_table, column=0, row=1, text=get_short_name(pair1_symbol1) + " vs " + get_short_name(pair1_symbol2), bgcolor=color.gray, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=1, row=1, text=str.tostring(corr_long_1 * 100, "#.##") + "%", bgcolor=math.abs(corr_long_1) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=2, row=1, text=str.tostring(corr_short_1 * 100, "#.##") + "%", bgcolor=math.abs(corr_short_1) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=3, row=1, text=str.tostring((corr_long_1 - corr_short_1) * 100, "#.##") + "%", bgcolor=color.yellow, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=4, row=1, text=status1, bgcolor=break1 ? color.red : math.abs(corr_long_1) >= threshold_decimal ? color.green : color.gray, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=5, row=1, text=str.tostring(correlation_threshold, "#.##") + "%", bgcolor=color.orange, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    
    // Pair 2 Data
    table.cell(table_id=correlation_table, column=0, row=2, text=get_short_name(pair2_symbol1) + " vs " + get_short_name(pair2_symbol2), bgcolor=color.gray, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=1, row=2, text=str.tostring(corr_long_2 * 100, "#.##") + "%", bgcolor=math.abs(corr_long_2) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=2, row=2, text=str.tostring(corr_short_2 * 100, "#.##") + "%", bgcolor=math.abs(corr_short_2) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=3, row=2, text=str.tostring((corr_long_2 - corr_short_2) * 100, "#.##") + "%", bgcolor=color.yellow, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=4, row=2, text=status2, bgcolor=break2 ? color.red : math.abs(corr_long_2) >= threshold_decimal ? color.green : color.gray, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=5, row=2, text=str.tostring(correlation_threshold, "#.##") + "%", bgcolor=color.orange, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    
    // Pair 3 Data
    table.cell(table_id=correlation_table, column=0, row=3, text=get_short_name(pair3_symbol1) + " vs " + get_short_name(pair3_symbol2), bgcolor=color.gray, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=1, row=3, text=str.tostring(corr_long_3 * 100, "#.##") + "%", bgcolor=math.abs(corr_long_3) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=2, row=3, text=str.tostring(corr_short_3 * 100, "#.##") + "%", bgcolor=math.abs(corr_short_3) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=3, row=3, text=str.tostring((corr_long_3 - corr_short_3) * 100, "#.##") + "%", bgcolor=color.yellow, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=4, row=3, text=status3, bgcolor=break3 ? color.red : math.abs(corr_long_3) >= threshold_decimal ? color.green : color.gray, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=5, row=3, text=str.tostring(correlation_threshold, "#.##") + "%", bgcolor=color.orange, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    
    // Pair 4 Data
    table.cell(table_id=correlation_table, column=0, row=4, text=get_short_name(pair4_symbol1) + " vs " + get_short_name(pair4_symbol2), bgcolor=color.gray, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=1, row=4, text=str.tostring(corr_long_4 * 100, "#.##") + "%", bgcolor=math.abs(corr_long_4) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=2, row=4, text=str.tostring(corr_short_4 * 100, "#.##") + "%", bgcolor=math.abs(corr_short_4) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=3, row=4, text=str.tostring((corr_long_4 - corr_short_4) * 100, "#.##") + "%", bgcolor=color.yellow, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=4, row=4, text=status4, bgcolor=break4 ? color.red : math.abs(corr_long_4) >= threshold_decimal ? color.green : color.gray, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=5, row=4, text=str.tostring(correlation_threshold, "#.##") + "%", bgcolor=color.orange, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    
    // Pair 5 Data
    table.cell(table_id=correlation_table, column=0, row=5, text=get_short_name(pair5_symbol1) + " vs " + get_short_name(pair5_symbol2), bgcolor=color.gray, text_color=color.black, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=1, row=5, text=str.tostring(corr_long_5 * 100, "#.##") + "%", bgcolor=math.abs(corr_long_5) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
    table.cell(table_id=correlation_table, column=2, row=5, text=str.tostring(corr_short_5 * 100, "#.##") + "%", bgcolor=math.abs(corr_short_5) >= threshold_decimal ? color.green : color.red, text_color=color.white, text_size=table_size == "tiny" ? size.tiny : table_size == "small" ? size.small : table_size == "normal" ? size.normal : size.large)
