//@version=6
indicator("Choppiness Index MTF", shorttitle="CHOP MTF", overlay=true)

// ── Réglages ──────────────────────────────────────────────
len = input.int(14, "Longueur CHOP", minval=2)

g1 = "Unites de temps"
useTF1 = input.bool(true,  "TF 1", inline="tf1", group=g1)
tf1    = input.timeframe("5",   "", inline="tf1", group=g1)
useTF2 = input.bool(true,  "TF 2", inline="tf2", group=g1)
tf2    = input.timeframe("15",  "", inline="tf2", group=g1)
useTF3 = input.bool(true,  "TF 3", inline="tf3", group=g1)
tf3    = input.timeframe("60",  "", inline="tf3", group=g1)
useTF4 = input.bool(true,  "TF 4", inline="tf4", group=g1)
tf4    = input.timeframe("240", "", inline="tf4", group=g1)
useTF5 = input.bool(true,  "TF 5", inline="tf5", group=g1)
tf5    = input.timeframe("D",   "", inline="tf5", group=g1)
useTF6 = input.bool(false, "TF 6", inline="tf6", group=g1)
tf6    = input.timeframe("W",   "", inline="tf6", group=g1)

g2 = "Seuils"
seuilRange = input.float(61.8, "Seuil range (choppy)", group=g2)
seuilTrend = input.float(38.2, "Seuil tendance",       group=g2)

g3 = "Affichage"
posY    = input.string("top",    "Position verticale",   options=["top","middle","bottom"], group=g3)
posX    = input.string("right",  "Position horizontale", options=["left","center","right"], group=g3)
txtSize = input.string("normal", "Taille du texte",      options=["tiny","small","normal","large"], group=g3)

// ── Calcul CHOP ───────────────────────────────────────────
f_chop(_len) =>
    100.0 * math.log10(math.sum(ta.tr(true), _len) / (ta.highest(high, _len) - ta.lowest(low, _len))) / math.log10(_len)

// Appels multi-timeframe AU NIVEAU GLOBAL (obligatoire)
c1 = request.security(syminfo.tickerid, tf1, f_chop(len), lookahead=barmerge.lookahead_off)
c2 = request.security(syminfo.tickerid, tf2, f_chop(len), lookahead=barmerge.lookahead_off)
c3 = request.security(syminfo.tickerid, tf3, f_chop(len), lookahead=barmerge.lookahead_off)
c4 = request.security(syminfo.tickerid, tf4, f_chop(len), lookahead=barmerge.lookahead_off)
c5 = request.security(syminfo.tickerid, tf5, f_chop(len), lookahead=barmerge.lookahead_off)
c6 = request.security(syminfo.tickerid, tf6, f_chop(len), lookahead=barmerge.lookahead_off)

// ── Helpers affichage ─────────────────────────────────────
f_col(_v) =>
    col = color.gray
    if not na(_v)
        col := _v >= seuilRange ? color.red : _v <= seuilTrend ? color.green : color.orange
    col

f_state(_v) =>
    na(_v) ? "-" : _v >= seuilRange ? "RANGE" : _v <= seuilTrend ? "TREND" : "NEUTRE"

f_txt(_v) =>
    na(_v) ? "-" : str.tostring(_v, "#.0")

f_position(_y, _x) =>
    _y == "top"    and _x == "left"   ? position.top_left      :
     _y == "top"    and _x == "center" ? position.top_center    :
     _y == "top"    and _x == "right"  ? position.top_right     :
     _y == "middle" and _x == "left"   ? position.middle_left   :
     _y == "middle" and _x == "center" ? position.middle_center :
     _y == "middle" and _x == "right"  ? position.middle_right  :
     _y == "bottom" and _x == "left"   ? position.bottom_left   :
     _y == "bottom" and _x == "center" ? position.bottom_center :
     position.bottom_right

// ── Tableau ───────────────────────────────────────────────
var table t = table.new(f_position(posY, posX), 3, 7, border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)

f_row(_r, _use, _lbl, _v) =>
    if _use
        table.cell(t, 0, _r, _lbl,       text_color=color.white, bgcolor=color.new(color.black, 20), text_size=txtSize)
        table.cell(t, 1, _r, f_txt(_v),  text_color=color.white, bgcolor=color.new(f_col(_v), 0),    text_size=txtSize)
        table.cell(t, 2, _r, f_state(_v),text_color=color.white, bgcolor=color.new(color.black, 20), text_size=txtSize)

if barstate.islast
    table.clear(t, 0, 0, 2, 6)
    table.cell(t, 0, 0, "TF",   text_color=color.white, bgcolor=color.blue, text_size=txtSize)
    table.cell(t, 1, 0, "CHOP", text_color=color.white, bgcolor=color.blue, text_size=txtSize)
    table.cell(t, 2, 0, "Etat", text_color=color.white, bgcolor=color.blue, text_size=txtSize)
    f_row(1, useTF1, tf1, c1)
    f_row(2, useTF2, tf2, c2)
    f_row(3, useTF3, tf3, c3)
    f_row(4, useTF4, tf4, c4)
    f_row(5, useTF5, tf5, c5)
    f_row(6, useTF6, tf6, c6)
