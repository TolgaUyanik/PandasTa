//@version=6
indicator(title="Relative Strength Scoring System", shorttitle="RS Score", overlay=false)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
benchmark = input.symbol("NSE:NIFTY500",   title="Benchmark Symbol")
st_tf     = input.timeframe("W",           title="Short-Term Timeframe (e.g. W = Weekly)")
st_len    = input.int(20,                  title="Short-Term SMA Length", minval=1)
st_label  = input.string("Weekly MA",      title="Short-Term Label")
lt_tf     = input.timeframe("M",           title="Long-Term Timeframe (e.g. M = Monthly)")
lt_len    = input.int(20,                  title="Long-Term SMA Length", minval=1)
lt_label  = input.string("Monthly MA",     title="Long-Term Label")
plot_style = input.string("Both",          title="Plot Style", options=["Histogram", "Line", "Both"])

// ─────────────────────────────────────────────
// HELPER FUNCTIONS
// ─────────────────────────────────────────────
f_score_color(s) =>
    s > 0 ? color.new(#00c853, 20) : s < 0 ? color.new(#b71c1c, 20) : color.new(#37474f, 20)

f_score_text(s) =>
    s > 0 ? "+" + str.tostring(s) : s < 0 ? str.tostring(s) : "0"

// ─────────────────────────────────────────────
// CURRENT RATIO (chart timeframe — apples to apples)
// ─────────────────────────────────────────────
bench_chart   = request.security(benchmark, timeframe.period, close)
current_ratio = close / bench_chart

// ─────────────────────────────────────────────
// SHORT-TERM RATIO MA
// Both stock and benchmark pulled at the same higher tf
// Ratio computed from matching closes, then SMA applied
// ─────────────────────────────────────────────
st_stock_close = request.security(syminfo.tickerid, st_tf, close)
st_bench_close = request.security(benchmark, st_tf, close)
st_ratio       = st_stock_close / st_bench_close
st_ma_val      = ta.sma(st_ratio, st_len)

// ─────────────────────────────────────────────
// LONG-TERM RATIO MA
// ─────────────────────────────────────────────
lt_stock_close = request.security(syminfo.tickerid, lt_tf, close)
lt_bench_close = request.security(benchmark, lt_tf, close)
lt_ratio       = lt_stock_close / lt_bench_close
lt_ma_val      = ta.sma(lt_ratio, lt_len)

// ─────────────────────────────────────────────
// SCORING — equality = 0, not -1
// ─────────────────────────────────────────────
score_price_vs_st  = current_ratio > st_ma_val ? 1 : current_ratio < st_ma_val ? -1 : 0
score_price_vs_lt  = current_ratio > lt_ma_val ? 1 : current_ratio < lt_ma_val ? -1 : 0
score_st_vs_lt     = st_ma_val     > lt_ma_val ? 1 : st_ma_val     < lt_ma_val ? -1 : 0
composite_score    = score_price_vs_st + score_price_vs_lt + score_st_vs_lt

// ─────────────────────────────────────────────
// COLORS
// ─────────────────────────────────────────────
hist_color  = composite_score == 3 ? color.new(#00c853, 0) : composite_score == 2 ? color.new(#69f0ae, 0) : composite_score == 1 ? color.new(#b9f6ca, 0) : composite_score == -1 ? color.new(#ff8a80, 0) : composite_score == -2 ? color.new(#ff1744, 0) : composite_score == -3 ? color.new(#b71c1c, 0) : color.new(#90a4ae, 0)
line_color  = composite_score > 0 ? color.new(#00c853, 0) : composite_score < 0 ? color.new(#ff1744, 0) : color.new(#90a4ae, 0)

// ─────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────
plot(plot_style == "Histogram" or plot_style == "Both" ? composite_score : na, style=plot.style_histogram, color=hist_color, linewidth=4, title="RS Score Histogram")
plot(plot_style == "Line"      or plot_style == "Both" ? composite_score : na, style=plot.style_line,      color=line_color,  linewidth=2, title="RS Score Line")

hline(0,  "Zero",   color=color.new(color.white, 60), linestyle=hline.style_solid)
hline(3,  "+3 Max", color=color.new(color.green, 70), linestyle=hline.style_dashed)
hline(-3, "-3 Min", color=color.new(color.red,   70), linestyle=hline.style_dashed)
hline(1,  "+1",     color=color.new(color.green, 85), linestyle=hline.style_dotted)
hline(-1, "-1",     color=color.new(color.red,   85), linestyle=hline.style_dotted)

// ─────────────────────────────────────────────
// TABLE (Bottom Left)
// ─────────────────────────────────────────────
var table score_table = table.new(position.bottom_left, 3, 5, bgcolor=color.new(#0d1117, 10), border_width=1, border_color=color.new(color.white, 70), frame_width=1, frame_color=color.new(color.white, 50))

// Header
table.cell(score_table, 0, 0, "VARIABLE", text_color=color.new(color.white, 20), text_size=size.small, bgcolor=color.new(#1a237e, 10), text_halign=text.align_left)
table.cell(score_table, 1, 0, "STATUS",   text_color=color.new(color.white, 20), text_size=size.small, bgcolor=color.new(#1a237e, 10), text_halign=text.align_center)
table.cell(score_table, 2, 0, "SCORE",    text_color=color.new(color.white, 20), text_size=size.small, bgcolor=color.new(#1a237e, 10), text_halign=text.align_center)

// Row 1: Price vs Short-Term MA
table.cell(score_table, 0, 1, "Price vs " + st_label + " (" + str.tostring(st_len) + ")", text_color=color.white, text_size=size.small, text_halign=text.align_left)
table.cell(score_table, 1, 1, score_price_vs_st > 0 ? "Above ▲" : score_price_vs_st < 0 ? "Below ▼" : "Equal —", text_color=score_price_vs_st > 0 ? color.lime : score_price_vs_st < 0 ? color.red : color.gray, text_size=size.small)
table.cell(score_table, 2, 1, f_score_text(score_price_vs_st), text_color=color.white, text_size=size.small, bgcolor=f_score_color(score_price_vs_st))

// Row 2: Price vs Long-Term MA
table.cell(score_table, 0, 2, "Price vs " + lt_label + " (" + str.tostring(lt_len) + ")", text_color=color.white, text_size=size.small, text_halign=text.align_left)
table.cell(score_table, 1, 2, score_price_vs_lt > 0 ? "Above ▲" : score_price_vs_lt < 0 ? "Below ▼" : "Equal —", text_color=score_price_vs_lt > 0 ? color.lime : score_price_vs_lt < 0 ? color.red : color.gray, text_size=size.small)
table.cell(score_table, 2, 2, f_score_text(score_price_vs_lt), text_color=color.white, text_size=size.small, bgcolor=f_score_color(score_price_vs_lt))

// Row 3: Short-Term MA vs Long-Term MA
table.cell(score_table, 0, 3, st_label + " vs " + lt_label, text_color=color.white, text_size=size.small, text_halign=text.align_left)
table.cell(score_table, 1, 3, score_st_vs_lt > 0 ? "Above ▲" : score_st_vs_lt < 0 ? "Below ▼" : "Equal —", text_color=score_st_vs_lt > 0 ? color.lime : score_st_vs_lt < 0 ? color.red : color.gray, text_size=size.small)
table.cell(score_table, 2, 3, f_score_text(score_st_vs_lt), text_color=color.white, text_size=size.small, bgcolor=f_score_color(score_st_vs_lt))

// Composite row
composite_bg    = composite_score >= 3 ? color.new(#00c853, 10) : composite_score > 0 ? color.new(#69f0ae, 20) : composite_score == 0 ? color.new(#37474f, 20) : composite_score > -3 ? color.new(#ff1744, 20) : color.new(#b71c1c, 10)
composite_label = composite_score >= 2 ? "LONG ✦" : composite_score <= -2 ? "SHORT ✦" : "NEUTRAL"

table.cell(score_table, 0, 4, "COMPOSITE SCORE",             text_color=color.white, text_size=size.normal, text_halign=text.align_left, bgcolor=composite_bg)
table.cell(score_table, 1, 4, composite_label,               text_color=color.white, text_size=size.normal, bgcolor=composite_bg)
table.cell(score_table, 2, 4, f_score_text(composite_score), text_color=color.white, text_size=size.normal, bgcolor=composite_bg)