//@version=6
indicator("BK AK-Cobra", "🐍🔬", overlay=false, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §1  DISPLAY + CONTRACT + MASTER CONTROLS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
mode         = input.string("Normal", "Display Mode", options=["Clean","Normal","Debug"], group="Display")
presetInput  = input.string("AUTO", "Contract Preset", options=["AUTO","ES","NQ","CL","GC","MBT","Custom"], group="Display")
histTransp   = input.int(35, "Histogram Transparency (0-100)", minval=0, maxval=100, group="Display")
labelLookback= input.int(300, "Label Lookback (bars)", minval=50, maxval=500, group="Display", tooltip="Max bars back for signal labels. Lower = fewer labels, faster chart.")
useSlopeColor= input.bool(true, "Slope Directional SMI Color", group="Display", tooltip="Cyan when rising, purple/magenta when falling. Brightens at ±40 extremes.")
onlySessionLabels = input.bool(false, "Only Show Icons During Session", group="Display", tooltip="When enabled, all signal labels/icons only appear during RTH session hours. Uses your Session settings.")

showAPlus = true
showSqz   = mode != "Clean"
showDiv   = mode == "Normal" or mode == "Debug"
showEW    = mode == "Debug"
showAdvSig= mode == "Debug"
showExhaust = mode == "Normal" or mode == "Debug"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §2  BACKGROUND + SESSION LINES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
showHistBG   = input.bool(true, "Show Histogram-Based Background", group="Background", tooltip="Background pulses green/red with histogram direction.")
bgTransp     = input.int(99, "BG Transparency", minval=80, maxval=99, group="Background")
showRTHLine  = input.bool(true, "Show RTH Open Line", group="Session Lines", tooltip="Vertical line at 9:30 AM NY")
rthLineTransp= input.int(20, "RTH Line Transparency", minval=0, maxval=90, group="Session Lines")
showETHLine  = input.bool(true, "Show ETH Open Line", group="Session Lines", tooltip="Vertical line at 6:00 PM NY")
ethLineTransp= input.int(35, "ETH Line Transparency", minval=0, maxval=90, group="Session Lines")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §3  MTF TIMEFRAME STACK
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
tf_5   = input.timeframe("5",   "TF: 5m",   group="MTF Stack")
tf_15  = input.timeframe("15",  "TF: 15m",  group="MTF Stack")
tf_30  = input.timeframe("30",  "TF: 30m",  group="MTF Stack")
tf_60  = input.timeframe("60",  "TF: 1h",   group="MTF Stack")
tf_233 = input.timeframe("233", "TF: 233m", group="MTF Stack")
tf_987 = input.timeframe("987", "TF: 987m", group="MTF Stack")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §4  RTH SESSION + SESSION PHASES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
useNYTZ    = input.bool(true, "Use New York Timezone", group="Session")
rthNY      = input.session("0600-1600", "RTH Session (NY)", group="Session")
inRTH_ny   = not na(time(timeframe.period, rthNY, "America/New_York"))
inRTH_ex   = not na(time(timeframe.period, rthNY))
inRTH      = useNYTZ ? inRTH_ny : inRTH_ex

nyHour   = hour(time, "America/New_York")
nyMinute = minute(time, "America/New_York")
nyMins   = nyHour * 60 + nyMinute

isPreMkt    = nyMins >= 240  and nyMins < 570
isOpenDrive = nyMins >= 570  and nyMins < 600
isMorning   = nyMins >= 600  and nyMins < 690
isMidday    = nyMins >= 690  and nyMins < 810
isAfternoon = nyMins >= 810  and nyMins < 900
isPowerHour = nyMins >= 900  and nyMins < 960

sessionName = isOpenDrive ? "Open Drive" : isMorning ? "AM Session" : isMidday ? "Midday" : isAfternoon ? "Afternoon" : isPowerHour ? "Power Hour" : isPreMkt ? "Pre-Market" : "Closed"
sessionBias = isOpenDrive ? "MOMENTUM — trust the thrust, don't fade" : isMorning ? "TRENDING — setups develop, follow conviction" : isMidday ? "MEAN REVERT — fade extremes, tighten stops" : isAfternoon ? "TRANSITION — watch for new initiative" : isPowerHour ? "INSTITUTIONAL — volume = truth, respect size" : isPreMkt ? "POSITIONING — low liquidity, watch for traps" : "OFF HOURS"
sessionID = isOpenDrive ? 1 : isMorning ? 2 : isMidday ? 3 : isAfternoon ? 4 : isPowerHour ? 5 : isPreMkt ? 6 : 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §5  CONFLUENCE + SIGNAL OPTIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
allowOverrides   = input.bool(false, "Allow Manual Overrides", group="Signal Filters")
requireHighAgree = input.bool(true,  "Require 233m+987m Agree (Master)", group="Signal Filters")
require5mReset   = input.bool(true,  "Require 5m Reset Before Entry", group="Signal Filters")
resetLookback    = input.int(20, "5m Reset Lookback Bars", minval=1, maxval=200, group="Signal Filters")
cooldownBars     = input.int(5,  "Min Bars Between A+ Signals", minval=0, maxval=200, group="Signal Filters")
useMidVeto       = input.bool(true, "Mid TF Veto (15m+30m)", group="Signal Filters")
execThresh       = input.int(6, "Execution Bias Threshold", minval=1, maxval=30, group="Signal Filters")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §6  CORE SMI PARAMETERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
kLen_in    = input.int(10, "%K Length", minval=1, maxval=15000, group="Core SMI")
dLen_in    = input.int(3,  "Double Smooth Len", minval=1, maxval=4999, group="Core SMI")
sigLen_in  = input.int(3,  "Signal Len", minval=1, maxval=4999, group="Core SMI")
sigType_in = input.string("WMA", "Signal Type", options=["EMA","RMA","WMA","HMA"], group="Core SMI")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §7  DYNAMIC BANDS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bandLookback_in = input.int(170, "Dynamic Band Lookback", minval=20, maxval=2000, group="Dynamic Bands")
bandK_in        = input.float(1.45, "Band StDev Mult", minval=0.2, maxval=5.0, step=0.05, group="Dynamic Bands")
bandMin_in      = input.float(25, "Band Min", minval=5, maxval=80, step=1, group="Dynamic Bands")
bandMax_in      = input.float(70, "Band Max", minval=20, maxval=140, step=1, group="Dynamic Bands")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §8  REGIME ENGINE (EMA + ADX)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
useEMA     = input.bool(true,  "Use EMA Stack", group="Regime Engine")
useADX     = input.bool(false, "Use ADX Filter", group="Regime Engine")
emaFast_in = input.int(55,  "EMA Fast", minval=2, maxval=500, group="Regime Engine")
emaSlow_in = input.int(233, "EMA Slow", minval=5, maxval=800, group="Regime Engine")
adxLen_in  = input.int(14,  "ADX Length", minval=5, maxval=100, group="Regime Engine")
adxTh_in   = input.float(20, "ADX Threshold", minval=5, maxval=50, step=0.5, group="Regime Engine")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §9  SQUEEZE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
useSqueeze = input.bool(true, "Use Squeeze Filter", group="Squeeze")
bbLen   = input.int(20, "BB Length", minval=5, maxval=200, group="Squeeze")
bbMult  = input.float(2.0, "BB Mult", minval=0.5, maxval=4.0, step=0.1, group="Squeeze")
kcLen   = input.int(20, "KC Length", minval=5, maxval=200, group="Squeeze")
kcMult  = input.float(1.5, "KC Mult", minval=0.5, maxval=4.0, step=0.1, group="Squeeze")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §10 DIVERGENCE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
useDiv_in  = input.bool(true, "Enable Divergence", group="Divergence")
pivLen     = input.int(5, "Pivot Length", minval=2, maxval=20, group="Divergence")
divMinBars = input.int(10, "Min Bars Between Pivots", minval=2, maxval=200, group="Divergence")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §11 ENHANCEMENT MODULES — TOGGLES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
useVolWeight  = input.bool(true,  "Volume Conviction Layer", group="⚡ Enhancement Modules", tooltip="Volume Conviction Score (0-100%) measuring participation quality.")
useAdaptive   = input.bool(true,  "Adaptive Regime Sensitivity", group="⚡ Enhancement Modules", tooltip="Adjusts dynamic bands based on ATR regime.")
useTrap       = input.bool(true,  "Trap / Failed Auction Detection", group="⚡ Enhancement Modules", tooltip="Detects SMI band pierce → reversal without price follow-through.")
useFatigue    = input.bool(true,  "Momentum Decay / Fatigue Scoring", group="⚡ Enhancement Modules", tooltip="Tracks extreme camping + decaying slope = exhaustion.")
useAbsorption = input.bool(true,  "Absorption Signature Detection", group="⚡ Enhancement Modules", tooltip="Price new highs + histogram compression = distribution/accumulation.")
useJerk       = input.bool(true,  "Histogram Jerk (3rd Derivative)", group="⚡ Enhancement Modules", tooltip="Rate of change of acceleration. Earliest turn signal.")
useCrossTFDiv = input.bool(true,  "Cross-TF Deceleration Score", group="⚡ Enhancement Modules", tooltip="Multi-TF decel count = reversal conviction.")

trapBars     = input.int(5, "Trap Reversal Window (bars)", minval=2, maxval=20, group="⚡ Trap Settings")
trapPriceATR = input.float(0.3, "Trap Price Follow-Through ATR%", minval=0.05, maxval=1.0, step=0.05, group="⚡ Trap Settings")
fatigueDecayBars = input.int(30, "Fatigue Max Bars", minval=5, maxval=100, group="⚡ Fatigue Settings")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §11B INTELLIGENCE MODULES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
useHeatScore   = input.bool(true,  "🔥 Heat Score (Unified Conviction)", group="🧠 Intelligence Modules")
useBandTouch   = input.bool(true,  "📊 Band Touch Counter + Memory", group="🧠 Intelligence Modules")
useVelocity    = input.bool(true,  "⚡ Momentum Velocity at Extremes", group="🧠 Intelligence Modules")
useHistPatterns= input.bool(true,  "🔬 Histogram Pattern Recognition", group="🧠 Intelligence Modules")
useCurveShape  = input.bool(true,  "📐 SMI Curve Shape Matching", group="🧠 Intelligence Modules")

patCooldown    = input.int(8,   "Pattern Cooldown (bars)", minval=2, maxval=50, group="🔬 Pattern Recognition")
patMinHistMag  = input.float(2.0, "Min Histogram Magnitude", minval=0.5, maxval=20.0, step=0.5, group="🔬 Pattern Recognition")
slingMinComp   = input.int(3,   "Slingshot: Min Compression Bars", minval=2, maxval=8, group="🔬 Pattern Recognition")
slingExpMult   = input.float(1.5, "Slingshot: Expansion Multiplier", minval=1.1, maxval=3.0, step=0.1, group="🔬 Pattern Recognition")
stairMinBars   = input.int(4,   "Staircase: Min Consecutive Bars", minval=3, maxval=8, group="🔬 Pattern Recognition")
cliffDropPct   = input.float(50, "Cliff: Min Drop %", minval=30, maxval=80, step=5, group="🔬 Pattern Recognition")
cliffMinPeak   = input.float(0.6, "Cliff: Min Peak Ratio", minval=0.3, maxval=0.9, step=0.1, group="🔬 Pattern Recognition")
dblPumpWindow  = input.int(8,   "Dbl Pump: Lookback Window", minval=4, maxval=15, group="🔬 Pattern Recognition")
dblPumpZeroPct = input.float(20, "Dbl Pump: Near-Zero % Threshold", minval=5, maxval=40, step=5, group="🔬 Pattern Recognition")
divCompBars    = input.int(4,   "Div Compression: Min Declining Bars", minval=3, maxval=8, group="🔬 Pattern Recognition")

shapeLookback  = input.int(30,  "Shape Lookback Window", minval=15, maxval=60, group="📐 Curve Shape Matching")
shapeCooldown  = input.int(10,  "Shape Cooldown (bars)", minval=3, maxval=30, group="📐 Curve Shape Matching")
wMinTrough     = input.float(0.6, "W/M: Min Band Penetration", minval=0.3, maxval=1.0, step=0.1, group="📐 Curve Shape Matching")
wMaxBarsBtwn   = input.int(20,  "W/M: Max Bars Between Troughs", minval=8, maxval=40, group="📐 Curve Shape Matching")
wMinBarsBtwn   = input.int(5,   "W/M: Min Bars Between Troughs", minval=3, maxval=15, group="📐 Curve Shape Matching")
roundMinBars   = input.int(8,   "Rounding: Min Formation Bars", minval=5, maxval=25, group="📐 Curve Shape Matching")
vSpikeMaxBars  = input.int(4,   "V-Spike: Max Reversal Bars", minval=2, maxval=8, group="📐 Curve Shape Matching")
vSpikeMinDepth = input.float(0.8, "V-Spike: Min Band Depth", minval=0.5, maxval=1.5, step=0.1, group="📐 Curve Shape Matching")

useBacktest    = input.bool(true,  "📈 Signal Outcome Tracker (Backtest)", group="🧠 Intelligence Modules")
useGrading     = input.bool(true,  "🏆 Signal Grading (A+/A/B+/B)", group="🧠 Intelligence Modules")

heatW_band     = input.float(15, "Heat: Band Proximity Weight", minval=0, maxval=30, step=1, group="🔥 Heat Score Tuning")
heatW_bandTch  = input.float(9, "Heat: Band Touch Freshness", minval=0, maxval=20, step=1, group="🔥 Heat Score Tuning")
heatW_velocity = input.float(10, "Heat: Velocity Weight", minval=0, maxval=20, step=1, group="🔥 Heat Score Tuning")
heatW_fatigue  = input.float(10, "Heat: Fatigue Weight", minval=0, maxval=25, step=1, group="🔥 Heat Score Tuning")
heatW_xtfDecel = input.float(8, "Heat: Cross-TF Decel Weight", minval=0, maxval=25, step=1, group="🔥 Heat Score Tuning")
heatW_trap     = input.float(7,  "Heat: Trap Detection Weight", minval=0, maxval=20, step=1, group="🔥 Heat Score Tuning")
heatW_absorb   = input.float(7,  "Heat: Absorption Weight", minval=0, maxval=20, step=1, group="🔥 Heat Score Tuning")
heatW_volConv  = input.float(7,  "Heat: Volume Conviction Weight", minval=0, maxval=25, step=1, group="🔥 Heat Score Tuning")
heatW_session  = input.float(4,  "Heat: Session Phase Weight", minval=0, maxval=20, step=1, group="🔥 Heat Score Tuning")
heatW_squeeze  = input.float(4,  "Heat: Squeeze State Weight", minval=0, maxval=15, step=1, group="🔥 Heat Score Tuning")
heatW_diverg   = input.float(3,  "Heat: Divergence Weight", minval=0, maxval=15, step=1, group="🔥 Heat Score Tuning")
heatW_shape    = input.float(8, "Heat: Curve Shape Weight", minval=0, maxval=20, step=1, group="🔥 Heat Score Tuning")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §11C 🔬 FOOTPRINT ENGINE INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
group_fp = "🔬 Footprint Engine"
useFP           = input.bool(true,   "Enable Footprint Engine (Premium/Ultimate)", group=group_fp, tooltip="Requires TradingView Premium or Ultimate. Gracefully degrades if unavailable.")
fpTickSize      = input.int(100,     "Tick Size Per Row",          minval=1,   group=group_fp)
fpVAPct         = input.float(70.0,  "Value Area %",              step=5.0,   minval=50.0, maxval=95.0, group=group_fp)

group_fpD = "🔬 FP: Delta Gate"
useFPDelta      = input.bool(true,   "Delta Confirmation for A+ Signals", group=group_fpD, tooltip="Require delta alignment for A+ long/short triggers. Positive delta for longs, negative for shorts.")
fpDeltaMode     = input.string("Direction", "Delta Mode", options=["Direction","Threshold"], group=group_fpD)
fpDeltaMinAbs   = input.float(0.0,   "  Min Abs Delta (Threshold mode)", step=50.0, group=group_fpD)

group_fpP = "🔬 FP: POC / Auction"
useFPPOC        = input.bool(true,   "POC Migration Tracking",                 group=group_fpP)
useFPLocGate    = input.bool(true,   "Price vs POC Location Filter",           group=group_fpP, tooltip="Price above POC = bullish acceptance. Below = bearish.")

group_fpI = "🔬 FP: Imbalance"
useFPImbalance  = input.bool(true,   "Imbalance Detection at POC",             group=group_fpI)
fpImbRatio      = input.float(2.5,   "  Imbalance Ratio Threshold",  step=0.5, minval=1.5, group=group_fpI)
showFPImbLabels = input.bool(true,   "  Show Imbalance Labels",                group=group_fpI)

group_fpDv = "🔬 FP: Delta Divergence"
useFPDiv        = input.bool(true,   "Delta vs SMI Divergence",                group=group_fpDv, tooltip="ADX-style divergence but using ACTUAL order flow. SMI rising but delta fading = fuel drying up.")
fpDivLen        = input.int(8,       "  Delta SMA Length",  minval=3, maxval=30, group=group_fpDv)
showFPDivLabels = input.bool(true,   "  Show Divergence Labels",               group=group_fpDv)

group_fpM = "🔬 FP: MTF Delta"
useFPMTF        = input.bool(true,   "MTF Delta Accumulation",                 group=group_fpM, tooltip="Accumulates chart-TF footprint delta into HTF windows. The ONLY way to get accurate HTF delta — built from granular LTF data, not aggregated bars.")
fpMTFAlignMin   = input.int(3,       "  Min HTF Windows Aligned",  minval=1, maxval=5, group=group_fpM, tooltip="How many HTF delta windows must agree for MTF alignment signal.")

// 🔬 FP Heat Score Weights
heatW_fpDelta   = input.float(8,  "Heat: FP Delta Weight",    minval=0, maxval=20, step=1, group="🔥 Heat Score Tuning", tooltip="Points for delta direction alignment with trade direction.")
heatW_fpPOC     = input.float(6,  "Heat: FP POC Migration",   minval=0, maxval=15, step=1, group="🔥 Heat Score Tuning", tooltip="Points for POC migration confirming trade direction.")
heatW_fpImb     = input.float(7,  "Heat: FP Imbalance",       minval=0, maxval=15, step=1, group="🔥 Heat Score Tuning", tooltip="Points for aggressive imbalance at POC confirming direction.")
heatW_fpMTF     = input.float(8,  "Heat: FP MTF Delta Align", minval=0, maxval=20, step=1, group="🔥 Heat Score Tuning", tooltip="Points for multi-TF delta alignment.")

bandTouchWindow  = input.int(60, "Band Touch Window (bars)", minval=10, maxval=200, group="📊 Band Touch Settings")
bandTouchMinBars = input.int(5,  "Min Bars Between Touches", minval=2, maxval=30, group="📊 Band Touch Settings")

velocityWindow = input.int(10, "Velocity Lookback (bars)", minval=3, maxval=30, group="⚡ Velocity Settings")
velocityFastTh = input.float(5.0, "Fast Velocity Threshold", minval=1.0, maxval=15.0, step=0.5, group="⚡ Velocity Settings")
velocitySlowTh = input.float(1.5, "Slow Velocity Threshold", minval=0.2, maxval=5.0, step=0.1, group="⚡ Velocity Settings")

btRTarget1    = input.float(1.0, "Backtest R-Target 1", minval=0.5, maxval=5.0, step=0.25, group="📈 Backtest Engine")
btRTarget2    = input.float(2.0, "Backtest R-Target 2", minval=1.0, maxval=8.0, step=0.25, group="📈 Backtest Engine")
btRTarget3    = input.float(3.0, "Backtest R-Target 3", minval=1.5, maxval=12.0, step=0.25, group="📈 Backtest Engine")
btStopATRMult = input.float(1.5, "Stop Distance (ATR mult)", minval=0.5, maxval=4.0, step=0.25, group="📈 Backtest Engine")
btMaxBarsHold = input.int(50, "Max Bars to Hold", minval=10, maxval=200, group="📈 Backtest Engine")
btTrackCount  = input.int(50, "Max Signals to Track", minval=10, maxval=100, group="📈 Backtest Engine")

gradeAPlus = input.int(82, "Grade A+ Threshold", minval=50, maxval=100, group="🏆 Signal Grading")
gradeA     = input.int(68, "Grade A Threshold", minval=30, maxval=95, group="🏆 Signal Grading")
gradeBPlus = input.int(52, "Grade B+ Threshold", minval=20, maxval=80, group="🏆 Signal Grading")

useBayesian    = input.bool(true, "🧮 Bayesian Confidence (Self-Learning)", group="🧬 Adaptive Intelligence")
bayesMinSample = input.int(5, "Bayes: Min Samples to Activate", minval=3, maxval=20, group="🧬 Adaptive Intelligence")
bayesStrength  = input.float(0.3, "Bayes: Adjustment Strength", minval=0.05, maxval=0.6, step=0.05, group="🧬 Adaptive Intelligence")

useKNN         = input.bool(true, "🔍 k-NN Context Matching", group="🧬 Adaptive Intelligence")
knnK           = input.int(5, "k-NN: Neighbors (k)", minval=3, maxval=10, group="🧬 Adaptive Intelligence")
knnMinClosed   = input.int(8, "k-NN: Min Closed Signals", minval=5, maxval=30, group="🧬 Adaptive Intelligence")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §12 AUTO CONTRACT DETECT + PRESETS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
root = str.upper(syminfo.root)
autoContract = (root == "ES" or root == "NQ" or root == "CL" or root == "GC" or root == "MBT") ? root : "Custom"
contract = presetInput == "AUTO" ? autoContract : presetInput

kLen_p   = contract=="ES" ? 10 : contract=="NQ" ? 10 : contract=="CL" ? 12 : contract=="GC" ? 10 : contract=="MBT" ? 14 : kLen_in
dLen_p   = contract=="ES" ? 3  : contract=="NQ" ? 3  : contract=="CL" ? 3  : contract=="GC" ? 3  : contract=="MBT" ? 4  : dLen_in
sigLen_p = contract=="ES" ? 3  : contract=="NQ" ? 3  : contract=="CL" ? 4  : contract=="GC" ? 3  : contract=="MBT" ? 5  : sigLen_in
sigType_p= "EMA"

bandLookback_p = contract=="ES" ? 150 : contract=="NQ" ? 170 : contract=="CL" ? 200 : contract=="GC" ? 180 : contract=="MBT" ? 250 : bandLookback_in
bandK_p        = contract=="ES" ? 1.35: contract=="NQ" ? 1.45: contract=="CL" ? 1.55: contract=="GC" ? 1.45: contract=="MBT" ? 1.65: bandK_in
bandMin_p      = contract=="CL" ? 30  : contract=="MBT" ? 35  : bandMin_in
bandMax_p      = contract=="CL" ? 80  : contract=="MBT" ? 90  : bandMax_in

emaFast_p = contract=="ES" ? 50  : contract=="NQ" ? 55  : contract=="CL" ? 34  : contract=="GC" ? 50  : contract=="MBT" ? 55  : emaFast_in
emaSlow_p = contract=="ES" ? 200 : contract=="NQ" ? 233 : contract=="CL" ? 144 : contract=="GC" ? 200 : contract=="MBT" ? 233 : emaSlow_in
adxTh_p   = contract=="ES" ? 18  : contract=="NQ" ? 20  : contract=="CL" ? 22  : contract=="GC" ? 20  : contract=="MBT" ? 25  : adxTh_in

useOvr = allowOverrides or contract == "Custom"
kLen   = useOvr ? kLen_in   : kLen_p
dLen   = useOvr ? dLen_in   : dLen_p
sigLen = useOvr ? sigLen_in : sigLen_p
sigType= useOvr ? sigType_in: sigType_p

bandLookback = useOvr ? bandLookback_in : bandLookback_p
bandK_base   = useOvr ? bandK_in        : bandK_p
bandMin      = useOvr ? bandMin_in      : bandMin_p
bandMax      = useOvr ? bandMax_in      : bandMax_p

emaFast = useOvr ? emaFast_in : emaFast_p
emaSlow = useOvr ? emaSlow_in : emaSlow_p
adxLen  = adxLen_in
adxTh   = useOvr ? adxTh_in   : adxTh_p
useDiv  = useDiv_in

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §13 CORE FUNCTIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
clamp(x, lo, hi) => math.min(math.max(x, lo), hi)
emaEma(src, len)  => ta.ema(ta.ema(src, len), len)

smooth(src, len, method) =>
    switch method
        "EMA" => ta.ema(src, len)
        "RMA" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        "HMA" => ta.hma(src, len)
        => ta.ema(src, len)

f_smi_core(_kLen, _dLen) =>
    hh  = ta.highest(high, _kLen)
    ll  = ta.lowest(low,  _kLen)
    rng = hh - ll
    rel = close - (hh + ll) / 2.0
    den = emaEma(rng, _dLen)
    num = emaEma(rel, _dLen)
    den != 0 ? 200.0 * (num / den) : 0.0

f_pack(_kLen, _dLen, _sigLen, _sigType) =>
    s  = f_smi_core(_kLen, _dLen)
    g  = smooth(s, _sigLen, _sigType)
    h  = s - g
    sl = s - s[1]
    [s, g, h, sl]

f_state(_s, _g, _h, _sl) =>
    sb = _s > 0 and _h > 0 and _sl > 0 and _s > _g
    b  = _s > 0 and _h > 0 and _s > _g
    sB = _s < 0 and _h < 0 and _sl < 0 and _s < _g
    bR = _s < 0 and _h < 0 and _s < _g
    sb ? 2 : b ? 1 : sB ? -2 : bR ? -1 : 0

f_state_txt(_st) =>
    _st == 2 ? "S·BULL" : _st == 1 ? "BULL" : _st == -1 ? "BEAR" : _st == -2 ? "S·BEAR" : "NEUT"

f_state_clr(_st, _transp) =>
    _st >= 2  ? color.new(#00E676, _transp) :
     _st == 1  ? color.new(#4CAF50, _transp) :
     _st == -1 ? color.new(#EF5350, _transp) :
     _st <= -2 ? color.new(#FF1744, _transp) :
     color.new(#78909C, _transp)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §14 ADAPTIVE REGIME SENSITIVITY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
atrVal   = ta.atr(14)
atrSma50 = ta.sma(atrVal, 50)
atrRatio = atrSma50 > 0 ? atrVal / atrSma50 : 1.0

volRegime   = atrRatio > 1.4 ? 2 : atrRatio > 1.15 ? 1 : atrRatio < 0.65 ? -2 : atrRatio < 0.85 ? -1 : 0
volRegLabel = volRegime == 2 ? "SPIKE" : volRegime == 1 ? "HIGH" : volRegime == -1 ? "LOW" : volRegime == -2 ? "DEAD" : "NORM"

adaptBandK = useAdaptive ?
     (volRegime == 2 ? bandK_base * 1.35 :
      volRegime == 1 ? bandK_base * 1.15 :
      volRegime == -1 ? bandK_base * 0.85 :
      volRegime == -2 ? bandK_base * 0.70 :
      bandK_base) : bandK_base

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §15 CURRENT TF CALCULATIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[smi, sig, hist, slope] = f_pack(kLen, dLen, sigLen, sigType)
accel = slope - slope[1]
jerk  = accel - accel[1]

smiSt = ta.stdev(smi, bandLookback)
dyn   = clamp(smiSt * adaptBandK, bandMin, bandMax)
obDyn = dyn
osDyn = -dyn

slopeCrossUp   = ta.crossover(slope, 0)
slopeCrossDn   = ta.crossunder(slope, 0)
accelCrossUpT  = ta.crossover(accel, 0)
accelCrossDnT  = ta.crossunder(accel, 0)
jerkCrossUp    = ta.crossover(jerk, 0)
jerkCrossDn    = ta.crossunder(jerk, 0)

turnUp = slopeCrossUp or accelCrossUpT
turnDn = slopeCrossDn or accelCrossDnT
histUp = hist > hist[1]
histDn = hist < hist[1]

emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
[dip, dim, adxV] = ta.dmi(adxLen, adxLen)
trendBull = (not useEMA or emaF > emaS) and (not useADX or adxV > adxTh)
trendBear = (not useEMA or emaF < emaS) and (not useADX or adxV > adxTh)
rangeMode = not trendBull and not trendBear

basis = ta.sma(close, bbLen)
dev   = ta.stdev(close, bbLen) * bbMult
bbU   = basis + dev
bbL   = basis - dev
kcM   = ta.ema(close, kcLen)
kcR   = ta.ema(ta.tr(true), kcLen) * kcMult
kcU   = kcM + kcR
kcL   = kcM - kcR
squeezeOn      = bbU < kcU and bbL > kcL
squeezeRelease = squeezeOn[1] and not squeezeOn

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §15A 🔬 FOOTPRINT ENGINE — DATA EXTRACTION + MTF ACCUMULATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// request.footprint() MUST be at global scope. Returns na on non-Premium.
// HTF delta is ACCUMULATED from chart-TF footprint for maximum accuracy.
// This is the ONLY correct way — HTF bars aggregate and lose granularity.
// Building from LTF preserves every tick of order flow truth.

footprint reqFP = request.footprint(fpTickSize, fpVAPct)
bool fpAvailable = useFP and not na(reqFP)

// ── Bar-Level Metrics ──
float fpDelta    = na
float fpBuyVol   = na
float fpSellVol  = na
float fpTotalVol = na
float fpBSRatio  = na

// ── POC / Auction Levels ──
float pocMidPrice   = na
float pocUpperPrice  = na
float pocLowerPrice  = na
float pocBuyVolume   = na
float pocSellVolume  = na
float pocDelta       = na
float pocImbRatio    = na
float vahPrice       = na
float valPrice       = na

if fpAvailable
    fpDelta    := reqFP.delta()
    fpBuyVol   := reqFP.buy_volume()
    fpSellVol  := reqFP.sell_volume()
    fpTotalVol := reqFP.total_volume()
    fpBSRatio  := (nz(fpSellVol) != 0) ? nz(fpBuyVol) / fpSellVol : na

    volume_row _poc = reqFP.poc()
    if not na(_poc)
        pocUpperPrice  := _poc.up_price()
        pocLowerPrice  := _poc.down_price()
        pocMidPrice    := (_poc.up_price() + _poc.down_price()) / 2.0
        pocBuyVolume   := _poc.buy_volume()
        pocSellVolume  := _poc.sell_volume()
        pocDelta       := _poc.delta()
        float _pMin     = math.min(nz(pocBuyVolume), nz(pocSellVolume))
        pocImbRatio    := _pMin > 0 ? math.max(nz(pocBuyVolume), nz(pocSellVolume)) / _pMin : na

    volume_row _vah = reqFP.vah()
    if not na(_vah)
        vahPrice := _vah.up_price()

    volume_row _val = reqFP.val()
    if not na(_val)
        valPrice := _val.down_price()

// ── MTF DELTA ACCUMULATION (from chart-TF footprint) ──
// Dynamically compute # of chart bars per HTF period
int chartSec   = timeframe.in_seconds(timeframe.period)
int fpBars15   = chartSec > 0 ? math.max(1, math.round(float(timeframe.in_seconds(tf_15))  / float(chartSec))) : 3
int fpBars60   = chartSec > 0 ? math.max(1, math.round(float(timeframe.in_seconds(tf_60))  / float(chartSec))) : 12
int fpBars233  = chartSec > 0 ? math.max(1, math.round(float(timeframe.in_seconds(tf_233)) / float(chartSec))) : 47
int fpBars987  = chartSec > 0 ? math.max(1, math.round(float(timeframe.in_seconds(tf_987)) / float(chartSec))) : 197

// Rolling delta sums + buy/sell sums per HTF window (always compute for consistent ta.sma history)
float _fpD       = nz(fpDelta)
float _fpDSma15  = ta.sma(_fpD, fpBars15)
float _fpDSma60  = ta.sma(_fpD, fpBars60)
float _fpDSma233 = ta.sma(_fpD, fpBars233)
float _fpDSma987 = ta.sma(_fpD, fpBars987)

float fpDeltaSum15  = fpAvailable ? _fpDSma15  * fpBars15  : na
float fpDeltaSum60  = fpAvailable ? _fpDSma60  * fpBars60  : na
float fpDeltaSum233 = fpAvailable ? _fpDSma233 * fpBars233 : na
float fpDeltaSum987 = fpAvailable ? _fpDSma987 * fpBars987 : na

// Delta direction per HTF window
bool fpD15Bull  = not na(fpDeltaSum15)  and fpDeltaSum15  > 0
bool fpD60Bull  = not na(fpDeltaSum60)  and fpDeltaSum60  > 0
bool fpD233Bull = not na(fpDeltaSum233) and fpDeltaSum233 > 0
bool fpD987Bull = not na(fpDeltaSum987) and fpDeltaSum987 > 0

// MTF delta alignment score (-4 to +4, like execScore concept)
int fpMTFScore = 0
if fpAvailable and useFPMTF
    fpMTFScore += fpD15Bull  ? 1 : not na(fpDeltaSum15)  ? -1 : 0
    fpMTFScore += fpD60Bull  ? 1 : not na(fpDeltaSum60)  ? -1 : 0
    fpMTFScore += fpD233Bull ? 1 : not na(fpDeltaSum233) ? -1 : 0
    fpMTFScore += fpD987Bull ? 1 : not na(fpDeltaSum987) ? -1 : 0

bool fpMTFAlignLong  = fpMTFScore >= fpMTFAlignMin
bool fpMTFAlignShort = fpMTFScore <= -fpMTFAlignMin

// Delta trend (SMA of delta for divergence detection — always compute)
float _fpDeltaSMAraw   = ta.sma(_fpD, fpDivLen)
float fpDeltaSMA       = fpAvailable ? _fpDeltaSMAraw : na
float fpDeltaSMASlope  = (not na(fpDeltaSMA) and not na(fpDeltaSMA[1])) ? fpDeltaSMA - fpDeltaSMA[1] : na

// ── POC Migration ──
float pocMigration = (not na(pocMidPrice) and not na(pocMidPrice[1])) ? pocMidPrice - pocMidPrice[1] : 0.0
bool  pocRising    = pocMigration > 0
bool  pocFalling   = pocMigration < 0

bool priceAbovePOC = not na(pocMidPrice) ? close > pocMidPrice : true
bool priceBelowPOC = not na(pocMidPrice) ? close < pocMidPrice : true
bool priceAboveVAH = not na(vahPrice) ? close > vahPrice : false
bool priceBelowVAL = not na(valPrice) ? close < valPrice : false

// ── FOOTPRINT DELTA CONFIRMATION GATE ──
bool fpDeltaLongOK  = true
bool fpDeltaShortOK = true
if useFP and useFPDelta and fpAvailable and not na(fpDelta)
    if fpDeltaMode == "Direction"
        fpDeltaLongOK  := fpDelta > 0
        fpDeltaShortOK := fpDelta < 0
    else
        fpDeltaLongOK  := fpDelta > fpDeltaMinAbs
        fpDeltaShortOK := fpDelta < -fpDeltaMinAbs

// ── FOOTPRINT IMBALANCE DETECTION ──
bool fpBuyImbalance  = false
bool fpSellImbalance = false
if useFP and useFPImbalance and fpAvailable and not na(pocImbRatio)
    fpBuyImbalance  := (pocImbRatio >= fpImbRatio) and (nz(pocBuyVolume) > nz(pocSellVolume))
    fpSellImbalance := (pocImbRatio >= fpImbRatio) and (nz(pocSellVolume) > nz(pocBuyVolume))

bool fpImbEdgeBuy  = fpBuyImbalance  and not (fpBuyImbalance[1] == true)
bool fpImbEdgeSell = fpSellImbalance and not (fpSellImbalance[1] == true)

// ── FOOTPRINT DELTA vs SMI DIVERGENCE ──
bool fpDivBear = false
bool fpDivBull = false
if useFP and useFPDiv and fpAvailable and not na(fpDeltaSMASlope)
    // Bearish: SMI slope positive (momentum building) but delta trend declining (flow drying up)
    fpDivBear := (slope > 0.3) and (fpDeltaSMASlope < 0) and (nz(fpDeltaSMA) < nz(fpDeltaSMA[2])) and (smi > obDyn * 0.3)
    // Bullish: SMI in OS territory but delta trend improving (hidden demand)
    fpDivBull := (slope < -0.3) and (fpDeltaSMASlope > 0) and (nz(fpDeltaSMA) > nz(fpDeltaSMA[2])) and (smi < osDyn * 0.3)

bool fpDivBearEdge = fpDivBear and not (fpDivBear[1] == true)
bool fpDivBullEdge = fpDivBull and not (fpDivBull[1] == true)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §15B VOLUME CONVICTION LAYER (🔬 FOOTPRINT ENHANCED)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
volRaw    = nz(volume, 0)
volSma20  = ta.sma(volRaw, 20)
volSma50  = ta.sma(volRaw, 50)
volRatio  = volSma20 > 0 ? volRaw / volSma20 : 1.0

f1_raw    = useVolWeight ? clamp(volRatio * 20, 0, 40) : 20.0
volTrend  = volSma50 > 0 ? volSma20 / volSma50 : 1.0
f2_raw    = useVolWeight ? clamp((volTrend - 0.7) * 100, 0, 30) : 15.0
priceDir  = close > open ? 1 : close < open ? -1 : 0
smiDir    = smi > sig ? 1 : smi < sig ? -1 : 0
dirAlign  = priceDir == smiDir and priceDir != 0
f3_raw    = useVolWeight ? (dirAlign and volRatio > 1.2 ? 30.0 : dirAlign and volRatio > 0.8 ? 15.0 : 5.0) : 15.0

// 🔬 Footprint enhancement: replace bar-level proxy with actual buy/sell split when available
float f3_fp = f3_raw
if fpAvailable and useVolWeight and not na(fpBSRatio)
    // Actual delta direction confirmation is stronger than bar close direction
    fpDirAlign = (fpDelta > 0 and smiDir > 0) or (fpDelta < 0 and smiDir < 0)
    f3_fp := fpDirAlign and nz(fpBSRatio) > 1.3 ? 30.0 : fpDirAlign ? 20.0 : not na(fpDelta) and fpDelta == 0 ? 10.0 : 5.0

volConv      = clamp(f1_raw + f2_raw + f3_fp, 0, 100)
volConvLabel = volConv > 75 ? "HIGH" : volConv > 50 ? "GOOD" : volConv > 30 ? "LOW" : "WEAK"
volConvColor = volConv > 75 ? color.new(#00E676, 40) : volConv > 50 ? color.new(#69F0AE, 50) : volConv > 30 ? color.new(#FFB74D, 50) : color.new(#78909C, 50)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §16 MTF STACK
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[s5,   g5,   h5,   sl5]   = request.security(syminfo.tickerid, tf_5,   f_pack(kLen, dLen, sigLen, sigType), barmerge.gaps_off, barmerge.lookahead_off)
[s15,  g15,  h15,  sl15]  = request.security(syminfo.tickerid, tf_15,  f_pack(kLen, dLen, sigLen, sigType), barmerge.gaps_off, barmerge.lookahead_off)
[s30,  g30,  h30,  sl30]  = request.security(syminfo.tickerid, tf_30,  f_pack(kLen, dLen, sigLen, sigType), barmerge.gaps_off, barmerge.lookahead_off)
[s60,  g60,  h60,  sl60]  = request.security(syminfo.tickerid, tf_60,  f_pack(kLen, dLen, sigLen, sigType), barmerge.gaps_off, barmerge.lookahead_off)
[s233, g233, h233, sl233] = request.security(syminfo.tickerid, tf_233, f_pack(kLen, dLen, sigLen, sigType), barmerge.gaps_off, barmerge.lookahead_off)
[s987, g987, h987, sl987] = request.security(syminfo.tickerid, tf_987, f_pack(kLen, dLen, sigLen, sigType), barmerge.gaps_off, barmerge.lookahead_off)

st5   = f_state(s5,   g5,   h5,   sl5)
st15  = f_state(s15,  g15,  h15,  sl15)
st30  = f_state(s30,  g30,  h30,  sl30)
st60  = f_state(s60,  g60,  h60,  sl60)
st233 = f_state(s233, g233, h233, sl233)
st987 = f_state(s987, g987, h987, sl987)

hiBullOk  = (st233 > 0 and st987 > 0)
hiBearOk  = (st233 < 0 and st987 < 0)
hiOkLong  = not requireHighAgree or hiBullOk
hiOkShort = not requireHighAgree or hiBearOk

midOpposesLong  = (st15 < 0 and st30 < 0)
midOpposesShort = (st15 > 0 and st30 > 0)
midOkLong  = not useMidVeto or not midOpposesLong
midOkShort = not useMidVeto or not midOpposesShort

had5mPullbackForLong  = ta.lowest(h5, resetLookback) < 0
had5mPullbackForShort = ta.highest(h5, resetLookback) > 0
resetOkLong  = not require5mReset or had5mPullbackForLong
resetOkShort = not require5mReset or had5mPullbackForShort

w5 = 1, w15 = 2, w30 = 2, w60 = 3, w233 = 4, w987 = 4
execScore = w5*st5 + w15*st15 + w30*st30 + w60*st60 + w233*st233 + w987*st987
execBull  = execScore >= execThresh
execBear  = execScore <= -execThresh

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §17 CROSS-TF DECELERATION SCORE (🔬 FP Delta Decel Added)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bullDecelCount = 0
bearDecelCount = 0

bullDecelCount += (sl5  > 0 and sl5  < nz(sl5[1]))  ? 1 : 0
bullDecelCount += (sl15 > 0 and sl15 < nz(sl15[1])) ? 1 : 0
bullDecelCount += (sl30 > 0 and sl30 < nz(sl30[1])) ? 1 : 0
bullDecelCount += (sl60 > 0 and sl60 < nz(sl60[1])) ? 1 : 0
bullDecelCount += (sl233> 0 and sl233< nz(sl233[1]))? 1 : 0
bullDecelCount += (sl987> 0 and sl987< nz(sl987[1]))? 1 : 0

bearDecelCount += (sl5  < 0 and sl5  > nz(sl5[1]))  ? 1 : 0
bearDecelCount += (sl15 < 0 and sl15 > nz(sl15[1])) ? 1 : 0
bearDecelCount += (sl30 < 0 and sl30 > nz(sl30[1])) ? 1 : 0
bearDecelCount += (sl60 < 0 and sl60 > nz(sl60[1])) ? 1 : 0
bearDecelCount += (sl233< 0 and sl233> nz(sl233[1]))? 1 : 0
bearDecelCount += (sl987< 0 and sl987> nz(sl987[1]))? 1 : 0

crossTFDecelBull = useCrossTFDiv ? bullDecelCount : 0
crossTFDecelBear = useCrossTFDiv ? bearDecelCount : 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §18 TRAP / FAILED AUCTION DETECTION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var bool  wasBullPierce = false
var int   bullPierceBar = na
var float bullPierceHi  = na
var bool  wasBearPierce = false
var int   bearPierceBar = na
var float bearPierceLo  = na

trapBull = false
trapBear = false

if useTrap
    if smi > obDyn and not wasBullPierce
        wasBullPierce := true
        bullPierceBar := bar_index
        bullPierceHi  := high
    if wasBullPierce
        bullPierceHi := math.max(bullPierceHi, high)
        barsInPierce = bar_index - bullPierceBar
        priceMoved   = nz(bullPierceHi) - close
        atrThreshold = atrVal * trapPriceATR
        if smi < obDyn and barsInPierce <= trapBars
            if priceMoved < atrThreshold or close < nz(bullPierceHi) - atrThreshold
                trapBear := true
            wasBullPierce := false
        else if barsInPierce > trapBars
            wasBullPierce := false
    if smi < osDyn and not wasBearPierce
        wasBearPierce := true
        bearPierceBar := bar_index
        bearPierceLo  := low
    if wasBearPierce
        bearPierceLo := math.min(bearPierceLo, low)
        barsInPierce = bar_index - bearPierceBar
        priceMoved   = close - nz(bearPierceLo)
        atrThreshold = atrVal * trapPriceATR
        if smi > osDyn and barsInPierce <= trapBars
            if priceMoved < atrThreshold or close > nz(bearPierceLo) + atrThreshold
                trapBull := true
            wasBearPierce := false
        else if barsInPierce > trapBars
            wasBearPierce := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §19 FATIGUE + §20 ABSORPTION + §21 JERK
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int barsInOB = 0, var int barsInOS = 0
var float slopeAtOBEntry = na, var float slopeAtOSEntry = na

if smi > obDyn
    barsInOB += 1
    if barsInOB == 1
        slopeAtOBEntry := slope
else
    barsInOB := 0
    slopeAtOBEntry := na

if smi < osDyn
    barsInOS += 1
    if barsInOS == 1
        slopeAtOSEntry := slope
else
    barsInOS := 0
    slopeAtOSEntry := na

timeFatigueOB  = useFatigue ? clamp(barsInOB * 100.0 / fatigueDecayBars, 0, 100) : 0.0
slopeDecayOB   = useFatigue and not na(slopeAtOBEntry) and slopeAtOBEntry != 0 ? clamp((1.0 - slope / slopeAtOBEntry) * 100, 0, 100) : 0.0
fatigueOB      = useFatigue ? clamp((timeFatigueOB + slopeDecayOB) / 2.0, 0, 100) : 0.0

timeFatigueOS  = useFatigue ? clamp(barsInOS * 100.0 / fatigueDecayBars, 0, 100) : 0.0
slopeDecayOS   = useFatigue and not na(slopeAtOSEntry) and slopeAtOSEntry != 0 ? clamp((1.0 - math.abs(slope) / math.abs(slopeAtOSEntry)) * 100, 0, 100) : 0.0
fatigueOS      = useFatigue ? clamp((timeFatigueOS + slopeDecayOS) / 2.0, 0, 100) : 0.0

fatigueScore   = smi > obDyn ? fatigueOB : smi < osDyn ? fatigueOS : 0.0
isFatigued     = fatigueScore > 65

priceNewHi3 = high > ta.highest(high[1], 3)
priceNewLo3 = low  < ta.lowest(low[1], 3)
histCompressing = math.abs(hist) < math.abs(hist[1]) and math.abs(hist[1]) < math.abs(hist[2])
absorbBear = useAbsorption and priceNewHi3 and hist > 0 and histCompressing and smi > obDyn * 0.5
absorbBull = useAbsorption and priceNewLo3 and hist < 0 and histCompressing and smi < osDyn * 0.5

jerkBullSignal = useJerk and jerkCrossUp and smi < osDyn * 0.4
jerkBearSignal = useJerk and jerkCrossDn and smi > obDyn * 0.4

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §21B BAND TOUCH + VELOCITY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int lastOBTouchBar = na, var int lastOSTouchBar = na
var int obTouchCount = 0, var int osTouchCount = 0

if useBandTouch
    if not na(lastOBTouchBar) and (bar_index - lastOBTouchBar) > bandTouchWindow
        obTouchCount := 0
        lastOBTouchBar := na
    if not na(lastOSTouchBar) and (bar_index - lastOSTouchBar) > bandTouchWindow
        osTouchCount := 0
        lastOSTouchBar := na

obTouchNow = smi >= obDyn and smi[1] < obDyn
osTouchNow = smi <= osDyn and smi[1] > osDyn

if useBandTouch and obTouchNow
    okSpace = na(lastOBTouchBar) or (bar_index - lastOBTouchBar) >= bandTouchMinBars
    if okSpace
        obTouchCount += 1
        lastOBTouchBar := bar_index

if useBandTouch and osTouchNow
    okSpace = na(lastOSTouchBar) or (bar_index - lastOSTouchBar) >= bandTouchMinBars
    if okSpace
        osTouchCount += 1
        lastOSTouchBar := bar_index

bandTouchOB = useBandTouch ? obTouchCount : 0
bandTouchOS = useBandTouch ? osTouchCount : 0
bandTouchLabelOB = bandTouchOB == 1 ? "FRESH 1st" : bandTouchOB == 2 ? "2nd Touch" : bandTouchOB >= 3 ? "STALE " + str.tostring(bandTouchOB) + "x" : "—"
bandTouchLabelOS = bandTouchOS == 1 ? "FRESH 1st" : bandTouchOS == 2 ? "2nd Touch" : bandTouchOS >= 3 ? "STALE " + str.tostring(bandTouchOS) + "x" : "—"

smiChangeRate = (smi - smi[velocityWindow]) / velocityWindow
velocityAbs    = math.abs(smiChangeRate)
velocityLabel  = useVelocity ? (velocityAbs >= velocityFastTh ? "V-SPIKE" : velocityAbs >= (velocityFastTh + velocitySlowTh) / 2 ? "MODERATE" : velocityAbs >= velocitySlowTh ? "SLOW" : "CRAWL") : "OFF"
isFastArrival  = useVelocity and velocityAbs >= velocityFastTh
isSlowGrind    = useVelocity and velocityAbs < velocitySlowTh

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §21C HISTOGRAM PATTERN RECOGNITION ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var string histPatternName = "NONE"
var int    histPatternID   = 0
var int    histPatternDir  = 0
var int    lastPatternBar  = 0

histPatternName := "NONE"
histPatternID   := 0
histPatternDir  := 0

if useHistPatterns
    hAbs = math.abs(hist), hAbs1 = math.abs(hist[1]), hAbs2 = math.abs(hist[2])
    hAbs3 = math.abs(hist[3]), hAbs4 = math.abs(hist[4])
    hAbs5 = math.abs(nz(hist[5])), hAbs6 = math.abs(nz(hist[6])), hAbs7 = math.abs(nz(hist[7]))
    histPeak8 = ta.highest(hAbs, 8)
    cooldownOK = (bar_index - lastPatternBar) >= patCooldown
    magOK = hAbs >= patMinHistMag or hAbs1 >= patMinHistMag

    if cooldownOK and magOK
        compCount = 0
        if hAbs1 < hAbs2
            compCount += 1
        if hAbs2 < hAbs3
            compCount += 1
        if hAbs3 < hAbs4
            compCount += 1
        if hAbs4 < hAbs5
            compCount += 1
        if hAbs5 < hAbs6
            compCount += 1
        inExtreme = math.abs(smi) > dyn * 0.5
        expanding = hAbs > hAbs1 * slingExpMult and hAbs >= patMinHistMag
        isSlingshot = compCount >= slingMinComp and inExtreme and expanding

        sameSign4 = (hist > 0 and hist[1] > 0 and hist[2] > 0 and hist[3] > 0) or (hist < 0 and hist[1] < 0 and hist[2] < 0 and hist[3] < 0)
        chg0 = hAbs - hAbs1, chg1 = hAbs1 - hAbs2, chg2 = hAbs2 - hAbs3, chg3 = hAbs3 - hAbs4
        stairCount = 0
        if chg0 > 0
            stairCount += 1
        if chg1 > 0
            stairCount += 1
        if chg2 > 0
            stairCount += 1
        if chg3 > 0
            stairCount += 1
        orderly01 = chg1 != 0 ? math.abs(chg0 / chg1) : 0.0
        isOrderly = orderly01 >= 0.4 and orderly01 <= 2.5
        isStaircase = sameSign4 and stairCount >= stairMinBars and isOrderly and hAbs >= patMinHistMag

        dropRatio = hAbs1 > 0 ? hAbs / hAbs1 : 1.0
        isCliff = hAbs1 >= patMinHistMag and dropRatio < (1.0 - cliffDropPct / 100.0) and hAbs1 > histPeak8 * cliffMinPeak

        nearZeroFound = false, nearZeroBar = 0
        zeroPctThresh = hAbs * dblPumpZeroPct / 100.0
        for i = 3 to math.min(dblPumpWindow, 12)
            hAbsI = math.abs(nz(hist[i]))
            if hAbsI < zeroPctThresh and hAbsI < patMinHistMag * 0.5
                nearZeroFound := true
                nearZeroBar   := i
                break
        sameSignAsCurrent = (hist > 0 and nz(hist[3]) >= 0) or (hist < 0 and nz(hist[3]) <= 0)
        isDblPump = nearZeroFound and sameSignAsCurrent and hAbs > hAbs1 and hAbs >= patMinHistMag and hAbs > hAbs2

        divCompDeclineCount = 0
        if hAbs1 < hAbs2
            divCompDeclineCount += 1
        if hAbs2 < hAbs3
            divCompDeclineCount += 1
        if hAbs3 < hAbs4
            divCompDeclineCount += 1
        if hAbs4 < hAbs5
            divCompDeclineCount += 1
        isDivCompBear = priceNewHi3 and hist > 0 and divCompDeclineCount >= (divCompBars - 1) and hAbs2 >= patMinHistMag
        isDivCompBull = priceNewLo3 and hist < 0 and divCompDeclineCount >= (divCompBars - 1) and hAbs2 >= patMinHistMag

        if isSlingshot
            histPatternDir  := hist > 0 ? 1 : -1
            histPatternName := hist > 0 ? "SLINGSHOT ▲" : "SLINGSHOT ▼"
            histPatternID := 1
            lastPatternBar := bar_index
        else if isCliff
            histPatternDir  := hist[1] > 0 ? -1 : 1
            histPatternName := hist[1] > 0 ? "CLIFF ▼" : "CLIFF ▲"
            histPatternID := 3
            lastPatternBar := bar_index
        else if isDblPump
            histPatternDir  := hist > 0 ? 1 : -1
            histPatternName := hist > 0 ? "DBL PUMP ▲" : "DBL PUMP ▼"
            histPatternID := 4
            lastPatternBar := bar_index
        else if isStaircase
            histPatternDir  := hist > 0 ? 1 : -1
            histPatternName := hist > 0 ? "STAIRCASE ▲" : "STAIRCASE ▼"
            histPatternID := 2
            lastPatternBar := bar_index
        else if isDivCompBear or isDivCompBull
            histPatternDir  := isDivCompBull ? 1 : -1
            histPatternName := isDivCompBear ? "DIV·COMP ▼" : "DIV·COMP ▲"
            histPatternID := 5
            lastPatternBar := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §21E CURVE SHAPE MATCHING
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var string curveShapeName = "NONE"
var int    curveShapeID   = 0
var int    lastShapeBar   = 0

if useCurveShape
    curveShapeName := "NONE"
    curveShapeID   := 0
    shapeCooldownOK = (bar_index - lastShapeBar) >= shapeCooldown

    if shapeCooldownOK
        // W-BOTTOM
        wThreshold = osDyn * wMinTrough
        var float wT1V = na, var int wT1B = na, var float wT2V = na, var int wT2B = na
        wT1V := na, wT1B := na, wT2V := na, wT2B := na
        for lb = 3 to math.min(shapeLookback, bar_index)
            smiLB = smi[lb]
            if smiLB <= wThreshold and (na(wT1V) or smiLB < wT1V)
                wT1V := smiLB
                wT1B := lb
        if not na(wT1B)
            for lb = 3 to math.min(shapeLookback, bar_index)
                smiLB = smi[lb]
                barDist = math.abs(lb - wT1B)
                if smiLB <= wThreshold and barDist >= wMinBarsBtwn and barDist <= wMaxBarsBtwn
                    isLocalMin = smiLB <= nz(smi[lb - 1]) and smiLB <= nz(smi[lb + 1])
                    if isLocalMin and (na(wT2V) or smiLB < wT2V)
                        wT2V := smiLB
                        wT2B := lb
        if not na(wT1B) and not na(wT2B)
            earlyBar = math.max(wT1B, wT2B), lateBar = math.min(wT1B, wT2B)
            earlyVal = earlyBar == wT1B ? wT1V : wT2V, lateVal = lateBar == wT1B ? wT1V : wT2V
            midVal = (earlyVal + lateVal) / 2.0
            hasBounce = false
            for mb = lateBar + 1 to earlyBar - 1
                if mb > 0 and mb < bar_index and smi[mb] > midVal + math.abs(midVal) * 0.3
                    hasBounce := true
                    break
            higherLow = lateVal >= earlyVal - math.abs(earlyVal) * 0.15
            risingNow = smi > smi[1] and smi > smi[2] and lateBar <= 6
            if hasBounce and higherLow and risingNow
                curveShapeName := "W-BOTTOM"
                curveShapeID := 1
                lastShapeBar := bar_index

        // M-TOP
        if curveShapeID == 0
            mThreshold = obDyn * wMinTrough
            var float mP1V = na, var int mP1B = na, var float mP2V = na, var int mP2B = na
            mP1V := na, mP1B := na, mP2V := na, mP2B := na
            for lb = 3 to math.min(shapeLookback, bar_index)
                smiLB = smi[lb]
                if smiLB >= mThreshold and (na(mP1V) or smiLB > mP1V)
                    mP1V := smiLB
                    mP1B := lb
            if not na(mP1B)
                for lb = 3 to math.min(shapeLookback, bar_index)
                    smiLB = smi[lb]
                    barDist = math.abs(lb - mP1B)
                    if smiLB >= mThreshold and barDist >= wMinBarsBtwn and barDist <= wMaxBarsBtwn
                        isLocalMax = smiLB >= nz(smi[lb - 1]) and smiLB >= nz(smi[lb + 1])
                        if isLocalMax and (na(mP2V) or smiLB > mP2V)
                            mP2V := smiLB
                            mP2B := lb
            if not na(mP1B) and not na(mP2B)
                earlyBar = math.max(mP1B, mP2B), lateBar = math.min(mP1B, mP2B)
                earlyVal = earlyBar == mP1B ? mP1V : mP2V, lateVal = lateBar == mP1B ? mP1V : mP2V
                midVal = (earlyVal + lateVal) / 2.0
                hasDip = false
                for mb = lateBar + 1 to earlyBar - 1
                    if mb > 0 and mb < bar_index and smi[mb] < midVal - math.abs(midVal) * 0.3
                        hasDip := true
                        break
                lowerHigh = lateVal <= earlyVal + math.abs(earlyVal) * 0.15
                fallingNow = smi < smi[1] and smi < smi[2] and lateBar <= 6
                if hasDip and lowerHigh and fallingNow
                    curveShapeName := "M-TOP"
                    curveShapeID := 2
                    lastShapeBar := bar_index

        // V-SPIKE BULL
        if curveShapeID == 0
            vDepthBull = osDyn * vSpikeMinDepth
            wasDeepOS = false, deepBar = 0, deepVal = 0.0
            for lb = 1 to vSpikeMaxBars
                if smi[lb] <= vDepthBull
                    wasDeepOS := true
                    deepBar := lb
                    deepVal := smi[lb]
                    break
            if wasDeepOS
                snapSize = smi - deepVal
                minSnap  = math.abs(deepVal) * 0.3
                if snapSize >= minSnap and smi > smi[1]
                    curveShapeName := "V-SPIKE ▲"
                    curveShapeID := 3
                    lastShapeBar := bar_index

        // V-SPIKE BEAR
        if curveShapeID == 0
            vDepthBear = obDyn * vSpikeMinDepth
            wasDeepOB = false, deepBarB = 0, deepValB = 0.0
            for lb = 1 to vSpikeMaxBars
                if smi[lb] >= vDepthBear
                    wasDeepOB := true
                    deepBarB := lb
                    deepValB := smi[lb]
                    break
            if wasDeepOB
                snapSizeB = deepValB - smi
                minSnapB  = math.abs(deepValB) * 0.3
                if snapSizeB >= minSnapB and smi < smi[1]
                    curveShapeName := "V-SPIKE ▼"
                    curveShapeID := 4
                    lastShapeBar := bar_index

        // ROUNDING BOTTOM
        if curveShapeID == 0
            roundOSCount = 0
            for lb = 0 to roundMinBars
                if smi[lb] < osDyn * 0.5
                    roundOSCount += 1
            isRoundBot = roundOSCount >= roundMinBars
            slopeRising = slope > 0 and slope[1] <= 0 and slope[2] <= 0
            notSharp = math.abs(smi - smi[2]) < math.abs(osDyn) * 0.4
            if isRoundBot and slopeRising and notSharp
                curveShapeName := "ROUND ▲"
                curveShapeID := 5
                lastShapeBar := bar_index

        // ROUNDING TOP
        if curveShapeID == 0
            roundOBCount = 0
            for lb = 0 to roundMinBars
                if smi[lb] > obDyn * 0.5
                    roundOBCount += 1
            isRoundTop = roundOBCount >= roundMinBars
            slopeFalling = slope < 0 and slope[1] >= 0 and slope[2] >= 0
            notSharpT = math.abs(smi - smi[2]) < math.abs(obDyn) * 0.4
            if isRoundTop and slopeFalling and notSharpT
                curveShapeName := "ROUND ▼"
                curveShapeID := 6
                lastShapeBar := bar_index

shapeBull = curveShapeID == 1 or curveShapeID == 3 or curveShapeID == 5
shapeBear = curveShapeID == 2 or curveShapeID == 4 or curveShapeID == 6

bullDiv = false, bearDiv = false, hidBull = false, hidBear = false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §21D HEAT SCORE ENGINE (🔬 FOOTPRINT COMPONENTS INTEGRATED)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_heatScore(_isLong) =>
    heat = 0.0
    denom = 0.0

    // 1) Band Proximity
    denom += heatW_band
    if _isLong
        bandDepth = osDyn != 0 ? clamp(smi / osDyn, 0, 1.5) : 0.0
        heat += bandDepth * heatW_band
    else
        bandDepth = obDyn != 0 ? clamp(smi / obDyn, 0, 1.5) : 0.0
        heat += bandDepth * heatW_band

    // 2) Band Touch Freshness
    touchCount = _isLong ? bandTouchOS : bandTouchOB
    if touchCount > 0
        denom += heatW_bandTch
        touchBonus = touchCount == 1 ? 1.0 : touchCount == 2 ? 0.6 : 0.1
        heat += touchBonus * heatW_bandTch

    // 3) Velocity
    inZone = _isLong ? smi < osDyn * 0.3 : smi > obDyn * 0.3
    if inZone
        denom += heatW_velocity
        velBonus = isFastArrival ? 1.0 : isSlowGrind ? 0.15 : 0.4
        heat += velBonus * heatW_velocity

    // 4) Volume Conviction
    denom += heatW_volConv
    heat += clamp(volConv / 100.0, 0, 1) * heatW_volConv

    // 5) Cross-TF Deceleration
    denom += heatW_xtfDecel
    if _isLong
        heat += clamp(crossTFDecelBear / 6.0, 0, 1) * heatW_xtfDecel
    else
        heat += clamp(crossTFDecelBull / 6.0, 0, 1) * heatW_xtfDecel

    // 6) Session
    denom += heatW_session
    sessionBonus = isOpenDrive ? 1.0 : isPowerHour ? 0.9 : isMorning ? 0.7 : isAfternoon ? 0.5 : isMidday ? 0.3 : 0.1
    heat += sessionBonus * heatW_session

    // 7) Fatigue (conditional)
    if fatigueScore > 5
        denom += heatW_fatigue
        heat += clamp(fatigueScore / 100.0, 0, 1) * heatW_fatigue

    // 8) Trap (conditional)
    if _isLong and trapBull
        denom += heatW_trap
        heat += heatW_trap
    if not _isLong and trapBear
        denom += heatW_trap
        heat += heatW_trap

    // 9) Absorption (conditional)
    if _isLong and absorbBull
        denom += heatW_absorb
        heat += heatW_absorb
    if not _isLong and absorbBear
        denom += heatW_absorb
        heat += heatW_absorb

    // 10) Squeeze (conditional)
    if squeezeOn or squeezeRelease
        denom += heatW_squeeze
        sqzBonus = squeezeRelease ? 1.0 : 0.5
        heat += sqzBonus * heatW_squeeze

    // 11) Divergence (conditional)
    if _isLong and (bullDiv or hidBull)
        denom += heatW_diverg
        heat += heatW_diverg
    if not _isLong and (bearDiv or hidBear)
        denom += heatW_diverg
        heat += heatW_diverg

    // 12) Curve Shape (conditional)
    if _isLong and shapeBull
        denom += heatW_shape
        shapeBonus = curveShapeID == 1 ? 1.0 : curveShapeID == 3 ? 0.9 : 0.7
        heat += shapeBonus * heatW_shape
    if not _isLong and shapeBear
        denom += heatW_shape
        shapeBonus = curveShapeID == 2 ? 1.0 : curveShapeID == 4 ? 0.9 : 0.7
        heat += shapeBonus * heatW_shape

    // ═══ 🔬 FOOTPRINT COMPONENTS ═══

    // 13) FP Delta Direction Alignment
    if fpAvailable and not na(fpDelta)
        denom += heatW_fpDelta
        if _isLong and fpDelta > 0
            heat += heatW_fpDelta
        else if not _isLong and fpDelta < 0
            heat += heatW_fpDelta
        else
            heat += heatW_fpDelta * 0.1  // Wrong direction = near-zero

    // 14) FP POC Migration Alignment
    if fpAvailable and not na(pocMidPrice) and not na(pocMidPrice[1])
        denom += heatW_fpPOC
        if _isLong and pocRising
            heat += heatW_fpPOC
        else if not _isLong and pocFalling
            heat += heatW_fpPOC
        else
            heat += heatW_fpPOC * 0.2  // Stalled or wrong = low

    // 15) FP Imbalance at POC
    if fpAvailable and (fpBuyImbalance or fpSellImbalance)
        denom += heatW_fpImb
        if _isLong and fpBuyImbalance
            heat += heatW_fpImb   // Buy imbalance confirms long
        else if not _isLong and fpSellImbalance
            heat += heatW_fpImb   // Sell imbalance confirms short
        // Counter-direction imbalance = 0 points (actively bad)

    // 16) FP MTF Delta Alignment
    if fpAvailable and useFPMTF
        denom += heatW_fpMTF
        if _isLong
            heat += clamp(float(fpMTFScore) / 4.0, 0, 1) * heatW_fpMTF
        else
            heat += clamp(float(-fpMTFScore) / 4.0, 0, 1) * heatW_fpMTF

    denom > 0 ? clamp(heat / denom * 100, 0, 100) : 0.0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §22 A+ SIGNALS (🔬 FOOTPRINT DELTA GATE INTEGRATED)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
valleyZone = smi < osDyn * 0.5 or (smi < 0 and smi[1] < osDyn * 0.5) or (smi < osDyn * 0.8 and turnUp)
peakZone   = smi > obDyn * 0.5 or (smi > 0 and smi[1] > obDyn * 0.5) or (smi > obDyn * 0.8 and turnDn)

// 🔬 Footprint delta gate wired into valley/peak raw signals
rawValleyLong  = valleyZone and turnUp and histUp and hiOkLong and midOkLong and (not useSqueeze or not squeezeOn) and fpDeltaLongOK
rawPeakShort   = peakZone   and turnDn and histDn and hiOkShort and midOkShort and (not useSqueeze or not squeezeOn) and fpDeltaShortOK

rawPullbackLong  = trendBull and execBull and resetOkLong  and turnUp and histUp and smi < 0 and (not useSqueeze or squeezeRelease or not squeezeOn) and fpDeltaLongOK
rawPullbackShort = trendBear and execBear and resetOkShort and turnDn and histDn and smi > 0 and (not useSqueeze or squeezeRelease or not squeezeOn) and fpDeltaShortOK

rawLong  = (rawValleyLong  or rawPullbackLong)  and inRTH
rawShort = (rawPeakShort   or rawPullbackShort) and inRTH

isValleySig = rawValleyLong  and inRTH
isPeakSig   = rawPeakShort   and inRTH

var int lastLongBar  = na
var int lastShortBar = na
allowLong  = na(lastLongBar)  or (bar_index - lastLongBar)  > cooldownBars
allowShort = na(lastShortBar) or (bar_index - lastShortBar) > cooldownBars

aLong  = rawLong  and allowLong
aShort = rawShort and allowShort

if aLong
    lastLongBar := bar_index
if aShort
    lastShortBar := bar_index

earlyLong  = showEW and accelCrossUpT and smi < 0 and smi < (osDyn * 0.6)
earlyShort = showEW and accelCrossDnT and smi > 0 and smi > (obDyn * 0.6)

heatLong  = useHeatScore ? f_heatScore(true)  : 0.0
heatShort = useHeatScore ? f_heatScore(false) : 0.0

f_grade(_heat) =>
    _heat >= gradeAPlus ? "A+" : _heat >= gradeA ? "A" : _heat >= gradeBPlus ? "B+" : "B"

f_gradeColor(_heat) =>
    _heat >= gradeAPlus ? color.new(#FFD700, 0) : _heat >= gradeA ? color.new(#00E676, 0) : _heat >= gradeBPlus ? color.new(#26C6DA, 0) : color.new(#78909C, 0)

gradeLong  = useGrading ? f_grade(heatLong)  : "—"
gradeShort = useGrading ? f_grade(heatShort) : "—"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §22B BACKTEST ENGINE (🔬 FP CONTEXT VECTORS ADDED)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var array<int>    bt_bars     = array.new<int>()
var array<float>  bt_entry    = array.new<float>()
var array<int>    bt_dir      = array.new<int>()
var array<float>  bt_stop     = array.new<float>()
var array<float>  bt_atr      = array.new<float>()
var array<float>  bt_heat     = array.new<float>()
var array<int>    bt_session  = array.new<int>()
var array<int>    bt_gradeID  = array.new<int>()
var array<int>    bt_outcome  = array.new<int>()
var array<float>  bt_mae      = array.new<float>()
var array<float>  bt_mfe      = array.new<float>()
var array<int>    bt_exitBar  = array.new<int>()
var array<int>    bt_histPat  = array.new<int>()

var array<float>  ctx_smiNorm   = array.new<float>()
var array<float>  ctx_bandDepth = array.new<float>()
var array<float>  ctx_velocity  = array.new<float>()
var array<float>  ctx_fatigue   = array.new<float>()
var array<float>  ctx_volConv   = array.new<float>()
var array<float>  ctx_atrRatio  = array.new<float>()
var array<float>  ctx_sqzState  = array.new<float>()
var array<float>  ctx_sessNorm  = array.new<float>()
var array<float>  ctx_xtfDecel  = array.new<float>()
var array<float>  ctx_execNorm  = array.new<float>()
var array<int>    ctx_velType   = array.new<int>()
var array<int>    ctx_bandTch   = array.new<int>()
var array<int>    ctx_shapeID   = array.new<int>()
// 🔬 Footprint context vectors
var array<float>  ctx_fpDelta   = array.new<float>()
var array<int>    ctx_fpMTF     = array.new<int>()

var float bt_winRate = na, var float bt_avgR = na
var int bt_totalSigs = 0, var int bt_wins = 0, var int bt_losses = 0
var float bt_totalR  = 0.0

f_gradeToID(_heat) =>
    _heat >= gradeAPlus ? 4 : _heat >= gradeA ? 3 : _heat >= gradeBPlus ? 2 : 1

if useBacktest and (aLong or aShort)
    entryPrice = close
    direction  = aLong ? 1 : -1
    stopDist   = atrVal * btStopATRMult
    stopPrice  = aLong ? entryPrice - stopDist : entryPrice + stopDist
    sigHeat    = aLong ? heatLong : heatShort

    array.push(bt_bars, bar_index), array.push(bt_entry, entryPrice), array.push(bt_dir, direction)
    array.push(bt_stop, stopPrice), array.push(bt_atr, atrVal), array.push(bt_heat, sigHeat)
    array.push(bt_session, sessionID), array.push(bt_gradeID, f_gradeToID(sigHeat))
    array.push(bt_outcome, 0), array.push(bt_mae, 0.0), array.push(bt_mfe, 0.0)
    array.push(bt_exitBar, 0), array.push(bt_histPat, histPatternID)

    _bd = aLong ? (osDyn != 0 ? clamp(smi / osDyn, 0, 1.5) : 0.0) : (obDyn != 0 ? clamp(smi / obDyn, 0, 1.5) : 0.0)
    _sqz = squeezeRelease ? 1.0 : squeezeOn ? 0.5 : 0.0
    _decel = aLong ? clamp(crossTFDecelBear / 6.0, 0, 1) : clamp(crossTFDecelBull / 6.0, 0, 1)
    _vType = isFastArrival ? 3 : isSlowGrind ? 1 : velocityAbs > velocitySlowTh ? 2 : 0
    _bTch  = aLong ? bandTouchOS : bandTouchOB

    array.push(ctx_smiNorm, clamp((smi + 100.0) / 200.0, 0, 1))
    array.push(ctx_bandDepth, _bd), array.push(ctx_velocity, clamp(velocityAbs / 15.0, 0, 1))
    array.push(ctx_fatigue, clamp(fatigueScore / 100.0, 0, 1))
    array.push(ctx_volConv, clamp(volConv / 100.0, 0, 1))
    array.push(ctx_atrRatio, clamp(atrRatio / 3.0, 0, 1))
    array.push(ctx_sqzState, _sqz), array.push(ctx_sessNorm, clamp(float(sessionID) / 6.0, 0, 1))
    array.push(ctx_xtfDecel, _decel), array.push(ctx_execNorm, clamp((execScore + 32.0) / 64.0, 0, 1))
    array.push(ctx_velType, _vType), array.push(ctx_bandTch, _bTch), array.push(ctx_shapeID, curveShapeID)
    // 🔬 FP context
    array.push(ctx_fpDelta, fpAvailable and not na(fpDelta) ? clamp(nz(fpDelta) / 500.0, -1, 1) : 0.0)
    array.push(ctx_fpMTF, fpMTFScore)

    if array.size(bt_bars) > btTrackCount
        array.shift(bt_bars), array.shift(bt_entry), array.shift(bt_dir), array.shift(bt_stop)
        array.shift(bt_atr), array.shift(bt_heat), array.shift(bt_session), array.shift(bt_gradeID)
        array.shift(bt_outcome), array.shift(bt_mae), array.shift(bt_mfe), array.shift(bt_exitBar)
        array.shift(bt_histPat), array.shift(ctx_smiNorm), array.shift(ctx_bandDepth)
        array.shift(ctx_velocity), array.shift(ctx_fatigue), array.shift(ctx_volConv)
        array.shift(ctx_atrRatio), array.shift(ctx_sqzState), array.shift(ctx_sessNorm)
        array.shift(ctx_xtfDecel), array.shift(ctx_execNorm), array.shift(ctx_velType)
        array.shift(ctx_bandTch), array.shift(ctx_shapeID)
        array.shift(ctx_fpDelta), array.shift(ctx_fpMTF)

// Position updates (same logic as original)
if useBacktest and array.size(bt_bars) > 0
    sz = array.size(bt_bars)
    for i = 0 to sz - 1
        if i < array.size(bt_outcome) and array.get(bt_outcome, i) == 0
            eBar = array.get(bt_bars, i), ePrice = array.get(bt_entry, i)
            eDir = array.get(bt_dir, i), eATR = array.get(bt_atr, i)
            stopDist = eATR * btStopATRMult
            bestPrice = eDir == 1 ? high : low, worstPrice = eDir == 1 ? low : high
            bestR = stopDist > 0 ? (bestPrice - ePrice) * eDir / stopDist : 0.0
            worstR = stopDist > 0 ? (worstPrice - ePrice) * eDir / stopDist : 0.0
            array.set(bt_mae, i, math.min(array.get(bt_mae, i), worstR))
            array.set(bt_mfe, i, math.max(array.get(bt_mfe, i), bestR))
            updatedMFE = array.get(bt_mfe, i)
            barsHeld = bar_index - eBar
            stoppedThisBar = worstR <= -1.0
            hit3R = bestR >= btRTarget3, hit2R = bestR >= btRTarget2, hit1R = bestR >= btRTarget1
            if hit3R
                array.set(bt_outcome, i, 3), array.set(bt_exitBar, i, bar_index)
            else if stoppedThisBar
                if updatedMFE >= btRTarget2
                    array.set(bt_outcome, i, 2)
                else if updatedMFE >= btRTarget1
                    array.set(bt_outcome, i, 1)
                else
                    array.set(bt_outcome, i, -1)
                array.set(bt_exitBar, i, bar_index)
            else if barsHeld >= btMaxBarsHold
                if updatedMFE >= btRTarget2
                    array.set(bt_outcome, i, 2)
                else if updatedMFE >= btRTarget1
                    array.set(bt_outcome, i, 1)
                else if updatedMFE > 0
                    array.set(bt_outcome, i, 1)
                else
                    array.set(bt_outcome, i, -2)
                array.set(bt_exitBar, i, bar_index)

if useBacktest and array.size(bt_outcome) > 0
    wins = 0, losses = 0, totalR = 0.0, closed = 0
    for i = 0 to array.size(bt_outcome) - 1
        oc = array.get(bt_outcome, i)
        if oc != 0
            closed += 1
            if oc == 3
                wins += 1, totalR += btRTarget3
            else if oc == 2
                wins += 1, totalR += btRTarget2
            else if oc == 1
                wins += 1, totalR += btRTarget1
            else
                losses += 1, totalR += -1.0
    bt_totalSigs := closed, bt_wins := wins, bt_losses := losses
    bt_totalR := totalR
    bt_winRate := closed > 0 ? (wins * 100.0 / closed) : na
    bt_avgR := closed > 0 ? totalR / closed : na

f_sessionWinRate(_sessID) =>
    w = 0, t = 0
    if useBacktest and array.size(bt_outcome) > 0
        for i = 0 to array.size(bt_outcome) - 1
            if array.get(bt_session, i) == _sessID and array.get(bt_outcome, i) != 0
                t += 1
                if array.get(bt_outcome, i) > 0
                    w += 1
    t > 0 ? w * 100.0 / t : na

f_gradeWinRate(_gID) =>
    w = 0, t = 0
    if useBacktest and array.size(bt_outcome) > 0
        for i = 0 to array.size(bt_outcome) - 1
            if array.get(bt_gradeID, i) == _gID and array.get(bt_outcome, i) != 0
                t += 1
                if array.get(bt_outcome, i) > 0
                    w += 1
    t > 0 ? w * 100.0 / t : na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §22C BAYESIAN CONFIDENCE ENGINE (🔬 FP FACTORS INCLUDED)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float bayesAdj     = 0.0
var string bayesDetail = ""

if useBayesian and useBacktest and bt_totalSigs >= bayesMinSample and barstate.islast
    baseWR = nz(bt_winRate, 50.0)
    adjustSum = 0.0
    factorCount = 0.0

    // Session factor
    sessW = 0, sessT = 0
    for i = 0 to array.size(bt_outcome) - 1
        if array.get(bt_outcome, i) != 0 and array.get(bt_session, i) == sessionID
            sessT += 1
            if array.get(bt_outcome, i) > 0
                sessW += 1
    sessFWR = sessT >= 3 ? sessW * 100.0 / sessT : na
    if not na(sessFWR)
        adjustSum += (sessFWR - baseWR) / 100.0 * math.min(sessT / 10.0, 1.0)
        factorCount += 1

    // Velocity factor
    curVType = isFastArrival ? 3 : isSlowGrind ? 1 : velocityAbs > velocitySlowTh ? 2 : 0
    velW = 0, velT = 0
    for i = 0 to array.size(bt_outcome) - 1
        if array.get(bt_outcome, i) != 0 and array.get(ctx_velType, i) == curVType
            velT += 1
            if array.get(bt_outcome, i) > 0
                velW += 1
    velFWR = velT >= 3 ? velW * 100.0 / velT : na
    if not na(velFWR)
        adjustSum += (velFWR - baseWR) / 100.0 * math.min(velT / 10.0, 1.0)
        factorCount += 1

    // Band Touch factor
    curBTch = smi < 0 ? bandTouchOS : smi > 0 ? bandTouchOB : 0
    btchW = 0, btchT = 0
    for i = 0 to array.size(bt_outcome) - 1
        if array.get(bt_outcome, i) != 0 and array.get(ctx_bandTch, i) == curBTch
            btchT += 1
            if array.get(bt_outcome, i) > 0
                btchW += 1
    btchFWR = btchT >= 3 ? btchW * 100.0 / btchT : na
    if not na(btchFWR) and curBTch > 0
        adjustSum += (btchFWR - baseWR) / 100.0 * math.min(btchT / 10.0, 1.0)
        factorCount += 1

    // Pattern factor
    patW = 0, patT = 0
    if histPatternID > 0
        for i = 0 to array.size(bt_outcome) - 1
            if array.get(bt_outcome, i) != 0 and array.get(bt_histPat, i) == histPatternID
                patT += 1
                if array.get(bt_outcome, i) > 0
                    patW += 1
    patFWR = patT >= 3 ? patW * 100.0 / patT : na
    if not na(patFWR)
        adjustSum += (patFWR - baseWR) / 100.0 * math.min(patT / 8.0, 1.0)
        factorCount += 1

    // Curve Shape factor
    shpW = 0, shpT = 0
    if curveShapeID > 0
        for i = 0 to array.size(bt_outcome) - 1
            if array.get(bt_outcome, i) != 0 and array.get(ctx_shapeID, i) == curveShapeID
                shpT += 1
                if array.get(bt_outcome, i) > 0
                    shpW += 1
    shpFWR = shpT >= 3 ? shpW * 100.0 / shpT : na
    if not na(shpFWR)
        adjustSum += (shpFWR - baseWR) / 100.0 * math.min(shpT / 8.0, 1.0)
        factorCount += 1

    // 🔬 FP MTF Alignment factor — WR when MTF delta was aligned at entry
    fpMW = 0, fpMT = 0
    if fpAvailable and useFPMTF and math.abs(fpMTFScore) >= 2
        for i = 0 to array.size(bt_outcome) - 1
            if array.get(bt_outcome, i) != 0
                entryMTF = array.get(ctx_fpMTF, i)
                matchDir = (fpMTFScore > 0 and entryMTF > 0) or (fpMTFScore < 0 and entryMTF < 0)
                if matchDir
                    fpMT += 1
                    if array.get(bt_outcome, i) > 0
                        fpMW += 1
    fpMFWR = fpMT >= 3 ? fpMW * 100.0 / fpMT : na
    if not na(fpMFWR)
        adjustSum += (fpMFWR - baseWR) / 100.0 * math.min(fpMT / 8.0, 1.0)
        factorCount += 1

    rawAdj = factorCount > 0 ? adjustSum / factorCount : 0.0
    bayesAdj := clamp(rawAdj, -bayesStrength, bayesStrength)

    bayesDetail := "── BAYESIAN FACTORS ──\n"
    bayesDetail += "Base WR: " + str.tostring(baseWR, "#.#") + "%\n"
    if not na(sessFWR)
        bayesDetail += "Session (" + sessionName + "): " + str.tostring(sessFWR, "#") + "% [n=" + str.tostring(sessT) + "]\n"
    if not na(velFWR)
        vLbl = curVType == 3 ? "V-SPIKE" : curVType == 2 ? "MOD" : curVType == 1 ? "SLOW" : "CRAWL"
        bayesDetail += "Velocity (" + vLbl + "): " + str.tostring(velFWR, "#") + "% [n=" + str.tostring(velT) + "]\n"
    if not na(btchFWR) and curBTch > 0
        bayesDetail += "BandTouch (" + str.tostring(curBTch) + "x): " + str.tostring(btchFWR, "#") + "% [n=" + str.tostring(btchT) + "]\n"
    if not na(patFWR)
        bayesDetail += "Pattern (" + histPatternName + "): " + str.tostring(patFWR, "#") + "% [n=" + str.tostring(patT) + "]\n"
    if not na(shpFWR)
        bayesDetail += "Shape (" + curveShapeName + "): " + str.tostring(shpFWR, "#") + "% [n=" + str.tostring(shpT) + "]\n"
    if not na(fpMFWR)
        bayesDetail += "🔬 FP MTF (" + str.tostring(fpMTFScore) + "/4): " + str.tostring(fpMFWR, "#") + "% [n=" + str.tostring(fpMT) + "]\n"
    bayesDetail += "Adjustment: " + (bayesAdj >= 0 ? "+" : "") + str.tostring(bayesAdj * 100, "#.#") + " pts\n"

bayesHeatAdj = useBayesian and bt_totalSigs >= bayesMinSample ? bayesAdj * 100.0 : 0.0
heatLongAdj  = clamp(heatLong + bayesHeatAdj, 0, 100)
heatShortAdj = clamp(heatShort + bayesHeatAdj, 0, 100)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §22D k-NN CONTEXT MATCHING (🔬 FP FEATURES IN DISTANCE)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float knnWinPct   = na
var float knnAvgR     = na
var string knnDetail  = ""
var int   knnMatches  = 0

if useKNN and useBacktest and bt_totalSigs >= knnMinClosed and barstate.islast
    isLongSide = smi < 0
    _curBD = isLongSide ? (osDyn != 0 ? clamp(smi / osDyn, 0, 1.5) : 0.0) : (obDyn != 0 ? clamp(smi / obDyn, 0, 1.5) : 0.0)
    curVec_smi     = clamp((smi + 100.0) / 200.0, 0, 1)
    curVec_band    = _curBD
    curVec_vel     = clamp(velocityAbs / 15.0, 0, 1)
    curVec_fat     = clamp(fatigueScore / 100.0, 0, 1)
    curVec_vol     = clamp(volConv / 100.0, 0, 1)
    curVec_atr     = clamp(atrRatio / 3.0, 0, 1)
    curVec_sqz     = squeezeRelease ? 1.0 : squeezeOn ? 0.5 : 0.0
    curVec_sess    = clamp(float(sessionID) / 6.0, 0, 1)
    curVec_decel   = isLongSide ? clamp(crossTFDecelBear / 6.0, 0, 1) : clamp(crossTFDecelBull / 6.0, 0, 1)
    curVec_exec    = clamp((execScore + 32.0) / 64.0, 0, 1)
    // 🔬 FP context features
    curVec_fpD     = fpAvailable and not na(fpDelta) ? clamp(nz(fpDelta) / 500.0, -1, 1) : 0.0
    curVec_fpMTF   = clamp(float(fpMTFScore) / 4.0, -1, 1)

    // Feature weights (band + velocity + FP most important for peak/valley)
    fw_smi = 1.0, fw_band = 2.0, fw_vel = 1.8, fw_fat = 1.2, fw_vol = 1.0
    fw_atr = 0.8, fw_sqz = 0.7, fw_sess = 0.6, fw_dec = 1.0, fw_exec = 0.5
    fw_fpD = 1.5, fw_fpM = 1.3  // 🔬 FP features get meaningful weight

    var array<float> knn_dist = array.new<float>()
    var array<int>   knn_idx  = array.new<int>()
    array.clear(knn_dist)
    array.clear(knn_idx)

    for i = 0 to array.size(bt_outcome) - 1
        if array.get(bt_outcome, i) != 0
            d_smi  = (curVec_smi  - array.get(ctx_smiNorm, i))   * fw_smi
            d_band = (curVec_band - array.get(ctx_bandDepth, i))  * fw_band
            d_vel  = (curVec_vel  - array.get(ctx_velocity, i))   * fw_vel
            d_fat  = (curVec_fat  - array.get(ctx_fatigue, i))    * fw_fat
            d_vol  = (curVec_vol  - array.get(ctx_volConv, i))    * fw_vol
            d_atr  = (curVec_atr  - array.get(ctx_atrRatio, i))   * fw_atr
            d_sqz  = (curVec_sqz  - array.get(ctx_sqzState, i))  * fw_sqz
            d_sess = (curVec_sess - array.get(ctx_sessNorm, i))   * fw_sess
            d_dec  = (curVec_decel- array.get(ctx_xtfDecel, i))   * fw_dec
            d_exec = (curVec_exec - array.get(ctx_execNorm, i))   * fw_exec
            // 🔬 FP distance components
            d_fpD  = (curVec_fpD  - array.get(ctx_fpDelta, i))   * fw_fpD
            d_fpM  = (curVec_fpMTF - float(array.get(ctx_fpMTF, i)) / 4.0) * fw_fpM

            dist = math.sqrt(d_smi*d_smi + d_band*d_band + d_vel*d_vel + d_fat*d_fat + d_vol*d_vol + d_atr*d_atr + d_sqz*d_sqz + d_sess*d_sess + d_dec*d_dec + d_exec*d_exec + d_fpD*d_fpD + d_fpM*d_fpM)
            array.push(knn_dist, dist)
            array.push(knn_idx, i)

    kTotal = array.size(knn_dist)
    kActual = math.min(knnK, kTotal)
    knnMatches := kActual

    if kActual >= 3
        for j = 0 to kActual - 1
            minPos = j
            minDist = array.get(knn_dist, j)
            for m = j + 1 to kTotal - 1
                if array.get(knn_dist, m) < minDist
                    minDist := array.get(knn_dist, m)
                    minPos := m
            if minPos != j
                tmpD = array.get(knn_dist, j)
                array.set(knn_dist, j, array.get(knn_dist, minPos))
                array.set(knn_dist, minPos, tmpD)
                tmpI = array.get(knn_idx, j)
                array.set(knn_idx, j, array.get(knn_idx, minPos))
                array.set(knn_idx, minPos, tmpI)

        kWins = 0
        kRSum = 0.0
        knnDetail := "── k-NN (k=" + str.tostring(kActual) + ", 12-feat incl FP) ──\n"
        for j = 0 to kActual - 1
            idx = array.get(knn_idx, j)
            oc  = array.get(bt_outcome, idx)
            dst = array.get(knn_dist, j)
            ht  = array.get(bt_heat, idx)
            isW = oc > 0
            if isW
                kWins += 1
            rVal = oc == 3 ? btRTarget3 : oc == 2 ? btRTarget2 : oc == 1 ? btRTarget1 : -1.0
            kRSum += rVal
            wl = isW ? "W" : "L"
            rLbl = oc == 3 ? "3R" : oc == 2 ? "2R" : oc == 1 ? "1R" : "Stop"
            knnDetail += "#" + str.tostring(j + 1) + " d=" + str.tostring(dst, "#.##") + " H:" + str.tostring(ht, "#") + " → " + wl + " (" + rLbl + ")\n"

        knnWinPct := kActual > 0 ? kWins * 100.0 / kActual : na
        knnAvgR   := kActual > 0 ? kRSum / kActual : na
        knnDetail += "Prediction: " + str.tostring(nz(knnWinPct, 0), "#") + "% WR | " + str.tostring(nz(knnAvgR, 0), "#.#") + "R\n"
    else
        knnDetail := "k-NN: Need more closed signals.\n"
        knnWinPct := na
        knnAvgR   := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §21E2 MOMENTUM REGIME CLASSIFICATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
slopeAccel   = math.abs(slope) > math.abs(slope[1]) and math.abs(slope[1]) > math.abs(slope[2])
histExpanding= math.abs(hist) > math.abs(hist[1]) and math.abs(hist[1]) > math.abs(hist[2])
histNarrow   = math.abs(hist) < dyn * 0.1

momRegime = squeezeRelease or (math.abs(jerk) > math.abs(nz(jerk[1])) * 2 and volRegime >= 1) ? "EXPLOSIVE" : isFatigued or (absorbBear or absorbBull) ? "EXHAUSTIVE" : slopeAccel and histExpanding ? "IMPULSIVE" : histNarrow and volRegime <= 0 ? "GRINDING" : "CORRECTIVE"
momRegimeColor = momRegime == "EXPLOSIVE" ? color.new(#FFD700, 0) : momRegime == "EXHAUSTIVE" ? color.new(#FF6E40, 0) : momRegime == "IMPULSIVE" ? color.new(#00E676, 0) : momRegime == "GRINDING" ? color.new(#78909C, 0) : color.new(#42A5F5, 0)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §23 BACKGROUND + SESSION LINES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
color bgColor = na
if showHistBG
    if hist > 0
        bgColor := color.new(#00E676, bgTransp)
    else if hist < 0
        bgColor := color.new(#FF1744, bgTransp)
bgcolor(bgColor)

rthOpen = nyMins >= 570 and nyMins[1] < 570 and nyMins[1] >= 0
ethOpen = nyMins >= 1080 and nyMins[1] < 1080
isRecentLine = bar_index > (last_bar_index - labelLookback)
tfAllowLines = timeframe.in_seconds(timeframe.period) <= 144 * 60  // Auto-hide session lines above 144m

if showRTHLine and rthOpen and isRecentLine and tfAllowLines
    line.new(bar_index, -1, bar_index, 1, color=color.new(#FFD54F, rthLineTransp), style=line.style_dotted, width=1, extend=extend.both)
if showETHLine and ethOpen and isRecentLine and tfAllowLines
    line.new(bar_index, -1, bar_index, 1, color=color.new(#42A5F5, ethLineTransp), style=line.style_dotted, width=1, extend=extend.both)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §24 DIVERGENCE ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float prevPL = na, var float prevSL = na, var int prevPL_bar = na
var float prevPH = na, var float prevSH = na, var int prevPH_bar = na

pl = ta.pivotlow(low, pivLen, pivLen)
ph = ta.pivothigh(high, pivLen, pivLen)

bullDiv := false, bearDiv := false, hidBull := false, hidBear := false

if showDiv and useDiv and not na(pl)
    thisPL = pl, thisSL = smi[pivLen], thisBar = bar_index - pivLen
    okSpacing = na(prevPL_bar) ? true : (thisBar - prevPL_bar) >= divMinBars
    inZone = thisSL < osDyn * 0.5
    if okSpacing and not na(prevPL) and not na(prevSL)
        bullDiv := (thisPL < prevPL) and (thisSL > prevSL) and (thisSL < 0) and inZone
        hidBull := (thisPL > prevPL) and (thisSL < prevSL) and (thisSL < 0) and inZone
    prevPL := thisPL, prevSL := thisSL, prevPL_bar := thisBar

if showDiv and useDiv and not na(ph)
    thisPH = ph, thisSH = smi[pivLen], thisBar = bar_index - pivLen
    okSpacing = na(prevPH_bar) ? true : (thisBar - prevPH_bar) >= divMinBars
    inZone = thisSH > obDyn * 0.5
    if okSpacing and not na(prevPH) and not na(prevSH)
        bearDiv := (thisPH > prevPH) and (thisSH < prevSH) and (thisSH > 0) and inZone
        hidBear := (thisPH < prevPH) and (thisSH > prevSH) and (thisSH > 0) and inZone
    prevPH := thisPH, prevSH := thisSH, prevPH_bar := thisBar

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §25 PLOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
histGrowing = hist > hist[1]
histAbs = math.abs(hist), histMax = ta.highest(histAbs, 50)
histStrength = histMax > 0 ? histAbs / histMax : 0.5
strAlpha = math.round(clamp(histTransp + (1.0 - histStrength) * 25, histTransp, 80))
dimAlpha = math.round(clamp(strAlpha + 15, 0, 95))

color histColor = hist >= 0 and histGrowing ? color.new(#00E676, strAlpha) : hist >= 0 ? color.new(#2E7D32, dimAlpha) : hist < 0 and not histGrowing ? color.new(#FF1744, strAlpha) : color.new(#B71C1C, dimAlpha)

plot(hist, "Histogram", style=plot.style_columns, color=histColor)
hline(0, "Zero", color=color.new(#546E7A, 70), linestyle=hline.style_dotted)
ob_line = hline(40, "Overbought", color=color.new(#78909C, 55), linestyle=hline.style_dashed)
os_line = hline(-40, "Oversold", color=color.new(#78909C, 55), linestyle=hline.style_dashed)
fill(ob_line, os_line, color=color.new(#42A5F5, 95), title="Neutral Zone")

smiPlot = plot(smi, "SMI_ref", color=color.new(color.white, 100), display=display.none)
midPlot = plot(0, "Zero_ref", color=color.new(color.white, 100), display=display.none)
fill(smiPlot, midPlot, 120, 40, top_color=color.new(#FF1744, 60), bottom_color=color.new(#FF1744, 100), title="OB Gradient")
fill(smiPlot, midPlot, -40, -120, top_color=color.new(#00E676, 100), bottom_color=color.new(#00E676, 60), title="OS Gradient")

slopeUp = slope > 0
color smiClr = useSlopeColor ? (slopeUp and smi > 40 ? color.new(#00E5FF, 0) : slopeUp ? color.new(#26C6DA, 15) : not slopeUp and smi < -40 ? color.new(#E040FB, 0) : color.new(#AB47BC, 15)) : (smi > 0 ? color.new(#26C6DA, 0) : color.new(#AB47BC, 0))

plot(smi, "SMI", color=smiClr, linewidth=2)
plot(sig, "Signal", color=color.new(#FFB74D, 25), linewidth=1)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §26 SIGNAL LABELS (🔬 FOOTPRINT TOOLTIPS)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
isRecent = bar_index > (last_bar_index - labelLookback) and (not onlySessionLabels or inRTH)

f_buildConfluence(_isLong) =>
    s = ""
    if _isLong
        s += (valleyZone ? "✓" : "✗") + " Valley Zone\n"
        s += (hiOkLong ? "✓" : "✗") + " 233+987 Agree\n"
        s += (midOkLong ? "✓" : "✗") + " Mid TF Clear\n"
        s += (turnUp ? "✓" : "✗") + " Turn Confirmed\n"
        s += (histUp ? "✓" : "✗") + " Hist Rising\n"
        s += (execBull ? "✓" : "●") + " ExecScore ≥ " + str.tostring(execThresh) + "\n"
        // 🔬 FP gates
        s += (fpDeltaLongOK ? "✓" : "✗") + " FP Delta (" + (fpAvailable and not na(fpDelta) ? str.tostring(fpDelta, format.volume) : "N/A") + ")\n"
    else
        s += (peakZone ? "✓" : "✗") + " Peak Zone\n"
        s += (hiOkShort ? "✓" : "✗") + " 233+987 Agree\n"
        s += (midOkShort ? "✓" : "✗") + " Mid TF Clear\n"
        s += (turnDn ? "✓" : "✗") + " Turn Confirmed\n"
        s += (histDn ? "✓" : "✗") + " Hist Falling\n"
        s += (execBear ? "✓" : "●") + " ExecScore ≤ -" + str.tostring(execThresh) + "\n"
        s += (fpDeltaShortOK ? "✓" : "✗") + " FP Delta (" + (fpAvailable and not na(fpDelta) ? str.tostring(fpDelta, format.volume) : "N/A") + ")\n"
    s

f_buildStatus() =>
    s = "SMI: " + str.tostring(smi, "#.#") + " | Sig: " + str.tostring(sig, "#.#") + "\n"
    s += "Hist: " + str.tostring(hist, "#.#") + " | Slope: " + str.tostring(slope, "#.##") + "\n"
    s += "ExecScore: " + str.tostring(execScore) + " | VolRegime: " + volRegLabel + "\n"
    s += "VolConviction: " + str.tostring(volConv, "#") + "% (" + volConvLabel + ")\n"
    s += "Fatigue: " + str.tostring(fatigueScore, "#") + "%" + (isFatigued ? " ⚠ EXHAUSTED" : "") + "\n"
    s += "Bands: +" + str.tostring(obDyn, "#.#") + " / " + str.tostring(osDyn, "#.#") + "\n"
    s += "X-TF Decel: Bull=" + str.tostring(crossTFDecelBull) + "/6  Bear=" + str.tostring(crossTFDecelBear) + "/6\n"
    s

// 🔬 Footprint status string for tooltips
f_fpStatus() =>
    s = ""
    if useFP
        if fpAvailable
            s += "━━━ 🔬 FOOTPRINT ━━━\n"
            s += "Delta: " + str.tostring(fpDelta, format.volume) + " " + (nz(fpDelta) > 0 ? "🟢 BUY" : nz(fpDelta) < 0 ? "🔴 SELL" : "⚖ FLAT") + "\n"
            s += "B/S: " + str.tostring(fpBSRatio, "#.##") + "x | Total: " + str.tostring(fpTotalVol, format.volume) + "\n"
            s += not na(pocMidPrice) ? "POC: " + str.tostring(pocMidPrice, format.mintick) + " " + (pocRising ? "↑" : pocFalling ? "↓" : "→") + "\n" : ""
            s += not na(vahPrice) ? "VAH: " + str.tostring(vahPrice, format.mintick) + " | VAL: " + str.tostring(valPrice, format.mintick) + "\n" : ""
            s += not na(pocMidPrice) ? "Price vs POC: " + (priceAbovePOC ? "PREMIUM" : "DISCOUNT") + "\n" : ""
            s += (fpBuyImbalance or fpSellImbalance) ? "⚡ IMB: " + (fpBuyImbalance ? "BUY" : "SELL") + " " + str.tostring(pocImbRatio, "#.#") + "x at POC\n" : ""
            s += "MTF Δ: 15m=" + (fpD15Bull ? "+" : "-") + " 60m=" + (fpD60Bull ? "+" : "-") + " 233m=" + (fpD233Bull ? "+" : "-") + " 987m=" + (fpD987Bull ? "+" : "-") + " [" + str.tostring(fpMTFScore) + "/4]\n"
        else
            s += "🔬 FP: No data (Premium req)\n"
    s

f_buildIntel(_isLong) =>
    s = "━━━ 🧠 INTELLIGENCE ━━━\n"
    h = _isLong ? heatLongAdj : heatShortAdj
    s += "🔥 Heat: " + str.tostring(h, "#.#") + "/100 → " + f_grade(h) + "\n"
    if useBayesian and bayesHeatAdj != 0
        s += "   Bayes adj: " + (bayesHeatAdj >= 0 ? "+" : "") + str.tostring(bayesHeatAdj, "#.#") + " pts\n"
    if useBandTouch
        s += "📊 Touch: " + (_isLong ? bandTouchLabelOS : bandTouchLabelOB) + "\n"
    if useVelocity
        s += "⚡ Velocity: " + velocityLabel + "\n"
    if useHistPatterns and histPatternID > 0
        s += "🔬 Pattern: " + histPatternName + "\n"
    if useCurveShape and curveShapeID > 0
        s += "📐 Shape: " + curveShapeName + "\n"
    s += "💫 Regime: " + momRegime + "\n"
    if useKNN and not na(knnWinPct)
        s += "━━━ 🔍 k-NN MATCH ━━━\n"
        s += str.tostring(knnMatches) + " similar: " + str.tostring(knnWinPct, "#") + "% WR | " + str.tostring(nz(knnAvgR, 0), "#.#") + "R\n"
    if useBacktest and not na(bt_winRate) and bt_totalSigs > 3
        s += "📈 WR: " + str.tostring(bt_winRate, "#.#") + "% (" + str.tostring(bt_wins) + "W/" + str.tostring(bt_losses) + "L) | Avg: " + str.tostring(bt_avgR, "#.#") + "R\n"
        sessWR = f_sessionWinRate(sessionID)
        if not na(sessWR)
            s += "This Session WR: " + str.tostring(sessWR, "#.#") + "%\n"
    s += f_fpStatus()
    s

f_confluenceCount(_isLong) =>
    c = 0
    if _isLong
        c += valleyZone ? 1 : 0, c += hiOkLong ? 1 : 0, c += midOkLong ? 1 : 0
        c += turnUp ? 1 : 0, c += histUp ? 1 : 0, c += execBull ? 1 : 0
        c += fpDeltaLongOK ? 1 : 0   // 🔬 7th gate
    else
        c += peakZone ? 1 : 0, c += hiOkShort ? 1 : 0, c += midOkShort ? 1 : 0
        c += turnDn ? 1 : 0, c += histDn ? 1 : 0, c += execBear ? 1 : 0
        c += fpDeltaShortOK ? 1 : 0
    c

// ── A+ LONG LABEL ──
if showAPlus and aLong and isRecent
    conf = f_confluenceCount(true), hv = heatLongAdj
    tip  = "═══ " + f_grade(hv) + " LONG ═══\n🔥 Heat: " + str.tostring(hv, "#.#") + "/100\n"
    tip += "Confluence: " + str.tostring(conf) + "/7\n━━━ CHECKLIST ━━━\n"
    tip += f_buildConfluence(true) + "━━━ CONTEXT ━━━\n" + f_buildStatus()
    tip += "Session: " + sessionName + "\n" + sessionBias + "\n"
    tip += f_buildIntel(true) + "━━━ EXECUTION ━━━\n"
    tip += "PLAY: " + (isValleySig ? "Valley reversal" : "Trend pullback") + "\n"
    tip += "STOP: " + str.tostring(close - atrVal * btStopATRMult, "#.##") + "\n"
    tip += "T1: " + str.tostring(close + atrVal * btStopATRMult * btRTarget1, "#.##") + " | T2: " + str.tostring(close + atrVal * btStopATRMult * btRTarget2, "#.##") + "\n"
    lblSize = hv >= gradeAPlus ? size.normal : hv >= gradeA ? size.small : size.tiny
    label.new(bar_index, smi - dyn * 0.12, hv >= gradeAPlus ? "▲ A+" : hv >= gradeA ? "▲ A" : hv >= gradeBPlus ? "▲ B+" : "▲ B", style=label.style_none, textcolor=f_gradeColor(hv), size=lblSize, tooltip=tip)

// ── A+ SHORT LABEL ──
if showAPlus and aShort and isRecent
    conf = f_confluenceCount(false), hv = heatShortAdj
    tip  = "═══ " + f_grade(hv) + " SHORT ═══\n🔥 Heat: " + str.tostring(hv, "#.#") + "/100\n"
    tip += "Confluence: " + str.tostring(conf) + "/7\n━━━ CHECKLIST ━━━\n"
    tip += f_buildConfluence(false) + "━━━ CONTEXT ━━━\n" + f_buildStatus()
    tip += "Session: " + sessionName + "\n" + sessionBias + "\n"
    tip += f_buildIntel(false) + "━━━ EXECUTION ━━━\n"
    tip += "PLAY: " + (isPeakSig ? "Peak reversal" : "Trend pullback") + "\n"
    tip += "STOP: " + str.tostring(close + atrVal * btStopATRMult, "#.##") + "\n"
    tip += "T1: " + str.tostring(close - atrVal * btStopATRMult * btRTarget1, "#.##") + " | T2: " + str.tostring(close - atrVal * btStopATRMult * btRTarget2, "#.##") + "\n"
    lblSize = hv >= gradeAPlus ? size.normal : hv >= gradeA ? size.small : size.tiny
    label.new(bar_index, smi + dyn * 0.12, hv >= gradeAPlus ? "▼ A+" : hv >= gradeA ? "▼ A" : hv >= gradeBPlus ? "▼ B+" : "▼ B", style=label.style_none, textcolor=f_gradeColor(hv), size=lblSize, tooltip=tip)

// ── Pattern/Shape/Trap/Absorption/Squeeze/Div labels (ENHANCED directional tooltips for hist patterns) ──
if useHistPatterns and histPatternID > 0 and isRecent and (mode == "Normal" or mode == "Debug")
    patDirStr  = histPatternDir > 0 ? "🟢 BULLISH" : "🔴 BEARISH"
    patExplain = ""
    if histPatternID == 1
        patExplain := patDirStr + " CONTINUATION\n"
        patExplain += "Histogram compressed at extreme then expanded.\n"
        patExplain += "Energy coiled in a spring — now releasing.\n"
        patExplain += "Institutions loaded during compression, now driving.\n"
        patExplain += "ACTION: Trade WITH the expansion. Don't fade this.\n"
    else if histPatternID == 2
        patExplain := patDirStr + " TREND CONVICTION\n"
        patExplain += "Orderly same-sign histogram growth 4+ bars.\n"
        patExplain += "Each bar larger than the last — clean institutional flow.\n"
        patExplain += "Absence of chaos = smart money in control.\n"
        patExplain += "ACTION: Ride the trend. This is NOT exhaustion.\n"
    else if histPatternID == 3
        patExplain := patDirStr + " REVERSAL WARNING\n"
        patExplain += "Histogram dropped " + str.tostring(cliffDropPct, "#") + "%+ from peak in ONE bar.\n"
        patExplain += "Dominant side just lost conviction instantly.\n"
        if histPatternDir > 0
            patExplain += "Sellers evaporated — watch for long entry.\n"
        else
            patExplain += "Buyers evaporated — watch for short entry.\n"
        patExplain += "ACTION: First sign of turn. Combine w/ band touch + fatigue.\n"
    else if histPatternID == 4
        patExplain := patDirStr + " CONTINUATION / RELOAD\n"
        patExplain += "Histogram pumped, faded near zero, pumped again same dir.\n"
        patExplain += "First wave paused → absorbed → institutions re-engaged.\n"
        patExplain += "Retail got shaken out on the fade. Smart money reloaded.\n"
        patExplain += "ACTION: Enter on 2nd pump. The pause WAS the pullback.\n"
    else if histPatternID == 5
        patExplain := patDirStr + " DIVERGENCE + COMPRESSION\n"
        if histPatternDir < 0
            patExplain += "Price making new highs but histogram declining.\n"
            patExplain += "Fade the high. Sellers loading behind the scenes.\n"
        else
            patExplain += "Price making new lows but histogram declining.\n"
            patExplain += "Fade the low. Buyers accumulating underneath.\n"
        patExplain += "Momentum dying while price extends — classic trap.\n"
        patExplain += "ACTION: The divergence IS the edge. Price lies, momentum tells truth.\n"

    patTip = "🔬 " + histPatternName + "\n━━━━━━━━━━━━━━━━━━━━\n" + patExplain + "━━━━━━━━━━━━━━━━━━━━\n" + f_buildStatus() + f_fpStatus()
    patClr = histPatternDir > 0 ? color.new(#00E676, 10) : color.new(#FF1744, 10)
    patIcon = histPatternDir > 0 ? "★▲" : "★▼"
    label.new(bar_index, hist, patIcon, style=label.style_none, textcolor=patClr, size=size.tiny, tooltip=patTip)

if useCurveShape and curveShapeID > 0 and isRecent and (mode == "Normal" or mode == "Debug")
    shpTip = "📐 " + curveShapeName + "\n" + f_buildStatus() + f_fpStatus()
    shpClr = curveShapeID == 1 ? color.new(#00E5FF, 5) : curveShapeID == 2 ? color.new(#FF4081, 5) : curveShapeID == 3 ? color.new(#76FF03, 5) : curveShapeID == 4 ? color.new(#FF6E40, 5) : curveShapeID == 5 ? color.new(#40C4FF, 15) : color.new(#FF80AB, 15)
    shpIcon = curveShapeID == 1 ? "◇W" : curveShapeID == 2 ? "◇M" : curveShapeID == 3 ? "◇V▲" : curveShapeID == 4 ? "◇V▼" : curveShapeID == 5 ? "◇R▲" : "◇R▼"
    shpY = shapeBull ? smi - dyn * 0.2 : smi + dyn * 0.2
    label.new(bar_index, shpY, shpIcon, style=label.style_none, textcolor=shpClr, size=size.tiny, tooltip=shpTip)

if useTrap and trapBull and isRecent
    label.new(bar_index, smi, "⚡", style=label.style_none, textcolor=color.new(#00BCD4, 0), size=size.small, tooltip="⚡ BULL TRAP\n" + f_buildStatus() + f_fpStatus())
if useTrap and trapBear and isRecent
    label.new(bar_index, smi, "⚡", style=label.style_none, textcolor=color.new(#E040FB, 0), size=size.small, tooltip="⚡ BEAR TRAP\n" + f_buildStatus() + f_fpStatus())

if absorbBear and isRecent
    label.new(bar_index, smi, "◈", style=label.style_none, textcolor=color.new(#CE93D8, 0), size=size.tiny, tooltip="◈ DISTRIBUTION\n" + f_buildStatus() + f_fpStatus())
if absorbBull and isRecent
    label.new(bar_index, smi, "◈", style=label.style_none, textcolor=color.new(#80CBC4, 0), size=size.tiny, tooltip="◈ ACCUMULATION\n" + f_buildStatus() + f_fpStatus())

if showSqz and useSqueeze and squeezeRelease and isRecent
    label.new(bar_index, smi, "◆", style=label.style_none, textcolor=color.new(#FFD54F, 0), size=size.tiny, tooltip="◆ SQUEEZE RELEASE\n" + f_buildStatus() + f_fpStatus())

if showDiv and bullDiv and isRecent
    label.new(bar_index - pivLen, smi[pivLen], "◆", style=label.style_none, textcolor=color.new(#00E676, 0), size=size.tiny, tooltip="◆ BULL DIV\n" + f_buildStatus() + f_fpStatus())
if showDiv and bearDiv and isRecent
    label.new(bar_index - pivLen, smi[pivLen], "◆", style=label.style_none, textcolor=color.new(#FF1744, 0), size=size.tiny, tooltip="◆ BEAR DIV\n" + f_buildStatus() + f_fpStatus())
if showDiv and hidBull and isRecent
    label.new(bar_index - pivLen, smi[pivLen], "◇", style=label.style_none, textcolor=color.new(#69F0AE, 25), size=size.tiny, tooltip="◇ HIDDEN BULL\n" + f_buildStatus())
if showDiv and hidBear and isRecent
    label.new(bar_index - pivLen, smi[pivLen], "◇", style=label.style_none, textcolor=color.new(#FF8A80, 25), size=size.tiny, tooltip="◇ HIDDEN BEAR\n" + f_buildStatus())

// 🔬 FOOTPRINT-SPECIFIC LABELS
if showFPImbLabels and fpImbEdgeBuy and isRecent
    label.new(bar_index, smi - dyn * 0.15, "🔋", style=label.style_none, textcolor=color.new(#00E676, 0), size=size.tiny, tooltip="⚡ BUY IMBALANCE at POC\nPOC: " + str.tostring(pocMidPrice, format.mintick) + "\nRatio: " + str.tostring(pocImbRatio, "#.#") + "x\n" + f_fpStatus())
if showFPImbLabels and fpImbEdgeSell and isRecent
    label.new(bar_index, smi + dyn * 0.15, "🔋", style=label.style_none, textcolor=color.new(#FF1744, 0), size=size.tiny, tooltip="⚡ SELL IMBALANCE at POC\nPOC: " + str.tostring(pocMidPrice, format.mintick) + "\nRatio: " + str.tostring(pocImbRatio, "#.#") + "x\n" + f_fpStatus())

if showFPDivLabels and fpDivBearEdge and isRecent
    label.new(bar_index, smi + dyn * 0.2, "🔬", style=label.style_none, textcolor=color.new(#FF6D00, 0), size=size.small, tooltip="🔬 BEARISH DELTA DIVERGENCE\nSMI rising but delta fading.\nTrend fuel drying up.\n" + f_fpStatus())
if showFPDivLabels and fpDivBullEdge and isRecent
    label.new(bar_index, smi - dyn * 0.2, "🔬", style=label.style_none, textcolor=color.new(#00E5FF, 0), size=size.small, tooltip="🔬 BULLISH DELTA DIVERGENCE\nSMI falling but delta improving.\nHidden demand building.\n" + f_fpStatus())

// Debug labels
if showAdvSig and jerkBullSignal and isRecent
    label.new(bar_index, smi, "●", style=label.style_none, textcolor=color.new(#A5D6A7, 40), size=size.tiny, tooltip="JERK Bull\n" + f_buildStatus())
if showAdvSig and jerkBearSignal and isRecent
    label.new(bar_index, smi, "●", style=label.style_none, textcolor=color.new(#EF9A9A, 40), size=size.tiny, tooltip="JERK Bear\n" + f_buildStatus())

fatigueJustTripped = isFatigued and not (fatigueScore[1] > 65)
if showExhaust and useFatigue and fatigueJustTripped and isRecent
    label.new(bar_index, smi, "⚠", style=label.style_none, textcolor=color.new(#FFD54F, 10), size=size.tiny, tooltip="⚠ FATIGUE " + str.tostring(fatigueScore, "#") + "%\n" + f_buildStatus() + f_fpStatus())

if showEW and earlyLong and isRecent
    label.new(bar_index, smi, "•", style=label.style_none, textcolor=color.new(#A5D6A7, 40), size=size.tiny, tooltip="EW LONG\n" + f_buildStatus())
if showEW and earlyShort and isRecent
    label.new(bar_index, smi, "•", style=label.style_none, textcolor=color.new(#EF9A9A, 40), size=size.tiny, tooltip="EW SHORT\n" + f_buildStatus())

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §27 HUD — Horizontal Command Strip (🔬 FP COLUMN ADDED)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
showDash = input.bool(true, "Show Intelligence HUD", group="📊 Dashboard")
dashPos  = input.string("Bottom Center", "HUD Position", options=["Bottom Center","Top Center","Top Right","Bottom Right"], group="📊 Dashboard")
dashPosVal = dashPos == "Bottom Center" ? position.bottom_center : dashPos == "Top Center" ? position.top_center : dashPos == "Top Right" ? position.top_right : position.bottom_right

color cDark = color.new(#0A0A1A, 100), color cDim = color.new(#546E7A, 0), color cLabel = color.new(#78909C, 0)

if showDash and barstate.islast
    // 🔬 Expanded to 12 columns (was 10) for FP Delta + FP MTF
    var table hud = table.new(dashPosVal, 12, 2, bgcolor=color.new(#0A0A1A, 100), border_color=color.new(#1A1A2E, 100), border_width=0, frame_color=color.new(#263238, 100), frame_width=0)

    heatDisplay = smi > obDyn * 0.3 ? heatShortAdj : smi < osDyn * 0.3 ? heatLongAdj : math.max(heatLongAdj, heatShortAdj)
    gradeDisplay = f_grade(heatDisplay)
    btLabel = smi > 0 ? bandTouchLabelOB : smi < 0 ? bandTouchLabelOS : "—"
    isFreshTouch = obTouchCount == 1 or osTouchCount == 1
    isStaleTouch = obTouchCount >= 3 or osTouchCount >= 3
    wrTxt = useBacktest and not na(bt_winRate) and bt_totalSigs > 3 ? str.tostring(bt_winRate, "#") + "%" : "—"
    arTxt = useBacktest and not na(bt_avgR) and bt_totalSigs > 3 ? str.tostring(bt_avgR, "#.#") + "R" : ""

    bool flashHeat = heatDisplay >= 65, bool flashRegime = momRegime == "EXPLOSIVE" or momRegime == "EXHAUSTIVE"
    bool flashBand = isFreshTouch, bool flashVeloc = isFastArrival, bool flashFatigue = isFatigued
    bool flashPat = histPatternID > 0 or curveShapeID > 0, bool flashVol = volConv > 75 or volConv < 25
    bool flashSess = isOpenDrive or isPowerHour
    bool flashBT = useBacktest and not na(bt_winRate) and bt_winRate >= 60 and bt_totalSigs > 5

    // ROW 0: LABELS
    table.cell(hud, 0, 0, "HEAT",    text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 1, 0, "REGIME",  text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 2, 0, "SMI",     text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 3, 0, "BAND",    text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 4, 0, "VELOC",   text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 5, 0, "FATIGUE", text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 6, 0, "PATTERN", text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 7, 0, "VOL",     text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 8, 0, "SESSION", text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 9, 0, "W/L",     text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 10, 0, "🔬 Δ",   text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)
    table.cell(hud, 11, 0, "🔬 MTF",  text_color=cLabel, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center)

    // ROW 1: VALUES
    // Col 0: HEAT
    heatClr = heatDisplay >= 75 ? color.new(#FFD700, 0) : heatDisplay >= 55 ? color.new(#00E676, 0) : heatDisplay >= 35 ? color.new(#26C6DA, 0) : cDim
    table.cell(hud, 0, 1, str.tostring(heatDisplay, "#") + " " + gradeDisplay, text_color=heatClr, text_size=size.tiny, bgcolor=flashHeat ? color.new(#FFD700, 92) : cDark, text_halign=text.align_center, tooltip="🔥 Heat: " + str.tostring(heatDisplay, "#") + "/100 [" + gradeDisplay + "]\nIncludes FP Delta + POC + Imbalance + MTF Delta.\n" + (useBayesian and str.length(bayesDetail) > 1 ? bayesDetail : "") + (useKNN and not na(knnWinPct) ? "k-NN: " + str.tostring(knnMatches) + " similar → " + str.tostring(knnWinPct, "#") + "% WR | " + str.tostring(nz(knnAvgR, 0), "#.#") + "R\n" : "") + f_fpStatus())

    // Col 1: REGIME
    table.cell(hud, 1, 1, momRegime, text_color=momRegimeColor, text_size=size.tiny, bgcolor=flashRegime ? color.new(#FFD700, 92) : cDark, text_halign=text.align_center, tooltip="Momentum: " + momRegime)

    // Col 2: SMI
    table.cell(hud, 2, 1, str.tostring(smi, "#.#") + (slope > 0 ? " ▲" : " ▼"), text_color=smiClr, text_size=size.tiny, bgcolor=cDark, text_halign=text.align_center, tooltip="SMI: " + str.tostring(smi, "#.#") + " Sig: " + str.tostring(sig, "#.#") + " Hist: " + str.tostring(hist, "#.##"))

    // Col 3: BAND
    btClr = isFreshTouch ? color.new(#00E676, 0) : isStaleTouch ? color.new(#FF6E40, 0) : cDim
    table.cell(hud, 3, 1, btLabel, text_color=btClr, text_size=size.tiny, bgcolor=flashBand ? color.new(#00E676, 92) : cDark, text_halign=text.align_center, tooltip="OB: " + str.tostring(obTouchCount) + "x | OS: " + str.tostring(osTouchCount) + "x")

    // Col 4: VELOCITY
    velClr = isFastArrival ? color.new(#FFD700, 0) : isSlowGrind ? color.new(#78909C, 0) : color.new(#42A5F5, 0)
    table.cell(hud, 4, 1, velocityLabel, text_color=velClr, text_size=size.tiny, bgcolor=flashVeloc ? color.new(#FFD700, 92) : cDark, text_halign=text.align_center, tooltip="Velocity: " + str.tostring(velocityAbs, "#.#") + " pts/bar")

    // Col 5: FATIGUE
    fatClr = isFatigued ? color.new(#FF6E40, 0) : fatigueScore > 30 ? color.new(#FFB74D, 0) : cDim
    table.cell(hud, 5, 1, str.tostring(fatigueScore, "#") + "%", text_color=fatClr, text_size=size.tiny, bgcolor=flashFatigue ? color.new(#FF6E40, 92) : cDark, text_halign=text.align_center, tooltip="Fatigue: " + str.tostring(fatigueScore, "#") + "% | OB:" + str.tostring(barsInOB) + " OS:" + str.tostring(barsInOS))

    // Col 6: PATTERN (ENHANCED: directional coloring)
    hasHistPat = histPatternID > 0, hasShape = curveShapeID > 0
    displayName = hasShape and hasHistPat ? curveShapeName + "+" : hasShape ? curveShapeName : hasHistPat ? histPatternName : "NONE"
    patClr = hasShape ? (shapeBull ? color.new(#00E5FF, 0) : color.new(#FF4081, 0)) : histPatternID > 0 ? (histPatternDir > 0 ? color.new(#00E676, 0) : color.new(#FF1744, 0)) : cDim
    table.cell(hud, 6, 1, displayName, text_color=patClr, text_size=size.tiny, bgcolor=flashPat ? color.new(#FFD700, 92) : cDark, text_halign=text.align_center, tooltip="Pattern: " + histPatternName + " | Shape: " + curveShapeName)

    // Col 7: VOL
    vClr = volConv > 75 ? color.new(#00E676, 0) : volConv > 50 ? color.new(#69F0AE, 0) : volConv < 25 ? color.new(#FF5252, 0) : cDim
    table.cell(hud, 7, 1, str.tostring(volConv, "#") + "%", text_color=vClr, text_size=size.tiny, bgcolor=flashVol ? color.new(#00E676, 92) : cDark, text_halign=text.align_center, tooltip="Vol Conviction: " + str.tostring(volConv, "#") + "% | Ratio: " + str.tostring(volRatio, "#.#") + "x\n" + (fpAvailable ? "🔬 FP-enhanced (actual buy/sell split)" : "Bar-level proxy"))

    // Col 8: SESSION
    sessClr = isOpenDrive ? color.new(#FFD700, 0) : isPowerHour ? color.new(#E040FB, 0) : isMorning ? color.new(#00E676, 0) : cDim
    table.cell(hud, 8, 1, sessionName, text_color=sessClr, text_size=size.tiny, bgcolor=flashSess ? color.new(#FFD700, 92) : cDark, text_halign=text.align_center, tooltip=sessionBias)

    // Col 9: W/L
    wrClr = useBacktest and not na(bt_winRate) ? (bt_winRate >= 60 ? color.new(#00E676, 0) : bt_winRate >= 45 ? color.new(#FFB74D, 0) : color.new(#FF5252, 0)) : cDim
    wrBTTip = "Signals: " + str.tostring(bt_totalSigs) + " | " + str.tostring(bt_wins) + "W/" + str.tostring(bt_losses) + "L"
    if useBacktest and bt_totalSigs > 3
        sessWR = f_sessionWinRate(sessionID)
        if not na(sessWR)
            wrBTTip += "\n" + sessionName + " WR: " + str.tostring(sessWR, "#") + "%"
        g4wr = f_gradeWinRate(4), g3wr = f_gradeWinRate(3)
        if not na(g4wr)
            wrBTTip += "\nA+ WR: " + str.tostring(g4wr, "#") + "%"
        if not na(g3wr)
            wrBTTip += "\nA WR: " + str.tostring(g3wr, "#") + "%"
    if useKNN and str.length(knnDetail) > 1
        wrBTTip += "\n" + knnDetail
    table.cell(hud, 9, 1, useBacktest and bt_totalSigs > 3 ? wrTxt + " " + arTxt : "...", text_color=wrClr, text_size=size.tiny, bgcolor=flashBT ? color.new(#00E676, 92) : cDark, text_halign=text.align_center, tooltip=wrBTTip)

    // 🔬 Col 10: FP DELTA
    fpDeltaStr = fpAvailable and not na(fpDelta) ? str.tostring(fpDelta, format.volume) : "N/A"
    fpDeltaClr = fpAvailable and not na(fpDelta) ? (nz(fpDelta) > 0 ? color.new(#00E676, 0) : nz(fpDelta) < 0 ? color.new(#FF1744, 0) : color.new(#FFC107, 0)) : cDim
    flashFPD = fpAvailable and not na(fpDelta) and math.abs(nz(fpDelta)) > 0
    fpDTip = fpAvailable ? "Delta: " + str.tostring(fpDelta, format.volume) + "\nBuy: " + str.tostring(fpBuyVol, format.volume) + " | Sell: " + str.tostring(fpSellVol, format.volume) + "\nB/S: " + str.tostring(fpBSRatio, "#.##") + "x\nPOC: " + (not na(pocMidPrice) ? str.tostring(pocMidPrice, format.mintick) + " " + (pocRising ? "↑" : pocFalling ? "↓" : "→") : "N/A") + "\n" + (fpBuyImbalance ? "⚡ BUY IMB " + str.tostring(pocImbRatio, "#.#") + "x" : fpSellImbalance ? "⚡ SELL IMB " + str.tostring(pocImbRatio, "#.#") + "x" : "No imbalance") : "Footprint requires Premium/Ultimate"
    table.cell(hud, 10, 1, fpDeltaStr, text_color=fpDeltaClr, text_size=size.tiny, bgcolor=flashFPD ? color.new(#00E676, 95) : cDark, text_halign=text.align_center, tooltip=fpDTip)

    // 🔬 Col 11: FP MTF ALIGNMENT
    fpMTFStr = fpAvailable and useFPMTF ? str.tostring(fpMTFScore) + "/4" : "N/A"
    fpMTFClr = fpMTFScore >= 3 ? color.new(#00E676, 0) : fpMTFScore <= -3 ? color.new(#FF1744, 0) : fpMTFScore >= 1 ? color.new(#69F0AE, 0) : fpMTFScore <= -1 ? color.new(#EF5350, 0) : cDim
    flashMTF = math.abs(fpMTFScore) >= 3
    mtfTip = "MTF Delta Alignment: " + str.tostring(fpMTFScore) + "/4\n"
    mtfTip += "15m Δ: " + (not na(fpDeltaSum15) ? str.tostring(fpDeltaSum15, format.volume) : "N/A") + " " + (fpD15Bull ? "🟢" : "🔴") + "\n"
    mtfTip += "60m Δ: " + (not na(fpDeltaSum60) ? str.tostring(fpDeltaSum60, format.volume) : "N/A") + " " + (fpD60Bull ? "🟢" : "🔴") + "\n"
    mtfTip += "233m Δ: " + (not na(fpDeltaSum233) ? str.tostring(fpDeltaSum233, format.volume) : "N/A") + " " + (fpD233Bull ? "🟢" : "🔴") + "\n"
    mtfTip += "987m Δ: " + (not na(fpDeltaSum987) ? str.tostring(fpDeltaSum987, format.volume) : "N/A") + " " + (fpD987Bull ? "🟢" : "🔴") + "\n"
    mtfTip += "Built from " + str.tostring(fpBars987) + " chart bars of granular LTF footprint.\nThis is the ONLY accurate way to compute HTF delta."
    table.cell(hud, 11, 1, fpMTFStr, text_color=fpMTFClr, text_size=size.tiny, bgcolor=flashMTF ? color.new(#FFD700, 92) : cDark, text_halign=text.align_center, tooltip=mtfTip)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  §28 ALERTS (🔬 FOOTPRINT ALERTS ADDED)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
alertcondition(aLong,          "Cobra A+ Long",        "🐍 A+ LONG — FP delta confirmed")
alertcondition(aShort,         "Cobra A+ Short",       "🐍 A+ SHORT — FP delta confirmed")
alertcondition(trapBull,       "Cobra Bull Trap",      "⚡ BULL TRAP — Failed bear auction")
alertcondition(trapBear,       "Cobra Bear Trap",      "⚡ BEAR TRAP — Failed bull auction")
alertcondition(squeezeRelease, "Cobra Squeeze Release", "◆ SQUEEZE RELEASE")
alertcondition(bullDiv,        "Cobra Bull Div",       "◆ BULL DIVERGENCE")
alertcondition(bearDiv,        "Cobra Bear Div",       "◆ BEAR DIVERGENCE")
alertcondition(histPatternID == 1, "Cobra Slingshot",  "🔬 SLINGSHOT")
alertcondition(histPatternID == 3, "Cobra Cliff",      "🔬 CLIFF")

// 🔬 Footprint-specific alerts
alertcondition(fpImbEdgeBuy,   "🔬 FP Buy Imbalance",    "🔬 BUY IMBALANCE at POC — institutional loading")
alertcondition(fpImbEdgeSell,  "🔬 FP Sell Imbalance",   "🔬 SELL IMBALANCE at POC — institutional distribution")
alertcondition(fpDivBearEdge,  "🔬 FP Bearish Delta Div", "🔬 BEARISH DELTA DIV — SMI rising but flow fading")
alertcondition(fpDivBullEdge,  "🔬 FP Bullish Delta Div", "🔬 BULLISH DELTA DIV — hidden demand under weakness")
alertcondition(fpMTFAlignLong, "🔬 FP MTF Delta Long",   "🔬 MTF DELTA ALIGNED LONG — multiple HTF windows bullish")
alertcondition(fpMTFAlignShort,"🔬 FP MTF Delta Short",  "🔬 MTF DELTA ALIGNED SHORT — multiple HTF windows bearish")

// End of BK AK-Cobra FP

