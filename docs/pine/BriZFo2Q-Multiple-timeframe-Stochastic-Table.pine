//@version=6
indicator("MTF Stochastic Table", overlay=true)

tablePosInput = input.string("top_right", "Table Position", options=["top_left", "top_right", "bottom_left", "bottom_right"])
txtSizeInput  = input.string("small", "Text Size", options=["tiny", "small", "normal"])
showBgColor   = input.bool(true, "Color Cells by OB/OS")
showHeader    = input.bool(true, "Show Header")

f_tablePos(pos) =>
    pos == "top_left" ? position.top_left :
     pos == "top_right" ? position.top_right :
     pos == "bottom_left" ? position.bottom_left :
     position.bottom_right

f_textSize(sz) =>
    sz == "tiny" ? size.tiny :
     sz == "small" ? size.small :
     size.normal

f_stoch(tf, lenK, smoothK, smoothD) =>
    k = request.security(syminfo.tickerid, tf, ta.sma(ta.stoch(close, high, low, lenK), smoothK))
    d = request.security(syminfo.tickerid, tf, ta.sma(ta.sma(ta.stoch(close, high, low, lenK), smoothK), smoothD))
    [k, d]

f_bg(v) =>
    not showBgColor ? color.new(color.white, 0) :
     v >= 80 ? color.new(color.red, 75) :
     v <= 20 ? color.new(color.lime, 75) :
     color.new(color.white, 0)

f_txt(v) =>
    color.black

f_tfBg() =>
    color.rgb(55, 55, 55)

f_hdBg() =>
    color.rgb(35, 35, 35)

f_fmt(v) =>
    str.tostring(v, "#.##")

var table t = table.new(f_tablePos(tablePosInput), 5, 9, border_width=1, frame_color=color.gray, border_color=color.gray)

[k_1_5,   d_1_5]   = f_stoch("1",   5, 3, 3)
[k_1_20,  d_1_20]  = f_stoch("1",   20, 3, 3)

[k_5_5,   d_5_5]   = f_stoch("5",   5, 3, 3)
[k_5_20,  d_5_20]  = f_stoch("5",   20, 3, 3)

[k_15_5,  d_15_5]  = f_stoch("15",  5, 3, 3)
[k_15_20, d_15_20] = f_stoch("15",  20, 3, 3)

[k_30_5,  d_30_5]  = f_stoch("30",  5, 3, 3)
[k_30_20, d_30_20] = f_stoch("30",  20, 3, 3)

[k_60_5,  d_60_5]  = f_stoch("60",  5, 3, 3)
[k_60_20, d_60_20] = f_stoch("60",  20, 3, 3)

[k_240_5, d_240_5] = f_stoch("240", 5, 3, 3)
[k_240_20,d_240_20]= f_stoch("240", 20, 3, 3)

[k_D_5,   d_D_5]   = f_stoch("D",   5, 3, 3)
[k_D_20,  d_D_20]  = f_stoch("D",   20, 3, 3)

[k_W_5,   d_W_5]   = f_stoch("W",   5, 3, 3)
[k_W_20,  d_W_20]  = f_stoch("W",   20, 3, 3)

if barstate.islast
    if showHeader
        table.cell(t, 0, 0, "TF", text_color=color.white, bgcolor=f_hdBg(), text_size=f_textSize(txtSizeInput))
        table.cell(t, 1, 0, "Stoch(5,3,3)\nMain", text_color=color.white, bgcolor=f_hdBg(), text_size=f_textSize(txtSizeInput))
        table.cell(t, 2, 0, "Stoch(5,3,3)\nSignal", text_color=color.white, bgcolor=f_hdBg(), text_size=f_textSize(txtSizeInput))
        table.cell(t, 3, 0, "Stoch(20,3,3)\nMain", text_color=color.white, bgcolor=f_hdBg(), text_size=f_textSize(txtSizeInput))
        table.cell(t, 4, 0, "Stoch(20,3,3)\nSignal", text_color=color.white, bgcolor=f_hdBg(), text_size=f_textSize(txtSizeInput))

    table.cell(t, 0, 1, "1 min", text_color=color.white, bgcolor=f_tfBg(), text_size=f_textSize(txtSizeInput))
    table.cell(t, 1, 1, f_fmt(k_1_5), text_color=f_txt(k_1_5), bgcolor=f_bg(k_1_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 2, 1, f_fmt(d_1_5), text_color=f_txt(d_1_5), bgcolor=f_bg(d_1_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 3, 1, f_fmt(k_1_20), text_color=f_txt(k_1_20), bgcolor=f_bg(k_1_20), text_size=f_textSize(txtSizeInput))
    table.cell(t, 4, 1, f_fmt(d_1_20), text_color=f_txt(d_1_20), bgcolor=f_bg(d_1_20), text_size=f_textSize(txtSizeInput))

    table.cell(t, 0, 2, "5 min", text_color=color.white, bgcolor=f_tfBg(), text_size=f_textSize(txtSizeInput))
    table.cell(t, 1, 2, f_fmt(k_5_5), text_color=f_txt(k_5_5), bgcolor=f_bg(k_5_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 2, 2, f_fmt(d_5_5), text_color=f_txt(d_5_5), bgcolor=f_bg(d_5_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 3, 2, f_fmt(k_5_20), text_color=f_txt(k_5_20), bgcolor=f_bg(k_5_20), text_size=f_textSize(txtSizeInput))
    table.cell(t, 4, 2, f_fmt(d_5_20), text_color=f_txt(d_5_20), bgcolor=f_bg(d_5_20), text_size=f_textSize(txtSizeInput))

    table.cell(t, 0, 3, "15 min", text_color=color.white, bgcolor=f_tfBg(), text_size=f_textSize(txtSizeInput))
    table.cell(t, 1, 3, f_fmt(k_15_5), text_color=f_txt(k_15_5), bgcolor=f_bg(k_15_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 2, 3, f_fmt(d_15_5), text_color=f_txt(d_15_5), bgcolor=f_bg(d_15_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 3, 3, f_fmt(k_15_20), text_color=f_txt(k_15_20), bgcolor=f_bg(k_15_20), text_size=f_textSize(txtSizeInput))
    table.cell(t, 4, 3, f_fmt(d_15_20), text_color=f_txt(d_15_20), bgcolor=f_bg(d_15_20), text_size=f_textSize(txtSizeInput))

    table.cell(t, 0, 4, "30 min", text_color=color.white, bgcolor=f_tfBg(), text_size=f_textSize(txtSizeInput))
    table.cell(t, 1, 4, f_fmt(k_30_5), text_color=f_txt(k_30_5), bgcolor=f_bg(k_30_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 2, 4, f_fmt(d_30_5), text_color=f_txt(d_30_5), bgcolor=f_bg(d_30_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 3, 4, f_fmt(k_30_20), text_color=f_txt(k_30_20), bgcolor=f_bg(k_30_20), text_size=f_textSize(txtSizeInput))
    table.cell(t, 4, 4, f_fmt(d_30_20), text_color=f_txt(d_30_20), bgcolor=f_bg(d_30_20), text_size=f_textSize(txtSizeInput))

    table.cell(t, 0, 5, "1 Hour", text_color=color.white, bgcolor=f_tfBg(), text_size=f_textSize(txtSizeInput))
    table.cell(t, 1, 5, f_fmt(k_60_5), text_color=f_txt(k_60_5), bgcolor=f_bg(k_60_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 2, 5, f_fmt(d_60_5), text_color=f_txt(d_60_5), bgcolor=f_bg(d_60_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 3, 5, f_fmt(k_60_20), text_color=f_txt(k_60_20), bgcolor=f_bg(k_60_20), text_size=f_textSize(txtSizeInput))
    table.cell(t, 4, 5, f_fmt(d_60_20), text_color=f_txt(d_60_20), bgcolor=f_bg(d_60_20), text_size=f_textSize(txtSizeInput))

    table.cell(t, 0, 6, "4 Hour", text_color=color.white, bgcolor=f_tfBg(), text_size=f_textSize(txtSizeInput))
    table.cell(t, 1, 6, f_fmt(k_240_5), text_color=f_txt(k_240_5), bgcolor=f_bg(k_240_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 2, 6, f_fmt(d_240_5), text_color=f_txt(d_240_5), bgcolor=f_bg(d_240_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 3, 6, f_fmt(k_240_20), text_color=f_txt(k_240_20), bgcolor=f_bg(k_240_20), text_size=f_textSize(txtSizeInput))
    table.cell(t, 4, 6, f_fmt(d_240_20), text_color=f_txt(d_240_20), bgcolor=f_bg(d_240_20), text_size=f_textSize(txtSizeInput))

    table.cell(t, 0, 7, "Daily", text_color=color.white, bgcolor=f_tfBg(), text_size=f_textSize(txtSizeInput))
    table.cell(t, 1, 7, f_fmt(k_D_5), text_color=f_txt(k_D_5), bgcolor=f_bg(k_D_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 2, 7, f_fmt(d_D_5), text_color=f_txt(d_D_5), bgcolor=f_bg(d_D_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 3, 7, f_fmt(k_D_20), text_color=f_txt(k_D_20), bgcolor=f_bg(k_D_20), text_size=f_textSize(txtSizeInput))
    table.cell(t, 4, 7, f_fmt(d_D_20), text_color=f_txt(d_D_20), bgcolor=f_bg(d_D_20), text_size=f_textSize(txtSizeInput))

    table.cell(t, 0, 8, "Weekly", text_color=color.white, bgcolor=f_tfBg(), text_size=f_textSize(txtSizeInput))
    table.cell(t, 1, 8, f_fmt(k_W_5), text_color=f_txt(k_W_5), bgcolor=f_bg(k_W_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 2, 8, f_fmt(d_W_5), text_color=f_txt(d_W_5), bgcolor=f_bg(d_W_5), text_size=f_textSize(txtSizeInput))
    table.cell(t, 3, 8, f_fmt(k_W_20), text_color=f_txt(k_W_20), bgcolor=f_bg(k_W_20), text_size=f_textSize(txtSizeInput))
    table.cell(t, 4, 8, f_fmt(d_W_20), text_color=f_txt(d_W_20), bgcolor=f_bg(d_W_20), text_size=f_textSize(txtSizeInput))