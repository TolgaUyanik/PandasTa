//@version=6
library("News2026H2", overlay=false)
import pking9999/NewsTypes/4 as nt

export f_loadNewsRows() =>
    string[] arrDateStr = array.new_string()
    int[] arrTimeMS = array.new_int()
    int[] arrTypeId = array.new_int()
// ────────────────
    // NEWS ROWS
    // ────────────────
    // ────────────────
    // CME HOLIDAY / EARLY-CLOSE OVERRIDES (hard enforced by main strategy)
    // ────────────────
    nt.f_addNews("2026-07-02", 1015, nt.TYPE_CME_Early_Close, arrDateStr, arrTimeMS, arrTypeId)  // 🟧 PATCH: Day before Independence Day
    nt.f_addNews("2026-07-03", 1, nt.TYPE_Bank_Holiday, arrDateStr, arrTimeMS, arrTypeId)  // 🟧 PATCH: Independence Day (observed) all-day day-session closed
    nt.f_addNews("2026-09-07", 1000, nt.TYPE_CME_Early_Close, arrDateStr, arrTimeMS, arrTypeId)  // 🟧 PATCH: Labor Day
    nt.f_addNews("2026-11-26", 1000, nt.TYPE_CME_Early_Close, arrDateStr, arrTimeMS, arrTypeId)  // 🟧 PATCH: Thanksgiving Day
    nt.f_addNews("2026-11-27", 1015, nt.TYPE_CME_Early_Close, arrDateStr, arrTimeMS, arrTypeId)  // 🟧 PATCH: Day after Thanksgiving
    nt.f_addNews("2026-12-25", 1, nt.TYPE_Bank_Holiday, arrDateStr, arrTimeMS, arrTypeId)  // 🟧 PATCH: Christmas Day all-day day-session closed

    [arrDateStr, arrTimeMS, arrTypeId]

export f_loadExcSevByTypeId() =>
    int[] _baseSev = nt.f_loadTypeSevByTypeId()
    int _n = array.size(_baseSev)
    int[] _excSev = array.new_int(_n, 0)
    // Example overrides (inherit only; applied by main script):
    // array.set(_excSev, nt.TYPE_ISM_Manufacturing_PMI, 3)
    // array.set(_excSev, nt.TYPE_JOLTS_Job_Openings, 2)
    _excSev

export f_loadExcTagByTypeId() =>
    int[] _baseSev = nt.f_loadTypeSevByTypeId()
    int _n = array.size(_baseSev)
    string[] _excTag = array.new_string(_n, "")
    // Optional debug tag per override (displayed in block reasons):
    // array.set(_excTag, nt.TYPE_ISM_Manufacturing_PMI, "2024-ex")
    _excTag

export f_loadExcDelayAfterNewsMins() =>
    0
