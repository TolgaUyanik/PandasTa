//@version=6
library("VolumaticDataLibrary") // Library name

// Define a custom type to hold the details of a significant volume node.
export type VolumeNode
    float price
    float volume // Stores absolute volume
    float signed_volume // Stores signed volume (close > open ? volume : -volume)
    color node_color // Color associated with the node's condition
    int bar_index // Bar index where the node occurred
    float atr_delta // ATR Delta value at the time the node occurred
    string volatility_level // Volatility level string (e.g., "Low", "Medium", "High", "Very High")

// Define a custom type to hold signal information when a level is crossed.
export type SignalInfo
    VolumeNode node // The VolumeNode that was crossed
    string direction // "above" or "below"
    string volatility_condition_met // The type of volatility condition that was met for the signal

// --- Removed: Internal Persistent Arrays ---
// These arrays are now managed by the calling indicator script using 'var'.


// @function Normalizes a value if mean is 0
// This function does not access global variables.
export norm(series float src) => // Exporting norm as it might be useful
    (src - ta.sma(src, 200)) / ta.stdev(src, 200)


// @function Processes a potential volume node and adds it to the provided arrays
// if it meets the criteria and there is space or it's more significant
// than an existing node. Uses a LIFO buffer management approach on the passed arrays.
// This function should be called on every bar from the consuming indicator/strategy.
// @param level The sensitivity level for detecting nodes.
// @param line_amount The maximum number of nodes to store in the buffer.
// @param node_prices Array to store node prices (passed by reference from indicator).
// @param node_volumes Array to store node absolute volumes (passed by reference from indicator).
// @param node_signed_volumes Array to store node signed volumes (passed by reference from indicator).
// @param node_colors Array to store node colors (passed by reference from indicator).
// @param node_bar_indices Array to store node bar indices (passed by reference from indicator).
// @param node_atr_deltas Array to store node ATR Delta values (passed by reference from indicator).
// @param node_volatility_levels Array to store node volatility level strings (passed by reference from indicator).
// @param color_up The color to use for upward significant volume.
// @param color_dn The color to use for downward significant volume.
// @param current_atr_delta The current ATR Delta value from the calling script.
// @param current_volatility_level_string The current volatility level string from the calling script.
// @param src_open The open price series from the calling script.
// @param src_high The high price series from the calling script.
// @param src_low The low price series from the calling script.
// @param src_close The close price series from the calling script.
// @param src_volume The volume series from the calling script.
// Modified function signature to accept arrays
export addVolumeNodeIfSignificant(float level, int line_amount, array<float> node_prices, array<float> node_volumes, array<float> node_signed_volumes, array<color> node_colors, array<int> node_bar_indices, array<float> node_atr_deltas, array<string> node_volatility_levels, color color_up, color color_dn, float current_atr_delta, string current_volatility_level_string, series float src_open, series float src_high, series float src_low, series float src_close, series float src_volume) =>
    // --- Core Calculation Logic ---
    // Bar Size
    series float diff = src_close - src_open

    // Normalized Bars Size and Volume
    series float current_signed_volume = src_close > src_open ? src_volume : -src_volume
    series float norm_vol = norm(current_signed_volume)
    series float norm_diff = norm(diff)

    // Adaptive "Level Width" based on Normalized Volume (can be used for tolerance)
    float level_width = math.abs(norm_vol * (ta.atr(200) * 0.1)) // Calculate width, use abs for positive value

    // Condition for a significant volume bar
    color condition = norm_diff > level and norm_vol > level ? color_up : norm_diff < -level and norm_vol < -level ? color_dn : na

    // Process significant volume bars
    if not na(condition) and line_amount > 0 // Only add if significant and line_amount is valid
        // Calculate the price for the volume node (using hl2 as in original)
        float node_price = (src_high + src_low) / 2.0
        float abs_volume = math.abs(current_signed_volume)

        // Add the new node data to the end of the passed-in arrays (LIFO - Last In, First Out)
        array.push(node_prices, node_price)
        array.push(node_volumes, abs_volume)
        array.push(node_signed_volumes, current_signed_volume)
        array.push(node_colors, condition) // Use the calculated condition color
        array.push(node_bar_indices, bar_index)
        array.push(node_atr_deltas, current_atr_delta)
        array.push(node_volatility_levels, current_volatility_level_string)

        // If the passed-in array size exceeds the maximum allowed, remove the oldest element (at index 0)
        if array.size(node_prices) > line_amount
            array.shift(node_prices)
            array.shift(node_volumes)
            array.shift(node_signed_volumes)
            array.shift(node_colors)
            array.shift(node_bar_indices)
            array.shift(node_atr_deltas)
            array.shift(node_volatility_levels)

    // This function does not return the list of nodes.
    // The result of the last statement is implicitly returned (effectively 'void').


// @function Creates and returns an array of VolumeNode objects from the provided separate arrays.
// This function is called by the consuming indicator/strategy
// to get the current list of significant volume nodes managed by the indicator.
// @param node_prices Array containing the prices of the nodes (passed by reference from indicator).
// @param node_volumes Array containing the absolute volumes of the nodes (passed by reference from indicator).
// @param node_signed_volumes Array containing the signed volumes of the nodes (passed by reference from indicator).
// @param node_colors Array containing the colors of the nodes (passed by reference from indicator).
// @param node_bar_indices Array containing the bar indices of the nodes (passed by reference from indicator).
// @param node_atr_deltas Array to store node ATR Delta values (passed by reference from indicator).
// @param node_volatility_levels Array to store node volatility level strings (passed by reference from indicator).
// @returns An array of VolumeNode objects representing the stored volume nodes.
// Modified function signature to accept arrays
export createVolumeNodeArray(array<float> node_prices, array<float> node_volumes, array<float> node_signed_volumes, array<color> node_colors, array<int> node_bar_indices, array<float> node_atr_deltas, array<string> node_volatility_levels) =>
    var VolumeNode[] result_nodes = array.new<VolumeNode>(0)
    array.clear(result_nodes) // Clear previous results

    // Populate the result_nodes array from the passed-in persistent arrays
    int current_stored_size = array.size(node_prices) // Assuming all passed-in arrays have the same size
    // Added check for array size before iterating to prevent error on bar 0
    if current_stored_size > 0
        for i = 0 to current_stored_size - 1
            float price = array.get(node_prices, i)
            float volume = array.get(node_volumes, i) // Absolute volume
            float signed_volume = array.get(node_signed_volumes, i) // Signed volume
            color node_color = array.get(node_colors, i)
            int node_bar_idx = array.get(node_bar_indices, i) // Bar index
            float atr_delta = array.get(node_atr_deltas, i) // ATR Delta
            string volatility_level = array.get(node_volatility_levels, i) // Volatility Level

            // Only add valid nodes (where price is not na)
            if not na(price)
                array.push(result_nodes, VolumeNode.new(price, volume, signed_volume, node_color, node_bar_idx, atr_delta, volatility_level))

    result_nodes // Implicitly return the result_nodes array


// @function Calculates the volume percentages for a provided array of VolumeNode objects.
// @param nodes_array Array of VolumeNode objects.
// @returns An array of floats representing the volume percentage for each node.
export calculateVolumePercentages(VolumeNode[] nodes_array) =>
    var array<float> vol_perc = array.new_float(0) // Use var in the calling script for persistence if needed
    array.clear(vol_perc) // Clear previous percentages

    float total_volume = 0.0
    int valid_nodes_count = 0
    for i = 0 to array.size(nodes_array) - 1
        node = array.get(nodes_array, i)
        if not na(node.volume)
            total_volume += node.volume // Sum absolute volumes
            valid_nodes_count += 1

    if total_volume > 0 and valid_nodes_count > 0
        for i = 0 to array.size(nodes_array) - 1
            node = array.get(nodes_array, i)
            if not na(node.volume)
                array.push(vol_perc, node.volume / total_volume * 100)
            else
                array.push(vol_perc, na)
    else
         // If total volume is 0 or na, or no valid nodes, push na for all percentages
        for i = 0 to array.size(nodes_array) - 1
            array.push(vol_perc, na)

    vol_perc // Implicitly return the percentage array


// @function Determines the volatility level string based on the ATR Delta value and thresholds.
// @param atr_delta The current ATR Delta value.
// @param low_threshold The upper bound for "Low Volatility".
// @param medium_threshold The upper bound for "Medium Volatility".
// @param high_threshold The upper bound for "High Volatility".
// @returns A string representing the volatility level ("Low", "Medium", "High", "Very High").
export getVolatilityLevelString(float atr_delta, float low_threshold, float medium_threshold, float high_threshold) =>
    float abs_atr_delta = math.abs(atr_delta)
    string volatility_level = if abs_atr_delta <= low_threshold
        "Low"
    else if abs_atr_delta <= medium_threshold
        "Medium"
    else if abs_atr_delta <= high_threshold
        "High"
    else
        "Very High"
    volatility_level


// @function Checks if the current price has crossed any of the provided volume node levels
// and if the specified volatility condition is met, returns signal information.
// @param nodes_array Array of VolumeNode objects to check crossings against.
// @param current_close The current bar's close price.
// @param prev_close The previous bar's close price.
// @param current_atr_delta The current ATR Delta value from the calling script.
// @param current_signal_line The current ATR Delta signal line value from the calling script.
// @param alert_volatility_condition The type of volatility condition to check for signals.
// @returns An array of SignalInfo objects for any levels crossed that meet the signal criteria.
export getSignalsOnCrossings(VolumeNode[] nodes_array, series float current_close, series float prev_close, float current_atr_delta, float current_signal_line, string alert_volatility_condition) =>
    var SignalInfo[] signals = array.new<SignalInfo>(0)
    array.clear(signals) // Clear previous signals

    if not na(current_close) and not na(prev_close) and array.size(nodes_array) > 0 // Added array size check here
        for i = 0 to array.size(nodes_array) - 1
            VolumeNode node = array.get(nodes_array, i)
            if not na(node.price)
                string direction = ""
                // Check for crossover (price goes from below to above the level)
                if prev_close < node.price and current_close >= node.price
                    direction := "above"
                // Check for crossunder (price goes from above to below the level)
                else if prev_close > node.price and current_close <= node.price
                    direction := "below"

                // If a crossing occurred, check the volatility condition
                if direction != ""
                    bool volatility_condition_met = false
                    string condition_met_type = ""

                    if alert_volatility_condition == "Increasing Average Volatility"
                        // Check if the current signal line is above its previous value
                        // AND the current ATR Delta is not na (uses the argument)
                        volatility_condition_met := not na(current_signal_line[1]) and current_signal_line > current_signal_line[1] and not na(current_atr_delta)
                        if volatility_condition_met
                            condition_met_type := "Increasing Average Volatility"
                    else if alert_volatility_condition == "High Volatility Level"
                        // Check if the volatility level at the time of crossing is "High" or "Very High"
                        // AND the current ATR Delta is not na (uses the argument)
                        volatility_condition_met := (node.volatility_level == "High" or node.volatility_level == "Very High") and not na(current_atr_delta)
                        if volatility_condition_met
                            condition_met_type := "High Volatility Level"
                    else if alert_volatility_condition == "Any Volatility"
                        // No specific volatility condition, signal on any crossing
                        // AND the current ATR Delta is not na (uses the argument)
                        volatility_condition_met := not na(current_atr_delta)
                        if volatility_condition_met
                            condition_met_type := "Any Volatility"
                    else if alert_volatility_condition == "Increasing Average Volatility OR High Volatility Level"
                        // Check for either condition
                        bool increasing_avg_vol = not na(current_signal_line[1]) and current_signal_line > current_signal_line[1] and not na(current_atr_delta)
                        bool high_vol_level = (node.volatility_level == "High" or node.volatility_level == "Very High") and not na(current_atr_delta)
                        volatility_condition_met := increasing_avg_vol or high_vol_level
                        if volatility_condition_met
                            condition_met_type := "Increasing Average Volatility OR High Volatility Level"


                    // If the volatility condition is met, add a signal
                    if volatility_condition_met
                        array.push(signals, SignalInfo.new(node, direction, condition_met_type))

    signals // Implicitly return the array of signals


// --- New Functions for Lorentzian Trend and ML Trend Control ---

// @function Calculates the Lorentzian Trend.
// @param src The source series (e.g., close).
// @param length The length for the SMA and difference calculation.
// @param smoothing The length for the EMA smoothing.
// @returns The Lorentzian Trend series.
export lorentzianTrend(series float src, int length, int smoothing) =>
    // Calculate absolute difference from SMA
    series float abs_diff = math.abs(src - ta.sma(src, length))
    // Calculate a weighted value based on the difference
    series float weighted_value = src * abs_diff
    // Smooth the weighted value
    series float smoothed_weighted_value = ta.ema(weighted_value, smoothing)
    // Smooth the absolute difference
    series float smoothed_abs_diff = ta.ema(abs_diff, smoothing)
    // Calculate the Lorentzian Trend
    series float lorentzian_trend_calc = smoothed_abs_diff != 0 ? smoothed_weighted_value / smoothed_abs_diff : src // Avoid division by zero
    lorentzian_trend_calc


// @function Calculates the ML Trend Control value.
// @param src The source series (e.g., close).
// @param length The length for the SMA and standard deviation.
// @returns The ML Trend Control value (0 to 1).
export mlTrendControl(series float src, int length) =>
    // Calculate the difference between the source and its SMA
    series float diff_from_sma = src - ta.sma(src, length)
    // Normalize the difference using standard deviation
    series float normalized_diff = ta.stdev(src, length) != 0 ? diff_from_sma / ta.stdev(src, length) : 0

    // Scale and clamp the normalized difference to map it roughly between 0 and 1
    // Using a simple scaling and clamping approach as math.tanh is not available.
    // Adjust scaling factor (0.15) and offset (0.5) as needed for desired range mapping.
    series float scaled_diff = normalized_diff * 0.15 + 0.5

    // Clamp the result between 0 and 1
    series float ml_trend_control_calc = math.max(0.0, math.min(1.0, scaled_diff))
    ml_trend_control_calc
