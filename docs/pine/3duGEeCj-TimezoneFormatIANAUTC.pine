		map.put(tzMAP, "Kolkata",	 		tz.new("Asia/Kolkata", "UTC+05:30"))
		map.put(tzMAP, "Kathmandu", 		tz.new("Asia/Kathmandu", "UTC+05:45"))
		map.put(tzMAP, "Dhaka", 			tz.new("Asia/Dhaka", "UTC+06:00"))
		map.put(tzMAP, "Yangon", 			tz.new("Asia/Yangon", "UTC+06:30"))
		map.put(tzMAP, "Bangkok", 			tz.new("Asia/Bangkok", "UTC+07:00"))
		map.put(tzMAP, "Ho Chi Minh", 		tz.new("Asia/Ho_Chi_Minh", "UTC+07:00"))
		map.put(tzMAP, "Jakarta", 			tz.new("Asia/Jakarta", "UTC+07:00"))
		map.put(tzMAP, "Chongqing", 		tz.new("Asia/Chongqing", "UTC+08:00"))
		map.put(tzMAP, "Hong Kong", 		tz.new("Asia/Hong_Kong", "UTC+08:00"))
		map.put(tzMAP, "Kuala Lumpur", 		tz.new("Asia/Kuala_Lumpur", "UTC+08:00"))
		map.put(tzMAP, "Manila",			tz.new("Asia/Manila", "UTC+08:00"))
		map.put(tzMAP, "Perth", 			tz.new("Australia/Perth", "UTC+08:00"))
		map.put(tzMAP, "Shanghai", 			tz.new("Asia/Shanghai", "UTC+08:00"))
		map.put(tzMAP, "Singapore", 		tz.new("Asia/Singapore", "UTC+08:00"))
		map.put(tzMAP, "Taipei", 			tz.new("Asia/Taipei", "UTC+08:00"))
		map.put(tzMAP, "Seoul", 			tz.new("Asia/Seoul", "UTC+09:00"))
		map.put(tzMAP, "Tokyo", 			tz.new("Asia/Tokyo", "UTC+09:00"))
		map.put(tzMAP, "Adelaide", 			tz.new("Australia/Adelaide", "UTC+09:30"))
		map.put(tzMAP, "Brisbane", 			tz.new("Australia/Brisbane", "UTC+10:00"))
		map.put(tzMAP, "Sydney", 			tz.new("Australia/Sydney", "UTC+10:00"))
		map.put(tzMAP, "Norfolk Island", 	tz.new("Pacific/Norfolk", "UTC+11:00"))
		map.put(tzMAP, "New Zealand", 		tz.new("NZ", "UTC+12:00"))
		map.put(tzMAP, "Chatham Islands", 	tz.new("Pacific/Chatham", "UTC+12:45"))
		map.put(tzMAP, "Tokelau", 			tz.new("Pacific/Fakaofo", "UTC+13:00"))

	//@variable type value of key
	val = map.get(tzMAP, str.trim(_tzname))
	//@variable return value based on "Name" or "UTC"
	result = if na(val)
		if str.match(_tzname, "^[+-]((0?[0-9])|1[0-4]):(00|15|30|45)$") != ""
			_tzname
		else
			runtime.error("Invalid timezone input. Please enter a valid timezone value.(e.g. New York, London, or enter a UTC offset in ±HH:MM format (hours 00–14, minutes 00, 15, 30, or 45), for example +03:00 or –05:30")
			string(na)
	else
		if _format == "IANA"
			val.iana
		else
			val.utc
