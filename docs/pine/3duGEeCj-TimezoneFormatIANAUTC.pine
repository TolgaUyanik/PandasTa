//@version=6

// @description provides Timezone Full Name or UTC offset
library("TimezoneFormatIANAUTC", overlay = true)

//@type hold IANA name and UTC offset
type tz
    string iana
    string utc

// @function        
// @param _tzname	Name of chart timezone(in the chart’s lower-right corner)
// @param _format 	Timezone format: 'IANA' or 'UTC'
// @returns         Timezone string  
export tz(string _tzname, string _format) =>
	//@variable A map associating `string` keys with `tz` instances.
	var tzMAP = map.new<string, tz>()
	// Put a new pair with Tradingview Chart Timezone Name key into `tzMAP` only on the first bar.
	if bar_index == 0
		map.put(tzMAP, "UTC", 				tz.new("UTC+00:00", "UTC+00:00"))
		map.put(tzMAP, "Exchange", 			tz.new(syminfo.timezone, syminfo.timezone))
		map.put(tzMAP, "Honolulu", 			tz.new("Pacific/Honolulu", "UTC-10:00"))
		map.put(tzMAP, "Anchorage", 		tz.new("America/Anchorage", "UTC-09:00"))
