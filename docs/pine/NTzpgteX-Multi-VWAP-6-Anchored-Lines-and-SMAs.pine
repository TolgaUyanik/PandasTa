//@version=6
indicator("Multi-VWAP — 6 Anchored Lines + SMAs", shorttitle = "VWAP x6 + SMA", overlay = true, max_bars_back = 5000, max_labels_count = 60)

// ============================================================================
//  MULTI-VWAP  —  six independently-anchored VWAPs on one chart
// ----------------------------------------------------------------------------
//  Each VWAP can anchor to:  Session / Day / Week / Month / Quarter / Year /
//  Custom Date.  Each carries optional ± standard-deviation bands.
//
//  Per-line styling : colour, width, line transparency, fill transparency.
//  End-of-line labels: name the anchor + the line (VWAP / +SD / -SD),
//                      with horizontal offset and optional vertical stagger.
//
//  NOTE: these are *anchored* VWAPs (volume accumulator resets at each new
//  anchor period). They are NOT rolling/HTF security() VWAPs. The "timeframe"
//  you choose per line is the ANCHOR period, not a higher chart resolution.
//
//  + Adds a Simple Moving Average block (up to 4 lines) at the bottom.
// ============================================================================

// ----------------------------- Shared inputs --------------------------------
grpGen   = "General"
tzSel    = input.string("Europe / Berlin (Frankfurt)", "Session timezone (for 'Session' anchor)",
             options = ["Europe / Berlin (Frankfurt)", "America / New York (US)", "Asia / Tokyo (Asian)"], group = grpGen,
             tooltip = "Used only by VWAPs whose anchor is set to 'Session'. Sets the timezone the session window is interpreted in. GER40 cash = Europe / Berlin.")
tzSess   = tzSel == "America / New York (US)" ? "America/New_York" : tzSel == "Asia / Tokyo (Asian)" ? "Asia/Tokyo" : "Europe/Berlin"
useP     = input.bool(false, "Use market cash-session preset", group = grpGen,
             tooltip = "When ON, every 'Session'-anchored VWAP uses the standard cash hours for the timezone chosen above and ignores its own Session field. When OFF, each line's Session field is used.")
presetS  = tzSel == "America / New York (US)" ? "0930-1600" : tzSel == "Asia / Tokyo (Asian)" ? "0900-1500" : "0900-1730"
breakNew = input.bool(true, "Break line at each new anchor", group = grpGen,
             tooltip = "Prevents the diagonal 'jump' line drawn when a VWAP resets to a new period.")
fillBnds = input.bool(true, "Fill between ± bands (master)", group = grpGen)

grpLbl   = "Labels"
showLbl  = input.bool(true, "Show end-of-line labels", group = grpLbl)
lblSizeS = input.string("Small", "Label size", options = ["Tiny","Small","Normal","Large"], group = grpLbl)
lblXoff  = input.int(2, "Offset (bars from line end)", minval = 0, maxval = 50, group = grpLbl,
             tooltip = "Higher = labels sit further to the right (away from the line). 0 = right at the last bar.")
stagOn   = input.bool(false, "Stagger labels vertically", group = grpLbl, inline = "stag",
             tooltip = "Fans the lines' labels apart vertically so they stop overlapping when prices cluster. NOTE: this detaches the label from the exact line level by the offset below.")
stagAmt  = input.float(0.3, "× ATR", minval = 0.0, step = 0.1, group = grpLbl, inline = "stag")

lblSz    = lblSizeS == "Tiny" ? size.tiny : lblSizeS == "Normal" ? size.normal : lblSizeS == "Large" ? size.large : size.small
atrLbl   = ta.atr(14)

// ----------------------------- Reset helper ---------------------------------
// Returns TRUE on the first bar of a new anchor period for the chosen mode.
f_reset(simple string mode, simple string sess, simple string tz, simple int aTs) =>
    bool r = false
    if mode == "Day"
        r := timeframe.change("1D")
    else if mode == "Week"
        r := timeframe.change("1W")
    else if mode == "Month"
        r := timeframe.change("1M")
    else if mode == "Quarter"
        r := timeframe.change("3M")
    else if mode == "Year"
        r := timeframe.change("12M")
    else if mode == "Custom Date"
        r := time >= aTs and time[1] < aTs
    else  // "Session"
        int t = time(timeframe.period, sess, tz)
        r := (not na(t)) and na(t[1])
    r

// ----------------------------- VWAP builder ---------------------------------
// Runs unconditionally every bar (required by ta.vwap). Returns value, bands,
// and the reset flag so the caller can break the plot at each new anchor.
f_vwap(float src, simple string mode, simple string sess, simple string tz, simple int aTs, simple float mult) =>
    bool reset = f_reset(mode, sess, tz, aTs)
    [v, u, l] = ta.vwap(src, reset, mult)
    [v, u, l, reset]

// ----------------------------- Stagger offset -------------------------------
// Fan-out slot per line index (1..6) -> centred on 0 (using 3.5 as the
// midpoint of 1..6), scaled by ATR.
f_yoff(int idx, bool on, float amt, float atr) =>
    on ? (idx - 3.5) * amt * nz(atr) : 0.0

// ----------------------------- Label manager --------------------------------
// One persistent label per line (VWAP / upper SD / lower SD). var-in-function
// keeps a separate instance per call site, so each VWAP owns its own labels.
// Labels only live on the last bar; toggling off deletes them (no leak).
// xOff = bars to the right of the last bar;  yOff = vertical stagger nudge.
f_labels(bool en, bool showBands, bool master, string anchorName, float vVal, float uVal, float lVal, float mult, color c, string sz, int xOff, float yOff) =>
    var label lV = na
    var label lU = na
    var label lL = na
    if barstate.islast
        int xp = bar_index + xOff
        // --- VWAP line ---
        if master and en and not na(vVal)
            txtV = anchorName + " VWAP"
            if na(lV)
                lV := label.new(xp, vVal + yOff, txtV, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 100), textcolor = color.new(c, 0), size = sz)
            else
                label.set_xy(lV, xp, vVal + yOff)
                label.set_text(lV, txtV)
                label.set_textcolor(lV, color.new(c, 0))
                label.set_size(lV, sz)
        else if not na(lV)
            label.delete(lV)
            lV := na
        // --- Upper SD line ---
        if master and en and showBands and not na(uVal)
            txtU = anchorName + " +" + str.tostring(mult, "0.0") + " SD"
            if na(lU)
                lU := label.new(xp, uVal + yOff, txtU, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 100), textcolor = color.new(c, 25), size = sz)
            else
                label.set_xy(lU, xp, uVal + yOff)
                label.set_text(lU, txtU)
                label.set_textcolor(lU, color.new(c, 25))
                label.set_size(lU, sz)
        else if not na(lU)
            label.delete(lU)
            lU := na
        // --- Lower SD line ---
        if master and en and showBands and not na(lVal)
            txtL = anchorName + " -" + str.tostring(mult, "0.0") + " SD"
            if na(lL)
                lL := label.new(xp, lVal + yOff, txtL, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 100), textcolor = color.new(c, 25), size = sz)
            else
                label.set_xy(lL, xp, lVal + yOff)
                label.set_text(lL, txtL)
                label.set_textcolor(lL, color.new(c, 25))
                label.set_size(lL, sz)
        else if not na(lL)
            label.delete(lL)
            lL := na
    true

// ============================================================================
//  VWAP 1
// ============================================================================
g1     = "VWAP 1"
en1    = input.bool(true,  "Enable", group = g1, inline = "1a")
col1   = input.color(#2962FF, "", group = g1, inline = "1a")
w1     = input.int(2, "Width", minval = 1, maxval = 5, group = g1, inline = "1a")
lt1    = input.int(0,  "Line transparency", minval = 0, maxval = 100, group = g1)
src1   = input.source(hlc3, "Source", group = g1)
mode1  = input.string("Day", "Anchor", options = ["Session","Day","Week","Month","Quarter","Year","Custom Date"], group = g1)
sess1  = input.session("0900-1730", "Session (if anchor = Session)", group = g1)
a1     = input.time(timestamp("2025-01-01 00:00 +0000"), "Custom anchor (if anchor = Custom Date)", group = g1)
band1  = input.bool(false, "Bands", group = g1, inline = "1b")
mult1  = input.float(1.0, "× stdev", minval = 0.1, step = 0.1, group = g1, inline = "1b")
ft1    = input.int(90, "Fill transp", minval = 0, maxval = 100, group = g1, inline = "1b")

[v1, u1, l1, r1] = f_vwap(src1, mode1, useP ? presetS : sess1, tzSess, a1, mult1)
brk1 = breakNew and r1
pv1  = plot(en1 ? (brk1 ? na : v1) : na, "VWAP 1", color = color.new(col1, lt1), linewidth = w1)
pu1  = plot(en1 and band1 ? (brk1 ? na : u1) : na, "V1 upper", color = color.new(col1, lt1))
pl1  = plot(en1 and band1 ? (brk1 ? na : l1) : na, "V1 lower", color = color.new(col1, lt1))
fill(pu1, pl1, color = en1 and band1 and fillBnds ? color.new(col1, ft1) : na)
f_labels(en1, band1, showLbl, mode1, v1, u1, l1, mult1, col1, lblSz, lblXoff, f_yoff(1, stagOn, stagAmt, atrLbl))

