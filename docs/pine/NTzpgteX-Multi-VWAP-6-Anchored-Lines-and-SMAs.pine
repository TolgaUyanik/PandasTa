// ============================================================================
//  SIMPLE MOVING AVERAGES  —  up to 4 configurable lines
// ----------------------------------------------------------------------------
//  Chart-timeframe by default. Optionally source each SMA from a higher
//  timeframe (leave "Source TF" blank = chart). HTF fetch is NON-REPAINTING
//  via the [1] offset + barmerge.lookahead_on idiom, so a HTF-sourced SMA
//  only updates on confirmed HTF bars (no intra-bar repaint).
//
//  Reuses the shared Label controls above (size / offset / stagger).
// ============================================================================
grpSMA  = "Simple Moving Averages"
smaLbl  = input.bool(true, "Show SMA end-of-line labels", group = grpSMA)

// -- non-repainting SMA (chart-TF or HTF) --
f_sma(float src, simple int len, simple string tf) =>
    bool useHTF = not (tf == "" or tf == timeframe.period)
    float chartVal = ta.sma(src, len)
    useHTF ? request.security(syminfo.tickerid, tf, ta.sma(src, len)[1], lookahead = barmerge.lookahead_on) : chartVal

// -- one persistent end-of-line label per SMA (mirrors f_labels: no leak) --
f_smaLabel(bool en, string txt, float val, color c, string sz, int xOff, float yOff) =>
    var label lb = na
    if barstate.islast
        if en and not na(val)
            int xp = bar_index + xOff
            if na(lb)
                lb := label.new(xp, val + yOff, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 100), textcolor = color.new(c, 0), size = sz)
            else
                label.set_xy(lb, xp, val + yOff)
                label.set_text(lb, txt)
                label.set_textcolor(lb, color.new(c, 0))
                label.set_size(lb, sz)
        else if not na(lb)
            label.delete(lb)
            lb := na
    true

// -- build a label caption: "SMA 20" or "SMA 50 1D" when HTF-sourced --
f_smaTxt(int len, string tf) => "SMA " + str.tostring(len) + (tf == "" ? "" : " " + tf)

// --- SMA 1 (20, on) ---
sEn1  = input.bool(true,  "Enable", group = grpSMA, inline = "s1a")
sCol1 = input.color(#FFFFFF, "", group = grpSMA, inline = "s1a")
sW1   = input.int(2, "Width", minval = 1, maxval = 5, group = grpSMA, inline = "s1a")
sLen1 = input.int(20, "└ Length", minval = 1, group = grpSMA)
sSrc1 = input.source(close, "└ Source", group = grpSMA, inline = "s1b")
sTf1  = input.timeframe("", "└ Source TF (blank = chart)", group = grpSMA, inline = "s1b")

// --- SMA 2 (50, on) ---
sEn2  = input.bool(true,  "Enable", group = grpSMA, inline = "s2a")
