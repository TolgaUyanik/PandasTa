// --- SMA 4 (200, off) ---
sEn4  = input.bool(false, "Enable", group = grpSMA, inline = "s4a")
sCol4 = input.color(#FFD180, "", group = grpSMA, inline = "s4a")
sW4   = input.int(2, "Width", minval = 1, maxval = 5, group = grpSMA, inline = "s4a")
sLen4 = input.int(200, "└ Length", minval = 1, group = grpSMA)
sSrc4 = input.source(close, "└ Source", group = grpSMA, inline = "s4b")
sTf4  = input.timeframe("", "└ Source TF (blank = chart)", group = grpSMA, inline = "s4b")

sma1 = f_sma(sSrc1, sLen1, sTf1)
sma2 = f_sma(sSrc2, sLen2, sTf2)
sma3 = f_sma(sSrc3, sLen3, sTf3)
sma4 = f_sma(sSrc4, sLen4, sTf4)

plot(sEn1 ? sma1 : na, "SMA 1", color = color.new(sCol1, 0), linewidth = sW1)
plot(sEn2 ? sma2 : na, "SMA 2", color = color.new(sCol2, 0), linewidth = sW2)
