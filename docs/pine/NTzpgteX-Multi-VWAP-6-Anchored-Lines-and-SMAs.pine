sEn3  = input.bool(false, "Enable", group = grpSMA, inline = "s3a")
sCol3 = input.color(#FF5252, "", group = grpSMA, inline = "s3a")
sW3   = input.int(2, "Width", minval = 1, maxval = 5, group = grpSMA, inline = "s3a")
sLen3 = input.int(100, "└ Length", minval = 1, group = grpSMA)
sSrc3 = input.source(close, "└ Source", group = grpSMA, inline = "s3b")
