//@version=6
indicator("Key Levels - PDH/PDL/PWH/PWL/PMH/PML", overlay = true, max_lines_count = 100, max_labels_count = 100)

// ==========================================
// 1. INPUT GROUPS & CONFIGURATION
// ==========================================

// --- Display Controls ---
GRP_DISP    = "Display Options"
showIntra   = input.bool(true, "Show Only on Intraday Charts", group = GRP_DISP, tooltip = "Hides levels on Daily charts or higher to prevent clutter.")
extRight    = input.bool(true, "Extend Lines Right", group = GRP_DISP)
labelOffset = input.int(5, "Label Right Offset (Bars)", minval = 0, group = GRP_DISP)

// --- Daily Levels ---
GRP_D       = "Daily Levels"
show_PDH    = input.bool(true, "Prev Day High (PDH)", inline = "pdh", group = GRP_D)
col_PDH     = input.color(#ef5350, "", inline = "pdh", group = GRP_D)
style_PDH   = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "pdh", group = GRP_D)

show_PDL    = input.bool(true, "Prev Day Low (PDL)", inline = "pdl", group = GRP_D)
col_PDL     = input.color(#26a69a, "", inline = "pdl", group = GRP_D)
style_PDL   = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "pdl", group = GRP_D)

show_PDO    = input.bool(false, "Prev Day Open (PDO)", inline = "pdo", group = GRP_D)
col_PDO     = input.color(#ff9800, "", inline = "pdo", group = GRP_D)
style_PDO   = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "pdo", group = GRP_D)

show_DO     = input.bool(true, "Current Day Open (DO)", inline = "do", group = GRP_D)
col_DO      = input.color(#2196f3, "", inline = "do", group = GRP_D)
style_DO    = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "do", group = GRP_D)

// --- Weekly Levels ---
GRP_W       = "Weekly Levels"
show_PWH    = input.bool(true, "Prev Week High (PWH)", inline = "pwh", group = GRP_W)
col_PWH     = input.color(#b22222, "", inline = "pwh", group = GRP_W)
style_PWH   = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "pwh", group = GRP_W)

show_PWL    = input.bool(true, "Prev Week Low (PWL)", inline = "pwl", group = GRP_W)
col_PWL     = input.color(#008080, "", inline = "pwl", group = GRP_W)
style_PWL   = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "pwl", group = GRP_W)

// --- Monthly Levels ---
GRP_M       = "Monthly Levels"
show_PMH    = input.bool(true, "Prev Month High (PMH)", inline = "pmh", group = GRP_M)
col_PMH     = input.color(#880e4f, "", inline = "pmh", group = GRP_M)
style_PMH   = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "pmh", group = GRP_M)

show_PML    = input.bool(true, "Prev Month Low (PML)", inline = "pml", group = GRP_M)
col_PML     = input.color(#004d40, "", inline = "pml", group = GRP_M)
style_PML   = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "pml", group = GRP_M)

// --- Alert Configuration ---
GRP_ALT     = "Alert Settings"
enableAlerts= input.bool(true, "Enable Cross/Touch Alerts", group = GRP_ALT)

// ==========================================
// 2. HELPER FUNCTIONS
// ==========================================

// Map string style inputs to Pine Script line styles
get_line_style(string s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

// ==========================================
// 3. NON-REPAINTING DATA FETCHING
// ==========================================

// Security calls fetching closed historical bar values [1] to avoid repainting
[pdh_val, pdl_val, pdo_val] = request.security(syminfo.tickerid, "D", [high[1], low[1], open[1]], lookahead = barmerge.lookahead_on)
do_val                      = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_off)

[pwh_val, pwl_val]          = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pmh_val, pml_val]          = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ==========================================
// 4. RENDERING & OBJECT MANAGEMENT
// ==========================================

// Check timeframe conditions
is_intraday = timeframe.isintraday
can_render  = showIntra ? is_intraday : true

// Persistent Line and Label Variables
var line  l_pdh = na, var label lb_pdh = na
var line  l_pdl = na, var label lb_pdl = na
var line  l_pdo = na, var label lb_pdo = na
var line  l_do  = na, var label lb_do  = na
var line  l_pwh = na, var label lb_pwh = na
var line  l_pwl = na, var label lb_pwl = na
var line  l_pmh = na, var label lb_pmh = na
var line  l_pml = na, var label lb_pml = na

// Helper function to update or draw lines and labels dynamically
update_level(bool show, float val, string name, color col, string style_str, ref_line, ref_label) =>
    line  ret_line  = ref_line
    label ret_label = ref_label

    if can_render and show and not na(val)
        ext_mode = extRight ? extend.right : extend.none
        l_style  = get_line_style(style_str)
        
        if barstate.islast
            // Clean up previous renderings on last bar update
            line.delete(ret_line)
            label.delete(ret_label)
            
            // Draw line
            ret_line := line.new(
                 x1 = bar_index - 10, y1 = val,
                 x2 = bar_index, y2 = val,
                 color = col, style = l_style, width = 1, extend = ext_mode
                 )
            
            // Draw label at right-hand side
            ret_label := label.new(
                 x = bar_index + labelOffset, y = val,
                 text = name + ": " + str.tostring(val, "#.##"),
                 color = color.new(col, 100),
                 textcolor = col,
                 style = label.style_label_left,
                 size = size.small
                 )
    ret_line

// Main update logic running on the last bar
if barstate.islast
    update_level(show_PDH, pdh_val, "PDH", col_PDH, style_PDH, l_pdh, lb_pdh)
    update_level(show_PDL, pdl_val, "PDL", col_PDL, style_PDL, l_pdl, lb_pdl)
    update_level(show_PDO, pdo_val, "PDO", col_PDO, style_PDO, l_pdo, lb_pdo)
    update_level(show_DO,  do_val,  "DO",  col_DO,  style_DO,  l_do,  lb_do)
    update_level(show_PWH, pwh_val, "PWH", col_PWH, style_PWH, l_pwh, lb_pwh)
    update_level(show_PWL, pwl_val, "PWL", col_PWL, style_PWL, l_pwl, lb_pwl)
    update_level(show_PMH, pmh_val, "PMH", col_PMH, style_PMH, l_pmh, lb_pmh)
    update_level(show_PML, pml_val, "PML", col_PML, style_PML, l_pml, lb_pml)

// ==========================================
// 5. ALERT ENGINE
// ==========================================

check_cross(bool enabled, float level, string name) =>
    if enabled and not na(level)
        if ta.cross(close, level)
            alert(syminfo.ticker + " crossed " + name + " level at " + str.tostring(close), alert.freq_once_per_bar)

if enableAlerts
    check_cross(show_PDH, pdh_val, "PDH")
    check_cross(show_PDL, pdl_val, "PDL")
    check_cross(show_PDO, pdo_val, "PDO")
    check_cross(show_DO,  do_val,  "DO")
    check_cross(show_PWH, pwh_val, "PWH")
    check_cross(show_PWL, pwl_val, "PWL")
    check_cross(show_PMH, pmh_val, "PMH")
    check_cross(show_PML, pml_val, "PML")