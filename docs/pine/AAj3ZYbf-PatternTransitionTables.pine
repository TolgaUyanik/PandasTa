// @function    Returns the precomputed transition table for the specified order.
// @param d     <simple int> Order of ordinal patterns. Valid: 2, 3, 4, or 5.
//              Note: If your indicator uses "embedding dimension D" (number of points), pass D-1.
// @returns     <array<int>> Flattened transition table φ_d(n, l). Size = (d+1)! × (d+1).
export get_table(int d) =>
    switch d
        2 => get_table_d2()
        3 => get_table_d3()
        4 => get_table_d4()
        5 => get_table_d5()
        =>
            runtime.error("get_table(): Order d must be 2, 3, 4, or 5. Got: " + str.tostring(d))
            array.new<int>()

//#endregion


//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  SECTION 3: DIMENSION-SPECIFIC SUCCESSOR FUNCTIONS  ]------
//----------------------------------------------------------------------------------------------------------------------------- //
//
// These functions wrap the table lookup for each specific dimension.
// They abstract the index calculation: index = current_pattern * (d+1) + position_l
//
//----------------------------------------------------------------------------------------------------------------------------- //


// @function            Computes the successor ordinal pattern for Order d=2.
// @param current_pattern <int> Current ordinal pattern index [0, 6].
// @param position_l    <int> Position of new point [0, 2].
//                      l = count of points in the last d values >= new point.
// @returns             <int> Successor ordinal pattern index.
export get_successor_d2(int current_pattern, int position_l) =>
    array<int> arr_table = get_table_d2()
    int index = current_pattern * 3 + position_l  // (d+1) = 3
    arr_table.get(index)


// @function            Computes the successor ordinal pattern for Order d=3.
// @param current_pattern <int> Current ordinal pattern index [0, 23].
// @param position_l    <int> Position of new point [0, 3].
// @returns             <int> Successor ordinal pattern index.
export get_successor_d3(int current_pattern, int position_l) =>
    array<int> arr_table = get_table_d3()
    int index = current_pattern * 4 + position_l  // (d+1) = 4
    arr_table.get(index)


// @function            Computes the successor ordinal pattern for Order d=4.
// @param current_pattern <int> Current ordinal pattern index [0, 119].
// @param position_l    <int> Position of new point [0, 4].
// @returns             <int> Successor ordinal pattern index.
export get_successor_d4(int current_pattern, int position_l) =>
    array<int> arr_table = get_table_d4()
    int index = current_pattern * 5 + position_l  // (d+1) = 5
    arr_table.get(index)


// @function            Computes the successor ordinal pattern for Order d=5.
// @param current_pattern <int> Current ordinal pattern index [0, 719].
// @param position_l    <int> Position of new point [0, 5].
// @returns             <int> Successor ordinal pattern index.
export get_successor_d5(int current_pattern, int position_l) =>
    array<int> arr_table = get_table_d5()
    int index = current_pattern * 6 + position_l  // (d+1) = 6
    arr_table.get(index)

//#endregion


//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  SECTION 4: GENERIC MASTER WRAPPER  ]------
//----------------------------------------------------------------------------------------------------------------------------- //

// @function            Generic successor lookup that routes to the appropriate order.
//                      Implements φ_d(n, l) from Equation (5) of Unakafova & Keller (2013).
// @param d             <simple int> Order of ordinal patterns. Valid: 2, 3, 4, or 5.
//                      Note: If using "embedding dimension D", pass D-1.
// @param current_pattern <int> Current ordinal pattern index [0, (d+1)!-1].
// @param position_l    <int> Position of the new point [0, d].
//                      l = #{r ∈ {0,...,d-1} | x_{t-rτ} >= x_{t+τ}} (Equation 6)
// @returns             <int> Successor ordinal pattern index n^τ_d(t+τ).
export get_successor(int d, int current_pattern, int position_l) =>
    switch d
        2 => get_successor_d2(current_pattern, position_l)
        3 => get_successor_d3(current_pattern, position_l)
        4 => get_successor_d4(current_pattern, position_l)
        5 => get_successor_d5(current_pattern, position_l)
        =>
            runtime.error("get_successor(): Order d must be 2, 3, 4, or 5. Got: " + str.tostring(d))
            0

//#endregion


//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  SECTION 5: VALIDATION & DEMONSTRATION (Non-exported)  ]------
//----------------------------------------------------------------------------------------------------------------------------- //
//
// This section provides runtime validation to ensure the transition tables
// are correctly loaded and accessible. It runs only on the last bar.
//
//----------------------------------------------------------------------------------------------------------------------------- //

// @function    Runs a simple equality check and logs the result.
// @param name  <string> Name of the test case.
// @param actual <int> The value returned by the function.
// @param expected <int> The expected value.
// @returns     <bool> True if passed, false otherwise.
method run_test(string name, int actual, int expected) =>
    bool passed = actual == expected
    if not passed
        log.error("❌ Test Failed: {0} | Expected: {1}, Got: {2}", name, expected, actual)
    else
        log.info("✅ Test Passed: {0}", name)
    passed

if barstate.islast
    log.info("------[ PatternTransitionTables: Starting Validation ]------")

    // ------[  Table Size Tests  ]------ //

    "Table Size d=2".run_test(get_table_size(2), 18)
    "Table Size d=3".run_test(get_table_size(3), 96)
    "Table Size d=4".run_test(get_table_size(4), 600)
    "Table Size d=5".run_test(get_table_size(5), 4320)

    // ------[  Generic Table Getter Tests  ]------ //

    "Table d=2 Size".run_test(get_table(2).size(), 18)
    "Table d=3 Size".run_test(get_table(3).size(), 96)
    "Table d=4 Size".run_test(get_table(4).size(), 600)
    "Table d=5 Size".run_test(get_table(5).size(), 4320)
    // "Table d=6 Size".run_test(get_table(6).size(), 35280) // Uncomment after populating d=6 tables

    // ------[  d=2 Transition Tests  ]------ //
    // Note: As per Section 3.3 of the paper, patterns with the same (i1, ..., id-1) share successors.
    //       Patterns 0, 1, 2 (i1=0) -> Successors {0, 3, 4}
    //       Patterns 3, 4, 5 (i1=1) -> Successors {1, 2, 5}

    // Pattern 0 is (0,0) -> Successors: 0, 3, 4
    "d=2 φ(0,0)".run_test(get_successor_d2(0, 0), 0)
    "d=2 φ(0,1)".run_test(get_successor_d2(0, 1), 3)
    "d=2 φ(0,2)".run_test(get_successor_d2(0, 2), 4)

    // Pattern 3 is (1,0) -> Successors: 1, 2, 5
    "d=2 φ(3,0)".run_test(get_successor_d2(3, 0), 1)
    "d=2 φ(3,1)".run_test(get_successor_d2(3, 1), 2)
    "d=2 φ(3,2)".run_test(get_successor_d2(3, 2), 5)

    // ------[  d=3 Transition Tests  ]------ //
    // Pattern 0 at pos 1 -> 12 (Index 0*4 + 1 = 1) -> value 12
    "d=3 φ(0,1)".run_test(get_successor_d3(0, 1), 12)

    // ------[  Generic Successor Tests  ]------ //
    // Test that generic wrapper produces same results as dimension-specific functions
    "Generic d=2 φ(0,0)".run_test(get_successor(2, 0, 0), get_successor_d2(0, 0))
    "Generic d=3 φ(0,1)".run_test(get_successor(3, 0, 1), get_successor_d3(0, 1))
    "Generic d=4 φ(0,0)".run_test(get_successor(4, 0, 0), get_successor_d4(0, 0))
    "Generic d=5 φ(0,0)".run_test(get_successor(5, 0, 0), get_successor_d5(0, 0))

    log.info("------[ PatternTransitionTables: Validation Complete ]------")

// Plot nothing, just to ensure script can be added to chart if needed
plot(na, display = display.none)

//#endregion
