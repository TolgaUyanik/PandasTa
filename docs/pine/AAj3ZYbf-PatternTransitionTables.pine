// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/

// @version=6

// @description Precomputed pattern transition tables for efficient ordinal pattern updates.
//              Based on Unakafova, V. & Keller, K. (2013) "Efficiently Measuring Complexity on the
//              Basis of Real-World Data", Entropy 2013, 15, 4392-4415.
//              DOI: 10.3390/e15104392 | URL: https://www.mdpi.com/1099-4300/15/10/4392
//
//              These tables implement the φ_d(n, l) transition function (Equation 5) which maps
//              a current ordinal pattern index `n` and a position `l` to the successor pattern index.
//              Position `l` = #{r ∈ {0,...,d-1} | x_{t-rτ} >= x_{t+τ}} (Equation 6), i.e., how many
//              of the d previous points (x_t, x_{t-τ}, ..., x_{t-(d-1)τ}) are >= the new point x_{t+τ}.
//
//              Using this table reduces per-update operations from ≤4d-1 to ≤2d (Table 4).
//              The table lookup is O(1); computing position l requires d comparisons.
//
//              Tables are stored as flattened 1D arrays in Row-Major order:
//              table[current_pattern * (d+1) + position_l] = successor_pattern
//
// @author      Arthur Nazarian (@GoemonYae), 2025-12
library("PatternTransitionTables", overlay = false)


//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  SECTION 1: TABLE SIZE CONSTANTS & METADATA  ]------
//----------------------------------------------------------------------------------------------------------------------------- //

// @function    Returns the number of ordinal patterns for a given order d.
//              This equals (d+1)! (factorial), since patterns of order d contain (d+1) points.
// @param d     <simple int> Order of ordinal patterns. Valid range: 2-5.
//              Note: If your indicator uses "embedding dimension D" (number of points), pass D-1.
// @returns     <int> Number of patterns: d=2→6, d=3→24, d=4→120, d=5→720.
export get_num_patterns(int d) =>
    switch d
        2 => 6
        3 => 24
        4 => 120
        5 => 720
        =>
            runtime.error("get_num_patterns(): Dimension d must be 2, 3, 4, or 5. Got: " + str.tostring(d))
            0


// @function    Returns the number of possible positions for the new point.
//              This equals (d+1).
// @param d     <simple int> Order of ordinal patterns. Valid range: 2-5.
//              Note: If your indicator uses "embedding dimension D" (number of points), pass D-1.
// @returns     <int> Number of positions: d+1.
export get_num_positions(int d) =>
    d + 1


// @function    Returns the total table size (number of entries) for Order d.
//              This equals (d+1)! × (d+1).
// @param d     <simple int> Order of ordinal patterns. Valid range: 2-5.
//              Note: If your indicator uses "embedding dimension D" (number of points), pass D-1.
// @returns     <int> Total entries: d=2→18, d=3→96, d=4→600, d=5→4320.
export get_table_size(int d) =>
    get_num_patterns(d) * get_num_positions(d)

//#endregion


//----------------------------------------------------------------------------------------------------------------------------- //
//#region ------[  SECTION 2: TRANSITION TABLE GETTERS  ]------
//----------------------------------------------------------------------------------------------------------------------------- //
//
// Table Layout (Row-Major, Flattened):
//   - For Order d, there are (d+1)! patterns and (d+1) positions.
//   - Entry for pattern `n` and position `l` is at index: n * (d+1) + l
//   - Value at that index is the successor pattern index.
//
//----------------------------------------------------------------------------------------------------------------------------- //


// @function    Returns the precomputed transition table for Order d=2 (Dim 3).
//              Table size: 6 patterns × 3 positions = 18 entries.
// @returns     <array<int>> Flattened transition table φ_2(n, l).
export get_table_d2() =>
    // Declare inside function scope (exported functions cannot access global arrays)
    var array<int> arr_table = array.from(
      0, 3, 4, 0, 3, 4, 0, 3, 4, 1, 2, 5,
      1, 2, 5, 1, 2, 5
      )
    arr_table


// @function    Returns the precomputed transition table for Order d=3 (Dim 4).
//              Table size: 24 patterns × 4 positions = 96 entries.
// @returns     <array<int>> Flattened transition table φ_3(n, l).
export get_table_d3() =>
    var array<int> arr_table = array.from(
      0, 12, 16, 17, 0, 12, 16, 17, 0, 12, 16, 17,
      0, 12, 16, 17, 1, 13, 14, 18, 1, 13, 14, 18,
      1, 13, 14, 18, 1, 13, 14, 18, 2, 3, 15, 19,
      2, 3, 15, 19, 2, 3, 15, 19, 2, 3, 15, 19,
      4, 8, 20, 21, 4, 8, 20, 21, 4, 8, 20, 21,
      4, 8, 20, 21, 5, 9, 10, 22, 5, 9, 10, 22,
      5, 9, 10, 22, 5, 9, 10, 22, 6, 7, 11, 23,
      6, 7, 11, 23, 6, 7, 11, 23, 6, 7, 11, 23
      )
    arr_table


