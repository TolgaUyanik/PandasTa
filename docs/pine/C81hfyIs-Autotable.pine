//@version=5

// @description Output matrix to a table in the most simple and flexible way. autotable() allows to manage
// all the properties of the table which are normally set with table.new() and table.cell() and much more
// (e.g. merge cells on the fly by just suplying a string merge matrix as an argument, where "L" means merge 
// the cell with the cell to the left, and "U" - merge upwards).
// --- USAGE EXAMPLES ---  { 

// The simplest and most straightforward: 
// [pine]
// mxF = matrix.new<float>(3,3, 3.14)
// mxF.autotable(bgcolor = color.rgb(249, 209, 29))  // displays float matrix as a table in the top right corner with defalult settings

// mxS = matrix.new<string>(3,3,"PI")
// // displays string matrix as a table in the top right corner with defalult settings
// mxS.autotable(Ypos = "bottom", Xpos = "right", bgcolor = #b4d400)  

// // displays matrix displaying a string value over a float value in each cell
// mxS.autotable(mxF, Ypos = "middle", Xpos = "center", bgcolor = color.gray, text_color = #86f62a)  
// [/pine]

// Draws this: 
// https://www.tradingview.com/x/YEs4r0ae/


// Tables with headers: 
// [pine]
// if barstate.islast 
//     mxF = matrix.new<float>(3,3, 3.14)
//     mxS = matrix.new<string>(3,3,"PI")
//     arColHeaders = array.from("Col1", "Col2", "Col3")
//     arRowHeaders = array.from("Row1", "Row2", "Row3")

//     // float matrix with col headers
//     mxF.autotable(
//               bgcolor = #fdfd6b
//               , arColHeaders = arColHeaders
//               )  

//     // string matrix with row headers
//     mxS.autotable(arRowHeaders = arRowHeaders, Ypos = "bottom", Xpos = "right", bgcolor = #b4d400)  

//     // string/float matrix with both row and column headers
//     mxS.autotable(mxF
//               , Ypos = "middle", Xpos = "center"
//               , arRowHeaders = arRowHeaders
//               , arColHeaders = arColHeaders
//               , cornerBgClr = #707070, cornerTitle = "Corner\ncell", cornerTxtClr = #ffdc13
//               , bgcolor = color.gray, text_color = #86f62a
//               )  
// [/pine]

// Draws this: 
// https://www.tradingview.com/x/RaGyrkwo/

// A more complex usage example may be found in CSVConfig library.
// END OF USAGE EXAMPLES } 


library("Autotable", overlay = true)

import moebius1977/ToS/1      
import moebius1977/ToStringMx/1 
import moebius1977/RegexLib/1
import kaigouthro/theme_engine/1  as TE // for blinking table
import kaigouthro/theme_presets/2  as TP // for blinking table

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                   AUTOTABLE HELPER FUNCTIONS                                 ┃{

// ━━━━━ size(mx) ━━━━━{
size(_mtx) => _cl = matrix.columns (_mtx) , _rw = matrix.rows(_mtx),  [_rw,_cl]
//}

// ━━━━━  concatMx(matrix<string> mxS, matrix<float> mxF, ... ) ━━━━━ {
// @function Concatenates matrix<string> mxS and matrix<float> mxF by converting each float element to string and 
// right joining (via a _separator) to respective mxS element. (does not change mxS of mxF) 
// @param mxS String matrix to which floats are added (per element)
// @param mxF Float matrix to from whichfloats are added to mxS (per element)
// @param _separator  A separator string, by default "\n" 
// @param _format  A separator string, by default "\n" 
// @returns Returns a new matrix (does not change mxS or mxF) 
method concatMx (matrix<string> mxS, matrix<float> mxF, string _separator = "\n", string _format = "", string nz = na) =>
    mxSr = mxS.rows(), mxSc = mxS.columns()
    mxFr = mxF.rows(), mxFc = mxF.columns()
    if mxSc != mxFc or mxSr != mxFr
        runtime.error(str.format("mSumMx: mxRS and mxF sizes do not match: mxRS is {0}x{1} and mxF is {2}x{3} (Cols x Rows)", mxSc, mxSr, mxFc, mxFr))

    _mxOut = matrix.new<string>(mxSr, mxSc, "")
    for i = 0 to mxSr - 1
        for j = 0 to mxSc - 1
            _mxOut.set(i,j, mxS.get(i,j) + _separator + mxF.get(i,j).toS(_format, nz = nz))
    _mxOut
//}

// _̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿ CONFIG IMPORT FUNCTIONS _̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿_̿ {

// ━━━━━ impMxS() ━━━━━{
// @function Imports string values from text (comma separated, each line corresponds to a row).  If text is longer just 
// ignores extra values. Trims values from spaces.
method impMxS (string s, int rows, int cols) =>
    matrix<string> mx = na
    if s != ""
        mx := matrix.new<string>(rows,cols,"")
        inS = s
        _r = -1     
        while inS != "" and _r < rows -1
            _r+=1
            _c=-1
            [_line, _lnbr, _remainder] = inS.feedRgx("\n")
            inS := _remainder
            inS1 = _line
            while inS1 != "" and _c < cols - 1
                _c+=1
                [_item,_lnbr1,_remainder1] = inS1.feedRgx(",")
                mx.set(_r, _c, str.trim(_item))
                inS1 := _remainder1
                // log.info("\n--- ITEM ---\n{0}\n---REMAINDER---\n {1}\n", _item, _remainder1)
    mx
// END OF impMxS()}

// ━━━━━ impMxF() ━━━━━{
// @function Imports float values from text (comma separated, each line corresponds to a row).  If text is longer just 
// ignores extra values. Trims values from spaces. Tries to convert string to float using str.tonumber()
method impMxF (string s, int rows, int cols) =>
    matrix<float> mx = na
    if s != ""
        mx := matrix.new<float>(rows,cols,na)
        inS = s
        _r = -1     
        while inS != "" and _r < rows -1
            _r+=1
            _c=-1
            [_line, _lnbr, _remainder] = inS.feedRgx("\n")
            inS := _remainder
            inS1 = _line
            // log.info("\n--- LINE ---\n{0}\n", _line)
            while inS1 != "" and _c < cols - 1
                _c+=1
                [_item,_lnbr1,_remainder1] = inS1.feedRgx(",")
                mx.set(_r, _c, str.tonumber(str.trim(_item)))
                inS1 := _remainder1
                // log.info("\n--- ITEM ---\n{0}\n---REMAINDER---\n {1}\n", _item, _remainder1)
    mx
 


// END OF impMxF()}

// ━━━━━ impArS() ━━━━━{
method impArS(string s, int rows, int cols) =>
    mx = impMxS(s,rows,cols)
    array<string> arNa = na
    if na(mx)
        na // arNa
    else
        mx.row(0)
// END OF impArS()}

// Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲ END OF CONFIG IMPORT FUNCTIONS Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲Δ̲}

// ━━━━━ method growArRCp() ━━━━━ {
// @function Grows array up to `n`, returns a copy if grown OR original array if no need to grow (if `n <= ar.size()`)
// @param N (int) Required number of elements in the array 
// @param val Value to be added to array to grow to n. 
// @returns (array) A copy of original array with added `na` elements so that the resulting array's size is N.
_growArRCp(ar,n,val)=>                              
    gap = math.max(0, n - ar.size())
    if gap > 0 
        arC = ar.copy()
        for i = 0 to gap-1
            arC.push(val)
        arC
    else
        ar

// @function Grows array up to `n`, returns a copy if grown OR original array if no need to grow (if `n <= ar.size()`)
// @param N (int) Required number of elements in the array 
// @param val Value to be added to array to grow to n. 
// @returns (array) A copy (if grown) of original array (if not altered) with added `na` elements so that the resulting 
// array's size is `n`.
method growRCp(string[] ar, int n, string val = na)   => _growArRCp(ar, n, val)

// END OF growArCp() }

// ━━━━━ method matchArSzCp() ━━━━━ {
// @function Brings array size to  `n` by adding `val` to the end or cutting elements from the end. 
// Returns a copy if grown OR original array if no need to grow (if `n <= ar.size()`)
// @param N (int) Required number of elements in the array 
// @param val Value to be added to array to grow to n. 
// @returns (array) A copy (if grown) or original array (if shortened or not altered) with added `na` elements so that the resulting array's size is N.
_matchArRSzCp(ar,n, val)=>                              
    gap = math.max(0, n - ar.size())
    if gap > 0 
        _growArRCp(ar, n, val)
    else if gap <= 0 
        ar.slice(0, n)

method matchSzRCp(string[] ar, int n, string val=na)   => _matchArRSzCp(ar, n, val)
// END OF growArCp() }



// ^^^ END OF HELPER FUNCTIONS }
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                  TABLE MERGE MATRIX TYPES AND METHODS                        ┃ {
// This sections contains methods for handling `matrix<string> mmMerge` argument, which is a matrix
// determining how the cells will be merged within the table. 
// Format is very simple: 
// 		"L" - merge cell with the one on the left,
// 		"U" - merge cell with the one above

// ♦♦♦♦♦♦ RECT TYPE ♦♦♦♦♦♦ {

// --- +++ rect type +++ --- {
// @type Just int (x1,y1)-(x2,y2) coordinates (used for rectangles within a matrix)
type rect
    int     x1
    int     y1
    int     x2
    int     y2
//}

// --- eq(rect1, rect2) ---{
// @function True if r1 and r2 have all the same coordinates
method eq(rect r1, rect r2) => na(r1) ? false : na(r2) ? false : (r1.x1 == r2.x1) and (r1.y1 == r2.y1) and (r1.x2 == r2.x2) and (r1.y2 == r2.y2)
//}

// --- toS(rect) ---{
// @function Returns "(x1,y1)-(x2,y2)" string representation of the rectangle
method toS(rect this) => str.format("({0}, {1})-({2}, {3})", this.x1, this.y1, this.x2, this.y2)
//}

// --- copy(rect) ---{
// @function Copies rect
method copy(rect this) => rect.new(this.x1, this.y1, this.x2, this.y2)
//}

// ▲▲▲ END OF RECT TYPE ▲▲▲ }

// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ SPREAD MATRIX FUNCTIONS ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {
// These functions fill mxMerge matrix so that rectangles corresponding to each ultimately merged cell:
// 		- have "T" in its top left corner cell 
//		- have "U" below "T" all the way down to the bottom of the rectangle
// 		- have "L" in all other cells 
// They do so going thruogh the cells line by line and spreading each rectagle iteratively the the left, then upwards,
// then to the right until spreading stops.
// In the end spread(mxMerge) function returns array of rectangles used as na arg for  tbl.cellMerge() method 

// ━━━━━ spreadL() ━━━━━{
// @function If left border of rect has "L" in any of its cells expands rect by 1 column to the left.
method spreadL(matrix<string> this, rect r) =>
    if r.x1 > r.x2 or r.y1 > r.y2 
        runtime.error(str.format("spreadL: x1 {0} > x2 {1} of y1 {2} > y2 {3}", r.x1, r.y1, r.x2, r.y2))

    _spreadL = false
    if r.x1 > 0 
        for y = r.y1 to r.y2
            if this.get(y, r.x1) == "L"
                _spreadL := true

    r.x1 := _spreadL ? r.x1-1 : r.x1
    this
//}

// ━━━━━ spreadU() ━━━━━ {
// @function If upper border of rect has "U" in any of its cells expands rect by 1 row to the upside.
method spreadU(matrix<string> this, rect r) =>
    if r.x1 > r.x2 or r.y1 > r.y2 
        runtime.error(str.format("spreadU: x1 {0} > x2 {1} of y1 {2} > y2 {3}", r.x1, r.y1, r.x2, r.y2))

    _spreadU = false
    if r.y1 > 0 
        for x = r.x1 to r.x2
            if this.get(r.y1, x) == "U"
                _spreadU := true

    r.y1 := _spreadU ? r.y1-1 : r.y1
    this
//}

// ━━━━━ spreadR() ━━━━━ {
// @function If the column to the right of the rect has "L" expands rect by 1 column to the right
method spreadR(matrix<string> this, rect r) =>
    if r.x1 > r.x2 or r.y1 > r.y2 
        runtime.error(str.format("spreadR: x1 {0} > x2 {1} of y1 {2} > y2 {3}", r.x1, r.y1, r.x2, r.y2))

    _spreadR = false
    if r.x2 < this.columns()-1 
        for y = r.y1 to r.y2
            if this.get(y, r.x2+1) == "L"
                _spreadR := true

    r.x2 := _spreadR ? r.x2+1 : r.x2
    this
//}

// ━━━━━ spread() ━━━━━{
// @functions Starting from a given rectangle iterates spreading left, up and right consequtively until spreading stops.
method spread(matrix<string> this, rect r, int N = 99999999999) =>
    if r.x1 > r.x2 or r.y1 > r.y2 
        runtime.error(str.format("spreadR: x1 {0} > x2 {1} of y1 {2} > y2 {3}", r.x1, r.y1, r.x2, r.y2))

    rect _r = na
    n = 0 
    while not eq(_r, r)  and n < N
        _r := r.copy()
        this.spreadL(r).spreadU(r).spreadR(r)
        n+=1
    this

// }

// ━━━━━ fill() ━━━━━{
// @function Fills rect with T in the corner, U's below it and L all the rest
method fill(matrix<string> this, rect r) =>
    if r.x1 > r.x2 or r.y1 > r.y2 
        runtime.error(str.format("fill: x1 {0} > x2 {1} of y1 {2} > y2 {3}", r.x1, r.y1, r.x2, r.y2))

    // fill top left cell
    this.set(r.y1, r.x1, "T")

    // fill first column below the corner cell
    if r.y1 < r.y2
        for y = r.y1+1 to r.y2
            this.set(y, r.x1, "U")

    // fill the rest 
    if r.x1 < r.x2
        y = r.y1
        while y <= r.y2
            for x = r.x1+1 to r.x2
                this.set(y, x, "L")
            y+=1
    this
//}

// ━━━━━ _getRect(this, int x, int y ) ━━━━━{
// @function Given that matrix is complete (all merges/spreads complete) and x1,y1 are the coordinates of one of the 
// "T"'s (corners of the merged cells) returns rect object corresponding to the merged cell  
_getRect(matrix<string> this, int x1, int y1) =>
    y2 = y1+1
    while y2 < this.rows()
        if this.get(y2, x1) != "U"
            break
        y2+=1
    y2-=1

    x2 = x1+1
    while x2 < this.columns()
        if this.get(y1, x2) != "L"
            break
        x2+=1
    x2-=1

    rect.new(x1,y1,x2,y2)




//}

// ━━━━━ spread() ━━━━━{
// @functions Iterates all cells  spreading each of them as far as possible. As a result some rects will merge.
method spread(matrix<string> this, int N = 999999999999) =>
    ar = array.new<rect>() 
    // spread al cells to max
    if this.rows() > 0 and this.columns() > 0 
        for x = 0 to this.columns()-1
            for y = 0 to this.rows()-1
                if this.get(y,x) == "L" or this.get(y,x) == "U" 
                    r = rect.new(x,y,x,y)
                    this.spread(r, N).fill(r)


    // create array<rect> of all the merged cells
        for x = 0 to this.columns()-1
            for y = 0 to this.rows()-1
                if this.get(y,x) == "T" 
                    _r = _getRect(this,x,y)
                    ar.push(_r)
                    
    ar

// }

// ━━━━━ method tbl.cellMerge(arRect) ━━━━━ {
method cellMerge(table this, array<rect> ar) =>
    for r in ar
        table.merge_cells(this, r.x1, r.y1,r.x2,r.y2)
// END OF cellMerge()}

// ━━━━━ method tbl.cellMerge(mxMrg) ━━━━━ {
// @function Merges cells in this table based on the mxMrg matrix. 
// Cells of mxMrg with "L" values are merged with the cells to the left
// Cells of mxMrg with "U" values are merged with the cells above
method cellMerge(table this, matrix<string> mxMrg, string dbgS = "") =>
	if not na(mxMrg)
	    this.cellMerge(mxMrg.spread())
    else 
        if dbgS != ""
            log.info("\n---cellMerge--- na(mxMrg) is na\ndbgS = {0}", dbgS)
        na
	this
// END OF cellMerge()}

// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF SPREAD MATRIX FUNCTIONS ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ } 

// ┃^^^ END OF TABLE MERGE MATRIX TYPES AND METHODS 							  ┃}
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃                  AUTOTABLE							                          ┃ {

// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ AUTOTABLE FUNCTIONS ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

// ━━━━━ mtable() - creates table ━━━━━ {
// @function    Creates a table with mxValS and mxValF as values (normally in each cell a string value over float value). 
// All arguments of `table.new()` and `table.cell()` (and more) can be supplied as (matrix) arguments (e.g. cell merge matrix).             
// @param mxValS                 (matrix<string>   ) Cell text values     
// @param tbl                    (table            ) (Optional) If supplied, this table will be deleted.
// @param mxBgColor              (matrix<color>    ) (Optional) like bgcolor argument in table.cell()
// @param mxTextColor            (matrix<color>    ) (Optional) like text_color argument in table.cell()     
// @param mxTt                   (matrix<string>   ) (Optional) like tooltip argument in table.cell()
// @param mxMerge                (matrix<string>   ) (Optional) like Matrix determining how cells will be merged. "L" - cell merges to the left, "U" - upwards.     
// @param mxWidth                (matrix<float>    ) (Optional) like width argument in table.cell()
// @param mxHeight               (matrix<float>    ) (Optional) like height argument in table.cell()
// @param mxHalign               (matrix<string>   ) (Optional) like text_halign argument in table.cell()     
// @param mxValign               (matrix<string>   ) (Optional) like text_valign argument in table.cell()          
// @param mxTextSize             (matrix<string>   ) (Optional) like text_size argument in table.cell()
// @param mxFontFamily           (matrix<string>   ) (Optional) like text_font_family argument in table.cell()         
// @param arColHeaders            (string[]         ) (Optional) Array of column headers. If not na a header row is added.          
// @param arRowHeaders            (string[]         ) (Optional) Array of row headers. If not na a header column is added.          
// @param cornerTitle            (string           ) (Optional) If both row and column headers are supplied allows to set the value of the corner cell.           
// @param mergeAllColHeaders      (bool             ) (Optional) Allows to print a table title instead of column headers, merging all header row cells and leaving just the value of the first cell. For more flexible options use matrix arguments leaving header/row arguments na.
// @param mergeAllRowHeaders      (bool             ) (Optional) Allows to print one text value merging all header row cells and leaving just the value of the first cell. For more flexible options use matrix arguments leaving header/row arguments na.
// @param bgcolor         (color            ) (Optional) bgcolor to be used if mxBgColor is not supplied             
// @param text_color        (color            ) (Optional) text_color to be used if mxTextColor is not supplied
// @param colHeadersBgColor       (color            ) (Optional) bgcolor for header row
// @param colHeadersTxtColor      (color            ) (Optional) text_color for header row
// @param rowHeadersBgColor       (color            ) (Optional) bgcolor for header column             
// @param rowHeadersTxtColor      (color            ) (Optional) text_color for header column             
// @param cornerBgClr            (color            ) (Optional) bgcolor for the corner cell
// @param cornerTxtClr           (color            ) (Optional) text_color for the corner cell
// @param frame_color            (color 		   ) (Optional) frame_color  like in table.new()          
// @param frame_width            (int 			   ) (Optional) frame_width  like in table.new()         
// @param border_color           (color 		   ) (Optional) border_color like in table.new()         
// @param border_width           (int 			   ) (Optional) border_width like in table.new()         
// @param text_size              (string           ) (Optional) text_size to be used if mxTextSize is not supplied                  
// @param Ypos                   (string           ) (Optional) "top", "bottom" or "center" 
// @param Xpos                   (string           ) (Optional) "left", "right", or "center"
// @param tableWidth             (float            ) (Optional) Overrides table width if cell widths are non zero. E.g. if there are four rows 
//   and cell widths are 20 (either as set via cellH or via mxWidth) then if tableHeigh is set to e.g. 50 then cell 
//   widths will be 50 * (20 / 80), where 80 is 20*4 = total width of all cells. Works simialar for widths set via 
//   mxWidth - determines max sum of widths across all cloumns of mxWidth and adjusts cell widths proportionally to it.
//   If cell widths are 0 (i.e. auto-adjust) tableWidth has no effect.         
// @param tableHeight            (float            ) (Optional) Overrides table height if cell heights are non zero. E.g. if there are four rows 
//   and cell heights are 20 (either as set via cellH or via mxHeight) then if tableHeigh is set to e.g. 50 then cell 
//   heights will be 50 * (20 / 80), where 80 is 20*4 = total height of all cells. Works simialar for heights set via 
//   mxHeight - determines max sum of heights across all cloumns of mxHeight and adjusts cell heights proportionally to it.
//   If cell heights are 0 (i.e. auto-adjust) tableHeight has no effect.         
// @param cellW                  (float            ) (Optional) cell width to be used if a value in mxWidth is no supplied  
// @param cellH                  (float            ) (Optional) cell height to be used if a value in mxHeight is no supplied   
// @param halign                 (string           ) (Optional) cell text_halign value to be used if a value in mxHalign is no supplied       
// @param valign                 (string           ) (Optional) cell text_valign value to be used if a value in mxValign is no supplied            
// @param font_family            (string           ) (Optional) cell text_font_family value to be used if a value in mxFontFamily is no supplied                     
// @param format                 (string           ) (Optional) format string like in str.format() used to format numerical values     
// @param nz                     (string           ) (Optional) Determines how na numerical values are displayed.   
// @param force_overlay          (simple bool      ) (Optional) If true draws table on main pane.          
// @param dbgS                   (string           ) (Optional) For debug. 
// @returns A newly created beautiful table. 
mtable( 
      matrix<string>            mxValS                          // values
      , table                   tbl                               = na
      , matrix<color>           mxBgColor                         = na // bgColor
      , matrix<color>           mxTextColor                        = na // text color
      , matrix<string>          mxTt                            = na // tooltips
      , matrix<string>          mxMerge                         = na 
      , matrix<float>           mxWidth                         = na 
      , matrix<float>           mxHeight                        = na 
      , matrix<string>          mxHalign                        = na 
      , matrix<string>          mxValign                        = na 
      , matrix<string>          mxTextSize                      = na 
      , matrix<string>          mxFontFamily                  = na 
      , string[]                arColHeaders                     = na 
      , string[]                arRowHeaders                     = na
      , string                  cornerTitle                     = na   
      , bool                    mergeAllColHeaders               = false 
      , bool                    mergeAllRowHeaders               = false 
      , color                   bgcolor                  = #fdfd6b
      , color                   text_color                 = #514242
      , color                   colHeadersBgColor                = #ecc504
      , color                   colHeadersTxtColor               = #514242
      , color                   rowHeadersBgColor                = #ecc504
      , color                   rowHeadersTxtColor               = #514242
      , color                   cornerBgClr                     = #ecc504
      , color                   cornerTxtClr                    = #514242
	  , color 					frame_color  			        = na
	  , int 					frame_width  			        = 1
	  , color 					border_color 			        = na
	  , int 					border_width 			        = 1      
      , string                  Ypos                            = 'top'
      , string                  Xpos                            = 'right'
      , float                   tableWidth                      = 0
      , float                   tableHeight                     = 0
      , float                   cellW                           = 0
      , float                   cellH                           = 0
	  , float 					colHeadersHeight  			    = 0
	  , float 					rowHeadersWidth  			    = 0
      , string                  halign                          = text.align_left
      , string                  valign                          = text.align_center
	  , string                  text_size                       = size.auto
      , string                  font_family                     = font.family_default
      , string                  nz                              = na
      , const bool              force_overlay                   = false
      , string                  dbgS                            = ""
      ) =>      


    if na(mxValS) 
        runtime.error("mtable: mxValS is na")


    // --- === PREPARE PARAMS  === ---  {
    // if matrices not given - create, if given of wrong size - cast error 
    [_rws,_cls] = size(mxValS) 

    
    // prepare vars, will replace these with shallow copies if we will have to modify these because of headers
    // (if one of the args is var modifying it will at least cause size mismatch between that var matrix and mxValS on next iteration of this function)
        
    _hasRowHeaders = not na(arRowHeaders) 
    _hasColHeaders = not na(arColHeaders) // will have to modify arg matrices, so shallow copy will be needed
    _hasHeaders = _hasRowHeaders or _hasColHeaders // will have to modify arg matrices, so shallow copy will be needed



    // max sum all cell widths for all the rows. Used to proportionally determine cell widths'
    _maxWidth = if na(mxWidth)
        _rowHeadersWidth = if rowHeadersWidth == 0 
            cellW
        else
            rowHeadersWidth
        tableWidth == 0 ?  100 : cellW * _cls + _rowHeadersWidth * (_hasRowHeaders ? 1 : 0)
    else
        // if rowHeadersWidth not supplied, assume from mxWidth(0,0)
        _rowHeadersWidth = if rowHeadersWidth == 0 
            mxWidth.get(0,0)
        else
            rowHeadersWidth
        mxWidth             .mult( array.new<float>(_cls,1)  )     .max() + _rowHeadersWidth * (_hasRowHeaders ? 1 : 0)// max of sums of every row

    // max sum all cell heights for all the columns. Used to proportionally determine cell heights'
    _maxHeight = if na(mxHeight)
        _colHeadersHeight = if colHeadersHeight == 0 
            cellH
        else
            colHeadersHeight
        tableHeight == 0 ?  100 : cellH * _rws + _colHeadersHeight * (_hasColHeaders ? 1 : 0)
    else
        _colHeadersHeight = if colHeadersHeight == 0 
            mxHeight.get(0,0)
        else
            colHeadersHeight

        mxWidth.transpose() .mult( array.new<float>(_rws,1)  )     .max() + _colHeadersHeight * (_hasColHeaders ? 1 : 0)  // max of sums of every column



    // END OF PREPARE PARAMS}

    // --- === PREPARE MATRICES  === ---  {


    // --- CONST na MATRICES  ----{
    mxBgColorNa            = matrix.new<color     >(_rws, _cls, bgcolor       )                    
    mxTextColorNa           = matrix.new<color     >(_rws, _cls, text_color      )                    
    // var mxTtNa               = matrix.new<string    >(_rws, _cls, ""                   )        
    // var mxMergeNa            = matrix.new<string    >(_rws, _cls, ""                   )        
    // var mxWidthNa            = matrix.new<float     >(_rws, _cls, 0                    )    
    // var mxHeightNa           = matrix.new<float     >(_rws, _cls, 0                    )    
    // var mxHalignNa           = matrix.new<Halign    >(_rws, _cls, text.align_left      )                    
    // var mxValignNa           = matrix.new<Valign    >(_rws, _cls, text.align_center    )                    
    // var mxTextSizeNa         = matrix.new<TextSize  >(_rws, _cls, size.auto            )                
    // var mxFontFamilyNa    = matrix.new<string    >(_rws, _cls, false                )        

    //}

    // --- INIT MATRICES --- {
    // TO_DO?: _mxBgColor and _mxTextColor are created on every call. 
    // Actually, we only need then when there are headers (any of), so can only create them then.
    _mxValS         = mxValS
    _mxBgColor = if na(mxBgColor) // since colors of headers may be different we need this matrix
        mxBgColorNa
    else 
        if mxBgColor.rows() != _rws or mxBgColor.columns() != _cls
            runtime.error(str.format("mtable(): mxBgColor size mismatch: mxBgColor is {0}x{1}, mxValS is {2}x{3} (R x C)", mxBgColor.rows(), mxBgColor.columns(), _rws, _cls))
        if _hasHeaders
            mxBgColor.copy() // a shallow copy 
        else
            mxBgColor
    
    _mxTextColor = if na(mxTextColor) // since colors of headers may be different we need this matrix
        mxTextColorNa
    else 
        if mxTextColor.rows() != _rws or mxTextColor.columns() != _cls
            runtime.error(str.format("mtable(): mxTextColor size mismatch: mxTextColor is {0}x{1}, mxValS is {2}x{3} (R x C)", mxTextColor.rows(), mxTextColor.columns(), _rws, _cls))
        if _hasHeaders
            mxTextColor.copy()
        else
            mxTextColor
    
    _mxTt = if not na(mxTt)
        if mxTt.rows() != _rws or mxTt.columns() != _cls
            runtime.error(str.format("mtable(): mxTt size mismatch: mxTt is {0}x{1}, mxValS is {2}x{3} (R x C)", mxTt.rows(), mxTt.columns(), _rws, _cls))
        if _hasHeaders
            mxTt.copy()
        else
            mxTt

    _mxMerge = if not na(mxMerge)
        if mxMerge.rows() != _rws or mxMerge.columns() != _cls
            runtime.error(str.format("mtable(): mxMerge size mismatch: mxMerge is {0}x{1}, mxValS is {2}x{3} (R x C)", mxMerge.rows(), mxMerge.columns(), _rws, _cls))
        if _hasHeaders
            mxMerge.copy()
        else
            mxMerge

    _mxWidth = if not na(mxWidth)
        if mxWidth.rows() != _rws or mxWidth.columns() != _cls
            runtime.error(str.format("mtable(): mxWidth size mismatch: mxWidth is {0}x{1}, mxValS is {2}x{3} (R x C)", mxWidth.rows(), mxWidth.columns(), _rws, _cls))
        if _hasHeaders
            mxWidth.copy()
        else
            mxWidth

    _mxHeight = if not na(mxHeight)
        if mxHeight.rows() != _rws or mxHeight.columns() != _cls
            runtime.error(str.format("mtable(): mxHeight size mismatch: mxHeight is {0}x{1}, mxValS is {2}x{3} (R x C)", mxHeight.rows(), mxHeight.columns(), _rws, _cls))
        if _hasHeaders
            mxHeight.copy()
        else
            mxHeight

    _mxHalign = if not na(mxHalign)
        if mxHalign.rows() != _rws or mxHalign.columns() != _cls
            runtime.error(str.format("mtable(): mxHalign size mismatch: mxHalign is {0}x{1}, mxValS is {2}x{3} (R x C)", mxHalign.rows(), mxHalign.columns(), _rws, _cls))
        if _hasHeaders
            mxHalign.copy()
        else
            mxHalign

    _mxValign = if not na(mxValign)
        if mxValign.rows() != _rws or mxValign.columns() != _cls
            runtime.error(str.format("mtable(): mxValign size mismatch: mxValign is {0}x{1}, mxValS is {2}x{3} (R x C)", mxValign.rows(), mxValign.columns(), _rws, _cls))
        if _hasHeaders
            mxValign.copy()
        else
            mxValign

    _mxTextSize = if not na(mxTextSize)
        if mxTextSize.rows() != _rws or mxTextSize.columns() != _cls
            runtime.error(str.format("mtable(): mxTextSize size mismatch: mxTextSize is {0}x{1}, mxValS is {2}x{3} (R x C)", mxTextSize.rows(), mxTextSize.columns(), _rws, _cls))
        if _hasHeaders
            mxTextSize.copy()
        else
            mxTextSize

    _mxFontFamily = if not na(mxFontFamily)
        if mxFontFamily.rows() != _rws or mxFontFamily.columns() != _cls
            runtime.error(str.format("mtable(): mxFontFamily size mismatch: mxFontFamily is {0}x{1}, mxValS is {2}x{3} (R x C)", mxFontFamily.rows(), mxFontFamily.columns(), _rws, _cls))
        if _hasHeaders
            mxFontFamily.copy()
        else
            mxFontFamily

    //END OF INIT MATRICES}

    // END OF PREPARE MATRICES}

    // --- ADD HEADERS --- {
    _arRowHeaders    = arRowHeaders 
    _arColHeaders    = arColHeaders  

    if _hasHeaders 
        // _arColHeaders    := arColHeaders.copy() // commented since it is not modified 
        _mxValS         := mxValS.copy()
   
        // if column headers given - add headers row to all other matrices
        if not na(_arColHeaders)

            // grow or trim array to match _cls
            _arColHeaders := arColHeaders.matchSzRCp(_cls)

            _mxValS.add_row(0,_arColHeaders)

            _mxBgColor.add_row(0,array.new<color>(_cls,colHeadersBgColor))
            _mxTextColor.add_row(0,array.new<color>(_cls,colHeadersTxtColor))

            if not na(_mxTt)
                // _mxTt             .add_row(0, _mxTt.row(0)) 
                _mxTt             .add_row(0) 
            if not na(_mxMerge)
				_mxMerge          .add_row(0, _mxMerge.row(0))
            if not na(_mxWidth)
				_mxWidth          .add_row(0, _mxWidth.row(0))
            if not na(_mxHeight)
				_mxHeight         .add_row(0, _mxHeight.row(0))
            if not na(_mxHalign)
				_mxHalign         .add_row(0, _mxHalign.row(0))
            if not na(_mxValign)
				_mxValign         .add_row(0, _mxValign.row(0))
            if not na(_mxTextSize)
				_mxTextSize       .add_row(0, _mxTextSize.row(0))
            if not na(_mxFontFamily)
				_mxFontFamily     .add_row(0, _mxFontFamily.row(0))

            _rws+=1


        // if row headers are given - add a first column to all other matrices
        if not na(_arRowHeaders)

            // grow or trim array to match _rws
            _arRowHeaders := arRowHeaders.matchSzRCp(_hasColHeaders ? _rws -1 : _rws )
            // if both row and col headers - add corner cell to row headers 
            if not na(_arColHeaders)
                _arRowHeaders.unshift("")


            _mxValS                 .add_col(0,_arRowHeaders)
            _mxBgColor                .add_col(0,array.new<color>(_rws,rowHeadersBgColor))
            _mxTextColor               .add_col(0,array.new<color>(_rws,rowHeadersTxtColor))

            if not na(_arColHeaders)
                _mxValS.set(0,0,cornerTitle)
                _mxBgColor.set(0,0,cornerBgClr)
                _mxTextColor.set(0,0,cornerTxtClr)




            if not na(_mxTt)
                // _mxTt             .add_col(0, _mxTt.col(0)) 
                _mxTt               .add_col(0) 
            if not na(_mxMerge)
				_mxMerge            .add_col(0, _mxMerge.col(0))
            if not na(_mxWidth)
				_mxWidth            .add_col(0, _mxWidth.col(0))
            if not na(_mxHeight)
				_mxHeight           .add_col(0, _mxHeight.col(0))
            if not na(_mxHalign)
				_mxHalign           .add_col(0, _mxHalign.col(0))
            if not na(_mxValign)
				_mxValign           .add_col(0, _mxValign.col(0))
            if not na(_mxTextSize)
				_mxTextSize         .add_col(0, _mxTextSize.col(0))
            if not na(_mxFontFamily)
				_mxFontFamily       .add_col(0, _mxFontFamily.col(0))

            _cls+=1



    // END OF ADD HEADERS }

    // --- CREATE TABLE --- {
    // delete existing table
    if not na(tbl)
        tbl.delete()

    table _table = na
    // if barstate.islast  // let autotable() behave like table.new(), leaving control on the user as to when to run it
    _table := table.new (
                              position          = Ypos  + '_' + Xpos
                              , columns         = _cls
                              , rows            = _rws
                              , bgcolor         = bgcolor
                              , frame_color     = frame_color  
                              , frame_width     = frame_width  
                              , border_color    = border_color 
                              , border_width    = border_width 
                              , force_overlay   = force_overlay
                              ) 


    for _c = 0  to _cls  -1  by 1
        for _r  = 0 to _rws  -1 by 1
            _ValS       = _mxValS.get(_r,_c)
            _bgcolor    = _mxBgColor.get(_r , _c) 
            _text_color = _mxTextColor.get(_r , _c) 

            _text_size      = if na(mxTextSize)   
                text_size
            else
                _v = _mxTextSize.get(_r, _c)
				na(_v) ? text_size : _v     

            _tooltip      = if na(mxTt)   
                ""
            else
                _mxTt.get(_r, _c)     

            _width      = if na(mxWidth)   
                cellW 
            else
                _v = _mxWidth.get(_r, _c)
				na(_v) ? cellW : _v     

            // tableWidth overrides cell widths, so that if. e.g. tableWidth = 50 and cellW = 30 for a two column 
            // table then each column will be 30% of 50% and not 30% of all visible part of the screen
            if tableWidth != 0 
                _width := tableWidth * ( _width / _maxWidth)


            _height      = if na(mxHeight)   
                cellH 
            else
                _v = _mxHeight.get(_r, _c)
				na(_v) ? cellH : _v     

            // tableWidth overrides cell widths, so that if. e.g. tableWidth = 50 and cellW = 30 for a two column 
            // table then each column will be 30% of 50% and not 30% of all visible part of the screen
            if tableHeight != 0 
                _height := tableHeight * ( _height / _maxHeight)


            _halign      = if na(mxHalign)   
                halign 
            else
                _v = _mxHalign.get(_r, _c)
                na(_v) ? halign : _v     

            _valign      = if na(mxValign)   
                valign 
            else
                _v = _mxValign.get(_r, _c)
				na(_v) ? valign : _v     

            _font_family      = if na(mxFontFamily)   
                font_family 
            else
                _v = _mxFontFamily.get(_r, _c)
				na(_v) ? font_family : _v     

            table.cell(
                              table_id              = _table
                              , column              = _c 
                              , row                 = _r
                              , text                = _ValS 
                              , width               = _width 
                              , height              = _height 
                              , text_color          = _text_color 
                              , text_halign         = _halign 
                              , text_valign         = _valign 
                              , text_size           = _text_size 
                              , bgcolor             = _bgcolor 
                              , tooltip             = _tooltip 
                              , text_font_family    = _font_family 
                          )

    // END OF CREATE TABLE }

    // --- MERGE CELLS --- {
    _table.cellMerge(_mxMerge, dbgS)
    if _hasColHeaders and mergeAllColHeaders
        _table.merge_cells(_hasRowHeaders ? 1 : 0, 0, _cls-1, 0)
    if _hasRowHeaders and mergeAllRowHeaders
        _table.merge_cells(0, _hasColHeaders ? 1 : 0, 0, _rws-1)
    // }

    _table
//}

// ━━━━━ mtableFOL() - creates table with forced overlay ━━━━━ {
// @function    Wrapper for calling mtable with force_overlay = true arg (required since library funcs cannot have 
// const args whereas table.new() requires const bool force_overlay.
mtableFOL(
      matrix<string>            mxValS                      // values
      , table                   tbl                         = na
      , matrix<color>           mxBgColor                     = na // bgColor
      , matrix<color>           mxTextColor                    = na // text color
      , matrix<string>          mxTt                        = na // tooltips
      , matrix<string>          mxMerge                     = na 
      , matrix<float>           mxWidth                     = na 
      , matrix<float>           mxHeight                    = na 
      , matrix<string>          mxHalign                    = na 
      , matrix<string>          mxValign                    = na 
      , matrix<string>          mxTextSize                  = na 
      , matrix<string>          mxFontFamily             = na 
      , string[]                arColHeaders                 = na 
      , string[]                arRowHeaders                 = na
      , string                  cornerTitle                 = na   
      , bool                    mergeAllColHeaders               = false 
      , bool                    mergeAllRowHeaders               = false 
      , color                   bgcolor                  = #fdfd6b
      , color                   text_color                 = #514242
      , color                   colHeadersBgColor                = #ecc504
      , color                   colHeadersTxtColor               = #514242
      , color                   rowHeadersBgColor                = #ecc504
      , color                   rowHeadersTxtColor               = #514242
      , color                   cornerBgClr                     = #ecc504
      , color                   cornerTxtClr                    = #514242
	  , color 					frame_color  				= na
	  , int 					frame_width  				= 1
	  , color 					border_color 				= na
	  , int 					border_width 				= 1      
      , string                  text_size                   = size.auto
      , string                  Ypos                        = 'top'
      , string                  Xpos                        = 'right'
      , float                   tableWidth                      = 0
      , float                   tableHeight                     = 0
      , float                   cellW                      = 0
      , float                   cellH                      = 0
	  , float 					colHeadersHeight  			    = 0
	  , float 					rowHeadersWidth  			    = 0
      , string                  halign                     = text.align_left
      , string                  valign                     = text.align_center
      , string                  font_family                = font.family_default
      , string                  nz                         = na
    //   , const bool                    force_overlay               = false
      , string                  dbgS                      = ""
      ) =>      

	mtable(
          mxValS                    = mxValS
          , tbl                     = tbl
          , mxBgColor                 = mxBgColor
          , mxTextColor                = mxTextColor
          , mxTt                    = mxTt
          , mxMerge                 = mxMerge
          , mxWidth                 = mxWidth            
          , mxHeight                = mxHeight                
          , mxHalign                = mxHalign                
          , mxValign                = mxValign                
          , mxTextSize              = mxTextSize                
          , mxFontFamily         = mxFontFamily                    
          , arColHeaders             = arColHeaders
          , arRowHeaders             = arRowHeaders
          , cornerTitle             = cornerTitle
          , mergeAllColHeaders       = mergeAllColHeaders
          , mergeAllRowHeaders       = mergeAllRowHeaders
          , bgcolor         = bgcolor
          , text_color        = text_color
          , colHeadersBgColor        = colHeadersBgColor
          , colHeadersTxtColor       = colHeadersTxtColor
          , rowHeadersBgColor        = rowHeadersBgColor
          , rowHeadersTxtColor       = rowHeadersTxtColor
          , cornerBgClr             = cornerBgClr
          , cornerTxtClr             = cornerTxtClr
		  , frame_color     			= frame_color  
		  , frame_width     			= frame_width  
		  , border_color    			= border_color 
		  , border_width    			= border_width 
          , text_size               = text_size   
          , Ypos               		= Ypos   
          , Xpos               		= Xpos
          , tableWidth              = tableWidth
          , tableHeight             = tableHeight
          , cellW                      = cellW
          , cellH                      = cellH
          , colHeadersHeight       = colHeadersHeight
          , rowHeadersWidth        = rowHeadersWidth
          , halign                 = halign
          , valign                 = valign
          , font_family            = font_family
          , nz                     = nz
          , force_overlay           = true
          , dbgS                    = dbgS
          )
//}

// ━━━━━ mtableNoFOL() - creates table with forced overlay ━━━━━ {
// @function    Wrapper for calling mtable with force_overlay = false arg (required since library funcs cannot have 
// const args whereas table.new() requires const bool force_overlay.
mtableNoFOL(
      matrix<string>            mxValS                  // values
      , table                   tbl                     = na
      , matrix<color>           mxBgColor               = na // bgColor
      , matrix<color>           mxTextColor             = na // text color
      , matrix<string>          mxTt                    = na // tooltips
      , matrix<string>          mxMerge                 = na 
      , matrix<float>           mxWidth                 = na 
      , matrix<float>           mxHeight                = na 
      , matrix<string>          mxHalign                = na 
      , matrix<string>          mxValign                = na 
      , matrix<string>          mxTextSize              = na 
      , matrix<string>          mxFontFamily            = na 
      , string[]                arColHeaders            = na 
      , string[]                arRowHeaders            = na
      , string                  cornerTitle             = na   
      , bool                    mergeAllColHeaders      = false 
      , bool                    mergeAllRowHeaders      = false 
      , color                   bgcolor                 = #fdfd6b
      , color                   text_color              = #514242
      , color                   colHeadersBgColor       = #ecc504
      , color                   colHeadersTxtColor      = #514242
      , color                   rowHeadersBgColor       = #ecc504
      , color                   rowHeadersTxtColor      = #514242
      , color                   cornerBgClr             = #ecc504
      , color                   cornerTxtClr            = #514242
	  , color 					frame_color  		    = na
	  , int 					frame_width  		    = 1
	  , color 					border_color 		    = na
	  , int 					border_width 		    = 1      
      , string                  text_size               = size.auto
      , string                  Ypos                    = 'top'
      , string                  Xpos                    = 'right'
      , float                   tableWidth              = 0
      , float                   tableHeight             = 0
      , float                   cellW                   = 0
      , float                   cellH                   = 0
	  , float 					colHeadersHeight  	    = 0
	  , float 					rowHeadersWidth  	    = 0
      , string                  halign                  = text.align_left
      , string                  valign                  = text.align_center
      , string                  font_family             = font.family_default
      , string                  nz                      = na
    //   , const bool                    force_overlay               = false
      , string                  dbgS                                = ""
      ) =>      
    mtable(
          mxValS                        = mxValS
          , tbl                         = tbl
          , mxBgColor                   = mxBgColor
          , mxTextColor                 = mxTextColor
          , mxTt                        = mxTt
          , mxMerge                     = mxMerge
          , mxWidth                     = mxWidth            
          , mxHeight                    = mxHeight                
          , mxHalign                    = mxHalign                
          , mxValign                    = mxValign                
          , mxTextSize                  = mxTextSize                
          , mxFontFamily                = mxFontFamily                    
          , arColHeaders                 = arColHeaders
          , arRowHeaders                 = arRowHeaders
          , cornerTitle                 = cornerTitle
          , mergeAllColHeaders           = mergeAllColHeaders
          , mergeAllRowHeaders           = mergeAllRowHeaders
          , bgcolor              = bgcolor
          , text_color             = text_color
          , colHeadersBgColor            = colHeadersBgColor
          , colHeadersTxtColor           = colHeadersTxtColor
          , rowHeadersBgColor            = rowHeadersBgColor
          , rowHeadersTxtColor           = rowHeadersTxtColor
          , cornerBgClr                 = cornerBgClr
          , cornerTxtClr                = cornerTxtClr
		  , frame_color     	        = frame_color  
		  , frame_width     	        = frame_width  
		  , border_color    	        = border_color 
		  , border_width    	        = border_width 
          , text_size                   = text_size   
          , Ypos               	        = Ypos   
          , Xpos               	        = Xpos
          , tableWidth                  = tableWidth
          , tableHeight                 = tableHeight
          , cellW                       = cellW
          , cellH                       = cellH
          , colHeadersHeight       = colHeadersHeight
          , rowHeadersWidth        = rowHeadersWidth
          , halign                      = halign
          , valign                      = valign
          , font_family                 = font_family
          , nz                          = nz
          , force_overlay               = false
          , dbgS                      = dbgS
          )
//}

// ━━━━━ autotable ( matrix<float> ) ━━━━━ {
// @function    Creates a table with mxValS and mxValF as values (normally in each cell a string value over float value). 
// All arguments of `table.new()` and `table.cell()` (and more) can be supplied as (matrix) arguments (e.g. cell merge matrix).             
// @param mxValF                 (matrix<float>    ) (Optional) Values
// @param tbl                    (table            ) (Optional) If supplied, this table will be deleted.
// @param mxBgColor              (matrix<color>    ) (Optional) like bgcolor argument in table.cell()
// @param mxTextColor            (matrix<color>    ) (Optional) like text_color argument in table.cell()     
// @param mxTt                   (matrix<string>   ) (Optional) like tooltip argument in table.cell()
// @param mxMerge                (matrix<string>   ) (Optional) like Matrix determining how cells will be merged. "L" - cell merges to the left, "U" - upwards.     
// @param mxWidth                (matrix<float>    ) (Optional) like width argument in table.cell()
// @param mxHeight               (matrix<float>    ) (Optional) like height argument in table.cell()
// @param mxHalign               (matrix<string>   ) (Optional) like text_halign argument in table.cell()     
// @param mxValign               (matrix<string>   ) (Optional) like text_valign argument in table.cell()          
// @param mxTextSize             (matrix<string>   ) (Optional) like text_size argument in table.cell()
// @param mxFontFamily           (matrix<string>   ) (Optional) like text_font_family argument in table.cell()         
// @param arColHeaders            (string[]         ) (Optional) Array of column headers. If not na a header row is added.          
// @param arRowHeaders            (string[]         ) (Optional) Array of row headers. If not na a header column is added.          
// @param cornerTitle            (string           ) (Optional) If both row and column headers are supplied allows to set the value of the corner cell.           
// @param mergeAllColHeaders      (bool             ) (Optional) Allows to print a table title instead of column headers, merging all header row cells and leaving just the value of the first cell. For more flexible options use matrix arguments leaving header/row arguments na.
// @param mergeAllRowHeaders      (bool             ) (Optional) Allows to print one text value merging all header row cells and leaving just the value of the first cell. For more flexible options use matrix arguments leaving header/row arguments na.
// @param bgcolor         (color            ) (Optional) bgcolor to be used if mxBgColor is not supplied             
// @param text_color        (color            ) (Optional) text_color to be used if mxTextColor is not supplied
// @param colHeadersBgColor       (color            ) (Optional) bgcolor for header row
// @param colHeadersTxtColor      (color            ) (Optional) text_color for header row
// @param rowHeadersBgColor       (color            ) (Optional) bgcolor for header column             
// @param rowHeadersTxtColor      (color            ) (Optional) text_color for header column             
// @param cornerBgClr            (color            ) (Optional) bgcolor for the corner cell
// @param cornerTxtClr           (color            ) (Optional) text_color for the corner cell
// @param frame_color            (color 		   ) (Optional) frame_color  like in table.new()          
// @param frame_width            (int 			   ) (Optional) frame_width  like in table.new()         
// @param border_color           (color 		   ) (Optional) border_color like in table.new()         
// @param border_width           (int 			   ) (Optional) border_width like in table.new()         
// @param text_size              (string           ) (Optional) text_size to be used if mxTextSize is not supplied                  
// @param Ypos                   (string           ) (Optional) "top", "bottom" or "center" 
// @param Xpos                   (string           ) (Optional) "left", "right", or "center"
// @param tableWidth             (float            ) (Optional) Overrides table width if cell widths are non zero. E.g. if there are four rows 
//   and cell widths are 20 (either as set via cellH or via mxWidth) then if tableHeigh is set to e.g. 50 then cell 
//   widths will be 50 * (20 / 80), where 80 is 20*4 = total width of all cells. Works simialar for widths set via 
//   mxWidth - determines max sum of widths across all cloumns of mxWidth and adjusts cell widths proportionally to it.
//   If cell widths are 0 (i.e. auto-adjust) tableWidth has no effect.         
// @param tableHeight            (float            ) (Optional) Overrides table height if cell heights are non zero. E.g. if there are four rows 
//   and cell heights are 20 (either as set via cellH or via mxHeight) then if tableHeigh is set to e.g. 50 then cell 
//   heights will be 50 * (20 / 80), where 80 is 20*4 = total height of all cells. Works simialar for heights set via 
//   mxHeight - determines max sum of heights across all cloumns of mxHeight and adjusts cell heights proportionally to it.
//   If cell heights are 0 (i.e. auto-adjust) tableHeight has no effect.         
// @param cellW                  (float            ) (Optional) cell width to be used if a value in mxWidth is no supplied  
// @param cellH                  (float            ) (Optional) cell height to be used if a value in mxHeight is no supplied   
// @param halign                 (string           ) (Optional) cell text_halign value to be used if a value in mxHalign is no supplied       
// @param valign                 (string           ) (Optional) cell text_valign value to be used if a value in mxValign is no supplied            
// @param font_family            (string           ) (Optional) cell text_font_family value to be used if a value in mxFontFamily is no supplied                     
// @param format                 (string           ) (Optional) format string like in str.format() used to format numerical values     
// @param nz                     (string           ) (Optional) Determines how na numerical values are displayed.   
// @param force_overlay          (simple bool      ) (Optional) If true draws table on main pane.          
// @param dbgS                   (string           ) (Optional) For debug. 
// @returns A newly created beautiful table. 
export method autotable(
      matrix<float>     mxValF                      	//
      , table                   tbl                         = na
      , matrix<color>     mxBgColor                   	= na // bgColor
      , matrix<color>     mxTextColor                  	= na // text color
      , matrix<string>    mxTt                      	= na // tooltips
      , matrix<string>    mxMerge                       = na 
      , matrix<float>     mxWidth                       = na 
      , matrix<float>     mxHeight                      = na 
      , matrix<string>    mxHalign                      = na 
      , matrix<string>    mxValign                      = na 
      , matrix<string>    mxTextSize                    = na 
      , matrix<string>    mxFontFamily               = na 
      , string[]          arColHeaders               	= na
      , string[]          arRowHeaders               	= na
      , string            cornerTitle               	= na   
      , bool                    mergeAllColHeaders               = false 
      , bool                    mergeAllRowHeaders               = false 
      , color                   bgcolor                  = #fdfd6b
      , color                   text_color                 = #514242
      , color                   colHeadersBgColor                = #ecc504
      , color                   colHeadersTxtColor               = #514242
      , color                   rowHeadersBgColor                = #ecc504
      , color                   rowHeadersTxtColor               = #514242
      , color                   cornerBgClr                     = #ecc504
      , color                   cornerTxtClr                    = #514242
	  , color 			  frame_color  			 		= na
	  , int 			  frame_width  			 		= 1
	  , color 			  border_color 			 		= #514242
	  , int 			  border_width 			 		= 1      
      , string            text_size                 	= size.auto
      , string            Ypos                  		= 'top'
      , string            Xpos                  		= 'right'            
      , float             tableWidth                      = 0
      , float             tableHeight                     = 0
      , float             cellW                        	= 0
      , float             cellH                        	= 0
	  , float 			  colHeadersHeight  			    = 0
	  , float 			  rowHeadersWidth  			    = 0
      , string            halign                   	= text.align_left
      , string            valign                   	= text.align_center
      , string            font_family              	= font.family_default
      , string            format                    	= ""
      , string            nz                        	= na // to be displayed in place of na
      , simple bool            force_overlay        	= false
      , string            dbgS                      = ""

      )                        =>  


    mxValS = mxValF.toStringMx(format = format, nz = nz)  

	// since table.new() requires const bool force_overlay argument whereas library functions can only have simple bool
	// have to use wrapper functions
	if force_overlay == true 
    	mtableFOL(
          mxValS                    	= mxValS
          , tbl                     = tbl
          , mxBgColor                 	= mxBgColor
          , mxTextColor                	= mxTextColor
          , mxTt                    	= mxTt
          , mxMerge                 	= mxMerge
          , mxWidth                 = mxWidth            
          , mxHeight                = mxHeight                
          , mxHalign                = mxHalign                
          , mxValign                = mxValign                
          , mxTextSize              = mxTextSize                
          , mxFontFamily         = mxFontFamily                    
          , arColHeaders             	= arColHeaders
          , arRowHeaders             	= arRowHeaders
          , cornerTitle             	= cornerTitle
          , mergeAllColHeaders       = mergeAllColHeaders
          , mergeAllRowHeaders       = mergeAllRowHeaders
          , bgcolor        		= bgcolor
          , text_color       		= text_color
          , colHeadersBgColor        	= colHeadersBgColor
          , colHeadersTxtColor       	= colHeadersTxtColor
          , rowHeadersBgColor        	= rowHeadersBgColor
          , rowHeadersTxtColor       	= rowHeadersTxtColor
          , cornerBgClr             	= cornerBgClr
          , cornerTxtClr            	= cornerTxtClr
		  , frame_color     			= frame_color  
		  , frame_width     			= frame_width  
		  , border_color    			= border_color 
		  , border_width    			= border_width 
          , text_size            	    = text_size           
          , Ypos               			= Ypos   
          , Xpos               			= Xpos
          , tableWidth                  = tableWidth
          , tableHeight                 = tableHeight
          , cellW                      	= cellW
          , cellH                      	= cellH
          , colHeadersHeight       = colHeadersHeight
          , rowHeadersWidth        = rowHeadersWidth
          , halign                 	    = halign
          , valign                 	    = valign
          , font_family            	    = font_family
          , nz                     		= nz
          , dbgS                    = dbgS
          )
	else
    	mtableNoFOL(
          mxValS                    = mxValS
          , tbl                     = tbl
          , mxBgColor                 = mxBgColor
          , mxTextColor                = mxTextColor
          , mxTt                    = mxTt
          , mxMerge                 = mxMerge
          , mxWidth                 = mxWidth            
          , mxHeight                = mxHeight                
          , mxHalign                = mxHalign                
          , mxValign                = mxValign                
          , mxTextSize              = mxTextSize                
          , mxFontFamily         = mxFontFamily                    
          , arColHeaders             = arColHeaders
          , arRowHeaders             = arRowHeaders
          , cornerTitle             = cornerTitle
          , mergeAllColHeaders       = mergeAllColHeaders
          , mergeAllRowHeaders       = mergeAllRowHeaders
          , bgcolor         = bgcolor
          , text_color        = text_color
          , colHeadersBgColor        = colHeadersBgColor
          , colHeadersTxtColor       = colHeadersTxtColor
          , rowHeadersBgColor        = rowHeadersBgColor
          , rowHeadersTxtColor       = rowHeadersTxtColor
          , cornerBgClr             = cornerBgClr
          , cornerTxtClr             = cornerTxtClr
		  , frame_color     			= frame_color  
		  , frame_width     			= frame_width  
		  , border_color    			= border_color 
		  , border_width    			= border_width 
          , text_size            = text_size   
          , Ypos               = Ypos   
          , Xpos               = Xpos
          , tableWidth              = tableWidth
          , tableHeight             = tableHeight
          , cellW                      = cellW
          , cellH                      = cellH
          , colHeadersHeight       = colHeadersHeight
          , rowHeadersWidth        = rowHeadersWidth
          , halign                 = halign
          , valign                 = valign
          , font_family            = font_family
          , nz                     = nz
          , dbgS                    = dbgS
          )
//}

// ━━━━━ autotable ( matrix<string>,  matrix<float> ) ━━━━━ {
// @function    Creates a table with mxValS and mxValF as values (normally in each cell a string value over float value). 
// All arguments of `table.new()` and `table.cell()` (and more) can be supplied as (matrix) arguments (e.g. cell merge matrix).             
// @param mxValS                 (matrix<string>   ) Cell text values     
// @param mxValF                 (matrix<float>    ) (Optional) Numerical part of cell text values. Is concatenated to 
// the mxValS values via `string_float_separator` string (default "\n")     
// @param tbl                    (table            ) (Optional) If supplied, this table will be deleted.
// @param mxBgColor              (matrix<color>    ) (Optional) like bgcolor argument in table.cell()
// @param mxTextColor            (matrix<color>    ) (Optional) like text_color argument in table.cell()     
// @param mxTt                   (matrix<string>   ) (Optional) like tooltip argument in table.cell()
// @param mxMerge                (matrix<string>   ) (Optional) like Matrix determining how cells will be merged. "L" - cell merges to the left, "U" - upwards.     
// @param mxWidth                (matrix<float>    ) (Optional) like width argument in table.cell()
// @param mxHeight               (matrix<float>    ) (Optional) like height argument in table.cell()
// @param mxHalign               (matrix<string>   ) (Optional) like text_halign argument in table.cell()     
// @param mxValign               (matrix<string>   ) (Optional) like text_valign argument in table.cell()          
// @param mxTextSize             (matrix<string>   ) (Optional) like text_size argument in table.cell()
// @param mxFontFamily           (matrix<string>   ) (Optional) like text_font_family argument in table.cell()         
// @param arColHeaders            (string[]         ) (Optional) Array of column headers. If not na a header row is added.          
// @param arRowHeaders            (string[]         ) (Optional) Array of row headers. If not na a header column is added.          
// @param cornerTitle            (string           ) (Optional) If both row and column headers are supplied allows to set the value of the corner cell.           
// @param mergeAllColHeaders      (bool             ) (Optional) Allows to print a table title instead of column headers, merging all header row cells and leaving just the value of the first cell. For more flexible options use matrix arguments leaving header/row arguments na.
// @param mergeAllRowHeaders      (bool             ) (Optional) Allows to print one text value merging all header row cells and leaving just the value of the first cell. For more flexible options use matrix arguments leaving header/row arguments na.
// @param bgcolor         (color            ) (Optional) bgcolor to be used if mxBgColor is not supplied             
// @param text_color        (color            ) (Optional) text_color to be used if mxTextColor is not supplied
// @param colHeadersBgColor       (color            ) (Optional) bgcolor for header row
// @param colHeadersTxtColor      (color            ) (Optional) text_color for header row
// @param rowHeadersBgColor       (color            ) (Optional) bgcolor for header column             
// @param rowHeadersTxtColor      (color            ) (Optional) text_color for header column             
// @param cornerBgClr            (color            ) (Optional) bgcolor for the corner cell
// @param cornerTxtClr           (color            ) (Optional) text_color for the corner cell
// @param frame_color            (color 		   ) (Optional) frame_color  like in table.new()          
// @param frame_width            (int 			   ) (Optional) frame_width  like in table.new()         
// @param border_color           (color 		   ) (Optional) border_color like in table.new()         
// @param border_width           (int 			   ) (Optional) border_width like in table.new()         
// @param text_size              (string           ) (Optional) text_size to be used if mxTextSize is not supplied                  
// @param Ypos                   (string           ) (Optional) "top", "bottom" or "center" 
// @param Xpos                   (string           ) (Optional) "left", "right", or "center"
// @param tableWidth             (float            ) (Optional) Overrides table width if cell widths are non zero. E.g. if there are four rows 
//   and cell widths are 20 (either as set via cellH or via mxWidth) then if tableHeigh is set to e.g. 50 then cell 
//   widths will be 50 * (20 / 80), where 80 is 20*4 = total width of all cells. Works simialar for widths set via 
//   mxWidth - determines max sum of widths across all cloumns of mxWidth and adjusts cell widths proportionally to it.
//   If cell widths are 0 (i.e. auto-adjust) tableWidth has no effect.         
// @param tableHeight            (float            ) (Optional) Overrides table height if cell heights are non zero. E.g. if there are four rows 
//   and cell heights are 20 (either as set via cellH or via mxHeight) then if tableHeigh is set to e.g. 50 then cell 
//   heights will be 50 * (20 / 80), where 80 is 20*4 = total height of all cells. Works simialar for heights set via 
//   mxHeight - determines max sum of heights across all cloumns of mxHeight and adjusts cell heights proportionally to it.
//   If cell heights are 0 (i.e. auto-adjust) tableHeight has no effect.         
// @param cellW                  (float            ) (Optional) cell width to be used if a value in mxWidth is no supplied  
// @param cellH                  (float            ) (Optional) cell height to be used if a value in mxHeight is no supplied   
// @param halign                 (string           ) (Optional) cell text_halign value to be used if a value in mxHalign is no supplied       
// @param valign                 (string           ) (Optional) cell text_valign value to be used if a value in mxValign is no supplied            
// @param font_family            (string           ) (Optional) cell text_font_family value to be used if a value in mxFontFamily is no supplied                     
// @param string_float_separator (string           ) (Optional) A string used to separate string and float parts of cell values (mxValS and mxValF)                    
// @param format                 (string           ) (Optional) format string like in str.format() used to format numerical values     
// @param nz                     (string           ) (Optional) Determines how na numerical values are displayed.   
// @param force_overlay          (simple bool      ) (Optional) If true draws table on main pane.          
// @param dbgS                   (string           ) (Optional) For debug. 
// @returns A newly created beautiful table. 
export method autotable(
      matrix<string>      mxValS                      //                                
      , matrix<float>     mxValF                    = na
      , table             tbl                       = na
      , matrix<color>     mxBgColor                 = na // bgColor
      , matrix<color>     mxTextColor               = na // text color
      , matrix<string>    mxTt                      = na // tooltips
      , matrix<string>    mxMerge                   = na 
      , matrix<float>     mxWidth                   = na 
      , matrix<float>     mxHeight                  = na 
      , matrix<string>    mxHalign                  = na 
      , matrix<string>    mxValign                  = na 
      , matrix<string>    mxTextSize                = na 
      , matrix<string>    mxFontFamily              = na 
      , string[]          arColHeaders              = na
      , string[]          arRowHeaders              = na
      , string            cornerTitle               = na   
      , bool              mergeAllColHeaders        = false 
      , bool              mergeAllRowHeaders        = false 
      , color             bgcolor                   = #fdfd6b
      , color             text_color                = #514242
      , color             colHeadersBgColor         = #ecc504
      , color             colHeadersTxtColor        = #514242
      , color             rowHeadersBgColor         = #ecc504
      , color             rowHeadersTxtColor        = #514242
      , color             cornerBgClr               = #ecc504
      , color             cornerTxtClr              = #514242
	  , color 			  frame_color  			    = na
	  , int 			  frame_width  			    = 1
	  , color 			  border_color 			    = #514242
	  , int 			  border_width 			    = 1      
      , string            text_size                 = size.auto
      , string            Ypos                      = 'top'
      , string            Xpos                      = 'right'            
      , float             tableWidth                = 0
      , float             tableHeight               = 0
      , float             cellW                     = 0
      , float             cellH                     = 0
	  , float 			  colHeadersHeight  	    = 0
	  , float 			  rowHeadersWidth  		    = 0
      , string            halign                    = text.align_left
      , string            valign                    = text.align_center
      , string            font_family               = font.family_default
      , string            string_float_separator    = "\n"
      , string            format                    = ""
      , string            nz                        = na // to be displayed in place of na
      , simple bool       force_overlay             = false
      , string            dbgS                      = ""
      )                        =>  

    // in order not to  modify elements of mxValS we need a new matrix if mxValF is joined 
    _mxValS = if not na(mxValF)
        mxValS.concatMx(mxValF, string_float_separator, format, nz = nz) // returns a new matrix
    else
        mxValS

	if force_overlay == true
	    mtableFOL(
          mxValS                    = _mxValS  
          , tbl                     = tbl
          , mxBgColor                 = mxBgColor
          , mxTextColor                = mxTextColor
          , mxTt                    = mxTt
          , mxMerge                 = mxMerge
          , mxWidth                 = mxWidth            
          , mxHeight                = mxHeight                
          , mxHalign                = mxHalign                
          , mxValign                = mxValign                
          , mxTextSize              = mxTextSize                
          , mxFontFamily         = mxFontFamily                    
          , arColHeaders             = arColHeaders
          , arRowHeaders             = arRowHeaders
          , cornerTitle             = cornerTitle
          , mergeAllColHeaders       = mergeAllColHeaders
          , mergeAllRowHeaders       = mergeAllRowHeaders
          , bgcolor          = bgcolor
          , text_color         = text_color
          , colHeadersBgColor        = colHeadersBgColor
          , colHeadersTxtColor       = colHeadersTxtColor
          , rowHeadersBgColor        = rowHeadersBgColor
          , rowHeadersTxtColor       = rowHeadersTxtColor
          , cornerBgClr             = cornerBgClr
          , cornerTxtClr            = cornerTxtClr
		  , frame_color     	    = frame_color  
		  , frame_width     	    = frame_width  
		  , border_color    	    = border_color 
		  , border_width    	    = border_width 
          , text_size            = text_size   
          , Ypos                    = Ypos   
          , Xpos                    = Xpos
          , tableWidth              = tableWidth
          , tableHeight             = tableHeight
          , cellW                  = cellW
          , cellH                  = cellH
          , colHeadersHeight       = colHeadersHeight
          , rowHeadersWidth        = rowHeadersWidth
          , halign                 = halign
          , valign                 = valign
          , font_family            = font_family
          , nz                      = nz
          , dbgS                    = dbgS
          )
	else
	    mtableNoFOL(
          mxValS                    = _mxValS  
          , tbl                     = tbl
          , mxBgColor                 = mxBgColor
          , mxTextColor                = mxTextColor
          , mxTt                    = mxTt
          , mxMerge                 = mxMerge
          , mxWidth                 = mxWidth            
          , mxHeight                = mxHeight                
          , mxHalign                = mxHalign                
          , mxValign                = mxValign                
          , mxTextSize              = mxTextSize                
          , mxFontFamily         = mxFontFamily                    
          , arColHeaders             = arColHeaders
          , arRowHeaders             = arRowHeaders
          , cornerTitle             = cornerTitle
          , mergeAllColHeaders       = mergeAllColHeaders
          , mergeAllRowHeaders       = mergeAllRowHeaders
          , bgcolor         = bgcolor
          , text_color        = text_color
          , colHeadersBgColor        = colHeadersBgColor
          , colHeadersTxtColor       = colHeadersTxtColor
          , rowHeadersBgColor        = rowHeadersBgColor
          , rowHeadersTxtColor       = rowHeadersTxtColor
          , cornerBgClr             = cornerBgClr
          , cornerTxtClr             = cornerTxtClr
		  , frame_color     			= frame_color  
		  , frame_width     			= frame_width  
		  , border_color    			= border_color 
		  , border_width    			= border_width 
          , text_size            = text_size   
          , Ypos               = Ypos   
          , Xpos               = Xpos
          , tableWidth              = tableWidth
          , tableHeight             = tableHeight
          , cellW                      = cellW
          , cellH                      = cellH
          , colHeadersHeight       = colHeadersHeight
          , rowHeadersWidth        = rowHeadersWidth
          , halign                 = halign
          , valign                 = valign
          , font_family            = font_family
          , nz                     = nz
          , dbgS                    = dbgS
          )

//}


// ━━━━━ autotable ( string ) one cell ━━━━━ {
// @function    Creates a one cell table with string value  
// All arguments of `table.new()` and `table.cell()` (and more) can be supplied as (matrix) arguments (e.g. cell merge matrix).             
// @param s                      (string   )         Cell's text value
// @param tbl                    (table            ) (Optional) If supplied, this table will be deleted.
// @param mxBgColor              (matrix<color>    ) (Optional) like bgcolor argument in table.cell()
// @param mxTextColor            (matrix<color>    ) (Optional) like text_color argument in table.cell()     
// @param mxTt                   (matrix<string>   ) (Optional) like tooltip argument in table.cell()
// @param mxMerge                (matrix<string>   ) (Optional) like Matrix determining how cells will be merged. "L" - cell merges to the left, "U" - upwards.     
// @param mxWidth                (matrix<float>    ) (Optional) like width argument in table.cell()
// @param mxHeight               (matrix<float>    ) (Optional) like height argument in table.cell()
// @param mxHalign               (matrix<string>   ) (Optional) like text_halign argument in table.cell()     
// @param mxValign               (matrix<string>   ) (Optional) like text_valign argument in table.cell()          
// @param mxTextSize             (matrix<string>   ) (Optional) like text_size argument in table.cell()
// @param mxFontFamily           (matrix<string>   ) (Optional) like text_font_family argument in table.cell()         
// @param arColHeaders            (string[]         ) (Optional) Array of column headers. If not na a header row is added.          
// @param arRowHeaders            (string[]         ) (Optional) Array of row headers. If not na a header column is added.          
// @param cornerTitle            (string           ) (Optional) If both row and column headers are supplied allows to set the value of the corner cell.           
// @param mergeAllColHeaders      (bool             ) (Optional) Allows to print a table title instead of column headers, merging all header row cells and leaving just the value of the first cell. For more flexible options use matrix arguments leaving header/row arguments na.
// @param mergeAllRowHeaders      (bool             ) (Optional) Allows to print one text value merging all header row cells and leaving just the value of the first cell. For more flexible options use matrix arguments leaving header/row arguments na.
// @param bgcolor         (color            ) (Optional) bgcolor to be used if mxBgColor is not supplied             
// @param text_color        (color            ) (Optional) text_color to be used if mxTextColor is not supplied
// @param colHeadersBgColor       (color            ) (Optional) bgcolor for header row
// @param colHeadersTxtColor      (color            ) (Optional) text_color for header row
// @param rowHeadersBgColor       (color            ) (Optional) bgcolor for header column             
// @param rowHeadersTxtColor      (color            ) (Optional) text_color for header column             
// @param cornerBgClr            (color            ) (Optional) bgcolor for the corner cell
// @param cornerTxtClr           (color            ) (Optional) text_color for the corner cell
// @param frame_color            (color 		   ) (Optional) frame_color  like in table.new()          
// @param frame_width            (int 			   ) (Optional) frame_width  like in table.new()         
// @param border_color           (color 		   ) (Optional) border_color like in table.new()         
// @param border_width           (int 			   ) (Optional) border_width like in table.new()         
// @param text_size              (string           ) (Optional) text_size to be used if mxTextSize is not supplied                  
// @param Ypos                   (string           ) (Optional) "top", "bottom" or "center" 
// @param Xpos                   (string           ) (Optional) "left", "right", or "center"
// @param tableWidth             (float            ) (Optional) Overrides table width if cell widths are non zero. E.g. if there are four rows 
//   and cell widths are 20 (either as set via cellH or via mxWidth) then if tableHeigh is set to e.g. 50 then cell 
//   widths will be 50 * (20 / 80), where 80 is 20*4 = total width of all cells. Works simialar for widths set via 
//   mxWidth - determines max sum of widths across all cloumns of mxWidth and adjusts cell widths proportionally to it.
//   If cell widths are 0 (i.e. auto-adjust) tableWidth has no effect.         
// @param tableHeight            (float            ) (Optional) Overrides table height if cell heights are non zero. E.g. if there are four rows 
//   and cell heights are 20 (either as set via cellH or via mxHeight) then if tableHeigh is set to e.g. 50 then cell 
//   heights will be 50 * (20 / 80), where 80 is 20*4 = total height of all cells. Works simialar for heights set via 
//   mxHeight - determines max sum of heights across all cloumns of mxHeight and adjusts cell heights proportionally to it.
//   If cell heights are 0 (i.e. auto-adjust) tableHeight has no effect.         
// @param cellW                  (float            ) (Optional) cell width to be used if a value in mxWidth is no supplied  
// @param cellH                  (float            ) (Optional) cell height to be used if a value in mxHeight is no supplied   
// @param halign                 (string           ) (Optional) cell text_halign value to be used if a value in mxHalign is no supplied       
// @param valign                 (string           ) (Optional) cell text_valign value to be used if a value in mxValign is no supplied            
// @param font_family            (string           ) (Optional) cell text_font_family value to be used if a value in mxFontFamily is no supplied                     
// @param format                 (string           ) (Optional) format string like in str.format() used to format numerical values     
// @param nz                     (string           ) (Optional) Determines how na numerical values are displayed.   
// @param force_overlay          (simple bool      ) (Optional) If true draws table on main pane.          
// @param dbgS                   (string           ) (Optional) For debug. 
// @returns A newly created beautiful table. 
export method autotable(
      string              s
      , table             tbl                   = na
      , matrix<color>     mxBgColor             = na // bgColor
      , matrix<color>     mxTextColor           = na // text color
      , matrix<string>    mxTt                  = na // tooltips
      , matrix<string>    mxMerge               = na 
      , matrix<float>     mxWidth               = na 
      , matrix<float>     mxHeight              = na 
      , matrix<string>    mxHalign              = na 
      , matrix<string>    mxValign              = na 
      , matrix<string>    mxTextSize            = na 
      , matrix<string>    mxFontFamily          = na 
      , string            colHeader             = na
      , string            rowHeader             = na
      , string            cornerTitle           = na   
      , bool              mergeAllColHeaders    = false 
      , bool              mergeAllRowHeaders    = false 
      , color             bgcolor               = #fdfd6b
      , color             text_color            = #514242
      , color             colHeadersBgColor     = #ecc504
      , color             colHeadersTxtColor    = #514242
      , color             rowHeadersBgColor     = #ecc504
      , color             rowHeadersTxtColor    = #514242
      , color             cornerBgClr           = #ecc504
      , color             cornerTxtClr          = #514242
	  , color 			  frame_color  		    = na
	  , int 			  frame_width  		    = 1
	  , color 			  border_color 		    = #514242
	  , int 			  border_width 		    = 1      
      , string            text_size             = size.auto
      , string            Ypos                  = 'top'
      , string            Xpos                  = 'right'            
      , float             tableWidth            = 0
      , float             tableHeight           = 0
      , float             cellW                 = 0
      , float             cellH                 = 0
	  , float 			  colHeadersHeight      = 0
	  , float 			  rowHeadersWidth  	    = 0
      , string            halign                = text.align_left
      , string            valign                = text.align_center
      , string            font_family           = font.family_default
    //   , string            format             = ""
    //   , string            nz                        = na // to be displayed in place of na
      , simple bool       force_overlay             = false
      , string            dbgS                      = ""
      )                        =>  

    // in order not to  modify elements of mxValS we need a new matrix if mxValF is joined 
    _mxValS = matrix.new<string>(1,1,s)

    string[] arColHeaders = if colHeader == ""
        na
    else
        array.from(colHeader)

    string[] arRowHeaders = if rowHeader == ""
        na
    else
        array.from(rowHeader)

	if force_overlay == true
	    mtableFOL(
          mxValS                    = _mxValS  
          , tbl                     = tbl
          , mxBgColor                 = mxBgColor
          , mxTextColor                = mxTextColor
          , mxTt                    = mxTt
          , mxMerge                 = mxMerge
          , mxWidth                 = mxWidth            
          , mxHeight                = mxHeight                
          , mxHalign                = mxHalign                
          , mxValign                = mxValign                
          , mxTextSize              = mxTextSize                
          , mxFontFamily         = mxFontFamily                    
          , arColHeaders             = arColHeaders
          , arRowHeaders             = arRowHeaders
          , cornerTitle             = cornerTitle
          , mergeAllColHeaders       = mergeAllColHeaders
          , mergeAllRowHeaders       = mergeAllRowHeaders
          , bgcolor          = bgcolor
          , text_color         = text_color
          , colHeadersBgColor        = colHeadersBgColor
          , colHeadersTxtColor       = colHeadersTxtColor
          , rowHeadersBgColor        = rowHeadersBgColor
          , rowHeadersTxtColor       = rowHeadersTxtColor
          , cornerBgClr             = cornerBgClr
          , cornerTxtClr            = cornerTxtClr
		  , frame_color     	    = frame_color  
		  , frame_width     	    = frame_width  
		  , border_color    	    = border_color 
		  , border_width    	    = border_width 
          , text_size            = text_size   
          , Ypos                    = Ypos   
          , Xpos                    = Xpos
          , tableWidth              = tableWidth
          , tableHeight             = tableHeight
          , cellW                  = cellW
          , cellH                  = cellH
          , colHeadersHeight       = colHeadersHeight
          , rowHeadersWidth        = rowHeadersWidth
          , halign                 = halign
          , valign                 = valign
          , font_family            = font_family
        //   , nz                      = nz
          , dbgS                    = dbgS
          )
	else
	    mtableNoFOL(
          mxValS                    = _mxValS  
          , tbl                     = tbl
          , mxBgColor                 = mxBgColor
          , mxTextColor                = mxTextColor
          , mxTt                    = mxTt
          , mxMerge                 = mxMerge
          , mxWidth                 = mxWidth            
          , mxHeight                = mxHeight                
          , mxHalign                = mxHalign                
          , mxValign                = mxValign                
          , mxTextSize              = mxTextSize                
          , mxFontFamily            = mxFontFamily                    
          , arColHeaders             = arColHeaders
          , arRowHeaders             = arRowHeaders
          , cornerTitle             = cornerTitle
          , mergeAllColHeaders       = mergeAllColHeaders
          , mergeAllRowHeaders       = mergeAllRowHeaders
          , bgcolor                 = bgcolor
          , text_color               = text_color
          , colHeadersBgColor        = colHeadersBgColor
          , colHeadersTxtColor       = colHeadersTxtColor
          , rowHeadersBgColor        = rowHeadersBgColor
          , rowHeadersTxtColor       = rowHeadersTxtColor
          , cornerBgClr             = cornerBgClr
          , cornerTxtClr             = cornerTxtClr
		  , frame_color     			= frame_color  
		  , frame_width     			= frame_width  
		  , border_color    			= border_color 
		  , border_width    			= border_width 
          , text_size                  = text_size   
          , Ypos                     = Ypos   
          , Xpos                     = Xpos
          , tableWidth              = tableWidth
          , tableHeight             = tableHeight
          , cellW                      = cellW
          , cellH                      = cellH
          , colHeadersHeight       = colHeadersHeight
          , rowHeadersWidth        = rowHeadersWidth
          , halign                 = halign
          , valign                 = valign
          , font_family            = font_family
        //   , nz                     = nz
          , dbgS                    = dbgS
          )

//}

// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF AUTOTABLE FUNCTIONS ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲}

// ┃^^^ END OF AUTOTABLE                             							  ┃}
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ 

 
// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                                DEMO                                          ║ {

// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ INPUT ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {


// --- input text constants ---{

const string IG_TBL_SZPOS        = "▓▓▓▓▓ SIZE AND POSITION  ▓▓▓▓▓"
const string IG_TBL_CLRS         = "▓▓▓▓▓ COLORS AND BORDERS ▓▓▓▓▓"
const string IG_TBL_FRMT         = "▓▓▓▓▓ FORMAT  ▓▓▓▓▓"
const string IG_MX_DATA         = "▓▓▓▓▓ DATA MATRICES  ▓▓▓▓▓"
const string IG_MX_CLRS         = "▓▓▓▓▓ COLOR MATRICES  ▓▓▓▓▓"
const string IG_AR_HEADERS         = "▓▓▓▓▓ HEADER ARRAYS  ▓▓▓▓▓"
const string IG_MX_CELSZ         = "▓▓▓▓▓ CELL SIZE MATRICES  ▓▓▓▓▓"
const string IG_MX_ALIGN        = "▓▓▓▓▓ ALIGN MATRICES  ▓▓▓▓▓"
const string IG_MX_TXTSZ        = "▓▓▓▓▓ TEXT SIZE MATRIX  ▓▓▓▓▓"
const string IG_MX_FONT         = "▓▓▓▓▓ FONT FAMILY MATRIX  ▓▓▓▓▓"
const string IG_MX_TT           = "▓▓▓▓▓ TOOLTIP MATRIX  ▓▓▓▓▓"
const string IG_MX_MERGE        = "▓▓▓▓▓ MERGE MATRIX  ▓▓▓▓▓"



const string TT_TBL_HEIGHT        = "(for width similarly) Overrides table height if cell heights are non zero. E.g. if there are four rows 
  and cell heights are 20 (either as set via cellH or via mxHeight) then if tableHeigh is set to e.g. 50 then cell 
  heights will be 50 * (20 / 80), where 80 is 20*4 = total height of all cells. Works simialar for heights set via 
  mxHeight - determines max sum of heights across all cloumns of mxHeight and adjusts cell heights proportionally to it.
  If cell heights are 0 (i.e. auto-adjust) tableHeight has no effect. "


//}

// --- TABLE SIZE AND POSITION --- {
i_rows                          = input.int     (group = IG_TBL_SZPOS, inline = "rc", defval = 4            , title = "Size: Rows")    
i_cols                          = input.int     (group = IG_TBL_SZPOS, inline = "rc", defval = 5            , title = "Columns")    
i_Ypos							= input.string	(group = IG_TBL_SZPOS, inline = "pos", defval = "bottom"	, title = "Position: Y", options= ["bottom", "top", "middle"])
i_Xpos							= input.string	(group = IG_TBL_SZPOS, inline = "pos", defval = "right"	    , title = "X", options= ["right", "left", "center"])
i_tableWidth                    = input.float	(group = IG_TBL_SZPOS, inline = "twh", defval = 0			, title = "Table width")
i_tableHeight                   = input.float	(group = IG_TBL_SZPOS, inline = "twh", defval = 0			, title = "Table height", tooltip=TT_TBL_HEIGHT)
i_width							= input.float	(group = IG_TBL_SZPOS, inline = "cwh", defval = 0			, title = "Cell width")
i_height						= input.float	(group = IG_TBL_SZPOS, inline = "cwh", defval = 0			, title = "Cell height")
i_force_overlay					= input.bool	(group = IG_TBL_SZPOS, inline = "ovl",	defval = false		, title = "force_overlay")
//}

// --- TABLE COLORS --- {
i_bgcolor				= input.color	(group = IG_TBL_CLRS, inline = "1", defval =     #fdfd6b			, title = "bgcolor")
i_text_color				= input.color	(group = IG_TBL_CLRS, inline = "1", defval =     #514242			, title = "text_color")
i_colHeadersTxtColor				= input.color	(group = IG_TBL_CLRS, inline = "2", defval =     #514242			, title = "colHeadersTxtColor")
i_colHeadersBgColor				= input.color	(group = IG_TBL_CLRS, inline = "2", defval =     #ecc504			, title = "colHeadersBgColor")
i_rowHeadersTxtColor				= input.color	(group = IG_TBL_CLRS, inline = "3", defval =     #514242			, title = "rowHeadersTxtColor")
i_rowHeadersBgColor				= input.color	(group = IG_TBL_CLRS, inline = "3", defval =     #ecc504			, title = "rowHeadersBgColor")
i_cornerBgClr					= input.color	(group = IG_TBL_CLRS, inline = "4", defval =     #ecc504			, title = "cornerBgClr")
i_cornerTxtClr					= input.color	(group = IG_TBL_CLRS, inline = "4", defval =     #514242			, title = "cornerTxtClr")
i_frame_color					= input.color	(group = IG_TBL_CLRS, inline = "5", defval =     color.black		, title = "frame_color")
i_frame_width					= input.int		(group = IG_TBL_CLRS, inline = "5", defval =     1					 , title = "frame_width")
i_border_color					= input.color	(group = IG_TBL_CLRS, inline = "6", defval =     color.black	    , title = "border_color")
i_border_width					= input.int		(group = IG_TBL_CLRS, inline = "6", defval =     1					 , title = "border_width")
//}

// --- TABLE FORMAT --- {
i_text_size						= input.string	(group = IG_TBL_FRMT, inline = "1",	defval = size.auto			, title = "text_size", options = [size.auto, size.tiny, size.small, size.normal, size.large, size.huge])
i_font_family					= input.string	(group = IG_TBL_FRMT, inline = "1",	defval = font.family_default    , title = "font_family", options = [font.family_default, font.family_monospace])
i_halign						= input.string	(group = IG_TBL_FRMT, inline = "2",	defval = text.align_left        , title = "halign", options=[text.align_left, text.align_right, text.align_center])
i_valign						= input.string	(group = IG_TBL_FRMT, inline = "2",	defval = text.align_top         , title = "valign", options=[text.align_top, text.align_bottom, text.align_center])
i_string_float_separator		= input.string	(group = IG_TBL_FRMT, inline = "3",	defval = "\n"      			    , title = "string_float_separator")
i_nz							= input.string	(group = IG_TBL_FRMT, inline = "3",	defval = "--"					, title = "nz")
i_format						= input.string	(group = IG_TBL_FRMT, inline = "4",	defval = ""					    , title = "format")
//}

// --- INPUT MATRICES --- {

i_mxS                               = input.text_area(group = IG_MX_DATA
                                                  , defval = "
                                                  Val11,Val12,Val13,Val14,Val15\n
                                                  Val21,Val22,Val23,Val24,Val25\n
                                                  Val31,Val32,Val33,Val34,Val35\n
                                                  Val41,Val42,Val43,Val44,Val45
                                                  "
                                                  , title = "mxValS ()")

i_mxF                               = input.text_area(group = IG_MX_DATA
                                                  , defval = "
                                                  11,12,13,14,15\n
                                                  21,22,23,24,25\n
                                                  31,32,33,34,35\n
                                                  41,42,43,44,45
                                                  "
                                                  , title = "mxValF (float)")

i_mxMerge                            = input.text_area(group = IG_MX_MERGE
                                                 , defval = "
                                                  , , ,L, \n
                                                  ,L, ,L, \n
                                                 U, , , ,U
                                                  , , , , 
                                                  "
                                                  , title = "mxMerge")

i_arColHeaders                            = input.text_area(group = IG_AR_HEADERS
                                                  , defval = "
                                                  Header1,H2,H3,H4,H5
                                                  "
                                                  , title =  "col headers")

i_arRowHeaders                            = input.text_area(group = IG_AR_HEADERS
                                                  ,defval = "
                                                  Row1,Row2,Row3,Row4,Row5
                                                  "
                                                  , title = "row headers")

i_mxWidth                            = input.text_area(group = IG_MX_CELSZ
                                                  , defval = "
                                                  10,10,10,10,15\n
                                                  10,10,10,10,15\n
                                                  10,10,10,10,15\n
                                                  10,10,10,10,15
                                                  "
                                                  , title = "mxWidth")

i_mxHeight                            = input.text_area(group = IG_MX_CELSZ
                                                  , defval = "
                                                  10,10,10,10,15\n
                                                  10,10,10,10,15\n
                                                  10,10,10,10,15\n
                                                  10,10,10,10,15
                                                  "
                                                  , title = "mxHeight")

i_mxTt                               = input.text_area(group = IG_MX_TT
                                                  , defval = "Corner cell tooltip,\n
                                                           Cell below corner tooltip"                                                  
                                                  , title = "mxTt")

// END OF INPUT MATRICES}

// ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ END OF INPUT  ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲ }


// --- COLORFUL FUNCTIONS --- {
import kaigouthro/hsvColor/16 as H

i_N1 = input.int(5, "Size of colorful table")
// i_hShift1 = input.int(10, "Hue shift 1")
// i_hShift2 = input.int(50, "Hue shift 2")


method hue(color c, float _rotate) => 
    [_h,_s,_v,_a] = H.rgbhsv(c)
    _h += _rotate
    H.hsv(_h,_s,_v,_a)

clrAr(color c1, color c2, int n) =>
    ar = array.new<color>(0, na)
    for i = 0 to n-1
        _c = H.hsl_gradient(i, 0, n-1, c1, c2)
        ar.push(_c)
    ar

// gradient colors scrolling diagonally 
mxGradClrs (int rws, int cls, int hs1 = 10 , int hs2= 90) => 
    var color c1 = na
    c1 := if na(c1) 
        // rndClr(1)
        #ff52526e
    else
        c1.hue(hs1)
    c2 = c1.hue(hs2)
    mx = matrix.new<color>(0,cls,na)
    for j = 0 to rws-1
        ar = clrAr(c1, c2, cls)
        mx.add_row(mx.rows(), ar)    
        c1:= c1.hue(hs1)
        c2:= c2.hue(hs1)
    mx
// END OF COLORFUL FUNCTIONS}

var table tB = na
if barstate.islast

    // ---- COLORFUL TABLE ----{
    mxSN1 = matrix.new<string>(i_N1,i_N1,"AA")
    mxBgClrN1 = mxGradClrs(i_N1, i_N1)
    mxSN1.autotable(mxBgColor = mxBgClrN1,  Xpos = "left", Ypos = "top", tableWidth = 50, tableHeight = 50, cellW = 1, cellH = 1, dbgS = "COLORFUL table")
    //}

    // ---- BLINKER TABLE ----{
    BLINKER_SZ = 4 
    varip lastClose = 0.
    arrowChar = close > lastClose ? "😃" : "😟"
	mxS = matrix.new<string>(BLINKER_SZ,BLINKER_SZ,arrowChar)
    mxBgClrB = mxGradClrs(BLINKER_SZ, BLINKER_SZ)


	mxF = matrix.new<float>(BLINKER_SZ,BLINKER_SZ,close)
    mxF.set(1,1,close)
    mxS.set(1,1, arrowChar)
    mxF.set(1,1, close)


    mxMrgB = matrix.new<string>(0,BLINKER_SZ, "")
    mxMrgB.add_row(mxMrgB.rows(), array.from("", "", "", ""))
    mxMrgB.add_row(mxMrgB.rows(), array.from("", "", "L", ""))
    mxMrgB.add_row(mxMrgB.rows(), array.from("", "U", "", ""))
    mxMrgB.add_row(mxMrgB.rows(), array.from("", "", "", ""))

    mxSzB = matrix.new<string>(0,BLINKER_SZ, na)
    mxSzB.add_row(mxSzB.rows(), array.from("","","",""))
    mxSzB.add_row(mxSzB.rows(), array.from("",size.huge,"",""))
    mxSzB.add_row(mxSzB.rows(), array.from("","","",""))
    mxSzB.add_row(mxSzB.rows(), array.from("","","",""))


    mxHalignB = matrix.new<string>(0,BLINKER_SZ, na )
    mxHalignB.add_row(mxHalignB.rows(), array.from("","","",""))
    mxHalignB.add_row(mxHalignB.rows(), array.from("",text.align_center,"",""))
    mxHalignB.add_row(mxHalignB.rows(), array.from("","","",""))
    mxHalignB.add_row(mxHalignB.rows(), array.from("","","",""))

    mxValignB = matrix.new<string>(0,BLINKER_SZ, na )
    mxValignB.add_row(mxValignB.rows(), array.from("","","",""))
    mxValignB.add_row(mxValignB.rows(), array.from("",text.align_center,"",""))
    mxValignB.add_row(mxValignB.rows(), array.from("","","",""))
    mxValignB.add_row(mxValignB.rows(), array.from("","","",""))


    mxTtB = matrix.new<string>(BLINKER_SZ,BLINKER_SZ, "Colors from kaigouthro/theme_presets/2" )

    textColorB = close > lastClose ? color.green : color.red
    lastClose := close
	mxTCB = matrix.new<color>(BLINKER_SZ,BLINKER_SZ,textColorB)

	
	tB := mxS.autotable(mxF
              , mxBgColor = mxBgClrB
              , mxTextColor = mxTCB
              , mxTt = mxTtB
            //   , tbl = tB
              , mxMerge = mxMrgB
              , mxTextSize = mxSzB
              , mxHalign = mxHalignB
              , mxValign = mxValignB
              , Ypos = "top", Xpos = "right" 
              , tableWidth = 40, tableHeight = 40
              , cellW = 10, cellH = 10
              , format = "{0, number, 0.0}", text_size = size.normal, string_float_separator = " "
              , dbgS = "BLINKER table"
              )
    // END OF BLINKER TABLE} 


if barstate.islastconfirmedhistory 
// --- DRAW MAIN TABLE --- {  
    mxS = i_mxS.impMxS(i_rows, i_cols)
    mxF = i_mxF.impMxF(i_rows, i_cols)
    mxMrg = i_mxMerge.impMxS(i_rows, i_cols)
    arColHeaders = i_arColHeaders.impArS(1, i_cols)
    arRowHeaders = i_arRowHeaders.impArS(1, i_rows)
    mxW = i_mxWidth.impMxF(i_rows, i_cols)
    mxH = i_mxHeight.impMxF(i_rows, i_cols)
    mxTt = i_mxTt.impMxS(i_rows, i_cols)

	autotable(
              mxValS                     =   mxS     
              , mxValF                   =   mxF     
              , mxBgColor                  =   na     
              , mxTextColor                 =   na         
              , mxTt                     =   mxTt     
              , mxMerge                  =   mxMrg     
              , mxWidth                  =   mxW     
              , mxHeight                 =   mxH         
              , mxHalign                 =   na         
              , mxValign                 =   na         
              , mxTextSize               =   na         
              , mxFontFamily             =   na             
              , arColHeaders              =   arColHeaders           
              , arRowHeaders              =   arRowHeaders           
              , cornerTitle              =   "Corner cell"         
              , bgcolor                  = i_bgcolor
              , text_color               = i_text_color               
              , colHeadersBgColor         = i_colHeadersBgColor                   
              , colHeadersTxtColor        = i_colHeadersTxtColor  
              , rowHeadersBgColor         = i_rowHeadersBgColor                   
              , rowHeadersTxtColor        = i_rowHeadersTxtColor                   
              , cornerBgClr              = i_cornerBgClr           
              , cornerTxtClr             = i_cornerTxtClr               
              , frame_color              = i_frame_color           
              , frame_width              = i_frame_width           
              , border_color             = i_border_color               
              , border_width             = i_border_width               
              , text_size                = i_text_size           
              , Ypos                     = i_Ypos        
              , Xpos                     = i_Xpos       
              , tableWidth               = i_tableWidth           
              , tableHeight              = i_tableHeight       
              , cellW                    = i_width       
              , cellH                    = i_height       
              , halign                   = i_halign       
              , valign                   = i_valign       
              , font_family              = i_font_family           
              , string_float_separator   = i_string_float_separator                       
              , format                   = i_format       
              , nz                       = i_nz   
              , force_overlay			 = i_force_overlay 
              , dbgS                     = "MAIN table"
              )                         
// END OF DRAW MAIN TABLE}

// -- DRAW MERGE MATRIX ---{

    // draw merge matrix (CONTINUATION OF if barstate.islastconfirmedhistory) 
    tMrg = autotable(mxMrg
              , Ypos                    = "bottom"
              , Xpos                    = "left"
              , bgcolor                  = #b4d400
              , arColHeaders             = array.from("MERGE MATRIX") 
              , arRowHeaders             = array.from("MERGE MATRIX") 
              , mergeAllColHeaders       = true
              , mergeAllRowHeaders       = true
              , cellW                   = 1
              , cellH                   = 5
              , tableWidth              = 20
              , cornerTitle             = str.format("{0}x{1}", mxMrg.rows(), mxMrg.columns())
              , dbgS = "MERGE table"
              )

 
// END OF DRAW MERGE MATRIX }

// ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ DEBUG PRINTS ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ {

plotchar(bar_index, "bar_index",  "", location = location.bottom)
plotchar(array.size(table.all), "table.all size",  "", location = location.bottom)
plotchar(array.size(line.all), "line.all size",  "", location = location.bottom)
plotchar(array.size(label.all), "label.all size",  "", location = location.bottom)

