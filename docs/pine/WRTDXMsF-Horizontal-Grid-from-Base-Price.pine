//@version=5
indicator("Horizontal Grid from Base Price", overlay=true)

// ====== INPUTS ======
base_price       = input.float(2000.0, title="Base Price")
point_distance   = input.int(500, title="Distance (in points)")
lines_per_side   = input.int(5, title="Number of Lines per Side")
line_color_up    = input.color(color.green, title="Upper Line Color")
line_color_down  = input.color(color.red, title="Lower Line Color")

// ====== CALCULATE PRICE STEP ======
price_step = point_distance * syminfo.mintick

// ====== DRAW LINES ONCE ======
if bar_index == 0
    for i = 1 to lines_per_side
        price_up   = base_price + price_step * i
        price_down = base_price - price_step * i

        line.new(x1=bar_index, y1=price_up,
                 x2=bar_index + 1000, y2=price_up,
                 color=line_color_up, style=line.style_dashed, extend=extend.right)

        line.new(x1=bar_index, y1=price_down,
                 x2=bar_index + 1000, y2=price_down,
                 color=line_color_down, style=line.style_dashed, extend=extend.right)
                 