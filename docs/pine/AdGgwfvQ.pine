//@version=6

// @description Configuration centrale pour tous les indicateurs LAB (Kijun + EMA + S/R)
// Centralise les valeurs par défaut pour éviter les désynchronisations entre indicateurs
library("labConfigCore")

// ═════════════════════════════════════════════════════════════════════════════════
// 🕐 TIMEFRAMES PAR DÉFAUT
// ═════════════════════════════════════════════════════════════════════════════════

// @function Retourne le timeframe Fast par défaut
// @returns String - Timeframe Fast ("15" par défaut)
export getTFFast() => 
    "15"

// @function Retourne le timeframe Mid par défaut
// @returns String - Timeframe Mid ("60" par défaut)
export getTFMid() => 
    "60"

// @function Retourne le timeframe Slow par défaut
// @returns String - Timeframe Slow ("240" par défaut)
export getTFSlow() => 
    "240"

// @function Retourne le timeframe ATR par défaut
// @returns String - Timeframe ATR ("60" par défaut)
export getTFATR() => 
    "60"

// ═════════════════════════════════════════════════════════════════════════════════
// 📊 PARAMÈTRES KIJUN PAR DÉFAUT
// ═════════════════════════════════════════════════════════════════════════════════

// @function Retourne la longueur Kijun par défaut
// @returns Int - Longueur Kijun (26 par défaut)
export getKijunLength() => 
    26

// @function Retourne l'état d'affichage Kijun par défaut
// @returns Bool - Afficher Kijun (true par défaut)
export getShowKijun() => 
    true

// ═════════════════════════════════════════════════════════════════════════════════
// 📈 PARAMÈTRES EMA CHANNELS PAR DÉFAUT
// ═════════════════════════════════════════════════════════════════════════════════

// @function Retourne la longueur EMA par défaut
// @returns Int - Longueur EMA (50 par défaut)
export getEMALength() => 
    50

// @function Retourne la largeur des canaux EMA par défaut
// @returns Float - Largeur canal en % (2.0 par défaut)
export getChannelWidth() => 
    2.0

// @function Retourne la transparence des canaux par défaut
// @returns Int - Alpha channel (93 par défaut)
export getChannelAlpha() => 
    93

// @function Retourne l'état d'affichage canal Fast par défaut
// @returns Bool - Afficher canal Fast (false par défaut)
export getShowChannelFast() => 
    false

// @function Retourne l'état d'affichage canal Mid par défaut
// @returns Bool - Afficher canal Mid (true par défaut)
export getShowChannelMid() => 
    true

// @function Retourne l'état d'affichage canal Slow par défaut
// @returns Bool - Afficher canal Slow (true par défaut)
export getShowChannelSlow() => 
    true

// @function Retourne la couleur canal Fast par défaut
// @returns Color - Couleur Fast (#00BCD4 par défaut)
export getChannelColorFast() => 
    #00BCD4

// @function Retourne la couleur canal Mid par défaut
// @returns Color - Couleur Mid (#4CAF50 par défaut)
export getChannelColorMid() => 
    #4CAF50

// @function Retourne la couleur canal Slow par défaut
// @returns Color - Couleur Slow (#FF9800 par défaut)
export getChannelColorSlow() => 
    #FF9800

// ═════════════════════════════════════════════════════════════════════════════════
// 🎯 PARAMÈTRES S/R ZONES PAR DÉFAUT
// ═════════════════════════════════════════════════════════════════════════════════

// @function Retourne le mode d'affichage S/R par défaut
// @returns String - Mode ('S/R Zones' par défaut)
export getSRDisplayMode() => 
    "S/R Zones"

// @function Retourne le timeframe S/R par défaut
// @returns String - Timeframe S/R ('Chart' par défaut)
export getSRTimeframe() => 
    "Chart"

// @function Retourne la longueur Volume MA par défaut
// @returns Int - Longueur Vol MA (6 par défaut)
export getSRVolMA() => 
    6

// @function Retourne le nombre de zones back par défaut
// @returns Int - Zones back (10 par défaut)
export getSRNumZones() => 
    10

// @function Retourne l'état extend lines par défaut
// @returns Bool - Extend to next zone (true par défaut)
export getSRExtendLines() => 
    true

// @function Retourne l'état extend active par défaut
// @returns Bool - Extend active right (true par défaut)
export getSRExtendActive() => 
    true

// @function Retourne l'état extend right par défaut
// @returns Bool - Extend right (false par défaut)
export getSRExtendRight() => 
    false

// @function Retourne l'état affichage labels par défaut
// @returns Bool - Show labels (true par défaut)
export getSRShowLabels() => 
    true

// @function Retourne la position labels par défaut
// @returns String - Position ('Right' par défaut)
export getSRLabelLocation() => 
    "Right"

// @function Retourne l'offset labels par défaut
// @returns Int - Offset (15 par défaut)
export getSRLabelOffset() => 
    15

// @function Retourne l'état affichage H/L par défaut
// @returns Bool - Show H/L lines (true par défaut)
export getSRShowHL() => 
    true

// @function Retourne l'état affichage O/C par défaut
// @returns Bool - Show O/C lines (true par défaut)
export getSRShowOC() => 
    true

// @function Retourne le style ligne H/L par défaut
// @returns String - Style ('Solid' par défaut)
export getSRLineStyleHL() => 
    "Solid"

// @function Retourne l'épaisseur ligne H/L par défaut
// @returns Int - Width (1 par défaut)
export getSRLineWidthHL() => 
    1

// @function Retourne le style ligne O/C par défaut
// @returns String - Style ('Solid' par défaut)
export getSRLineStyleOC() => 
    "Solid"

// @function Retourne l'épaisseur ligne O/C par défaut
// @returns Int - Width (1 par défaut)
export getSRLineWidthOC() => 
    1

// @function Retourne la couleur lignes résistance par défaut
// @returns Color - Couleur (rouge 20% transparent)
export getSRResLinesColor() => 
    color.new(color.red, 20)

// @function Retourne la couleur zone résistance par défaut
// @returns Color - Couleur (rouge 90% transparent)
export getSRResZoneColor() => 
    color.new(color.red, 90)

// @function Retourne la couleur lignes support par défaut
// @returns Color - Couleur (lime 20% transparent)
export getSRSupLinesColor() => 
    color.new(color.lime, 20)

// @function Retourne la couleur zone support par défaut
// @returns Color - Couleur (lime 90% transparent)
export getSRSupZoneColor() => 
    color.new(color.lime, 90)

// ═════════════════════════════════════════════════════════════════════════════════
// ⚖️ PARAMÈTRES NORMALISATION PAR DÉFAUT
// ═════════════════════════════════════════════════════════════════════════════════

// @function Retourne le mode de normalisation par défaut
// @returns String - Mode ('ATR' par défaut)
export getNormMode() => 
    "ATR"

// @function Retourne la longueur ATR par défaut
// @returns Int - Longueur ATR (14 par défaut)
export getATRLength() => 
    14

// @function Retourne la tolérance égalité par défaut
// @returns Float - Tolérance (0.10 par défaut)
export getTolEqual() => 
    0.10

// @function Retourne le seuil compression par défaut
// @returns Float - Seuil tight (0.25 par défaut)
export getThresholdTight() => 
    0.25

// @function Retourne le seuil extension par défaut
// @returns Float - Seuil wide (1.50 par défaut)
export getThresholdWide() => 
    1.50

// ═════════════════════════════════════════════════════════════════════════════════
// 📊 PARAMÈTRES DASHBOARD PAR DÉFAUT
// ═════════════════════════════════════════════════════════════════════════════════

// @function Retourne l'état d'affichage dashboard par défaut
// @returns Bool - Show table (true par défaut)
export getShowDashboard() => 
    true

// @function Retourne la position dashboard par défaut
// @returns String - Position ('Top Right' par défaut)
export getDashboardPosition() => 
    "Top Right"

// @function Retourne la taille dashboard par défaut
// @returns String - Size ('Small' par défaut)
export getDashboardSize() => 
    "Small"

// ═════════════════════════════════════════════════════════════════════════════════
// 🎯 PARAMÈTRES PROBABILITY MATRIX (pour indicateur stats)
// ═════════════════════════════════════════════════════════════════════════════════

// @function Retourne le nombre de barres forward par défaut
// @returns Int - Bars forward (20 par défaut)
export getProbBarsForward() => 
    20

// @function Retourne le seuil win par défaut
// @returns Float - Win threshold % (1.5 par défaut)
export getProbWinThreshold() => 
    1.5

// @function Retourne le seuil loss par défaut
// @returns Float - Loss threshold % (1.0 par défaut)
export getProbLossThreshold() => 
    1.0

// @function Retourne la taille historique par défaut
// @returns Int - History size (500 par défaut)
export getProbHistorySize() => 
    500

// ═════════════════════════════════════════════════════════════════════════════════
// 💼 PARAMÈTRES STRATEGY (pour backtesting)
// ═════════════════════════════════════════════════════════════════════════════════

// @function Retourne le mode TP/SL par défaut
// @returns String - Mode ('% Fixed' ou 'ATR Multiple')
export getStrategyTPSLMode() => 
    "% Fixed"

// @function Retourne le take profit % par défaut
// @returns Float - TP % (2.0 par défaut)
export getStrategyTPPercent() => 
    2.0

// @function Retourne le stop loss % par défaut
// @returns Float - SL % (1.0 par défaut)
export getStrategySLPercent() => 
    1.0

// @function Retourne le multiple ATR pour TP par défaut
// @returns Float - TP ATR multiple (2.0 par défaut)
export getStrategyTPATRMultiple() => 
    2.0

// @function Retourne le multiple ATR pour SL par défaut
// @returns Float - SL ATR multiple (1.5 par défaut)
export getStrategySLATRMultiple() => 
    1.5

// @function Retourne l'état trailing stop par défaut
// @returns Bool - Use trailing stop (false par défaut)
export getStrategyUseTrailing() => 
    false

// @function Retourne l'activation trailing % par défaut
// @returns Float - Trailing activation % (1.0 par défaut)
export getStrategyTrailingActivation() => 
    1.0

// @function Retourne le trailing offset % par défaut
// @returns Float - Trailing offset % (0.5 par défaut)
export getStrategyTrailingOffset() => 
    0.5

// @function Retourne la taille position par défaut
// @returns Float - Position size % equity (100 par défaut)
export getStrategyPositionSize() => 
    100.0

// @function Retourne le capital initial par défaut
// @returns Float - Initial capital (10000 par défaut)
export getStrategyInitialCapital() => 
    10000.0

// @function Retourne la commission par défaut
// @returns Float - Commission % (0.1 par défaut)
export getStrategyCommission() => 
    0.1

// @function Retourne le slippage par défaut
// @returns Int - Slippage ticks (2 par défaut)
export getStrategySlippage() => 
    2

// ═════════════════════════════════════════════════════════════════════════════════
// 🎨 FONCTIONS UTILITAIRES
// ═════════════════════════════════════════════════════════════════════════════════

// @function Retourne TOUS les paramètres Kijun sous forme de tuple
// @returns [string, string, string, int, bool] - TF Fast, Mid, Slow, Length, Show
export getAllKijunDefaults() => 
    [getTFFast(), getTFMid(), getTFSlow(), getKijunLength(), getShowKijun()]

// @function Retourne TOUS les paramètres EMA sous forme de tuple
// @returns [int, float, int, bool, bool, bool] - Length, Width, Alpha, Show Fast, Mid, Slow
export getAllEMADefaults() => 
    [getEMALength(), getChannelWidth(), getChannelAlpha(), 
     getShowChannelFast(), getShowChannelMid(), getShowChannelSlow()]

// @function Retourne TOUS les paramètres Normalisation sous forme de tuple
// @returns [string, string, int, float, float, float] - Mode, TF ATR, Length, Tol, Tight, Wide
export getAllNormDefaults() => 
    [getNormMode(), getTFATR(), getATRLength(), 
     getTolEqual(), getThresholdTight(), getThresholdWide()]

// @function Retourne TOUS les paramètres Dashboard sous forme de tuple
// @returns [bool, string, string] - Show, Position, Size
export getAllDashboardDefaults() => 
    [getShowDashboard(), getDashboardPosition(), getDashboardSize()]