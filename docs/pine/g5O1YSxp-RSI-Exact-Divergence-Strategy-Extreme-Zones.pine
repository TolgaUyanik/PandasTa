//@version=6
strategy("RSI Exact Divergence Strategy (Extreme Zones)", overlay=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, max_lines_count=50)

// --- Inputs ---
rsiLength     = input.int(14, title="RSI Length", minval=1, group="RSI Settings")
rsiSource     = input.source(close, title="RSI Source", group="RSI Settings")
pivotLookback = input.int(5, title="Pivot Lookback Period (Left/Right Bars)", minval=1, group="RSI Settings")
maxLookback   = input.int(60, title="Max Lookback for Divergence", minval=10, group="RSI Settings")

// --- Extreme Zone Thresholds ---
obLevel       = input.int(70, title="Overbought Level Threshold", minval=50, maxval=100, group="RSI Settings")
osLevel       = input.int(30, title="Oversold Level Threshold", minval=0, maxval=50, group="RSI Settings")

// --- Higher Time Frame Filter Settings ---
useHtfFilter  = input.bool(true, title="Enable Higher Time Frame Filter", group="HTF Trend Filter")
htfResolution = input.timeframe("D", title="HTF Timeframe", group="HTF Trend Filter")
htfEmaLength  = input.int(200, title="HTF EMA Length", minval=1, group="HTF Trend Filter")

// --- RSI Calculation ---
rsiValue = ta.rsi(rsiSource, rsiLength)

// --- HTF Trend Filter Implementation ---
htfEmaRaw = ta.ema(close, htfEmaLength)
htfEma    = request.security(syminfo.tickerid, htfResolution, htfEmaRaw[1], barmerge.gaps_off, barmerge.lookahead_off)
htfClose  = request.security(syminfo.tickerid, htfResolution, close[1], barmerge.gaps_off, barmerge.lookahead_off)

htfTrendUp   = not useHtfFilter or (htfClose > htfEma)
htfTrendDown = not useHtfFilter or (htfClose < htfEma)

// --- Declare Reference Levels ---
h_ob  = hline(obLevel, "Overbought", color=color.red, linestyle=hline.style_dashed)
h_55  = hline(55, "Upper Equilibrium", color=color.gray, linestyle=hline.style_dotted)
h_mid = hline(50, "Middle Line", color=color.gray, linestyle=hline.style_dotted)
h_45 = hline(45, "Lower Equilibrium", color=color.gray, linestyle=hline.style_dotted)
h_os  = hline(osLevel, "Oversold", color=color.green, linestyle=hline.style_dashed)

plot(rsiValue, title="RSI", color=color.purple, linewidth=2)

// --- Pivot Points Identification ---
pvHi = ta.pivothigh(rsiValue, pivotLookback, pivotLookback)
pvLo = ta.pivotlow(rsiValue, pivotLookback, pivotLookback)

var float topRsi      = na
var int   topBar      = na
var float topPrice    = na
var float prevTopRsi  = na
var int   prevTopBar  = na
var float prevTopPrice= na

var float botRsi      = na
var int   botBar      = na
var float botPrice    = na
var float prevBotRsi  = na
var int   prevBotBar  = na
var float prevBotPrice= na

if not na(pvHi)
    prevTopRsi   := topRsi
    prevTopBar   := topBar
    prevTopPrice := topPrice
    
    topRsi   := rsiValue[pivotLookback]
    topBar   := bar_index[pivotLookback]
    topPrice := high[pivotLookback]

if not na(pvLo)
    prevBotRsi   := botRsi
    prevBotBar   := botBar
    prevBotPrice := botPrice
    
    botRsi   := rsiValue[pivotLookback]
    botBar   := bar_index[pivotLookback]
    botPrice := low[pivotLookback]

// --- Divergence Detection ---
validLookback(pBar) => not na(pBar) and (bar_index - pBar) <= maxLookback

bearDiv = false
if not na(pvHi) and validLookback(prevTopBar)
    priceHigherHigh = high[pivotLookback] > prevTopPrice
    rsiLowerHigh    = rsiValue[pivotLookback] < prevTopRsi
    inOrLeavingOb   = (prevTopRsi >= obLevel) or (rsiValue[pivotLookback] >= obLevel)
    if priceHigherHigh and rsiLowerHigh and inOrLeavingOb
        bearDiv := true

bullDiv = false
if not na(pvLo) and validLookback(prevBotBar)
    priceLowerLow   = low[pivotLookback] < prevBotPrice
    rsiHigherLow    = rsiValue[pivotLookback] > prevBotRsi
    inOrLeavingOs   = (prevBotRsi <= osLevel) or (rsiValue[pivotLookback] <= osLevel)
    if priceLowerLow and rsiHigherLow and inOrLeavingOs
        bullDiv := true

// --- Sub-window Visualization ---
plotshape(bearDiv ? rsiValue[pivotLookback] : na, title="Bearish Div Shape", style=shape.labeldown, location=location.absolute, color=color.red, text="BEAR", textcolor=color.white, offset=-pivotLookback)
plotshape(bullDiv ? rsiValue[pivotLookback] : na, title="Bullish Div Shape", style=shape.labelup, location=location.absolute, color=color.green, text="BULL", textcolor=color.white, offset=-pivotLookback)

// FIXED: Using independent tracking variables for line persistence
var line bearLine = na
var line bullLine = na

if bearDiv
    line.delete(bearLine)
    bearLine := line.new(x1=prevTopBar, y1=prevTopRsi, x2=bar_index[pivotLookback], y2=rsiValue[pivotLookback], xloc=xloc.bar_index, color=color.red, width=2)
if bullDiv
    line.delete(bullLine)
    bullLine := line.new(x1=prevBotBar, y1=prevBotRsi, x2=bar_index[pivotLookback], y2=rsiValue[pivotLookback], xloc=xloc.bar_index, color=color.green, width=2)

// --- Strategy Entry Conditions ---
buySignal  = bullDiv and htfTrendUp
sellSignal = bearDiv and htfTrendDown

if (buySignal)
    strategy.entry("Long", strategy.long, comment="Buy")

if (sellSignal)
    strategy.entry("Short", strategy.short, comment="Sell")

if (bearDiv and strategy.position_size > 0)
    strategy.close("Long", comment="Exit Buy")

if (bullDiv and strategy.position_size < 0)
    strategy.close("Short", comment="Exit Sell")

// --- Main Chart Overlay Labels (FIXED: Plotting signals exactly on execution bar, not historically offset) ---
plotshape(buySignal, title="Price Buy Label", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal, text="BUY", textcolor=color.white, force_overlay=true)
plotshape(sellSignal, title="Price Sell Label", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal, text="SELL", textcolor=color.white, force_overlay=true)

// --- Shading Zones ---
fill(h_55, h_45, color=color.new(color.blue, 90), title="45-55 Equilibrium Shade")
fill(h_ob, h_mid, color=color.new(color.red, 95), title="Upper Range Shade")
fill(h_os, h_mid, color=color.new(color.green, 95), title="Lower Range Shade")
