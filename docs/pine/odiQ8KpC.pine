//@version=6
indicator(
     "IROSOFT - Trend Matrix MA",
     shorttitle = "TMMA",
     overlay = true
)

//==================================================
// Moving Average Settings
//==================================================

groupMA = "Moving Averages"

ema1Length = input.int(
     9,
     title = "Fast EMA Length",
     minval = 1,
     group = groupMA
)

ema2Length = input.int(
     20,
     title = "Medium EMA Length",
     minval = 1,
     group = groupMA
)

ema3Length = input.int(
     50,
     title = "Slow EMA Length",
     minval = 1,
     group = groupMA
)

smaLength = input.int(
     200,
     title = "Trend SMA Length",
     minval = 1,
     group = groupMA
)

//==================================================
// Moving Average Style
//==================================================

groupStyle = "Moving Average Style"

ema1Color = input.color(
     color.red,
     "Fast EMA Color",
     group = groupStyle
)

ema2Color = input.color(
     color.blue,
     "Medium EMA Color",
     group = groupStyle
)

ema3Color = input.color(
     color.aqua,
     "Slow EMA Color",
     group = groupStyle
)

smaColor = input.color(
     color.rgb(255, 191, 0),
     "Trend SMA Color",
     group = groupStyle
)

emaWidth = input.int(
     1,
     "EMA Width",
     minval = 1,
     maxval = 5,
     group = groupStyle
)

smaWidth = input.int(
     2,
     "SMA Width",
     minval = 1,
     maxval = 5,
     group = groupStyle
)

//==================================================
// Early Signal Settings
//==================================================

groupSignals = "Early Signal Settings"

enableEarlySignals = input.bool(
     true,
     "Enable Early BUY / SELL",
     group = groupSignals
)

convergenceBars = input.int(
     4,
     title = "Convergence Candles",
     minval = 2,
     maxval = 20,
     tooltip = "Number of recent candles analyzed to detect EMA convergence.",
     group = groupSignals
)

minimumConvergingBars = input.int(
     3,
     title = "Minimum Converging Candles",
     minval = 1,
     maxval = 20,
     tooltip = "Minimum number of candles where the distance between the fast and medium EMA must decrease.",
     group = groupSignals
)

slopeLookback = input.int(
     2,
     title = "EMA Slope Lookback",
     minval = 1,
     maxval = 10,
     tooltip = "Number of candles used to measure the direction and speed of the EMAs.",
     group = groupSignals
)

requirePriceMomentum = input.bool(
     true,
     title = "Require Price Momentum",
     tooltip = "BUY requires the price to rise. SELL requires the price to fall.",
     group = groupSignals
)

enableCrossConfirmation = input.bool(
     true,
     "Enable BUY+ / SELL+",
     group = groupSignals
)

//==================================================
// Higher-Timeframe Filter
//==================================================

groupHTF = "Higher Timeframe Filter"

enableHTFFilter = input.bool(
     true,
     "Enable Higher Timeframe Filter",
     group = groupHTF
)

higherTimeframe = input.timeframe(
     "60",
     "Higher Timeframe",
     tooltip = "Example: use 15 minutes when trading M1/M5, or 60 minutes when trading M15.",
     group = groupHTF
)

useHTFSlowEMA = input.bool(
     true,
     "Use Slow EMA in HTF Trend",
     group = groupHTF
)

useHTFSMA = input.bool(
     true,
     "Use SMA in HTF Trend",
     group = groupHTF
)

showCounterTrendSignals = input.bool(
     true,
     "Show Counter-Trend Signals",
     group = groupHTF
)

//==================================================
// Display Settings
//==================================================

groupDisplay = "Signal Display"

showEarlyLabels = input.bool(
     false,
     "Show BUY / SELL Labels",
     group = groupDisplay
)

showConfirmationLabels = input.bool(
     false,
     "Show BUY+ / SELL+ Labels",
     group = groupDisplay
)

showStrongLabels = input.bool(
     false,
     "Show BUY++ / SELL++ Labels",
     group = groupDisplay
)

//==================================================
// Current-Timeframe Calculations
//==================================================

ema1 = ta.ema(close, ema1Length)
ema2 = ta.ema(close, ema2Length)
ema3 = ta.ema(close, ema3Length)
sma1 = ta.sma(close, smaLength)

// Distance between the fast and medium EMA
emaDistance = math.abs(ema1 - ema2)

// EMA slopes
ema1Slope = ema1 - ema1[slopeLookback]
ema2Slope = ema2 - ema2[slopeLookback]

// Price momentum
bullishPriceMomentum = close > close[1]
bearishPriceMomentum = close < close[1]

//==================================================
// Convergence Calculation
//==================================================

// Count how many times the distance decreased
// during the selected number of candles.

int convergenceCount = 0

for i = 0 to convergenceBars - 2
    if emaDistance[i] < emaDistance[i + 1]
        convergenceCount += 1

requiredConvergence = math.min(
     minimumConvergingBars,
     convergenceBars - 1
)

isConverging = convergenceCount >= requiredConvergence

//==================================================
// Higher-Timeframe Calculations
//==================================================

// We use the last completed higher-timeframe candle
// to reduce repainting from an unfinished HTF candle.

htfClose = request.security(
     syminfo.tickerid,
     higherTimeframe,
     close[1],
     lookahead = barmerge.lookahead_on
)

htfEma1 = request.security(
     syminfo.tickerid,
     higherTimeframe,
     ta.ema(close, ema1Length)[1],
     lookahead = barmerge.lookahead_on
)

htfEma2 = request.security(
     syminfo.tickerid,
     higherTimeframe,
     ta.ema(close, ema2Length)[1],
     lookahead = barmerge.lookahead_on
)

htfEma3 = request.security(
     syminfo.tickerid,
     higherTimeframe,
     ta.ema(close, ema3Length)[1],
     lookahead = barmerge.lookahead_on
)

htfSma = request.security(
     syminfo.tickerid,
     higherTimeframe,
     ta.sma(close, smaLength)[1],
     lookahead = barmerge.lookahead_on
)

// Basic higher-timeframe direction
htfBullishBase = htfEma1 > htfEma2
htfBearishBase = htfEma1 < htfEma2

// Optional slow EMA confirmation
htfBullishSlowEMA = not useHTFSlowEMA or htfEma2 > htfEma3
htfBearishSlowEMA = not useHTFSlowEMA or htfEma2 < htfEma3

// Optional SMA confirmation
htfBullishSMA = not useHTFSMA or htfClose > htfSma
htfBearishSMA = not useHTFSMA or htfClose < htfSma

htfBullish =
     not enableHTFFilter or
     (
         htfBullishBase and
         htfBullishSlowEMA and
         htfBullishSMA
     )

htfBearish =
     not enableHTFFilter or
     (
         htfBearishBase and
         htfBearishSlowEMA and
         htfBearishSMA
     )

//==================================================
// Early BUY / SELL Logic
//==================================================

// Early BUY:
// - Fast EMA is still below medium EMA.
// - Their distance is decreasing.
// - Fast EMA is rising.
// - Fast EMA rises faster than medium EMA.
// - Price momentum is bullish if enabled.

earlyBuyRaw =
     enableEarlySignals and
     ema1 < ema2 and
     isConverging and
     ema1Slope > 0 and
     ema1Slope > ema2Slope and
     (
         not requirePriceMomentum or
         bullishPriceMomentum
     )

// Early SELL:
// - Fast EMA is still above medium EMA.
// - Their distance is decreasing.
// - Fast EMA is falling.
// - Fast EMA falls faster than medium EMA.
// - Price momentum is bearish if enabled.

earlySellRaw =
     enableEarlySignals and
     ema1 > ema2 and
     isConverging and
     ema1Slope < 0 and
     ema1Slope < ema2Slope and
     (
         not requirePriceMomentum or
         bearishPriceMomentum
     )

// Trigger only once when the condition first appears.
earlyBuySignal =
     earlyBuyRaw and
     not earlyBuyRaw[1]

earlySellSignal =
     earlySellRaw and
     not earlySellRaw[1]

//==================================================
// Crossover Confirmation
//==================================================

buyCross =
     enableCrossConfirmation and
     ta.crossover(ema1, ema2)

sellCross =
     enableCrossConfirmation and
     ta.crossunder(ema1, ema2)

//==================================================
// Signal Classification
//==================================================

// Early signals aligned with the higher timeframe
earlyBuyAligned =
     earlyBuySignal and
     htfBullish

earlySellAligned =
     earlySellSignal and
     htfBearish

// Early signals against the higher timeframe
earlyBuyCounterTrend =
     earlyBuySignal and
     not htfBullish and
     showCounterTrendSignals

earlySellCounterTrend =
     earlySellSignal and
     not htfBearish and
     showCounterTrendSignals

// Confirmed cross aligned with higher timeframe
strongBuy =
     buyCross and
     htfBullish

strongSell =
     sellCross and
     htfBearish

// Confirmed cross against higher timeframe
confirmedBuy =
     buyCross and
     not htfBullish and
     showCounterTrendSignals

confirmedSell =
     sellCross and
     not htfBearish and
     showCounterTrendSignals

//==================================================
// Moving Average Display
//==================================================

plot(
     ema1,
     title = "Fast EMA",
     color = ema1Color,
     linewidth = emaWidth
)

plot(
     ema2,
     title = "Medium EMA",
     color = ema2Color,
     linewidth = emaWidth
)

plot(
     ema3,
     title = "Slow EMA",
     color = ema3Color,
     linewidth = emaWidth
)

plot(
     sma1,
     title = "Trend SMA",
     color = smaColor,
     linewidth = smaWidth
)

//==================================================
// Signal Labels
//==================================================

// Early BUY aligned
plotshape(
     showEarlyLabels and earlyBuyAligned,
     title = "Early BUY",
     text = "BUY",
     style = shape.labelup,
     location = location.belowbar,
     color = color.new(color.lime, 20),
     textcolor = color.black,
     size = size.small
)

// Early BUY against higher-timeframe trend
plotshape(
     showEarlyLabels and earlyBuyCounterTrend,
     title = "Counter-Trend BUY",
     text = "BUY ⚠",
     style = shape.labelup,
     location = location.belowbar,
     color = color.orange,
     textcolor = color.black,
     size = size.small
)

// Early SELL aligned
plotshape(
     showEarlyLabels and earlySellAligned,
     title = "Early SELL",
     text = "SELL",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.new(color.red, 20),
     textcolor = color.white,
     size = size.small
)

// Early SELL against higher-timeframe trend
plotshape(
     showEarlyLabels and earlySellCounterTrend,
     title = "Counter-Trend SELL",
     text = "SELL ⚠",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.orange,
     textcolor = color.black,
     size = size.small
)

// Confirmed BUY against HTF trend
plotshape(
     showConfirmationLabels and confirmedBuy,
     title = "Confirmed BUY",
     text = "BUY+",
     style = shape.labelup,
     location = location.belowbar,
     color = color.green,
     textcolor = color.white,
     size = size.normal
)

// Confirmed SELL against HTF trend
plotshape(
     showConfirmationLabels and confirmedSell,
     title = "Confirmed SELL",
     text = "SELL+",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.maroon,
     textcolor = color.white,
     size = size.normal
)

// Confirmed BUY aligned with HTF trend
plotshape(
     showStrongLabels and strongBuy,
     title = "Strong BUY",
     text = "BUY++",
     style = shape.labelup,
     location = location.belowbar,
     color = color.lime,
     textcolor = color.black,
     size = size.normal
)

// Confirmed SELL aligned with HTF trend
plotshape(
     showStrongLabels and strongSell,
     title = "Strong SELL",
     text = "SELL++",
     style = shape.labeldown,
     location = location.abovebar,
     color = color.red,
     textcolor = color.white,
     size = size.normal
)

//==================================================
// TradingView Alerts
//==================================================

alertcondition(
     earlyBuyAligned,
     title = "TMMA Early BUY",
     message = "TMMA Early BUY detected on {{ticker}} - {{interval}}"
)

alertcondition(
     earlySellAligned,
     title = "TMMA Early SELL",
     message = "TMMA Early SELL detected on {{ticker}} - {{interval}}"
)

alertcondition(
     earlyBuyCounterTrend,
     title = "TMMA Counter-Trend BUY",
     message = "TMMA Counter-Trend BUY detected on {{ticker}} - {{interval}}"
)

alertcondition(
     earlySellCounterTrend,
     title = "TMMA Counter-Trend SELL",
     message = "TMMA Counter-Trend SELL detected on {{ticker}} - {{interval}}"
)

alertcondition(
     confirmedBuy,
     title = "TMMA BUY+",
     message = "TMMA BUY+ crossover confirmed on {{ticker}} - {{interval}}"
)

alertcondition(
     confirmedSell,
     title = "TMMA SELL+",
     message = "TMMA SELL+ crossover confirmed on {{ticker}} - {{interval}}"
)

alertcondition(
     strongBuy,
     title = "TMMA BUY++",
     message = "TMMA BUY++ crossover confirmed and aligned with the higher timeframe on {{ticker}} - {{interval}}"
)

alertcondition(
     strongSell,
     title = "TMMA SELL++",
     message = "TMMA SELL++ crossover confirmed and aligned with the higher timeframe on {{ticker}} - {{interval}}"
)