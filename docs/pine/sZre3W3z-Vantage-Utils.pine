// @function Returns an array mapping each TYPE_ integer ID to its default severity level. Delegates to the NewsTypes library. Index with a TYPE_ constant to get severity: 1=low, 2=medium (delayed start), 3=high (full-day block).
// @returns int[] — severity array indexed by TYPE_ ID
export LoadTypeSevByTypeId() =>
    int[] typeSevByTypeId = array.new_int()
    array.push(typeSevByTypeId, 1)  // 0 TYPE_CPI_m_m
    array.push(typeSevByTypeId, 2)  // 1 TYPE_CPI_y_y
    array.push(typeSevByTypeId, 1)  // 2 TYPE_Core_CPI_m_m
