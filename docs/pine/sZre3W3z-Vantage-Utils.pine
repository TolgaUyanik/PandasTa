// ============================================================================
// NEWS TIER 3: DATE CHECKERS
// ============================================================================

export CheckDateBlocked(NewsState this, string _dateStr) =>
    bool _blocked = false
    string _reasons = ""
    string _seen = ""
    int _maxSev = 0
    if this.config.useSev3TimeWindow
        int _rowsEval = array.size(this.cache.dateStr)
        int _policySize = array.size(this.config.policyByTypeId)
        if _rowsEval > 0
            for _i = 0 to _rowsEval - 1
                if array.get(this.cache.dateStr, _i) == _dateStr
                    int _tid = array.get(this.cache.typeId, _i)
                    if _tid >= _policySize
                        continue
                    int _sev = array.get(this.cache.severity, _i)
                    PolicyType _pol = array.get(this.config.policyByTypeId, _tid)
                    bool _isAllDay = _pol == PolicyType.block or (_pol == PolicyType.inherit and _sev == 3 and this.config.useSev3Filter)
                    if _isAllDay
                        string _nm = GetEventName(_tid)
                        bool _dupe = str.contains("|" + _seen + "|", "|" + _nm + "|")
                        if not _dupe
                            _reasons := _reasons == "" ? _nm : _reasons + ", " + _nm
                            _seen := _seen == "" ? _nm : _seen + "|" + _nm
                        _maxSev := _sev > _maxSev ? _sev : _maxSev
                        _blocked := true
    [_blocked, _reasons, _maxSev]

export CheckDateDelay(NewsState this, string _dateStr) =>
    int _releaseMax = 0
    string _reasons = ""
    string _seen = ""
    if this.config.useSev3TimeWindow
        int _rowsEval = array.size(this.cache.dateStr)
        int _policySize = array.size(this.config.policyByTypeId)
        if _rowsEval > 0
            for _i = 0 to _rowsEval - 1
                if array.get(this.cache.dateStr, _i) == _dateStr
                    int _tid = array.get(this.cache.typeId, _i)
                    if _tid >= _policySize
                        continue
                    int _sev = array.get(this.cache.severity, _i)
                    PolicyType _pol = array.get(this.config.policyByTypeId, _tid)
                    bool _isTimed = _pol == PolicyType.delay or (_pol == PolicyType.inherit and ((_sev == 2 and this.config.useSev2Filter) or (_sev == 1 and this.config.useSev1Filter)))
                    if _isTimed
                        int _tMs = array.get(this.cache.timeMS, _i)
                        bool _timeValid = _tMs > 0 and _tMs < 86400000
                        if _timeValid
                            int _delayMinEff = this.config.sev3PostDelayMin
                            int _relMs = _tMs + _delayMinEff * 60000
                            if _relMs > _releaseMax
                                _releaseMax := _relMs
                            string _nm = GetEventName(_tid)
                            bool _dupe = str.contains("|" + _seen + "|", "|" + _nm + "|")
                            if not _dupe
                                _reasons := _reasons == "" ? _nm : _reasons + ", " + _nm
                                _seen := _seen == "" ? _nm : _seen + "|" + _nm
    [_releaseMax, _reasons]

// ============================================================================
// NEWS TIER 4: SESSION EVALUATION
// ============================================================================

export EvaluateForDate(NewsState this, string _dateStr) =>
    bool _needEval = this.evaluatedDate != _dateStr
    if _needEval
        bool _allDay = false
        bool _timed = false
        int _lastMs = 0
        int _releaseMax = 0
        string _reasons = ""
        string _seen = ""
        int _maxSev = 0
        string _primaryBlock = ""
        string _primaryDelay = ""
        if this.config.useSev3TimeWindow
            int _rowsNews = array.size(this.cache.dateStr)
            int _policySize = array.size(this.config.policyByTypeId)
            if _rowsNews > 0
                for _i = 0 to _rowsNews - 1
                    if array.get(this.cache.dateStr, _i) == _dateStr
                        int _tid = array.get(this.cache.typeId, _i)
                        int _sev = array.get(this.cache.severity, _i)
                        if _tid >= _policySize
                            continue
                        PolicyType _pol = array.get(this.config.policyByTypeId, _tid)
                        bool _isAllDay = _pol == PolicyType.block or (_pol == PolicyType.inherit and _sev == 3 and this.config.useSev3Filter)
                        bool _isTimed = _pol == PolicyType.delay or (_pol == PolicyType.inherit and ((_sev == 2 and this.config.useSev2Filter) or (_sev == 1 and this.config.useSev1Filter)))
                        if _isAllDay
                            _allDay := true
                            string _nm = GetEventName(_tid)
                            bool _dupe = str.contains("|" + _seen + "|", "|" + _nm + "|")
                            if not _dupe
                                _reasons := _reasons == "" ? _nm : _reasons + ", " + _nm
                                _seen := _seen == "" ? _nm : _seen + "|" + _nm
                                if _primaryBlock == ""
                                    _primaryBlock := _nm
                            _maxSev := _sev > _maxSev ? _sev : _maxSev
                        if _isTimed
                            int _tMs = array.get(this.cache.timeMS, _i)
                            bool _timeValid = _tMs > 0 and _tMs < 86400000
                            if _timeValid
                                _timed := true
                                if _tMs > _lastMs
                                    _lastMs := _tMs
                                int _relMs = _tMs + this.config.sev3PostDelayMin * 60000
                                if _relMs > _releaseMax
                                    _releaseMax := _relMs
                                    _primaryDelay := GetEventName(_tid)
                                string _nm = GetEventName(_tid)
                                bool _dupe = str.contains("|" + _seen + "|", "|" + _nm + "|")
                                if not _dupe
                                    _reasons := _reasons == "" ? _nm : _reasons + ", " + _nm
                                    _seen := _seen == "" ? _nm : _seen + "|" + _nm
                                _maxSev := _sev > _maxSev ? _sev : _maxSev
        this.allDayBlocked := _allDay
        this.timedBlocked := _timed
        this.releaseMs := _timed ? _releaseMax : 0
        this.lastEventMs := _lastMs
        this.reasonsToday := _reasons
        this.primaryBlockReason := _primaryBlock
        this.primaryDelayReason := _primaryDelay
        this.maxSevToday := _maxSev
        this.evaluatedDate := _dateStr
    [this.allDayBlocked, this.timedBlocked, this.releaseMs, this.reasonsToday, this.maxSevToday]

// ============================================================================
// NEWS TIER 5: FUTURE SCANNERS
// ============================================================================

export ScanFuture(NewsState this, string _sessionDateStr, int _rangeEndTime, string _tzInput) =>
    string _earliestBlockedDate = na
    string _earliestBlockedReasons = ""
    int _earliestBlockedSev = 0
    int _sessKey = DateKey(_sessionDateStr)
    int _dayN = array.size(this.cache.dayStr)
    bool _foundNext = false
    for _j = 0 to _dayN - 1
        if not _foundNext
            string _d = array.get(this.cache.dayStr, _j)
            int _dKey = DateKey(_d)
            if _dKey > _sessKey
                [_blk, _reas, _sev] = CheckDateBlocked(this, _d)
                if _blk
                    _earliestBlockedDate := _d
                    _earliestBlockedReasons := _reas
                    _earliestBlockedSev := _sev
                    _foundNext := true
    this.nextBlockDate := _earliestBlockedDate
    this.nextBlockReasons := _earliestBlockedReasons
    this.nextBlockSev := _earliestBlockedSev
    this.nextAllowedDate := na
    if this.allDayBlocked
        int _yy = year(_rangeEndTime, _tzInput)
        int _mm = month(_rangeEndTime, _tzInput)
        int _dd = dayofmonth(_rangeEndTime, _tzInput)
        int _baseMid = timestamp(_tzInput, _yy, _mm, _dd, 0, 0)
        for _k = 1 to 14
            if na(this.nextAllowedDate)
                int _t = _baseMid + _k * 86400000
                int _yN = year(_t, _tzInput)
                int _mN = month(_t, _tzInput)
                int _dN = dayofmonth(_t, _tzInput)
                string _dstr = str.tostring(_yN) + "-" + str.tostring(_mN, "00") + "-" + str.tostring(_dN, "00")
                [_blk, _ignoredReasons, _ignoredSev] = CheckDateBlocked(this, _dstr)
                if not _blk
                    this.nextAllowedDate := _dstr
    true

export ScanNextEvent(NewsState this, string _sessionDateStr) =>
    this.nextNewsDate := na
    this.nextNewsReasons := ""
    this.nextNewsIsBlock := false
    this.nextNewsReleaseMs := 0
    int _sessKey = DateKey(_sessionDateStr)
    int _dayN = array.size(this.cache.dayStr)
    bool _found = false
    for _j = 0 to _dayN - 1
        if not _found
            string _d = array.get(this.cache.dayStr, _j)
            int _dKey = DateKey(_d)
            if _dKey > _sessKey
                [_blk, _blkReas, _blkSev] = CheckDateBlocked(this, _d)
                if _blk
                    this.nextNewsDate := _d
                    this.nextNewsReasons := _blkReas
                    this.nextNewsIsBlock := true
                    _found := true
                else
                    [_delMs, _delReas] = CheckDateDelay(this, _d)
                    if _delMs > 0
                        this.nextNewsDate := _d
                        this.nextNewsReasons := _delReas
                        this.nextNewsIsBlock := false
                        this.nextNewsReleaseMs := _delMs
                        _found := true
    true

export FindNextTradingWindow(NewsState this, string _todayDateStr, int _rangeEndTime, int _defaultStartMs, string _tzInput) =>
    EvaluateForDate(this, _todayDateStr)
    if not IsAllDayBlocked(this)
        this.nextTradingDate := _todayDateStr
        if this.timedBlocked and this.releaseMs > 0
            this.nextTradingStartMs := this.releaseMs
            this.nextTradingReasons := this.reasonsToday
        else
            this.nextTradingStartMs := _defaultStartMs
            this.nextTradingReasons := ""
    else
        this.nextTradingDate := na
        this.nextTradingStartMs := 0
        this.nextTradingReasons := ""
        int _yy = year(_rangeEndTime, _tzInput)
        int _mm = month(_rangeEndTime, _tzInput)
        int _dd = dayofmonth(_rangeEndTime, _tzInput)
        int _baseMid = timestamp(_tzInput, _yy, _mm, _dd, 0, 0)
        for _k = 1 to 14
            if na(this.nextTradingDate)
                int _t = _baseMid + _k * 86400000
                int _dow = dayofweek(_t, _tzInput)
                bool _isWeekday = _dow >= 2 and _dow <= 6
                if _isWeekday
                    int _yN = year(_t, _tzInput)
                    int _mN = month(_t, _tzInput)
                    int _dN = dayofmonth(_t, _tzInput)
                    string _dstr = str.tostring(_yN) + "-" + str.tostring(_mN, "00") + "-" + str.tostring(_dN, "00")
                    [_blk, _reas, _sev] = CheckDateBlocked(this, _dstr)
                    if not _blk
                        this.nextTradingDate := _dstr
                        [_delayMs, _delayReasons] = CheckDateDelay(this, _dstr)
                        if _delayMs > 0
                            this.nextTradingStartMs := _delayMs
                            this.nextTradingReasons := _delayReasons
                        else
                            this.nextTradingStartMs := _defaultStartMs
                            this.nextTradingReasons := ""
    ScanFuture(this, _todayDateStr, _rangeEndTime, _tzInput)
    ScanNextEvent(this, _todayDateStr)
    true

// ============================================================================
// NEWS: CME EARLY CLOSE
// ============================================================================

export CheckCmeEarlyClose(NewsState this, string _dateStr, int _rangeEndTs, string _tzInput) =>
    int _haltTs = 0
    int _dayIdx = array.indexof(this.cache.dayStr, _dateStr)
    if _dayIdx >= 0
        int _start = array.get(this.cache.dayStart, _dayIdx)
        int _end = array.get(this.cache.dayEnd, _dayIdx)
        for _i = _start to _end - 1
            int _tid = array.get(this.cache.typeId, _i)
            if _tid == TYPE_CME_EARLY_CLOSE
                int _timeMs = array.get(this.cache.timeMS, _i)
                int _yy = year(_rangeEndTs, _tzInput)
                int _mm = month(_rangeEndTs, _tzInput)
                int _dd = dayofmonth(_rangeEndTs, _tzInput)
                int _haltHour = math.floor(_timeMs / 3600000)
                int _haltMin = math.floor((_timeMs % 3600000) / 60000)
                _haltTs := timestamp(_tzInput, _yy, _mm, _dd, _haltHour, _haltMin)
                break
    _haltTs
