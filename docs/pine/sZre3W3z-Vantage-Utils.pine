//@version=6
// @description Non-trading utilities for Pine Script strategies. Most notably a news
// calendar state machine that bundles the NewsTypes vocabulary and calendar data
// libraries into a single NewsState object, and a P&L tracker UDT with per-trade
// labels and session / daily accumulators. Built on the UDT pseudo-class pattern —
// each capability owns its state behind a tight method surface so callers don't
// reinvent the bookkeeping.
library("Vantage_Utils", true)
import Vantage-Stack/Vantage_News/26 as packed
import Vantage-Stack/Vantage_News_Historical/2 as hist
import Vantage-Stack/Vantage_News_Types/1 as nt

// ─────────────────────────────────────────────────────────────────────────
// USAGE — instantiate a NewsState and/or PnLTracker and call methods on them.
// Copy the patterns into your strategy and adjust the timezone, dates, and
// handler hooks to match.
// ─────────────────────────────────────────────────────────────────────────
//
//   import Vantage-Stack/Vantage_Utils/1 as utils
//
//   // News-calendar state machine
//   var utils.NewsState news = utils.NewsState.new()
//   utils.LoadEvents(news)
//   utils.EvaluateForDate(news, "2026-04-13")
//   bool  blocked     = utils.IsBlocked(news, timenow_ms)
//   string nextWindow = utils.GetNextTradingWindowText(news, rangeEndMs, "America/Los_Angeles")
//
//   // P&L tracker
//   var utils.PnLTracker pnl = utils.PnLTracker.new()
//   utils.PnlCheckDayBoundary(pnl, "America/Los_Angeles")
//   // On each realized exit event from your strategy:
//   utils.PnlOnExitEvent(pnl, direction, fillPx, entryPx, fillQty, profit, commission, showLabels)
//
// ─────────────────────────────────────────────────────────────────────────

// ============================================================================
// STATE MACHINE CONSTANTS (must match main script values)
// ============================================================================
int _S_RESET              = 0
int _S_IDLE               = 1
int _S_WAITING_FOR_SETUP  = 2
int _S_WAITING_FOR_BREAKOUT = 3
int _S_IN_BREAKOUT_TRADE  = 4
int _S_AWAITING_RECOUP    = 5
int _S_IN_RECOUP_TRADE    = 6
int _S_COOLDOWN           = 7
int _S_CLEANING_UP        = 8

// ============================================================================
// INFO PANEL CONTEXT UDTs
// ============================================================================

// @type Session state context for info panel rendering: current state, halt/block/delay flags, position info, entry/exit prices, and filter status
export type InfoPanelStatusCtx
    int    currentState
    string resetReason
    bool   dllHalt
    bool   profitHalt
    bool   winHalt
    bool   newsBlocked
    bool   hitLimit
    bool   profitTargetReached
    int    giveUpTimeTs
    string giveUpTimeInput
    int    rangeEndTs
    string tzInput
    bool   newsDelayed
    string delayedUntilText
    string nextTradingFromNews
    bool   useSev3TimeWindow
    float  longEntry
    float  shortEntry
    int    positionSide
    float  entryPrice
    bool   recoupIsLong
    int    tradeSetsCompleted
    int    emergencyExitBar
    bool   emergencyExitSent
    int    lockUntilBarIdx
    bool   skipRecoupTrade

// @type Data context for info panel rendering: risk calculations, range metrics, P&L totals, display configuration, and news window text
export type InfoPanelDataCtx
    string presetTxt
    color  presetCol
    string stFilterMode
    bool   supertrendBullish
    float  trendStrength
    bool   strongBearish
    bool   strongBullish
    float  rangeHigh
    float  rangeLow
    float  effectiveMaxRange
    bool   isAutoRiskMode
    float  maxRangePoints
    float  prevRangePoints
    string prevRangeDate
    bool   snapTaken
    bool   autoRiskEnabled
    float  riskDollarsEff
    float  estAutoRiskFromMaxRange
    float  riskDollarsInput
    float  totalRiskModeled
    bool   dllExhausted
    bool   isHailMary
    bool   minOneYMOvershoot
    bool   partialExitActive
    bool   greenDayOptimized
    float  estTotalRiskManual
    bool   estOvershootManual
    float  estTotalRiskAuto
    bool   estOvershootAuto
    float  dayPL
    float  profitHaltTargetDollars
    bool   isHaltPctOrFixed
    bool   isHaltWinCount
    int    haltAfterWinTrades
    int    brcSpikeCount       = 0
    string brcFilterMode       = "Off"
    bool   inDefine            = false

// ============================================================================
// PNL TRACKER
// ============================================================================

// @type Accumulates realized P&L across a session: running dollar/point totals, trade/win/loss counts, day boundary detection, and chart label reference
export type PnLTracker
    varip float sessionPL
    varip float dayPL
    varip float curLossDollars
    varip int dayWinCount
    varip float lastTradePoints
    varip float lastTradeDollars
    varip bool lastTradeWasProfit
    varip bool lastTradeWasLong
    varip int lastTradeQty
    varip int lastTradeBar
    varip int lastProfitLblBar
    varip int dayStartMs

// @function Calculates realized P&L in dollars for a single trade including commission.
// @param entryPrice Entry fill price
// @param exitPrice Exit fill price
// @param qty Position quantity (contracts)
// @param commission Commission in dollars per side
// @returns Realized P&L in dollars
export PnlCalcTrade(float entryPrice, float exitPrice, float qty, float commission) =>
    bool isLong = qty > 0
    float absQty = math.abs(qty)
    float points = isLong ? (exitPrice - entryPrice) : (entryPrice - exitPrice)
    float dollars = (points * syminfo.pointvalue * absQty) - commission
    [points, dollars]

// @function Draws a P&L label on the chart at the current bar.
// @param pnl PnLTracker instance
// @param points Points gained or lost
// @param dollars Dollar P&L for the trade
// @param isLong True if the trade was a long
// @param isProfit True if the trade was profitable
export PnlDrawLabel(PnLTracker pnl, float points, float dollars, bool isLong, bool isProfit) =>
    string labelText = "P/L: " + str.tostring(points, "#.##") + " pts, $" + str.tostring(dollars, "#.##") + " [" + (isLong ? "Long" : "Short") + "]"
    color labelColor = isProfit ? color.green : color.red
    float yOffsetAmt = syminfo.mintick * 90
    float yPos = isProfit ? (high + yOffsetAmt) : (low - yOffsetAmt)
    string labelStyle = isProfit ? label.style_label_down : label.style_label_up
    int bumpSteps = isProfit and not na(pnl.lastProfitLblBar) and bar_index == pnl.lastProfitLblBar + 1 ? 1 : 0
    float bump = syminfo.mintick * 60 * bumpSteps
    yPos := isProfit ? (yPos + bump) : yPos
    label.new(bar_index, yPos, labelText, style=labelStyle, color=labelColor, textcolor=color.white, size=size.small)
    if isProfit
        pnl.lastProfitLblBar := bar_index
    true

// @function Processes a trade exit event: calculates P&L, updates tracker totals, and optionally draws a label.
// @param pnl PnLTracker instance
// @param direction Trade direction: 1=long, -1=short
// @param fillPrice Exit fill price
// @param entryPrice Entry fill price
// @param fillQty Quantity filled on exit
// @param profit Raw profit from strategy (used for sign check)
// @param commission Commission in dollars per side
// @param showLabels Whether to draw a P&L label on the chart
export PnlOnExitEvent(PnLTracker pnl, int direction, float fillPrice, float entryPrice, int fillQty, float profit, float commission, bool showLabels) =>
    if not na(profit)
        bool isLong = direction > 0
        [points, dollars] = PnlCalcTrade(entryPrice, fillPrice, isLong ? fillQty : -fillQty, commission)
        pnl.sessionPL := pnl.sessionPL + dollars
        pnl.dayPL := pnl.dayPL + dollars
        pnl.curLossDollars := pnl.dayPL < 0 ? -pnl.dayPL : 0.0
        pnl.lastTradePoints := points
        pnl.lastTradeDollars := dollars
        pnl.lastTradeWasProfit := points > 0
        pnl.lastTradeWasLong := isLong
        pnl.lastTradeQty := fillQty
        pnl.lastTradeBar := bar_index
        if points > 0
            pnl.dayWinCount := pnl.dayWinCount + 1
        if showLabels
            PnlDrawLabel(pnl, points, dollars, isLong, points > 0)
    true

// @function Resets session-level P&L accumulators (does not reset day totals).
// @param pnl PnLTracker instance
export PnlResetSession(PnLTracker pnl) =>
    pnl.sessionPL := 0.0
    pnl.lastTradePoints := na
    pnl.lastTradeDollars := na
    pnl.lastTradeWasProfit := false
    pnl.lastTradeWasLong := false
    pnl.lastTradeQty := 0
    pnl.lastTradeBar := na
    true

// @function Resets all day-level P&L accumulators and counters.
// @param pnl PnLTracker instance
export PnlResetDay(PnLTracker pnl) =>
    pnl.dayPL := 0.0
    pnl.curLossDollars := 0.0
    pnl.dayWinCount := 0
    pnl.lastProfitLblBar := na
    true

// @function Checks whether the current bar crosses into a new calendar day and resets day totals if so.
// @param pnl PnLTracker instance
// @param timezone Timezone string for day boundary detection (e.g., "America/Los_Angeles")
// @returns True if a day boundary was detected and totals were reset
export PnlCheckDayBoundary(PnLTracker pnl, string timezone) =>
    int yy = year(time, timezone)
    int mm = month(time, timezone)
    int dd = dayofmonth(time, timezone)
    int todayOpen = timestamp(timezone, yy, mm, dd, 15, 0)
    int effectiveDayStart = time < todayOpen ? todayOpen - 86400000 : todayOpen
    bool newDay = na(pnl.dayStartMs) or effectiveDayStart != pnl.dayStartMs
    if newDay
        pnl.dayStartMs := effectiveDayStart
        PnlResetDay(pnl)
    newDay

// @function Ensures the P&L label object exists, creating it if necessary.
// @param pnl PnLTracker instance
// @param showLabels Whether labels are enabled; no-ops if false
export PnlEnsureLabel(PnLTracker pnl, bool showLabels) =>
    if showLabels and not na(pnl.lastTradeBar) and pnl.lastTradeBar == bar_index and not na(pnl.lastTradePoints)
        PnlDrawLabel(pnl, pnl.lastTradePoints, pnl.lastTradeDollars, pnl.lastTradeWasLong, pnl.lastTradeWasProfit)
    true

// ============================================================================
// INFO PANEL RENDERER
// ============================================================================

_f_panel_size(simple string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

// @function Renders the strategy info panel table on the chart. Deletes the existing table, creates a new one, and populates all rows from the provided context structs. Call on barstate.islast only.
// @param panelRef Existing table reference (pass na on first call)
// @param sc InfoPanelStatusCtx populated with current session state
// @param dc InfoPanelDataCtx populated with current risk and P&L data
// @param panelSize Table text size: "Small", "Normal", "Large", etc.
// @returns Updated table reference; store this and pass back on the next call
export RenderInfoPanel(table panelRef, InfoPanelStatusCtx sc, InfoPanelDataCtx dc, simple string panelSize = "Small") =>
    if not na(panelRef)
        table.delete(panelRef)
    simple string _sz = _f_panel_size(panelSize)
    int _rows = dc.stFilterMode != "Off" ? 9 : 8
    table _panel = table.new(position=position.top_right, columns=2, rows=_rows, bgcolor=color.new(color.blue, 90), border_width=1, border_color=color.blue)

    table.cell(_panel, 0, 0, text="", bgcolor=color.new(color.navy, 100), text_color=color.new(color.white, 100), text_size=_sz)
    table.cell(_panel, 1, 0, text="", bgcolor=color.new(color.navy, 100), text_color=color.new(color.white, 100), text_size=_sz)

    string _statusTxt = ""
    color _statusCol = color.gray

    if sc.dllHalt
        _statusTxt := "Halted: DLL"
        _statusCol := color.red
    else if sc.profitHalt
        _statusTxt := "Halted: Profit Reached"
        _statusCol := color.green
    else if sc.winHalt
        _statusTxt := "Halted: Wins"
        _statusCol := color.green
    else if sc.tradeSetsCompleted == 0 and not na(sc.giveUpTimeTs) and time >= sc.giveUpTimeTs and (sc.currentState == _S_IDLE or sc.currentState == _S_CLEANING_UP)
        _statusTxt := "Done: Give-up (" + sc.giveUpTimeInput + ")"
        _statusCol := color.gray
    else if sc.newsBlocked
        _statusTxt := "Blocked: News"
        _statusCol := color.red
    else if sc.hitLimit
        _statusTxt := "Halted: Max Sets"
        _statusCol := color.white
    else if sc.currentState == _S_IDLE and str.startswith(sc.resetReason, "Skipped:")
        _statusTxt := sc.resetReason
        _statusCol := color.gray
    else if sc.currentState == _S_IDLE
        string _nxt = sc.nextTradingFromNews
        if str.length(_nxt) == 0 and not na(sc.rangeEndTs) and time < sc.rangeEndTs
            int _displayTs = sc.rangeEndTs
            int _dow = dayofweek(_displayTs, sc.tzInput)
            if _dow == dayofweek.saturday
                _displayTs := _displayTs + 2 * 86400000
            else if _dow == dayofweek.sunday
                _displayTs := _displayTs + 86400000
            int _dow2 = dayofweek(_displayTs, sc.tzInput)
            string _dn = _dow2 == 1 ? "Sun" : _dow2 == 2 ? "Mon" : _dow2 == 3 ? "Tue" : _dow2 == 4 ? "Wed" : _dow2 == 5 ? "Thu" : _dow2 == 6 ? "Fri" : "Sat"
            int _mm = month(_displayTs, sc.tzInput)
            int _dd = dayofmonth(_displayTs, sc.tzInput)
            int _hh = hour(_displayTs, sc.tzInput)
            int _mn = minute(_displayTs, sc.tzInput)
            int _h12 = _hh % 12 == 0 ? 12 : _hh % 12
            string _ap = _hh >= 12 ? "pm" : "am"
            _nxt := _dn + " " + str.tostring(_mm) + "/" + str.tostring(_dd) + " @ " + str.tostring(_h12) + ":" + str.tostring(_mn, "00") + " " + _ap
        _statusTxt := str.length(_nxt) > 0 ? "Idle: Next " + _nxt : "Idle"
        if sc.skipRecoupTrade
            _statusTxt := _statusTxt + " [No Recoup]"
        _statusCol := color.white
    else if sc.currentState == _S_WAITING_FOR_SETUP
        if sc.newsDelayed
            _statusTxt := "Waiting: News clears " + sc.delayedUntilText
            _statusCol := color.white
        else
            _statusTxt := "Waiting: Mid-range"
            _statusCol := color.white
    else if sc.currentState == _S_WAITING_FOR_BREAKOUT
        string _lp = not na(sc.longEntry) ? str.tostring(sc.longEntry, "#.##") : "?"
        string _sp = not na(sc.shortEntry) ? str.tostring(sc.shortEntry, "#.##") : "?"
        _statusTxt := "Ready: L@" + _lp + " / S@" + _sp
        if sc.skipRecoupTrade
            _statusTxt := _statusTxt + " [NR]"
        _statusCol := color.green
    else if sc.currentState == _S_IN_BREAKOUT_TRADE
        string _dir = sc.positionSide == 1 ? "LONG" : "SHORT"
        string _ep = not na(sc.entryPrice) ? str.tostring(sc.entryPrice, "#.##") : "?"
        _statusTxt := "Trading: " + _dir + " @ " + _ep
        _statusCol := color.green
    else if sc.currentState == _S_AWAITING_RECOUP
        string _rd = sc.recoupIsLong ? "Long" : "Short"
        _statusTxt := "Pending: Recoup " + _rd
        _statusCol := color.yellow
    else if sc.currentState == _S_IN_RECOUP_TRADE
        string _rd2 = sc.recoupIsLong ? "LONG" : "SHORT"
        string _ep2 = not na(sc.entryPrice) ? str.tostring(sc.entryPrice, "#.##") : "?"
        _statusTxt := "Recoup: " + _rd2 + " @ " + _ep2
        _statusCol := color.green
    else if sc.currentState == _S_COOLDOWN
        if not na(sc.emergencyExitBar) and not sc.emergencyExitSent and bar_index < sc.emergencyExitBar
            _statusTxt := "Cooldown: Sweeping"
            _statusCol := color.white
        else
            int _remain = not na(sc.lockUntilBarIdx) ? math.max(0, sc.lockUntilBarIdx - bar_index) : 0
            _statusTxt := "Cooldown: " + str.tostring(_remain) + " bars"
            _statusCol := color.white
    else if sc.currentState == _S_CLEANING_UP
        _statusTxt := "Session: Ending"
        _statusCol := color.white
    else
        _statusTxt := "State: " + str.tostring(sc.currentState)
        _statusCol := color.white

    table.cell(_panel, 0, 1, text="Status", bgcolor=color.navy, text_color=color.white, text_size=_sz)
    table.cell(_panel, 1, 1, text=_statusTxt, bgcolor=color.navy, text_color=_statusCol, text_size=_sz)

    table.cell(_panel, 0, 2, text="Mode", bgcolor=color.navy, text_color=color.white, text_size=_sz)
    table.cell(_panel, 1, 2, text=dc.presetTxt, bgcolor=color.navy, text_color=dc.presetCol, text_size=_sz)

    int _ro = dc.stFilterMode != "Off" ? 1 : 0

    if dc.stFilterMode != "Off"
        string _stTxt = dc.supertrendBullish ? "Bullish" : "Bearish"
        _stTxt := _stTxt + " " + str.tostring(math.abs(dc.trendStrength), "#.#") + "x"
        color _stCol = dc.supertrendBullish ? color.green : color.red
        if dc.stFilterMode == "Bias"
            _stTxt := _stTxt + " [Bias]"
            _stCol := color.yellow
        else if dc.stFilterMode == "Filter" and not dc.strongBearish and not dc.strongBullish
            _stTxt := _stTxt + " [Weak]"
            _stCol := color.yellow
        table.cell(_panel, 0, 3, text="Trend", bgcolor=color.navy, text_color=color.white, text_size=_sz)
        table.cell(_panel, 1, 3, text=_stTxt, bgcolor=color.navy, text_color=_stCol, text_size=_sz)

    string _rangeTxt = "—"
    color _rangeCol = color.white
    bool _autoSizer = dc.isAutoRiskMode and na(dc.effectiveMaxRange)
    float _effMaxDisplay = not _autoSizer and dc.isAutoRiskMode and not na(dc.effectiveMaxRange) ? dc.effectiveMaxRange : dc.maxRangePoints
    if not na(dc.rangeHigh) and not na(dc.rangeLow)
        float _rw = dc.rangeHigh - dc.rangeLow
        if dc.inDefine
            _rangeTxt := str.tostring(_rw, "#") + " / " + str.tostring(dc.maxRangePoints, "#") + " target"
            _rangeCol := color.gray
        else if _autoSizer
            _rangeTxt := str.tostring(_rw, "#") + " (Auto)"
        else
            _rangeTxt := str.tostring(_rw, "#") + " / " + str.tostring(_effMaxDisplay, "#") + " max"
            if _rw > _effMaxDisplay
                _rangeCol := color.red
    else if _autoSizer and _effMaxDisplay > 0
        _rangeTxt := str.tostring(_effMaxDisplay, "#") + " (target)"
    else if _effMaxDisplay > 0
        string _src = dc.isAutoRiskMode and not na(dc.effectiveMaxRange) and dc.effectiveMaxRange < dc.maxRangePoints ? " (DLL)" : ""
        _rangeTxt := str.tostring(_effMaxDisplay, "#") + " max" + _src
    else if not na(dc.prevRangePoints)
        _rangeTxt := str.tostring(dc.prevRangePoints, "#") + " (" + dc.prevRangeDate + ")"
    if dc.brcFilterMode != "Off" and dc.brcSpikeCount > 0
        _rangeTxt := _rangeTxt + " (BRC:" + str.tostring(dc.brcSpikeCount) + ")"
        _rangeCol := color.orange
    table.cell(_panel, 0, 3 + _ro, text="Range", bgcolor=color.navy, text_color=color.white, text_size=_sz)
    table.cell(_panel, 1, 3 + _ro, text=_rangeTxt, bgcolor=color.navy, text_color=_rangeCol, text_size=_sz)

    string _riskTxt = ""
    if dc.snapTaken and not na(dc.riskDollarsEff)
        _riskTxt := "$" + str.tostring(dc.riskDollarsEff, "#.##")
        if dc.autoRiskEnabled
            _riskTxt := _riskTxt + " (Auto)"
    else if not dc.snapTaken and not na(dc.estAutoRiskFromMaxRange)
        _riskTxt := "$" + str.tostring(dc.estAutoRiskFromMaxRange, "#.##") + " (Auto)"
    else if dc.autoRiskEnabled
        _riskTxt := "Auto (Pending)"
    else
        _riskTxt := "$" + str.tostring(math.abs(dc.riskDollarsInput), "#.##")
    table.cell(_panel, 0, 4 + _ro, text="Risk - Initial", bgcolor=color.navy, text_color=color.white, text_size=_sz)
    table.cell(_panel, 1, 4 + _ro, text=_riskTxt, bgcolor=color.navy, text_color=color.white, text_size=_sz)

    string _totalTxt = "—"
    color _totalCol = color.white
    if dc.snapTaken and not na(dc.totalRiskModeled)
        _totalTxt := "$" + str.tostring(dc.totalRiskModeled, "#.##")
        if dc.dllExhausted
            _totalTxt := _totalTxt + " (DLL)"
            _totalCol := color.white
        else if dc.isHailMary
            _totalTxt := _totalTxt + " (!!)"
            _totalCol := color.red
        else if dc.minOneYMOvershoot
            _totalTxt := _totalTxt + " (!)"
            _totalCol := color.red
        else if dc.partialExitActive
            _totalTxt := _totalTxt + " (P)"
            _totalCol := color.blue
        else if dc.greenDayOptimized
            _totalTxt := _totalTxt + " (G)"
            _totalCol := color.green
    else if not dc.snapTaken and not na(dc.estTotalRiskManual)
        _totalTxt := "$" + str.tostring(dc.estTotalRiskManual, "#.##")
        if dc.estOvershootManual
            _totalTxt := _totalTxt + " (!)"
            _totalCol := color.red
    else if not dc.snapTaken and not na(dc.estTotalRiskAuto)
        _totalTxt := "$" + str.tostring(dc.estTotalRiskAuto, "#.##") + " (Auto est)"
        if dc.estOvershootAuto
            _totalTxt := _totalTxt + " (!)"
            _totalCol := color.red
    else if not dc.snapTaken and not na(dc.totalRiskModeled)
        _totalTxt := "$" + str.tostring(dc.totalRiskModeled, "#.##") + " (Prev)"
        _totalCol := color.white
    table.cell(_panel, 0, 5 + _ro, text="Risk - Total", bgcolor=color.navy, text_color=color.white, text_size=_sz)
    table.cell(_panel, 1, 5 + _ro, text=_totalTxt, bgcolor=color.navy, text_color=_totalCol, text_size=_sz)

    string _plTxt = "$" + str.tostring(dc.dayPL, "#.##")
    if dc.isHaltPctOrFixed
        if dc.profitHaltTargetDollars > 0
            _plTxt := _plTxt + " / $" + str.tostring(dc.profitHaltTargetDollars, "#.##") + " Target"
    else if dc.isHaltWinCount and dc.haltAfterWinTrades > 0
        _plTxt := _plTxt + " / " + str.tostring(dc.haltAfterWinTrades) + " Wins"
    color _plCol = dc.dayPL > 0 ? color.green : dc.dayPL < 0 ? color.red : color.white
    if sc.profitTargetReached
        _plCol := color.green
    table.cell(_panel, 0, 6 + _ro, text="Day P&L", bgcolor=color.navy, text_color=color.white, text_size=_sz)
    table.cell(_panel, 1, 6 + _ro, text=_plTxt, bgcolor=color.navy, text_color=_plCol, text_size=_sz)

    string _nextTradingTxt = "—"
    bool _anyHalt = sc.dllHalt or sc.profitHalt or sc.winHalt or sc.hitLimit
    if not _anyHalt and ((sc.currentState == _S_IDLE and time < sc.rangeEndTs) or (sc.currentState == _S_WAITING_FOR_SETUP and sc.newsDelayed)) and sc.useSev3TimeWindow
        _nextTradingTxt := sc.nextTradingFromNews
        if str.length(_nextTradingTxt) == 0
            _nextTradingTxt := "—"
    table.cell(_panel, 0, 7 + _ro, text="Next Trading", bgcolor=color.navy, text_color=color.white, text_size=_sz)
    table.cell(_panel, 1, 7 + _ro, text=_nextTradingTxt, bgcolor=color.navy, text_color=color.white, text_size=_sz)

    _panel

// ============================================================================
// LOGGING WRAPPERS (from LO1_Utils)
// ============================================================================

// @function Logs exitCleanupDone set to true with context, tradeSet, and bar index.
// @param context Context label string
// @param tradeSet Current trade set index
// @param barIdx Current bar index
export LogCleanupTrue(string context, int tradeSet, int barIdx) =>
    log.info("[CLEANUP] exitCleanupDone → true ({0}, tradeSet={1}, bar={2})", context, tradeSet, barIdx)

// @function Logs exitCleanupDone set to false with context and bar index.
// @param context Context label string
// @param barIdx Current bar index
export LogCleanupFalse(string context, int barIdx) =>
    log.info("[CLEANUP] exitCleanupDone → false ({0}, bar={1})", context, barIdx)

// @function Logs a state machine transition with from/to states, trigger, bar index, and tradeSet.
// @param fromState Previous state integer ID
// @param toState Next state integer ID
// @param trigger String describing the event that caused the transition
// @param barIdx Current bar index
// @param tradeSet Current trade set index
export LogState(int fromState, int toState, string trigger, int barIdx, int tradeSet) =>
    log.info("State • {0} → {1} • trigger={2} • bar={3} • tradeSet={4}", fromState, toState, trigger, barIdx, tradeSet)

// @function Logs the auto-sizer's partial exit mode selection and baseline comparison.
// @param mode Selected partial exit mode string
// @param baseline Baseline contract count without partial exit
// @param withPartial Contract count with partial exit applied
// @param delta Incremental difference between withPartial and baseline
export LogPartialExitAutosizer(string mode, int baseline, int withPartial, int delta) =>
    log.info("[PARTIAL-EXIT] AutoSizer • mode={0} • baseline={1} • withPartial={2} • delta=+{3}", mode, baseline, withPartial, delta)

// @function Logs the partial exit optimizer's best configuration result.
// @param t1qty T1 partial exit quantity
// @param bestK Best K value selected by the optimizer
// @param exitQty Total exit quantity
// @param ymQty YM mini contract count
// @param worstCase Worst-case scenario string
// @param recoupNet Net recoup outcome string
export LogPartialExitOptimizer(int t1qty, int bestK, int exitQty, int ymQty, string worstCase, string recoupNet) =>
    log.info("[PARTIAL-EXIT] Optimizer • T1qty={0} • bestK={1} • exitQty={2} • ymQty={3} • worstCase={4} • recoupNet={5}", t1qty, bestK, exitQty, ymQty, worstCase, recoupNet)

// @function Logs a partial exit cancellation showing how many MYM contracts were kept.
// @param keptMYM Number of MYM micro contracts retained after cancellation
export LogPartialExitCancel(int keptMYM) =>
    log.info("[PARTIAL-EXIT] RecoupTP • MYM CancelSweep • keptMYM={0} • exiting all remaining", keptMYM)

// @function Logs session open with version prefix, date, and range high/low prices.
// @param versionPrefix Version string prefix for the log line
// @param dateStr Session date string
// @param rangeHigh Session range high price
// @param rangeLow Session range low price
export LogSessionStart(string versionPrefix, string dateStr, float rangeHigh, float rangeLow) =>
    log.info("[SESSION] " + versionPrefix + dateStr + " | range " + str.tostring(rangeHigh) + "-" + str.tostring(rangeLow))

// @function Logs session close with version prefix, date, and total trade set count.
// @param versionPrefix Version string prefix for the log line
// @param dateStr Session date string
// @param tradeSets Total number of trade sets completed this session
export LogSessionEnd(string versionPrefix, string dateStr, int tradeSets) =>
    log.info("[SESSION-END] " + versionPrefix + dateStr + " | trades: " + str.tostring(tradeSets))

// @function Logs a recoup trade cleanup sweep with ticker, tradeSet, qty, and kept MYM count.
// @param tag Log tag identifying the cleanup origin
// @param ticker Chart ticker symbol
// @param tradeSet Current trade set index
// @param qty Exit quantity dispatched
// @param keptMYM Number of MYM micro contracts retained
export LogOppCleanup(string tag, string ticker, int tradeSet, int qty, int keptMYM) =>
    log.info("{0} • CHART • {1} • tradeSet={2} • exitQty={3} • keptMYM={4}", tag, ticker, tradeSet, qty, keptMYM)

// @function Logs a P&L override showing bracket vs actual fill prices and resulting dollar P&L.
// @param bracketExitPx Bracket order exit price
// @param fillPx Actual exit fill price
// @param bracketEntryPx Bracket order entry price
// @param entryPx Actual entry fill price
// @param dollars Resulting dollar P&L after override
export LogPlOverride(float bracketExitPx, float fillPx, float bracketEntryPx, float entryPx, float dollars) =>
    log.info("[PL-OVERRIDE] exitBracketPx={0} exitFillPx={1} entryBracketPx={2} entryFillPx={3} dollars={4}", bracketExitPx, fillPx, bracketEntryPx, entryPx, dollars)

// @function Logs an atomic exit dispatch including cancel and close flags, tickers, qty, and proxy gate status.
// @param simPrefix Simulation mode prefix string
// @param reason Exit reason label
// @param doCancelAll Whether to cancel all open brackets
// @param doClose Whether to close the position
// @param chartTkr Chart instrument ticker symbol
// @param proxyTkr Proxy instrument ticker symbol
// @param exitQty Quantity being exited
// @param proxyGate Whether the proxy exit gate is open
export LogExitAtomic(string simPrefix, string reason, bool doCancelAll, bool doClose, string chartTkr, string proxyTkr, int exitQty, bool proxyGate) =>
    string _qtyStr = exitQty > 0 ? " • qty=" + str.tostring(exitQty) : ""
    log.info(simPrefix + "ExitAtomic • reason=" + reason + " • doCancelAll=" + str.tostring(doCancelAll) + " • doClose=" + str.tostring(doClose) + " • chart=" + chartTkr + " • proxy=" + proxyTkr + _qtyStr + " • proxyGate=" + str.tostring(proxyGate))

// @function Logs the end-of-session cleanup sweep status including position and bracket state.
// @param barIdx Current bar index
// @param tradeSets Total trade sets completed
// @param inPos Whether the strategy is currently in a position
// @param bracketsIssued Whether bracket orders have been issued
// @param firing Whether the cleanup sweep is actively firing
export LogCleanupSweep(int barIdx, int tradeSets, bool inPos, bool bracketsIssued, bool firing) =>
    log.info("[CLEANUP-SWEEP] bar={0} • tradeSets={1} • inPos={2} • bracketsIssued={3} • firing={4}", barIdx, tradeSets, inPos, bracketsIssued, firing)

// @function Logs a live session marker showing cleanup state and tradeSet at a given bar.
// @param barIdx Current bar index
// @param exitCleanupDone Whether exit cleanup has completed
// @param tradeSet Current trade set index
export LogLiveMarker(int barIdx, bool exitCleanupDone, int tradeSet) =>
    log.info("[LIVE] bar={0} — entering realtime polling (exitCleanupDone={1} tradeSet={2})", barIdx, exitCleanupDone, tradeSet)

// ── BRC Range Spike Filter ──
// Detects monster candles during range formation that set artificial high/low extremes.
// Library holds computation and logging; main script applies revert decisions.

// @type Bar Range Condition evaluation state: spike detection, peak BRC count, lockout tracking, and session range high/low
export type BrcState
    int   spikeCount        = 0
    int   barsElapsed       = 0
    bool  sessionSkipped    = false
    float peakBRC           = 0.0
    float currentBRC        = 0.0
    bool  revertHigh        = false
    bool  revertLow         = false
    float naturalHigh       = na
    float naturalLow        = na
    float lockedHigh        = na
    float lockedLow         = na

// @function Resets all BRC state fields to their initial values for a new session.
// @param s BrcState instance to reset
export BrcReset(BrcState s) =>
    s.spikeCount := 0
    s.barsElapsed := 0
    s.sessionSkipped := false
    s.peakBRC := 0.0
    s.currentBRC := 0.0
    s.revertHigh := false
    s.revertLow := false
    s.naturalHigh := na
    s.naturalLow := na
    s.lockedHigh := na
    s.lockedLow := na
    true

// @function Evaluates a single bar against the Bar Range Condition. Updates spike count, peak BRC, lockout state, and session range in the provided BrcState.
// @param s BrcState instance (updated in place)
// @param prevDayHigh Previous day's high price
// @param prevDayLow Previous day's low price
// @param barHigh Current bar's high price
// @param barLow Current bar's low price
// @param threshold BRC spike threshold in points
// @param minElapsed Minimum bars elapsed before BRC evaluation begins
// @param maxSpikes Maximum spikes before BRC is marked FILTERED
// @param filterMode Spike filter mode string
// @param showDebug Whether to log debug output to the chart
// @param lockAfterSpike Bars to lock out after a spike (0 = no lockout)
export BrcCheckBar(BrcState s, float prevDayHigh, float prevDayLow, float barHigh, float barLow, float threshold, int minElapsed, int maxSpikes, string filterMode, bool showDebug, int lockAfterSpike = 0) =>
    s.revertHigh := false
    s.revertLow := false
    s.barsElapsed += 1
    float _prevNatH = s.naturalHigh
    float _prevNatL = s.naturalLow
    s.naturalHigh := na(s.naturalHigh) ? barHigh : math.max(s.naturalHigh, barHigh)
    s.naturalLow := na(s.naturalLow) ? barLow : math.min(s.naturalLow, barLow)
    float _brcHigh = na(prevDayHigh) ? 0.0 : math.max(0.0, barHigh - prevDayHigh)
    float _brcLow = na(prevDayLow) ? 0.0 : math.max(0.0, prevDayLow - barLow)
    float _brc = math.max(_brcHigh, _brcLow)
    float _brcNatHigh = na(_prevNatH) ? 0.0 : math.max(0.0, barHigh - _prevNatH)
    float _brcNatLow = na(_prevNatL) ? 0.0 : math.max(0.0, _prevNatL - barLow)
    float _brcNat = math.max(_brcNatHigh, _brcNatLow)
    s.currentBRC := _brcNat
    s.peakBRC := math.max(s.peakBRC, _brcNat)
    bool _shouldRevert = s.barsElapsed >= minElapsed and _brc > threshold
    bool _isSpike = s.barsElapsed >= minElapsed and _brcNat > threshold
    if _shouldRevert and (filterMode == "Filter" or filterMode == "Skip")
        if _brcHigh >= _brcLow
            s.revertHigh := true
        else
            s.revertLow := true
    if _isSpike
        s.spikeCount += 1
        string _side = _brcNatHigh >= _brcNatLow ? "HIGH" : "LOW"
        if lockAfterSpike > 0 and s.spikeCount == lockAfterSpike
            if s.revertHigh
                s.lockedHigh := prevDayHigh
            if s.revertLow
                s.lockedLow := prevDayLow
            log.info("[BRC] LOCKED | spike #{0} | lockedHigh={1} | lockedLow={2}", s.spikeCount, str.tostring(s.lockedHigh, "#"), str.tostring(s.lockedLow, "#"))
        if maxSpikes > 0 and s.spikeCount >= maxSpikes
            s.sessionSkipped := true
        log.info("[BRC] SPIKE #{0} {1} | natBRC={2} | actBRC={3} | thresh={4}", s.spikeCount, _side, str.tostring(_brcNat, "#"), str.tostring(_brc, "#"), str.tostring(threshold, "#"))
        if s.sessionSkipped
            log.info("[BRC] CIRCUIT BREAKER | {0} spikes >= max {1}", s.spikeCount, maxSpikes)
        if filterMode == "Filter" or filterMode == "Skip" or showDebug
            label.new(bar_index, barLow, "BRC +" + str.tostring(_brcNat, "#"), style=label.style_label_up, color=color.new(color.orange, 30), textcolor=color.white, size=size.tiny)
    true

// @function Logs the BRC result summary line (CLEAN or FILTERED) with peak BRC, spike count, range, and threshold.
// @param s BrcState instance containing computed results
// @param dayHigh Session day high price
// @param dayLow Session day low price
// @param threshold BRC spike threshold used for this session
export BrcLogSummary(BrcState s, float dayHigh, float dayLow, float threshold) =>
    float _range = not na(dayHigh) and not na(dayLow) ? dayHigh - dayLow : 0.0
    string _status = s.sessionSkipped ? "SKIPPED" : s.spikeCount > 0 ? "FILTERED" : "CLEAN"
    log.info("[BRC] {0} | peakBRC={1} | spikes={2} | range={3} | thresh={4}", _status, str.tostring(s.peakBRC, "#"), s.spikeCount, str.tostring(_range, "#"), str.tostring(threshold, "#"))
    true

