// ============================================================================
// NEWS ENUM + UDT DEFINITIONS
// ============================================================================

export const int TYPE_CME_EARLY_CLOSE = 122

// @type News event policy classification: BLOCK, DELAY, ALLOW, or UNKNOWN
export enum PolicyType
    inherit = "Inherit"
    ignore = "Ignore"
    delay = "Delay then trade"
    block = "Block entire day"

// @type Configuration for the news calendar integration layer: severity enable flags, delay minutes, demote/promote override lists, and session timing
export type NewsConfig
    bool useSev3TimeWindow
    bool useSev3Filter
    bool useSev2Filter
    bool useSev1Filter
    int sev3PostDelayMin
    bool applyLibExceptionMappings
    string newsTzConst
    array<PolicyType> policyByTypeId
    array<int> typeSevByTypeId
    PolicyType defaultPolicyHigh
    PolicyType defaultPolicyMedium
    PolicyType defaultPolicyLow

// @type Cache of last news evaluation results to avoid re-computing on every bar: evaluation date, next event metadata, and scan expiry
export type NewsCache
    array<string> dateStr
    array<int> timeMS
    array<int> severity
    array<string> excTag
    array<int> typeId
    array<int> libDelayMins
    array<string> dayStr
    array<int> dayStart
    array<int> dayEnd

// @type Full resolved news state for the current session date: block/delay flags, delay end timestamp, reasons, severity, next trading window, and display text fields
export type NewsState
    NewsConfig config
    NewsCache cache
    varip bool allDayBlocked = false
    varip bool timedBlocked = false
    varip int releaseMs = 0
    varip string reasonsToday = ""
    varip string primaryBlockReason = ""
    varip string primaryDelayReason = ""
    varip int maxSevToday = 0
    varip string evaluatedDate = ""
    varip bool initialized = false
    varip string nextBlockDate = na
    varip string nextBlockReasons = ""
    varip int nextBlockSev = 0
    varip string nextAllowedDate = na
    varip string nextNewsDate = na
    varip string nextNewsReasons = ""
    varip bool nextNewsIsBlock = false
    varip int nextNewsReleaseMs = 0
    varip string nextTradingDate = ""
    varip int nextTradingStartMs = 0
    varip string nextTradingReasons = ""
    varip int lastEventMs = 0

// ============================================================================
// NEWS TIER 0: PURE HELPERS
// ============================================================================

export DateKey(string _s) =>
    int _yy = int(str.tonumber(str.substring(_s, 0, 4)))
    int _mm = int(str.tonumber(str.substring(_s, 5, 7)))
    int _dd = int(str.tonumber(str.substring(_s, 8, 10)))
    _yy * 10000 + _mm * 100 + _dd

// ============================================================================
// NEWS TIER 0.5: INITIALIZATION & DATA LOADING (light mode — no external libs)
// ============================================================================

MergeRows(NewsState this, string[] _dateArr, int[] _timeArr, int[] _typeArr, int[] _excSevArr, int[] _excDelayArr) =>
    int _count = array.size(_dateArr)
    int _sevSize = array.size(this.config.typeSevByTypeId)
    if _count > 0
        for _i = 0 to _count - 1
            string _d = array.get(_dateArr, _i)
            int _t = array.get(_timeArr, _i)
            int _tid = array.get(_typeArr, _i)
            if _tid >= _sevSize
                continue
            int _sevBase = array.get(this.config.typeSevByTypeId, _tid)
            int _excSev = array.get(_excSevArr, _i)
            int _sevEff = (this.config.applyLibExceptionMappings and _excSev > 0) ? _excSev : _sevBase
            int _excDelay = array.get(_excDelayArr, _i)
            array.push(this.cache.dateStr, _d)
            array.push(this.cache.timeMS, _t)
            array.push(this.cache.typeId, _tid)
            array.push(this.cache.severity, _sevEff)
            array.push(this.cache.excTag, "")
            array.push(this.cache.libDelayMins, _excDelay)
    _count

BuildDayIndex(NewsState this) =>
    array.clear(this.cache.dayStr)
    array.clear(this.cache.dayStart)
    array.clear(this.cache.dayEnd)
    int _rowsIdx = array.size(this.cache.dateStr)
    if _rowsIdx > 0
        string _curDayIdx = array.get(this.cache.dateStr, 0)
        int _startIdx = 0
        for _iIdx = 1 to _rowsIdx - 1
            string _dIdx = array.get(this.cache.dateStr, _iIdx)
            bool _changedIdx = _dIdx != _curDayIdx
            if _changedIdx
                array.push(this.cache.dayStr, _curDayIdx)
                array.push(this.cache.dayStart, _startIdx)
                array.push(this.cache.dayEnd, _iIdx)
                _curDayIdx := _dIdx
                _startIdx := _iIdx
        array.push(this.cache.dayStr, _curDayIdx)
        array.push(this.cache.dayStart, _startIdx)
        array.push(this.cache.dayEnd, _rowsIdx)
    true

Init(NewsState this) =>
    this.initialized := true
    this.evaluatedDate := ""
    this.allDayBlocked := false
    this.timedBlocked := false
    this.releaseMs := 0
    this.reasonsToday := ""
    this.primaryBlockReason := ""
    this.primaryDelayReason := ""
    this.maxSevToday := 0
    this.lastEventMs := 0
    this.nextTradingDate := ""
    this.nextTradingStartMs := 0
    this.nextTradingReasons := ""
    true


// Copy library-returned arrays element-by-element (F27 fix) and merge into cache
_copyAndMerge(NewsState this, string[] _dP, int[] _tP, int[] _iP, int[] _sP, int[] _delP) =>
    int _n = array.size(_dP)
    string[] _dArr = array.new_string()
    int[] _tArr = array.new_int()
    int[] _idArr = array.new_int()
    int[] _sevArr = array.new_int()
    int[] _delArr = array.new_int()
    for _k = 0 to _n - 1
        array.push(_dArr, array.get(_dP, _k))
        array.push(_tArr, array.get(_tP, _k))
        array.push(_idArr, array.get(_iP, _k))
        array.push(_sevArr, array.get(_sP, _k))
        array.push(_delArr, array.get(_delP, _k))
    MergeRows(this, _dArr, _tArr, _idArr, _sevArr, _delArr)

export LoadEvents(NewsState this) =>
    if array.size(this.config.typeSevByTypeId) == 0
        this.config.typeSevByTypeId := LoadTypeSevByTypeId()
    array.clear(this.cache.dateStr)
    array.clear(this.cache.timeMS)
    array.clear(this.cache.severity)
    array.clear(this.cache.excTag)
    array.clear(this.cache.typeId)
    array.clear(this.cache.libDelayMins)
    [_hD, _hT, _hI, _hS, _hDel] = hist.LoadNewsRows()
    _copyAndMerge(this, _hD, _hT, _hI, _hS, _hDel)
    [_dPacked, _tPacked, _iPacked, _sPacked, _delPacked] = packed.LoadNewsRows()
    _copyAndMerge(this, _dPacked, _tPacked, _iPacked, _sPacked, _delPacked)
    BuildDayIndex(this)
    Init(this)
    true

// ============================================================================
// NEWS TIER 1: SIMPLE GETTERS
// ============================================================================

export IsAllDayBlocked(NewsState this) =>
    this.config.useSev3TimeWindow and this.allDayBlocked

export IsDelayed(NewsState this, int currentTimeMs) =>
    bool _delayed = false
    if this.config.useSev3TimeWindow and this.timedBlocked and this.releaseMs > 0
        _delayed := currentTimeMs < this.releaseMs
    _delayed

export GetReleaseMs(NewsState this) => this.timedBlocked ? this.releaseMs : 0
export GetReasonsToday(NewsState this) => this.reasonsToday
export GetPrimaryBlockReason(NewsState this) => this.primaryBlockReason
export GetPrimaryDelayReason(NewsState this) => this.primaryDelayReason
export GetMaxSeverity(NewsState this) => this.maxSevToday
export GetNextBlockDate(NewsState this) => this.nextBlockDate
export GetNextBlockReasons(NewsState this) => this.nextBlockReasons
export GetNextBlockSev(NewsState this) => this.nextBlockSev
export GetNextAllowedDate(NewsState this) => this.nextAllowedDate
export GetNextTradingDate(NewsState this) => this.nextTradingDate
export GetNextTradingStartMs(NewsState this) => this.nextTradingStartMs
export GetNextTradingReasons(NewsState this) => this.nextTradingReasons

// ============================================================================
// NEWS TIER 2: COMPOUND GETTERS
// ============================================================================

// Returns true if news prevents trading RIGHT NOW — covers both the all-day
// block and the pre-release delay window. Most callers want this.
//
// WARNING: Do NOT use this when you specifically mean "kill the session for
// the rest of the day." On a delay-then-trade day IsBlocked() is true during
// the pre-release window and false afterward; treating it as a terminal
// block sends the session to cleanup before the delay ever ends. For that
// branch call IsAllDayBlocked() directly, and handle the delay via
// IsDelayed() on a separate path that waits it out.
export IsBlocked(NewsState this, int currentTimeMs) =>
    IsAllDayBlocked(this) or IsDelayed(this, currentTimeMs)

export WillTradeToday(NewsState this) => not IsAllDayBlocked(this)

export GetDelayText(NewsState this, int currentTimeMs) =>
    string _result = ""
    if IsDelayed(this, currentTimeMs) and this.releaseMs > 0
        int _relMinutes = int(math.floor(this.releaseMs / 60000))
        _relMinutes := math.max(0, math.min(_relMinutes, 23 * 60 + 59))
        int _hh24 = int(math.floor(_relMinutes / 60))
        int _mm = _relMinutes - _hh24 * 60
        int _hh12 = _hh24 % 12
        if _hh12 == 0
            _hh12 := 12
        string _suffix = _hh24 >= 12 ? "pm" : "am"
        _result := str.format("{0}:{1} {2}", str.tostring(_hh12), str.tostring(_mm, "00"), _suffix)
    _result

export GetActionUntilText(NewsState this, int currentTimeMs) =>
    string _result = ""
    if this.config.useSev3TimeWindow
        if IsAllDayBlocked(this)
            _result := "Full Day"
        else if IsDelayed(this, currentTimeMs) and this.releaseMs > 0
            int _relMinutes = int(math.floor(this.releaseMs / 60000))
            _relMinutes := math.max(0, math.min(_relMinutes, 23 * 60 + 59))
            int _hh24 = int(math.floor(_relMinutes / 60))
            int _mm = _relMinutes - _hh24 * 60
            int _hh12 = _hh24 % 12
            if _hh12 == 0
                _hh12 := 12
            string _suffix = _hh24 >= 12 ? "pm" : "am"
            _result := str.format("{0}:{1} {2}", str.tostring(_hh12), str.tostring(_mm, "00"), _suffix)
    _result

export GetDelayHHMM(NewsState this, int currentTimeMs) =>
    int _result = na
    if IsDelayed(this, currentTimeMs) and this.releaseMs > 0
        int _relMinutes = int(math.floor(this.releaseMs / 60000))
        _relMinutes := math.max(0, math.min(_relMinutes, 23 * 60 + 59))
        int _hh = int(math.floor(_relMinutes / 60))
        int _mm = _relMinutes - _hh * 60
        _result := _hh * 100 + _mm
    _result

export GetBlockedFlag(NewsState this) => IsAllDayBlocked(this) ? 1 : 0

export GetDelayHour(NewsState this, int currentTimeMs) =>
    int _result = na
    if IsDelayed(this, currentTimeMs) and this.releaseMs > 0
        int _relMinutes = int(math.floor(this.releaseMs / 60000))
        _result := int(math.floor(_relMinutes / 60))
    _result

export GetDelayMinute(NewsState this, int currentTimeMs) =>
    int _result = na
    if IsDelayed(this, currentTimeMs) and this.releaseMs > 0
        int _relMinutes = int(math.floor(this.releaseMs / 60000))
        int _hh = int(math.floor(_relMinutes / 60))
        _result := _relMinutes - _hh * 60
    _result

export GetDelayEndTimestamp(NewsState this, int _sessionRangeEnd, int currentTimeMs) =>
    int _result = na
    if IsDelayed(this, currentTimeMs) and this.releaseMs > 0
        int _relMinutes = int(math.floor(this.releaseMs / 60000))
        int _relH = int(math.floor(_relMinutes / 60))
        int _relM = _relMinutes - _relH * 60
        int _yy = year(_sessionRangeEnd, this.config.newsTzConst)
        int _mm = month(_sessionRangeEnd, this.config.newsTzConst)
        int _dd = dayofmonth(_sessionRangeEnd, this.config.newsTzConst)
        _result := timestamp(this.config.newsTzConst, _yy, _mm, _dd, _relH, _relM)
    _result

export GetNextTradingWindowText(NewsState this, int _defaultStartMs, string _tzInput) =>
    string _result = "-"
    if not na(this.nextTradingDate) and str.length(this.nextTradingDate) > 0
        int _yy = int(str.tonumber(str.substring(this.nextTradingDate, 0, 4)))
        int _mm = int(str.tonumber(str.substring(this.nextTradingDate, 5, 7)))
        int _dd = int(str.tonumber(str.substring(this.nextTradingDate, 8, 10)))
        int _t = timestamp(_tzInput, _yy, _mm, _dd, 12, 0)
        int _dow = dayofweek(_t, _tzInput)
        if _dow == dayofweek.saturday
            _t := _t + 2 * 86400000
        else if _dow == dayofweek.sunday
            _t := _t + 86400000
        int _displayDow = dayofweek(_t, _tzInput)
        int _displayMm = month(_t, _tzInput)
        int _displayDd = dayofmonth(_t, _tzInput)
        string _dayName = switch _displayDow
            1 => "Sun"
            2 => "Mon"
            3 => "Tue"
            4 => "Wed"
            5 => "Thu"
            6 => "Fri"
            7 => "Sat"
            => "???"
        int _startMs = this.nextTradingStartMs > 0 ? this.nextTradingStartMs : _defaultStartMs
        int _relMinutes = int(math.floor(_startMs / 60000))
        _relMinutes := math.max(0, math.min(_relMinutes, 23 * 60 + 59))
        int _hh24 = int(math.floor(_relMinutes / 60))
        int _mn = _relMinutes - _hh24 * 60
        int _hh12 = _hh24 % 12
        if _hh12 == 0
            _hh12 := 12
        string _ampm = _hh24 >= 12 ? "pm" : "am"
        string _timeStr = str.tostring(_hh12) + ":" + str.tostring(_mn, "00") + " " + _ampm
        _result := _dayName + " " + str.tostring(_displayMm) + "/" + str.tostring(_displayDd) + " @ " + _timeStr
    _result

// ============================================================================
// NEWS TIER 2.5: EVENT NAME LOOKUP
// ============================================================================

export GetEventName(int _tid) =>
    string _nm = switch _tid
        TYPE_CPI_m_m => "CPI m/m"
        TYPE_CPI_y_y => "CPI y/y"
        TYPE_Core_CPI_m_m => "Core CPI m/m"
        TYPE_Core_PPI_m_m => "Core PPI m/m"
