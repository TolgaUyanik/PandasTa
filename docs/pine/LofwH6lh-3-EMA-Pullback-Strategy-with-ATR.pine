// © 2025 Manann
//@version=5
indicator("3 EMA Pullback Strategy with ATR", shorttitle="3 EMA ATR Pullback", overlay=true)

// —————— 1. INPUTS & SETUP ——————
// Create a group for EMA settings for better UI organization
group_ema = "EMA Settings"
fast_ema_len = input.int(9, "Fast EMA Period", minval=1, group=group_ema)
medium_ema_len = input.int(21, "Medium EMA Period", minval=1, group=group_ema)
slow_ema_len = input.int(50, "Slow EMA Period", minval=1, group=group_ema)

// Create a group for ATR and Risk Management settings
group_risk = "ATR & Risk/Reward Settings"
atr_len = input.int(14, "ATR Period", minval=1, group=group_risk)
sl_multiplier = input.float(2.0, "ATR Stop Loss Multiplier", minval=0.1, step=0.1, group=group_risk)
rr_ratio = input.float(1.5, "Take Profit Risk/Reward Ratio", minval=0.1, step=0.1, group=group_risk)

// Create a group for visual settings
group_visuals = "Visual Settings"
show_ema_bands = input.bool(true, "Show Trend Background Color", group=group_visuals)
show_sl_tp = input.bool(true, "Show SL/TP Lines", group=group_visuals)

// —————— 2. INDICATOR CALCULATIONS ——————
// Calculate the three Exponential Moving Averages
fast_ema = ta.ema(close, fast_ema_len)
medium_ema = ta.ema(close, medium_ema_len)
slow_ema = ta.ema(close, slow_ema_len)

// Calculate the Average True Range for volatility
atr_value = ta.atr(atr_len)

// —————— 3. PLOT INDICATORS ON CHART ——————
// Plot the EMAs with distinct colors and line widths for clarity
plot(fast_ema, "Fast EMA", color=color.new(color.blue, 0), linewidth=2)
plot(medium_ema, "Medium EMA", color=color.new(color.orange, 0), linewidth=2)
plot(slow_ema, "Slow EMA", color=color.new(color.red, 0), linewidth=3)

// —————— 4. STRATEGY LOGIC & CONDITIONS ——————
// A. Trend Identification
// Uptrend is confirmed when EMAs are stacked bullishly (Fast > Medium > Slow)
is_uptrend = fast_ema > medium_ema and medium_ema > slow_ema
// Downtrend is confirmed when EMAs are stacked bearishly (Fast < Medium < Slow)
is_downtrend = fast_ema < medium_ema and medium_ema < slow_ema

// B. Pullback Identification
// A pullback in an uptrend is when price touches or dips slightly below the medium EMA
long_pullback = is_uptrend and ta.crossunder(low, medium_ema)

// A pullback in a downtrend is when price touches or rallies slightly above the medium EMA
short_pullback = is_downtrend and ta.crossover(high, medium_ema)

// C. Entry Signal
// Long entry: After a pullback in an uptrend, price closes back above the fast EMA
long_entry_signal = is_uptrend and ta.crossunder(close, fast_ema) == false and ta.crossover(close, fast_ema)

// Short entry: After a pullback in a downtrend, price closes back below the fast EMA
short_entry_signal = is_downtrend and ta.crossover(close, fast_ema) == false and ta.crossunder(close, fast_ema)

// —————— 5. STATE MANAGEMENT FOR TRADES ——————
// We use 'var' to declare variables that persist across bars
var float long_entry_price = na
var float long_stop_loss = na
var float long_take_profit = na
var float short_entry_price = na
var float short_stop_loss = na
var float short_take_profit = na

// —————— 6. EXECUTE TRADE LOGIC & CALCULATE SL/TP ——————
// Handle Long Trade Entry and SL/TP Calculation
if long_entry_signal
    // Set entry price and calculate SL/TP
    long_entry_price := close
    risk_amount_long = atr_value * sl_multiplier
    long_stop_loss := long_entry_price - risk_amount_long
    long_take_profit := long_entry_price + (risk_amount_long * rr_ratio)
    
    // Reset any existing short trade variables
    short_entry_price := na
    short_stop_loss := na
    short_take_profit := na

// Handle Short Trade Entry and SL/TP Calculation
if short_entry_signal
    // Set entry price and calculate SL/TP
    short_entry_price := close
    risk_amount_short = atr_value * sl_multiplier
    short_stop_loss := short_entry_price + risk_amount_short
    short_take_profit := short_entry_price - (risk_amount_short * rr_ratio)

    // Reset any existing long trade variables
    long_entry_price := na
    long_stop_loss := na
    long_take_profit := na

// Check if a trade should be invalidated or closed
// If price crosses the slow EMA, the trend is considered broken
if ta.cross(close, slow_ema)
    long_entry_price := na
    short_entry_price := na

// If price hits the SL or TP, reset the trade variables for that direction
if not na(long_entry_price) and (high >= long_take_profit or low <= long_stop_loss)
    long_entry_price := na

if not na(short_entry_price) and (low <= short_take_profit or high >= short_stop_loss)
    short_entry_price := na

// —————— 7. PLOT VISUALS ON CHART ——————
// A. Plot Entry Signals
// Plot a green upward-pointing triangle for long entries
plotshape(long_entry_signal, "Long Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="BUY")
// Plot a red downward-pointing triangle for short entries
plotshape(short_entry_signal, "Short Entry", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="SELL")

// B. Plot SL/TP Lines
// Only plot the lines if a trade is active and the user wants to see them
plot(show_sl_tp and not na(long_entry_price) ? long_take_profit : na, "Long TP", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(show_sl_tp and not na(long_entry_price) ? long_stop_loss : na, "Long SL", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

plot(show_sl_tp and not na(short_entry_price) ? short_take_profit : na, "Short TP", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(show_sl_tp and not na(short_entry_price) ? short_stop_loss : na, "Short SL", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

// C. Background Coloring to Visualize Trend
// Use a transparent green for uptrends and red for downtrends
bgcolor(show_ema_bands ? (is_uptrend ? color.new(color.green, 90) : is_downtrend ? color.new(color.red, 90) : na) : na)
