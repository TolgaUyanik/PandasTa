//@version=6
indicator("GLOBEX BOX v1.5", overlay=true, max_bars_back=5000)

// Timezone for Eastern Time (handles DST automatically)
tz = "America/New_York"

// Inputs
days_back = input.int(7, "Days Back (Default: Previous Week)", minval=1)
extend_future = input.bool(true, "Extend to Future (Toggle: Fixed 1 Bar vs Extend)")
custom_extend_bars = input.int(500, "Custom Extend Bars (500 max, if Extend Enabled)", minval=1, maxval=500)

// Toggle for box types
show_0930_boxes = input.bool(true, "Show 09:30 Boxes")
show_1800_boxes = input.bool(true, "Show 18:00 Boxes")

// Individual day toggles for 09:30
show_mon_0930 = input.bool(true, "Show Monday 09:30")
show_tue_0930 = input.bool(true, "Show Tuesday 09:30")
show_wed_0930 = input.bool(true, "Show Wednesday 09:30")
show_thu_0930 = input.bool(true, "Show Thursday 09:30")
show_fri_0930 = input.bool(true, "Show Friday 09:30")

// Individual day toggles for 18:00
show_sun_1800 = input.bool(true, "Show Sunday 18:00")
show_mon_1800 = input.bool(true, "Show Monday 18:00")
show_tue_1800 = input.bool(true, "Show Tuesday 18:00")
show_wed_1800 = input.bool(true, "Show Wednesday 18:00")
show_thu_1800 = input.bool(true, "Show Thursday 18:00")

// Monday 09:30 settings
border_color_mon_0930 = input.color(color.red, "Monday 09:30 Border Color")
bg_color_mon_0930 = input.color(color.new(color.red, 50), "Monday 09:30 Background Color")
midline_color_mon_0930 = input.color(color.blue, "Monday 09:30 Midline Color")
midline_style_str_mon_0930 = input.string("Dashed", "Monday 09:30 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_mon_0930 = input.bool(true, "Show Monday 09:30 Midline")
show_text_mon_0930 = input.bool(true, "Show Monday 09:30 Text")
text_color_mon_0930 = input.color(color.white, "Monday 09:30 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_mon_0930 = input.string("Left", "Monday 09:30 Horizontal Text Position", options=["Left", "Center", "Right"])
text_vert_position_mon_0930 = input.string("Above", "Monday 09:30 Vertical Text Position", options=["Above", "Middle", "Below"])

// Tuesday 09:30 settings
border_color_tue_0930 = input.color(color.red, "Tuesday 09:30 Border Color")
bg_color_tue_0930 = input.color(color.new(color.red, 50), "Tuesday 09:30 Background Color")
midline_color_tue_0930 = input.color(color.blue, "Tuesday 09:30 Midline Color")
midline_style_str_tue_0930 = input.string("Dashed", "Tuesday 09:30 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_tue_0930 = input.bool(true, "Show Tuesday 09:30 Midline")
show_text_tue_0930 = input.bool(true, "Show Tuesday 09:30 Text")
text_color_tue_0930 = input.color(color.white, "Tuesday 09:30 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_tue_0930 = input.string("Left", "Tuesday 09:30 Horizontal Text Position", options=["Left", "Center", "Right"])
text_vert_position_tue_0930 = input.string("Above", "Tuesday 09:30 Vertical Text Position", options=["Above", "Middle", "Below"])

// Wednesday 09:30 settings
border_color_wed_0930 = input.color(color.red, "Wednesday 09:30 Border Color")
bg_color_wed_0930 = input.color(color.new(color.red, 50), "Wednesday 09:30 Background Color")
midline_color_wed_0930 = input.color(color.blue, "Wednesday 09:30 Midline Color")
midline_style_str_wed_0930 = input.string("Dashed", "Wednesday 09:30 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_wed_0930 = input.bool(true, "Show Wednesday 09:30 Midline")
show_text_wed_0930 = input.bool(true, "Show Wednesday 09:30 Text")
text_color_wed_0930 = input.color(color.white, "Wednesday 09:30 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_wed_0930 = input.string("Left", "Wednesday 09:30 Horizontal Text Position", options=["Left", "Center", "Right"])
