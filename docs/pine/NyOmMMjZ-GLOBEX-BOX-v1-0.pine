// Thursday 09:30 settings
border_color_thu_0930 = input.color(color.red, "Thursday 09:30 Border Color")
bg_color_thu_0930 = input.color(color.new(color.red, 50), "Thursday 09:30 Background Color")
midline_color_thu_0930 = input.color(color.blue, "Thursday 09:30 Midline Color")
midline_style_str_thu_0930 = input.string("Dashed", "Thursday 09:30 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_thu_0930 = input.bool(true, "Show Thursday 09:30 Midline")
show_text_thu_0930 = input.bool(true, "Show Thursday 09:30 Text")
text_color_thu_0930 = input.color(color.white, "Thursday 09:30 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_thu_0930 = input.string("Left", "Thursday 09:30 Horizontal Text Position", options=["Left", "Center", "Right"])
text_vert_position_thu_0930 = input.string("Above", "Thursday 09:30 Vertical Text Position", options=["Above", "Middle", "Below"])

// Friday 09:30 settings
border_color_fri_0930 = input.color(color.red, "Friday 09:30 Border Color")
bg_color_fri_0930 = input.color(color.new(color.red, 50), "Friday 09:30 Background Color")
midline_color_fri_0930 = input.color(color.blue, "Friday 09:30 Midline Color")
midline_style_str_fri_0930 = input.string("Dashed", "Friday 09:30 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_fri_0930 = input.bool(true, "Show Friday 09:30 Midline")
show_text_fri_0930 = input.bool(true, "Show Friday 09:30 Text")
text_color_fri_0930 = input.color(color.white, "Friday 09:30 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_fri_0930 = input.string("Left", "Friday 09:30 Horizontal Text Position", options=["Left", "Center", "Right"])
text_vert_position_fri_0930 = input.string("Above", "Friday 09:30 Vertical Text Position", options=["Above", "Middle", "Below"])

// Sunday 18:00 settings
border_color_sun_1800 = input.color(color.red, "Sunday 18:00 Border Color")
bg_color_sun_1800 = input.color(color.new(color.red, 50), "Sunday 18:00 Background Color")
midline_color_sun_1800 = input.color(color.blue, "Sunday 18:00 Midline Color")
midline_style_str_sun_1800 = input.string("Dashed", "Sunday 18:00 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_sun_1800 = input.bool(true, "Show Sunday 18:00 Midline")
show_text_sun_1800 = input.bool(true, "Show Sunday 18:00 Text")
text_color_sun_1800 = input.color(color.white, "Sunday 18:00 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_sun_1800 = input.string("Left", "Sunday 18:00 Horizontal Text Position", options=["Left", "Center", "Right"])
text_vert_position_sun_1800 = input.string("Above", "Sunday 18:00 Vertical Text Position", options=["Above", "Middle", "Below"])

// Monday 18:00 settings
border_color_mon_1800 = input.color(color.red, "Monday 18:00 Border Color")
bg_color_mon_1800 = input.color(color.new(color.red, 50), "Monday 18:00 Background Color")
midline_color_mon_1800 = input.color(color.blue, "Monday 18:00 Midline Color")
midline_style_str_mon_1800 = input.string("Dashed", "Monday 18:00 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_mon_1800 = input.bool(true, "Show Monday 18:00 Midline")
show_text_mon_1800 = input.bool(true, "Show Monday 18:00 Text")
text_color_mon_1800 = input.color(color.white, "Monday 18:00 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_mon_1800 = input.string("Left", "Monday 18:00 Horizontal Text Position", options=["Left", "Center", "Right"])
text_vert_position_mon_1800 = input.string("Above", "Monday 18:00 Vertical Text Position", options=["Above", "Middle", "Below"])

// Tuesday 18:00 settings
border_color_tue_1800 = input.color(color.red, "Tuesday 18:00 Border Color")
bg_color_tue_1800 = input.color(color.new(color.red, 50), "Tuesday 18:00 Background Color")
midline_color_tue_1800 = input.color(color.blue, "Tuesday 18:00 Midline Color")
midline_style_str_tue_1800 = input.string("Dashed", "Tuesday 18:00 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_tue_1800 = input.bool(true, "Show Tuesday 18:00 Midline")
show_text_tue_1800 = input.bool(true, "Show Tuesday 18:00 Text")
text_color_tue_1800 = input.color(color.white, "Tuesday 18:00 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_tue_1800 = input.string("Left", "Tuesday 18:00 Horizontal Text Position", options=["Left", "Center", "Right"])
text_vert_position_tue_1800 = input.string("Above", "Tuesday 18:00 Vertical Text Position", options=["Above", "Middle", "Below"])

// Wednesday 18:00 settings
border_color_wed_1800 = input.color(color.red, "Wednesday 18:00 Border Color")
bg_color_wed_1800 = input.color(color.new(color.red, 50), "Wednesday 18:00 Background Color")
midline_color_wed_1800 = input.color(color.blue, "Wednesday 18:00 Midline Color")
midline_style_str_wed_1800 = input.string("Dashed", "Wednesday 18:00 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_wed_1800 = input.bool(true, "Show Wednesday 18:00 Midline")
show_text_wed_1800 = input.bool(true, "Show Wednesday 18:00 Text")
text_color_wed_1800 = input.color(color.white, "Wednesday 18:00 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_wed_1800 = input.string("Left", "Wednesday 18:00 Horizontal Text Position", options=["Left", "Center", "Right"])
text_vert_position_wed_1800 = input.string("Above", "Wednesday 18:00 Vertical Text Position", options=["Above", "Middle", "Below"])

// Thursday 18:00 settings
border_color_thu_1800 = input.color(color.red, "Thursday 18:00 Border Color")
bg_color_thu_1800 = input.color(color.new(color.red, 50), "Thursday 18:00 Background Color")
midline_color_thu_1800 = input.color(color.blue, "Thursday 18:00 Midline Color")
midline_style_str_thu_1800 = input.string("Dashed", "Thursday 18:00 Midline Style", options=["Solid", "Dashed", "Dotted"])
show_midline_thu_1800 = input.bool(true, "Show Thursday 18:00 Midline")
show_text_thu_1800 = input.bool(true, "Show Thursday 18:00 Text")
text_color_thu_1800 = input.color(color.white, "Thursday 18:00 Text Color (Adjust alpha for fade intensity)")
text_horiz_position_thu_1800 = input.string("Left", "Thursday 18:00 Horizontal Text Position", options=["Left", "Center", "Right"])
text_vert_position_thu_1800 = input.string("Above", "Thursday 18:00 Vertical Text Position", options=["Above", "Middle", "Below"])

// Fetch high/low for 09:30
current_tf_seconds = timeframe.in_seconds()
float one_min_high = na
float one_min_low = na
if current_tf_seconds > 60
    one_min_times = request.security_lower_tf(syminfo.tickerid, "1", time)
    one_min_highs = request.security_lower_tf(syminfo.tickerid, "1", high)
    one_min_lows = request.security_lower_tf(syminfo.tickerid, "1", low)
    if array.size(one_min_times) > 0
        for i = 0 to array.size(one_min_times) - 1
            t = array.get(one_min_times, i)
            if hour(t, tz) == 9 and minute(t, tz) == 30
                one_min_high := array.get(one_min_highs, i)
                one_min_low := array.get(one_min_lows, i)
                break
else
    if hour(time, tz) == 9 and minute(time, tz) == 30
        one_min_high := high
        one_min_low := low

// Expressions for request.security for 18:00
five_min_high_expr() =>
    var float h = na
    if ta.change(dayofmonth(time, tz)) != 0
        h := na
    if hour(time, tz) == 18 and minute(time, tz) == 0
        h := high
    h

five_min_low_expr() =>
    var float l = na
    if ta.change(dayofmonth(time, tz)) != 0
        l := na
    if hour(time, tz) == 18 and minute(time, tz) == 0
        l := low
    l

// Fetch high/low for 18:00
five_min_high = request.security(syminfo.tickerid, "5", five_min_high_expr(), barmerge.gaps_off, barmerge.lookahead_on)
five_min_low = request.security(syminfo.tickerid, "5", five_min_low_expr(), barmerge.gaps_off, barmerge.lookahead_on)

// Define event type
type event
    int bar
    float h
    float l
    int t
    int day_of_week

// Arrays for events and drawings
var array<event> events_0930 = array.new<event>()
var array<event> events_1800 = array.new<event>()
var array<box> boxes_0930 = array.new<box>()
var array<label> labels_0930 = array.new<label>()
var array<line> midlines_0930 = array.new<line>()
var array<box> boxes_1800 = array.new<box>()
var array<label> labels_1800 = array.new<label>()
var array<line> midlines_1800 = array.new<line>()

// Event durations in milliseconds
var int event_duration_0930 = 1 * 60 * 1000  // 1 minute for 09:30-09:31
var int event_duration_1800 = 5 * 60 * 1000  // 5 minutes for 18:00-18:05

// Detect if bar includes the event time
target_0930_time = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 9, 30, 0)
target_1800_time = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 18, 0, 0)

is_0930_bar = dayofweek(target_0930_time, tz) >= dayofweek.monday and dayofweek(target_0930_time, tz) <= dayofweek.friday and time <= target_0930_time and target_0930_time < time_close
is_1800_bar = dayofweek(target_1800_time, tz) >= dayofweek.sunday and dayofweek(target_1800_time, tz) <= dayofweek.thursday and time <= target_1800_time and target_1800_time < time_close

// Function to check if event already exists
event_exists(array<event> events, int target_time) =>
    bool exists = false
    if array.size(events) > 0
        for i = 0 to array.size(events) - 1
            if array.get(events, i).t == target_time
                exists := true
                break
    exists

// Function to get abbreviated day name
get_day_abbrev(dow) =>
    switch dow
        dayofweek.sunday => "SUN"
        dayofweek.monday => "MON"
        dayofweek.tuesday => "TUE"
        dayofweek.wednesday => "WED"
        dayofweek.thursday => "THU"
        dayofweek.friday => "FRI"
        dayofweek.saturday => "SAT"

// Function to get text x-position (horizontal)
get_text_x(position, left_bar, right_bar) =>
    switch position
        "Left" => left_bar + 10
        "Center" => math.round((left_bar + right_bar) / 2)
        "Right" => right_bar - 10

// Function to get text y-position (vertical)
get_text_y(position, top, bottom, mid) =>
    switch position
        "Above" => top
        "Middle" => mid
        "Below" => bottom

// Function to get line style
get_line_style(style_str) =>
    switch style_str
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        "Solid" => line.style_solid

// Function to check if 09:30 should be shown for a given day
show_0930_for_day(dow) =>
    switch dow
        dayofweek.monday => show_mon_0930
        dayofweek.tuesday => show_tue_0930
        dayofweek.wednesday => show_wed_0930
        dayofweek.thursday => show_thu_0930
        dayofweek.friday => show_fri_0930
        => false

// Function to check if 18:00 should be shown for a given day
show_1800_for_day(dow) =>
    switch dow
        dayofweek.sunday => show_sun_1800
        dayofweek.monday => show_mon_1800
        dayofweek.tuesday => show_tue_1800
        dayofweek.wednesday => show_wed_1800
        dayofweek.thursday => show_thu_1800
        => false

// Function to get 09:30 horizontal text position based on day
get_horiz_position_0930(dow) =>
    switch dow
        dayofweek.monday => text_horiz_position_mon_0930
        dayofweek.tuesday => text_horiz_position_tue_0930
        dayofweek.wednesday => text_horiz_position_wed_0930
        dayofweek.thursday => text_horiz_position_thu_0930
        dayofweek.friday => text_horiz_position_fri_0930
        => "Center"

// Function to get 18:00 horizontal text position based on day
get_horiz_position_1800(dow) =>
    switch dow
        dayofweek.sunday => text_horiz_position_sun_1800
        dayofweek.monday => text_horiz_position_mon_1800
        dayofweek.tuesday => text_horiz_position_tue_1800
        dayofweek.wednesday => text_horiz_position_wed_1800
        dayofweek.thursday => text_horiz_position_thu_1800
        => "Center"

// Function to get 09:30 vertical text position based on day
get_vert_position_0930(dow) =>
    switch dow
        dayofweek.monday => text_vert_position_mon_0930
        dayofweek.tuesday => text_vert_position_tue_0930
        dayofweek.wednesday => text_vert_position_wed_0930
        dayofweek.thursday => text_vert_position_thu_0930
        dayofweek.friday => text_vert_position_fri_0930
        => "Middle"

// Function to get 18:00 vertical text position based on day
get_vert_position_1800(dow) =>
    switch dow
        dayofweek.sunday => text_vert_position_sun_1800
        dayofweek.monday => text_vert_position_mon_1800
        dayofweek.tuesday => text_vert_position_tue_1800
        dayofweek.wednesday => text_vert_position_wed_1800
        dayofweek.thursday => text_vert_position_thu_1800
        => "Middle"

// Draw box, label, and midline for an event
draw_box(event e, bool is_0930_box, int right_bar) =>
    var box b = na
    var label l = na
    var line ln = na
    color border_col = na
    color bg_col = na
    color midline_col = na
    string midline_style_str = "Dashed"
    bool show_mid = false
    bool show_txt = false
    color text_col = na
    string text_horiz = "Center"
    string text_vert = "Middle"
    if is_0930_box and show_0930_boxes and show_0930_for_day(e.day_of_week)
        switch e.day_of_week
            dayofweek.monday =>
                border_col := border_color_mon_0930
                bg_col := bg_color_mon_0930
                midline_col := midline_color_mon_0930
                midline_style_str := midline_style_str_mon_0930
                show_mid := show_midline_mon_0930
                show_txt := show_text_mon_0930
                text_col := text_color_mon_0930
                text_horiz := text_horiz_position_mon_0930
                text_vert := text_vert_position_mon_0930
            dayofweek.tuesday =>
                border_col := border_color_tue_0930
                bg_col := bg_color_tue_0930
                midline_col := midline_color_tue_0930
                midline_style_str := midline_style_str_tue_0930
                show_mid := show_midline_tue_0930
                show_txt := show_text_tue_0930
                text_col := text_color_tue_0930
                text_horiz := text_horiz_position_tue_0930
                text_vert := text_vert_position_tue_0930
            dayofweek.wednesday =>
                border_col := border_color_wed_0930
                bg_col := bg_color_wed_0930
                midline_col := midline_color_wed_0930
                midline_style_str := midline_style_str_wed_0930
                show_mid := show_midline_wed_0930
                show_txt := show_text_wed_0930
                text_col := text_color_wed_0930
                text_horiz := text_horiz_position_wed_0930
                text_vert := text_vert_position_wed_0930
            dayofweek.thursday =>
                border_col := border_color_thu_0930
                bg_col := bg_color_thu_0930
                midline_col := midline_color_thu_0930
                midline_style_str := midline_style_str_thu_0930
                show_mid := show_midline_thu_0930
                show_txt := show_text_thu_0930
                text_col := text_color_thu_0930
                text_horiz := text_horiz_position_thu_0930
                text_vert := text_vert_position_thu_0930
            dayofweek.friday =>
                border_col := border_color_fri_0930
                bg_col := bg_color_fri_0930
                midline_col := midline_color_fri_0930
                midline_style_str := midline_style_str_fri_0930
                show_mid := show_midline_fri_0930
                show_txt := show_text_fri_0930
                text_col := text_color_fri_0930
                text_horiz := text_horiz_position_fri_0930
                text_vert := text_vert_position_fri_0930
        b := box.new(left=e.bar, right=right_bar, top=e.h, bottom=e.l, border_color=border_col, bgcolor=bg_col)
        array.push(boxes_0930, b)
        mid = (e.h + e.l) / 2
        if show_txt
            label_str = "0930 " + get_day_abbrev(e.day_of_week)
            text_x = get_text_x(text_horiz, e.bar, right_bar)
            text_y = get_text_y(text_vert, e.h, e.l, mid)
            l := label.new(x=text_x, y=text_y, text=label_str, style=label.style_none, textcolor=text_col, size=size.normal)
            array.push(labels_0930, l)
        if show_mid
            ln := line.new(x1=e.bar, x2=right_bar, y1=mid, y2=mid, color=midline_col, style=get_line_style(midline_style_str))
            array.push(midlines_0930, ln)
    else if not is_0930_box and show_1800_boxes and show_1800_for_day(e.day_of_week)
        switch e.day_of_week
            dayofweek.sunday =>
                border_col := border_color_sun_1800
                bg_col := bg_color_sun_1800
                midline_col := midline_color_sun_1800
                midline_style_str := midline_style_str_sun_1800
                show_mid := show_midline_sun_1800
                show_txt := show_text_sun_1800
                text_col := text_color_sun_1800
                text_horiz := text_horiz_position_sun_1800
                text_vert := text_vert_position_sun_1800
            dayofweek.monday =>
                border_col := border_color_mon_1800
                bg_col := bg_color_mon_1800
                midline_col := midline_color_mon_1800
                midline_style_str := midline_style_str_mon_1800
                show_mid := show_midline_mon_1800
                show_txt := show_text_mon_1800
                text_col := text_color_mon_1800
                text_horiz := text_horiz_position_mon_1800
                text_vert := text_vert_position_mon_1800
            dayofweek.tuesday =>
                border_col := border_color_tue_1800
                bg_col := bg_color_tue_1800
                midline_col := midline_color_tue_1800
                midline_style_str := midline_style_str_tue_1800
                show_mid := show_midline_tue_1800
                show_txt := show_text_tue_1800
                text_col := text_color_tue_1800
                text_horiz := text_horiz_position_tue_1800
                text_vert := text_vert_position_tue_1800
            dayofweek.wednesday =>
                border_col := border_color_wed_1800
                bg_col := bg_color_wed_1800
                midline_col := midline_color_wed_1800
                midline_style_str := midline_style_str_wed_1800
                show_mid := show_midline_wed_1800
                show_txt := show_text_wed_1800
                text_col := text_color_wed_1800
                text_horiz := text_horiz_position_wed_1800
                text_vert := text_vert_position_wed_1800
            dayofweek.thursday =>
                border_col := border_color_thu_1800
                bg_col := bg_color_thu_1800
                midline_col := midline_color_thu_1800
                midline_style_str := midline_style_str_thu_1800
                show_mid := show_midline_thu_1800
                show_txt := show_text_thu_1800
                text_col := text_color_thu_1800
                text_horiz := text_horiz_position_thu_1800
                text_vert := text_vert_position_thu_1800
        b := box.new(left=e.bar, right=right_bar, top=e.h, bottom=e.l, border_color=border_col, bgcolor=bg_col)
        array.push(boxes_1800, b)
        mid = (e.h + e.l) / 2
        if show_txt
            label_str = "1800 " + get_day_abbrev(e.day_of_week)
            text_x = get_text_x(text_horiz, e.bar, right_bar)
            text_y = get_text_y(text_vert, e.h, e.l, mid)
            l := label.new(x=text_x, y=text_y, text=label_str, style=label.style_none, textcolor=text_col, size=size.normal)
            array.push(labels_1800, l)
        if show_mid
            ln := line.new(x1=e.bar, x2=right_bar, y1=mid, y2=mid, color=midline_col, style=get_line_style(midline_style_str))
            array.push(midlines_1800, ln)
    [b, l, ln]

// Add events and draw historical boxes when bars are confirmed and within lookback period
within_lookback_0930 = target_0930_time >= timenow - (days_back * 86400000)
within_lookback_1800 = target_1800_time >= timenow - (days_back * 86400000)

if is_0930_bar and show_0930_boxes and show_0930_for_day(dayofweek(target_0930_time, tz)) and within_lookback_0930 and not event_exists(events_0930, target_0930_time)
    new_event = event.new(bar_index, one_min_high, one_min_low, target_0930_time, dayofweek(target_0930_time, tz))
    array.push(events_0930, new_event)
    right_bar = extend_future ? bar_index + custom_extend_bars : bar_index + 1
    [b, l, ln] = draw_box(new_event, true, right_bar)
    array.push(boxes_0930, b)
    array.push(labels_0930, l)
    array.push(midlines_0930, ln)

if is_1800_bar and show_1800_boxes and show_1800_for_day(dayofweek(target_1800_time, tz)) and within_lookback_1800 and not event_exists(events_1800, target_1800_time)
    new_event = event.new(bar_index, five_min_high, five_min_low, target_1800_time, dayofweek(target_1800_time, tz))
    array.push(events_1800, new_event)
    right_bar = extend_future ? bar_index + custom_extend_bars : bar_index + 1
    [b, l, ln] = draw_box(new_event, false, right_bar)
    array.push(boxes_1800, b)
    array.push(labels_1800, l)
    array.push(midlines_1800, ln)

// Update extensions and ranges on the last bar
if barstate.islast
    // Extend all boxes if extend_future is enabled
    if extend_future
        if array.size(events_0930) > 0
            for i = 0 to array.size(events_0930) - 1
                e = array.get(events_0930, i)
                b = array.get(boxes_0930, i)
                box.set_right(b, bar_index + custom_extend_bars)
                if array.size(labels_0930) > i and not na(array.get(labels_0930, i))
                    horiz = get_horiz_position_0930(e.day_of_week)
                    text_x = get_text_x(horiz, e.bar, bar_index + custom_extend_bars)
                    label.set_x(array.get(labels_0930, i), text_x)
                if array.size(midlines_0930) > i and not na(array.get(midlines_0930, i))
                    line.set_x2(array.get(midlines_0930, i), bar_index + custom_extend_bars)
        
        if array.size(events_1800) > 0
            for i = 0 to array.size(events_1800) - 1
                e = array.get(events_1800, i)
                b = array.get(boxes_1800, i)
                box.set_right(b, bar_index + custom_extend_bars)
                if array.size(labels_1800) > i and not na(array.get(labels_1800, i))
                    horiz = get_horiz_position_1800(e.day_of_week)
                    text_x = get_text_x(horiz, e.bar, bar_index + custom_extend_bars)
                    label.set_x(array.get(labels_1800, i), text_x)
                if array.size(midlines_1800) > i and not na(array.get(midlines_1800, i))
                    line.set_x2(array.get(midlines_1800, i), bar_index + custom_extend_bars)
    
    // Update range for the last 09:30 event if within duration
    if array.size(events_0930) > 0
        e = array.get(events_0930, -1)
        if timenow < e.t + event_duration_0930
            e.h := one_min_high
            e.l := one_min_low
            b = array.get(boxes_0930, -1)
            box.set_top(b, e.h)
            box.set_bottom(b, e.l)
            new_mid = (e.h + e.l) / 2
            if array.size(midlines_0930) > (array.size(events_0930) - 1) and not na(array.get(midlines_0930, -1))
                ln = array.get(midlines_0930, -1)
                line.set_y1(ln, new_mid)
                line.set_y2(ln, new_mid)
            if array.size(labels_0930) > (array.size(events_0930) - 1) and not na(array.get(labels_0930, -1))
                vert = get_vert_position_0930(e.day_of_week)
                new_y = get_text_y(vert, e.h, e.l, new_mid)
                label.set_y(array.get(labels_0930, -1), new_y)
    
    // Update range for the last 18:00 event if within duration
    if array.size(events_1800) > 0
        e = array.get(events_1800, -1)
        if timenow < e.t + event_duration_1800
            e.h := five_min_high
            e.l := five_min_low
            b = array.get(boxes_1800, -1)
            box.set_top(b, e.h)
            box.set_bottom(b, e.l)
            new_mid = (e.h + e.l) / 2
            if array.size(midlines_1800) > (array.size(events_1800) - 1) and not na(array.get(midlines_1800, -1))
                ln = array.get(midlines_1800, -1)
                line.set_y1(ln, new_mid)
                line.set_y2(ln, new_mid)
            if array.size(labels_1800) > (array.size(events_1800) - 1) and not na(array.get(labels_1800, -1))
                vert = get_vert_position_1800(e.day_of_week)
                new_y = get_text_y(vert, e.h, e.l, new_mid)
                label.set_y(array.get(labels_1800, -1), new_y)