//@version=6
indicator("Trend Architecture Locked MTF Dashboard", overlay=true, max_labels_count=500)

// --- 1. INPUTS & PARAMETERS ---
htfPeriod    = input.timeframe("60", title="Dashboard Locked Timeframe", options=["5", "15", "60", "240", "D", "W"])
src          = input(close, title="Source")
ema9Len      = input.int(9, title="Ultra-Short EMA Length")
emaShortLen  = input.int(20, title="Short EMA Length")
emaMedLen    = input.int(50, title="Medium EMA Length")
smaLongLen   = input.int(200, title="Long SMA Length")
rsiLen       = input.int(14, title="RSI Length")

// --- 2. MULTI-TIMEFRAME DATA CALCULATION & FETCH ---
// We bundle the indicator calculations inside a function to query them cleanly from the higher timeframe
get_htf_metrics() =>
    v_ema9   = ta.ema(close, ema9Len)
    v_ema20  = ta.ema(close, emaShortLen)
    v_ema50  = ta.ema(close, emaMedLen)
    v_sma200 = ta.sma(close, smaLongLen)
    v_rsi    = ta.rsi(close, rsiLen)
    v_vwap   = ta.vwap(close)
    [close, v_ema9, v_ema20, v_ema50, v_sma200, v_rsi, v_vwap]

// Request data securely from the user-defined higher timeframe without future-leak bias
[htfClose, htfEma9, htfEma20, htfEma50, htfSma200, htfRsi, htfVwap] = request.security(syminfo.tickerid, htfPeriod, get_htf_metrics(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Universally supported financial metric
sharesOutstanding = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol=true)

// --- 3. TREND CONDITIONS (EVALUATED STRICTLY ON THE MACRO DATA) ---
isUptrend   = (htfEma20 > htfEma50) and (htfEma50 > htfSma200) and (htfClose > htfEma20) and (htfClose > htfVwap)
isDowntrend = (htfEma20 < htfEma50) and (htfEma50 < htfSma200) and (htfClose < htfEma20) and (htfClose < htfVwap)

// --- 4. DASHBOARD TABLE VISUAL (AUTO-ADJUSTS DESIGN TO CHOSEN TIMEFRAME) ---
var table trendTable = table.new(position = position.bottom_left, columns = 2, rows = 8, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray)

if barstate.islast
    // Header showing the active locked timeframe
    string tfDisplay = htfPeriod == "60" ? "1-Hour" : htfPeriod == "240" ? "4-Hour" : htfPeriod == "D" ? "Daily" : htfPeriod + "m"
    table.cell(trendTable, 0, 0, "Macro (" + tfDisplay + ")", text_color=color.white, bgcolor=color.gray, text_size=size.small)
    table.cell(trendTable, 1, 0, "Status",     text_color=color.white, bgcolor=color.gray, text_size=size.small)
    
    // Row 1: Structural Trend Status
    table.cell(trendTable, 0, 1, "Structure",  text_color=color.white, text_size=size.small)
    string trendText = isUptrend ? "Bullish Trend" : isDowntrend ? "Bearish Trend" : "Neutral / Choppy"
    color  trendColor = isUptrend ? color.green : isDowntrend ? color.red : color.orange
    table.cell(trendTable, 1, 1, trendText,    text_color=color.white, bgcolor=trendColor, text_size=size.small)
    
    // Row 2: Institutional Volume Benchmark (VWAP)
    table.cell(trendTable, 0, 2, "Price vs VWAP", text_color=color.white, text_size=size.small)
    bool priceAboveVwap = htfClose > htfVwap
    table.cell(trendTable, 1, 2, priceAboveVwap ? "Institutional Buying" : "Institutional Selling", text_color=color.white, bgcolor=priceAboveVwap ? color.teal : color.maroon, text_size=size.small)

    // Row 3: Ultra-Short Momentum (9 EMA Metric)
    table.cell(trendTable, 0, 3, "Price vs EMA9", text_color=color.white, text_size=size.small)
    bool priceAbove9 = htfClose > htfEma9
    table.cell(trendTable, 1, 3, priceAbove9 ? "Fast Momentum" : "Cooling Down", text_color=color.white, bgcolor=priceAbove9 ? color.teal : color.maroon, text_size=size.small)
    
    // Row 4: Price Position vs 20
    table.cell(trendTable, 0, 4, "Price vs EMA20", text_color=color.white, text_size=size.small)
    bool priceAbove20 = htfClose > htfEma20
    table.cell(trendTable, 1, 4, priceAbove20 ? "Above" : "Below", text_color=color.white, bgcolor=priceAbove20 ? color.teal : color.maroon, text_size=size.small)
    
    // Row 5: EMA Alignment
    table.cell(trendTable, 0, 5, "EMA 20/50 Cross", text_color=color.white, text_size=size.small)
    bool emaBullish = htfEma20 > htfEma50
    table.cell(trendTable, 1, 5, emaBullish ? "Bullish Alignment" : "Bearish Alignment", text_color=color.white, bgcolor=emaBullish ? color.teal : color.maroon, text_size=size.small)

    // Row 6: RSI Relative Strength
    table.cell(trendTable, 0, 6, "RSI (14)",   text_color=color.white, text_size=size.small)
    color rsiBg = (htfRsi >= 50 and htfRsi <= 70) ? color.teal : (htfRsi > 70) ? color.orange : color.maroon
    table.cell(trendTable, 1, 6, str.tostring(htfRsi, "#.##"), text_color=color.white, bgcolor=rsiBg, text_size=size.small)

    // Row 7: Capitalization Integrity Check
    table.cell(trendTable, 0, 7, "Shares Class", text_color=color.white, text_size=size.small)
    bool dataValid = not na(sharesOutstanding)
    string capText = dataValid ? (sharesOutstanding > 500000000 ? "Mega/Large Cap" : sharesOutstanding > 50000000 ? "Mid Cap" : "Small/Micro Cap") : "Standard Vol"
    color capBg = dataValid ? (sharesOutstanding < 50000000 ? color.orange : color.teal) : color.gray
    table.cell(trendTable, 1, 7, capText, text_color=color.white, bgcolor=capBg, text_size=size.small)

