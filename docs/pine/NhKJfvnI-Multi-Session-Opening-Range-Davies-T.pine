        nyaMid  := line.new(bar_index, math.avg(high, low), bar_index, math.avg(high, low), color=nyaCol, style=line.style_dashed)
    else if nyaIn
        nyaHigh := math.max(nyaHigh, high)
        nyaLow  := math.min(nyaLow, low)
        box.set_top(nyaBox, nyaHigh)
        box.set_bottom(nyaBox, nyaLow)
        box.set_right(nyaBox, bar_index)
        nyaMidY = math.avg(nyaHigh, nyaLow)
        line.set_y1(nyaMid, nyaMidY)
        line.set_y2(nyaMid, nyaMidY)
        line.set_x2(nyaMid, bar_index)
    if nyaEndS
        box.set_right(nyaBox, bar_index + nyaExt)
        line.set_x2(nyaMid, bar_index + nyaExt)
// }

