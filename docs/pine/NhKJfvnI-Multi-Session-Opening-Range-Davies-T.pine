//@version=6
indicator("Multi-Session Opening Range [Davies T]", shorttitle="MultiSess ORB", overlay=true, max_boxes_count=200, max_lines_count=200)

// ~~ Inputs: London {
lonEnable = input.bool(true, "Enable London", group="London")
lonSess   = input.session("0800-0815", "Session (HHMM-HHMM)", group="London")
lonTZ     = input.string("Europe/London", "Timezone", group="London")
lonExt    = input.int(120, "Extend (bars)", minval=0, group="London")
lonCol    = input.color(color.blue, "Color", group="London")
// }

// ~~ Inputs: New York AM {
nyaEnable = input.bool(true, "Enable New York AM", group="New York AM")
nyaSess   = input.session("0930-0945", "Session (HHMM-HHMM)", group="New York AM")
nyaTZ     = input.string("America/New_York", "Timezone", group="New York AM")
nyaExt    = input.int(120, "Extend (bars)", minval=0, group="New York AM")
nyaCol    = input.color(color.lime, "Color", group="New York AM")
// }

// ~~ Inputs: New York PM {
nypEnable = input.bool(false, "Enable New York PM", group="New York PM")
nypSess   = input.session("1330-1345", "Session (HHMM-HHMM)", group="New York PM")
nypTZ     = input.string("America/New_York", "Timezone", group="New York PM")
nypExt    = input.int(120, "Extend (bars)", minval=0, group="New York PM")
nypCol    = input.color(color.orange, "Color", group="New York PM")
// }

// ~~ Inputs: Asia (Tokyo) {
tokEnable = input.bool(false, "Enable Asia", group="Asia")
tokSess   = input.session("0900-0915", "Session (HHMM-HHMM)", group="Asia")
tokTZ     = input.string("Asia/Tokyo", "Timezone", group="Asia")
tokExt    = input.int(120, "Extend (bars)", minval=0, group="Asia")
tokCol    = input.color(color.purple, "Color", group="Asia")
// }

// ~~ State: London {
var box   lonBox  = na
var line  lonMid  = na
var float lonHigh = na
var float lonLow  = na

lonTime = time(timeframe.period, lonSess, lonTZ)
lonIn   = not na(lonTime)
lonNew  = lonIn and not lonIn[1]
lonEndS = not lonIn and lonIn[1]

if lonEnable
    if lonNew
        lonHigh := high
        lonLow  := low
        lonBox  := box.new(bar_index, high, bar_index, low, border_color=lonCol, bgcolor=color.new(lonCol, 85))
        lonMid  := line.new(bar_index, math.avg(high, low), bar_index, math.avg(high, low), color=lonCol, style=line.style_dashed)
    else if lonIn
        lonHigh := math.max(lonHigh, high)
        lonLow  := math.min(lonLow, low)
        box.set_top(lonBox, lonHigh)
        box.set_bottom(lonBox, lonLow)
        box.set_right(lonBox, bar_index)
        lonMidY = math.avg(lonHigh, lonLow)
        line.set_y1(lonMid, lonMidY)
        line.set_y2(lonMid, lonMidY)
        line.set_x2(lonMid, bar_index)
    if lonEndS
        box.set_right(lonBox, bar_index + lonExt)
        line.set_x2(lonMid, bar_index + lonExt)
// }

// ~~ State: New York AM {
var box   nyaBox  = na
var line  nyaMid  = na
var float nyaHigh = na
var float nyaLow  = na

nyaTime = time(timeframe.period, nyaSess, nyaTZ)
