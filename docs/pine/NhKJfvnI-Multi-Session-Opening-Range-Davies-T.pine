// ~~ State: Asia (Tokyo) {
var box   tokBox  = na
var line  tokMid  = na
var float tokHigh = na
var float tokLow  = na

tokTime = time(timeframe.period, tokSess, tokTZ)
tokIn   = not na(tokTime)
tokNew  = tokIn and not tokIn[1]
tokEndS = not tokIn and tokIn[1]

if tokEnable
    if tokNew
        tokHigh := high
