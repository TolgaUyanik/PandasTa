//@version=6
// ITF26 B1 — BB Fade SOL 5m.
// Bloque: 14:00-14:40 UTC (16:00-16:40 CEST)
//
// Lógica: cuando el precio toca la Banda de Bollinger lagged (shift 1 bar),
// entramos en la dirección contraria (fade) con límite en la banda,
// TP en la media móvil. TimeOnly exit al final del bloque.
//
// BB(20,2) — parámetros de literatura, sin optimizar
// Entry: LIMIT al nivel de la banda (Mode C — no market, no bar close)
// TP: midband. Sin stop fijo — TimeOnly es el stop implícito.
//
// OOS Dec-Feb: n=62 p=75.8% PF=3.056 WF=78/71/78%
// Reciente (Apr-May): n=21 p=66.7%
//
// VALIDACIÓN STRATEGY TESTER:
//   Período: Mar 19 – May 18 2026
//   Esperado: n≈40 | hit%≈60-70% | PF≈1.8-2.5
//   Tolerancia ±10pp en hit%, ±0.5 en PF
//   Si hit%<50% o PF<1.0 → estrategia en régimen adverso

strategy(
    title                  = "ITF26 B1 — BB Fade SOL 5m",
    shorttitle             = "ITF26-B1",
    overlay                = true,
    default_qty_type       = strategy.percent_of_equity,
    default_qty_value      = 125,
    initial_capital        = 100000,
    commission_type        = strategy.commission.percent,
    commission_value       = 0.02,
    slippage               = 1,
    calc_on_every_tick     = false,
    process_orders_on_close = false
)

// ── Inputs ───────────────────────────────────────────────────────────────────
float sz = input.float(125.0, "Sizing (% equity)", minval = 10.0, maxval = 300.0, step = 25.0,
     tooltip = "OOS optimal: 175%. Reciente conservador: 125%.")

// ── BB — entry logic usa versión lagged (sin look-ahead) ─────────────────────
float bb_basis_raw = ta.sma(close, 20)
float bb_dev_raw   = ta.stdev(close, 20)
float bb_mid       = bb_basis_raw[1]
float bb_upper     = bb_mid + 2.0 * bb_dev_raw[1]
float bb_lower     = bb_mid - 2.0 * bb_dev_raw[1]

// ── Filtro horario — solo B1, solo días de semana ────────────────────────────
int   h_utc      = hour(time, "UTC")
int   m_utc      = minute(time, "UTC")
bool  is_weekday = dayofweek(time, "UTC") != dayofweek.saturday and dayofweek(time, "UTC") != dayofweek.sunday
bool  in_b1    = h_utc == 14 and m_utc <= 40 and is_weekday
bool  b1_start = h_utc == 14 and m_utc == 0  and is_weekday
bool  b1_end   = h_utc == 14 and m_utc == 40 and is_weekday

// ── Estado ───────────────────────────────────────────────────────────────────
var bool  placed = false
var int   signal = 0
var float ep     = na
var float tp     = na

if b1_start
    placed := false
    signal := 0
    ep     := na
    tp     := na

// ── Entry: primer bar del bloque que toca la banda ───────────────────────────
if in_b1 and not placed and strategy.position_size == 0
    if not na(bb_upper) and not na(bb_lower) and not na(bb_mid)
        if high > bb_upper
            strategy.entry("B1S", strategy.short, qty = sz, limit = bb_upper, comment = "BB_Fade↓")
            signal := -1
            ep     := bb_upper
            tp     := bb_mid
            placed := true
        else if low < bb_lower
            strategy.entry("B1L", strategy.long, qty = sz, limit = bb_lower, comment = "BB_Fade↑")
            signal := 1
            ep     := bb_lower
            tp     := bb_mid
            placed := true

// ── TP exit intrabar ─────────────────────────────────────────────────────────
if strategy.position_size > 0 and not na(tp)
    strategy.exit("B1L_TP", from_entry = "B1L", limit = tp, comment = "TP→mid")
if strategy.position_size < 0 and not na(tp)
    strategy.exit("B1S_TP", from_entry = "B1S", limit = tp, comment = "TP→mid")

// ── TimeOnly exit al final del bloque ────────────────────────────────────────
if b1_end
    strategy.close("B1L", comment = "TimeOnly")
    strategy.close("B1S", comment = "TimeOnly")
    strategy.cancel("B1L")
    strategy.cancel("B1S")

// ── Plots: BB siempre visible, rodeando el precio ────────────────────────────
plot(bb_basis_raw + 2.0 * bb_dev_raw, "BB Upper", color.new(color.red,   30), 1)
plot(bb_basis_raw,                     "BB Mid",   color.new(color.gray,  40), 1)
plot(bb_basis_raw - 2.0 * bb_dev_raw, "BB Lower", color.new(color.green, 30), 1)
bgcolor(in_b1 ? color.new(color.purple, 93) : na, title = "B1 Zone")

// ── Tabla on-chart ───────────────────────────────────────────────────────────
var table tbl = table.new(position.bottom_right, 2, 5,
    bgcolor       = color.new(color.black, 75),
    border_width  = 1,
    border_color  = color.new(color.gray, 60),
    frame_width   = 1,
    frame_color   = color.new(color.gray, 50))

if barstate.islast
    table.cell(tbl, 0, 0, "ITF26 B1 — BB Fade",
        text_color = color.white, text_size = size.small,
        bgcolor = color.new(color.purple, 30))
    table.cell(tbl, 1, 0, "",
        text_color = color.white, text_size = size.small,
        bgcolor = color.new(color.purple, 30))

    table.cell(tbl, 0, 1, "Bloque",
        text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, "16:00-16:40 CEST",
        text_color = color.white, text_size = size.small)

    string sig_str = signal ==  1 ? "LONG  (fade↑)" :
                     signal == -1 ? "SHORT (fade↓)" :
                     placed       ? "Sin señal hoy"  : "Esperando…"
    color  sig_col = signal == 1  ? color.lime :
                     signal == -1 ? color.red  : color.gray
    table.cell(tbl, 0, 2, "Señal",
        text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, sig_str,
        text_color = sig_col, text_size = size.small)

    float pnl = strategy.openprofit
    string pnl_str = pnl == 0.0 ? "—" : str.tostring(math.round(pnl, 0)) + " USD"
    color  pnl_col = pnl > 0 ? color.lime : pnl < 0 ? color.red : color.gray
    table.cell(tbl, 0, 3, "PnL abierto",
        text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, pnl_str,
        text_color = pnl_col, text_size = size.small)

    int end_min_utc = 14 * 60 + 40
    int cur_min_utc = h_utc * 60 + m_utc
    int mins_left   = in_b1 ? math.max(0, end_min_utc - cur_min_utc) : 0
    string time_str = in_b1 ? str.tostring(mins_left) + " min" : "Fuera de bloque"
    table.cell(tbl, 0, 4, "Tiempo",
        text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 4, time_str,
        text_color = color.yellow, text_size = size.small)
