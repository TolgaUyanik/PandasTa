kz_nah_str = input.string("NYAM.H",  "KZ3 Labels", inline = "L_NA", group = g_LABELS)
kz_nal_str = input.string("NYAM.L",  "",           inline = "L_NA", group = g_LABELS)
kz_nlh_str = input.string("NYL.H",   "KZ4 Labels", inline = "L_NL", group = g_LABELS)
kz_nll_str = input.string("NYL.L",   "",           inline = "L_NL", group = g_LABELS)
kz_nph_str = input.string("NYPM.H",  "KZ5 Labels", inline = "L_NP", group = g_LABELS)
