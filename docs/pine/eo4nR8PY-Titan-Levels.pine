kz_kzp_style_str = input.string("Solid",  "Pivot Style",    options = ["Solid","Dotted","Dashed"], inline = "KZP", group = g_LABELS)
kz_kzp_width     = input.int(1, "",                         inline = "KZP", group = g_LABELS)
kz_kzm_style_str = input.string("Dotted", "Midpoint Style", options = ["Solid","Dotted","Dashed"], inline = "KZM", group = g_LABELS)
kz_kzm_width     = input.int(1, "",                         inline = "KZM", group = g_LABELS)

var g_RNG         = "🕐 ICT — Killzone Range"
kz_show_range     = input.bool(false, "Show Killzone Range", group = g_RNG)
kz_show_range_avg = input.bool(true,  "Show Average",        group = g_RNG)
kz_range_avg      = input.int(5,      "Average Length",      group = g_RNG)
kz_range_pos_str  = input.string("Top Right", "Table Position", options = ["Bottom Center","Bottom Left","Bottom Right","Middle Center","Middle Left","Middle Right","Top Center","Top Left","Top Right"], group = g_RNG)
kz_range_sz_str   = input.string("Normal",    "Table Size",    options = ["Auto","Tiny","Small","Normal","Large","Huge"], group = g_RNG)

var g_DWM         = "🕐 ICT — Day/Week/Month"
kz_sep_unlimited  = input.bool(false, "Unlimited", group = g_DWM)
kz_alert_HL       = input.bool(false, "Alert High/Low Break", group = g_DWM)

kz_show_d_open = input.bool(false, "D Open",    inline = "DO", group = g_DWM)
