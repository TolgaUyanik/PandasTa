//@version=6
indicator("TitanLevels",
         shorttitle       = "TitanLevels",
         overlay          = true,
         max_lines_count  = 500,
         max_labels_count = 500,
         max_boxes_count  = 500,
         max_bars_back    = 500)

// ════════════════════════════════════════════════════════════
//  TitanLevels — suite combinată
//    1) Sweep Rejection Levels (multi-timeframe)
//    2) ICT Killzones & Pivots + Day/Week/Month
//    3) Supply / Demand + Swing H/L
//    4) Key Levels (port SpacemanBTC IDWM)
//  Subject to the Mozilla Public License 2.0 — https://mozilla.org/MPL/2.0/
// ════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════════════
//  📈  1) SWEEP REJECTION LEVELS
// ════════════════════════════════════════════════════════════

// ============================================================
//  Sweep Rejection Levels — Multi-Timeframe
//
//  Detectează formațiunea de 2 candele adiacente:
//    - VÂRF (bearish) : stânga bullish -> dreapta bearish;
//                       dreapta face wick PESTE close-ul stângii
//                       și închide SUB el  (sweep + rejection).
//    - FUND (bullish) : stânga bearish -> dreapta bullish;
//                       dreapta face wick SUB close-ul stângii
//                       și închide PESTE el.
//
//  Linia se trage la CLOSE-ul candelei din stânga, ancorată în timp
//  la candela sursă și extinsă spre dreapta.
//  Culoarea + label-ul indică timeframe-ul pe care a fost detectată.
//
//  LIFECYCLE: linia dispare după N evenimente (default 3). Două moduri:
//    - Spargere (close) : candela ÎNCHIDE de partea opusă a nivelului.
//                         Wick-urile care traversează nu contează.
//    - Atingere (wick)  : wick-ul atinge nivelul; se numără o singură dată
//                         per vizită (prețul trebuie să plece și să revină).
//
//  LOOKBACK: se detectează doar în ultimele N candele ALE FIECĂRUI TF.
//
//  NOTĂ: request.security() nu poate coborî sub timeframe-ul chartului.
//  Pentru detecție corectă a M15, stai pe chart de 15m sau mai jos.
// ============================================================

// ---------------- Timeframes ----------------
gTF = "📈 Sweep — Timeframes"
useM15 = input.bool(true,  "M15",   inline = "m15", group = gTF)
tfM15  = input.timeframe("15",  "",  inline = "m15", group = gTF)
useH1  = input.bool(true,  "H1",    inline = "h1",  group = gTF)
tfH1   = input.timeframe("60",  "",  inline = "h1",  group = gTF)
useH2  = input.bool(true,  "H2",    inline = "h2",  group = gTF)
tfH2   = input.timeframe("120", "",  inline = "h2",  group = gTF)
useH4  = input.bool(true,  "H4",    inline = "h4",  group = gTF)
tfH4   = input.timeframe("240", "",  inline = "h4",  group = gTF)
useD   = input.bool(true,  "Daily", inline = "d",   group = gTF)
tfD    = input.timeframe("1D",  "",  inline = "d",   group = gTF)

// ---------------- Detecție ----------------
gDet = "📈 Sweep — Detecție"
lookback = input.int(50, "Lookback (candele per TF)", minval = 1, group = gDet,
     tooltip = "Detectează doar în ultimele N candele ale fiecărui timeframe scanat.")
reqOpp   = input.bool(true, "Cere culori opuse (reversal)", group = gDet)
reqWicks = input.bool(true, "Cere wick pe ambele candele",  group = gDet)
minWick  = input.float(0.0, "Wick minim (puncte)", minval = 0, step = 0.1, group = gDet,
     tooltip = "Fiecare candelă trebuie să aibă wick total (sus+jos) peste această valoare.")
minSweep = input.float(0.0, "Sweep minim peste close (puncte)", minval = 0, step = 0.1, group = gDet,
     tooltip = "Cât de mult trebuie wick-ul candelei din dreapta să depășească close-ul stângii.")
maxPerTF = input.int(20, "Max niveluri per TF (cap)", minval = 1, maxval = 100, group = gDet,
     tooltip = "Plafon dur de siguranță pe fiecare timeframe.")

// ---------------- Lifecycle ----------------
gLC = "📈 Sweep — Lifecycle"
lcMode     = input.string("Spargere (close)", "Mod numărare", options = ["Spargere (close)", "Atingere (wick)"], group = gLC,
     tooltip = "Spargere = candela ÎNCHIDE de partea cealaltă a liniei (traversările cu wick nu contează). Atingere = wick-ul atinge linia.")
delOnTouch = input.bool(true, "Șterge linia după N evenimente", group = gLC)
maxTouch   = input.int(3, "Număr de evenimente", minval = 1, maxval = 20, group = gLC,
     tooltip = "Linia dispare după N spargeri (sau atingeri, în funcție de mod).")
touchTol   = input.float(0.0, "Toleranță (puncte)", minval = 0, step = 0.1, group = gLC,
     tooltip = "Doar pentru modul Atingere: cât de aproape trebuie prețul de linie. 0 = atingere exactă.")
showCount  = input.bool(true, "Arată contorul în label (ex. M15 2/3)", group = gLC)

isBreakMode = lcMode == "Spargere (close)"

// ---------------- Stil ----------------
gSt = "📈 Sweep — Stil"
cM15 = input.color(color.rgb(247, 82,  95),  "M15",   group = gSt)
cH1  = input.color(color.rgb(38,  198, 218), "H1",    group = gSt)
cH2  = input.color(color.rgb(255, 214, 0),   "H2",    group = gSt)
cH4  = input.color(color.rgb(170, 0,   255), "H4",    group = gSt)
cD   = input.color(color.rgb(41,  98,  255), "Daily", group = gSt)
lw         = input.int(1, "Grosime linie", minval = 1, maxval = 4, group = gSt)
h4Dashed   = input.bool(true, "H4 linie punctată", group = gSt)
showLabels = input.bool(true, "Arată label TF", group = gSt)
labelSizeS = input.string("small", "Mărime label", options = ["tiny", "small", "normal", "large"], group = gSt)

f_size(string s) =>
    s == "tiny" ? size.tiny : s == "normal" ? size.normal : s == "large" ? size.large : size.small

// ---------------- Detecție per timeframe ----------------
// Se evaluează pe ultimele DOUĂ candele închise ale TF-ului cerut
// (offset [2] = stânga, [1] = dreapta) -> non-repainting.
f_detect(string tf) =>
    [lC, lO, lH, lL, rO, rH, rL, rC, lt, curIdx, riIdx] = request.security(syminfo.tickerid, tf,
         [close[2], open[2], high[2], low[2], open[1], high[1], low[1], close[1], time[2], bar_index, bar_index[1]],
         lookahead = barmerge.lookahead_off)

    // fire o singură dată, când se închide o nouă candelă pe TF-ul respectiv
    newBar = ta.change(curIdx) != 0

    // wick total (sus + jos) pentru fiecare candelă
    lWick = (lH - math.max(lO, lC)) + (math.min(lO, lC) - lL)
    rWick = (rH - math.max(rO, rC)) + (math.min(rO, rC) - rL)
    wicksOK = not reqWicks or (lWick > minWick and rWick > minWick)

    // culori
    leftBull  = lC > lO
    leftBear  = lC < lO
    rightBull = rC > rO
    rightBear = rC < rO
    oppTop = not reqOpp or (leftBull and rightBear)
    oppBot = not reqOpp or (leftBear and rightBull)

    // pattern-uri
    bearTop = newBar and oppTop and (rH > lC + minSweep) and (rC < lC) and wicksOK   // sweep sus + close sub
    bullBot = newBar and oppBot and (rL < lC - minSweep) and (rC > lC) and wicksOK   // sweep jos + close peste

    sig = bearTop or bullBot
    [sig, lC, lt, riIdx, curIdx]

// ---------------- Stocare (arrays paralele per TF) ----------------
var array<line>  laM15 = array.new_line()
var array<label> lbM15 = array.new_label()
var array<int>   liM15 = array.new_int()
var array<float> lpM15 = array.new_float()
var array<int>   ltM15 = array.new_int()
var array<bool>  lcM15 = array.new_bool()

var array<line>  laH1  = array.new_line()
var array<label> lbH1  = array.new_label()
var array<int>   liH1  = array.new_int()
var array<float> lpH1  = array.new_float()
var array<int>   ltH1  = array.new_int()
var array<bool>  lcH1  = array.new_bool()

var array<line>  laH2  = array.new_line()
var array<label> lbH2  = array.new_label()
var array<int>   liH2  = array.new_int()
var array<float> lpH2  = array.new_float()
var array<int>   ltH2  = array.new_int()
var array<bool>  lcH2  = array.new_bool()

var array<line>  laH4  = array.new_line()
var array<label> lbH4  = array.new_label()
var array<int>   liH4  = array.new_int()
var array<float> lpH4  = array.new_float()
var array<int>   ltH4  = array.new_int()
var array<bool>  lcH4  = array.new_bool()

var array<line>  laD   = array.new_line()
var array<label> lbD   = array.new_label()
var array<int>   liD   = array.new_int()
var array<float> lpD   = array.new_float()
var array<int>   ltD   = array.new_int()
var array<bool>  lcD   = array.new_bool()

// scoate elementul de la index i din toate array-urile paralele
f_remove(int i, array<line> aL, array<label> aB, array<int> aI, array<float> aP, array<int> aT, array<bool> aC) =>
    line.delete(array.get(aL, i))
    label.delete(array.get(aB, i))
    array.remove(aL, i)
    array.remove(aB, i)
    array.remove(aI, i)
    array.remove(aP, i)
    array.remove(aT, i)
    array.remove(aC, i)

// ---------------- Desenare + lifecycle ----------------
f_draw(bool cond, float lvl, int t1, int riIdx, int curIdx, color col, string stl, string txt,
       array<line> aL, array<label> aB, array<int> aI, array<float> aP, array<int> aT, array<bool> aC) =>

    // 1) desenează la detecție
    if cond and not na(lvl) and not na(t1)
        ln = line.new(t1, lvl, time, lvl, xloc = xloc.bar_time, extend = extend.right,
                 color = col, width = lw, style = stl)
        lb = label.new(t1, lvl, showLabels ? txt : "", xloc = xloc.bar_time,
                 style = label.style_none, textcolor = col, size = f_size(labelSizeS))
        array.push(aL, ln)
        array.push(aB, lb)
        array.push(aI, riIdx)
        array.push(aP, lvl)
        array.push(aT, 0)
        // stare inițială:
        //  - mod Spargere : reținem pe ce parte a nivelului e prețul (close > nivel)
        //  - mod Atingere : marcăm dacă bara curentă traversează deja nivelul,
        //                   ca să nu numărăm sweep-ul care tocmai a creat linia
        array.push(aC, isBreakMode ? close > lvl : (low <= lvl + touchTol and high >= lvl - touchTol))

    // 2) numărare evenimente + ștergere (parcurgem invers ca să putem elimina în siguranță)
    if array.size(aP) > 0
        for i = array.size(aP) - 1 to 0
            p = array.get(aP, i)
            if isBreakMode
                // SPARGERE: close pe partea opusă față de starea anterioară
                wasAbove = array.get(aC, i)
                nowAbove = close > p
                if nowAbove != wasAbove
                    array.set(aT, i, array.get(aT, i) + 1)
                    array.set(aC, i, nowAbove)
            else
                // ATINGERE: wick intră în nivel; se numără o dată per vizită
                inside = low <= p + touchTol and high >= p - touchTol
                wasIn  = array.get(aC, i)
                if inside and not wasIn
                    array.set(aT, i, array.get(aT, i) + 1)
                    array.set(aC, i, true)
                else if not inside
                    array.set(aC, i, false)
            cnt = array.get(aT, i)
            if delOnTouch and cnt >= maxTouch
                f_remove(i, aL, aB, aI, aP, aT, aC)
            else if showLabels and showCount
                label.set_text(array.get(aB, i),
                     txt + " " + str.tostring(cnt) + "/" + str.tostring(maxTouch))

    // 3) expirare după lookback candele ale TF-ului
    while array.size(aI) > 0 and not na(curIdx) and (curIdx - array.get(aI, 0)) >= lookback
        f_remove(0, aL, aB, aI, aP, aT, aC)

    // 4) plafon dur de siguranță
    while array.size(aL) > maxPerTF
        f_remove(0, aL, aB, aI, aP, aT, aC)

// ---------------- Rulare ----------------
[sM15, vM15, xM15, iM15, cIM15] = f_detect(tfM15)
[sH1,  vH1,  xH1,  iH1,  cIH1 ] = f_detect(tfH1)
[sH2,  vH2,  xH2,  iH2,  cIH2 ] = f_detect(tfH2)
[sH4,  vH4,  xH4,  iH4,  cIH4 ] = f_detect(tfH4)
[sD,   vD,   xD,   iD,   cID  ] = f_detect(tfD)

if useM15
    f_draw(sM15, vM15, xM15, iM15, cIM15, cM15, line.style_solid, "M15", laM15, lbM15, liM15, lpM15, ltM15, lcM15)
if useH1
    f_draw(sH1, vH1, xH1, iH1, cIH1, cH1, line.style_solid, "H1", laH1, lbH1, liH1, lpH1, ltH1, lcH1)
if useH2
    f_draw(sH2, vH2, xH2, iH2, cIH2, cH2, line.style_solid, "H2", laH2, lbH2, liH2, lpH2, ltH2, lcH2)
if useH4
    f_draw(sH4, vH4, xH4, iH4, cIH4, cH4, h4Dashed ? line.style_dashed : line.style_solid, "H4", laH4, lbH4, liH4, lpH4, ltH4, lcH4)
if useD
    f_draw(sD, vD, xD, iD, cID, cD, line.style_solid, "Daily", laD, lbD, liD, lpD, ltD, lcD)


// ═══════════════════════════════════════════════════════════
//  🕐  2) ICT KILLZONES & PIVOTS + DAY/WEEK/MONTH
//      (fără Opening Prices și fără Timestamps)
// ═══════════════════════════════════════════════════════════
var G_KZ         = "🕐 ICT Killzones"
var g_SETTINGS   = "🕐 ICT — Settings"
kz_max_days      = input.int(3, "Session Drawing Limit", 1, group = g_SETTINGS)
kz_tf_limit      = input.timeframe("30", "Timeframe Limit", group = g_SETTINGS)
kz_gmt_tz        = input.string("America/New_York", "Timezone",
                   options = ["America/New_York","GMT-12","GMT-11","GMT-10","GMT-9","GMT-8","GMT-7","GMT-6","GMT-5","GMT-4","GMT-3","GMT-2","GMT-1","GMT+0","GMT+1","GMT+2","GMT+3","GMT+4","GMT+5","GMT+6","GMT+7","GMT+8","GMT+9","GMT+10","GMT+11","GMT+12","GMT+13","GMT+14"],
                   group = g_SETTINGS)
kz_lbl_size_str  = input.string("Normal", "Label Size", options = ["Auto","Tiny","Small","Normal","Large","Huge"], group = g_SETTINGS)
kz_txt_color     = input.color(color.black, "Text Color", group = g_SETTINGS)
kz_use_cutoff    = input.bool(false, "Drawing Cutoff Time", inline = "CO", group = g_SETTINGS)
kz_cutoff        = input.session("1800-1801", "", inline = "CO", group = g_SETTINGS)

kz_show_kz       = input.bool(true,  "Show Killzone Boxes", inline = "KZ", group = G_KZ)
kz_show_txt      = input.bool(true,  "Display Text",        inline = "KZ", group = G_KZ)

kz_use_as   = input.bool   (true,        "", inline = "ASIA", group = G_KZ)
kz_as_txt   = input.string ("Asia",      "", inline = "ASIA", group = G_KZ)
kz_asia     = input.session("2000-0000", "", inline = "ASIA", group = G_KZ)
kz_as_color = input.color  (color.blue,  "", inline = "ASIA", group = G_KZ)

kz_use_lo   = input.bool   (true,        "", inline = "LONDON", group = G_KZ)
kz_lo_txt   = input.string ("London",    "", inline = "LONDON", group = G_KZ)
kz_london   = input.session("0200-0500", "", inline = "LONDON", group = G_KZ)
kz_lo_color = input.color  (color.red,   "", inline = "LONDON", group = G_KZ)

kz_use_na   = input.bool   (true,        "",      inline = "NYAM", group = G_KZ)
kz_na_txt   = input.string ("NY AM",     "",      inline = "NYAM", group = G_KZ)
kz_nyam     = input.session("0930-1100", "",      inline = "NYAM", group = G_KZ)
kz_na_color = input.color  (#089981,     "",      inline = "NYAM", group = G_KZ)

kz_use_nl   = input.bool   (true,        "",       inline = "NYLU", group = G_KZ)
kz_nl_txt   = input.string ("NY Lunch",  "",       inline = "NYLU", group = G_KZ)
kz_nylu     = input.session("1200-1300", "",       inline = "NYLU", group = G_KZ)
kz_nl_color = input.color  (color.yellow,"",       inline = "NYLU", group = G_KZ)

kz_use_np   = input.bool   (true,        "",       inline = "NYPM", group = G_KZ)
kz_np_txt   = input.string ("NY PM",     "",       inline = "NYPM", group = G_KZ)
kz_nypm     = input.session("1330-1600", "",       inline = "NYPM", group = G_KZ)
kz_np_color = input.color  (color.purple,"",       inline = "NYPM", group = G_KZ)

kz_box_transp  = input.int(70, "Box Transparency",  0, 100, group = G_KZ)
kz_text_transp = input.int(50, "Text Transparency", 0, 100, group = G_KZ)

var g_LABELS      = "🕐 ICT — Killzone Pivots"
kz_show_pivots    = input.bool(true,  "Show Pivots",         inline = "PV", group = g_LABELS)
kz_use_alerts     = input.bool(true,  "Alert Broken Pivots", inline = "PV", group = g_LABELS)
kz_show_midpoints = input.bool(false, "Show Pivot Midpoints",inline = "mp", group = g_LABELS)
kz_stop_midpoints = input.bool(true,  "Stop Once Mitigated", inline = "mp", group = g_LABELS)
kz_show_labels    = input.bool(true,  "Show Pivot Labels",   inline = "LB", group = g_LABELS)
kz_label_price    = input.bool(false, "Display Price",       inline = "LB", group = g_LABELS)
kz_label_right    = input.bool(false, "Right Side",          inline = "LB", group = g_LABELS)
